// A pool runs one function over a slice on several threads at once.
//
// This is parallelism: the threads run at the same time, on as many CPUs as
// there are. What keeps that from being a data race is the shape of the one
// call that uses them. `each` cuts the slice into chunks that do not overlap,
// hands every chunk to the worker once, and returns only after all of them
// ran. A worker is a top-level function, so it captures nothing; what it can
// reach is its own chunk and nothing else, and the borrow of the slice ends
// when `each` returns, the way any call's does.
//
// There are no handles to join, no channels and no locks here. ADR-0025
// withdrew those shapes and set the order this follows: the thing that runs
// comes first, and a rule is written only on top of it.

pub error Error {
    OutOfMemory,
    SpawnFailed,
    StackProtectionFailed,
}

// A Pool owns its threads and their stacks. `deinit` stops and joins them and
// returns their memory to the allocator the pool was made with.
pub struct Pool {
    handle: i64,
}

// A pool thread runs the same code the caller does, so it gets the stack a
// main thread usually has rather than a coroutine's.
fn thread_stack_bytes() -> i64 {
    return 8 * 1024 * 1024;
}

// cpu_count is how many processors this process may run on now: the number
// of threads that can run at once. It is at least 1.
pub fn cpu_count(io: Io) -> i64 {
    return std::internal::builtin::thread_cpu_count(io);
}

// init makes a pool of `threads` threads counting the caller, which runs
// chunks too, so it starts `threads - 1` more. Their stacks come from
// `allocator`. Starting a thread is asking the OS, so it takes the Io.
pub fn init(
    io: Io,
    allocator: Allocator,
    threads: i64
) -> std::thread::Error!std::thread::Pool {
    if threads < 1 or threads > 1024 {
        std::internal::builtin::panic("thread init: threads must be from 1 to 1024");
    }
    let handle = try std::internal::builtin::thread_pool_new(
        allocator, threads, thread_stack_bytes());
    return Pool { handle: handle };
}

fn (self: std::thread::Pool) deinit(allocator: Allocator) -> void {
    std::internal::builtin::thread_pool_close(self.handle, allocator);
    return;
}

// each cuts `data` into chunks of `chunk` elements -- the last one may be
// shorter -- and calls `worker(part, index)` once for each, where `index`
// counts chunks from 0. The chunks run on the pool's threads in no promised
// order and return when all of them have. T holds no Io, Allocator, or view:
// those would reach past the chunk they came in.
pub fn each<T>(
    pool: &var std::thread::Pool,
    data: &var []T,
    chunk: i64,
    worker: fn(&var []T, i64) -> void
) -> void {
    if chunk < 1 {
        std::internal::builtin::panic("thread each: chunk must be at least 1");
    }
    std::internal::builtin::thread_pool_each<T>(pool.handle, data, chunk, worker);
    return;
}

// each_lane runs `worker` once per lane of `data`, on the pool's threads.
// `data` is blocks of `length * stride` elements, and each block holds
// `stride` lanes: lane i of a block is its elements i, i + stride, ...,
// i + (length - 1) * stride. For a row-major grid, a lane along an axis is
// `length` = that axis's size and `stride` = the product of the sizes after
// it; a stride of 1 is a row.
//
// The worker is handed each lane as an ordinary `&var []T` of `length`
// elements. A lane whose elements are not side by side is copied into a run
// of the taking thread's own, handed over, and copied back when the worker
// returns, so no other thread holds any element of it. Those runs, one per
// thread, come from `allocator` for the call and go back before it returns.
// `index` counts lanes from 0 in the order of their first elements' blocks,
// then i. `data` whose length is not whole blocks is a panic.
pub fn each_lane<T>(
    pool: &var std::thread::Pool,
    allocator: Allocator,
    data: &var []T,
    length: i64,
    stride: i64,
    worker: fn(&var []T, i64) -> void
) -> std::thread::Error!void {
    if length < 1 or stride < 1 {
        std::internal::builtin::panic("thread each_lane: length and stride must be at least 1");
    }
    if std::mem::count<T>(data) % (length * stride) != 0 {
        std::internal::builtin::panic("thread each_lane: data must be whole blocks of length * stride");
    }
    try std::internal::builtin::thread_pool_each_lane<T>(
        pool.handle, allocator, data, length, stride, worker);
    return;
}
