// std::json encode v1 is an explicit streaming encoder. The caller spells
// every begin/end and field write, and the encoder owns its output buffer.
// API misuse (a field outside an object, an unbalanced end, a second
// top-level value) is a bug, so it traps instead of returning a recoverable
// error; the `!void` results only propagate allocation failures from the
// owned output. `write_*_field` pairs the key and the value in one call, so
// a key can never be left without a value.
pub struct Encoder {
    allocator: Allocator,
    out: std::string::String,
    depth: i64,
    kinds: i64,
    nonempty: i64,
    top_written: bool,
    indent_byte: u8,
    indent_width: i64,
}

pub fn encoder(allocator: Allocator) -> Encoder {
    return Encoder {
        allocator: allocator,
        out: std::string::new(allocator),
        depth: 0,
        kinds: 0,
        nonempty: 0,
        top_written: false,
        indent_byte: cast<u8>(32),
        indent_width: 0,
    };
}

// encoder_with_spaces writes the same document broken across lines, with
// `width` spaces per level. A negative width is a bug, not a request.
pub fn encoder_with_spaces(allocator: Allocator, width: i64) -> Encoder {
    return indented_encoder(allocator, cast<u8>(32), width);
}

// encoder_with_tabs writes the same document broken across lines, with `width`
// tabs per level.
pub fn encoder_with_tabs(allocator: Allocator, width: i64) -> Encoder {
    return indented_encoder(allocator, cast<u8>(9), width);
}

fn indented_encoder(allocator: Allocator, byte: u8, width: i64) -> Encoder {
    if width < 0 {
        std::internal::builtin::panic("json encoder: indent width cannot be negative");
    }
    return Encoder {
        allocator: allocator,
        out: std::string::new(allocator),
        depth: 0,
        kinds: 0,
        nonempty: 0,
        top_written: false,
        indent_byte: byte,
        indent_width: width,
    };
}

fn (self: &var Encoder) begin_object() -> std::mem::Error!void {
    try self.begin_value();
    try self.push(1, cast<u8>(123));
    return;
}

fn (self: &var Encoder) end_object() -> std::mem::Error!void {
    if self.depth == 0 or self.kinds % 2 == 0 {
        std::internal::builtin::panic("json encoder: end_object without an open object");
    }
    try self.pop(cast<u8>(125));
    return;
}

fn (self: &var Encoder) begin_array() -> std::mem::Error!void {
    try self.begin_value();
    try self.push(0, cast<u8>(91));
    return;
}

fn (self: &var Encoder) end_array() -> std::mem::Error!void {
    if self.depth == 0 or self.kinds % 2 == 1 {
        std::internal::builtin::panic("json encoder: end_array without an open array");
    }
    try self.pop(cast<u8>(93));
    return;
}

fn (self: &var Encoder) begin_object_field(name: []u8) -> std::mem::Error!void {
    try self.begin_field(name);
    try self.push(1, cast<u8>(123));
    return;
}

fn (self: &var Encoder) begin_array_field(name: []u8) -> std::mem::Error!void {
    try self.begin_field(name);
    try self.push(0, cast<u8>(91));
    return;
}

fn (self: &var Encoder) write_i64(value: i64) -> std::mem::Error!void {
    let allocator = self.allocator;
    try self.begin_value();
    try std::fmt::append_i64(allocator, self.out, value);
    return;
}

// write_f64 spells a float the way `std::float::append` does: the shortest
// decimal that reads back as the same value, with `.0` on an integral one so
// the document still says it is a float. JSON has no spelling for NaN or an
// infinity, so reaching here with one is a bug in the caller, not a recoverable
// failure (ADR-0112): the value came from the program's own arithmetic rather
// than from input, and what it stands for is the program's to decide.
fn (self: &var Encoder) write_f64(value: f64) -> std::mem::Error!void {
    let allocator = self.allocator;
    check_finite(value);
    try self.begin_value();
    try std::float::append(allocator, self.out, value);
    return;
}

fn (self: &var Encoder) write_bool(value: bool) -> std::mem::Error!void {
    let allocator = self.allocator;
    try self.begin_value();
    try std::fmt::append_bool(allocator, self.out, value);
    return;
}

fn (self: &var Encoder) write_null() -> std::mem::Error!void {
    try self.begin_value();
    try self.out.append_bytes(self.allocator, "null");
    return;
}

fn (self: &var Encoder) write_bytes(value: []u8) -> std::mem::Error!void {
    try self.begin_value();
    try self.write_quoted(value);
    return;
}

fn (self: &var Encoder) write_i64_field(name: []u8, value: i64) -> std::mem::Error!void {
    let allocator = self.allocator;
    try self.begin_field(name);
    try std::fmt::append_i64(allocator, self.out, value);
    return;
}

fn (self: &var Encoder) write_f64_field(name: []u8, value: f64) -> std::mem::Error!void {
    let allocator = self.allocator;
    check_finite(value);
    try self.begin_field(name);
    try std::float::append(allocator, self.out, value);
    return;
}

fn (self: &var Encoder) write_bool_field(name: []u8, value: bool) -> std::mem::Error!void {
    let allocator = self.allocator;
    try self.begin_field(name);
    try std::fmt::append_bool(allocator, self.out, value);
    return;
}

fn (self: &var Encoder) write_null_field(name: []u8) -> std::mem::Error!void {
    try self.begin_field(name);
    try self.out.append_bytes(self.allocator, "null");
    return;
}

fn (self: &var Encoder) write_bytes_field(name: []u8, value: []u8) -> std::mem::Error!void {
    try self.begin_field(name);
    try self.write_quoted(value);
    return;
}

fn check_finite(value: f64) -> void {
    if std::float::is_nan(value) {
        std::internal::builtin::panic("json encoder: NaN is not a JSON number");
    }
    if std::float::is_infinite(value) {
        std::internal::builtin::panic("json encoder: an infinity is not a JSON number");
    }
    return;
}

// finish_into checks the document is complete and appends the encoded bytes
// into `out`. The encoder keeps its own buffer; `deinit` releases it. The
// checker cannot yet lend a field's bytes out of a method, so v1 copies into
// a caller buffer instead of returning a view.
fn (self: Encoder) finish_into(
    allocator: Allocator,
    out: &var std::string::String
) -> std::mem::Error!void {
    if self.depth != 0 {
        std::internal::builtin::panic("json encoder: finish with an open container");
    }
    if !self.top_written {
        std::internal::builtin::panic("json encoder: finish before any value");
    }
    try out.append_string(allocator, self.out);
    return;
}

// encode writes one value as a JSON document into `out`.
//
// The walk is the value's own shape read at compile time (SPEC §13.1): a
// struct becomes an object of its public fields in declaration order, and a
// field whose type is itself a struct recurses. A type this encoder has no
// case for is a compile error, not a runtime one, and not silence.
pub fn encode<T>(
    allocator: Allocator,
    value: &T,
    out: &var std::string::String,
) -> std::mem::Error!void {
    var encoder = std::json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encode_value<T>(encoder, value);
    try encoder.finish_into(allocator, out);
    return;
}

// encode_with_spaces writes the same document broken across lines, with
// `width` spaces per level. The document is the one `encode` writes; only the
// whitespace between its parts differs.
pub fn encode_with_spaces<T>(
    allocator: Allocator,
    width: i64,
    value: &T,
    out: &var std::string::String,
) -> std::mem::Error!void {
    var encoder = std::json::encoder_with_spaces(allocator, width);
    defer encoder.deinit(allocator);
    try encode_value<T>(encoder, value);
    try encoder.finish_into(allocator, out);
    return;
}

// encode_with_tabs writes the same document with `width` tabs per level.
pub fn encode_with_tabs<T>(
    allocator: Allocator,
    width: i64,
    value: &T,
    out: &var std::string::String,
) -> std::mem::Error!void {
    var encoder = std::json::encoder_with_tabs(allocator, width);
    defer encoder.deinit(allocator);
    try encode_value<T>(encoder, value);
    try encoder.finish_into(allocator, out);
    return;
}

// encode_value writes one bare value: the document's top level, or an array
// element. A named field goes through encode_field, so a key is never written
// without the value that belongs to it.
pub fn encode_value<T>(encoder: &var std::json::Encoder, value: &T) -> std::mem::Error!void {
    comptime if T == type<i64> {
        try encoder.write_i64(value.*);
    } else {
        comptime if T == type<f64> {
            try encoder.write_f64(value.*);
        } else {
            comptime if T == type<bool> {
                try encoder.write_bool(value.*);
            } else {
                comptime if T == type<[]u8> {
                    try encoder.write_bytes(value.*);
                } else {
                    comptime if T == type<std::string::String> {
                        let text = value.as_bytes();
                        try encoder.write_bytes(text);
                    } else {
                        comptime if std::meta::has_public_fields<T>() {
                            try encoder.begin_object();
                            try encode_fields<T>(encoder, value);
                            try encoder.end_object();
                        } else {
                            comptime if std::meta::is_array<T>()
                                or std::meta::is_map<T>()
                                or std::meta::is_box<T>() {
                                try encode_container_value<T>(encoder, value);
                            } else {
                                comptime if std::meta::is_enum<T>()
                                    or std::meta::is_union<T>() {
                                    try encode_variant_value<T>(encoder, value);
                                } else {
                                    std::meta::unsupported<T>();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return;
}

fn encode_container_value<T>(encoder: &var std::json::Encoder, value: &T) -> std::mem::Error!void {
    comptime if std::meta::is_array<T>() {
        try encoder.begin_array();
        try encode_elements<T>(encoder, value);
        try encoder.end_array();
    } else {
        comptime if std::meta::is_map<T>() {
            try encoder.begin_object();
            try encode_entries<T>(encoder, value);
            try encoder.end_object();
        } else {
            let held = value.borrow();
            try encode_value<std::meta::element<T>>(encoder, held);
        }
    }
    return;
}

fn encode_elements<T>(encoder: &var std::json::Encoder, value: &T) -> std::mem::Error!void {
    var index = 0;
    while index < value.len() {
        if value.at(index) |elem| {
            try encode_value<std::meta::element<T>>(encoder, elem);
        }
        index = index + 1;
    }
    return;
}

fn encode_entries<T>(encoder: &var std::json::Encoder, value: &T) -> std::mem::Error!void {
    var index = 0;
    while value.key_at(index) |key| {
        if value.at(key) |entry| {
            try encode_field<std::meta::element<T>>(encoder, key, entry);
        }
        index = index + 1;
    }
    return;
}

fn encode_fields<T>(encoder: &var std::json::Encoder, value: &T) -> std::mem::Error!void {
    comptime for std::meta::public_fields<T>() |f| {
        comptime if std::meta::is_optional<std::meta::field_type<T, f>>() {
            if std::meta::field<T, f>(value) |held| {
                try encode_field<std::meta::element<std::meta::field_type<T, f>>>(
                    encoder,
                    std::meta::field_name<T, f>(),
                    held,
                );
            } else {
                try encoder.write_null_field(std::meta::field_name<T, f>());
            }
        } else {
            try encode_field<std::meta::field_type<T, f>>(
                encoder,
                std::meta::field_name<T, f>(),
                std::meta::field<T, f>(value),
            );
        }
    }
    return;
}

fn encode_field<T>(
    encoder: &var std::json::Encoder,
    name: []u8,
    value: &T,
) -> std::mem::Error!void {
    comptime if T == type<i64> {
        try encoder.write_i64_field(name, value.*);
    } else {
        comptime if T == type<f64> {
            try encoder.write_f64_field(name, value.*);
        } else {
            comptime if T == type<bool> {
                try encoder.write_bool_field(name, value.*);
            } else {
                comptime if T == type<[]u8> {
                    try encoder.write_bytes_field(name, value.*);
                } else {
                    comptime if T == type<std::string::String> {
                        let text = value.as_bytes();
                        try encoder.write_bytes_field(name, text);
                    } else {
                        comptime if std::meta::has_public_fields<T>() {
                            try encoder.begin_object_field(name);
                            try encode_fields<T>(encoder, value);
                            try encoder.end_object();
                        } else {
                            comptime if std::meta::is_array<T>()
                                or std::meta::is_map<T>()
                                or std::meta::is_box<T>() {
                                try encode_container_field<T>(encoder, name, value);
                            } else {
                                comptime if std::meta::is_enum<T>()
                                    or std::meta::is_union<T>() {
                                    try encode_variant_field<T>(encoder, name, value);
                                } else {
                                    std::meta::unsupported<T>();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return;
}

fn encode_container_field<T>(
    encoder: &var std::json::Encoder,
    name: []u8,
    value: &T,
) -> std::mem::Error!void {
    comptime if std::meta::is_array<T>() {
        try encoder.begin_array_field(name);
        try encode_elements<T>(encoder, value);
        try encoder.end_array();
    } else {
        comptime if std::meta::is_map<T>() {
            try encoder.begin_object_field(name);
            try encode_entries<T>(encoder, value);
            try encoder.end_object();
        } else {
            let held = value.borrow();
            try encode_field<std::meta::element<T>>(encoder, name, held);
        }
    }
    return;
}

fn encode_variant_value<T>(encoder: &var std::json::Encoder, value: &T) -> std::mem::Error!void {
    comptime if T == type<std::json::Value> {
        try encode_any_value(encoder, value);
    } else {
        comptime match value |v, payload| {
            comptime if std::meta::has_payload<T, v>() {
                try encoder.begin_object();
                try encode_field<std::meta::variant_type<T, v>>(
                    encoder,
                    std::meta::variant_name<T, v>(),
                    payload,
                );
                try encoder.end_object();
            } else {
                try encoder.write_bytes(std::meta::variant_name<T, v>());
            }
        }
    }
    return;
}

fn encode_variant_field<T>(
    encoder: &var std::json::Encoder,
    name: []u8,
    value: &T,
) -> std::mem::Error!void {
    comptime if T == type<std::json::Value> {
        try encode_any_field(encoder, name, value);
    } else {
        comptime match value |v, payload| {
            comptime if std::meta::has_payload<T, v>() {
                try encoder.begin_object_field(name);
                try encode_field<std::meta::variant_type<T, v>>(
                    encoder,
                    std::meta::variant_name<T, v>(),
                    payload,
                );
                try encoder.end_object();
            } else {
                try encoder.write_bytes_field(name, std::meta::variant_name<T, v>());
            }
        }
    }
    return;
}

fn encode_any_value(
    encoder: &var std::json::Encoder,
    value: &std::json::Value,
) -> std::mem::Error!void {
    match value {
        Null => try encoder.write_null(),
        Bool(flag) => try encoder.write_bool(flag),
        I64(number) => try encoder.write_i64(number),
        F64(number) => try encoder.write_f64(number),
        Str(text) => {
            let bytes = text.as_bytes();
            try encoder.write_bytes(bytes);
        },
        Arr(items) => {
            try encoder.begin_array();
            try encode_any_elements(encoder, items);
            try encoder.end_array();
        },
        Obj(entries) => {
            try encoder.begin_object();
            try encode_any_entries(encoder, entries);
            try encoder.end_object();
        },
    }
    return;
}

fn encode_any_field(
    encoder: &var std::json::Encoder,
    name: []u8,
    value: &std::json::Value,
) -> std::mem::Error!void {
    match value {
        Null => try encoder.write_null_field(name),
        Bool(flag) => try encoder.write_bool_field(name, flag),
        I64(number) => try encoder.write_i64_field(name, number),
        F64(number) => try encoder.write_f64_field(name, number),
        Str(text) => {
            let bytes = text.as_bytes();
            try encoder.write_bytes_field(name, bytes);
        },
        Arr(items) => {
            try encoder.begin_array_field(name);
            try encode_any_elements(encoder, items);
            try encoder.end_array();
        },
        Obj(entries) => {
            try encoder.begin_object_field(name);
            try encode_any_entries(encoder, entries);
            try encoder.end_object();
        },
    }
    return;
}

fn encode_any_elements(
    encoder: &var std::json::Encoder,
    items: &std::array::Array<std::json::Value>,
) -> std::mem::Error!void {
    var index = 0;
    while items.at(index) |elem| {
        try encode_any_value(encoder, elem);
        index = index + 1;
    }
    return;
}

fn encode_any_entries(
    encoder: &var std::json::Encoder,
    entries: &std::map::Map<[]u8, std::json::Value>,
) -> std::mem::Error!void {
    var index = 0;
    while entries.key_at(index) |key| {
        if entries.at(key) |value| {
            try encode_any_field(encoder, key, value);
        }
        index = index + 1;
    }
    return;
}

// begin_value checks that a bare value may start here: the single top-level
// slot or an array element. Inside an object a value needs a field name, so
// a bare value there is misuse.
fn (self: &var Encoder) begin_value() -> std::mem::Error!void {
    if self.depth == 0 {
        if self.top_written {
            std::internal::builtin::panic("json encoder: second top-level value");
        }
        self.top_written = true;
        return;
    }
    if self.kinds % 2 == 1 {
        std::internal::builtin::panic("json encoder: bare value inside an object");
    }
    try self.mark_element();
    return;
}

// begin_field checks that a named field may start here (inside an object)
// and writes the separator, the escaped name, and the colon.
fn (self: &var Encoder) begin_field(name: []u8) -> std::mem::Error!void {
    if self.depth == 0 or self.kinds % 2 == 0 {
        std::internal::builtin::panic("json encoder: field outside an object");
    }
    try self.mark_element();
    try self.write_quoted(name);
    try self.out.append_byte(self.allocator, cast<u8>(58));
    if self.indent_width > 0 {
        try self.out.append_byte(self.allocator, cast<u8>(32));
    }
    return;
}

fn (self: &var Encoder) mark_element() -> std::mem::Error!void {
    if self.nonempty % 2 == 1 {
        try self.out.append_byte(self.allocator, cast<u8>(44));
    } else {
        self.nonempty = self.nonempty + 1;
    }
    try self.break_line(self.depth);
    return;
}

// break_line starts a new line indented for `level` open containers. It writes
// nothing in the compact form, which is what keeps one separator path for both
// forms instead of two writers.
fn (self: &var Encoder) break_line(level: i64) -> std::mem::Error!void {
    if self.indent_width == 0 {
        return;
    }
    try self.out.append_byte(self.allocator, cast<u8>(10));
    var remaining = level * self.indent_width;
    while remaining > 0 {
        try self.out.append_byte(self.allocator, self.indent_byte);
        remaining = remaining - 1;
    }
    return;
}

fn (self: &var Encoder) push(kind: i64, open: u8) -> std::mem::Error!void {
    if self.depth == 62 {
        std::internal::builtin::panic("json encoder: nesting deeper than 62 levels");
    }
    self.depth = self.depth + 1;
    self.kinds = self.kinds * 2 + kind;
    self.nonempty = self.nonempty * 2;
    try self.out.append_byte(self.allocator, open);
    return;
}

fn (self: &var Encoder) pop(close: u8) -> std::mem::Error!void {
    let had_element = self.nonempty % 2 == 1;
    self.depth = self.depth - 1;
    self.kinds = self.kinds / 2;
    self.nonempty = self.nonempty / 2;
    if had_element {
        try self.break_line(self.depth);
    }
    try self.out.append_byte(self.allocator, close);
    return;
}

// write_quoted writes one JSON string: quoted, with the two-character JSON
// escapes for quote, backslash, newline, carriage return, and tab, and
// \u00XX for the remaining control bytes. Bytes are escaped
// deterministically; encode v1 does not validate UTF-8.
fn (self: &var Encoder) write_quoted(bytes: []u8) -> std::mem::Error!void {
    try self.out.append_byte(self.allocator, cast<u8>(34));
    var index = 0;
    let length = std::mem::len(bytes);
    while index < length {
        let byte = bytes[index];
        if byte == cast<u8>(34) or byte == cast<u8>(92) {
            try self.out.append_byte(self.allocator, cast<u8>(92));
            try self.out.append_byte(self.allocator, byte);
        } else {
            if byte == cast<u8>(10) {
                try self.out.append_bytes(self.allocator, "\n");
            } else {
                if byte == cast<u8>(13) {
                    try self.out.append_bytes(self.allocator, "\r");
                } else {
                    if byte == cast<u8>(9) {
                        try self.out.append_bytes(self.allocator, "\t");
                    } else {
                        if byte < cast<u8>(32) {
                            try self.out.append_bytes(self.allocator, "\u00");
                            try self.out.append_byte(self.allocator, hex_digit(byte / cast<u8>(16)));
                            try self.out.append_byte(self.allocator, hex_digit(byte % cast<u8>(16)));
                        } else {
                            try self.out.append_byte(self.allocator, byte);
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    try self.out.append_byte(self.allocator, cast<u8>(34));
    return;
}

fn hex_digit(value: u8) -> u8 {
    if value < cast<u8>(10) {
        return cast<u8>(48) + value;
    }
    return cast<u8>(87) + value;
}

pub error Error {
    // The bytes are not JSON at this point.
    UnexpectedToken,
    // The document is JSON, but does not describe a `T`: a field of `T` is
    // absent, the document names one `T` does not have, or one key appears
    // twice. The caller recovers by decoding into a different type or by
    // asking for the variant that ignores unknown keys.
    MissingField,
    UnknownField,
    DuplicateField,
    // A number that JSON allows and the asked-for type cannot hold: a
    // fraction or an exponent asked for as `i64`, an integer past `i64`, or a
    // magnitude past `f64`.
    InvalidNumber,
    // The escape is well-formed JSON that names no character: a lone
    // surrogate half, or a `\` before something that is not an escape.
    InvalidEscape,
    // Input-dependent, so it is recoverable rather than a trap: the caller
    // rejects the document, the way it rejects any other malformed input.
    DepthExceeded,
}

// Decoding fails two ways: the document does not describe a `T` (`Error`),
// or building the decoded value ran out of memory (`std::mem::Error`). The
// union carries both without converting either (ADR-0128), so a caller can
// catch a decode and match the members of both sets.
pub error DecodeError = Error or std::mem::Error;

fn max_depth() -> i64 {
    return 128;
}

fn is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9)
        or byte == cast<u8>(10) or byte == cast<u8>(13);
}

fn skip_space(bytes: []u8, index: &var i64) -> void {
    while std::mem::byte_at(bytes, index.*) |byte| {
        if !is_space(byte) {
            return;
        }
        index.* = index.* + 1;
    }
    return;
}

fn peek_byte(bytes: []u8, index: &var i64) -> ?u8 {
    skip_space(bytes, index);
    return std::mem::byte_at(bytes, index.*);
}

fn expect_byte(bytes: []u8, index: &var i64, want: u8) -> Error!void {
    if peek_byte(bytes, index) |byte| {
        if byte == want {
            index.* = index.* + 1;
            return;
        }
    }
    return Error::UnexpectedToken;
}

fn expect_literal(bytes: []u8, index: &var i64, word: []u8) -> Error!void {
    skip_space(bytes, index);
    if std::mem::slice(bytes, index.*, index.* + std::mem::len(word)) |seen| {
        if std::mem::equal_bytes(seen, word) {
            index.* = index.* + std::mem::len(word);
            return;
        }
    }
    return Error::UnexpectedToken;
}

fn decode_bool(bytes: []u8, index: &var i64) -> Error!bool {
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(116) {
            try expect_literal(bytes, index, "true");
            return true;
        }
        if byte == cast<u8>(102) {
            try expect_literal(bytes, index, "false");
            return false;
        }
    }
    return Error::UnexpectedToken;
}

fn decode_null(bytes: []u8, index: &var i64) -> Error!void {
    try expect_literal(bytes, index, "null");
    return;
}

fn is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}

struct Number {
    start: i64,
    end: i64,
    integral: bool,
}

fn scan_number(bytes: []u8, index: &var i64) -> Error!Number {
    skip_space(bytes, index);
    let start = index.*;
    if std::mem::byte_at(bytes, index.*) |byte| {
        if byte == cast<u8>(45) {
            index.* = index.* + 1;
        }
    }
    if std::mem::byte_at(bytes, index.*) |byte| {
        if byte == cast<u8>(48) {
            index.* = index.* + 1;
        } else {
            if skip_digits(bytes, index) == 0 {
                return Error::UnexpectedToken;
            }
        }
    } else {
        return Error::UnexpectedToken;
    }
    var integral = true;
    if std::mem::byte_at(bytes, index.*) |byte| {
        if byte == cast<u8>(46) {
            index.* = index.* + 1;
            if skip_digits(bytes, index) == 0 {
                return Error::UnexpectedToken;
            }
            integral = false;
        }
    }
    if std::mem::byte_at(bytes, index.*) |byte| {
        if byte == cast<u8>(101) or byte == cast<u8>(69) {
            index.* = index.* + 1;
            if std::mem::byte_at(bytes, index.*) |sign| {
                if sign == cast<u8>(43) or sign == cast<u8>(45) {
                    index.* = index.* + 1;
                }
            }
            if skip_digits(bytes, index) == 0 {
                return Error::UnexpectedToken;
            }
            integral = false;
        }
    }
    return Number { start: start, end: index.*, integral: integral };
}

fn skip_digits(bytes: []u8, index: &var i64) -> i64 {
    var count = 0;
    while std::mem::byte_at(bytes, index.*) |byte| {
        if !is_digit(byte) {
            break;
        }
        index.* = index.* + 1;
        count = count + 1;
    }
    return count;
}

fn integer_of(bytes: []u8, number: &Number) -> Error!i64 {
    if !number.integral {
        return Error::InvalidNumber;
    }
    var at = number.start;
    var negative = false;
    if std::mem::byte_at(bytes, at) |byte| {
        if byte == cast<u8>(45) {
            negative = true;
            at = at + 1;
        }
    }
    var value = 0;
    while at < number.end {
        if std::mem::byte_at(bytes, at) |byte| {
            let digit = cast<i64>(byte - cast<u8>(48));
            if value < -922337203685477580
                or (value == -922337203685477580 and digit > 8) {
                return Error::InvalidNumber;
            }
            value = value * 10 - digit;
        }
        at = at + 1;
    }
    if negative {
        return value;
    }
    if value < -9223372036854775807 {
        return Error::InvalidNumber;
    }
    return 0 - value;
}

fn float_of(allocator: Allocator, bytes: []u8, number: &Number) -> std::json::DecodeError!f64 {
    if std::mem::slice(bytes, number.start, number.end) |text| {
        if try std::float::parse(allocator, text) |value| {
            if std::float::is_infinite(value) {
                return Error::InvalidNumber;
            }
            return value;
        }
    }
    return Error::UnexpectedToken;
}

fn decode_i64(bytes: []u8, index: &var i64) -> Error!i64 {
    let number = try scan_number(bytes, index);
    return integer_of(bytes, &number);
}

fn decode_f64(allocator: Allocator, bytes: []u8, index: &var i64) -> std::json::DecodeError!f64 {
    let number = try scan_number(bytes, index);
    return float_of(allocator, bytes, &number);
}

fn hex_value(byte: u8) -> ?i64 {
    if is_digit(byte) {
        return cast<i64>(byte - cast<u8>(48));
    }
    if byte >= cast<u8>(97) and byte <= cast<u8>(102) {
        return cast<i64>(byte - cast<u8>(87));
    }
    if byte >= cast<u8>(65) and byte <= cast<u8>(70) {
        return cast<i64>(byte - cast<u8>(55));
    }
    return null;
}

fn read_hex4(bytes: []u8, index: &var i64) -> Error!i64 {
    var value = 0;
    var count = 0;
    while count < 4 {
        if std::mem::byte_at(bytes, index.*) |byte| {
            if hex_value(byte) |digit| {
                value = value * 16 + digit;
                index.* = index.* + 1;
                count = count + 1;
            } else {
                return Error::InvalidEscape;
            }
        } else {
            return Error::InvalidEscape;
        }
    }
    return value;
}

fn append_utf8(allocator: Allocator, out: &var std::string::String, code: i64) -> std::json::DecodeError!void {
    if code < 128 {
        try out.append_byte(allocator, cast<u8>(code));
        return;
    }
    if code < 2048 {
        try out.append_byte(allocator, cast<u8>(192 + code / 64));
        try out.append_byte(allocator, cast<u8>(128 + code % 64));
        return;
    }
    if code < 65536 {
        try out.append_byte(allocator, cast<u8>(224 + code / 4096));
        try out.append_byte(allocator, cast<u8>(128 + code / 64 % 64));
        try out.append_byte(allocator, cast<u8>(128 + code % 64));
        return;
    }
    try out.append_byte(allocator, cast<u8>(240 + code / 262144));
    try out.append_byte(allocator, cast<u8>(128 + code / 4096 % 64));
    try out.append_byte(allocator, cast<u8>(128 + code / 64 % 64));
    try out.append_byte(allocator, cast<u8>(128 + code % 64));
    return;
}

fn decode_escape(allocator: Allocator, bytes: []u8, index: &var i64, out: &var std::string::String) -> std::json::DecodeError!void {
    if std::mem::byte_at(bytes, index.*) |byte| {
        index.* = index.* + 1;
        if byte == cast<u8>(34) or byte == cast<u8>(92) or byte == cast<u8>(47) {
            try out.append_byte(allocator, byte);
            return;
        }
        if byte == cast<u8>(110) {
            try out.append_byte(allocator, cast<u8>(10));
            return;
        }
        if byte == cast<u8>(114) {
            try out.append_byte(allocator, cast<u8>(13));
            return;
        }
        if byte == cast<u8>(116) {
            try out.append_byte(allocator, cast<u8>(9));
            return;
        }
        if byte == cast<u8>(98) {
            try out.append_byte(allocator, cast<u8>(8));
            return;
        }
        if byte == cast<u8>(102) {
            try out.append_byte(allocator, cast<u8>(12));
            return;
        }
        if byte == cast<u8>(117) {
            let code = try read_hex4(bytes, index);
            try append_utf8(allocator, out, try pair_surrogate(bytes, index, code));
            return;
        }
    }
    return Error::InvalidEscape;
}

fn pair_surrogate(bytes: []u8, index: &var i64, code: i64) -> Error!i64 {
    if code < 55296 or code > 57343 {
        return code;
    }
    if code > 56319 {
        return Error::InvalidEscape;
    }
    try expect_byte(bytes, index, cast<u8>(92));
    try expect_byte(bytes, index, cast<u8>(117));
    let low = try read_hex4(bytes, index);
    if low < 56320 or low > 57343 {
        return Error::InvalidEscape;
    }
    return 65536 + (code - 55296) * 1024 + (low - 56320);
}

fn decode_string(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
) -> std::json::DecodeError!std::string::String {
    try expect_byte(bytes, index, cast<u8>(34));
    var out = std::string::new(allocator);
    errdefer out.deinit(allocator);
    while std::mem::byte_at(bytes, index.*) |byte| {
        index.* = index.* + 1;
        if byte == cast<u8>(34) {
            return move out;
        }
        if byte == cast<u8>(92) {
            try decode_escape(allocator, bytes, index, &var out);
        } else {
            try out.append_byte(allocator, byte);
        }
    }
    return Error::UnexpectedToken;
}

fn skip_value(bytes: []u8, index: &var i64, depth: i64) -> Error!void {
    if depth > max_depth() {
        return Error::DepthExceeded;
    }
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(123) {
            return skip_object(bytes, index, depth);
        }
        if byte == cast<u8>(91) {
            return skip_array(bytes, index, depth);
        }
        if byte == cast<u8>(34) {
            return skip_string(bytes, index);
        }
        if byte == cast<u8>(116) or byte == cast<u8>(102) {
            let _ = try decode_bool(bytes, index);
            return;
        }
        if byte == cast<u8>(110) {
            return decode_null(bytes, index);
        }
        let _ = try scan_number(bytes, index);
        return;
    }
    return Error::UnexpectedToken;
}

fn skip_string(bytes: []u8, index: &var i64) -> Error!void {
    try expect_byte(bytes, index, cast<u8>(34));
    while std::mem::byte_at(bytes, index.*) |byte| {
        index.* = index.* + 1;
        if byte == cast<u8>(34) {
            return;
        }
        if byte == cast<u8>(92) {
            index.* = index.* + 1;
        }
    }
    return Error::UnexpectedToken;
}

fn skip_object(bytes: []u8, index: &var i64, depth: i64) -> Error!void {
    try expect_byte(bytes, index, cast<u8>(123));
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(125) {
            index.* = index.* + 1;
            return;
        }
    }
    var more = true;
    while more {
        try skip_string(bytes, index);
        try expect_byte(bytes, index, cast<u8>(58));
        try skip_value(bytes, index, depth + 1);
        more = try comma_or_close(bytes, index, cast<u8>(125));
    }
    return;
}

fn skip_array(bytes: []u8, index: &var i64, depth: i64) -> Error!void {
    try expect_byte(bytes, index, cast<u8>(91));
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(93) {
            index.* = index.* + 1;
            return;
        }
    }
    var more = true;
    while more {
        try skip_value(bytes, index, depth + 1);
        more = try comma_or_close(bytes, index, cast<u8>(93));
    }
    return;
}

fn comma_or_close(bytes: []u8, index: &var i64, close: u8) -> Error!bool {
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(44) {
            index.* = index.* + 1;
            return true;
        }
        if byte == close {
            index.* = index.* + 1;
            return false;
        }
    }
    return Error::UnexpectedToken;
}

// A Member is one key of an object with the offsets it and its value start at.
// The key stays where it is: comparing it against a field name undoes escapes
// as it walks, so a key costs no allocation and an escaped key still matches
// the field it names.
pub struct Member {
    pub key_at: i64,
    pub value_at: i64,
}

// A Scan is what one object looked like: its members in document order. The
// fields of `T` are filled from it in declaration order, so a document may
// name them in any order.
pub struct Scan {
    pub members: std::array::Array<Member>,
}

fn scan_object(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    depth: i64,
) -> std::json::DecodeError!Scan {
    if depth > max_depth() {
        return Error::DepthExceeded;
    }
    try expect_byte(bytes, index, cast<u8>(123));
    var members = std::array::new<Member>(allocator);
    errdefer members.deinit(allocator);
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(125) {
            index.* = index.* + 1;
            return Scan { members: move members };
        }
    }
    var more = true;
    while more {
        skip_space(bytes, index);
        let key_at = index.*;
        try skip_string(bytes, index);
        try expect_byte(bytes, index, cast<u8>(58));
        skip_space(bytes, index);
        let member = Member { key_at: key_at, value_at: index.* };
        if member_at(&members, bytes, key_at) |_| {
            return Error::DuplicateField;
        }
        try members.append(allocator, member);
        try skip_value(bytes, index, depth + 1);
        more = try comma_or_close(bytes, index, cast<u8>(125));
    }
    return Scan { members: move members };
}

fn member_at(
    members: &std::array::Array<Member>,
    bytes: []u8,
    key_at: i64,
) -> ?i64 {
    var index = 0;
    while members.at(index) |member| {
        if same_key(bytes, member.key_at, key_at) {
            return member.value_at;
        }
        index = index + 1;
    }
    return null;
}

fn member_named(
    members: &std::array::Array<Member>,
    bytes: []u8,
    name: []u8,
) -> ?i64 {
    var index = 0;
    while members.at(index) |member| {
        if key_equals(bytes, member.key_at, name) {
            return member.value_at;
        }
        index = index + 1;
    }
    return null;
}

fn key_equals(bytes: []u8, key_at: i64, name: []u8) -> bool {
    var index = key_at + 1;
    var seen = 0;
    let length = std::mem::len(name);
    while std::mem::byte_at(bytes, index) |byte| {
        if byte == cast<u8>(34) {
            return seen == length;
        }
        if byte == cast<u8>(92) {
            index = index + 1;
            if escape_byte(bytes, &var index) |decoded| {
                if seen >= length or name[seen] != decoded {
                    return false;
                }
                seen = seen + 1;
            } else {
                return false;
            }
        } else {
            if seen >= length or name[seen] != byte {
                return false;
            }
            seen = seen + 1;
            index = index + 1;
        }
    }
    return false;
}

fn same_key(bytes: []u8, left_at: i64, right_at: i64) -> bool {
    var left = left_at;
    var right = right_at;
    while std::mem::byte_at(bytes, left) |byte| {
        if std::mem::byte_at(bytes, right) |other| {
            if byte != other {
                return false;
            }
            if byte == cast<u8>(34) and left > left_at {
                return true;
            }
            if byte == cast<u8>(92) {
                left = left + 1;
                right = right + 1;
            }
            left = left + 1;
            right = right + 1;
        } else {
            return false;
        }
    }
    return false;
}

fn escape_byte(bytes: []u8, index: &var i64) -> ?u8 {
    if std::mem::byte_at(bytes, index.*) |byte| {
        index.* = index.* + 1;
        if byte == cast<u8>(34) or byte == cast<u8>(92) or byte == cast<u8>(47) {
            return byte;
        }
        if byte == cast<u8>(110) {
            return cast<u8>(10);
        }
        if byte == cast<u8>(114) {
            return cast<u8>(13);
        }
        if byte == cast<u8>(116) {
            return cast<u8>(9);
        }
        if byte == cast<u8>(98) {
            return cast<u8>(8);
        }
        if byte == cast<u8>(102) {
            return cast<u8>(12);
        }
        if byte == cast<u8>(117) {
            if hex4_value(bytes, index) |code| {
                if code < 128 {
                    return cast<u8>(code);
                }
            }
            return null;
        }
    }
    return null;
}

fn hex4_value(bytes: []u8, index: &var i64) -> ?i64 {
    var value = 0;
    var count = 0;
    while count < 4 {
        if std::mem::byte_at(bytes, index.*) |byte| {
            if hex_value(byte) |digit| {
                value = value * 16 + digit;
                index.* = index.* + 1;
                count = count + 1;
            } else {
                return null;
            }
        } else {
            return null;
        }
    }
    return value;
}

// A Value is a JSON document read without deciding its type first. It is an
// ordinary recursive union, not a document-object layer: `decode<Value>` goes
// through the same parser every other type does, so the defenses against
// untrusted input sit in one place and there is one route to a value
// (ADR-0115).
//
// `Obj` is the map a JSON object is: keys with the values they name, in the
// order the document wrote them (ADR-0088). It owns both, so the keys outlive
// the bytes they were read from.
//
// A number is `F64` when its spelling has a fraction or an exponent and `I64`
// otherwise, so `1.0` stays a float and `1` stays an integer through a round
// trip. An integer spelling `i64` cannot hold is `InvalidNumber`, not a float
// that has lost digits.
pub union Value {
    Null,
    Bool(bool),
    I64(i64),
    F64(f64),
    Str(std::string::String),
    Arr(std::array::Array<std::json::Value>),
    Obj(std::map::Map<[]u8, std::json::Value>),
}

fn (self: Value) deinit(allocator: Allocator) -> void {
    match self {
        Null => return,
        Bool(_) => return,
        I64(_) => return,
        F64(_) => return,
        Str(text) => text.deinit(allocator),
        Arr(items) => items.deinit(allocator),
        Obj(entries) => entries.deinit(allocator),
    }
    return;
}

// decode reads one JSON document as a `T`.
//
// The document must name every public field of `T`, and may name nothing else:
// a key `T` has no field for is an error rather than a value quietly dropped.
// `decode_ignore_unknown` is the spelling that drops them, named so that a
// reader sees which one a call chose (原理 3).
pub fn decode<T>(allocator: Allocator, bytes: []u8) -> std::json::DecodeError!T {
    try check_one_document(bytes);
    var index = 0;
    return decode_value<T>(allocator, bytes, &var index, false);
}

// decode_ignore_unknown reads one JSON document as a `T`, dropping the keys
// `T` has no field for.
pub fn decode_ignore_unknown<T>(allocator: Allocator, bytes: []u8) -> std::json::DecodeError!T {
    try check_one_document(bytes);
    var index = 0;
    return decode_value<T>(allocator, bytes, &var index, true);
}

fn check_one_document(bytes: []u8) -> std::json::DecodeError!void {
    var index = 0;
    try skip_value(bytes, &var index, 0);
    try expect_end(bytes, &var index);
    return;
}

fn expect_end(bytes: []u8, index: &var i64) -> Error!void {
    skip_space(bytes, index);
    if std::mem::byte_at(bytes, index.*) |_| {
        return Error::UnexpectedToken;
    }
    return;
}

fn decode_value<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> std::json::DecodeError!T {
    comptime if T == type<i64> {
        return try decode_i64(bytes, index);
    } else {
        comptime if T == type<f64> {
            return decode_f64(allocator, bytes, index);
        } else {
            comptime if T == type<bool> {
                return try decode_bool(bytes, index);
            } else {
                comptime if T == type<std::string::String> {
                    return decode_string(allocator, bytes, index);
                } else {
                    comptime if T == type<std::json::Value> {
                        return decode_any(allocator, bytes, index, 0);
                    } else {
                        comptime if std::meta::is_array<T>()
                            or std::meta::is_map<T>()
                            or std::meta::is_box<T>() {
                            return decode_container_value<T>(allocator, bytes, index, ignore_unknown);
                        } else {
                            comptime if std::meta::has_public_fields<T>() {
                                return decode_struct<T>(allocator, bytes, index, ignore_unknown);
                            } else {
                                comptime if std::meta::is_enum<T>()
                                    or std::meta::is_union<T>() {
                                    return decode_variant<T>(allocator, bytes, index, ignore_unknown);
                                } else {
                                    return std::meta::unsupported<T>();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn decode_any(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    depth: i64,
) -> std::json::DecodeError!std::json::Value {
    if depth > max_depth() {
        return Error::DepthExceeded;
    }
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(123) {
            return decode_any_object(allocator, bytes, index, depth);
        }
        if byte == cast<u8>(91) {
            return decode_any_array(allocator, bytes, index, depth);
        }
        if byte == cast<u8>(34) {
            return std::json::Value::Str(try decode_string(allocator, bytes, index));
        }
        if byte == cast<u8>(116) or byte == cast<u8>(102) {
            return std::json::Value::Bool(try decode_bool(bytes, index));
        }
        if byte == cast<u8>(110) {
            try decode_null(bytes, index);
            return std::json::Value::Null;
        }
        let number = try scan_number(bytes, index);
        if number.integral {
            return std::json::Value::I64(try integer_of(bytes, &number));
        }
        return std::json::Value::F64(try float_of(allocator, bytes, &number));
    }
    return Error::UnexpectedToken;
}

fn decode_any_array(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    depth: i64,
) -> std::json::DecodeError!std::json::Value {
    try expect_byte(bytes, index, cast<u8>(91));
    var items = std::array::new<std::json::Value>(allocator);
    errdefer items.deinit(allocator);
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(93) {
            index.* = index.* + 1;
            return std::json::Value::Arr(move items);
        }
    }
    var more = true;
    while more {
        let item = try decode_any(allocator, bytes, index, depth + 1);
        try items.append(allocator, move item);
        more = try comma_or_close(bytes, index, cast<u8>(93));
    }
    return std::json::Value::Arr(move items);
}

fn decode_any_object(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    depth: i64,
) -> std::json::DecodeError!std::json::Value {
    try expect_byte(bytes, index, cast<u8>(123));
    var entries = std::map::new<[]u8, std::json::Value>(allocator);
    errdefer entries.deinit(allocator);
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(125) {
            index.* = index.* + 1;
            return std::json::Value::Obj(move entries);
        }
    }
    var more = true;
    while more {
        skip_space(bytes, index);
        var key = try decode_string(allocator, bytes, index);
        defer key.deinit(allocator);
        let name = key.as_bytes();
        if entries.contains(name) {
            return Error::DuplicateField;
        }
        try expect_byte(bytes, index, cast<u8>(58));
        let value = try decode_any(allocator, bytes, index, depth + 1);
        try entries.insert(allocator, name, move value);
        more = try comma_or_close(bytes, index, cast<u8>(125));
    }
    return std::json::Value::Obj(move entries);
}

fn decode_container_value<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> std::json::DecodeError!T {
    comptime if std::meta::is_array<T>() {
        return decode_array<T>(allocator, bytes, index, ignore_unknown);
    } else {
        comptime if std::meta::is_map<T>() {
            return decode_map<T>(allocator, bytes, index, ignore_unknown);
        } else {
            let held = try decode_value<std::meta::element<T>>(allocator, bytes, index, ignore_unknown);
            return try std::mem::box<std::meta::element<T>>(allocator, move held);
        }
    }
}

fn decode_array<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> std::json::DecodeError!T {
    try expect_byte(bytes, index, cast<u8>(91));
    var items = std::array::new<std::meta::element<T>>(allocator);
    errdefer items.deinit(allocator);
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(93) {
            index.* = index.* + 1;
            return move items;
        }
    }
    var more = true;
    while more {
        let item = try decode_value<std::meta::element<T>>(allocator, bytes, index, ignore_unknown);
        try items.append(allocator, move item);
        more = try comma_or_close(bytes, index, cast<u8>(93));
    }
    return move items;
}

fn decode_map<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> std::json::DecodeError!T {
    try expect_byte(bytes, index, cast<u8>(123));
    var entries = std::map::new<[]u8, std::meta::element<T>>(allocator);
    errdefer entries.deinit(allocator);
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(125) {
            index.* = index.* + 1;
            return move entries;
        }
    }
    var more = true;
    while more {
        skip_space(bytes, index);
        var key = try decode_string(allocator, bytes, index);
        defer key.deinit(allocator);
        let name = key.as_bytes();
        if entries.contains(name) {
            return Error::DuplicateField;
        }
        try expect_byte(bytes, index, cast<u8>(58));
        let value = try decode_value<std::meta::element<T>>(allocator, bytes, index, ignore_unknown);
        try entries.insert(allocator, name, move value);
        more = try comma_or_close(bytes, index, cast<u8>(125));
    }
    return move entries;
}

fn decode_variant<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> std::json::DecodeError!T {
    skip_space(bytes, index);
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(34) {
            return decode_variant_tag<T>(bytes, index);
        }
    }
    return decode_variant_payload<T>(allocator, bytes, index, ignore_unknown);
}

fn decode_variant_tag<T>(bytes: []u8, index: &var i64) -> std::json::DecodeError!T {
    let name_at = index.*;
    try skip_string(bytes, index);
    comptime for std::meta::variants<T>() |v| {
        comptime if std::meta::has_payload<T, v>() {} else {
            if key_equals(bytes, name_at, std::meta::variant_name<T, v>()) {
                return std::meta::variant<T, v>();
            }
        }
    }
    return Error::UnknownField;
}

fn decode_variant_payload<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> std::json::DecodeError!T {
    var scan = try scan_object(allocator, bytes, index, 0);
    defer scan.deinit(allocator);
    if scan.members.len() != 1 {
        return Error::UnexpectedToken;
    }
    if scan.members.at(0) |member| {
        comptime for std::meta::variants<T>() |v| {
            comptime if std::meta::has_payload<T, v>() {
                if key_equals(bytes, member.key_at, std::meta::variant_name<T, v>()) {
                    var at = member.value_at;
                    let payload = try decode_value<std::meta::variant_type<T, v>>(allocator, bytes, &var at, ignore_unknown);
                    return std::meta::variant<T, v>(move payload);
                }
            } else {}
        }
    }
    return Error::UnknownField;
}

fn decode_struct<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> std::json::DecodeError!T {
    var scan = try scan_object(allocator, bytes, index, 0);
    defer scan.deinit(allocator);
    if !ignore_unknown {
        try reject_unknown<T>(bytes, &scan);
    }
    return std::meta::construct<T, decode_field>(allocator, bytes, &scan, ignore_unknown);
}

fn reject_unknown<T>(bytes: []u8, scan: &std::json::Scan) -> Error!void {
    var index = 0;
    while scan.members.at(index) |member| {
        if !names_field<T>(bytes, member.key_at) {
            return Error::UnknownField;
        }
        index = index + 1;
    }
    return;
}

fn names_field<T>(bytes: []u8, key_at: i64) -> bool {
    comptime for std::meta::public_fields<T>() |f| {
        if key_equals(bytes, key_at, std::meta::field_name<T, f>()) {
            return true;
        }
    }
    return false;
}

fn decode_field<T, f: Field>(
    allocator: Allocator,
    bytes: []u8,
    scan: &std::json::Scan,
    ignore_unknown: bool,
) -> std::json::DecodeError!std::meta::field_type<T, f> {
    let name = std::meta::field_name<T, f>();
    comptime if std::meta::is_optional<std::meta::field_type<T, f>>() {
        if member_named(&scan.members, bytes, name) |value_at| {
            var index = value_at;
            return decode_optional<std::meta::field_type<T, f>>(allocator, bytes, &var index, ignore_unknown);
        }
        return null;
    } else {
        if member_named(&scan.members, bytes, name) |value_at| {
            var index = value_at;
            return decode_value<std::meta::field_type<T, f>>(allocator, bytes, &var index, ignore_unknown);
        }
        return Error::MissingField;
    }
}

fn decode_optional<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> std::json::DecodeError!T {
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(110) {
            try decode_null(bytes, index);
            return null;
        }
    }
    let held = try decode_value<std::meta::element<T>>(allocator, bytes, index, ignore_unknown);
    return move held;
}
