// std::json encode v1 is an explicit streaming encoder. The caller spells
// every begin/end and field write, and the encoder owns its output buffer.
// API misuse (a field outside an object, an unbalanced end, a second
// top-level value) is a bug, so it traps instead of returning a recoverable
// error; the `!void` results only propagate allocation failures from the
// owned output. `write_*_field` pairs the key and the value in one call, so
// a key can never be left without a value.
pub struct Encoder {
    out: std::string::String,
    // The nesting state exists to detect misuse, not to drive output. Each
    // open container holds one bit in two i64 stacks: `kinds` records object
    // (1) or array (0), `nonempty` records whether the container has written
    // an element yet (comma placement). Push is *2, pop is /2, so the check
    // area holds 62 levels; deeper nesting traps.
    depth: i64,
    kinds: i64,
    nonempty: i64,
    top_written: bool,
    // What one level of indent writes: `indent_width` copies of
    // `indent_byte`. A width of zero writes the compact form, so the shape of
    // the document does not depend on which encoder made it -- only the
    // whitespace between its parts does.
    //
    // The unit is two scalars rather than the bytes themselves because a
    // `[]u8` field would make this a view-carrying type, and a view-carrying
    // type cannot be lent a view: `write_bytes_field(name, string.as_bytes())`
    // would stop compiling (SPEC §9). Which is also why the choice of space or
    // tab lives in the constructor's name instead.
    indent_byte: u8,
    indent_width: i64,
}

pub fn encoder(allocator: Allocator) -> Encoder {
    return Encoder {
        out: std::string::new(allocator),
        depth: 0,
        kinds: 0,
        nonempty: 0,
        top_written: false,
        indent_byte: cast<u8>(32),
        indent_width: 0,
    };
}

// encoder_with_spaces writes the same document broken across lines, with
// `width` spaces per level. A negative width is a bug, not a request.
pub fn encoder_with_spaces(allocator: Allocator, width: i64) -> Encoder {
    return indented_encoder(allocator, cast<u8>(32), width);
}

// encoder_with_tabs writes the same document broken across lines, with `width`
// tabs per level.
pub fn encoder_with_tabs(allocator: Allocator, width: i64) -> Encoder {
    return indented_encoder(allocator, cast<u8>(9), width);
}

fn indented_encoder(allocator: Allocator, byte: u8, width: i64) -> Encoder {
    if width < 0 {
        std::internal::builtin::panic("json encoder: indent width cannot be negative");
    }
    return Encoder {
        out: std::string::new(allocator),
        depth: 0,
        kinds: 0,
        nonempty: 0,
        top_written: false,
        indent_byte: byte,
        indent_width: width,
    };
}

fn (self: &var Encoder) begin_object() -> !void {
    try self.begin_value();
    try self.push(1, cast<u8>(123));
    return;
}

fn (self: &var Encoder) end_object() -> !void {
    if self.depth == 0 or self.kinds % 2 == 0 {
        std::internal::builtin::panic("json encoder: end_object without an open object");
    }
    try self.pop(cast<u8>(125));
    return;
}

fn (self: &var Encoder) begin_array() -> !void {
    try self.begin_value();
    try self.push(0, cast<u8>(91));
    return;
}

fn (self: &var Encoder) end_array() -> !void {
    if self.depth == 0 or self.kinds % 2 == 1 {
        std::internal::builtin::panic("json encoder: end_array without an open array");
    }
    try self.pop(cast<u8>(93));
    return;
}

fn (self: &var Encoder) begin_object_field(name: []u8) -> !void {
    try self.begin_field(name);
    try self.push(1, cast<u8>(123));
    return;
}

fn (self: &var Encoder) begin_array_field(name: []u8) -> !void {
    try self.begin_field(name);
    try self.push(0, cast<u8>(91));
    return;
}

fn (self: &var Encoder) write_i64(value: i64) -> !void {
    try self.begin_value();
    try std::fmt::append_i64(self.out, value);
    return;
}

fn (self: &var Encoder) write_bool(value: bool) -> !void {
    try self.begin_value();
    try std::fmt::append_bool(self.out, value);
    return;
}

fn (self: &var Encoder) write_null() -> !void {
    try self.begin_value();
    try self.out.append_bytes("null");
    return;
}

fn (self: &var Encoder) write_bytes(value: []u8) -> !void {
    try self.begin_value();
    try self.append_string(value);
    return;
}

fn (self: &var Encoder) write_i64_field(name: []u8, value: i64) -> !void {
    try self.begin_field(name);
    try std::fmt::append_i64(self.out, value);
    return;
}

fn (self: &var Encoder) write_bool_field(name: []u8, value: bool) -> !void {
    try self.begin_field(name);
    try std::fmt::append_bool(self.out, value);
    return;
}

fn (self: &var Encoder) write_null_field(name: []u8) -> !void {
    try self.begin_field(name);
    try self.out.append_bytes("null");
    return;
}

fn (self: &var Encoder) write_bytes_field(name: []u8, value: []u8) -> !void {
    try self.begin_field(name);
    try self.append_string(value);
    return;
}

// finish_into checks the document is complete and appends the encoded bytes
// into `out`. The encoder keeps its own buffer; `deinit` releases it. The
// checker cannot yet lend a field's bytes out of a method, so v1 copies into
// a caller buffer instead of returning a view.
fn (self: Encoder) finish_into(out: &var std::string::String) -> !void {
    if self.depth != 0 {
        std::internal::builtin::panic("json encoder: finish with an open container");
    }
    if !self.top_written {
        std::internal::builtin::panic("json encoder: finish before any value");
    }
    try out.append_string(self.out);
    return;
}

fn (self: Encoder) deinit() -> void {
    self.out.deinit();
}

// encode writes one value as a JSON document into `out`.
//
// The walk is the value's own shape read at compile time (SPEC §13.1): a
// struct becomes an object of its public fields in declaration order, and a
// field whose type is itself a struct recurses. A type this encoder has no
// case for is a compile error, not a runtime one, and not silence.
pub fn encode<T>(
    allocator: Allocator,
    value: &T,
    out: &var std::string::String,
) -> !void {
    var encoder = std::json::encoder(allocator);
    defer encoder.deinit();
    try encode_value<T>(encoder, value);
    try encoder.finish_into(out);
    return;
}

// encode_with_spaces writes the same document broken across lines, with
// `width` spaces per level. The document is the one `encode` writes; only the
// whitespace between its parts differs.
pub fn encode_with_spaces<T>(
    allocator: Allocator,
    width: i64,
    value: &T,
    out: &var std::string::String,
) -> !void {
    var encoder = std::json::encoder_with_spaces(allocator, width);
    defer encoder.deinit();
    try encode_value<T>(encoder, value);
    try encoder.finish_into(out);
    return;
}

// encode_with_tabs writes the same document with `width` tabs per level.
pub fn encode_with_tabs<T>(
    allocator: Allocator,
    width: i64,
    value: &T,
    out: &var std::string::String,
) -> !void {
    var encoder = std::json::encoder_with_tabs(allocator, width);
    defer encoder.deinit();
    try encode_value<T>(encoder, value);
    try encoder.finish_into(out);
    return;
}

// encode_value writes one bare value: the document's top level, or an array
// element. A named field goes through encode_field, so a key is never written
// without the value that belongs to it.
pub fn encode_value<T>(encoder: &var std::json::Encoder, value: &T) -> !void {
    comptime if T == type<i64> {
        try encoder.write_i64(value.*);
    } else {
        comptime if T == type<bool> {
            try encoder.write_bool(value.*);
        } else {
            comptime if T == type<[]u8> {
                try encoder.write_bytes(value.*);
            } else {
                comptime if T == type<std::string::String> {
                    let text = value.as_bytes();
                    try encoder.write_bytes(text);
                } else {
                    comptime if std::meta::has_public_fields<T>() {
                        try encoder.begin_object();
                        try encode_fields<T>(encoder, value);
                        try encoder.end_object();
                    } else {
                        comptime if std::meta::is_array<T>()
                            or std::meta::is_map<T>()
                            or std::meta::is_box<T>() {
                            try encode_container_value<T>(encoder, value);
                        } else {
                            comptime if std::meta::is_enum<T>()
                                or std::meta::is_union<T>() {
                                try encode_variant_value<T>(encoder, value);
                            } else {
                                std::meta::unsupported<T>();
                            }
                        }
                    }
                }
            }
        }
    }
    return;
}

// encode_container_value writes the containers, which carry their contents
// rather than being one: an array becomes a JSON array, a map becomes an
// object keyed by its own keys, and a box is the value it holds.
fn encode_container_value<T>(encoder: &var std::json::Encoder, value: &T) -> !void {
    comptime if std::meta::is_array<T>() {
        try encoder.begin_array();
        try encode_elements<T>(encoder, value);
        try encoder.end_array();
    } else {
        comptime if std::meta::is_map<T>() {
            try encoder.begin_object();
            try encode_entries<T>(encoder, value);
            try encoder.end_object();
        } else {
            let held = value.borrow();
            try encode_value<std::meta::element<T>>(encoder, held);
        }
    }
    return;
}

// encode_elements writes an array's elements into the array already open, in
// index order.
fn encode_elements<T>(encoder: &var std::json::Encoder, value: &T) -> !void {
    var index = 0;
    while index < value.len() {
        if value.at(index) |elem| {
            try encode_value<std::meta::element<T>>(encoder, elem);
        }
        index = index + 1;
    }
    return;
}

// encode_entries writes a map's entries into the object already open. The
// order is `key_at`'s insertion order, so the same map encodes the same way
// every run.
fn encode_entries<T>(encoder: &var std::json::Encoder, value: &T) -> !void {
    var index = 0;
    while value.key_at(index) |key| {
        if value.at(key) |entry| {
            try encode_field<std::meta::element<T>>(encoder, key, entry);
        }
        index = index + 1;
    }
    return;
}

// encode_fields writes a struct's public fields into the object already open.
//
// An optional field is opened here rather than in encode_field: `?T` cannot be
// a static argument (ADR-0101), so the optional is unwrapped at run time and
// what recurses is the type it holds.
fn encode_fields<T>(encoder: &var std::json::Encoder, value: &T) -> !void {
    comptime for std::meta::public_fields<T>() |f| {
        comptime if std::meta::is_optional<std::meta::field_type<T, f>>() {
            if std::meta::field<T, f>(value) |held| {
                try encode_field<std::meta::element<std::meta::field_type<T, f>>>(
                    encoder,
                    std::meta::field_name<T, f>(),
                    held,
                );
            } else {
                try encoder.write_null_field(std::meta::field_name<T, f>());
            }
        } else {
            try encode_field<std::meta::field_type<T, f>>(
                encoder,
                std::meta::field_name<T, f>(),
                std::meta::field<T, f>(value),
            );
        }
    }
    return;
}

// encode_field writes one named field. Each case enters through a call that
// carries the key, so the key and its value are written together.
fn encode_field<T>(
    encoder: &var std::json::Encoder,
    name: []u8,
    value: &T,
) -> !void {
    comptime if T == type<i64> {
        try encoder.write_i64_field(name, value.*);
    } else {
        comptime if T == type<bool> {
            try encoder.write_bool_field(name, value.*);
        } else {
            comptime if T == type<[]u8> {
                try encoder.write_bytes_field(name, value.*);
            } else {
                comptime if T == type<std::string::String> {
                    let text = value.as_bytes();
                    try encoder.write_bytes_field(name, text);
                } else {
                    comptime if std::meta::has_public_fields<T>() {
                        try encoder.begin_object_field(name);
                        try encode_fields<T>(encoder, value);
                        try encoder.end_object();
                    } else {
                        comptime if std::meta::is_array<T>()
                            or std::meta::is_map<T>()
                            or std::meta::is_box<T>() {
                            try encode_container_field<T>(encoder, name, value);
                        } else {
                            comptime if std::meta::is_enum<T>()
                                or std::meta::is_union<T>() {
                                try encode_variant_field<T>(encoder, name, value);
                            } else {
                                std::meta::unsupported<T>();
                            }
                        }
                    }
                }
            }
        }
    }
    return;
}

// encode_container_field is encode_container_value with the key written by the
// call that opens the container.
fn encode_container_field<T>(
    encoder: &var std::json::Encoder,
    name: []u8,
    value: &T,
) -> !void {
    comptime if std::meta::is_array<T>() {
        try encoder.begin_array_field(name);
        try encode_elements<T>(encoder, value);
        try encoder.end_array();
    } else {
        comptime if std::meta::is_map<T>() {
            try encoder.begin_object_field(name);
            try encode_entries<T>(encoder, value);
            try encoder.end_object();
        } else {
            let held = value.borrow();
            try encode_field<std::meta::element<T>>(encoder, name, held);
        }
    }
    return;
}

// encode_variant_value writes one variant of an enum or union. A variant that
// carries nothing is the string naming it; one that carries a payload is the
// single-key object `{"Name": payload}`. An enum is the case where no variant
// carries anything, so it needs no rule of its own: `Color::Red` is `"Red"`
// because that is what a payload-free variant is.
//
// `Value` is the exception, and takes the first branch: its variants name
// JSON's own shapes rather than a program's, so tagging them would wrap a
// document that already says what it is.
fn encode_variant_value<T>(encoder: &var std::json::Encoder, value: &T) -> !void {
    comptime if T == type<std::json::Value> {
        try encode_any_value(encoder, value);
    } else {
        comptime match value |v, payload| {
            comptime if std::meta::has_payload<T, v>() {
                try encoder.begin_object();
                try encode_field<std::meta::variant_type<T, v>>(
                    encoder,
                    std::meta::variant_name<T, v>(),
                    payload,
                );
                try encoder.end_object();
            } else {
                try encoder.write_bytes(std::meta::variant_name<T, v>());
            }
        }
    }
    return;
}

// encode_variant_field is encode_variant_value with the key written by the
// call that opens the value.
fn encode_variant_field<T>(
    encoder: &var std::json::Encoder,
    name: []u8,
    value: &T,
) -> !void {
    comptime if T == type<std::json::Value> {
        try encode_any_field(encoder, name, value);
    } else {
        comptime match value |v, payload| {
            comptime if std::meta::has_payload<T, v>() {
                try encoder.begin_object_field(name);
                try encode_field<std::meta::variant_type<T, v>>(
                    encoder,
                    std::meta::variant_name<T, v>(),
                    payload,
                );
                try encoder.end_object();
            } else {
                try encoder.write_bytes_field(name, std::meta::variant_name<T, v>());
            }
        }
    }
    return;
}

// encode_any_value writes a `Value` as the document it was read from, so a
// document that came in through `decode<Value>` goes back out unchanged apart
// from whitespace.
fn encode_any_value(
    encoder: &var std::json::Encoder,
    value: &std::json::Value,
) -> !void {
    match value {
        Null => try encoder.write_null(),
        Bool(flag) => try encoder.write_bool(flag),
        I64(number) => try encoder.write_i64(number),
        Str(text) => {
            let bytes = text.as_bytes();
            try encoder.write_bytes(bytes);
        },
        Arr(items) => {
            try encoder.begin_array();
            try encode_any_elements(encoder, items);
            try encoder.end_array();
        },
        Obj(entries) => {
            try encoder.begin_object();
            try encode_any_entries(encoder, entries);
            try encoder.end_object();
        },
    }
    return;
}

// encode_any_field is encode_any_value with the key written by the call that
// opens the value.
fn encode_any_field(
    encoder: &var std::json::Encoder,
    name: []u8,
    value: &std::json::Value,
) -> !void {
    match value {
        Null => try encoder.write_null_field(name),
        Bool(flag) => try encoder.write_bool_field(name, flag),
        I64(number) => try encoder.write_i64_field(name, number),
        Str(text) => {
            let bytes = text.as_bytes();
            try encoder.write_bytes_field(name, bytes);
        },
        Arr(items) => {
            try encoder.begin_array_field(name);
            try encode_any_elements(encoder, items);
            try encoder.end_array();
        },
        Obj(entries) => {
            try encoder.begin_object_field(name);
            try encode_any_entries(encoder, entries);
            try encoder.end_object();
        },
    }
    return;
}

// encode_any_elements writes a `Value` array's elements into the array already
// open, in index order.
fn encode_any_elements(
    encoder: &var std::json::Encoder,
    items: &std::array::Array<std::json::Value>,
) -> !void {
    var index = 0;
    while items.at(index) |elem| {
        try encode_any_value(encoder, elem);
        index = index + 1;
    }
    return;
}

// encode_any_entries writes a `Value` object's entries into the object already
// open, in the order the document wrote them.
fn encode_any_entries(
    encoder: &var std::json::Encoder,
    entries: &std::array::Array<std::json::Entry>,
) -> !void {
    var index = 0;
    while entries.at(index) |entry| {
        let key = entry.key.as_bytes();
        try encode_any_field(encoder, key, &entry.value);
        index = index + 1;
    }
    return;
}

// begin_value checks that a bare value may start here: the single top-level
// slot or an array element. Inside an object a value needs a field name, so
// a bare value there is misuse.
fn (self: &var Encoder) begin_value() -> !void {
    if self.depth == 0 {
        if self.top_written {
            std::internal::builtin::panic("json encoder: second top-level value");
        }
        self.top_written = true;
        return;
    }
    if self.kinds % 2 == 1 {
        std::internal::builtin::panic("json encoder: bare value inside an object");
    }
    try self.mark_element();
    return;
}

// begin_field checks that a named field may start here (inside an object)
// and writes the separator, the escaped name, and the colon.
fn (self: &var Encoder) begin_field(name: []u8) -> !void {
    if self.depth == 0 or self.kinds % 2 == 0 {
        std::internal::builtin::panic("json encoder: field outside an object");
    }
    try self.mark_element();
    try self.append_string(name);
    try self.out.append_byte(cast<u8>(58));
    if self.indent_width > 0 {
        try self.out.append_byte(cast<u8>(32));
    }
    return;
}

fn (self: &var Encoder) mark_element() -> !void {
    if self.nonempty % 2 == 1 {
        try self.out.append_byte(cast<u8>(44));
    } else {
        self.nonempty = self.nonempty + 1;
    }
    try self.break_line(self.depth);
    return;
}

// break_line starts a new line indented for `level` open containers. It writes
// nothing in the compact form, which is what keeps one separator path for both
// forms instead of two writers.
fn (self: &var Encoder) break_line(level: i64) -> !void {
    if self.indent_width == 0 {
        return;
    }
    try self.out.append_byte(cast<u8>(10));
    var remaining = level * self.indent_width;
    while remaining > 0 {
        try self.out.append_byte(self.indent_byte);
        remaining = remaining - 1;
    }
    return;
}

fn (self: &var Encoder) push(kind: i64, open: u8) -> !void {
    if self.depth == 62 {
        std::internal::builtin::panic("json encoder: nesting deeper than 62 levels");
    }
    self.depth = self.depth + 1;
    self.kinds = self.kinds * 2 + kind;
    self.nonempty = self.nonempty * 2;
    try self.out.append_byte(open);
    return;
}

fn (self: &var Encoder) pop(close: u8) -> !void {
    let had_element = self.nonempty % 2 == 1;
    self.depth = self.depth - 1;
    self.kinds = self.kinds / 2;
    self.nonempty = self.nonempty / 2;
    // An empty container stays on one line: there is nothing to indent, and
    // `{\n}` reads as a container whose contents went missing.
    if had_element {
        try self.break_line(self.depth);
    }
    try self.out.append_byte(close);
    return;
}

// append_string writes one JSON string: quoted, with the two-character JSON
// escapes for quote, backslash, newline, carriage return, and tab, and
// \u00XX for the remaining control bytes. Bytes are escaped
// deterministically; encode v1 does not validate UTF-8.
fn (self: &var Encoder) append_string(bytes: []u8) -> !void {
    try self.out.append_byte(cast<u8>(34));
    var index = 0;
    let length = std::mem::len(bytes);
    while index < length {
        let byte = bytes[index];
        if byte == cast<u8>(34) or byte == cast<u8>(92) {
            try self.out.append_byte(cast<u8>(92));
            try self.out.append_byte(byte);
        } else {
            if byte == cast<u8>(10) {
                try self.out.append_bytes("\n");
            } else {
                if byte == cast<u8>(13) {
                    try self.out.append_bytes("\r");
                } else {
                    if byte == cast<u8>(9) {
                        try self.out.append_bytes("\t");
                    } else {
                        if byte < cast<u8>(32) {
                            try self.out.append_bytes("\u00");
                            try self.out.append_byte(hex_digit(byte / cast<u8>(16)));
                            try self.out.append_byte(hex_digit(byte % cast<u8>(16)));
                        } else {
                            try self.out.append_byte(byte);
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    try self.out.append_byte(cast<u8>(34));
    return;
}

fn hex_digit(value: u8) -> u8 {
    if value < cast<u8>(10) {
        return cast<u8>(48) + value;
    }
    return cast<u8>(87) + value;
}

// --- decode ------------------------------------------------------------
//
// decode reads bytes straight into `T`. There is no document object between
// them: a DOM would need its own place to live, would have to defend against
// untrusted input on its own, and would leave two routes to a value -- one
// through the DOM and one into a type (ADR-0115, #1626).
//
// Parse state is two arguments, `bytes: []u8` and `index: &var i64`, rather
// than a cursor struct. A struct holding a view cannot be passed as `&var`
// (ADR-0100), so splitting the state keeps `decode<T>` an ordinary generic
// free function.

pub error Error {
    // The bytes are not JSON at this point.
    UnexpectedToken,
    // The document is JSON, but does not describe a `T`: a field of `T` is
    // absent, the document names one `T` does not have, or one key appears
    // twice. The caller recovers by decoding into a different type or by
    // asking for the variant that ignores unknown keys.
    MissingField,
    UnknownField,
    DuplicateField,
    // A number that JSON allows and `i64` cannot hold. std::json v1 has no
    // float: SPEC §7 reserves `f64` but the language has no float arithmetic.
    InvalidNumber,
    // The escape is well-formed JSON that names no character: a lone
    // surrogate half, or a `\` before something that is not an escape.
    InvalidEscape,
    // Input-dependent, so it is recoverable rather than a trap: the caller
    // rejects the document, the way it rejects any other malformed input.
    DepthExceeded,
}

// max_depth bounds nesting so a deep document cannot exhaust the stack. There
// is no input size limit: the caller already holds the bytes and decides how
// many there are.
fn max_depth() -> i64 {
    return 128;
}

fn is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9)
        or byte == cast<u8>(10) or byte == cast<u8>(13);
}

// skip_space advances past whitespace and leaves index on the next byte, or on
// the end of input.
fn skip_space(bytes: []u8, index: &var i64) -> void {
    while std::mem::byte_at(bytes, index.*) |byte| {
        if !is_space(byte) {
            return;
        }
        index.* = index.* + 1;
    }
    return;
}

// peek_byte reads the next non-space byte without consuming it.
fn peek_byte(bytes: []u8, index: &var i64) -> ?u8 {
    skip_space(bytes, index);
    return std::mem::byte_at(bytes, index.*);
}

// expect_byte consumes one specific byte, and fails when the document has
// something else there.
fn expect_byte(bytes: []u8, index: &var i64, want: u8) -> Error!void {
    if peek_byte(bytes, index) |byte| {
        if byte == want {
            index.* = index.* + 1;
            return;
        }
    }
    return Error::UnexpectedToken;
}

// expect_literal consumes one of the three bare words JSON has.
fn expect_literal(bytes: []u8, index: &var i64, word: []u8) -> Error!void {
    skip_space(bytes, index);
    if std::mem::slice(bytes, index.*, index.* + std::mem::len(word)) |seen| {
        if std::mem::equal_bytes(seen, word) {
            index.* = index.* + std::mem::len(word);
            return;
        }
    }
    return Error::UnexpectedToken;
}

// decode_bool reads `true` or `false`.
fn decode_bool(bytes: []u8, index: &var i64) -> Error!bool {
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(116) {
            try expect_literal(bytes, index, "true");
            return true;
        }
        if byte == cast<u8>(102) {
            try expect_literal(bytes, index, "false");
            return false;
        }
    }
    return Error::UnexpectedToken;
}

// decode_null reads `null`.
fn decode_null(bytes: []u8, index: &var i64) -> Error!void {
    try expect_literal(bytes, index, "null");
    return;
}

fn is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}

// decode_i64 reads an integer. JSON allows a fraction and an exponent; std::json
// v1 has neither, because the language has no float arithmetic (SPEC §7
// reserves `f64` and no more), so a number that is not an integer is an error
// rather than a silently truncated value.
fn decode_i64(bytes: []u8, index: &var i64) -> Error!i64 {
    skip_space(bytes, index);
    var negative = false;
    if std::mem::byte_at(bytes, index.*) |byte| {
        if byte == cast<u8>(45) {
            negative = true;
            index.* = index.* + 1;
        }
    }
    var digits = 0;
    var value = 0;
    while std::mem::byte_at(bytes, index.*) |byte| {
        if !is_digit(byte) {
            break;
        }
        // The bound keeps the multiply below from overflowing before the
        // digit is added; a number this long is out of range either way.
        if value > 922337203685477580 {
            return Error::InvalidNumber;
        }
        value = value * 10 + cast<i64>(byte - cast<u8>(48));
        digits = digits + 1;
        index.* = index.* + 1;
    }
    if digits == 0 {
        return Error::UnexpectedToken;
    }
    if std::mem::byte_at(bytes, index.*) |byte| {
        if byte == cast<u8>(46) or byte == cast<u8>(101) or byte == cast<u8>(69) {
            return Error::InvalidNumber;
        }
    }
    if negative {
        return 0 - value;
    }
    return value;
}

fn hex_value(byte: u8) -> ?i64 {
    if is_digit(byte) {
        return cast<i64>(byte - cast<u8>(48));
    }
    if byte >= cast<u8>(97) and byte <= cast<u8>(102) {
        return cast<i64>(byte - cast<u8>(87));
    }
    if byte >= cast<u8>(65) and byte <= cast<u8>(70) {
        return cast<i64>(byte - cast<u8>(55));
    }
    return null;
}

// read_hex4 reads the four hex digits of a `\uXXXX` escape.
fn read_hex4(bytes: []u8, index: &var i64) -> Error!i64 {
    var value = 0;
    var count = 0;
    while count < 4 {
        if std::mem::byte_at(bytes, index.*) |byte| {
            if hex_value(byte) |digit| {
                value = value * 16 + digit;
                index.* = index.* + 1;
                count = count + 1;
            } else {
                return Error::InvalidEscape;
            }
        } else {
            return Error::InvalidEscape;
        }
    }
    return value;
}

// append_utf8 writes one code point as UTF-8.
fn append_utf8(out: &var std::string::String, code: i64) -> !void {
    if code < 128 {
        try out.append_byte(cast<u8>(code));
        return;
    }
    if code < 2048 {
        try out.append_byte(cast<u8>(192 + code / 64));
        try out.append_byte(cast<u8>(128 + code % 64));
        return;
    }
    if code < 65536 {
        try out.append_byte(cast<u8>(224 + code / 4096));
        try out.append_byte(cast<u8>(128 + code / 64 % 64));
        try out.append_byte(cast<u8>(128 + code % 64));
        return;
    }
    try out.append_byte(cast<u8>(240 + code / 262144));
    try out.append_byte(cast<u8>(128 + code / 4096 % 64));
    try out.append_byte(cast<u8>(128 + code / 64 % 64));
    try out.append_byte(cast<u8>(128 + code % 64));
    return;
}

// decode_escape reads what follows a `\` and appends the character it names.
// A `\uXXXX` above the basic plane arrives as a surrogate pair, so the high
// half consumes its low half here; a half on its own names no character.
fn decode_escape(bytes: []u8, index: &var i64, out: &var std::string::String) -> !void {
    if std::mem::byte_at(bytes, index.*) |byte| {
        index.* = index.* + 1;
        if byte == cast<u8>(34) or byte == cast<u8>(92) or byte == cast<u8>(47) {
            try out.append_byte(byte);
            return;
        }
        if byte == cast<u8>(110) {
            try out.append_byte(cast<u8>(10));
            return;
        }
        if byte == cast<u8>(114) {
            try out.append_byte(cast<u8>(13));
            return;
        }
        if byte == cast<u8>(116) {
            try out.append_byte(cast<u8>(9));
            return;
        }
        if byte == cast<u8>(98) {
            try out.append_byte(cast<u8>(8));
            return;
        }
        if byte == cast<u8>(102) {
            try out.append_byte(cast<u8>(12));
            return;
        }
        if byte == cast<u8>(117) {
            let code = try read_hex4(bytes, index);
            try append_utf8(out, try pair_surrogate(bytes, index, code));
            return;
        }
    }
    return Error::InvalidEscape;
}

// pair_surrogate joins a high surrogate with the low half that must follow it,
// and returns any other code point unchanged.
fn pair_surrogate(bytes: []u8, index: &var i64, code: i64) -> Error!i64 {
    if code < 55296 or code > 57343 {
        return code;
    }
    if code > 56319 {
        return Error::InvalidEscape;
    }
    try expect_byte(bytes, index, cast<u8>(92));
    try expect_byte(bytes, index, cast<u8>(117));
    let low = try read_hex4(bytes, index);
    if low < 56320 or low > 57343 {
        return Error::InvalidEscape;
    }
    return 65536 + (code - 55296) * 1024 + (low - 56320);
}

// decode_string reads a JSON string into an owned buffer, undoing escapes.
fn decode_string(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
) -> !std::string::String {
    try expect_byte(bytes, index, cast<u8>(34));
    var out = std::string::new(allocator);
    errdefer out.deinit();
    while std::mem::byte_at(bytes, index.*) |byte| {
        index.* = index.* + 1;
        if byte == cast<u8>(34) {
            return out;
        }
        if byte == cast<u8>(92) {
            try decode_escape(bytes, index, &var out);
        } else {
            try out.append_byte(byte);
        }
    }
    return Error::UnexpectedToken;
}

// skip_value advances past one complete value without building it. Scanning an
// object records where each value starts and comes back for the ones the type
// asks for, so the values in between are only measured, never decoded.
fn skip_value(bytes: []u8, index: &var i64, depth: i64) -> Error!void {
    if depth > max_depth() {
        return Error::DepthExceeded;
    }
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(123) {
            return skip_object(bytes, index, depth);
        }
        if byte == cast<u8>(91) {
            return skip_array(bytes, index, depth);
        }
        if byte == cast<u8>(34) {
            return skip_string(bytes, index);
        }
        if byte == cast<u8>(116) or byte == cast<u8>(102) {
            let _ = try decode_bool(bytes, index);
            return;
        }
        if byte == cast<u8>(110) {
            return decode_null(bytes, index);
        }
        let _ = try decode_i64(bytes, index);
        return;
    }
    return Error::UnexpectedToken;
}

// skip_string advances past a string. Escapes are not undone here, only
// stepped over, so that a `\"` does not end the string.
fn skip_string(bytes: []u8, index: &var i64) -> Error!void {
    try expect_byte(bytes, index, cast<u8>(34));
    while std::mem::byte_at(bytes, index.*) |byte| {
        index.* = index.* + 1;
        if byte == cast<u8>(34) {
            return;
        }
        if byte == cast<u8>(92) {
            index.* = index.* + 1;
        }
    }
    return Error::UnexpectedToken;
}

fn skip_object(bytes: []u8, index: &var i64, depth: i64) -> Error!void {
    try expect_byte(bytes, index, cast<u8>(123));
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(125) {
            index.* = index.* + 1;
            return;
        }
    }
    var more = true;
    while more {
        try skip_string(bytes, index);
        try expect_byte(bytes, index, cast<u8>(58));
        try skip_value(bytes, index, depth + 1);
        more = try comma_or_close(bytes, index, cast<u8>(125));
    }
    return;
}

fn skip_array(bytes: []u8, index: &var i64, depth: i64) -> Error!void {
    try expect_byte(bytes, index, cast<u8>(91));
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(93) {
            index.* = index.* + 1;
            return;
        }
    }
    var more = true;
    while more {
        try skip_value(bytes, index, depth + 1);
        more = try comma_or_close(bytes, index, cast<u8>(93));
    }
    return;
}

// comma_or_close consumes the byte that separates or ends a sequence, and
// reports whether another element follows.
fn comma_or_close(bytes: []u8, index: &var i64, close: u8) -> Error!bool {
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(44) {
            index.* = index.* + 1;
            return true;
        }
        if byte == close {
            index.* = index.* + 1;
            return false;
        }
    }
    return Error::UnexpectedToken;
}

// A Member is one key of an object with the offsets it and its value start at.
// The key stays where it is: comparing it against a field name undoes escapes
// as it walks, so a key costs no allocation and an escaped key still matches
// the field it names.
pub struct Member {
    pub key_at: i64,
    pub value_at: i64,
}

// A Scan is what one object looked like: its members in document order. The
// fields of `T` are filled from it in declaration order, so a document may
// name them in any order.
pub struct Scan {
    pub members: std::array::Array<Member>,
}

fn (self: Scan) deinit() -> void {
    self.members.deinit();
    return;
}

// scan_object records every key of one object and where its value begins.
// Duplicate keys are an error: keeping one of the two would silently drop a
// value the document meant to carry.
fn scan_object(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    depth: i64,
) -> !Scan {
    if depth > max_depth() {
        return Error::DepthExceeded;
    }
    try expect_byte(bytes, index, cast<u8>(123));
    var members = std::array::new<Member>(allocator);
    errdefer members.deinit();
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(125) {
            index.* = index.* + 1;
            return Scan { members: members };
        }
    }
    var more = true;
    while more {
        skip_space(bytes, index);
        let key_at = index.*;
        try skip_string(bytes, index);
        try expect_byte(bytes, index, cast<u8>(58));
        skip_space(bytes, index);
        let member = Member { key_at: key_at, value_at: index.* };
        if member_at(&members, bytes, key_at) |_| {
            return Error::DuplicateField;
        }
        try members.append(member);
        try skip_value(bytes, index, depth + 1);
        more = try comma_or_close(bytes, index, cast<u8>(125));
    }
    return Scan { members: members };
}

// member_at finds where the value of the key spelled at key_at begins.
fn member_at(
    members: &std::array::Array<Member>,
    bytes: []u8,
    key_at: i64,
) -> ?i64 {
    var index = 0;
    while members.at(index) |member| {
        if same_key(bytes, member.key_at, key_at) {
            return member.value_at;
        }
        index = index + 1;
    }
    return null;
}

// member_named finds where the value of one field's key begins.
fn member_named(
    members: &std::array::Array<Member>,
    bytes: []u8,
    name: []u8,
) -> ?i64 {
    var index = 0;
    while members.at(index) |member| {
        if key_equals(bytes, member.key_at, name) {
            return member.value_at;
        }
        index = index + 1;
    }
    return null;
}

// key_equals compares the string spelled at key_at with a field name, undoing
// escapes as it walks so that `"\u0061"` matches `a`.
fn key_equals(bytes: []u8, key_at: i64, name: []u8) -> bool {
    var index = key_at + 1;
    var seen = 0;
    let length = std::mem::len(name);
    while std::mem::byte_at(bytes, index) |byte| {
        if byte == cast<u8>(34) {
            return seen == length;
        }
        if byte == cast<u8>(92) {
            index = index + 1;
            if escape_byte(bytes, &var index) |decoded| {
                if seen >= length or name[seen] != decoded {
                    return false;
                }
                seen = seen + 1;
            } else {
                return false;
            }
        } else {
            if seen >= length or name[seen] != byte {
                return false;
            }
            seen = seen + 1;
            index = index + 1;
        }
    }
    return false;
}

// same_key compares two keys of the same document.
fn same_key(bytes: []u8, left_at: i64, right_at: i64) -> bool {
    var left = left_at;
    var right = right_at;
    while std::mem::byte_at(bytes, left) |byte| {
        if std::mem::byte_at(bytes, right) |other| {
            if byte != other {
                return false;
            }
            if byte == cast<u8>(34) and left > left_at {
                return true;
            }
            if byte == cast<u8>(92) {
                left = left + 1;
                right = right + 1;
            }
            left = left + 1;
            right = right + 1;
        } else {
            return false;
        }
    }
    return false;
}

// escape_byte reads one escape that names a single byte, which is what a key
// matching a Kizu field name can hold. A multi-byte escape names no field, so
// it stops the comparison rather than being decoded.
fn escape_byte(bytes: []u8, index: &var i64) -> ?u8 {
    if std::mem::byte_at(bytes, index.*) |byte| {
        index.* = index.* + 1;
        if byte == cast<u8>(34) or byte == cast<u8>(92) or byte == cast<u8>(47) {
            return byte;
        }
        if byte == cast<u8>(110) {
            return cast<u8>(10);
        }
        if byte == cast<u8>(114) {
            return cast<u8>(13);
        }
        if byte == cast<u8>(116) {
            return cast<u8>(9);
        }
        if byte == cast<u8>(98) {
            return cast<u8>(8);
        }
        if byte == cast<u8>(102) {
            return cast<u8>(12);
        }
        if byte == cast<u8>(117) {
            if hex4_value(bytes, index) |code| {
                if code < 128 {
                    return cast<u8>(code);
                }
            }
            return null;
        }
    }
    return null;
}

// hex4_value reads four hex digits without failing the whole parse: a key that
// does not match is not an error, it is a different key.
fn hex4_value(bytes: []u8, index: &var i64) -> ?i64 {
    var value = 0;
    var count = 0;
    while count < 4 {
        if std::mem::byte_at(bytes, index.*) |byte| {
            if hex_value(byte) |digit| {
                value = value * 16 + digit;
                index.* = index.* + 1;
                count = count + 1;
            } else {
                return null;
            }
        } else {
            return null;
        }
    }
    return value;
}

// A Value is a JSON document read without deciding its type first. It is an
// ordinary recursive union, not a document-object layer: `decode<Value>` goes
// through the same parser every other type does, so the defenses against
// untrusted input sit in one place and there is one route to a value
// (ADR-0115).
//
// `Obj` is an `Array<Entry>` rather than a map: a map's value type is copy-only
// and a `Value` owns its contents. The array also keeps the keys in the order
// the document wrote them.
pub union Value {
    Null,
    Bool(bool),
    I64(i64),
    Str(std::string::String),
    Arr(std::array::Array<std::json::Value>),
    Obj(std::array::Array<std::json::Entry>),
}

// An Entry is one key of an object with the value it names. Both are owned:
// the key outlives the bytes it was read from.
pub struct Entry {
    pub key: std::string::String,
    pub value: std::json::Value,
}

fn (self: Entry) deinit() -> void {
    self.key.deinit();
    self.value.deinit();
    return;
}

fn (self: Value) deinit() -> void {
    match self {
        Null => return,
        Bool(_) => return,
        I64(_) => return,
        Str(text) => text.deinit(),
        Arr(items) => items.deinit(),
        Obj(entries) => entries.deinit(),
    }
    return;
}

// decode reads one JSON document as a `T`.
//
// The document must name every public field of `T`, and may name nothing else:
// a key `T` has no field for is an error rather than a value quietly dropped.
// `decode_ignore_unknown` is the spelling that drops them, named so that a
// reader sees which one a call chose (原理 3).
pub fn decode<T>(allocator: Allocator, bytes: []u8) -> !T {
    try check_one_document(bytes);
    var index = 0;
    return decode_value<T>(allocator, bytes, &var index, false);
}

// decode_ignore_unknown reads one JSON document as a `T`, dropping the keys
// `T` has no field for.
pub fn decode_ignore_unknown<T>(allocator: Allocator, bytes: []u8) -> !T {
    try check_one_document(bytes);
    var index = 0;
    return decode_value<T>(allocator, bytes, &var index, true);
}

// check_one_document walks the bytes once before anything is built, so that a
// malformed document is refused before it has allocated. It is also what lets
// `decode` return its value directly: nothing can fail after the value exists,
// so there is no error path that would have to release it.
fn check_one_document(bytes: []u8) -> Error!void {
    var index = 0;
    try skip_value(bytes, &var index, 0);
    try expect_end(bytes, &var index);
    return;
}

// expect_end refuses trailing bytes: a second document after the first is not
// one document, and accepting it would hide half the input.
fn expect_end(bytes: []u8, index: &var i64) -> Error!void {
    skip_space(bytes, index);
    if std::mem::byte_at(bytes, index.*) |_| {
        return Error::UnexpectedToken;
    }
    return;
}

// decode_value reads one value as a `T`, dispatching on what `T` is. The set
// of types is the one `encode_value` writes, so a document this produces is
// one that produced it (原理 9). The one exception is `?T`: an optional cannot
// be a static argument (ADR-0101), so it cannot reach here at all, and a
// struct that holds one is refused with that language error rather than a
// `std::json` one.
fn decode_value<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> !T {
    comptime if T == type<i64> {
        return decode_i64(bytes, index);
    } else {
        comptime if T == type<bool> {
            return decode_bool(bytes, index);
        } else {
            comptime if T == type<std::string::String> {
                return decode_string(allocator, bytes, index);
            } else {
                comptime if T == type<std::json::Value> {
                    return decode_any(allocator, bytes, index, 0);
                } else {
                    comptime if std::meta::is_array<T>()
                        or std::meta::is_map<T>()
                        or std::meta::is_box<T>() {
                        return decode_container_value<T>(
                            allocator, bytes, index, ignore_unknown);
                    } else {
                        comptime if std::meta::has_public_fields<T>() {
                            return decode_struct<T>(allocator, bytes, index, ignore_unknown);
                        } else {
                            comptime if std::meta::is_enum<T>()
                                or std::meta::is_union<T>() {
                                return decode_variant<T>(
                                    allocator, bytes, index, ignore_unknown);
                            } else {
                                return std::meta::unsupported<T>();
                            }
                        }
                    }
                }
            }
        }
    }
}

// decode_any reads one value as a `Value`, deciding what it is from the byte
// that starts it. This is the route for documents whose shape is not known in
// advance; it is the same parser the typed route uses, so both are behind the
// same defenses.
fn decode_any(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    depth: i64,
) -> !std::json::Value {
    if depth > max_depth() {
        return Error::DepthExceeded;
    }
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(123) {
            return decode_any_object(allocator, bytes, index, depth);
        }
        if byte == cast<u8>(91) {
            return decode_any_array(allocator, bytes, index, depth);
        }
        if byte == cast<u8>(34) {
            return std::json::Value::Str(try decode_string(allocator, bytes, index));
        }
        if byte == cast<u8>(116) or byte == cast<u8>(102) {
            return std::json::Value::Bool(try decode_bool(bytes, index));
        }
        if byte == cast<u8>(110) {
            try decode_null(bytes, index);
            return std::json::Value::Null;
        }
        return std::json::Value::I64(try decode_i64(bytes, index));
    }
    return Error::UnexpectedToken;
}

fn decode_any_array(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    depth: i64,
) -> !std::json::Value {
    try expect_byte(bytes, index, cast<u8>(91));
    var items = std::array::new<std::json::Value>(allocator);
    errdefer items.deinit();
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(93) {
            index.* = index.* + 1;
            return std::json::Value::Arr(items);
        }
    }
    var more = true;
    while more {
        let item = try decode_any(allocator, bytes, index, depth + 1);
        try items.append(item);
        more = try comma_or_close(bytes, index, cast<u8>(93));
    }
    return std::json::Value::Arr(items);
}

// decode_any_object keeps the keys in document order. Duplicates are an error
// here too: which of the two survived would otherwise depend on the reader.
fn decode_any_object(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    depth: i64,
) -> !std::json::Value {
    try expect_byte(bytes, index, cast<u8>(123));
    var entries = std::array::new<std::json::Entry>(allocator);
    errdefer entries.deinit();
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(125) {
            index.* = index.* + 1;
            return std::json::Value::Obj(entries);
        }
    }
    var more = true;
    while more {
        skip_space(bytes, index);
        let key_at = index.*;
        try reject_duplicate_entry(&entries, bytes, key_at);
        var key = try decode_string(allocator, bytes, index);
        errdefer key.deinit();
        try expect_byte(bytes, index, cast<u8>(58));
        let value = try decode_any(allocator, bytes, index, depth + 1);
        try entries.append(std::json::Entry { key: key, value: value });
        more = try comma_or_close(bytes, index, cast<u8>(125));
    }
    return std::json::Value::Obj(entries);
}

// reject_duplicate_entry refuses a key the object already carries.
fn reject_duplicate_entry(
    entries: &std::array::Array<std::json::Entry>,
    bytes: []u8,
    key_at: i64,
) -> Error!void {
    var index = 0;
    while entries.at(index) |entry| {
        let seen = entry.key.as_bytes();
        if key_equals(bytes, key_at, seen) {
            return Error::DuplicateField;
        }
        index = index + 1;
    }
    return;
}

// decode_container_value reads the containers, mirroring what
// `encode_container_value` writes: a JSON array becomes an array, an object
// becomes a map keyed by its own keys, and a box is the value it holds.
fn decode_container_value<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> !T {
    comptime if std::meta::is_array<T>() {
        return decode_array<T>(allocator, bytes, index, ignore_unknown);
    } else {
        comptime if std::meta::is_map<T>() {
            return decode_map<T>(allocator, bytes, index, ignore_unknown);
        } else {
            let held = try decode_value<std::meta::element<T>>(
                allocator, bytes, index, ignore_unknown);
            return std::mem::box<std::meta::element<T>>(allocator, held);
        }
    }
}

// decode_array reads a JSON array into an owned collection. Each element is
// decoded as the array's element type, so an element the type cannot hold is
// an error rather than a value quietly skipped.
fn decode_array<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> !T {
    try expect_byte(bytes, index, cast<u8>(91));
    var items = std::array::new<std::meta::element<T>>(allocator);
    errdefer items.deinit();
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(93) {
            index.* = index.* + 1;
            return items;
        }
    }
    var more = true;
    while more {
        let item = try decode_value<std::meta::element<T>>(
            allocator, bytes, index, ignore_unknown);
        try items.append(item);
        more = try comma_or_close(bytes, index, cast<u8>(93));
    }
    return items;
}

// decode_map reads a JSON object into an owned map. Unlike a struct, a map has
// no field list to check keys against, so every key of the document is one the
// map holds and `ignore_unknown` has nothing to decide. The key is unescaped
// into a String first, then copied into the map by `insert`, so no key points
// back into the document.
fn decode_map<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> !T {
    try expect_byte(bytes, index, cast<u8>(123));
    var entries = std::map::new<[]u8, std::meta::element<T>>(allocator);
    errdefer entries.deinit();
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(125) {
            index.* = index.* + 1;
            return entries;
        }
    }
    var more = true;
    while more {
        skip_space(bytes, index);
        var key = try decode_string(allocator, bytes, index);
        defer key.deinit();
        let name = key.as_bytes();
        // Refused before the value is built, the way `scan_object` refuses one:
        // keeping either of the two would silently drop what the other carried.
        if entries.contains(name) {
            return Error::DuplicateField;
        }
        try expect_byte(bytes, index, cast<u8>(58));
        let value = try decode_value<std::meta::element<T>>(
            allocator, bytes, index, ignore_unknown);
        try entries.insert(name, value);
        more = try comma_or_close(bytes, index, cast<u8>(125));
    }
    return entries;
}

// decode_variant reads one variant of an enum or union. The two shapes are the
// two `encode_variant_value` writes: a variant that carries nothing is the
// string naming it, and one that carries a payload is the single-key object
// `{"Name": payload}`. Which one a document holds is read from the byte that
// starts it, so a tag and a payload variant cannot be confused for each other.
fn decode_variant<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> !T {
    skip_space(bytes, index);
    if peek_byte(bytes, index) |byte| {
        if byte == cast<u8>(34) {
            return decode_variant_tag<T>(bytes, index);
        }
    }
    return decode_variant_payload<T>(allocator, bytes, index, ignore_unknown);
}

// decode_variant_tag reads the string naming a variant that carries nothing.
// The name is compared where it lies, so a tag costs no allocation and an
// escaped spelling still names the variant it spells.
fn decode_variant_tag<T>(bytes: []u8, index: &var i64) -> !T {
    let name_at = index.*;
    try skip_string(bytes, index);
    comptime for std::meta::variants<T>() |v| {
        comptime if std::meta::has_payload<T, v>() {
            // A variant carrying a payload is never written as a bare string.
        } else {
            if key_equals(bytes, name_at, std::meta::variant_name<T, v>()) {
                return std::meta::variant<T, v>();
            }
        }
    }
    return Error::UnknownField;
}

// decode_variant_payload reads the single-key object naming a variant and the
// value it carries. A second key would name a second variant, and a value can
// only be one of them, so anything but one key is refused.
fn decode_variant_payload<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> !T {
    var scan = try scan_object(allocator, bytes, index, 0);
    defer scan.deinit();
    if scan.members.len() != 1 {
        return Error::UnexpectedToken;
    }
    if scan.members.at(0) |member| {
        comptime for std::meta::variants<T>() |v| {
            comptime if std::meta::has_payload<T, v>() {
                if key_equals(bytes, member.key_at, std::meta::variant_name<T, v>()) {
                    var at = member.value_at;
                    let payload = try decode_value<std::meta::variant_type<T, v>>(
                        allocator, bytes, &var at, ignore_unknown);
                    return std::meta::variant<T, v>(payload);
                }
            } else {
                // A variant carrying nothing is written as a bare string.
            }
        }
    }
    return Error::UnknownField;
}

// deinit_elements releases a partly built array on an error path. The cleanup a
// container accepts depends on whether its element owns anything (ADR-0091),
// so the choice is made where the element type is bound to a name.
fn deinit_elements<E>(items: std::array::Array<E>) -> void {
    comptime if E == type<std::string::String> or E == type<std::json::Value> {
        items.deinit();
    } else {
        comptime if std::meta::is_struct<E>() {
            items.deinit();
        } else {
            items.deinit();
        }
    }
    return;
}

// decode_struct fills every public field of `T` from one object. The keys
// arrive in document order and the fields are filled in declaration order, so
// the object is scanned once into the offsets of its values, and each field
// comes back for the one it names.
fn decode_struct<T>(
    allocator: Allocator,
    bytes: []u8,
    index: &var i64,
    ignore_unknown: bool,
) -> !T {
    var scan = try scan_object(allocator, bytes, index, 0);
    defer scan.deinit();
    if !ignore_unknown {
        // Checked before anything is built: a document `T` cannot hold is
        // refused while there is still nothing to release.
        try reject_unknown<T>(bytes, &scan);
    }
    return std::meta::construct<T, decode_field>(allocator, bytes, &scan, ignore_unknown);
}

// reject_unknown refuses a key `T` has no field for. Dropping it silently
// would lose data the document carried, so the caller has to say which it
// wants by calling `decode_ignore_unknown` instead (原理 3).
fn reject_unknown<T>(bytes: []u8, scan: &std::json::Scan) -> Error!void {
    var index = 0;
    while scan.members.at(index) |member| {
        if !names_field<T>(bytes, member.key_at) {
            return Error::UnknownField;
        }
        index = index + 1;
    }
    return;
}

// names_field reports whether one key names a public field of `T`.
fn names_field<T>(bytes: []u8, key_at: i64) -> bool {
    comptime for std::meta::public_fields<T>() |f| {
        if key_equals(bytes, key_at, std::meta::field_name<T, f>()) {
            return true;
        }
    }
    return false;
}

// decode_field reads the value one field names out of a scanned object. It is
// the worker `construct` calls once per field: `f` is bound to that field, so
// the name it looks up and the type it returns both come from `f`.
fn decode_field<T, f: Field>(
    allocator: Allocator,
    bytes: []u8,
    scan: &std::json::Scan,
    ignore_unknown: bool,
) -> !std::meta::field_type<T, f> {
    let name = std::meta::field_name<T, f>();
    if member_named(&scan.members, bytes, name) |value_at| {
        var index = value_at;
        return decode_value<std::meta::field_type<T, f>>(
            allocator, bytes, &var index, ignore_unknown);
    }
    return Error::MissingField;
}
