pub struct SimdMatrix8x8F32 {
    opaque: u8,
}

pub struct SimdMatrix8x8F16 {
    opaque: u8,
}

pub fn thread_index() -> i64 {
    return std::internal::builtin::gpu_thread_index();
}

pub fn group_index() -> i64 {
    return std::internal::builtin::gpu_group_index();
}

pub fn local_index() -> i64 {
    return std::internal::builtin::gpu_local_index();
}

pub fn simdgroup_index() -> i64 {
    return std::internal::builtin::gpu_simdgroup_index();
}

pub fn lane_index() -> i64 {
    return std::internal::builtin::gpu_lane_index();
}

pub fn barrier() -> void {
    std::internal::builtin::gpu_barrier();
    return;
}

pub fn shuffle_xor(value: f32, mask: i64) -> f32 {
    return std::internal::builtin::gpu_shuffle_xor_f32(value, mask);
}

pub fn simd_max(value: f32) -> f32 {
    return std::internal::builtin::gpu_simd_max_f32(value);
}

pub fn simd_sum(value: f32) -> f32 {
    return std::internal::builtin::gpu_simd_sum_f32(value);
}

pub fn simd_matrix_zero() -> std::gpu::SimdMatrix8x8F32 {
    return std::internal::builtin::gpu_simd_matrix_zero_f32();
}

pub fn simd_matrix_load_f16(src: []u16, offset: i64, stride: i64, transpose: bool) -> std::gpu::SimdMatrix8x8F16 {
    return std::internal::builtin::gpu_simd_matrix_load_f16(src, offset, stride, transpose);
}

pub fn simd_matrix_mma_f16(
    acc: std::gpu::SimdMatrix8x8F32,
    a: std::gpu::SimdMatrix8x8F16,
    b: std::gpu::SimdMatrix8x8F16
) -> std::gpu::SimdMatrix8x8F32 {
    return std::internal::builtin::gpu_simd_matrix_mma_f16(acc, a, b);
}

pub fn simd_matrix_store_f32(
    acc: std::gpu::SimdMatrix8x8F32,
    dst: &var []f32,
    offset: i64,
    stride: i64
) -> void {
    std::internal::builtin::gpu_simd_matrix_store_f32(acc, dst, offset, stride);
    return;
}

pub fn sqrt(value: f32) -> f32 {
    return std::internal::builtin::gpu_sqrt_f32(value);
}

pub fn exp(value: f32) -> f32 {
    return std::internal::builtin::gpu_exp_f32(value);
}

pub fn log(value: f32) -> f32 {
    return std::internal::builtin::gpu_log_f32(value);
}

pub fn fma(left: f32, right: f32, addend: f32) -> f32 {
    return std::internal::builtin::gpu_fma_f32(left, right, addend);
}

pub fn f32_from_half(bits: u16) -> f32 {
    return std::internal::builtin::gpu_f32_from_half(bits);
}

pub fn half_from_f32(value: f32) -> u16 {
    return std::internal::builtin::gpu_half_from_f32(value);
}
