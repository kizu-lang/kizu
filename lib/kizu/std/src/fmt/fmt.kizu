// append_i64 appends a deterministic decimal i64 diagnostic representation.
pub fn append_i64(out: &var std::string::String, value: i64) -> !void {
    if value == 0 {
        try out.append_byte(cast<u8>(48));
        return;
    }
    var current = value;
    if current < 0 {
        try out.append_byte(cast<u8>(45));
    } else {
        current = 0 - current;
    }
    var divisor = 1;
    while divisor <= 100000000000000000 and current <= (0 - (divisor * 10)) {
        divisor = divisor * 10;
    }
    while divisor > 0 {
        let raw_digit = (current / divisor) % 10;
        let digit = 0 - raw_digit;
        try out.append_byte(cast<u8>(48 + digit));
        divisor = divisor / 10;
    }
    return;
}

// append_bool appends the stable Kizu boolean diagnostic spelling.
pub fn append_bool(out: &var std::string::String, value: bool) -> !void {
    if value {
        try out.append_bytes("true");
    } else {
        try out.append_bytes("false");
    }
    return;
}

// append_bytes_literal appends a quoted deterministic byte-string literal.
pub fn append_bytes_literal(out: &var std::string::String, bytes: []u8) -> !void {
    try out.append_byte(cast<u8>(34));
    var index = 0;
    let length = std::mem::len(bytes);
    while index < length {
        let byte = bytes[index];
        if byte == cast<u8>(34) or byte == cast<u8>(92) {
            try out.append_byte(cast<u8>(92));
            try out.append_byte(byte);
        } else {
            if byte == cast<u8>(10) {
                try out.append_bytes("\n");
            } else {
                if byte == cast<u8>(13) {
                    try out.append_bytes("\r");
                } else {
                    if byte == cast<u8>(9) {
                        try out.append_bytes("\t");
                    } else {
                        if byte >= cast<u8>(32) and byte <= cast<u8>(126) {
                            try out.append_byte(byte);
                        } else {
                            try out.append_bytes("\x");
                            let value = cast<i64>(byte);
                            let high = value / 16;
                            if high < 10 {
                                try out.append_byte(cast<u8>(48 + high));
                            } else {
                                try out.append_byte(cast<u8>(55 + high));
                            }
                            let low = value % 16;
                            if low < 10 {
                                try out.append_byte(cast<u8>(48 + low));
                            } else {
                                try out.append_byte(cast<u8>(55 + low));
                            }
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    try out.append_byte(cast<u8>(34));
    return;
}
