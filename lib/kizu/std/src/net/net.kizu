// std::net is the descriptors a Poller can wait on: TCP, and the pipes of a
// child process. A listener accepts, a stream reads and writes bytes, a child
// hands out what it writes, and each is an owner that releases its
// descriptors when its frame ends. Everything a protocol needs on top of that
// -- framing, headers, status lines -- is Kizu source elsewhere (std::http).
//
// The child lives here rather than in std::process because the poller has to
// reach its pipes, and a private field is only reachable from its own module.
// std::process answers about this process; a child whose output is waited on
// next to the connections is this module's.
//
// Safe Kizu never sees a descriptor. The owners keep theirs in a private
// field, so the only way to reach a socket or a pipe is through a value this
// module handed out, and the only way to release one is the deinit that value
// carries.

pub error Error {
    InvalidAddress,
    AddressNotFound,
    AddressInUse,
    ConnectionRefused,
    ConnectionReset,
    PermissionDenied,
    TooManyOpenFiles,
    TimedOut,
    InvalidLength,
    ReadFailed,
    WriteFailed,
    OutOfMemory,
    LimitExceeded,
    IoFailing,
    OperationFailed,
    Closed,
    // A call that was waiting when its task was cancelled. It is a failure
    // rather than an absence: `?T` already means "nothing right now", and a
    // cancelled wait is not going to have anything later (ADR-0146).
    Canceled,
}

// An address is `host:port`, the way every other tool writes one. An IPv6
// host is bracketed (`[::1]:8080`) so the colons inside it are not read as the
// separator. An empty host means every interface for `tcp_listen` and the
// loopback for `tcp_connect`, which is what the host resolver already says.
pub struct Address {
    pub host: []u8,
    pub port: i64,
}

// A deadline is a moment on the monotonic clock that an operation must be
// finished by, and 0 means there is none. It lives here rather than in the
// kernel so the type says a call changed it: `SO_RCVTIMEO` would be a budget
// each recv gets back, which a peer sending one byte at a time never spends.
pub struct TcpListener {
    fd: i64,
    accept_deadline_ms: i64,
}

pub struct TcpStream {
    fd: i64,
    read_deadline_ms: i64,
    write_deadline_ms: i64,
}

// deadline_in_millis is the moment `millis` from now, on the same monotonic
// clock `std::process::monotonic_millis` reads. It is what the setters below
// take: a deadline is a point, and this is how far away you want the point.
//
// Passing a bare duration to a setter by mistake asks for a moment near boot,
// which has already gone by, so the first call fails loudly with `TimedOut`
// rather than quietly never expiring.
pub fn deadline_in_millis(millis: i64) -> i64 {
    let now = std::process::monotonic_millis();
    if millis <= 0 {
        return now;
    }
    return now + millis;
}

// A Poller waits on many descriptors at once, which is the one thing a
// blocking server cannot do. It answers with which of them are ready, and
// nothing else: what a ready descriptor means, and what to do about it, is the
// caller's -- the same pull loop `accept` is, one level out.
//
// Poller is the explicit state-machine shape. `io::evented` is the other
// shape: an ordinary read parks a worker whose creation is visible at
// `io::async` or `io::spawn`. Neither hides where concurrency begins
// (SPEC §15).
pub struct Poller {
    handle: i64,
}

// Interest is what a descriptor is being watched for.
pub union Interest {
    Read,
    Write,
    ReadWrite,
}

// Ready is one thing the host said became ready. `token` is what the caller
// registered with, which is how it finds its own state again -- this module
// never looks at it.
//
// A descriptor that is both readable and writable may arrive as one Ready or
// as two, because kqueue and epoll disagree about that and neither is wrong.
// A caller that acts on the flags it was given is right either way.
pub struct Ready {
    pub token: i64,
    pub readable: bool,
    pub writable: bool,
    pub closed: bool,
}

// poller_new opens a poller that can report up to `capacity` ready
// descriptors per wait. More than that are not lost -- they are reported by
// the next wait, which returns immediately because they are still ready.
pub fn poller_new(io: Io, capacity: i64) -> std::net::Error!std::net::Poller {
    let handle = try std::internal::builtin::net_poller_new(io, capacity);
    return Poller { handle: handle };
}

fn (self: &var std::net::Poller) watch_stream(
    io: Io,
    stream: &std::net::TcpStream,
    token: i64,
    interest: std::net::Interest
) -> std::net::Error!void {
    try std::internal::builtin::net_poller_add(
        io, self.handle, stream.fd, token, interest_bits(interest));
    return;
}

// watch_listener is how an evented server hears about a new connection at the
// same time as it hears about the ones it already has.
fn (self: &var std::net::Poller) watch_listener(
    io: Io,
    listener: &std::net::TcpListener,
    token: i64
) -> std::net::Error!void {
    try std::internal::builtin::net_poller_add(
        io, self.handle, listener.fd, token, interest_bits(Interest::Read));
    return;
}

// forget stops watching a descriptor the process still holds. Closing one
// removes it on its own, so this is for a connection that is staying open and
// has nothing to be woken about.
fn (self: &var std::net::Poller) forget(
    io: Io,
    stream: &std::net::TcpStream
) -> std::net::Error!void {
    try std::internal::builtin::net_poller_remove(io, self.handle, stream.fd);
    return;
}

// forget_listener is `forget` for the listener: a server that holds as many
// connections as it will take stops listening rather than being woken by every
// caller it is not going to accept, and listens again when one leaves.
fn (self: &var std::net::Poller) forget_listener(
    io: Io,
    listener: &std::net::TcpListener
) -> std::net::Error!void {
    try std::internal::builtin::net_poller_remove(io, self.handle, listener.fd);
    return;
}

// wait blocks until something is ready or the deadline passes, and answers how
// many. `at` is a moment, the same kind `set_read_deadline` takes; a poller
// with no deadline waits until something happens.
fn (self: &var std::net::Poller) wait(io: Io, at: i64) -> std::net::Error!i64 {
    let budget = remaining_millis(at);
    let count = try std::internal::builtin::net_poller_wait(io, self.handle, budget);
    return count;
}

// ready reads one of the last wait's answers. Out of range is null, so a loop
// over them ends without the caller holding the count.
fn (self: &std::net::Poller) ready(index: i64) -> ?std::net::Ready {
    if index < 0 {
        return null;
    }
    let flags = std::internal::builtin::net_poller_flags(self.handle, index);
    if flags == 0 {
        return null;
    }
    let token = std::internal::builtin::net_poller_token(self.handle, index);
    return Ready {
        token: token,
        readable: has_bit(flags, 1),
        writable: has_bit(flags, 2),
        closed: has_bit(flags, 4),
    };
}

fn (self: std::net::Poller) deinit() -> void {
    std::internal::builtin::net_poller_close(self.handle);
    return;
}

fn interest_bits(interest: std::net::Interest) -> i64 {
    return match interest {
        Read => 1,
        Write => 2,
        ReadWrite => 3,
    };
}

fn has_bit(flags: i64, bit: i64) -> bool {
    return (flags / bit) % 2 == 1;
}

// parse_address splits `host:port`. It reads text and nothing else: a name
// that has to be looked up is looked up by `tcp_listen` / `tcp_connect`, where
// the failure has an Io to be attributed to.
pub fn parse_address(address: []u8) -> std::net::Error!std::net::Address {
    let length = std::mem::len(address);
    if length == 0 {
        return std::net::Error::InvalidAddress;
    }
    if address[0] == cast<u8>(91) {
        let close = index_of_byte(address, cast<u8>(93), 0) orelse
            return std::net::Error::InvalidAddress;
        if close + 1 >= length or address[close + 1] != cast<u8>(58) {
            return std::net::Error::InvalidAddress;
        }
        let port = try parse_port(address[close + 2..length]);
        return Address { host: address[1..close], port: port };
    }
    let colon = last_index_of_byte(address, cast<u8>(58)) orelse
        return std::net::Error::InvalidAddress;
    let port = try parse_port(address[colon + 1..length]);
    return Address { host: address[0..colon], port: port };
}

// tcp_listen binds and starts listening. Port 0 asks the host for a free one;
// `local_port` then says which, so a program that must not collide with
// another does not have to guess.
pub fn tcp_listen(io: Io, address: []u8) -> std::net::Error!std::net::TcpListener {
    let parsed = try parse_address(address);
    let fd = try std::internal::builtin::net_listen(io, parsed.host, parsed.port);
    return TcpListener { fd: fd, accept_deadline_ms: 0 };
}

// tcp_connect opens a stream to a listening peer. It waits as long as the host
// will, which for an address that answers nothing is on the order of a minute:
// `tcp_connect_before` is the one that says otherwise.
pub fn tcp_connect(io: Io, address: []u8) -> std::net::Error!std::net::TcpStream {
    let stream = try tcp_connect_before(io, address, 0);
    return move stream;
}

// tcp_connect_before gives the connect a deadline -- the same kind of moment
// `set_read_deadline` takes, and 0 for none. An address that is not answering
// is the case it exists for: nothing else in this module can bound that wait,
// because there is no stream yet to set a deadline on.
pub fn tcp_connect_before(
    io: Io,
    address: []u8,
    at: i64
) -> std::net::Error!std::net::TcpStream {
    let parsed = try parse_address(address);
    let budget = remaining_millis(at);
    let fd = try std::internal::builtin::net_connect(
        io, parsed.host, parsed.port, budget);
    return TcpStream { fd: fd, read_deadline_ms: 0, write_deadline_ms: 0 };
}

// accept waits for the next connection and returns it as an owned stream. The
// listener stays open, so the caller decides when to stop accepting by
// leaving the loop, not by the listener running out.
fn (self: &var TcpListener) accept(io: Io) -> std::net::Error!std::net::TcpStream {
    let budget = remaining_millis(self.accept_deadline_ms);
    let fd = try std::internal::builtin::net_accept(io, self.fd, budget);
    return TcpStream { fd: fd, read_deadline_ms: 0, write_deadline_ms: 0 };
}

// accept_ready takes a connection if one is waiting and answers null if none
// is. It never waits, which is what a poller loop needs: the loop already
// asked, and being told "not right now" is an answer it can act on.
fn (self: &var TcpListener) accept_ready(io: Io) -> std::net::Error!?std::net::TcpStream {
    if std::internal::builtin::net_accept(io, self.fd, 0) |fd| {
        return TcpStream { fd: fd, read_deadline_ms: 0, write_deadline_ms: 0 };
    } else |failure| {
        if failure == std::net::Error::TimedOut {
            return null;
        }
        return failure;
    }
}

// local_port is the port this listener is actually on.
fn (self: &TcpListener) local_port() -> std::net::Error!i64 {
    let port = try std::internal::builtin::net_local_port(self.fd);
    return port;
}

// set_accept_deadline gives every later `accept` until the deadline, not each
// one. A loop that has other work to do sets one, takes `TimedOut` as its cue
// to do that work, and sets the next.
fn (self: &var TcpListener) set_accept_deadline(at: i64) -> void {
    self.accept_deadline_ms = at;
    return;
}

fn (self: &var TcpListener) clear_accept_deadline() -> void {
    self.accept_deadline_ms = 0;
    return;
}

// deinit consumes the listener and releases its descriptor. Consuming rather
// than borrowing is what makes a use after release a type error instead of a
// runtime one: there is no listener left to call anything on.
fn (self: std::net::TcpListener) deinit() -> void {
    std::internal::builtin::net_close(self.fd);
    return;
}

// read_into appends what one read returns to the caller's buffer and answers
// with how many bytes that was. Zero means the peer closed its side: a stream
// has no length, so the loop that decides a message is complete belongs to
// whoever knows the protocol.
fn (self: &var TcpStream) read_into(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::net::Error!i64 {
    let budget = remaining_millis(self.read_deadline_ms);
    let count = try std::internal::builtin::net_read(
        io, allocator, self.fd, out, max, budget);
    return count;
}

// write_all writes every byte or reports why it could not. A partial write is
// not a result the caller has to handle, because there is no shape of it this
// returns.
fn (self: &var TcpStream) write_all(io: Io, bytes: []u8) -> std::net::Error!void {
    let budget = remaining_millis(self.write_deadline_ms);
    try std::internal::builtin::net_write_all(io, self.fd, bytes, budget);
    return;
}

// set_read_deadline covers every later read until it passes, so a peer that
// drips one byte at a time still runs out. It is one moment for the whole
// message, which means a connection that serves more than one message has to
// push it forward between them -- the deadline does not renew itself.
fn (self: &var TcpStream) set_read_deadline(at: i64) -> void {
    self.read_deadline_ms = at;
    return;
}

fn (self: &var TcpStream) set_write_deadline(at: i64) -> void {
    self.write_deadline_ms = at;
    return;
}

fn (self: &var TcpStream) clear_read_deadline() -> void {
    self.read_deadline_ms = 0;
    return;
}

fn (self: &var TcpStream) clear_write_deadline() -> void {
    self.write_deadline_ms = 0;
    return;
}

// close_write ends the writing half and keeps the reading half. The peer
// reads end-of-stream after everything written so far, and can still send.
// It is the first stage of closing a connection the peer may still be writing
// to: closing outright with unread bytes waiting makes the kernel send a
// reset, which can reach the peer before what this side wrote does.
fn (self: &var TcpStream) close_write() -> void {
    std::internal::builtin::net_shutdown_write(self.fd);
    return;
}

// read_ready takes what has already arrived and answers null if nothing has.
// It never waits, which is the read counterpart of `write_some`: a poller loop
// asked already, and "nothing right now" is an answer it can act on.
//
// Zero still means the peer closed. Null and zero are different answers to
// different questions -- one is "not yet", the other is "not ever".
fn (self: &var TcpStream) read_ready(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::net::Error!?i64 {
    if std::internal::builtin::net_read(io, allocator, self.fd, out, max, 0) |count| {
        return count;
    } else |failure| {
        if failure == std::net::Error::TimedOut {
            return null;
        }
        return failure;
    }
}

// write_some sends what fits right now and answers with how many bytes that
// was. **Zero is not an error and not the end**: it is "not right now", and the
// caller comes back when a poller says this stream is writable again.
//
// This is the half of writing that `write_all` cannot do. `write_all` finishes
// or fails, so a peer that stopped reading holds the caller until its deadline;
// a loop over `write_some` keeps what is left and goes back to the wait, which
// is what lets one thread serve everyone else meanwhile.
//
// It never waits, so a write deadline does not apply. The waiting belongs to
// the poller, and the deadline that bounds it is the one on `Poller.wait`.
fn (self: &var TcpStream) write_some(io: Io, bytes: []u8) -> std::net::Error!i64 {
    let count = try std::internal::builtin::net_write_some(io, self.fd, bytes);
    return count;
}

// deinit consumes the stream and releases its descriptor.
fn (self: std::net::TcpStream) deinit() -> void {
    std::internal::builtin::net_close(self.fd);
    return;
}

// remaining_millis is what the primitives take: a negative budget means there
// is no deadline and the call blocks, and zero means the deadline is gone and
// the call must not wait. Recomputing it per call is what keeps a deadline
// from being handed back a full budget every time.
fn remaining_millis(deadline: i64) -> i64 {
    if deadline == 0 {
        return -1;
    }
    let left = deadline - std::process::monotonic_millis();
    if left < 0 {
        return 0;
    }
    return left;
}

fn parse_port(text: []u8) -> std::net::Error!i64 {
    let length = std::mem::len(text);
    if length == 0 or length > 5 {
        return std::net::Error::InvalidAddress;
    }
    var value = 0;
    var index = 0;
    while index < length {
        let byte = text[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return std::net::Error::InvalidAddress;
        }
        value = value * 10 + cast<i64>(byte) - 48;
        index = index + 1;
    }
    if value > 65535 {
        return std::net::Error::InvalidAddress;
    }
    return value;
}

fn index_of_byte(bytes: []u8, needle: u8, from: i64) -> ?i64 {
    let length = std::mem::len(bytes);
    var index = from;
    while index < length {
        if bytes[index] == needle {
            return index;
        }
        index = index + 1;
    }
    return null;
}

fn last_index_of_byte(bytes: []u8, needle: u8) -> ?i64 {
    var index = std::mem::len(bytes);
    while index > 0 {
        index = index - 1;
        if bytes[index] == needle {
            return index;
        }
    }
    return null;
}

// Stdio is where one of a child's standard streams goes: this process's own,
// nowhere, or a pipe this process holds the other end of.
pub enum Stdio {
    Inherit,
    Null,
    Pipe,
}

// A Command is the program and arguments a child will run, the environment
// and directory it starts in, and where its three streams go. Every stream
// starts as Inherit, and so do the environment and the directory, the way a
// shell runs a command. It is built by appending, because the number of
// arguments is the caller's and a fixed shape would have to guess it.
pub struct Command {
    // Each argument followed by a NUL, which is the form the host's argv
    // takes and the reason an argument cannot hold one.
    argv: std::string::String,
    // Each `NAME=value` binding followed by a NUL, laid over the inherited
    // environment in order.
    bindings: std::string::String,
    // The directory the child starts in, empty for this process's.
    dir: std::string::String,
    stdin: std::net::Stdio,
    stdout: std::net::Stdio,
    stderr: std::net::Stdio,
}

// A Child is a running process this one started. Reading what it wrote never
// waits: `read_stdout_ready` takes what has arrived, and a Poller says when
// more has. That is what lets one thread relay a long command's output while
// it serves its connections.
pub struct Child {
    handle: i64,
}

// command starts a Command that runs `program`, looked up on PATH when it
// names no directory. An empty program, or an argument with a NUL byte in it
// (where the host's argv would cut it short), is InvalidLength.
pub fn command(allocator: Allocator, program: []u8) -> std::net::Error!std::net::Command {
    if std::mem::len(program) == 0 {
        return std::net::Error::InvalidLength;
    }
    var argv = std::string::new(allocator);
    errdefer argv.deinit(allocator);
    try append_arg(allocator, &var argv, program);
    return Command {
        argv: move argv,
        bindings: std::string::new(allocator),
        dir: std::string::new(allocator),
        stdin: Stdio::Inherit,
        stdout: Stdio::Inherit,
        stderr: Stdio::Inherit,
    };
}

fn (self: &var std::net::Command) arg(allocator: Allocator, value: []u8) -> std::net::Error!void {
    try append_arg(allocator, &var self.argv, value);
    return;
}

// env sets one variable in the child's environment, which is otherwise this
// process's. A later binding of the same name wins. An empty name, a name
// with `=` in it, or a NUL anywhere is InvalidLength: the host's environment
// could not carry it.
fn (self: &var std::net::Command) env(
    allocator: Allocator,
    name: []u8,
    value: []u8
) -> std::net::Error!void {
    if std::mem::len(name) == 0 {
        return std::net::Error::InvalidLength;
    }
    if index_of_byte(name, cast<u8>(61), 0) |_| {
        return std::net::Error::InvalidLength;
    }
    if index_of_byte(name, cast<u8>(0), 0) |_| {
        return std::net::Error::InvalidLength;
    }
    if index_of_byte(value, cast<u8>(0), 0) |_| {
        return std::net::Error::InvalidLength;
    }
    // One reservation for the whole binding, so running out of memory leaves
    // none of it behind.
    let size = std::mem::len(name) + std::mem::len(value) + 2;
    self.bindings.reserve(allocator, size) catch return std::net::Error::OutOfMemory;
    self.bindings.append_bytes(allocator, name) catch return std::net::Error::OutOfMemory;
    self.bindings.append_byte(allocator, cast<u8>(61)) catch return std::net::Error::OutOfMemory;
    self.bindings.append_bytes(allocator, value) catch return std::net::Error::OutOfMemory;
    self.bindings.append_byte(allocator, cast<u8>(0)) catch return std::net::Error::OutOfMemory;
    return;
}

// set_dir makes the child start in `path` instead of this process's
// directory. A program named by a relative path is found from there. An empty
// path or one with a NUL is InvalidLength. A directory the child cannot enter
// is not an error here: like a program that cannot run, the child exits 127.
fn (self: &var std::net::Command) set_dir(allocator: Allocator, path: []u8) -> std::net::Error!void {
    if std::mem::len(path) == 0 {
        return std::net::Error::InvalidLength;
    }
    if index_of_byte(path, cast<u8>(0), 0) |_| {
        return std::net::Error::InvalidLength;
    }
    self.dir.clear();
    self.dir.append_bytes(allocator, path) catch return std::net::Error::OutOfMemory;
    return;
}

fn (self: &var std::net::Command) set_stdin(stdio: std::net::Stdio) -> void {
    self.stdin = stdio;
    return;
}

fn (self: &var std::net::Command) set_stdout(stdio: std::net::Stdio) -> void {
    self.stdout = stdio;
    return;
}

fn (self: &var std::net::Command) set_stderr(stdio: std::net::Stdio) -> void {
    self.stderr = stdio;
    return;
}

// spawn starts the child and returns without waiting for it. A program that
// cannot be run is not an error here: the child exits 127, as it does for
// `std::process::spawn_wait8`, because whether exec worked is only known in
// the child.
fn (self: &std::net::Command) spawn(io: Io) -> std::net::Error!std::net::Child {
    let modes = stdio_bits(self.stdin) + stdio_bits(self.stdout) * 4 +
        stdio_bits(self.stderr) * 16;
    let argv = self.argv.as_bytes();
    let bindings = self.bindings.as_bytes();
    let dir = self.dir.as_bytes();
    let handle = try std::internal::builtin::net_child_spawn(io, argv, modes, bindings, dir);
    return Child { handle: handle };
}

fn (self: std::net::Command) deinit(allocator: Allocator) -> void {
    self.argv.deinit(allocator);
    self.bindings.deinit(allocator);
    self.dir.deinit(allocator);
    return;
}

// read_stdout_ready is `TcpStream.read_ready` for the child's standard
// output: null is "nothing yet", zero is "the child closed it". A stream that
// was not piped is Closed.
//
// After zero, close it with `close_stdout`. A pipe at its end stays readable,
// so a poller still watching it would answer at once on every wait.
fn (self: &var std::net::Child) read_stdout_ready(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::net::Error!?i64 {
    let fd = std::internal::builtin::net_child_fd(self.handle, 1);
    return read_pipe_ready(io, allocator, fd, out, max);
}

fn (self: &var std::net::Child) read_stderr_ready(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::net::Error!?i64 {
    let fd = std::internal::builtin::net_child_fd(self.handle, 2);
    return read_pipe_ready(io, allocator, fd, out, max);
}

// read_stdout_into is `TcpStream.read_into` for the child's standard output:
// one read appended to `out`, and zero is the end. It waits for the child to
// write, which on an evented Io parks only the calling worker -- the shape a
// worker-per-connection server reads with. There is no deadline: a child is
// stopped with `kill`.
fn (self: &var std::net::Child) read_stdout_into(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::net::Error!i64 {
    let fd = std::internal::builtin::net_child_fd(self.handle, 1);
    let count = try std::internal::builtin::net_read(io, allocator, fd, out, max, -1);
    return count;
}

fn (self: &var std::net::Child) read_stderr_into(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::net::Error!i64 {
    let fd = std::internal::builtin::net_child_fd(self.handle, 2);
    let count = try std::internal::builtin::net_read(io, allocator, fd, out, max, -1);
    return count;
}

// write_stdin_all is `TcpStream.write_all` for the child's standard input: it
// writes every byte or reports why not, waiting while the pipe is full.
fn (self: &var std::net::Child) write_stdin_all(io: Io, bytes: []u8) -> std::net::Error!void {
    let fd = std::internal::builtin::net_child_fd(self.handle, 0);
    try std::internal::builtin::net_write_all(io, fd, bytes, -1);
    return;
}

// write_stdin_some is `TcpStream.write_some` for the child's standard input:
// zero is "not right now", and a poller watching it for Write says when.
fn (self: &var std::net::Child) write_stdin_some(io: Io, bytes: []u8) -> std::net::Error!i64 {
    let fd = std::internal::builtin::net_child_fd(self.handle, 0);
    let count = try std::internal::builtin::net_write_some(io, fd, bytes);
    return count;
}

// close_stdin is how the child reads end of input. The other two close this
// process's end, which also takes it out of any poller watching it.
fn (self: &var std::net::Child) close_stdin() -> void {
    std::internal::builtin::net_child_close_fd(self.handle, 0);
    return;
}

fn (self: &var std::net::Child) close_stdout() -> void {
    std::internal::builtin::net_child_close_fd(self.handle, 1);
    return;
}

fn (self: &var std::net::Child) close_stderr() -> void {
    std::internal::builtin::net_child_close_fd(self.handle, 2);
    return;
}

// try_wait answers the exit status if the child has ended and null if it is
// still running. It never waits. The status is the code the child exited
// with, or 128 plus the signal that ended it.
fn (self: &var std::net::Child) try_wait(io: Io) -> std::net::Error!?i64 {
    let status = try std::internal::builtin::net_child_wait(io, self.handle, 0);
    if status < 0 {
        return null;
    }
    return status;
}

// wait blocks until the child ends. A child still writing to a pipe nobody
// reads can block on that write first, so read to the end before waiting.
//
// It is waitpid, so it holds the thread even on an evented Io: the other
// workers do not run until it returns. A worker that has read the child's
// output to its end usually waits only for the exit that follows.
fn (self: &var std::net::Child) wait(io: Io) -> std::net::Error!i64 {
    let status = try std::internal::builtin::net_child_wait(io, self.handle, 1);
    return status;
}

// kill ends the child at once (SIGKILL). It is still the caller's to wait
// for; `wait` then answers 128 plus the signal.
fn (self: &var std::net::Child) kill(io: Io) -> std::net::Error!void {
    try std::internal::builtin::net_child_kill(io, self.handle);
    return;
}

// deinit closes the pipes and releases the child. One that was never waited
// for is killed and reaped here, so dropping a Child leaves neither a running
// process nor a zombie behind -- a child meant to outlive its owner is not
// something this type makes.
fn (self: std::net::Child) deinit() -> void {
    std::internal::builtin::net_child_close(self.handle);
    return;
}

// watch_child_stdout is how a child's output wakes the same wait its
// connections do.
fn (self: &var std::net::Poller) watch_child_stdout(
    io: Io,
    child: &std::net::Child,
    token: i64
) -> std::net::Error!void {
    let fd = std::internal::builtin::net_child_fd(child.handle, 1);
    try std::internal::builtin::net_poller_add(
        io, self.handle, fd, token, interest_bits(Interest::Read));
    return;
}

fn (self: &var std::net::Poller) watch_child_stderr(
    io: Io,
    child: &std::net::Child,
    token: i64
) -> std::net::Error!void {
    let fd = std::internal::builtin::net_child_fd(child.handle, 2);
    try std::internal::builtin::net_poller_add(
        io, self.handle, fd, token, interest_bits(Interest::Read));
    return;
}

fn (self: &var std::net::Poller) watch_child_stdin(
    io: Io,
    child: &std::net::Child,
    token: i64
) -> std::net::Error!void {
    let fd = std::internal::builtin::net_child_fd(child.handle, 0);
    try std::internal::builtin::net_poller_add(
        io, self.handle, fd, token, interest_bits(Interest::Write));
    return;
}

fn stdio_bits(stdio: std::net::Stdio) -> i64 {
    return match stdio {
        Inherit => 0,
        Null => 1,
        Pipe => 2,
    };
}

fn append_arg(
    allocator: Allocator,
    argv: &var std::string::String,
    value: []u8
) -> std::net::Error!void {
    if index_of_byte(value, cast<u8>(0), 0) |_| {
        return std::net::Error::InvalidLength;
    }
    argv.append_bytes(allocator, value) catch return std::net::Error::OutOfMemory;
    argv.append_byte(allocator, cast<u8>(0)) catch return std::net::Error::OutOfMemory;
    return;
}

fn read_pipe_ready(
    io: Io,
    allocator: Allocator,
    fd: i64,
    out: &var std::string::String,
    max: i64
) -> std::net::Error!?i64 {
    if std::internal::builtin::net_read(io, allocator, fd, out, max, 0) |count| {
        return count;
    } else |failure| {
        if failure == std::net::Error::TimedOut {
            return null;
        }
        return failure;
    }
}
