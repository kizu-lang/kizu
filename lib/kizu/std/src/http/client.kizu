// The client is one call: build the request, open the connection, read the
// answer whole. It closes the connection when it is done, which is what
// `Connection: close` on the way out already promised.
//
// There is no connection pool and no redirect following. Both are policy --
// how long to keep a socket, whether a 301 to another host is the same
// request -- and policy a library picks is policy the caller cannot see. What
// this returns is what the server said.

// A ClientResponse is what came back, owned. It is a different type from
// std::http::Response, because they are different things: one is what a
// server is still building, the other is what a client already has.
pub struct ClientResponse {
    pub status: i64,
    pub version: std::http::Version,
    pub reason: std::string::String,
    pub headers: std::http::Headers,
    pub body: std::string::String,
}

fn (self: std::http::ClientResponse) deinit(allocator: Allocator) -> void {
    self.reason.deinit(allocator);
    self.headers.deinit(allocator);
    self.body.deinit(allocator);
    return;
}

// get asks for a URL and returns what came back.
pub fn get(
    io: Io,
    allocator: Allocator,
    url: []u8
) -> std::http::Failure!std::http::ClientResponse {
    return fetch(io, allocator, "GET", url, "", "");
}

// post sends a body under a content type. An empty content type omits the
// header, which is what a body with no declared type means.
pub fn post(
    io: Io,
    allocator: Allocator,
    url: []u8,
    content_type: []u8,
    body: []u8
) -> std::http::Failure!std::http::ClientResponse {
    return fetch(io, allocator, "POST", url, content_type, body);
}

// fetch is get and post without the method baked in, under default limits.
pub fn fetch(
    io: Io,
    allocator: Allocator,
    method: []u8,
    url: []u8,
    content_type: []u8,
    body: []u8
) -> std::http::Failure!std::http::ClientResponse {
    return fetch_with(
        io, allocator, method, url, content_type, body, std::http::default_limits());
}

// fetch_with is the whole client. The limits bound what one answer may make
// this process allocate; a server that is not trusted is exactly the case
// they exist for.
pub fn fetch_with(
    io: Io,
    allocator: Allocator,
    method: []u8,
    url: []u8,
    content_type: []u8,
    body: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    if !std::http::valid_field_name(method) {
        return std::http::Error::MalformedRequest;
    }
    var parsed = try std::http::parse_url(allocator, url);
    defer parsed.deinit(allocator);
    var address = std::string::new(allocator);
    defer address.deinit(allocator);
    try parsed.authority(allocator, &var address);
    var request = std::string::new(allocator);
    defer request.deinit(allocator);
    try build_request(allocator, &parsed, &var request, method, content_type, body);
    return exchange(io, allocator, &address, &request, method, limits);
}

// exchange opens the connection, writes the request, and reads the answer.
// The stream lives only here: the answer is owned, so nothing the caller holds
// points at a socket this closed.
fn exchange(
    io: Io,
    allocator: Allocator,
    address: &std::string::String,
    request: &std::string::String,
    method: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    let address_bytes = address.as_bytes();
    var stream = try std::net::tcp_connect(io, address_bytes);
    defer stream.deinit();
    let wire = request.as_bytes();
    std::http::arm_write(&var stream, limits.write_millis);
    try stream.write_all(io, wire);
    return read_response(io, allocator, &var stream, method, limits);
}

// write_request writes one request onto a stream the caller already has, and
// read_response_from reads one answer off one. `fetch` is those two around a
// connect; splitting them out is what lets something else own the stream --
// a test that is both ends, and the TLS or proxy layer that is not here yet.
//
// `write_request` leaves the stream's write deadline alone: the caller owns
// the stream, so the deadline on it is the caller's answer already.
// `read_response_from` arms from the limits it is handed, because those limits
// are what the caller passed in to bound this read.
pub fn write_request(
    io: Io,
    allocator: Allocator,
    stream: &var std::net::TcpStream,
    method: []u8,
    url: &std::http::Url,
    content_type: []u8,
    body: []u8
) -> std::http::Failure!void {
    if !std::http::valid_field_name(method) {
        return std::http::Error::MalformedRequest;
    }
    var request = std::string::new(allocator);
    defer request.deinit(allocator);
    try build_request(allocator, url, &var request, method, content_type, body);
    let wire = request.as_bytes();
    try stream.write_all(io, wire);
    return;
}

// read_response_from reads one answer off a stream. `method` is what was
// asked, because a HEAD answer carries the length its body would have had and
// none of it -- the framing of an answer depends on the question.
pub fn read_response_from(
    io: Io,
    allocator: Allocator,
    stream: &var std::net::TcpStream,
    method: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    return read_response(io, allocator, stream, method, limits);
}

// build_request writes the request line and the head. Host is required by
// HTTP/1.1 and is the authority the URL named, so it is written here rather
// than left to the caller to remember.
fn build_request(
    allocator: Allocator,
    url: &std::http::Url,
    out: &var std::string::String,
    method: []u8,
    content_type: []u8,
    body: []u8
) -> std::http::Failure!void {
    let target = url.target.as_bytes();
    try out.append_bytes(allocator, method);
    try out.append_byte(allocator, cast<u8>(32));
    try out.append_bytes(allocator, target);
    try out.append_byte(allocator, cast<u8>(32));
    try out.append_bytes(allocator, std::http::version_text(std::http::Version::Http11));
    try std::http::append_crlf(allocator, out);
    try out.append_bytes(allocator, "Host: ");
    try url.authority(allocator, out);
    try std::http::append_crlf(allocator, out);
    if std::mem::len(content_type) > 0 {
        if !std::http::valid_field_value(content_type) {
            return std::http::Error::InvalidHeader;
        }
        try out.append_bytes(allocator, "Content-Type: ");
        try out.append_bytes(allocator, content_type);
        try std::http::append_crlf(allocator, out);
    }
    if std::mem::len(body) > 0 {
        try out.append_bytes(allocator, "Content-Length: ");
        try std::fmt::append_i64(allocator, out, std::mem::len(body));
        try std::http::append_crlf(allocator, out);
    }
    // One request per connection, and saying so is what lets the server frame
    // the answer by closing rather than by a length it may not know.
    try out.append_bytes(allocator, "Connection: close");
    try std::http::append_crlf(allocator, out);
    try std::http::append_crlf(allocator, out);
    try out.append_bytes(allocator, body);
    return;
}

fn read_response(
    io: Io,
    allocator: Allocator,
    stream: &var std::net::TcpStream,
    method: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    var buffer = std::string::new(allocator);
    defer buffer.deinit(allocator);
    std::http::arm_read(stream, limits.read_head_millis);
    let head_length = try std::http::read_head(io, allocator, stream, &var buffer, limits);
    var response = try parse_response_at(allocator, &buffer, head_length, limits);
    errdefer response.deinit(allocator);
    try read_response_body(io, allocator, stream, &var buffer, &var response,
        head_length, method, limits);
    return move response;
}

fn parse_response_at(
    allocator: Allocator,
    buffer: &std::string::String,
    head_length: i64,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    let bytes = buffer.as_bytes();
    return parse_response_head(allocator, bytes[0..head_length], limits);
}

// parse_response_head reads `HTTP/1.x SP STATUS SP REASON CRLF` and the header
// fields behind it. The reason phrase is kept as sent: it is text for a person,
// and a client that rewrote it would be reporting something nobody said.
pub fn parse_response_head(
    allocator: Allocator,
    head: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    var response = ClientResponse {
        status: 0,
        version: std::http::Version::Http11,
        reason: std::string::new(allocator),
        headers: std::http::headers_new(allocator),
        body: std::string::new(allocator),
    };
    errdefer response.deinit(allocator);
    let after_line = try parse_status_line(allocator, &var response, head);
    try std::http::parse_header_fields(
        allocator, &var response.headers, head, after_line, limits);
    return move response;
}

fn parse_status_line(
    allocator: Allocator,
    response: &var std::http::ClientResponse,
    head: []u8
) -> std::http::Failure!i64 {
    let length = std::mem::len(head);
    let line_end = std::http::index_of(head, cast<u8>(13), 0) orelse
        return std::http::Error::MalformedResponse;
    if line_end + 1 >= length or head[line_end + 1] != cast<u8>(10) {
        return std::http::Error::MalformedResponse;
    }
    let line = head[0..line_end];
    let first_space = std::http::index_of(line, cast<u8>(32), 0) orelse
        return std::http::Error::MalformedResponse;
    response.version = try parse_response_version(line[0..first_space]);
    var status_end = line_end;
    var reason_start = line_end;
    if std::http::index_of(line, cast<u8>(32), first_space + 1) |second_space| {
        status_end = second_space;
        reason_start = second_space + 1;
    }
    let status = std::http::parse_decimal(line[first_space + 1..status_end]) orelse
        return std::http::Error::MalformedResponse;
    if status < 100 or status > 999 {
        return std::http::Error::MalformedResponse;
    }
    response.status = status;
    let reason = line[reason_start..line_end];
    if !std::http::valid_field_value(reason) {
        return std::http::Error::MalformedResponse;
    }
    try response.reason.append_bytes(allocator, reason);
    return line_end + 2;
}

// A token that is not shaped like a version at all is a malformed line; one
// that is, and names a version this does not speak, is the other failure. The
// two are different answers to different questions (docs/principles.md §7).
fn parse_response_version(text: []u8) -> std::http::Failure!std::http::Version {
    if std::mem::equal_bytes(text, "HTTP/1.1") {
        return std::http::Version::Http11;
    }
    if std::mem::equal_bytes(text, "HTTP/1.0") {
        return std::http::Version::Http10;
    }
    if std::mem::starts_with(text, "HTTP/") {
        return std::http::Error::UnsupportedVersion;
    }
    return std::http::Error::MalformedResponse;
}

// read_body takes what the answer is framed by. A Content-Length says how
// much; without one, `Connection: close` means the close is the frame, so
// reading to end of stream is the answer rather than a guess.
fn read_response_body(
    io: Io,
    allocator: Allocator,
    stream: &var std::net::TcpStream,
    buffer: &var std::string::String,
    response: &var std::http::ClientResponse,
    head_length: i64,
    method: []u8,
    limits: std::http::Limits
) -> std::http::Failure!void {
    if response.headers.has("Transfer-Encoding") {
        return std::http::Error::UnsupportedEncoding;
    }
    // A HEAD answer carries the length the body would have had and none of it,
    // and 1xx / 204 / 304 carry no body at all.
    if std::mem::equal_bytes(method, "HEAD") {
        return;
    }
    if !std::http::status_carries_body(response.status) {
        return;
    }
    // The body gets its own deadline, the way the server's does.
    std::http::arm_read(stream, limits.read_body_millis);
    let declared = try content_length(response);
    if declared |length| {
        if length > limits.max_body_bytes {
            return std::http::Error::BodyTooLarge;
        }
        while buffer.len() - head_length < length {
            let missing = length - (buffer.len() - head_length);
            let got = try stream.read_into(io, allocator, buffer, missing);
            if got == 0 {
                return std::http::Error::Incomplete;
            }
        }
        try copy_response_body(allocator, buffer, response, head_length, length);
        return;
    }
    while true {
        if buffer.len() - head_length > limits.max_body_bytes {
            return std::http::Error::BodyTooLarge;
        }
        let got = try stream.read_into(io, allocator, buffer, 4096);
        if got == 0 {
            break;
        }
    }
    try copy_response_body(allocator, buffer, response, head_length, buffer.len() - head_length);
    return;
}

fn content_length(
    response: &std::http::ClientResponse
) -> std::http::Failure!?i64 {
    if response.headers.find("Content-Length") |field| {
        let text = field.value.as_bytes();
        let value = std::http::parse_decimal(text) orelse
            return std::http::Error::MalformedResponse;
        return value;
    }
    return null;
}

fn copy_response_body(
    allocator: Allocator,
    buffer: &std::string::String,
    response: &var std::http::ClientResponse,
    head_length: i64,
    length: i64
) -> std::http::Failure!void {
    if length <= 0 {
        return;
    }
    let bytes = buffer.as_bytes();
    try response.body.append_bytes(allocator, bytes[head_length..head_length + length]);
    return;
}
