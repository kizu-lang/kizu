// The client is two shapes over one connection. `get` / `post` / `fetch` are
// one call: build the request, open the connection, read the answer whole.
// `Connection` is the same thing taken apart, for an answer too big to hold or
// a stream that is not a plain socket.
//
// There is no connection pool and no redirect following. Both are policy --
// how long to keep a socket, whether a 301 to another host is the same
// request -- and policy a library picks is policy the caller cannot see. What
// this returns is what the server said.

// A ClientResponse is the head that came back, owned. It is a different type
// from std::http::Response, because they are different things: one is what a
// server is still building, the other is what a client already has.
//
// `body` is what `fetch` and its two spellings read, up to the ceiling their
// caller named. `Connection.receive` leaves it empty and the body on the
// connection -- the same split `accept` and `accept_head` make on the server.
pub struct ClientResponse {
    pub status: i64,
    pub version: std::http::Version,
    pub reason: std::string::String,
    pub headers: std::http::Headers,
    pub body: std::string::String,
}

fn (self: std::http::ClientResponse) deinit(allocator: Allocator) -> void {
    self.reason.deinit(allocator);
    self.headers.deinit(allocator);
    self.body.deinit(allocator);
    return;
}

// A Connection is a stream and the bytes read off it that nobody has taken
// yet. It is what `fetch` uses underneath, and what a caller uses directly to
// stream an answer rather than hold it.
//
// The stream is not handed back. Reading a head reads whole packets, so the
// first bytes of the body are already in here -- a caller reading the socket
// would skip them. Go's `http.ReadResponse` takes a `*bufio.Reader` for the
// same reason.
pub struct Connection {
    reader: std::http::Reader,
}

// connect opens one. `take` wraps a stream the caller already has, which is
// what lets TLS or a proxy go underneath without this module knowing.
pub fn connect(
    io: Io,
    allocator: Allocator,
    address: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::Connection {
    var stream = try std::net::tcp_connect(io, address);
    errdefer stream.deinit();
    return Connection {
        reader: std::http::reader_new(allocator, move stream, limits),
    };
}

pub fn take(
    allocator: Allocator,
    stream: std::net::TcpStream,
    limits: std::http::Limits
) -> std::http::Connection {
    return Connection {
        reader: std::http::reader_new(allocator, move stream, limits),
    };
}

fn (self: std::http::Connection) deinit(allocator: Allocator) -> void {
    self.reader.deinit(allocator);
    return;
}

// send writes one request. The write deadline comes from the limits this
// connection was opened with, and is set when the write starts.
fn (self: &var std::http::Connection) send(
    io: Io,
    allocator: Allocator,
    method: []u8,
    url: &std::http::Url,
    content_type: []u8,
    body: []u8,
    write_millis: i64
) -> std::http::Failure!void {
    if !std::http::valid_field_name(method) {
        return std::http::Error::MalformedRequest;
    }
    var request = std::string::new(allocator);
    defer request.deinit(allocator);
    try build_request(allocator, url, &var request, method, content_type, body);
    let wire = request.as_bytes();
    self.reader.arm_write(write_millis);
    try self.reader.write_all(io, wire);
    return;
}

// receive reads the answer's head and stops there, leaving the body on the
// connection for `read_into`.
//
// `method` is what was asked, because a HEAD answer carries the length its
// body would have had and none of it -- the framing of an answer depends on
// the question.
fn (self: &var std::http::Connection) receive(
    io: Io,
    allocator: Allocator,
    method: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    self.reader.arm_read(limits.read_head_millis);
    let head_length = try self.take_head(io, allocator, limits);
    var response = try self.parse_head(allocator, head_length, limits);
    errdefer response.deinit(allocator);
    self.reader.took(head_length);
    try self.bind_body(&response, method);
    self.reader.arm_read(limits.read_body_millis);
    return move response;
}

// take_head fills the connection until the head is complete.
fn (self: &var std::http::Connection) take_head(
    io: Io,
    allocator: Allocator,
    limits: std::http::Limits
) -> std::http::Failure!i64 {
    while true {
        let found = self.reader.find_head();
        if found |end| {
            if end > limits.max_head_bytes {
                return std::http::Error::HeadTooLarge;
            }
            return end;
        }
        if self.reader.held_len() >= limits.max_head_bytes {
            return std::http::Error::HeadTooLarge;
        }
        let got = try self.reader.fill_waiting(io, allocator);
        if got == 0 {
            return std::http::Error::Incomplete;
        }
    }
    return std::http::Error::Incomplete;
}

fn (self: &var std::http::Connection) parse_head(
    allocator: Allocator,
    head_length: i64,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    var head = std::string::new(allocator);
    defer head.deinit(allocator);
    try self.reader.copy_head(allocator, head_length, &var head);
    let bytes = head.as_bytes();
    return parse_response_head(allocator, bytes, limits);
}

// bind_body settles where the answer ends. A Content-Length says how much;
// chunked says its terminator does; without either, the close is the frame,
// so reading to the end of the stream is the answer rather than a guess.
fn (self: &var std::http::Connection) bind_body(
    response: &std::http::ClientResponse,
    method: []u8
) -> std::http::Failure!void {
    // A HEAD answer carries the length the body would have had and none of it,
    // and 1xx / 204 / 304 carry no body at all.
    if std::mem::equal_bytes(method, "HEAD") {
        self.reader.bind_length(0);
        return;
    }
    if !std::http::status_carries_body(response.status) {
        self.reader.bind_length(0);
        return;
    }
    // A message that says two things about its own length is what turns one
    // answer into two, so this is where the refusal comes from rather than a
    // guess about which framing wins.
    if try std::http::chunked_framing(&response.headers) {
        self.reader.bind_chunked(std::mem::Limit::Unlimited);
        return;
    }
    let declared = try content_length(response);
    if declared |length| {
        self.reader.bind_length(length);
        return;
    }
    self.reader.bind_until_close();
    return;
}

// read_into and read_ready_into hand out the answer's body. Zero is the end
// whichever framing carried it, so the loop above them does not have to know
// which one it was.
fn (self: &var std::http::Connection) read_into(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::http::Failure!i64 {
    let count = try self.reader.read_into(io, allocator, out, max);
    return count;
}

fn (self: &var std::http::Connection) read_ready_into(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::http::Failure!?i64 {
    let count = try self.reader.read_ready_into(io, allocator, out, max);
    return count;
}

fn (self: &var std::http::Connection) set_read_deadline(at: i64) -> void {
    self.reader.set_read_deadline(at);
    return;
}

fn (self: &var std::http::Connection) set_write_deadline(at: i64) -> void {
    self.reader.set_write_deadline(at);
    return;
}

fn (self: &var std::http::Connection) clear_read_deadline() -> void {
    self.reader.clear_read_deadline();
    return;
}

fn (self: &var std::http::Connection) clear_write_deadline() -> void {
    self.reader.clear_write_deadline();
    return;
}

// read_body reads the whole answer into `response.body`, under a ceiling the
// caller named. It is what `fetch` does after `receive`, and is a method
// rather than a loop written out because holding a whole answer is the common
// case even though streaming it is the general one.
fn (self: &var std::http::Connection) read_body(
    io: Io,
    allocator: Allocator,
    response: &var std::http::ClientResponse,
    max: i64
) -> std::http::Failure!void {
    // A declared length past the ceiling is refused before a byte is read. A
    // chunked answer has no number to check, so it is refused as it grows.
    if self.reader.owes() > max {
        return std::http::Error::BodyTooLarge;
    }
    var body = std::string::new(allocator);
    defer body.deinit(allocator);
    var got = try self.reader.read_into(io, allocator, &var body, 4096);
    while got > 0 {
        if body.len() > max {
            return std::http::Error::BodyTooLarge;
        }
        got = try self.reader.read_into(io, allocator, &var body, 4096);
    }
    if body.len() > max {
        return std::http::Error::BodyTooLarge;
    }
    let bytes = body.as_bytes();
    try response.body.append_bytes(allocator, bytes);
    return;
}

// get asks for a URL and returns what came back, holding the body up to
// `max` bytes. The ceiling is an argument because the size of an answer is
// what the caller asking for it knows, not something this module can name once
// for every URL there is.
pub fn get(
    io: Io,
    allocator: Allocator,
    url: []u8,
    max: i64
) -> std::http::Failure!std::http::ClientResponse {
    return fetch(io, allocator, "GET", url, "", "", max);
}

// post sends a body under a content type. An empty content type omits the
// header, which is what a body with no declared type means.
pub fn post(
    io: Io,
    allocator: Allocator,
    url: []u8,
    content_type: []u8,
    body: []u8,
    max: i64
) -> std::http::Failure!std::http::ClientResponse {
    return fetch(io, allocator, "POST", url, content_type, body, max);
}

// fetch is get and post without the method baked in, under default limits.
pub fn fetch(
    io: Io,
    allocator: Allocator,
    method: []u8,
    url: []u8,
    content_type: []u8,
    body: []u8,
    max: i64
) -> std::http::Failure!std::http::ClientResponse {
    return fetch_with(
        io, allocator, method, url, content_type, body,
        std::http::default_limits(), max);
}

// fetch_with is the whole client in one call. The limits bound the head and
// the time each phase may take; `max` bounds the body this holds. A server
// that is not trusted is exactly the case they exist for.
pub fn fetch_with(
    io: Io,
    allocator: Allocator,
    method: []u8,
    url: []u8,
    content_type: []u8,
    body: []u8,
    limits: std::http::Limits,
    max: i64
) -> std::http::Failure!std::http::ClientResponse {
    // Checked before the connect, so a request this will not send does not
    // open a socket first.
    if !std::http::valid_field_name(method) {
        return std::http::Error::MalformedRequest;
    }
    var parsed = try std::http::parse_url(allocator, url);
    defer parsed.deinit(allocator);
    var address = std::string::new(allocator);
    defer address.deinit(allocator);
    try parsed.authority(allocator, &var address);
    let address_bytes = address.as_bytes();
    var open = try connect(io, allocator, address_bytes, limits);
    defer open.deinit(allocator);
    try open.send(io, allocator, method, &parsed, content_type, body, limits.write_millis);
    var response = try open.receive(io, allocator, method, limits);
    errdefer response.deinit(allocator);
    try open.read_body(io, allocator, &var response, max);
    return move response;
}

// build_request writes the request line and the head. Host is required by
// HTTP/1.1 and is the authority the URL named, so it is written here rather
// than left to the caller to remember.
fn build_request(
    allocator: Allocator,
    url: &std::http::Url,
    out: &var std::string::String,
    method: []u8,
    content_type: []u8,
    body: []u8
) -> std::http::Failure!void {
    let target = url.target.as_bytes();
    try out.append_bytes(allocator, method);
    try out.append_byte(allocator, cast<u8>(32));
    try out.append_bytes(allocator, target);
    try out.append_byte(allocator, cast<u8>(32));
    try out.append_bytes(allocator, std::http::version_text(std::http::Version::Http11));
    try std::http::append_crlf(allocator, out);
    try out.append_bytes(allocator, "Host: ");
    try url.authority(allocator, out);
    try std::http::append_crlf(allocator, out);
    if std::mem::len(content_type) > 0 {
        if !std::http::valid_field_value(content_type) {
            return std::http::Error::InvalidHeader;
        }
        try out.append_bytes(allocator, "Content-Type: ");
        try out.append_bytes(allocator, content_type);
        try std::http::append_crlf(allocator, out);
    }
    if std::mem::len(body) > 0 {
        try out.append_bytes(allocator, "Content-Length: ");
        try std::fmt::append_i64(allocator, out, std::mem::len(body));
        try std::http::append_crlf(allocator, out);
    }
    // One request per connection, and saying so is what lets the server frame
    // the answer by closing rather than by a length it may not know.
    try out.append_bytes(allocator, "Connection: close");
    try std::http::append_crlf(allocator, out);
    try std::http::append_crlf(allocator, out);
    try out.append_bytes(allocator, body);
    return;
}

// parse_response_head reads `HTTP/1.x SP STATUS SP REASON CRLF` and the header
// fields behind it. The reason phrase is kept as sent: it is text for a person,
// and a client that rewrote it would be reporting something nobody said.
pub fn parse_response_head(
    allocator: Allocator,
    head: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::ClientResponse {
    var response = ClientResponse {
        status: 0,
        version: std::http::Version::Http11,
        reason: std::string::new(allocator),
        headers: std::http::headers_new(allocator),
        body: std::string::new(allocator),
    };
    errdefer response.deinit(allocator);
    let after_line = try parse_status_line(allocator, &var response, head);
    try std::http::parse_header_fields(
        allocator, &var response.headers, head, after_line, limits);
    return move response;
}

fn parse_status_line(
    allocator: Allocator,
    response: &var std::http::ClientResponse,
    head: []u8
) -> std::http::Failure!i64 {
    let length = std::mem::len(head);
    let line_end = std::http::index_of(head, cast<u8>(13), 0) orelse
        return std::http::Error::MalformedResponse;
    if line_end + 1 >= length or head[line_end + 1] != cast<u8>(10) {
        return std::http::Error::MalformedResponse;
    }
    let line = head[0..line_end];
    let first_space = std::http::index_of(line, cast<u8>(32), 0) orelse
        return std::http::Error::MalformedResponse;
    response.version = try parse_response_version(line[0..first_space]);
    var status_end = line_end;
    var reason_start = line_end;
    if std::http::index_of(line, cast<u8>(32), first_space + 1) |second_space| {
        status_end = second_space;
        reason_start = second_space + 1;
    }
    let status = std::http::parse_decimal(line[first_space + 1..status_end]) orelse
        return std::http::Error::MalformedResponse;
    if status < 100 or status > 999 {
        return std::http::Error::MalformedResponse;
    }
    response.status = status;
    let reason = line[reason_start..line_end];
    if !std::http::valid_field_value(reason) {
        return std::http::Error::MalformedResponse;
    }
    try response.reason.append_bytes(allocator, reason);
    return line_end + 2;
}

// A token that is not shaped like a version at all is a malformed line; one
// that is, and names a version this does not speak, is the other failure. The
// two are different answers to different questions (docs/principles.md §7).
fn parse_response_version(text: []u8) -> std::http::Failure!std::http::Version {
    if std::mem::equal_bytes(text, "HTTP/1.1") {
        return std::http::Version::Http11;
    }
    if std::mem::equal_bytes(text, "HTTP/1.0") {
        return std::http::Version::Http10;
    }
    if std::mem::starts_with(text, "HTTP/") {
        return std::http::Error::UnsupportedVersion;
    }
    return std::http::Error::MalformedResponse;
}

fn content_length(
    response: &std::http::ClientResponse
) -> std::http::Failure!?i64 {
    if response.headers.find("Content-Length") |field| {
        let text = field.value.as_bytes();
        let value = std::http::parse_decimal(text) orelse
            return std::http::Error::MalformedResponse;
        return value;
    }
    return null;
}
