// The server is a loop the caller writes.
//
// `accept` hands back one Exchange -- the request that arrived and the
// response to fill in -- and returns. There is no handler registry and no
// callback, so what happens to a request is in the source that asked for it,
// at the place it asked. Go and Zig both take a handler because both can pass
// one; Kizu's function values cannot carry a borrow, so a handler could not be
// given the request, and a pull loop is what remains -- which is also the
// shape that keeps the control flow visible (docs/principles.md §2).
//
// One connection is served at a time. Kizu has no concurrency API (SPEC §15),
// so a second caller waits in the listen backlog until the first is answered.

pub struct Server {
    listener: std::net::TcpListener,
    limits: std::http::Limits,
}

// listen binds an address with the default limits. `address` is what
// std::net reads: `host:port`, IPv6 host bracketed, port 0 for a free one.
pub fn listen(io: Io, address: []u8) -> std::http::Failure!std::http::Server {
    return listen_with(io, address, std::http::default_limits());
}

// listen_with binds an address under limits the caller chose. A server behind
// a proxy and one on the open internet do not want the same ceiling.
pub fn listen_with(
    io: Io,
    address: []u8,
    limits: std::http::Limits
) -> std::http::Failure!std::http::Server {
    let listener = try std::net::tcp_listen(io, address);
    return Server { listener: move listener, limits: limits };
}

// local_port is the port this server is on. Binding port 0 and asking is how
// a program takes a free port without racing another for a fixed one.
fn (self: &std::http::Server) local_port() -> std::http::Failure!i64 {
    let port = try self.listener.local_port();
    return port;
}

fn (self: std::http::Server) deinit() -> void {
    self.listener.deinit();
    return;
}

// accept waits for one connection, reads one request off it, and hands back
// the exchange. A request this server cannot read is answered on the spot --
// the client is owed a status, and the caller cannot send one for a request
// that never parsed -- and then the failure is returned.
fn (self: &var std::http::Server) accept(
    io: Io,
    allocator: Allocator
) -> std::http::Failure!std::http::Exchange {
    return self.accept_message(io, allocator, true);
}

// accept_head stops at the blank line. The body is left where it is, so a
// caller that wants to stream an upload rather than hold it reads it with
// `exchange.read_body_into` -- and `max_body_bytes` never applies, because
// nothing here is holding the body for it to bound.
//
// `Transfer-Encoding` is still refused. Deciding the framing is what makes
// two requests out of one (request smuggling), and handing that decision over
// is a bigger door than this one opens.
fn (self: &var std::http::Server) accept_head(
    io: Io,
    allocator: Allocator
) -> std::http::Failure!std::http::Exchange {
    var held = try self.accept_message(io, allocator, false);
    // The body phase starts here, because the caller is the one reading it.
    // One deadline covers the whole body; a caller reading for longer than a
    // body pushes it forward itself.
    let read_millis = self.limits.read_body_millis;
    held.arm_read_phase(read_millis);
    return move held;
}

fn (self: &var std::http::Exchange) arm_read_phase(millis: i64) -> void {
    std::http::arm_read(&var self.stream, millis);
    return;
}

fn (self: &var std::http::Server) accept_message(
    io: Io,
    allocator: Allocator,
    read_body: bool
) -> std::http::Failure!std::http::Exchange {
    var stream = try self.listener.accept(io);
    errdefer stream.deinit();
    var pending = std::string::new(allocator);
    errdefer pending.deinit(allocator);
    if read_request(io, allocator, &var stream, self.limits, read_body, &var pending) |request| {
        var owned = move request;
        errdefer owned.deinit(allocator);
        return Exchange {
            stream: move stream,
            request: move owned,
            response: std::http::response_new(allocator),
            answered: false,
            pending: move pending,
            pending_at: 0,
            limits: self.limits,
        };
    } else |failure| {
        refuse(io, allocator, &var stream, failure, self.limits);
        return failure;
    }
}

// An Exchange is one request, the response owed for it, and the connection
// the two travel on. All three are fields, so a caller reads
// `exchange.request.headers` and writes `exchange.response.write(...)` the
// way it would any other struct.
//
// The connection is not a field a caller reaches. `write_all` and `read_into`
// are, and they are the whole of what a caller can do to it -- which is enough
// to write a body this module did not frame, or to speak whatever protocol a
// 101 upgraded to.
//
// Handing out the stream itself would be handing out half of it: reading a
// head reads whole packets, so the first bytes of what comes next are already
// in `pending` and a read that went to the socket would skip them. Go hands a
// hijacker its buffered reader beside the connection for the same reason.
pub struct Exchange {
    stream: std::net::TcpStream,
    pub request: std::http::Request,
    pub response: std::http::Response,
    answered: bool,
    // Bytes that arrived behind the head and have not been handed out. Reading
    // the head reads whatever the peer had already sent, so a body this server
    // did not copy into the request starts here rather than on the socket.
    pending: std::string::String,
    pending_at: i64,
    // The server's policy, carried so `respond` can make the write deadline
    // when the write starts. A deadline stamped at accept would already be
    // spent by whatever the caller did in between.
    limits: std::http::Limits,
}

// respond sends the response and marks the exchange answered. It is called
// once: a second call is Error::ResponseFinished rather than a second message
// on a connection the first one already framed.
fn (self: &var std::http::Exchange) respond(
    io: Io,
    allocator: Allocator
) -> std::http::Failure!void {
    if self.answered {
        return std::http::Error::ResponseFinished;
    }
    let method = self.request.method.as_bytes();
    let head_only = std::mem::equal_bytes(method, "HEAD");
    try self.send_head(io, allocator, std::http::Framing::Buffered, head_only);
    return;
}

// respond_head sends the head and stops. What follows the head is then the
// caller's to write through `stream`, and `framing` is what the head told the
// peer about where that body ends.
//
// The exchange is answered afterwards, so `respond` cannot also send one --
// the head is already on the connection, and a second one would be a second
// message the first did not frame.
fn (self: &var std::http::Exchange) respond_head(
    io: Io,
    allocator: Allocator,
    framing: std::http::Framing
) -> std::http::Failure!void {
    if self.answered {
        return std::http::Error::ResponseFinished;
    }
    try self.send_head(io, allocator, framing, true);
    return;
}

fn (self: &var std::http::Exchange) send_head(
    io: Io,
    allocator: Allocator,
    framing: std::http::Framing,
    head_only: bool
) -> std::http::Failure!void {
    self.response.finish();
    let version = self.request.version;
    var out = std::string::new(allocator);
    defer out.deinit(allocator);
    try self.response.encode(allocator, version, framing, head_only, &var out);
    let wire = out.as_bytes();
    let write_millis = self.limits.write_millis;
    std::http::arm_write(&var self.stream, write_millis);
    try self.stream.write_all(io, wire);
    self.answered = true;
    return;
}

// write_all puts bytes on the connection with nothing added. It is what a
// caller uses after `respond_head`: the head said how the body ends, and these
// are the body.
//
// It does not touch the deadline. `respond_head` set one for the write phase,
// and re-arming here would hand a fresh budget back on every call -- which is
// the per-call timeout this module does not have. A stream that outlives one
// phase pushes its own deadline forward with `set_write_deadline`.
fn (self: &var std::http::Exchange) write_all(
    io: Io,
    bytes: []u8
) -> std::http::Failure!void {
    try self.stream.write_all(io, bytes);
    return;
}

// The connection's deadlines, for a caller that has taken the body or the
// protocol over. One phase's deadline is set when that phase starts; a caller
// whose work is not one phase says so here.
fn (self: &var std::http::Exchange) set_read_deadline(at: i64) -> void {
    self.stream.set_read_deadline(at);
    return;
}

fn (self: &var std::http::Exchange) set_write_deadline(at: i64) -> void {
    self.stream.set_write_deadline(at);
    return;
}

fn (self: &var std::http::Exchange) clear_read_deadline() -> void {
    self.stream.clear_read_deadline();
    return;
}

fn (self: &var std::http::Exchange) clear_write_deadline() -> void {
    self.stream.clear_write_deadline();
    return;
}

// read_into is how a caller reads what this server did not: a body left on
// the connection by `accept_head`, or whatever a 101 upgraded to. It answers
// the way `std::net::read_into` does -- how many bytes it appended, and 0 for
// the end of the stream -- so the loop that knows when the message is complete
// is still the caller's.
//
// The bytes that arrived behind the head come out first, which is the reason
// this exists rather than the socket being handed over.
fn (self: &var std::http::Exchange) read_into(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    max: i64
) -> std::http::Failure!i64 {
    if max <= 0 {
        return std::net::Error::InvalidLength;
    }
    let held = self.pending.len() - self.pending_at;
    if held > 0 {
        var take = held;
        if take > max {
            take = max;
        }
        let start = self.pending_at;
        try self.copy_pending(allocator, out, start, start + take);
        self.pending_at = start + take;
        return take;
    }
    let count = try self.stream.read_into(io, allocator, out, max);
    return count;
}

fn (self: &std::http::Exchange) copy_pending(
    allocator: Allocator,
    out: &var std::string::String,
    from: i64,
    to: i64
) -> std::http::Failure!void {
    let bytes = self.pending.as_bytes();
    try out.append_bytes(allocator, bytes[from..to]);
    return;
}

// respond_text is the whole answer in one call: a status, a content type, and
// a body. It is what most handlers want, and writing it out by hand is what
// the fields are still there for.
fn (self: &var std::http::Exchange) respond_text(
    io: Io,
    allocator: Allocator,
    status: i64,
    content_type: []u8,
    body: []u8
) -> std::http::Failure!void {
    try self.response.set_status(status);
    try self.response.header(allocator, "Content-Type", content_type);
    try self.response.write(allocator, body);
    try self.respond(io, allocator);
    return;
}

fn (self: &std::http::Exchange) is_answered() -> bool {
    return self.answered;
}

fn (self: std::http::Exchange) deinit(allocator: Allocator) -> void {
    self.stream.deinit();
    self.request.deinit(allocator);
    self.response.deinit(allocator);
    self.pending.deinit(allocator);
    return;
}

// read_request reads the head up to the blank line, and then -- if the caller
// asked for it -- exactly the body Content-Length declared. Whatever arrived
// behind what it took is copied into `pending`, because reading a head reads
// whole packets and those bytes are the peer's, not this buffer's to drop.
fn read_request(
    io: Io,
    allocator: Allocator,
    stream: &var std::net::TcpStream,
    limits: std::http::Limits,
    read_body: bool,
    pending: &var std::string::String
) -> std::http::Failure!std::http::Request {
    var buffer = std::string::new(allocator);
    defer buffer.deinit(allocator);
    std::http::arm_read(stream, limits.read_head_millis);
    let head_length = try std::http::read_head(io, allocator, stream, &var buffer, limits);
    var request = try parse_request_at(allocator, &buffer, head_length, limits);
    errdefer request.deinit(allocator);
    // Guessing how a body is framed is how two requests become one (request
    // smuggling), so a framing this server does not speak is refused whether
    // or not it is the one reading the body.
    if request.headers.has("Transfer-Encoding") {
        return std::http::Error::UnsupportedEncoding;
    }
    var consumed = head_length;
    if read_body {
        let length = try read_request_body(
            io, allocator, stream, &var buffer, &var request, head_length, limits);
        consumed = head_length + length;
    }
    try copy_tail(allocator, &buffer, pending, consumed);
    return move request;
}

// copy_tail keeps what arrived behind the message this server took.
fn copy_tail(
    allocator: Allocator,
    buffer: &std::string::String,
    pending: &var std::string::String,
    from: i64
) -> std::http::Failure!void {
    let bytes = buffer.as_bytes();
    let length = std::mem::len(bytes);
    if from >= length {
        return;
    }
    try pending.append_bytes(allocator, bytes[from..length]);
    return;
}

fn parse_request_at(
    allocator: Allocator,
    buffer: &std::string::String,
    head_length: i64,
    limits: std::http::Limits
) -> std::http::Failure!std::http::Request {
    let bytes = buffer.as_bytes();
    return std::http::parse_request_head(allocator, bytes[0..head_length], limits);
}

// read_body reads what Content-Length declared and copies it into the request.
// A message with no Content-Length has no body: without one there is nothing
// that says where a body would end, and guessing is how two requests become
// one (request smuggling).
fn read_request_body(
    io: Io,
    allocator: Allocator,
    stream: &var std::net::TcpStream,
    buffer: &var std::string::String,
    request: &var std::http::Request,
    head_length: i64,
    limits: std::http::Limits
) -> std::http::Failure!i64 {
    let declared = try request.content_length();
    var length = 0;
    if declared |value| {
        length = value;
    }
    if length == 0 {
        return 0;
    }
    if length > limits.max_body_bytes {
        return std::http::Error::BodyTooLarge;
    }
    // The body gets its own deadline. Sharing the head's would give a large
    // body whatever the head happened to leave over.
    std::http::arm_read(stream, limits.read_body_millis);
    while buffer.len() - head_length < length {
        let missing = length - (buffer.len() - head_length);
        let got = try stream.read_into(io, allocator, buffer, missing);
        if got == 0 {
            return std::http::Error::Incomplete;
        }
    }
    try copy_request_body(allocator, buffer, request, head_length, length);
    return length;
}

fn copy_request_body(
    allocator: Allocator,
    buffer: &std::string::String,
    request: &var std::http::Request,
    head_length: i64,
    length: i64
) -> std::http::Failure!void {
    let bytes = buffer.as_bytes();
    try request.body.append_bytes(allocator, bytes[head_length..head_length + length]);
    return;
}

// refuse answers a request that could not be read. The client is owed a
// status, and the caller never got an exchange to send one with. A write that
// fails here is dropped: the failure being reported is the one that already
// happened, and the peer that would not take the answer cannot be told twice.
fn refuse(
    io: Io,
    allocator: Allocator,
    stream: &var std::net::TcpStream,
    failure: std::http::Failure,
    limits: std::http::Limits
) -> void {
    let status = refusal_status(failure);
    var out = std::string::new(allocator);
    defer out.deinit(allocator);
    var response = std::http::response_new(allocator);
    defer response.deinit(allocator);
    response.set_status(status) catch return;
    response.header(allocator, "Content-Type", "text/plain") catch return;
    response.write(allocator, std::http::status_text(status)) catch return;
    response.encode(
        allocator, std::http::Version::Http11, std::http::Framing::Buffered,
        false, &var out) catch return;
    let wire = out.as_bytes();
    std::http::arm_write(stream, limits.write_millis);
    stream.write_all(io, wire) catch return;
    return;
}

// refusal_status maps a read failure to what the client should be told. A
// ceiling this server chose is a 4xx about the request; anything else is this
// server's own trouble.
fn refusal_status(failure: std::http::Failure) -> i64 {
    return match failure {
        MalformedRequest => 400,
        Incomplete => 400,
        InvalidHeader => 400,
        HeadTooLarge => 431,
        BodyTooLarge => 413,
        UnsupportedVersion => 505,
        UnsupportedEncoding => 501,
        // The deadline this server set ran out. RFC 9110 gives that its own
        // status: the request was not wrong, it just never finished arriving.
        TimedOut => 408,
        _ => 500,
    };
}
