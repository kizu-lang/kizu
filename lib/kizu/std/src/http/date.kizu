// An HTTP date is the IMF-fixdate of RFC 9110 §5.6.7: `Sun, 06 Nov 1994
// 08:49:37 GMT`, always UTC and always this one spelling when sent. A
// recipient has to read two older spellings as well, so reading is a separate
// piece of work; nothing here reads a date.

// append_date writes `moment` in the one spelling a sender may use. The
// format has four digits for the year, so a year outside 0..9999 is refused
// rather than spelled in a form no peer would read.
pub fn append_date(
    allocator: Allocator,
    out: &var std::string::String,
    moment: std::date::DateTime
) -> std::http::Failure!void {
    let day = moment.date();
    if day.year() < 0 or day.year() > 9999 {
        return std::http::Error::InvalidHeader;
    }
    let weekday = day.weekday();
    try out.append_bytes(allocator, weekday_text(weekday));
    try out.append_bytes(allocator, ", ");
    try append_padded(allocator, out, day.day(), 10);
    try out.append_byte(allocator, cast<u8>(32));
    try out.append_bytes(allocator, month_text(day.month()));
    try out.append_byte(allocator, cast<u8>(32));
    try append_padded(allocator, out, day.year(), 1000);
    try out.append_byte(allocator, cast<u8>(32));
    try append_padded(allocator, out, moment.hour(), 10);
    try out.append_byte(allocator, cast<u8>(58));
    try append_padded(allocator, out, moment.minute(), 10);
    try out.append_byte(allocator, cast<u8>(58));
    try append_padded(allocator, out, moment.second(), 10);
    try out.append_bytes(allocator, " GMT");
    return;
}

// append_padded writes `value` with leading zeros down from the `top` digit:
// 10 for two digits, 1000 for four.
fn append_padded(
    allocator: Allocator,
    out: &var std::string::String,
    value: i64,
    top: i64
) -> std::http::Failure!void {
    var digit = top;
    while digit > 1 and value < digit {
        try out.append_byte(allocator, cast<u8>(48));
        digit = digit / 10;
    }
    try std::fmt::append_i64(allocator, out, value);
    return;
}

fn weekday_text(weekday: std::date::Weekday) -> []u8 {
    return match weekday {
        Monday => "Mon",
        Tuesday => "Tue",
        Wednesday => "Wed",
        Thursday => "Thu",
        Friday => "Fri",
        Saturday => "Sat",
        Sunday => "Sun",
    };
}

fn month_text(month: i64) -> []u8 {
    if month == 1 {
        return "Jan";
    }
    if month == 2 {
        return "Feb";
    }
    if month == 3 {
        return "Mar";
    }
    if month == 4 {
        return "Apr";
    }
    if month == 5 {
        return "May";
    }
    if month == 6 {
        return "Jun";
    }
    if month == 7 {
        return "Jul";
    }
    if month == 8 {
        return "Aug";
    }
    if month == 9 {
        return "Sep";
    }
    if month == 10 {
        return "Oct";
    }
    if month == 11 {
        return "Nov";
    }
    return "Dec";
}
