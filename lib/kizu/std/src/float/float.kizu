// The bits of a floating-point value, and a value from its bits.
//
// A float is a sign, an exponent, and a mantissa laid out in 64 bits by IEEE
// 754. Everything that turns a float into text or text into a float reads
// that layout, and nothing in the language can look at it: a `cast` converts
// the value, not its representation. These two are the one place the
// representation is visible, and they are the only trusted primitives the
// floating-point support rests on.

// bits returns the IEEE 754 binary64 representation of value.
pub fn bits(value: f64) -> u64 {
    return std::internal::builtin::f64_bits(value);
}

// from_bits returns the value whose IEEE 754 binary64 representation is bits.
pub fn from_bits(bits: u64) -> f64 {
    return std::internal::builtin::f64_from_bits(bits);
}
