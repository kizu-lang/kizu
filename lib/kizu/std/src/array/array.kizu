pub error Error {
    OutOfBounds,
}

pub fn new<T>(allocator: Allocator) -> std::array::Array<T> {
    return std::internal::builtin::array<T>(allocator);
}

// append names the allocator its storage grows from. An Array header is
// `{data, len, cap}` and keeps no allocator, so what a growth needs is spelled
// where the growth is asked for: allocation is an explicit allocator
// (原理 4) and the header pays no word for it (ADR-0132).
fn (self: &var std::array::Array<T>) append<T>(
    allocator: Allocator,
    value: T
) -> std::mem::Error!void {
    return std::internal::builtin::array_append<T>(self, allocator, value);
}

// append_bytes copies a whole run into a byte array in one call. Appending
// byte by byte reaches the same place through one capacity check and one
// store per byte, and text is built out of runs.
fn (self: &var std::array::Array<T>) append_bytes<T>(
    allocator: Allocator,
    bytes: []u8
) -> std::mem::Error!void {
    return std::internal::builtin::array_append_bytes<T>(self, allocator, bytes);
}

fn (self: &std::array::Array<T>) len<T>() -> i64 {
    return std::internal::builtin::array_len<T>(self);
}

fn (self: &std::array::Array<T>) capacity<T>() -> i64 {
    return std::internal::builtin::array_capacity<T>(self);
}

fn (self: &var std::array::Array<T>) reserve<T>(
    allocator: Allocator,
    additional: i64
) -> std::mem::Error!void {
    return std::internal::builtin::array_reserve<T>(self, allocator, additional);
}

fn (self: &std::array::Array<T>) clone<T>(allocator: Allocator) -> std::mem::Error!std::array::Array<T> {
    var out = std::array::new<T>(allocator);
    errdefer out.deinit(allocator);
    try out.reserve(allocator, self.len());
    var index = 0;
    while self.get(index) |item| {
        try out.append(allocator, item);
        index = index + 1;
    }
    return out;
}

fn (self: &var std::array::Array<T>) pop<T>() -> ?T {
    return std::internal::builtin::array_pop<T>(self);
}

fn (self: &var std::array::Array<T>) pop_or_panic<T>() -> T {
    return std::internal::builtin::array_pop_or_panic<T>(self);
}

fn (self: &std::array::Array<T>) get<T>(index: i64) -> ?T {
    return std::internal::builtin::array_get<T>(self, index);
}

fn (self: &std::array::Array<T>) get_or_panic<T>(index: i64) -> T {
    return std::internal::builtin::array_get_or_panic<T>(self, index);
}

fn (self: &std::array::Array<T>) at<T>(index: i64) -> ?&T {
    return std::internal::builtin::array_at<T>(self, index);
}

fn (self: &var std::array::Array<T>) at_mut<T>(index: i64) -> ?&var T {
    return std::internal::builtin::array_at_mut<T>(self, index);
}

fn (self: &var std::array::Array<T>) set<T>(index: i64, value: T) -> std::array::Error!void {
    return std::internal::builtin::array_set<T>(self, index, value);
}

// swap exchanges two initialized slots without copying or destroying either
// value. The primitive performs both bounds checks before touching storage.
fn (self: &var std::array::Array<T>) swap<T>(left: i64, right: i64) -> std::array::Error!void {
    return std::internal::builtin::array_swap<T>(self, left, right);
}

// remove moves one initialized element out and closes the gap without
// copying or destroying any owner. The initial check is the only recoverable
// failure; after it succeeds every adjacent swap is in bounds.
fn (self: &var std::array::Array<T>) remove<T>(index: i64) -> std::array::Error!T {
    let length = self.len();
    if index < 0 or index >= length {
        return std::array::Error::OutOfBounds;
    }
    var at = index;
    while at + 1 < length {
        self.swap(at, at + 1) catch
            std::internal::builtin::panic("std::array::Array.remove: checked swap failed");
        at = at + 1;
    }
    return self.pop_or_panic();
}

// deinit consumes every element, then releases the backing buffer. An element
// that owns nothing has nothing to consume, so the loop is not generated for
// it and this is one runtime op; an element that owns something is released
// with it, which is what keeps a container from leaking its contents
// (ADR-0091). The call is in source either way, so nothing is hidden.
fn (self: std::array::Array<T>) deinit<T>(allocator: Allocator) -> void {
    comptime if std::meta::is_owner<T>() {
        // An element that frees memory names the allocator; one that closes a
        // descriptor has nothing to name (ADR-0132). Asking is what lets a
        // collection hold either.
        comptime if std::meta::release_names_allocator<T>() {
            while self.len() > 0 {
                let item = self.pop_or_panic();
                item.deinit(allocator);
            }
        } else {
            while self.len() > 0 {
                let item = self.pop_or_panic();
                item.deinit();
            }
        }
    } else {}
    std::internal::builtin::array_deinit<T>(self, allocator);
}

// truncate validates before touching the collection, then releases removed
// owners from the last element down. Plain elements have no cleanup body, so
// their instance remains one storage primitive.
fn (self: &var std::array::Array<T>) truncate<T>(
    allocator: Allocator,
    length: i64
) -> std::array::Error!void {
    comptime if std::meta::is_owner<T>() {
        if length < 0 or length > self.len() {
            return std::array::Error::OutOfBounds;
        }
        comptime if std::meta::release_names_allocator<T>() {
            while self.len() > length {
                let item = self.pop_or_panic();
                item.deinit(allocator);
            }
        } else {
            while self.len() > length {
                let item = self.pop_or_panic();
                item.deinit();
            }
        }
    } else {
        return std::internal::builtin::array_truncate<T>(self, length);
    }
    return;
}

// clear releases every owner from the last element down while retaining the
// allocation. Plain elements collapse to the single storage primitive.
fn (self: &var std::array::Array<T>) clear<T>(allocator: Allocator) -> void {
    comptime if std::meta::is_owner<T>() {
        comptime if std::meta::release_names_allocator<T>() {
            while self.len() > 0 {
                let item = self.pop_or_panic();
                item.deinit(allocator);
            }
        } else {
            while self.len() > 0 {
                let item = self.pop_or_panic();
                item.deinit();
            }
        }
    } else {
        std::internal::builtin::array_clear<T>(self);
    }
    return;
}

fn (self: &std::array::Array<T>) as_bytes<T>() -> []u8 {
    return std::internal::builtin::array_as_bytes<T>(self);
}

fn (self: &var std::array::Array<T>) as_mut_bytes<T>() -> &var []u8 {
    return std::internal::builtin::array_as_mut_bytes<T>(self);
}
