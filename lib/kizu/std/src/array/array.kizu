pub error Error {
    OutOfBounds,
}

pub fn new<T>(allocator: Allocator) -> std::array::Array<T> {
    return std::internal::builtin::array<T>(allocator);
}

fn (self: &var std::array::Array<T>) append<T>(value: T) -> std::mem::Error!void {
    return std::internal::builtin::array_append<T>(self, value);
}

fn (self: &std::array::Array<T>) len<T>() -> i64 {
    return std::internal::builtin::array_len<T>(self);
}

fn (self: &std::array::Array<T>) capacity<T>() -> i64 {
    return std::internal::builtin::array_capacity<T>(self);
}

fn (self: &var std::array::Array<T>) reserve<T>(additional: i64) -> std::mem::Error!void {
    return std::internal::builtin::array_reserve<T>(self, additional);
}

fn (self: &std::array::Array<T>) clone<T>(allocator: Allocator) -> std::mem::Error!std::array::Array<T> {
    var out = std::array::new<T>(allocator);
    errdefer out.deinit();
    try out.reserve(self.len());
    var index = 0;
    while self.get(index) |item| {
        try out.append(item);
        index = index + 1;
    }
    return out;
}

fn (self: &var std::array::Array<T>) pop<T>() -> ?T {
    return std::internal::builtin::array_pop<T>(self);
}

fn (self: &var std::array::Array<T>) pop_or_panic<T>() -> T {
    return std::internal::builtin::array_pop_or_panic<T>(self);
}

fn (self: &std::array::Array<T>) get<T>(index: i64) -> ?T {
    return std::internal::builtin::array_get<T>(self, index);
}

fn (self: &std::array::Array<T>) get_or_panic<T>(index: i64) -> T {
    return std::internal::builtin::array_get_or_panic<T>(self, index);
}

fn (self: &std::array::Array<T>) at<T>(index: i64) -> ?&T {
    return std::internal::builtin::array_at<T>(self, index);
}

fn (self: &var std::array::Array<T>) at_mut<T>(index: i64) -> ?&var T {
    return std::internal::builtin::array_at_mut<T>(self, index);
}

fn (self: &var std::array::Array<T>) set<T>(index: i64, value: T) -> std::array::Error!void {
    return std::internal::builtin::array_set<T>(self, index, value);
}

// swap exchanges two initialized slots without copying or destroying either
// value. The primitive performs both bounds checks before touching storage.
fn (self: &var std::array::Array<T>) swap<T>(left: i64, right: i64) -> std::array::Error!void {
    return std::internal::builtin::array_swap<T>(self, left, right);
}

// deinit consumes every element, then releases the backing buffer. An element
// that owns nothing has nothing to consume, so the loop is not generated for
// it and this is one runtime op; an element that owns something is released
// with it, which is what keeps a container from leaking its contents
// (ADR-0091). The call is in source either way, so nothing is hidden.
fn (self: std::array::Array<T>) deinit<T>() -> void {
    comptime if std::meta::is_owner<T>() {
        while self.len() > 0 {
            let item = self.pop_or_panic();
            item.deinit();
        }
    } else {}
    std::internal::builtin::array_deinit<T>(self);
}

fn (self: &var std::array::Array<T>) truncate<T>(length: i64) -> std::array::Error!void {
    return std::internal::builtin::array_truncate<T>(self, length);
}

fn (self: &var std::array::Array<T>) clear<T>() -> void {
    std::internal::builtin::array_clear<T>(self);
}

fn (self: &std::array::Array<T>) as_bytes<T>() -> []u8 {
    return std::internal::builtin::array_as_bytes<T>(self);
}

fn (self: &var std::array::Array<T>) as_mut_bytes<T>() -> &var []u8 {
    return std::internal::builtin::array_as_mut_bytes<T>(self);
}
