// The client side of the handshake (RFC 8446 §2): `connect` sends a
// ClientHello, takes the server's messages in the order the client
// machine in handshake.kizu allows, judges the server's certificates
// with std::crypto::x509, and returns a connected `Connection`. A
// failure anywhere sends the alert the RFC names for it and closes.

// connect opens a TCP connection to `address` and completes a TLS 1.3
// handshake with it as `host`: the server's chain must vouch for `host`
// at `now` (seconds since 1970) under one of the `roots`, the way
// std::crypto::x509::verify_chain judges. The connection is ready for
// application data when this returns.
pub fn connect(
    io: Io,
    allocator: Allocator,
    address: []u8,
    host: []u8,
    roots: &std::array::Array<std::string::String>,
    now: i64
) -> std::tls::Failure!std::tls::Connection {
    var stream = try std::net::tcp_connect(io, address);
    var client = new_connection(allocator, move stream, Role::Client);
    errdefer client.deinit(allocator);
    try client.handshake(io, allocator, host, roots, now);
    return move client;
}

// handshake sends the ClientHello and takes the server's messages until
// the connection is connected.
fn (self: &var std::tls::Connection) handshake(
    io: Io,
    allocator: Allocator,
    host: []u8,
    roots: &std::array::Array<std::string::String>,
    now: i64
) -> std::tls::Failure!void {
    // 96 random bytes: the hello's random, the session id, and the
    // x25519 private key.
    let random = try std::crypto::random_bytes(io, allocator, 96);
    defer random.deinit(allocator);
    let drawn = random.as_bytes();
    var share_buffer = [32]u8{};
    let share = share_buffer.as_mut_bytes();
    std::crypto::x25519_base(drawn[64..96], share);
    let share_bytes = share_buffer.as_bytes();
    var hello = std::string::new(allocator);
    defer hello.deinit(allocator);
    try std::tls::write_client_hello(allocator, &var hello, drawn[0..32], drawn[32..64], host, share_bytes);
    let hello_bytes = hello.as_bytes();
    try self.transcript.append_bytes(allocator, hello_bytes);
    try self.send(io, allocator, std::tls::content_handshake(), hello_bytes);
    while !self.connected() {
        var message = std::string::new(allocator);
        defer message.deinit(allocator);
        try self.next_handshake_message(io, allocator, &var message);
        let message_bytes = message.as_bytes();
        try self.take_message(io, allocator, message_bytes, drawn[32..96], host, roots, now);
    }
    self.transcript.clear();
    return;
}

// event_of is the event a handshake message is to the state machine.
fn event_of(kind: u8, retry: bool) -> ?std::tls::Event {
    if kind == std::tls::handshake_server_hello() {
        if retry {
            return std::tls::Event::HelloRetryRequest;
        }
        return std::tls::Event::ServerHello;
    }
    if kind == std::tls::handshake_encrypted_extensions() {
        return std::tls::Event::EncryptedExtensions;
    }
    if kind == std::tls::handshake_certificate_request() {
        return std::tls::Event::CertificateRequest;
    }
    if kind == std::tls::handshake_certificate() {
        return std::tls::Event::Certificate;
    }
    if kind == std::tls::handshake_certificate_verify() {
        return std::tls::Event::CertificateVerify;
    }
    if kind == std::tls::handshake_finished() {
        return std::tls::Event::Finished;
    }
    if kind == std::tls::handshake_new_session_ticket() {
        return std::tls::Event::NewSessionTicket;
    }
    if kind == std::tls::handshake_key_update() {
        return std::tls::Event::KeyUpdate;
    }
    return null;
}

// take_message handles one handshake message from the server. `secrets`
// is the session id followed by the x25519 private key.
fn (self: &var std::tls::Connection) take_message(
    io: Io,
    allocator: Allocator,
    message: []u8,
    secrets: []u8,
    host: []u8,
    roots: &std::array::Array<std::string::String>,
    now: i64
) -> std::tls::Failure!void {
    let kind = message[0];
    if kind == std::tls::handshake_server_hello() {
        return self.take_server_hello(io, allocator, message, secrets);
    }
    if kind == std::tls::handshake_certificate() {
        return self.take_certificate(io, allocator, message, host, roots, now);
    }
    if kind == std::tls::handshake_certificate_verify() {
        return self.take_certificate_verify(io, allocator, message);
    }
    if kind == std::tls::handshake_finished() {
        return self.take_finished(io, allocator, message);
    }
    if kind == std::tls::handshake_key_update() {
        return self.take_key_update(io, allocator, message);
    }
    if event_of(kind, false) |event| {
        try self.advance_with(io, allocator, event);
    } else {
        try self.fail(io, allocator, alert_unexpected_message());
        return std::tls::Error::UnexpectedMessage;
    }
    if kind == std::tls::handshake_certificate_request() {
        self.certificate_requested = true;
    }
    if self.state != std::tls::State::Connected {
        try self.transcript.append_bytes(allocator, message);
    }
    return;
}

// take_server_hello reads the ServerHello, computes the shared secret,
// and turns on the handshake keys.
fn (self: &var std::tls::Connection) take_server_hello(
    io: Io,
    allocator: Allocator,
    message: []u8,
    secrets: []u8
) -> std::tls::Failure!void {
    let hello = try self.read_server_hello_or_alert(io, allocator, message, secrets[0..32]);
    try self.advance_with(io, allocator, event_of(message[0], hello.retry) orelse std::tls::Event::ServerHello);
    self.suite = hello.suite;
    try self.transcript.append_bytes(allocator, message);
    var shared_buffer = [32]u8{};
    let shared = shared_buffer.as_mut_bytes();
    try self.agree_or_alert(io, allocator, secrets[32..64], message[hello.key_share_start..hello.key_share_end], shared);
    let shared_bytes = shared_buffer.as_bytes();
    var early_buffer = [32]u8{};
    let early = early_buffer.as_mut_bytes();
    std::tls::early_secret(early);
    let early_bytes = early_buffer.as_bytes();
    var handshake_buffer = [32]u8{};
    let handshake_secret = handshake_buffer.as_mut_bytes();
    std::tls::handshake_secret(early_bytes, shared_bytes, handshake_secret);
    let handshake_bytes = handshake_buffer.as_bytes();
    self.handshake_secret.clear();
    try self.handshake_secret.append_bytes(allocator, handshake_bytes);
    var hash_buffer = [32]u8{};
    let hash = hash_buffer.as_mut_bytes();
    self.hash_transcript(hash);
    let hash_bytes = hash_buffer.as_bytes();
    try self.install_read_secret(allocator, handshake_bytes, "s hs traffic", hash_bytes);
    try self.install_write_secret(allocator, handshake_bytes, "c hs traffic", hash_bytes);
    return;
}

fn (self: &var std::tls::Connection) read_server_hello_or_alert(
    io: Io,
    allocator: Allocator,
    message: []u8,
    session_id: []u8
) -> std::tls::Failure!std::tls::ServerHello {
    if std::tls::read_server_hello(message, session_id) |hello| {
        return hello;
    } else |err| {
        try self.fail(io, allocator, alert_illegal_parameter());
        return err;
    }
}

// take_certificate reads the server's chain, verifies it for the host
// under the roots, and keeps the server's public key.
fn (self: &var std::tls::Connection) take_certificate(
    io: Io,
    allocator: Allocator,
    message: []u8,
    host: []u8,
    roots: &std::array::Array<std::string::String>,
    now: i64
) -> std::tls::Failure!void {
    try self.advance_with(io, allocator, std::tls::Event::Certificate);
    var chain = std::array::new<std::string::String>(allocator);
    defer chain.deinit(allocator);
    try self.read_chain_or_alert(io, allocator, message, &var chain);
    try self.verify_chain_or_alert(io, allocator, &chain, roots, host, now);
    if chain.at(0) |leaf| {
        let der = leaf.as_bytes();
        let cert = try std::crypto::x509::parse(der);
        let key = cert.public_key();
        self.peer_key.clear();
        try self.peer_key.append_bytes(allocator, key);
        self.peer_key_algorithm = cert.key_algorithm;
    }
    try self.transcript.append_bytes(allocator, message);
    return;
}

fn (self: &var std::tls::Connection) read_chain_or_alert(
    io: Io,
    allocator: Allocator,
    message: []u8,
    chain: &var std::array::Array<std::string::String>
) -> std::tls::Failure!void {
    if std::tls::read_certificate(allocator, message, chain) {
        return;
    } else |err| {
        try self.fail(io, allocator, alert_illegal_parameter());
        return err;
    }
}

fn (self: &var std::tls::Connection) verify_chain_or_alert(
    io: Io,
    allocator: Allocator,
    chain: &std::array::Array<std::string::String>,
    roots: &std::array::Array<std::string::String>,
    host: []u8,
    now: i64
) -> std::tls::Failure!void {
    if std::crypto::x509::verify_chain(chain, roots, host, now) {
        return;
    } else |err| {
        try self.fail(io, allocator, certificate_alert(err));
        return err;
    }
}

// certificate_alert is the alert a chain's failure calls for.
fn certificate_alert(err: std::crypto::x509::Error) -> u8 {
    return match err {
        Expired => alert_certificate_expired(),
        UnknownIssuer => alert_unknown_ca(),
        _ => alert_bad_certificate(),
    };
}

// take_certificate_verify checks the server's signature over the
// transcript so far under the key its certificate carries.
fn (self: &var std::tls::Connection) take_certificate_verify(
    io: Io,
    allocator: Allocator,
    message: []u8
) -> std::tls::Failure!void {
    try self.advance_with(io, allocator, std::tls::Event::CertificateVerify);
    let verify = try self.read_certificate_verify_or_alert(io, allocator, message);
    if !self.scheme_verifiable(verify.scheme) {
        try self.fail(io, allocator, alert_handshake_failure());
        return std::tls::Error::Unsupported;
    }
    let kind = scheme_hash(verify.scheme);
    var digest_buffer = [64]u8{};
    let digest = digest_buffer.as_mut_bytes();
    try self.certificate_verify_digest(allocator, kind, digest);
    let digest_bytes = digest[0..std::crypto::digest_length(kind)];
    let valid = self.signature_valid(verify.scheme, digest_bytes, message[verify.signature_start..verify.signature_end]);
    if !valid {
        try self.fail(io, allocator, alert_decrypt_error());
        return std::tls::Error::BadSignature;
    }
    try self.transcript.append_bytes(allocator, message);
    return;
}

// scheme_verifiable reports whether a CertificateVerify scheme is one
// this client checks with the key the server's certificate holds: ECDSA
// with the key on the scheme's curve, RSA-PSS with an RSA key.
fn (self: &std::tls::Connection) scheme_verifiable(scheme: i64) -> bool {
    if scheme == std::tls::signature_ecdsa_secp256r1_sha256() {
        return self.peer_key_algorithm == std::crypto::x509::KeyAlgorithm::EcdsaP256;
    }
    if scheme == std::tls::signature_ecdsa_secp384r1_sha384() {
        return self.peer_key_algorithm == std::crypto::x509::KeyAlgorithm::EcdsaP384;
    }
    if scheme == std::tls::signature_rsa_pss_rsae_sha256()
        or scheme == std::tls::signature_rsa_pss_rsae_sha384()
        or scheme == std::tls::signature_rsa_pss_rsae_sha512() {
        return self.peer_key_algorithm == std::crypto::x509::KeyAlgorithm::Rsa;
    }
    return false;
}

// signature_valid checks a CertificateVerify signature over `digest`
// under the server's key, as the scheme says.
fn (self: &std::tls::Connection) signature_valid(scheme: i64, digest: []u8, signature: []u8) -> bool {
    let key = self.peer_key.as_bytes();
    if scheme == std::tls::signature_ecdsa_secp256r1_sha256()
        or scheme == std::tls::signature_ecdsa_secp384r1_sha384() {
        return std::crypto::x509::ecdsa_signature_verifies(key, digest, signature);
    }
    return std::crypto::x509::rsa_pss_signature_verifies(scheme_hash(scheme), key, digest, signature);
}

fn (self: &var std::tls::Connection) read_certificate_verify_or_alert(
    io: Io,
    allocator: Allocator,
    message: []u8
) -> std::tls::Failure!std::tls::CertificateVerify {
    if std::tls::read_certificate_verify(message) |verify| {
        return verify;
    } else |err| {
        try self.fail(io, allocator, alert_illegal_parameter());
        return err;
    }
}

// take_finished checks the server's Finished, answers with the client's,
// and turns on the application keys.
fn (self: &var std::tls::Connection) take_finished(
    io: Io,
    allocator: Allocator,
    message: []u8
) -> std::tls::Failure!void {
    try self.check_finished_shape(io, allocator, message);
    let matches = self.finished_matches(message[4..36]);
    if !matches {
        try self.fail(io, allocator, alert_decrypt_error());
        return std::tls::Error::BadSignature;
    }
    try self.advance_with(io, allocator, std::tls::Event::Finished);
    try self.transcript.append_bytes(allocator, message);

    // The application secrets come from the transcript through the
    // server's Finished; the client's own messages are sent under the
    // handshake keys and change the hash for its Finished only.
    var server_secret_buffer = [32]u8{};
    var client_secret_buffer = [32]u8{};
    let server_secret = server_secret_buffer.as_mut_bytes();
    let client_secret = client_secret_buffer.as_mut_bytes();
    self.derive_application_secrets(server_secret, client_secret);

    if self.certificate_requested {
        var certificate = std::string::new(allocator);
        defer certificate.deinit(allocator);
        try std::tls::write_empty_certificate(allocator, &var certificate);
        let certificate_bytes = certificate.as_bytes();
        try self.transcript.append_bytes(allocator, certificate_bytes);
        try self.send(io, allocator, std::tls::content_handshake(), certificate_bytes);
    }
    var own_buffer = [32]u8{};
    let own = own_buffer.as_mut_bytes();
    self.own_finished(own);
    let own_bytes = own_buffer.as_bytes();
    var finished = std::string::new(allocator);
    defer finished.deinit(allocator);
    try std::tls::write_finished(allocator, &var finished, own_bytes);
    let finished_bytes = finished.as_bytes();
    try self.send(io, allocator, std::tls::content_handshake(), finished_bytes);

    let server_secret_bytes = server_secret_buffer.as_bytes();
    let client_secret_bytes = client_secret_buffer.as_bytes();
    try self.set_read_secret(allocator, server_secret_bytes);
    try self.set_write_secret(allocator, client_secret_bytes);
    return;
}
