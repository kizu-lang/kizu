// The server side of the handshake (RFC 8446 §2): `accept` takes the
// client's ClientHello off a socket, answers with everything through
// its Finished in one flight -- ServerHello, EncryptedExtensions, the
// certificate chain, a CertificateVerify signed with the chain's key,
// Finished -- waits for the client's Finished, and returns a connected
// `Connection`. A failure anywhere sends the alert the RFC names for it
// and closes.
//
// The server asks for no client certificate, resumes no session, and
// sends no HelloRetryRequest: a client that offers no x25519 share is
// answered with `handshake_failure`, as one that offers no suite or no
// signature scheme this server's key can sign with.

// accept completes a TLS 1.3 handshake as the server over `stream`, a
// connection a listener accepted, presenting `chain` -- the server's
// certificate first, then its issuers, each as DER -- and signing with
// `key`, the chain's private key as `std::crypto::x509::parse_private_key`
// read it. The connection is ready for application data when this
// returns. It is `accepting` followed by `accept_wait`.
pub fn accept(
    io: Io,
    allocator: Allocator,
    stream: std::net::TcpStream,
    chain: &std::array::Array<std::string::String>,
    key: &std::crypto::x509::PrivateKey
) -> std::tls::Failure!std::tls::Connection {
    var connection = accepting(allocator, move stream);
    errdefer connection.deinit(allocator);
    try connection.accept_wait(io, allocator, chain, key);
    return move connection;
}

// accepting is a server's connection over `stream` with the handshake not
// begun, for a caller that must not wait: `accept_ready` moves it on by
// what has arrived, and the caller's poller says when to call again.
pub fn accepting(allocator: Allocator, stream: std::net::TcpStream) -> std::tls::Connection {
    return new_connection(allocator, move stream, Role::Server);
}

// accept_wait runs the handshake of an accepting connection to the end,
// waiting on the socket for each of the client's messages.
pub fn (self: &var std::tls::Connection) accept_wait(
    io: Io,
    allocator: Allocator,
    chain: &std::array::Array<std::string::String>,
    key: &std::crypto::x509::PrivateKey
) -> std::tls::Failure!void {
    while !try self.accept_ready(io, allocator, chain, key) {
        let held = self.inbound.len() - self.inbound_at;
        try self.fill(io, allocator, held + 1);
    }
    return;
}

// accept_ready moves an accepting connection's handshake on by what has
// already arrived and answers whether it is done: the ClientHello, once
// whole, is answered with the server's whole flight; the client's
// Finished, once whole, connects. It never waits for the socket. A
// connection that failed and closed is `Error::Closed`.
pub fn (self: &var std::tls::Connection) accept_ready(
    io: Io,
    allocator: Allocator,
    chain: &std::array::Array<std::string::String>,
    key: &std::crypto::x509::PrivateKey
) -> std::tls::Failure!bool {
    if self.server_state == std::tls::ServerState::WaitClientHello {
        var hello = std::string::new(allocator);
        defer hello.deinit(allocator);
        if !try self.next_handshake_message_ready(io, allocator, &var hello) {
            return false;
        }
        let hello_bytes = hello.as_bytes();
        try self.take_client_hello(io, allocator, hello_bytes, chain, key);
    }
    if self.server_state == std::tls::ServerState::WaitFinished {
        var finished = std::string::new(allocator);
        defer finished.deinit(allocator);
        if !try self.next_handshake_message_ready(io, allocator, &var finished) {
            return false;
        }
        let finished_bytes = finished.as_bytes();
        try self.take_client_finished(io, allocator, finished_bytes);
        self.transcript.clear();
    }
    if self.closed() {
        return std::tls::Error::Closed;
    }
    return self.connected();
}

// take_client_hello takes the ClientHello and sends the server's flight
// through its Finished.
fn (self: &var std::tls::Connection) take_client_hello(
    io: Io,
    allocator: Allocator,
    hello_bytes: []u8,
    chain: &std::array::Array<std::string::String>,
    key: &std::crypto::x509::PrivateKey
) -> std::tls::Failure!void {
    if hello_bytes[0] != std::tls::handshake_client_hello() {
        try self.fail(io, allocator, alert_unexpected_message());
        return std::tls::Error::UnexpectedMessage;
    }
    try self.advance_server_with(io, allocator, std::tls::ServerEvent::ClientHello);
    let offered = try self.read_client_hello_or_alert(io, allocator, hello_bytes);
    let scheme = try self.choose_or_alert(io, allocator, &offered, key.algorithm);
    self.server_name.clear();
    try self.server_name.append_bytes(allocator, hello_bytes[offered.server_name_start..offered.server_name_end]);
    try self.transcript.append_bytes(allocator, hello_bytes);

    // 64 random bytes: the hello's random and the x25519 private key.
    let random = try std::crypto::random_bytes(io, allocator, 64);
    defer random.deinit(allocator);
    let drawn = random.as_bytes();
    try self.send_server_hello(io, allocator, hello_bytes, &offered, drawn);
    try self.install_handshake_keys(allocator, drawn[32..64], hello_bytes[offered.key_share_start..offered.key_share_end]);

    var extensions = std::string::new(allocator);
    defer extensions.deinit(allocator);
    try std::tls::write_encrypted_extensions(allocator, &var extensions);
    let extensions_bytes = extensions.as_bytes();
    try self.transcript.append_bytes(allocator, extensions_bytes);
    try self.send(io, allocator, std::tls::content_handshake(), extensions_bytes);

    var certificate = std::string::new(allocator);
    defer certificate.deinit(allocator);
    try std::tls::write_certificate(allocator, &var certificate, chain);
    let certificate_bytes = certificate.as_bytes();
    try self.transcript.append_bytes(allocator, certificate_bytes);
    try self.send(io, allocator, std::tls::content_handshake(), certificate_bytes);

    try self.send_certificate_verify(io, allocator, key, scheme);
    try self.send_finished(io, allocator);
    return;
}

fn (self: &var std::tls::Connection) read_client_hello_or_alert(
    io: Io,
    allocator: Allocator,
    message: []u8
) -> std::tls::Failure!std::tls::ClientHello {
    if std::tls::read_client_hello(message) |hello| {
        return hello;
    } else |err| {
        if err == std::tls::Error::Unsupported {
            try self.fail(io, allocator, alert_protocol_version());
        } else {
            try self.fail(io, allocator, alert_illegal_parameter());
        }
        return err;
    }
}

// choose_or_alert settles the suite and the signature scheme from what
// the client offered and what the key can sign, or answers
// handshake_failure: no suite in common, no x25519 share (this server
// sends no HelloRetryRequest), or no scheme for the key.
fn (self: &var std::tls::Connection) choose_or_alert(
    io: Io,
    allocator: Allocator,
    offered: &std::tls::ClientHello,
    algorithm: std::crypto::x509::KeyAlgorithm
) -> std::tls::Failure!i64 {
    if offered.aes {
        self.suite = std::tls::CipherSuite::Aes128GcmSha256;
    } else {
        self.suite = std::tls::CipherSuite::Chacha20Poly1305Sha256;
    }
    let scheme = choose_scheme(algorithm, offered.schemes) orelse 0;
    if (!offered.aes and !offered.chacha) or offered.key_share_end == 0 or scheme == 0 {
        try self.fail(io, allocator, alert_handshake_failure());
        return std::tls::Error::Unsupported;
    }
    return scheme;
}

// choose_scheme is the signature scheme a key of `algorithm` signs
// with among those the client accepts (`schemes` as `scheme_bit` bits):
// the curve's own for ECDSA, RSA-PSS over the shortest hash offered.
fn choose_scheme(algorithm: std::crypto::x509::KeyAlgorithm, schemes: i64) -> ?i64 {
    if algorithm == std::crypto::x509::KeyAlgorithm::EcdsaP256 {
        if schemes & std::tls::scheme_bit(std::tls::signature_ecdsa_secp256r1_sha256()) != 0 {
            return std::tls::signature_ecdsa_secp256r1_sha256();
        }
        return null;
    }
    if algorithm == std::crypto::x509::KeyAlgorithm::EcdsaP384 {
        if schemes & std::tls::scheme_bit(std::tls::signature_ecdsa_secp384r1_sha384()) != 0 {
            return std::tls::signature_ecdsa_secp384r1_sha384();
        }
        return null;
    }
    if algorithm != std::crypto::x509::KeyAlgorithm::Rsa {
        return null;
    }
    if schemes & std::tls::scheme_bit(std::tls::signature_rsa_pss_rsae_sha256()) != 0 {
        return std::tls::signature_rsa_pss_rsae_sha256();
    }
    if schemes & std::tls::scheme_bit(std::tls::signature_rsa_pss_rsae_sha384()) != 0 {
        return std::tls::signature_rsa_pss_rsae_sha384();
    }
    if schemes & std::tls::scheme_bit(std::tls::signature_rsa_pss_rsae_sha512()) != 0 {
        return std::tls::signature_rsa_pss_rsae_sha512();
    }
    return null;
}

// send_server_hello writes and sends the ServerHello for what was
// chosen, with `drawn`'s first 32 bytes as the random and the x25519
// share of its last 32, then the change_cipher_spec of §D.4.
fn (self: &var std::tls::Connection) send_server_hello(
    io: Io,
    allocator: Allocator,
    client_hello: []u8,
    offered: &std::tls::ClientHello,
    drawn: []u8
) -> std::tls::Failure!void {
    var share_buffer = [32]u8{};
    let share = share_buffer.as_mut_bytes();
    std::crypto::x25519_base(drawn[32..64], share);
    let share_bytes = share_buffer.as_bytes();
    var hello = std::string::new(allocator);
    defer hello.deinit(allocator);
    let session_id = client_hello[offered.session_id_start..offered.session_id_end];
    try std::tls::write_server_hello(allocator, &var hello, drawn[0..32], session_id, self.suite, share_bytes);
    let hello_bytes = hello.as_bytes();
    try self.transcript.append_bytes(allocator, hello_bytes);
    try self.send_plain(io, allocator, std::tls::content_handshake(), hello_bytes);
    var spec = [1]u8{};
    let spec_view = spec.as_mut_bytes();
    spec_view[0] = 1;
    let spec_bytes = spec.as_bytes();
    try self.send_plain(io, allocator, content_change_cipher_spec(), spec_bytes);
    return;
}

// install_handshake_keys computes the shared secret and turns on the
// handshake keys: the server writes under "s hs traffic" and reads
// under "c hs traffic".
fn (self: &var std::tls::Connection) install_handshake_keys(
    allocator: Allocator,
    private_key: []u8,
    peer_share: []u8
) -> std::tls::Failure!void {
    var shared_buffer = [32]u8{};
    let shared = shared_buffer.as_mut_bytes();
    // A share of low order would be the client's doing; the handshake
    // is already past the point of answering it with an alert in the
    // clear, so the failure is reported as it is.
    try std::crypto::x25519(private_key, peer_share, shared);
    let shared_bytes = shared_buffer.as_bytes();
    var early_buffer = [32]u8{};
    let early = early_buffer.as_mut_bytes();
    std::tls::early_secret(early);
    let early_bytes = early_buffer.as_bytes();
    var handshake_buffer = [32]u8{};
    let handshake_secret = handshake_buffer.as_mut_bytes();
    std::tls::handshake_secret(early_bytes, shared_bytes, handshake_secret);
    let handshake_bytes = handshake_buffer.as_bytes();
    self.handshake_secret.clear();
    try self.handshake_secret.append_bytes(allocator, handshake_bytes);
    var hash_buffer = [32]u8{};
    let hash = hash_buffer.as_mut_bytes();
    self.hash_transcript(hash);
    let hash_bytes = hash_buffer.as_bytes();
    try self.install_write_secret(allocator, handshake_bytes, "s hs traffic", hash_bytes);
    try self.install_read_secret(allocator, handshake_bytes, "c hs traffic", hash_bytes);
    return;
}

// send_certificate_verify signs the transcript so far with the key
// under `scheme` and sends the CertificateVerify.
fn (self: &var std::tls::Connection) send_certificate_verify(
    io: Io,
    allocator: Allocator,
    key: &std::crypto::x509::PrivateKey,
    scheme: i64
) -> std::tls::Failure!void {
    let kind = scheme_hash(scheme);
    var digest_buffer = [64]u8{};
    let digest = digest_buffer.as_mut_bytes();
    try self.certificate_verify_digest(allocator, kind, digest);
    let digest_bytes = digest[0..std::crypto::digest_length(kind)];
    let salt = try std::crypto::random_bytes(io, allocator, std::crypto::digest_length(kind));
    defer salt.deinit(allocator);
    let salt_bytes = salt.as_bytes();
    let signature = try std::crypto::x509::sign(allocator, key, kind, digest_bytes, salt_bytes);
    defer signature.deinit(allocator);
    let signature_bytes = signature.as_bytes();
    var verify = std::string::new(allocator);
    defer verify.deinit(allocator);
    try std::tls::write_certificate_verify(allocator, &var verify, scheme, signature_bytes);
    let verify_bytes = verify.as_bytes();
    try self.transcript.append_bytes(allocator, verify_bytes);
    try self.send(io, allocator, std::tls::content_handshake(), verify_bytes);
    return;
}

// send_finished sends the server's Finished and turns on its
// application write keys; the client's read keys wait for its Finished.
fn (self: &var std::tls::Connection) send_finished(io: Io, allocator: Allocator) -> std::tls::Failure!void {
    var own_buffer = [32]u8{};
    let own = own_buffer.as_mut_bytes();
    self.own_finished(own);
    let own_bytes = own_buffer.as_bytes();
    var finished = std::string::new(allocator);
    defer finished.deinit(allocator);
    try std::tls::write_finished(allocator, &var finished, own_bytes);
    let finished_bytes = finished.as_bytes();
    try self.transcript.append_bytes(allocator, finished_bytes);
    try self.send(io, allocator, std::tls::content_handshake(), finished_bytes);
    return;
}

// take_client_finished takes the client's Finished, checks it against
// the transcript through the server's own, and turns on the
// application keys in both directions.
fn (self: &var std::tls::Connection) take_client_finished(
    io: Io,
    allocator: Allocator,
    message_bytes: []u8
) -> std::tls::Failure!void {
    var server_secret_buffer = [32]u8{};
    var client_secret_buffer = [32]u8{};
    let server_secret = server_secret_buffer.as_mut_bytes();
    let client_secret = client_secret_buffer.as_mut_bytes();
    self.derive_application_secrets(server_secret, client_secret);
    if message_bytes[0] != std::tls::handshake_finished() {
        try self.fail(io, allocator, alert_unexpected_message());
        return std::tls::Error::UnexpectedMessage;
    }
    try self.check_finished_shape(io, allocator, message_bytes);
    let matches = self.finished_matches(message_bytes[4..36]);
    if !matches {
        try self.fail(io, allocator, alert_decrypt_error());
        return std::tls::Error::BadSignature;
    }
    try self.advance_server_with(io, allocator, std::tls::ServerEvent::Finished);
    let server_secret_bytes = server_secret_buffer.as_bytes();
    let client_secret_bytes = client_secret_buffer.as_bytes();
    try self.set_write_secret(allocator, server_secret_bytes);
    try self.set_read_secret(allocator, client_secret_bytes);
    return;
}
