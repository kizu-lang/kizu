// The handshake messages each side writes and reads (RFC 8446 §4): a
// ClientHello built from what the client offers and read by the server
// for what it can take, the server's messages built from what it chose
// and read by the client. A message is its four-byte header -- the type
// and a 24-bit length -- and its body; what is read is left in the
// message's bytes and named by offsets, the way std::crypto::x509
// leaves a certificate in its DER.

// Handshake message types (RFC 8446 §4).
pub fn handshake_client_hello() -> u8 {
    return 1;
}

pub fn handshake_server_hello() -> u8 {
    return 2;
}

pub fn handshake_new_session_ticket() -> u8 {
    return 4;
}

pub fn handshake_encrypted_extensions() -> u8 {
    return 8;
}

pub fn handshake_certificate() -> u8 {
    return 11;
}

pub fn handshake_certificate_request() -> u8 {
    return 13;
}

pub fn handshake_certificate_verify() -> u8 {
    return 15;
}

pub fn handshake_finished() -> u8 {
    return 20;
}

pub fn handshake_key_update() -> u8 {
    return 24;
}

// Cipher suite and group codes on the wire.
fn suite_code(suite: std::tls::CipherSuite) -> i64 {
    if suite == std::tls::CipherSuite::Aes128GcmSha256 {
        return 0x1301;
    }
    return 0x1303;
}

fn group_x25519() -> i64 {
    return 0x001d;
}

// The SignatureSchemes this client can verify (RFC 8446 §4.2.3): ECDSA
// on P-256 over SHA-256 and on P-384 over SHA-384, and RSA-PSS over
// each of three hashes, for a CertificateVerify; and RSA PKCS #1 v1.5
// over the same three, which TLS 1.3 allows only on a certificate.
pub fn signature_ecdsa_secp256r1_sha256() -> i64 {
    return 0x0403;
}

pub fn signature_ecdsa_secp384r1_sha384() -> i64 {
    return 0x0503;
}

pub fn signature_rsa_pss_rsae_sha256() -> i64 {
    return 0x0804;
}

pub fn signature_rsa_pss_rsae_sha384() -> i64 {
    return 0x0805;
}

pub fn signature_rsa_pss_rsae_sha512() -> i64 {
    return 0x0806;
}

pub fn signature_rsa_pkcs1_sha256() -> i64 {
    return 0x0401;
}

pub fn signature_rsa_pkcs1_sha384() -> i64 {
    return 0x0501;
}

pub fn signature_rsa_pkcs1_sha512() -> i64 {
    return 0x0601;
}

// write_client_hello appends a ClientHello handshake message: TLS 1.3
// only, the two suites std::tls has, x25519 with the given share, the
// signature schemes this client verifies, and the host as the server
// name. `random` and `session_id` are 32 bytes each; the
// session id is echoed by the server and is what makes middleboxes take
// the handshake for TLS 1.2 (§D.4).
pub fn write_client_hello(
    allocator: Allocator,
    out: &var std::string::String,
    random: []u8,
    session_id: []u8,
    host: []u8,
    key_share: []u8
) -> std::mem::Error!void {
    let start = out.len();
    try append_u8(allocator, out, handshake_client_hello());
    try append_u24(allocator, out, 0);
    try append_u16(allocator, out, 0x0303);
    try out.append_bytes(allocator, random);
    try append_u8(allocator, out, 32);
    try out.append_bytes(allocator, session_id);
    try append_u16(allocator, out, 4);
    try append_u16(allocator, out, suite_code(std::tls::CipherSuite::Aes128GcmSha256));
    try append_u16(allocator, out, suite_code(std::tls::CipherSuite::Chacha20Poly1305Sha256));
    try append_u8(allocator, out, 1);
    try append_u8(allocator, out, 0);
    let extensions_at = out.len();
    try append_u16(allocator, out, 0);
    // server_name: one host_name entry.
    let host_length = std::mem::len(host);
    try append_u16(allocator, out, 0);
    try append_u16(allocator, out, host_length + 5);
    try append_u16(allocator, out, host_length + 3);
    try append_u8(allocator, out, 0);
    try append_u16(allocator, out, host_length);
    try out.append_bytes(allocator, host);
    // supported_groups: x25519.
    try append_u16(allocator, out, 10);
    try append_u16(allocator, out, 4);
    try append_u16(allocator, out, 2);
    try append_u16(allocator, out, group_x25519());
    // signature_algorithms: what `Client` can verify, preferred first.
    try append_u16(allocator, out, 13);
    try append_u16(allocator, out, 18);
    try append_u16(allocator, out, 16);
    try append_u16(allocator, out, signature_ecdsa_secp256r1_sha256());
    try append_u16(allocator, out, signature_ecdsa_secp384r1_sha384());
    try append_u16(allocator, out, signature_rsa_pss_rsae_sha256());
    try append_u16(allocator, out, signature_rsa_pss_rsae_sha384());
    try append_u16(allocator, out, signature_rsa_pss_rsae_sha512());
    try append_u16(allocator, out, signature_rsa_pkcs1_sha256());
    try append_u16(allocator, out, signature_rsa_pkcs1_sha384());
    try append_u16(allocator, out, signature_rsa_pkcs1_sha512());
    // supported_versions: 1.3.
    try append_u16(allocator, out, 43);
    try append_u16(allocator, out, 3);
    try append_u8(allocator, out, 2);
    try append_u16(allocator, out, 0x0304);
    // key_share: the x25519 share.
    try append_u16(allocator, out, 51);
    try append_u16(allocator, out, 38);
    try append_u16(allocator, out, 36);
    try append_u16(allocator, out, group_x25519());
    try append_u16(allocator, out, 32);
    try out.append_bytes(allocator, key_share);
    let end = out.len();
    set_u16(out, extensions_at, end - extensions_at - 2);
    set_u24(out, start + 1, end - start - 4);
    return;
}

// write_finished appends a Finished handshake message with `verify_data`.
pub fn write_finished(
    allocator: Allocator,
    out: &var std::string::String,
    verify_data: []u8
) -> std::mem::Error!void {
    try append_u8(allocator, out, handshake_finished());
    try append_u24(allocator, out, std::mem::len(verify_data));
    try out.append_bytes(allocator, verify_data);
    return;
}

// write_empty_certificate appends the Certificate a client without a
// certificate answers a CertificateRequest with: an empty context and
// an empty list.
pub fn write_empty_certificate(allocator: Allocator, out: &var std::string::String) -> std::mem::Error!void {
    try append_u8(allocator, out, handshake_certificate());
    try append_u24(allocator, out, 4);
    try append_u8(allocator, out, 0);
    try append_u24(allocator, out, 0);
    return;
}

// write_key_update appends a KeyUpdate that asks for none in return.
pub fn write_key_update(allocator: Allocator, out: &var std::string::String) -> std::mem::Error!void {
    try append_u8(allocator, out, handshake_key_update());
    try append_u24(allocator, out, 1);
    try append_u8(allocator, out, 0);
    return;
}

// message_length is the whole length of the handshake message at the
// front of `bytes`, header and body, or null when the bytes do not yet
// hold the whole message.
pub fn message_length(bytes: []u8) -> ?i64 {
    if std::mem::len(bytes) < 4 {
        return null;
    }
    let body = read_u24(bytes, 1);
    if std::mem::len(bytes) < 4 + body {
        return null;
    }
    return 4 + body;
}

// A ServerHello, read: the suite the server chose, where its x25519
// share is in the message, and whether it is a HelloRetryRequest.
pub struct ServerHello {
    pub suite: std::tls::CipherSuite,
    pub key_share_start: i64,
    pub key_share_end: i64,
    pub retry: bool,
}

// read_server_hello reads a ServerHello (RFC 8446 §4.1.3). The session
// id must echo the client's (`session_id`, of whatever length it sent),
// the suite and group must be ones the client offered, and
// supported_versions must say 1.3. A message that does not fit is
// `Error::IllegalParameter`.
pub fn read_server_hello(message: []u8, session_id: []u8) -> std::tls::Error!std::tls::ServerHello {
    let length = std::mem::len(message);
    if length < 4 + 2 + 32 + 1 or message[0] != handshake_server_hello() or read_u24(message, 1) != length - 4 {
        return std::tls::Error::IllegalParameter;
    }
    if read_u16(message, 4) != 0x0303 {
        return std::tls::Error::IllegalParameter;
    }
    let random = message[6..38];
    let retry = is_hex(random, hello_retry_request_random());
    var at = 38;
    let id_length = cast<i64>(message[at]);
    at = at + 1;
    if id_length != std::mem::len(session_id) or at + id_length + 3 > length {
        return std::tls::Error::IllegalParameter;
    }
    let echoed = message[at..at + id_length];
    if !std::mem::equal_bytes(echoed, session_id) {
        return std::tls::Error::IllegalParameter;
    }
    at = at + id_length;
    let suite_code = read_u16(message, at);
    var suite = std::tls::CipherSuite::Aes128GcmSha256;
    if suite_code == 0x1303 {
        suite = std::tls::CipherSuite::Chacha20Poly1305Sha256;
    } else {
        if suite_code != 0x1301 {
            return std::tls::Error::IllegalParameter;
        }
    }
    at = at + 2;
    if message[at] != 0 {
        return std::tls::Error::IllegalParameter;
    }
    at = at + 1;
    if at + 2 > length {
        return std::tls::Error::IllegalParameter;
    }
    let extensions_length = read_u16(message, at);
    at = at + 2;
    if at + extensions_length != length {
        return std::tls::Error::IllegalParameter;
    }
    var version_seen = false;
    var share_start = 0;
    var share_end = 0;
    while at < length {
        if at + 4 > length {
            return std::tls::Error::IllegalParameter;
        }
        let kind = read_u16(message, at);
        let size = read_u16(message, at + 2);
        let body = at + 4;
        if body + size > length {
            return std::tls::Error::IllegalParameter;
        }
        if kind == 43 {
            if size != 2 or read_u16(message, body) != 0x0304 {
                return std::tls::Error::IllegalParameter;
            }
            version_seen = true;
        }
        if kind == 51 {
            if retry {
                return std::tls::Error::Unsupported;
            }
            if size != 36 or read_u16(message, body) != group_x25519() or read_u16(message, body + 2) != 32 {
                return std::tls::Error::IllegalParameter;
            }
            share_start = body + 4;
            share_end = body + 36;
        }
        at = body + size;
    }
    if !version_seen or (!retry and share_end == 0) {
        return std::tls::Error::IllegalParameter;
    }
    return ServerHello { suite: suite, key_share_start: share_start, key_share_end: share_end, retry: retry };
}

// hello_retry_request_random is the ServerHello.random that makes the
// message a HelloRetryRequest (RFC 8446 §4.1.3), as hex.
fn hello_retry_request_random() -> []u8 {
    return "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c";
}

// is_hex reports whether `bytes` are what a lowercase hex text spells.
fn is_hex(bytes: []u8, hex: []u8) -> bool {
    let count = std::mem::len(hex) / 2;
    if std::mem::len(bytes) != count {
        return false;
    }
    for 0..count |index| {
        let high = hex_value(hex[index * 2]);
        let low = hex_value(hex[index * 2 + 1]);
        if cast<i64>(bytes[index]) != high * 16 + low {
            return false;
        }
    }
    return true;
}

fn hex_value(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return value - 87;
    }
    return value - 48;
}

// read_certificate reads a Certificate (RFC 8446 §4.4.2) and appends
// each certificate's DER to `chain`, the server's first. The request
// context must be empty, since the client asked for nothing.
pub fn read_certificate(
    allocator: Allocator,
    message: []u8,
    chain: &var std::array::Array<std::string::String>
) -> std::tls::Failure!void {
    let length = std::mem::len(message);
    if length < 8 or message[0] != handshake_certificate() or read_u24(message, 1) != length - 4 {
        return std::tls::Error::IllegalParameter;
    }
    if message[4] != 0 {
        return std::tls::Error::IllegalParameter;
    }
    let list_length = read_u24(message, 5);
    var at = 8;
    if at + list_length != length {
        return std::tls::Error::IllegalParameter;
    }
    while at < length {
        if at + 3 > length {
            return std::tls::Error::IllegalParameter;
        }
        let der_length = read_u24(message, at);
        at = at + 3;
        if at + der_length + 2 > length {
            return std::tls::Error::IllegalParameter;
        }
        let der = message[at..at + der_length];
        var copy = std::string::new(allocator);
        errdefer copy.deinit(allocator);
        try copy.append_bytes(allocator, der);
        try chain.append(allocator, move copy);
        at = at + der_length;
        let extensions_length = read_u16(message, at);
        at = at + 2 + extensions_length;
        if at > length {
            return std::tls::Error::IllegalParameter;
        }
    }
    return;
}

// A CertificateVerify, read: the signature scheme and where the
// signature is.
pub struct CertificateVerify {
    pub scheme: i64,
    pub signature_start: i64,
    pub signature_end: i64,
}

// read_certificate_verify reads a CertificateVerify (RFC 8446 §4.4.3).
pub fn read_certificate_verify(message: []u8) -> std::tls::Error!std::tls::CertificateVerify {
    let length = std::mem::len(message);
    if length < 8 or message[0] != handshake_certificate_verify() or read_u24(message, 1) != length - 4 {
        return std::tls::Error::IllegalParameter;
    }
    let scheme = read_u16(message, 4);
    let signature_length = read_u16(message, 6);
    if 8 + signature_length != length {
        return std::tls::Error::IllegalParameter;
    }
    return CertificateVerify { scheme: scheme, signature_start: 8, signature_end: length };
}

// A ClientHello, read by a server: what the client offered that this
// server can take. `session_id` is echoed; `key_share` is the x25519
// share, or empty when none was offered; `schemes` is the signature
// schemes the client accepts, as a bit per scheme `scheme_bit` names;
// `server_name` is the host the client asked for, or empty.
pub struct ClientHello {
    pub session_id_start: i64,
    pub session_id_end: i64,
    pub aes: bool,
    pub chacha: bool,
    pub key_share_start: i64,
    pub key_share_end: i64,
    pub schemes: i64,
    pub server_name_start: i64,
    pub server_name_end: i64,
}

// scheme_bit is the bit of `ClientHello.schemes` for a signature scheme
// a server can sign with, or 0 for one it cannot.
pub fn scheme_bit(scheme: i64) -> i64 {
    if scheme == signature_ecdsa_secp256r1_sha256() {
        return 1;
    }
    if scheme == signature_ecdsa_secp384r1_sha384() {
        return 2;
    }
    if scheme == signature_rsa_pss_rsae_sha256() {
        return 4;
    }
    if scheme == signature_rsa_pss_rsae_sha384() {
        return 8;
    }
    if scheme == signature_rsa_pss_rsae_sha512() {
        return 16;
    }
    return 0;
}

// read_client_hello reads a ClientHello (RFC 8446 §4.1.2). A message
// that does not fit the shape is `IllegalParameter`; one that offers
// no TLS 1.3, no suite this server has, no x25519 share, or no scheme
// the server signs with is read all the same, and the server decides
// from what it holds.
pub fn read_client_hello(message: []u8) -> std::tls::Error!std::tls::ClientHello {
    let length = std::mem::len(message);
    if length < 4 + 2 + 32 + 1 or message[0] != handshake_client_hello() or read_u24(message, 1) != length - 4 {
        return std::tls::Error::IllegalParameter;
    }
    if read_u16(message, 4) != 0x0303 {
        return std::tls::Error::IllegalParameter;
    }
    var at = 38;
    let id_length = cast<i64>(message[at]);
    at = at + 1;
    if id_length > 32 or at + id_length + 2 > length {
        return std::tls::Error::IllegalParameter;
    }
    var hello = ClientHello {
        session_id_start: at,
        session_id_end: at + id_length,
        aes: false,
        chacha: false,
        key_share_start: 0,
        key_share_end: 0,
        schemes: 0,
        server_name_start: 0,
        server_name_end: 0,
    };
    at = at + id_length;
    let suites_length = read_u16(message, at);
    at = at + 2;
    if suites_length & 1 == 1 or at + suites_length + 1 > length {
        return std::tls::Error::IllegalParameter;
    }
    for 0..suites_length / 2 |index| {
        let code = read_u16(message, at + index * 2);
        if code == 0x1301 {
            hello.aes = true;
        }
        if code == 0x1303 {
            hello.chacha = true;
        }
    }
    at = at + suites_length;
    // Compression methods: at least null.
    let compressions = cast<i64>(message[at]);
    at = at + 1;
    if compressions == 0 or at + compressions > length {
        return std::tls::Error::IllegalParameter;
    }
    at = at + compressions;
    if at + 2 > length {
        return std::tls::Error::IllegalParameter;
    }
    let extensions_length = read_u16(message, at);
    at = at + 2;
    if at + extensions_length != length {
        return std::tls::Error::IllegalParameter;
    }
    var version_seen = false;
    while at < length {
        if at + 4 > length {
            return std::tls::Error::IllegalParameter;
        }
        let kind = read_u16(message, at);
        let size = read_u16(message, at + 2);
        let body = at + 4;
        if body + size > length {
            return std::tls::Error::IllegalParameter;
        }
        if kind == 0 {
            try read_server_name(message, body, body + size, &var hello);
        }
        if kind == 13 {
            hello.schemes = try read_schemes(message, body, body + size);
        }
        if kind == 43 {
            version_seen = try read_versions(message, body, body + size);
        }
        if kind == 51 {
            try read_key_shares(message, body, body + size, &var hello);
        }
        at = body + size;
    }
    if !version_seen {
        return std::tls::Error::Unsupported;
    }
    return hello;
}

// read_server_name notes the host_name entry of a server_name extension
// (RFC 6066 §3).
fn read_server_name(message: []u8, start: i64, end: i64, hello: &var std::tls::ClientHello) -> std::tls::Error!void {
    if end - start < 2 or start + 2 + read_u16(message, start) != end {
        return std::tls::Error::IllegalParameter;
    }
    var at = start + 2;
    while at < end {
        if at + 3 > end {
            return std::tls::Error::IllegalParameter;
        }
        let kind = message[at];
        let size = read_u16(message, at + 1);
        at = at + 3;
        if at + size > end {
            return std::tls::Error::IllegalParameter;
        }
        if kind == 0 {
            hello.server_name_start = at;
            hello.server_name_end = at + size;
        }
        at = at + size;
    }
    return;
}

// read_schemes folds a signature_algorithms extension into scheme bits.
fn read_schemes(message: []u8, start: i64, end: i64) -> std::tls::Error!i64 {
    if end - start < 2 or start + 2 + read_u16(message, start) != end or (end - start) & 1 == 1 {
        return std::tls::Error::IllegalParameter;
    }
    var bits = 0;
    var at = start + 2;
    while at < end {
        bits = bits | scheme_bit(read_u16(message, at));
        at = at + 2;
    }
    return bits;
}

// read_versions reports whether a supported_versions extension offers
// TLS 1.3.
fn read_versions(message: []u8, start: i64, end: i64) -> std::tls::Error!bool {
    if end - start < 1 or start + 1 + cast<i64>(message[start]) != end or (end - start - 1) & 1 == 1 {
        return std::tls::Error::IllegalParameter;
    }
    var at = start + 1;
    while at < end {
        if read_u16(message, at) == 0x0304 {
            return true;
        }
        at = at + 2;
    }
    return false;
}

// read_key_shares notes the x25519 entry of a key_share extension.
fn read_key_shares(message: []u8, start: i64, end: i64, hello: &var std::tls::ClientHello) -> std::tls::Error!void {
    if end - start < 2 or start + 2 + read_u16(message, start) != end {
        return std::tls::Error::IllegalParameter;
    }
    var at = start + 2;
    while at < end {
        if at + 4 > end {
            return std::tls::Error::IllegalParameter;
        }
        let group = read_u16(message, at);
        let size = read_u16(message, at + 2);
        at = at + 4;
        if at + size > end {
            return std::tls::Error::IllegalParameter;
        }
        if group == group_x25519() {
            if size != 32 {
                return std::tls::Error::IllegalParameter;
            }
            hello.key_share_start = at;
            hello.key_share_end = at + 32;
        }
        at = at + size;
    }
    return;
}

// write_server_hello appends a ServerHello (RFC 8446 §4.1.3): the
// client's session id echoed, the suite chosen, and supported_versions
// and key_share with the server's x25519 share.
pub fn write_server_hello(
    allocator: Allocator,
    out: &var std::string::String,
    random: []u8,
    session_id: []u8,
    suite: std::tls::CipherSuite,
    key_share: []u8
) -> std::mem::Error!void {
    let start = out.len();
    try append_u8(allocator, out, handshake_server_hello());
    try append_u24(allocator, out, 0);
    try append_u16(allocator, out, 0x0303);
    try out.append_bytes(allocator, random);
    try append_u8(allocator, out, cast<u8>(std::mem::len(session_id)));
    try out.append_bytes(allocator, session_id);
    try append_u16(allocator, out, suite_code(suite));
    try append_u8(allocator, out, 0);
    try append_u16(allocator, out, 46);
    // key_share: the x25519 share.
    try append_u16(allocator, out, 51);
    try append_u16(allocator, out, 36);
    try append_u16(allocator, out, group_x25519());
    try append_u16(allocator, out, 32);
    try out.append_bytes(allocator, key_share);
    // supported_versions: 1.3.
    try append_u16(allocator, out, 43);
    try append_u16(allocator, out, 2);
    try append_u16(allocator, out, 0x0304);
    let end = out.len();
    set_u24(out, start + 1, end - start - 4);
    return;
}

// write_encrypted_extensions appends an EncryptedExtensions with no
// extensions: this server negotiates nothing after the hello.
pub fn write_encrypted_extensions(allocator: Allocator, out: &var std::string::String) -> std::mem::Error!void {
    try append_u8(allocator, out, handshake_encrypted_extensions());
    try append_u24(allocator, out, 2);
    try append_u16(allocator, out, 0);
    return;
}

// write_certificate appends a Certificate (RFC 8446 §4.4.2) carrying
// `chain`, the server's own first, each with no extensions, under an
// empty request context.
pub fn write_certificate(
    allocator: Allocator,
    out: &var std::string::String,
    chain: &std::array::Array<std::string::String>
) -> std::mem::Error!void {
    let start = out.len();
    try append_u8(allocator, out, handshake_certificate());
    try append_u24(allocator, out, 0);
    try append_u8(allocator, out, 0);
    let list_at = out.len();
    try append_u24(allocator, out, 0);
    var index = 0;
    while chain.at(index) |der| {
        let bytes = der.as_bytes();
        try append_u24(allocator, out, std::mem::len(bytes));
        try out.append_bytes(allocator, bytes);
        try append_u16(allocator, out, 0);
        index = index + 1;
    }
    let end = out.len();
    set_u24(out, list_at, end - list_at - 3);
    set_u24(out, start + 1, end - start - 4);
    return;
}

// write_certificate_verify appends a CertificateVerify (RFC 8446 §4.4.3)
// with `signature` under `scheme`.
pub fn write_certificate_verify(
    allocator: Allocator,
    out: &var std::string::String,
    scheme: i64,
    signature: []u8
) -> std::mem::Error!void {
    let length = std::mem::len(signature);
    try append_u8(allocator, out, handshake_certificate_verify());
    try append_u24(allocator, out, 4 + length);
    try append_u16(allocator, out, scheme);
    try append_u16(allocator, out, length);
    try out.append_bytes(allocator, signature);
    return;
}

// read_finished checks a Finished message's shape and returns its 32
// bytes of verify_data.
pub fn read_finished(message: []u8) -> std::tls::Error![]u8 {
    let length = std::mem::len(message);
    if length != 36 or message[0] != handshake_finished() or read_u24(message, 1) != 32 {
        return std::tls::Error::IllegalParameter;
    }
    return message[4..36];
}

// read_key_update reads a KeyUpdate and reports whether the peer asked
// for one in return.
pub fn read_key_update(message: []u8) -> std::tls::Error!bool {
    let length = std::mem::len(message);
    if length != 5 or message[0] != handshake_key_update() or read_u24(message, 1) != 1 or message[4] > 1 {
        return std::tls::Error::IllegalParameter;
    }
    return message[4] == 1;
}

fn read_u16(bytes: []u8, at: i64) -> i64 {
    return (cast<i64>(bytes[at]) << 8) | cast<i64>(bytes[at + 1]);
}

fn read_u24(bytes: []u8, at: i64) -> i64 {
    return (cast<i64>(bytes[at]) << 16) | (cast<i64>(bytes[at + 1]) << 8) | cast<i64>(bytes[at + 2]);
}

fn append_u8(allocator: Allocator, out: &var std::string::String, value: u8) -> std::mem::Error!void {
    try out.append_byte(allocator, value);
    return;
}

fn append_u16(allocator: Allocator, out: &var std::string::String, value: i64) -> std::mem::Error!void {
    try out.append_byte(allocator, cast<u8>((value >> 8) & 255));
    try out.append_byte(allocator, cast<u8>(value & 255));
    return;
}

fn append_u24(allocator: Allocator, out: &var std::string::String, value: i64) -> std::mem::Error!void {
    try out.append_byte(allocator, cast<u8>((value >> 16) & 255));
    try out.append_byte(allocator, cast<u8>((value >> 8) & 255));
    try out.append_byte(allocator, cast<u8>(value & 255));
    return;
}

fn set_u16(out: &var std::string::String, at: i64, value: i64) -> void {
    let bytes = out.as_mut_bytes();
    bytes[at] = cast<u8>((value >> 8) & 255);
    bytes[at + 1] = cast<u8>(value & 255);
    return;
}

fn set_u24(out: &var std::string::String, at: i64, value: i64) -> void {
    let bytes = out.as_mut_bytes();
    bytes[at] = cast<u8>((value >> 16) & 255);
    bytes[at + 1] = cast<u8>((value >> 8) & 255);
    bytes[at + 2] = cast<u8>(value & 255);
    return;
}
