// std::tls is a TLS 1.3 client (RFC 8446): the handshake as a machine
// whose table spec/Tls.lean holds and proves things about, the key
// schedule that turns the key exchange and the transcript into keys,
// and the record layer that seals and opens records under them. The
// arithmetic is std::crypto's; nothing here links C or reads a clock.

// Error is what the record layer and the handshake can fail with.
// `BadRecord` is a record that is not TLS 1.3's or whose tag does not
// verify: the peer, or someone between, sent bytes this connection
// cannot take, and the connection is done.
pub error Error {
    BadRecord,
    IllegalParameter,
    Unsupported,
    UnexpectedMessage,
    BadSignature,
    Alert,
    Closed,
}

// Failure is what a connection can fail with: the record, what
// std::crypto's sealing can fail with, the certificate, or the socket.
pub error Failure = Error or std::crypto::Failure or std::crypto::x509::Error or std::net::Error;
