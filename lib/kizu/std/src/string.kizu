pub error Error {
    InvalidLength,
}

pub struct String {
    bytes: std::array::Array<u8>,
}

pub fn new(allocator: Allocator) -> std::string::String {
    return String {
        bytes: std::array::new<u8>(allocator)
    };
}

fn (self: String) append_bytes(bytes: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(bytes);
    while index < length {
        try self.bytes.append(bytes[index]);
        index = index + 1;
    }
    return;
}

fn (self: String) append_byte(byte: u8) -> !void {
    try self.bytes.append(byte);
    return;
}

fn (self: String) reserve(additional: i64) -> !void {
    if additional < 0 {
        return std::string::Error::InvalidLength;
    }
    try self.bytes.reserve(additional);
    return;
}

fn (self: String) len() -> i64 {
    return self.bytes.len();
}

fn (self: String) capacity() -> i64 {
    return self.bytes.capacity();
}

fn (self: String) as_bytes() -> []u8 borrows self {
    return self.bytes.as_bytes();
}

fn (self: String) clear() -> void {
    self.bytes.clear();
}

fn (self: String) truncate(length: i64) -> !void {
    if length < 0 or length > self.len() {
        return std::string::Error::InvalidLength;
    }
    try self.bytes.truncate(length);
    return;
}

fn (self: String) deinit() -> void {
    self.bytes.deinit();
}
