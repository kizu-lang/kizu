import std::array;
import std::mem;
import std::string;

// strings sorts owned strings in ascending byte-lexical order. The work is an
// introsort: quicksort down to short ranges, insertion sort for those, and
// heapsort for a range the partitions have failed to halve often enough.
// Quicksort is what makes the comparisons cheap -- it walks each range in one
// direction, where heapsort jumps by halves and reads a cold string every time
// -- and the other two are what keep the worst case O(n log n) without
// allocating: a run of one repeated key is gathered in one pass, and the depth
// limit answers an input chosen to defeat the pivot.
pub fn strings(values: &var array::Array<string::String>) -> std::array::Error!void {
    let length = values.len();
    if length < 2 {
        return;
    }
    return quicksort(values, 0, length, depth_limit(length));
}

fn short() -> i64 {
    return 16;
}

fn depth_limit(length: i64) -> i64 {
    var levels = 0;
    var rest = length;
    while rest > 1 {
        rest = rest / 2;
        levels = levels + 1;
    }
    return levels * 2;
}

fn quicksort(
    values: &var array::Array<string::String>,
    start: i64,
    end: i64,
    depth: i64
) -> std::array::Error!void {
    var low = start;
    var high = end;
    var left = depth;
    while high - low > short() {
        if left == 0 {
            return heapsort(values, low, high);
        }
        left = left - 1;
        try move_median_to_front(values, low, high);
        if low > 0 and compare_at(values, low - 1, low) == 0 {
            low = try partition(values, low, high, 1) + 1;
            continue;
        }
        let split = try partition(values, low, high, 0);
        if split - low < high - split {
            try quicksort(values, low, split, left);
            low = split + 1;
        } else {
            try quicksort(values, split + 1, high, left);
            high = split;
        }
    }
    return insertion_sort(values, low, high);
}

fn partition(
    values: &var array::Array<string::String>,
    low: i64,
    high: i64,
    limit: i64
) -> std::array::Error!i64 {
    var edge = low + 1;
    var index = low + 1;
    while index < high {
        let before = compare_at(values, index, low) < limit;
        try values.swap(index, edge);
        edge = edge + if before { 1 } else { 0 };
        index = index + 1;
    }
    try values.swap(low, edge - 1);
    return edge - 1;
}

fn move_median_to_front(
    values: &var array::Array<string::String>,
    low: i64,
    high: i64
) -> std::array::Error!void {
    let last = high - 1;
    let middle = low + (high - low) / 2;
    if less_at(values, middle, low) {
        try values.swap(middle, low);
    }
    if less_at(values, last, middle) {
        try values.swap(last, middle);
        if less_at(values, middle, low) {
            try values.swap(middle, low);
        }
    }
    return values.swap(low, middle);
}

fn insertion_sort(
    values: &var array::Array<string::String>,
    low: i64,
    high: i64
) -> std::array::Error!void {
    var index = low + 1;
    while index < high {
        var slot = index;
        while slot > low and less_at(values, slot, slot - 1) {
            try values.swap(slot, slot - 1);
            slot = slot - 1;
        }
        index = index + 1;
    }
    return;
}

fn heapsort(
    values: &var array::Array<string::String>,
    low: i64,
    high: i64
) -> std::array::Error!void {
    let length = high - low;
    var start = length / 2;
    while start > 0 {
        start = start - 1;
        try sift_down(values, low, start, length);
    }

    var end = length;
    while end > 1 {
        end = end - 1;
        try values.swap(low, low + end);
        try sift_down(values, low, 0, end);
    }
    return;
}

fn sift_down(
    values: &var array::Array<string::String>,
    low: i64,
    start: i64,
    end: i64
) -> std::array::Error!void {
    var root = start;
    while root < end / 2 {
        let child = root * 2 + 1;
        var larger = child;
        if child + 1 < end and less_at(values, low + child, low + child + 1) {
            larger = child + 1;
        }
        if !less_at(values, low + root, low + larger) {
            return;
        }
        try values.swap(low + root, low + larger);
        root = larger;
    }
    return;
}

fn less_at(
    values: &array::Array<string::String>,
    left: i64,
    right: i64
) -> bool {
    return compare_at(values, left, right) < 0;
}

fn compare_at(
    values: &array::Array<string::String>,
    left: i64,
    right: i64
) -> i64 {
    if values.at(left) |left_value| {
        if values.at(right) |right_value| {
            let left_bytes = left_value.as_bytes();
            let right_bytes = right_value.as_bytes();
            return mem::compare(left_bytes, right_bytes);
        }
    }
    std::internal::builtin::panic("sort strings: index out of bounds");
    return 0;
}
