import std::array;
import std::mem;
import std::string;

// strings sorts owned strings in ascending byte-lexical order. Heapsort keeps
// the operation in place and allocation-free while guaranteeing O(n log n).
pub fn strings(values: &var array::Array<string::String>) -> !void {
    let length = values.len();
    var start = length / 2;
    while start > 0 {
        start = start - 1;
        try sift_down(values, start, length);
    }

    var end = length;
    while end > 1 {
        end = end - 1;
        try values.swap(0, end);
        try sift_down(values, 0, end);
    }
    return;
}

fn sift_down(
    values: &var array::Array<string::String>,
    start: i64,
    end: i64
) -> !void {
    var root = start;
    while root < end / 2 {
        let child = root * 2 + 1;
        var larger = child;
        if child + 1 < end and less_at(values, child, child + 1) {
            larger = child + 1;
        }
        if !less_at(values, root, larger) {
            return;
        }
        try values.swap(root, larger);
        root = larger;
    }
    return;
}

fn less_at(
    values: &array::Array<string::String>,
    left: i64,
    right: i64
) -> bool {
    if values.at(left) |left_value| {
        if values.at(right) |right_value| {
            let left_bytes = left_value.as_bytes();
            let right_bytes = right_value.as_bytes();
            return bytes_less(left_bytes, right_bytes);
        }
    }
    std::internal::builtin::panic("sort strings: heap index out of bounds");
    return false;
}

fn bytes_less(left: []u8, right: []u8) -> bool {
    let common = if mem::len(left) < mem::len(right) {
        mem::len(left)
    } else {
        mem::len(right)
    };
    var index = 0;
    while index < common {
        if left[index] < right[index] {
            return true;
        }
        if left[index] > right[index] {
            return false;
        }
        index = index + 1;
    }
    return mem::len(left) < mem::len(right);
}
