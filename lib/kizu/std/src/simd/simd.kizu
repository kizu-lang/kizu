/// Broadcasts one f32 across all 4 lanes.
pub fn splat_f32x4(value: f32) -> f32x4 {
    return f32x4 { value, value, value, value };
}

/// Broadcasts one f64 across both lanes.
pub fn splat_f64x2(value: f64) -> f64x2 {
    return f64x2 { value, value };
}

/// Broadcasts one i32 across all 4 lanes.
pub fn splat_i32x4(value: i32) -> i32x4 {
    return i32x4 { value, value, value, value };
}

/// Broadcasts one u32 across all 4 lanes.
pub fn splat_u32x4(value: u32) -> u32x4 {
    return u32x4 { value, value, value, value };
}

/// Broadcasts one i8 across all 16 lanes.
pub fn splat_i8x16(value: i8) -> i8x16 {
    return i8x16 {
        value, value, value, value,
        value, value, value, value,
        value, value, value, value,
        value, value, value, value,
    };
}

/// Broadcasts one u8 across all 16 lanes.
pub fn splat_u8x16(value: u8) -> u8x16 {
    return u8x16 {
        value, value, value, value,
        value, value, value, value,
        value, value, value, value,
        value, value, value, value,
    };
}

/// Loads 4 contiguous f32 elements from `slice` starting at `offset`.
pub fn load_f32x4(slice: []f32, offset: i64) -> f32x4 {
    let n = std::mem::count<f32>(slice);
    if n < 4 or cast<u64>(offset) > cast<u64>(n - 4) {
        std::internal::builtin::panic("simd load_f32x4: index out of bounds");
    }
    return std::internal::builtin::simd_load_f32x4(slice, offset);
}

/// Stores 4 contiguous f32 elements into `slice` starting at `offset`.
pub fn store_f32x4(slice: &var []f32, offset: i64, value: f32x4) -> void {
    let n = std::mem::count<f32>(slice);
    if n < 4 or cast<u64>(offset) > cast<u64>(n - 4) {
        std::internal::builtin::panic("simd store_f32x4: index out of bounds");
    }
    std::internal::builtin::simd_store_f32x4(slice, offset, value);
    return;
}

/// Loads 2 contiguous f64 elements from `slice` starting at `offset`.
pub fn load_f64x2(slice: []f64, offset: i64) -> f64x2 {
    let n = std::mem::count<f64>(slice);
    if n < 2 or cast<u64>(offset) > cast<u64>(n - 2) {
        std::internal::builtin::panic("simd load_f64x2: index out of bounds");
    }
    return std::internal::builtin::simd_load_f64x2(slice, offset);
}

/// Stores 2 contiguous f64 elements into `slice` starting at `offset`.
pub fn store_f64x2(slice: &var []f64, offset: i64, value: f64x2) -> void {
    let n = std::mem::count<f64>(slice);
    if n < 2 or cast<u64>(offset) > cast<u64>(n - 2) {
        std::internal::builtin::panic("simd store_f64x2: index out of bounds");
    }
    std::internal::builtin::simd_store_f64x2(slice, offset, value);
    return;
}

/// Loads 4 contiguous i32 elements from `slice` starting at `offset`.
pub fn load_i32x4(slice: []i32, offset: i64) -> i32x4 {
    let n = std::mem::count<i32>(slice);
    if n < 4 or cast<u64>(offset) > cast<u64>(n - 4) {
        std::internal::builtin::panic("simd load_i32x4: index out of bounds");
    }
    return std::internal::builtin::simd_load_i32x4(slice, offset);
}

/// Stores 4 contiguous i32 elements into `slice` starting at `offset`.
pub fn store_i32x4(slice: &var []i32, offset: i64, value: i32x4) -> void {
    let n = std::mem::count<i32>(slice);
    if n < 4 or cast<u64>(offset) > cast<u64>(n - 4) {
        std::internal::builtin::panic("simd store_i32x4: index out of bounds");
    }
    std::internal::builtin::simd_store_i32x4(slice, offset, value);
    return;
}

/// Loads 16 contiguous u8 elements from `slice` starting at `offset`.
pub fn load_u8x16(slice: []u8, offset: i64) -> u8x16 {
    let n = std::mem::len(slice);
    if n < 16 or cast<u64>(offset) > cast<u64>(n - 16) {
        std::internal::builtin::panic("simd load_u8x16: index out of bounds");
    }
    return std::internal::builtin::simd_load_u8x16(slice, offset);
}

/// Stores 16 contiguous u8 elements into `slice` starting at `offset`.
pub fn store_u8x16(slice: &var []u8, offset: i64, value: u8x16) -> void {
    let n = std::mem::len(slice);
    if n < 16 or cast<u64>(offset) > cast<u64>(n - 16) {
        std::internal::builtin::panic("simd store_u8x16: index out of bounds");
    }
    std::internal::builtin::simd_store_u8x16(slice, offset, value);
    return;
}

/// Loads 16 contiguous i8 elements from `slice` starting at `offset`.
pub fn load_i8x16(slice: []i8, offset: i64) -> i8x16 {
    let n = std::mem::count<i8>(slice);
    if n < 16 or cast<u64>(offset) > cast<u64>(n - 16) {
        std::internal::builtin::panic("simd load_i8x16: index out of bounds");
    }
    return std::internal::builtin::simd_load_i8x16(slice, offset);
}

/// Stores 16 contiguous i8 elements into `slice` starting at `offset`.
pub fn store_i8x16(slice: &var []i8, offset: i64, value: i8x16) -> void {
    let n = std::mem::count<i8>(slice);
    if n < 16 or cast<u64>(offset) > cast<u64>(n - 16) {
        std::internal::builtin::panic("simd store_i8x16: index out of bounds");
    }
    std::internal::builtin::simd_store_i8x16(slice, offset, value);
    return;
}

/// Loads 16 contiguous bytes from `slice` starting at `offset`, reinterpreted
/// as signed `i8x16`.
pub fn load_i8x16_from_u8(slice: []u8, offset: i64) -> i8x16 {
    let n = std::mem::len(slice);
    if n < 16 or cast<u64>(offset) > cast<u64>(n - 16) {
        std::internal::builtin::panic("simd load_i8x16_from_u8: index out of bounds");
    }
    return std::internal::builtin::simd_load_i8x16_u8(slice, offset);
}

/// 16-entry parallel byte table lookup. For each lane `j`, returns
/// `table[indices[j]]` when `indices[j] < 16` and `0` otherwise.
pub fn tbl16(table: u8x16, indices: u8x16) -> u8x16 {
    return std::internal::builtin::simd_tbl16(table, indices);
}

/// Single-rounding fused multiply-add `a * b + c` on f32.
pub fn fma_f32(a: f32, b: f32, c: f32) -> f32 {
    return std::internal::builtin::simd_fma_f32(a, b, c);
}

/// Lane-wise single-rounding fused multiply-add `a * b + c` on f32x4.
pub fn fma_f32x4(a: f32x4, b: f32x4, c: f32x4) -> f32x4 {
    return std::internal::builtin::simd_fma_f32x4(a, b, c);
}

/// Lane-wise single-rounding fused multiply-add `a * b + c` on f64x2.
pub fn fma_f64x2(a: f64x2, b: f64x2, c: f64x2) -> f64x2 {
    return std::internal::builtin::simd_fma_f64x2(a, b, c);
}

/// Signed 8-bit 4-way dot product accumulate: for each lane `k` in `0..4`,
/// adds the dot product of `a[4k..4k+4]` and `b[4k..4k+4]` into `acc[k]`.
pub fn sdot_i8x16(acc: i32x4, a: i8x16, b: i8x16) -> i32x4 {
    return std::internal::builtin::simd_sdot_i8x16(acc, a, b);
}

/// Sign-extends lanes 0..3 of `v` from i8 to f32x4.
pub fn i8x16_to_f32x4_0(v: i8x16) -> f32x4 {
    return std::internal::builtin::simd_i8x16_to_f32x4_0(v);
}

/// Sign-extends lanes 4..7 of `v` from i8 to f32x4.
pub fn i8x16_to_f32x4_1(v: i8x16) -> f32x4 {
    return std::internal::builtin::simd_i8x16_to_f32x4_1(v);
}

/// Sign-extends lanes 8..11 of `v` from i8 to f32x4.
pub fn i8x16_to_f32x4_2(v: i8x16) -> f32x4 {
    return std::internal::builtin::simd_i8x16_to_f32x4_2(v);
}

/// Sign-extends lanes 12..15 of `v` from i8 to f32x4.
pub fn i8x16_to_f32x4_3(v: i8x16) -> f32x4 {
    return std::internal::builtin::simd_i8x16_to_f32x4_3(v);
}

/// Converts 4 signed i32 lanes to f32x4.
pub fn f32x4_from_i32x4(v: i32x4) -> f32x4 {
    return std::internal::builtin::simd_f32x4_from_i32x4(v);
}

/// Converts 4 f32 lanes to i32x4 with saturating truncation.
pub fn i32x4_from_f32x4(v: f32x4) -> i32x4 {
    return std::internal::builtin::simd_i32x4_from_f32x4(v);
}

/// Reinterprets `u8x16` lanes as signed `i8x16`.
pub fn i8x16_from_u8x16(v: u8x16) -> i8x16 {
    return std::internal::builtin::simd_i8x16_from_u8x16(v);
}

/// Reinterprets `i8x16` lanes as unsigned `u8x16`.
pub fn u8x16_from_i8x16(v: i8x16) -> u8x16 {
    return std::internal::builtin::simd_u8x16_from_i8x16(v);
}

/// Counts set bits in a u32.
pub fn popcount_u32(value: u32) -> u32 {
    return std::internal::builtin::simd_popcount_u32(value);
}

/// Counts set bits in a u64.
pub fn popcount_u64(value: u64) -> u64 {
    return std::internal::builtin::simd_popcount_u64(value);
}

/// Counts set bits in each byte lane of a u8x16.
pub fn popcount_u8x16(value: u8x16) -> u8x16 {
    return std::internal::builtin::simd_popcount_u8x16(value);
}

/// Deterministic horizontal sum `(v[0] + v[1]) + (v[2] + v[3])`.
pub fn reduce_add_f32x4(v: f32x4) -> f32 {
    return (v[0] + v[1]) + (v[2] + v[3]);
}

/// Deterministic horizontal sum `v[0] + v[1]`.
pub fn reduce_add_f64x2(v: f64x2) -> f64 {
    return v[0] + v[1];
}

/// Horizontal sum of all 4 i32 lanes.
pub fn reduce_add_i32x4(v: i32x4) -> i32 {
    return (v[0] + v[1]) + (v[2] + v[3]);
}

/// SIMD dot product of two equal-length `[]f32` slices using 4x unrolled FMA.
pub fn dot_f32(a: []f32, b: []f32) -> f32 {
    let n = std::mem::count<f32>(a);
    if n != std::mem::count<f32>(b) {
        std::internal::builtin::panic("simd dot_f32: slice lengths must match");
    }
    var acc0 = splat_f32x4(0.0);
    var acc1 = splat_f32x4(0.0);
    var acc2 = splat_f32x4(0.0);
    var acc3 = splat_f32x4(0.0);
    var i = 0;
    while i + 16 <= n {
        acc0 = fma_f32x4(std::internal::builtin::simd_load_f32x4(a, i), std::internal::builtin::simd_load_f32x4(b, i), acc0);
        acc1 = fma_f32x4(std::internal::builtin::simd_load_f32x4(a, i + 4), std::internal::builtin::simd_load_f32x4(b, i + 4), acc1);
        acc2 = fma_f32x4(std::internal::builtin::simd_load_f32x4(a, i + 8), std::internal::builtin::simd_load_f32x4(b, i + 8), acc2);
        acc3 = fma_f32x4(std::internal::builtin::simd_load_f32x4(a, i + 12), std::internal::builtin::simd_load_f32x4(b, i + 12), acc3);
        i = i + 16;
    }
    var sum = (acc0 + acc1) + (acc2 + acc3);
    while i + 4 <= n {
        sum = fma_f32x4(std::internal::builtin::simd_load_f32x4(a, i), std::internal::builtin::simd_load_f32x4(b, i), sum);
        i = i + 4;
    }
    var total = reduce_add_f32x4(sum);
    while i < n {
        total = fma_f32(a[i], b[i], total);
        i = i + 1;
    }
    return total;
}

/// SIMD dot product of signed `[]i8` weights against `[]f32` inputs.
pub fn dot_i8_f32(weights: []i8, input: []f32) -> f32 {
    let n = std::mem::count<i8>(weights);
    if n != std::mem::count<f32>(input) {
        std::internal::builtin::panic("simd dot_i8_f32: slice lengths must match");
    }
    var acc0 = splat_f32x4(0.0);
    var acc1 = splat_f32x4(0.0);
    var acc2 = splat_f32x4(0.0);
    var acc3 = splat_f32x4(0.0);
    var i = 0;
    while i + 16 <= n {
        let w = std::internal::builtin::simd_load_i8x16(weights, i);
        let x0 = std::internal::builtin::simd_load_f32x4(input, i);
        let x1 = std::internal::builtin::simd_load_f32x4(input, i + 4);
        let x2 = std::internal::builtin::simd_load_f32x4(input, i + 8);
        let x3 = std::internal::builtin::simd_load_f32x4(input, i + 12);
        acc0 = fma_f32x4(i8x16_to_f32x4_0(w), x0, acc0);
        acc1 = fma_f32x4(i8x16_to_f32x4_1(w), x1, acc1);
        acc2 = fma_f32x4(i8x16_to_f32x4_2(w), x2, acc2);
        acc3 = fma_f32x4(i8x16_to_f32x4_3(w), x3, acc3);
        i = i + 16;
    }
    var total = reduce_add_f32x4((acc0 + acc1) + (acc2 + acc3));
    while i < n {
        total = fma_f32(cast<f32>(weights[i]), input[i], total);
        i = i + 1;
    }
    return total;
}

/// SIMD dot product of two's-complement signed int8 weights stored in `[]u8`
/// against `[]f32` inputs.
pub fn dot_q8_f32(weights: []u8, input: []f32) -> f32 {
    let n = std::mem::len(weights);
    if n != std::mem::count<f32>(input) {
        std::internal::builtin::panic("simd dot_q8_f32: slice lengths must match");
    }
    var acc0 = splat_f32x4(0.0);
    var acc1 = splat_f32x4(0.0);
    var acc2 = splat_f32x4(0.0);
    var acc3 = splat_f32x4(0.0);
    var i = 0;
    while i + 16 <= n {
        let w = std::internal::builtin::simd_load_i8x16_u8(weights, i);
        let x0 = std::internal::builtin::simd_load_f32x4(input, i);
        let x1 = std::internal::builtin::simd_load_f32x4(input, i + 4);
        let x2 = std::internal::builtin::simd_load_f32x4(input, i + 8);
        let x3 = std::internal::builtin::simd_load_f32x4(input, i + 12);
        acc0 = fma_f32x4(i8x16_to_f32x4_0(w), x0, acc0);
        acc1 = fma_f32x4(i8x16_to_f32x4_1(w), x1, acc1);
        acc2 = fma_f32x4(i8x16_to_f32x4_2(w), x2, acc2);
        acc3 = fma_f32x4(i8x16_to_f32x4_3(w), x3, acc3);
        i = i + 16;
    }
    var total = reduce_add_f32x4((acc0 + acc1) + (acc2 + acc3));
    while i < n {
        let sv = (cast<i32>(weights[i]) ^ 128) - 128;
        total = fma_f32(cast<f32>(sv), input[i], total);
        i = i + 1;
    }
    return total;
}

/// SIMD signed 8-bit integer dot product using `sdot_i8x16`.
pub fn dot_i8_i8(a: []i8, b: []i8) -> i32 {
    let n = std::mem::count<i8>(a);
    if n != std::mem::count<i8>(b) {
        std::internal::builtin::panic("simd dot_i8_i8: slice lengths must match");
    }
    var acc0 = splat_i32x4(0);
    var acc1 = splat_i32x4(0);
    var i = 0;
    while i + 32 <= n {
        acc0 = sdot_i8x16(acc0, std::internal::builtin::simd_load_i8x16(a, i), std::internal::builtin::simd_load_i8x16(b, i));
        acc1 = sdot_i8x16(acc1, std::internal::builtin::simd_load_i8x16(a, i + 16), std::internal::builtin::simd_load_i8x16(b, i + 16));
        i = i + 32;
    }
    var acc = acc0 + acc1;
    while i + 16 <= n {
        acc = sdot_i8x16(acc, std::internal::builtin::simd_load_i8x16(a, i), std::internal::builtin::simd_load_i8x16(b, i));
        i = i + 16;
    }
    var total = reduce_add_i32x4(acc);
    while i < n {
        total = total + cast<i32>(a[i]) * cast<i32>(b[i]);
        i = i + 1;
    }
    return total;
}
