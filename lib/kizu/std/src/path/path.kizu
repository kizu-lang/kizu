// join joins slash-separated path fragments into an owned String.
pub fn join(
    allocator: Allocator,
    left: []u8,
    right: []u8
) -> std::mem::Error!std::string::String {
    var out = std::string::new(allocator);
    errdefer out.deinit(allocator);
    let left_len = std::mem::len(left);
    let right_len = std::mem::len(right);
    let absolute = (left_len > 0 and std::path::internal::bits::is_slash(left[0])) or
        (left_len == 0 and right_len > 0 and std::path::internal::bits::is_slash(right[0]));
    if absolute {
        try out.append_byte(allocator, cast<u8>(47));
    }
    var starts = std::array::new<i64>(allocator);
    errdefer starts.deinit(allocator);
    var depth = 0;
    var pass = 0;
    while pass < 2 {
        var path = left;
        if pass != 0 {
            path = right;
        }
        var index = 0;
        let length = std::mem::len(path);
        while index < length {
            while index < length and std::path::internal::bits::is_slash(path[index]) {
                index = index + 1;
            }
            let start = index;
            while index < length and !std::path::internal::bits::is_slash(path[index]) {
                index = index + 1;
            }
            if start == index {
                continue;
            }

            let segment = path[start..index];
            if std::mem::equal_bytes(segment, ".") {
                continue;
            }
            if std::mem::equal_bytes(segment, "..") {
                if depth == 0 {
                    if !absolute {
                        let before_dotdot = out.len();
                        if before_dotdot > 0 and !(absolute and before_dotdot == 1) {
                            try out.append_byte(allocator, cast<u8>(47));
                        }
                        try out.append_bytes(allocator, segment);
                    }
                    continue;
                }
                depth = depth - 1;
                let parent = starts.get_or_panic(depth);
                // The kept length comes from this walk, so the truncate cannot
                // be refused; a refusal is a broken invariant, not an error.
                out.truncate(parent) catch
                    std::internal::builtin::panic("path: parent length out of range");
                continue;
            }

            let before_segment = out.len();
            if before_segment > 0 and !(absolute and before_segment == 1) {
                try out.append_byte(allocator, cast<u8>(47));
            }
            let segment_start = before_segment;
            try out.append_bytes(allocator, segment);
            if depth < starts.len() {
                // depth stays below the appended count, so the set cannot be
                // refused; a refusal is a broken invariant, not an error.
                starts.set(depth, segment_start) catch
                    std::internal::builtin::panic("path: segment index out of range");
            } else {
                try starts.append(allocator, segment_start);
            }
            depth = depth + 1;
        }
        pass = pass + 1;
    }
    if out.len() == 0 {
        try out.append_bytes(allocator, ".");
    }
    starts.deinit(allocator);
    return move out;
}

// clean normalizes a slash-separated path into an owned String.
pub fn clean(allocator: Allocator, path: []u8) -> std::mem::Error!std::string::String {
    var out = std::string::new(allocator);
    errdefer out.deinit(allocator);
    let length = std::mem::len(path);
    let absolute = length > 0 and std::path::internal::bits::is_slash(path[0]);
    if absolute {
        try out.append_byte(allocator, cast<u8>(47));
    }

    var starts = std::array::new<i64>(allocator);
    errdefer starts.deinit(allocator);
    var index = 0;
    var depth = 0;
    while index < length {
        while index < length and std::path::internal::bits::is_slash(path[index]) {
            index = index + 1;
        }
        let start = index;
        while index < length and !std::path::internal::bits::is_slash(path[index]) {
            index = index + 1;
        }
        if start == index {
            continue;
        }

        let segment = path[start..index];
        if std::mem::equal_bytes(segment, ".") {
            continue;
        }
        if std::mem::equal_bytes(segment, "..") {
            if depth == 0 {
                if !absolute {
                    let before_dotdot = out.len();
                    if before_dotdot > 0 and !(absolute and before_dotdot == 1) {
                        try out.append_byte(allocator, cast<u8>(47));
                    }
                    try out.append_bytes(allocator, segment);
                }
                continue;
            }
            depth = depth - 1;
            let parent = starts.get_or_panic(depth);
            // The kept length comes from this walk, so the truncate cannot
            // be refused; a refusal is a broken invariant, not an error.
            out.truncate(parent) catch
                std::internal::builtin::panic("path: parent length out of range");
            continue;
        }
        let before_segment = out.len();
        if before_segment > 0 and !(absolute and before_segment == 1) {
            try out.append_byte(allocator, cast<u8>(47));
        }
        let segment_start = before_segment;
        try out.append_bytes(allocator, segment);
        if depth < starts.len() {
            // depth stays below the appended count, so the set cannot be
            // refused; a refusal is a broken invariant, not an error.
            starts.set(depth, segment_start) catch
                std::internal::builtin::panic("path: segment index out of range");
        } else {
            try starts.append(allocator, segment_start);
        }
        depth = depth + 1;
    }
    if out.len() == 0 {
        try out.append_bytes(allocator, ".");
    }
    starts.deinit(allocator);
    return move out;
}

// basename returns the final slash-separated path element.
pub fn basename(path: []u8) -> []u8 {
    return std::path::internal::bits::basename(path);
}

// dirname returns all but the final slash-separated path element.
pub fn dirname(path: []u8) -> []u8 {
    return std::path::internal::bits::dirname(path);
}

// extension returns the final extension of a slash-separated path.
pub fn extension(path: []u8) -> []u8 {
    return std::path::internal::bits::extension(path);
}
