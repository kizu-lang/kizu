// Arena storage is provided by the Go implementation for now:
// `std::arena::Arena<T>` and `std::arena::Handle<T>` are types the compiler
// knows. This file declares the public construction and cleanup boundary so
// owner elements follow the same source-visible deinit cascade as Array.

pub fn new<T>(allocator: Allocator) -> std::arena::Arena<T> {
    return std::internal::builtin::arena<T>(allocator);
}

// deinit consumes every initialized element, then releases the arena storage.
// Plain elements have no cleanup body, so their arena remains one runtime op.
fn (self: std::arena::Arena<T>) deinit<T>() -> void {
    comptime if std::meta::is_owner<T>() {
        while std::internal::builtin::arena_len<T>(self) > 0 {
            let item = std::internal::builtin::arena_pop_or_panic<T>(self);
            item.deinit();
        }
    } else {
    }
    std::internal::builtin::arena_deinit<T>(self);
}
