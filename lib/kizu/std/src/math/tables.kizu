// log_centre_bits is the centre c of sub-interval index of [0.6875, 1.375).
fn log_centre_bits(index: i64) -> u64 {
    if index == 0 { return word64(0x3fe61000, 0x00000000); }
    if index == 1 { return word64(0x3fe63000, 0x00000000); }
    if index == 2 { return word64(0x3fe65000, 0x00000000); }
    if index == 3 { return word64(0x3fe67000, 0x00000000); }
    if index == 4 { return word64(0x3fe69000, 0x00000000); }
    if index == 5 { return word64(0x3fe6b000, 0x00000000); }
    if index == 6 { return word64(0x3fe6d000, 0x00000000); }
    if index == 7 { return word64(0x3fe6f000, 0x00000000); }
    if index == 8 { return word64(0x3fe71000, 0x00000000); }
    if index == 9 { return word64(0x3fe73000, 0x00000000); }
    if index == 10 { return word64(0x3fe75000, 0x00000000); }
    if index == 11 { return word64(0x3fe77000, 0x00000000); }
    if index == 12 { return word64(0x3fe79000, 0x00000000); }
    if index == 13 { return word64(0x3fe7b000, 0x00000000); }
    if index == 14 { return word64(0x3fe7d000, 0x00000000); }
    if index == 15 { return word64(0x3fe7f000, 0x00000000); }
    if index == 16 { return word64(0x3fe81000, 0x00000000); }
    if index == 17 { return word64(0x3fe83000, 0x00000000); }
    if index == 18 { return word64(0x3fe85000, 0x00000000); }
    if index == 19 { return word64(0x3fe87000, 0x00000000); }
