// The tables of the exp, log, pow, sin and cos kernels in math.kizu, each a
// chain of equal comparisons on its index, which the optimizer folds into
// one table.get (a constant array in memory on every target). The values
// are generated to 90 digits and rounded once; the comment on each function
// says what it holds.

// exp_scale_bits is 2^(index/128) with index << 45 taken off its bits, so
// that adding a whole k << 45 rebuilds 2^(k/128).
fn exp_scale_bits(index: i64) -> u64 {
    if index == 0 { return word64(0x3ff00000, 0x00000000); }
    if index == 1 { return word64(0x3feff63d, 0xa9fb3335); }
    if index == 2 { return word64(0x3fefec9a, 0x3e778061); }
    if index == 3 { return word64(0x3fefe315, 0xe86e7f85); }
    if index == 4 { return word64(0x3fefd9b0, 0xd3158574); }
    if index == 5 { return word64(0x3fefd06b, 0x29ddf6de); }
    if index == 6 { return word64(0x3fefc745, 0x18759bc8); }
    if index == 7 { return word64(0x3fefbe3e, 0xcac6f383); }
    if index == 8 { return word64(0x3fefb558, 0x6cf9890f); }
    if index == 9 { return word64(0x3fefac92, 0x2b7247f7); }
    if index == 10 { return word64(0x3fefa3ec, 0x32d3d1a2); }
    if index == 11 { return word64(0x3fef9b66, 0xaffed31b); }
    if index == 12 { return word64(0x3fef9301, 0xd0125b51); }
    if index == 13 { return word64(0x3fef8abd, 0xc06c31cc); }
    if index == 14 { return word64(0x3fef829a, 0xaea92de0); }
    if index == 15 { return word64(0x3fef7a98, 0xc8a58e51); }
    if index == 16 { return word64(0x3fef72b8, 0x3c7d517b); }
    if index == 17 { return word64(0x3fef6af9, 0x388c8dea); }
    if index == 18 { return word64(0x3fef635b, 0xeb6fcb75); }
    if index == 19 { return word64(0x3fef5be0, 0x84045cd4); }
    if index == 20 { return word64(0x3fef5487, 0x3168b9aa); }
    if index == 21 { return word64(0x3fef4d50, 0x22fcd91d); }
    if index == 22 { return word64(0x3fef463b, 0x88628cd6); }
    if index == 23 { return word64(0x3fef3f49, 0x917ddc96); }
    if index == 24 { return word64(0x3fef387a, 0x6e756238); }
