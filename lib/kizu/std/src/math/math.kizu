import std::float;

// Elementary functions and constants on f64.
//
// Four of them are one IEEE 754 operation each -- `sqrt`, `floor`, `ceil`
// and `trunc` -- and rest on the backend, which has each as one instruction
// or intrinsic and answers the correctly rounded value; the native target
// adds the fused multiply-add, which wasm gets in software (fma_fast).
// Everything else is written over those and over the bits of a float, so
// the answer is the same on every target.

// sqrt returns the square root of value, correctly rounded. A negative value
// gives NaN; -0.0 gives -0.0.
fn sqrt_f64(value: f64) -> f64 {
    return std::internal::builtin::f64_sqrt(value);
}

// floor returns the largest integral value not greater than value.
fn floor_f64(value: f64) -> f64 {
    return std::internal::builtin::f64_floor(value);
}

// ceil returns the smallest integral value not less than value.
fn ceil_f64(value: f64) -> f64 {
    return std::internal::builtin::f64_ceil(value);
}

// trunc returns the integral part of value, rounding toward zero.
fn trunc_f64(value: f64) -> f64 {
    return std::internal::builtin::f64_trunc(value);
}

// round returns the integral value nearest to value, with halves rounded
// away from zero: round(0.5) is 1.0 and round(-0.5) is -1.0.
fn round_f64(value: f64) -> f64 {
    // value - whole is exact below 2^52; above it every value is integral
    // and the difference is zero. NaN and the infinities fall through both
    // comparisons and come back as trunc left them.
    let whole = trunc_f64(value);
    let rest = value - whole;
    if rest >= 0.5 {
        return whole + 1.0;
    }
    if rest <= -0.5 {
        return whole - 1.0;
    }
    return whole;
}

// abs returns value with its sign bit cleared: |NaN| is NaN, |-0.0| is 0.0.
fn abs_f64(value: f64) -> f64 {
    return float::from_bits(float::bits(value) & ~sign_bit());
}

// copysign returns magnitude with the sign bit of sign.
fn copysign_f64(magnitude: f64, sign: f64) -> f64 {
    let bits = (float::bits(magnitude) & ~sign_bit()) | (float::bits(sign) & sign_bit());
    return float::from_bits(bits);
}

// is_negative reports whether the sign bit of value is set, so -0.0 is
// negative and NaN follows its sign bit.
fn is_negative_f64(value: f64) -> bool {
    return float::bits(value) & sign_bit() != 0;
}

// min returns the smaller of two values. One NaN yields the other value,
// and -0.0 is smaller than 0.0.
fn min_f64(a: f64, b: f64) -> f64 {
    if float::is_nan(a) {
        return b;
    }
    if float::is_nan(b) {
        return a;
    }
    if a == b {
        if is_negative_f64(a) {
            return a;
        }
        return b;
    }
    if a < b {
        return a;
    }
    return b;
}

// max returns the larger of two values. One NaN yields the other value,
// and 0.0 is larger than -0.0.
fn max_f64(a: f64, b: f64) -> f64 {
    if float::is_nan(a) {
        return b;
    }
    if float::is_nan(b) {
        return a;
    }
    if a == b {
        if is_negative_f64(a) {
            return b;
        }
        return a;
    }
    if a > b {
        return a;
    }
    return b;
}

// clamp returns value held within [low, high]. A NaN value stays NaN.
fn clamp_f64(value: f64, low: f64, high: f64) -> f64 {
    if value < low {
        return low;
    }
    if value > high {
        return high;
    }
    return value;
}

// hypot returns sqrt(x*x + y*y) without the overflow or underflow the
// squares alone would have: the larger magnitude is factored out first.
// An infinite argument gives infinity even when the other is NaN.
fn hypot_f64(x: f64, y: f64) -> f64 {
    var p = abs_f64(x);
    var q = abs_f64(y);
    if float::is_infinite(p) or float::is_infinite(q) {
        return infinity_f64();
    }
    if float::is_nan(p) or float::is_nan(q) {
        return nan_f64();
    }
    if p < q {
        let swap = p;
        p = q;
        q = swap;
    }
    if p == 0.0 {
        return 0.0;
    }
    let ratio = q / p;
    return p * sqrt_f64(1.0 + ratio * ratio);
}

// pi is the ratio of a circle's circumference to its diameter.
fn pi_f64() -> f64 {
    return 3.141592653589793;
}

// tau is 2 * pi, the circumference of the unit circle.
fn tau_f64() -> f64 {
    return 6.283185307179586;
}

// e is the base of the natural logarithm.
fn e_f64() -> f64 {
    return 2.718281828459045;
}

// infinity returns positive infinity.
fn infinity_f64() -> f64 {
    return float::from_bits(exponent_mask());
}

// nan returns a quiet NaN with the sign bit clear.
fn nan_f64() -> f64 {
    return float::from_bits(exponent_mask() | (cast<u64>(1) << 51));
}

fn sign_bit() -> u64 { return cast<u64>(1) << 63; }

fn exponent_mask() -> u64 { return cast<u64>(2047) << 52; }

// ---------------------------------------------------------------------------
// Exponentials and logarithms.
//
// exp, exp2, log and pow are table driven, in the shape of the ARM
// optimized-routines: the argument is reduced against 128 (pow: 256) points
// whose values live in tables.kizu, and a short polynomial covers what is
// left. expm1, log1p, log2 and log10 follow the FreeBSD msun algorithms as
// Go's math package spells them. Each answers within one unit in the last
// place of the true value, and the same bits on every target.

// exp returns e raised to value. Above about 709.78 the answer is infinity;
// below about -745.13 it is 0.
fn exp_f64(value: f64) -> f64 {
    // The exponent of value above 2^-54; below that it wraps past 2^31.
    let top = ((float::bits(value) >> 52) & 0x7ff) - 0x3c9;
    if top >= 0x3f {
        return exp_edges(value);
    }
    return exp_kernel(value, 0.0, 0, false);
}

// exp_edges is exp of a value below 2^-54 or at least 512 in magnitude.
fn exp_edges(value: f64) -> f64 {
    let top = ((float::bits(value) >> 52) & 0x7ff) - 0x3c9;
    if top >= 0x80000000 {
        return 1.0 + value;
    }
    if float::is_nan(value) {
        return value;
    }
    if value > 709.782712893383973096 {
        return infinity_f64();
    }
    if value < -745.133219101941108420 {
        return 0.0;
    }
    return exp_kernel(value, 0.0, 0, true);
}

// fma_fast is x * y + z: on the native target the fused multiply-add
// instruction, one rounding; on wasm, which has no such instruction, the
// product and the sum rounded in turn. The kernels below use it only where
// either is within their error budget, so both targets answer within one
// unit in the last place, though not always the same bit. (The software
// fma of `math::fma` would give the same bits but costs a hundred
// instructions a call.)
fn fma_fast(x: f64, y: f64, z: f64) -> f64 {
    comptime if std::target::is_native() {
        return std::internal::builtin::f64_fma(x, y, z);
    } else {
        return x * y + z;
    }
}

// exp_kernel returns exp(value + tail), negated when sign_bias is set, for
// a value below 512 in magnitude: value = k ln2/128 + r with |r| at most
// ln2/256, so exp(value) = 2^(k/128) exp(r), with 2^(k/128) from the table
// and exp(r) from a polynomial. The tail carries the low half of a
// double-double argument (pow); edge says the scale by 2^(k/128) alone
// could overflow or come out subnormal.
fn exp_kernel(value: f64, tail: f64, sign_bias: u64, edge: bool) -> f64 {
    // Adding 1.5 * 2^52 rounds value * 128/ln2 to an integer whose low bits
    // sit in the low bits of the sum.
    let shift = 6755399441055744.0;
    let kd = fma_fast(value, 184.6649652337873, shift);
    let ki = float::bits(kd);
    let k = kd - shift;
    var r = fma_fast(k, -0.005415212348111709, value);
    r = fma_fast(k, -1.2864023111638346e-14, r);
    r = r + tail;
    let index = cast<i64>(ki & 127);
    let sbits = exp_scale_bits(index) + ((ki + sign_bias) << 45);
    let r2 = r * r;
    let low = fma_fast(r2, fma_fast(r, 0.16666666666666666, 0.5), float::from_bits(exp_tail_bits(index)) + r);
    let tmp = fma_fast(r2 * r2, fma_fast(r, 0.008333333333333333, 0.041666666666666664), low);
    if edge {
        return exp_edge_scale(tmp, sbits, ki);
    }
    let scale = float::from_bits(sbits);
    return fma_fast(scale, tmp, scale);
}

// exp_edge_scale finishes exp_kernel where 2^(k/128) alone would overflow
// or be subnormal: the scale is taken 2^1009 too small or 2^1022 too large
// and the answer moved back after the multiply, so that a subnormal answer
// is rounded once rather than twice.
fn exp_edge_scale(tmp: f64, sbits: u64, ki: u64) -> f64 {
    if ki & 0x80000000 == 0 {
        // k > 0: the exponent of the scale may have overflowed by up to 460.
        let scale = float::from_bits(sbits - (cast<u64>(1009) << 52));
        return 5.486124068793689e303 * (scale + scale * tmp);
    }
    // k < 0: the answer may be subnormal.
    let scale = float::from_bits(sbits + (cast<u64>(1022) << 52));
    var y = scale + scale * tmp;
    if abs_f64(y) < 1.0 {
        var one = 1.0;
        if y < 0.0 {
            one = -1.0;
        }
        var lo = scale - y + scale * tmp;
        let hi = one + y;
        lo = one - hi + y + lo;
        y = (hi + lo) - one;
        if y == 0.0 {
            y = float::from_bits(sbits & sign_bit());
        }
    }
    return 2.2250738585072014e-308 * y;
}

// exp2 returns 2 raised to value.
fn exp2_f64(value: f64) -> f64 {
    let top = ((float::bits(value) >> 52) & 0x7ff) - 0x3c9;
    if top >= 0x3f {
        return exp2_edges(value);
    }
    return exp2_kernel(value, false);
}

// exp2_edges is exp2 of a value below 2^-54 or at least 512 in magnitude.
fn exp2_edges(value: f64) -> f64 {
    let top = ((float::bits(value) >> 52) & 0x7ff) - 0x3c9;
    if top >= 0x80000000 {
        return 1.0 + value;
    }
    if float::is_nan(value) {
        return value;
    }
    if value >= 1024.0 {
        return infinity_f64();
    }
    if value <= -1075.0 {
        return 0.0;
    }
    return exp2_kernel(value, true);
}

// exp2_kernel is exp_kernel for 2^value: value = k/128 + r with |r| at
// most 1/256, found by rounding to the 1/128 grid, and 2^r from a
// polynomial.
fn exp2_kernel(value: f64, edge: bool) -> f64 {
    let shift = 52776558133248.0;
    let kd = value + shift;
    let ki = float::bits(kd);
    let r = value - (kd - shift);
    let index = cast<i64>(ki & 127);
    let sbits = exp_scale_bits(index) + (ki << 45);
    let r2 = r * r;
    let low = fma_fast(r2, fma_fast(r, 0.05550410866482158, 0.24022650695910072), fma_fast(r, 0.6931471805599453, float::from_bits(exp_tail_bits(index))));
    let tmp = fma_fast(r2 * r2, fma_fast(r, 0.0013333558146428443, 0.009618129107628477), low);
    if edge {
        return exp_edge_scale(tmp, sbits, ki);
    }
    let scale = float::from_bits(sbits);
    return fma_fast(scale, tmp, scale);
}

// expm1 returns exp(value) - 1, accurate where the subtraction itself would
// lose every digit: expm1(1e-10) is 1.00000000005e-10.
fn expm1_f64(value: f64) -> f64 {
    let overflow = 709.782712893383973096;
    let ln2_x56 = 3.88162421113569373274e+01;
    let ln2_half_x3 = 1.03972077083991796413e+00;
    let ln2_half = 3.46573590279972654709e-01;
    let inv_ln2 = 1.44269504088896338700e+00;
    let tiny = 5.5511151231257827021181583404541015625e-17;
    let q1 = -3.33333333333331316428e-02;
    let q2 = 1.58730158725481460165e-03;
    let q3 = -7.93650757867487942473e-05;
    let q4 = 4.00821782732936239552e-06;
    let q5 = -2.01099218183624371326e-07;
    if value == infinity_f64() or float::is_nan(value) {
        return value;
    }
    if value == -infinity_f64() {
        return -1.0;
    }
    let negative = value < 0.0;
    let magnitude = abs_f64(value);
    // A huge argument is -1 or overflows before any reduction.
    if magnitude >= ln2_x56 {
        if negative {
            return -1.0;
        }
        if magnitude >= overflow {
            return infinity_f64();
        }
    }
    // Reduce to |x| <= ln 2 / 2, keeping c, what the reduction dropped.
    var x = value;
    var c = 0.0;
    var k = 0;
    if magnitude > ln2_half {
        var hi = 0.0;
        var lo = 0.0;
        if magnitude < ln2_half_x3 {
            if negative {
                hi = x + ln2_hi();
                lo = -ln2_lo();
                k = -1;
            } else {
                hi = x - ln2_hi();
                lo = ln2_lo();
                k = 1;
            }
        } else {
            if negative {
                k = cast<i64>(inv_ln2 * x - 0.5);
            } else {
                k = cast<i64>(inv_ln2 * x + 0.5);
            }
            let t = cast<f64>(k);
            hi = x - t * ln2_hi();
            lo = t * ln2_lo();
        }
        x = hi - lo;
        c = (hi - x) - lo;
    } else {
        if magnitude < tiny {
            return x;
        }
    }
    let hfx = 0.5 * x;
    let hxs = x * hfx;
    let r1 = 1.0 + hxs * (q1 + hxs * (q2 + hxs * (q3 + hxs * (q4 + hxs * q5))));
    let t = 3.0 - r1 * hfx;
    var e = hxs * ((r1 - t) / (6.0 - x * t));
    if k == 0 {
        return x - (x * e - hxs);
    }
    e = (x * (e - c) - c);
    e = e - hxs;
    if k == -1 {
        return 0.5 * (x - e) - 0.5;
    }
    if k == 1 {
        if x < -0.25 {
            return -2.0 * (e - (x + 0.5));
        }
        return 1.0 + 2.0 * (x - e);
    }
    if k <= -2 or k > 56 {
        let y = 1.0 - (e - x);
        return scale_exponent(y, k) - 1.0;
    }
    if k < 20 {
        // t = 1 - 2^-k, built from its bits.
        let t2 = float::from_bits(0x3ff0000000000000 - (0x20000000000000 >> cast<u64>(k)));
        let y = t2 - (e - x);
        return scale_exponent(y, k);
    }
    let t2 = float::from_bits(cast<u64>(1023 - k) << 52);
    var y = x - (e + t2);
    y = y + 1.0;
    return scale_exponent(y, k);
}

// scale_exponent adds k to the exponent field of a normal value, which is
// value * 2^k as long as the result stays normal; the callers keep it so.
fn scale_exponent(value: f64, k: i64) -> f64 {
    if k >= 0 {
        return float::from_bits(float::bits(value) + (cast<u64>(k) << 52));
    }
    return float::from_bits(float::bits(value) - (cast<u64>(-k) << 52));
}

// log returns the natural logarithm of value. A negative value gives NaN and
// zero gives negative infinity.
fn log_f64(value: f64) -> f64 {
    let ix = float::bits(value);
    // In [1 - 1/16, 1 + 1/16) log(1 + f) is taken straight from f = value - 1,
    // which is exact there.
    if ix - 0x3fee000000000000 < 0x3000000000000 {
        return log_near_one(value - 1.0);
    }
    if (ix >> 48) - 0x0010 >= 0x7fe0 {
        return log_edges(value);
    }
    return log_kernel(ix);
}

// log_edges is log of zero, a subnormal, a negative value, infinity or NaN.
fn log_edges(value: f64) -> f64 {
    if float::is_nan(value) {
        return value;
    }
    let ix = float::bits(value);
    if ix << 1 == 0 {
        return -infinity_f64();
    }
    if ix >> 63 == 1 {
        return nan_f64();
    }
    if value == infinity_f64() {
        return value;
    }
    // A subnormal: value * 2^52 is normal.
    return log_kernel(float::bits(value * 4503599627370496.0) - (cast<u64>(52) << 52));
}

// log_kernel is log of the normal positive value with bits ix, at least
// 1/16 away from 1. value = 2^k z with z in [0.6875, 1.375), z = c (1 + r)
// for the table centre c of z's sub-interval, and
// log(value) = k ln2 + log(c) + log(1 + r) with |r| below 1/256. k ln2 and
// log(c) are each split in two so that the sum of the high parts is exact.
fn log_kernel(ix: u64) -> f64 {
    let tmp = ix - 0x3fe6000000000000;
    let index = cast<i64>((tmp >> 45) & 127);
    let k = cast<f64>(cast<i64>(tmp) >> 52);
    let z = float::from_bits(ix - (tmp & (cast<u64>(0xfff) << 52)));
    let r = (z - float::from_bits(log_centre_bits(index))) * float::from_bits(log_inverse_bits(index));
    // k ln2 + log(c) + r as hi + lo, with ln2 in two parts so that k times
    // the first is exact.
    let w = fma_fast(k, 0.6931471805598903, float::from_bits(log_c_bits(index)));
    let hi = w + r;
    let lo = fma_fast(k, 5.497923018708371e-14, w - hi + r) + float::from_bits(log_c_tail_bits(index));
    let r2 = r * r;
    // -r^2/2 + r^3/3 - ... + r^7/7
    let high = fma_fast(r2, 0.14285714285714285, fma_fast(r, -0.16666666666666666, 0.2));
    let mid = fma_fast(r2, high, fma_fast(r, -0.25, 0.3333333333333333));
    return fma_fast(r * r2, mid, fma_fast(r2, -0.5, lo)) + hi;
}

// log_near_one is log(1 + f) for |f| below 1/16, the msun kernel on
// s = f / (2 + f): log(1 + f) = 2s + 2s^3/3 + 2s^5/5 + ..., with f^2/2 kept
// apart so that the cancellation against f is exact.
fn log_near_one(f: f64) -> f64 {
    let l1 = 6.666666666666735130e-01;
    let l2 = 3.999999999940941908e-01;
    let l3 = 2.857142874366239149e-01;
    let l4 = 2.222219843214978396e-01;
    let l5 = 1.818357216161805012e-01;
    let l6 = 1.531383769920937332e-01;
    let l7 = 1.479819860511658591e-01;
    let s = f / (2.0 + f);
    let s2 = s * s;
    let s4 = s2 * s2;
    let t1 = s2 * (l1 + s4 * (l3 + s4 * (l5 + s4 * l7)));
    let t2 = s4 * (l2 + s4 * (l4 + s4 * l6));
    let r = t1 + t2;
    let hfsq = 0.5 * f * f;
    return f - (hfsq - s * (hfsq + r));
}

// log1p returns log(1 + value), accurate where the addition itself would
// lose every digit: log1p(1e-10) is 9.9999999995e-11.
fn log1p_f64(value: f64) -> f64 {
    let sqrt2_m1 = 4.142135623730950488017e-01;
    let sqrt2_half_m1 = -2.928932188134524755992e-01;
    let small = 1.86264514923095703125e-9;
    let tiny = 5.5511151231257827021181583404541015625e-17;
    let two53 = 9007199254740992.0;
    let lp1 = 6.666666666666735130e-01;
    let lp2 = 3.999999999940941908e-01;
    let lp3 = 2.857142874366239149e-01;
    let lp4 = 2.222219843214978396e-01;
    let lp5 = 1.818357216161805012e-01;
    let lp6 = 1.531383769920937332e-01;
    let lp7 = 1.479819860511658591e-01;
    if value < -1.0 or float::is_nan(value) {
        return nan_f64();
    }
    if value == -1.0 {
        return -infinity_f64();
    }
    if value == infinity_f64() {
        return infinity_f64();
    }
    let magnitude = abs_f64(value);
    var f = 0.0;
    var iu = cast<u64>(0);
    var k = 1;
    if magnitude < sqrt2_m1 {
        if magnitude < small {
            if magnitude < tiny {
                return value;
            }
            return value - value * value * 0.5;
        }
        if value > sqrt2_half_m1 {
            k = 0;
            f = value;
            iu = 1;
        }
    }
    var c = 0.0;
    if k != 0 {
        var u = 0.0;
        if magnitude < two53 {
            u = 1.0 + value;
            iu = float::bits(u);
            k = cast<i64>(iu >> 52) - 1023;
            // The correction term: what 1 + value rounded away.
            if k > 0 {
                c = 1.0 - (u - value);
            } else {
                c = value - (u - 1.0);
            }
            c = c / u;
        } else {
            u = value;
            iu = float::bits(u);
            k = cast<i64>(iu >> 52) - 1023;
            c = 0.0;
        }
        iu = iu & 0x000fffffffffffff;
        if iu < 0x0006a09e667f3bcd {
            u = float::from_bits(iu | 0x3ff0000000000000);
        } else {
            k = k + 1;
            u = float::from_bits(iu | 0x3fe0000000000000);
            iu = (0x0010000000000000 - iu) >> 2;
        }
        f = u - 1.0;
    }
    let hfsq = 0.5 * f * f;
    let kf = cast<f64>(k);
    if iu == 0 {
        if f == 0.0 {
            if k == 0 {
                return 0.0;
            }
            c = c + kf * ln2_lo();
            return kf * ln2_hi() + c;
        }
        let r = hfsq * (1.0 - 0.66666666666666666 * f);
        if k == 0 {
            return f - r;
        }
        return kf * ln2_hi() - ((r - (kf * ln2_lo() + c)) - f);
    }
    let s = f / (2.0 + f);
    let z = s * s;
    let r = z * (lp1 + z * (lp2 + z * (lp3 + z * (lp4 + z * (lp5 + z * (lp6 + z * lp7))))));
    if k == 0 {
        return f - (hfsq - s * (hfsq + r));
    }
    return kf * ln2_hi() - ((hfsq - (s * (hfsq + r) + (kf * ln2_lo() + c))) - f);
}

// log2 returns the base-2 logarithm of value. An exact power of two gives an
// exact integer.
fn log2_f64(value: f64) -> f64 {
    let split = frexp_f64(value);
    if split.fraction == 0.5 {
        return cast<f64>(split.exponent - 1);
    }
    return log_f64(split.fraction) * inv_ln2() + cast<f64>(split.exponent);
}

// log10 returns the base-10 logarithm of value.
fn log10_f64(value: f64) -> f64 {
    return log_f64(value) * inv_ln10();
}

// pow returns base raised to exponent, with the special cases of C's pow:
// pow(x, 0) and pow(1, y) are 1 for any x and y, a negative base with a
// non-integral exponent is NaN, and 0 and the infinities follow the sign
// and parity of the exponent.
fn pow_f64(base: f64, exponent: f64) -> f64 {
    var ix = float::bits(base);
    let iy = float::bits(exponent);
    var sign_bias = cast<u64>(0);
    if (ix >> 52) - 0x001 >= 0x7fe or ((iy >> 52) & 0x7ff) - 0x3be >= 0x80 {
        // base is zero, subnormal, negative, infinite or NaN, or exponent is
        // below 2^-65 or at least 2^63 in magnitude, infinite or NaN.
        let edge = pow_edges(base, exponent);
        if edge.done {
            return edge.value;
        }
        ix = edge.bits;
        sign_bias = edge.sign_bias;
    }
    let lg = pow_log(ix);
    // exponent * log(base) as a double-double: the product's rounding is
    // recovered by a fused multiply-add where there is one, and elsewhere
    // the halves are cut to 26 bits so that their product is exact.
    let ehi = exponent * lg.hi;
    var elo = 0.0;
    comptime if std::target::is_native() {
        elo = fma_fast(exponent, lg.lo, fma_fast(exponent, lg.hi, -ehi));
    } else {
        let yhi = float::from_bits(iy & ~((cast<u64>(1) << 27) - 1));
        let ylo = exponent - yhi;
        let lhi = float::from_bits(float::bits(lg.hi) & ~((cast<u64>(1) << 27) - 1));
        let llo = lg.hi - lhi + lg.lo;
        elo = fma_fast(ylo, lhi, exponent * llo) + (yhi * lhi - ehi);
    }
    let top = ((float::bits(ehi) >> 52) & 0x7ff) - 0x3c9;
    if top >= 0x3f {
        if top >= 0x80000000 {
            // |exponent * log(base)| below 2^-54: the answer is 1 to the last bit.
            let one = 1.0 + ehi;
            if sign_bias != 0 {
                return -one;
            }
            return one;
        }
        if ehi > 709.782712893383973096 {
            if sign_bias != 0 {
                return -infinity_f64();
            }
            return infinity_f64();
        }
        if ehi < -745.133219101941108420 {
            return float::from_bits(sign_bias << 45);
        }
        return exp_kernel(ehi, elo, sign_bias, true);
    }
    return exp_kernel(ehi, elo, sign_bias, false);
}

// PowEdge is what pow_edges settled: either the answer (done), or the bits
// of |base| made normal and the sign to give the answer.
struct PowEdge {
    done: bool,
    value: f64,
    bits: u64,
    sign_bias: u64,
}

// pow_edges handles the special cases of pow: a zero, subnormal, negative,
// infinite or NaN base, and an exponent that is zero, infinite, NaN, tiny
// (below 2^-65) or huge (at least 2^63).
fn pow_edges(base: f64, exponent: f64) -> PowEdge {
    var ix = float::bits(base);
    let iy = float::bits(exponent);
    let one = float::bits(1.0);
    let inf = float::bits(infinity_f64());
    var sign_bias = cast<u64>(0);
    if (iy << 1) - 1 >= (inf << 1) - 1 {
        // exponent is zero, infinite or NaN.
        if iy << 1 == 0 or ix == one {
            return settled(1.0);
        }
        if ix << 1 > inf << 1 or iy << 1 > inf << 1 {
            return settled(nan_f64());
        }
        if ix << 1 == one << 1 {
            // (-1)^(+-infinity) is 1.
            return settled(1.0);
        }
        if (ix << 1 < one << 1) == (iy >> 63 == 0) {
            // |base| < 1 with exponent +infinity, or |base| > 1 with -infinity.
            return settled(0.0);
        }
        return settled(infinity_f64());
    }
    if (ix << 1) - 1 >= (inf << 1) - 1 {
        // base is zero, infinite or NaN.
        var x2 = base * base;
        if ix >> 63 == 1 and pow_integer_kind(iy) == 1 {
            x2 = -x2;
        }
        if iy >> 63 == 1 {
            return settled(1.0 / x2);
        }
        return settled(x2);
    }
    if ix >> 63 == 1 {
        let kind = pow_integer_kind(iy);
        if kind == 0 {
            return settled(nan_f64());
        }
        if kind == 1 {
            sign_bias = 0x40000;
        }
        ix = ix & ~sign_bit();
    }
    if ((iy >> 52) & 0x7ff) - 0x3be >= 0x80 {
        if ix == one {
            return settled(1.0);
        }
        if ((iy >> 52) & 0x7ff) < 0x3be {
            // |exponent| below 2^-65: the answer is 1 to the last bit.
            if ix > one {
                return settled(1.0 + exponent);
            }
            return settled(1.0 - exponent);
        }
        // |exponent| at least 2^63, an even integer: |base| is not 1, so
        // |exponent log(base)| is past 1000.
        if (ix > one) == (iy >> 63 == 0) {
            return settled(infinity_f64());
        }
        return settled(0.0);
    }
    if ix >> 52 == 0 {
        // A subnormal base: base * 2^52 is normal.
        ix = float::bits(float::from_bits(ix) * 4503599627370496.0) - (cast<u64>(52) << 52);
    }
    return PowEdge { done: false, value: 0.0, bits: ix, sign_bias: sign_bias };
}

fn settled(value: f64) -> PowEdge {
    return PowEdge { done: true, value: value, bits: 0, sign_bias: 0 };
}

// pow_integer_kind is 0 when the float with bits iy is not an integer, 1
// when it is an odd integer and 2 when even.
fn pow_integer_kind(iy: u64) -> i64 {
    let e = (iy >> 52) & 0x7ff;
    if e < 0x3ff {
        return 0;
    }
    if e > 0x433 {
        return 2;
    }
    let low = cast<u64>(1) << (0x433 - e);
    if iy & (low - 1) != 0 {
        return 0;
    }
    if iy & low != 0 {
        return 1;
    }
    return 2;
}

// LogParts is a logarithm as a double-double, hi + lo.
struct LogParts {
    hi: f64,
    lo: f64,
}

// pow_log is log of the normal positive value with bits ix to about 2^-68
// relative, which pow needs since the exponent multiplies the error. As in
// log_kernel, value = 2^k z with z = c (1 + r) and z in [0.70508, 1.41016),
// but 1/c = j/256 for an integer j, which has so few bits that r = z/c - 1
// is exact, and every rounding of the sum is carried into lo.
fn pow_log(ix: u64) -> LogParts {
    let tmp = ix - 0x3fe6900000000000;
    let k = cast<f64>(cast<i64>(tmp) >> 52);
    let iz = ix - (tmp & (cast<u64>(0xfff) << 52));
    let z = float::from_bits(iz);
    // 1/c = j/256 for the j of z's sub-interval, so that |z/c - 1| is below
    // 2^-7.9 and, with so few bits in 1/c, exact.
    let index = cast<i64>((tmp >> 44) & 255);
    let invc = cast<f64>(pow_j_bits(index)) * 0.00390625;
    // r = z/c - 1 exactly, and lo3, what the rounding of ar2 = -r^2/2
    // dropped: with a fused multiply-add each is one instruction; without
    // one, r comes from the halves of z, whose products with so short a
    // 1/c are exact, as is the square of r's top half.
    var r = 0.0;
    var ar = 0.0;
    var ar2 = 0.0;
    var lo3 = 0.0;
    comptime if std::target::is_native() {
        r = fma_fast(z, invc, -1.0);
        ar = -0.5 * r;
        ar2 = r * ar;
        lo3 = fma_fast(ar, r, -ar2);
    } else {
        let zhi = float::from_bits((iz + (cast<u64>(1) << 31)) & (cast<u64>(0xffffffff) << 32));
        let zlo = z - zhi;
        let rhi = zhi * invc - 1.0;
        let rlo = zlo * invc;
        r = rhi + rlo;
        ar = -0.5 * r;
        ar2 = r * ar;
        let arhi = -0.5 * rhi;
        lo3 = rlo * (ar + arhi) + (rhi * arhi - ar2);
    }
    let ar3 = r * ar2;
    // k ln2 + log(c) + r, with the rounding of each step kept.
    let t1 = fma_fast(k, 0.6931471805598903, float::from_bits(pow_log_c_bits(index)));
    let t2 = t1 + r;
    let lo1 = fma_fast(k, 5.497923018708371e-14, float::from_bits(pow_log_c_tail_bits(index)));
    let lo2 = t1 - t2 + r;
    let hi = t2 + ar2;
    let lo4 = t2 - hi + ar2;
    // r^3/3 - r^4/4 + ... + r^9/9, written on ar2 and ar3.
    let inner = fma_fast(ar2, 1.7777777777777777, fma_fast(r, 1.0, -1.1428571428571428));
    let middle = fma_fast(ar2, inner, fma_fast(r, -0.6666666666666666, 0.8));
    let p = ar3 * fma_fast(ar2, middle, fma_fast(r, 0.5, -0.6666666666666666));
    let lo = lo1 + lo2 + lo3 + lo4 + p;
    let y = hi + lo;
    return LogParts { hi: y, lo: hi - y + lo };
}

// fmod returns the remainder of value / divisor, with the sign of value and a
// magnitude below |divisor|, the way C's fmod does: fmod(5.5, 2.0) is 1.5 and
// fmod(-5.5, 2.0) is -1.5. A zero divisor, an infinite value, or a NaN gives
// NaN.
fn fmod_f64(value: f64, divisor: f64) -> f64 {
    if divisor == 0.0 or float::is_infinite(value) or float::is_nan(value) or float::is_nan(divisor) {
        return nan_f64();
    }
    let y = abs_f64(divisor);
    let ysplit = frexp_f64(y);
    var r = value;
    if value < 0.0 {
        r = -value;
    }
    while r >= y {
        let rsplit = frexp_f64(r);
        var rexp = rsplit.exponent;
        if rsplit.fraction < ysplit.fraction {
            rexp = rexp - 1;
        }
        r = r - ldexp_f64(y, rexp - ysplit.exponent);
    }
    if value < 0.0 {
        r = -r;
    }
    return r;
}

// ldexp returns fraction * 2^exponent, with a result past the format
// becoming infinity or 0 and one below the normal range rounded once into a
// subnormal.
fn ldexp_f64(fraction: f64, exponent: i64) -> f64 {
    if fraction == 0.0 or float::is_infinite(fraction) or float::is_nan(fraction) {
        return fraction;
    }
    let normal = normalize(fraction);
    var bits = float::bits(normal.fraction);
    var e = exponent + normal.exponent + cast<i64>((bits >> 52) & 2047) - 1023;
    if e < -1075 {
        return copysign_f64(0.0, fraction);
    }
    if e > 1023 {
        if fraction < 0.0 {
            return -infinity_f64();
        }
        return infinity_f64();
    }
    var m = 1.0;
    if e < -1022 {
        // A subnormal result: build it 2^53 too large, then scale once.
        e = e + 53;
        m = 1.1102230246251565404236316680908203125e-16;
    }
    bits = bits & ~(cast<u64>(2047) << 52);
    bits = bits | (cast<u64>(e + 1023) << 52);
    return m * float::from_bits(bits);
}

// Scaled is a value taken apart into a fraction and the power of two that
// scales it back: fraction * 2^exponent.
pub struct Scaled {
    pub fraction: f64,
    pub exponent: i64,
}

// frexp splits value into fraction * 2^exponent with the fraction in
// [1/2, 1). Zero, the infinities and NaN come back as they are with a zero
// exponent.
fn frexp_f64(value: f64) -> Scaled {
    if value == 0.0 or float::is_infinite(value) or float::is_nan(value) {
        return Scaled { fraction: value, exponent: 0 };
    }
    let normal = normalize(value);
    var bits = float::bits(normal.fraction);
    let exponent = normal.exponent + cast<i64>((bits >> 52) & 2047) - 1022;
    bits = bits & ~(cast<u64>(2047) << 52);
    bits = bits | (cast<u64>(1022) << 52);
    return Scaled { fraction: float::from_bits(bits), exponent: exponent };
}

// normalize scales a subnormal value up by 2^52 so that its exponent field
// is meaningful, reporting the -52 that undoes it; a normal value is
// returned as it is with 0.
fn normalize(value: f64) -> Scaled {
    let smallest_normal = 2.2250738585072014e-308;
    if abs_f64(value) < smallest_normal {
        return Scaled { fraction: value * 4503599627370496.0, exponent: -52 };
    }
    return Scaled { fraction: value, exponent: 0 };
}

// Parts is a value taken apart into its integral and fractional parts.
pub struct Parts {
    pub whole: f64,
    pub fraction: f64,
}

// modf splits value into its integral and fractional parts, both with the
// sign of value: modf(-2.5) is -2.0 and -0.5.
fn modf_f64(value: f64) -> Parts {
    if value < 1.0 {
        if value < 0.0 {
            let parts = modf_f64(-value);
            return Parts { whole: -parts.whole, fraction: -parts.fraction };
        }
        if value == 0.0 {
            return Parts { whole: value, fraction: value };
        }
        return Parts { whole: 0.0, fraction: value };
    }
    var bits = float::bits(value);
    let e = cast<i64>((bits >> 52) & 2047) - 1023;
    // Keep the top 12 + e bits, the integral part, and clear the rest.
    if e < 52 {
        bits = bits & ~((cast<u64>(1) << cast<u64>(52 - e)) - 1);
    }
    let whole = float::from_bits(bits);
    return Parts { whole: whole, fraction: value - whole };
}

fn ln2_hi() -> f64 { return 6.93147180369123816490e-01; }

fn ln2_lo() -> f64 { return 1.90821492927058770002e-10; }

fn inv_ln2() -> f64 { return 1.44269504088896340736; }

fn inv_ln10() -> f64 { return 0.43429448190325182765; }

// ---------------------------------------------------------------------------
// Trigonometry.
//
// sin and cos are table driven: value = k pi/64 + r with |r| at most pi/128,
// sin and cos of the 128 points k pi/64 around the circle live in
// tables.kizu as double-doubles, and sin(value) = sin(k pi/64) cos(r) +
// cos(k pi/64) sin(r) needs only a short polynomial for each of cos(r) - 1
// and sin(r) - r. Within three points of a zero of the answer the point's
// value would cancel against the polynomial's, so there sin is taken
// straight from the distance to the zero. Below 2^17 the reduction
// subtracts pi/64 in 30-bit pieces the msun way, more of them when the
// subtraction cancels; above it Payne-Hanek reduction leads. tan reduces
// by pi/4 the Cephes way, as Go's math package spells it. Each answers
// within one unit in the last place.

// Arc is an angle taken apart as k pi/64 + (r + tail), k in [0, 128).
struct Arc {
    k: u64,
    r: f64,
    tail: f64,
}

// Point is sin and cos of a point k pi/64 of the circle, each as a
// double-double.
struct Point {
    sin_hi: f64,
    sin_lo: f64,
    cos_hi: f64,
    cos_lo: f64,
}

// point_of reads sin and cos of the point k pi/64 off the tables.
fn point_of(k: u64) -> Point {
    let index = cast<i64>(k & 127);
    return Point {
        sin_hi: float::from_bits(circle_sin_bits(index)),
        sin_lo: float::from_bits(circle_sin_tail_bits(index)),
        cos_hi: float::from_bits(circle_cos_bits(index)),
        cos_lo: float::from_bits(circle_cos_tail_bits(index)),
    };
}

// sin returns the sine of value in radians. An infinity gives NaN.
fn sin_f64(value: f64) -> f64 {
    if (float::bits(value) >> 52) & 0x7ff >= 0x410 {
        return sin_huge(value);
    }
    if value == 0.0 {
        // Keeps the sign of -0, which the sum in sin_near_zero would lose.
        return value;
    }
    let a = reduce_arc(value);
    return sin_at(a.k, a.r, a.tail);
}

// cos returns the cosine of value in radians. An infinity gives NaN.
fn cos_f64(value: f64) -> f64 {
    if (float::bits(value) >> 52) & 0x7ff >= 0x410 {
        return cos_huge(value);
    }
    let a = reduce_arc(value);
    return cos_at(a.k, a.r, a.tail);
}

// sin_at is the sine of the angle a.
fn sin_at(k: u64, r: f64, tail: f64) -> f64 {
    comptime if !std::target::is_native() {
        if (k + 3) & 63 < 7 {
            return sin_near_zero(k, r, tail, 0);
        }
    }
    let z = r * r;
    let z2 = z * z;
    // sin(r) - r and cos(r) - 1, each polynomial split in two so that the
    // dependency chain is short.
    let p = r * z * fma_fast(z2, -0.0001984126984126984, fma_fast(z, 0.008333333333333333, -0.16666666666666666));
    let q = z * fma_fast(z2, fma_fast(z, 2.48015873015873e-05, -0.001388888888888889), fma_fast(z, 0.041666666666666664, -0.5));
    let point = point_of(k);
    let pt = p + tail;
    // sin(c) cos(r) + cos(c) sin(r), largest terms last; q arrives last, so
    // its term is added last of the small ones.
    let small = fma_fast(point.sin_hi, q, fma_fast(point.cos_hi, pt, fma_fast(point.cos_lo, r, point.sin_lo)));
    return sum_of(point.sin_hi, point.cos_hi, r, small);
}

// cos_at is the cosine of the angle a.
fn cos_at(k: u64, r: f64, tail: f64) -> f64 {
    comptime if !std::target::is_native() {
        if (k + 3 - 32) & 63 < 7 {
            return sin_near_zero(k, r, tail, 32);
        }
    }
    let z = r * r;
    let z2 = z * z;
    // sin(r) - r and cos(r) - 1, each polynomial split in two so that the
    // dependency chain is short.
    let p = r * z * fma_fast(z2, -0.0001984126984126984, fma_fast(z, 0.008333333333333333, -0.16666666666666666));
    let q = z * fma_fast(z2, fma_fast(z, 2.48015873015873e-05, -0.001388888888888889), fma_fast(z, 0.041666666666666664, -0.5));
    let point = point_of(k);
    let pt = p + tail;
    // cos(c) cos(r) - sin(c) sin(r), largest terms last.
    let small = fma_fast(point.cos_hi, q, fma_fast(-point.sin_hi, pt, fma_fast(-point.sin_lo, r, point.cos_lo)));
    return sum_of(point.cos_hi, -point.sin_hi, r, small);
}

// SinCos is the sine and cosine of one angle.
pub struct SinCos {
    pub sin: f64,
    pub cos: f64,
}

// sin_cos returns the sine and cosine of value in radians together. The
// reduction and the table point are shared, so it costs little more than
// one of them.
fn sin_cos_f64(value: f64) -> SinCos {
    if (float::bits(value) >> 52) & 0x7ff >= 0x410 {
        if float::is_nan(value) or float::is_infinite(value) {
            return SinCos { sin: nan_f64(), cos: nan_f64() };
        }
        let a = arc_of(reduce_octant_huge(abs_f64(value)));
        var both = both_at(a.k, a.r, a.tail);
        if value < 0.0 {
            both.sin = -both.sin;
        }
        return both;
    }
    let a = reduce_arc(value);
    var both = both_at(a.k, a.r, a.tail);
    if value == 0.0 {
        both.sin = value;
    }
    return both;
}

// both_at is sin_at and cos_at of the angle a in one pass.
fn both_at(k: u64, r: f64, tail: f64) -> SinCos {
    let z = r * r;
    let z2 = z * z;
    // sin(r) - r and cos(r) - 1, each polynomial split in two so that the
    // dependency chain is short.
    let p = r * z * fma_fast(z2, -0.0001984126984126984, fma_fast(z, 0.008333333333333333, -0.16666666666666666));
    let q = z * fma_fast(z2, fma_fast(z, 2.48015873015873e-05, -0.001388888888888889), fma_fast(z, 0.041666666666666664, -0.5));
    let point = point_of(k);
    let pt = p + tail;
    let s_small = fma_fast(point.sin_hi, q, fma_fast(point.cos_hi, pt, fma_fast(point.cos_lo, r, point.sin_lo)));
    var s = point.sin_hi + fma_fast(point.cos_hi, r, s_small);
    let c_small = fma_fast(point.cos_hi, q, fma_fast(-point.sin_hi, pt, fma_fast(-point.sin_lo, r, point.cos_lo)));
    var c = point.cos_hi + fma_fast(-point.sin_hi, r, c_small);
    if (k + 3) & 63 < 7 {
        s = sin_near_zero(k, r, tail, 0);
    }
    if (k + 3 - 32) & 63 < 7 {
        c = sin_near_zero(k, r, tail, 32);
    }
    return SinCos { sin: s, cos: c };
}

// sum_of is big + m r + small, the last step of sin_at and cos_at. Within
// three points of a zero of the answer, big and m r cancel, so a rounding
// of either would be a large part of what is left. With a fused
// multiply-add the product's rounding is recovered exactly, and the sum's
// by Fast2Sum (|big| is at least |m r| wherever big is not zero), so the
// answer is rounded once; the wasm target has no such instruction and
// takes the sine of the distance to the zero instead (sin_near_zero).
fn sum_of(big: f64, m: f64, r: f64, small: f64) -> f64 {
    comptime if std::target::is_native() {
        let product = m * r;
        let product_lo = fma_fast(m, r, -product);
        let sum = big + product;
        let sum_lo = (big - sum) + product;
        return sum + ((sum_lo + product_lo) + small);
    } else {
        return big + fma_fast(m, r, small);
    }
}

// sin_near_zero is the sine of the angle a when it is within three points
// of a zero of sin: the point at zero_k (0) or the one half a turn on. For
// cos, zero_k is 32, and cos(a) = -sin(a - pi/2) is the sine measured from
// its zeros at 32 and 96. The distance t = r + d pi/64 to the zero is kept
// as a double-double, and sin(t) comes from an odd polynomial in t.
fn sin_near_zero(k: u64, r: f64, tail: f64, zero_k: u64) -> f64 {
    let shifted = (k + 3 - zero_k) & 127;
    var d = cast<i64>(shifted) - 3;
    var negative = zero_k == 32;
    if shifted >= 64 {
        d = d - 64;
        negative = !negative;
    }
    // pi/64 in 51 bits, so that d times it is exact, and the rest.
    let steps = cast<f64>(d);
    let big = steps * 0.04908738521234052;
    let t = big + r;
    let t_lo = (big - t) + r + fma_fast(steps, 1.9135106236677394e-18, tail);
    let z = t * t;
    let z2 = z * z;
    let odd = fma_fast(z2, fma_fast(z2, -2.505210838544172e-08, fma_fast(z, 2.7557319223985893e-06, -0.0001984126984126984)), fma_fast(z, 0.008333333333333333, -0.16666666666666666));
    let y = t + fma_fast(t * z, odd, t_lo);
    if negative {
        return -y;
    }
    return y;
}

// reduce_arc takes a value below 2^17 in magnitude apart as
// k pi/64 + (r + tail): k is value / (pi/64) rounded to nearest and pi/64
// is subtracted in 30-bit pieces, more of them when the subtraction
// cancels (a value close to a multiple of pi/64), so that the remainder
// keeps its full precision.
fn reduce_arc(value: f64) -> Arc {
    let shift = 6755399441055744.0;
    let kd = fma_fast(value, 20.371832715762604, shift);
    let k = float::bits(kd) & 127;
    let steps = kd - shift;
    var r = fma_fast(-steps, 0.049087385239545256, value);
    var w = steps * -2.720473654845052e-11;
    var lo = r - w;
    let exponent = cast<i64>((float::bits(value) >> 52) & 0x7ff);
    var lost = exponent - cast<i64>((float::bits(lo) >> 52) & 0x7ff);
    if lost > 16 {
        // The second piece brings pi/64 to 60 bits, the third to 90.
        var t = r;
        w = steps * -2.7204736537502286e-11;
        r = t - w;
        w = steps * -1.0948232494031031e-20 - ((t - r) - w);
        lo = r - w;
        lost = exponent - cast<i64>((float::bits(lo) >> 52) & 0x7ff);
        if lost > 46 {
            t = r;
            w = steps * -1.0948232490483806e-20;
            r = t - w;
            w = steps * -3.547224564850688e-30 - ((t - r) - w);
            lo = r - w;
        }
    }
    return Arc { k: k, r: lo, tail: (r - lo) - w };
}

// sin_huge is sin of a value at least 2^17 in magnitude, or not finite.
fn sin_huge(value: f64) -> f64 {
    if float::is_nan(value) or float::is_infinite(value) {
        return nan_f64();
    }
    let a = arc_of(reduce_octant_huge(abs_f64(value)));
    let y = sin_at(a.k, a.r, a.tail);
    if value < 0.0 {
        return -y;
    }
    return y;
}

// cos_huge is cos of a value at least 2^17 in magnitude, or not finite.
fn cos_huge(value: f64) -> f64 {
    if float::is_nan(value) or float::is_infinite(value) {
        return nan_f64();
    }
    let a = arc_of(reduce_octant_huge(abs_f64(value)));
    return cos_at(a.k, a.r, a.tail);
}

// arc_of moves an angle from octants of pi/4 to points of pi/64: the
// remainder z is at most pi/4, so it is at most 16 points from the octant.
fn arc_of(octant: Octant) -> Arc {
    let shift = 6755399441055744.0;
    let kd = octant.z * 20.371832715762604 + shift;
    let steps = kd - shift;
    let r = octant.z - steps * 0.049087385239545256;
    let w = steps * -2.720473654845052e-11;
    let lo = r - w;
    let k = cast<u64>(cast<i64>(octant.j * 16) + cast<i64>(steps)) & 127;
    return Arc { k: k, r: lo, tail: ((r - lo) - w) + octant.lo };
}

// tan returns the tangent of value in radians. An infinity gives NaN.
fn tan_f64(value: f64) -> f64 {
    if value == 0.0 or float::is_nan(value) {
        return value;
    }
    if float::is_infinite(value) {
        return nan_f64();
    }
    var sign = false;
    var x = value;
    if x < 0.0 {
        x = -x;
        sign = true;
    }
    let octant = reduce_octant(x);
    let j = octant.j;
    let z = octant.z;
    let zz = z * z;
    var y = z;
    if zz > 1e-14 {
        let p = ((-1.30936939181383777646e4 * zz) + 1.15351664838587416140e6) * zz - 1.79565251976484877988e7;
        let q = (((zz + 1.36812963470692954678e4) * zz - 1.32089234440210967447e6) * zz + 2.50083801823357915839e7) * zz - 5.38695755929454629881e7;
        y = z + z * (zz * p / q);
    }
    if j & 2 == 2 {
        y = -1.0 / y;
    }
    if sign {
        y = -y;
    }
    return y;
}

// Octant is an angle taken apart as j pi/4 + (z + lo), with j even; lo is
// the tail of z, which only the Payne-Hanek reduction fills in.
struct Octant {
    j: u64,
    z: f64,
    lo: f64,
}

// reduce_octant splits a non-negative x into the octant of x / (pi/4) and
// the remainder: below 2^29 by subtracting a three-part pi/4, above it by
// Payne-Hanek reduction. An odd octant is mapped to the even one after it
// so that the remainder is centred on zero.
fn reduce_octant(x: f64) -> Octant {
    if x >= 536870912.0 {
        return reduce_octant_huge(x);
    }
    let pi4_a = 7.85398125648498535156e-1;
    let pi4_b = 3.77489470793079817668e-8;
    let pi4_c = 2.69515142907905952645e-15;
    var j = cast<u64>(x * four_over_pi());
    var y = cast<f64>(j);
    if j & 1 == 1 {
        j = j + 1;
        y = y + 1.0;
    }
    j = j & 7;
    let z = ((x - y * pi4_a) - y * pi4_b) - y * pi4_c;
    return Octant { j: j, z: z, lo: 0.0 };
}

// reduce_octant_huge is Payne-Hanek reduction of x >= pi/4 by pi/4: the
// mantissa of x is multiplied by the digits of 4/pi that matter at x's
// exponent, in 64-bit pieces, and the integer and fractional parts are read
// off the product. From "Argument Reduction for Huge Arguments: Good to the
// Last Bit", K. C. Ng et al, 1992.
fn reduce_octant_huge(x: f64) -> Octant {
    if x < pi_over_4() {
        return Octant { j: 0, z: x, lo: 0.0 };
    }
    // x = ix * 2^exp with the hidden bit made explicit.
    var ix = float::bits(x);
    let exp = cast<i64>((ix >> 52) & 2047) - 1023 - 52;
    ix = (ix & 0x000fffffffffffff) | 0x0010000000000000;
    // The three digits of 4/pi at which the product's leading digit has
    // exponent -61; exp is at least -53 and below 971.
    let digit = cast<u64>((exp + 61) / 64);
    let bitshift = cast<u64>((exp + 61) % 64);
    let z0 = (four_over_pi_digit(digit) << bitshift) | (four_over_pi_digit(digit + 1) >> (64 - bitshift));
    let z1 = (four_over_pi_digit(digit + 1) << bitshift) | (four_over_pi_digit(digit + 2) >> (64 - bitshift));
    let z2 = (four_over_pi_digit(digit + 2) << bitshift) | (four_over_pi_digit(digit + 3) >> (64 - bitshift));
    // Multiply the mantissa by the digits and keep the upper two words.
    let z2hi = mul64_high(z2, ix);
    let z1hi = mul64_high(z1, ix);
    let z1lo = z1 * ix;
    let z0lo = z0 * ix;
    let lo = z1lo + z2hi;
    var carry = cast<u64>(0);
    if lo < z1lo {
        carry = 1;
    }
    var hi = z0lo + z1hi + carry;
    // The top 3 bits are the octant; the rest is the fraction, as a 128-bit
    // number in fhi and flo.
    var j = hi >> 61;
    var fhi = (hi << 3) | (lo >> 61);
    var flo = lo << 3;
    var negative = false;
    if j & 1 == 1 {
        // An odd octant: measure from the next even one, so that the
        // remainder is centred on zero. Negating the whole fraction here
        // keeps every bit; subtracting 1 from a float would not.
        j = (j + 1) & 7;
        flo = 0 - flo;
        fhi = 0 - fhi;
        if flo != 0 {
            fhi = fhi - 1;
        }
        negative = true;
    }
    if fhi == 0 {
        return Octant { j: j, z: 0.0, lo: 0.0 };
    }
    // Normalise the fraction into a float: the 52 bits after the leading
    // one, rounded on the bit below them.
    let lz = leading_zeros(fhi);
    var e = cast<u64>(1023) - (lz + 1);
    let rest = (fhi << (lz + 1)) | (flo >> (64 - (lz + 1)));
    var mantissa = rest >> 12;
    // The 12 bits the float drops, minus 1 when the rounding went up, as a
    // float of their own scaled 2^-64 below the leading one.
    var dropped = cast<i64>(rest & 0xfff);
    if rest & 0x800 != 0 {
        mantissa = mantissa + 1;
        dropped = dropped - 4096;
        if mantissa >> 52 == 1 {
            mantissa = 0;
            e = e + 1;
        }
    }
    var z = float::from_bits(mantissa | (e << 52));
    var z_lo = cast<f64>(dropped) * float::from_bits((e - 64) << 52);
    if negative {
        z = -z;
        z_lo = -z_lo;
    }
    // (z + z_lo) times pi/4 as a double-double: the product of the halves of
    // z and of pi/4 is exact, and pi/4's own tail beyond a float is added.
    let zh = float::from_bits(float::bits(z) & ~((cast<u64>(1) << 27) - 1));
    let zl = z - zh;
    let ph = 0.7853981554508209;
    let pl = 7.946627356147928e-9;
    let angle = z * pi_over_4();
    let tail = ((zh * ph - angle) + zh * pl + zl * ph) + zl * pl + z * 3.061616997868383e-17 + z_lo * pi_over_4();
    return Octant { j: j, z: angle, lo: tail };
}

// mul64_high returns the upper 64 bits of the 128-bit product of a and b.
fn mul64_high(a: u64, b: u64) -> u64 {
    let mask32 = cast<u64>(0xffffffff);
    let a0 = a & mask32;
    let a1 = a >> 32;
    let b0 = b & mask32;
    let b1 = b >> 32;
    let w0 = a0 * b0;
    let t = a1 * b0 + (w0 >> 32);
    var w1 = t & mask32;
    let w2 = t >> 32;
    w1 = w1 + a0 * b1;
    return a1 * b1 + w2 + (w1 >> 32);
}

// leading_zeros returns the number of leading zero bits in value, 64 for 0.
fn leading_zeros(value: u64) -> u64 {
    var count = cast<u64>(0);
    var rest = value;
    var width = cast<u64>(32);
    while width > 0 {
        if rest >> (64 - width) == 0 {
            count = count + width;
            rest = rest << width;
        }
        width = width >> 1;
    }
    if rest == 0 {
        return 64;
    }
    return count;
}

// four_over_pi_digit returns the index-th 64-bit digit of 4/pi, so that
// 4/pi is the sum of digit(i) * 2^(-64 i): 19 digits and the leading one
// give 1217 bits, enough for the largest float exponent.
fn four_over_pi_digit(index: u64) -> u64 {
    if index == 0 { return 0x0000000000000001; }
    if index == 1 { return word64(0x45f306dc, 0x9c882a53); }
    if index == 2 { return word64(0xf84eafa3, 0xea69bb81); }
    if index == 3 { return word64(0xb6c52b32, 0x78872083); }
    if index == 4 { return word64(0xfca2c757, 0xbd778ac3); }
    if index == 5 { return word64(0x6e48dc74, 0x849ba5c0); }
    if index == 6 { return word64(0x0c925dd4, 0x13a32439); }
    if index == 7 { return word64(0xfc3bd639, 0x62534e7d); }
    if index == 8 { return word64(0xd1046bea, 0x5d768909); }
    if index == 9 { return word64(0xd338e04d, 0x68befc82); }
    if index == 10 { return word64(0x7323ac73, 0x06a673e9); }
    if index == 11 { return word64(0x3908bf17, 0x7bf25076); }
    if index == 12 { return word64(0x3ff12fff, 0xbc0b301f); }
    if index == 13 { return word64(0xde5e2316, 0xb414da3e); }
    if index == 14 { return word64(0xda6cfd9e, 0x4f96136e); }
    if index == 15 { return word64(0x9e8c7ecd, 0x3cbfd45a); }
    if index == 16 { return word64(0xea4f758f, 0xd7cbe2f6); }
    if index == 17 { return word64(0x7a0e73ef, 0x14a525d4); }
    if index == 18 { return word64(0xd7f6bf62, 0x3f1aba10); }
    if index == 19 { return word64(0xac06608d, 0xf8f6d757); }
    return 0;
}

// word64 joins two 32-bit halves, since a literal cannot exceed the i64
// range.
fn word64(high: u64, low: u64) -> u64 {
    return (high << 32) | low;
}

// asin returns the arc sine of value, in [-pi/2, pi/2]. A value outside
// [-1, 1] gives NaN.
fn asin_f64(value: f64) -> f64 {
    if value == 0.0 {
        return value;
    }
    var sign = false;
    var x = value;
    if x < 0.0 {
        x = -x;
        sign = true;
    }
    if x > 1.0 {
        return nan_f64();
    }
    var temp = sqrt_f64(1.0 - x * x);
    if x > 0.7 {
        temp = pi_over_2() - atan_positive(temp / x);
    } else {
        temp = atan_positive(x / temp);
    }
    if sign {
        temp = -temp;
    }
    return temp;
}

// acos returns the arc cosine of value, in [0, pi]. A value outside [-1, 1]
// gives NaN.
fn acos_f64(value: f64) -> f64 {
    return pi_over_2() - asin_f64(value);
}

// atan returns the arc tangent of value, in [-pi/2, pi/2].
fn atan_f64(value: f64) -> f64 {
    if value == 0.0 {
        return value;
    }
    if value > 0.0 {
        return atan_positive(value);
    }
    return -atan_positive(-value);
}

// atan2 returns the angle of the point (x, y) from the positive x axis, in
// (-pi, pi], with the quadrant chosen from the signs of both arguments:
// atan2(1, -1) is 3pi/4 where atan(1 / -1) is -pi/4.
fn atan2_f64(y: f64, x: f64) -> f64 {
    if float::is_nan(y) or float::is_nan(x) {
        return nan_f64();
    }
    if y == 0.0 {
        if x >= 0.0 and !is_negative_f64(x) {
            return copysign_f64(0.0, y);
        }
        return copysign_f64(pi_f64(), y);
    }
    if x == 0.0 {
        return copysign_f64(pi_over_2(), y);
    }
    if float::is_infinite(x) {
        if x == infinity_f64() {
            if float::is_infinite(y) {
                return copysign_f64(pi_over_4(), y);
            }
            return copysign_f64(0.0, y);
        }
        if float::is_infinite(y) {
            return copysign_f64(three_pi_over_4(), y);
        }
        return copysign_f64(pi_f64(), y);
    }
    if float::is_infinite(y) {
        return copysign_f64(pi_over_2(), y);
    }
    let q = atan_f64(y / x);
    if x < 0.0 {
        if q <= 0.0 {
            return q + pi_f64();
        }
        return q - pi_f64();
    }
    return q;
}

// atan_positive is the arc tangent of a positive value, the Cephes `satan`:
// the argument is folded into [0, 0.66] where the rational approximation
// holds.
fn atan_positive(x: f64) -> f64 {
    let more_bits = 6.123233995736765886130e-17;
    let tan_3pi_over_8 = 2.41421356237309504880;
    // Three ranges, each a different argument to atan_reduced and a
    // different base angle; the arguments are all computed and one is
    // selected, since a branch on the range is unpredictable on random
    // input. atan_reduced is odd, so pi/2 - atan(1/x) is pi/2 + atan(-1/x).
    var argument = x;
    var base = 0.0;
    var extra = 0.0;
    if x > 0.66 {
        argument = (x - 1.0) / (x + 1.0);
        base = pi_over_4();
        extra = 0.5 * more_bits;
    }
    if x > tan_3pi_over_8 {
        argument = -1.0 / x;
        base = pi_over_2();
        extra = more_bits;
    }
    return base + atan_reduced(argument) + extra;
}

// atan_reduced is the arc tangent of x in [0, 0.66], the Cephes `xatan`.
fn atan_reduced(x: f64) -> f64 {
    let p0 = -8.750608600031904122785e-01;
    let p1 = -1.615753718733365076637e+01;
    let p2 = -7.500855792314704667340e+01;
    let p3 = -1.228866684490136173410e+02;
    let p4 = -6.485021904942025371773e+01;
    let q0 = 2.485846490142306297962e+01;
    let q1 = 1.650270098316988542046e+02;
    let q2 = 4.328810604912902668951e+02;
    let q3 = 4.853903996359136964868e+02;
    let q4 = 1.945506571482613964425e+02;
    var z = x * x;
    z = z * ((((p0 * z + p1) * z + p2) * z + p3) * z + p4) / (((((z + q0) * z + q1) * z + q2) * z + q3) * z + q4);
    z = x * z + x;
    return z;
}

fn four_over_pi() -> f64 { return 1.27323954473516268615107010698011489627567716592365; }

fn pi_over_4() -> f64 { return 0.78539816339744830961566084581987572104929234984378; }

fn pi_over_2() -> f64 { return 1.57079632679489661923132169163975144209858469968755; }

fn three_pi_over_4() -> f64 { return 2.35619449019234492884698253745962716314787704953133; }

// ---------------------------------------------------------------------------
// Hyperbolics, the cube root, round-to-even and the fused multiply-add.

// sinh returns the hyperbolic sine of value.
fn sinh_f64(value: f64) -> f64 {
    let p0 = -0.6307673640497716991184787251e+6;
    let p1 = -0.8991272022039509355398013511e+5;
    let p2 = -0.2894211355989563807284660366e+4;
    let p3 = -0.2630563213397497062819489e+2;
    let q0 = -0.6307673640497716991212077277e+6;
    let q1 = 0.1521517378790019070696485176e+5;
    let q2 = -0.173678953558233699533450911e+3;
    var sign = false;
    var x = value;
    if x < 0.0 {
        x = -x;
        sign = true;
    }
    var temp = 0.0;
    if x > 21.0 {
        temp = exp_f64(x) * 0.5;
    } else {
        if x > 0.5 {
            let ex = exp_f64(x);
            temp = (ex - 1.0 / ex) * 0.5;
        } else {
            let sq = x * x;
            temp = (((p3 * sq + p2) * sq + p1) * sq + p0) * x;
            temp = temp / (((sq + q2) * sq + q1) * sq + q0);
        }
    }
    if sign {
        temp = -temp;
    }
    return temp;
}

// cosh returns the hyperbolic cosine of value.
fn cosh_f64(value: f64) -> f64 {
    let x = abs_f64(value);
    if x > 21.0 {
        return exp_f64(x) * 0.5;
    }
    let ex = exp_f64(x);
    return (ex + 1.0 / ex) * 0.5;
}

// tanh returns the hyperbolic tangent of value, in [-1, 1].
fn tanh_f64(value: f64) -> f64 {
    let max_log = 8.8029691931113054295988e+01;
    let p0 = -9.64399179425052238628e-1;
    let p1 = -9.92877231001918586564e1;
    let p2 = -1.61468768441708447952e3;
    let q0 = 1.12811678491632931402e2;
    let q1 = 2.23548839060100448583e3;
    let q2 = 4.84406305325125486048e3;
    let z = abs_f64(value);
    if z > 0.5 * max_log {
        if value < 0.0 {
            return -1.0;
        }
        return 1.0;
    }
    if value == 0.0 {
        return value;
    }
    // Both the rational form (below 0.625) and the exp form are evaluated
    // and one is selected, since a branch on the magnitude is unpredictable
    // on random input and costs more than the spare evaluation.
    let s = value * value;
    let rational = value + value * s * ((p0 * s + p1) * s + p2) / (((s + q0) * s + q1) * s + q2);
    let e = exp_f64(2.0 * z);
    var big = 1.0 - 2.0 / (e + 1.0);
    if value < 0.0 {
        big = -big;
    }
    if z >= 0.625 {
        return big;
    }
    return rational;
}

// asinh returns the inverse hyperbolic sine of value.
fn asinh_f64(value: f64) -> f64 {
    let ln2 = 6.93147180559945286227e-01;
    let near_zero = 3.7252902984619140625e-9;
    let large = 268435456.0;
    if float::is_nan(value) or float::is_infinite(value) {
        return value;
    }
    var sign = false;
    var x = value;
    if x < 0.0 {
        x = -x;
        sign = true;
    }
    var temp = 0.0;
    if x > large {
        temp = log_f64(x) + ln2;
    } else {
        if x > 2.0 {
            temp = log_f64(2.0 * x + 1.0 / (sqrt_f64(x * x + 1.0) + x));
        } else {
            if x < near_zero {
                temp = x;
            } else {
                temp = log1p_f64(x + x * x / (1.0 + sqrt_f64(1.0 + x * x)));
            }
        }
    }
    if sign {
        temp = -temp;
    }
    return temp;
}

// acosh returns the inverse hyperbolic cosine of value. A value below 1
// gives NaN.
fn acosh_f64(value: f64) -> f64 {
    let ln2 = 6.93147180559945286227e-01;
    let large = 268435456.0;
    if value < 1.0 or float::is_nan(value) {
        return nan_f64();
    }
    if value == 1.0 {
        return 0.0;
    }
    if value >= large {
        return log_f64(value) + ln2;
    }
    if value > 2.0 {
        return log_f64(2.0 * value - 1.0 / (value + sqrt_f64(value * value - 1.0)));
    }
    let t = value - 1.0;
    return log1p_f64(t + sqrt_f64(2.0 * t + t * t));
}

// atanh returns the inverse hyperbolic tangent of value. A value outside
// [-1, 1] gives NaN and the ends give the infinities.
fn atanh_f64(value: f64) -> f64 {
    let near_zero = 3.7252902984619140625e-9;
    if value < -1.0 or value > 1.0 or float::is_nan(value) {
        return nan_f64();
    }
    if value == 1.0 {
        return infinity_f64();
    }
    if value == -1.0 {
        return -infinity_f64();
    }
    var sign = false;
    var x = value;
    if x < 0.0 {
        x = -x;
        sign = true;
    }
    var temp = 0.0;
    if x < near_zero {
        temp = x;
    } else {
        if x < 0.5 {
            temp = x + x;
            temp = 0.5 * log1p_f64(temp + temp * x / (1.0 - x));
        } else {
            temp = 0.5 * log1p_f64((x + x) / (1.0 - x));
        }
    }
    if sign {
        temp = -temp;
    }
    return temp;
}

// cbrt returns the cube root of value, with the sign of value: cbrt(-8.0)
// is -2.0. The FreeBSD msun algorithm: a rough root from the bits, a
// rational refinement, and one Newton step.
fn cbrt_f64(value: f64) -> f64 {
    let b1 = cast<u64>(715094163);
    let b2 = cast<u64>(696219795);
    let c = 5.42857142857142815906e-01;
    let d = -7.05306122448979611050e-01;
    let e = 1.41428571428571436819e+00;
    let f = 1.60714285714285720630e+00;
    let g = 3.57142857142857150787e-01;
    let smallest_normal = 2.22507385850720138309e-308;
    if value == 0.0 or float::is_nan(value) or float::is_infinite(value) {
        return value;
    }
    var sign = false;
    var x = value;
    if x < 0.0 {
        x = -x;
        sign = true;
    }
    // A root good to 5 bits, straight from the exponent.
    var t = float::from_bits(float::bits(x) / 3 + (b1 << 32));
    if x < smallest_normal {
        t = 18014398509481984.0 * x;
        t = float::from_bits(float::bits(t) / 3 + (b2 << 32));
    }
    // To 23 bits.
    var r = t * t / x;
    var s = c + r * t;
    t = t * (g + f / (s + e + d / s));
    // Chop to 22 bits, made larger than the root.
    t = float::from_bits((float::bits(t) & (cast<u64>(0xFFFFFFFFC) << 28)) + (cast<u64>(1) << 30));
    // One Newton step to 53 bits, within 0.667 ulp.
    s = t * t;
    r = x / s;
    let w = t + t;
    r = (r - t) / (w + r);
    t = t + t * r;
    if sign {
        t = -t;
    }
    return t;
}

// round_even returns the integral value nearest to value, with halves
// rounded to the even neighbour: round_even(0.5) is 0.0 and
// round_even(1.5) is 2.0.
fn round_even_f64(value: f64) -> f64 {
    var bits = float::bits(value);
    let e = (bits >> 52) & 2047;
    if e >= 1023 {
        // |value| >= 1: add just under a half, or a half when the integral
        // part is odd, then drop the fraction. Past 2^52, infinity and NaN
        // have no fraction bits and pass through.
        let half_minus_ulp = (cast<u64>(1) << 51) - 1;
        let shift = e - 1023;
        bits = bits + ((half_minus_ulp + ((bits >> (52 - shift)) & 1)) >> shift);
        bits = bits & ~(fraction_mask() >> shift);
        return float::from_bits(bits);
    }
    if e == 1022 and bits & fraction_mask() != 0 {
        // 0.5 < |value| < 1 rounds to +-1.
        return float::from_bits((bits & sign_bit()) | (cast<u64>(1023) << 52));
    }
    // |value| <= 0.5, subnormals included, rounds to +-0.
    return float::from_bits(bits & sign_bit());
}

fn fraction_mask() -> u64 { return (cast<u64>(1) << 52) - 1; }

// fma returns x * y + z with one rounding, where x * y + z written out
// rounds twice: fma(0.1, 10.0, -1.0) is the error of 0.1 * 10.0, which the
// plain expression loses. The product is formed exactly as 128 bits, z is
// aligned to it with the bits shifted out compressed into a sticky bit, and
// the sum is rounded once to the nearest even. From Go's math.FMA.
fn fma_f64(x: f64, y: f64, z: f64) -> f64 {
    let bx = float::bits(x);
    let by = float::bits(y);
    let bz = float::bits(z);
    let inf = exponent_mask();
    // A zero, an infinity or a NaN among x and y: x * y + z rounds once.
    if x == 0.0 or y == 0.0 or z == 0.0 or bx & inf == inf or by & inf == inf {
        return x * y + z;
    }
    // A finite product plus an infinite or NaN z is z.
    if bz & inf == inf {
        return z;
    }
    let xp = fma_split(bx);
    let yp = fma_split(by);
    let zp = fma_split(bz);
    // The product: sign, exponent and a two-word mantissa, the 106-bit
    // product shifted left by 21 so that its top bit is bit 62 or 63.
    var ps = xp.sign ^ yp.sign;
    var pe = xp.exponent + yp.exponent - 1023 + 1;
    let xm = xp.mantissa << 10;
    let ym = yp.mantissa << 11;
    var pm1 = mul64_high(xm, ym);
    var pm2 = xm * ym;
    var zs = zp.sign;
    var ze = zp.exponent;
    var zm1 = zp.mantissa << 10;
    var zm2 = cast<u64>(0);
    // Normalize the product to bit 62.
    let is62zero = (~pm1 >> 62) & 1;
    let shifted = shl128(pm1, pm2, is62zero);
    pm1 = shifted.high;
    pm2 = shifted.low;
    pe = pe - cast<i64>(is62zero);
    // Add the smaller magnitude to the larger.
    if pe < ze or (pe == ze and pm1 < zm1) {
        let ts = ps;
        let te = pe;
        let t1 = pm1;
        let t2 = pm2;
        ps = zs;
        pe = ze;
        pm1 = zm1;
        pm2 = zm2;
        zs = ts;
        ze = te;
        zm1 = t1;
        zm2 = t2;
    }
    // p == -z is +0, since neither operand is zero.
    if ps != zs and pe == ze and pm1 == zm1 and pm2 == zm2 {
        return 0.0;
    }
    // Align z to the product.
    let aligned = shr128_sticky(zm1, zm2, cast<u64>(pe - ze));
    zm1 = aligned.high;
    zm2 = aligned.low;
    var m = cast<u64>(0);
    if ps == zs {
        // (pm1:pm2) + (zm1:zm2)
        let low = pm2 + zm2;
        var carry = cast<u64>(0);
        if low < pm2 {
            carry = 1;
        }
        pm2 = low;
        pm1 = pm1 + zm1 + carry;
        pe = pe - cast<i64>(~pm1 >> 63);
        let compressed = shr128_sticky(pm1, pm2, 64 + (pm1 >> 63));
        pm1 = compressed.high;
        m = compressed.low;
    } else {
        // (pm1:pm2) - (zm1:zm2)
        let low = pm2 - zm2;
        var borrow = cast<u64>(0);
        if pm2 < zm2 {
            borrow = 1;
        }
        pm2 = low;
        pm1 = pm1 - zm1 - borrow;
        var nz = leading_zeros(pm1);
        if nz == 64 {
            nz = nz + leading_zeros(pm2);
        }
        pe = pe - cast<i64>(nz);
        let shifted2 = shl128(pm1, pm2, nz - 1);
        m = shifted2.high;
        pm2 = shifted2.low;
        if pm2 != 0 {
            m = m | 1;
        }
    }
    // Round to nearest even; a result past the exponent range is infinity.
    if pe > 1022 + 1023 or (pe == 1022 + 1023 and ((m + (cast<u64>(1) << 9)) >> 63) == 1) {
        return float::from_bits((ps << 63) | inf);
    }
    if pe < 0 {
        let n = cast<u64>(-pe);
        var sticky = cast<u64>(0);
        if m & ((cast<u64>(1) << n) - 1) != 0 {
            sticky = 1;
        }
        m = (m >> n) | sticky;
        pe = 0;
    }
    let rounded = (m + (cast<u64>(1) << 9)) >> 10;
    // A tie, with the rounding bit set and nothing below it, goes to even.
    if (m & ((cast<u64>(1) << 10) - 1)) == (cast<u64>(1) << 9) {
        m = rounded & ~cast<u64>(1);
    } else {
        m = rounded;
    }
    if m == 0 {
        pe = 0;
    }
    return float::from_bits((ps << 63) + (cast<u64>(pe) << 52) + m);
}

// FmaPart is one operand of fma taken apart: its sign bit, its biased
// exponent, and its mantissa with the hidden bit made explicit and a
// subnormal shifted up to normal.
struct FmaPart {
    sign: u64,
    exponent: i64,
    mantissa: u64,
}

fn fma_split(bits: u64) -> FmaPart {
    let sign = bits >> 63;
    var exponent = cast<i64>((bits >> 52) & 2047);
    var mantissa = bits & fraction_mask();
    if exponent == 0 {
        let shift = leading_zeros(mantissa) - 11;
        mantissa = mantissa << shift;
        exponent = 1 - cast<i64>(shift);
    } else {
        mantissa = mantissa | (cast<u64>(1) << 52);
    }
    return FmaPart { sign: sign, exponent: exponent, mantissa: mantissa };
}

// Words is a 128-bit value as two 64-bit words.
struct Words {
    high: u64,
    low: u64,
}

// shl128 shifts a two-word value left by n, for any n below 128.
fn shl128(high: u64, low: u64, n: u64) -> Words {
    return Words {
        high: (high << n) | (low >> (64 - n)) | (low << (n - 64)),
        low: low << n,
    };
}

// shr128 shifts a two-word value right by n, for any n below 128.
fn shr128(high: u64, low: u64, n: u64) -> Words {
    return Words {
        high: high >> n,
        low: (low >> n) | (high << (64 - n)) | (high >> (n - 64)),
    };
}

// shr128_sticky shifts a two-word value right by n and folds every bit
// shifted out into the lowest bit of the result, so that rounding still
// sees whether anything was below it.
fn shr128_sticky(high: u64, low: u64, n: u64) -> Words {
    if n == 0 {
        return Words { high: high, low: low };
    }
    if n == 64 {
        var sticky = cast<u64>(0);
        if low != 0 {
            sticky = 1;
        }
        return Words { high: 0, low: high | sticky };
    }
    if n >= 128 {
        var sticky = cast<u64>(0);
        if high | low != 0 {
            sticky = 1;
        }
        return Words { high: 0, low: sticky };
    }
    let shifted = shr128(high, low, n);
    var dropped = cast<u64>(0);
    if n < 64 {
        dropped = low & ((cast<u64>(1) << n) - 1);
    } else {
        dropped = (high & ((cast<u64>(1) << (n - 64)) - 1)) | low;
    }
    var sticky = cast<u64>(0);
    if dropped != 0 {
        sticky = 1;
    }
    return Words { high: shifted.high, low: shifted.low | sticky };
}

// ---------------------------------------------------------------------------
// The public functions. Each takes the float type as its static argument,
// `math::sin<f64>(x)` or `math::sin<f32>(x)`, and any other type is a type
// error in its body. An f32 is computed in f64 and rounded once on the way
// back: sqrt, floor, ceil, trunc, round, round_even and fma come out
// correctly rounded that way, since 53 bits are more than 2 * 24 + 2, and
// the rest are within one unit in the last place of f64 before the last
// rounding. frexp and modf hand back f64 parts whatever T is; an f32 fits
// them exactly.

pub fn sqrt<T>(value: T) -> T {
    comptime if T == type<f32> {
        return cast<f32>(sqrt_f64(cast<f64>(value)));
    } else {
        return sqrt_f64(value);
    }
}

pub fn floor<T>(value: T) -> T {
    comptime if T == type<f32> {
        return cast<f32>(floor_f64(cast<f64>(value)));
    } else {
        return floor_f64(value);
    }
}

