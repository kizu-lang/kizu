// sin_with, cos_with, exp_with, log_with and pow_with are the functions at
// f64 with the kernels' products and sums rounded once (fused = true) or in
// turn (false, which is what `sin<f64>` and the others are). Either answers
// the same bits on every target; fused is faster on native, where it is one
// instruction, and much slower elsewhere.
pub fn sin_with<fused: bool>(value: f64) -> f64 {
    return sin_on<fused>(value);
}

pub fn cos_with<fused: bool>(value: f64) -> f64 {
    return cos_on<fused>(value);
}

pub fn exp_with<fused: bool>(value: f64) -> f64 {
    return exp_on<fused>(value);
}

pub fn log_with<fused: bool>(value: f64) -> f64 {
    return log_on<fused>(value);
}

pub fn pow_with<fused: bool>(base: f64, exponent: f64) -> f64 {
    return pow_on<fused>(base, exponent);
}

