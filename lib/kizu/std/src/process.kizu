pub error Error {
    InvalidArgumentCount,
    MissingExecutable,
    OutOfMemory,
    ArgIndexOutOfBounds,
    InvalidEnvName,
    EnvNotFound,
}

pub fn arg_count() -> i64 {
    return std::internal::builtin::process_arg_count();
}

pub fn arg(index: i64) -> std::process::Error![]u8 {
    let value = try std::internal::builtin::process_arg(index);
    return value;
}

pub fn env(name: []u8) -> std::process::Error![]u8 {
    let value = try std::internal::builtin::process_env(name);
    return value;
}

pub fn env_or_empty(name: []u8) -> []u8 {
    return std::internal::builtin::process_env_or_empty(name);
}

pub fn monotonic_millis() -> i64 {
    return std::internal::builtin::process_monotonic_millis();
}

pub fn spawn_wait8(
    argc: i64,
    arg0: &[]u8,
    arg1: &[]u8,
    arg2: &[]u8,
    arg3: &[]u8,
    arg4: &[]u8,
    arg5: &[]u8,
    arg6: &[]u8,
    arg7: &[]u8
) -> std::process::Error!i64 {
    return try std::internal::builtin::process_spawn_wait8(
        argc,
        arg0,
        arg1,
        arg2,
        arg3,
        arg4,
        arg5,
        arg6,
        arg7
    );
}

pub fn exit_code(code: i64) -> i64 {
    return code;
}
