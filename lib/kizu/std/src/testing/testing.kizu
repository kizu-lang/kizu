pub fn expect(condition: bool) -> void {
    if !condition {
        std::internal::builtin::test_fail("expected condition to be true");
    }
    return;
}

pub fn expect_equal<T>(expected: T, actual: T) -> void {
    if expected != actual {
        comptime if T == type<f64> {
            fail_equal_f64(expected, actual);
        } else {
            std::internal::builtin::test_fail_equal<T>(expected, actual);
        }
    }
    return;
}

// fail_equal_f64 spells both floats the way `std::float::append` does and
// stops through the same trap the other `expect_equal` shapes use. The
// text is built in a stack buffer: a test failure allocates nothing the test
// did not hand over.
fn fail_equal_f64(expected: f64, actual: f64) -> void {
    var storage = [16384]u8 {};
    let bytes = storage.as_mut_bytes();
    let allocator = std::mem::fixed_buffer(bytes);
    var message = std::string::new(allocator);
    defer message.deinit(allocator);
    message.append_bytes(allocator, "expected ") catch return fail("expected and got differ (message buffer exhausted)");
    std::float::append(allocator, &var message, expected) catch return fail("expected and got differ (message buffer exhausted)");
    message.append_bytes(allocator, ", got ") catch return fail("expected and got differ (message buffer exhausted)");
    std::float::append(allocator, &var message, actual) catch return fail("expected and got differ (message buffer exhausted)");
    let text = message.as_bytes();
    fail(text);
    return;
}

// fail reports one test failure. The message is a diagnostic: it goes to
// stderr through the same trap `expect` uses, and no error value carries it
// (ADR-0086). Like `expect`, it ends the process rather than returning a
// failure the caller could ignore.
pub fn fail(message: []u8) -> void {
    std::internal::builtin::test_fail(message);
    return;
}

// seed is the number a randomized test draws its sequence from: the one
// `kizu test --seed N` was given, or one the runtime chose for this run. Every
// failure after the first call names it, so the run that failed replays with
// the same flag (SPEC §14.5). Hand it to `std::rand::new`.
pub fn seed() -> i64 {
    return std::internal::builtin::test_seed();
}

// failing_io is the Io every operation refuses. A program's error paths only
// run when something fails, and a real Io cannot be asked to fail on demand.
pub fn failing_io() -> Io {
    return std::internal::builtin::io_failing();
}

// run_model drives a model and the system it describes through one random
// command sequence, one `step` at a time, and hands back the shortest
// sequence on which the two disagree -- or null when they agree for every
// step. The model is the plain statement of what should happen; the system
// under test is what is being checked against it.
//
// `gen` draws the next command from the rng and the model's state, `init_*`
// build a fresh model and system for every run, and `step` advances both by
// one command and answers whether they still agree. A sequence that found a
// disagreement is replayed to shrink it: the shortest failing prefix by
// bisection, then every command that can be dropped while the rest still
// fails. Each replay starts from fresh `init_*` values, so a model or a
// system that owns storage is built and released once per replay.
//
// The seed the rng came from is what replays the whole run; a test that
// draws it from `seed()` sees it named when it fails (SPEC §14.5). Commands
// are copied into the trace, so a command type has to be a copy type; one
// that owns storage is refused here.
pub fn run_model<Cmd, M, S>(
    allocator: Allocator,
    rng: &var std::rand::Rng,
    steps: i64,
    gen: fn(&var std::rand::Rng, &M) -> Cmd,
    init_model: fn(Allocator) -> !M,
    init_sut: fn(Allocator) -> !S,
    step: fn(Allocator, &var M, &var S, &Cmd) -> !bool
) -> !?std::array::Array<Cmd> {
    comptime if std::meta::is_owner<Cmd>() {
        std::meta::unsupported<Cmd>();
    } else {
    }
    var trace = std::array::new<Cmd>(allocator);
    errdefer trace.deinit(allocator);
    let found = try explore<Cmd, M, S>(allocator, rng, steps, gen, init_model, init_sut, step, &var trace);
    if !found {
        trace.deinit(allocator);
        return null;
    }
    try shrink<Cmd, M, S>(allocator, init_model, init_sut, step, &var trace);
    return move trace;
}

// explore generates and runs commands until one disagrees or `steps` have
// agreed, leaving every command run in the trace. True means a disagreement
// was found, and the trace ends with the command that found it.
fn explore<Cmd, M, S>(
    allocator: Allocator,
    rng: &var std::rand::Rng,
    steps: i64,
    gen: fn(&var std::rand::Rng, &M) -> Cmd,
    init_model: fn(Allocator) -> !M,
    init_sut: fn(Allocator) -> !S,
    step: fn(Allocator, &var M, &var S, &Cmd) -> !bool,
    trace: &var std::array::Array<Cmd>
) -> !bool {
    var model = try boxed<M>(allocator, init_model);
    errdefer model.deinit(allocator);
    var sut = try boxed<S>(allocator, init_sut);
    errdefer sut.deinit(allocator);
    var index = 0;
    while index < steps {
        let seen = model.borrow();
        let cmd = gen(rng, seen);
        try trace.append(allocator, cmd);
        let m = model.borrow_mut();
        let s = sut.borrow_mut();
        let outcome = step(allocator, m, s, &cmd);
        let agreed = try outcome;
        if !agreed {
            sut.deinit(allocator);
            model.deinit(allocator);
            return true;
        }
        index = index + 1;
    }
    sut.deinit(allocator);
    model.deinit(allocator);
    return false;
}

// replay runs the first `length` commands of the trace, skipping the one at
// `skip` (or none when skip is negative), from fresh model and system values,
// and reports whether some step disagreed.
fn replay<Cmd, M, S>(
    allocator: Allocator,
    init_model: fn(Allocator) -> !M,
    init_sut: fn(Allocator) -> !S,
    step: fn(Allocator, &var M, &var S, &Cmd) -> !bool,
    trace: &std::array::Array<Cmd>,
    length: i64,
    skip: i64
) -> !bool {
    var model = try boxed<M>(allocator, init_model);
    errdefer model.deinit(allocator);
    var sut = try boxed<S>(allocator, init_sut);
    errdefer sut.deinit(allocator);
    var index = 0;
    while index < length {
        if index != skip {
            if trace.get(index) |cmd| {
                let m = model.borrow_mut();
                let s = sut.borrow_mut();
                let outcome = step(allocator, m, s, &cmd);
                let agreed = try outcome;
                if !agreed {
                    sut.deinit(allocator);
                    model.deinit(allocator);
                    return true;
                }
            }
        }
        index = index + 1;
    }
    sut.deinit(allocator);
    model.deinit(allocator);
    return false;
}

// shrink makes a failing trace as short as replaying can prove: first the
// shortest failing prefix, found by bisection, then every command that can be
// dropped while the rest still fails, until none can.
fn shrink<Cmd, M, S>(
    allocator: Allocator,
    init_model: fn(Allocator) -> !M,
    init_sut: fn(Allocator) -> !S,
    step: fn(Allocator, &var M, &var S, &Cmd) -> !bool,
    trace: &var std::array::Array<Cmd>
) -> !void {
    var low = 1;
    var high = trace.len();
    while low < high {
        let middle = (low + high) / 2;
        if try replay<Cmd, M, S>(allocator, init_model, init_sut, step, trace, middle, -1) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    try trace.truncate(allocator, high);
    var index = 0;
    while index < trace.len() {
        if try replay<Cmd, M, S>(allocator, init_model, init_sut, step, trace, trace.len(), index) {
            let _ = try trace.remove(index);
        } else {
            index = index + 1;
        }
    }
    return;
}

// boxed builds one fresh value through `init` and places it in a Box, so a
// run can name one cleanup for a value whose type it does not know: the Box
// releases an owner payload and lets a copy payload go (ADR-0091).
fn boxed<T>(allocator: Allocator, init: fn(Allocator) -> !T) -> !std::mem::Box<T> {
    let built = try init(allocator);
    comptime if std::meta::is_owner<T>() {
        return try std::mem::box<T>(allocator, move built);
    } else {
        return try std::mem::box<T>(allocator, built);
    }
}

// check draws `cases` values from `gen` and answers the first one for which
// `holds` is false, or null when every value satisfied it. It is the
// stateless counterpart of run_model: a property of one value rather than of
// a sequence. Values are copied out, so the type has to be a copy type.
pub fn check<T>(
    rng: &var std::rand::Rng,
    cases: i64,
    gen: fn(&var std::rand::Rng) -> T,
    holds: fn(&T) -> bool
) -> ?T {
    comptime if std::meta::is_owner<T>() {
        std::meta::unsupported<T>();
    } else {
    }
    var index = 0;
    while index < cases {
        let value = gen(rng);
        if !holds(&value) {
            return value;
        }
        index = index + 1;
    }
    return null;
}
