// Random bytes come from the host: the kernel's entropy source on a native
// target, `random_get` on WASI, `crypto.getRandomValues` in a browser. The
// draw goes through an `Io`, the way every other host boundary does, so a
// program that draws randomness says so at the call and a failing Io
// refuses it like any other read. What `std::rand` gives is not this: a
// seeded sequence is the same every run, which is what a test wants and
// what a key must never be.

// Error is what drawing random bytes can fail with: the Io refusing, the
// String the bytes go to not growing, or the host's source not answering.
pub error Error {
    IoFailing,
    OutOfMemory,
    ReadFailed,
}

// random_bytes returns `count` bytes from the host's source as an owned
// String. A count of zero or less gives an empty one.
pub fn random_bytes(
    io: Io,
    allocator: Allocator,
    count: i64
) -> std::crypto::Error!std::string::String {
    var out = std::string::new(allocator);
    errdefer out.deinit(allocator);
    try std::internal::builtin::crypto_random_into(io, allocator, &var out, count);
    return move out;
}

// random_into appends `count` bytes from the host's source to a caller
// buffer. The buffer is the caller's, so the allocator that grows it is
// named the same way every other growth is (ADR-0132). On a failure the
// buffer is as it was.
pub fn random_into(
    io: Io,
    allocator: Allocator,
    out: &var std::string::String,
    count: i64
) -> std::crypto::Error!void {
    try std::internal::builtin::crypto_random_into(io, allocator, out, count);
    return;
}
