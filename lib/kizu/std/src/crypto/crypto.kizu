// std::crypto is the arithmetic a protocol's security rests on: a digest
// that names a message, a tag that proves who wrote it, and a comparison
// that does not say where two secrets first differ. Each is Kizu source,
// and nothing else: the same bytes go in and the same bytes come out on
// every target, and a wasm module that links no C hashes the way a native
// binary does. What a primitive is checked against is its published test
// vectors -- FIPS 180-4 for SHA-256, RFC 4231 for HMAC -- and, in the
// compiler's own tests, the digest another implementation computes for the
// same bytes.
//
// Nothing here draws randomness or reads a clock. What a primitive needs it
// is handed, and the caller's source says where it came from.

// Error is what the operations here can fail with. Drawing random bytes
// fails when the Io refuses (`IoFailing`), when the String the bytes go
// to cannot grow (`OutOfMemory`), or when the host's source does not
// answer (`ReadFailed`). Opening a sealed message fails with
// `AuthenticationFailed` when the tag does not match: the message was
// changed, or was not sealed under this key, nonce, and associated data,
// and which of those is not knowable and not said. A key agreement fails
// with `LowOrderPoint` when the other side's public point has low order,
// so that the shared secret would be one anybody could compute.
pub error Error {
    IoFailing,
    OutOfMemory,
    ReadFailed,
    AuthenticationFailed,
    LowOrderPoint,
}

// Failure is what opening a sealed message into a String can fail with:
// the tag, or the memory the plain bytes need.
pub error Failure = Error or std::mem::Error;

// Hash names one of the digests here, for an operation that takes the
// digest of a message and needs to know which it was: a signature is
// checked against the digest it was made over, and padded with the same
// hash.
pub enum Hash {
    Sha256,
    Sha384,
    Sha512,
}

// digest_length is how many bytes the digest of `hash` has.
pub fn digest_length(hash: Hash) -> i64 {
    return match hash {
        Sha256 => 32,
        Sha384 => 48,
        Sha512 => 64,
    };
}

// digest_of writes the digest of `bytes` under `hash` to the front of
// `digest`.
pub fn digest_of(hash: Hash, bytes: []u8, digest: &var []u8) -> void {
    match hash {
        Sha256 => sha256(bytes, digest),
        Sha384 => sha384(bytes, digest),
        Sha512 => sha512(bytes, digest),
    }
    return;
}

// equal_constant_time reports whether `a` and `b` hold the same bytes, in a
// time that depends on their length and not on where they differ. A plain
// `equal_bytes` stops at the first mismatch, and how long it took says how
// many leading bytes were right; a tag checked that way is a tag that can
// be guessed a byte at a time. Two views of different length are not equal,
// and that is decided at once: the length of a tag is not the secret.
pub fn equal_constant_time(a: []u8, b: []u8) -> bool {
    let count = std::mem::len(a);
    if count != std::mem::len(b) {
        return false;
    }
    var differ = cast<u8>(0);
    for 0..count |index| {
        differ = differ | (a[index] ^ b[index]);
    }
    return differ == 0;
}
