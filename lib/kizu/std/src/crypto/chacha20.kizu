fn chacha20_block(key: []u8, counter: i64, nonce: []u8, out: &var []u8) -> void {
    var state_buffer = [16]u32{};
    var work_buffer = [16]u32{};
    let state = state_buffer.as_mut_slice();
    let work = work_buffer.as_mut_slice();
    state[0] = 0x61707865;
    state[1] = 0x3320646e;
    state[2] = 0x79622d32;
    state[3] = 0x6b206574;
    for 0..8 |index| {
        state[4 + index] = le32(key, index * 4);
    }
    state[12] = cast<u32>(counter & 0xFFFFFFFF);
    for 0..3 |index| {
        state[13 + index] = le32(nonce, index * 4);
    }
    for 0..16 |index| {
        work[index] = state[index];
    }
    for 0..10 |_| {
        quarter_round(work, 0, 4, 8, 12);
        quarter_round(work, 1, 5, 9, 13);
        quarter_round(work, 2, 6, 10, 14);
        quarter_round(work, 3, 7, 11, 15);
        quarter_round(work, 0, 5, 10, 15);
        quarter_round(work, 1, 6, 11, 12);
        quarter_round(work, 2, 7, 8, 13);
        quarter_round(work, 3, 4, 9, 14);
    }
    for 0..16 |index| {
        set_le32(out, index, work[index] + state[index]);
    }
    return;
}

fn quarter_round(state: &var []u32, a: i64, b: i64, c: i64, d: i64) -> void {
    var xa = state[a];
    var xb = state[b];
    var xc = state[c];
    var xd = state[d];
    xa = xa + xb;
    xd = rotl(xd ^ xa, 16);
    xc = xc + xd;
    xb = rotl(xb ^ xc, 12);
    xa = xa + xb;
    xd = rotl(xd ^ xa, 8);
    xc = xc + xd;
    xb = rotl(xb ^ xc, 7);
    state[a] = xa;
    state[b] = xb;
    state[c] = xc;
    state[d] = xd;
    return;
}

fn chacha20_xor(
    allocator: Allocator,
    key: []u8,
    nonce: []u8,
    counter: i64,
    text: []u8,
    out: &var std::string::String
) -> std::mem::Error!void {
    var stream_buffer = [64]u8{};
    let end = std::mem::len(text);
    var at = 0;
    var block = counter;
    while at < end {
        var take = end - at;
        if take > 64 {
            take = 64;
        }
        let stream = stream_buffer.as_mut_bytes();
        chacha20_block(key, block, nonce, stream);
        for 0..take |index| {
            stream[index] = stream[index] ^ text[at + index];
        }
        let produced = stream[0..take];
        try out.append_bytes(allocator, produced);
        at = at + take;
        block = block + 1;
    }
    return;
}

fn rotl(x: u32, n: u32) -> u32 {
    return (x << n) | (x >> (32 - n));
}

fn le32(view: []u8, at: i64) -> u32 {
    return cast<u32>(view[at])
        | (cast<u32>(view[at + 1]) << 8)
        | (cast<u32>(view[at + 2]) << 16)
        | (cast<u32>(view[at + 3]) << 24);
}

fn set_le32(view: &var []u8, index: i64, value: u32) -> void {
    let at = index * 4;
    view[at] = cast<u8>(value & 255);
    view[at + 1] = cast<u8>((value >> 8) & 255);
    view[at + 2] = cast<u8>((value >> 16) & 255);
    view[at + 3] = cast<u8>((value >> 24) & 255);
    return;
}
