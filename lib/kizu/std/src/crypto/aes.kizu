// AES, bitsliced over 64-bit words so that no step reads memory at an
// address the key or the text chooses. Eight u64 words hold four blocks
// at once, one bit position per word; the S-box is a Boolean circuit
// over those words, the one Boyar and Peralta found (eprint 2009/191);
// ShiftRows and MixColumns are shifts and masks. A table lookup would be
// faster, and would let a neighbour on the same core read the key from
// the cache lines the lookups touched.
//
// This is a port of BearSSL's aes_ct64 (src/symcipher/aes_ct64.c and
// aes_ct64_enc.c), which is
//
//   Copyright (c) 2016 Thomas Pornin <pornin@bolet.org>
//
//   Permission is hereby granted, free of charge, to any person obtaining
//   a copy of this software and associated documentation files (the
//   "Software"), to deal in the Software without restriction, including
//   without limitation the rights to use, copy, modify, merge, publish,
//   distribute, sublicense, and/or sell copies of the Software, and to
//   permit persons to whom the Software is furnished to do so, subject to
//   the following conditions:
//
//   The above copyright notice and this permission notice shall be
//   included in all copies or substantial portions of the Software.
//
//   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
//   EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
//   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
//   NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
//   LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
//   OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
//   WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
//
// The words live in stack buffers read and written eight bytes at a
// time: `q` is the eight state words, a compressed key schedule is two
// words per round, and an expanded one is eight. Only encryption is
// here, since GCM and CTR never decrypt with the block cipher.

// mask1 through mask8 pick every fourth bit, starting at bit 0, 1, 2, 3.
fn mask1() -> u64 {
    return 0x1111111111111111;
}

fn mask2() -> u64 {
    return 0x2222222222222222;
}

fn mask4() -> u64 {
    return 0x4444444444444444;
}

fn mask8() -> u64 {
    return ~cast<u64>(0x7777777777777777);
}

// word64 reads word `index` of a table of little-endian u64.
fn word64(view: []u8, index: i64) -> u64 {
    let at = index * 8;
    return cast<u64>(view[at])
        | (cast<u64>(view[at + 1]) << 8)
        | (cast<u64>(view[at + 2]) << 16)
        | (cast<u64>(view[at + 3]) << 24)
        | (cast<u64>(view[at + 4]) << 32)
        | (cast<u64>(view[at + 5]) << 40)
        | (cast<u64>(view[at + 6]) << 48)
        | (cast<u64>(view[at + 7]) << 56);
}

// set_word64 writes word `index` of a table of little-endian u64.
fn set_word64(view: &var []u8, index: i64, value: u64) -> void {
    let at = index * 8;
    for 0..8 |offset| {
        let shift = cast<u64>(offset * 8);
        view[at + offset] = cast<u8>((value >> shift) & 255);
    }
    return;
}

// bitslice_sbox applies the S-box to the four blocks in `q`. Variables
// x* (input) and s* (output) are numbered high bit first, as in the
// circuit's description.
fn bitslice_sbox(q: &var []u8) -> void {
    let x0 = word64(q, 7);
    let x1 = word64(q, 6);
    let x2 = word64(q, 5);
    let x3 = word64(q, 4);
    let x4 = word64(q, 3);
    let x5 = word64(q, 2);
    let x6 = word64(q, 1);
    let x7 = word64(q, 0);

    // Top linear transformation.
    let y14 = x3 ^ x5;
    let y13 = x0 ^ x6;
    let y9 = x0 ^ x3;
    let y8 = x0 ^ x5;
    let t0 = x1 ^ x2;
    let y1 = t0 ^ x7;
    let y4 = y1 ^ x3;
    let y12 = y13 ^ y14;
    let y2 = y1 ^ x0;
    let y5 = y1 ^ x6;
    let y3 = y5 ^ y8;
    let t1 = x4 ^ y12;
    let y15 = t1 ^ x5;
    let y20 = t1 ^ x1;
    let y6 = y15 ^ x7;
    let y10 = y15 ^ t0;
    let y11 = y20 ^ y9;
    let y7 = x7 ^ y11;
    let y17 = y10 ^ y11;
    let y19 = y10 ^ y8;
    let y16 = t0 ^ y11;
    let y21 = y13 ^ y16;
    let y18 = x0 ^ y16;

    // Non-linear section.
    let t2 = y12 & y15;
    let t3 = y3 & y6;
    let t4 = t3 ^ t2;
    let t5 = y4 & x7;
    let t6 = t5 ^ t2;
    let t7 = y13 & y16;
    let t8 = y5 & y1;
    let t9 = t8 ^ t7;
    let t10 = y2 & y7;
    let t11 = t10 ^ t7;
    let t12 = y9 & y11;
    let t13 = y14 & y17;
    let t14 = t13 ^ t12;
    let t15 = y8 & y10;
    let t16 = t15 ^ t12;
    let t17 = t4 ^ t14;
    let t18 = t6 ^ t16;
    let t19 = t9 ^ t14;
    let t20 = t11 ^ t16;
    let t21 = t17 ^ y20;
    let t22 = t18 ^ y19;
    let t23 = t19 ^ y21;
    let t24 = t20 ^ y18;
    let t25 = t21 ^ t22;
    let t26 = t21 & t23;
    let t27 = t24 ^ t26;
    let t28 = t25 & t27;
    let t29 = t28 ^ t22;
    let t30 = t23 ^ t24;
    let t31 = t22 ^ t26;
    let t32 = t31 & t30;
    let t33 = t32 ^ t24;
    let t34 = t23 ^ t33;
    let t35 = t27 ^ t33;
    let t36 = t24 & t35;
    let t37 = t36 ^ t34;
    let t38 = t27 ^ t36;
    let t39 = t29 & t38;
    let t40 = t25 ^ t39;
    let t41 = t40 ^ t37;
    let t42 = t29 ^ t33;
    let t43 = t29 ^ t40;
    let t44 = t33 ^ t37;
    let t45 = t42 ^ t41;
    let z0 = t44 & y15;
    let z1 = t37 & y6;
    let z2 = t33 & x7;
    let z3 = t43 & y16;
    let z4 = t40 & y1;
    let z5 = t29 & y7;
    let z6 = t42 & y11;
    let z7 = t45 & y17;
    let z8 = t41 & y10;
    let z9 = t44 & y12;
    let z10 = t37 & y3;
    let z11 = t33 & y4;
    let z12 = t43 & y13;
    let z13 = t40 & y5;
    let z14 = t29 & y2;
    let z15 = t42 & y9;
    let z16 = t45 & y14;
    let z17 = t41 & y8;

    // Bottom linear transformation.
    let t46 = z15 ^ z16;
    let t47 = z10 ^ z11;
    let t48 = z5 ^ z13;
    let t49 = z9 ^ z10;
    let t50 = z2 ^ z12;
    let t51 = z2 ^ z5;
    let t52 = z7 ^ z8;
    let t53 = z0 ^ z3;
    let t54 = z6 ^ z7;
    let t55 = z16 ^ z17;
    let t56 = z12 ^ t48;
    let t57 = t50 ^ t53;
    let t58 = z4 ^ t46;
    let t59 = z3 ^ t54;
    let t60 = t46 ^ t57;
    let t61 = z14 ^ t57;
    let t62 = t52 ^ t58;
    let t63 = t49 ^ t58;
    let t64 = z4 ^ t59;
    let t65 = t61 ^ t62;
    let t66 = z1 ^ t63;
    let s0 = t59 ^ t63;
    let s6 = t56 ^ ~t62;
    let s7 = t48 ^ ~t60;
    let t67 = t64 ^ t65;
    let s3 = t53 ^ t66;
    let s4 = t51 ^ t66;
    let s5 = t47 ^ t65;
    let s1 = t64 ^ ~s3;
    let s2 = t55 ^ ~t67;

    set_word64(q, 7, s0);
    set_word64(q, 6, s1);
    set_word64(q, 5, s2);
    set_word64(q, 4, s3);
    set_word64(q, 3, s4);
    set_word64(q, 2, s5);
    set_word64(q, 1, s6);
    set_word64(q, 0, s7);
    return;
}

// swap_bits exchanges the bit groups `cl` selects in word `i` with the
// complementary groups in word `j`, `s` bits apart: one step of the
// transposition between byte order and bit-plane order.
fn swap_bits(q: &var []u8, i: i64, j: i64, cl: u64, s: u64) -> void {
    let a = word64(q, i);
    let b = word64(q, j);
    let ch = ~cl;
    set_word64(q, i, (a & cl) | ((b & cl) << s));
    set_word64(q, j, ((a & ch) >> s) | (b & ch));
    return;
}

// ortho transposes the eight words between the byte order interleave_in
// leaves and the bit-plane order the S-box wants; it is its own inverse.
fn ortho(q: &var []u8) -> void {
    swap_bits(q, 0, 1, 0x5555555555555555, 1);
    swap_bits(q, 2, 3, 0x5555555555555555, 1);
    swap_bits(q, 4, 5, 0x5555555555555555, 1);
    swap_bits(q, 6, 7, 0x5555555555555555, 1);
    swap_bits(q, 0, 2, 0x3333333333333333, 2);
    swap_bits(q, 1, 3, 0x3333333333333333, 2);
    swap_bits(q, 4, 6, 0x3333333333333333, 2);
    swap_bits(q, 5, 7, 0x3333333333333333, 2);
    swap_bits(q, 0, 4, 0x0F0F0F0F0F0F0F0F, 4);
    swap_bits(q, 1, 5, 0x0F0F0F0F0F0F0F0F, 4);
    swap_bits(q, 2, 6, 0x0F0F0F0F0F0F0F0F, 4);
    swap_bits(q, 3, 7, 0x0F0F0F0F0F0F0F0F, 4);
    return;
}

// interleave_in spreads the four little-endian words of one block at
// byte `at` of `w` over words `i0` and `i1` of `q`.
fn interleave_in(q: &var []u8, i0: i64, i1: i64, w: []u8, at: i64) -> void {
    var x0 = cast<u64>(std::crypto::le32(w, at));
    var x1 = cast<u64>(std::crypto::le32(w, at + 4));
    var x2 = cast<u64>(std::crypto::le32(w, at + 8));
    var x3 = cast<u64>(std::crypto::le32(w, at + 12));
    x0 = x0 | (x0 << 16);
    x1 = x1 | (x1 << 16);
    x2 = x2 | (x2 << 16);
    x3 = x3 | (x3 << 16);
    x0 = x0 & 0x0000FFFF0000FFFF;
    x1 = x1 & 0x0000FFFF0000FFFF;
    x2 = x2 & 0x0000FFFF0000FFFF;
    x3 = x3 & 0x0000FFFF0000FFFF;
    x0 = x0 | (x0 << 8);
    x1 = x1 | (x1 << 8);
    x2 = x2 | (x2 << 8);
    x3 = x3 | (x3 << 8);
    x0 = x0 & 0x00FF00FF00FF00FF;
    x1 = x1 & 0x00FF00FF00FF00FF;
    x2 = x2 & 0x00FF00FF00FF00FF;
    x3 = x3 & 0x00FF00FF00FF00FF;
    set_word64(q, i0, x0 | (x2 << 8));
    set_word64(q, i1, x1 | (x3 << 8));
    return;
}

// interleave_out gathers one block back from two state words into the
// four little-endian words starting at word `index` of `w`.
fn interleave_out(w: &var []u8, index: i64, q0: u64, q1: u64) -> void {
    var x0 = q0 & 0x00FF00FF00FF00FF;
    var x1 = q1 & 0x00FF00FF00FF00FF;
    var x2 = (q0 >> 8) & 0x00FF00FF00FF00FF;
    var x3 = (q1 >> 8) & 0x00FF00FF00FF00FF;
    x0 = x0 | (x0 >> 8);
    x1 = x1 | (x1 >> 8);
    x2 = x2 | (x2 >> 8);
    x3 = x3 | (x3 >> 8);
    x0 = x0 & 0x0000FFFF0000FFFF;
    x1 = x1 & 0x0000FFFF0000FFFF;
    x2 = x2 & 0x0000FFFF0000FFFF;
    x3 = x3 & 0x0000FFFF0000FFFF;
    std::crypto::set_le32(w, index, cast<u32>((x0 | (x0 >> 16)) & 0xFFFFFFFF));
    std::crypto::set_le32(w, index + 1, cast<u32>((x1 | (x1 >> 16)) & 0xFFFFFFFF));
    std::crypto::set_le32(w, index + 2, cast<u32>((x2 | (x2 >> 16)) & 0xFFFFFFFF));
    std::crypto::set_le32(w, index + 3, cast<u32>((x3 | (x3 >> 16)) & 0xFFFFFFFF));
    return;
}

// rcon is the round constant for round `k`: x^k in GF(2^8).
fn rcon(k: i64) -> u32 {
    var value = 1;
    for 0..k |_| {
        value = value << 1;
        if value >= 256 {
            value = value ^ 0x11B;
        }
    }
    return cast<u32>(value);
}

// sub_word puts one word through the S-box, for the key schedule.
fn sub_word(x: u32) -> u32 {
    var q_buffer = [64]u8{};
    let q = q_buffer.as_mut_bytes();
    set_word64(q, 0, cast<u64>(x));
    ortho(q);
    bitslice_sbox(q);
    ortho(q);
    return cast<u32>(word64(q, 0) & 0xFFFFFFFF);
}

// aes_keysched expands a 16- or 32-byte key into the compressed schedule
// -- two words per round key, written to `comp` -- and returns the
// number of rounds, 10 or 14.
fn aes_keysched(key: []u8, comp: &var []u8) -> i64 {
    let key_len = std::mem::len(key);
    var rounds = 10;
    if key_len == 32 {
        rounds = 14;
    }
    let nk = key_len / 4;
    let nkf = (rounds + 1) * 4;
    var skey_buffer = [240]u8{};
    let skey = skey_buffer.as_mut_bytes();
    for 0..nk |index| {
        let w = std::crypto::le32(key, index * 4);
        std::crypto::set_le32(skey, index, w);
    }
    var tmp = std::crypto::le32(key, key_len - 4);
    var i = nk;
    var j = 0;
    var k = 0;
    while i < nkf {
        if j == 0 {
            tmp = (tmp << 24) | (tmp >> 8);
            tmp = sub_word(tmp) ^ rcon(k);
        } else {
            if nk > 6 and j == 4 {
                tmp = sub_word(tmp);
            }
        }
        let earlier = std::crypto::le32(skey, (i - nk) * 4);
        tmp = tmp ^ earlier;
        std::crypto::set_le32(skey, i, tmp);
        i = i + 1;
        j = j + 1;
        if j == nk {
            j = 0;
            k = k + 1;
        }
    }
    var q_buffer = [64]u8{};
    let q = q_buffer.as_mut_bytes();
    var at = 0;
    var out = 0;
    while at < nkf {
        interleave_in(q, 0, 4, skey, at * 4);
        let q0 = word64(q, 0);
        let q4 = word64(q, 4);
        set_word64(q, 1, q0);
        set_word64(q, 2, q0);
        set_word64(q, 3, q0);
        set_word64(q, 5, q4);
        set_word64(q, 6, q4);
        set_word64(q, 7, q4);
        ortho(q);
        let c0 = (word64(q, 0) & mask1())
            | (word64(q, 1) & mask2())
            | (word64(q, 2) & mask4())
            | (word64(q, 3) & mask8());
        let c1 = (word64(q, 4) & mask1())
            | (word64(q, 5) & mask2())
            | (word64(q, 6) & mask4())
            | (word64(q, 7) & mask8());
        set_word64(comp, out, c0);
        set_word64(comp, out + 1, c1);
        at = at + 4;
        out = out + 2;
    }
    return rounds;
}

// aes_skey_expand turns the compressed schedule into eight words per
// round key, the form add_round_key reads.
fn aes_skey_expand(comp: []u8, rounds: i64, skey: &var []u8) -> void {
    let n = (rounds + 1) * 2;
    for 0..n |u| {
        let x = word64(comp, u);
        let x0 = x & mask1();
        let x1 = (x & mask2()) >> 1;
        let x2 = (x & mask4()) >> 2;
        let x3 = (x & mask8()) >> 3;
        set_word64(skey, u * 4, (x0 << 4) - x0);
        set_word64(skey, u * 4 + 1, (x1 << 4) - x1);
        set_word64(skey, u * 4 + 2, (x2 << 4) - x2);
        set_word64(skey, u * 4 + 3, (x3 << 4) - x3);
    }
    return;
}

fn add_round_key(q: &var []u8, skey: []u8, offset: i64) -> void {
    for 0..8 |index| {
        let x = word64(q, index) ^ word64(skey, offset + index);
        set_word64(q, index, x);
    }
    return;
}

fn shift_rows(q: &var []u8) -> void {
    for 0..8 |index| {
        let x = word64(q, index);
        let shifted = (x & 0x000000000000FFFF)
            | ((x & 0x00000000FFF00000) >> 4)
            | ((x & 0x00000000000F0000) << 12)
            | ((x & 0x0000FF0000000000) >> 8)
            | ((x & 0x000000FF00000000) << 8)
            | ((x & ~cast<u64>(0x0FFFFFFFFFFFFFFF)) >> 12)
            | ((x & 0x0FFF000000000000) << 4);
        set_word64(q, index, shifted);
    }
    return;
}

fn rotr32(x: u64) -> u64 {
    return (x << 32) | (x >> 32);
}

fn mix_columns(q: &var []u8) -> void {
    let q0 = word64(q, 0);
    let q1 = word64(q, 1);
    let q2 = word64(q, 2);
    let q3 = word64(q, 3);
    let q4 = word64(q, 4);
    let q5 = word64(q, 5);
    let q6 = word64(q, 6);
    let q7 = word64(q, 7);
    let r0 = (q0 >> 16) | (q0 << 48);
    let r1 = (q1 >> 16) | (q1 << 48);
    let r2 = (q2 >> 16) | (q2 << 48);
    let r3 = (q3 >> 16) | (q3 << 48);
    let r4 = (q4 >> 16) | (q4 << 48);
    let r5 = (q5 >> 16) | (q5 << 48);
    let r6 = (q6 >> 16) | (q6 << 48);
    let r7 = (q7 >> 16) | (q7 << 48);
    set_word64(q, 0, q7 ^ r7 ^ r0 ^ rotr32(q0 ^ r0));
    set_word64(q, 1, q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr32(q1 ^ r1));
    set_word64(q, 2, q1 ^ r1 ^ r2 ^ rotr32(q2 ^ r2));
    set_word64(q, 3, q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr32(q3 ^ r3));
    set_word64(q, 4, q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr32(q4 ^ r4));
    set_word64(q, 5, q4 ^ r4 ^ r5 ^ rotr32(q5 ^ r5));
    set_word64(q, 6, q5 ^ r5 ^ r6 ^ rotr32(q6 ^ r6));
    set_word64(q, 7, q6 ^ r6 ^ r7 ^ rotr32(q7 ^ r7));
    return;
}

// bitslice_encrypt runs the rounds over the four blocks in `q`, which
// are in bit-plane order.
fn bitslice_encrypt(rounds: i64, skey: []u8, q: &var []u8) -> void {
    add_round_key(q, skey, 0);
    for 1..rounds |u| {
        bitslice_sbox(q);
        shift_rows(q);
        mix_columns(q);
        add_round_key(q, skey, u * 8);
    }
    bitslice_sbox(q);
    shift_rows(q);
    add_round_key(q, skey, rounds * 8);
    return;
}

// aes_encrypt4 encrypts the four 16-byte blocks in `blocks` in place
// under an expanded schedule.
fn aes_encrypt4(rounds: i64, skey: []u8, blocks: &var []u8) -> void {
    var q_buffer = [64]u8{};
    let q = q_buffer.as_mut_bytes();
    for 0..4 |index| {
        interleave_in(q, index, index + 4, blocks, index * 16);
    }
    ortho(q);
    bitslice_encrypt(rounds, skey, q);
    ortho(q);
    for 0..4 |index| {
        let q0 = word64(q, index);
        let q1 = word64(q, index + 4);
        interleave_out(blocks, index * 4, q0, q1);
    }
    return;
}
