// The DER a certificate is written in, read one element at a time: a
// tag byte, a length, and that many bytes of content. Only what RFC 5280
// uses is read -- one-byte tags and definite lengths -- and a length
// that is not the shortest spelling, or runs past its container, is a
// malformed certificate and not a bug.

// An Element is one tag-length-value at a known place in the DER: `head`
// is where its tag byte is, the content is `start` up to `end`, and the
// next element begins at `end`.
struct Element {
    tag: i64,
    head: i64,
    start: i64,
    end: i64,
}

// read_element reads the element at `at`, which must end by `limit`.
fn read_element(der: []u8, at: i64, limit: i64) -> std::crypto::x509::Error!Element {
    if at + 2 > limit {
        return std::crypto::x509::Error::Malformed;
    }
    let tag = cast<i64>(der[at]);
    if tag & 31 == 31 {
        return std::crypto::x509::Error::Malformed;
    }
    let first = cast<i64>(der[at + 1]);
    var start = at + 2;
    var length = first;
    if first >= 128 {
        let count = first - 128;
        if count == 0 or count > 4 or start + count > limit {
            return std::crypto::x509::Error::Malformed;
        }
        length = 0;
        for 0..count |index| {
            length = (length << 8) | cast<i64>(der[start + index]);
        }
        start = start + count;
        // DER spells a length in the fewest bytes that hold it.
        if length < 128 or (count > 1 and length < (1 << ((count - 1) * 8))) {
            return std::crypto::x509::Error::Malformed;
        }
    }
    if start + length > limit {
        return std::crypto::x509::Error::Malformed;
    }
    return Element { tag: tag, head: at, start: start, end: start + length };
}

// expect_element reads the element at `at` and requires its tag.
fn expect_element(der: []u8, at: i64, limit: i64, tag: i64) -> std::crypto::x509::Error!Element {
    let element = try read_element(der, at, limit);
    if element.tag != tag {
        return std::crypto::x509::Error::Malformed;
    }
    return element;
}

// Tags: the universal ones RFC 5280 uses, and the context-specific
// ones a certificate's optional parts wear.
fn tag_boolean() -> i64 {
    return 1;
}

fn tag_integer() -> i64 {
    return 2;
}

fn tag_bit_string() -> i64 {
    return 3;
}

fn tag_octet_string() -> i64 {
    return 4;
}

fn tag_oid() -> i64 {
    return 6;
}

fn tag_utc_time() -> i64 {
    return 23;
}

fn tag_generalized_time() -> i64 {
    return 24;
}

fn tag_sequence() -> i64 {
    return 48;
}

// tag_explicit is the tag of `[n] EXPLICIT`, a constructed context tag.
fn tag_explicit(n: i64) -> i64 {
    return 160 + n;
}

// tag_dns_name is `[2] IMPLICIT IA5String`, a GeneralName's dNSName.
fn tag_dns_name() -> i64 {
    return 130;
}

// content_is_hex reports whether an element's content is the bytes a hex
// text spells. The object identifiers below are compared this way, since
// a literal holds text and not bytes.
fn content_is_hex(der: []u8, element: Element, hex: []u8) -> bool {
    let count = std::mem::len(hex) / 2;
    if element.end - element.start != count {
        return false;
    }
    for 0..count |index| {
        let high = hex_digit(hex[index * 2]);
        let low = hex_digit(hex[index * 2 + 1]);
        if cast<i64>(der[element.start + index]) != high * 16 + low {
            return false;
        }
    }
    return true;
}

// hex_digit is the value of one lowercase hex digit.
fn hex_digit(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return value - 87;
    }
    return value - 48;
}

// same_content reports whether two elements, possibly in different DER,
// hold the same bytes.
fn same_content(a_der: []u8, a: Element, b_der: []u8, b: Element) -> bool {
    let left = a_der[a.head..a.end];
    let right = b_der[b.head..b.end];
    return std::mem::equal_bytes(left, right);
}

// read_time reads a UTCTime `YYMMDDHHMMSSZ` or a GeneralizedTime
// `YYYYMMDDHHMMSSZ` as seconds since 1970-01-01T00:00:00Z. RFC 5280
// §4.1.2.5 allows no other form, and a UTCTime year below 50 is 20YY.
fn read_time(der: []u8, at: i64, limit: i64) -> std::crypto::x509::Error!Element {
    let element = try read_element(der, at, limit);
    let length = element.end - element.start;
    var year_digits = 2;
    if element.tag == tag_generalized_time() {
        year_digits = 4;
    } else {
        if element.tag != tag_utc_time() {
            return std::crypto::x509::Error::Malformed;
        }
    }
    if length != year_digits + 11 or der[element.end - 1] != 90 {
        return std::crypto::x509::Error::Malformed;
    }
    return element;
}

// time_value is the seconds since 1970 an element read_time accepted
// stands for.
fn time_value(der: []u8, element: Element) -> std::crypto::x509::Error!i64 {
    var at = element.start;
    var year = 0;
    if element.tag == tag_generalized_time() {
        year = try digits(der, at, 4);
        at = at + 4;
    } else {
        year = try digits(der, at, 2);
        at = at + 2;
        if year < 50 {
            year = year + 2000;
        } else {
            year = year + 1900;
        }
    }
    let month = try digits(der, at, 2);
    let day = try digits(der, at + 2, 2);
    let hour = try digits(der, at + 4, 2);
    let minute = try digits(der, at + 6, 2);
    let second = try digits(der, at + 8, 2);
    if month < 1 or month > 12 or day < 1 or day > 31 or hour > 23 or minute > 59 or second > 60 {
        return std::crypto::x509::Error::Malformed;
    }
    let days = days_from_civil(year, month, day);
    return days * 86400 + hour * 3600 + minute * 60 + second;
}

// digits reads `count` decimal digits.
fn digits(der: []u8, at: i64, count: i64) -> std::crypto::x509::Error!i64 {
    var value = 0;
    for 0..count |index| {
        let byte = cast<i64>(der[at + index]);
        if byte < 48 or byte > 57 {
            return std::crypto::x509::Error::Malformed;
        }
        value = value * 10 + byte - 48;
    }
    return value;
}

// days_from_civil is the number of days from 1970-01-01 to a calendar
// day, the way std::date counts them.
fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    var y = year;
    if month <= 2 {
        y = y - 1;
    }
    var era = y / 400;
    if y < 0 and y % 400 != 0 {
        era = era - 1;
    }
    let yoe = y - era * 400;
    var m = month - 3;
    if month <= 2 {
        m = month + 9;
    }
    let doy = (153 * m + 2) / 5 + day - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}
