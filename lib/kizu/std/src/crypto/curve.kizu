// The NIST curves P-256 and P-384 (FIPS 186-4 §D.1.2, SEC 2 secp256r1
// and secp384r1), as far as verifying a signature needs them: each
// curve's field prime p and group order n as moduli for the arithmetic
// in limbs.kizu, its constant b and generator G, and point addition and
// doubling in Jacobian coordinates, which take the modulus view of p
// and read their width from it -- eight limbs for P-256, twelve for
// P-384. Both curves have a = -3, so one set of formulas serves.
//
// Everything here works on public data -- a certificate's key, a
// signature, a digest -- so it branches on values and compares them
// early; nothing here handles a private key.

// Curve names one of the two curves.
enum Curve {
    P256,
    P384,
}

// curve_bytes is how many bytes a coordinate or a scalar takes.
fn curve_bytes(curve: Curve) -> i64 {
    return match curve {
        P256 => 32,
        P384 => 48,
    };
}

// fill_field writes the modulus view for the field prime p.
fn fill_field(o: &var []u64, curve: Curve) -> void {
    var p_buffer = [12]u64{};
    let p = p_buffer.as_mut_slice();
    let hex = match curve {
        P256 => "ffffffff 00000001 00000000 00000000 00000000 ffffffff ffffffff ffffffff",
        P384 =>
            \\ffffffff ffffffff ffffffff ffffffff ffffffff ffffffff ffffffff fffffffe
            \\ffffffff 00000000 00000000 ffffffff
        ,
    };
    limbs_of_hex(p, 0, hex);
    let p_view = p[0..curve_bytes(curve) / 4];
    fill_modulus(o, p_view);
    return;
}

// fill_order writes the modulus view for the group order n.
fn fill_order(o: &var []u64, curve: Curve) -> void {
    var n_buffer = [12]u64{};
    let n = n_buffer.as_mut_slice();
    let hex = match curve {
        P256 => "ffffffff 00000000 ffffffff ffffffff bce6faad a7179e84 f3b9cac2 fc632551",
        P384 =>
            \\ffffffff ffffffff ffffffff ffffffff ffffffff ffffffff c7634d81 f4372ddf
            \\581a0db2 48b0a77a ecec196a ccc52973
        ,
    };
    limbs_of_hex(n, 0, hex);
    let n_view = n[0..curve_bytes(curve) / 4];
    fill_modulus(o, n_view);
    return;
}

// curve_b is the constant b of y^2 = x^3 - 3x + b.
fn curve_b(curve: Curve) -> []u8 {
    return match curve {
        P256 => "5ac635d8 aa3a93e7 b3ebbd55 769886bc 651d06b0 cc53b0f6 3bce3c3e 27d2604b",
        P384 =>
            \\b3312fa7 e23ee7e4 988e056b e3f82d19 181d9c6e fe814112 0314088f 5013875a
            \\c656398d 8a2ed19d 2a85c8ed d3ec2aef
        ,
    };
}

// generator_x and generator_y are the affine coordinates of G.
fn generator_x(curve: Curve) -> []u8 {
    return match curve {
        P256 => "6b17d1f2 e12c4247 f8bce6e5 63a440f2 77037d81 2deb33a0 f4a13945 d898c296",
        P384 =>
            \\aa87ca22 be8b0537 8eb1c71e f320ad74 6e1d3b62 8ba79b98 59f741e0 82542a38
            \\5502f25d bf55296c 3a545e38 72760ab7
        ,
    };
}

fn generator_y(curve: Curve) -> []u8 {
    return match curve {
        P256 => "4fe342e2 fe1a7f9b 8ee7eb4a 7c0f9e16 2bce3357 6b315ece cbb64068 37bf51f5",
        P384 =>
            \\3617de4a 96262c6f 5d9e98bf 9292dc29 f8f41dbd 289a147c e9da3113 b5f0b8c0
            \\0a60b1ce 1d7e819d 7a431d7c 90ea0e5f
        ,
    };
}

// A point is 3 count limbs: Jacobian X, Y, Z in Montgomery form, where
// the affine point is (X / Z^2, Y / Z^3) and Z = 0 is the point at
// infinity. `count` is the width the modulus view gives.
fn point_x(p: []u64, count: i64) -> []u64 {
    return p[0..count];
}

fn point_y(p: []u64, count: i64) -> []u64 {
    return p[count..count * 2];
}

fn point_z(p: []u64, count: i64) -> []u64 {
    return p[count * 2..count * 3];
}

fn is_infinity(p: []u64, count: i64) -> bool {
    let z = point_z(p, count);
    return is_zero(z);
}

fn copy_point(o: &var []u64, p: []u64, count: i64) -> void {
    for 0..count * 3 |index| {
        o[index] = p[index];
    }
    return;
}

// point_double writes 2P. The formulas are for a = -3 (Bernstein and
// Lange's dbl-2001-b): with delta = Z^2 and gamma = Y^2,
// alpha = 3 (X - delta) (X + delta) and beta = X gamma, then
// X' = alpha^2 - 8 beta, Z' = (Y + Z)^2 - gamma - delta, and
// Y' = alpha (4 beta - X') - 8 gamma^2.
fn point_double(o: &var []u64, p: []u64, m: []u64) -> void {
    let count = count_of(m);
    let x = point_x(p, count);
    let y = point_y(p, count);
    let z = point_z(p, count);
    var delta_buffer = [12]u64{};
    var gamma_buffer = [12]u64{};
    var beta_buffer = [12]u64{};
    var alpha_buffer = [12]u64{};
    var t1_buffer = [12]u64{};
    var t2_buffer = [12]u64{};
    var t3_buffer = [12]u64{};
    let delta = delta_buffer.as_mut_slice();
    let gamma = gamma_buffer.as_mut_slice();
    let beta = beta_buffer.as_mut_slice();
    let alpha = alpha_buffer.as_mut_slice();
    let t1 = t1_buffer.as_mut_slice();
    let t2 = t2_buffer.as_mut_slice();
    let t3 = t3_buffer.as_mut_slice();
    mont_mul(delta, z, z, m);
    mont_mul(gamma, y, y, m);
    mont_mul(beta, x, gamma, m);
    mod_sub(t1, x, delta, m);
    mod_add(t2, x, delta, m);
    mont_mul(t3, t1, t2, m);
    mod_add(t1, t3, t3, m);
    mod_add(alpha, t1, t3, m);
    // X' = alpha^2 - 8 beta
    mont_mul(t1, alpha, alpha, m);
    mod_add(t2, beta, beta, m);
    mod_add(t3, t2, t2, m);
    mod_add(t2, t3, t3, m);
    mod_sub(t3, t1, t2, m);
    copy_limbs(o, 0, t3, count);
    // Z' = (Y + Z)^2 - gamma - delta
    mod_add(t1, y, z, m);
    mont_mul(t2, t1, t1, m);
    mod_sub(t1, t2, gamma, m);
    mod_sub(t2, t1, delta, m);
    copy_limbs(o, count * 2, t2, count);
    // Y' = alpha (4 beta - X') - 8 gamma^2
    mod_add(t1, beta, beta, m);
    mod_add(t2, t1, t1, m);
    mod_sub(t1, t2, t3, m);
    mont_mul(t2, alpha, t1, m);
    mont_mul(t1, gamma, gamma, m);
    mod_add(t3, t1, t1, m);
    mod_add(t1, t3, t3, m);
    mod_add(t3, t1, t1, m);
    mod_sub(t1, t2, t3, m);
    copy_limbs(o, count, t1, count);
    return;
}

// point_add writes P + Q (Bernstein and Lange's add-2007-bl): with
// U1 = X1 Z2^2, U2 = X2 Z1^2, S1 = Y1 Z2^3, S2 = Y2 Z1^3, H = U2 - U1,
// I = (2H)^2, J = H I, r = 2 (S2 - S1), V = U1 I, then
// X3 = r^2 - J - 2V, Y3 = r (V - X3) - 2 S1 J, and
// Z3 = ((Z1 + Z2)^2 - Z1^2 - Z2^2) H. Either point at infinity gives the
// other; equal points double, and opposite points give infinity.
fn point_add(o: &var []u64, p: []u64, q: []u64, m: []u64) -> void {
    let count = count_of(m);
    if is_infinity(p, count) {
        copy_point(o, q, count);
        return;
    }
    if is_infinity(q, count) {
        copy_point(o, p, count);
        return;
    }
    let x1 = point_x(p, count);
    let y1 = point_y(p, count);
    let z1 = point_z(p, count);
    let x2 = point_x(q, count);
    let y2 = point_y(q, count);
    let z2 = point_z(q, count);
    var z1z1_buffer = [12]u64{};
    var z2z2_buffer = [12]u64{};
    var u1_buffer = [12]u64{};
    var u2_buffer = [12]u64{};
    var s1_buffer = [12]u64{};
    var s2_buffer = [12]u64{};
    var h_buffer = [12]u64{};
    var i_buffer = [12]u64{};
    var j_buffer = [12]u64{};
    var r_buffer = [12]u64{};
    var v_buffer = [12]u64{};
    var t1_buffer = [12]u64{};
    var t2_buffer = [12]u64{};
    var t3_buffer = [12]u64{};
    let z1z1 = z1z1_buffer.as_mut_slice();
    let z2z2 = z2z2_buffer.as_mut_slice();
    let u1 = u1_buffer.as_mut_slice();
    let u2 = u2_buffer.as_mut_slice();
    let s1 = s1_buffer.as_mut_slice();
    let s2 = s2_buffer.as_mut_slice();
    let h = h_buffer.as_mut_slice();
    let i = i_buffer.as_mut_slice();
    let j = j_buffer.as_mut_slice();
    let r = r_buffer.as_mut_slice();
    let v = v_buffer.as_mut_slice();
    let t1 = t1_buffer.as_mut_slice();
    let t2 = t2_buffer.as_mut_slice();
    let t3 = t3_buffer.as_mut_slice();
    mont_mul(z1z1, z1, z1, m);
    mont_mul(z2z2, z2, z2, m);
    mont_mul(u1, x1, z2z2, m);
    mont_mul(u2, x2, z1z1, m);
    mont_mul(t1, z2, z2z2, m);
    mont_mul(s1, y1, t1, m);
    mont_mul(t1, z1, z1z1, m);
    mont_mul(s2, y2, t1, m);
    mod_sub(h, u2, u1, m);
    mod_sub(t1, s2, s1, m);
    if is_zero(h) {
        if is_zero(t1) {
            point_double(o, p, m);
        } else {
            for 0..count * 3 |index| {
                o[index] = 0;
            }
        }
        return;
    }
    mod_add(r, t1, t1, m);
    mod_add(t1, h, h, m);
    mont_mul(i, t1, t1, m);
    mont_mul(j, h, i, m);
    mont_mul(v, u1, i, m);
    // X3 = r^2 - J - 2V
    mont_mul(t1, r, r, m);
    mod_sub(t2, t1, j, m);
    mod_add(t1, v, v, m);
    mod_sub(t3, t2, t1, m);
    copy_limbs(o, 0, t3, count);
    // Y3 = r (V - X3) - 2 S1 J
    mod_sub(t1, v, t3, m);
    mont_mul(t2, r, t1, m);
    mont_mul(t1, s1, j, m);
    mod_add(t3, t1, t1, m);
    mod_sub(t1, t2, t3, m);
    copy_limbs(o, count, t1, count);
    // Z3 = ((Z1 + Z2)^2 - Z1Z1 - Z2Z2) H
    mod_add(t1, z1, z2, m);
    mont_mul(t2, t1, t1, m);
    mod_sub(t1, t2, z1z1, m);
    mod_sub(t2, t1, z2z2, m);
    mont_mul(t1, t2, h, m);
    copy_limbs(o, count * 2, t1, count);
    return;
}

// point_from_affine writes the Jacobian point for affine (x, y) given as
// plain numbers: Montgomery form with Z = 1.
fn point_from_affine(o: &var []u64, x: []u64, y: []u64, m: []u64) -> void {
    let count = count_of(m);
    var t_buffer = [12]u64{};
    let t = t_buffer.as_mut_slice();
    to_mont(t, x, m);
    copy_limbs(o, 0, t, count);
    to_mont(t, y, m);
    copy_limbs(o, count, t, count);
    var one_buffer = [12]u64{};
    let one = one_buffer.as_mut_slice();
    one[0] = 1;
    to_mont(t, one, m);
    copy_limbs(o, count * 2, t, count);
    return;
}

// affine_x writes the plain affine x of a point that is not infinity:
// X / Z^2, out of Montgomery form.
fn affine_x(o: &var []u64, p: []u64, m: []u64) -> void {
    let count = count_of(m);
    let x = point_x(p, count);
    let z = point_z(p, count);
    var t1_buffer = [12]u64{};
    var t2_buffer = [12]u64{};
    let t1 = t1_buffer.as_mut_slice();
    let t2 = t2_buffer.as_mut_slice();
    mont_mul(t1, z, z, m);
    mont_inverse(t2, t1, m);
    mont_mul(t1, x, t2, m);
    from_mont(o, t1, m);
    return;
}

// scalar_mul_add writes k1 P1 + k2 P2 for plain scalars k1 and k2 below
// n, by doubling and adding from the top bit down with P1 + P2 held
// ready for the bits where both are set (Straus and Shamir). The
// scalars are public here, so the branches on their bits are too.
fn scalar_mul_add(o: &var []u64, k1: []u64, p1: []u64, k2: []u64, p2: []u64, m: []u64) -> void {
    let count = count_of(m);
    var both_buffer = [36]u64{};
    var acc_buffer = [36]u64{};
    var next_buffer = [36]u64{};
    let both = both_buffer.as_mut_slice();
    let acc = acc_buffer.as_mut_slice();
    let next = next_buffer.as_mut_slice();
    point_add(both, p1, p2, m);
    var bit = count * 32 - 1;
    while bit >= 0 {
        point_double(next, acc, m);
        let limb = bit >> 5;
        let shift = cast<u64>(bit & 31);
        let bit1 = (k1[limb] >> shift) & 1;
        let bit2 = (k2[limb] >> shift) & 1;
        if bit1 == 1 and bit2 == 1 {
            point_add(acc, next, both, m);
        } else {
            if bit1 == 1 {
                point_add(acc, next, p1, m);
            } else {
                if bit2 == 1 {
                    point_add(acc, next, p2, m);
                } else {
                    copy_point(acc, next, count);
                }
            }
        }
        bit = bit - 1;
    }
    copy_point(o, acc, count);
    return;
}

// on_curve reports whether plain affine (x, y), both below p, satisfy
// y^2 = x^3 - 3x + b.
fn on_curve(curve: Curve, x: []u64, y: []u64, m: []u64) -> bool {
    var xm_buffer = [12]u64{};
    var ym_buffer = [12]u64{};
    var b_buffer = [12]u64{};
    var bm_buffer = [12]u64{};
    var t1_buffer = [12]u64{};
    var t2_buffer = [12]u64{};
    var t3_buffer = [12]u64{};
    let xm = xm_buffer.as_mut_slice();
    let ym = ym_buffer.as_mut_slice();
    let b = b_buffer.as_mut_slice();
    let bm = bm_buffer.as_mut_slice();
    let t1 = t1_buffer.as_mut_slice();
    let t2 = t2_buffer.as_mut_slice();
    let t3 = t3_buffer.as_mut_slice();
    to_mont(xm, x, m);
    to_mont(ym, y, m);
    limbs_of_hex(b, 0, curve_b(curve));
    to_mont(bm, b, m);
    // left = y^2
    mont_mul(t1, ym, ym, m);
    // right = x^3 - 3x + b
    mont_mul(t2, xm, xm, m);
    mont_mul(t3, t2, xm, m);
    mod_sub(t2, t3, xm, m);
    mod_sub(t3, t2, xm, m);
    mod_sub(t2, t3, xm, m);
    mod_add(t3, t2, bm, m);
    return equal_limbs(t1, t3);
}
