// Poly1305, as RFC 8439 §2.5 defines it: the message is read as 16-byte
// blocks, each with a 1 bit set above its top byte, and the accumulator
// is (acc + block) * r mod 2^130 - 5 for each; the tag is the accumulator
// plus s, mod 2^128. The arithmetic is on five 26-bit limbs held in i64,
// so a limb times a limb stays under 2^52 and a row of five products
// under 2^55 (the shape of poly1305-donna-32), and no branch depends on
// the message or the key: the final reduction chooses with a mask.
//
// Only the AEAD reaches this, and the AEAD pads what it authenticates to
// whole blocks, so every block here is a full one.

// Poly1305 is the accumulator and the clamped key, mid-message.
struct Poly1305 {
    h0: i64,
    h1: i64,
    h2: i64,
    h3: i64,
    h4: i64,
    r0: i64,
    r1: i64,
    r2: i64,
    r3: i64,
    r4: i64,
}

// poly1305_new clamps the first half of the 32-byte one-time key into r.
fn poly1305_new(key: []u8) -> std::crypto::Poly1305 {
    let t0 = cast<i64>(std::crypto::le32(key, 0));
    let t1 = cast<i64>(std::crypto::le32(key, 4));
    let t2 = cast<i64>(std::crypto::le32(key, 8));
    let t3 = cast<i64>(std::crypto::le32(key, 12));
    return std::crypto::Poly1305 {
        h0: 0,
        h1: 0,
        h2: 0,
        h3: 0,
        h4: 0,
        r0: t0 & 0x3ffffff,
        r1: ((t0 >> 26) | (t1 << 6)) & 0x3ffff03,
        r2: ((t1 >> 20) | (t2 << 12)) & 0x3ffc0ff,
        r3: ((t2 >> 14) | (t3 << 18)) & 0x3f03fff,
        r4: (t3 >> 8) & 0x00fffff,
    };
}

// block folds one full 16-byte block into the accumulator.
fn (self: &var std::crypto::Poly1305) block(m: []u8) -> void {
    let t0 = cast<i64>(std::crypto::le32(m, 0));
    let t1 = cast<i64>(std::crypto::le32(m, 4));
    let t2 = cast<i64>(std::crypto::le32(m, 8));
    let t3 = cast<i64>(std::crypto::le32(m, 12));
    let h0 = self.h0 + (t0 & 0x3ffffff);
    let h1 = self.h1 + (((t0 >> 26) | (t1 << 6)) & 0x3ffffff);
    let h2 = self.h2 + (((t1 >> 20) | (t2 << 12)) & 0x3ffffff);
    let h3 = self.h3 + (((t2 >> 14) | (t3 << 18)) & 0x3ffffff);
    let h4 = self.h4 + ((t3 >> 8) | (1 << 24));
    let s1 = self.r1 * 5;
    let s2 = self.r2 * 5;
    let s3 = self.r3 * 5;
    let s4 = self.r4 * 5;
    let d0 = h0 * self.r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1;
    let d1 = h0 * self.r1 + h1 * self.r0 + h2 * s4 + h3 * s3 + h4 * s2;
    let d2 = h0 * self.r2 + h1 * self.r1 + h2 * self.r0 + h3 * s4 + h4 * s3;
    let d3 = h0 * self.r3 + h1 * self.r2 + h2 * self.r1 + h3 * self.r0 + h4 * s4;
    let d4 = h0 * self.r4 + h1 * self.r3 + h2 * self.r2 + h3 * self.r1 + h4 * self.r0;
    var carry = d0 >> 26;
    let e0 = d0 & 0x3ffffff;
    let f1 = d1 + carry;
    carry = f1 >> 26;
    let e1 = f1 & 0x3ffffff;
    let f2 = d2 + carry;
    carry = f2 >> 26;
    let e2 = f2 & 0x3ffffff;
    let f3 = d3 + carry;
    carry = f3 >> 26;
    let e3 = f3 & 0x3ffffff;
    let f4 = d4 + carry;
    carry = f4 >> 26;
    let e4 = f4 & 0x3ffffff;
    let g0 = e0 + carry * 5;
    carry = g0 >> 26;
    self.h0 = g0 & 0x3ffffff;
    self.h1 = e1 + carry;
    self.h2 = e2;
    self.h3 = e3;
    self.h4 = e4;
    return;
}

// absorb_padded folds `bytes` as whole blocks, the last one filled out
// with zeros, which is how the AEAD lays out each of its inputs.
fn (self: &var std::crypto::Poly1305) absorb_padded(bytes: []u8) -> void {
    let end = std::mem::len(bytes);
    var at = 0;
    while at + 16 <= end {
        let chunk = bytes[at..at + 16];
        self.block(chunk);
        at = at + 16;
    }
    if at < end {
        var last_buffer = [16]u8{};
        let last = last_buffer.as_mut_bytes();
        let rest = end - at;
        for 0..rest |index| {
            last[index] = bytes[at + index];
        }
        self.block(last);
    }
    return;
}

// finish reduces the accumulator fully, adds s (the second half of the
// key), and writes the 16-byte tag to the front of `tag`. Whether the
// accumulator is above the modulus is decided with a mask, not a branch.
fn (self: &std::crypto::Poly1305) finish(key: []u8, tag: &var []u8) -> void {
    var carry = self.h1 >> 26;
    var h1 = self.h1 & 0x3ffffff;
    var h2 = self.h2 + carry;
    carry = h2 >> 26;
    h2 = h2 & 0x3ffffff;
    var h3 = self.h3 + carry;
    carry = h3 >> 26;
    h3 = h3 & 0x3ffffff;
    var h4 = self.h4 + carry;
    carry = h4 >> 26;
    h4 = h4 & 0x3ffffff;
    var h0 = self.h0 + carry * 5;
    carry = h0 >> 26;
    h0 = h0 & 0x3ffffff;
    h1 = h1 + carry;

    var g0 = h0 + 5;
    carry = g0 >> 26;
    g0 = g0 & 0x3ffffff;
    var g1 = h1 + carry;
    carry = g1 >> 26;
    g1 = g1 & 0x3ffffff;
    var g2 = h2 + carry;
    carry = g2 >> 26;
    g2 = g2 & 0x3ffffff;
    var g3 = h3 + carry;
    carry = g3 >> 26;
    g3 = g3 & 0x3ffffff;
    let g4 = h4 + carry - (1 << 26);

    // g is h - (2^130 - 5); it is the answer when it did not go negative.
    let select = ((g4 >> 63) & 1) - 1;
    let keep = ~select;
    h0 = (h0 & keep) | (g0 & select);
    h1 = (h1 & keep) | (g1 & select);
    h2 = (h2 & keep) | (g2 & select);
    h3 = (h3 & keep) | (g3 & select);
    h4 = (h4 & keep) | (g4 & select);

    let w0 = (h0 | (h1 << 26)) & 0xffffffff;
    let w1 = ((h1 >> 6) | (h2 << 20)) & 0xffffffff;
    let w2 = ((h2 >> 12) | (h3 << 14)) & 0xffffffff;
    let w3 = ((h3 >> 18) | (h4 << 8)) & 0xffffffff;

    var sum = w0 + cast<i64>(std::crypto::le32(key, 16));
    std::crypto::set_le32(tag, 0, cast<u32>(sum & 0xffffffff));
    sum = w1 + cast<i64>(std::crypto::le32(key, 20)) + (sum >> 32);
    std::crypto::set_le32(tag, 1, cast<u32>(sum & 0xffffffff));
    sum = w2 + cast<i64>(std::crypto::le32(key, 24)) + (sum >> 32);
    std::crypto::set_le32(tag, 2, cast<u32>(sum & 0xffffffff));
    sum = w3 + cast<i64>(std::crypto::le32(key, 28)) + (sum >> 32);
    std::crypto::set_le32(tag, 3, cast<u32>(sum & 0xffffffff));
    return;
}
