pub error Error {
    WriteFailed,
    ReadFailed,
    OutOfMemory,
    IoFailing,
}

pub fn blocking() -> Io {
    return std::builtin::io_blocking();
}

pub fn write_stdout(io: Io, bytes: &[]u8) -> std::io::Error!void {
    try std::builtin::io_write_stdout(io, bytes);
    return;
}

pub fn write_stderr(io: Io, bytes: &[]u8) -> std::io::Error!void {
    try std::builtin::io_write_stderr(io, bytes);
    return;
}

pub fn read_stdin(io: Io) -> std::io::Error![]u8 {
    let bytes = try std::builtin::io_read_stdin(io);
    return bytes;
}
