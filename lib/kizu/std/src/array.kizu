pub error Error {
    OutOfMemory,
    OutOfBounds,
}

pub fn new<T>(allocator: Allocator) -> std::array::Array<T> {
    return std::internal::builtin::array<T>(allocator);
}

fn (self: std::array::Array<T>) append<T>(value: T) -> !void {
    return std::internal::builtin::array_append<T>(self, value);
}

fn (self: std::array::Array<T>) len<T>() -> i64 {
    return std::internal::builtin::array_len<T>(self);
}

fn (self: std::array::Array<T>) capacity<T>() -> i64 {
    return std::internal::builtin::array_capacity<T>(self);
}

fn (self: std::array::Array<T>) reserve<T>(additional: i64) -> !void {
    return std::internal::builtin::array_reserve<T>(self, additional);
}

fn (self: std::array::Array<T>) pop<T>() -> ?T {
    return std::internal::builtin::array_pop<T>(self);
}

fn (self: std::array::Array<T>) pop_or_panic<T>() -> T {
    return std::internal::builtin::array_pop_or_panic<T>(self);
}

fn (self: std::array::Array<T>) get<T>(index: i64) -> ?T {
    return std::internal::builtin::array_get<T>(self, index);
}

fn (self: std::array::Array<T>) get_or_panic<T>(index: i64) -> T {
    return std::internal::builtin::array_get_or_panic<T>(self, index);
}

fn (self: std::array::Array<T>) at<T>(index: i64) -> ?&T {
    return std::internal::builtin::array_at<T>(self, index);
}

fn (self: std::array::Array<T>) at_mut<T>(index: i64) -> ?&var T {
    return std::internal::builtin::array_at_mut<T>(self, index);
}

fn (self: std::array::Array<T>) set<T>(index: i64, value: T) -> !void {
    return std::internal::builtin::array_set<T>(self, index, value);
}

fn (self: std::array::Array<T>) deinit<T>() -> void {
    std::internal::builtin::array_deinit<T>(self);
}

// deinit_all consumes every element, then releases the backing buffer. It is
// the one cleanup an owner-element Array accepts: shallow `deinit()` would
// leak the elements, so the checker rejects it (ADR-0091).
fn (self: std::array::Array<T>) deinit_all<T>() -> void {
    while self.len() > 0 {
        let item = self.pop_or_panic();
        item.deinit();
    }
    std::internal::builtin::array_deinit<T>(self);
}

fn (self: std::array::Array<T>) truncate<T>(length: i64) -> !void {
    return std::internal::builtin::array_truncate<T>(self, length);
}

fn (self: std::array::Array<T>) clear<T>() -> void {
    std::internal::builtin::array_clear<T>(self);
}

fn (self: std::array::Array<T>) as_bytes<T>() -> []u8 {
    return std::internal::builtin::array_as_bytes<T>(self);
}

fn (self: std::array::Array<T>) as_mut_bytes<T>() -> &var []u8 {
    return std::internal::builtin::array_as_mut_bytes<T>(self);
}
