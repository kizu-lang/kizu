// ExitStatus names what a process exit means without baking the platform
// shape into every program: Success and Failure map to the host's
// conventional codes (0 and 1), Specific carries an explicit one. `main`
// may return `!std::process::ExitStatus`; the native entry point maps the
// value to the process exit status (ADR-0085).
pub union ExitStatus {
    Success,
    Failure,
    Specific(u8),
}

pub error Error {
    InvalidArgumentCount,
    MissingExecutable,
    OutOfMemory,
    ArgIndexOutOfBounds,
    ExecutablePathUnknown,
}

pub fn arg_count() -> i64 {
    return std::internal::builtin::process_arg_count();
}

pub fn arg(index: i64) -> std::process::Error![]u8 {
    let value = try std::internal::builtin::process_arg(index);
    return value;
}

// env returns the value of an environment variable, or null when it is not
// set. A name the host cannot look up (an embedded NUL) has no value either.
pub fn env(name: []u8) -> ?[]u8 {
    return std::internal::builtin::process_env(name);
}

// executable_path returns the path of the running executable, so a program
// can find what ships beside it without depending on the directory it was
// started from. The kernel answers about this process, the way argv does, so
// no Io is taken. The path is what the kernel reports: `real_path` resolves
// it when a symlink stands between the caller and the install tree.
pub fn executable_path(allocator: Allocator) -> std::process::Error!std::string::String {
    var out = std::string::new(allocator);
    errdefer out.deinit();
    try std::internal::builtin::process_executable_path_into(&var out);
    return move out;
}

pub fn monotonic_millis() -> i64 {
    return std::internal::builtin::process_monotonic_millis();
}

// unix_millis reads the wall clock as milliseconds since the Unix epoch.
// monotonic_millis orders events within one process; this names a moment
// other processes and machines agree on, which is what a timestamp written
// next to an artifact has to be.
pub fn unix_millis() -> i64 {
    return std::internal::builtin::process_unix_millis();
}

pub fn spawn_wait8(
    argc: i64,
    arg0: &[]u8,
    arg1: &[]u8,
    arg2: &[]u8,
    arg3: &[]u8,
    arg4: &[]u8,
    arg5: &[]u8,
    arg6: &[]u8,
    arg7: &[]u8
) -> std::process::Error!i64 {
    return try std::internal::builtin::process_spawn_wait8(
        argc,
        arg0,
        arg1,
        arg2,
        arg3,
        arg4,
        arg5,
        arg6,
        arg7
    );
}

pub fn exit_code(code: i64) -> i64 {
    return code;
}
