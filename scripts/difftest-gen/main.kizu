fn (self: &var Gen) runners(allocator: Allocator, cases: i64) -> mem::Error!void {
    var runner = 0;
    var index = 0;
    while index < cases {
        try self.put(allocator, "fn run_");
        try self.number(allocator, runner);
        try self.put(allocator, "() -> void {$");
        var slot = 0;
        while slot < cases_per_runner and index < cases {
            try self.put(allocator, "    report(");
            try self.number(allocator, index);
            try self.put(allocator, ", case_");
            try self.number(allocator, index);
            try self.put(allocator, "());$");
            slot = slot + 1;
            index = index + 1;
        }
        try self.put(allocator, "}$$");
        runner = runner + 1;
    }
    try self.put(allocator, "fn main() {$");
    index = 0;
    while index < runner {
        try self.put(allocator, "    run_");
        try self.number(allocator, index);
        try self.put(allocator, "();$");
        index = index + 1;
    }
    return self.put(allocator, "}$");
}
