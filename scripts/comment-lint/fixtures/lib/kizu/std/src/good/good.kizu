// Thing is one public value.
pub struct Thing {
    // count is how many there are.
    pub count: i64,
}

// new makes a Thing.
//
// It allocates nothing.
pub fn new() -> std::good::Thing {
    return Thing { count: 0 };
}

// len reads the count of a Thing named by its bare name.
fn (self: &Thing) len() -> i64 {
    return self.count;
}

// bump adds one, through the qualified path of a pub type.
fn (self: &var std::good::Thing) bump() -> void {
    self.count = self.count + 1;
}

// reset works on a type the compiler knows; good/ does not declare it.
fn (self: &var std::good::Builtin<T>) reset<T>() -> void {
    std::internal::builtin::reset<T>(self);
}

// size reads another module's pub type.
fn (self: std::other::Shape) size() -> i64 {
    return 0;
}

// Error names what can go wrong.
pub error Error {
    Empty,
}

// Kind is a public enum.
// SAFETY: a SAFETY line inside a contract block is still fine.
/// A doc line too.
pub enum Kind {
    A,
}

/// Reads one byte the caller owns.
pub unsafe fn peek(p: *u8) -> u8 {
    // SAFETY: the caller hands a live pointer.
    return *p; // SAFETY: same pointer.
}

fn url() -> []u8 {
    return "https://example.com//path";
}

fn text() -> []u8 {
    return \\a // inside a multiline string
    ;
}
