// bad holds what the lint refuses in std.

// Thing is public, but a blank line separates this block from it.

pub struct Thing {
    count: i64,
}

// Inner is not pub, so this is not a contract.
struct Inner {
    x: i64,
}

// helper is not pub, so this is not a contract.
fn helper() -> i64 {
    return 1;
}

// len is a method of a type this module declares without pub.
fn (self: &Inner) len() -> i64 {
    return self.x;
}

// width is a method of another module's private type.
fn (self: &std::other::Hidden) width() -> i64 {
    return self.x;
}

// depth is a method of a bare name this module does not declare.
fn (self: &Elsewhere) depth() -> i64 {
    return 0;
}

pub fn run() -> i64 {
    // the reason this body is written this way
    let x = helper(); // trailing
    return x;
}

// a block at the end of the file
