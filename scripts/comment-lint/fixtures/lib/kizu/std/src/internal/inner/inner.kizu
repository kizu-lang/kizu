// Cell is pub, but std::internal is not an outward API.
pub struct Cell {
    // value is a pub field of an internal type.
    pub value: i64,
}

// get is a pub function of std::internal.
pub fn get(c: &Cell) -> i64 {
    return c.value;
}

// read is a method of a pub type of std::internal.
fn (self: &Cell) read() -> i64 {
    return self.value;
}

/// Reads one byte the caller owns.
pub unsafe fn peek(p: *u8) -> u8 {
    // SAFETY: the caller hands a live pointer.
    return *p;
}

fn url() -> []u8 {
    return "https://example.com//path";
}
