// The Kizu end of the `https-client-*` TLS fixtures: std::http over std::tls
// as the client, the peer a node https server that answers with the path it
// was asked for. record.mjs runs it from the repository root as
//
//     kizu run scripts/record-tls-fixtures/https_client.kizu -- <case> <port> <roots> <host>
//
// It connects to 127.0.0.1:<port> (record.mjs's relay) for <host>, trusting
// examples/fixtures/tls/<roots>.pem, at the real clock, drawing from the
// predictable source seeded with SHA-256("kizu tls fixture " + <case>), and
// sends GET https://<host>:<port>/greeting. It prints the status and the body,
// or the failure's name. The port is in the request's Host field, which is
// why these fixtures carry `# port:` and the replay puts its own port there.
// tests/behavior/src/tls_replay/ replays the fixture with the same steps.

import std::array;
import std::crypto;
import std::crypto::x509;
import std::fs;
import std::http;
import std::io;
import std::mem;
import std::process;
import std::string;
import std::tls;

error Failure = http::Failure or x509::Failure or fs::Error or process::Error or io::Error or mem::Error;

fn seed_of(allocator: Allocator, name: []u8, seed: &var []u8) -> mem::Error!void {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "kizu tls fixture ");
    try text.append_bytes(allocator, name);
    let bytes = text.as_bytes();
    crypto::sha256(bytes, seed);
    return;
}

fn roots_of(allocator: Allocator, name: []u8) -> Failure!array::Array<string::String> {
    var path = string::new(allocator);
    defer path.deinit(allocator);
    try path.append_bytes(allocator, "examples/fixtures/tls/");
    try path.append_bytes(allocator, name);
    try path.append_bytes(allocator, ".pem");
    let view = path.as_bytes();
    let text = try fs::read_file(io::blocking(), allocator, &view, mem::Limit::Unlimited);
    defer text.deinit(allocator);
    let text_bytes = text.as_bytes();
    var roots = array::new<string::String>(allocator);
    errdefer roots.deinit(allocator);
    let der = try x509::decode_pem(allocator, text_bytes, "CERTIFICATE");
    try roots.append(allocator, move der);
    return move roots;
}

fn failure_name(failure: Failure) -> []u8 {
    return match failure {
        NameMismatch => "NameMismatch",
        UnknownIssuer => "UnknownIssuer",
        Expired => "Expired",
        NoTrustedRoots => "NoTrustedRoots",
        Alert => "Alert",
        BadRecord => "BadRecord",
        _ => "other",
    };
}

fn fetch(io: Io, allocator: Allocator) -> Failure!void {
    let name = try process::arg(0);
    let port = try process::arg(1);
    let roots_name = try process::arg(2);
    let host = try process::arg(3);
    var seed_buffer = [32]u8{};
    var seed = seed_buffer.as_mut_bytes();
    try seed_of(allocator, name, &var seed);
    var roots = try roots_of(allocator, roots_name);
    defer roots.deinit(allocator);
    var address = string::new(allocator);
    defer address.deinit(allocator);
    try address.append_bytes(allocator, "127.0.0.1:");
    try address.append_bytes(allocator, port);
    var url_text = string::new(allocator);
    defer url_text.deinit(allocator);
    try url_text.append_bytes(allocator, "https://");
    try url_text.append_bytes(allocator, host);
    try url_text.append_bytes(allocator, ":");
    try url_text.append_bytes(allocator, port);
    try url_text.append_bytes(allocator, "/greeting");
    let address_bytes = address.as_bytes();
    let seed_bytes = seed_buffer.as_bytes();
    var client = try http::connect_secure_with(io, allocator, address_bytes, host, &roots,
        http::default_limits(), tls::predictable_entropy(seed_bytes));
    defer client.deinit(allocator);
    let url_bytes = url_text.as_bytes();
    var url = try http::parse_url(allocator, url_bytes);
    defer url.deinit(allocator);
    try client.send(io, allocator, "GET", &url, "", "", 20000);
    var response = try client.receive(io, allocator, "GET", http::default_limits());
    defer response.deinit(allocator);
    try client.read_body(io, allocator, &var response, 1 << 20);
    print(response.status);
    let body = response.body.as_bytes();
    print(body);
    return;
}

fn main() -> !void {
    if fetch(io::blocking(), mem::page_allocator()) {
        return;
    } else |err| {
        print(failure_name(err));
    }
    return;
}
