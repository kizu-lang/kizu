// The Kizu end of the `client-*` TLS fixtures: std::tls as the client, the
// peer a node TLS server that answers in upper case. record.mjs runs it from
// the repository root as
//
//     kizu run scripts/record-tls-fixtures/client.kizu -- <case> <port> <roots> <host>
//
// It connects to 127.0.0.1:<port> (record.mjs's relay) for <host>, trusting
// examples/fixtures/tls/<roots>.pem, at 1893456000 (2030-01-01), drawing from
// the predictable source seeded with SHA-256("kizu tls fixture " + <case>).
// It says "hello over tls", reads until the server closes, closes, and prints
// what happened: the suite, the reply and "closed", or the failure's name.
// tests/behavior/src/tls_replay/ replays the fixture with the same steps.

import std::array;
import std::crypto;
import std::crypto::x509;
import std::fs;
import std::io;
import std::mem;
import std::process;
import std::string;
import std::tls;

error Failure = tls::Failure or x509::Failure or fs::Error or process::Error or io::Error or mem::Error;

fn seed_of(allocator: Allocator, name: []u8, seed: &var []u8) -> mem::Error!void {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "kizu tls fixture ");
    try text.append_bytes(allocator, name);
    let bytes = text.as_bytes();
    crypto::sha256(bytes, seed);
    return;
}

fn roots_of(allocator: Allocator, name: []u8) -> Failure!array::Array<string::String> {
    var path = string::new(allocator);
    defer path.deinit(allocator);
    try path.append_bytes(allocator, "examples/fixtures/tls/");
    try path.append_bytes(allocator, name);
    try path.append_bytes(allocator, ".pem");
    let view = path.as_bytes();
    let text = try fs::read_file(io::blocking(), allocator, &view, mem::Limit::Unlimited);
    defer text.deinit(allocator);
    let text_bytes = text.as_bytes();
    var roots = array::new<string::String>(allocator);
    errdefer roots.deinit(allocator);
    let der = try x509::decode_pem(allocator, text_bytes, "CERTIFICATE");
    try roots.append(allocator, move der);
    return move roots;
}

fn failure_name(failure: Failure) -> []u8 {
    return match failure {
        NameMismatch => "NameMismatch",
        UnknownIssuer => "UnknownIssuer",
        Expired => "Expired",
        Alert => "Alert",
        BadRecord => "BadRecord",
        _ => "other",
    };
}

fn talk(io: Io, allocator: Allocator) -> Failure!void {
    let name = try process::arg(0);
    let port = try process::arg(1);
    let roots_name = try process::arg(2);
    let host = try process::arg(3);
    var seed_buffer = [32]u8{};
    var seed = seed_buffer.as_mut_bytes();
    try seed_of(allocator, name, &var seed);
    var roots = try roots_of(allocator, roots_name);
    defer roots.deinit(allocator);
    var address = string::new(allocator);
    defer address.deinit(allocator);
    try address.append_bytes(allocator, "127.0.0.1:");
    try address.append_bytes(allocator, port);
    let address_bytes = address.as_bytes();
    let seed_bytes = seed_buffer.as_bytes();
    var client = try tls::connect_with(io, allocator, address_bytes, host, &roots, 1893456000,
        tls::predictable_entropy(seed_bytes));
    defer client.deinit(allocator);
    if client.cipher_suite() == tls::CipherSuite::Aes128GcmSha256 {
        print("connected with AES-128-GCM");
    } else {
        print("connected with ChaCha20-Poly1305");
    }
    try client.write(io, allocator, "hello over tls");
    var reply = string::new(allocator);
    defer reply.deinit(allocator);
    while true {
        let got = try client.read_into(io, allocator, &var reply, 4096);
        if got == 0 {
            break;
        }
    }
    let reply_bytes = reply.as_bytes();
    print(reply_bytes);
    try client.close(io, allocator);
    print("closed");
    return;
}

fn main() -> !void {
    if talk(io::blocking(), mem::page_allocator()) {
        return;
    } else |err| {
        print(failure_name(err));
    }
    return;
}
