import compiler::unsafecap;
import std::mem;
import std::testing;

fn expect_lookup(name: []u8, expected_permit: []u8) -> void {
    if unsafecap::lookup(name) |info| {
        testing::expect(mem::equal_bytes(info.name, name));
        testing::expect(mem::equal_bytes(info.short_permit, expected_permit));
    } else {
        testing::fail("missing unsafe capability");
    }
    return;
}

test "unsafe capability lookup preserves every Go entry" {
    let extern_permit =
        \\covers calls to `extern "c" fn` declarations
    ;
    expect_lookup("extern_call", extern_permit);
    expect_lookup("ptr_cast", "covers raw pointer casts with `cast<ptr<...>>(value)`");
    expect_lookup("ptr_deref", "covers raw pointer dereference such as `p.*` and `p.*.field`");
    expect_lookup("ptr_int_cast",
        "covers `ptr_from_int<ptr<...>>(value)` and `int_from_ptr<usize>(value)`");
    expect_lookup("ptr_read", "covers raw pointer reads with `ptr_read(p)`");
    expect_lookup("ptr_write", "covers mutable raw pointer writes with `ptr_write(p, value)`");
    expect_lookup("struct_invariant",
        "covers establishing or changing the invariant of an `unsafe struct`, which is its construction and its field writes");
    expect_lookup("unsafe_call", "covers calls to functions or methods declared `unsafe fn`");
    expect_lookup("volatile",
        "covers volatile reads and writes with `volatile_read` / `volatile_write`");
}

test "unsafe capability lookup rejects unknown names" {
    if unsafecap::lookup("filesystem") |_| {
        testing::fail("unknown unsafe capability was accepted");
    }
}

test "unsafe capability all keeps display order" {
    let allocator = mem::page_allocator();
    let values = try unsafecap::all(allocator);
    defer values.deinit();
    testing::expect_equal<i64>(9, values.len());
    if values.at(0) |first| {
        testing::expect(mem::equal_bytes(first.name, "extern_call"));
    } else {
        testing::fail("missing first unsafe capability");
    }
    if values.at(8) |last| {
        testing::expect(mem::equal_bytes(last.name, "volatile"));
    } else {
        testing::fail("missing last unsafe capability");
    }
}

test "unsafe capability hint matches Go diagnostics" {
    let allocator = mem::page_allocator();
    if unsafecap::lookup("ptr_read") |info| {
        let text = try unsafecap::hint(allocator, info);
        defer text.deinit();
        let bytes = text.as_bytes();
        testing::expect(mem::equal_bytes(bytes,
            "`unsafe` here covers raw pointer reads with `ptr_read(p)`."));
    } else {
        testing::fail("missing ptr_read capability");
    }
}
