import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::fmt;
import compiler::internal::lexer;
import compiler::internal::lsp;
import compiler::internal::parser;
import compiler::internal::project;
import compiler::internal::source;
import compiler::internal::stdtarget;
import compiler::internal::types;
import std::array;
import std::fs;
import std::json;
import std::map;
import std::mem;
import std::path;
import std::string;

struct Problem {
    file: string::String,
    diagnostic: diagnostic::Diagnostic,
    text: string::String,
}

struct Session {
    lib_dir: string::String,
    documents: map::Map<[]u8, string::String>,
    published: array::Array<map::Map<[]u8, bool>>,
    snapshots: map::Map<[]u8, Snapshot>,
    valid_snapshots: map::Map<[]u8, Snapshot>,
    root: string::String,
    shut_down: bool,
}

fn (self: Session) deinit(allocator: Allocator) -> void {
    self.lib_dir.deinit(allocator);
    self.documents.deinit(allocator);
    self.published.deinit(allocator);
    self.snapshots.deinit(allocator);
    self.valid_snapshots.deinit(allocator);
    self.root.deinit(allocator);
    return;
}

fn lsp_command(io: Io, allocator: Allocator, lib_dir: []u8) -> !i64 {
    var session = Session {
        lib_dir: try string::from_bytes(allocator, lib_dir),
        documents: map::new<[]u8, string::String>(allocator),
        published: array::new<map::Map<[]u8, bool>>(allocator),
        snapshots: map::new<[]u8, Snapshot>(allocator),
        valid_snapshots: map::new<[]u8, Snapshot>(allocator),
        root: string::new(allocator),
        shut_down: false
    };
    defer session.deinit(allocator);
    var reader = lsp::new_reader(allocator);
    defer reader.deinit(allocator);
    var body = string::new(allocator);
    defer body.deinit(allocator);
    var queued = string::new(allocator);
    defer queued.deinit(allocator);
    while true {
        body.clear();
        if queued.len() > 0 {
            try body.append_string(allocator, &queued);
            queued.clear();
        } else if !try reader.next(allocator, &var body) {
            if session.shut_down {
                return 0;
            }
            return 1;
        }
        let body_bytes = body.as_bytes();
        if json::decode<json::Value>(allocator, body_bytes) |message| {
            defer message.deinit(allocator);
            let method = lsp::text_at(&message, "method");
            if mem::equal_bytes(method, "exit") {
                if session.shut_down {
                    return 0;
                }
                return 1;
            }
            if mem::equal_bytes(method, "textDocument/didChange") {
                let uri = lsp::text_at(&message, "params.textDocument.uri");
                try remember_change(allocator, &var session, uri, &message);
                try coalesce_changes(allocator, &var session, uri, &var reader, &var queued);
                try refresh_snapshot(io, allocator, &var session, uri);
                try publish(io, allocator, &var session);
            } else {
                try handle(io, allocator, &var session, method, &message);
            }
        } else |_| {}
    }
    return 1;
}

fn remember_change(allocator: Allocator, session: &var Session, uri: []u8, message: &json::Value) -> !void {
    let text = lsp::last_change(message);
    return remember(allocator, session, uri, text);
}

fn coalesce_changes(
    allocator: Allocator, session: &var Session, uri: []u8, reader: &var lsp::Reader, queued: &var string::String
) -> !void {
    while try reader.buffered(allocator, queued) {
        let bytes = queued.as_bytes();
        if json::decode<json::Value>(allocator, bytes) |message| {
            defer message.deinit(allocator);
            let method = lsp::text_at(&message, "method");
            let next_uri = lsp::text_at(&message, "params.textDocument.uri");
            if !mem::equal_bytes(method, "textDocument/didChange") or !mem::equal_bytes(next_uri, uri) {
                return;
            }
            try remember_change(allocator, session, uri, &message);
        } else |_| {}
        queued.clear();
    }
    return;
}

fn handle(io: Io, allocator: Allocator, session: &var Session, method: []u8, message: &json::Value) -> !void {
    if mem::equal_bytes(method, "initialize") {
        let root_uri = lsp::text_at(message, "params.rootUri");
        let _ = try lsp::path_of_uri(allocator, root_uri, &var session.root);
        return answer_initialize(io, allocator, message);
    }
    if mem::equal_bytes(method, "shutdown") {
        session.shut_down = true;
        var encoder = json::encoder(allocator);
        errdefer encoder.deinit(allocator);
        try lsp::begin_message(&var encoder);
        try lsp::write_id(&var encoder, message);
        try encoder.write_null_field("result");
        return lsp::finish(io, allocator, move encoder);
    }
    let uri = lsp::text_at(message, "params.textDocument.uri");
    if mem::equal_bytes(method, "textDocument/didOpen") {
        let text = lsp::text_at(message, "params.textDocument.text");
        try remember(allocator, session, uri, text);
        try refresh_snapshot(io, allocator, session, uri);
        return publish(io, allocator, session);
    }
    if mem::equal_bytes(method, "textDocument/didSave") {
        try refresh_snapshot(io, allocator, session, uri);
        return publish(io, allocator, session);
    }
    if mem::equal_bytes(method, "textDocument/didClose") {
        if session.documents.remove(allocator, uri) |old| {
            old.deinit(allocator);
        }
        try close_snapshot(io, allocator, session, uri);
        return publish(io, allocator, session);
    }
    if mem::equal_bytes(method, "textDocument/formatting") {
        return answer_formatting(io, allocator, session, message, uri);
    }
    if mem::equal_bytes(method, "textDocument/documentSymbol") {
        return answer_outline(io, allocator, session, message, uri, false);
    }
    if mem::equal_bytes(method, "textDocument/foldingRange") {
        return answer_outline(io, allocator, session, message, uri, true);
    }
    if !lsp::has(message, "id") {
        return;
    }
    if try answer_editor(io, allocator, session, message, method, uri) {
        return;
    }
    var encoder = json::encoder(allocator);
    errdefer encoder.deinit(allocator);
    try lsp::begin_message(&var encoder);
    try lsp::write_id(&var encoder, message);
    try encoder.begin_object_field("error");
    try encoder.write_i64_field("code", 0 - 32601);
    try encoder.write_bytes_field("message", method);
    try encoder.end_object();
    return lsp::finish(io, allocator, move encoder);
}

fn remember(allocator: Allocator, session: &var Session, uri: []u8, text: []u8) -> !void {
    if session.documents.remove(allocator, uri) |old| {
        old.deinit(allocator);
    }
    return session.documents.insert(allocator, uri, try string::from_bytes(allocator, text));
}

fn answer_initialize(io: Io, allocator: Allocator, message: &json::Value) -> !void {
    var encoder = json::encoder(allocator);
    errdefer encoder.deinit(allocator);
    try lsp::begin_message(&var encoder);
    try lsp::write_id(&var encoder, message);
    try encoder.begin_object_field("result");
    try encoder.begin_object_field("capabilities");
    try encoder.write_i64_field("textDocumentSync", 1);
    try encoder.write_bool_field("documentFormattingProvider", true);
    try encoder.write_bool_field("documentSymbolProvider", true);
    try encoder.write_bool_field("foldingRangeProvider", true);
    try editor_capabilities(&var encoder);
    try encoder.end_object();
    try encoder.begin_object_field("serverInfo");
    try encoder.write_bytes_field("name", "kizu");
    try encoder.end_object();
    try encoder.end_object();
    return lsp::finish(io, allocator, move encoder);
}

fn package_root(io: Io, allocator: Allocator, file: []u8, out: &var string::String) -> !bool {
    var dir = path::dirname(file);
    while mem::len(dir) > 0 {
        let manifest = try path::join(allocator, dir, "kizu.toml");
        defer manifest.deinit(allocator);
        let manifest_bytes = manifest.as_bytes();
        if fs::exists(io, manifest_bytes) catch false {
            try out.append_bytes(allocator, dir);
            return true;
        }
        let parent = path::dirname(dir);
        if mem::equal_bytes(parent, dir) {
            return false;
        }
        dir = parent;
    }
    return false;
}

fn add_problem(
    allocator: Allocator,
    sources: &source::SourceMap,
    fallback_file: []u8,
    failed: &diagnostic::Diagnostic,
    problems: &var array::Array<Problem>
) -> !void {
    var file = string::new(allocator);
    errdefer file.deinit(allocator);
    if failed.span.source |id| {
        if sources.at(id) |input| {
            try file.append_string(allocator, &input.path);
        }
    }
    if file.len() == 0 {
        try file.append_bytes(allocator, fallback_file);
    }
    var message = string::new(allocator);
    errdefer message.deinit(allocator);
    if failed.category.len() > 0 {
        try message.append_string(allocator, &failed.category);
        try message.append_bytes(allocator, ": ");
    }
    try message.append_string(allocator, &failed.message);
    var note_index = 0;
    while failed.notes.at(note_index) |note| {
        note_index = note_index + 1;
        try message.append_byte(allocator, cast<u8>(10));
        try message.append_string(allocator, note);
    }
    if failed.help.len() > 0 {
        try message.append_byte(allocator, cast<u8>(10));
        try message.append_bytes(allocator, "help: ");
        try message.append_string(allocator, &failed.help);
    }
    let retained = try failed.clone(allocator);
    return problems.append(allocator, Problem {
        file: move file, diagnostic: move retained, text: move message
    });
}

fn override_documents(allocator: Allocator, session: &Session, loader: &var project::Loader) -> !void {
    var index = 0;
    while session.documents.key_at(index) |uri| {
        index = index + 1;
        var file = string::new(allocator);
        defer file.deinit(allocator);
        if try lsp::path_of_uri(allocator, uri, &var file) {
            if session.documents.at(uri) |text| {
                let file_bytes = file.as_bytes();
                let text_bytes = text.as_bytes();
                try loader.override_source(file_bytes, text_bytes);
            }
        }
    }
    return;
}

fn load_for(
    io: Io,
    allocator: Allocator,
    session: &Session,
    loader: &var project::Loader,
    tree: &var ast::Ast,
    file: []u8,
    uri: []u8,
    package_name: &var string::String
) -> !project::LoadResult {
    var root = string::new(allocator);
    defer root.deinit(allocator);
    if try package_root(io, allocator, file, &var root) {
        let root_bytes = root.as_bytes();
        let include_tests = project::is_test_file(file) or try has_open_tests(io, allocator, session, root_bytes);
        return load_target(io, allocator, loader, tree, root_bytes, package_name, include_tests);
    }
    if session.documents.at(uri) |text| {
        let text_bytes = text.as_bytes();
        return loader.load_source(tree, file, text_bytes);
    }
    return load_target(io, allocator, loader, tree, file, package_name, false);
}

struct Snapshot {
    sources: source::SourceMap,
    index: types::SemanticIndex,
    files: map::Map<[]u8, project::EditorFile>,
    problems: array::Array<Problem>,
    reusable: bool,
}

fn copy_sources(allocator: Allocator, sources: &source::SourceMap) -> !source::SourceMap {
    var out = source::new(allocator);
    errdefer out.deinit(allocator);
    for 0..sources.len() |at| {
        if sources.at(source::SourceId { index: at }) |entry| {
            let path_bytes = entry.path.as_bytes();
            let text_bytes = entry.text.as_bytes();
            let file = try string::from_bytes(allocator, path_bytes);
            errdefer file.deinit(allocator);
            let text = try string::from_bytes(allocator, text_bytes);
            let _ = try out.add(move file, move text);
        }
    }
    return move out;
}

fn analyze(
    io: Io,
    allocator: Allocator,
    session: &Session,
    file: []u8,
    uri: []u8,
    previous: &Snapshot
) -> !Snapshot {
    let lib_dir = session.lib_dir.as_bytes();
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    tree.locate_names = true;
    var loader = try project::new_loader(io, allocator, lib_dir);
    defer loader.deinit(allocator);
    try override_documents(allocator, session, &var loader);
    var package_name = string::new(allocator);
    defer package_name.deinit(allocator);
    let loaded = try load_for(io, allocator, session, &var loader, &var tree, file, uri, &var package_name);
    var problems = array::new<Problem>(allocator);
    errdefer problems.deinit(allocator);
    match loaded {
        Error(failed) => {
            defer failed.deinit(allocator);
            let sources = try copy_sources(allocator, &loader.sources);
            errdefer sources.deinit(allocator);
            try add_problem(allocator, &sources, file, &failed, &var problems);
            return Snapshot {
                sources: move sources, index: types::new_index(allocator), problems: move problems,
                files: map::new<[]u8, project::EditorFile>(allocator), reusable: false
            };
        },
        Program(program) => {
            defer program.deinit(allocator);
            let sources = try copy_sources(allocator, &loader.sources);
            errdefer sources.deinit(allocator);
            let files = try loader.editor_files();
            errdefer files.deinit(allocator);
            let kernel = gpu_kernel(&tree, &program);
            var target = stdtarget::host();
            if !kernel.is_zero() {
                target = output_target(Output::Metal);
            }
            var unchanged = map::new<i64, bool>(allocator);
            defer unchanged.deinit(allocator);
            if kernel.is_zero() and !loader.embedded_inputs {
                try unchanged_editor_sources(allocator, &loader, &files, &tree, &program, previous, &var unchanged);
            }
            let checked = try types::check_indexed(allocator, &var tree, &program, target, &previous.index, &unchanged);
            let index = move checked.index;
            errdefer index.deinit(allocator);
            let failures = move checked.problems;
            defer failures.deinit(allocator);
            if loader.parse_diagnostics.at(0) |failed| {
                try add_problem(allocator, &sources, file, failed, &var problems);
            } else if failures.at(0) |failed| {
                try add_problem(allocator, &sources, file, failed, &var problems);
            } else {
                try check_editor_target(allocator, &var tree, &program, &var loader, file, kernel, target, &var problems, &unchanged);
            }
            let reusable = problems.len() == 0 and kernel.is_zero() and !loader.embedded_inputs;
            return Snapshot {
                sources: move sources, index: move index, problems: move problems, files: move files, reusable: reusable
            };
        },
    }
}

fn snapshot_key(io: Io, allocator: Allocator, file: []u8, key: &var string::String) -> !void {
    if !try package_root(io, allocator, file, key) {
        try key.append_bytes(allocator, file);
    }
    return;
}

fn refresh_snapshot(io: Io, allocator: Allocator, session: &var Session, uri: []u8) -> !void {
    var file = string::new(allocator);
    defer file.deinit(allocator);
    if !try lsp::path_of_uri(allocator, uri, &var file) {
        return;
    }
    let file_bytes = file.as_bytes();
    var key = string::new(allocator);
    defer key.deinit(allocator);
    try snapshot_key(io, allocator, file_bytes, &var key);
    let key_bytes = key.as_bytes();
    let snapshot = try analyze_with_previous(io, allocator, session, file_bytes, uri, key_bytes);
    errdefer snapshot.deinit(allocator);
    if session.snapshots.remove(allocator, key_bytes) |previous| {
        if previous.reusable and !snapshot.reusable {
            try remember_valid_snapshot(allocator, &var session.valid_snapshots, key_bytes, move previous);
        } else {
            previous.deinit(allocator);
        }
    }
    if snapshot.reusable {
        if session.valid_snapshots.remove(allocator, key_bytes) |previous| {
            previous.deinit(allocator);
        }
    }
    return session.snapshots.insert(allocator, key_bytes, move snapshot);
}

fn has_open_tests(io: Io, allocator: Allocator, session: &Session, root: []u8) -> !bool {
    var at = 0;
    while session.documents.key_at(at) |uri| {
        at = at + 1;
        var file = string::new(allocator);
        defer file.deinit(allocator);
        if !try lsp::path_of_uri(allocator, uri, &var file) {
            continue;
        }
        let path_bytes = file.as_bytes();
        if project::is_test_file(path_bytes) {
            var key = string::new(allocator);
            defer key.deinit(allocator);
            try snapshot_key(io, allocator, path_bytes, &var key);
            let package = key.as_bytes();
            if mem::equal_bytes(package, root) {
                return true;
            }
        }
    }
    return false;
}

fn close_snapshot(io: Io, allocator: Allocator, session: &var Session, uri: []u8) -> !void {
    var file = string::new(allocator);
    defer file.deinit(allocator);
    if !try lsp::path_of_uri(allocator, uri, &var file) {
        return;
    }
    let file_bytes = file.as_bytes();
    var key = string::new(allocator);
    defer key.deinit(allocator);
    try snapshot_key(io, allocator, file_bytes, &var key);
    let key_bytes = key.as_bytes();
    let replacement = try open_document_in(io, allocator, session, key_bytes);
    defer replacement.deinit(allocator);
    if replacement.len() > 0 {
        let replacement_uri = replacement.as_bytes();
        return refresh_snapshot(io, allocator, session, replacement_uri);
    }
    if session.snapshots.remove(allocator, key_bytes) |removed| {
        removed.deinit(allocator);
    }
    if session.valid_snapshots.remove(allocator, key_bytes) |removed| {
        removed.deinit(allocator);
    }
    return;
}

fn open_document_in(io: Io, allocator: Allocator, session: &Session, key: []u8) -> !string::String {
    var at = 0;
    while session.documents.key_at(at) |uri| {
        at = at + 1;
        var file = string::new(allocator);
        defer file.deinit(allocator);
        if try lsp::path_of_uri(allocator, uri, &var file) {
            var current = string::new(allocator);
            defer current.deinit(allocator);
            let file_bytes = file.as_bytes();
            try snapshot_key(io, allocator, file_bytes, &var current);
            let current_key = current.as_bytes();
            if mem::equal_bytes(key, current_key) {
                return string::from_bytes(allocator, uri);
            }
        }
    }
    return string::new(allocator);
}

fn publish(io: Io, allocator: Allocator, session: &var Session) -> !void {
    var active = map::new<[]u8, bool>(allocator);
    errdefer active.deinit(allocator);
    var document_index = 0;
    while session.documents.key_at(document_index) |document| {
        document_index = document_index + 1;
        try active.insert(allocator, document, true);
    }
    var snapshot_index = 0;
    while session.snapshots.key_at(snapshot_index) |key| {
        snapshot_index = snapshot_index + 1;
        if session.snapshots.at(key) |snapshot| {
            var problem_index = 0;
            while snapshot.problems.at(problem_index) |problem| {
                problem_index = problem_index + 1;
                var problem_uri = string::new(allocator);
                defer problem_uri.deinit(allocator);
                let file = problem.file.as_bytes();
                try lsp::uri_of_path(allocator, file, &var problem_uri);
                let bytes = problem_uri.as_bytes();
                try active.insert(allocator, bytes, true);
            }
        }
    }
    try send_diagnostics(io, allocator, session, &active);
    if session.published.pop() |previous| {
        previous.deinit(allocator);
    }
    return session.published.append(allocator, move active);
}

fn send_diagnostics(io: Io, allocator: Allocator, session: &Session, active: &map::Map<[]u8, bool>) -> !void {
    var at = 0;
    if session.published.at(0) |published| {
        while published.key_at(at) |previous| {
            at = at + 1;
            if !active.contains(previous) {
                try publish_empty(io, allocator, previous);
            }
        }
    }
    at = 0;
    while active.key_at(at) |current| {
        at = at + 1;
        try publish_problems(io, allocator, session, current);
    }
    return;
}

fn begin_diagnostics(encoder: &var json::Encoder, uri: []u8) -> !void {
    try lsp::begin_message(encoder);
    try encoder.write_bytes_field("method", "textDocument/publishDiagnostics");
    try encoder.begin_object_field("params");
    try encoder.write_bytes_field("uri", uri);
    return encoder.begin_array_field("diagnostics");
}

fn end_diagnostics(encoder: &var json::Encoder) -> !void {
    try encoder.end_array();
    return encoder.end_object();
}

fn publish_empty(io: Io, allocator: Allocator, uri: []u8) -> !void {
    var encoder = json::encoder(allocator);
    errdefer encoder.deinit(allocator);
    try begin_diagnostics(&var encoder, uri);
    try end_diagnostics(&var encoder);
    return lsp::finish(io, allocator, move encoder);
}

fn publish_problems(io: Io, allocator: Allocator, session: &Session, uri: []u8) -> !void {
    var file = string::new(allocator);
    defer file.deinit(allocator);
    if !try lsp::path_of_uri(allocator, uri, &var file) {
        return;
    }
    let file_bytes = file.as_bytes();
    var encoder = json::encoder(allocator);
    errdefer encoder.deinit(allocator);
    try begin_diagnostics(&var encoder, uri);
    var snapshot_index = 0;
    while session.snapshots.key_at(snapshot_index) |key| {
        snapshot_index = snapshot_index + 1;
        if session.snapshots.at(key) |snapshot| {
            var at = 0;
            while snapshot.problems.at(at) |problem| {
                at = at + 1;
                let problem_file = problem.file.as_bytes();
                if mem::equal_bytes(problem_file, file_bytes) {
                    try write_problem(allocator, &var encoder, &snapshot.sources, problem);
                }
            }
        }
    }
    try end_diagnostics(&var encoder);
    return lsp::finish(io, allocator, move encoder);
}

fn diagnostic_span(span: ast::Span) -> ast::Span {
    if !before_position(span.start, span.end) {
        return ast::Span {
            source: span.source, start: span.start,
            end: ast::Position { line: span.start.line, column: span.start.column + 1 }
        };
    }
    return span;
}

fn write_problem(allocator: Allocator, encoder: &var json::Encoder, sources: &source::SourceMap, problem: &Problem) -> !void {
    let failed = &problem.diagnostic;
    try encoder.begin_object();
    var has_range = false;
    if failed.span.source |id| {
        has_range = !failed.span.is_zero() and id.index >= 0 and id.index < sources.len();
    }
    if has_range {
        try write_span(encoder, sources, "range", diagnostic_span(failed.span));
    } else {
        try lsp::write_range(encoder, "range", 0, 0, 0, 1);
    }
    var severity = 1;
    if failed.severity == diagnostic::Severity::Warning {
        severity = 2;
    }
    try encoder.write_i64_field("severity", severity);
    try encoder.write_bytes_field("source", "kizu");
    let code = failed.code.as_bytes();
    if mem::len(code) > 0 {
        try encoder.write_bytes_field("code", code);
    }
    let text = problem.text.as_bytes();
    try encoder.write_bytes_field("message", text);
    if failed.related.len() > 0 {
        try encoder.begin_array_field("relatedInformation");
        var at = 0;
        while failed.related.at(at) |related| {
            at = at + 1;
            let id = related.span.source orelse continue;
            let label = related.label.as_bytes();
            try encoder.begin_object();
            try encoder.begin_object_field("location");
            try write_uri(allocator, encoder, sources, id);
            try write_span(encoder, sources, "range", diagnostic_span(related.span));
            try encoder.end_object();
            try encoder.write_bytes_field("message", label);
            try encoder.end_object();
        }
        try encoder.end_array();
    }
    return encoder.end_object();
}

fn line_count(text: []u8) -> i64 {
    var lines = 0;
    for 0..mem::len(text) |index| {
        if text[index] == cast<u8>(10) {
            lines = lines + 1;
        }
    }
    return lines + 1;
}

fn parses(allocator: Allocator, file: []u8, text: []u8) -> !bool {
    var sources = source::new(allocator);
    defer sources.deinit(allocator);
    let held_path = try string::from_bytes(allocator, file);
    errdefer held_path.deinit(allocator);
    let held_text = try string::from_bytes(allocator, text);
    let id = try sources.add(move held_path, move held_text);
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    if sources.at(id) |input| {
        let bytes = input.text.as_bytes();
        let scanner = lexer::new_source(allocator, id, bytes);
        var source_parser = try parser::new(allocator, move scanner);
        defer source_parser.deinit(allocator);
        let program = try source_parser.parse_program(&var tree);
        defer program.deinit(allocator);
        return source_parser.diagnostics_len() == 0;
    }
    return false;
}

fn answer_formatting(io: Io, allocator: Allocator, session: &Session, message: &json::Value, uri: []u8) -> !void {
    var encoder = json::encoder(allocator);
    errdefer encoder.deinit(allocator);
    try lsp::begin_message(&var encoder);
    try lsp::write_id(&var encoder, message);
    var file = string::new(allocator);
    defer file.deinit(allocator);
    let known = try lsp::path_of_uri(allocator, uri, &var file);
    let file_bytes = file.as_bytes();
    if !known {
        try encoder.write_null_field("result");
        return lsp::finish(io, allocator, move encoder);
    }
    if session.documents.at(uri) |text| {
        let original = text.as_bytes();
        if !try parses(allocator, file_bytes, original) {
            try encoder.write_null_field("result");
            return lsp::finish(io, allocator, move encoder);
        }
        var marked = try string::from_bytes(allocator, original);
        defer marked.deinit(allocator);
        let lib_dir = session.lib_dir.as_bytes();
        let inserted = try insert_move_markers(io, allocator, lib_dir, file_bytes, &var marked);
        match inserted {
            Ok => {},
            Outside(_) => {
                try encoder.write_null_field("result");
                return lsp::finish(io, allocator, move encoder);
            },
        }
        let marked_bytes = marked.as_bytes();
        let formatted = try fmt::format(allocator, marked_bytes);
        defer formatted.deinit(allocator);
        let formatted_bytes = formatted.as_bytes();
        try encoder.begin_array_field("result");
        if !mem::equal_bytes(formatted_bytes, original) {
            try encoder.begin_object();
            try lsp::write_range(&var encoder, "range", 0, 0, line_count(original), 0);
            try encoder.write_bytes_field("newText", formatted_bytes);
            try encoder.end_object();
        }
        try encoder.end_array();
        return lsp::finish(io, allocator, move encoder);
    }
    try encoder.write_null_field("result");
    return lsp::finish(io, allocator, move encoder);
}

struct Outline {
    name: string::String,
    kind: i64,
    span: ast::Span,
}

fn text_bytes(tree: &ast::Ast, text: ast::Text) -> []u8 {
    let held = tree.texts.at(text.node);
    let bytes = held.as_bytes();
    return bytes;
}

fn outline_of(allocator: Allocator, tree: &ast::Ast, declaration: &ast::Declaration, out: &var array::Array<Outline>) -> !void {
    let handle = declaration.span orelse return;
    let span = tree.spans.at(handle).*;
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    var kind = 0;
    match tree.declarations.at(declaration.node) {
        Function(function) => {
            try name.append_bytes(allocator, text_bytes(tree, function.signature.name));
            kind = 12;
        },
        Test(test_decl) => {
            try name.append_bytes(allocator, "test ");
            try name.append_bytes(allocator, text_bytes(tree, test_decl.name));
            kind = 12;
        },
        Struct(declared) => {
            try name.append_bytes(allocator, text_bytes(tree, declared.name));
            kind = 23;
        },
        Enum(declared) => {
            try name.append_bytes(allocator, text_bytes(tree, declared.name));
            kind = 10;
        },
        ErrorSet(declared) => {
            try name.append_bytes(allocator, text_bytes(tree, declared.name));
            kind = 10;
        },
        Union(declared) => {
            try name.append_bytes(allocator, text_bytes(tree, declared.name));
            kind = 10;
        },
        Contract(declared) => {
            try name.append_bytes(allocator, text_bytes(tree, declared.name));
            kind = 11;
        },
        Impl(declared) => {
            try name.append_bytes(allocator, text_bytes(tree, declared.contract_name));
            try name.append_bytes(allocator, " for ");
            try name.append_bytes(allocator, text_bytes(tree, declared.type_name));
            kind = 19;
        },
        Const(declared) => {
            try name.append_bytes(allocator, text_bytes(tree, declared.name));
            kind = 14;
        },
        _ => {},
    }
    if kind == 0 or name.len() == 0 {
        name.deinit(allocator);
        return;
    }
    return out.append(allocator, Outline { name: move name, kind: kind, span: span });
}

fn answer_outline(io: Io, allocator: Allocator, session: &Session, message: &json::Value, uri: []u8, folding: bool) -> !void {
    var encoder = json::encoder(allocator);
    errdefer encoder.deinit(allocator);
    try lsp::begin_message(&var encoder);
    try lsp::write_id(&var encoder, message);
    try encoder.begin_array_field("result");
    var outline = array::new<Outline>(allocator);
    defer outline.deinit(allocator);
    if session.documents.at(uri) |text| {
        var sources = source::new(allocator);
        defer sources.deinit(allocator);
        let held = text.as_bytes();
        let held_path = try string::from_bytes(allocator, uri);
        errdefer held_path.deinit(allocator);
        let held_text = try string::from_bytes(allocator, held);
        let id_in_map = try sources.add(move held_path, move held_text);
        var tree = ast::new(allocator);
        defer tree.deinit(allocator);
        if sources.at(id_in_map) |input| {
            let bytes = input.text.as_bytes();
            let scanner = lexer::new_source(allocator, id_in_map, bytes);
            var source_parser = try parser::new(allocator, move scanner);
            defer source_parser.deinit(allocator);
            let program = try source_parser.parse_program(&var tree);
            defer program.deinit(allocator);
            var index = 0;
            while program.declarations.at(index) |declaration| {
                index = index + 1;
                try outline_of(allocator, &tree, declaration, &var outline);
            }
        }
    }
    var document = string::new(allocator);
    defer document.deinit(allocator);
    if session.documents.at(uri) |text| {
        try document.append_string(allocator, text);
    }
    let document_bytes = document.as_bytes();
    var index = 0;
    while outline.at(index) |entry| {
        index = index + 1;
        var start_line = entry.span.start.line - 1;
        var end_line = entry.span.end.line - 1;
        if start_line < 0 {
            start_line = 0;
        }
        if end_line < start_line {
            end_line = start_line;
        }
        let start_character = lsp::utf16_column(document_bytes, start_line, entry.span.start.column - 1);
        let end_character = lsp::utf16_column(document_bytes, end_line, entry.span.end.column - 1);
        if folding {
            if end_line > start_line {
                try encoder.begin_object();
                try encoder.write_i64_field("startLine", start_line);
                try encoder.write_i64_field("endLine", end_line);
                try encoder.end_object();
            }
            continue;
        }
        try encoder.begin_object();
        let name = entry.name.as_bytes();
        try encoder.write_bytes_field("name", name);
        try encoder.write_i64_field("kind", entry.kind);
        try lsp::write_range(&var encoder, "range", start_line, start_character, end_line, end_character);
        try lsp::write_range(&var encoder, "selectionRange", start_line, start_character, start_line, start_character);
        try encoder.end_object();
    }
    try encoder.end_array();
    return lsp::finish(io, allocator, move encoder);
}
