import compiler::internal::ast;
import compiler::internal::buildcache;
import compiler::internal::cimport;
import compiler::internal::diagnostic;
import compiler::internal::fmt;
import compiler::internal::fsutil;
import compiler::internal::ir;
import compiler::internal::lexer;
import compiler::internal::llvm;
import compiler::internal::manifest;
import compiler::internal::native;
import compiler::internal::ownership;
import compiler::internal::parser;
import compiler::internal::pool;
import compiler::internal::project;
import compiler::internal::source;
import compiler::internal::stdfmt;
import compiler::internal::stdtarget;
import compiler::internal::types;
import compiler::internal::version;
import compiler::internal::wasm;
import std::array;
import std::fs;
import std::io;
import std::mem;
import std::path;
import std::process;
import std::string;

// Port of cmd/kizu for the commands the selfhost compiler can run so far:
// `parse` prints the program a file parses to, `fmt` validates and formats a
// file, `init` scaffolds a package, `check` loads a file or a package with its
// std modules, type-checks it, and ownership-checks it,
// `ir` lowers a checked file or package to typed SSA IR and prints it,
// `build --emit-llvm` prints the LLVM IR the lowered module emits to,
// `build --target wasm32-wasi` and `build --target wasm32-browser` emit
// WebAssembly text or binary for one source file, and the browser target can
// emit the binary beside its JavaScript ESM host,
// `build --target native` links a program into the executable it names,
// `run` / `test` build a temporary executable and run it, forwarding
// the child's exit status through `std::process::ExitStatus` (ADR-0085),
// `import-c-header` prints the externs a C header maps to,
// and `version` names the binary from the VCS state it was generated with.
// Not connected to the shipping CLI.

/// Dispatches the command line and maps each command's exit code to the
/// `std::process::ExitStatus` the process ends with: 0 is Success, and any
/// other code is Specific, so a child's status crosses `run` unchanged.
fn main() -> !process::ExitStatus {
    // The compiler allocates and releases about eighteen million small blocks
    // in one run, so it brings its own allocator rather than paying libc's
    // general one for each (ADR-0129).
    var pool = try pool::new(mem::page_allocator());
    defer pool.deinit(mem::page_allocator());
    let allocator = pool::allocator_of(&var pool);
    let io = io::blocking();
    // std::process counts the user arguments only; arg(0) is the first one.
    let count = process::arg_count();
    var next = 0;
    var lib_dir = string::new(allocator);
    defer lib_dir.deinit(allocator);
    if count >= 2 {
        let first = try process::arg(0);
        if mem::equal_bytes(first, "--lib-dir") {
            let given = try process::arg(1);
            try lib_dir.append_bytes(allocator, given);
            next = 2;
        }
    }
    if lib_dir.len() == 0 {
        try resolve_lib_dir(io, allocator, &var lib_dir);
    }
    if count - next < 1 {
        try usage(io);
        return process::ExitStatus::Specific(2);
    }
    let command = try process::arg(next);
    if mem::equal_bytes(command, "init") {
        let code = try init_command(io, allocator, next, count);
        return exit_of(code);
    }
    if mem::equal_bytes(command, "version") or mem::equal_bytes(command, "--version") {
        let code = try version_command(io, next, count);
        return exit_of(code);
    }
    if count - next < 2 {
        try usage(io);
        return process::ExitStatus::Specific(2);
    }
    let target = try process::arg(next + 1);
    let lib_dir_bytes = lib_dir.as_bytes();
    if mem::equal_bytes(command, "parse") {
        if count - next != 2 {
            try usage(io);
            try io::write_stderr_line(io, "error: parse takes one target");
            return process::ExitStatus::Specific(1);
        }
        let code = try parse_file(io, allocator, target);
        return exit_of(code);
    }
    if mem::equal_bytes(command, "check") {
        if count - next != 2 {
            try usage(io);
            try io::write_stderr_line(io, "error: check takes one target");
            return process::ExitStatus::Specific(1);
        }
        let code = try lower_target(io, allocator, lib_dir_bytes, target, false, Output::Check, "");
        return exit_of(code);
    }
    if mem::equal_bytes(command, "fmt") {
        let code = try fmt_command(
            io,
            allocator,
            lib_dir_bytes,
            next,
            count
        );
        return exit_of(code);
    }
    if mem::equal_bytes(command, "ir") {
        let code = try opt_file_command(io, allocator, lib_dir_bytes, next + 1, count, Output::Ir);
        return exit_of(code);
    }
    if mem::equal_bytes(command, "run") {
        let code = try run_command(io, allocator, lib_dir_bytes, target, next, count);
        return exit_of(code);
    }
    if mem::equal_bytes(command, "test") {
        let code = try test_command(io, allocator, lib_dir_bytes, target, next, count);
        return exit_of(code);
    }
    if mem::equal_bytes(command, "cache") {
        let code = try cache_command(io, allocator, target, next, count);
        return exit_of(code);
    }
    if mem::equal_bytes(command, "import-c-header") {
        let code = try import_c_header_command(io, allocator, target);
        return exit_of(code);
    }
    if mem::equal_bytes(command, "build") {
        let code = try build_command(io, allocator, lib_dir_bytes, next, count);
        return exit_of(code);
    }
    try usage(io);
    try report_unknown_command(io, allocator, command);
    return process::ExitStatus::Specific(1);
}

/// Writes the line the Go `dispatch` default arm returns for a command this
/// binary does not have.
fn report_unknown_command(io: Io, allocator: Allocator, command: []u8) -> !void {
    var message = try string::from_bytes(allocator, "error: unknown command `");
    defer message.deinit(allocator);
    try message.append_bytes(allocator, command);
    try message.append_bytes(allocator, "`");
    let message_bytes = message.as_bytes();
    return io::write_stderr_line(io, message_bytes);
}

/// Is one source file read, or the message the CLI prints for its failure.
union SourceRead {
    Text(string::String),
    Failed(string::String),
}

/// Reads one file, naming a failure the way the Go CLI names the `os.ReadFile`
/// error it stops at. The path is the caller's, so the error itself does not
/// have to carry it.
fn read_source_file(io: Io, allocator: Allocator, path: []u8) -> !SourceRead {
    if fs::read_file(io, allocator, path, mem::Limit::Unlimited) |text| {
        return SourceRead::Text(move text);
    } else |failed| {
        var message = string::new(allocator);
        errdefer message.deinit(allocator);
        try append_read_failure(allocator, io, &var message, path, failed);
        return SourceRead::Failed(move message);
    }
}

/// Appends the message one read failure prints: the syscall that failed, the
/// path, and the reason. Go's `os.ReadFile` opens and then reads, so `open`
/// names a failure to open and `read` one to read. The runtime folds every
/// read-stage errno into ReadFailed, so a directory is recognized by asking
/// the file system rather than by the error alone.
fn append_read_failure(allocator: Allocator,
    io: Io,
    out: &var string::String,
    path: []u8,
    failed: fs::Error
) -> !void {
    if read_stage_failure(failed) {
        try out.append_bytes(allocator, "read ");
        try out.append_bytes(allocator, path);
        if is_directory(io, path) {
            return out.append_bytes(allocator, ": is a directory");
        }
        return out.append_bytes(allocator, ": input/output error");
    }
    try out.append_bytes(allocator, "open ");
    try out.append_bytes(allocator, path);
    try out.append_bytes(allocator, ": ");
    let reason = open_failure_reason(failed);
    return out.append_bytes(allocator, reason);
}

/// Reports the failure the runtime raises once the file is already open.
fn read_stage_failure(failed: fs::Error) -> bool {
    return match failed {
        ReadFailed => true,
        _ => false,
    };
}

/// Returns the reason text the C library gives one open failure, the text the
/// Go error carries from errno.
fn open_failure_reason(failed: fs::Error) -> []u8 {
    return match failed {
        NotFound => "no such file or directory",
        PermissionDenied => "permission denied",
        IsDirectory => "is a directory",
        NotDirectory => "not a directory",
        AlreadyExists => "file exists",
        DirectoryNotEmpty => "directory not empty",
        NoSpaceLeft => "no space left on device",
        TooManyOpenFiles => "too many open files",
        InvalidPath => "invalid argument",
        OutOfMemory => "cannot allocate memory",
        LimitExceeded => "file too large",
        _ => "input/output error",
    };
}

/// Reports whether a path names a directory, answering without a failure of
/// its own: a path the file system cannot describe is not one.
fn is_directory(io: Io, path: []u8) -> bool {
    let found = fs::exists(io, path) catch false;
    if !found {
        return false;
    }
    let info = fs::metadata(io, path) catch return false;
    return info.is_dir;
}

/// Writes one top-level failure line, the Go `printError` prefix.
fn write_error_line(io: Io, allocator: Allocator, message: []u8) -> !void {
    var line = try string::from_bytes(allocator, "error: ");
    defer line.deinit(allocator);
    try line.append_bytes(allocator, message);
    let bytes = line.as_bytes();
    return io::write_stderr_line(io, bytes);
}

/// Turns one read failure message into the diagnostic a load reports.
fn load_read_failure(allocator: Allocator, message: &string::String) -> !project::LoadResult {
    let bytes = message.as_bytes();
    let failed = try diagnostic::from_text(allocator,
        diagnostic::Severity::Error,
        ast::zero_span(),
        bytes
    );
    return project::LoadResult::Error(move failed);
}

/// Maps one command exit code to the ExitStatus main returns.
fn exit_of(code: i64) -> process::ExitStatus {
    if code == 0 {
        return process::ExitStatus::Success;
    }
    return process::ExitStatus::Specific(cast<u8>(code));
}

/// Names what a lowered module produces: its IR dump, LLVM IR, WebAssembly
/// text or binary, the browser binary beside its ESM host, or nothing but the
/// promise that emitting succeeded, which is what `check` prints.
enum Output {
    Ir,
    Llvm,
    Wasm,
    WasmBinary,
    WasmBrowser,
    WasmBrowserBinary,
    WasmBrowserEsm,
    Check,
}

/// Maps one output family to the target visible during compile-time selection.
fn output_target(output: Output) -> stdtarget::Target {
    if output == Output::WasmBrowser or output == Output::WasmBrowserBinary or
        output == Output::WasmBrowserEsm {
        return stdtarget::Target::WasmBrowser;
    }
    if output == Output::Wasm or output == Output::WasmBinary {
        return stdtarget::Target::WasmWasi;
    }
    return stdtarget::Target::Native;
}

/// Closes an executable module over its entry and the exports one target can
/// enter before a backend validates host capabilities.
fn keep_target_program(
    allocator: Allocator,
    module: &var ir::Module,
    export_abi: []u8
) -> !void {
    var roots = array::new<string::String>(allocator);
    defer roots.deinit(allocator);
    let main_root = try string::from_bytes(allocator, "main");
    try roots.append(allocator, move main_root);
    return ir::keep_target_reachable_functions(
        allocator, module, &roots, export_abi
    );
}

/// Runs one `[--opt] <target>` command, the Go `parseOptFileArgs` and the
/// command it feeds: `ir`, `build --emit-llvm` and `build --target wasm32-wasi`
/// take the same shape. A lone `--opt` names the flag, not a file.
fn opt_file_command(
    io: Io,
    allocator: Allocator,
    lib_dir: []u8,
    start: i64,
    count: i64,
    output: Output
) -> !i64 {
    if count - start == 1 {
        let only = try process::arg(start);
        if !mem::equal_bytes(only, "--opt") {
            return lower_target(io, allocator, lib_dir, only, false, output, "");
        }
    }
    if count - start == 2 {
        let flag = try process::arg(start);
        if mem::equal_bytes(flag, "--opt") {
            let target = try process::arg(start + 1);
            return lower_target(io, allocator, lib_dir, target, true, output, "");
        }
    }
    try usage(io);
    try io::write_stderr_line(io, "error: invalid command arguments");
    return 1;
}

/// Runs `build <--emit-llvm|--target> ...`, the Go `buildFile` over
/// `emitTargetFile`: anything else names no build this binary has.
fn build_command(io: Io, allocator: Allocator, lib_dir: []u8, next: i64, count: i64) -> !i64 {
    if count - next < 3 {
        try usage(io);
        try io::write_stderr_line(io, "error: invalid build command");
        return 1;
    }
    let kind = try process::arg(next + 1);
    if mem::equal_bytes(kind, "--emit-llvm") {
        return opt_file_command(io, allocator, lib_dir, next + 2, count, Output::Llvm);
    }
    if !mem::equal_bytes(kind, "--target") {
        try usage(io);
        try io::write_stderr_line(io, "error: invalid build command");
        return 1;
    }
    let target_kind = try process::arg(next + 2);
    if mem::equal_bytes(target_kind, "wasm32-wasi") {
        return wasm_build_command(io, allocator, lib_dir, next + 3, count, false);
    }
    if mem::equal_bytes(target_kind, "wasm32-browser") {
        return wasm_build_command(io, allocator, lib_dir, next + 3, count, true);
    }
    if mem::equal_bytes(target_kind, "native") {
        return build_native_command(io, allocator, lib_dir, next + 3, count);
    }
    try usage(io);
    var message = try string::from_bytes(allocator, "error: invalid build target `");
    defer message.deinit(allocator);
    try message.append_bytes(allocator, target_kind);
    try message.append_bytes(allocator, "`");
    let message_bytes = message.as_bytes();
    try io::write_stderr_line(io, message_bytes);
    return 1;
}

struct WasmBuildOptions {
    path: string::String,
    output: string::String,
    issue_detail: string::String,
    opt: bool,
    binary: bool,
    esm: bool
}

fn wasm_build_options_new(allocator: Allocator) -> WasmBuildOptions {
    return WasmBuildOptions {
        path: string::new(allocator),
        output: string::new(allocator),
        issue_detail: string::new(allocator),
        opt: false,
        binary: false,
        esm: false
    };
}

enum WasmBuildParseIssue {
    DuplicateOpt,
    EmitNeedsFormat,
    InvalidEmit,
    InvalidOutput,
    InvalidArguments,
    MissingSource,
}

/// Parses and runs the explicit WAT, binary wasm, or browser ESM artifact
/// command. Binary files and ESM directories require `-o`; the legacy
/// no-option form still writes WAT to stdout.
fn wasm_build_command(
    io: Io,
    allocator: Allocator,
    lib_dir: []u8,
    start: i64,
    count: i64,
    browser: bool
) -> !i64 {
    var options = wasm_build_options_new(allocator);
    defer options.deinit(allocator);
    if try parse_wasm_build_options(
        allocator, start, count, browser, &var options
    ) |issue| {
        try report_wasm_build_parse_issue(io, issue, browser, &options.issue_detail);
        return 1;
    }
    if options.binary and options.output.len() == 0 {
        try io::write_stderr_line(io, "error: binary wasm output requires -o <path>");
        return 1;
    }
    if options.esm and options.output.len() == 0 {
        try io::write_stderr_line(io, "error: browser esm output requires -o <directory>");
        return 1;
    }
    let path = options.path.as_bytes();
    let output_file = options.output.as_bytes();
    var output = Output::Wasm;
    if browser and options.esm {
        output = Output::WasmBrowserEsm;
    } else {
        if browser and options.binary {
            output = Output::WasmBrowserBinary;
        } else {
            if browser {
                output = Output::WasmBrowser;
            } else {
                if options.binary {
                    output = Output::WasmBinary;
                }
            }
        }
    }
    return lower_target(
        io,
        allocator,
        lib_dir,
        path,
        options.opt,
        output,
        output_file
    );
}

fn parse_wasm_build_options(
    allocator: Allocator,
    start: i64,
    count: i64,
    browser: bool,
    out: &var WasmBuildOptions
) -> !?WasmBuildParseIssue {
    var index = start;
    var opt_seen = false;
    var emit_seen = false;
    while index < count {
        let argument = try process::arg(index);
        index = index + 1;
        if mem::equal_bytes(argument, "--opt") {
            if opt_seen {
                return WasmBuildParseIssue::DuplicateOpt;
            }
            opt_seen = true;
            out.opt = true;
            continue;
        }
        if mem::equal_bytes(argument, "--emit") {
            if emit_seen {
                return WasmBuildParseIssue::InvalidArguments;
            }
            if index >= count {
                return WasmBuildParseIssue::EmitNeedsFormat;
            }
            emit_seen = true;
            let format = try process::arg(index);
            index = index + 1;
            if mem::equal_bytes(format, "wasm") {
                out.binary = true;
                continue;
            }
            if mem::equal_bytes(format, "wat") {
                out.binary = false;
                continue;
            }
            if browser and mem::equal_bytes(format, "esm") {
                out.esm = true;
                continue;
            }
            try out.issue_detail.append_bytes(allocator, format);
            return WasmBuildParseIssue::InvalidEmit;
        }
        if mem::equal_bytes(argument, "-o") or mem::equal_bytes(argument, "--output") {
            if out.output.len() > 0 or index >= count {
                return WasmBuildParseIssue::InvalidOutput;
            }
            let path = try process::arg(index);
            index = index + 1;
            try out.output.append_bytes(allocator, path);
            continue;
        }
        if mem::len(argument) > 0 and argument[0] == cast<u8>(45) {
            return WasmBuildParseIssue::InvalidArguments;
        }
        if out.path.len() > 0 {
            return WasmBuildParseIssue::InvalidArguments;
        }
        try out.path.append_bytes(allocator, argument);
    }
    if out.path.len() == 0 {
        return WasmBuildParseIssue::MissingSource;
    }
    return null;
}

/// Reports the user-input failure returned by the wasm option parser. Runtime
/// failures still use `!`; malformed command lines are typed data with the
/// invalid format retained as payload instead of being collapsed to null.
fn report_wasm_build_parse_issue(
    io: Io,
    issue: WasmBuildParseIssue,
    browser: bool,
    detail: &string::String
) -> !void {
    match issue {
        DuplicateOpt => try io::write_stderr_line(io, "error: duplicate --opt"),
        EmitNeedsFormat => {
            if browser {
                try io::write_stderr_line(io, "error: --emit needs wat, wasm, or esm");
            } else {
                try io::write_stderr_line(io, "error: --emit needs wat or wasm");
            }
        },
        InvalidEmit => {
            try io::write_stderr(io, "error: invalid wasm emit `");
            let bytes = detail.as_bytes();
            try io::write_stderr(io, bytes);
            try io::write_stderr_line(io, "`");
        },
        InvalidOutput => try io::write_stderr_line(io, "error: invalid wasm output path"),
        InvalidArguments => try io::write_stderr_line(io, "error: invalid wasm build arguments"),
        MissingSource => try io::write_stderr_line(io, "error: wasm build needs one source or package path"),
    }
    return;
}

/// Runs `version`, the Go `versionCommand`: the binary names itself and takes
/// nothing else. The line is generated with the compiler, because a selfhost
/// build has no linker flag to stamp and no build info to read.
fn version_command(io: Io, next: i64, count: i64) -> !i64 {
    if count - next != 1 {
        try usage(io);
        try io::write_stderr_line(io, "error: version takes no arguments");
        return 1;
    }
    try io::write_stdout_line(io, version::version_string());
    return 0;
}

/// Writes the usage lines for the commands this binary has.
fn usage(io: Io) -> !void {
    try io::write_stderr_line(io, "usage: kizu <parse|run|check|test> <file> [-- args...]");
    try io::write_stderr_line(io, "usage: kizu init [path]");
    try io::write_stderr_line(io, "usage: kizu fmt [--write] <file>");
    try io::write_stderr_line(io, "usage: kizu ir [--opt] <file>");
    try io::write_stderr_line(io, "usage: kizu build --emit-llvm [--opt] <file>");
    try io::write_stderr_line(io, "usage: kizu build --target native [native-options] <file>");
    try io::write_stderr_line(io, "usage: kizu build --target wasm32-wasi [--emit wat] [--opt] [-o file] <file|package>");
    try io::write_stderr_line(io, "usage: kizu build --target wasm32-wasi --emit wasm -o file [--opt] <file|package>");
    try io::write_stderr_line(io, "usage: kizu build --target wasm32-browser [--emit wat] [--opt] [-o file] <file|package>");
    try io::write_stderr_line(io, "usage: kizu build --target wasm32-browser --emit wasm -o file [--opt] <file|package>");
    try io::write_stderr_line(io, "usage: kizu build --target wasm32-browser --emit esm -o directory [--opt] <file|package>");
    try io::write_stderr_line(io, "usage: kizu cache <status|prune>");
    try io::write_stderr_line(io, "usage: kizu import-c-header <file>");
    return io::write_stderr_line(io, "usage: kizu version");
}

/// Runs `cache <status|prune>`, the Go `cacheCommand`, printing the same
/// lines the Go CLI prints.
fn cache_command(io: Io, allocator: Allocator, action: []u8, next: i64, count: i64) -> !i64 {
    if count - next != 2 {
        try usage(io);
        try io::write_stderr_line(io, "error: invalid cache command");
        return 1;
    }
    if mem::equal_bytes(action, "status") {
        var cache = try buildcache::new(io, allocator);
        defer cache.deinit(allocator);
        let current = try cache.status(io, allocator);
        defer current.deinit(allocator);
        var dir_line = string::new(allocator);
        defer dir_line.deinit(allocator);
        try dir_line.append_bytes(allocator, "cache dir: ");
        try dir_line.append_string(allocator, &current.dir);
        let dir_line_bytes = dir_line.as_bytes();
        try io::write_stdout_line(io, dir_line_bytes);
        try write_count_line(io, allocator, "entries: ", current.entries);
        try write_count_line(io, allocator, "size bytes: ", current.size_bytes);
        try write_count_line(io, allocator, "max bytes: ", current.max_bytes);
        return 0;
    }
    if mem::equal_bytes(action, "prune") {
        var cache = try buildcache::new(io, allocator);
        defer cache.deinit(allocator);
        let removed = try cache.prune(io, allocator);
        var line = string::new(allocator);
        defer line.deinit(allocator);
        try line.append_bytes(allocator, "cache pruned: removed ");
        try stdfmt::append_i64(allocator, &var line, removed.entries);
        try line.append_bytes(allocator, " entries, freed ");
        try stdfmt::append_i64(allocator, &var line, removed.bytes);
        try line.append_bytes(allocator, " bytes");
        let line_bytes = line.as_bytes();
        try io::write_stdout_line(io, line_bytes);
        return 0;
    }
    try usage(io);
    try io::write_stderr_line(io, "error: invalid cache command");
    return 1;
}

/// Writes one `label: value` stdout line.
fn write_count_line(io: Io, allocator: Allocator, label: []u8, value: i64) -> !void {
    var line = string::new(allocator);
    defer line.deinit(allocator);
    try line.append_bytes(allocator, label);
    try stdfmt::append_i64(allocator, &var line, value);
    let line_bytes = line.as_bytes();
    return io::write_stdout_line(io, line_bytes);
}

/// Prints the Kizu extern declarations a C header maps to, the Go
/// `importCHeaderFile`.
fn import_c_header_command(io: Io, allocator: Allocator, target: []u8) -> !i64 {
    let read = try read_source_file(io, allocator, target);
    match read {
        Failed(message) => {
            defer message.deinit(allocator);
            let bytes = message.as_bytes();
            try write_error_line(io, allocator, bytes);
            return 1;
        },
        Text(source_text) => return import_c_header_source(io, allocator, move source_text),
    }
}

/// Prints the declarations one read C header maps to, the rest of the Go
/// `importCHeaderFile` once the header is in hand.
fn import_c_header_source(io: Io, allocator: Allocator, source_text: string::String) -> !i64 {
    defer source_text.deinit(allocator);
    let source_bytes = source_text.as_bytes();
    let imported = try cimport::import_header(allocator, source_bytes);
    match imported {
        Declarations(declarations) => {
            defer declarations.deinit(allocator);
            let declaration_bytes = declarations.as_bytes();
            try io::write_stdout_line(io, declaration_bytes);
            return 0;
        },
        Error(message) => {
            defer message.deinit(allocator);
            var line = try string::from_bytes(allocator, "error: ");
            defer line.deinit(allocator);
            try line.append_string(allocator, &message);
            let line_bytes = line.as_bytes();
            try io::write_stderr_line(io, line_bytes);
            return 1;
        },
    }
}

/// Decides the library tree std is read from, the Go `resolveLibDir`: the
/// caller says where it is, or it sits next to the running binary. Nothing is
/// searched for, and the current directory is never consulted -- a program has
/// to mean the same thing whatever directory it is compiled from.
fn resolve_lib_dir(io: Io, allocator: Allocator, out: &var string::String) -> !void {
    // Go reads the variable with os.Getenv, which cannot tell an empty value
    // from an unset one, so an empty one names no tree here either.
    if process::env("KIZU_LIB_DIR") |from_env| {
        if mem::len(from_env) > 0 {
            return out.append_bytes(allocator, from_env);
        }
    }
    let executable = try process::executable_path(allocator);
    defer executable.deinit(allocator);
    let executable_bytes = executable.as_bytes();
    // An install reached through a symlink names the tree beside the real
    // binary, so resolve it; a path that cannot be resolved is used as it is.
    let resolved = fs::real_path(io, allocator, executable_bytes) catch
        return append_lib_dir_beside(allocator, out, executable_bytes);
    defer resolved.deinit(allocator);
    let resolved_bytes = resolved.as_bytes();
    return append_lib_dir_beside(allocator, out, resolved_bytes);
}

/// Appends `<prefix>/lib/kizu` for an executable at `<prefix>/bin/kizu`.
fn append_lib_dir_beside(
    allocator: Allocator,
    out: &var string::String,
    executable: []u8
) -> !void {
    let prefix = path::dirname(path::dirname(executable));
    let lib = try path::join(allocator, prefix, "lib/kizu");
    defer lib.deinit(allocator);
    let lib_bytes = lib.as_bytes();
    return out.append_bytes(allocator, lib_bytes);
}

union MarkerInsertResult {
    Ok,
    Outside(ast::Position),
}

enum InitNameError {
    None,
    Empty,
    Reserved,
    Invalid,
}

struct InitPackageNameResult {
    name: string::String,
    failed: InitNameError
}

fn (self: InitPackageNameResult) deinit(allocator: Allocator) -> void {
    self.name.deinit(allocator);
}

/// Prints or rewrites one source file in canonical form, the Go
/// `fmtCommand` including parse validation and move-marker insertion.
fn fmt_command(
    io: Io,
    allocator: Allocator,
    lib_dir: []u8,
    command_index: i64,
    count: i64
) -> !i64 {
    let argument_count = count - command_index - 1;
    var write = false;
    var file_index = command_index + 1;
    if argument_count == 2 {
        let flag = try process::arg(file_index);
        if is_fmt_write_flag(flag) {
            write = true;
            file_index = file_index + 1;
        }
    }
    let file = try process::arg(file_index);
    if (argument_count != 1 and !write) or
        (argument_count == 1 and starts_with_dash(file)) {
        try usage(io);
        try io::write_stderr_line(
            io,
            "error: fmt takes an optional --write and one target"
        );
        return 1;
    }
    let read = try read_source_file(io, allocator, file);
    match read {
        Failed(message) => {
            defer message.deinit(allocator);
            let bytes = message.as_bytes();
            try write_error_line(io, allocator, bytes);
            return 1;
        },
        Text(source_text) => {
            return format_source(io, allocator, lib_dir, file, write, move source_text);
        },
    }
}

/// Formats one read source file, the rest of the Go `fmtCommand` once the file
/// is in hand.
fn format_source(
    io: Io,
    allocator: Allocator,
    lib_dir: []u8,
    file: []u8,
    write: bool,
    text: string::String
) -> !i64 {
    var source_text = move text;
    defer source_text.deinit(allocator);
    if !try validate_fmt_parse(io, allocator, file) {
        return 1;
    }
    let inserted = try insert_move_markers(
        io,
        allocator,
        lib_dir,
        file,
        &var source_text
    );
    match inserted {
        Ok => {},
        Outside(position) => {
            try write_fmt_outside_error(io, allocator, file, position);
            return 1;
        },
    }
    let source_bytes = source_text.as_bytes();
    let formatted = try fmt::format(allocator, source_bytes);
    defer formatted.deinit(allocator);
    let formatted_bytes = formatted.as_bytes();
    if write {
        try fs::write_file(io, file, formatted_bytes);
        return 0;
    }
    try io::write_stdout(io, formatted_bytes);
    return 0;
}

/// Reports whether an argument selects in-place formatting, the Go
/// `isFmtWriteFlag`.
fn is_fmt_write_flag(argument: []u8) -> bool {
    return mem::equal_bytes(argument, "--write") or mem::equal_bytes(argument, "-w");
}

fn starts_with_dash(argument: []u8) -> bool {
    return mem::len(argument) > 0 and argument[0] == cast<u8>(45);
}

/// Validates syntax before token formatting, the parse-first part of the Go
/// `fmtCommand`.
fn validate_fmt_parse(io: Io, allocator: Allocator, file: []u8) -> !bool {
    let read = try read_source_file(io, allocator, file);
    match read {
        Failed(message) => {
            defer message.deinit(allocator);
            let bytes = message.as_bytes();
            try write_error_line(io, allocator, bytes);
            return false;
        },
        Text(text) => return validate_fmt_source(io, allocator, file, move text),
    }
}

/// Parses one read source file for `fmt`, the rest of `validate_fmt_parse`
/// once the file is in hand.
fn validate_fmt_source(
    io: Io,
    allocator: Allocator,
    file: []u8,
    text: string::String
) -> !bool {
    errdefer text.deinit(allocator);
    var sources = source::new(allocator);
    defer sources.deinit(allocator);
    let path_copy = try string::from_bytes(allocator, file);
    let id = try sources.add(move path_copy, move text);
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    if sources.at(id) |input| {
        let bytes = input.text.as_bytes();
        let scanner = lexer::new_source(allocator, id, bytes);
        var source_parser = try parser::new(allocator, move scanner);
        defer source_parser.deinit(allocator);
        let program = try source_parser.parse_program(&var tree);
        defer program.deinit(allocator);
        if source_parser.diagnostics_len() == 0 {
            return true;
        }
        var index = 0;
        while source_parser.diagnostic(index) |failed| {
            try report(io, allocator, &sources, failed);
            index = index + 1;
        }
        try io::write_stderr_line(io, "error: parse failed");
        return false;
    }
    return true;
}

/// Inserts every missing move marker after successful load, type, and
/// ownership checks, the Go `insertMoveMarkers`. Any diagnostic leaves source
/// unchanged so `check` remains the command that reports it.
fn insert_move_markers(
    io: Io,
    allocator: Allocator,
    lib_dir: []u8,
    file: []u8,
    source_text: &var string::String
) -> !MarkerInsertResult {
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    var loader = try project::new_loader(io, allocator, lib_dir);
    defer loader.deinit(allocator);
    let source_bytes = source_text.as_bytes();
    let loaded = try loader.load_source(
        &var tree,
        file,
        source_bytes
    );
    match loaded {
        Error(failed) => {
            failed.deinit(allocator);
            return MarkerInsertResult::Ok;
        },
        Program(program) => {
            defer program.deinit(allocator);
            if try types::check(allocator, &var tree, &program) |failed| {
                failed.deinit(allocator);
                return MarkerInsertResult::Ok;
            }
            var markers = array::new<ast::Span>(allocator);
            defer markers.deinit(allocator);
            if try ownership::missing_move_markers(allocator,
                &var tree,
                &program,
                &var markers
            ) |failed| {
                failed.deinit(allocator);
                return MarkerInsertResult::Ok;
            }
            var offsets = array::new<i64>(allocator);
            defer offsets.deinit(allocator);
            var index = 0;
            while markers.get(index) |marker| {
                index = index + 1;
                var belongs_to_file = false;
                if marker.source |source_id| {
                    if loader.sources.at(source_id) |source_file| {
                        let source_path = source_file.path.as_bytes();
                        belongs_to_file = mem::equal_bytes(source_path, file);
                    }
                }
                if !belongs_to_file {
                    continue;
                }
                let offset = line_column_offset(
                    source_bytes,
                    marker.start.line,
                    marker.start.column
                ) orelse return MarkerInsertResult::Outside(marker.start);
                try offsets.append(allocator, offset);
            }
            try sort_offsets_descending(&var offsets);
            var offset_index = 0;
            while offsets.get(offset_index) |offset| {
                try insert_move_at(allocator, source_text, offset);
                offset_index = offset_index + 1;
            }
            return MarkerInsertResult::Ok;
        },
    }
}

/// Converts a one-based line and column to a byte offset, the Go
/// `lineColumnOffset`.
fn line_column_offset(source_text: []u8, line_value: i64, column: i64) -> ?i64 {
    if line_value < 1 or column < 1 {
        return null;
    }
    var line = line_value;
    var offset = 0;
    while line > 1 {
        var next = offset;
        var found = false;
        while next < mem::len(source_text) {
            if source_text[next] == cast<u8>(10) {
                found = true;
                break;
            }
            next = next + 1;
        }
        if !found {
            return null;
        }
        offset = next + 1;
        line = line - 1;
    }
    offset = offset + column - 1;
    if offset > mem::len(source_text) {
        return null;
    }
    return offset;
}

fn sort_offsets_descending(offsets: &var array::Array<i64>) -> !void {
    var index = 1;
    while index < offsets.len() {
        var cursor = index;
        while cursor > 0 and offsets.get_or_panic(cursor) >
            offsets.get_or_panic(cursor - 1) {
            try offsets.swap(cursor, cursor - 1);
            cursor = cursor - 1;
        }
        index = index + 1;
    }
    return;
}

fn insert_move_at(allocator: Allocator, source_text: &var string::String, offset: i64) -> !void {
    let old_length = source_text.len();
    try source_text.append_bytes(allocator, "move ");
    let bytes = source_text.as_mut_bytes();
    var cursor = old_length;
    while cursor > offset {
        bytes[cursor + 4] = bytes[cursor - 1];
        cursor = cursor - 1;
    }
    bytes[offset] = cast<u8>(109);
    bytes[offset + 1] = cast<u8>(111);
    bytes[offset + 2] = cast<u8>(118);
    bytes[offset + 3] = cast<u8>(101);
    bytes[offset + 4] = cast<u8>(32);
    return;
}

fn write_fmt_outside_error(
    io: Io,
    allocator: Allocator,
    file: []u8,
    position: ast::Position
) -> !void {
    var message = try string::from_bytes(allocator, "error: fmt: ");
    defer message.deinit(allocator);
    try message.append_bytes(allocator, file);
    try message.append_byte(allocator, cast<u8>(58));
    try stdfmt::append_i64(allocator, &var message, position.line);
    try message.append_byte(allocator, cast<u8>(58));
    try stdfmt::append_i64(allocator, &var message, position.column);
    try message.append_bytes(allocator, " is outside the file");
    let bytes = message.as_bytes();
    return io::write_stderr_line(io, bytes);
}

/// Scaffolds a minimal package, the Go `initCommand`.
fn init_command(
    io: Io,
    allocator: Allocator,
    command_index: i64,
    count: i64
) -> !i64 {
    let argument_count = count - command_index - 1;
    if argument_count > 1 {
        try usage(io);
        try io::write_stderr_line(io, "error: invalid init command");
        return 1;
    }
    var target = ".";
    if argument_count == 1 {
        target = try process::arg(command_index + 1);
    }
    let absolute_target = try fsutil::absolute(allocator, target);
    defer absolute_target.deinit(allocator);
    let absolute_bytes = absolute_target.as_bytes();
    let package = try init_package_name(allocator, absolute_bytes);
    defer package.deinit(allocator);
    let package_bytes = package.name.as_bytes();
    if package.failed == InitNameError::Empty {
        try io::write_stderr_line(io, "error: init error: package name is empty");
        return 1;
    }
    if package.failed == InitNameError::Reserved {
        try io::write_stderr_line(io, "error: init error: package name `std` is reserved");
        return 1;
    }
    if package.failed == InitNameError::Invalid {
        try write_init_invalid_name(io, allocator, package_bytes);
        return 1;
    }
    if !try ensure_init_target(io, absolute_bytes) {
        try write_init_path_error(
            io,
            allocator,
            "error: init error: target `",
            absolute_bytes,
            "` is not a directory"
        );
        return 1;
    }
    if try reject_existing_init_files(io, allocator, absolute_bytes) |existing| {
        defer existing.deinit(allocator);
        let existing_bytes = existing.as_bytes();
        try write_init_path_error(
            io,
            allocator,
            "error: init error: `",
            existing_bytes,
            "` already exists"
        );
        return 1;
    }
    let source_dir = try path::join(allocator, absolute_bytes, "src");
    defer source_dir.deinit(allocator);
    let source_dir_bytes = source_dir.as_bytes();
    try fsutil::create_dir_all(io, source_dir_bytes);
    let manifest = try init_manifest(allocator, package_bytes);
    defer manifest.deinit(allocator);
    let manifest_path = try path::join(allocator, absolute_bytes, "kizu.toml");
    defer manifest_path.deinit(allocator);
    let manifest_path_bytes = manifest_path.as_bytes();
    let manifest_bytes = manifest.as_bytes();
    try write_new_file(io, manifest_path_bytes, manifest_bytes);
    let main_path = try path::join(allocator, source_dir_bytes, "main.kizu");
    defer main_path.deinit(allocator);
    let main_path_bytes = main_path.as_bytes();
    let init_main_source =
        \\fn main() {
        \\    print("hello, kizu");
        \\}
        \\
    ;
    try write_new_file(
        io,
        main_path_bytes,
        init_main_source
    );
    var line = try string::from_bytes(allocator, "initialized Kizu package `");
    defer line.deinit(allocator);
    try line.append_bytes(allocator, package_bytes);
    try line.append_bytes(allocator, "` in ");
    try line.append_bytes(allocator, absolute_bytes);
    let line_bytes = line.as_bytes();
    try io::write_stdout_line(io, line_bytes);
    return 0;
}

/// Derives and validates the namespace from target, the Go
/// `initPackageName`.
fn init_package_name(
    allocator: Allocator,
    target: []u8
) -> !InitPackageNameResult {
    let name = try normalize_init_package_name(allocator, path::basename(target));
    let bytes = name.as_bytes();
    var failed = InitNameError::None;
    if mem::len(bytes) == 0 {
        failed = InitNameError::Empty;
    } else {
        if mem::equal_bytes(bytes, "std") {
            failed = InitNameError::Reserved;
        } else {
            if !is_valid_init_package_name(bytes) {
                failed = InitNameError::Invalid;
            }
        }
    }
    return InitPackageNameResult { name: move name, failed: failed };
}

/// Maps a directory spelling to an identifier, the Go
/// `normalizeInitPackageName`.
fn normalize_init_package_name(
    allocator: Allocator,
    name: []u8
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var last_underscore = false;
    var index = 0;
    while index < mem::len(name) {
        let current = name[index];
        if current >= cast<u8>(65) and current <= cast<u8>(90) {
            try out.append_byte(allocator, current + cast<u8>(32));
            last_underscore = false;
        } else {
            if (current >= cast<u8>(97) and current <= cast<u8>(122)) or
                (current >= cast<u8>(48) and current <= cast<u8>(57)) {
                try out.append_byte(allocator, current);
                last_underscore = false;
            } else {
                if current == cast<u8>(95) or current == cast<u8>(45) {
                    if out.len() > 0 and !last_underscore {
                        try out.append_byte(allocator, cast<u8>(95));
                        last_underscore = true;
                    }
                } else {
                    out.clear();
                    return move out;
                }
            }
        }
        index = index + 1;
    }
    while ends_with_byte(&out, cast<u8>(95)) {
        try out.truncate(out.len() - 1);
    }
    return move out;
}

fn ends_with_byte(value: &string::String, byte: u8) -> bool {
    if value.len() == 0 {
        return false;
    }
    let bytes = value.as_bytes();
    return bytes[value.len() - 1] == byte;
}

/// Reports whether name is an identifier-like package root, the Go
/// `isValidInitPackageName`.
fn is_valid_init_package_name(name: []u8) -> bool {
    if mem::len(name) == 0 {
        return false;
    }
    let first = name[0];
    if !((first >= cast<u8>(97) and first <= cast<u8>(122)) or
        first == cast<u8>(95)) {
        return false;
    }
    var index = 1;
    while index < mem::len(name) {
        let current = name[index];
        if (current >= cast<u8>(97) and current <= cast<u8>(122)) or
            (current >= cast<u8>(48) and current <= cast<u8>(57)) or
            current == cast<u8>(95) {
            index = index + 1;
            continue;
        }
        return false;
    }
    return true;
}

/// Creates target or rejects a non-directory, the Go `ensureInitTarget`.
fn ensure_init_target(io: Io, target: []u8) -> !bool {
    if try fs::exists(io, target) {
        let info = try fs::metadata(io, target);
        return info.is_dir;
    }
    try fsutil::create_dir_all(io, target);
    return true;
}

/// Returns the first init file that already exists, the Go
/// `rejectExistingInitFiles`.
fn reject_existing_init_files(
    io: Io,
    allocator: Allocator,
    target: []u8
) -> !?string::String {
    let manifest_path = try path::join(allocator, target, "kizu.toml");
    errdefer manifest_path.deinit(allocator);
    if try retained_path_exists(io, &manifest_path) {
        return move manifest_path;
    }
    manifest_path.deinit(allocator);
    let main_path = try path::join(allocator, target, "src/main.kizu");
    errdefer main_path.deinit(allocator);
    if try retained_path_exists(io, &main_path) {
        return move main_path;
    }
    main_path.deinit(allocator);
    return null;
}

fn retained_path_exists(io: Io, retained: &string::String) -> !bool {
    let bytes = retained.as_bytes();
    return fs::exists(io, bytes);
}

/// Renders the minimal manifest, the Go `initManifest`.
fn init_manifest(allocator: Allocator, package_name: []u8) -> !string::String {
    var out = try string::from_bytes(allocator, "[package]");
    errdefer out.deinit(allocator);
    try out.append_byte(allocator, cast<u8>(10));
    try out.append_bytes(allocator, "name = ");
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_bytes(allocator, package_name);
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_byte(allocator, cast<u8>(10));
    try out.append_bytes(allocator, "version = ");
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_bytes(allocator, "0.1.0");
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_byte(allocator, cast<u8>(10));
    try out.append_byte(allocator, cast<u8>(10));
    try out.append_bytes(allocator, "[modules]");
    try out.append_byte(allocator, cast<u8>(10));
    try out.append_bytes(allocator, "paths = [");
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_bytes(allocator, "src");
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_byte(allocator, cast<u8>(93));
    try out.append_byte(allocator, cast<u8>(10));
    return move out;
}

/// Writes a new init file after the earlier rejection pass, the Go
/// `writeNewFile`. std has no exclusive-create primitive, so a concurrent
/// creator between the check and write remains the recorded fs gap.
fn write_new_file(io: Io, file: []u8, content: []u8) -> !void {
    return fs::write_file(io, file, content);
}

fn write_init_invalid_name(io: Io, allocator: Allocator, name: []u8) -> !void {
    return write_init_path_error(
        io,
        allocator,
        "error: init error: invalid package name `",
        name,
        "`"
    );
}

fn write_init_path_error(
    io: Io,
    allocator: Allocator,
    prefix: []u8,
    value: []u8,
    suffix: []u8
) -> !void {
    var message = try string::from_bytes(allocator, prefix);
    defer message.deinit(allocator);
    try message.append_bytes(allocator, value);
    try message.append_bytes(allocator, suffix);
    let bytes = message.as_bytes();
    return io::write_stderr_line(io, bytes);
}

/// Writes one diagnostic the way the CLI reports errors.
fn report(
    io: Io,
    allocator: Allocator,
    sources: &source::SourceMap,
    failed: &diagnostic::Diagnostic
) -> !void {
    let rendered = try failed.cli_error(allocator, sources);
    defer rendered.deinit(allocator);
    let bytes = rendered.as_bytes();
    return io::write_stderr_line(io, bytes);
}

/// Parses a source file and prints its AST summary.
fn parse_file(io: Io, allocator: Allocator, file: []u8) -> !i64 {
    let read = try read_source_file(io, allocator, file);
    match read {
        Failed(message) => {
            defer message.deinit(allocator);
            let bytes = message.as_bytes();
            try write_error_line(io, allocator, bytes);
            return 1;
        },
        Text(text) => return parse_source(io, allocator, file, move text),
    }
}

/// Parses one read source file and prints its AST summary, the rest of the Go
/// `parseFile` once the file is in hand.
fn parse_source(io: Io, allocator: Allocator, file: []u8, text: string::String) -> !i64 {
    errdefer text.deinit(allocator);
    var sources = source::new(allocator);
    defer sources.deinit(allocator);
    let path_copy = try string::from_bytes(allocator, file);
    let id = try sources.add(move path_copy, move text);
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    if sources.at(id) |input| {
        let bytes = input.text.as_bytes();
        let scanner = lexer::new_source(allocator, id, bytes);
        var source_parser = try parser::new(allocator, move scanner);
        defer source_parser.deinit(allocator);
        let program = try source_parser.parse_program(&var tree);
        defer program.deinit(allocator);
        if source_parser.diagnostics_len() > 0 {
            var index = 0;
            while source_parser.diagnostic(index) |failed| {
                try report(io, allocator, &sources, failed);
                index = index + 1;
            }
            try io::write_stderr_line(io, "error: parse failed");
            return 1;
        }
        let rendered = try ast::render_program(allocator, &tree, &program);
        defer rendered.deinit(allocator);
        let rendered_bytes = rendered.as_bytes();
        try io::write_stdout_line(io, rendered_bytes);
        return 0;
    }
    return 0;
}

/// Writes the installed browser runtime beside the binary it loads. The
/// runtime is read before the output directory is created, so a broken
/// installation cannot leave a wasm-only directory that looks complete.
fn write_browser_esm(
    io: Io,
    allocator: Allocator,
    lib_dir: []u8,
    output_dir: []u8,
    wasm_bytes: []u8
) -> !bool {
    let runtime_path = try path::join(allocator, lib_dir, "browser/app.mjs");
    defer runtime_path.deinit(allocator);
    let runtime_path_bytes = runtime_path.as_bytes();
    if !try fs::exists(io, runtime_path_bytes) {
        var message = try string::from_bytes(allocator, "error: open ");
        defer message.deinit(allocator);
        try message.append_bytes(allocator, runtime_path_bytes);
        try message.append_bytes(allocator, ": no such file or directory");
        try message.append_byte(allocator, cast<u8>(10));
        try message.append_bytes(allocator, "help: the library tree is `");
        try message.append_bytes(allocator, lib_dir);
        try message.append_bytes(
            allocator,
            "`; set KIZU_LIB_DIR or pass --lib-dir to point somewhere else"
        );
        let message_bytes = message.as_bytes();
        try io::write_stderr_line(io, message_bytes);
        return false;
    }
    let runtime = try fs::read_file(
        io, allocator, runtime_path_bytes, mem::Limit::Unlimited
    );
    defer runtime.deinit(allocator);
    try fsutil::create_dir_all(io, output_dir);
    let wasm_path = try path::join(allocator, output_dir, "app.wasm");
    defer wasm_path.deinit(allocator);
    let wasm_path_bytes = wasm_path.as_bytes();
    try fs::write_file(io, wasm_path_bytes, wasm_bytes);
    let module_path = try path::join(allocator, output_dir, "app.mjs");
    defer module_path.deinit(allocator);
    let module_path_bytes = module_path.as_bytes();
    let runtime_bytes = runtime.as_bytes();
    try fs::write_file(io, module_path_bytes, runtime_bytes);
    return true;
}

/// Lowers a checked file or package to typed SSA IR and prints it, the Go
/// `irCommand` over `lowerFile` / `lowerPackage`, the LLVM IR emitted from it,
/// the Go `emitLLVMFile`, or the WASI WebAssembly text emitted from it, the Go
/// `emitWASMFile`: a package also gets the `main` entry wrapper the native
/// build adds. The text is emitted fresh every time (ADR-0126).
///
/// `Output::Check` runs the same path and throws the LLVM text away, the Go
/// `checkFile`: `check: ok` promises the backend accepts the program, not just
/// the checkers, so a lowering or emitter gap surfaces here rather than at the
/// first `run`, and the promise cannot drift from what `run` does.
fn lower_target(
    io: Io,
    allocator: Allocator,
    lib_dir: []u8,
    target: []u8,
    opt: bool,
    output: Output,
    output_file: []u8
) -> !i64 {
    let build_target = output_target(output);
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    var loader = try project::new_loader(io, allocator, lib_dir);
    defer loader.deinit(allocator);
    var package_name = string::new(allocator);
    defer package_name.deinit(allocator);
    let loaded = try load_target(
        io,
        allocator,
        &var loader,
        &var tree,
        target,
        &var package_name,
        false
    );
    match loaded {
        Error(failed) => {
            defer failed.deinit(allocator);
            try report(io, allocator, &loader.sources, &failed);
            return 1;
        },
        Program(program) => {
            defer program.deinit(allocator);
            if try types::check_for_target(
                allocator, &var tree, &program, build_target
            ) |failed| {
                defer failed.deinit(allocator);
                try report(io, allocator, &loader.sources, &failed);
                return 1;
            }
            var checker = try ownership::new_checker_for_target(
                allocator, &tree, &program, build_target
            );
            defer checker.deinit(allocator);
            if try checker.check_program(&var tree, &program) |failed| {
                defer failed.deinit(allocator);
                try report(io, allocator, &loader.sources, &failed);
                return 1;
            }
            let codes = try loader.std_error_codes();
            match codes {
                Error(failed) => {
                    defer failed.deinit(allocator);
                    try report(io, allocator, &loader.sources, &failed);
                    return 1;
                },
                Codes(std_errors) => {
                    defer std_errors.deinit(allocator);
                    var lowerer = try ir::new_lowerer_for_target(
                        allocator, &tree, &program, &checker, build_target
                    );
                    defer lowerer.deinit(allocator);
                    if try lowerer.lower(&var tree, &program, &std_errors) |failed| {
                        defer failed.deinit(allocator);
                        try report(io, allocator, &loader.sources, &failed);
                        return 1;
                    }
                    if opt {
                        if try ir::optimize(allocator, &var lowerer.module) |failed| {
                            defer failed.deinit(allocator);
                            try report(io, allocator, &loader.sources, &failed);
                            return 1;
                        }
                    }
                    if package_name.len() > 0 {
                        var entry = string::new(allocator);
                        defer entry.deinit(allocator);
                        try entry.append_string(allocator, &package_name);
                        try entry.append_bytes(allocator, "::main");
                        let entry_bytes = entry.as_bytes();
                        if try add_package_main(allocator, &var lowerer.module, entry_bytes) |failed| {
                            defer failed.deinit(allocator);
                            try report(io, allocator, &loader.sources, &failed);
                            return 1;
                        }
                    }
                    if output == Output::Wasm or output == Output::WasmBinary or
                        output == Output::WasmBrowser or
                        output == Output::WasmBrowserBinary or
                        output == Output::WasmBrowserEsm {
                        // A wasm module exposes only target-selected entry /
                        // export roots, so unreachable functions must not drag
                        // unused host capabilities into its imports.
                        var export_abi = "";
                        if output == Output::WasmBrowser or
                            output == Output::WasmBrowserBinary or
                            output == Output::WasmBrowserEsm {
                            export_abi = "browser";
                        }
                        try keep_target_program(
                            allocator, &var lowerer.module, export_abi
                        );
                        var text = string::new(allocator);
                        defer text.deinit(allocator);
                        if output == Output::WasmBrowserBinary or
                            output == Output::WasmBrowserEsm {
                            if try wasm::emit_browser_binary(
                                allocator,
                                &lowerer.module,
                                &var text
                            ) |failed| {
                                defer failed.deinit(allocator);
                                try report(io, allocator, &loader.sources, &failed);
                                return 1;
                            }
                        } else {
                            if output == Output::WasmBrowser {
                                if try wasm::emit_browser(
                                    allocator,
                                    &lowerer.module,
                                    &var text
                                ) |failed| {
                                    defer failed.deinit(allocator);
                                    try report(io, allocator, &loader.sources, &failed);
                                    return 1;
                                }
                            } else {
                                if output == Output::WasmBinary {
                                    if try wasm::emit_binary(
                                        allocator,
                                        &lowerer.module,
                                        &var text
                                    ) |failed| {
                                        defer failed.deinit(allocator);
                                        try report(io, allocator, &loader.sources, &failed);
                                        return 1;
                                    }
                                } else {
                                    if try wasm::emit(
                                        allocator,
                                        &lowerer.module,
                                        &var text
                                    ) |failed| {
                                        defer failed.deinit(allocator);
                                        try report(io, allocator, &loader.sources, &failed);
                                        return 1;
                                    }
                                }
                            }
                        }
                        let text_bytes = text.as_bytes();
                        if output == Output::WasmBrowserEsm {
                            if try write_browser_esm(
                                io, allocator, lib_dir, output_file, text_bytes
                            ) {
                                return 0;
                            }
                            return 1;
                        }
                        if mem::len(output_file) > 0 {
                            try fs::write_file(io, output_file, text_bytes);
                            return 0;
                        }
                        try io::write_stdout_line(io, text_bytes);
                        return 0;
                    }
                    if output == Output::Llvm or output == Output::Check {
                        try keep_target_program(
                            allocator, &var lowerer.module, ""
                        );
                        var text = string::new(allocator);
                        defer text.deinit(allocator);
                        if try llvm::emit(allocator, &var lowerer.module, &var text) |failed| {
                            defer failed.deinit(allocator);
                            try report(io, allocator, &loader.sources, &failed);
                            return 1;
                        }
                        if output == Output::Check {
                            try io::write_stdout_line(io, "check: ok");
                            return 0;
                        }
                        let text_bytes = text.as_bytes();
                        try io::write_stdout_line(io, text_bytes);
                        return 0;
                    }
                    let rendered = try ir::render(allocator, &lowerer.module);
                    defer rendered.deinit(allocator);
                    let rendered_bytes = rendered.as_bytes();
                    try io::write_stdout_line(io, rendered_bytes);
                    return 0;
                },
            }
        },
    }
}

/// Exposes the root module main as the native entrypoint, the Go
/// `addPackageMain`, so a package uses the same entry rule as a single
/// file: `fn main`. It writes IR by hand, so it verifies what it produced.
fn add_package_main(allocator: Allocator, module: &var ir::Module, entry: []u8) -> !?diagnostic::Diagnostic {
    if module.function_named("main") |_| {
        return null;
    }
    let entry_function = module.function_named(entry) orelse return null;
    if module.function_param_count(entry_function) != 0 {
        return null;
    }
    let return_type = module.function_return(entry_function);
    let result_name = try module.names.intern("%1");
    let main_name = try module.names.intern("main");
    let entry_name = try module.names.intern("entry");
    let callee = try module.names.intern(entry);
    let result = ir::Value { name: result_name, type_name: return_type };
    let main_function = ir::Function {
        node: try module.function_nodes.add(allocator, ir::FunctionNode {
            name: main_name,
            params: array::new<ir::Param>(allocator),
            return_type: return_type,
            blocks: array::new<ir::Block>(allocator),
            export_abi: ir::empty_name(),
            export_name: ir::empty_name()
        })
    };
    try module.functions.append(allocator, main_function);
    let block = try module.add_block(main_function, entry_name);
    let call = module.blank_instr(result, ir::Op::Call, callee, ir::empty_name());
    let _ = try module.add_instr(allocator, block, move call);
    module.set_terminator(block, ir::return_terminator(result));
    return ir::verify(allocator, module);
}

/// Reports whether path names a package root: a directory or a manifest.
fn is_package_root(io: Io, target: []u8) -> !bool {
    let exists = try fs::exists(io, target);
    if !exists {
        return false;
    }
    let info = try fs::metadata(io, target);
    if info.is_dir {
        return true;
    }
    return mem::equal_bytes(path::basename(target), "kizu.toml");
}

/// Loads one loose source file together with the std it imports, reporting a
/// read failure as the diagnostic the load path carries.
fn load_one_file(
    io: Io,
    allocator: Allocator,
    loader: &var project::Loader,
    tree: &var ast::Ast,
    target: []u8
) -> !project::LoadResult {
    let read = try read_source_file(io, allocator, target);
    match read {
        Failed(message) => {
            defer message.deinit(allocator);
            return load_read_failure(allocator, &message);
        },
        Text(text) => {
            defer text.deinit(allocator);
            let text_bytes = text.as_bytes();
            return loader.load_source(tree, target, text_bytes);
        },
    }
}

/// Loads the target as a package when it is a package root, else as one file
/// resolved together with the std it imports.
fn load_target(
    io: Io,
    allocator: Allocator,
    loader: &var project::Loader,
    tree: &var ast::Ast,
    target: []u8,
    package_name: &var string::String,
    include_tests: bool
) -> !project::LoadResult {
    let package = try is_package_root(io, target);
    if !package {
        return load_one_file(io, allocator, loader, tree, target);
    }
    var root = try string::from_bytes(allocator, target);
    defer root.deinit(allocator);
    var manifest_path = try path::join(allocator, target, "kizu.toml");
    defer manifest_path.deinit(allocator);
    if mem::equal_bytes(path::basename(target), "kizu.toml") {
        root.clear();
        try root.append_bytes(allocator, path::dirname(target));
        manifest_path.clear();
        try manifest_path.append_bytes(allocator, target);
    }
    let manifest_bytes = manifest_path.as_bytes();
    let manifest_read = try read_source_file(io, allocator, manifest_bytes);
    match manifest_read {
        Failed(message) => {
            defer message.deinit(allocator);
            return load_read_failure(allocator, &message);
        },
        Text(text) => {
            defer text.deinit(allocator);
            return load_manifest_package(
                io,
                allocator,
                loader,
                tree,
                &root,
                package_name,
                include_tests,
                &text
            );
        },
    }
}

/// Resolves and loads the package one manifest text declares, the rest of the
/// Go `loadPackageProgramMode` once the manifest is in hand.
fn load_manifest_package(
    io: Io,
    allocator: Allocator,
    loader: &var project::Loader,
    tree: &var ast::Ast,
    root: &string::String,
    package_name: &var string::String,
    include_tests: bool,
    text: &string::String
) -> !project::LoadResult {
    let text_bytes = text.as_bytes();
    let parsed = try manifest::parse_manifest(allocator, text_bytes);
    match parsed {
        Manifest(found) => {
            defer found.deinit(allocator);
            try package_name.append_string(allocator, &found.package_name);
            let root_bytes = root.as_bytes();
            let resolved = try project::resolve_modules(io, allocator, root_bytes, &found);
            match resolved {
                Graph(graph) => {
                    defer graph.deinit(allocator);
                    if include_tests {
                        return loader.load_test_program(tree, &graph);
                    }
                    return loader.load_program(tree, &graph);
                },
                Error(failed) => return project::LoadResult::Error(move failed),
            }
        },
        Error(message) => {
            defer message.deinit(allocator);
            let message_bytes = message.as_bytes();
            let failed = try diagnostic::from_text(allocator,
                diagnostic::Severity::Error,
                ast::zero_span(),
                message_bytes
            );
            return project::LoadResult::Error(move failed);
        },
    }
}

/// Names which native command a lowered module is built for.
enum NativeCommand {
    Build,
    Run,
    Test,
}

/// Returns the native link options `run` and `test` build with, the defaults
/// of the Go `parseNativeBuildArgs` with no output named.
fn default_native_options(allocator: Allocator) -> !native::Options {
    var libc = try string::from_bytes(allocator, "on");
    errdefer libc.deinit(allocator);
    var runtime_mode = try string::from_bytes(allocator, "hosted");
    errdefer runtime_mode.deinit(allocator);
    var emit = try string::from_bytes(allocator, "exe");
    errdefer emit.deinit(allocator);
    var linker = try string::from_bytes(allocator, "clang");
    errdefer linker.deinit(allocator);
    return native::Options {
        output: string::new(allocator),
        triple: string::new(allocator),
        cpu: string::new(allocator),
        abi: string::new(allocator),
        libc: move libc,
        runtime: move runtime_mode,
        emit: move emit,
        linker: move linker,
        opt: false
    };
}

/// Runs `run <file|package> [-- args...]`, the Go `dispatchRun`: everything
/// after `--` goes to the built program.
fn run_command(io: Io, allocator: Allocator, lib_dir: []u8, target: []u8, next: i64, count: i64) -> !i64 {
    let child_start = next + 3;
    var child_count = 0;
    if count - next >= 3 {
        let separator = try process::arg(next + 2);
        if mem::equal_bytes(separator, "--") {
            child_count = count - child_start;
        }
    }
    var options = try default_native_options(allocator);
    defer options.deinit(allocator);
    return native_target(io, allocator, lib_dir, target, NativeCommand::Run, &options, child_start, child_count);
}

/// Runs `test <file|package> [-- args...]`, the Go `dispatchTest`.
fn test_command(io: Io, allocator: Allocator, lib_dir: []u8, target: []u8, next: i64, count: i64) -> !i64 {
    let child_start = next + 3;
    var child_count = 0;
    if count - next >= 3 {
        let separator = try process::arg(next + 2);
        if mem::equal_bytes(separator, "--") {
            child_count = count - child_start;
        }
    }
    var options = try default_native_options(allocator);
    defer options.deinit(allocator);
    return native_target(io, allocator, lib_dir, target, NativeCommand::Test, &options, child_start, child_count);
}

/// Runs `build --target native [native-options] <file|package>`, the Go
/// `emitNativeFile`.
fn build_native_command(io: Io, allocator: Allocator, lib_dir: []u8, first: i64, count: i64) -> !i64 {
    var options = try default_native_options(allocator);
    defer options.deinit(allocator);
    var target_path = string::new(allocator);
    defer target_path.deinit(allocator);
    let parsed = try parse_native_build_args(io, allocator, first, count, &var options, &var target_path);
    if parsed != 0 {
        return parsed;
    }
    let target_bytes = target_path.as_bytes();
    return native_target(io, allocator, lib_dir, target_bytes, NativeCommand::Build, &options, 0, 0);
}

/// Parses native build flags and derives defaults, the Go
/// `parseNativeBuildArgs`.
fn parse_native_build_args(
    io: Io,
    allocator: Allocator,
    first: i64,
    count: i64,
    options: &var native::Options,
    path: &var string::String
) -> !i64 {
    var index = first;
    while index < count {
        let arg = try process::arg(index);
        index = index + 1;
        if mem::equal_bytes(arg, "--opt") {
            options.opt = true;
            continue;
        }
        if mem::equal_bytes(arg, "-o") {
            index = try take_flag_value(io, allocator, index, count, "-o", &var options.output);
            if index < 0 {
                return 1;
            }
            continue;
        }
        if mem::equal_bytes(arg, "--triple") {
            index = try take_flag_value(io, allocator, index, count, "--triple", &var options.triple);
            if index < 0 {
                return 1;
            }
            continue;
        }
        if mem::equal_bytes(arg, "--cpu") {
            index = try take_flag_value(io, allocator, index, count, "--cpu", &var options.cpu);
            if index < 0 {
                return 1;
            }
            continue;
        }
        if mem::equal_bytes(arg, "--abi") {
            index = try take_flag_value(io, allocator, index, count, "--abi", &var options.abi);
            if index < 0 {
                return 1;
            }
            continue;
        }
        if mem::equal_bytes(arg, "--libc") {
            index = try take_flag_value(io, allocator, index, count, "--libc", &var options.libc);
            if index < 0 {
                return 1;
            }
            continue;
        }
        if mem::equal_bytes(arg, "--runtime") {
            index = try take_flag_value(io, allocator, index, count, "--runtime", &var options.runtime);
            if index < 0 {
                return 1;
            }
            continue;
        }
        if mem::equal_bytes(arg, "--emit") {
            index = try take_flag_value(io, allocator, index, count, "--emit", &var options.emit);
            if index < 0 {
                return 1;
            }
            continue;
        }
        if mem::equal_bytes(arg, "--linker") {
            index = try take_flag_value(io, allocator, index, count, "--linker", &var options.linker);
            if index < 0 {
                return 1;
            }
            continue;
        }
        if path.len() > 0 {
            try usage(io);
            try io::write_stderr_line(io, "error: invalid command arguments");
            return 1;
        }
        try path.append_bytes(allocator, arg);
    }
    if path.len() == 0 {
        try usage(io);
        try io::write_stderr_line(io, "error: missing source file");
        return 1;
    }
    if options.output.len() == 0 {
        let path_bytes = path.as_bytes();
        let emit_bytes = options.emit.as_bytes();
        try default_native_output(allocator, path_bytes, emit_bytes, &var options.output);
    }
    return 0;
}

/// Reads the value following a flag into one option and returns the next
/// argument index, the Go `nextNativeArg`; a missing value prints the
/// usage and reports -1.
fn take_flag_value(
    io: Io,
    allocator: Allocator,
    index: i64,
    count: i64,
    flag: []u8,
    into: &var string::String
) -> !i64 {
    if index >= count {
        try usage(io);
        var message = try string::from_bytes(allocator, "error: missing value after ");
        defer message.deinit(allocator);
        try message.append_bytes(allocator, flag);
        let message_bytes = message.as_bytes();
        try io::write_stderr_line(io, message_bytes);
        return 0 - 1;
    }
    let value = try process::arg(index);
    into.clear();
    try into.append_bytes(allocator, value);
    return index + 1;
}

/// Maps a source path to the default target/native artifact, the Go
/// `defaultNativeOutput`.
fn default_native_output(allocator: Allocator, path: []u8, emit: []u8, out: &var string::String) -> !void {
    let base = path::basename(path);
    let ext = path::extension(base);
    let stem_end = mem::len(base) - mem::len(ext);
    let name = base[0..stem_end];
    try out.append_bytes(allocator, "target/native/");
    try out.append_bytes(allocator, name);
    if mem::equal_bytes(emit, "obj") {
        try out.append_bytes(allocator, ".o");
    }
    if mem::equal_bytes(emit, "llvm") {
        try out.append_bytes(allocator, ".ll");
    }
    return;
}

/// Lowers a checked file or package and hands it to the native backend: the
/// Go `emitNativeFile` for Build, `runFile` for Run and `testFile` for
/// Test. Test loads package test files and replaces `main` with an entry
/// that runs every test block; Build and Run expose the package main. The
/// typed-SSA optimizer stays scoped to `build --emit-llvm --opt`, so no
/// mode runs it; native `--opt` prunes unreachable functions and hands
/// optimization to the toolchain.
fn native_target(
    io: Io,
    allocator: Allocator,
    lib_dir: []u8,
    target: []u8,
    command: NativeCommand,
    options: &native::Options,
    child_start: i64,
    child_count: i64
) -> !i64 {
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    var loader = try project::new_loader(io, allocator, lib_dir);
    defer loader.deinit(allocator);
    var package_name = string::new(allocator);
    defer package_name.deinit(allocator);
    let include_tests = command == NativeCommand::Test;
    let loaded = try load_target(io, allocator, &var loader, &var tree, target, &var package_name, include_tests);
    match loaded {
        Error(failed) => {
            defer failed.deinit(allocator);
            try report(io, allocator, &loader.sources, &failed);
            return 1;
        },
        Program(program) => {
            defer program.deinit(allocator);
            if try types::check(allocator, &var tree, &program) |failed| {
                defer failed.deinit(allocator);
                try report(io, allocator, &loader.sources, &failed);
                return 1;
            }
            var checker = try ownership::new_checker(allocator, &tree, &program);
            defer checker.deinit(allocator);
            if try checker.check_program(&var tree, &program) |failed| {
                defer failed.deinit(allocator);
                try report(io, allocator, &loader.sources, &failed);
                return 1;
            }
            let codes = try loader.std_error_codes();
            match codes {
                Error(failed) => {
                    defer failed.deinit(allocator);
                    try report(io, allocator, &loader.sources, &failed);
                    return 1;
                },
                Codes(std_errors) => {
                    defer std_errors.deinit(allocator);
                    var lowerer = try ir::new_lowerer(allocator, &tree, &program, &checker);
                    defer lowerer.deinit(allocator);
                    if try lowerer.lower(&var tree, &program, &std_errors) |failed| {
                        defer failed.deinit(allocator);
                        try report(io, allocator, &loader.sources, &failed);
                        return 1;
                    }
                    if command != NativeCommand::Test and package_name.len() > 0 {
                        var entry = string::new(allocator);
                        defer entry.deinit(allocator);
                        try entry.append_string(allocator, &package_name);
                        try entry.append_bytes(allocator, "::main");
                        let entry_bytes = entry.as_bytes();
                        if try add_package_main(allocator, &var lowerer.module, entry_bytes) |failed| {
                            defer failed.deinit(allocator);
                            try report(io, allocator, &loader.sources, &failed);
                            return 1;
                        }
                    }
                    if command == NativeCommand::Test {
                        if try add_test_main(allocator, &var lowerer.module) |failed| {
                            defer failed.deinit(allocator);
                            try report(io, allocator, &loader.sources, &failed);
                            return 1;
                        }
                    }
                    try keep_target_program(
                        allocator, &var lowerer.module, ""
                    );
                    var temps = try native::new_temp_dirs(allocator);
                    defer temps.deinit(allocator);
                    var host = string::new(allocator);
                    defer host.deinit(allocator);
                    if try native::host_key(io, allocator, &var temps, &var host) |failed| {
                        defer failed.deinit(allocator);
                        try report(io, allocator, &loader.sources, &failed);
                        return 1;
                    }
                    let darwin = native::target_is_darwin(options, &host);
                    var text = string::new(allocator);
                    defer text.deinit(allocator);
                    if try llvm::emit_native(allocator, &var lowerer.module, &var text, darwin) |failed| {
                        defer failed.deinit(allocator);
                        try report(io, allocator, &loader.sources, &failed);
                        return 1;
                    }
                    if command == NativeCommand::Build {
                        if try native::build(io, allocator, &var temps, options, &host, &text, &std_errors.sets) |failed| {
                            defer failed.deinit(allocator);
                            try report(io, allocator, &loader.sources, &failed);
                            return 1;
                        }
                        let output = options.output.as_bytes();
                        try io::write_stdout_line(io, output);
                        return 0;
                    }
                    var exe = string::new(allocator);
                    defer exe.deinit(allocator);
                    if try native::executable(io, allocator, &var temps, options, &host, &text, &std_errors.sets, &var exe) |failed| {
                        defer failed.deinit(allocator);
                        try report(io, allocator, &loader.sources, &failed);
                        return 1;
                    }
                    let exe_bytes = exe.as_bytes();
                    let code = try execute_built(allocator, exe_bytes, child_start, child_count);
                    if code != 0 {
                        return code;
                    }
                    if command == NativeCommand::Test {
                        try io::write_stdout_line(io, "test: ok");
                    }
                    return 0;
                },
            }
        },
    }
}

/// Builds an entry that runs every lowered test block in order, the Go
/// `addTestMain`. It writes IR by hand, so it ends by verifying what it
/// produced, the same way `internal/ir` verifies what it returns.
fn add_test_main(allocator: Allocator, module: &var ir::Module) -> !?diagnostic::Diagnostic {
    var test_names = array::new<ir::Name>(allocator);
    defer test_names.deinit(allocator);
    try ir::test_function_names(allocator, module, &var test_names);
    if test_names.len() == 0 {
        let failed = try diagnostic::from_text(allocator,
            diagnostic::Severity::Error,
            ast::zero_span(),
            "test error: no tests found"
        );
        return move failed;
    }
    // Loose-file lowering may already contain a native main; tests replace it.
    var reversed = array::new<ir::Function>(allocator);
    defer reversed.deinit(allocator);
    while module.functions.pop() |function| {
        try reversed.append(allocator, function);
    }
    var position = reversed.len();
    while position > 0 {
        position = position - 1;
        let function = reversed.get_or_panic(position);
        let name = module.function_name(function);
        if module.names.is(name, "main") {
            continue;
        }
        try module.functions.append(allocator, function);
    }
    // A test body returns `!void`, so the entry tries each result: the first
    // failing test returns its message instead of letting the run report ok.
    let bang_void = try module.names.intern("!void");
    let void_name = try module.names.intern("void");
    let main_name = try module.names.intern("main");
    let entry_name = try module.names.intern("entry");
    let main_function = ir::Function {
        node: try module.function_nodes.add(allocator, ir::FunctionNode {
            name: main_name,
            params: array::new<ir::Param>(allocator),
            return_type: bang_void,
            blocks: array::new<ir::Block>(allocator),
            export_abi: ir::empty_name(),
            export_name: ir::empty_name()
        })
    };
    try module.functions.append(allocator, main_function);
    let block = try module.add_block(main_function, entry_name);
    var index = 0;
    while test_names.get(index) |test_name| {
        var called_spelling = try string::from_bytes(allocator, "%test.");
        errdefer called_spelling.deinit(allocator);
        try stdfmt::append_i64(allocator, &var called_spelling, index);
        let called_name = try module.names.intern_owned(move called_spelling);
        let called = ir::Value { name: called_name, type_name: bang_void };
        let call = module.blank_instr(called, ir::Op::Call, test_name, ir::empty_name());
        let _ = try module.add_instr(allocator, block, move call);
        var tried_spelling = try string::from_bytes(allocator, "%try.");
        errdefer tried_spelling.deinit(allocator);
        try stdfmt::append_i64(allocator, &var tried_spelling, index);
        let tried_name = try module.names.intern_owned(move tried_spelling);
        let tried = ir::Value { name: tried_name, type_name: void_name };
        var tried_instr = module.blank_instr(tried, ir::Op::ErrorTry, ir::empty_name(), ir::empty_name());
        errdefer tried_instr.deinit(allocator);
        try tried_instr.args.append(allocator, called);
        let _ = try module.add_instr(allocator, block, move tried_instr);
        index = index + 1;
    }
    let ok_name = try module.names.intern("%test.ok");
    let ok = ir::Value { name: ok_name, type_name: bang_void };
    let ok_instr = module.blank_instr(ok, ir::Op::ErrorOk, ir::empty_name(), ir::empty_name());
    let _ = try module.add_instr(allocator, block, move ok_instr);
    module.set_terminator(block, ir::return_terminator(ok));
    return ir::verify(allocator, module);
}

/// Runs a linked executable with the arguments after `--` and returns its
/// exit status, the Go `executeBuilt`. std::process::spawn_wait8 carries at
/// most eight arguments, so the program and up to seven of its own fit.
fn execute_built(allocator: Allocator, exe: []u8, arg_start: i64, arg_count: i64) -> !i64 {
    var a0 = try string::from_bytes(allocator, exe);
    defer a0.deinit(allocator);
    var a1 = string::new(allocator);
    defer a1.deinit(allocator);
    var a2 = string::new(allocator);
    defer a2.deinit(allocator);
    var a3 = string::new(allocator);
    defer a3.deinit(allocator);
    var a4 = string::new(allocator);
    defer a4.deinit(allocator);
    var a5 = string::new(allocator);
    defer a5.deinit(allocator);
    var a6 = string::new(allocator);
    defer a6.deinit(allocator);
    var a7 = string::new(allocator);
    defer a7.deinit(allocator);
    if arg_count >= 1 {
        let value = try process::arg(arg_start);
        try a1.append_bytes(allocator, value);
    }
    if arg_count >= 2 {
        let value = try process::arg(arg_start + 1);
        try a2.append_bytes(allocator, value);
    }
    if arg_count >= 3 {
        let value = try process::arg(arg_start + 2);
        try a3.append_bytes(allocator, value);
    }
    if arg_count >= 4 {
        let value = try process::arg(arg_start + 3);
        try a4.append_bytes(allocator, value);
    }
    if arg_count >= 5 {
        let value = try process::arg(arg_start + 4);
        try a5.append_bytes(allocator, value);
    }
    if arg_count >= 6 {
        let value = try process::arg(arg_start + 5);
        try a6.append_bytes(allocator, value);
    }
    if arg_count >= 7 {
        let value = try process::arg(arg_start + 6);
        try a7.append_bytes(allocator, value);
    }
    let b0 = a0.as_bytes();
    let b1 = a1.as_bytes();
    let b2 = a2.as_bytes();
    let b3 = a3.as_bytes();
    let b4 = a4.as_bytes();
    let b5 = a5.as_bytes();
    let b6 = a6.as_bytes();
    let b7 = a7.as_bytes();
    let argc = 1 + arg_count;
    let code = try process::spawn_wait8(argc, b0, b1, b2, b3, b4, b5, b6, b7);
    return code;
}
