import compiler::lexer;
import compiler::source;
import compiler::token;
import std::mem;
import std::string;
import std::testing;

fn owned_text(allocator: Allocator, bytes: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes(bytes);
    return move out;
}

test "source map owns files and returns stable IDs" {
    let allocator = mem::page_allocator();
    var sources = source::new(allocator);
    defer sources.deinit();
    let main = try sources.add(
    try owned_text(allocator, "src/main.kizu"),
    try owned_text(allocator, "fn main() {}")
    );
    let helper = try sources.add(
    try owned_text(allocator, "src/helper.kizu"),
    try owned_text(allocator, "pub fn helper() {}")
    );
    testing::expect_equal<i64>(0, main.index);
    testing::expect_equal<i64>(1, helper.index);
    testing::expect_equal<i64>(2, sources.len());
    if sources.at(main) |file| {
        let path = file.path.as_bytes();
        let text = file.text.as_bytes();
        testing::expect(mem::equal_bytes(path, "src/main.kizu"));
        testing::expect(mem::equal_bytes(text, "fn main() {}"));
    } else {
        testing::fail("missing main source");
    }
    if sources.at(helper) |file| {
        let path = file.path.as_bytes();
        let text = file.text.as_bytes();
        testing::expect(mem::equal_bytes(path, "src/helper.kizu"));
        testing::expect(mem::equal_bytes(text, "pub fn helper() {}"));
    } else {
        testing::fail("missing helper source");
    }
}

test "source map rejects invalid IDs" {
    let allocator = mem::page_allocator();
    var sources = source::new(allocator);
    defer sources.deinit();
    if sources.at(source::SourceId {
        index: -1
    }) |_| {
        testing::fail("negative source ID resolved");
    }
    if sources.at(source::SourceId {
        index: 0
    }) |_| {
        testing::fail("missing source ID resolved");
    }
}

test "lexer borrows one source map input and copies its ID" {
    let allocator = mem::page_allocator();
    var sources = source::new(allocator);
    defer sources.deinit();
    let id = try sources.add(
    try owned_text(allocator, "sample.kizu"),
    try owned_text(allocator, "first second")
    );
    if sources.at(id) |file| {
        let input = file.text.as_bytes();
        var scanner = lexer::new_source(allocator, id, input);
        defer scanner.deinit();
        let first = try scanner.next_token();
        defer first.deinit();
        testing::expect(first.kind == token::Kind::Ident);
        if first.source |actual| {
            testing::expect_equal<i64>(id.index, actual.index);
        } else {
            testing::fail("token lost source ID");
        }
    } else {
        testing::fail("missing lexer source");
    }
}
