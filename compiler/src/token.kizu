import compiler::source;
import std::array;
import std::mem;
import std::string;

// Mechanical port of internal/token/token.go. Token text and attached comments
// own their bytes because the parser keeps more than one token while the lexer
// advances. Source is a copyable ID; compiler::source owns the path and input.

/// Identifies one lexical token kind.
pub enum Kind {
    Illegal,
    Eof,
    Ident,
    Int,
    String,
    Assign,
    Plus,
    Minus,
    Bang,
    Question,
    Amp,
    Asterisk,
    Slash,
    Percent,
    At,
    Eq,
    FatArrow,
    NotEq,
    Lt,
    Lte,
    Gt,
    Gte,
    Arrow,
    Dot,
    Range,
    DoubleColon,
    Comma,
    Colon,
    Semicolon,
    Pipe,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Function,
    Import,
    Public,
    Let,
    Var,
    Return,
    Defer,
    ErrDefer,
    If,
    Else,
    While,
    Break,
    Continue,
    Match,
    Struct,
    Enum,
    Union,
    Contract,
    For,
    Impl,
    True,
    False,
    And,
    Or,
    Mut,
    Unsafe,
    Extern,
    Comptime,
    Try,
    Move,
    Null,
    Orelse,
}

/// Carries one lexical token and its source location.
pub struct Token {
    pub kind: Kind,
    pub literal: string::String,
    pub line: i64,
    pub column: i64,
    pub doc_comments: array::Array<string::String>,
    pub safety: array::Array<string::String>,
    pub source: ?source::SourceId
}

/// Returns the keyword kind for ident, or Ident for a user name.
pub fn lookup_ident(ident: []u8) -> Kind {
    if mem::equal_bytes(ident, "fn") {
        return Kind::Function;
    }
    if mem::equal_bytes(ident, "import") {
        return Kind::Import;
    }
    if mem::equal_bytes(ident, "pub") {
        return Kind::Public;
    }
    if mem::equal_bytes(ident, "let") {
        return Kind::Let;
    }
    if mem::equal_bytes(ident, "var") {
        return Kind::Var;
    }
    if mem::equal_bytes(ident, "return") {
        return Kind::Return;
    }
    if mem::equal_bytes(ident, "defer") {
        return Kind::Defer;
    }
    if mem::equal_bytes(ident, "errdefer") {
        return Kind::ErrDefer;
    }
    if mem::equal_bytes(ident, "if") {
        return Kind::If;
    }
    if mem::equal_bytes(ident, "else") {
        return Kind::Else;
    }
    if mem::equal_bytes(ident, "while") {
        return Kind::While;
    }
    if mem::equal_bytes(ident, "break") {
        return Kind::Break;
    }
    if mem::equal_bytes(ident, "continue") {
        return Kind::Continue;
    }
    if mem::equal_bytes(ident, "match") {
        return Kind::Match;
    }
    if mem::equal_bytes(ident, "struct") {
        return Kind::Struct;
    }
    if mem::equal_bytes(ident, "enum") {
        return Kind::Enum;
    }
    if mem::equal_bytes(ident, "union") {
        return Kind::Union;
    }
    if mem::equal_bytes(ident, "contract") {
        return Kind::Contract;
    }
    if mem::equal_bytes(ident, "for") {
        return Kind::For;
    }
    if mem::equal_bytes(ident, "impl") {
        return Kind::Impl;
    }
    if mem::equal_bytes(ident, "true") {
        return Kind::True;
    }
    if mem::equal_bytes(ident, "false") {
        return Kind::False;
    }
    if mem::equal_bytes(ident, "and") {
        return Kind::And;
    }
    if mem::equal_bytes(ident, "or") {
        return Kind::Or;
    }
    if mem::equal_bytes(ident, "mut") {
        return Kind::Mut;
    }
    if mem::equal_bytes(ident, "unsafe") {
        return Kind::Unsafe;
    }
    if mem::equal_bytes(ident, "extern") {
        return Kind::Extern;
    }
    if mem::equal_bytes(ident, "comptime") {
        return Kind::Comptime;
    }
    if mem::equal_bytes(ident, "try") {
        return Kind::Try;
    }
    if mem::equal_bytes(ident, "move") {
        return Kind::Move;
    }
    if mem::equal_bytes(ident, "null") {
        return Kind::Null;
    }
    if mem::equal_bytes(ident, "orelse") {
        return Kind::Orelse;
    }
    return Kind::Ident;
}

/// Returns the source or diagnostic spelling carried by the Go token type.
pub fn spelling(kind: Kind) -> []u8 {
    return match kind {
        Illegal => "ILLEGAL",
        Eof => "EOF",
        Ident => "IDENT",
        Int => "INT",
        String => "STRING",
        Assign => "=",
        Plus => "+",
        Minus => "-",
        Bang => "!",
        Question => "?",
        Amp => "&",
        Asterisk => "*",
        Slash => "/",
        Percent => "%",
        At => "@",
        Eq => "==",
        FatArrow => "=>",
        NotEq => "!=",
        Lt => "<",
        Lte => "<=",
        Gt => ">",
        Gte => ">=",
        Arrow => "->",
        Dot => ".",
        Range => "..",
        DoubleColon => "::",
        Comma => ",",
        Colon => ":",
        Semicolon => ";",
        Pipe => "|",
        LParen => "(",
        RParen => ")",
        LBrace => "{",
        RBrace => "}",
        LBracket => "[",
        RBracket => "]",
        Function => "fn",
        Import => "import",
        Public => "pub",
        Let => "let",
        Var => "var",
        Return => "return",
        Defer => "defer",
        ErrDefer => "errdefer",
        If => "if",
        Else => "else",
        While => "while",
        Break => "break",
        Continue => "continue",
        Match => "match",
        Struct => "struct",
        Enum => "enum",
        Union => "union",
        Contract => "contract",
        For => "for",
        Impl => "impl",
        True => "true",
        False => "false",
        And => "and",
        Or => "or",
        Mut => "mut",
        Unsafe => "unsafe",
        Extern => "extern",
        Comptime => "comptime",
        Try => "try",
        Move => "move",
        Null => "null",
        Orelse => "orelse",
    };
}
