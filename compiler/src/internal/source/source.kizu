import std::array;
import std::string;

// Mechanical port of internal/source/source.go. The map owns each path and
// input once; syntax records carry only the copyable integer ID.

/// Identifies one source file inside a SourceMap.
pub struct SourceId {
    pub index: i64
}

/// Owns one immutable compiler input.
pub struct SourceFile {
    pub path: string::String,
    pub text: string::String
}

/// Owns every source file loaded for one compiler invocation.
pub struct SourceMap {
    allocator: Allocator,
    files: array::Array<SourceFile>
}

/// Creates an empty source map using allocator for its file storage.
pub fn new(allocator: Allocator) -> SourceMap {
    return SourceMap {
        allocator: allocator,
        files: array::new<SourceFile>(allocator)
    };
}

/// Adds one owned source file and returns its stable ID.
fn (self: &var SourceMap) add(
    path: string::String,
    text: string::String
) -> !SourceId {
    let id = SourceId {
        index: self.files.len()
    };
    try self.files.append(self.allocator, SourceFile {
        path: move path,
        text: move text
    });
    return id;
}

/// Returns the source file named by id, or null for an invalid ID.
fn (self: &SourceMap) at(id: SourceId) -> ?&SourceFile {
    if id.index < 0 {
        return null;
    }
    return self.files.at(id.index);
}

/// Returns the number of files in the map.
fn (self: &SourceMap) len() -> i64 {
    return self.files.len();
}
