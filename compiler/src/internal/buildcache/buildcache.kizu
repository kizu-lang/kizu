import compiler::internal::fsutil;
import compiler::internal::sha256;
import std::array;
import std::date;
import std::fs;
import std::json;
import std::mem;
import std::path;
import std::process;
import std::string;
import std::time;

// Mechanical port of internal/buildcache/cache.go: the local store of build
// artifacts both compilers share. Cache keys, artifact file names and entry
// file names are byte-identical with the Go side, which is what lets a
// build made by one CLI be reused by the other. The Go builder callbacks
// cannot cross a Kizu module boundary (no closures), so `GetOrBuild` and
// `GetOrBuildArtifact` are split in two: the first half answers hit or
// miss, the caller runs its builder on a miss, and the second half stores
// what was built.

/// The Go `Version`: included in cache keys so incompatible formats do not
/// collide.
pub fn version() -> []u8 {
    return "native-v1";
}

/// The Go `DefaultMaxBytes`: bounds the local cache to 256 MiB by default.
pub fn default_max_bytes() -> i64 {
    return 268435456;
}

/// Stores local Kizu build artifacts, the Go `Cache`.
pub struct Cache {
    pub dir: string::String,
    pub max_bytes: i64,
    scratch_sequence: i64,
}

/// Describes one cached build artifact, the Go `Entry`. The fields spell
/// the JSON keys `encoding/json` writes, so `std::json` reads the entries
/// the Go side stores and the Go side reads what this module stores.
pub struct Entry {
    pub key: string::String,
    pub target: string::String,
    pub source_hash: string::String,
    pub version: string::String,
    pub output: string::String,
    pub size_bytes: i64,
    pub created_at: string::String,
    /// When a build last read or stored the artifact, the Go `UsedAt`: what
    /// eviction orders by. An entry written before the field existed has
    /// none and is ordered by created_at.
    pub used_at: ?string::String,
}

/// Summarizes cache state, the Go `Status`.
pub struct Status {
    pub dir: string::String,
    pub max_bytes: i64,
    pub size_bytes: i64,
    pub entries: i64,
    /// The entries and bytes of each artifact kind, sorted by kind.
    pub kinds: array::Array<KindStatus>,
}

/// The share of the cache one artifact kind holds, the Go `KindStatus`.
pub struct KindStatus {
    pub kind: string::String,
    pub entries: i64,
    pub size_bytes: i64,
}

/// What the Go `Prune` reports: the entries removed and the bytes freed.
pub struct PruneResult {
    pub entries: i64,
    pub bytes: i64,
}

/// Keys one artifact, the Go `cacheInput`.
pub struct CacheInput {
    pub key: string::String,
    pub target: string::String,
    pub source_hash: string::String,
}

/// A miss the Go `GetOrBuildArtifact` would build: the caller builds into
/// `scratch` and hands the plan to `finish_artifact`, or abandons it with
/// `discard_artifact` when its builder failed.
pub struct PendingArtifact {
    pub input: CacheInput,
    pub scratch: string::String,
    pub stored: string::String,
    pub output: string::String,
}

/// What the first half of the Go `GetOrBuildArtifact` decided.
pub union ArtifactPlan {
    Hit,
    Miss(PendingArtifact),
}

/// Returns the default local cache, the Go `New`.
pub fn new(io: Io, allocator: Allocator) -> !Cache {
    var dir = string::new(allocator);
    errdefer dir.deinit(allocator);
    try resolve_cache_dir(io, allocator, &var dir);
    return Cache {
        dir: move dir,
        max_bytes: default_max_bytes(),
        scratch_sequence: 0
    };
}

/// Decides the cache directory, the Go `New`'s spelling: KIZU_CACHE_DIR
/// wins, else the platform cache directory plus `kizu`.
fn resolve_cache_dir(io: Io, allocator: Allocator, out: &var string::String) -> !void {
    if process::env("KIZU_CACHE_DIR") |given| {
        if mem::len(given) > 0 {
            return out.append_bytes(allocator, given);
        }
    }
    try fsutil::append_user_cache_dir(io, allocator, out);
    return out.append_bytes(allocator, "/kizu");
}

/// Appends the lowercase hex SHA-256 digest of bytes to out, the hash a
/// caller spells one of an artifact's inputs by inside a target.
pub fn (self: &Cache) append_content_hash(
    allocator: Allocator,
    bytes: []u8,
    out: &var string::String
) -> !void {
    return sha256::append_hex_digest(allocator, bytes, out);
}

/// Keys an artifact by everything it is made of, the Go `newInput`: the
/// cache format, the target, the name, and the bytes it is built from.
pub fn (self: &Cache) new_input(
    allocator: Allocator,
    name: []u8,
    target: []u8,
    content: []u8
) -> !CacheInput {
    var source_hash = string::new(allocator);
    errdefer source_hash.deinit(allocator);
    try sha256::append_hex_digest(allocator, content, &var source_hash);
    var message = string::new(allocator);
    defer message.deinit(allocator);
    try message.append_bytes(allocator, version());
    try message.append_byte(allocator, cast<u8>(10));
    try message.append_bytes(allocator, target);
    try message.append_byte(allocator, cast<u8>(10));
    try message.append_bytes(allocator, name);
    try message.append_byte(allocator, cast<u8>(10));
    try message.append_string(allocator, &source_hash);
    var key = string::new(allocator);
    errdefer key.deinit(allocator);
    let message_bytes = message.as_bytes();
    try sha256::append_hex_digest(allocator, message_bytes, &var key);
    let target_copy = try string::from_bytes(allocator, target);
    return CacheInput {
        key: move key,
        target: move target_copy,
        source_hash: move source_hash
    };
}

/// Answers the first half of the Go `GetOrBuildArtifact` for one artifact
/// built from content the compiler carries itself: on a hit out_path names
/// the stored artifact, on a miss it names where the artifact will be once
/// the caller builds into the plan's scratch path and finishes.
pub fn (self: &var Cache) get_or_build_artifact(
    io: Io,
    allocator: Allocator,
    name: []u8,
    target: []u8,
    content: []u8,
    out_path: &var string::String
) -> !ArtifactPlan {
    let input = try self.new_input(allocator, name, target, content);
    errdefer input.deinit(allocator);
    let stored = try output_name_of(allocator, &input.key);
    errdefer stored.deinit(allocator);
    let output = try self.output_path_of(allocator, &stored);
    errdefer output.deinit(allocator);
    let hit = try self.artifact_hit(io, allocator, &input.key);
    if hit {
        try self.mark_used(io, allocator, &input.key);
        try out_path.append_string(allocator, &output);
        input.deinit(allocator);
        stored.deinit(allocator);
        output.deinit(allocator);
        return ArtifactPlan::Hit;
    }
    let dir_bytes = self.dir.as_bytes();
    try fsutil::create_dir_all(io, dir_bytes);
    var scratch_name = string::new(allocator);
    defer scratch_name.deinit(allocator);
    try fsutil::append_scratch_name(allocator, &input.key, self.scratch_sequence, &var scratch_name);
    self.scratch_sequence = self.scratch_sequence + 1;
    let scratch = try self.output_path_of(allocator, &scratch_name);
    errdefer scratch.deinit(allocator);
    try out_path.append_string(allocator, &output);
    return ArtifactPlan::Miss(PendingArtifact {
        input: move input,
        scratch: move scratch,
        stored: move stored,
        output: move output
    });
}

/// Moves what the builder made into place and records it, the tail of the
/// Go `buildArtifact` plus `writeMeta` and `enforceLimit`: the artifact is
/// renamed from the scratch path first, so an entry never promises a file
/// that is not there yet.
pub fn (self: &Cache) finish_artifact(
    io: Io,
    allocator: Allocator,
    pending: PendingArtifact
) -> !void {
    errdefer pending.deinit(allocator);
    try self.install_artifact(io, allocator, &pending);
    pending.deinit(allocator);
    return self.enforce_limit(io, allocator);
}

/// Stats, renames and records one built artifact.
fn (self: &Cache) install_artifact(
    io: Io,
    allocator: Allocator,
    pending: &PendingArtifact
) -> !void {
    let scratch_bytes = pending.scratch.as_bytes();
    let info = try fs::metadata(io, scratch_bytes);
    let output_bytes = pending.output.as_bytes();
    try fs::rename(io, scratch_bytes, output_bytes);
    let stored_bytes = pending.stored.as_bytes();
    return self.write_meta(io, allocator, &pending.input, stored_bytes, info.size);
}

/// Records that a build read the entry's artifact, the Go `markUsed`, so
/// eviction takes what no build has asked for longest rather than what was
/// made first.
fn (self: &Cache) mark_used(io: Io, allocator: Allocator, key: &string::String) -> !void {
    let key_bytes = key.as_bytes();
    if try self.read_entry(io, allocator, key_bytes) |entry| {
        defer entry.deinit(allocator);
        var stamp = string::new(allocator);
        defer stamp.deinit(allocator);
        try append_now(allocator, &var stamp);
        let created = entry.created_at.as_bytes();
        let stamp_bytes = stamp.as_bytes();
        return self.write_entry(io, allocator, &entry, created, stamp_bytes);
    }
    return;
}

/// Abandons a miss whose builder failed, the Go `defer os.Remove` of the
/// scratch file: what was half-built is removed, and nothing is recorded.
pub fn (self: &Cache) discard_artifact(
    io: Io,
    allocator: Allocator,
    pending: PendingArtifact
) -> !void {
    errdefer pending.deinit(allocator);
    try remove_scratch(io, &pending);
    pending.deinit(allocator);
    return;
}

/// Removes the scratch file when the builder left one behind.
fn remove_scratch(io: Io, pending: &PendingArtifact) -> !void {
    let scratch_bytes = pending.scratch.as_bytes();
    let found = try fs::exists(io, scratch_bytes);
    if found {
        try fs::remove_file(io, scratch_bytes);
    }
    return;
}

/// Reports whether a key has both the entry that accounts for it and the
/// file that entry names, the Go `hasArtifact`: an entry whose artifact is
/// gone is a miss.
pub fn (self: &Cache) has_artifact(io: Io, allocator: Allocator, key: []u8) -> !?Entry {
    if try self.read_entry(io, allocator, key) |entry| {
        errdefer entry.deinit(allocator);
        let name_bytes = entry.output.as_bytes();
        let stored = try self.output_path(allocator, name_bytes);
        defer stored.deinit(allocator);
        let stored_bytes = stored.as_bytes();
        let found = try fs::exists(io, stored_bytes);
        if !found {
            entry.deinit(allocator);
            return null;
        }
        return move entry;
    }
    return null;
}

/// Reports a hit with the key still owned by a CacheInput, so the caller
/// keeps no borrow of the input alive and can move it afterwards.
fn (self: &Cache) artifact_hit(io: Io, allocator: Allocator, key: &string::String) -> !bool {
    let key_bytes = key.as_bytes();
    if try self.has_artifact(io, allocator, key_bytes) |entry| {
        entry.deinit(allocator);
        return true;
    }
    return false;
}

/// Records what one stored artifact is and how much room it takes, the Go
/// `writeMeta`. It is written after the artifact it describes, so an entry
/// never promises a file that is not there yet.
fn (self: &Cache) write_meta(
    io: Io,
    allocator: Allocator,
    input: &CacheInput,
    stored: []u8,
    size: i64
) -> !void {
    var stamp = string::new(allocator);
    defer stamp.deinit(allocator);
    try append_now(allocator, &var stamp);
    var output = string::new(allocator);
    defer output.deinit(allocator);
    try output.append_bytes(allocator, stored);
    var version_text = string::new(allocator);
    defer version_text.deinit(allocator);
    try version_text.append_bytes(allocator, version());
    let stamp_bytes = stamp.as_bytes();
    return self.write_fields(
        io,
        allocator,
        &input.key,
        &input.target,
        &input.source_hash,
        &version_text,
        &output,
        size,
        stamp_bytes,
        stamp_bytes
    );
}

/// Writes one metadata entry with its created_at and used_at stamps, the Go
/// `writeEntry`.
fn (self: &Cache) write_entry(
    io: Io,
    allocator: Allocator,
    entry: &Entry,
    created: []u8,
    used: []u8
) -> !void {
    return self.write_fields(
        io,
        allocator,
        &entry.key,
        &entry.target,
        &entry.source_hash,
        &entry.version,
        &entry.output,
        entry.size_bytes,
        created,
        used
    );
}

/// Encodes the fields of one entry and writes them under its key.
fn (self: &Cache) write_fields(
    io: Io,
    allocator: Allocator,
    key: &string::String,
    target: &string::String,
    source_hash: &string::String,
    entry_version: &string::String,
    output: &string::String,
    size: i64,
    created: []u8,
    used: []u8
) -> !void {
    var encoder = json::encoder_with_spaces(allocator, 2);
    defer encoder.deinit(allocator);
    try encoder.begin_object();
    try write_field(&var encoder, "key", key);
    try write_field(&var encoder, "target", target);
    try write_field(&var encoder, "source_hash", source_hash);
    try write_field(&var encoder, "version", entry_version);
    try write_field(&var encoder, "output", output);
    try encoder.write_i64_field("size_bytes", size);
    try encoder.write_bytes_field("created_at", created);
    try encoder.write_bytes_field("used_at", used);
    try encoder.end_object();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(allocator, &var out);
    let key_bytes = key.as_bytes();
    let meta = try self.meta_path(allocator, key_bytes);
    defer meta.deinit(allocator);
    let meta_bytes = meta.as_bytes();
    let text = out.as_bytes();
    try fs::write_file(io, meta_bytes, text);
    return;
}

/// Appends the present moment as an RFC 3339 stamp.
fn append_now(allocator: Allocator, out: &var string::String) -> !void {
    let now = date::from_unix(time::unix(process::unix_millis()));
    return now.append_iso(allocator, out);
}

/// Writes one owned value as an entry field.
fn write_field(encoder: &var json::Encoder, name: []u8, value: &string::String) -> !void {
    let bytes = value.as_bytes();
    return encoder.write_bytes_field(name, bytes);
}

/// Reads one metadata entry, the Go `readEntry`. A read that fails for any
/// reason is a miss, the way Go treats any `os.ReadFile` error, and a file
/// std::json cannot decode is a miss the way Go treats any `json.Unmarshal`
/// error: a stale or corrupt entry never becomes a failure of the caller.
pub fn (self: &Cache) read_entry(io: Io, allocator: Allocator, key: []u8) -> !?Entry {
    let meta = try self.meta_path(allocator, key);
    defer meta.deinit(allocator);
    let meta_bytes = meta.as_bytes();
    if fs::read_file(io, allocator, meta_bytes, mem::Limit::Unlimited) |text| {
        defer text.deinit(allocator);
        let data = text.as_bytes();
        if json::decode_ignore_unknown<Entry>(allocator, data) |entry| {
            return move entry;
        } else |err| {
            match err {
                _ => return null,
            }
        }
    } else |err| {
        match err {
            _ => return null,
        }
    }
}

/// Reads all metadata entries, the Go `entries`. Go walks the sorted
/// glob; the order is unobservable (sums, and an eviction sort that
/// re-orders by time), so the directory order is read as it comes.
pub fn (self: &Cache) entries(io: Io, allocator: Allocator, out: &var array::Array<Entry>) -> !void {
    let dir_bytes = self.dir.as_bytes();
    let dir_found = try fs::exists(io, dir_bytes);
    if !dir_found {
        return;
    }
    var listed = try fs::read_dir(io, allocator, dir_bytes);
    defer listed.deinit(allocator);
    var index = 0;
    while listed.at(index) |item| {
        index = index + 1;
        if item.is_dir {
            continue;
        }
        let item_name = item.name.as_bytes();
        if fsutil::has_suffix(item_name, ".json") {
            let item_path = item.path.as_bytes();
            try append_entry_at(io, allocator, item_path, out);
        }
    }
    return;
}

/// Reads the entry one metadata file holds and appends it.
fn append_entry_at(io: Io, allocator: Allocator, full: []u8, out: &var array::Array<Entry>) -> !void {
    // A concurrent process may evict an entry between the walk and the
    // read: work that is gone is a miss, not a failure, and every other
    // read failure propagates — the Go `os.IsNotExist` split. A file
    // std::json cannot decode is skipped, the Go continue on a
    // `json.Unmarshal` error.
    if fs::read_file(io, allocator, full, mem::Limit::Unlimited) |text| {
        defer text.deinit(allocator);
        let data = text.as_bytes();
        if json::decode_ignore_unknown<Entry>(allocator, data) |entry| {
            // Go decodes `created_at` into a time.Time, so an entry whose
            // stamp it cannot read is one it skips; std::json reads the
            // field as a String, so the same refusal is spelled here.
            if created_moment(&entry) |_| {
                try out.append(allocator, move entry);
            } else {
                entry.deinit(allocator);
            }
        } else |err| {
            match err {
                _ => return,
            }
        }
    } else |err| {
        match err {
            NotFound => return,
            _ => return err,
        }
    }
    return;
}

/// Returns current cache size and entry count, the Go `Status`.
pub fn (self: &Cache) status(io: Io, allocator: Allocator) -> !Status {
    var all = array::new<Entry>(allocator);
    defer all.deinit(allocator);
    try self.entries(io, allocator, &var all);
    var size = 0;
    var kinds = array::new<KindStatus>(allocator);
    errdefer kinds.deinit(allocator);
    var index = 0;
    while all.at(index) |entry| {
        index = index + 1;
        size = size + entry.size_bytes;
        try count_kind(allocator, &var kinds, entry);
    }
    let count = all.len();
    var dir = string::new(allocator);
    errdefer dir.deinit(allocator);
    try dir.append_string(allocator, &self.dir);
    return Status {
        dir: move dir,
        max_bytes: self.max_bytes,
        size_bytes: size,
        entries: count,
        kinds: move kinds
    };
}

/// The kind of artifact an entry holds, the Go `Entry.Kind`: the first
/// segment of its target.
pub fn entry_kind(entry: &Entry) -> []u8 {
    let target = entry.target.as_bytes();
    var end = 0;
    let length = mem::len(target);
    while end < length {
        if target[end] == cast<u8>(47) {
            return target[0..end];
        }
        end = end + 1;
    }
    return target;
}

/// Adds one entry to the share of its kind, keeping the kinds sorted: a
/// kind seen first is appended and moved down past every kind it sorts
/// before.
fn count_kind(allocator: Allocator, kinds: &var array::Array<KindStatus>, entry: &Entry) -> !void {
    let kind = entry_kind(entry);
    var at = 0;
    while kinds.at_mut(at) |share| {
        let name = share.kind.as_bytes();
        if mem::equal_bytes(name, kind) {
            share.entries = share.entries + 1;
            share.size_bytes = share.size_bytes + entry.size_bytes;
            return;
        }
        at = at + 1;
    }
    let spelled = try string::from_bytes(allocator, kind);
    try kinds.append(allocator, KindStatus {
        kind: move spelled,
        entries: 1,
        size_bytes: entry.size_bytes
    });
    var placed = kinds.len() - 1;
    while placed > 0 and kind_before(kinds, placed, placed - 1) {
        try kinds.swap(placed, placed - 1);
        placed = placed - 1;
    }
    return;
}

/// Orders two kinds by name.
fn kind_before(kinds: &array::Array<KindStatus>, left: i64, right: i64) -> bool {
    if kinds.at(left) |a| {
        if kinds.at(right) |b| {
            let a_name = a.kind.as_bytes();
            let b_name = b.kind.as_bytes();
            return mem::compare(a_name, b_name) < 0;
        }
    }
    return false;
}

/// Removes every cache entry, the Go `Prune`.
pub fn (self: &Cache) prune(io: Io, allocator: Allocator) -> !PruneResult {
    var all = array::new<Entry>(allocator);
    defer all.deinit(allocator);
    try self.entries(io, allocator, &var all);
    var bytes = 0;
    var index = 0;
    while all.at(index) |entry| {
        index = index + 1;
        bytes = bytes + entry.size_bytes;
        try self.remove_entry_files(io, allocator, entry);
    }
    let count = all.len();
    return PruneResult { entries: count, bytes: bytes };
}

/// Removes the entries used longest ago until the cache fits max_bytes, the
/// Go `enforceLimit`: what the stored files measure is asked first, and the
/// entries are read and ordered only when that is over the limit.
pub fn (self: &Cache) enforce_limit(io: Io, allocator: Allocator) -> !void {
    let stored = try self.stored_bytes(io, allocator);
    if stored <= self.max_bytes {
        return;
    }
    var all = array::new<Entry>(allocator);
    defer all.deinit(allocator);
    try self.entries(io, allocator, &var all);
    let count = all.len();
    var a = 0;
    while a < count {
        var smallest = a;
        var b = a + 1;
        while b < count {
            if entry_before(&all, b, smallest) {
                smallest = b;
            }
            b = b + 1;
        }
        if smallest != a {
            try all.swap(a, smallest);
        }
        a = a + 1;
    }
    var size = 0;
    var index = 0;
    while all.at(index) |entry| {
        index = index + 1;
        size = size + entry.size_bytes;
    }
    index = 0;
    while all.at(index) |entry| {
        index = index + 1;
        if size <= self.max_bytes {
            return;
        }
        size = size - entry.size_bytes;
        try self.remove_entry_files(io, allocator, entry);
    }
    return;
}

/// Sums the sizes of the stored artifacts, the Go `storedBytes`. An
/// artifact whose entry is gone still counts: it takes the room all the
/// same.
fn (self: &Cache) stored_bytes(io: Io, allocator: Allocator) -> !i64 {
    let dir_bytes = self.dir.as_bytes();
    var listed = try fs::read_dir(io, allocator, dir_bytes);
    defer listed.deinit(allocator);
    var size = 0;
    var index = 0;
    while listed.at(index) |item| {
        index = index + 1;
        if item.is_dir {
            continue;
        }
        let item_name = item.name.as_bytes();
        if !fsutil::has_suffix(item_name, ".out") {
            continue;
        }
        let item_path = item.path.as_bytes();
        // A concurrent process may evict an artifact between the listing
        // and the stat; gone takes no room.
        if fs::metadata(io, item_path) |info| {
            size = size + info.size;
        } else |err| {
            match err {
                NotFound => {},
                _ => return err,
            }
        }
    }
    return size;
}

/// Removes the metadata and artifact files of one entry when they are
/// there, the Go removes that ignore `os.IsNotExist`.
fn (self: &Cache) remove_entry_files(io: Io, allocator: Allocator, entry: &Entry) -> !void {
    let key_bytes = entry.key.as_bytes();
    let meta = try self.meta_path(allocator, key_bytes);
    defer meta.deinit(allocator);
    let meta_bytes = meta.as_bytes();
    let meta_found = try fs::exists(io, meta_bytes);
    if meta_found {
        try fs::remove_file(io, meta_bytes);
    }
    let output_bytes = entry.output.as_bytes();
    let stored = try self.output_path(allocator, output_bytes);
    defer stored.deinit(allocator);
    let stored_bytes = stored.as_bytes();
    let stored_found = try fs::exists(io, stored_bytes);
    if stored_found {
        try fs::remove_file(io, stored_bytes);
    }
    return;
}

/// The moment the entry was last used: used_at when the entry has one,
/// else created_at, the Go `lastUsed`.
fn used_moment(entry: &Entry) -> ?date::DateTime {
    if entry.used_at |used| {
        let stamp = used.as_bytes();
        if date::parse_datetime(stamp) |moment| {
            return moment;
        } else |err| {
            match err {
                _ => return null,
            }
        }
    }
    return created_moment(entry);
}

/// The moment `created_at` spells, null when it is not an RFC 3339 stamp:
/// what Go's time.Time decodes.
fn created_moment(entry: &Entry) -> ?date::DateTime {
    let stamp = entry.created_at.as_bytes();
    if date::parse_datetime(stamp) |moment| {
        return moment;
    } else |err| {
        match err {
            _ => return null,
        }
    }
}

/// Orders two entries by the moment they were last used and then by key,
/// the ascending sort of the Go `enforceLimit`.
fn entry_before(all: &array::Array<Entry>, left: i64, right: i64) -> bool {
    if all.at(left) |a| {
        if all.at(right) |b| {
            if used_moment(a) |a_moment| {
                if used_moment(b) |b_moment| {
                    if !a_moment.equals(b_moment) {
                        return a_moment.before(b_moment);
                    }
                    let a_key = a.key.as_bytes();
                    let b_key = b.key.as_bytes();
                    return mem::compare(a_key, b_key) < 0;
                }
            }
        }
    }
    return false;
}

/// Returns the metadata path for key, the Go `metaPath`.
pub fn (self: &Cache) meta_path(allocator: Allocator, key: []u8) -> !string::String {
    var name = string::new(allocator);
    defer name.deinit(allocator);
    try name.append_bytes(allocator, key);
    try name.append_bytes(allocator, ".json");
    let dir_bytes = self.dir.as_bytes();
    let name_bytes = name.as_bytes();
    return path::join(allocator, dir_bytes, name_bytes);
}

/// Returns the file name the artifact for key is stored under, the Go
/// `outputName`.
pub fn output_name(allocator: Allocator, key: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, key);
    try out.append_bytes(allocator, ".out");
    return move out;
}

/// Reads `output_name` with the key still owned by a CacheInput.
fn output_name_of(allocator: Allocator, key: &string::String) -> !string::String {
    let key_bytes = key.as_bytes();
    return output_name(allocator, key_bytes);
}

/// Returns the artifact path for name, the Go `outputPath`.
pub fn (self: &Cache) output_path(allocator: Allocator, name: []u8) -> !string::String {
    let dir_bytes = self.dir.as_bytes();
    return path::join(allocator, dir_bytes, name);
}

/// Reads `output_path` with the name still owned by a String.
fn (self: &Cache) output_path_of(allocator: Allocator, name: &string::String) -> !string::String {
    let name_bytes = name.as_bytes();
    return self.output_path(allocator, name_bytes);
}
