import compiler::internal::sha256;
import std::array;
import std::fmt;
import std::fs;
import std::json;
import std::mem;
import std::path;
import std::process;
import std::sort;
import std::string;

// Mechanical port of internal/buildcache/cache.go: the local store of build
// artifacts both compilers share. Cache keys, artifact file names and entry
// file names are byte-identical with the Go side, which is what lets a
// build made by one CLI be reused by the other. The Go builder callbacks
// cannot cross a Kizu module boundary (no closures), so `GetOrBuild` and
// `GetOrBuildArtifact` are split in two: the first half answers hit or
// miss, the caller runs its builder on a miss, and the second half stores
// what was built.

/// The Go `Version`: included in cache keys so incompatible formats do not
/// collide.
pub fn version() -> []u8 {
    return "native-v1";
}

/// The Go `DefaultMaxBytes`: bounds the local cache to 256 MiB by default.
pub fn default_max_bytes() -> i64 {
    return 268435456;
}

pub error Error {
    MissingCacheHome,
}

/// Stores local Kizu build artifacts, the Go `Cache`. It also owns the
/// sha256 hasher every key derivation reads, so the bitwise tables are
/// built once per cache rather than once per key.
pub struct Cache {
    pub dir: string::String,
    pub max_bytes: i64,
    hasher: sha256::Hasher,
    scratch_sequence: i64
}

/// Describes one cached build artifact, the Go `Entry`. The fields spell
/// the JSON keys `encoding/json` writes, so `std::json` reads the entries
/// the Go side stores and the Go side reads what this module stores.
pub struct Entry {
    pub key: string::String,
    pub target: string::String,
    pub source_hash: string::String,
    pub version: string::String,
    pub output: string::String,
    pub size_bytes: i64,
    pub created_at: string::String
}

/// Summarizes cache state, the Go `Status`.
pub struct Status {
    pub dir: string::String,
    pub max_bytes: i64,
    pub size_bytes: i64,
    pub entries: i64
}

/// What the Go `Prune` reports: the entries removed and the bytes freed.
pub struct PruneResult {
    pub entries: i64,
    pub bytes: i64
}

/// Keys one artifact, the Go `cacheInput`.
pub struct CacheInput {
    pub key: string::String,
    pub target: string::String,
    pub source_hash: string::String
}

/// What the first half of the Go `GetOrBuild` decided: the artifact text
/// was cached and is in the caller's buffer, or the caller has to run its
/// builder and hand the output to `finish_get_or_build` with this input.
pub union GetOrBuild {
    Hit,
    Miss(CacheInput),
}

/// A miss the Go `GetOrBuildArtifact` would build: the caller builds into
/// `scratch` and hands the plan to `finish_artifact`, or abandons it with
/// `discard_artifact` when its builder failed.
pub struct PendingArtifact {
    pub input: CacheInput,
    pub scratch: string::String,
    pub stored: string::String,
    pub output: string::String
}

/// What the first half of the Go `GetOrBuildArtifact` decided.
pub union ArtifactPlan {
    Hit,
    Miss(PendingArtifact),
}

/// Returns the default local cache, the Go `New`.
pub fn new(io: Io, allocator: Allocator) -> !Cache {
    var dir = string::new(allocator);
    errdefer dir.deinit();
    try resolve_cache_dir(io, allocator, &var dir);
    let hasher = try sha256::new(allocator);
    return Cache {
        dir: move dir,
        max_bytes: default_max_bytes(),
        hasher: move hasher,
        scratch_sequence: 0
    };
}

/// Decides the cache directory the way Go `os.UserCacheDir` does, probed
/// rather than compiled per platform: KIZU_CACHE_DIR wins, a home with
/// Library/Caches is the macOS spelling, and XDG_CACHE_HOME or ~/.cache is
/// the Linux spelling.
fn resolve_cache_dir(io: Io, allocator: Allocator, out: &var string::String) -> !void {
    if process::env("KIZU_CACHE_DIR") |given| {
        if mem::len(given) > 0 {
            return out.append_bytes(given);
        }
    }
    let home = process::env("HOME") orelse "";
    if mem::len(home) > 0 {
        let mac_base = try path::join(allocator, home, "Library/Caches");
        defer mac_base.deinit();
        let mac_bytes = mac_base.as_bytes();
        let mac = try fs::exists(io, mac_bytes);
        if mac {
            try out.append_bytes(mac_bytes);
            return out.append_bytes("/kizu");
        }
    }
    if process::env("XDG_CACHE_HOME") |xdg| {
        if mem::len(xdg) > 0 {
            try out.append_bytes(xdg);
            return out.append_bytes("/kizu");
        }
    }
    if mem::len(home) == 0 {
        return Error::MissingCacheHome;
    }
    try out.append_bytes(home);
    return out.append_bytes("/.cache/kizu");
}

/// Keys an artifact by everything it is made of, the Go `newInput`: the
/// cache format, the target, the name, and the bytes it is built from.
pub fn (self: &Cache) new_input(
    allocator: Allocator,
    name: []u8,
    target: []u8,
    content: []u8
) -> !CacheInput {
    let hasher = &self.hasher;
    var source_hash = string::new(allocator);
    errdefer source_hash.deinit();
    try hasher.append_hex_digest(allocator, content, &var source_hash);
    var message = string::new(allocator);
    defer message.deinit();
    try message.append_bytes(version());
    try message.append_byte(cast<u8>(10));
    try message.append_bytes(target);
    try message.append_byte(cast<u8>(10));
    try message.append_bytes(name);
    try message.append_byte(cast<u8>(10));
    try message.append_string(&source_hash);
    var key = string::new(allocator);
    errdefer key.deinit();
    let message_bytes = message.as_bytes();
    try hasher.append_hex_digest(allocator, message_bytes, &var key);
    let target_copy = try string::from_bytes(allocator, target);
    return CacheInput {
        key: move key,
        target: move target_copy,
        source_hash: move source_hash
    };
}

/// Reads a source file and keys it by where it is and what is in it, the
/// Go `newFileInput`.
pub fn (self: &Cache) new_file_input(
    io: Io,
    allocator: Allocator,
    file: []u8,
    target: []u8
) -> !CacheInput {
    let text = try fs::read_file(io, allocator, file, mem::Limit::Unlimited);
    defer text.deinit();
    var abs = string::new(allocator);
    defer abs.deinit();
    try append_abs_path(allocator, file, &var abs);
    let abs_bytes = abs.as_bytes();
    let content = text.as_bytes();
    return self.new_input(allocator, abs_bytes, target, content);
}

/// Spells the Go `filepath.Abs`: an absolute path cleaned, a relative one
/// joined to the working directory. std::process has no getcwd, so the
/// directory comes from $PWD, which shells and the Go CLI's own child
/// environment keep pointing at the working directory.
fn append_abs_path(allocator: Allocator, file: []u8, out: &var string::String) -> !void {
    if mem::len(file) > 0 and file[0] == cast<u8>(47) {
        let cleaned = try path::clean(allocator, file);
        defer cleaned.deinit();
        let cleaned_bytes = cleaned.as_bytes();
        return out.append_bytes(cleaned_bytes);
    }
    let base = process::env("PWD") orelse "";
    let joined = try path::join(allocator, base, file);
    defer joined.deinit();
    let joined_bytes = joined.as_bytes();
    return out.append_bytes(joined_bytes);
}

/// Answers the first half of the Go `GetOrBuild` for one source file: on a
/// hit the cached text is appended to out_text, on a miss the caller runs
/// its builder and hands the output to `finish_get_or_build`.
pub fn (self: &Cache) get_or_build(
    io: Io,
    allocator: Allocator,
    file: []u8,
    target: []u8,
    out_text: &var string::String
) -> !GetOrBuild {
    let input = try self.new_file_input(io, allocator, file, target);
    errdefer input.deinit();
    let hit = try self.read_hit(io, allocator, &input.key, out_text);
    if hit {
        input.deinit();
        return GetOrBuild::Hit;
    }
    return GetOrBuild::Miss(move input);
}

/// Reads a hit's stored text into out_text and reports whether there was
/// one. The key stays owned by the caller's CacheInput, so no borrow of
/// the input outlives this call and the caller can move it afterwards.
fn (self: &Cache) read_hit(
    io: Io,
    allocator: Allocator,
    key: &string::String,
    out_text: &var string::String
) -> !bool {
    let key_bytes = key.as_bytes();
    if try self.has_artifact(io, allocator, key_bytes) |entry| {
        defer entry.deinit();
        let name_bytes = entry.output.as_bytes();
        let stored = try self.output_path(allocator, name_bytes);
        defer stored.deinit();
        let stored_bytes = stored.as_bytes();
        try fs::read_file_into(io, stored_bytes, out_text);
        return true;
    }
    return false;
}

/// Stores builder output, the second half of the Go `GetOrBuild`:
/// `writeEntry` and then `enforceLimit`.
pub fn (self: &Cache) finish_get_or_build(
    io: Io,
    allocator: Allocator,
    input: CacheInput,
    output: []u8
) -> !void {
    errdefer input.deinit();
    try self.write_entry(io, allocator, &input, output);
    input.deinit();
    return self.enforce_limit(io, allocator);
}

/// Answers the first half of the Go `GetOrBuildArtifact` for one artifact
/// built from content the compiler carries itself: on a hit out_path names
/// the stored artifact, on a miss it names where the artifact will be once
/// the caller builds into the plan's scratch path and finishes.
pub fn (self: &var Cache) get_or_build_artifact(
    io: Io,
    allocator: Allocator,
    name: []u8,
    target: []u8,
    content: []u8,
    out_path: &var string::String
) -> !ArtifactPlan {
    let input = try self.new_input(allocator, name, target, content);
    errdefer input.deinit();
    let stored = try output_name_of(allocator, &input.key);
    errdefer stored.deinit();
    let output = try self.output_path_of(allocator, &stored);
    errdefer output.deinit();
    let hit = try self.artifact_hit(io, allocator, &input.key);
    if hit {
        try out_path.append_string(&output);
        input.deinit();
        stored.deinit();
        output.deinit();
        return ArtifactPlan::Hit;
    }
    let dir_bytes = self.dir.as_bytes();
    try create_dir_all(io, dir_bytes);
    var scratch_name = string::new(allocator);
    defer scratch_name.deinit();
    try append_scratch_name(&input.key, self.scratch_sequence, &var scratch_name);
    self.scratch_sequence = self.scratch_sequence + 1;
    let scratch = try self.output_path_of(allocator, &scratch_name);
    errdefer scratch.deinit();
    try out_path.append_string(&output);
    return ArtifactPlan::Miss(PendingArtifact {
        input: move input,
        scratch: move scratch,
        stored: move stored,
        output: move output
    });
}

/// Names one scratch file. Go's `os.CreateTemp` draws a random name; std
/// has no randomness, so distinctness comes from what differs between
/// concurrent builders: the key being built, the wall clock, and a
/// per-process sequence. Two processes collide only when they build the
/// same key in the same millisecond, and the loser fails loudly.
fn append_scratch_name(key: &string::String, sequence: i64, out: &var string::String) -> !void {
    try out.append_bytes("artifact-");
    let key_bytes = key.as_bytes();
    var head = mem::len(key_bytes);
    if head > 16 {
        head = 16;
    }
    let prefix = key_bytes[0..head];
    try out.append_bytes(prefix);
    try out.append_bytes("-");
    try fmt::append_i64(out, process::unix_millis());
    try out.append_bytes("-");
    return fmt::append_i64(out, sequence);
}

/// Moves what the builder made into place and records it, the tail of the
/// Go `buildArtifact` plus `writeMeta` and `enforceLimit`: the artifact is
/// renamed from the scratch path first, so an entry never promises a file
/// that is not there yet.
pub fn (self: &Cache) finish_artifact(
    io: Io,
    allocator: Allocator,
    pending: PendingArtifact
) -> !void {
    errdefer pending.deinit();
    try self.install_artifact(io, allocator, &pending);
    pending.deinit();
    return self.enforce_limit(io, allocator);
}

/// Stats, renames and records one built artifact.
fn (self: &Cache) install_artifact(
    io: Io,
    allocator: Allocator,
    pending: &PendingArtifact
) -> !void {
    let scratch_bytes = pending.scratch.as_bytes();
    let info = try fs::metadata(io, scratch_bytes);
    let output_bytes = pending.output.as_bytes();
    try fs::rename(io, scratch_bytes, output_bytes);
    let stored_bytes = pending.stored.as_bytes();
    return self.write_meta(io, allocator, &pending.input, stored_bytes, info.size);
}

/// Abandons a miss whose builder failed, the Go `defer os.Remove` of the
/// scratch file: what was half-built is removed, and nothing is recorded.
pub fn (self: &Cache) discard_artifact(io: Io, pending: PendingArtifact) -> !void {
    errdefer pending.deinit();
    try remove_scratch(io, &pending);
    pending.deinit();
    return;
}

/// Removes the scratch file when the builder left one behind.
fn remove_scratch(io: Io, pending: &PendingArtifact) -> !void {
    let scratch_bytes = pending.scratch.as_bytes();
    let found = try fs::exists(io, scratch_bytes);
    if found {
        try fs::remove_file(io, scratch_bytes);
    }
    return;
}

/// Reports whether a key has both the entry that accounts for it and the
/// file that entry names, the Go `hasArtifact`: an entry whose artifact is
/// gone is a miss.
pub fn (self: &Cache) has_artifact(io: Io, allocator: Allocator, key: []u8) -> !?Entry {
    if try self.read_entry(io, allocator, key) |entry| {
        errdefer entry.deinit();
        let name_bytes = entry.output.as_bytes();
        let stored = try self.output_path(allocator, name_bytes);
        defer stored.deinit();
        let stored_bytes = stored.as_bytes();
        let found = try fs::exists(io, stored_bytes);
        if !found {
            entry.deinit();
            return null;
        }
        return move entry;
    }
    return null;
}

/// Reports a hit with the key still owned by a CacheInput, so the caller
/// keeps no borrow of the input alive and can move it afterwards.
fn (self: &Cache) artifact_hit(io: Io, allocator: Allocator, key: &string::String) -> !bool {
    let key_bytes = key.as_bytes();
    if try self.has_artifact(io, allocator, key_bytes) |entry| {
        entry.deinit();
        return true;
    }
    return false;
}

/// Writes metadata and output for one artifact, the Go `writeEntry`.
fn (self: &Cache) write_entry(
    io: Io,
    allocator: Allocator,
    input: &CacheInput,
    output: []u8
) -> !void {
    let dir_bytes = self.dir.as_bytes();
    try create_dir_all(io, dir_bytes);
    let stored = try output_name_of(allocator, &input.key);
    defer stored.deinit();
    let target = try self.output_path_of(allocator, &stored);
    defer target.deinit();
    let target_bytes = target.as_bytes();
    try fs::write_file(io, target_bytes, output);
    let stored_bytes = stored.as_bytes();
    return self.write_meta(io, allocator, input, stored_bytes, mem::len(output));
}

/// Records what one stored artifact is and how much room it takes, the Go
/// `writeMeta`. It is written after the artifact it describes, so an entry
/// never promises a file that is not there yet.
fn (self: &Cache) write_meta(
    io: Io,
    allocator: Allocator,
    input: &CacheInput,
    stored: []u8,
    size: i64
) -> !void {
    var encoder = json::encoder_with_spaces(allocator, 2);
    defer encoder.deinit();
    try encoder.begin_object();
    try write_field(&var encoder, "key", &input.key);
    try write_field(&var encoder, "target", &input.target);
    try write_field(&var encoder, "source_hash", &input.source_hash);
    try encoder.write_bytes_field("version", version());
    try encoder.write_bytes_field("output", stored);
    try encoder.write_i64_field("size_bytes", size);
    var stamp = string::new(allocator);
    defer stamp.deinit();
    try append_created_at(&var stamp, process::unix_millis());
    let stamp_bytes = stamp.as_bytes();
    try encoder.write_bytes_field("created_at", stamp_bytes);
    try encoder.end_object();
    var out = string::new(allocator);
    defer out.deinit();
    try encoder.finish_into(&var out);
    let key_bytes = input.key.as_bytes();
    let meta = try self.meta_path(allocator, key_bytes);
    defer meta.deinit();
    let meta_bytes = meta.as_bytes();
    let text = out.as_bytes();
    try fs::write_file(io, meta_bytes, text);
    return;
}

/// Writes one owned value as an entry field.
fn write_field(encoder: &var json::Encoder, name: []u8, value: &string::String) -> !void {
    let bytes = value.as_bytes();
    return encoder.write_bytes_field(name, bytes);
}

/// Reads one metadata entry, the Go `readEntry`. A missing file is a miss;
/// a file std::json cannot read is an error rather than the Go miss,
/// because a decode failure cannot be caught (recorded gap).
pub fn (self: &Cache) read_entry(io: Io, allocator: Allocator, key: []u8) -> !?Entry {
    let meta = try self.meta_path(allocator, key);
    defer meta.deinit();
    let meta_bytes = meta.as_bytes();
    let found = try fs::exists(io, meta_bytes);
    if !found {
        return null;
    }
    let text = try fs::read_file(io, allocator, meta_bytes, mem::Limit::Unlimited);
    defer text.deinit();
    let data = text.as_bytes();
    let entry = try json::decode_ignore_unknown<Entry>(allocator, data);
    return move entry;
}

/// Reads all metadata entries in name order, the Go `entries` over the
/// sorted `filepath.Glob`.
pub fn (self: &Cache) entries(io: Io, allocator: Allocator, out: &var array::Array<Entry>) -> !void {
    let dir_bytes = self.dir.as_bytes();
    let dir_found = try fs::exists(io, dir_bytes);
    if !dir_found {
        return;
    }
    var names = array::new<string::String>(allocator);
    defer names.deinit();
    var listed = try fs::read_dir(io, dir_bytes);
    defer listed.deinit();
    var index = 0;
    while index < listed.len() {
        let item = listed.get_or_panic(index);
        index = index + 1;
        if item.is_dir {
            continue;
        }
        if has_suffix(item.name, ".json") {
            let owned = try string::from_bytes(allocator, item.name);
            try names.append(move owned);
        }
    }
    try sort::strings(&var names);
    var name_index = 0;
    while names.at(name_index) |name| {
        name_index = name_index + 1;
        try self.append_entry_of(io, allocator, name, out);
    }
    return;
}

/// Reads the entry one metadata file holds and appends it.
fn (self: &Cache) append_entry_of(
    io: Io,
    allocator: Allocator,
    name: &string::String,
    out: &var array::Array<Entry>
) -> !void {
    let name_bytes = name.as_bytes();
    let full = try self.output_path(allocator, name_bytes);
    defer full.deinit();
    let full_bytes = full.as_bytes();
    let text = try fs::read_file(io, allocator, full_bytes, mem::Limit::Unlimited);
    defer text.deinit();
    let data = text.as_bytes();
    let entry = try json::decode_ignore_unknown<Entry>(allocator, data);
    try out.append(move entry);
    return;
}

/// Returns current cache size and entry count, the Go `Status`.
pub fn (self: &Cache) status(io: Io, allocator: Allocator) -> !Status {
    var all = array::new<Entry>(allocator);
    defer all.deinit();
    try self.entries(io, allocator, &var all);
    var size = 0;
    var index = 0;
    while all.at(index) |entry| {
        index = index + 1;
        size = size + entry.size_bytes;
    }
    let count = all.len();
    var dir = string::new(allocator);
    errdefer dir.deinit();
    try dir.append_string(&self.dir);
    return Status {
        dir: move dir,
        max_bytes: self.max_bytes,
        size_bytes: size,
        entries: count
    };
}

/// Removes every cache entry, the Go `Prune`.
pub fn (self: &Cache) prune(io: Io, allocator: Allocator) -> !PruneResult {
    var all = array::new<Entry>(allocator);
    defer all.deinit();
    try self.entries(io, allocator, &var all);
    var bytes = 0;
    var index = 0;
    while all.at(index) |entry| {
        index = index + 1;
        bytes = bytes + entry.size_bytes;
        try self.remove_entry_files(io, allocator, entry);
    }
    let count = all.len();
    return PruneResult { entries: count, bytes: bytes };
}

/// Removes oldest entries until the cache fits max_bytes, the Go
/// `enforceLimit`.
pub fn (self: &Cache) enforce_limit(io: Io, allocator: Allocator) -> !void {
    var all = array::new<Entry>(allocator);
    defer all.deinit();
    try self.entries(io, allocator, &var all);
    let count = all.len();
    var a = 0;
    while a < count {
        var smallest = a;
        var b = a + 1;
        while b < count {
            if entry_before(&all, b, smallest) {
                smallest = b;
            }
            b = b + 1;
        }
        if smallest != a {
            try all.swap(a, smallest);
        }
        a = a + 1;
    }
    var size = 0;
    var index = 0;
    while all.at(index) |entry| {
        index = index + 1;
        size = size + entry.size_bytes;
    }
    index = 0;
    while all.at(index) |entry| {
        index = index + 1;
        if size <= self.max_bytes {
            return;
        }
        size = size - entry.size_bytes;
        try self.remove_entry_files(io, allocator, entry);
    }
    return;
}

/// Removes the metadata and artifact files of one entry when they are
/// there, the Go removes that ignore `os.IsNotExist`.
fn (self: &Cache) remove_entry_files(io: Io, allocator: Allocator, entry: &Entry) -> !void {
    let key_bytes = entry.key.as_bytes();
    let meta = try self.meta_path(allocator, key_bytes);
    defer meta.deinit();
    let meta_bytes = meta.as_bytes();
    let meta_found = try fs::exists(io, meta_bytes);
    if meta_found {
        try fs::remove_file(io, meta_bytes);
    }
    let output_bytes = entry.output.as_bytes();
    let stored = try self.output_path(allocator, output_bytes);
    defer stored.deinit();
    let stored_bytes = stored.as_bytes();
    let stored_found = try fs::exists(io, stored_bytes);
    if stored_found {
        try fs::remove_file(io, stored_bytes);
    }
    return;
}

/// Orders two entries by the moment they were created, the ascending sort
/// key of the Go `enforceLimit`.
fn entry_before(all: &array::Array<Entry>, left: i64, right: i64) -> bool {
    if all.at(left) |a| {
        if all.at(right) |b| {
            let a_bytes = a.created_at.as_bytes();
            let b_bytes = b.created_at.as_bytes();
            return stamp_before(a_bytes, b_bytes);
        }
    }
    return false;
}

/// Orders two RFC3339 UTC stamps. The date and time compare bytewise up to
/// the seconds; the fractions compare digit by digit with missing digits
/// read as zero, because `.5` is later than `.123` while shorter. Both
/// compilers write UTC `Z` stamps, so offsets need no arithmetic here.
fn stamp_before(a: []u8, b: []u8) -> bool {
    if mem::len(a) < 19 or mem::len(b) < 19 {
        return mem::len(a) < mem::len(b);
    }
    var index = 0;
    while index < 19 {
        if a[index] != b[index] {
            return a[index] < b[index];
        }
        index = index + 1;
    }
    // The fraction digits start after the `.` at 19; a stamp with no
    // fraction reads as zeros. Nine digits is all Go ever writes, so a
    // dozen closes every real spelling.
    var digit = 0;
    while digit < 12 {
        let a_value = fraction_digit(a, 20 + digit);
        let b_value = fraction_digit(b, 20 + digit);
        if a_value != b_value {
            return a_value < b_value;
        }
        digit = digit + 1;
    }
    return false;
}

/// Reads one fraction digit, zero once the fraction has ended.
fn fraction_digit(stamp: []u8, at: i64) -> i64 {
    if at >= mem::len(stamp) {
        return 0;
    }
    let byte = stamp[at];
    if byte < cast<u8>(48) or byte > cast<u8>(57) {
        return 0;
    }
    return cast<i64>(byte) - 48;
}

/// Appends the Go `time.Time` JSON spelling of one epoch-milliseconds
/// moment: RFC3339 UTC with the fraction trimmed the way RFC3339Nano
/// trims it. Go writes nanoseconds where this writes milliseconds; both
/// sides read either, and the precision difference is accepted.
fn append_created_at(out: &var string::String, millis: i64) -> !void {
    let days = millis / 86400000;
    let rem = millis % 86400000;
    let z = days + 719468;
    let era = z / 146097;
    let doe = z % 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = doy - (153 * mp + 2) / 5 + 1;
    var month = mp + 3;
    if mp >= 10 {
        month = mp - 9;
    }
    var year = yoe + era * 400;
    if month <= 2 {
        year = year + 1;
    }
    try append_padded(out, year, 1000);
    try out.append_byte(cast<u8>(45));
    try append_padded(out, month, 10);
    try out.append_byte(cast<u8>(45));
    try append_padded(out, day, 10);
    try out.append_byte(cast<u8>(84));
    let hour = rem / 3600000;
    let minute = (rem / 60000) % 60;
    let second = (rem / 1000) % 60;
    let milli = rem % 1000;
    try append_padded(out, hour, 10);
    try out.append_byte(cast<u8>(58));
    try append_padded(out, minute, 10);
    try out.append_byte(cast<u8>(58));
    try append_padded(out, second, 10);
    if milli != 0 {
        try out.append_byte(cast<u8>(46));
        var scale = 100;
        var rest = milli;
        while rest > 0 {
            try out.append_byte(cast<u8>(48 + rest / scale));
            rest = rest % scale;
            scale = scale / 10;
        }
    }
    return out.append_byte(cast<u8>(90));
}

/// Appends value zero-padded to the width the top divisor spells.
fn append_padded(out: &var string::String, value: i64, top: i64) -> !void {
    var divisor = top;
    while divisor > 0 {
        try out.append_byte(cast<u8>(48 + (value / divisor) % 10));
        divisor = divisor / 10;
    }
    return;
}

/// Returns the metadata path for key, the Go `metaPath`.
pub fn (self: &Cache) meta_path(allocator: Allocator, key: []u8) -> !string::String {
    var name = string::new(allocator);
    defer name.deinit();
    try name.append_bytes(key);
    try name.append_bytes(".json");
    let dir_bytes = self.dir.as_bytes();
    let name_bytes = name.as_bytes();
    return path::join(allocator, dir_bytes, name_bytes);
}

/// Returns the file name the artifact for key is stored under, the Go
/// `outputName`.
pub fn output_name(allocator: Allocator, key: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes(key);
    try out.append_bytes(".out");
    return move out;
}

/// Reads `output_name` with the key still owned by a CacheInput.
fn output_name_of(allocator: Allocator, key: &string::String) -> !string::String {
    let key_bytes = key.as_bytes();
    return output_name(allocator, key_bytes);
}

/// Returns the artifact path for name, the Go `outputPath`.
pub fn (self: &Cache) output_path(allocator: Allocator, name: []u8) -> !string::String {
    let dir_bytes = self.dir.as_bytes();
    return path::join(allocator, dir_bytes, name);
}

/// Reads `output_path` with the name still owned by a String.
fn (self: &Cache) output_path_of(allocator: Allocator, name: &string::String) -> !string::String {
    let name_bytes = name.as_bytes();
    return self.output_path(allocator, name_bytes);
}

/// Reports whether text ends with suffix.
fn has_suffix(text: []u8, suffix: []u8) -> bool {
    let text_len = mem::len(text);
    let suffix_len = mem::len(suffix);
    if text_len < suffix_len {
        return false;
    }
    let tail = text[text_len - suffix_len..text_len];
    return mem::equal_bytes(tail, suffix);
}

/// Creates every directory a path names that is not there yet, the Go
/// `os.MkdirAll`: `fs::create_dir` tolerates an existing directory.
fn create_dir_all(io: Io, target: []u8) -> !void {
    var index = 0;
    while index < mem::len(target) {
        if target[index] == cast<u8>(47) and index > 0 {
            let prefix = target[0..index];
            try fs::create_dir(io, prefix);
        }
        index = index + 1;
    }
    if mem::len(target) > 0 {
        try fs::create_dir(io, target);
    }
    return;
}
