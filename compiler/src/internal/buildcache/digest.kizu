import compiler::internal::fsutil;
import compiler::internal::sha256;
import std::fmt;
import std::fs;
import std::mem;
import std::path;
import std::process;
import std::string;

extern "c" fn stat(file: ptr<const u8>, out: ptr<u8>) -> i32
struct FileStamp {
    dev: i64,
    ino: i64,
    mode: i64,
    size: i64,
    mtime_sec: i64,
    mtime_nsec: i64,
    ctime_sec: i64,
    ctime_nsec: i64,
}

fn digest_header() -> []u8 {
    return "kizu-compiler-digest-v1";
}

fn read_u16_le(bytes: []u8, offset: i64) -> i64 {
    let b0 = cast<u64>(bytes[offset]);
    let b1 = cast<u64>(bytes[offset + 1]);
    return cast<i64>(b0 | (b1 << cast<u64>(8)));
}

fn read_u32_le(bytes: []u8, offset: i64) -> i64 {
    let b0 = cast<u64>(bytes[offset]);
    let b1 = cast<u64>(bytes[offset + 1]);
    let b2 = cast<u64>(bytes[offset + 2]);
    let b3 = cast<u64>(bytes[offset + 3]);
    let value = b0 | (b1 << cast<u64>(8)) | (b2 << cast<u64>(16)) | (b3 << cast<u64>(24));
    return cast<i64>(value);
}

fn read_i64_le(bytes: []u8, offset: i64) -> i64 {
    var value = cast<u64>(0);
    for 0..8 |index| {
        let part = cast<u64>(bytes[offset + index]);
        value = value | (part << cast<u64>(index * 8));
    }
    return cast<i64>(value);
}

fn has_nul(bytes: []u8) -> bool {
    for 0..mem::len(bytes) |index| {
        if bytes[index] == cast<u8>(0) {
            return true;
        }
    }
    return false;
}

fn stamp_file(io: Io, allocator: Allocator, file: []u8) -> !?FileStamp {
    comptime if !std::target::is_darwin() and !std::target::is_linux() {
        return null;
    }
    if mem::len(file) == 0 or has_nul(file) {
        return null;
    }
    let info = fs::metadata(io, file) catch return null;
    if info.is_dir or info.size <= 0 {
        return null;
    }
    var cpath = try string::from_bytes(allocator, file);
    defer cpath.deinit(allocator);
    try cpath.append_byte(allocator, cast<u8>(0));
    let cpath_bytes = cpath.as_bytes();
    var raw = [256]u8{};
    let raw_mut = raw.as_mut_bytes();
    let code = unsafe stat(ptr_of(cpath_bytes), mut_ptr_of(raw_mut));
    if code != cast<i32>(0) {
        return null;
    }
    let bytes = raw.as_bytes();
    comptime if std::target::is_darwin() {
        let dev = read_u32_le(bytes, 0);
        let mode = read_u16_le(bytes, 4);
        let ino = read_i64_le(bytes, 8);
        let mtime_sec = read_i64_le(bytes, 48);
        let mtime_nsec = read_i64_le(bytes, 56);
        let ctime_sec = read_i64_le(bytes, 64);
        let ctime_nsec = read_i64_le(bytes, 72);
        let size = read_i64_le(bytes, 96);
        if size != info.size or ino == 0 or (mode & 61440) != 32768 {
            return null;
        }
        if mtime_nsec < 0 or mtime_nsec >= 1000000000 or ctime_nsec < 0 or ctime_nsec >= 1000000000 {
            return null;
        }
        return FileStamp {
            dev: dev,
            ino: ino,
            mode: mode,
            size: size,
            mtime_sec: mtime_sec,
            mtime_nsec: mtime_nsec,
            ctime_sec: ctime_sec,
            ctime_nsec: ctime_nsec
        };
    }
    comptime if std::target::is_linux() {
        let dev = read_i64_le(bytes, 0);
        let ino = read_i64_le(bytes, 8);
        let mode_arm = read_u32_le(bytes, 16);
        let mode_x86 = read_u32_le(bytes, 24);
        let size = read_i64_le(bytes, 48);
        let mtime_sec = read_i64_le(bytes, 88);
        let mtime_nsec = read_i64_le(bytes, 96);
        let ctime_sec = read_i64_le(bytes, 104);
        let ctime_nsec = read_i64_le(bytes, 112);
        let is_reg = (mode_x86 & 61440) == 32768 or (mode_arm & 61440) == 32768;
        if size != info.size or ino == 0 or !is_reg {
            return null;
        }
        if mtime_nsec < 0 or mtime_nsec >= 1000000000 or ctime_nsec < 0 or ctime_nsec >= 1000000000 {
            return null;
        }
        return FileStamp {
            dev: dev,
            ino: ino,
            mode: 0,
            size: size,
            mtime_sec: mtime_sec,
            mtime_nsec: mtime_nsec,
            ctime_sec: ctime_sec,
            ctime_nsec: ctime_nsec
        };
    }
    return null;
}

fn stamps_equal(left: FileStamp, right: FileStamp) -> bool {
    return left.dev == right.dev and left.ino == right.ino and left.mode == right.mode and
        left.size == right.size and left.mtime_sec == right.mtime_sec and
        left.mtime_nsec == right.mtime_nsec and left.ctime_sec == right.ctime_sec and
        left.ctime_nsec == right.ctime_nsec;
}

fn stamp_settled(stamp: FileStamp, now_ms: i64) -> bool {
    if stamp.mtime_sec < 0 or stamp.ctime_sec < 0 or stamp.mtime_sec > 9000000000000 or
        stamp.ctime_sec > 9000000000000 {
        return false;
    }
    let mtime_ms = stamp.mtime_sec * 1000 + stamp.mtime_nsec / 1000000;
    let ctime_ms = stamp.ctime_sec * 1000 + stamp.ctime_nsec / 1000000;
    var latest_ms = mtime_ms;
    if ctime_ms > latest_ms {
        latest_ms = ctime_ms;
    }
    if now_ms >= latest_ms and now_ms - latest_ms < 50 {
        return false;
    }
    return true;
}

fn append_stamp_meta(
    allocator: Allocator,
    stamp: FileStamp,
    resolved_path: []u8,
    out: &var string::String
) -> !void {
    try fmt::append_i64(allocator, out, stamp.dev);
    try out.append_byte(allocator, cast<u8>(32));
    try fmt::append_i64(allocator, out, stamp.ino);
    try out.append_byte(allocator, cast<u8>(32));
    try fmt::append_i64(allocator, out, stamp.mode);
    try out.append_byte(allocator, cast<u8>(32));
    try fmt::append_i64(allocator, out, stamp.size);
    try out.append_byte(allocator, cast<u8>(32));
    try fmt::append_i64(allocator, out, stamp.mtime_sec);
    try out.append_byte(allocator, cast<u8>(32));
    try fmt::append_i64(allocator, out, stamp.mtime_nsec);
    try out.append_byte(allocator, cast<u8>(32));
    try fmt::append_i64(allocator, out, stamp.ctime_sec);
    try out.append_byte(allocator, cast<u8>(32));
    try fmt::append_i64(allocator, out, stamp.ctime_nsec);
    try out.append_byte(allocator, cast<u8>(10));
    try fmt::append_i64(allocator, out, mem::len(resolved_path));
    try out.append_byte(allocator, cast<u8>(10));
    return out.append_bytes(allocator, resolved_path);
}

fn digest_sidecar_key(allocator: Allocator, resolved_path: []u8, out: &var string::String) -> !void {
    var full = string::new(allocator);
    defer full.deinit(allocator);
    try sha256::append_hex_digest(allocator, resolved_path, &var full);
    let full_bytes = full.as_bytes();
    return out.append_bytes(allocator, full_bytes[0..16]);
}

fn digest_sidecar_path(
    allocator: Allocator,
    cache_dir: []u8,
    key: []u8
) -> !string::String {
    var name = try string::from_bytes(allocator, "compiler-digest-");
    defer name.deinit(allocator);
    try name.append_bytes(allocator, key);
    try name.append_bytes(allocator, ".v1");
    let name_bytes = name.as_bytes();
    return path::join(allocator, cache_dir, name_bytes);
}

fn is_lower_hex_64(bytes: []u8) -> bool {
    if mem::len(bytes) != 64 {
        return false;
    }
    for 0..64 |index| {
        let ch = bytes[index];
        let digit = ch >= cast<u8>(48) and ch <= cast<u8>(57);
        let letter = ch >= cast<u8>(97) and ch <= cast<u8>(102);
        if !digit and !letter {
            return false;
        }
    }
    return true;
}

fn read_cached_digest(
    io: Io,
    allocator: Allocator,
    sidecar_path: []u8,
    expected_meta: []u8,
    out: &var string::String
) -> !bool {
    let text = fs::read_file(io, allocator, sidecar_path, mem::Limit::Bytes(65536)) catch return false;
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    let header = digest_header();
    let header_len = mem::len(header);
    let digest_start = header_len + 1;
    let digest_end = digest_start + 64;
    let meta_start = digest_end + 1;
    let total_len = meta_start + mem::len(expected_meta);
    if mem::len(bytes) != total_len {
        return false;
    }
    if !mem::equal_bytes(bytes[0..header_len], header) {
        return false;
    }
    if bytes[header_len] != cast<u8>(10) or bytes[digest_end] != cast<u8>(10) {
        return false;
    }
    let digest = bytes[digest_start..digest_end];
    if !is_lower_hex_64(digest) {
        return false;
    }
    if !mem::equal_bytes(bytes[meta_start..total_len], expected_meta) {
        return false;
    }
    try out.append_bytes(allocator, digest);
    return true;
}

fn ensure_dir_best_effort(io: Io, target: []u8) -> bool {
    var index = 0;
    while index < mem::len(target) {
        if target[index] == cast<u8>(47) and index > 0 {
            let prefix = target[0..index];
            if fs::create_dir(io, prefix) {} else |_| {
                return false;
            }
        }
        index = index + 1;
    }
    if mem::len(target) > 0 {
        if fs::create_dir(io, target) {} else |_| {
            return false;
        }
    }
    return true;
}

pub fn append_cache_dir_best_effort(io: Io, allocator: Allocator, out: &var string::String) -> !void {
    if process::env("KIZU_CACHE_DIR") |given| {
        if mem::len(given) > 0 {
            return out.append_bytes(allocator, given);
        }
    }
    comptime if std::target::is_windows() {
        let local = process::env("LocalAppData") orelse "";
        if mem::len(local) == 0 {
            return;
        }
        try out.append_bytes(allocator, local);
        return out.append_bytes(allocator, "/kizu");
    }
    let home = process::env("HOME") orelse "";
    if mem::len(home) > 0 {
        let mac_base = try path::join(allocator, home, "Library/Caches");
        defer mac_base.deinit(allocator);
        let mac_bytes = mac_base.as_bytes();
        let mac = fs::exists(io, mac_bytes) catch false;
        if mac {
            try out.append_bytes(allocator, mac_bytes);
            return out.append_bytes(allocator, "/kizu");
        }
    }
    if process::env("XDG_CACHE_HOME") |xdg| {
        if mem::len(xdg) > 0 {
            try out.append_bytes(allocator, xdg);
            return out.append_bytes(allocator, "/kizu");
        }
    }
    if mem::len(home) == 0 {
        return;
    }
    try out.append_bytes(allocator, home);
    return out.append_bytes(allocator, "/.cache/kizu");
}

fn write_cached_digest(
    io: Io,
    allocator: Allocator,
    cache_dir: []u8,
    key: []u8,
    sidecar_path: []u8,
    digest: []u8,
    meta: []u8
) -> !void {
    if !ensure_dir_best_effort(io, cache_dir) {
        return;
    }
    var payload = try string::from_bytes(allocator, digest_header());
    defer payload.deinit(allocator);
    try payload.append_byte(allocator, cast<u8>(10));
    try payload.append_bytes(allocator, digest);
    try payload.append_byte(allocator, cast<u8>(10));
    try payload.append_bytes(allocator, meta);
    var scratch_name = try string::from_bytes(allocator, ".compiler-digest-");
    defer scratch_name.deinit(allocator);
    try scratch_name.append_bytes(allocator, key);
    try scratch_name.append_byte(allocator, cast<u8>(45));
    try fmt::append_i64(allocator, &var scratch_name, fsutil::current_pid());
    try scratch_name.append_byte(allocator, cast<u8>(45));
    try fmt::append_i64(allocator, &var scratch_name, process::monotonic_millis());
    try scratch_name.append_bytes(allocator, ".tmp");
    let scratch_name_bytes = scratch_name.as_bytes();
    let scratch_path = try path::join(allocator, cache_dir, scratch_name_bytes);
    defer scratch_path.deinit(allocator);
    let scratch_bytes = scratch_path.as_bytes();
    let payload_bytes = payload.as_bytes();
    if fs::write_file(io, scratch_bytes, payload_bytes) {} else |_| {
        return;
    }
    if fs::rename(io, scratch_bytes, sidecar_path) {} else |_| {
        if fs::remove_file(io, scratch_bytes) {} else |_| {}
    }
    return;
}

fn direct_file_digest(
    io: Io,
    allocator: Allocator,
    file_path: []u8,
    out: &var string::String
) -> !bool {
    let bytes = fs::read_file(io, allocator, file_path, mem::Limit::Unlimited) catch return false;
    defer bytes.deinit(allocator);
    let data = bytes.as_bytes();
    try sha256::append_hex_digest(allocator, data, out);
    return true;
}

pub fn cached_file_digest(
    io: Io,
    allocator: Allocator,
    cache_dir: []u8,
    file_path: []u8,
    out: &var string::String
) -> !bool {
    return cached_file_digest_at(io, allocator, cache_dir, file_path, process::unix_millis(), out);
}

pub fn cached_file_digest_at(
    io: Io,
    allocator: Allocator,
    cache_dir: []u8,
    file_path: []u8,
    now_ms: i64,
    out: &var string::String
) -> !bool {
    if mem::len(cache_dir) == 0 {
        return direct_file_digest(io, allocator, file_path, out);
    }
    let resolved = fs::real_path(io, allocator, file_path) catch
        return direct_file_digest(io, allocator, file_path, out);
    defer resolved.deinit(allocator);
    let resolved_bytes = resolved.as_bytes();
    if try stamp_file(io, allocator, resolved_bytes) |before| {
        let settled = stamp_settled(before, now_ms);
        var key = string::new(allocator);
        defer key.deinit(allocator);
        try digest_sidecar_key(allocator, resolved_bytes, &var key);
        let key_bytes = key.as_bytes();
        let sidecar = try digest_sidecar_path(allocator, cache_dir, key_bytes);
        defer sidecar.deinit(allocator);
        let sidecar_bytes = sidecar.as_bytes();
        var meta = string::new(allocator);
        defer meta.deinit(allocator);
        try append_stamp_meta(allocator, before, resolved_bytes, &var meta);
        let meta_bytes = meta.as_bytes();
        if settled and try read_cached_digest(io, allocator, sidecar_bytes, meta_bytes, out) {
            return true;
        }
        var computed = string::new(allocator);
        defer computed.deinit(allocator);
        if !try direct_file_digest(io, allocator, resolved_bytes, &var computed) {
            return false;
        }
        let computed_bytes = computed.as_bytes();
        if settled {
            if try stamp_file(io, allocator, resolved_bytes) |after| {
                if stamps_equal(before, after) {
                    try write_cached_digest(
                        io,
                        allocator,
                        cache_dir,
                        key_bytes,
                        sidecar_bytes,
                        computed_bytes,
                        meta_bytes
                    );
                }
            }
        }
        try out.append_bytes(allocator, computed_bytes);
        return true;
    }
    return direct_file_digest(io, allocator, resolved_bytes, out);
}

fn is_digest_sidecar_name(name: []u8) -> bool {
    return mem::starts_with(name, "compiler-digest-") and fsutil::has_suffix(name, ".v1");
}

fn remove_digest_sidecars(io: Io, allocator: Allocator, dir: []u8) -> !void {
    let found = try fs::exists(io, dir);
    if !found {
        return;
    }
    var listed = try fs::read_dir(io, allocator, dir);
    defer listed.deinit(allocator);
    var index = 0;
    while listed.at(index) |item| {
        index = index + 1;
        if item.is_dir {
            continue;
        }
        let name = item.name.as_bytes();
        if is_digest_sidecar_name(name) {
            let full = item.path.as_bytes();
            try remove_if_present(io, full);
        }
    }
    return;
}
