import compiler::internal::source;
import compiler::internal::stdmeta;
import compiler::internal::typ;
import std::arena;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// Mechanical port of internal/ast's declaration, statement, and expression
// representation. Ast owns every node for one parsed program; Declaration,
// Expression, and Statement are copy handles whose types keep the three closed
// node categories distinct.

/// Identifies immutable text retained by an Ast.
pub struct Text {
    pub node: arena::Handle<string::String>
}

/// Identifies one immutable expression list retained by an Ast.
pub struct ExpressionList {
    pub node: arena::Handle<array::Array<Expression>>
}

/// Owns the syntax and parsed type graphs for one compiler phase.
pub struct Ast {
    allocator: Allocator,
    pub types: typ::Table,
    pub texts: arena::Arena<string::String>,
    pub expression_lists: arena::Arena<array::Array<Expression>>,
    pub declarations: arena::Arena<DeclarationNode>,
    pub expressions: arena::Arena<ExpressionNode>,
    pub statements: arena::Arena<StatementNode>
}

/// Is the root of one parsed Kizu source file.
pub struct Program {
    pub declarations: array::Array<Declaration>
}

/// Identifies one declaration retained by an Ast.
pub struct Declaration {
    pub node: arena::Handle<DeclarationNode>
}

/// Identifies one expression retained by an Ast.
pub struct Expression {
    pub node: arena::Handle<ExpressionNode>
}

/// Identifies one statement retained by an Ast.
pub struct Statement {
    pub node: arena::Handle<StatementNode>
}

/// Identifies one block retained by an Ast.
pub struct Block {
    pub node: arena::Handle<StatementNode>
}

/// Identifies a one-based source position.
pub struct Position {
    pub line: i64,
    pub column: i64
}

/// Identifies a half-open source range.
pub struct Span {
    pub source: ?source::SourceId,
    pub start: Position,
    pub end: Position
}

/// Is one node that may appear as a top-level declaration.
pub union DeclarationNode {
    Import(ImportDecl),
    Function(FunctionDecl),
    Test(TestDecl),
    Struct(StructDecl),
    Enum(EnumDecl),
    ErrorSet(ErrorSetDecl),
    Union(UnionDecl),
    Contract(ContractDecl),
    Impl(ImplDecl),
    Recovered(RecoveredNode),
}

/// Stands in for a node the parser could not finish. The parse that produced
/// one also produced a diagnostic, and nothing consumes a program that has
/// diagnostics, so the node carries only the span where parsing gave up.
pub struct RecoveredNode {
    pub span: Span
}

/// Represents one explicit top-level module import.
pub struct ImportDecl {
    pub path: array::Array<Text>
}

/// Is the declaration information visible to a function caller.
pub struct FunctionSignature {
    pub receiver: bool,
    pub name: Text,
    pub static_params: array::Array<StaticParam>,
    pub params: array::Array<Param>,
    pub return_type: ?typ::Type,
    pub requires_unsafe: bool,
    pub extern_abi: Text,
    pub export_abi: Text,
    pub public: bool,
    pub std: bool,
    /// span points at the declaration name, so a diagnostic about the
    /// signature can say where it was written.
    pub span: Span
}

/// Represents a function declaration and its optional body.
pub struct FunctionDecl {
    pub signature: FunctionSignature,
    pub doc: Text,
    pub derived: bool,
    pub body: ?Block
}

/// Is one entry of a static argument declaration list.
pub struct StaticParam {
    pub name: Text,
    pub type_name: ?typ::Type
}

/// Represents a top-level test block.
pub struct TestDecl {
    pub name: Text,
    pub body: ?Block,
    /// The package module the block was written in, empty for a loose file. A
    /// test body resolves the module's own names the way a function in it
    /// does, and a synthetic name with no module cannot.
    pub module: Text
}

/// Represents a top-level struct declaration.
pub struct StructDecl {
    pub name: Text,
    pub doc: Text,
    pub type_params: array::Array<Text>,
    pub fields: array::Array<Field>,
    pub public: bool,
    pub span: Span,
    pub requires_unsafe: bool
}

/// Represents a top-level tag enum declaration.
pub struct EnumDecl {
    pub name: Text,
    pub doc: Text,
    pub tags: array::Array<Text>,
    pub tag_docs: ?map::Map<[]u8, Text>,
    pub public: bool
}

/// Represents a top-level error set declaration. The `error C = A or B;`
/// form lists the declared sets it combines and declares no members of its
/// own; the `{ }` form leaves combines empty (ADR-0127).
pub struct ErrorSetDecl {
    pub name: Text,
    pub doc: Text,
    pub members: array::Array<Text>,
    pub member_docs: ?map::Map<[]u8, Text>,
    pub public: bool,
    pub combines: array::Array<Text>
}

/// Represents a top-level tagged union declaration.
pub struct UnionDecl {
    pub name: Text,
    pub doc: Text,
    pub type_params: array::Array<Text>,
    pub variants: array::Array<UnionVariant>,
    pub public: bool
}

/// Represents one tagged union variant.
pub struct UnionVariant {
    pub name: Text,
    pub doc: Text,
    pub payload: ?typ::Type
}

/// Represents required method signatures.
pub struct ContractDecl {
    pub name: Text,
    pub methods: array::Array<FunctionDecl>,
    pub public: bool
}

/// Asserts that one concrete type satisfies one contract.
pub struct ImplDecl {
    pub contract_name: Text,
    pub type_name: Text
}

/// Represents a named struct field.
pub struct Field {
    pub name: Text,
    pub doc: Text,
    pub type_name: typ::Type,
    pub borrow: bool,
    pub mut_borrow: bool,
    pub public: bool
}

/// Represents one function parameter.
pub struct Param {
    pub name: Text,
    pub type_name: typ::Type,
    pub borrow: bool,
    pub mut_borrow: bool
}

/// Is one enum tag or union variant exposed to compile-time reflection.
pub struct MetaVariant {
    pub name: Text,
    pub has_payload: bool,
    /// The error set that declares a member of an error set, empty for an
    /// enum tag or a union variant. A member keeps the set that declared it
    /// (SPEC §11.2), so the arm names that set the way a written arm would.
    pub origin: Text
}

/// Is one public field filled by a compile-time construct expansion.
pub struct ConstructField {
    pub name: []u8,
    pub type_name: []u8
}

/// Owns the generated statement list and its retained result expression.
pub struct ConstructResult {
    pub statements: array::Array<Statement>,
    pub literal: Expression
}

struct ConstructBuilt {
    statement: Statement,
    cleanup: ?Statement,
    field: FieldValue
}

// DerivedNames retains the closed vocabulary shared by one generated deinit.
struct DerivedNames {
    receiver: Text,
    capture: Text,
    // The error member the `else |err|` of an `E!T` field's open binds. The
    // body has nothing to do with it: the field held no value.
    err: Text,
    cleanup: Text,
    allocator: Text,
    empty: Text,
    empty_args: ExpressionList,
    // The one argument every derived release carries: the allocator the body
    // was handed, which is what made the fields it consumes (ADR-0132).
    allocator_args: ExpressionList
}

enum DerivedMemberKind {
    Copy,
    Owner,
    OptionalOwner,
    ErrorUnionOwner,
}

/// Is one node that may appear as a statement.
pub union StatementNode {
    Block(BlockStmt),
    Let(LetStmt),
    Assign(AssignStmt),
    Return(ReturnStmt),
    Defer(DeferStmt),
    ErrDefer(ErrDeferStmt),
    If(IfStmt),
    While(WhileStmt),
    For(ForStmt),
    Break(BreakStmt),
    Continue(ContinueStmt),
    Match(MatchStmt),
    ComptimeIf(ComptimeIfStmt),
    ComptimeFor(ComptimeForStmt),
    ComptimeMatch(ComptimeMatchStmt),
    Expr(ExprStmt),
    Recovered(RecoveredNode),
}

/// Is one node that may produce a value.
pub union ExpressionNode {
    Ident(IdentExpr),
    Int(IntExpr),
    Float(FloatExpr),
    String(StringExpr),
    Null(NullExpr),
    OrelseGuard(OrelseGuardExpr),
    CatchGuard(CatchGuardExpr),
    Bool(BoolExpr),
    Type(TypeExpr),
    Comptime(ComptimeExpr),
    Prefix(PrefixExpr),
    Binary(BinaryExpr),
    Call(CallExpr),
    TypeApply(TypeApplyExpr),
    Cast(CastExpr),
    Try(TryExpr),
    Move(MoveExpr),
    Unsafe(UnsafeExpr),
    Index(IndexExpr),
    StructLiteral(StructLiteralExpr),
    BufferLiteral(BufferLiteralExpr),
    Field(FieldExpr),
    Deref(DerefExpr),
    If(IfStmt),
    Match(MatchStmt),
    Recovered(RecoveredNode),
}

/// Represents a sequence of statements.
pub struct BlockStmt {
    pub statements: array::Array<Statement>
}

/// Represents a let or var declaration.
pub struct LetStmt {
    pub mutable: bool,
    pub name: Text,
    pub value: Expression
}

/// Represents assignment to an existing binding.
pub struct AssignStmt {
    pub target: Expression,
    pub value: Expression
}

/// Represents an explicit return statement.
pub struct ReturnStmt {
    pub value: ?Expression
}

/// Registers one cleanup expression for the current lexical block.
pub struct DeferStmt {
    pub expr: Expression
}

/// Registers a cleanup expression for an error-return path.
pub struct ErrDeferStmt {
    pub expr: Expression
}

/// Represents a conditional branch or conditional expression. err_capture
/// names the error member an `else |err|` block binds when the condition is
/// an error union; it is empty otherwise (SPEC §11.1).
pub struct IfStmt {
    pub condition: Expression,
    pub consequence: Block,
    pub alternative: ?Block,
    pub capture: Text,
    pub err_capture: Text
}

/// Represents a loop guarded by a condition expression.
pub struct WhileStmt {
    pub label: Text,
    pub condition: Expression,
    pub body: Block,
    pub capture: Text
}

/// Represents a bounded integer range loop.
pub struct ForStmt {
    pub label: Text,
    pub name: Text,
    pub start: Expression,
    pub end: Expression,
    pub body: Block
}

/// Exits the nearest loop or a named enclosing loop.
pub struct BreakStmt {
    pub label: Text
}

/// Skips to the next iteration of the nearest or named loop.
pub struct ContinueStmt {
    pub label: Text
}

/// Represents an enum or union tag match.
pub struct MatchStmt {
    pub value: Expression,
    pub arms: array::Array<MatchArm>,
    pub meta_capture: Text,
    pub meta_owner: Text
}

/// Represents one tag branch in a match. tag_set qualifies tag with the
/// error set that declared it (`FsError::NotFound => ...`); it is empty for
/// bare arms and for enum or union tags (SPEC §11.2).
pub struct MatchArm {
    pub tag: Text,
    pub binding: Text,
    pub body: Statement,
    pub tag_set: Text
}

/// Represents a branch selected during compilation.
pub struct ComptimeIfStmt {
    pub condition: Expression,
    pub consequence: Block,
    pub alternative: ?Block
}

/// Repeats a body for every element of a compile-time list.
pub struct ComptimeForStmt {
    pub list: Expression,
    pub name: Text,
    pub body: Block
}

/// Repeats a body for every variant of a compile-time value.
pub struct ComptimeMatchStmt {
    pub value: Expression,
    pub name: Text,
    pub binding: Text,
    pub body: Block
}

/// Wraps an expression used as a statement.
pub struct ExprStmt {
    pub expr: Expression,
    pub semicolon: bool
}

/// Represents a name reference.
pub struct IdentExpr {
    pub name: Text,
    pub span: Span
}

/// Represents an integer literal.
pub struct IntExpr {
    pub value: Text
}

/// Represents a floating-point literal. The value is the spelling with
/// separators removed and the exponent marker lowercased, as `1.5e3`.
pub struct FloatExpr {
    pub value: Text
}

/// Represents a string literal.
pub struct StringExpr {
    pub value: Text
}

/// Is the null literal of an optional type.
pub struct NullExpr {
    pub span: Span
}

/// Is `cond orelse return/break/continue`.
pub struct OrelseGuardExpr {
    pub condition: Expression,
    pub exit: Statement,
    pub span: Span
}

/// Is `cond catch return/break/continue`: on failure the guard leaves the
/// enclosing function or loop, so the expression itself always yields the
/// success payload. The default form (`cond catch expr`) is a BinaryExpr.
pub struct CatchGuardExpr {
    pub condition: Expression,
    pub exit: Statement,
    pub span: Span
}

/// Represents a boolean literal.
pub struct BoolExpr {
    pub value: bool
}

/// Represents a compile-time type value.
pub struct TypeExpr {
    pub type_name: Text
}

/// Represents an expression evaluated during compilation.
pub struct ComptimeExpr {
    pub expr: Expression
}

/// Represents a unary operator expression.
pub struct PrefixExpr {
    pub operator: Text,
    pub right: Expression
}

/// Represents an infix binary operator expression.
pub struct BinaryExpr {
    pub left: Expression,
    pub operator: Text,
    pub operator_span: Span,
    pub right: Expression
}

/// Represents a function call.
pub struct CallExpr {
    pub callee: Expression,
    pub args: ExpressionList
}

/// Represents a call target with explicit static arguments.
pub struct TypeApplyExpr {
    pub callee: Expression,
    pub type_arg: Text
}

/// Represents an explicit cast<T>(value) conversion.
pub struct CastExpr {
    pub target_type: typ::Type,
    pub value: Expression,
    pub keyword_span: Span
}

/// Unwraps a !T value or returns the error from the current function.
pub struct TryExpr {
    pub value: Expression
}

/// Marks the place an owner is handed off from.
pub struct MoveExpr {
    pub value: Expression,
    pub span: Span
}

/// Marks an expression whose memory safety the compiler does not prove.
pub struct UnsafeExpr {
    pub value: Expression,
    pub safety: Text,
    pub span: Span
}

/// Represents checked byte indexing or one-dimensional slicing.
pub struct IndexExpr {
    pub target: Expression,
    pub index: ?Expression,
    pub start: ?Expression,
    pub end: ?Expression,
    pub slice: bool,
    pub span: Span
}

/// Represents construction of a struct value.
pub struct StructLiteralExpr {
    pub type_name: Text,
    pub fields: array::Array<FieldValue>,
    pub span: Span
}

/// Is a zero-filled fixed-length byte buffer literal.
pub struct BufferLiteralExpr {
    pub size: i64,
    pub span: Span
}

/// Represents one field initializer in a struct literal.
pub struct FieldValue {
    pub name: Text,
    pub value: Expression
}

/// Represents field access on a receiver expression.
pub struct FieldExpr {
    pub receiver: Expression,
    pub name: Text,
    pub namespace: bool,
    pub span: Span
}

/// Holds the root identifier and dotted suffix of one runtime field path.
pub struct FieldPath {
    pub root: IdentExpr,
    pub path: string::String
}

/// Represents explicit postfix dereference.
pub struct DerefExpr {
    pub receiver: Expression,
    pub operator_span: Span
}

/// Creates empty storage for one parsed AST.
pub fn new(allocator: Allocator) -> Ast {
    return Ast {
        allocator: allocator,
        types: typ::new(allocator),
        texts: arena::new<string::String>(allocator),
        expression_lists: arena::new<array::Array<Expression>>(allocator),
        declarations: arena::new<DeclarationNode>(allocator),
        expressions: arena::new<ExpressionNode>(allocator),
        statements: arena::new<StatementNode>(allocator)
    };
}

/// Creates an empty root declaration list.
pub fn new_program(allocator: Allocator) -> Program {
    return Program {
        declarations: array::new<Declaration>(allocator)
    };
}

/// Retains owned text and returns its copyable identity.
fn (self: &var Ast) add_text(value: string::String) -> !Text {
    return Text { node: try self.texts.add(self.allocator, move value) };
}

/// Retains an empty text value without a fallible byte copy.
fn (self: &var Ast) add_empty_text() -> !Text {
    return try self.add_text(string::new(self.allocator));
}

/// Copies borrowed bytes into text retained for the Ast lifetime.
fn (self: &var Ast) add_text_from_bytes(
    bytes: []u8
) -> !Text {
    let value = try string::from_bytes(self.allocator, bytes);
    return try self.add_text(move value);
}

/// Retains one immutable expression handle list for shared call sites.
fn (self: &var Ast) add_expression_list(
    values: array::Array<Expression>
) -> !ExpressionList {
    return ExpressionList {
        node: try self.expression_lists.add(self.allocator, move values)
    };
}

pub fn (self: ExpressionList) len(ast: &Ast) -> i64 {
    return expression_list_len(ast.expression_lists.at(self.node));
}

pub fn (self: ExpressionList) get_or_panic(ast: &Ast, index: i64) -> Expression {
    return expression_list_get_or_panic(
        ast.expression_lists.at(self.node),
        index
    );
}

fn expression_list_len(values: &array::Array<Expression>) -> i64 {
    return values.len();
}

fn expression_list_get_or_panic(
    values: &array::Array<Expression>,
    index: i64
) -> Expression {
    return values.get_or_panic(index);
}

/// Retains one declaration node and returns its typed handle.
fn (self: &var Ast) add_declaration(node: DeclarationNode) -> !Declaration {
    return Declaration {
        node: try self.declarations.add(self.allocator, move node)
    };
}

/// Appends one retained declaration to the source-file root.
fn (self: &var Program) add_declaration(
    allocator: Allocator,
    declaration: Declaration
) -> !void {
    return self.declarations.append(allocator, declaration);
}

/// Retains one expression node and returns its typed handle.
fn (self: &var Ast) add_expression(node: ExpressionNode) -> !Expression {
    return Expression {
        node: try self.expressions.add(self.allocator, move node)
    };
}

/// Retains one statement node and returns its typed handle.
fn (self: &var Ast) add_statement(node: StatementNode) -> !Statement {
    return Statement {
        node: try self.statements.add(self.allocator, move node)
    };
}

/// Retains one block and returns its typed handle.
fn (self: &var Ast) add_block(block: BlockStmt) -> !Block {
    return Block {
        node: try self.statements.add(self.allocator, StatementNode::Block(move block))
    };
}

/// Retains the recovery declaration for a parse that gave up at `span`.
fn (self: &var Ast) add_recovered_declaration(span: Span) -> !Declaration {
    return try self.add_declaration(DeclarationNode::Recovered(RecoveredNode {
        span: span
    }));
}

/// Retains the recovery statement for a parse that gave up at `span`.
fn (self: &var Ast) add_recovered_statement(span: Span) -> !Statement {
    return try self.add_statement(StatementNode::Recovered(RecoveredNode {
        span: span
    }));
}

/// Retains the recovery expression for a parse that gave up at `span`.
fn (self: &var Ast) add_recovered_expression(span: Span) -> !Expression {
    return try self.add_expression(ExpressionNode::Recovered(RecoveredNode {
        span: span
    }));
}

/// Retains an empty block using the syntax graph's allocator.
fn (self: &var Ast) add_empty_block() -> !Block {
    return try self.add_block(BlockStmt {
        statements: array::new<Statement>(self.allocator)
    });
}

/// Views a retained block as the statement node with the same identity.
fn (self: Block) as_statement() -> Statement {
    return Statement { node: self.node };
}

/// Reports whether a span has no source position.
fn (self: Span) is_zero() -> bool {
    return self.start.line == 0 or self.start.column == 0;
}

pub fn zero_span() -> Span {
    return Span {
        source: null,
        start: Position { line: 0, column: 0 },
        end: Position { line: 0, column: 0 }
    };
}

/// Reports whether this entry declares a type parameter.
fn (self: &StaticParam) is_type() -> bool {
    if self.type_name |_| {
        return false;
    } else {
        return true;
    }
}

/// Returns the names of static entries that declare types.
fn (self: &FunctionSignature) type_param_names(
    allocator: Allocator
) -> !array::Array<Text> {
    var names = array::new<Text>(allocator);
    errdefer names.deinit(allocator);
    var index = 0;
    while self.static_params.at(index) |param| {
        if param.is_type() {
            try names.append(allocator, param.name);
        }
        index = index + 1;
    }
    return move names;
}

/// Reports whether this arm is the fallback match branch.
pub fn (self: &MatchArm) is_wildcard(ast: &Ast) -> bool {
    let retained = ast.texts.at(self.tag.node);
    let bytes = retained.as_bytes();
    return mem::equal_bytes(bytes, "_");
}

/// Returns this fixed buffer literal's type spelling.
pub fn (self: &BufferLiteralExpr) type_text(
    allocator: Allocator
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try self.append_type_text(allocator, &var out);
    return move out;
}

fn (self: &BufferLiteralExpr) append_type_text(

    allocator: Allocator,
    out: &var string::String
) -> !void {
    try out.append_byte(allocator, cast<u8>(91));
    try fmt::append_i64(allocator, out, self.size);
    try out.append_bytes(allocator, "]u8");
    return;
}

/// Resolves a runtime field chain to its root and dotted relative path.
pub fn field_path_root(
    allocator: Allocator,
    ast: &Ast,
    expression: Expression
) -> !?FieldPath {
    var path = string::new(allocator);
    errdefer path.deinit(allocator);
    if try append_field_path(allocator, ast, expression, &var path) |root| {
        return FieldPath { root: root, path: move path };
    }
    path.deinit(allocator);
    return null;
}

fn append_field_path(

    allocator: Allocator,
    ast: &Ast,
    expression: Expression,
    path: &var string::String
) -> !?IdentExpr {
    match ast.expressions.at(expression.node) {
        Field(field) => {
            if field.namespace {
                return null;
            }
            match ast.expressions.at(field.receiver.node) {
                Ident(root) => {
                    try append_retained_text(allocator,
                        path,
                        ast.texts.at(field.name.node)
                    );
                    return IdentExpr { name: root.name, span: root.span };
                },
                Field(_) => {
                    if try append_field_path(allocator,
                        ast,
                        field.receiver,
                        path
                    ) |root| {
                        try path.append_byte(allocator, cast<u8>(46));
                        try append_retained_text(allocator,
                            path,
                            ast.texts.at(field.name.node)
                        );
                        return root;
                    }
                    return null;
                },
                _ => return null,
            }
        },
        _ => return null,
    }
}

/// Renders one retained expression in the compact compiler diagnostic form.
pub fn render_expression(
    allocator: Allocator,
    ast: &Ast,
    expression: Expression
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try append_expression(allocator, &var out, ast, expression);
    return move out;
}

/// Renders one retained statement in the compact compiler diagnostic form.
pub fn render_statement(
    allocator: Allocator,
    ast: &Ast,
    statement: Statement
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try append_statement(allocator, &var out, ast, statement);
    return move out;
}

/// Renders one retained block in the compact compiler diagnostic form.
pub fn render_block(
    allocator: Allocator,
    ast: &Ast,
    block: Block
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try append_block(allocator, &var out, ast, block);
    return move out;
}

fn append_expression(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    expression: Expression
) -> !void {
    match ast.expressions.at(expression.node) {
        Ident(value) => try append_text(allocator, out, ast, value.name),
        Int(value) => try append_text(allocator, out, ast, value.value),
        Float(value) => try append_text(allocator, out, ast, value.value),
        String(value) => {
            let retained = ast.texts.at(value.value.node);
            let bytes = retained.as_bytes();
            try fmt::append_bytes_literal(allocator, out, bytes);
        },
        Null(_) => try out.append_bytes(allocator, "null"),
        OrelseGuard(value) => {
            try out.append_byte(allocator, cast<u8>(40));
            try append_expression(allocator, out, ast, value.condition);
            try out.append_bytes(allocator, " orelse ");
            try append_guard_exit(allocator, out, ast, value.exit);
            try out.append_byte(allocator, cast<u8>(41));
        },
        CatchGuard(value) => {
            try out.append_byte(allocator, cast<u8>(40));
            try append_expression(allocator, out, ast, value.condition);
            try out.append_bytes(allocator, " catch ");
            try append_guard_exit(allocator, out, ast, value.exit);
            try out.append_byte(allocator, cast<u8>(41));
        },
        Bool(value) => try fmt::append_bool(allocator, out, value.value),
        Type(value) => {
            try out.append_bytes(allocator, "type<");
            try append_text(allocator, out, ast, value.type_name);
            try out.append_byte(allocator, cast<u8>(62));
        },
        Comptime(value) => {
            try out.append_bytes(allocator, "comptime ");
            try append_expression(allocator, out, ast, value.expr);
        },
        Prefix(value) => {
            try out.append_byte(allocator, cast<u8>(40));
            try append_text(allocator, out, ast, value.operator);
            try append_expression(allocator, out, ast, value.right);
            try out.append_byte(allocator, cast<u8>(41));
        },
        Binary(value) => {
            try out.append_byte(allocator, cast<u8>(40));
            try append_expression(allocator, out, ast, value.left);
            try out.append_byte(allocator, cast<u8>(32));
            try append_text(allocator, out, ast, value.operator);
            try out.append_byte(allocator, cast<u8>(32));
            try append_expression(allocator, out, ast, value.right);
            try out.append_byte(allocator, cast<u8>(41));
        },
        Call(value) => {
            try append_expression(allocator, out, ast, value.callee);
            try out.append_byte(allocator, cast<u8>(40));
            try append_expression_list(allocator, out, ast, value.args);
            try out.append_byte(allocator, cast<u8>(41));
        },
        TypeApply(value) => {
            try append_expression(allocator, out, ast, value.callee);
            try out.append_byte(allocator, cast<u8>(60));
            try append_text(allocator, out, ast, value.type_arg);
            try out.append_byte(allocator, cast<u8>(62));
        },
        Cast(value) => {
            try out.append_bytes(allocator, "cast<");
            try typ::append_render(allocator, out, &ast.types, value.target_type);
            try out.append_bytes(allocator, ">(");
            try append_expression(allocator, out, ast, value.value);
            try out.append_byte(allocator, cast<u8>(41));
        },
        Try(value) => {
            try out.append_bytes(allocator, "try ");
            try append_expression(allocator, out, ast, value.value);
        },
        Move(value) => {
            try out.append_bytes(allocator, "move ");
            try append_expression(allocator, out, ast, value.value);
        },
        Unsafe(value) => {
            try out.append_bytes(allocator, "unsafe ");
            try append_expression(allocator, out, ast, value.value);
        },
        Index(value) => try append_index(allocator, out, ast, value),
        StructLiteral(value) => {
            try append_text(allocator, out, ast, value.type_name);
            try out.append_bytes(allocator, " { ");
            var index = 0;
            while value.fields.at(index) |field| {
                if index > 0 {
                    try out.append_bytes(allocator, ", ");
                }
                try append_text(allocator, out, ast, field.name);
                try out.append_bytes(allocator, ": ");
                try append_expression(allocator, out, ast, field.value);
                index = index + 1;
            }
            try out.append_bytes(allocator, " }");
        },
        BufferLiteral(value) => {
            try value.append_type_text(allocator, out);
            try out.append_bytes(allocator, "{}");
        },
        Field(value) => {
            try append_expression(allocator, out, ast, value.receiver);
            if value.namespace {
                try out.append_bytes(allocator, "::");
            } else {
                try out.append_byte(allocator, cast<u8>(46));
            }
            try append_text(allocator, out, ast, value.name);
        },
        Deref(value) => {
            try append_expression(allocator, out, ast, value.receiver);
            try out.append_bytes(allocator, ".*");
        },
        If(value) => try append_conditional(allocator,
            out,
            ast,
            value.condition,
            value.consequence,
            value.alternative
        ),
        Match(value) => try append_match(allocator, out, ast, value),
        Recovered(_) => {},
    }
    return;
}

fn append_statement(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    statement: Statement
) -> !void {
    match ast.statements.at(statement.node) {
        Block(value) => try append_block_value(allocator, out, ast, value),
        Let(value) => {
            if value.mutable {
                try out.append_bytes(allocator, "var ");
            } else {
                try out.append_bytes(allocator, "let ");
            }
            try append_text(allocator, out, ast, value.name);
            try out.append_bytes(allocator, " = ");
            try append_expression(allocator, out, ast, value.value);
            try out.append_byte(allocator, cast<u8>(59));
        },
        Assign(value) => {
            try append_expression(allocator, out, ast, value.target);
            try out.append_bytes(allocator, " = ");
            try append_expression(allocator, out, ast, value.value);
            try out.append_byte(allocator, cast<u8>(59));
        },
        Return(value) => {
            try out.append_bytes(allocator, "return");
            if value.value |expression| {
                try out.append_byte(allocator, cast<u8>(32));
                try append_expression(allocator, out, ast, expression);
            }
            try out.append_byte(allocator, cast<u8>(59));
        },
        Defer(value) => {
            try out.append_bytes(allocator, "defer ");
            try append_expression(allocator, out, ast, value.expr);
            try out.append_byte(allocator, cast<u8>(59));
        },
        ErrDefer(value) => {
            try out.append_bytes(allocator, "errdefer ");
            try append_expression(allocator, out, ast, value.expr);
            try out.append_byte(allocator, cast<u8>(59));
        },
        If(value) => try append_conditional(allocator,
            out,
            ast,
            value.condition,
            value.consequence,
            value.alternative
        ),
        While(value) => {
            try append_label(allocator, out, ast, value.label);
            try out.append_bytes(allocator, "while ");
            try append_expression(allocator, out, ast, value.condition);
            try out.append_byte(allocator, cast<u8>(32));
            try append_block(allocator, out, ast, value.body);
        },
        For(value) => {
            try append_label(allocator, out, ast, value.label);
            try out.append_bytes(allocator, "for ");
            try append_expression(allocator, out, ast, value.start);
            try out.append_bytes(allocator, "..");
            try append_expression(allocator, out, ast, value.end);
            try out.append_bytes(allocator, " |");
            try append_text(allocator, out, ast, value.name);
            try out.append_bytes(allocator, "| ");
            try append_block(allocator, out, ast, value.body);
        },
        Break(value) => try append_jump(allocator, out, ast, "break", value.label),
        Continue(value) => try append_jump(allocator, out, ast, "continue", value.label),
        Match(value) => try append_match(allocator, out, ast, value),
        ComptimeIf(value) => {
            try out.append_bytes(allocator, "comptime ");
            try append_conditional(allocator,
                out,
                ast,
                value.condition,
                value.consequence,
                value.alternative
            );
        },
        ComptimeFor(value) => {
            try out.append_bytes(allocator, "comptime for ");
            try append_expression(allocator, out, ast, value.list);
            try out.append_bytes(allocator, " |");
            try append_text(allocator, out, ast, value.name);
            try out.append_bytes(allocator, "| ");
            try append_block(allocator, out, ast, value.body);
        },
        ComptimeMatch(value) => {
            try out.append_bytes(allocator, "comptime match ");
            try append_expression(allocator, out, ast, value.value);
            try out.append_bytes(allocator, " |");
            try append_text(allocator, out, ast, value.name);
            if !text_is_empty(ast, value.binding) {
                try out.append_bytes(allocator, ", ");
                try append_text(allocator, out, ast, value.binding);
            }
            try out.append_bytes(allocator, "| ");
            try append_block(allocator, out, ast, value.body);
        },
        Expr(value) => {
            try append_expression(allocator, out, ast, value.expr);
            try out.append_byte(allocator, cast<u8>(59));
        },
        Recovered(_) => {},
    }
    return;
}

fn append_block(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    block: Block
) -> !void {
    match ast.statements.at(block.node) {
        Block(value) => try append_block_value(allocator, out, ast, value),
        _ => {},
    }
    return;
}

fn append_block_value(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    block: &BlockStmt
) -> !void {
    try out.append_bytes(allocator, "{ ");
    var index = 0;
    while block.statements.at(index) |statement| {
        if index > 0 {
            try out.append_byte(allocator, cast<u8>(32));
        }
        try append_statement(allocator,
            out,
            ast,
            Statement { node: statement.node }
        );
        index = index + 1;
    }
    try out.append_bytes(allocator, " }");
    return;
}

fn append_conditional(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    condition: Expression,
    consequence: Block,
    alternative: ?Block
) -> !void {
    try out.append_bytes(allocator, "if ");
    try append_expression(allocator, out, ast, condition);
    try out.append_byte(allocator, cast<u8>(32));
    try append_block(allocator, out, ast, consequence);
    if alternative |other| {
        try out.append_bytes(allocator, " else ");
        try append_block(allocator, out, ast, other);
    }
    return;
}

fn append_match(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    value: &MatchStmt
) -> !void {
    try out.append_bytes(allocator, "match ");
    try append_expression(allocator, out, ast, value.value);
    try out.append_bytes(allocator, " { ");
    var index = 0;
    while value.arms.at(index) |arm| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try append_match_arm(allocator, out, ast, arm);
        index = index + 1;
    }
    try out.append_bytes(allocator, " }");
    return;
}

fn append_match_arm(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    arm: &MatchArm
) -> !void {
    if !text_is_empty(ast, arm.tag_set) {
        try append_text(allocator, out, ast, arm.tag_set);
        try out.append_bytes(allocator, "::");
    }
    try append_text(allocator, out, ast, arm.tag);
    if !text_is_empty(ast, arm.binding) {
        try out.append_byte(allocator, cast<u8>(40));
        try append_text(allocator, out, ast, arm.binding);
        try out.append_byte(allocator, cast<u8>(41));
    }
    try out.append_bytes(allocator, " => ");
    match ast.statements.at(arm.body.node) {
        Expr(expression) => {
            if !expression.semicolon {
                try append_expression(allocator, out, ast, expression.expr);
                return;
            }
        },
        _ => {},
    }
    return append_statement(allocator, out, ast, arm.body);
}

fn append_expression_list(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    expressions: ExpressionList
) -> !void {
    var index = 0;
    while index < expressions.len(ast) {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try append_expression(allocator,
            out,
            ast,
            expressions.get_or_panic(ast, index)
        );
        index = index + 1;
    }
    return;
}

fn append_index(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    value: &IndexExpr
) -> !void {
    try append_expression(allocator, out, ast, value.target);
    try out.append_byte(allocator, cast<u8>(91));
    if !value.slice {
        if value.index |index| {
            try append_expression(allocator, out, ast, index);
        }
    } else {
        if value.start |start| {
            try append_expression(allocator, out, ast, start);
        }
        try out.append_bytes(allocator, "..");
        if value.end |end| {
            try append_expression(allocator, out, ast, end);
        }
    }
    try out.append_byte(allocator, cast<u8>(93));
    return;
}

fn append_guard_exit(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    exit: Statement
) -> !void {
    let start = out.len();
    try append_statement(allocator, out, ast, exit);
    if out.len() > start and string_ends_with(out, cast<u8>(59)) {
        try out.truncate(out.len() - 1);
    }
    return;
}

fn append_label(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    label: Text
) -> !void {
    if !text_is_empty(ast, label) {
        try append_text(allocator, out, ast, label);
        try out.append_bytes(allocator, ": ");
    }
    return;
}

fn append_jump(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    keyword: []u8,
    label: Text
) -> !void {
    try out.append_bytes(allocator, keyword);
    if !text_is_empty(ast, label) {
        try out.append_bytes(allocator, " :");
        try append_text(allocator, out, ast, label);
    }
    try out.append_byte(allocator, cast<u8>(59));
    return;
}

fn append_text(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    value: Text
) -> !void {
    return append_retained_text(allocator, out, ast.texts.at(value.node));
}

fn text_is_empty(ast: &Ast, value: Text) -> bool {
    return ast.texts.at(value.node).len() == 0;
}

fn string_ends_with(value: &string::String, expected: u8) -> bool {
    let length = value.len();
    if length == 0 {
        return false;
    }
    let bytes = value.as_bytes();
    return bytes[length - 1] == expected;
}

/// Renders one source-file root in the compact compiler diagnostic form.
pub fn render_program(
    allocator: Allocator,
    ast: &Ast,
    program: &Program
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while program.declarations.at(index) |declaration| {
        if index > 0 {
            try out.append_byte(allocator, cast<u8>(10));
        }
        try append_declaration(allocator,
            &var out,
            ast,
            Declaration { node: declaration.node }
        );
        index = index + 1;
    }
    return move out;
}

/// Renders one retained declaration in the compact compiler diagnostic form.
pub fn render_declaration(
    allocator: Allocator,
    ast: &Ast,
    declaration: Declaration
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try append_declaration(allocator, &var out, ast, declaration);
    return move out;
}

fn append_declaration(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: Declaration
) -> !void {
    match ast.declarations.at(declaration.node) {
        Import(value) => try append_import_decl(allocator, out, ast, value),
        Function(value) => try append_function_decl(allocator, out, ast, value),
        Test(value) => try append_test_decl(allocator, out, ast, value),
        Struct(value) => try append_struct_decl(allocator, out, ast, value),
        Enum(value) => try append_enum_decl(allocator, out, ast, value),
        ErrorSet(value) => try append_error_set_decl(allocator, out, ast, value),
        Union(value) => try append_union_decl(allocator, out, ast, value),
        Contract(value) => try append_contract_decl(allocator, out, ast, value),
        Impl(value) => try append_impl_decl(allocator, out, ast, value),
        Recovered(_) => {},
    }
    return;
}

fn append_import_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &ImportDecl
) -> !void {
    try out.append_bytes(allocator, "import ");
    return append_text_list(allocator, out, ast, &declaration.path, "::");
}

fn append_function_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &FunctionDecl
) -> !void {
    if declaration.signature.public {
        try out.append_bytes(allocator, "pub ");
    }
    if declaration.signature.requires_unsafe {
        try out.append_bytes(allocator, "unsafe ");
    }
    if !text_is_empty(ast, declaration.signature.extern_abi) {
        try out.append_bytes(allocator, "extern ");
        let abi = ast.texts.at(declaration.signature.extern_abi.node);
        let abi_bytes = abi.as_bytes();
        try fmt::append_bytes_literal(allocator, out, abi_bytes);
        try out.append_bytes(allocator, " fn ");
        try append_function_name_and_signature(allocator, out, ast, declaration);
        return;
    }
    if !text_is_empty(ast, declaration.signature.export_abi) {
        try out.append_bytes(allocator, "export ");
        let abi = ast.texts.at(declaration.signature.export_abi.node);
        let abi_bytes = abi.as_bytes();
        try fmt::append_bytes_literal(allocator, out, abi_bytes);
        try out.append_bytes(allocator, " fn ");
        try append_function_name_and_signature(allocator, out, ast, declaration);
        if declaration.body |body| {
            try out.append_byte(allocator, cast<u8>(32));
            try append_block(allocator, out, ast, body);
        } else {
            try out.append_byte(allocator, cast<u8>(59));
        }
        return;
    }
    try out.append_bytes(allocator, "fn ");
    try append_function_name_and_signature(allocator, out, ast, declaration);
    if declaration.body |body| {
        try out.append_byte(allocator, cast<u8>(32));
        try append_block(allocator, out, ast, body);
    } else {
        try out.append_byte(allocator, cast<u8>(59));
    }
    return;
}

fn append_function_name_and_signature(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &FunctionDecl
) -> !void {
    var param_index = 0;
    if declaration.signature.receiver {
        if declaration.signature.params.at(0) |receiver| {
            try out.append_byte(allocator, cast<u8>(40));
            try append_param(allocator, out, ast, receiver);
            try out.append_bytes(allocator, ") ");
            param_index = 1;
        }
    }
    try append_text(allocator, out, ast, declaration.signature.name);
    if declaration.signature.static_params.len() > 0 {
        try out.append_byte(allocator, cast<u8>(60));
        try append_static_params(allocator,
            out,
            ast,
            &declaration.signature.static_params
        );
        try out.append_byte(allocator, cast<u8>(62));
    }
    try out.append_byte(allocator, cast<u8>(40));
    var output_index = 0;
    while declaration.signature.params.at(param_index) |param| {
        if output_index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try append_param(allocator, out, ast, param);
        param_index = param_index + 1;
        output_index = output_index + 1;
    }
    try out.append_byte(allocator, cast<u8>(41));
    if declaration.signature.return_type |return_type| {
        try out.append_bytes(allocator, " -> ");
        try typ::append_render(allocator, out, &ast.types, return_type);
    }
    return;
}

fn append_static_params(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    params: &array::Array<StaticParam>
) -> !void {
    var index = 0;
    while params.at(index) |param| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try append_static_param(allocator, out, ast, param);
        index = index + 1;
    }
    return;
}

/// Appends one static parameter using its source declaration spelling.
pub fn append_static_param(
    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    param: &StaticParam
) -> !void {
    try append_text(allocator, out, ast, param.name);
    if param.type_name |type_name| {
        try out.append_bytes(allocator, ": ");
        try typ::append_render(allocator, out, &ast.types, type_name);
    }
    return;
}

fn append_param(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    param: &Param
) -> !void {
    try append_text(allocator, out, ast, param.name);
    try out.append_bytes(allocator, ": ");
    try append_borrow_prefix(allocator, out, param.borrow, param.mut_borrow);
    return typ::append_render(allocator, out, &ast.types, param.type_name);
}

fn append_test_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &TestDecl
) -> !void {
    try out.append_bytes(allocator, "test ");
    let name = ast.texts.at(declaration.name.node);
    let name_bytes = name.as_bytes();
    try fmt::append_bytes_literal(allocator, out, name_bytes);
    if declaration.body |body| {
        try out.append_byte(allocator, cast<u8>(32));
        try append_block(allocator, out, ast, body);
    } else {
        try out.append_bytes(allocator, " <missing>");
    }
    return;
}

fn append_struct_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &StructDecl
) -> !void {
    if declaration.public {
        try out.append_bytes(allocator, "pub ");
    }
    if declaration.requires_unsafe {
        try out.append_bytes(allocator, "unsafe ");
    }
    try out.append_bytes(allocator, "struct ");
    try append_text(allocator, out, ast, declaration.name);
    try append_type_params(allocator, out, ast, &declaration.type_params);
    try out.append_bytes(allocator, " { ");
    var index = 0;
    while declaration.fields.at(index) |field| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try append_field(allocator, out, ast, field);
        index = index + 1;
    }
    try out.append_bytes(allocator, " }");
    return;
}

fn append_field(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    field: &Field
) -> !void {
    if field.public {
        try out.append_bytes(allocator, "pub ");
    }
    try append_text(allocator, out, ast, field.name);
    try out.append_bytes(allocator, ": ");
    try append_borrow_prefix(allocator, out, field.borrow, field.mut_borrow);
    return typ::append_render(allocator, out, &ast.types, field.type_name);
}

fn append_enum_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &EnumDecl
) -> !void {
    if declaration.public {
        try out.append_bytes(allocator, "pub ");
    }
    try out.append_bytes(allocator, "enum ");
    try append_text(allocator, out, ast, declaration.name);
    try out.append_bytes(allocator, " { ");
    try append_text_list(allocator, out, ast, &declaration.tags, ", ");
    try out.append_bytes(allocator, " }");
    return;
}

fn append_error_set_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &ErrorSetDecl
) -> !void {
    if declaration.public {
        try out.append_bytes(allocator, "pub ");
    }
    try out.append_bytes(allocator, "error ");
    try append_text(allocator, out, ast, declaration.name);
    if declaration.combines.len() > 0 {
        try out.append_bytes(allocator, " = ");
        try append_text_list(allocator, out, ast, &declaration.combines, " or ");
        try out.append_byte(allocator, cast<u8>(59));
        return;
    }
    try out.append_bytes(allocator, " { ");
    try append_text_list(allocator, out, ast, &declaration.members, ", ");
    try out.append_bytes(allocator, " }");
    return;
}

fn append_union_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &UnionDecl
) -> !void {
    if declaration.public {
        try out.append_bytes(allocator, "pub ");
    }
    try out.append_bytes(allocator, "union ");
    try append_text(allocator, out, ast, declaration.name);
    try append_type_params(allocator, out, ast, &declaration.type_params);
    try out.append_bytes(allocator, " { ");
    var index = 0;
    while declaration.variants.at(index) |variant| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try append_union_variant(allocator, out, ast, variant);
        index = index + 1;
    }
    try out.append_bytes(allocator, " }");
    return;
}

fn append_union_variant(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    variant: &UnionVariant
) -> !void {
    try append_text(allocator, out, ast, variant.name);
    if variant.payload |payload| {
        try out.append_byte(allocator, cast<u8>(40));
        try typ::append_render(allocator, out, &ast.types, payload);
        try out.append_byte(allocator, cast<u8>(41));
    }
    return;
}

fn append_contract_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &ContractDecl
) -> !void {
    if declaration.public {
        try out.append_bytes(allocator, "pub ");
    }
    try out.append_bytes(allocator, "contract ");
    try append_text(allocator, out, ast, declaration.name);
    try out.append_bytes(allocator, " { ");
    var index = 0;
    while declaration.methods.at(index) |method| {
        if index > 0 {
            try out.append_bytes(allocator, "; ");
        }
        try append_function_decl(allocator, out, ast, method);
        index = index + 1;
    }
    try out.append_bytes(allocator, " }");
    return;
}

fn append_impl_decl(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    declaration: &ImplDecl
) -> !void {
    try out.append_bytes(allocator, "impl ");
    try append_text(allocator, out, ast, declaration.contract_name);
    try out.append_bytes(allocator, " for ");
    try append_text(allocator, out, ast, declaration.type_name);
    try out.append_byte(allocator, cast<u8>(59));
    return;
}

fn append_type_params(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    params: &array::Array<Text>
) -> !void {
    if params.len() == 0 {
        return;
    }
    try out.append_byte(allocator, cast<u8>(60));
    try append_text_list(allocator, out, ast, params, ", ");
    try out.append_byte(allocator, cast<u8>(62));
    return;
}

fn append_text_list(

    allocator: Allocator,
    out: &var string::String,
    ast: &Ast,
    values: &array::Array<Text>,
    separator: []u8
) -> !void {
    var index = 0;
    while values.at(index) |value| {
        if index > 0 {
            try out.append_bytes(allocator, separator);
        }
        try append_text(allocator, out, ast, Text { node: value.node });
        index = index + 1;
    }
    return;
}

fn append_borrow_prefix(

    allocator: Allocator,
    out: &var string::String,
    borrow: bool,
    mut_borrow: bool
) -> !void {
    if mut_borrow {
        try out.append_bytes(allocator, "&var ");
    } else {
        if borrow {
            try out.append_byte(allocator, cast<u8>(38));
        }
    }
    return;
}

/// Expands one compile-time match into the ordinary match every phase reads.
pub fn comptime_match_expansion(
    allocator: Allocator,
    stmt: &ComptimeMatchStmt,
    owner: Text,
    empty: Text,
    variants: &array::Array<MetaVariant>
) -> !MatchStmt {
    var arms = array::new<MatchArm>(allocator);
    errdefer arms.deinit(allocator);
    try arms.reserve(allocator, variants.len());
    let body = stmt.body.as_statement();
    var index = 0;
    while variants.at(index) |variant| {
        var binding = empty;
        if variant.has_payload {
            binding = stmt.binding;
        }
        try arms.append(allocator, MatchArm {
            tag: variant.name,
            binding: binding,
            body: body,
            tag_set: variant.origin
        });
        index = index + 1;
    }
    return MatchStmt {
        value: stmt.value,
        arms: move arms,
        meta_capture: stmt.name,
        meta_owner: owner
    };
}

fn add_variant_path(
    ast: &var Ast,
    owner_name: Text,
    variant_name: Text
) -> !Expression {
    let receiver = try ast.add_expression(ExpressionNode::Ident(IdentExpr {
        name: owner_name,
        span: zero_span()
    }));
    return try ast.add_expression(ExpressionNode::Field(FieldExpr {
        receiver: receiver,
        name: variant_name,
        namespace: true,
        span: zero_span()
    }));
}

/// Expands one reflected variant constructor into an ordinary expression.
pub fn variant_expansion(
    ast: &var Ast,
    owner: []u8,
    variant: []u8,
    args: ExpressionList
) -> !Expression {
    let owner_name = try ast.add_text_from_bytes(owner);
    let variant_name = try ast.add_text_from_bytes(variant);
    let has_args = args.len(ast) > 0;
    if !has_args {
        return add_variant_path(ast, owner_name, variant_name);
    }
    let path = try add_variant_path(ast, owner_name, variant_name);
    return try ast.add_expression(ExpressionNode::Call(CallExpr {
        callee: path,
        args: args
    }));
}

/// Reports whether a type spelling carries a cleanup contract.
pub fn owner_type(
    owners: &map::Map<[]u8, bool>,
    type_name: []u8
) -> bool {
    let base = base_type_name(type_name);
    return owners.get(base) orelse false;
}

fn base_type_name(type_name: []u8) -> []u8 {
    if typ::split_apply(type_name) |parts| {
        return parts.base;
    }
    return type_name;
}

fn new_owner_map(allocator: Allocator) -> !map::Map<[]u8, bool> {
    var owners = map::new<[]u8, bool>(allocator);
    errdefer owners.deinit(allocator);
    try owners.insert(allocator, "std::arena::Arena", true);
    return move owners;
}

fn add_declared_deinit_name(

    allocator: Allocator,
    owners: &var map::Map<[]u8, bool>,
    retained: &string::String
) -> !void {
    let name = retained.as_bytes();
    if typ::split_method_name(name) |parts| {
        if mem::equal_bytes(parts.method, typ::cleanup_method()) {
            let receiver = parts.receiver;
            let base = base_type_name(receiver);
            try owners.insert(allocator, base, true);
        }
    }
    return;
}

fn collect_declared_deinits(

    allocator: Allocator,
    ast: &Ast,
    program: &Program,
    owners: &var map::Map<[]u8, bool>,
    include_derived: bool
) -> !void {
    var index = 0;
    while program.declarations.get(index) |declaration| {
        match ast.declarations.at(declaration.node) {
            Function(function) => {
                if function.signature.receiver and
                    (include_derived or !function.derived) {
                    try add_declared_deinit_name(allocator,
                        owners,
                        ast.texts.at(function.signature.name.node)
                    );
                }
            },
            _ => {},
        }
        index = index + 1;
    }
    return;
}

fn type_holds_owner(
    allocator: Allocator,
    type_table: &typ::Table,
    owners: &map::Map<[]u8, bool>,
    value: typ::Type
) -> !bool {
    let rendered = try stdmeta::resolve_element_type_forms(allocator,
        type_table,
        value
    );
    defer rendered.deinit(allocator);
    let text = rendered.as_bytes();
    if typ::optional_elem(text) |elem| {
        return owner_type(owners, elem);
    }
    if typ::error_union_success(text) |success| {
        return owner_type(owners, success);
    }
    return owner_type(owners, text);
}

fn declared_holder(
    allocator: Allocator,
    ast: &Ast,
    owners: &map::Map<[]u8, bool>,
    declaration: Declaration
) -> !?Text {
    match ast.declarations.at(declaration.node) {
        Struct(value) => {
            var index = 0;
            while value.fields.at(index) |field| {
                if try type_holds_owner(allocator,
                    &ast.types,
                    owners,
                    field.type_name
                ) {
                    return value.name;
                }
                index = index + 1;
            }
            return null;
        },
        Union(value) => {
            var index = 0;
            while value.variants.at(index) |variant| {
                if variant.payload |payload| {
                    if try type_holds_owner(allocator,
                        &ast.types,
                        owners,
                        payload
                    ) {
                        return value.name;
                    }
                }
                index = index + 1;
            }
            return null;
        },
        _ => return null,
    }
}

fn add_owner_bytes(

    allocator: Allocator,
    owners: &var map::Map<[]u8, bool>,
    retained: &string::String
) -> !bool {
    let name = retained.as_bytes();
    if owners.contains(name) {
        return false;
    }
    try owners.insert(allocator, name, true);
    return true;
}

/// Returns every declared or transitive owner base name in one program.
pub fn deinit_owners(
    allocator: Allocator,
    ast: &Ast,
    program: &Program
) -> !map::Map<[]u8, bool> {
    var owners = try new_owner_map(allocator);
    errdefer owners.deinit(allocator);
    try collect_declared_deinits(allocator, ast, program, &var owners, true);
    var grew = true;
    while grew {
        grew = false;
        var index = 0;
        while program.declarations.get(index) |declaration| {
            if try declared_holder(allocator,
                ast,
                &owners,
                declaration
            ) |name| {
                if try add_owner_bytes(allocator,
                    &var owners,
                    ast.texts.at(name.node)
                ) {
                    grew = true;
                }
            }
            index = index + 1;
        }
    }
    return move owners;
}

/// Returns owner base names whose release names an allocator -- whose `deinit`
/// takes one (ADR-0132).
///
/// Generic cleanup has to know. A container releasing owner elements calls each
/// element's deinit, and an owner that frees memory and one that closes a
/// descriptor do not take the same argument.
///
/// A derived deinit always takes one, because the body it derives hands the
/// allocator to every field it consumes. Only a declared deinit says otherwise,
/// and it says it in its parameter list.
pub fn release_names_allocator(
    allocator: Allocator,
    ast: &Ast,
    program: &Program
) -> !map::Map<[]u8, bool> {
    var names = try new_owner_map(allocator);
    errdefer names.deinit(allocator);
    var declared = map::new<[]u8, bool>(allocator);
    defer declared.deinit(allocator);
    var index = 0;
    while program.declarations.get(index) |declaration| {
        match ast.declarations.at(declaration.node) {
            Function(function) => {
                if function.signature.receiver {
                    try collect_release_allocator(allocator,
                        ast,
                        function,
                        &var names,
                        &var declared
                    );
                }
            },
            _ => {},
        }
        index = index + 1;
    }
    // Everything else that owes cleanup owes it through fields, and the body
    // that discharges those is derived with an allocator.
    let owners = try deinit_owners(allocator, ast, program);
    defer owners.deinit(allocator);
    var owner_index = 0;
    while owners.key_at(owner_index) |owner| {
        if !declared.contains(owner) {
            try names.insert(allocator, owner, true);
        }
        owner_index = owner_index + 1;
    }
    return move names;
}

fn collect_release_allocator(
    allocator: Allocator,
    ast: &Ast,
    function: &FunctionDecl,
    names: &var map::Map<[]u8, bool>,
    declared: &var map::Map<[]u8, bool>
) -> !void {
    let retained = ast.texts.at(function.signature.name.node);
    let name = retained.as_bytes();
    if typ::split_method_name(name) |parts| {
        if !mem::equal_bytes(parts.method, typ::cleanup_method()) {
            return;
        }
        let base = base_type_name(parts.receiver);
        try declared.insert(allocator, base, true);
        if try deinit_takes_allocator(allocator, ast, function) {
            try names.insert(allocator, base, true);
        }
    }
    return;
}

// deinit_takes_allocator reads a declared cleanup's parameter list. The
// receiver is the first parameter, so an allocator is the one behind it.
fn deinit_takes_allocator(
    allocator: Allocator,
    ast: &Ast,
    function: &FunctionDecl
) -> !bool {
    var index = 1;
    while function.signature.params.at(index) |param| {
        var rendered = string::new(allocator);
        defer rendered.deinit(allocator);
        try typ::append_render(allocator, &var rendered, &ast.types, param.type_name);
        let text = rendered.as_bytes();
        if mem::equal_bytes(text, "Allocator") {
            return true;
        }
        index = index + 1;
    }
    return false;
}

/// Reports whether releasing a type names an allocator under the map above.
pub fn release_names(names: &map::Map<[]u8, bool>, type_name: []u8) -> bool {
    return owner_type(names, type_name);
}

/// Returns owner base names with cleanup written by the program's author.
pub fn declared_deinits(
    allocator: Allocator,
    ast: &Ast,
    program: &Program
) -> !map::Map<[]u8, bool> {
    var declared = try new_owner_map(allocator);
    errdefer declared.deinit(allocator);
    try collect_declared_deinits(allocator, ast, program, &var declared, false);
    return move declared;
}

fn all_declared_deinits(
    allocator: Allocator,
    ast: &Ast,
    program: &Program
) -> !map::Map<[]u8, bool> {
    var declared = map::new<[]u8, bool>(allocator);
    errdefer declared.deinit(allocator);
    try collect_declared_deinits(allocator, ast, program, &var declared, true);
    return move declared;
}

/// Adds the ordinary deinit method for every owner aggregate that declares none.
pub fn add_derived_deinits(
    allocator: Allocator,
    ast: &var Ast,
    program: &var Program
) -> !void {
    let owners = try deinit_owners(allocator, ast, program);
    defer owners.deinit(allocator);
    let declared = try all_declared_deinits(allocator, ast, program);
    defer declared.deinit(allocator);
    var derived = array::new<Declaration>(allocator);
    defer derived.deinit(allocator);
    try derived.reserve(allocator, program.declarations.len());
    var index = 0;
    while program.declarations.get(index) |declaration| {
        if try declared_holder(allocator,
            ast,
            &owners,
            declaration
        ) |name| {
            if !has_declared_deinit(ast, &declared, name) {
                if try derive_deinit(allocator,
                    ast,
                    &owners,
                    declaration
                ) |function| {
                    let retained = try ast.add_declaration(
                        DeclarationNode::Function(move function)
                    );
                    try derived.append(allocator, retained);
                }
            }
        }
        index = index + 1;
    }
    index = 0;
    while derived.get(index) |declaration| {
        try program.add_declaration(allocator, declaration);
        index = index + 1;
    }
    return;
}

fn has_declared_deinit(
    ast: &Ast,
    declared: &map::Map<[]u8, bool>,
    name: Text
) -> bool {
    return retained_map_contains(
        declared,
        ast.texts.at(name.node)
    );
}

// Keeps the arena borrow inside the lookup so later generation may mutate Ast.
fn retained_map_contains(
    values: &map::Map<[]u8, bool>,
    retained: &string::String
) -> bool {
    let bytes = retained.as_bytes();
    return values.contains(bytes);
}

/// Returns the deinit body fixed by one struct or union's owner members.
pub fn derive_deinit(
    allocator: Allocator,
    ast: &var Ast,
    owners: &map::Map<[]u8, bool>,
    declaration: Declaration
) -> !?FunctionDecl {
    let names = try new_derived_names(allocator, ast);
    match ast.declarations.at(declaration.node) {
        Struct(value) => return derive_struct_deinit(allocator, ast, owners, value, &names
        ),
        Union(value) => return derive_union_deinit(allocator, ast, owners, value, &names
        ),
        _ => return null,
    }
}

fn new_derived_names(
    allocator: Allocator,
    ast: &var Ast
) -> !DerivedNames {
    let receiver = try ast.add_text_from_bytes("self");
    let capture = try ast.add_text_from_bytes("held");
    let cleanup = try ast.add_text_from_bytes(
        typ::cleanup_method()
    );
    let allocator_name = try ast.add_text_from_bytes("allocator");
    let empty = try ast.add_empty_text();
    let err = try ast.add_text_from_bytes("err");
    let empty_args = try ast.add_expression_list(
        array::new<Expression>(allocator)
    );
    let handed = try add_derived_ident(ast, allocator_name);
    var allocator_arg_values = array::new<Expression>(allocator);
    errdefer allocator_arg_values.deinit(allocator);
    try allocator_arg_values.append(allocator, handed);
    let allocator_args = try ast.add_expression_list(move allocator_arg_values);
    return DerivedNames {
        receiver: receiver,
        capture: capture,
        cleanup: cleanup,
        allocator: allocator_name,
        empty: empty,
        err: err,
        empty_args: empty_args,
        allocator_args: allocator_args
    };
}

fn derive_struct_deinit(
    allocator: Allocator,
    ast: &var Ast,
    owners: &map::Map<[]u8, bool>,
    declaration: &StructDecl,
    names: &DerivedNames
) -> !?FunctionDecl {
    var statements = array::new<Statement>(allocator);
    errdefer statements.deinit(allocator);
    try statements.reserve(allocator, declaration.fields.len());
    var index = 0;
    while declaration.fields.at(index) |field| {
        let rendered = try stdmeta::resolve_element_type_forms(allocator,
            &ast.types,
            field.type_name
        );
        let kind = derived_member_kind(owners, &rendered);
        rendered.deinit(allocator);
        match kind {
            OptionalOwner => {
                // Only if may consume a field that while could read twice.
                let read = try add_derived_field_read(
                    ast,
                    names.receiver,
                    field.name
                );
                let held = try add_derived_ident(ast, names.capture);
                let cleanup = try add_derived_cleanup(ast, names, held);
                let consequence = try add_derived_block(allocator,
                    ast,
                    cleanup
                );
                try statements.append(allocator, try ast.add_statement(StatementNode::If(
                    IfStmt {
                    condition: read,
                    consequence: consequence,
                    alternative: null,
                    capture: names.capture,
                    err_capture: names.empty
                }
                )));
            },
            ErrorUnionOwner => {
                // An error union opens the same way, and its `if` names the
                // failure arm too (SPEC §11.1); a failed field holds nothing.
                let read = try add_derived_field_read(
                    ast,
                    names.receiver,
                    field.name
                );
                let held = try add_derived_ident(ast, names.capture);
                let cleanup = try add_derived_cleanup(ast, names, held);
                let consequence = try add_derived_block(allocator,
                    ast,
                    cleanup
                );
                let alternative = try add_derived_empty_block(allocator, ast);
                try statements.append(allocator, try ast.add_statement(StatementNode::If(
                    IfStmt {
                    condition: read,
                    consequence: consequence,
                    alternative: alternative,
                    capture: names.capture,
                    err_capture: names.err
                }
                )));
            },
            Owner => {
                let read = add_derived_field_read(
                    ast,
                    names.receiver,
                    field.name
                );
                try statements.append(allocator, try add_derived_cleanup(
                    ast,
                    names,
                    try read
                ));
            },
            Copy => {},
        }
        index = index + 1;
    }
    if statements.len() == 0 {
        statements.deinit(allocator);
        return null;
    }
    return try derive_decl(allocator,
        ast,
        declaration.name,
        &declaration.type_params,
        names,
        move statements
    );
}

fn derived_member_kind(
    owners: &map::Map<[]u8, bool>,
    rendered: &string::String
) -> DerivedMemberKind {
    let text = rendered.as_bytes();
    if typ::optional_elem(text) |elem| {
        if owner_type(owners, elem) {
            return DerivedMemberKind::OptionalOwner;
        }
        return DerivedMemberKind::Copy;
    }
    if typ::error_union_success(text) |success| {
        if owner_type(owners, success) {
            return DerivedMemberKind::ErrorUnionOwner;
        }
        return DerivedMemberKind::Copy;
    }
    if owner_type(owners, text) {
        return DerivedMemberKind::Owner;
    }
    return DerivedMemberKind::Copy;
}

fn rendered_owner_type(
    owners: &map::Map<[]u8, bool>,
    rendered: &string::String
) -> bool {
    let text = rendered.as_bytes();
    return owner_type(owners, text);
}

fn derive_union_deinit(
    allocator: Allocator,
    ast: &var Ast,
    owners: &map::Map<[]u8, bool>,
    declaration: &UnionDecl,
    names: &DerivedNames
) -> !?FunctionDecl {
    var arms = array::new<MatchArm>(allocator);
    errdefer arms.deinit(allocator);
    try arms.reserve(allocator, declaration.variants.len());
    var owned = false;
    var index = 0;
    while declaration.variants.at(index) |variant| {
        var payload_owned = false;
        if variant.payload |payload| {
            let rendered = try stdmeta::resolve_element_type_forms(allocator,
                &ast.types,
                payload
            );
            payload_owned = rendered_owner_type(owners, &rendered);
            rendered.deinit(allocator);
        }
        if payload_owned {
            owned = true;
            let held = try add_derived_ident(ast, names.capture);
            try arms.append(allocator, MatchArm {
                tag: variant.name,
                binding: names.capture,
                body: try add_derived_cleanup(ast, names, held),
                tag_set: names.empty
            });
        } else {
            // Empty arms keep the generated match exhaustive.
            let body = try add_derived_empty_block(allocator, ast);
            try arms.append(allocator, MatchArm {
                tag: variant.name,
                binding: names.empty,
                body: body.as_statement(),
                tag_set: names.empty
            });
        }
        index = index + 1;
    }
    if !owned {
        arms.deinit(allocator);
        return null;
    }
    let receiver = try add_derived_ident(ast, names.receiver);
    let statement = try ast.add_statement(StatementNode::Match(MatchStmt {
        value: receiver,
        arms: move arms,
        meta_capture: names.empty,
        meta_owner: names.empty
    }));
    var statements = array::new<Statement>(allocator);
    errdefer statements.deinit(allocator);
    try statements.append(allocator, statement);
    return try derive_decl(allocator,
        ast,
        declaration.name,
        &declaration.type_params,
        names,
        move statements
    );
}

fn derive_decl(
    allocator: Allocator,
    ast: &var Ast,
    owner: Text,
    type_params: &array::Array<Text>,
    names: &DerivedNames,
    statements: array::Array<Statement>
) -> !FunctionDecl {
    var body = move statements;
    errdefer body.deinit(allocator);
    let returned = try ast.add_statement(StatementNode::Return(ReturnStmt {
        value: null
    }));
    try body.append(allocator, returned);
    var static_params = array::new<StaticParam>(allocator);
    errdefer static_params.deinit(allocator);
    try static_params.reserve(allocator, type_params.len());
    var index = 0;
    while type_params.get(index) |name| {
        try static_params.append(allocator, StaticParam {
            name: name,
            type_name: null
        });
        index = index + 1;
    }
    let receiver_type = try derived_receiver_type(allocator,
        ast,
        owner,
        type_params
    );
    var params = array::new<Param>(allocator);
    errdefer params.deinit(allocator);
    try params.append(allocator, Param {
        name: names.receiver,
        type_name: receiver_type,
        borrow: false,
        mut_borrow: false
    });
    let allocator_type = try ast.types.parse("Allocator");
    try params.append(allocator, Param {
        name: names.allocator,
        type_name: allocator_type,
        borrow: false,
        mut_borrow: false
    });
    let owner_copy = try copy_text(allocator, ast, owner);
    defer owner_copy.deinit(allocator);
    let owner_bytes = owner_copy.as_bytes();
    // A derived method keeps the module identity of its receiver type.
    let std_owner = mem::starts_with(owner_bytes, "std::");
    let function_name = try joined_text(allocator,
        ast,
        owner_bytes,
        ".",
        typ::cleanup_method()
    );
    let return_type = try ast.types.parse("void");
    let body_block = try ast.add_block(BlockStmt { statements: move body });
    return FunctionDecl {
        signature: FunctionSignature {
            receiver: true,
            name: function_name,
            static_params: move static_params,
            params: move params,
            return_type: return_type,
            requires_unsafe: false,
            extern_abi: names.empty,
            export_abi: names.empty,
            public: false,
            std: std_owner,
            span: zero_span()
        },
        doc: names.empty,
        derived: true,
        body: body_block
    };
}

fn derived_receiver_type(
    allocator: Allocator,
    ast: &var Ast,
    owner: Text,
    type_params: &array::Array<Text>
) -> !typ::Type {
    if type_params.len() == 0 {
        let retained = ast.texts.at(owner.node);
        let bytes = retained.as_bytes();
        return ast.types.parse(bytes);
    }
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try append_retained_text(allocator, &var text, ast.texts.at(owner.node));
    try text.append_byte(allocator, cast<u8>(60));
    var index = 0;
    while type_params.get(index) |name| {
        if index > 0 {
            try text.append_bytes(allocator, ", ");
        }
        try append_retained_text(allocator, &var text, ast.texts.at(name.node));
        index = index + 1;
    }
    try text.append_byte(allocator, cast<u8>(62));
    let bytes = text.as_bytes();
    return ast.types.parse(bytes);
}

fn append_retained_text(

    allocator: Allocator,
    out: &var string::String,
    retained: &string::String
) -> !void {
    let bytes = retained.as_bytes();
    return out.append_bytes(allocator, bytes);
}

// Owns a name while the text arena is mutated to retain a derived method name.
fn copy_text(
    allocator: Allocator,
    ast: &Ast,
    value: Text
) -> !string::String {
    return copy_retained_text(allocator, ast.texts.at(value.node));
}

fn copy_retained_text(
    allocator: Allocator,
    retained: &string::String
) -> !string::String {
    let bytes = retained.as_bytes();
    return string::from_bytes(allocator, bytes);
}

fn add_derived_ident(ast: &var Ast, name: Text) -> !Expression {
    return try ast.add_expression(ExpressionNode::Ident(IdentExpr {
        name: name,
        span: zero_span()
    }));
}

fn add_derived_field_read(
    ast: &var Ast,
    receiver_name: Text,
    field_name: Text
) -> !Expression {
    let receiver = try add_derived_ident(ast, receiver_name);
    return try ast.add_expression(ExpressionNode::Field(FieldExpr {
        receiver: receiver,
        name: field_name,
        namespace: false,
        span: zero_span()
    }));
}

fn add_derived_cleanup(
    ast: &var Ast,
    names: &DerivedNames,
    value: Expression
) -> !Statement {
    let method = try ast.add_expression(ExpressionNode::Field(FieldExpr {
        receiver: value,
        name: names.cleanup,
        namespace: false,
        span: zero_span()
    }));
    let call = try ast.add_expression(ExpressionNode::Call(CallExpr {
        callee: method,
        args: names.allocator_args
    }));
    return try ast.add_statement(StatementNode::Expr(ExprStmt {
        expr: call,
        semicolon: true
    }));
}

fn add_derived_block(
    allocator: Allocator,
    ast: &var Ast,
    statement: Statement
) -> !Block {
    var statements = array::new<Statement>(allocator);
    errdefer statements.deinit(allocator);
    try statements.append(allocator, statement);
    return try ast.add_block(BlockStmt { statements: move statements });
}

fn add_derived_empty_block(
    allocator: Allocator,
    ast: &var Ast
) -> !Block {
    return try ast.add_block(BlockStmt {
        statements: array::new<Statement>(allocator)
    });
}

fn joined_text(
    allocator: Allocator,
    ast: &var Ast,
    left: []u8,
    middle: []u8,
    right: []u8
) -> !Text {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.reserve(allocator, mem::len(left) + mem::len(middle) + mem::len(right));
    try out.append_bytes(allocator, left);
    try out.append_bytes(allocator, middle);
    try out.append_bytes(allocator, right);
    return try ast.add_text(move out);
}

fn construct_binding(
    allocator: Allocator,
    ast: &var Ast,
    field: []u8
) -> !Text {
    return joined_text(allocator, ast, "construct$", "", field);
}

fn add_construct_cleanup(
    ast: &var Ast,
    binding: Text,
    method_name: Text,
    args: ExpressionList
) -> !Statement {
    let receiver = try ast.add_expression(ExpressionNode::Ident(IdentExpr {
        name: binding,
        span: zero_span()
    }));
    let method = try ast.add_expression(ExpressionNode::Field(FieldExpr {
        receiver: receiver,
        name: method_name,
        namespace: false,
        span: zero_span()
    }));
    let call = try ast.add_expression(ExpressionNode::Call(CallExpr {
        callee: method,
        args: args
    }));
    return try ast.add_statement(StatementNode::ErrDefer(ErrDeferStmt {
        expr: call
    }));
}

fn add_construct_field(
    allocator: Allocator,
    ast: &var Ast,
    owner: []u8,
    worker_name: Text,
    cleanup_method: Text,
    release_args: ExpressionList,
    field: &ConstructField,
    args: ExpressionList,
    owners: &map::Map<[]u8, bool>
) -> !ConstructBuilt {
    let binding = try construct_binding(allocator, ast, field.name);
    let type_arg = try joined_text(allocator, ast, owner, ", ", field.name);
    let field_name = try ast.add_text_from_bytes(field.name);
    let worker_expr = try ast.add_expression(ExpressionNode::Ident(IdentExpr {
        name: worker_name,
        span: zero_span()
    }));
    let applied = try ast.add_expression(ExpressionNode::TypeApply(TypeApplyExpr {
        callee: worker_expr,
        type_arg: type_arg
    }));
    let call = try ast.add_expression(ExpressionNode::Call(CallExpr {
        callee: applied,
        args: args
    }));
    let value = try ast.add_expression(ExpressionNode::Try(TryExpr {
        value: call
    }));
    let statement = try ast.add_statement(StatementNode::Let(LetStmt {
        mutable: false,
        name: binding,
        value: value
    }));
    let field_value = try ast.add_expression(ExpressionNode::Ident(IdentExpr {
        name: binding,
        span: zero_span()
    }));
    if owner_type(owners, field.type_name) {
        let cleanup = try add_construct_cleanup(
            ast,
            binding,
            cleanup_method,
            release_args
        );
        let moved = try ast.add_expression(ExpressionNode::Move(MoveExpr {
            value: field_value,
            span: zero_span()
        }));
        return ConstructBuilt {
            statement: statement,
            cleanup: cleanup,
            field: FieldValue {
                name: field_name,
                value: moved
            }
        };
    }
    return ConstructBuilt {
        statement: statement,
        cleanup: null,
        field: FieldValue {
            name: field_name,
            value: field_value
        }
    };
}

// Accumulates the statements and literal fields of one construct expansion
// so callers that hold field descriptions in different shapes share one
// expansion.
struct ConstructBuilder {
    statements: array::Array<Statement>,
    values: array::Array<FieldValue>,
    type_name: Text,
    worker_name: Text,
    cleanup_method: Text,
    // The release an owner field's errdefer writes names the allocator the
    // worker built it from, which is the construct's own first argument
    // (ADR-0132).
    release_args: ExpressionList
}

fn begin_construct(
    allocator: Allocator,
    ast: &var Ast,
    owner: []u8,
    worker: []u8,
    field_count: i64,
    args: ExpressionList
) -> !ConstructBuilder {
    var statements = array::new<Statement>(allocator);
    errdefer statements.deinit(allocator);
    try statements.reserve(allocator, field_count * 2);
    var values = array::new<FieldValue>(allocator);
    errdefer values.deinit(allocator);
    try values.reserve(allocator, field_count);
    let type_name = try ast.add_text_from_bytes(owner);
    let worker_name = try ast.add_text_from_bytes(worker);
    let cleanup_method = try ast.add_text_from_bytes(
        typ::cleanup_method()
    );
    var release_values = array::new<Expression>(allocator);
    errdefer release_values.deinit(allocator);
    if args.len(ast) > 0 {
        try release_values.append(allocator, args.get_or_panic(ast, 0));
    }
    let release_args = try ast.add_expression_list(move release_values);
    return ConstructBuilder {
        statements: move statements,
        values: move values,
        type_name: type_name,
        worker_name: worker_name,
        cleanup_method: cleanup_method,
        release_args: release_args
    };
}

fn (self: &var ConstructBuilder) add_field(
    allocator: Allocator,
    ast: &var Ast,
    owner: []u8,
    field: &ConstructField,
    args: ExpressionList,
    owners: &map::Map<[]u8, bool>
) -> !void {
    let built = try add_construct_field(allocator,
        ast,
        owner,
        self.worker_name,
        self.cleanup_method,
        self.release_args,
        field,
        args,
        owners
    );
    try self.statements.append(allocator, built.statement);
    if built.cleanup |cleanup| {
        try self.statements.append(allocator, cleanup);
    }
    try self.values.append(allocator, built.field);
    return;
}

fn finish_construct(
    allocator: Allocator,
    ast: &var Ast,
    builder: ConstructBuilder
) -> !ConstructResult {
    errdefer builder.deinit(allocator);
    let literal = try ast.add_expression(ExpressionNode::StructLiteral(StructLiteralExpr {
        type_name: builder.type_name,
        fields: move builder.values,
        span: zero_span()
    }));
    return ConstructResult {
        statements: move builder.statements,
        literal: literal
    };
}

/// Expands one reflected struct construction into ordinary AST nodes.
pub fn construct_expansion(
    allocator: Allocator,
    ast: &var Ast,
    owner: []u8,
    worker: []u8,
    fields: &array::Array<ConstructField>,
    args: ExpressionList,
    owners: &map::Map<[]u8, bool>
) -> !ConstructResult {
    var builder = try begin_construct(allocator, ast, owner, worker, fields.len(), args
    );
    errdefer builder.deinit(allocator);
    var index = 0;
    while fields.at(index) |field| {
        try builder.add_field(allocator, ast, owner, field, args, owners);
        index = index + 1;
    }
    return finish_construct(allocator, ast, move builder);
}

/// Expands one reflected struct construction whose field names and type
/// spellings are retained Strings, paired by index.
pub fn construct_expansion_from_names(
    allocator: Allocator,
    ast: &var Ast,
    owner: []u8,
    worker: []u8,
    names: &array::Array<string::String>,
    type_names: &array::Array<string::String>,
    args: ExpressionList,
    owners: &map::Map<[]u8, bool>
) -> !ConstructResult {
    var builder = try begin_construct(allocator, ast, owner, worker, names.len(), args
    );
    errdefer builder.deinit(allocator);
    var index = 0;
    while names.at(index) |retained_name| {
        let name = retained_name.as_bytes();
        if type_names.at(index) |retained_type_name| {
            let type_name = retained_type_name.as_bytes();
            let field = ConstructField { name: name, type_name: type_name };
            try builder.add_field(allocator, ast, owner, &field, args, owners);
        }
        index = index + 1;
    }
    return finish_construct(allocator, ast, move builder);
}

/// Returns the expression covered by a value-transparent marker.
pub fn marker_value(ast: &Ast, value: Expression) -> ?Expression {
    match ast.expressions.at(value.node) {
        Comptime(node) => return node.expr,
        Unsafe(node) => return node.value,
        Move(node) => return node.value,
        _ => return null,
    }
}
