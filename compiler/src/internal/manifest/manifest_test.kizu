import std::array;
import std::mem;
import std::string;
import std::testing;

fn expect_string(actual: &string::String, expected: []u8) -> void {
    let bytes = actual.as_bytes();
    testing::expect_equal<[]u8>(expected, bytes);
    return;
}

fn expect_path(manifest: &Manifest, index: i64, expected: []u8) -> void {
    if manifest.paths.at(index) |path| {
        expect_string(path, expected);
    } else {
        testing::fail("missing path");
    }
    return;
}

fn expect_error(result: &ParseResult, expected: []u8) -> void {
    match result {
        Manifest(_) => testing::fail("manifest was accepted"),
        Error(text) => expect_string(text, expected),
    }
    return;
}

test "parse manifest accepts the kizu.toml subset" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "app"
        \\version = "0.1.0"
        \\
        \\[modules]
        \\paths = ["src", "lib"]
    ;
    let result = try parse_manifest(allocator, source);
    defer result.deinit(allocator);
    match &result {
        Manifest(manifest) => {
            expect_string(&manifest.package_name, "app");
            expect_string(&manifest.version, "0.1.0");
            testing::expect_equal<i64>(2, manifest.paths.len());
            expect_path(manifest, 0, "src");
            expect_path(manifest, 1, "lib");
        },
        Error(text) => expect_string(text, ""),
    }
}

test "parse manifest rejects the removed modules.root key" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "app"
        \\
        \\[modules]
        \\root = "src/main.kizu"
    ;
    let result = try parse_manifest(allocator, source);
    defer result.deinit(allocator);
    expect_error(&result, "manifest error:5: unsupported key `modules.root`");
}

test "parse manifest rejects the reserved std package name" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "std"
    ;
    let result = try parse_manifest(allocator, source);
    defer result.deinit(allocator);
    expect_error(&result, "manifest error: package name `std` is reserved");
}

test "parse std manifest allows the reserved std package name" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "std"
        \\
        \\[modules]
        \\paths = ["src"]
    ;
    let result = try parse_std_manifest(allocator, source);
    defer result.deinit(allocator);
    match &result {
        Manifest(manifest) => {
            expect_string(&manifest.package_name, "std");
            expect_path(manifest, 0, "src");
        },
        Error(text) => expect_string(text, ""),
    }
}

fn expect_entry(values: &array::Array<string::String>, index: i64, expected: []u8) -> void {
    if values.at(index) |value| {
        expect_string(value, expected);
    } else {
        testing::fail("missing entry");
    }
    return;
}

test "parse manifest reads the native search paths" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "app"
        \\
        \\[native]
        \\library_search = ["/opt/homebrew/lib", "vendor/lib"]
        \\framework_search = ["vendor/frameworks"]
    ;
    let result = try parse_manifest(allocator, source);
    defer result.deinit(allocator);
    match &result {
        Manifest(manifest) => {
            testing::expect_equal<i64>(2, manifest.native.libraries.len());
            expect_entry(&manifest.native.libraries, 1, "vendor/lib");
            testing::expect_equal<i64>(1, manifest.native.frameworks.len());
            expect_entry(&manifest.native.frameworks, 0, "vendor/frameworks");
        },
        Error(text) => expect_string(text, ""),
    }
}

test "parse manifest reads a native section per operating system" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "app"
        \\
        \\[native]
        \\library_search = ["vendor/lib"]
        \\
        \\[native.darwin]
        \\framework_search = ["vendor/frameworks"]
        \\
        \\[native.linux]
        \\library_search = ["/opt/lib"]
    ;
    let result = try parse_manifest(allocator, source);
    defer result.deinit(allocator);
    match &result {
        Manifest(manifest) => {
            let darwin = try manifest.native_search(allocator, "darwin");
            defer darwin.deinit(allocator);
            testing::expect_equal<i64>(1, darwin.libraries.len());
            expect_entry(&darwin.libraries, 0, "vendor/lib");
            testing::expect_equal<i64>(1, darwin.frameworks.len());
            expect_entry(&darwin.frameworks, 0, "vendor/frameworks");
            let linux = try manifest.native_search(allocator, "linux");
            defer linux.deinit(allocator);
            testing::expect_equal<i64>(2, linux.libraries.len());
            expect_entry(&linux.libraries, 0, "vendor/lib");
            expect_entry(&linux.libraries, 1, "/opt/lib");
            testing::expect_equal<i64>(0, linux.frameworks.len());
            let none = try manifest.native_search(allocator, "");
            defer none.deinit(allocator);
            testing::expect_equal<i64>(1, none.libraries.len());
            expect_entry(&none.libraries, 0, "vendor/lib");
        },
        Error(text) => expect_string(text, ""),
    }
}

test "parse manifest rejects an unknown native operating system" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "app"
        \\
        \\[native.windows]
        \\library_search = ["vendor/lib"]
    ;
    let result = try parse_manifest(allocator, source);
    defer result.deinit(allocator);
    expect_error(
        &result,
        "manifest error:4: unsupported section `native.windows`: native targets are darwin, linux"
    );
}

test "parse manifest rejects an unknown key in a native section per operating system" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "app"
        \\
        \\[native.darwin]
        \\foo = ["m"]
    ;
    let result = try parse_manifest(allocator, source);
    defer result.deinit(allocator);
    expect_error(&result, "manifest error:5: unsupported key `native.darwin.foo`");
}

test "parse manifest rejects an unknown native key" {
    let allocator = mem::page_allocator();
    let source =
        \\[package]
        \\name = "app"
        \\
        \\[native]
        \\libraries = ["m"]
    ;
    let result = try parse_manifest(allocator, source);
    defer result.deinit(allocator);
    expect_error(&result, "manifest error:5: unsupported key `native.libraries`");
}
