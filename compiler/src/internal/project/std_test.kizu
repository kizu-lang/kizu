import compiler::internal::ast;
import compiler::internal::lexer;
import compiler::internal::token;
import std::fs;
import std::io;
import std::mem;
import std::testing;

fn lexes_error(text: []u8) -> !bool {
    let allocator = mem::page_allocator();
    var scanner = lexer::new(allocator, text);
    defer scanner.deinit(allocator);
    while true {
        let current = try scanner.next_lexeme();
        if current.kind == token::Kind::Eof {
            return false;
        }
        if current.kind == token::Kind::Ident and
            mem::equal_bytes(text[current.start..current.end], "error") {
            return true;
        }
    }
    return false;
}

fn expect_may_spell(text: []u8, want: bool) -> !void {
    testing::expect(may_spell_error(text) == want);
    if try lexes_error(text) {
        testing::expect(may_spell_error(text));
    }
    return;
}

test "may_spell_error rules out only occurrences that are not the token" {
    try expect_may_spell("error Failure { A, B }", true);
    try expect_may_spell("pub error Failure = A or B;", true);
    try expect_may_spell(
        \\fn f() {}
        \\error Failure { A }
    , true);
    try expect_may_spell("let x = 1error;", true);
    try expect_may_spell("// relative error of the result", false);
    try expect_may_spell(
        \\/// a doc comment naming an error
        \\fn f() {}
    , false);
    try expect_may_spell("let x = 1; // error below", false);
    try expect_may_spell("terror errors error_set set_error error9", false);
    try expect_may_spell("let s = 0xerror;", false);
    try expect_may_spell(
        \\let s = "a // b"; error Failure { A }
    , true);
    try expect_may_spell(
        \\let s = "a // b error";
    , true);
    try expect_may_spell(
        \\let s = "a
        \\// b error";
    , false);
    try expect_may_spell(
        \\let s =
        \\    \\ text // error
        \\;
    , false);
    try expect_may_spell(
        \\let s =
        \\    \\ text error
        \\;
    , true);
    return;
}

test "may_spell_error keeps every std file that declares an error set" {
    let allocator = mem::page_allocator();
    let io = io::blocking();
    var loader = try new_loader(io, allocator, "lib/kizu");
    defer loader.deinit(allocator);
    let outcome = try loader.read_std_graph();
    match outcome {
        Error(failed) => {
            defer failed.deinit(allocator);
            testing::fail("std graph did not resolve");
        },
        Graph(graph) => {
            defer graph.deinit(allocator);
            var index = 0;
            while graph.modules.at(index) |module| {
                index = index + 1;
                var file_index = 0;
                while module.files.at(file_index) |file| {
                    file_index = file_index + 1;
                    let file_bytes = file.as_bytes();
                    let text = try fs::read_file(io, allocator, file_bytes, mem::Limit::Unlimited);
                    defer text.deinit(allocator);
                    let bytes = text.as_bytes();
                    if try lexes_error(bytes) {
                        testing::expect(may_spell_error(bytes));
                    }
                }
            }
        },
    }
    return;
}

test "std cache skips std::fmt without print and loads it when print is used" {
    let allocator = mem::page_allocator();
    let io = io::blocking();
    let cached = try load_std_cache(io, allocator, "lib/kizu");
    match cached {
        Error(failed) => {
            defer failed.deinit(allocator);
            testing::fail("std cache did not load");
        },
        Cache(std_cache) => {
            defer std_cache.deinit(allocator);
            var plain_tree = ast::new(allocator);
            defer plain_tree.deinit(allocator);
            var plain_loader = try new_loader(io, allocator, "lib/kizu");
            defer plain_loader.deinit(allocator);
            let plain = try plain_loader.load_source_cached(&var plain_tree, "plain.kizu", "fn main() -> i64 { return 1; }", &std_cache);
            match plain {
                Error(failed) => {
                    defer failed.deinit(allocator);
                    testing::fail("plain source did not load");
                },
                Program(program) => {
                    defer program.deinit(allocator);
                    testing::expect(!plain_tree.uses_print);
                    testing::expect_equal<i64>(1, program.declarations.len());
                },
            }
            var print_tree = ast::new(allocator);
            defer print_tree.deinit(allocator);
            var print_loader = try new_loader(io, allocator, "lib/kizu");
            defer print_loader.deinit(allocator);
            print_loader.std_signatures_only = true;
            let printed = try print_loader.load_source_cached(&var print_tree, "print.kizu", "fn main() { print(1); }", &std_cache);
            match printed {
                Error(failed) => {
                    defer failed.deinit(allocator);
                    testing::fail("print source did not load");
                },
                Program(program) => {
                    defer program.deinit(allocator);
                    testing::expect(print_tree.uses_print);
                    testing::expect(program.declarations.len() > 1);
                },
            }
            var umbrella_tree = ast::new(allocator);
            defer umbrella_tree.deinit(allocator);
            var umbrella_loader = try new_loader(io, allocator, "lib/kizu");
            defer umbrella_loader.deinit(allocator);
            let umbrella_source =
                \\import std;
                \\fn main() -> i64 { return std::mem::len("ab"); }
            ;
            let umbrella = try umbrella_loader.load_source_cached(
                &var umbrella_tree,
                "umbrella.kizu",
                umbrella_source,
                &std_cache
            );
            match umbrella {
                Error(failed) => {
                    defer failed.deinit(allocator);
                    testing::fail("umbrella import std did not load");
                },
                Program(program) => {
                    defer program.deinit(allocator);
                    var has_mem = false;
                    var has_http = false;
                    var mod_index = 0;
                    while program.modules.get(mod_index) |mod_text| {
                        mod_index = mod_index + 1;
                        let name = umbrella_tree.texts.at(mod_text.node);
                        if text_is(name, "std::mem") {
                            has_mem = true;
                        }
                        if text_is(name, "std::http") {
                            has_http = true;
                        }
                    }
                    testing::expect(has_mem);
                    testing::expect(!has_http);
                },
            }
        },
    }
    return;
}
