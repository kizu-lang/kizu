import compiler::internal::ast;
import compiler::internal::buildplan;
import compiler::internal::diagnostic;
import compiler::internal::lexer;
import compiler::internal::manifest;
import compiler::internal::parser;
import compiler::internal::source;
import std::arena;
import std::array;
import std::fmt;
import std::fs;
import std::map;
import std::mem;
import std::path;
import std::sort;
import std::string;

pub fn std_root() -> []u8 {
    return "std";
}

pub fn internal_segment() -> []u8 {
    return "internal";
}

pub struct Module {
    pub path: string::String,
    pub files: array::Array<string::String>,
    pub test_files: array::Array<string::String>,
}

pub struct Graph {
    pub package_name: string::String,
    pub modules: array::Array<Module>,
    pub root: string::String,
}

pub union GraphResult {
    Graph(Graph),
    Error(diagnostic::Diagnostic),
}

pub union LoadResult {
    Program(ast::Program),
    Error(diagnostic::Diagnostic),
}

fn module_error(allocator: Allocator, text: string::String) -> !diagnostic::Diagnostic {
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    let built = try diagnostic::from_text(allocator,
        diagnostic::Severity::Error,
        ast::zero_span(),
        bytes
    );
    return move built;
}

fn module_error_text(allocator: Allocator) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, "module error: ");
    return move out;
}

fn copy_string(allocator: Allocator, value: &string::String) -> !string::String {
    let bytes = value.as_bytes();
    return string::from_bytes(allocator, bytes);
}

fn same_text(left: &string::String, right: &string::String) -> bool {
    let left_bytes = left.as_bytes();
    let right_bytes = right.as_bytes();
    return mem::equal_bytes(left_bytes, right_bytes);
}

fn text_is(value: &string::String, bytes: []u8) -> bool {
    let value_bytes = value.as_bytes();
    return mem::equal_bytes(value_bytes, bytes);
}

fn set_contains(set: &map::Map<[]u8, bool>, key: &string::String) -> bool {
    let bytes = key.as_bytes();
    return set.contains(bytes);
}

fn set_insert(allocator: Allocator, set: &var map::Map<[]u8, bool>, key: &string::String) -> !void {
    let bytes = key.as_bytes();
    return set.insert(allocator, bytes, true);
}

fn (self: &Module) source_files(
    allocator: Allocator,
    include_tests: bool
) -> !array::Array<string::String> {
    var files = array::new<string::String>(allocator);
    errdefer files.deinit(allocator);
    var index = 0;
    while self.files.at(index) |file| {
        try files.append(allocator, try copy_string(allocator, file));
        index = index + 1;
    }
    if include_tests {
        index = 0;
        while self.test_files.at(index) |file| {
            try files.append(allocator, try copy_string(allocator, file));
            index = index + 1;
        }
    }
    try sort::strings(&var files);
    return move files;
}

pub fn is_test_file(file: []u8) -> bool {
    let base = path::basename(file);
    let suffix = "_test.kizu";
    let suffix_len = mem::len(suffix);
    let base_len = mem::len(base);
    if base_len < suffix_len {
        return false;
    }
    return mem::equal_bytes(base[base_len - suffix_len..base_len], suffix);
}

pub fn resolve_modules(
    io: Io,
    allocator: Allocator,
    base_dir: []u8,
    parsed: &manifest::Manifest,
    inputs: &var buildplan::InputLog
) -> !GraphResult {
    var modules = array::new<Module>(allocator);
    errdefer modules.deinit(allocator);
    var seen_files = map::new<[]u8, string::String>(allocator);
    defer seen_files.deinit(allocator);
    let package_name = parsed.package_name.as_bytes();
    var index = 0;
    while parsed.paths.at(index) |source_root| {
        index = index + 1;
        let source_root_bytes = source_root.as_bytes();
        let joined = try path::join(allocator, base_dir, source_root_bytes);
        defer joined.deinit(allocator);
        let joined_bytes = joined.as_bytes();
        let root = try path::clean(allocator, joined_bytes);
        defer root.deinit(allocator);
        let root_bytes = root.as_bytes();
        if try collect_source_root(
            io,
            allocator,
            &var modules,
            &var seen_files,
            inputs,
            package_name,
            root_bytes,
            root_bytes
        ) |failed| {
            modules.deinit(allocator);
            return GraphResult::Error(move failed);
        }
    }
    try sort_modules(&var modules);
    var root = try string::from_bytes(allocator, base_dir);
    errdefer root.deinit(allocator);
    return GraphResult::Graph(Graph {
        package_name: try copy_string(allocator, &parsed.package_name),
        modules: move modules,
        root: move root
    });
}

fn collect_source_root(
    io: Io,
    allocator: Allocator,
    modules: &var array::Array<Module>,
    seen_files: &var map::Map<[]u8, string::String>,
    inputs: &var buildplan::InputLog,
    package_name: []u8,
    source_root: []u8,
    dir: []u8
) -> !?diagnostic::Diagnostic {
    var entries = try fs::read_dir(io, allocator, dir);
    defer entries.deinit(allocator);
    try inputs.add_dir(allocator, dir, &entries);
    var index = 0;
    while entries.at(index) |entry| {
        index = index + 1;
        let entry_path = entry.path.as_bytes();
        if entry.is_dir {
            if try collect_source_root(
                io,
                allocator,
                modules,
                seen_files,
                inputs,
                package_name,
                source_root,
                entry_path
            ) |failed| {
                return move failed;
            }
        } else {
            let extension = path::extension(entry_path);
            if mem::equal_bytes(extension, ".kizu") {
                if try record_source_file(allocator,
                    modules,
                    seen_files,
                    package_name,
                    source_root,
                    entry_path
                ) |failed| {
                    return move failed;
                }
            }
        }
    }
    return null;
}

fn record_source_file(
    allocator: Allocator,
    modules: &var array::Array<Module>,
    seen_files: &var map::Map<[]u8, string::String>,
    package_name: []u8,
    source_root: []u8,
    file: []u8
) -> !?diagnostic::Diagnostic {
    let module_path = try source_module_path(allocator, package_name, source_root, file);
    defer module_path.deinit(allocator);
    let clean_path = try path::clean(allocator, file);
    defer clean_path.deinit(allocator);
    let clean = clean_path.as_bytes();
    if seen_files.at(clean) |previous| {
        if same_text(previous, &module_path) {
            return null;
        }
        var text = try module_error_text(allocator);
        errdefer text.deinit(allocator);
        try text.append_bytes(allocator, "source `");
        try text.append_bytes(allocator, clean);
        try text.append_bytes(allocator, "` belongs to both `");
        try text.append_string(allocator, previous);
        try text.append_bytes(allocator, "` and `");
        try text.append_string(allocator, &module_path);
        try text.append_bytes(allocator, "`");
        return try module_error(allocator, move text);
    }
    try seen_files.insert(allocator, clean, try copy_string(allocator, &module_path));
    let slot = try module_slot(allocator, modules, &module_path);
    if modules.at_mut(slot) |module| {
        if is_test_file(clean) {
            try module.test_files.append(allocator, try string::from_bytes(allocator, clean));
        } else {
            try module.files.append(allocator, try string::from_bytes(allocator, clean));
        }
    }
    return null;
}

fn module_slot(
    allocator: Allocator,
    modules: &var array::Array<Module>,
    module_path: &string::String
) -> !i64 {
    var index = 0;
    while modules.at(index) |module| {
        if same_text(&module.path, module_path) {
            return index;
        }
        index = index + 1;
    }
    try modules.append(allocator, Module {
        path: try copy_string(allocator, module_path),
        files: array::new<string::String>(allocator),
        test_files: array::new<string::String>(allocator)
    });
    return index;
}

fn source_module_path(
    allocator: Allocator,
    package_name: []u8,
    source_root: []u8,
    file: []u8
) -> !string::String {
    let dir = path::dirname(file);
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, package_name);
    let root_len = mem::len(source_root);
    if mem::len(dir) <= root_len {
        return move out;
    }
    let rel = dir[root_len + 1..mem::len(dir)];
    if mem::len(rel) == 0 {
        return move out;
    }
    try out.append_bytes(allocator, "::");
    var index = 0;
    while mem::byte_at(rel, index) |byte| {
        if byte == cast<u8>(47) {
            try out.append_bytes(allocator, "::");
        } else {
            try out.append_byte(allocator, byte);
        }
        index = index + 1;
    }
    return move out;
}

fn sort_modules(modules: &var array::Array<Module>) -> !void {
    var index = 0;
    while modules.at_mut(index) |module| {
        try sort::strings(&var module.files);
        try sort::strings(&var module.test_files);
        index = index + 1;
    }
    var outer = 1;
    while outer < modules.len() {
        var inner = outer;
        while inner > 0 {
            if !module_before(modules, inner, inner - 1) {
                break;
            }
            try modules.swap(inner - 1, inner);
            inner = inner - 1;
        }
        outer = outer + 1;
    }
    return;
}

fn module_before(modules: &array::Array<Module>, left: i64, right: i64) -> bool {
    if modules.at(left) |left_module| {
        if modules.at(right) |right_module| {
            let left_bytes = left_module.path.as_bytes();
            let right_bytes = right_module.path.as_bytes();
            return bytes_less(left_bytes, right_bytes);
        }
    }
    return false;
}

pub fn bytes_less(left: []u8, right: []u8) -> bool {
    var index = 0;
    while true {
        let left_byte = mem::byte_at(left, index);
        let right_byte = mem::byte_at(right, index);
        if left_byte |l| {
            if right_byte |r| {
                if l != r {
                    return l < r;
                }
            } else {
                return false;
            }
        } else {
            if right_byte |_| {
                return true;
            }
            return false;
        }
        index = index + 1;
    }
    return false;
}

pub struct InternalModule {
    pub internal: bool,
    pub module_end: i64,
    pub scope_end: i64,
}

pub fn internal_module(module_path: []u8) -> InternalModule {
    let none = InternalModule { internal: false, module_end: 0, scope_end: 0 };
    var start = 0;
    var segment = 0;
    var index = 0;
    let length = mem::len(module_path);
    while index <= length {
        let at_end = index == length;
        let at_sep = !at_end and index + 1 < length and
            module_path[index] == cast<u8>(58) and module_path[index + 1] == cast<u8>(58);
        if at_end or at_sep {
            if segment > 0 and mem::equal_bytes(module_path[start..index], internal_segment()) {
                var module_end = index;
                if at_sep {
                    var next = index + 2;
                    while next < length and !(next + 1 < length and
                        module_path[next] == cast<u8>(58) and module_path[next + 1] == cast<u8>(58)) {
                        next = next + 1;
                    }
                    module_end = next;
                }
                return InternalModule {
                    internal: true,
                    module_end: module_end,
                    scope_end: start - 2
                };
            }
            segment = segment + 1;
            index = index + 2;
            start = index;
            continue;
        }
        index = index + 1;
    }
    return none;
}

pub fn reachable_from(module_path: []u8, from: []u8) -> bool {
    let found = internal_module(module_path);
    if !found.internal {
        return true;
    }
    let scope = module_path[0..found.scope_end];
    if mem::equal_bytes(from, scope) {
        return true;
    }
    if mem::len(from) <= mem::len(scope) {
        return false;
    }
    return mem::equal_bytes(from[0..mem::len(scope)], scope) and
        from[mem::len(scope)] == cast<u8>(58) and from[mem::len(scope) + 1] == cast<u8>(58);
}

pub fn is_std_path(module_path: []u8) -> bool {
    let root = std_root();
    if mem::equal_bytes(module_path, root) {
        return true;
    }
    let root_len = mem::len(root);
    return mem::len(module_path) > root_len + 1 and
        mem::equal_bytes(module_path[0..root_len], root) and
        module_path[root_len] == cast<u8>(58) and module_path[root_len + 1] == cast<u8>(58);
}

struct Export {
    group: arena::Handle<ModuleGroup>,
    public: bool,
}

struct ModuleGroup {
    path: string::String,
    pkg: string::String,
    files: array::Array<arena::Handle<ModuleFile>>,
    imports: map::Map<[]u8, string::String>,
}

struct ModuleFile {
    group: arena::Handle<ModuleGroup>,
    file: string::String,
    source: ?source::SourceId,
    program: ast::Program,
    imports: map::Map<[]u8, string::String>,
    namespaces: map::Map<[]u8, string::String>,
    used: map::Map<[]u8, bool>,
}

pub struct Loader {
    allocator: Allocator,
    io: Io,
    lib_dir: string::String,
    groups: arena::Arena<ModuleGroup>,
    group_by_path: map::Map<[]u8, arena::Handle<ModuleGroup>>,
    std_order: array::Array<arena::Handle<ModuleGroup>>,
    order: array::Array<arena::Handle<ModuleGroup>>,
    files: arena::Arena<ModuleFile>,
    packages: map::Map<[]u8, bool>,
    std_modules: map::Map<[]u8, bool>,
    types: map::Map<[]u8, Export>,
    functions: map::Map<[]u8, Export>,
    source_overrides: map::Map<[]u8, string::String>,
    std_graph: array::Array<Graph>,
    consts: map::Map<[]u8, ConstEntry>,
    last_source: ?source::SourceId,
    current_decl_span: ast::Span,
    pub sources: source::SourceMap,
    pub parse_diagnostics: array::Array<diagnostic::Diagnostic>,
    pub embedded_inputs: bool,
    pub std_signatures_only: bool,
    pub inputs: buildplan::InputLog,
}

pub fn new_loader(io: Io, allocator: Allocator, lib_dir: []u8) -> !Loader {
    return Loader {
        allocator: allocator,
        io: io,
        lib_dir: try string::from_bytes(allocator, lib_dir),
        groups: arena::new<ModuleGroup>(allocator),
        group_by_path: map::new<[]u8, arena::Handle<ModuleGroup>>(allocator),
        std_order: array::new<arena::Handle<ModuleGroup>>(allocator),
        order: array::new<arena::Handle<ModuleGroup>>(allocator),
        files: arena::new<ModuleFile>(allocator),
        packages: map::new<[]u8, bool>(allocator),
        std_modules: map::new<[]u8, bool>(allocator),
        types: map::new<[]u8, Export>(allocator),
        functions: map::new<[]u8, Export>(allocator),
        source_overrides: map::new<[]u8, string::String>(allocator),
        std_graph: array::new<Graph>(allocator),
        consts: map::new<[]u8, ConstEntry>(allocator),
        last_source: null,
        current_decl_span: ast::zero_span(),
        sources: source::new(allocator),
        parse_diagnostics: array::new<diagnostic::Diagnostic>(allocator),
        embedded_inputs: false,
        std_signatures_only: false,
        inputs: buildplan::new_log(allocator, false)
    };
}

pub fn (self: &var Loader) load_source(
    tree: &var ast::Ast,
    file: []u8,
    text: []u8
) -> !LoadResult {
    var files = array::new<string::String>(self.allocator);
    errdefer files.deinit(self.allocator);
    try files.append(self.allocator, try string::from_bytes(self.allocator, file));
    var modules = array::new<Module>(self.allocator);
    errdefer modules.deinit(self.allocator);
    try modules.append(self.allocator, Module {
        path: string::new(self.allocator),
        files: move files,
        test_files: array::new<string::String>(self.allocator)
    });
    let graph = Graph {
        package_name: string::new(self.allocator),
        modules: move modules,
        root: string::new(self.allocator)
    };
    defer graph.deinit(self.allocator);
    try self.override_source(file, text);
    return self.load_program_with_sources(tree, &graph, false);
}

pub fn (self: &var Loader) load_source_cached(
    tree: &var ast::Ast,
    file: []u8,
    text: []u8,
    cache: &StdCache
) -> !LoadResult {
    var files = array::new<string::String>(self.allocator);
    errdefer files.deinit(self.allocator);
    try files.append(self.allocator, try string::from_bytes(self.allocator, file));
    var modules = array::new<Module>(self.allocator);
    errdefer modules.deinit(self.allocator);
    try modules.append(self.allocator, Module {
        path: string::new(self.allocator),
        files: move files,
        test_files: array::new<string::String>(self.allocator)
    });
    let graph = Graph {
        package_name: string::new(self.allocator),
        modules: move modules,
        root: string::new(self.allocator)
    };
    defer graph.deinit(self.allocator);
    try self.override_source(file, text);
    return self.load_program_with_cache(tree, &graph, false, cache);
}

pub fn (self: &var Loader) override_source(file: []u8, text: []u8) -> !void {
    let cleaned = try path::clean(self.allocator, file);
    defer cleaned.deinit(self.allocator);
    let cleaned_bytes = cleaned.as_bytes();
    let owned = try string::from_bytes(self.allocator, text);
    if self.source_overrides.remove(self.allocator, cleaned_bytes) |previous| {
        previous.deinit(self.allocator);
    }
    return self.source_overrides.insert(self.allocator, cleaned_bytes, move owned);
}

pub fn (self: &var Loader) load_program(
    tree: &var ast::Ast,
    graph: &Graph
) -> !LoadResult {
    return self.load_program_with_sources(tree, graph, false);
}

pub fn (self: &var Loader) load_program_cached(
    tree: &var ast::Ast,
    graph: &Graph,
    cache: &StdCache
) -> !LoadResult {
    return self.load_program_with_cache(tree, graph, false, cache);
}

pub fn (self: &var Loader) load_test_program(
    tree: &var ast::Ast,
    graph: &Graph
) -> !LoadResult {
    return self.load_program_with_sources(tree, graph, true);
}

pub fn (self: &var Loader) load_test_program_cached(
    tree: &var ast::Ast,
    graph: &Graph,
    cache: &StdCache
) -> !LoadResult {
    return self.load_program_with_cache(tree, graph, true, cache);
}

pub fn (self: &var Loader) load_std_package(
    tree: &var ast::Ast,
    graph: &Graph,
    include_tests: bool
) -> !LoadResult {
    try self.remember_std_modules(graph);
    if try self.load_package(tree, graph, include_tests, true) |failed| {
        return LoadResult::Error(move failed);
    }
    if try self.collect_types(tree) |failed| {
        return LoadResult::Error(move failed);
    }
    if try self.collect_functions(tree) |failed| {
        return LoadResult::Error(move failed);
    }
    return self.program(tree);
}

fn (self: &var Loader) load_program_with_sources(
    tree: &var ast::Ast,
    graph: &Graph,
    include_tests: bool
) -> !LoadResult {
    if try self.load_package(tree, graph, include_tests, false) |failed| {
        return LoadResult::Error(move failed);
    }
    if try self.load_std(tree) |failed| {
        return LoadResult::Error(move failed);
    }
    if try self.collect_types(tree) |failed| {
        return LoadResult::Error(move failed);
    }
    if try self.collect_functions(tree) |failed| {
        return LoadResult::Error(move failed);
    }
    return self.program(tree);
}

fn (self: &var Loader) load_program_with_cache(
    tree: &var ast::Ast,
    graph: &Graph,
    include_tests: bool,
    cache: &StdCache
) -> !LoadResult {
    if try self.load_package(tree, graph, include_tests, false) |failed| {
        return LoadResult::Error(move failed);
    }
    if try self.load_std_cached(tree, cache) |failed| {
        return LoadResult::Error(move failed);
    }
    if try self.collect_types(tree) |failed| {
        return LoadResult::Error(move failed);
    }
    if try self.collect_functions(tree) |failed| {
        return LoadResult::Error(move failed);
    }
    return self.program(tree);
}

fn (self: &var Loader) load_package(
    tree: &var ast::Ast,
    graph: &Graph,
    include_tests: bool,
    std: bool
) -> !?diagnostic::Diagnostic {
    let allocator = self.allocator;
    if graph.package_name.len() > 0 {
        let package_name = graph.package_name.as_bytes();
        try self.packages.insert(allocator, package_name, true);
    }
    var index = 0;
    while graph.modules.at(index) |module| {
        index = index + 1;
        let files = try module.source_files(allocator, include_tests);
        defer files.deinit(allocator);
        if files.len() == 0 {
            continue;
        }
        var path = try copy_string(allocator, &module.path);
        errdefer path.deinit(allocator);
        let group = try self.groups.add(allocator, ModuleGroup {
            path: move path,
            pkg: try copy_string(allocator, &graph.package_name),
            files: array::new<arena::Handle<ModuleFile>>(allocator),
            imports: map::new<[]u8, string::String>(allocator)
        });
        var file_index = 0;
        let skip_bodies = std and self.std_signatures_only and !tree.locate_names;
        while files.at(file_index) |file| {
            file_index = file_index + 1;
            let file_bytes = file.as_bytes();
            let root = graph.root.as_bytes();
            let outcome_1 = try self.parse_module_file(tree, file_bytes, root, skip_bodies);
            match outcome_1 {
                Program(program) => {
                    errdefer program.deinit(allocator);
                    let file_copy = try copy_string(allocator, file);
                    let handle = try self.files.add(allocator, ModuleFile {
                        group: group,
                        file: move file_copy,
                        source: self.last_source,
                        program: move program,
                        imports: map::new<[]u8, string::String>(allocator),
                        namespaces: map::new<[]u8, string::String>(allocator),
                        used: map::new<[]u8, bool>(allocator)
                    });
                    if self.groups.at_mut(group) |entry| {
                        try entry.files.append(allocator, handle);
                    }
                },
                Error(failed) => return move failed,
            }
        }
        let module_path = module.path.as_bytes();
        try self.group_by_path.insert(allocator, module_path, group);
        if std {
            try self.std_order.append(allocator, group);
        } else {
            try self.order.append(allocator, group);
        }
    }
    return null;
}

fn (self: &var Loader) parse_module_file(
    tree: &var ast::Ast,
    file: []u8,
    root: []u8,
    skip_bodies: bool
) -> !LoadResult {
    let cleaned = try path::clean(self.allocator, file);
    defer cleaned.deinit(self.allocator);
    let cleaned_bytes = cleaned.as_bytes();
    if self.source_overrides.at(cleaned_bytes) |text| {
        let copied = try copy_string(self.allocator, text);
        return self.parse_module_source(tree, file, move copied, root, skip_bodies);
    }
    let text = try fs::read_file(self.io, self.allocator, file, mem::Limit::Unlimited);
    errdefer text.deinit(self.allocator);
    try self.inputs.add_text(self.allocator, file, &text);
    return self.parse_module_source(tree, file, move text, root, skip_bodies);
}

fn (self: &var Loader) parse_module_source(
    tree: &var ast::Ast,
    file: []u8,
    text: string::String,
    root: []u8,
    skip_bodies: bool
) -> !LoadResult {
    errdefer text.deinit(self.allocator);
    let path_copy = try string::from_bytes(self.allocator, file);
    let id = try self.sources.add(move path_copy, move text);
    self.last_source = id;
    if self.sources.at(id) |input| {
        let bytes = input.text.as_bytes();
        let scanner = lexer::new_source(self.allocator, id, bytes);
        var source_parser = try parser::new(self.allocator, move scanner);
        defer source_parser.deinit(self.allocator);
        source_parser.skip_non_generic_bodies = skip_bodies;
        var program = try source_parser.parse_program(tree);
        errdefer program.deinit(self.allocator);
        if source_parser.diagnostic(0) |first| {
            let copied = try first.clone(self.allocator);
            if !tree.locate_names {
                program.deinit(self.allocator);
                return LoadResult::Error(move copied);
            }
            try self.parse_diagnostics.append(self.allocator, move copied);
        }
        var embed_index = 0;
        while source_parser.embeds.at(embed_index) |embed| {
            embed_index = embed_index + 1;
            if try self.embed_file(tree, embed.*, root) |failed| {
                program.deinit(self.allocator);
                return LoadResult::Error(move failed);
            }
        }
        return LoadResult::Program(move program);
    }
    return LoadResult::Program(ast::new_program(self.allocator));
}

fn (self: &var Loader) embed_file(
    tree: &var ast::Ast,
    expression: ast::Expression,
    root: []u8
) -> !?diagnostic::Diagnostic {
    let embed = embedded_file(tree, expression) orelse return null;
    self.embedded_inputs = true;
    let span = tree.spans.at(embed.span).*;
    let path_text = try copy_string(self.allocator, tree.texts.at(embed.path.node));
    defer path_text.deinit(self.allocator);
    let path_bytes = path_text.as_bytes();
    if mem::len(root) == 0 {
        return try self.embed_error(path_bytes, span,
            "module error: @embed_file(", ") needs a package: the path is relative to its kizu.toml");
    }
    if mem::len(path_bytes) > 0 and path_bytes[0] == cast<u8>(47) {
        return try self.embed_error(path_bytes, span,
            "module error: @embed_file path ", " is absolute; write it relative to kizu.toml");
    }
    let joined = try path::join(self.allocator, root, path_bytes);
    defer joined.deinit(self.allocator);
    let joined_bytes = joined.as_bytes();
    if fs::read_file(self.io, self.allocator, joined_bytes, mem::Limit::Unlimited) |data| {
        errdefer data.deinit(self.allocator);
        try self.inputs.add_text(self.allocator, joined_bytes, &data);
        let value = try tree.add_text(move data);
        if tree.expressions.at_mut(expression.node) |node| {
            node.* = ast::ExpressionNode::String(ast::StringExpr { value: value, embed: embed });
        }
        return null;
    } else |err| {
        match err {
            _ => return try self.embed_error(path_bytes, span,
                "module error: @embed_file cannot read ", ""),
        }
    }
}

fn embedded_file(tree: &ast::Ast, expression: ast::Expression) -> ?ast::EmbedFile {
    match tree.expressions.at(expression.node) {
        String(value) => return value.embed,
        _ => return null,
    }
}

fn (self: &Loader) embed_error(
    path_bytes: []u8,
    span: ast::Span,
    prefix: []u8,
    suffix: []u8
) -> !?diagnostic::Diagnostic {
    var text = string::new(self.allocator);
    defer text.deinit(self.allocator);
    try text.append_bytes(self.allocator, prefix);
    try fmt::append_bytes_literal(self.allocator, &var text, path_bytes);
    try text.append_bytes(self.allocator, suffix);
    let bytes = text.as_bytes();
    return try diagnostic::from_text(self.allocator, diagnostic::Severity::Error, span, bytes);
}
