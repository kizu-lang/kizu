import compiler::internal::ir;
import std::array;
import std::map;

pub fn clone_function(allocator: Allocator, source: &MFunction) -> !MFunction {
    var copy = new_function(allocator);
    errdefer copy.deinit(allocator);
    var index = 0;
    while source.blocks.at(index) |block| {
        index = index + 1;
        var insts = array::new<MInst>(allocator);
        errdefer insts.deinit(allocator);
        var inst_index = 0;
        while block.insts.get(inst_index) |inst| {
            inst_index = inst_index + 1;
            try insts.append(allocator, inst);
        }
        try copy.blocks.append(allocator, MBlock {
            insts: move insts,
            term: block.term,
            cond: block.cond,
            treg: block.treg,
            succ0: block.succ0,
            succ1: block.succ1,
            cold: block.cold
        });
    }
    index = 0;
    while source.copies.get(index) |item| {
        index = index + 1;
        try copy.copies.append(allocator, item);
    }
    index = 0;
    while source.slots.get(index) |slot| {
        index = index + 1;
        try copy.slots.append(allocator, slot);
    }
    copy.vregs = source.vregs;
    copy.out_words = source.out_words;
    copy.calls = source.calls;
    copy.is_main = source.is_main;
    return move copy;
}

fn inlinable(func: &MFunction) -> bool {
    if func.is_main {
        return false;
    }
    var size = 0;
    var hot_blocks = 0;
    var reads_stack_args = false;
    var touches_out_words = false;
    var index = 0;
    while func.blocks.at(index) |block| {
        index = index + 1;
        let fails = block.fails();
        if !fails {
            hot_blocks = hot_blocks + 1;
        }
        var inst_index = 0;
        while block.insts.at(inst_index) |inst| {
            inst_index = inst_index + 1;
            if inst.rn == reg_inarg() {
                reads_stack_args = true;
            }
            if fails {
                continue;
            }
            if inst.op == MOp::Call or inst.op == MOp::CallReg {
                return false;
            }
            if inst.rn == reg_sp() {
                touches_out_words = true;
            }
            size = size + 1;
        }
    }
    if reads_stack_args and touches_out_words {
        return false;
    }
    return size <= inline_size() and hot_blocks <= inline_blocks() and func.blocks.len() <= 2 * inline_blocks();
}

fn inline_size() -> i64 {
    return 400;
}

fn inline_blocks() -> i64 {
    return 64;
}

fn inline_sites() -> i64 {
    return 64;
}

pub struct Inliner {
    by_symbol: map::Map<i64, i64>,
    bodies: array::Array<MFunction>,
}

pub fn new_inliner(allocator: Allocator) -> Inliner {
    return Inliner { by_symbol: map::new<i64, i64>(allocator), bodies: array::new<MFunction>(allocator) };
}

pub fn (self: Inliner) deinit(allocator: Allocator) -> void {
    self.by_symbol.deinit(allocator);
    self.bodies.deinit(allocator);
}

pub fn (self: &var Inliner) remember(allocator: Allocator, func: &MFunction, symbol: ir::Name) -> !void {
    if !inlinable(func) {
        return;
    }
    var body = try clone_function(allocator, func);
    errdefer body.deinit(allocator);
    try self.by_symbol.insert(allocator, ir::name_id(symbol), self.bodies.len());
    try self.bodies.append(allocator, move body);
    return;
}

pub fn callee_first(allocator: Allocator, module: &ir::Module, selector: &Selector) -> !array::Array<i64> {
    var starts = array::new<i64>(allocator);
    defer starts.deinit(allocator);
    var edges = array::new<i64>(allocator);
    defer edges.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        try starts.append(allocator, edges.len());
        let node = module.function_nodes.at(function.node);
        var block_index = 0;
        while node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let instr_node = module.instrs.at(instr.node);
                if instr_node.op == ir::Op::Call {
                    try add_edge(allocator, &var edges, selector.callee_index(instr_node.operand));
                }
                var cleanup_index = 0;
                while instr_node.cleanups.at(cleanup_index) |cleanup| {
                    cleanup_index = cleanup_index + 1;
                    if cleanup.op == ir::Op::Call {
                        try add_edge(allocator, &var edges, selector.callee_index(cleanup.operand));
                    }
                }
            }
        }
    }
    try starts.append(allocator, edges.len());
    var order = array::new<i64>(allocator);
    errdefer order.deinit(allocator);
    var seen = array::new<bool>(allocator);
    defer seen.deinit(allocator);
    for 0..module.functions.len() |_f| {
        try seen.append(allocator, false);
    }
    var stack = array::new<i64>(allocator);
    defer stack.deinit(allocator);
    var next = array::new<i64>(allocator);
    defer next.deinit(allocator);
    for 0..module.functions.len() |root| {
        if seen.get_or_panic(root) {
            continue;
        }
        try seen.set(root, true);
        try stack.append(allocator, root);
        try next.append(allocator, starts.get_or_panic(root));
        while stack.len() > 0 {
            let top = stack.len() - 1;
            let f = stack.get_or_panic(top);
            let edge = next.get_or_panic(top);
            if edge < starts.get_or_panic(f + 1) {
                try next.set(top, edge + 1);
                let target = edges.get_or_panic(edge);
                if !seen.get_or_panic(target) {
                    try seen.set(target, true);
                    try stack.append(allocator, target);
                    try next.append(allocator, starts.get_or_panic(target));
                }
                continue;
            }
            try order.append(allocator, f);
            try stack.truncate(allocator, top);
            try next.truncate(allocator, top);
        }
    }
    return move order;
}

fn add_edge(allocator: Allocator, edges: &var array::Array<i64>, target: i64) -> !void {
    if target >= 0 {
        try edges.append(allocator, target);
    }
    return;
}

pub fn (self: &Inliner) inline_into(allocator: Allocator, func: &var MFunction, symbol: ir::Name) -> !void {
    let own = ir::name_id(symbol);
    var budget = inline_sites();
    while budget > 0 {
        var found_block = 0 - 1;
        var found_inst = 0 - 1;
        var callee = 0 - 1;
        var block_id = 0;
        while func.blocks.at(block_id) |block| {
            var inst_index = 0;
            while block.insts.at(inst_index) |inst| {
                if inst.op == MOp::Call and found_block < 0 and ir::name_id(inst.sym) != own {
                    if self.by_symbol.get(ir::name_id(inst.sym)) |target| {
                        found_block = block_id;
                        found_inst = inst_index;
                        callee = target;
                    }
                }
                inst_index = inst_index + 1;
            }
            block_id = block_id + 1;
        }
        if callee < 0 {
            break;
        }
        budget = budget - 1;
        if self.bodies.at(callee) |source| {
            let body = try clone_function(allocator, source);
            defer body.deinit(allocator);
            try splice(allocator, func, found_block, found_inst, &body);
        }
    }
    return;
}

fn splice(allocator: Allocator, func: &var MFunction, block: i64, at: i64, callee: &MFunction) -> !void {
    let vreg_base = func.vregs;
    let slot_base = func.slots.len();
    let copy_base = func.copies.len();
    let block_base = func.blocks.len();
    var rest = array::new<MInst>(allocator);
    errdefer rest.deinit(allocator);
    var term = Term::Open;
    var cond = Cond::Eq;
    var treg = reg_none();
    var succ0 = 0 - 1;
    var succ1 = 0 - 1;
    var cold = false;
    if func.blocks.at_mut(block) |node| {
        var index = at + 1;
        while node.insts.get(index) |inst| {
            index = index + 1;
            try rest.append(allocator, inst);
        }
        try node.insts.truncate(allocator, at);
        term = node.term;
        cond = node.cond;
        treg = node.treg;
        succ0 = node.succ0;
        succ1 = node.succ1;
        cold = node.cold;
        node.term = Term::Jump;
        node.succ0 = block_base;
        node.succ1 = 0 - 1;
        node.treg = reg_none();
    }
    let continuation = block_base + callee.blocks.len();
    var index = 0;
    while callee.blocks.at(index) |source| {
        index = index + 1;
        var insts = array::new<MInst>(allocator);
        errdefer insts.deinit(allocator);
        var inst_index = 0;
        while source.insts.get(inst_index) |inst| {
            inst_index = inst_index + 1;
            try insts.append(allocator, renumber(inst, vreg_base, slot_base, copy_base));
        }
        var block_term = source.term;
        var block_succ0 = shift_block(source.succ0, block_base);
        var block_succ1 = shift_block(source.succ1, block_base);
        if block_term == Term::Return {
            block_term = Term::Jump;
            block_succ0 = continuation;
            block_succ1 = 0 - 1;
        }
        try func.blocks.append(allocator, MBlock {
            insts: move insts,
            term: block_term,
            cond: source.cond,
            treg: shift_reg(source.treg, vreg_base),
            succ0: block_succ0,
            succ1: block_succ1,
            cold: source.cold or cold
        });
    }
    try func.blocks.append(allocator, MBlock {
        insts: move rest,
        term: term,
        cond: cond,
        treg: treg,
        succ0: succ0,
        succ1: succ1,
        cold: cold
    });
    index = 0;
    while callee.copies.get(index) |item| {
        index = index + 1;
        var moved = item;
        moved.dst = shift_reg(item.dst, vreg_base);
        if !item.src_imm {
            moved.src = shift_reg(item.src, vreg_base);
        }
        try func.copies.append(allocator, moved);
    }
    index = 0;
    while callee.slots.get(index) |slot| {
        index = index + 1;
        try func.slots.append(allocator, slot);
    }
    func.vregs = func.vregs + callee.vregs;
    if callee.out_words > func.out_words {
        func.out_words = callee.out_words;
    }
    try untie_seams(allocator, func, block, block_base, continuation);
    var calls = false;
    index = 0;
    while func.blocks.at(index) |node| {
        index = index + 1;
        var inst_index = 0;
        while node.insts.at(inst_index) |inst| {
            inst_index = inst_index + 1;
            if inst.op == MOp::Call or inst.op == MOp::CallReg {
                calls = true;
            }
        }
    }
    func.calls = calls;
    return;
}

fn shift_reg(reg: i64, base: i64) -> i64 {
    if is_vreg(reg) {
        return reg + base;
    }
    return reg;
}

fn shift_block(block: i64, base: i64) -> i64 {
    if block < 0 {
        return block;
    }
    return block + base;
}

fn renumber(inst: MInst, vreg_base: i64, slot_base: i64, copy_base: i64) -> MInst {
    var out = inst;
    out.rd = shift_reg(inst.rd, vreg_base);
    out.rn = shift_reg(inst.rn, vreg_base);
    out.rm = shift_reg(inst.rm, vreg_base);
    out.ra = shift_reg(inst.ra, vreg_base);
    if inst.rn == reg_inarg() {
        out.rn = reg_sp();
    }
    if inst.slot >= 0 and (inst.op == MOp::FrameAddr or inst.rn == reg_frame()) {
        out.slot = inst.slot + slot_base;
    }
    if inst.op == MOp::ParCopy {
        out.slot = inst.slot + copy_base;
    }
    return out;
}

fn untie_seams(allocator: Allocator, func: &var MFunction, caller: i64, first: i64, continuation: i64) -> !void {
    var buf = array::new<i64>(allocator);
    defer buf.deinit(allocator);
    var reads_mask = 0;
    var writes_mask = 0;
    var late_mask = 0;
    var pinned_mask = 0;
    var block_id = first;
    while block_id < continuation {
        if func.blocks.at(block_id) |block| {
            if block.fails() {
                var inst_index = 0;
                while block.insts.at(inst_index) |inst| {
                    inst_index = inst_index + 1;
                    try reads(inst, &var buf, allocator, &func.copies);
                    pinned_mask = pinned_mask | seam_mask(&buf);
                }
                if block.treg >= 0 and block.treg < 9 {
                    pinned_mask = pinned_mask | (1 << block.treg);
                }
                block_id = block_id + 1;
                continue;
            }
            var inst_index = 0;
            while block.insts.at(inst_index) |inst| {
                inst_index = inst_index + 1;
                try reads(inst, &var buf, allocator, &func.copies);
                let read_now = seam_mask(&buf);
                if block_id != first {
                    late_mask = late_mask | read_now;
                } else {
                    late_mask = late_mask | (read_now & writes_mask);
                }
                reads_mask = reads_mask | read_now;
                if inst.op == MOp::ParCopy {
                    var index = 0;
                    while index < inst.imm {
                        let copy = func.copies.get_or_panic(inst.slot + index);
                        index = index + 1;
                        if copy.dst >= 0 and copy.dst < 9 {
                            writes_mask = writes_mask | (1 << copy.dst);
                        }
                    }
                } else if writes_rd(inst.op) and inst.rd >= 0 and inst.rd < 9 {
                    writes_mask = writes_mask | (1 << inst.rd);
                }
            }
            if block.treg >= 0 and block.treg < 9 {
                reads_mask = reads_mask | (1 << block.treg);
                late_mask = late_mask | (1 << block.treg);
            }
        }
        block_id = block_id + 1;
    }
    var def_at = array::new<i64>(allocator);
    defer def_at.deinit(allocator);
    var after_reads = array::new<i64>(allocator);
    defer after_reads.deinit(allocator);
    for 0..9 |_r| {
        try def_at.append(allocator, 0 - 1);
    }
    if func.blocks.at(caller) |block| {
        var index = block.insts.len() - 1;
        while index >= 0 {
            let inst = block.insts.get_or_panic(index);
            if inst.op == MOp::ParCopy or inst.op == MOp::Call or inst.op == MOp::CallReg {
                break;
            }
            try reads(&inst, &var buf, allocator, &func.copies);
            if seam_mask(&buf) != 0 {
                break;
            }
            if writes_rd(inst.op) and inst.rd >= 0 and inst.rd < 9 and def_at.get_or_panic(inst.rd) < 0 {
                try def_at.set(inst.rd, index);
            }
            index = index - 1;
        }
    }
    var settled = 0;
    var open = writes_mask;
    if func.blocks.at(continuation) |block| {
        var index = 0;
        var stopped = false;
        while block.insts.at(index) |inst| {
            if inst.op == MOp::ParCopy and parcopy_touches(&func.copies, inst, open) {
                stopped = true;
                break;
            }
            try reads(inst, &var buf, allocator, &func.copies);
            var read_index = 0;
            while buf.get(read_index) |reg| {
                read_index = read_index + 1;
                if reg >= 0 and reg < 9 and (open & (1 << reg)) != 0 {
                    try after_reads.append(allocator, index);
                }
            }
            if inst.op == MOp::Call or inst.op == MOp::CallReg {
                settled = settled | open;
                open = 0;
                break;
            }
            if writes_rd(inst.op) and inst.rd >= 0 and inst.rd < 9 and (open & (1 << inst.rd)) != 0 {
                settled = settled | (1 << inst.rd);
                open = open & ~(1 << inst.rd);
            }
            index = index + 1;
        }
        if !stopped and block.term != Term::Return and !(block.treg >= 0 and block.treg < 9) {
            settled = settled | open;
        }
    }
    var kept = 0;
    for 0..9 |r| {
        let bit = 1 << r;
        var keeps = (reads_mask & bit) != 0 and def_at.get_or_panic(r) < 0;
        keeps = keeps or ((writes_mask & bit) != 0 and (settled & bit) == 0);
        keeps = keeps or ((late_mask & bit) != 0 and (writes_mask & bit) != 0);
        keeps = keeps or (pinned_mask & bit) != 0;
        if keeps {
            kept = kept | bit;
        }
    }
    if (kept & reads_mask) != 0 {
        kept = kept | reads_mask;
    }
    if (kept & writes_mask) != 0 {
        kept = kept | writes_mask;
    }
    for 0..9 |r| {
        let bit = 1 << r;
        if (reads_mask & bit) == 0 and (writes_mask & bit) == 0 {
            continue;
        }
        if (kept & bit) != 0 {
            continue;
        }
        let fresh = func.new_vreg();
        var result = fresh;
        if (reads_mask & bit) != 0 and (writes_mask & bit) != 0 {
            result = func.new_vreg();
        }
        if (reads_mask & bit) != 0 {
            if func.blocks.at_mut(caller) |block| {
                let at = def_at.get_or_panic(r);
                var inst = block.insts.get_or_panic(at);
                inst.rd = fresh;
                try block.insts.set(at, inst);
            }
        }
        block_id = first;
        while block_id < continuation {
            var renames = true;
            if func.blocks.at(block_id) |block| {
                renames = !block.fails();
            }
            if renames {
                try rename_in_block(allocator, func, block_id, r, fresh, result);
            }
            block_id = block_id + 1;
        }
        if (writes_mask & bit) != 0 {
            if func.blocks.at_mut(continuation) |block| {
                var index = 0;
                while after_reads.get(index) |at| {
                    index = index + 1;
                    var inst = block.insts.get_or_panic(at);
                    if (inst.op == MOp::Store or inst.op == MOp::StoreIdx) and inst.rd == r {
                        inst.rd = result;
                    }
                    if inst.rn == r {
                        inst.rn = result;
                    }
                    if inst.rm == r {
                        inst.rm = result;
                    }
                    if inst.ra == r {
                        inst.ra = result;
                    }
                    try block.insts.set(at, inst);
                }
            }
        }
    }
    return;
}

fn seam_mask(regs: &array::Array<i64>) -> i64 {
    var mask = 0;
    var index = 0;
    while regs.get(index) |reg| {
        index = index + 1;
        if reg >= 0 and reg < 9 {
            mask = mask | (1 << reg);
        }
    }
    return mask;
}

fn rename_in_block(allocator: Allocator, func: &var MFunction, block_id: i64, from: i64, read_as: i64, write_as: i64) -> !void {
    var copy_slots = array::new<i64>(allocator);
    defer copy_slots.deinit(allocator);
    if func.blocks.at_mut(block_id) |block| {
        var index = 0;
        while index < block.insts.len() {
            var inst = block.insts.get_or_panic(index);
            let stores = inst.op == MOp::Store or inst.op == MOp::StoreIdx;
            if inst.rd == from {
                if stores {
                    inst.rd = read_as;
                } else {
                    inst.rd = write_as;
                }
            }
            if inst.rn == from {
                inst.rn = read_as;
            }
            if inst.rm == from {
                inst.rm = read_as;
            }
            if inst.ra == from {
                inst.ra = read_as;
            }
            try block.insts.set(index, inst);
            if inst.op == MOp::ParCopy {
                for 0..inst.imm |offset| {
                    try copy_slots.append(allocator, inst.slot + offset);
                }
            }
            index = index + 1;
        }
        if block.treg == from {
            block.treg = read_as;
        }
    }
    var index = 0;
    while copy_slots.get(index) |slot| {
        index = index + 1;
        var copy = func.copies.get_or_panic(slot);
        if copy.dst == from {
            copy.dst = write_as;
        }
        if !copy.src_imm and copy.src == from {
            copy.src = read_as;
        }
        try func.copies.set(slot, copy);
    }
    return;
}

fn parcopy_touches(copies: &array::Array<Copy>, inst: &MInst, mask: i64) -> bool {
    var index = 0;
    while index < inst.imm {
        let copy = copies.get_or_panic(inst.slot + index);
        index = index + 1;
        if copy.dst >= 0 and copy.dst < 9 and (mask & (1 << copy.dst)) != 0 {
            return true;
        }
        if !copy.src_imm and copy.src >= 0 and copy.src < 9 and (mask & (1 << copy.src)) != 0 {
            return true;
        }
    }
    return false;
}
