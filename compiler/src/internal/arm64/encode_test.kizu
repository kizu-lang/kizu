import std::testing;

test "encode unscaled loads and stores" {
    testing::expect_equal<i64>(0xF85F8041, enc_mem(true, 8, false, true, 1, 2, 0 - 8));
    testing::expect_equal<i64>(0xB85FC041, enc_mem(true, 4, false, true, 1, 2, 0 - 4));
    testing::expect_equal<i64>(0xB89FC041, enc_mem(true, 4, true, true, 1, 2, 0 - 4));
    testing::expect_equal<i64>(0x78803041, enc_mem(true, 2, true, true, 1, 2, 3));
    testing::expect_equal<i64>(0x389FF041, enc_mem(true, 1, true, true, 1, 2, 0 - 1));
    testing::expect_equal<i64>(0x785FE041, enc_mem(true, 2, false, true, 1, 2, 0 - 2));
    testing::expect_equal<i64>(0x38501041, enc_mem(true, 1, false, true, 1, 2, 0 - 255));
    testing::expect_equal<i64>(0x380FF041, enc_mem(false, 1, false, true, 1, 2, 255));
    testing::expect_equal<i64>(0 - 1, enc_mem(true, 8, false, true, 1, 2, 256));
}

test "encode immediates the assembler rewrites" {
    testing::expect_equal<i64>(0xB13FFC7F, enc_add_imm(false, true, reg_zr(), 3, 4095));
    testing::expect_equal<i64>(0xF140047F, enc_add_imm(true, true, reg_zr(), 3, 4096));
    testing::expect_equal<i64>(0xD1001CC5, enc_rri("add", 5, 6, 0 - 7));
    testing::expect_equal<i64>(0 - 1, enc_add_imm(false, false, 1, 2, 4097));
    testing::expect_equal<i64>(0xEB2463FF, 0xEB20601F | (field(4) << 16) | (field(reg_sp()) << 5));
}

test "encode bitmask immediates" {
    testing::expect_equal<i64>(0x9200F041, enc_rri("and", 1, 2, 0x5555555555555555));
    testing::expect_equal<i64>(0x927FF841, enc_rri("and", 1, 2, 0 - 2));
    testing::expect_equal<i64>(0x9240F841, enc_rri("and", 1, 2, 0x7FFFFFFFFFFFFFFF));
    testing::expect_equal<i64>(0xF2781C3F, enc_logical_imm(0xF2000000, reg_zr(), 1, 0xFF00));
    testing::expect_equal<i64>(0 - 1, bitmask_fields(0));
    testing::expect_equal<i64>(0 - 1, bitmask_fields(0 - 1));
    testing::expect_equal<i64>(0 - 1, bitmask_fields(5));
}

test "encode moves and shifts" {
    testing::expect_equal<i64>(0x910003BF, enc_rr("mov", reg_sp(), 29));
    testing::expect_equal<i64>(0x910003FD, enc_rr("mov", 29, reg_sp()));
    testing::expect_equal<i64>(0x92800001, enc_move_wide(movn(), 1, 0, 0));
    testing::expect_equal<i64>(0xF2F7DDE1, enc_move_wide(movk(), 1, 0xBEEF, 48));
    testing::expect_equal<i64>(0xD340FC41, enc_rri("lsl", 1, 2, 0));
    testing::expect_equal<i64>(0xD3410041, enc_rri("lsl", 1, 2, 63));
    testing::expect_equal<i64>(0xA91FD3F3, enc_pair(false, 19, 20, reg_sp(), 504));
}

test "encode lane inserts" {
    testing::expect_equal<i64>(0x4E181C83, 0x4E001C00 | (lane_imm5(8, 1) << 16) | (4 << 5) | 3);
    testing::expect_equal<i64>(0x4E1F1C83, 0x4E001C00 | (lane_imm5(1, 15) << 16) | (4 << 5) | 3);
}

test "encode float registers" {
    testing::expect_equal<i64>(0xFC5F8056, enc_mem(true, 8, false, true, 54, 2, 0 - 8));
    testing::expect_equal<i64>(0xFC1F8056, enc_mem(false, 8, false, true, 54, 2, 0 - 8));
    testing::expect_equal<i64>(0xBC5FC056, enc_mem(true, 4, false, true, 54, 2, 0 - 4));
    testing::expect_equal<i64>(0xBC0FF056, enc_mem(false, 4, false, true, 54, 2, 255));
    testing::expect_equal<i64>(0xBD7FFC56, enc_mem(true, 4, false, false, 54, 2, 16380));
    testing::expect_equal<i64>(0xFC637856, enc_mem_indexed(true, 8, false, 54, 2, 3, true));
    testing::expect_equal<i64>(0xBC236856, enc_mem_indexed(false, 4, false, 54, 2, 3, false));
    testing::expect_equal<i64>(0 - 1, enc_mem(true, 4, true, false, 54, 2, 0));
    testing::expect_equal<i64>(0x6D1FBFEE, enc_pair(false, 46, 47, reg_sp(), 504));
    testing::expect_equal<i64>(0x6D4127E8, enc_pair(true, 40, 41, reg_sp(), 16));
    testing::expect_equal<i64>(0 - 1, enc_pair(false, 19, 40, reg_sp(), 0));
    testing::expect_equal<i64>(0x1E6042F6, enc_rr("fmov", 54, 55));
    testing::expect_equal<i64>(0x1E2042F6, enc_fmov_float(4, 22, 23));
    testing::expect_equal<i64>(0x9E670216, enc_rr("fmov", 54, 16));
    testing::expect_equal<i64>(0x9E6602C1, enc_rr("fmov", 1, 54));
    testing::expect_equal<i64>(0x9E6703F6, enc_rr("fmov", 54, reg_zr()));
    testing::expect_equal<i64>(0x1E78BEF6, enc_fcsel(8, 22, 23, 24, Cond::Lt));
    testing::expect_equal<i64>(0x1E721E30, enc_fcsel(8, 16, 17, 18, Cond::Ne));
}

test "encode float lanes" {
    testing::expect_equal<i64>(0x4E63D441, enc_vfloat(float_add(), 1, 2, 3));
    testing::expect_equal<i64>(0x4EE3D441, enc_vfloat(float_sub(), 1, 2, 3));
    testing::expect_equal<i64>(0x6E63DC41, enc_vfloat(float_mul(), 1, 2, 3));
    testing::expect_equal<i64>(0x6E63FC41, enc_vfloat(float_div(), 1, 2, 3));
    testing::expect_equal<i64>(0x4E71D41F, enc_vfloat(float_add(), 31, 0, 17));
    testing::expect_equal<i64>(0x1E71281F, enc_float(float_add(), 8, 31, 0, 17));
    testing::expect_equal<i64>(0x1E631841, enc_float(float_div(), 8, 1, 2, 3));
    testing::expect_equal<i64>(0x4E61D841, enc_vscvtf(1, 2));
    testing::expect_equal<i64>(0x4E61DA1F, enc_vscvtf(31, 16));
    testing::expect_equal<i64>(0x5E180425, enc_dup_lane(8, 5, 1, 1));
    testing::expect_equal<i64>(0x5E18061F, enc_dup_lane(8, 31, 16, 1));
    testing::expect_equal<i64>(0x5E080425, enc_dup_lane(8, 5, 1, 0));
}
