import compiler::internal::ir;
import std::array;
import std::mem;
import std::string;

// The x86-64 encoder: the machine code of each instruction the amd64
// printer hands it, named by its AT&T mnemonic, into the object (obj.kizu),
// byte for byte as the system assembler (LLVM's) encodes the same line of
// assembly. Where a line has more than one encoding
// the assembler's choice is taken: the register-to-register form that
// names the source in ModRM.reg (89, 01, 29, ...), the shortest
// displacement, an 8-bit immediate where it fits, rax's own form of an
// arithmetic immediate that does not, the one-operand form of a shift by 1.
// A jump is written short and made near when the function ends, where its
// target is out of a byte's reach (relax_jumps). A line no encoding here
// holds is recorded as the object's failure, which stops the build.

/// Is one instruction to encode: an optional legacy prefix, REX.W, one to
/// three opcode bytes, ModRM.reg (a register 0..15 or an opcode
/// extension), the r/m operand -- a register or a memory operand -- and an
/// immediate.
struct X86 {
    prefix: i64,
    w: bool,
    opcode: i64,
    length: i64,
    reg: i64,
    // reg or rm names a byte register: spl, bpl, sil and dil need a REX.
    reg_byte: bool,
    rm_byte: bool,
    // 0 a register, 1 memory.
    kind: i64,
    // The register, or the memory operand's base (-1 none).
    rm: i64,
    index: i64,
    shift: i64,
    disp: i64,
    imm: i64,
    imm_size: i64,
}

/// Is a memory operand as the printer resolved it: base and index the
/// backend's register numbers (-1 none), the index scaled by 1 << shift.
struct Mem {
    base: i64,
    index: i64,
    shift: i64,
    disp: i64,
}

// The relocation kinds of x86-64 ELF the encoder records, beside
// reloc_unsigned (obj.kizu), which is R_X86_64_64 there.
fn reloc_x86_pc32() -> i64 { return 20; }

fn reloc_x86_plt32() -> i64 { return 21; }

fn reloc_x86_gotpcrelx() -> i64 { return 22; }

/// Returns an instruction of opcode, length bytes long, with no operand.
fn x86_op(opcode: i64, length: i64) -> X86 {
    return X86 {
        prefix: 0,
        w: false,
        opcode: opcode,
        length: length,
        reg: 0,
        reg_byte: false,
        rm_byte: false,
        kind: 0 - 1,
        rm: 0 - 1,
        index: 0 - 1,
        shift: 0,
        disp: 0,
        imm: 0,
        imm_size: 0
    };
}

/// Returns an instruction whose r/m is the register rm.
fn x86_reg_form(opcode: i64, length: i64, w: bool, reg: i64, rm: i64) -> X86 {
    var inst = x86_op(opcode, length);
    inst.w = w;
    inst.reg = reg;
    inst.kind = 0;
    inst.rm = rm;
    return inst;
}

/// Returns an instruction whose r/m is memory, its registers numbered as
/// the machine numbers them.
fn x86_mem_form(opcode: i64, length: i64, w: bool, reg: i64, base: i64, index: i64, shift: i64, disp: i64) -> X86 {
    var inst = x86_op(opcode, length);
    inst.w = w;
    inst.reg = reg;
    inst.kind = 1;
    inst.rm = base;
    inst.index = index;
    inst.shift = shift;
    inst.disp = disp;
    return inst;
}

fn fits_i8(value: i64) -> bool {
    return value >= 0 - 128 and value <= 127;
}

/// Returns the condition code of a jcc, setcc or cmovcc suffix, or -1.
fn x86_cc_code(suffix: []u8) -> i64 {
    if mem::equal_bytes(suffix, "o") { return 0; }
    if mem::equal_bytes(suffix, "no") { return 1; }
    if mem::equal_bytes(suffix, "b") or mem::equal_bytes(suffix, "c") { return 2; }
    if mem::equal_bytes(suffix, "ae") or mem::equal_bytes(suffix, "nc") { return 3; }
    if mem::equal_bytes(suffix, "e") { return 4; }
    if mem::equal_bytes(suffix, "ne") { return 5; }
    if mem::equal_bytes(suffix, "be") { return 6; }
    if mem::equal_bytes(suffix, "a") { return 7; }
    if mem::equal_bytes(suffix, "s") { return 8; }
    if mem::equal_bytes(suffix, "ns") { return 9; }
    if mem::equal_bytes(suffix, "p") { return 10; }
    if mem::equal_bytes(suffix, "np") { return 11; }
    if mem::equal_bytes(suffix, "l") { return 12; }
    if mem::equal_bytes(suffix, "ge") { return 13; }
    if mem::equal_bytes(suffix, "le") { return 14; }
    if mem::equal_bytes(suffix, "g") { return 15; }
    return 0 - 1;
}

/// Writes one instruction: prefix, REX when one is needed, opcode, ModRM,
/// SIB and displacement, and the immediate.
fn (self: &var Obj) x86(allocator: Allocator, inst: &X86, what: []u8) -> !void {
    let base = inst.rm;
    if inst.reg < 0 or inst.reg > 15 or (inst.kind == 0 and (base < 0 or base > 15)) or inst.index == 4 or inst.index > 15 or
        (inst.kind == 1 and base < 0 and inst.index < 0) {
        return self.fail(allocator, what, inst.reg);
    }
    if inst.prefix != 0 {
        try self.byte(allocator, inst.prefix);
    }
    var rex = 0;
    if inst.w {
        rex = rex | 8;
    }
    if inst.reg >= 8 {
        rex = rex | 4;
    }
    if inst.index >= 8 {
        rex = rex | 2;
    }
    if base >= 8 {
        rex = rex | 1;
    }
    let low_byte = inst.reg_byte and inst.reg >= 4 and inst.reg <= 7;
    let rm_low_byte = inst.rm_byte and inst.kind == 0 and base >= 4 and base <= 7;
    if rex != 0 or low_byte or rm_low_byte {
        try self.byte(allocator, 0x40 | rex);
    }
    var at = inst.length - 1;
    while at >= 0 {
        try self.byte(allocator, inst.opcode >> (8 * at));
        at = at - 1;
    }
    let reg = (inst.reg & 7) << 3;
    if inst.kind == 0 {
        try self.byte(allocator, 0xC0 | reg | (base & 7));
    } else if base < 0 {
        // No base: the index scaled, and a 32-bit displacement.
        try self.byte(allocator, reg | 4);
        try self.byte(allocator, (inst.shift << 6) | ((inst.index & 7) << 3) | 5);
        try self.little(allocator, inst.disp, 4);
    } else {
        var mode = 0x80;
        if inst.disp == 0 and (base & 7) != 5 {
            mode = 0;
        } else if fits_i8(inst.disp) {
            mode = 0x40;
        }
        if inst.index >= 0 or (base & 7) == 4 {
            var index = 4;
            if inst.index >= 0 {
                index = inst.index & 7;
            }
            try self.byte(allocator, mode | reg | 4);
            try self.byte(allocator, (inst.shift << 6) | (index << 3) | (base & 7));
        } else {
            try self.byte(allocator, mode | reg | (base & 7));
        }
        if mode == 0x40 {
            try self.byte(allocator, inst.disp);
        } else if mode == 0x80 {
            try self.little(allocator, inst.disp, 4);
        }
    }
    return self.little(allocator, inst.imm, inst.imm_size);
}

/// Writes an instruction that names its register in the opcode's low
/// bits: push, pop, mov of an immediate.
fn (self: &var Obj) x86_plus(allocator: Allocator, opcode: i64, w: bool, reg: i64, imm: i64, imm_size: i64, what: []u8) -> !void {
    if reg < 0 or reg > 15 {
        return self.fail(allocator, what, reg);
    }
    var rex = 0;
    if w {
        rex = 8;
    }
    if reg >= 8 {
        rex = rex | 1;
    }
    if rex != 0 {
        try self.byte(allocator, 0x40 | rex);
    }
    try self.byte(allocator, opcode | (reg & 7));
    return self.little(allocator, imm, imm_size);
}

/// `op %src, %dst`, each register at its size.
fn (self: &var Obj) x86_rr(allocator: Allocator, mnemonic: []u8, src: i64, src_size: i64, dst: i64, dst_size: i64) -> !void {
    let w = dst_size == 8;
    // ModRM.reg is the source.
    var opcode = 0 - 1;
    if mem::equal_bytes(mnemonic, "movq") or mem::equal_bytes(mnemonic, "movl") {
        opcode = 0x89;
    } else if mem::equal_bytes(mnemonic, "addq") {
        opcode = 0x01;
    } else if mem::equal_bytes(mnemonic, "subq") {
        opcode = 0x29;
    } else if mem::equal_bytes(mnemonic, "andq") {
        opcode = 0x21;
    } else if mem::equal_bytes(mnemonic, "orq") {
        opcode = 0x09;
    } else if mem::equal_bytes(mnemonic, "xorq") or mem::equal_bytes(mnemonic, "xorl") {
        opcode = 0x31;
    } else if mem::equal_bytes(mnemonic, "cmpq") {
        opcode = 0x39;
    } else if mem::equal_bytes(mnemonic, "testq") {
        opcode = 0x85;
    }
    if opcode >= 0 {
        let inst = x86_reg_form(opcode, 1, w, src, dst);
        return self.x86(allocator, &inst, mnemonic);
    }
    // ModRM.reg is the destination.
    var length = 2;
    if mem::equal_bytes(mnemonic, "imulq") {
        opcode = 0x0FAF;
    } else if mem::equal_bytes(mnemonic, "movzbl") {
        opcode = 0x0FB6;
    } else if mem::equal_bytes(mnemonic, "movzwl") {
        opcode = 0x0FB7;
    } else if mem::equal_bytes(mnemonic, "movslq") {
        opcode = 0x63;
        length = 1;
    } else if mem::equal_bytes(mnemonic, "movswq") {
        opcode = 0x0FBF;
    } else if mem::equal_bytes(mnemonic, "movsbq") {
        opcode = 0x0FBE;
    }
    if opcode < 0 {
        return self.fail(allocator, mnemonic, src);
    }
    var inst = x86_reg_form(opcode, length, w, dst, src);
    inst.rm_byte = src_size == 1;
    return self.x86(allocator, &inst, mnemonic);
}

/// `cmov<cc>q %src, %dst`.
fn (self: &var Obj) x86_cmov(allocator: Allocator, cc: i64, src: i64, dst: i64) -> !void {
    let inst = x86_reg_form(0x0F40 | cc, 2, true, dst, src);
    return self.x86(allocator, &inst, "cmov");
}

/// `set<cc> %reg`, a byte register.
fn (self: &var Obj) x86_setcc(allocator: Allocator, cc: i64, reg: i64) -> !void {
    var inst = x86_reg_form(0x0F90 | cc, 2, false, 0, reg);
    inst.rm_byte = true;
    return self.x86(allocator, &inst, "set");
}

/// Returns the ModRM.reg extension of a group 1 arithmetic mnemonic (the
/// 80..83 opcodes), or -1.
fn group1(mnemonic: []u8) -> i64 {
    if mem::equal_bytes(mnemonic, "addq") { return 0; }
    if mem::equal_bytes(mnemonic, "orq") { return 1; }
    if mem::equal_bytes(mnemonic, "andq") { return 4; }
    if mem::equal_bytes(mnemonic, "subq") { return 5; }
    if mem::equal_bytes(mnemonic, "cmpq") or mem::equal_bytes(mnemonic, "cmp") { return 7; }
    return 0 - 1;
}

/// Returns the ModRM.reg extension of a shift mnemonic, or -1.
fn shift_group(mnemonic: []u8) -> i64 {
    if mem::equal_bytes(mnemonic, "shlq") { return 4; }
    if mem::equal_bytes(mnemonic, "shrq") { return 5; }
    if mem::equal_bytes(mnemonic, "sarq") { return 7; }
    return 0 - 1;
}

/// `op $imm, %dst` at size.
fn (self: &var Obj) x86_ir(allocator: Allocator, mnemonic: []u8, imm: i64, dst: i64, size: i64) -> !void {
    let w = size == 8;
    if mem::equal_bytes(mnemonic, "movl") {
        return self.x86_plus(allocator, 0xB8, false, dst, imm, 4, mnemonic);
    }
    if mem::equal_bytes(mnemonic, "movabsq") {
        return self.x86_plus(allocator, 0xB8, true, dst, imm, 8, mnemonic);
    }
    if mem::equal_bytes(mnemonic, "movq") {
        var inst = x86_reg_form(0xC7, 1, true, 0, dst);
        inst.imm = imm;
        inst.imm_size = 4;
        return self.x86(allocator, &inst, mnemonic);
    }
    let extension = group1(mnemonic);
    if extension >= 0 {
        if fits_i8(imm) {
            var inst = x86_reg_form(0x83, 1, w, extension, dst);
            inst.imm = imm;
            inst.imm_size = 1;
            return self.x86(allocator, &inst, mnemonic);
        }
        if dst == 0 {
            // rax's own form: op rax, imm32.
            if w {
                try self.byte(allocator, 0x48);
            }
            try self.byte(allocator, (extension << 3) | 5);
            return self.little(allocator, imm, 4);
        }
        var inst = x86_reg_form(0x81, 1, w, extension, dst);
        inst.imm = imm;
        inst.imm_size = 4;
        return self.x86(allocator, &inst, mnemonic);
    }
    if mem::equal_bytes(mnemonic, "testq") {
        if dst == 0 {
            try self.byte(allocator, 0x48);
            try self.byte(allocator, 0xA9);
            return self.little(allocator, imm, 4);
        }
        var inst = x86_reg_form(0xF7, 1, true, 0, dst);
        inst.imm = imm;
        inst.imm_size = 4;
        return self.x86(allocator, &inst, mnemonic);
    }
    let shift = shift_group(mnemonic);
    if shift >= 0 {
        if imm == 1 {
            let inst = x86_reg_form(0xD1, 1, w, shift, dst);
            return self.x86(allocator, &inst, mnemonic);
        }
        var inst = x86_reg_form(0xC1, 1, w, shift, dst);
        inst.imm = imm;
        inst.imm_size = 1;
        return self.x86(allocator, &inst, mnemonic);
    }
    if mem::equal_bytes(mnemonic, "btcq") {
        var inst = x86_reg_form(0x0FBA, 2, true, 7, dst);
        inst.imm = imm;
        inst.imm_size = 1;
        return self.x86(allocator, &inst, mnemonic);
    }
    return self.fail(allocator, mnemonic, imm);
}

/// Returns the F7 group's ModRM.reg extension of a one-operand mnemonic,
/// or -1.
fn unary_group(mnemonic: []u8) -> i64 {
    if mem::equal_bytes(mnemonic, "notq") or mem::equal_bytes(mnemonic, "not") { return 2; }
    if mem::equal_bytes(mnemonic, "negq") { return 3; }
    if mem::equal_bytes(mnemonic, "mulq") { return 4; }
    if mem::equal_bytes(mnemonic, "imulq") { return 5; }
    if mem::equal_bytes(mnemonic, "divq") or mem::equal_bytes(mnemonic, "divl") { return 6; }
    if mem::equal_bytes(mnemonic, "idivq") { return 7; }
    return 0 - 1;
}

/// `op %reg` at size.
fn (self: &var Obj) x86_r1(allocator: Allocator, mnemonic: []u8, reg: i64, size: i64) -> !void {
    if mem::equal_bytes(mnemonic, "pushq") {
        return self.x86_plus(allocator, 0x50, false, reg, 0, 0, mnemonic);
    }
    if mem::equal_bytes(mnemonic, "popq") {
        return self.x86_plus(allocator, 0x58, false, reg, 0, 0, mnemonic);
    }
    let extension = unary_group(mnemonic);
    if extension < 0 {
        return self.fail(allocator, mnemonic, reg);
    }
    let inst = x86_reg_form(0xF7, 1, size == 8, extension, reg);
    return self.x86(allocator, &inst, mnemonic);
}

/// `op mem`: a division or multiplication by memory.
fn (self: &var Obj) x86_m1(allocator: Allocator, mnemonic: []u8, base: i64, index: i64, shift: i64, disp: i64) -> !void {
    let extension = unary_group(mnemonic);
    if extension < 0 {
        return self.fail(allocator, mnemonic, disp);
    }
    let w = !mem::equal_bytes(mnemonic, "divl");
    let inst = x86_mem_form(0xF7, 1, w, extension, base, index, shift, disp);
    return self.x86(allocator, &inst, mnemonic);
}

/// `op mem, %dst`: a load, lea, or an or from memory.
fn (self: &var Obj) x86_mr(
    allocator: Allocator,
    mnemonic: []u8,
    base: i64,
    index: i64,
    shift: i64,
    disp: i64,
    dst: i64
) -> !void {
    var opcode = 0 - 1;
    var length = 1;
    var w = true;
    if mem::equal_bytes(mnemonic, "movq") {
        opcode = 0x8B;
    } else if mem::equal_bytes(mnemonic, "movl") {
        opcode = 0x8B;
        w = false;
    } else if mem::equal_bytes(mnemonic, "leaq") {
        opcode = 0x8D;
    } else if mem::equal_bytes(mnemonic, "orq") {
        opcode = 0x0B;
    } else if mem::equal_bytes(mnemonic, "movslq") {
        opcode = 0x63;
    } else if mem::equal_bytes(mnemonic, "movzbl") {
        opcode = 0x0FB6;
        length = 2;
        w = false;
    } else if mem::equal_bytes(mnemonic, "movzwl") {
        opcode = 0x0FB7;
        length = 2;
        w = false;
    } else if mem::equal_bytes(mnemonic, "movswq") {
        opcode = 0x0FBF;
        length = 2;
    } else if mem::equal_bytes(mnemonic, "movsbq") {
        opcode = 0x0FBE;
        length = 2;
    }
    if opcode < 0 {
        return self.fail(allocator, mnemonic, disp);
    }
    let inst = x86_mem_form(opcode, length, w, dst, base, index, shift, disp);
    return self.x86(allocator, &inst, mnemonic);
}

/// `mov<size> %src, mem`.
fn (self: &var Obj) x86_rm(
    allocator: Allocator,
    mnemonic: []u8,
    src: i64,
    base: i64,
    index: i64,
    shift: i64,
    disp: i64
) -> !void {
    var opcode = 0x89;
    var inst = x86_mem_form(opcode, 1, false, src, base, index, shift, disp);
    if mem::equal_bytes(mnemonic, "movb") {
        opcode = 0x88;
        inst = x86_mem_form(opcode, 1, false, src, base, index, shift, disp);
        inst.reg_byte = true;
    } else if mem::equal_bytes(mnemonic, "movw") {
        inst.prefix = 0x66;
    } else if mem::equal_bytes(mnemonic, "movq") {
        inst.w = true;
    } else if !mem::equal_bytes(mnemonic, "movl") {
        return self.fail(allocator, mnemonic, disp);
    }
    return self.x86(allocator, &inst, mnemonic);
}

/// `mov<size> $imm, mem`.
fn (self: &var Obj) x86_im(
    allocator: Allocator,
    mnemonic: []u8,
    imm: i64,
    base: i64,
    index: i64,
    shift: i64,
    disp: i64
) -> !void {
    var inst = x86_mem_form(0xC7, 1, false, 0, base, index, shift, disp);
    inst.imm = imm;
    inst.imm_size = 4;
    if mem::equal_bytes(mnemonic, "movb") {
        inst.opcode = 0xC6;
        inst.imm_size = 1;
    } else if mem::equal_bytes(mnemonic, "movw") {
        inst.prefix = 0x66;
        inst.imm_size = 2;
    } else if mem::equal_bytes(mnemonic, "movq") {
        inst.w = true;
    } else if !mem::equal_bytes(mnemonic, "movl") {
        return self.fail(allocator, mnemonic, imm);
    }
    return self.x86(allocator, &inst, mnemonic);
}

/// An instruction without operands.
fn (self: &var Obj) x86_bare(allocator: Allocator, mnemonic: []u8) -> !void {
    if mem::equal_bytes(mnemonic, "ret") {
        return self.byte(allocator, 0xC3);
    }
    if mem::equal_bytes(mnemonic, "ud2") {
        return self.little(allocator, 0x0B0F, 2);
    }
    if mem::equal_bytes(mnemonic, "cqto") {
        return self.little(allocator, 0x9948, 2);
    }
    if mem::equal_bytes(mnemonic, "pushfq") {
        return self.byte(allocator, 0x9C);
    }
    if mem::equal_bytes(mnemonic, "popfq") {
        return self.byte(allocator, 0x9D);
    }
    return self.fail(allocator, mnemonic, 0);
}

/// `op %cl, %dst`: a shift by cl.
fn (self: &var Obj) x86_shift_cl(allocator: Allocator, mnemonic: []u8, dst: i64) -> !void {
    let extension = shift_group(mnemonic);
    if extension < 0 {
        return self.fail(allocator, mnemonic, dst);
    }
    let inst = x86_reg_form(0xD3, 1, true, extension, dst);
    return self.x86(allocator, &inst, mnemonic);
}

/// `leaq sym(%rip), %dst`, or with got `movq sym@GOTPCREL(%rip), %dst`.
fn (self: &var Obj) x86_rip(allocator: Allocator, syms: &ir::NameTable, name: ir::Name, dst: i64, got: bool) -> !void {
    if dst < 0 or dst > 15 {
        return self.fail(allocator, "leaq", dst);
    }
    var opcode = 0x8D;
    var kind = reloc_x86_pc32();
    if got {
        opcode = 0x8B;
        kind = reloc_x86_gotpcrelx();
    }
    try self.byte(allocator, 0x48 | ((dst >> 1) & 4));
    try self.byte(allocator, opcode);
    try self.byte(allocator, ((dst & 7) << 3) | 5);
    try self.relocate_addend(allocator, syms, name, kind, 0 - 4);
    return self.little(allocator, 0, 4);
}

/// `call sym`: resolved here when sym is a local function of the section,
/// else left to the linker, through the PLT.
fn (self: &var Obj) x86_call(allocator: Allocator, syms: &ir::NameTable, name: ir::Name) -> !void {
    try self.byte(allocator, 0xE8);
    try self.relocate_addend(allocator, syms, name, reloc_x86_plt32(), 0 - 4);
    return self.little(allocator, 0, 4);
}

/// `call *%reg`.
fn (self: &var Obj) x86_call_reg(allocator: Allocator, reg: i64) -> !void {
    let inst = x86_reg_form(0xFF, 1, false, 2, reg);
    return self.x86(allocator, &inst, "call");
}

/// `op %xmm a, %xmm b`: prefix and opcode by mnemonic, or by a float
/// arithmetic mnemonic and width (the sd or ss suffix).
fn (self: &var Obj) x86_xx(allocator: Allocator, mnemonic: []u8, width: i64, a: i64, b: i64) -> !void {
    var prefix = 0xF3;
    if width == 8 {
        prefix = 0xF2;
    }
    var opcode = 0 - 1;
    if mem::equal_bytes(mnemonic, "add") {
        opcode = 0x0F58;
    } else if mem::equal_bytes(mnemonic, "mul") {
        opcode = 0x0F59;
    } else if mem::equal_bytes(mnemonic, "sub") {
        opcode = 0x0F5C;
    } else if mem::equal_bytes(mnemonic, "div") {
        opcode = 0x0F5E;
    } else if mem::equal_bytes(mnemonic, "sqrt") {
        opcode = 0x0F51;
    } else if mem::equal_bytes(mnemonic, "cvtsd2ss") {
        opcode = 0x0F5A;
        prefix = 0xF2;
    } else if mem::equal_bytes(mnemonic, "cvtss2sd") {
        opcode = 0x0F5A;
        prefix = 0xF3;
    } else if mem::equal_bytes(mnemonic, "ucomisd") {
        opcode = 0x0F2E;
        prefix = 0x66;
    } else if mem::equal_bytes(mnemonic, "ucomiss") {
        opcode = 0x0F2E;
        prefix = 0;
    } else if mem::equal_bytes(mnemonic, "xorps") {
        opcode = 0x0F57;
        prefix = 0;
    } else if mem::equal_bytes(mnemonic, "movapd") {
        // The load form, ModRM.reg the destination, as the assembler
        // writes a register copy.
        opcode = 0x0F28;
        prefix = 0x66;
    }
    if opcode < 0 {
        return self.fail(allocator, mnemonic, a);
    }
    var inst = x86_reg_form(opcode, 2, false, b, a);
    inst.prefix = prefix;
    return self.x86(allocator, &inst, mnemonic);
}

/// Returns the prefix of a float move by its mnemonic: F2 for movsd, F3
/// for movss, none (0) for movups, or -1.
fn scalar_move_prefix(mnemonic: []u8) -> i64 {
    if mem::equal_bytes(mnemonic, "movsd") { return 0xF2; }
    if mem::equal_bytes(mnemonic, "movss") { return 0xF3; }
    if mem::equal_bytes(mnemonic, "movups") { return 0; }
    return 0 - 1;
}

/// `op mem, %xmm`: a float loaded into an xmm register (movsd, movss),
/// the rest of the register cleared, or all 16 bytes of it (movups).
fn (self: &var Obj) x86_mx(allocator: Allocator, mnemonic: []u8, base: i64, index: i64, shift: i64, disp: i64, xmm: i64) -> !void {
    let prefix = scalar_move_prefix(mnemonic);
    if prefix < 0 {
        return self.fail(allocator, mnemonic, disp);
    }
    var inst = x86_mem_form(0x0F10, 2, false, xmm, base, index, shift, disp);
    inst.prefix = prefix;
    return self.x86(allocator, &inst, mnemonic);
}

/// `op %xmm, mem`: a float stored from an xmm register (movsd, movss), or
/// all 16 bytes of it (movups).
fn (self: &var Obj) x86_xm(allocator: Allocator, mnemonic: []u8, xmm: i64, base: i64, index: i64, shift: i64, disp: i64) -> !void {
    let prefix = scalar_move_prefix(mnemonic);
    if prefix < 0 {
        return self.fail(allocator, mnemonic, disp);
    }
    var inst = x86_mem_form(0x0F11, 2, false, xmm, base, index, shift, disp);
    inst.prefix = prefix;
    return self.x86(allocator, &inst, mnemonic);
}

/// `op %reg, %xmm`: a general register into an xmm one, its bits (movq,
/// movd) or its value (cvtsi2sdq, cvtsi2ssq).
fn (self: &var Obj) x86_rx(allocator: Allocator, mnemonic: []u8, reg: i64, size: i64, xmm: i64) -> !void {
    var prefix = 0x66;
    var opcode = 0x0F6E;
    if mem::equal_bytes(mnemonic, "cvtsi2sdq") {
        prefix = 0xF2;
        opcode = 0x0F2A;
    } else if mem::equal_bytes(mnemonic, "cvtsi2ssq") {
        prefix = 0xF3;
        opcode = 0x0F2A;
    } else if !mem::equal_bytes(mnemonic, "movq") and !mem::equal_bytes(mnemonic, "movd") {
        return self.fail(allocator, mnemonic, reg);
    }
    var inst = x86_reg_form(opcode, 2, size == 8, xmm, reg);
    inst.prefix = prefix;
    return self.x86(allocator, &inst, mnemonic);
}

/// `op %xmm, %reg`: an xmm register into a general one, its bits (movq,
/// movd) or its value truncated (cvttsd2si, cvttss2si).
fn (self: &var Obj) x86_xr(allocator: Allocator, mnemonic: []u8, xmm: i64, reg: i64, size: i64) -> !void {
    if mem::equal_bytes(mnemonic, "movq") or mem::equal_bytes(mnemonic, "movd") {
        var inst = x86_reg_form(0x0F7E, 2, size == 8, xmm, reg);
        inst.prefix = 0x66;
        return self.x86(allocator, &inst, mnemonic);
    }
    var prefix = 0xF2;
    if mem::equal_bytes(mnemonic, "cvttss2si") {
        prefix = 0xF3;
    } else if !mem::equal_bytes(mnemonic, "cvttsd2si") {
        return self.fail(allocator, mnemonic, reg);
    }
    var inst = x86_reg_form(0x0F2C, 2, size == 8, reg, xmm);
    inst.prefix = prefix;
    return self.x86(allocator, &inst, mnemonic);
}

// ---- jumps ----

/// Is one jump of the function being written, two bytes long until the
/// function ends: cc is its condition code, or -1 for jmp; target a block,
/// or with local set a label of the printer's own.
struct X86Jump {
    at: i64,
    cc: i64,
    target: i64,
    local: bool,
}

/// Appends a jump, short for now.
fn (self: &var Obj) x86_jump(allocator: Allocator, cc: i64, target: i64, local: bool) -> !void {
    let at = self.here();
    try self.jumps.append(allocator, X86Jump { at: at, cc: cc, target: target, local: local });
    return self.little(allocator, 0, 2);
}

/// Places one of the printer's own labels here.
fn (self: &var Obj) place_local(allocator: Allocator, label: i64) -> !void {
    while self.local_at.len() <= label {
        try self.local_at.append(allocator, 0 - 1);
    }
    let at = self.here();
    return self.local_at.set(label, at);
}

/// Returns how many of the jumps start before at, given they are in order.
fn jumps_before(jumps: &array::Array<X86Jump>, at: i64) -> i64 {
    var low = 0;
    var high = jumps.len();
    while low < high {
        let middle = (low + high) / 2;
        if jumps.get_or_panic(middle).at < at {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

/// Ends a function on x86-64: makes near each jump whose target a byte
/// does not reach, as the assembler relaxes them -- every jump starts
/// short, and one that does not reach grows, until none grows -- then
/// writes them, and moves what follows each grown one: the bytes, the
/// relocations and the symbols of the function.
fn (self: &var Obj) relax_jumps(allocator: Allocator) -> !void {
    let count = self.jumps.len();
    if count == 0 {
        return;
    }
    // The target of each jump, and how many jumps start before it.
    var targets = array::new<i64>(allocator);
    defer targets.deinit(allocator);
    var before = array::new<i64>(allocator);
    defer before.deinit(allocator);
    var index = 0;
    while self.jumps.get(index) |jump| {
        index = index + 1;
        var target = 0 - 1;
        if jump.local {
            target = self.local_at.get(jump.target) orelse 0 - 1;
        } else {
            target = self.block_at.get(jump.target) orelse 0 - 1;
        }
        if target < 0 {
            try self.fail(allocator, "jump to a label never placed", jump.target);
            return;
        }
        try targets.append(allocator, target);
        try before.append(allocator, jumps_before(&self.jumps, target));
    }
    // grown[i] is what the i-th jump adds when near; added[i] what the
    // jumps before it add.
    var grown = array::new<i64>(allocator);
    defer grown.deinit(allocator);
    var added = array::new<i64>(allocator);
    defer added.deinit(allocator);
    for 0..count + 1 |_index| {
        try grown.append(allocator, 0);
        try added.append(allocator, 0);
    }
    var changed = true;
    while changed {
        changed = false;
        var sum = 0;
        for 0..count |at| {
            try added.set(at, sum);
            sum = sum + grown.get_or_panic(at);
        }
        try added.set(count, sum);
        for 0..count |at| {
            if grown.get_or_panic(at) != 0 {
                continue;
            }
            let jump = self.jumps.get_or_panic(at);
            let end = jump.at + added.get_or_panic(at) + 2;
            let target = targets.get_or_panic(at) + added.get_or_panic(before.get_or_panic(at));
            if !fits_i8(target - end) {
                var growth = 4;
                if jump.cc < 0 {
                    growth = 3;
                }
                try grown.set(at, growth);
                changed = true;
            }
        }
    }
    // Write the function again from its first jump.
    let first = self.jumps.get_or_panic(0).at;
    var tail = string::new(allocator);
    defer tail.deinit(allocator);
    if self.sections.at(self.current) |section| {
        let bytes = section.bytes.as_bytes();
        var cursor = first;
        for 0..count |at| {
            let jump = self.jumps.get_or_panic(at);
            try tail.append_bytes(allocator, bytes[cursor..jump.at]);
            cursor = jump.at + 2;
            let growth = grown.get_or_panic(at);
            let start = jump.at + added.get_or_panic(at);
            let target = targets.get_or_panic(at) + added.get_or_panic(before.get_or_panic(at));
            let distance = target - (start + 2 + growth);
            if growth == 0 {
                if jump.cc < 0 {
                    try tail.append_byte(allocator, cast<u8>(0xEB));
                } else {
                    try tail.append_byte(allocator, cast<u8>(0x70 | jump.cc));
                }
                try tail.append_byte(allocator, cast<u8>(distance & 255));
                continue;
            }
            if jump.cc < 0 {
                try tail.append_byte(allocator, cast<u8>(0xE9));
            } else {
                try tail.append_byte(allocator, cast<u8>(0x0F));
                try tail.append_byte(allocator, cast<u8>(0x80 | jump.cc));
            }
            for 0..4 |byte| {
                try tail.append_byte(allocator, cast<u8>((distance >> (8 * byte)) & 255));
            }
        }
        try tail.append_bytes(allocator, bytes[cursor..mem::len(bytes)]);
    }
    let current = self.current;
    if self.sections.at_mut(current) |section| {
        try section.bytes.truncate(first);
        try section.bytes.append_string(allocator, &tail);
        var reloc_index = 0;
        while section.relocs.at_mut(reloc_index) |reloc| {
            reloc_index = reloc_index + 1;
            if reloc.address > first {
                reloc.address = reloc.address + added.get_or_panic(jumps_before(&self.jumps, reloc.address));
            }
        }
    }
    var symbol_index = 0;
    while self.symbols.at_mut(symbol_index) |symbol| {
        symbol_index = symbol_index + 1;
        if symbol.section == current and symbol.value > first {
            symbol.value = symbol.value + added.get_or_panic(jumps_before(&self.jumps, symbol.value));
        }
    }
    return;
}

/// Pads code to an alignment with the nops the assembler writes for
/// x86-64: the longest first, ten bytes at most.
fn (self: &var Obj) x86_nops(allocator: Allocator, count: i64) -> !void {
    var left = count;
    while left > 0 {
        var size = left;
        if size > 10 {
            size = 10;
        }
        left = left - size;
        if size == 1 {
            try self.byte(allocator, 0x90);
        } else if size == 2 {
            try self.little(allocator, 0x9066, 2);
        } else if size == 3 {
            try self.little(allocator, 0x001F0F, 3);
        } else if size == 4 {
            try self.little(allocator, 0x00401F0F, 4);
        } else if size == 5 {
            try self.little(allocator, 0x0000441F0F, 5);
        } else if size == 6 {
            try self.little(allocator, 0x0000441F0F66, 6);
        } else if size == 7 {
            try self.little(allocator, 0x00000000801F0F, 7);
        } else if size == 8 {
            try self.little(allocator, 0x0000000000841F0F, 8);
        } else if size == 9 {
            try self.byte(allocator, 0x66);
            try self.little(allocator, 0x0000000000841F0F, 8);
        } else {
            try self.little(allocator, 0x0F2E66, 3);
            try self.little(allocator, 0x00000000841F, 7);
        }
    }
    return;
}
