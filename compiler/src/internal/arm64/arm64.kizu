import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ir;
import std::array;
import std::fmt;
import std::mem;
import std::string;

// The arm64 backend: a lowered module straight to AArch64 assembly text,
// Mach-O for Darwin or ELF for Linux, which the system assembler and
// linker turn into the executable (and, through the amd64 printer, x86-64
// text, also COFF for Windows).
// Every function is selected into machine IR, given registers, and printed;
// an op or a type the backend does not lower stops the build with a
// diagnostic naming it rather than being handed to another backend. The
// same machine IR, allocated, is also printed as x86-64 by the amd64
// printer. On arm64 the printer can also write each line's machine code
// itself into a Mach-O or ELF object (encode.kizu, obj.kizu, macho.kizu,
// elf.kizu), the object the assembler would make of the text; the text
// stays the reference it is checked against.

/// Is the object format the assembly text is written for. Selection names
/// symbols the Mach-O way; printing for ELF or COFF spells them through
/// symbol.
pub enum Format {
    MachO,
    Elf,
    Coff,
}

/// Emits a lowered module as assembly text for arch, in format. The amd64
/// printer writes Mach-O, ELF and COFF, and arm64 Mach-O and ELF only; the
/// caller rejects the other pairs.
pub fn emit(allocator: Allocator, module: &ir::Module, arch: Arch, format: Format, out: &var string::String) -> !?diagnostic::Diagnostic {
    var sink = new_out(allocator, false, format);
    defer sink.deinit(allocator);
    if try emit_into(allocator, module, arch, format, &var sink) |failed| {
        return move failed;
    }
    try out.append_string(allocator, &sink.text);
    return null;
}

/// Emits a lowered module for arm64 as an object in format, Mach-O for
/// Darwin or ELF for Linux: the lines emit would write, encoded here rather
/// than by the assembler, so the text stays what the object is checked
/// against. A Mach-O object's LC_BUILD_VERSION names no version; the link
/// stamps the one of the runtime it links with.
pub fn emit_object(allocator: Allocator, module: &ir::Module, format: Format, out: &var string::String) -> !?diagnostic::Diagnostic {
    var sink = new_out(allocator, true, format);
    defer sink.deinit(allocator);
    if try emit_into(allocator, module, Arch::Arm64, format, &var sink) |failed| {
        return move failed;
    }
    if sink.obj.failure.len() > 0 {
        var message = try string::from_bytes(allocator, "arm64 error: no encoding for ");
        defer message.deinit(allocator);
        try message.append_string(allocator, &sink.obj.failure);
        let bytes = message.as_bytes();
        return try diagnostic::from_text(allocator, diagnostic::Severity::Error, ast::zero_span(), bytes);
    }
    try out.append_string(allocator, &sink.text);
    return null;
}

/// Is where the printer writes: assembly text, or with binary set the
/// machine code of each line into obj, and then the object file into text.
pub struct Out {
    binary: bool,
    text: string::String,
    obj: Obj,
}

fn new_out(allocator: Allocator, binary: bool, format: Format) -> Out {
    return Out { binary: binary, text: string::new(allocator), obj: new_obj(allocator, format) };
}

/// Appends one instruction word to the object.
fn (self: &var Out) word(allocator: Allocator, value: i64, what: []u8) -> !void {
    return self.obj.word(allocator, value, what);
}

fn emit_into(allocator: Allocator, module: &ir::Module, arch: Arch, format: Format, out: &var Out) -> !?diagnostic::Diagnostic {
    var selector = try new_selector(allocator, arch);
    defer selector.deinit(allocator);
    selector.stacks_variadics = format == Format::MachO;
    if module.error_sets.at("std::mem::Error") |declared| {
        selector.oom = declared.tags.get("OutOfMemory") orelse 0 - 1;
    }
    if module.error_sets.at("std::array::Error") |declared| {
        selector.oob = declared.tags.get("OutOfBounds") orelse 0 - 1;
    }
    var main_ret = ir::empty_name();
    if module.function_named("main") |main_function| {
        let ret = module.function_return(main_function);
        if !module.names.is(ret, "void") {
            selector.main_wraps = true;
            main_ret = ret;
        }
    }
    if out.binary {
        try out.obj.enter(allocator, &var selector.syms, SectionKind::Text);
    } else {
        if format != Format::MachO {
            try out.text.append_bytes(allocator, "    .text");
        } else {
            try out.text.append_bytes(allocator, "    .section __TEXT,__text,regular,pure_instructions");
        }
        try newline(allocator, &var out.text);
    }
    // Select every function first, so a call can take a copy of its
    // callee's body; then allocate and print each.
    var functions = array::new<MFunction>(allocator);
    defer functions.deinit(allocator);
    var symbols = array::new<ir::Name>(allocator);
    defer symbols.deinit(allocator);
    // The C symbol of each `export "c"` function, a second label on the
    // same code, or the empty name.
    var exports = array::new<ir::Name>(allocator);
    defer exports.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let function_node = module.function_nodes.at(function.node);
        let name = function_node.name;
        let symbol = try selector.function_symbol(module, name);
        try exports.append(allocator, try selector.export_symbol(module, function_node));
        if try selector.select_function(module, function) |failed| {
            return move failed;
        }
        selector.mark_cold_blocks();
        try functions.append(allocator, try clone_function(allocator, &selector.func));
        try symbols.append(allocator, symbol);
    }
    if selector.main_wraps {
        if try selector.select_main_wrapper(module, main_ret) |failed| {
            return move failed;
        }
        selector.mark_cold_blocks();
        try functions.append(allocator, try clone_function(allocator, &selector.func));
        try symbols.append(allocator, try selector.syms.intern("_main"));
        try exports.append(allocator, ir::empty_name());
    }
    for 0..2 |kind| {
        let states = kind == 1;
        if (states and selector.state_invokes) or (!states and selector.invokes) {
            try selector.select_thread_invoke(states);
            selector.mark_cold_blocks();
            try functions.append(allocator, try clone_function(allocator, &selector.func));
            try symbols.append(allocator, try selector.invoke_symbol(states));
            try exports.append(allocator, ir::empty_name());
        }
    }
    var task_index = 0;
    while selector.task_invokes.get(task_index) |state_type| {
        task_index = task_index + 1;
        if try selector.select_task_invoke(module, state_type) |failed| {
            return move failed;
        }
        selector.mark_cold_blocks();
        try functions.append(allocator, try clone_function(allocator, &selector.func));
        try symbols.append(allocator, try selector.task_invoke_symbol(module, state_type));
        try exports.append(allocator, ir::empty_name());
    }
    try inline_calls(allocator, &var functions, &symbols);
    var ordinal = 0;
    while functions.at_mut(ordinal) |func| {
        let symbol = symbols.get_or_panic(ordinal);
        let allocation = try allocate(allocator, func, arch);
        defer allocation.deinit(allocator);
        let symbol_text = ir::name_text(&selector.syms, symbol);
        let symbol_bytes = symbol_text.as_bytes();
        let exported = exports.get_or_panic(ordinal);
        if is_x86(arch) {
            try amd64_print_function(allocator, &var out.text, func, &allocation, symbol_bytes, exported, ordinal, &selector.syms, arch, format);
            ordinal = ordinal + 1;
            continue;
        }
        if !ir::is_empty(exported) {
            if out.binary {
                try out.obj.global(allocator, &selector.syms, exported);
                try out.obj.align(allocator, 4);
                try out.obj.define(allocator, &selector.syms, exported);
            } else {
                let exported_text = ir::name_text(&selector.syms, exported);
                let exported_bytes = exported_text.as_bytes();
                try out.text.append_bytes(allocator, "    .globl ");
                try symbol(allocator, &var out.text, format, exported_bytes);
                try newline(allocator, &var out.text);
                try out.text.append_bytes(allocator, "    .p2align 4");
                try newline(allocator, &var out.text);
                try symbol(allocator, &var out.text, format, exported_bytes);
                try out.text.append_bytes(allocator, ":");
                try newline(allocator, &var out.text);
            }
        }
        try print_function(allocator, out, func, &allocation, symbol, ordinal, &selector.syms, format);
        ordinal = ordinal + 1;
    }
    if selector.main_wraps {
        try write_error_names(allocator, module, &var selector, format, out);
    }
    if selector.table_starts.len() > 0 {
        try write_tables(allocator, &var selector, format, out);
    }
    if selector.literals.len() > 0 {
        if out.binary {
            try write_literal_bytes(allocator, &var selector, &var out.obj);
        } else {
            try write_literals(allocator, &selector, format, &var out.text);
        }
    }
    if out.binary {
        if format == Format::Elf {
            // The stack is not executable.
            try out.obj.enter(allocator, &var selector.syms, SectionKind::Note);
            try out.obj.write_elf(allocator, &selector.syms, &var out.text);
        } else {
            try out.obj.write_macho(allocator, &selector.syms, 0, &var out.text);
        }
        return null;
    }
    if format == Format::Elf {
        // The stack is not executable.
        try elf_section(allocator, &var out.text, ".note.GNU-stack", "", ",%progbits");
        try newline(allocator, &var out.text);
    } else if format == Format::MachO {
        try out.text.append_bytes(allocator, ".subsections_via_symbols");
        try newline(allocator, &var out.text);
    }
    return null;
}

/// Writes the string literals as text, each NUL-terminated.
fn write_literals(allocator: Allocator, selector: &Selector, format: Format, out: &var string::String) -> !void {
    if format == Format::Elf {
        try elf_section(allocator, out, ".rodata.str1.1", "aMS", ",%progbits,1");
    } else if format == Format::Coff {
        try elf_section(allocator, out, ".rdata", "dr", "");
    } else {
        try out.append_bytes(allocator, "    .section __TEXT,__cstring,cstring_literals");
    }
    try newline(allocator, out);
    var literal_index = 0;
    while selector.literals.get(literal_index) |literal| {
        try symbol(allocator, out, format, "Lkz_str.");
        try fmt::append_i64(allocator, out, literal_index);
        try out.append_bytes(allocator, ":");
        try newline(allocator, out);
        literal_index = literal_index + 1;
        let text = ir::name_text(&selector.syms, literal);
        let bytes = text.as_bytes();
        var at = 0;
        while at < mem::len(bytes) {
            if at % 16 == 0 {
                if at > 0 {
                    try newline(allocator, out);
                }
                try out.append_bytes(allocator, "    .byte ");
            } else {
                try out.append_bytes(allocator, ",");
            }
            try fmt::append_i64(allocator, out, cast<i64>(bytes[at]));
            at = at + 1;
        }
        if mem::len(bytes) > 0 {
            try newline(allocator, out);
        }
        try out.append_bytes(allocator, "    .byte 0");
        try newline(allocator, out);
    }
    return;
}

/// Writes the string literals into the object's C string section.
fn write_literal_bytes(allocator: Allocator, selector: &var Selector, obj: &var Obj) -> !void {
    try obj.enter(allocator, &var selector.syms, SectionKind::Cstring);
    var literal_index = 0;
    while selector.literals.get(literal_index) |literal| {
        let label = try local_label(allocator, &var selector.syms, "Lkz_str.", literal_index);
        literal_index = literal_index + 1;
        try obj.define(allocator, &selector.syms, label);
        let text = ir::name_text(&selector.syms, literal);
        let bytes = text.as_bytes();
        try obj.bytes(allocator, bytes);
        try obj.datum(allocator, 0, 1);
    }
    return;
}

/// Returns the name of the local label prefix followed by index.
fn local_label(allocator: Allocator, syms: &var ir::NameTable, prefix: []u8, index: i64) -> !ir::Name {
    var label = try string::from_bytes(allocator, prefix);
    defer label.deinit(allocator);
    try fmt::append_i64(allocator, &var label, index);
    let bytes = label.as_bytes();
    return syms.intern(bytes);
}

/// Writes an assembler symbol the selector named the Mach-O way. ELF and
/// x86-64 COFF have no `_` in front of a C symbol, and keep a local label
/// out of the symbol table by a `.L` start rather than an `L` one.
fn symbol(allocator: Allocator, out: &var string::String, format: Format, bytes: []u8) -> !void {
    if format != Format::MachO and mem::len(bytes) > 0 {
        if bytes[0] == cast<u8>(95) {
            return out.append_bytes(allocator, bytes[1..mem::len(bytes)]);
        }
        if bytes[0] == cast<u8>(76) {
            try out.append_bytes(allocator, ".");
        }
    }
    return out.append_bytes(allocator, bytes);
}

/// Writes a symbol with a relocation operator: ELF's in front
/// (`:lo12:sym`), Mach-O's behind (`sym@PAGEOFF`).
fn relocated(allocator: Allocator, out: &var string::String, format: Format, bytes: []u8, elf: []u8, mach_o: []u8) -> !void {
    if format == Format::Elf {
        try out.append_bytes(allocator, elf);
        return symbol(allocator, out, format, bytes);
    }
    try out.append_bytes(allocator, bytes);
    return out.append_bytes(allocator, mach_o);
}

/// Writes an ELF or COFF `.section name,"flags"rest` line, without the
/// newline.
fn elf_section(allocator: Allocator, out: &var string::String, name: []u8, flags: []u8, rest: []u8) -> !void {
    try out.append_bytes(allocator, "    .section ");
    try out.append_bytes(allocator, name);
    try out.append_bytes(allocator, ",");
    try out.append_byte(allocator, cast<u8>(34));
    try out.append_bytes(allocator, flags);
    try out.append_byte(allocator, cast<u8>(34));
    return out.append_bytes(allocator, rest);
}

/// Writes the read-only tables of table.get, eight bytes an entry.
fn write_tables(allocator: Allocator, selector: &var Selector, format: Format, sink: &var Out) -> !void {
    if sink.binary {
        try sink.obj.enter(allocator, &var selector.syms, SectionKind::TextConst);
        var table = 0;
        while selector.table_starts.get(table) |start| {
            var end = selector.table_words.len();
            if selector.table_starts.get(table + 1) |next| {
                end = next;
            }
            try sink.obj.align(allocator, 3);
            let label = try local_label(allocator, &var selector.syms, "Lkz_table.", table);
            try sink.obj.define(allocator, &selector.syms, label);
            table = table + 1;
            for start..end |at| {
                try sink.obj.datum(allocator, selector.table_words.get_or_panic(at), 8);
            }
        }
        return;
    }
    return write_tables_text(allocator, selector, format, &var sink.text);
}

fn write_tables_text(allocator: Allocator, selector: &Selector, format: Format, out: &var string::String) -> !void {
    if format == Format::Elf {
        try out.append_bytes(allocator, "    .section .rodata");
    } else if format == Format::Coff {
        try elf_section(allocator, out, ".rdata", "dr", "");
    } else {
        try out.append_bytes(allocator, "    .section __TEXT,__const");
    }
    try newline(allocator, out);
    var table = 0;
    while selector.table_starts.get(table) |start| {
        var end = selector.table_words.len();
        if selector.table_starts.get(table + 1) |next| {
            end = next;
        }
        try out.append_bytes(allocator, "    .p2align 3");
        try newline(allocator, out);
        try symbol(allocator, out, format, "Lkz_table.");
        try fmt::append_i64(allocator, out, table);
        try out.append_bytes(allocator, ":");
        try newline(allocator, out);
        table = table + 1;
        var at = start;
        while at < end {
            try out.append_bytes(allocator, "    .quad ");
            try fmt::append_i64(allocator, out, selector.table_words.get_or_panic(at));
            try newline(allocator, out);
            at = at + 1;
        }
    }
    return;
}

fn newline(allocator: Allocator, out: &var string::String) -> !void {
    return out.append_byte(allocator, cast<u8>(10));
}

/// Is where a function's frame puts things, from the stack pointer after
/// the prologue: the outgoing arguments and slots from 0, then the
/// callee-saved registers, then the frame record (x29, x30) at the top.
struct Frame {
    needed: bool,
    total: i64,
    saved_at: i64,
}

fn plan_frame(func: &var MFunction, allocation: &Allocation) -> Frame {
    var uses_inarg = false;
    var block_index = 0;
    while func.blocks.at(block_index) |block| {
        block_index = block_index + 1;
        var inst_index = 0;
        while block.insts.at(inst_index) |inst| {
            inst_index = inst_index + 1;
            if inst.rn == reg_inarg() {
                uses_inarg = true;
            }
        }
    }
    var offset = func.out_words * 8;
    var slot_index = 0;
    while func.slots.at_mut(slot_index) |slot| {
        slot_index = slot_index + 1;
        offset = round_up(offset, slot.align);
        slot.offset = offset;
        offset = offset + slot.size;
    }
    offset = round_up(offset, 8);
    let saved_at = offset;
    offset = offset + allocation.saved.len() * 8;
    let total = round_up(offset + 16, 16);
    let needed = func.calls or uses_inarg or offset > 0;
    return Frame { needed: needed, total: total, saved_at: saved_at };
}

/// Writes `op xa, xb, [base, #offset]` for a register pair, or two single
/// accesses when the offset does not fit the pair form.
fn print_pair(allocator: Allocator, out: &var Out, load: bool, a: i64, b: i64, base: i64, offset: i64) -> !void {
    if offset >= 0 and offset <= 504 and offset % 8 == 0 {
        if out.binary {
            return out.word(allocator, enc_pair(load, a, b, base, offset), "ldp/stp");
        }
        let text = &var out.text;
        if load {
            try head(allocator, text, "ldp");
        } else {
            try head(allocator, text, "stp");
        }
        try reg_name(allocator, text, a, true);
        try comma(allocator, text);
        try reg_name(allocator, text, b, true);
        try text.append_bytes(allocator, ", [");
        try reg_name(allocator, text, base, true);
        if offset != 0 {
            try comma(allocator, text);
            try imm_text(allocator, text, offset);
        }
        try text.append_bytes(allocator, "]");
        return newline(allocator, text);
    }
    try print_mem(allocator, out, load, a, base, offset, 8, false);
    return print_mem(allocator, out, load, b, base, offset + 8, 8, false);
}

/// Saves or restores the callee-saved registers, two at a time.
fn print_saved(allocator: Allocator, out: &var Out, load: bool, saved: &array::Array<i64>, at: i64) -> !void {
    var index = 0;
    while index < saved.len() {
        let first = saved.get_or_panic(index);
        if index + 1 < saved.len() {
            let second = saved.get_or_panic(index + 1);
            if is_float_reg(first) == is_float_reg(second) {
                try print_pair(allocator, out, load, first, second, reg_sp(), at + index * 8);
                index = index + 2;
                continue;
            }
        }
        try print_mem(allocator, out, load, first, reg_sp(), at + index * 8, 8, false);
        index = index + 1;
    }
    return;
}

fn print_prologue(allocator: Allocator, out: &var Out, frame: Frame, saved: &array::Array<i64>) -> !void {
    if frame.total < 4096 {
        try rri(allocator, out, "sub", reg_sp(), reg_sp(), frame.total);
    } else {
        try materialize(allocator, out, scratch_addr(), frame.total);
        try rrr(allocator, out, "sub", reg_sp(), reg_sp(), scratch_addr());
    }
    let record = frame.total - 16;
    if record <= 504 {
        try print_pair(allocator, out, false, 29, 30, reg_sp(), record);
        try add_imm(allocator, out, 29, reg_sp(), record);
    } else {
        try add_imm(allocator, out, scratch_addr(), reg_sp(), record);
        try print_pair(allocator, out, false, 29, 30, scratch_addr(), 0);
        try rr(allocator, out, "mov", 29, scratch_addr());
    }
    return print_saved(allocator, out, false, saved, frame.saved_at);
}

fn print_epilogue(allocator: Allocator, out: &var Out, frame: Frame, saved: &array::Array<i64>) -> !void {
    try print_saved(allocator, out, true, saved, frame.saved_at);
    let record = frame.total - 16;
    if record <= 504 {
        try print_pair(allocator, out, true, 29, 30, reg_sp(), record);
    } else {
        try add_imm(allocator, out, scratch_addr(), reg_sp(), record);
        try print_pair(allocator, out, true, 29, 30, scratch_addr(), 0);
    }
    if frame.total < 4096 {
        return rri(allocator, out, "add", reg_sp(), reg_sp(), frame.total);
    }
    try materialize(allocator, out, scratch_addr(), frame.total);
    return rrr(allocator, out, "add", reg_sp(), reg_sp(), scratch_addr());
}

/// Is the printer's state for one function.
struct Printer {
    allocator: Allocator,
    ordinal: i64,
}

fn reg_name(allocator: Allocator, out: &var string::String, reg: i64, wide: bool) -> !void {
    if reg == reg_sp() {
        if wide {
            return out.append_bytes(allocator, "sp");
        }
        return out.append_bytes(allocator, "wsp");
    }
    if reg == reg_zr() or reg < 0 {
        if wide {
            return out.append_bytes(allocator, "xzr");
        }
        return out.append_bytes(allocator, "wzr");
    }
    if is_float_reg(reg) {
        return freg(allocator, out, float_reg_index(reg), width_of(wide));
    }
    if wide {
        try out.append_byte(allocator, cast<u8>(120));
    } else {
        try out.append_byte(allocator, cast<u8>(119));
    }
    return fmt::append_i64(allocator, out, reg);
}

/// Returns the bytes a register spelled wide or not holds.
fn width_of(wide: bool) -> i64 {
    if wide {
        return 8;
    }
    return 4;
}

/// Writes an indented mnemonic and a space; the caller adds the operands.
fn head(allocator: Allocator, out: &var string::String, op: []u8) -> !void {
    try out.append_bytes(allocator, "    ");
    try out.append_bytes(allocator, op);
    return out.append_byte(allocator, cast<u8>(32));
}

fn comma(allocator: Allocator, out: &var string::String) -> !void {
    return out.append_bytes(allocator, ", ");
}

fn imm_text(allocator: Allocator, out: &var string::String, value: i64) -> !void {
    try out.append_bytes(allocator, "#");
    return fmt::append_i64(allocator, out, value);
}

/// Writes `op xd, xn, xm`.
fn rrr(allocator: Allocator, out: &var Out, op: []u8, rd: i64, rn: i64, rm: i64) -> !void {
    if out.binary {
        return out.word(allocator, enc_rrr(op, rd, rn, rm), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, rd, true);
    try comma(allocator, text);
    try reg_name(allocator, text, rn, true);
    try comma(allocator, text);
    try reg_name(allocator, text, rm, true);
    return newline(allocator, text);
}

/// Writes `op xd, xn, xm, <shift> #imm`.
fn rrr_shifted(allocator: Allocator, out: &var Out, op: []u8, inst: &MInst, shift: []u8) -> !void {
    if out.binary {
        let sub = mem::equal_bytes(op, "sub");
        let lsr = mem::equal_bytes(shift, ", lsr ");
        return out.word(allocator, enc_shifted(sub, lsr, inst.rd, inst.rn, inst.rm, inst.imm), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, inst.rd, true);
    try comma(allocator, text);
    try reg_name(allocator, text, inst.rn, true);
    try comma(allocator, text);
    try reg_name(allocator, text, inst.rm, true);
    try text.append_bytes(allocator, shift);
    try imm_text(allocator, text, inst.imm);
    return newline(allocator, text);
}

/// Writes `op xd, xn, #imm`.
fn rri(allocator: Allocator, out: &var Out, op: []u8, rd: i64, rn: i64, imm: i64) -> !void {
    if out.binary {
        return out.word(allocator, enc_rri(op, rd, rn, imm), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, rd, true);
    try comma(allocator, text);
    try reg_name(allocator, text, rn, true);
    try comma(allocator, text);
    try imm_text(allocator, text, imm);
    return newline(allocator, text);
}

/// Writes `op xd, xn`.
fn rr(allocator: Allocator, out: &var Out, op: []u8, rd: i64, rn: i64) -> !void {
    if out.binary {
        return out.word(allocator, enc_rr(op, rd, rn), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, rd, true);
    try comma(allocator, text);
    try reg_name(allocator, text, rn, true);
    return newline(allocator, text);
}

/// Writes `op xd, #imm` with the shift of a 16-bit move: what is printed,
/// and what the move encodes (base, the chunk, the shift).
fn move_wide(allocator: Allocator, out: &var Out, op: []u8, rd: i64, printed: i64, base: i64, chunk: i64, shift: i64) -> !void {
    if out.binary {
        return out.word(allocator, enc_move_wide(base, rd, chunk, shift), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, rd, true);
    try comma(allocator, text);
    try imm_text(allocator, text, printed);
    if shift > 0 {
        try text.append_bytes(allocator, ", lsl ");
        try imm_text(allocator, text, shift);
    }
    return newline(allocator, text);
}

/// Puts a 64-bit constant in a register with the fewest moves.
fn materialize(allocator: Allocator, out: &var Out, rd: i64, imm: i64) -> !void {
    if imm >= 0 and imm < 65536 {
        return move_wide(allocator, out, "mov", rd, imm, movz(), imm, 0);
    }
    if imm < 0 and imm >= 0 - 65536 {
        return move_wide(allocator, out, "mov", rd, imm, movn(), ~imm, 0);
    }
    // Count the chunks that are all ones: with three or more, start from
    // movn and patch the others.
    var ones = 0;
    var zeros = 0;
    for 0..4 |chunk| {
        let part = (imm >> (chunk * 16)) & 65535;
        if part == 65535 {
            ones = ones + 1;
        }
        if part == 0 {
            zeros = zeros + 1;
        }
    }
    let inverted = ones > zeros;
    var first = true;
    for 0..4 |chunk| {
        let part = (imm >> (chunk * 16)) & 65535;
        if inverted and part == 65535 {
            continue;
        }
        if !inverted and part == 0 {
            continue;
        }
        if first {
            first = false;
            if inverted {
                let printed = (~part) & 65535;
                try move_wide(allocator, out, "movn", rd, printed, movn(), printed, chunk * 16);
            } else {
                try move_wide(allocator, out, "movz", rd, part, movz(), part, chunk * 16);
            }
        } else {
            try move_wide(allocator, out, "movk", rd, part, movk(), part, chunk * 16);
        }
    }
    if first {
        // Every chunk was the skipped value: all ones.
        return move_wide(allocator, out, "movn", rd, 0, movn(), 0, 0);
    }
    return;
}

/// Returns the memory mnemonic for a load or store of width bytes.
fn mem_op(load: bool, width: i64, signed: bool, unscaled: bool) -> []u8 {
    if load {
        if width == 8 {
            if unscaled {
                return "ldur";
            }
            return "ldr";
        }
        if width == 4 {
            if signed {
                if unscaled {
                    return "ldursw";
                }
                return "ldrsw";
            }
            if unscaled {
                return "ldur";
            }
            return "ldr";
        }
        if width == 2 {
            if signed {
                if unscaled {
                    return "ldursh";
                }
                return "ldrsh";
            }
            if unscaled {
                return "ldurh";
            }
            return "ldrh";
        }
        if signed {
            if unscaled {
                return "ldursb";
            }
            return "ldrsb";
        }
        if unscaled {
            return "ldurb";
        }
        return "ldrb";
    }
    if width == 8 or width == 4 {
        if unscaled {
            return "stur";
        }
        return "str";
    }
    if width == 2 {
        if unscaled {
            return "sturh";
        }
        return "strh";
    }
    if unscaled {
        return "sturb";
    }
    return "strb";
}

/// Reports whether the data register of a load or store is spelled as an
/// x register.
fn data_wide(load: bool, width: i64, signed: bool) -> bool {
    if width == 8 {
        return true;
    }
    return load and signed;
}

/// Writes one load or store of width bytes at base + offset, forming an
/// address that does not fit the instruction in x15 first.
fn print_mem(allocator: Allocator, out: &var Out, load: bool, data: i64, base: i64, offset: i64, width: i64, signed: bool) -> !void {
    var at_base = base;
    var at_offset = offset;
    let scaled = offset >= 0 and offset % width == 0 and offset / width < 4096;
    let unscaled = offset >= 0 - 256 and offset < 256;
    if !scaled and !unscaled {
        try materialize(allocator, out, scratch_addr(), offset);
        try rrr(allocator, out, "add", scratch_addr(), base, scratch_addr());
        at_base = scratch_addr();
        at_offset = 0;
    }
    let use_unscaled = !(at_offset >= 0 and at_offset % width == 0 and at_offset / width < 4096);
    let op = mem_op(load, width, signed, use_unscaled);
    if out.binary {
        return out.word(allocator, enc_mem(load, width, signed, use_unscaled, data, at_base, at_offset), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, data, data_wide(load, width, signed));
    try text.append_bytes(allocator, ", [");
    try reg_name(allocator, text, at_base, true);
    if at_offset != 0 {
        try comma(allocator, text);
        try imm_text(allocator, text, at_offset);
    }
    try text.append_bytes(allocator, "]");
    return newline(allocator, text);
}

fn block_label(allocator: Allocator, out: &var string::String, format: Format, ordinal: i64, block: i64) -> !void {
    try symbol(allocator, out, format, "LBB");
    try fmt::append_i64(allocator, out, ordinal);
    try out.append_bytes(allocator, "_");
    return fmt::append_i64(allocator, out, block);
}

/// Writes a branch to a block: op is `b` or `b.<cond>`, word what it
/// encodes with the offset zero.
fn branch(allocator: Allocator, out: &var Out, format: Format, op: []u8, word: i64, ordinal: i64, block: i64) -> !void {
    if out.binary {
        return out.obj.branch(allocator, word, block, word == enc_b());
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try block_label(allocator, text, format, ordinal, block);
    return newline(allocator, text);
}

/// Writes `b.<cond>` to a block.
fn branch_if(allocator: Allocator, out: &var Out, format: Format, cond: Cond, ordinal: i64, block: i64) -> !void {
    var op = string::new(allocator);
    defer op.deinit(allocator);
    if !out.binary {
        try op.append_bytes(allocator, "b.");
        try op.append_bytes(allocator, cond_spelling(cond));
    }
    let op_bytes = op.as_bytes();
    return branch(allocator, out, format, op_bytes, 0x54000000 | cond_field(cond), ordinal, block);
}

fn enc_b() -> i64 { return 0x14000000; }

/// Adds or subtracts an immediate from a register into another, through x15
/// when it does not fit one instruction.
fn add_imm(allocator: Allocator, out: &var Out, rd: i64, rn: i64, imm: i64) -> !void {
    if imm >= 0 and imm < 4096 {
        return rri(allocator, out, "add", rd, rn, imm);
    }
    if imm < 0 and imm > 0 - 4096 {
        return rri(allocator, out, "sub", rd, rn, 0 - imm);
    }
    try materialize(allocator, out, scratch_addr(), imm);
    return rrr(allocator, out, "add", rd, rn, scratch_addr());
}

/// Writes a line with no operands: ret or brk #1.
fn bare(allocator: Allocator, out: &var Out, line: []u8, word: i64) -> !void {
    if out.binary {
        return out.word(allocator, word, line);
    }
    try out.text.append_bytes(allocator, line);
    return newline(allocator, &var out.text);
}

fn print_function(
    allocator: Allocator,
    out: &var Out,
    func: &var MFunction,
    allocation: &Allocation,
    name: ir::Name,
    ordinal: i64,
    syms: &ir::NameTable,
    format: Format
) -> !void {
    let frame = plan_frame(func, allocation);
    if out.binary {
        if func.is_main {
            try out.obj.global(allocator, syms, name);
        }
        try out.obj.align(allocator, 4);
        try out.obj.define(allocator, syms, name);
        try out.obj.begin_function(allocator, func.blocks.len());
    } else {
        let name_text = ir::name_text(syms, name);
        let name_bytes = name_text.as_bytes();
        if func.is_main {
            try out.text.append_bytes(allocator, "    .globl ");
            try symbol(allocator, &var out.text, format, name_bytes);
            try newline(allocator, &var out.text);
        }
        try out.text.append_bytes(allocator, "    .p2align 4");
        try newline(allocator, &var out.text);
        try symbol(allocator, &var out.text, format, name_bytes);
        try out.text.append_bytes(allocator, ":");
        try newline(allocator, &var out.text);
    }
    if frame.needed {
        try print_prologue(allocator, out, frame, &allocation.saved);
    }
    var order_index = 0;
    while allocation.order.get(order_index) |block_id| {
        order_index = order_index + 1;
        var following = 0 - 1;
        if allocation.order.get(order_index) |next| {
            following = next;
        }
        if out.binary {
            try out.obj.place_block(block_id);
        } else {
            try block_label(allocator, &var out.text, format, ordinal, block_id);
            try out.text.append_bytes(allocator, ":");
            try newline(allocator, &var out.text);
        }
        if func.blocks.at(block_id) |block| {
            var cache = empty_cache();
            var inst_index = 0;
            while block.insts.at(inst_index) |inst| {
                inst_index = inst_index + 1;
                if is_float_op(inst.op) {
                    try print_float(allocator, out, inst, &var cache);
                    continue;
                }
                cache = empty_cache();
                if block.insts.at(inst_index) |second| {
                    if load_pair(func, inst, second) {
                        let place = resolve_base(func, inst);
                        try print_pair(allocator, out, true, inst.rd, second.rd, place.total, place.saved_at);
                        inst_index = inst_index + 1;
                        continue;
                    }
                }
                try print_inst(allocator, out, func, inst, syms, format);
            }
            match block.term {
                Open => try bare(allocator, out, "    brk #1", enc_brk()),
                Jump => {
                    if block.succ0 != following {
                        try branch(allocator, out, format, "b", enc_b(), ordinal, block.succ0);
                    }
                },
                Flags => {
                    if block.succ0 == following {
                        try branch_if(allocator, out, format, invert(block.cond), ordinal, block.succ1);
                    } else {
                        try branch_if(allocator, out, format, block.cond, ordinal, block.succ0);
                        if block.succ1 != following {
                            try branch(allocator, out, format, "b", enc_b(), ordinal, block.succ1);
                        }
                    }
                },
                Zero => try print_test_branch(allocator, out, format, false, block.treg, ordinal, block.succ0, block.succ1, following),
                NonZero => try print_test_branch(allocator, out, format, true, block.treg, ordinal, block.succ0, block.succ1, following),
                Return => {
                    if frame.needed {
                        try print_epilogue(allocator, out, frame, &allocation.saved);
                    }
                    try bare(allocator, out, "    ret", enc_ret());
                },
                Stop => {},
            }
        }
    }
    if out.binary {
        try out.obj.end_function(allocator);
    }
    return;
}

/// Writes the cbz or cbnz (nonzero) of a block that tests reg, and the
/// jump after it when the other successor does not follow.
fn print_test_branch(
    allocator: Allocator,
    out: &var Out,
    format: Format,
    nonzero: bool,
    reg: i64,
    ordinal: i64,
    taken: i64,
    other: i64,
    following: i64
) -> !void {
    if taken == following {
        try test_branch(allocator, out, format, !nonzero, reg, ordinal, other);
        return;
    }
    try test_branch(allocator, out, format, nonzero, reg, ordinal, taken);
    if other != following {
        try branch(allocator, out, format, "b", enc_b(), ordinal, other);
    }
    return;
}

/// Writes `cbz` or `cbnz reg, block`.
fn test_branch(allocator: Allocator, out: &var Out, format: Format, nonzero: bool, reg: i64, ordinal: i64, block: i64) -> !void {
    if out.binary {
        var word = 0xB4000000 | field(reg);
        if nonzero {
            word = 0xB5000000 | field(reg);
        }
        return out.obj.branch(allocator, word, block, false);
    }
    let text = &var out.text;
    if nonzero {
        try head(allocator, text, "cbnz");
    } else {
        try head(allocator, text, "cbz");
    }
    try reg_name(allocator, text, reg, true);
    try comma(allocator, text);
    try block_label(allocator, text, format, ordinal, block);
    return newline(allocator, text);
}

/// Resolves a memory base and offset: a frame slot to the stack pointer and
/// the slot's offset, an incoming argument to the frame pointer.
fn resolve_base(func: &MFunction, inst: &MInst) -> Frame {
    if inst.rn == reg_frame() {
        let slot = func.slots.get_or_panic(inst.slot);
        return Frame { needed: true, total: reg_sp(), saved_at: slot.offset + inst.imm };
    }
    if inst.rn == reg_inarg() {
        return Frame { needed: true, total: 29, saved_at: 16 + inst.imm };
    }
    return Frame { needed: true, total: inst.rn, saved_at: inst.imm };
}

/// Reports whether two loads read one 8-byte word and the next from one
/// base into two registers, the first not the base, so one ldp does both:
/// it reads the base before writing either register.
fn load_pair(func: &MFunction, first: &MInst, second: &MInst) -> bool {
    if first.op != MOp::Load or second.op != MOp::Load or first.width != 8 or second.width != 8 {
        return false;
    }
    if first.rd < 0 or first.rd >= 31 or second.rd < 0 or second.rd >= 31 or first.rd == second.rd {
        return false;
    }
    let a = resolve_base(func, first);
    let b = resolve_base(func, second);
    if a.total != b.total or first.rd == a.total {
        return false;
    }
    return b.saved_at == a.saved_at + 8 and a.saved_at >= 0 and a.saved_at <= 504 and a.saved_at % 8 == 0;
}

/// Writes `op xd, xn, xm, xa`: madd or msub.
fn rrrr(allocator: Allocator, out: &var Out, op: []u8, inst: &MInst) -> !void {
    if out.binary {
        let sub = mem::equal_bytes(op, "msub");
        return out.word(allocator, enc_madd(sub, inst.rd, inst.rn, inst.rm, inst.ra), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, inst.rd, true);
    try comma(allocator, text);
    try reg_name(allocator, text, inst.rn, true);
    try comma(allocator, text);
    try reg_name(allocator, text, inst.rm, true);
    try comma(allocator, text);
    try reg_name(allocator, text, inst.ra, true);
    return newline(allocator, text);
}

/// Writes `op xn, #imm` that only sets the flags: tst, cmp or cmn.
fn flags_imm(allocator: Allocator, out: &var Out, op: []u8, rn: i64, imm: i64) -> !void {
    if out.binary {
        if mem::equal_bytes(op, "tst") {
            return out.word(allocator, enc_logical_imm(0xF2000000, reg_zr(), rn, imm), op);
        }
        let sub = mem::equal_bytes(op, "cmp");
        return out.word(allocator, enc_add_imm(sub, true, reg_zr(), rn, imm), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, rn, true);
    try comma(allocator, text);
    try imm_text(allocator, text, imm);
    return newline(allocator, text);
}

/// Writes `csel` or `csinc xd, xn, xm, cond`.
fn conditional(allocator: Allocator, out: &var Out, increment: bool, inst: &MInst) -> !void {
    if out.binary {
        var word = 0x9A800000;
        if increment {
            word = 0x9A800400;
        }
        return out.word(allocator, word | (field(inst.rm) << 16) | (cond_field(inst.cond) << 12) | (field(inst.rn) << 5) | field(inst.rd), "csel");
    }
    let text = &var out.text;
    if increment {
        try head(allocator, text, "csinc");
    } else {
        try head(allocator, text, "csel");
    }
    try reg_name(allocator, text, inst.rd, true);
    try comma(allocator, text);
    try reg_name(allocator, text, inst.rn, true);
    try comma(allocator, text);
    try reg_name(allocator, text, inst.rm, true);
    try comma(allocator, text);
    try text.append_bytes(allocator, cond_spelling(inst.cond));
    return newline(allocator, text);
}

/// Writes the address of a symbol into rd: adrp and add of the page
/// offset, or with got the adrp and load of its global offset table slot.
fn symbol_address(allocator: Allocator, out: &var Out, inst: &MInst, got: bool, syms: &ir::NameTable, format: Format) -> !void {
    if out.binary {
        let rd = field(inst.rd);
        if got {
            try out.obj.relocate(allocator, syms, inst.sym, reloc_got_page21());
            try out.word(allocator, 0x90000000 | rd, "adrp");
            try out.obj.relocate(allocator, syms, inst.sym, reloc_got_pageoff12());
            return out.word(allocator, 0xF9400000 | (rd << 5) | rd, "ldr");
        }
        try out.obj.relocate(allocator, syms, inst.sym, reloc_page21());
        try out.word(allocator, 0x90000000 | rd, "adrp");
        try out.obj.relocate(allocator, syms, inst.sym, reloc_pageoff12());
        return out.word(allocator, 0x91000000 | (rd << 5) | rd, "add");
    }
    let text = ir::name_text(syms, inst.sym);
    let bytes = text.as_bytes();
    let line = &var out.text;
    try head(allocator, line, "adrp");
    try reg_name(allocator, line, inst.rd, true);
    try comma(allocator, line);
    if got {
        try relocated(allocator, line, format, bytes, ":got:", "@GOTPAGE");
        try newline(allocator, line);
        try head(allocator, line, "ldr");
        try reg_name(allocator, line, inst.rd, true);
        try line.append_bytes(allocator, ", [");
        try reg_name(allocator, line, inst.rd, true);
        try line.append_bytes(allocator, ", ");
        try relocated(allocator, line, format, bytes, ":got_lo12:", "@GOTPAGEOFF");
        try line.append_bytes(allocator, "]");
        return newline(allocator, line);
    }
    try relocated(allocator, line, format, bytes, "", "@PAGE");
    try newline(allocator, line);
    try head(allocator, line, "add");
    try reg_name(allocator, line, inst.rd, true);
    try comma(allocator, line);
    try reg_name(allocator, line, inst.rd, true);
    try comma(allocator, line);
    try relocated(allocator, line, format, bytes, ":lo12:", "@PAGEOFF");
    return newline(allocator, line);
}

fn print_inst(allocator: Allocator, out: &var Out, func: &MFunction, inst: &MInst, syms: &ir::NameTable, format: Format) -> !void {
    match inst.op {
        Mov => {
            if inst.rd == inst.rn {
                return;
            }
            if is_float_reg(inst.rd) or is_float_reg(inst.rn) {
                return rr(allocator, out, "fmov", inst.rd, inst.rn);
            }
            return rr(allocator, out, "mov", inst.rd, inst.rn);
        },
        MovImm => {
            if is_float_reg(inst.rd) {
                return float_constant(allocator, out, inst.rd, inst.imm);
            }
            return materialize(allocator, out, inst.rd, inst.imm);
        },
        Add => return rrr(allocator, out, "add", inst.rd, inst.rn, inst.rm),
        Sub => return rrr(allocator, out, "sub", inst.rd, inst.rn, inst.rm),
        Mul => return rrr(allocator, out, "mul", inst.rd, inst.rn, inst.rm),
        SDiv => return rrr(allocator, out, "sdiv", inst.rd, inst.rn, inst.rm),
        UDiv => return rrr(allocator, out, "udiv", inst.rd, inst.rn, inst.rm),
        And => return rrr(allocator, out, "and", inst.rd, inst.rn, inst.rm),
        Orr => return rrr(allocator, out, "orr", inst.rd, inst.rn, inst.rm),
        Eor => return rrr(allocator, out, "eor", inst.rd, inst.rn, inst.rm),
        Lsl => return rrr(allocator, out, "lsl", inst.rd, inst.rn, inst.rm),
        Lsr => return rrr(allocator, out, "lsr", inst.rd, inst.rn, inst.rm),
        Asr => return rrr(allocator, out, "asr", inst.rd, inst.rn, inst.rm),
        AddImm => return add_imm(allocator, out, inst.rd, inst.rn, inst.imm),
        SubImm => return add_imm(allocator, out, inst.rd, inst.rn, 0 - inst.imm),
        LslImm => return rri(allocator, out, "lsl", inst.rd, inst.rn, inst.imm),
        LsrImm => return rri(allocator, out, "lsr", inst.rd, inst.rn, inst.imm),
        AsrImm => return rri(allocator, out, "asr", inst.rd, inst.rn, inst.imm),
        MSub => return rrrr(allocator, out, "msub", inst),
        MAdd => return rrrr(allocator, out, "madd", inst),
        AddShift => return rrr_shifted(allocator, out, "add", inst, ", lsl "),
        SubShift => return rrr_shifted(allocator, out, "sub", inst, ", lsl "),
        AddLsr => return rrr_shifted(allocator, out, "add", inst, ", lsr "),
        SMulH => return rrr(allocator, out, "smulh", inst.rd, inst.rn, inst.rm),
        UMulH => return rrr(allocator, out, "umulh", inst.rd, inst.rn, inst.rm),
        AndImm => return rri(allocator, out, "and", inst.rd, inst.rn, inst.imm),
        TstImm => return flags_imm(allocator, out, "tst", inst.rn, inst.imm),
        Neg => return rr(allocator, out, "neg", inst.rd, inst.rn),
        Mvn => return rr(allocator, out, "mvn", inst.rd, inst.rn),
        Extend => {
            if out.binary {
                return out.word(allocator, enc_extend(inst.width, inst.signed, inst.rd, inst.rn), "extend");
            }
            var op = "sxtw";
            var wide_dst = true;
            if inst.width == 1 {
                op = "sxtb";
                if !inst.signed {
                    op = "uxtb";
                    wide_dst = false;
                }
            } else if inst.width == 2 {
                op = "sxth";
                if !inst.signed {
                    op = "uxth";
                    wide_dst = false;
                }
            } else if !inst.signed {
                op = "mov";
                wide_dst = false;
            }
            let text = &var out.text;
            try head(allocator, text, op);
            try reg_name(allocator, text, inst.rd, wide_dst);
            try comma(allocator, text);
            try reg_name(allocator, text, inst.rn, false);
            return newline(allocator, text);
        },
        Cmp => {
            if out.binary {
                var word = 0xEB00001F;
                if inst.rn == reg_sp() {
                    word = 0xEB20601F;
                }
                return out.word(allocator, word | (field(inst.rm) << 16) | (field(inst.rn) << 5), "cmp");
            }
            let text = &var out.text;
            try head(allocator, text, "cmp");
            try reg_name(allocator, text, inst.rn, true);
            try comma(allocator, text);
            try reg_name(allocator, text, inst.rm, true);
            return newline(allocator, text);
        },
        CmpImm => return flags_imm(allocator, out, "cmp", inst.rn, inst.imm),
        CmnImm => return flags_imm(allocator, out, "cmn", inst.rn, inst.imm),
        CSet => {
            if out.binary {
                return out.word(allocator, 0x9A9F07E0 | (cond_field(invert(inst.cond)) << 12) | field(inst.rd), "cset");
            }
            let text = &var out.text;
            try head(allocator, text, "cset");
            try reg_name(allocator, text, inst.rd, true);
            try comma(allocator, text);
            try text.append_bytes(allocator, cond_spelling(inst.cond));
            return newline(allocator, text);
        },
        CSInc => return conditional(allocator, out, true, inst),
        CSel => {
            if is_float_reg(inst.rd) or is_float_reg(inst.rn) or is_float_reg(inst.rm) {
                return float_select(allocator, out, inst);
            }
            return conditional(allocator, out, false, inst);
        },
        Load => {
            let place = resolve_base(func, inst);
            return print_mem(allocator, out, true, inst.rd, place.total, place.saved_at, inst.width, inst.signed);
        },
        Store => {
            let place = resolve_base(func, inst);
            return print_mem(allocator, out, false, inst.rd, place.total, place.saved_at, inst.width, false);
        },
        LoadIdx => return print_indexed(allocator, out, true, inst),
        StoreIdx => return print_indexed(allocator, out, false, inst),
        FrameAddr => {
            let slot = func.slots.get_or_panic(inst.slot);
            return add_imm(allocator, out, inst.rd, reg_sp(), slot.offset + inst.imm);
        },
        SymAddr => return symbol_address(allocator, out, inst, false, syms, format),
        GotAddr => return symbol_address(allocator, out, inst, true, syms, format),
        Call => {
            if out.binary {
                return out.obj.call(allocator, syms, inst.sym);
            }
            let text = ir::name_text(syms, inst.sym);
            let bytes = text.as_bytes();
            try head(allocator, &var out.text, "bl");
            try symbol(allocator, &var out.text, format, bytes);
            return newline(allocator, &var out.text);
        },
        CallReg => {
            if out.binary {
                return out.word(allocator, 0xD63F0000 | (field(inst.rn) << 5), "blr");
            }
            try head(allocator, &var out.text, "blr");
            try reg_name(allocator, &var out.text, inst.rn, true);
            return newline(allocator, &var out.text);
        },
        Trap => return bare(allocator, out, "    brk #1", enc_brk()),
        ParCopy => return,
        _ => return print_vector(allocator, out, inst),
    }
}

/// Returns the arrangement suffix of lanes of width bytes in a q register.
fn arrangement(width: i64) -> []u8 {
    if width == 1 {
        return ".16b";
    }
    if width == 2 {
        return ".8h";
    }
    if width == 4 {
        return ".4s";
    }
    return ".2d";
}

/// Returns the arrangement of the low 8 bytes in lanes of width bytes.
fn half_arrangement(width: i64) -> []u8 {
    if width == 1 {
        return ".8b";
    }
    if width == 2 {
        return ".4h";
    }
    return ".2s";
}

fn lane_suffix(width: i64) -> []u8 {
    if width == 1 {
        return ".b";
    }
    if width == 2 {
        return ".h";
    }
    if width == 4 {
        return ".s";
    }
    return ".d";
}

fn vreg_name(allocator: Allocator, out: &var string::String, v: i64, suffix: []u8) -> !void {
    try out.append_bytes(allocator, "v");
    try fmt::append_i64(allocator, out, v);
    return out.append_bytes(allocator, suffix);
}

/// Writes `op vd.T, vn.T, vm.T`, or with two registers when three is not
/// set; base is the encoding, sized whether it takes the lane width.
fn vvv(allocator: Allocator, out: &var Out, op: []u8, inst: &MInst, suffix: []u8, three: bool, base: i64, sized: bool) -> !void {
    if out.binary {
        return out.word(allocator, enc_vvv(base, sized, inst.width, inst.vec % 256, (inst.vec / 256) % 256, inst.vec / 65536), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try vreg_name(allocator, text, inst.vec % 256, suffix);
    try comma(allocator, text);
    try vreg_name(allocator, text, (inst.vec / 256) % 256, suffix);
    if three {
        try comma(allocator, text);
        try vreg_name(allocator, text, inst.vec / 65536, suffix);
    }
    return newline(allocator, text);
}

/// Writes `op vd.T, vn.T, #imm`: shl, sshr or ushr.
fn vshift(allocator: Allocator, out: &var Out, op: []u8, inst: &MInst, base: i64, left: bool) -> !void {
    let vd = inst.vec % 256;
    let vn = (inst.vec / 256) % 256;
    if out.binary {
        return out.word(allocator, enc_vshift(base, left, inst.width, vd, vn, inst.imm), op);
    }
    let lanes = arrangement(inst.width);
    let text = &var out.text;
    try head(allocator, text, op);
    try vreg_name(allocator, text, vd, lanes);
    try comma(allocator, text);
    try vreg_name(allocator, text, vn, lanes);
    try comma(allocator, text);
    try imm_text(allocator, text, inst.imm);
    return newline(allocator, text);
}

fn print_vector(allocator: Allocator, out: &var Out, inst: &MInst) -> !void {
    let vd = inst.vec % 256;
    let vn = (inst.vec / 256) % 256;
    let lanes = arrangement(inst.width);
    match inst.op {
        VZero => {
            if out.binary {
                return out.word(allocator, 0x6F00E400 | vd, "movi");
            }
            try head(allocator, &var out.text, "movi");
            try vreg_name(allocator, &var out.text, vd, ".2d");
            try out.text.append_bytes(allocator, ", #0");
            return newline(allocator, &var out.text);
        },
        VOnes => {
            if out.binary {
                return out.word(allocator, 0x6F07E7E0 | vd, "movi");
            }
            try head(allocator, &var out.text, "movi");
            try vreg_name(allocator, &var out.text, vd, ".2d");
            try out.text.append_bytes(allocator, ", #0xffffffffffffffff");
            return newline(allocator, &var out.text);
        },
        VDup => {
            if out.binary {
                return out.word(allocator, 0x4E000C00 | (lane_imm5(inst.width, 0) << 16) | (field(inst.rn) << 5) | vd, "dup");
            }
            try head(allocator, &var out.text, "dup");
            try vreg_name(allocator, &var out.text, vd, lanes);
            try comma(allocator, &var out.text);
            try reg_name(allocator, &var out.text, inst.rn, inst.width == 8);
            return newline(allocator, &var out.text);
        },
        VIns => {
            if out.binary {
                return out.word(allocator, 0x4E001C00 | (lane_imm5(inst.width, inst.imm) << 16) | (field(inst.rn) << 5) | vd, "ins");
            }
            try head(allocator, &var out.text, "mov");
            try vreg_name(allocator, &var out.text, vd, lane_suffix(inst.width));
            try out.text.append_bytes(allocator, "[");
            try fmt::append_i64(allocator, &var out.text, inst.imm);
            try out.text.append_bytes(allocator, "], ");
            try reg_name(allocator, &var out.text, inst.rn, inst.width == 8);
            return newline(allocator, &var out.text);
        },
        VLdp => {
            if out.binary {
                return out.word(allocator, 0xAD400000 | (((inst.imm / 16) & 127) << 15) | (vn << 10) | (field(inst.rn) << 5) | vd, "ldp q");
            }
            let text = &var out.text;
            try head(allocator, text, "ldp");
            try text.append_bytes(allocator, "q");
            try fmt::append_i64(allocator, text, vd);
            try text.append_bytes(allocator, ", q");
            try fmt::append_i64(allocator, text, vn);
            try text.append_bytes(allocator, ", [");
            try reg_name(allocator, text, inst.rn, true);
            if inst.imm != 0 {
                try comma(allocator, text);
                try imm_text(allocator, text, inst.imm);
            }
            try text.append_bytes(allocator, "]");
            return newline(allocator, text);
        },
        VAdd => return vvv(allocator, out, "add", inst, lanes, true, 0x4E208400, true),
        VSub => return vvv(allocator, out, "sub", inst, lanes, true, 0x6E208400, true),
        VAnd => return vvv(allocator, out, "and", inst, ".16b", true, 0x4E201C00, false),
        VOrr => return vvv(allocator, out, "orr", inst, ".16b", true, 0x4EA01C00, false),
        VEor => return vvv(allocator, out, "eor", inst, ".16b", true, 0x6E201C00, false),
        VSMax => return vvv(allocator, out, "smax", inst, lanes, true, 0x4E206400, true),
        VSMin => return vvv(allocator, out, "smin", inst, lanes, true, 0x4E206C00, true),
        VUMax => return vvv(allocator, out, "umax", inst, lanes, true, 0x6E206400, true),
        VUMin => return vvv(allocator, out, "umin", inst, lanes, true, 0x6E206C00, true),
        VCmGt => return vvv(allocator, out, "cmgt", inst, lanes, true, 0x4E203400, true),
        VCmHi => return vvv(allocator, out, "cmhi", inst, lanes, true, 0x6E203400, true),
        VCmEq => return vvv(allocator, out, "cmeq", inst, lanes, true, 0x6E208C00, true),
        VCmGe => return vvv(allocator, out, "cmge", inst, lanes, true, 0x4E203C00, true),
        VCmHs => return vvv(allocator, out, "cmhs", inst, lanes, true, 0x6E203C00, true),
        VBic => return vvv(allocator, out, "bic", inst, ".16b", true, 0x4E601C00, false),
        VLdr => {
            if out.binary {
                var word = 0x3DC00000;
                if inst.imm == 8 {
                    word = 0xFD400000;
                }
                return out.word(allocator, word | (field(inst.rn) << 5) | vd, "ldr");
            }
            let text = &var out.text;
            try head(allocator, text, "ldr");
            if inst.imm == 8 {
                try text.append_bytes(allocator, "d");
            } else {
                try text.append_bytes(allocator, "q");
            }
            try fmt::append_i64(allocator, text, vd);
            try text.append_bytes(allocator, ", [");
            try reg_name(allocator, text, inst.rn, true);
            try text.append_bytes(allocator, "]");
            return newline(allocator, text);
        },
        VXtl => {
            if out.binary {
                return out.word(allocator, enc_vxtl(inst.signed, false, inst.width, vd, vn), "xtl");
            }
            let text = &var out.text;
            if inst.signed {
                try head(allocator, text, "sshll");
            } else {
                try head(allocator, text, "ushll");
            }
            try vreg_name(allocator, text, vd, arrangement(inst.width * 2));
            try comma(allocator, text);
            try vreg_name(allocator, text, vn, half_arrangement(inst.width));
            try text.append_bytes(allocator, ", #0");
            return newline(allocator, text);
        },
        VXtl2 => {
            if out.binary {
                return out.word(allocator, enc_vxtl(inst.signed, true, inst.width, vd, vn), "xtl2");
            }
            let text = &var out.text;
            if inst.signed {
                try head(allocator, text, "sshll2");
            } else {
                try head(allocator, text, "ushll2");
            }
            try vreg_name(allocator, text, vd, arrangement(inst.width * 2));
            try comma(allocator, text);
            try vreg_name(allocator, text, vn, arrangement(inst.width));
            try text.append_bytes(allocator, ", #0");
            return newline(allocator, text);
        },
        VBit => return vvv(allocator, out, "bit", inst, ".16b", true, 0x6EA01C00, false),
        VShl => return vshift(allocator, out, "shl", inst, 0x4F005400, true),
        VSShr => return vshift(allocator, out, "sshr", inst, 0x4F000400, false),
        VUShr => return vshift(allocator, out, "ushr", inst, 0x6F000400, false),
        VExt => {
            if out.binary {
                return out.word(allocator, 0x6E000000 | (vn << 16) | ((inst.imm & 15) << 11) | (vn << 5) | vd, "ext");
            }
            let text = &var out.text;
            try head(allocator, text, "ext");
            try vreg_name(allocator, text, vd, ".16b");
            try comma(allocator, text);
            try vreg_name(allocator, text, vn, ".16b");
            try comma(allocator, text);
            try vreg_name(allocator, text, vn, ".16b");
            try comma(allocator, text);
            try imm_text(allocator, text, inst.imm);
            return newline(allocator, text);
        },
        VToGpr => {
            if out.binary {
                if inst.width == 8 {
                    return out.word(allocator, 0x9E660000 | (vn << 5) | field(inst.rd), "fmov");
                }
                var word = 0x0E003C00;
                if inst.signed {
                    word = 0x4E002C00;
                }
                return out.word(allocator, word | (lane_imm5(inst.width, 0) << 16) | (vn << 5) | field(inst.rd), "mov");
            }
            let text = &var out.text;
            if inst.width == 8 {
                try head(allocator, text, "fmov");
                try reg_name(allocator, text, inst.rd, true);
                try text.append_bytes(allocator, ", d");
                try fmt::append_i64(allocator, text, vn);
                return newline(allocator, text);
            }
            if inst.signed {
                try head(allocator, text, "smov");
                try reg_name(allocator, text, inst.rd, true);
            } else {
                try head(allocator, text, "umov");
                try reg_name(allocator, text, inst.rd, false);
            }
            try comma(allocator, text);
            try vreg_name(allocator, text, vn, lane_suffix(inst.width));
            try text.append_bytes(allocator, "[0]");
            return newline(allocator, text);
        },
        _ => return,
    }
}

fn print_indexed(allocator: Allocator, out: &var Out, load: bool, inst: &MInst) -> !void {
    var signed = inst.signed;
    if !load {
        signed = false;
    }
    let op = mem_op(load, inst.width, signed, false);
    if out.binary {
        return out.word(allocator, enc_mem_indexed(load, inst.width, signed, inst.rd, inst.rn, inst.rm, inst.imm > 0), op);
    }
    let text = &var out.text;
    try head(allocator, text, op);
    try reg_name(allocator, text, inst.rd, data_wide(load, inst.width, signed));
    try text.append_bytes(allocator, ", [");
    try reg_name(allocator, text, inst.rn, true);
    try comma(allocator, text);
    try reg_name(allocator, text, inst.rm, true);
    if inst.imm > 0 {
        try text.append_bytes(allocator, ", lsl ");
        try imm_text(allocator, text, inst.imm);
    }
    try text.append_bytes(allocator, "]");
    return newline(allocator, text);
}

/// Writes the table the entry point reads a failure's name from: one
/// (pointer, length) row per error code, row 0 and codes no set declares
/// empty, each name a string literal.
fn write_error_names(allocator: Allocator, module: &ir::Module, selector: &var Selector, format: Format, sink: &var Out) -> !void {
    var rows = 1;
    var set_index = 0;
    while module.error_sets.key_at(set_index) |set_name| {
        set_index = set_index + 1;
        if module.error_sets.at(set_name) |declared| {
            var tag_index = 0;
            while declared.tags.key_at(tag_index) |member| {
                tag_index = tag_index + 1;
                let code = declared.tags.get(member) orelse 0;
                if code + 1 > rows {
                    rows = code + 1;
                }
            }
        }
    }
    var labels = array::new<i64>(allocator);
    defer labels.deinit(allocator);
    var lengths = array::new<i64>(allocator);
    defer lengths.deinit(allocator);
    for 0..rows |_row| {
        try labels.append(allocator, 0 - 1);
        try lengths.append(allocator, 0);
    }
    set_index = 0;
    while module.error_sets.key_at(set_index) |set_name| {
        set_index = set_index + 1;
        if module.error_sets.at(set_name) |declared| {
            var tag_index = 0;
            while declared.tags.key_at(tag_index) |member| {
                tag_index = tag_index + 1;
                let code = declared.tags.get(member) orelse continue;
                var spelled = try string::from_bytes(allocator, set_name);
                defer spelled.deinit(allocator);
                try spelled.append_bytes(allocator, "::");
                try spelled.append_bytes(allocator, member);
                let spelled_bytes = spelled.as_bytes();
                let held = try selector.syms.intern(spelled_bytes);
                try labels.set(code, selector.literals.len());
                try lengths.set(code, mem::len(spelled_bytes));
                try selector.literals.append(allocator, held);
            }
        }
    }
    if sink.binary {
        let obj = &var sink.obj;
        try obj.enter(allocator, &var selector.syms, SectionKind::DataConst);
        try obj.align(allocator, 3);
        let table = try selector.syms.intern("Lkz_error_names");
        try obj.define(allocator, &selector.syms, table);
        for 0..rows |row| {
            let label = labels.get_or_panic(row);
            if label >= 0 {
                let literal = try local_label(allocator, &var selector.syms, "Lkz_str.", label);
                try obj.relocate(allocator, &selector.syms, literal, reloc_unsigned());
            }
            try obj.datum(allocator, 0, 8);
            try obj.datum(allocator, lengths.get_or_panic(row), 8);
        }
        return;
    }
    return write_error_rows(allocator, format, &labels, &lengths, rows, &var sink.text);
}

/// Writes the rows of the error name table as text.
fn write_error_rows(
    allocator: Allocator,
    format: Format,
    labels: &array::Array<i64>,
    lengths: &array::Array<i64>,
    rows: i64,
    out: &var string::String
) -> !void {
    if format == Format::Elf {
        // The rows hold addresses, which a position-independent
        // executable relocates when it is loaded.
        try elf_section(allocator, out, ".data.rel.ro", "aw", ",%progbits");
    } else if format == Format::Coff {
        // The loader applies the image's base relocations to these too.
        try elf_section(allocator, out, ".rdata", "dr", "");
    } else {
        try out.append_bytes(allocator, "    .section __DATA,__const");
    }
    try newline(allocator, out);
    try out.append_bytes(allocator, "    .p2align 3");
    try newline(allocator, out);
    try symbol(allocator, out, format, "Lkz_error_names:");
    try newline(allocator, out);
    for 0..rows |row| {
        let label = labels.get_or_panic(row);
        if label < 0 {
            try out.append_bytes(allocator, "    .quad 0");
            try newline(allocator, out);
        } else {
            try out.append_bytes(allocator, "    .quad ");
            try symbol(allocator, out, format, "Lkz_str.");
            try fmt::append_i64(allocator, out, label);
            try newline(allocator, out);
        }
        try out.append_bytes(allocator, "    .quad ");
        try fmt::append_i64(allocator, out, lengths.get_or_panic(row));
        try newline(allocator, out);
    }
    return;
}
