import compiler::internal::ir;
import std::array;
import std::fmt;
import std::mem;
import std::sort;
import std::string;

// The Mach-O object the backend writes itself on Darwin arm64: the bytes of
// each section the printer fills, the symbols and relocations its lines
// name, and the file the system linker reads. It lays the object out the
// way the system assembler lays out the same lines (sections in the order
// they are first entered, a section-start symbol `ltmpN` for each, local
// symbols in the order they are first named, the others sorted by name,
// relocations last to first, the string table merged by common tail), so
// the object is the one the assembler makes of the text and the text stays
// the oracle it is checked against.

/// Is one section the printer writes into.
pub enum SectionKind {
    Text,
    DataConst,
    TextConst,
    Cstring,
}

struct Section {
    kind: SectionKind,
    bytes: string::String,
    // log2 of the widest alignment asked for in it
    align: i64,
    relocs: array::Array<Reloc>,
    // The section-start symbol.
    start: i64,
}

// The relocation types of arm64 Mach-O.
fn reloc_unsigned() -> i64 { return 0; }

fn reloc_branch26() -> i64 { return 2; }

fn reloc_page21() -> i64 { return 3; }

fn reloc_pageoff12() -> i64 { return 4; }

fn reloc_got_page21() -> i64 { return 5; }

fn reloc_got_pageoff12() -> i64 { return 6; }

fn reloc_addend() -> i64 { return 10; }

/// Is one relocation: the instruction or word at address takes symbol's
/// address plus addend, the way kind says.
struct Reloc {
    address: i64,
    symbol: i64,
    kind: i64,
    addend: i64,
}

/// Is one symbol a line names or defines. section is -1 until it is
/// defined; value is its offset in the section until the layout makes it
/// an address.
struct Symbol {
    name: ir::Name,
    section: i64,
    value: i64,
    global: bool,
    // An assembler-local label (`L...`): kept out of the symbol table unless
    // a relocation has to name it.
    temp: bool,
    named: bool,
    // The position in the written table, once it is laid out.
    index: i64,
}

/// Is one branch to a block of the function being written, patched when
/// the function ends: an imm26 (b) or an imm19 (b.cond, cbz, cbnz) word.
struct Branch {
    at: i64,
    block: i64,
    word: i64,
    wide: bool,
}

/// Is the object being written.
pub struct Obj {
    sections: array::Array<Section>,
    current: i64,
    symbols: array::Array<Symbol>,
    // by_name[name id] is the symbol's index + 1, or 0.
    by_name: array::Array<i64>,
    block_at: array::Array<i64>,
    branches: array::Array<Branch>,
    // The symbol the code being written belongs to: the last one defined
    // in the code section that is not assembler-local, or -1.
    atom: i64,
    // What no encoding holds, the first one met; empty when all did.
    pub failure: string::String,
}

/// Returns an empty object.
pub fn new_obj(allocator: Allocator) -> Obj {
    return Obj {
        sections: array::new<Section>(allocator),
        current: 0 - 1,
        symbols: array::new<Symbol>(allocator),
        by_name: array::new<i64>(allocator),
        block_at: array::new<i64>(allocator),
        branches: array::new<Branch>(allocator),
        atom: 0 - 1,
        failure: string::new(allocator)
    };
}

/// Records the first line no encoding holds.
fn (self: &var Obj) fail(allocator: Allocator, what: []u8, value: i64) -> !void {
    if self.failure.len() > 0 {
        return;
    }
    try self.failure.append_bytes(allocator, what);
    try self.failure.append_bytes(allocator, " ");
    return fmt::append_i64(allocator, &var self.failure, value);
}

/// Returns the symbol a name names, registering it on first sight: the
/// order of first sight is the order of the local symbols.
fn (self: &var Obj) symbol_of(allocator: Allocator, syms: &ir::NameTable, name: ir::Name) -> !i64 {
    let id = ir::name_id(name);
    while self.by_name.len() <= id {
        try self.by_name.append(allocator, 0);
    }
    let known = self.by_name.get_or_panic(id);
    if known > 0 {
        return known - 1;
    }
    let index = self.symbols.len();
    let text = ir::name_text(syms, name);
    let bytes = text.as_bytes();
    let temp = mem::len(bytes) > 0 and bytes[0] == cast<u8>(76);
    try self.symbols.append(allocator, Symbol {
        name: name,
        section: 0 - 1,
        value: 0,
        global: false,
        temp: temp,
        named: false,
        index: 0 - 1
    });
    try self.by_name.set(id, index + 1);
    return index;
}

/// Enters a section, creating it and its start symbol the first time.
pub fn (self: &var Obj) enter(allocator: Allocator, syms: &var ir::NameTable, kind: SectionKind) -> !void {
    var index = 0;
    while self.sections.at(index) |section| {
        if section.kind == kind {
            self.current = index;
            return;
        }
        index = index + 1;
    }
    var label = try string::from_bytes(allocator, "ltmp");
    defer label.deinit(allocator);
    try fmt::append_i64(allocator, &var label, index);
    let label_bytes = label.as_bytes();
    let name = try syms.intern(label_bytes);
    let start = try self.symbol_of(allocator, syms, name);
    if self.symbols.at_mut(start) |symbol| {
        symbol.section = index;
        symbol.value = 0;
    }
    try self.sections.append(allocator, Section {
        kind: kind,
        bytes: string::new(allocator),
        align: 0,
        relocs: array::new<Reloc>(allocator),
        start: start
    });
    self.current = index;
    return;
}

/// Returns how many bytes the current section holds.
fn (self: &Obj) here() -> i64 {
    if self.sections.at(self.current) |section| {
        return section.bytes.len();
    }
    return 0;
}

/// Appends bytes to the current section.
pub fn (self: &var Obj) bytes(allocator: Allocator, data: []u8) -> !void {
    if self.sections.at_mut(self.current) |section| {
        try section.bytes.append_bytes(allocator, data);
    }
    return;
}

/// Appends one byte to the current section.
fn (self: &var Obj) byte(allocator: Allocator, value: i64) -> !void {
    if self.sections.at_mut(self.current) |section| {
        try section.bytes.append_byte(allocator, cast<u8>(value & 255));
    }
    return;
}

/// Appends a little-endian value of size bytes.
fn (self: &var Obj) little(allocator: Allocator, value: i64, size: i64) -> !void {
    for 0..size |at| {
        try self.byte(allocator, value >> (8 * at));
    }
    return;
}

/// Appends one instruction word, or records the failure a word of -1 marks.
pub fn (self: &var Obj) word(allocator: Allocator, value: i64, what: []u8) -> !void {
    if value < 0 {
        try self.fail(allocator, what, value);
    }
    return self.little(allocator, value, 4);
}

/// Appends a little-endian value of size bytes, a datum of the section.
pub fn (self: &var Obj) datum(allocator: Allocator, value: i64, size: i64) -> !void {
    return self.little(allocator, value, size);
}

/// Pads the current section to 2^log2 bytes: with nops in code, zeros
/// elsewhere, as the assembler pads.
pub fn (self: &var Obj) align(allocator: Allocator, log2: i64) -> !void {
    var code = false;
    if self.sections.at_mut(self.current) |section| {
        if section.align < log2 {
            section.align = log2;
        }
        code = section.kind == SectionKind::Text;
    }
    let size = 1 << log2;
    while self.here() % size != 0 {
        if code {
            try self.little(allocator, enc_nop(), 4);
        } else {
            try self.byte(allocator, 0);
        }
    }
    return;
}

/// Registers a symbol `.globl` names.
pub fn (self: &var Obj) global(allocator: Allocator, syms: &ir::NameTable, name: ir::Name) -> !void {
    let index = try self.symbol_of(allocator, syms, name);
    if self.symbols.at_mut(index) |symbol| {
        symbol.global = true;
    }
    return;
}

/// Defines a symbol here.
pub fn (self: &var Obj) define(allocator: Allocator, syms: &ir::NameTable, name: ir::Name) -> !void {
    let index = try self.symbol_of(allocator, syms, name);
    let at = self.here();
    let section = self.current;
    var temp = true;
    if self.symbols.at_mut(index) |symbol| {
        symbol.section = section;
        symbol.value = at;
        temp = symbol.temp;
    }
    if self.sections.at(section) |held| {
        if !temp and held.kind == SectionKind::Text {
            self.atom = index;
        }
    }
    return;
}

/// Appends a `bl` to name. A call into the function being written (its
/// own recursion) is resolved here, as the assembler resolves a branch
/// within one atom; any other is left to the linker.
pub fn (self: &var Obj) call(allocator: Allocator, syms: &ir::NameTable, name: ir::Name) -> !void {
    let index = try self.symbol_of(allocator, syms, name);
    if index == self.atom {
        let symbol = self.symbols.get_or_panic(index);
        let distance = (symbol.value - self.here()) / 4;
        return self.little(allocator, 0x94000000 | (distance & 0x3FFFFFF), 4);
    }
    try self.relocate(allocator, syms, name, reloc_branch26());
    return self.little(allocator, 0x94000000, 4);
}

/// Records a relocation of kind against name at the next word or quad.
pub fn (self: &var Obj) relocate(allocator: Allocator, syms: &ir::NameTable, name: ir::Name, kind: i64) -> !void {
    let index = try self.symbol_of(allocator, syms, name);
    let at = self.here();
    if self.sections.at_mut(self.current) |section| {
        try section.relocs.append(allocator, Reloc { address: at, symbol: index, kind: kind, addend: 0 });
    }
    return;
}

/// Starts a function: no block has a place yet.
pub fn (self: &var Obj) begin_function(allocator: Allocator, blocks: i64) -> !void {
    self.block_at.clear(allocator);
    self.branches.clear(allocator);
    for 0..blocks |_block| {
        try self.block_at.append(allocator, 0 - 1);
    }
    return;
}

/// Places a block here.
pub fn (self: &var Obj) place_block(block: i64) -> !void {
    let at = self.here();
    try self.block_at.set(block, at);
    return;
}

/// Appends a branch to a block: word is the instruction with its offset
/// field zero, wide whether that field is the imm26 of b.
pub fn (self: &var Obj) branch(allocator: Allocator, word: i64, block: i64, wide: bool) -> !void {
    let at = self.here();
    try self.branches.append(allocator, Branch { at: at, block: block, word: word, wide: wide });
    return self.little(allocator, word, 4);
}

/// Ends a function: patches each branch with its block's offset.
pub fn (self: &var Obj) end_function(allocator: Allocator) -> !void {
    var index = 0;
    while self.branches.get(index) |branch| {
        index = index + 1;
        let target = self.block_at.get(branch.block) orelse 0 - 1;
        if target < 0 {
            try self.fail(allocator, "branch to a block never placed", branch.block);
            continue;
        }
        let distance = (target - branch.at) / 4;
        var word = branch.word;
        if branch.wide {
            if distance < 0 - (1 << 25) or distance >= (1 << 25) {
                try self.fail(allocator, "branch out of range", distance);
            }
            word = word | (distance & 0x3FFFFFF);
        } else {
            if distance < 0 - (1 << 18) or distance >= (1 << 18) {
                try self.fail(allocator, "branch out of range", distance);
            }
            word = word | ((distance & 0x7FFFF) << 5);
        }
        try self.patch(branch.at, word);
    }
    return;
}

/// Overwrites the word at an offset of the current section.
fn (self: &var Obj) patch(at: i64, word: i64) -> !void {
    if self.sections.at_mut(self.current) |section| {
        let writable = section.bytes.as_mut_bytes();
        for 0..4 |byte| {
            writable[at + byte] = cast<u8>((word >> (8 * byte)) & 255);
        }
    }
    return;
}

// Writing the file.

fn put(allocator: Allocator, out: &var string::String, value: i64, size: i64) -> !void {
    for 0..size |at| {
        try out.append_byte(allocator, cast<u8>((value >> (8 * at)) & 255));
    }
    return;
}

/// Writes a name in a 16-byte field.
fn put_name(allocator: Allocator, out: &var string::String, name: []u8) -> !void {
    try out.append_bytes(allocator, name);
    for mem::len(name)..16 |_pad| {
        try out.append_byte(allocator, cast<u8>(0));
    }
    return;
}

fn section_name(kind: SectionKind) -> []u8 {
    return match kind {
        Text => "__text",
        DataConst => "__const",
        TextConst => "__const",
        Cstring => "__cstring",
    };
}

fn segment_name(kind: SectionKind) -> []u8 {
    return match kind {
        DataConst => "__DATA",
        _ => "__TEXT",
    };
}

fn section_flags(kind: SectionKind) -> i64 {
    return match kind {
        // S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
        Text => 0x80000400,
        // S_CSTRING_LITERALS
        Cstring => 2,
        _ => 0,
    };
}

fn round_to(value: i64, size: i64) -> i64 {
    return (value + size - 1) / size * size;
}

/// Writes the object: a 64-bit arm64 MH_OBJECT whose LC_BUILD_VERSION
/// names macOS minos (the version as the load command packs it), for the
/// link to replace with the deployment target of the runtime it links
/// with.
pub fn (self: &var Obj) write(allocator: Allocator, syms: &ir::NameTable, minos: i64, out: &var string::String) -> !void {
    // A relocation against an assembler-local label in a section the
    // linker splits by symbol names the section's start and the offset
    // instead; in a section of C strings, which the linker splits by
    // content, the label itself goes in the table.
    var kinds = array::new<SectionKind>(allocator);
    defer kinds.deinit(allocator);
    var starts = array::new<i64>(allocator);
    defer starts.deinit(allocator);
    var section_index = 0;
    while self.sections.at(section_index) |section| {
        section_index = section_index + 1;
        try kinds.append(allocator, section.kind);
        try starts.append(allocator, section.start);
    }
    var unplaced = 0 - 1;
    section_index = 0;
    while self.sections.at_mut(section_index) |section| {
        section_index = section_index + 1;
        var reloc_index = 0;
        while section.relocs.at_mut(reloc_index) |reloc| {
            reloc_index = reloc_index + 1;
            let symbol = self.symbols.get_or_panic(reloc.symbol);
            if !symbol.temp {
                continue;
            }
            let kind = kinds.get(symbol.section) orelse SectionKind::Text;
            if symbol.section < 0 or kind == SectionKind::Text {
                unplaced = reloc.symbol;
                continue;
            }
            if kind == SectionKind::Cstring {
                continue;
            }
            reloc.symbol = starts.get_or_panic(symbol.section);
            reloc.addend = symbol.value;
        }
    }
    if unplaced >= 0 {
        try self.fail(allocator, "a relocation names an undefined or code label, symbol", unplaced);
    }
    // Mark what the relocations name.
    section_index = 0;
    while self.sections.at(section_index) |section| {
        section_index = section_index + 1;
        var reloc_index = 0;
        while section.relocs.get(reloc_index) |reloc| {
            reloc_index = reloc_index + 1;
            if self.symbols.at_mut(reloc.symbol) |symbol| {
                symbol.named = true;
            }
        }
    }
    // Lay the sections out.
    var addresses = array::new<i64>(allocator);
    defer addresses.deinit(allocator);
    var address = 0;
    section_index = 0;
    while self.sections.at(section_index) |section| {
        section_index = section_index + 1;
        address = round_to(address, 1 << section.align);
        try addresses.append(allocator, address);
        address = address + section.bytes.len();
    }
    let data_size = address;
    // The table: locals in the order first named, then the defined globals
    // and the undefined, each sorted by name.
    var locals = array::new<i64>(allocator);
    defer locals.deinit(allocator);
    var defined_names = array::new<string::String>(allocator);
    defer defined_names.deinit(allocator);
    var undefined_names = array::new<string::String>(allocator);
    defer undefined_names.deinit(allocator);
    var symbol_index = 0;
    while self.symbols.at(symbol_index) |symbol| {
        let text = ir::name_text(syms, symbol.name);
        let bytes = text.as_bytes();
        if symbol.section < 0 {
            try undefined_names.append(allocator, try string::from_bytes(allocator, bytes));
        } else if symbol.global {
            try defined_names.append(allocator, try string::from_bytes(allocator, bytes));
        } else if !symbol.temp or symbol.named {
            try locals.append(allocator, symbol_index);
        }
        symbol_index = symbol_index + 1;
    }
    try sort::strings(&var defined_names);
    try sort::strings(&var undefined_names);
    var table = array::new<i64>(allocator);
    defer table.deinit(allocator);
    var local_index = 0;
    while locals.get(local_index) |index| {
        local_index = local_index + 1;
        try table.append(allocator, index);
    }
    try self.append_sorted(allocator, syms, &defined_names, &var table);
    try self.append_sorted(allocator, syms, &undefined_names, &var table);
    var position = 0;
    while table.get(position) |index| {
        if self.symbols.at_mut(index) |symbol| {
            symbol.index = position;
        }
        position = position + 1;
    }
    // The strings, merged by common tail.
    var strings = string::new(allocator);
    defer strings.deinit(allocator);
    var offsets = array::new<i64>(allocator);
    defer offsets.deinit(allocator);
    try self.string_table(allocator, syms, &table, &var strings, &var offsets);
    // Where everything goes.
    let nsects = self.sections.len();
    let segment_size = 72 + 80 * nsects;
    let commands = segment_size + 24 + 24 + 80;
    let data_start = 32 + commands;
    var reloc_start = round_to(data_start + data_size, 8);
    var reloc_at = array::new<i64>(allocator);
    defer reloc_at.deinit(allocator);
    var relocs_end = reloc_start;
    section_index = 0;
    while self.sections.at(section_index) |section| {
        section_index = section_index + 1;
        try reloc_at.append(allocator, relocs_end);
        relocs_end = relocs_end + 8 * reloc_entries(&section.relocs);
    }
    let symoff = relocs_end;
    let stroff = symoff + 16 * table.len();
    // mach_header_64
    try put(allocator, out, 0xFEEDFACF, 4);
    try put(allocator, out, 0x0100000C, 4);
    try put(allocator, out, 0, 4);
    try put(allocator, out, 1, 4);
    try put(allocator, out, 4, 4);
    try put(allocator, out, commands, 4);
    // MH_SUBSECTIONS_VIA_SYMBOLS
    try put(allocator, out, 0x2000, 4);
    try put(allocator, out, 0, 4);
    // LC_SEGMENT_64, unnamed, holding every section
    try put(allocator, out, 0x19, 4);
    try put(allocator, out, segment_size, 4);
    try put_name(allocator, out, "");
    try put(allocator, out, 0, 8);
    try put(allocator, out, data_size, 8);
    try put(allocator, out, data_start, 8);
    try put(allocator, out, data_size, 8);
    try put(allocator, out, 7, 4);
    try put(allocator, out, 7, 4);
    try put(allocator, out, nsects, 4);
    try put(allocator, out, 0, 4);
    section_index = 0;
    while self.sections.at(section_index) |section| {
        let at = addresses.get_or_panic(section_index);
        try put_name(allocator, out, section_name(section.kind));
        try put_name(allocator, out, segment_name(section.kind));
        try put(allocator, out, at, 8);
        try put(allocator, out, section.bytes.len(), 8);
        try put(allocator, out, data_start + at, 4);
        try put(allocator, out, section.align, 4);
        let entries = reloc_entries(&section.relocs);
        if entries > 0 {
            try put(allocator, out, reloc_at.get_or_panic(section_index), 4);
        } else {
            try put(allocator, out, 0, 4);
        }
        try put(allocator, out, entries, 4);
        try put(allocator, out, section_flags(section.kind), 4);
        try put(allocator, out, 0, 12);
        section_index = section_index + 1;
    }
    // LC_BUILD_VERSION: macOS, no SDK named, no tools
    try put(allocator, out, 0x32, 4);
    try put(allocator, out, 24, 4);
    try put(allocator, out, 1, 4);
    try put(allocator, out, minos, 4);
    try put(allocator, out, 0, 4);
    try put(allocator, out, 0, 4);
    // LC_SYMTAB
    try put(allocator, out, 2, 4);
    try put(allocator, out, 24, 4);
    try put(allocator, out, symoff, 4);
    try put(allocator, out, table.len(), 4);
    try put(allocator, out, stroff, 4);
    try put(allocator, out, strings.len(), 4);
    // LC_DYSYMTAB: the three runs of the table
    let defined = defined_names.len();
    let undefined = undefined_names.len();
    try put(allocator, out, 0xB, 4);
    try put(allocator, out, 80, 4);
    try put(allocator, out, 0, 4);
    try put(allocator, out, locals.len(), 4);
    try put(allocator, out, locals.len(), 4);
    try put(allocator, out, defined, 4);
    try put(allocator, out, locals.len() + defined, 4);
    try put(allocator, out, undefined, 4);
    try put(allocator, out, 0, 48);
    // The section contents, each at its address.
    section_index = 0;
    while self.sections.at(section_index) |section| {
        let at = data_start + addresses.get_or_panic(section_index);
        while out.len() < at {
            try out.append_byte(allocator, cast<u8>(0));
        }
        let contents = section.bytes.as_bytes();
        try out.append_bytes(allocator, contents);
        section_index = section_index + 1;
    }
    while out.len() < reloc_start {
        try out.append_byte(allocator, cast<u8>(0));
    }
    // The relocations of each section, last first, an addend before the
    // relocation it belongs to.
    section_index = 0;
    while self.sections.at(section_index) |section| {
        section_index = section_index + 1;
        var reloc_index = section.relocs.len() - 1;
        while reloc_index >= 0 {
            let reloc = section.relocs.get_or_panic(reloc_index);
            reloc_index = reloc_index - 1;
            if reloc.addend != 0 {
                try put(allocator, out, reloc.address, 4);
                try put(allocator, out, (reloc.addend & 0xFFFFFF) | (2 << 25) | (reloc_addend() << 28), 4);
            }
            let symbol = self.symbols.get_or_panic(reloc.symbol);
            var info = symbol.index | (1 << 27) | (reloc.kind << 28);
            if reloc.kind == reloc_unsigned() {
                info = info | (3 << 25);
            } else {
                info = info | (2 << 25);
            }
            if reloc.kind == reloc_branch26() or reloc.kind == reloc_page21() or reloc.kind == reloc_got_page21() {
                info = info | (1 << 24);
            }
            try put(allocator, out, reloc.address, 4);
            try put(allocator, out, info, 4);
        }
    }
    // nlist_64 entries
    position = 0;
    while table.get(position) |index| {
        let symbol = self.symbols.get_or_panic(index);
        try put(allocator, out, offsets.get_or_panic(position), 4);
        if symbol.section < 0 {
            // N_UNDF | N_EXT
            try put(allocator, out, 1, 1);
            try put(allocator, out, 0, 1);
            try put(allocator, out, 0, 2);
            try put(allocator, out, 0, 8);
        } else {
            // N_SECT, | N_EXT for a global
            var kind = 0xE;
            if symbol.global {
                kind = 0xF;
            }
            try put(allocator, out, kind, 1);
            try put(allocator, out, symbol.section + 1, 1);
            try put(allocator, out, 0, 2);
            try put(allocator, out, addresses.get_or_panic(symbol.section) + symbol.value, 8);
        }
        position = position + 1;
    }
    return out.append_string(allocator, &strings);
}

/// Returns how many entries a section's relocations take: an addend is an
/// entry of its own.
fn reloc_entries(relocs: &array::Array<Reloc>) -> i64 {
    var count = 0;
    var index = 0;
    while relocs.get(index) |reloc| {
        index = index + 1;
        count = count + 1;
        if reloc.addend != 0 {
            count = count + 1;
        }
    }
    return count;
}

/// Appends the symbols of sorted names to the table, in that order.
fn (self: &Obj) append_sorted(
    allocator: Allocator,
    syms: &ir::NameTable,
    names: &array::Array<string::String>,
    table: &var array::Array<i64>
) -> !void {
    var index = 0;
    while names.at(index) |name| {
        index = index + 1;
        let bytes = name.as_bytes();
        if syms.lookup(bytes) |held| {
            let known = self.by_name.get(ir::name_id(held)) orelse 0;
            if known > 0 {
                try table.append(allocator, known - 1);
            }
        }
    }
    return;
}

/// Builds the string table of the symbols in table: a zero byte, then the
/// names ordered by their reversed spelling, greatest first, so a name that
/// ends another follows it and is found at that one's tail rather than
/// written again; padded to eight bytes. offsets gets each symbol's
/// string offset, in table order.
fn (self: &Obj) string_table(
    allocator: Allocator,
    syms: &ir::NameTable,
    table: &array::Array<i64>,
    out: &var string::String,
    offsets: &var array::Array<i64>
) -> !void {
    var reversed = array::new<string::String>(allocator);
    defer reversed.deinit(allocator);
    var position = 0;
    while table.get(position) |index| {
        position = position + 1;
        let symbol = self.symbols.get_or_panic(index);
        let text = ir::name_text(syms, symbol.name);
        let bytes = text.as_bytes();
        var back = string::new(allocator);
        errdefer back.deinit(allocator);
        var at = mem::len(bytes);
        while at > 0 {
            at = at - 1;
            try back.append_byte(allocator, bytes[at]);
        }
        try reversed.append(allocator, move back);
    }
    try sort::strings(&var reversed);
    try out.append_byte(allocator, cast<u8>(0));
    // by_offset[symbol] is the string offset of the symbol's name.
    var by_symbol = array::new<i64>(allocator);
    defer by_symbol.deinit(allocator);
    for 0..self.symbols.len() |_symbol| {
        try by_symbol.append(allocator, 0);
    }
    var previous_start = 0 - 1;
    var previous_len = 0;
    var sorted_index = reversed.len() - 1;
    var name = string::new(allocator);
    defer name.deinit(allocator);
    while sorted_index >= 0 {
        var back_bytes = array::new<u8>(allocator);
        defer back_bytes.deinit(allocator);
        if reversed.at(sorted_index) |back| {
            let back_view = back.as_bytes();
            try back_bytes.append_bytes(allocator, back_view);
        }
        sorted_index = sorted_index - 1;
        name.clear();
        var at = back_bytes.len();
        while at > 0 {
            at = at - 1;
            try name.append_byte(allocator, back_bytes.get_or_panic(at));
        }
        let name_bytes = name.as_bytes();
        let size = mem::len(name_bytes);
        var offset = 0;
        // A name that ends the one written last is found at its tail.
        if previous_start >= 0 and previous_len >= size and
            tail_matches(out, previous_start + previous_len - size, name_bytes) {
            offset = previous_start + previous_len - size;
        } else {
            offset = out.len();
            try out.append_bytes(allocator, name_bytes);
            try out.append_byte(allocator, cast<u8>(0));
            previous_start = offset;
            previous_len = size;
        }
        if syms.lookup(name_bytes) |held| {
            let known = self.by_name.get(ir::name_id(held)) orelse 0;
            if known > 0 {
                try by_symbol.set(known - 1, offset);
            }
        }
    }
    while out.len() % 8 != 0 {
        try out.append_byte(allocator, cast<u8>(0));
    }
    position = 0;
    while table.get(position) |index| {
        position = position + 1;
        try offsets.append(allocator, by_symbol.get_or_panic(index));
    }
    return;
}

/// Reports whether the bytes of out at start are name and nothing after it
/// but the terminator the name written last ends with.
fn tail_matches(out: &string::String, start: i64, name: []u8) -> bool {
    let all = out.as_bytes();
    return mem::equal_bytes(all[start..start + mem::len(name)], name);
}
