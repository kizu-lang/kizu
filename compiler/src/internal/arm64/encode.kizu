import std::mem;

// The AArch64 encodings of the instructions the printer writes, one 32-bit
// word each, for the object the backend writes itself (obj.kizu). Each
// function takes the operands of one instruction and returns the word the
// assembler makes of it, including the assembler's rewrites (an alias, a
// negative immediate). A word of -1 marks an operand no encoding holds,
// which the assembler would refuse as well; the build stops on it.

/// Returns the 5-bit field of a register: the stack pointer and the zero
/// register are both 31, which the instruction reads as one or the other,
/// and a float register is its d register's number.
fn field(reg: i64) -> i64 {
    if reg == reg_sp() or reg == reg_zr() or reg < 0 {
        return 31;
    }
    if is_float_reg(reg) {
        return float_reg_index(reg);
    }
    return reg;
}

/// Returns the bit (26) that makes a load or store move a float register.
fn float_data(data: i64) -> i64 {
    if is_float_reg(data) {
        return 1 << 26;
    }
    return 0;
}

/// Encodes `op xd, xn, xm` as rrr prints it. An add or a subtract that
/// names the stack pointer takes the extended-register form, as the
/// shifted-register form reads 31 as the zero register.
fn enc_rrr(op: []u8, rd: i64, rn: i64, rm: i64) -> i64 {
    let regs = (field(rm) << 16) | (field(rn) << 5) | field(rd);
    let sp = rd == reg_sp() or rn == reg_sp();
    if mem::equal_bytes(op, "add") {
        if sp {
            return 0x8B206000 | regs;
        }
        return 0x8B000000 | regs;
    }
    if mem::equal_bytes(op, "sub") {
        if sp {
            return 0xCB206000 | regs;
        }
        return 0xCB000000 | regs;
    }
    if mem::equal_bytes(op, "mul") {
        return 0x9B007C00 | regs;
    }
    if mem::equal_bytes(op, "sdiv") {
        return 0x9AC00C00 | regs;
    }
    if mem::equal_bytes(op, "udiv") {
        return 0x9AC00800 | regs;
    }
    if mem::equal_bytes(op, "and") {
        return 0x8A000000 | regs;
    }
    if mem::equal_bytes(op, "orr") {
        return 0xAA000000 | regs;
    }
    if mem::equal_bytes(op, "eor") {
        return 0xCA000000 | regs;
    }
    if mem::equal_bytes(op, "lsl") {
        return 0x9AC02000 | regs;
    }
    if mem::equal_bytes(op, "lsr") {
        return 0x9AC02400 | regs;
    }
    if mem::equal_bytes(op, "asr") {
        return 0x9AC02800 | regs;
    }
    if mem::equal_bytes(op, "smulh") {
        return 0x9B407C00 | regs;
    }
    if mem::equal_bytes(op, "umulh") {
        return 0x9BC07C00 | regs;
    }
    return 0 - 1;
}

/// Encodes `op xd, xn, xm, <shift> #amount`: add or sub with lsl, add with
/// lsr.
fn enc_shifted(sub: bool, lsr: bool, rd: i64, rn: i64, rm: i64, amount: i64) -> i64 {
    var word = 0x8B000000;
    if sub {
        word = 0xCB000000;
    }
    if lsr {
        word = word | (1 << 22);
    }
    return word | (field(rm) << 16) | ((amount & 63) << 10) | (field(rn) << 5) | field(rd);
}

/// Encodes `madd` or `msub xd, xn, xm, xa`.
fn enc_madd(sub: bool, rd: i64, rn: i64, rm: i64, ra: i64) -> i64 {
    var word = 0x9B000000;
    if sub {
        word = 0x9B008000;
    }
    return word | (field(rm) << 16) | (field(ra) << 10) | (field(rn) << 5) | field(rd);
}

/// Encodes an add or subtract of an immediate (setting the flags for cmp
/// and cmn, whose rd is the zero register), the way the assembler reads
/// `#imm`: a negative one is the other operation, and one that is a
/// multiple of 4096 too wide for 12 bits goes in shifted.
fn enc_add_imm(sub: bool, flags: bool, rd: i64, rn: i64, imm: i64) -> i64 {
    var negate = sub;
    var value = imm;
    if value < 0 {
        negate = !negate;
        value = 0 - value;
    }
    var shift = 0;
    if value >= 4096 {
        if value % 4096 != 0 or value / 4096 >= 4096 {
            return 0 - 1;
        }
        shift = 1;
        value = value / 4096;
    }
    var word = 0x91000000;
    if negate {
        word = 0xD1000000;
    }
    if flags {
        word = word | 0x20000000;
    }
    return word | (shift << 22) | (value << 10) | (field(rn) << 5) | field(rd);
}

/// Encodes `op xd, xn, #imm` as rri prints it.
fn enc_rri(op: []u8, rd: i64, rn: i64, imm: i64) -> i64 {
    let regs = (field(rn) << 5) | field(rd);
    if mem::equal_bytes(op, "add") {
        return enc_add_imm(false, false, rd, rn, imm);
    }
    if mem::equal_bytes(op, "sub") {
        return enc_add_imm(true, false, rd, rn, imm);
    }
    if imm < 0 or imm > 63 {
        if mem::equal_bytes(op, "and") {
            return enc_logical_imm(0x92000000, rd, rn, imm);
        }
        return 0 - 1;
    }
    if mem::equal_bytes(op, "lsl") {
        // ubfm xd, xn, #(-imm mod 64), #(63 - imm)
        return 0xD3400000 | (((64 - imm) & 63) << 16) | ((63 - imm) << 10) | regs;
    }
    if mem::equal_bytes(op, "lsr") {
        return 0xD340FC00 | (imm << 16) | regs;
    }
    if mem::equal_bytes(op, "asr") {
        return 0x9340FC00 | (imm << 16) | regs;
    }
    if mem::equal_bytes(op, "and") {
        return enc_logical_imm(0x92000000, rd, rn, imm);
    }
    return 0 - 1;
}

/// Encodes `op xd, xn` as rr prints it. A mov naming the stack pointer is
/// an add of 0, as the orr it otherwise is reads 31 as the zero register.
fn enc_rr(op: []u8, rd: i64, rn: i64) -> i64 {
    if mem::equal_bytes(op, "mov") {
        if rd == reg_sp() or rn == reg_sp() {
            return 0x91000000 | (field(rn) << 5) | field(rd);
        }
        return 0xAA0003E0 | (field(rn) << 16) | field(rd);
    }
    if mem::equal_bytes(op, "neg") {
        return 0xCB0003E0 | (field(rn) << 16) | field(rd);
    }
    if mem::equal_bytes(op, "mvn") {
        return 0xAA2003E0 | (field(rn) << 16) | field(rd);
    }
    if mem::equal_bytes(op, "fmov") {
        return enc_fmov_reg(rd, rn);
    }
    return 0 - 1;
}

/// Encodes the 8-byte `fmov` rr prints when either register is a float
/// one: between float registers, or across from a general one.
fn enc_fmov_reg(rd: i64, rn: i64) -> i64 {
    if is_float_reg(rd) and is_float_reg(rn) {
        return enc_fmov_float(8, field(rd), field(rn));
    }
    if is_float_reg(rd) {
        return enc_fmov(true, 8, rn, field(rd));
    }
    if is_float_reg(rn) {
        return enc_fmov(false, 8, rd, field(rn));
    }
    return 0 - 1;
}

/// Encodes a move of a 16-bit chunk: movz, movn or movk, shifted by shift
/// bits.
fn enc_move_wide(base: i64, rd: i64, chunk: i64, shift: i64) -> i64 {
    return base | ((shift / 16) << 21) | ((chunk & 65535) << 5) | field(rd);
}

fn movz() -> i64 { return 0xD2800000; }

fn movn() -> i64 { return 0x92800000; }

fn movk() -> i64 { return 0xF2800000; }

/// Encodes a logical operation with a bitmask immediate (and, or with the
/// zero register as rd the ands of tst), or -1 when imm is not one.
fn enc_logical_imm(base: i64, rd: i64, rn: i64, imm: i64) -> i64 {
    let bits = bitmask_fields(imm);
    if bits < 0 {
        return 0 - 1;
    }
    return base | (bits << 10) | (field(rn) << 5) | field(rd);
}

/// Returns N:immr:imms (13 bits) of a 64-bit bitmask immediate, or -1: a
/// rotated run of ones repeated in elements of 2, 4, ..., 64 bits.
fn bitmask_fields(imm: i64) -> i64 {
    if imm == 0 or imm == 0 - 1 {
        return 0 - 1;
    }
    // The smallest element the value repeats in.
    var size = 64;
    while size > 2 {
        let half = size / 2;
        let mask = (1 << half) - 1;
        if (imm & mask) != ((imm >> half) & mask) {
            break;
        }
        size = half;
    }
    var element = imm;
    if size < 64 {
        element = imm & ((1 << size) - 1);
    }
    // Rotate the element right until its ones are one run at the bottom.
    let ones = count_ones(element, size);
    var rotation = 0;
    while rotation < size {
        let rotated = rotate_right(element, rotation, size);
        if rotated == low_ones(ones) {
            break;
        }
        rotation = rotation + 1;
    }
    if rotation == size {
        return 0 - 1;
    }
    // immr rotates the run back left into place: right by size - rotation.
    let immr = (size - rotation) % size;
    var n = 0;
    var imms = 0;
    if size == 64 {
        n = 1;
        imms = ones - 1;
    } else {
        // The high bits of imms name the element size: 0 then 1s.
        imms = ((~(size * 2 - 1)) & 63) | (ones - 1);
    }
    return (n << 12) | (immr << 6) | imms;
}

fn count_ones(value: i64, size: i64) -> i64 {
    var count = 0;
    for 0..size |bit| {
        if ((value >> bit) & 1) == 1 {
            count = count + 1;
        }
    }
    return count;
}

fn low_ones(count: i64) -> i64 {
    if count >= 64 {
        return 0 - 1;
    }
    return (1 << count) - 1;
}

/// Rotates the low size bits of value right by amount.
fn rotate_right(value: i64, amount: i64, size: i64) -> i64 {
    if amount == 0 {
        return value;
    }
    var mask = 0 - 1;
    if size < 64 {
        mask = (1 << size) - 1;
    }
    // A logical shift right of the 64-bit pattern: clear what an arithmetic
    // shift drags in.
    let low = (value >> amount) & ((1 << (64 - amount)) - 1);
    return (low | (value << (size - amount))) & mask;
}

/// Returns the condition field of cond.
fn cond_field(cond: Cond) -> i64 {
    return match cond {
        Eq => 0,
        Ne => 1,
        Hs => 2,
        Lo => 3,
        Mi => 4,
        Pl => 5,
        Hi => 8,
        Ls => 9,
        Ge => 10,
        Lt => 11,
        Gt => 12,
        Le => 13,
    };
}

/// Encodes a load or store of width bytes at [base + offset], in the form
/// the mnemonic mem_op chose names: the unsigned scaled offset, or with
/// unscaled the 9-bit signed one.
fn enc_mem(load: bool, width: i64, signed: bool, unscaled: bool, data: i64, base: i64, offset: i64) -> i64 {
    var size = 3;
    if width == 4 {
        size = 2;
    } else if width == 2 {
        size = 1;
    } else if width == 1 {
        size = 0;
    }
    // opc: 00 store, 01 load, 10 load signed into an x register.
    var opc = 0;
    if load {
        opc = 1;
        if signed and width < 8 {
            opc = 2;
        }
    }
    if is_float_reg(data) and (opc == 2 or width < 4) {
        return 0 - 1;
    }
    let regs = float_data(data) | (field(base) << 5) | field(data);
    if unscaled {
        if offset < 0 - 256 or offset > 255 {
            return 0 - 1;
        }
        return 0x38000000 | (size << 30) | (opc << 22) | ((offset & 511) << 12) | regs;
    }
    if offset < 0 or offset % width != 0 or offset / width >= 4096 {
        return 0 - 1;
    }
    return 0x39000000 | (size << 30) | (opc << 22) | ((offset / width) << 10) | regs;
}

/// Encodes a load or store of width bytes at [base + (index << shift)];
/// shifted is whether the line spells the `lsl`.
fn enc_mem_indexed(load: bool, width: i64, signed: bool, data: i64, base: i64, index: i64, shifted: bool) -> i64 {
    var size = 3;
    if width == 4 {
        size = 2;
    } else if width == 2 {
        size = 1;
    } else if width == 1 {
        size = 0;
    }
    var opc = 0;
    if load {
        opc = 1;
        if signed and width < 8 {
            opc = 2;
        }
    }
    if is_float_reg(data) and (opc == 2 or width < 4) {
        return 0 - 1;
    }
    var s = 0;
    if shifted {
        s = 1;
    }
    return 0x38206800 | float_data(data) | (size << 30) | (opc << 22) | (field(index) << 16) | (s << 12) | (field(base) << 5) | field(data);
}

/// Encodes `stp` or `ldp` of two x registers, or two d registers, at
/// [base + offset].
fn enc_pair(load: bool, a: i64, b: i64, base: i64, offset: i64) -> i64 {
    var word = 0xA9000000;
    if is_float_reg(a) != is_float_reg(b) {
        return 0 - 1;
    }
    if is_float_reg(a) {
        word = 0x6D000000;
    }
    if load {
        word = word | 0x00400000;
    }
    return word | (((offset / 8) & 127) << 15) | (field(b) << 10) | (field(base) << 5) | field(a);
}

/// Encodes the extensions Extend prints: sxtb, sxth, sxtw into an x
/// register, uxtb, uxth and the mov of a w register into a w one.
fn enc_extend(width: i64, signed: bool, rd: i64, rn: i64) -> i64 {
    let regs = (field(rn) << 5) | field(rd);
    if signed {
        // sbfm xd, xn, #0, #(8 * width - 1)
        return 0x93400000 | ((8 * width - 1) << 10) | regs;
    }
    if width == 4 {
        return 0x2A0003E0 | (field(rn) << 16) | field(rd);
    }
    // ubfm wd, wn, #0, #(8 * width - 1)
    return 0x53000000 | ((8 * width - 1) << 10) | regs;
}

fn enc_nop() -> i64 { return 0xD503201F; }

fn enc_ret() -> i64 { return 0xD65F03C0; }

fn enc_brk() -> i64 { return 0xD4200020; }

// Scalar floating point over d (width 8) or s (width 4) registers.

/// Returns the type bit (22) of a scalar float op of width bytes.
fn ftype(width: i64) -> i64 {
    if width == 4 {
        return 0;
    }
    return 1 << 22;
}

/// Encodes `fmov` between a general and a float register of width bytes.
fn enc_fmov(to_float: bool, width: i64, reg: i64, v: i64) -> i64 {
    if to_float {
        if width == 4 {
            return 0x1E270000 | (field(reg) << 5) | v;
        }
        return 0x9E670000 | (field(reg) << 5) | v;
    }
    if width == 4 {
        return 0x1E260000 | (v << 5) | field(reg);
    }
    return 0x9E660000 | (v << 5) | field(reg);
}

/// Encodes `fmov vd, vn` between float registers of width bytes.
fn enc_fmov_float(width: i64, vd: i64, vn: i64) -> i64 {
    return 0x1E204000 | ftype(width) | (vn << 5) | vd;
}

/// Encodes a float op of float_mnemonic's kind into vd from vn (and vm).
fn enc_float(kind: i64, width: i64, vd: i64, vn: i64, vm: i64) -> i64 {
    var word = 0x1E202800;
    if kind == float_sub() {
        word = 0x1E203800;
    } else if kind == float_mul() {
        word = 0x1E200800;
    } else if kind == float_div() {
        word = 0x1E201800;
    } else if kind == float_neg() {
        word = 0x1E214000;
    } else if kind == float_sqrt() {
        word = 0x1E21C000;
    } else if kind == float_floor() {
        word = 0x1E254000;
    } else if kind == float_ceil() {
        word = 0x1E24C000;
    } else if kind == float_trunc() {
        word = 0x1E25C000;
    }
    var m = 0;
    if vm >= 0 {
        m = vm << 16;
    }
    return word | ftype(width) | m | (vn << 5) | vd;
}

fn enc_fmadd(width: i64, vd: i64, vn: i64, vm: i64, va: i64) -> i64 {
    return 0x1F000000 | ftype(width) | (vm << 16) | (va << 10) | (vn << 5) | vd;
}

fn enc_fcsel(width: i64, vd: i64, vn: i64, vm: i64, cond: Cond) -> i64 {
    return 0x1E200C00 | ftype(width) | (vm << 16) | (cond_field(cond) << 12) | (vn << 5) | vd;
}

fn enc_fcmp(width: i64, vn: i64, vm: i64) -> i64 {
    return 0x1E202000 | ftype(width) | (vm << 16) | (vn << 5);
}

/// Encodes `fcvt` from a float of width bytes to the other width.
fn enc_fcvt(from: i64, vd: i64, vn: i64) -> i64 {
    if from == 4 {
        return 0x1E22C000 | (vn << 5) | vd;
    }
    return 0x1E624000 | (vn << 5) | vd;
}

/// Encodes `fcvtzs`/`fcvtzu` of a float of from bytes into a register of
/// width bytes.
fn enc_fcvtz(signed: bool, width: i64, from: i64, rd: i64, vn: i64) -> i64 {
    var word = 0x1E390000;
    if signed {
        word = 0x1E380000;
    }
    if width == 8 {
        word = word | (1 << 31);
    }
    return word | ftype(from) | (vn << 5) | field(rd);
}

/// Encodes `scvtf`/`ucvtf` of an x register into a float of width bytes.
fn enc_cvtf(signed: bool, width: i64, vd: i64, rn: i64) -> i64 {
    var word = 0x9E230000;
    if signed {
        word = 0x9E220000;
    }
    return word | ftype(width) | (field(rn) << 5) | vd;
}

// NEON, over full q registers unless named otherwise.

/// Returns the size field of lanes of width bytes.
fn lane_size(width: i64) -> i64 {
    if width == 1 {
        return 0;
    }
    if width == 2 {
        return 1;
    }
    if width == 4 {
        return 2;
    }
    return 3;
}

/// Encodes a three-register NEON op with its base word and, for the ops
/// over lanes, the lane width.
fn enc_vvv(base: i64, sized: bool, width: i64, vd: i64, vn: i64, vm: i64) -> i64 {
    var size = 0;
    if sized {
        size = lane_size(width) << 22;
    }
    return base | size | (vm << 16) | (vn << 5) | vd;
}

/// Encodes `fadd`/`fsub`/`fmul`/`fdiv` over the f64 lanes of full
/// registers, the FloatOp kind.
fn enc_vfloat(kind: i64, vd: i64, vn: i64, vm: i64) -> i64 {
    var word = 0x4E60D400;
    if kind == float_sub() {
        word = 0x4EE0D400;
    } else if kind == float_mul() {
        word = 0x6E60DC00;
    } else if kind == float_div() {
        word = 0x6E60FC00;
    }
    return word | (vm << 16) | (vn << 5) | vd;
}

/// Encodes `scvtf vd.2d, vn.2d`.
fn enc_vscvtf(vd: i64, vn: i64) -> i64 {
    return 0x4E61D800 | (vn << 5) | vd;
}

/// Encodes the scalar `dup` (`mov`) of lane index of vn, of width bytes,
/// into vd.
fn enc_dup_lane(width: i64, vd: i64, vn: i64, index: i64) -> i64 {
    return 0x5E000400 | (lane_imm5(width, index) << 16) | (vn << 5) | vd;
}

/// Returns the imm5 field naming lane index of lanes of width bytes.
fn lane_imm5(width: i64, index: i64) -> i64 {
    let size = lane_size(width);
    return (index << (size + 1)) | (1 << size);
}

/// Encodes a shift of each lane by imm: shl, or sshr/ushr.
fn enc_vshift(base: i64, left: bool, width: i64, vd: i64, vn: i64, imm: i64) -> i64 {
    let esize = width * 8;
    var field_bits = esize + imm;
    if !left {
        field_bits = 2 * esize - imm;
    }
    return base | (field_bits << 16) | (vn << 5) | vd;
}

/// Encodes sshll/ushll(2) of lanes of width bytes by 0.
fn enc_vxtl(signed: bool, high: bool, width: i64, vd: i64, vn: i64) -> i64 {
    var word = 0x2F00A400;
    if signed {
        word = 0x0F00A400;
    }
    if high {
        word = word | (1 << 30);
    }
    return word | ((width * 8) << 16) | (vn << 5) | vd;
}
