import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::array;
import std::float;
import std::fmt;
import std::map;
import std::mem;
import std::string;

pub enum Scalar {
    Bool,
    I8,
    I16,
    I32,
    I64,
    U8,
    U16,
    U32,
    U64,
    F32,
}

fn scalar_kind(type_name: []u8) -> ?Scalar {
    if mem::equal_bytes(type_name, "bool") {
        return Scalar::Bool;
    }
    if mem::equal_bytes(type_name, "i8") {
        return Scalar::I8;
    }
    if mem::equal_bytes(type_name, "i16") {
        return Scalar::I16;
    }
    if mem::equal_bytes(type_name, "i32") {
        return Scalar::I32;
    }
    if mem::equal_bytes(type_name, "i64") {
        return Scalar::I64;
    }
    if mem::equal_bytes(type_name, "u8") {
        return Scalar::U8;
    }
    if mem::equal_bytes(type_name, "u16") {
        return Scalar::U16;
    }
    if mem::equal_bytes(type_name, "u32") {
        return Scalar::U32;
    }
    if mem::equal_bytes(type_name, "u64") {
        return Scalar::U64;
    }
    if mem::equal_bytes(type_name, "f32") {
        return Scalar::F32;
    }
    return null;
}

fn spelling(kind: Scalar) -> []u8 {
    return match kind {
        Bool => "bool",
        I8 => "char",
        I16 => "short",
        I32 => "int",
        I64 => "long",
        U8 => "uchar",
        U16 => "ushort",
        U32 => "uint",
        U64 => "ulong",
        F32 => "float",
    };
}

enum Space {
    Device,
    Thread,
    Group,
}

fn space_spelling(space: Space) -> []u8 {
    return match space {
        Device => "device",
        Thread => "thread",
        Group => "threadgroup",
    };
}

fn space_letter(space: Space) -> u8 {
    return match space {
        Device => cast<u8>(100),
        Thread => cast<u8>(116),
        Group => cast<u8>(103),
    };
}

fn space_of_letter(letter: u8) -> Space {
    if letter == cast<u8>(116) {
        return Space::Thread;
    }
    if letter == cast<u8>(103) {
        return Space::Group;
    }
    return Space::Device;
}

pub enum Form {
    Value,
    View,
    Array,
    Pointer,
    ViewSlot,
}

pub struct Shape {
    pub form: Form,
    pub element: Scalar,
    pub count: i64,
}

fn parse_count(text: []u8, start: i64) -> ?i64 {
    var index = start;
    var count: i64 = 0;
    let length = mem::len(text);
    while index < length and text[index] >= cast<u8>(48) and text[index] <= cast<u8>(57) {
        count = count * 10 + cast<i64>(text[index] - cast<u8>(48));
        index = index + 1;
    }
    if index == start or index >= length or text[index] != cast<u8>(93) {
        return null;
    }
    return count;
}

fn digits_end(text: []u8, start: i64) -> i64 {
    var index = start;
    while index < mem::len(text) and text[index] >= cast<u8>(48) and text[index] <= cast<u8>(57) {
        index = index + 1;
    }
    return index;
}

fn array_shape(text: []u8, start: i64, form: Form) -> ?Shape {
    let length = mem::len(text);
    if start >= length or text[start] != cast<u8>(91) {
        return null;
    }
    if start + 1 < length and text[start + 1] == cast<u8>(93) {
        let element = scalar_kind(text[start + 2..length]) orelse return null;
        if element == Scalar::Bool {
            return null;
        }
        return Shape { form: Form::View, element: element, count: 0 };
    }
    let count = parse_count(text, start + 1) orelse return null;
    let close = digits_end(text, start + 1);
    let element = scalar_kind(text[close + 1..length]) orelse return null;
    return Shape { form: form, element: element, count: count };
}

pub fn shape_of(text: []u8) -> ?Shape {
    if scalar_kind(text) |kind| {
        return Shape { form: Form::Value, element: kind, count: 0 };
    }
    let length = mem::len(text);
    if length > 0 and text[0] == cast<u8>(38) {
        var start = 1;
        if length > 5 and text[1] == cast<u8>(118) and text[2] == cast<u8>(97) and text[3] == cast<u8>(114) and text[4] == cast<u8>(32) {
            start = 5;
        }
        if scalar_kind(text[start..length]) |kind| {
            return Shape { form: Form::Pointer, element: kind, count: 0 };
        }
        let shape = array_shape(text, start, Form::Pointer) orelse return null;
        if shape.form == Form::View {
            return Shape { form: Form::ViewSlot, element: shape.element, count: 0 };
        }
        return shape;
    }
    return array_shape(text, 0, Form::Array);
}

pub fn shape_named(module: &ir::Module, type_name: ir::Name) -> ?Shape {
    let retained = ir::name_text(&module.names, type_name);
    let bytes = retained.as_bytes();
    return shape_of(bytes);
}

enum Role {
    Kernel,
    Helper,
}

struct Instance {
    function: ir::Function,
    spaces: string::String,
}

struct Emitter {
    allocator: Allocator,
    out: string::String,
    prototypes: string::String,
    helpers: string::String,
    kernels: string::String,
    instances: array::Array<Instance>,
    emitted: i64,
    spaces: map::Map<i64, Space>,
    uses: map::Map<i64, i64>,
    wide_constants: map::Map<i64, ir::Name>,
    kernel_views: array::Array<i64>,
    role: Role,
    returns_value: bool,
    generation: i64,
}

fn (self: Emitter) deinit(allocator: Allocator) -> void {
    self.out.deinit(allocator);
    self.prototypes.deinit(allocator);
    self.helpers.deinit(allocator);
    self.kernels.deinit(allocator);
    self.instances.deinit(allocator);
    self.spaces.deinit(allocator);
    self.uses.deinit(allocator);
    self.wide_constants.deinit(allocator);
    self.kernel_views.deinit(allocator);
    return;
}

pub fn emit(
    allocator: Allocator,
    module: &ir::Module,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    var emitter = Emitter {
        allocator: allocator,
        out: string::new(allocator),
        prototypes: string::new(allocator),
        helpers: string::new(allocator),
        kernels: string::new(allocator),
        instances: array::new<Instance>(allocator),
        emitted: 0,
        spaces: map::new<i64, Space>(allocator),
        uses: map::new<i64, i64>(allocator),
        wide_constants: map::new<i64, ir::Name>(allocator),
        kernel_views: array::new<i64>(allocator),
        role: Role::Kernel,
        returns_value: false,
        generation: 0
    };
    defer emitter.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let node = module.function_nodes.at(function.node);
        if !module.names.is(node.export_abi, "gpu") {
            continue;
        }
        if try emitter.emit_function(module, node, Role::Kernel, "") |failed| {
            return move failed;
        }
        try emitter.kernels.append_string(allocator, &emitter.out);
    }
    while emitter.instances.at(emitter.emitted) |instance| {
        let function = instance.function;
        var spaces = string::new(allocator);
        defer spaces.deinit(allocator);
        try spaces.append_string(allocator, &instance.spaces);
        emitter.emitted = emitter.emitted + 1;
        let node = module.function_nodes.at(function.node);
        let space_bytes = spaces.as_bytes();
        if try emitter.emit_function(module, node, Role::Helper, space_bytes) |failed| {
            return move failed;
        }
        try emitter.helpers.append_string(allocator, &emitter.out);
    }
    try append_line(allocator, out, "#include <metal_stdlib>");
    try append_line(allocator, out, "using namespace metal;");
    try append_line(allocator, out, "#pragma METAL fp contract(off)");
    try append_line(allocator, out, "struct KzIds { uint thread_id; uint group_id; uint local_id; uint simdgroup_id; uint lane_id; };");
    try out.append_string(allocator, &emitter.prototypes);
    try out.append_string(allocator, &emitter.helpers);
    try out.append_string(allocator, &emitter.kernels);
    return null;
}

fn append_line(allocator: Allocator, out: &var string::String, text: []u8) -> !void {
    try out.append_bytes(allocator, text);
    try out.append_byte(allocator, cast<u8>(10));
    return;
}

fn fail(
    allocator: Allocator,
    module: &ir::Module,
    span: ast::Span,
    before: []u8,
    name: ir::Name,
    after: []u8
) -> !diagnostic::Diagnostic {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "metal error: ");
    try text.append_bytes(allocator, before);
    let retained = ir::name_text(&module.names, name);
    try text.append_string(allocator, retained);
    try text.append_bytes(allocator, after);
    let bytes = text.as_bytes();
    return try diagnostic::from_text(allocator, diagnostic::Severity::Error, span, bytes);
}

fn unsupported(module: &ir::Module, allocator: Allocator, span: ast::Span, what: []u8, type_name: ir::Name) -> !diagnostic::Diagnostic {
    return fail(allocator, module, span, what, type_name, "`, which a kernel cannot hold yet");
}

fn (self: &var Emitter) text(bytes: []u8) -> !void {
    try self.out.append_bytes(self.allocator, bytes);
    return;
}

fn (self: &var Emitter) number(value: i64) -> !void {
    return fmt::append_i64(self.allocator, &var self.out, value);
}

fn (self: &var Emitter) value(name: ir::Name) -> !void {
    try self.text("v");
    return self.number(ir::name_id(name));
}

fn (self: &var Emitter) view_pointer(name: ir::Name) -> !void {
    try self.value(name);
    return self.text("p");
}

fn (self: &var Emitter) view_length(name: ir::Name) -> !void {
    try self.value(name);
    return self.text("n");
}

fn (self: &var Emitter) storage(name: ir::Name) -> !void {
    try self.value(name);
    return self.text("s");
}

fn (self: &var Emitter) phi_input(name: ir::Name) -> !void {
    try self.text("p");
    return self.number(ir::name_id(name));
}

fn (self: &var Emitter) end_line() -> !void {
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) line(indent: []u8, bytes: []u8) -> !void {
    try self.text(indent);
    try self.text(bytes);
    return self.end_line();
}

fn (self: &var Emitter) leaf_name(module: &ir::Module, name: ir::Name) -> !void {
    let retained = ir::name_text(&module.names, name);
    let bytes = retained.as_bytes();
    var start = mem::len(bytes);
    while start > 0 and bytes[start - 1] != cast<u8>(58) {
        start = start - 1;
    }
    try self.out.append_bytes(self.allocator, bytes[start..mem::len(bytes)]);
    return;
}

fn (self: &var Emitter) instance_name(module: &ir::Module, name: ir::Name, spaces: []u8) -> !void {
    try self.leaf_name(module, name);
    try self.text("_");
    try self.number(ir::name_id(name));
    if mem::len(spaces) > 0 {
        try self.text("_");
        try self.text(spaces);
    }
    return;
}

fn (self: &Emitter) key(name: ir::Name) -> i64 {
    return self.generation * 4294967296 + ir::name_id(name);
}

fn (self: &Emitter) space_of(name: ir::Name) -> ?Space {
    return self.spaces.get(self.key(name));
}

fn (self: &Emitter) use_count(name: ir::Name) -> i64 {
    return self.uses.get(self.key(name)) orelse 0;
}

fn (self: &var Emitter) set_space(name: ir::Name, space: Space) -> !void {
    let key = self.key(name);
    if self.spaces.contains(key) {
        return;
    }
    try self.spaces.insert(self.allocator, key, space);
    return;
}

fn (self: &var Emitter) count_use(name: ir::Name) -> !void {
    let key = self.key(name);
    if self.uses.at_mut(key) |count| {
        count.* = count.* + 1;
        return;
    }
    try self.uses.insert(self.allocator, key, 1);
    return;
}

fn (self: &var Emitter) reset() -> void {
    self.out.clear();
    self.kernel_views.clear(self.allocator);
    self.generation = self.generation + 1;
    return;
}

fn (self: &var Emitter) emit_function(
    module: &ir::Module,
    node: &ir::FunctionNode,
    role: Role,
    param_spaces: []u8
) -> !?diagnostic::Diagnostic {
    self.reset();
    self.role = role;
    self.returns_value = !module.names.is(node.return_type, "void");
    if try self.assign_param_spaces(module, node, param_spaces) |failed| {
        return move failed;
    }
    try self.study_values(module, node);
    if try self.emit_signature(module, node, param_spaces) |failed| {
        return move failed;
    }
    if role == Role::Helper {
        try self.prototypes.append_string(self.allocator, &self.out);
        try self.prototypes.append_bytes(self.allocator, ";");
        try self.prototypes.append_byte(self.allocator, cast<u8>(10));
    }
    try self.line("", " {");
    if try self.emit_body(module, node) |failed| {
        return move failed;
    }
    try self.line("", "}");
    return null;
}

fn (self: &var Emitter) assign_param_spaces(module: &ir::Module, node: &ir::FunctionNode, param_spaces: []u8) -> !?diagnostic::Diagnostic {
    var position = 0;
    var view_position = 0;
    while node.params.get(position) |param| {
        position = position + 1;
        let shape = shape_named(module, param.type_name) orelse return try unsupported(module, self.allocator, ast::zero_span(),
            "a kernel parameter has type `", param.type_name);
        if shape.form == Form::Value {
            continue;
        }
        if shape.form != Form::View {
            return try unsupported(module, self.allocator, ast::zero_span(), "a kernel parameter has type `", param.type_name);
        }
        var space = Space::Device;
        if self.role == Role::Helper {
            space = space_of_letter(param_spaces[view_position]);
        } else {
            try self.kernel_views.append(self.allocator, ir::name_id(param.name));
        }
        try self.set_space(param.name, space);
        view_position = view_position + 1;
    }
    return null;
}

fn (self: &var Emitter) study_values(module: &ir::Module, node: &ir::FunctionNode) -> !void {
    var round = 0;
    while round < 3 {
        round = round + 1;
        var block_index = 0;
        while node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let instr_node = module.instrs.at(instr.node);
                if round == 1 {
                    var arg_index = 0;
                    while instr_node.args.get(arg_index) |arg| {
                        arg_index = arg_index + 1;
                        try self.count_use(arg.name);
                    }
                    var incoming_index = 0;
                    while instr_node.incoming.get(incoming_index) |incoming| {
                        incoming_index = incoming_index + 1;
                        try self.count_use(incoming.value.name);
                    }
                }
                try self.study_space(module, instr_node);
            }
            if round == 1 {
                let terminator = block_node.terminator;
                try self.count_use(terminator.value.name);
                try self.count_use(terminator.cond.name);
            }
        }
    }
    return;
}

fn (self: &var Emitter) study_space(module: &ir::Module, node: &ir::InstrNode) -> !void {
    let result = node.result.name;
    if node.op == ir::Op::Const and module.names.is(node.result.type_name, "f64") {
        let key = self.key(result);
        if !self.wide_constants.contains(key) {
            try self.wide_constants.insert(self.allocator, key, node.immediate);
        }
        return;
    }
    match node.op {
        BufferNew => try self.set_space(result, Space::Thread),
        GpuGroupArray => try self.set_space(result, Space::Group),
        RefLoad => {
            let shape = shape_named(module, node.result.type_name) orelse return;
            if shape.form == Form::View {
                try self.inherit_space(node);
                return;
            }
            try self.set_space(result, Space::Thread);
        },
        LocalSlot => {
            let source = node.args.get_or_panic(0);
            let shape = shape_named(module, source.type_name) orelse return;
            if shape.form == Form::View {
                try self.inherit_space(node);
                return;
            }
            if shape.form == Form::Array and self.use_count(source.name) == 1 {
                if self.space_of(source.name) |space| {
                    try self.set_space(result, space);
                }
                return;
            }
            try self.set_space(result, Space::Thread);
        },
        BufferAddr => try self.inherit_space(node),
        BufferAsBytes => try self.inherit_space(node),
        SliceSlice => try self.inherit_space(node),
        Id => try self.inherit_space(node),
        Phi => {
            var incoming_index = 0;
            while node.incoming.get(incoming_index) |incoming| {
                incoming_index = incoming_index + 1;
                if self.space_of(incoming.value.name) |space| {
                    try self.set_space(result, space);
                    return;
                }
            }
        },
        _ => {},
    }
    return;
}

fn (self: &var Emitter) inherit_space(node: &ir::InstrNode) -> !void {
    if self.space_of(node.args.get_or_panic(0).name) |space| {
        try self.set_space(node.result.name, space);
    }
    return;
}

fn (self: &var Emitter) emit_signature(module: &ir::Module, node: &ir::FunctionNode, param_spaces: []u8) -> !?diagnostic::Diagnostic {
    if self.role == Role::Kernel {
        try self.text("kernel void ");
        try self.leaf_name(module, node.name);
    } else {
        try self.text("static ");
        if self.returns_value {
            let shape = shape_named(module, node.return_type) orelse return try unsupported(module, self.allocator, ast::zero_span(),
                "a kernel calls a function returning `", node.return_type);
            if shape.form != Form::Value {
                return try unsupported(module, self.allocator, ast::zero_span(), "a kernel calls a function returning `", node.return_type);
            }
            try self.text(spelling(shape.element));
        } else {
            try self.text("void");
        }
        try self.text(" ");
        try self.instance_name(module, node.name, param_spaces);
    }
    try self.text("(");
    var position = 0;
    while node.params.get(position) |param| {
        let shape = shape_named(module, param.type_name) orelse return try unsupported(module, self.allocator, ast::zero_span(),
            "a kernel parameter has type `", param.type_name);
        if shape.form == Form::View {
            let space = self.space_of(param.name) orelse Space::Device;
            try self.text(space_spelling(space));
            try self.text(" ");
            try self.text(spelling(shape.element));
            try self.text(" *");
            try self.view_pointer(param.name);
            if self.role == Role::Helper {
                try self.text(", long ");
                try self.view_length(param.name);
            }
        } else {
            if self.role == Role::Kernel {
                try self.text("constant ");
                try self.text(spelling(shape.element));
                try self.text(" &");
            } else {
                try self.text(spelling(shape.element));
                try self.text(" ");
            }
            try self.value(param.name);
        }
        if self.role == Role::Kernel {
            try self.text(" [[buffer(");
            try self.number(position);
            try self.text(")]]");
        }
        try self.text(", ");
        position = position + 1;
    }
    if self.role == Role::Kernel {
        try self.text("constant long *kz_lengths [[buffer(");
        try self.number(position);
        try self.text(")]], device atomic_uint *kz_status [[buffer(");
        try self.number(position + 1);
        try self.text(")]], uint kz_thread [[thread_position_in_grid]], uint kz_group [[threadgroup_position_in_grid]], ");
        try self.text("uint kz_local [[thread_index_in_threadgroup]], uint kz_simdgroup [[simdgroup_index_in_threadgroup]], ");
        try self.text("uint kz_lane [[thread_index_in_simdgroup]])");
    } else {
        try self.text("thread bool &kz_failed, KzIds kz_ids)");
    }
    return null;
}

fn (self: &var Emitter) emit_fail_action(indent: []u8) -> !void {
    if self.role == Role::Kernel {
        try self.line(indent, "atomic_store_explicit(kz_status, 1u, memory_order_relaxed);");
        return self.line(indent, "return;");
    }
    try self.line(indent, "kz_failed = true;");
    if self.returns_value {
        return self.line(indent, "return {};");
    }
    return self.line(indent, "return;");
}

fn (self: &var Emitter) emit_body(module: &ir::Module, node: &ir::FunctionNode) -> !?diagnostic::Diagnostic {
    if self.role == Role::Kernel {
        try self.line("    ", "bool kz_failed = false;");
        try self.line("    ", "KzIds kz_ids = { kz_thread, kz_group, kz_local, kz_simdgroup, kz_lane };");
        var view_index = 0;
        while self.kernel_views.get(view_index) |id| {
            try self.text("    long v");
            try self.number(id);
            try self.text("n = kz_lengths[");
            try self.number(view_index);
            try self.text("];");
            try self.end_line();
            view_index = view_index + 1;
        }
    }
    if try self.declare_values(module, node) |failed| {
        return move failed;
    }
    var flow = try analyze_flow(self.allocator, module, node);
    defer flow.deinit(self.allocator);
    var header = 0;
    while header < flow.count {
        if flow.header.get_or_panic(header) and flow.loop_exits.get_or_panic(header) > 1 {
            return try fail(self.allocator, module, ast::zero_span(), "`", node.name,
                "` has a loop that leaves to more than one place, which the metal target cannot structure yet");
        }
        header = header + 1;
    }
    let outermost = Context { loop_header: -1, loop_exit: -1, follow: -1 };
    if try self.emit_from(module, node, &flow, 0, outermost) |failed| {
        return move failed;
    }
    return null;
}

fn (self: &var Emitter) emit_phi_entry(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let shape = shape_named(module, node.result.type_name) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel joins values of type `", node.result.type_name);
    try self.text("            ");
    if shape.form == Form::View {
        try self.view_pointer(node.result.name);
        try self.text(" = ");
        try self.phi_input(node.result.name);
        try self.text("p; ");
        try self.view_length(node.result.name);
        try self.text(" = ");
        try self.phi_input(node.result.name);
        try self.text("n;");
    } else {
        try self.value(node.result.name);
        try self.text(" = ");
        try self.phi_input(node.result.name);
        try self.text(";");
    }
    try self.end_line();
    return null;
}

fn (self: &var Emitter) declare_values(module: &ir::Module, node: &ir::FunctionNode) -> !?diagnostic::Diagnostic {
    var block_index = 0;
    while node.blocks.get(block_index) |block| {
        block_index = block_index + 1;
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            let instr_node = module.instrs.at(instr.node);
            if ir::is_empty(instr_node.result.name) or module.names.is(instr_node.result.type_name, "void") {
                continue;
            }
            if self.wide_constants.contains(self.key(instr_node.result.name)) {
                continue;
            }
            if try self.declare_value(module, instr_node) |failed| {
                return move failed;
            }
        }
    }
    return null;
}

fn (self: &var Emitter) declare_value(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let result = node.result;
    let shape = shape_named(module, result.type_name) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel computes a value of type `", result.type_name);
    let space = self.space_of(result.name) orelse Space::Thread;
    let element = spelling(shape.element);
    var form = shape.form;
    if form == Form::ViewSlot {
        form = Form::View;
    }
    match form {
        Value => {
            try self.text("    ");
            try self.text(element);
            try self.text(" ");
            try self.value(result.name);
            try self.text(";");
            if node.op == ir::Op::Phi {
                try self.text(" ");
                try self.text(element);
                try self.text(" ");
                try self.phi_input(result.name);
                try self.text(";");
            }
        },
        View => {
            if !self.spaces.contains(self.key(result.name)) {
                return try unsupported(module, self.allocator, node.span, "a kernel cannot tell where a view of type `", result.type_name);
            }
            try self.text("    ");
            try self.text(space_spelling(space));
            try self.text(" ");
            try self.text(element);
            try self.text(" *");
            try self.view_pointer(result.name);
            try self.text("; long ");
            try self.view_length(result.name);
            try self.text(";");
            if node.op == ir::Op::Phi {
                try self.text(" ");
                try self.text(space_spelling(space));
                try self.text(" ");
                try self.text(element);
                try self.text(" *");
                try self.phi_input(result.name);
                try self.text("p; long ");
                try self.phi_input(result.name);
                try self.text("n;");
            }
        },
        Array => {
            if node.op == ir::Op::GpuGroupArray and self.role == Role::Helper {
                return try fail(self.allocator, module, node.span, "`std::gpu::group_array` of type `", result.type_name,
                    "` is allowed only in the body of a gpu export");
            }
            try self.text("    ");
            try self.text(space_spelling(space));
            try self.text(" ");
            try self.text(element);
            try self.text(" ");
            try self.value(result.name);
            try self.text("[");
            try self.number(shape.count);
            try self.text("];");
        },
        ViewSlot => {},
        Pointer => {
            if node.op == ir::Op::Phi {
                return try unsupported(module, self.allocator, node.span, "a kernel joins values of type `", result.type_name);
            }
            try self.text("    ");
            try self.text(space_spelling(space));
            try self.text(" ");
            try self.text(element);
            try self.text(" *");
            try self.value(result.name);
            try self.text(";");
            if node.op == ir::Op::LocalSlot and space == Space::Thread {
                try self.text(" thread ");
                try self.text(element);
                try self.text(" ");
                try self.storage(result.name);
                if shape.count > 0 {
                    try self.text("[");
                    try self.number(shape.count);
                    try self.text("]");
                }
                try self.text(";");
            }
        },
    }
    try self.end_line();
    return null;
}

fn (self: &var Emitter) emit_view_copy(target: ir::Name, source: ir::Name) -> !void {
    try self.text("            ");
    try self.view_pointer(target);
    try self.text(" = ");
    try self.view_pointer(source);
    try self.text("; ");
    try self.view_length(target);
    try self.text(" = ");
    try self.view_length(source);
    try self.text(";");
    return self.end_line();
}

fn (self: &var Emitter) emit_copy(target: ir::Name, target_suffix: []u8, source: ir::Name, count: i64) -> !void {
    try self.text("            for (int k = 0; k < ");
    try self.number(count);
    try self.text("; k++) { ");
    try self.value(target);
    try self.text(target_suffix);
    try self.text("[k] = ");
    try self.value(source);
    try self.text("[k]; }");
    return self.end_line();
}

fn (self: &var Emitter) emit_instr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let result = node.result.name;
    match node.op {
        CondFail => {
            try self.text("            if (");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(") {");
            try self.end_line();
            try self.emit_fail_action("                ");
            try self.line("            ", "}");
            return null;
        },
        GpuGroupArray => return null,
        Const => {
            if self.wide_constants.contains(self.key(result)) {
                return null;
            }
        },
        Cast => {
            let source = node.args.get_or_panic(0);
            if self.wide_constants.get(self.key(source.name)) |literal| {
                let shape = shape_named(module, node.result.type_name) orelse return try unsupported(module, self.allocator, node.span,
                    "a kernel casts an f64 constant to `", node.result.type_name);
                if shape.element != Scalar::F32 or shape.form != Form::Value {
                    return try unsupported(module, self.allocator, node.span, "a kernel casts an f64 constant to `", node.result.type_name);
                }
                let literal_text = ir::name_text(&module.names, literal);
                let literal_bytes = literal_text.as_bytes();
                let parsed = try typ::parse_float_literal(self.allocator, literal_bytes) orelse return try fail(self.allocator, module, node.span,
                    "a kernel has the float literal `", literal, "`, which does not parse");
                try self.text("            ");
                try self.value(result);
                try self.text(" = as_type<float>(");
                try fmt::append_u64(self.allocator, &var self.out, binary32_bits(cast<f32>(parsed)));
                try self.text("u);");
                try self.end_line();
                return null;
            }
        },
        GpuBarrier => {
            try self.line("            ", "threadgroup_barrier(mem_flags::mem_threadgroup);");
            return null;
        },
        BufferNew => {
            let shape = shape_named(module, node.result.type_name) orelse return null;
            try self.text("            for (int k = 0; k < ");
            try self.number(shape.count);
            try self.text("; k++) { ");
            try self.value(result);
            try self.text("[k] = 0; }");
            try self.end_line();
            return null;
        },
        LocalSlot => {
            let source = node.args.get_or_panic(0);
            let shape = shape_named(module, source.type_name) orelse return try unsupported(module, self.allocator, node.span,
                "a kernel takes the address of a value of type `", source.type_name);
            if shape.form == Form::View {
                try self.emit_view_copy(result, source.name);
                return null;
            }
            let space = self.space_of(result) orelse Space::Thread;
            if shape.form == Form::Array and space != Space::Thread {
                try self.text("            ");
                try self.value(result);
                try self.text(" = ");
                try self.value(source.name);
                try self.text(";");
                try self.end_line();
                return null;
            }
            if shape.form == Form::Array {
                if self.use_count(source.name) == 1 {
                    try self.text("            ");
                    try self.value(result);
                    try self.text(" = ");
                    try self.value(source.name);
                    try self.text(";");
                    try self.end_line();
                    return null;
                }
                try self.emit_copy(result, "s", source.name, shape.count);
            } else {
                if shape.form != Form::Value {
                    return try unsupported(module, self.allocator, node.span, "a kernel takes the address of a value of type `", source.type_name);
                }
                try self.text("            ");
                try self.storage(result);
                try self.text(" = ");
                try self.value(source.name);
                try self.text(";");
                try self.end_line();
                try self.text("            ");
                try self.value(result);
                try self.text(" = &");
                try self.storage(result);
                try self.text(";");
                try self.end_line();
                return null;
            }
            try self.text("            ");
            try self.value(result);
            try self.text(" = ");
            try self.storage(result);
            try self.text(";");
            try self.end_line();
            return null;
        },
        RefLoad => {
            let shape = shape_named(module, node.result.type_name) orelse return try unsupported(module, self.allocator, node.span,
                "a kernel loads a value of type `", node.result.type_name);
            if shape.form == Form::Array {
                try self.emit_copy(result, "", node.args.get_or_panic(0).name, shape.count);
                return null;
            }
            if shape.form == Form::View {
                try self.emit_view_copy(result, node.args.get_or_panic(0).name);
                return null;
            }
            if shape.form != Form::Value {
                return try unsupported(module, self.allocator, node.span, "a kernel loads a value of type `", node.result.type_name);
            }
            try self.text("            ");
            try self.value(result);
            try self.text(" = *");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(";");
            try self.end_line();
            return null;
        },
        RefStore => {
            let stored = node.args.get_or_panic(1);
            let shape = shape_named(module, stored.type_name) orelse return try unsupported(module, self.allocator, node.span,
                "a kernel stores a value of type `", stored.type_name);
            if shape.form == Form::Array {
                try self.emit_copy(node.args.get_or_panic(0).name, "", stored.name, shape.count);
                return null;
            }
            if shape.form == Form::View {
                try self.emit_view_copy(node.args.get_or_panic(0).name, stored.name);
                return null;
            }
            if shape.form != Form::Value {
                return try unsupported(module, self.allocator, node.span, "a kernel stores a value of type `", stored.type_name);
            }
            try self.text("            *");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(" = ");
            try self.value(stored.name);
            try self.text(";");
            try self.end_line();
            return null;
        },
        BufferAddr => {
            try self.text("            ");
            try self.value(result);
            try self.text(" = ");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(" + ");
            try self.value(node.args.get_or_panic(1).name);
            try self.text(";");
            try self.end_line();
            return null;
        },
        BufferAsBytes => {
            let slot = node.args.get_or_panic(0);
            let shape = shape_named(module, slot.type_name) orelse return try unsupported(module, self.allocator, node.span,
                "a kernel views a value of type `", slot.type_name);
            try self.text("            ");
            try self.view_pointer(result);
            try self.text(" = ");
            try self.value(slot.name);
            try self.text("; ");
            try self.view_length(result);
            try self.text(" = ");
            try self.number(shape.count);
            try self.text(";");
            try self.end_line();
            return null;
        },
        SliceSlice => {
            let view = node.args.get_or_panic(0).name;
            let low = node.args.get_or_panic(1).name;
            let high = node.args.get_or_panic(2).name;
            try self.text("            ");
            try self.view_pointer(result);
            try self.text(" = ");
            try self.view_pointer(view);
            try self.text(" + ");
            try self.value(low);
            try self.text("; ");
            try self.view_length(result);
            try self.text(" = ");
            try self.value(high);
            try self.text(" - ");
            try self.value(low);
            try self.text(";");
            try self.end_line();
            return null;
        },
        SliceStore => {
            try self.text("            ");
            try self.view_pointer(node.args.get_or_panic(0).name);
            try self.text("[");
            try self.value(node.args.get_or_panic(1).name);
            try self.text("] = ");
            try self.value(node.args.get_or_panic(2).name);
            try self.text(";");
            try self.end_line();
            return null;
        },
        Id => {
            let source = node.args.get_or_panic(0);
            let shape = shape_named(module, source.type_name) orelse return try unsupported(module, self.allocator, node.span,
                "a kernel copies a value of type `", source.type_name);
            if shape.form == Form::View {
                try self.text("            ");
                try self.view_pointer(result);
                try self.text(" = ");
                try self.view_pointer(source.name);
                try self.text("; ");
                try self.view_length(result);
                try self.text(" = ");
                try self.view_length(source.name);
                try self.text(";");
                try self.end_line();
                return null;
            }
        },
        Call => return self.emit_call(module, node),
        _ => {},
    }
    try self.text("            ");
    if !ir::is_empty(result) and !module.names.is(node.result.type_name, "void") {
        try self.value(result);
        try self.text(" = ");
    }
    if try self.emit_expression(module, node) |failed| {
        return move failed;
    }
    try self.text(";");
    try self.end_line();
    return null;
}

fn (self: &var Emitter) emit_call(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let callee_text = ir::name_text(&module.names, node.operand);
    let callee_bytes = callee_text.as_bytes();
    let callee = module.function_named(callee_bytes) orelse return try fail(self.allocator, module, node.span,
        "a kernel calls `", node.operand, "`, which has no body the metal target can lower");
    let callee_node = module.function_nodes.at(callee.node);
    var spaces = string::new(self.allocator);
    defer spaces.deinit(self.allocator);
    var index = 0;
    while node.args.get(index) |arg| {
        index = index + 1;
        let shape = shape_named(module, arg.type_name) orelse return try unsupported(module, self.allocator, node.span,
            "a kernel passes a value of type `", arg.type_name);
        if shape.form == Form::View {
            let space = self.space_of(arg.name) orelse Space::Device;
            try spaces.append_byte(self.allocator, space_letter(space));
        } else {
            if shape.form != Form::Value {
                return try unsupported(module, self.allocator, node.span, "a kernel passes a value of type `", arg.type_name);
            }
        }
    }
    let space_bytes = spaces.as_bytes();
    try self.request_instance(callee, space_bytes);
    try self.text("            ");
    if !ir::is_empty(node.result.name) and !module.names.is(node.result.type_name, "void") {
        try self.value(node.result.name);
        try self.text(" = ");
    }
    try self.instance_name(module, callee_node.name, space_bytes);
    try self.text("(");
    index = 0;
    while node.args.get(index) |arg| {
        index = index + 1;
        let shape = shape_named(module, arg.type_name) orelse return null;
        if shape.form == Form::View {
            try self.view_pointer(arg.name);
            try self.text(", ");
            try self.view_length(arg.name);
        } else {
            try self.value(arg.name);
        }
        try self.text(", ");
    }
    try self.text("kz_failed, kz_ids);");
    try self.end_line();
    try self.line("            ", "if (kz_failed) {");
    try self.emit_fail_action("                ");
    try self.line("            ", "}");
    return null;
}

fn (self: &var Emitter) request_instance(function: ir::Function, spaces: []u8) -> !void {
    var index = 0;
    while self.instances.at(index) |instance| {
        index = index + 1;
        let existing = instance.spaces.as_bytes();
        if instance.function.node == function.node and mem::equal_bytes(existing, spaces) {
            return;
        }
    }
    let owned = try string::from_bytes(self.allocator, spaces);
    try self.instances.append(self.allocator, Instance { function: function, spaces: move owned });
    return;
}

fn (self: &var Emitter) emit_expression(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    match node.op {
        Const => {
            let shape = shape_named(module, node.result.type_name) orelse return try unsupported(module, self.allocator, node.span,
                "a kernel has a constant of type `", node.result.type_name);
            return self.emit_const(module, node, shape.element);
        },
        Id => try self.value(node.args.get_or_panic(0).name),
        GpuIndex => {
            try self.text("long(kz_ids.");
            let kind = ir::name_text(&module.names, node.immediate);
            try self.out.append_string(self.allocator, kind);
            try self.text("_id)");
        },
        GpuShuffleXor => {
            try self.text("simd_shuffle_xor(");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(", ushort(");
            try self.value(node.args.get_or_panic(1).name);
            try self.text("))");
        },
        GpuMath => {
            if module.names.is(node.immediate, "f32_from_half") {
                try self.text("float(as_type<half>(");
                try self.value(node.args.get_or_panic(0).name);
                try self.text("))");
                return null;
            }
            if module.names.is(node.immediate, "half_from_f32") {
                try self.text("as_type<ushort>(half(");
                try self.value(node.args.get_or_panic(0).name);
                try self.text("))");
                return null;
            }
            let function = ir::name_text(&module.names, node.immediate);
            try self.out.append_string(self.allocator, function);
            try self.text("(");
            var arg_index = 0;
            while node.args.get(arg_index) |arg| {
                if arg_index > 0 {
                    try self.text(", ");
                }
                arg_index = arg_index + 1;
                try self.value(arg.name);
            }
            try self.text(")");
        },
        GpuSimdMax => {
            try self.text("simd_max(");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(")");
        },
        FloatBits => {
            try self.text("as_type<uint>(");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(")");
        },
        FloatFromBits => {
            try self.text("as_type<float>(");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(")");
        },
        Cast => {
            let shape = shape_named(module, node.result.type_name) orelse return try unsupported(module, self.allocator, node.span,
                "a kernel casts to `", node.result.type_name);
            try self.text(spelling(shape.element));
            try self.text("(");
            try self.value(node.args.get_or_panic(0).name);
            try self.text(")");
        },
        Unary => {
            let operator_text = ir::name_text(&module.names, node.operand);
            try self.out.append_string(self.allocator, operator_text);
            try self.value(node.args.get_or_panic(0).name);
        },
        Binary => {
            let operator_text = ir::name_text(&module.names, node.operand);
            try self.value(node.args.get_or_panic(0).name);
            try self.text(" ");
            try self.out.append_string(self.allocator, operator_text);
            try self.text(" ");
            try self.value(node.args.get_or_panic(1).name);
        },
        SliceLen => try self.view_length(node.args.get_or_panic(0).name),
        SliceIndex => {
            try self.view_pointer(node.args.get_or_panic(0).name);
            try self.text("[");
            try self.value(node.args.get_or_panic(1).name);
            try self.text("]");
        },
        _ => {
            var message = string::new(self.allocator);
            defer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, "metal error: a kernel uses `");
            try message.append_bytes(self.allocator, ir::op_spelling(node.op));
            try message.append_bytes(self.allocator, "`, which the metal target does not support yet");
            let bytes = message.as_bytes();
            return try diagnostic::from_text(self.allocator, diagnostic::Severity::Error, node.span, bytes);
        },
    }
    return null;
}

fn (self: &var Emitter) emit_const(module: &ir::Module, node: &ir::InstrNode, kind: Scalar) -> !?diagnostic::Diagnostic {
    let literal_text = ir::name_text(&module.names, node.immediate);
    let literal = literal_text.as_bytes();
    if kind == Scalar::F32 {
        let parsed = try typ::parse_f32_literal(self.allocator, literal) orelse return try fail(self.allocator, module, node.span,
            "a kernel has the float literal `", node.immediate, "`, which does not parse");
        try self.text("as_type<float>(");
        try fmt::append_u64(self.allocator, &var self.out, binary32_bits(cast<f32>(parsed)));
        try self.text("u)");
        return null;
    }
    try self.text(spelling(kind));
    try self.text("(");
    try self.text(literal);
    if kind == Scalar::U64 {
        try self.text("ul");
    }
    try self.text(")");
    return null;
}

fn (self: &var Emitter) emit_from(
    module: &ir::Module,
    function: &ir::FunctionNode,
    flow: &Flow,
    start: i64,
    context: Context
) -> !?diagnostic::Diagnostic {
    var block = start;
    while true {
        if block < 0 or block == context.follow {
            return null;
        }
        if block == context.loop_header {
            try self.line("    ", "continue;");
            return null;
        }
        if block == context.loop_exit {
            try self.line("    ", "break;");
            return null;
        }
        if !flow.header.get_or_panic(block) {
            return self.emit_block(module, function, flow, block, context);
        }
        let exit = flow.loop_exit.get_or_panic(block);
        try self.line("    ", "while (true) {");
        let inner = Context { loop_header: block, loop_exit: exit, follow: -1 };
        if try self.emit_block(module, function, flow, block, inner) |failed| {
            return move failed;
        }
        try self.line("    ", "}");
        block = exit;
    }
    return null;
}

fn (self: &var Emitter) emit_block(
    module: &ir::Module,
    function: &ir::FunctionNode,
    flow: &Flow,
    index: i64,
    context: Context
) -> !?diagnostic::Diagnostic {
    let block = function.blocks.get_or_panic(index);
    let block_node = module.blocks.at(block.node);
    var instr_index = 0;
    while block_node.instrs.get(instr_index) |instr| {
        instr_index = instr_index + 1;
        let instr_node = module.instrs.at(instr.node);
        if instr_node.op == ir::Op::Phi {
            if try self.emit_phi_entry(module, instr_node) |failed| {
                return move failed;
            }
        }
    }
    instr_index = 0;
    while block_node.instrs.get(instr_index) |instr| {
        instr_index = instr_index + 1;
        let instr_node = module.instrs.at(instr.node);
        if instr_node.op == ir::Op::Phi {
            continue;
        }
        if try self.emit_instr(module, instr_node) |failed| {
            return move failed;
        }
    }
    let terminator = block_node.terminator;
    match terminator.op {
        Return => {
            try self.text("            return");
            if self.role == Role::Helper and self.returns_value {
                try self.text(" ");
                try self.value(terminator.value.name);
            }
            try self.text(";");
            try self.end_line();
            return null;
        },
        Unreachable => {
            try self.emit_fail_action("            ");
            return null;
        },
        Jump => {
            let target = flow.successor(index, 0);
            try self.emit_phi_assignments(module, function, block_node.name, target, "            ");
            return self.emit_from(module, function, flow, target, context);
        },
        Branch => {
            let then_target = flow.successor(index, 0);
            let else_target = flow.successor(index, 1);
            let merge = flow.ipdom.get_or_panic(index);
            let arms = Context { loop_header: context.loop_header, loop_exit: context.loop_exit, follow: merge };
            try self.text("            if (");
            try self.value(terminator.cond.name);
            try self.text(") {");
            try self.end_line();
            try self.emit_phi_assignments(module, function, block_node.name, then_target, "                ");
            if try self.emit_from(module, function, flow, then_target, arms) |failed| {
                return move failed;
            }
            try self.line("            ", "} else {");
            try self.emit_phi_assignments(module, function, block_node.name, else_target, "                ");
            if try self.emit_from(module, function, flow, else_target, arms) |failed| {
                return move failed;
            }
            try self.line("            ", "}");
            if merge < 0 {
                return null;
            }
            return self.emit_from(module, function, flow, merge, context);
        },
        None => return try fail(self.allocator, module, ast::zero_span(), "block `", block_node.name, "` has no terminator"),
    }
    return null;
}

fn (self: &var Emitter) emit_phi_assignments(module: &ir::Module, function: &ir::FunctionNode, from: ir::Name, to: i64, indent: []u8) -> !void {
    if to < 0 {
        return;
    }
    let block = function.blocks.get_or_panic(to);
    let block_node = module.blocks.at(block.node);
    var instr_index = 0;
    while block_node.instrs.get(instr_index) |instr| {
        instr_index = instr_index + 1;
        let instr_node = module.instrs.at(instr.node);
        if instr_node.op != ir::Op::Phi {
            continue;
        }
        var incoming_index = 0;
        while instr_node.incoming.get(incoming_index) |incoming| {
            incoming_index = incoming_index + 1;
            if ir::same_name(incoming.block, from) {
                try self.emit_phi_assignment(module, instr_node, incoming.value, indent);
            }
        }
    }
    return;
}

fn (self: &var Emitter) emit_phi_assignment(module: &ir::Module, phi: &ir::InstrNode, incoming: ir::Value, indent: []u8) -> !void {
    try self.text(indent);
    let shape = shape_named(module, phi.result.type_name) orelse Shape { form: Form::Value, element: Scalar::I64, count: 0 };
    if shape.form == Form::View {
        try self.phi_input(phi.result.name);
        try self.text("p = ");
        try self.view_pointer(incoming.name);
        try self.text("; ");
        try self.phi_input(phi.result.name);
        try self.text("n = ");
        try self.view_length(incoming.name);
        try self.text(";");
    } else {
        try self.phi_input(phi.result.name);
        try self.text(" = ");
        try self.value(incoming.name);
        try self.text(";");
    }
    return self.end_line();
}

pub fn binary32_bits(value: f32) -> u64 {
    let wide = float::bits(cast<f64>(value));
    let sign = (wide >> 32) & 0x80000000;
    let exponent = cast<i64>((wide >> 52) & 0x7ff);
    let fraction = wide & 0xfffffffffffff;
    if exponent == 0x7ff {
        var quiet: u64 = 0;
        if fraction != 0 {
            quiet = 0x400000 | (fraction >> 29);
        }
        return sign | 0x7f800000 | quiet;
    }
    if exponent == 0 {
        return sign;
    }
    let unbiased = exponent - 1023;
    if unbiased >= -126 {
        return sign | (cast<u64>(unbiased + 127) << 23) | (fraction >> 29);
    }
    let significand = fraction | 0x10000000000000;
    return sign | (significand >> cast<u64>(29 - 126 - unbiased));
}
