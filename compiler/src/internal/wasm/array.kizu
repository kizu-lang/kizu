import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::array;
import std::mem;
import std::string;

// Mechanical port of internal/wasm/array.go. An Array value is the inline
// wasm32 `{data, len, cap}` header; its element storage comes from the explicit
// allocator passed by every operation that may grow or release it.

fn array_header_size() -> i64 {
    return 24;
}

fn array_data_offset() -> i64 {
    return 0;
}

fn array_len_offset() -> i64 {
    return 8;
}

fn array_capacity_offset() -> i64 {
    return 16;
}

fn is_array_wasm_type(name: []u8) -> bool {
    return mem::starts_with(name, "std::array::Array<") and ir::ends_with_bytes(name, ">");
}

/// Returns T through either direct or borrowed Array<T>.
fn array_element_wasm_type(name: []u8) -> ?[]u8 {
    var start = 0;
    if mem::starts_with(name, "&var ") {
        start = 5;
    } else {
        if mem::starts_with(name, "&") {
            start = 1;
        }
    }
    let direct = name[start..mem::len(name)];
    if !is_array_wasm_type(direct) {
        return null;
    }
    return direct[18..mem::len(direct) - 1];
}

/// Copies the measured element into out and returns its wasm32 layout.
fn (self: &var Emitter) array_element_layout(
    module: &ir::Module,
    node: &ir::InstrNode,
    out: &var string::String
) -> !WasmLayoutResult {
    var container = node.result.type_name;
    if node.op != ir::Op::ArrayNew {
        let first = node.args.get(0) orelse return WasmLayoutResult::Error(try self.fail_op(
            module,
            node,
            "wasm error: `%s` was handed no Array<T>"
        ));
        container = first.type_name;
    }
    let retained = ir::name_text(&module.names, container);
    let spelling = retained.as_bytes();
    if array_element_wasm_type(spelling) |elem| {
        try out.append_bytes(self.allocator, elem);
        let outcome = try self.type_layout_bytes(module, elem);
        match outcome {
            Error(failed) => return WasmLayoutResult::Error(move failed),
            Layout(layout) => {
                return WasmLayoutResult::Layout(layout);
            },
        }
    }
    return WasmLayoutResult::Error(try self.fail_op(
        module,
        node,
        "wasm error: `%s` was handed no Array<T>"
    ));
}

fn (self: &var Emitter) array_expr1(format: []u8, a: Arg) -> !ir::Name {
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    try format_args(
        self.allocator,
        &var out,
        &self.names,
        format,
        move a,
        Arg::None,
        Arg::None,
        Arg::None
    );
    return self.names.intern_owned(move out);
}

fn (self: &var Emitter) array_expr2(format: []u8, a: Arg, b: Arg) -> !ir::Name {
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    try format_args(
        self.allocator,
        &var out,
        &self.names,
        format,
        move a,
        move b,
        Arg::None,
        Arg::None
    );
    return self.names.intern_owned(move out);
}

fn (self: &var Emitter) array_expr3(format: []u8, a: Arg, b: Arg, c: Arg) -> !ir::Name {
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    try format_args(
        self.allocator,
        &var out,
        &self.names,
        format,
        move a,
        move b,
        move c,
        Arg::None
    );
    return self.names.intern_owned(move out);
}

fn (self: &var Emitter) array_expr4(
    format: []u8,
    a: Arg,
    b: Arg,
    c: Arg,
    d: Arg
) -> !ir::Name {
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    try format_args(
        self.allocator,
        &var out,
        &self.names,
        format,
        move a,
        move b,
        move c,
        move d
    );
    return self.names.intern_owned(move out);
}

fn (self: &var Emitter) array_field_address(array: ir::Name, offset: i64) -> !ir::Name {
    return self.address_at(array, offset);
}

fn (self: &var Emitter) array_element_address(
    array: ir::Name,
    index: ir::Name,
    size: i64
) -> !ir::Name {
    let data = try self.array_field_address(array, array_data_offset());
    return self.array_expr3(
        "(i32.add (i32.load %s) (i32.wrap_i64 (i64.mul %s (i64.const %d))))",
        Arg::Str(data),
        Arg::Str(index),
        Arg::Int(size)
    );
}

/// Is how an operation reaches the `{data, len, cap}` header of the Array it
/// works on, the Go `arrayHeader`: at an address in linear memory, with the
/// storage pointer and length read from locals instead when the loop being
/// written hoisted those reads (plan_loop_hoists).
struct ArrayHeader {
    address: ir::Name,
    hoisted: bool,
    data: ir::Name,
    length: ir::Name,
}

/// Returns how the Array value reaches its header, the Go `arrayHeaderOf`.
fn (self: &var Emitter) array_header_of(module: &ir::Module, value: ir::Value) -> !ArrayHeader {
    let info = try self.value_of(module, value);
    if self.hoisted_of(value.name) |hoist| {
        return ArrayHeader {
            address: info.expr,
            hoisted: true,
            data: hoist.data,
            length: hoist.length
        };
    }
    return ArrayHeader {
        address: info.expr,
        hoisted: false,
        data: ir::empty_name(),
        length: ir::empty_name()
    };
}

/// Reads the header's storage pointer, the Go `arrayHeader.data`.
fn (self: &var Emitter) header_data(h: ArrayHeader) -> !ir::Name {
    if h.hoisted {
        return self.local_get_expr(h.data);
    }
    let address = try self.array_field_address(h.address, array_data_offset());
    return self.array_expr1("(i32.load %s)", Arg::Str(address));
}

/// Reads the header's element count, the Go `arrayHeader.length`.
fn (self: &var Emitter) header_length(h: ArrayHeader) -> !ir::Name {
    if h.hoisted {
        return self.local_get_expr(h.length);
    }
    let address = try self.array_field_address(h.address, array_len_offset());
    return self.array_expr1("(i64.load %s)", Arg::Str(address));
}

/// Reads the header's reserved element count, the Go `arrayHeader.capacity`.
fn (self: &var Emitter) header_capacity(h: ArrayHeader) -> !ir::Name {
    let address = try self.array_field_address(h.address, array_capacity_offset());
    return self.array_expr1("(i64.load %s)", Arg::Str(address));
}

/// Returns the storage address of the element at a checked index, the Go
/// `arrayHeader.element`.
fn (self: &var Emitter) header_element(h: ArrayHeader, index: ir::Name, size: i64) -> !ir::Name {
    let data = try self.header_data(h);
    return self.array_expr3(
        "(i32.add %s (i32.wrap_i64 (i64.mul %s (i64.const %d))))",
        Arg::Str(data),
        Arg::Str(index),
        Arg::Int(size)
    );
}

/// Sets the header's element count, the Go `writeArrayLength`. A loop that
/// writes it hoists no read of it, so the count is always stored where it
/// lives.
fn (self: &var Emitter) write_array_length(h: ArrayHeader, value: ir::Name) -> !void {
    let address = try self.array_field_address(h.address, array_len_offset());
    return self.line2("                (i64.store %s %s)", Arg::Str(address), Arg::Str(value));
}

fn (self: &var Emitter) write_array_instr(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    match node.op {
        ArrayNew => return self.write_array_new(module, node),
        ArrayAppend => return self.write_array_append(module, node),
        ArrayAppendBytes => return self.write_array_append_bytes(module, node),
        ArrayLen => return self.write_array_field(module, node, array_len_offset(), "array.len"),
        ArrayCapacity => return self.write_array_field(
            module,
            node,
            array_capacity_offset(),
            "array.capacity"
        ),
        ArrayReserve => return self.write_array_reserve(module, node),
        ArrayPop => return self.write_array_pop(module, node),
        ArrayPopOrPanic => return self.write_array_pop_or_panic(module, node),
        ArrayGet => return self.write_array_get(module, node),
        ArrayGetOrPanic => return self.write_array_get_or_panic(module, node),
        ArrayAt => return self.write_array_at(module, node),
        ArrayAtMut => return self.write_array_at(module, node),
        ArraySet => return self.write_array_set(module, node),
        ArraySwap => return self.write_array_swap(module, node),
        ArrayTruncate => return self.write_array_truncate(module, node),
        ArrayClear => return self.write_array_clear(module, node),
        ArrayAsBytes => return self.write_array_as_bytes(module, node),
        ArrayDeinit => return self.write_array_deinit(module, node),
        _ => return try self.fail_op(
            module,
            node,
            "wasm error: unsupported array instruction `%s`"
        ),
    }
}

fn (self: &var Emitter) write_array_new(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    if node.args.len() != 1 or
        !module.names.is(node.args.get_or_panic(0).type_name, "Allocator") or
        !is_array_wasm_type(result_type) {
        return try self.fail0("wasm error: array.new expects allocator -> Array<T>");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(_) => {},
    }
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for Array result");
    try self.write_memory_zero(slot, array_header_size());
    try self.set_value(module, node.result, slot);
    return null;
}

fn (self: &var Emitter) write_array_field(
    module: &ir::Module,
    node: &ir::InstrNode,
    offset: i64,
    op: []u8
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.result.type_name, "i64") {
        return try self.fail("wasm error: %s expects Array<T> -> i64", Arg::Lit(op));
    }
    let first = node.args.get_or_panic(0);
    let retained = ir::name_text(&module.names, first.type_name);
    let type_name = retained.as_bytes();
    if array_element_wasm_type(type_name) |_| {} else {
        return try self.fail("wasm error: %s expects Array<T> -> i64", Arg::Lit(op));
    }
    let h = try self.array_header_of(module, first);
    var field = try self.header_length(h);
    if offset == array_capacity_offset() {
        field = try self.header_capacity(h);
    }
    return self.write_scalar_result(module, node.result, field);
}

/// Appends one element, the Go `writeArrayAppend`: into the reserved tail
/// when there is room, and through the reserve helper only when the storage
/// must grow.
fn (self: &var Emitter) write_array_append(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or
        !module.names.is(node.args.get_or_panic(1).type_name, "Allocator") or
        !module.names.is(node.result.type_name, "std::mem::Error!void") {
        return try self.fail0(
            "wasm error: array.append expects Array<T>, Allocator, T -> std::mem::Error!void"
        );
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let elem_bytes = elem.as_bytes();
    let value = node.args.get_or_panic(2);
    if !module.names.is(value.type_name, elem_bytes) {
        let expected = try self.names.intern(elem_bytes);
        let got = try self.own(module, value.type_name);
        return try self.fail2(
            "wasm error: array.append expects %s, got %s",
            Arg::Str(expected),
            Arg::Str(got)
        );
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let allocator = try self.value_of(module, node.args.get_or_panic(1));
    let length = try self.header_length(h);
    let needed = try self.array_expr1("(i64.add %s (i64.const 1))", Arg::Str(length));
    let reserve = try self.array_expr4(
        "(call $__array_reserve %s %s %s (i32.const %d))",
        Arg::Str(allocator.expr),
        Arg::Str(h.address),
        Arg::Str(needed),
        Arg::Int(layout.size)
    );
    let capacity = try self.header_capacity(h);
    try self.line2("            (if (i64.lt_u %s %s)", Arg::Str(length), Arg::Str(capacity));
    try self.line("              (then");
    let ok = try self.names.intern("(i32.const 1)");
    if try self.write_array_error_slot(module, node.result, ok) |failed| {
        return move failed;
    }
    if try self.write_array_append_element(module, node, h, length, needed, layout.size) |failed| {
        return move failed;
    }
    try self.line("              )");
    try self.line("              (else");
    let slot_outcome = try self.write_array_error_result(
        module,
        node.result,
        reserve,
        "std::mem::Error",
        "OutOfMemory"
    );
    var grown = ir::empty_name();
    match slot_outcome {
        Error(failed) => return move failed,
        Name(found) => {
            grown = found;
        },
    }
    try self.line1("            (if %s", Arg::Str(grown));
    try self.line("              (then");
    if try self.write_array_append_element(module, node, h, length, needed, layout.size) |failed| {
        return move failed;
    }
    try self.line("              ))");
    try self.line("              )");
    try self.line("            )");
    return null;
}

/// Writes the success result of an append's fast path: the same two stores
/// `write_array_error_result` makes, with success as the answer.
fn (self: &var Emitter) write_array_error_slot(
    module: &ir::Module,
    result: ir::Value,
    ok: ir::Name
) -> !?diagnostic::Diagnostic {
    let outcome = try self.write_array_error_result(module, result, ok, "std::mem::Error", "OutOfMemory");
    match outcome {
        Error(failed) => return move failed,
        Name(_) => {},
    }
    return null;
}

/// Stores the appended element at the tail and counts it, the `write`
/// closure of the Go `writeArrayAppend`.
fn (self: &var Emitter) write_array_append_element(
    module: &ir::Module,
    node: &ir::InstrNode,
    h: ArrayHeader,
    length: ir::Name,
    needed: ir::Name,
    size: i64
) -> !?diagnostic::Diagnostic {
    let value = node.args.get_or_panic(2);
    let destination = try self.header_element(h, length, size);
    let value_info = try self.value_of(module, value);
    if try self.write_store_value(module, destination, 0, value.type_name, value_info) |failed| {
        return move failed;
    }
    try self.write_array_length(h, needed);
    return null;
}

/// Appends one byte slice to an Array of bytes, the Go
/// `writeArrayAppendBytes`: into the reserved tail when the run fits.
fn (self: &var Emitter) write_array_append_bytes(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or
        !module.names.is(node.args.get_or_panic(1).type_name, "Allocator") or
        !module.names.is(node.args.get_or_panic(2).type_name, "[]u8") or
        !module.names.is(node.result.type_name, "std::mem::Error!void") {
        return try self.fail0(
            "wasm error: array.append_bytes expects Array<u8>, Allocator, []u8 -> std::mem::Error!void"
        );
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(_) => {},
    }
    let elem_bytes = elem.as_bytes();
    if !mem::equal_bytes(elem_bytes, "u8") {
        return try self.fail0("wasm error: array.append_bytes expects Array<u8>");
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let allocator = try self.value_of(module, node.args.get_or_panic(1));
    let bytes = try self.value_of(module, node.args.get_or_panic(2));
    let length = try self.header_length(h);
    let byte_length_address = try self.address_at(bytes.expr, 4);
    let byte_length_32 = try self.array_expr1("(i32.load %s)", Arg::Str(byte_length_address));
    let byte_length = try self.array_expr1(
        "(i64.extend_i32_u %s)",
        Arg::Str(byte_length_32)
    );
    let needed = try self.array_expr2(
        "(i64.add %s %s)",
        Arg::Str(length),
        Arg::Str(byte_length)
    );
    let reserve = try self.array_expr3(
        "(call $__array_reserve %s %s %s (i32.const 1))",
        Arg::Str(allocator.expr),
        Arg::Str(h.address),
        Arg::Str(needed)
    );
    let capacity = try self.header_capacity(h);
    try self.line2("            (if (i64.le_u %s %s)", Arg::Str(needed), Arg::Str(capacity));
    try self.line("              (then");
    let ok = try self.names.intern("(i32.const 1)");
    if try self.write_array_error_slot(module, node.result, ok) |failed| {
        return move failed;
    }
    try self.write_array_append_run(h, bytes.expr, length, needed, byte_length_32);
    try self.line("              )");
    try self.line("              (else");
    let slot_outcome = try self.write_array_error_result(
        module,
        node.result,
        reserve,
        "std::mem::Error",
        "OutOfMemory"
    );
    var grown = ir::empty_name();
    match slot_outcome {
        Error(failed) => return move failed,
        Name(found) => {
            grown = found;
        },
    }
    try self.line1("            (if %s", Arg::Str(grown));
    try self.line("              (then");
    try self.write_array_append_run(h, bytes.expr, length, needed, byte_length_32);
    try self.line("              ))");
    try self.line("              )");
    try self.line("            )");
    return null;
}

/// Copies the run to the tail and counts it, the `write` closure of the Go
/// `writeArrayAppendBytes`.
fn (self: &var Emitter) write_array_append_run(
    h: ArrayHeader,
    bytes_expr: ir::Name,
    length: ir::Name,
    needed: ir::Name,
    byte_length_32: ir::Name
) -> !void {
    let destination = try self.header_element(h, length, 1);
    try self.line3(
        "                (memory.copy %s (i32.load %s) %s)",
        Arg::Str(destination),
        Arg::Str(bytes_expr),
        Arg::Str(byte_length_32)
    );
    return self.write_array_length(h, needed);
}

fn (self: &var Emitter) write_array_reserve(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or
        !module.names.is(node.args.get_or_panic(1).type_name, "Allocator") or
        !module.names.is(node.args.get_or_panic(2).type_name, "i64") or
        !module.names.is(node.result.type_name, "std::mem::Error!void") {
        return try self.fail0(
            "wasm error: array.reserve expects Array<T>, Allocator, i64 -> std::mem::Error!void"
        );
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let allocator = try self.value_of(module, node.args.get_or_panic(1));
    let additional = try self.value_of(module, node.args.get_or_panic(2));
    let length = try self.header_length(h);
    let needed = try self.array_expr2(
        "(i64.add %s %s)",
        Arg::Str(length),
        Arg::Str(additional.expr)
    );
    let reserve = try self.array_expr4(
        "(call $__array_reserve %s %s %s (i32.const %d))",
        Arg::Str(allocator.expr),
        Arg::Str(h.address),
        Arg::Str(needed),
        Arg::Int(layout.size)
    );
    let ok = try self.array_expr2(
        "(i32.and (i64.ge_s %s (i64.const 0)) %s)",
        Arg::Str(additional.expr),
        Arg::Str(reserve)
    );
    let outcome = try self.write_array_error_result(
        module,
        node.result,
        ok,
        "std::mem::Error",
        "OutOfMemory"
    );
    match outcome {
        Error(failed) => return move failed,
        Name(_) => return null,
    }
}

fn (self: &var Emitter) write_array_pop(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("wasm error: array.pop expects Array<T> -> ?T");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    let elem_bytes = elem.as_bytes();
    var result_matches = false;
    if typ::optional_elem(result_type) |want| {
        result_matches = mem::equal_bytes(want, elem_bytes);
    }
    if !result_matches {
        return try self.fail0("wasm error: array.pop expects Array<T> -> ?T");
    }
    var payload_offset = 0;
    let offset_outcome = try self.tagged_payload_offset(module, elem_bytes, false);
    match offset_outcome {
        Error(failed) => return move failed,
        Offset(found) => {
            payload_offset = found;
        },
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let length = try self.header_length(h);
    try self.line1(
        "            (if (i64.gt_s %s (i64.const 0))",
        Arg::Str(length)
    );
    try self.line("              (then");
    let shortened = try self.array_expr1("(i64.sub %s (i64.const 1))", Arg::Str(length));
    try self.write_array_length(h, shortened);
    if try self.write_tagged_result(module, node.result, 1) |failed| {
        return move failed;
    }
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for array.pop result");
    let new_length = try self.header_length(h);
    let source = try self.header_element(h, new_length, layout.size);
    let destination = try self.address_at(slot, payload_offset);
    if try self.write_array_copy_value(
        module,
        destination,
        source,
        node.result.type_name,
        elem_bytes
    ) |failed| {
        return move failed;
    }
    try self.line("              )");
    try self.line("              (else");
    if try self.write_tagged_result(module, node.result, 0) |failed| {
        return move failed;
    }
    try self.line("              ))");
    return null;
}

fn (self: &var Emitter) write_array_pop_or_panic(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("wasm error: array.pop_or_panic expects Array<T> -> T");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let elem_bytes = elem.as_bytes();
    if !module.names.is(node.result.type_name, elem_bytes) {
        return try self.fail0("wasm error: array.pop_or_panic expects Array<T> -> T");
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let length = try self.header_length(h);
    try self.line1("            (if (i64.eqz %s)", Arg::Str(length));
    try self.line2(
        "              (then (call $__panic_array_empty (i64.const %d) (i64.const %d)) (unreachable)))",
        Arg::Int(node.span.start.line),
        Arg::Int(node.span.start.column)
    );
    let shortened = try self.array_expr1("(i64.sub %s (i64.const 1))", Arg::Str(length));
    try self.write_array_length(h, shortened);
    let new_length = try self.header_length(h);
    let source = try self.header_element(h, new_length, layout.size);
    return self.write_load_value(module, node.result, source, 0);
}

fn (self: &var Emitter) write_array_get(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") {
        return try self.fail0("wasm error: array.get expects Array<T>, i64 -> ?T");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    let elem_bytes = elem.as_bytes();
    var result_matches = false;
    if typ::optional_elem(result_type) |want| {
        result_matches = mem::equal_bytes(want, elem_bytes);
    }
    if !result_matches {
        return try self.fail0("wasm error: array.get expects Array<T>, i64 -> ?T");
    }
    var payload_offset = 0;
    let offset_outcome = try self.tagged_payload_offset(module, elem_bytes, false);
    match offset_outcome {
        Error(failed) => return move failed,
        Offset(found) => {
            payload_offset = found;
        },
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let index = try self.value_of(module, node.args.get_or_panic(1));
    if self.is_option_local(node.result.name) {
        let element = try self.header_element(h, index.expr, layout.size);
        var load = ir::empty_name();
        if wasm_load_op_bytes(module, elem_bytes) |op| {
            let op_name = try self.names.intern(op);
            load = try self.array_expr2("(%s %s)", Arg::Str(op_name), Arg::Str(element));
        } else {
            let shown = try self.names.intern(elem_bytes);
            return try self.fail(
                "wasm error: type `%s` cannot be loaded from linear memory",
                Arg::Str(shown)
            );
        }
        let length = try self.header_length(h);
        try self.line2(
            "            (if (i64.lt_u %s %s)",
            Arg::Str(index.expr),
            Arg::Str(length)
        );
        try self.line("              (then");
        let present = try self.names.intern("(i32.const 1)");
        try self.write_option_locals(module, node.result, present, load);
        try self.line("              )");
        try self.line("              (else");
        let absent = try self.names.intern("(i32.const 0)");
        try self.write_option_locals(module, node.result, absent, ir::empty_name());
        try self.line("              ))");
        return null;
    }
    let length = try self.header_length(h);
    try self.line2(
        "            (if (i64.lt_u %s %s)",
        Arg::Str(index.expr),
        Arg::Str(length)
    );
    try self.line("              (then");
    if try self.write_tagged_result(module, node.result, 1) |failed| {
        return move failed;
    }
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for array.get result");
    let source = try self.header_element(h, index.expr, layout.size);
    let destination = try self.address_at(slot, payload_offset);
    if try self.write_array_copy_value(
        module,
        destination,
        source,
        node.result.type_name,
        elem_bytes
    ) |failed| {
        return move failed;
    }
    try self.line("              )");
    try self.line("              (else");
    if try self.write_tagged_result(module, node.result, 0) |failed| {
        return move failed;
    }
    try self.line("              ))");
    return null;
}

fn (self: &var Emitter) write_array_get_or_panic(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") {
        return try self.fail0("wasm error: array.get_or_panic expects Array<T>, i64 -> T");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let elem_bytes = elem.as_bytes();
    if !module.names.is(node.result.type_name, elem_bytes) {
        return try self.fail0("wasm error: array.get_or_panic expects Array<T>, i64 -> T");
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let index = try self.value_of(module, node.args.get_or_panic(1));
    let length = try self.header_length(h);
    try self.line2(
        "            (if (i64.ge_u %s %s)",
        Arg::Str(index.expr),
        Arg::Str(length)
    );
    try self.line4(
        "              (then (call $__panic_bounds %s %s (i64.const %d) (i64.const %d)) (unreachable)))",
        Arg::Str(index.expr),
        Arg::Str(length),
        Arg::Int(node.span.start.line),
        Arg::Int(node.span.start.column)
    );
    let source = try self.header_element(h, index.expr, layout.size);
    return self.write_load_value(module, node.result, source, 0);
}

fn (self: &var Emitter) write_array_at(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") {
        return try self.fail0("wasm error: array.at expects Array<T>, i64 -> ?&T");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    var payload_offset = 0;
    var is_optional = false;
    if typ::optional_elem(result_type) |want| {
        is_optional = true;
        let offset_outcome = try self.tagged_payload_offset(module, want, false);
        match offset_outcome {
            Error(failed) => return move failed,
            Offset(found) => {
                payload_offset = found;
            },
        }
    }
    if !is_optional {
        return try self.fail0("wasm error: array.at expects Array<T>, i64 -> ?&T");
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let index = try self.value_of(module, node.args.get_or_panic(1));
    if self.is_option_local(node.result.name) {
        // The address is only an add: working it out for an index past the
        // end reads nothing, so presence and payload are set without a branch.
        let bound = try self.header_length(h);
        let present = try self.array_expr2(
            "(i64.lt_u %s %s)",
            Arg::Str(index.expr),
            Arg::Str(bound)
        );
        let element = try self.header_element(h, index.expr, layout.size);
        try self.write_option_locals(module, node.result, present, element);
        return null;
    }
    let length = try self.header_length(h);
    try self.line2(
        "            (if (i64.lt_u %s %s)",
        Arg::Str(index.expr),
        Arg::Str(length)
    );
    try self.line("              (then");
    if try self.write_tagged_result(module, node.result, 1) |failed| {
        return move failed;
    }
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for array.at result");
    let destination = try self.address_at(slot, payload_offset);
    let source = try self.header_element(h, index.expr, layout.size);
    try self.line2(
        "                (i32.store %s %s)",
        Arg::Str(destination),
        Arg::Str(source)
    );
    try self.line("              )");
    try self.line("              (else");
    if try self.write_tagged_result(module, node.result, 0) |failed| {
        return move failed;
    }
    try self.line("              ))");
    return null;
}

fn (self: &var Emitter) write_array_set(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.result.type_name, "std::array::Error!void") {
        return try self.fail0(
            "wasm error: array.set expects Array<T>, i64, T -> std::array::Error!void"
        );
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let value = node.args.get_or_panic(2);
    let elem_bytes = elem.as_bytes();
    if !module.names.is(value.type_name, elem_bytes) {
        let expected = try self.names.intern(elem_bytes);
        let got = try self.own(module, value.type_name);
        return try self.fail2(
            "wasm error: array.set expects %s, got %s",
            Arg::Str(expected),
            Arg::Str(got)
        );
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let index = try self.value_of(module, node.args.get_or_panic(1));
    let length = try self.header_length(h);
    let ok = try self.array_expr2(
        "(i64.lt_u %s %s)",
        Arg::Str(index.expr),
        Arg::Str(length)
    );
    let slot_outcome = try self.write_array_error_result(
        module,
        node.result,
        ok,
        "std::array::Error",
        "OutOfBounds"
    );
    var in_bounds = ir::empty_name();
    match slot_outcome {
        Error(failed) => return move failed,
        Name(found) => {
            in_bounds = found;
        },
    }
    try self.line1(
        "            (if %s",
        Arg::Str(in_bounds)
    );
    try self.line("              (then");
    let destination = try self.header_element(h, index.expr, layout.size);
    let value_info = try self.value_of(module, value);
    if try self.write_store_value(
        module,
        destination,
        0,
        value.type_name,
        value_info
    ) |failed| {
        return move failed;
    }
    try self.line("              ))");
    return null;
}

fn (self: &var Emitter) write_array_swap(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.args.get_or_panic(2).type_name, "i64") or
        !module.names.is(node.result.type_name, "std::array::Error!void") {
        return try self.fail0(
            "wasm error: array.swap expects Array<T>, i64, i64 -> std::array::Error!void"
        );
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let left = try self.value_of(module, node.args.get_or_panic(1));
    let right = try self.value_of(module, node.args.get_or_panic(2));
    let elem_bytes = elem.as_bytes();
    let module_elem = module.names.lookup(elem_bytes) orelse ir::empty_name();
    if ir::is_empty(module_elem) or try self.is_memory_type(module, module_elem) or
        (!h.hoisted and !self.is_plain_address(h.address)) {
        let ok = try self.array_expr4(
            "(call $__array_swap %s %s %s (i32.const %d))",
            Arg::Str(h.address),
            Arg::Str(left.expr),
            Arg::Str(right.expr),
            Arg::Int(layout.size)
        );
        let outcome = try self.write_array_error_result(
            module,
            node.result,
            ok,
            "std::array::Error",
            "OutOfBounds"
        );
        match outcome {
            Error(failed) => return move failed,
            Name(_) => return null,
        }
    }
    // A scalar element is moved as the one word it is, through the swap
    // local its type declares, instead of byte by byte in a helper.
    let length = try self.header_length(h);
    let ok = try self.array_expr4(
        "(i32.and (i64.lt_u %s %s) (i64.lt_u %s %s))",
        Arg::Str(left.expr),
        Arg::Str(length),
        Arg::Str(right.expr),
        Arg::Str(length)
    );
    let outcome = try self.write_array_error_result(
        module,
        node.result,
        ok,
        "std::array::Error",
        "OutOfBounds"
    );
    var in_bounds = ir::empty_name();
    match outcome {
        Error(failed) => return move failed,
        Name(found) => {
            in_bounds = found;
        },
    }
    let left_address = try self.header_element(h, left.expr, layout.size);
    let right_address = try self.header_element(h, right.expr, layout.size);
    let temp = try self.swap_local(wasm_type(module, module_elem));
    if wasm_load_op(module, module_elem) |load_op| {
        if wasm_store_op(module, module_elem) |store_op| {
            let load = try self.names.intern(load_op);
            let store = try self.names.intern(store_op);
            try self.line1("            (if %s", Arg::Str(in_bounds));
            try self.line("              (then");
            try self.line3("            (local.set %s (%s %s))", Arg::Str(temp), Arg::Str(load), Arg::Str(left_address));
            try self.line4(
                "            (%s %s (%s %s))",
                Arg::Str(store),
                Arg::Str(left_address),
                Arg::Str(load),
                Arg::Str(right_address)
            );
            try self.line3("            (%s %s (local.get %s))", Arg::Str(store), Arg::Str(right_address), Arg::Str(temp));
            try self.line("              ))");
            return null;
        }
    }
    return try self.fail0("wasm error: array.swap element cannot be moved as one word");
}

/// Names the local an inline swap of one wasm value type holds the left
/// element in, the Go `swapLocal`.
fn (self: &var Emitter) swap_local(wasm_value_type: []u8) -> !ir::Name {
    var out = try string::from_bytes(self.allocator, "$__kizu_swap_");
    errdefer out.deinit(self.allocator);
    try out.append_bytes(self.allocator, wasm_value_type);
    return self.names.intern_owned(move out);
}

/// Declares, in first-use order, the swap locals a function's inline swaps
/// hold an element in, the Go `swapLocalTypes` and its declaration loop.
fn (self: &var Emitter) write_swap_locals(module: &ir::Module, node: &ir::FunctionNode) -> !void {
    var declared = array::new<ir::Name>(self.allocator);
    defer declared.deinit(self.allocator);
    var block_index = 0;
    while node.blocks.get(block_index) |block| {
        block_index = block_index + 1;
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            let instr_node = module.instrs.at(instr.node);
            if instr_node.op != ir::Op::ArraySwap or instr_node.args.len() != 3 {
                continue;
            }
            let container = instr_node.args.get_or_panic(0);
            let array_text = ir::name_text(&module.names, container.type_name);
            let array_bytes = array_text.as_bytes();
            var module_elem = ir::empty_name();
            if array_element_wasm_type(array_bytes) |elem| {
                module_elem = module.names.lookup(elem) orelse ir::empty_name();
            }
            if ir::is_empty(module_elem) or try self.is_memory_type(module, module_elem) {
                continue;
            }
            let value_type = wasm_type(module, module_elem);
            let value_type_name = try self.names.intern(value_type);
            var seen = false;
            var index = 0;
            while declared.get(index) |existing| {
                index = index + 1;
                if ir::same_name(existing, value_type_name) {
                    seen = true;
                }
            }
            if !seen {
                try declared.append(self.allocator, value_type_name);
                let temp = try self.swap_local(value_type);
                try self.line2("    (local %s %s)", Arg::Str(temp), Arg::Str(value_type_name));
            }
        }
    }
    return;
}

fn (self: &var Emitter) write_array_truncate(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.result.type_name, "std::array::Error!void") {
        return try self.fail0(
            "wasm error: array.truncate expects Array<T>, i64 -> std::array::Error!void"
        );
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(_) => {},
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let want = try self.value_of(module, node.args.get_or_panic(1));
    let length = try self.header_length(h);
    let ok = try self.array_expr3(
        "(i32.and (i64.ge_s %s (i64.const 0)) (i64.le_s %s %s))",
        Arg::Str(want.expr),
        Arg::Str(want.expr),
        Arg::Str(length)
    );
    let slot_outcome = try self.write_array_error_result(
        module,
        node.result,
        ok,
        "std::array::Error",
        "OutOfBounds"
    );
    var in_bounds = ir::empty_name();
    match slot_outcome {
        Error(failed) => return move failed,
        Name(found) => {
            in_bounds = found;
        },
    }
    try self.line1(
        "            (if %s",
        Arg::Str(in_bounds)
    );
    try self.line("              (then");
    try self.write_array_length(h, want.expr);
    try self.line("              ))");
    return null;
}

fn (self: &var Emitter) write_array_clear(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.result.type_name, "void") {
        return try self.fail0("wasm error: array.clear expects Array<T> -> void");
    }
    let array_value = node.args.get_or_panic(0);
    let retained = ir::name_text(&module.names, array_value.type_name);
    let type_name = retained.as_bytes();
    if array_element_wasm_type(type_name) |_| {} else {
        return try self.fail0("wasm error: array.clear expects Array<T> -> void");
    }
    let h = try self.array_header_of(module, array_value);
    let zero = try self.names.intern("(i64.const 0)");
    try self.write_array_length(h, zero);
    return null;
}

fn (self: &var Emitter) write_array_as_bytes(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    // The same {ptr, len} descriptor as every view, with the length in
    // elements, for an Array of anything a view may hold.
    if node.args.len() != 1 or !module.names.starts_with(node.result.type_name, "[]") {
        return try self.fail0("wasm error: array.as_bytes expects Array<T> -> []T");
    }
    let array_value = node.args.get_or_panic(0);
    let retained = ir::name_text(&module.names, array_value.type_name);
    let type_name = retained.as_bytes();
    var has_element = false;
    if array_element_wasm_type(type_name) |elem| {
        has_element = mem::len(elem) > 0;
    }
    if !has_element {
        return try self.fail0("wasm error: array.as_bytes expects Array<T> -> []T");
    }
    let h = try self.array_header_of(module, array_value);
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for Array byte view");
    let data = try self.header_data(h);
    try self.line2(
        "            (i32.store %s %s)",
        Arg::Str(slot),
        Arg::Str(data)
    );
    let descriptor_length = try self.address_at(slot, 4);
    let array_length = try self.header_length(h);
    try self.line2(
        "            (i32.store %s (i32.wrap_i64 %s))",
        Arg::Str(descriptor_length),
        Arg::Str(array_length)
    );
    try self.set_value(module, node.result, slot);
    return null;
}

fn (self: &var Emitter) write_array_deinit(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or
        !module.names.is(node.args.get_or_panic(1).type_name, "Allocator") or
        !module.names.is(node.result.type_name, "void") {
        return try self.fail0("wasm error: array.deinit expects Array<T>, Allocator -> void");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    var layout = WasmLayout { size: 0, align: 1 };
    let measured = try self.array_element_layout(module, node, &var elem);
    match measured {
        Error(failed) => return move failed,
        Layout(found) => {
            layout = found;
        },
    }
    let h = try self.array_header_of(module, node.args.get_or_panic(0));
    let allocator = try self.value_of(module, node.args.get_or_panic(1));
    let capacity = try self.header_capacity(h);
    let bytes = try self.array_expr2(
        "(i32.wrap_i64 (i64.mul %s (i64.const %d)))",
        Arg::Str(capacity),
        Arg::Int(layout.size)
    );
    let data = try self.header_data(h);
    try self.line3(
        "            (call $__allocator_free %s %s %s)",
        Arg::Str(allocator.expr),
        Arg::Str(data),
        Arg::Str(bytes)
    );
    return null;
}

union WasmNameResult {
    Name(ir::Name),
    Error(diagnostic::Diagnostic),
}

/// Stores an E!void tag and the declaration-owned global error code.
fn (self: &var Emitter) write_array_error_result(
    module: &ir::Module,
    result: ir::Value,
    ok: ir::Name,
    error_set: []u8,
    member: []u8
) -> !WasmNameResult {
    if !module.error_sets.contains(error_set) {
        return WasmNameResult::Error(try self.fail(
            "wasm error: failure needs error set `%s`",
            Arg::Lit(error_set)
        ));
    }
    let code = wasm_error_code(module, error_set, member) orelse return WasmNameResult::Error(
        try self.fail2(
            "wasm error: error set `%s` has no member `%s`",
            Arg::Lit(error_set),
            Arg::Lit(member)
        )
    );
    let result_text = ir::name_text(&module.names, result.type_name);
    let result_type = result_text.as_bytes();
    let shown_result = try self.own(module, result.type_name);
    let parts = try self.error_union_parts(result_type) orelse return WasmNameResult::Error(
        try self.fail("wasm error: array failure expects !void, got %s", Arg::Str(shown_result))
    );
    defer parts.deinit(self.allocator);
    let success = parts.success.as_bytes();
    if !mem::equal_bytes(success, "void") {
        let shown = try self.own(module, result.type_name);
        return WasmNameResult::Error(try self.fail(
            "wasm error: array failure expects !void, got %s",
            Arg::Str(shown)
        ));
    }
    var offset = 0;
    let offset_outcome = try self.tagged_payload_offset(module, success, true);
    match offset_outcome {
        Error(failed) => return WasmNameResult::Error(move failed),
        Offset(found) => {
            offset = found;
        },
    }
    if self.is_flag_result(result.name) {
        let retained = ir::name_text(&module.names, result.name);
        let bytes = retained.as_bytes();
        let symbol = try self.symbol_name_of(bytes);
        try self.line2("            (local.set %s %s)", Arg::Str(symbol), Arg::Str(ok));
        try self.values.insert(self.allocator, bytes, ValueInfo {
            expr: ir::empty_name(),
            generation: self.generation,
            flag: symbol,
            code: code,
            payload: ir::empty_name()
        });
        let local = try self.local_expr(bytes);
        return WasmNameResult::Name(local);
    }
    let slot = try self.result_slot(module, result) orelse return WasmNameResult::Error(
        try self.fail0("wasm error: no frame slot for array failure result")
    );
    try self.line2(
        "            (i64.store %s (i64.extend_i32_u %s))",
        Arg::Str(slot),
        Arg::Str(ok)
    );
    let code_address = try self.address_at(slot, offset);
    try self.line2(
        "            (i64.store %s (i64.const %d))",
        Arg::Str(code_address),
        Arg::Int(code)
    );
    try self.set_value(module, result, slot);
    let reread = try self.array_expr1("(i32.wrap_i64 (i64.load %s))", Arg::Str(slot));
    return WasmNameResult::Name(reread);
}

/// Reports whether op writes its E!void result through
/// write_array_error_result, whose failure code is a constant of the
/// operation, the Go `writesFlagResult`.
fn writes_flag_result(op: ir::Op) -> bool {
    return match op {
        ArrayAppend => true,
        ArrayAppendBytes => true,
        ArrayReserve => true,
        ArraySet => true,
        ArraySwap => true,
        ArrayTruncate => true,
        MapInsert => true,
        _ => false,
    };
}

/// Reports whether a result is held as a success local in this function.
fn (self: &Emitter) is_flag_result(name: ir::Name) -> bool {
    if self.flag_results.get(ir::name_id(name)) |filed| {
        return filed == self.generation;
    }
    return false;
}

/// Names the results of a function a flag local can hold, the Go
/// `flagResultsOf`: an operation that writes its E!void result through
/// write_array_error_result, read only by the instructions that ask for its
/// tag or its code. Such a result is never handed on, so nothing needs it at
/// an address, and a success that is tested where it was produced does not go
/// through memory to be tested.
fn (self: &var Emitter) flag_results_of(module: &ir::Module, node: &ir::FunctionNode) -> !void {
    var found = false;
    var block_index = 0;
    while node.blocks.get(block_index) |block| {
        block_index = block_index + 1;
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            let instr_node = module.instrs.at(instr.node);
            if writes_flag_result(instr_node.op) and module.names.ends_with(instr_node.result.type_name, "!void") {
                try self.flag_results.insert(self.allocator, ir::name_id(instr_node.result.name), self.generation);
                found = true;
            }
        }
    }
    if !found {
        return;
    }
    block_index = 0;
    while node.blocks.get(block_index) |block| {
        block_index = block_index + 1;
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            let instr_node = module.instrs.at(instr.node);
            var index = 0;
            while instr_node.args.get(index) |arg| {
                let reads_tag = index == 0 and (instr_node.op == ir::Op::ErrorTry or
                    instr_node.op == ir::Op::ErrorHas or instr_node.op == ir::Op::ErrorCode);
                index = index + 1;
                if !reads_tag {
                    try self.drop_flag_result(arg.name);
                }
            }
            index = 0;
            while instr_node.incoming.get(index) |incoming| {
                index = index + 1;
                try self.drop_flag_result(incoming.value.name);
            }
            index = 0;
            while instr_node.fields.get(index) |field| {
                index = index + 1;
                try self.drop_flag_result(field.value.name);
            }
            index = 0;
            while instr_node.cleanups.get(index) |cleanup| {
                index = index + 1;
                var arg_index = 0;
                while module.cleanup_arg(cleanup, arg_index) |arg| {
                    arg_index = arg_index + 1;
                    try self.drop_flag_result(arg.name);
                }
            }
        }
        try self.drop_flag_result(block_node.terminator.value.name);
        try self.drop_flag_result(block_node.terminator.cond.name);
    }
    return;
}

/// Takes a result read as a whole back out of the flag set.
fn (self: &var Emitter) drop_flag_result(name: ir::Name) -> !void {
    if self.is_flag_result(name) {
        try self.flag_results.insert(self.allocator, ir::name_id(name), -1);
    }
    return;
}

/// Copies one element into an already-addressed optional payload.
fn (self: &var Emitter) write_array_copy_value(
    module: &ir::Module,
    destination: ir::Name,
    source: ir::Name,
    optional_type: ir::Name,
    elem: []u8
) -> !?diagnostic::Diagnostic {
    let elem_name = try self.names.intern(elem);
    let shown_optional = try self.own(module, optional_type);
    let module_elem = module.names.lookup(elem) orelse return try self.fail(
        "wasm error: unknown array element type in %s",
        Arg::Str(shown_optional)
    );
    if try self.is_memory_type(module, module_elem) {
        let outcome = try self.type_layout(module, module_elem);
        match outcome {
            Error(failed) => return move failed,
            Layout(layout) => {
                try self.write_memory_copy(destination, source, layout.size);
                return null;
            },
        }
    }
    if wasm_load_op(module, module_elem) |op| {
        let op_name = try self.names.intern(op);
        let loaded = try self.array_expr2("(%s %s)", Arg::Str(op_name), Arg::Str(source));
        let info = ValueInfo {
            expr: loaded,
            generation: self.generation,
            flag: ir::empty_name(),
            code: 0,
            payload: ir::empty_name()
        };
        return self.write_store_value(module, destination, 0, module_elem, info);
    }
    return try self.fail(
        "wasm error: type `%s` cannot be loaded from linear memory",
        Arg::Str(elem_name)
    );
}
