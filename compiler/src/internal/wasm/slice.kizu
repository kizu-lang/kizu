import compiler::internal::diagnostic;
import compiler::internal::ir;
import std::fmt;
import std::mem;
import std::string;

// Mechanical port of internal/wasm/slice.go. A `[]T` value is an addressed
// `{ i32 pointer, i32 length }` descriptor, the length counted in elements.

fn (self: &var Emitter) write_slice_instr(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.op == ir::Op::SliceLen {
        return self.write_slice_len(module, node);
    }
    if node.op == ir::Op::SlicePtr {
        return self.write_slice_ptr(module, node);
    }
    if node.op == ir::Op::SliceIndex {
        return self.write_slice_index(module, node);
    }
    if node.op == ir::Op::SliceStore {
        return self.write_slice_store(module, node);
    }
    if node.op == ir::Op::SliceSlice {
        return self.write_slice_slice(module, node);
    }
    if node.op == ir::Op::SliceCompare {
        return self.write_slice_compare(module, node);
    }
    return try self.fail_op(module, node, "wasm error: unsupported slice instruction `%s`");
}

/// Returns the byte width of one element of a view, the Go `viewCell`: the
/// element's own layout, whatever it is, since a view counts elements and an
/// element of copy data is read and written the way a container's is.
fn (self: &var Emitter) view_cell(module: &ir::Module, elem: []u8) -> !WasmCellResult {
    let measured = try self.type_layout_bytes(module, elem);
    match measured {
        Error(failed) => return WasmCellResult::Error(move failed),
        Layout(found) => return WasmCellResult::Cell(found.size),
    }
}

union WasmCellResult {
    Cell(i64),
    Error(diagnostic::Diagnostic),
}

/// Spells the address of element `index` of a view, the Go `elementAddress`:
/// the pointer word plus the index scaled by the cell width.
fn (self: &var Emitter) element_address(
    pointer: ir::Name,
    index: ir::Name,
    cell: i64
) -> !ir::Name {
    var address = try string::from_bytes(self.allocator, "(i32.add ");
    errdefer address.deinit(self.allocator);
    try self.names.append_to(&var address, pointer);
    if cell == 1 {
        try address.append_bytes(self.allocator, " (i32.wrap_i64 ");
        try self.names.append_to(&var address, index);
        try address.append_bytes(self.allocator, "))");
    } else {
        try address.append_bytes(self.allocator, " (i32.mul (i32.wrap_i64 ");
        try self.names.append_to(&var address, index);
        try address.append_bytes(self.allocator, ") (i32.const ");
        try fmt::append_i64(self.allocator, &var address, cell);
        try address.append_bytes(self.allocator, ")))");
    }
    return self.names.intern_owned(move address);
}

fn (self: &var Emitter) write_slice_len(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let arg = node.args.get(0) orelse ir::empty_value();
    if node.args.len() != 1 or !module.names.starts_with(arg.type_name, "[]") or
        !module.names.is(node.result.type_name, "i64") {
        return try self.fail0("wasm error: slice.len expects []T -> i64");
    }
    let length = try self.view_length(module, arg);
    var out = try string::from_bytes(self.allocator, "(i64.extend_i32_u ");
    errdefer out.deinit(self.allocator);
    try self.names.append_to(&var out, length);
    try out.append_bytes(self.allocator, ")");
    let expr = try self.names.intern_owned(move out);
    return self.write_scalar_result(module, node.result, expr);
}

/// Reads the element pointer of a view descriptor as a raw pointer, the Go
/// `writeSlicePtr`; on this target it is the same i32 address.
fn (self: &var Emitter) write_slice_ptr(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let arg = node.args.get(0) orelse ir::empty_value();
    if node.args.len() != 1 or !module.names.starts_with(arg.type_name, "[]") {
        return try self.fail0("wasm error: slice.ptr expects []T -> ptr<T>");
    }
    let pointer = try self.view_pointer(module, arg);
    return self.write_scalar_result(module, node.result, pointer);
}

fn (self: &var Emitter) write_slice_index(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let slice = node.args.get(0) orelse ir::empty_value();
    let at = node.args.get(1) orelse ir::empty_value();
    let view_text = ir::name_text(&module.names, slice.type_name);
    let view_bytes = view_text.as_bytes();
    if !mem::starts_with(view_bytes, "[]") {
        return try self.fail0("wasm error: slice.index expects []T, i64 -> T");
    }
    let elem = view_bytes[2..mem::len(view_bytes)];
    if node.args.len() != 2 or
        !module.names.is(at.type_name, "i64") or
        !module.names.is(node.result.type_name, elem) {
        return try self.fail0("wasm error: slice.index expects []T, i64 -> T");
    }
    var cell = 0;
    let measured = try self.view_cell(module, elem);
    match measured {
        Error(failed) => return move failed,
        Cell(found) => {
            cell = found;
        },
    }
    let index = try self.value_of(module, at);
    let pointer = try self.view_pointer(module, slice);
    let address_name = try self.element_address(pointer, index.expr, cell);
    return self.write_load_value(module, node.result, address_name, 0);
}

fn (self: &var Emitter) write_slice_store(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let slice = node.args.get(0) orelse ir::empty_value();
    let at = node.args.get(1) orelse ir::empty_value();
    let stored = node.args.get(2) orelse ir::empty_value();
    let view_text = ir::name_text(&module.names, slice.type_name);
    let view_bytes = view_text.as_bytes();
    if !mem::starts_with(view_bytes, "[]") {
        return try self.fail0("wasm error: slice.store expects []T, i64, T -> void");
    }
    let elem = view_bytes[2..mem::len(view_bytes)];
    if node.args.len() != 3 or
        !module.names.is(at.type_name, "i64") or
        !module.names.is(stored.type_name, elem) or
        !module.names.is(node.result.type_name, "void") {
        return try self.fail0("wasm error: slice.store expects []T, i64, T -> void");
    }
    var cell = 0;
    let measured = try self.view_cell(module, elem);
    match measured {
        Error(failed) => return move failed,
        Cell(found) => {
            cell = found;
        },
    }
    let index = try self.value_of(module, at);
    let value = try self.value_of(module, stored);
    let pointer = try self.view_pointer(module, slice);
    let address_name = try self.element_address(pointer, index.expr, cell);
    return self.write_store_value(module, address_name, 0, stored.type_name, value);
}

fn (self: &var Emitter) write_slice_slice(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let slice = node.args.get(0) orelse ir::empty_value();
    let from = node.args.get(1) orelse ir::empty_value();
    let to = node.args.get(2) orelse ir::empty_value();
    let view_text = ir::name_text(&module.names, slice.type_name);
    let view_bytes = view_text.as_bytes();
    if !mem::starts_with(view_bytes, "[]") {
        return try self.fail0("wasm error: slice.slice expects []T, i64, i64 -> []T");
    }
    let elem = view_bytes[2..mem::len(view_bytes)];
    if node.args.len() != 3 or
        !module.names.is(from.type_name, "i64") or !module.names.is(to.type_name, "i64") or
        !ir::same_name(node.result.type_name, slice.type_name) {
        return try self.fail0("wasm error: slice.slice expects []T, i64, i64 -> []T");
    }
    var cell = 0;
    let measured = try self.view_cell(module, elem);
    match measured {
        Error(failed) => return move failed,
        Cell(found) => {
            cell = found;
        },
    }
    let start = try self.value_of(module, from);
    let end = try self.value_of(module, to);
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for slice result");
    let pointer = try self.view_pointer(module, slice);
    let pointer_expr = try self.element_address(pointer, start.expr, cell);
    try self.line2("            (i32.store %s %s)", Arg::Str(slot), Arg::Str(pointer_expr));
    var length = try string::from_bytes(self.allocator, "(i32.wrap_i64 (i64.sub ");
    errdefer length.deinit(self.allocator);
    try self.names.append_to(&var length, end.expr);
    try length.append_byte(self.allocator, cast<u8>(32));
    try self.names.append_to(&var length, start.expr);
    try length.append_bytes(self.allocator, "))");
    let length_expr = try self.names.intern_owned(move length);
    let length_address = try self.address_at(slot, 4);
    try self.line2("            (i32.store %s %s)",
        Arg::Str(length_address), Arg::Str(length_expr));
    try self.set_value(module, node.result, slot);
    return null;
}

/// Assigns one scalar expression to its SSA local.
fn (self: &var Emitter) write_scalar_result(
    module: &ir::Module,
    result: ir::Value,
    expr: ir::Name
) -> !?diagnostic::Diagnostic {
    if try self.is_memory_type(module, result.type_name) {
        let type_name = try self.own(module, result.type_name);
        return try self.fail("wasm error: scalar result helper got aggregate `%s`", Arg::Str(type_name));
    }
    let retained = ir::name_text(&module.names, result.name);
    let bytes = retained.as_bytes();
    let symbol = try self.symbol_name_of(bytes);
    try self.line2("            (local.set %s %s)", Arg::Str(symbol), Arg::Str(expr));
    let local = try self.local_expr(bytes);
    try self.set_value(module, result, local);
    return null;
}
