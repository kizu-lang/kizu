import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::mem;
import std::string;

// Mechanical port of internal/wasm/buffer.go. A fixed-length array lives in
// memory like a struct; buffer.as_bytes builds the `{pointer, length}` view
// into its storage.

/// Reports whether a verified IR spelling is one fixed stack-buffer type
/// `[N]T`: a bracketed run of digits followed by the element.
fn is_buffer_wasm_type(type_name: []u8) -> bool {
    let length = mem::len(type_name);
    if length < 4 or type_name[0] != cast<u8>(91) {
        return false;
    }
    var index = 1;
    while index < length and type_name[index] != cast<u8>(93) {
        let byte = type_name[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return false;
        }
        index = index + 1;
    }
    return index > 1 and index + 1 < length;
}

/// Returns N for one fixed stack-buffer spelling `[N]T`.
fn (self: &var Emitter) buffer_size(type_name: []u8) -> !?i64 {
    if mem::len(type_name) == 0 {
        return null;
    }
    let parsed = try self.types.parse(type_name);
    match typ::root_node(&self.types, parsed) {
        Buffer(node) => return node.size,
        _ => return null,
    }
}

/// Renders T from a `[N]T` spelling, null for any other spelling.
fn (self: &var Emitter) buffer_elem(type_name: []u8) -> !?string::String {
    if mem::len(type_name) == 0 {
        return null;
    }
    let parsed = try self.types.parse(type_name);
    match typ::root_node(&self.types, parsed) {
        Buffer(node) => {
            let child = typ::child_type(parsed, node.elem);
            return try typ::render(self.allocator, &self.types, child);
        },
        _ => return null,
    }
}

/// Lowers fixed-length zeroed storage and its byte view.
fn (self: &var Emitter) write_buffer_instr(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.op == ir::Op::BufferNew {
        return self.write_buffer_new(module, node);
    }
    if node.op == ir::Op::BufferAsBytes {
        return self.write_buffer_as_bytes(module, node);
    }
    if node.op == ir::Op::BufferAddr {
        return self.write_buffer_addr(module, node);
    }
    return try self.fail_op(module, node, "wasm error: unsupported buffer instruction `%s`");
}

fn (self: &var Emitter) write_buffer_new(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let retained = ir::name_text(&module.names, node.result.type_name);
    let type_name = retained.as_bytes();
    let shown = try self.own(module, node.result.type_name);
    if try self.buffer_size(type_name) |_| {} else {
        return try self.fail(
            "wasm error: buffer.new expects `[N]T` result, got %s",
            Arg::Str(shown)
        );
    }
    if node.args.len() != 0 {
        let shown = try self.own(module, node.result.type_name);
        return try self.fail(
            "wasm error: buffer.new expects `[N]T` result, got %s",
            Arg::Str(shown)
        );
    }
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for buffer result");
    let outcome = try self.type_layout(module, node.result.type_name);
    match outcome {
        Error(failed) => return move failed,
        Layout(layout) => try self.write_memory_zero(slot, layout.size),
    }
    try self.set_value(module, node.result, slot);
    return null;
}

fn (self: &var Emitter) write_buffer_as_bytes(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.starts_with(node.result.type_name, "[]") {
        return try self.fail0("wasm error: buffer.as_bytes expects `&var [N]T` -> `[]T`");
    }
    let buffer = node.args.get_or_panic(0);
    let retained = ir::name_text(&module.names, buffer.type_name);
    let spelled = retained.as_bytes();
    let type_name = deref_wasm_type(spelled);
    let shown = try self.own(module, buffer.type_name);
    let size = try self.buffer_size(type_name) orelse return try self.fail(
        "wasm error: buffer.as_bytes expects the storage of `[N]T`, got %s",
        Arg::Str(shown)
    );
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for buffer view");
    let info = try self.value_of(module, buffer);
    try self.line2(
        "            (i32.store %s %s)",
        Arg::Str(slot),
        Arg::Str(info.expr)
    );
    let length = try self.address_at(slot, 4);
    try self.line2(
        "            (i32.store %s (i32.const %d))",
        Arg::Str(length),
        Arg::Int(size)
    );
    try self.set_value(module, node.result, slot);
    return null;
}

/// Projects the address of one element out of an array's storage, the Go
/// `writeBufferAddr`. The index was bounds-checked when it was lowered.
fn (self: &var Emitter) write_buffer_addr(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("wasm error: buffer.addr expects the storage of `[N]T` and an index");
    }
    let storage = node.args.get_or_panic(0);
    let retained = ir::name_text(&module.names, storage.type_name);
    let spelled = retained.as_bytes();
    let array = deref_wasm_type(spelled);
    let elem = try self.buffer_elem(array) orelse
        return try self.fail0("wasm error: buffer.addr expects `&var [N]T` -> `&var T`");
    defer elem.deinit(self.allocator);
    let elem_bytes = elem.as_bytes();
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    let pointed = deref_wasm_type(result_type);
    if !mem::equal_bytes(pointed, elem_bytes) {
        return try self.fail0("wasm error: buffer.addr expects `&var [N]T` -> `&var T`");
    }
    let outcome = try self.type_layout_bytes(module, elem_bytes);
    var cell = WasmLayout { size: 0, align: 1 };
    match outcome {
        Error(failed) => return move failed,
        Layout(layout) => {
            cell = layout;
        },
    }
    let storage_info = try self.value_of(module, storage);
    let position_info = try self.value_of(module, node.args.get_or_panic(1));
    let result_name = ir::name_text(&module.names, node.result.name);
    let result_bytes = result_name.as_bytes();
    let symbol = try self.symbol_name_of(result_bytes);
    try self.line4(
        "            (local.set %s (i32.add %s (i32.mul (i32.wrap_i64 %s) (i32.const %d))))",
        Arg::Str(symbol), Arg::Str(storage_info.expr), Arg::Str(position_info.expr), Arg::Int(cell.size)
    );
    let local = try self.local_expr(result_bytes);
    try self.set_value(module, node.result, local);
    return null;
}
