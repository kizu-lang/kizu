import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::mem;

// Mechanical port of internal/wasm/buffer.go. A fixed buffer is its inline
// frame storage; buffer.as_bytes builds the `{pointer, length}` view into it.

/// Reports whether a verified IR spelling is one fixed byte-buffer type.
fn is_buffer_wasm_type(type_name: []u8) -> bool {
    let length = mem::len(type_name);
    if length < 5 or type_name[0] != cast<u8>(91) or
        type_name[length - 3] != cast<u8>(93) or
        type_name[length - 2] != cast<u8>(117) or
        type_name[length - 1] != cast<u8>(56) {
        return false;
    }
    var index = 1;
    while index < length - 3 {
        let byte = type_name[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

/// Returns N for one fixed stack-buffer spelling `[N]u8`.
fn (self: &var Emitter) buffer_size(type_name: []u8) -> !?i64 {
    if mem::len(type_name) == 0 {
        return null;
    }
    let parsed = try self.types.parse(type_name);
    match typ::root_node(&self.types, parsed) {
        Buffer(node) => return node.size,
        _ => return null,
    }
}

/// Lowers fixed-length zeroed storage and its byte view.
fn (self: &var Emitter) write_buffer_instr(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.op == ir::Op::BufferNew {
        return self.write_buffer_new(module, node);
    }
    if node.op == ir::Op::BufferAsBytes {
        return self.write_buffer_as_bytes(module, node);
    }
    return try self.fail_op(module, node, "wasm error: unsupported buffer instruction `%s`");
}

fn (self: &var Emitter) write_buffer_new(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let retained = ir::name_text(&module.names, node.result.type_name);
    let type_name = retained.as_bytes();
    let shown = try self.own(module, node.result.type_name);
    let size = try self.buffer_size(type_name) orelse return try self.fail(
        "wasm error: buffer.new expects `[N]u8` result, got %s",
        Arg::Str(shown)
    );
    if node.args.len() != 0 {
        let shown = try self.own(module, node.result.type_name);
        return try self.fail(
            "wasm error: buffer.new expects `[N]u8` result, got %s",
            Arg::Str(shown)
        );
    }
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for buffer result");
    if size > 0 {
        try self.line2(
            "            (memory.fill %s (i32.const 0) (i32.const %d))",
            Arg::Str(slot),
            Arg::Int(size)
        );
    }
    try self.set_value(module, node.result, slot);
    return null;
}

fn (self: &var Emitter) write_buffer_as_bytes(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.result.type_name, "[]u8") {
        return try self.fail0("wasm error: buffer.as_bytes expects buffer -> []u8");
    }
    let buffer = node.args.get_or_panic(0);
    let retained = ir::name_text(&module.names, buffer.type_name);
    let type_name = retained.as_bytes();
    let shown = try self.own(module, buffer.type_name);
    let size = try self.buffer_size(type_name) orelse return try self.fail(
        "wasm error: buffer.as_bytes expects `[N]u8`, got %s",
        Arg::Str(shown)
    );
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for buffer view");
    let info = try self.value_of(module, buffer);
    try self.line2(
        "            (i32.store %s %s)",
        Arg::Str(slot),
        Arg::Str(info.expr)
    );
    let length = try self.address_at(slot, 4);
    try self.line2(
        "            (i32.store %s (i32.const %d))",
        Arg::Str(length),
        Arg::Int(size)
    );
    try self.set_value(module, node.result, slot);
    return null;
}
