    try self.line("                (br $dir_refill)))");
    try self.line(
        "            (local.set $next (i64.load (local.get $header)))"
    );
    try self.line(
        "            (if (i64.eq (local.get $next) (local.get $cookie))"
    );
    try self.line("              (then");
    try self.write_fs_read_dir_failure(codes.read_failed, "                ");
    try self.line("                (return)))");
    try self.line("            (local.set $cookie (local.get $next))");
    try self.line1(
        "            (local.set $name (i32.add (local.get $header) (i32.const %d)))",
        Arg::Int(24)
    );
    try self.write_fs_read_dir_entry(layout, codes);
    try self.line(
        "            (local.set $pos (i32.add (local.get $pos) (local.get $record_size)))"
    );
    try self.line("            (br $dir_parse)))");
    return self.line("        (br $dir_read)))");
}

fn (self: &var Emitter) write_fs_read_dir_entry(
    layout: FSDirLayout,
    codes: FSErrorCodes
) -> !void {
    try self.line("            (if (i32.or");
    try self.line(
        "                  (i32.and (i32.eq (local.get $name_len) (i32.const 1))"
    );
    try self.line(
        "                    (i32.eq (i32.load8_u (local.get $name)) (i32.const 46)))"
    );
    try self.line(
        "                  (i32.and (i32.eq (local.get $name_len) (i32.const 2))"
    );
    try self.line(
        "                    (i32.and (i32.eq (i32.load8_u (local.get $name)) (i32.const 46))"
    );
    try self.line(
        "                      (i32.eq (i32.load8_u (i32.add (local.get $name) (i32.const 1))) (i32.const 46)))))"
    );
    try self.line("              (then");
    try self.line(
        "                (local.set $pos (i32.add (local.get $pos) (local.get $record_size)))"
    );
    try self.line("                (br $dir_parse)))");
    try self.line("            (local.set $name_copy");
    try self.line(
        "              (call $__allocator_alloc (local.get $allocator) (local.get $name_len)))"
    );
    try self.line("            (if (i32.eqz (local.get $name_copy))");
    try self.line("              (then");
    try self.write_fs_read_dir_failure(codes.out_of_memory, "                ");
    try self.line("                (return)))");
    try self.line(
        "            (memory.copy (local.get $name_copy) (local.get $name) (local.get $name_len))"
    );
    try self.line("            (local.set $path_len");
    try self.line(
        "              (i32.load (i32.add (local.get $path) (i32.const 4))))"
    );
    try self.line("            (local.set $separator (i32.const 0))");
    try self.line("            (if (local.get $path_len)");
    try self.line("              (then");
    try self.line("                (if (i32.ne (i32.load8_u");
    try self.line(
        "                      (i32.add (i32.load (local.get $path))"
    );
    try self.line(
        "                        (i32.sub (local.get $path_len) (i32.const 1))))"
    );
    try self.line("                    (i32.const 47))");
    try self.line(
        "                  (then (local.set $separator (i32.const 1))))))"
    );
    try self.line("            (local.set $path_size");
    try self.line(
        "              (i64.add (i64.extend_i32_u (local.get $path_len))"
    );
    try self.line(
        "                (i64.add (i64.extend_i32_u (local.get $separator))"
    );
    try self.line(
        "                  (i64.extend_i32_u (local.get $name_len)))))"
    );
    try self.line(
        "            (if (i64.gt_u (local.get $path_size) (i64.const 2147483640))"
    );
    try self.line("              (then");
    try self.line(
        "                (call $__allocator_free (local.get $allocator)"
    );
    try self.line(
        "                  (local.get $name_copy) (local.get $name_len))"
    );
    try self.write_fs_read_dir_failure(codes.out_of_memory, "                ");
    try self.line("                (return)))");
    try self.line(
        "            (local.set $path_copy (call $__allocator_alloc"
    );
    try self.line(
        "              (local.get $allocator) (i32.wrap_i64 (local.get $path_size))))"
    );
    try self.line("            (if (i32.eqz (local.get $path_copy))");
    try self.line("              (then");
    try self.line(
        "                (call $__allocator_free (local.get $allocator)"
    );
    try self.line(
        "                  (local.get $name_copy) (local.get $name_len))"
    );
    try self.write_fs_read_dir_failure(codes.out_of_memory, "                ");
    try self.line("                (return)))");
    try self.line("            (memory.copy (local.get $path_copy)");
    try self.line(
        "              (i32.load (local.get $path)) (local.get $path_len))"
    );
    try self.line("            (if (local.get $separator)");
    try self.line(
        "              (then (i32.store8 (i32.add (local.get $path_copy) (local.get $path_len))"
    );
    try self.line("                (i32.const 47))))");
    try self.line("            (memory.copy");
    try self.line("              (i32.add (local.get $path_copy)");
    try self.line(
        "                (i32.add (local.get $path_len) (local.get $separator)))"
    );
    try self.line(
        "              (local.get $name_copy) (local.get $name_len))"
    );
    try self.line(
        "            (local.set $errno (call $__wasi_path_filestat_get"
    );
    try self.line(
        "              (local.get $root) (i32.const 1) (local.get $path_copy)"
    );
    try self.line("              (i32.wrap_i64 (local.get $path_size))");
    try self.line1("              (i32.const %d)))", Arg::Int(64));
    try self.line2(
        "            (local.set $is_dir (i32.and (i32.eqz (local.get $errno)) (i32.eq (i32.load8_u (i32.const %d)) (i32.const %d))))",
        Arg::Int(80),
        Arg::Int(3)
    );
    try self.line1(
        "            (local.set $length (i64.load (i32.add (local.get $array) (i32.const %d))))",
        Arg::Int(array_len_offset())
    );
    try self.line("            (if (i32.eqz (call $__array_reserve");
    try self.line1(
        "                  (local.get $allocator) (local.get $array) (i64.add (local.get $length) (i64.const 1)) (i32.const %d)))",
        Arg::Int(layout.entry_size)
    );
    try self.line("              (then");
    try self.line(
        "                (call $__allocator_free (local.get $allocator)"
    );
    try self.line(
        "                  (local.get $name_copy) (local.get $name_len))"
    );
    try self.line(
        "                (call $__allocator_free (local.get $allocator)"
    );
    try self.line(
        "                  (local.get $path_copy) (i32.wrap_i64 (local.get $path_size)))"
    );
    try self.write_fs_read_dir_failure(codes.out_of_memory, "                ");
    try self.line("                (return)))");
    try self.line(
        "            (local.set $item (i32.add (i32.load (local.get $array))"
    );
    try self.line1(
        "              (i32.wrap_i64 (i64.mul (local.get $length) (i64.const %d)))))",
        Arg::Int(layout.entry_size)
    );
    try self.line1(
        "            (i32.store (i32.add (local.get $item) (i32.const %d)) (local.get $name_copy))",
        Arg::Int(layout.name_offset + array_data_offset())
    );
    try self.line1(
        "            (i64.store (i32.add (local.get $item) (i32.const %d)) (i64.extend_i32_u (local.get $name_len)))",
        Arg::Int(layout.name_offset + array_len_offset())
    );
    try self.line1(
        "            (i64.store (i32.add (local.get $item) (i32.const %d)) (i64.extend_i32_u (local.get $name_len)))",
        Arg::Int(layout.name_offset + array_capacity_offset())
    );
    try self.line1(
        "            (i32.store (i32.add (local.get $item) (i32.const %d)) (local.get $path_copy))",
        Arg::Int(layout.path_offset + array_data_offset())
    );
    try self.line1(
        "            (i64.store (i32.add (local.get $item) (i32.const %d)) (local.get $path_size))",
        Arg::Int(layout.path_offset + array_len_offset())
    );
    try self.line1(
        "            (i64.store (i32.add (local.get $item) (i32.const %d)) (local.get $path_size))",
        Arg::Int(layout.path_offset + array_capacity_offset())
    );
    try self.line1(
        "            (i32.store8 (i32.add (local.get $item) (i32.const %d)) (local.get $is_dir))",
        Arg::Int(layout.is_dir_offset)
    );
    return self.line1(
        "            (i64.store (i32.add (local.get $array) (i32.const %d)) (i64.add (local.get $length) (i64.const 1)))",
        Arg::Int(array_len_offset())
    );
}

/// Replaces one preopen-relative file and writes every byte.
fn (self: &var Emitter) write_fs_write_file(codes: FSErrorCodes) -> !void {
    try self.line("  (func $std::internal::builtin::fs_write_file");
    try self.line(
        "      (param $out i32) (param $io i32) (param $path i32) (param $bytes i32)"
    );
    try self.line("    (local $fd i32) (local $errno i32) (local $ptr i32)");
    try self.line("    (local $remaining i32) (local $written i32)");
    try self.write_fs_guard(codes.io_failing, codes.permission_denied);
    try self.line("    (local.set $errno (call $__wasi_path_open");
    try self.line(
        "      (local.get $fd) (i32.const 1) (i32.load (local.get $path))"
    );
    try self.line(
        "      (i32.load (i32.add (local.get $path) (i32.const 4)))"
    );
    try self.line3(
        "      (i32.const %d) (i64.const %d) (i64.const 0) (i32.const 0) (i32.const %d)))",
        Arg::Int(9),
        Arg::Int(64),
        Arg::Int(24)
    );
    try self.line("    (if (local.get $errno)");
    try self.line("      (then");
    try self.write_fs_stored_errno("        ");
    try self.line("        (return)))");
    try self.line("    (local.set $fd (i32.load (i32.const 24)))");
    try self.line("    (local.set $ptr (i32.load (local.get $bytes)))");
    try self.line("    (local.set $remaining");
    try self.line("      (i32.load (i32.add (local.get $bytes) (i32.const 4))))");
    try self.line("    (block $done");
    try self.line("      (loop $write");
    try self.line("        (br_if $done (i32.eqz (local.get $remaining)))");
    try self.line1(
        "        (i32.store (i32.const %d) (local.get $ptr))",
        Arg::Int(scratch_offset())
    );
    try self.line1(
        "        (i32.store (i32.const %d) (local.get $remaining))",
        Arg::Int(scratch_offset() + 4)
    );
    try self.line("        (local.set $errno (call $__wasi_fd_write");
    try self.line2(
        "          (local.get $fd) (i32.const %d) (i32.const 1) (i32.const %d)))",
        Arg::Int(scratch_offset()),
        Arg::Int(scratch_offset() + 16)
    );
    try self.line("        (if (local.get $errno)");
    try self.line("          (then");
    try self.write_fs_write_failure(codes.write_failed);
    try self.line("            (return)))");
    try self.line1(
        "        (local.set $written (i32.load (i32.const %d)))",
        Arg::Int(scratch_offset() + 16)
    );
    try self.line("        (if (i32.or (i32.eqz (local.get $written))");
    try self.line(
        "            (i32.gt_u (local.get $written) (local.get $remaining)))"
    );
    try self.line("          (then");
    try self.write_fs_write_failure(codes.write_failed);
    try self.line("            (return)))");
    try self.line("        (local.set $ptr");
    try self.line("          (i32.add (local.get $ptr) (local.get $written)))");
    try self.line("        (local.set $remaining");
    try self.line(
        "          (i32.sub (local.get $remaining) (local.get $written)))"
    );
    try self.line("        (br $write)))");
    try self.line("    (drop (call $__wasi_fd_close (local.get $fd)))");
    try self.line("    (i64.store (local.get $out) (i64.const 1))");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_fs_write_failure(code: i64) -> !void {
    try self.line("            (drop (call $__wasi_fd_close (local.get $fd)))");
    return self.write_error_result(code, "            ");
}

fn (self: &var Emitter) write_fs_exists(codes: FSErrorCodes) -> !void {
    try self.line(
        "  (func $std::internal::builtin::fs_exists (param $out i32) (param $io i32) (param $path i32)"
    );
    try self.line("    (local $fd i32) (local $errno i32)");
    try self.write_fs_guard(codes.io_failing, codes.permission_denied);
    try self.write_fs_filestat_call();
    try self.line("    (i64.store (local.get $out) (i64.const 1))");
    try self.line(
        "    (i32.store8 (i32.add (local.get $out) (i32.const 8))"
    );
    try self.line("      (i32.eqz (local.get $errno)))");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_fs_metadata(codes: FSErrorCodes) -> !void {
    try self.line(
        "  (func $std::internal::builtin::fs_metadata (param $out i32) (param $io i32) (param $path i32)"
    );
    try self.line("    (local $fd i32) (local $errno i32)");
    try self.write_fs_guard(codes.io_failing, codes.permission_denied);
    try self.write_fs_filestat_call();
    try self.line("    (if (local.get $errno)");
    try self.line("      (then");
    try self.write_fs_stored_errno("        ");
    try self.line("        (return)))");
    try self.line("    (i64.store (local.get $out) (i64.const 1))");
    try self.line1(
        "    (i64.store (i32.add (local.get $out) (i32.const %d))",
        Arg::Int(void_error_payload_offset())
    );
    try self.line1(
        "      (i64.load (i32.const %d)))",
        Arg::Int(64 + 32)
    );
    try self.line1(
        "    (i32.store8 (i32.add (local.get $out) (i32.const %d))",
        Arg::Int(void_error_payload_offset() + 8)
    );
    try self.line2(
        "      (i32.eq (i32.load8_u (i32.const %d)) (i32.const %d)))",
        Arg::Int(64 + 16),
        Arg::Int(3)
    );
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_fs_filestat_call() -> !void {
    try self.line("    (local.set $errno (call $__wasi_path_filestat_get");
    try self.line(
        "      (local.get $fd) (i32.const 1) (i32.load (local.get $path))"
    );
    try self.line(
        "      (i32.load (i32.add (local.get $path) (i32.const 4)))"
    );
    return self.line("      (i32.const 64)))");
}

fn (self: &var Emitter) write_fs_path_void_builtin(
    name: []u8,
    host: []u8,
    codes: FSErrorCodes
) -> !void {
    try self.line1(
        "  (func $%s (param $out i32) (param $io i32) (param $path i32)",
        Arg::Lit(name)
    );
    try self.line("    (local $fd i32) (local $errno i32)");
    try self.write_fs_guard(codes.io_failing, codes.permission_denied);
    try self.line1("    (local.set $errno (call %s", Arg::Lit(host));
    try self.line("      (local.get $fd) (i32.load (local.get $path))");
    try self.line(
        "      (i32.load (i32.add (local.get $path) (i32.const 4)))))"
    );
    try self.line("    (if (local.get $errno)");
    try self.line("      (then");
    try self.write_fs_stored_errno("        ");
    try self.line("        (return)))");
    try self.line("    (i64.store (local.get $out) (i64.const 1))");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

/// Moves one path within the explicitly granted preopen.
fn (self: &var Emitter) write_fs_rename(codes: FSErrorCodes) -> !void {
    try self.line(
        "  (func $std::internal::builtin::fs_rename (param $out i32) (param $io i32) (param $from i32) (param $to i32)"
    );
    try self.line("    (local $fd i32) (local $errno i32)");
    try self.write_fs_guard(codes.io_failing, codes.permission_denied);
    try self.line("    (local.set $errno (call $__wasi_path_rename");
