}

fn (self: &var Emitter) write_fs_real_path_pop_helper() -> !void {
    try self.line(
        "  (func $__fs_real_path_pop (param $dst i32) (param $start i64) (result i32)"
    );
    try self.line(
        "    (local $length i64) (local $index i64) (local $data i32)"
    );
    try self.line1(
        "    (local.set $length (i64.load (i32.add (local.get $dst) (i32.const %d))))",
        Arg::Int(array_len_offset())
