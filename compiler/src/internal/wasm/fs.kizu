/// Emits an owned, sorted directory snapshot.
fn (self: &var Emitter) write_fs_read_dir(
    layout: FSDirLayout,
    codes: FSErrorCodes
) -> !void {
    try self.write_fs_dir_entries_free(layout);
    try self.write_fs_dir_entry_after(layout);
    try self.write_fs_sort_dir_entries(layout);
    try self.write_fs_read_dir_fail_helper(layout);
    return self.write_fs_read_dir_builtin(layout, codes);
}

