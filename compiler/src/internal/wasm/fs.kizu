fn (self: &var Emitter) write_fs_real_path_fail_helper() -> !void {
    try self.line("  (func $__fs_real_path_fail");
    try self.line(
        "      (param $out i32) (param $allocator i32) (param $dst i32) (param $start i64)"
    );
