    try self.line("      (local.get $fd) (i32.load (local.get $to))");
    try self.line(
        "      (i32.load (i32.add (local.get $to) (i32.const 4)))))"
    );
    try self.line("    (if (local.get $errno)");
    try self.line("      (then");
    try self.write_fs_stored_errno("        ");
    try self.line("        (return)))");
    try self.line("    (i64.store (local.get $out) (i64.const 1))");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}
