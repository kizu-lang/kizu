    try self.line(
        "    (if (i64.le_u (local.get $length) (local.get $start))"
    );
    try self.line("      (then (return (i32.const 0))))");
    try self.line("    (local.set $data (i32.load (local.get $dst)))");
    try self.line("    (local.set $index (local.get $length))");
    try self.line("    (loop $pop");
    try self.line(
        "      (if (i64.le_u (local.get $index) (local.get $start))"
    );
    try self.line("        (then");
    try self.line1(
        "          (i64.store (i32.add (local.get $dst) (i32.const %d)) (local.get $start))",
        Arg::Int(array_len_offset())
    );
    try self.line("          (return (i32.const 1))))");
    try self.line(
        "      (local.set $index (i64.sub (local.get $index) (i64.const 1)))"
    );
    try self.line(
        "      (if (i32.eq (i32.load8_u (i32.add (local.get $data) (i32.wrap_i64 (local.get $index)))) (i32.const 47))"
    );
    try self.line("        (then");
    try self.line1(
        "          (i64.store (i32.add (local.get $dst) (i32.const %d)) (local.get $index))",
        Arg::Int(array_len_offset())
    );
    try self.line("          (return (i32.const 1))))");
    try self.line("      (br $pop))");
    try self.line("    (unreachable)");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
