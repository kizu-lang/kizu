import compiler::internal::diagnostic;
import compiler::internal::ir;

// Mechanical port of internal/wasm/fs.go. Filesystem paths are relative to
// the host's explicit first WASI preopen; the compiler grants no directory.

struct FSErrorCodes {
    invalid_path: i64,
    not_found: i64,
    permission_denied: i64,
    is_directory: i64,
    not_directory: i64,
    already_exists: i64,
    directory_not_empty: i64,
    no_space_left: i64,
    too_many_open_files: i64,
    read_failed: i64,
    write_failed: i64,
    out_of_memory: i64,
    operation_failed: i64,
    io_failing: i64,
    limit_exceeded: i64
}

/// Is the declaration-derived wasm32 storage used by read_dir.
struct FSDirLayout {
    entry_size: i64,
    name_offset: i64,
    path_offset: i64,
    is_dir_offset: i64,
    result_offset: i64
}

/// Is one read_dir layout or the reason it cannot be formed.
union FSDirLayoutResult {
    Layout(FSDirLayout),
    Error(diagnostic::Diagnostic),
}

fn (self: &Emitter) uses_fs_runtime(module: &ir::Module) -> bool {
    return self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_read_file_into"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_real_path_into"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_read_dir"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_write_file"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_exists"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_metadata"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_rename"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_create_dir"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_remove_dir"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_remove_file"
    );
}

fn (self: &Emitter) uses_fs_open(module: &ir::Module) -> bool {
    return self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_read_file_into"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_write_file"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_read_dir"
    );
}

fn (self: &Emitter) uses_fs_stat(module: &ir::Module) -> bool {
    return self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_exists"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_metadata"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_read_dir"
    ) or self.uses_builtin_call(
        module,
        "std::internal::builtin::fs_real_path_into"
    );
}

/// Declares only the WASI filesystem calls the guest reaches.
fn (self: &var Emitter) write_fs_imports(module: &ir::Module) -> !void {
    if !self.uses_fs_runtime(module) {
        return;
    }
    let prestat =
        \\  (import "wasi_snapshot_preview1" "fd_prestat_get"
    ;
    try self.line(prestat);
    try self.line("    (func $__wasi_fd_prestat_get (param i32 i32) (result i32)))");
    if self.uses_fs_open(module) {
        let path_open =
            \\  (import "wasi_snapshot_preview1" "path_open"
        ;
        try self.line(path_open);
        try self.line("    (func $__wasi_path_open");
        try self.line(
            "      (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))"
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_read_file_into") {
        let fd_read =
            \\  (import "wasi_snapshot_preview1" "fd_read"
        ;
        try self.line(fd_read);
        try self.line(
            "    (func $__wasi_fd_read (param i32 i32 i32 i32) (result i32)))"
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_read_dir") {
        let fd_readdir =
            \\  (import "wasi_snapshot_preview1" "fd_readdir"
        ;
        try self.line(fd_readdir);
        try self.line(
            "    (func $__wasi_fd_readdir (param i32 i32 i32 i64 i32) (result i32)))"
        );
    }
    if self.uses_fs_open(module) {
        let fd_close =
            \\  (import "wasi_snapshot_preview1" "fd_close"
        ;
        try self.line(fd_close);
        try self.line("    (func $__wasi_fd_close (param i32) (result i32)))");
    }
    if self.uses_fs_stat(module) {
        let filestat =
            \\  (import "wasi_snapshot_preview1" "path_filestat_get"
        ;
        try self.line(filestat);
        try self.line("    (func $__wasi_path_filestat_get");
        try self.line("      (param i32 i32 i32 i32 i32) (result i32)))");
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_real_path_into") {
        let path_readlink =
            \\  (import "wasi_snapshot_preview1" "path_readlink"
        ;
        try self.line(path_readlink);
        try self.line("    (func $__wasi_path_readlink");
        try self.line(
            "      (param i32 i32 i32 i32 i32 i32) (result i32)))"
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_create_dir") {
        let create_dir =
            \\  (import "wasi_snapshot_preview1" "path_create_directory"
        ;
        try self.line(create_dir);
        try self.line(
            "    (func $__wasi_path_create_directory (param i32 i32 i32) (result i32)))"
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_remove_dir") {
        let remove_dir =
            \\  (import "wasi_snapshot_preview1" "path_remove_directory"
        ;
        try self.line(remove_dir);
        try self.line(
            "    (func $__wasi_path_remove_directory (param i32 i32 i32) (result i32)))"
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_remove_file") {
        let unlink_file =
            \\  (import "wasi_snapshot_preview1" "path_unlink_file"
        ;
        try self.line(unlink_file);
        try self.line(
            "    (func $__wasi_path_unlink_file (param i32 i32 i32) (result i32)))"
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_rename") {
        let rename =
            \\  (import "wasi_snapshot_preview1" "path_rename"
        ;
        try self.line(rename);
        try self.line("    (func $__wasi_path_rename");
        try self.line(
            "      (param i32 i32 i32 i32 i32 i32) (result i32)))"
        );
    }
    return;
}

/// Emits the basic preopen-relative filesystem boundary.
fn (self: &var Emitter) write_fs_runtime(
    module: &ir::Module
) -> !?diagnostic::Diagnostic {
    if !self.uses_fs_runtime(module) {
        return null;
    }
    let invalid_path = wasm_error_code(
        module,
        "std::fs::Error",
        "InvalidPath"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `InvalidPath`"
    );
    let not_found = wasm_error_code(
        module,
        "std::fs::Error",
        "NotFound"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `NotFound`"
    );
    let permission_denied = wasm_error_code(
        module,
        "std::fs::Error",
        "PermissionDenied"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `PermissionDenied`"
    );
    let is_directory = wasm_error_code(
        module,
        "std::fs::Error",
        "IsDirectory"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `IsDirectory`"
    );
    let not_directory = wasm_error_code(
        module,
        "std::fs::Error",
        "NotDirectory"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `NotDirectory`"
    );
    let already_exists = wasm_error_code(
        module,
        "std::fs::Error",
        "AlreadyExists"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `AlreadyExists`"
    );
    let directory_not_empty = wasm_error_code(
        module,
        "std::fs::Error",
        "DirectoryNotEmpty"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `DirectoryNotEmpty`"
    );
    let no_space_left = wasm_error_code(
        module,
        "std::fs::Error",
        "NoSpaceLeft"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `NoSpaceLeft`"
    );
    let too_many_open_files = wasm_error_code(
        module,
        "std::fs::Error",
        "TooManyOpenFiles"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `TooManyOpenFiles`"
    );
    let read_failed = wasm_error_code(
        module,
        "std::fs::Error",
        "ReadFailed"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `ReadFailed`"
    );
    let write_failed = wasm_error_code(
        module,
        "std::fs::Error",
        "WriteFailed"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `WriteFailed`"
    );
    let out_of_memory = wasm_error_code(
        module,
        "std::fs::Error",
        "OutOfMemory"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `OutOfMemory`"
    );
    let operation_failed = wasm_error_code(
        module,
        "std::fs::Error",
        "OperationFailed"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `OperationFailed`"
    );
    let io_failing = wasm_error_code(
        module,
        "std::fs::Error",
        "IoFailing"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `IoFailing`"
    );
    let limit_exceeded = wasm_error_code(
        module,
        "std::fs::Error",
        "LimitExceeded"
    ) orelse return try self.fail0(
        "wasm error: error set `std::fs::Error` has no member `LimitExceeded`"
    );
    let codes = FSErrorCodes {
        invalid_path: invalid_path,
        not_found: not_found,
        permission_denied: permission_denied,
        is_directory: is_directory,
        not_directory: not_directory,
        already_exists: already_exists,
        directory_not_empty: directory_not_empty,
        no_space_left: no_space_left,
        too_many_open_files: too_many_open_files,
        read_failed: read_failed,
        write_failed: write_failed,
        out_of_memory: out_of_memory,
        operation_failed: operation_failed,
        io_failing: io_failing,
        limit_exceeded: limit_exceeded
    };
    try self.write_fs_preopen_helper();
    try self.write_fs_errno_helper(codes);
    if self.uses_builtin_call(module, "std::internal::builtin::fs_read_file_into") {
        try self.write_fs_read_file_into(codes);
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_real_path_into") {
        try self.write_fs_real_path_into(codes);
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_read_dir") {
        let layout_outcome = try self.load_fs_dir_layout(module);
        match layout_outcome {
            Error(failed) => return move failed,
            Layout(layout) => try self.write_fs_read_dir(layout, codes),
        }
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_write_file") {
        try self.write_fs_write_file(codes);
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_exists") {
        try self.write_fs_exists(codes);
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_metadata") {
        try self.write_fs_metadata(codes);
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_create_dir") {
        try self.write_fs_path_void_builtin(
            "std::internal::builtin::fs_create_dir",
            "$__wasi_path_create_directory",
            codes
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_remove_dir") {
        try self.write_fs_path_void_builtin(
            "std::internal::builtin::fs_remove_dir",
            "$__wasi_path_remove_directory",
            codes
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_remove_file") {
        try self.write_fs_path_void_builtin(
            "std::internal::builtin::fs_remove_file",
            "$__wasi_path_unlink_file",
            codes
        );
    }
    if self.uses_builtin_call(module, "std::internal::builtin::fs_rename") {
        try self.write_fs_rename(codes);
    }
    return null;
}

/// Resolves DirEntry, String storage, and the error-union payload from the
/// declarations instead of pinning their source-level aggregate offsets.
fn (self: &var Emitter) load_fs_dir_layout(
    module: &ir::Module
) -> !FSDirLayoutResult {
    var entry = WasmLayout { size: 0, align: 1 };
    let entry_outcome = try self.type_layout_bytes(module, "std::fs::DirEntry");
    match entry_outcome {
        Error(failed) => return FSDirLayoutResult::Error(move failed),
        Layout(found) => {
            entry = found;
        },
    }
    var name_offset = 0;
    let name_outcome = try self.field_layout(
        module,
        "std::fs::DirEntry",
        "name"
    );
    match name_outcome {
        Error(failed) => return FSDirLayoutResult::Error(move failed),
        Field(found) => {
            if !module.names.is(found.field.type_name, "std::string::String") {
                return FSDirLayoutResult::Error(try self.fail0(
                    "wasm error: incompatible `std::fs::DirEntry` storage for fs_read_dir"
                ));
            }
            name_offset = found.offset;
        },
    }
    var path_offset = 0;
    let path_outcome = try self.field_layout(
        module,
        "std::fs::DirEntry",
        "path"
    );
    match path_outcome {
        Error(failed) => return FSDirLayoutResult::Error(move failed),
        Field(found) => {
            if !module.names.is(found.field.type_name, "std::string::String") {
                return FSDirLayoutResult::Error(try self.fail0(
                    "wasm error: incompatible `std::fs::DirEntry` storage for fs_read_dir"
                ));
            }
            path_offset = found.offset;
        },
    }
    var is_dir_offset = 0;
    let is_dir_outcome = try self.field_layout(
        module,
        "std::fs::DirEntry",
        "is_dir"
    );
    match is_dir_outcome {
        Error(failed) => return FSDirLayoutResult::Error(move failed),
        Field(found) => {
            if !module.names.is(found.field.type_name, "bool") {
                return FSDirLayoutResult::Error(try self.fail0(
                    "wasm error: incompatible `std::fs::DirEntry` storage for fs_read_dir"
                ));
            }
            is_dir_offset = found.offset;
        },
    }
    var bytes_offset = 0;
    let bytes_outcome = try self.field_layout(
        module,
        "std::string::String",
        "bytes"
    );
    match bytes_outcome {
        Error(failed) => return FSDirLayoutResult::Error(move failed),
        Field(found) => {
            if !module.names.is(found.field.type_name, "std::array::Array<u8>") {
                return FSDirLayoutResult::Error(try self.fail0(
                    "wasm error: incompatible `std::fs::DirEntry` storage for fs_read_dir"
                ));
            }
            bytes_offset = found.offset;
        },
    }
    if entry.size <= 0 {
        return FSDirLayoutResult::Error(try self.fail0(
            "wasm error: incompatible `std::fs::DirEntry` storage for fs_read_dir"
        ));
    }
    var result_offset = 0;
    let result_outcome = try self.tagged_payload_offset(
        module,
        "std::array::Array<std::fs::DirEntry>",
        true
    );
    match result_outcome {
        Error(failed) => return FSDirLayoutResult::Error(move failed),
        Offset(found) => {
            result_offset = found;
        },
    }
    return FSDirLayoutResult::Layout(FSDirLayout {
        entry_size: entry.size,
        name_offset: name_offset + bytes_offset,
        path_offset: path_offset + bytes_offset,
        is_dir_offset: is_dir_offset,
        result_offset: result_offset
    });
}

fn (self: &var Emitter) write_fs_preopen_helper() -> !void {
    try self.line("  (func $__fs_preopen (result i32)");
    try self.line2(
        "    (if (call $__wasi_fd_prestat_get (i32.const %d) (i32.const %d))",
        Arg::Int(3),
        Arg::Int(scratch_offset())
    );
    try self.line("      (then (return (i32.const -1))))");
    try self.line1(
        "    (if (i32.ne (i32.load8_u (i32.const %d)) (i32.const 0))",
        Arg::Int(scratch_offset())
    );
    try self.line("      (then (return (i32.const -1))))");
    try self.line("    (i32.const 3)");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_fs_errno_helper(codes: FSErrorCodes) -> !void {
    try self.line("  (func $__fs_error (param $errno i32) (result i64)");
    try self.write_fs_errno_case(44, codes.not_found);
    try self.write_fs_errno_triple_case(2, 63, 76, codes.permission_denied);
    try self.write_fs_errno_case(31, codes.is_directory);
    try self.write_fs_errno_case(54, codes.not_directory);
    try self.write_fs_errno_case(20, codes.already_exists);
    try self.write_fs_errno_case(55, codes.directory_not_empty);
    try self.write_fs_errno_case(51, codes.no_space_left);
    try self.write_fs_errno_pair_case(33, 41, codes.too_many_open_files);
    try self.write_fs_errno_pair_case(28, 37, codes.invalid_path);
    try self.line1("    (i64.const %d)", Arg::Int(codes.operation_failed));
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_fs_errno_case(errno: i64, code: i64) -> !void {
    try self.line1(
        "    (if (i32.eq (local.get $errno) (i32.const %d))",
        Arg::Int(errno)
    );
    return self.line1("      (then (return (i64.const %d))))", Arg::Int(code));
}

fn (self: &var Emitter) write_fs_errno_pair_case(
    first: i64,
    second: i64,
    code: i64
) -> !void {
    try self.line("    (if (i32.or");
    try self.line1(
        "          (i32.eq (local.get $errno) (i32.const %d))",
        Arg::Int(first)
    );
    try self.line1(
        "          (i32.eq (local.get $errno) (i32.const %d)))",
        Arg::Int(second)
    );
    return self.line1("      (then (return (i64.const %d))))", Arg::Int(code));
}

fn (self: &var Emitter) write_fs_errno_triple_case(
    first: i64,
    second: i64,
    third: i64,
    code: i64
) -> !void {
    try self.line("    (if (i32.or");
    try self.line1(
        "          (i32.eq (local.get $errno) (i32.const %d))",
        Arg::Int(first)
    );
    try self.line1(
        "          (i32.or (i32.eq (local.get $errno) (i32.const %d))",
        Arg::Int(second)
    );
    try self.line1(
        "            (i32.eq (local.get $errno) (i32.const %d))))",
        Arg::Int(third)
    );
    return self.line1("      (then (return (i64.const %d))))", Arg::Int(code));
}

fn (self: &var Emitter) write_fs_guard(
    io_failing: i64,
    permission_denied: i64
) -> !void {
    try self.line("    (if (i32.eq (local.get $io) (i32.const 2))");
    try self.line("      (then");
    try self.write_error_result(io_failing, "        ");
    try self.line("        (return)))");
    try self.line("    (local.set $fd (call $__fs_preopen))");
    try self.line("    (if (i32.lt_s (local.get $fd) (i32.const 0))");
    try self.line("      (then");
    try self.write_error_result(permission_denied, "        ");
    return self.line("        (return)))");
}

fn (self: &var Emitter) write_fs_stored_errno(indent: []u8) -> !void {
    try self.line1(
        "%s(i64.store (local.get $out) (i64.const 0))",
        Arg::Lit(indent)
    );
    try self.line2(
        "%s(i64.store (i32.add (local.get $out) (i32.const %d))",
        Arg::Lit(indent),
        Arg::Int(void_error_payload_offset())
    );
    return self.line1(
        "%s  (call $__fs_error (local.get $errno)))",
        Arg::Lit(indent)
    );
}

fn (self: &var Emitter) write_fs_read_file_into(codes: FSErrorCodes) -> !void {
    try self.line("  (func $std::internal::builtin::fs_read_file_into");
    try self.line(
        "      (param $out i32) (param $io i32) (param $allocator i32)"
    );
    try self.line("      (param $path i32) (param $dst i32) (param $max i64)");
    try self.line("    (local $fd i32) (local $errno i32) (local $ptr i32)");
    try self.line("    (local $want i32) (local $read i32)");
    try self.line("    (local $start i64) (local $total i64)");
    try self.line("    (local $remaining i64) (local $needed i64)");
    try self.write_fs_guard(codes.io_failing, codes.permission_denied);
    try self.line("    (local.set $errno (call $__wasi_path_open");
    try self.line(
        "      (local.get $fd) (i32.const 1) (i32.load (local.get $path))"
    );
    try self.line(
        "      (i32.load (i32.add (local.get $path) (i32.const 4)))"
    );
    try self.line1(
        "      (i32.const 0) (i64.const 2) (i64.const 0) (i32.const 0) (i32.const %d)))",
        Arg::Int(24)
    );
    try self.line("    (if (local.get $errno)");
    try self.line("      (then");
    try self.write_fs_stored_errno("        ");
    try self.line("        (return)))");
    try self.line("    (local.set $fd (i32.load (i32.const 24)))");
    try self.line1(
        "    (local.set $start (i64.load (i32.add (local.get $dst) (i32.const %d))))",
        Arg::Int(array_len_offset())
    );
    try self.line("    (block $done");
    try self.line("      (loop $read");
    try self.line("        (local.set $want (i32.const 65536))");
