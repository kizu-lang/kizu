import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::float;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// Mechanical port of internal/wasm/control.go: the dispatch arm one IR block
// becomes, the instructions this backend lowers, and the control transfer at
// the end of a block. Go reads an operation as a string and matches it by
// prefix; here the operation is the ir::Op tag and the name it carries, so the
// `binary.` / `call.` / `field.` prefixes become the tags that spell them.

/// Writes a dispatch arm for one IR block, the Go `writeBlock`.
fn (self: &var Emitter) write_block(
    module: &ir::Module,
    block: ir::Block,
    index: &map::Map<[]u8, DispatchBlock>,
    id: i64
) -> !?diagnostic::Diagnostic {
    try self.line1("        (if (i32.eq (local.get $pc) (i32.const %d))", Arg::Int(id));
    try self.line("          (then");
    let node = module.blocks.at(block.node);
    var instr_index = 0;
    while node.instrs.get(instr_index) |instr| {
        instr_index = instr_index + 1;
        if module.instr_op(instr) == ir::Op::Phi {
            continue;
        }
        if try self.write_instr(module, instr) |failed| {
            return move failed;
        }
    }
    if try self.write_terminator(module, block, index) |failed| {
        return move failed;
    }
    try self.line("          )");
    try self.line("        )");
    return null;
}

/// Writes one WebAssembly instruction sequence, the Go `writeInstr`.
fn (self: &var Emitter) write_instr(
    module: &ir::Module,
    instr: ir::Instr
) -> !?diagnostic::Diagnostic {
    let node = module.instrs.at(instr.node);
    return self.write_instr_node(module, node);
}

/// Writes one instruction record that need not already be retained in module.
fn (self: &var Emitter) write_instr_node(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.op == ir::Op::Const {
        return self.write_const(module, node);
    }
    if node.op == ir::Op::Binary {
        return self.write_binary(module, node);
    }
    if node.op == ir::Op::Unary {
        return self.write_unary(module, node);
    }
    if node.op == ir::Op::CondFail {
        return self.write_cond_fail(module, node);
    }
    if node.op == ir::Op::PanicFail {
        return self.write_panic_fail(module, node);
    }
    if node.op == ir::Op::TestFail or node.op == ir::Op::TestExpectEqual {
        return self.write_test_instr(module, node);
    }
    if node.op == ir::Op::PrintLine {
        return self.write_print_line(module, node);
    }
    if node.op == ir::Op::Call {
        return self.write_call(module, node);
    }
    if node.op == ir::Op::FuncAddr {
        return self.write_func_addr(module, node);
    }
    if node.op == ir::Op::CallIndirect {
        return self.write_indirect_call(module, node);
    }
    if node.op == ir::Op::Cast {
        return self.write_cast(module, node);
    }
    if node.op == ir::Op::FloatBits or node.op == ir::Op::FloatFromBits {
        return self.write_float_bits(module, node);
    }
    if node.op == ir::Op::BufferNew or node.op == ir::Op::BufferAsBytes {
        return self.write_buffer_instr(module, node);
    }
    if node.op == ir::Op::StructNew {
        return self.write_struct_new(module, node);
    }
    if node.op == ir::Op::Field or node.op == ir::Op::FieldRef or
        node.op == ir::Op::FieldSet or node.op == ir::Op::FieldRefSet or
        node.op == ir::Op::FieldAddr {
        return self.write_field_instr(module, node);
    }
    if node.op == ir::Op::LocalSlot {
        return self.write_local_slot(module, node);
    }
    if node.op == ir::Op::RefStore {
        return self.write_ref_store(module, node);
    }
    if node.op == ir::Op::RefLoad {
        return self.write_ref_load(module, node);
    }
    if node.op == ir::Op::UnionNew or node.op == ir::Op::UnionLoad or
        node.op == ir::Op::UnionTag or node.op == ir::Op::UnionPayload {
        return self.write_union_instr(module, node);
    }
    if node.op == ir::Op::SliceLen or node.op == ir::Op::SliceIndex or
        node.op == ir::Op::SliceStore or node.op == ir::Op::SliceSlice {
        return self.write_slice_instr(module, node);
    }
    if node.op == ir::Op::OptNull or node.op == ir::Op::OptSome or
        node.op == ir::Op::OptHas or node.op == ir::Op::OptValue {
        return self.write_optional_instr(module, node);
    }
    if node.op == ir::Op::ErrorOk or node.op == ir::Op::ErrorError or
        node.op == ir::Op::ErrorTry or node.op == ir::Op::ErrorHas or
        node.op == ir::Op::ErrorValue or node.op == ir::Op::ErrorCode {
        return self.write_error_instr(module, node);
    }
    if is_wasm_array_op(node.op) {
        return self.write_array_instr(module, node);
    }
    if is_wasm_map_op(node.op) {
        return self.write_map_instr(module, node);
    }
    if is_wasm_box_op(node.op) {
        return self.write_box_instr(module, node);
    }
    if is_wasm_arena_op(node.op) {
        return self.write_arena_instr(module, node);
    }
    return try self.fail_op(module, node, "wasm error: unsupported instruction `%s`");
}

/// Builds one failure naming the operation the way Go spells `instr.Op`.
fn (self: &Emitter) fail_op(
    module: &ir::Module,
    node: &ir::InstrNode,
    format: []u8
) -> !diagnostic::Diagnostic {
    var text = string::new(self.allocator);
    errdefer text.deinit(self.allocator);
    try ir::append_op(self.allocator, &var text, &module.names, node.op, node.operand);
    return self.fail(format, Arg::Owned(move text));
}

/// Preserves integer-width casts in the shared i64 representation and converts
/// when a raw wasm32 pointer crosses the integer boundary.
fn (self: &var Emitter) write_cast(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("wasm error: cast expects 1 arg");
    }
    let source_value = node.args.get_or_panic(0);
    if is_float_type(&module.names, source_value.type_name) or
        is_float_type(&module.names, node.result.type_name) {
        return self.write_float_cast(module, node);
    }
    let source = wasm_type(module, source_value.type_name);
    let target = wasm_type(module, node.result.type_name);
    let value = try self.arg_expr(module, node, 0);
    var expression = string::new(self.allocator);
    errdefer expression.deinit(self.allocator);
    if mem::equal_bytes(source, "i64") and mem::equal_bytes(target, "i32") {
        try expression.append_bytes(self.allocator, "(i32.wrap_i64 ");
        try self.names.append_to(&var expression, value);
        try expression.append_bytes(self.allocator, ")");
    } else {
        if mem::equal_bytes(source, "i32") and mem::equal_bytes(target, "i64") {
            try expression.append_bytes(self.allocator, "(i64.extend_i32_u ");
            try self.names.append_to(&var expression, value);
            try expression.append_bytes(self.allocator, ")");
        } else {
            try self.names.append_to(&var expression, value);
        }
    }
    let expr = try self.names.intern_owned(move expression);
    try self.set_value(module, node.result, expr);
    return null;
}

/// Records scalar and string constants, the Go `writeConst`.
fn (self: &var Emitter) write_const(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if is_integer_type(&module.names, node.result.type_name) or
        is_named_i64_type(module, node.result.type_name) {
        // Every scalar integer is one wasm i64, so a constant of any width is
        // written the same way.
        let expr = try self.constant_expr(module, node, "(i64.const ");
        try self.set_value(module, node.result, expr);
        return null;
    }
    if module.names.is(node.result.type_name, "bool") {
        let expr = try self.names.intern(wasm_bool(&module.names, node.immediate));
        try self.set_value(module, node.result, expr);
        return null;
    }
    if is_float_type(&module.names, node.result.type_name) {
        let expr = try self.float_const_expr(module, node) orelse
            return try self.fail_op(module, node, "wasm error: invalid float constant `%s`");
        try self.set_value(module, node.result, expr);
        return null;
    }
    if module.names.is(node.result.type_name, "[]u8") {
        let immediate = ir::name_text(&module.names, node.immediate);
        let immediate_bytes = immediate.as_bytes();
        let found = self.data_ref(immediate_bytes);
        let slot = try self.result_slot(module, node.result) orelse
            return try self.fail0("wasm error: no frame slot for string constant");
        let pointer = try self.offset_expr(found.offset);
        try self.line2("            (i32.store %s %s)", Arg::Str(slot), Arg::Str(pointer));
        let length_address = try self.address_at(slot, 4);
        let length = try self.offset_expr(found.length);
        try self.line2("            (i32.store %s %s)",
            Arg::Str(length_address), Arg::Str(length));
        try self.set_value(module, node.result, slot);
        return null;
    }
    let type_name = try self.own(module, node.result.type_name);
    return try self.fail("wasm error: unsupported const type `%s`", Arg::Str(type_name));
}

/// Names one constant expression made of a prefix and the immediate.
fn (self: &var Emitter) constant_expr(
    module: &ir::Module,
    node: &ir::InstrNode,
    prefix: []u8
) -> !ir::Name {
    var out = try string::from_bytes(self.allocator, prefix);
    errdefer out.deinit(self.allocator);
    try module.names.append_to(&var out, node.immediate);
    try out.append_bytes(self.allocator, ")");
    return self.names.intern_owned(move out);
}

/// Names the `(i32.const N)` expression one data offset reads as.
fn (self: &var Emitter) offset_expr(offset: i64) -> !ir::Name {
    var out = try string::from_bytes(self.allocator, "(i32.const ");
    errdefer out.deinit(self.allocator);
    try fmt::append_i64(self.allocator, &var out, offset);
    try out.append_bytes(self.allocator, ")");
    return self.names.intern_owned(move out);
}

/// Writes arithmetic and comparison local assignments, the Go `writeBinary`.
fn (self: &var Emitter) write_binary(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("wasm error: binary expects 2 args");
    }
    if module.names.is(node.args.get_or_panic(0).type_name, "[]u8") {
        return self.write_byte_equality(module, node);
    }
    let left = try self.arg_expr(module, node, 0);
    let right = try self.arg_expr(module, node, 1);
    if module.names.is(node.operand, "<<") or module.names.is(node.operand, ">>") {
        return self.write_shift(module, node, left, right);
    }
    let result_retained = ir::name_text(&module.names, node.result.name);
    let result_bytes = result_retained.as_bytes();
    let symbol = try self.symbol_name_of(result_bytes);
    let narrow = wraps_result(&module.names, node.operand) and
        !module.names.is(node.result.type_name, "bool") and
        !is_float_type(&module.names, node.result.type_name);
    var expression = string::new(self.allocator);
    errdefer expression.deinit(self.allocator);
    if narrow {
        try expression.append_bytes(self.allocator, narrow_prefix(&module.names, node.result.type_name));
    }
    try expression.append_byte(self.allocator, cast<u8>(40));
    try expression.append_bytes(self.allocator, binary_operation(module, node));
    try expression.append_byte(self.allocator, cast<u8>(32));
    try self.names.append_to(&var expression, left);
    try expression.append_byte(self.allocator, cast<u8>(32));
    try self.names.append_to(&var expression, right);
    try expression.append_byte(self.allocator, cast<u8>(41));
    if narrow {
        try expression.append_bytes(self.allocator, narrow_suffix(&module.names, node.result.type_name));
    }
    try self.line2("            (local.set %s %s)", Arg::Str(symbol), Arg::Owned(move expression));
    let expr = try self.local_expr(result_bytes);
    try self.set_value(module, node.result, expr);
    return null;
}

/// Returns the WebAssembly operation one binary instruction lowers to: a
/// comparison when its result is a bool, the Go `wasmOp` choice.
fn binary_operation(module: &ir::Module, node: &ir::InstrNode) -> []u8 {
    if module.names.is(node.result.type_name, "bool") {
        let left_type = node.args.get_or_panic(0).type_name;
        if module.names.is(left_type, "bool") {
            if module.names.is(node.operand, "!=") {
                return "i32.ne";
            }
            return "i32.eq";
        }
        if is_float_type(&module.names, left_type) {
            return wasm_float_compare_op(&module.names, node.operand, left_type);
        }
        return wasm_compare_op(&module.names, node.operand, left_type);
    }
    if is_float_type(&module.names, node.result.type_name) {
        return wasm_float_binary_op(&module.names, node.operand, node.result.type_name);
    }
    return wasm_binary_op(&module.names, node.operand, node.result.type_name);
}

/// Writes `<<` and `>>` with the width rule of SPEC §6.9.2, the Go
/// `writeShift`. A WebAssembly shift reads its amount modulo 64, so the
/// amount is compared with the width first and the result chosen by a
/// select.
fn (self: &var Emitter) write_shift(
    module: &ir::Module,
    node: &ir::InstrNode,
    left: ir::Name,
    right: ir::Name
) -> !?diagnostic::Diagnostic {
    let bits = integer_bit_width(&module.names, node.result.type_name) orelse
        return try self.fail0("wasm error: shift expects an integer");
    var expression = string::new(self.allocator);
    errdefer expression.deinit(self.allocator);
    let shift_left = module.names.is(node.operand, "<<");
    if shift_left {
        try expression.append_bytes(self.allocator, narrow_prefix(&module.names, node.result.type_name));
    }
    try expression.append_bytes(self.allocator, "(select (");
    let signed_right = module.names.is(node.operand, ">>") and
        !is_unsigned_integer_type(&module.names, node.result.type_name);
    if shift_left {
        try expression.append_bytes(self.allocator, "i64.shl ");
    } else {
        if signed_right {
            try expression.append_bytes(self.allocator, "i64.shr_s ");
        } else {
            try expression.append_bytes(self.allocator, "i64.shr_u ");
        }
    }
    try self.names.append_to(&var expression, left);
    try expression.append_byte(self.allocator, cast<u8>(32));
    try self.names.append_to(&var expression, right);
    try expression.append_bytes(self.allocator, ") ");
    if signed_right {
        try expression.append_bytes(self.allocator, "(i64.shr_s ");
        try self.names.append_to(&var expression, left);
        try expression.append_bytes(self.allocator, " (i64.const 63))");
    } else {
        try expression.append_bytes(self.allocator, "(i64.const 0)");
    }
    try expression.append_bytes(self.allocator, " (i64.lt_u ");
    try self.names.append_to(&var expression, right);
    try expression.append_bytes(self.allocator, " (i64.const ");
    try fmt::append_i64(self.allocator, &var expression, bits);
    try expression.append_bytes(self.allocator, ")))");
    if shift_left {
        try expression.append_bytes(self.allocator, narrow_suffix(&module.names, node.result.type_name));
    }
    let expr = try self.names.intern_owned(move expression);
    return self.write_scalar_result(module, node.result, expr);
}

/// Writes boolean negation and integer arithmetic negation, the Go
/// `writeUnary`.
fn (self: &var Emitter) write_unary(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("wasm error: unary expects 1 arg");
    }
    let value = try self.arg_expr(module, node, 0);
    var expression = string::new(self.allocator);
    errdefer expression.deinit(self.allocator);
    if module.names.is(node.operand, "!") {
        if !module.names.is(node.result.type_name, "bool") {
            expression.deinit(self.allocator);
            return try self.fail0("wasm error: unary ! expects bool");
        }
        try expression.append_bytes(self.allocator, "(i32.eqz ");
        try self.names.append_to(&var expression, value);
        try expression.append_byte(self.allocator, cast<u8>(41));
    } else {
        if module.names.is(node.operand, "~") {
            if !is_integer_type(&module.names, node.result.type_name) {
                expression.deinit(self.allocator);
                return try self.fail0("wasm error: unary ~ expects integer");
            }
            try expression.append_bytes(self.allocator, narrow_prefix(&module.names, node.result.type_name));
            try expression.append_bytes(self.allocator, "(i64.xor ");
            try self.names.append_to(&var expression, value);
            try expression.append_bytes(self.allocator, " (i64.const -1))");
            try expression.append_bytes(self.allocator, narrow_suffix(&module.names, node.result.type_name));
        } else {
            if !module.names.is(node.operand, "-") {
                expression.deinit(self.allocator);
                return try self.fail_op(module, node, "wasm error: unsupported unary `%s`");
            }
            if is_float_type(&module.names, node.result.type_name) {
                try expression.append_byte(self.allocator, cast<u8>(40));
                try expression.append_bytes(self.allocator, wasm_type(module, node.result.type_name));
                try expression.append_bytes(self.allocator, ".neg ");
                try self.names.append_to(&var expression, value);
                try expression.append_byte(self.allocator, cast<u8>(41));
            } else {
                if !is_integer_type(&module.names, node.result.type_name) {
                    expression.deinit(self.allocator);
                    return try self.fail0("wasm error: unary - expects integer");
                }
                try expression.append_bytes(self.allocator, narrow_prefix(&module.names, node.result.type_name));
                try expression.append_bytes(self.allocator, "(i64.sub (i64.const 0) ");
                try self.names.append_to(&var expression, value);
                try expression.append_byte(self.allocator, cast<u8>(41));
                try expression.append_bytes(self.allocator, narrow_suffix(&module.names, node.result.type_name));
            }
        }
    }
    let expr = try self.names.intern_owned(move expression);
    return self.write_scalar_result(module, node.result, expr);
}

/// Writes the table index a function name holds. wasm has no address for a
/// function, so a pointer is the position the header's `elem` gave it.
fn (self: &var Emitter) write_func_addr(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let retained = ir::name_text(&module.names, node.operand);
    let bytes = retained.as_bytes();
    let position = self.table_index.get(bytes) orelse
        return try self.fail("wasm error: `%s` has no table entry", Arg::Str(node.operand));
    var text = try string::from_bytes(self.allocator, "(i32.const ");
    errdefer text.deinit(self.allocator);
    try fmt::append_i64(self.allocator, &var text, position);
    try text.append_byte(self.allocator, cast<u8>(41));
    let expr = try self.names.intern_owned(move text);
    try self.set_value(module, node.result, expr);
    return null;
}

/// Adapts one IR argument to its declared wasm call ABI. A CopyAddress scalar
/// is stored in its planned frame cell and that address reaches the callee.
fn (self: &var Emitter) write_call_arg(
    module: &ir::Module,
    node: &ir::InstrNode,
    arg: ir::Value,
    param: ir::Param,
    index: i64,
    out: &var ir::Name
) -> !?diagnostic::Diagnostic {
    let info = try self.value_of(module, arg);
    if !try self.call_needs_copy_slot(module, param, arg) {
        out.* = info.expr;
        return null;
    }
    let slot = try self.call_copy_slot(module, node.result, index) orelse
        return try self.fail0("wasm error: no frame slot for addressed call argument");
    if try self.write_store_value(module, slot, 0, arg.type_name, info) |failed| {
        return move failed;
    }
    out.* = slot;
    return null;
}

/// Writes a call through a function pointer. The callee is the first operand
/// and reaches wasm as the table index it lowered to, which `call_indirect`
/// takes last.
fn (self: &var Emitter) write_indirect_call(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let callee_value = node.args.get(0) orelse
        return try self.fail0("wasm error: call.indirect expects a callee");
    var result_slot = ir::empty_name();
    if try self.is_memory_type(module, node.result.type_name) {
        result_slot = try self.result_slot(module, node.result) orelse
            return try self.fail0("wasm error: no frame slot for indirect call result");
    }
    let signature = try self.intern_signature(module, node);
    var call = try string::from_bytes(self.allocator, "(call_indirect (type $sig");
    errdefer call.deinit(self.allocator);
    try fmt::append_i64(self.allocator, &var call, signature);
    try call.append_bytes(self.allocator, ")");
    if !ir::is_empty(result_slot) {
        try call.append_byte(self.allocator, cast<u8>(32));
        try self.names.append_to(&var call, result_slot);
    }
    var index = 1;
    var param_index = 0;
    while node.args.get(index) |arg| {
        index = index + 1;
        try call.append_bytes(self.allocator, " ");
        var expr = ir::empty_name();
        if node.call_params.get(param_index) |param| {
            if try self.write_call_arg(
                module,
                node,
                arg,
                param,
                param_index,
                &var expr
            ) |failed| {
                call.deinit(self.allocator);
                return move failed;
            }
        } else {
            let info = try self.value_of(module, arg);
            expr = info.expr;
        }
        param_index = param_index + 1;
        try self.names.append_to(&var call, expr);
    }
    try call.append_bytes(self.allocator, " ");
    let callee = try self.value_of(module, callee_value);
    try self.names.append_to(&var call, callee.expr);
    try call.append_byte(self.allocator, cast<u8>(41));
    if module.names.is(node.result.type_name, "void") or
        try self.is_memory_type(module, node.result.type_name) {
        try self.line1("            %s", Arg::Owned(move call));
        if try self.is_memory_type(module, node.result.type_name) {
            try self.set_value(module, node.result, result_slot);
        }
        return null;
    }
    let result_retained = ir::name_text(&module.names, node.result.name);
    let result_bytes = result_retained.as_bytes();
    let symbol = try self.symbol_name_of(result_bytes);
    try self.line2("            (local.set %s %s)", Arg::Str(symbol), Arg::Owned(move call));
    let expr = try self.local_expr(result_bytes);
    try self.set_value(module, node.result, expr);
    return null;
}

/// Writes builtin print and user function calls, the Go `writeCall`.
fn (self: &var Emitter) write_call(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if !ir::is_empty(node.extern_abi) {
        if self.is_browser() and module.names.is(node.extern_abi, "browser") {
            return self.write_browser_host_call(module, node);
        }
        let abi = try self.own(module, node.extern_abi);
        var target = "wasm32-wasi";
        if self.is_browser() {
            target = "wasm32-browser";
        }
        return try self.fail2(
            "wasm error: target %s does not support extern `%s`",
            Arg::Lit(target),
            Arg::Str(abi)
        );
    }
    if module.names.is(node.operand, "std::internal::builtin::mem_page_allocator") {
        if node.args.len() != 0 or !module.names.is(node.result.type_name, "Allocator") {
            return try self.fail0(
                "wasm error: mem_page_allocator expects no args -> Allocator"
            );
        }
        let expr = try self.names.intern("(i32.const 0)");
        return self.write_scalar_result(module, node.result, expr);
    }
    if module.names.is(node.operand, "std::internal::builtin::mem_fixed_buffer") {
        if node.args.len() != 1 or
            !module.names.is(node.args.get_or_panic(0).type_name, "[]u8") or
            !module.names.is(node.result.type_name, "Allocator") {
            return try self.fail0("wasm error: mem_fixed_buffer expects []u8 -> Allocator");
        }
        let view = try self.arg_expr(module, node, 0);
        var call = try string::from_bytes(self.allocator, "(call $__fixed_buffer ");
        errdefer call.deinit(self.allocator);
        try self.names.append_to(&var call, view);
        try call.append_bytes(self.allocator, ")");
        let expr = try self.names.intern_owned(move call);
        return self.write_scalar_result(module, node.result, expr);
    }
    if module.names.is(node.operand, "std::internal::builtin::mem_allocator_from") {
        return self.write_allocator_from_call(module, node);
    }
    if module.names.is(node.operand, "std::internal::builtin::io_blocking") {
        if node.args.len() != 0 or !module.names.is(node.result.type_name, "Io") {
            return try self.fail0("wasm error: io_blocking expects no args -> Io");
        }
        let expr = try self.names.intern("(i32.const 1)");
        return self.write_scalar_result(module, node.result, expr);
    }
    if module.names.is(node.operand, "std::internal::builtin::io_failing") {
        if node.args.len() != 0 or !module.names.is(node.result.type_name, "Io") {
            return try self.fail0("wasm error: io_failing expects no args -> Io");
        }
        let expr = try self.names.intern("(i32.const 2)");
        return self.write_scalar_result(module, node.result, expr);
    }
    var result_slot = ir::empty_name();
    if try self.is_memory_type(module, node.result.type_name) {
        result_slot = try self.result_slot(module, node.result) orelse
            return try self.fail0("wasm error: no frame slot for call result");
    }
    var call = try string::from_bytes(self.allocator, "(call $");
    errdefer call.deinit(self.allocator);
    try module.names.append_to(&var call, node.operand);
    try call.append_bytes(self.allocator, " ");
    var wrote = false;
    if !ir::is_empty(result_slot) {
        try self.names.append_to(&var call, result_slot);
        wrote = true;
    }
    let callee = self.functions_by_name.get(ir::name_id(node.operand));
    var index = 0;
    while node.args.get(index) |arg| {
        if wrote {
            try call.append_bytes(self.allocator, " ");
        }
        wrote = true;
        var expr = ir::empty_name();
        var adapted = false;
        if callee |function| {
            if module.function_param(function, index) |param| {
                if try self.write_call_arg(
                    module,
                    node,
                    arg,
                    param,
                    index,
                    &var expr
                ) |failed| {
                    call.deinit(self.allocator);
                    return move failed;
                }
                adapted = true;
            }
        }
        if !adapted {
            let info = try self.value_of(module, arg);
            expr = info.expr;
        }
        index = index + 1;
        try self.names.append_to(&var call, expr);
    }
    try call.append_bytes(self.allocator, ")");
    if module.names.is(node.result.type_name, "void") or
        try self.is_memory_type(module, node.result.type_name) {
        try self.line1("            %s", Arg::Owned(move call));
        if try self.is_memory_type(module, node.result.type_name) {
            try self.set_value(module, node.result, result_slot);
        }
        return null;
    }
    let result_retained = ir::name_text(&module.names, node.result.name);
    let result_bytes = result_retained.as_bytes();
    let symbol = try self.symbol_name_of(result_bytes);
    try self.line2("            (local.set %s %s)", Arg::Str(symbol), Arg::Owned(move call));
    let expr = try self.local_expr(result_bytes);
    try self.set_value(module, node.result, expr);
    return null;
}

/// Writes one byte string and a newline to stdout, the Go `writePrintLine`:
/// the one print primitive std::fmt::print is built on (SPEC §14.1).
fn (self: &var Emitter) write_print_line(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.args.get_or_panic(0).type_name, "[]u8") {
        return try self.fail0("wasm error: print.line expects []u8");
    }
    let arg = node.args.get_or_panic(0);
    let info = try self.value_of(module, arg);
    let length_address = try self.address_at(info.expr, 4);
    var pointer = try string::from_bytes(self.allocator, "(i32.load ");
    errdefer pointer.deinit(self.allocator);
    try self.names.append_to(&var pointer, info.expr);
    try pointer.append_byte(self.allocator, cast<u8>(41));
    let pointer_expr = try self.names.intern_owned(move pointer);
    var length = try string::from_bytes(self.allocator, "(i32.load ");
    errdefer length.deinit(self.allocator);
    try self.names.append_to(&var length, length_address);
    try length.append_byte(self.allocator, cast<u8>(41));
    let length_expr = try self.names.intern_owned(move length);
    try self.line2("            (call $__write_line %s %s)",
        Arg::Str(pointer_expr), Arg::Str(length_expr));
    return null;
}

/// Returns the expression standing for one instruction argument, the Go
/// `e.value(instr.Args[i]).expr`.
fn (self: &var Emitter) arg_expr(
    module: &ir::Module,
    node: &ir::InstrNode,
    index: i64
) -> !ir::Name {
    let arg = node.args.get(index) orelse ir::empty_value();
    let info = try self.value_of(module, arg);
    return info.expr;
}

/// Writes control transfer for one dispatch arm, the Go `writeTerminator`.
fn (self: &var Emitter) write_terminator(
    module: &ir::Module,
    block: ir::Block,
    index: &map::Map<[]u8, DispatchBlock>
) -> !?diagnostic::Diagnostic {
    let term = module.block_terminator(block);
    if term.op == ir::TermOp::Return {
        return self.write_return(module, term.value);
    }
    if term.op == ir::TermOp::Jump {
        try self.write_jump(module, block, term.target, index);
        return null;
    }
    if term.op == ir::TermOp::Branch {
        try self.write_branch(module, block, index);
        return null;
    }
    if term.op == ir::TermOp::Unreachable {
        try self.line("            (unreachable)");
        return null;
    }
    let spelling = term_op_spelling(term.op);
    return try self.fail("wasm error: unsupported terminator `%s`", Arg::Lit(spelling));
}

/// Returns the Go `Terminator.Op` spelling a failure message names; a block
/// that has not ended yet is the Go empty string.
fn term_op_spelling(op: ir::TermOp) -> []u8 {
    return match op {
        None => "",
        Return => "return",
        Jump => "jump",
        Branch => "branch",
        Unreachable => "unreachable",
    };
}

/// Writes a function return or exits a void function, the Go `writeReturn`.
fn (self: &var Emitter) write_return(
    module: &ir::Module,
    value: ir::Value
) -> !?diagnostic::Diagnostic {
    if module.names.is(value.type_name, "void") {
        try self.restore_frame(module);
        try self.line("            (br $exit)");
        return null;
    }
    let info = try self.value_of(module, value);
    if try self.is_memory_type(module, value.type_name) {
        let outcome = try self.type_layout(module, value.type_name);
        match outcome {
            Error(failed) => return move failed,
            Layout(layout) => {
                let result = try self.names.intern("(local.get $__kizu_result)");
                try self.write_memory_copy(result, info.expr, layout.size);
                try self.restore_frame(module);
                try self.line("            (br $exit)");
                return null;
            },
        }
    }
    try self.restore_frame(module);
    try self.line1("            (return %s)", Arg::Str(info.expr));
    return null;
}

/// Releases this invocation's fixed frame before any return.
fn (self: &var Emitter) restore_frame(module: &ir::Module) -> !void {
    if self.frame_size > 0 {
        if self.uses_allocator_runtime(module) {
            return self.line1(
                "            (call $__stack_free (local.get $__kizu_frame) (i32.const %d))",
                Arg::Int(self.frame_size)
            );
        }
        return self.line("            (global.set $__stack_pointer (local.get $__kizu_frame))");
    }
    return;
}

/// Writes an unconditional dispatch jump, the Go `writeJump`.
fn (self: &var Emitter) write_jump(
    module: &ir::Module,
    block: ir::Block,
    target: ir::Name,
    index: &map::Map<[]u8, DispatchBlock>
) -> !void {
    let source = module.block_name(block);
    try self.write_phi_copies(module, source, target, index);
    let id = block_index_of(module, index, target);
    try self.line1("            (local.set $pc (i32.const %d))", Arg::Int(id));
    return self.line("            (br $dispatch)");
}

/// Writes a conditional dispatch jump, the Go `writeBranch`.
fn (self: &var Emitter) write_branch(
    module: &ir::Module,
    block: ir::Block,
    index: &map::Map<[]u8, DispatchBlock>
) -> !void {
    let term = module.block_terminator(block);
    let source = module.block_name(block);
    let info = try self.value_of(module, term.cond);
    try self.line1("            (if %s", Arg::Str(info.expr));
    try self.line("              (then");
    try self.write_phi_copies(module, source, term.target, index);
    let target_id = block_index_of(module, index, term.target);
    try self.line1("                (local.set $pc (i32.const %d))", Arg::Int(target_id));
    try self.line("                (br $dispatch))");
    try self.line("              (else");
    try self.write_phi_copies(module, source, term.else_target, index);
    let else_id = block_index_of(module, index, term.else_target);
    try self.line1("                (local.set $pc (i32.const %d))", Arg::Int(else_id));
    return self.line("                (br $dispatch)))");
}

/// Assigns target phi locals for an edge, the Go `writePhiCopies`. The edge
/// stays inside one function, so the target is read out of that function's
/// dispatch map.
fn (self: &var Emitter) write_phi_copies(
    module: &ir::Module,
    source: ir::Name,
    target: ir::Name,
    index: &map::Map<[]u8, DispatchBlock>
) -> !void {
    let block = block_named(module, index, target) orelse return;
    let node = module.blocks.at(block.node);
    var instr_index = 0;
    while node.instrs.get(instr_index) |instr| {
        instr_index = instr_index + 1;
        let instr_node = module.instrs.at(instr.node);
        if instr_node.op != ir::Op::Phi {
            continue;
        }
        var incoming_index = 0;
        while instr_node.incoming.get(incoming_index) |incoming| {
            incoming_index = incoming_index + 1;
            if !ir::same_name(incoming.block, source) {
                continue;
            }
            try self.write_local_copy(module, instr_node.result, incoming.value, "            ");
        }
    }
    return;
}

/// Copies one value into a local, the Go `writeLocalCopy`.
fn (self: &var Emitter) write_local_copy(
    module: &ir::Module,
    dst: ir::Value,
    src: ir::Value,
    indent: []u8
) -> !void {
    let info = try self.value_of(module, src);
    let dst_retained = ir::name_text(&module.names, dst.name);
    let dst_bytes = dst_retained.as_bytes();
    let symbol = try self.symbol_name_of(dst_bytes);
    try self.line3("%s(local.set %s %s)", Arg::Lit(indent), Arg::Str(symbol), Arg::Str(info.expr));
    let expr = try self.local_expr(dst_bytes);
    return self.set_value(module, dst, expr);
}

/// Maps bool constants to WebAssembly i32 constants, the Go `wasmBool`.
fn wasm_bool(names: &ir::NameTable, value: ir::Name) -> []u8 {
    if names.is(value, "true") {
        return "(i32.const 1)";
    }
    return "(i32.const 0)";
}

/// Spells a floating-point constant exactly, the Go `floatConstExpr`: the
/// bits of the value reinterpreted, since a decimal in the text format would
/// round again. An f32 is the f64 it widens to, demoted, which is exact.
fn (self: &var Emitter) float_const_expr(module: &ir::Module, node: &ir::InstrNode) -> !?ir::Name {
    let literal_text = ir::name_text(&module.names, node.immediate);
    let literal = literal_text.as_bytes();
    var value = try typ::parse_float_literal(self.allocator, literal) orelse return null;
    let narrow = module.names.is(node.result.type_name, "f32");
    if narrow {
        value = cast<f64>(cast<f32>(value));
    }
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    if narrow {
        try out.append_bytes(self.allocator, "(f32.demote_f64 ");
    }
    try out.append_bytes(self.allocator, "(f64.reinterpret_i64 (i64.const ");
    try fmt::append_i64(self.allocator, &var out, cast<i64>(float::bits(value)));
    try out.append_bytes(self.allocator, "))");
    if narrow {
        try out.append_byte(self.allocator, cast<u8>(41));
    }
    return try self.names.intern_owned(move out);
}

/// Writes a cast with a floating-point side (SPEC §6.9.3), the Go
/// `floatCastExpr`. An integer widens to a float by rounding; a float narrows
/// to an integer by truncating toward zero and saturating, with NaN going to
/// 0, which is what the saturating truncation instructions do; the narrower
/// integer types are clamped to their own range afterwards. `f32` and `f64`
/// convert by rounding, and a cast to the same type is the value itself.
fn (self: &var Emitter) write_float_cast(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let source = node.args.get_or_panic(0).type_name;
    let target = node.result.type_name;
    let value = try self.arg_expr(module, node, 0);
    var expression = string::new(self.allocator);
    errdefer expression.deinit(self.allocator);
    if ir::same_name(source, target) {
        try self.names.append_to(&var expression, value);
    } else {
        if is_float_type(&module.names, source) and is_float_type(&module.names, target) {
            if module.names.is(target, "f32") {
                try expression.append_bytes(self.allocator, "(f32.demote_f64 ");
            } else {
                try expression.append_bytes(self.allocator, "(f64.promote_f32 ");
            }
            try self.names.append_to(&var expression, value);
            try expression.append_byte(self.allocator, cast<u8>(41));
        } else {
            if is_float_type(&module.names, source) {
                try self.append_float_to_integer(module, &var expression, source, target, value);
            } else {
                try expression.append_byte(self.allocator, cast<u8>(40));
                try expression.append_bytes(self.allocator, wasm_type(module, target));
                try expression.append_bytes(self.allocator, ".convert_i64");
                if is_unsigned_integer_type(&module.names, source) {
                    try expression.append_bytes(self.allocator, "_u ");
                } else {
                    try expression.append_bytes(self.allocator, "_s ");
                }
                try self.names.append_to(&var expression, value);
                try expression.append_byte(self.allocator, cast<u8>(41));
            }
        }
    }
    let expr = try self.names.intern_owned(move expression);
    try self.set_value(module, node.result, expr);
    return null;
}

/// Appends the saturating truncation of a float to an integer type, clamped
/// to the range of a narrower type, the Go `clampToIntegerRange`.
fn (self: &var Emitter) append_float_to_integer(
    module: &ir::Module,
    out: &var string::String,
    source: ir::Name,
    target: ir::Name,
    value: ir::Name
) -> !void {
    var truncated = string::new(self.allocator);
    defer truncated.deinit(self.allocator);
    try truncated.append_bytes(self.allocator, "(i64.trunc_sat_");
    try truncated.append_bytes(self.allocator, wasm_type(module, source));
    if is_unsigned_integer_type(&module.names, target) {
        try truncated.append_bytes(self.allocator, "_u ");
    } else {
        try truncated.append_bytes(self.allocator, "_s ");
    }
    try self.names.append_to(&var truncated, value);
    try truncated.append_byte(self.allocator, cast<u8>(41));
    var low = 0;
    var high = 0;
    if module.names.is(target, "i8") {
        low = -128;
        high = 127;
    } else {
        if module.names.is(target, "i16") {
            low = -32768;
            high = 32767;
        } else {
            if module.names.is(target, "i32") {
                low = -2147483648;
                high = 2147483647;
            } else {
                if module.names.is(target, "u8") {
                    high = 255;
                } else {
                    if module.names.is(target, "u16") {
                        high = 65535;
                    } else {
                        if module.names.is(target, "u32") {
                            high = 4294967295;
                        } else {
                            return out.append_string(self.allocator, &truncated);
                        }
                    }
                }
            }
        }
    }
    // (select high clamped_low (i64.gt_s clamped_low high)), where
    // clamped_low is (select low value (i64.lt_s value low)).
    var clamped_low = string::new(self.allocator);
    defer clamped_low.deinit(self.allocator);
    try clamped_low.append_bytes(self.allocator, "(select (i64.const ");
    try fmt::append_i64(self.allocator, &var clamped_low, low);
    try clamped_low.append_bytes(self.allocator, ") ");
    try clamped_low.append_string(self.allocator, &truncated);
    try clamped_low.append_bytes(self.allocator, " (i64.lt_s ");
    try clamped_low.append_string(self.allocator, &truncated);
    try clamped_low.append_bytes(self.allocator, " (i64.const ");
    try fmt::append_i64(self.allocator, &var clamped_low, low);
    try clamped_low.append_bytes(self.allocator, ")))");
    try out.append_bytes(self.allocator, "(select (i64.const ");
    try fmt::append_i64(self.allocator, out, high);
    try out.append_bytes(self.allocator, ") ");
    try out.append_string(self.allocator, &clamped_low);
    try out.append_bytes(self.allocator, " (i64.gt_s ");
    try out.append_string(self.allocator, &clamped_low);
    try out.append_bytes(self.allocator, " (i64.const ");
    try fmt::append_i64(self.allocator, out, high);
    try out.append_bytes(self.allocator, ")))");
    return;
}

/// Reinterprets a float as its bits or bits as a float, the
/// `std::float::bits` and `std::float::from_bits` primitives; the Go
/// `writeFloatBits`.
fn (self: &var Emitter) write_float_bits(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail_op(module, node, "wasm error: %s expects 1 arg");
    }
    let value = try self.arg_expr(module, node, 0);
    var expression = string::new(self.allocator);
    errdefer expression.deinit(self.allocator);
    if node.op == ir::Op::FloatBits {
        try expression.append_bytes(self.allocator, "(i64.reinterpret_f64 ");
    } else {
        try expression.append_bytes(self.allocator, "(f64.reinterpret_i64 ");
    }
    try self.names.append_to(&var expression, value);
    try expression.append_byte(self.allocator, cast<u8>(41));
    let expr = try self.names.intern_owned(move expression);
    return self.write_scalar_result(module, node.result, expr);
}
