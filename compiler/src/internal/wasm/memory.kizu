import compiler::internal::diagnostic;
import compiler::internal::ir;
import std::fmt;
import std::mem;
import std::string;

// Mechanical port of internal/wasm/memory.go: typed linear-memory loads,
// stores, address arithmetic, and aggregate copies.

/// Adds a constant byte offset to one linear-memory address expression.
fn (self: &var Emitter) address_at(base: ir::Name, offset: i64) -> !ir::Name {
    if offset == 0 {
        return base;
    }
    var out = try string::from_bytes(self.allocator, "(i32.add ");
    errdefer out.deinit(self.allocator);
    try self.names.append_to(&var out, base);
    try out.append_bytes(self.allocator, " (i32.const ");
    try fmt::append_i64(self.allocator, &var out, offset);
    try out.append_bytes(self.allocator, "))");
    return self.names.intern_owned(move out);
}

/// Stores value at base+offset according to typ's wasm32 layout. Aggregates
/// are copied byte-for-byte from their addressed value.
fn (self: &var Emitter) write_store_value(
    module: &ir::Module,
    base: ir::Name,
    offset: i64,
    typ: ir::Name,
    value: ValueInfo
) -> !?diagnostic::Diagnostic {
    let address = try self.address_at(base, offset);
    if try self.is_memory_type(module, typ) {
        let outcome = try self.type_layout(module, typ);
        match outcome {
            Error(failed) => return move failed,
            Layout(layout) => {
                try self.write_memory_copy(address, value.expr, layout.size);
                return null;
            },
        }
    }
    if wasm_store_op(module, typ) |op| {
        let owned_op = try self.names.intern(op);
        try self.line3("            (%s %s %s)",
            Arg::Str(owned_op), Arg::Str(address), Arg::Str(value.expr));
        return null;
    }
    let type_name = try self.own(module, typ);
    return try self.fail("wasm error: type `%s` cannot be stored in linear memory", Arg::Str(type_name));
}

/// Loads one result from base+offset, copying an aggregate into its result
/// slot or assigning a scalar local.
fn (self: &var Emitter) write_load_value(
    module: &ir::Module,
    result: ir::Value,
    base: ir::Name,
    offset: i64
) -> !?diagnostic::Diagnostic {
    if try self.is_memory_type(module, result.type_name) {
        if try self.result_slot(module, result) |slot| {
            let outcome = try self.type_layout(module, result.type_name);
            match outcome {
                Error(failed) => return move failed,
                Layout(layout) => {
                    let source = try self.address_at(base, offset);
                    try self.write_memory_copy(slot, source, layout.size);
                    try self.set_value(module, result, slot);
                    return null;
                },
            }
        }
        return try self.fail0("wasm error: no frame slot for aggregate load");
    }
    if wasm_load_op(module, result.type_name) |op| {
        let address = try self.address_at(base, offset);
        var loaded = try string::from_bytes(self.allocator, "(");
        errdefer loaded.deinit(self.allocator);
        try loaded.append_bytes(self.allocator, op);
        try loaded.append_byte(self.allocator, cast<u8>(32));
        try self.names.append_to(&var loaded, address);
        try loaded.append_byte(self.allocator, cast<u8>(41));
        let expr = try self.names.intern_owned(move loaded);
        let retained = ir::name_text(&module.names, result.name);
        let bytes = retained.as_bytes();
        let symbol = try self.symbol_name_of(bytes);
        try self.line2("            (local.set %s %s)", Arg::Str(symbol), Arg::Str(expr));
        let local = try self.local_expr(bytes);
        try self.set_value(module, result, local);
        return null;
    }
    let type_name = try self.own(module, result.type_name);
    return try self.fail("wasm error: type `%s` cannot be loaded from linear memory", Arg::Str(type_name));
}

/// Returns the largest byte count a copy or a zeroing of a fixed size is
/// written out as loads and stores, the Go `inlineCopyLimit`. memory.copy and
/// memory.fill leave the engine's compiled code for a runtime routine, which
/// costs more than the handful of word moves an aggregate of a few fields
/// needs.
fn inline_copy_limit() -> i64 {
    return 64;
}

/// Copies size bytes from src to dst, the Go `writeMemoryCopy`. The two
/// addresses of an aggregate copy never lie partly over each other: a value
/// has a slot of its own, so the word-by-word copy reads what memory.copy
/// would.
fn (self: &var Emitter) write_memory_copy(dst: ir::Name, src: ir::Name, size: i64) -> !void {
    if size == 0 {
        return;
    }
    if size > inline_copy_limit() or !self.is_plain_address(dst) or !self.is_plain_address(src) {
        return self.line3("            (memory.copy %s %s (i32.const %d))",
            Arg::Str(dst), Arg::Str(src), Arg::Int(size));
    }
    var offset = 0;
    while offset < size {
        let chunk = copy_chunk(size - offset);
        let target = try self.address_at(dst, offset);
        let source = try self.address_at(src, offset);
        try self.line4("            (%s %s (%s %s))",
            Arg::Lit(chunk.store), Arg::Str(target), Arg::Lit(chunk.load), Arg::Str(source));
        offset = offset + chunk.width;
    }
    return;
}

/// Zeroes size bytes at a fixed-size address, the Go `writeMemoryZero`.
fn (self: &var Emitter) write_memory_zero(dst: ir::Name, size: i64) -> !void {
    if size == 0 {
        return;
    }
    if size > inline_copy_limit() or !self.is_plain_address(dst) {
        return self.line2("            (memory.fill %s (i32.const 0) (i32.const %d))",
            Arg::Str(dst), Arg::Int(size));
    }
    var offset = 0;
    while offset < size {
        let chunk = copy_chunk(size - offset);
        let target = try self.address_at(dst, offset);
        var zero: []u8 = "(i64.const 0)";
        if chunk.width < 8 {
            zero = "(i32.const 0)";
        }
        try self.line3("            (%s %s %s)", Arg::Lit(chunk.store), Arg::Str(target), Arg::Lit(zero));
        offset = offset + chunk.width;
    }
    return;
}

/// Is the widest word that fits in the bytes left to move, with the load and
/// store that move it, the Go `copyChunk` results.
struct CopyChunk {
    width: i64,
    load: []u8,
    store: []u8,
}

/// Returns the widest word that fits in left bytes, the Go `copyChunk`.
fn copy_chunk(left: i64) -> CopyChunk {
    if left >= 8 {
        return CopyChunk { width: 8, load: "i64.load", store: "i64.store" };
    }
    if left >= 4 {
        return CopyChunk { width: 4, load: "i32.load", store: "i32.store" };
    }
    return CopyChunk { width: 1, load: "i32.load8_u", store: "i32.store8" };
}

/// Reports whether an address expression reads nothing but locals and
/// constants, so writing it once per word neither repeats a memory read nor
/// changes what a later word's copy addresses, the Go `isPlainAddress`.
fn (self: &Emitter) is_plain_address(expr: ir::Name) -> bool {
    let retained = ir::name_text(&self.names, expr);
    let bytes = retained.as_bytes();
    return !wasm_bytes_contain(bytes, "load") and !wasm_bytes_contain(bytes, "call") and
        !wasm_bytes_contain(bytes, "global");
}

/// Reports whether needle occurs in haystack, the Go `strings.Contains`.
fn wasm_bytes_contain(haystack: []u8, needle: []u8) -> bool {
    let needle_len = mem::len(needle);
    var start = 0;
    while start + needle_len <= mem::len(haystack) {
        if mem::equal_bytes(haystack[start..start + needle_len], needle) {
            return true;
        }
        start = start + 1;
    }
    return false;
}

fn wasm_store_op(module: &ir::Module, typ: ir::Name) -> ?[]u8 {
    if is_named_i64_type(module, typ) {
        return "i64.store";
    }
    let retained = ir::name_text(&module.names, typ);
    let bytes = retained.as_bytes();
    if is_buffer_wasm_type(bytes) {
        return "i32.store";
    }
    if module.names.is(typ, "bool") {
        return "i32.store8";
    }
    if module.names.is(typ, "i8") or module.names.is(typ, "u8") {
        return "i64.store8";
    }
    if module.names.is(typ, "i16") or module.names.is(typ, "u16") {
        return "i64.store16";
    }
    if module.names.is(typ, "i32") or module.names.is(typ, "u32") or
        module.names.is(typ, "usize") or module.names.is(typ, "isize") {
        return "i64.store32";
    }
    if module.names.is(typ, "i64") or module.names.is(typ, "u64") {
        return "i64.store";
    }
    if module.names.is(typ, "f32") {
        return "f32.store";
    }
    if module.names.is(typ, "f64") {
        return "f64.store";
    }
    if module.names.is(typ, "Allocator") or module.names.is(typ, "Io") {
        return "i32.store";
    }
    if is_wasm_reference_type(bytes) or is_wasm_raw_pointer_type(bytes) or
        is_wasm_function_pointer_type(bytes) or is_box_wasm_type(bytes) {
        return "i32.store";
    }
    return null;
}

fn wasm_load_op(module: &ir::Module, typ: ir::Name) -> ?[]u8 {
    if is_named_i64_type(module, typ) {
        return "i64.load";
    }
    let retained = ir::name_text(&module.names, typ);
    let bytes = retained.as_bytes();
    if is_buffer_wasm_type(bytes) {
        return "i32.load";
    }
    if module.names.is(typ, "bool") {
        return "i32.load8_u";
    }
    if module.names.is(typ, "i8") {
        return "i64.load8_s";
    }
    if module.names.is(typ, "u8") {
        return "i64.load8_u";
    }
    if module.names.is(typ, "i16") {
        return "i64.load16_s";
    }
    if module.names.is(typ, "u16") {
        return "i64.load16_u";
    }
    if module.names.is(typ, "i32") or module.names.is(typ, "isize") {
        return "i64.load32_s";
    }
    if module.names.is(typ, "u32") or module.names.is(typ, "usize") {
        return "i64.load32_u";
    }
    if module.names.is(typ, "i64") or module.names.is(typ, "u64") {
        return "i64.load";
    }
    if module.names.is(typ, "f32") {
        return "f32.load";
    }
    if module.names.is(typ, "f64") {
        return "f64.load";
    }
    if module.names.is(typ, "Allocator") or module.names.is(typ, "Io") {
        return "i32.load";
    }
    if is_wasm_reference_type(bytes) or is_wasm_raw_pointer_type(bytes) or
        is_wasm_function_pointer_type(bytes) or is_box_wasm_type(bytes) {
        return "i32.load";
    }
    return null;
}

/// Spells the load of one type named by its spelling, the Go `loadOp`, for a
/// type the module may never name on its own, such as an optional's payload.
fn wasm_load_op_bytes(module: &ir::Module, typ: []u8) -> ?[]u8 {
    if is_named_i64_bytes(module, typ) {
        return "i64.load";
    }
    if is_buffer_wasm_type(typ) {
        return "i32.load";
    }
    if mem::equal_bytes(typ, "bool") {
        return "i32.load8_u";
    }
    if mem::equal_bytes(typ, "i8") {
        return "i64.load8_s";
    }
    if mem::equal_bytes(typ, "u8") {
        return "i64.load8_u";
    }
    if mem::equal_bytes(typ, "i16") {
        return "i64.load16_s";
    }
    if mem::equal_bytes(typ, "u16") {
        return "i64.load16_u";
    }
    if mem::equal_bytes(typ, "i32") or mem::equal_bytes(typ, "isize") {
        return "i64.load32_s";
    }
    if mem::equal_bytes(typ, "u32") or mem::equal_bytes(typ, "usize") {
        return "i64.load32_u";
    }
    if mem::equal_bytes(typ, "i64") or mem::equal_bytes(typ, "u64") {
        return "i64.load";
    }
    if mem::equal_bytes(typ, "f32") {
        return "f32.load";
    }
    if mem::equal_bytes(typ, "f64") {
        return "f64.load";
    }
    if mem::equal_bytes(typ, "Allocator") or mem::equal_bytes(typ, "Io") {
        return "i32.load";
    }
    if is_wasm_reference_type(typ) or is_wasm_raw_pointer_type(typ) or
        is_wasm_function_pointer_type(typ) or is_box_wasm_type(typ) {
        return "i32.load";
    }
    return null;
}
