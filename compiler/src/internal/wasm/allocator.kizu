import compiler::internal::diagnostic;
import compiler::internal::ir;
import std::mem;

// Mechanical port of internal/wasm/allocator.go. Function frames and explicit
// page allocations share one address-ordered free list, while fixed and user
// allocators stay explicit dispatch kinds.

/// Reports whether op is one of the Array runtime instructions.
fn is_wasm_array_op(op: ir::Op) -> bool {
    return match op {
        ArrayNew => true,
        ArrayAppend => true,
        ArrayAppendBytes => true,
        ArrayAsBytes => true,
        ArrayAt => true,
        ArrayAtMut => true,
        ArrayCapacity => true,
        ArrayClear => true,
        ArrayDeinit => true,
        ArrayGet => true,
        ArrayGetOrPanic => true,
        ArrayLen => true,
        ArrayPop => true,
        ArrayPopOrPanic => true,
        ArrayReserve => true,
        ArraySet => true,
        ArraySwap => true,
        ArrayTruncate => true,
        _ => false,
    };
}

fn (self: &Emitter) uses_array_runtime(module: &ir::Module) -> bool {
    var function_index = 0;
    while module.functions.get(function_index) |function| {
        function_index = function_index + 1;
        let function_node = module.function_nodes.at(function.node);
        var block_index = 0;
        while function_node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let node = module.instrs.at(instr.node);
                if is_wasm_array_op(node.op) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn (self: &Emitter) uses_user_allocator_runtime(module: &ir::Module) -> bool {
    var function_index = 0;
    while module.functions.get(function_index) |function| {
        function_index = function_index + 1;
        let function_node = module.function_nodes.at(function.node);
        var block_index = 0;
        while function_node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let node = module.instrs.at(instr.node);
                if node.op == ir::Op::Call and module.names.is(
                    node.operand,
                    "std::internal::builtin::mem_allocator_from"
                ) {
                    return true;
                }
            }
        }
    }
    return false;
}

/// Reports whether frames must coexist with explicit linear-memory storage.
fn (self: &Emitter) uses_allocator_runtime(module: &ir::Module) -> bool {
    if self.uses_array_runtime(module) or self.uses_box_runtime(module) or
        self.uses_arena_runtime(module) or
        self.uses_user_allocator_runtime(module) {
        return true;
    }
    var function_index = 0;
    while module.functions.get(function_index) |function| {
        function_index = function_index + 1;
        let function_node = module.function_nodes.at(function.node);
        var block_index = 0;
        while function_node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let node = module.instrs.at(instr.node);
                if node.op == ir::Op::Call and module.names.is(
                    node.operand,
                    "std::internal::builtin::mem_fixed_buffer"
                ) {
                    return true;
                }
            }
        }
    }
    return false;
}

/// Installs kind, state, and two table indexes in the caller-owned header.
fn (self: &var Emitter) write_allocator_from_call(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or !module.names.is(node.result.type_name, "Allocator") {
        return try self.fail0(
            "wasm error: mem_allocator_from expects state, alloc, free -> Allocator"
        );
    }
    let state_value = node.args.get_or_panic(0);
    let alloc_value = node.args.get_or_panic(1);
    let release_value = node.args.get_or_panic(2);
    let state_type = ir::name_text(&module.names, state_value.type_name);
    let alloc_type = ir::name_text(&module.names, alloc_value.type_name);
    let release_type = ir::name_text(&module.names, release_value.type_name);
    let state_type_bytes = state_type.as_bytes();
    let alloc_type_bytes = alloc_type.as_bytes();
    let release_type_bytes = release_type.as_bytes();
    if !mem::starts_with(state_type_bytes, "&var ") or
        !mem::starts_with(alloc_type_bytes, "unsafe fn(") or
        !mem::starts_with(release_type_bytes, "unsafe fn(") {
        return try self.fail0(
            "wasm error: mem_allocator_from expects state, alloc, free -> Allocator"
        );
    }
    let state = try self.value_of(module, state_value);
    let alloc = try self.value_of(module, alloc_value);
    let release = try self.value_of(module, release_value);
    try self.line1("            (i64.store %s (i64.const 2))", Arg::Str(state.expr));
    let state_field = try self.address_at(state.expr, 8);
    try self.line2(
        "            (i64.store %s (i64.extend_i32_u %s))",
        Arg::Str(state_field),
        Arg::Str(state.expr)
    );
    let alloc_field = try self.address_at(state.expr, 16);
    try self.line2(
        "            (i64.store %s (i64.extend_i32_u %s))",
        Arg::Str(alloc_field),
        Arg::Str(alloc.expr)
    );
    let release_field = try self.address_at(state.expr, 24);
    try self.line2(
        "            (i64.store %s (i64.extend_i32_u %s))",
        Arg::Str(release_field),
        Arg::Str(release.expr)
    );
    return self.write_scalar_result(module, node.result, state.expr);
}

/// Emits the page allocator, explicit dispatch, and Array generic helpers.
fn (self: &var Emitter) write_allocator_runtime(module: &ir::Module) -> !void {
    try self.write_page_alloc_helper();
    try self.write_page_free_helper();
    try self.write_page_realloc_helper();
    try self.write_fixed_buffer_helper();
    try self.write_fixed_alloc_helper();
    try self.write_allocator_dispatch_helpers(module);
    try self.write_array_reserve_helper();
    return self.write_array_swap_helper();
}

fn (self: &var Emitter) write_fixed_buffer_helper() -> !void {
    try self.line("  (func $__fixed_buffer (param $view i32) (result i32)");
    try self.line("    (local $ptr i32) (local $length i32) (local $header i32)");
    try self.line("    (local $data i32) (local $end i32)");
    try self.line("    (local.set $ptr (i32.load (local.get $view)))");
    try self.line("    (local.set $length (i32.load (i32.add (local.get $view) (i32.const 4))))");
    try self.line("    (local.set $end (i32.add (local.get $ptr) (local.get $length)))");
    try self.line("    (local.set $header");
    try self.line("      (i32.and (i32.add (local.get $ptr) (i32.const 15)) (i32.const -16)))");
    try self.line("    (local.set $data (i32.add (local.get $header) (i32.const 32)))");
    try self.line("    (if (i32.or (i32.eqz (local.get $ptr))");
    try self.line("          (i32.or (i32.lt_u (local.get $end) (local.get $ptr))");
    try self.line("            (i32.gt_u (local.get $data) (local.get $end))))");
    try self.line("      (then");
    try self.line("        (i64.store (i32.const 256) (i64.const 1))");
    try self.line("        (i32.store (i32.const 264) (i32.const 0))");
    try self.line("        (i64.store (i32.const 272) (i64.const 0))");
    try self.line("        (i64.store (i32.const 280) (i64.const 0))");
    try self.line("        (return (i32.const 256))))");
    try self.line("    (i64.store (local.get $header) (i64.const 1))");
    try self.line("    (i32.store (i32.add (local.get $header) (i32.const 8)) (local.get $data))");
    try self.line("    (i64.store (i32.add (local.get $header) (i32.const 16))");
    try self.line("      (i64.extend_i32_u (i32.sub (local.get $end) (local.get $data))))");
    try self.line("    (i64.store (i32.add (local.get $header) (i32.const 24)) (i64.const 0))");
    try self.line("    (local.get $header)");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_fixed_alloc_helper() -> !void {
    try self.line("  (func $__fixed_alignment (param $size i32) (result i32)");
    try self.line("    (local $align i32)");
    try self.line("    (local.set $align (i32.const 1))");
    try self.line("    (block $done");
    try self.line("      (loop $grow");
    try self.line("        (br_if $done (i32.ge_u (local.get $align) (local.get $size)))");
    try self.line("        (br_if $done (i32.ge_u (local.get $align) (i32.const 16)))");
    try self.line("        (local.set $align (i32.mul (local.get $align) (i32.const 2)))");
    try self.line("        (br $grow)))");
    try self.line("    (local.get $align)");
    try self.line("  )");
    try self.out.append_byte(self.allocator, cast<u8>(10));
    try self.line("  (func $__fixed_alloc (param $allocator i32) (param $size i32) (result i32)");
    try self.line("    (local $align i32) (local $offset i64) (local $aligned i64)");
    try self.line("    (local $capacity i64) (local $next i64) (local $data i32)");
    try self.line("    (if (i32.lt_s (local.get $size) (i32.const 0))");
    try self.line("      (then (return (i32.const 0))))");
    try self.line("    (local.set $align (call $__fixed_alignment (local.get $size)))");
    try self.line("    (local.set $offset");
    try self.line("      (i64.load (i32.add (local.get $allocator) (i32.const 24))))");
    try self.line("    (local.set $aligned");
    try self.line("      (i64.and");
    try self.line("        (i64.add (local.get $offset)");
    try self.line("          (i64.extend_i32_u (i32.sub (local.get $align) (i32.const 1))))");
    try self.line("        (i64.extend_i32_s (i32.sub (i32.const 0) (local.get $align)))))");
    try self.line("    (local.set $capacity");
    try self.line("      (i64.load (i32.add (local.get $allocator) (i32.const 16))))");
    try self.line("    (local.set $next");
    try self.line("      (i64.add (local.get $aligned) (i64.extend_i32_u (local.get $size))))");
    try self.line("    (if (i64.gt_u (local.get $next) (local.get $capacity))");
    try self.line("      (then (return (i32.const 0))))");
    try self.line("    (i64.store (i32.add (local.get $allocator) (i32.const 24)) (local.get $next))");
    try self.line("    (local.set $data (i32.load (i32.add (local.get $allocator) (i32.const 8))))");
    try self.line("    (i32.add (local.get $data) (i32.wrap_i64 (local.get $aligned)))");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_page_alloc_helper() -> !void {
    try self.line("  (func $__page_alloc (param $size i32) (result i32)");
    try self.line("    (local $need i32) (local $previous i32) (local $current i32)");
    try self.line("    (local $capacity i32) (local $next i32) (local $remaining i32)");
    try self.line("    (local $split i32) (local $base i32) (local $end i32)");
    try self.line("    (local $required i32) (local $pages i32)");
    try self.line("    (if (i32.eqz (local.get $size))");
    try self.line("      (then (local.set $size (i32.const 1))))");
    try self.line("    (if (i32.gt_u (local.get $size) (i32.const 2147483640))");
    try self.line("      (then (return (i32.const 0))))");
    try self.line("    (local.set $need");
    try self.line("      (i32.and (i32.add (local.get $size) (i32.const 7)) (i32.const -8)))");
    try self.line("    (local.set $current (global.get $__free_head))");
    try self.line("    (block $fresh");
    try self.line("      (loop $scan");
    try self.line("        (br_if $fresh (i32.eqz (local.get $current)))");
    try self.line("        (local.set $capacity (i32.load (local.get $current)))");
    try self.line("        (local.set $next");
    try self.line("          (i32.load (i32.add (local.get $current) (i32.const 4))))");
    try self.line("        (if (i32.ge_u (local.get $capacity) (local.get $need))");
    try self.line("          (then");
    try self.line("            (local.set $remaining");
    try self.line("              (i32.sub (local.get $capacity) (local.get $need)))");
    try self.line("            (if (i32.ge_u (local.get $remaining) (i32.const 16))");
    try self.line("              (then");
    try self.line("                (local.set $split");
    try self.line("                  (i32.add (local.get $current)");
    try self.line("                    (i32.add (i32.const 8) (local.get $need))))");
    try self.line("                (i32.store (local.get $split)");
    try self.line("                  (i32.sub (local.get $remaining) (i32.const 8)))");
    try self.line("                (i32.store (i32.add (local.get $split) (i32.const 4))");
    try self.line("                  (local.get $next))");
    try self.line("                (if (local.get $previous)");
    try self.line("                  (then (i32.store");
    try self.line("                    (i32.add (local.get $previous) (i32.const 4))");
    try self.line("                    (local.get $split)))");
    try self.line("                  (else (global.set $__free_head (local.get $split))))");
    try self.line("                (i32.store (local.get $current) (local.get $need)))");
    try self.line("              (else");
    try self.line("                (if (local.get $previous)");
    try self.line("                  (then (i32.store");
    try self.line("                    (i32.add (local.get $previous) (i32.const 4))");
    try self.line("                    (local.get $next)))");
    try self.line("                  (else (global.set $__free_head (local.get $next))))))");
    try self.line("            (return (i32.add (local.get $current) (i32.const 8)))))");
    try self.line("        (local.set $previous (local.get $current))");
    try self.line("        (local.set $current (local.get $next))");
    try self.line("        (br $scan)))");
    try self.line("    (local.set $base (global.get $__heap_end))");
    try self.line("    (local.set $end");
    try self.line("      (i32.add (local.get $base)");
    try self.line("        (i32.add (i32.const 8) (local.get $need))))");
    try self.line("    (if (i32.lt_u (local.get $end) (local.get $base))");
    try self.line("      (then (return (i32.const 0))))");
    try self.line("    (if (i32.gt_u (local.get $end) (i32.const -65536))");
    try self.line("      (then (return (i32.const 0))))");
    try self.line("    (local.set $required");
    try self.line("      (i32.shr_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 16)))");
    try self.line("    (local.set $pages (memory.size))");
    try self.line("    (if (i32.gt_u (local.get $required) (local.get $pages))");
    try self.line("      (then");
    try self.line("        (if (i32.eq (memory.grow");
    try self.line("              (i32.sub (local.get $required) (local.get $pages)))");
    try self.line("            (i32.const -1))");
    try self.line("          (then (return (i32.const 0))))))");
    try self.line("    (i32.store (local.get $base) (local.get $need))");
    try self.line("    (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.const 0))");
    try self.line("    (global.set $__heap_end (local.get $end))");
    try self.line("    (i32.add (local.get $base) (i32.const 8))");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_page_free_helper() -> !void {
    try self.line("  (func $__page_free (param $ptr i32) (param $size i32)");
    try self.line("    (local $block i32) (local $previous i32) (local $current i32)");
    try self.line("    (local $capacity i32)");
    try self.line("    (if (i32.eqz (local.get $ptr)) (then (return)))");
    try self.line("    (local.set $block (i32.sub (local.get $ptr) (i32.const 8)))");
    try self.line("    (local.set $current (global.get $__free_head))");
    try self.line("    (block $insert");
    try self.line("      (loop $scan");
    try self.line("        (br_if $insert (i32.eqz (local.get $current)))");
    try self.line("        (br_if $insert (i32.gt_u (local.get $current) (local.get $block)))");
    try self.line("        (local.set $previous (local.get $current))");
    try self.line("        (local.set $current");
    try self.line("          (i32.load (i32.add (local.get $current) (i32.const 4))))");
    try self.line("        (br $scan)))");
    try self.line("    (i32.store (i32.add (local.get $block) (i32.const 4)) (local.get $current))");
    try self.line("    (if (local.get $previous)");
    try self.line("      (then (i32.store (i32.add (local.get $previous) (i32.const 4))");
    try self.line("        (local.get $block)))");
    try self.line("      (else (global.set $__free_head (local.get $block))))");
    try self.line("    (if (local.get $current)");
    try self.line("      (then");
    try self.line("        (local.set $capacity (i32.load (local.get $block)))");
    try self.line("        (if (i32.eq");
    try self.line("              (i32.add (local.get $block)");
    try self.line("                (i32.add (i32.const 8) (local.get $capacity)))");
    try self.line("              (local.get $current))");
    try self.line("          (then");
    try self.line("            (i32.store (local.get $block)");
    try self.line("              (i32.add (local.get $capacity)");
    try self.line("                (i32.add (i32.const 8) (i32.load (local.get $current)))))");
    try self.line("            (i32.store (i32.add (local.get $block) (i32.const 4))");
    try self.line("              (i32.load (i32.add (local.get $current) (i32.const 4))))))))");
    try self.line("    (if (local.get $previous)");
    try self.line("      (then");
    try self.line("        (local.set $capacity (i32.load (local.get $previous)))");
    try self.line("        (if (i32.eq");
    try self.line("              (i32.add (local.get $previous)");
    try self.line("                (i32.add (i32.const 8) (local.get $capacity)))");
    try self.line("              (local.get $block))");
    try self.line("          (then");
    try self.line("            (i32.store (local.get $previous)");
    try self.line("              (i32.add (local.get $capacity)");
    try self.line("                (i32.add (i32.const 8) (i32.load (local.get $block)))))");
    try self.line("            (i32.store (i32.add (local.get $previous) (i32.const 4))");
    try self.line("              (i32.load (i32.add (local.get $block) (i32.const 4))))))))");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_page_realloc_helper() -> !void {
    try self.line("  (func $__page_realloc");
    try self.line("      (param $ptr i32) (param $old_size i32) (param $new_size i32) (result i32)");
    try self.line("    (local $grown i32) (local $copy i32)");
    try self.line("    (if (i32.eqz (local.get $ptr))");
    try self.line("      (then (return (call $__page_alloc (local.get $new_size)))))");
    try self.line("    (if (i32.le_u (local.get $new_size)");
    try self.line("          (i32.load (i32.sub (local.get $ptr) (i32.const 8))))");
    try self.line("      (then (return (local.get $ptr))))");
    try self.line("    (local.set $grown (call $__page_alloc (local.get $new_size)))");
    try self.line("    (if (i32.eqz (local.get $grown)) (then (return (i32.const 0))))");
    try self.line("    (local.set $copy (local.get $old_size))");
    try self.line("    (if (i32.gt_u (local.get $copy) (local.get $new_size))");
    try self.line("      (then (local.set $copy (local.get $new_size))))");
    try self.line("    (memory.copy (local.get $grown) (local.get $ptr) (local.get $copy))");
    try self.line("    (call $__page_free (local.get $ptr) (local.get $old_size))");
    try self.line("    (local.get $grown)");
    try self.line("  )");
    return self.out.append_byte(self.allocator, cast<u8>(10));
}

fn (self: &var Emitter) write_allocator_dispatch_helpers(module: &ir::Module) -> !void {
    let user = self.uses_user_allocator_runtime(module);
    var alloc_signature = 0;
    var release_signature = 0;
    if user {
        alloc_signature = try self.intern_wasm_signature(
            " (param i32) (param i64) (result i32)",
            "i32,i64,->i32"
        );
        release_signature = try self.intern_wasm_signature(
            " (param i32) (param i32) (param i64)",
            "i32,i32,i64,->"
        );
    }
    try self.line("  (func $__allocator_alloc (param $allocator i32) (param $size i32) (result i32)");
    try self.line("    (if (local.get $allocator)");
    try self.line("      (then");
    try self.line("        (if (i64.eq (i64.load (local.get $allocator)) (i64.const 1))");
    try self.line("          (then (return (call $__fixed_alloc");
    try self.line("            (local.get $allocator) (local.get $size)))))");
    if user {
        try self.line("        (if (i64.eq (i64.load (local.get $allocator)) (i64.const 2))");
        try self.line1(
            "          (then (return (call_indirect (type $sig%d)",
            Arg::Int(alloc_signature)
        );
        try self.line("            (i32.wrap_i64 (i64.load (i32.add (local.get $allocator) (i32.const 8))))");
        try self.line("            (i64.extend_i32_u (local.get $size))");
        try self.line("            (i32.wrap_i64 (i64.load (i32.add (local.get $allocator) (i32.const 16))))))))");
    }
    try self.line("        (return (i32.const 0))))");
    try self.line("    (call $__page_alloc (local.get $size))");
    try self.line("  )");
    try self.out.append_byte(self.allocator, cast<u8>(10));
    try self.line("  (func $__allocator_realloc");
    try self.line("      (param $allocator i32) (param $ptr i32)");
    try self.line("      (param $old_size i32) (param $new_size i32) (result i32)");
    try self.line("    (local $grown i32) (local $copy i32)");
    try self.line("    (if (local.get $allocator)");
    try self.line("      (then");
    if user {
