import compiler::internal::ir;
import std::mem;
import std::string;

// Mechanical port of internal/wasm/types.go: the WebAssembly spelling of Kizu
// IR types and operators, the WAT local name an SSA name becomes, and the
// escaping of data segment bytes. Go passes every spelling as a string; here a
// type or operator the module names arrives as its NameTable and the Name, the
// way internal/llvm reads one, and every fixed spelling is returned as a
// literal. A generated name is appended into the caller's String, so no view
// leaves the call.

/// Maps Kizu IR types to WebAssembly value types, the Go `wasmType`.
fn wasm_type(module: &ir::Module, typ: ir::Name) -> []u8 {
    if is_integer_type(&module.names, typ) or is_named_i64_type(module, typ) {
        return "i64";
    }
    if module.names.is(typ, "f32") {
        return "f32";
    }
    if module.names.is(typ, "f64") {
        return "f64";
    }
    return "i32";
}

/// Reports whether typ is `f32` or `f64`, each held in the wasm value type of
/// the same name; the Go `isFloatType`.
fn is_float_type(names: &ir::NameTable, typ: ir::Name) -> bool {
    return names.is(typ, "f32") or names.is(typ, "f64");
}

/// Maps a Kizu arithmetic operator on a float type to a WebAssembly
/// operation, the Go `wasmFloatBinaryOp`.
fn wasm_float_binary_op(names: &ir::NameTable, op: ir::Name, typ: ir::Name) -> []u8 {
    if names.is(typ, "f32") {
        if names.is(op, "-") { return "f32.sub"; }
        if names.is(op, "*") { return "f32.mul"; }
        if names.is(op, "/") { return "f32.div"; }
        return "f32.add";
    }
    if names.is(op, "-") { return "f64.sub"; }
    if names.is(op, "*") { return "f64.mul"; }
    if names.is(op, "/") { return "f64.div"; }
    return "f64.add";
}

/// Maps a Kizu comparison on a float type to a WebAssembly operation, the Go
/// `wasmFloatCompareOp`. Every one is ordered except `ne`, which is true for
/// NaN, as IEEE 754 says.
fn wasm_float_compare_op(names: &ir::NameTable, op: ir::Name, typ: ir::Name) -> []u8 {
    if names.is(typ, "f32") {
        if names.is(op, "!=") { return "f32.ne"; }
        if names.is(op, "<") { return "f32.lt"; }
        if names.is(op, "<=") { return "f32.le"; }
        if names.is(op, ">") { return "f32.gt"; }
        if names.is(op, ">=") { return "f32.ge"; }
        return "f32.eq";
    }
    if names.is(op, "!=") { return "f64.ne"; }
    if names.is(op, "<") { return "f64.lt"; }
    if names.is(op, "<=") { return "f64.le"; }
    if names.is(op, ">") { return "f64.gt"; }
    if names.is(op, ">=") { return "f64.ge"; }
    return "f64.eq";
}

/// Reports whether a Kizu type is a scalar integer, the Go `isIntegerType`.
/// Every integer width is held in one wasm i64, so the width only matters to
/// the frontend.
fn is_integer_type(names: &ir::NameTable, typ: ir::Name) -> bool {
    if names.is(typ, "i8") or names.is(typ, "i16") or names.is(typ, "i32") or
        names.is(typ, "i64") {
        return true;
    }
    if names.is(typ, "u8") or names.is(typ, "u16") or names.is(typ, "u32") or
        names.is(typ, "u64") {
        return true;
    }
    return names.is(typ, "usize") or names.is(typ, "isize");
}

/// Maps a Kizu binary operator on one type to a WebAssembly integer
/// operation, the Go `wasmBinaryOp`. Division and remainder read the sign
/// of the type.
fn wasm_binary_op(names: &ir::NameTable, op: ir::Name, typ: ir::Name) -> []u8 {
    if names.is(op, "-") {
        return "i64.sub";
    }
    if names.is(op, "*") {
        return "i64.mul";
    }
    if names.is(op, "/") {
        if is_unsigned_integer_type(names, typ) {
            return "i64.div_u";
        }
        return "i64.div_s";
    }
    if names.is(op, "%") {
        if is_unsigned_integer_type(names, typ) {
            return "i64.rem_u";
        }
        return "i64.rem_s";
    }
    if names.is(op, "&") {
        return "i64.and";
    }
    if names.is(op, "|") {
        return "i64.or";
    }
    if names.is(op, "^") {
        return "i64.xor";
    }
    return "i64.add";
}

/// Reports whether typ is one of the unsigned widths, the Go
/// `isUnsignedIntegerType`.
fn is_unsigned_integer_type(names: &ir::NameTable, typ: ir::Name) -> bool {
    let retained = ir::name_text(names, typ);
    let bytes = retained.as_bytes();
    return mem::starts_with(bytes, "u");
}

/// Opens the wrapper that narrows an arithmetic result to the width of typ,
/// the Go `narrowResult`: every integer lives in an i64 local, so an
/// unsigned type keeps its low bits, a signed one is sign-extended from its
/// top bit, and a 64-bit type gets no wrapper. This is what makes `+ - * <<`
/// wrap as SPEC §6.9.2 says. `narrow_suffix` closes it.
fn narrow_prefix(names: &ir::NameTable, typ: ir::Name) -> []u8 {
    if names.is(typ, "u8") or names.is(typ, "u16") or names.is(typ, "u32") {
        return "(i64.and ";
    }
    if names.is(typ, "i8") {
        return "(i64.extend8_s ";
    }
    if names.is(typ, "i16") {
        return "(i64.extend16_s ";
    }
    if names.is(typ, "i32") {
        return "(i64.extend32_s ";
    }
    return "";
}

fn narrow_suffix(names: &ir::NameTable, typ: ir::Name) -> []u8 {
    if names.is(typ, "u8") {
        return " (i64.const 255))";
    }
    if names.is(typ, "u16") {
        return " (i64.const 65535))";
    }
    if names.is(typ, "u32") {
        return " (i64.const 4294967295))";
    }
    if names.is(typ, "i8") or names.is(typ, "i16") or names.is(typ, "i32") {
        return ")";
    }
    return "";
}

/// Reports whether op can leave the width of its type, so that its result
/// needs narrowing, the Go `wrapsResult`. Comparisons, `& | ^`, `/ %`, and
/// `>>` cannot.
fn wraps_result(names: &ir::NameTable, op: ir::Name) -> bool {
    return names.is(op, "+") or names.is(op, "-") or names.is(op, "*") or
        names.is(op, "<<");
}

/// Reports the width a Kizu integer type shifts within, the Go
/// `integerBitWidth`. The value itself is held in an i64 local; the width
/// only bounds the amount.
fn integer_bit_width(names: &ir::NameTable, typ: ir::Name) -> ?i64 {
    if names.is(typ, "i8") or names.is(typ, "u8") {
        return 8;
    }
    if names.is(typ, "i16") or names.is(typ, "u16") {
        return 16;
    }
    if names.is(typ, "i32") or names.is(typ, "u32") {
        return 32;
    }
    if names.is(typ, "i64") or names.is(typ, "u64") or
        names.is(typ, "usize") or names.is(typ, "isize") {
        return 64;
    }
    return null;
}

/// Maps a Kizu comparison to a WebAssembly integer operation, the Go
/// `wasmCompareOp`. An unsigned operand type orders by the unsigned reading
/// of its i64 local, the way its division does.
fn wasm_compare_op(names: &ir::NameTable, op: ir::Name, typ: ir::Name) -> []u8 {
    if names.is(op, "!=") {
        return "i64.ne";
    }
    let unsigned = is_unsigned_integer_type(names, typ);
    if names.is(op, "<") {
        if unsigned {
            return "i64.lt_u";
        }
        return "i64.lt_s";
    }
    if names.is(op, "<=") {
        if unsigned {
            return "i64.le_u";
        }
        return "i64.le_s";
    }
    if names.is(op, ">") {
        if unsigned {
            return "i64.gt_u";
        }
        return "i64.gt_s";
    }
    if names.is(op, ">=") {
        if unsigned {
            return "i64.ge_u";
        }
        return "i64.ge_s";
    }
    return "i64.eq";
}

/// Converts an IR value name to a stable WebAssembly local name, the Go
/// `symbolName`: the leading `%` goes, `.`, `-`, `<` and `>` become `_`, a
/// leading digit takes a `v`, and the result is written after `$`.
fn append_symbol_name(allocator: Allocator, out: &var string::String, name: []u8) -> !void {
    try out.append_byte(allocator, cast<u8>(36));
    var index = 0;
    if mem::starts_with(name, "%") {
        index = 1;
    }
    if index < mem::len(name) and name[index] >= cast<u8>(48) and
        name[index] <= cast<u8>(57) {
        try out.append_byte(allocator, cast<u8>(118));
    }
    while index < mem::len(name) {
        let byte = name[index];
        index = index + 1;
        if byte == cast<u8>(46) or byte == cast<u8>(45) or byte == cast<u8>(60) or
            byte == cast<u8>(62) {
            try out.append_byte(allocator, cast<u8>(95));
            continue;
        }
        try out.append_byte(allocator, byte);
    }
    return;
}

/// Escapes data bytes for WAT data segments, the Go `stringBytes`.
fn append_string_bytes(allocator: Allocator, out: &var string::String, value: []u8) -> !void {
    var index = 0;
    while index < mem::len(value) {
        let byte = value[index];
        index = index + 1;
        if byte == cast<u8>(92) or byte == cast<u8>(34) {
            try out.append_byte(allocator, cast<u8>(92));
            try append_hex_byte(allocator, out, byte);
            continue;
        }
        if byte == cast<u8>(10) {
            try out.append_bytes(allocator, "\0a");
            continue;
        }
        if byte == cast<u8>(9) {
            try out.append_bytes(allocator, "\09");
            continue;
        }
        if byte < cast<u8>(32) or byte >= cast<u8>(127) {
            try out.append_byte(allocator, cast<u8>(92));
            try append_hex_byte(allocator, out, byte);
            continue;
        }
        try out.append_byte(allocator, byte);
    }
    return;
}

/// Appends a two-character lowercase hexadecimal byte, the Go `hexByte`.
fn append_hex_byte(allocator: Allocator, out: &var string::String, value: u8) -> !void {
    let digits = "0123456789abcdef";
    let index = cast<i64>(value);
    try out.append_byte(allocator, digits[index / 16]);
    return out.append_byte(allocator, digits[index % 16]);
}
