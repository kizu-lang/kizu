        \\        (return (i32.const 1))))
        \\    (if (i64.le_u (local.get $key_length) (i64.const 8))
        \\      (then (local.set $stored_key (call $__map_short_key (local.get $key) (local.get $key_length))))
        \\      (else
        \\        (local.set $entry (call $__allocator_alloc (local.get $allocator)
        \\          (i32.wrap_i64 (local.get $key_length))))
