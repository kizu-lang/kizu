        \\      (i64.load (i32.add (local.get $map) (i32.const 8))) (i64.const 1)))
        \\    (memory.copy (local.get $entry) (i32.add (local.get $entry) (local.get $entry_size))
        \\      (i32.mul (local.get $entry_size) (i32.wrap_i64
        \\        (i64.sub (local.get $length) (local.get $found)))))
