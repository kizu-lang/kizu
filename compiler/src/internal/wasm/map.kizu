fn (self: &var Emitter) map_expr4(
    format: []u8,
    a: Arg,
    b: Arg,
    c: Arg,
    d: Arg
) -> !ir::Name {
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    try format_args(
        self.allocator,
        &var out,
        &self.names,
        format,
        move a,
        move b,
        move c,
        move d
    );
    return self.names.intern_owned(move out);
}

/// Measures K and V through either a direct or borrowed Map<K, V> and copies
/// their canonical spellings into the caller-owned buffers.
fn (self: &var Emitter) map_element_layouts(
    module: &ir::Module,
    node: &ir::InstrNode,
    key_out: &var string::String,
    value_out: &var string::String,
    key_layout_out: &var WasmLayout,
    value_layout_out: &var WasmLayout
) -> !?diagnostic::Diagnostic {
    var container = node.result.type_name;
    if node.op != ir::Op::MapNew {
        let first = node.args.get(0) orelse return try self.fail_op(
            module,
            node,
            "wasm error: `%s` was handed no Map<K, V>"
        );
        container = first.type_name;
    }
    let retained = ir::name_text(&module.names, container);
    let spelling = retained.as_bytes();
    var start = 0;
    if mem::starts_with(spelling, "&var ") {
        start = 5;
    } else {
        if mem::starts_with(spelling, "&") {
            start = 1;
        }
    }
    let direct = spelling[start..mem::len(spelling)];
    if !is_map_wasm_type(direct) {
        return try self.fail_op(
            module,
            node,
            "wasm error: `%s` was handed no Map<K, V>"
        );
    }
    let args_text = direct[14..mem::len(direct) - 1];
    let parts = try typ::split_args_optional(self.allocator, args_text) orelse
        return try self.fail_op(
        module,
        node,
        "wasm error: `%s` was handed no Map<K, V>"
    );
    defer parts.deinit(self.allocator);
    if parts.len() != 2 {
        return try self.fail_op(
            module,
            node,
            "wasm error: `%s` was handed no Map<K, V>"
        );
    }
    if parts.at(0) |key| {
        let key_bytes = key.as_bytes();
        if !typ::is_map_key(key_bytes) {
            return try self.fail_op(
                module,
                node,
                "wasm error: `%s` was handed no Map<K, V>"
            );
        }
        try key_out.append_bytes(self.allocator, key_bytes);
        let key_outcome = try self.type_layout_bytes(module, key_bytes);
        match key_outcome {
            Error(failed) => return move failed,
            Layout(layout) => {
                key_layout_out.* = layout;
            },
        }
    } else {
        return try self.fail_op(
            module,
            node,
            "wasm error: `%s` was handed no Map<K, V>"
        );
    }
    if parts.at(1) |value| {
        let value_bytes = value.as_bytes();
        try value_out.append_bytes(self.allocator, value_bytes);
        let value_outcome = try self.type_layout_bytes(module, value_bytes);
        match value_outcome {
            Error(failed) => return move failed,
            Layout(layout) => {
                value_layout_out.* = layout;
            },
        }
    } else {
        return try self.fail_op(
            module,
            node,
            "wasm error: `%s` was handed no Map<K, V>"
        );
    }
    if key_layout_out.size <= 0 or value_layout_out.size <= 0 {
        return try self.fail0("wasm error: Map key and value need nonzero storage");
    }
    return null;
}

fn (self: &var Emitter) write_map_instr(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    match node.op {
        MapNew => return self.write_map_new(module, node),
        MapInsert => return self.write_map_insert(module, node),
        MapGet => return self.write_map_get(module, node),
        MapRemove => return self.write_map_remove(module, node),
        MapAt => return self.write_map_at(module, node),
        MapAtMut => return self.write_map_at(module, node),
        MapTakeValueAt => return self.write_map_take_value_at(module, node),
        MapKeyAt => return self.write_map_key_at(module, node),
        MapContains => return self.write_map_contains(module, node),
        MapLen => return self.write_map_len(module, node),
        MapDeinit => return self.write_map_deinit(module, node),
        _ => return try self.fail_op(
            module,
            node,
            "wasm error: unsupported map instruction `%s`"
        ),
    }
}

fn (self: &var Emitter) write_map_new(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    if node.args.len() != 1 or
        !module.names.is(node.args.get_or_panic(0).type_name, "Allocator") or
        !is_map_wasm_type(result_type) {
        return try self.fail0("wasm error: map.new expects allocator -> Map<K, V>");
    }
    var key = string::new(self.allocator);
    defer key.deinit(self.allocator);
    var value = string::new(self.allocator);
    defer value.deinit(self.allocator);
    var key_layout = WasmLayout { size: 0, align: 1 };
    var value_layout = WasmLayout { size: 0, align: 1 };
    if try self.map_element_layouts(
        module,
        node,
        &var key,
        &var value,
        &var key_layout,
        &var value_layout
    ) |failed| {
        return move failed;
    }
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for Map result");
    try self.write_memory_zero(slot, map_header_size());
    try self.set_value(module, node.result, slot);
    return null;
}

/// Normalizes a byte slice or integer key to the pointer/length ABI consumed
/// by the shared hash runtime.
fn (self: &var Emitter) write_map_key_parts(
    module: &ir::Module,
    key: ir::Value,
    temp: ir::Name,
    key_type: []u8,
    key_layout: WasmLayout,
    pointer_out: &var ir::Name,
    length_out: &var ir::Name
) -> !?diagnostic::Diagnostic {
    if !module.names.is(key.type_name, key_type) {
        let expected = try self.names.intern(key_type);
        let got = try self.own(module, key.type_name);
        return try self.fail2(
            "wasm error: Map expects %s key, got %s",
            Arg::Str(expected),
            Arg::Str(got)
        );
    }
    let info = try self.value_of(module, key);
    if mem::equal_bytes(key_type, "[]u8") {
        pointer_out.* = try self.map_expr1("(i32.load %s)", Arg::Str(info.expr));
        let length_address = try self.address_at(info.expr, 4);
        length_out.* = try self.map_expr1(
            "(i64.extend_i32_u (i32.load %s))",
            Arg::Str(length_address)
        );
        return null;
    }
    if try self.write_store_value(module, temp, 0, key.type_name, info) |failed| {
        return move failed;
    }
    pointer_out.* = temp;
    length_out.* = try self.map_expr1(
        "(i64.const %d)",
        Arg::Int(key_layout.size)
    );
    return null;
}

/// Sets local to the address of the value stored for key, or 0, the Go
/// `writeMapLookup`. A key of eight bytes is handed to the runtime as the
/// word it is.
fn (self: &var Emitter) write_map_lookup(
    module: &ir::Module,
    node: &ir::InstrNode,
    local: ir::Name,
    key: ir::Value,
    key_type: []u8,
    key_layout: WasmLayout,
    value_layout: WasmLayout
) -> !?diagnostic::Diagnostic {
    let map_value = try self.arg_expr(module, node, 0);
    if !mem::equal_bytes(key_type, "[]u8") and key_layout.size == 8 and
        module.names.is(key.type_name, key_type) {
        let word = try self.value_of(module, key);
        try self.write_map_word_lookup(local, map_value, word.expr, value_layout.size);
        return null;
    }
    let temp = try self.local_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for Map temporary");
    var key_pointer = ir::empty_name();
    var key_length = ir::empty_name();
    if try self.write_map_key_parts(
        module,
        key,
        temp,
        key_type,
        key_layout,
        &var key_pointer,
        &var key_length
    ) |failed| {
        return move failed;
    }
    var call = try string::from_bytes(self.allocator, "(call $__map_get ");
    errdefer call.deinit(self.allocator);
    try self.names.append_to(&var call, map_value);
    try call.append_byte(self.allocator, cast<u8>(32));
    try self.names.append_to(&var call, key_pointer);
    try call.append_byte(self.allocator, cast<u8>(32));
    try self.names.append_to(&var call, key_length);
    try call.append_bytes(self.allocator, " (i32.const ");
    try fmt::append_i64(self.allocator, &var call, value_layout.size);
    try call.append_bytes(self.allocator, "))");
    try self.line2("            (local.set %s %s)", Arg::Str(local), Arg::Owned(move call));
    return null;
}

// A lookup of an eight-byte key is written where it is made, since an engine
// that compiles wasm calls a function as a function and a map read in a loop
// would pay for the call on every iteration. It reads the index eight control
// bytes at a time: an empty slot has its high bit set and a tag never does, so
// one load answers for eight slots whether any holds the tag and where the
// first empty one is. A group that would run past the last control byte is
// left to `$__map_get_word`, which steps one slot at a time.

/// Reports whether an instruction looks a Map value up by a key of eight
/// bytes that is not a byte view, which the lookup reads as the word it is,
/// the Go `isMapWordLookup`.
fn (self: &var Emitter) is_map_word_lookup(module: &ir::Module, node: &ir::InstrNode) -> !bool {
    let looks_up = match node.op {
        MapGet => true,
        MapAt => true,
        MapAtMut => true,
        MapContains => true,
        _ => false,
    };
    if !looks_up or node.args.len() != 2 {
        return false;
    }
    let container = node.args.get_or_panic(0);
    let retained = ir::name_text(&module.names, container.type_name);
    let spelling = retained.as_bytes();
    var start = 0;
    if mem::starts_with(spelling, "&var ") {
        start = 5;
    } else {
        if mem::starts_with(spelling, "&") {
            start = 1;
        }
    }
    let direct = spelling[start..mem::len(spelling)];
    if !is_map_wasm_type(direct) {
        return false;
    }
    let parts = try typ::split_args_optional(self.allocator, direct[14..mem::len(direct) - 1]) orelse
        return false;
    defer parts.deinit(self.allocator);
    if parts.len() != 2 {
        return false;
    }
    if parts.at(0) |key| {
        let key_bytes = key.as_bytes();
        if mem::equal_bytes(key_bytes, "[]u8") or !typ::is_map_key(key_bytes) or
            !module.names.is(node.args.get_or_panic(1).type_name, key_bytes) {
            return false;
        }
        let layout = wasm_primitive_layout(key_bytes) orelse return false;
        return layout.size == 8;
    }
    return false;
}

/// Declares the locals the word-key lookups of a function work in, when it
/// makes any, the Go `writeMapWordLocals`.
fn (self: &var Emitter) write_map_word_locals(module: &ir::Module, function: &ir::FunctionNode) -> !void {
    var block_index = 0;
    while function.blocks.get(block_index) |block| {
        block_index = block_index + 1;
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            if try self.is_map_word_lookup(module, module.instrs.at(instr.node)) {
                let text =
                    \\    (local $__kizu_map i32) (local $__kizu_map_key i64) (local $__kizu_map_hash i64)
                    \\    (local $__kizu_map_capacity i32) (local $__kizu_map_index i32) (local $__kizu_map_slot i32)
                    \\    (local $__kizu_map_tags i64) (local $__kizu_map_empty i64) (local $__kizu_map_match i64)
                    \\    (local $__kizu_map_entry i32) (local $__kizu_map_found i32)
                    \\
                ;
                return self.out.append_bytes(self.allocator, text);
            }
        }
    }
    return;
}

/// Sets local to the address of the value stored for the eight-byte key, or
/// 0, hashing it the way `$__map_get_word` does, the Go `writeMapWordLookup`.
fn (self: &var Emitter) write_map_word_lookup(
    local: ir::Name,
    map_expr: ir::Name,
    key: ir::Name,
    value_size: i64
) -> !void {
    try self.line1("            (local.set $__kizu_map %s)", Arg::Str(map_expr));
    try self.line1("            (local.set $__kizu_map_key %s)", Arg::Str(key));
    try self.write_map_word_hash();
    try self.line("                    (local.set $__kizu_map_found (call $__map_get_word");
    try self.line1(
        "                      (local.get $__kizu_map) (local.get $__kizu_map_key) (i32.const %d)))",
        Arg::Int(value_size)
    );
    try self.write_map_word_group();
    try self.line1(
        "                        (i32.mul (i32.const %d) (i32.load (i32.add",
        Arg::Int(map_entry_size(value_size))
    );
    try self.write_map_word_candidate();
    return self.line1("            (local.set %s (local.get $__kizu_map_found))", Arg::Str(local));
}

/// Hashes the key and starts the probe at the group its hash names.
fn (self: &var Emitter) write_map_word_hash() -> !void {
    let text =
        \\            (local.set $__kizu_map_found (i32.const 0))
        \\            (block $__kizu_map_done
        \\              (local.set $__kizu_map_capacity (i32.wrap_i64
        \\                (i64.load (i32.add (local.get $__kizu_map) (i32.const 32)))))
        \\              (br_if $__kizu_map_done (i32.eqz (local.get $__kizu_map_capacity)))
        \\              (local.set $__kizu_map_hash (i64.mul
        \\                (i64.xor (i64.const 256) (local.get $__kizu_map_key))
        \\                (i64.const 0x517cc1b727220a95)))
        \\              (local.set $__kizu_map_hash (i64.xor (local.get $__kizu_map_hash)
        \\                (i64.shr_u (local.get $__kizu_map_hash) (i64.const 32))))
        \\              (local.set $__kizu_map_hash
        \\                (i64.mul (local.get $__kizu_map_hash) (i64.const 0xd6e8feb86659fd93)))
        \\              (local.set $__kizu_map_hash (i64.xor (local.get $__kizu_map_hash)
        \\                (i64.shr_u (local.get $__kizu_map_hash) (i64.const 32))))
        \\              (local.set $__kizu_map_index
        \\                (i32.load (i32.add (local.get $__kizu_map) (i32.const 24))))
        \\              (local.set $__kizu_map_slot
        \\                (i32.and (i32.wrap_i64 (local.get $__kizu_map_hash))
        \\                  (i32.sub (local.get $__kizu_map_capacity) (i32.const 1))))
        \\              (local.set $__kizu_map_tags
        \\                (i64.mul (i64.shr_u (local.get $__kizu_map_hash) (i64.const 57))
        \\                  (i64.const 0x0101010101010101)))
        \\              (loop $__kizu_map_probe
        \\                (if (i32.gt_u (i32.add (local.get $__kizu_map_slot) (i32.const 8))
        \\                      (local.get $__kizu_map_capacity))
        \\                  (then
        \\
    ;
    try self.out.append_bytes(self.allocator, text);
    return;
}

/// Loads one group of control bytes and marks the bytes before its first
/// empty slot that may hold the tag. A byte equal to the tag is zero after the
/// xor; the borrow test marks every zero byte and may also mark a byte above
/// one, which the key comparison then turns away.
fn (self: &var Emitter) write_map_word_group() -> !void {
    let text =
        \\                    (br $__kizu_map_done)))
        \\                (local.set $__kizu_map_match (i64.load
        \\                  (i32.add (local.get $__kizu_map_index) (local.get $__kizu_map_slot))))
        \\                (local.set $__kizu_map_empty
        \\                  (i64.and (local.get $__kizu_map_match) (i64.const 0x8080808080808080)))
        \\                (local.set $__kizu_map_match
        \\                  (i64.xor (local.get $__kizu_map_match) (local.get $__kizu_map_tags)))
        \\                (local.set $__kizu_map_match (i64.and
        \\                  (i64.and
        \\                    (i64.sub (local.get $__kizu_map_match) (i64.const 0x0101010101010101))
        \\                    (i64.xor (local.get $__kizu_map_match) (i64.const -1)))
        \\                  (i64.and (i64.const 0x8080808080808080)
        \\                    (i64.sub
        \\                      (i64.and (local.get $__kizu_map_empty)
        \\                        (i64.sub (i64.const 0) (local.get $__kizu_map_empty)))
        \\                      (i64.const 1)))))
        \\                (loop $__kizu_map_candidates
        \\                  (if (i64.ne (local.get $__kizu_map_match) (i64.const 0))
        \\                    (then
        \\                      (local.set $__kizu_map_entry (i32.add (i32.load (local.get $__kizu_map))
        \\
    ;
    try self.out.append_bytes(self.allocator, text);
    return;
}

/// Compares the entry one marked byte names, and moves to the next group once
/// no marked byte holds the key and no slot in this one is empty.
fn (self: &var Emitter) write_map_word_candidate() -> !void {
    let text =
        \\                        (i32.add (local.get $__kizu_map_index) (local.get $__kizu_map_capacity))
        \\                        (i32.shl
        \\                          (i32.add (local.get $__kizu_map_slot) (i32.wrap_i64 (i64.shr_u
        \\                            (i64.ctz (local.get $__kizu_map_match)) (i64.const 3))))
        \\                          (i32.const 2)))))))
        \\                      (if (i32.and
        \\                            (i64.eq (i64.load (local.get $__kizu_map_entry))
        \\                              (local.get $__kizu_map_hash))
        \\                            (i32.and
        \\                              (i64.eq (i64.load (i32.add (local.get $__kizu_map_entry)
        \\                                (i32.const 8))) (i64.const 8))
        \\                              (i64.eq (i64.load (i32.add (local.get $__kizu_map_entry)
        \\                                (i32.const 16))) (local.get $__kizu_map_key))))
        \\                        (then
        \\                          (local.set $__kizu_map_found
        \\                            (i32.add (local.get $__kizu_map_entry) (i32.const 24)))
        \\                          (br $__kizu_map_done)))
        \\                      (local.set $__kizu_map_match (i64.and (local.get $__kizu_map_match)
        \\                        (i64.sub (local.get $__kizu_map_match) (i64.const 1))))
        \\                      (br $__kizu_map_candidates))))
        \\                (br_if $__kizu_map_done (i64.ne (local.get $__kizu_map_empty) (i64.const 0)))
        \\                (local.set $__kizu_map_slot
        \\                  (i32.and (i32.add (local.get $__kizu_map_slot) (i32.const 8))
        \\                    (i32.sub (local.get $__kizu_map_capacity) (i32.const 1))))
        \\                (br $__kizu_map_probe)))
        \\
    ;
    try self.out.append_bytes(self.allocator, text);
    return;
}

fn (self: &var Emitter) write_map_insert(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 4 or
        !module.names.is(node.args.get_or_panic(1).type_name, "Allocator") or
        !module.names.is(node.result.type_name, "std::mem::Error!void") {
        return try self.fail0(
            "wasm error: map.insert expects Map, Allocator, K, V -> std::mem::Error!void"
        );
    }
    var key = string::new(self.allocator);
    defer key.deinit(self.allocator);
    var value = string::new(self.allocator);
    defer value.deinit(self.allocator);
    var key_layout = WasmLayout { size: 0, align: 1 };
    var value_layout = WasmLayout { size: 0, align: 1 };
    if try self.map_element_layouts(
        module,
        node,
        &var key,
        &var value,
        &var key_layout,
        &var value_layout
    ) |failed| {
        return move failed;
    }
    let key_bytes = key.as_bytes();
    let value_bytes = value.as_bytes();
    if !module.names.is(node.args.get_or_panic(3).type_name, value_bytes) {
        return try self.fail0(
            "wasm error: map.insert expects Map, Allocator, K, V -> std::mem::Error!void"
        );
    }
    let temp = try self.local_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for Map temporary");
    let value_arg = node.args.get_or_panic(3);
    let value_info = try self.value_of(module, value_arg);
    var value_pointer = value_info.expr;
    if !try self.is_memory_type(module, value_arg.type_name) {
        if try self.write_store_value(
            module,
            temp,
            map_temp_value_offset(),
            value_arg.type_name,
            value_info
        ) |failed| {
            return move failed;
        }
        value_pointer = try self.address_at(temp, map_temp_value_offset());
    }
    let allocator = try self.arg_expr(module, node, 1);
    let map_value = try self.arg_expr(module, node, 0);
    let word_key = !mem::equal_bytes(key_bytes, "[]u8") and key_layout.size == 8;
    var key_pointer = ir::empty_name();
    var key_length = ir::empty_name();
    if !word_key {
        if try self.write_map_key_parts(
            module,
            node.args.get_or_panic(2),
            temp,
            key_bytes,
            key_layout,
            &var key_pointer,
            &var key_length
        ) |failed| {
            return move failed;
        }
    }
    var call = string::new(self.allocator);
    errdefer call.deinit(self.allocator);
    if word_key {
        let word = try self.arg_expr(module, node, 2);
        try call.append_bytes(self.allocator, "(call $__map_insert_word ");
        try self.names.append_to(&var call, allocator);
        try call.append_byte(self.allocator, cast<u8>(32));
        try self.names.append_to(&var call, map_value);
        try call.append_byte(self.allocator, cast<u8>(32));
        try self.names.append_to(&var call, word);
    } else {
        try call.append_bytes(self.allocator, "(call $__map_insert ");
        try self.names.append_to(&var call, allocator);
        try call.append_byte(self.allocator, cast<u8>(32));
        try self.names.append_to(&var call, map_value);
        try call.append_byte(self.allocator, cast<u8>(32));
        try self.names.append_to(&var call, key_pointer);
        try call.append_byte(self.allocator, cast<u8>(32));
        try self.names.append_to(&var call, key_length);
    }
    try call.append_byte(self.allocator, cast<u8>(32));
    try self.names.append_to(&var call, value_pointer);
    try call.append_bytes(self.allocator, " (i32.const ");
    try fmt::append_i64(self.allocator, &var call, value_layout.size);
    try call.append_bytes(self.allocator, "))");
    let ok = try self.names.intern_owned(move call);
    let result = try self.write_array_error_result(
        module,
        node.result,
        ok,
        "std::mem::Error",
        "OutOfMemory"
    );
    match result {
        Error(failed) => return move failed,
        Name(_) => return null,
    }
}

/// Lowers a Map value lookup that copies into an optional, the Go
/// `writeMapGet`.
fn (self: &var Emitter) write_map_get(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("wasm error: map.get expects Map, K -> ?V");
    }
    var key = string::new(self.allocator);
    defer key.deinit(self.allocator);
    var value = string::new(self.allocator);
    defer value.deinit(self.allocator);
    var key_layout = WasmLayout { size: 0, align: 1 };
    var value_layout = WasmLayout { size: 0, align: 1 };
    if try self.map_element_layouts(
        module,
        node,
        &var key,
        &var value,
        &var key_layout,
        &var value_layout
    ) |failed| {
        return move failed;
    }
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    let key_bytes = key.as_bytes();
    let value_bytes = value.as_bytes();
    var result_matches = false;
    if typ::optional_elem(result_type) |want| {
        result_matches = mem::equal_bytes(want, value_bytes);
    }
    if !result_matches {
        return try self.fail0("wasm error: map.get expects Map, K -> ?V");
    }
    var payload_offset = 0;
    let offset_outcome = try self.tagged_payload_offset(module, value_bytes, false);
    match offset_outcome {
        Error(failed) => return move failed,
        Offset(found) => {
            payload_offset = found;
        },
    }
    let retained = ir::name_text(&module.names, node.result.name);
    let result_bytes = retained.as_bytes();
    let symbol = try self.symbol_name_of(result_bytes);
    if self.is_option_local(node.result.name) {
        let payload = try self.option_payload_local(result_bytes);
        if try self.write_map_lookup(
            module,
            node,
            symbol,
            node.args.get_or_panic(1),
            key_bytes,
            key_layout,
            value_layout
        ) |failed| {
            return move failed;
        }
        let found = try self.local_expr(result_bytes);
        var load = ir::empty_name();
        if wasm_load_op_bytes(module, value_bytes) |op| {
            let op_name = try self.names.intern(op);
            load = try self.map_expr2("(%s %s)", Arg::Str(op_name), Arg::Str(found));
        } else {
            let shown = try self.names.intern(value_bytes);
            return try self.fail(
                "wasm error: type `%s` cannot be loaded from linear memory",
                Arg::Str(shown)
            );
        }
        try self.line1("            (if (local.get %s)", Arg::Str(symbol));
        try self.line2("              (then (local.set %s %s)))", Arg::Str(payload), Arg::Str(load));
        let present = try self.map_expr1("(i32.ne (local.get %s) (i32.const 0))", Arg::Str(symbol));
        try self.write_option_locals(module, node.result, present, ir::empty_name());
        return null;
    }
    if try self.write_map_lookup(
        module,
        node,
        symbol,
        node.args.get_or_panic(1),
        key_bytes,
        key_layout,
        value_layout
    ) |failed| {
        return move failed;
    }
    let local = try self.local_expr(result_bytes);
    try self.line1("            (if (local.get %s)", Arg::Str(symbol));
    try self.line("              (then");
    if try self.write_tagged_result(module, node.result, 1) |failed| {
        return move failed;
    }
    let slot = try self.result_slot(module, node.result) orelse
        return try self.fail0("wasm error: no frame slot for map.get result");
    let destination = try self.address_at(slot, payload_offset);
    if try self.write_array_copy_value(
        module,
        destination,
        local,
        node.result.type_name,
        value_bytes
    ) |failed| {
        return move failed;
    }
    try self.line("              )");
    try self.line("              (else");
    if try self.write_tagged_result(module, node.result, 0) |failed| {
        return move failed;
    }
    try self.line("              ))");
    return null;
}

/// Lowers Map.remove(allocator, key), the Go `writeMapRemove`: the runtime
/// moves the value into the optional's payload before it releases the entry,
/// and the tag says whether the key was there.
fn (self: &var Emitter) write_map_remove(
    module: &ir::Module,
    node: &ir::InstrNode
