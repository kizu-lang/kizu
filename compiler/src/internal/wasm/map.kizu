        \\    (local.set $capacity (i32.wrap_i64 (i64.load (i32.add (local.get $map) (i32.const 32)))))
        \\    (local.set $mask (i64.sub (i64.extend_i32_u (local.get $capacity)) (i64.const 1)))
        \\    (block $placed_all
        \\      (loop $entries
        \\        (br_if $placed_all (i64.ge_u (local.get $number)
        \\          (i64.load (i32.add (local.get $map) (i32.const 8)))))
        \\        (local.set $hash (i64.load (i32.add (i32.load (local.get $map))
        \\          (i32.mul (local.get $entry_size) (i32.wrap_i64 (local.get $number))))))
        \\        (local.set $slot (i64.and (local.get $hash) (local.get $mask)))
        \\        (block $placed
        \\          (loop $probe
        \\            (br_if $placed (i32.eq (i32.load8_u (i32.add (local.get $index)
