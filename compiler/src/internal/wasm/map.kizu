import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::fmt;
import std::mem;
import std::string;

// Mechanical port of internal/wasm/map.go. A Map value is the inline wasm32
// header shared with native semantics: insertion-ordered entries plus an
// open-addressed index. Every key enters the runtime as bytes, and every value
// enters as an address measured from its wasm32 layout.

fn map_header_size() -> i64 {
    return 40;
}

fn map_len_offset() -> i64 {
    return 8;
}

fn map_entry_size() -> i64 {
    return 32;
}

fn map_entry_key_offset() -> i64 {
    return 0;
}

fn map_entry_key_len_offset() -> i64 {
    return 8;
}

fn map_entry_value_offset() -> i64 {
    return 16;
}

fn map_temp_size() -> i64 {
    return 16;
}

fn map_temp_value_offset() -> i64 {
    return 8;
}

fn is_map_wasm_type(name: []u8) -> bool {
    return mem::starts_with(name, "std::map::Map<") and ir::ends_with_bytes(name, ">");
}

fn is_wasm_map_op(op: ir::Op) -> bool {
    return match op {
        MapNew => true,
        MapAt => true,
        MapAtMut => true,
        MapContains => true,
        MapDeinit => true,
        MapGet => true,
        MapInsert => true,
        MapKeyAt => true,
        MapLen => true,
        MapTakeValueAt => true,
        _ => false,
    };
}

/// Reports whether an operation normalizes a key or value into addressed
/// frame bytes before entering the generic runtime.
fn is_wasm_map_temp_op(op: ir::Op) -> bool {
    return match op {
        MapInsert => true,
        MapGet => true,
        MapAt => true,
        MapAtMut => true,
        MapContains => true,
        _ => false,
    };
}

fn (self: &Emitter) uses_map_runtime(module: &ir::Module) -> bool {
    var function_index = 0;
    while module.functions.get(function_index) |function| {
        function_index = function_index + 1;
        let function_node = module.function_nodes.at(function.node);
        var block_index = 0;
        while function_node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let node = module.instrs.at(instr.node);
                if is_wasm_map_op(node.op) {
                    return true;
                }
            }
        }
    }
    return false;
}

/// Emits the generic insertion-ordered hash table runtime. This literal is the
/// same WAT written line-by-line by the Go seed; keeping it type-independent
/// makes all Map<K, V> instances share one implementation.
fn (self: &var Emitter) write_map_runtime() -> !void {
    let text =
        \\  (func $__map_read_tail (param $key i32) (param $length i64) (result i64)
        \\    (if (i64.ge_u (local.get $length) (i64.const 4))
        \\      (then (return
        \\        (i64.or
        \\          (i64.shl (i64.extend_i32_u (i32.load (local.get $key))) (i64.const 32))
        \\          (i64.extend_i32_u
        \\            (i32.load (i32.add (local.get $key)
        \\              (i32.wrap_i64 (i64.sub (local.get $length) (i64.const 4))))))))))
        \\    (if (i64.eqz (local.get $length))
        \\      (then (return (i64.const 0))))
        \\    (i64.or
        \\      (i64.shl (i64.extend_i32_u (i32.load8_u (local.get $key))) (i64.const 16))
        \\      (i64.or
        \\        (i64.shl
        \\          (i64.extend_i32_u (i32.load8_u (i32.add (local.get $key)
        \\            (i32.wrap_i64 (i64.shr_u (local.get $length) (i64.const 1))))))
        \\          (i64.const 8))
        \\        (i64.extend_i32_u (i32.load8_u (i32.add (local.get $key)
        \\          (i32.wrap_i64 (i64.sub (local.get $length) (i64.const 1))))))))
        \\  )
        \\
        \\  (func $__map_hash (param $key i32) (param $length i64) (result i64)
        \\    (local $hash i64) (local $offset i64)
        \\    (local.set $hash (local.get $length))
        \\    (block $tail
        \\      (loop $words
        \\        (br_if $tail (i64.gt_u
        \\          (i64.add (local.get $offset) (i64.const 8)) (local.get $length)))
        \\        (local.set $hash
        \\          (i64.mul
        \\            (i64.xor (i64.rotl (local.get $hash) (i64.const 5))
        \\              (i64.load (i32.add (local.get $key) (i32.wrap_i64 (local.get $offset)))))
        \\            (i64.const 0x517cc1b727220a95)))
        \\        (local.set $offset (i64.add (local.get $offset) (i64.const 8)))
        \\        (br $words)))
        \\    (if (i64.lt_u (local.get $offset) (local.get $length))
        \\      (then (local.set $hash
        \\        (i64.mul
        \\          (i64.xor (i64.rotl (local.get $hash) (i64.const 5))
        \\            (call $__map_read_tail
        \\              (i32.add (local.get $key) (i32.wrap_i64 (local.get $offset)))
        \\              (i64.sub (local.get $length) (local.get $offset))))
        \\          (i64.const 0x517cc1b727220a95)))))
        \\    (local.set $hash
        \\      (i64.xor (local.get $hash) (i64.shr_u (local.get $hash) (i64.const 32))))
        \\    (local.set $hash
        \\      (i64.mul (local.get $hash) (i64.const 0xd6e8feb86659fd93)))
        \\    (i64.xor (local.get $hash) (i64.shr_u (local.get $hash) (i64.const 32)))
        \\  )
        \\
        \\  (func $__map_keys_equal
        \\      (param $left i32) (param $right i32) (param $length i64) (result i32)
        \\    (local $offset i64)
        \\    (block $bytes
        \\      (loop $words
        \\        (br_if $bytes (i64.gt_u
        \\          (i64.add (local.get $offset) (i64.const 8)) (local.get $length)))
        \\        (if (i64.ne
        \\              (i64.load (i32.add (local.get $left) (i32.wrap_i64 (local.get $offset))))
        \\              (i64.load (i32.add (local.get $right) (i32.wrap_i64 (local.get $offset)))))
        \\          (then (return (i32.const 0))))
        \\        (local.set $offset (i64.add (local.get $offset) (i64.const 8)))
        \\        (br $words)))
        \\    (block $equal
        \\      (loop $tail
        \\        (br_if $equal (i64.ge_u (local.get $offset) (local.get $length)))
        \\        (if (i32.ne
        \\              (i32.load8_u (i32.add (local.get $left) (i32.wrap_i64 (local.get $offset))))
        \\              (i32.load8_u (i32.add (local.get $right) (i32.wrap_i64 (local.get $offset)))))
        \\          (then (return (i32.const 0))))
        \\        (local.set $offset (i64.add (local.get $offset) (i64.const 1)))
        \\        (br $tail)))
        \\    (i32.const 1)
        \\  )
        \\
        \\  (func $__map_slot
        \\      (param $map i32) (param $key i32) (param $key_length i64)
        \\      (param $hash i64) (result i64)
        \\    (local $mask i64) (local $slot i64) (local $entry_index i64)
        \\    (local $entry i32)
        \\    (local.set $mask
        \\      (i64.sub (i64.load (i32.add (local.get $map) (i32.const 32))) (i64.const 1)))
        \\    (local.set $slot (i64.and (local.get $hash) (local.get $mask)))
        \\    (loop $probe
        \\      (local.set $entry_index
        \\        (i64.load (i32.add
        \\          (i32.load (i32.add (local.get $map) (i32.const 24)))
        \\          (i32.wrap_i64 (i64.mul (local.get $slot) (i64.const 8))))))
        \\      (if (i64.lt_s (local.get $entry_index) (i64.const 0))
        \\        (then (return (local.get $slot))))
        \\      (local.set $entry
        \\        (i32.add (i32.load (local.get $map))
        \\          (i32.wrap_i64 (i64.mul (local.get $entry_index) (i64.const 32)))))
        \\      (if (i32.and
        \\            (i64.eq (i64.load (i32.add (local.get $entry) (i32.const 24)))
        \\              (local.get $hash))
        \\            (i32.and
        \\              (i64.eq (i64.load (i32.add (local.get $entry) (i32.const 8)))
        \\                (local.get $key_length))
        \\              (call $__map_keys_equal (i32.load (local.get $entry))
        \\                (local.get $key) (local.get $key_length))))
        \\        (then (return (local.get $slot))))
        \\      (local.set $slot
        \\        (i64.and (i64.add (local.get $slot) (i64.const 1)) (local.get $mask)))
        \\      (br $probe))
        \\    (unreachable)
        \\  )
        \\
        \\  (func $__map_find
        \\      (param $map i32) (param $key i32) (param $key_length i64) (result i64)
        \\    (local $slot i64)
        \\    (if (i32.or (i32.eqz (local.get $map))
        \\          (i32.or (i64.lt_s (local.get $key_length) (i64.const 0))
        \\            (i32.or
        \\              (i32.and (i32.eqz (local.get $key))
        \\                (i64.gt_s (local.get $key_length) (i64.const 0)))
        \\              (i64.eqz (i64.load (i32.add (local.get $map) (i32.const 32)))))))
        \\      (then (return (i64.const -1))))
        \\    (local.set $slot (call $__map_slot (local.get $map) (local.get $key)
        \\      (local.get $key_length) (call $__map_hash (local.get $key) (local.get $key_length))))
        \\    (i64.load (i32.add
        \\      (i32.load (i32.add (local.get $map) (i32.const 24)))
        \\      (i32.wrap_i64 (i64.mul (local.get $slot) (i64.const 8)))))
        \\  )
        \\
        \\  (func $__map_reindex
        \\      (param $allocator i32) (param $map i32) (param $needed i64) (result i32)
        \\    (local $next i64) (local $old_index i32) (local $old_capacity i64)
        \\    (local $new_index i32) (local $bytes i32) (local $mask i64)
        \\    (local $entry_index i64) (local $entry i32) (local $slot i64)
        \\    (if (i32.or (i32.eqz (local.get $map))
        \\          (i64.lt_s (local.get $needed) (i64.const 0)))
        \\      (then (return (i32.const 0))))
        \\    (local.set $old_index (i32.load (i32.add (local.get $map) (i32.const 24))))
        \\    (local.set $old_capacity
        \\      (i64.load (i32.add (local.get $map) (i32.const 32))))
        \\    (local.set $next (local.get $old_capacity))
        \\    (if (i64.eqz (local.get $next))
        \\      (then (local.set $next (i64.const 8))))
        \\    (block $grown
        \\      (loop $grow
        \\        (br_if $grown (i64.le_u (local.get $needed)
        \\          (i64.div_u (i64.mul (local.get $next) (i64.const 3)) (i64.const 4))))
        \\        (if (i64.gt_u (local.get $next) (i64.const 134217727))
        \\          (then (return (i32.const 0))))
        \\        (local.set $next (i64.mul (local.get $next) (i64.const 2)))
        \\        (br $grow)))
        \\    (if (i64.eq (local.get $next) (local.get $old_capacity))
        \\      (then (return (i32.const 1))))
        \\    (local.set $bytes (i32.wrap_i64 (i64.mul (local.get $next) (i64.const 8))))
        \\    (local.set $new_index
        \\      (call $__allocator_alloc (local.get $allocator) (local.get $bytes)))
        \\    (if (i32.eqz (local.get $new_index)) (then (return (i32.const 0))))
