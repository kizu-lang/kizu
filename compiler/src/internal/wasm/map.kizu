        \\          (i32.mul (local.get $entry_size) (i32.wrap_i64 (local.get $number)))))
        \\        (if (i64.gt_u (i64.load (i32.add (local.get $entry) (i32.const 8))) (i64.const 8))
        \\          (then (call $__allocator_free (local.get $allocator)
        \\            (i32.load (i32.add (local.get $entry) (i32.const 16)))
        \\            (i32.wrap_i64 (i64.load (i32.add (local.get $entry) (i32.const 8)))))))
