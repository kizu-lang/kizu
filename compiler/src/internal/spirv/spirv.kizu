fn (self: &var Emitter) emit_phi_assignments(module: &ir::Module, function: &ir::FunctionNode, from: ir::Name, to: i64) -> !void {
    if to < 0 {
        return;
    }
    let block = function.blocks.get_or_panic(to);
    let block_node = module.blocks.at(block.node);
    var instr_index = 0;
    while block_node.instrs.get(instr_index) |instr| {
        instr_index = instr_index + 1;
        let instr_node = module.instrs.at(instr.node);
        if instr_node.op != ir::Op::Phi {
            continue;
        }
        let input = self.phi_homes.get(self.key(instr_node.result.name)) orelse continue;
        var incoming_index = 0;
        while instr_node.incoming.get(incoming_index) |incoming| {
            incoming_index = incoming_index + 1;
            if !ir::same_name(incoming.block, from) {
