            if input.second > 0 {
                let first = try self.read_first(incoming.value.name);
                let second = try self.read_second(incoming.value.name);
                try self.store(input.first, first);
                try self.store(input.second, second);
            } else {
                let value = try self.read(incoming.value.name);
                try self.store(input.first, value);
            }
