        Return => {
            if self.role == Role::Helper and self.returns_value {
                let value = try self.read(terminator.value.name);
                try self.start();
                try self.put(value);
                try self.end(254);
            } else {
                try self.start();
                try self.end(253);
            }
            self.open = false;
            return null;
        },
        Unreachable => {
            try self.fail_action();
            return null;
        },
        Jump => {
            let target = flow.successor(index, 0);
            try self.emit_phi_assignments(module, function, block_node.name, target);
            return self.emit_from(module, function, flow, target, context);
        },
        Branch => {
            let then_target = flow.successor(index, 0);
            let else_target = flow.successor(index, 1);
            let merge = flow.ipdom.get_or_panic(index);
            let arms = Context {
                loop_header: context.loop_header,
                loop_exit: context.loop_exit,
                follow: merge,
                continue_label: context.continue_label,
                merge_label: context.merge_label
            };
            let condition = try self.read(terminator.cond.name);
            let then_label = self.fresh();
            let else_label = self.fresh();
            let merge_label = self.fresh();
            try self.selection(condition, then_label, else_label, merge_label);
            try self.label(then_label);
            try self.emit_phi_assignments(module, function, block_node.name, then_target);
            if try self.emit_from(module, function, flow, then_target, arms) |failed| {
                return move failed;
            }
            let then_reaches = self.open;
            try self.branch(merge_label);
            try self.label(else_label);
            try self.emit_phi_assignments(module, function, block_node.name, else_target);
            if try self.emit_from(module, function, flow, else_target, arms) |failed| {
                return move failed;
            }
            let else_reaches = self.open;
            try self.branch(merge_label);
            try self.label(merge_label);
            if merge < 0 or (!then_reaches and !else_reaches) {
                try self.unreachable();
                return null;
            }
            return self.emit_from(module, function, flow, merge, context);
        },
        None => return try fail(self.allocator, module, ast::zero_span(), "block `", block_node.name, "` has no terminator"),
    }
    return null;
}

fn (self: &var Emitter) emit_phi_entry(node: &ir::InstrNode) -> !void {
    let key = self.key(node.result.name);
