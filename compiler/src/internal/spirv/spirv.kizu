fn (self: &var Emitter) emit_body(module: &ir::Module, node: &ir::FunctionNode) -> !?diagnostic::Diagnostic {
    var flow = try msl::analyze_flow(self.allocator, module, node);
    defer flow.deinit(self.allocator);
    var header = 0;
    while header < flow.count {
        if flow.header.get_or_panic(header) and flow.loop_exits.get_or_panic(header) > 1 {
            return try fail(self.allocator, module, ast::zero_span(), "`", node.name,
                "` has a loop that leaves to more than one place, which the spirv target cannot structure yet");
        }
        header = header + 1;
    }
    let outermost = Context { loop_header: -1, loop_exit: -1, follow: -1, continue_label: 0, merge_label: 0 };
    return self.emit_from(module, node, &flow, 0, outermost);
}

fn (self: &var Emitter) emit_from(
    module: &ir::Module,
    function: &ir::FunctionNode,
    flow: &msl::Flow,
    start: i64,
    context: Context
) -> !?diagnostic::Diagnostic {
    var block = start;
    while true {
        if block < 0 or block == context.follow {
            return null;
        }
        if block == context.loop_header {
            try self.branch(context.continue_label);
            return null;
        }
        if block == context.loop_exit {
            try self.branch(context.merge_label);
            return null;
        }
        if !flow.header.get_or_panic(block) {
            return self.emit_block(module, function, flow, block, context);
        }
        let exit = flow.loop_exit.get_or_panic(block);
        let header_label = self.fresh();
        let body_label = self.fresh();
        let continue_label = self.fresh();
        let merge_label = self.fresh();
        try self.branch(header_label);
        try self.label(header_label);
        try self.start();
        try self.put(merge_label);
        try self.put(continue_label);
        try self.put(0);
        try self.end(246);
        try self.branch(body_label);
        try self.label(body_label);
        let inner = Context { loop_header: block, loop_exit: exit, follow: -1, continue_label: continue_label, merge_label: merge_label };
        if try self.emit_block(module, function, flow, block, inner) |failed| {
            return move failed;
        }
        try self.branch(continue_label);
        try self.label(continue_label);
        try self.branch(header_label);
        try self.label(merge_label);
        if exit < 0 {
            try self.unreachable();
            return null;
        }
        block = exit;
    }
    return null;
}

fn (self: &var Emitter) emit_block(
    module: &ir::Module,
    function: &ir::FunctionNode,
    flow: &msl::Flow,
    index: i64,
    context: Context
) -> !?diagnostic::Diagnostic {
    let block = function.blocks.get_or_panic(index);
    let block_node = module.blocks.at(block.node);
    var instr_index = 0;
    while block_node.instrs.get(instr_index) |instr| {
        instr_index = instr_index + 1;
        let instr_node = module.instrs.at(instr.node);
        if instr_node.op == ir::Op::Phi {
            try self.emit_phi_entry(instr_node);
        }
    }
    instr_index = 0;
    while block_node.instrs.get(instr_index) |instr| {
        instr_index = instr_index + 1;
        let instr_node = module.instrs.at(instr.node);
        if instr_node.op == ir::Op::Phi {
            continue;
        }
        if try self.emit_instr(module, instr_node) |failed| {
            return move failed;
