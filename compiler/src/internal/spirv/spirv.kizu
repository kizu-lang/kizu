fn (self: &var Emitter) emit_call(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let callee_text = ir::name_text(&module.names, node.operand);
    let callee_bytes = callee_text.as_bytes();
    let callee = module.function_named(callee_bytes) orelse return try fail(self.allocator, module, node.span,
        "a kernel calls `", node.operand, "`, which has no body the spirv target can lower");
