    if target_root.count != source_root.count or target_root.element != source_root.element {
        return try unsupported(module, self.allocator, node.span, "a kernel copies arrays of different shapes into `", node.result.type_name);
    }
    let storage = try self.root_type(source_root);
    let value = try self.load(storage, source_root.variable);
    try self.store(target_root.variable, value);
    try self.use_global(target_root.variable);
    try self.use_global(source_root.variable);
    return null;
