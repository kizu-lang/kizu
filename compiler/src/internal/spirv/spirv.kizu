fn (self: &var Emitter) copy_array(module: &ir::Module, node: &ir::InstrNode, target: ir::Name, source: ir::Name) -> !?diagnostic::Diagnostic {
    let target_root = self.root_of(target) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel copies into an array of type `", node.result.type_name);
    let source_root = self.root_of(source) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel copies from an array of type `", node.result.type_name);
    if target_root.variable == source_root.variable {
        return null;
