    try self.end(57);
    let caller = self.function;
    try self.calls.append(self.allocator, Pair { from: caller, to: callee_id });
    if !ir::is_empty(node.result.name) and !module.names.is(node.result.type_name, "void") {
        try self.write(node.result.name, id);
    }
    let flag = try self.failed_flag();
    let bool_id = try self.bool_type();
    let failed = try self.load(bool_id, flag);
    try self.fail_when(failed);
    return null;
}

fn (self: &Emitter) instance_end(position: i64) -> i64 {
    if self.instance_starts.get(position + 1) |next| {
        return next;
    }
    return self.code_pool.len();
}

fn (self: &Emitter) instance_codes(position: i64, out: &var array::Array<i64>) -> !void {
    var index = self.instance_starts.get_or_panic(position);
    let last = self.instance_end(position);
    while index < last {
        try out.append(self.allocator, self.code_pool.get_or_panic(index));
        index = index + 1;
    }
    return;
}

fn (self: &Emitter) instance_matches(position: i64, function: ir::Function, codes: &array::Array<i64>) -> bool {
    if self.instance_functions.get_or_panic(position).node != function.node {
        return false;
    }
    let first = self.instance_starts.get_or_panic(position);
    if self.instance_end(position) - first != codes.len() {
        return false;
    }
    var index = 0;
    while codes.get(index) |code| {
        if self.code_pool.get_or_panic(first + index) != code {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn (self: &var Emitter) request_instance(function: ir::Function, codes: &array::Array<i64>) -> !i64 {
    var position = 0;
    while position < self.instance_ids.len() {
        if self.instance_matches(position, function, codes) {
            return self.instance_ids.get_or_panic(position);
        }
        position = position + 1;
    }
    let id = self.fresh();
    let pool_start = self.code_pool.len();
    try self.instance_functions.append(self.allocator, function);
    try self.instance_ids.append(self.allocator, id);
    try self.instance_starts.append(self.allocator, pool_start);
    var index = 0;
    while codes.get(index) |code| {
        index = index + 1;
        try self.code_pool.append(self.allocator, code);
    }
    return id;
}

fn (self: &var Emitter) builtin_value(code: i64, vector: bool) -> !i64 {
    let word_type = try self.int_type(32);
    var variable: i64 = 0;
    if self.builtins.get(code) |existing| {
        variable = existing;
    } else {
        var pointee = word_type;
        if vector {
            pointee = try self.vector3_type();
        }
        variable = try self.global_variable(1, pointee, 0);
        try self.decorate_value(variable, 11, code);
        try self.builtins.insert(self.allocator, code, variable);
    }
    try self.use_global(variable);
    if !vector {
        return self.load(word_type, variable);
    }
    let vector_type = try self.vector3_type();
    let loaded = try self.load(vector_type, variable);
    return self.op2(81, word_type, loaded, 0);
}

fn (self: &var Emitter) emit_expression(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let wide = try self.i64_type();
    let word_type = try self.int_type(32);
    match node.op {
        Id => {
            self.produced = try self.read(node.args.get_or_panic(0).name);
        },
        GpuIndex => {
            var code: i64 = 28;
            var vector = true;
            if module.names.is(node.immediate, "group") {
                code = 26;
            }
            if module.names.is(node.immediate, "local") {
                code = 29;
                vector = false;
            }
            if module.names.is(node.immediate, "simdgroup") {
                code = 40;
                vector = false;
                self.subgroup = true;
            }
            if module.names.is(node.immediate, "lane") {
                code = 41;
                vector = false;
                self.subgroup = true;
            }
            let value = try self.builtin_value(code, vector);
            self.produced = try self.op1(113, wide, value);
        },
        GpuShuffleXor => {
            let float_id = try self.float_type();
            let value = try self.read(node.args.get_or_panic(0).name);
            let mask_wide = try self.read(node.args.get_or_panic(1).name);
            let mask = try self.op1(113, word_type, mask_wide);
            let scope = try self.int_constant(32, 3);
            self.produced = try self.op3(346, float_id, scope, value, mask);
            self.subgroup = true;
            self.shuffle = true;
        },
        GpuSimdMax => {
            let float_id = try self.float_type();
            let value = try self.read(node.args.get_or_panic(0).name);
            let scope = try self.int_constant(32, 3);
            self.produced = try self.op3(358, float_id, scope, 0, value);
            self.subgroup = true;
            self.arithmetic = true;
        },
        GpuMath => {
            var instruction: i64 = 0;
            if module.names.is(node.immediate, "exp") {
                instruction = 27;
            }
            if module.names.is(node.immediate, "log") {
                instruction = 28;
            }
            if module.names.is(node.immediate, "sqrt") {
                instruction = 31;
            }
            if instruction == 0 {
                return try fail(self.allocator, module, node.span, "a kernel uses the gpu math function `", node.immediate,
                    "`, which the spirv target does not support yet");
            }
            let float_id = try self.float_type();
            let value = try self.read(node.args.get_or_panic(0).name);
            let glsl = self.glsl;
            self.produced = try self.op3(12, float_id, glsl, instruction, value);
        },
        FloatBits => {
            let value = try self.read(node.args.get_or_panic(0).name);
            let bits = try self.op1(124, word_type, value);
            self.produced = bits;
            let shape = msl::shape_named(module, node.result.type_name) orelse return null;
            if width_of(shape.element) == 64 {
                self.produced = try self.op1(113, wide, bits);
            }
        },
        FloatFromBits => {
            let float_id = try self.float_type();
            var value = try self.read(node.args.get_or_panic(0).name);
            let source = node.args.get_or_panic(0);
            let shape = msl::shape_named(module, source.type_name) orelse return null;
            if width_of(shape.element) == 64 {
                value = try self.op1(113, word_type, value);
            }
            self.produced = try self.op1(124, float_id, value);
        },
        Cast => return self.emit_cast(module, node),
        Unary => return self.emit_unary(module, node),
        Binary => return self.emit_binary(module, node),
        SliceLen => {
            self.produced = try self.read_second(node.args.get_or_panic(0).name);
        },
        SliceIndex => {
            let view = node.args.get_or_panic(0);
            let shape = msl::shape_named(module, view.type_name) orelse return try unsupported(module, self.allocator, node.span,
                "a kernel indexes a value of type `", view.type_name);
            let index = try self.read(node.args.get_or_panic(1).name);
            let access = try self.element_access(view.name, shape.element, index);
            self.produced = try self.load_access(access);
        },
        _ => {
            var message = string::new(self.allocator);
            defer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, "spirv error: a kernel uses `");
            try message.append_bytes(self.allocator, ir::op_spelling(node.op));
            try message.append_bytes(self.allocator, "`, which the spirv target does not support yet");
            let bytes = message.as_bytes();
            return try diagnostic::from_text(self.allocator, diagnostic::Severity::Error, node.span, bytes);
        },
    }
    return null;
}

fn (self: &var Emitter) emit_cast(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let source_value = node.args.get_or_panic(0);
    let source = msl::shape_named(module, source_value.type_name) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel casts from `", source_value.type_name);
    let target = msl::shape_named(module, node.result.type_name) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel casts to `", node.result.type_name);
    if source.form != msl::Form::Value or target.form != msl::Form::Value {
        return try unsupported(module, self.allocator, node.span, "a kernel casts to `", node.result.type_name);
    }
    let value = try self.read(source_value.name);
    let target_type = try self.scalar_type(target.element);
    if source.element == target.element {
        self.produced = value;
        return null;
    }
    if target.element == msl::Scalar::Bool {
        let zero = try self.int_constant(width_of(source.element), 0);
        self.produced = try self.op2(171, target_type, value, zero);
        return null;
    }
    if source.element == msl::Scalar::Bool {
        if target.element == msl::Scalar::F32 {
            let one = try self.float_constant(msl::binary32_bits(cast<f32>(1.0)));
            let zero = try self.float_constant(0);
            self.produced = try self.op3(169, target_type, value, one, zero);
            return null;
        }
        let one = try self.int_constant(width_of(target.element), 1);
        let zero = try self.int_constant(width_of(target.element), 0);
        self.produced = try self.op3(169, target_type, value, one, zero);
        return null;
    }
    if source.element == msl::Scalar::F32 {
        var opcode: i64 = 109;
        if is_signed(target.element) {
            opcode = 110;
        }
        self.produced = try self.op1(opcode, target_type, value);
        return null;
    }
    if target.element == msl::Scalar::F32 {
        var opcode: i64 = 112;
        if is_signed(source.element) {
            opcode = 111;
        }
        self.produced = try self.op1(opcode, target_type, value);
        return null;
    }
    let source_width = width_of(source.element);
    let target_width = width_of(target.element);
    if source_width == target_width {
        self.produced = value;
        return null;
    }
    var opcode: i64 = 113;
    if target_width > source_width and is_signed(source.element) {
        opcode = 114;
    }
    self.produced = try self.op1(opcode, target_type, value);
    return null;
}

fn (self: &var Emitter) emit_unary(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let operand = node.args.get_or_panic(0);
    let shape = msl::shape_named(module, operand.type_name) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel negates a value of type `", operand.type_name);
    let type_id = try self.scalar_type(shape.element);
    let value = try self.read(operand.name);
    var opcode: i64 = 0;
    if module.names.is(node.operand, "-") {
        opcode = 126;
        if shape.element == msl::Scalar::F32 {
            opcode = 127;
        }
    }
    if module.names.is(node.operand, "!") {
        opcode = 200;
        if shape.element == msl::Scalar::Bool {
            opcode = 168;
        }
    }
    if module.names.is(node.operand, "~") {
        opcode = 200;
    }
    if opcode == 0 {
        return try fail(self.allocator, module, node.span, "a kernel uses the operator `", node.operand,
            "`, which the spirv target does not support yet");
    }
    self.produced = try self.op1(opcode, type_id, value);
    return null;
}

fn binary_opcode(operator: []u8, kind: msl::Scalar) -> i64 {
    let float = kind == msl::Scalar::F32;
    let boolean = kind == msl::Scalar::Bool;
    let signed = is_signed(kind);
    if mem::equal_bytes(operator, "+") {
        if float { return 129; }
        return 128;
    }
    if mem::equal_bytes(operator, "-") {
        if float { return 131; }
        return 130;
    }
    if mem::equal_bytes(operator, "*") {
        if float { return 133; }
        return 132;
    }
    if mem::equal_bytes(operator, "/") {
        if float { return 136; }
        if signed { return 135; }
        return 134;
    }
    if mem::equal_bytes(operator, "%") {
        if float { return 140; }
        if signed { return 138; }
        return 137;
    }
    if mem::equal_bytes(operator, "&") or mem::equal_bytes(operator, "&&") or mem::equal_bytes(operator, "and") {
        if boolean { return 167; }
        return 199;
    }
    if mem::equal_bytes(operator, "|") or mem::equal_bytes(operator, "||") or mem::equal_bytes(operator, "or") {
        if boolean { return 166; }
        return 197;
    }
    if mem::equal_bytes(operator, "^") {
        if boolean { return 165; }
        return 198;
    }
    if mem::equal_bytes(operator, "<<") {
        return 196;
    }
    if mem::equal_bytes(operator, ">>") {
        if signed { return 195; }
        return 194;
    }
    if mem::equal_bytes(operator, "==") {
        if float { return 180; }
        if boolean { return 164; }
        return 170;
    }
    if mem::equal_bytes(operator, "!=") {
        if float { return 183; }
        if boolean { return 165; }
        return 171;
    }
    if mem::equal_bytes(operator, "<") {
        if float { return 184; }
        if signed { return 177; }
        return 176;
    }
    if mem::equal_bytes(operator, "<=") {
        if float { return 188; }
        if signed { return 179; }
        return 178;
    }
    if mem::equal_bytes(operator, ">") {
        if float { return 186; }
        if signed { return 173; }
        return 172;
    }
    if mem::equal_bytes(operator, ">=") {
        if float { return 190; }
        if signed { return 175; }
        return 174;
    }
    return 0;
}

fn (self: &var Emitter) emit_binary(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let left = node.args.get_or_panic(0);
    let shape = msl::shape_named(module, left.type_name) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel computes with a value of type `", left.type_name);
    let result_shape = msl::shape_named(module, node.result.type_name) orelse return try unsupported(module, self.allocator, node.span,
        "a kernel computes a value of type `", node.result.type_name);
    let operator_text = ir::name_text(&module.names, node.operand);
    let operator = operator_text.as_bytes();
    let opcode = binary_opcode(operator, shape.element);
    if opcode == 0 {
        return try fail(self.allocator, module, node.span, "a kernel uses the operator `", node.operand,
            "`, which the spirv target does not support yet");
    }
    let first = try self.read(left.name);
    let second = try self.read(node.args.get_or_panic(1).name);
    let type_id = try self.scalar_type(result_shape.element);
    self.produced = try self.op2(opcode, type_id, first, second);
    if opcode == 129 or opcode == 131 or opcode == 133 or opcode == 136 or opcode == 140 {
        let produced = self.produced;
        try self.decorate(produced, 42);
    }
    return null;
}

fn (self: &var Emitter) capability(out: &var array::Array<u32>, value: i64) -> !void {
    let at = try begin(self.allocator, out);
    try word(self.allocator, out, value);
    return finish(out, at, 17);
}

fn contains(values: &array::Array<i64>, value: i64) -> bool {
    var index = 0;
    while values.get(index) |existing| {
        if existing == value {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn (self: &var Emitter) interface_of(function: i64, out: &var array::Array<i64>) -> !void {
    var reached = array::new<i64>(self.allocator);
    defer reached.deinit(self.allocator);
    try reached.append(self.allocator, function);
    var changed = true;
    while changed {
        changed = false;
        var call_index = 0;
        while self.calls.get(call_index) |call| {
            call_index = call_index + 1;
            if contains(&reached, call.from) and !contains(&reached, call.to) {
                try reached.append(self.allocator, call.to);
                changed = true;
            }
        }
    }
    var use_index = 0;
    while self.globals_used.get(use_index) |used| {
        use_index = use_index + 1;
        if contains(&reached, used.from) and !contains(out, used.to) {
            try out.append(self.allocator, used.to);
        }
    }
    return;
}

fn execution_mode(allocator: Allocator, out: &var array::Array<u32>, function: i64, mode: i64) -> !void {
    let at = try begin(allocator, out);
    try word(allocator, out, function);
    try word(allocator, out, mode);
    try word(allocator, out, 32);
    return finish(out, at, 16);
}

fn append_words(allocator: Allocator, out: &var array::Array<u32>, words: &array::Array<u32>) -> !void {
    var index = 0;
    while words.get(index) |value| {
        index = index + 1;
        try out.append(allocator, value);
    }
    return;
}

fn (self: &var Emitter) assemble(out: &var array::Array<u32>) -> !void {
    var entries = array::new<u32>(self.allocator);
    defer entries.deinit(self.allocator);
    var modes = array::new<u32>(self.allocator);
    defer modes.deinit(self.allocator);
    var kernel_index = 0;
    while self.kernel_functions.get(kernel_index) |function| {
        var interface = array::new<i64>(self.allocator);
        defer interface.deinit(self.allocator);
        try self.interface_of(function, &var interface);
        let name_start = self.kernel_starts.get_or_panic(kernel_index);
        let names = self.kernel_names.as_bytes();
        var name_end = mem::len(names);
        if self.kernel_starts.get(kernel_index + 1) |next| {
            name_end = next;
        }
        kernel_index = kernel_index + 1;
        let name_bytes = names[name_start..name_end];
        let at = try begin(self.allocator, &var entries);
        try word(self.allocator, &var entries, 5);
        try word(self.allocator, &var entries, function);
        try text_words(self.allocator, &var entries, name_bytes);
        var interface_index = 0;
        while interface.get(interface_index) |global| {
            interface_index = interface_index + 1;
            try word(self.allocator, &var entries, global);
        }
        try finish(&var entries, at, 15);
        try execution_mode(self.allocator, &var modes, function, 4459);
        try execution_mode(self.allocator, &var modes, function, 4461);
    }
    try word(self.allocator, out, 0x07230203);
    try word(self.allocator, out, 0x00010500);
    try word(self.allocator, out, 0);
    let bound = self.next;
    try word(self.allocator, out, bound);
    try word(self.allocator, out, 0);
    try self.capability(out, 1);
    try self.capability(out, 11);
    try self.capability(out, 5347);
    try self.capability(out, 4464);
    try self.capability(out, 4466);
    if self.int8 {
        try self.capability(out, 39);
    }
    if self.int16 {
        try self.capability(out, 22);
    }
    if self.device8 {
        try self.capability(out, 4448);
    }
    if self.device16 {
        try self.capability(out, 4433);
    }
    if self.subgroup {
        try self.capability(out, 61);
    }
    if self.arithmetic {
        try self.capability(out, 63);
    }
    if self.shuffle {
        try self.capability(out, 65);
    }
    let import_at = try begin(self.allocator, out);
    let glsl = self.glsl;
    try word(self.allocator, out, glsl);
    try text_words(self.allocator, out, "GLSL.std.450");
    try finish(out, import_at, 11);
    let memory_at = try begin(self.allocator, out);
    try word(self.allocator, out, 5348);
    try word(self.allocator, out, 1);
    try finish(out, memory_at, 14);
    try append_words(self.allocator, out, &entries);
    try append_words(self.allocator, out, &modes);
    let allocator = self.allocator;
    try append_words(allocator, out, &self.annotations);
    try append_words(allocator, out, &self.globals);
    try append_words(allocator, out, &self.functions);
    return;
}
