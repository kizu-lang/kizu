import std::fmt;
import std::string;

// Keeps std::fmt reachable from compiler::main after main imports
// compiler::internal::fmt. Kizu has no alias import, and both paths otherwise
// bind the same local module name.

/// Appends one decimal i64 using the std formatter.
pub fn append_i64(out: &var string::String, value: i64) -> !void {
    return fmt::append_i64(out, value);
}
