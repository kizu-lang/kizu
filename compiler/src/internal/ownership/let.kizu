import compiler::internal::ast;
import compiler::internal::diagnostic;
import std::array;

// Port of the `let` recognizers of internal/ownership/checker.go: borrow
// lets, Box and String view lets, returned-borrow and view-capture lets, and
// the plain move let, plus the call-source derivations they share.

/// Is the resolved source of a direct Arena.at result, the Go
/// `arenaAtBorrowSource` result: the arena place and the element type.
pub struct ArenaAtSource {
    pub target: ?BindingHandle,
    pub field: Name,
    pub elem: Name
}

/// Is the name and signature of a resolved call target, the Go
/// `calledFunction` result.
pub struct CalledFunction {
    pub name: Name,
    pub function: FunctionHandle
}

/// Moves the initializer into a new binding when needed, the Go
/// `checkLetStmt`.
fn (self: &var Checker) check_let_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::LetStmt
) -> !?diagnostic::Diagnostic {
    if borrow_prefix(tree, statement.value) |borrow| {
        return self.check_borrow_let_stmt(tree, env, statement, borrow);
    }
    var box = self.new_box_borrow();
    var handled = false;
    if try self.box_borrow_initializer(tree, env, statement.value, &var box, &var handled) |failed| {
        return move failed;
    }
    if handled {
        return self.check_box_borrow_let_stmt(tree, env, statement, box);
    }
    var view = self.new_string_view();
    if try self.string_view_initializer(tree, env, statement.value, &var view) {
        return self.check_string_view_let_stmt(tree, env, statement, view);
    }
    if try self.check_explicit_borrow_result_let_stmt(tree, env, statement, &var handled) |failed| {
        return move failed;
    }
    if handled {
        return null;
    }
    var sources = array::new<BorrowSource>(self.allocator);
    defer sources.deinit(self.allocator);
    var returned = ReturnedBorrow { elem: empty_name(), mutable: false };
    if try self.returned_borrow_initializer(tree, env, statement.value, &var sources, &var returned, &var handled) |failed| {
        return move failed;
    }
    if handled {
        return self.check_returned_borrow_let_stmt(tree, env, statement, &sources, returned.elem, returned.mutable);
    }
    if try self.check_capture_let_stmt(tree, env, statement, &var handled) |failed| {
        return move failed;
    }
    if handled {
        return null;
    }
    var type_name = empty_name();
    if try self.move_expr(tree, env, statement.value, &var type_name) |failed| {
        return move failed;
    }
    if try self.reject_stored_optional(tree, type_name) |failed| {
        return move failed;
    }
    let name = try self.names.intern_text(tree, statement.name);
    var value = self.store.new_binding(name, type_name);
    errdefer value.deinit(self.allocator);
    value.mutable = statement.mutable;
    value.decl_span = expression_span(tree, statement.value);
    let handle = try self.store.retain(move value);
    try self.set_arena_provenance(tree, env, handle, statement.value);
    if try self.attach_alloc_provenance(tree, handle) |failed| {
        return move failed;
    }
    return self.define_retained(env, handle);
}

/// Recognizes Arena.at and declared borrow returns before the view-capture
/// path, the Go `checkExplicitBorrowResultLetStmt`, because &Owner binds a
/// reference and must not inherit the owner's deinit obligation.
fn (self: &var Checker) check_explicit_borrow_result_let_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::LetStmt,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = true;
    var source = ArenaAtSource { target: null, field: empty_name(), elem: empty_name() };
    if try self.arena_at_borrow_source(tree, env, statement.value, &var source) |failed| {
        return move failed;
    }
    if source.target |target| {
        var sources = array::new<BorrowSource>(self.allocator);
        defer sources.deinit(self.allocator);
        try sources.append(self.allocator, BorrowSource { target: target, field: source.field });
        return self.check_explicit_returned_borrow_let_stmt(tree, env, statement, &sources, source.elem, false);
    }
    var sources = array::new<BorrowSource>(self.allocator);
    defer sources.deinit(self.allocator);
    var returned = ReturnedBorrow { elem: empty_name(), mutable: false };
    var recognized = false;
    if try self.explicit_returned_borrow_initializer(
        tree, env, statement.value, &var sources, &var returned, &var recognized
    ) |failed| {
        return move failed;
    }
    if !recognized {
        handled.* = false;
        return null;
    }
    return self.check_explicit_returned_borrow_let_stmt(tree, env, statement, &sources, returned.elem, returned.mutable);
}

/// Separates a declared &T or &var T result from owners that merely capture
/// views, the Go `explicitReturnedBorrowInitializer`. Both carry structural
/// sources, but only the latter retain an ownership obligation in the caller.
fn (self: &var Checker) explicit_returned_borrow_initializer(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    sources: &var array::Array<BorrowSource>,
    returned: &var ReturnedBorrow,
    recognized: &var bool
) -> !?diagnostic::Diagnostic {
    recognized.* = false;
    let call = call_expr(tree, expression) orelse return null;
    let called = try self.called_user_function(tree, env, call.callee) orelse return null;
    if !self.names.is_explicit_borrow(self.return_type_name(called.function)) {
        return null;
    }
    return self.returned_borrow_initializer(tree, env, expression, sources, returned, recognized);
}

/// Recognizes a direct Arena.at result and resolves the arena place that
/// keeps the element alive, the Go `arenaAtBorrowSource`. It validates the
/// complete call before the caller records the returned shared borrow. A
/// failure comes back as the diagnostic; an unrecognized shape leaves the
/// target null.
fn (self: &var Checker) arena_at_borrow_source(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var ArenaAtSource
) -> !?diagnostic::Diagnostic {
    out.target = null;
    let call = call_expr(tree, expression) orelse return null;
    let field = field_expr(tree, call.callee) orelse return null;
    if field.namespace or !text_equals(tree, field.name, "at") {
        return null;
    }
    var receiver_type = empty_name();
    if try self.read_expr(tree, env, field.receiver, &var receiver_type) |failed| {
        failed.deinit(self.allocator);
        return null;
    }
    let borrowed = try self.names.borrowed_value(receiver_type);
    let parts = try self.names.split_generic(borrowed) orelse return null;
    if !self.names.is(parts.base, "std::arena::Arena") {
        return null;
    }
    var target = self.new_borrow_target();
    if try self.borrow_target(tree, env, field.receiver, &var target) |failed| {
        return move failed;
    }
    var result = empty_name();
    if try self.read_expr(tree, env, expression, &var result) |failed| {
        return move failed;
    }
    let result_parts = try self.names.explicit_borrow(result);
    var accepted = false;
    if result_parts |borrow| {
        accepted = !borrow.mutable and same_name(borrow.inner, parts.args);
    }
    if !accepted {
        return try self.error2(
            tree, ast::zero_span(), "arena error: Arena.at must return &%s, got %s",
            Arg::Str(parts.args), Arg::Str(result)
        );
    }
    out.target = target.value;
    out.field = target.field;
    out.elem = parts.args;
    return null;
}

/// Is the payload a `?T` or `E!T` spelling wraps, and which wrapper it is.
pub struct WrappedPayload {
    pub elem: Name,
    pub error_union: bool
}

/// Refuses to store a `?T` or `E!T` whose payload owns memory or carries a
/// view, the Go `rejectStoredOptional`. Inside the wrapper the payload is
/// invisible to move and borrow tracking, so such a value lives only where
/// it is consumed: a capture, an `orelse` / `catch` / `try`, or a return
/// path. The two wrappers share the rule because they share the payload
/// (SPEC §11.1).
fn (self: &var Checker) reject_stored_optional(tree: &ast::Ast, type_name: Name) -> !?diagnostic::Diagnostic {
    let wrapped = try self.wrapped_payload_elem(type_name) orelse return null;
    let elem = wrapped.elem;
    if self.names.starts_with(elem, "&") or try self.view_carrying_type(elem) or
        try self.value_type_needs_consume(self.allocator, elem) {
        if wrapped.error_union {
            return try self.error1(
                tree, ast::zero_span(),
                "move error: error union `%s` must be consumed where it is produced (capture, catch, or try)",
                Arg::Str(type_name)
            );
        }
        return try self.error1(
            tree, ast::zero_span(),
            "move error: optional `%s` must be consumed where it is produced (capture or orelse)",
            Arg::Str(type_name)
        );
    }
    return null;
}

/// Returns the payload type a `?T` or `E!T` spelling wraps, the Go
/// `wrappedPayloadElem`. An error union around an optional (`E!?T`) reports
/// the innermost payload: what its capture binds is the value, and the value
/// is what carries the obligation.
fn (self: &var Checker) wrapped_payload_elem(type_name: Name) -> !?WrappedPayload {
    if try self.names.optional_elem(type_name) |elem| {
        return WrappedPayload { elem: elem, error_union: false };
    }
    let parts = try self.names.error_union_parts(type_name) orelse return null;
    if try self.names.optional_elem(parts.success) |elem| {
        return WrappedPayload { elem: elem, error_union: true };
    }
    return WrappedPayload { elem: parts.success, error_union: true };
}

/// Runs the let recognizers that tie a binding to borrow-class views, the Go
/// `checkCaptureLetStmt`: struct literal capture and view field reads.
fn (self: &var Checker) check_capture_let_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::LetStmt,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = true;
    var sources = array::new<BorrowSource>(self.allocator);
    defer sources.deinit(self.allocator);
    var elem = empty_name();
    var recognized = false;
    if try self.struct_capture_initializer(tree, env, statement.value, &var sources, &var elem, &var recognized) |failed| {
        return move failed;
    }
    if recognized {
        return self.check_returned_borrow_let_stmt(tree, env, statement, &sources, elem, false);
    }
    var view_source = self.scratch_binding;
    var found = false;
    if try self.view_field_borrow_initializer(tree, env, statement.value, &var found, &var view_source) |failed| {
        return move failed;
    }
    if found {
        try sources.append(self.allocator, BorrowSource { target: view_source, field: empty_name() });
        return self.check_returned_borrow_let_stmt(tree, env, statement, &sources, self.common.bytes_name, false);
    }
    handled.* = false;
    return null;
}

/// Recognizes a struct literal that captures borrow-class views in its
/// fields, the Go `structCaptureInitializer`. Only a let can carry the tie,
/// so the recognizer lives on the let path; everywhere else the literal
/// keeps being rejected by the move on its field values.
fn (self: &var Checker) struct_capture_initializer(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    sources: &var array::Array<BorrowSource>,
    elem: &var Name,
    recognized: &var bool
) -> !?diagnostic::Diagnostic {
    recognized.* = false;
    let head = struct_literal_head(tree, expression) orelse return null;
    let type_name = try self.names.intern_text(tree, head.type_name);
    if !try self.view_capture_struct_type(type_name) {
        return null;
    }
    var captures = false;
    var index = 0;
    while struct_literal_field_at(tree, expression, index) |field| {
        if try self.borrow_class_view_root(tree, env, field.value) |_| {
            captures = true;
        }
        index = index + 1;
    }
    if !captures {
        return null;
    }
    recognized.* = true;
    var ignored = empty_name();
    index = 0;
    while struct_literal_field_at(tree, expression, index) |field| {
        index = index + 1;
        if try self.borrow_class_view_root(tree, env, field.value) |view| {
            if try self.read_expr(tree, env, field.value, &var ignored) |failed| {
                return move failed;
            }
            try sources.append(self.allocator, BorrowSource { target: view, field: empty_name() });
            continue;
        }
        if try self.move_expr(tree, env, field.value, &var ignored) |failed| {
            return move failed;
        }
    }
    elem.* = type_name;
    return null;
}

/// Recognizes reading a `[]u8` field out of a borrow-class value, the Go
/// `viewFieldBorrowInitializer`: the copy is a view of the same backing, so
/// the binding stays tied to the value it was read from.
fn (self: &var Checker) view_field_borrow_initializer(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    found: &var bool,
    out: &var BindingHandle
) -> !?diagnostic::Diagnostic {
    found.* = false;
    let field = field_expr(tree, expression) orelse return null;
    if field.namespace {
        return null;
    }
    let root = try self.borrow_class_view_root(tree, env, expression) orelse return null;
    var ignored = empty_name();
    if try self.read_expr(tree, env, expression, &var ignored) |failed| {
        return move failed;
    }
    found.* = true;
    out.* = root;
    return null;
}

/// Ties a fresh owner to the tied allocators its initializer consumed, the
/// Go `attachAllocProvenance`. The owner keeps its consume obligation; the
/// shared borrow keeps each allocator — and transitively its buffer — alive
/// until the owner's last use.
fn (self: &var Checker) attach_alloc_provenance(tree: &ast::Ast, value: BindingHandle) -> !?diagnostic::Diagnostic {
    if self.pending_alloc_taints.len() == 0 {
        return null;
    }
    var sources = array::new<BorrowSource>(self.allocator);
    defer sources.deinit(self.allocator);
    while self.pending_alloc_taints.pop() |taint| {
        try sources.append(self.allocator, BorrowSource { target: taint.alloc, field: empty_name() });
    }
    // Popping reversed the taints; restore the order they were recorded in.
    var index = 0;
    var last = sources.len() - 1;
    while index < last {
        try sources.swap(index, last);
        index = index + 1;
        last = last - 1;
    }
    return self.bind_borrow_sources(tree, value, &sources, false);
}

/// Activates every source for a binding and records them as its borrow
/// targets, the Go `bindBorrowSources`. Checking before each activation (not
/// all checks first) rejects the same value passed for two mutable sources:
/// the second check sees the first activation.
fn (self: &var Checker) bind_borrow_sources(
    tree: &ast::Ast,
    value: BindingHandle,
    sources: &array::Array<BorrowSource>,
    mutable: bool
) -> !?diagnostic::Diagnostic {
    var index = 0;
    while sources.get(index) |source| {
        if try self.check_borrow_conflict_for_field(tree, source.target, source.field, mutable) |failed| {
            return move failed;
        }
        try self.activate_borrow(source.target, source.field, mutable);
        try self.append_borrow_target(value, source);
        index = index + 1;
    }
    return null;
}

/// Records one more borrow source on a binding.
fn (self: &var Checker) append_borrow_target(value: BindingHandle, source: BorrowSource) -> !void {
    let allocator = self.allocator;
    if self.store.binding_mut(value) |record| {
        return record.borrow_targets.append(allocator, source);
    }
    return;
}

/// Binds a returned view carrier to its source owner, the Go
/// `checkReturnedBorrowLetStmt`. A view-only value lives in the borrow class.
/// A value that also owes deinit stays an ordinary owner binding with borrow
/// targets, like an owner allocated from a tied allocator: it must be
/// consumed and cannot leave its sources.
fn (self: &var Checker) check_returned_borrow_let_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::LetStmt,
    sources: &array::Array<BorrowSource>,
    elem: Name,
    mutable: bool
) -> !?diagnostic::Diagnostic {
    let name = try self.names.intern_text(tree, statement.name);
    var value = self.store.new_binding(name, elem);
    errdefer value.deinit(self.allocator);
    value.mutable = statement.mutable;
    value.decl_span = expression_span(tree, statement.value);
    value.mut_borrow = mutable;
    if !try self.value_type_needs_consume(self.allocator, elem) {
        value.borrowed_param = true;
        value.local_borrow = true;
    }
    let handle = try self.store.retain(move value);
    if try self.bind_borrow_sources(tree, handle, sources, mutable) |failed| {
        return move failed;
    }
    if try self.attach_future_capability_provenance(tree, env, handle, statement.value) |failed| {
        return move failed;
    }
    if try self.attach_alloc_provenance(tree, handle) |failed| {
        return move failed;
    }
    return self.define_retained(env, handle);
}

/// Binds an already retained record in a scope under its own name.
fn (self: &var Checker) define_retained(env: ScopeHandle, handle: BindingHandle) -> !?diagnostic::Diagnostic {
    let retained = name_text(&self.names, self.binding(handle).name);
    let bytes = retained.as_bytes();
    try self.store.define_handle(self.allocator, env, bytes, handle);
    return null;
}

/// Binds a declared borrow result, the Go
/// `checkExplicitReturnedBorrowLetStmt`. The element may itself be an owner
/// type, but the binding owns only a reference to it and therefore never
/// inherits the element's deinit obligation.
fn (self: &var Checker) check_explicit_returned_borrow_let_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::LetStmt,
    sources: &array::Array<BorrowSource>,
    elem: Name,
    mutable: bool
) -> !?diagnostic::Diagnostic {
    let name = try self.names.intern_text(tree, statement.name);
    var value = self.store.new_binding(name, elem);
    errdefer value.deinit(self.allocator);
    value.mutable = statement.mutable;
    value.decl_span = expression_span(tree, statement.value);
    value.borrowed_param = true;
    value.local_borrow = true;
    value.mut_borrow = mutable;
    let handle = try self.store.retain(move value);
    if try self.bind_borrow_sources(tree, handle, sources, mutable) |failed| {
        return move failed;
    }
    return self.define_retained(env, handle);
}

/// Is the element and mutability of a recognized returned borrow, the Go
/// `returnedBorrowInitializer` result.
pub struct ReturnedBorrow {
    pub elem: Name,
    pub mutable: bool
}

/// Recognizes calls returning a borrowed view, the Go
/// `returnedBorrowInitializer`. The sources are derived structurally
/// (ADR-0098): every borrow parameter that can back the return — all of them
/// for a shared return, the `&var` ones for a mutable return — is kept
/// borrowed while the result lives.
fn (self: &var Checker) returned_borrow_initializer(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    sources: &var array::Array<BorrowSource>,
    returned: &var ReturnedBorrow,
    recognized: &var bool
) -> !?diagnostic::Diagnostic {
    recognized.* = false;
    // A factory that can refuse hands its result back through `try`. The tie
    // is a property of the value, not of how the failure was spelled, so the
    // `try` is read through rather than treated as a different expression.
    if try_expr(tree, expression) |attempt| {
        return self.returned_borrow_initializer(
            tree, env, attempt.value, sources, returned, recognized);
    }
    let call = call_expr(tree, expression) orelse return null;
    let called = try self.called_user_function(tree, env, call.callee) orelse return null;
    let ret_name = self.return_type_name(called.function);
    var mutable = false;
    var elem = empty_name();
    var allocator_return = false;
    var view_return = false;
    var tied_struct = false;
    if try self.names.explicit_borrow(ret_name) |parts| {
        mutable = parts.mutable;
        elem = parts.inner;
    } else {
        // An Allocator return with tie-capable sources is a tied allocator:
        // it holds the buffer's writable view exclusively, so it behaves as a
        // mutable borrow of its sources (page_allocator has none and falls
        // through as a plain copy value). A view or view-capturing struct
        // return ties the same way when a borrow-class view flows in, and
        // falls through as a plain value when none does.
        if self.capability_return(ret_name) {
            // An allocator holds its buffer's writable view exclusively. An
            // Io is copied into every call that takes one, so it is shared:
            // what ties it is how long it may live, not who else may hold one.
            allocator_return = true;
            mutable = !self.names.is(ret_name, "Io");
            elem = ret_name;
        } else {
            if self.tied_struct_return(ret_name) {
                // A Future holds the state it was lent exclusively. A TaskSet
                // owns its worker states and only shares the capabilities it
                // retains.
                tied_struct = true;
                mutable = !self.task_set_return(ret_name);
                allocator_return = self.task_set_return(ret_name);
                elem = try self.view_carrier_payload(ret_name);
            } else {
                if self.names.is(ret_name, "[]u8") or try self.view_capture_struct_type(ret_name) {
                    view_return = true;
                    elem = ret_name;
                } else {
                    return null;
                }
            }
        }
    }
    if try self.call_borrow_return_sources(
        tree, env, called.name, called.function, call, mutable, allocator_return, view_return, sources
    ) |failed| {
        return move failed;
    }
    if sources.len() == 0 {
        if allocator_return or view_return or tied_struct {
            return null;
        }
        return try self.error1(
            tree, ast::zero_span(), "borrow error: `%s` borrowed return has no source parameter",
            Arg::Str(called.name)
        );
    }
    var ignored = empty_name();
    if try self.check_tied_factory_call(tree, env, called.name, call, &var ignored) |failed| {
        return move failed;
    }
    returned.elem = elem;
    returned.mutable = mutable;
    recognized.* = true;
    return null;
}

/// Records the shared capability half of a Future's ties separately from its
/// exclusive state borrow. A Future stores both Io and allocator, and neither
/// becomes exclusive merely because the state is.
fn (self: &var Checker) attach_future_capability_provenance(
    tree: &var ast::Ast,
    env: ScopeHandle,
    value: BindingHandle,
    expression: ast::Expression
) -> !?diagnostic::Diagnostic {
    if try_expr(tree, expression) |attempt| {
        return self.attach_future_capability_provenance(tree, env, value, attempt.value);
    }
    let call = call_expr(tree, expression) orelse return null;
    let called = try self.called_user_function(tree, env, call.callee) orelse return null;
    let ret_name = self.return_type_name(called.function);
    if !self.tied_struct_return(ret_name) or self.task_set_return(ret_name) {
        return null;
    }
    var sources = array::new<BorrowSource>(self.allocator);
    defer sources.deinit(self.allocator);
    var index = 0;
    while arg_at(tree, call.args, index) |arg| {
        index = index + 1;
        let capability = self.tied_capability_arg(tree, env, arg) orelse continue;
        try sources.append(
            self.allocator, BorrowSource { target: capability, field: empty_name() });
    }
    return self.bind_borrow_sources(tree, value, &sources, false);
}

/// Runs the ordinary call check for a factory whose result is tied, through
/// whichever arm the callee's shape belongs to.
fn (self: &var Checker) check_tied_factory_call(
    tree: &var ast::Ast,
    env: ScopeHandle,
    name: Name,
    call: ast::CallExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if type_apply_expr(tree, call.callee) |apply| {
        return self.check_type_apply_call_expr(tree, env, apply, call.args, true, out);
    }
    if ident_text(tree, call.callee) |text| {
        if self.lookup_text(tree, env, text) |value| {
            let pointer = self.binding(value).type_name;
            if self.name_is_function_pointer(pointer) {
                return self.check_func_pointer_call(
                    tree, env, name, pointer, call.args, true, out);
            }
        }
    }
    return self.check_user_call(tree, env, name, call.args, true, out);
}

/// Lists the caller-side bindings a borrow-shaped call result stays tied
/// to, the Go `callBorrowReturnSources`: every qualifying borrow argument,
/// plus — for Allocator returns — every already-tied allocator argument, so
/// re-wrapping an allocator cannot launder its tie away, plus — for view
/// returns — every borrow-class view argument the result could have
/// captured.
fn (self: &var Checker) call_borrow_return_sources(
    tree: &var ast::Ast,
    env: ScopeHandle,
    name: Name,
    function: FunctionHandle,
    call: ast::CallExpr,
    mutable: bool,
    allocator_return: bool,
    view_return: bool,
    sources: &var array::Array<BorrowSource>
) -> !?diagnostic::Diagnostic {
    var index = 0;
    while self.param_at(function, index) |param| {
        let position = index;
        index = index + 1;
        let arg = arg_at(tree, call.args, position) orelse continue;
        if !param.borrow or (mutable and !param.mut_borrow) {
            if allocator_return {
                if self.tied_capability_arg(tree, env, arg) |alloc| {
                    try sources.append(self.allocator, BorrowSource { target: alloc, field: empty_name() });
                }
            }
            if view_return and self.names.is(param.type_name, "[]u8") {
                if try self.borrow_class_view_root(tree, env, arg) |view| {
                    try sources.append(self.allocator, BorrowSource { target: view, field: empty_name() });
                }
            }
            continue;
        }
        var target = self.new_borrow_target();
        var found = false;
        if try self.call_borrow_target(tree, env, arg, &var found, &var target) |failed| {
            return move failed;
        }
        if found {
            try sources.append(self.allocator, BorrowSource { target: target.value, field: target.field });
            continue;
        }
        // call_borrow_target tolerates non-place args for temporary call
        // borrows, but a provenance source must be a place the caller can
        // keep alive while the returned view is used.
        return try self.error2(
            tree, ast::zero_span(),
            "borrow error: `%s` borrow source `%s` must be a local binding or direct field",
            Arg::Str(name), Arg::Str(param.name)
        );
    }
    return null;
}

/// Resolves an argument to a tied allocator binding, the Go
/// `tiedAllocatorArg`.
fn (self: &Checker) tied_allocator_arg(tree: &ast::Ast, env: ScopeHandle, arg: ast::Expression) -> ?BindingHandle {
    let value = self.direct_assignment_root(tree, env, arg) orelse return null;
    if !self.names.is(self.binding(value).type_name, "Allocator") {
        return null;
    }
    if !self.binding(value).borrowed_param or !self.has_borrow_targets(value) {
        return null;
    }
    return value;
}

/// Resolves an argument to a tied capability binding, or null. This answers
/// the other question the allocator version does: may this be handed over at
/// all. Lending one is free; what is not free is outliving what it reaches.
fn (self: &Checker) tied_capability_arg(
    tree: &ast::Ast,
    env: ScopeHandle,
    arg: ast::Expression
) -> ?BindingHandle {
    let value = self.direct_assignment_root(tree, env, arg) orelse return null;
    if !self.capability_return(self.binding(value).type_name) {
        return null;
    }
    if !self.binding(value).borrowed_param or !self.has_borrow_targets(value) {
        return null;
    }
    return value;
}

/// Reports the return types that are tied when they are built from a borrow.
/// A capability is a permission to reach something, so one built out of local
/// state cannot leave the frame that state lives in.
pub fn (self: &Checker) capability_return(name: Name) -> bool {
    return self.names.is(name, "Allocator") or self.names.is(name, "Io");
}

/// Reports the std struct returns that stay tied to what they were built
/// from. A Future stands on borrowed state; a TaskSet retains the Io and
/// allocator selected when it is made.
pub fn (self: &Checker) tied_struct_return(name: Name) -> bool {
    return self.names.is(name, "std::io::Future") or
        self.names.is(name, "io::Future") or
        self.names.ends_with(name, "!std::io::Future") or
        self.names.ends_with(name, "!io::Future") or
        self.task_set_return(name);
}

pub fn (self: &Checker) task_set_return(name: Name) -> bool {
    return self.names.is(name, "std::io::TaskSet") or
        self.names.is(name, "io::TaskSet") or
        self.names.ends_with(name, "!std::io::TaskSet") or
        self.names.ends_with(name, "!io::TaskSet");
}

/// Reports whether a call to fn yields a tied allocator, the Go
/// `callTiesAllocator`: the signature takes a `&var` borrow the result stays
/// tied to, or an argument is itself a tied allocator being re-wrapped.
/// Callers pass no args to ask about the signature alone.
fn (self: &var Checker) call_ties_allocator(
    tree: &ast::Ast,
    function: FunctionHandle,
    args: ?ast::ExpressionList,
    env: ?ScopeHandle
) -> !bool {
    var index = 0;
    while self.param_at(function, index) |param| {
        if param.borrow and param.mut_borrow {
            return true;
        }
        if args |present| {
            if env |scope| {
                if arg_at(tree, present, index) |arg| {
                    if self.tied_allocator_arg(tree, scope, arg) |_| {
                        return true;
                    }
                }
            }
        }
        index = index + 1;
    }
    return false;
}

/// Resolves direct and namespace-qualified source function calls, the Go
/// `calledFunction`.
fn (self: &var Checker) called_user_function(
    tree: &ast::Ast,
    env: ScopeHandle,
    callee: ast::Expression
) -> !?CalledFunction {
    if ident_text(tree, callee) |text| {
        let name = try self.names.intern_text(tree, text);
        // A binding shadows a declaration here exactly as it does in call
        // dispatch, so returned-borrow and tied-capability recognizers see
        // the same indirect call as the ordinary ownership effects.
        if self.lookup_text(tree, env, text) |value| {
            let pointer = self.binding(value).type_name;
            if self.name_is_function_pointer(pointer) {
                let function = try self.function_pointer_handle(pointer) orelse return null;
                return CalledFunction { name: name, function: function };
            }
        }
        let function = self.function_for_text(tree, text) orelse return null;
        return CalledFunction { name: name, function: function };
    }
    if field_expr(tree, callee) |_| {
        let name = try self.qualified_name(tree, callee) orelse return null;
        let function = self.function_named(name) orelse return null;
        return CalledFunction { name: name, function: function };
    }
    // A generic call names the declaration its static arguments instantiate,
    // and the recognizers read the instantiated signature: with `T` spelled
    // out, a view or a tied allocator the call hands back is seen for what it
    // is, as it would be for a direct call.
    if type_apply_expr(tree, callee) |apply| {
        var target = empty_type_apply_target();
        if try self.type_apply_target(tree, apply, &var target) |failed| {
            failed.deinit(self.allocator);
            return null;
        }
        let function = self.function_named(target.name) orelse return null;
        if self.static_param_count(function) == 0 {
            return CalledFunction { name: target.name, function: function };
        }
        var subst = self.empty_subst();
        defer subst.deinit(self.allocator);
        if try self.generic_call_subst(tree, target.name, function, target.type_arg, &var subst) |failed| {
            failed.deinit(self.allocator);
            return CalledFunction { name: target.name, function: function };
        }
        let instantiated = try self.instantiate_function_info(function, &subst);
        return CalledFunction { name: target.name, function: instantiated };
    }
    return null;
}

/// Is a recognized String byte-view initializer, the Go
/// `stringViewInitializer` result: the binding the view borrows, the field
/// path it names within it, and whether the view is writable.
pub struct StringView {
    pub target: BindingHandle,
    pub path: Name,
    pub mutable: bool
}

fn (self: &Checker) new_string_view() -> StringView {
    return StringView { target: self.scratch_binding, path: empty_name(), mutable: false };
}

/// Binds a local byte view and activates the String owner, the Go
/// `checkStringViewLetStmt`. The as_mut_bytes form takes an exclusive borrow
/// and requires a writable String binding (ADR-0096).
fn (self: &var Checker) check_string_view_let_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::LetStmt,
    view: StringView
) -> !?diagnostic::Diagnostic {
    if try self.check_string_view_initializer_shape(tree, statement.value) |failed| {
        return move failed;
    }
    let target = self.binding(view.target);
    if view.mutable and !target.mutable and !(target.borrowed_param and target.mut_borrow) {
        var kind = "String";
        if self.names.is_buffer_type(target.type_name) {
            kind = "buffer";
        }
        let kind_name = try self.names.intern(kind);
        return try self.error2(
            tree, ast::zero_span(), "string error: `%s.as_mut_bytes` requires mutable %s binding",
            Arg::Str(kind_name), Arg::Str(kind_name)
        );
    }
    if try self.check_borrow_conflict_for_field(tree, view.target, view.path, view.mutable) |failed| {
        return move failed;
    }
    try self.activate_borrow(view.target, view.path, view.mutable);
    let name = try self.names.intern_text(tree, statement.name);
    var value = self.store.new_binding(name, self.common.bytes_name);
    errdefer value.deinit(self.allocator);
    value.borrowed_param = true;
    value.local_borrow = true;
    try value.borrow_targets.append(self.allocator, BorrowSource { target: view.target, field: view.path });
    value.mut_borrow = view.mutable;
    let _ = try self.define(env, move value);
    return null;
}

/// Validates string.as_bytes() / as_mut_bytes() local view syntax, the Go
/// `checkStringViewInitializerShape`.
fn (self: &var Checker) check_string_view_initializer_shape(
    tree: &ast::Ast,
    expression: ast::Expression
) -> !?diagnostic::Diagnostic {
    let call = call_expr(tree, expression) orelse
        return try self.error0(ast::zero_span(), "string error: String view initializer must call String.as_bytes");
    let field = field_expr(tree, call.callee) orelse
        return try self.error0(ast::zero_span(), "string error: String view initializer must call String.as_bytes");
    if !text_equals(tree, field.name, "as_bytes") and !text_equals(tree, field.name, "as_mut_bytes") {
        return try self.error0(ast::zero_span(), "string error: String view initializer must call String.as_bytes");
    }
    let count = arg_count(tree, call.args);
    if count != 0 {
        return try self.error2(
            tree, ast::zero_span(), "string error: `String.%s` expects 0 args, got %d",
            Arg::Text(field.name), Arg::Int(count)
        );
    }
    return null;
}

/// Recognizes string.as_bytes() / as_mut_bytes() local byte-view
/// initializers, the Go `stringViewInitializer`, and reports the binding the
/// view borrows together with the field path it names within it. A `String`
/// reached through a field lends its bytes the way any other field path is
/// borrowed (ADR-0111): the borrow is tracked on the root binding under that
/// path, so the struct holding it is what the borrow conflicts with.
fn (self: &var Checker) string_view_initializer(
    tree: &ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var StringView
) -> !bool {
    let call = call_expr(tree, expression) orelse return false;
    let field = field_expr(tree, call.callee) orelse return false;
    if !text_equals(tree, field.name, "as_bytes") and !text_equals(tree, field.name, "as_mut_bytes") {
        return false;
    }
    let receiver = try self.view_receiver_path(tree, env, field.receiver) orelse return false;
    let target = receiver.root;
    if self.binding(target).moved {
        return false;
    }
    var viewed = self.binding(target).type_name;
    if !is_empty(receiver.path) {
        viewed = self.field_path_type(viewed, receiver.path) orelse return false;
    }
    if !self.names.is(viewed, "std::string::String") and !self.names.is_buffer_type(viewed) {
        return false;
    }
    out.target = target;
    out.path = receiver.path;
    out.mutable = text_equals(tree, field.name, "as_mut_bytes");
    return true;
}

/// Reads the local a view initializer borrows from, and the dotted field
/// path within it, the Go `viewReceiverPath`; a bare name is the path-less
/// case. The root is resolved here, so an unbound root reads as no path.
fn (self: &var Checker) view_receiver_path(
    tree: &ast::Ast,
    env: ScopeHandle,
    receiver: ast::Expression
) -> !?DirectFieldRoot {
    return self.direct_field_root(tree, env, receiver);
}

/// Is a recognized Box borrow initializer, the Go `boxBorrowInitializer`
/// result.
pub struct BoxBorrow {
    pub target: BindingHandle,
    pub field: Name,
    pub elem: Name,
    pub mutable: bool
}

fn (self: &Checker) new_box_borrow() -> BoxBorrow {
    return BoxBorrow { target: self.scratch_binding, field: empty_name(), elem: empty_name(), mutable: false };
}

/// Binds a Box payload borrow and activates the Box owner, the Go
/// `checkBoxBorrowLetStmt`.
fn (self: &var Checker) check_box_borrow_let_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::LetStmt,
    box: BoxBorrow
) -> !?diagnostic::Diagnostic {
    if box.mutable and !self.box_borrow_target_is_mutable(box.target, box.field) {
        return try self.error0(ast::zero_span(), "box error: `Box.borrow_mut` requires mutable Box receiver");
    }
    if try self.check_box_borrow_initializer_shape(tree, statement.value) |failed| {
        return move failed;
    }
    if try self.check_borrow_conflict_for_field(tree, box.target, box.field, box.mutable) |failed| {
        return move failed;
    }
    try self.activate_borrow(box.target, box.field, box.mutable);
    let name = try self.names.intern_text(tree, statement.name);
    var value = self.store.new_binding(name, box.elem);
    errdefer value.deinit(self.allocator);
    value.borrowed_param = true;
    value.local_borrow = true;
    try value.borrow_targets.append(self.allocator, BorrowSource { target: box.target, field: box.field });
    value.mut_borrow = box.mutable;
    let _ = try self.define(env, move value);
    return null;
}

/// Reports whether the target can produce a mutable Box view, the Go
/// `boxBorrowTargetIsMutable`.
fn (self: &Checker) box_borrow_target_is_mutable(target: BindingHandle, field: Name) -> bool {
    if !is_empty(field) {
        return self.binding(target).mutable;
    }
    return self.binding(target).mutable;
}

/// Validates Box.borrow/borrow_mut local borrow syntax, the Go
/// `checkBoxBorrowInitializerShape`.
fn (self: &var Checker) check_box_borrow_initializer_shape(
    tree: &ast::Ast,
    expression: ast::Expression
) -> !?diagnostic::Diagnostic {
    let call = call_expr(tree, expression) orelse
        return try self.error0(ast::zero_span(), "box error: Box borrow initializer must call Box.borrow");
    let field = field_expr(tree, call.callee) orelse
        return try self.error0(ast::zero_span(), "box error: Box borrow initializer must call Box.borrow");
    if !text_equals(tree, field.name, "borrow") and !text_equals(tree, field.name, "borrow_mut") {
        return try self.error0(ast::zero_span(), "box error: Box borrow initializer must call Box.borrow");
    }
    let count = arg_count(tree, call.args);
    if count != 0 {
        return try self.error2(
            tree, ast::zero_span(), "box error: `Box.%s` expects 0 args, got %d",
            Arg::Text(field.name), Arg::Int(count)
        );
    }
    return null;
}

/// Recognizes box.borrow/borrow_mut local borrow initializers, the Go
/// `boxBorrowInitializer`.
fn (self: &var Checker) box_borrow_initializer(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var BoxBorrow,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    let call = call_expr(tree, expression) orelse return null;
    let field = field_expr(tree, call.callee) orelse return null;
    if !text_equals(tree, field.name, "borrow") and !text_equals(tree, field.name, "borrow_mut") {
        return null;
    }
    var target = self.new_borrow_target();
    if try self.borrow_target(tree, env, field.receiver, &var target) |failed| {
        return move failed;
    }
    var type_name = empty_name();
    if try self.read_expr(tree, env, field.receiver, &var type_name) |failed| {
        return move failed;
    }
    let parts = try self.names.split_generic(type_name);
    var elem = empty_name();
    var is_box = false;
    if parts |generic| {
        is_box = self.names.is(generic.base, "std::mem::Box");
        elem = generic.args;
    }
    if !is_box {
        return try self.error1(tree, ast::zero_span(), "box error: `Box.%s` expects Box receiver", Arg::Text(field.name));
    }
    out.target = target.value;
    out.field = target.field;
    out.elem = elem;
    out.mutable = text_equals(tree, field.name, "borrow_mut");
    handled.* = true;
    return null;
}

/// Binds a local borrow and activates its owner until last use, the Go
/// `checkBorrowLetStmt`.
fn (self: &var Checker) check_borrow_let_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::LetStmt,
    borrow: ast::PrefixExpr
) -> !?diagnostic::Diagnostic {
    var target = self.new_borrow_target();
    if try self.borrow_target(tree, env, borrow.right, &var target) |failed| {
        return move failed;
    }
    let mutable = text_equals(tree, borrow.operator, "&var");
    if try self.check_borrow_conflict_for_field(tree, target.value, target.field, mutable) |failed| {
        return move failed;
    }
    var type_name = empty_name();
    if try self.read_expr(tree, env, borrow.right, &var type_name) |failed| {
        return move failed;
    }
    try self.activate_borrow(target.value, target.field, mutable);
    let name = try self.names.intern_text(tree, statement.name);
    var value = self.store.new_binding(name, type_name);
    errdefer value.deinit(self.allocator);
    value.borrowed_param = true;
    value.local_borrow = true;
    try value.borrow_targets.append(self.allocator, BorrowSource { target: target.value, field: target.field });
    value.mut_borrow = mutable;
    let _ = try self.define(env, move value);
    return null;
}

/// Is a resolved explicit borrow target: the binding and the field path
/// within it (empty for the whole value), the Go `borrowTarget` result.
pub struct BorrowTarget {
    pub value: BindingHandle,
    pub field: Name
}

/// Returns a borrow target to fill in; its value is the scratch binding
/// until a resolver replaces it.
fn (self: &Checker) new_borrow_target() -> BorrowTarget {
    return BorrowTarget { value: self.scratch_binding, field: empty_name() };
}

/// Resolves an explicit borrow target, the Go `borrowTarget`.
fn (self: &var Checker) borrow_target(
    tree: &ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var BorrowTarget
) -> !?diagnostic::Diagnostic {
    if ident_expr(tree, expression) |ident| {
        let value = self.lookup_text(tree, env, ident.name) orelse
            return try self.error1(tree, ident.span, "borrow error: undefined variable `%s`", Arg::Text(ident.name));
        if try self.check_deinitialized_borrow(tree, ident.name, value, ident.span) |failed| {
            return move failed;
        }
        if self.binding(value).moved {
            return try self.error1(tree, ident.span, "borrow error: moved value `%s` was borrowed", Arg::Text(ident.name));
        }
        out.value = value;
        out.field = empty_name();
        return null;
    }
    let field = field_expr(tree, expression) orelse
        return try self.error0(ast::zero_span(), "borrow error: borrow target must be a local binding or field path");
    let path = try ast::field_path_root(self.allocator, tree, expression) orelse
        return try self.error0(field.span, "borrow error: borrow target must be a local binding or field path");
    let path_name = try self.names.intern_owned(move path.path);
    let ident = path.root;
    let value = self.lookup_text(tree, env, ident.name) orelse
        return try self.error1(tree, ident.span, "borrow error: undefined variable `%s`", Arg::Text(ident.name));
    if try self.check_deinitialized_borrow(tree, ident.name, value, ident.span) |failed| {
        return move failed;
    }
    if self.binding(value).moved {
        return try self.error1(tree, ident.span, "borrow error: moved value `%s` was borrowed", Arg::Text(ident.name));
    }
    if try self.overlapping_field_deinit(value, path_name) |deinit| {
        return try self.error2(
            tree, field.span, "move error: field `%s.%s` was deinitialized",
            Arg::Text(ident.name), Arg::Str(deinit)
        );
    }
    out.value = value;
    out.field = path_name;
    return null;
}

/// Reports whether an expression is &T or &var T syntax, the Go
/// `borrowPrefix`.
pub fn borrow_prefix(tree: &ast::Ast, expression: ast::Expression) -> ?ast::PrefixExpr {
    let prefix = prefix_expr(tree, expression) orelse return null;
    if !text_equals(tree, prefix.operator, "&") and !text_equals(tree, prefix.operator, "&var") {
        return null;
    }
    return prefix;
}
