import compiler::internal::ast;
import compiler::internal::diagnostic;
import std::array;
import std::mem;

// Port of the expression read / move entry points of internal/ownership/
// checker.go: readExpr, moveExpr, the if / match / block value forms, the
// binary and contextual reads, and the try / pointer / struct literal reads.

/// Checks an expression without consuming owned values, the Go `readExpr`.
fn (self: &var Checker) read_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if transparent_expr_value(tree, expression) |inner| {
        return self.read_expr(tree, env, inner, out);
    }
    match tree.expressions.at(expression.node) {
        Int(_) => {
            out.* = self.common.i64_name;
            return null;
        },
        String(_) => {
            out.* = self.common.bytes_name;
            return null;
        },
        Bool(_) => {
            out.* = self.common.bool_name;
            return null;
        },
        Type(_) => {
            out.* = self.common.type_value_name;
            return null;
        },
        Null(_) => {
            out.* = self.common.null_name;
            return null;
        },
        BufferLiteral(value) => {
            let text = try value.type_text(self.allocator);
            out.* = try self.names.intern_owned(move text);
            return null;
        },
        Comptime(value) => return self.read_comptime_only(tree, value.expr, out),
        Ident(value) => {
            let copied = value;
            return self.read_ident_expr(tree, env, copied, out);
        },
        Binary(value) => {
            let copied = value;
            return self.read_binary_expr(tree, env, copied, out);
        },
        Call(value) => {
            let copied = value;
            return self.check_call(tree, env, expression, copied, out);
        },
        Cast(value) => {
            let copied = value;
            return self.read_cast_expr(tree, env, copied, out);
        },
        Try(value) => {
            let copied = value;
            return self.read_try_expr(tree, env, expression, copied, out);
        },
        Index(value) => {
            let copied = value;
            return self.read_index_expr(tree, env, copied, out);
        },
        StructLiteral(_) => return self.read_struct_literal_expr(tree, env, expression, out),
        Field(value) => {
            let copied = value;
            return self.read_field_expr(tree, env, copied, out);
        },
        Deref(value) => {
            let copied = value;
            return self.read_deref_expr(tree, env, copied, out);
        },
        _ => return self.read_control_expr(tree, env, expression, out),
    }
}

/// Reads an identifier: a type argument in scope reads as `type`, anything
/// else as the local it names.
fn (self: &var Checker) read_ident_expr(
    tree: &ast::Ast,
    env: ScopeHandle,
    ident: ast::IdentExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if self.type_arg_value_text(tree, ident.name) |_| {
        out.* = self.common.type_value_name;
        return null;
    }
    return self.read_ident(tree, env, ident, out);
}

/// Returns the type bound to a generic type parameter in the active
/// instantiation, the Go `c.typeArgValues[name]`.
fn (self: &Checker) type_arg_value_text(tree: &ast::Ast, text: ast::Text) -> ?Name {
    let retained = tree.texts.at(text.node);
    let bytes = retained.as_bytes();
    return self.type_arg_values.get(bytes);
}

/// Checks control flow expressions without consuming owned values, the Go
/// `readControlExpr`.
fn (self: &var Checker) read_control_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if if_expr(tree, expression) |value| {
        return self.check_if_expr_value(tree, env, expression, value, false, out);
    }
    if is_match_expr(tree, expression) {
        return self.check_match_expr_value(tree, env, expression, false, out);
    }
    if orelse_guard_expr(tree, expression) |value| {
        return self.read_orelse_guard_expr(tree, env, value, out);
    }
    if catch_guard_expr(tree, expression) |value| {
        return self.read_catch_guard_expr(tree, env, value, out);
    }
    if move_expr(tree, expression) |value| {
        // The name is interned before the call: a `&self` receiver travels as
        // a copy, so a name retained while the arguments are read would land
        // in a table the copy does not have (ADR-0131).
        let rendered = try self.names.intern_expression(tree, value.value);
        return try self.error1(
            tree, value.span, "move error: `move` marks a hand-off, and `%s` is only read here",
            Arg::Str(rendered)
        );
    }
    return try self.error0(ast::zero_span(), "move error: unsupported expression *ast.RecoveredExpr");
}

/// Reads `cond orelse return/break/continue`, the Go `readOrelseGuardExpr`.
/// The null arm is a real exit, so it carries the matching statement's
/// obligations, checked in a clone: the fall-through path did not take the
/// exit, so nothing the exit consumes may look moved after the guard.
fn (self: &var Checker) read_orelse_guard_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    guard: ast::OrelseGuardExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    let pending = self.pending_owner_temps.len();
    var cond_type = empty_name();
    if try self.read_expr(tree, env, guard.condition, &var cond_type) |failed| {
        return move failed;
    }
    if try self.refuse_container_view_orelse(tree, env, cond_type, guard.condition) |failed| {
        return move failed;
    }
    if try self.check_no_pending_owner_temps(
        tree, pending, "orelse", expression_span(tree, guard.condition), guard.condition
    ) |failed| {
        return move failed;
    }
    if try self.check_guard_exit(tree, env, guard.exit, pending) |failed| {
        return move failed;
    }
    out.* = try self.names.optional_payload_name(cond_type);
    return null;
}

/// Reads `cond catch return/break/continue`, the Go `readCatchGuardExpr`.
/// The failure arm is a real exit like an orelse guard's null arm: it
/// carries the matching statement's obligations, checked in a clone so
/// nothing it consumes looks moved on the fall-through path. The handled
/// failure is not an error return path, so no errdefer obligations attach
/// here.
fn (self: &var Checker) read_catch_guard_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    guard: ast::CatchGuardExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    let pending = self.pending_owner_temps.len();
    var cond_type = empty_name();
    if try self.read_expr(tree, env, guard.condition, &var cond_type) |failed| {
        return move failed;
    }
    if try self.check_no_pending_owner_temps(
        tree, pending, "catch", expression_span(tree, guard.condition), guard.condition
    ) |failed| {
        return move failed;
    }
    if try self.check_guard_exit(tree, env, guard.exit, pending) |failed| {
        return move failed;
    }
    if try self.names.error_union_parts(cond_type) |parts| {
        out.* = parts.success;
        return null;
    }
    out.* = cond_type;
    return null;
}

/// Reads checked byte indexing and slicing without moving bytes, the Go
/// `readIndexExpr`.
fn (self: &var Checker) read_index_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    index: ast::IndexExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var target = empty_name();
    if try self.read_expr(tree, env, index.target, &var target) |failed| {
        return move failed;
    }
    if !self.names.is(target, "[]u8") {
        return try self.error1(
            tree, ast::zero_span(), "move error: index/slice target expects []u8, got %s",
            Arg::Str(target)
        );
    }
    var ignored = empty_name();
    if !index.slice {
        if index.index |present| {
            if try self.read_expr(tree, env, present, &var ignored) |failed| {
                return move failed;
            }
        }
        out.* = self.common.u8_name;
        return null;
    }
    if index.start |present| {
        if try self.read_expr(tree, env, present, &var ignored) |failed| {
            return move failed;
        }
    }
    if index.end |present| {
        if try self.read_expr(tree, env, present, &var ignored) |failed| {
            return move failed;
        }
    }
    out.* = target;
    return null;
}

/// Reads expr and treats fit-checked integer literals as want, the Go
/// `readContextualExpr`.
fn (self: &var Checker) read_contextual_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    want: Name,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var got = empty_name();
    if try self.read_expr(tree, env, expression, &var got) |failed| {
        return move failed;
    }
    return self.coerce_contextual_literal(tree, expression, want, got, out);
}

/// Moves expr and treats fit-checked integer literals as want, the Go
/// `moveContextualExpr`.
fn (self: &var Checker) move_contextual_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    want: Name,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var got = empty_name();
    if try self.move_expr(tree, env, expression, &var got) |failed| {
        return move failed;
    }
    return self.coerce_contextual_literal(tree, expression, want, got, out);
}

/// Narrows only source integer literals, the Go
/// `coerceContextualIntegerLiteral`.
fn (self: &var Checker) coerce_contextual_literal(
    tree: &ast::Ast,
    expression: ast::Expression,
    want: Name,
    got: Name,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    out.* = got;
    if same_name(got, want) or !self.names.is(got, "i64") or !self.names.is_integer_type(want) {
        return null;
    }
    let value = integer_literal_value(tree, expression) orelse return null;
    if !self.integer_literal_fits_type(value, want) {
        let rendered = try self.names.intern_expression(tree, expression);
        return try self.error2(
            tree, ast::zero_span(), "move error: integer literal `%s` does not fit %s",
            Arg::Str(rendered), Arg::Str(want)
        );
    }
    out.* = want;
    return null;
}

/// Returns an interpreter-representable integer literal, the Go
/// `integerLiteralValue`.
pub fn integer_literal_value(tree: &ast::Ast, expression: ast::Expression) -> ?i64 {
    if int_expr(tree, expression) |literal| {
        let retained = tree.texts.at(literal.value.node);
        let bytes = retained.as_bytes();
        return decimal_i64(bytes);
    }
    let prefix = prefix_expr(tree, expression) orelse return null;
    if !text_equals(tree, prefix.operator, "-") {
        return null;
    }
    let value = integer_literal_value(tree, prefix.right) orelse return null;
    return 0 - value;
}

/// Parses a decimal literal into i64, the Go `strconv.ParseInt(text, 10, 64)`.
pub fn decimal_i64(text: []u8) -> ?i64 {
    if mem::len(text) == 0 {
        return null;
    }
    var value = 0;
    var index = 0;
    while index < mem::len(text) {
        let byte = text[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return null;
        }
        let digit = cast<i64>(byte - cast<u8>(48));
        if value > (9223372036854775807 - digit) / 10 {
            return null;
        }
        value = value * 10 + digit;
        index = index + 1;
    }
    return value;
}

/// Checks the fixed-width bounds for contextual literals, the Go
/// `integerLiteralFitsType`.
fn (self: &Checker) integer_literal_fits_type(value: i64, type_name: Name) -> bool {
    if self.names.is(type_name, "i8") {
        return value >= -128 and value <= 127;
    }
    if self.names.is(type_name, "i16") {
        return value >= -32768 and value <= 32767;
    }
    if self.names.is(type_name, "i32") {
        return value >= -2147483648 and value <= 2147483647;
    }
    if self.names.is(type_name, "i64") or self.names.is(type_name, "isize") {
        return true;
    }
    if self.names.is(type_name, "u8") {
        return value >= 0 and value <= 255;
    }
    if self.names.is(type_name, "u16") {
        return value >= 0 and value <= 65535;
    }
    if self.names.is(type_name, "u32") {
        return value >= 0 and value <= 4294967295;
    }
    if self.names.is(type_name, "u64") or self.names.is(type_name, "usize") {
        return value >= 0;
    }
    return false;
}

/// Reads the source value and returns the explicit target type, the Go
/// `readCastExpr`.
fn (self: &var Checker) read_cast_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    cast: ast::CastExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var ignored = empty_name();
    if try self.read_expr(tree, env, cast.value, &var ignored) |failed| {
        return move failed;
    }
    out.* = try self.names.intern_type(tree, cast.target_type);
    return null;
}

/// Checks an expression in a move context and enforces the `move` marker,
/// the Go `moveExpr`. A hand-off from a named place carries the marker: that
/// is where the obligation leaves the place, and where an errdefer covering
/// it retires (ADR-0114). A temporary has no place to leave, so it carries
/// no marker.
fn (self: &var Checker) move_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var place = expression;
    var marker_span = ast::zero_span();
    var has_marker = false;
    if move_expr(tree, expression) |marker| {
        place = marker.value;
        marker_span = marker.span;
        has_marker = true;
    }
    var handed_off = false;
    if try self.move_place_expr(tree, env, place, &var handed_off, out) |failed| {
        return move failed;
    }
    if handed_off {
        // The value has left its place and reached nothing yet: until the
        // call or literal takes it, only this statement holds it. A whole
        // binding keeps its storage until then, so an exit can still release
        // it; a field taken out of a value has no cleanup of its own left.
        if self.moved_place_binding(tree, env, place) |value| {
            try self.pending_moved_places.append(self.allocator, value);
        } else {
            try self.pending_owner_temps.append(self.allocator, place);
        }
    }
    if has_marker and !handed_off {
        if !try self.is_copy_place(tree, env, place) {
            let rendered = try self.names.intern_expression(tree, place);
            return try self.error1(
                tree, marker_span,
                "move error: `move` marks a hand-off from a named place, and `%s` is not one",
                Arg::Str(rendered)
            );
        }
        // A generic body is one source line per instantiation. The owner one
        // hands off and needs the marker, so the copy one accepts it rather
        // than making the function unwritable.
        if !self.in_generic_function() {
            let rendered = try self.names.intern_expression(tree, place);
            return try self.error1(
                tree, marker_span, "move error: `%s` is copy data and hands nothing off",
                Arg::Str(rendered)
            );
        }
    }
    // A compile-time expansion has no source line for an author to write on,
    // so the marker is required only where source exists. The generator
    // writes it on the fields it knows own something (ast.ConstructExpansion);
    // the rest of the expansion is checked like any other move.
    let span = expression_span(tree, place);
    if !has_marker and handed_off and !span.is_zero() {
        if !self.collect_missing_markers {
            let rendered = try self.names.intern_expression(tree, place);
            return try self.error2(
                tree, span, "move error: `%s` is handed off here; write `move %s`",
                Arg::Str(rendered), Arg::Str(rendered)
            );
        }
        try self.missing_markers.append(self.allocator, span);
    }
    return null;
}

/// Reports whether the body being checked defers a type to its
/// instantiation, the Go `inGenericFunction`, so whether a place hands off is
/// not fixed by this source.
fn (self: &Checker) in_generic_function() -> bool {
    let function = self.current_function orelse return false;
    let info = self.functions.at(function.index);
    return info.static_params.len() > 0;
}

/// Reports whether expr names a binding whose type copies, the Go
/// `isCopyPlace`, so a `move` marker on it can say that rather than that it
/// found no place.
fn (self: &var Checker) is_copy_place(tree: &ast::Ast, env: ScopeHandle, expression: ast::Expression) -> !bool {
    let value = self.lookup_ident(tree, env, expression) orelse return false;
    return self.is_copy_type(self.binding(value).type_name);
}

/// Consumes a non-copy identifier when present and reports whether the
/// value was handed off from a named place, the Go `movePlaceExpr`.
fn (self: &var Checker) move_place_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    handed_off: &var bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    handed_off.* = false;
    if field_expr(tree, expression) |field| {
        if !field.namespace {
            // A field of a value the frame holds is a place too: taking it
            // out hands the obligation on, so it is marked like any other
            // hand-off.
            if try self.move_field_expr(tree, env, field, out) |failed| {
                return move failed;
            }
            handed_off.* = !try self.is_copy_type(out.*);
            return null;
        }
    }
    let ident = ident_expr(tree, expression) orelse return self.move_non_ident_expr(tree, env, expression, out);
    if self.lookup_text(tree, env, ident.name) |value| {
        return self.move_bound_ident(tree, env, ident, value, self.returned_view(expression), handed_off, out);
    }
    if text_equals(tree, ident.name, "void") {
        return try self.error0(ident.span, "move error: void is not a value");
    }
    // A top-level function's name is a function pointer value: it owns
    // nothing, and the code it names outlives the program.
    let candidate = try self.names.intern_text(tree, ident.name);
    if try self.function_pointer_name(candidate) |pointer| {
        out.* = pointer;
        return null;
    }
    return try self.error1(tree, ident.span, "move error: undefined variable `%s`", Arg::Text(ident.name));
}

// Consumes one bound identifier in a move context: the named-place half of
// the Go `movePlaceExpr`.
fn (self: &var Checker) move_bound_ident(
    tree: &var ast::Ast,
    env: ScopeHandle,
    ident: ast::IdentExpr,
    value: BindingHandle,
    returned: bool,
    handed_off: &var bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if try self.check_deinitialized_use(tree, env, ident.name, value, ident.span) |failed| {
        return move failed;
    }
    if self.binding(value).moved {
        return try self.error1(tree, ident.span, "move error: moved value `%s` was used", Arg::Text(ident.name));
    }
    if self.binding(value).borrowed_param and !returned {
        return try self.error1(tree, ident.span, "borrow error: borrowed value `%s` cannot escape", Arg::Text(ident.name));
    }
    if self.tied_struct_return(self.binding(value).type_name) and self.has_borrow_targets(value) {
        if self.task_set_return(self.binding(value).type_name) {
            return try self.error1(
                tree, ident.span,
                "borrow error: TaskSet `%s` cannot outlive its Io or allocator",
                Arg::Text(ident.name)
            );
        }
        return try self.error1(
            tree, ident.span,
            "borrow error: borrowed value `%s` cannot escape",
            Arg::Text(ident.name)
        );
    }
    if self.alloc_tied(value) {
        return try self.error1(
            tree, ident.span,
            "borrow error: value `%s` is allocated from a tied allocator and cannot escape its frame",
            Arg::Text(ident.name)
        );
    }
    let type_name = self.binding(value).type_name;
    if self.store.has_any_borrow(value) and !try self.is_copy_type(type_name) {
        return try self.error1(
            tree, ident.span, "borrow error: value `%s` cannot be moved while borrowed", Arg::Text(ident.name)
        );
    }
    if try self.partially_consumed_field(value) |field| {
        return try self.error3(
            tree, ident.span,
            "move error: field `%s.%s` is already consumed, so `%s` cannot be handed on whole",
            Arg::Text(ident.name), Arg::Str(field), Arg::Text(ident.name)
        );
    }
    out.* = type_name;
    if try self.is_copy_type(type_name) {
        return null;
    }
    try self.store.set_moved(value, true);
    handed_off.* = true;
    return null;
}

/// Handles move contexts for compound expressions, the Go `moveNonIdentExpr`.
fn (self: &var Checker) move_non_ident_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if deref_expr(tree, expression) |deref| {
        return self.move_deref_expr(tree, env, expression, deref, out);
    }
    if try self.is_arena_at_expr(tree, env, expression) {
        if try self.read_expr(tree, env, expression, out) |failed| {
            return move failed;
        }
        if try self.is_copy_type(out.*) {
            return null;
        }
        return try self.error0(expression_span(tree, expression), "arena error: Arena.at returns &T and cannot be moved");
    }
    if is_struct_literal_expr(tree, expression) {
        return self.move_struct_literal_expr(tree, env, expression, out);
    }
    if field_expr(tree, expression) |field| {
        if field.namespace {
            return self.read_field_expr(tree, env, field, out);
        }
        return self.move_field_expr(tree, env, field, out);
    }
    if if_expr(tree, expression) |value| {
        return self.check_if_expr_value(tree, env, expression, value, true, out);
    }
    if is_match_expr(tree, expression) {
        return self.check_match_expr_value(tree, env, expression, true, out);
    }
    if try self.read_expr(tree, env, expression, out) |failed| {
        return move failed;
    }
    return self.refuse_view_escape(tree, env, expression, out.*);
}

/// Rejects handing a view still backed by a local borrow to a consumer that
/// may keep it, as moving the borrow binding itself is refused, the Go
/// `refuseViewEscape`: the storage the view points into ends with the frame.
fn (self: &var Checker) refuse_view_escape(
    tree: &ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    type_name: Name
) -> !?diagnostic::Diagnostic {
    if !self.names.is(type_name, "[]u8") or self.returned_view(expression) {
        return null;
    }
    let root = try self.borrow_class_view_root(tree, env, expression) orelse return null;
    return try self.error1(
        tree, expression_span(tree, expression),
        "borrow error: borrowed value `%s` cannot escape",
        Arg::Str(self.binding(root).name)
    );
}

/// Reports whether expression is one the return being checked hands out on
/// its parameter ties, the Go `c.returnedViews[expr]`.
fn (self: &Checker) returned_view(expression: ast::Expression) -> bool {
    var index = 0;
    while self.returned_views.get(index) |known| {
        if known.node == expression.node {
            return true;
        }
        index = index + 1;
    }
    return false;
}

/// Merges possible branch moves from an if expression, the Go
/// `checkIfExprValue`; move_tail selects the move or read form of the tails.
fn (self: &var Checker) check_if_expr_value(
    tree: &var ast::Ast,
    env: ScopeHandle,
    producer: ?ast::Expression,
    statement: ast::IfStmt,
    move_tail: bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    // One branch runs: what the first produces is not live in the second,
    // and what the expression as a whole hands on is one value.
    let pending = self.pending_owner_temps.len();
    let places = self.pending_moved_places.len();
    var ignored = empty_name();
    if try self.read_expr(tree, env, statement.condition, &var ignored) |failed| {
        return move failed;
    }
    let alternative = statement.alternative orelse
        return try self.error0(ast::zero_span(), "move error: if expression requires else branch");
    try self.settle_owner_temps(pending, places, self.common.void_name, null);
    let left = try self.store.clone_scope(env);
    var left_type = empty_name();
    let left_child = try self.store.child(left);
    if try self.check_value_block(tree, left_child, statement.consequence, move_tail, &var left_type) |failed| {
        return move failed;
    }
    try self.settle_owner_temps(pending, places, self.common.void_name, null);
    let right = try self.store.clone_scope(env);
    var right_type = empty_name();
    let right_child = try self.store.child(right);
    if try self.check_value_block(tree, right_child, alternative, move_tail, &var right_type) |failed| {
        return move failed;
    }
    if !same_name(left_type, right_type) {
        return try self.error2(
            tree, ast::zero_span(), "move error: if expression branch types differ: %s vs %s",
            Arg::Str(left_type), Arg::Str(right_type)
        );
    }
    try self.settle_owner_temps(pending, places, left_type, producer);
    try self.store.merge_moved_from(env, left);
    try self.store.merge_moved_from(env, right);
    out.* = left_type;
    return null;
}

/// Merges possible arm moves from a match expression, the Go
/// `checkMatchExprValue`.
fn (self: &var Checker) check_match_expr_value(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    move_tail: bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    let head = match_expr_head(tree, expression) orelse return null;
    // One arm runs: what the value produced is held by the arm that binds
    // it, what one arm produces is not live in the next, and what the
    // expression as a whole hands on is one value.
    let pending = self.pending_owner_temps.len();
    let places = self.pending_moved_places.len();
    var value_type = empty_name();
    if try self.read_expr(tree, env, head.value, &var value_type) |failed| {
        return move failed;
    }
    value_type = try self.names.borrowed_value(value_type);
    let tags = try self.match_tags(value_type) orelse
        return try self.error1(tree, ast::zero_span(), "move error: match expects enum or union, got %s", Arg::Str(value_type));
    let owned_match = try self.match_scrutinee_owned(tree, env, head.value);
    let arms = try match_expr_arms(self.allocator, tree, expression);
    defer arms.deinit(self.allocator);
    if try self.consume_moved_from_scrutinee(tree, env, head.value, &arms, tags) |failed| {
        return move failed;
    }
    let span = expression_span(tree, head.value);
    var result = empty_name();
    var index = 0;
    while arms.get(index) |arm| {
        try self.settle_owner_temps(pending, places, self.common.void_name, null);
        var got = empty_name();
        if try self.check_match_expr_arm_value(tree, env, arm, tags, owned_match, span, move_tail, &var got) |failed| {
            return move failed;
        }
        if index == 0 {
            result = got;
        } else {
            if !same_name(got, result) {
                return try self.error2(
                    tree, ast::zero_span(), "move error: match arm types differ: %s vs %s",
                    Arg::Str(result), Arg::Str(got)
                );
            }
        }
        index = index + 1;
    }
    try self.settle_owner_temps(pending, places, result, expression);
    out.* = result;
    return null;
}

/// Checks one arm and merges its possible moves, the Go
/// `checkMatchExprArmValue`.
fn (self: &var Checker) check_match_expr_arm_value(
    tree: &var ast::Ast,
    env: ScopeHandle,
    arm: ast::MatchArm,
    tags: MatchTags,
    owned_match: bool,
    span: ast::Span,
    move_tail: bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if arm.is_wildcard(tree) {
        if !text_empty(tree, arm.binding) {
            return try self.error0(ast::zero_span(), "move error: wildcard match arm cannot bind payload");
        }
    } else {
        if !self.match_arm_tag_known(tree, tags, arm) {
            return try self.error1(tree, ast::zero_span(), "move error: unknown match tag `%s`", Arg::Text(arm.tag));
        }
    }
    let arm_env = try self.store.clone_scope(env);
    let child = try self.store.child(arm_env);
    try self.define_match_arm_payload(tree, arm, tags, false, owned_match, child, span);
    if try self.check_value_stmt(tree, child, arm.body, move_tail, out) |failed| {
        return move failed;
    }
    if try self.check_arm_payload_consumed(tree, arm, child) |failed| {
        return move failed;
    }
    try self.store.merge_moved_from(env, arm_env);
    return null;
}

/// Checks a branch block used in expression position, the Go
/// `checkBlockValue`.
fn (self: &var Checker) check_value_block(
    tree: &var ast::Ast,
    env: ScopeHandle,
    block: ast::Block,
    move_tail: bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if block_len(tree, block) == 0 {
        return try self.error0(ast::zero_span(), "move error: expression block must end with a value");
    }
    let err_defer_mark = self.live_err_defers.len();
    if try self.check_block_value_statements(tree, env, block, move_tail, out) |failed| {
        self.restore_err_defers(err_defer_mark);
        return move failed;
    }
    self.restore_err_defers(err_defer_mark);
    return null;
}

fn (self: &var Checker) check_block_value_statements(
    tree: &var ast::Ast,
    env: ScopeHandle,
    block: ast::Block,
    move_tail: bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var last_uses = try block_last_uses(self.allocator, tree, block);
    defer last_uses.deinit(self.allocator);
    var defers = array::new<ast::Expression>(self.allocator);
    defer defers.deinit(self.allocator);
    let binding_mark = self.store.id_mark();
    let last_index = block_len(tree, block) - 1;
    // Each statement starts from what the enclosing expression held pending,
    // as in check_block_statements; the tail value is what the block itself
    // hands on.
    let pending_mark = self.pending_owner_temps.len();
    let places_mark = self.pending_moved_places.len();
    var index = 0;
    while index < last_index {
        self.truncate_owner_temps(pending_mark);
        self.truncate_moved_places(places_mark);
        let statement = block_statement_at(tree, block, index) orelse break;
        if defer_stmt(tree, statement) |deferred| {
            if try self.check_defer_stmt(tree, env, deferred) |failed| {
                return move failed;
            }
            try defers.append(self.allocator, deferred.expr);
            try self.release_last_use_borrows(env, index, &last_uses);
            index = index + 1;
            continue;
        }
        if errdefer_stmt(tree, statement) |deferred| {
            if try self.check_err_defer_stmt(tree, env, deferred) |failed| {
                return move failed;
            }
            try self.release_last_use_borrows(env, index, &last_uses);
            index = index + 1;
            continue;
        }
        if try self.check_stmt(tree, env, statement) |failed| {
            return move failed;
        }
        try self.release_last_use_borrows(env, index, &last_uses);
        index = index + 1;
    }
    self.truncate_owner_temps(pending_mark);
    self.truncate_moved_places(places_mark);
    let last = block_statement_at(tree, block, last_index) orelse return null;
    if try self.check_value_stmt(tree, env, last, move_tail, out) |failed| {
        return move failed;
    }
    try self.release_last_use_borrows(env, last_index, &last_uses);
    if try self.check_deferred_cleanups(tree, env, &defers) |failed| {
        return move failed;
    }
    return self.check_owners_consumed(tree, env, binding_mark, plain_exit());
}

/// Checks a value-producing tail statement, the Go `checkStmtValue`.
fn (self: &var Checker) check_value_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::Statement,
    move_tail: bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if expr_stmt(tree, statement) |value| {
        if value.semicolon {
            return try self.error0(ast::zero_span(), "move error: expression block must end with a value");
        }
        if move_tail {
            return self.move_expr(tree, env, value.expr, out);
        }
        return self.read_expr(tree, env, value.expr, out);
    }
    if if_stmt(tree, statement) |value| {
        // A statement-form `if` ending a value block has no expression node
        // of its own to stand as the producer; its value is what the block
        // hands on, and the block's reader records that.
        return self.check_if_expr_value(tree, env, null, value, move_tail, out);
    }
    if is_match_stmt(tree, statement) {
        return self.check_match_expr_value_stmt(tree, env, statement, move_tail, out);
    }
    if is_block_stmt(tree, statement) {
        return self.check_value_block(tree, env, ast::Block { node: statement.node }, move_tail, out);
    }
    return try self.error0(ast::zero_span(), "move error: expression block must end with a value");
}

/// Checks a match statement standing as the value of an expression block,
/// reading its arms through the statement arena.
fn (self: &var Checker) check_match_expr_value_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::Statement,
    move_tail: bool,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    let head = match_stmt_head(tree, statement) orelse return null;
    var value_type = empty_name();
    if try self.read_expr(tree, env, head.value, &var value_type) |failed| {
        return move failed;
    }
    value_type = try self.names.borrowed_value(value_type);
    let tags = try self.match_tags(value_type) orelse
        return try self.error1(tree, ast::zero_span(), "move error: match expects enum or union, got %s", Arg::Str(value_type));
    let owned_match = try self.match_scrutinee_owned(tree, env, head.value);
    let arms = try match_stmt_arms(self.allocator, tree, statement);
    defer arms.deinit(self.allocator);
    if try self.consume_moved_from_scrutinee(tree, env, head.value, &arms, tags) |failed| {
        return move failed;
    }
    let span = expression_span(tree, head.value);
    var result = empty_name();
    var index = 0;
    while arms.get(index) |arm| {
        var got = empty_name();
        if try self.check_match_expr_arm_value(tree, env, arm, tags, owned_match, span, move_tail, &var got) |failed| {
            return move failed;
        }
        if index == 0 {
            result = got;
        } else {
            if !same_name(got, result) {
                return try self.error2(
                    tree, ast::zero_span(), "move error: match arm types differ: %s vs %s",
                    Arg::Str(result), Arg::Str(got)
                );
            }
        }
        index = index + 1;
    }
    out.* = result;
    return null;
}

/// Rejects moving non-copy values out through checked borrows, the Go
/// `moveDerefExpr`.
fn (self: &var Checker) move_deref_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    deref: ast::DerefExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var handled = false;
    if try self.raw_pointer_deref_expr_type(tree, env, deref, &var handled, out) |failed| {
        return move failed;
    }
    if handled {
        return null;
    }
    if try self.read_deref_expr(tree, env, deref, out) |failed| {
        return move failed;
    }
    if try self.is_copy_type(out.*) {
        return self.refuse_view_escape(tree, env, expression, out.*);
    }
    let rendered = try self.names.intern_expression(tree, deref.receiver);
    return try self.error1(
        tree, ast::zero_span(), "borrow error: value `%s` cannot be moved out of borrow",
        Arg::Str(rendered)
    );
}

/// Reads both operands and returns the operator result type, the Go
/// `readBinaryExpr`.
fn (self: &var Checker) read_binary_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    binary: ast::BinaryExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var left = empty_name();
    if try self.read_expr(tree, env, binary.left, &var left) |failed| {
        return move failed;
    }
    if text_equals(tree, binary.operator, "orelse") {
        if try self.refuse_container_view_orelse(tree, env, left, binary.left) |failed| {
            return move failed;
        }
        return self.read_orelse_default(tree, env, left, binary.right, out);
    }
    if text_equals(tree, binary.operator, "catch") {
        return self.read_catch_default(tree, env, left, binary.right, out);
    }
    var ignored = empty_name();
    if try self.read_expr(tree, env, binary.right, &var ignored) |failed| {
        return move failed;
    }
    if text_equals(tree, binary.operator, "and") or text_equals(tree, binary.operator, "or") {
        out.* = self.common.bool_name;
        return null;
    }
    if is_boolean_binary_operator(tree, binary.operator) {
        out.* = self.common.bool_name;
        return null;
    }
    out.* = left;
    return null;
}

/// Reads the default arm of `orelse`, the Go `readOrelseDefault`. The
/// default stands in for the payload, so when the payload carries a deinit
/// contract the default is a competing owner producer and must be moved, not
/// aliased.
fn (self: &var Checker) read_orelse_default(
    tree: &var ast::Ast,
    env: ScopeHandle,
    left: Name,
    right: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    let elem = try self.names.optional_payload_name(left);
    var ignored = empty_name();
    if try self.value_type_needs_consume(self.allocator, elem) {
        if try self.move_expr(tree, env, right, &var ignored) |failed| {
            return move failed;
        }
        out.* = elem;
        return null;
    }
    if try self.read_expr(tree, env, right, &var ignored) |failed| {
        return move failed;
    }
    out.* = elem;
    return null;
}

/// Reads the default arm of `catch`, the Go `readCatchDefault`. The default
/// stands in for the success payload the same way an `orelse` default stands
/// in for the optional payload, so an owner payload makes it a competing
/// producer.
fn (self: &var Checker) read_catch_default(
    tree: &var ast::Ast,
    env: ScopeHandle,
    left: Name,
    right: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var elem = left;
    if try self.names.error_union_parts(left) |parts| {
        elem = parts.success;
    }
    var ignored = empty_name();
    if try self.value_type_needs_consume(self.allocator, elem) {
        if try self.move_expr(tree, env, right, &var ignored) |failed| {
            return move failed;
        }
        out.* = elem;
        return null;
    }
    if try self.read_expr(tree, env, right, &var ignored) |failed| {
        return move failed;
    }
    out.* = elem;
    return null;
}

/// Reports whether a binary operator returns bool, the Go
/// `isBooleanBinaryOperator`.
fn is_boolean_binary_operator(tree: &ast::Ast, operator: ast::Text) -> bool {
    return text_equals(tree, operator, "==") or text_equals(tree, operator, "!=") or
        text_equals(tree, operator, "<") or text_equals(tree, operator, "<=") or
        text_equals(tree, operator, ">") or text_equals(tree, operator, ">=");
}

/// Reads a !T expression and returns T, the Go `readTryExpr`.
/// Reports whether a value of this type, held by nothing but the expression
/// that produced it, is one an early exit would drop, the Go
/// `producesOwnerTemp`: an owner, bare or inside the `?T` / `E!T` wrapper its
/// producer returns.
fn (self: &var Checker) produces_owner_temp(type_name: Name) -> !bool {
    var elem = type_name;
    if try self.wrapped_payload_elem(type_name) |wrapped| {
        elem = wrapped.elem;
    }
    return self.value_type_needs_consume(self.allocator, elem);
}

/// Refuses an exit that can be taken while the enclosing statement still
/// holds owners nothing has bound, the Go `checkNoPendingOwnerTemps`: the
/// exit would drop them, and the value's own allocator is not written where
/// the checker could release them. Binding the value first gives it a name
/// an `errdefer` can cover. The exit's own operand is what it unwraps and
/// hands on, not something it drops; it is in the list when the expression
/// is read more than once.
fn (self: &var Checker) check_no_pending_owner_temps(
    tree: &ast::Ast,
    pending: i64,
    exit: []u8,
    span: ast::Span,
    own: ast::Expression
) -> !?diagnostic::Diagnostic {
    var index = self.temps_base;
    while index < pending {
        let producer = self.pending_owner_temps.get_or_panic(index);
        index = index + 1;
        if producer.node == own.node {
            continue;
        }
        let rendered = try self.names.intern_expression(tree, producer);
        let spelling = try self.names.intern(exit);
        return try self.error2(
            tree, span,
            "move error: the owner `%s` produced earlier in this statement would leak on this `%s` exit; bind it with `let` and register `errdefer` before it",
            Arg::Str(rendered), Arg::Str(spelling)
        );
    }
    return null;
}

/// Records that a call or literal took every owner its operands handed it
/// -- the temporaries and the places moved since it began -- and that its
/// own result is what stays pending when that result owns something, the Go
/// `settleOwnerTemps`. A statement form settles with no producer.
fn (self: &var Checker) settle_owner_temps(
    pending: i64,
    places: i64,
    type_name: Name,
    producer: ?ast::Expression
) -> !void {
    self.truncate_owner_temps(pending);
    self.truncate_moved_places(places);
    if producer |node| {
        if try self.produces_owner_temp(type_name) {
            try self.pending_owner_temps.append(self.allocator, node);
        }
    }
    return;
}

/// Drops the pending owner producers past length, the Go slice truncation.
fn (self: &var Checker) truncate_owner_temps(length: i64) -> void {
    while self.pending_owner_temps.len() > length {
        let _ = self.pending_owner_temps.pop();
    }
    return;
}

/// Drops the pending moved places past length, the Go slice truncation.
fn (self: &var Checker) truncate_moved_places(length: i64) -> void {
    while self.pending_moved_places.len() > length {
        let _ = self.pending_moved_places.pop();
    }
    return;
}

/// Returns the binding a hand-off took a whole value out of, the Go
/// `movedPlaceBinding`. A field path or a temporary is not one: nothing but
/// the statement holds what left them.
fn (self: &Checker) moved_place_binding(tree: &ast::Ast, env: ScopeHandle, place: ast::Expression) -> ?BindingHandle {
    let value = self.lookup_ident(tree, env, place) orelse return null;
    if !self.binding(value).moved {
        return null;
    }
    return value;
}

/// Marks the places this statement has moved out of as held (moved false)
/// or handed off (moved true), the two halves of the Go
/// `withPendingPlacesLive`. Their storage is untouched until the call or
/// literal that takes them runs, so an exit before that point leaves the
/// value where it was: a cleanup covering it releases it, and an uncovered
/// one is the leak the check reports.
fn (self: &var Checker) set_pending_places_moved(moved: bool) -> !void {
    var index = self.places_base;
    while index < self.pending_moved_places.len() {
        let value = self.pending_moved_places.get_or_panic(index);
        index = index + 1;
        try self.store.set_moved(value, moved);
    }
    return;
}

/// Checks the exit an `orelse` / `catch` guard takes, the Go
/// `checkGuardExit`: a return, or a branch out of a loop. It is taken in the
/// middle of a statement, so the places the statement has moved out of are
/// still held on that path.
fn (self: &var Checker) check_guard_exit(
    tree: &var ast::Ast,
    env: ScopeHandle,
    exit: ast::Statement,
    pending: i64
) -> !?diagnostic::Diagnostic {
    // On the exit path the condition produced nothing to keep -- the guard
    // is taken because it did not -- so what it added is not pending there.
    // It is once the guard falls through, so it comes back after.
    var kept = array::new<ast::Expression>(self.allocator);
    defer kept.deinit(self.allocator);
    while self.pending_owner_temps.len() > pending {
        let producer = self.pending_owner_temps.pop() orelse break;
        try kept.append(self.allocator, producer);
    }
    if try self.check_guard_exit_live(tree, env, exit) |failed| {
        return move failed;
    }
    while kept.pop() |producer| {
        try self.pending_owner_temps.append(self.allocator, producer);
    }
    return null;
}

/// Is the exit check itself, with the statement's moved places counted as
/// still held for its duration.
fn (self: &var Checker) check_guard_exit_live(
    tree: &var ast::Ast,
    env: ScopeHandle,
    exit: ast::Statement
) -> !?diagnostic::Diagnostic {
    try self.set_pending_places_moved(false);
    if return_stmt(tree, exit) |value| {
        let cloned = try self.store.clone_scope(env);
        if try self.check_return_stmt(tree, cloned, exit, value) |failed| {
            return move failed;
        }
    }
    if break_stmt(tree, exit) |value| {
        if try self.check_loop_branch_label(tree, env, LeakExitKind::Break, value.label) |failed| {
            return move failed;
        }
    }
    if continue_stmt(tree, exit) |value| {
        if try self.check_loop_branch_label(tree, env, LeakExitKind::Continue, value.label) |failed| {
            return move failed;
        }
    }
    try self.set_pending_places_moved(true);
    return null;
}

fn (self: &var Checker) read_try_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    tried: ast::TryExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    // What was pending before the operand is what the error exit drops; the
    // operand's own result is what the try unwraps and hands on.
    let pending = self.pending_owner_temps.len();
    var got = empty_name();
    if try self.read_expr(tree, env, tried.value, &var got) |failed| {
        return move failed;
    }
    let parts = try self.names.error_union_parts(got) orelse
        return try self.error1(tree, ast::zero_span(), "move error: try expects !T, got %s", Arg::Str(got));
    if try self.check_no_pending_owner_temps(
        tree, pending, "try", expression_span(tree, expression), tried.value
    ) |failed| {
        return move failed;
    }
    // A try can return early through the error path, which runs any active
    // errdefer cleanups. Their receivers must still be valid at this point,
    // except the ones a move has retired.
    // The places this statement has moved out of are still held on that
    // path (the Go `withPendingPlacesLive`).
    try self.set_pending_places_moved(false);
    var retired = array::new<ast::Expression>(self.allocator);
    errdefer retired.deinit(self.allocator);
    if try self.validate_err_defer_receivers(tree, env, &var retired) |failed| {
        retired.deinit(self.allocator);
        return move failed;
    }
    try self.result.try_retired_err_defers.append(self.allocator, RetiredTry { node: expression.node, receivers: move retired });
    // The same early exit must not leak a live owner: every owner must be
    // consumed or covered by a defer / errdefer cleanup before the try.
    let exit = LeakExit { kind: LeakExitKind::Try, span: expression_span(tree, expression) };
    if try self.check_owners_consumed(tree, env, 0, exit) |failed| {
        return move failed;
    }
    try self.set_pending_places_moved(true);
    out.* = parts.success;
    return null;
}

/// Reads raw pointer builtin arguments without moving values, the Go
/// `checkPointerBuiltin`.
fn (self: &var Checker) check_pointer_builtin(
    tree: &var ast::Ast,
    env: ScopeHandle,
    call: ast::CallExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var ignored = empty_name();
    var index = 0;
    while arg_at(tree, call.args, index) |arg| {
        if try self.read_expr(tree, env, arg, &var ignored) |failed| {
            return move failed;
        }
        index = index + 1;
    }
    out.* = self.common.void_name;
    if ident_text(tree, call.callee) |name| {
        if text_equals(tree, name, "ptr_read") {
            out.* = self.common.i64_name;
        }
    }
    return null;
}

/// Reads pointer/integer conversion arguments without moving values, the Go
/// `checkPointerIntCastBuiltin`.
fn (self: &var Checker) check_pointer_int_cast_builtin(
    tree: &var ast::Ast,
    env: ScopeHandle,
    type_arg: Name,
    args: ast::ExpressionList,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    var ignored = empty_name();
    var index = 0;
    while arg_at(tree, args, index) |arg| {
        if try self.read_expr(tree, env, arg, &var ignored) |failed| {
            return move failed;
        }
        index = index + 1;
    }
    out.* = type_arg;
    return null;
}

/// Checks a literal without consuming field values, the Go
/// `readStructLiteralExpr`.
fn (self: &var Checker) read_struct_literal_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    let head = struct_literal_head(tree, expression) orelse return null;
    let pending = self.pending_owner_temps.len();
    let places = self.pending_moved_places.len();
    var ignored = empty_name();
    var index = 0;
    while struct_literal_field_at(tree, expression, index) |field| {
        if try self.read_expr(tree, env, field.value, &var ignored) |failed| {
            return move failed;
        }
        index = index + 1;
    }
    out.* = try self.names.intern_text(tree, head.type_name);
    try self.settle_owner_temps(pending, places, out.*, expression);
    return null;
}

/// Moves field values into a new struct value, the Go
/// `moveStructLiteralExpr`.
fn (self: &var Checker) move_struct_literal_expr(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    let head = struct_literal_head(tree, expression) orelse return null;
    let pending = self.pending_owner_temps.len();
    let places = self.pending_moved_places.len();
    var ignored = empty_name();
    var index = 0;
    while struct_literal_field_at(tree, expression, index) |field| {
        if try self.move_expr(tree, env, field.value, &var ignored) |failed| {
            return move failed;
        }
        index = index + 1;
    }
    out.* = try self.names.intern_text(tree, head.type_name);
    try self.settle_owner_temps(pending, places, out.*, expression);
    return null;
}
