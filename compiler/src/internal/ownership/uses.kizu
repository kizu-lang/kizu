import compiler::internal::ast;
import std::array;
import std::map;

// Port of the last-use analysis of internal/ownership/checker.go: which
// statement index each identifier is last read at, so a block can release
// local borrows once their binding is no longer used.

/// Keeps the identifier reads the last-use analysis works from, the Go
/// `identUses`. Every block the check enters asks for its own last uses, and
/// each one reads its nested blocks' names; collecting a nested block once
/// and keeping its distinct names keeps that linear. Walking each subtree
/// again at every depth made deep nesting -- and a long else-if chain, which
/// parses as nested blocks -- cubic. The names depend only on the syntax,
/// which no check rewrites, so one entry serves every instantiation and
/// expansion of a body.
pub struct IdentUses {
    // ranges maps a block's id to where its distinct names sit in texts.
    ranges: map::Map<i64, UseRange>,
    texts: array::Array<ast::Text>,
}

/// Is a run of IdentUses.texts.
struct UseRange {
    start: i64,
    len: i64,
}

fn new_ident_uses(allocator: Allocator) -> IdentUses {
    return IdentUses {
        ranges: map::new<i64, UseRange>(allocator),
        texts: array::new<ast::Text>(allocator)
    };
}

fn (self: IdentUses) deinit(allocator: Allocator) -> void {
    self.ranges.deinit(allocator);
    self.texts.deinit(allocator);
    return;
}

/// Returns the last statement index where each identifier appears, the Go
/// `blockLastUses`. A loop counts as one statement: every turn it runs is
/// over once the statement is, and the body is checked against its own
/// scope, which this block's releases never reach. A name a registered
/// cleanup reads is read when the block exits, so it is kept until the end
/// whatever else follows.
fn (self: &var IdentUses) block_last_uses(
    allocator: Allocator,
    tree: &ast::Ast,
    block: ast::Block
) -> !map::Map<[]u8, i64> {
    var last_uses = map::new<[]u8, i64>(allocator);
    errdefer last_uses.deinit(allocator);
    var names = array::new<ast::Text>(allocator);
    defer names.deinit(allocator);
    let count = block_len(tree, block);
    var index = 0;
    while block_statement_at(tree, block, index) |statement| {
        var at = index;
        if cleanup_stmt(tree, statement) {
            at = count;
        }
        var name_index = names.len();
        try self.stmt(allocator, tree, statement, &var names);
        while names.get(name_index) |name| {
            let retained = tree.texts.at(name.node);
            let bytes = retained.as_bytes();
            try record_use(allocator, &var last_uses, bytes, at, count);
            name_index = name_index + 1;
        }
        index = index + 1;
    }
    return move last_uses;
}

/// Reports whether statement registers a cleanup that runs when the block
/// exits, the Go `cleanupStmt`.
fn cleanup_stmt(tree: &ast::Ast, statement: ast::Statement) -> bool {
    if defer_stmt(tree, statement) |_| {
        return true;
    }
    if errdefer_stmt(tree, statement) |_| {
        return true;
    }
    return false;
}

/// Records the index at which a name was used: a name already kept to the
/// block's end (count) keeps that position.
fn record_use(allocator: Allocator, out: &var map::Map<[]u8, i64>, name: []u8, at: i64, count: i64) -> !void {
    if out.at_mut(name) |slot| {
        if slot.* >= count {
            return;
        }
        slot.* = at;
        return;
    }
    return out.insert(allocator, name, at);
}

/// Appends the identifier reads of one statement to out, the Go
/// `identUses.stmt`.
fn (self: &var IdentUses) stmt(
    allocator: Allocator,
    tree: &ast::Ast,
    statement: ast::Statement,
    out: &var array::Array<ast::Text>
) -> !void {
    match tree.statements.at(statement.node) {
        Let(value) => return self.expr(allocator, tree, value.value, out),
        Assign(value) => {
            try self.expr(allocator, tree, value.value, out);
            return self.expr(allocator, tree, value.target, out);
        },
        Return(value) => {
            if value.value |returned| {
                return self.expr(allocator, tree, returned, out);
            }
            return;
        },
        Defer(value) => return self.expr(allocator, tree, value.expr, out),
        ErrDefer(value) => return self.expr(allocator, tree, value.expr, out),
        Expr(value) => return self.expr(allocator, tree, value.expr, out),
        If(value) => {
            try self.expr(allocator, tree, value.condition, out);
            try self.block(allocator, tree, value.consequence, out);
            if value.alternative |alternative| {
                return self.block(allocator, tree, alternative, out);
            }
            return;
        },
        While(value) => {
            try self.expr(allocator, tree, value.condition, out);
            return self.block(allocator, tree, value.body, out);
        },
        For(value) => {
            try self.expr(allocator, tree, value.start, out);
            try self.expr(allocator, tree, value.end, out);
            return self.block(allocator, tree, value.body, out);
        },
        Match(value) => {
            try self.expr(allocator, tree, value.value, out);
            var index = 0;
            while value.arms.get(index) |arm| {
                try self.stmt(allocator, tree, arm.body, out);
                index = index + 1;
            }
            return;
        },
        ComptimeIf(value) => {
            try self.expr(allocator, tree, value.condition, out);
            try self.block(allocator, tree, value.consequence, out);
            if value.alternative |alternative| {
                return self.block(allocator, tree, alternative, out);
            }
            return;
        },
        _ => return,
    }
}

/// Appends the distinct identifier reads inside a nested block to out, the
/// Go `identUses.block`.
fn (self: &var IdentUses) block(
    allocator: Allocator,
    tree: &ast::Ast,
    block: ast::Block,
    out: &var array::Array<ast::Text>
) -> !void {
    let range = try self.block_range(allocator, tree, block);
    var index = 0;
    while index < range.len {
        try out.append(allocator, self.texts.get_or_panic(range.start + index));
        index = index + 1;
    }
    return;
}

/// Returns where a block's distinct identifier reads sit in texts,
/// collecting them on the first request.
fn (self: &var IdentUses) block_range(allocator: Allocator, tree: &ast::Ast, block: ast::Block) -> !UseRange {
    var id = 0;
    match tree.statements.at(block.node) {
        Block(value) => {
            id = value.id;
        },
        _ => return UseRange { start: 0, len: 0 },
    }
    if self.ranges.get(id) |found| {
        return found;
    }
    // The nested blocks append their own entries to texts while this one is
    // walked, so its names gather apart and join texts after.
    var names = array::new<ast::Text>(allocator);
    defer names.deinit(allocator);
    var index = 0;
    while block_statement_at(tree, block, index) |statement| {
        try self.stmt(allocator, tree, statement, &var names);
        index = index + 1;
    }
    var seen = map::new<[]u8, bool>(allocator);
    defer seen.deinit(allocator);
    let start = self.texts.len();
    index = 0;
    while names.get(index) |name| {
        let retained = tree.texts.at(name.node);
        let bytes = retained.as_bytes();
        if !seen.contains(bytes) {
            try seen.insert(allocator, bytes, true);
            try self.texts.append(allocator, name);
        }
        index = index + 1;
    }
    let range = UseRange { start: start, len: self.texts.len() - start };
    try self.ranges.insert(allocator, id, range);
    return range;
}

/// Appends the identifier reads of an expression to out, the Go
/// `identUses.expr`.
fn (self: &var IdentUses) expr(
    allocator: Allocator,
    tree: &ast::Ast,
    expression: ast::Expression,
    out: &var array::Array<ast::Text>
) -> !void {
    if transparent_expr_value(tree, expression) |inner| {
        return self.expr(allocator, tree, inner, out);
    }
    match tree.expressions.at(expression.node) {
        Ident(value) => return out.append(allocator, value.name),
        Binary(value) => {
            try self.expr(allocator, tree, value.left, out);
            return self.expr(allocator, tree, value.right, out);
        },
        Call(value) => {
            try self.expr(allocator, tree, value.callee, out);
            let args = tree.expression_lists.at(value.args.node);
            var index = 0;
            while args.get(index) |arg| {
                try self.expr(allocator, tree, arg, out);
                index = index + 1;
            }
            return;
        },
        Cast(value) => return self.expr(allocator, tree, value.value, out),
        Try(value) => return self.expr(allocator, tree, value.value, out),
        // A hand-off reads the place it hands off. Missing it here would end
        // the value's live range at its previous statement, and everything a
        // last use releases -- the borrows it holds, the allocator it is tied
        // to -- would be released one statement early.
        Move(value) => return self.expr(allocator, tree, value.value, out),
        StructLiteral(value) => {
            var index = 0;
            while value.fields.get(index) |field| {
                try self.expr(allocator, tree, field.value, out);
                index = index + 1;
            }
            return;
        },
        Field(value) => return self.expr(allocator, tree, value.receiver, out),
        Deref(value) => return self.expr(allocator, tree, value.receiver, out),
        VectorLiteral(value) => {
            var index = 0;
            while value.lanes.get(index) |lane| {
                try self.expr(allocator, tree, lane, out);
                index = index + 1;
            }
            return;
        },
        BufferLiteral(value) => {
            var index = 0;
            while value.elements.get(index) |element| {
                try self.expr(allocator, tree, element, out);
                index = index + 1;
            }
            return;
        },
        Index(value) => {
            try self.expr(allocator, tree, value.target, out);
            if value.index |present| {
                try self.expr(allocator, tree, present, out);
            }
            if value.start |present| {
                try self.expr(allocator, tree, present, out);
            }
            if value.end |present| {
                return self.expr(allocator, tree, present, out);
            }
            return;
        },
        Comptime(value) => return self.expr(allocator, tree, value.expr, out),
        // An `if` or `match` standing as a value reads whatever its branches
        // read, and a guard's exit reads whatever it returns.
        If(value) => {
            try self.expr(allocator, tree, value.condition, out);
            try self.block(allocator, tree, value.consequence, out);
            if value.alternative |alternative| {
                return self.block(allocator, tree, alternative, out);
            }
            return;
        },
        Match(value) => {
            try self.expr(allocator, tree, value.value, out);
            var index = 0;
            while value.arms.get(index) |arm| {
                try self.stmt(allocator, tree, arm.body, out);
                index = index + 1;
            }
            return;
        },
        OrelseGuard(value) => {
            try self.expr(allocator, tree, value.condition, out);
            return self.stmt(allocator, tree, value.exit, out);
        },
        CatchGuard(value) => {
            try self.expr(allocator, tree, value.condition, out);
            return self.stmt(allocator, tree, value.exit, out);
        },
        _ => return,
    }
}

/// Ends local borrows whose binding is no longer used, the Go
/// `releaseLastUseBorrows`. A binding that is itself still borrowed keeps its
/// own sources active: the chain buffer <- view <- allocator <- owner releases
/// from the leaf inward, each release re-examining only the bindings it just
/// unblocked.
fn (self: &var Checker) release_last_use_borrows(
    env: ScopeHandle,
    statement_index: i64,
    last_uses: &map::Map<[]u8, i64>
) -> !void {
    var index = 0;
    while self.store.scope_value_at(env, index) |value| {
        try self.release_if_unused(env, value, statement_index, last_uses);
        index = index + 1;
    }
    return;
}

/// Releases one binding's borrow targets once it is past its last use and
/// nothing borrows it, then retries the targets that release may have
/// unblocked, the Go `releaseIfUnused`.
fn (self: &var Checker) release_if_unused(
    env: ScopeHandle,
    value: BindingHandle,
    statement_index: i64,
    last_uses: &map::Map<[]u8, i64>
) -> !void {
    if !self.has_borrow_targets(value) {
        return;
    }
    if self.last_use_of(value, last_uses) |last| {
        if last > statement_index {
            return;
        }
    }
    // A deferred Future or TaskSet cleanup is a use at scope exit: live
    // workers can still reach retained state and capabilities.
    let record = self.binding(value);
    if record.defer_cleanup and self.tied_struct_return(record.type_name) and
        !record.deinitialized and !record.moved {
        return;
    }
    if self.store.has_any_borrow(value) {
        return;
    }
    try self.release_borrow(value);
    var targets = array::new<BorrowSource>(self.allocator);
    defer targets.deinit(self.allocator);
    try self.take_borrow_targets(value, &var targets);
    var index = 0;
    while targets.get(index) |source| {
        index = index + 1;
        let held = self.lookup_local_name(env, self.binding(source.target).name) orelse continue;
        if held.node == source.target.node {
            try self.release_if_unused(env, held, statement_index, last_uses);
        }
    }
    return;
}

/// Ends the borrows a consumed binding holds, the Go
/// `releaseConsumedBorrows`. A value handed off or released reads its
/// sources no more, and the cleanup registered on it retires with it, so
/// the mentions its name still has — an errdefer that will never run — keep
/// nothing alive. What the release unblocks is released by the statement's
/// own last-use pass.
fn (self: &var Checker) release_consumed_borrows(value: BindingHandle) -> !void {
    if !self.has_borrow_targets(value) or self.store.has_any_borrow(value) {
        return;
    }
    try self.release_borrow(value);
    var targets = array::new<BorrowSource>(self.allocator);
    defer targets.deinit(self.allocator);
    return self.take_borrow_targets(value, &var targets);
}

/// Reads the last-use statement index recorded for a binding's name.
fn (self: &Checker) last_use_of(value: BindingHandle, last_uses: &map::Map<[]u8, i64>) -> ?i64 {
    let retained = name_text(&self.names, self.binding(value).name);
    let bytes = retained.as_bytes();
    return last_uses.get(bytes);
}

/// Moves a binding's borrow targets out, leaving it with none, the Go
/// `targets := value.borrowTargets; value.borrowTargets = nil`.
fn (self: &var Checker) take_borrow_targets(value: BindingHandle, out: &var array::Array<BorrowSource>) -> !void {
    let allocator = self.allocator;
    if self.store.binding_mut(value) |record| {
        while record.borrow_targets.pop() |source| {
            try out.append(allocator, source);
        }
    }
    return;
}
