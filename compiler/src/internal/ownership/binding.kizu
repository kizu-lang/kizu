import compiler::internal::ast;
import std::arena;
import std::array;
import std::map;
import std::mem;
import std::string;

// Mechanical port of the binding and scope records of internal/ownership/
// checker.go. Go shares `*binding` between scopes and their clones; here one
// ScopeStore owns every binding and scope of a checker run in arenas and hands
// out copy handles, so a clone is a fresh record with the same stable id, as
// in Go, and the chain walks and id lookups stay pointer-free.

/// Identifies one binding retained by a ScopeStore.
pub struct BindingHandle {
    node: arena::Handle<Binding>
}

/// Identifies one lexical scope retained by a ScopeStore.
pub struct ScopeHandle {
    node: arena::Handle<Scope>
}

/// Is one owner a local borrow keeps active: the borrowed binding and, for a
/// field borrow, the borrowed field path; an empty field is the whole value.
pub struct BorrowSource {
    pub target: BindingHandle,
    pub field: Name
}

/// Keeps every ownership fact about one local name.
pub struct Binding {
    pub id: i64,
    pub name: Name,
    pub type_name: Name,
    pub mutable: bool,
    pub moved: bool,
    pub borrowed_param: bool,
    pub local_borrow: bool,
    pub borrow_targets: array::Array<BorrowSource>,
    pub mut_borrow: bool,
    pub active_borrows: i64,
    pub active_mut_borrows: i64,
    pub field_borrows: map::Map<[]u8, i64>,
    pub field_mut_borrows: map::Map<[]u8, i64>,
    pub field_deinit: map::Map<[]u8, bool>,
    pub field_arena_ids: map::Map<[]u8, i64>,
    pub arena_id: i64,
    pub handle_arena_id: i64,
    pub deinitialized: bool,
    pub consume_exempt: bool,
    // owns_tied marks a capture that was handed its owner payload while the
    // payload's views keep it tied to the container it came from: the
    // binding owns the value (its `deinit` is its to call) but cannot move
    // it out of the frame (SPEC §9).
    pub owns_tied: bool,
    pub defer_cleanup: bool,
    pub decl_span: ast::Span,
    // field_owner and field_owner_name link a direct-field receiver
    // projection back to the owner binding and its field.
    pub field_owner: ?BindingHandle,
    pub field_owner_name: Name
}

fn (self: Binding) deinit(allocator: Allocator) -> void {
    self.borrow_targets.deinit(allocator);
    self.field_borrows.deinit(allocator);
    self.field_mut_borrows.deinit(allocator);
    self.field_deinit.deinit(allocator);
    self.field_arena_ids.deinit(allocator);
    return;
}

struct Scope {
    parent: ?ScopeHandle,
    values: map::Map<[]u8, BindingHandle>
}

/// Owns the bindings and lexical scopes of one checker run.
pub struct ScopeStore {
    allocator: Allocator,
    bindings: arena::Arena<Binding>,
    scopes: arena::Arena<Scope>,
    next_id: i64
}

pub fn new_scope_store(allocator: Allocator) -> ScopeStore {
    return ScopeStore {
        allocator: allocator,
        bindings: arena::new<Binding>(allocator),
        scopes: arena::new<Scope>(allocator),
        next_id: 0
    };
}

fn (self: ScopeStore) deinit(allocator: Allocator) -> void {
    self.bindings.deinit(allocator);
    self.scopes.deinit(allocator);
    return;
}

/// Creates a local ownership binding with a stable id, the Go `newBinding`.
/// The record is filled in by the caller and then defined into a scope.
fn (self: &var ScopeStore) new_binding(name: Name, type_name: Name) -> Binding {
    self.next_id = self.next_id + 1;
    return self.blank_binding(self.next_id, name, type_name);
}

/// Creates a transient binding outside the id sequence, the Go
/// `&binding{...}` literal of receiver projections.
fn (self: &ScopeStore) blank_binding(id: i64, name: Name, type_name: Name) -> Binding {
    return Binding {
        id: id,
        name: name,
        type_name: type_name,
        mutable: false,
        moved: false,
        borrowed_param: false,
        local_borrow: false,
        borrow_targets: array::new<BorrowSource>(self.allocator),
        mut_borrow: false,
        active_borrows: 0,
        active_mut_borrows: 0,
        field_borrows: map::new<[]u8, i64>(self.allocator),
        field_mut_borrows: map::new<[]u8, i64>(self.allocator),
        field_deinit: map::new<[]u8, bool>(self.allocator),
        field_arena_ids: map::new<[]u8, i64>(self.allocator),
        arena_id: 0,
        handle_arena_id: 0,
        deinitialized: false,
        consume_exempt: false,
        owns_tied: false,
        defer_cleanup: false,
        decl_span: ast::zero_span(),
        field_owner: null,
        field_owner_name: empty_name()
    };
}

/// Returns the next stable id, the Go `c.nextID++` used for field arenas.
fn (self: &var ScopeStore) next_binding_id() -> i64 {
    self.next_id = self.next_id + 1;
    return self.next_id;
}

/// Returns the id watermark new bindings will exceed.
fn (self: &ScopeStore) id_mark() -> i64 {
    return self.next_id;
}

/// Retains a binding that belongs to no scope, such as a receiver projection.
fn (self: &var ScopeStore) retain(value: Binding) -> !BindingHandle {
    return BindingHandle { node: try self.bindings.add(self.allocator, move value) };
}

/// Reads one binding.
fn (self: &ScopeStore) at(handle: BindingHandle) -> &Binding {
    return self.bindings.at(handle.node);
}

/// Opens one binding for mutation.
fn (self: &var ScopeStore) binding_mut(handle: BindingHandle) -> ?&var Binding {
    return self.bindings.at_mut(handle.node);
}

/// Creates a lexical ownership scope, the Go `newScope`.
fn (self: &var ScopeStore) new_scope(parent: ?ScopeHandle) -> !ScopeHandle {
    return ScopeHandle {
        node: try self.scopes.add(self.allocator, Scope {
            parent: parent,
            values: map::new<[]u8, BindingHandle>(self.allocator)
        })
    };
}

/// Creates a nested lexical ownership scope, the Go `scope.child`.
fn (self: &var ScopeStore) child(parent: ScopeHandle) -> !ScopeHandle {
    return self.new_scope(parent);
}

/// Binds a local name in the current scope, the Go `scope.define`; a name
/// already bound there is replaced.
fn (self: &var ScopeStore) define(scope: ScopeHandle, name: []u8, value: Binding) -> !BindingHandle {
    let handle = try self.retain(move value);
    try self.define_handle(self.allocator, scope, name, handle);
    return handle;
}

/// Binds an already retained binding in the current scope.
fn (self: &var ScopeStore) define_handle(allocator: Allocator, scope: ScopeHandle, name: []u8, handle: BindingHandle) -> !void {
    if self.scopes.at_mut(scope.node) |current| {
        if current.values.at_mut(name) |slot| {
            slot.* = handle;
            return;
        }
        return current.values.insert(allocator, name, handle);
    }
    return;
}

/// Resolves a local name by walking parent scopes, the Go `scope.lookup`.
fn (self: &ScopeStore) resolve(scope: ScopeHandle, name: []u8) -> ?BindingHandle {
    var current = optional_scope(scope);
    while current |handle| {
        let retained = self.scopes.at(handle.node);
        if retained.values.get(name) |value| {
            return value;
        }
        current = retained.parent;
    }
    return null;
}

/// Resolves a name in one scope only, the Go `scope.values[name]`.
fn (self: &ScopeStore) lookup_local(scope: ScopeHandle, name: []u8) -> ?BindingHandle {
    let retained = self.scopes.at(scope.node);
    return retained.values.get(name);
}

fn optional_scope(scope: ScopeHandle) -> ?ScopeHandle {
    return scope;
}

/// Visits every binding of a scope chain in turn; a Walker replaces the Go
/// `walkBindings` visitor closure.
pub struct Walker {
    current: ?ScopeHandle,
    index: i64
}

fn (self: &ScopeStore) walk(scope: ScopeHandle) -> Walker {
    return Walker { current: scope, index: 0 };
}

fn (self: &var Walker) next(store: &ScopeStore) -> ?BindingHandle {
    while self.current |handle| {
        let retained = store.scopes.at(handle.node);
        if retained.values.key_at(self.index) |name| {
            self.index = self.index + 1;
            return retained.values.get(name);
        }
        self.current = retained.parent;
        self.index = 0;
    }
    return null;
}

/// Finds the binding with a stable id in a scope chain, the Go
/// `collectBindings` map read back by id.
fn (self: &ScopeStore) find_by_id(scope: ScopeHandle, id: i64) -> ?BindingHandle {
    var walker = self.walk(scope);
    while walker.next(self) |handle| {
        if self.at(handle).id == id {
            return handle;
        }
    }
    return null;
}

/// Resolves the binding whose field holds the arena with this provenance id,
/// the Go `scope.fieldArenaOwner`.
fn (self: &ScopeStore) field_arena_owner(scope: ScopeHandle, arena_id: i64) -> ?BindingHandle {
    var walker = self.walk(scope);
    while walker.next(self) |handle| {
        if self.holds_field_arena(handle, arena_id) {
            return handle;
        }
    }
    return null;
}

fn (self: &ScopeStore) holds_field_arena(handle: BindingHandle, arena_id: i64) -> bool {
    let value = self.at(handle);
    var index = 0;
    while value.field_arena_ids.key_at(index) |field| {
        if value.field_arena_ids.get(field) |id| {
            if id == arena_id {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

/// Resolves a tracked arena owner by provenance id, the Go
/// `scope.lookupArenaID`.
fn (self: &ScopeStore) lookup_arena_id(scope: ScopeHandle, arena_id: i64) -> ?BindingHandle {
    var walker = self.walk(scope);
    while walker.next(self) |handle| {
        if self.at(handle).arena_id == arena_id {
            return handle;
        }
    }
    return null;
}

/// Reports whether a whole value or any direct field is borrowed, the Go
/// `binding.hasAnyBorrow`. A field count that dropped to zero stays in its
/// map, so only positive counts are borrows.
fn (self: &ScopeStore) has_any_borrow(handle: BindingHandle) -> bool {
    let value = self.at(handle);
    return value.active_borrows > 0 or value.active_mut_borrows > 0 or
        any_positive(&value.field_borrows) or any_positive(&value.field_mut_borrows);
}

/// Reports whether any field of a binding is borrowed the given way, the Go
/// `len(value.fieldMutBorrows) > 0` / `len(value.fieldBorrows) > 0`.
fn (self: &ScopeStore) has_field_borrows(handle: BindingHandle, mutable: bool) -> bool {
    let value = self.at(handle);
    if mutable {
        return any_positive(&value.field_mut_borrows);
    }
    return any_positive(&value.field_borrows);
}

/// Reports whether any field of a per-field counter map is borrowed, the Go
/// `len(map) > 0` over a map that deletes zero counts.
fn any_positive(counts: &map::Map<[]u8, i64>) -> bool {
    var index = 0;
    while counts.key_at(index) |field| {
        if counts.get(field) |count| {
            if count > 0 {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

/// Sums the borrow counts of every tracked field path that aliases path, the
/// Go `overlappingFieldCount`.
fn overlapping_field_count(counts: &map::Map<[]u8, i64>, path: []u8) -> i64 {
    var total = 0;
    var index = 0;
    while counts.key_at(index) |key| {
        if field_paths_overlap(key, path) {
            total = total + (counts.get(key) orelse 0);
        }
        index = index + 1;
    }
    return total;
}

/// Reports whether two dotted field paths alias the same storage, the Go
/// `fieldPathsOverlap`: equal paths, or one naming a struct that contains the
/// other (`a.b` overlaps `a.b.c`; `a.b` does not overlap `a.bc`).
pub fn field_paths_overlap(left: []u8, right: []u8) -> bool {
    if mem::len(left) > mem::len(right) {
        return field_paths_overlap(right, left);
    }
    if !mem::starts_with(right, left) {
        return false;
    }
    return mem::len(left) == mem::len(right) or right[mem::len(left)] == cast<u8>(46);
}

/// Reports whether a field path has been deinitialized.
fn (self: &ScopeStore) field_deinit(handle: BindingHandle, field: []u8) -> bool {
    let value = self.at(handle);
    return value.field_deinit.get(field) orelse false;
}

/// Reports whether any field of a value has been deinitialized, the Go
/// `len(value.fieldDeinit) == 0` over a map that deletes cleared fields.
fn (self: &ScopeStore) has_field_deinit(handle: BindingHandle) -> bool {
    if self.partially_consumed_field_index(handle) |_| {
        return true;
    }
    return false;
}

/// Returns the insertion index of one field already taken out of a value,
/// the Go `partiallyConsumedField`; callers read the key back with `key_at`.
fn (self: &ScopeStore) partially_consumed_field_index(handle: BindingHandle) -> ?i64 {
    let value = self.at(handle);
    var index = 0;
    while value.field_deinit.key_at(index) |field| {
        if value.field_deinit.get(field) orelse false {
            return index;
        }
        index = index + 1;
    }
    return null;
}

/// Records that an owned direct field has been cleaned up, the Go
/// `binding.markFieldDeinit`.
fn (self: &var ScopeStore) mark_field_deinit(handle: BindingHandle, field: []u8) -> !void {
    let allocator = self.allocator;
    if self.binding_mut(handle) |value| {
        return put_bool(allocator, &var value.field_deinit, field, true);
    }
    return;
}

/// Records assignment of a fresh value into a direct field, the Go
/// `binding.clearFieldDeinit`.
fn (self: &var ScopeStore) clear_field_deinit(handle: BindingHandle, field: []u8) -> !void {
    if self.binding_mut(handle) |value| {
        if value.field_deinit.at_mut(field) |slot| {
            slot.* = false;
        }
    }
    return;
}

fn put_bool(allocator: Allocator, values: &var map::Map<[]u8, bool>, key: []u8, flag: bool) -> !void {
    if values.at_mut(key) |slot| {
        slot.* = flag;
        return;
    }
    return values.insert(allocator, key, flag);
}

fn add_count(allocator: Allocator, counts: &var map::Map<[]u8, i64>, key: []u8, delta: i64) -> !void {
    if counts.at_mut(key) |slot| {
        slot.* = slot.* + delta;
        return;
    }
    return counts.insert(allocator, key, delta);
}

/// Records one active whole-value or field borrow on a target, the Go
/// `activateBorrow`.
fn (self: &var ScopeStore) activate_borrow(target: BindingHandle, field: []u8, mutable: bool) -> !void {
    let allocator = self.allocator;
    if self.binding_mut(target) |value| {
        if mem::len(field) == 0 {
            if mutable {
                value.active_mut_borrows = value.active_mut_borrows + 1;
            } else {
                value.active_borrows = value.active_borrows + 1;
            }
            return;
        }
        if mutable {
            return add_count(allocator, &var value.field_mut_borrows, field, 1);
        }
        return add_count(allocator, &var value.field_borrows, field, 1);
    }
    return;
}

/// Clears one call-scoped whole-value or field borrow, the Go
/// `releaseTemporaryBorrow`.
fn (self: &var ScopeStore) release_temporary_borrow(target: BindingHandle, field: []u8, mutable: bool) -> !void {
    if self.binding_mut(target) |value| {
        if mem::len(field) == 0 {
            if mutable and value.active_mut_borrows > 0 {
                value.active_mut_borrows = value.active_mut_borrows - 1;
            } else {
                if !mutable and value.active_borrows > 0 {
                    value.active_borrows = value.active_borrows - 1;
                }
            }
            return;
        }
        if mutable {
            return release_count(&var value.field_mut_borrows, field);
        }
        return release_count(&var value.field_borrows, field);
    }
    return;
}

fn release_count(counts: &var map::Map<[]u8, i64>, key: []u8) -> !void {
    if counts.at_mut(key) |slot| {
        let count = slot.*;
        if count > 0 {
            slot.* = count - 1;
        }
    }
    return;
}

/// Clears one owner's share of a local borrow, the Go `releaseBorrowSource`:
/// the borrow's mutability decides which counter it held.
fn (self: &var ScopeStore) release_borrow_source(mutable: bool, target: BindingHandle, field: []u8) -> !void {
    if self.binding_mut(target) |value| {
        if mem::len(field) == 0 {
            if mutable and value.active_mut_borrows > 0 {
                value.active_mut_borrows = value.active_mut_borrows - 1;
            } else {
                if value.active_borrows > 0 {
                    value.active_borrows = value.active_borrows - 1;
                }
            }
            return;
        }
        if mutable and (value.field_mut_borrows.get(field) orelse 0) > 0 {
            return release_count(&var value.field_mut_borrows, field);
        }
        return release_count(&var value.field_borrows, field);
    }
    return;
}

/// Copies a scope chain so branch checks do not interfere with each other,
/// the Go `scope.clone`. A binding's scalar facts copy with the record; its
/// map and array facts are copied one by one, so a branch never writes into
/// the state the other branches read.
fn (self: &var ScopeStore) clone_scope(scope: ScopeHandle) -> !ScopeHandle {
    var parent = self.scopes.at(scope.node).parent;
    if parent |parent_handle| {
        parent = try self.clone_scope(parent_handle);
    }
    let cloned = try self.new_scope(parent);
    var index = 0;
    while self.scope_value_at(scope, index) |value| {
        let name = try self.scope_key_copy(scope, index);
        defer name.deinit(self.allocator);
        let copied = try self.clone_binding(value);
        let handle = try self.retain(move copied);
        let name_bytes = name.as_bytes();
        try self.define_handle(self.allocator, cloned, name_bytes, handle);
        index = index + 1;
    }
    return cloned;
}

fn (self: &ScopeStore) scope_value_at(scope: ScopeHandle, index: i64) -> ?BindingHandle {
    let retained = self.scopes.at(scope.node);
    let name = retained.values.key_at(index) orelse return null;
    return retained.values.get(name);
}

// Copies the name the scope holds at index, so the source map is not
// borrowed while the clone is defined.
fn (self: &ScopeStore) scope_key_copy(scope: ScopeHandle, index: i64) -> !string::String {
    let retained = self.scopes.at(scope.node);
    if retained.values.key_at(index) |name| {
        return string::from_bytes(self.allocator, name);
    }
    return string::new(self.allocator);
}

fn (self: &ScopeStore) clone_binding(handle: BindingHandle) -> !Binding {
    let value = self.at(handle);
    // Each copy is bound and covered before the next is made: a copy the
    // allocator refuses must not leave the ones already made unreleased.
    var borrow_targets = try value.borrow_targets.clone(self.allocator);
    errdefer borrow_targets.deinit(self.allocator);
    var field_borrows = try copy_int_map(self.allocator, &value.field_borrows);
    errdefer field_borrows.deinit(self.allocator);
    var field_mut_borrows = try copy_int_map(self.allocator, &value.field_mut_borrows);
    errdefer field_mut_borrows.deinit(self.allocator);
    var field_deinit = try copy_bool_map(self.allocator, &value.field_deinit);
    errdefer field_deinit.deinit(self.allocator);
    let field_arena_ids = try copy_int_map(self.allocator, &value.field_arena_ids);
    return Binding {
        id: value.id,
        name: value.name,
        type_name: value.type_name,
        mutable: value.mutable,
        moved: value.moved,
        borrowed_param: value.borrowed_param,
        local_borrow: value.local_borrow,
        borrow_targets: move borrow_targets,
        mut_borrow: value.mut_borrow,
        active_borrows: value.active_borrows,
        active_mut_borrows: value.active_mut_borrows,
        field_borrows: move field_borrows,
        field_mut_borrows: move field_mut_borrows,
        field_deinit: move field_deinit,
        field_arena_ids: move field_arena_ids,
        arena_id: value.arena_id,
        handle_arena_id: value.handle_arena_id,
        deinitialized: value.deinitialized,
        consume_exempt: value.consume_exempt,
        owns_tied: value.owns_tied,
        defer_cleanup: value.defer_cleanup,
        decl_span: value.decl_span,
        field_owner: value.field_owner,
        field_owner_name: value.field_owner_name
    };
}

/// Copies a per-field counter map so a clone counts on its own.
fn copy_int_map(allocator: Allocator, source: &map::Map<[]u8, i64>) -> !map::Map<[]u8, i64> {
    var out = map::new<[]u8, i64>(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while source.key_at(index) |key| {
        try out.insert(allocator, key, source.get(key) orelse 0);
        index = index + 1;
    }
    return move out;
}

/// Copies a per-field flag map so a clone marks on its own.
fn copy_bool_map(allocator: Allocator, source: &map::Map<[]u8, bool>) -> !map::Map<[]u8, bool> {
    var out = map::new<[]u8, bool>(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while source.key_at(index) |key| {
        try out.insert(allocator, key, source.get(key) orelse false);
        index = index + 1;
    }
    return move out;
}

/// Carries what a checked branch did to a binding out past the branch, the
/// Go `scope.mergeMovedFrom`: that it moved it, that it released it, and
/// which of its fields it cleaned.
fn (self: &var ScopeStore) merge_moved_from(scope: ScopeHandle, other: ScopeHandle) -> !void {
    var walker = self.walk(other);
    while walker.next(self) |value| {
        let id = self.at(value).id;
        if self.find_by_id(scope, id) |target| {
            try self.merge_binding(target, value);
        }
    }
    return;
}

fn (self: &var ScopeStore) merge_binding(target: BindingHandle, value: BindingHandle) -> !void {
    let moved = self.at(value).moved;
    let deinitialized = self.at(value).deinitialized;
    if moved {
        try self.set_moved(target, true);
    }
    if deinitialized {
        try self.set_deinitialized(target, true);
    }
    var index = 0;
    while self.cleaned_field_at(value, index) |field_index| {
        try self.mark_field_deinit_from(target, value, field_index);
        index = field_index + 1;
    }
    return;
}

// Returns the insertion index of the next cleaned field at or after index.
fn (self: &ScopeStore) cleaned_field_at(handle: BindingHandle, index: i64) -> ?i64 {
    let value = self.at(handle);
    var current = index;
    while value.field_deinit.key_at(current) |field| {
        if value.field_deinit.get(field) orelse false {
            return current;
        }
        current = current + 1;
    }
    return null;
}

// Marks on target the field source holds at field_index.
fn (self: &var ScopeStore) mark_field_deinit_from(target: BindingHandle, source: BindingHandle, field_index: i64) -> !void {
    let value = self.at(source);
    if value.field_deinit.key_at(field_index) |field| {
        return self.mark_field_deinit(target, field);
    }
    return;
}

fn (self: &var ScopeStore) set_moved(handle: BindingHandle, moved: bool) -> !void {
    if self.binding_mut(handle) |value| {
        value.moved = moved;
    }
    return;
}

fn (self: &var ScopeStore) set_deinitialized(handle: BindingHandle, deinitialized: bool) -> !void {
    if self.binding_mut(handle) |value| {
        value.deinitialized = deinitialized;
    }
    return;
}
