pub fn is_block_stmt(tree: &ast::Ast, statement: ast::Statement) -> bool {
    match tree.statements.at(statement.node) {
        Block(_) => return true,
        _ => return false,
    }
}

pub fn is_match_stmt(tree: &ast::Ast, statement: ast::Statement) -> bool {
    match tree.statements.at(statement.node) {
        Match(_) => return true,
        _ => return false,
    }
}

