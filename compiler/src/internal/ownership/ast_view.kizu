import compiler::internal::ast;
import std::array;
import std::mem;

// One-line readers for the Ast node shapes the checker dispatches on, the Go
// `expr.(*ast.CallExpr)` type assertions. A copy-only node comes back by
// value so the Ast borrow ends with the call; nodes that own arrays (match
// arms, struct literal fields) are read through their handle by the caller.

pub fn call_expr(tree: &ast::Ast, expression: ast::Expression) -> ?ast::CallExpr {
    match tree.expressions.at(expression.node) {
        Call(value) => return value,
        _ => return null,
    }
}

pub fn field_expr(tree: &ast::Ast, expression: ast::Expression) -> ?ast::FieldExpr {
    match tree.expressions.at(expression.node) {
        Field(value) => return value,
        _ => return null,
    }
}

