/// Returns the statement a block holds at index, the Go
/// `block.Statements[index]`.
pub fn block_statement_at(tree: &ast::Ast, block: ast::Block, index: i64) -> ?ast::Statement {
    match tree.statements.at(block.node) {
        Block(value) => return value.statements.get(index),
        _ => return null,
    }
}

/// Returns the number of statements a block holds.
pub fn block_len(tree: &ast::Ast, block: ast::Block) -> i64 {
    match tree.statements.at(block.node) {
        Block(value) => return value.statements.len(),
        _ => return 0,
    }
}

/// Returns the argument a call holds at index.
pub fn arg_at(tree: &ast::Ast, args: ast::ExpressionList, index: i64) -> ?ast::Expression {
    let values = tree.expression_lists.at(args.node);
    return values.get(index);
}

/// Returns the number of arguments a call holds, the Go `len(call.Args)`.
pub fn arg_count(tree: &ast::Ast, args: ast::ExpressionList) -> i64 {
    return args.len(tree);
}

/// Reports whether an Ast text spells the bytes, the Go `name == "..."`.
pub fn text_equals(tree: &ast::Ast, text: ast::Text, want: []u8) -> bool {
    let retained = tree.texts.at(text.node);
    let bytes = retained.as_bytes();
    return mem::equal_bytes(bytes, want);
}
