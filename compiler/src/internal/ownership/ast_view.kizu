/// Reports whether an expression is a `match` used as an expression.
pub fn is_match_expr(tree: &ast::Ast, expression: ast::Expression) -> bool {
    match tree.expressions.at(expression.node) {
        Match(_) => return true,
        _ => return false,
    }
}

pub fn is_struct_literal_expr(tree: &ast::Ast, expression: ast::Expression) -> bool {
    match tree.expressions.at(expression.node) {
        StructLiteral(_) => return true,
        _ => return false,
    }
}

pub fn is_call_expr(tree: &ast::Ast, expression: ast::Expression) -> bool {
    if call_expr(tree, expression) |_| {
        return true;
    }
    return false;
}

/// Reads the type name and span of a struct literal; its fields are read
/// through struct_literal_field_at.
pub struct StructLiteralHead {
    pub type_name: ast::Text,
    pub span: ast::Span,
    pub field_count: i64
}

pub fn struct_literal_head(tree: &ast::Ast, expression: ast::Expression) -> ?StructLiteralHead {
    match tree.expressions.at(expression.node) {
        StructLiteral(value) => return StructLiteralHead {
            type_name: value.type_name,
            span: value.span,
            field_count: value.fields.len()
        },
        _ => return null,
    }
}

pub fn struct_literal_field_at(tree: &ast::Ast, expression: ast::Expression, index: i64) -> ?ast::FieldValue {
    match tree.expressions.at(expression.node) {
        StructLiteral(value) => return value.fields.get(index),
        _ => return null,
    }
}

/// Reads the copy half of a match: its scrutinee and meta texts; arms come
/// back through match_arms.
pub struct MatchHead {
    pub value: ast::Expression,
    pub meta_capture: ast::Text,
    pub meta_owner: ast::Text,
    pub arm_count: i64
}

pub fn match_stmt_head(tree: &ast::Ast, statement: ast::Statement) -> ?MatchHead {
    match tree.statements.at(statement.node) {
        Match(value) => return MatchHead {
            value: value.value,
            meta_capture: value.meta_capture,
            meta_owner: value.meta_owner,
            arm_count: value.arms.len()
        },
        _ => return null,
    }
}

pub fn match_expr_head(tree: &ast::Ast, expression: ast::Expression) -> ?MatchHead {
    match tree.expressions.at(expression.node) {
        Match(value) => return MatchHead {
            value: value.value,
            meta_capture: value.meta_capture,
            meta_owner: value.meta_owner,
            arm_count: value.arms.len()
        },
        _ => return null,
    }
}

/// Copies the arms of a match statement so the Ast borrow ends.
pub fn match_stmt_arms(allocator: Allocator, tree: &ast::Ast, statement: ast::Statement) -> !array::Array<ast::MatchArm> {
    match tree.statements.at(statement.node) {
        Match(value) => return value.arms.clone(allocator),
        _ => return array::new<ast::MatchArm>(allocator),
    }
}

/// Copies the arms of a match expression so the Ast borrow ends.
pub fn match_expr_arms(allocator: Allocator, tree: &ast::Ast, expression: ast::Expression) -> !array::Array<ast::MatchArm> {
    match tree.expressions.at(expression.node) {
        Match(value) => return value.arms.clone(allocator),
        _ => return array::new<ast::MatchArm>(allocator),
    }
}

