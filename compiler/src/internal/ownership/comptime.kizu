import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::staticexpr;
import compiler::internal::stdmath;
import compiler::internal::stdmeta;
import compiler::internal::stdtarget;
import compiler::internal::typ;

// Mechanical port of internal/ownership/comptime.go: the compile-time branch
// selection of `comptime if` and the minimal constant evaluation it needs.
// Go's `(value, ok)` pairs come back as optionals; the Go `string` type
// values are Names.

/// Checks ownership effects for the selected compile-time branch, the Go
/// `checkComptimeIfStmt`.
fn (self: &var Checker) check_comptime_if_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::ComptimeIfStmt
) -> !?diagnostic::Diagnostic {
    var condition_type = empty_name();
    if try self.read_comptime_only(tree, statement.condition, &var condition_type) |failed| {
        return move failed;
    }
    if try self.comptime_bool(tree, statement.condition) |value| {
        if !value {
            let alternative = statement.alternative orelse return null;
            let scope = try self.store.child(env);
            return self.check_block(tree, scope, alternative);
        }
    }
    let scope = self.store.child(env);
    return self.check_block(tree, try scope, statement.consequence);
}

/// Evaluates integer-only compile-time arithmetic used in branch conditions,
/// the Go `intLiteral`, with an integer-range capture standing for its
/// expansion's value.
fn (self: &Checker) int_literal(tree: &ast::Ast, expression: ast::Expression) -> ?i64 {
    if comptime_expr(tree, expression) |wrapped| {
        return self.int_literal(tree, wrapped.expr);
    }
    if int_expr(tree, expression) |literal| {
        let retained = tree.texts.at(literal.value.node);
        let bytes = retained.as_bytes();
        return decimal_i64(bytes);
    }
    if ident_expr(tree, expression) |ident| {
        let retained = tree.texts.at(ident.name.node);
        let bytes = retained.as_bytes();
        let bound = self.comptime_values.get(bytes) orelse return null;
        // A bound value may be negative: a static expression such as `(-2)`
        // reaches the instance as its decimal text.
        let text = name_text(&self.names, bound);
        let text_bytes = text.as_bytes();
        return staticexpr::parse_i64(text_bytes);
    }
    if prefix_expr(tree, expression) |prefix| {
        let value = self.int_literal(tree, prefix.right);
        if text_equals(tree, prefix.operator, "-") {
            let present = value orelse return null;
            return 0 - present;
        }
        return null;
    }
    if binary_expr(tree, expression) |binary| {
        let left = self.int_literal(tree, binary.left) orelse return null;
        let right = self.int_literal(tree, binary.right) orelse return null;
        return eval_comptime_int(tree, binary.operator, left, right);
    }
    return null;
}

/// Evaluates simple integer arithmetic for ownership branch selection, the
/// Go `evalComptimeInt`.
pub fn eval_comptime_int(tree: &ast::Ast, op: ast::Text, left: i64, right: i64) -> ?i64 {
    if text_equals(tree, op, "+") {
        return left + right;
    }
    if text_equals(tree, op, "-") {
        return left - right;
    }
    if text_equals(tree, op, "*") {
        return left * right;
    }
    if text_equals(tree, op, "/") {
        if right == 0 {
            return null;
        }
        return left / right;
    }
    if text_equals(tree, op, "%") {
        if right == 0 {
            return null;
        }
        return left % right;
    }
    return null;
}

/// Evaluates integer comparisons for ownership branch selection, the Go
/// `compareComptimeInts`.
pub fn compare_comptime_ints(tree: &ast::Ast, op: ast::Text, left: i64, right: i64) -> ?bool {
    if text_equals(tree, op, "==") {
        return left == right;
    }
    if text_equals(tree, op, "!=") {
        return left != right;
    }
    if text_equals(tree, op, "<") {
        return left < right;
    }
    if text_equals(tree, op, "<=") {
        return left <= right;
    }
    if text_equals(tree, op, ">") {
        return left > right;
    }
    if text_equals(tree, op, ">=") {
        return left >= right;
    }
    return null;
}

/// Reads a compile-time expression without moving runtime values, the Go
/// `readComptimeExpr`.
fn (self: &var Checker) read_comptime_expr(
    tree: &ast::Ast,
    expression: ast::ComptimeExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    return self.read_comptime_only(tree, expression.expr, out);
}

/// Rejects runtime locals inside compile-time expressions, the Go
/// `readComptimeOnly`.
fn (self: &var Checker) read_comptime_only(
    tree: &ast::Ast,
    expression: ast::Expression,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.node) {
        Comptime(value) => return self.read_comptime_only(tree, value.expr, out),
        Int(_) => {
            out.* = self.common.i64_name;
            return null;
        },
        Float(_) => {
            out.* = self.common.f64_name;
            return null;
        },
        String(_) => {
            out.* = self.common.bytes_name;
            return null;
        },
        Bool(_) => {
            out.* = self.common.bool_name;
            return null;
        },
        Type(_) => {
            out.* = self.common.type_value_name;
            return null;
        },
        Ident(value) => {
            let retained = tree.texts.at(value.name.node);
            let bytes = retained.as_bytes();
            if self.type_arg_values.contains(bytes) {
                out.* = self.common.type_value_name;
                return null;
            }
            if self.comptime_values.get(bytes) |bound| {
                if self.names.is(bound, "true") or self.names.is(bound, "false") {
                    out.* = self.common.bool_name;
                    return null;
                }
                out.* = self.common.i64_name;
                return null;
            }
            return try self.error0(
                ast::zero_span(), "borrow error: runtime value cannot cross comptime boundary"
            );
        },
        Prefix(value) => return self.read_comptime_only(tree, value.right, out),
        Binary(value) => {
            let copied = value;
            var left = empty_name();
            if try self.read_comptime_only(tree, copied.left, &var left) |failed| {
                return move failed;
            }
            var right = empty_name();
            if try self.read_comptime_only(tree, copied.right, &var right) |failed| {
                return move failed;
            }
            out.* = left;
            return null;
        },
        Cast(value) => {
            let copied = value;
            var inner = empty_name();
            if try self.read_comptime_only(tree, copied.value, &var inner) |failed| {
                return move failed;
            }
            out.* = try self.names.intern_type(tree, copied.target_type);
            return null;
        },
        Call(value) => return self.read_comptime_call(tree, value, out),
        _ => return try self.error0(
            ast::zero_span(), "borrow error: runtime value cannot cross comptime boundary"
        ),
    }
}

/// Reads a call a comptime expression may make, the Go `readComptimeCall`:
/// a target or meta predicate, or a std::math function of comptime
/// arguments.
fn (self: &var Checker) read_comptime_call(
    tree: &ast::Ast,
    call: ast::CallExpr,
    out: &var Name
) -> !?diagnostic::Diagnostic {
    if try self.target_predicate_call(tree, call) |_| {
        out.* = self.common.bool_name;
        return null;
    }
    if try self.meta_predicate_call(tree, call) |_| {
        out.* = self.common.bool_name;
        return null;
    }
    if !try self.comptime_math_call(tree, call) {
        return try self.error0(
            ast::zero_span(), "borrow error: runtime value cannot cross comptime boundary"
        );
    }
    var index = 0;
    while arg_at(tree, call.args, index) |argument| {
        var argument_type = empty_name();
        if try self.read_comptime_only(tree, argument, &var argument_type) |failed| {
            return move failed;
        }
        index = index + 1;
    }
    out.* = self.common.f64_name;
    return null;
}

/// Reports whether a call is one of the std::math functions a float comptime
/// expression may make, the Go `comptimeMathCall`.
fn (self: &var Checker) comptime_math_call(tree: &ast::Ast, call: ast::CallExpr) -> !bool {
    let apply = type_apply_expr(tree, call.callee) orelse return false;
    let name = try self.qualified_name(tree, apply.callee) orelse return false;
    let retained = name_text(&self.names, name);
    let bytes = retained.as_bytes();
    return stdmath::names(bytes);
}

/// Evaluates f64 compile-time arithmetic for ownership branch selection, the
/// Go `floatLiteral`, with the same bits the type checker and the lowerer
/// compute.
fn (self: &var Checker) float_literal(tree: &ast::Ast, expression: ast::Expression) -> !?f64 {
    if comptime_expr(tree, expression) |wrapped| {
        return self.float_literal(tree, wrapped.expr);
    }
    if float_expr(tree, expression) |literal| {
        let retained = tree.texts.at(literal.value.node);
        let bytes = retained.as_bytes();
        return typ::parse_float_literal(self.allocator, bytes);
    }
    if cast_expr(tree, expression) |converted| {
        let target = try self.names.intern_type(tree, converted.target_type);
        if !self.names.is(target, "f64") {
            return null;
        }
        if self.int_literal(tree, converted.value) |integer| {
            return cast<f64>(integer);
        }
        return self.float_literal(tree, converted.value);
    }
    if prefix_expr(tree, expression) |prefix| {
        let value = try self.float_literal(tree, prefix.right) orelse return null;
        if !text_equals(tree, prefix.operator, "-") {
            return null;
        }
        return -value;
    }
    if binary_expr(tree, expression) |binary| {
        let left = try self.float_literal(tree, binary.left) orelse return null;
        let right = try self.float_literal(tree, binary.right) orelse return null;
        let retained = tree.texts.at(binary.operator.node);
        let operator = retained.as_bytes();
        return stdmath::binary(operator, left, right);
    }
    if call_expr(tree, expression) |call| {
        if !try self.comptime_math_call(tree, call) {
            return null;
        }
        var count = 0;
        var first = 0.0;
        while arg_at(tree, call.args, count) |argument| {
            let value = try self.float_literal(tree, argument) orelse return null;
            if count == 0 {
                first = value;
            }
            count = count + 1;
        }
        let apply = type_apply_expr(tree, call.callee) orelse return null;
        let name = try self.qualified_name(tree, apply.callee) orelse return null;
        let retained = name_text(&self.names, name);
        let bytes = retained.as_bytes();
        return stdmath::call(bytes, count, first, stdtarget::is_native(self.target));
    }
    return null;
}

/// Answers a compiler-defined std::target predicate; null reports that the
/// call was not one.
fn (self: &var Checker) target_predicate_call(
    tree: &ast::Ast,
    call: ast::CallExpr
) -> !?bool {
    let name = try self.qualified_name(tree, call.callee) orelse return null;
    let owned = try self.names.copy(name);
    defer owned.deinit(self.allocator);
    let name_bytes = owned.as_bytes();
    let predicate = stdtarget::identify(name_bytes) orelse return null;
    if arg_count(tree, call.args) != 0 {
        return null;
    }
    return stdtarget::evaluate(self.target, predicate);
}

/// Answers the predicates that ask which declaration a type came from, the
/// Go `declaredKindPredicate`; null reports that the form was not one of
/// them.
fn (self: &Checker) declared_kind_predicate(form: stdmeta::Form, subject: Name) -> ?bool {
    match form {
        IsStruct => return self.is_struct(subject),
        IsEnum => return self.is_enum(subject),
        IsUnion => return self.is_union(subject),
        IsError => return self.is_error_set(subject),
        _ => return null,
    }
}

/// Answers a `std::meta` predicate written as a compile-time condition, the
/// Go `metaPredicateCall`; null reports that the call was not one.
fn (self: &var Checker) meta_predicate_call(tree: &ast::Ast, call: ast::CallExpr) -> !?bool {
    let apply = type_apply_expr(tree, call.callee) orelse return null;
    let name = try self.qualified_name(tree, apply.callee) orelse return null;
    let owned = try self.names.copy(name);
    defer owned.deinit(self.allocator);
    let name_bytes = owned.as_bytes();
    if !stdmeta::predicate(name_bytes) or arg_count(tree, call.args) != 0 {
        return null;
    }
    let raw = try self.names.intern_text(tree, apply.type_arg);
    let subject = try self.instantiate_type_arg_text(raw);
    let form = self.meta_form(name) orelse return null;
    if form == stdmeta::Form::HasPayload {
        let args = try self.names.split_generic_args(subject) orelse return null;
        defer args.deinit(self.allocator);
        var variant = MetaField {
            owner: empty_name(),
            name: empty_name(),
            typ: empty_name(),
            variant: false,
            origin: empty_name()
        };
        if try self.meta_capture(tree, form, &args, &var variant) |failed| {
            failed.deinit(self.allocator);
            return null;
        }
        return !is_empty(variant.typ);
    }
    if self.declared_kind_predicate(form, subject) |known| {
        return known;
    }
    match form {
        IsOptional => return self.names.is_optional(subject),
        IsArray => return self.names.generic_base_is(subject, "std::array::Array"),
        IsBox => return self.names.generic_base_is(subject, "std::mem::Box"),
        IsMap => return self.names.generic_base_is(subject, "std::map::Map"),
        IsOwner => return self.owner_type(subject),
        ReleaseNamesAllocator => return self.release_names_allocator(subject),
        HasPublicFields => return self.struct_has_public_fields(subject),
        _ => return null,
    }
}

/// Reports whether a type spelling carries a cleanup contract, the Go
/// `ast.OwnerType(c.deinitOwners, subject)`.
fn (self: &Checker) owner_type(type_name: Name) -> bool {
    let retained = name_text(&self.names, type_name);
    let bytes = retained.as_bytes();
    return ast::owner_type(&self.deinit_owners, bytes);
}

/// Reports whether releasing a type names an allocator (ADR-0132).
fn (self: &Checker) release_names_allocator(type_name: Name) -> bool {
    let retained = name_text(&self.names, type_name);
    let bytes = retained.as_bytes();
    return ast::release_names(&self.release_allocators, bytes);
}

/// Evaluates simple compile-time boolean expressions for ownership branch
/// checks, the Go `comptimeBool`.
fn (self: &var Checker) comptime_bool(tree: &ast::Ast, expression: ast::Expression) -> !?bool {
    match tree.expressions.at(expression.node) {
        Comptime(value) => return self.comptime_bool(tree, value.expr),
        Bool(value) => return value.value,
        Ident(value) => {
            let retained = tree.texts.at(value.name.node);
            let bytes = retained.as_bytes();
            let bound = self.comptime_values.get(bytes) orelse return null;
            if self.names.is(bound, "true") {
                return true;
            }
            if self.names.is(bound, "false") {
                return false;
            }
            return null;
        },
        Call(value) => {
            let copied = value;
            if try self.target_predicate_call(tree, copied) |selected| {
                return selected;
            }
            return self.meta_predicate_call(tree, copied);
        },
        Prefix(value) => {
            let copied = value;
            let inner = try self.comptime_bool(tree, copied.right) orelse return null;
            if !text_equals(tree, copied.operator, "!") {
                return null;
            }
            return !inner;
        },
        Binary(value) => return self.comptime_binary_bool(tree, value),
        _ => return null,
    }
}

/// Evaluates a compile-time logical operator, a type comparison, or an
/// integer or float comparison, the Go `comptimeBinaryBool`.
fn (self: &var Checker) comptime_binary_bool(tree: &ast::Ast, binary: ast::BinaryExpr) -> !?bool {
    let logical = text_equals(tree, binary.operator, "and") or
        text_equals(tree, binary.operator, "or");
    if logical {
        return self.comptime_logical_bool(tree, binary);
    }
    if try self.comptime_type_value(tree, binary.left) |left_type| {
        if try self.comptime_type_value(tree, binary.right) |right_type| {
            return compare_comptime_types(tree, binary.operator, left_type, right_type);
        }
    }
    if self.int_literal(tree, binary.left) |left| {
        if self.int_literal(tree, binary.right) |right| {
            return compare_comptime_ints(tree, binary.operator, left, right);
        }
    }
    let left_float = try self.float_literal(tree, binary.left) orelse return null;
    let right_float = try self.float_literal(tree, binary.right) orelse return null;
    let retained = tree.texts.at(binary.operator.node);
    let operator = retained.as_bytes();
    return stdmath::compare(operator, left_float, right_float);
}

/// Returns a type value from the minimal compile-time type subset, the Go
/// `comptimeTypeValue`.
fn (self: &var Checker) comptime_type_value(
    tree: &ast::Ast,
    expression: ast::Expression
) -> !?Name {
    match tree.expressions.at(expression.node) {
        Comptime(value) => return self.comptime_type_value(tree, value.expr),
        Type(value) => {
            let copied = value;
            let raw = try self.names.intern_text(tree, copied.type_name);
            let name = try self.instantiate_type_arg_text(raw);
            if is_empty(name) {
                return null;
            }
            return name;
        },
        Ident(value) => {
            let retained = tree.texts.at(value.name.node);
            let bytes = retained.as_bytes();
            return self.type_arg_values.get(bytes);
        },
        _ => return null,
    }
}

/// Evaluates equality on compile-time type values, the Go
/// `compareComptimeTypes`.
pub fn compare_comptime_types(
    tree: &ast::Ast,
    op: ast::Text,
    left: Name,
    right: Name
) -> ?bool {
    if text_equals(tree, op, "==") {
        return same_name(left, right);
    }
    if text_equals(tree, op, "!=") {
        return !same_name(left, right);
    }
    return null;
}

/// Evaluates constant boolean logical expressions, the Go
/// `comptimeLogicalBool`.
fn (self: &var Checker) comptime_logical_bool(tree: &ast::Ast, binary: ast::BinaryExpr) -> !?bool {
    let left = try self.comptime_bool(tree, binary.left) orelse return null;
    if text_equals(tree, binary.operator, "and") and !left {
        return false;
    }
    if text_equals(tree, binary.operator, "or") and left {
        return true;
    }
    let right = try self.comptime_bool(tree, binary.right) orelse return null;
    if text_equals(tree, binary.operator, "and") {
        return left and right;
    }
    return left or right;
}
