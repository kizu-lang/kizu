import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::typ;
import std::array;
import std::map;

fn (self: &var Checker) check_block(
    tree: &var ast::Ast,
    env: ScopeHandle,
    block: ast::Block
) -> !?diagnostic::Diagnostic {
    let err_defer_mark = self.live_err_defers.len();
    let pending_mark = self.pending_owner_temps.len();
    let places_mark = self.pending_moved_places.len();
    if try self.check_block_statements(tree, env, block) |failed| {
        self.restore_err_defers(err_defer_mark);
        self.truncate_owner_temps(pending_mark);
        self.truncate_moved_places(places_mark);
        return move failed;
    }
    self.restore_err_defers(err_defer_mark);
    self.truncate_owner_temps(pending_mark);
    self.truncate_moved_places(places_mark);
    return null;
}

fn (self: &var Checker) check_block_statements(
    tree: &var ast::Ast,
    env: ScopeHandle,
    block: ast::Block
) -> !?diagnostic::Diagnostic {
    var last_uses = try self.ident_uses.block_last_uses(self.allocator, tree, block);
    defer last_uses.deinit(self.allocator);
    var defers = array::new<ast::Statement>(self.allocator);
    defer defers.deinit(self.allocator);
    let binding_mark = self.store.id_mark();
    let pending_mark = self.pending_owner_temps.len();
    let places_mark = self.pending_moved_places.len();
    var index = 0;
    while block_statement_at(tree, block, index) |statement| {
        self.truncate_owner_temps(pending_mark);
        self.truncate_moved_places(places_mark);
        if defer_stmt(tree, statement) |deferred| {
            if try self.check_defer_stmt(tree, env, deferred) |failed| {
                return diagnostic::locate(move failed, tree.statement_span(statement));
            }
            try defers.append(self.allocator, statement);
            try self.release_last_use_borrows(env, index, &last_uses);
            index = index + 1;
            continue;
        }
        if errdefer_stmt(tree, statement) |deferred| {
            if try self.check_err_defer_stmt(tree, env, deferred) |failed| {
                return diagnostic::locate(move failed, tree.statement_span(statement));
            }
            try self.release_last_use_borrows(env, index, &last_uses);
            index = index + 1;
            continue;
        }
        if try self.check_stmt(tree, env, statement) |failed| {
            return move failed;
        }
        if self.pending_alloc_taints.get(0) |taint| {
            while self.pending_alloc_taints.pop() |_| {}
            return try self.error0(
                taint.span,
                "borrow error: a value allocated from a tied allocator must be bound with `let`"
            );
        }
        try self.release_last_use_borrows(env, index, &last_uses);
        index = index + 1;
    }
    if try self.check_deferred_cleanups(tree, env, &defers) |failed| {
        return move failed;
    }
    if self.block_terminates(tree, block) {
        return null;
    }
    return self.check_owners_consumed(tree, env, binding_mark, plain_exit());
}

fn (self: &var Checker) restore_err_defers(mark: i64) -> void {
    while self.live_err_defers.len() > mark {
        let _ = self.live_err_defers.pop();
    }
    return;
}

fn (self: &var Checker) check_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::Statement
) -> !?diagnostic::Diagnostic {
    if try self.check_stmt_form(tree, env, statement) |problem| {
        return diagnostic::locate(move problem, tree.statement_span(statement));
    }
    return null;
}

fn (self: &var Checker) check_stmt_form(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::Statement
) -> !?diagnostic::Diagnostic {
    if let_stmt(tree, statement) |value| {
        return self.check_let_stmt(tree, env, value);
    }
    if assign_stmt(tree, statement) |value| {
        return self.check_assign_stmt(tree, env, value);
    }
    if return_stmt(tree, statement) |value| {
        return self.check_return_stmt(tree, env, statement, value);
    }
    if defer_stmt(tree, statement) |_| {
        return try self.error0(ast::zero_span(), "move error: defer statement must appear directly in a block");
    }
    if errdefer_stmt(tree, statement) |_| {
        return try self.error0(ast::zero_span(), "move error: errdefer statement must appear directly in a block");
    }
    if expr_stmt(tree, statement) |value| {
        return self.check_expr_stmt(tree, env, value.expr);
    }
    return self.check_body_stmt(tree, env, statement);
}

fn (self: &var Checker) check_body_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::Statement
) -> !?diagnostic::Diagnostic {
    if if_stmt(tree, statement) |value| {
        return self.check_if_stmt(tree, env, value);
    }
    if while_stmt(tree, statement) |value| {
        return self.check_while_stmt(tree, env, value);
    }
    if for_stmt(tree, statement) |value| {
        return self.check_for_stmt(tree, env, value);
    }
    if break_stmt(tree, statement) |value| {
        return self.check_loop_branch_label(tree, env, LeakExitKind::Break, value.label);
    }
    if continue_stmt(tree, statement) |value| {
        return self.check_loop_branch_label(tree, env, LeakExitKind::Continue, value.label);
    }
    if is_match_stmt(tree, statement) {
        return self.check_match_stmt(tree, env, statement);
    }
    if is_block_stmt(tree, statement) {
        return self.check_block(tree, env, ast::Block { node: statement.node, location: null });
    }
    if comptime_if_stmt(tree, statement) |value| {
        return self.check_comptime_if_stmt(tree, env, value);
    }
    if comptime_match_stmt(tree, statement) |value| {
        return self.check_comptime_match_stmt(tree, env, value);
    }
    if comptime_for_stmt(tree, statement) |value| {
        return self.check_comptime_for_stmt(tree, env, value);
    }
    return try self.error0(ast::zero_span(), "move error: unsupported statement *ast.RecoveredStmt");
}

fn (self: &var Checker) check_defer_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::DeferStmt
) -> !?diagnostic::Diagnostic {
    return self.register_cleanup(tree, env, CleanupKind::Defer, statement.expr);
}

fn (self: &var Checker) check_err_defer_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::ErrDeferStmt
) -> !?diagnostic::Diagnostic {
    return self.register_cleanup(tree, env, CleanupKind::ErrDefer, statement.expr);
}

enum CleanupKind {
    Defer,
    ErrDefer,
}

fn cleanup_keyword(kind: CleanupKind) -> []u8 {
    match kind {
        Defer => return "defer",
        ErrDefer => return "errdefer",
    }
}

fn (self: &var Checker) register_cleanup(
    tree: &var ast::Ast,
    env: ScopeHandle,
    kind: CleanupKind,
    expression: ast::Expression
) -> !?diagnostic::Diagnostic {
    let keyword = try self.names.intern(cleanup_keyword(kind));
    let call = call_expr(tree, unwrap_expression_markers(tree, expression)) orelse
        return try self.error1(tree, ast::zero_span(), "move error: %s expects a void call", Arg::Str(keyword));
    var owner = DeferredOwner { value: null, expression: expression };
    if try self.read_deferred_call(tree, env, kind, call, &var owner) |failed| {
        return move failed;
    }
    if owner.value |found| {
        if try self.check_cleanup_not_registered(tree, found, owner.expression) |failed| {
            return move failed;
        }
    }
    match kind {
        Defer => {
            if owner.value |found| {
                if self.store.binding_mut(found) |record| {
                    record.defer_cleanup = true;
                }
            }
            return null;
        },
        ErrDefer => {
            var entry = ErrDeferEntry { receiver: owner.expression, name: empty_name(), id: 0 };
            if owner.value |found| {
                entry.name = self.binding(found).name;
                entry.id = self.binding(found).id;
            }
            try self.live_err_defers.append(self.allocator, entry);
            return null;
        },
    }
}

struct DeferredOwner {
    value: ?BindingHandle,
    expression: ast::Expression,
}

fn (self: &var Checker) read_deferred_call(
    tree: &var ast::Ast,
    env: ScopeHandle,
    kind: CleanupKind,
    call: ast::CallExpr,
    owner: &var DeferredOwner
) -> !?diagnostic::Diagnostic {
    let keyword = try self.names.intern(cleanup_keyword(kind));
    if field_expr(tree, call.callee) |field| {
        if !field.namespace {
            var receiver_type = empty_name();
            if try self.read_expr(tree, env, field.receiver, &var receiver_type) |failed| {
                return move failed;
            }
            if try self.check_deferred_release_args(tree, env, receiver_type, &field, call.args) |failed| {
                return move failed;
            }
            try self.record_deferred_method_callee(tree, call.callee, field, receiver_type);
            if self.lookup_ident(tree, env, field.receiver) |found| {
                if try self.method_consumes_receiver(found, tree, field.name) {
                    owner.value = found;
                    owner.expression = field.receiver;
                }
            }
        }
    }
    var index = 0;
    while arg_at(tree, call.args, index) |argument| {
        index = index + 1;
        if move_expr(tree, argument) |marker| {
            if try self.read_moved_deferred_arg(tree, env, keyword, marker, owner) |failed| {
                return move failed;
            }
        } else {
            var ignored = empty_name();
            if try self.read_expr(tree, env, argument, &var ignored) |failed| {
                return move failed;
            }
        }
    }
    return null;
}

fn (self: &var Checker) record_deferred_method_callee(
    tree: &ast::Ast,
    callee: ast::Expression,
    field: ast::FieldExpr,
    receiver_type: Name
) -> !void {
    var value_type = receiver_type;
    if try self.names.explicit_borrow(receiver_type) |parts| {
        value_type = parts.inner;
    }
    let method = try self.names.intern_text(tree, field.name);
    if try self.std_container_base(value_type) |base| {
        let name = try self.names.format("%s.%s", base, method, empty_name());
        return self.record_method_callee(callee, method_call_key(tree, callee), name);
    }
    let function = self.impl_method(value_type, method) orelse return;
    return self.record_method_callee(callee, method_call_key(tree, callee), self.functions.at(function.index).name);
}

fn (self: &var Checker) read_moved_deferred_arg(
    tree: &var ast::Ast,
    env: ScopeHandle,
    keyword: Name,
    marker: ast::MoveExpr,
    owner: &var DeferredOwner
) -> !?diagnostic::Diagnostic {
    var ignored = empty_name();
    if try self.read_expr(tree, env, marker.value, &var ignored) |failed| {
        return move failed;
    }
    if ident_text(tree, marker.value) |_name| {} else {
        let rendered = try ast::render_expression(self.allocator, tree, marker.value);
        let place = try self.names.intern_owned(move rendered);
        return try self.error2(
            tree, marker.span, "move error: %s can only move a local binding, got `%s`",
            Arg::Str(keyword), Arg::Str(place)
        );
    }
    let found = self.lookup_ident(tree, env, marker.value) orelse return null;
    if owner.value |first| {
        return try self.error3(
            tree, marker.span,
            "move error: %s call consumes both `%s` and `%s`; a deferred call consumes at most one owner",
            Arg::Str(keyword), Arg::Str(self.binding(first).name), Arg::Str(self.binding(found).name)
        );
    }
    owner.value = found;
    owner.expression = marker.value;
    return null;
}

fn (self: &var Checker) method_consumes_receiver(value: BindingHandle, tree: &ast::Ast, method: ast::Text) -> !bool {
    let type_name = self.binding(value).type_name;
    let receiver_type = try self.names.generic_base_or_self(type_name);
    if self.impl_method_text(receiver_type, tree, method) |info| {
        return self.function_consumes_receiver(info);
    }
    if !text_equals(tree, method, typ::cleanup_method()) {
        return false;
    }
    return self.value_type_needs_consume(self.allocator, type_name);
}

fn (self: &var Checker) check_cleanup_not_registered(
    tree: &var ast::Ast,
    value: BindingHandle,
    receiver: ast::Expression
) -> !?diagnostic::Diagnostic {
    var keyword = "";
    if self.binding(value).defer_cleanup {
        keyword = "defer";
    } else {
        if self.err_defer_covers_id(self.binding(value).id) {
            keyword = "errdefer";
        } else {
            return null;
        }
    }
    let spelling = try self.names.intern(keyword);
    return try self.error2(
        tree, expression_span(tree, receiver),
        "move error: `%s` already has a registered `%s` cleanup; a second cleanup would release it twice",
        Arg::Str(self.binding(value).name), Arg::Str(spelling)
    );
}

fn (self: &var Checker) check_deferred_release_args(
    tree: &var ast::Ast,
    env: ScopeHandle,
    receiver_type: Name,
    field: &ast::FieldExpr,
    args: ast::ExpressionList
) -> !?diagnostic::Diagnostic {
    if arg_count(tree, args) != 1 or !text_equals(tree, field.name, typ::cleanup_method()) {
        return null;
    }
    let receiver = self.lookup_ident(tree, env, field.receiver) orelse return null;
    let label = try self.release_label(receiver_type);
    let argument = args.get_or_panic(tree, 0);
    return self.check_release_tie(tree, env, label, receiver, argument);
}

fn (self: &var Checker) release_label(receiver_type: Name) -> !Name {
    let borrowed = try self.names.trim_prefix(receiver_type, "&var ");
    let owned = try self.names.trim_prefix(borrowed, "&");
    let base = try self.names.generic_base_or_self(owned);
    let tail = try self.names.after_last_path_separator(base);
    return self.names.format("%s.deinit", tail, empty_name(), empty_name());
}

fn (self: &var Checker) validate_err_defer_receivers(
    tree: &ast::Ast,
    env: ScopeHandle,
    retired: &var array::Array<ast::Expression>
) -> !?diagnostic::Diagnostic {
    var index = 0;
    while self.live_err_defers.get(index) |entry| {
        index = index + 1;
        if entry.id == 0 {
            continue;
        }
        let entry_name = name_text(&self.names, entry.name);
        let entry_bytes = entry_name.as_bytes();
        let value = self.store.find_named_id(env, entry_bytes, entry.id) orelse continue;
        if self.binding_consumed(value) {
            try retired.append(self.allocator, entry.receiver);
            continue;
        }
        let record = self.binding(value);
        if record.active_borrows - record.reservations > 0 or record.active_mut_borrows > 0 {
            return try self.error1(
                tree, ast::zero_span(),
                "borrow error: errdefer cleanup receiver `%s` is borrowed on an error path",
                Arg::Str(entry.name)
            );
        }
    }
    return null;
}

fn (self: &var Checker) value_type_needs_consume(allocator: Allocator, type_name: Name) -> !bool {
    let retained = name_text(&self.names, type_name);
    let bytes = retained.as_bytes();
    if self.consume_needs.get(bytes) |needs| {
        return needs;
    }
    let needs = ast::owner_type(&self.deinit_owners, bytes);
    try self.consume_needs.insert(allocator, bytes, needs);
    return needs;
}

fn (self: &var Checker) field_type_needs_consume(type_name: Name) -> !bool {
    if try self.names.optional_elem(type_name) |elem| {
        return self.value_type_needs_consume(self.allocator, elem);
    }
    return self.value_type_needs_consume(self.allocator, type_name);
}

fn (self: &var Checker) result_type_needs_consume(type_name: Name) -> !bool {
    var current = type_name;
    while true {
        if try self.names.error_union_parts(current) |parts| {
            current = parts.success;
            continue;
        }
        if try self.names.optional_elem(current) |elem| {
            current = elem;
            continue;
        }
        return self.value_type_needs_consume(self.allocator, current);
    }
    return false;
}

fn (self: &var Checker) binding_needs_consume(value: BindingHandle) -> !bool {
    let record = self.binding(value);
    if record.moved or record.deinitialized or record.defer_cleanup {
        return false;
    }
    if record.borrowed_param or record.local_borrow or record.consume_exempt {
        return false;
    }
    if record.handle_arena_id != 0 {
        return false;
    }
    if try self.all_owner_fields_consumed(value) {
        return false;
    }
    return self.value_type_needs_consume(self.allocator, record.type_name);
}

fn (self: &var Checker) all_owner_fields_consumed(value: BindingHandle) -> !bool {
    let type_name = self.binding(value).type_name;
    if !self.store.has_field_deinit(value) or self.declares_deinit(type_name) {
        return false;
    }
    if !self.is_struct(type_name) {
        return false;
    }
    var index = 0;
    while self.struct_field_at(type_name, index) |field| {
        index = index + 1;
        let field_type = self.struct_field_type(type_name, field) orelse continue;
        if try self.field_type_needs_consume(field_type) and !self.field_deinit_name(value, field) {
            return false;
        }
    }
    return true;
}

fn (self: &Checker) declares_deinit(type_name: Name) -> bool {
    let retained = name_text(&self.names, type_name);
    let bytes = retained.as_bytes();
    return ast::owner_type(&self.declared_deinits, bytes);
}

pub enum LeakExitKind {
    Plain,
    Try,
    ErrorReturn,
    Break,
    Continue,
}

pub struct LeakExit {
    pub kind: LeakExitKind,
    pub span: ast::Span,
}

pub fn plain_exit() -> LeakExit {
    return LeakExit { kind: LeakExitKind::Plain, span: ast::zero_span() };
}

fn (self: &var Checker) check_owners_consumed(
    tree: &ast::Ast,
    env: ScopeHandle,
    since_id: i64,
    exit: LeakExit
) -> !?diagnostic::Diagnostic {
    let error_path = exit.kind == LeakExitKind::Try or exit.kind == LeakExitKind::ErrorReturn;
    var leaked = none_binding();
    var walker = self.store.walk_owners(env);
    while walker.next(&self.store) |value| {
        if self.binding(value).id <= since_id or !try self.binding_needs_consume(value) {
            continue;
        }
        if error_path and self.err_defer_covers_id(self.binding(value).id) {
            continue;
        }
        if leaked |seen| {
            if self.binding(value).id > self.binding(seen).id {
                leaked = value;
            }
        } else {
            leaked = value;
        }
    }
    let found = leaked orelse return null;
    return try self.leak_error(tree, found, exit);
}

fn (self: &Checker) leak_error(tree: &ast::Ast, value: BindingHandle, exit: LeakExit) -> !diagnostic::Diagnostic {
    let name = self.binding(value).name;
    if exit.kind == LeakExitKind::Try {
        return self.error1(
            tree, exit.span,
            "move error: owned value `%s` would leak on this `try`'s error exit; register `defer` or `errdefer` cleanup before it",
            Arg::Str(name)
        );
    }
    if exit.kind == LeakExitKind::ErrorReturn {
        return self.error1(
            tree, exit.span,
            "move error: owned value `%s` would leak on this error return; register `defer` or `errdefer` cleanup before it",
            Arg::Str(name)
        );
    }
    if exit.kind == LeakExitKind::Break {
        return self.error1(
            tree, self.binding(value).decl_span,
            "move error: owned value `%s` is not released before `break` leaves the loop",
            Arg::Str(name)
        );
    }
    if exit.kind == LeakExitKind::Continue {
        return self.error1(
            tree, self.binding(value).decl_span,
            "move error: owned value `%s` is not released before `continue` ends the turn",
            Arg::Str(name)
        );
    }
    return self.error1(
        tree, self.binding(value).decl_span,
        "move error: owned value `%s` is never deinitialized", Arg::Str(name)
    );
}

fn (self: &var Checker) check_cleanup_receiver_overwrite(
    tree: &ast::Ast,
    target: BindingHandle,
    statement: ast::AssignStmt
) -> !?diagnostic::Diagnostic {
    let name = self.binding(target).name;
    var keyword = "";
    if self.binding(target).defer_cleanup {
        keyword = "defer";
    } else {
        if self.err_defer_covers_id(self.binding(target).id) {
            keyword = "errdefer";
        } else {
            return null;
        }
    }
    let spelling = try self.names.intern(keyword);
    return try self.error2(
        tree, expression_span(tree, statement.value),
        "move error: `%s` cleanup receiver `%s` cannot be assigned over; bind the new value to its own name",
        Arg::Str(spelling), Arg::Str(name)
    );
}

fn (self: &Checker) err_defer_covers_id(id: i64) -> bool {
    if id == 0 {
        return false;
    }
    var index = 0;
    while self.live_err_defers.get(index) |entry| {
        if entry.id == id {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn (self: &Checker) block_terminates(tree: &ast::Ast, block: ast::Block) -> bool {
    let count = block_len(tree, block);
    if count == 0 {
        return false;
    }
    let last = block_statement_at(tree, block, count - 1) orelse return false;
    return self.stmt_terminates(tree, last);
}

fn (self: &Checker) stmt_terminates(tree: &ast::Ast, statement: ast::Statement) -> bool {
    if is_return_stmt(tree, statement) {
        return true;
    }
    if is_block_stmt(tree, statement) {
        return self.block_terminates(tree, ast::Block { node: statement.node, location: null });
    }
    if if_stmt(tree, statement) |value| {
        let alternative = value.alternative orelse return false;
        return self.block_terminates(tree, value.consequence) and
            self.block_terminates(tree, alternative);
    }
    if match_stmt_head(tree, statement) |head| {
        if head.arm_count == 0 {
            return false;
        }
        var index = 0;
        while self.match_arm_body(tree, statement, index) |body| {
            if !self.stmt_terminates(tree, body) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
    return false;
}

fn (self: &Checker) match_arm_body(tree: &ast::Ast, statement: ast::Statement, index: i64) -> ?ast::Statement {
    match tree.statements.at(statement.node) {
        Match(value) => {
            let arm = value.arms.get(index) orelse return null;
            return arm.body;
        },
        _ => return null,
    }
}

fn (self: &var Checker) check_deferred_cleanups(
    tree: &var ast::Ast,
    env: ScopeHandle,
    defers: &array::Array<ast::Statement>
) -> !?diagnostic::Diagnostic {
    var no_later_uses = map::new<[]u8, i64>(self.allocator);
    defer no_later_uses.deinit(self.allocator);
    var index = defers.len();
    while index > 0 {
        index = index - 1;
        let statement = defers.get_or_panic(index);
        let deferred = defer_stmt(tree, statement) orelse continue;
        if try self.check_expr_stmt(tree, env, deferred.expr) |failed| {
            return diagnostic::locate(move failed, tree.statement_span(statement));
        }
        try self.release_last_use_borrows(env, 0, &no_later_uses);
    }
    return null;
}

fn (self: &var Checker) check_return_stmt(
    tree: &var ast::Ast,
    env: ScopeHandle,
    statement: ast::Statement,
    value: ast::ReturnStmt
) -> !?diagnostic::Diagnostic {
    if self.current_function |function| {
        if try self.check_deinit_completeness(tree, function, env) |failed| {
            return move failed;
        }
    }
    let returned = value.value orelse return self.check_owners_consumed(tree, env, 0, plain_exit());
    var done = false;
    if try self.check_return_value_escapes(tree, env, returned, &var done) |failed| {
        return move failed;
    }
    if done {
        return null;
    }
    let error_path = try self.return_takes_error_path(tree, env, returned);
    if error_path {
        var retired = array::new<ast::Expression>(self.allocator);
        errdefer retired.deinit(self.allocator);
        if try self.validate_err_defer_receivers(tree, env, &var retired) |failed| {
            retired.deinit(self.allocator);
            return move failed;
        }
        try self.result.return_retired_err_defers.append(self.allocator, RetiredErrDefers {
            node: statement.node, receivers: move retired
        });
    }
    let saved = self.borrow_return;
    if self.current_function |function| {
        if self.names.is_borrow_optional(self.return_type_name(function)) {
            self.borrow_return = true;
        }
    }
    var ignored = empty_name();
    if try self.move_expr(tree, env, returned, &var ignored) |failed| {
        self.borrow_return = saved;
        self.clear_returned_views();
        return move failed;
    }
    self.borrow_return = saved;
    self.clear_returned_views();
    var exit = plain_exit();
    if error_path {
        exit = LeakExit { kind: LeakExitKind::ErrorReturn, span: expression_span(tree, returned) };
    }
    return self.check_owners_consumed(tree, env, 0, exit);
}

fn (self: &var Checker) return_takes_error_path(
    tree: &ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression
) -> !bool {
    let type_name = try self.returned_type_name(tree, env, expression) orelse return false;
    if self.is_error_set(type_name) {
        return true;
    }
    if try self.names.error_union_parts(type_name) |_| {
        return true;
    }
    return false;
}

fn (self: &var Checker) returned_type_name(
    tree: &ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression
) -> !?Name {
    if self.lookup_ident(tree, env, expression) |value| {
        return self.binding(value).type_name;
    }
    if ident_text(tree, expression) |_| {
        return null;
    }
    let field = field_expr(tree, expression) orelse return null;
    if !field.namespace {
        return null;
    }
    var out = empty_name();
    if try self.read_namespace_expr(tree, field, &var out) |failed| {
        failed.deinit(self.allocator);
        return null;
    }
    return out;
}

fn (self: &var Checker) check_return_value_escapes(
    tree: &var ast::Ast,
    env: ScopeHandle,
    returned: ast::Expression,
    done: &var bool
) -> !?diagnostic::Diagnostic {
    done.* = true;
    var roots = array::new<BindingHandle>(self.allocator);
    defer roots.deinit(self.allocator);
    try self.returned_view_roots(tree, env, returned, &var roots);
    if roots.len() > 0 and self.param_rooted_all(&roots) {
        try self.record_returned_views(tree, returned);
    }
    if ident_expr(tree, returned) |ident| {
        if self.lookup_text(tree, env, ident.name) |value| {
            if self.binding(value).borrowed_param and !self.returned_view(returned) {
                if try self.borrowed_return_allowed(tree, ident.name, value) {
                    return null;
                }
                return try self.error1(
                    tree, ident.span, "borrow error: borrowed value `%s` cannot escape",
                    Arg::Text(ident.name)
                );
            }
            let handle_arena_id = self.binding(value).handle_arena_id;
            if handle_arena_id != 0 and !self.arena_outlives_frame(handle_arena_id, env) {
                return try self.error1(
                    tree, ident.span, "arena error: handle `%s` cannot outlive its arena",
                    Arg::Text(ident.name)
                );
            }
        }
    }
    if try self.arena_add_receiver(tree, env, returned) |arena| {
        let arena_id = self.binding(arena).arena_id;
        if arena_id != 0 and !self.arena_outlives_frame(arena_id, env) {
            return try self.error1(
                tree, ast::zero_span(), "arena error: handle from `%s` cannot outlive its arena",
                Arg::Str(self.binding(arena).name)
            );
        }
    }
    var handled = false;
    if try self.check_arena_borrow_return_exit(tree, env, returned, &var handled) |failed| {
        return move failed;
    }
    if handled {
        return null;
    }
    if call_expr(tree, returned) |call| {
        if try self.check_tied_allocator_return(tree, env, call, &var handled) |failed| {
            return move failed;
        }
        if handled {
            return self.check_owners_consumed(tree, env, 0, plain_exit());
        }
    }
    done.* = false;
    return null;
}

fn (self: &var Checker) clear_returned_views() -> void {
    while self.returned_views.pop() |_| {}
    return;
}

fn (self: &var Checker) returned_view_roots(
    tree: &ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    out: &var array::Array<BindingHandle>
) -> !void {
    let unwrapped = unwrap_expression_markers(tree, expression);
    if is_struct_literal_expr(tree, unwrapped) {
        var index = 0;
        while struct_literal_field_at(tree, unwrapped, index) |field| {
            index = index + 1;
            try self.returned_view_roots(tree, env, field.value, out);
        }
        return;
    }
    return self.borrow_class_view_roots(tree, env, expression, out);
}

fn (self: &Checker) param_rooted_all(roots: &array::Array<BindingHandle>) -> bool {
    var index = 0;
    while roots.get(index) |root| {
        if !self.param_rooted_binding(root) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn (self: &var Checker) record_returned_views(tree: &ast::Ast, expression: ast::Expression) -> !void {
    try self.returned_views.append(self.allocator, expression);
    let unwrapped = unwrap_expression_markers(tree, expression);
    if is_struct_literal_expr(tree, unwrapped) {
        var index = 0;
        while struct_literal_field_at(tree, unwrapped, index) |field| {
            index = index + 1;
            try self.record_returned_views(tree, field.value);
        }
    }
    return;
}

fn (self: &var Checker) check_arena_borrow_return_exit(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    if try self.check_arena_borrow_return(tree, env, expression, handled) |failed| {
        return move failed;
    }
    if !handled.* {
        return null;
    }
    return self.check_owners_consumed(tree, env, 0, plain_exit());
}

fn (self: &var Checker) check_arena_borrow_return(
    tree: &var ast::Ast,
    env: ScopeHandle,
    expression: ast::Expression,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    let function = self.current_function orelse return null;
    let parts = try self.names.explicit_borrow(self.return_type_name(function)) orelse return null;
    if parts.mutable {
        return null;
    }
    var source = ArenaAtSource { target: null, field: empty_name(), elem: empty_name() };
    if try self.arena_at_borrow_source(tree, env, expression, &var source) |failed| {
        handled.* = true;
        return move failed;
    }
    let target = source.target orelse return null;
    if !same_name(source.elem, parts.inner) {
        return null;
    }
    handled.* = true;
    if !self.param_rooted_binding(target) {
        return try self.error1(
            tree, expression_span(tree, expression),
            "borrow error: Arena.at borrow from local `%s` cannot escape",
            Arg::Str(self.binding(target).name)
        );
    }
    return null;
}

fn (self: &var Checker) check_tied_allocator_return(
    tree: &var ast::Ast,
    env: ScopeHandle,
    call: ast::CallExpr,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    let called = try self.called_user_function(tree, env, call.callee) orelse return null;
    let ret_name = self.return_type_name(called.function);
    if !self.capability_return(ret_name) and !self.tied_struct_return(ret_name) {
        return null;
    }
    var sources = array::new<BorrowSource>(self.allocator);
    defer sources.deinit(self.allocator);
    handled.* = true;
    let mutable = !self.task_set_return(ret_name);
    if try self.call_borrow_return_sources(
        tree, env, called.name, called.function, call, mutable, true, false, &var sources
    ) |failed| {
        return move failed;
    }
    if sources.len() == 0 {
        handled.* = false;
        return null;
    }
    var index = 0;
    while sources.get(index) |source| {
        if !self.param_rooted_binding(source.target) {
            return try self.error1(
                tree, ast::zero_span(),
                "borrow error: `%s` returns a value tied to local state and cannot escape",
                Arg::Str(called.name)
            );
        }
        index = index + 1;
    }
    var ignored = empty_name();
    return self.check_tied_factory_call(tree, env, called.name, call, &var ignored);
}

fn (self: &Checker) param_rooted_binding(value: BindingHandle) -> bool {
    if self.has_borrow_targets(value) {
        var index = 0;
        while self.borrow_target_at(value, index) |source| {
            if !self.param_rooted_binding(source.target) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
    let record = self.binding(value);
    return record.borrowed_param and !record.local_borrow;
}

fn (self: &var Checker) borrowed_return_allowed(
    tree: &ast::Ast,
    name: ast::Text,
    value: BindingHandle
) -> !bool {
    let function = self.current_function orelse return false;
    let parts = try self.names.explicit_borrow(self.return_type_name(function)) orelse return false;
    if parts.mutable and !self.binding(value).mut_borrow {
        return false;
    }
    if !same_name(self.binding(value).type_name, parts.inner) {
        return false;
    }
    var index = 0;
    while self.param_at(function, index) |param| {
        index = index + 1;
        if !self.names.is_text(param.name, tree, name) or !param.borrow {
            continue;
        }
        return !parts.mutable or param.mut_borrow;
    }
    return false;
}
