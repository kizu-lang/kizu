import compiler::internal::typ;
import std::arena;
import std::array;
import std::mem;
import std::string;

// Mechanical port of internal/stdmeta/stdmeta.go. Form metadata is static;
// only names() and split_apply() allocate caller-owned result storage.

/// Identifies one compiler-resolved std::meta form.
pub enum Form {
    IsStruct,
    IsEnum,
    IsUnion,
    IsOptional,
    IsArray,
    IsBox,
    IsMap,
    IsOwner,
    HasPublicFields,
    Element,
    PublicFields,
    FieldName,
    FieldType,
    Field,
    Variants,
    VariantName,
    VariantType,
    HasPayload,
    Variant,
    Construct,
    Unsupported,
}

/// Describes the source shape accepted by one std::meta form.
pub struct Shape {
    pub static_args: i64,
    pub capture: bool,
    pub args: i64,
    pub type_form: bool,
    pub variadic: bool,
    pub worker: i64
}

/// Is the identity and shape found by one registry lookup.
pub struct IdentifiedForm {
    pub form: Form,
    pub shape: Shape
}

struct Entry {
    form: Form,
    shape: Shape
}

/// Returns the source spelling of form.
pub fn spelling(form: Form) -> []u8 {
    return match form {
        IsStruct => "std::meta::is_struct",
        IsEnum => "std::meta::is_enum",
        IsUnion => "std::meta::is_union",
        IsOptional => "std::meta::is_optional",
        IsArray => "std::meta::is_array",
        IsBox => "std::meta::is_box",
        IsMap => "std::meta::is_map",
        IsOwner => "std::meta::is_owner",
        HasPublicFields => "std::meta::has_public_fields",
        Element => "std::meta::element",
        PublicFields => "std::meta::public_fields",
        FieldName => "std::meta::field_name",
        FieldType => "std::meta::field_type",
        Field => "std::meta::field",
        Variants => "std::meta::variants",
        VariantName => "std::meta::variant_name",
        VariantType => "std::meta::variant_type",
        HasPayload => "std::meta::has_payload",
        Variant => "std::meta::variant",
        Construct => "std::meta::construct",
        Unsupported => "std::meta::unsupported",
    };
}

/// Returns the shape of name, or null when name is not a std::meta form.
pub fn lookup(name: []u8) -> ?Shape {
    if lookup_entry(name) |value| {
        return value.shape;
    }
    return null;
}

/// Returns the identity and shape of name in one registry lookup.
pub fn identify(name: []u8) -> ?IdentifiedForm {
    if lookup_entry(name) |value| {
        return IdentifiedForm { form: value.form, shape: value.shape };
    }
    return null;
}

/// Reports whether name is a compile-time predicate form.
pub fn predicate(name: []u8) -> bool {
    if lookup_entry(name) |value| {
        return match value.form {
            IsStruct => true,
            IsEnum => true,
            IsUnion => true,
            IsOptional => true,
            IsArray => true,
            IsBox => true,
            IsMap => true,
            IsOwner => true,
            HasPublicFields => true,
            HasPayload => true,
            _ => false,
        };
    }
    return false;
}

/// Reports whether form consumes a variant capture instead of a field capture.
pub fn variant_form(form: Form) -> bool {
    return match form {
        VariantName => true,
        VariantType => true,
        HasPayload => true,
        Variant => true,
        _ => false,
    };
}

/// Returns the child type held by one valid, closed container type.
/// The returned handle remains owned by table.
pub fn element_type(
    table: &typ::Table,
    container: typ::Type
) -> ?typ::Type {
    match typ::root_node(table, container) {
        Optional(node) => return typ::child_type(container, node.elem),
        Name(node) => {
            if (path_is(&node.path, "array", "Array") or
                path_is(&node.path, "mem", "Box")) and
                node.args.len() == 1 {
                return typ::child_type(
                    container,
                    node.args.get_or_panic(0)
                );
            }
            if path_is(&node.path, "map", "Map") and
                node.args.len() == 2 {
                return typ::child_type(
                    container,
                    node.args.get_or_panic(1)
                );
            }
        },
        _ => {},
    }
    return null;
}

/// Rewrites every valid, closed element<T> form in one retained type graph.
/// Invalid and type-parameter-dependent containers remain written forms so
/// the checker that owns their context can reject or instantiate them later.
pub fn resolve_element_type_forms(allocator: Allocator, table: &typ::Table, value: typ::Type) -> !string::String {
    var resolved = typ::new(allocator);
    defer resolved.deinit(allocator);
    var mapper = ElementTypeMapper { allocator: allocator };
    let transformed = try typ::fold_names_into<ElementTypeMapper>(table, value, &var resolved, &var mapper);
    return typ::render(allocator, &resolved, transformed);
}

struct ElementTypeMapper {
    allocator: Allocator,
}

fn (self: &var ElementTypeMapper) fold_name(builder: &var typ::Builder, path: array::Array<string::String>, args: array::Array<arena::Handle<typ::Node>>) -> !arena::Handle<typ::Node> {
    if path_is(&path, "meta", "element") and args.len() == 1 {
        let container = args.get_or_panic(0);
        if projected_element_handle(builder, container) |element| {
            path.deinit(self.allocator);
            args.deinit(self.allocator);
            return element;
        }
    }
    return builder.add(typ::Node::Name(typ::Name { path: move path, args: move args }));
}

fn projected_element_handle(builder: &typ::Builder, container: arena::Handle<typ::Node>) -> ?arena::Handle<typ::Node> {
    match builder.at(container) {
        Optional(node) => return node.elem,
        Name(node) => {
            if (path_is(&node.path, "array", "Array") or
                path_is(&node.path, "mem", "Box")) and
                node.args.len() == 1 {
                return node.args.get_or_panic(0);
            }
            if path_is(&node.path, "map", "Map") and
                node.args.len() == 2 and
                builder_handle_is_map_key(builder, node.args.get_or_panic(0)) {
                return node.args.get_or_panic(1);
            }
        },
        _ => {},
    }
    return null;
}

fn builder_handle_is_map_key(builder: &typ::Builder, value: arena::Handle<typ::Node>) -> bool {
    match builder.at(value) {
        Slice(node) => {
            match builder.at(node.elem) {
                Name(name) => return name.path.len() == 1 and
                    name.args.len() == 0 and
                    path_part_is(&name.path, 0, "u8"),
                _ => {},
            }
        },
        Name(name) => return name.path.len() == 1 and
            name.args.len() == 0 and
            path_part_is_map_key(&name.path, 0),
        _ => {},
    }
    return false;
}

fn path_part_is_map_key(path: &array::Array<string::String>, index: i64) -> bool {
    if path.at(index) |part| {
        let bytes = part.as_bytes();
        return typ::is_map_key(bytes);
    }
    return false;
}

fn path_is(path: &array::Array<string::String>, module: []u8, name: []u8) -> bool {
    if path.len() != 3 {
        return false;
    }
    return path_part_is(path, 0, "std") and
        path_part_is(path, 1, module) and
        path_part_is(path, 2, name);
}

fn path_part_is(path: &array::Array<string::String>, index: i64, expected: []u8) -> bool {
    if path.at(index) |part| {
        let bytes = part.as_bytes();
        return mem::equal_bytes(bytes, expected);
    }
    return false;
}

/// Returns every form.
pub fn names(allocator: Allocator) -> !array::Array<Form> {
    var out = array::new<Form>(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while entry(index) |value| {
        try out.append(value.form);
        index = index + 1;
    }
    return move out;
}

/// Owns the static arguments split from one recognized form application.
pub struct ApplyParts {
    pub form: Form,
    pub args: array::Array<string::String>
}

/// Splits a spelling such as std::meta::field_type<T, f>.
pub fn split_apply(
    allocator: Allocator,
    text: []u8
) -> !?ApplyParts {
    var normalized = try string::from_bytes(allocator, text);
    defer normalized.deinit(allocator);
    string::trim_space_in_place(&var normalized);
    let spelling_bytes = normalized.as_bytes();
    let length = mem::len(spelling_bytes);
    var open = 0;
    while open < length and spelling_bytes[open] != cast<u8>(60) {
        open = open + 1;
    }
    if open == length or length == 0 or
        spelling_bytes[length - 1] != cast<u8>(62) {
        return null;
    }
    var name = try string::from_bytes(allocator, spelling_bytes[0..open]);
    defer name.deinit(allocator);
    string::trim_space_in_place(&var name);
    let name_bytes = name.as_bytes();
    if lookup_entry(name_bytes) |known| {
        let argument_bytes = spelling_bytes[open + 1..length - 1];
        if try split_args(allocator, argument_bytes) |args| {
            return ApplyParts {
                form: known.form,
                args: move args
            };
        }
    }
    return null;
}

fn split_args(
    allocator: Allocator,
    text: []u8
) -> !?array::Array<string::String> {
    var parts = array::new<string::String>(allocator);
    errdefer parts.deinit(allocator);
    var depth = 0;
    var start = 0;
    var index = 0;
    while index < mem::len(text) {
        let byte = text[index];
        if byte == cast<u8>(60) {
            depth = depth + 1;
        } else {
            if byte == cast<u8>(62) {
                depth = depth - 1;
                if depth < 0 {
                    parts.deinit(allocator);
                    return null;
                }
            } else {
                if byte == cast<u8>(44) and depth == 0 {
                    if !try append_trimmed_part(
                        allocator,
                        &var parts,
                        text[start..index]
                    ) {
                        parts.deinit(allocator);
                        return null;
                    }
                    start = index + 1;
                }
            }
        }
        index = index + 1;
    }
    if depth != 0 or !try append_trimmed_part(
        allocator,
        &var parts,
        text[start..mem::len(text)]
    ) {
        parts.deinit(allocator);
        return null;
    }
    return move parts;
}

fn append_trimmed_part(
    allocator: Allocator,
    parts: &var array::Array<string::String>,
    text: []u8
) -> !bool {
    var part = try string::from_bytes(allocator, text);
    errdefer part.deinit(allocator);
    string::trim_space_in_place(&var part);
    if part.len() == 0 {
        part.deinit(allocator);
        return false;
    }
    try parts.append(move part);
    return true;
}

fn lookup_entry(name: []u8) -> ?Entry {
    var index = 0;
    while entry(index) |value| {
        if mem::equal_bytes(spelling(value.form), name) {
            return value;
        }
        index = index + 1;
    }
    return null;
}

fn entry(index: i64) -> ?Entry {
    if index == 0 {
        return simple_entry(Form::IsStruct, 1);
    }
    if index == 1 {
        return simple_entry(Form::IsEnum, 1);
    }
    if index == 2 {
        return simple_entry(Form::IsUnion, 1);
    }
    if index == 3 {
        return simple_entry(Form::IsOptional, 1);
    }
    if index == 4 {
        return simple_entry(Form::IsArray, 1);
    }
    if index == 5 {
        return simple_entry(Form::IsBox, 1);
    }
    if index == 6 {
        return simple_entry(Form::IsMap, 1);
    }
    if index == 7 {
        return simple_entry(Form::IsOwner, 1);
    }
    if index == 8 {
        return simple_entry(Form::HasPublicFields, 1);
    }
    if index == 9 {
        return Entry {
            form: Form::Element,
            shape: Shape {
                static_args: 1, capture: false, args: 0,
                type_form: true, variadic: false, worker: 0
            }
        };
    }
    if index == 10 {
        return simple_entry(Form::PublicFields, 1);
    }
    if index == 11 {
        return capture_entry(Form::FieldName, false, 0, false);
    }
    if index == 12 {
        return capture_entry(Form::FieldType, true, 0, false);
    }
    if index == 13 {
        return capture_entry(Form::Field, false, 1, false);
    }
    if index == 14 {
        return simple_entry(Form::Variants, 1);
    }
    if index == 15 {
        return capture_entry(Form::VariantName, false, 0, false);
    }
    if index == 16 {
        return capture_entry(Form::VariantType, true, 0, false);
    }
    if index == 17 {
        return capture_entry(Form::HasPayload, false, 0, false);
    }
    if index == 18 {
        return capture_entry(Form::Variant, false, 0, true);
    }
    if index == 19 {
        return Entry {
            form: Form::Construct,
            shape: Shape {
                static_args: 2, capture: false, args: 0,
                type_form: false, variadic: true, worker: 2
            }
        };
    }
    if index == 20 {
        return simple_entry(Form::Unsupported, 1);
    }
    return null;
}

fn simple_entry(form: Form, static_args: i64) -> Entry {
    return Entry {
        form: form,
        shape: Shape {
            static_args: static_args, capture: false, args: 0,
            type_form: false, variadic: false, worker: 0
        }
    };
}

fn capture_entry(
    form: Form,
    type_form: bool,
    args: i64,
    variadic: bool
) -> Entry {
    return Entry {
        form: form,
        shape: Shape {
            static_args: 2, capture: true, args: args,
            type_form: type_form, variadic: variadic, worker: 0
        }
    };
}
