import compiler::internal::typ;
import std::array;
import std::mem;
import std::string;
import std::testing;

fn expect_shape(
    name: []u8,
    static_args: i64,
    capture: bool,
    args: i64,
    type_form: bool,
    variadic: bool,
    worker: i64
) -> void {
    if lookup(name) |shape| {
        testing::expect_equal<i64>(static_args, shape.static_args);
        testing::expect_equal<bool>(capture, shape.capture);
        testing::expect_equal<i64>(args, shape.args);
        testing::expect_equal<bool>(type_form, shape.type_form);
        testing::expect_equal<bool>(variadic, shape.variadic);
        testing::expect_equal<i64>(worker, shape.worker);
    } else {
        testing::fail("stdmeta shape was not found");
    }
}

fn expect_arg(
    args: &array::Array<string::String>,
    index: i64,
    expected: []u8
) -> void {
    if args.at(index) |value| {
        let bytes = value.as_bytes();
        testing::expect_equal<[]u8>(expected, bytes);
    } else {
        testing::fail("stdmeta argument was not found");
    }
}

fn count_form(
    forms: &array::Array<Form>,
    expected: Form
) -> i64 {
    var count = 0;
    var index = 0;
    while forms.get(index) |form| {
        if form == expected {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn expect_one_form(
    forms: &array::Array<Form>,
    expected: Form
) -> void {
    testing::expect_equal<i64>(1, count_form(forms, expected));
}

fn expect_spelling(form: Form, expected: []u8) -> void {
    testing::expect_equal<[]u8>(expected, spelling(form));
}

fn expect_element_type(
    allocator: Allocator,
    container: []u8,
    expected: []u8
) -> !void {
    var table = typ::new(allocator);
    defer table.deinit(allocator);
    let parsed = try table.parse(container);
    if element_type(&table, parsed) |element| {
        let rendered = try typ::render(allocator, &table, element);
        defer rendered.deinit(allocator);
        let bytes = rendered.as_bytes();
        testing::expect_equal<[]u8>(expected, bytes);
    } else {
        testing::fail("stdmeta element type was not found");
    }
    return;
}

fn expect_no_element_type(
    allocator: Allocator,
    container: []u8
) -> !void {
    var table = typ::new(allocator);
    defer table.deinit(allocator);
    let parsed = try table.parse(container);
    if element_type(&table, parsed) |_| {
        testing::fail("invalid stdmeta element container was accepted");
    }
    return;
}

fn expect_resolved_element_type_forms(
    allocator: Allocator,
    input: []u8,
    expected: []u8
) -> !void {
    var table = typ::new(allocator);
    defer table.deinit(allocator);
    let parsed = try table.parse(input);
    let resolved = try resolve_element_type_forms(
        allocator,
        &table,
        parsed
    );
    defer resolved.deinit(allocator);
    let bytes = resolved.as_bytes();
    testing::expect_equal<[]u8>(expected, bytes);
    return;
}

fn expect_no_apply(allocator: Allocator, text: []u8) -> !void {
    if try split_apply(allocator, text) |parts| {
        parts.deinit(allocator);
        testing::fail("invalid stdmeta application was accepted");
    }
    return;
}

fn split_releasing_input(
    allocator: Allocator,
    text: string::String
) -> !?ApplyParts {
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    return split_apply(allocator, bytes);
}

test "stdmeta registry exposes every form and shape" {
    let allocator = mem::page_allocator();
    let forms = try names(allocator);
    defer forms.deinit(allocator);
    testing::expect_equal<i64>(21, forms.len());
    var index = 0;
    while forms.get(index) |form| {
        let name = spelling(form);
        if lookup(name) |_| {
        } else {
            testing::fail("enumerated stdmeta form has no shape");
        }
        if identify(name) |identified| {
            testing::expect(identified.form == form);
        } else {
            testing::fail("enumerated stdmeta form has no identity");
        }
        index = index + 1;
    }

    expect_one_form(&forms, Form::IsStruct);
    expect_one_form(&forms, Form::IsEnum);
    expect_one_form(&forms, Form::IsUnion);
    expect_one_form(&forms, Form::IsOptional);
    expect_one_form(&forms, Form::IsArray);
    expect_one_form(&forms, Form::IsBox);
    expect_one_form(&forms, Form::IsMap);
    expect_one_form(&forms, Form::IsOwner);
    expect_one_form(&forms, Form::HasPublicFields);
    expect_one_form(&forms, Form::Element);
    expect_one_form(&forms, Form::PublicFields);
    expect_one_form(&forms, Form::FieldName);
    expect_one_form(&forms, Form::FieldType);
    expect_one_form(&forms, Form::Field);
    expect_one_form(&forms, Form::Variants);
    expect_one_form(&forms, Form::VariantName);
    expect_one_form(&forms, Form::VariantType);
    expect_one_form(&forms, Form::HasPayload);
    expect_one_form(&forms, Form::Variant);
    expect_one_form(&forms, Form::Construct);
    expect_one_form(&forms, Form::Unsupported);

    expect_spelling(Form::IsStruct, "std::meta::is_struct");
    expect_spelling(Form::IsEnum, "std::meta::is_enum");
    expect_spelling(Form::IsUnion, "std::meta::is_union");
    expect_spelling(Form::IsOptional, "std::meta::is_optional");
    expect_spelling(Form::IsArray, "std::meta::is_array");
    expect_spelling(Form::IsBox, "std::meta::is_box");
    expect_spelling(Form::IsMap, "std::meta::is_map");
    expect_spelling(Form::IsOwner, "std::meta::is_owner");
    expect_spelling(
        Form::HasPublicFields,
        "std::meta::has_public_fields"
    );
    expect_spelling(Form::Element, "std::meta::element");
    expect_spelling(Form::PublicFields, "std::meta::public_fields");
    expect_spelling(Form::FieldName, "std::meta::field_name");
    expect_spelling(Form::FieldType, "std::meta::field_type");
    expect_spelling(Form::Field, "std::meta::field");
    expect_spelling(Form::Variants, "std::meta::variants");
    expect_spelling(Form::VariantName, "std::meta::variant_name");
    expect_spelling(Form::VariantType, "std::meta::variant_type");
    expect_spelling(Form::HasPayload, "std::meta::has_payload");
    expect_spelling(Form::Variant, "std::meta::variant");
    expect_spelling(Form::Construct, "std::meta::construct");
    expect_spelling(Form::Unsupported, "std::meta::unsupported");

    expect_shape("std::meta::is_struct", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_enum", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_union", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_optional", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_array", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_box", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_map", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_owner", 1, false, 0, false, false, 0);
    expect_shape("std::meta::has_public_fields", 1, false, 0, false, false, 0);
    expect_shape("std::meta::element", 1, false, 0, true, false, 0);
    expect_shape("std::meta::public_fields", 1, false, 0, false, false, 0);
    expect_shape("std::meta::field_name", 2, true, 0, false, false, 0);
    expect_shape("std::meta::field_type", 2, true, 0, true, false, 0);
    expect_shape("std::meta::field", 2, true, 1, false, false, 0);
    expect_shape("std::meta::variants", 1, false, 0, false, false, 0);
    expect_shape("std::meta::variant_name", 2, true, 0, false, false, 0);
    expect_shape("std::meta::variant_type", 2, true, 0, true, false, 0);
    expect_shape("std::meta::has_payload", 2, true, 0, false, false, 0);
    expect_shape("std::meta::variant", 2, true, 0, false, true, 0);
    expect_shape("std::meta::construct", 2, false, 0, false, true, 2);
    expect_shape("std::meta::unsupported", 1, false, 0, false, false, 0);
    if lookup("std::meta::missing") |_| {
        testing::fail("unknown stdmeta form has a shape");
    }
    if identify("std::meta::missing") |_| {
        testing::fail("unknown stdmeta form has an identity");
    }
}

test "stdmeta classifies predicates and variant captures" {
    testing::expect(predicate("std::meta::is_struct"));
    testing::expect(predicate("std::meta::is_enum"));
    testing::expect(predicate("std::meta::is_union"));
    testing::expect(predicate("std::meta::is_optional"));
    testing::expect(predicate("std::meta::is_array"));
    testing::expect(predicate("std::meta::is_box"));
    testing::expect(predicate("std::meta::is_map"));
    testing::expect(predicate("std::meta::is_owner"));
    testing::expect(predicate("std::meta::has_public_fields"));
    testing::expect(predicate("std::meta::has_payload"));
    testing::expect(!predicate("std::meta::element"));
    testing::expect(!predicate("std::meta::public_fields"));
    testing::expect(!predicate("std::meta::field_name"));
    testing::expect(!predicate("std::meta::field_type"));
    testing::expect(!predicate("std::meta::field"));
    testing::expect(!predicate("std::meta::variants"));
    testing::expect(!predicate("std::meta::variant_name"));
    testing::expect(!predicate("std::meta::variant_type"));
    testing::expect(!predicate("std::meta::variant"));
    testing::expect(!predicate("std::meta::construct"));
    testing::expect(!predicate("std::meta::unsupported"));
    testing::expect(!predicate("std::meta::missing"));
    testing::expect(variant_form(Form::VariantName));
    testing::expect(variant_form(Form::VariantType));
    testing::expect(variant_form(Form::HasPayload));
    testing::expect(variant_form(Form::Variant));
    testing::expect(!variant_form(Form::IsStruct));
    testing::expect(!variant_form(Form::IsEnum));
    testing::expect(!variant_form(Form::IsUnion));
    testing::expect(!variant_form(Form::IsOptional));
    testing::expect(!variant_form(Form::IsArray));
    testing::expect(!variant_form(Form::IsBox));
    testing::expect(!variant_form(Form::IsMap));
    testing::expect(!variant_form(Form::IsOwner));
    testing::expect(!variant_form(Form::HasPublicFields));
    testing::expect(!variant_form(Form::Element));
    testing::expect(!variant_form(Form::PublicFields));
    testing::expect(!variant_form(Form::FieldName));
    testing::expect(!variant_form(Form::FieldType));
    testing::expect(!variant_form(Form::Field));
    testing::expect(!variant_form(Form::Variants));
    testing::expect(!variant_form(Form::Construct));
    testing::expect(!variant_form(Form::Unsupported));
}

test "stdmeta splits nested static applications into owned arguments" {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(
        allocator,
        "　std::meta::field_type　<　std::map::Map<[]u8, std::array::Array<i64>>,　f　>　"
    );
    if try split_releasing_input(allocator, move text) |parts| {
        defer parts.deinit(allocator);
        testing::expect(parts.form == Form::FieldType);
        testing::expect_equal<i64>(2, parts.args.len());
        expect_arg(
            &parts.args,
            0,
            "std::map::Map<[]u8, std::array::Array<i64>>"
        );
        expect_arg(&parts.args, 1, "f");
    } else {
        testing::fail("valid stdmeta application was rejected");
    }
}

test "stdmeta rejects ordinary and malformed applications" {
    let allocator = mem::page_allocator();
    try expect_no_apply(allocator, "std::meta::field_type");
    try expect_no_apply(allocator, "other<T>");
    try expect_no_apply(allocator, "std::meta::field_type<>");
    try expect_no_apply(allocator, "std::meta::field_type<T,>");
    try expect_no_apply(allocator, "std::meta::field_type<,f>");
    try expect_no_apply(allocator, "std::meta::field_type<T, f");
    try expect_no_apply(allocator, "std::meta::field_type<T>, f>");
    try expect_no_apply(allocator, "std::meta::field_type<T<f>");
}

test "stdmeta reads element types from valid closed containers" {
    let allocator = mem::page_allocator();
    try expect_element_type(allocator, "?i64", "i64");
    try expect_element_type(
        allocator,
        "std::array::Array<i64>",
        "i64"
    );
    try expect_element_type(
        allocator,
        "std::mem::Box<bool>",
        "bool"
    );
    try expect_element_type(
        allocator,
        "std::map::Map<[]u8, bool>",
        "bool"
    );
    try expect_element_type(
        allocator,
        "std::map::Map<K, V>",
        "V"
    );
    try expect_no_element_type(allocator, "i64");
}

test "element forms resolve recursively without hiding invalid maps" {
    let allocator = mem::page_allocator();
    try expect_resolved_element_type_forms(
        allocator,
        "std::meta::element<std::array::Array<i64>>",
        "i64"
    );
    try expect_resolved_element_type_forms(
        allocator,
        "?std::array::Array<std::meta::element<std::mem::Box<i64>>>",
        "?std::array::Array<i64>"
    );
    try expect_resolved_element_type_forms(
        allocator,
        "std::meta::element<std::map::Map<[]u8, std::string::String>>",
        "std::string::String"
    );
    try expect_resolved_element_type_forms(
        allocator,
        "std::meta::element<std::map::Map<f64, bool>>",
        "std::meta::element<std::map::Map<f64, bool>>"
    );
    try expect_resolved_element_type_forms(
        allocator,
        "std::meta::element<std::map::Map<K, bool>>",
        "std::meta::element<std::map::Map<K, bool>>"
    );
}
