import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

fn (self: &var Emitter) fail_name1(module: &ir::Module, format: []u8, a: ir::Name) -> !diagnostic::Diagnostic {
    let shown_a = try self.own(module, a);
    return self.fail1(format, Arg::Str(shown_a));
}

fn (self: &var Emitter) fail_name2(module: &ir::Module, format: []u8, a: ir::Name, b: ir::Name) -> !diagnostic::Diagnostic {
    let shown_a = try self.own(module, a);
    let shown_b = try self.own(module, b);
    return self.fail2(format, Arg::Str(shown_a), Arg::Str(shown_b));
}

fn (self: &var Emitter) fail_name4(
    module: &ir::Module,
    format: []u8,
    a: ir::Name,
    b: ir::Name,
    c: ir::Name,
    d: ir::Name
) -> !diagnostic::Diagnostic {
    let shown_a = try self.own(module, a);
    let shown_b = try self.own(module, b);
    let shown_c = try self.own(module, c);
    let shown_d = try self.own(module, d);
    return self.fail4(format, Arg::Str(shown_a), Arg::Str(shown_b), Arg::Str(shown_c), Arg::Str(shown_d));
}

fn (self: &var Emitter) write_const(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if try self.scalar_const_operand(module, node) |operand| {
        try self.set_value(module, node.result, operand);
        return null;
    }
    if module.names.is(node.result.type_name, "[]u8") {
        var unquoted = string::new(self.allocator);
        defer unquoted.deinit(self.allocator);
        let literal = ir::name_text(&module.names, node.immediate);
        let literal_bytes = literal.as_bytes();
        try append_unquoted(self.allocator, &var unquoted, literal_bytes);
        var global = ir::empty_name();
        if self.strings.get(literal_bytes) |found| {
            global = found;
        }
        let name = try self.local_name(module, node.result.name);
        let ptr_name = try self.suffixed(name, ".ptr");
        let base_name = try self.suffixed(name, ".base");
        try self.line3(
            "  %s = getelementptr inbounds [%d x i8], ptr %s, i64 0, i64 0",
            Arg::Str(ptr_name), Arg::Int(unquoted.len() + 1), Arg::Str(global)
        );
        try self.line2("  %s = insertvalue %%kizu.slice.u8 poison, ptr %s, 0", Arg::Str(base_name), Arg::Str(ptr_name));
        try self.line3(
            "  %s = insertvalue %%kizu.slice.u8 %s, i64 %d, 1",
            Arg::Str(name), Arg::Str(base_name), Arg::Int(unquoted.len())
        );
        try self.set_value(module, node.result, name);
        return null;
    }
    return try self.fail_name1(module, "llvm error: unsupported const type `%s`", node.result.type_name);
}

fn (self: &var Emitter) write_binary(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("llvm error: binary expects 2 args");
    }
    let left_arg = node.args.get_or_panic(0);
    let right_arg = node.args.get_or_panic(1);
    let left = try self.operand(module, left_arg);
    let right = try self.operand(module, right_arg);
    if module.names.is(node.result.type_name, "bool") {
        let left_type = try self.llvm_type_of(module, left_arg.type_name);
        let right_type = try self.llvm_type_of(module, right_arg.type_name);
        if !ir::same_name(left_type, right_type) {
            return try self.fail_name4(
                module, "llvm error: binary %s operand type mismatch: %s and %s",
                node.operand, left_arg.type_name, right_arg.type_name, ir::empty_name()
            );
        }
        let name = try self.local_name(module, node.result.name);
        let left_text = ir::name_text(&module.names, left_arg.type_name);
        let left_bytes = left_text.as_bytes();
        if is_float_type(left_bytes) {
            try self.line5(
                "  %s = fcmp %s %s %s, %s",
                Arg::Str(name), Arg::Lit(llvm_float_predicate(&module.names, node.operand)),
                Arg::Str(left_type), Arg::Str(left.operand), Arg::Str(right.operand)
            );
        } else {
            try self.line5(
                "  %s = icmp %s %s %s, %s",
                Arg::Str(name), Arg::Lit(llvm_typed_predicate(&module.names, node.operand, left_arg.type_name)),
                Arg::Str(left_type), Arg::Str(left.operand), Arg::Str(right.operand)
            );
        }
        try self.set_value(module, node.result, name);
        return null;
    }
    if module.names.is(node.operand, "<<") or module.names.is(node.operand, ">>") {
        return self.write_shift(module, node, left, right);
    }
    let name = try self.local_name(module, node.result.name);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_bytes = result_text.as_bytes();
    let lane = lane_type(result_bytes);
    if is_float_type(lane) {
        try self.line5(
            "  %s = %s %s %s, %s",
            Arg::Str(name), Arg::Lit(llvm_float_binary_op(&module.names, node.operand)),
            Arg::Str(result_type), Arg::Str(left.operand), Arg::Str(right.operand)
        );
    } else {
        let unsigned = is_unsigned_integer_type(lane);
        try self.line5(
            "  %s = %s %s %s, %s",
            Arg::Str(name), Arg::Lit(llvm_binary_op_signed(&module.names, node.operand, unsigned)),
            Arg::Str(result_type), Arg::Str(left.operand), Arg::Str(right.operand)
        );
    }
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_shift(
    module: &ir::Module,
    node: &ir::InstrNode,
    left: ValueInfo,
    right: ValueInfo
) -> !?diagnostic::Diagnostic {
    let type_retained = ir::name_text(&module.names, node.result.type_name);
    let type_bytes = type_retained.as_bytes();
    let bits = integer_bit_width(type_bytes) orelse
        return try self.fail_name1(module, "llvm error: shift expects an integer, got %s", node.result.type_name);
    let llvm = try self.llvm_type_of(module, node.result.type_name);
    let name = try self.local_name(module, node.result.name);
    let in_range = try self.suffixed(name, ".shift.in");
    let amount = try self.suffixed(name, ".shift.amount");
    let raw = try self.suffixed(name, ".shift.raw");
    try self.line4("  %s = icmp ult %s %s, %s",
        Arg::Str(in_range), Arg::Str(llvm), Arg::Str(right.operand), Arg::Int(bits));
    try self.line5("  %s = select i1 %s, %s %s, %s 0",
        Arg::Str(amount), Arg::Str(in_range), Arg::Str(llvm), Arg::Str(right.operand), Arg::Str(llvm));
    if module.names.is(node.operand, "<<") {
        try self.line4("  %s = shl %s %s, %s",
            Arg::Str(raw), Arg::Str(llvm), Arg::Str(left.operand), Arg::Str(amount));
        try self.line5("  %s = select i1 %s, %s %s, %s 0",
            Arg::Str(name), Arg::Str(in_range), Arg::Str(llvm), Arg::Str(raw), Arg::Str(llvm));
    } else {
        if is_unsigned_integer_type(type_bytes) {
            try self.line4("  %s = lshr %s %s, %s",
                Arg::Str(raw), Arg::Str(llvm), Arg::Str(left.operand), Arg::Str(amount));
            try self.line5("  %s = select i1 %s, %s %s, %s 0",
                Arg::Str(name), Arg::Str(in_range), Arg::Str(llvm), Arg::Str(raw), Arg::Str(llvm));
        } else {
            let sign = try self.suffixed(name, ".shift.sign");
            try self.line4("  %s = ashr %s %s, %s",
                Arg::Str(sign), Arg::Str(llvm), Arg::Str(left.operand), Arg::Int(bits - 1));
            try self.line4("  %s = ashr %s %s, %s",
                Arg::Str(raw), Arg::Str(llvm), Arg::Str(left.operand), Arg::Str(amount));
            try self.line6("  %s = select i1 %s, %s %s, %s %s",
                Arg::Str(name), Arg::Str(in_range), Arg::Str(llvm), Arg::Str(raw), Arg::Str(llvm), Arg::Str(sign));
        }
    }
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_unary(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: unary expects 1 arg");
    }
    let value = try self.operand(module, node.args.get_or_panic(0));
    let name = try self.local_name(module, node.result.name);
    if module.names.is(node.operand, "!") {
        if !module.names.is(node.result.type_name, "bool") {
            return try self.fail0("llvm error: unary ! expects bool");
        }
        try self.line2("  %s = xor i1 %s, true", Arg::Str(name), Arg::Str(value.operand));
    } else {
        if module.names.is(node.operand, "-") {
            let result_type = try self.llvm_type_of(module, node.result.type_name);
            let result_text = ir::name_text(&module.names, node.result.type_name);
            let result_bytes = result_text.as_bytes();
            let lane = lane_type(result_bytes);
            if is_float_type(lane) {
                try self.line3("  %s = fneg %s %s", Arg::Str(name), Arg::Str(result_type), Arg::Str(value.operand));
            } else {
                if typ::is_vector(result_bytes) {
                    try self.line3("  %s = sub %s zeroinitializer, %s", Arg::Str(name), Arg::Str(result_type), Arg::Str(value.operand));
                } else {
                    try self.line3("  %s = sub %s 0, %s", Arg::Str(name), Arg::Str(result_type), Arg::Str(value.operand));
                }
            }
        } else {
            if module.names.is(node.operand, "~") {
                let result_type = try self.llvm_type_of(module, node.result.type_name);
                let result_text = ir::name_text(&module.names, node.result.type_name);
                let result_bytes = result_text.as_bytes();
                if typ::is_vector(result_bytes) {
                    let all_ones = try self.vector_splat_int(result_bytes, "-1");
                    try self.line4("  %s = xor %s %s, %s", Arg::Str(name), Arg::Str(result_type), Arg::Str(value.operand), Arg::Str(all_ones));
                } else {
                    try self.line3("  %s = xor %s %s, -1", Arg::Str(name), Arg::Str(result_type), Arg::Str(value.operand));
                }
            } else {
                return try self.fail_name1(module, "llvm error: unsupported unary `%s`", node.operand);
            }
        }
    }
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_cast(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: cast expects 1 arg");
    }
    let source = node.args.get_or_panic(0);
    let source_text = ir::name_text(&module.names, source.type_name);
    let source_bytes = source_text.as_bytes();
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_bytes = result_text.as_bytes();
    if try self.error_union_success_type(source_bytes) |success| {
        success.deinit(self.allocator);
        return try self.fail_name2(
            module, "llvm error: cannot cast error union %s to %s", source.type_name, node.result.type_name
        );
    }
    if try self.error_union_success_type(result_bytes) |success| {
        success.deinit(self.allocator);
        return try self.fail_name2(
            module, "llvm error: cannot cast %s to error union %s", source.type_name, node.result.type_name
        );
    }
    if cast_forwards_operand(module, node) {
        let value = try self.operand(module, source);
        try self.set_value(module, node.result, value.operand);
        return null;
    }
    if is_float_type(source_bytes) or is_float_type(result_bytes) {
        return self.write_float_cast(module, node);
    }
    if integer_bit_width(source_bytes) |_| {
        if integer_bit_width(result_bytes) |_| {
            return self.write_integer_cast(module, node);
        }
        return self.write_pointer_integer_cast(module, node, "inttoptr");
    }
    return self.write_pointer_integer_cast(module, node, "ptrtoint");
}

fn (self: &var Emitter) write_float_cast(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let source = node.args.get_or_panic(0);
    let source_text = ir::name_text(&module.names, source.type_name);
    let source_bytes = source_text.as_bytes();
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_bytes = result_text.as_bytes();
    let value = try self.operand(module, source);
    let name = try self.local_name(module, node.result.name);
    let source_type = try self.llvm_type_of(module, source.type_name);
    let target_type = try self.llvm_type_of(module, node.result.type_name);
    if is_float_type(source_bytes) and is_float_type(result_bytes) {
        if mem::equal_bytes(source_bytes, "f64") {
            try self.line5("  %s = %s %s %s to %s",
                Arg::Str(name), Arg::Lit("fptrunc"), Arg::Str(source_type), Arg::Str(value.operand), Arg::Str(target_type));
        } else {
            try self.line5("  %s = %s %s %s to %s",
                Arg::Str(name), Arg::Lit("fpext"), Arg::Str(source_type), Arg::Str(value.operand), Arg::Str(target_type));
        }
        try self.set_value(module, node.result, name);
        return null;
    }
    if is_float_type(source_bytes) {
        if integer_bit_width(result_bytes) |_| {
            var intrinsic = string::new(self.allocator);
            errdefer intrinsic.deinit(self.allocator);
            try append_float_to_int_intrinsic(self.allocator, &var intrinsic, source_bytes, result_bytes);
            try self.line5("  %s = call %s @%s(%s %s)",
                Arg::Str(name), Arg::Str(target_type), Arg::Owned(move intrinsic),
                Arg::Str(source_type), Arg::Str(value.operand));
            try self.set_value(module, node.result, name);
            return null;
        }
        return try self.fail_name2(module, "llvm error: cannot cast %s to %s", source.type_name, node.result.type_name);
    }
    if integer_bit_width(source_bytes) |_| {
        if is_unsigned_integer_type(source_bytes) {
            try self.line5("  %s = %s %s %s to %s",
                Arg::Str(name), Arg::Lit("uitofp"), Arg::Str(source_type), Arg::Str(value.operand), Arg::Str(target_type));
        } else {
            try self.line5("  %s = %s %s %s to %s",
                Arg::Str(name), Arg::Lit("sitofp"), Arg::Str(source_type), Arg::Str(value.operand), Arg::Str(target_type));
        }
        try self.set_value(module, node.result, name);
        return null;
    }
    return try self.fail_name2(module, "llvm error: cannot cast %s to %s", source.type_name, node.result.type_name);
}

fn append_float_to_int_intrinsic(
    allocator: Allocator,
    out: &var string::String,
    source: []u8,
    target: []u8
) -> !void {
    try out.append_bytes(allocator, "llvm.");
    if is_unsigned_integer_type(target) {
        try out.append_bytes(allocator, "fptoui");
    } else {
        try out.append_bytes(allocator, "fptosi");
    }
    let target_type = integer_llvm_type(target);
    let source_type = llvm_primitive_type(source);
    try out.append_bytes(allocator, ".sat.");
    try out.append_bytes(allocator, target_type);
    try out.append_byte(allocator, cast<u8>(46));
    try out.append_bytes(allocator, source_type);
    return;
}

fn (self: &var Emitter) write_float_bits(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        if node.op == ir::Op::FloatBits {
            return try self.fail0("llvm error: float.bits expects 1 arg");
        }
        return try self.fail0("llvm error: float.from_bits expects 1 arg");
    }
    let source = node.args.get_or_panic(0);
    let value = try self.operand(module, source);
    let name = try self.local_name(module, node.result.name);
    let source_type = try self.llvm_type_of(module, source.type_name);
    let target_type = try self.llvm_type_of(module, node.result.type_name);
    try self.line4("  %s = bitcast %s %s to %s",
        Arg::Str(name), Arg::Str(source_type), Arg::Str(value.operand), Arg::Str(target_type));
    try self.set_value(module, node.result, name);
    return null;
}

pub fn float_unary_intrinsic(op: ir::Op) -> ?[]u8 {
    if op == ir::Op::FloatSqrt {
        return "llvm.sqrt.f64";
    }
    if op == ir::Op::FloatFloor {
        return "llvm.floor.f64";
    }
    if op == ir::Op::FloatCeil {
        return "llvm.ceil.f64";
    }
    if op == ir::Op::FloatTrunc {
        return "llvm.trunc.f64";
    }
    return null;
}

fn (self: &var Emitter) write_float_fma(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 {
        let op = try self.op_name(module, node);
        return try self.fail1("llvm error: %s expects 3 args", Arg::Str(op));
    }
    let x = try self.operand(module, node.args.get_or_panic(0));
    let y = try self.operand(module, node.args.get_or_panic(1));
    let z = try self.operand(module, node.args.get_or_panic(2));
    let name = try self.local_name(module, node.result.name);
    if module.names.is(node.result.type_name, "f32") {
        try self.line4("  %s = call float @llvm.fma.f32(float %s, float %s, float %s)",
            Arg::Str(name), Arg::Str(x.operand), Arg::Str(y.operand), Arg::Str(z.operand));
    } else if module.names.is(node.result.type_name, "f32x4") {
        try self.line4("  %s = call <4 x float> @llvm.fma.v4f32(<4 x float> %s, <4 x float> %s, <4 x float> %s)",
            Arg::Str(name), Arg::Str(x.operand), Arg::Str(y.operand), Arg::Str(z.operand));
    } else if module.names.is(node.result.type_name, "f64x2") {
        try self.line4("  %s = call <2 x double> @llvm.fma.v2f64(<2 x double> %s, <2 x double> %s, <2 x double> %s)",
            Arg::Str(name), Arg::Str(x.operand), Arg::Str(y.operand), Arg::Str(z.operand));
    } else {
        try self.line4("  %s = call double @llvm.fma.f64(double %s, double %s, double %s)",
            Arg::Str(name), Arg::Str(x.operand), Arg::Str(y.operand), Arg::Str(z.operand));
    }
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_float_unary(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let intrinsic = float_unary_intrinsic(node.op) orelse "";
    if mem::len(intrinsic) == 0 {
        let op = try self.op_name(module, node);
        return try self.fail1("llvm error: unsupported instruction `%s`", Arg::Str(op));
    }
    if node.args.len() != 1 {
        let op = try self.op_name(module, node);
        return try self.fail1("llvm error: %s expects 1 arg", Arg::Str(op));
    }
    let source = node.args.get_or_panic(0);
    let value = try self.operand(module, source);
    let name = try self.local_name(module, node.result.name);
    let callee = try self.names.intern(intrinsic);
    try self.line3("  %s = call double @%s(double %s)",
        Arg::Str(name), Arg::Str(callee), Arg::Str(value.operand));
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_pointer_integer_cast(
    module: &ir::Module,
    node: &ir::InstrNode,
    op: []u8
) -> !?diagnostic::Diagnostic {
    let source = node.args.get_or_panic(0);
    let name = try self.local_name(module, node.result.name);
    let source_type = try self.llvm_type_of(module, source.type_name);
    let value = try self.operand(module, source);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    try self.line5(
        "  %s = %s %s %s to %s",
        Arg::Str(name), Arg::Lit(op), Arg::Str(source_type), Arg::Str(value.operand), Arg::Str(result_type)
    );
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_integer_cast(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let source = node.args.get_or_panic(0);
    let source_text = ir::name_text(&module.names, source.type_name);
    let source_bytes = source_text.as_bytes();
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_bytes = result_text.as_bytes();
    let source_width = integer_bit_width(source_bytes) orelse 0;
    let target_width = integer_bit_width(result_bytes) orelse 0;
    let value = try self.operand(module, source);
    let name = try self.local_name(module, node.result.name);
    let source_type = try self.llvm_type_of(module, source.type_name);
    let target_type = try self.llvm_type_of(module, node.result.type_name);
    if source_width > target_width {
        try self.line4(
            "  %s = trunc %s %s to %s",
            Arg::Str(name), Arg::Str(source_type), Arg::Str(value.operand), Arg::Str(target_type)
        );
    } else {
        var op = "sext";
        if is_unsigned_integer_type(source_bytes) {
            op = "zext";
        }
        try self.line5(
            "  %s = %s %s %s to %s",
            Arg::Str(name), Arg::Lit(op), Arg::Str(source_type), Arg::Str(value.operand), Arg::Str(target_type)
        );
    }
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_struct_new(allocator: Allocator, module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    if module.structs.at(result_type) |declared| {
        var values = map::new<[]u8, ir::Value>(self.allocator);
        defer values.deinit(self.allocator);
        var field_index = 0;
        while node.fields.get(field_index) |field| {
            field_index = field_index + 1;
            let field_text = ir::name_text(&module.names, field.name);
            let field_bytes = field_text.as_bytes();
            if struct_field_index(declared, field.name) |_| {
                if values.contains(field_bytes) {
                    return try self.fail_name2(
                        module, "llvm error: duplicate struct field `%s.%s`", declared.name, field.name
                    );
                }
                try values.insert(allocator, field_bytes, field.value);
            } else {
                return try self.fail_name2(module, "llvm error: unknown struct field `%s.%s`", declared.name, field.name);
            }
        }
        var ordered = array::new<ir::Value>(self.allocator);
        defer ordered.deinit(self.allocator);
        var check_index = 0;
        while declared.fields.get(check_index) |field| {
            check_index = check_index + 1;
            let field_text = ir::name_text(&module.names, field.name);
            let field_bytes = field_text.as_bytes();
            if values.get(field_bytes) |value| {
                if !ir::same_name(value.type_name, field.type_name) {
                    return try self.fail_name4(
                        module, "llvm error: struct field `%s.%s` expects %s, got %s",
                        declared.name, field.name, field.type_name, value.type_name
                    );
                }
                try ordered.append(self.allocator, value);
            } else {
                return try self.fail_name2(module, "llvm error: missing struct field `%s.%s`", declared.name, field.name);
            }
        }
        if try self.kept_in_memory(module, node.result) {
            try self.write_memory_literal(module, node, &ordered);
            return null;
        }
        let struct_type = try self.llvm_type(module, result_type);
        var aggregate = try self.names.intern("zeroinitializer");
        var result_name = try self.local_name(module, node.result.name);
        var index = 0;
        while declared.fields.get(index) |field| {
            let value = ordered.get_or_panic(index);
            let field_value = try self.operand(module, value);
            var name = try self.text2("%s.field%d", Arg::Str(result_name), Arg::Int(index));
            if index == declared.fields.len() - 1 {
                name = result_name;
            }
            let field_type = try self.llvm_type_of(module, field.type_name);
            try self.line6(
                "  %s = insertvalue %s %s, %s %s, %d",
                Arg::Str(name), Arg::Str(struct_type), Arg::Str(aggregate),
                Arg::Str(field_type), Arg::Str(field_value.operand), Arg::Int(index)
            );
            aggregate = name;
            index = index + 1;
        }
        if declared.fields.len() == 0 {
            result_name = try self.names.intern("zeroinitializer");
        }
        try self.set_value(module, node.result, result_name);
        return null;
    }
    return try self.fail_name1(module, "llvm error: unknown struct type `%s`", node.result.type_name);
}

fn (self: &var Emitter) write_field(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: field read expects 1 arg");
    }
    let receiver = node.args.get_or_panic(0);
    let receiver_text = ir::name_text(&module.names, receiver.type_name);
    let receiver_bytes = receiver_text.as_bytes();
    if module.structs.at(receiver_bytes) |declared| {
        if struct_field_index(declared, node.operand) |index| {
            let field = declared.fields.get_or_panic(index);
            if !ir::same_name(node.result.type_name, field.type_name) {
                return try self.fail_name4(
                    module, "llvm error: field `%s.%s` returns %s, got %s",
                    declared.name, node.operand, field.type_name, node.result.type_name
                );
            }
            if try self.address_arg(module, node, 0) |addr| {
                try self.write_memory_field(module, node, addr, index);
                return null;
            }
            let value = try self.operand(module, receiver);
            let name = try self.local_name(module, node.result.name);
            let receiver_type = try self.llvm_type(module, receiver_bytes);
            try self.line4(
                "  %s = extractvalue %s %s, %d",
                Arg::Str(name), Arg::Str(receiver_type), Arg::Str(value.operand), Arg::Int(index)
            );
            try self.set_value(module, node.result, name);
            return null;
        }
        return try self.fail_name2(module, "llvm error: unknown struct field `%s.%s`", declared.name, node.operand);
    }
    return try self.fail_name1(module, "llvm error: unknown struct type `%s`", receiver.type_name);
}

fn (self: &var Emitter) write_field_ref(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: borrowed field read expects 1 arg");
    }
    let receiver = node.args.get_or_panic(0);
    let receiver_text = ir::name_text(&module.names, receiver.type_name);
    let receiver_bytes = receiver_text.as_bytes();
    let struct_type = deref_llvm_type(receiver_bytes);
    if module.structs.at(struct_type) |declared| {
        if struct_field_index(declared, node.operand) |index| {
            let field = declared.fields.get_or_panic(index);
            if !ir::same_name(node.result.type_name, field.type_name) {
                return try self.fail_name4(
                    module, "llvm error: borrowed field `%s.%s` returns %s, got %s",
                    declared.name, node.operand, field.type_name, node.result.type_name
                );
            }
            let value = try self.operand(module, receiver);
            let name = try self.local_name(module, node.result.name);
            let ptr_name = try self.suffixed(name, ".ptr");
            let llvm_struct = try self.llvm_type(module, struct_type);
            try self.line4(
                "  %s = getelementptr %s, ptr %s, i32 0, i32 %d",
                Arg::Str(ptr_name), Arg::Str(llvm_struct), Arg::Str(value.operand), Arg::Int(index)
            );
            if try self.copied_into_memory(module, node.result, ptr_name) {
                return null;
            }
            let result_type = try self.llvm_type_of(module, node.result.type_name);
            let tag = self.value_tag(result_type);
            try self.line4(
                "  %s = load %s, ptr %s%s", Arg::Str(name), Arg::Str(result_type), Arg::Str(ptr_name), Arg::Lit(tag)
            );
            try self.set_value(module, node.result, name);
            return null;
        }
        return try self.fail_name2(module, "llvm error: unknown struct field `%s.%s`", declared.name, node.operand);
    }
    return try self.fail_name1(module, "llvm error: unknown borrowed struct type `%s`", receiver.type_name);
}

fn (self: &var Emitter) write_field_addr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: field address expects 1 arg");
    }
    let receiver = node.args.get_or_panic(0);
    let receiver_text = ir::name_text(&module.names, receiver.type_name);
    let receiver_bytes = receiver_text.as_bytes();
    let struct_type = deref_llvm_type(receiver_bytes);
    if module.structs.at(struct_type) |declared| {
        if struct_field_index(declared, node.operand) |index| {
            let field = declared.fields.get_or_panic(index);
            let result_text = ir::name_text(&module.names, node.result.type_name);
            let result_bytes = result_text.as_bytes();
            let want = deref_llvm_type(result_bytes);
            if !module.names.is(field.type_name, want) {
                return try self.fail_name4(
                    module, "llvm error: field address `%s.%s` returns &var %s, got %s",
                    declared.name, node.operand, field.type_name, node.result.type_name
                );
            }
            let value = try self.operand(module, receiver);
            let name = try self.local_name(module, node.result.name);
            let llvm_struct = try self.llvm_type(module, struct_type);
            try self.line4(
                "  %s = getelementptr %s, ptr %s, i32 0, i32 %d",
                Arg::Str(name), Arg::Str(llvm_struct), Arg::Str(value.operand), Arg::Int(index)
            );
            try self.set_value(module, node.result, name);
            return null;
        }
        return try self.fail_name2(module, "llvm error: unknown struct field `%s.%s`", declared.name, node.operand);
    }
    return try self.fail_name1(module, "llvm error: unknown borrowed struct type `%s`", receiver.type_name);
}

fn (self: &var Emitter) write_field_set(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("llvm error: field write expects 2 args");
    }
    let receiver = node.args.get_or_panic(0);
    let receiver_text = ir::name_text(&module.names, receiver.type_name);
    let receiver_bytes = receiver_text.as_bytes();
    if module.structs.at(receiver_bytes) |declared| {
        if struct_field_index(declared, node.operand) |index| {
            let field = declared.fields.get_or_panic(index);
            let new_value = node.args.get_or_panic(1);
            if !ir::same_name(new_value.type_name, field.type_name) {
                return try self.fail_name4(
                    module, "llvm error: field `%s.%s` accepts %s, got %s",
                    declared.name, node.operand, field.type_name, new_value.type_name
                );
            }
            if !ir::same_name(node.result.type_name, receiver.type_name) {
                return try self.fail_name4(
                    module, "llvm error: field write on `%s` returns %s, got %s",
                    declared.name, receiver.type_name, node.result.type_name, ir::empty_name()
                );
            }
            if try self.kept_in_memory(module, node.result) {
                try self.write_memory_field_set(module, node, index);
                return null;
            }
            let value = try self.operand(module, new_value);
            let name = try self.local_name(module, node.result.name);
            let receiver_type = try self.llvm_type(module, receiver_bytes);
            let receiver_value = try self.operand(module, receiver);
            let value_type = try self.llvm_type_of(module, new_value.type_name);
            try self.line6(
                "  %s = insertvalue %s %s, %s %s, %d",
                Arg::Str(name), Arg::Str(receiver_type), Arg::Str(receiver_value.operand),
                Arg::Str(value_type), Arg::Str(value.operand), Arg::Int(index)
            );
            try self.set_value(module, node.result, name);
            return null;
        }
        return try self.fail_name2(module, "llvm error: unknown struct field `%s.%s`", declared.name, node.operand);
    }
    return try self.fail_name1(module, "llvm error: unknown struct type `%s`", receiver.type_name);
}

fn (self: &var Emitter) write_field_ref_set(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("llvm error: borrowed field write expects 2 args");
    }
    let receiver = node.args.get_or_panic(0);
    let receiver_text = ir::name_text(&module.names, receiver.type_name);
    let receiver_bytes = receiver_text.as_bytes();
    let struct_type = deref_llvm_type(receiver_bytes);
    if module.structs.at(struct_type) |declared| {
        if struct_field_index(declared, node.operand) |index| {
            let field = declared.fields.get_or_panic(index);
            let new_value = node.args.get_or_panic(1);
            if !ir::same_name(new_value.type_name, field.type_name) {
                return try self.fail_name4(
                    module, "llvm error: borrowed field `%s.%s` accepts %s, got %s",
                    declared.name, node.operand, field.type_name, new_value.type_name
                );
            }
            if !module.names.is(node.result.type_name, "void") {
                return try self.fail_name1(
                    module, "llvm error: borrowed field write returns void, got %s", node.result.type_name
                );
            }
            let result_name = try self.local_name(module, node.result.name);
            let ptr_name = try self.suffixed(result_name, ".ptr");
            let llvm_struct = try self.llvm_type(module, struct_type);
            let receiver_value = try self.operand(module, receiver);
            try self.line4(
                "  %s = getelementptr %s, ptr %s, i32 0, i32 %d",
                Arg::Str(ptr_name), Arg::Str(llvm_struct), Arg::Str(receiver_value.operand), Arg::Int(index)
            );
            let value_type = try self.llvm_type_of(module, new_value.type_name);
            if !try self.copied_from_memory(module, node, 1, ptr_name) {
                let value = try self.operand(module, new_value);
                let tag = self.value_tag(value_type);
                try self.line4(
                    "  store %s %s, ptr %s%s",
                    Arg::Str(value_type), Arg::Str(value.operand), Arg::Str(ptr_name), Arg::Lit(tag)
                );
            }
            try self.set_void_value(module, node.result);
            return null;
        }
        return try self.fail_name2(module, "llvm error: unknown struct field `%s.%s`", declared.name, node.operand);
    }
    return try self.fail_name1(module, "llvm error: unknown borrowed struct type `%s`", receiver.type_name);
}

fn (self: &var Emitter) write_ref_store(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("llvm error: dereference write expects 2 args");
    }
    let receiver = node.args.get_or_panic(0);
    let new_value = node.args.get_or_panic(1);
    let receiver_text = ir::name_text(&module.names, receiver.type_name);
    let receiver_bytes = receiver_text.as_bytes();
    let want = deref_llvm_type(receiver_bytes);
    if !module.names.is(new_value.type_name, want) {
        let shown_receiver = try self.own(module, receiver.type_name);
        let shown_want = try self.names.intern(want);
        let shown_value = try self.own(module, new_value.type_name);
        return try self.fail3(
            "llvm error: dereference write on `%s` accepts %s, got %s",
            Arg::Str(shown_receiver), Arg::Str(shown_want), Arg::Str(shown_value)
        );
    }
    if !module.names.is(node.result.type_name, "void") {
        return try self.fail_name1(module, "llvm error: dereference write returns void, got %s", node.result.type_name);
    }
    let keyword = volatile_keyword(node.op);
    let target = try self.operand(module, receiver);
    if try self.copied_from_memory(module, node, 1, target.operand) {
        try self.set_void_value(module, node.result);
        return null;
    }
    let value_type = try self.llvm_type_of(module, new_value.type_name);
    let value = try self.operand(module, new_value);
    let receiver_value = try self.operand(module, receiver);
    let tag = self.reference_tag(module, node.op, receiver.type_name, value_type);
    try self.line5(
        "  store %s%s %s, ptr %s%s",
        Arg::Lit(keyword), Arg::Str(value_type), Arg::Str(value.operand), Arg::Str(receiver_value.operand), Arg::Lit(tag)
    );
    try self.set_void_value(module, node.result);
    return null;
}

fn volatile_keyword(op: ir::Op) -> []u8 {
    if op == ir::Op::VolatileStore or op == ir::Op::VolatileLoad {
        return "volatile ";
    }
    return "";
}

fn (self: &var Emitter) write_local_slot(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: local slot expects 1 arg");
    }
    let initial = node.args.get_or_panic(0);
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_bytes = result_text.as_bytes();
    let want = deref_llvm_type(result_bytes);
    if !module.names.is(initial.type_name, want) {
        let shown_result = try self.own(module, node.result.type_name);
        let shown_want = try self.names.intern(want);
        let shown_initial = try self.own(module, initial.type_name);
        return try self.fail3(
            "llvm error: local slot of %s holds %s, got %s",
            Arg::Str(shown_result), Arg::Str(shown_want), Arg::Str(shown_initial)
        );
    }
    let slot_name = try self.local_name(module, node.result.name);
    let value_type = try self.llvm_type_of(module, initial.type_name);
    try self.line2("  %s = alloca %s", Arg::Str(slot_name), Arg::Str(value_type));
    if !try self.copied_from_memory(module, node, 0, slot_name) {
        let initial_value = try self.operand(module, initial);
        try self.line3(
            "  store %s %s, ptr %s", Arg::Str(value_type), Arg::Str(initial_value.operand), Arg::Str(slot_name)
        );
    }
    try self.set_value(module, node.result, slot_name);
    return null;
}

fn (self: &var Emitter) write_ref_load(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: borrow read expects 1 arg");
    }
    let receiver = node.args.get_or_panic(0);
    let receiver_text = ir::name_text(&module.names, receiver.type_name);
    let receiver_bytes = receiver_text.as_bytes();
    let want = deref_llvm_type(receiver_bytes);
    if !module.names.is(node.result.type_name, want) {
        let shown_receiver = try self.own(module, receiver.type_name);
        let shown_want = try self.names.intern(want);
        let shown_result = try self.own(module, node.result.type_name);
        return try self.fail3(
            "llvm error: borrow read of `%s` gives %s, got %s",
            Arg::Str(shown_receiver), Arg::Str(shown_want), Arg::Str(shown_result)
        );
    }
    let result_name = try self.local_name(module, node.result.name);
    let keyword = volatile_keyword(node.op);
    if mem::len(keyword) == 0 {
        let source = try self.operand(module, receiver);
        if try self.copied_into_memory(module, node.result, source.operand) {
            return null;
        }
    }
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    let receiver_value = try self.operand(module, receiver);
    let tag = self.reference_tag(module, node.op, receiver.type_name, result_type);
    try self.write_value_load(result_name, keyword, result_type, receiver_value.operand, 0, tag);
    try self.set_value(module, node.result, result_name);
    return null;
}

fn (self: &var Emitter) write_slice_instr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    match node.op {
        SliceLen => return self.write_slice_len(module, node),
        SlicePtr => return self.write_slice_ptr(module, node),
        SliceFromPtr => return self.write_slice_from_ptr(module, node),
        SliceIndex => return self.write_slice_index(module, node),
        SliceStore => return self.write_slice_store(module, node),
        SliceSlice => return self.write_slice_slice(module, node),
        SliceCompare => return self.write_slice_compare(module, node),
        _ => {
            let op = try self.op_name(module, node);
            return try self.fail1("llvm error: unsupported slice instruction `%s`", Arg::Str(op));
        },
    }
}

fn (self: &var Emitter) write_vector_new(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_bytes = result_text.as_bytes();
    let kind = typ::vector_kind(result_bytes);
    if kind < 0 {
        return try self.fail0("llvm error: vector.new expects a vector result");
    }
    let lane = typ::vector_lane_of_kind(kind);
    let lanes = typ::vector_lanes(result_bytes);
    if node.args.len() != lanes {
        return try self.fail0("llvm error: vector.new expects one value per lane");
    }
    let vector_type = try self.llvm_type(module, result_bytes);
    let lane_llvm = try self.names.intern(llvm_primitive_type(lane));
    let name = try self.local_name(module, node.result.name);
    var current = try self.names.intern("poison");
    var index = 0;
    while node.args.get(index) |arg| {
        if !module.names.is(arg.type_name, lane) {
            return try self.fail0("llvm error: vector.new lane has the wrong type");
        }
        var next = name;
        if index + 1 < lanes {
            var suffix = try string::from_bytes(self.allocator, ".lane");
            defer suffix.deinit(self.allocator);
            try fmt::append_i64(self.allocator, &var suffix, index);
            let suffix_bytes = suffix.as_bytes();
            next = try self.suffixed(name, suffix_bytes);
        }
        let operand = try self.operand(module, arg);
        try self.line6(
            "  %s = insertelement %s %s, %s %s, i32 %d",
            Arg::Str(next), Arg::Str(vector_type), Arg::Str(current),
            Arg::Str(lane_llvm), Arg::Str(operand.operand), Arg::Int(index)
        );
        current = next;
        index = index + 1;
    }
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_vector_lane(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: vector.lane expects one vector");
    }
    let vector = node.args.get_or_panic(0);
    let vector_text = ir::name_text(&module.names, vector.type_name);
    let vector_bytes = vector_text.as_bytes();
    let kind = typ::vector_kind(vector_bytes);
    if kind < 0 {
        return try self.fail0("llvm error: vector.lane expects a vector");
    }
    let lane = typ::vector_lane_of_kind(kind);
    if !module.names.is(node.result.type_name, lane) {
        return try self.fail0("llvm error: vector.lane result must be the lane type");
    }
    let name = try self.local_name(module, node.result.name);
    let vector_type = try self.llvm_type(module, vector_bytes);
    let operand = try self.operand(module, vector);
    let immediate = try self.own(module, node.immediate);
    try self.line4(
        "  %s = extractelement %s %s, i32 %s",
        Arg::Str(name), Arg::Str(vector_type), Arg::Str(operand.operand), Arg::Str(immediate)
    );
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) vector_splat_int(vec_type: []u8, value: []u8) -> !ir::Name {
    let kind = typ::vector_kind(vec_type);
    let lane = typ::vector_lane_of_kind(kind);
    let lanes = typ::vector_lanes(vec_type);
    let lane_llvm = llvm_primitive_type(lane);
    var out = try string::from_bytes(self.allocator, "<");
    errdefer out.deinit(self.allocator);
    var index = 0;
    while index < lanes {
        if index > 0 {
            try out.append_bytes(self.allocator, ", ");
        }
        try out.append_bytes(self.allocator, lane_llvm);
        try out.append_byte(self.allocator, cast<u8>(32));
        try out.append_bytes(self.allocator, value);
        index = index + 1;
    }
    try out.append_byte(self.allocator, cast<u8>(62));
    return self.names.intern_owned(move out);
}

fn slice_elem_align(elem: []u8) -> i64 {
    if mem::equal_bytes(elem, "f64") or mem::equal_bytes(elem, "i64") or mem::equal_bytes(elem, "u64") {
        return 8;
    }
    if mem::equal_bytes(elem, "f32") or mem::equal_bytes(elem, "i32") or mem::equal_bytes(elem, "u32") {
        return 4;
    }
    if mem::equal_bytes(elem, "i16") or mem::equal_bytes(elem, "u16") {
        return 2;
    }
    return 1;
}

fn (self: &var Emitter) write_vector_load(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("llvm error: vector.load expects slice and offset");
    }
    let slice_arg = node.args.get_or_panic(0);
    let view_text = ir::name_text(&module.names, slice_arg.type_name);
    let view_bytes = view_text.as_bytes();
    if !mem::starts_with(view_bytes, "[]") {
        return try self.fail0("llvm error: vector.load expects []T, i64");
    }
    let elem = view_bytes[2..mem::len(view_bytes)];
    let elem_llvm = try self.llvm_type(module, elem);
    let vec_llvm = try self.llvm_type_of(module, node.result.type_name);
    let slice = try self.operand(module, slice_arg);
    let offset = try self.operand(module, node.args.get_or_panic(1));
    let name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(name, ".ptr");
    let elem_ptr = try self.suffixed(name, ".elem.ptr");
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 0", Arg::Str(ptr_name), Arg::Str(slice.operand));
    try self.line4(
        "  %s = getelementptr inbounds %s, ptr %s, i64 %s",
        Arg::Str(elem_ptr), Arg::Str(elem_llvm), Arg::Str(ptr_name), Arg::Str(offset.operand)
    );
    try self.line4(
        "  %s = load %s, ptr %s, align %d",
        Arg::Str(name), Arg::Str(vec_llvm), Arg::Str(elem_ptr), Arg::Int(slice_elem_align(elem))
    );
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_vector_store(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 {
        return try self.fail0("llvm error: vector.store expects slice, offset, vector");
    }
    let slice_arg = node.args.get_or_panic(0);
    let view_text = ir::name_text(&module.names, slice_arg.type_name);
    let view_bytes = view_text.as_bytes();
    if !mem::starts_with(view_bytes, "[]") {
        return try self.fail0("llvm error: vector.store expects []T, i64, V");
    }
    let elem = view_bytes[2..mem::len(view_bytes)];
    let elem_llvm = try self.llvm_type(module, elem);
    let val_arg = node.args.get_or_panic(2);
    let vec_llvm = try self.llvm_type_of(module, val_arg.type_name);
    let slice = try self.operand(module, slice_arg);
    let offset = try self.operand(module, node.args.get_or_panic(1));
    let value = try self.operand(module, val_arg);
    let synthetic = try self.next_synthetic_value("vector.store");
    let base = try self.percent(synthetic);
    let ptr_name = try self.suffixed(base, ".ptr");
    let elem_ptr = try self.suffixed(base, ".elem.ptr");
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 0", Arg::Str(ptr_name), Arg::Str(slice.operand));
    try self.line4(
        "  %s = getelementptr inbounds %s, ptr %s, i64 %s",
        Arg::Str(elem_ptr), Arg::Str(elem_llvm), Arg::Str(ptr_name), Arg::Str(offset.operand)
    );
    try self.line4(
        "  store %s %s, ptr %s, align %d",
        Arg::Str(vec_llvm), Arg::Str(value.operand), Arg::Str(elem_ptr), Arg::Int(slice_elem_align(elem))
    );
    try self.set_void_value(module, node.result);
    return null;
}

fn (self: &var Emitter) write_vector_tbl16(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("llvm error: vector.tbl16 expects 2 args");
    }
    let tbl = try self.operand(module, node.args.get_or_panic(0));
    let idx = try self.operand(module, node.args.get_or_panic(1));
    let name = try self.local_name(module, node.result.name);
    if self.arch == Arch::Arm64 {
        try self.line3(
            "  %s = call <16 x i8> @llvm.aarch64.neon.tbl1.v16i8(<16 x i8> %s, <16 x i8> %s)",
            Arg::Str(name), Arg::Str(tbl.operand), Arg::Str(idx.operand)
        );
        try self.set_value(module, node.result, name);
        return null;
    }
    if self.has_ssse3 {
        let oob = try self.suffixed(name, ".oob");
        let masked = try self.suffixed(name, ".masked");
        let sixteen = try self.vector_splat_int("u8x16", "16");
        let neg128 = try self.vector_splat_int("u8x16", "-128");
        try self.line3(
            "  %s = icmp uge <16 x i8> %s, %s",
            Arg::Str(oob), Arg::Str(idx.operand), Arg::Str(sixteen)
        );
        try self.line4(
            "  %s = select <16 x i1> %s, <16 x i8> %s, <16 x i8> %s",
            Arg::Str(masked), Arg::Str(oob), Arg::Str(neg128), Arg::Str(idx.operand)
        );
        try self.line3(
            "  %s = call <16 x i8> @llvm.x86.ssse3.pshuf.b.128(<16 x i8> %s, <16 x i8> %s)",
            Arg::Str(name), Arg::Str(tbl.operand), Arg::Str(masked)
        );
        try self.set_value(module, node.result, name);
        return null;
    }
    let slot = try self.suffixed(name, ".tbl");
    try self.line1("  %s = alloca [16 x i8], align 16", Arg::Str(slot));
    try self.line2("  store <16 x i8> %s, ptr %s, align 16", Arg::Str(tbl.operand), Arg::Str(slot));
    var current = try self.names.intern("poison");
    for 0..16 |lane| {
        var suffix = try string::from_bytes(self.allocator, ".l");
        defer suffix.deinit(self.allocator);
        try fmt::append_i64(self.allocator, &var suffix, lane);
        let sbytes = suffix.as_bytes();
        let lane_base = try self.suffixed(name, sbytes);
        let k = try self.suffixed(lane_base, ".k");
        let ok = try self.suffixed(lane_base, ".ok");
        let safe = try self.suffixed(lane_base, ".safe");
        let ext = try self.suffixed(lane_base, ".ext");
        let ptr = try self.suffixed(lane_base, ".p");
        let val = try self.suffixed(lane_base, ".v");
        let picked = try self.suffixed(lane_base, ".o");
        var next = name;
        if lane < 15 {
            next = try self.suffixed(lane_base, ".vec");
        }
        try self.line3("  %s = extractelement <16 x i8> %s, i32 %d", Arg::Str(k), Arg::Str(idx.operand), Arg::Int(lane));
        try self.line2("  %s = icmp ult i8 %s, 16", Arg::Str(ok), Arg::Str(k));
        try self.line3("  %s = select i1 %s, i8 %s, i8 0", Arg::Str(safe), Arg::Str(ok), Arg::Str(k));
        try self.line2("  %s = zext i8 %s to i64", Arg::Str(ext), Arg::Str(safe));
        try self.line3("  %s = getelementptr inbounds [16 x i8], ptr %s, i64 0, i64 %s", Arg::Str(ptr), Arg::Str(slot), Arg::Str(ext));
        try self.line2("  %s = load i8, ptr %s, align 1", Arg::Str(val), Arg::Str(ptr));
        try self.line3("  %s = select i1 %s, i8 %s, i8 0", Arg::Str(picked), Arg::Str(ok), Arg::Str(val));
        try self.line4("  %s = insertelement <16 x i8> %s, i8 %s, i32 %d", Arg::Str(next), Arg::Str(current), Arg::Str(picked), Arg::Int(lane));
        current = next;
    }
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_vector_sdot(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 {
        return try self.fail0("llvm error: vector.sdot expects 3 args");
    }
    let acc = try self.operand(module, node.args.get_or_panic(0));
    let a = try self.operand(module, node.args.get_or_panic(1));
    let b = try self.operand(module, node.args.get_or_panic(2));
    let name = try self.local_name(module, node.result.name);
    if self.has_dotprod {
        try self.line4(
            "  %s = call <4 x i32> @llvm.aarch64.neon.sdot.v4i32.v16i8(<4 x i32> %s, <16 x i8> %s, <16 x i8> %s)",
            Arg::Str(name), Arg::Str(acc.operand), Arg::Str(a.operand), Arg::Str(b.operand)
        );
        try self.set_value(module, node.result, name);
        return null;
    }
    let ae = try self.suffixed(name, ".ae");
    let be = try self.suffixed(name, ".be");
    let mul = try self.suffixed(name, ".m");
    let lo1 = try self.suffixed(name, ".lo1");
    let hi1 = try self.suffixed(name, ".hi1");
    let p1 = try self.suffixed(name, ".p1");
    let lo2 = try self.suffixed(name, ".lo2");
    let hi2 = try self.suffixed(name, ".hi2");
    let p2 = try self.suffixed(name, ".p2");
    try self.line2("  %s = sext <16 x i8> %s to <16 x i32>", Arg::Str(ae), Arg::Str(a.operand));
    try self.line2("  %s = sext <16 x i8> %s to <16 x i32>", Arg::Str(be), Arg::Str(b.operand));
    try self.line3("  %s = mul <16 x i32> %s, %s", Arg::Str(mul), Arg::Str(ae), Arg::Str(be));
    try self.line2(
        "  %s = shufflevector <16 x i32> %s, <16 x i32> poison, <8 x i32> <i32 0, i32 2, i32 4, i32 6, i32 8, i32 10, i32 12, i32 14>",
        Arg::Str(lo1), Arg::Str(mul)
    );
    try self.line2(
        "  %s = shufflevector <16 x i32> %s, <16 x i32> poison, <8 x i32> <i32 1, i32 3, i32 5, i32 7, i32 9, i32 11, i32 13, i32 15>",
        Arg::Str(hi1), Arg::Str(mul)
    );
    try self.line3("  %s = add <8 x i32> %s, %s", Arg::Str(p1), Arg::Str(lo1), Arg::Str(hi1));
    try self.line2(
        "  %s = shufflevector <8 x i32> %s, <8 x i32> poison, <4 x i32> <i32 0, i32 2, i32 4, i32 6>",
        Arg::Str(lo2), Arg::Str(p1)
    );
    try self.line2(
        "  %s = shufflevector <8 x i32> %s, <8 x i32> poison, <4 x i32> <i32 1, i32 3, i32 5, i32 7>",
        Arg::Str(hi2), Arg::Str(p1)
    );
    try self.line3("  %s = add <4 x i32> %s, %s", Arg::Str(p2), Arg::Str(lo2), Arg::Str(hi2));
    try self.line3("  %s = add <4 x i32> %s, %s", Arg::Str(name), Arg::Str(acc.operand), Arg::Str(p2));
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_vector_convert(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: vector.convert expects 1 arg");
    }
    let src_arg = node.args.get_or_panic(0);
    let src = try self.operand(module, src_arg);
    if (module.names.is(src_arg.type_name, "u8x16") and module.names.is(node.result.type_name, "i8x16")) or
        (module.names.is(src_arg.type_name, "i8x16") and module.names.is(node.result.type_name, "u8x16")) {
        try self.set_value(module, node.result, src.operand);
        return null;
    }
    let name = try self.local_name(module, node.result.name);
    if module.names.is(src_arg.type_name, "i32x4") and module.names.is(node.result.type_name, "f32x4") {
        try self.line2("  %s = sitofp <4 x i32> %s to <4 x float>", Arg::Str(name), Arg::Str(src.operand));
        try self.set_value(module, node.result, name);
        return null;
    }
    if module.names.is(src_arg.type_name, "f32x4") and module.names.is(node.result.type_name, "i32x4") {
        try self.line2("  %s = call <4 x i32> @llvm.fptosi.sat.v4i32.v4f32(<4 x float> %s)", Arg::Str(name), Arg::Str(src.operand));
        try self.set_value(module, node.result, name);
        return null;
    }
    if module.names.is(src_arg.type_name, "i8x16") and module.names.is(node.result.type_name, "f32x4") {
        var mask = "<i32 0, i32 1, i32 2, i32 3>";
        if module.names.is(node.immediate, "1") {
            mask = "<i32 4, i32 5, i32 6, i32 7>";
        } else if module.names.is(node.immediate, "2") {
            mask = "<i32 8, i32 9, i32 10, i32 11>";
        } else if module.names.is(node.immediate, "3") {
            mask = "<i32 12, i32 13, i32 14, i32 15>";
        }
        let shuf = try self.suffixed(name, ".shuf");
        let ext = try self.suffixed(name, ".ext");
        try self.line3(
            "  %s = shufflevector <16 x i8> %s, <16 x i8> poison, <4 x i32> %s",
            Arg::Str(shuf), Arg::Str(src.operand), Arg::Lit(mask)
        );
        try self.line2("  %s = sext <4 x i8> %s to <4 x i32>", Arg::Str(ext), Arg::Str(shuf));
        try self.line2("  %s = sitofp <4 x i32> %s to <4 x float>", Arg::Str(name), Arg::Str(ext));
        try self.set_value(module, node.result, name);
        return null;
    }
    return try self.fail_name2(
        module, "llvm error: unsupported vector.convert from %s to %s", src_arg.type_name, node.result.type_name
    );
}

fn (self: &var Emitter) write_int_popcount(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: int.popcount expects 1 arg");
    }
    let src = try self.operand(module, node.args.get_or_panic(0));
    let name = try self.local_name(module, node.result.name);
    if module.names.is(node.result.type_name, "u32") {
        try self.line2("  %s = call i32 @llvm.ctpop.i32(i32 %s)", Arg::Str(name), Arg::Str(src.operand));
    } else if module.names.is(node.result.type_name, "u64") {
        try self.line2("  %s = call i64 @llvm.ctpop.i64(i64 %s)", Arg::Str(name), Arg::Str(src.operand));
    } else if module.names.is(node.result.type_name, "u8x16") {
        try self.line2("  %s = call <16 x i8> @llvm.ctpop.v16i8(<16 x i8> %s)", Arg::Str(name), Arg::Str(src.operand));
    } else {
        return try self.fail_name1(module, "llvm error: unsupported int.popcount type `%s`", node.result.type_name);
    }
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_slice_store(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let view_text = ir::name_text(&module.names, node.args.get_or_panic(0).type_name);
    let view_bytes = view_text.as_bytes();
    if !mem::starts_with(view_bytes, "[]") {
        return try self.fail0("llvm error: slice.store expects []T, i64, T");
    }
    let elem = view_bytes[2..mem::len(view_bytes)];
    if node.args.len() != 3 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.args.get_or_panic(2).type_name, elem) {
        return try self.fail0("llvm error: slice.store expects []T, i64, T");
    }
    let elem_name = try self.llvm_type(module, elem);
    let slice = try self.operand(module, node.args.get_or_panic(0));
    let index = try self.operand(module, node.args.get_or_panic(1));
    let synthetic = try self.next_synthetic_value("slice.store");
    let base = try self.percent(synthetic);
    let ptr_name = try self.suffixed(base, ".ptr");
    let elem_ptr_name = try self.suffixed(base, ".elem.ptr");
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 0", Arg::Str(ptr_name), Arg::Str(slice.operand));
    try self.line4(
        "  %s = getelementptr inbounds %s, ptr %s, i64 %s",
        Arg::Str(elem_ptr_name), Arg::Str(elem_name), Arg::Str(ptr_name), Arg::Str(index.operand)
    );
    if !try self.copied_from_memory(module, node, 2, elem_ptr_name) {
        let value = try self.operand(module, node.args.get_or_panic(2));
        try self.line3("  store %s %s, ptr %s", Arg::Str(elem_name), Arg::Str(value.operand), Arg::Str(elem_ptr_name));
    }
    return null;
}

fn (self: &var Emitter) write_slice_len(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or
        !module.names.starts_with(node.args.get_or_panic(0).type_name, "[]") or
        !module.names.is(node.result.type_name, "i64") {
        return try self.fail0("llvm error: slice.len expects []T -> i64");
    }
    let slice = try self.operand(module, node.args.get_or_panic(0));
    let result_name = try self.local_name(module, node.result.name);
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 1", Arg::Str(result_name), Arg::Str(slice.operand));
    try self.set_value(module, node.result, result_name);
    return null;
}

fn (self: &var Emitter) write_slice_ptr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or
        !module.names.starts_with(node.args.get_or_panic(0).type_name, "[]") or
        !module.names.starts_with(node.result.type_name, "ptr<") {
        return try self.fail0("llvm error: slice.ptr expects []T -> ptr<T>");
    }
    let slice = try self.operand(module, node.args.get_or_panic(0));
    let result_name = try self.local_name(module, node.result.name);
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 0", Arg::Str(result_name), Arg::Str(slice.operand));
    try self.set_value(module, node.result, result_name);
    return null;
}

fn (self: &var Emitter) write_slice_from_ptr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or
        !module.names.starts_with(node.result.type_name, "[]") or
        !module.names.starts_with(node.args.get_or_panic(0).type_name, "ptr<") or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") {
        return try self.fail0("llvm error: slice.from_ptr expects ptr<T>, i64 -> []T");
    }
    let pointer = try self.operand(module, node.args.get_or_panic(0));
    let count = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    let base_name = try self.suffixed(result_name, ".base");
    try self.line2("  %s = insertvalue %%kizu.slice.u8 poison, ptr %s, 0", Arg::Str(base_name), Arg::Str(pointer.operand));
    try self.line3(
        "  %s = insertvalue %%kizu.slice.u8 %s, i64 %s, 1",
        Arg::Str(result_name), Arg::Str(base_name), Arg::Str(count.operand)
    );
    try self.set_value(module, node.result, result_name);
    return null;
}

fn (self: &var Emitter) write_ptr_offset(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let pointer_text = ir::name_text(&module.names, node.args.get_or_panic(0).type_name);
    let pointer_bytes = pointer_text.as_bytes();
    if node.args.len() != 2 or !is_raw_pointer_type(pointer_bytes) or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !ir::same_name(node.result.type_name, node.args.get_or_panic(0).type_name) {
        return try self.fail0("llvm error: ptr.offset expects ptr<T>, i64 -> ptr<T>");
    }
    let elem = deref_llvm_type(pointer_bytes);
    let elem_name = try self.llvm_type(module, elem);
    let pointer = try self.operand(module, node.args.get_or_panic(0));
    let count = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    try self.line4(
        "  %s = getelementptr %s, ptr %s, i64 %s",
        Arg::Str(result_name), Arg::Str(elem_name), Arg::Str(pointer.operand), Arg::Str(count.operand)
    );
    try self.set_value(module, node.result, result_name);
    return null;
}

fn (self: &var Emitter) write_ptr_has(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let pointer = node.args.get(0) orelse ir::empty_value();
    let pointer_text = ir::name_text(&module.names, pointer.type_name);
    let pointer_bytes = pointer_text.as_bytes();
    if node.args.len() != 1 or !is_nullable_pointer_type(pointer_bytes) {
        return try self.fail0("llvm error: ptr.has expects ?ptr<T> -> bool");
    }
    let info = try self.operand(module, pointer);
    let result_name = try self.local_name(module, node.result.name);
    try self.line2("  %s = icmp ne ptr %s, null", Arg::Str(result_name), Arg::Str(info.operand));
    try self.set_value(module, node.result, result_name);
    return null;
}

fn (self: &var Emitter) write_ptr_value(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let pointer = node.args.get(0) orelse ir::empty_value();
    let pointer_text = ir::name_text(&module.names, pointer.type_name);
    let pointer_bytes = pointer_text.as_bytes();
    if node.args.len() != 1 or !is_nullable_pointer_type(pointer_bytes) {
        return try self.fail0("llvm error: ptr.value expects ?ptr<T> -> ptr<T>");
    }
    let carried = try self.operand(module, pointer);
    try self.set_value(module, node.result, carried.operand);
    return null;
}

fn (self: &var Emitter) write_slice_index(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let view_text = ir::name_text(&module.names, node.args.get_or_panic(0).type_name);
    let view_bytes = view_text.as_bytes();
    if !mem::starts_with(view_bytes, "[]") {
        return try self.fail0("llvm error: slice.index expects []T, i64 -> T");
    }
    let elem = view_bytes[2..mem::len(view_bytes)];
    if node.args.len() != 2 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.result.type_name, elem) {
        return try self.fail0("llvm error: slice.index expects []T, i64 -> T");
    }
    let elem_name = try self.llvm_type(module, elem);
    let slice = try self.operand(module, node.args.get_or_panic(0));
    let index = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".ptr");
    let elem_ptr_name = try self.suffixed(result_name, ".elem.ptr");
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 0", Arg::Str(ptr_name), Arg::Str(slice.operand));
    try self.line4(
        "  %s = getelementptr inbounds %s, ptr %s, i64 %s",
        Arg::Str(elem_ptr_name), Arg::Str(elem_name), Arg::Str(ptr_name), Arg::Str(index.operand)
    );
    if try self.copied_into_memory(module, node.result, elem_ptr_name) {
        return null;
    }
    try self.write_value_load(result_name, "", elem_name, elem_ptr_name, 0, "");
    try self.set_value(module, node.result, result_name);
    return null;
}

fn (self: &var Emitter) write_slice_slice(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let view_text = ir::name_text(&module.names, node.args.get_or_panic(0).type_name);
    let view_bytes = view_text.as_bytes();
    if !mem::starts_with(view_bytes, "[]") {
        return try self.fail0("llvm error: slice.slice expects []T, i64, i64 -> []T");
    }
    let elem = view_bytes[2..mem::len(view_bytes)];
    if node.args.len() != 3 or
        !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.args.get_or_panic(2).type_name, "i64") or
        !ir::same_name(node.result.type_name, node.args.get_or_panic(0).type_name) {
        return try self.fail0("llvm error: slice.slice expects []T, i64, i64 -> []T");
    }
    let elem_name = try self.llvm_type(module, elem);
    let slice = try self.operand(module, node.args.get_or_panic(0));
    let start = try self.operand(module, node.args.get_or_panic(1));
    let end = try self.operand(module, node.args.get_or_panic(2));
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".source.ptr");
    let slice_ptr_name = try self.suffixed(result_name, ".ptr");
    let base_name = try self.suffixed(result_name, ".base");
    let slice_len_name = try self.suffixed(result_name, ".len");
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 0", Arg::Str(ptr_name), Arg::Str(slice.operand));
    try self.line4(
        "  %s = getelementptr %s, ptr %s, i64 %s",
        Arg::Str(slice_ptr_name), Arg::Str(elem_name), Arg::Str(ptr_name), Arg::Str(start.operand)
    );
    try self.line3("  %s = sub i64 %s, %s", Arg::Str(slice_len_name), Arg::Str(end.operand), Arg::Str(start.operand));
    try self.line2("  %s = insertvalue %%kizu.slice.u8 poison, ptr %s, 0", Arg::Str(base_name), Arg::Str(slice_ptr_name));
    try self.line3(
        "  %s = insertvalue %%kizu.slice.u8 %s, i64 %s, 1",
        Arg::Str(result_name), Arg::Str(base_name), Arg::Str(slice_len_name)
    );
    try self.set_value(module, node.result, result_name);
    return null;
}

fn (self: &var Emitter) write_buffer_new(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    if try self.buffer_size(result_type) |_| {
        let constant = try self.names.intern("zeroinitializer");
        try self.set_value(module, node.result, constant);
        return null;
    }
    return try self.fail_name1(module, "llvm error: buffer.new expects `[N]T` result, got %s", node.result.type_name);
}

fn (self: &var Emitter) write_buffer_as_bytes(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.starts_with(node.result.type_name, "[]") {
        return try self.fail0("llvm error: buffer.as_bytes expects `&var [N]T` -> `[]T`");
    }
    let storage_arg = node.args.get_or_panic(0);
    let storage_text = ir::name_text(&module.names, storage_arg.type_name);
    let storage_bytes = storage_text.as_bytes();
    let array_bytes = deref_llvm_type(storage_bytes);
    if try self.buffer_size(array_bytes) |size| {
        let storage = try self.operand(module, storage_arg);
        let result_name = try self.local_name(module, node.result.name);
        let base_name = try self.suffixed(result_name, ".base");
        try self.line2("  %s = insertvalue %%kizu.slice.u8 poison, ptr %s, 0", Arg::Str(base_name), Arg::Str(storage.operand));
        try self.line3(
            "  %s = insertvalue %%kizu.slice.u8 %s, i64 %d, 1",
            Arg::Str(result_name), Arg::Str(base_name), Arg::Int(size)
        );
        try self.set_value(module, node.result, result_name);
        return null;
    }
    return try self.fail_name1(module, "llvm error: buffer.as_bytes expects the storage of `[N]T`, got %s", storage_arg.type_name);
}

fn (self: &var Emitter) write_buffer_addr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 {
        return try self.fail0("llvm error: buffer.addr expects the storage of `[N]T` and an index");
    }
    let storage_arg = node.args.get_or_panic(0);
    let storage_text = ir::name_text(&module.names, storage_arg.type_name);
    let storage_bytes = storage_text.as_bytes();
    let array = deref_llvm_type(storage_bytes);
    let elem = try self.buffer_elem(array) orelse
        return try self.fail_name2(module, "llvm error: buffer.addr expects `&var [N]T` -> `&var T`, got %s -> %s",
        storage_arg.type_name, node.result.type_name);
    defer elem.deinit(self.allocator);
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_bytes = result_text.as_bytes();
    let elem_bytes = elem.as_bytes();
    let pointed = deref_llvm_type(result_bytes);
    if !mem::equal_bytes(pointed, elem_bytes) {
        return try self.fail_name2(module, "llvm error: buffer.addr expects `&var [N]T` -> `&var T`, got %s -> %s",
            storage_arg.type_name, node.result.type_name);
    }
    let storage = try self.operand(module, storage_arg);
    let position = try self.operand(module, node.args.get_or_panic(1));
    let name = try self.local_name(module, node.result.name);
    let llvm_array = try self.llvm_type(module, array);
    try self.line4(
        "  %s = getelementptr inbounds %s, ptr %s, i64 0, i64 %s",
        Arg::Str(name), Arg::Str(llvm_array), Arg::Str(storage.operand), Arg::Str(position.operand)
    );
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) buffer_elem(typ_name: []u8) -> !?string::String {
    if mem::len(typ_name) == 0 {
        return null;
    }
    let parsed = try self.types.parse(typ_name);
    match typ::root_node(&self.types, parsed) {
        Buffer(node) => {
            let child = typ::child_type(parsed, node.elem);
            return try typ::render(self.allocator, &self.types, child);
        },
        _ => return null,
    }
}

fn (self: &var Emitter) buffer_size(typ_name: []u8) -> !?i64 {
    if mem::len(typ_name) == 0 {
        return null;
    }
    let parsed = try self.types.parse(typ_name);
    match typ::root_node(&self.types, parsed) {
        Buffer(node) => return node.size,
        _ => return null,
    }
}

fn (self: &var Emitter) write_cond_fail(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let imm = ir::name_text(&module.names, node.immediate);
    let imm_bytes = imm.as_bytes();
    if parse_panic_key(imm_bytes) |key| {
        let spec = panic_entry(key);
        let param_count = panic_param_count(spec.params);
        if node.args.len() != param_count + 1 or !module.names.is(node.args.get_or_panic(0).type_name, "bool") {
            let shown = try self.own(module, node.immediate);
            return try self.fail2(
                "llvm error: cond_fail `%s` expects bool and %d values", Arg::Str(shown), Arg::Int(param_count)
            );
        }
        let cond_value = node.args.get_or_panic(0);
        let cond = try self.operand(module, cond_value);
        var typed = array::new<string::String>(self.allocator);
        defer typed.deinit(self.allocator);
        var index = 1;
        while node.args.get(index) |arg| {
            let value = try self.operand(module, arg);
            let param = panic_param_at(spec.params, index - 1);
            var part = try string::from_bytes(self.allocator, param);
            errdefer part.deinit(self.allocator);
            try part.append_bytes(self.allocator, " ");
            try self.names.append_to(&var part, value.operand);
            try typed.append(self.allocator, move part);
            index = index + 1;
        }
        let position = try self.panic_position(node.span);
        try typed.append(self.allocator, try self.names.copy(position));
        let check_synthetic = try self.next_synthetic_value("check");
        let check = try self.percent(check_synthetic);
        let fail_label = try self.helper_label_local(check, "fail");
        let ok_label = try self.helper_label_local(check, "pass");
        try self.mark_current_block_exit(module, ok_label);
        try self.line3(
            "  br i1 %s, label %%%s, label %%%s", Arg::Str(cond.operand), Arg::Str(fail_label), Arg::Str(ok_label)
        );
        try self.line1("%s:", Arg::Str(fail_label));
        let joined = try string::join(self.allocator, &typed, ", ");
        try self.line2("  call void @%s(%s)", Arg::Lit(spec.entry), Arg::Owned(move joined));
        try self.line("  unreachable");
        try self.line1("%s:", Arg::Str(ok_label));
        return null;
    }
    return try self.fail_name1(module, "llvm error: unknown cond_fail kind `%s`", node.immediate);
}

fn (self: &var Emitter) write_panic_fail(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.args.get_or_panic(0).type_name, "[]u8") {
        return try self.fail0("llvm error: panic.fail expects one []u8 message");
    }
    let result_name = try self.local_name(module, node.result.name);
    let msg_name = try self.suffixed(result_name, ".msg");
    let value = try self.operand(module, node.args.get_or_panic(0));
    let parts = try self.write_slice_parts(msg_name, value.operand);
    let position = try self.panic_position(node.span);
    try self.line3(
        "  call void @kizu_panic_fail(ptr %s, i64 %s, %s)", Arg::Str(parts.ptr), Arg::Str(parts.len), Arg::Str(position)
    );
    try self.line("  unreachable");
    self.wrote_open_trap = true;
    try self.set_void_value(module, node.result);
    return null;
}

fn (self: &var Emitter) write_phi(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    var parts = array::new<string::String>(self.allocator);
    defer parts.deinit(self.allocator);
    var index = 0;
    while node.incoming.get(index) |incoming| {
        index = index + 1;
        var operand = ir::empty_name();
        if self.value_written(incoming.value.name) {
            let value = try self.operand(module, incoming.value);
            operand = value.operand;
        } else {
            let spelled = try self.own(module, incoming.value.name);
            operand = try self.names.wrapped(phi_value_mark(), spelled, "");
            self.wrote_phi_value_mark = true;
        }
        let block_text = ir::name_text(&module.names, incoming.block);
        let block_bytes = block_text.as_bytes();
        let block = try self.names.intern(block_bytes);
        try parts.append(self.allocator, try self.sprint3(
            "[ %s, %s%s ]", Arg::Str(operand), Arg::Lit(phi_predecessor_mark()), Arg::Str(block)
        ));
    }
    let name = try self.local_name(module, node.result.name);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    try self.note_phi_type(result_type);
    let joined = try string::join(self.allocator, &parts, ", ");
    try self.line3("  %s = phi %s %s", Arg::Str(name), Arg::Str(result_type), Arg::Owned(move joined));
    try self.set_value(module, node.result, name);
    return null;
}

fn (self: &var Emitter) write_print_line(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.args.get_or_panic(0).type_name, "[]u8") {
        return try self.fail0("llvm error: print.line expects []u8");
    }
    let arg = node.args.get_or_panic(0);
    let value = try self.operand(module, arg);
    let ptr_synthetic = try self.next_synthetic_value("print.slice.ptr");
    let ptr_name = try self.percent(ptr_synthetic);
    let len_synthetic = try self.next_synthetic_value("print.slice.len");
    let len_name = try self.percent(len_synthetic);
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 0", Arg::Str(ptr_name), Arg::Str(value.operand));
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 1", Arg::Str(len_name), Arg::Str(value.operand));
    try self.line2("  call void @kizu_print_string(ptr %s, i64 %s)", Arg::Str(ptr_name), Arg::Str(len_name));
    return null;
}
