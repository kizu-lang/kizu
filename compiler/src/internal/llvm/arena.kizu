import compiler::internal::diagnostic;
import compiler::internal::ir;
import std::mem;
import std::string;

// Mechanical port of internal/llvm/arena.go.
//
// An arena is the header an array is -- `{data, len, cap}` -- and owns its
// elements the same way, so everything below reaches for the array lowering
// rather than repeating it. What separates the two is above the backend: a
// Handle is an index rather than a borrow, and nothing is removed from the
// middle, which is why the index a handle carries stays the element's for as
// long as the arena lives. runtime.c has no arena entry points for the same
// reason (ADR-0131).

/// Reports whether a lowered IR type is a std::arena::Arena<T>, the Go
/// `isArenaLLVMType`.
fn is_arena_llvm_type(typ_name: []u8) -> bool {
    return mem::starts_with(typ_name, "std::arena::Arena<") and ir::ends_with_bytes(typ_name, ">");
}

/// Dispatches runtime-backed Arena operations, the Go `writeArenaInstr`.
fn (self: &var Emitter) write_arena_instr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    match node.op {
        ArenaNew => return self.write_arena_new(module, node),
        ArenaAdd => return self.write_arena_add(module, node),
        ArenaAt => return self.write_arena_at(module, node),
        ArenaAtMut => return self.write_arena_at_mut(module, node),
        ArenaLen => return self.write_arena_len(module, node),
        ArenaPopOrPanic => return self.write_arena_pop_or_panic(module, node),
        ArenaDeinit => return self.write_arena_deinit(module, node),
        _ => {
            let op = try self.op_name(module, node);
            return try self.fail1("llvm error: unsupported arena instruction `%s`", Arg::Str(op));
        },
    }
}

/// Lowers std::arena::new<T>(allocator) to the header value an empty arena is,
/// the Go `writeArenaNew`: three zero words, and no allocation to fail at. The
/// first add is what buys storage, and it is the call that names an allocator
/// and says whether it got any (ADR-0131).
fn (self: &var Emitter) write_arena_new(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    if node.args.len() != 1 or !is_arena_llvm_type(result_type) {
        return try self.fail0("llvm error: arena.new expects allocator -> Arena<T>");
    }
    let zero = try self.names.intern("zeroinitializer");
    try self.set_value(module, node.result, zero);
    return null;
}

/// Reports whether a type the module names is std::arena::Handle<T>, the Go
/// `isArenaHandleType` on an IR value's type.
fn is_arena_handle_name(names: &ir::NameTable, typ_name: ir::Name) -> bool {
    let retained = ir::name_text(names, typ_name);
    let bytes = retained.as_bytes();
    return is_arena_handle_type(bytes);
}

/// Lowers try Arena.add(allocator, value), the Go `writeArenaAdd`. The element
/// goes where an append would put it, and the length the append started from
/// is the handle: nothing is ever removed from the middle, so that index names
/// the element for as long as the arena holds it. This is the call that buys
/// storage, so an allocator that refuses comes back as the failure half of the
/// union, the same way an append's does (ADR-0131).
fn (self: &var Emitter) write_arena_add(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    var success_is_handle = false;
    if try self.error_union_success_type(result_type) |success| {
        defer success.deinit(self.allocator);
        let success_bytes = success.as_bytes();
        success_is_handle = is_arena_handle_type(success_bytes);
    }
    if node.args.len() != 3 or !success_is_handle {
        return try self.fail0(
            "llvm error: arena.add expects Arena<T>, Allocator, T -> std::mem::Error!Handle<T>");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    if !try self.instr_element_type(module, node, &var elem) {
        return try self.fail0(
            "llvm error: emitter bug: instruction measures an element but was handed no container");
    }
    let elem_bytes = elem.as_bytes();
    let arena = try self.operand(module, node.args.get_or_panic(0));
    let handle = try self.array_handle(arena.operand);
    let result_name = try self.local_name(module, node.result.name);
    let ok_name = try self.suffixed(result_name, ".ok");
    let index = try self.write_array_append_paths(
        module, node, arena.operand, handle, ok_name, elem_bytes);
    return self.write_error_union_from_bool(
        module, node.result, ok_name, FailureKey::ArenaAdd, index, "i64");
}

/// Returns the number of initialized elements still owned by the arena, the
/// Go `writeArenaLen`.
fn (self: &var Emitter) write_arena_len(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.result.type_name, "i64") {
        return try self.fail0("llvm error: arena.len expects Arena<T> -> i64");
    }
    let arena = try self.operand(module, node.args.get_or_panic(0));
    let handle = try self.array_handle(arena.operand);
    let result_name = try self.local_name(module, node.result.name);
    try self.array_load_field(handle, array_field_len(), "arena.len", result_name);
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Moves the last element out for Arena.deinit's cleanup cascade, the Go
/// `writeArenaPopOrPanic`.
fn (self: &var Emitter) write_arena_pop_or_panic(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: arena.pop_or_panic expects Arena<T> -> T");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    if !try self.instr_element_type(module, node, &var elem) {
        return try self.fail0(
            "llvm error: emitter bug: instruction measures an element but was handed no container");
    }
    let elem_bytes = elem.as_bytes();
    let arena = try self.operand(module, node.args.get_or_panic(0));
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".ptr");
    let size = try self.element_size_operand_bytes(module, elem_bytes);
    try self.line3(
        "  %s = call ptr @kizu_array_pop(ptr %s, i64 %s)",
        Arg::Str(ptr_name), Arg::Str(arena.operand), Arg::Str(size)
    );
    let none = self.no_names();
    defer none.deinit(self.allocator);
    try self.write_null_failure(module, node, ptr_name, "arena.pop.panic", PanicKey::ArenaEmpty, &none);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    try self.line3("  %s = load %s, ptr %s", Arg::Str(result_name), Arg::Str(result_type), Arg::Str(ptr_name));
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Lowers Arena.at(handle) to a checked shared borrow, the Go `writeArenaAt`.
/// Borrows with value IR load a copy; address-spelled borrows (currently
/// unions) keep the element address.
fn (self: &var Emitter) write_arena_at(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !is_arena_handle_name(&module.names, node.args.get_or_panic(1).type_name) {
        return try self.fail0("llvm error: arena.at expects Arena<T>, Handle<T> -> &T");
    }
    let ptr_name = try self.arena_checked_element(module, node) orelse
        return try self.fail0(
            "llvm error: emitter bug: instruction measures an element but was handed no container");
    let none = self.no_names();
    defer none.deinit(self.allocator);
    try self.write_null_failure(module, node, ptr_name, "arena.at", PanicKey::ArenaHandle, &none);
    if module.names.starts_with(node.result.type_name, "&") {
        try self.set_value(module, node.result, ptr_name);
        return null;
    }
    let result_name = try self.local_name(module, node.result.name);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    try self.line3("  %s = load %s, ptr %s", Arg::Str(result_name), Arg::Str(result_type), Arg::Str(ptr_name));
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Lowers Arena.at_mut(handle) to a borrow optional, the Go
/// `writeArenaAtMut`: the nullable element pointer becomes the payload and its
/// presence, branch-free. It reaches the same element Arena.at does and skips
/// both the trap and the load.
fn (self: &var Emitter) write_arena_at_mut(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !is_arena_handle_name(&module.names, node.args.get_or_panic(1).type_name) {
        return try self.fail0("llvm error: arena.at_mut expects Arena<T>, Handle<T> -> ?&var T");
    }
    let ptr_name = try self.arena_checked_element(module, node) orelse
        return try self.fail0(
            "llvm error: emitter bug: instruction measures an element but was handed no container");
    return self.write_borrow_optional_result(module, node, ptr_name);
}

/// Returns the address of the element a handle names, or null when the handle
/// is outside the arena, the Go `arenaCheckedElement`. The address is named
/// after the result rather than synthesized, because continuation_label
/// predicts the label the trap continues at from that name before this block
/// is written.
fn (self: &var Emitter) arena_checked_element(
    module: &ir::Module,
    node: &ir::InstrNode
) -> !?ir::Name {
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    if !try self.instr_element_type(module, node, &var elem) {
        return null;
    }
    let elem_bytes = elem.as_bytes();
    let arena = try self.operand(module, node.args.get_or_panic(0));
    let index = try self.operand(module, node.args.get_or_panic(1));
    let handle = try self.array_handle(arena.operand);
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".ptr");
    return try self.array_checked_element(module, node, handle, index.operand, elem_bytes, ptr_name);
}

/// Lowers Arena.deinit(allocator), the Go `writeArenaDeinit`. It releases the
/// storage and nothing else: the elements are the caller's to consume first,
/// the same way Array.deinit is handed an array whose owners are already gone.
fn (self: &var Emitter) write_arena_deinit(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.result.type_name, "void") {
        return try self.fail0("llvm error: arena.deinit expects Arena<T>, Allocator -> void");
    }
    return self.write_container_storage_release(module, node, "arena.deinit");
}

