import compiler::internal::diagnostic;
import compiler::internal::hostabi;
import compiler::internal::ir;
import std::array;
import std::map;
import std::string;

// The pool-round calls, by the signature hostabi declares, and the thunks
// they call every worker through, one per worker error set.

/// Names the error set a pool round's worker fails with, the Go
/// `threadRoundSet`: the round returns `E!void` with the same E.
fn (self: &var Emitter) thread_round_set(module: &ir::Module, node: &ir::InstrNode) -> !string::String {
    let result = ir::name_text(&module.names, node.result.type_name);
    let bytes = result.as_bytes();
    let parts = try self.error_union_parts(bytes) orelse return string::new(self.allocator);
    parts.success.deinit(self.allocator);
    return move parts.err;
}

/// Names the adapter a round whose worker fails with `set`, and takes a state
/// first when `states`, calls that worker through, the Go
/// `threadInvokeThunkName`.
fn (self: &var Emitter) thread_invoke_thunk_name(set: []u8, states: bool) -> !ir::Name {
    var prefix = "kizu.thread.each.invoke.";
    if states {
        prefix = "kizu.thread.each.state.invoke.";
    }
    var out = try string::from_bytes(self.allocator, prefix);
    errdefer out.deinit(self.allocator);
    try append_llvm_name_part(self.allocator, &var out, set);
    return self.names.intern_owned(move out);
}

/// Lists the worker error sets the module's pool rounds use with states, or
/// without when `states` is false, the Go `threadRoundInvokes`.
fn (self: &var Emitter) thread_round_sets(module: &ir::Module, states: bool) -> !array::Array<string::String> {
    var seen = map::new<[]u8, bool>(self.allocator);
    defer seen.deinit(self.allocator);
    var function_index = 0;
    while module.functions.get(function_index) |function| {
        function_index = function_index + 1;
        let function_node = module.function_nodes.at(function.node);
        var block_index = 0;
        while function_node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let node = module.instrs.at(instr.node);
                if node.op != ir::Op::Call {
                    continue;
                }
                if !hostabi::hands_worker(module, node.operand) {
                    continue;
                }
                var source = hostabi::Source::PoolInvoke;
                if states {
                    source = hostabi::Source::PoolStateInvoke;
                }
                let _ = try hostabi::source_arg(self.allocator, module, &node, source) orelse continue;
                let set = try self.thread_round_set(module, &node);
                defer set.deinit(self.allocator);
                let bytes = set.as_bytes();
                let name = try self.names.intern(bytes);
                let retained = ir::name_text(&self.names, name);
                let key = retained.as_bytes();
                try seen.insert(self.allocator, key, true);
            }
        }
    }
    return sorted_keys(self.allocator, &seen);
}

/// Emits the typed side of the pool's callback ABI, one adapter per worker
/// error set and state or none, the Go `writeThreadEachInvokeThunks`. A
/// worker takes its view as the {ptr, len} value and returns E's union; the
/// runtime hands the chunk behind a pointer, the state as the pointer
/// `&var S` already is, and is told the failure code -- zero for success --
/// and nothing else. Every view is the same pair whatever T is.
fn (self: &var Emitter) write_thread_each_invoke_thunks(module: &ir::Module) -> !void {
    try self.write_thread_invoke_thunks(module, false);
    try self.write_thread_invoke_thunks(module, true);
    return;
}

fn (self: &var Emitter) write_thread_invoke_thunks(module: &ir::Module, states: bool) -> !void {
    var sets = try self.thread_round_sets(module, states);
    defer sets.deinit(self.allocator);
    var state_arg = "";
    if states {
        state_arg = "ptr %kizu.state, ";
    }
    var index = 0;
    while sets.at(index) |set| {
        index = index + 1;
        let set_bytes = set.as_bytes();
        var union_text = try string::from_bytes(self.allocator, set_bytes);
        defer union_text.deinit(self.allocator);
        try union_text.append_bytes(self.allocator, "!void");
        let union_bytes = union_text.as_bytes();
        let union_type = try self.llvm_type(module, union_bytes);
        let thunk = try self.thread_invoke_thunk_name(set_bytes, states);
        let linkage = self.thunk_linkage();
        let comdat = try self.thunk_comdat(thunk);
        try self.line3(
            "define %si64 @%s(ptr %%kizu.worker, ptr %%kizu.state, ptr %%kizu.part, i64 %%kizu.index) #0%s {",
            Arg::Lit(linkage),
            Arg::Str(thunk),
            Arg::Lit(comdat)
        );
        try self.line("entry:");
        try self.line("  %kizu.part.value = load %kizu.slice.u8, ptr %kizu.part");
        try self.line2(
            "  %%kizu.result = call %s %%kizu.worker(%s%%kizu.slice.u8 %%kizu.part.value, i64 %%kizu.index)",
            Arg::Str(union_type),
            Arg::Lit(state_arg)
        );
        try self.line1("  %%kizu.code = extractvalue %s %%kizu.result, 0", Arg::Str(union_type));
        try self.line("  ret i64 %kizu.code");
        try self.line("}");
        try self.line("");
    }
    return;
}

/// Lowers one pool round by the C signature hostabi declares for it. The
/// runtime does not know T or S, so the call carries what the declaration
/// says -- the slice behind a pointer and what T measures, the states and
/// what S measures, the thunk that calls the worker -- and writes the
/// round's `E!void` into the leading slot. It is spelled apart from
/// write_hosted_runtime_call only in how it names its slots and copies the
/// view, the spelling the Go emitter gives the same round.
fn (self: &var Emitter) write_thread_pool_round(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let signature = try hostabi::declare(self.allocator, module, node.operand, node);
    defer signature.deinit(self.allocator);
    // Out and Zero are made from no operand; every other parameter needs
    // the one it names.
    var check = 0;
    while signature.params.get(check) |param| {
        check = check + 1;
        let operandless = param.source == hostabi::Source::Out or param.source == hostabi::Source::Zero;
        if param.arg >= node.args.len() or (param.arg < 0 and !operandless) {
            return try self.fail_name1(module, "llvm error: %s expects its operands", node.operand);
        }
    }
    let slot = try self.text1("%%kizu.thread.round.%d", Arg::Int(self.next_thread_each));
    self.next_thread_each = self.next_thread_each + 1;
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    try self.line2("  %s.result = alloca %s", Arg::Str(slot), Arg::Str(result_type));
    var args = array::new<string::String>(self.allocator);
    defer args.deinit(self.allocator);
    var index = 0;
    while signature.params.get(index) |param| {
        index = index + 1;
        match param.source {
            Out => try args.append(self.allocator, try self.sprint2("ptr %s.result", Arg::Str(slot), Arg::None)),
            Address => {
                let arg = node.args.get_or_panic(param.arg);
                let value = try self.operand(module, arg);
                let arg_type = try self.llvm_type_of(module, arg.type_name);
                try self.line2("  %s.data = alloca %s", Arg::Str(slot), Arg::Str(arg_type));
                try self.line3("  store %s %s, ptr %s.data", Arg::Str(arg_type), Arg::Str(value.operand), Arg::Str(slot));
                try args.append(self.allocator, try self.sprint2("ptr %s.data", Arg::Str(slot), Arg::None));
            },
            _ => {
                if try self.append_hosted_arg(module, node, param, &var args) |failed| {
                    return move failed;
                }
            },
        }
    }
    let symbol = try self.callee_symbol(module, node.operand);
    let joined = try string::join(self.allocator, &args, ", ");
    try self.line2("  call void @%s(%s)", Arg::Str(symbol), Arg::Owned(move joined));
    let result_name = try self.local_name(module, node.result.name);
    try self.line3("  %s = load %s, ptr %s.result", Arg::Str(result_name), Arg::Str(result_type), Arg::Str(slot));
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Spells the thunk hostabi's PoolInvoke or PoolStateInvoke names for a
/// round: one per error set its worker fails with, read from the round's
/// `E!void`.
fn (self: &var Emitter) pool_invoke_arg(
    module: &ir::Module,
    node: &ir::InstrNode,
    states: bool,
    args: &var array::Array<string::String>
) -> !?diagnostic::Diagnostic {
    let set = try self.thread_round_set(module, node);
    defer set.deinit(self.allocator);
    if set.len() == 0 {
        return try self.fail_name2(
            module, "llvm error: %s returns %s, not E!void", node.operand, node.result.type_name);
    }
    let set_bytes = set.as_bytes();
    let thunk = try self.thread_invoke_thunk_name(set_bytes, states);
    try args.append(self.allocator, try self.sprint2("ptr @%s", Arg::Str(thunk), Arg::None));
    return null;
}
