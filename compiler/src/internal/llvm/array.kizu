/// Lowers Array.set(index, value) and preserves !void failure flow, the Go
/// `writeArraySet`.
fn (self: &var Emitter) write_array_set(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.result.type_name, "std::array::Error!void") {
        return try self.fail0("llvm error: array.set expects Array<T>, i64, T -> std::array::Error!void");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit();
    if !try self.instr_element_type(module, node, &var elem) {
        return try self.fail0(
            "llvm error: emitter bug: instruction measures an element but was handed no container");
    }
    let elem_bytes = elem.as_bytes();
    let array = try self.operand(module, node.args.get_or_panic(0));
    let index = try self.operand(module, node.args.get_or_panic(1));
    let handle = try self.array_handle(array.operand);
    let result_name = try self.local_name(module, node.result.name);
    let ok_name = try self.suffixed(result_name, ".ok");
    try self.write_array_checked_store(module, node, handle, index.operand, ok_name, elem_bytes);
    return self.write_array_bool_result(module, node.result, ok_name, FailureKey::ArrayBounds);
}

/// Writes value at index when index is inside the array and leaves ok_name
/// saying whether it did, the Go `writeArrayCheckedStore`.
fn (self: &var Emitter) write_array_checked_store(
    module: &ir::Module,
    node: &ir::InstrNode,
    handle: ir::Name,
    index: ir::Name,
    ok_name: ir::Name,
    elem_bytes: []u8
) -> !void {
    let len_synthetic = try self.next_synthetic_value("array.set.len");
    let length = try self.percent(len_synthetic);
    try self.array_load_field(handle, array_field_len(), "array.set.len", length);
    let range_synthetic = try self.next_synthetic_value("array.set.in_range");
    let in_range = try self.percent(range_synthetic);
    try self.line3("  %s = icmp ult i64 %s, %s", Arg::Str(in_range), Arg::Str(index), Arg::Str(length));
    let store_label = try self.helper_label_local(ok_name, "array.set.store");
    let skip_label = try self.helper_label_local(ok_name, "array.set.skip");
    let join_label = try self.helper_label_local(ok_name, "array.set.join");
    try self.mark_current_block_exit(module, join_label);
    try self.line3("  br i1 %s, label %%%s, label %%%s", Arg::Str(in_range), Arg::Str(store_label), Arg::Str(skip_label));
    try self.line1("%s:", Arg::Str(store_label));
    let value = node.args.get_or_panic(2);
    let elem_addr = try self.array_element_addr_bytes(module, handle, elem_bytes, index);
    let value_type = try self.llvm_type_of(module, value.type_name);
    let value_operand = try self.operand(module, value);
    try self.line3("  store %s %s, ptr %s", Arg::Str(value_type), Arg::Str(value_operand.operand), Arg::Str(elem_addr));
    try self.line1("  br label %%%s", Arg::Str(join_label));
    try self.line1("%s:", Arg::Str(skip_label));
    try self.line1("  br label %%%s", Arg::Str(join_label));
    try self.line1("%s:", Arg::Str(join_label));
    return self.line3(
        "  %s = phi i1 [ true, %%%s ], [ false, %%%s ]",
        Arg::Str(ok_name), Arg::Str(store_label), Arg::Str(skip_label)
    );
}

