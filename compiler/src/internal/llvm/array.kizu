    try self.line2("  %s = call i64 @kizu_array_capacity(ptr %s)", Arg::Str(result_name), Arg::Str(array.operand));
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Lowers Array.reserve(additional), the Go `writeArrayReserve`.
fn (self: &var Emitter) write_array_reserve(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.result.type_name, "std::mem::Error!void") {
        return try self.fail0("llvm error: array.reserve expects Array<T>, i64 -> std::mem::Error!void");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let additional = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    let ok_name = try self.suffixed(result_name, ".ok");
    try self.line3(
        "  %s = call i1 @kizu_array_reserve(ptr %s, i64 %s)",
        Arg::Str(ok_name), Arg::Str(array.operand), Arg::Str(additional.operand)
    );
    return self.write_array_bool_result(module, node.result, ok_name, FailureKey::ArrayReserve);
}

/// Lowers Array.pop(), the Go `writeArrayPop`.
fn (self: &var Emitter) write_array_pop(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: array.pop expects Array<T> -> ?T");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".ptr");
    try self.line2("  %s = call ptr @kizu_array_pop(ptr %s)", Arg::Str(ptr_name), Arg::Str(array.operand));
    return self.write_array_optional_load_result(module, node, ptr_name);
}

/// Moves the last element out or traps on an empty Array, the Go
/// `writeArrayPopOrPanic`.
fn (self: &var Emitter) write_array_pop_or_panic(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: array.pop_or_panic expects Array<T> -> T");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".ptr");
    try self.line2("  %s = call ptr @kizu_array_pop(ptr %s)", Arg::Str(ptr_name), Arg::Str(array.operand));
    let none = self.no_names();
    defer none.deinit();
    try self.write_null_failure(module, node, ptr_name, "array.pop.panic", PanicKey::ArrayEmpty, &none);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    try self.line3("  %s = load %s, ptr %s", Arg::Str(result_name), Arg::Str(result_type), Arg::Str(ptr_name));
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Lowers Array.get(index), the Go `writeArrayGet`.
fn (self: &var Emitter) write_array_get(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.args.get_or_panic(1).type_name, "i64") {
        return try self.fail0("llvm error: array.get expects Array<T>, i64 -> ?T");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let index = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".ptr");
    try self.line3(
        "  %s = call ptr @kizu_array_get(ptr %s, i64 %s)",
        Arg::Str(ptr_name), Arg::Str(array.operand), Arg::Str(index.operand)
    );
    return self.write_array_optional_load_result(module, node, ptr_name);
}

/// Lowers Array.get_or_panic(index), the Go `writeArrayGetOrPanic`.
fn (self: &var Emitter) write_array_get_or_panic(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.args.get_or_panic(1).type_name, "i64") {
        return try self.fail0("llvm error: array.get_or_panic expects Array<T>, i64 -> T");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let index = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".ptr");
    let len_synthetic = try self.next_synthetic_value("array.get.panic.len");
    let len_name = try self.percent(len_synthetic);
    try self.line2("  %s = call i64 @kizu_array_len(ptr %s)", Arg::Str(len_name), Arg::Str(array.operand));
    try self.line3(
        "  %s = call ptr @kizu_array_get(ptr %s, i64 %s)",
        Arg::Str(ptr_name), Arg::Str(array.operand), Arg::Str(index.operand)
    );
    var args = self.no_names();
    defer args.deinit();
    try args.append(index.operand);
    try args.append(len_name);
    try self.write_null_failure(module, node, ptr_name, "array.get.panic", PanicKey::Bounds, &args);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    try self.line3("  %s = load %s, ptr %s", Arg::Str(result_name), Arg::Str(result_type), Arg::Str(ptr_name));
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Lowers Array.at(index) and Array.at_mut(index) to a borrow optional, the
/// Go `writeArrayAt`: the runtime's nullable element pointer becomes the
/// payload and its presence, branch-free.
fn (self: &var Emitter) write_array_at(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.args.get_or_panic(1).type_name, "i64") {
        return try self.fail0("llvm error: array.at expects Array<T>, i64 -> ?&T");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let index = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    let ptr_name = try self.suffixed(result_name, ".ptr");
    try self.line3(
        "  %s = call ptr @kizu_array_get(ptr %s, i64 %s)",
        Arg::Str(ptr_name), Arg::Str(array.operand), Arg::Str(index.operand)
    );
    return self.write_borrow_optional_result(module, node, ptr_name);
}

/// Lowers Array.set(index, value) and preserves !void failure flow, the Go
/// `writeArraySet`.
fn (self: &var Emitter) write_array_set(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.result.type_name, "std::array::Error!void") {
        return try self.fail0("llvm error: array.set expects Array<T>, i64, T -> std::array::Error!void");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let index = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    let elem_base = try self.suffixed(result_name, ".elem");
    let elem_slot = try self.write_stack_value(module, elem_base, node.args.get_or_panic(2));
    let ok_name = try self.suffixed(result_name, ".ok");
    try self.line4(
        "  %s = call i1 @kizu_array_set(ptr %s, i64 %s, ptr %s)",
        Arg::Str(ok_name), Arg::Str(array.operand), Arg::Str(index.operand), Arg::Str(elem_slot)
    );
    return self.write_array_bool_result(module, node.result, ok_name, FailureKey::ArrayBounds);
}

