/// Shortens the array by one and returns the address of the element that left
/// it, or null when there was none, the Go `arrayPopElement`. The length is
/// written either way -- an empty array is written the length it already
/// had -- so the path a pop takes is two loads, a compare and a store rather
/// than a call the optimizer cannot see the length change through.
fn (self: &var Emitter) array_pop_element(
    module: &ir::Module,
    node: &ir::InstrNode,
    into: ir::Name
) -> !?ir::Name {
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    if !try self.instr_element_type(module, node, &var elem) {
        return null;
    }
    let elem_bytes = elem.as_bytes();
    let array = try self.operand(module, node.args.get_or_panic(0));
    let handle = array.operand;
    let length_addr = try self.array_field_addr(handle, array_field_len(), "array.pop.len.addr");
    let length_synthetic = try self.next_synthetic_value("array.pop.len");
    let length = try self.percent(length_synthetic);
    let count_tag = self.tbaa_tag(TbaaKind::Count);
    try self.line3(
        "  %s = load i64, ptr %s%s", Arg::Str(length), Arg::Str(length_addr), Arg::Lit(count_tag));
    let held_synthetic = try self.next_synthetic_value("array.pop.held");
    let held = try self.percent(held_synthetic);
    try self.line2("  %s = icmp sgt i64 %s, 0", Arg::Str(held), Arg::Str(length));
    let shorter_synthetic = try self.next_synthetic_value("array.pop.shorter");
    let shorter = try self.percent(shorter_synthetic);
    try self.line2("  %s = sub i64 %s, 1", Arg::Str(shorter), Arg::Str(length));
    let kept_synthetic = try self.next_synthetic_value("array.pop.kept");
    let kept = try self.percent(kept_synthetic);
    try self.line4(
        "  %s = select i1 %s, i64 %s, i64 %s",
        Arg::Str(kept), Arg::Str(held), Arg::Str(shorter), Arg::Str(length)
    );
    let stored_tag = self.tbaa_tag(TbaaKind::Count);
    try self.line3(
        "  store i64 %s, ptr %s%s", Arg::Str(kept), Arg::Str(length_addr), Arg::Lit(stored_tag));
    let elem_addr = try self.array_element_addr_bytes(module, handle, elem_bytes, kept);
    try self.line3(
        "  %s = select i1 %s, ptr %s, ptr null",
        Arg::Str(into), Arg::Str(held), Arg::Str(elem_addr)
    );
    return into;
}

/// Moves the last element out or traps on an empty Array, the Go
/// `writeArrayPopOrPanic`.
fn (self: &var Emitter) write_array_pop_or_panic(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: array.pop_or_panic expects Array<T> -> T");
    }
