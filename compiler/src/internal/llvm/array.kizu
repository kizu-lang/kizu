import compiler::internal::diagnostic;
import compiler::internal::ir;
import std::mem;
import std::string;

// Mechanical port of internal/llvm/array.go: the hosted Array runtime
// declarations and the `array.*` instructions. The helpers other container
// files share (writeContainerNew, writeNullFailure, writeArrayBoolResult,
// writeArrayOptionalLoadResult, writeStackValue, writeStaticStringGlobal,
// arrayResultLabels, elementSizeOperand) live in llvm.kizu.

/// Reports whether a lowered IR type is a std::array::Array<T>, the Go
/// `isArrayLLVMType`.
fn is_array_llvm_type(typ_name: []u8) -> bool {
    return mem::starts_with(typ_name, "std::array::Array<") and ir::ends_with_bytes(typ_name, ">");
}

/// Copies T out of a `std::array::Array<T>` spelling, through a borrow of one,
/// and reports whether the spelling was one.
fn copy_array_element(names: &ir::NameTable, type_name: ir::Name, out: &var string::String) -> !bool {
    let retained = ir::name_text(names, type_name);
    let spelling = retained.as_bytes();
    var start = 0;
    if mem::starts_with(spelling, "&var ") {
        start = 5;
    } else {
        if mem::starts_with(spelling, "&") {
            start = 1;
        }
    }
    let base = spelling[start..mem::len(spelling)];
    if !is_array_llvm_type(base) {
        return false;
    }
    let elem = spelling[start + 18..mem::len(spelling) - 1];
    try out.append_bytes(elem);
    return true;
}

/// Copies the type an instruction measures into out, the Go
/// `instrElementType`. A container spells its element in its own type, so the
/// two can never disagree and no instruction can arrive without one -- a
/// cleanup carries no immediate, and a release measured against a missing type
/// would free the wrong number of bytes.
///
/// Which value carries it depends on the instruction: a constructor names the
/// container it returns, and everything else was handed the container it works
/// on. Reading whichever happens to match would take the wrong answer for an
/// element that is itself a container, where the result of a `pop` is an Array
/// whose own element is not what the outer storage is sized by.
fn (self: &var Emitter) instr_element_type(
    module: &ir::Module,
    node: &ir::InstrNode,
    out: &var string::String
) -> !bool {
    if container_constructor(node.op) {
        return self.container_element_of_result(module, node.result.type_name, out);
    }
    if node.args.len() == 0 {
        return false;
    }
    let first = node.args.get_or_panic(0);
    return copy_array_element(&module.names, first.type_name, out);
}

/// Reports the instructions whose container is the value they return rather
/// than the one they were handed.
fn container_constructor(op: ir::Op) -> bool {
    return match op {
        ArrayNew => true,
        MapNew => true,
        ArenaNew => true,
        BoxNew => true,
        _ => false,
    };
}

/// Copies what a constructor's result holds: the element for an Array, Arena
/// or Box, and the value for a Map, which is what its storage is sized by.
fn (self: &var Emitter) container_element_of_result(
    module: &ir::Module,
    type_name: ir::Name,
    out: &var string::String
) -> !bool {
    let retained = ir::name_text(&module.names, type_name);
    var spelling = retained.as_bytes();
    if try self.error_union_success_type(spelling) |success| {
        defer success.deinit();
        let bytes = success.as_bytes();
        return try self.copy_container_arg(bytes, out);
    }
    return self.copy_container_arg(spelling, out);
}

/// Copies the static argument a container spelling carries, taking a Map's
/// value rather than its key.
fn (self: &var Emitter) copy_container_arg(spelling: []u8, out: &var string::String) -> !bool {
    if is_array_llvm_type(spelling) {
        try out.append_bytes(spelling[18..mem::len(spelling) - 1]);
        return true;
    }
    if mem::starts_with(spelling, "std::arena::Arena<") and ir::ends_with_bytes(spelling, ">") {
        try out.append_bytes(spelling[18..mem::len(spelling) - 1]);
        return true;
    }
    if mem::starts_with(spelling, "std::mem::Box<") and ir::ends_with_bytes(spelling, ">") {
        try out.append_bytes(spelling[14..mem::len(spelling) - 1]);
        return true;
    }
    if mem::starts_with(spelling, "std::map::Map<") and ir::ends_with_bytes(spelling, ">") {
        let args = spelling[14..mem::len(spelling) - 1];
        let comma = top_level_comma(args, 0) orelse return false;
        try out.append_bytes(mem::trim_ascii(args[comma + 1..mem::len(args)]));
        return true;
    }
    return false;
}

/// Names the runtime's KizuArray header in emitted modules, the Go
/// `arrayHeaderType`. Element access reads these fields rather than calling the
/// runtime for each one: `kizu ir compiler` reaches an element 264 million
/// times in one run, and a call the optimizer cannot see through costs more
/// than the access. runtime.c asserts the same offsets, so the two spellings
/// cannot drift apart.
fn array_header_type() -> []u8 {
    return "%kizu.array";
}

/// The header read in place of a null handle, the Go `arrayEmptyGlobal`. The
/// runtime hands back null when the header itself could not be allocated, and
/// answered every read on it from its own null checks; an all-zero header
/// answers them the same way. It holds no capacity, so an append still goes
/// back to the runtime and comes back as the failure.
fn array_empty_global() -> []u8 {
    return "@kizu.array.empty";
}

/// The field index of the element storage.
fn array_field_data() -> i64 {
    return 0;
}

/// The field index of the element count.
fn array_field_len() -> i64 {
    return 1;
}

/// The field index of the reserved element count.
fn array_field_capacity() -> i64 {
    return 2;
}

/// The field index of the allocator the array grows with.
fn array_field_allocator() -> i64 {
    return 3;
}

/// What array_header_type occupies: four words, the Go `arrayHeaderSize`.
/// The element size is not among them -- the compiler knows T at every call
/// that needs it, so a header carrying sizeof(T) would carry what the caller
/// already has, in every array and in every element of an array of arrays.
pub fn array_header_size() -> i64 {
    return 32;
}

/// Writes declarations for the hosted Array runtime, the Go
/// `writeArrayRuntimeDecls`.
fn (self: &var Emitter) write_array_runtime_decls(module: &ir::Module) -> !void {
    if !self.uses_array_runtime(module) {
        return;
    }
    try self.line1("%s = type { ptr, i64, i64, ptr }", Arg::Lit(array_header_type()));
    try self.line2(
        "%s = private unnamed_addr global %s zeroinitializer",
        Arg::Lit(array_empty_global()), Arg::Lit(array_header_type())
    );
    try self.line("declare i1 @kizu_array_append(ptr, ptr, i64)");
    try self.line("declare i1 @kizu_array_append_bytes(ptr, ptr, i64)");
    try self.line("declare i1 @kizu_array_reserve(ptr, i64, i64)");
    try self.line("declare ptr @kizu_array_pop(ptr, i64)");
    try self.line("declare i1 @kizu_array_swap(ptr, i64, i64, i64)");
    try self.line("declare i1 @kizu_array_truncate(ptr, i64)");
    try self.line("declare void @kizu_array_clear(ptr)");
    try self.line("declare %kizu.slice.u8 @kizu_array_as_bytes(ptr)");
    try self.line("declare void @kizu_array_deinit(ptr, ptr, i64)");
    return self.line("");
}

/// Returns an operand that always points at a readable header, the Go
/// `arrayHandle`.
fn (self: &var Emitter) array_handle(operand: ir::Name) -> !ir::Name {
    let null_synthetic = try self.next_synthetic_value("array.handle.null");
    let null_name = try self.percent(null_synthetic);
    let handle_synthetic = try self.next_synthetic_value("array.handle");
    let handle_name = try self.percent(handle_synthetic);
    try self.line2("  %s = icmp eq ptr %s, null", Arg::Str(null_name), Arg::Str(operand));
    try self.line4(
        "  %s = select i1 %s, ptr %s, ptr %s",
        Arg::Str(handle_name), Arg::Str(null_name), Arg::Lit(array_empty_global()), Arg::Str(operand)
    );
    return handle_name;
}

/// Returns the address of one header field, the Go `arrayFieldAddr`.
fn (self: &var Emitter) array_field_addr(handle: ir::Name, field: i64, name: []u8) -> !ir::Name {
    let synthetic = try self.next_synthetic_value(name);
    let addr = try self.percent(synthetic);
    try self.line4(
        "  %s = getelementptr %s, ptr %s, i64 0, i32 %d",
        Arg::Str(addr), Arg::Lit(array_header_type()), Arg::Str(handle), Arg::Int(field)
    );
    return addr;
}

/// Loads one i64 header field into the named register, the Go
/// `arrayLoadField`.
fn (self: &var Emitter) array_load_field(handle: ir::Name, field: i64, name: []u8, into: ir::Name) -> !void {
    var addr_name = try string::from_bytes(self.allocator, name);
    defer addr_name.deinit();
    try addr_name.append_bytes(".addr");
    let addr_bytes = addr_name.as_bytes();
    let addr = try self.array_field_addr(handle, field, addr_bytes);
    return self.line2("  %s = load i64, ptr %s", Arg::Str(into), Arg::Str(addr));
}

/// Returns the address of the element at index, the Go `arrayElementAddr`. The
/// stride is the element type, which is what array.new sized the elements by,
/// and the index is not checked here.
/// The same for an element spelled out rather than named by the module, for
/// the instructions that read their element from the value they were handed.
fn (self: &var Emitter) array_element_addr_bytes(
    module: &ir::Module,
    handle: ir::Name,
    elem: []u8,
    index: ir::Name
) -> !ir::Name {
    let elem_type = try self.llvm_type(module, elem);
    return self.array_element_addr_of(handle, elem_type, index);
}

fn (self: &var Emitter) array_element_addr(
    module: &ir::Module,
    handle: ir::Name,
    elem: ir::Name,
    index: ir::Name
) -> !ir::Name {
    let elem_type = try self.llvm_type_of(module, elem);
    return self.array_element_addr_of(handle, elem_type, index);
}

/// Writes the address of one element slot, given the lowered element type.
fn (self: &var Emitter) array_element_addr_of(
    handle: ir::Name,
    elem_type: ir::Name,
    index: ir::Name
) -> !ir::Name {
    let data_addr = try self.array_field_addr(handle, array_field_data(), "array.data.addr");
    let data_synthetic = try self.next_synthetic_value("array.data");
    let data = try self.percent(data_synthetic);
    let elem_synthetic = try self.next_synthetic_value("array.elem");
    let elem_addr = try self.percent(elem_synthetic);
    try self.line2("  %s = load ptr, ptr %s", Arg::Str(data), Arg::Str(data_addr));
    try self.line4(
        "  %s = getelementptr %s, ptr %s, i64 %s",
        Arg::Str(elem_addr), Arg::Str(elem_type), Arg::Str(data), Arg::Str(index)
    );
    return elem_addr;
}

/// Returns the address of the element at index, or null when index is outside
/// the array, the Go `arrayCheckedElement`. The comparison is unsigned, so a
/// negative index is out of range without a second test -- the same answer the
/// runtime gave by returning a null element pointer.
fn (self: &var Emitter) array_checked_element(
    module: &ir::Module,
    node: &ir::InstrNode,
    handle: ir::Name,
    index: ir::Name,
    elem_bytes: []u8
) -> !ir::Name {
    let len_synthetic = try self.next_synthetic_value("array.len");
    let length = try self.percent(len_synthetic);
    try self.array_load_field(handle, array_field_len(), "array.len", length);
    let range_synthetic = try self.next_synthetic_value("array.in_range");
    let in_range = try self.percent(range_synthetic);
    try self.line3("  %s = icmp ult i64 %s, %s", Arg::Str(in_range), Arg::Str(index), Arg::Str(length));
    let elem_addr = try self.array_element_addr_bytes(module, handle, elem_bytes, index);
    let checked_synthetic = try self.next_synthetic_value("array.checked");
    let checked = try self.percent(checked_synthetic);
    try self.line3(
        "  %s = select i1 %s, ptr %s, ptr null",
        Arg::Str(checked), Arg::Str(in_range), Arg::Str(elem_addr)
    );
    return checked;
}

/// Traps when index is outside the array, the Go `writeBoundsFailure`. The
/// comparison is unsigned, so a negative index is out of range without a
/// second test.
fn (self: &var Emitter) write_bounds_failure(
    module: &ir::Module,
    node: &ir::InstrNode,
    index: ir::Name,
    length: ir::Name
) -> !void {
    let range_synthetic = try self.next_synthetic_value("array.get.panic.in_range");
    let in_range = try self.percent(range_synthetic);
    let fail_label = try self.helper_label_local(in_range, "array.get.panic.bounds");
    let ok_label = try self.helper_label_local(in_range, "ok");
    try self.mark_current_block_exit(module, ok_label);
    try self.line3("  %s = icmp ult i64 %s, %s", Arg::Str(in_range), Arg::Str(index), Arg::Str(length));
    try self.line3("  br i1 %s, label %%%s, label %%%s", Arg::Str(in_range), Arg::Str(ok_label), Arg::Str(fail_label));
    try self.line1("%s:", Arg::Str(fail_label));
    var args = self.no_names();
    defer args.deinit();
    try args.append(index);
    try args.append(length);
    try self.write_panic_call(node, PanicKey::Bounds, &args);
    return self.line1("%s:", Arg::Str(ok_label));
}

/// Reports whether this module uses std::array::Array lowering, the Go
/// `usesArrayRuntime`.
fn (self: &Emitter) uses_array_runtime(module: &ir::Module) -> bool {
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let node = module.function_nodes.at(function.node);
        var block_index = 0;
        while node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let instr_node = module.instrs.at(instr.node);
                if mem::starts_with(ir::op_spelling(instr_node.op), "array.") {
                    return true;
                }
            }
        }
    }
    return false;
}

/// Dispatches the Array operations that act on the container as a whole --
/// lifetime, size, and bulk views -- the Go `writeArrayInstr`. Anything that
/// reaches into a single element falls through to write_array_element_instr,
/// which also owns the error for instructions neither half recognises.
fn (self: &var Emitter) write_array_instr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    match node.op {
        ArrayNew => return self.write_array_new(module, node),
        ArrayLen => return self.write_array_len(module, node),
        ArrayCapacity => return self.write_array_capacity(module, node),
        ArrayAppendBytes => return self.write_array_append_bytes(module, node),
        ArrayReserve => return self.write_array_reserve(module, node),
        ArrayTruncate => return self.write_array_truncate(module, node),
        ArrayClear => return self.write_array_clear(module, node),
        ArrayAsBytes => return self.write_array_as_bytes(module, node),
        ArrayDeinit => return self.write_array_deinit(module, node),
        _ => return self.write_array_element_instr(module, node),
    }
}

/// Dispatches the Array operations that move or borrow a single element, the
/// Go `writeArrayElementInstr`. All of them go through a pointer to one
/// element slot -- read out of the header here for the ones that only need an
/// address, handed back by the runtime for pop -- so they share the failure
/// plumbing.
fn (self: &var Emitter) write_array_element_instr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    match node.op {
        ArrayAppend => return self.write_array_append(module, node),
        ArrayPop => return self.write_array_pop(module, node),
        ArrayPopOrPanic => return self.write_array_pop_or_panic(module, node),
        ArrayGet => return self.write_array_get(module, node),
        ArrayGetOrPanic => return self.write_array_get_or_panic(module, node),
        ArrayAt => return self.write_array_at(module, node),
        ArrayAtMut => return self.write_array_at(module, node),
        ArraySet => return self.write_array_set(module, node),
        ArraySwap => return self.write_array_swap(module, node),
        _ => {
            let op = try self.op_name(module, node);
            return try self.fail1("llvm error: unsupported array instruction `%s`", Arg::Str(op));
        },
    }
}

/// Exchanges two initialized slots without copying ownership, the Go
/// `writeArraySwap`.
fn (self: &var Emitter) write_array_swap(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 3 or !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.args.get_or_panic(2).type_name, "i64") or !module.names.is(node.result.type_name, "std::array::Error!void") {
        return try self.fail0("llvm error: array.swap expects Array<T>, i64, i64 -> std::array::Error!void");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit();
    if !try self.instr_element_type(module, node, &var elem) {
        return try self.fail0(
            "llvm error: emitter bug: instruction measures an element but was handed no container");
    }
    let elem_bytes = elem.as_bytes();
    let array = try self.operand(module, node.args.get_or_panic(0));
    let left = try self.operand(module, node.args.get_or_panic(1));
    let right = try self.operand(module, node.args.get_or_panic(2));
    let result_name = try self.local_name(module, node.result.name);
    let ok_name = try self.suffixed(result_name, ".ok");
    let size = try self.element_size_operand_bytes(module, elem_bytes);
    try self.line5(
        "  %s = call i1 @kizu_array_swap(ptr %s, i64 %s, i64 %s, i64 %s)",
        Arg::Str(ok_name), Arg::Str(array.operand), Arg::Str(left.operand),
        Arg::Str(right.operand), Arg::Str(size)
    );
    return self.write_array_bool_result(module, node.result, ok_name, FailureKey::ArraySwap);
}

/// Lowers std::array::new<T>(allocator) to the header value an empty array
/// is, the Go `writeArrayNew`. An empty array owns no storage, so it needs
/// none: the three fields that describe the elements are zero and the two
/// that describe how to grow are the element size and the allocator the call
/// names.
fn (self: &var Emitter) write_array_new(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    if node.args.len() != 1 or !is_array_llvm_type(result_type) {
        return try self.fail0("llvm error: array.new expects allocator -> Array<T>");
    }
    let allocator = try self.operand(module, node.args.get_or_panic(0));
    let result_name = try self.local_name(module, node.result.name);
    try self.line4(
        "  %s = insertvalue %s zeroinitializer, ptr %s, %s",
        Arg::Str(result_name), Arg::Lit(array_header_type()),
        Arg::Str(allocator.operand), Arg::Int(array_field_allocator())
    );
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Lowers Array.append(value) and preserves !void failure flow, the Go
/// `writeArrayAppend`.
fn (self: &var Emitter) write_array_append(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.result.type_name, "std::mem::Error!void") {
        return try self.fail0("llvm error: array.append expects Array<T>, T -> std::mem::Error!void");
    }
    var elem = string::new(self.allocator);
    defer elem.deinit();
    if !try self.instr_element_type(module, node, &var elem) {
        return try self.fail0(
            "llvm error: emitter bug: instruction measures an element but was handed no container");
    }
    let elem_bytes = elem.as_bytes();
    let array = try self.operand(module, node.args.get_or_panic(0));
    let handle = try self.array_handle(array.operand);
    let result_name = try self.local_name(module, node.result.name);
    let ok_name = try self.suffixed(result_name, ".ok");
    try self.write_array_append_paths(module, node, array.operand, handle, ok_name, elem_bytes);
    return self.write_array_bool_result(module, node.result, ok_name, FailureKey::ArrayAppend);
}

/// Writes into the reserved tail when there is one and otherwise hands the
/// append back to the runtime, the Go `writeArrayAppendPaths`. Growing the
/// storage is what the runtime owns. The slow path is given the handle as it
/// came, not the readable stand-in, so a null handle still comes back as the
/// failure it is.
fn (self: &var Emitter) write_array_append_paths(
    module: &ir::Module,
    node: &ir::InstrNode,
    handle_operand: ir::Name,
    handle: ir::Name,
    ok_name: ir::Name,
    elem_bytes: []u8
) -> !void {
    let len_synthetic = try self.next_synthetic_value("array.append.len");
    let length = try self.percent(len_synthetic);
    let cap_synthetic = try self.next_synthetic_value("array.append.cap");
    let capacity = try self.percent(cap_synthetic);
    let length_addr = try self.array_field_addr(handle, array_field_len(), "array.append.len.addr");
    try self.line2("  %s = load i64, ptr %s", Arg::Str(length), Arg::Str(length_addr));
    try self.array_load_field(handle, array_field_capacity(), "array.append.cap", capacity);
    let fits_synthetic = try self.next_synthetic_value("array.append.fits");
    let fits = try self.percent(fits_synthetic);
    try self.line3("  %s = icmp slt i64 %s, %s", Arg::Str(fits), Arg::Str(length), Arg::Str(capacity));
    let fast_label = try self.helper_label_local(ok_name, "array.append.fast");
    let slow_label = try self.helper_label_local(ok_name, "array.append.slow");
    let join_label = try self.helper_label_local(ok_name, "array.append.join");
    try self.mark_current_block_exit(module, join_label);
    try self.line3("  br i1 %s, label %%%s, label %%%s", Arg::Str(fits), Arg::Str(fast_label), Arg::Str(slow_label));
    try self.line1("%s:", Arg::Str(fast_label));
    try self.write_array_append_fast(module, node, handle, length, length_addr, elem_bytes);
    try self.line1("  br label %%%s", Arg::Str(join_label));
    try self.line1("%s:", Arg::Str(slow_label));
    let slow_ok = try self.write_array_append_slow(module, node, handle_operand, elem_bytes);
    try self.line1("  br label %%%s", Arg::Str(join_label));
    try self.line1("%s:", Arg::Str(join_label));
    return self.line4(
        "  %s = phi i1 [ true, %%%s ], [ %s, %%%s ]",
        Arg::Str(ok_name), Arg::Str(fast_label), Arg::Str(slow_ok), Arg::Str(slow_label)
    );
}

/// Writes the value into the reserved tail and counts it, the fast half of the
/// Go `writeArrayAppendPaths`.
fn (self: &var Emitter) write_array_append_fast(
    module: &ir::Module,
    node: &ir::InstrNode,
    handle: ir::Name,
    length: ir::Name,
    length_addr: ir::Name,
    elem_bytes: []u8
) -> !void {
    let value = node.args.get_or_panic(1);
    let elem_addr = try self.array_element_addr_bytes(module, handle, elem_bytes, length);
    let value_type = try self.llvm_type_of(module, value.type_name);
    let value_operand = try self.operand(module, value);
    try self.line3("  store %s %s, ptr %s", Arg::Str(value_type), Arg::Str(value_operand.operand), Arg::Str(elem_addr));
    let grown_synthetic = try self.next_synthetic_value("array.append.grown");
    let grown = try self.percent(grown_synthetic);
    try self.line2("  %s = add i64 %s, 1", Arg::Str(grown), Arg::Str(length));
    return self.line2("  store i64 %s, ptr %s", Arg::Str(grown), Arg::Str(length_addr));
}

/// Hands the append back to the runtime and returns the register holding what
/// it answered, the slow half of the Go `writeArrayAppendPaths`.
fn (self: &var Emitter) write_array_append_slow(
    module: &ir::Module,
    node: &ir::InstrNode,
    handle_operand: ir::Name,
    elem_bytes: []u8
) -> !ir::Name {
    let result_name = try self.local_name(module, node.result.name);
    let elem_base = try self.suffixed(result_name, ".elem");
    let elem_slot = try self.write_stack_value(module, elem_base, node.args.get_or_panic(1));
    let slow_synthetic = try self.next_synthetic_value("array.append.slow.ok");
    let slow_ok = try self.percent(slow_synthetic);
    let size = try self.element_size_operand_bytes(module, elem_bytes);
    try self.line4(
        "  %s = call i1 @kizu_array_append(ptr %s, ptr %s, i64 %s)",
        Arg::Str(slow_ok), Arg::Str(handle_operand), Arg::Str(elem_slot), Arg::Str(size)
    );
    return slow_ok;
}

