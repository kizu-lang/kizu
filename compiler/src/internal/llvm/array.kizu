/// Lowers Array.append_bytes(bytes) for a u8 array, the Go
/// `writeArrayAppendBytes`: the run is copied in one runtime call rather than
/// one element at a time.
fn (self: &var Emitter) write_array_append_bytes(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.args.get_or_panic(1).type_name, "[]u8") or
        !module.names.is(node.result.type_name, "std::mem::Error!void") {
        return try self.fail0("llvm error: array.append_bytes expects Array<u8>, []u8 -> std::mem::Error!void");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let slice = try self.operand(module, node.args.get_or_panic(1));
    let synthetic = try self.next_synthetic_value("array.append_bytes");
    let base = try self.percent(synthetic);
    let ptr_name = try self.suffixed(base, ".ptr");
    let len_name = try self.suffixed(base, ".len");
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 0", Arg::Str(ptr_name), Arg::Str(slice.operand));
    try self.line2("  %s = extractvalue %%kizu.slice.u8 %s, 1", Arg::Str(len_name), Arg::Str(slice.operand));
    let result_name = try self.local_name(module, node.result.name);
    let ok_name = try self.suffixed(result_name, ".ok");
    try self.line4(
        "  %s = call i1 @kizu_array_append_bytes(ptr %s, ptr %s, i64 %s)",
        Arg::Str(ok_name), Arg::Str(array.operand), Arg::Str(ptr_name), Arg::Str(len_name)
    );
    return self.write_array_bool_result(module, node.result, ok_name, FailureKey::ArrayAppendBytes);
}

