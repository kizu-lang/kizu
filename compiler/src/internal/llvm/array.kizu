fn (self: &var Emitter) write_array_deinit(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.result.type_name, "void") {
        return try self.fail0("llvm error: array.deinit expects Array<T> -> void");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    try self.line1("  call void @kizu_array_deinit(ptr %s)", Arg::Str(array.operand));
    try self.set_void_value(module, node.result);
    return null;
}
