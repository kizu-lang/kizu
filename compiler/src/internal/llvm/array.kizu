    let elem_addr = try self.array_element_at(data, elem_type, index);
    let value_type = try self.llvm_type_of(module, value.type_name);
    let value_operand = try self.operand(module, value);
    let tag = self.value_tag(value_type);
    try self.line4(
        "  store %s %s, ptr %s%s", Arg::Str(value_type), Arg::Str(value_operand.operand), Arg::Str(elem_addr), Arg::Lit(tag)
    );
    try self.line1("  br label %%%s", Arg::Str(join_label));
    try self.line1("%s:", Arg::Str(skip_label));
    try self.line1("  br label %%%s", Arg::Str(join_label));
    try self.line1("%s:", Arg::Str(join_label));
    return self.line3(
        "  %s = phi i1 [ true, %%%s ], [ false, %%%s ]",
        Arg::Str(ok_name), Arg::Str(store_label), Arg::Str(skip_label)
    );
}

/// Lowers the raw Array storage truncate primitive, the Go `writeArrayTruncate`.
fn (self: &var Emitter) write_array_truncate(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.args.get_or_panic(1).type_name, "i64") or
        !module.names.is(node.result.type_name, "std::array::Error!void") {
        return try self.fail0("llvm error: array.truncate expects Array<T>, i64 -> std::array::Error!void");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let length = try self.operand(module, node.args.get_or_panic(1));
    let result_name = try self.local_name(module, node.result.name);
    let ok_name = try self.suffixed(result_name, ".ok");
    let handle = array.operand;
    let length_addr = try self.array_field_addr(handle, array_field_len(), "array.truncate.len.addr");
    let held_synthetic = try self.next_synthetic_value("array.truncate.held");
    let held = try self.percent(held_synthetic);
    let count_tag = self.tbaa_tag(TbaaKind::Count);
    try self.line3(
        "  %s = load i64, ptr %s%s", Arg::Str(held), Arg::Str(length_addr), Arg::Lit(count_tag));
    // An unsigned compare answers both halves of "between zero and the length"
    // with one test, the way a checked element access answers its index.
    try self.line3(
        "  %s = icmp ule i64 %s, %s", Arg::Str(ok_name), Arg::Str(length.operand), Arg::Str(held));
    let kept_synthetic = try self.next_synthetic_value("array.truncate.kept");
    let kept = try self.percent(kept_synthetic);
    try self.line4(
        "  %s = select i1 %s, i64 %s, i64 %s",
        Arg::Str(kept), Arg::Str(ok_name), Arg::Str(length.operand), Arg::Str(held)
    );
    let stored_tag = self.tbaa_tag(TbaaKind::Count);
    try self.line3(
        "  store i64 %s, ptr %s%s", Arg::Str(kept), Arg::Str(length_addr), Arg::Lit(stored_tag));
    return self.write_array_bool_result(module, node.result, ok_name, FailureKey::ArrayTruncate);
}

/// Lowers the raw Array storage clear primitive, the Go `writeArrayClear`.
fn (self: &var Emitter) write_array_clear(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.result.type_name, "void") {
        return try self.fail0("llvm error: array.clear expects Array<T> -> void");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let length_addr = try self.array_field_addr(array.operand, array_field_len(), "array.clear.len.addr");
    let count_tag = self.tbaa_tag(TbaaKind::Count);
    try self.line2("  store i64 0, ptr %s%s", Arg::Str(length_addr), Arg::Lit(count_tag));
    try self.set_void_value(module, node.result);
    return null;
}

/// Lowers Array<u8>.as_bytes(), the Go `writeArrayAsBytes`.
fn (self: &var Emitter) write_array_as_bytes(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 or !module.names.is(node.result.type_name, "[]u8") {
        return try self.fail0("llvm error: array.as_bytes expects Array<u8> -> []u8");
    }
    let array = try self.operand(module, node.args.get_or_panic(0));
    let result_name = try self.local_name(module, node.result.name);
    let data = try self.array_data(array.operand);
    let length_synthetic = try self.next_synthetic_value("array.as_bytes.len");
    let length = try self.percent(length_synthetic);
    try self.array_load_field(array.operand, array_field_len(), "array.as_bytes.len.addr", length);
    let ptr_synthetic = try self.next_synthetic_value("array.as_bytes.ptr");
    let with_ptr = try self.percent(ptr_synthetic);
    try self.line2(
        "  %s = insertvalue %%kizu.slice.u8 undef, ptr %s, 0", Arg::Str(with_ptr), Arg::Str(data));
    try self.line3(
        "  %s = insertvalue %%kizu.slice.u8 %s, i64 %s, 1",
        Arg::Str(result_name), Arg::Str(with_ptr), Arg::Str(length)
    );
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Lowers Array.deinit(), the Go `writeArrayDeinit`.
fn (self: &var Emitter) write_array_deinit(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 2 or !module.names.is(node.result.type_name, "void") {
        return try self.fail0("llvm error: array.deinit expects Array<T>, Allocator -> void");
    }
    return self.write_container_storage_release(module, node, "array.deinit");
}

/// Releases the storage a container header owns: the data pointer, measured by
/// the capacity it was sized at, the Go `writeContainerStorageRelease`.
/// Array.deinit and Arena.deinit are both this, since the two are the same
/// header and whatever owners the elements held are already gone by the time
/// either runs.
///
/// A container that never grew owns no bytes, and releasing it asks nothing of
/// the allocator, so that test is written here rather than behind the call: a
/// scratch array a function declares and deinits on every call, and mostly
/// leaves empty, otherwise pays a call into the runtime for each.
fn (self: &var Emitter) write_container_storage_release(
    module: &ir::Module,
    node: &ir::InstrNode,
    what: []u8
) -> !?diagnostic::Diagnostic {
    let container = try self.operand(module, node.args.get_or_panic(0));
    // A cleanup carries no immediate, so the element the release measures is
    // read from the container it was handed: the one place the type is written
    // down either way.
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    if !try self.instr_element_type(module, node, &var elem) {
        return try self.fail0(
            "llvm error: emitter bug: a release measures an element but was handed no container");
    }
    let elem_bytes = elem.as_bytes();
    var data_name = try string::from_bytes(self.allocator, what);
    defer data_name.deinit(self.allocator);
    try data_name.append_bytes(self.allocator, ".data");
    let data_bytes = data_name.as_bytes();
    var cap_name = try string::from_bytes(self.allocator, what);
    defer cap_name.deinit(self.allocator);
    try cap_name.append_bytes(self.allocator, ".cap");
    let cap_bytes = cap_name.as_bytes();
    var bytes_name = try string::from_bytes(self.allocator, what);
    defer bytes_name.deinit(self.allocator);
    try bytes_name.append_bytes(self.allocator, ".bytes");
    let bytes_label = bytes_name.as_bytes();
    // An arena's header leads with the array's three fields but is not the
    // same type, so the extract names whichever one it was handed.
    var header = array_header_type();
    let container_type = ir::name_text(&module.names, node.args.get_or_panic(0).type_name);
    let container_bytes = container_type.as_bytes();
    if is_arena_llvm_type(container_bytes) {
        header = arena_header_type();
    }
    let data = try self.array_field_of(header, container.operand, array_field_data(), data_bytes);
    let capacity = try self.array_field_of(header, container.operand, array_field_capacity(), cap_bytes);
    let allocator = try self.operand(module, node.args.get_or_panic(1));
    let elem_size = try self.element_size_operand_bytes(module, elem_bytes);
    let bytes_synthetic = try self.next_synthetic_value(bytes_label);
    let bytes = try self.percent(bytes_synthetic);
    try self.line3(
        "  %s = mul i64 %s, %s",
        Arg::Str(bytes), Arg::Str(capacity), Arg::Str(elem_size)
    );
    var owns_name = try string::from_bytes(self.allocator, what);
    defer owns_name.deinit(self.allocator);
    try owns_name.append_bytes(self.allocator, ".owns");
    let owns_label = owns_name.as_bytes();
    let owns_synthetic = try self.next_synthetic_value(owns_label);
    let owns = try self.percent(owns_synthetic);
    let release_label = try self.helper_label_local(owns, "release");
    let done_label = try self.helper_label_local(owns, "done");
    try self.mark_current_block_exit(module, done_label);
    try self.line2("  %s = icmp ne i64 %s, 0", Arg::Str(owns), Arg::Str(bytes));
    try self.line3(
        "  br i1 %s, label %%%s, label %%%s",
        Arg::Str(owns), Arg::Str(release_label), Arg::Str(done_label)
    );
    try self.line1("%s:", Arg::Str(release_label));
    try self.line3(
        "  call void @kizu_array_deinit(ptr %s, ptr %s, i64 %s)",
        Arg::Str(allocator.operand), Arg::Str(data), Arg::Str(bytes)
    );
    try self.line1("  br label %%%s", Arg::Str(done_label));
    try self.line1("%s:", Arg::Str(done_label));
    try self.set_void_value(module, node.result);
    return null;
}

/// Reads one field out of a container header value, the Go `arrayFieldOf`.
fn (self: &var Emitter) array_field_of(header: []u8, value: ir::Name, field: i64, name: []u8) -> !ir::Name {
    let synthetic = try self.next_synthetic_value(name);
    let out = try self.percent(synthetic);
    try self.line4(
        "  %s = extractvalue %s %s, %s",
        Arg::Str(out), Arg::Lit(header), Arg::Str(value), Arg::Int(field)
    );
    return out;
}
