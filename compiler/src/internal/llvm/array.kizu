    let into = try self.suffixed(result_name, ".ptr");
    let ptr_name = try self.array_pop_element(module, node, into) orelse
        return try self.fail0(
        "llvm error: emitter bug: instruction measures an element but was handed no container");
    return self.write_array_optional_load_result(module, node, ptr_name);
}

fn (self: &var Emitter) array_pop_element(
    module: &ir::Module,
    node: &ir::InstrNode,
    into: ir::Name
) -> !?ir::Name {
    var elem = string::new(self.allocator);
    defer elem.deinit(self.allocator);
    if !try self.instr_element_type(module, node, &var elem) {
        return null;
    }
    let elem_bytes = elem.as_bytes();
    let array = try self.operand(module, node.args.get_or_panic(0));
    let handle = array.operand;
    let length_addr = try self.array_field_addr(handle, array_field_len(), "array.pop.len.addr");
    let length_synthetic = try self.next_synthetic_value("array.pop.len");
    let length = try self.percent(length_synthetic);
    let count_tag = self.tbaa_tag(TbaaKind::Count);
    try self.line3(
        "  %s = load i64, ptr %s%s", Arg::Str(length), Arg::Str(length_addr), Arg::Lit(count_tag));
    let held_synthetic = try self.next_synthetic_value("array.pop.held");
    let held = try self.percent(held_synthetic);
    try self.line2("  %s = icmp sgt i64 %s, 0", Arg::Str(held), Arg::Str(length));
    let pop_label = try self.helper_label_local(into, "array.pop.take");
    let empty_label = try self.helper_label_local(into, "array.pop.empty");
    let join_label = try self.helper_label_local(into, "array.pop.join");
    try self.mark_current_block_exit(module, join_label);
    try self.line3(
        "  br i1 %s, label %%%s, label %%%s", Arg::Str(held), Arg::Str(pop_label), Arg::Str(empty_label));
    try self.line1("%s:", Arg::Str(pop_label));
    let shorter_synthetic = try self.next_synthetic_value("array.pop.shorter");
    let shorter = try self.percent(shorter_synthetic);
    try self.line2("  %s = sub i64 %s, 1", Arg::Str(shorter), Arg::Str(length));
    let stored_tag = self.tbaa_tag(TbaaKind::Count);
    try self.line3(
        "  store i64 %s, ptr %s%s", Arg::Str(shorter), Arg::Str(length_addr), Arg::Lit(stored_tag));
    let elem_addr = try self.array_element_addr_bytes(module, handle, elem_bytes, shorter);
    try self.line1("  br label %%%s", Arg::Str(join_label));
    try self.line1("%s:", Arg::Str(empty_label));
    try self.line1("  br label %%%s", Arg::Str(join_label));
    try self.line1("%s:", Arg::Str(join_label));
    try self.line4(
        "  %s = phi ptr [ %s, %%%s ], [ null, %%%s ]",
        Arg::Str(into), Arg::Str(elem_addr), Arg::Str(pop_label), Arg::Str(empty_label)
    );
    return into;
}

fn (self: &var Emitter) write_array_pop_or_panic(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if node.args.len() != 1 {
        return try self.fail0("llvm error: array.pop_or_panic expects Array<T> -> T");
    }
    let result_name = try self.local_name(module, node.result.name);
    let into = try self.suffixed(result_name, ".ptr");
    let ptr_name = try self.array_pop_element(module, node, into) orelse
        return try self.fail0(
        "llvm error: emitter bug: instruction measures an element but was handed no container");
    let none = self.no_names();
    defer none.deinit(self.allocator);
    try self.write_null_failure(module, node, ptr_name, "array.pop.panic", PanicKey::ArrayEmpty, &none);
    if try self.copied_into_memory(module, node.result, ptr_name) {
        return null;
    }
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    let tag = self.value_tag(result_type);
    try self.write_value_load(result_name, "", result_type, ptr_name, 0, tag);
    try self.set_value(module, node.result, result_name);
    return null;
}

