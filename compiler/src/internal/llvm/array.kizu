        "  call void @llvm.memcpy.p0.p0.i64(ptr %s, ptr %s, i64 %s, i1 false)",
        Arg::Str(tail_addr), Arg::Str(ptr_name), Arg::Str(len_name)
    );
    try self.line3("  store i64 %s, ptr %s%s", Arg::Str(needed), Arg::Str(length_addr), Arg::Lit(length_tag));
    try self.line1("  br label %%%s", Arg::Str(join_label));
