    let length_tag = self.tbaa_tag(TbaaKind::Count);
    try self.line3("  %s = load i64, ptr %s%s", Arg::Str(length), Arg::Str(length_addr), Arg::Lit(length_tag));
    try self.array_load_field(handle, array_field_capacity(), "array.append_bytes.cap", capacity);
    let needed_synthetic = try self.next_synthetic_value("array.append_bytes.needed");
    let needed = try self.percent(needed_synthetic);
    try self.line3("  %s = add i64 %s, %s", Arg::Str(needed), Arg::Str(length), Arg::Str(len_name));
    let fits_synthetic = try self.next_synthetic_value("array.append_bytes.fits");
