import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::array;
import std::float;
import std::fmt;
import std::map;
import std::mem;
import std::string;

pub fn emit(allocator: Allocator, module: &var ir::Module, out: &var string::String) -> !?diagnostic::Diagnostic {
    return emit_for_native_target(allocator, module, out, false, Arch::Arm64, "");
}

fn emit_for_native_target(
    allocator: Allocator,
    module: &var ir::Module,
    out: &var string::String,
    darwin: bool,
    arch: Arch,
    cpu: []u8
) -> !?diagnostic::Diagnostic {
    var emitter = try new_emitter(allocator, module, darwin, arch, cpu);
    defer emitter.deinit(allocator);
    return emitter.finish(module, out);
}

fn cpu_enables_arm_dotprod(cpu: []u8) -> bool {
    if mem::len(cpu) == 0 {
        return false;
    }
    return mem::equal_bytes(cpu, "native") or
        contains_bytes(cpu, "apple") or
        contains_bytes(cpu, "neoverse") or
        contains_bytes(cpu, "cortex-a7") or
        contains_bytes(cpu, "cortex-x") or
        contains_bytes(cpu, "armv8.2") or
        contains_bytes(cpu, "armv8.3") or
        contains_bytes(cpu, "armv8.4") or
        contains_bytes(cpu, "armv8.5") or
        contains_bytes(cpu, "armv8.6") or
        contains_bytes(cpu, "armv9");
}

fn cpu_enables_x86_ssse3(darwin: bool, cpu: []u8) -> bool {
    if darwin {
        return true;
    }
    if mem::len(cpu) == 0 or mem::equal_bytes(cpu, "x86-64") {
        return false;
    }
    return true;
}

fn new_emitter(
    allocator: Allocator,
    module: &var ir::Module,
    darwin: bool,
    arch: Arch,
    cpu: []u8
) -> !Emitter {
    let void_name = try module.names.intern("void");
    let names = try ir::new_name_table(allocator);
    let is_x86 = arch == Arch::X86_64 or arch == Arch::X86_64Windows;
    let has_dotprod = arch == Arch::Arm64 and (darwin or cpu_enables_arm_dotprod(cpu));
    let has_ssse3 = is_x86 and cpu_enables_x86_ssse3(darwin, cpu);
    return Emitter {
        allocator: allocator,
        void_name: void_name,
        types: typ::new(allocator),
        names: move names,
        out: string::new(allocator),
        strings: map::new<[]u8, ir::Name>(allocator),
        string_literals: map::new<[]u8, ir::Name>(allocator),
        tables: array::new<ir::Name>(allocator),
        table_order: array::new<ir::Instr>(allocator),
        tables_written: 0,
        values: array::new<ValueInfo>(allocator),
        function_names: map::new<[]u8, ir::Function>(allocator),
        current_return: ir::empty_name(),
        main_returns_int: false,
        next_label: 0,
        next_thread_each: 0,
        current_block: ir::empty_name(),
        block_exit_label: array::new<ExitLabel>(allocator),
        niche_aliases: array::new<NicheAlias>(allocator),
        niche_alias_count: 0,
        local_names: array::new<ir::Name>(allocator),
        owned_names: array::new<ir::Name>(allocator),
        llvm_types: array::new<ir::Name>(allocator),
        entry_param_loads: string::new(allocator),
        wrote_param_loads: false,
        generation: 0,
        frame_records: darwin,
        darwin: darwin,
        arch: arch,
        has_dotprod: has_dotprod,
        has_ssse3: has_ssse3,
        tbaa_used: false,
        bool_range_used: false,
        memory_types: array::new<i64>(allocator),
        whole_values: array::new<i64>(allocator),
        whole_storage: array::new<i64>(allocator),
        part_of: array::new<AddressPart>(allocator),
        lent: array::new<i64>(allocator),
        misread: ir::empty_name(),
        memory_copy_used: false,
        memory_set_used: false,
        use_counts: array::new<UseCount>(allocator),
        own_slots: array::new<OwnSlot>(allocator),
        wrote_phi_value_mark: false,
        aggregates: map::new<[]u8, ir::Name>(allocator),
        references: map::new<[]u8, i64>(allocator),
        wrote_aggregate_phi: false,
        wrote_open_trap: false,
        split: false,
        program_unit: false,
        program_error_names: false,
        program_functions: array::new<ir::Function>(allocator),
        lto: false,
        shared: map::new<i64, bool>(allocator),
        type_scope: map::new<[]u8, bool>(allocator)
    };
}

fn (self: &var Emitter) finish(module: &ir::Module, out: &var string::String) -> !?diagnostic::Diagnostic {
    if try self.emit_module(module) |failed| {
        return move failed;
    }
    while self.out.len() > 0 and last_byte_is(&self.out, 10) {
        try self.out.truncate(self.out.len() - 1);
    }
    let text = self.out.as_bytes();
    if try verify_emitted_text(self.allocator, text) |failed| {
        return move failed;
    }
    try out.append_bytes(self.allocator, text);
    return null;
}

fn last_byte_is(text: &string::String, byte: i64) -> bool {
    let bytes = text.as_bytes();
    return bytes[mem::len(bytes) - 1] == cast<u8>(byte);
}

struct Emitter {
    allocator: Allocator,
    void_name: ir::Name,
    types: typ::Table,
    names: ir::NameTable,
    out: string::String,
    strings: map::Map<[]u8, ir::Name>,
    string_literals: map::Map<[]u8, ir::Name>,
    tables: array::Array<ir::Name>,
    table_order: array::Array<ir::Instr>,
    tables_written: i64,
    values: array::Array<ValueInfo>,
    function_names: map::Map<[]u8, ir::Function>,
    current_return: ir::Name,
    main_returns_int: bool,
    next_label: i64,
    next_thread_each: i64,
    current_block: ir::Name,
    block_exit_label: array::Array<ExitLabel>,
    niche_aliases: array::Array<NicheAlias>,
    niche_alias_count: i64,
    local_names: array::Array<ir::Name>,
    owned_names: array::Array<ir::Name>,
    llvm_types: array::Array<ir::Name>,
    entry_param_loads: string::String,
    wrote_param_loads: bool,
    generation: i64,
    frame_records: bool,
    darwin: bool,
    arch: Arch,
    has_dotprod: bool,
    has_ssse3: bool,
    tbaa_used: bool,
    bool_range_used: bool,
    memory_types: array::Array<i64>,
    whole_values: array::Array<i64>,
    whole_storage: array::Array<i64>,
    part_of: array::Array<AddressPart>,
    lent: array::Array<i64>,
    misread: ir::Name,
    memory_copy_used: bool,
    memory_set_used: bool,
    use_counts: array::Array<UseCount>,
    own_slots: array::Array<OwnSlot>,
    wrote_phi_value_mark: bool,
    aggregates: map::Map<[]u8, ir::Name>,
    references: map::Map<[]u8, i64>,
    wrote_aggregate_phi: bool,
    wrote_open_trap: bool,
    split: bool,
    program_unit: bool,
    program_error_names: bool,
    program_functions: array::Array<ir::Function>,
    lto: bool,
    shared: map::Map<i64, bool>,
    type_scope: map::Map<[]u8, bool>,
}

struct ValueInfo {
    typ: ir::Name,
    operand: ir::Name,
    addr: ir::Name,
    generation: i64,
}

struct NicheAlias {
    result: ir::Name,
    source: ir::Value,
}

struct ExitLabel {
    label: ir::Name,
    generation: i64,
}

union Arg {
    Str(ir::Name),
    Lit([]u8),
    Owned(string::String),
    Int(i64),
    None,
}

fn append_arg(
    allocator: Allocator,
    out: &var string::String,
    names: &ir::NameTable,
    arg: Arg
) -> !void {
    match arg {
        Str(name) => return names.append_to(out, name),
        Lit(text) => return out.append_bytes(allocator, text),
        Owned(text) => {
            defer text.deinit(allocator);
            return out.append_string(allocator, &text);
        },
        Int(value) => return fmt::append_i64(allocator, out, value),
        None => return,
    }
}

fn place_arg(
    allocator: Allocator,
    out: &var string::String,
    names: &ir::NameTable,
    format: []u8,
    position: &var i64,
    arg: Arg
) -> !void {
    errdefer arg.deinit(allocator);
    var index = position.*;
    var run = index;
    while index < mem::len(format) {
        let byte = format[index];
        if byte == cast<u8>(37) and index + 1 < mem::len(format) {
            if format[index + 1] == cast<u8>(37) {
                try out.append_bytes(allocator, format[run..index + 1]);
                index = index + 2;
                run = index;
                continue;
            }
            try out.append_bytes(allocator, format[run..index]);
            try append_arg(allocator, out, names, move arg);
            position.* = index + 2;
            return;
        }
        index = index + 1;
    }
    try out.append_bytes(allocator, format[run..index]);
    arg.deinit(allocator);
    position.* = index;
    return;
}

fn append_format_rest(allocator: Allocator, out: &var string::String, format: []u8, position: i64) -> !void {
    var index = position;
    var run = index;
    while index < mem::len(format) {
        let byte = format[index];
        if byte == cast<u8>(37) and index + 1 < mem::len(format) and format[index + 1] == cast<u8>(37) {
            try out.append_bytes(allocator, format[run..index + 1]);
            index = index + 2;
            run = index;
            continue;
        }
        index = index + 1;
    }
    return out.append_bytes(allocator, format[run..index]);
}

fn format_args1(
    allocator: Allocator,
    out: &var string::String,
    names: &ir::NameTable,
    format: []u8,
    a: Arg
) -> !void {
    errdefer a.deinit(allocator);
    var position = 0;
    try place_arg(allocator, out, names, format, &var position, move a);
    return append_format_rest(allocator, out, format, position);
}

fn format_args2(
    allocator: Allocator,
    out: &var string::String,
    names: &ir::NameTable,
    format: []u8,
    a: Arg,
    b: Arg
) -> !void {
    errdefer a.deinit(allocator);
    errdefer b.deinit(allocator);
    var position = 0;
    try place_arg(allocator, out, names, format, &var position, move a);
    try place_arg(allocator, out, names, format, &var position, move b);
    return append_format_rest(allocator, out, format, position);
}

fn format_args3(
    allocator: Allocator,
    out: &var string::String,
