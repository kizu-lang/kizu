import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::typ;
import std::array;
import std::mem;
import std::string;

// Mechanical port of the call half of internal/llvm/emit.go: `call.<f>`
// instructions to module-local functions with the explicit pointer ABI, to
// std hosted runtime entries with the out-pointer ABI, and to external
// symbols, plus the declaration an external call gets in the header. Go's `functionParams[name]` is read here through the
// function handle `function_named` hands back.

/// Is which of its ways write_call hands a callee its arguments, the Go
/// `callKind`: as the values they are, spelled by the emitter itself, to a
/// std runtime entry with the out-pointer ABI, to a function of this module
/// with the pointer ABI, or to a declared C function.
enum CallKind {
    Plain,
    Builtin,
    Hosted,
    Internal,
    Foreign,
}

/// Says how the callee of a call by name is called, the Go `callTarget`. It
/// is asked where the call is written and where its arguments are sorted
/// (call_reads_address), so the two cannot answer differently.
fn (self: &var Emitter) call_kind(module: &ir::Module, node: &ir::InstrNode) -> !CallKind {
    if module.names.is(node.extern_abi, "c") {
        return CallKind::Foreign;
    }
    if thread_round_data(&module.names, node.operand) |_| {
        return CallKind::Builtin;
    }
    if module.names.is(node.operand, "std::internal::builtin::mem_size_of") {
        return CallKind::Builtin;
    }
    if try self.uses_hosted_runtime_abi(module, node.operand, node) {
        return CallKind::Hosted;
    }
    if self.function_named(module, node.operand) |_| {
        return CallKind::Internal;
    }
    return CallKind::Plain;
}

/// Writes user function calls, the Go `writeCall`.
fn (self: &var Emitter) write_call(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    var callee_name = node.operand;
    match try self.call_kind(module, node) {
        Builtin => return self.write_compiler_builtin(module, node),
        Hosted => return self.write_hosted_runtime_call(module, node.operand, node),
        Internal => {
            if self.function_named(module, node.operand) |callee| {
                return self.write_internal_call(module, callee, node);
            }
        },
        Foreign => {
            callee_name = node.extern_name;
            if try self.c_call_uses_struct_values(module, node) {
                let symbol = try self.callee_symbol(module, callee_name);
                return self.write_c_struct_call(module, symbol, node);
            }
        },
        Plain => {},
    }
    var args = array::new<string::String>(self.allocator);
    defer args.deinit(self.allocator);
    var index = 0;
    while node.args.get(index) |arg| {
        // A foreign callee carries its declared passing on the call; a
        // parameter handed the address of a copy gets that copy made here.
        if call_param_takes_address_of(module, node, index, arg.type_name) {
            try args.append(self.allocator, try self.copy_address_arg(module, node, index, index));
            index = index + 1;
            continue;
        }
        index = index + 1;
        let value = try self.operand(module, arg);
        let arg_type = try self.llvm_type_of(module, arg.type_name);
        try args.append(self.allocator, try self.sprint2("%s %s", Arg::Str(arg_type), Arg::Str(value.operand)));
    }
    // A call to a variadic callee names the callee's whole function type, not
    // only its result: that is what tells the target which arguments are the
    // variadic ones, and so how each is passed.
    var callee_type = try self.llvm_type_of(module, node.result.type_name);
    if node.variadic_fixed > 0 {
        var params = array::new<string::String>(self.allocator);
        defer params.deinit(self.allocator);
        try self.append_plain_call_params(module, node, &var params);
        let joined_params = try string::join(self.allocator, &params, ", ");
        callee_type = try self.text2("%s (%s)", Arg::Str(callee_type), Arg::Owned(move joined_params));
    }
    let symbol = try self.callee_symbol(module, callee_name);
    let joined = try string::join(self.allocator, &args, ", ");
    let call = try self.text3("call %s @%s(%s)", Arg::Str(callee_type), Arg::Str(symbol), Arg::Owned(move joined));
    return self.write_call_line(module, node, call);
}

/// Writes a builtin the emitter spells itself rather than calling into the
/// runtime, the Go `writeCompilerBuiltin`: a pool round, or the size of a
/// type.
fn (self: &var Emitter) write_compiler_builtin(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if thread_round_data(&module.names, node.operand) |data_index| {
        return self.write_thread_pool_round(module, node, data_index);
    }
    return self.write_size_of(module, node);
}

/// Writes the size of the type the call names as the target lays it out, the
/// Go `writeSizeOf`: the address one T past null, which LLVM folds to a
/// constant from the data layout clang gives the module.
fn (self: &var Emitter) write_size_of(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let end_name = try self.next_synthetic_value("size.end");
    let end = try self.percent(end_name);
    let measured = try self.llvm_type_of(module, node.immediate);
    try self.line2("  %s = getelementptr %s, ptr null, i64 1", Arg::Str(end), Arg::Str(measured));
    let result = try self.local_name(module, node.result.name);
    try self.line2("  %s = ptrtoint ptr %s to i64", Arg::Str(result), Arg::Str(end));
    try self.set_value(module, node.result, result);
    return null;
}

/// Writes the address of a declared function. A function symbol is already a
/// pointer in LLVM, so the value is the symbol itself and no instruction is
/// emitted for it.
fn (self: &var Emitter) write_func_addr(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    if module.names.is(node.extern_abi, "c") {
        let symbol = try self.callee_symbol(module, node.extern_name);
        let operand = try self.text1("@%s", Arg::Str(symbol));
        try self.set_value(module, node.result, operand);
        return null;
    }
    if self.function_named(module, node.operand) |_| {
        let symbol = try self.callee_symbol(module, node.operand);
        let operand = try self.text1("@%s", Arg::Str(symbol));
        try self.set_value(module, node.result, operand);
        return null;
    }
    return try self.fail1("llvm error: `%s` is not a declared function", Arg::Str(node.operand));
}

/// Writes a call through a function pointer. The callee is the first operand,
/// the way it arrived from lowering.
fn (self: &var Emitter) write_indirect_call(module: &ir::Module, node: &ir::InstrNode) -> !?diagnostic::Diagnostic {
    let callee_value = node.args.get(0) orelse
        return try self.fail0("llvm error: call.indirect expects a callee");
    let callee = try self.operand(module, callee_value);
    var args = array::new<string::String>(self.allocator);
    defer args.deinit(self.allocator);
    var index = 1;
    while index < node.args.len() {
        let param_index = index - 1;
        var passing = ir::Passing::Value;
        var param_type = ir::empty_name();
        if node.call_params.get(param_index) |param| {
            passing = param.passing;
            param_type = param.type_name;
        }
        try args.append(
            self.allocator,
            try self.internal_call_arg(module, node, index, passing, param_type, param_index)
        );
        index = index + 1;
    }
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    let joined = try string::join(self.allocator, &args, ", ");
    let call = try self.text3(
        "call %s %s(%s)", Arg::Str(result_type), Arg::Str(callee.operand), Arg::Owned(move joined));
    return self.write_call_line(module, node, call);
}

/// Writes the call text as a statement or as a result definition, the tail
/// the Go `writeCall` and `writeInternalCall` share.
fn (self: &var Emitter) write_call_line(module: &ir::Module, node: &ir::InstrNode, call: ir::Name) -> !?diagnostic::Diagnostic {
    if module.names.is(node.result.type_name, "void") {
        try self.line1("  %s", Arg::Str(call));
        return null;
    }
    let result_name = try self.local_name(module, node.result.name);
    try self.line2("  %s = %s", Arg::Str(result_name), Arg::Str(call));
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Names the LLVM symbol of a callee the module names, the Go
/// `llvmFunctionName(name)`.
fn (self: &var Emitter) callee_symbol(module: &ir::Module, name: ir::Name) -> !ir::Name {
    let retained = ir::name_text(&module.names, name);
    let bytes = retained.as_bytes();
    return self.llvm_function_name(bytes);
}

/// Adapts module-local struct values to Kizu's explicit pointer ABI,
/// avoiding target-dependent aggregate argument lowering, the Go
/// `writeInternalCall`.
fn (self: &var Emitter) write_internal_call(
    module: &ir::Module,
    callee: ir::Function,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    var args = array::new<string::String>(self.allocator);
    defer args.deinit(self.allocator);
    let param_count = module.function_param_count(callee);
    var index = 0;
    while index < node.args.len() {
        // A callee this module does not declare takes its arguments by value,
        // which is what the zero Param says.
        var passing = ir::Passing::Value;
        var param_type = ir::empty_name();
        if index < param_count {
            if module.function_param(callee, index) |param| {
                passing = param.passing;
                param_type = param.type_name;
            }
        }
        try args.append(self.allocator, try self.internal_call_arg(module, node, index, passing, param_type, index));
        index = index + 1;
    }
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    let symbol = try self.callee_symbol(module, node.operand);
    let joined = try string::join(self.allocator, &args, ", ");
    let call = try self.text3("call %s @%s(%s)", Arg::Str(result_type), Arg::Str(symbol), Arg::Owned(move joined));
    return self.write_call_line(module, node, call);
}

/// Returns the argument of an instruction at arg_index, the index-th the
/// callee takes, in function_param_abi form, the Go `internalCallArg`. A
/// parameter handed the value its address is taken of gets that address made
/// here, which is the one thing the callee's declared Passing decides.
///
/// A value kept in memory is passed as the slot it already lives in: the
/// callee only reads through the address, and nothing writes the slot while
/// the call runs.
fn (self: &var Emitter) internal_call_arg(
    module: &ir::Module,
    node: &ir::InstrNode,
    arg_index: i64,
    passing: ir::Passing,
    param_type: ir::Name,
    index: i64
) -> !string::String {
    let arg = node.args.get_or_panic(arg_index);
    let arg_type = try self.llvm_type_of(module, arg.type_name);
    if takes_address_of(module, passing, param_type, arg.type_name) {
        return self.copy_address_arg(module, node, arg_index, index);
    }
    let type_text = ir::name_text(&module.names, arg.type_name);
    let type_bytes = type_text.as_bytes();
    if !uses_indirect_struct_param_abi(module, type_bytes) {
        let value = try self.operand(module, arg);
        return self.sprint2("%s %s", Arg::Str(arg_type), Arg::Str(value.operand));
    }
    if try self.address_arg(module, node, arg_index) |addr| {
        return self.sprint2("ptr %s", Arg::Str(addr), Arg::None);
    }
    let slot_name = try self.next_arg_slot(index);
    try self.line2("  %s = alloca %s", Arg::Str(slot_name), Arg::Str(arg_type));
    let value = try self.operand(module, arg);
    try self.line3("  store %s %s, ptr %s", Arg::Str(arg_type), Arg::Str(value.operand), Arg::Str(slot_name));
    return self.sprint2("ptr %s", Arg::Str(slot_name), Arg::None);
}

/// Stores a copy of the argument of an instruction at arg_index, the
/// index-th the callee takes, in a slot of its own and returns that slot as
/// the pointer argument a CopyAddress parameter reads through, the Go
/// `copyAddressArg`.
fn (self: &var Emitter) copy_address_arg(
    module: &ir::Module,
    node: &ir::InstrNode,
    arg_index: i64,
    index: i64
) -> !string::String {
    let arg = node.args.get_or_panic(arg_index);
    let arg_type = try self.llvm_type_of(module, arg.type_name);
    let slot_name = try self.next_arg_slot(index);
    try self.line3("  %s = alloca %s, align %d", Arg::Str(slot_name), Arg::Str(arg_type), Arg::Int(max_inline_payload_align()));
    if !try self.copied_from_memory(module, node, arg_index, slot_name) {
        let value = try self.operand(module, arg);
        try self.line4(
            "  store %s %s, ptr %s, align %d",
            Arg::Str(arg_type), Arg::Str(value.operand), Arg::Str(slot_name), Arg::Int(max_inline_payload_align())
        );
    }
    return self.sprint2("ptr %s", Arg::Str(slot_name), Arg::None);
}

/// Reports whether the call's index-th declared parameter, when the call
/// carries one, is handed the address of a copy of its argument: the Go
/// `index < len(instr.CallParams) && instr.CallParams[index].TakesAddressOf(arg.Type)`.
fn call_param_takes_address_of(module: &ir::Module, node: &ir::InstrNode, index: i64, arg_type: ir::Name) -> bool {
    let param = node.call_params.get(index) orelse return false;
    return takes_address_of(module, param.passing, param.type_name, arg_type);
}

/// Names the slot one by-address argument is copied into, the Go
/// `"%" + e.nextSyntheticValue(fmt.Sprintf("arg.%d", index))`.
fn (self: &var Emitter) next_arg_slot(index: i64) -> !ir::Name {
    self.next_label = self.next_label + 1;
    return self.text2("%%kizu.arg.%d.%d", Arg::Int(index), Arg::Int(self.next_label));
}

/// Reports whether a parameter reading through an address is being handed
/// the value that address is taken of, rather than an address the caller
/// already held, the Go `Param.TakesAddressOf` read without interning.
fn takes_address_of(module: &ir::Module, passing: ir::Passing, param_type: ir::Name, arg_type: ir::Name) -> bool {
    if passing != ir::Passing::CopyAddress or ir::same_name(param_type, arg_type) {
        return false;
    }
    let param_text = ir::name_text(&module.names, param_type);
    let param_bytes = param_text.as_bytes();
    let arg_text = ir::name_text(&module.names, arg_type);
    let arg_bytes = arg_text.as_bytes();
    let deref = deref_borrow_type(param_bytes);
    return mem::equal_bytes(deref, arg_bytes);
}

/// Returns T for `&T` and `&var T`, and the spelling itself otherwise, the
/// Go ir `derefType`.
fn deref_borrow_type(name: []u8) -> []u8 {
    if mem::starts_with(name, "&var ") {
        return name[5..mem::len(name)];
    }
    if mem::starts_with(name, "&") {
        return name[1..mem::len(name)];
    }
    return name;
}

/// Reports whether a std hosted runtime call uses the explicit pointer ABI
/// instead of the platform C aggregate ABI, the Go `usesHostedRuntimeABI`.
/// Error unions and optionals are both C-side aggregates, so both go out
/// through the pointer; an aggregate argument goes in through one. How C
/// passes an aggregate by value is the platform's to say -- two registers on
/// System V and AAPCS64 for a slice, a hidden address on Windows -- and a
/// pointer is the one spelling every platform agrees on.
fn (self: &var Emitter) uses_hosted_runtime_abi(module: &ir::Module, name: ir::Name, node: &ir::InstrNode) -> !bool {
    let symbol = try self.callee_symbol(module, name);
    if !self.names.starts_with(symbol, "std__internal__builtin__") {
        return false;
    }
    let result_text = ir::name_text(&module.names, node.result.type_name);
    let result_type = result_text.as_bytes();
    if try self.error_union_success_type(result_type) |success| {
        success.deinit(self.allocator);
        return true;
    }
    if is_optional_type(result_type) {
        return true;
    }
    var index = 0;
    while node.args.get(index) |arg| {
        index = index + 1;
        let type_text = ir::name_text(&module.names, arg.type_name);
        let type_bytes = type_text.as_bytes();
        if hosted_runtime_indirect_abi(module, type_bytes) {
            return true;
        }
    }
    return false;
}

/// Appends the lowered parameter ABI for hosted runtime calls, the Go
/// `hostedRuntimeParamTypes`. Aggregates -- slices and module structs --
/// reach the C runtime behind a pointer, never by value.
fn (self: &var Emitter) append_hosted_runtime_param_types(
    module: &ir::Module,
    name: ir::Name,
    args: &array::Array<ir::Value>,
    params: &var array::Array<string::String>
) -> !void {
    var index = 0;
    while args.get(index) |arg| {
        index = index + 1;
        let type_text = ir::name_text(&module.names, arg.type_name);
        let type_bytes = type_text.as_bytes();
        if hosted_runtime_indirect_abi(module, type_bytes) {
            try params.append(self.allocator, try string::from_bytes(self.allocator, "ptr"));
            if module.names.is(name, "std::internal::builtin::task_set_spawn") and index == 4 {
                try params.append(self.allocator, try string::from_bytes(self.allocator, "ptr"));
            }
            if module.names.is(name, "std::internal::builtin::task_set_spawn") and index == 5 {
                try params.append(self.allocator, try string::from_bytes(self.allocator, "i64"));
            }
            continue;
        }
        let arg_type = try self.llvm_type_of(module, arg.type_name);
        try params.append(self.allocator, try self.names.copy(arg_type));
        if module.names.is(name, "std::internal::builtin::task_set_spawn") and index == 4 {
            try params.append(self.allocator, try string::from_bytes(self.allocator, "ptr"));
        }
        if module.names.is(name, "std::internal::builtin::task_set_spawn") and index == 5 {
            try params.append(self.allocator, try string::from_bytes(self.allocator, "i64"));
        }
    }
    return;
}

/// Adapts Kizu aggregate values to the narrow hosted C ABI, the Go
/// `writeHostedRuntimeCall`.
fn (self: &var Emitter) write_hosted_runtime_call(
    module: &ir::Module,
    name: ir::Name,
    node: &ir::InstrNode
) -> !?diagnostic::Diagnostic {
    let result_name = try self.local_name(module, node.result.name);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    let result_slot = try self.suffixed(result_name, ".slot");
    try self.line2("  %s = alloca %s", Arg::Str(result_slot), Arg::Str(result_type));
    var args = array::new<string::String>(self.allocator);
    defer args.deinit(self.allocator);
    try args.append(self.allocator, try self.sprint2("ptr %s", Arg::Str(result_slot), Arg::None));
    var index = 0;
    while node.args.get(index) |arg| {
        let type_text = ir::name_text(&module.names, arg.type_name);
        let type_bytes = type_text.as_bytes();
        let arg_type = try self.llvm_type_of(module, arg.type_name);
        if hosted_runtime_indirect_abi(module, type_bytes) {
            let arg_slot = try self.text2("%s.arg.%d", Arg::Str(result_name), Arg::Int(index));
            try self.line2("  %s = alloca %s", Arg::Str(arg_slot), Arg::Str(arg_type));
            if !try self.copied_from_memory(module, node, index, arg_slot) {
                let value = try self.operand(module, arg);
                try self.line3("  store %s %s, ptr %s", Arg::Str(arg_type), Arg::Str(value.operand), Arg::Str(arg_slot));
            }
            try args.append(self.allocator, try self.sprint2("ptr %s", Arg::Str(arg_slot), Arg::None));
            if module.names.is(name, "std::internal::builtin::task_set_spawn") and index == 3 {
                let state = node.args.get_or_panic(4);
                let invoke = try self.task_invoke_thunk_name(module, state.type_name);
                try args.append(self.allocator, try self.sprint2("ptr @%s", Arg::Str(invoke), Arg::None));
            }
            if module.names.is(name, "std::internal::builtin::task_set_spawn") and index == 4 {
                let size = try self.element_size_operand(module, arg.type_name);
                try args.append(self.allocator, try self.sprint2("i64 %s", Arg::Str(size), Arg::None));
            }
            index = index + 1;
            continue;
        }
        let value = try self.operand(module, arg);
        try args.append(self.allocator, try self.sprint2("%s %s", Arg::Str(arg_type), Arg::Str(value.operand)));
        if module.names.is(name, "std::internal::builtin::task_set_spawn") and index == 3 {
            let state = node.args.get_or_panic(4);
            let invoke = try self.task_invoke_thunk_name(module, state.type_name);
            try args.append(self.allocator, try self.sprint2("ptr @%s", Arg::Str(invoke), Arg::None));
        }
        if module.names.is(name, "std::internal::builtin::task_set_spawn") and index == 4 {
            let size = try self.element_size_operand(module, arg.type_name);
            try args.append(self.allocator, try self.sprint2("i64 %s", Arg::Str(size), Arg::None));
        }
        index = index + 1;
    }
    let symbol = try self.callee_symbol(module, name);
    let joined = try string::join(self.allocator, &args, ", ");
    try self.line2("  call void @%s(%s)", Arg::Str(symbol), Arg::Owned(move joined));
    try self.line3("  %s = load %s, ptr %s", Arg::Str(result_name), Arg::Str(result_type), Arg::Str(result_slot));
    try self.set_value(module, node.result, result_name);
    return null;
}

/// Names the typed side of the TaskSet callback ABI for one state type, the
/// Go `taskInvokeThunkName`.
fn (self: &var Emitter) task_invoke_thunk_name(
    module: &ir::Module,
    type_name: ir::Name
) -> !ir::Name {
    let retained = ir::name_text(&module.names, type_name);
    let bytes = retained.as_bytes();
    return self.task_invoke_thunk_name_bytes(bytes);
}

fn (self: &var Emitter) task_invoke_thunk_name_bytes(type_name: []u8) -> !ir::Name {
    var out = try string::from_bytes(self.allocator, "kizu.task.invoke.");
    errdefer out.deinit(self.allocator);
    try append_llvm_name_part(self.allocator, &var out, type_name);
    return self.names.intern_owned(move out);
}

/// Declares the C symbol one instruction names, the Go `externalDecl`. A call
/// spells the signature with its operands; taking the address spells it with
/// the `extern "c" fn(...)` type the address has.
fn (self: &var Emitter) external_decl(module: &ir::Module, node: &ir::InstrNode) -> !string::String {
    if node.op != ir::Op::FuncAddr {
        return self.external_call_decl(module, node.extern_name, node);
    }
    let pointer = ir::name_text(&module.names, node.result.type_name);
    let pointer_bytes = pointer.as_bytes();
    let parsed = try self.types.parse(pointer_bytes);
    var declared = array::new<typ::Type>(self.allocator);
    defer declared.deinit(self.allocator);
    var result = parsed;
    match typ::root_node(&self.types, parsed) {
        Func(func) => {
            var index = 0;
            while func.params.get(index) |param| {
                index = index + 1;
                try declared.append(self.allocator, typ::child_type(parsed, param));
            }
            result = typ::child_type(parsed, func.result);
        },
        _ => return self.external_call_decl(module, node.extern_name, node),
    }
    var params = array::new<string::String>(self.allocator);
    defer params.deinit(self.allocator);
    var index = 0;
    while declared.get(index) |part| {
        index = index + 1;
        let param_type = try self.rendered_llvm_type(module, part);
        try params.append(self.allocator, try self.names.copy(param_type));
    }
    let result_type = try self.rendered_llvm_type(module, result);
    let symbol = try self.callee_symbol(module, node.extern_name);
    let joined = try string::join(self.allocator, &params, ", ");
    return self.sprint3("declare %s @%s(%s)", Arg::Str(result_type), Arg::Str(symbol), Arg::Owned(move joined));
}

/// Names the LLVM type of one parsed Kizu type.
fn (self: &var Emitter) rendered_llvm_type(module: &ir::Module, value: typ::Type) -> !ir::Name {
    let rendered = try typ::render(self.allocator, &self.types, value);
    defer rendered.deinit(self.allocator);
    let bytes = rendered.as_bytes();
    return self.llvm_type(module, bytes);
}

/// Formats one external call declaration from typed IR operands, the Go
/// `externalCallDecl`.
fn (self: &var Emitter) external_call_decl(module: &ir::Module, name: ir::Name, node: &ir::InstrNode) -> !string::String {
    let symbol = try self.callee_symbol(module, name);
    if thread_round_data(&module.names, name) |data_index| {
        return self.thread_pool_round_decl(module, name, node, data_index);
    }
    var params = array::new<string::String>(self.allocator);
    defer params.deinit(self.allocator);
    if try self.uses_hosted_runtime_abi(module, name, node) {
        try params.append(self.allocator, try string::from_bytes(self.allocator, "ptr"));
        try self.append_hosted_runtime_param_types(module, name, &node.args, &var params);
        let joined = try string::join(self.allocator, &params, ", ");
        return self.sprint2("declare void @%s(%s)", Arg::Str(symbol), Arg::Owned(move joined));
    }
    if module.names.is(node.extern_abi, "c") and try self.c_call_uses_struct_values(module, node) {
        return self.c_struct_call_decl(module, symbol, node);
    }
    try self.append_plain_call_params(module, node, &var params);
    let result_type = try self.llvm_type_of(module, node.result.type_name);
    let joined = try string::join(self.allocator, &params, ", ");
    return self.sprint3("declare %s @%s(%s)", Arg::Str(result_type), Arg::Str(symbol), Arg::Owned(move joined));
}

/// Spells the parameter list of a callee that takes every argument as the
/// value it is, from the operands of one call to it, the Go
/// `plainCallParams`. A C variadic callee declares only its first
/// variadic_fixed arguments and then `...`: the arguments after them differ
/// from call to call, and the declaration and every call have to say where
/// they start.
fn (self: &var Emitter) append_plain_call_params(
    module: &ir::Module,
    node: &ir::InstrNode,
    params: &var array::Array<string::String>
) -> !void {
    var declared = node.args.len();
    if node.variadic_fixed > 0 {
        declared = node.variadic_fixed;
    }
    var index = 0;
    while index < declared {
        let arg = node.args.get(index) orelse break;
        // A parameter handed the address of a copy is a pointer to C.
        if call_param_takes_address_of(module, node, index, arg.type_name) {
            try params.append(self.allocator, try string::from_bytes(self.allocator, "ptr"));
            index = index + 1;
            continue;
        }
        index = index + 1;
        let arg_type = try self.llvm_type_of(module, arg.type_name);
        try params.append(self.allocator, try self.names.copy(arg_type));
    }
    if node.variadic_fixed > 0 {
        try params.append(self.allocator, try string::from_bytes(self.allocator, "..."));
    }
    return;
}
