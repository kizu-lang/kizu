import compiler::internal::ast;
import compiler::internal::diagnostic;
import std::mem;
import std::string;

// Accepts a call, possibly under an `unsafe` marker, and nothing that
// could fail on the way, the Go `validateDeferredCallShape`. A deferred
// call runs where no caller is listening, so it cannot fail: a `try` or a
// `catch` inside it would be an error path with nowhere to go. A builtin
// form such as `print` is a statement the compiler spells out in place, not
// a function a call can be held to; a deferred call names something with a
// signature.
fn (self: &Checker) validate_deferred_call_shape(
    tree: &ast::Ast,
    keyword: []u8,
    expression: ast::Expression
) -> !?diagnostic::Diagnostic {
    var inner = expression;
    match tree.expressions.at(inner.node) {
        Unsafe(marked) => {
            inner = marked.value;
        },
        _ => {},
    }
    match tree.expressions.at(inner.node) {
        Try(_) => {
            return try self.deferred_call_error(keyword, " call cannot propagate an error with `try`", "");
        },
        Call(call) => {
            match tree.expressions.at(call.callee.node) {
                Ident(identifier) => {
                    let retained = tree.texts.at(identifier.name.node);
                    let name = retained.as_bytes();
                    if is_builtin_call_name(name) {
                        var message = string::new(self.allocator);
                        errdefer message.deinit(self.allocator);
                        try message.append_bytes(self.allocator, keyword);
                        try message.append_bytes(self.allocator, " expects a call to a declared function or method, got builtin `");
                        try message.append_bytes(self.allocator, name);
                        try message.append_byte(self.allocator, cast<u8>(96));
                        return try self.checker_message_at("type error", ast::zero_span(), move message);
                    }
                    return null;
                },
                _ => return null,
            }
        },
        Binary(binary) => {
            let retained = tree.texts.at(binary.operator.node);
            let operator = retained.as_bytes();
            if mem::equal_bytes(operator, "catch") {
                return try self.deferred_call_error(keyword, " call cannot fail; `catch` has no error to catch", "");
            }
        },
        _ => {},
    }
    return try self.deferred_call_error(keyword, " expects a void call", "");
}

// Builds the diagnostic for a deferred statement of the wrong shape.
fn (self: &Checker) deferred_call_error(keyword: []u8, text: []u8, tail: []u8) -> !?diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, keyword);
    try message.append_bytes(self.allocator, text);
    try message.append_bytes(self.allocator, tail);
    return try self.checker_message_at("type error", ast::zero_span(), move message);
}

// Names the call spellings the checker types itself rather than through a
// declaration, the Go `isBuiltinCallName`: they have no signature to defer
// against.
fn is_builtin_call_name(name: []u8) -> bool {
    return mem::equal_bytes(name, "print") or mem::equal_bytes(name, "ptr_read") or
        mem::equal_bytes(name, "ptr_write") or mem::equal_bytes(name, "ptr_of") or
        mem::equal_bytes(name, "mut_ptr_of") or mem::equal_bytes(name, "ptr_offset") or
        mem::equal_bytes(name, "view_from_ptr") or mem::equal_bytes(name, "mut_view_from_ptr") or
        mem::equal_bytes(name, "volatile_read") or mem::equal_bytes(name, "volatile_write") or
        mem::equal_bytes(name, "Io");
}

// Records an active loop label after rejecting a duplicate named loop.
fn (self: &var Checker) enter_loop(label: []u8) -> !?diagnostic::Diagnostic {
    let allocator = self.allocator;
    if mem::len(label) > 0 and self.has_loop_label(label) {
        var message = string::new(allocator);
        errdefer message.deinit(allocator);
        try message.append_bytes(allocator, "duplicate loop label `");
        try message.append_bytes(allocator, label);
        try message.append_byte(allocator, cast<u8>(96));
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    if self.current_body |handle| {
        let owned = try string::from_bytes(allocator, label);
        errdefer owned.deinit(allocator);
        if self.body_contexts.at_mut(handle) |context| {
            try context.loop_labels.append(allocator, move owned);
            return null;
        }
        owned.deinit(allocator);
    }
    return try self.checker_error_at(
        "type error", ast::zero_span(),
        "internal checker has no active body"
    );
}

fn (self: &var Checker) leave_loop() -> void {
    if self.current_body |handle| {
        if self.body_contexts.at_mut(handle) |context| {
            let label = context.loop_labels.pop_or_panic();
            label.deinit(self.allocator);
        }
    }
    return;
}

// Validates break and continue placement against the active loop stack.
fn (self: &Checker) check_loop_branch(kind: []u8, label: []u8) -> !?diagnostic::Diagnostic {
    if self.loop_depth() == 0 {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try message.append_bytes(self.allocator, kind);
        try message.append_bytes(self.allocator, "` used outside loop");
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    if mem::len(label) > 0 and !self.has_loop_label(label) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "unknown loop label `");
        try message.append_bytes(self.allocator, label);
        try message.append_byte(self.allocator, cast<u8>(96));
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    return null;
}

fn (self: &Checker) loop_depth() -> i64 {
    let handle = self.current_body orelse return 0;
    let context = self.body_contexts.at(handle);
    return context.loop_labels.len();
}

// Reports whether label names an active loop, searching innermost first.
fn (self: &Checker) has_loop_label(label: []u8) -> bool {
    let handle = self.current_body orelse return false;
    let context = self.body_contexts.at(handle);
    let labels = &context.loop_labels;
    var index = labels.len() - 1;
    while index >= 0 {
        if labels.at(index) |retained| {
            let current = retained.as_bytes();
            if mem::equal_bytes(current, label) {
                return true;
            }
        }
        index = index - 1;
    }
    return false;
}
