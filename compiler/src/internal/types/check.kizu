import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::stdtarget;
import std::array;
import std::map;
import std::mem;

union BodyCheckTarget {
    None,
    Missing,
    Function(FunctionHandle),
    Test(ast::TestDecl),
}

fn is_std_module_name(name: []u8) -> bool {
    return mem::equal_bytes(name, "std") or mem::starts_with(name, "std::");
}

fn program_has_non_std_decl(tree: &ast::Ast, program: &ast::Program) -> bool {
    var index = 0;
    while program.declarations.get(index) |declaration| {
        index = index + 1;
        match tree.declarations.at(declaration.node) {
            Function(function) => {
                if !function.signature.std {
                    let retained = tree.texts.at(function.signature.name.node);
                    let name = retained.as_bytes();
                    if !mem::starts_with(name, "std::") {
                        return true;
                    }
                }
            },
            Test(test) => {
                let retained = tree.texts.at(test.module.node);
                let module_name = retained.as_bytes();
                if !is_std_module_name(module_name) {
                    return true;
                }
            },
            _ => {},
        }
    }
    return false;
}

fn (self: &Checker) is_std_function(handle: FunctionHandle) -> bool {
    if self.metadata.functions.at(handle.index) |function| {
        let name = function.name.as_bytes();
        return function.signature.std or mem::starts_with(name, "std::");
    }
    return false;
}

fn (self: &var Checker) reach_std_function(handle: FunctionHandle) -> !void {
    if !self.lazy_std {
        return;
    }
    if self.metadata.functions.at(handle.index) |function| {
        let name = function.name.as_bytes();
        if (!function.signature.std and !mem::starts_with(name, "std::")) or
            function_has_type_params(function) {
            return;
        }
        if self.reached_std.contains(handle.index) {
            return;
        }
        try self.reached_std.insert(self.allocator, handle.index, true);
        try self.pending_std.append(self.allocator, handle);
    }
    return;
}

pub fn check(
    allocator: Allocator,
    tree: &var ast::Ast,
    program: &ast::Program
) -> !?diagnostic::Diagnostic {
    return check_for_target(
        allocator, tree, program, stdtarget::host()
    );
}

pub fn check_for_target(
    allocator: Allocator,
    tree: &var ast::Ast,
    program: &ast::Program,
    target: stdtarget::Target
) -> !?diagnostic::Diagnostic {
    var checker = new_checker_for_target(allocator, target);
    defer checker.deinit(allocator);
    checker.lazy_std = program_has_non_std_decl(tree, program);
    if try checker.check_setup(tree, program) |failed| {
        return move failed;
    }
    var std_spans = map::new<i64, ast::Span>(allocator);
    defer std_spans.deinit(allocator);
    var index = 0;
    while program.declarations.get(index) |declaration| {
        index = index + 1;
        if checker.lazy_std {
            match checker.body_check_target(tree, declaration) {
                Function(handle) => {
                    if checker.is_std_function(handle) {
                        try std_spans.insert(allocator, handle.index, tree.declaration_span(declaration));
                        continue;
                    }
                },
                _ => {},
            }
        }
        if try checker.check_declaration_body(tree, declaration) |failed| {
            return move failed;
        }
    }
    var pending_index = 0;
    while checker.pending_std.get(pending_index) |handle| {
        pending_index = pending_index + 1;
        if try checker.check_function(tree, handle) |failed| {
            let span = std_spans.get(handle.index) orelse ast::zero_span();
            return diagnostic::locate(move failed, span);
        }
    }
    return null;
}

pub fn check_all(
    allocator: Allocator,
    tree: &var ast::Ast,
    program: &ast::Program
) -> !array::Array<diagnostic::Diagnostic> {
    var checker = new_checker(allocator);
    defer checker.deinit(allocator);
    checker.lazy_std = program_has_non_std_decl(tree, program);
    var out = array::new<diagnostic::Diagnostic>(allocator);
    errdefer out.deinit(allocator);
    if try checker.check_setup(tree, program) |failed| {
        try out.append(allocator, move failed);
        return move out;
    }
    var std_spans = map::new<i64, ast::Span>(allocator);
    defer std_spans.deinit(allocator);
    var index = 0;
    while program.declarations.get(index) |declaration| {
        index = index + 1;
        if checker.lazy_std {
            match checker.body_check_target(tree, declaration) {
                Function(handle) => {
                    if checker.is_std_function(handle) {
                        try std_spans.insert(allocator, handle.index, tree.declaration_span(declaration));
                        continue;
                    }
                },
                _ => {},
            }
        }
        if try checker.check_declaration_body(tree, declaration) |failed| {
            try out.append(allocator, move failed);
        }
    }
    var pending_index = 0;
    while checker.pending_std.get(pending_index) |handle| {
        pending_index = pending_index + 1;
        if try checker.check_function(tree, handle) |failed| {
            let span = std_spans.get(handle.index) orelse ast::zero_span();
            try out.append(allocator, diagnostic::locate(move failed, span));
        }
    }
    return move out;
}

fn (self: &var Checker) check_setup(
    tree: &ast::Ast,
    program: &ast::Program
) -> !?diagnostic::Diagnostic {
    if try self.collect_functions(tree, program) |failed| {
        return move failed;
    }
    self.plain_data_ready = true;
    if try self.check_inline_recursion(tree, program) |failed| {
        return move failed;
    }
    if try self.check_public_api(tree, program) |failed| {
        return move failed;
    }
    return self.check_owner_union_contracts(tree, program);
}

fn (self: &var Checker) check_declaration_body(
    tree: &var ast::Ast,
    declaration: ast::Declaration
) -> !?diagnostic::Diagnostic {
    if try self.check_declaration_body_form(tree, declaration) |problem| {
        return locate_decl(tree, move problem, declaration);
    }
    return null;
}

fn (self: &var Checker) locate_member(
    tree: &ast::Ast,
    problem: diagnostic::Diagnostic,
    declaration: ast::Declaration
) -> diagnostic::Diagnostic {
    let at_member = diagnostic::locate(move problem, self.member_span);
    self.member_span = ast::zero_span();
    return locate_decl(tree, move at_member, declaration);
}

fn locate_decl(
    tree: &ast::Ast,
    problem: diagnostic::Diagnostic,
    declaration: ast::Declaration
) -> diagnostic::Diagnostic {
    return diagnostic::locate(move problem, tree.declaration_span(declaration));
}

fn (self: &var Checker) check_declaration_body_form(
    tree: &var ast::Ast,
    declaration: ast::Declaration
) -> !?diagnostic::Diagnostic {
    match self.body_check_target(tree, declaration) {
        None => return null,
        Missing => return try self.checker_error_at(
            "type error", ast::zero_span(), "missing function metadata"
        ),
        Function(handle) => return self.check_function(tree, handle),
        Test(test) => return self.check_test_decl(tree, &test),
    }
}

fn (self: &Checker) body_check_target(
    tree: &ast::Ast,
    declaration: ast::Declaration
) -> BodyCheckTarget {
    match tree.declarations.at(declaration.node) {
        Function(function) => {
            if signature_has_type_params(&function.signature) {
                return BodyCheckTarget::None;
            }
            let retained = tree.texts.at(function.signature.name.node);
            let name = retained.as_bytes();
            let handle = self.metadata.functions_by_name.get(name) orelse
                return BodyCheckTarget::Missing;
            return BodyCheckTarget::Function(handle);
        },
        Test(test) => return BodyCheckTarget::Test(ast::TestDecl {
            name: test.name,
            body: test.body,
            module: test.module
        }),
        _ => return BodyCheckTarget::None,
    }
}

fn signature_has_type_params(signature: &ast::FunctionSignature) -> bool {
    var index = 0;
    while signature.static_params.at(index) |parameter| {
        if parameter.is_type() {
            return true;
        }
        index = index + 1;
    }
    return false;
}
