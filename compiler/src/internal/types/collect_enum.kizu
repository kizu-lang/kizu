import compiler::internal::ast;
import compiler::internal::diagnostic;
import std::array;
import std::map;
import std::string;

// Collects the enum-shaped branches of the Checker's type-declaration pass.
fn (self: &var Checker) collect_enum(tree: &ast::Ast, declaration: &ast::EnumDecl) -> !?TypeCollectionIssue {
    let retained_name = tree.texts.at(declaration.name.node);
    let name = retained_name.as_bytes();
    if self.metadata.has_collected_type(name) {
        return TypeCollectionIssue::DuplicateType(declaration.name);
    }
    var value = EnumType {
        name: declaration.name,
        tags: map::new<[]u8, bool>(self.allocator),
        order: array::new<ast::Text>(self.allocator),
        public: declaration.public
    };
    errdefer value.deinit();
    var index = 0;
    while declaration.tags.at(index) |tag| {
        let retained_tag = tree.texts.at(tag.node);
        let tag_name = retained_tag.as_bytes();
        if value.tags.contains(tag_name) {
            value.deinit();
            let issue = CollectionMemberIssue {
                owner: declaration.name, member: ast::Text { node: tag.node }
            };
            return TypeCollectionIssue::DuplicateEnumTag(issue);
        }
        try value.order.append(ast::Text { node: tag.node });
        try value.tags.insert(tag_name, true);
        index = index + 1;
    }
    let handle = EnumHandle { index: self.metadata.enums.len() };
    try self.metadata.enums.append(move value);
    try self.metadata.enums_by_name.insert(name, handle);
    return null;
}

// Collects one error set declaration. A combined set (`error C = A or B;`)
// is registered here and resolved after every declaration is collected, so
// the sets it names may be declared later in the file.
fn (self: &var Checker) collect_error_set(tree: &ast::Ast, declaration: &ast::ErrorSetDecl) -> !?TypeCollectionIssue {
    let retained_name = tree.texts.at(declaration.name.node);
    let name = retained_name.as_bytes();
    if self.metadata.has_collected_type(name) {
        return TypeCollectionIssue::DuplicateType(declaration.name);
    }
    var tagged = EnumType {
        name: declaration.name,
        tags: map::new<[]u8, bool>(self.allocator),
        order: array::new<ast::Text>(self.allocator),
        public: declaration.public
    };
    errdefer tagged.deinit();
    var index = 0;
    while declaration.members.at(index) |member| {
        let retained_member = tree.texts.at(member.node);
        let member_name = retained_member.as_bytes();
        if tagged.tags.contains(member_name) {
            tagged.deinit();
            let issue = CollectionMemberIssue {
                owner: declaration.name, member: ast::Text { node: member.node }
            };
            return TypeCollectionIssue::DuplicateError(issue);
        }
        try tagged.tags.insert(member_name, true);
        index = index + 1;
    }
    let tagged_handle = EnumHandle { index: self.metadata.enums.len() };
    try self.metadata.enums.append(move tagged);
    var set = ErrorSetType {
        name: declaration.name,
        public: declaration.public,
        tagged: tagged_handle,
        combines: array::new<string::String>(self.allocator),
        values: map::new<[]u8, bool>(self.allocator),
        value_order: array::new<string::String>(self.allocator),
        resolved: declaration.combines.len() == 0
    };
    errdefer set.deinit();
    index = 0;
    while declaration.combines.at(index) |reference| {
        index = index + 1;
        let retained_reference = tree.texts.at(reference.node);
        let reference_bytes = retained_reference.as_bytes();
        let copied = try string::from_bytes(self.allocator, reference_bytes);
        errdefer copied.deinit();
        try set.combines.append(move copied);
    }
    index = 0;
    while declaration.members.at(index) |member| {
        index = index + 1;
        let retained_member = tree.texts.at(member.node);
        let member_name = retained_member.as_bytes();
        var key = string::new(self.allocator);
        errdefer key.deinit();
        try key.append_bytes(name);
        try key.append_bytes("::");
        try key.append_bytes(member_name);
        try set.value_order.append(move key);
    }
    index = 0;
    while set.value_order.at(index) |stored| {
        index = index + 1;
        let key_bytes = stored.as_bytes();
        try set.values.insert(key_bytes, true);
    }
    let set_handle = ErrorSetHandle { index: self.metadata.error_sets.len() };
    try self.metadata.error_sets.append(move set);
    try self.metadata.error_sets_by_name.insert(name, set_handle);
    return null;
}

// Fills in the member values of every combined error set once all
// declarations are collected, the Go `resolveErrorSetCompositions`. The
// union of unions is a union: a set reached through two of its parts
// contributes each value once. Unknown references are refused first, so the
// fixpoint below can only stall on a cycle.
fn (self: &var Checker) resolve_error_set_compositions(tree: &ast::Ast) -> !?diagnostic::Diagnostic {
    var index = 0;
    while index < self.metadata.error_sets.len() {
        if try self.check_error_set_references(tree, index) |problem| {
            return move problem;
        }
        index = index + 1;
    }
    var guard = 0;
    while guard <= self.metadata.error_sets.len() {
        guard = guard + 1;
        var progress = false;
        var stalled = -1;
        var position = 0;
        while position < self.metadata.error_sets.len() {
            var state = 0;
            try self.resolve_error_set_composition(position, &var state);
            if state == 1 {
                progress = true;
            }
            if state == 2 and stalled < 0 {
                stalled = position;
            }
            position = position + 1;
        }
        if stalled < 0 {
            return null;
        }
        if !progress {
            return try self.combined_from_itself_error(tree, stalled);
        }
    }
    return null;
}

// Refuses a combined set whose right side names something that is not a
// declared error set.
fn (self: &Checker) check_error_set_references(tree: &ast::Ast, position: i64) -> !?diagnostic::Diagnostic {
    if self.metadata.error_sets.at(position) |set| {
        var index = 0;
        while set.combines.at(index) |reference| {
            index = index + 1;
            let reference_bytes = reference.as_bytes();
            if !self.metadata.error_sets_by_name.contains(reference_bytes) {
                let retained_name = tree.texts.at(set.name.node);
                let name = retained_name.as_bytes();
                var message = string::new(self.allocator);
                errdefer message.deinit();
                try message.append_bytes("`");
                try message.append_bytes(name);
                try message.append_bytes("` combines `");
                try message.append_bytes(reference_bytes);
                try message.append_bytes("`, which is not a declared error set");
                return try self.checker_message_at("type error", ast::zero_span(), move message);
            }
        }
    }
    return null;
}

// Reports a combined set the fixpoint could not resolve: with unknown
// references already refused, only a cycle stalls it.
fn (self: &Checker) combined_from_itself_error(tree: &ast::Ast, position: i64) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit();
    try message.append_bytes("error set `");
    if self.metadata.error_sets.at(position) |set| {
        let retained_name = tree.texts.at(set.name.node);
        let name = retained_name.as_bytes();
        try message.append_bytes(name);
    }
    try message.append_bytes("` is combined from itself");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

// Resolves one combined set when every set it names is already resolved.
// state reports what happened: 0 already resolved, 1 resolved now, 2 still
// waiting on a part.
fn (self: &var Checker) resolve_error_set_composition(position: i64, state: &var i64) -> !void {
    state.* = 0;
    var ready = true;
    var merged = array::new<string::String>(self.allocator);
    defer merged.deinit();
    var seen = map::new<[]u8, bool>(self.allocator);
    defer seen.deinit();
    if self.metadata.error_sets.at(position) |set| {
        if set.resolved {
            return;
        }
        var index = 0;
        while set.combines.at(index) |reference| {
            index = index + 1;
            let reference_bytes = reference.as_bytes();
            if self.metadata.error_sets_by_name.get(reference_bytes) |handle| {
                if self.metadata.error_sets.at(handle.index) |part| {
                    if !part.resolved {
                        ready = false;
                        break;
                    }
                    var order = 0;
                    while part.value_order.at(order) |value| {
                        order = order + 1;
                        let value_bytes = value.as_bytes();
                        if seen.contains(value_bytes) {
                            continue;
                        }
                        try seen.insert(value_bytes, true);
                        let copied = try string::from_bytes(self.allocator, value_bytes);
                        errdefer copied.deinit();
                        try merged.append(move copied);
                    }
                }
            }
        }
    } else {
        return;
    }
    if !ready {
        state.* = 2;
        return;
    }
    // The value set fills from borrows first; the spellings then move in,
    // reversed twice so the writes land in part order.
    if self.metadata.error_sets.at_mut(position) |slot| {
        var index = 0;
        while merged.at(index) |value| {
            index = index + 1;
            let value_bytes = value.as_bytes();
            try slot.values.insert(value_bytes, true);
        }
    }
    var reversed = array::new<string::String>(self.allocator);
    errdefer reversed.deinit();
    while merged.pop() |value| {
        errdefer value.deinit();
        try reversed.append(move value);
    }
    if self.metadata.error_sets.at_mut(position) |slot| {
        while reversed.pop() |value| {
            errdefer value.deinit();
            try slot.value_order.append(move value);
        }
        slot.resolved = true;
    }
    reversed.deinit();
    state.* = 1;
    return;
}
