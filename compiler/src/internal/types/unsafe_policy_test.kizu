import compiler::internal::ast;
import compiler::internal::source;
import std::testing;

fn unsafe_policy_span(index: i64) -> ast::Span {
    return ast::Span {
        source: source::SourceId { index: index },
        start: ast::Position { line: 1, column: 1 },
        end: ast::Position { line: 1, column: 2 }
    };
}

test "unsafe struct policy separates marker and file requirements" {
    let declaration = unsafe_policy_span(1);
    let same_file = unsafe_policy_span(1);
    let other_file = unsafe_policy_span(2);
    testing::expect(
        unsafe_struct_invariant_requirement(
            false,
            true,
            declaration,
            same_file
        ) == UnsafeInvariantRequirement::None
    );
    testing::expect(
        unsafe_struct_invariant_requirement(
            true,
            false,
            declaration,
            same_file
        ) == UnsafeInvariantRequirement::None
    );
    testing::expect(
        unsafe_struct_invariant_requirement(
            true,
            true,
            declaration,
            same_file
        ) == UnsafeInvariantRequirement::Marker
    );
    testing::expect(
        unsafe_struct_invariant_requirement(
            true,
            true,
            declaration,
            other_file
        ) == UnsafeInvariantRequirement::FileBoundary
    );
}

test "unsafe obligation policy distinguishes missing documentation" {
    testing::expect(obligation_doc_missing(true, ""));
    testing::expect(!obligation_doc_missing(true, "documented"));
    testing::expect(!obligation_doc_missing(false, ""));
}
