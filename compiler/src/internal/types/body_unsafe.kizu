import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::unsafecap;
import std::string;

// Rejects an unproven operation when no source unsafe marker covers it.
fn (self: &var Checker) require_unsafe_capability_at(
    capability: UnsafeCapability,
    operation: []u8,
    span: ast::Span
) -> !?diagnostic::Diagnostic {
    if use_unsafe_mark(&var self.mark) {
        return null;
    }
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, operation);
    try message.append_bytes(self.allocator, " requires `unsafe`");
    var problem = try self.checker_message_at("unsafe error", span, move message);
    errdefer problem.deinit(self.allocator);
    if !span.is_zero() {
        try problem.with_code(self.allocator, "unsafe.missing_marker");
    }
    let capability_name = unsafe_capability_name(capability);
    if unsafecap::lookup(capability_name) |info| {
        let help = try unsafecap::hint(self.allocator, &info);
        defer help.deinit(self.allocator);
        let text = help.as_bytes();
        try problem.with_help(self.allocator, text);
    }
    return move problem;
}
