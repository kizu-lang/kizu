import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::unsafecap;
import std::string;

// Rejects an unproven operation when no source unsafe marker covers it.
fn (self: &Checker) require_unsafe_capability_at(
    mark: &var UnsafeMark,
    capability: UnsafeCapability,
    operation: []u8,
    span: ast::Span
) -> !?diagnostic::Diagnostic {
    if use_unsafe_mark(mark) {
        return null;
    }
    var message = string::new(self.allocator);
    errdefer message.deinit();
    try message.append_bytes(operation);
    try message.append_bytes(" requires `unsafe`");
    var problem = try self.checker_message_at(
        "unsafe error", span, move message
    );
    errdefer problem.deinit();
    if !span.is_zero() {
        try problem.with_code("unsafe.missing_marker");
    }
    let capability_name = unsafe_capability_name(capability);
    if unsafecap::lookup(capability_name) |info| {
        let help = try unsafecap::hint(self.allocator, &info);
        defer help.deinit();
        let text = help.as_bytes();
        try problem.with_help(text);
    }
    return move problem;
}
