import compiler::internal::types;
import compiler::internal::unsafecap;
import std::array;
import std::mem;
import std::testing;

fn expect_capability_name(
    capability: types::UnsafeCapability,
    expected: []u8
) -> void {
    let name = types::unsafe_capability_name(capability);
    testing::expect_equal<[]u8>(expected, name);
    if unsafecap::lookup(name) |_| {} else {
        testing::fail("checker unsafe capability is missing metadata");
    }
    return;
}

test "unsafe capability names have exact metadata coverage" {
    let allocator = mem::page_allocator();
    var capabilities = array::new<types::UnsafeCapability>(allocator);
    defer capabilities.deinit();
    try capabilities.append(types::UnsafeCapability::PtrRead);
    try capabilities.append(types::UnsafeCapability::PtrWrite);
    try capabilities.append(types::UnsafeCapability::PtrDeref);
    try capabilities.append(types::UnsafeCapability::PtrCast);
    try capabilities.append(types::UnsafeCapability::PtrIntCast);
    try capabilities.append(types::UnsafeCapability::ExternCall);
    try capabilities.append(types::UnsafeCapability::UnsafeCall);
    try capabilities.append(types::UnsafeCapability::StructInvariant);
    try capabilities.append(types::UnsafeCapability::Volatile);
    expect_capability_name(types::UnsafeCapability::PtrRead, "ptr_read");
    expect_capability_name(types::UnsafeCapability::PtrWrite, "ptr_write");
    expect_capability_name(types::UnsafeCapability::PtrDeref, "ptr_deref");
    expect_capability_name(types::UnsafeCapability::PtrCast, "ptr_cast");
    expect_capability_name(
        types::UnsafeCapability::PtrIntCast,
        "ptr_int_cast"
    );
    expect_capability_name(types::UnsafeCapability::ExternCall, "extern_call");
    expect_capability_name(types::UnsafeCapability::UnsafeCall, "unsafe_call");
    expect_capability_name(
        types::UnsafeCapability::StructInvariant,
        "struct_invariant"
    );
    expect_capability_name(types::UnsafeCapability::Volatile, "volatile");
    let metadata = try unsafecap::all(allocator);
    defer metadata.deinit();
    testing::expect_equal<i64>(capabilities.len(), metadata.len());
}

test "unsafe marker use mutates only the explicit current state" {
    var unmarked = types::UnsafeMark { used: null };
    testing::expect(!types::use_unsafe_mark(&var unmarked));
    if unmarked.used |_| {
        testing::fail("unmarked checker state became present");
    }
    var outer = types::UnsafeMark { used: false };
    var inner = types::UnsafeMark { used: false };
    testing::expect(!(outer.used orelse true));
    testing::expect(!(inner.used orelse true));
    testing::expect(types::use_unsafe_mark(&var inner));
    testing::expect(!(outer.used orelse true));
    testing::expect(inner.used orelse false);
}
