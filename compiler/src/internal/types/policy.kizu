import compiler::internal::typ;

// Mechanical port of the declaration policy decisions in
// internal/types/policy.go. The checker that owns the surrounding source
// context turns a reported violation into its structured diagnostic.

/// Finds the first Function static parameter reserved for std wrappers.
pub fn reserved_function_static_param_index(
    table: &TypeTable,
    signature: &FunctionSignatureType
) -> ?i64 {
    if signature.std {
        return null;
    }
    var index = 0;
    while signature.static_params.at(index) |param| {
        if table.is_text(param.type_name, "Function") {
            return index;
        }
        index = index + 1;
    }
    return null;
}

/// Reports whether a type contains Function or Field compile-time tokens.
pub fn compile_time_only_type(table: &TypeTable, value: Type) -> bool {
    return table.contains_compile_time_only(value);
}

/// Reports whether a raw-pointer field requires an unsafe struct declaration.
pub fn raw_pointer_field_requires_unsafe(
    table: &TypeTable,
    requires_unsafe: bool,
    field_type: Type
) -> bool {
    return !requires_unsafe and table.contains_raw_pointer(field_type);
}

/// Reports whether a union payload is structurally a borrow.
pub fn is_borrow_payload(table: &typ::Table, payload: typ::Type) -> bool {
    return match typ::root_node(table, payload) {
        Borrow(_) => true,
        _ => false,
    };
}
