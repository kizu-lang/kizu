import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::typ;
import std::array;
import std::map;
import std::mem;
import std::string;

fn (self: &var Checker) check_let_value_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::LetStmt,
    out: &var Type
) -> !bool {
    let declared = statement.type_name orelse return self.check_expr_ok(tree, scope, statement.value, out);
    var want = empty_type();
    if try self.let_declared_type_text(tree, statement, declared, &var want) |problem| {
        return self.fail(move problem);
    }
    var got = empty_type();
    if try self.check_contextual_expr_ok(tree, scope, statement.value, want, &var got) {
        return true;
    }
    if !same_type(got, want) {
        let mismatch_name = semantic_text(tree, statement.name);
        let problem = try self.let_declared_mismatch(tree, statement, mismatch_name, want, got);
        return self.fail(move problem);
    }
    out.* = want;
    return false;
}

fn (self: &var Checker) let_declared_type_text(
    tree: &var ast::Ast,
    statement: &ast::LetStmt,
    declared: typ::Type,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let owned_name = try string::from_bytes(self.allocator, semantic_text(tree, statement.name));
    defer owned_name.deinit(self.allocator);
    let name = owned_name.as_bytes();
    return self.let_declared_type(tree, statement, name, declared, out);
}

fn (self: &var Checker) let_declared_type(
    tree: &var ast::Ast,
    statement: &ast::LetStmt,
    name: []u8,
    declared: typ::Type,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if declares_borrow(tree, declared) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, "` cannot declare a borrow type; a borrow comes from a `&` initializer");
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    match try self.resolve_type_node(self.allocator, tree, statement.type_name) {
        Value(value) => {
            out.* = value;
        },
        Issue(issue) => return try self.type_resolution_diagnostic(issue),
    }
    return null;
}

fn declares_borrow(tree: &ast::Ast, declared: typ::Type) -> bool {
    return match typ::root_node(&tree.types, declared) {
        Borrow(_) => true,
        _ => false,
    };
}

fn (self: &var Checker) check_let_declared_against_binding(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::LetStmt,
    name: []u8
) -> !?diagnostic::Diagnostic {
    let declared = statement.type_name orelse return null;
    var want = empty_type();
    if try self.let_declared_type(tree, statement, name, declared, &var want) |problem| {
        return move problem;
    }
    let got = self.scopes.lookup(scope, name) orelse empty_type();
    if !same_type(got, want) {
        return try self.let_declared_mismatch(tree, statement, name, want, got);
    }
    return null;
}

fn (self: &var Checker) let_declared_mismatch(
    tree: &ast::Ast,
    statement: &ast::LetStmt,
    name: []u8,
    want: Type,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` is declared ");
    try self.append_checker_type(&var message, want);
    try message.append_bytes(self.allocator, ", got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", expression_span(tree, statement.value), move message);
}

fn (self: &var Checker) check_let_stmt_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::LetStmt,
    out: &var bool
) -> !bool {
    if try self.check_let_binding_ok(tree, scope, statement, out) {
        return true;
    }
    let name = semantic_text(tree, statement.name);
    self.scopes.declare_local(scope, name, expression_span(tree, statement.value));
    if self.editor.len() > 0 {
        var inferred = true;
        if statement.type_name |_| {
            inferred = false;
        }
        try self.record_binding(scope, name, tree.text_span(statement.name), false, inferred);
    }
    return false;
}

fn (self: &var Checker) check_let_binding_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::LetStmt,
    out: &var bool
) -> !bool {
    out.* = false;
    let maybe_special = match tree.expressions.at(statement.value.node) {
        Prefix(_) => true,
        Call(_) => true,
        Unsafe(_) => true,
        _ => false,
    };
    if maybe_special {
        let owned_name = try string::from_bytes(self.allocator, semantic_text(tree, statement.name));
        defer owned_name.deinit(self.allocator);
        let name = owned_name.as_bytes();
        var handled = false;
        if try self.define_special_let_initializer(
            tree, scope, statement, name, &var handled
        ) |problem| {
            return self.fail(move problem);
        }
        if handled {
            if statement.type_name |_| {
                if try self.check_let_declared_against_binding(tree, scope, statement, name) |problem| {
                    return self.fail(move problem);
                }
            }
            return false;
        }
    }
    var value_type = empty_type();
    if try self.check_let_value_ok(tree, scope, statement, &var value_type) {
        return true;
    }
    if self.types.contains_type_value(value_type) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "type value cannot be stored in local `");
        try message.append_bytes(self.allocator, semantic_text(tree, statement.name));
        try message.append_byte(self.allocator, cast<u8>(96));
        let problem = try self.checker_message_at("type error", ast::zero_span(), move message);
        return self.fail(move problem);
    }
    if try self.types.explicit_borrow_type(value_type) |parts| {
        let owned_name = try string::from_bytes(self.allocator, semantic_text(tree, statement.name));
        defer owned_name.deinit(self.allocator);
        let owned_bytes = owned_name.as_bytes();
        var sources = array::new<string::String>(self.allocator);
        errdefer sources.deinit(self.allocator);
        try self.expr_borrow_source_list(tree, scope, statement.value, &var sources);
        let defined = try self.scopes.define_param_with_source(
            scope, owned_bytes, parts.inner, true, parts.mutable, move sources, false
        );
        if try self.require_scope_definition(owned_bytes, defined) |problem| {
            return self.fail(move problem);
        }
        return false;
    }
    if self.types.is_borrowed_view_return_fast(value_type) {
        let owned_name = try string::from_bytes(self.allocator, semantic_text(tree, statement.name));
        defer owned_name.deinit(self.allocator);
        let owned_bytes = owned_name.as_bytes();
        var sources = array::new<string::String>(self.allocator);
        errdefer sources.deinit(self.allocator);
        try self.expr_borrow_source_list(tree, scope, statement.value, &var sources);
        if sources.len() > 0 {
            let defined = try self.scopes.define_with_source(
                scope, owned_bytes, value_type, statement.mutable, move sources
            );
            if try self.require_scope_definition(owned_bytes, defined) |problem| {
                return self.fail(move problem);
            }
            return false;
        }
        sources.deinit(self.allocator);
    }
    let name = semantic_text(tree, statement.name);
    let defined = try self.scopes.define(scope, name, value_type, statement.mutable);
    if !defined {
        if try self.require_scope_definition(name, false) |problem| {
            return self.fail(move problem);
        }
        return false;
    }
    return false;
}

fn (self: &var Checker) define_special_let_initializer(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::LetStmt,
    name: []u8,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = true;
    match borrow_prefix(tree, statement.value) {
        Value(borrow) => {
            var value_type = empty_type();
            var mutable = false;
            if try self.check_borrow_prefix(
                tree,
                scope,
                &borrow,
                &var value_type,
                &var mutable
            ) |problem| {
                return move problem;
            }
            var sources = array::new<string::String>(self.allocator);
            errdefer sources.deinit(self.allocator);
            try self.expr_borrow_source_list(tree, scope, borrow.right, &var sources);
            let defined = try self.scopes.define_param_with_source(
                scope, name, value_type, true, mutable, move sources, false
            );
            return self.require_scope_definition(name, defined);
        },
        None => {},
    }
    var value_type = empty_type();
    var mutable = false;
    var box_handled = false;
    if try self.check_box_borrow_initializer(
        tree,
        scope,
        statement.value,
        &var value_type,
        &var mutable,
        &var box_handled
    ) |problem| {
        return move problem;
    }
    if box_handled {
        let defined = try self.define_scope_param(scope, name, value_type, true, mutable, false);
        return self.require_scope_definition(name, defined);
    }
    var sources = array::new<string::String>(self.allocator);
    errdefer sources.deinit(self.allocator);
    var view_handled = false;
    var view_type = empty_type();
    if try self.check_string_view_initializer(
        tree,
        scope,
        statement.value,
        &var sources,
        &var view_type,
        &var mutable,
        &var view_handled
    ) |problem| {
        sources.deinit(self.allocator);
        return move problem;
    }
    if view_handled {
        let defined = try self.scopes.define_param_with_source(
            scope, name, view_type, true, mutable, move sources, false
        );
        return self.require_scope_definition(name, defined);
    }
    sources.deinit(self.allocator);
    var raw_handled = false;
    var raw_view = empty_type();
    if try self.check_marked_raw_view_initializer(
        tree,
        scope,
        statement.value,
        &var raw_view,
        &var mutable,
        &var raw_handled
    ) |problem| {
        return move problem;
    }
    if raw_handled {
        let defined = try self.define_scope_param(scope, name, raw_view, true, mutable, false);
        return self.require_scope_definition(name, defined);
    }
    var pointee = empty_type();
    if try self.check_raw_pointer_borrow_initializer(
        tree,
        scope,
        statement.value,
        &var pointee,
        &var mutable,
        &var raw_handled
    ) |problem| {
        return move problem;
    }
    if raw_handled {
        let defined = try self.define_scope_param(scope, name, pointee, true, mutable, false);
        return self.require_scope_definition(name, defined);
    }
    handled.* = false;
    return null;
}

fn (self: &var Checker) check_raw_pointer_borrow_initializer(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    pointee_out: &var Type,
    mutable_out: &var bool,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    var marker: ?ast::UnsafeExpr = null;
    var inner = expression;
    match tree.expressions.at(expression.node) {
        Unsafe(value) => {
            inner = value.value;
            marker = ast::UnsafeExpr { value: value.value, span: value.span };
        },
        _ => {},
    }
    let unsafe_marker = marker orelse return null;
    var borrow_parts: ?ast::PrefixExpr = null;
    match borrow_prefix(tree, inner) {
        Value(borrow) => {
            borrow_parts = borrow;
        },
        None => {},
    }
    let borrow = borrow_parts orelse return null;
    var deref_parts: ?ast::DerefExpr = null;
    match tree.expressions.at(borrow.right.node) {
        Deref(value) => {
            deref_parts = ast::DerefExpr {
                receiver: value.receiver,
                operator_span: value.operator_span
            };
        },
        _ => {},
    }
    let deref = deref_parts orelse return null;
    handled.* = true;
    let retained = tree.texts.at(borrow.operator.node);
    let operator = retained.as_bytes();
    let mutable = mem::equal_bytes(operator, "&var");
    mutable_out.* = mutable;
    let saved_mark = self.mark;
    self.mark = UnsafeMark { used: false };
    if try self.check_raw_pointer_borrow_target(tree, scope, &deref, mutable, pointee_out) |problem| {
        self.mark = saved_mark;
        return move problem;
    }
    let inner_mark = self.mark;
    self.mark = saved_mark;
    return self.check_under_mark(&unsafe_marker, &inner_mark);
}

fn (self: &var Checker) check_raw_pointer_borrow_target(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    deref: &ast::DerefExpr,
    mutable: bool,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var pointer = empty_type();
    if try self.check_expr(tree, scope, deref.receiver, &var pointer) |problem| {
        return move problem;
    }
    if !self.types.is_pointer_type(pointer) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try self.append_checker_type(&var message, pointer);
        try message.append_bytes(self.allocator, "` is not a raw pointer; `&var x.*` borrows through one");
        return try self.checker_message_at(
            "type error", expression_span(tree, deref.receiver), move message
        );
    }
    if try self.require_unsafe_capability_at(
        UnsafeCapability::PtrDeref,
        "raw pointer borrow",
        deref.operator_span
    ) |problem| {
        return move problem;
    }
    if mutable {
        match try self.types.assignable_raw_pointer_deref_type(pointer) {
            Value(value) => {
                out.* = value;
                return null;
            },
            Error(reason) => return try self.pointer_deref_error(pointer, reason, true),
        }
    }
    match try self.types.raw_pointer_deref_type(pointer) {
        Value(value) => {
            out.* = value;
            return null;
        },
        Error(reason) => return try self.pointer_deref_error(pointer, reason, false),
    }
}

fn (self: &var Checker) check_marked_raw_view_initializer(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    view_out: &var Type,
    mutable_out: &var bool,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    var inner = expression;
    var marker: ?ast::UnsafeExpr = null;
    match tree.expressions.at(expression.node) {
        Unsafe(value) => {
            inner = value.value;
            marker = ast::UnsafeExpr { value: value.value, span: value.span };
        },
        _ => {},
    }
    var call_parts: ?ast::CallExpr = null;
    match tree.expressions.at(inner.node) {
        Call(value) => {
            call_parts = ast::CallExpr { callee: value.callee, args: value.args };
        },
        _ => {},
    }
    let call = call_parts orelse return null;
    let unsafe_marker = marker orelse
        return self.check_raw_view_initializer(tree, scope, &call, view_out, mutable_out, handled);
    let saved_mark = self.mark;
    self.mark = UnsafeMark { used: false };
    if try self.check_raw_view_initializer(tree, scope, &call, view_out, mutable_out, handled) |problem| {
        self.mark = saved_mark;
        return move problem;
    }
    let inner_mark = self.mark;
    self.mark = saved_mark;
    if !handled.* {
        return null;
    }
    return self.check_under_mark(&unsafe_marker, &inner_mark);
}

struct FieldCallParts {
    field: ast::FieldExpr,
    args: ast::ExpressionList,
}

fn field_call_parts(tree: &ast::Ast, expression: ast::Expression) -> ?FieldCallParts {
    match tree.expressions.at(expression.node) {
        Call(call) => {
            let callee = call.callee;
            let args = call.args;
            match tree.expressions.at(callee.node) {
                Field(field) => return FieldCallParts {
                    field: ast::FieldExpr {
                        receiver: field.receiver,
                        name: field.name,
                        namespace: field.namespace,
                        span: field.span
                    },
                    args: args
                },
                _ => return null,
            }
        },
        _ => return null,
    }
}

fn (self: &var Checker) check_box_borrow_initializer(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type,
    mutable_out: &var bool,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    let parts = field_call_parts(tree, expression) orelse return null;
    let retained = tree.texts.at(parts.field.name.node);
    let source_name = retained.as_bytes();
    let owned_name = try string::from_bytes(self.allocator, source_name);
    defer owned_name.deinit(self.allocator);
    let name = owned_name.as_bytes();
    if !mem::equal_bytes(name, "borrow") and
        !mem::equal_bytes(name, "borrow_mut") {
        return null;
    }
    handled.* = true;
    var receiver = empty_type();
    if try self.check_expr(tree, scope, parts.field.receiver, &var receiver) |problem| {
        return move problem;
    }
    let receiver_text = try self.types.copy_text(self.allocator, receiver);
    defer receiver_text.deinit(self.allocator);
    let receiver_name = receiver_text.as_bytes();
    var elem = empty_type();
    var is_box = false;
    if split_generic_type(receiver_name) |generic| {
        if mem::equal_bytes(generic.base, "std::mem::Box") {
            is_box = true;
            elem = try self.types.intern(generic.args);
        }
    }
    var method = string::new(self.allocator);
    defer method.deinit(self.allocator);
    try method.append_bytes(self.allocator, "Box.");
    try method.append_bytes(self.allocator, name);
    let method_name = method.as_bytes();
    if !is_box {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try message.append_bytes(self.allocator, method_name);
        try message.append_bytes(self.allocator, "` expects Box receiver");
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    if parts.args.len(tree) != 0 {
        return try self.named_arity_error(method_name, 0, parts.args.len(tree));
    }
    let mutable = mem::equal_bytes(name, "borrow_mut");
    if mutable {
        let writable = try self.box_borrow_mut_receiver_is_mutable(
            tree, scope, parts.field.receiver
        );
        if !writable {
            return try self.checker_error_at(
                "type error",
                ast::zero_span(),
                "`Box.borrow_mut` requires mutable Box receiver"
            );
        }
    }
    out.* = elem;
    mutable_out.* = mutable;
    return null;
}

fn (self: &Checker) box_borrow_mut_receiver_is_mutable(
    tree: &ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression
) -> !bool {
    if try mutable_place_base(self.allocator, tree, expression) |base| {
        let retained = tree.texts.at(base.name.node);
        let name = retained.as_bytes();
        return self.scopes.is_mutable(scope, name);
    }
    return false;
}

fn (self: &var Checker) check_string_view_initializer(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    sources: &var array::Array<string::String>,
    view_out: &var Type,
    mutable_out: &var bool,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    let parts = field_call_parts(tree, expression) orelse return null;
    let retained = tree.texts.at(parts.field.name.node);
    let source_name = retained.as_bytes();
    let owned_name = try string::from_bytes(self.allocator, source_name);
    defer owned_name.deinit(self.allocator);
    let name = owned_name.as_bytes();
    if !is_view_method_name(name) {
        return null;
    }
    handled.* = true;
    let mutable = mem::equal_bytes(name, "as_mut_bytes") or mem::equal_bytes(name, "as_mut_slice");
    mutable_out.* = mutable;
    var receiver = empty_type();
    if try self.check_expr(tree, scope, parts.field.receiver, &var receiver) |problem| {
        return move problem;
    }
    let is_buffer = self.types.is_buffer_type(receiver);
    if try self.view_of_receiver(tree, receiver, name, view_out) |problem| {
        return move problem;
    }
    var kind = "Array";
    if is_buffer {
        kind = "buffer";
    } else if self.types.is_text(receiver, "std::string::String") {
        kind = "String";
    }
    if parts.args.len(tree) != 0 {
        var method = string::new(self.allocator);
        defer method.deinit(self.allocator);
        try method.append_bytes(self.allocator, kind);
        try method.append_byte(self.allocator, cast<u8>(46));
        try method.append_bytes(self.allocator, name);
        let method_name = method.as_bytes();
        return try self.named_arity_error(method_name, 0, parts.args.len(tree));
    }
    if mutable {
        var writable = false;
        if try mutable_place_base(self.allocator, tree, parts.field.receiver) |place| {
            let retained_place = tree.texts.at(place.name.node);
            let place_name = retained_place.as_bytes();
            writable = self.scopes.is_mutable(scope, place_name) or
                self.scopes.is_mut_borrowed(scope, place_name);
        }
        if !writable {
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            try message.append_byte(self.allocator, cast<u8>(96));
            try message.append_bytes(self.allocator, kind);
            try message.append_byte(self.allocator, cast<u8>(46));
            try message.append_bytes(self.allocator, name);
            try message.append_bytes(self.allocator, "` requires mutable ");
            try message.append_bytes(self.allocator, kind);
            try message.append_bytes(self.allocator, " binding");
            return try self.checker_message_at("type error", ast::zero_span(), move message);
        }
    }
    try self.expr_borrow_source_list(tree, scope, parts.field.receiver, sources);
    return null;
}

fn is_view_method_name(name: []u8) -> bool {
    return mem::equal_bytes(name, "as_bytes") or mem::equal_bytes(name, "as_mut_bytes") or
        mem::equal_bytes(name, "as_slice") or mem::equal_bytes(name, "as_mut_slice");
}

fn (self: &var Checker) view_of_receiver(
    tree: &ast::Ast,
    receiver: Type,
    method: []u8,
    view_out: &var Type
) -> !?diagnostic::Diagnostic {
    let bytes = mem::equal_bytes(method, "as_bytes") or mem::equal_bytes(method, "as_mut_bytes");
    if self.types.is_text(receiver, "std::string::String") {
        if !bytes {
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, "`String` has no `");
            try message.append_bytes(self.allocator, method);
            try message.append_bytes(self.allocator, "`; its view is `as_bytes`");
            return try self.checker_message_at("type error", ast::zero_span(), move message);
        }
        view_out.* = try self.types.byte_string_type();
        return null;
    }
    let receiver_text = try self.types.copy_text(self.allocator, receiver);
    defer receiver_text.deinit(self.allocator);
    let receiver_bytes = receiver_text.as_bytes();
    if split_generic_type(receiver_bytes) |parts| {
        if mem::equal_bytes(parts.base, "std::array::Array") {
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            let elem = try self.types.intern(parts.args);
            let view_elem = try self.is_view_elem(tree, elem);
            let byte_elem = mem::equal_bytes(parts.args, "u8");
            if bytes or byte_elem or !view_elem {
                try message.append_byte(self.allocator, cast<u8>(96));
                try self.append_checker_type(&var message, receiver);
                try message.append_bytes(self.allocator, "` has no `");
                try message.append_bytes(self.allocator, method);
                if byte_elem {
                    try message.append_bytes(self.allocator, "`; bytes are owned by `std::string::String`, whose view is `as_bytes`");
                } else if view_elem {
                    try message.append_bytes(self.allocator, "`; an Array of copy data is viewed with `as_slice`");
                } else {
                    try message.append_bytes(self.allocator, "`; `as_slice` views an Array of copy data other than u8");
                }
                return try self.checker_message_at("type error", ast::zero_span(), move message);
            }
            message.deinit(self.allocator);
            view_out.* = try self.types.slice_of(elem);
            return null;
        }
    }
    let elem = try self.types.buffer_elem(receiver) orelse
        return try self.view_receiver_error(method);
    let elem_is_bytes = self.types.is_text(elem, "u8");
    if bytes != elem_is_bytes {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try self.append_checker_type(&var message, receiver);
        try message.append_bytes(self.allocator, "` has no `");
        try message.append_bytes(self.allocator, method);
        if bytes {
            try message.append_bytes(self.allocator, "`; a buffer of ");
            try self.append_checker_type(&var message, elem);
            try message.append_bytes(self.allocator, " is viewed with `as_slice`");
        } else {
            try message.append_bytes(self.allocator, "`; a buffer of u8 is viewed with `as_bytes`");
        }
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    view_out.* = try self.types.slice_of(elem);
    return null;
}

fn (self: &Checker) view_receiver_error(method: []u8) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, method);
    try message.append_bytes(self.allocator, "` expects String, stack buffer, or Array receiver");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_assign_stmt_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::AssignStmt,
    out: &var bool
) -> !bool {
    var want = empty_type();
    if try self.check_assignable_target_ok(tree, scope, statement.target, &var want) {
        return true;
    }
    var got = empty_type();
    if try self.check_contextual_expr_ok(tree, scope, statement.value, want, &var got) {
        return true;
    }
    if !same_type(got, want) {
        let rendered = try ast::render_expression(self.allocator, tree, statement.target);
        defer rendered.deinit(self.allocator);
        let target = rendered.as_bytes();
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "assignment to `");
        try message.append_bytes(self.allocator, target);
        try message.append_bytes(self.allocator, "` expects ");
        try self.append_checker_type(&var message, want);
        try message.append_bytes(self.allocator, ", got ");
        try self.append_checker_type(&var message, got);
        let problem = try self.checker_message_at(
            "type error",
            expression_span(tree, statement.target),
            move message
        );
        return self.fail(move problem);
    }
    out.* = false;
    return false;
}

fn (self: &var Checker) check_assignable_target(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if try self.check_assignable_target_ok(tree, scope, expression, out) {
        return self.take_failure();
    }
    return null;
}

fn (self: &var Checker) check_assignable_target_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type
) -> !bool {
    match tree.expressions.at(expression.node) {
        Ident(value) => {
            let copied = ast::IdentExpr {
                name: value.name, span: value.span
            };
            return self.check_assignable_ident_ok(tree, scope, &copied, out);
        },
        Field(value) => {
            let copied = ast::FieldExpr {
                receiver: value.receiver,
                name: value.name,
                namespace: value.namespace,
                span: value.span
            };
            return self.check_assignable_field_ok(tree, scope, expression, &copied, out);
        },
        Deref(value) => {
            let copied = ast::DerefExpr {
                receiver: value.receiver,
                operator_span: value.operator_span
            };
            if try self.check_assignable_deref(tree, scope, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Index(value) => {
            let copied = ast::IndexExpr {
                target: value.target,
                index: value.index,
                start: value.start,
                end: value.end,
                slice: value.slice,
                span: value.span
            };
            if try self.check_assignable_index(tree, scope, expression, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Unsafe(value) => {
            let copied = ast::UnsafeExpr {
                value: value.value,
                span: value.span
            };
            let saved_mark = self.mark;
            self.mark = UnsafeMark { used: false };
            if try self.check_assignable_target_ok(tree, scope, copied.value, out) {
                self.mark = saved_mark;
                return true;
            }
            let inner_used = self.mark.used;
            self.mark = saved_mark;
            if try self.unsafe_marker_coverage(&copied, inner_used) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        _ => {
            let problem = try self.invalid_assignment_target_error(tree, expression);
            return self.fail(move problem);
        },
    }
}

fn (self: &Checker) unsafe_marker_coverage(
    expression: &ast::UnsafeExpr,
    used: ?bool
) -> !?diagnostic::Diagnostic {
    if !(used orelse false) {
        var failure = try self.checker_error_at(
            "unsafe error", expression.span,
            "`unsafe` covers no operation that needs it"
        );
        errdefer failure.deinit(self.allocator);
        try failure.with_code(self.allocator, "unsafe.unused_marker");
        try failure.with_help(self.allocator, "remove `unsafe`");
        return move failure;
    }
    return null;
}

fn (self: &Checker) invalid_assignment_target_error(
    tree: &ast::Ast,
    expression: ast::Expression
) -> !diagnostic::Diagnostic {
    let rendered = try ast::render_expression(self.allocator, tree, expression);
    defer rendered.deinit(self.allocator);
    let target = rendered.as_bytes();
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "invalid assignment target `");
    try message.append_bytes(self.allocator, target);
    try message.append_byte(self.allocator, cast<u8>(96));
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_assignable_index(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    index: &ast::IndexExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if index.slice {
        return try self.invalid_assignment_target_error(tree, expression);
    }
    var array = empty_type();
    if try self.assignable_array_place(tree, scope, index.target, &var array) {
        return self.check_array_index(tree, scope, index, array, out);
    }
    var target = empty_type();
    if try self.check_expr(tree, scope, index.target, &var target) |problem| {
        problem.deinit(self.allocator);
    } else {
        let held = try self.types.borrowed_value_type(target);
        if try self.types.buffer_elem(held) |_| {
            var written = empty_type();
            if try self.check_assignable_target(tree, scope, index.target, &var written) |problem| {
                return move problem;
            }
        }
    }
    var elem = empty_type();
    match tree.expressions.at(index.target.node) {
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let name = retained.as_bytes();
            let target = self.scopes.lookup(scope, name) orelse
                return try self.unknown_local_error(name);
            let found = try self.types.slice_elem(target) orelse
                return try self.index_assign_error(name);
            if !self.scopes.is_mut_borrowed(scope, name) {
                return try self.index_assign_error(name);
            }
            if self.editor.len() > 0 {
                let selection = self.scopes.selection(scope, name);
                try self.record_reference(tree.text_span(identifier.name), selection, false);
            }
            elem = found;
        },
        _ => return try self.checker_error_at(
            "type error",
            ast::zero_span(),
            "indexed assignment target must be a local `&var []T` binding or a writable array"
        ),
    }
    if try self.check_index_bound(tree, scope, "index", index.index) |problem| {
        return move problem;
    }
    out.* = elem;
    return null;
}

fn (self: &var Checker) assignable_array_place(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type
) -> !bool {
    var place = empty_type();
    match tree.expressions.at(expression.node) {
        Index(value) => {
            let copied = ast::IndexExpr {
                target: value.target,
                index: value.index,
                start: value.start,
                end: value.end,
                slice: value.slice,
                span: value.span
            };
            if try self.check_assignable_index(tree, scope, expression, &copied, &var place) |problem| {
                problem.deinit(self.allocator);
                return false;
            }
        },
        _ => {
            var written = empty_type();
            if try self.check_assignable_target(tree, scope, expression, &var written) |problem| {
                problem.deinit(self.allocator);
                return false;
            }
            place = try self.types.borrowed_value_type(written);
        },
    }
    if try self.types.buffer_elem(place) |_| {
        out.* = place;
        return true;
    }
    return false;
}

fn (self: &Checker) index_assign_error(name: []u8) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator,
        "indexed assignment requires a writable slice view (`&var []T`), `"
    );
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` is not one");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) unknown_local_error(name: []u8) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "unknown local `");
    try message.append_bytes(self.allocator, name);
    try message.append_byte(self.allocator, cast<u8>(96));
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_assignable_ident_ok(
    tree: &ast::Ast,
    scope: ScopeHandle,
    expression: &ast::IdentExpr,
    out: &var Type
) -> !bool {
    let retained = tree.texts.at(expression.name.node);
    let name = retained.as_bytes();
    var want = empty_type();
    if self.scopes.lookup(scope, name) |resolved| {
        want = resolved;
        if self.editor.len() > 0 {
            let selection = self.scopes.selection(scope, name);
            let is_write_only = !self.scopes.is_mut_borrowed(scope, name);
            try self.record_reference(tree.text_span(expression.name), selection, is_write_only);
        }
    } else {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "undefined variable `");
        try message.append_bytes(self.allocator, name);
        try message.append_byte(self.allocator, cast<u8>(96));
        let problem = try self.checker_message_at("type error", expression.span, move message);
        return self.fail(move problem);
    }
    var writable = false;
    if self.scopes.binding_facts(scope, name) |facts| {
        writable = facts.mutable or (facts.mut_borrow and facts.signature_param);
    }
    if !writable {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "cannot assign to immutable binding `");
        try message.append_bytes(self.allocator, name);
        try message.append_byte(self.allocator, cast<u8>(96));
        let problem = try self.checker_message_at("type error", ast::zero_span(), move message);
        return self.fail(move problem);
    }
    out.* = want;
    return false;
}

fn (self: &var Checker) check_assignable_field_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    field: &ast::FieldExpr,
    out: &var Type
) -> !bool {
    match tree.expressions.at(field.receiver.node) {
        Ident(identifier) => {
            let name = semantic_text(tree, identifier.name);
            if self.scopes.binding_facts(scope, name) |facts| {
                if facts.borrowed {
                    if !facts.mut_borrow {
                        let problem = try self.field_receiver_error(
                            "cannot assign field through shared borrow `", name
                        );
                        return self.fail(move problem);
                    }
                } else {
                    if !facts.mutable {
                        let problem = try self.field_receiver_error(
                            "cannot assign field of immutable binding `", name
                        );
                        return self.fail(move problem);
                    }
                }
            } else {
                let problem = try self.field_receiver_error(
                    "cannot assign field of immutable binding `", name
                );
                return self.fail(move problem);
            }
        },
        Deref(value) => {
            let copied = ast::DerefExpr {
                receiver: value.receiver,
                operator_span: value.operator_span
            };
            var ignored = empty_type();
            if try self.check_assignable_deref(tree, scope, &copied, &var ignored) |problem| {
                return self.fail(move problem);
            }
        },
        Field(value) => {
            let copied = ast::FieldExpr {
                receiver: value.receiver,
                name: value.name,
                namespace: value.namespace,
                span: value.span
            };
            var ignored = empty_type();
            if try self.check_assignable_field_ok(
                tree,
                scope,
                field.receiver,
                &copied,
                &var ignored
            ) {
                return true;
            }
        },
        Index(value) => {
            let copied = ast::IndexExpr {
                target: value.target,
                index: value.index,
                start: value.start,
                end: value.end,
                slice: value.slice,
                span: value.span
            };
            var ignored = empty_type();
            if try self.check_assignable_index(tree, scope, field.receiver, &copied, &var ignored) |problem| {
                return self.fail(move problem);
            }
        },
        _ => {
            let problem = try self.invalid_assignment_target_error(tree, expression);
            return self.fail(move problem);
        },
    }
    return self.resolve_field_expr_ok(tree, scope, field, true, out);
}

fn (self: &Checker) field_receiver_error(prefix: []u8, name: []u8) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, prefix);
    try message.append_bytes(self.allocator, name);
    try message.append_byte(self.allocator, cast<u8>(96));
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_field_invariant(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    action: []u8
) -> !?diagnostic::Diagnostic {
    var receiver = empty_type();
    if try self.check_expr(tree, scope, field.receiver, &var receiver) |problem| {
        return move problem;
    }
    receiver = try self.types.borrowed_value_type(receiver);
    let receiver_text = try self.types.copy_text(self.allocator, receiver);
    defer receiver_text.deinit(self.allocator);
    let receiver_name = receiver_text.as_bytes();
    let handle = self.metadata.structs.get(receiver_name) orelse return null;
    match tree.declarations.at(handle.node) {
        Struct(declaration) => {
            let retained_name = tree.texts.at(declaration.name.node);
            let type_name = retained_name.as_bytes();
            let retained_field = tree.texts.at(field.name.node);
            let field_name = retained_field.as_bytes();
            return self.require_unsafe_struct_invariant(
                declaration,
                type_name,
                action,
                field_name,
                field.span
            );
        },
        _ => return null,
    }
}

fn (self: &var Checker) check_assignable_deref(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::DerefExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var mut_borrowed_view = false;
    match tree.expressions.at(expression.receiver.node) {
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let source_name = retained.as_bytes();
            if self.scopes.is_mut_borrowed(scope, source_name) {
                mut_borrowed_view = true;
                if self.scopes.lookup(scope, source_name) |value| {
                    if self.types.is_slice_type(value) {
                        var message = string::new(self.allocator);
                        errdefer message.deinit(self.allocator);
                        try message.append_byte(self.allocator, cast<u8>(96));
                        try message.append_bytes(self.allocator, source_name);
                        try message.append_bytes(self.allocator,
                            ".*` cannot re-point a slice view; write elements with `"
                        );
                        try message.append_bytes(self.allocator, source_name);
                        try message.append_bytes(self.allocator, "[i] = ...`");
                        return try self.checker_message_at(
                            "type error", ast::zero_span(), move message
                        );
                    }
                }
            }
        },
        _ => {},
    }
    if mut_borrowed_view {
        return self.check_deref_expr(tree, scope, expression, out);
    }
    var receiver = empty_type();
    if try self.check_expr(tree, scope, expression.receiver, &var receiver) |problem| {
        return move problem;
    }
    if self.types.is_pointer_type(receiver) {
        if try self.require_unsafe_capability_at(
            UnsafeCapability::PtrDeref,
            "raw pointer dereference",
            expression.operator_span
        ) |problem| {
            return move problem;
        }
        match try self.types.assignable_raw_pointer_deref_type(receiver) {
            Value(value) => {
                out.* = value;
                return null;
            },
            Error(reason) => return try self.pointer_deref_error(receiver, reason, true),
        }
    }
    let rendered = try ast::render_expression(self.allocator, tree, expression.receiver);
    defer rendered.deinit(self.allocator);
    let receiver_text = rendered.as_bytes();
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, receiver_text);
    try message.append_bytes(self.allocator, "` is not a mutable borrow");
    return try self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) expr_borrow_sources(
    allocator: Allocator,
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var map::Map<[]u8, bool>
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.node) {
        String(_) => {
            try out.insert(allocator, "$static", true);
            return null;
        },
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let name = retained.as_bytes();
            try self.ident_borrow_sources(scope, name, out);
            return null;
        },
        Index(value) => {
            if !value.slice {
                return null;
            }
            return self.expr_borrow_sources(allocator, tree, scope, value.target, out);
        },
        Try(value) => return self.expr_borrow_sources(allocator, tree, scope, value.value, out),
        Unsafe(value) => return self.expr_borrow_sources(allocator, tree, scope, value.value, out),
        Move(value) => return self.expr_borrow_sources(allocator, tree, scope, value.value, out),
        Call(value) => {
            let copied = ast::CallExpr {
                callee: value.callee, args: value.args
            };
            return self.call_borrow_sources(tree, scope, &copied, out);
        },
        Field(value) => {
            let copied = ast::FieldExpr {
                receiver: value.receiver,
                name: value.name,
                namespace: value.namespace,
                span: value.span
            };
            return self.field_borrow_sources(tree, scope, &copied, out);
        },
        StructLiteral(_) => return self.struct_literal_borrow_sources(tree, scope, expression, out),
        _ => return null,
    }
}

fn (self: &Checker) ident_borrow_sources(
    scope: ScopeHandle,
    name: []u8,
    roots: &var map::Map<[]u8, bool>
) -> !void {
    var seen = map::new<[]u8, bool>(self.allocator);
    defer seen.deinit(self.allocator);
    return self.collect_borrow_roots(self.allocator, scope, name, &var seen, roots);
}

fn (self: &Checker) collect_borrow_roots(
    allocator: Allocator,
    scope: ScopeHandle,
    source: []u8,
    seen: &var map::Map<[]u8, bool>,
    roots: &var map::Map<[]u8, bool>
) -> !void {
    if seen.contains(source) {
        return;
    }
    try seen.insert(allocator, source, true);
    let idx = self.scopes.find_entry_in_chain(scope, source);
    if idx >= 0 {
        if self.scopes.entries.at(idx) |entry| {
            if entry.binding.borrow_sources.len() == 0 {
                return roots.insert(allocator, source, true);
            }
            var index = 0;
            while entry.binding.borrow_sources.at(index) |recorded| {
                let candidate = recorded.as_bytes();
                if mem::equal_bytes(candidate, source) {
                    try roots.insert(allocator, source, true);
                } else {
                    try self.collect_borrow_roots(allocator, scope, candidate, seen, roots);
                }
                index = index + 1;
            }
            return;
        }
    }
    return roots.insert(allocator, source, true);
}

fn (self: &var Checker) call_borrow_sources(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    call: &ast::CallExpr,
    out: &var map::Map<[]u8, bool>
) -> !?diagnostic::Diagnostic {
    var handled = false;
    if try self.method_borrow_sources(tree, scope, call, &var handled, out) |problem| {
        return move problem;
    }
    if handled {
        return null;
    }
    let function = try self.called_function(tree, call.callee) orelse
        return null;
    return self.structural_return_sources(tree, scope, function, null, call.args, out);
}

fn (self: &var Checker) structural_return_sources(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    function: FunctionHandle,
    receiver: ?ast::Expression,
    args: ast::ExpressionList,
    out: &var map::Map<[]u8, bool>
) -> !?diagnostic::Diagnostic {
    let facts = self.callable_facts(function) orelse return null;
    if !try self.types.is_borrowed_view_return_type(facts.return_type) {
        return null;
    }
    var index = 0;
    while index < facts.parameter_count {
        let parameter = self.callable_param_facts(function, index) orelse
            return null;
        let tie_capable = try self.tie_capable_param(parameter.typ, parameter.borrow);
        if tie_capable {
            if structural_arg_at(tree, receiver, args, index) |argument| {
                if try self.expr_borrow_sources(self.allocator, tree, scope, argument, out) |problem| {
                    return move problem;
                }
            }
        }
        index = index + 1;
    }
    return null;
}

fn structural_arg_at(
    tree: &ast::Ast,
    receiver: ?ast::Expression,
    args: ast::ExpressionList,
    index: i64
) -> ?ast::Expression {
    var position = index;
    if receiver |present| {
        if index == 0 {
            return present;
        }
        position = index - 1;
    }
    if position >= args.len(tree) {
        return null;
    }
    return args.get_or_panic(tree, position);
}

fn (self: &var Checker) tie_capable_param(param: Type, borrowed: bool) -> !bool {
    return borrowed or
        try self.types.is_borrowed_view_return_type(param);
}

fn (self: &var Checker) method_borrow_sources(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    call: &ast::CallExpr,
    handled: &var bool,
    out: &var map::Map<[]u8, bool>
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    match tree.expressions.at(call.callee.node) {
        Field(value) => {
            if value.namespace {
                return null;
            }
            let copied = ast::FieldExpr {
                receiver: value.receiver,
                name: value.name,
                namespace: value.namespace,
                span: value.span
            };
            return self.method_receiver_borrow_sources(
                tree, scope, &copied, call.args, handled, out
            );
        },
        _ => return null,
    }
}

fn (self: &var Checker) method_receiver_borrow_sources(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    args: ast::ExpressionList,
    handled: &var bool,
    out: &var map::Map<[]u8, bool>
) -> !?diagnostic::Diagnostic {
    var receiver = empty_type();
    if try self.check_expr(tree, scope, field.receiver, &var receiver) |problem| {
        handled.* = true;
        return move problem;
    }
    let receiver_text = try self.types.copy_text(self.allocator, receiver);
    defer receiver_text.deinit(self.allocator);
    let receiver_name = receiver_text.as_bytes();
    let retained = tree.texts.at(field.name.node);
    let source_name = retained.as_bytes();
    let owned_name = try string::from_bytes(self.allocator, source_name);
    defer owned_name.deinit(self.allocator);
    let name = owned_name.as_bytes();
    if self.impl_method(receiver_name, name) |method| {
        handled.* = true;
        return self.structural_return_sources(tree, scope, method, field.receiver, args, out);
    }
    if mem::equal_bytes(name, "as_bytes") or
        mem::equal_bytes(name, "as_mut_bytes") or
        mem::equal_bytes(name, "borrow") or
        mem::equal_bytes(name, "borrow_mut") or
        mem::equal_bytes(name, "at") or
        mem::equal_bytes(name, "at_mut") {
        handled.* = true;
        return self.expr_borrow_sources(self.allocator, tree, scope, field.receiver, out);
    }
    return null;
}

fn (self: &var Checker) expr_borrow_source_list(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var array::Array<string::String>
) -> !void {
    var sources = map::new<[]u8, bool>(self.allocator);
    defer sources.deinit(self.allocator);
    if try self.expr_borrow_sources(self.allocator, tree, scope, expression, &var sources) |problem| {
        problem.deinit(self.allocator);
        return;
    }
    var index = 0;
    while sources.key_at(index) |candidate| {
        if !mem::equal_bytes(candidate, "$static") {
            let copied = try string::from_bytes(self.allocator, candidate);
            errdefer copied.deinit(self.allocator);
            try out.append(self.allocator, move copied);
        }
        index = index + 1;
    }
    return;
}

fn (self: &var Checker) field_borrow_sources(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    out: &var map::Map<[]u8, bool>
) -> !?diagnostic::Diagnostic {
    if field.namespace {
        return null;
    }
    return self.expr_borrow_sources(self.allocator, tree, scope, field.receiver, out);
}

fn (self: &var Checker) struct_literal_borrow_sources(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var map::Map<[]u8, bool>
) -> !?diagnostic::Diagnostic {
    let declaration = self.struct_literal_declaration(tree, expression) orelse
        return null;
    let count = struct_declaration_field_count(tree, declaration);
    var index = 0;
    while index < count {
        let written = written_struct_field_value(tree, declaration, expression, index);
        if written |value| {
            if try self.expr_borrow_sources(self.allocator, tree, scope, value, out) |problem| {
                return move problem;
            }
        }
        index = index + 1;
    }
    return null;
}

fn (self: &Checker) struct_literal_declaration(
    tree: &ast::Ast,
    expression: ast::Expression
) -> ?ast::Declaration {
    match tree.expressions.at(expression.node) {
        StructLiteral(literal) => {
            let retained = tree.texts.at(literal.type_name.node);
            let type_name = retained.as_bytes();
            return self.metadata.structs.get(type_name);
        },
        _ => return null,
    }
}

fn struct_declaration_field_count(tree: &ast::Ast, declaration: ast::Declaration) -> i64 {
    match tree.declarations.at(declaration.node) {
        Struct(declared) => return declared.fields.len(),
        _ => return 0,
    }
}

fn written_struct_field_value(
    tree: &ast::Ast,
    declaration: ast::Declaration,
    expression: ast::Expression,
    index: i64
) -> ?ast::Expression {
    match tree.declarations.at(declaration.node) {
        Struct(declared) => {
            if declared.fields.at(index) |field| {
                let retained = tree.texts.at(field.name.node);
                let name = retained.as_bytes();
                return written_field_value(tree, expression, name);
            }
            return null;
        },
        _ => return null,
    }
}

fn written_field_value(
    tree: &ast::Ast,
    expression: ast::Expression,
    name: []u8
) -> ?ast::Expression {
    match tree.expressions.at(expression.node) {
        StructLiteral(literal) => {
            var index = literal.fields.len();
            while index > 0 {
                index = index - 1;
                if literal.fields.at(index) |written| {
                    let retained = tree.texts.at(written.name.node);
                    let written_name = retained.as_bytes();
                    if mem::equal_bytes(written_name, name) {
                        return written.value;
                    }
                }
            }
            return null;
        },
        _ => return null,
    }
}

fn (self: &Checker) called_function(tree: &ast::Ast, callee: ast::Expression) -> !?FunctionHandle {
    if try qualified_name(self.allocator, tree, callee) |name| {
        defer name.deinit(self.allocator);
        let bytes = name.as_bytes();
        return self.metadata.functions_by_name.get(bytes);
    }
    return null;
}
