import compiler::internal::ast;
import compiler::internal::diagnostic;
import std::string;

fn (self: &var Checker) check_block(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    block: ast::Block,
    want_return: Type,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    if try self.check_block_ok(tree, scope, block, want_return, out) {
        return self.take_failure();
    }
    return null;
}

fn (self: &var Checker) check_block_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    block: ast::Block,
    want_return: Type,
    out: &var bool
) -> !bool {
    if self.editor.len() > 0 {
        self.scopes.set_extent(scope, tree.statement_span(block.as_statement()));
    }
    var index = 0;
    while block_statement_at(tree, block, index) |statement| {
        var returns = false;
        if try self.check_stmt_ok(tree, scope, statement, want_return, &var returns) {
            return true;
        }
        if returns {
            out.* = true;
            if self.lint_mode or !self.scopes.has_unread(scope) {
                return false;
            }
            if try self.unread_local_error(scope) |problem| {
                return self.fail(move problem);
            }
            return false;
        }
        index = index + 1;
    }
    out.* = false;
    if self.lint_mode or !self.scopes.has_unread(scope) {
        return false;
    }
    if try self.unread_local_error(scope) |problem| {
        return self.fail(move problem);
    }
    return false;
}

fn block_statement_at(tree: &ast::Ast, block: ast::Block, index: i64) -> ?ast::Statement {
    match tree.statements.at(block.node) {
        Block(value) => return value.statements.get(index),
        _ => return null,
    }
}

fn (self: &var Checker) check_stmt(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: ast::Statement,
    want_return: Type,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    if try self.check_stmt_ok(tree, scope, statement, want_return, out) {
        return self.take_failure();
    }
    return null;
}

fn (self: &var Checker) check_stmt_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: ast::Statement,
    want_return: Type,
    out: &var bool
) -> !bool {
    if try self.check_stmt_form_ok(tree, scope, statement, want_return, out) {
        if !self.checking_std() {
            self.locate_failure(tree.statement_span(statement));
        }
        return true;
    }
    return false;
}

fn (self: &Checker) locate_stmt(
    tree: &ast::Ast,
    problem: diagnostic::Diagnostic,
    statement: ast::Statement
) -> diagnostic::Diagnostic {
    if self.checking_std() {
        return move problem;
    }
    return diagnostic::locate(move problem, tree.statement_span(statement));
}

fn (self: &var Checker) check_stmt_form_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: ast::Statement,
    want_return: Type,
    out: &var bool
) -> !bool {
    out.* = false;
    match tree.statements.at(statement.node) {
        Let(value) => {
            let copied = ast::LetStmt {
                mutable: value.mutable,
                name: value.name,
                type_name: value.type_name,
                value: value.value
            };
            return self.check_let_stmt_ok(tree, scope, &copied, out);
        },
        Assign(value) => {
            let copied = ast::AssignStmt {
                target: value.target, value: value.value
            };
            return self.check_assign_stmt_ok(tree, scope, &copied, out);
        },
        Return(value) => {
            let copied = ast::ReturnStmt { value: value.value };
            return self.check_return_stmt_ok(tree, scope, &copied, want_return, out);
        },
        Defer(value) => {
            let copied = ast::DeferStmt { expr: value.expr };
            if try self.check_cleanup_stmt(tree, scope, "defer", copied.expr, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        ErrDefer(value) => {
            let copied = ast::ErrDeferStmt { expr: value.expr };
            if try self.check_cleanup_stmt(tree, scope, "errdefer", copied.expr, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Expr(value) => {
            var ignored = empty_type();
            return self.check_expr_ok(tree, scope, value.expr, &var ignored);
        },
        If(value) => {
            let copied = ast::IfStmt {
                condition: value.condition,
                consequence: value.consequence,
                alternative: value.alternative,
                capture: value.capture,
                err_capture: value.err_capture
            };
            return self.check_if_stmt_ok(tree, scope, &copied, want_return, out);
        },
        While(value) => {
            let copied = ast::WhileStmt {
                label: value.label,
                condition: value.condition,
                body: value.body,
                capture: value.capture
            };
            return self.check_while_stmt_ok(tree, scope, &copied, want_return, out);
        },
        For(value) => {
            let copied = ast::ForStmt {
                label: value.label,
                name: value.name,
                start: value.start,
                end: value.end,
                body: value.body
            };
            return self.check_for_stmt_ok(tree, scope, &copied, want_return, out);
        },
        Break(value) => {
            if try self.check_loop_branch_stmt(tree, "break", value.label, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Continue(value) => {
            if try self.check_loop_branch_stmt(tree, "continue", value.label, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Match(_) => {
            if try self.check_match_stmt(tree, scope, statement, want_return, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Block(_) => {
            let child = try self.scopes.new_scope(scope);
            return self.check_block_ok(
                tree,
                child,
                ast::Block { node: statement.node, location: statement.span },
                want_return,
                out
            );
        },
        ComptimeIf(value) => {
            let copied = ast::ComptimeIfStmt {
                condition: value.condition,
                consequence: value.consequence,
                alternative: value.alternative
            };
            if try self.check_comptime_if_stmt(tree, scope, &copied, want_return, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        ComptimeFor(value) => {
            let copied = ast::ComptimeForStmt {
                iterable: value.iterable,
                name: value.name,
                body: value.body
            };
            if try self.check_comptime_for_stmt(tree, scope, &copied, want_return, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        ComptimeMatch(value) => {
            let copied = ast::ComptimeMatchStmt {
                value: value.value,
                name: value.name,
                binding: value.binding,
                body: value.body
            };
            if try self.check_comptime_match_stmt(tree, scope, &copied, want_return, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Recovered(_) => {
            let problem = try self.checker_error_at(
                "type error", ast::zero_span(), "unsupported statement"
            );
            return self.fail(move problem);
        },
    }
}

fn (self: &var Checker) check_cleanup_stmt(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    keyword: []u8,
    expression: ast::Expression,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    if try self.validate_deferred_call_shape(tree, keyword, expression) |problem| {
        return move problem;
    }
    var got = empty_type();
    if try self.check_expr(tree, scope, expression, &var got) |problem| {
        return move problem;
    }
    if !self.types.is_text(got, "void") {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, keyword);
        try message.append_bytes(self.allocator, " call must return void, got ");
        try self.append_checker_type(&var message, got);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    out.* = false;
    return null;
}

fn (self: &var Checker) check_return_stmt(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::ReturnStmt,
    want: Type,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    if try self.check_return_stmt_ok(tree, scope, statement, want, out) {
        return self.take_failure();
    }
    return null;
}

fn (self: &var Checker) check_return_stmt_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::ReturnStmt,
    want: Type,
    out: &var bool
) -> !bool {
    if statement.value |expression| {
        if return_void_identifier(tree, expression) {
            let problem = try self.checker_error_at(
                "type error", ast::zero_span(),
                "void is not a value; use `return;`"
            );
            return self.fail(move problem);
        }
        if return_null_literal(tree, expression) {
            var success = want;
            if try self.types.error_union_element(success) |elem| {
                success = elem;
            }
            if try self.types.takes_null(success) {
                out.* = true;
                return false;
            }
            let problem = try self.return_null_mismatch(want);
            return self.fail(move problem);
        }
        let saved_capture = self.capture_condition;
        if self.types.is_borrow_optional_fast(want) {
            self.capture_condition = true;
        }
        var got = empty_type();
        if try self.check_expr_ok(tree, scope, expression, &var got) {
            self.capture_condition = saved_capture;
            return true;
        }
        self.capture_condition = saved_capture;
        return self.check_return_value_ok(tree, scope, expression, want, got, out);
    }
    if try self.accepts_bare_return(want) {
        out.* = true;
        return false;
    }
    let problem = try self.return_void_mismatch(want);
    return self.fail(move problem);
}

fn return_void_identifier(tree: &ast::Ast, expression: ast::Expression) -> bool {
    match tree.expressions.at(expression.node) {
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let name = retained.as_bytes();
            return equal(name, "void");
        },
        _ => return false,
    }
}

fn return_null_literal(tree: &ast::Ast, expression: ast::Expression) -> bool {
    return match tree.expressions.at(expression.node) {
        Null(_) => true,
        _ => false,
    };
}

fn (self: &Checker) return_void_mismatch(want: Type) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "return expects ");
    try self.append_checker_type(&var message, want);
    try message.append_bytes(self.allocator, ", got void");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) return_null_mismatch(want: Type) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "return expects ");
    try self.append_checker_type(&var message, want);
    try message.append_bytes(self.allocator, ", got null");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) check_loop_branch_stmt(
    tree: &ast::Ast,
    kind: []u8,
    label: ast::Text,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    let retained = tree.texts.at(label.node);
    let bytes = retained.as_bytes();
    if try self.check_loop_branch(kind, bytes) |problem| {
        return move problem;
    }
    out.* = false;
    return null;
}
