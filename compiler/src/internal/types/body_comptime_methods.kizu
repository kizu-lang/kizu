import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::stdmeta;
import compiler::internal::typ;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// Ports the compile-time statement checks of internal/types/comptime.go and
// meta.go, the receiver-sensitive Box / String / Arena method checks of
// checker.go, and the per-declaration body drivers checkFunction and
// checkTestDecl. Expansions add nodes to the mutable Ast; nothing here keeps
// a borrow into it across a recursive check.

// Names one union variant copied out of checker metadata so the variant list
// can be retained without holding a metadata borrow.
struct UnionVariantFacts {
    name: string::String,
    payload: Type
}

// Checks only the branch selected by a compile-time bool.
fn (self: &var Checker) check_comptime_if_stmt(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::ComptimeIfStmt,
    want_return: Type,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    var condition = ComptimeValue::Integer(0);
    if try self.eval_comptime(tree, statement.condition, &var condition) |problem| {
        return move problem;
    }
    var selected = false;
    match condition {
        Boolean(value) => {
            selected = value;
        },
        _ => {
            let got = try self.comptime_value_type(condition);
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, "if condition must be bool, got ");
            try self.append_checker_type(&var message, got);
            return try self.comptime_message(move message);
        },
    }
    if selected {
        let child = try self.scopes.new_scope(scope);
        return self.check_block(tree, child, statement.consequence, want_return, out);
    }
    if statement.alternative |alternative| {
        let child = self.scopes.new_scope(scope);
        return self.check_block(tree, try child, alternative, want_return, out);
    }
    out.* = false;
    return null;
}

// Expands a compile-time loop and checks each expansion. The body is
// ordinary Kizu code checked once per field, not a rewritten token stream.
fn (self: &var Checker) check_comptime_for_stmt(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::ComptimeForStmt,
    want_return: Type,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    var fields = array::new<MetaFieldHandle>(self.allocator);
    defer fields.deinit(self.allocator);
    if try self.comptime_for_fields(tree, statement.list, &var fields) |problem| {
        return move problem;
    }
    let retained_name = tree.texts.at(statement.name.node);
    let source_name = retained_name.as_bytes();
    let owned_name = try string::from_bytes(self.allocator, source_name);
    defer owned_name.deinit(self.allocator);
    let previous_meta = self.meta_bindings.current;
    var returns = true;
    var index = 0;
    while fields.get(index) |field| {
        let name = owned_name.as_bytes();
        try self.bind_meta_field(name, field);
        let child = try self.scopes.new_scope(scope);
        var expansion_returns = false;
        if try self.check_block(
            tree,
            child,
            statement.body,
            want_return,
            &var expansion_returns
        ) |problem| {
            self.meta_bindings.restore(previous_meta);
            return move problem;
        }
        returns = returns and expansion_returns;
        index = index + 1;
    }
    self.meta_bindings.restore(previous_meta);
    // An empty struct expands to nothing, and nothing cannot return.
    out.* = returns and fields.len() > 0;
    return null;
}

// Reads the list a `comptime for` walks. Only the two declared lists are
// iterable: an integer range is what the runtime `for` is for.
fn (self: &var Checker) comptime_for_fields(
    tree: &ast::Ast,
    list: ast::Expression,
    out: &var array::Array<MetaFieldHandle>
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(list.node) {
        Call(call) => match tree.expressions.at(call.callee.node) {
            TypeApply(applied) => {
                if try qualified_name(self.allocator, tree, applied.callee) |name| {
                    defer name.deinit(self.allocator);
                    return self.comptime_for_named_fields(
                        tree, call.args, applied.type_arg, &name, out
                    );
                }
            },
            _ => {},
        },
        _ => {},
    }
    return try self.comptime_for_list_error();
}

fn (self: &var Checker) comptime_for_named_fields(
    tree: &ast::Ast,
    args: ast::ExpressionList,
    type_arg: ast::Text,
    name: &string::String,
    out: &var array::Array<MetaFieldHandle>
) -> !?diagnostic::Diagnostic {
    let name_bytes = name.as_bytes();
    if args.len(tree) != 0 {
        return try self.comptime_named_error(name_bytes, " takes no arguments");
    }
    let identified = stdmeta::identify(name_bytes) orelse
        return try self.comptime_for_list_error();
    match identified.form {
        PublicFields => {
            let instantiated = try self.instantiate_type_arg_text(tree, type_arg);
            defer instantiated.deinit(self.allocator);
            let argument_text = instantiated.as_bytes();
            return self.comptime_public_fields(tree, argument_text, out);
        },
        Variants => {
            let instantiated = try self.instantiate_type_arg_text(tree, type_arg);
            defer instantiated.deinit(self.allocator);
            let argument_text = instantiated.as_bytes();
            return self.comptime_variants(tree, argument_text, out);
        },
        _ => return try self.comptime_for_list_error(),
    }
}

// Names the lists a `comptime for` accepts.
fn (self: &Checker) comptime_for_list_error() -> !diagnostic::Diagnostic {
    return self.comptime_error(
        "comptime for expects `std::meta::public_fields<T>()` or `std::meta::variants<T>()`"
    );
}

// Lists a struct's public fields in declaration order.
fn (self: &var Checker) comptime_public_fields(
    tree: &ast::Ast,
    type_arg: []u8,
    out: &var array::Array<MetaFieldHandle>
) -> !?diagnostic::Diagnostic {
    var owner = empty_type();
    if try self.comptime_list_owner(
        tree, stdmeta::Form::PublicFields, type_arg, &var owner
    ) |problem| {
        return move problem;
    }
    return self.public_meta_fields(tree, owner, out);
}

// Lists an enum's tags or a union's variants in declaration order.
fn (self: &var Checker) comptime_variants(
    tree: &ast::Ast,
    type_arg: []u8,
    out: &var array::Array<MetaFieldHandle>
) -> !?diagnostic::Diagnostic {
    var owner = empty_type();
    if try self.comptime_list_owner(tree, stdmeta::Form::Variants, type_arg, &var owner) |problem| {
        return move problem;
    }
    return self.variant_meta_fields(tree, owner, out);
}

// Resolves the one static argument a list form takes.
fn (self: &var Checker) comptime_list_owner(
    tree: &ast::Ast,
    form: stdmeta::Form,
    type_arg: []u8,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if try typ::split_args_optional(self.allocator, type_arg) |arguments| {
        defer arguments.deinit(self.allocator);
        if arguments.len() != 1 {
            return try self.comptime_form_error(form, "` expects 1 static argument");
        }
        if arguments.at(0) |argument| {
            let bytes = argument.as_bytes();
            match try self.resolve_type(tree, bytes) {
                Value(value) => {
                    out.* = value;
                    return null;
                },
                Issue(issue) => {
                    return try self.type_resolution_diagnostic(issue);
                },
            }
        }
    }
    return try self.comptime_form_error(form, "` expects 1 static argument");
}

// Retains one meta field per enum tag or union variant of owner.
fn (self: &var Checker) variant_meta_fields(
    tree: &ast::Ast,
    owner: Type,
    out: &var array::Array<MetaFieldHandle>
) -> !?diagnostic::Diagnostic {
    let owner_name = try self.types.copy_text(self.allocator, owner);
    defer owner_name.deinit(self.allocator);
    let owner_bytes = owner_name.as_bytes();
    if self.metadata.enums_by_name.get(owner_bytes) |enum_handle| {
        var index = 0;
        while self.enum_tag_at(enum_handle, index) |tag| {
            let retained_tag = tree.texts.at(tag.node);
            let tag_name = retained_tag.as_bytes();
            let handle = try self.retain_meta_field(owner, tag_name, empty_type(), true);
            try out.append(self.allocator, handle);
            index = index + 1;
        }
        return null;
    }
    let union_handle = self.metadata.unions_by_name.get(owner_bytes) orelse
        return try self.meta_variants_type_error(owner);
    let count = self.union_variant_count(union_handle);
    var index = 0;
    while index < count {
        if try self.copy_union_variant(union_handle, index) |variant| {
            defer variant.deinit(self.allocator);
            let variant_name = variant.name.as_bytes();
            let handle = try self.retain_meta_field(owner, variant_name, variant.payload, true);
            try out.append(self.allocator, handle);
        }
        index = index + 1;
    }
    return null;
}

fn (self: &Checker) union_variant_count(handle: UnionHandle) -> i64 {
    if self.metadata.unions.at(handle.index) |value| {
        return value.order.len();
    }
    return 0;
}

fn (self: &Checker) enum_tag_at(handle: EnumHandle, index: i64) -> ?ast::Text {
    if self.metadata.enums.at(handle.index) |value| {
        return value.order.get(index);
    }
    return null;
}

fn (self: &Checker) copy_union_variant(handle: UnionHandle, index: i64) -> !?UnionVariantFacts {
    if self.metadata.unions.at(handle.index) |value| {
        if value.order.at(index) |retained| {
            let name = retained.as_bytes();
            let payload = value.variants.get(name) orelse empty_type();
            return UnionVariantFacts {
                name: try string::from_bytes(self.allocator, name),
                payload: payload
            };
        }
    }
    return null;
}

fn (self: &Checker) meta_variants_type_error(owner: Type) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "`std::meta::variants` expects an enum or union, got ");
    try self.append_checker_type(&var message, owner);
    return self.comptime_message(move message);
}

// Checks the match a `comptime match` stands for, with the capture bound to
// the arm's own variant while its body is checked. The dispatch itself is an
// ordinary match, so exhaustiveness and payload binding are checked by the
// rules match already has.
fn (self: &var Checker) check_comptime_match_stmt(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    statement: &ast::ComptimeMatchStmt,
    want_return: Type,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    var value_type = empty_type();
    if try self.check_expr(tree, scope, statement.value, &var value_type) |problem| {
        return move problem;
    }
    let owner = try self.types.borrowed_value_type(value_type);
    var variants = array::new<MetaFieldHandle>(self.allocator);
    defer variants.deinit(self.allocator);
    if try self.variant_meta_fields(tree, owner, &var variants) |problem| {
        problem.deinit(self.allocator);
        return try self.comptime_match_subject_error(value_type);
    }
    let binding_len = tree.texts.at(statement.binding.node).len();
    if binding_len == 0 and self.meta_fields_carry_payload(&variants) {
        return try self.comptime_match_capture_error(owner);
    }
    let expanded = try self.expand_comptime_match(tree, statement, owner, &variants);
    return self.check_stmt(tree, scope, expanded, want_return, out);
}

// Reports whether any variant holds a payload, which is what makes the
// second capture necessary.
fn (self: &Checker) meta_fields_carry_payload(variants: &array::Array<MetaFieldHandle>) -> bool {
    var index = 0;
    while variants.get(index) |handle| {
        let field = self.meta_field_entries.at(handle.node);
        if !same_type(field.type_name, empty_type()) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// Builds the ordinary match every phase reads from the resolved variants.
fn (self: &Checker) expand_comptime_match(
    tree: &var ast::Ast,
    statement: &ast::ComptimeMatchStmt,
    owner: Type,
    variants: &array::Array<MetaFieldHandle>
) -> !ast::Statement {
    var meta_variants = array::new<ast::MetaVariant>(self.allocator);
    defer meta_variants.deinit(self.allocator);
    var index = 0;
    while variants.get(index) |handle| {
        let field = self.meta_field_entries.at(handle.node);
        let field_name = field.name.as_bytes();
        let name = try tree.add_text_from_bytes(field_name);
        try meta_variants.append(self.allocator, ast::MetaVariant {
            name: name,
            has_payload: !same_type(field.type_name, empty_type())
        });
        index = index + 1;
    }
    let owner_name = try self.types.copy_text(self.allocator, owner);
    defer owner_name.deinit(self.allocator);
    let owner_bytes = owner_name.as_bytes();
    let owner_text = try tree.add_text_from_bytes(owner_bytes);
    let empty = try tree.add_empty_text();
    let expanded = try ast::comptime_match_expansion(self.allocator, statement, owner_text, empty, &meta_variants
    );
    return try tree.add_statement(ast::StatementNode::Match(move expanded));
}

fn (self: &Checker) comptime_match_subject_error(value_type: Type) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "comptime match expects an enum or union, got ");
    try self.append_checker_type(&var message, value_type);
    return self.comptime_message(move message);
}

fn (self: &Checker) comptime_match_capture_error(owner: Type) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "comptime match on `");
    try self.append_checker_type(&var message, owner);
    try message.append_bytes(self.allocator,
        "` needs a payload capture, as in `comptime match value |variant, payload| { ... }`"
    );
    return self.comptime_message(move message);
}

// Validates receiver-sensitive Box<T> methods.
fn (self: &var Checker) check_box_receiver_method(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    name: []u8,
    receiver: Type,
    elem: Type,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if mem::equal_bytes(name, "borrow") {
        return try self.checker_error_at(
            "type error", ast::zero_span(),
            "`Box.borrow` must be bound with `let name = box.borrow()`"
        );
    }
    if mem::equal_bytes(name, "borrow_mut") {
        return try self.checker_error_at(
            "type error", ast::zero_span(),
            "`Box.borrow_mut` must be bound with `let name = box.borrow_mut()`"
        );
    }
    if mem::equal_bytes(name, "take") {
        if receiver_ident(tree, field.receiver) |_| {} else {
            return try self.box_local_receiver_error(name);
        }
        return self.check_box_std_method(tree, scope, elem, name, args, out);
    }
    if mem::equal_bytes(name, "deinit") {
        if receiver_ident(tree, field.receiver) |_| {} else {
            if !self.direct_field_cleanup_receiver(tree, scope, field.receiver) {
                return try self.box_local_receiver_error(name);
            }
        }
        return self.check_box_std_method(tree, scope, elem, name, args, out);
    }
    let receiver_name = try self.types.copy_text(self.allocator, receiver);
    defer receiver_name.deinit(self.allocator);
    let receiver_text = receiver_name.as_bytes();
    if self.impl_method(receiver_text, name) |method| {
        return self.check_method_args(
            tree,
            scope,
            method,
            receiver,
            field.receiver,
            field.span,
            args,
            out
        );
    }
    return try self.std_missing_method_error("Box", name);
}

fn (self: &var Checker) check_box_std_method(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    elem: Type,
    name: []u8,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var type_args = array::new<Type>(self.allocator);
    defer type_args.deinit(self.allocator);
    try type_args.append(self.allocator, elem);
    return self.check_std_method(
        tree,
        scope,
        "std::mem::Box",
        &type_args,
        "Box",
        name,
        args,
        0,
        out
    );
}

fn (self: &Checker) box_local_receiver_error(name: []u8) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "`Box.");
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` requires local Box receiver");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

// Returns the identifier a receiver names directly, or null for any other
// receiver shape.
fn receiver_ident(tree: &ast::Ast, expression: ast::Expression) -> ?ast::IdentExpr {
    match tree.expressions.at(expression.node) {
        Ident(identifier) => return ast::IdentExpr {
            name: identifier.name,
            span: identifier.span
        },
        _ => return null,
    }
}

// Validates receiver-sensitive String methods.
fn (self: &var Checker) check_string_receiver_method(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    name: []u8,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if receiver_ident(tree, field.receiver) |identifier| {
        let retained = tree.texts.at(identifier.name.node);
        let binding = retained.as_bytes();
        if mem::equal_bytes(name, "deinit") and
            self.scopes.is_borrowed(scope, binding) {
            return try self.checker_error_at(
                "type error", ast::zero_span(),
                "`String.deinit` requires owned String receiver"
            );
        }
        if is_string_mutating_method(name) and
            self.scopes.is_borrowed(scope, binding) and
            !self.scopes.is_mut_borrowed(scope, binding) {
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, "`String.");
            try message.append_bytes(self.allocator, name);
            try message.append_bytes(self.allocator, "` requires mutable String receiver");
            return try self.checker_message_at("type error", ast::zero_span(), move message);
        }
    }
    return self.check_string_method(tree, scope, name, args, out);
}

// Validates owned String prototype methods.
fn (self: &var Checker) check_string_method(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if is_string_mutator_method(name) {
        if try self.check_string_mutator_arg(tree, scope, name, args) |problem| {
            return move problem;
        }
        let void_type = try self.types.void_type();
        if mem::equal_bytes(name, "truncate") {
            out.* = try self.intern_declared_error_type("std::string::Error", void_type);
            return null;
        }
        if mem::equal_bytes(name, "reserve") {
            // The requested size itself can be refused, and memory can run
            // out (ADR-0128).
            out.* = try self.intern_declared_error_type("std::string::GrowError", void_type);
            return null;
        }
        // Growing needs memory and nothing else (ADR-0128).
        out.* = try self.intern_declared_error_type("std::mem::Error", void_type);
        return null;
    }
    if mem::equal_bytes(name, "len") or
        mem::equal_bytes(name, "capacity") {
        if args.len(tree) != 0 {
            return try self.receiver_arity_error("String", name, 0, args.len(tree));
        }
        out.* = try self.types.i64_type();
        return null;
    }
    if mem::equal_bytes(name, "as_bytes") or
        mem::equal_bytes(name, "as_mut_bytes") {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "`String.");
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, "` must be bound with `let name = string.");
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, "()`");
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    if mem::equal_bytes(name, "clear") {
        if args.len(tree) != 0 {
            return try self.receiver_arity_error("String", name, 0, args.len(tree));
        }
        out.* = try self.types.void_type();
        return null;
    }
    if mem::equal_bytes(name, "deinit") {
        if try self.check_release_allocator(
            tree, scope, "String", name, args, 0
        ) |problem| {
            return move problem;
        }
        out.* = try self.types.void_type();
        return null;
    }
    return try self.std_missing_method_error("String", name);
}

// Validates the single argument each String mutator takes.
fn (self: &var Checker) check_string_mutator_arg(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    args: ast::ExpressionList
) -> !?diagnostic::Diagnostic {
    // A growth names the allocator its storage comes from first: a String
    // keeps none of its own (ADR-0132). `truncate` neither grows nor frees.
    var offset = 0;
    if is_string_grow_method(name) {
        offset = 1;
        if try self.check_string_grow_allocator(tree, scope, name, args) |problem| {
            return move problem;
        }
    }
    if args.len(tree) != offset + 1 {
        return try self.string_method_arg_count_error(name, offset + 1, args.len(tree));
    }
    let argument = args.get_or_panic(tree, offset);
    var got = empty_type();
    if mem::equal_bytes(name, "append_byte") {
        let want = try self.types.u8_type();
        if try self.check_contextual_expr(tree, scope, argument, want, &var got) |problem| {
            return move problem;
        }
        if !same_type(got, want) {
            return try self.std_method_arg_error("String", name, want, got);
        }
        return null;
    }
    if try self.check_expr(tree, scope, argument, &var got) |problem| {
        return move problem;
    }
    if mem::equal_bytes(name, "append_bytes") {
        let want = try self.types.byte_string_type();
        if !same_type(got, want) {
            return try self.std_method_arg_error("String", name, want, got);
        }
        return null;
    }
    if mem::equal_bytes(name, "append_string") {
        if !self.types.is_text(got, "std::string::String") {
            return try self.string_method_string_arg_error(name, got);
        }
        return null;
    }
    let want = try self.types.i64_type();
    if !same_type(got, want) {
        return try self.std_method_arg_error("String", name, want, got);
    }
    return null;
}

fn (self: &Checker) string_method_arg_count_error(
    name: []u8,
    expected: i64,
    got: i64
) -> !diagnostic::Diagnostic {
    var label = string::new(self.allocator);
    defer label.deinit(self.allocator);
    try label.append_bytes(self.allocator, "String.");
    try label.append_bytes(self.allocator, name);
    let label_bytes = label.as_bytes();
    return self.named_arity_error(label_bytes, expected, got);
}

/// Reports the String methods that may ask for storage.
fn is_string_grow_method(name: []u8) -> bool {
    return mem::equal_bytes(name, "append_bytes") or
        mem::equal_bytes(name, "append_byte") or
        mem::equal_bytes(name, "append_string") or
        mem::equal_bytes(name, "reserve");
}

/// Validates the leading Allocator a String growth names.
fn (self: &var Checker) check_string_grow_allocator(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    args: ast::ExpressionList
) -> !?diagnostic::Diagnostic {
    if args.len(tree) != 2 {
        return try self.string_method_arg_count_error(name, 2, args.len(tree));
    }
    let argument = args.get_or_panic(tree, 0);
    var got = empty_type();
    if try self.check_expr(tree, scope, argument, &var got) |problem| {
        return move problem;
    }
    if !self.types.is_text(got, "Allocator") {
        let allocator_type = try self.types.intern("Allocator");
        return try self.std_method_arg_error("String", name, allocator_type, got);
    }
    return null;
}

fn (self: &Checker) string_method_string_arg_error(
    name: []u8,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "`String.");
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` expects String, got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

// Reports whether a String method takes one argument and returns `!void`.
fn is_string_mutator_method(name: []u8) -> bool {
    return mem::equal_bytes(name, "append_bytes") or
        mem::equal_bytes(name, "append_byte") or
        mem::equal_bytes(name, "append_string") or
        mem::equal_bytes(name, "reserve") or
        mem::equal_bytes(name, "truncate");
}

// Reports whether a String method can change owned storage.
fn is_string_mutating_method(name: []u8) -> bool {
    return is_string_mutator_method(name) or
        mem::equal_bytes(name, "clear") or
        mem::equal_bytes(name, "deinit");
}

// Validates the receiver-sensitive std::arena::Arena<T> methods, then reads
// the rest off std's declaration the way Array and Box do. What is left here
// is what a declaration cannot state: which receiver place a method may come
// from, and that `at_mut` hands out a borrow only a capture can consume.
fn (self: &var Checker) check_arena_method(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    name: []u8,
    elem: Type,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if mem::equal_bytes(name, "at_mut") {
        return self.check_arena_at_mut(tree, scope, field, elem, args, out);
    }
    if mem::equal_bytes(name, "deinit") {
        if try self.check_arena_cleanup_receiver(tree, scope, field) |problem| {
            return move problem;
        }
    }
    return self.check_arena_std_method(tree, scope, elem, name, args, out);
}

// Reads one Arena method off std's declaration.
fn (self: &var Checker) check_arena_std_method(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    elem: Type,
    name: []u8,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var type_args = array::new<Type>(self.allocator);
    defer type_args.deinit(self.allocator);
    try type_args.append(self.allocator, elem);
    return self.check_std_method(
        tree,
        scope,
        "std::arena::Arena",
        &type_args,
        "Arena",
        name,
        args,
        0,
        out
    );
}

// Validates the arena_add primitive: the add is what buys the storage the
// element goes in, so it names the allocator it buys from -- an arena header
// keeps none of its own (ADR-0131, ADR-0132).
fn (self: &var Checker) check_arena_add(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    elem: Type,
    args: ast::ExpressionList,
    offset: i64,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let count = args.len(tree) - offset;
    if count != 2 {
        return try self.receiver_arity_error("Arena", "add", 2, count);
    }
    let allocator_arg = args.get_or_panic(tree, offset);
    var allocator = empty_type();
    if try self.check_expr(tree, scope, allocator_arg, &var allocator) |problem| {
        return move problem;
    }
    if !self.types.is_text(allocator, "Allocator") {
        return try self.labeled_arg_type_error(
            "Arena.add", try self.types.intern("Allocator"), allocator);
    }
    let argument = args.get_or_panic(tree, offset + 1);
    var got = empty_type();
    if try self.check_expr(tree, scope, argument, &var got) |problem| {
        return move problem;
    }
    if !same_type(got, elem) {
        return try self.labeled_arg_type_error("Arena.add", elem, got);
    }
    let handle = try self.intern_arena_handle_type(elem);
    out.* = try self.intern_declared_error_type("std::mem::Error", handle);
    return null;
}

// Validates std::arena::Arena<T>.at_mut(handle): capture conditions consume
// the `?&var T` it returns, everywhere else refuses it.
fn (self: &var Checker) check_arena_at_mut(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    elem: Type,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if !self.capture_condition {
        return try self.checker_error_at(
            "type error", ast::zero_span(),
            "`Arena.at_mut` must be consumed by a capture (`if a.at_mut(handle) |name|` or `while a.at_mut(handle) |name|`)"
        );
    }
    if !try self.mutable_receiver_place(tree, scope, field.receiver) {
        return try self.checker_error_at(
            "type error", ast::zero_span(),
            "`Arena.at_mut` requires mutable arena binding"
        );
    }
    // The flag covers exactly this call: off while the argument is read,
    // and back on for the result the call gate reads.
    self.capture_condition = false;
    if try self.check_arena_std_method(tree, scope, elem, "at_mut", args, out) |problem| {
        self.capture_condition = true;
        return move problem;
    }
    self.capture_condition = true;
    return null;
}

// Keeps arena cleanup on a place it may consume.
fn (self: &var Checker) check_arena_cleanup_receiver(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr
) -> !?diagnostic::Diagnostic {
    if receiver_ident(tree, field.receiver) |identifier| {
        let retained = tree.texts.at(identifier.name.node);
        let binding = retained.as_bytes();
        if self.scopes.is_borrowed(scope, binding) {
            return try self.checker_error_at(
                "type error", ast::zero_span(),
                "`Arena.deinit` requires owned arena receiver"
            );
        }
        return null;
    }
    if !self.direct_field_cleanup_receiver(tree, scope, field.receiver) {
        return try self.checker_error_at(
            "type error", ast::zero_span(),
            "`Arena.deinit` requires local arena receiver"
        );
    }
    return null;
}

// Validates the one handle argument an arena accessor takes against the
// arena's element type. label names the accessor in errors.
fn (self: &var Checker) check_arena_handle_arg(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    elem: Type,
    args: ast::ExpressionList,
    offset: i64,
    label: []u8
) -> !?diagnostic::Diagnostic {
    let count = args.len(tree) - offset;
    if count != 1 {
        return try self.named_arity_error(label, 1, count);
    }
    let argument = args.get_or_panic(tree, offset);
    var got = empty_type();
    if try self.check_expr(tree, scope, argument, &var got) |problem| {
        return move problem;
    }
    let want = try self.intern_arena_handle_type(elem);
    if !same_type(got, want) {
        return try self.labeled_arg_type_error(label, want, got);
    }
    return null;
}

fn (self: &var Checker) intern_arena_handle_type(elem: Type) -> !Type {
    return self.intern_single_argument_type("std::arena::Handle", elem);
}

fn (self: &Checker) labeled_arg_type_error(
    label: []u8,
    want: Type,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, label);
    try message.append_bytes(self.allocator, "` expects ");
    try self.append_checker_type(&var message, want);
    try message.append_bytes(self.allocator, ", got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

// Rejects a marker that covers no unproven operation after its value was
// checked under the fresh marker `inner`. Both the expression and the
// assignment-target paths go through here, so the rule for what a marker must
// cover lives in one place.
fn (self: &Checker) check_under_mark(
    tree: &ast::Ast,
    expression: &ast::UnsafeExpr,
    inner: &UnsafeMark
) -> !?diagnostic::Diagnostic {
    if !(inner.used orelse false) {
        var failure = try self.checker_error_at(
            "unsafe error", expression.span,
            "`unsafe` covers no operation that needs it"
        );
        errdefer failure.deinit(self.allocator);
        try failure.with_code(self.allocator, "unsafe.unused_marker");
        try failure.with_help(self.allocator, "remove `unsafe`");
        return move failure;
    }
    let safety = tree.texts.at(expression.safety.node);
    let text = safety.as_bytes();
    if mem::len(text) == 0 {
        var failure = try self.checker_error_at(
            "unsafe error", expression.span,
            "`unsafe` needs a `// SAFETY:` comment on its statement"
        );
        errdefer failure.deinit(self.allocator);
        try failure.with_code(self.allocator, "unsafe.missing_safety_comment");
        try failure.with_help(self.allocator, "write `// SAFETY: <why this holds>` on the line above");
        return move failure;
    }
    return null;
}

// Validates one function body against its signature.
fn (self: &var Checker) check_function(
    tree: &var ast::Ast,
    function: FunctionHandle
) -> !?diagnostic::Diagnostic {
    if self.function_is_extern(function) {
        return null;
    }
    // A body that calls a `Function` static parameter has no types until the
    // parameter is bound: the parameter names a function, and a function's
    // signature is not something the declaration says. Such a body is checked
    // once per instantiation instead, which is the only place the call has a
    // callee.
    if self.function_has_function_static_param(function) {
        return null;
    }
    let facts = try self.copy_instance_function_facts(function) orelse
        return try self.checker_error_at(
        "type error", ast::zero_span(), "missing function metadata"
    );
    defer facts.deinit(self.allocator);
    let body = facts.body orelse return null;
    let name = facts.name.as_bytes();
    if try self.check_main_return_type(name, facts.return_type) |problem| {
        return move problem;
    }
    let root = try self.scopes.new_scope(null);
    var static_values = map::new<[]u8, Type>(self.allocator);
    errdefer static_values.deinit(self.allocator);
    if try self.define_static_value_params(self.allocator, root, function, &var static_values) |problem| {
        static_values.deinit(self.allocator);
        return move problem;
    }
    let runtime_count = self.function_runtime_param_count(function);
    var index = 0;
    while index < runtime_count {
        if try self.copy_instance_param(function, index) |parameter| {
            defer parameter.deinit(self.allocator);
            let parameter_name = parameter.name.as_bytes();
            let defined = try self.define_scope_param(
                root,
                parameter_name,
                parameter.type_name,
                parameter.borrow,
                parameter.mutable,
                true
            );
            if try self.require_scope_definition(parameter_name, defined) |problem| {
                static_values.deinit(self.allocator);
                return move problem;
            }
        } else {
            static_values.deinit(self.allocator);
            return try self.checker_error_at(
                "type error",
                ast::zero_span(),
                "missing runtime parameter metadata"
            );
        }
        index = index + 1;
    }
    let type_params = try self.signature_type_params(self.allocator, function);
    let type_args = map::new<[]u8, Type>(self.allocator);
    let previous_context = try self.enter_body_context(
        CurrentFunction::Value(function),
        facts.std,
        facts.return_type,
        move type_params,
        move type_args,
        move static_values
    );
    let saved_mark = self.mark;
    self.mark = UnsafeMark { used: null };
    var returns = false;
    if try self.check_block(tree, root, body, facts.return_type, &var returns) |problem| {
        self.mark = saved_mark;
        self.restore_body_context(previous_context);
        return move problem;
    }
    self.mark = saved_mark;
    self.restore_body_context(previous_context);
    if !self.types.is_text(facts.return_type, "void") and
        !self.function_implicit_return(function) and !returns {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "function `");
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, "` must return ");
        try self.append_checker_type(&var message, facts.return_type);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    return null;
}

fn (self: &Checker) function_is_extern(function: FunctionHandle) -> bool {
    if self.metadata.functions.at(function.index) |value| {
        return value.signature.extern_abi.len() > 0;
    }
    return false;
}

fn (self: &Checker) function_implicit_return(function: FunctionHandle) -> bool {
    if self.metadata.functions.at(function.index) |value| {
        return value.implicit_return;
    }
    return false;
}

// Collects the type-valued static parameter names of one cached signature.
fn (self: &Checker) signature_type_params(allocator: Allocator, function: FunctionHandle) -> !map::Map<[]u8, bool> {
    var names = map::new<[]u8, bool>(self.allocator);
    errdefer names.deinit(self.allocator);
    if self.metadata.functions.at(function.index) |value| {
        var index = 0;
        while value.signature.static_params.at(index) |parameter| {
            if parameter.is_type {
                let name = parameter.name.as_bytes();
                try names.insert(allocator, name, true);
            }
            index = index + 1;
        }
    }
    return move names;
}

// Validates a top-level test block as an errorable, parameterless body. The
// synthetic function is retained in metadata only while its body is checked
// so the body sees it as the current function.
fn (self: &var Checker) check_test_decl(
    tree: &var ast::Ast,
    test: &ast::TestDecl
) -> !?diagnostic::Diagnostic {
    let retained_name = tree.texts.at(test.name.node);
    let source_name = retained_name.as_bytes();
    // The name carries the module so the body reads its own module's names --
    // a function pointer's value is looked up through the prefix of whatever
    // is being checked, and a synthetic name without one finds nothing.
    var name = string::new(self.allocator);
    errdefer name.deinit(self.allocator);
    let retained_module = tree.texts.at(test.module.node);
    let module_bytes = retained_module.as_bytes();
    if mem::len(module_bytes) > 0 {
        try name.append_bytes(self.allocator, module_bytes);
        try name.append_bytes(self.allocator, "::");
    }
    try name.append_bytes(self.allocator, "test ");
    try fmt::append_bytes_literal(self.allocator, &var name, source_name);
    let return_type = try self.types.intern("!void");
    let signature = FunctionSignatureType {
        extern_abi: string::new(self.allocator),
        export_abi: string::new(self.allocator),
        static_params: array::new<StaticParamType>(self.allocator),
        params: array::new<SignatureParamType>(self.allocator),
        return_type: empty_type(),
        requires_unsafe: false,
        std: false
    };
    let function = FunctionType {
        name: move name,
        signature: move signature,
        params: array::new<Type>(self.allocator),
        borrow_params: array::new<bool>(self.allocator),
        mut_borrow_params: array::new<bool>(self.allocator),
        return_type: return_type,
        body: test.body,
        implicit_return: true
    };
    let handle = FunctionHandle { index: self.metadata.functions.len() };
    try self.metadata.functions.append(self.allocator, move function);
    if try self.check_function(tree, handle) |problem| {
        self.discard_test_function();
        return move problem;
    }
    self.discard_test_function();
    return null;
}

fn (self: &var Checker) discard_test_function() -> void {
    let removed = self.metadata.functions.pop_or_panic();
    removed.deinit(self.allocator);
    return;
}
