import compiler::internal::ast;
import compiler::internal::diagnostic;
import std::mem;
import std::string;

// Computes the static type of one expression through the actual Checker
// dispatcher used by function and test bodies.
fn (self: &var Checker) check_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: ast::Expression,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.node) {
        Int(_) => return self.check_scalar_expr(tree, expression, out),
        String(_) => return self.check_scalar_expr(tree, expression, out),
        Bool(_) => return self.check_scalar_expr(tree, expression, out),
        Type(_) => return self.check_scalar_expr(tree, expression, out),
        Null(_) => return self.check_scalar_expr(tree, expression, out),
        Comptime(value) => {
            let copied = ast::ComptimeExpr { expr: value.expr };
            return self.check_comptime_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        Ident(value) => return self.check_ident_expr(
            tree, scopes, scope, value, out
        ),
        Prefix(value) => {
            let copied = ast::PrefixExpr {
                operator: value.operator, right: value.right
            };
            return self.check_prefix_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        Binary(value) => {
            let copied = ast::BinaryExpr {
                left: value.left,
                operator: value.operator,
                operator_span: value.operator_span,
                right: value.right
            };
            return self.check_binary_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        Call(value) => {
            let copied = ast::CallExpr {
                callee: value.callee, args: value.args
            };
            return self.check_call_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        TypeApply(_) => return try self.checker_error_at(
            "type error", expression_span(tree, expression),
            "unsupported expression TypeApply"
        ),
        Cast(value) => {
            let copied = ast::CastExpr {
                target_type: value.target_type,
                value: value.value,
                keyword_span: value.keyword_span
            };
            return self.check_cast_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        Try(value) => {
            let copied = ast::TryExpr { value: value.value };
            return self.check_try_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        Unsafe(value) => {
            let copied = ast::UnsafeExpr {
                value: value.value,
                safety: value.safety,
                span: value.span
            };
            return self.check_unsafe_expr(
                tree, scopes, scope, &copied, out
            );
        },
        Move(value) => return self.check_expr(
            tree, scopes, scope, mark, value.value, out
        ),
        Index(value) => {
            let copied = ast::IndexExpr {
                target: value.target,
                index: value.index,
                start: value.start,
                end: value.end,
                slice: value.slice,
                span: value.span
            };
            return self.check_index_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        StructLiteral(_) => return self.check_struct_literal_expr(
            tree, scopes, scope, mark, expression, out
        ),
        BufferLiteral(value) => {
            let text = try value.type_text(self.allocator);
            defer text.deinit();
            let bytes = text.as_bytes();
            out.* = try self.types.intern(bytes);
            return null;
        },
        Field(value) => {
            let copied = ast::FieldExpr {
                receiver: value.receiver,
                name: value.name,
                namespace: value.namespace,
                span: value.span
            };
            return self.check_field_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        Deref(value) => {
            let copied = ast::DerefExpr {
                receiver: value.receiver,
                operator_span: value.operator_span
            };
            return self.check_deref_expr(
                tree, scopes, scope, mark, &copied, out
            );
        },
        If(_) => return self.check_control_expr(
            tree, scopes, scope, mark, expression, out
        ),
        Match(_) => return self.check_control_expr(
            tree, scopes, scope, mark, expression, out
        ),
        OrelseGuard(_) => return self.check_control_expr(
            tree, scopes, scope, mark, expression, out
        ),
        Recovered(_) => return self.check_control_expr(
            tree, scopes, scope, mark, expression, out
        ),
    }
}

// Checks that runtime typing and compile-time evaluation agree.
fn (self: &var Checker) check_comptime_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: &ast::ComptimeExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var runtime_type = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression.expr, &var runtime_type
    ) |problem| {
        return move problem;
    }
    var value = ComptimeValue::Integer(0);
    if try self.eval_comptime(tree, expression.expr, &var value) |problem| {
        return move problem;
    }
    let evaluated_type = try self.comptime_value_type(value);
    if !same_type(evaluated_type, runtime_type) {
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes("expected ");
        try self.append_checker_type(&var message, runtime_type);
        try message.append_bytes(", got ");
        try self.append_checker_type(&var message, evaluated_type);
        return try self.checker_message_at(
            "comptime error", ast::zero_span(), move message
        );
    }
    out.* = runtime_type;
    return null;
}

fn (self: &var Checker) comptime_value_type(
    value: ComptimeValue
) -> !Type {
    return match value {
        Integer(_) => try self.types.i64_type(),
        Boolean(_) => try self.types.bool_type(),
        Bytes(_) => try self.types.byte_string_type(),
        TypeValue(_) => try self.types.type_value_type(),
    };
}

// Validates unary operators and explicit local borrow syntax.
fn (self: &var Checker) check_prefix_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: &ast::PrefixExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let retained = tree.texts.at(expression.operator.node);
    let source_operator = retained.as_bytes();
    let owned_operator = try string::from_bytes(
        self.allocator, source_operator
    );
    defer owned_operator.deinit();
    let operator = owned_operator.as_bytes();
    if mem::equal_bytes(operator, "&") or
        mem::equal_bytes(operator, "&var") {
        var mutable = false;
        return self.check_borrow_prefix(
            tree, scopes, scope, mark, expression, out, &var mutable
        );
    }
    var right = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression.right, &var right
    ) |problem| {
        return move problem;
    }
    if mem::equal_bytes(operator, "-") {
        if !self.checker_signed_numeric_type(right) {
            return try self.unary_type_error(
                operator, "signed numeric", right
            );
        }
        out.* = right;
        return null;
    }
    if mem::equal_bytes(operator, "!") {
        if !self.types.is_text(right, "bool") {
            return try self.unary_type_error(operator, "bool", right);
        }
        out.* = try self.types.bool_type();
        return null;
    }
    var message = string::new(self.allocator);
    errdefer message.deinit();
    try message.append_bytes("unsupported unary `");
    try message.append_bytes(operator);
    try message.append_byte(cast<u8>(96));
    return try self.checker_message_at(
        "type error", ast::zero_span(), move message
    );
}

fn (self: &Checker) unary_type_error(
    operator: []u8,
    want: []u8,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit();
    try message.append_bytes("unary ");
    try message.append_bytes(operator);
    try message.append_bytes(" expects ");
    try message.append_bytes(want);
    try message.append_bytes(", got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at(
        "type error", ast::zero_span(), move message
    );
}

fn (self: &Checker) checker_signed_numeric_type(value: Type) -> bool {
    if value.node |handle| {
        let entry = self.types.entries.at(handle);
        let bytes = entry.spelling.as_bytes();
        return is_signed_numeric_type(bytes);
    }
    return false;
}

fn (self: &Checker) checker_numeric_type(value: Type) -> bool {
    if value.node |handle| {
        let entry = self.types.entries.at(handle);
        let bytes = entry.spelling.as_bytes();
        return is_numeric_type(bytes);
    }
    return false;
}

// Validates arithmetic, logical, equality, and comparison operators.
fn (self: &var Checker) check_binary_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: &ast::BinaryExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let retained = tree.texts.at(expression.operator.node);
    let source_operator = retained.as_bytes();
    let owned_operator = try string::from_bytes(
        self.allocator, source_operator
    );
    defer owned_operator.deinit();
    let operator = owned_operator.as_bytes();
    if mem::equal_bytes(operator, "orelse") {
        return self.check_orelse_expr(
            tree, scopes, scope, mark, expression, out
        );
    }
    var left = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression.left, &var left
    ) |problem| {
        return move problem;
    }
    var right = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression.right, &var right
    ) |problem| {
        return move problem;
    }
    if mem::equal_bytes(operator, "and") or
        mem::equal_bytes(operator, "or") {
        return self.check_logical(
            operator, left, right, expression.operator_span, out
        );
    }
    if mem::equal_bytes(operator, "==") or
        mem::equal_bytes(operator, "!=") {
        return self.check_equality(
            operator, left, right, expression.operator_span, out
        );
    }
    if !same_type(left, right) {
        return try self.operator_type_mismatch(
            operator, left, right, expression.operator_span
        );
    }
    if !self.checker_numeric_type(left) {
        return try self.operator_operand_kind_error(
            operator, "numeric", left, right, expression.operator_span
        );
    }
    if mem::equal_bytes(operator, "%") and
        !self.checker_integer_type(left) {
        return try self.operator_operand_kind_error(
            operator, "integer", left, right, expression.operator_span
        );
    }
    if is_comparison(operator) {
        out.* = try self.types.bool_type();
        return null;
    }
    out.* = left;
    return null;
}

// Types optional fallback expressions.
fn (self: &var Checker) check_orelse_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: &ast::BinaryExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var left = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression.left, &var left
    ) |problem| {
        return move problem;
    }
    var elem = empty_type();
    if try self.types.optional_elem(left) |present| {
        elem = present;
    } else {
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes("`orelse` expects an optional left operand, got ");
        try self.append_checker_type(&var message, left);
        return try self.checker_message_at(
            "type error", ast::zero_span(), move message
        );
    }
    var right = empty_type();
    if try self.check_contextual_expr(
        tree, scopes, scope, mark, expression.right, elem, &var right
    ) |problem| {
        return move problem;
    }
    if !same_type(right, elem) {
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes("`orelse` default must be ");
        try self.append_checker_type(&var message, elem);
        try message.append_bytes(", got ");
        try self.append_checker_type(&var message, right);
        return try self.checker_message_at(
            "type error", ast::zero_span(), move message
        );
    }
    out.* = elem;
    return null;
}

// Applies optional context and integer-literal narrowing to an expression.
fn (self: &var Checker) check_contextual_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: ast::Expression,
    want: Type,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.node) {
        Null(_) => {
            if try self.types.optional_elem(want) |_| {
                out.* = want;
                return null;
            }
            var message = string::new(self.allocator);
            errdefer message.deinit();
            try message.append_bytes("`null` needs an optional context, expected ");
            try self.append_checker_type(&var message, want);
            return try self.checker_message_at(
                "type error", ast::zero_span(), move message
            );
        },
        _ => {},
    }
    var got = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression, &var got
    ) |problem| {
        return move problem;
    }
    if try self.types.optional_elem(want) |_| {
        var wrapped = false;
        if try self.wraps_into_optional(
            tree, expression, want, got, &var wrapped
        ) |problem| {
            return move problem;
        }
        if wrapped {
            out.* = want;
            return null;
        }
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes("expected ");
        try self.append_checker_type(&var message, want);
        try message.append_bytes(", got ");
        try self.append_checker_type(&var message, got);
        return try self.checker_message_at(
            "type error", ast::zero_span(), move message
        );
    }
    return self.coerce_contextual_integer_literal(
        tree, expression, want, got, out
    );
}

// Validates checked byte indexing and one-dimensional slicing.
fn (self: &var Checker) check_index_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: &ast::IndexExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var target = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression.target, &var target
    ) |problem| {
        return move problem;
    }
    if !self.types.is_text(target, "[]u8") {
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes("index/slice target expects []u8, got ");
        try self.append_checker_type(&var message, target);
        return try self.checker_message_at(
            "type error", ast::zero_span(), move message
        );
    }
    if !expression.slice {
        if try self.check_index_bound(
            tree, scopes, scope, mark, "index", expression.index
        ) |problem| {
            return move problem;
        }
        out.* = try self.types.u8_type();
        return null;
    }
    if expression.start |_| {
        if try self.check_index_bound(
            tree, scopes, scope, mark, "slice start", expression.start
        ) |problem| {
            return move problem;
        }
    }
    if expression.end |_| {
        if try self.check_index_bound(
            tree, scopes, scope, mark, "slice end", expression.end
        ) |problem| {
            return move problem;
        }
    }
    out.* = target;
    return null;
}

fn (self: &var Checker) check_index_bound(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    name: []u8,
    expression: ?ast::Expression
) -> !?diagnostic::Diagnostic {
    if expression |present| {
        var got = empty_type();
        if try self.check_expr(
            tree, scopes, scope, mark, present, &var got
        ) |problem| {
            return move problem;
        }
        if self.types.is_text(got, "i64") {
            return null;
        }
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes(name);
        try message.append_bytes(" expects i64, got ");
        try self.append_checker_type(&var message, got);
        return try self.checker_message_at(
            "type error", ast::zero_span(), move message
        );
    }
    var message = string::new(self.allocator);
    errdefer message.deinit();
    try message.append_bytes(name);
    try message.append_bytes(" is missing");
    return try self.checker_message_at(
        "type error", ast::zero_span(), move message
    );
}

// Validates explicit numeric and raw-pointer casts.
fn (self: &var Checker) check_cast_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: &ast::CastExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var target = empty_type();
    match try self.resolve_type_node(tree, expression.target_type) {
        Value(value) => {
            target = value;
        },
        Issue(issue) => return try self.type_resolution_diagnostic(issue),
    }
    var source = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression.value, &var source
    ) |problem| {
        return move problem;
    }
    if self.checker_numeric_type(source) and
        self.checker_numeric_type(target) {
        out.* = target;
        return null;
    }
    if self.types.is_pointer_type(source) and
        self.types.is_pointer_type(target) {
        if try self.require_unsafe_capability_at(
            mark,
            UnsafeCapability::PtrCast,
            "pointer cast",
            expression.keyword_span
        ) |problem| {
            return move problem;
        }
        out.* = target;
        return null;
    }
    var message = string::new(self.allocator);
    errdefer message.deinit();
    try message.append_bytes("cannot cast ");
    try self.append_checker_type(&var message, source);
    try message.append_bytes(" to ");
    try self.append_checker_type(&var message, target);
    return try self.checker_message_at(
        "type error", ast::zero_span(), move message
    );
}

// Checks one explicit unsafe marker under an isolated use record.
fn (self: &var Checker) check_unsafe_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    expression: &ast::UnsafeExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var inner = UnsafeMark { used: false };
    if try self.check_expr(
        tree, scopes, scope, &var inner, expression.value, out
    ) |problem| {
        return move problem;
    }
    return self.check_under_mark(tree, expression, &inner);
}

// Validates error-union propagation and returns its success type.
fn (self: &var Checker) check_try_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: &ast::TryExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let current_return = self.current_return_type();
    if try self.types.error_union_parts(current_return) |_| {} else {
        return try self.checker_error_at(
            "type error", ast::zero_span(),
            "try requires function to return !T"
        );
    }
    var source = empty_type();
    if try self.check_expr(
        tree, scopes, scope, mark, expression.value, &var source
    ) |problem| {
        return move problem;
    }
    var source_error = empty_type();
    var success = empty_type();
    if try self.types.error_union_parts(source) |parts| {
        source_error = parts.err;
        success = parts.success;
    } else {
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes("try expects !T, got ");
        try self.append_checker_type(&var message, source);
        return try self.checker_message_at(
            "type error", ast::zero_span(), move message
        );
    }
    var target_error = empty_type();
    if try self.types.error_union_parts(current_return) |parts| {
        target_error = parts.err;
    }
    if !same_type(target_error, empty_type()) and
        !same_type(source_error, target_error) {
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes("try cannot propagate ");
        try self.append_checker_type(&var message, source_error);
        try message.append_bytes(" from ");
        try self.append_checker_type(&var message, source);
        return try self.checker_message_at(
            "type error", ast::zero_span(), move message
        );
    }
    out.* = success;
    return null;
}

// Routes statement-compatible control flow used as an expression.
fn (self: &var Checker) check_control_expr(
    tree: &var ast::Ast,
    scopes: &var ScopeStore,
    scope: ScopeHandle,
    mark: &var UnsafeMark,
    expression: ast::Expression,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.node) {
        If(value) => return self.check_if_expr(
            tree, scopes, scope, mark, value, out
        ),
        Match(value) => return self.check_match_expr(
            tree, scopes, scope, mark, value, out
        ),
        OrelseGuard(value) => return self.check_orelse_guard_expr(
            tree, scopes, scope, mark, value, out
        ),
        _ => return try self.checker_error_at(
            "type error", expression_span(tree, expression),
            "unsupported expression"
        ),
    }
}
