import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::typ;
import std::array;
import std::fmt;
import std::mem;
import std::string;

enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    And,
    Or,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    Orelse,
    Catch,
    Other,
}

fn classify_binary_op(op: []u8) -> BinaryOp {
    let n = mem::len(op);
    if n == 1 {
        let b = op[0];
        if b == cast<u8>(43) { return BinaryOp::Add; }
        if b == cast<u8>(45) { return BinaryOp::Sub; }
        if b == cast<u8>(42) { return BinaryOp::Mul; }
        if b == cast<u8>(47) { return BinaryOp::Div; }
        if b == cast<u8>(37) { return BinaryOp::Mod; }
        if b == cast<u8>(60) { return BinaryOp::Lt; }
        if b == cast<u8>(62) { return BinaryOp::Gt; }
        if b == cast<u8>(38) { return BinaryOp::BitAnd; }
        if b == cast<u8>(124) { return BinaryOp::BitOr; }
        if b == cast<u8>(94) { return BinaryOp::BitXor; }
        return BinaryOp::Other;
    }
    if n == 2 {
        if mem::equal_bytes(op, "==") { return BinaryOp::Eq; }
        if mem::equal_bytes(op, "!=") { return BinaryOp::Ne; }
        if mem::equal_bytes(op, "<=") { return BinaryOp::Le; }
        if mem::equal_bytes(op, ">=") { return BinaryOp::Ge; }
        if mem::equal_bytes(op, "or") { return BinaryOp::Or; }
        if mem::equal_bytes(op, "<<") { return BinaryOp::Shl; }
        if mem::equal_bytes(op, ">>") { return BinaryOp::Shr; }
        return BinaryOp::Other;
    }
    if mem::equal_bytes(op, "and") { return BinaryOp::And; }
    if mem::equal_bytes(op, "orelse") { return BinaryOp::Orelse; }
    if mem::equal_bytes(op, "catch") { return BinaryOp::Catch; }
    return BinaryOp::Other;
}

fn binary_op_text(op: BinaryOp) -> []u8 {
    return match op {
        Add => "+",
        Sub => "-",
        Mul => "*",
        Div => "/",
        Mod => "%",
        Eq => "==",
        Ne => "!=",
        Lt => "<",
        Le => "<=",
        Gt => ">",
        Ge => ">=",
        And => "and",
        Or => "or",
        BitAnd => "&",
        BitOr => "|",
        BitXor => "^",
        Shl => "<<",
        Shr => ">>",
        Orelse => "orelse",
        Catch => "catch",
        Other => "",
    };
}

fn (self: &var Checker) check_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if try self.check_expr_ok(tree, scope, expression, out) {
        return self.take_failure();
    }
    return null;
}

fn (self: &var Checker) check_expr_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type
) -> !bool {
    if try self.check_expr_form_ok(tree, scope, expression, out) {
        if !self.checking_std() {
            self.locate_failure(expression_span(tree, expression));
        }
        return true;
    }
    if self.editor.len() > 0 {
        try self.record_expression(tree.expression_extent(expression), out.*);
    }
    return false;
}

fn (self: &var Checker) check_expr_form_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type
) -> !bool {
    match tree.expressions.at(expression.node) {
        Int(_) => return self.check_scalar_expr_ok(tree, expression, out),
        Float(_) => return self.check_scalar_expr_ok(tree, expression, out),
        String(_) => return self.check_scalar_expr_ok(tree, expression, out),
        CString(_) => return self.check_scalar_expr_ok(tree, expression, out),
        Bool(_) => return self.check_scalar_expr_ok(tree, expression, out),
        Type(_) => return self.check_scalar_expr_ok(tree, expression, out),
        Null(_) => return self.check_scalar_expr_ok(tree, expression, out),
        Comptime(value) => {
            let copied = ast::ComptimeExpr { expr: value.expr };
            if try self.check_comptime_expr(tree, scope, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Ident(value) => return self.check_ident_expr_ok(tree, scope, value, out),
        Prefix(value) => {
            let copied = ast::PrefixExpr {
                operator: value.operator, right: value.right
            };
            if try self.check_prefix_expr(tree, scope, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Binary(value) => {
            let copied = ast::BinaryExpr {
                left: value.left,
                operator: value.operator,
                operator_span: value.operator_span,
                right: value.right
            };
            return self.check_binary_expr_ok(tree, scope, &copied, out);
        },
        Call(value) => {
            let copied = ast::CallExpr {
                callee: value.callee, args: value.args
            };
            return self.check_call_expr_ok(tree, scope, &copied, out);
        },
        TypeApply(_) => {
            let problem = try self.checker_error_at(
                "type error", expression_span(tree, expression),
                "unsupported expression TypeApply"
            );
            return self.fail(move problem);
        },
        Cast(value) => {
            let copied = ast::CastExpr {
                target_type: value.target_type,
                value: value.value,
                keyword_span: value.keyword_span
            };
            if try self.check_cast_expr(tree, scope, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Try(value) => {
            let copied = ast::TryExpr { value: value.value };
            if try self.check_try_expr(tree, scope, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Unsafe(value) => {
            let copied = ast::UnsafeExpr {
                value: value.value,
                span: value.span
            };
            if try self.check_unsafe_expr(tree, scope, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Move(value) => return self.check_expr_ok(tree, scope, value.value, out),
        Index(value) => {
            let copied = ast::IndexExpr {
                target: value.target,
                index: value.index,
                start: value.start,
                end: value.end,
                slice: value.slice,
                span: value.span
            };
            if try self.check_index_expr(tree, scope, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        StructLiteral(_) => return self.check_struct_literal_expr_ok(tree, scope, expression, out),
        VectorLiteral(_) => {
            if try ast::copy_vector_literal(self.allocator, tree, expression) |literal| {
                defer literal.deinit(self.allocator);
                if try self.check_vector_literal_expr(tree, scope, &literal, out) |problem| {
                    return self.fail(move problem);
                }
                return false;
            }
            let problem = try self.checker_error_at(
                "type error", ast::zero_span(), "vector literal reached the node dispatch");
            return self.fail(move problem);
        },
        BufferLiteral(_) => {
            if try ast::copy_array_literal(self.allocator, tree, expression) |literal| {
                defer literal.deinit(self.allocator);
                if try self.check_array_literal_expr(tree, scope, &literal, out) |problem| {
                    return self.fail(move problem);
                }
                return false;
            }
            let problem = try self.checker_error_at(
                "type error", ast::zero_span(), "array literal reached the node dispatch");
            return self.fail(move problem);
        },
        Field(value) => {
            let copied = ast::FieldExpr {
                receiver: value.receiver,
                name: value.name,
                namespace: value.namespace,
                span: value.span
            };
            return self.resolve_field_expr_ok(tree, scope, &copied, false, out);
        },
        Deref(value) => {
            let copied = ast::DerefExpr {
                receiver: value.receiver,
                operator_span: value.operator_span
            };
            if try self.check_deref_expr(tree, scope, &copied, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        If(_) => {
            if try self.check_control_expr(tree, scope, expression, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Match(_) => {
            if try self.check_control_expr(tree, scope, expression, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        OrelseGuard(_) => {
            if try self.check_control_expr(tree, scope, expression, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        CatchGuard(_) => {
            if try self.check_control_expr(tree, scope, expression, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
        Recovered(_) => {
            if try self.check_control_expr(tree, scope, expression, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        },
    }
}

fn (self: &var Checker) check_comptime_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::ComptimeExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var runtime_type = empty_type();
    if try self.check_expr(tree, scope, expression.expr, &var runtime_type) |problem| {
        return move problem;
    }
    var value = ComptimeValue::Integer(0);
    if try self.eval_comptime(tree, expression.expr, &var value) |problem| {
        return move problem;
    }
    let evaluated_type = try self.comptime_value_type(value);
    if !same_type(evaluated_type, runtime_type) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "expected ");
        try self.append_checker_type(&var message, runtime_type);
        try message.append_bytes(self.allocator, ", got ");
        try self.append_checker_type(&var message, evaluated_type);
        return try self.checker_message_at("comptime error", ast::zero_span(), move message);
    }
    out.* = runtime_type;
    return null;
}

fn (self: &var Checker) comptime_value_type(value: ComptimeValue) -> !Type {
    return match value {
        Integer(_) => try self.types.i64_type(),
        Float(_) => try self.types.intern("f64"),
        Boolean(_) => try self.types.bool_type(),
        Bytes(_) => try self.types.byte_string_type(),
        TypeValue(_) => try self.types.type_value_type(),
    };
}

fn (self: &var Checker) check_prefix_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::PrefixExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let retained = tree.texts.at(expression.operator.node);
    let source_operator = retained.as_bytes();
    let owned_operator = try string::from_bytes(self.allocator, source_operator);
    defer owned_operator.deinit(self.allocator);
    let operator = owned_operator.as_bytes();
    if mem::equal_bytes(operator, "&") or
        mem::equal_bytes(operator, "&var") {
        var mutable = false;
        return self.check_borrow_prefix(tree, scope, expression, out, &var mutable);
    }
    var right = empty_type();
    if try self.check_expr(tree, scope, expression.right, &var right) |problem| {
        return move problem;
    }
    if mem::equal_bytes(operator, "-") {
        let kind = try self.vector_kind_of(right);
        if kind >= 0 {
            let lane = typ::vector_lane_of_kind(kind);
            if !is_signed_numeric_type(lane) {
                return try self.unary_type_error(operator, "signed lanes", right);
            }
            out.* = right;
            return null;
        }
        if !self.checker_signed_numeric_type(right) {
            return try self.unary_type_error(operator, "signed numeric", right);
        }
        out.* = right;
        return null;
    }
    if mem::equal_bytes(operator, "!") {
        if !self.types.is_text(right, "bool") {
            return try self.unary_type_error(operator, "bool", right);
        }
        out.* = try self.types.bool_type();
        return null;
    }
    if mem::equal_bytes(operator, "~") {
        let kind = try self.vector_kind_of(right);
        if kind >= 0 {
            let lane = typ::vector_lane_of_kind(kind);
            if mem::equal_bytes(lane, "f32") or mem::equal_bytes(lane, "f64") {
                return try self.unary_type_error(operator, "integer lanes", right);
            }
            out.* = right;
            return null;
        }
        if !self.checker_integer_type(right) {
            return try self.unary_type_error(operator, "integer", right);
        }
        out.* = right;
        return null;
    }
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "unsupported unary `");
    try message.append_bytes(self.allocator, operator);
    try message.append_byte(self.allocator, cast<u8>(96));
    return try self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) unary_type_error(
    operator: []u8,
    want: []u8,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "unary ");
    try message.append_bytes(self.allocator, operator);
    try message.append_bytes(self.allocator, " expects ");
    try message.append_bytes(self.allocator, want);
    try message.append_bytes(self.allocator, ", got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) checker_signed_numeric_type(value: Type) -> bool {
    return self.types.is_signed_numeric_fast(value);
}

fn (self: &Checker) checker_numeric_type(value: Type) -> bool {
    return self.types.is_numeric_fast(value);
}

fn is_borrow_prefix(tree: &ast::Ast, expression: ast::Expression) -> bool {
    match tree.expressions.at(expression.node) {
        Prefix(value) => {
            let retained = tree.texts.at(value.operator.node);
            let operator = retained.as_bytes();
            return mem::equal_bytes(operator, "&") or mem::equal_bytes(operator, "&var");
        },
        _ => return false,
    }
}

fn (self: &var Checker) borrow_operand_of_bit_and(span: ast::Span) -> !?diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator,
        "type error: `&&` is not an operator; logical and is written `and`");
    try message.append_byte(self.allocator, cast<u8>(10));
    try message.append_bytes(self.allocator,
        "note: `a && b` reads as `a & &b`, and a borrow is not an operand of `&`");
    return try self.checker_text_diagnostic_at(span, move message);
}

fn (self: &var Checker) check_binary_expr_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::BinaryExpr,
    out: &var Type
) -> !bool {
    let op = classify_binary_op(semantic_text(tree, expression.operator));
    if op == BinaryOp::Orelse {
        if try self.check_orelse_expr(tree, scope, expression, out) |problem| {
            return self.fail(move problem);
        }
        return false;
    }
    if op == BinaryOp::Catch {
        if try self.check_catch_expr(tree, scope, expression, out) |problem| {
            return self.fail(move problem);
        }
        return false;
    }
    var left = empty_type();
    if try self.check_expr_ok(tree, scope, expression.left, &var left) {
        return true;
    }
    var right = empty_type();
    if try self.check_expr_ok(tree, scope, expression.right, &var right) {
        return true;
    }
    if op == BinaryOp::And or op == BinaryOp::Or {
        return self.check_logical_ok(binary_op_text(op), left, right, expression.operator_span, out);
    }
    if !same_type(left, right) {
        if try self.coerce_binary_literal(tree, expression, &var left, &var right) |problem| {
            return self.fail(move problem);
        }
    }
    if self.types.is_vector_fast(left) or self.types.is_vector_fast(right) {
        let operator = if op == BinaryOp::Other {
            semantic_text(tree, expression.operator)
        } else {
            binary_op_text(op)
        };
        if try self.check_vector_operands(operator, left, right, expression.operator_span, out) |problem| {
            return self.fail(move problem);
        }
        return false;
    }
    if op == BinaryOp::Eq or op == BinaryOp::Ne {
        return self.check_equality_ok(binary_op_text(op), left, right, expression.operator_span, out);
    }
    if op == BinaryOp::BitAnd and is_borrow_prefix(tree, expression.right) {
        if try self.borrow_operand_of_bit_and(expression.operator_span) |problem| {
            return self.fail(move problem);
        }
        return false;
    }
    if !same_type(left, right) {
        let operator = if op == BinaryOp::Other {
            semantic_text(tree, expression.operator)
        } else {
            binary_op_text(op)
        };
        let problem = try self.operator_type_mismatch(operator, left, right, expression.operator_span);
        return self.fail(move problem);
    }
    if !self.types.is_numeric_fast(left) {
        let operator = if op == BinaryOp::Other {
            semantic_text(tree, expression.operator)
        } else {
            binary_op_text(op)
        };
        let problem = try self.operator_operand_kind_error(
            operator, "numeric", left, right, expression.operator_span
        );
        return self.fail(move problem);
    }
    let is_int_only = match op {
        Mod => true,
        BitAnd => true,
        BitOr => true,
        BitXor => true,
        Shl => true,
        Shr => true,
        _ => false,
    };
    if is_int_only and !self.types.is_integer_fast(left) {
        let problem = try self.operator_operand_kind_error(
            binary_op_text(op), "integer", left, right, expression.operator_span
        );
        return self.fail(move problem);
    }
    if op == BinaryOp::Shl or op == BinaryOp::Shr {
        if try self.check_shift_literal(tree, expression, binary_op_text(op)) |problem| {
            return self.fail(move problem);
        }
    }
    let is_cmp = match op {
        Lt => true,
        Le => true,
        Gt => true,
        Ge => true,
        _ => false,
    };
    if is_cmp {
        out.* = try self.types.bool_type();
        return false;
    }
    out.* = left;
    return false;
}

fn (self: &var Checker) vector_kind_of(value: Type) -> !i64 {
    return self.types.vector_kind_fast(value);
}

fn (self: &var Checker) check_vector_operands(
    operator: []u8,
    left: Type,
    right: Type,
    span: ast::Span,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if !same_type(left, right) {
        return try self.operator_type_mismatch(operator, left, right, span);
    }
    let kind = try self.vector_kind_of(left);
    if kind < 0 {
        return null;
    }
    let lane = typ::vector_lane_of_kind(kind);
    if mem::equal_bytes(operator, "+") or mem::equal_bytes(operator, "-") or
        mem::equal_bytes(operator, "*") {
        out.* = left;
        return null;
    }
    if mem::equal_bytes(operator, "&") or mem::equal_bytes(operator, "|") or
        mem::equal_bytes(operator, "^") {
        if !mem::equal_bytes(lane, "f32") and !mem::equal_bytes(lane, "f64") {
            out.* = left;
            return null;
        }
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "operator `");
        try message.append_bytes(self.allocator, operator);
        try message.append_bytes(self.allocator, "` on a vector expects integer lanes, got ");
        try self.append_checker_type(&var message, left);
        return try self.checker_message_at("type error", span, move message);
    }
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    if mem::equal_bytes(operator, "/") {
        if mem::equal_bytes(lane, "f32") or mem::equal_bytes(lane, "f64") {
            message.deinit(self.allocator);
            out.* = left;
            return null;
        }
        try message.append_bytes(self.allocator, "operator `/` on a vector expects float lanes, got ");
        try self.append_checker_type(&var message, left);
        return try self.checker_message_at("type error", span, move message);
    }
    try message.append_bytes(self.allocator, "operator `");
    try message.append_bytes(self.allocator, operator);
    try message.append_bytes(self.allocator, "` is not defined on a vector (");
    try self.append_checker_type(&var message, left);
    try message.append_byte(self.allocator, cast<u8>(41));
    return try self.checker_message_at("type error", span, move message);
}

fn (self: &var Checker) check_array_literal_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::BufferLiteralExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let text = try expression.type_text(self.allocator, tree);
    defer text.deinit(self.allocator);
    let array_bytes = text.as_bytes();
    var array_type = empty_type();
    match try self.resolve_type(tree, array_bytes) {
        Value(value) => {
            array_type = value;
        },
        Issue(issue) => return try self.type_resolution_diagnostic(issue),
    }
    if self.types.has_static_length(array_type) {
        var message = try string::from_bytes(self.allocator, "`");
        errdefer message.deinit(self.allocator);
        try self.append_checker_type(&var message, array_type);
        try message.append_bytes(self.allocator, "` has no length here");
        return try self.checker_message_at("internal error", expression.span, move message);
    }
    let size = self.types.buffer_size(array_type) orelse 0;
    let elem = try self.types.buffer_elem(array_type) orelse array_type;
    var seen = array::new<Type>(self.allocator);
    defer seen.deinit(self.allocator);
    if !try self.is_plain_data_type(tree, elem, &var seen) {
        var message = try string::from_bytes(self.allocator,
            "an array holds copy data (numbers, bool, enums, copy structs, arrays of them), got ");
        errdefer message.deinit(self.allocator);
        try self.append_checker_type(&var message, elem);
        return try self.checker_message_at("type error", expression.span, move message);
    }
    if expression.elements.len() == 0 {
        if !try self.zero_fillable(elem) {
            var message = try string::from_bytes(self.allocator, "`");
            errdefer message.deinit(self.allocator);
            try self.append_checker_type(&var message, array_type);
            try message.append_bytes(self.allocator, "{}` fills with zero, which only numbers and bool have; list the ");
            try fmt::append_i64(self.allocator, &var message, size);
            try message.append_bytes(self.allocator, " elements");
            return try self.checker_message_at("type error", expression.span, move message);
        }
        out.* = array_type;
        return null;
    }
    if expression.elements.len() != size {
        var message = try string::from_bytes(self.allocator, "`");
        errdefer message.deinit(self.allocator);
        try self.append_checker_type(&var message, array_type);
        try message.append_bytes(self.allocator, "` has ");
        try fmt::append_i64(self.allocator, &var message, size);
        try message.append_bytes(self.allocator, " elements, got ");
        try fmt::append_i64(self.allocator, &var message, expression.elements.len());
        try message.append_bytes(self.allocator, " values");
        return try self.checker_message_at("type error", expression.span, move message);
    }
    var index = 0;
    while expression.elements.get(index) |value| {
        var got = empty_type();
        if try self.check_contextual_expr(tree, scope, value, elem, &var got) |problem| {
            return move problem;
        }
        if !same_type(got, elem) {
            var message = try string::from_bytes(self.allocator, "element ");
            errdefer message.deinit(self.allocator);
            try fmt::append_i64(self.allocator, &var message, index);
            try message.append_bytes(self.allocator, " of `");
            try self.append_checker_type(&var message, array_type);
            try message.append_bytes(self.allocator, "` expects ");
            try self.append_checker_type(&var message, elem);
            try message.append_bytes(self.allocator, ", got ");
            try self.append_checker_type(&var message, got);
            return try self.checker_message_at("type error", expression_span(tree, value), move message);
        }
        index = index + 1;
    }
    out.* = array_type;
    return null;
}

fn (self: &var Checker) zero_fillable(elem: Type) -> !bool {
    let text = try self.types.copy_text(self.allocator, elem);
    defer text.deinit(self.allocator);
    let bytes = text.as_bytes();
    if is_numeric_type(bytes) or self.types.is_text(elem, "bool") {
        return true;
    }
    if try self.types.buffer_elem(elem) |inner| {
        return self.zero_fillable(inner);
    }
    return false;
}

fn (self: &var Checker) check_vector_literal_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::VectorLiteralExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let retained = tree.texts.at(expression.type_name.node);
    let name = retained.as_bytes();
    let kind = typ::vector_kind(name);
    if kind < 0 {
        return try self.checker_error_at("type error", expression.span, "not a vector type");
    }
    let lane = typ::vector_lane_of_kind(kind);
    let lanes = typ::vector_lanes(name);
    if expression.lanes.len() != lanes {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, "` has ");
        try fmt::append_i64(self.allocator, &var message, lanes);
        try message.append_bytes(self.allocator, " lanes, got ");
        try fmt::append_i64(self.allocator, &var message, expression.lanes.len());
        try message.append_bytes(self.allocator, " values");
        return try self.checker_message_at("type error", expression.span, move message);
    }
    let lane_type = try self.types.intern(lane);
    let vector_type = try self.types.intern(name);
    var index = 0;
    while expression.lanes.get(index) |value| {
        var got = empty_type();
        if try self.check_contextual_expr(tree, scope, value, lane_type, &var got) |problem| {
            return move problem;
        }
        if !same_type(got, lane_type) {
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, "lane ");
            try fmt::append_i64(self.allocator, &var message, index);
            try message.append_bytes(self.allocator, " of `");
            try self.append_checker_type(&var message, vector_type);
            try message.append_bytes(self.allocator, "` expects ");
            try self.append_checker_type(&var message, lane_type);
            try message.append_bytes(self.allocator, ", got ");
            try self.append_checker_type(&var message, got);
            return try self.checker_message_at("type error", expression_span(tree, value), move message);
        }
        index = index + 1;
    }
    out.* = vector_type;
    return null;
}

fn (self: &var Checker) check_vector_lane(
    tree: &ast::Ast,
    expression: &ast::IndexExpr,
    target: Type,
    lane: []u8,
    lanes: i64,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if expression.slice {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "a vector has lanes, not a range; `");
        try self.append_checker_type(&var message, target);
        try message.append_bytes(self.allocator, "[a..b]` is not a view");
        return try self.checker_message_at("type error", expression.span, move message);
    }
    let index_expr = expression.index orelse
        return try self.checker_error_at("type error", expression.span, "index is missing");
    var index = -1;
    if integer_literal_value(tree, index_expr) |value| {
        index = value;
    } else {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "a vector lane is named by an integer literal, got `");
        let rendered = try ast::render_expression(self.allocator, tree, index_expr);
        defer rendered.deinit(self.allocator);
        let rendered_bytes = rendered.as_bytes();
        try message.append_bytes(self.allocator, rendered_bytes);
        try message.append_byte(self.allocator, cast<u8>(96));
        return try self.checker_message_at("type error", expression.span, move message);
    }
    if index < 0 or index >= lanes {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "lane ");
        try fmt::append_i64(self.allocator, &var message, index);
        try message.append_bytes(self.allocator, " is outside `");
        try self.append_checker_type(&var message, target);
        try message.append_bytes(self.allocator, "`, which has lanes 0..");
        try fmt::append_i64(self.allocator, &var message, lanes);
        return try self.checker_message_at("type error", expression.span, move message);
    }
    out.* = try self.types.intern(lane);
    return null;
}

fn (self: &var Checker) check_orelse_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::BinaryExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var left = empty_type();
    if try self.check_expr(tree, scope, expression.left, &var left) |problem| {
        return move problem;
    }
    var elem = empty_type();
    if try self.types.openable_elem(left) |present| {
        elem = present;
    } else {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "`orelse` expects an optional left operand, got ");
        try self.append_checker_type(&var message, left);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    var right = empty_type();
    if try self.check_contextual_expr(tree, scope, expression.right, elem, &var right) |problem| {
        return move problem;
    }
    if !same_type(right, elem) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "`orelse` default must be ");
        try self.append_checker_type(&var message, elem);
        try message.append_bytes(self.allocator, ", got ");
        try self.append_checker_type(&var message, right);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    out.* = elem;
    return null;
}

fn (self: &var Checker) check_catch_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::BinaryExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var left = empty_type();
    if try self.check_expr(tree, scope, expression.left, &var left) |problem| {
        return move problem;
    }
    var elem = empty_type();
    if try self.catch_success_type(left, &var elem) |problem| {
        return move problem;
    }
    var right = empty_type();
    if try self.check_contextual_expr(tree, scope, expression.right, elem, &var right) |problem| {
        return move problem;
    }
    if !same_type(right, elem) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "`catch` default must be ");
        try self.append_checker_type(&var message, elem);
        try message.append_bytes(self.allocator, ", got ");
        try self.append_checker_type(&var message, right);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    out.* = elem;
    return null;
}

fn (self: &var Checker) catch_success_type(union_type: Type, out: &var Type) -> !?diagnostic::Diagnostic {
    var error_type = empty_type();
    var success = empty_type();
    if try self.types.error_union_parts(union_type) |parts| {
        error_type = parts.err;
        success = parts.success;
    } else {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "`catch` expects an error union left operand, got ");
        try self.append_checker_type(&var message, union_type);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    if same_type(error_type, empty_type()) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "`catch` requires a declared error set; `!");
        try self.append_checker_type(&var message, success);
        try message.append_bytes(self.allocator, "` propagates with `try`");
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    out.* = success;
    return null;
}

fn (self: &Checker) error_set_fits(source: Type, target: Type) -> bool {
    if same_type(source, target) {
        return true;
    }
    let source_handle = self.error_set_of_type(source) orelse return false;
    let target_handle = self.error_set_of_type(target) orelse return false;
    if self.metadata.error_sets.at(source_handle.index) |src| {
        if self.metadata.error_sets.at(target_handle.index) |dst| {
            var index = 0;
            while src.value_order.at(index) |value| {
                index = index + 1;
                let value_bytes = value.as_bytes();
                if !dst.values.contains(value_bytes) {
                    return false;
                }
            }
            return true;
        }
    }
    return false;
}

fn (self: &Checker) error_set_of_type(value: Type) -> ?ErrorSetHandle {
    if value.node |handle| {
        let entry = self.types.entries.at(handle);
        let name = entry.spelling.as_bytes();
        return self.metadata.error_sets_by_name.get(name);
    }
    return null;
}

fn (self: &var Checker) check_contextual_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    want: Type,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if try self.check_contextual_expr_ok(tree, scope, expression, want, out) {
        return self.take_failure();
    }
    return null;
}

fn (self: &var Checker) check_contextual_expr_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    want: Type,
    out: &var Type
) -> !bool {
    match tree.expressions.at(expression.node) {
        Null(_) => {
            if try self.types.takes_null(want) {
                out.* = want;
                return false;
            }
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, "`null` needs an optional context, expected ");
            try self.append_checker_type(&var message, want);
            let problem = try self.checker_message_at("type error", ast::zero_span(), move message);
            return self.fail(move problem);
        },
        _ => {},
    }
    var got = empty_type();
    if try self.check_expr_ok(tree, scope, expression, &var got) {
        return true;
    }
    if same_type(got, want) {
        out.* = want;
        return false;
    }
    if self.types.fills_nullable_pointer(want, got) {
        out.* = want;
        return false;
    }
    if try self.types.optional_elem(want) |_| {
        var wrapped = false;
        if try self.wraps_into_optional(tree, expression, want, got, &var wrapped) |problem| {
            return self.fail(move problem);
        }
        if wrapped {
            out.* = want;
            return false;
        }
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "expected ");
        try self.append_checker_type(&var message, want);
        try message.append_bytes(self.allocator, ", got ");
        try self.append_checker_type(&var message, got);
        let problem = try self.checker_message_at("type error", ast::zero_span(), move message);
        return self.fail(move problem);
    }
    if try self.coerce_contextual_literal(tree, expression, want, got, out) |problem| {
        return self.fail(move problem);
    }
    return false;
}

fn (self: &var Checker) check_index_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::IndexExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var target = empty_type();
    if try self.check_expr(tree, scope, expression.target, &var target) |problem| {
        return move problem;
    }
    let target_kind = try self.vector_kind_of(target);
    if target_kind >= 0 {
        let target_text = try self.types.copy_text(self.allocator, target);
        defer target_text.deinit(self.allocator);
        let target_bytes = target_text.as_bytes();
        let lanes = typ::vector_lanes(target_bytes);
        let lane = typ::vector_lane_of_kind(target_kind);
        return self.check_vector_lane(tree, expression, target, lane, lanes, out);
    }
    let held = try self.types.borrowed_value_type(target);
    if try self.types.buffer_elem(held) |_| {
        return self.check_array_index(tree, scope, expression, held, out);
    }
    let elem = try self.types.slice_elem(target) orelse
        return try self.index_target_error(target);
    if !expression.slice {
        if try self.check_index_bound(tree, scope, "index", expression.index) |problem| {
            return move problem;
        }
        out.* = elem;
        return null;
    }
    if expression.start |_| {
        if try self.check_index_bound(tree, scope, "slice start", expression.start) |problem| {
            return move problem;
        }
    }
    if expression.end |_| {
        if try self.check_index_bound(tree, scope, "slice end", expression.end) |problem| {
            return move problem;
        }
    }
    out.* = target;
    return null;
}

fn (self: &var Checker) check_array_index(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::IndexExpr,
    array: Type,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if expression.slice {
        var message = try string::from_bytes(self.allocator, "an array (`");
        errdefer message.deinit(self.allocator);
        try self.append_checker_type(&var message, array);
        try message.append_bytes(self.allocator, "`) is not sliced directly; take a range of its view, `as_slice()`");
        return try self.checker_message_at("type error", expression.span, move message);
    }
    if try self.check_index_bound(tree, scope, "index", expression.index) |problem| {
        return move problem;
    }
    let size = self.types.buffer_size(array) orelse 0;
    if expression.index |index_expr| {
        if integer_literal_value(tree, index_expr) |index| {
            if index < 0 or index >= size {
                var message = try string::from_bytes(self.allocator, "index ");
                errdefer message.deinit(self.allocator);
                try fmt::append_i64(self.allocator, &var message, index);
                try message.append_bytes(self.allocator, " is outside `");
                try self.append_checker_type(&var message, array);
                try message.append_bytes(self.allocator, "`, which has elements 0..");
                try fmt::append_i64(self.allocator, &var message, size);
                return try self.checker_message_at("type error", expression.span, move message);
            }
        }
    }
    out.* = try self.types.buffer_elem(array) orelse array;
    return null;
}

fn (self: &Checker) index_target_error(target: Type) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "index/slice target expects a view (`[]T`) or an array (`[N]T`), got ");
    try self.append_checker_type(&var message, target);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_index_bound(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    expression: ?ast::Expression
) -> !?diagnostic::Diagnostic {
    if expression |present| {
        var got = empty_type();
        if try self.check_expr(tree, scope, present, &var got) |problem| {
            return move problem;
        }
        if self.types.is_text(got, "i64") {
            return null;
        }
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, " expects i64, got ");
        try self.append_checker_type(&var message, got);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, " is missing");
    return try self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_cast_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::CastExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var target = empty_type();
    match try self.resolve_type_node(self.allocator, tree, expression.target_type) {
        Value(value) => {
            target = value;
        },
        Issue(issue) => return try self.type_resolution_diagnostic(issue),
    }
    var source = empty_type();
    if try self.check_expr(tree, scope, expression.value, &var source) |problem| {
        return move problem;
    }
    if self.checker_numeric_type(source) and
        self.checker_numeric_type(target) {
        out.* = target;
        return null;
    }
    if self.types.is_pointer_type(source) and
        self.types.is_pointer_type(target) {
        if try self.require_unsafe_capability_at(
            UnsafeCapability::PtrCast,
            "pointer cast",
            expression.keyword_span
        ) |problem| {
            return move problem;
        }
        out.* = target;
        return null;
    }
    if self.types.casts_c_function_address(source, target) {
        if try self.require_unsafe_capability_at(
            UnsafeCapability::PtrCast,
            "function pointer cast",
            expression.keyword_span
        ) |problem| {
            return move problem;
        }
        out.* = target;
        return null;
    }
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "cannot cast ");
    try self.append_checker_type(&var message, source);
    try message.append_bytes(self.allocator, " to ");
    try self.append_checker_type(&var message, target);
    return try self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_unsafe_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::UnsafeExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let saved_mark = self.mark;
    self.mark = UnsafeMark { used: false };
    if try self.check_expr(tree, scope, expression.value, out) |problem| {
        self.mark = saved_mark;
        return move problem;
    }
    let inner = self.mark;
    self.mark = saved_mark;
    return self.check_under_mark(expression, &inner);
}

fn (self: &var Checker) check_try_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::TryExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let current_return = self.current_return_type();
    if try self.types.error_union_parts(current_return) |_| {} else {
        return try self.checker_error_at(
            "type error", ast::zero_span(),
            "try requires function to return !T"
        );
    }
    var source = empty_type();
    if try self.check_expr(tree, scope, expression.value, &var source) |problem| {
        return move problem;
    }
    var source_error = empty_type();
    var success = empty_type();
    if try self.types.error_union_parts(source) |parts| {
        source_error = parts.err;
        success = parts.success;
    } else {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_bytes(self.allocator, "try expects !T, got ");
        try self.append_checker_type(&var message, source);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    var target_error = empty_type();
    if try self.types.error_union_parts(current_return) |parts| {
        target_error = parts.err;
    }
    if !same_type(target_error, empty_type()) and
        !self.error_set_fits(source_error, target_error) {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        if same_type(source_error, empty_type()) {
            try message.append_bytes(self.allocator, "try cannot propagate an error of ");
            try self.append_checker_type(&var message, source);
            try message.append_bytes(self.allocator, " into ");
            try self.append_checker_type(&var message, current_return);
            try message.append_bytes(self.allocator, ": ");
            try self.append_checker_type(&var message, source);
            try message.append_bytes(
                self.allocator, " declares no error set, so its failures cannot be checked against it");
        } else {
            try message.append_bytes(self.allocator, "try cannot propagate ");
            try self.append_checker_type(&var message, source_error);
            try message.append_bytes(self.allocator, " from ");
            try self.append_checker_type(&var message, source);
            try message.append_bytes(self.allocator, " into ");
            try self.append_checker_type(&var message, current_return);
        }
        let span = expression_span(tree, expression.value);
        return try self.checker_message_at("type error", span, move message);
    }
    out.* = success;
    return null;
}

fn (self: &var Checker) check_control_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.node) {
        If(value) => return self.check_if_expr(tree, scope, value, out),
        Match(value) => return self.check_match_expr(tree, scope, value, out),
        OrelseGuard(value) => return self.check_orelse_guard_expr(tree, scope, value, out),
        CatchGuard(value) => return self.check_catch_guard_expr(tree, scope, value, out),
        _ => return try self.checker_error_at(
            "type error", expression_span(tree, expression),
            "unsupported expression"
        ),
    }
}
