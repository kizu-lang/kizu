import compiler::internal::typ;
import std::array;
import std::mem;
import std::string;
import std::testing;

fn empty_signature_type(allocator: Allocator) -> FunctionSignatureType {
    return FunctionSignatureType {
        extern_abi: string::new(allocator),
        static_params: array::new<StaticParamType>(allocator),
        params: array::new<SignatureParamType>(allocator),
        return_type: empty_type(),
        requires_unsafe: false,
        std: false
    };
}

test "declaration policy reports the first reserved Function parameter" {
    let allocator = mem::page_allocator();
    var table = new_type_table(allocator);
    defer table.deinit(allocator);
    var signature = empty_signature_type(allocator);
    defer signature.deinit(allocator);
    let field_name = try string::from_bytes(allocator, "field");
    errdefer field_name.deinit(allocator);
    try signature.static_params.append(StaticParamType {
        name: move field_name,
        type_name: try table.field_type(),
        is_type: false
    });
    let worker_name = try string::from_bytes(allocator, "worker");
    errdefer worker_name.deinit(allocator);
    try signature.static_params.append(StaticParamType {
        name: move worker_name,
        type_name: try table.function_type(),
        is_type: false
    });
    if reserved_function_static_param_index(&table, &signature) |index| {
        testing::expect_equal<i64>(1, index);
    } else {
        testing::fail("non-std Function parameter was accepted");
    }
    signature.std = true;
    if reserved_function_static_param_index(&table, &signature) |_| {
        testing::fail("std Function parameter was rejected");
    }
}

test "declaration policy classifies runtime storage structurally" {
    let allocator = mem::page_allocator();
    var table = new_type_table(allocator);
    defer table.deinit(allocator);
    let compile_time = try table.intern("?Function");
    let runtime = try table.i64_type();
    testing::expect(compile_time_only_type(&table, compile_time));
    testing::expect(!compile_time_only_type(&table, runtime));
    let pointer = try table.intern("[]ptr<u8>");
    testing::expect(raw_pointer_field_requires_unsafe(
        &table,
        false,
        pointer
    ));
    testing::expect(!raw_pointer_field_requires_unsafe(
        &table,
        true,
        pointer
    ));
    testing::expect(!raw_pointer_field_requires_unsafe(
        &table,
        false,
        runtime
    ));
}

test "union payload policy reads the parsed root" {
    let allocator = mem::page_allocator();
    var table = typ::new(allocator);
    defer table.deinit(allocator);
    let borrowed = try table.parse("&Item");
    let owned = try table.parse("Item");
    testing::expect(is_borrow_payload(&table, borrowed));
    testing::expect(!is_borrow_payload(&table, owned));
}
