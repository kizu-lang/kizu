import compiler::internal::ast;
import compiler::internal::staticexpr;
import compiler::internal::typ;
import std::arena;
import std::array;
import std::map;
import std::mem;
import std::sort;
import std::string;

pub struct Type {
    node: ?arena::Handle<TypeEntry>,
}

enum TypeRootKind {
    Name,
    Slice,
    Buffer,
    Borrow,
    Optional,
    Const,
    ErrorUnion,
    Func,
}

struct TypeEntry {
    id: i64,
    spelling: string::String,
    parsed: typ::Type,
    root_kind: TypeRootKind,
    vector_kind: i64,
    static_length: bool,
    is_numeric: bool,
    is_signed_numeric: bool,
    is_integer: bool,
    is_pointer: bool,
    is_borrow_optional: bool,
    is_borrowed_view_return: bool,
    has_raw_pointer: bool,
    has_type_value: bool,
    has_compile_time_only: bool,
    has_borrow_optional: bool,
    has_meta_prefix: bool,
}

pub struct TypeTable {
    allocator: Allocator,
    parsed: typ::Table,
    entries: arena::Arena<TypeEntry>,
    by_spelling: map::Map<[]u8, Type>,
    next_id: i64,
    cached_bool: Type,
    cached_field: Type,
    cached_function: Type,
    cached_i64: Type,
    cached_u8: Type,
    cached_f64: Type,
    cached_byte_string: Type,
    cached_c_string: Type,
    cached_type_value: Type,
    cached_void: Type,
}

pub struct BorrowParts {
    pub mutable: bool,
    pub inner: Type,
}

pub struct ErrorUnionTypeParts {
    pub err: Type,
    pub success: Type,
}

pub enum PointerDerefError {
    NotPointer,
    Nullable,
    Const,
}

pub union PointerDerefResult {
    Value(Type),
    Error(PointerDerefError),
}

pub enum BorrowCoercionError {
    OwningParameter,
    WantsShared,
    WantsMutable,
}

pub union BorrowCoercionResult {
    Value(Type),
    Error(BorrowCoercionError),
}

struct TypeScanVisitor {
    has_raw_pointer: bool,
    has_type_value: bool,
    has_compile_time_only: bool,
    has_borrow_optional: bool,
    optional_child: bool,
}

fn (self: &var TypeScanVisitor) visit(value: &typ::Node) -> void {
    let directly_optional = self.optional_child;
    self.optional_child = false;
    match value {
        Name(node) => {
            if node.path.len() != 1 {
                return;
            }
            if node.path.at(0) |part| {
                let name = part.as_bytes();
                if node.args.len() > 0 and equal(name, "ptr") {
                    self.has_raw_pointer = true;
                } else if equal(name, "type") {
                    self.has_type_value = true;
                } else if equal(name, "Field") or equal(name, "Function") {
                    self.has_compile_time_only = true;
                }
            }
        },
        Borrow(_) => {
            if directly_optional {
                self.has_borrow_optional = true;
            }
        },
        Optional(_) => {
            self.optional_child = true;
        },
        _ => {},
    }
    return;
}

fn classify_root(table: &typ::Table, value: typ::Type) -> TypeRootKind {
    return match typ::root_node(table, value) {
        Name(_) => TypeRootKind::Name,
        Slice(_) => TypeRootKind::Slice,
        Buffer(_) => TypeRootKind::Buffer,
        Borrow(_) => TypeRootKind::Borrow,
        Optional(_) => TypeRootKind::Optional,
        Const(_) => TypeRootKind::Const,
        ErrorUnion(_) => TypeRootKind::ErrorUnion,
        Func(_) => TypeRootKind::Func,
    };
}

fn compute_borrowed_view_return(table: &typ::Table, value: typ::Type, root_kind: TypeRootKind) -> bool {
    if root_kind == TypeRootKind::Borrow or root_kind == TypeRootKind::Slice {
        return true;
    }
    if root_kind == TypeRootKind::ErrorUnion {
        match typ::root_node(table, value) {
            ErrorUnion(node) => {
                let ok_child = typ::child_type(value, node.ok);
                return match typ::root_node(table, ok_child) {
                    Borrow(_) => true,
                    Slice(_) => true,
                    _ => false,
                };
            },
            _ => return false,
        }
    }
    return false;
}

fn is_borrow_optional_bytes(bytes: []u8) -> bool {
    if mem::len(bytes) < 2 or bytes[0] != cast<u8>(63) or bytes[1] != cast<u8>(38) {
        return false;
    }
    if typ::borrow_optional_elem(bytes) |_| {
        return true;
    }
    return false;
}

pub struct EnumHandle {
    pub index: i64,
}

pub struct FunctionHandle {
    pub index: i64,
}

pub struct EnumType {
    pub name: ast::Text,
    pub tags: map::Map<[]u8, bool>,
    pub order: array::Array<ast::Text>,
    pub public: bool,
}

pub struct ErrorSetType {
    pub name: ast::Text,
    pub public: bool,
    pub tagged: EnumHandle,
    pub combines: array::Array<string::String>,
    pub values: map::Map<[]u8, bool>,
    pub value_order: array::Array<string::String>,
    pub resolved: bool,
}

pub struct UnionType {
    pub name: string::String,
    pub type_params: array::Array<string::String>,
    pub variants: map::Map<[]u8, Type>,
    pub order: array::Array<string::String>,
    pub public: bool,
}

pub struct StaticParamType {
    pub name: string::String,
    pub type_name: Type,
    pub is_type: bool,
}

pub struct SignatureParamType {
    pub name: string::String,
    pub selection: ast::Span,
    pub borrow: bool,
    pub mut_borrow: bool,
}

pub struct FunctionSignatureType {
    pub extern_abi: string::String,
    pub export_abi: string::String,
    pub static_params: array::Array<StaticParamType>,
    pub params: array::Array<SignatureParamType>,
    pub return_type: Type,
    pub variadic: bool,
    pub requires_unsafe: bool,
    pub std: bool,
}

pub struct FunctionType {
    pub name: string::String,
    pub signature: FunctionSignatureType,
    pub params: array::Array<Type>,
    pub borrow_params: array::Array<bool>,
    pub mut_borrow_params: array::Array<bool>,
    pub return_type: Type,
    pub body: ?ast::Block,
    pub implicit_return: bool,
}

pub struct ContractType {
    pub name: string::String,
    pub methods: map::Map<[]u8, FunctionHandle>,
    pub public: bool,
}

pub fn new_type_table(allocator: Allocator) -> TypeTable {
    return TypeTable {
        allocator: allocator,
        parsed: typ::new(allocator),
        entries: arena::new<TypeEntry>(allocator),
        by_spelling: map::new<[]u8, Type>(allocator),
        next_id: 0,
        cached_bool: empty_type(),
        cached_field: empty_type(),
        cached_function: empty_type(),
        cached_i64: empty_type(),
        cached_u8: empty_type(),
        cached_f64: empty_type(),
        cached_byte_string: empty_type(),
        cached_c_string: empty_type(),
        cached_type_value: empty_type(),
        cached_void: empty_type()
    };
}

pub fn empty_type() -> Type {
    return Type { node: null };
}

pub fn (self: &var TypeTable) bool_type() -> !Type {
    if self.cached_bool.node |_| {
        return self.cached_bool;
    }
    let value = try self.intern("bool");
    self.cached_bool = value;
    return value;
}

pub fn (self: &var TypeTable) field_type() -> !Type {
    if self.cached_field.node |_| {
        return self.cached_field;
    }
    let value = try self.intern("Field");
    self.cached_field = value;
    return value;
}

pub fn (self: &var TypeTable) function_type() -> !Type {
    if self.cached_function.node |_| {
        return self.cached_function;
    }
    let value = try self.intern("Function");
    self.cached_function = value;
    return value;
}

pub fn (self: &var TypeTable) i64_type() -> !Type {
    if self.cached_i64.node |_| {
        return self.cached_i64;
    }
    let value = try self.intern("i64");
    self.cached_i64 = value;
    return value;
}

pub fn (self: &var TypeTable) u8_type() -> !Type {
    if self.cached_u8.node |_| {
        return self.cached_u8;
    }
    let value = try self.intern("u8");
    self.cached_u8 = value;
    return value;
}

fn (self: &var TypeTable) f64_type() -> !Type {
    if self.cached_f64.node |_| {
        return self.cached_f64;
    }
    let value = try self.intern("f64");
    self.cached_f64 = value;
    return value;
}

pub fn (self: &var TypeTable) byte_string_type() -> !Type {
    if self.cached_byte_string.node |_| {
        return self.cached_byte_string;
    }
    let value = try self.intern("[]u8");
    self.cached_byte_string = value;
    return value;
}

pub fn (self: &var TypeTable) c_string_type() -> !Type {
    if self.cached_c_string.node |_| {
        return self.cached_c_string;
    }
    let value = try self.intern("ptr<const u8>");
    self.cached_c_string = value;
    return value;
}

pub fn (self: &var TypeTable) type_value_type() -> !Type {
    if self.cached_type_value.node |_| {
        return self.cached_type_value;
    }
    let value = try self.intern("type");
    self.cached_type_value = value;
    return value;
}

pub fn (self: &var TypeTable) void_type() -> !Type {
    if self.cached_void.node |_| {
        return self.cached_void;
    }
    let value = try self.intern("void");
    self.cached_void = value;
    return value;
}

fn (self: &var TypeTable) add_entry(spelling: string::String, parsed: typ::Type) -> !Type {
    errdefer spelling.deinit(self.allocator);
    let bytes = spelling.as_bytes();
    let static_length = typ::has_static_length(bytes);
    let root_kind = classify_root(&self.parsed, parsed);
    var vector_kind = -1;
    var is_integer = false;
    var is_numeric = false;
    var is_signed_numeric = false;
    var has_meta_prefix = false;
    if root_kind == TypeRootKind::Name {
        is_integer = is_integer_type(bytes);
        if is_integer {
            is_numeric = true;
            is_signed_numeric = is_signed_numeric_type(bytes);
        } else if equal(bytes, "f32") or equal(bytes, "f64") {
            is_numeric = true;
            is_signed_numeric = true;
        } else {
            vector_kind = typ::vector_kind(bytes);
            if vector_kind < 0 and mem::starts_with(bytes, "std::meta::") {
                has_meta_prefix = true;
            }
        }
    }
    var is_pointer = false;
    if root_kind == TypeRootKind::Name or root_kind == TypeRootKind::Optional {
        is_pointer = parsed_is_pointer(&self.parsed, parsed);
    }
    var is_borrow_optional = false;
    if root_kind == TypeRootKind::Optional {
        is_borrow_optional = is_borrow_optional_bytes(bytes);
    }
    let is_borrowed_view_return = compute_borrowed_view_return(&self.parsed, parsed, root_kind);
    var scan = TypeScanVisitor {
        has_raw_pointer: false,
        has_type_value: false,
        has_compile_time_only: false,
        has_borrow_optional: false,
        optional_child: false
    };
    if !is_numeric and vector_kind < 0 and !equal(bytes, "bool") and !equal(bytes, "void") {
        typ::walk<TypeScanVisitor>(&self.parsed, parsed, &var scan);
    }
    let id = self.next_id;
    self.next_id = id + 1;
    let handle = try self.entries.add(self.allocator, TypeEntry {
        id: id,
        spelling: move spelling,
        parsed: parsed,
        root_kind: root_kind,
        vector_kind: vector_kind,
        static_length: static_length,
        is_numeric: is_numeric,
        is_signed_numeric: is_signed_numeric,
        is_integer: is_integer,
        is_pointer: is_pointer,
        is_borrow_optional: is_borrow_optional,
        is_borrowed_view_return: is_borrowed_view_return,
        has_raw_pointer: scan.has_raw_pointer,
        has_type_value: scan.has_type_value,
        has_compile_time_only: scan.has_compile_time_only,
        has_borrow_optional: scan.has_borrow_optional,
        has_meta_prefix: has_meta_prefix
    });
    let value = Type { node: handle };
    let retained = self.entries.at(handle);
    let retained_text = retained.spelling.as_bytes();
    try self.by_spelling.insert(self.allocator, retained_text, value);
    return value;
}

pub fn (self: &var TypeTable) intern(text: []u8) -> !Type {
    if mem::len(text) == 0 {
        return empty_type();
    }
    if self.by_spelling.get(text) |known| {
        return known;
    }
    let parsed = try self.parsed.parse(text);
    let spelling = try string::from_bytes(self.allocator, text);
    return self.add_entry(move spelling, parsed);
}

pub fn (self: &var TypeTable) remember(source: &typ::Table, parsed: typ::Type) -> !Type {
    match typ::root_node(source, parsed) {
        Name(node) => {
            if node.path.len() == 1 and node.args.len() == 0 {
                if node.path.at(0) |part| {
                    let bytes = part.as_bytes();
                    if equal(bytes, "i64") {
                        return self.i64_type();
                    }
                    if equal(bytes, "bool") {
                        return self.bool_type();
                    }
                    if equal(bytes, "void") {
                        return self.void_type();
                    }
                    if equal(bytes, "u8") {
                        return self.u8_type();
                    }
                    if equal(bytes, "f64") {
                        return self.f64_type();
                    }
                    return self.intern(bytes);
                }
            }
        },
        _ => {},
    }
    let spelling = try typ::render(self.allocator, source, parsed);
    defer spelling.deinit(self.allocator);
    let bytes = spelling.as_bytes();
    return self.intern(bytes);
}

pub fn (self: &TypeTable) copy_text(allocator: Allocator, value: Type) -> !string::String {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        let bytes = entry.spelling.as_bytes();
        return string::from_bytes(allocator, bytes);
    }
    return string::new(allocator);
}

pub fn (self: &TypeTable) mints_wrapper(allocator: Allocator, value: Type) -> !bool {
    let _ = allocator;
    if value.node |handle| {
        let entry = self.entries.at(handle);
        let bytes = entry.spelling.as_bytes();
        return has_wrapper_byte(bytes);
    }
    return false;
}

fn (self: &TypeTable) vector_kind_fast(value: Type) -> i64 {
    if value.node |handle| {
        return self.entries.at(handle).vector_kind;
    }
    return -1;
}

fn (self: &TypeTable) is_vector_fast(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).vector_kind >= 0;
    }
    return false;
}

fn (self: &TypeTable) is_numeric_fast(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).is_numeric;
    }
    return false;
}

fn (self: &TypeTable) is_signed_numeric_fast(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).is_signed_numeric;
    }
    return false;
}

fn (self: &TypeTable) is_integer_fast(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).is_integer;
    }
    return false;
}

fn (self: &TypeTable) is_borrow_optional_fast(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).is_borrow_optional;
    }
    return false;
}

fn (self: &TypeTable) has_meta_prefix_fast(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).has_meta_prefix;
    }
    return false;
}

fn (self: &TypeTable) is_borrowed_view_return_fast(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).is_borrowed_view_return;
    }
    return false;
}

fn has_wrapper_byte(bytes: []u8) -> bool {
    for 0..mem::len(bytes) |i| {
        if bytes[i] == cast<u8>(63) or bytes[i] == cast<u8>(33) {
            return true;
        }
    }
    return false;
}

pub fn (self: &TypeTable) lookup(value: Type) -> ?typ::Type {
    if value.node |handle| {
        return self.entries.at(handle).parsed;
    }
    return null;
}

fn (self: &var TypeTable) retain_parsed(value: typ::Type) -> !Type {
    let spelling = try typ::render(self.allocator, &self.parsed, value);
    errdefer spelling.deinit(self.allocator);
    let bytes = spelling.as_bytes();
    let known = self.by_spelling.get(bytes);
    if known |retained_type| {
        spelling.deinit(self.allocator);
        return retained_type;
    }
    return self.add_entry(move spelling, value);
}

pub fn same_type(left: Type, right: Type) -> bool {
    if left.node |left_handle| {
        if right.node |right_handle| {
            return left_handle == right_handle;
        }
        return false;
    }
    if right.node |_| {
        return false;
    }
    return true;
}

pub fn (self: &TypeTable) is_text(value: Type, expected: []u8) -> bool {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        let bytes = entry.spelling.as_bytes();
        return equal(bytes, expected);
    }
    return mem::len(expected) == 0;
}

pub fn (self: &TypeTable) is_map_key_type(value: Type) -> bool {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        let bytes = entry.spelling.as_bytes();
        return typ::is_map_key(bytes);
    }
    return false;
}

pub fn (self: &var TypeTable) slice_elem(value: Type) -> !?Type {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        if entry.root_kind != TypeRootKind::Slice {
            return null;
        }
        let parsed = entry.parsed;
        match typ::root_node(&self.parsed, parsed) {
            Slice(node) => {
                let child = typ::child_type(parsed, node.elem);
                return try self.retain_parsed(child);
            },
            _ => return null,
        }
    }
    return null;
}

pub fn (self: &TypeTable) is_slice_type(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).root_kind == TypeRootKind::Slice;
    }
    return false;
}

pub fn (self: &var TypeTable) buffer_elem(value: Type) -> !?Type {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        if entry.root_kind != TypeRootKind::Buffer {
            return null;
        }
        let parsed = entry.parsed;
        match typ::root_node(&self.parsed, parsed) {
            Buffer(node) => {
                let child = typ::child_type(parsed, node.elem);
                return try self.retain_parsed(child);
            },
            _ => return null,
        }
    }
    return null;
}

pub fn (self: &var TypeTable) buffer_size(value: Type) -> ?i64 {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        if entry.root_kind != TypeRootKind::Buffer {
            return null;
        }
        let parsed = entry.parsed;
        match typ::root_node(&self.parsed, parsed) {
            Buffer(node) => return node.size,
            _ => return null,
        }
    }
    return null;
}

pub fn (self: &var TypeTable) slice_of(elem: Type) -> !Type {
    var spelling = try string::from_bytes(self.allocator, "[]");
    defer spelling.deinit(self.allocator);
    let text = try self.copy_text(self.allocator, elem);
    defer text.deinit(self.allocator);
    try spelling.append_string(self.allocator, &text);
    let bytes = spelling.as_bytes();
    return try self.intern(bytes);
}

pub fn (self: &TypeTable) is_buffer_type(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).root_kind == TypeRootKind::Buffer;
    }
    return false;
}

pub fn (self: &TypeTable) contains_borrow_optional(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).has_borrow_optional;
    }
    return false;
}

pub fn (self: &var TypeTable) unwrap_return_success_type(value: Type) -> !Type {
    if try self.error_union_parts(value) |parts| {
        return parts.success;
    }
    return value;
}

pub fn (self: &var TypeTable) is_borrowed_view_return_type(value: Type) -> !bool {
    if value.node |handle| {
        return self.entries.at(handle).is_borrowed_view_return;
    }
    return false;
}

pub fn (self: &var TypeTable) borrow_wrapped_type(
    borrow: bool,
    mutable: bool,
    value: Type
) -> !Type {
    if !borrow {
        return value;
    }
    if self.lookup(value) |parsed| {
        let wrapped = try typ::wrap_borrow(&var self.parsed, parsed, mutable);
        return self.retain_parsed(wrapped);
    }
    return value;
}

pub fn (self: &var TypeTable) substitute_type_params(
    allocator: Allocator,
    declared: Type,
    substitutions: &map::Map<[]u8, Type>
) -> !Type {
    if declared.node |handle| {
        let entry = self.entries.at(handle);
        let bytes = entry.spelling.as_bytes();
        if substitutions.get(bytes) |replacement| {
            return replacement;
        }
    } else {
        return declared;
    }
    if self.lookup(declared) |parsed| {
        var parsed_substitutions = map::new<[]u8, typ::Type>(self.allocator);
        defer parsed_substitutions.deinit(self.allocator);
        var index = 0;
        while substitutions.key_at(index) |name| {
            if substitutions.get(name) |replacement| {
                if self.lookup(replacement) |replacement_type| {
                    try parsed_substitutions.insert(allocator, name, replacement_type);
                }
            }
            index = index + 1;
        }
        let replaced = try typ::substitute(&var self.parsed, parsed, &parsed_substitutions);
        return self.retain_parsed(replaced);
    }
    return declared;
}

union BoundLengths {
    Value(Type),
    Problem(string::String),
}

fn (self: &TypeTable) has_static_length(value: Type) -> bool {
    let handle = value.node orelse return false;
    return self.entries.at(handle).static_length;
}

fn (self: &var TypeTable) bind_lengths(value: Type, env: &staticexpr::Env) -> !BoundLengths {
    if !self.has_static_length(value) {
        return BoundLengths::Value(value);
    }
    let parsed = self.lookup(value) orelse return BoundLengths::Value(value);
    let bound = try typ::bind_lengths(&var self.parsed, parsed, env);
    match bound {
        Type(result) => return BoundLengths::Value(try self.retain_parsed(result)),
        Problem(problem) => return BoundLengths::Problem(move problem),
    }
}

pub fn arg_texts(
    allocator: Allocator,
    source: &typ::Table,
    args: &array::Array<typ::Type>
) -> !array::Array<string::String> {
    var out = array::new<string::String>(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while args.get(index) |arg| {
        let text = try typ::render(allocator, source, arg);
        errdefer text.deinit(allocator);
        try out.append(allocator, move text);
        index = index + 1;
    }
    return move out;
}

fn sorted_method_names(
    allocator: Allocator,
    methods: &map::Map<[]u8, FunctionHandle>
) -> !array::Array<string::String> {
    var names = array::new<string::String>(allocator);
    errdefer names.deinit(allocator);
    var index = 0;
    while methods.key_at(index) |name| {
        let copied = try string::from_bytes(allocator, name);
        errdefer copied.deinit(allocator);
        try names.append(allocator, move copied);
        index = index + 1;
    }
    try sort::strings(&var names);
    return move names;
}

fn method_matches(want: &FunctionType, got: &FunctionType) -> bool {
    if got.params.len() == 0 or
        want.params.len() != got.params.len() - 1 or
        !same_type(want.return_type, got.return_type) {
        return false;
    }
    var index = 0;
    while want.params.get(index) |want_param| {
        let got_param = got.params.get_or_panic(index + 1);
        if !same_type(want_param, got_param) or
            want.borrow_params.get_or_panic(index) !=
            got.borrow_params.get_or_panic(index + 1) or
            want.mut_borrow_params.get_or_panic(index) !=
            got.mut_borrow_params.get_or_panic(index + 1) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

pub fn (self: &var TypeTable) optional_elem(value: Type) -> !?Type {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        if entry.root_kind != TypeRootKind::Optional or entry.is_pointer {
            return null;
        }
        let parsed = entry.parsed;
        match typ::root_node(&self.parsed, parsed) {
            Optional(node) => {
                let child = typ::child_type(parsed, node.elem);
                return try self.retain_parsed(child);
            },
            _ => return null,
        }
    }
    return null;
}

pub fn (self: &var TypeTable) openable_elem(value: Type) -> !?Type {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        if entry.root_kind != TypeRootKind::Optional {
            return null;
        }
        let parsed = entry.parsed;
        match typ::root_node(&self.parsed, parsed) {
            Optional(node) => {
                let child = typ::child_type(parsed, node.elem);
                return try self.retain_parsed(child);
            },
            _ => return null,
        }
    }
    return null;
}

pub fn (self: &var TypeTable) takes_null(value: Type) -> !bool {
    if value.node |handle| {
        return self.entries.at(handle).root_kind == TypeRootKind::Optional;
    }
    return false;
}

pub fn (self: &var TypeTable) absorbs_error_union(want: Type, got: Type) -> !bool {
    if try self.error_union_parts(want) |want_parts| {
        if !same_type(want_parts.err, empty_type()) {
            return false;
        }
        if try self.error_union_parts(got) |got_parts| {
            return !same_type(got_parts.err, empty_type()) and
                same_type(want_parts.success, got_parts.success);
        }
    }
    return false;
}

pub fn (self: &var TypeTable) explicit_borrow_type(value: Type) -> !?BorrowParts {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        if entry.root_kind != TypeRootKind::Borrow {
            return null;
        }
        let parsed = entry.parsed;
        match typ::root_node(&self.parsed, parsed) {
            Borrow(node) => {
                let child = typ::child_type(parsed, node.elem);
                return BorrowParts {
                    mutable: node.mutable,
                    inner: try self.retain_parsed(child)
                };
            },
            _ => return null,
        }
    }
    return null;
}

pub fn (self: &var TypeTable) borrowed_value_type(value: Type) -> !Type {
    if value.node |handle| {
        if self.entries.at(handle).root_kind != TypeRootKind::Borrow {
            return value;
        }
    } else {
        return value;
    }
    if try self.explicit_borrow_type(value) |parts| {
        return parts.inner;
    }
    return value;
}

pub fn (self: &var TypeTable) coerce_returned_borrow_argument(
    got: Type,
    want: Type,
    want_borrow: bool,
    want_mutable: bool
) -> !BorrowCoercionResult {
    if got.node |handle| {
        if self.entries.at(handle).root_kind != TypeRootKind::Borrow {
            return BorrowCoercionResult::Value(got);
        }
    } else {
        return BorrowCoercionResult::Value(got);
    }
    if try self.explicit_borrow_type(got) |parts| {
        if !want_borrow {
            return BorrowCoercionResult::Error(BorrowCoercionError::OwningParameter);
        }
        if parts.mutable and !want_mutable {
            return BorrowCoercionResult::Error(BorrowCoercionError::WantsShared);
        }
        if !parts.mutable and want_mutable {
            return BorrowCoercionResult::Error(BorrowCoercionError::WantsMutable);
        }
        if same_type(parts.inner, want) {
            return BorrowCoercionResult::Value(parts.inner);
        }
    }
    return BorrowCoercionResult::Value(got);
}

pub fn (self: &TypeTable) join_types(
    allocator: Allocator,
    values: &array::Array<Type>
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while values.get(index) |value| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        if value.node |handle| {
            let entry = self.entries.at(handle);
            let bytes = entry.spelling.as_bytes();
            try out.append_bytes(allocator, bytes);
        }
        index = index + 1;
    }
    return move out;
}

pub fn (self: &var TypeTable) pointer_element(value: Type) -> !?Type {
    if self.lookup(value) |parsed| {
        if parsed_pointer_element(&self.parsed, parsed) |element| {
            return try self.retain_parsed(element);
        }
    }
    return null;
}

pub fn (self: &TypeTable) fills_nullable_pointer(want: Type, got: Type) -> bool {
    let want_handle = want.node orelse return false;
    let want_entry = self.entries.at(want_handle);
    if want_entry.root_kind != TypeRootKind::Optional or !want_entry.is_pointer {
        return false;
    }
    let got_handle = got.node orelse return false;
    let want_bytes = want_entry.spelling.as_bytes();
    let got_entry = self.entries.at(got_handle);
    let got_bytes = got_entry.spelling.as_bytes();
    if mem::len(want_bytes) != mem::len(got_bytes) + 1 {
        return false;
    }
    return mem::equal_bytes(want_bytes[1..mem::len(want_bytes)], got_bytes);
}

pub fn (self: &TypeTable) is_function_pointer(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).root_kind == TypeRootKind::Func;
    }
    return false;
}

pub fn (self: &TypeTable) function_pointer_arity(value: Type) -> i64 {
    if self.lookup(value) |parsed| {
        match typ::root_node(&self.parsed, parsed) {
            Func(node) => return node.params.len(),
            _ => return -1,
        }
    }
    return -1;
}

pub fn (self: &TypeTable) function_pointer_is_unsafe(value: Type) -> bool {
    if self.lookup(value) |parsed| {
        match typ::root_node(&self.parsed, parsed) {
            Func(node) => return node.unsafe_call,
            _ => return false,
        }
    }
    return false;
}

pub fn (self: &TypeTable) function_pointer_is_c(value: Type) -> bool {
    if self.lookup(value) |parsed| {
        match typ::root_node(&self.parsed, parsed) {
            Func(node) => return node.c_abi,
            _ => return false,
        }
    }
    return false;
}

pub fn (self: &var TypeTable) function_pointer_part(value: Type, index: i64) -> !Type {
    let child = function_pointer_child(self, value, index) orelse return empty_type();
    return self.retain_parsed(child);
}

fn function_pointer_child(table: &TypeTable, value: Type, index: i64) -> ?typ::Type {
    let parsed = table.lookup(value) orelse return null;
    match typ::root_node(&table.parsed, parsed) {
        Func(node) => {
            if index < 0 {
                return typ::child_type(parsed, node.result);
            }
            if node.params.get(index) |param| {
                return typ::child_type(parsed, param);
            }
            return null;
        },
        _ => return null,
    }
}

pub fn (self: &TypeTable) is_pointer_type(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).is_pointer;
    }
    return false;
}

pub fn (self: &TypeTable) is_c_function_pointer(value: Type) -> bool {
    if self.lookup(value) |parsed| {
        return parsed_c_function_pointer(&self.parsed, parsed);
    }
    return false;
}

pub fn (self: &TypeTable) casts_c_function_address(source: Type, target: Type) -> bool {
    let source_parsed = self.lookup(source) orelse return false;
    let target_parsed = self.lookup(target) orelse return false;
    if is_optional_root(&self.parsed, source_parsed) !=
        is_optional_root(&self.parsed, target_parsed) {
        return false;
    }
    let source_func = parsed_c_function_pointer(&self.parsed, source_parsed);
    let target_func = parsed_c_function_pointer(&self.parsed, target_parsed);
    if !source_func and !target_func {
        return false;
    }
    let source_address = source_func or parsed_is_pointer(&self.parsed, source_parsed);
    let target_address = target_func or parsed_is_pointer(&self.parsed, target_parsed);
    return source_address and target_address;
}

fn parsed_is_pointer(table: &typ::Table, value: typ::Type) -> bool {
    if parsed_pointer_element(table, value) |_| {
        return true;
    }
    return false;
}

fn parsed_c_function_pointer(table: &typ::Table, value: typ::Type) -> bool {
    var candidate = value;
    match typ::root_node(table, candidate) {
        Optional(node) => {
            candidate = typ::child_type(candidate, node.elem);
        },
        _ => {},
    }
    match typ::root_node(table, candidate) {
        Func(node) => {
            if !node.c_abi {
                return false;
            }
            var index = 0;
            while node.params.get(index) |param| {
                index = index + 1;
                let passed = typ::child_type(candidate, param);
                if !parsed_lends_struct(table, passed) and !parsed_c_scalar(table, passed) and
                    !parsed_plain_name(table, passed) {
                    return false;
                }
            }
            let result = typ::child_type(candidate, node.result);
            return parsed_c_scalar(table, result) or parsed_plain_name(table, result);
        },
        _ => return false,
    }
}

fn parsed_lends_struct(table: &typ::Table, value: typ::Type) -> bool {
    match typ::root_node(table, value) {
        Borrow(node) => {
            match typ::root_node(table, typ::child_type(value, node.elem)) {
                Name(name) => return name.args.len() == 0,
                _ => return false,
            }
        },
        _ => return false,
    }
}

fn parsed_plain_name(table: &typ::Table, value: typ::Type) -> bool {
    match typ::root_node(table, value) {
        Name(name) => return name.args.len() == 0,
        _ => return false,
    }
}

fn parsed_c_scalar(table: &typ::Table, value: typ::Type) -> bool {
    if parsed_is_pointer(table, value) {
        return true;
    }
    if parsed_c_function_pointer(table, value) {
        return true;
    }
    return parsed_name_is(table, value, "bool") or parsed_name_is(table, value, "f32") or
        parsed_name_is(table, value, "f64") or parsed_name_is(table, value, "i8") or
        parsed_name_is(table, value, "i16") or parsed_name_is(table, value, "i32") or
        parsed_name_is(table, value, "i64") or parsed_name_is(table, value, "u8") or
        parsed_name_is(table, value, "u16") or parsed_name_is(table, value, "u32") or
        parsed_name_is(table, value, "u64") or parsed_name_is(table, value, "usize") or
        parsed_name_is(table, value, "isize");
}

fn parsed_name_is(table: &typ::Table, value: typ::Type, expected: []u8) -> bool {
    match typ::root_node(table, value) {
        Name(node) => {
            if node.path.len() != 1 or node.args.len() != 0 {
                return false;
            }
            if node.path.at(0) |part| {
                let bytes = part.as_bytes();
                return equal(bytes, expected);
            }
            return false;
        },
        _ => return false,
    }
}

fn parsed_pointer_element(table: &typ::Table, value: typ::Type) -> ?typ::Type {
    var candidate = value;
    match typ::root_node(table, candidate) {
        Optional(node) => {
            candidate = typ::child_type(candidate, node.elem);
        },
        _ => {},
    }
    match typ::root_node(table, candidate) {
        Name(node) => return pointer_name_element(candidate, node),
        _ => return null,
    }
}

fn pointer_name_element(parent: typ::Type, node: &typ::Name) -> ?typ::Type {
    if node.path.len() != 1 or node.args.len() != 1 {
        return null;
    }
    if node.path.at(0) |part| {
        let bytes = part.as_bytes();
        if !equal(bytes, "ptr") {
            return null;
        }
    } else {
        return null;
    }
    if node.args.get(0) |argument| {
        return typ::child_type(parent, argument);
    }
    return null;
}

pub fn (self: &var TypeTable) raw_pointer_deref_type(value: Type) -> !PointerDerefResult {
    let nullable = is_optional_root(&self.parsed, self.lookup(value));
    if try self.pointer_element(value) |element| {
        if nullable {
            return PointerDerefResult::Error(PointerDerefError::Nullable);
        }
        return PointerDerefResult::Value(try self.strip_const(element));
    }
    return PointerDerefResult::Error(PointerDerefError::NotPointer);
}

pub fn (self: &var TypeTable) assignable_raw_pointer_deref_type(
    value: Type
) -> !PointerDerefResult {
    let nullable = is_optional_root(&self.parsed, self.lookup(value));
    if try self.pointer_element(value) |element| {
        if nullable {
            return PointerDerefResult::Error(PointerDerefError::Nullable);
        }
        if is_const_root(&self.parsed, self.lookup(element)) {
            return PointerDerefResult::Error(PointerDerefError::Const);
        }
        return PointerDerefResult::Value(element);
    }
    return PointerDerefResult::Error(PointerDerefError::NotPointer);
}

fn (self: &var TypeTable) strip_const(value: Type) -> !Type {
    if self.lookup(value) |parsed| {
        match typ::root_node(&self.parsed, parsed) {
            Const(node) => {
                return self.retain_parsed(typ::child_type(parsed, node.elem));
            },
            _ => {},
        }
    }
    return value;
}

fn is_optional_root(table: &typ::Table, value: ?typ::Type) -> bool {
    if value |parsed| {
        return match typ::root_node(table, parsed) {
            Optional(_) => true,
            _ => false,
        };
    }
    return false;
}

fn is_const_root(table: &typ::Table, value: ?typ::Type) -> bool {
    if value |parsed| {
        return match typ::root_node(table, parsed) {
            Const(_) => true,
            _ => false,
        };
    }
    return false;
}

pub fn (self: &TypeTable) contains_raw_pointer(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).has_raw_pointer;
    }
    return false;
}

pub fn (self: &TypeTable) contains_type_value(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).has_type_value;
    }
    return false;
}

pub fn (self: &TypeTable) contains_compile_time_only(value: Type) -> bool {
    if value.node |handle| {
        return self.entries.at(handle).has_compile_time_only;
    }
    return false;
}

pub fn (self: &var TypeTable) error_union_parts(value: Type) -> !?ErrorUnionTypeParts {
    if value.node |handle| {
        let entry = self.entries.at(handle);
        if entry.root_kind != TypeRootKind::ErrorUnion {
            return null;
        }
        let parsed = entry.parsed;
        match typ::root_node(&self.parsed, parsed) {
            ErrorUnion(node) => {
                var err = empty_type();
                if node.err |error_node| {
                    err = try self.retain_parsed(typ::child_type(parsed, error_node));
                }
                let success = try self.retain_parsed(typ::child_type(parsed, node.ok));
                return ErrorUnionTypeParts {
                    err: err,
                    success: success
                };
            },
            _ => return null,
        }
    }
    return null;
}

pub fn (self: &var TypeTable) error_union_element(value: Type) -> !?Type {
    if try self.error_union_parts(value) |parts| {
        return parts.success;
    }
    return null;
}

pub fn split_generic_type(name: []u8) -> ?typ::ApplyParts {
    return typ::split_apply(name);
}

pub fn split_generic_args(allocator: Allocator, args: []u8) -> !?array::Array<string::String> {
    return typ::split_args_optional(allocator, args);
}

pub fn single_generic_arg(args: &array::Array<string::String>) -> ?&string::String {
    if args.len() != 1 {
        return null;
    }
    return args.at(0);
}

pub fn is_known_type(name: []u8) -> bool {
    return is_numeric_type(name) or typ::is_vector(name) or
        equal(name, "bool") or equal(name, "[]u8") or
        equal(name, "void") or equal(name, "Field") or
        equal(name, "Function") or equal(name, "type") or
        equal(name, "Io") or equal(name, "Allocator") or
        equal(name, "std::fs::Metadata") or
        equal(name, "std::fs::DirEntry") or
        equal(name, "std::string::String");
}

pub fn is_numeric_type(name: []u8) -> bool {
    return is_integer_type(name) or equal(name, "f32") or equal(name, "f64");
}

pub fn is_builtin_copy_type(name: []u8) -> bool {
    return is_numeric_type(name) or
        equal(name, "bool") or mem::starts_with(name, "[]") or
        equal(name, "void") or equal(name, "Io") or
        equal(name, "Allocator") or
        equal(name, "std::fs::Metadata");
}

pub fn is_signed_numeric_type(name: []u8) -> bool {
    return equal(name, "i8") or equal(name, "i16") or
        equal(name, "i32") or equal(name, "i64") or
        equal(name, "isize") or equal(name, "f32") or equal(name, "f64");
}

pub fn is_integer_type(name: []u8) -> bool {
    return equal(name, "i8") or equal(name, "i16") or
        equal(name, "i32") or equal(name, "i64") or
        equal(name, "u8") or equal(name, "u16") or
        equal(name, "u32") or equal(name, "u64") or
        equal(name, "usize") or equal(name, "isize");
}

pub fn is_known_generic_base(base: []u8) -> bool {
    return equal(base, "std::mem::Box") or equal(base, "std::map::Map") or
        equal(base, "ptr") or equal(base, "std::arena::Arena") or
        equal(base, "std::arena::Handle") or equal(base, "option") or
        equal(base, "std::array::Array");
}

fn equal(left: []u8, right: []u8) -> bool {
    return mem::equal_bytes(left, right);
}

pub enum UnsafeCapability {
    PtrRead,
    PtrWrite,
    PtrDeref,
    PtrCast,
    PtrIntCast,
    PtrOffset,
    PtrView,
    ExternCall,
    UnsafeCall,
    StructInvariant,
    Volatile,
}

pub fn unsafe_capability_name(capability: UnsafeCapability) -> []u8 {
    return match capability {
        PtrRead => "ptr_read",
        PtrWrite => "ptr_write",
        PtrDeref => "ptr_deref",
        PtrCast => "ptr_cast",
        PtrIntCast => "ptr_int_cast",
        PtrOffset => "ptr_offset",
        PtrView => "ptr_view",
        ExternCall => "extern_call",
        UnsafeCall => "unsafe_call",
        StructInvariant => "struct_invariant",
        Volatile => "volatile",
    };
}

pub struct UnsafeMark {
    pub used: ?bool,
}

pub fn use_unsafe_mark(mark: &var UnsafeMark) -> bool {
    if mark.used |_| {
        mark.used = true;
        return true;
    }
    return false;
}
