import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::stdmeta;
import compiler::internal::typ;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// The real declaration-collection work unit predeclares types, then dispatches
// types, receiver methods, and impl assertions in three source-order passes.
// This Checker boundary alone constructs source diagnostics from copy issues.

struct CollectionMemberIssue {
    owner: ast::Text, member: ast::Text
}

struct CollectionNamedTypeIssue {
    name: ast::Text, type_name: Type,
    /// span is where the declaration was written, or zero when the issue
    /// has no single place.
    span: ast::Span
}

struct CollectionMemberTypeIssue {
    member: CollectionMemberIssue, type_name: Type
}

struct CollectionImplMethodIssue {
    contract_name: ast::Text, type_name: ast::Text, method: FunctionHandle
}

struct CollectionHostParamIssue {
    name: ast::Text, index: i64, type_name: Type,
    mut_borrow: bool,
    span: ast::Span
}

struct FunctionParamStorage {
    params: array::Array<Type>,
    borrow_params: array::Array<bool>,
    mut_borrow_params: array::Array<bool>
}

union TypeCollectionIssue {
    DuplicateType(ast::Text),
    DuplicateEnumTag(CollectionMemberIssue),
    DuplicateError(CollectionMemberIssue),
    DuplicateUnionVariant(CollectionMemberIssue),
    DuplicateContract(ast::Text),
    DuplicateContractMethod(CollectionMemberIssue),
    DuplicateMethod(ast::Text),
    DuplicateFunction(ast::Text),
    FunctionNameIsType(ast::Text),
    UnknownContract(ast::Text),
    MissingContractMethod(CollectionImplMethodIssue),
    ContractMethodMismatch(CollectionImplMethodIssue),
    Resolution(TypeResolutionIssue),
    UnionOptional(CollectionMemberIssue),
    UnionBorrow(CollectionMemberIssue),
    UnionTypeValue(CollectionMemberIssue),
    StructObligationDoc(ast::Text),
    StructBorrow(CollectionMemberIssue),
    StructRawPointer(CollectionMemberIssue),
    StructCompileTimeOnly(CollectionMemberTypeIssue),
    StructTypeValue(CollectionMemberIssue),
    StructBuffer(CollectionMemberIssue),
    StructOptionalView(CollectionMemberIssue),
    FunctionObligationDoc(ast::Text),
    ReservedFunctionStaticParam(ast::Text),
    FunctionReturnCompileTimeOnly(CollectionNamedTypeIssue),
    FunctionReturnBuffer(ast::Text),
    FunctionReturnTypeValue(ast::Text),
    FunctionReturnNestedBorrowOptional(ast::Text),
    ParamBorrowOptional(ast::Text),
    ParamVoid(ast::Text),
    ParamTypeValue(ast::Text),
    ParamBuffer(ast::Text),
    ParamCompileTimeOnly(CollectionNamedTypeIssue),
    ParamBorrowOptionalValue(ast::Text),
    FunctionExternAndExport(ast::Text),
    UnsupportedExternAbi(ast::Text),
    UnsupportedExportAbi(ast::Text),
    BrowserHostMethod(ast::Text),
    BrowserHostStaticParams(ast::Text),
    BrowserExportMain,
    BrowserExportReserved(ast::Text),
    BrowserHostBorrowParam(CollectionHostParamIssue),
    BrowserHostParam(CollectionHostParamIssue),
    BrowserHostReturn(CollectionNamedTypeIssue),
    CHostBorrowParam(CollectionHostParamIssue),
    CHostParam(CollectionHostParamIssue),
    CHostReturn(CollectionNamedTypeIssue),
}

union DeclaredFunctionResult {
    Value(FunctionHandle),
    Issue(TypeCollectionIssue),
}

// Registers types, receiver methods, then impl assertions in the same three
// source-order passes as the shipping Checker's collectTypesAndMethods.
fn (self: &var Checker) collect_types_and_methods(tree: &ast::Ast, program: &ast::Program) -> !?diagnostic::Diagnostic {
    let owners = try ast::deinit_owners(self.allocator, tree, program);
    errdefer owners.deinit(self.allocator);
    try self.predeclare_type_names(self.allocator, tree, program);
    var index = 0;
    while program.declarations.get(index) |declaration| {
        if try self.collect_type_decl(tree, declaration, &owners) |issue| {
            let value = try self.type_collection_diagnostic(tree, issue);
            owners.deinit(self.allocator);
            return move value;
        }
        index = index + 1;
    }
    // Combined error sets resolve after every set is collected, so the sets
    // they name may be declared later in the file.
    if try self.resolve_error_set_compositions(tree) |failed| {
        owners.deinit(self.allocator);
        return move failed;
    }
    index = 0;
    while program.declarations.get(index) |declaration| {
        if try self.collect_method_decl(tree, declaration) |issue| {
            let value = try self.type_collection_diagnostic(tree, issue);
            owners.deinit(self.allocator);
            return move value;
        }
        index = index + 1;
    }
    index = 0;
    while program.declarations.get(index) |declaration| {
        match tree.declarations.at(declaration.node) {
            Impl(value) => {
                if try self.collect_impl(tree, value) |issue| {
                    let diagnostic = try self.type_collection_diagnostic(tree, issue);
                    owners.deinit(self.allocator);
                    return move diagnostic;
                }
            },
            _ => {},
        }
        index = index + 1;
    }
    let handle = try self.deinit_owner_maps.add(self.allocator, move owners);
    self.deinit_owners = handle;
    // The same shape, answering a different question: whose release names an
    // allocator (ADR-0132). Generic cleanup asks it before calling a deinit.
    let names = try ast::release_names_allocator(self.allocator, tree, program);
    let names_handle = try self.deinit_owner_maps.add(self.allocator, move names);
    self.release_allocators = names_handle;
    return null;
}

fn (self: &var Checker) collect_type_decl(
    tree: &ast::Ast, declaration: ast::Declaration, owners: &map::Map<[]u8, bool>
) -> !?TypeCollectionIssue {
    match tree.declarations.at(declaration.node) {
        Struct(value) => return self.collect_struct(tree, declaration, value, owners),
        Enum(value) => return self.collect_enum(self.allocator, tree, value),
        ErrorSet(value) => return self.collect_error_set(self.allocator, tree, value),
        Union(value) => return self.collect_union(tree, value),
        Contract(value) => return self.collect_contract(self.allocator, tree, value),
        Import(_) => return null,
        Function(_) => return null,
        Test(_) => return null,
        Impl(_) => return null,
        Recovered(_) => return null,
    }
}

fn (self: &var Checker) collect_struct(
    tree: &ast::Ast, declaration_handle: ast::Declaration,
    declaration: &ast::StructDecl, owners: &map::Map<[]u8, bool>
) -> !?TypeCollectionIssue {
    let retained_name = tree.texts.at(declaration.name.node);
    let name = retained_name.as_bytes();
    if self.metadata.has_collected_type(name) {
        return TypeCollectionIssue::DuplicateType(declaration.name);
    }
    let retained_doc = tree.texts.at(declaration.doc.node);
    let doc = retained_doc.as_bytes();
    if obligation_doc_missing(declaration.requires_unsafe, doc) {
        return TypeCollectionIssue::StructObligationDoc(declaration.name);
    }
    try self.metadata.structs.insert(self.allocator, name, declaration_handle);
    let previous = try self.type_params.enter_ast(self.allocator, tree, &declaration.type_params);
    let result = try self.collect_struct_fields(tree, declaration, owners);
    self.type_params.restore(previous);
    return result;
}

fn (self: &var Checker) collect_struct_fields(
    tree: &ast::Ast, declaration: &ast::StructDecl, owners: &map::Map<[]u8, bool>
) -> !?TypeCollectionIssue {
    var index = 0;
    while declaration.fields.at(index) |field| {
        match try self.resolve_type_node(self.allocator, tree, field.type_name) {
            Value(field_type) => {
                let member = CollectionMemberIssue {
                    owner: declaration.name, member: field.name
                };
                if field.borrow {
                    return TypeCollectionIssue::StructBorrow(member);
                }
                if raw_pointer_field_requires_unsafe(
                    &self.types, declaration.requires_unsafe, field_type
                ) {
                    return TypeCollectionIssue::StructRawPointer(member);
                }
                if compile_time_only_type(&self.types, field_type) {
                    let issue = CollectionMemberTypeIssue {
                        member: member, type_name: field_type
                    };
                    return TypeCollectionIssue::StructCompileTimeOnly(issue);
                }
                if self.types.contains_type_value(field_type) {
                    return TypeCollectionIssue::StructTypeValue(member);
                }
                if self.types.contains_buffer_type(field_type) {
                    return TypeCollectionIssue::StructBuffer(member);
                }
                if try self.types.optional_elem(field_type) |element| {
                    if !try self.optional_field_element_allowed(tree, owners, element) {
                        return TypeCollectionIssue::StructOptionalView(member);
                    }
                }
            },
            Issue(issue) => return TypeCollectionIssue::Resolution(issue),
        }
        index = index + 1;
    }
    return null;
}

fn (self: &var Checker) optional_field_element_allowed(tree: &ast::Ast, owners: &map::Map<[]u8, bool>, element: Type) -> !bool {
    var seen = array::new<Type>(self.allocator);
    defer seen.deinit(self.allocator);
    if try self.is_plain_data_type(tree, element, &var seen) {
        return true;
    }
    let text = try self.types.copy_text(self.allocator, element);
    defer text.deinit(self.allocator);
    let bytes = text.as_bytes();
    return ast::owner_type(owners, bytes);
}

fn (self: &var Checker) is_plain_data_type(tree: &ast::Ast, value: Type, seen: &var array::Array<Type>) -> !bool {
    if try self.types.optional_elem(value) |element| {
        return self.is_plain_data_type(tree, element, seen);
    }
    // A function pointer is the address of a top-level function, which
    // outlives the program: copying it creates no obligation.
    if self.types.is_function_pointer(value) {
        return true;
    }
    let text = try self.types.copy_text(self.allocator, value);
    defer text.deinit(self.allocator);
    let name = text.as_bytes();
    if self.types.is_text(value, "bool") or
        self.types.is_text(value, "void") or is_numeric_type(name) {
        return true;
    }
    if self.metadata.enums_by_name.contains(name) or
        self.metadata.error_sets_by_name.contains(name) or
        mem::starts_with(name, "std::arena::Handle<") {
        return true;
    }
    var seen_index = 0;
    while seen.get(seen_index) |active| {
        if same_type(active, value) {
            return false;
        }
        seen_index = seen_index + 1;
    }
    if self.metadata.impls.at(name) |methods| {
        if methods.contains(typ::cleanup_method()) {
            return false;
        }
    }
    let struct_declaration = self.metadata.structs.get(name);
    let union_handle = self.metadata.unions_by_name.get(name);
    try seen.append(self.allocator, value);
    var plain = true;
    if struct_declaration |handle| {
        match tree.declarations.at(handle.node) {
            Struct(declaration) => {
                var index = 0;
                while declaration.fields.at(index) |field| {
                    let resolved = try stdmeta::resolve_element_type_forms(self.allocator, &tree.types, field.type_name
                    );
                    let field_type = try self.intern_collection_text(move resolved);
                    if field.borrow or
                        !try self.is_plain_data_type(tree, field_type, seen) {
                        plain = false;
                        break;
                    }
                    index = index + 1;
                }
            },
            _ => {
                plain = false;
            },
        }
    } else {
        if union_handle |handle| {
            var payloads = array::new<Type>(self.allocator);
            defer payloads.deinit(self.allocator);
            if self.metadata.unions.at(handle.index) |union_type| {
                var index = 0;
                while union_type.variants.key_at(index) |variant| {
                    if union_type.variants.get(variant) |payload| {
                        if !same_type(payload, empty_type()) {
                            try payloads.append(self.allocator, payload);
                        }
                    }
                    index = index + 1;
                }
            } else {
                plain = false;
            }
            var payload_index = 0;
            while payloads.get(payload_index) |payload| {
                if !try self.is_plain_data_type(tree, payload, seen) {
                    plain = false;
                    break;
                }
                payload_index = payload_index + 1;
            }
        } else {
            plain = false;
        }
    }
    let _ = seen.pop_or_panic();
    return plain;
}

fn (self: &var Checker) collect_union(tree: &ast::Ast, declaration: &ast::UnionDecl) -> !?TypeCollectionIssue {
    let retained_name = tree.texts.at(declaration.name.node);
    let name = retained_name.as_bytes();
    if self.metadata.has_collected_type(name) {
        return TypeCollectionIssue::DuplicateType(declaration.name);
    }
    let previous = try self.type_params.enter_ast(self.allocator, tree, &declaration.type_params);
    let result = try self.collect_union_in_scope(self.allocator, tree, declaration, name);
    self.type_params.restore(previous);
    return result;
}

fn (self: &var Checker) collect_union_in_scope(allocator: Allocator, tree: &ast::Ast, declaration: &ast::UnionDecl, name: []u8) -> !?TypeCollectionIssue {
    var value = UnionType {
        name: try string::from_bytes(self.allocator, name),
        type_params: array::new<string::String>(self.allocator),
        variants: map::new<[]u8, Type>(self.allocator),
        order: array::new<string::String>(self.allocator),
        public: declaration.public
    };
    errdefer value.deinit(self.allocator);
    var index = 0;
    while declaration.type_params.at(index) |parameter| {
        let retained = tree.texts.at(parameter.node);
        let bytes = retained.as_bytes();
        let copied = try string::from_bytes(self.allocator, bytes);
        errdefer copied.deinit(self.allocator);
        try value.type_params.append(self.allocator, move copied);
        index = index + 1;
    }
    index = 0;
    while declaration.variants.at(index) |variant| {
        let retained_variant = tree.texts.at(variant.name.node);
        let variant_name = retained_variant.as_bytes();
        let member = CollectionMemberIssue {
            owner: declaration.name, member: variant.name
        };
        if value.variants.contains(variant_name) {
            let issue = TypeCollectionIssue::DuplicateUnionVariant(member);
            return discard_union(self.allocator, move value, issue);
        }
        var payload_type = empty_type();
        if variant.payload |payload| {
            match try self.resolve_type_node(allocator, tree, payload) {
                Value(value) => {
                    payload_type = value;
                },
                Issue(issue) => return discard_union(self.allocator, move value, TypeCollectionIssue::Resolution(issue)),
            }
            let normalized = try stdmeta::resolve_element_type_forms(self.allocator, &tree.types, payload);
            defer normalized.deinit(self.allocator);
            let written = try typ::render(self.allocator, &tree.types, payload);
            defer written.deinit(self.allocator);
            let normalized_bytes = normalized.as_bytes();
            let written_bytes = written.as_bytes();
            if !mem::equal_bytes(normalized_bytes, written_bytes) {
                match try self.resolve_type(tree, normalized_bytes) {
                    Value(value) => {
                        payload_type = value;
                    },
                    Issue(issue) => return discard_union(self.allocator, move value, TypeCollectionIssue::Resolution(issue)),
                }
            }
            if try self.types.optional_elem(payload_type) |_| {
                return discard_union(self.allocator, move value, TypeCollectionIssue::UnionOptional(member));
            }
            if is_borrow_payload(&tree.types, payload) {
                return discard_union(self.allocator, move value, TypeCollectionIssue::UnionBorrow(member));
            }
            if self.types.contains_type_value(payload_type) {
                return discard_union(self.allocator, move value, TypeCollectionIssue::UnionTypeValue(member));
            }
        }
        try value.variants.insert(allocator, variant_name, payload_type);
        let copied = try string::from_bytes(self.allocator, variant_name);
        errdefer copied.deinit(self.allocator);
        try value.order.append(self.allocator, move copied);
        index = index + 1;
    }
    let handle = UnionHandle { index: self.metadata.unions.len() };
    try self.metadata.unions.append(self.allocator, move value);
    try self.metadata.unions_by_name.insert(allocator, name, handle);
    return null;
}

fn discard_union(
    allocator: Allocator,
    value: UnionType,
    issue: TypeCollectionIssue
) -> ?TypeCollectionIssue {
    value.deinit(allocator);
    return issue;
}

fn (self: &var Checker) intern_collection_text(text: string::String) -> !Type {
    defer text.deinit(self.allocator);
    let bytes = text.as_bytes();
    return self.types.intern(bytes);
}

fn (self: &var Checker) collect_contract(allocator: Allocator, tree: &ast::Ast, declaration: &ast::ContractDecl) -> !?TypeCollectionIssue {
    let retained_name = tree.texts.at(declaration.name.node);
    let name = retained_name.as_bytes();
    if self.metadata.contracts_by_name.contains(name) {
        return TypeCollectionIssue::DuplicateContract(declaration.name);
    }
    var value = ContractType {
        name: try string::from_bytes(self.allocator, name),
        methods: map::new<[]u8, FunctionHandle>(self.allocator),
        public: declaration.public
    };
    errdefer value.deinit(self.allocator);
    var index = 0;
    while declaration.methods.at(index) |method| {
        let retained_method = tree.texts.at(method.signature.name.node);
        let method_name = retained_method.as_bytes();
        if value.methods.contains(method_name) {
            value.deinit(self.allocator);
            let issue = CollectionMemberIssue {
                owner: declaration.name, member: method.signature.name
            };
            return TypeCollectionIssue::DuplicateContractMethod(issue);
        }
        match try self.new_declared_function_type(tree, method) {
            Value(handle) => {
                try value.methods.insert(allocator, method_name, handle);
            },
            Issue(issue) => {
                value.deinit(self.allocator);
                return issue;
            },
        }
        index = index + 1;
    }
    let handle = ContractHandle { index: self.metadata.contracts.len() };
    try self.metadata.contracts.append(self.allocator, move value);
    try self.metadata.contracts_by_name.insert(allocator, name, handle);
    return null;
}

fn (self: &var Checker) new_declared_function_type(tree: &ast::Ast, declaration: &ast::FunctionDecl) -> !DeclaredFunctionResult {
    let signature = &declaration.signature;
    let retained_doc = tree.texts.at(declaration.doc.node);
    let doc = retained_doc.as_bytes();
    if obligation_doc_missing(signature.requires_unsafe, doc) {
        let issue = TypeCollectionIssue::FunctionObligationDoc(signature.name);
        return DeclaredFunctionResult::Issue(issue);
    }
    let previous = try self.type_params.enter_ast_signature(self.allocator, tree, signature);
    let result = try self.new_declared_function_type_in_scope(tree, declaration);
    self.type_params.restore(previous);
    return result;
}

fn (self: &var Checker) new_declared_function_type_in_scope(tree: &ast::Ast, declaration: &ast::FunctionDecl) -> !DeclaredFunctionResult {
    let signature = &declaration.signature;
    if try self.reserved_static_parameter(tree, signature) |parameter| {
        let issue = TypeCollectionIssue::ReservedFunctionStaticParam(parameter);
        return DeclaredFunctionResult::Issue(issue);
    }
    var storage = FunctionParamStorage {
        params: array::new<Type>(self.allocator),
        borrow_params: array::new<bool>(self.allocator),
        mut_borrow_params: array::new<bool>(self.allocator)
    };
    errdefer storage.deinit(self.allocator);
    var index = 0;
    while signature.params.at(index) |parameter| {
        match try self.resolve_type_node(self.allocator, tree, parameter.type_name) {
            Value(parameter_type) => {
                if try self.collect_function_parameter(
                    signature.std, parameter, parameter_type, &var storage
                ) |issue| {
                    return function_storage_issue(self.allocator, move storage, issue);
                }
            },
            Issue(issue) => {
                let resolution = TypeCollectionIssue::Resolution(issue);
                return function_storage_issue(self.allocator, move storage, resolution);
            },
        }
        index = index + 1;
    }
    var return_type = try self.types.void_type();
    if signature.return_type |written_return| {
        match try self.resolve_type_node(self.allocator, tree, written_return) {
            Value(value) => {
                return_type = value;
            },
            Issue(issue) => {
                let resolution = TypeCollectionIssue::Resolution(issue);
                return function_storage_issue(self.allocator, move storage, resolution);
            },
        }
    }
    if compile_time_only_type(&self.types, return_type) {
        let named = CollectionNamedTypeIssue {
            name: signature.name, type_name: return_type, span: ast::zero_span()
        };
        let issue = TypeCollectionIssue::FunctionReturnCompileTimeOnly(named);
        return function_storage_issue(self.allocator, move storage, issue);
    }
    if self.types.contains_buffer_type(return_type) {
        let issue = TypeCollectionIssue::FunctionReturnBuffer(signature.name);
        return function_storage_issue(self.allocator, move storage, issue);
    }
    if self.types.contains_type_value(return_type) {
        let issue = TypeCollectionIssue::FunctionReturnTypeValue(signature.name);
        return function_storage_issue(self.allocator, move storage, issue);
    }
    if !signature.std and self.types.contains_borrow_optional(return_type) {
        let text = try self.types.copy_text(self.allocator, return_type);
        let bytes = text.as_bytes();
        var bare = false;
        if typ::borrow_optional_elem(bytes) |_| {
            bare = true;
        }
        text.deinit(self.allocator);
        if !bare {
            let issue = TypeCollectionIssue::FunctionReturnNestedBorrowOptional(signature.name);
            return function_storage_issue(self.allocator, move storage, issue);
        }
    }
    if self.validate_host_function_signature(
        tree, signature, &storage.params, return_type
    ) |issue| {
        return function_storage_issue(self.allocator, move storage, issue);
    }
    let cached = try self.cache_function_signature(tree, signature);
    errdefer cached.deinit(self.allocator);
    let retained_name = tree.texts.at(signature.name.node);
    let name = retained_name.as_bytes();
    let function_type = FunctionType {
        name: try string::from_bytes(self.allocator, name),
        signature: move cached,
        params: move storage.params,
        borrow_params: move storage.borrow_params,
        mut_borrow_params: move storage.mut_borrow_params,
        return_type: return_type,
        body: declaration.body,
        implicit_return: false
    };
    let handle = FunctionHandle { index: self.metadata.functions.len() };
    try self.metadata.functions.append(self.allocator, move function_type);
    return DeclaredFunctionResult::Value(handle);
}

// Keeps foreign ABIs explicit and limits the browser boundary to values with
// one stable WebAssembly representation.
fn (self: &Checker) validate_host_function_signature(
    tree: &ast::Ast,
    signature: &ast::FunctionSignature,
    params: &array::Array<Type>,
    return_type: Type
) -> ?TypeCollectionIssue {
    let retained_extern_abi = tree.texts.at(signature.extern_abi.node);
    let extern_abi = retained_extern_abi.as_bytes();
    let retained_export_abi = tree.texts.at(signature.export_abi.node);
    let export_abi = retained_export_abi.as_bytes();
    if mem::len(extern_abi) > 0 and mem::len(export_abi) > 0 {
        return TypeCollectionIssue::FunctionExternAndExport(signature.name);
    }
    if mem::len(extern_abi) > 0 and
        !mem::equal_bytes(extern_abi, "c") and
        !mem::equal_bytes(extern_abi, "browser") {
        return TypeCollectionIssue::UnsupportedExternAbi(signature.extern_abi);
    }
    if mem::len(export_abi) > 0 and !mem::equal_bytes(export_abi, "browser") {
        return TypeCollectionIssue::UnsupportedExportAbi(signature.export_abi);
    }
    if mem::equal_bytes(extern_abi, "c") {
        return self.validate_c_host_function_types(signature, params, return_type);
    }
    let browser_import = mem::equal_bytes(extern_abi, "browser");
    let browser_export = mem::equal_bytes(export_abi, "browser");
    if !browser_import and !browser_export {
        return null;
    }
    if signature.receiver {
        return TypeCollectionIssue::BrowserHostMethod(signature.name);
    }
    if signature.static_params.len() > 0 {
        return TypeCollectionIssue::BrowserHostStaticParams(signature.name);
    }
    let retained_name = tree.texts.at(signature.name.node);
    let name = retained_name.as_bytes();
    if browser_export {
        if collection_name_has_leaf(name, "main") {
            return TypeCollectionIssue::BrowserExportMain;
        }
        if collection_name_has_leaf(name, "memory") or
            collection_name_has_leaf(name, "kizu_start") {
            return TypeCollectionIssue::BrowserExportReserved(signature.name);
        }
    }
    var index = 0;
    while params.get(index) |parameter_type| {
        let issue = self.host_param_issue(signature, index, parameter_type);
        if signature.params.at(index) |parameter| {
            if parameter.borrow or parameter.mut_borrow {
                return TypeCollectionIssue::BrowserHostBorrowParam(issue);
            }
        }
        if !browser_host_scalar(&self.types, parameter_type) and
            !(browser_import and self.types.is_text(parameter_type, "[]u8")) {
            return TypeCollectionIssue::BrowserHostParam(issue);
        }
        index = index + 1;
    }
    if !self.types.is_text(return_type, "void") and
        !browser_host_scalar(&self.types, return_type) {
        let issue = CollectionNamedTypeIssue {
            name: signature.name, type_name: return_type, span: signature.span
        };
        return TypeCollectionIssue::BrowserHostReturn(issue);
    }
    return null;
}

/// Limits a C function's boundary to what C can name, the Go
/// `validateCHostFunctionTypes`: integers, floats, bool, and raw pointers. A
/// view, a borrow, an owner, a struct, or an error union has no C
/// representation; passing one hands C the address of something it cannot
/// read, and taking one back hands Kizu a value C never built.
fn (self: &Checker) validate_c_host_function_types(
    signature: &ast::FunctionSignature,
    params: &array::Array<Type>,
    return_type: Type
) -> ?TypeCollectionIssue {
    var index = 0;
    while params.get(index) |parameter_type| {
        let issue = self.host_param_issue(signature, index, parameter_type);
        if signature.params.at(index) |parameter| {
            if parameter.borrow or parameter.mut_borrow {
                return TypeCollectionIssue::CHostBorrowParam(issue);
            }
        }
        if !c_host_scalar(&self.types, parameter_type) {
            return TypeCollectionIssue::CHostParam(issue);
        }
        index = index + 1;
    }
    if !self.types.is_text(return_type, "void") and !c_host_scalar(&self.types, return_type) {
        let issue = CollectionNamedTypeIssue {
            name: signature.name, type_name: return_type, span: signature.span
        };
        return TypeCollectionIssue::CHostReturn(issue);
    }
    return null;
}

/// Describes one host boundary parameter for a diagnostic: its position,
/// its type, and whether the declaration borrows it mutably.
fn (self: &Checker) host_param_issue(
    signature: &ast::FunctionSignature,
    index: i64,
    parameter_type: Type
) -> CollectionHostParamIssue {
    var mut_borrow = false;
    if signature.params.at(index) |parameter| {
        mut_borrow = parameter.mut_borrow;
    }
    return CollectionHostParamIssue {
        name: signature.name, index: index + 1, type_name: parameter_type, mut_borrow: mut_borrow,
        span: signature.span
    };
}

/// Reports whether value has one C representation, the Go `cHostScalar`.
fn c_host_scalar(types: &TypeTable, value: Type) -> bool {
    return browser_host_scalar(types, value) or
        types.is_text(value, "f32") or types.is_text(value, "f64");
}

fn browser_host_scalar(types: &TypeTable, value: Type) -> bool {
    if types.is_text(value, "bool") or types.is_pointer_type(value) {
        return true;
    }
    return types.is_text(value, "i8") or types.is_text(value, "i16") or
        types.is_text(value, "i32") or types.is_text(value, "i64") or
        types.is_text(value, "u8") or types.is_text(value, "u16") or
        types.is_text(value, "u32") or types.is_text(value, "u64") or
        types.is_text(value, "usize") or types.is_text(value, "isize");
}

fn collection_name_has_leaf(name: []u8, leaf: []u8) -> bool {
    var index = mem::len(name);
    while index > 1 {
        index = index - 1;
        if name[index] == cast<u8>(58) and name[index - 1] == cast<u8>(58) {
            return mem::equal_bytes(name[index + 1..], leaf);
        }
    }
    return mem::equal_bytes(name, leaf);
}

fn function_storage_issue(
    allocator: Allocator,
    storage: FunctionParamStorage,
    issue: TypeCollectionIssue
) -> DeclaredFunctionResult {
    storage.deinit(allocator);
    return DeclaredFunctionResult::Issue(issue);
}

fn (self: &var Checker) collect_function_parameter(
    std_function: bool, parameter: &ast::Param, parameter_type: Type,
    storage: &var FunctionParamStorage
) -> !?TypeCollectionIssue {
    if !std_function and self.types.contains_borrow_optional(parameter_type) {
        return TypeCollectionIssue::ParamBorrowOptional(parameter.name);
    }
    if self.types.is_text(parameter_type, "void") {
        return TypeCollectionIssue::ParamVoid(parameter.name);
    }
    if self.types.contains_type_value(parameter_type) {
        return TypeCollectionIssue::ParamTypeValue(parameter.name);
    }
    if self.types.contains_buffer_type(parameter_type) {
        return TypeCollectionIssue::ParamBuffer(parameter.name);
    }
    if compile_time_only_type(&self.types, parameter_type) {
        let named = CollectionNamedTypeIssue {
            name: parameter.name, type_name: parameter_type, span: ast::zero_span()
        };
        return TypeCollectionIssue::ParamCompileTimeOnly(named);
    }
    if try self.types.optional_elem(parameter_type) |_| {
        if parameter.borrow {
            return TypeCollectionIssue::ParamBorrowOptionalValue(parameter.name);
        }
    }
    try storage.params.append(self.allocator, parameter_type);
    try storage.borrow_params.append(self.allocator, parameter.borrow);
    try storage.mut_borrow_params.append(self.allocator, parameter.mut_borrow);
    return null;
}

fn (self: &var Checker) reserved_static_parameter(tree: &ast::Ast, signature: &ast::FunctionSignature) -> !?ast::Text {
    if signature.std {
        return null;
    }
    var index = 0;
    while signature.static_params.at(index) |parameter| {
        if parameter.type_name |type_name| {
            let retained = try self.types.remember(&tree.types, type_name);
            if self.types.is_text(retained, "Function") {
                return parameter.name;
            }
        }
        index = index + 1;
    }
    return null;
}

fn (self: &var Checker) cache_function_signature(tree: &ast::Ast, source: &ast::FunctionSignature) -> !FunctionSignatureType {
    let retained_abi = tree.texts.at(source.extern_abi.node);
    let abi = retained_abi.as_bytes();
    let retained_export_abi = tree.texts.at(source.export_abi.node);
    let export_abi = retained_export_abi.as_bytes();
    var extern_abi_text = try string::from_bytes(self.allocator, abi);
    errdefer extern_abi_text.deinit(self.allocator);
    var signature = FunctionSignatureType {
        extern_abi: move extern_abi_text,
        export_abi: try string::from_bytes(self.allocator, export_abi),
        static_params: array::new<StaticParamType>(self.allocator),
        params: array::new<SignatureParamType>(self.allocator),
        return_type: empty_type(),
        requires_unsafe: source.requires_unsafe,
        std: source.std
    };
    errdefer signature.deinit(self.allocator);
    var index = 0;
    while source.static_params.at(index) |parameter| {
        let retained_name = tree.texts.at(parameter.name.node);
        let name = retained_name.as_bytes();
        var type_name = empty_type();
        var is_type = true;
        if parameter.type_name |written_type| {
            type_name = try self.types.remember(&tree.types, written_type);
            is_type = false;
        }
        let copied = try string::from_bytes(self.allocator, name);
        errdefer copied.deinit(self.allocator);
        try signature.static_params.append(self.allocator, StaticParamType {
            name: move copied, type_name: type_name, is_type: is_type
        });
        index = index + 1;
    }
    index = 0;
    while source.params.at(index) |parameter| {
        let retained_name = tree.texts.at(parameter.name.node);
        let name = retained_name.as_bytes();
        let copied = try string::from_bytes(self.allocator, name);
        errdefer copied.deinit(self.allocator);
        try signature.params.append(self.allocator, SignatureParamType {
            name: move copied, borrow: parameter.borrow,
            mut_borrow: parameter.mut_borrow
        });
        index = index + 1;
    }
    if source.return_type |written_return| {
        signature.return_type = try self.types.remember(&tree.types, written_return);
    }
    return move signature;
}

fn (self: &Checker) type_collection_diagnostic(tree: &ast::Ast, issue: TypeCollectionIssue) -> !diagnostic::Diagnostic {
    match issue {
        Resolution(resolution_issue) => return self.type_resolution_diagnostic(resolution_issue),
        _ => {},
    }
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    var category = "type error";
    var span = ast::zero_span();
    match issue {
        DuplicateType(name) => {
            try message.append_bytes(self.allocator, "duplicate type `");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        DuplicateEnumTag(member) => {
            try message.append_bytes(self.allocator, "duplicate enum tag `");
            try append_collection_member(self.allocator, &var message, tree, member, "::");
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        DuplicateError(member) => {
            try message.append_bytes(self.allocator, "duplicate error `");
            try append_collection_member(self.allocator, &var message, tree, member, "::");
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        DuplicateUnionVariant(member) => {
            try message.append_bytes(self.allocator, "duplicate union variant `");
            try append_collection_member(self.allocator, &var message, tree, member, "::");
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        DuplicateContract(name) => {
            try message.append_bytes(self.allocator, "duplicate contract `");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        DuplicateContractMethod(member) => {
            try message.append_bytes(self.allocator, "duplicate contract method `");
            try append_collection_member(self.allocator, &var message, tree, member, ".");
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        DuplicateMethod(name) => {
            try message.append_bytes(self.allocator, "duplicate method `");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        DuplicateFunction(name) => {
            try message.append_bytes(self.allocator, "duplicate function `");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        FunctionNameIsType(name) => {
            try message.append_byte(self.allocator, cast<u8>(96));
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, "` is a type and cannot name a function");
        },
        UnknownContract(name) => {
            try message.append_bytes(self.allocator, "unknown contract `");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        MissingContractMethod(impl_method) => {
            try message.append_byte(self.allocator, cast<u8>(96));
            try append_collection_text(self.allocator, &var message, tree, impl_method.type_name);
            try message.append_bytes(self.allocator, "` does not satisfy `");
            try append_collection_text(self.allocator, &var message, tree, impl_method.contract_name);
            try message.append_byte(self.allocator, cast<u8>(96));
            try message.append_bytes(self.allocator, ": missing method `");
            if self.metadata.functions.at(impl_method.method.index) |function| {
                let name = function.name.as_bytes();
                try message.append_bytes(self.allocator, name);
            }
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        ContractMethodMismatch(impl_method) => {
            try message.append_byte(self.allocator, cast<u8>(96));
            try append_collection_text(self.allocator, &var message, tree, impl_method.type_name);
            try message.append_byte(self.allocator, cast<u8>(46));
            if self.metadata.functions.at(impl_method.method.index) |function| {
                let name = function.name.as_bytes();
                try message.append_bytes(self.allocator, name);
            }
            try message.append_bytes(self.allocator, "` does not match contract `");
            try append_collection_text(self.allocator, &var message, tree, impl_method.contract_name);
            try message.append_byte(self.allocator, cast<u8>(96));
        },
        Resolution(_) => {
            // Handled before message storage is created.
},
        UnionOptional(member) => {
            try message.append_bytes(self.allocator, "union payload `");
            try append_collection_member(self.allocator, &var message, tree, member, "::");
            try message.append_bytes(self.allocator, "` cannot store an optional yet");
        },
        UnionBorrow(member) => {
            try message.append_bytes(self.allocator, "borrow payload `");
            try append_collection_member(self.allocator, &var message, tree, member, ".");
            try message.append_bytes(self.allocator, "` cannot store borrow");
        },
        UnionTypeValue(member) => {
            try message.append_bytes(self.allocator, "union variant `");
            try append_collection_member(self.allocator, &var message, tree, member, "::");
            try message.append_bytes(self.allocator, "` cannot store type value");
        },
        StructObligationDoc(name) => {
            category = "unsafe error";
            try message.append_bytes(self.allocator, "`unsafe struct ");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, "` needs a `///` comment stating the invariant its fields carry");
        },
        StructBorrow(member) => {
            try message.append_bytes(self.allocator, "borrow field `");
            try append_collection_member(self.allocator, &var message, tree, member, ".");
            try message.append_bytes(self.allocator, "` cannot store borrow");
        },
        StructRawPointer(member) => {
            category = "unsafe error";
            try message.append_bytes(self.allocator, "struct `");
            try append_collection_text(self.allocator, &var message, tree, member.owner);
            try message.append_bytes(self.allocator, "` holds a raw pointer in field `");
            try append_collection_text(self.allocator, &var message, tree, member.member);
            try message.append_bytes(self.allocator, "`, so it must be declared `unsafe struct`");
        },
        StructCompileTimeOnly(named) => {
            try message.append_bytes(self.allocator, "struct field `");
            try append_collection_member(self.allocator, &var message, tree, named.member, ".");
            try message.append_bytes(self.allocator, "` cannot store ");
            try self.append_checker_type(&var message, named.type_name);
        },
        StructTypeValue(member) => {
            try message.append_bytes(self.allocator, "struct field `");
            try append_collection_member(self.allocator, &var message, tree, member, ".");
            try message.append_bytes(self.allocator, "` cannot store type value");
        },
        StructBuffer(member) => {
            try message.append_bytes(self.allocator, "struct field `");
            try append_collection_member(self.allocator, &var message, tree, member, ".");
            try message.append_bytes(self.allocator, "` cannot store stack buffer");
        },
        StructOptionalView(member) => {
            try message.append_bytes(self.allocator, "struct field `");
            try append_collection_member(self.allocator, &var message, tree, member, ".");
            try message.append_bytes(self.allocator, "` cannot store an optional view; a capture would be hidden ");
            try message.append_bytes(self.allocator, "from the rules that read field types");
        },
        FunctionObligationDoc(name) => {
            category = "unsafe error";
            try message.append_bytes(self.allocator, "`unsafe fn ");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, "` needs a `///` comment stating what the caller must uphold");
        },
        ReservedFunctionStaticParam(name) => {
            try message.append_bytes(self.allocator, "Function static parameter `");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, "` is reserved for std");
        },
        FunctionReturnCompileTimeOnly(named) => {
            try append_function_name(self.allocator, &var message, tree, named.name);
            try message.append_bytes(self.allocator, " cannot return ");
            try self.append_checker_type(&var message, named.type_name);
        },
        FunctionReturnBuffer(name) => {
            try append_function_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot return a stack buffer; return an owned buffer or ");
            try message.append_bytes(self.allocator, "write through a view");
        },
        FunctionReturnTypeValue(name) => {
            try append_function_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot return type");
        },
        FunctionReturnNestedBorrowOptional(name) => {
            try append_function_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot nest a borrow optional in its return; declare a bare ");
            try message.append_bytes(self.allocator, "`?&T` / `?&var T`");
        },
        ParamBorrowOptional(name) => {
            try append_parameter_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot hold a borrow optional; `?&T` exists only as a ");
            try message.append_bytes(self.allocator, "capture condition");
        },
        ParamVoid(name) => {
            try append_parameter_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot have type void");
        },
        ParamTypeValue(name) => {
            try append_parameter_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot have type");
        },
        ParamBuffer(name) => {
            try message.append_bytes(self.allocator, "stack buffer parameter `");
            try append_collection_text(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, "` is not supported; pass a view (`[]u8` or `&var []u8`)");
        },
        ParamCompileTimeOnly(named) => {
            try self.append_checker_type(&var message, named.type_name);
            try message.append_bytes(self.allocator, " parameter `");
            try append_collection_text(self.allocator, &var message, tree, named.name);
            try message.append_bytes(self.allocator, "` belongs in `<...>`, not `(...)`");
        },
        ParamBorrowOptionalValue(name) => {
            try append_parameter_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot borrow an optional yet");
        },
        FunctionExternAndExport(name) => {
            try append_function_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot be both extern and export");
        },
        UnsupportedExternAbi(abi) => {
            try message.append_bytes(self.allocator, "unsupported extern ABI ");
            try message.append_byte(self.allocator, cast<u8>(34));
            try append_collection_text(self.allocator, &var message, tree, abi);
            try message.append_byte(self.allocator, cast<u8>(34));
        },
        UnsupportedExportAbi(abi) => {
            try message.append_bytes(self.allocator, "unsupported export ABI ");
            try message.append_byte(self.allocator, cast<u8>(34));
            try append_collection_text(self.allocator, &var message, tree, abi);
            try message.append_byte(self.allocator, cast<u8>(34));
        },
        BrowserHostMethod(name) => {
            try message.append_bytes(self.allocator, "browser host ");
            try append_function_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot be a method");
        },
        BrowserHostStaticParams(name) => {
            try message.append_bytes(self.allocator, "browser host ");
            try append_function_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator, " cannot have static parameters");
        },
        BrowserExportMain => {
            try message.append_bytes(self.allocator,
                "browser export `main` conflicts with the program entry"
            );
        },
        BrowserExportReserved(name) => {
            try message.append_bytes(self.allocator, "browser export ");
            try append_function_name(self.allocator, &var message, tree, name);
            try message.append_bytes(self.allocator,
                " conflicts with a reserved browser export"
            );
        },
        BrowserHostBorrowParam(host_param) => {
            span = host_param.span;
            try message.append_bytes(self.allocator, "browser host ");
            try append_function_name(self.allocator, &var message, tree, host_param.name);
            try message.append_bytes(self.allocator, " cannot borrow parameter ");
            try fmt::append_i64(self.allocator, &var message, host_param.index);
        },
        BrowserHostParam(host_param) => {
            span = host_param.span;
            try message.append_bytes(self.allocator, "browser host ");
            try append_function_name(self.allocator, &var message, tree, host_param.name);
            try message.append_bytes(self.allocator, " parameter ");
            try fmt::append_i64(self.allocator, &var message, host_param.index);
            try message.append_bytes(self.allocator, " has unsupported type ");
            try self.append_checker_type(&var message, host_param.type_name);
        },
        BrowserHostReturn(named) => {
            span = named.span;
            try message.append_bytes(self.allocator, "browser host ");
            try append_function_name(self.allocator, &var message, tree, named.name);
            try message.append_bytes(self.allocator, " has unsupported return type ");
            try self.append_checker_type(&var message, named.type_name);
        },
        CHostBorrowParam(host_param) => {
            span = host_param.span;
            try message.append_bytes(self.allocator, "C ");
            try append_function_name(self.allocator, &var message, tree, host_param.name);
            try message.append_bytes(self.allocator, " parameter ");
            try fmt::append_i64(self.allocator, &var message, host_param.index);
            try message.append_bytes(self.allocator, " is a borrow (`");
            try self.append_c_host_param_spelling(&var message, tree, host_param);
            try message.append_bytes(self.allocator, "`), which C cannot receive");
        },
        CHostParam(host_param) => {
            span = host_param.span;
            try message.append_bytes(self.allocator, "C ");
            try append_function_name(self.allocator, &var message, tree, host_param.name);
            try message.append_bytes(self.allocator, " parameter ");
            try fmt::append_i64(self.allocator, &var message, host_param.index);
            try message.append_bytes(self.allocator, " has type `");
            try self.append_checker_type(&var message, host_param.type_name);
            try message.append_bytes(self.allocator, "`, which C cannot receive");
        },
        CHostReturn(named) => {
            span = named.span;
            try message.append_bytes(self.allocator, "C ");
            try append_function_name(self.allocator, &var message, tree, named.name);
            try message.append_bytes(self.allocator, " returns `");
            try self.append_checker_type(&var message, named.type_name);
            try message.append_bytes(self.allocator, "`, which C cannot produce");
        },
    }
    var value = try new_checker_diagnostic_at(self.allocator, category, span, move message);
    errdefer value.deinit(self.allocator);
    match issue {
        StructObligationDoc(_) => try value.with_help(self.allocator,
            "write `/// <the invariant its fields carry>` above the declaration"
        ),
        FunctionObligationDoc(_) => try value.with_help(self.allocator,
            "write `/// <what the caller must uphold>` above the declaration"
        ),
        StructRawPointer(member) => {
            var help = string::new(self.allocator);
            defer help.deinit(self.allocator);
            try help.append_bytes(self.allocator, "write `unsafe struct ");
            try append_collection_text(self.allocator, &var help, tree, member.owner);
            try help.append_bytes(self.allocator, "` and document the invariant its fields carry");
            let help_text = help.as_bytes();
            try value.with_help(self.allocator, help_text);
        },
        CHostBorrowParam(_) => try add_c_host_advice(self.allocator, &var value),
        CHostParam(_) => try add_c_host_advice(self.allocator, &var value),
        CHostReturn(_) => try add_c_host_advice(self.allocator, &var value),
        _ => {},
    }
    return move value;
}

/// Adds what C can carry and how to hand it the value, the Go
/// `cHostTypeError` note and help.
fn add_c_host_advice(allocator: Allocator, value: &var diagnostic::Diagnostic) -> !void {
    try value.with_note(allocator,
        "a C function passes only what C can name: an integer, a float, `bool`, `ptr<T>`, `ptr<const T>`, or a nullable pointer"
    );
    return value.with_help(allocator,
        "spell the value as C sees it: `ptr<const u8>` with a `usize` length for bytes, `ptr<T>` for a value C reads or writes in place"
    );
}

/// Spells a borrowed C parameter the way its declaration does, the Go
/// `"&var " + spelled` / `"&" + spelled`.
fn (self: &Checker) append_c_host_param_spelling(
    message: &var string::String,
    tree: &ast::Ast,
    host_param: CollectionHostParamIssue
) -> !void {
    if host_param.mut_borrow {
        try message.append_bytes(self.allocator, "&var ");
    } else {
        try message.append_bytes(self.allocator, "&");
    }
    return self.append_checker_type(message, host_param.type_name);
}

fn new_checker_diagnostic(allocator: Allocator, category: []u8, message: string::String) -> !diagnostic::Diagnostic {
    return new_checker_diagnostic_at(allocator, category, ast::zero_span(), move message);
}

/// Builds one collection diagnostic at span, the place the issue names.
fn new_checker_diagnostic_at(
    allocator: Allocator,
    category: []u8,
    span: ast::Span,
    message: string::String
) -> !diagnostic::Diagnostic {
    defer message.deinit(allocator);
    let message_text = message.as_bytes();
    return diagnostic::new(
        allocator, diagnostic::Severity::Error, category,
        span, message_text
    );
}

fn (self: &Checker) type_resolution_diagnostic(
    issue: TypeResolutionIssue
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    let category = try self.append_type_resolution_diagnostic(&var message, issue);
    return new_checker_diagnostic(self.allocator, category, move message);
}

fn append_collection_text(allocator: Allocator, out: &var string::String, tree: &ast::Ast, text: ast::Text) -> !void {
    let retained = tree.texts.at(text.node);
    let bytes = retained.as_bytes();
    return out.append_bytes(allocator, bytes);
}

fn append_collection_member(allocator: Allocator, out: &var string::String, tree: &ast::Ast, issue: CollectionMemberIssue, separator: []u8) -> !void {
    try append_collection_text(allocator, out, tree, issue.owner);
    try out.append_bytes(allocator, separator);
    return append_collection_text(allocator, out, tree, issue.member);
}

fn append_function_name(allocator: Allocator, out: &var string::String, tree: &ast::Ast, name: ast::Text) -> !void {
    try out.append_bytes(allocator, "function `");
    try append_collection_text(allocator, out, tree, name);
    return out.append_byte(allocator, cast<u8>(96));
}

fn append_parameter_name(allocator: Allocator, out: &var string::String, tree: &ast::Ast, name: ast::Text) -> !void {
    try out.append_bytes(allocator, "parameter `");
    try append_collection_text(allocator, out, tree, name);
    return out.append_byte(allocator, cast<u8>(96));
}

fn (self: &Checker) append_checker_type(out: &var string::String, value: Type) -> !void {
    let text = try self.types.copy_text(self.allocator, value);
    defer text.deinit(self.allocator);
    let bytes = text.as_bytes();
    return out.append_bytes(self.allocator, bytes);
}

fn (self: &Checker) append_type_resolution_diagnostic(out: &var string::String, issue: TypeResolutionIssue) -> ![]u8 {
    match issue {
        Missing => {
            try out.append_bytes(self.allocator, "missing type");
            return "type error";
        },
        Unknown(subject) => {
            try out.append_bytes(self.allocator, "unknown type `");
            try self.append_checker_type(out, subject);
            try out.append_byte(self.allocator, cast<u8>(96));
            return "type error";
        },
        WrapsOptional(subject) => {
            try out.append_byte(self.allocator, cast<u8>(96));
            try self.append_checker_type(out, subject);
            try out.append_bytes(self.allocator, "` cannot wrap an optional yet");
            return "type error";
        },
        ErrorSetRequired(subject) => {
            try out.append_bytes(self.allocator, "the error of `E!T` must be an `error` set, got `");
            try self.append_checker_type(out, subject);
            try out.append_byte(self.allocator, cast<u8>(96));
            return "type error";
        },
        OptionalStaticArg(subject) => {
            try out.append_bytes(self.allocator, "optional `");
            try self.append_checker_type(out, subject);
            try out.append_bytes(self.allocator, "` cannot be a static argument yet");
            return "type error";
        },
        SingleGenericArity(subject) => {
            try out.append_byte(self.allocator, cast<u8>(96));
            try self.append_checker_type(out, subject);
            try out.append_bytes(self.allocator, "` expects 1 static argument");
            return "type error";
        },
        MapArity => {
            try out.append_bytes(self.allocator, "std::map::Map expects 2 static arguments");
            return "type error";
        },
        MapKey => {
            try out.append_bytes(self.allocator, "std::map::Map key type must be one of ");
            try out.append_bytes(self.allocator, typ::map_key_type_names());
            return "type error";
        },
        UnknownGeneric(subject) => {
            try out.append_bytes(self.allocator, "unknown generic type `");
            try self.append_checker_type(out, subject);
            try out.append_byte(self.allocator, cast<u8>(96));
            return "type error";
        },
        UserGenericArity(arity) => {
            try out.append_byte(self.allocator, cast<u8>(96));
            try self.append_checker_type(out, arity.subject);
            try out.append_bytes(self.allocator, "` expects ");
            try fmt::append_i64(self.allocator, out, arity.expected);
            try out.append_bytes(self.allocator, " static arguments");
            return "type error";
        },
        OptionalOptional(subject) => {
            try out.append_bytes(self.allocator, "optional cannot wrap an optional `");
            try self.append_checker_type(out, subject);
            try out.append_byte(self.allocator, cast<u8>(96));
            return "type error";
        },
        OptionalErrorUnion(subject) => {
            try out.append_bytes(self.allocator, "optional cannot wrap an error union `");
            try self.append_checker_type(out, subject);
            try out.append_bytes(self.allocator, "`; spell it `E!?T`");
            return "type error";
        },
        MetaNotType(form) => {
            try append_meta_form(self.allocator, out, form);
            try out.append_bytes(self.allocator, " does not name a type");
            return "comptime error";
        },
        MetaArity(arity) => {
            try append_meta_form(self.allocator, out, arity.form);
            try out.append_bytes(self.allocator, " expects ");
            try fmt::append_i64(self.allocator, out, arity.expected);
            try out.append_bytes(self.allocator, " static arguments, got ");
            try fmt::append_i64(self.allocator, out, arity.actual);
            return "comptime error";
        },
        MetaCaptureUnbound(capture) => {
            try out.append_byte(self.allocator, cast<u8>(96));
            try self.append_checker_type(out, capture);
            try out.append_bytes(self.allocator, "` is not a comptime capture");
            return "comptime error";
        },
        MetaCaptureKind(kind) => {
            try append_meta_form(self.allocator, out, kind.form);
            try out.append_bytes(self.allocator, " expects a ");
            if stdmeta::variant_form(kind.form) {
                try out.append_bytes(self.allocator, "variant");
            } else {
                try out.append_bytes(self.allocator, "field");
            }
            try out.append_bytes(self.allocator, " capture, got `");
            try self.append_checker_type(out, kind.capture);
            try out.append_byte(self.allocator, cast<u8>(96));
            return "comptime error";
        },
        MetaCaptureOwner(owner_issue) => {
            try out.append_bytes(self.allocator, "capture `");
            try self.append_checker_type(out, owner_issue.capture_type());
            try out.append_bytes(self.allocator, "` belongs to ");
            let field = self.meta_field_entries.at(owner_issue.field_handle().node);
            try self.append_checker_type(out, field.owner);
            try out.append_bytes(self.allocator, ", not ");
            try self.append_checker_type(out, owner_issue.owner_type());
            return "comptime error";
        },
        MetaVariantNoPayload(handle) => {
            let field = self.meta_field_entries.at(handle.node);
            try out.append_bytes(self.allocator, "variant `");
            try self.append_checker_type(out, field.owner);
            try out.append_bytes(self.allocator, "::");
            let name = field.name.as_bytes();
            try out.append_bytes(self.allocator, name);
            try out.append_bytes(self.allocator, "` carries no payload, so `");
            try out.append_bytes(self.allocator, stdmeta::spelling(stdmeta::Form::VariantType));
            try out.append_bytes(self.allocator, "` names nothing; ask `");
            try out.append_bytes(self.allocator, stdmeta::spelling(stdmeta::Form::HasPayload));
            try out.append_byte(self.allocator, cast<u8>(96));
            try out.append_bytes(self.allocator, " first");
            return "comptime error";
        },
        MetaElementArity => {
            try append_meta_form(self.allocator, out, stdmeta::Form::Element);
            try out.append_bytes(self.allocator, " expects 1 static argument");
            return "comptime error";
        },
        MetaElementUnsupported(subject) => {
            try append_meta_form(self.allocator, out, stdmeta::Form::Element);
            try out.append_bytes(self.allocator, " expects ?T, Array<T>, Box<T>, or Map<K, V>, got ");
            try self.append_checker_type(out, subject);
            return "comptime error";
        },
    }
}

fn append_meta_form(allocator: Allocator, out: &var string::String, form: stdmeta::Form) -> !void {
    try out.append_byte(allocator, cast<u8>(96));
    try out.append_bytes(allocator, stdmeta::spelling(form));
    return out.append_byte(allocator, cast<u8>(96));
}
