import compiler::internal::ast;
import compiler::internal::lexer;
import compiler::internal::parser;
import std::mem;
import std::testing;

test "checker metadata predeclares every type name" {
    let allocator = mem::page_allocator();
    let input =
        \\struct Later { value: i64 }
        \\pub enum Choice { First }
        \\error Problem { Failed }
        \\union Maybe { None, Some(i64) }
        \\contract Readable { fn read(self: i64); }
        \\fn run() {}
    ;
    var tree = ast::new(allocator);
    defer tree.deinit();
    let scanner = lexer::new(allocator, input);
    var source_parser = try parser::new(allocator, move scanner);
    defer source_parser.deinit();
    let program = try source_parser.parse_program(&var tree);
    defer program.deinit();
    var metadata = new_checker_metadata(allocator);
    defer metadata.deinit();
    try predeclare_type_names(&tree, &program, &var metadata);
    testing::expect(metadata.has_declared_type("Later"));
    testing::expect(metadata.has_declared_type("Choice"));
    testing::expect(metadata.has_declared_type("Problem"));
    testing::expect(metadata.has_declared_type("Maybe"));
    testing::expect(metadata.has_declared_type("Readable"));
    testing::expect(!metadata.has_declared_type("run"));
    testing::expect(metadata.is_type_name("i64"));
    testing::expect(metadata.is_type_name("Choice"));
    testing::expect(metadata.is_type_name("std::array::Array"));
    testing::expect(!metadata.is_type_name("Missing"));
    var index = 0;
    while program.declarations.get(index) |declaration| {
        match tree.declarations.at(declaration.node) {
            Enum(value) => {
                if try collect_enum_decision(
                    allocator,
                    &tree,
                    value,
                    &var metadata
                ) |_| {
                    testing::fail("enum metadata collection failed");
                }
            },
            ErrorSet(value) => {
                if try collect_error_set_decision(
                    allocator,
                    &tree,
                    value,
                    &var metadata
                ) |_| {
                    testing::fail("error-set metadata collection failed");
                }
            },
            _ => {},
        }
        index = index + 1;
    }
    testing::expect(metadata.is_user_declared_type("Choice"));
    testing::expect(metadata.is_user_declared_type("Problem"));
    testing::expect(!metadata.is_user_declared_type("Missing"));
    testing::expect(metadata.is_public_type(&tree, "Choice"));
    testing::expect(!metadata.is_public_type(&tree, "Problem"));
    testing::expect(!metadata.is_public_type(&tree, "Missing"));
}
