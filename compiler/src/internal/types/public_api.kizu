import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::typ;
import std::array;
import std::mem;
import std::sort;
import std::string;

struct PrivateTypeNames {
    values: array::Array<string::String>, found: ?i64
}

union PublicAPIContext {
    FunctionParameter(ast::Text),
    FunctionReturn(ast::Text),
    Field(CollectionMemberIssue),
    UnionVariant(CollectionMemberIssue),
}

struct PrivateExposureIssue {
    context: PublicAPIContext, private_name: i64
}

union PublicAPIIssue {
    PrivateExposure(PrivateExposureIssue),
    UnsafeStructField(CollectionMemberIssue),
}

// Rejects the first private type exposed by a public declaration in source
// order, matching the shipping Checker's checkPublicAPI phase.
fn (self: &Checker) check_public_api(tree: &ast::Ast, program: &ast::Program) -> !?diagnostic::Diagnostic {
    var private_names = try collect_private_type_names(self.allocator, tree, program);
    defer private_names.deinit();
    var index = 0;
    while program.declarations.get(index) |declaration| {
        let issue = match tree.declarations.at(declaration.node) {
            Function(value) => if value.signature.public {
                check_public_signature(tree, &value.signature, &var private_names)
            } else {
                no_public_api_issue()
            },
            Struct(value) => check_public_struct_fields(tree, value, &var private_names),
            Union(value) => check_public_union_variants(tree, value, &var private_names),
            Contract(value) => check_public_contract(tree, value, &var private_names),
            _ => no_public_api_issue(),
        };
        if issue |failure| {
            let value = try self.public_api_diagnostic(tree, &private_names, failure);
            return move value;
        }
        index = index + 1;
    }
    return null;
}

fn no_public_api_issue() -> ?PublicAPIIssue {
    return null;
}

fn check_public_signature(tree: &ast::Ast, signature: &ast::FunctionSignature,
    private_names: &var PrivateTypeNames) -> ?PublicAPIIssue {
    var index = 0;
    while signature.params.at(index) |parameter| {
        if reject_private_type(&tree.types, parameter.type_name, private_names,
            PublicAPIContext::FunctionParameter(signature.name)) |issue| {
            return issue;
        }
        index = index + 1;
    }
    if signature.return_type |return_type| {
        return reject_private_type(&tree.types, return_type, private_names,
            PublicAPIContext::FunctionReturn(signature.name));
    }
    return null;
}

fn check_public_struct_fields(tree: &ast::Ast, declaration: &ast::StructDecl,
    private_names: &var PrivateTypeNames) -> ?PublicAPIIssue {
    var index = 0;
    while declaration.fields.at(index) |field| {
        if field.public {
            let member = CollectionMemberIssue {
                owner: declaration.name, member: field.name
            };
            if declaration.requires_unsafe {
                return PublicAPIIssue::UnsafeStructField(member);
            }
            if reject_private_type(&tree.types, field.type_name, private_names, PublicAPIContext::Field(member)) |issue| {
                return issue;
            }
        }
        index = index + 1;
    }
    return null;
}

fn check_public_union_variants(tree: &ast::Ast, declaration: &ast::UnionDecl,
    private_names: &var PrivateTypeNames) -> ?PublicAPIIssue {
    if !declaration.public {
        return null;
    }
    var index = 0;
    while declaration.variants.at(index) |variant| {
        if variant.payload |payload| {
            let member = CollectionMemberIssue {
                owner: declaration.name, member: variant.name
            };
            if reject_private_type(&tree.types, payload, private_names, PublicAPIContext::UnionVariant(member)) |issue| {
                return issue;
            }
        }
        index = index + 1;
    }
    return null;
}

fn check_public_contract(tree: &ast::Ast, declaration: &ast::ContractDecl,
    private_names: &var PrivateTypeNames) -> ?PublicAPIIssue {
    if !declaration.public {
        return null;
    }
    var index = 0;
    while declaration.methods.at(index) |method| {
        if check_public_signature(tree, &method.signature, private_names) |issue| {
            return issue;
        }
        index = index + 1;
    }
    return null;
}

fn reject_private_type(table: &typ::Table, type_name: typ::Type,
    private_names: &var PrivateTypeNames, context: PublicAPIContext) -> ?PublicAPIIssue {
    if private_names.find(table, type_name) |name| {
        return PublicAPIIssue::PrivateExposure(PrivateExposureIssue {
            context: context, private_name: name
        });
    }
    return null;
}

fn collect_private_type_names(allocator: Allocator, tree: &ast::Ast,
    program: &ast::Program) -> !PrivateTypeNames {
    var names = PrivateTypeNames { values: array::new<string::String>(allocator), found: null };
    errdefer names.deinit();
    var index = 0;
    while program.declarations.get(index) |declaration| {
        let node = tree.declarations.at(declaration.node);
        let private = match node {
            Struct(value) => !value.public,
            Enum(value) => !value.public,
            ErrorSet(value) => !value.public,
            Union(value) => !value.public,
            Contract(value) => !value.public,
            _ => false,
        };
        if private {
            if declared_type_name(node) |name| {
                let retained = tree.texts.at(name.node);
                let bytes = retained.as_bytes();
                let copied = try string::from_bytes(allocator, bytes);
                errdefer copied.deinit();
                try names.values.append(move copied);
            }
        }
        index = index + 1;
    }
    try sort::strings(&var names.values);
    return move names;
}

fn (self: &var PrivateTypeNames) find(table: &typ::Table, value: typ::Type) -> ?i64 {
    self.found = null;
    typ::walk<PrivateTypeNames>(table, value, self);
    return self.found;
}

fn (self: &var PrivateTypeNames) visit(value: &typ::Node) -> void {
    if self.found |_| {
        return;
    }
    match value {
        Name(name) => {
            var low = 0;
            var high = self.values.len();
            while low < high {
                let middle = low + (high - low) / 2;
                if self.values.at(middle) |candidate| {
                    let bytes = candidate.as_bytes();
                    let order = compare_type_path(&name.path, bytes);
                    if order == 0 {
                        self.found = middle;
                        return;
                    }
                    if order < 0 {
                        high = middle;
                    } else {
                        low = middle + 1;
                    }
                } else {
                    return;
                }
            }
        },
        _ => {},
    }
    return;
}

fn compare_type_path(path: &array::Array<string::String>, expected: []u8) -> i64 {
    let expected_len = mem::len(expected);
    var offset = 0;
    var index = 0;
    while path.at(index) |part| {
        if index > 0 {
            var separator = 0;
            while separator < 2 {
                if offset >= expected_len {
                    return 1;
                }
                let order = cast<i64>(cast<u8>(58)) - cast<i64>(expected[offset]);
                if order != 0 {
                    return order;
                }
                offset = offset + 1;
                separator = separator + 1;
            }
        }
        let bytes = part.as_bytes();
        var part_index = 0;
        while part_index < mem::len(bytes) {
            if offset >= expected_len {
                return 1;
            }
            let order = cast<i64>(bytes[part_index]) - cast<i64>(expected[offset]);
            if order != 0 {
                return order;
            }
            offset = offset + 1;
            part_index = part_index + 1;
        }
        index = index + 1;
    }
    return offset - expected_len;
}

fn (self: &Checker) public_api_diagnostic(tree: &ast::Ast,
    private_names: &PrivateTypeNames, issue: PublicAPIIssue) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit();
    var category = "type error";
    match issue {
        PrivateExposure(exposure) => {
            try message.append_bytes("public ");
            match exposure.context {
                FunctionParameter(name) => {
                    try append_function_name(&var message, tree, name);
                    try message.append_bytes(" parameter");
                },
                FunctionReturn(name) => {
                    try append_function_name(&var message, tree, name);
                    try message.append_bytes(" return type");
                },
                Field(member) => {
                    try message.append_bytes("field `");
                    try append_collection_member(&var message, tree, member, ".");
                    try message.append_byte(cast<u8>(96));
                },
                UnionVariant(member) => {
                    try message.append_bytes("union variant `");
                    try append_collection_member(&var message, tree, member, "::");
                    try message.append_byte(cast<u8>(96));
                },
            }
            try message.append_bytes(" exposes private type `");
            if private_names.values.at(exposure.private_name) |name| {
                let bytes = name.as_bytes();
                try message.append_bytes(bytes);
            }
            try message.append_byte(cast<u8>(96));
        },
        UnsafeStructField(member) => {
            category = "unsafe error";
            try message.append_bytes("`unsafe struct ");
            try append_collection_text(&var message, tree, member.owner);
            try message.append_bytes("` cannot have `pub` field `");
            try append_collection_text(&var message, tree, member.member);
            try message.append_byte(cast<u8>(96));
        },
    }
    var value = try new_checker_diagnostic(self.allocator, category, move message);
    errdefer value.deinit();
    match issue {
        UnsafeStructField(_) => try value.with_help(
            "drop `pub` so only this file can break the invariant"
        ),
        _ => {},
    }
    return move value;
}
