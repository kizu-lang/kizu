import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::stdprim;
import compiler::internal::typ;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// Validates one call and enforces the single borrow-optional consumption gate.
fn (self: &var Checker) check_call_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::CallExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var result = empty_type();
    if try self.check_call_expr_dispatch(tree, scope, expression, &var result) |problem| {
        return move problem;
    }
    let text = try self.types.copy_text(self.allocator, result);
    defer text.deinit(self.allocator);
    let bytes = text.as_bytes();
    if typ::borrow_optional_elem(bytes) |_| {
        if !self.capture_condition {
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, "a call returning ");
            try message.append_bytes(self.allocator, bytes);
            try message.append_bytes(self.allocator, 
                " must be consumed by a capture (`if call |name|` or `while call |name|`)"
            );
            return try self.checker_message_at("type error", ast::zero_span(), move message);
        }
    }
    out.* = result;
    return null;
}

// Validates a call made through a function pointer. The call is safe unless
// the pointee carries an obligation, which is what `unsafe fn(...)` spells:
// the marker is required for the same reason a direct call to an `unsafe fn`
// requires it.
fn (self: &var Checker) check_func_pointer_call(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    span: ast::Span,
    pointer: Type,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if self.types.function_pointer_is_unsafe(pointer) {
        var operation = string::new(self.allocator);
        defer operation.deinit(self.allocator);
        try operation.append_bytes(self.allocator, "call through `");
        try operation.append_bytes(self.allocator, name);
        try operation.append_byte(self.allocator, cast<u8>(96));
        let operation_bytes = operation.as_bytes();
        if try self.require_unsafe_capability_at(
            UnsafeCapability::UnsafeCall,
            operation_bytes,
            span
        ) |problem| {
            return move problem;
        }
    }
    let arity = self.types.function_pointer_arity(pointer);
    if args.len(tree) != arity {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, "` expects ");
        try fmt::append_i64(self.allocator, &var message, arity);
        try message.append_bytes(self.allocator, " argument(s), got ");
        try fmt::append_i64(self.allocator, &var message, args.len(tree));
        return try self.checker_message_at("type error", span, move message);
    }
    var index = 0;
    while index < arity {
        let declared = try self.types.function_pointer_part(pointer, index);
        var want = declared;
        var borrow = false;
        var mutable = false;
        if try self.types.explicit_borrow_type(declared) |parts| {
            want = parts.inner;
            borrow = true;
            mutable = parts.mutable;
        }
        let argument = args.get_or_panic(tree, index);
        var checked_argument = argument;
        if try self.prepare_borrow_argument(
            tree,
            scope,
            argument,
            borrow,
            mutable,
            &var checked_argument
        ) |problem| {
            return move problem;
        }
        if mutable {
            if try self.require_mutable_borrow_arg(
                tree,
                scope,
                checked_argument,
                want
            ) |problem| {
                return move problem;
            }
        }
        var got = empty_type();
        if try self.check_contextual_expr(
            tree,
            scope,
            checked_argument,
            want,
            &var got
        ) |problem| {
            return move problem;
        }
        match try self.types.coerce_returned_borrow_argument(got, want, borrow, mutable) {
            Value(value) => {
                got = value;
            },
            Error(reason) => return try self.borrow_argument_error(reason),
        }
        if !same_type(got, want) {
            return try self.func_pointer_arg_error(name, index, declared, got);
        }
        index = index + 1;
    }
    out.* = try self.types.function_pointer_part(pointer, -1);
    return null;
}

fn (self: &var Checker) func_pointer_arg_error(
    name: []u8,
    index: i64,
    want: Type,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` argument ");
    try fmt::append_i64(self.allocator, &var message, index + 1);
    try message.append_bytes(self.allocator, " expects ");
    let want_text = try self.types.copy_text(self.allocator, want);
    defer want_text.deinit(self.allocator);
    try message.append_string(self.allocator, &want_text);
    try message.append_bytes(self.allocator, ", got ");
    let got_text = try self.types.copy_text(self.allocator, got);
    defer got_text.deinit(self.allocator);
    try message.append_string(self.allocator, &got_text);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_call_expr_dispatch(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::CallExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.callee.node) {
        Field(field) => {
            let copied = ast::FieldExpr {
                receiver: field.receiver,
                name: field.name,
                namespace: field.namespace,
                span: field.span
            };
            return self.check_field_call_expr(tree, scope, &copied, expression.args, out);
        },
        TypeApply(apply) => {
            let copied = ast::TypeApplyExpr {
                callee: apply.callee,
                type_arg: apply.type_arg
            };
            return self.check_type_apply_call_expr(tree, scope, &copied, expression.args, out);
        },
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let source_name = retained.as_bytes();
            let owned_name = try string::from_bytes(self.allocator, source_name);
            defer owned_name.deinit(self.allocator);
            let name = owned_name.as_bytes();
            let span = identifier.span;
            if mem::equal_bytes(name, "print") {
                return self.check_print_call(tree, scope, expression.args, span, out);
            }
            if mem::equal_bytes(name, "ptr_read") {
                return self.check_ptr_read(tree, scope, span, expression.args, out);
            }
            if mem::equal_bytes(name, "ptr_write") {
                return self.check_ptr_write(tree, scope, span, expression.args, out);
            }
            if mem::equal_bytes(name, "volatile_read") {
                return self.check_volatile_read(tree, scope, span, expression.args, out);
            }
            if mem::equal_bytes(name, "volatile_write") {
                return self.check_volatile_write(tree, scope, span, expression.args, out);
            }
            if mem::equal_bytes(name, "Io") {
                return try self.checker_error_at(
                    "type error",
                    ast::zero_span(),
                    "use `std::io::blocking()`"
                );
            }
            // A binding shadows a declaration: a name bound to a function
            // pointer is called through the pointer, not looked up as one.
            // The lookup result is rebound before it is read: a capture of a
            // Type is not usable as a value in the expression that follows.
            var bound = empty_type();
            if self.scopes.lookup(scope, name) |resolved| {
                bound = resolved;
            }
            if self.types.is_function_pointer(bound) {
                return self.check_func_pointer_call(
                    tree, scope, name, span, bound, expression.args, out);
            }
            return self.check_user_call(tree, scope, name, span, expression.args, out);
        },
        _ => return try self.checker_error_at(
            "type error",
            ast::zero_span(),
            "callee must be a function name"
        ),
    }
}

fn (self: &var Checker) check_field_call_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    var handled = false;
    if try self.check_union_constructor_call(
        tree, scope, field, args, &var handled, out
    ) |problem| {
        return move problem;
    }
    if handled {
        return null;
    }
    if try self.check_qualified_user_call(tree, scope, field, args, &var handled, out) |problem| {
        return move problem;
    }
    if handled {
        return null;
    }
    if try self.check_qualified_builtin(tree, scope, field, args, &var handled, out) |problem| {
        return move problem;
    }
    if handled {
        return null;
    }
    return self.check_method_call_expr(tree, scope, field, args, out);
}

fn (self: &var Checker) check_qualified_user_call(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    args: ast::ExpressionList,
    handled: &var bool,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if try qualified_name(self.allocator, tree, field.receiver) |prefix| {
        defer prefix.deinit(self.allocator);
        var name = string::new(self.allocator);
        defer name.deinit(self.allocator);
        let prefix_bytes = prefix.as_bytes();
        try name.append_bytes(self.allocator, prefix_bytes);
        try name.append_bytes(self.allocator, "::");
        let retained_field = tree.texts.at(field.name.node);
        let field_name = retained_field.as_bytes();
        try name.append_bytes(self.allocator, field_name);
        let bytes = name.as_bytes();
        if self.metadata.functions_by_name.get(bytes) |function_handle| {
            if self.metadata.functions.at(function_handle.index) |function| {
                if function_has_type_params(function) {
                    handled.* = false;
                    return null;
                }
            }
            handled.* = true;
            let span = expression_span(tree, field.receiver);
            return self.check_user_call(tree, scope, bytes, span, args, out);
        }
    }
    handled.* = false;
    return null;
}

fn function_has_type_params(function: &FunctionType) -> bool {
    var index = 0;
    while function.signature.static_params.at(index) |parameter| {
        if parameter.is_type {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn (self: &var Checker) check_qualified_builtin(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    field: &ast::FieldExpr,
    args: ast::ExpressionList,
    handled: &var bool,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if try qualified_field_name(self.allocator, tree, field) |qualified| {
        defer qualified.deinit(self.allocator);
        let bytes = qualified.as_bytes();
        if try self.reject_unknown_builtin(bytes) |problem| {
            handled.* = true;
            return move problem;
        }
        if try self.check_fs_builtin(tree, scope, bytes, args, handled, out) |problem| {
            return move problem;
        }
        if handled.* {
            return null;
        }
        if try self.check_simple_core_builtin(tree, scope, bytes, args, handled, out) |problem| {
            return move problem;
        }
        if handled.* {
            return null;
        }
        return self.check_std_constructor_builtin(tree, bytes, args, handled, out);
    }
    handled.* = false;
    return null;
}

fn qualified_field_name(
    allocator: Allocator,
    tree: &var ast::Ast,
    field: &ast::FieldExpr
) -> !?string::String {
    if try qualified_name(allocator, tree, field.receiver) |prefix| {
        defer prefix.deinit(allocator);
        var out = string::new(allocator);
        errdefer out.deinit(allocator);
        let prefix_bytes = prefix.as_bytes();
        try out.append_bytes(allocator, prefix_bytes);
        try out.append_bytes(allocator, "::");
        let retained = tree.texts.at(field.name.node);
        let name = retained.as_bytes();
        try out.append_bytes(allocator, name);
        return move out;
    }
    return null;
}

fn (self: &Checker) reject_unknown_builtin(name: []u8) -> !?diagnostic::Diagnostic {
    if !mem::starts_with(name, "std::internal::builtin::") or
        stdprim::primitive(name) {
        return null;
    }
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` is not a primitive");
    return try self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_std_constructor_builtin(
    tree: &var ast::Ast,
    name: []u8,
    args: ast::ExpressionList,
    handled: &var bool,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if mem::equal_bytes(name, "std::internal::builtin::io_blocking") or
        mem::equal_bytes(name, "std::internal::builtin::io_failing") {
        handled.* = true;
        if args.len(tree) != 0 {
            return try self.constructor_arity_error(name, 0, args.len(tree));
        }
        out.* = try self.types.intern("Io");
        return null;
    }
    handled.* = false;
    return null;
}

fn (self: &var Checker) check_simple_core_builtin(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    args: ast::ExpressionList,
    handled: &var bool,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    let retained_signature = stdprim::simple_core_signature(name) orelse
        return null;
    handled.* = true;
    if args.len(tree) != retained_signature.args_len() {
        return try self.core_signature_arity_error(name, &retained_signature);
    }
    var index = 0;
    while retained_signature.arg_at(index) |want| {
        let argument = args.get_or_panic(tree, index);
        if try self.check_core_arg(tree, scope, name, index, want, argument) |problem| {
            return move problem;
        }
        index = index + 1;
    }
    out.* = try self.types.intern(retained_signature.return_type);
    return null;
}

fn (self: &var Checker) check_core_arg(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    index: i64,
    want: stdprim::ArgKind,
    argument: ast::Expression
) -> !?diagnostic::Diagnostic {
    if want == stdprim::ArgKind::Io {
        return self.check_io_arg(tree, scope, argument, name);
    }
    if want == stdprim::ArgKind::StringOut {
        return self.check_string_out_arg(tree, scope, name, argument);
    }
    let spelling = stdprim::arg_kind_spelling(want);
    let expected = try self.types.intern(spelling);
    var got = empty_type();
    if try self.check_contextual_expr(tree, scope, argument, expected, &var got) |problem| {
        return move problem;
    }
    if !same_type(got, expected) {
        return try self.call_arg_type_error(name, index + 1, expected, got);
    }
    return null;
}

fn (self: &Checker) core_signature_arity_error(
    name: []u8,
    signature: &stdprim::CoreSignature
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` expects ");
    if signature.args_len() == 0 {
        try message.append_bytes(self.allocator, "0 args");
    } else {
        var index = 0;
        while signature.arg_at(index) |kind| {
            if index > 0 {
                try message.append_bytes(self.allocator, " and ");
            }
            if kind == stdprim::ArgKind::Io {
                try message.append_bytes(self.allocator, "io");
            } else {
                try message.append_bytes(self.allocator, stdprim::arg_kind_spelling(kind));
            }
            index = index + 1;
        }
    }
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) constructor_arity_error(
    name: []u8,
    expected: i64,
    got: i64
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` expects ");
    try fmt::append_i64(self.allocator, &var message, expected);
    try message.append_bytes(self.allocator, " args, got ");
    try fmt::append_i64(self.allocator, &var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) call_arg_type_error(
    name: []u8,
    index: i64,
    want: Type,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` arg ");
    try fmt::append_i64(self.allocator, &var message, index);
    try message.append_bytes(self.allocator, " expects ");
    try self.append_checker_type(&var message, want);
    try message.append_bytes(self.allocator, ", got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_fs_builtin(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    args: ast::ExpressionList,
    handled: &var bool,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if mem::equal_bytes(name, "std::internal::builtin::fs_write_file") {
        handled.* = true;
        return self.check_fs_write_file(tree, scope, args, out);
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_rename") {
        handled.* = true;
        return self.check_fs_rename(tree, scope, args, out);
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_exists") {
        handled.* = true;
        if try self.check_fs_path_args(tree, scope, "std::fs::exists", args) |problem| {
            return move problem;
        }
        out.* = try self.types.intern("std::fs::Error!bool");
        return null;
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_metadata") {
        handled.* = true;
        if try self.check_fs_path_args(tree, scope, "std::fs::metadata", args) |problem| {
            return move problem;
        }
        out.* = try self.types.intern("std::fs::Error!std::fs::Metadata");
        return null;
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_read_dir") {
        handled.* = true;
        return self.check_fs_read_dir(tree, scope, args, out);
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_create_dir") or
        mem::equal_bytes(name, "std::internal::builtin::fs_remove_dir") or
        mem::equal_bytes(name, "std::internal::builtin::fs_remove_file") {
        handled.* = true;
        if try self.check_fs_path_args(tree, scope, name, args) |problem| {
            return move problem;
        }
        out.* = try self.types.intern("std::fs::Error!void");
        return null;
    }
    handled.* = false;
    return null;
}

fn (self: &var Checker) check_string_out_arg(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    label: []u8,
    argument: ast::Expression
) -> !?diagnostic::Diagnostic {
    let string_type = try self.types.intern("std::string::String");
    match borrow_prefix(tree, argument) {
        Value(prefix) => {
            let retained_operator = tree.texts.at(prefix.operator.node);
            let operator = retained_operator.as_bytes();
            let explicit_mutable = mem::equal_bytes(operator, "&var");
            if explicit_mutable {
                var got = empty_type();
                var mutable = false;
                if try self.check_borrow_prefix(
                    tree,
                    scope,
                    prefix,
                    &var got,
                    &var mutable
                ) |problem| {
                    return move problem;
                }
                if same_type(got, string_type) {
                    return null;
                }
                return try self.string_out_type_error(label, got, true);
            }
        },
        None => {},
    }
    var got = empty_type();
    if try self.check_expr(tree, scope, argument, &var got) |problem| {
        return move problem;
    }
    match tree.expressions.at(argument.node) {
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let name = retained.as_bytes();
            if same_type(got, string_type) and
                self.scopes.is_mut_borrowed(scope, name) {
                return null;
            }
        },
        _ => {},
    }
    return try self.string_out_type_error(label, got, false);
}

fn (self: &Checker) string_out_type_error(
    label: []u8,
    got: Type,
    explicit: bool
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, label);
    try message.append_bytes(self.allocator, "` expects &var std::string::String out, got ");
    if explicit {
        try message.append_bytes(self.allocator, "&var ");
    }
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_fs_write_file(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if args.len(tree) != 3 {
        return try self.checker_error_at(
            "type error",
            ast::zero_span(),
            "`std::fs::write_file` expects io, path, and bytes"
        );
    }
    let argument = args.get_or_panic(tree, 0);
    if try self.check_io_arg(tree, scope, argument, "std::fs::write_file") |problem| {
        return move problem;
    }
    var index = 1;
    while index < 3 {
        var got = empty_type();
        let next_argument = args.get_or_panic(tree, index);
        if try self.check_expr(tree, scope, next_argument, &var got) |problem| {
            return move problem;
        }
        if !self.types.is_text(got, "[]u8") {
            let label = if index == 1 {
                "path"
            } else {
                "bytes"
            };
            return try self.fs_bytes_arg_error("std::fs::write_file", label, got);
        }
        index = index + 1;
    }
    out.* = try self.types.intern("std::fs::Error!void");
    return null;
}

fn (self: &var Checker) check_fs_rename(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if args.len(tree) != 3 {
        return try self.checker_error_at(
            "type error",
            ast::zero_span(),
            "`std::fs::rename` expects io, from, and to"
        );
    }
    let argument = args.get_or_panic(tree, 0);
    if try self.check_io_arg(tree, scope, argument, "std::fs::rename") |problem| {
        return move problem;
    }
    var index = 1;
    while index < 3 {
        var got = empty_type();
        let next_argument = args.get_or_panic(tree, index);
        if try self.check_expr(tree, scope, next_argument, &var got) |problem| {
            return move problem;
        }
        if !self.types.is_text(got, "[]u8") {
            let label = if index == 1 {
                "from"
            } else {
                "to"
            };
            return try self.fs_bytes_arg_error("std::fs::rename", label, got);
        }
        index = index + 1;
    }
    out.* = try self.types.intern("std::fs::Error!void");
    return null;
}

fn (self: &Checker) fs_bytes_arg_error(
    name: []u8,
    label: []u8,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` expects []u8 ");
    try message.append_bytes(self.allocator, label);
    try message.append_bytes(self.allocator, ", got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_fs_path_args(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    name: []u8,
    args: ast::ExpressionList
) -> !?diagnostic::Diagnostic {
    if args.len(tree) != 2 {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, "` expects io and path");
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    let argument = args.get_or_panic(tree, 0);
    if try self.check_io_arg(tree, scope, argument, name) |problem| {
        return move problem;
    }
    var path = empty_type();
    let second_argument = args.get_or_panic(tree, 1);
    if try self.check_expr(tree, scope, second_argument, &var path) |problem| {
        return move problem;
    }
    if !self.types.is_text(path, "[]u8") {
        return try self.fs_bytes_arg_error(name, "path", path);
    }
    return null;
}

fn (self: &var Checker) check_fs_read_dir(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let name = "std::fs::read_dir";
    if args.len(tree) != 3 {
        return try self.checker_error_at(
            "type error",
            ast::zero_span(),
            "`std::fs::read_dir` expects io, allocator, and path"
        );
    }
    let io_arg = args.get_or_panic(tree, 0);
    if try self.check_io_arg(tree, scope, io_arg, name) |problem| {
        return move problem;
    }
    let allocator_arg = args.get_or_panic(tree, 1);
    if try self.check_core_arg(
        tree, scope, name, 1, stdprim::ArgKind::Allocator, allocator_arg
    ) |problem| {
        return move problem;
    }
    var path = empty_type();
    let path_arg = args.get_or_panic(tree, 2);
    if try self.check_expr(tree, scope, path_arg, &var path) |problem| {
        return move problem;
    }
    if !self.types.is_text(path, "[]u8") {
        return try self.fs_bytes_arg_error(name, "path", path);
    }
    out.* = try self.types.intern("std::fs::Error!std::array::Array<std::fs::DirEntry>");
    return null;
}

fn (self: &var Checker) check_io_arg(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    argument: ast::Expression,
    name: []u8
) -> !?diagnostic::Diagnostic {
    var got = empty_type();
    if try self.check_expr(tree, scope, argument, &var got) |problem| {
        return move problem;
    }
    if !self.types.is_text(got, "Io") {
        var message = string::new(self.allocator);
        errdefer message.deinit(self.allocator);
        try message.append_byte(self.allocator, cast<u8>(96));
        try message.append_bytes(self.allocator, name);
        try message.append_bytes(self.allocator, "` expects Io, got ");
        try self.append_checker_type(&var message, got);
        return try self.checker_message_at("type error", ast::zero_span(), move message);
    }
    return null;
}

fn (self: &var Checker) check_print_call(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    args: ast::ExpressionList,
    span: ast::Span,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if args.len(tree) != 1 {
        return try self.named_arity_error("print", 1, args.len(tree));
    }
    var got = empty_type();
    let argument = args.get_or_panic(tree, 0);
    if try self.check_expr(tree, scope, argument, &var got) |problem| {
        return move problem;
    }
    if self.types.is_text(got, "void") {
        return try self.checker_error_at(
            "type error", ast::zero_span(), "`print` cannot print void"
        );
    }
    return self.check_print_instance(tree, got, span, out);
}

/// Names the std generic every `print(value)` is a call to, the Go
/// `stdlib.PrintFunction` (SPEC §14.1).
fn print_function_name() -> []u8 {
    return "std::fmt::print";
}

// Checks the std body `print` stands for with the argument's type bound
// (SPEC §14.1), the Go `checkPrintInstance`. The body is the one place that
// says which types print, so a type it has no case for is refused there, at
// this call.
fn (self: &var Checker) check_print_instance(
    tree: &var ast::Ast,
    argument: Type,
    span: ast::Span,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let name = print_function_name();
    let handle = self.metadata.functions_by_name.get(name) orelse
        return try self.print_not_loaded_error();
    if self.function_static_param_count(handle) != 1 {
        return try self.print_not_loaded_error();
    }
    let parameter = try self.copy_static_param(handle, 0) orelse
        return try self.print_not_loaded_error();
    let parameter_name = move parameter.name;
    defer parameter_name.deinit(self.allocator);
    var substitutions = map::new<[]u8, Type>(self.allocator);
    defer substitutions.deinit(self.allocator);
    let parameter_bytes = parameter_name.as_bytes();
    try substitutions.insert(self.allocator, parameter_bytes, argument);
    var fields = map::new<[]u8, MetaFieldHandle>(self.allocator);
    defer fields.deinit(self.allocator);
    var functions = map::new<[]u8, string::String>(self.allocator);
    defer functions.deinit(self.allocator);
    var type_args = array::new<Type>(self.allocator);
    defer type_args.deinit(self.allocator);
    try type_args.append(self.allocator, argument);
    if try self.check_generic_instantiation(tree, handle, &substitutions, &fields, &functions) |problem| {
        return try self.annotate_instantiation(move problem, span, name, &type_args);
    }
    out.* = try self.types.void_type();
    return null;
}

fn (self: &Checker) print_not_loaded_error() -> !diagnostic::Diagnostic {
    return self.checker_error_at("type error", ast::zero_span(), "`std::fmt::print` is not loaded");
}

fn (self: &Checker) named_arity_error(
    name: []u8,
    expected: i64,
    got: i64
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` expects ");
    try fmt::append_i64(self.allocator, &var message, expected);
    try message.append_bytes(self.allocator, " arg");
    if expected != 1 {
        try message.append_byte(self.allocator, cast<u8>(115));
    }
    try message.append_bytes(self.allocator, ", got ");
    try fmt::append_i64(self.allocator, &var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_ptr_read(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    span: ast::Span,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    return self.check_pointer_read(
        tree,
        scope,
        span,
        args,
        UnsafeCapability::PtrRead,
        "ptr_read",
        out
    );
}

fn (self: &var Checker) check_volatile_read(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    span: ast::Span,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    return self.check_pointer_read(
        tree,
        scope,
        span,
        args,
        UnsafeCapability::Volatile,
        "volatile_read",
        out
    );
}

fn (self: &var Checker) check_pointer_read(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    span: ast::Span,
    args: ast::ExpressionList,
    capability: UnsafeCapability,
    name: []u8,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let operation = try quoted_name(self.allocator, name);
    defer operation.deinit(self.allocator);
    let operation_bytes = operation.as_bytes();
    if try self.require_unsafe_capability_at(capability, operation_bytes, span) |problem| {
        return move problem;
    }
    if args.len(tree) != 1 {
        return try self.named_arity_error(name, 1, args.len(tree));
    }
    var pointer_type = empty_type();
    let argument = args.get_or_panic(tree, 0);
    if try self.check_expr(tree, scope, argument, &var pointer_type) |problem| {
        return move problem;
    }
    match try self.types.raw_pointer_deref_type(pointer_type) {
        Value(value) => {
            out.* = value;
            return null;
        },
        Error(_) => return try self.pointer_read_type_error(name, pointer_type),
    }
}

fn (self: &var Checker) check_ptr_write(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    span: ast::Span,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    return self.check_pointer_write(
        tree,
        scope,
        span,
        args,
        UnsafeCapability::PtrWrite,
        "ptr_write",
        out
    );
}

fn (self: &var Checker) check_volatile_write(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    span: ast::Span,
    args: ast::ExpressionList,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    return self.check_pointer_write(
        tree,
        scope,
        span,
        args,
        UnsafeCapability::Volatile,
        "volatile_write",
        out
    );
}

fn (self: &var Checker) check_pointer_write(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    span: ast::Span,
    args: ast::ExpressionList,
    capability: UnsafeCapability,
    name: []u8,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let operation = try quoted_name(self.allocator, name);
    defer operation.deinit(self.allocator);
    let operation_bytes = operation.as_bytes();
    if try self.require_unsafe_capability_at(capability, operation_bytes, span) |problem| {
        return move problem;
    }
    if args.len(tree) != 2 {
        return try self.named_arity_error(name, 2, args.len(tree));
    }
    var pointer_type = empty_type();
    let argument = args.get_or_panic(tree, 0);
    if try self.check_expr(tree, scope, argument, &var pointer_type) |problem| {
        return move problem;
    }
    var element = empty_type();
    match try self.types.assignable_raw_pointer_deref_type(pointer_type) {
        Value(value) => {
            element = value;
        },
        Error(_) => return try self.pointer_write_type_error(name),
    }
    var value_type = empty_type();
    let second_argument = args.get_or_panic(tree, 1);
    if try self.check_contextual_expr(
        tree,
        scope,
        second_argument,
        element,
        &var value_type
    ) |problem| {
        return move problem;
    }
    if !same_type(value_type, element) {
        return try self.pointer_write_value_error(name, element, value_type);
    }
    out.* = try self.types.void_type();
    return null;
}

fn quoted_name(allocator: Allocator, name: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_byte(allocator, cast<u8>(96));
    try out.append_bytes(allocator, name);
    try out.append_byte(allocator, cast<u8>(96));
    return move out;
}

fn (self: &Checker) pointer_read_type_error(name: []u8, got: Type) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` expects non-null raw pointer, got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) pointer_write_type_error(name: []u8) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` expects mutable non-null raw pointer");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) pointer_write_value_error(
    name: []u8,
    want: Type,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try message.append_bytes(self.allocator, name);
    try message.append_bytes(self.allocator, "` expects ");
    try self.append_checker_type(&var message, want);
    try message.append_bytes(self.allocator, ", got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}
