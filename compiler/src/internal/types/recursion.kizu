import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::typ;
import std::array;
import std::map;
import std::mem;
import std::string;

// Mechanical port of internal/types/recursion.go.

/// Refuses a struct or union that holds itself by value, directly or through
/// other structs and unions, the Go `checkInlineRecursion`: its size would
/// have no end. A value held through `std::mem::Box<T>`, an Array, a view, or
/// a pointer is behind a fixed-size handle and ends the chain; a stack buffer,
/// an optional, and an error union hold their element inline and continue it.
///
/// One pass over the by-value graph finds which types sit on a cycle; only
/// the first such declaration walks again to spell the path it reports.
fn (self: &Checker) check_inline_recursion(
    tree: &ast::Ast,
    program: &ast::Program
) -> !?diagnostic::Diagnostic {
    var declared = map::new<[]u8, ast::Declaration>(self.allocator);
    defer declared.deinit(self.allocator);
    var cycles = InlineCycles {
        numbers: map::new<[]u8, i64>(self.allocator),
        declarations: array::new<ast::Declaration>(self.allocator),
        index: array::new<i64>(self.allocator),
        low: array::new<i64>(self.allocator),
        on_stack: array::new<bool>(self.allocator),
        cyclic: array::new<bool>(self.allocator),
        stack: array::new<i64>(self.allocator),
        next: 0,
    };
    defer cycles.deinit(self.allocator);
    var index = 0;
    while program.declarations.get(index) |declaration| {
        index = index + 1;
        if inline_type_decl_name(tree, declaration) |name| {
            let retained = tree.texts.at(name.node);
            let bytes = retained.as_bytes();
            try declared.insert(self.allocator, bytes, declaration);
            if cycles.numbers.get(bytes) |number| {
                try cycles.declarations.set(number, declaration);
            } else {
                try cycles.numbers.insert(self.allocator, bytes, cycles.declarations.len());
                try cycles.declarations.append(self.allocator, declaration);
                try cycles.index.append(self.allocator, -1);
                try cycles.low.append(self.allocator, 0);
                try cycles.on_stack.append(self.allocator, false);
                try cycles.cyclic.append(self.allocator, false);
            }
        }
    }
    var node = 0;
    while node < cycles.declarations.len() {
        if cycles.index.get_or_panic(node) < 0 {
            try inline_visit(self.allocator, tree, &var cycles, node);
        }
        node = node + 1;
    }
    index = 0;
    while program.declarations.get(index) |declaration| {
        index = index + 1;
        let name = inline_type_decl_name(tree, declaration) orelse continue;
        let retained = tree.texts.at(name.node);
        let target = retained.as_bytes();
        let number = cycles.numbers.get(target) orelse continue;
        if !cycles.cyclic.get_or_panic(number) {
            continue;
        }
        var seen = map::new<[]u8, bool>(self.allocator);
        defer seen.deinit(self.allocator);
        var path = array::new<string::String>(self.allocator);
        defer path.deinit(self.allocator);
        if try inline_path_to(self.allocator, tree, &declared, target, target, &var seen, &var path) {
            var message = try string::from_bytes(self.allocator, "`");
            errdefer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, target);
            try message.append_bytes(self.allocator, "` holds itself by value (");
            let joined = try string::join(self.allocator, &path, ", then ");
            defer joined.deinit(self.allocator);
            try message.append_string(self.allocator, &joined);
            try message.append_bytes(self.allocator, "), so its size has no end");
            var help = try string::from_bytes(self.allocator, "hold the inner `");
            defer help.deinit(self.allocator);
            try help.append_bytes(self.allocator, target);
            try help.append_bytes(self.allocator, "` through `std::mem::Box<");
            try help.append_bytes(self.allocator, target);
            try help.append_bytes(self.allocator, ">` or an arena handle");
            var problem = try self.checker_message_at("type error", tree.declaration_span(declaration), move message);
            errdefer problem.deinit(self.allocator);
            let help_bytes = help.as_bytes();
            try problem.with_help(self.allocator, help_bytes);
            return move problem;
        }
    }
    return null;
}

/// Is Tarjan's strongly connected components over the by-value graph, the Go
/// `inlineCycles`: nodes are the program's non-generic structs and unions in
/// declaration order, and a type is cyclic when its component has more than
/// one member or it holds itself directly.
struct InlineCycles {
    numbers: map::Map<[]u8, i64>,
    declarations: array::Array<ast::Declaration>,
    index: array::Array<i64>,
    low: array::Array<i64>,
    on_stack: array::Array<bool>,
    cyclic: array::Array<bool>,
    stack: array::Array<i64>,
    next: i64,
}

fn (self: InlineCycles) deinit(allocator: Allocator) -> void {
    self.numbers.deinit(allocator);
    self.declarations.deinit(allocator);
    self.index.deinit(allocator);
    self.low.deinit(allocator);
    self.on_stack.deinit(allocator);
    self.cyclic.deinit(allocator);
    self.stack.deinit(allocator);
    return;
}

/// Numbers `node` and everything it reaches by value, closing each
/// component as its root finishes, the Go `inlineCycles.visit`.
fn inline_visit(
    allocator: Allocator,
    tree: &ast::Ast,
    cycles: &var InlineCycles,
    node: i64
) -> !void {
    try cycles.index.set(node, cycles.next);
    try cycles.low.set(node, cycles.next);
    cycles.next = cycles.next + 1;
    try cycles.stack.append(allocator, node);
    try cycles.on_stack.set(node, true);
    var self_loop = false;
    var parts = try inline_parts(allocator, tree, cycles.declarations.get_or_panic(node));
    defer parts.deinit(allocator);
    var index = 0;
    while parts.at(index) |part| {
        index = index + 1;
        let text = part.type_text.as_bytes();
        let found = inline_type_name(text, 0) orelse continue;
        let inner = cycles.numbers.get(text[found.start..found.end]) orelse continue;
        if inner == node {
            self_loop = true;
        }
        if cycles.index.get_or_panic(inner) < 0 {
            try inline_visit(allocator, tree, cycles, inner);
            let reached = cycles.low.get_or_panic(inner);
            if reached < cycles.low.get_or_panic(node) {
                try cycles.low.set(node, reached);
            }
        } else if cycles.on_stack.get_or_panic(inner) {
            let reached = cycles.index.get_or_panic(inner);
            if reached < cycles.low.get_or_panic(node) {
                try cycles.low.set(node, reached);
            }
        }
    }
    if cycles.low.get_or_panic(node) != cycles.index.get_or_panic(node) {
        return;
    }
    var start = cycles.stack.len() - 1;
    while cycles.stack.get_or_panic(start) != node {
        start = start - 1;
    }
    let cyclic = self_loop or cycles.stack.len() - start > 1;
    while cycles.stack.pop() |member| {
        try cycles.on_stack.set(member, false);
        if cyclic {
            try cycles.cyclic.set(member, true);
        }
        if member == node {
            break;
        }
    }
    return;
}

/// Returns the name of a non-generic struct or union a declaration declares.
fn inline_type_decl_name(tree: &ast::Ast, declaration: ast::Declaration) -> ?ast::Text {
    match tree.declarations.at(declaration.node) {
        Struct(value) => {
            if value.type_params.len() == 0 {
                return value.name;
            }
            return null;
        },
        Union(value) => {
            if value.type_params.len() == 0 {
                return value.name;
            }
            return null;
        },
        _ => return null,
    }
}

/// Appends to `path` the fields and payloads that lead from `from` to
/// `target` by value and answers true, or answers false when none does, the
/// Go `inlinePathTo`. `seen` stops a chain that loops without reaching target.
fn inline_path_to(
    allocator: Allocator,
    tree: &ast::Ast,
    declared: &map::Map<[]u8, ast::Declaration>,
    from: []u8,
    target: []u8,
    seen: &var map::Map<[]u8, bool>,
    path: &var array::Array<string::String>
) -> !bool {
    if seen.contains(from) {
        return false;
    }
    try seen.insert(allocator, from, true);
    let declaration = declared.get(from) orelse return false;
    var parts = try inline_parts(allocator, tree, declaration);
    defer parts.deinit(allocator);
    var index = 0;
    while parts.at(index) |part| {
        index = index + 1;
        let text = part.type_text.as_bytes();
        let found = inline_type_name(text, 0) orelse continue;
        let inner = text[found.start..found.end];
        try path.append(allocator, try inline_step(allocator, tree, part));
        if mem::equal_bytes(inner, target) {
            return true;
        }
        if declared_name(tree, declared, inner) |retained| {
            if try inline_path_to(allocator, tree, declared, retained, target, seen, path) {
                return true;
            }
        }
        if path.pop() |dropped| {
            dropped.deinit(allocator);
        }
    }
    return false;
}

/// Spells a part as one link of the reported path, the Go `inlinePart.step`.
fn inline_step(allocator: Allocator, tree: &ast::Ast, part: &InlinePart) -> !string::String {
    let owner = tree.texts.at(part.owner.node);
    let member = tree.texts.at(part.member.node);
    var step = string::new(allocator);
    errdefer step.deinit(allocator);
    if part.payload {
        try step.append_bytes(allocator, "payload `");
        try step.append_string(allocator, owner);
        try step.append_bytes(allocator, "::");
    } else {
        try step.append_bytes(allocator, "field `");
        try step.append_string(allocator, owner);
        try step.append_bytes(allocator, ".");
    }
    try step.append_string(allocator, member);
    try step.append_bytes(allocator, "`: ");
    try step.append_string(allocator, &part.type_text);
    return move step;
}

/// Returns the declared type name with the tree's lifetime, so the walk does
/// not hold a borrow of a part's text across the recursive call.
fn declared_name(
    tree: &ast::Ast,
    declared: &map::Map<[]u8, ast::Declaration>,
    name: []u8
) -> ?[]u8 {
    let declaration = declared.get(name) orelse return null;
    let text = inline_type_decl_name(tree, declaration) orelse return null;
    let retained = tree.texts.at(text.node);
    let bytes = retained.as_bytes();
    return bytes;
}

/// Is one field of a struct or payload of a union variant, the Go
/// `inlinePart`.
struct InlinePart {
    owner: ast::Text,
    member: ast::Text,
    payload: bool,
    type_text: string::String,
}

fn (self: InlinePart) deinit(allocator: Allocator) -> void {
    self.type_text.deinit(allocator);
    return;
}

/// Lists what a struct or union stores, in declaration order, the Go
/// `inlineParts`.
fn inline_parts(
    allocator: Allocator,
    tree: &ast::Ast,
    declaration: ast::Declaration
) -> !array::Array<InlinePart> {
    var parts = array::new<InlinePart>(allocator);
    errdefer parts.deinit(allocator);
    match tree.declarations.at(declaration.node) {
        Struct(value) => {
            var index = 0;
            while value.fields.at(index) |field| {
                index = index + 1;
                let type_text = try typ::render(allocator, &tree.types, field.type_name);
                try parts.append(allocator, InlinePart { owner: value.name, member: field.name, payload: false, type_text: move type_text });
            }
        },
        Union(value) => {
            var index = 0;
            while value.variants.at(index) |variant| {
                index = index + 1;
                let payload = variant.payload orelse continue;
                let type_text = try typ::render(allocator, &tree.types, payload);
                try parts.append(allocator, InlinePart { owner: value.name, member: variant.name, payload: true, type_text: move type_text });
            }
        },
        _ => {},
    }
    return move parts;
}

/// Where the declared type name a field type stores by value sits in its
/// spelling.
struct InlineName {
    start: i64,
    end: i64,
}

/// Returns where the declared type a field type stores by value is named, if
/// any, the Go `inlineTypeName`: through stack buffers, optionals, and error
/// unions, but not through a view, borrow, function, or generic application
/// such as Box or Array.
fn inline_type_name(text: []u8, start: i64) -> ?InlineName {
    let length = mem::len(text);
    let rest = text[start..length];
    if typ::optional_elem(rest) |_| {
        return inline_type_name(text, start + 1);
    }
    if typ::error_union_success(rest) |success| {
        return inline_type_name(text, length - mem::len(success));
    }
    let size = length - start;
    if size > 1 and rest[0] == cast<u8>(91) and rest[1] != cast<u8>(93) {
        var index = 1;
        while index < size {
            if rest[index] == cast<u8>(93) {
                return inline_type_name(text, start + index + 1);
            }
            index = index + 1;
        }
        return null;
    }
    if size == 0 or rest[0] == cast<u8>(91) or rest[0] == cast<u8>(38) or rest[0] == cast<u8>(63) {
        return null;
    }
    if typ::is_func_spelling(rest) {
        return null;
    }
    var index = 0;
    while index < size {
        if rest[index] == cast<u8>(60) {
            return null;
        }
        index = index + 1;
    }
    return InlineName { start: start, end: length };
}
