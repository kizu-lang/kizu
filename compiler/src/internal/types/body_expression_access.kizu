import compiler::internal::ast;
import compiler::internal::diagnostic;
import std::array;
import std::mem;
import std::sort;
import std::string;

fn (self: &var Checker) check_struct_literal_expr_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    out: &var Type
) -> !bool {
    match tree.expressions.at(expression.node) {
        StructLiteral(literal) => {
            let type_name = literal.type_name;
            let span = literal.span;
            let field_count = literal.fields.len();
            return self.check_struct_literal_parts_ok(
                tree,
                scope,
                expression,
                type_name,
                span,
                field_count,
                out
            );
        },
        _ => {
            let problem = try self.checker_error_at(
                "type error", expression_span(tree, expression),
                "expected struct literal"
            );
            return self.fail(move problem);
        },
    }
}

fn (self: &Checker) find_struct_field_index(
    tree: &ast::Ast,
    struct_idx: i64,
    field_name: []u8
) -> i64 {
    if self.metadata.struct_infos.at(struct_idx) |info| {
        var index = 0;
        while info.fields.at(index) |field| {
            if mem::equal_bytes(semantic_text(tree, field.name), field_name) {
                return index;
            }
            index = index + 1;
        }
    }
    return -1;
}

fn (self: &var Checker) pop_struct_literal_slots(base: i64) -> void {
    while self.struct_literal_slots.len() > base {
        let _ = self.struct_literal_slots.pop_or_panic();
    }
    return;
}

fn (self: &Checker) lookup_struct_info_text(tree: &ast::Ast, name_handle: ast::Text) -> ?i64 {
    return self.metadata.struct_infos_by_name.get(semantic_text(tree, name_handle));
}

fn (self: &Checker) find_struct_field_index_text(
    tree: &ast::Ast,
    struct_idx: i64,
    field_name_handle: ast::Text
) -> i64 {
    return self.find_struct_field_index(tree, struct_idx, semantic_text(tree, field_name_handle));
}

fn (self: &Checker) has_duplicate_unknown_field(
    tree: &ast::Ast,
    expression: ast::Expression,
    written_index: i64,
    field_name_handle: ast::Text
) -> bool {
    let field_name = semantic_text(tree, field_name_handle);
    var prior = 0;
    while prior < written_index {
        match tree.expressions.at(expression.node) {
            StructLiteral(literal) => {
                if literal.fields.at(prior) |prev_field| {
                    if mem::equal_bytes(semantic_text(tree, prev_field.name), field_name) {
                        return true;
                    }
                }
            },
            _ => {},
        }
        prior = prior + 1;
    }
    return false;
}

fn (self: &var Checker) check_struct_literal_parts_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    type_name_handle: ast::Text,
    span: ast::Span,
    field_count: i64,
    out: &var Type
) -> !bool {
    var struct_idx = -1;
    if self.lookup_struct_info_text(tree, type_name_handle) |found| {
        struct_idx = found;
    } else {
        let problem = try self.unknown_struct_error(semantic_text(tree, type_name_handle));
        return self.fail(move problem);
    }
    var maybe_decl: ?ast::Declaration = null;
    var declared_count = 0;
    var requires_unsafe = false;
    var is_extern = false;
    var is_std = false;
    var module_id = -1;
    if self.metadata.struct_infos.at(struct_idx) |info| {
        maybe_decl = info.declaration;
        declared_count = info.fields.len();
        requires_unsafe = info.requires_unsafe;
        is_extern = info.is_extern;
        is_std = info.is_std;
        module_id = info.module_id;
    }
    if maybe_decl |_| {} else {
        let problem = try self.unknown_struct_error(semantic_text(tree, type_name_handle));
        return self.fail(move problem);
    }
    let decl_handle = maybe_decl orelse return true;
    if requires_unsafe {
        match tree.declarations.at(decl_handle.node) {
            Struct(declaration) => {
                if try self.require_unsafe_struct_invariant(
                    declaration,
                    semantic_text(tree, type_name_handle),
                    "construction of",
                    "",
                    span
                ) |problem| {
                    return self.fail(move problem);
                }
            },
            _ => {
                let problem = try self.unknown_struct_error(semantic_text(tree, type_name_handle));
                return self.fail(move problem);
            },
        }
    }
    let slot_base = self.struct_literal_slots.len();
    var init_index = 0;
    while init_index < declared_count {
        try self.struct_literal_slots.append(self.allocator, StructLiteralSlot {
            present: false,
            expression: expression,
            typ: empty_type()
        });
        init_index = init_index + 1;
    }
    var unknown_written_index = -1;
    var written_index = 0;
    while written_index < field_count {
        var field_name_handle = type_name_handle;
        var field_value_expr = expression;
        match tree.expressions.at(expression.node) {
            StructLiteral(literal) => {
                if literal.fields.at(written_index) |field| {
                    field_name_handle = field.name;
                    field_value_expr = field.value;
                } else {
                    self.pop_struct_literal_slots(slot_base);
                    let problem = try self.checker_error_at(
                        "type error", expression_span(tree, expression),
                        "invalid struct literal field"
                    );
                    return self.fail(move problem);
                }
            },
            _ => {
                self.pop_struct_literal_slots(slot_base);
                let problem = try self.checker_error_at(
                    "type error", expression_span(tree, expression),
                    "invalid struct literal field"
                );
                return self.fail(move problem);
            },
        }
        let declared_idx = self.find_struct_field_index_text(tree, struct_idx, field_name_handle);
        if declared_idx >= 0 {
            var already_present = false;
            if self.struct_literal_slots.at(slot_base + declared_idx) |slot| {
                already_present = slot.present;
            }
            if already_present {
                let type_bytes = semantic_text(tree, type_name_handle);
                let field_bytes = semantic_text(tree, field_name_handle);
                self.pop_struct_literal_slots(slot_base);
                let problem = try self.struct_member_error("duplicate field", type_bytes, field_bytes);
                return self.fail(move problem);
            }
        } else {
            if self.has_duplicate_unknown_field(tree, expression, written_index, field_name_handle) {
                let type_bytes = semantic_text(tree, type_name_handle);
                let field_bytes = semantic_text(tree, field_name_handle);
                self.pop_struct_literal_slots(slot_base);
                let problem = try self.struct_member_error("duplicate field", type_bytes, field_bytes);
                return self.fail(move problem);
            }
            if unknown_written_index < 0 {
                unknown_written_index = written_index;
            }
        }
        if self.editor.len() > 0 {
            try self.record_literal_field(tree, decl_handle, field_name_handle, semantic_text(tree, field_name_handle));
        }
        var got = empty_type();
        if expression_is_null(tree, field_value_expr) {
            let copied_field = ast::FieldValue { name: field_name_handle, value: field_value_expr };
            let owned_type_name = try string::from_bytes(self.allocator, semantic_text(tree, type_name_handle));
            defer owned_type_name.deinit(self.allocator);
            let owned_type_bytes = owned_type_name.as_bytes();
            if try self.check_struct_literal_field_value(
                tree,
                scope,
                decl_handle,
                owned_type_bytes,
                &copied_field,
                &var got
            ) |problem| {
                self.pop_struct_literal_slots(slot_base);
                return self.fail(move problem);
            }
        } else {
            if try self.check_expr_ok(tree, scope, field_value_expr, &var got) {
                self.pop_struct_literal_slots(slot_base);
                return true;
            }
        }
        if declared_idx >= 0 {
            if self.struct_literal_slots.at_mut(slot_base + declared_idx) |slot| {
                slot.present = true;
                slot.expression = field_value_expr;
                slot.typ = got;
            }
        }
        written_index = written_index + 1;
    }
    let current_module = self.current_module_id();
    let in_std = self.checking_std_body();
    var has_subst = false;
    if self.type_args.current |_| {
        has_subst = true;
    }
    if self.meta_bindings.current |_| {
        has_subst = true;
    }
    var field_index = 0;
    while field_index < declared_count {
        var slot_present = false;
        var slot_expr = expression;
        var slot_typ = empty_type();
        if self.struct_literal_slots.at(slot_base + field_index) |slot| {
            slot_present = slot.present;
            slot_expr = slot.expression;
            slot_typ = slot.typ;
        }
        var field_name_handle = type_name_handle;
        var field_public = false;
        var cached_type = empty_type();
        if self.metadata.struct_infos.at(struct_idx) |info| {
            if info.fields.at(field_index) |field| {
                field_name_handle = field.name;
                field_public = field.public;
                cached_type = field.resolved_type;
            }
        }
        if !slot_present {
            let type_bytes = semantic_text(tree, type_name_handle);
            let field_bytes = semantic_text(tree, field_name_handle);
            self.pop_struct_literal_slots(slot_base);
            let problem = try self.struct_member_error("missing field", type_bytes, field_bytes);
            return self.fail(move problem);
        }
        let accessible = field_public or is_extern or
            (is_std and in_std) or
            (!is_std and (module_id < 0 or module_id == current_module));
        if !accessible {
            let type_bytes = semantic_text(tree, type_name_handle);
            let field_bytes = semantic_text(tree, field_name_handle);
            self.pop_struct_literal_slots(slot_base);
            let problem = try self.private_field_error(type_bytes, field_bytes);
            return self.fail(move problem);
        }
        var want = cached_type;
        var need_resolve = has_subst;
        if want.node |_| {} else {
            need_resolve = true;
        }
        if need_resolve {
            match tree.declarations.at(decl_handle.node) {
                Struct(declaration) => {
                    if declaration.fields.at(field_index) |field| {
                        match try self.resolve_instance_field_type(tree, field) {
                            Value(value) => {
                                want = value;
                            },
                            Issue(issue) => {
                                self.pop_struct_literal_slots(slot_base);
                                let problem = try self.type_resolution_diagnostic(issue);
                                return self.fail(move problem);
                            },
                        }
                    }
                },
                _ => {},
            }
        }
        if !same_type(slot_typ, want) {
            var got = empty_type();
            if try self.coerce_contextual_literal(
                tree,
                slot_expr,
                want,
                slot_typ,
                &var got
            ) |problem| {
                self.pop_struct_literal_slots(slot_base);
                return self.fail(move problem);
            }
            var matches = false;
            if try self.struct_literal_field_matches(
                tree,
                scope,
                slot_expr,
                want,
                got,
                &var matches
            ) |problem| {
                self.pop_struct_literal_slots(slot_base);
                return self.fail(move problem);
            }
            if !matches {
                let type_bytes = semantic_text(tree, type_name_handle);
                let field_bytes = semantic_text(tree, field_name_handle);
                self.pop_struct_literal_slots(slot_base);
                let problem = try self.struct_field_type_error(type_bytes, field_bytes, want, got);
                return self.fail(move problem);
            }
        }
        field_index = field_index + 1;
    }
    self.pop_struct_literal_slots(slot_base);
    if unknown_written_index >= 0 {
        match tree.expressions.at(expression.node) {
            StructLiteral(literal) => {
                if literal.fields.at(unknown_written_index) |unknown_field| {
                    let type_bytes = semantic_text(tree, type_name_handle);
                    let field_bytes = semantic_text(tree, unknown_field.name);
                    let problem = try self.struct_member_error("unknown field", type_bytes, field_bytes);
                    return self.fail(move problem);
                }
            },
            _ => {},
        }
    }
    let final_type_name = semantic_text(tree, type_name_handle);
    out.* = try self.types.intern(final_type_name);
    return false;
}

fn (self: &Checker) private_field_error(
    type_name: []u8,
    field_name: []u8
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "field `");
    try message.append_bytes(self.allocator, type_name);
    try message.append_byte(self.allocator, cast<u8>(46));
    try message.append_bytes(self.allocator, field_name);
    try message.append_bytes(self.allocator, "` is private");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) unknown_struct_error(name: []u8) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "unknown struct `");
    try message.append_bytes(self.allocator, name);
    try message.append_byte(self.allocator, cast<u8>(96));
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) struct_member_error(
    kind: []u8,
    type_name: []u8,
    field_name: []u8
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, kind);
    try message.append_bytes(self.allocator, " `");
    try message.append_bytes(self.allocator, type_name);
    try message.append_byte(self.allocator, cast<u8>(46));
    try message.append_bytes(self.allocator, field_name);
    try message.append_byte(self.allocator, cast<u8>(96));
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) resolve_instance_field_type(
    tree: &ast::Ast,
    field: &ast::Field
) -> !TypeResolution {
    let declared = try self.types.remember(&tree.types, field.type_name);
    let wrapped = try self.types.borrow_wrapped_type(field.borrow, field.mut_borrow, declared);
    let substituted = try self.type_args.substitute(&var self.types, wrapped);
    return self.resolve_retained_type(tree, substituted);
}

fn (self: &var Checker) check_struct_literal_field_value(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    declaration_handle: ast::Declaration,
    type_name: []u8,
    field: &ast::FieldValue,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if !expression_is_null(tree, field.value) {
        return self.check_expr(tree, scope, field.value, out);
    }
    let retained_name = tree.texts.at(field.name.node);
    let field_name = retained_name.as_bytes();
    match tree.declarations.at(declaration_handle.node) {
        Struct(declaration) => {
            var index = 0;
            while declaration.fields.at(index) |declared| {
                let retained_declared_name = tree.texts.at(declared.name.node);
                let declared_name = retained_declared_name.as_bytes();
                if mem::equal_bytes(declared_name, field_name) {
                    var want = empty_type();
                    match try self.resolve_instance_field_type(tree, declared) {
                        Value(value) => {
                            want = value;
                        },
                        Issue(issue) => return try self.type_resolution_diagnostic(issue),
                    }
                    if try self.types.takes_null(want) {
                        out.* = want;
                        return null;
                    }
                    return try self.struct_null_field_error(type_name, field_name, want);
                }
                index = index + 1;
            }
        },
        _ => return try self.unknown_struct_error(type_name),
    }
    return try self.struct_member_error("unknown field", type_name, field_name);
}

fn expression_is_null(tree: &ast::Ast, expression: ast::Expression) -> bool {
    return match tree.expressions.at(expression.node) {
        Null(_) => true,
        _ => false,
    };
}

fn (self: &var Checker) struct_literal_field_matches(
    tree: &ast::Ast,
    scope: ScopeHandle,
    expression: ast::Expression,
    want: Type,
    got: Type,
    out: &var bool
) -> !?diagnostic::Diagnostic {
    if same_type(got, want) or self.types.fills_nullable_pointer(want, got) {
        out.* = true;
        return null;
    }
    if try self.types.optional_elem(want) |_| {
        if try self.wraps_into_optional(tree, expression, want, got, out) |problem| {
            return move problem;
        }
        if out.* {
            return null;
        }
    }
    out.* = try self.return_value_matches_borrow_param(tree, scope, expression, want, got);
    return null;
}

fn (self: &Checker) struct_null_field_error(
    type_name: []u8,
    field_name: []u8,
    want: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "field `");
    try message.append_bytes(self.allocator, type_name);
    try message.append_byte(self.allocator, cast<u8>(46));
    try message.append_bytes(self.allocator, field_name);
    try message.append_bytes(self.allocator, "` expects ");
    try self.append_checker_type(&var message, want);
    try message.append_bytes(self.allocator, ", got null");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) struct_field_type_error(
    type_name: []u8,
    field_name: []u8,
    want: Type,
    got: Type
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "field `");
    try message.append_bytes(self.allocator, type_name);
    try message.append_byte(self.allocator, cast<u8>(46));
    try message.append_bytes(self.allocator, field_name);
    try message.append_bytes(self.allocator, "` expects ");
    try self.append_checker_type(&var message, want);
    try message.append_bytes(self.allocator, ", got ");
    try self.append_checker_type(&var message, got);
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_namespace_receiver_dot_error(
    tree: &ast::Ast,
    expression: &ast::FieldExpr
) -> !bool {
    if self.metadata.namespaces.len() == 0 {
        return false;
    }
    match tree.expressions.at(expression.receiver.node) {
        Ident(identifier) => {
            let name = semantic_text(tree, identifier.name);
            if self.metadata.namespaces.get(name) |entry| {
                let member = semantic_text(tree, expression.name);
                match entry {
                    Enum(handle) => {
                        if self.metadata.enums.at(handle.index) |tagged| {
                            let enum_name = semantic_text(tree, tagged.name);
                            let problem = try self.namespace_separator_error(
                                "enum tag", enum_name, member
                            );
                            return self.fail(move problem);
                        }
                    },
                    ErrorSet(handle) => {
                        if self.metadata.error_sets.at(handle.index) |set| {
                            let set_name = semantic_text(tree, set.name);
                            let problem = try self.namespace_separator_error(
                                "error", set_name, member
                            );
                            return self.fail(move problem);
                        }
                    },
                    Union(handle) => {
                        if self.metadata.unions.at(handle.index) |tagged| {
                            let union_name = tagged.name.as_bytes();
                            let problem = try self.namespace_separator_error(
                                "union variant", union_name, member
                            );
                            return self.fail(move problem);
                        }
                    },
                }
            }
            return false;
        },
        Field(recv_field) => {
            if !recv_field.namespace {
                return false;
            }
            if try self.error_set_receiver(tree, expression.receiver) |handle| {
                if self.metadata.error_sets.at(handle.index) |set| {
                    let name = semantic_text(tree, set.name);
                    let member = semantic_text(tree, expression.name);
                    let problem = try self.namespace_separator_error("error", name, member);
                    return self.fail(move problem);
                }
            }
            return false;
        },
        _ => return false,
    }
}

fn (self: &var Checker) resolve_field_expr_ok(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::FieldExpr,
    write: bool,
    out: &var Type
) -> !bool {
    if expression.namespace {
        if try self.check_namespace_expr(tree, expression, out) |problem| {
            return self.fail(move problem);
        }
        return false;
    }
    if try self.check_namespace_receiver_dot_error(tree, expression) {
        return true;
    }
    var receiver = empty_type();
    if try self.check_expr_ok(tree, scope, expression.receiver, &var receiver) {
        return true;
    }
    receiver = try self.types.borrowed_value_type(receiver);
    let struct_idx = try self.struct_index_for_type(receiver);
    let field_name = semantic_text(tree, expression.name);
    if struct_idx < 0 {
        if self.types.is_text(receiver, "std::fs::Metadata") {
            if try self.check_fs_metadata_field(field_name, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        }
        if self.types.is_text(receiver, "std::fs::DirEntry") {
            if try self.check_fs_dir_entry_field(field_name, out) |problem| {
                return self.fail(move problem);
            }
            return false;
        }
        let problem = try self.no_fields_error(receiver);
        return self.fail(move problem);
    }
    let field_index = self.find_struct_field_index(tree, struct_idx, field_name);
    if field_index < 0 {
        let problem = try self.unknown_field_error(receiver, field_name);
        return self.fail(move problem);
    }
    var maybe_decl: ?ast::Declaration = null;
    var struct_name_handle = expression.name;
    var field_name_handle = expression.name;
    var field_public = false;
    var is_extern = false;
    var is_std = false;
    var requires_unsafe = false;
    var module_id = -1;
    var cached_type = empty_type();
    if self.metadata.struct_infos.at(struct_idx) |info| {
        maybe_decl = info.declaration;
        struct_name_handle = info.name;
        is_extern = info.is_extern;
        is_std = info.is_std;
        requires_unsafe = info.requires_unsafe;
        module_id = info.module_id;
        if info.fields.at(field_index) |field| {
            field_name_handle = field.name;
            field_public = field.public;
            cached_type = field.resolved_type;
        }
    }
    if maybe_decl |_| {} else {
        let problem = try self.no_fields_error(receiver);
        return self.fail(move problem);
    }
    let decl_handle = maybe_decl orelse return true;
    let accessible = field_public or is_extern or
        (is_std and self.checking_std_body()) or
        (!is_std and (module_id < 0 or module_id == self.current_module_id()));
    if !accessible {
        let type_bytes = semantic_text(tree, struct_name_handle);
        let problem = try self.private_field_error(type_bytes, field_name);
        return self.fail(move problem);
    }
    var field_type = cached_type;
    var need_resolve = false;
    if self.type_args.current |_| {
        need_resolve = true;
    }
    if self.meta_bindings.current |_| {
        need_resolve = true;
    }
    if field_type.node |_| {} else {
        need_resolve = true;
    }
    if need_resolve {
        match tree.declarations.at(decl_handle.node) {
            Struct(value) => {
                if value.fields.at(field_index) |field| {
                    match try self.resolve_instance_field_type(tree, field) {
                        Value(resolved) => {
                            field_type = resolved;
                        },
                        Issue(issue) => {
                            let problem = try self.type_resolution_diagnostic(issue);
                            return self.fail(move problem);
                        },
                    }
                }
            },
            _ => {
                let problem = try self.no_fields_error(receiver);
                return self.fail(move problem);
            },
        }
    }
    if write and requires_unsafe {
        match tree.declarations.at(decl_handle.node) {
            Struct(declaration) => {
                let type_bytes = semantic_text(tree, declaration.name);
                if try self.require_unsafe_struct_invariant(
                    declaration,
                    type_bytes,
                    "write to field",
                    field_name,
                    expression.span
                ) |problem| {
                    return self.fail(move problem);
                }
            },
            _ => {},
        }
    }
    out.* = field_type;
    if self.editor.len() > 0 {
        try self.record_reference(tree.text_span(expression.name), tree.text_span(field_name_handle), write);
    }
    return false;
}

fn (self: &Checker) namespace_separator_error(
    kind: []u8,
    owner: []u8,
    member: []u8
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, kind);
    try message.append_bytes(self.allocator, " `");
    try message.append_bytes(self.allocator, owner);
    try message.append_byte(self.allocator, cast<u8>(46));
    try message.append_bytes(self.allocator, member);
    try message.append_bytes(self.allocator, "` must use `::`");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn is_std_type_name(name: []u8) -> bool {
    return mem::starts_with(name, "std::");
}

fn user_module_end(name: []u8) -> ?i64 {
    var index = mem::len(name);
    while index > 1 {
        index = index - 1;
        if name[index - 1] == cast<u8>(58) and
            name[index] == cast<u8>(58) {
            return index - 1;
        }
    }
    return null;
}

fn (self: &var Checker) check_fs_metadata_field(
    name: []u8,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if mem::equal_bytes(name, "size") {
        out.* = try self.types.i64_type();
        return null;
    }
    if mem::equal_bytes(name, "is_dir") {
        out.* = try self.types.bool_type();
        return null;
    }
    return try self.unknown_builtin_field_error("std::fs::Metadata", name);
}

fn (self: &var Checker) check_fs_dir_entry_field(
    name: []u8,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    if mem::equal_bytes(name, "name") or mem::equal_bytes(name, "path") {
        out.* = try self.types.intern("std::string::String");
        return null;
    }
    if mem::equal_bytes(name, "is_dir") {
        out.* = try self.types.bool_type();
        return null;
    }
    return try self.unknown_builtin_field_error("std::fs::DirEntry", name);
}

fn (self: &Checker) unknown_builtin_field_error(
    owner: []u8,
    name: []u8
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "unknown field `");
    try message.append_bytes(self.allocator, owner);
    try message.append_byte(self.allocator, cast<u8>(46));
    try message.append_bytes(self.allocator, name);
    try message.append_byte(self.allocator, cast<u8>(96));
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) check_namespace_expr(
    tree: &ast::Ast,
    expression: &ast::FieldExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    let retained_member = tree.texts.at(expression.name.node);
    let member = retained_member.as_bytes();
    if self.enum_receiver(tree, expression.receiver) |handle| {
        if self.metadata.enums.at(handle.index) |tagged| {
            let retained_name = tree.texts.at(tagged.name.node);
            let name = retained_name.as_bytes();
            if !tagged.tags.contains(member) {
                return try self.unknown_namespace_member_error("enum tag", name, member);
            }
            out.* = try self.types.intern(name);
            if self.instantiation_depth == 0 {
                if self.editor.at_mut(0) |index| {
                    try index.record_member(self.allocator, tree.text_span(expression.name), name, member);
                }
            }
            return null;
        }
    }
    if try self.error_set_receiver(tree, expression.receiver) |handle| {
        if self.metadata.error_sets.at(handle.index) |set| {
            let retained_name = tree.texts.at(set.name.node);
            let name = retained_name.as_bytes();
            if self.metadata.enums.at(set.tagged.index) |value| {
                if !value.tags.contains(member) {
                    return try self.unknown_namespace_member_error("error", name, member);
                }
                out.* = try self.types.intern(name);
                if self.instantiation_depth == 0 {
                    if self.editor.at_mut(0) |index| {
                        try index.record_member(self.allocator, tree.text_span(expression.name), name, member);
                    }
                }
                return null;
            }
        }
    }
    if self.union_receiver(tree, expression.receiver) |handle| {
        if self.metadata.unions.at(handle.index) |tagged| {
            let name = tagged.name.as_bytes();
            let payload = tagged.variants.get(member);
            if payload |_| {} else {
                return try self.unknown_namespace_member_error("union variant", name, member);
            }
            let payload_type = payload orelse empty_type();
            if !same_type(payload_type, empty_type()) {
                var message = string::new(self.allocator);
                errdefer message.deinit(self.allocator);
                try message.append_bytes(self.allocator, "union variant `");
                try message.append_bytes(self.allocator, name);
                try message.append_bytes(self.allocator, "::");
                try message.append_bytes(self.allocator, member);
                try message.append_bytes(self.allocator, "` expects payload");
                return try self.checker_message_at("type error", ast::zero_span(), move message);
            }
            out.* = try self.types.intern(name);
            if self.instantiation_depth == 0 {
                if self.editor.at_mut(0) |index| {
                    try index.record_member(self.allocator, tree.text_span(expression.name), name, member);
                }
            }
            return null;
        }
    }
    let rendered = try ast::render_expression(self.allocator, tree, expression.receiver);
    defer rendered.deinit(self.allocator);
    let name = rendered.as_bytes();
    return try self.unknown_namespace_error(name, expression_span(tree, expression.receiver));
}

fn (self: &Checker) enum_receiver(tree: &ast::Ast, expression: ast::Expression) -> ?EnumHandle {
    match tree.expressions.at(expression.node) {
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let name = retained.as_bytes();
            return self.metadata.enums_by_name.get(name);
        },
        _ => return null,
    }
}

fn (self: &Checker) union_receiver(tree: &ast::Ast, expression: ast::Expression) -> ?UnionHandle {
    match tree.expressions.at(expression.node) {
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let name = retained.as_bytes();
            return self.metadata.unions_by_name.get(name);
        },
        _ => return null,
    }
}

fn (self: &Checker) error_set_receiver(
    tree: &ast::Ast,
    expression: ast::Expression
) -> !?ErrorSetHandle {
    if try qualified_name(self.allocator, tree, expression) |name| {
        defer name.deinit(self.allocator);
        let bytes = name.as_bytes();
        return self.metadata.error_sets_by_name.get(bytes);
    }
    return null;
}

fn (self: &Checker) unknown_namespace_member_error(
    kind: []u8,
    owner: []u8,
    member: []u8
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "unknown ");
    try message.append_bytes(self.allocator, kind);
    try message.append_bytes(self.allocator, " `");
    try message.append_bytes(self.allocator, owner);
    try message.append_bytes(self.allocator, "::");
    try message.append_bytes(self.allocator, member);
    try message.append_byte(self.allocator, cast<u8>(96));
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) unknown_namespace_error(
    name: []u8,
    span: ast::Span
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "unknown namespace `");
    try message.append_bytes(self.allocator, name);
    try message.append_byte(self.allocator, cast<u8>(96));
    var problem = try self.checker_message_at("type error", span, move message);
    errdefer problem.deinit(self.allocator);
    if !span.is_zero() {
        try problem.with_code(self.allocator, "type.unknown_namespace");
    }
    try problem.with_help(self.allocator, "use an enum/union name or import a module that defines this namespace");
    let known = try self.known_namespace_summary();
    defer known.deinit(self.allocator);
    let known_bytes = known.as_bytes();
    if mem::len(known_bytes) > 0 {
        var note = string::new(self.allocator);
        defer note.deinit(self.allocator);
        try note.append_bytes(self.allocator, "known namespaces: ");
        try note.append_bytes(self.allocator, known_bytes);
        let note_bytes = note.as_bytes();
        try problem.with_note(self.allocator, note_bytes);
    }
    return move problem;
}

fn (self: &Checker) known_namespace_summary() -> !string::String {
    var names = array::new<string::String>(self.allocator);
    defer names.deinit(self.allocator);
    var index = 0;
    while self.metadata.enums_by_name.key_at(index) |name| {
        let copied = try string::from_bytes(self.allocator, name);
        errdefer copied.deinit(self.allocator);
        try names.append(self.allocator, move copied);
        index = index + 1;
    }
    index = 0;
    while self.metadata.unions_by_name.key_at(index) |name| {
        let copied = try string::from_bytes(self.allocator, name);
        errdefer copied.deinit(self.allocator);
        try names.append(self.allocator, move copied);
        index = index + 1;
    }
    try sort::strings(&var names);
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    index = 0;
    while index < names.len() and index < 5 {
        if index > 0 {
            try out.append_bytes(self.allocator, ", ");
        }
        if names.at(index) |name| {
            let bytes = name.as_bytes();
            try out.append_bytes(self.allocator, bytes);
        }
        index = index + 1;
    }
    if names.len() > 5 {
        if index > 0 {
            try out.append_bytes(self.allocator, ", ");
        }
        try out.append_bytes(self.allocator, "...");
    }
    return move out;
}

fn (self: &var Checker) check_deref_expr(
    tree: &var ast::Ast,
    scope: ScopeHandle,
    expression: &ast::DerefExpr,
    out: &var Type
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.receiver.node) {
        Ident(identifier) => {
            let retained = tree.texts.at(identifier.name.node);
            let name = retained.as_bytes();
            if self.scopes.is_borrowed(scope, name) {
                if self.scopes.lookup(scope, name) |value| {
                    if self.editor.len() > 0 {
                        let selection = self.scopes.selection(scope, name);
                        try self.record_reference(tree.text_span(identifier.name), selection, false);
                    }
                    out.* = value;
                    return null;
                }
            }
        },
        _ => {},
    }
    var receiver = empty_type();
    if try self.check_expr(tree, scope, expression.receiver, &var receiver) |problem| {
        return move problem;
    }
    if try self.types.explicit_borrow_type(receiver) |parts| {
        out.* = parts.inner;
        return null;
    }
    if self.types.is_pointer_type(receiver) {
        if try self.require_unsafe_capability_at(
            UnsafeCapability::PtrDeref,
            "raw pointer dereference",
            expression.operator_span
        ) |problem| {
            return move problem;
        }
        match try self.types.raw_pointer_deref_type(receiver) {
            Value(value) => {
                out.* = value;
                return null;
            },
            Error(reason) => return try self.pointer_deref_error(receiver, reason, false),
        }
    }
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try self.append_checker_type(&var message, receiver);
    try message.append_bytes(self.allocator, "` is not a borrow or raw pointer and cannot be dereferenced");
    return try self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) pointer_deref_error(
    receiver: Type,
    reason: PointerDerefError,
    assignment: bool
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    match reason {
        NotPointer => {
            try message.append_byte(self.allocator, cast<u8>(96));
            try self.append_checker_type(&var message, receiver);
            try message.append_bytes(self.allocator, "` is not a raw pointer");
        },
        Nullable => {
            try message.append_bytes(self.allocator, "nullable raw pointer `");
            try self.append_checker_type(&var message, receiver);
            try message.append_bytes(self.allocator, "` cannot be dereferenced");
        },
        Const => {
            if assignment {
                try message.append_bytes(self.allocator, "cannot assign through const raw pointer `");
                try self.append_checker_type(&var message, receiver);
                try message.append_byte(self.allocator, cast<u8>(96));
            } else {
                try message.append_byte(self.allocator, cast<u8>(96));
                try self.append_checker_type(&var message, receiver);
                try message.append_bytes(self.allocator, "` is not a raw pointer");
            }
        },
    }
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &var Checker) require_unsafe_struct_invariant(
    declaration: &ast::StructDecl,
    type_name: []u8,
    action: []u8,
    field_name: []u8,
    span: ast::Span
) -> !?diagnostic::Diagnostic {
    match unsafe_struct_invariant_requirement(
        true,
        declaration.requires_unsafe,
        declaration.span,
        span
    ) {
        None => return null,
        Marker => {
            let operation = try unsafe_struct_operation(self.allocator,
                action,
                type_name,
                field_name
            );
            defer operation.deinit(self.allocator);
            let bytes = operation.as_bytes();
            return self.require_unsafe_capability_at(
                UnsafeCapability::StructInvariant,
                bytes,
                span
            );
        },
        FileBoundary => {
            let operation = try unsafe_struct_operation(self.allocator,
                action,
                type_name,
                field_name
            );
            defer operation.deinit(self.allocator);
            let operation_bytes = operation.as_bytes();
            var message = string::new(self.allocator);
            errdefer message.deinit(self.allocator);
            try message.append_bytes(self.allocator, operation_bytes);
            try message.append_bytes(self.allocator, " is confined to its declaration file");
            var problem = try self.checker_message_at("unsafe error", span, move message);
            errdefer problem.deinit(self.allocator);
            try problem.with_code(self.allocator, "unsafe.invariant_file_boundary");
            return move problem;
        },
    }
}

fn unsafe_struct_operation(
    allocator: Allocator,
    action: []u8,
    type_name: []u8,
    field_name: []u8
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, action);
    try out.append_bytes(allocator, " `");
    if mem::len(field_name) == 0 {
        try out.append_bytes(allocator, "unsafe struct ");
    }
    try out.append_bytes(allocator, type_name);
    if mem::len(field_name) > 0 {
        try out.append_byte(allocator, cast<u8>(46));
        try out.append_bytes(allocator, field_name);
    }
    try out.append_byte(allocator, cast<u8>(96));
    return move out;
}

fn (self: &Checker) no_fields_error(receiver: Type) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_byte(self.allocator, cast<u8>(96));
    try self.append_checker_type(&var message, receiver);
    try message.append_bytes(self.allocator, "` has no fields");
    return self.checker_message_at("type error", ast::zero_span(), move message);
}

fn (self: &Checker) unknown_field_error(
    receiver: Type,
    field_name: []u8
) -> !diagnostic::Diagnostic {
    var message = string::new(self.allocator);
    errdefer message.deinit(self.allocator);
    try message.append_bytes(self.allocator, "unknown field `");
    try self.append_checker_type(&var message, receiver);
    try message.append_byte(self.allocator, cast<u8>(46));
    try message.append_bytes(self.allocator, field_name);
    try message.append_byte(self.allocator, cast<u8>(96));
    return self.checker_message_at("type error", ast::zero_span(), move message);
}
