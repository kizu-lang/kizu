import compiler::internal::ast;
import std::arena;
import std::array;
import std::map;

// Owns every type-parameter frame made during a checker phase. The current
// frame is a copy handle so entering a generic never moves an owner field.
struct TypeParamStore {
    allocator: Allocator,
    frames: arena::Arena<map::Map<[]u8, bool>>,
    current: ?arena::Handle<map::Map<[]u8, bool>>
}

fn new_type_param_store(allocator: Allocator) -> TypeParamStore {
    return TypeParamStore {
        allocator: allocator,
        frames: arena::new<map::Map<[]u8, bool>>(allocator),
        current: null
    };
}

// Selects params and returns the frame the caller must restore. An empty list
// selects no parameters rather than capturing names from the outer generic.
fn (self: &var TypeParamStore) enter_ast(
    allocator: Allocator,
    tree: &ast::Ast, params: &array::Array<ast::Text>
) -> !?arena::Handle<map::Map<[]u8, bool>> {
    let previous = self.current;
    if params.len() == 0 {
        self.current = null;
        return previous;
    }
    var names = map::new<[]u8, bool>(self.allocator);
    errdefer names.deinit(self.allocator);
    var index = 0;
    while params.at(index) |param| {
        let retained = tree.texts.at(param.node);
        let name = retained.as_bytes();
        try names.insert(allocator, name, true);
        index = index + 1;
    }
    return try self.install_frame(move names, previous);
}

// Selects only type-valued entries from one parser-owned signature.
fn (self: &var TypeParamStore) enter_ast_signature(allocator: Allocator, tree: &ast::Ast, signature: &ast::FunctionSignature) -> !?arena::Handle<map::Map<[]u8, bool>> {
    let previous = self.current;
    if signature.static_params.len() == 0 {
        self.current = null;
        return previous;
    }
    var names = map::new<[]u8, bool>(self.allocator);
    errdefer names.deinit(self.allocator);
    var index = 0;
    while signature.static_params.at(index) |parameter| {
        if parameter.type_name |_| {} else {
            let retained = tree.texts.at(parameter.name.node);
            let name = retained.as_bytes();
            try names.insert(allocator, name, true);
        }
        index = index + 1;
    }
    return try self.install_frame(move names, previous);
}

// Selects only type-valued static parameters from a cached signature.
fn (self: &var TypeParamStore) enter_signature(
    allocator: Allocator,
    signature: &FunctionSignatureType
) -> !?arena::Handle<map::Map<[]u8, bool>> {
    let previous = self.current;
    if signature.static_params.len() == 0 {
        self.current = null;
        return previous;
    }
    var names = map::new<[]u8, bool>(self.allocator);
    errdefer names.deinit(self.allocator);
    var index = 0;
    while signature.static_params.at(index) |param| {
        if param.is_type {
            let name = param.name.as_bytes();
            try names.insert(allocator, name, true);
        }
        index = index + 1;
    }
    return try self.install_frame(move names, previous);
}

// Selects a caller-built set of type parameter names.
fn (self: &var TypeParamStore) enter(
    names: map::Map<[]u8, bool>
) -> !?arena::Handle<map::Map<[]u8, bool>> {
    let previous = self.current;
    return try self.install_frame(move names, previous);
}

fn (self: &var TypeParamStore) install_frame(names: map::Map<[]u8, bool>, previous: ?arena::Handle<map::Map<[]u8, bool>>) -> !?arena::Handle<map::Map<[]u8, bool>> {
    if names.len() == 0 {
        names.deinit(self.allocator);
        self.current = null;
        return previous;
    }
    let handle = try self.frames.add(self.allocator, move names);
    self.current = handle;
    return previous;
}

// Selects the frame returned by enter_ast.
fn (self: &var TypeParamStore) restore(previous: ?arena::Handle<map::Map<[]u8, bool>>) -> void {
    self.current = previous;
}

// Reports whether name belongs to the selected frame.
fn (self: &TypeParamStore) contains(name: []u8) -> bool {
    let handle = self.current orelse return false;
    return self.frames.at(handle).contains(name);
}
