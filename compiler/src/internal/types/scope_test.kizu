import compiler::internal::ast;
import std::array;
import std::mem;
import std::string;
import std::testing;

fn test_span(line: i64, column: i64) -> ast::Span {
    return ast::Span {
        source: null,
        start: ast::Position { line: line, column: column },
        end: ast::Position { line: line, column: column + 1 }
    };
}

fn one_source(allocator: Allocator, name: []u8) -> !array::Array<string::String> {
    var sources = array::new<string::String>(allocator);
    errdefer sources.deinit(allocator);
    let source = try string::from_bytes(allocator, name);
    errdefer source.deinit(allocator);
    try sources.append(allocator, move source);
    return move sources;
}

fn expect_borrow_source(
    scopes: &ScopeStore,
    scope: ScopeHandle,
    binding_name: []u8,
    expected: []u8
) -> void {
    let idx = scopes.find_entry_in_scope(scope.index, binding_name);
    if idx >= 0 {
        if scopes.entries.at(idx) |entry| {
            if entry.binding.borrow_sources.at(0) |source| {
                let bytes = source.as_bytes();
                testing::expect(equal(bytes, expected));
                return;
            }
        }
    }
    testing::fail("scope binding lost its borrow source");
}

fn expect_unread(
    scopes: &ScopeStore,
    scope: ScopeHandle,
    name: []u8,
    expected: bool
) -> void {
    let idx = scopes.find_entry_in_scope(scope.index, name);
    if idx >= 0 {
        if scopes.entries.at(idx) |entry| {
            if entry.binding.unread |_| {
                testing::expect(expected);
            } else {
                testing::expect(!expected);
            }
            return;
        }
    }
    testing::fail("scope lost its local binding");
}

test "scope keeps one binding record per name" {
    let allocator = mem::page_allocator();
    var table = new_type_table(allocator);
    defer table.deinit(allocator);
    var scopes = new_scope_store(allocator);
    defer scopes.deinit(allocator);
    let root = try scopes.new_scope(null);
    let bool_type = try table.bool_type();
    let i64_type = try table.i64_type();
    testing::expect(try scopes.define(root, "zeta", bool_type, false));
    testing::expect(try scopes.define(root, "alpha", i64_type, true));
    let zeta_span = test_span(4, 5);
    let alpha_span = test_span(2, 3);
    scopes.declare_local(root, "zeta", zeta_span);
    scopes.declare_local(root, "alpha", alpha_span);
    testing::expect(scopes.is_mutable(root, "alpha"));
    expect_unread(&scopes, root, "alpha", true);
    testing::expect(!(try scopes.define(root, "alpha", bool_type, false)));
    testing::expect(try scopes.define(root, "_", i64_type, false));
    testing::expect(try scopes.define(root, "_", bool_type, true));
    let child = try scopes.new_scope(root);
    if scopes.lookup(child, "alpha") |found| {
        testing::expect(same_type(found, i64_type));
    } else {
        testing::fail("child did not resolve its parent binding");
    }
    expect_unread(&scopes, root, "alpha", false);
    expect_unread(&scopes, root, "zeta", true);
}

test "scope resolves borrow facts at the nearest binding" {
    let allocator = mem::page_allocator();
    var table = new_type_table(allocator);
    defer table.deinit(allocator);
    var scopes = new_scope_store(allocator);
    defer scopes.deinit(allocator);
    let root = try scopes.new_scope(null);
    let view_type = try table.byte_string_type();
    let view_sources = try one_source(allocator, "view");
    testing::expect(try scopes.define_param_with_source(
        root,
        "view",
        view_type,
        false,
        false,
        move view_sources,
        false
    ));
    expect_borrow_source(&scopes, root, "view", "view");
    let i64_type = try table.i64_type();
    let out_sources = try one_source(allocator, "out");
    testing::expect(try scopes.define_param_with_source(
        root,
        "out",
        i64_type,
        true,
        true,
        move out_sources,
        true
    ));
    testing::expect(scopes.is_borrowed(root, "out"));
    testing::expect(scopes.is_mut_borrowed(root, "out"));
    testing::expect(scopes.is_mut_borrowed_param(root, "out"));
    let child = try scopes.new_scope(root);
    let bool_type = try table.bool_type();
    let sources = try one_source(allocator, "owner");
    testing::expect(try scopes.define_param_with_source(
        child,
        "out",
        bool_type,
        true,
        true,
        move sources,
        false
    ));
    testing::expect(!scopes.is_mut_borrowed_param(child, "out"));
    expect_borrow_source(&scopes, child, "out", "owner");
}

test "scope promotes large scopes to index map, tracks unread counts, and resets cleanly" {
    let allocator = mem::page_allocator();
    var table = new_type_table(allocator);
    defer table.deinit(allocator);
    var scopes = new_scope_store(allocator);
    defer scopes.deinit(allocator);
    let i64_type = try table.i64_type();
    let bool_type = try table.bool_type();
    let root = try scopes.new_scope(null);
    var names = array::new<[]u8>(allocator);
    defer names.deinit(allocator);
    try names.append(allocator, "v00");
    try names.append(allocator, "v01");
    try names.append(allocator, "v02");
    try names.append(allocator, "v03");
    try names.append(allocator, "v04");
    try names.append(allocator, "v05");
    try names.append(allocator, "v06");
    try names.append(allocator, "v07");
    try names.append(allocator, "v08");
    try names.append(allocator, "v09");
    try names.append(allocator, "v10");
    try names.append(allocator, "v11");
    try names.append(allocator, "v12");
    try names.append(allocator, "v13");
    try names.append(allocator, "v14");
    try names.append(allocator, "v15");
    try names.append(allocator, "v16");
    try names.append(allocator, "v17");
    try names.append(allocator, "v18");
    try names.append(allocator, "v19");
    var idx = 0;
    while names.get(idx) |name| {
        testing::expect(try scopes.define(root, name, i64_type, idx % 2 == 0));
        scopes.declare_local(root, name, test_span(idx + 1, 1));
        idx = idx + 1;
    }
    testing::expect(!(try scopes.define(root, "v00", bool_type, false)));
    testing::expect(!(try scopes.define(root, "v19", bool_type, false)));
    testing::expect(scopes.has_unread(root));
    let empty1 = try scopes.new_scope(root);
    let empty2 = try scopes.new_scope(empty1);
    testing::expect(!scopes.has_unread(empty2));
    idx = 0;
    while names.get(idx) |name| {
        if scopes.lookup(empty2, name) |found| {
            testing::expect(same_type(found, i64_type));
        } else {
            testing::fail("promoted scope lost a binding across empty child scopes");
        }
        idx = idx + 1;
    }
    testing::expect(!scopes.has_unread(root));
    scopes.reset();
    let fresh = try scopes.new_scope(null);
    testing::expect(try scopes.define(fresh, "v00", bool_type, true));
    if scopes.lookup(fresh, "v00") |found| {
        testing::expect(same_type(found, bool_type));
    } else {
        testing::fail("reset scope did not bind fresh variable");
    }
}
