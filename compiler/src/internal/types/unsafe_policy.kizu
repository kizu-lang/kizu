import compiler::internal::ast;
import std::mem;

// Mechanical port of the copy-only unsafe policy decisions in
// internal/types/unsafe.go. Checker-owned diagnostic construction stays above
// this boundary.

/// Classifies what one unsafe-struct invariant operation still requires.
pub enum UnsafeInvariantRequirement {
    None,
    Marker,
    FileBoundary,
}

/// Classifies an invariant operation without constructing diagnostic text.
pub fn unsafe_struct_invariant_requirement(
    declaration_present: bool,
    requires_unsafe: bool,
    declaration_span: ast::Span,
    use_span: ast::Span
) -> UnsafeInvariantRequirement {
    if !declaration_present or !requires_unsafe {
        return UnsafeInvariantRequirement::None;
    }
    if declaration_span.source |declaration_source| {
        if use_span.source |use_source| {
            if declaration_source.index != use_source.index {
                return UnsafeInvariantRequirement::FileBoundary;
            }
        }
    }
    return UnsafeInvariantRequirement::Marker;
}

/// Reports whether an unsafe obligation has no declaration documentation.
pub fn obligation_doc_missing(requires_unsafe: bool, doc: []u8) -> bool {
    return requires_unsafe and mem::len(doc) == 0;
}
