import std::fmt;
import std::fs;
import std::mem;
import std::path;
import std::process;
import std::string;

// Replacements for what the Go side reads from os, path/filepath and
// strings. They are std gap material recorded in docs/language-gaps.md:
// more than one module needs them, so they live here rather than inside
// whichever module needed them first.

/// Creates every directory a path names that is not there yet, the Go
/// `os.MkdirAll`: `fs::create_dir` tolerates an existing directory.
pub fn create_dir_all(io: Io, target: []u8) -> !void {
    var index = 0;
    while index < mem::len(target) {
        if target[index] == cast<u8>(47) and index > 0 {
            let prefix = target[0..index];
            try fs::create_dir(io, prefix);
        }
        index = index + 1;
    }
    if mem::len(target) > 0 {
        try fs::create_dir(io, target);
    }
    return;
}

/// Reports whether text ends with suffix, the Go `strings.HasSuffix`.
pub fn has_suffix(text: []u8, suffix: []u8) -> bool {
    let text_len = mem::len(text);
    let suffix_len = mem::len(suffix);
    if text_len < suffix_len {
        return false;
    }
    let tail = text[text_len - suffix_len..text_len];
    return mem::equal_bytes(tail, suffix);
}

pub error Error {
    MissingHome,
    MissingWorkingDirectory,
}

/// Returns a cleaned absolute path, the Go `filepath.Abs`. std does not expose
/// getcwd, so the caller supplies the shell-maintained PWD through the process
/// environment; selfhost differential runners pin it to os.Getwd. Windows
/// keeps no PWD: there the working directory is asked of the filesystem.
pub fn absolute(io: Io, allocator: Allocator, target: []u8) -> !string::String {
    comptime if std::target::is_windows() {
        return absolute_on_windows(io, allocator, target);
    }
    if mem::len(target) > 0 and target[0] == cast<u8>(47) {
        return path::clean(allocator, target);
    }
    let working = process::env("PWD") orelse return Error::MissingWorkingDirectory;
    return path::join(allocator, working, target);
}

/// Returns a cleaned absolute path on Windows, spelled with the slashes
/// every path the runtime hands back has. A path with a drive letter is
/// absolute already; one that starts at a root is on the working
/// directory's drive.
fn absolute_on_windows(io: Io, allocator: Allocator, target: []u8) -> !string::String {
    var given = string::new(allocator);
    defer given.deinit(allocator);
    var index = 0;
    while index < mem::len(target) {
        var byte = target[index];
        if byte == cast<u8>(92) {
            byte = cast<u8>(47);
        }
        try given.append_byte(allocator, byte);
        index = index + 1;
    }
    let slashed = given.as_bytes();
    let size = mem::len(slashed);
    if size >= 2 and slashed[1] == cast<u8>(58) {
        return path::clean(allocator, slashed);
    }
    let working = try fs::real_path(io, allocator, ".");
    defer working.deinit(allocator);
    let working_bytes = working.as_bytes();
    if size > 0 and slashed[0] == cast<u8>(47) and mem::len(working_bytes) >= 2 {
        var rooted = try string::from_bytes(allocator, working_bytes[0..2]);
        defer rooted.deinit(allocator);
        try rooted.append_bytes(allocator, slashed);
        let rooted_bytes = rooted.as_bytes();
        return path::clean(allocator, rooted_bytes);
    }
    return path::join(allocator, working_bytes, slashed);
}

/// Appends the platform cache directory, the Go `os.UserCacheDir`: on
/// Windows LocalAppData, and elsewhere probed rather than compiled per
/// platform: a home with Library/Caches is the macOS spelling, and
/// XDG_CACHE_HOME or ~/.cache is the Linux spelling.
pub fn append_user_cache_dir(io: Io, allocator: Allocator, out: &var string::String) -> !void {
    comptime if std::target::is_windows() {
        let local = process::env("LocalAppData") orelse "";
        if mem::len(local) == 0 {
            return Error::MissingHome;
        }
        return out.append_bytes(allocator, local);
    }
    let home = process::env("HOME") orelse "";
    if mem::len(home) > 0 {
        let mac_base = try path::join(allocator, home, "Library/Caches");
        defer mac_base.deinit(allocator);
        let mac_bytes = mac_base.as_bytes();
        let mac = try fs::exists(io, mac_bytes);
        if mac {
            return out.append_bytes(allocator, mac_bytes);
        }
    }
    if process::env("XDG_CACHE_HOME") |xdg| {
        if mem::len(xdg) > 0 {
            return out.append_bytes(allocator, xdg);
        }
    }
    if mem::len(home) == 0 {
        return Error::MissingHome;
    }
    try out.append_bytes(allocator, home);
    return out.append_bytes(allocator, "/.cache");
}

/// Names one scratch file the way Go draws one from `os.CreateTemp`. std
/// has no randomness, so distinctness comes from what differs between
/// concurrent writers: the name they build for, the wall clock, and a
/// per-process sequence. Two processes collide only when they build the
/// same name in the same millisecond, and the loser fails loudly.
pub fn append_scratch_name(allocator: Allocator, source: &string::String, sequence: i64, out: &var string::String) -> !void {
    try out.append_bytes(allocator, "artifact-");
    let source_bytes = source.as_bytes();
    var head = mem::len(source_bytes);
    if head > 16 {
        head = 16;
    }
    let prefix = source_bytes[0..head];
    try out.append_bytes(allocator, prefix);
    try out.append_bytes(allocator, "-");
    try fmt::append_i64(allocator, out, process::unix_millis());
    try out.append_bytes(allocator, "-");
    return fmt::append_i64(allocator, out, sequence);
}
