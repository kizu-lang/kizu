import std::mem;
import std::string;

// RFC3339 UTC timestamps for epoch milliseconds. The Go side reads and
// writes these through the time package; Kizu has none yet, so the civil
// conversion and the ordering live here as std gap material (recorded in
// docs/selfhost-porting.md) rather than inside the module that happens to
// need them first.

/// Appends the Go `time.Time` JSON spelling of one epoch-milliseconds
/// moment: RFC3339 UTC with the fraction trimmed the way RFC3339Nano
/// trims it. Go writes nanoseconds where this writes milliseconds; both
/// sides read either.
pub fn append_rfc3339_utc(out: &var string::String, millis: i64) -> !void {
    let days = millis / 86400000;
    let rem = millis % 86400000;
    let z = days + 719468;
    let era = z / 146097;
    let doe = z % 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = doy - (153 * mp + 2) / 5 + 1;
    var month = mp + 3;
    if mp >= 10 {
        month = mp - 9;
    }
    var year = yoe + era * 400;
    if month <= 2 {
        year = year + 1;
    }
    try append_padded(out, year, 1000);
    try out.append_byte(cast<u8>(45));
    try append_padded(out, month, 10);
    try out.append_byte(cast<u8>(45));
    try append_padded(out, day, 10);
    try out.append_byte(cast<u8>(84));
    let hour = rem / 3600000;
    let minute = (rem / 60000) % 60;
    let second = (rem / 1000) % 60;
    let milli = rem % 1000;
    try append_padded(out, hour, 10);
    try out.append_byte(cast<u8>(58));
    try append_padded(out, minute, 10);
    try out.append_byte(cast<u8>(58));
    try append_padded(out, second, 10);
    if milli != 0 {
        try out.append_byte(cast<u8>(46));
        var scale = 100;
        var rest = milli;
        while rest > 0 {
            try out.append_byte(cast<u8>(48 + rest / scale));
            rest = rest % scale;
            scale = scale / 10;
        }
    }
    return out.append_byte(cast<u8>(90));
}

/// Appends value zero-padded to the width the top divisor spells.
fn append_padded(out: &var string::String, value: i64, top: i64) -> !void {
    var divisor = top;
    while divisor > 0 {
        try out.append_byte(cast<u8>(48 + (value / divisor) % 10));
        divisor = divisor / 10;
    }
    return;
}

/// Orders two RFC3339 UTC stamps, the Go `time.Before` over parsed
/// spellings. The date and time compare bytewise up to the seconds; the
/// fractions compare digit by digit with missing digits read as zero,
/// because `.5` is later than `.123` while shorter. Both compilers write
/// UTC `Z` stamps, so offsets need no arithmetic here.
pub fn stamp_before(a: []u8, b: []u8) -> bool {
    if mem::len(a) < 19 or mem::len(b) < 19 {
        return mem::len(a) < mem::len(b);
    }
    var index = 0;
    while index < 19 {
        if a[index] != b[index] {
            return a[index] < b[index];
        }
        index = index + 1;
    }
    // The fraction digits start after the `.` at 19; a stamp with no
    // fraction reads as zeros. Nine digits is all Go ever writes, so a
    // dozen closes every real spelling.
    var digit = 0;
    while digit < 12 {
        let a_value = fraction_digit(a, 20 + digit);
        let b_value = fraction_digit(b, 20 + digit);
        if a_value != b_value {
            return a_value < b_value;
        }
        digit = digit + 1;
    }
    return false;
}

/// Reads one fraction digit, zero once the fraction has ended.
fn fraction_digit(stamp: []u8, at: i64) -> i64 {
    if at >= mem::len(stamp) {
        return 0;
    }
    let byte = stamp[at];
    if byte < cast<u8>(48) or byte > cast<u8>(57) {
        return 0;
    }
    return cast<i64>(byte) - 48;
}
