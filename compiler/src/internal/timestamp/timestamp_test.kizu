import std::mem;
import std::string;
import std::testing;

// The spelling has to be what Go's time.Time JSON writes for the same
// moment, and the ordering has to sort Go nanosecond spellings together
// with this module's millisecond spellings; both are checked here where
// input and output can show them.

/// Renders one stamp for the format tests.
fn stamp_of(allocator: Allocator, millis: i64) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try append_rfc3339_utc(&var out, millis);
    return move out;
}

test "rfc3339 utc spells the fraction trimmed" {
    let allocator = mem::page_allocator();
    let epoch = try stamp_of(allocator, 0);
    defer epoch.deinit();
    let epoch_bytes = epoch.as_bytes();
    testing::expect_equal<[]u8>("1970-01-01T00:00:00Z", epoch_bytes);
    let full = try stamp_of(allocator, 1700000000123);
    defer full.deinit();
    let full_bytes = full.as_bytes();
    testing::expect_equal<[]u8>("2023-11-14T22:13:20.123Z", full_bytes);
    let tens = try stamp_of(allocator, 1700000000120);
    defer tens.deinit();
    let tens_bytes = tens.as_bytes();
    testing::expect_equal<[]u8>("2023-11-14T22:13:20.12Z", tens_bytes);
    let half = try stamp_of(allocator, 1700000000500);
    defer half.deinit();
    let half_bytes = half.as_bytes();
    testing::expect_equal<[]u8>("2023-11-14T22:13:20.5Z", half_bytes);
}

test "stamps order by time rather than by spelling" {
    testing::expect(stamp_before(
        "2023-11-14T22:13:20.123Z",
        "2023-11-14T22:13:20.5Z"
    ));
    testing::expect(!stamp_before(
        "2023-11-14T22:13:20.5Z",
        "2023-11-14T22:13:20.123Z"
    ));
    testing::expect(stamp_before("2023-11-14T22:13:20Z", "2023-11-14T22:13:20.5Z"));
    testing::expect(!stamp_before("2023-11-14T22:13:20.5Z", "2023-11-14T22:13:20Z"));
    testing::expect(!stamp_before("2023-11-14T22:13:20.500Z", "2023-11-14T22:13:20.5Z"));
    testing::expect(!stamp_before("2023-11-14T22:13:20.5Z", "2023-11-14T22:13:20.500Z"));
    testing::expect(stamp_before(
        "2023-11-14T22:13:20.123456789Z",
        "2023-11-14T22:13:20.124Z"
    ));
    testing::expect(stamp_before("2022-12-31T23:59:59Z", "2023-01-01T00:00:00Z"));
}
