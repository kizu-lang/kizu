fn (self: &var Lowerer) cleanups_from(depth: i64, include_error: bool, out: &var array::Array<Cleanup>) -> !void {
    return;
}

fn (self: &var Lowerer) error_cleanups(out: &var array::Array<Cleanup>) -> !void {
    return self.cleanups_from(0, true, out);
}

fn (self: &var Lowerer) normal_cleanups(out: &var array::Array<Cleanup>) -> !void {
    return self.cleanups_from(0, false, out);
}

fn (self: &var Lowerer) emit_normal_cleanups() -> !void {
    return;
