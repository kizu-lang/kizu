import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ownership;
import compiler::internal::typ;
import std::arena;
import std::array;

// Mechanical port of internal/ir/defer.go: the lexical cleanup frames, the
// `defer` / `errdefer` statements that record one cleanup each, and the
// emission of the recorded cleanups at block ends, returns, loop exits and
// `try` propagation. The Go `Cleanup.Args` is a run of the module's
// cleanup_args pool, so a Cleanup stays a copy value; the Go op string is an
// `Op` plus the symbol a `call.<f>` cleanup carries in `operand`.

/// Opens a lexical cleanup frame for one block, the Go `pushDeferFrame`, and
/// returns its index.
fn (self: &var Lowerer) push_defer_frame() -> !i64 {
    try self.defer_frames.append(self.allocator, array::new<Cleanup>(self.allocator));
    return self.defer_frames.len() - 1;
}

/// Closes the innermost lexical cleanup frame, the Go `popDeferFrame`.
fn (self: &var Lowerer) pop_defer_frame() -> void {
    if self.defer_frames.pop() |frame| {
        frame.deinit(self.allocator);
    }
    return;
}

/// Records a checked deferred cleanup without emitting it now, the Go
/// `lowerDeferStmt`.
fn (self: &var Lowerer) lower_defer_stmt(tree: &var ast::Ast, statement: ast::DeferStmt) -> !?diagnostic::Diagnostic {
    return self.record_cleanup(tree, statement.expr, false);
}

/// Records an error-path cleanup into the shared cleanup stack, the Go
/// `lowerErrDeferStmt`.
fn (self: &var Lowerer) lower_err_defer_stmt(tree: &var ast::Ast, statement: ast::ErrDeferStmt) -> !?diagnostic::Diagnostic {
    return self.record_cleanup(tree, statement.expr, true);
}

/// Resolves a cleanup expression and registers it in the current frame, the
/// Go `recordCleanup`. on_error marks errdefer entries that run only on
/// error-return paths.
fn (self: &var Lowerer) record_cleanup(tree: &var ast::Ast, expression: ast::Expression, on_error: bool) -> !?diagnostic::Diagnostic {
    let allocator = self.allocator;
    var cleanup = empty_cleanup();
    if try self.cleanup_from_expr(tree, expression, &var cleanup) |failed| {
        return move failed;
    }
    cleanup.on_error = on_error;
    cleanup.receiver = cleanup_receiver(tree, expression);
    let frame = self.defer_frames.len() - 1;
    if self.defer_frames.at_mut(frame) |entries| {
        try entries.append(allocator, cleanup);
    }
    return null;
}

/// Reads the expression naming the one owner a deferred call consumes, the
/// Go `cleanupReceiver`: the receiver of a method call, or the binding an
/// argument marks `move`. The ownership checker names the same node when it
/// retires an errdefer, which is how the two agree on which entry it was. A
/// call that consumes nothing has none.
fn cleanup_receiver(tree: &ast::Ast, expression: ast::Expression) -> ?arena::Handle<ast::ExpressionNode> {
    let call = ownership::call_expr(tree, deferred_call_expr(tree, expression)) orelse return null;
    if ownership::field_expr(tree, call.callee) |field| {
        if !field.namespace {
            return field.receiver.node;
        }
    }
    var index = 0;
    while ownership::arg_at(tree, call.args, index) |arg| {
        index = index + 1;
        if ownership::move_expr(tree, arg) |marker| {
            return marker.value.node;
        }
    }
    return null;
}

/// Returns the expression a defer statement registers, under whatever
/// markers it was written with, the Go `deferredCall` before its cast.
fn deferred_call_expr(tree: &ast::Ast, expression: ast::Expression) -> ast::Expression {
    var current = expression;
    while ast::marker_value(tree, current) |inner| {
        current = inner;
    }
    return current;
}

/// Converts a deferred call into a void cleanup, the Go `cleanupFromExpr`:
/// the callee resolved now, the arguments read now, the call emitted at each
/// exit.
///
/// The arguments are read where the defer is written, not where it runs, so
/// what runs at scope exit is settled at the point the source names. The one
/// exception is an owner the call consumes -- a by-value receiver, or an
/// argument marked `move` -- which stays in its slot until the exit that
/// runs the call, since the frame may still use it until then and the exit
/// is what hands it over (load_cleanup_args).
fn (self: &var Lowerer) cleanup_from_expr(
    tree: &var ast::Ast,
    expression: ast::Expression,
    out: &var Cleanup
) -> !?diagnostic::Diagnostic {
    let call = ownership::call_expr(tree, deferred_call_expr(tree, expression)) orelse
        return try self.fail0("ir error: defer expects a void call");
    if ownership::field_expr(tree, call.callee) |field| {
        if !field.namespace {
            let ident = ownership::ident_expr(tree, field.receiver) orelse
                return try self.fail0("ir error: defer method receiver must be a local");
            let name = try self.text_name(tree, ident.name);
            let receiver = self.envs.get(self.env, name) orelse
                return try self.fail1(tree, "ir error: undefined defer receiver `%s`", Arg::Str(name));
            let method = try self.text_name(tree, field.name);
            var params = no_params();
            if try self.impl_method_callee_name(receiver.type_name, method) |method_name| {
                if self.signature_named(method_name) |signature| {
                    params = params_after_self(signature);
                }
            }
            var args = array::new<Value>(self.allocator);
            defer args.deinit(self.allocator);
            try args.append(self.allocator, receiver);
            if try self.lower_cleanup_args(tree, params, call.args, &var args) |failed| {
                return move failed;
            }
            return self.cleanup_from_method(tree, receiver, method, &args, out);
        }
    }
    let name = try self.function_callee_name(tree, call.callee) orelse
        return try self.fail1(tree, "ir error: unsupported defer callee `%s`", Arg::Str(try self.callee_name_text(tree, call.callee)));
    let signature = self.signature_named(name) orelse
        return try self.fail1(tree, "ir error: unsupported defer callee `%s`", Arg::Str(name));
    var args = array::new<Value>(self.allocator);
    defer args.deinit(self.allocator);
    if try self.lower_cleanup_args(tree, params_of(signature), call.args, &var args) |failed| {
        return move failed;
    }
    return self.cleanup_from_function(tree, name, &args, out);
}

/// Spells a callee expression for a diagnostic, the Go `call.Callee.String()`.
fn (self: &var Lowerer) callee_name_text(tree: &ast::Ast, callee: ast::Expression) -> !Name {
    let rendered = try ast::render_expression(self.allocator, tree, callee);
    return self.module.names.intern_owned(move rendered);
}

/// Lowers a deferred call's arguments at the types the callee declares, the
/// way a direct call does, the Go `lowerCleanupArgs`: a borrow parameter
/// takes the caller's storage, a value parameter the value read now. A
/// `move x` argument is the slot x lives in, loaded at the exit that runs
/// the call.
fn (self: &var Lowerer) lower_cleanup_args(
    tree: &var ast::Ast,
    params: ParamsView,
    args: ast::ExpressionList,
    out: &var array::Array<Value>
) -> !?diagnostic::Diagnostic {
    var index = 0;
    while ownership::arg_at(tree, args, index) |arg| {
        let position = index;
        index = index + 1;
        if ownership::move_expr(tree, arg) |marker| {
            if ownership::ident_expr(tree, marker.value) |ident| {
                let name = try self.text_name(tree, ident.name);
                if self.envs.get(self.env, name) |slot| {
                    try out.append(self.allocator, slot);
                    continue;
                }
            }
        }
        var want = empty_name();
        if self.view_param(params, position) |param| {
            want = param.type_name;
        }
        var value = empty_value();
        if try self.lower_contextual_expr(tree, arg, want, &var value) |failed| {
            return move failed;
        }
        try out.append(self.allocator, value);
    }
    return null;
}

/// Resolves a deferred call to a declared function or an extern one, the
/// Go `cleanupFromFunction`. The signature says the call returns void; a std
/// primitive with no declared signature is not a thing a defer can name.
fn (self: &var Lowerer) cleanup_from_function(
    tree: &var ast::Ast,
    name: Name,
    args: &array::Array<Value>,
    out: &var Cleanup
) -> !?diagnostic::Diagnostic {
    let signature = self.signature_named(name) orelse
        return try self.fail1(tree, "ir error: unsupported defer callee `%s`", Arg::Str(name));
    let returned = self.signature_return(signature);
    if !self.name_is(returned, "void") {
        return try self.fail1(tree, "ir error: defer call must return void, got %s", Arg::Str(returned));
    }
    var cleanup = try self.cleanup_of(Op::Call, name, args, self.owner_loads(args, params_of(signature)));
    if self.extern_decl(name) |external| {
        cleanup.operand = external.name;
        cleanup.extern_abi = external.abi;
        cleanup.extern_name = external.name;
    }
    out.* = cleanup;
    return null;
}

/// Marks the arguments a cleanup loads at exit, the Go `ownerLoads`: a slot
/// whose parameter takes the value itself. A slot handed to a `&` / `&var`
/// parameter is what that parameter wants and is passed as it is. With no
/// signature every slot is an owner, which is what a std container's
/// runtime release takes.
fn (self: &Lowerer) owner_loads(args: &array::Array<Value>, params: ParamsView) -> i64 {
    var loads = 0;
    var bit = 1;
    var index = 0;
    while args.get(index) |arg| {
        var load = self.is_mutable_reference_type(arg.type_name);
        if load {
            if self.view_param(params, index) |param| {
                if self.module.names.starts_with(param.type_name, "&") {
                    load = false;
                }
            }
        }
        if load {
            loads = loads + bit;
        }
        bit = bit * 2;
        index = index + 1;
    }
    return loads;
}

/// Names what one std container's cleanup needs, the Go `containerCleanup`:
/// the std type its wrapper is declared on, the runtime op a shallow cleanup
/// lowers to, and the type argument that decides which of the two runs.
struct ContainerCleanup {
    name: []u8,
    shallow_op: Op,
    type_arg: Name,
    // The type argument whose values the container holds and would have to
    // release: the element for an array, box, or arena, the value for a map.
    // type_arg spells the whole instantiation, which for a map is `K, V` and
    // names no type at all.
    owner_arg: Name,
    // Whether the runtime op takes the allocator the release names. Every
    // container header is now the value, and none of them keeps an allocator,
    // so every op is handed one; the field is what says a container's release
    // reads it (ADR-0132).
    shallow_names_allocator: bool,
}

/// Reports the cleanup shape of a std container type, the Go
/// `stdContainerCleanup`, and null for anything else.
fn (self: &var Lowerer) std_container_cleanup(receiver_type: Name) -> !?ContainerCleanup {
    if try self.array_element_type(receiver_type) |elem| {
        return ContainerCleanup {
            name: "std::array::Array",
            shallow_op: Op::ArrayDeinit,
            type_arg: elem,
            owner_arg: elem,
            shallow_names_allocator: true
        };
    }
    var map_key = empty_name();
    if try self.map_key_value_type(receiver_type, &var map_key) |value| {
        return ContainerCleanup {
            name: "std::map::Map",
            shallow_op: Op::MapDeinit,
            type_arg: try self.module.names.joined(map_key, ", ", value),
            owner_arg: value,
            shallow_names_allocator: true
        };
    }
    if try self.box_element_type(receiver_type) |elem| {
        return ContainerCleanup {
            name: "std::mem::Box",
            shallow_op: Op::BoxDeinit,
            type_arg: elem,
            owner_arg: elem,
            shallow_names_allocator: true
        };
    }
    let elem = try self.arena_element_type(receiver_type);
    if !self.name_is(elem, "unknown") {
        return ContainerCleanup {
            name: "std::arena::Arena",
            shallow_op: Op::ArenaDeinit,
            type_arg: elem,
            owner_arg: elem,
            shallow_names_allocator: true
        };
    }
    return null;
}

/// Returns a cleanup that runs op over args, the Go `Cleanup{Op: op, Args:
/// args, Loads: loads}`, with the arguments filed in the module's pool.
fn (self: &var Lowerer) cleanup_of(op: Op, operand: Name, args: &array::Array<Value>, loads: i64) -> !Cleanup {
    let start = try self.module.add_cleanup_args(self.allocator, args);
    return Cleanup {
        op: op,
        operand: operand,
        args_start: start,
        args_len: args.len(),
        loads: loads,
        extern_abi: empty_name(),
        extern_name: empty_name(),
        on_error: false,
        receiver: null
    };
}

/// Returns the record `std_container_call_op` fills, pointing at the
/// scratch signature until it does.
fn (self: &Lowerer) cleanup_call_op_slot() -> ContainerCallOp {
    return ContainerCallOp { symbol: empty_name(), signature: self.scratch_signature };
}

/// Resolves one receiver.method() cleanup into an IR instruction, the Go
/// `cleanupFromMethod`. args holds the receiver first, then the arguments
/// the statement carried.
fn (self: &var Lowerer) cleanup_from_method(
    tree: &var ast::Ast,
    receiver: Value,
    method: Name,
    args: &array::Array<Value>,
    out: &var Cleanup
) -> !?diagnostic::Diagnostic {
    let receiver_type = try self.deref_type(receiver.type_name);
    if try self.std_container_cleanup(receiver_type) |container| {
        if self.name_is(method, typ::cleanup_method()) {
            // A container whose contents own something releases them first,
            // and that loop lives in the std wrapper rather than in a runtime
            // op: the cleanup calls its instance exactly like a direct call
            // would. Plain contents have no loop to run, so they keep the
            // runtime op.
            if !self.is_owner_type(container.owner_arg) {
                var carried = array::new<Value>(self.allocator);
                defer carried.deinit(self.allocator);
                try carried.append(self.allocator, receiver);
                if container.shallow_names_allocator {
                    var index = 1;
                    while args.get(index) |arg| {
                        index = index + 1;
                        try carried.append(self.allocator, arg);
                    }
                }
                out.* = try self.cleanup_of(container.shallow_op, empty_name(), &carried, self.owner_loads(&carried, no_params()));
                return null;
            }
            let container_name = container.name;
            var resolved = self.cleanup_call_op_slot();
            if try self.std_container_call_op(tree, container_name, method, container.type_arg, &var resolved) |failed| {
                return move failed;
            }
            out.* = try self.cleanup_of(Op::Call, resolved.symbol, args, self.owner_loads(args, no_params()));
            return null;
        }
    }
    if try self.impl_method_callee_name(receiver.type_name, method) |method_name| {
        return self.cleanup_from_function(tree, method_name, args, out);
    }
    return try self.fail1(tree, "ir error: unknown cleanup method `%s`", Arg::Str(method));
}

/// Appends all active cleanups that run on an error-return path, the Go
/// `errorCleanups`, including both defer and errdefer entries, in execution
/// order.
fn (self: &var Lowerer) error_cleanups(out: &var array::Array<Cleanup>) -> !void {
    return self.cleanups_from(0, true, out);
}

/// Appends active defer cleanups for a success exit, the Go
/// `normalCleanups`. errdefer entries are skipped because they do not run
/// when the block exits normally.
fn (self: &var Lowerer) normal_cleanups(out: &var array::Array<Cleanup>) -> !void {
    return self.cleanups_from(0, false, out);
}

/// Appends cleanups from the requested frame depth inward, the Go
/// `cleanupsFrom`. When include_error is false, errdefer (error-path) entries
/// are skipped.
fn (self: &var Lowerer) cleanups_from(depth: i64, include_error: bool, out: &var array::Array<Cleanup>) -> !void {
    var frame = self.defer_frames.len();
    while frame > depth {
        frame = frame - 1;
        if self.defer_frames.at(frame) |entries| {
            var index = entries.len();
            while index > 0 {
                index = index - 1;
                if entries.get(index) |cleanup| {
                    if cleanup.on_error and !include_error {
                        continue;
                    }
                    try out.append(self.allocator, cleanup);
                }
            }
        }
    }
    return;
}

/// Emits success-path cleanups before a normal function exit, the Go
/// `emitNormalCleanups`.
fn (self: &var Lowerer) emit_normal_cleanups() -> !void {
    var cleanups = array::new<Cleanup>(self.allocator);
    defer cleanups.deinit(self.allocator);
    try self.normal_cleanups(&var cleanups);
    return self.emit_cleanups(&cleanups);
}

/// Emits error-path cleanups before an error-return exit, the Go
/// `emitErrorCleanups` over `RetiredErrDefersForReturn(stmt)`, minus the
/// ones a move retired before it.
fn (self: &var Lowerer) emit_error_cleanups_for_return(statement: ast::Statement) -> !void {
    var cleanups = array::new<Cleanup>(self.allocator);
    defer cleanups.deinit(self.allocator);
    try self.error_cleanups(&var cleanups);
    try self.retire_cleanups(CleanupExit::Return(statement), &var cleanups);
    return self.emit_cleanups(&cleanups);
}

/// Drops the errdefer cleanups whose receiver was moved before this try
/// expression, the Go `retireCleanups` over `RetiredErrDefersForTry(expr)`.
fn (self: &var Lowerer) retire_cleanups_for_try(expression: ast::Expression, cleanups: &var array::Array<Cleanup>) -> !void {
    return self.retire_cleanups(CleanupExit::Try(expression), cleanups);
}

/// Names the exit an errdefer retirement is asked about: the return
/// statement or the try expression the ownership checker recorded the
/// retired receivers under.
union CleanupExit {
    Return(ast::Statement),
    Try(ast::Expression),
}

/// Reports whether the ownership checker retired the errdefer on receiver
/// before exit, the Go `moved[cleanup.Receiver]` test.
fn (self: &Lowerer) retired_before(exit: CleanupExit, receiver: arena::Handle<ast::ExpressionNode>) -> bool {
    match exit {
        Return(statement) => return self.retired_for_return(statement, receiver),
        Try(expression) => return self.retired_for_try(expression, receiver),
    }
}

/// Reports whether one cleanup is an errdefer the checker retired before
/// exit: only an errdefer retires, and only one written on a local names a
/// receiver to retire by.
fn (self: &Lowerer) cleanup_retired(exit: CleanupExit, cleanup: &Cleanup) -> bool {
    if !cleanup.on_error {
        return false;
    }
    let receiver = cleanup.receiver orelse return false;
    return self.retired_before(exit, receiver);
}

/// Drops, in place, the errdefer cleanups whose receiver was moved before
/// this error exit, the Go `retireCleanups`. The ownership checker decides
/// which; lowering obeys, so the move rule has one implementation
/// (ADR-0114).
fn (self: &Lowerer) retire_cleanups(exit: CleanupExit, cleanups: &var array::Array<Cleanup>) -> !void {
    var kept = 0;
    var index = 0;
    while cleanups.get(index) |cleanup| {
        index = index + 1;
        if self.cleanup_retired(exit, &cleanup) {
            continue;
        }
        try cleanups.set(kept, cleanup);
        kept = kept + 1;
    }
    while cleanups.len() > kept {
        let _ = cleanups.pop();
    }
    return;
}

/// Emits normal fallthrough cleanups for one lexical block, the Go
/// `emitCleanupFrame`. errdefer entries are skipped because the block exited
/// without an error.
fn (self: &var Lowerer) emit_cleanup_frame(frame: i64) -> !void {
    var cleanups = array::new<Cleanup>(self.allocator);
    defer cleanups.deinit(self.allocator);
    if self.defer_frames.at(frame) |entries| {
        var index = entries.len();
        while index > 0 {
            index = index - 1;
            if entries.get(index) |cleanup| {
                if cleanup.on_error {
                    continue;
                }
                try cleanups.append(self.allocator, cleanup);
            }
        }
    }
    return self.emit_cleanups(&cleanups);
}

/// Appends cleanup instructions to the current block, the Go `emitCleanups`.
/// An owner the cleanup consumes lives in a slot until here, so the slot is
/// loaded at the exit that runs it.
fn (self: &var Lowerer) emit_cleanups(cleanups: &array::Array<Cleanup>) -> !void {
    var index = 0;
    while cleanups.get(index) |cleanup| {
        index = index + 1;
        var args = array::new<Value>(self.allocator);
        defer args.deinit(self.allocator);
        try self.load_cleanup_args(cleanup, &var args);
        let _ = try self.emit_with(cleanup.op, cleanup.operand, self.common.void_type, empty_name(), &args);
        if !is_empty(cleanup.extern_abi) {
            if self.last_instr() |instr| {
                self.module.set_extern_call(instr, cleanup.extern_abi, cleanup.extern_name);
            }
        }
    }
    return;
}

/// Appends a cleanup's arguments with the slot-backed owners it consumes
/// loaded into values and every other argument as it is, the Go
/// `loadCleanupArgs`.
fn (self: &var Lowerer) load_cleanup_args(cleanup: Cleanup, out: &var array::Array<Value>) -> !void {
    var index = 0;
    while self.module.cleanup_arg(cleanup, index) |arg| {
        let position = index;
        index = index + 1;
        if cleanup_loads(cleanup, position) {
            let elem = try self.deref_type(arg.type_name);
            let loaded = try self.emit1(Op::RefLoad, elem, arg);
            try out.append(self.allocator, loaded);
            continue;
        }
        try out.append(self.allocator, arg);
    }
    return;
}

/// Returns a copy of cleanup whose arguments are already loaded, the Go
/// `cleanups[index].Args = l.loadCleanupArgs(...)` at a try: the loaded
/// run is filed anew, so the frame's own entry keeps its slots for the
/// exits still to come.
fn (self: &var Lowerer) loaded_cleanup(cleanup: Cleanup) -> !Cleanup {
    var args = array::new<Value>(self.allocator);
    defer args.deinit(self.allocator);
    try self.load_cleanup_args(cleanup, &var args);
    var loaded = cleanup;
    loaded.args_start = try self.module.add_cleanup_args(self.allocator, &args);
    loaded.args_len = args.len();
    loaded.loads = 0;
    return loaded;
}

/// Returns an empty cleanup record, the slot a resolver fills.
fn empty_cleanup() -> Cleanup {
    return Cleanup {
        op: Op::Id,
        operand: empty_name(),
        args_start: 0,
        args_len: 0,
        loads: 0,
        extern_abi: empty_name(),
        extern_name: empty_name(),
        on_error: false,
        receiver: null
    };
}
