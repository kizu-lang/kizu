import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::typ;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// Mechanical port of internal/ir/verify.go: the rules every backend assumes
// of a module and none of them checks in full. Go reports each failure as an
// error wrapping ErrVerify; here the same text, `ir verify error: ...`, comes
// back as one diagnostic without a span. Go keys its sets and maps by the
// Go string of a value or block name; here they are keyed by the bytes of
// the interned Name, read through the module's NameTable.

/// Reports the first way a module is not well formed, the Go `Verify`.
pub fn verify(allocator: Allocator, module: &Module) -> !?diagnostic::Diagnostic {
    var types = typ::new(allocator);
    defer types.deinit(allocator);
    return verify_with_types(allocator, module, &var types);
}

/// Verifies module using the type table that produced it, the Go
/// `verifyWithTypes`.
fn verify_with_types(allocator: Allocator, module: &Module, types: &var typ::Table) -> !?diagnostic::Diagnostic {
    var verifier = Verifier {
        allocator: allocator,
        params: map::new<[]u8, Function>(allocator),
        fn_name: empty_name(),
        fn_return: empty_name(),
        block_name: empty_name()
    };
    defer verifier.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let name = module.function_name(function);
        let retained = name_text(&module.names, name);
        let bytes = retained.as_bytes();
        try verifier.params.insert(allocator, bytes, function);
    }
    index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        if try verifier.verify_function(module, types, function) |failed| {
            return move failed;
        }
    }
    return null;
}

/// Holds what a rule needs and the position it is reading, the Go
/// `verifier`: the functions a call can be checked against by name, and the
/// function and block names every message starts with. The module and the
/// type table are passed to each rule rather than held, and the block set a
/// terminator is checked against lives in the function check.
struct Verifier {
    allocator: Allocator,
    params: map::Map<[]u8, Function>,
    fn_name: Name,
    fn_return: Name,
    block_name: Name
}

/// Is one value a verify failure interpolates: a Name for `%s`, an integer
/// for `%d`; None fills the arguments a shorter format leaves unused.
union VerifyArg {
    Str(Name),
    Int(i64),
    None,
}

/// Checks one function's blocks and the SSA property across them, the Go
/// `function`.
fn (self: &var Verifier) verify_function(module: &Module, types: &var typ::Table, function: Function) -> !?diagnostic::Diagnostic {
    let node = module.function_nodes.at(function.node);
    self.fn_name = node.name;
    self.fn_return = node.return_type;
    var blocks = try block_index(self.allocator, module, function);
    defer blocks.deinit(self.allocator);
    var index = 0;
    while node.blocks.get(index) |block| {
        index = index + 1;
        self.block_name = module.block_name(block);
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            if try self.verify_instr(module, types, instr) |failed| {
                return move failed;
            }
        }
        if try self.verify_terminator(module, types, &blocks, block) |failed| {
            return move failed;
        }
    }
    var preds = try block_predecessors(self.allocator, module, function, &blocks);
    defer preds.deinit(self.allocator);
    if try self.phi_incoming_matches_predecessors(module, function, &blocks, &preds) |failed| {
        return move failed;
    }
    if try self.phi_incoming_dominates(module, function, &blocks, &preds) |failed| {
        return move failed;
    }
    return self.values_dominate_uses(module, function, &blocks, &preds);
}

/// Numbers a function's blocks by their position, the Go `verifier.at`. Every
/// rule below keys on that position rather than the name: a position indexes
/// an array, so one map per function replaces one map per rule.
struct BlockIndex {
    at: map::Map<[]u8, i64>,
    names: array::Array<Name>,
    handles: array::Array<Block>
}

/// Builds the index for one function.
fn block_index(allocator: Allocator, module: &Module, function: Function) -> !BlockIndex {
    var out = BlockIndex {
        at: map::new<[]u8, i64>(allocator),
        names: array::new<Name>(allocator),
        handles: array::new<Block>(allocator)
    };
    errdefer out.deinit(allocator);
    let node = module.function_nodes.at(function.node);
    var index = 0;
    while node.blocks.get(index) |block| {
        let name = module.block_name(block);
        let retained = name_text(&module.names, name);
        let bytes = retained.as_bytes();
        try out.at.insert(allocator, bytes, index);
        try out.names.append(allocator, name);
        try out.handles.append(allocator, block);
        index = index + 1;
    }
    return move out;
}

/// Returns the position of the block name spells, null when the function has
/// no such block.
fn (self: &BlockIndex) position_of(module: &Module, name: Name) -> ?i64 {
    let retained = name_text(&module.names, name);
    let bytes = retained.as_bytes();
    return self.at.get(bytes);
}

/// Names the block standing at position.
fn (self: &BlockIndex) name_at(position: i64) -> Name {
    return self.names.get_or_panic(position);
}

/// The number of blocks the index covers.
fn (self: &BlockIndex) len() -> i64 {
    return self.names.len();
}

/// Returns the block standing at position.
fn (self: &BlockIndex) block_at(position: i64) -> Block {
    return self.handles.get_or_panic(position);
}

/// Checks the declared slot an instruction fills, if it fills one, the Go
/// `instr`.
fn (self: &Verifier) verify_instr(module: &Module, types: &var typ::Table, instr: Instr) -> !?diagnostic::Diagnostic {
    let node = module.instrs.at(instr.node);
    match node.op {
        StructNew => return self.struct_literal(module, node),
        UnionNew => return self.union_payload(module, node),
        ErrorOk => return self.success_wrap(module, types, node),
        CallIndirect => return self.verify_indirect_call(module, types, node),
        _ => {},
    }
    if direct_callee(node.op, node.operand) |callee| {
        return self.verify_call(module, node, callee);
    }
    return null;
}

/// Checks the ABI signature retained beside a call whose declaration cannot
/// be named, the Go `indirectCall`.
fn (self: &Verifier) verify_indirect_call(
    module: &Module,
    types: &var typ::Table,
    node: &InstrNode
) -> !?diagnostic::Diagnostic {
    let callee = node.args.get(0) orelse
        return try self.failure(
            module, "call.indirect has no callee",
            VerifyArg::None, VerifyArg::None, VerifyArg::None, VerifyArg::None,
            VerifyArg::None, VerifyArg::None, VerifyArg::None);
    let callee_text = name_text(&module.names, callee.type_name);
    let callee_bytes = callee_text.as_bytes();
    let parsed = try types.parse(callee_bytes);
    var declared_count = -1;
    match typ::root_node(types, parsed) {
        Func(function) => {
            declared_count = function.params.len();
        },
        _ => return try self.failure(
            module, "call.indirect callee has type %s, not a function pointer",
            VerifyArg::Str(callee.type_name), VerifyArg::None, VerifyArg::None,
            VerifyArg::None, VerifyArg::None, VerifyArg::None, VerifyArg::None),
    }
    let arg_count = node.args.len() - 1;
    if node.call_params.len() != arg_count or declared_count != node.call_params.len() {
        return try self.failure(
            module, "call.indirect has %d args, %d ABI params, and %d declared params",
            VerifyArg::Int(arg_count), VerifyArg::Int(node.call_params.len()),
            VerifyArg::Int(declared_count), VerifyArg::None, VerifyArg::None,
            VerifyArg::None, VerifyArg::None);
    }
    var index = 0;
    while node.call_params.get(index) |param| {
        let got = node.args.get_or_panic(index + 1);
        if !argument_fits(module, param, got.type_name) {
            var position = try string::from_bytes(self.allocator, "call.indirect argument ");
            errdefer position.deinit(self.allocator);
            try fmt::append_i64(self.allocator, &var position, index);
            return try self.fail(module, move position, param.type_name, got.type_name);
        }
        index = index + 1;
    }
    return null;
}

/// Checks what a call hands to the function it names, the Go `call`.
fn (self: &Verifier) verify_call(module: &Module, node: &InstrNode, callee: Name) -> !?diagnostic::Diagnostic {
    let callee_text = name_text(&module.names, callee);
    let callee_bytes = callee_text.as_bytes();
    // A call to a symbol this module does not define, or with an arity the
    // lowerer built for an instruction rather than a function, has no
    // declaration here to check against.
    let declared = self.params.get(callee_bytes) orelse return null;
    let declared_node = module.function_nodes.at(declared.node);
    if declared_node.params.len() != node.args.len() {
        return null;
    }
    var index = 0;
    while declared_node.params.get(index) |param| {
        let got = node.args.get_or_panic(index);
        if !argument_fits(module, param, got.type_name) {
            var position = try string::from_bytes(self.allocator, "call ");
            errdefer position.deinit(self.allocator);
            try module.names.append_to(&var position, callee);
            try position.append_bytes(self.allocator, " argument ");
            try fmt::append_i64(self.allocator, &var position, index);
            return try self.fail(module, move position, param.type_name, got.type_name);
        }
        index = index + 1;
    }
    return null;
}

/// Reports whether a value of type got can fill param, the Go
/// `argumentFits`. It is the one slot not always filled by its own type: a
/// parameter read through an address also accepts the value that address is
/// taken of, which is what `Param.TakesAddressOf` names, and the address the
/// caller already holds, which a `&var T` binding is when the parameter asks
/// for `&T`; the verifier reads the module without interning, so the
/// dereference is compared as text.
fn argument_fits(module: &Module, param: Param, got: Name) -> bool {
    if same_name(param.type_name, got) {
        return true;
    }
    let param_text = name_text(&module.names, param.type_name);
    let param_bytes = param_text.as_bytes();
    let got_text = name_text(&module.names, got);
    let got_bytes = got_text.as_bytes();
    if lends_shared_borrow(param_bytes, got_bytes) {
        return true;
    }
    if param.passing != Passing::CopyAddress {
        return false;
    }
    let deref = deref_type_bytes(param_bytes);
    return mem::equal_bytes(deref, got_bytes);
}

/// Reports whether a `&var T` argument fills a `&T` parameter, the Go
/// `lendsSharedBorrow`. The two spell the same address and the callee may
/// only read through it, so handing over the one the caller already holds
/// costs no copy of what it names.
fn lends_shared_borrow(want: []u8, got: []u8) -> bool {
    if !mem::starts_with(want, "&") or mem::starts_with(want, "&var ") {
        return false;
    }
    if !mem::starts_with(got, "&var ") {
        return false;
    }
    return mem::equal_bytes(deref_type_bytes(want), deref_type_bytes(got));
}

/// Returns T for `&T` and `&var T`, and the spelling itself otherwise, the
/// Go `derefType` over bytes.
fn deref_type_bytes(name: []u8) -> []u8 {
    if mem::starts_with(name, "&var ") {
        return name[5..mem::len(name)];
    }
    if mem::starts_with(name, "&") {
        return name[1..mem::len(name)];
    }
    return name;
}

/// Checks what a struct literal puts in each declared field, the Go
/// `structLiteral`.
fn (self: &Verifier) struct_literal(module: &Module, node: &InstrNode) -> !?diagnostic::Diagnostic {
    let type_text = name_text(&module.names, node.result.type_name);
    let type_bytes = type_text.as_bytes();
    if module.structs.at(type_bytes) |declared_struct| {
        var index = 0;
        while node.fields.get(index) |field| {
            index = index + 1;
            var declared_index = 0;
            while declared_struct.fields.get(declared_index) |declared| {
                declared_index = declared_index + 1;
                if !same_name(declared.name, field.name) {
                    continue;
                }
                if !same_name(declared.type_name, field.value.type_name) {
                    var position = string::new(self.allocator);
                    errdefer position.deinit(self.allocator);
                    try module.names.append_to(&var position, node.result.type_name);
                    try position.append_bytes(self.allocator, ".");
                    try module.names.append_to(&var position, field.name);
                    return try self.fail(module, move position, declared.type_name, field.value.type_name);
                }
            }
        }
    }
    return null;
}

/// Checks what a union constructor carries in its variant, the Go
/// `unionPayload`.
fn (self: &Verifier) union_payload(module: &Module, node: &InstrNode) -> !?diagnostic::Diagnostic {
    let variant = module.union_variant(node.result.type_name, node.immediate) orelse return null;
    if is_empty(variant.payload) or node.args.len() != 1 {
        return null;
    }
    let arg = node.args.get_or_panic(0);
    if !same_name(variant.payload, arg.type_name) {
        var position = string::new(self.allocator);
        errdefer position.deinit(self.allocator);
        try module.names.append_to(&var position, node.result.type_name);
        try position.append_bytes(self.allocator, "::");
        try module.names.append_to(&var position, variant.name);
        try position.append_bytes(self.allocator, " payload");
        return try self.fail(module, move position, variant.payload, arg.type_name);
    }
    return null;
}

/// Checks the payload an error union's success carries, the Go
/// `successWrap`. The success type is compared by its rendered spelling, as
/// the Go `errorUnionParts` hands it back as text.
fn (self: &Verifier) success_wrap(module: &Module, types: &var typ::Table, node: &InstrNode) -> !?diagnostic::Diagnostic {
    if is_empty(node.result.type_name) {
        return null;
    }
    let type_text = name_text(&module.names, node.result.type_name);
    let type_bytes = type_text.as_bytes();
    let parsed = try types.parse(type_bytes);
    let parts = error_union_parts_of(types, parsed) orelse return null;
    if node.args.len() != 1 {
        return null;
    }
    var success = try typ::render(self.allocator, types, parts.ok);
    defer success.deinit(self.allocator);
    let arg = node.args.get_or_panic(0);
    let arg_text = name_text(&module.names, arg.type_name);
    let success_bytes = success.as_bytes();
    let arg_bytes = arg_text.as_bytes();
    if !mem::equal_bytes(success_bytes, arg_bytes) {
        var position = try string::from_bytes(self.allocator, "success wrapped as ");
        errdefer position.deinit(self.allocator);
        try module.names.append_to(&var position, node.result.type_name);
        return try self.fail_text(module, move position, &success, arg_text);
    }
    return null;
}

/// Is the structure of one parsed error union spelling: whether it names an
/// error set, and the success type it carries.
struct ParsedErrorUnion {
    has_err: bool,
    ok: typ::Type
}

/// Returns the parts of a parsed error union, null for any other type, the
/// Go `typ.ErrorUnionParts` on a parsed tree.
fn error_union_parts_of(types: &typ::Table, value: typ::Type) -> ?ParsedErrorUnion {
    match typ::root_node(types, value) {
        ErrorUnion(node) => {
            var has_err = false;
            if node.err |_| {
                has_err = true;
            }
            return ParsedErrorUnion { has_err: has_err, ok: typ::child_type(value, node.ok) };
        },
        _ => {},
    }
    return null;
}

/// Checks that a block ends, that it names blocks that exist, and that what
/// it returns is what its function declared, the Go `terminator`.
fn (self: &Verifier) verify_terminator(
    module: &Module,
    types: &var typ::Table,
    blocks: &BlockIndex,
    block: Block
) -> !?diagnostic::Diagnostic {
    let term = module.block_terminator(block);
    if term.op == TermOp::None {
        return try self.failure(
            module, "block %s has no terminator",
            VerifyArg::Str(self.block_name), VerifyArg::None, VerifyArg::None, VerifyArg::None,
            VerifyArg::None, VerifyArg::None, VerifyArg::None
        );
    }
    var position = 0;
    while term.successor(position) |target| {
        position = position + 1;
        if blocks.position_of(module, target) |_| {
            continue;
        } else {
            return try self.failure(
                module, "block %s branches to %s, which does not exist",
                VerifyArg::Str(self.block_name), VerifyArg::Str(target), VerifyArg::None,
                VerifyArg::None, VerifyArg::None, VerifyArg::None, VerifyArg::None
            );
        }
    }
    let got = term.value.type_name;
    if term.op != TermOp::Return or is_empty(got) or try absorbs_error_set(module, types, self.fn_return, got) {
        return null;
    }
    if !same_name(self.fn_return, got) and
        !fills_nullable_pointer(module, self.fn_return, got) {
        let position_text = try string::from_bytes(self.allocator, "return value");
        return try self.fail(module, move position_text, self.fn_return, got);
    }
    return null;
}

/// Reports whether a `ptr<T>` fills a `?ptr<T>` slot. The two spell the same
/// machine value and the non-null one is a subset of the nullable one, so
/// widening is always sound.
fn fills_nullable_pointer(module: &Module, want: Name, got: Name) -> bool {
    let want_retained = name_text(&module.names, want);
    let want_bytes = want_retained.as_bytes();
    if !mem::starts_with(want_bytes, "?ptr<") {
        return false;
    }
    let got_retained = name_text(&module.names, got);
    let got_bytes = got_retained.as_bytes();
    if mem::len(want_bytes) != mem::len(got_bytes) + 1 {
        return false;
    }
    return mem::equal_bytes(want_bytes[1..mem::len(want_bytes)], got_bytes);
}

/// Parses the IR spellings before asking the structural type query, the Go
/// `absorbsErrorSet` with `typ.AbsorbsErrorSet` inlined: `!T` declares no
/// error set, so an `E!T` reaching it arrives with E absorbed, while a
/// declared `E!T` named the one set it takes and absorbs nothing. Go answers
/// false for a spelling that does not parse; an empty spelling is the one
/// such case a lowered module holds, and is answered here before parsing.
fn absorbs_error_set(module: &Module, types: &var typ::Table, want: Name, got: Name) -> !bool {
    if is_empty(want) or is_empty(got) {
        return false;
    }
    let want_text = name_text(&module.names, want);
    let want_bytes = want_text.as_bytes();
    let want_type = try types.parse(want_bytes);
    let got_text = name_text(&module.names, got);
    let got_bytes = got_text.as_bytes();
    let got_type = try types.parse(got_bytes);
    let want_parts = error_union_parts_of(types, want_type) orelse return false;
    if want_parts.has_err {
        return false;
    }
    let got_parts = error_union_parts_of(types, got_type) orelse return false;
    return got_parts.has_err and typ::equal(types, got_parts.ok, types, want_parts.ok);
}

/// Names one position that holds a value of a type its declaration did not
/// ask for, the Go `fail`. Every type rule reports through here so the
/// message reads the same.
fn (self: &Verifier) fail(module: &Module, position: string::String, want: Name, got: Name) -> !diagnostic::Diagnostic {
    let want_text = name_text(&module.names, want);
    let got_text = name_text(&module.names, got);
    return self.fail_text(module, move position, want_text, got_text);
}

/// Builds the `fail` message from the spellings of the two types, for the
/// rule whose declared type is rendered rather than interned.
fn (self: &Verifier) fail_text(
    module: &Module,
    position: string::String,
    want: &string::String,
    got: &string::String
) -> !diagnostic::Diagnostic {
    defer position.deinit(self.allocator);
    var out = try string::from_bytes(self.allocator, "ir verify error: ");
    defer out.deinit(self.allocator);
    try module.names.append_to(&var out, self.fn_name);
    try out.append_bytes(self.allocator, ": ");
    try out.append_string(self.allocator, &position);
    try out.append_bytes(self.allocator, " in block ");
    try module.names.append_to(&var out, self.block_name);
    try out.append_bytes(self.allocator, " is ");
    try out.append_string(self.allocator, got);
    try out.append_bytes(self.allocator, ", declared ");
    try out.append_string(self.allocator, want);
    let text = out.as_bytes();
    return diagnostic::from_text(self.allocator, diagnostic::Severity::Error, ast::zero_span(), text);
}

/// Builds one verify failure from a Go format and its arguments in order,
/// the `fmt.Errorf("%w: %s: ...", ErrVerify, v.fn.Name, ...)` of every rule
/// that is not a type rule: the ErrVerify prefix and the function name are
/// written first, then `%s` takes a Name and `%d` an integer. A format with
/// fewer than seven verbs passes None for the rest.
fn (self: &Verifier) failure(
    module: &Module,
    format: []u8,
    a: VerifyArg,
    b: VerifyArg,
    c: VerifyArg,
    d: VerifyArg,
    e: VerifyArg,
    f: VerifyArg,
    g: VerifyArg
) -> !diagnostic::Diagnostic {
    var out = try string::from_bytes(self.allocator, "ir verify error: ");
    defer out.deinit(self.allocator);
    try module.names.append_to(&var out, self.fn_name);
    try out.append_bytes(self.allocator, ": ");
    var used = 0;
    var index = 0;
    while index < mem::len(format) {
        let byte = format[index];
        if byte == cast<u8>(37) and index + 1 < mem::len(format) {
            if used == 0 {
                try append_verify_arg(self.allocator, &var out, module, a);
            }
            if used == 1 {
                try append_verify_arg(self.allocator, &var out, module, b);
            }
            if used == 2 {
                try append_verify_arg(self.allocator, &var out, module, c);
            }
            if used == 3 {
                try append_verify_arg(self.allocator, &var out, module, d);
            }
            if used == 4 {
                try append_verify_arg(self.allocator, &var out, module, e);
            }
            if used == 5 {
                try append_verify_arg(self.allocator, &var out, module, f);
            }
            if used == 6 {
                try append_verify_arg(self.allocator, &var out, module, g);
            }
            used = used + 1;
            index = index + 2;
        } else {
            try out.append_byte(self.allocator, byte);
            index = index + 1;
        }
    }
    let text = out.as_bytes();
    return diagnostic::from_text(self.allocator, diagnostic::Severity::Error, ast::zero_span(), text);
}

fn append_verify_arg(allocator: Allocator, out: &var string::String, module: &Module, arg: VerifyArg) -> !void {
    match arg {
        Str(name) => return module.names.append_to(out, name),
        Int(value) => return fmt::append_i64(allocator, out, value),
        None => return,
    }
}

/// Checks the other half of what LLVM's verifier asks of a phi, the Go
/// `phiIncomingMatchesPredecessors`: one incoming for each block that jumps
/// to the phi's block, and none from a block that does not. An incoming from
/// a block that never reaches here reads a value on an edge that does not
/// exist, and a predecessor with no incoming leaves the phi undefined on an
/// edge that does.
///
/// An edge out of an unreachable block is still an edge, so it is still
/// counted. phi_incoming_dominates exempts unreachable blocks, which is not
/// a disagreement: that rule asks which paths reach a block, and an
/// unreachable block is on none, while this one asks which blocks name it as
/// a target.
fn (self: &Verifier) phi_incoming_matches_predecessors(
    module: &Module,
    function: Function,
    blocks: &BlockIndex,
    preds: &array::Array<array::Array<i64>>
) -> !?diagnostic::Diagnostic {
    let node = module.function_nodes.at(function.node);
    // Two block-wide flag sets, reused: a rule that fails ends the whole
    // verification, so only the path that continues has to clear them.
    var arrives = try flags(self.allocator, blocks.len());
    defer arrives.deinit(self.allocator);
    var named = try flags(self.allocator, blocks.len());
    defer named.deinit(self.allocator);
    var index = 0;
    while node.blocks.get(index) |block| {
        if preds.at(index) |into| {
            try set_flags(&var arrives, into, true);
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let instr_node = module.instrs.at(instr.node);
                if instr_node.op != Op::Phi {
                    continue;
                }
                if try self.phi_edges(module, block_node.name, instr_node, blocks, into, &var arrives, &var named) |failed| {
                    return move failed;
                }
            }
            try set_flags(&var arrives, into, false);
        }
        index = index + 1;
    }
    return null;
}

/// Returns count flags, all clear.
fn flags(allocator: Allocator, count: i64) -> !array::Array<bool> {
    var out = array::new<bool>(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while index < count {
        try out.append(allocator, false);
        index = index + 1;
    }
    return move out;
}

/// Sets the flag at each position in list.
fn set_flags(out: &var array::Array<bool>, list: &array::Array<i64>, value: bool) -> !void {
    var index = 0;
    while list.get(index) |position| {
        index = index + 1;
        try out.set(position, value);
    }
    return;
}

/// Checks one phi against the blocks that jump to its own, the Go
/// `phiEdges`. Counting after the two membership passes is what makes it
/// edges rather than names: a branch whose arms share a target reaches the
/// block twice and needs two incoming, and a phi naming one block twice
/// covers one edge, not two.
fn (self: &Verifier) phi_edges(
    module: &Module,
    block_name: Name,
    instr_node: &InstrNode,
    blocks: &BlockIndex,
    into: &array::Array<i64>,
    arrives: &var array::Array<bool>,
    named: &var array::Array<bool>
) -> !?diagnostic::Diagnostic {
    var index = 0;
    while instr_node.incoming.get(index) |incoming| {
        index = index + 1;
        if incoming_arrives(module, blocks, arrives, incoming.block) |from| {
            try named.set(from, true);
        } else {
            return try self.failure(
                module, "phi %s in block %s takes a value from %s, which does not jump to %s",
                VerifyArg::Str(instr_node.result.name), VerifyArg::Str(block_name),
                VerifyArg::Str(incoming.block), VerifyArg::Str(block_name), VerifyArg::None,
                VerifyArg::None, VerifyArg::None
            );
        }
    }
    var pred_index = 0;
    while into.get(pred_index) |pred| {
        pred_index = pred_index + 1;
        if named.get_or_panic(pred) {
            continue;
        }
        return try self.failure(
            module, "phi %s in block %s has no value for %s, which jumps to %s",
            VerifyArg::Str(instr_node.result.name), VerifyArg::Str(block_name),
            VerifyArg::Str(blocks.name_at(pred)), VerifyArg::Str(block_name), VerifyArg::None,
            VerifyArg::None, VerifyArg::None
        );
    }
    let count = into.len();
    if instr_node.incoming.len() != count {
        return try self.failure(
            module, "phi %s in block %s has %d incoming for %d edges into %s",
            VerifyArg::Str(instr_node.result.name), VerifyArg::Str(block_name),
            VerifyArg::Int(instr_node.incoming.len()), VerifyArg::Int(count), VerifyArg::Str(block_name),
            VerifyArg::None, VerifyArg::None
        );
    }
    index = 0;
    while instr_node.incoming.get(index) |incoming| {
        index = index + 1;
        if blocks.position_of(module, incoming.block) |from| {
            try named.set(from, false);
        }
    }
    return null;
}

/// Returns the position the incoming edge leaves from when that block does
/// jump to the one holding the phi, null otherwise.
fn incoming_arrives(
    module: &Module,
    blocks: &BlockIndex,
    arrives: &array::Array<bool>,
    block: Name
) -> ?i64 {
    let from = blocks.position_of(module, block) orelse return null;
    if arrives.get_or_panic(from) {
        return from;
    }
    return null;
}

/// Checks the SSA property LLVM's verifier enforces, the Go
/// `phiIncomingDominates`: a phi's incoming value must be defined in a block
/// that dominates the predecessor it arrives from. A value that is not yet
/// defined on that edge is read as whatever the register held.
fn (self: &Verifier) phi_incoming_dominates(
    module: &Module,
    function: Function,
    blocks: &BlockIndex,
    preds: &array::Array<array::Array<i64>>
) -> !?diagnostic::Diagnostic {
    let node = module.function_nodes.at(function.node);
    if node.blocks.len() == 0 {
        return null;
    }
    var defined_in = try value_defining_blocks(self.allocator, module, function);
    defer defined_in.deinit(self.allocator);
    var tree = try build_dominator_tree(self.allocator, module, function, blocks, preds);
    defer tree.deinit(self.allocator);
    var index = 0;
    while node.blocks.get(index) |block| {
        index = index + 1;
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            let instr_node = module.instrs.at(instr.node);
            if instr_node.op != Op::Phi {
                continue;
            }
            var incoming_index = 0;
            while instr_node.incoming.get(incoming_index) |incoming| {
                incoming_index = incoming_index + 1;
                let value_text = name_text(&module.names, incoming.value.name);
                let value_bytes = value_text.as_bytes();
                let defined = defined_in.get(value_bytes) orelse continue;
                let from = blocks.position_of(module, incoming.block) orelse continue;
                if tree.dominates(defined.block, from) {
                    continue;
                }
                return try self.failure(
                    module, "phi %s in block %s takes %s from %s, but %s is defined in %s, which does not dominate %s",
                    VerifyArg::Str(instr_node.result.name), VerifyArg::Str(block_node.name),
                    VerifyArg::Str(incoming.value.name), VerifyArg::Str(incoming.block),
                    VerifyArg::Str(incoming.value.name), VerifyArg::Str(blocks.name_at(defined.block)),
                    VerifyArg::Str(incoming.block)
                );
            }
        }
    }
    return null;
}

/// Checks for every operand what phi_incoming_dominates checks for a phi
/// edge, the Go `valuesDominateUses`: a value is read only where its
/// definition is on every path in, and within one block only after it.
///
/// A phi is the exception this rule leaves alone. Its operands arrive on
/// edges rather than where it stands, so a value defined in the block a back
/// edge leaves from is correct there and would look backwards here.
fn (self: &Verifier) values_dominate_uses(
    module: &Module,
    function: Function,
    blocks: &BlockIndex,
    preds: &array::Array<array::Array<i64>>
) -> !?diagnostic::Diagnostic {
    let node = module.function_nodes.at(function.node);
    if node.blocks.len() == 0 {
        return null;
    }
    var defined_in = try value_defining_blocks(self.allocator, module, function);
    defer defined_in.deinit(self.allocator);
    var tree = try build_dominator_tree(self.allocator, module, function, blocks, preds);
    defer tree.deinit(self.allocator);
    var index = 0;
    while node.blocks.get(index) |block| {
        let block_node = module.blocks.at(block.node);
        var step = 0;
        while block_node.instrs.get(step) |instr| {
            let instr_node = module.instrs.at(instr.node);
            if instr_node.op != Op::Phi {
                if try self.check_operands(module, &tree, &defined_in, blocks, index, step, instr_node) |failed| {
                    return move failed;
                }
            }
            step = step + 1;
        }
        let end = block_node.instrs.len();
        if try self.dominates_use(module, &tree, &defined_in, blocks, index, end, block_node.terminator.cond) |failed| {
            return move failed;
        }
        if try self.dominates_use(module, &tree, &defined_in, blocks, index, end, block_node.terminator.value) |failed| {
            return move failed;
        }
        index = index + 1;
    }
    return null;
}

/// Checks every value one instruction reads where it stands, the Go
/// `checkOperands`: its arguments, its field values, and the receiver of each
/// cleanup. They are walked in place rather than gathered, because gathering
/// costs one array per instruction and the walk reads each value once either
/// way.
fn (self: &Verifier) check_operands(
    module: &Module,
    tree: &DominatorTree,
    defined_in: &map::Map<[]u8, Definition>,
    blocks: &BlockIndex,
    position: i64,
    step: i64,
    instr_node: &InstrNode
) -> !?diagnostic::Diagnostic {
    var index = 0;
    while instr_node.args.get(index) |arg| {
        index = index + 1;
        if try self.dominates_use(module, tree, defined_in, blocks, position, step, arg) |failed| {
            return move failed;
        }
    }
    index = 0;
    while instr_node.fields.get(index) |field| {
        index = index + 1;
        if try self.dominates_use(module, tree, defined_in, blocks, position, step, field.value) |failed| {
            return move failed;
        }
    }
    index = 0;
    while instr_node.cleanups.get(index) |cleanup| {
        index = index + 1;
        if try self.dominates_use(module, tree, defined_in, blocks, position, step, cleanup.arg) |failed| {
            return move failed;
        }
        if is_empty(cleanup.allocator.name) {
            continue;
        }
        if try self.dominates_use(
            module, tree, defined_in, blocks, position, step, cleanup.allocator
        ) |failed| {
            return move failed;
        }
    }
    return null;
}

/// Checks one operand read in block, the Go `dominatesUse`. above holds what
/// the block has defined so far, which is what separates a read of an
/// earlier instruction from a read of a later one.
fn (self: &Verifier) dominates_use(
    module: &Module,
    tree: &DominatorTree,
    defined_in: &map::Map<[]u8, Definition>,
    blocks: &BlockIndex,
    position: i64,
    step: i64,
    operand: Value
) -> !?diagnostic::Diagnostic {
    let operand_text = name_text(&module.names, operand.name);
    let operand_bytes = operand_text.as_bytes();
    // A param or a literal has no defining block and is read anywhere.
    let defined = defined_in.get(operand_bytes) orelse return null;
    let block_name = blocks.name_at(position);
    if defined.block == position {
        if defined.step < step {
            return null;
        }
        return try self.failure(
            module, "block %s reads %s before it is defined",
            VerifyArg::Str(block_name), VerifyArg::Str(operand.name), VerifyArg::None,
            VerifyArg::None, VerifyArg::None, VerifyArg::None, VerifyArg::None
        );
    }
    if tree.dominates(defined.block, position) {
        return null;
    }
    let defined_at = blocks.name_at(defined.block);
    return try self.failure(
        module, "block %s reads %s, which is defined in %s, and %s does not dominate %s",
        VerifyArg::Str(block_name), VerifyArg::Str(operand.name), VerifyArg::Str(defined_at),
        VerifyArg::Str(defined_at), VerifyArg::Str(block_name), VerifyArg::None, VerifyArg::None
    );
}

/// Is where one instruction result is defined: the block, and how far into it,
/// the Go `definition`. The step is what tells a read of an earlier
/// instruction from a read of a later one, which a set of what a block has
/// defined so far would answer by being rebuilt for every block.
struct Definition {
    block: i64,
    step: i64
}

/// Maps each instruction result to where it is defined, the Go
/// `valueDefiningBlocks`. Params and literals have no defining block and are
/// available everywhere.
fn value_defining_blocks(allocator: Allocator, module: &Module, function: Function) -> !map::Map<[]u8, Definition> {
    var defined = map::new<[]u8, Definition>(allocator);
    errdefer defined.deinit(allocator);
    let node = module.function_nodes.at(function.node);
    var index = 0;
    while node.blocks.get(index) |block| {
        let block_node = module.blocks.at(block.node);
        var step = 0;
        while block_node.instrs.get(step) |instr| {
            let instr_node = module.instrs.at(instr.node);
            if !is_empty(instr_node.result.name) {
                let result_text = name_text(&module.names, instr_node.result.name);
                let result_bytes = result_text.as_bytes();
                try defined.insert(allocator, result_bytes, Definition { block: index, step: step });
            }
            step = step + 1;
        }
        index = index + 1;
    }
    return move defined;
}

/// Answers which blocks dominate which, the Go `dominatorTree`. It stores one
/// immediate dominator per block rather than a set per block, so the whole
/// tree is a map and a list and a question is a walk up the chain.
struct DominatorTree {
    // place[position] is where the block at position stands in reverse
    // postorder, which is the numbering the walk compares against, or -1 when
    // the entry cannot reach it.
    place: array::Array<i64>,
    // idom[i] is the reverse-postorder position of the block standing at i's
    // immediate dominator. The entry is its own.
    idom: array::Array<i64>
}

/// Computes immediate dominators by the Cooper-Harvey-Kennedy iteration, the
/// Go `buildDominatorTree`: walk the blocks in reverse postorder, and take
/// each block's immediate dominator to be the meet of the ones already known
/// for its predecessors. Storing sets instead costs a map per block and the
/// entry count grows with the square of the block count, which a function of
/// a few dozen blocks already feels.
fn build_dominator_tree(
    allocator: Allocator,
    module: &Module,
    function: Function,
    blocks: &BlockIndex,
    preds: &array::Array<array::Array<i64>>
) -> !DominatorTree {
    var order = try reverse_postorder(allocator, module, function, blocks);
    defer order.deinit(allocator);
    var tree = DominatorTree {
        place: array::new<i64>(allocator),
        idom: array::new<i64>(allocator)
    };
    errdefer tree.deinit(allocator);
    var position = 0;
    while position < blocks.len() {
        try tree.place.append(allocator, -1);
        position = position + 1;
    }
    position = 0;
    while order.get(position) |block| {
        try tree.place.set(block, position);
        try tree.idom.append(allocator, -1);
        position = position + 1;
    }
    if order.len() == 0 {
        return move tree;
    }
    try tree.idom.set(0, 0);
    var changed = true;
    while changed {
        changed = false;
        position = 1;
        while order.get(position) |block| {
            var meet = -1;
            if preds.at(block) |into| {
                var pred_index = 0;
                while into.get(pred_index) |pred| {
                    pred_index = pred_index + 1;
                    let at = tree.place.get_or_panic(pred);
                    if at < 0 or tree.idom.get_or_panic(at) < 0 {
                        continue;
                    }
                    if meet < 0 {
                        meet = at;
                        continue;
                    }
                    meet = tree.meet(meet, at);
                }
            }
            if meet >= 0 and tree.idom.get_or_panic(position) != meet {
                try tree.idom.set(position, meet);
                changed = true;
            }
            position = position + 1;
        }
    }
    return move tree;
}

/// Walks two blocks up the tree until they arrive at the same one, which is
/// the nearest block dominating both, the Go `meet`. A block's immediate
/// dominator always comes earlier in reverse postorder, so each step moves
/// the higher position down and the walk ends.
fn (self: &DominatorTree) meet(left: i64, right: i64) -> i64 {
    var left_at = left;
    var right_at = right;
    while left_at != right_at {
        while left_at > right_at {
            left_at = self.idom.get_or_panic(left_at);
        }
        while right_at > left_at {
            right_at = self.idom.get_or_panic(right_at);
        }
    }
    return left_at;
}

/// Reports whether every path reaching block passes through dominator, the
/// Go `dominates`. An unreachable block is reached by no path, so nothing is
/// claimed about it.
fn (self: &DominatorTree) dominates(dominator: i64, block: i64) -> bool {
    var at = self.place.get_or_panic(block);
    if at < 0 {
        return true;
    }
    let target = self.place.get_or_panic(dominator);
    if target < 0 {
        return false;
    }
    while at != target {
        let next = self.idom.get_or_panic(at);
        if next == at {
            return false;
        }
        at = next;
    }
    return true;
}

/// Lists the blocks reachable from the entry, each after every block it can
/// reach, then reversed, the Go `reversePostorder`. Predecessors therefore
/// come first except across a back edge, which is what makes one forward
/// pass enough for most of the dominator tree.
fn reverse_postorder(
    allocator: Allocator,
    module: &Module,
    function: Function,
    blocks: &BlockIndex
) -> !array::Array<i64> {
    let node = module.function_nodes.at(function.node);
    var visited = try flags(allocator, blocks.len());
    defer visited.deinit(allocator);
    var order = array::new<i64>(allocator);
    errdefer order.deinit(allocator);
    if node.blocks.len() == 0 {
        return move order;
    }
    try visit_postorder(allocator, module, blocks, &var visited, &var order, 0);
    var head = 0;
    var tail = order.len() - 1;
    while head < tail {
        try order.swap(head, tail);
        head = head + 1;
        tail = tail - 1;
    }
    return move order;
}

/// Appends the block at position after every block it can reach, the Go
/// `visit` closure of `reversePostorder`.
fn visit_postorder(
    allocator: Allocator,
    module: &Module,
    blocks: &BlockIndex,
    visited: &var array::Array<bool>,
    order: &var array::Array<i64>,
    position: i64
) -> !void {
    if visited.get_or_panic(position) {
        return;
    }
    try visited.set(position, true);
    let term = module.block_terminator(blocks.block_at(position));
    var index = 0;
    while term.successor(index) |target| {
        index = index + 1;
        if blocks.position_of(module, target) |to| {
            try visit_postorder(allocator, module, blocks, visited, order, to);
        }
    }
    return order.append(allocator, position);
}

/// Derives the CFG edges from each block's terminator, the Go
/// `blockPredecessors`: the positions of the blocks that jump to each block,
/// in block order.
fn block_predecessors(
    allocator: Allocator,
    module: &Module,
    function: Function,
    blocks: &BlockIndex
) -> !array::Array<array::Array<i64>> {
    var preds = array::new<array::Array<i64>>(allocator);
    errdefer preds.deinit(allocator);
    var index = 0;
    while index < blocks.len() {
        try preds.append(allocator, array::new<i64>(allocator));
        index = index + 1;
    }
    let node = module.function_nodes.at(function.node);
    index = 0;
    while node.blocks.get(index) |block| {
        let block_node = module.blocks.at(block.node);
        var position = 0;
        while block_node.terminator.successor(position) |target| {
            position = position + 1;
            if blocks.position_of(module, target) |to| {
                try add_predecessor(allocator, &var preds, to, index);
            }
        }
        index = index + 1;
    }
    return move preds;
}

/// Records one edge, the Go `preds[target] = append(preds[target], name)`.
fn add_predecessor(allocator: Allocator, preds: &var array::Array<array::Array<i64>>, to: i64, from: i64) -> !void {
    if preds.at_mut(to) |list| {
        return list.append(allocator, from);
    }
    return;
}
