import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ownership;
import compiler::internal::stdmath;
import compiler::internal::typ;
import std::array;
import std::fmt;
import std::mem;
import std::string;

fn (self: &var Lowerer) lower_expr(
    tree: &var ast::Ast,
    expression: ast::Expression,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    match tree.expressions.at(expression.node) {
        Comptime(node) => {
            let inner = node.expr;
            return self.lower_marked_expr(tree, expression, inner, out);
        },
        Unsafe(node) => {
            let inner = node.value;
            return self.lower_marked_expr(tree, expression, inner, out);
        },
        Move(node) => {
            let inner = node.value;
            return self.lower_marked_expr(tree, expression, inner, out);
        },
        Int(literal) => {
            let immediate = try self.text_name(tree, literal.value);
            out.* = try self.emit_const(self.common.i64_type, immediate);
            return null;
        },
        Float(literal) => {
            let immediate = try self.text_name(tree, literal.value);
            out.* = try self.emit_const(self.common.f64_type, immediate);
            return null;
        },
        Bool(literal) => {
            if literal.value {
                out.* = try self.emit_const(self.common.bool_type, self.common.true_text);
            } else {
                out.* = try self.emit_const(self.common.bool_type, self.common.false_text);
            }
            return null;
        },
        String(_) => return self.lower_literal_expr(tree, expression, out),
        CString(_) => return self.lower_literal_expr(tree, expression, out),
        Null(_) => return self.lower_literal_expr(tree, expression, out),
        Type(typed) => {
            let immediate = try self.text_name(tree, typed.type_name);
            out.* = try self.emit_const(self.common.type_type, immediate);
            return null;
        },
        Ident(ident) => {
            let copied = ast::IdentExpr { name: ident.name, span: ident.span };
            return self.lower_ident_expr(tree, expression, copied, out);
        },
        Prefix(prefix) => {
            let copied = ast::PrefixExpr { operator: prefix.operator, right: prefix.right };
            return self.lower_prefix_expr(tree, copied, out);
        },
        Binary(binary) => {
            let copied = ast::BinaryExpr {
                left: binary.left,
                operator: binary.operator,
                operator_span: binary.operator_span,
                right: binary.right
            };
            return self.lower_binary_expr(tree, copied, out);
        },
        Call(call) => {
            let copied = ast::CallExpr { callee: call.callee, args: call.args };
            return self.lower_call_expr(tree, copied, out);
        },
        Cast(cast) => {
            let copied = ast::CastExpr {
                target_type: cast.target_type,
                value: cast.value,
                keyword_span: cast.keyword_span
            };
            return self.lower_cast_expr(tree, copied, out);
        },
        Try(attempt) => {
            let copied = ast::TryExpr { value: attempt.value };
            return self.lower_try_expr(tree, expression, copied, out);
        },
        If(branch) => {
            let copied = ast::IfStmt {
                condition: branch.condition,
                consequence: branch.consequence,
                alternative: branch.alternative,
                capture: branch.capture,
                err_capture: branch.err_capture
            };
            return self.lower_if_expr(tree, copied, out);
        },
        Match(_) => return self.lower_match_expr(tree, MatchNode::Expression(expression), out),
        OrelseGuard(guard) => {
            let copied = ast::OrelseGuardExpr {
                condition: guard.condition,
                exit: guard.exit,
                span: guard.span
            };
            return self.lower_orelse_guard_expr(tree, copied, out);
        },
        CatchGuard(guard) => {
            let copied = ast::CatchGuardExpr {
                condition: guard.condition,
                exit: guard.exit,
                span: guard.span
            };
            return self.lower_catch_guard_expr(tree, copied, out);
        },
        StructLiteral(_) => return self.lower_struct_literal_expr(tree, expression, out),
        BufferLiteral(_) => {
            if try ast::copy_array_literal(self.allocator, tree, expression) |literal| {
                defer literal.deinit(self.allocator);
                return self.lower_array_literal(tree, &literal, out);
            }
            return null;
        },
        VectorLiteral(_) => {
            if try ast::copy_vector_literal(self.allocator, tree, expression) |literal| {
                defer literal.deinit(self.allocator);
                return self.lower_vector_literal_expr(tree, &literal, out);
            }
            return null;
        },
        Field(field) => {
            let copied = ast::FieldExpr {
                receiver: field.receiver,
                name: field.name,
                namespace: field.namespace,
                span: field.span
            };
            return self.lower_field_expr(tree, copied, out);
        },
        Index(index) => {
            let copied = ast::IndexExpr {
                target: index.target,
                index: index.index,
                start: index.start,
                end: index.end,
                slice: index.slice,
                span: index.span
            };
            return self.lower_index_expr(tree, copied, out);
        },
        Deref(deref) => {
            let copied = ast::DerefExpr {
                receiver: deref.receiver,
                operator_span: deref.operator_span
            };
            return self.lower_deref_expr(tree, copied, out);
        },
        TypeApply(_) => {
            let rendered = try self.expression_name(tree, expression);
            return try self.fail1(tree, "ir error: unsupported expression `%s`", Arg::Str(rendered));
        },
        Recovered(_) => {
            let rendered = try self.expression_name(tree, expression);
            return try self.fail1(tree, "ir error: unsupported expression `%s`", Arg::Str(rendered));
        },
    }
}

fn is_null_expr(tree: &ast::Ast, expression: ast::Expression) -> bool {
    match tree.expressions.at(expression.node) {
        Null(_) => return true,
        _ => return false,
    }
}

fn (self: &var Lowerer) lower_array_literal(
    tree: &var ast::Ast,
    literal: &ast::BufferLiteralExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    let type_text = try literal.type_text(self.allocator, tree);
    defer type_text.deinit(self.allocator);
    let type_bytes = type_text.as_bytes();
    let written_type = try self.name(type_bytes);
    let array_type = try self.resolve_bound_type(written_type);
    let zero = try self.emit0(Op::BufferNew, array_type);
    if literal.elements.len() == 0 {
        out.* = zero;
        return null;
    }
    let elem_text = tree.texts.at(literal.elem.node);
    let elem_bytes = elem_text.as_bytes();
    let written_elem = try self.name(elem_bytes);
    let elem_type = try self.resolve_bound_type(written_elem);
    var values = array::new<Value>(self.allocator);
    defer values.deinit(self.allocator);
    var index = 0;
    while literal.elements.get(index) |element| {
        index = index + 1;
        var value = empty_value();
        if try self.lower_contextual_expr(tree, element, elem_type, &var value) |failed| {
            return move failed;
        }
        try values.append(self.allocator, value);
    }
    let slot_type = try self.module.names.prefixed("&var ", array_type);
    let storage = try self.emit1(Op::LocalSlot, slot_type, zero);
    let address_type = try self.module.names.prefixed("&var ", elem_type);
    index = 0;
    while values.get(index) |value| {
        let position_text = try self.module.names.intern_i64(index);
        let position = try self.emit_const(self.common.i64_type, position_text);
        let element = try self.emit2(Op::BufferAddr, address_type, storage, position);
        let _ = try self.emit2(Op::RefStore, self.common.void_type, element, value);
        index = index + 1;
    }
    out.* = try self.emit1(Op::RefLoad, array_type, storage);
    return null;
}

fn (self: &var Lowerer) lower_vector_literal_expr(
    tree: &var ast::Ast,
    literal: &ast::VectorLiteralExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    let retained = tree.texts.at(literal.type_name.node);
    let name_bytes = retained.as_bytes();
    let kind = typ::vector_kind(name_bytes);
    if kind < 0 {
        return try self.fail0("ir error: not a vector type");
    }
    let lane = typ::vector_lane_of_kind(kind);
    let lane_type = try self.name(lane);
    let type_name = try self.name(name_bytes);
    var lanes = array::new<Value>(self.allocator);
    defer lanes.deinit(self.allocator);
    var index = 0;
    while literal.lanes.get(index) |lane_expr| {
        var value = empty_value();
        if try self.lower_contextual_expr(tree, lane_expr, lane_type, &var value) |failed| {
            return move failed;
        }
        try lanes.append(self.allocator, value);
        index = index + 1;
    }
    out.* = try self.emit_with(Op::VectorNew, empty_name(), type_name, empty_name(), &lanes);
    return null;
}

fn (self: &var Lowerer) lower_deref_expr(
    tree: &var ast::Ast,
    deref: ast::DerefExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    var receiver = empty_value();
    if try self.lower_expr(tree, deref.receiver, &var receiver) |failed| {
        return move failed;
    }
    if try self.raw_pointer_elem(receiver.type_name) |elem| {
        out.* = try self.emit1(Op::RefLoad, elem, receiver);
        return null;
    }
    if !self.is_reference_type(receiver.type_name) {
        out.* = receiver;
        return null;
    }
    let elem = try self.deref_type(receiver.type_name);
    out.* = try self.emit1(Op::RefLoad, elem, receiver);
    return null;
}

fn (self: &var Lowerer) lend_storage(
    tree: &var ast::Ast,
    expression: ast::Expression,
    want: Name
) -> !?Value {
    if !self.is_mutable_reference_type(want) {
        if !self.is_reference_type(want) {
            return null;
        }
        let shared = shared_borrow_target(tree, expression);
        let storage = try self.place_storage(tree, shared) orelse return null;
        let held = try self.deref_type(storage.type_name);
        let wanted = try self.deref_type(want);
        if !same_name(held, wanted) {
            return null;
        }
        return storage;
    }
    let target = borrow_target_expr(tree, expression);
    if try self.slot_pointer(tree, target) |slot| {
        if self.is_mutable_reference_type(slot.type_name) {
            let held = try self.deref_type(slot.type_name);
            if same_name(held, want) {
                return null;
            }
        }
        return slot;
    }
    return self.lower_field_storage(tree, target);
}

fn (self: &var Lowerer) lower_contextual_expr(
    tree: &var ast::Ast,
    expression: ast::Expression,
    want_type: Name,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    let want = try self.resolve_bound_type(want_type);
    if try self.optional_elem_type(want) |elem| {
        return self.lower_optional_context_expr(tree, expression, want, elem, out);
    }
    if is_null_expr(tree, expression) {
        if try self.module.names.nullable_pointer_elem(want) |elem| {
            out.* = try self.lower_null_pointer(want, elem);
            return null;
        }
    }
    if try self.lend_storage(tree, expression, want) |storage| {
        out.* = storage;
        return null;
    }
    if !self.narrows_integer_literal(want) and !self.narrows_float_literal(want) {
        var value = empty_value();
        if try self.lower_expr(tree, expression, &var value) |failed| {
            return move failed;
        }
        if fills_nullable_pointer(&self.module, want, value.type_name) {
            out.* = try self.emit_imm1(Op::Cast, want, want, value);
            return null;
        }
        out.* = try self.read_borrow_for_context(value, want);
        return null;
    }
    if ownership::int_expr(tree, expression) |literal| {
        if self.is_integer_type_name(want) {
            let immediate = try self.text_name(tree, literal.value);
            out.* = try self.emit_const(want, immediate);
            return null;
        }
    }
    if ownership::float_expr(tree, expression) |literal| {
        if self.is_float_type_name(want) {
            let immediate = try self.text_name(tree, literal.value);
            out.* = try self.emit_const(want, immediate);
            return null;
        }
    }
    if ownership::prefix_expr(tree, expression) |prefix| {
        if text_is(tree, prefix.operator, "-") {
            if is_scalar_literal(tree, prefix.right) {
                var value = empty_value();
                if try self.lower_contextual_expr(tree, prefix.right, want, &var value) |failed| {
                    return move failed;
                }
                let operator = try self.text_name(tree, prefix.operator);
                out.* = try self.emit_op1(Op::Unary, operator, value.type_name, value);
                return null;
            }
        }
    }
    return self.lower_expr(tree, expression, out);
}

fn (self: &var Lowerer) read_borrow_for_context(value: Value, want: Name) -> !Value {
    if is_empty(want) or !self.is_reference_type(value.type_name) or
        self.is_mutable_reference_type(want) {
        return value;
    }
    if !self.is_reference_type(want) {
        let deref = try self.deref_type(value.type_name);
        if !same_name(deref, want) {
            return value;
        }
        return self.emit1(Op::RefLoad, want, value);
    }
    let value_deref = try self.deref_type(value.type_name);
    let want_deref = try self.deref_type(want);
    if !self.is_mutable_reference_type(value.type_name) or !same_name(value_deref, want_deref) {
        return value;
    }
    return self.emit1(Op::RefLoad, want_deref, value);
}

fn (self: &var Lowerer) lower_null_pointer(want: Name, elem: Name) -> !Value {
    let zero = try self.emit_const_text(self.common.i64_type, "0");
    let address = try self.emit_imm1(Op::Cast, elem, elem, zero);
    return try self.emit_imm1(Op::Cast, want, want, address);
}

fn (self: &var Lowerer) lower_optional_context_expr(
    tree: &var ast::Ast,
    expression: ast::Expression,
    want: Name,
    elem: Name,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if is_null_expr(tree, expression) {
        out.* = try self.emit0(Op::OptNull, want);
        return null;
    }
    var value = empty_value();
    if try self.lower_contextual_expr(tree, expression, elem, &var value) |failed| {
        return move failed;
    }
    if !same_name(value.type_name, elem) {
        out.* = value;
        return null;
    }
    out.* = try self.emit1(Op::OptSome, want, value);
    return null;
}

fn (self: &Lowerer) narrows_integer_literal(type_name: Name) -> bool {
    let retained = name_text(&self.module.names, type_name);
    let bytes = retained.as_bytes();
    return mem::equal_bytes(bytes, "i8") or mem::equal_bytes(bytes, "i16") or
        mem::equal_bytes(bytes, "i32") or mem::equal_bytes(bytes, "u8") or
        mem::equal_bytes(bytes, "u16") or mem::equal_bytes(bytes, "u32") or
        mem::equal_bytes(bytes, "u64") or mem::equal_bytes(bytes, "usize") or
        mem::equal_bytes(bytes, "isize");
}

fn (self: &var Lowerer) lower_marked_expr(
    tree: &var ast::Ast,
    marked: ast::Expression,
    inner: ast::Expression,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if ownership::comptime_expr(tree, marked) |_| {
        if try self.const_float(tree, inner) |value| {
            let text = try stdmath::literal(self.allocator, value);
            defer text.deinit(self.allocator);
            let bytes = text.as_bytes();
            out.* = try self.emit_const_text(self.common.f64_type, bytes);
            return null;
        }
    }
    return self.lower_expr(tree, inner, out);
}

fn (self: &var Lowerer) lower_literal_expr(
    tree: &var ast::Ast,
    expression: ast::Expression,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if ownership::int_expr(tree, expression) |literal| {
        let immediate = try self.text_name(tree, literal.value);
        out.* = try self.emit_const(self.common.i64_type, immediate);
        return null;
    }
    if ownership::float_expr(tree, expression) |literal| {
        let immediate = try self.text_name(tree, literal.value);
        out.* = try self.emit_const(self.common.f64_type, immediate);
        return null;
    }
    if string_literal_text(tree, expression) |text| {
        let quoted = try self.quoted_name(tree, text);
        out.* = try self.emit_const(self.common.bytes_type, quoted);
        return null;
    }
    if c_string_literal_text(tree, expression) |text| {
        var ended = string::new(self.allocator);
        defer ended.deinit(self.allocator);
        let retained = tree.texts.at(text.node);
        let written = retained.as_bytes();
        try ended.append_bytes(self.allocator, written);
        try ended.append_byte(self.allocator, cast<u8>(0));
        let stored = ended.as_bytes();
        let quoted = try self.quoted_bytes(stored);
        let bytes = try self.emit_const(self.common.bytes_type, quoted);
        let pointer = try self.module.names.intern("ptr<const u8>");
        out.* = try self.emit1(Op::SlicePtr, pointer, bytes);
        return null;
    }
    if ownership::bool_expr(tree, expression) |literal| {
        if literal.value {
            out.* = try self.emit_const_text(self.common.bool_type, "true");
        } else {
            out.* = try self.emit_const_text(self.common.bool_type, "false");
        }
        return null;
    }
    if is_null_expr(tree, expression) {
        return try self.fail0("ir error: `null` needs an optional context");
    }
    let kind = try self.name(expression_go_type(tree, expression));
    return try self.fail1(tree, "ir error: unsupported literal %s", Arg::Str(kind));
}

fn string_literal_text(tree: &ast::Ast, expression: ast::Expression) -> ?ast::Text {
    match tree.expressions.at(expression.node) {
        String(literal) => return literal.value,
        _ => return null,
    }
}

fn c_string_literal_text(tree: &ast::Ast, expression: ast::Expression) -> ?ast::Text {
    match tree.expressions.at(expression.node) {
        CString(literal) => return literal.value,
        _ => return null,
    }
}

fn (self: &var Lowerer) quoted_name(tree: &ast::Ast, text: ast::Text) -> !Name {
    let retained = tree.texts.at(text.node);
    let bytes = retained.as_bytes();
    return self.quoted_bytes(bytes);
}

fn (self: &var Lowerer) quoted_bytes(bytes: []u8) -> !Name {
    var quoted = string::new(self.allocator);
    errdefer quoted.deinit(self.allocator);
    try fmt::append_bytes_literal(self.allocator, &var quoted, bytes);
    return self.module.names.intern_owned(move quoted);
}

fn expression_go_type(tree: &ast::Ast, expression: ast::Expression) -> []u8 {
    match tree.expressions.at(expression.node) {
        Ident(_) => return "*ast.IdentExpr",
        Int(_) => return "*ast.IntExpr",
        Float(_) => return "*ast.FloatExpr",
        String(_) => return "*ast.StringExpr",
        CString(_) => return "*ast.CStringExpr",
        Null(_) => return "*ast.NullExpr",
        OrelseGuard(_) => return "*ast.OrelseGuardExpr",
        CatchGuard(_) => return "*ast.CatchGuardExpr",
        Bool(_) => return "*ast.BoolExpr",
        Type(_) => return "*ast.TypeExpr",
        Comptime(_) => return "*ast.ComptimeExpr",
        Prefix(_) => return "*ast.PrefixExpr",
        Binary(_) => return "*ast.BinaryExpr",
        Call(_) => return "*ast.CallExpr",
        TypeApply(_) => return "*ast.TypeApplyExpr",
        Cast(_) => return "*ast.CastExpr",
        Try(_) => return "*ast.TryExpr",
        Move(_) => return "*ast.MoveExpr",
        Unsafe(_) => return "*ast.UnsafeExpr",
        Index(_) => return "*ast.IndexExpr",
        StructLiteral(_) => return "*ast.StructLiteralExpr",
        BufferLiteral(_) => return "*ast.BufferLiteralExpr",
        VectorLiteral(_) => return "*ast.VectorLiteralExpr",
        Field(_) => return "*ast.FieldExpr",
        Deref(_) => return "*ast.DerefExpr",
        If(_) => return "*ast.IfStmt",
        Match(_) => return "*ast.MatchStmt",
        Recovered(_) => return "*ast.RecoveredNode",
    }
}

fn (self: &var Lowerer) lower_ident_expr(
    tree: &var ast::Ast,
    expression: ast::Expression,
    ident: ast::IdentExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if try self.slot_pointer(tree, expression) |slot| {
        let elem = try self.deref_type(slot.type_name);
        out.* = try self.emit1(Op::RefLoad, elem, slot);
        return null;
    }
    let name = try self.text_name(tree, ident.name);
    if self.envs.get(self.env, name) |value| {
        out.* = value;
        return null;
    }
    if self.static_value(name) |static| {
        if !self.name_is(static.typ, "Function") {
            out.* = try self.emit_const(static.typ, static.text);
            return null;
        }
    }
    if self.name_is(name, "void") {
        out.* = self.common.void_value;
        return null;
    }
    if try self.function_by_value_name(name) |resolved| {
        let pointer = try self.function_pointer_type(resolved.signature);
        var none = array::new<Value>(self.allocator);
        defer none.deinit(self.allocator);
        out.* = try self.emit_with(Op::FuncAddr, resolved.name, pointer, empty_name(), &none);
        if self.extern_decl(resolved.name) |external| {
            if self.last_instr() |instr| {
                self.module.set_extern_call(instr, external.abi, external.name);
            }
        }
        return null;
    }
    return try self.fail1(tree, "ir error: undefined value `%s`", Arg::Str(name));
}

fn (self: &var Lowerer) lower_cast_expr(
    tree: &var ast::Ast,
    cast: ast::CastExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    var value = empty_value();
    if try self.lower_expr(tree, cast.value, &var value) |failed| {
        return move failed;
    }
    let target = try self.intern_type(tree, cast.target_type);
    out.* = try self.emit_imm1(Op::Cast, target, target, value);
    return null;
}

fn (self: &var Lowerer) lower_prefix_expr(
    tree: &var ast::Ast,
    prefix: ast::PrefixExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if text_is(tree, prefix.operator, "&var") {
        return self.lower_mutable_borrow_expr(tree, prefix.right, out);
    }
    if text_is(tree, prefix.operator, "&") {
        return self.lower_expr(tree, prefix.right, out);
    }
    var right = empty_value();
    if try self.lower_expr(tree, prefix.right, &var right) |failed| {
        return move failed;
    }
    let operator = try self.text_name(tree, prefix.operator);
    out.* = try self.emit_op1(Op::Unary, operator, right.type_name, right);
    return null;
}

fn (self: &var Lowerer) lower_mutable_borrow_expr(
    tree: &var ast::Ast,
    target: ast::Expression,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if try self.slot_pointer(tree, target) |slot| {
        out.* = slot;
        return null;
    }
    if try self.lower_field_storage(tree, target) |storage| {
        out.* = storage;
        return null;
    }
    var receiver: ?ast::Expression = null;
    match tree.expressions.at(target.node) {
        Deref(deref) => {
            receiver = deref.receiver;
        },
        _ => {},
    }
    let pointer_expr = receiver orelse return self.lower_expr(tree, target, out);
    var pointer = empty_value();
    if try self.lower_expr(tree, pointer_expr, &var pointer) |failed| {
        return move failed;
    }
    let elem = try self.raw_pointer_elem(pointer.type_name) orelse
        return self.lower_expr(tree, target, out);
    let borrowed = try self.module.names.prefixed("&var ", elem);
    out.* = try self.emit_imm1(Op::Cast, borrowed, borrowed, pointer);
    return null;
}

fn (self: &var Lowerer) lower_binary_expr(
    tree: &var ast::Ast,
    binary: ast::BinaryExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if text_is(tree, binary.operator, "and") or text_is(tree, binary.operator, "or") {
        return self.lower_logical_expr(tree, binary, out);
    }
    if text_is(tree, binary.operator, "orelse") {
        return self.lower_orelse_expr(tree, binary, out);
    }
    if text_is(tree, binary.operator, "catch") {
        return self.lower_catch_expr(tree, binary, out);
    }
    var left = empty_value();
    var right = empty_value();
    if try self.lower_binary_operands(tree, binary, &var left, &var right) |failed| {
        return move failed;
    }
    if text_is(tree, binary.operator, "<<") or text_is(tree, binary.operator, ">>") {
        try self.check_shift_amount(tree, binary, right);
    }
    let operator = try self.text_name(tree, binary.operator);
    let result_type = self.binary_result_type(operator, left.type_name);
    out.* = try self.emit_op2(Op::Binary, operator, result_type, left, right);
    return null;
}

fn (self: &var Lowerer) lower_binary_operands(
    tree: &var ast::Ast,
    binary: ast::BinaryExpr,
    left: &var Value,
    right: &var Value
) -> !?diagnostic::Diagnostic {
    let left_literal = is_scalar_literal(tree, binary.left);
    let right_literal = is_scalar_literal(tree, binary.right);
    if right_literal and !left_literal {
        if try self.lower_expr(tree, binary.left, left) |failed| {
            return move failed;
        }
        return self.lower_literal_operand(tree, binary.right, left.type_name, right);
    }
    if left_literal and !right_literal {
        if try self.lower_expr(tree, binary.right, right) |failed| {
            return move failed;
        }
        return self.lower_literal_operand(tree, binary.left, right.type_name, left);
    }
    if try self.lower_expr(tree, binary.left, left) |failed| {
        return move failed;
    }
    return self.lower_expr(tree, binary.right, right);
}

fn (self: &var Lowerer) lower_literal_operand(
    tree: &var ast::Ast,
    expression: ast::Expression,
    other: Name,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if is_integer_literal(tree, expression) and self.is_integer_type_name(other) {
        return self.lower_contextual_expr(tree, expression, other, out);
    }
    if is_float_literal(tree, expression) and self.is_float_type_name(other) {
        return self.lower_contextual_expr(tree, expression, other, out);
    }
    return self.lower_expr(tree, expression, out);
}

fn is_float_literal(tree: &ast::Ast, expression: ast::Expression) -> bool {
    if ownership::float_expr(tree, expression) |_| {
        return true;
    }
    if ownership::prefix_expr(tree, expression) |prefix| {
        if !text_is(tree, prefix.operator, "-") {
            return false;
        }
        if ownership::float_expr(tree, prefix.right) |_| {
            return true;
        }
    }
    return false;
}

fn is_scalar_literal(tree: &ast::Ast, expression: ast::Expression) -> bool {
    return is_integer_literal(tree, expression) or is_float_literal(tree, expression);
}

fn (self: &Lowerer) is_float_type_name(type_name: Name) -> bool {
    return self.module.names.is(type_name, "f32") or self.module.names.is(type_name, "f64");
}

fn (self: &Lowerer) narrows_float_literal(type_name: Name) -> bool {
    return self.module.names.is(type_name, "f32");
}

fn is_integer_literal(tree: &ast::Ast, expression: ast::Expression) -> bool {
    if ownership::int_expr(tree, expression) |_| {
        return true;
    }
    if ownership::prefix_expr(tree, expression) |prefix| {
        if !text_is(tree, prefix.operator, "-") {
            return false;
        }
        if ownership::int_expr(tree, prefix.right) |_| {
            return true;
        }
    }
    return false;
}

fn (self: &Lowerer) is_integer_type_name(type_name: Name) -> bool {
    return self.module.names.is(type_name, "i64") or self.narrows_integer_literal(type_name);
}

fn (self: &Lowerer) is_signed_integer_type_name(type_name: Name) -> bool {
    let retained = name_text(&self.module.names, type_name);
    let bytes = retained.as_bytes();
    return mem::equal_bytes(bytes, "i8") or mem::equal_bytes(bytes, "i16") or
        mem::equal_bytes(bytes, "i32") or mem::equal_bytes(bytes, "i64") or
        mem::equal_bytes(bytes, "isize");
}

fn (self: &var Lowerer) check_shift_amount(
    tree: &var ast::Ast,
    binary: ast::BinaryExpr,
    amount: Value
) -> !void {
    if !self.is_signed_integer_type_name(amount.type_name) or
        is_integer_literal(tree, binary.right) {
        return;
    }
    let zero = try self.emit_const_text(amount.type_name, "0");
    let kind = try self.module.names.intern("shift_negative");
    return self.cond_fail0(binary.operator_span, "<", amount, zero, kind);
}

fn (self: &var Lowerer) lower_struct_literal_expr(
    tree: &var ast::Ast,
    expression: ast::Expression,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    let head = ownership::struct_literal_head(tree, expression) orelse return try self.fail0("ir error: unsupported expression");
    let type_name = try self.text_name(tree, head.type_name);
    var fields = array::new<FieldArg>(self.allocator);
    defer fields.deinit(self.allocator);
    var index = 0;
    while ownership::struct_literal_field_at(tree, expression, index) |field| {
        index = index + 1;
        let field_name = try self.text_name(tree, field.name);
        let want = try self.field_type(type_name, field_name);
        var value = empty_value();
        if try self.lower_contextual_expr(tree, field.value, want, &var value) |failed| {
            return move failed;
        }
        try fields.append(self.allocator, FieldArg { name: field_name, value: value });
    }
    let result = try self.next(type_name);
    var instr = self.module.blank_instr(result, Op::StructNew, empty_name(), empty_name());
    errdefer instr.deinit(self.allocator);
    index = 0;
    while fields.get(index) |field| {
        index = index + 1;
        try instr.fields.append(self.allocator, field);
    }
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    out.* = result;
    return null;
}

fn (self: &var Lowerer) lower_field_expr(
    tree: &var ast::Ast,
    field: ast::FieldExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if field.namespace {
        if try self.lower_enum_tag_expr(tree, field) |value| {
            out.* = value;
            return null;
        }
        if try self.lower_payload_free_union_expr(tree, field) |value| {
            out.* = value;
            return null;
        }
    }
    var receiver = empty_value();
    if try self.lower_receiver_address(tree, field.receiver, &var receiver) |failed| {
        return move failed;
    }
    let field_name = try self.text_name(tree, field.name);
    let receiver_type = try self.deref_type(receiver.type_name);
    let field_type = try self.field_type(receiver_type, field_name);
    if self.is_reference_type(receiver.type_name) {
        out.* = try self.emit_op1(Op::FieldRef, field_name, field_type, receiver);
        return null;
    }
    out.* = try self.emit_op1(Op::Field, field_name, field_type, receiver);
    return null;
}

fn (self: &var Lowerer) lower_union_constructor(
    tree: &var ast::Ast,
    field: ast::FieldExpr,
    args: ast::ExpressionList,
    out: &var Value,
    handled: &var bool
) -> !?diagnostic::Diagnostic {
    handled.* = false;
    let found = try self.union_variant_of(tree, field) orelse return null;
    handled.* = true;
    let variant = found.variant;
    if is_empty(variant.payload) {
        if ownership::arg_count(tree, args) != 0 {
            return try self.fail2(
                tree, "ir error: union variant `%s::%s` expects no payload",
                Arg::Str(found.union_name), Arg::Str(variant.name)
            );
        }
        out.* = try self.emit_imm0(Op::UnionNew, found.union_name, variant.name);
        return null;
    }
    if ownership::arg_count(tree, args) != 1 {
        return try self.fail2(
            tree, "ir error: union variant `%s::%s` expects one payload",
            Arg::Str(found.union_name), Arg::Str(variant.name)
        );
    }
    let payload_expr = ownership::arg_at(tree, args, 0) orelse return null;
    var payload = empty_value();
    if try self.lower_contextual_expr(tree, payload_expr, variant.payload, &var payload) |failed| {
        return move failed;
    }
    out.* = try self.emit_imm1(Op::UnionNew, found.union_name, variant.name, payload);
    return null;
}

pub struct ResolvedVariant {
    pub union_name: Name,
    pub variant: UnionVariant,
}

fn (self: &var Lowerer) union_variant_of(tree: &ast::Ast, field: ast::FieldExpr) -> !?ResolvedVariant {
    let union_name = try self.expression_name(tree, field.receiver);
    let variant_name = try self.text_name(tree, field.name);
    let variant = self.module.union_variant(union_name, variant_name) orelse return null;
    return ResolvedVariant { union_name: union_name, variant: variant };
}

fn (self: &var Lowerer) lower_payload_free_union_expr(tree: &ast::Ast, field: ast::FieldExpr) -> !?Value {
    let found = try self.union_variant_of(tree, field) orelse return null;
    if !is_empty(found.variant.payload) {
        return null;
    }
    return try self.emit_imm0(Op::UnionNew, found.union_name, found.variant.name);
}

fn (self: &var Lowerer) lower_enum_tag_expr(tree: &ast::Ast, field: ast::FieldExpr) -> !?Value {
    let enum_name = try self.expression_name(tree, field.receiver);
    let tag = try self.text_name(tree, field.name);
    let index = self.module.enum_tag(enum_name, tag) orelse return null;
    let immediate = try self.module.names.intern_i64(index);
    return try self.emit_const(enum_name, immediate);
}

fn (self: &var Lowerer) lower_index_expr(
    tree: &var ast::Ast,
    index: ast::IndexExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    if !index.slice {
        let container = try self.assign_target_type(tree, index.target);
        if !is_empty(container) and self.module.names.is_buffer_type(container) {
            var element = empty_value();
            if try self.lower_array_element_address(tree, index, &var element) |failed| {
                return move failed;
            }
            let elem = try self.deref_type(element.type_name);
            out.* = try self.emit1(Op::RefLoad, elem, element);
            return null;
        }
    }
    var target = empty_value();
    if try self.lower_expr(tree, index.target, &var target) |failed| {
        return move failed;
    }
    if !index.slice and self.module.names.is_buffer_type(target.type_name) {
        let slot_type = try self.module.names.prefixed("&var ", target.type_name);
        let storage = try self.emit1(Op::LocalSlot, slot_type, target);
        var element = empty_value();
        if try self.index_array_storage(tree, index, storage, &var element) |failed| {
            return move failed;
        }
        let elem = try self.deref_type(element.type_name);
        out.* = try self.emit1(Op::RefLoad, elem, element);
        return null;
    }
    let target_text = name_text(&self.module.names, target.type_name);
    let target_bytes = target_text.as_bytes();
    let target_kind = typ::vector_kind(target_bytes);
    if target_kind >= 0 {
        let lane = typ::vector_lane_of_kind(target_kind);
        let index_expr = index.index orelse
            return try self.fail0("ir error: vector lane index is missing");
        let literal = ownership::int_expr(tree, index_expr) orelse
            return try self.fail0("ir error: vector lane index must be a literal");
        let retained = tree.texts.at(literal.value.node);
        let literal_text = retained.as_bytes();
        let immediate = try self.name(literal_text);
        let lane_type = try self.name(lane);
        out.* = try self.emit_imm1(Op::VectorLane, lane_type, immediate, target);
        return null;
    }
    if !index.slice {
        var position = empty_value();
        if index.index |index_expr| {
            if try self.lower_expr(tree, index_expr, &var position) |failed| {
                return move failed;
            }
        }
        let length = try self.emit1(Op::SliceLen, self.common.i64_type, target);
        let bounds = try self.name("bounds");
        try self.check_index_in_range(index.span, position, length, bounds);
        let elem = try self.module.names.view_elem(target.type_name);
        out.* = try self.emit2(Op::SliceIndex, elem, target, position);
        return null;
    }
    var start = self.common.zero_index;
    if index.start |start_expr| {
        if try self.lower_expr(tree, start_expr, &var start) |failed| {
            return move failed;
        }
    }
    var end = empty_value();
    if index.end |end_expr| {
        if try self.lower_expr(tree, end_expr, &var end) |failed| {
            return move failed;
        }
    } else {
        end = try self.emit1(Op::SliceLen, self.common.i64_type, target);
    }
    let length = try self.emit1(Op::SliceLen, self.common.i64_type, target);
    let range = try self.name("range");
    let unsigned_start = try self.unsigned(start);
    let unsigned_end = try self.unsigned(end);
    let unsigned_length = try self.unsigned(length);
    try self.cond_fail3(index.span, ">", unsigned_start, unsigned_end, range, start, end, length);
    try self.cond_fail3(index.span, ">", unsigned_end, unsigned_length, range, start, end, length);
    out.* = try self.emit3(Op::SliceSlice, target.type_name, target, start, end);
    return null;
}

fn (self: &var Lowerer) cond_fail0(
    span: ast::Span,
    operator: []u8,
    left: Value,
    right: Value,
    kind: Name
) -> !void {
    let bad = try self.emit_compare(operator, left, right);
    var instr = self.module.blank_instr(empty_value(), Op::CondFail, empty_name(), kind);
    errdefer instr.deinit(self.allocator);
    instr.span = span;
    try instr.args.append(self.allocator, bad);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return;
}

fn (self: &var Lowerer) lower_array_element_assign(
    tree: &var ast::Ast,
    target: ast::Expression,
    value: Value
) -> !?diagnostic::Diagnostic {
    let index = ownership::index_expr(tree, target) orelse
        return try self.fail0("ir error: array element write expects an index");
    let base = try self.array_place_root(tree, target);
    if try self.place_storage(tree, base) |_| {
        var element = empty_value();
        if try self.lower_array_element_address(tree, index, &var element) |failed| {
            return move failed;
        }
        let _ = try self.emit2(Op::RefStore, self.common.void_type, element, value);
        return null;
    }
    var whole = empty_value();
    if try self.lower_expr(tree, base, &var whole) |failed| {
        return move failed;
    }
    let slot_type = try self.module.names.prefixed("&var ", whole.type_name);
    let storage = try self.emit1(Op::LocalSlot, slot_type, whole);
    var element = empty_value();
    if try self.array_element_address_in(tree, target, base, storage, &var element) |failed| {
        return move failed;
    }
    let _ = try self.emit2(Op::RefStore, self.common.void_type, element, value);
    let updated = try self.emit1(Op::RefLoad, whole.type_name, storage);
    return self.lower_assign_target(tree, base, updated);
}

fn (self: &var Lowerer) in_place_element(tree: &var ast::Ast, expression: ast::Expression) -> !bool {
    let index = ownership::index_expr(tree, expression) orelse return false;
    if index.slice {
        return false;
    }
    let container = try self.assign_target_type(tree, index.target);
    if is_empty(container) or !self.module.names.is_buffer_type(container) {
        return false;
    }
    let base = try self.array_place_root(tree, expression);
    if try self.place_storage(tree, base) |_| {
        return true;
    }
    return false;
}

fn (self: &var Lowerer) array_place_root(tree: &var ast::Ast, expression: ast::Expression) -> !ast::Expression {
    var root = expression;
    while ownership::index_expr(tree, root) |index| {
        let target_type = try self.assign_target_type(tree, index.target);
        if is_empty(target_type) or !self.module.names.is_buffer_type(target_type) {
            return root;
        }
        root = index.target;
    }
    return root;
}

fn (self: &var Lowerer) place_storage(tree: &var ast::Ast, expression: ast::Expression) -> !?Value {
    if try self.slot_pointer(tree, expression) |slot| {
        return slot;
    }
    return self.lower_field_storage(tree, expression);
}

fn (self: &var Lowerer) array_element_address_in(
    tree: &var ast::Ast,
    expression: ast::Expression,
    root: ast::Expression,
    root_storage: Value,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    let index = ownership::index_expr(tree, expression) orelse
        return try self.fail0("ir error: array element expects an index");
    var storage = root_storage;
    if ownership::index_expr(tree, index.target) |_| {
        if index.target.node != root.node {
            var projected = empty_value();
            if try self.array_element_address_in(tree, index.target, root, root_storage, &var projected) |failed| {
                return move failed;
            }
            storage = projected;
        }
    }
    return self.index_array_storage(tree, index, storage, out);
}

fn (self: &var Lowerer) lower_array_element_address(
    tree: &var ast::Ast,
    index: ast::IndexExpr,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    var storage = empty_value();
    var nested = false;
    if ownership::index_expr(tree, index.target) |inner| {
        let inner_type = try self.assign_target_type(tree, inner.target);
        if !is_empty(inner_type) and self.module.names.is_buffer_type(inner_type) {
            nested = true;
            if try self.lower_array_element_address(tree, inner, &var storage) |failed| {
                return move failed;
            }
        }
    }
    if !nested {
        if try self.bound_read_storage(tree, index.target) |bound| {
            storage = bound;
        } else if try self.lower_array_storage(tree, index.target, &var storage) |failed| {
            return move failed;
        }
    }
    return self.index_array_storage(tree, index, storage, out);
}

fn (self: &var Lowerer) index_array_storage(
    tree: &var ast::Ast,
    index: ast::IndexExpr,
    storage: Value,
    out: &var Value
) -> !?diagnostic::Diagnostic {
    var position = empty_value();
    let index_expr = index.index orelse return try self.fail0("ir error: array index is missing");
    if try self.lower_expr(tree, index_expr, &var position) |failed| {
        return move failed;
    }
    let array = try self.deref_type(storage.type_name);
    let length_text = try self.module.names.buffer_length_text(array);
    let length = try self.emit_const(self.common.i64_type, length_text);
    let bounds = try self.name("bounds");
    try self.check_index_in_range(index.span, position, length, bounds);
    let elem = try self.module.names.buffer_elem(array);
    let address_type = try self.module.names.prefixed("&var ", elem);
    out.* = try self.emit2(Op::BufferAddr, address_type, storage, position);
    return null;
}

fn (self: &var Lowerer) check_index_in_range(
    span: ast::Span,
    index: Value,
    length: Value,
    kind: Name
) -> !void {
    let unsigned_index = try self.unsigned(index);
    let unsigned_length = try self.unsigned(length);
    return self.cond_fail2(span, ">=", unsigned_index, unsigned_length, kind, index, length);
}

fn (self: &var Lowerer) unsigned(value: Value) -> !Value {
    if !self.is_signed_integer_type_name(value.type_name) {
        return value;
    }
    let u64_type = try self.module.names.intern("u64");
    return self.emit_imm1(Op::Cast, u64_type, u64_type, value);
}

fn (self: &var Lowerer) cond_fail2(
    span: ast::Span,
    operator: []u8,
    left: Value,
    right: Value,
    kind: Name,
    a: Value,
    b: Value
) -> !void {
    let bad = try self.emit_compare(operator, left, right);
    var instr = self.module.blank_instr(empty_value(), Op::CondFail, empty_name(), kind);
    errdefer instr.deinit(self.allocator);
    instr.span = span;
    try instr.args.append(self.allocator, bad);
    try instr.args.append(self.allocator, a);
    try instr.args.append(self.allocator, b);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return;
}

fn (self: &var Lowerer) cond_fail3(
    span: ast::Span,
    operator: []u8,
    left: Value,
    right: Value,
    kind: Name,
    a: Value,
    b: Value,
    c: Value
) -> !void {
    let bad = try self.emit_compare(operator, left, right);
    var instr = self.module.blank_instr(empty_value(), Op::CondFail, empty_name(), kind);
    errdefer instr.deinit(self.allocator);
    instr.span = span;
    try instr.args.append(self.allocator, bad);
    try instr.args.append(self.allocator, a);
    try instr.args.append(self.allocator, b);
    try instr.args.append(self.allocator, c);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return;
}

fn (self: &var Lowerer) emit_compare(operator: []u8, left: Value, right: Value) -> !Value {
    let operand = try self.name(operator);
    return self.emit_op2(Op::Binary, operand, self.common.bool_type, left, right);
}
