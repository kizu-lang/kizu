fn (self: &var Lowerer) meta_capture(tree: &var ast::Ast, form: stdmeta::Form, type_arg: Name, out: &var MetaField) -> !?diagnostic::Diagnostic {
    return try self.fail0("ir error: unported meta_capture");
}

/// Binds one capture for the length of one expansion, the Go
/// `bindMetaField`; `restore_meta` with the mark taken before unbinds it. An
/// empty name binds nothing.
fn (self: &var Lowerer) bind_meta_field(name: Name, field: MetaField) -> !void {
    if is_empty(name) {
        return;
    }
    self.meta_current = self.meta_bindings.add(MetaBinding { parent: self.meta_current, name: name, field: field });
    return;
}

/// Puts the captures in force before a bind back.
fn (self: &var Lowerer) restore_meta(mark: MetaMark) -> void {
    self.meta_current = mark.previous;
    return;
}

/// Returns the capture bound to name, the Go `l.metaFields[name]`.
fn (self: &Lowerer) meta_field(name: Name) -> ?MetaField {
    var current = self.meta_current;
    while current |handle| {
        let binding = self.meta_bindings.at(handle);
        if same_name(binding.name, name) {
            return binding.field;
        }
        current = binding.parent;
    }
    return null;
}

