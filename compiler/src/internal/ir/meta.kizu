fn (self: &var Lowerer) lower_meta_apply(tree: &var ast::Ast, name: Name, type_arg: Name, args: ast::ExpressionList, out: &var Value, handled: &var bool) -> !?diagnostic::Diagnostic {
    handled.* = false;
    return null;
}

fn (self: &var Lowerer) meta_predicate_call(tree: &var ast::Ast, call: ast::CallExpr, out: &var bool) -> !bool {
