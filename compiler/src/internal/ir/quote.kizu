import std::mem;
import std::string;

// Ports Go's strconv.Quote, the `%q` verb the Go IR lowering uses to spell
// string literals (internal/ir/lower.go lowerLiteralExpr), so the Kizu
// lowering prints identical text. The printable-rune predicate carries the
// strconv IsPrint tables of Go 1.22 (strconv/isprint.go) as fixed-width hex
// text generated from the installed toolchain; docs/selfhost-porting.md
// records the gap (no std quoting / UTF-8 / Unicode table API). The
// lowercase hex helpers `append_hex_byte` / `hex_digit` live in generic.kizu.

/// A decoded UTF-8 scalar and its byte width, the Go `utf8.DecodeRune` pair:
/// malformed input is one `65533` of width one.
struct QuoteRune {
    value: i64,
    width: i64
}

/// Spells bytes the way Go's `%q` (the Go `strconv.Quote`) does.
pub fn quote_go(allocator: Allocator, bytes: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try append_quoted(&var out, bytes);
    return move out;
}

/// Ports the Go `appendQuotedWith` for the `"` quote with ASCIIonly and
/// graphicOnly off: an invalid byte is `\x` plus two lowercase hex digits,
/// every decoded rune goes through `append_escaped_rune`.
fn append_quoted(out: &var string::String, bytes: []u8) -> !void {
    try out.append_byte(cast<u8>(34));
    let length = mem::len(bytes);
    var position = 0;
    while position < length {
        let scalar = quote_decode_rune(bytes, position);
        if scalar.width == 1 and scalar.value == 65533 {
            try out.append_bytes("\x");
            try append_hex_byte(out, bytes[position]);
        } else {
            let encoded = bytes[position..position + scalar.width];
            try append_escaped_rune(out, encoded, scalar.value);
        }
        position = position + scalar.width;
    }
    try out.append_byte(cast<u8>(34));
    return;
}

/// Ports the Go `appendEscapedRune` for the `"` quote. `encoded` holds the
/// rune's source bytes, which are what `utf8.AppendRune` re-encodes for a
/// rune that `DecodeRune` accepted. The `!utf8.ValidRune` arm of the Go
/// switch cannot be reached from decoded input and has no port.
fn append_escaped_rune(out: &var string::String, encoded: []u8, value: i64) -> !void {
    if value == 34 or value == 92 {
        try out.append_byte(cast<u8>(92));
        return out.append_byte(cast<u8>(value));
    }
    if quote_is_print(value) {
        return out.append_bytes(encoded);
    }
    if value == 7 {
        return out.append_bytes("\a");
    }
    if value == 8 {
        return out.append_bytes("\b");
    }
    if value == 12 {
        return out.append_bytes("\f");
    }
    if value == 10 {
        return out.append_bytes("\n");
    }
    if value == 13 {
        return out.append_bytes("\r");
    }
    if value == 9 {
        return out.append_bytes("\t");
    }
    if value == 11 {
        return out.append_bytes("\v");
    }
    if value < 32 or value == 127 {
        try out.append_bytes("\x");
        return append_hex_byte(out, cast<u8>(value));
    }
    if value < 65536 {
        try out.append_bytes("\u");
        return append_quote_hex(out, value, 4);
    }
    try out.append_bytes("\U");
    return append_quote_hex(out, value, 8);
}

/// Appends `value` as exactly `digits` lowercase hex digits, most significant
/// first, the Go `lowerhex[r>>uint(s)&0xF]` loop.
fn append_quote_hex(out: &var string::String, value: i64, digits: i64) -> !void {
    var divisor = 1;
    var remaining = digits;
    while remaining > 1 {
        divisor = divisor * 16;
        remaining = remaining - 1;
    }
    while divisor > 0 {
        try out.append_byte(hex_digit((value / divisor) % 16));
        divisor = divisor / 16;
    }
    return;
}

/// Ports the Go `utf8.DecodeRune` width rules: a truncated, overlong, or
/// surrogate sequence and a stray continuation byte decode as `65533` of
/// width one, which the caller tells apart from an encoded U+FFFD by width.
fn quote_decode_rune(bytes: []u8, position: i64) -> QuoteRune {
    let length = mem::len(bytes);
    let first = bytes[position];
    if first < cast<u8>(128) {
        return QuoteRune { value: cast<i64>(first), width: 1 };
    }
    if first >= cast<u8>(194) and first <= cast<u8>(223) and position + 1 < length {
        let second = bytes[position + 1];
        if quote_is_continuation(second) {
            return QuoteRune {
                value: cast<i64>(first - cast<u8>(192)) * 64 +
                    cast<i64>(second - cast<u8>(128)),
                width: 2
            };
        }
    }
    if first >= cast<u8>(224) and first <= cast<u8>(239) and position + 2 < length {
        let second = bytes[position + 1];
        let third = bytes[position + 2];
        let second_valid = quote_is_continuation(second) and
            !(first == cast<u8>(224) and second < cast<u8>(160)) and
            !(first == cast<u8>(237) and second > cast<u8>(159));
        if second_valid and quote_is_continuation(third) {
            return QuoteRune {
                value: cast<i64>(first - cast<u8>(224)) * 4096 +
                    cast<i64>(second - cast<u8>(128)) * 64 +
                    cast<i64>(third - cast<u8>(128)),
                width: 3
            };
        }
    }
    if first >= cast<u8>(240) and first <= cast<u8>(244) and position + 3 < length {
        let second = bytes[position + 1];
        let third = bytes[position + 2];
        let fourth = bytes[position + 3];
        let second_valid = quote_is_continuation(second) and
            !(first == cast<u8>(240) and second < cast<u8>(144)) and
            !(first == cast<u8>(244) and second > cast<u8>(143));
        if second_valid and quote_is_continuation(third) and quote_is_continuation(fourth) {
            return QuoteRune {
                value: cast<i64>(first - cast<u8>(240)) * 262144 +
                    cast<i64>(second - cast<u8>(128)) * 4096 +
                    cast<i64>(third - cast<u8>(128)) * 64 +
                    cast<i64>(fourth - cast<u8>(128)),
                width: 4
            };
        }
    }
    return QuoteRune { value: 65533, width: 1 };
}

/// Reports whether a byte is a UTF-8 continuation byte (10xxxxxx).
fn quote_is_continuation(byte: u8) -> bool {
    return byte >= cast<u8>(128) and byte <= cast<u8>(191);
}

/// Ports the Go `strconv.IsPrint`: the Latin-1 fast path, then the 16-bit
/// range table minus its exception list, then the 32-bit range table whose
/// exception list only covers U+10000..U+1FFFF.
fn quote_is_print(value: i64) -> bool {
    if value <= 255 {
        if value >= 32 and value <= 126 {
            return true;
        }
        if value >= 161 and value <= 255 {
            return value != 173;
        }
        return false;
    }
    if value < 65536 {
        let ranges = print16_table();
        if !print_range_contains(ranges, 4, value) {
            return false;
        }
        let exceptions = not_print16_table();
        return !print_list_contains(exceptions, 4, value);
    }
    let ranges = print32_table();
    if !print_range_contains(ranges, 6, value) {
        return false;
    }
    if value >= 131072 {
        return true;
    }
    let exceptions = not_print32_table();
    return !print_list_contains(exceptions, 4, value - 65536);
}

/// Reports whether a start/end pair table spans `value`: the Go
/// `i >= len(isPrint) || rr < isPrint[i&^1] || isPrint[i|1] < rr` test.
fn print_range_contains(table: []u8, width: i64, value: i64) -> bool {
    let index = print_table_search(table, width, value);
    if index >= print_table_len(table, width) {
        return false;
    }
    let start = index - index % 2;
    if value < print_table_entry(table, width, start) {
        return false;
    }
    return print_table_entry(table, width, start + 1) >= value;
}

/// Reports whether a sorted list table holds `value`: the Go
/// `j < len(isNotPrint) && isNotPrint[j] == rr` test.
fn print_list_contains(table: []u8, width: i64, value: i64) -> bool {
    let index = print_table_search(table, width, value);
    if index >= print_table_len(table, width) {
        return false;
    }
    return print_table_entry(table, width, index) == value;
}

/// Ports the Go `bsearch16` / `bsearch32`: the smallest index whose entry is
/// at least `value`, or the entry count when there is none.
fn print_table_search(table: []u8, width: i64, value: i64) -> i64 {
    var low = 0;
    var high = print_table_len(table, width);
    while low < high {
        let middle = low + (high - low) / 2;
        if print_table_entry(table, width, middle) < value {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

/// Counts the entries of a hex table. Rows are 48 hex digits joined by one
/// newline, so every full 49-byte stretch holds exactly one newline.
fn print_table_len(table: []u8, width: i64) -> i64 {
    let length = mem::len(table);
    return (length - length / 49) / width;
}

/// Reads entry `index` of a hex table with `width` digits per entry: digit
/// position `p` of the joined text sits at byte `p + p / 48` once the row
/// newlines are counted in.
fn print_table_entry(table: []u8, width: i64, index: i64) -> i64 {
    let start = index * width + (index * width) / 48;
    var value = 0;
    var digit = 0;
    while digit < width {
        value = value * 16 + print_table_digit(table[start + digit]);
        digit = digit + 1;
    }
    return value;
}

/// Returns the value of one lowercase hex digit byte.
fn print_table_digit(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return value - 87;
    }
    return value - 48;
}

