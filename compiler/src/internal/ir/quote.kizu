import std::fmt;
import std::string;

// STUB: Go `%q` (strconv.Quote) port pending; deterministic ASCII quoting
// stands in.

/// Spells bytes the way Go's `%q` does.
pub fn quote_go(allocator: Allocator, bytes: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try fmt::append_bytes_literal(&var out, bytes);
    return move out;
}
