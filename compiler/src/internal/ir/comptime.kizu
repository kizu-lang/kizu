import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ownership;
import compiler::internal::staticexpr;
import compiler::internal::stdmath;
import compiler::internal::stdtarget;
import compiler::internal::typ;
import std::mem;

// Mechanical port of internal/ir/comptime.go: `comptime if` and the constant
// evaluation that selects its branch. The Go `(value, ok)` pairs come back as
// the ok flag with the value written through an out parameter.

/// Lowers only the branch selected during compilation, the Go
/// `lowerComptimeIfStmt`.
fn (self: &var Lowerer) lower_comptime_if_stmt(tree: &var ast::Ast, statement: ast::ComptimeIfStmt) -> !?diagnostic::Diagnostic {
    var cond = false;
    if !try self.const_bool(tree, statement.condition, &var cond) {
        return try self.fail0("ir error: comptime if condition must be constant bool");
    }
    if cond {
        return self.lower_block(tree, statement.consequence);
    }
    let alternative = statement.alternative orelse return null;
    return self.lower_block(tree, alternative);
}

/// Evaluates constant boolean expressions used by comptime if, the Go
/// `constBool`.
fn (self: &var Lowerer) const_bool(tree: &var ast::Ast, expression: ast::Expression, out: &var bool) -> !bool {
    if ownership::comptime_expr(tree, expression) |inner| {
        return self.const_bool(tree, inner.expr, out);
    }
    if ownership::bool_expr(tree, expression) |literal| {
        out.* = literal.value;
        return true;
    }
    if ownership::ident_expr(tree, expression) |ident| {
        let name = try self.text_name(tree, ident.name);
        return self.static_bool(name, out);
    }
    if ownership::call_expr(tree, expression) |call| {
        if try self.target_predicate_call(tree, call, out) {
            return true;
        }
        return self.meta_predicate_call(tree, call, out);
    }
    if ownership::prefix_expr(tree, expression) |prefix| {
        var value = false;
        let ok = try self.const_bool(tree, prefix.right, &var value);
        out.* = !value;
        return ok and text_is(tree, prefix.operator, "!");
    }
    if ownership::binary_expr(tree, expression) |binary| {
        return self.const_binary_bool(tree, binary, out);
    }
    return false;
}

/// Reads a bool static parameter, the Go `staticBool`, which reaches the
/// instance being lowered as its literal.
fn (self: &Lowerer) static_bool(name: Name, out: &var bool) -> bool {
    let static = self.static_value(name) orelse return false;
    if !self.name_is(static.typ, "bool") {
        return false;
    }
    out.* = self.name_is(static.text, "true");
    return true;
}

/// Evaluates a constant logical operator, a type comparison, or an integer
/// or float comparison, the Go `constBinaryBool`.
fn (self: &var Lowerer) const_binary_bool(
    tree: &var ast::Ast,
    binary: ast::BinaryExpr,
    out: &var bool
) -> !bool {
    if text_is(tree, binary.operator, "and") or text_is(tree, binary.operator, "or") {
        return self.const_logical_bool(tree, binary, out);
    }
    if text_is(tree, binary.operator, "==") or text_is(tree, binary.operator, "!=") {
        var equal = false;
        if try self.const_type_equal(tree, binary.left, binary.right, &var equal) {
            out.* = equal == text_is(tree, binary.operator, "==");
            return true;
        }
    }
    var left = 0;
    let left_ok = try self.const_int(tree, binary.left, &var left);
    var right = 0;
    let right_ok = try self.const_int(tree, binary.right, &var right);
    if left_ok and right_ok {
        let retained = tree.texts.at(binary.operator.node);
        let operator = retained.as_bytes();
        return compare_const_ints(operator, left, right, out);
    }
    let left_float = try self.const_float(tree, binary.left) orelse return false;
    let right_float = try self.const_float(tree, binary.right) orelse return false;
    let retained = tree.texts.at(binary.operator.node);
    let operator = retained.as_bytes();
    let compared = stdmath::compare(operator, left_float, right_float) orelse return false;
    out.* = compared;
    return true;
}

/// Evaluates f64 compile-time arithmetic, the Go `constFloat`: literals,
/// negation, + - * /, `cast<f64>` of a constant integer, and the std::math
/// calls stdmath computes for this target. The checker has already refused
/// whatever does not evaluate, so null means "not a float expression", not
/// an error.
fn (self: &var Lowerer) const_float(tree: &ast::Ast, expression: ast::Expression) -> !?f64 {
    if ownership::comptime_expr(tree, expression) |inner| {
        return self.const_float(tree, inner.expr);
    }
    if ownership::float_expr(tree, expression) |literal| {
        let retained = tree.texts.at(literal.value.node);
        let bytes = retained.as_bytes();
        return typ::parse_float_literal(self.allocator, bytes);
    }
    if ownership::cast_expr(tree, expression) |converted| {
        let target = try typ::render(self.allocator, &tree.types, converted.target_type);
        defer target.deinit(self.allocator);
        let target_bytes = target.as_bytes();
        if !mem::equal_bytes(target_bytes, "f64") {
            return null;
        }
        var integer = 0;
        if try self.const_int(tree, converted.value, &var integer) {
            return cast<f64>(integer);
        }
        return self.const_float(tree, converted.value);
    }
    if ownership::prefix_expr(tree, expression) |prefix| {
        let value = try self.const_float(tree, prefix.right) orelse return null;
        if !text_is(tree, prefix.operator, "-") {
            return null;
        }
        return -value;
    }
    if ownership::binary_expr(tree, expression) |binary| {
        let left = try self.const_float(tree, binary.left) orelse return null;
        let right = try self.const_float(tree, binary.right) orelse return null;
        let retained = tree.texts.at(binary.operator.node);
        let operator = retained.as_bytes();
        return stdmath::binary(operator, left, right);
    }
    if ownership::call_expr(tree, expression) |call| {
        return self.const_math_call(tree, call);
    }
    return null;
}

/// Evaluates a std::math call on constant f64 arguments, the Go
/// `constMathCall`.
fn (self: &var Lowerer) const_math_call(tree: &ast::Ast, call: ast::CallExpr) -> !?f64 {
    let apply = ownership::type_apply_expr(tree, call.callee) orelse return null;
    if !text_is(tree, apply.type_arg, "f64") {
        return null;
    }
    let name = try self.expression_name(tree, apply.callee);
    let retained = name_text(&self.module.names, name);
    let name_bytes = retained.as_bytes();
    if !stdmath::names(name_bytes) {
        return null;
    }
    var count = 0;
    var first = 0.0;
    while ownership::arg_at(tree, call.args, count) |argument| {
        let value = try self.const_float(tree, argument) orelse return null;
        if count == 0 {
            first = value;
        }
        count = count + 1;
    }
    // Evaluating an argument may intern names, so the spelling is read again
    // rather than held across the loop.
    let again = name_text(&self.module.names, name);
    let again_bytes = again.as_bytes();
    return stdmath::call(again_bytes, count, first, stdtarget::is_native(self.target));
}

/// Answers a compiler-defined std::target predicate and reports whether the
/// call was one.
fn (self: &var Lowerer) target_predicate_call(
    tree: &ast::Ast,
    call: ast::CallExpr,
    out: &var bool
) -> !bool {
    let name = try self.expression_name(tree, call.callee);
    let retained = name_text(&self.module.names, name);
    let name_bytes = retained.as_bytes();
    let predicate = stdtarget::identify(name_bytes) orelse return false;
    if ownership::arg_count(tree, call.args) != 0 {
        return false;
    }
    out.* = stdtarget::evaluate(self.target, predicate);
    return true;
}

/// Compares two type-valued expressions, the Go `constTypeEqual`, which is
/// how a generic body asks what its type parameter was bound to.
fn (self: &var Lowerer) const_type_equal(
    tree: &var ast::Ast,
    left: ast::Expression,
    right: ast::Expression,
    out: &var bool
) -> !bool {
    var left_name = empty_name();
    let left_ok = try self.const_type_name(tree, left, &var left_name);
    var right_name = empty_name();
    let right_ok = try self.const_type_name(tree, right, &var right_name);
    if !left_ok or !right_ok {
        return false;
    }
    out.* = same_name(left_name, right_name);
    return true;
}

/// Resolves an expression that names a type, the Go `constTypeName`.
fn (self: &var Lowerer) const_type_name(tree: &var ast::Ast, expression: ast::Expression, out: &var Name) -> !bool {
    if ownership::comptime_expr(tree, expression) |inner| {
        return self.const_type_name(tree, inner.expr, out);
    }
    if ownership::ident_expr(tree, expression) |ident| {
        let name = try self.text_name(tree, ident.name);
        let args = self.current_args orelse return false;
        let bound = self.bound_type(args, name) orelse return false;
        out.* = bound;
        return true;
    }
    if ownership::type_expr(tree, expression) |typed| {
        let type_name = try self.text_name(tree, typed.type_name);
        out.* = try self.resolve_bound_type(type_name);
        return true;
    }
    return false;
}

/// Evaluates boolean logic for comptime branch selection, the Go
/// `constLogicalBool`.
fn (self: &var Lowerer) const_logical_bool(tree: &var ast::Ast, binary: ast::BinaryExpr, out: &var bool) -> !bool {
    var left = false;
    if !try self.const_bool(tree, binary.left, &var left) {
        return false;
    }
    let is_and = text_is(tree, binary.operator, "and");
    if is_and and !left {
        out.* = false;
        return true;
    }
    if text_is(tree, binary.operator, "or") and left {
        out.* = true;
        return true;
    }
    var right = false;
    if !try self.const_bool(tree, binary.right, &var right) {
        return false;
    }
    if is_and {
        out.* = left and right;
        return true;
    }
    out.* = left or right;
    return true;
}

/// Evaluates constant integer arithmetic used by comptime branches, the Go
/// `constInt`.
fn (self: &var Lowerer) const_int(tree: &ast::Ast, expression: ast::Expression, out: &var i64) -> !bool {
    if ownership::comptime_expr(tree, expression) |inner| {
        return self.const_int(tree, inner.expr, out);
    }
    if ownership::int_expr(tree, expression) |literal| {
        let retained = tree.texts.at(literal.value.node);
        let bytes = retained.as_bytes();
        let value = ownership::decimal_i64(bytes) orelse return false;
        out.* = value;
        return true;
    }
    if ownership::ident_expr(tree, expression) |ident| {
        // An integer-range capture is bound like an `<n: i64>` static value,
        // so the expansion's integer reads through the same binding.
        let name = try self.text_name(tree, ident.name);
        let static = self.static_value(name) orelse return false;
        if !self.name_is(static.typ, "i64") {
            return false;
        }
        // A bound value may be negative: a static expression such as `(-2)`
        // reaches the instance as its decimal text.
        let retained = name_text(&self.module.names, static.text);
        let bytes = retained.as_bytes();
        let value = staticexpr::parse_i64(bytes) orelse return false;
        out.* = value;
        return true;
    }
    if ownership::prefix_expr(tree, expression) |prefix| {
        var value = 0;
        let ok = try self.const_int(tree, prefix.right, &var value);
        if text_is(tree, prefix.operator, "-") {
            out.* = 0 - value;
            return ok;
        }
        if text_is(tree, prefix.operator, "~") {
            out.* = ~value;
            return ok;
        }
        return false;
    }
    if ownership::binary_expr(tree, expression) |binary| {
        var left = 0;
        let left_ok = try self.const_int(tree, binary.left, &var left);
        var right = 0;
        let right_ok = try self.const_int(tree, binary.right, &var right);
        if left_ok and right_ok {
            let retained = tree.texts.at(binary.operator.node);
            let operator = retained.as_bytes();
            return eval_const_int(operator, left, right, out);
        }
    }
    return false;
}

/// Evaluates integer arithmetic for comptime branch selection, the Go
/// `evalConstInt`.
fn eval_const_int(op: []u8, left: i64, right: i64, out: &var i64) -> bool {
    if mem::equal_bytes(op, "+") {
        out.* = left + right;
        return true;
    }
    if mem::equal_bytes(op, "-") {
        out.* = left - right;
        return true;
    }
    if mem::equal_bytes(op, "*") {
        out.* = left * right;
        return true;
    }
    if mem::equal_bytes(op, "/") {
        if right == 0 {
            return false;
        }
        out.* = left / right;
        return true;
    }
    if mem::equal_bytes(op, "%") {
        if right == 0 {
            return false;
        }
        out.* = left % right;
        return true;
    }
    if mem::equal_bytes(op, "&") {
        out.* = left & right;
        return true;
    }
    if mem::equal_bytes(op, "|") {
        out.* = left | right;
        return true;
    }
    if mem::equal_bytes(op, "^") {
        out.* = left ^ right;
        return true;
    }
    if mem::equal_bytes(op, "<<") or mem::equal_bytes(op, ">>") {
        if right < 0 {
            return false;
        }
        out.* = typ::shift_i64(op, left, right);
        return true;
    }
    return false;
}

/// Evaluates integer comparisons for comptime branch selection, the Go
/// `compareConstInts`.
fn compare_const_ints(op: []u8, left: i64, right: i64, out: &var bool) -> bool {
    if mem::equal_bytes(op, "==") {
        out.* = left == right;
        return true;
    }
    if mem::equal_bytes(op, "!=") {
        out.* = left != right;
        return true;
    }
    if mem::equal_bytes(op, "<") {
        out.* = left < right;
        return true;
    }
    if mem::equal_bytes(op, "<=") {
        out.* = left <= right;
        return true;
    }
    if mem::equal_bytes(op, ">") {
        out.* = left > right;
        return true;
    }
    if mem::equal_bytes(op, ">=") {
        out.* = left >= right;
        return true;
    }
    return false;
}
