import std::array;
import std::string;

// Mechanical port of internal/ir/dump.go: the stable text form of a module,
// what `kizu ir` prints.

/// Formats a module as a stable text representation, the Go `Dump`: every
/// function in order, without the trailing newline.
pub fn render(allocator: Allocator, module: &Module) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        try append_function(allocator, &var out, module, function);
    }
    while out.len() > 0 and ends_with_newline(&out) {
        try out.truncate(out.len() - 1);
    }
    return move out;
}

fn ends_with_newline(out: &string::String) -> bool {
    let bytes = out.as_bytes();
    return bytes[out.len() - 1] == cast<u8>(10);
}

/// Writes one function dump, the Go `writeFunction`.
pub fn append_function(allocator: Allocator, out: &var string::String, module: &Module, function: Function) -> !void {
    let node = module.function_nodes.at(function.node);
    if !is_empty(node.export_abi) {
        try out.append_bytes(allocator, "export ");
        try out.append_byte(allocator, cast<u8>(34));
        try module.names.append_to(out, node.export_abi);
        try out.append_byte(allocator, cast<u8>(34));
        try out.append_byte(allocator, cast<u8>(32));
    }
    try out.append_bytes(allocator, "fn ");
    try module.names.append_to(out, node.name);
    try out.append_byte(allocator, cast<u8>(40));
    var index = 0;
    while node.params.get(index) |param| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        index = index + 1;
        try append_value(allocator, out, module, param.value());
    }
    try out.append_bytes(allocator, ") -> ");
    try module.names.append_to(out, node.return_type);
    try out.append_bytes(allocator, " {");
    try out.append_byte(allocator, cast<u8>(10));
    var block_index = 0;
    while node.blocks.get(block_index) |block| {
        block_index = block_index + 1;
        try append_block(allocator, out, module, block);
    }
    try out.append_bytes(allocator, "}");
    return out.append_byte(allocator, cast<u8>(10));
}

/// Writes one basic block.
fn append_block(allocator: Allocator, out: &var string::String, module: &Module, block: Block) -> !void {
    let node = module.blocks.at(block.node);
    try module.names.append_to(out, node.name);
    try out.append_bytes(allocator, ":");
    try out.append_byte(allocator, cast<u8>(10));
    var index = 0;
    while node.instrs.get(index) |instr| {
        index = index + 1;
        try out.append_bytes(allocator, "  ");
        try append_instr(allocator, out, module, instr);
        try out.append_byte(allocator, cast<u8>(10));
    }
    if node.terminator.op != TermOp::None {
        try out.append_bytes(allocator, "  ");
        try append_terminator(allocator, out, module, node.terminator);
        try out.append_byte(allocator, cast<u8>(10));
    }
    return;
}

/// Formats one instruction.
fn append_instr(allocator: Allocator, out: &var string::String, module: &Module, instr: Instr) -> !void {
    let node = module.instrs.at(instr.node);
    if node.op == Op::Const {
        try append_value(allocator, out, module, node.result);
        try out.append_bytes(allocator, " = const ");
        return module.names.append_to(out, node.immediate);
    }
    if node.op == Op::Phi {
        try append_value(allocator, out, module, node.result);
        try out.append_bytes(allocator, " = phi ");
        return append_incoming(allocator, out, module, &node.incoming);
    }
    if node.op == Op::StructNew {
        try append_value(allocator, out, module, node.result);
        try out.append_bytes(allocator, " = struct.new {");
        try append_fields(allocator, out, module, &node.fields);
        return out.append_bytes(allocator, "}");
    }
    if node.op == Op::CondFail {
        try out.append_bytes(allocator, "cond_fail ");
        if node.args.get(0) |first| {
            try append_value(allocator, out, module, first);
        }
        try out.append_bytes(allocator, ", ");
        try module.names.append_to(out, node.immediate);
        try out.append_bytes(allocator, "(");
        try append_values_from(allocator, out, module, &node.args, 1);
        return out.append_bytes(allocator, ")");
    }
    return append_generic_instr(out, module, node);
}

/// Formats a normal non-special instruction.
fn append_generic_instr(out: &var string::String, module: &Module, node: &InstrNode) -> !void {
    var args = string::new(module.names.allocator);
    defer args.deinit(module.names.allocator);
    try append_values_from(module.names.allocator, &var args, module, &node.args, 0);
    if !is_empty(node.immediate) {
        if args.len() > 0 {
            try args.append_bytes(module.names.allocator, ", ");
        }
        try module.names.append_to(&var args, node.immediate);
    }
    if node.cleanups.len() > 0 {
        if args.len() > 0 {
            try args.append_bytes(module.names.allocator, ", ");
        }
        try args.append_bytes(module.names.allocator, "cleanup ");
        try append_cleanups(module.names.allocator, &var args, module, &node.cleanups);
    }
    if module.names.is(node.result.type_name, "void") {
        if !is_empty(node.extern_abi) {
            try append_extern_prefix(out, module, node.extern_abi);
        }
        try append_op(module.names.allocator, out, &module.names, node.op, node.operand);
        try out.append_bytes(module.names.allocator, " ");
        return out.append_string(module.names.allocator, &args);
    }
    try append_value(module.names.allocator, out, module, node.result);
    try out.append_bytes(module.names.allocator, " = ");
    if !is_empty(node.extern_abi) {
        try append_extern_prefix(out, module, node.extern_abi);
    }
    try append_op(module.names.allocator, out, &module.names, node.op, node.operand);
    if args.len() == 0 {
        return;
    }
    try out.append_bytes(module.names.allocator, " ");
    return out.append_string(module.names.allocator, &args);
}

fn append_extern_prefix(out: &var string::String, module: &Module, abi: Name) -> !void {
    try out.append_bytes(module.names.allocator, "extern ");
    try out.append_byte(module.names.allocator, cast<u8>(34));
    try module.names.append_to(out, abi);
    try out.append_byte(module.names.allocator, cast<u8>(34));
    return out.append_byte(module.names.allocator, cast<u8>(32));
}

/// Formats deferred cleanups attached to a fallible instruction.
fn append_cleanups(allocator: Allocator, out: &var string::String, module: &Module, cleanups: &array::Array<Cleanup>) -> !void {
    var index = 0;
    while cleanups.get(index) |cleanup| {
        if index > 0 {
            try out.append_bytes(allocator, "; ");
        }
        index = index + 1;
        if !is_empty(cleanup.extern_abi) {
            try append_extern_prefix(out, module, cleanup.extern_abi);
        }
        try append_op(allocator, out, &module.names, cleanup.op, cleanup.operand);
        try out.append_bytes(allocator, " ");
        try append_value(allocator, out, module, cleanup.arg);
        if !is_empty(cleanup.allocator.name) {
            try out.append_bytes(allocator, ", ");
            try append_value(allocator, out, module, cleanup.allocator);
        }
    }
    return;
}

/// Formats one block terminator.
fn append_terminator(allocator: Allocator, out: &var string::String, module: &Module, term: Terminator) -> !void {
    if term.op == TermOp::Return {
        try out.append_bytes(allocator, "return ");
        return append_value(allocator, out, module, term.value);
    }
    if term.op == TermOp::Jump {
        try out.append_bytes(allocator, "jump ");
        return module.names.append_to(out, term.target);
    }
    if term.op == TermOp::Branch {
        try out.append_bytes(allocator, "branch ");
        try append_value(allocator, out, module, term.cond);
        try out.append_bytes(allocator, ", ");
        try module.names.append_to(out, term.target);
        try out.append_bytes(allocator, ", ");
        return module.names.append_to(out, term.else_target);
    }
    return out.append_bytes(allocator, "unreachable");
}

/// Formats a typed value reference, the Go `Value.String`.
pub fn append_value(allocator: Allocator, out: &var string::String, module: &Module, value: Value) -> !void {
    try module.names.append_to(out, value.name);
    if is_empty(value.type_name) {
        return;
    }
    try out.append_bytes(allocator, ": ");
    return module.names.append_to(out, value.type_name);
}

/// Formats instruction operands from position on, the Go `formatValues`.
fn append_values_from(allocator: Allocator, out: &var string::String, module: &Module, values: &array::Array<Value>, start: i64) -> !void {
    var index = start;
    while values.get(index) |value| {
        if index > start {
            try out.append_bytes(allocator, ", ");
        }
        index = index + 1;
        try append_value(allocator, out, module, value);
    }
    return;
}

/// Formats phi incoming edges.
fn append_incoming(allocator: Allocator, out: &var string::String, module: &Module, incoming: &array::Array<Incoming>) -> !void {
    var index = 0;
    while incoming.get(index) |item| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        index = index + 1;
        try out.append_bytes(allocator, "[");
        try module.names.append_to(out, item.block);
        try out.append_bytes(allocator, ", ");
        try append_value(allocator, out, module, item.value);
        try out.append_bytes(allocator, "]");
    }
    return;
}

/// Formats struct field initializers.
fn append_fields(allocator: Allocator, out: &var string::String, module: &Module, fields: &array::Array<FieldArg>) -> !void {
    var index = 0;
    while fields.get(index) |field| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        index = index + 1;
        try module.names.append_to(out, field.name);
        try out.append_bytes(allocator, ": ");
        try append_value(allocator, out, module, field.value);
    }
    return;
}
