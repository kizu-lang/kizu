import std::array;
import std::map;
import std::mem;
import std::string;

// Mechanical port of internal/ir/reachable.go: dropping the functions no
// root reaches through direct calls. Go keys its function map and reachable
// set by the Go string of a function name; here they are keyed by the bytes
// of the interned Name.

/// Removes module functions that cannot be reached from the supplied roots
/// through direct calls or a function address taken on a reachable path, the
/// Go `KeepReachableFunctions`. Calls to symbols outside the module do not add
/// an edge.
pub fn keep_reachable_functions(allocator: Allocator, module: &var Module, roots: &array::Array<string::String>) -> !void {
    return keep_reachable(
        allocator, module, roots, "", true
    );
}

/// Removes functions outside one target's entry closure. Only exports for
/// export_abi become additional host roots; empty means no explicit exports.
pub fn keep_target_reachable_functions(
    allocator: Allocator,
    module: &var Module,
    roots: &array::Array<string::String>,
    export_abi: []u8
) -> !void {
    return keep_reachable(
        allocator, module, roots, export_abi, false
    );
}

fn keep_reachable(
    allocator: Allocator,
    module: &var Module,
    roots: &array::Array<string::String>,
    export_abi: []u8,
    all_exports: bool
) -> !void {
    var functions = map::new<[]u8, Function>(allocator);
    defer functions.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let name = module.function_name(function);
        let retained = name_text(&module.names, name);
        let bytes = retained.as_bytes();
        try functions.insert(allocator, bytes, function);
    }
    var reachable = map::new<[]u8, bool>(allocator);
    defer reachable.deinit(allocator);
    var queue = array::new<Function>(allocator);
    defer queue.deinit(allocator);
    index = 0;
    while roots.at(index) |root| {
        index = index + 1;
        let root_bytes = root.as_bytes();
        if functions.get(root_bytes) |function| {
            if !reachable.contains(root_bytes) {
                try reachable.insert(allocator, root_bytes, true);
                try queue.append(allocator, function);
            }
        }
    }
    index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let node = module.function_nodes.at(function.node);
        if is_empty(node.export_abi) {
            continue;
        }
        if !all_exports {
            let retained_abi = name_text(&module.names, node.export_abi);
            let abi_bytes = retained_abi.as_bytes();
            if !mem::equal_bytes(abi_bytes, export_abi) {
                continue;
            }
        }
        let retained = name_text(&module.names, node.name);
        let bytes = retained.as_bytes();
        if !reachable.contains(bytes) {
            try reachable.insert(allocator, bytes, true);
            try queue.append(allocator, function);
        }
    }
    if queue.len() == 0 {
        return;
    }
    var head = 0;
    while queue.get(head) |function| {
        head = head + 1;
        var callees = try direct_callees(allocator, module, function);
        defer callees.deinit(allocator);
        var callee_index = 0;
        while callees.get(callee_index) |callee| {
            callee_index = callee_index + 1;
            try mark_reachable(allocator, module, &functions, &var reachable, &var queue, callee);
        }
    }
    var kept = array::new<Function>(allocator);
    defer kept.deinit(allocator);
    index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let name = module.function_name(function);
        let retained = name_text(&module.names, name);
        let bytes = retained.as_bytes();
        if reachable.contains(bytes) {
            try kept.append(allocator, function);
        }
    }
    module.functions.clear(allocator);
    index = 0;
    while kept.get(index) |function| {
        index = index + 1;
        try module.functions.append(allocator, function);
    }
    return keep_referenced_error_sets(allocator, module);
}

/// Removes the error sets no kept function names in a type, the Go
/// `KeepReferencedErrorSets`. std comes with every program (SPEC §14.1) and
/// declares its sets in modules the program may never call into; a set no
/// reachable code can carry has no spelling to report, so it leaves with the
/// code that would have carried it. A combined set keeps the sets it takes
/// its members from, since a value of the combined type holds their codes.
pub fn keep_referenced_error_sets(allocator: Allocator, module: &var Module) -> !void {
    var referenced = map::new<[]u8, bool>(allocator);
    defer referenced.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let node = module.function_nodes.at(function.node);
        var param_index = 0;
        while node.params.get(param_index) |param| {
            param_index = param_index + 1;
            try note_error_sets(allocator, module, &var referenced, param.type_name);
        }
        try note_error_sets(allocator, module, &var referenced, node.return_type);
        var block_index = 0;
        while node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let instr_node = module.instrs.at(instr.node);
                try note_error_sets(allocator, module, &var referenced, instr_node.result.type_name);
                var arg_index = 0;
                while instr_node.args.get(arg_index) |arg| {
                    arg_index = arg_index + 1;
                    try note_error_sets(allocator, module, &var referenced, arg.type_name);
                }
                try note_error_sets(allocator, module, &var referenced, instr_node.immediate);
            }
            try note_error_sets(allocator, module, &var referenced, block_node.terminator.value.type_name);
        }
    }
    // The origins closure is a work list; the order it settles in does not
    // matter, so the list is popped rather than walked.
    var pending = array::new<string::String>(allocator);
    defer pending.deinit(allocator);
    var key_index = 0;
    while referenced.key_at(key_index) |key| {
        key_index = key_index + 1;
        try pending.append(allocator, try string::from_bytes(allocator, key));
    }
    while pending.pop() |name| {
        defer name.deinit(allocator);
        let name_bytes = name.as_bytes();
        var origins = array::new<string::String>(allocator);
        defer origins.deinit(allocator);
        if module.error_sets.at(name_bytes) |set| {
            var origin_index = 0;
            while set.origins.get(origin_index) |origin| {
                origin_index = origin_index + 1;
                let origin_text = name_text(&module.names, origin);
                let origin_bytes = origin_text.as_bytes();
                if !referenced.contains(origin_bytes) {
                    try referenced.insert(allocator, origin_bytes, true);
                    try origins.append(allocator, try string::from_bytes(allocator, origin_bytes));
                }
            }
        }
        while origins.pop() |origin| {
            try pending.append(allocator, move origin);
        }
    }
    // The names come out first: a removal moves the entries behind it, so
    // the walk that finds them cannot be the one that removes them.
    var dropped = array::new<string::String>(allocator);
    defer dropped.deinit(allocator);
    var set_index = 0;
    while module.error_sets.key_at(set_index) |name| {
        set_index = set_index + 1;
        if !referenced.contains(name) {
            try dropped.append(allocator, try string::from_bytes(allocator, name));
        }
    }
    while dropped.pop() |name| {
        defer name.deinit(allocator);
        let name_bytes = name.as_bytes();
        if module.error_sets.remove(allocator, name_bytes) |set| {
            set.deinit(allocator);
        }
    }
    return;
}

/// Marks every error set a type spelling is built from, the Go `typeNames`
/// walk: the spelling is split on anything that is not a name byte, so a set
/// is found inside `std::mem::Error!void` and not inside a longer name.
fn note_error_sets(
    allocator: Allocator,
    module: &Module,
    referenced: &var map::Map<[]u8, bool>,
    typ: Name
) -> !void {
    if is_empty(typ) {
        return;
    }
    let retained = name_text(&module.names, typ);
    let bytes = retained.as_bytes();
    let length = mem::len(bytes);
    var start = 0;
    var index = 0;
    while index <= length {
        var boundary = index == length;
        if !boundary {
            boundary = !is_type_name_byte(bytes[index]);
        }
        if boundary {
            if index > start {
                let token = bytes[start..index];
                if module.error_sets.contains(token) and !referenced.contains(token) {
                    try referenced.insert(allocator, token, true);
                }
            }
            start = index + 1;
        }
        index = index + 1;
    }
    return;
}

/// Reports whether a byte belongs to a type name: `_`, `:`, a digit, or an
/// ASCII letter.
fn is_type_name_byte(byte: u8) -> bool {
    if byte == cast<u8>(95) or byte == cast<u8>(58) {
        return true;
    }
    if byte >= cast<u8>(48) and byte <= cast<u8>(57) {
        return true;
    }
    if byte >= cast<u8>(97) and byte <= cast<u8>(122) {
        return true;
    }
    return byte >= cast<u8>(65) and byte <= cast<u8>(90);
}

/// Queues one callee the first time a reachable function names it, the body
/// of the Go work-list loop: a symbol the module does not define adds
/// nothing.
fn mark_reachable(
    allocator: Allocator,
    module: &Module,
    functions: &map::Map<[]u8, Function>,
    reachable: &var map::Map<[]u8, bool>,
    queue: &var array::Array<Function>,
    callee: Name
) -> !void {
    let retained = name_text(&module.names, callee);
    let bytes = retained.as_bytes();
    let function = functions.get(bytes) orelse return;
    if reachable.contains(bytes) {
        return;
    }
    try reachable.insert(allocator, bytes, true);
    return queue.append(allocator, function);
}

/// Returns direct call targets from a function body and its deferred cleanup
/// paths, the Go `directCallees`.
fn direct_callees(allocator: Allocator, module: &Module, function: Function) -> !array::Array<Name> {
    var callees = array::new<Name>(allocator);
    errdefer callees.deinit(allocator);
    let node = module.function_nodes.at(function.node);
    var index = 0;
    while node.blocks.get(index) |block| {
        index = index + 1;
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            let instr_node = module.instrs.at(instr.node);
            if is_empty(instr_node.extern_abi) {
                if direct_callee(instr_node.op, instr_node.operand) |callee| {
                    try callees.append(allocator, callee);
                }
            }
            var cleanup_index = 0;
            while instr_node.cleanups.get(cleanup_index) |cleanup| {
                cleanup_index = cleanup_index + 1;
                if is_empty(cleanup.extern_abi) {
                    if direct_callee(cleanup.op, cleanup.operand) |callee| {
                        try callees.append(allocator, callee);
                    }
                }
            }
        }
    }
    return move callees;
}

/// Decodes one operation that makes a function reachable, the Go
/// `directCallee`: a direct call and taking a function's address both name the
/// symbol whose body the module must keep.
fn direct_callee(op: Op, operand: Name) -> ?Name {
    if op == Op::Call or op == Op::FuncAddr {
        return operand;
    }
    return null;
}
