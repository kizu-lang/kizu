import std::arena;
import std::map;

// An env binds the names in scope to the SSA values they currently hold, and
// keeps the order the names were bound in: a phi node is created by walking
// the names a merge has to reconcile, so the walk has to be deterministic. An
// EnvStore retains every env of one lowering in an arena and hands out copy
// handles, and an env is one map from name id to binding: std::map iterates in
// insertion order, so the one map keeps both the bindings and their order.

/// Identifies one environment retained by an EnvStore.
pub struct EnvHandle {
    node: arena::Handle<EnvNode>,
}

struct EnvNode {
    entries: map::Map<i64, EnvEntry>,
}

struct EnvEntry {
    name: Name,
    value: Value,
}

/// Retains every environment one lowering creates.
pub struct EnvStore {
    allocator: Allocator,
    envs: arena::Arena<EnvNode>,
}

pub fn new_env_store(allocator: Allocator) -> EnvStore {
    return EnvStore { allocator: allocator, envs: arena::new<EnvNode>(allocator) };
}

fn (self: EnvStore) deinit(allocator: Allocator) -> void {
    self.envs.deinit(allocator);
    return;
}

/// Returns an environment with nothing bound.
pub fn (self: &var EnvStore) new_env() -> !EnvHandle {
    return EnvHandle {
        node: try self.envs.add(self.allocator, EnvNode { entries: map::new<i64, EnvEntry>(self.allocator) })
    };
}

/// Returns the value bound to name.
pub fn (self: &EnvStore) get(env: EnvHandle, name: Name) -> ?Value {
    let node = self.envs.at(env.node);
    if node.entries.get(name_id(name)) |entry| {
        return entry.value;
    }
    return null;
}

/// Binds name to value. It is not named `set`: a `set` method taking `&var
/// self` would make the IR lowering treat every `x.set(...)` receiver as
/// storage. Rebinding a name that is already bound leaves it where it is, so
/// an assignment in a loop body does not move the name to the end and reorder
/// the header phis.
pub fn (self: &var EnvStore) bind(
    allocator: Allocator,
    env: EnvHandle,
    name: Name,
    value: Value
) -> !void {
    if self.envs.at_mut(env.node) |node| {
        let key = name_id(name);
        if node.entries.at_mut(key) |entry| {
            entry.* = EnvEntry { name: name, value: value };
            return;
        }
        return node.entries.insert(allocator, key, EnvEntry { name: name, value: value });
    }
    return;
}

/// Unbinds name, which is what a scope does to its declarations when it ends.
/// The map lookup finds the name wherever it was bound, and the rest keep the
/// order they were bound in.
pub fn (self: &var EnvStore) unbind(env: EnvHandle, name: Name) -> !void {
    if self.envs.at_mut(env.node) |node| {
        let _ = node.entries.remove(self.allocator, name_id(name));
    }
    return;
}

/// Returns the name bound at position in binding order; null past the last.
pub fn (self: &EnvStore) name_at(env: EnvHandle, position: i64) -> ?Name {
    let node = self.envs.at(env.node);
    let key = node.entries.key_at(position) orelse return null;
    if node.entries.get(key) |entry| {
        return entry.name;
    }
    return null;
}

/// Returns an independent copy, for lowering a branch that must not disturb
/// the environment its siblings start from. It is named clone_env for the
/// reason bind is not named `set`.
pub fn (self: &var EnvStore) clone_env(env: EnvHandle) -> !EnvHandle {
    var entries = map::new<i64, EnvEntry>(self.allocator);
    errdefer entries.deinit(self.allocator);
    let source = self.envs.at(env.node);
    var index = 0;
    while source.entries.key_at(index) |key| {
        index = index + 1;
        if source.entries.get(key) |entry| {
            try entries.insert(self.allocator, key, entry);
        }
    }
    return EnvHandle { node: try self.envs.add(self.allocator, EnvNode { entries: move entries }) };
}
