import std::arena;
import std::array;

// Mechanical port of internal/ir/env.go. An env binds the names in scope to
// the SSA values they currently hold, and keeps the order the names were
// bound in: a phi node is created by walking the names a merge has to
// reconcile, so the walk has to be deterministic. Go holds envs by pointer
// and clones them per branch; here an EnvStore retains every env of one
// lowering in an arena and hands out copy handles, and an env is one ordered
// list of bindings, which is both the Go `order` and the Go `values` map.

/// Identifies one environment retained by an EnvStore.
pub struct EnvHandle {
    node: arena::Handle<EnvNode>
}

struct EnvNode {
    entries: array::Array<EnvEntry>
}

struct EnvEntry {
    name: Name,
    value: Value
}

/// Retains every environment one lowering creates.
pub struct EnvStore {
    allocator: Allocator,
    envs: arena::Arena<EnvNode>
}

pub fn new_env_store(allocator: Allocator) -> EnvStore {
    return EnvStore { allocator: allocator, envs: arena::new<EnvNode>(allocator) };
}

fn (self: EnvStore) deinit(allocator: Allocator) -> void {
    self.envs.deinit(allocator);
    return;
}

/// Returns an environment with nothing bound, the Go `newEnv`.
pub fn (self: &var EnvStore) new_env() -> EnvHandle {
    return EnvHandle {
        node: self.envs.add(EnvNode { entries: array::new<EnvEntry>(self.allocator) })
    };
}

/// Returns the value bound to name, the Go `env.get`.
pub fn (self: &EnvStore) get(env: EnvHandle, name: Name) -> ?Value {
    let node = self.envs.at(env.node);
    var index = 0;
    while node.entries.get(index) |entry| {
        if same_name(entry.name, name) {
            return entry.value;
        }
        index = index + 1;
    }
    return null;
}

/// Binds name to value, the Go `env.set` (named bind here: a `set` method taking `&var self` would make the IR lowering treat every `x.set(...)` receiver as storage). Rebinding a name that is already
/// bound leaves it where it is, so an assignment in a loop body does not move
/// the name to the end and reorder the header phis.
pub fn (self: &var EnvStore) bind(env: EnvHandle, name: Name, value: Value) -> !void {
    let allocator = self.allocator;
    if self.envs.at_mut(env.node) |node| {
        var index = 0;
        while node.entries.get(index) |entry| {
            if same_name(entry.name, name) {
                return node.entries.set(index, EnvEntry { name: name, value: value });
            }
            index = index + 1;
        }
        return node.entries.append(allocator, EnvEntry { name: name, value: value });
    }
    return;
}

/// Unbinds name, the Go `env.remove`, which is what a scope does to its
/// declarations when it ends.
pub fn (self: &var EnvStore) unbind(env: EnvHandle, name: Name) -> !void {
    if self.envs.at_mut(env.node) |node| {
        var found = -1;
        var index = 0;
        while node.entries.get(index) |entry| {
            if same_name(entry.name, name) {
                found = index;
            }
            index = index + 1;
        }
        if found < 0 {
            return;
        }
        let length = node.entries.len();
        var shift = found + 1;
        while shift < length {
            if node.entries.get(shift) |entry| {
                try node.entries.set(shift - 1, entry);
            }
            shift = shift + 1;
        }
        let _ = node.entries.pop();
    }
    return;
}

/// Returns the name bound at position in binding order, the Go `env.names()`
/// read one entry at a time; null past the last.
pub fn (self: &EnvStore) name_at(env: EnvHandle, position: i64) -> ?Name {
    let node = self.envs.at(env.node);
    if node.entries.get(position) |entry| {
        return entry.name;
    }
    return null;
}

/// Returns an independent copy, the Go `env.clone` (named clone_env here: see bind), for lowering a branch
/// that must not disturb the environment its siblings start from.
pub fn (self: &var EnvStore) clone_env(env: EnvHandle) -> !EnvHandle {
    var entries = array::new<EnvEntry>(self.allocator);
    errdefer entries.deinit(self.allocator);
    let source = self.envs.at(env.node);
    var index = 0;
    while source.entries.get(index) |entry| {
        try entries.append(self.allocator, entry);
        index = index + 1;
    }
    return EnvHandle { node: self.envs.add(EnvNode { entries: move entries }) };
}
