import compiler::internal::diagnostic;
import compiler::internal::stdmath;
import compiler::internal::stdtarget;
import compiler::internal::typ;
import std::array;
import std::float;
import std::map;
import std::math;
import std::mem;

pub fn optimize(allocator: Allocator, module: &var Module, target: stdtarget::Target) -> !?diagnostic::Diagnostic {
    try inline_calls(allocator, module, stdtarget::evaluate(target, stdtarget::Predicate::IsGpu));
    try eliminate_tail_recursion(allocator, module);
    try propagate_constants(allocator, module);
    try fold_constant_tables(allocator, module);
    try forward_slot_reads(allocator, module);
    try copy_propagate(allocator, module);
    try forward_field_loads(allocator, module);
    try eliminate_bounds_checks(allocator, module);
    try simplify_branches(allocator, module);
    try remove_empty_loops(allocator, module);
    try dead_code_eliminate(allocator, module);
    if !stdtarget::is_native(target) {
        try reshape_for_engine(allocator, module);
    }
    return verify(allocator, module);
}

pub fn reshape_for_engine(allocator: Allocator, module: &var Module) -> !void {
    try eliminate_common_subexpressions(allocator, module);
    try eliminate_bounds_checks(allocator, module);
    try simplify_branches(allocator, module);
    try version_loops_for_bounds(allocator, module);
    try simplify_branches(allocator, module);
    try rotate_loops(allocator, module);
    try constant_fold(allocator, module);
    try simplify_branches(allocator, module);
    return dead_code_eliminate(allocator, module);
}

fn constant_fold(allocator: Allocator, module: &var Module) -> !void {
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let _ = try fold_constants_in(allocator, module, function);
    }
    return;
}

fn propagate_constants(allocator: Allocator, module: &var Module) -> !void {
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        var round = 0;
        while round < propagation_rounds() {
            round = round + 1;
            let _ = try fold_constants_in(allocator, module, function);
            if !(try simplify_branches_in(allocator, module, function)) {
                break;
            }
        }
    }
    return;
}

fn propagation_rounds() -> i64 {
    return 8;
}

fn fold_constants_in(allocator: Allocator, module: &var Module, function: Function) -> !bool {
    var consts = map::new<i64, i64>(allocator);
    defer consts.deinit(allocator);
    var floats = map::new<i64, f64>(allocator);
    defer floats.deinit(allocator);
    var block_index = 0;
    while function_block_at(module, function, block_index) |block| {
        block_index = block_index + 1;
        var instr_index = 0;
        while block_instr_at(module, block, instr_index) |instr| {
            instr_index = instr_index + 1;
            try record_constant(allocator, module, instr, &var consts);
            try record_float_constant(allocator, module, instr, &var floats);
        }
    }
    var folded = false;
    var phis_folded = false;
    var changed = true;
    while changed {
        changed = false;
        block_index = 0;
        while function_block_at(module, function, block_index) |block| {
            block_index = block_index + 1;
            var instr_index = 0;
            while block_instr_at(module, block, instr_index) |instr| {
                instr_index = instr_index + 1;
                if try fold_instr(allocator, module, instr, &var consts) {
                    changed = true;
                } else if try fold_float_instr(allocator, module, instr, &var consts, &var floats) {
                    changed = true;
                } else if try fold_phi(allocator, module, instr, &var consts, &var floats) {
                    changed = true;
                    phis_folded = true;
                }
            }
        }
        if changed {
            folded = true;
        }
    }
    if phis_folded {
        try group_phis(allocator, module, function);
    }
    return folded;
}

fn group_phis(allocator: Allocator, module: &var Module, function: Function) -> !void {
    var block_index = 0;
    while function_block_at(module, function, block_index) |block| {
        block_index = block_index + 1;
        var phis = array::new<Instr>(allocator);
        defer phis.deinit(allocator);
        var rest = array::new<Instr>(allocator);
        defer rest.deinit(allocator);
        var instr_index = 0;
        while block_instr_at(module, block, instr_index) |instr| {
            instr_index = instr_index + 1;
            if module.instrs.at(instr.node).op == Op::Phi {
                try phis.append(allocator, instr);
            } else {
                try rest.append(allocator, instr);
            }
        }
        var index = 0;
        while rest.get(index) |instr| {
            index = index + 1;
            try phis.append(allocator, instr);
        }
        try set_block_instrs(allocator, module, block, &phis);
    }
    return;
}

fn copy_propagate(allocator: Allocator, module: &var Module) -> !void {
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        var copies = map::new<[]u8, Value>(allocator);
        defer copies.deinit(allocator);
        var block_index = 0;
        while function_block_at(module, function, block_index) |block| {
            block_index = block_index + 1;
            var instr_index = 0;
            while block_instr_at(module, block, instr_index) |instr| {
                instr_index = instr_index + 1;
                try replace_args(module, instr, &copies);
                try record_copy(allocator, module, instr, &var copies);
            }
            replace_terminator_args(module, block, &copies);
        }
    }
    return;
}

fn record_copy(allocator: Allocator, module: &Module, instr: Instr, copies: &var map::Map<[]u8, Value>) -> !void {
    let node = module.instrs.at(instr.node);
    if node.op != Op::Id or node.args.len() != 1 {
        return;
    }
    let source = node.args.get_or_panic(0);
    let result_text = name_text(&module.names, node.result.name);
    let result_bytes = result_text.as_bytes();
    return copies.insert(allocator, result_bytes, source);
}

fn dead_code_eliminate(allocator: Allocator, module: &var Module) -> !void {
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        var used = try used_values(allocator, module, function);
        defer used.deinit(allocator);
        var block_index = 0;
        while function_block_at(module, function, block_index) |block| {
            block_index = block_index + 1;
            try keep_live_instrs(allocator, module, block, &used);
        }
    }
    return;
}

fn function_block_at(module: &Module, function: Function, index: i64) -> ?Block {
    let node = module.function_nodes.at(function.node);
    return node.blocks.get(index);
}

fn block_instr_at(module: &Module, block: Block, index: i64) -> ?Instr {
    let node = module.blocks.at(block.node);
    return node.instrs.get(index);
}

fn record_constant(allocator: Allocator, module: &Module, instr: Instr, consts: &var map::Map<i64, i64>) -> !void {
    let node = module.instrs.at(instr.node);
    if node.op != Op::Const or !module.names.is(node.result.type_name, "i64") {
        return;
    }
    let immediate_text = name_text(&module.names, node.immediate);
    let immediate_bytes = immediate_text.as_bytes();
    if parse_i64(immediate_bytes) |value| {
        try consts.insert(allocator, name_id(node.result.name), value);
    }
    return;
}

fn record_float_constant(allocator: Allocator, module: &Module, instr: Instr, floats: &var map::Map<i64, f64>) -> !void {
    let node = module.instrs.at(instr.node);
    if node.op != Op::Const or !module.names.is(node.result.type_name, "f64") {
        return;
    }
    let immediate_text = name_text(&module.names, node.immediate);
    let immediate_bytes = immediate_text.as_bytes();
    if try typ::parse_float_literal(allocator, immediate_bytes) |value| {
        try floats.insert(allocator, name_id(node.result.name), value);
    }
    return;
}

fn fold_float_instr(
    allocator: Allocator,
    module: &var Module,
    instr: Instr,
    consts: &var map::Map<i64, i64>,
    floats: &var map::Map<i64, f64>
) -> !bool {
    let node = module.instrs.at(instr.node);
    let op = node.op;
    let operand = node.operand;
    let result = node.result;
    let count = node.args.len();
    if count == 0 or count > 2 or op == Op::Const {
        return false;
    }
    let first_name = node.args.get_or_panic(0).name;
    let first_type = node.args.get_or_panic(0).type_name;
    var second_name = empty_name();
    if count == 2 {
        second_name = node.args.get_or_panic(1).name;
    }
    if count == 2 {
        if op != Op::Binary {
            return false;
        }
        let left = floats.get(name_id(first_name)) orelse return false;
        let right = floats.get(name_id(second_name)) orelse return false;
        if module.names.is(result.type_name, "f64") {
            let value = float_binary(module, operand, left, right) orelse return false;
            return set_float_constant(allocator, module, instr, value, floats);
        }
        if module.names.is(result.type_name, "bool") {
            let holds = float_compare(module, operand, left, right) orelse return false;
            return set_bool_constant(module, instr, holds);
        }
        return false;
    }
    if op == Op::Cast {
        if module.names.is(result.type_name, "f64") and module.names.is(first_type, "i64") {
            let integer = consts.get(name_id(first_name)) orelse return false;
            return set_float_constant(allocator, module, instr, cast<f64>(integer), floats);
        }
        if !module.names.is(first_type, "f64") {
            return false;
        }
        let value = floats.get(name_id(first_name)) orelse return false;
        let integer = truncated_integer(module, result.type_name, value) orelse return false;
        return set_integer_constant(allocator, module, instr, integer, consts);
    }
    if !module.names.is(result.type_name, "f64") or !module.names.is(first_type, "f64") {
        return false;
    }
    let value = floats.get(name_id(first_name)) orelse return false;
    let computed = float_unary(module, op, operand, value) orelse return false;
    return set_float_constant(allocator, module, instr, computed, floats);
}

fn float_binary(module: &Module, operand: Name, left: f64, right: f64) -> ?f64 {
    let operator_text = name_text(&module.names, operand);
    let operator = operator_text.as_bytes();
    return stdmath::binary(operator, left, right);
}

fn float_compare(module: &Module, operand: Name, left: f64, right: f64) -> ?bool {
    let operator_text = name_text(&module.names, operand);
    let operator = operator_text.as_bytes();
    return stdmath::compare(operator, left, right);
}

fn float_unary(module: &Module, op: Op, operand: Name, value: f64) -> ?f64 {
    if op == Op::Unary {
        if module.names.is(operand, "-") {
            return -value;
        }
        return null;
    }
    if op == Op::FloatTrunc {
        return math::trunc<f64>(value);
    }
    if op == Op::FloatFloor {
        return math::floor<f64>(value);
    }
    if op == Op::FloatCeil {
        return math::ceil<f64>(value);
    }
    if op == Op::FloatSqrt {
        return math::sqrt<f64>(value);
    }
    return null;
}

fn truncated_integer(module: &Module, type_name: Name, value: f64) -> ?i64 {
    if !stdmath::finite(value) {
        return null;
    }
    let whole = math::trunc<f64>(value);
    var low = 0.0;
    var high = 0.0;
    if module.names.is(type_name, "i64") {
        low = -9223372036854775808.0;
        high = 9223372036854775808.0;
    } else if module.names.is(type_name, "i32") {
        low = -2147483648.0;
        high = 2147483648.0;
    } else if module.names.is(type_name, "i16") {
        low = -32768.0;
        high = 32768.0;
    } else if module.names.is(type_name, "i8") {
        low = -128.0;
        high = 128.0;
    } else if module.names.is(type_name, "u64") {
        high = 9223372036854775808.0;
    } else if module.names.is(type_name, "u32") {
        high = 4294967296.0;
    } else if module.names.is(type_name, "u16") {
        high = 65536.0;
    } else if module.names.is(type_name, "u8") {
        high = 256.0;
    } else {
        return null;
    }
    if whole < low or whole >= high {
        return null;
    }
    return cast<i64>(whole);
}

fn fold_phi(
    allocator: Allocator,
    module: &var Module,
    instr: Instr,
    consts: &var map::Map<i64, i64>,
    floats: &var map::Map<i64, f64>
) -> !bool {
    if module.instrs.at(instr.node).op != Op::Phi {
        return false;
    }
    if phi_float(module, instr, floats) |known| {
        return set_float_constant(allocator, module, instr, known, floats);
    }
    if phi_integer(module, instr, consts) |known| {
        return set_integer_constant(allocator, module, instr, known, consts);
    }
    return false;
}

fn phi_float(module: &Module, instr: Instr, floats: &map::Map<i64, f64>) -> ?f64 {
    let node = module.instrs.at(instr.node);
    if node.incoming.len() == 0 or !module.names.is(node.result.type_name, "f64") {
        return null;
    }
    var known = 0.0;
    var index = 0;
    while node.incoming.get(index) |incoming| {
        let value = floats.get(name_id(incoming.value.name)) orelse return null;
        if index > 0 and float::bits(value) != float::bits(known) {
            return null;
        }
        known = value;
        index = index + 1;
    }
    return known;
}

fn phi_integer(module: &Module, instr: Instr, consts: &map::Map<i64, i64>) -> ?i64 {
    let node = module.instrs.at(instr.node);
    if node.incoming.len() == 0 or !module.names.is(node.result.type_name, "i64") {
        return null;
    }
    var known = 0;
    var index = 0;
    while node.incoming.get(index) |incoming| {
        let value = consts.get(name_id(incoming.value.name)) orelse return null;
        if index > 0 and value != known {
            return null;
        }
        known = value;
        index = index + 1;
    }
    return known;
}

fn set_float_constant(allocator: Allocator, module: &var Module, instr: Instr, value: f64, floats: &var map::Map<i64, f64>) -> !bool {
    if !stdmath::finite(value) {
        return false;
    }
    let spelled = try stdmath::literal(allocator, value);
    let immediate = try module.names.intern_owned(move spelled);
    let result = module.instr_result(instr);
    try floats.insert(allocator, name_id(result.name), value);
    become_constant(module, instr, immediate);
    return true;
}

fn set_integer_constant(allocator: Allocator, module: &var Module, instr: Instr, value: i64, consts: &var map::Map<i64, i64>) -> !bool {
    let immediate = try module.names.intern_i64(value);
    let result = module.instr_result(instr);
    if module.names.is(result.type_name, "i64") {
        try consts.insert(allocator, name_id(result.name), value);
    }
    become_constant(module, instr, immediate);
    return true;
}

fn set_bool_constant(module: &var Module, instr: Instr, holds: bool) -> !bool {
    var immediate = empty_name();
    if holds {
        immediate = try module.names.intern("true");
    } else {
        immediate = try module.names.intern("false");
    }
    become_constant(module, instr, immediate);
    return true;
}

fn become_constant(module: &var Module, instr: Instr, immediate: Name) -> void {
    if module.instrs.at_mut(instr.node) |folded| {
        folded.op = Op::Const;
        folded.operand = empty_name();
        while folded.args.pop() |_| {}
        while folded.incoming.pop() |_| {}
        folded.immediate = immediate;
    }
    return;
}

fn parse_i64(text: []u8) -> ?i64 {
    let length = mem::len(text);
    var index = 0;
    var negative = false;
    if length > 0 and (text[0] == cast<u8>(45) or text[0] == cast<u8>(43)) {
        negative = text[0] == cast<u8>(45);
        index = 1;
    }
    if index >= length {
        return null;
    }
    var value = 0;
    while index < length {
        let byte = text[index];
        index = index + 1;
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return null;
        }
        let digit = cast<i64>(byte - cast<u8>(48));
        if value < (-9223372036854775807 - 1 + digit) / 10 {
            return null;
        }
        value = value * 10 - digit;
    }
    if negative {
        return value;
    }
    if value == -9223372036854775807 - 1 {
        return null;
    }
    return -value;
}

fn integer_constant(module: &Module, value: Value, consts: &map::Map<i64, i64>) -> ?i64 {
    if !module.names.is(value.type_name, "i64") {
        return null;
    }
    if consts.get(name_id(value.name)) |known| {
        return known;
    }
    let text = name_text(&module.names, value.name);
    let bytes = text.as_bytes();
    return parse_i64(bytes);
}

fn fold_instr(allocator: Allocator, module: &var Module, instr: Instr, consts: &var map::Map<i64, i64>) -> !bool {
    let node = module.instrs.at(instr.node);
    if node.args.len() != 2 or node.op == Op::Const {
        return false;
    }
    let left_arg = node.args.get_or_panic(0);
    let right_arg = node.args.get_or_panic(1);
    let left = integer_constant(module, left_arg, consts) orelse return false;
    let right = integer_constant(module, right_arg, consts) orelse return false;
    let result = node.result;
    let op = node.op;
    let operand = node.operand;
    var immediate = empty_name();
    if module.names.is(result.type_name, "i64") {
        let value = fold_binary(module, op, operand, left, right) orelse return false;
        immediate = try module.names.intern_i64(value);
        try consts.insert(allocator, name_id(result.name), value);
    } else {
        if !module.names.is(result.type_name, "bool") {
            return false;
        }
        let holds = fold_comparison(module, op, operand, left, right) orelse return false;
        if holds {
            immediate = try module.names.intern("true");
        } else {
            immediate = try module.names.intern("false");
        }
    }
    if module.instrs.at_mut(instr.node) |folded| {
        folded.op = Op::Const;
        folded.operand = empty_name();
        while folded.args.pop() |_| {}
        folded.immediate = immediate;
    }
    return true;
}

fn fold_binary(module: &Module, op: Op, operand: Name, left: i64, right: i64) -> ?i64 {
    if op != Op::Binary {
        return null;
    }
    if module.names.is(operand, "+") {
        return left + right;
    }
    if module.names.is(operand, "-") {
        return left - right;
    }
    if module.names.is(operand, "*") {
        return left * right;
    }
    if module.names.is(operand, "&") {
        return left & right;
    }
    if module.names.is(operand, "|") {
        return left | right;
    }
    if module.names.is(operand, "^") {
        return left ^ right;
    }
    return null;
}

fn fold_comparison(module: &Module, op: Op, operand: Name, left: i64, right: i64) -> ?bool {
    if op != Op::Binary {
        return null;
    }
    if module.names.is(operand, "<") {
        return left < right;
    }
    if module.names.is(operand, "<=") {
        return left <= right;
    }
    if module.names.is(operand, ">") {
        return left > right;
    }
    if module.names.is(operand, ">=") {
        return left >= right;
    }
    if module.names.is(operand, "==") {
        return left == right;
    }
    if module.names.is(operand, "!=") {
        return left != right;
    }
    return null;
}

fn replace_args(module: &var Module, instr: Instr, copies: &map::Map<[]u8, Value>) -> !void {
    let names = &module.names;
    let pool = &var module.cleanup_args;
    if module.instrs.at_mut(instr.node) |node| {
        var index = 0;
        while node.args.get(index) |arg| {
            if copy_of(names, copies, arg.name) |replacement| {
                try node.args.set(index, replacement);
            }
            index = index + 1;
        }
        index = 0;
        while node.incoming.get(index) |incoming| {
            if copy_of(names, copies, incoming.value.name) |replacement| {
                if node.incoming.at_mut(index) |slot| {
                    slot.value = replacement;
                }
            }
            index = index + 1;
        }
        index = 0;
        while node.fields.get(index) |field| {
            if copy_of(names, copies, field.value.name) |replacement| {
                if node.fields.at_mut(index) |slot| {
                    slot.value = replacement;
                }
            }
            index = index + 1;
        }
        index = 0;
        while node.cleanups.get(index) |cleanup| {
            var arg_index = 0;
            while arg_index < cleanup.args_len {
                if pool.get(cleanup.args_start + arg_index) |arg| {
                    if copy_of(names, copies, arg.name) |replacement| {
                        try pool.set(cleanup.args_start + arg_index, replacement);
                    }
                }
                arg_index = arg_index + 1;
            }
            index = index + 1;
        }
    }
    return;
}

fn copy_of(names: &NameTable, copies: &map::Map<[]u8, Value>, name: Name) -> ?Value {
    let retained = name_text(names, name);
    let bytes = retained.as_bytes();
    return copies.get(bytes);
}

fn replace_terminator_args(module: &var Module, block: Block, copies: &map::Map<[]u8, Value>) -> void {
    var term = module.block_terminator(block);
    if copy_of(&module.names, copies, term.value.name) |replacement| {
        term.value = replacement;
    }
    if copy_of(&module.names, copies, term.cond.name) |replacement| {
        term.cond = replacement;
    }
    module.set_terminator(block, term);
    return;
}

fn used_values(allocator: Allocator, module: &Module, function: Function) -> !map::Map<[]u8, bool> {
    var used = map::new<[]u8, bool>(allocator);
    errdefer used.deinit(allocator);
    let node = module.function_nodes.at(function.node);
    var index = 0;
    while node.blocks.get(index) |block| {
        index = index + 1;
        let block_node = module.blocks.at(block.node);
        var instr_index = 0;
        while block_node.instrs.get(instr_index) |instr| {
            instr_index = instr_index + 1;
            let instr_node = module.instrs.at(instr.node);
            var arg_index = 0;
            while instr_node.args.get(arg_index) |arg| {
                arg_index = arg_index + 1;
                try mark_used(allocator, module, &var used, arg.name);
            }
            arg_index = 0;
            while instr_node.incoming.get(arg_index) |incoming| {
                arg_index = arg_index + 1;
                try mark_used(allocator, module, &var used, incoming.value.name);
            }
            arg_index = 0;
            while instr_node.fields.get(arg_index) |field| {
                arg_index = arg_index + 1;
                try mark_used(allocator, module, &var used, field.value.name);
            }
            arg_index = 0;
            while instr_node.cleanups.get(arg_index) |cleanup| {
                arg_index = arg_index + 1;
                var cleanup_arg = 0;
                while module.cleanup_arg(cleanup, cleanup_arg) |arg| {
                    cleanup_arg = cleanup_arg + 1;
                    try mark_used(allocator, module, &var used, arg.name);
                }
            }
        }
        try mark_used(allocator, module, &var used, block_node.terminator.value.name);
        try mark_used(allocator, module, &var used, block_node.terminator.cond.name);
    }
    return move used;
}

fn mark_used(allocator: Allocator, module: &Module, used: &var map::Map<[]u8, bool>, name: Name) -> !void {
    let retained = name_text(&module.names, name);
    let bytes = retained.as_bytes();
    return used.insert(allocator, bytes, true);
}

fn keep_live_instrs(allocator: Allocator, module: &var Module, block: Block, used: &map::Map<[]u8, bool>) -> !void {
    var kept = array::new<Instr>(allocator);
    defer kept.deinit(allocator);
    var index = 0;
    while block_instr_at(module, block, index) |instr| {
        index = index + 1;
        if has_effect(module, instr) or result_used(module, used, instr) {
            try kept.append(allocator, instr);
        }
    }
    if module.blocks.at_mut(block.node) |node| {
        while node.instrs.pop() |_| {}
        index = 0;
        while kept.get(index) |instr| {
            index = index + 1;
            try node.instrs.append(allocator, instr);
        }
    }
    return;
}

fn result_used(module: &Module, used: &map::Map<[]u8, bool>, instr: Instr) -> bool {
    let result = module.instr_result(instr);
    let retained = name_text(&module.names, result.name);
    let bytes = retained.as_bytes();
    return used.contains(bytes);
}

fn has_effect(module: &Module, instr: Instr) -> bool {
    let node = module.instrs.at(instr.node);
    return !is_pure_op(node.op);
}

fn is_pure_op(op: Op) -> bool {
    return match op {
        Const => true,
        Id => true,
        Phi => true,
        Cast => true,
        StructNew => true,
        LocalSlot => true,
        RefLoad => true,
        OptNull => true,
        OptSome => true,
        OptHas => true,
        OptValue => true,
        ErrorOk => true,
        ErrorError => true,
        ErrorHas => true,
        ErrorValue => true,
        ErrorCode => true,
        UnionNew => true,
        UnionTag => true,
        UnionPayload => true,
        UnionPayloadRef => true,
        UnionLoad => true,
        SliceLen => true,
        SlicePtr => true,
        SliceFromPtr => true,
        PtrOffset => true,
        PtrHas => true,
        PtrValue => true,
        SliceIndex => true,
        SliceSlice => true,
        SliceCompare => true,
        BufferNew => true,
        BufferAddr => true,
        BufferAsBytes => true,
        VectorNew => true,
        VectorLane => true,
        VectorLoad => true,
        VectorTbl16 => true,
        VectorSdot => true,
        VectorConvert => true,
        IntPopcount => true,
        GpuIndex => true,
        GpuMath => true,
        FloatBits => true,
        FloatFromBits => true,
        FloatSqrt => true,
        FloatFloor => true,
        FloatCeil => true,
        FloatTrunc => true,
        FloatFma => true,
        TableGet => true,
        BoxBorrow => true,
        BoxBorrowMut => true,
        ArrayNew => true,
        ArrayLen => true,
        ArrayCapacity => true,
        ArrayGet => true,
        ArrayAt => true,
        ArrayAtMut => true,
        ArrayAsBytes => true,
        MapNew => true,
        MapLen => true,
        MapGet => true,
        MapContains => true,
        MapAt => true,
        MapAtMut => true,
        MapKeyAt => true,
        ArenaNew => true,
        ArenaLen => true,
        Binary => true,
        Unary => true,
        Field => true,
        FieldRef => true,
        FieldSet => true,
        FieldAddr => true,
        FuncAddr => true,
        _ => false,
    };
}
