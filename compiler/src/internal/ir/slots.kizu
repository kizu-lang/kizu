import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ownership;
import compiler::internal::stdprim;
import std::array;
import std::mem;
import std::string;

fn (self: &var Lowerer) mutably_borrowed_locals(tree: &var ast::Ast, decl: FactsHandle) -> !?diagnostic::Diagnostic {
    while self.slots.pop() |_| {}
    while self.caller_storage_params.pop() |_| {}
    while self.index_written.pop() |_| {}
    while self.index_read.pop() |_| {}
    while self.read_storage.pop() |_| {}
    while self.place_slots.pop() |_| {}
    while self.lent_places.pop() |_| {}
    while self.for_indexes.pop() |_| {}
    if self.decl_body(decl) |body| {
        if try self.collect_slots_stmt(tree, body.as_statement()) |failed| {
            return move failed;
        }
    }
    return null;
}

fn (self: &var Lowerer) note_assign_index_write(tree: &ast::Ast, target: ast::Expression) -> !void {
    var element = target;
    while ownership::field_expr(tree, element) |field| {
        if field.namespace {
            break;
        }
        element = field.receiver;
    }
    if ownership::index_expr(tree, element) |index| {
        if !index.slice {
            var root = element;
            while ownership::index_expr(tree, root) |inner| {
                root = inner.target;
            }
            while ownership::field_expr(tree, root) |field| {
                if field.namespace {
                    break;
                }
                root = field.receiver;
            }
            if ownership::ident_expr(tree, root) |ident| {
                let name = try self.text_name(tree, ident.name);
                if !self.is_index_written(name) {
                    try self.index_written.append(self.allocator, name);
                }
            }
        }
    }
    return;
}

fn (self: &var Lowerer) note_index_read(tree: &ast::Ast, expression: ast::Expression) -> !void {
    var root = expression;
    while ownership::index_expr(tree, root) |inner| {
        root = inner.target;
    }
    if ownership::ident_expr(tree, root) |ident| {
        let name = try self.text_name(tree, ident.name);
        if !self.is_index_read(name) {
            try self.index_read.append(self.allocator, name);
        }
    }
    return;
}

fn (self: &Lowerer) is_index_read(name: Name) -> bool {
    var index = 0;
    while self.index_read.get(index) |read| {
        index = index + 1;
        if same_name(read, name) {
            return true;
        }
    }
    return false;
}

fn (self: &var Lowerer) bind_read_storage(name: Name, value: Value) -> !void {
    if !self.is_index_read(name) or !self.module.names.is_buffer_type(value.type_name) {
        return;
    }
    if self.read_storage_of(value.name) |_| {
        return;
    }
    if !self.made_in_block(value) {
        return;
    }
    let slot_type = try self.module.names.prefixed("&var ", value.type_name);
    let slot = try self.emit1(Op::LocalSlot, slot_type, value);
    try self.read_storage.append(self.allocator, ReadStorage { value: value.name, slot: slot });
    return;
}

fn (self: &Lowerer) made_in_block(value: Value) -> bool {
    let node = self.module.blocks.at(self.block.node);
    var index = 0;
    while node.instrs.get(index) |instr| {
        index = index + 1;
        if same_name(self.module.instrs.at(instr.node).result.name, value.name) {
            return true;
        }
    }
    return false;
}

fn (self: &Lowerer) read_storage_of(value: Name) -> ?Value {
    var index = 0;
    while self.read_storage.get(index) |entry| {
        index = index + 1;
        if same_name(entry.value, value) {
            return entry.slot;
        }
    }
    return null;
}

fn (self: &var Lowerer) bound_read_storage(tree: &ast::Ast, expression: ast::Expression) -> !?Value {
    let ident = ownership::ident_expr(tree, expression) orelse return null;
    let name = try self.text_name(tree, ident.name);
    let value = self.envs.get(self.env, name) orelse return null;
    return self.read_storage_of(value.name);
}

fn (self: &Lowerer) is_index_written(name: Name) -> bool {
    var index = 0;
    while self.index_written.get(index) |written| {
        index = index + 1;
        if same_name(written, name) {
            return true;
        }
    }
    return false;
}

fn (self: &Lowerer) is_lent_place_value(value: Name) -> bool {
    var index = 0;
    while self.lent_places.get(index) |place| {
        index = index + 1;
        if same_name(place, value) {
            return true;
        }
    }
    return false;
}

fn (self: &Lowerer) is_lent_place(name: Name) -> bool {
    let value = self.envs.get(self.env, name) orelse return false;
    return self.is_lent_place_value(value.name);
}

fn (self: &Lowerer) is_for_index(value: Name) -> bool {
    var index = 0;
    while self.for_indexes.get(index) |bound| {
        index = index + 1;
        if same_name(bound, value) {
            return true;
        }
    }
    return false;
}

fn (self: &Lowerer) is_place_slot(value: Name) -> bool {
    var index = 0;
    while self.place_slots.get(index) |slot| {
        index = index + 1;
        if same_name(slot, value) {
            return true;
        }
    }
    return false;
}

fn (self: &Lowerer) holds_array_place(type_name: Name) -> bool {
    return !self.module.names.starts_with(type_name, "[]") and !self.is_reference_type(type_name);
}

fn (self: &Lowerer) is_caller_storage_param(name: Name) -> bool {
    var index = 0;
    while self.caller_storage_params.get(index) |param| {
        index = index + 1;
        if same_name(param, name) {
            return true;
        }
    }
    return false;
}

fn (self: &Lowerer) has_slot(name: Name) -> bool {
    var index = 0;
    while self.slots.get(index) |slot| {
        index = index + 1;
        if same_name(slot, name) {
            return true;
        }
    }
    return false;
}

fn (self: &var Lowerer) add_slot(name: Name) -> !void {
    if self.has_slot(name) {
        return;
    }
    return self.slots.append(self.allocator, name);
}

fn match_stmt_binds_payload(tree: &ast::Ast, statement: ast::Statement) -> bool {
    match tree.statements.at(statement.node) {
        Match(value) => {
            var index = 0;
            while value.arms.get(index) |arm| {
                index = index + 1;
                if !text_empty(tree, arm.binding) and !arm.is_wildcard(tree) {
                    return true;
                }
            }
            return false;
        },
        _ => return false,
    }
}

fn match_stmt_arm_body_at(tree: &ast::Ast, statement: ast::Statement, index: i64) -> ?ast::Statement {
    match tree.statements.at(statement.node) {
        Match(value) => {
            if value.arms.get(index) |arm| {
                return arm.body;
            }
            return null;
        },
        _ => return null,
    }
}

fn match_expr_arm_body_at(tree: &ast::Ast, expression: ast::Expression, index: i64) -> ?ast::Statement {
    match tree.expressions.at(expression.node) {
        Match(value) => {
            if value.arms.get(index) |arm| {
                return arm.body;
            }
            return null;
        },
        _ => return null,
    }
}

fn buffer_element_at(tree: &ast::Ast, expression: ast::Expression, index: i64) -> ?ast::Expression {
    match tree.expressions.at(expression.node) {
        BufferLiteral(value) => return value.elements.get(index),
        _ => return null,
    }
}

fn vector_lane_at(tree: &ast::Ast, expression: ast::Expression, index: i64) -> ?ast::Expression {
    match tree.expressions.at(expression.node) {
        VectorLiteral(value) => return value.lanes.get(index),
        _ => return null,
    }
}

fn (self: &var Lowerer) collect_slots_if(tree: &var ast::Ast, branch: ast::IfStmt) -> !?diagnostic::Diagnostic {
    if try self.collect_slots_expr(tree, branch.condition) |failed| {
        return move failed;
    }
    if try self.collect_slots_stmt(tree, branch.consequence.as_statement()) |failed| {
        return move failed;
    }
    if branch.alternative |alternative| {
        return self.collect_slots_stmt(tree, alternative.as_statement());
    }
    return null;
}

fn (self: &var Lowerer) collect_slots_stmt(tree: &var ast::Ast, statement: ast::Statement) -> !?diagnostic::Diagnostic {
    match tree.statements.at(statement.node) {
        Let(s) => {
            let value = s.value;
            return self.collect_slots_expr(tree, value);
        },
        Assign(s) => {
            let target = s.target;
            let value = s.value;
            try self.note_assign_index_write(tree, target);
            if try self.collect_slots_expr(tree, target) |failed| {
                return move failed;
            }
            return self.collect_slots_expr(tree, value);
        },
        Return(s) => {
            if s.value |value| {
                return self.collect_slots_expr(tree, value);
            }
            return null;
        },
        Defer(s) => {
            let expr = s.expr;
            if cleanup_receiver(tree, expr) |receiver| {
                try self.mark_if_name(tree, ast::Expression { node: receiver, location: null });
            }
            return self.collect_slots_expr(tree, expr);
        },
        ErrDefer(s) => {
            let expr = s.expr;
            if cleanup_receiver(tree, expr) |receiver| {
                try self.mark_if_name(tree, ast::Expression { node: receiver, location: null });
            }
            return self.collect_slots_expr(tree, expr);
        },
        Expr(s) => {
            let expr = s.expr;
            return self.collect_slots_expr(tree, expr);
        },
        Break(_) => return null,
        Continue(_) => return null,
        Block(_) => {
            let block = ast::Block { node: statement.node, location: null };
            var index = 0;
            while ownership::block_statement_at(tree, block, index) |inner| {
                index = index + 1;
                if try self.collect_slots_stmt(tree, inner) |failed| {
                    return move failed;
                }
            }
            return null;
        },
        If(s) => {
            let copied = ast::IfStmt {
                condition: s.condition,
                consequence: s.consequence,
                alternative: s.alternative,
                capture: s.capture,
                err_capture: s.err_capture
            };
            return self.collect_slots_if(tree, copied);
        },
        ComptimeIf(s) => {
            let cond = s.condition;
            let cons = s.consequence;
            let alt = s.alternative;
            if try self.collect_slots_expr(tree, cond) |failed| {
                return move failed;
            }
            if try self.collect_slots_stmt(tree, cons.as_statement()) |failed| {
                return move failed;
            }
            if alt |alternative| {
                return self.collect_slots_stmt(tree, alternative.as_statement());
            }
            return null;
        },
        ComptimeFor(s) => {
            let body = s.body;
            var range_start: ?ast::Expression = null;
            var range_end: ?ast::Expression = null;
            match s.iterable {
                List(_) => {},
                Range(range) => {
                    range_start = range.start;
                    range_end = range.end;
                },
            }
            if range_start |start_expr| {
                if try self.collect_slots_expr(tree, start_expr) |failed| {
                    return move failed;
                }
            }
            if range_end |end_expr| {
                if try self.collect_slots_expr(tree, end_expr) |failed| {
                    return move failed;
                }
            }
            return self.collect_slots_stmt(tree, body.as_statement());
        },
        ComptimeMatch(s) => {
            let value = s.value;
            let body = s.body;
            if try self.collect_slots_expr(tree, value) |failed| {
                return move failed;
            }
            return self.collect_slots_stmt(tree, body.as_statement());
        },
        While(s) => {
            let cond = s.condition;
            let body = s.body;
            if try self.collect_slots_expr(tree, cond) |failed| {
                return move failed;
            }
            return self.collect_slots_stmt(tree, body.as_statement());
        },
        For(s) => {
            let start = s.start;
            let end = s.end;
            let body = s.body;
            if try self.collect_slots_expr(tree, start) |failed| {
                return move failed;
            }
            if try self.collect_slots_expr(tree, end) |failed| {
                return move failed;
            }
            return self.collect_slots_stmt(tree, body.as_statement());
        },
        Match(s) => {
            let match_value = s.value;
            if ownership::field_expr(tree, match_value) |field| {
                if !field.namespace and match_stmt_binds_payload(tree, statement) {
                    try self.mark_if_name(tree, match_value);
                }
            }
            if try self.collect_slots_expr(tree, match_value) |failed| {
                return move failed;
            }
            var index = 0;
            while match_stmt_arm_body_at(tree, statement, index) |body| {
                index = index + 1;
                if try self.collect_slots_stmt(tree, body) |failed| {
                    return move failed;
                }
            }
            return null;
        },
        Recovered(_) => {
            let kind = try self.name(statement_go_type(tree, statement));
            return try self.fail1(tree, "ir error: slot analysis does not know statement `%s`", Arg::Str(kind));
        },
    }
}

fn (self: &var Lowerer) collect_slots_expr(tree: &var ast::Ast, expression: ast::Expression) -> !?diagnostic::Diagnostic {
    if self.function_pointer_mut_borrows.len() > 0 and self.function_pointer_mutably_borrows(expression) {
        try self.mark_if_name(tree, expression);
    }
    match tree.expressions.at(expression.node) {
        Ident(_) => return null,
        Int(_) => return null,
        Float(_) => return null,
        String(_) => return null,
        CString(_) => return null,
        Bool(_) => return null,
        Type(_) => return null,
        Null(_) => return null,
        Prefix(e) => {
            let op = e.operator;
            let right = e.right;
            if text_is(tree, op, "&var") {
                try self.mark_if_name(tree, right);
            }
            return self.collect_slots_expr(tree, right);
        },
        Binary(e) => {
            let left = e.left;
            let right = e.right;
            if try self.collect_slots_expr(tree, left) |failed| {
                return move failed;
            }
            return self.collect_slots_expr(tree, right);
        },
        TypeApply(e) => {
            let callee = e.callee;
            return self.collect_slots_expr(tree, callee);
        },
        Cast(e) => {
            let value = e.value;
            return self.collect_slots_expr(tree, value);
        },
        Try(e) => {
            let value = e.value;
            return self.collect_slots_expr(tree, value);
        },
        Unsafe(e) => {
            let value = e.value;
            return self.collect_slots_expr(tree, value);
        },
        Move(e) => {
            let value = e.value;
            return self.collect_slots_expr(tree, value);
        },
        Comptime(e) => {
            let expr = e.expr;
            return self.collect_slots_expr(tree, expr);
        },
        Deref(e) => {
            let receiver = e.receiver;
            return self.collect_slots_expr(tree, receiver);
        },
        Field(e) => {
            let receiver = e.receiver;
            return self.collect_slots_expr(tree, receiver);
        },
        Index(e) => {
            let slice = e.slice;
            let target = e.target;
            let idx = e.index;
            let start = e.start;
            let end = e.end;
            if !slice {
                try self.note_index_read(tree, expression);
            }
            if try self.collect_slots_expr(tree, target) |failed| {
                return move failed;
            }
            if idx |index_expr| {
                if try self.collect_slots_expr(tree, index_expr) |failed| {
                    return move failed;
                }
            }
            if start |start_expr| {
                if try self.collect_slots_expr(tree, start_expr) |failed| {
                    return move failed;
                }
            }
            if end |end_expr| {
                return self.collect_slots_expr(tree, end_expr);
            }
            return null;
        },
        StructLiteral(_) => {
            var index = 0;
            while ownership::struct_literal_field_at(tree, expression, index) |field| {
                index = index + 1;
                if try self.collect_slots_expr(tree, field.value) |failed| {
                    return move failed;
                }
            }
            return null;
        },
        BufferLiteral(_) => {
            var index = 0;
            while buffer_element_at(tree, expression, index) |element| {
                index = index + 1;
                if try self.collect_slots_expr(tree, element) |failed| {
                    return move failed;
                }
            }
            return null;
        },
        VectorLiteral(_) => {
            var index = 0;
            while vector_lane_at(tree, expression, index) |lane| {
                index = index + 1;
                if try self.collect_slots_expr(tree, lane) |failed| {
                    return move failed;
                }
            }
            return null;
        },
        Call(e) => {
            let call = ast::CallExpr { callee: e.callee, args: e.args };
            try self.mark_lent_args(tree, call);
            if try self.collect_slots_expr(tree, call.callee) |failed| {
                return move failed;
            }
            var index = 0;
            while ownership::arg_at(tree, call.args, index) |arg| {
                index = index + 1;
                if try self.collect_slots_expr(tree, arg) |failed| {
                    return move failed;
                }
            }
            return null;
        },
        OrelseGuard(e) => {
            let cond = e.condition;
            let exit = e.exit;
            if try self.collect_slots_expr(tree, cond) |failed| {
                return move failed;
            }
            if ownership::return_stmt(tree, exit) |returned| {
                if returned.value |value| {
                    return self.collect_slots_expr(tree, value);
                }
            }
            return null;
        },
        CatchGuard(e) => {
            let cond = e.condition;
            let exit = e.exit;
            if try self.collect_slots_expr(tree, cond) |failed| {
                return move failed;
            }
            if ownership::return_stmt(tree, exit) |returned| {
                if returned.value |value| {
                    return self.collect_slots_expr(tree, value);
                }
            }
            return null;
        },
        If(branch) => {
            let copied = ast::IfStmt {
                condition: branch.condition,
                consequence: branch.consequence,
                alternative: branch.alternative,
                capture: branch.capture,
                err_capture: branch.err_capture
            };
            return self.collect_slots_if(tree, copied);
        },
        Match(value) => {
            let match_value = value.value;
            if try self.collect_slots_expr(tree, match_value) |failed| {
                return move failed;
            }
            var index = 0;
            while match_expr_arm_body_at(tree, expression, index) |body| {
                index = index + 1;
                if try self.collect_slots_stmt(tree, body) |failed| {
                    return move failed;
                }
            }
            return null;
        },
        Recovered(_) => {
            let kind = try self.name(expression_go_type(tree, expression));
            return try self.fail1(tree, "ir error: slot analysis does not know expression `%s`", Arg::Str(kind));
        },
    }
}

fn (self: &Lowerer) function_pointer_mutably_borrows(expression: ast::Expression) -> bool {
    var index = 0;
    while self.function_pointer_mut_borrows.get(index) |known| {
        if known.node == expression.node {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn (self: &var Lowerer) mark_lent_args(tree: &var ast::Ast, call: ast::CallExpr) -> !void {
    if ownership::field_expr(tree, call.callee) |field| {
        if !field.namespace {
            return self.mark_lent_method_args(tree, call.callee, field, call.args);
        }
    }
    if ownership::type_apply_expr(tree, call.callee) |type_apply| {
        return self.mark_lent_generic_args(tree, type_apply, call.args);
    }
    let name = try self.function_callee_name(tree, call.callee) orelse return;
    let signature = self.signature_named(name) orelse return;
    var index = 0;
    while ownership::arg_at(tree, call.args, index) |arg| {
        let param = self.signature_param(signature, index) orelse return;
        index = index + 1;
        if param.passing == Passing::CallerStorage {
            try self.mark_if_name(tree, arg);
        }
    }
    return;
}

fn (self: &var Lowerer) mark_lent_method_args(
    tree: &var ast::Ast,
    callee: ast::Expression,
    field: ast::FieldExpr,
    args: ast::ExpressionList
) -> !void {
    let key = ownership::method_call_key(tree, callee);
    if self.resolved_method_call(callee, key) {
        var position = 0;
        while self.resolved_method_signature_at(callee, key, position) |signature| {
            position = position + 1;
            try self.mark_lent_method_signature(tree, signature, field, args);
        }
        return;
    }
    var method = string::new(self.allocator);
    defer method.deinit(self.allocator);
    try append_text(self.allocator, tree, field.name, &var method);
    let method_bytes = method.as_bytes();
    var position = 0;
    while self.method_signature_at(method_bytes, position) |signature| {
        position = position + 1;
        try self.mark_lent_method_signature(tree, signature, field, args);
    }
    return;
}

fn (self: &var Lowerer) mark_lent_method_signature(
    tree: &var ast::Ast,
    signature: SignatureHandle,
    field: ast::FieldExpr,
    args: ast::ExpressionList
) -> !void {
    if self.signature_param(signature, 0) |first| {
        if first.passing == Passing::CallerStorage {
            try self.mark_if_name(tree, field.receiver);
        }
    }
    var index = 0;
    while ownership::arg_at(tree, args, index) |arg| {
        if self.signature_param(signature, index + 1) |param| {
            if param.passing == Passing::CallerStorage {
                try self.mark_if_name(tree, arg);
            }
        }
        index = index + 1;
    }
    return;
}

fn (self: &Lowerer) resolved_method_call(callee: ast::Expression, key: i64) -> bool {
    if self.method_call_buckets.at(key) |bucket| {
        var position = 0;
        while bucket.get(position) |index| {
            position = position + 1;
            let known = self.method_callees.get(index) orelse continue;
            if known.callee.node == callee.node {
                return true;
            }
        }
    }
    return false;
}

fn (self: &Lowerer) resolved_method_signature_at(
    callee: ast::Expression,
    key: i64,
    position: i64
) -> ?SignatureHandle {
    if self.method_call_buckets.at(key) |bucket| {
        var seen = 0;
        var cursor = 0;
        while bucket.get(cursor) |index| {
            cursor = cursor + 1;
            let known = self.method_callees.get(index) orelse continue;
            if known.callee.node != callee.node {
                continue;
            }
            let signature = self.callee_signature(known.name) orelse continue;
            if seen == position {
                return signature;
            }
            seen = seen + 1;
        }
    }
    return null;
}

fn (self: &Lowerer) callee_signature(name: Name) -> ?SignatureHandle {
    if self.signature_named(name) |signature| {
        return signature;
    }
    let decl = self.generic_decl(name) orelse return null;
    if self.decl_param_count(decl) > 0 and self.decl_param(decl, 0).mut_borrow {
        return self.storage_self_signature;
    }
    return null;
}

fn (self: &var Lowerer) mark_lent_generic_args(
    tree: &var ast::Ast,
    type_apply: ast::TypeApplyExpr,
    args: ast::ExpressionList
) -> !void {
    let name = try self.function_callee_name(tree, type_apply.callee) orelse return;
    let type_arg = try self.text_name(tree, type_apply.type_arg);
    var params = no_params();
    if try self.declared_instance_params(tree, name, type_arg, type_apply.resolved, &var params) |failed| {
        failed.deinit(self.allocator);
        if self.lends_container_storage(name) {
            if ownership::arg_at(tree, args, 0) |first| {
                try self.mark_if_name(tree, first);
            }
        }
        return;
    }
    var index = 0;
    while ownership::arg_at(tree, args, index) |arg| {
        if self.view_param(params, index) |param| {
            if param.passing == Passing::CallerStorage {
                try self.mark_if_name(tree, arg);
            }
        }
        index = index + 1;
    }
    return;
}

fn (self: &Lowerer) lends_container_storage(name: Name) -> bool {
    let retained = name_text(&self.module.names, name);
    let bytes = retained.as_bytes();
    return arena_primitive_writes_header(bytes) or map_mutating_primitive(bytes);
}

fn (self: &var Lowerer) mark_if_name(tree: &ast::Ast, expression: ast::Expression) -> !void {
    var current = expression;
    while ownership::field_expr(tree, current) |field| {
        if field.namespace {
            break;
        }
        current = field.receiver;
    }
    let ident = ownership::ident_expr(tree, current) orelse return;
    let name = try self.text_name(tree, ident.name);
    return self.add_slot(name);
}

fn (self: &var Lowerer) bind_local(name: Name, value: Value) -> !void {
    if !self.has_slot(name) and self.is_index_written(name) and self.holds_array_place(value.type_name) {
        let place_type = try self.module.names.prefixed("&var ", value.type_name);
        let place = try self.emit1(Op::LocalSlot, place_type, value);
        try self.place_slots.append(self.allocator, place.name);
        return self.envs.bind(self.allocator, self.env, name, place);
    }
    if self.is_mutable_reference_type(value.type_name) {
        try self.lent_places.append(self.allocator, value.name);
        return self.envs.bind(self.allocator, self.env, name, value);
    }
    if !self.has_slot(name) {
        try self.envs.bind(self.allocator, self.env, name, value);
        return self.bind_read_storage(name, value);
    }
    let slot_type = try self.module.names.prefixed("&var ", value.type_name);
    let slot = try self.emit1(Op::LocalSlot, slot_type, value);
    return self.envs.bind(self.allocator, self.env, name, slot);
}

fn (self: &var Lowerer) bind_capture(name: Name, value: Value) -> !void {
    if !self.has_slot(name) and self.is_index_written(name) and self.holds_array_place(value.type_name) {
        return self.bind_local(name, value);
    }
    if !self.has_slot(name) or self.is_reference_type(value.type_name) {
        try self.envs.bind(self.allocator, self.env, name, value);
        return self.bind_read_storage(name, value);
    }
    let slot_type = try self.module.names.prefixed("&var ", value.type_name);
    let slot = try self.emit1(Op::LocalSlot, slot_type, value);
    return self.envs.bind(self.allocator, self.env, name, slot);
}

fn borrow_target_expr(tree: &ast::Ast, expression: ast::Expression) -> ast::Expression {
    if ownership::prefix_expr(tree, expression) |prefix| {
        if text_is(tree, prefix.operator, "&var") {
            return prefix.right;
        }
    }
    return expression;
}

fn shared_borrow_target(tree: &ast::Ast, expression: ast::Expression) -> ast::Expression {
    if ownership::prefix_expr(tree, expression) |prefix| {
        if text_is(tree, prefix.operator, "&") {
            return prefix.right;
        }
    }
    return expression;
}

fn (self: &Lowerer) is_storage_param(name: Name) -> bool {
    let wanted_text = name_text(&self.module.names, name);
    let wanted = wanted_text.as_bytes();
    let count = self.module.function_param_count(self.current);
    var index = 0;
    while index < count {
        if self.module.function_param(self.current, index) |param| {
            let param_text = name_text(&self.module.names, param.name);
            let bytes = param_text.as_bytes();
            if mem::len(bytes) == mem::len(wanted) + 1 and bytes[0] == cast<u8>(37) and
                mem::equal_bytes(bytes[1..mem::len(bytes)], wanted) {
                return param.passing == Passing::CallerStorage;
            }
        }
        index = index + 1;
    }
    return false;
}

fn (self: &var Lowerer) slot_pointer(tree: &ast::Ast, expression: ast::Expression) -> !?Value {
    if self.slots.len() == 0 and self.place_slots.len() == 0 and self.lent_places.len() == 0 {
        return null;
    }
    let ident = ownership::ident_expr(tree, expression) orelse return null;
    let name = try self.text_name(tree, ident.name);
    return self.named_storage(name);
}

fn (self: &Lowerer) named_storage(name: Name) -> ?Value {
    if self.slots.len() == 0 and self.place_slots.len() == 0 and self.lent_places.len() == 0 {
        return null;
    }
    let value = self.envs.get(self.env, name) orelse return null;
    if self.is_for_index(value.name) {
        return null;
    }
    if !self.has_slot(name) and !self.is_place_slot(value.name) and
        !self.is_lent_place_value(value.name) {
        return null;
    }
    return value;
}

fn (self: &var Lowerer) lower_receiver_address(tree: &var ast::Ast, expression: ast::Expression, out: &var Value) -> !?diagnostic::Diagnostic {
    if try self.slot_pointer(tree, expression) |slot| {
        out.* = slot;
        return null;
    }
    return self.lower_expr(tree, expression, out);
}

fn (self: &var Lowerer) lower_field_storage(tree: &var ast::Ast, expression: ast::Expression) -> !?Value {
    let field = ownership::field_expr(tree, expression) orelse return null;
    if field.namespace {
        return null;
    }
    var storage: ?Value = null;
    if try self.slot_pointer(tree, field.receiver) |slot| {
        storage = slot;
    } else if try self.shared_borrow_address(tree, field.receiver) |address| {
        storage = address;
    } else {
        storage = try self.lower_field_storage(tree, field.receiver);
    }
    let found = storage orelse return null;
    let storage_type = try self.deref_type(found.type_name);
    let field_name = try self.text_name(tree, field.name);
    let field_type = try self.field_type(storage_type, field_name);
    if self.name_is(field_type, "unknown") {
        return null;
    }
    var addr_type = try self.module.names.prefixed("&var ", field_type);
    if !self.is_mutable_reference_type(found.type_name) {
        addr_type = try self.module.names.prefixed("&", field_type);
    }
    return try self.emit_op1(Op::FieldAddr, field_name, addr_type, found);
}

fn (self: &var Lowerer) shared_borrow_address(tree: &ast::Ast, expression: ast::Expression) -> !?Value {
    let ident = ownership::ident_expr(tree, expression) orelse return null;
    let name = try self.text_name(tree, ident.name);
    let value = self.envs.get(self.env, name) orelse return null;
    if !self.is_reference_type(value.type_name) or self.is_mutable_reference_type(value.type_name) {
        return null;
    }
    return value;
}

fn (self: &var Lowerer) lower_call_args(tree: &var ast::Ast, name: Name, args: ast::ExpressionList, out: &var array::Array<Value>) -> !?diagnostic::Diagnostic {
    if self.signature_named(name) |signature| {
        let passed = try self.variadic_call_signature(tree, signature, args);
        return self.lower_call_args_as(tree, params_of(passed), args, out);
    }
    return self.lower_core_primitive_args(tree, name, args, out);
}

fn (self: &var Lowerer) lower_core_primitive_args(
    tree: &var ast::Ast,
    name: Name,
    args: ast::ExpressionList,
    out: &var array::Array<Value>
) -> !?diagnostic::Diagnostic {
    let string_out = try self.module.names.intern(stdprim::arg_kind_spelling(stdprim::ArgKind::StringOut));
    var index = 0;
    while ownership::arg_at(tree, args, index) |arg| {
        var want = empty_name();
        if self.is_string_out_arg(name, index) {
            want = string_out;
        }
        index = index + 1;
        var value = empty_value();
        if try self.lower_contextual_expr(tree, arg, want, &var value) |failed| {
            return move failed;
        }
        try out.append(self.allocator, value);
    }
    return null;
}

fn (self: &Lowerer) is_string_out_arg(name: Name, index: i64) -> bool {
    let retained = name_text(&self.module.names, name);
    let spelling = retained.as_bytes();
    if stdprim::simple_core_signature(spelling) |signature| {
        if signature.arg_at(index) |kind| {
            return match kind {
                StringOut => true,
                _ => false,
            };
        }
    }
    return false;
}

fn (self: &var Lowerer) lower_call_args_named(
    tree: &var ast::Ast,
    types: NamedTypes,
    args: ast::ExpressionList,
    out: &var array::Array<Value>
) -> !?diagnostic::Diagnostic {
    var index = 0;
    while ownership::arg_at(tree, args, index) |arg| {
        let want = named_type_at(types, index);
        index = index + 1;
        var value = empty_value();
        if try self.lower_contextual_expr(tree, arg, want, &var value) |failed| {
            return move failed;
        }
        try out.append(self.allocator, value);
    }
    return null;
}

fn (self: &var Lowerer) lower_call_args_as(tree: &var ast::Ast, params: ParamsView, args: ast::ExpressionList, out: &var array::Array<Value>) -> !?diagnostic::Diagnostic {
    var index = 0;
    while ownership::arg_at(tree, args, index) |arg| {
        var want = empty_name();
        if self.view_param(params, index) |param| {
            want = param.type_name;
        }
        index = index + 1;
        var value = empty_value();
        if try self.lower_contextual_expr(tree, arg, want, &var value) |failed| {
            return move failed;
        }
        try out.append(self.allocator, value);
    }
    return null;
}
