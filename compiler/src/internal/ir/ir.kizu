import compiler::internal::ast;
import std::arena;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::sort;
import std::string;

pub struct Module {
    pub names: NameTable,
    pub structs: map::Map<[]u8, Struct>,
    pub enums: map::Map<[]u8, Enum>,
    pub error_sets: map::Map<[]u8, Enum>,
    pub unions: map::Map<[]u8, Union>,
    pub functions: array::Array<Function>,
    pub function_nodes: arena::Arena<FunctionNode>,
    pub blocks: arena::Arena<BlockNode>,
    pub instrs: arena::Arena<InstrNode>,
    pub externs: array::Array<Extern>,
    pub cleanup_args: array::Array<Value>,
    pub cleanup_params: array::Array<Param>,
    pub modules: array::Array<Name>,
}

pub struct Extern {
    pub abi: Name,
    pub library: Name,
    pub framework: Name,
}

pub fn new_module(allocator: Allocator) -> !Module {
    return Module {
        names: try new_name_table(allocator),
        structs: map::new<[]u8, Struct>(allocator),
        enums: map::new<[]u8, Enum>(allocator),
        error_sets: map::new<[]u8, Enum>(allocator),
        unions: map::new<[]u8, Union>(allocator),
        functions: array::new<Function>(allocator),
        function_nodes: arena::new<FunctionNode>(allocator),
        blocks: arena::new<BlockNode>(allocator),
        instrs: arena::new<InstrNode>(allocator),
        externs: array::new<Extern>(allocator),
        cleanup_args: array::new<Value>(allocator),
        cleanup_params: array::new<Param>(allocator),
        modules: array::new<Name>(allocator)
    };
}

pub fn (self: &var Module) add_cleanup_args(allocator: Allocator, args: &array::Array<Value>) -> !i64 {
    let start = self.cleanup_args.len();
    var index = 0;
    while args.get(index) |arg| {
        index = index + 1;
        try self.cleanup_args.append(allocator, arg);
    }
    return start;
}

pub fn (self: &Module) cleanup_arg(cleanup: Cleanup, index: i64) -> ?Value {
    if index < 0 or index >= cleanup.args_len {
        return null;
    }
    return self.cleanup_args.get(cleanup.args_start + index);
}

pub fn (self: &var Module) add_cleanup_params(allocator: Allocator, params: &array::Array<Param>) -> !i64 {
    let start = self.cleanup_params.len();
    var index = 0;
    while params.get(index) |param| {
        index = index + 1;
        try self.cleanup_params.append(allocator, param);
    }
    return start;
}

pub fn (self: &Module) cleanup_param(cleanup: Cleanup, index: i64) -> ?Param {
    if index < 0 or index >= cleanup.params_len {
        return null;
    }
    return self.cleanup_params.get(cleanup.params_start + index);
}

pub fn cleanup_loads(cleanup: Cleanup, index: i64) -> bool {
    var bit = 1;
    var count = 0;
    while count < index {
        bit = bit * 2;
        count = count + 1;
    }
    return (cleanup.loads / bit) % 2 == 1;
}

pub fn (self: &var Module) set_extern(allocator: Allocator, symbol: Name, declared: Extern) -> !void {
    let id = name_id(symbol);
    while self.externs.len() <= id {
        try self.externs.append(allocator, Extern {
            abi: empty_name(), library: empty_name(), framework: empty_name()
        });
    }
    return self.externs.set(id, declared);
}

pub fn link_inputs(
    allocator: Allocator,
    module: &Module,
    libraries: &var array::Array<string::String>,
    frameworks: &var array::Array<string::String>
) -> !void {
    var seen_libraries = map::new<[]u8, bool>(allocator);
    defer seen_libraries.deinit(allocator);
    var seen_frameworks = map::new<[]u8, bool>(allocator);
    defer seen_frameworks.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let node = module.function_nodes.at(function.node);
        var block_index = 0;
        while node.blocks.get(block_index) |block| {
            block_index = block_index + 1;
            let block_node = module.blocks.at(block.node);
            var instr_index = 0;
            while block_node.instrs.get(instr_index) |instr| {
                instr_index = instr_index + 1;
                let instr_node = module.instrs.at(instr.node);
                try visit_extern(allocator, module, instr_node.extern_name, &var seen_libraries, &var seen_frameworks, libraries, frameworks);
                var cleanup_index = 0;
                while instr_node.cleanups.get(cleanup_index) |cleanup| {
                    cleanup_index = cleanup_index + 1;
                    try visit_extern(allocator, module, cleanup.extern_name, &var seen_libraries, &var seen_frameworks, libraries, frameworks);
                }
            }
        }
    }
    try sort::strings(libraries);
    try sort::strings(frameworks);
    return;
}

fn visit_extern(
    allocator: Allocator,
    module: &Module,
    symbol: Name,
    seen_libraries: &var map::Map<[]u8, bool>,
    seen_frameworks: &var map::Map<[]u8, bool>,
    libraries: &var array::Array<string::String>,
    frameworks: &var array::Array<string::String>
) -> !void {
    if is_empty(symbol) {
        return;
    }
    if module.externs.get(name_id(symbol)) |declared| {
        try add_link_input(allocator, module, declared.library, seen_libraries, libraries);
        try add_link_input(allocator, module, declared.framework, seen_frameworks, frameworks);
    }
    return;
}

fn add_link_input(
    allocator: Allocator,
    module: &Module,
    value: Name,
    seen: &var map::Map<[]u8, bool>,
    out: &var array::Array<string::String>
) -> !void {
    if is_empty(value) {
        return;
    }
    let retained = name_text(&module.names, value);
    let bytes = retained.as_bytes();
    if seen.contains(bytes) {
        return;
    }
    try seen.insert(allocator, bytes, true);
    let copied = try string::from_bytes(allocator, bytes);
    return out.append(allocator, move copied);
}

pub struct Struct {
    pub name: Name,
    pub fields: array::Array<Field>,
}

pub struct Enum {
    pub name: Name,
    pub tags: map::Map<[]u8, i64>,
    pub origins: array::Array<Name>,
}

pub struct Union {
    pub name: Name,
    pub variants: map::Map<[]u8, UnionVariant>,
}

pub struct UnionVariant {
    pub name: Name,
    pub index: i64,
    pub payload: Name,
}

pub struct Field {
    pub name: Name,
    pub type_name: Name,
}

pub struct Function {
    pub node: arena::Handle<FunctionNode>,
}

pub struct FunctionNode {
    pub name: Name,
    pub params: array::Array<Param>,
    pub return_type: Name,
    pub blocks: array::Array<Block>,
    pub export_abi: Name,
    pub export_name: Name,
    pub module: Name,
    pub instance: bool,
}

pub struct Block {
    pub node: arena::Handle<BlockNode>,
}

pub struct BlockNode {
    pub name: Name,
    pub instrs: array::Array<Instr>,
    pub terminator: Terminator,
}

pub struct Value {
    pub name: Name,
    pub type_name: Name,
}

pub fn empty_value() -> Value {
    return Value { name: empty_name(), type_name: empty_name() };
}

pub fn same_value(left: Value, right: Value) -> bool {
    return same_name(left.name, right.name) and same_name(left.type_name, right.type_name);
}

pub struct Instr {
    pub node: arena::Handle<InstrNode>,
}

pub struct InstrNode {
    pub result: Value,
    pub op: Op,
    pub operand: Name,
    pub args: array::Array<Value>,
    pub extern_abi: Name,
    pub extern_name: Name,
    pub call_params: array::Array<Param>,
    pub variadic_fixed: i64,
    pub immediate: Name,
    pub fields: array::Array<FieldArg>,
    pub incoming: array::Array<Incoming>,
    pub cleanups: array::Array<Cleanup>,
    pub span: ast::Span,
}

pub struct Cleanup {
    pub op: Op,
    pub operand: Name,
    pub args_start: i64,
    pub args_len: i64,
    pub loads: i64,
    pub extern_abi: Name,
    pub extern_name: Name,
    pub params_start: i64,
    pub params_len: i64,
    pub variadic_fixed: i64,
    pub on_error: bool,
    pub receiver: ?arena::Handle<ast::ExpressionNode>,
}

pub struct FieldArg {
    pub name: Name,
    pub value: Value,
}

pub struct Incoming {
    pub block: Name,
    pub value: Value,
}

pub struct Terminator {
    pub op: TermOp,
    pub value: Value,
    pub cond: Value,
    pub target: Name,
    pub else_target: Name,
}

pub enum TermOp {
    None,
    Return,
    Jump,
    Branch,
    Unreachable,
}

pub fn no_terminator() -> Terminator {
    return Terminator {
        op: TermOp::None,
        value: empty_value(),
        cond: empty_value(),
        target: empty_name(),
        else_target: empty_name()
    };
}

pub fn return_terminator(value: Value) -> Terminator {
    return Terminator {
        op: TermOp::Return,
        value: value,
        cond: empty_value(),
        target: empty_name(),
        else_target: empty_name()
    };
}

pub fn jump_terminator(target: Name) -> Terminator {
    return Terminator {
        op: TermOp::Jump,
        value: empty_value(),
        cond: empty_value(),
        target: target,
        else_target: empty_name()
    };
}

pub fn branch_terminator(cond: Value, target: Name, else_target: Name) -> Terminator {
    return Terminator {
        op: TermOp::Branch,
        value: empty_value(),
        cond: cond,
        target: target,
        else_target: else_target
    };
}

pub fn unreachable_terminator() -> Terminator {
    return Terminator {
        op: TermOp::Unreachable,
        value: empty_value(),
        cond: empty_value(),
        target: empty_name(),
        else_target: empty_name()
    };
}

pub fn (self: &Terminator) successor(position: i64) -> ?Name {
    var seen = 0;
    if !is_empty(self.target) {
        if seen == position {
            return self.target;
        }
        seen = seen + 1;
    }
    if !is_empty(self.else_target) {
        if seen == position {
            return self.else_target;
        }
    }
    return null;
}

pub struct Param {
    pub name: Name,
    pub type_name: Name,
    pub passing: Passing,
}

pub fn (self: &Param) value() -> Value {
    return Value { name: self.name, type_name: self.type_name };
}

pub enum Passing {
    Value,
    CallerStorage,
    CopyAddress,
}

