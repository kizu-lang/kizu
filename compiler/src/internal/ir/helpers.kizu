import compiler::internal::ast;
import compiler::internal::typ;
import std::array;
import std::fmt;
import std::mem;
import std::string;

// Mechanical port of internal/ir/helpers.go: block and value allocation, the
// instruction emitters, and the type spelling helpers. Go builds an argument
// slice at every emit; here the arity is in the emitter's name (emit0 ..
// emit3, emit_imm1 .., emit_op1 ..) and a call with an argument list uses
// emit_with.

/// Appends a basic block to the current function, the Go `newBlock`.
fn (self: &var Lowerer) new_block(name: Name) -> !Block {
    return self.module.add_block(self.current, name);
}

/// Creates a stable block label, the Go `nextBlockName`: `prefix.N`.
fn (self: &var Lowerer) next_block_name(prefix: []u8) -> !Name {
    self.next_block = self.next_block + 1;
    var out = try string::from_bytes(self.allocator, prefix);
    errdefer out.deinit(self.allocator);
    try out.append_byte(self.allocator, cast<u8>(46));
    try fmt::append_i64(self.allocator, &var out, self.next_block);
    return self.module.names.intern_owned(move out);
}

/// Creates a fresh SSA value, the Go `next`: `%N` of the given type.
fn (self: &var Lowerer) next(type_name: Name) -> !Value {
    self.next_value = self.next_value + 1;
    var out = try string::from_bytes(self.allocator, "%");
    errdefer out.deinit(self.allocator);
    try fmt::append_i64(self.allocator, &var out, self.next_value);
    let name = try self.module.names.intern_owned(move out);
    return Value { name: name, type_name: type_name };
}

/// Reports whether the current block has ended.
fn (self: &Lowerer) terminated() -> bool {
    return self.module.block_terminated(self.block);
}

/// Ends the current block.
fn (self: &var Lowerer) terminate(terminator: Terminator) -> void {
    self.module.set_terminator(self.block, terminator);
    return;
}

/// Returns the label of the current block, the Go `l.block.Name`.
fn (self: &Lowerer) block_label() -> Name {
    return self.module.block_name(self.block);
}

/// Returns the last instruction emitted into the current block, or null for
/// an empty block.
fn (self: &Lowerer) last_instr() -> ?Instr {
    let node = self.module.blocks.at(self.block.node);
    let count = node.instrs.len();
    if count == 0 {
        return null;
    }
    return node.instrs.get(count - 1);
}

/// Appends a generic instruction with an argument list, the Go `emit`. The
/// result type is resolved against the instantiation in force, so a type
/// parameter never reaches the backend.
fn (self: &var Lowerer) emit_with(
    op: Op,
    operand: Name,
    type_name: Name,
    immediate: Name,
    args: &array::Array<Value>
) -> !Value {
    let resolved = try self.resolve_bound_type(type_name);
    let result = try self.next(resolved);
    var instr = self.module.blank_instr(result, op, operand, immediate);
    errdefer instr.deinit(self.allocator);
    var index = 0;
    while args.get(index) |arg| {
        index = index + 1;
        try instr.args.append(self.allocator, arg);
    }
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return result;
}

/// Appends an instruction with no operands.
fn (self: &var Lowerer) emit0(op: Op, type_name: Name) -> !Value {
    return self.emit_imm0(op, type_name, empty_name());
}

/// Appends an instruction with one operand.
fn (self: &var Lowerer) emit1(op: Op, type_name: Name, a: Value) -> !Value {
    return self.emit_imm1(op, type_name, empty_name(), a);
}

/// Appends an instruction with two operands.
fn (self: &var Lowerer) emit2(op: Op, type_name: Name, a: Value, b: Value) -> !Value {
    return self.emit_imm2(op, type_name, empty_name(), a, b);
}

/// Appends an instruction with three operands.
fn (self: &var Lowerer) emit3(op: Op, type_name: Name, a: Value, b: Value, c: Value) -> !Value {
    let resolved = try self.resolve_bound_type(type_name);
    let result = try self.next(resolved);
    var instr = self.module.blank_instr(result, op, empty_name(), empty_name());
    errdefer instr.deinit(self.allocator);
    try instr.args.append(self.allocator, a);
    try instr.args.append(self.allocator, b);
    try instr.args.append(self.allocator, c);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return result;
}

/// Appends an instruction with an immediate and no operands.
fn (self: &var Lowerer) emit_imm0(op: Op, type_name: Name, immediate: Name) -> !Value {
    let resolved = try self.resolve_bound_type(type_name);
    let result = try self.next(resolved);
    let instr = self.module.blank_instr(result, op, empty_name(), immediate);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return result;
}

/// Appends an instruction with an immediate and one operand.
fn (self: &var Lowerer) emit_imm1(op: Op, type_name: Name, immediate: Name, a: Value) -> !Value {
    let resolved = try self.resolve_bound_type(type_name);
    let result = try self.next(resolved);
    var instr = self.module.blank_instr(result, op, empty_name(), immediate);
    errdefer instr.deinit(self.allocator);
    try instr.args.append(self.allocator, a);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return result;
}

/// Appends an instruction with an immediate and two operands.
fn (self: &var Lowerer) emit_imm2(op: Op, type_name: Name, immediate: Name, a: Value, b: Value) -> !Value {
    let resolved = try self.resolve_bound_type(type_name);
    let result = try self.next(resolved);
    var instr = self.module.blank_instr(result, op, empty_name(), immediate);
    errdefer instr.deinit(self.allocator);
    try instr.args.append(self.allocator, a);
    try instr.args.append(self.allocator, b);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return result;
}

/// Appends an instruction that carries a name (`field.<f>`, `unary.<op>`)
/// with one operand.
fn (self: &var Lowerer) emit_op1(op: Op, operand: Name, type_name: Name, a: Value) -> !Value {
    let resolved = try self.resolve_bound_type(type_name);
    let result = try self.next(resolved);
    var instr = self.module.blank_instr(result, op, operand, empty_name());
    errdefer instr.deinit(self.allocator);
    try instr.args.append(self.allocator, a);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return result;
}

/// Appends an instruction that carries a name (`field.set.<f>`,
/// `binary.<op>`) with two operands.
fn (self: &var Lowerer) emit_op2(op: Op, operand: Name, type_name: Name, a: Value, b: Value) -> !Value {
    let resolved = try self.resolve_bound_type(type_name);
    let result = try self.next(resolved);
    var instr = self.module.blank_instr(result, op, operand, empty_name());
    errdefer instr.deinit(self.allocator);
    try instr.args.append(self.allocator, a);
    try instr.args.append(self.allocator, b);
    let _ = try self.module.add_instr(self.allocator, self.block, move instr);
    return result;
}

/// Appends a typed constant instruction, the Go `emitConst`.
fn (self: &var Lowerer) emit_const(type_name: Name, immediate: Name) -> !Value {
    return self.emit_imm0(Op::Const, type_name, immediate);
}

/// Appends a typed constant from literal text.
fn (self: &var Lowerer) emit_const_text(type_name: Name, immediate: []u8) -> !Value {
    let interned = try self.module.names.intern(immediate);
    return self.emit_imm0(Op::Const, type_name, interned);
}

/// Normalizes omitted function returns to void, the Go `returnType`.
fn (self: &Lowerer) return_type(name: Name) -> Name {
    if is_empty(name) {
        return self.common.void_type;
    }
    return name;
}

/// Returns the type produced by a binary operator, the Go
/// `binaryResultType`.
fn (self: &Lowerer) binary_result_type(op: Name, left: Name) -> Name {
    let retained = name_text(&self.module.names, op);
    let bytes = retained.as_bytes();
    if mem::equal_bytes(bytes, "and") or mem::equal_bytes(bytes, "or") or
        mem::equal_bytes(bytes, "==") or mem::equal_bytes(bytes, "!=") or
        mem::equal_bytes(bytes, "<") or mem::equal_bytes(bytes, "<=") or
        mem::equal_bytes(bytes, ">") or mem::equal_bytes(bytes, ">=") {
        return self.common.bool_type;
    }
    return left;
}

/// Resolves a struct field type, the Go `fieldType`: `unknown` when the
/// struct or field is not declared.
fn (self: &var Lowerer) field_type(struct_name: Name, field_name: Name) -> !Name {
    return self.module.field_type(struct_name, field_name);
}

/// Names T for `std::array::Array<T>`, the Go `arrayElementType`.
fn (self: &var Lowerer) array_element_type(name: Name) -> !?Name {
    return self.module.names.generic_arg_of(name, "std::array::Array");
}

/// Names T for `std::mem::Box<T>`, the Go `boxElementType`.
fn (self: &var Lowerer) box_element_type(name: Name) -> !?Name {
    return self.module.names.generic_arg_of(name, "std::mem::Box");
}

/// Names K and V for a `std::map::Map<K, V>` spelling the checker has already
/// accepted, the Go `mapTypeArgs`.
fn (self: &var Lowerer) map_key_value_type(name: Name, key_out: &var Name) -> !?Name {
    let args_text = try self.module.names.generic_arg_of(name, "std::map::Map") orelse return null;
    var args = try self.split_static_args(args_text);
    defer args.deinit(self.allocator);
    if args.len() != 2 {
        return null;
    }
    let key = args.get_or_panic(0);
    if !self.name_is_map_key(key) {
        return null;
    }
    key_out.* = key;
    return args.get_or_panic(1);
}

/// Names the `K, V` argument list a `std::map::Map` wrapper is instantiated
/// with, the Go `mapStaticArgs`. Both static parameters name the instance, so
/// a caller that only wanted V would pick the wrong one.
fn (self: &var Lowerer) map_static_args(name: Name) -> !?Name {
    var key = empty_name();
    let value = try self.map_key_value_type(name, &var key) orelse return null;
    return try self.module.names.joined(key, ", ", value);
}

/// Reports whether a type spelling is one std::map::Map accepts as a key.
fn (self: &var Lowerer) name_is_map_key(value: Name) -> bool {
    return self.module.names.is_map_key(value);
}

/// Names `std::map::Map<K, V>`.
fn (self: &var Lowerer) map_type_name(key: Name, value: Name) -> !Name {
    let args = try self.module.names.joined(key, ", ", value);
    return self.module.names.wrapped("std::map::Map<", args, ">");
}

/// Names T for `std::arena::Arena<T>`, and `unknown` for any other spelling,
/// the Go `arenaElementType`.
fn (self: &var Lowerer) arena_element_type(name: Name) -> !Name {
    if try self.module.names.generic_arg_of(name, "std::arena::Arena") |elem| {
        return elem;
    }
    return self.common.unknown;
}

/// Names `std::arena::Handle<T>` for `std::arena::Arena<T>`, the Go
/// `handleType`.
fn (self: &var Lowerer) handle_type(arena: Name) -> !Name {
    let elem = try self.arena_element_type(arena);
    return self.module.names.wrapped("std::arena::Handle<", elem, ">");
}

/// Splits a static argument list, and reports no arguments for a spelling
/// that is not one, the Go `splitStaticArgs`. Every caller checks the count
/// it wanted, so a malformed list falls through the same path a wrong count
/// does.
fn (self: &var Lowerer) split_static_args(args: Name) -> !array::Array<Name> {
    let args_copy = try self.module.names.copy(args);
    defer args_copy.deinit(self.allocator);
    let bytes = args_copy.as_bytes();
    if try typ::split_args_optional(self.allocator, bytes) |found| {
        defer found.deinit(self.allocator);
        return self.module.names.intern_all(&found);
    }
    return array::new<Name>(self.allocator);
}

/// Names `std::map::Map<K, V>` and V for the argument list a map constructor
/// was written with, the Go `mapInstanceType`; null when the list is not a
/// supported map shape.
fn (self: &var Lowerer) map_instance_type(type_arg: Name, value_out: &var Name) -> !?Name {
    var args = try self.split_static_args(type_arg);
    defer args.deinit(self.allocator);
    if args.len() != 2 {
        return null;
    }
    let key = args.get_or_panic(0);
    if !self.name_is_map_key(key) {
        return null;
    }
    let value_type = args.get_or_panic(1);
    value_out.* = value_type;
    return try self.map_type_name(key, value_type);
}

/// Returns the result type of a checked host-runtime builtin, the Go
/// `runtimeBuiltinReturnType`, or null for any other name.
fn runtime_builtin_return_type(name: []u8) -> ?[]u8 {
    if mem::equal_bytes(name, "std::internal::builtin::io_blocking") or
        mem::equal_bytes(name, "std::internal::builtin::io_failing") {
        return "Io";
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_write_file") or
        mem::equal_bytes(name, "std::internal::builtin::fs_create_dir") or
        mem::equal_bytes(name, "std::internal::builtin::fs_rename") or
        mem::equal_bytes(name, "std::internal::builtin::fs_remove_dir") or
        mem::equal_bytes(name, "std::internal::builtin::fs_remove_file") {
        return "std::fs::Error!void";
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_exists") {
        return "std::fs::Error!bool";
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_metadata") {
        return "std::fs::Error!std::fs::Metadata";
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_read_dir") {
        return "std::fs::Error!std::array::Array<std::fs::DirEntry>";
    }
    return null;
}

/// Is the error and success side of one `E!T` / `!T` spelling; err is
/// empty for `!T`.
pub struct ErrorUnionParts {
    pub err: Name,
    pub success: Name
}

/// Splits Error and T for `Error!T`, or empty Error and T for `!T`, the Go
/// `errorUnionParts`; null for a spelling that is not an error union.
fn (self: &var Lowerer) error_union_parts(result: Name) -> !?ErrorUnionParts {
    return error_union_parts_in(&var self.types, &var self.module.names, result);
}

/// Splits one error union spelling through a type table, the shared body
/// of the lowerer's and the verifier's `errorUnionParts`.
fn error_union_parts_in(types: &var typ::Table, names: &var NameTable, result: Name) -> !?ErrorUnionParts {
    if is_empty(result) {
        return null;
    }
    let retained = name_text(names, result);
    let bytes = retained.as_bytes();
    let parsed = try types.parse(bytes);
    var has_err = false;
    var err_text = string::new(names.allocator);
    defer err_text.deinit(names.allocator);
    var ok_text = string::new(names.allocator);
    defer ok_text.deinit(names.allocator);
    match typ::root_node(types, parsed) {
        ErrorUnion(node) => {
            has_err = true;
            if node.err |err_node| {
                try typ::append_render(names.allocator, &var err_text, types, typ::child_type(parsed, err_node));
            }
            try typ::append_render(names.allocator, &var ok_text, types, typ::child_type(parsed, node.ok));
        },
        _ => {},
    }
    if !has_err {
        return null;
    }
    let err_bytes = err_text.as_bytes();
    let ok_bytes = ok_text.as_bytes();
    return ErrorUnionParts {
        err: try names.intern(err_bytes),
        success: try names.intern(ok_bytes)
    };
}

/// Returns T for `!T` or `Error!T`, the Go `errorUnionSuccessType`; null for
/// any other spelling.
fn (self: &var Lowerer) error_union_success_type(result: Name) -> !?Name {
    if try self.error_union_parts(result) |parts| {
        return parts.success;
    }
    return null;
}

/// Returns T for `!T` or `Error!T`, and `unknown` for any other spelling,
/// the Go `errorUnionElementType`.
fn (self: &var Lowerer) error_union_element_type(result: Name) -> !Name {
    if try self.error_union_success_type(result) |success| {
        return success;
    }
    return self.common.unknown;
}

/// Names T for an optional value type `?T`, the Go `optionalElemType`.
fn (self: &var Lowerer) optional_elem_type(type_name: Name) -> !?Name {
    return self.module.names.optional_elem(type_name);
}

/// Reports whether a type is a local borrow, the Go `isReferenceType`.
fn (self: &Lowerer) is_reference_type(name: Name) -> bool {
    return self.module.names.is_reference_type(name);
}

/// Reports whether name is `&var T`, the Go `isMutableReferenceType`.
fn (self: &Lowerer) is_mutable_reference_type(name: Name) -> bool {
    return self.module.names.is_mutable_reference_type(name);
}

/// Names T for `&T` and `&var T`, the Go `derefType`.
fn (self: &var Lowerer) deref_type(name: Name) -> !Name {
    return self.module.names.deref_type(name);
}

/// Names T for `ptr<T>` and `ptr<const T>`, the Go `rawPointerElem`.
fn (self: &var Lowerer) raw_pointer_elem(name: Name) -> !?Name {
    return self.module.names.raw_pointer_elem(name);
}

/// Reports whether an IR type spelling is a fixed-length stack buffer, the
/// Go `isBufferIRType`.
fn (self: &Lowerer) is_buffer_ir_type(name: Name) -> bool {
    return self.module.names.is_buffer_type(name);
}

/// Reports whether a type carries a deinit contract, the Go
/// `ast.OwnerType(l.deinitOwners, name)`.
fn (self: &Lowerer) is_owner_type(name: Name) -> bool {
    let retained = name_text(&self.module.names, name);
    let bytes = retained.as_bytes();
    return ast::owner_type(&self.deinit_owners, bytes);
}

/// Names the text of one Ast text, the Go `string` an AST field holds.
fn (self: &var Lowerer) text_name(tree: &ast::Ast, text: ast::Text) -> !Name {
    return self.module.names.intern_text(tree, text);
}

/// Names the rendering of one expression, the Go `expr.String()`.
fn (self: &var Lowerer) expression_name(tree: &ast::Ast, expression: ast::Expression) -> !Name {
    let rendered = try ast::render_expression(self.allocator, tree, expression);
    return self.module.names.intern_owned(move rendered);
}

/// Names one literal text.
fn (self: &var Lowerer) name(text: []u8) -> !Name {
    return self.module.names.intern(text);
}

/// Reports whether a name spells text.
fn (self: &Lowerer) name_is(name: Name, text: []u8) -> bool {
    return self.module.names.is(name, text);
}

/// Reports whether an Ast text spells bytes, the Go `text == "..."`.
fn text_is(tree: &ast::Ast, text: ast::Text, want: []u8) -> bool {
    let retained = tree.texts.at(text.node);
    let bytes = retained.as_bytes();
    return mem::equal_bytes(bytes, want);
}

/// Appends an Ast text's bytes to out. A caller that needs the spelling
/// while the tree is also borrowed for writing copies it here first: a view
/// into the tree cannot outlive that borrow.
fn append_text(allocator: Allocator, tree: &ast::Ast, text: ast::Text, out: &var string::String) -> !void {
    let retained = tree.texts.at(text.node);
    return out.append_string(allocator, retained);
}

/// Reports whether an Ast text is empty, the Go `text == ""`.
fn text_empty(tree: &ast::Ast, text: ast::Text) -> bool {
    let retained = tree.texts.at(text.node);
    return retained.len() == 0;
}
