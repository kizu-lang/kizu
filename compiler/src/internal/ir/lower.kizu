import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ownership;
import compiler::internal::project;
import compiler::internal::stdmeta;
import compiler::internal::stdmethod;
import compiler::internal::typ;
import compiler::internal::stdtarget;
import std::arena;
import std::array;
import std::map;
import std::mem;
import std::string;

// Mechanical port of internal/ir/lower.go: the entry point, the lowerer
// state, declaration collection, signatures, and function lowering. The Go
// lowerer keeps pointers into the AST and swaps maps in and out; here every
// declaration fact the body lowering reads is copied into FunctionFacts
// first, so no borrow of the Ast is held while a body is lowered (the
// `std::meta` expansions add nodes to it), and the sets a generic
// instantiation binds live in arenas behind copy handles.

/// Converts a checked Kizu AST into typed SSA IR, the Go `Lower`: the module
/// is left in `self.module` for the caller to render, optimize or emit, and
/// the first failure comes back as a diagnostic. The ownership checker was
/// read for the errdefers a move retired (ADR-0114) when the lowerer was
/// created, and std_errors gives the codes std error sets lower to.
pub fn (self: &var Lowerer) lower(
    tree: &var ast::Ast,
    program: &ast::Program,
    std_errors: &project::StdErrorCodes
) -> !?diagnostic::Diagnostic {
    if try self.lower_module(tree, program, std_errors) |failed| {
        return move failed;
    }
    return verify(self.allocator, &self.module);
}

/// Is one function declaration as the lowering reads it, the Go
/// `*ast.FunctionDecl`: the signature facts rendered once, and the body.
pub struct FunctionFacts {
    pub name: Name,
    pub static_params: array::Array<StaticParamFacts>,
    pub params: array::Array<ParamFacts>,
    pub return_type: Name,
    pub extern_abi: Name,
    pub export_abi: Name,
    pub requires_unsafe: bool,
    pub body: ?ast::Block
}

/// Is one static parameter: its name, whether it is a type parameter, and
/// the declared type of a value parameter (`Field`, `Function`, `i64`).
pub struct StaticParamFacts {
    pub name: Name,
    pub is_type: bool,
    pub type_name: Name
}

/// Is one runtime parameter as written: name, rendered type, borrow marks.
pub struct ParamFacts {
    pub name: Name,
    pub type_name: Name,
    pub borrow: bool,
    pub mut_borrow: bool
}

/// Identifies one FunctionFacts retained by the lowerer.
pub struct FactsHandle {
    node: arena::Handle<FunctionFacts>
}

/// Identifies one Signature retained by the lowerer.
pub struct SignatureHandle {
    node: arena::Handle<Signature>
}

/// Names the parameters a call hands its arguments over at: a signature's
/// params from position offset on, or none at all, the Go `[]Param` slices
/// `lowerCallArgsAs` receives.
pub struct ParamsView {
    pub signature: ?SignatureHandle,
    pub offset: i64
}

/// The types a call hands its first arguments over at when the callee has no
/// signature the lowerer can read them from. A container primitive and a
/// std::internal::builtin both declare none of their own, so the call site
/// spells the ones that matter in place; `empty_name` leaves an argument
/// with the type it carries itself, the Go zero `Param`.
pub struct NamedTypes {
    pub first: Name,
    pub second: Name,
    pub third: Name,
    pub fourth: Name
}

/// Returns the record that names nothing.
pub fn no_named_types() -> NamedTypes {
    return NamedTypes {
        first: empty_name(),
        second: empty_name(),
        third: empty_name(),
        fourth: empty_name()
    };
}

/// Returns the type named for one argument position, or the empty name.
pub fn named_type_at(types: NamedTypes, index: i64) -> Name {
    if index == 0 {
        return types.first;
    }
    if index == 1 {
        return types.second;
    }
    if index == 2 {
        return types.third;
    }
    if index == 3 {
        return types.fourth;
    }
    return empty_name();
}

/// Returns the parameter list a callee the lowerer has no signature for
/// gets: every argument keeps the type it carries itself.
pub fn no_params() -> ParamsView {
    return ParamsView { signature: null, offset: 0 };
}

/// Is one compile-time value bound to a static parameter, the Go
/// `staticValue`.
pub struct StaticValue {
    pub name: Name,
    pub typ: Name,
    pub text: Name
}

/// Is one type parameter bound to a type argument.
pub struct TypeBinding {
    pub name: Name,
    pub bound: Name
}

/// Is what one generic declaration's static parameters are bound to for one
/// call, the Go `genericArguments`: the type arguments, the compile-time
/// values, and the order they were declared in. The type arguments are kept
/// as parallel owned texts as well, for the type parser's substitution.
pub struct GenericArgs {
    pub order: array::Array<Name>,
    pub bindings: array::Array<TypeBinding>,
    pub binding_names: array::Array<string::String>,
    pub binding_types: array::Array<string::String>,
    pub values: array::Array<StaticValue>
}

/// Identifies one GenericArgs retained by the lowerer.
pub struct GenericArgsHandle {
    node: arena::Handle<GenericArgs>
}

/// Is one generic function with its static parameters bound, the Go
/// `genericInstance`.
pub struct GenericInstance {
    pub decl: FactsHandle,
    pub args: GenericArgsHandle,
    pub symbol: Name
}

/// Is the per-function loop stack entry, the Go `loopContext`.
pub struct LoopContext {
    pub label: Name,
    pub break_to: Name,
    pub continue_to: Name,
    pub defer_depth: i64,
    pub break_edges: array::Array<LoopEdge>,
    pub continue_edges: array::Array<LoopEdge>
}

/// Is one edge back into or out of a loop: the block it leaves from and the
/// environment it carries.
pub struct LoopEdge {
    pub block: Name,
    pub env: EnvHandle
}

/// Is a header phi and the name it carries around the loop, the Go
/// `loopPhi`.
pub struct LoopPhi {
    pub name: Name,
    pub phi: Instr
}

/// Is the field or variant a comptime capture names for the length of one
/// expansion, the Go `metaField`. A variant that carries no payload has no
/// type, so typ is empty for it.
pub struct MetaField {
    pub owner: Name,
    pub name: Name,
    pub typ: Name,
    pub variant: bool,
    /// The error set that declared a member of an error set, empty
    /// otherwise; the member is spelled and built through that set.
    pub origin: Name
}

/// Returns a capture record to fill in, the Go zero `metaField`.
pub fn empty_meta_field() -> MetaField {
    return MetaField {
        owner: empty_name(), name: empty_name(), typ: empty_name(), variant: false, origin: empty_name()
    };
}

/// Names the declaration a variant is built from: the declaring set for an
/// error member, the type itself otherwise, the Go `variantOwner`.
pub fn variant_owner(field: MetaField) -> Name {
    if is_empty(field.origin) {
        return field.owner;
    }
    return field.origin;
}

// MetaBinding is one `comptime` capture in force, the Go `metaFields` map
// entry; the chain through parent is the map, newest first.
struct MetaBinding {
    parent: ?arena::Handle<MetaBinding>,
    name: Name,
    field: MetaField
}

/// Identifies the captures in force before a bind, what its restore puts
/// back, the Go closure `bindMetaField` returns.
pub struct MetaMark {
    previous: ?arena::Handle<MetaBinding>
}

/// Is one errdefer receiver the ownership checker retired at one return
/// statement or try expression, the Go `Result` maps flattened.
pub struct RetiredReceiver {
    pub statement: ?arena::Handle<ast::StatementNode>,
    pub expression: ?arena::Handle<ast::ExpressionNode>,
    // The receiver expression the retired `errdefer` was written with.
    pub receiver: arena::Handle<ast::ExpressionNode>
}

/// Holds the names every lowering spells, interned once.
pub struct CommonNames {
    pub bool_type: Name,
    pub i64_type: Name,
    pub f64_type: Name,
    pub u8_type: Name,
    pub void_type: Name,
    pub bytes_type: Name,
    pub unknown: Name,
    pub type_type: Name,
    pub void_value: Value,
    pub zero_index: Value
}

/// Lowers one program, the Go `lowerer`. The module it builds is read in
/// place after `lower` succeeds.
pub struct Lowerer {
    allocator: Allocator,
    target: stdtarget::Target,
    pub module: Module,
    types: typ::Table,
    common: CommonNames,
    // decls lists the program's function declarations in order; tests the
    // test blocks, which lower after the functions.
    decl_facts: arena::Arena<FunctionFacts>,
    decls: array::Array<FactsHandle>,
    // scratch_facts, scratch_args and scratch_signature fill result slots
    // before a resolver writes them, so out parameters need no optional
    // wrapper.
    scratch_facts: FactsHandle,
    scratch_args: GenericArgsHandle,
    scratch_signature: SignatureHandle,
    // The signature the slot analysis reads for a generic method whose
    // receiver arrives as the binding's storage: one param, handed over that
    // way, which is all markLentMethodArgs looks at.
    storage_self_signature: SignatureHandle,
    tests: array::Array<TestFacts>,
    /// The module of the test body being lowered, for the one body whose
    /// symbol does not carry it.
    current_test_module: Name,
    signature_nodes: arena::Arena<Signature>,
    signatures: map::Map<[]u8, SignatureHandle>,
    // method_signatures groups the signatures by the method name they
    // end with, the Go `methodSigs`, so a method call reads the handful
    // of methods that could answer it instead of every declaration.
    method_signatures: map::Map<[]u8, array::Array<SignatureHandle>>,
    current: Function,
    block: Block,
    envs: EnvStore,
    env: EnvHandle,
    next_value: i64,
    next_block: i64,
    loops: array::Array<LoopContext>,
    defer_frames: array::Array<array::Array<Cleanup>>,
    // current_args binds the type parameters and static values in force:
    // those of the generic function being instantiated, the Go
    // `typeBindings` and `staticValues`. null binds nothing.
    generic_args: arena::Arena<GenericArgs>,
    current_args: ?GenericArgsHandle,
    // instantiated records the generic instances already requested, keyed
    // by the symbol they were given; pending the ones still to lower, read
    // from pending_next on.
    // Indexed by the name id of the instance symbol, the way the emitter
    // indexes its value table: the ids are dense and the key is always a name.
    instantiated: array::Array<bool>,
    pending: array::Array<GenericInstance>,
    pending_next: i64,
    // slots names the locals of the function being lowered that live in
    // memory because something writes through a `&var` borrow of them, and
    // the `&var` parameters that arrive as such storage.
    slots: array::Array<Name>,
    // generic_decls indexes the program's generic function declarations by
    // name; struct_decls, enum_decls and union_decls the sum and product
    // declarations, which is what `comptime for` and `std::meta::variants`
    // walk in source order.
    generic_decls: map::Map<i64, FactsHandle>,
    struct_decls: map::Map<[]u8, ast::Declaration>,
    enum_decls: map::Map<[]u8, ast::Declaration>,
    union_decls: map::Map<[]u8, ast::Declaration>,
    // meta_fields binds the captures of the `comptime for` expansions
    // currently being lowered.
    meta_bindings: arena::Arena<MetaBinding>,
    meta_current: ?arena::Handle<MetaBinding>,
    // extern_decls maps a resolved foreign function name to its explicit ABI
    // and host symbol.
    extern_decls: array::Array<ExternDecl>,
    // next_error_code is the next global code for an error set the program
    // declares itself; std members keep the codes std assigns.
    next_error_code: i64,
    // deinit_owners names the types that carry a deinit contract, seeded
    // from ast::deinit_owners so lowering reads the same owner-ness the
    // checkers do.
    deinit_owners: map::Map<[]u8, bool>,
    release_allocators: map::Map<[]u8, bool>,
    // retired is the preceding phase's output: the errdefer receivers a
    // move retired before each return statement and try expression.
    retired: array::Array<RetiredReceiver>,
    // Argument places ownership proved an indirect call lends as &var.
    function_pointer_mut_borrows: array::Array<ast::Expression>
}

pub struct ExternDecl {
    pub abi: Name,
    pub name: Name
}

/// Is one `test "name" { ... }` block: the symbol it lowers under and its
/// body.
pub struct TestFacts {
    pub symbol: Name,
    /// The package module the block was written in, empty for a loose file.
    /// A test's symbol does not carry one, and a function pointer's value is
    /// looked up through the prefix of what is being lowered.
    pub module: Name,
    pub body: ?ast::Block
}

/// Prepares the lookup tables used during lowering, the Go `newLowerer`.
pub fn new_lowerer(
    allocator: Allocator,
    tree: &ast::Ast,
    program: &ast::Program,
    checker: &ownership::Checker
) -> !Lowerer {
    return new_lowerer_for_target(
        allocator,
        tree,
        program,
        checker,
        stdtarget::Target::Native
    );
}

/// Prepares lowering for one selected build target.
pub fn new_lowerer_for_target(
    allocator: Allocator,
    tree: &ast::Ast,
    program: &ast::Program,
    checker: &ownership::Checker,
    target: stdtarget::Target
) -> !Lowerer {
    var module = try new_module(allocator);
    errdefer module.deinit(allocator);
    let common = try intern_common(&var module.names);
    let deinit_owners = try ast::deinit_owners(allocator, tree, program);
    errdefer deinit_owners.deinit(allocator);
    let release_allocators = try ast::release_names_allocator(allocator, tree, program);
    errdefer release_allocators.deinit(allocator);
    var envs = new_env_store(allocator);
    errdefer envs.deinit(allocator);
    let env = try envs.new_env();
    // A function and a block that belong to no lowered function fill the
    // current slots until the first function opens, so the fields need no
    // optional wrapper.
    let scratch_function = Function {
        node: try module.function_nodes.add(allocator, FunctionNode {
            name: empty_name(),
            params: array::new<Param>(allocator),
            return_type: empty_name(),
            blocks: array::new<Block>(allocator),
            export_abi: empty_name(),
            export_name: empty_name()
        })
    };
    let scratch_block = try module.add_block(scratch_function, empty_name());
    var decl_facts = arena::new<FunctionFacts>(allocator);
    errdefer decl_facts.deinit(allocator);
    let scratch_facts = FactsHandle {
        node: try decl_facts.add(allocator, FunctionFacts {
            name: empty_name(),
            static_params: array::new<StaticParamFacts>(allocator),
            params: array::new<ParamFacts>(allocator),
            return_type: empty_name(),
            extern_abi: empty_name(),
            export_abi: empty_name(),
            requires_unsafe: false,
            body: null
        })
    };
    var generic_args = arena::new<GenericArgs>(allocator);
    errdefer generic_args.deinit(allocator);
    let scratch_args = GenericArgsHandle { node: try generic_args.add(allocator, blank_generic_args(allocator)) };
    var signature_nodes = arena::new<Signature>(allocator);
    errdefer signature_nodes.deinit(allocator);
    let scratch_signature = SignatureHandle {
        node: try signature_nodes.add(allocator, Signature {
            params: array::new<Param>(allocator),
            return_type: empty_name(),
            pointer_type: empty_name(),
            requires_unsafe: false
        })
    };
    var storage_self_params = array::new<Param>(allocator);
    errdefer storage_self_params.deinit(allocator);
    try storage_self_params.append(allocator, Param {
        name: empty_name(), type_name: empty_name(), passing: Passing::CallerStorage
    });
    let storage_self_signature = SignatureHandle {
        node: try signature_nodes.add(allocator, Signature {
            params: move storage_self_params,
            return_type: empty_name(),
            pointer_type: empty_name(),
            requires_unsafe: false
        })
    };
    var lowerer = Lowerer {
        allocator: allocator,
        target: target,
        module: move module,
        types: typ::new(allocator),
        common: common,
        decl_facts: move decl_facts,
        decls: array::new<FactsHandle>(allocator),
        scratch_facts: scratch_facts,
        scratch_args: scratch_args,
        scratch_signature: scratch_signature,
        storage_self_signature: storage_self_signature,
        tests: array::new<TestFacts>(allocator),
        current_test_module: empty_name(),
        signature_nodes: move signature_nodes,
        signatures: map::new<[]u8, SignatureHandle>(allocator),
        method_signatures: map::new<[]u8, array::Array<SignatureHandle>>(allocator),
        current: scratch_function,
        block: scratch_block,
        envs: move envs,
        env: env,
        next_value: 0,
        next_block: 0,
        loops: array::new<LoopContext>(allocator),
        defer_frames: array::new<array::Array<Cleanup>>(allocator),
        generic_args: move generic_args,
        current_args: null,
        instantiated: array::new<bool>(allocator),
        pending: array::new<GenericInstance>(allocator),
        pending_next: 0,
        slots: array::new<Name>(allocator),
        generic_decls: map::new<i64, FactsHandle>(allocator),
        struct_decls: map::new<[]u8, ast::Declaration>(allocator),
        enum_decls: map::new<[]u8, ast::Declaration>(allocator),
        union_decls: map::new<[]u8, ast::Declaration>(allocator),
        meta_bindings: arena::new<MetaBinding>(allocator),
        meta_current: null,
        extern_decls: array::new<ExternDecl>(allocator),
        next_error_code: 0,
        deinit_owners: move deinit_owners,
        release_allocators: move release_allocators,
        retired: array::new<RetiredReceiver>(allocator),
        function_pointer_mut_borrows: array::new<ast::Expression>(allocator)
    };
    errdefer lowerer.deinit(allocator);
    try lowerer.collect_facts(tree, program);
    try lowerer.copy_retired(checker);
    return move lowerer;
}

fn intern_common(names: &var NameTable) -> !CommonNames {
    let i64_type = try names.intern("i64");
    let void_type = try names.intern("void");
    return CommonNames {
        bool_type: try names.intern("bool"),
        i64_type: i64_type,
        f64_type: try names.intern("f64"),
        u8_type: try names.intern("u8"),
        void_type: void_type,
        bytes_type: try names.intern("[]u8"),
        unknown: try names.intern("unknown"),
        type_type: try names.intern("type"),
        void_value: Value { name: void_type, type_name: void_type },
        zero_index: Value { name: try names.intern("0"), type_name: i64_type }
    };
}

/// Copies the declaration facts the lowering reads out of the program: the
/// function declarations in order, the test blocks, and the indexes of the
/// generic, struct, enum and union declarations.
fn (self: &var Lowerer) collect_facts(tree: &ast::Ast, program: &ast::Program) -> !void {
    var index = 0;
    while program.declarations.get(index) |declaration| {
        index = index + 1;
        match tree.declarations.at(declaration.node) {
            Function(function) => {
                let handle = try self.function_facts(tree, function);
                try self.decls.append(self.allocator, handle);
                let facts = self.decl_facts.at(handle.node);
                if facts.static_params.len() > 0 {
                    try self.generic_decls.insert(self.allocator, name_id(facts.name), handle);
                }
            },
            Test(test) => {
                let retained = tree.texts.at(test.name.node);
                let name_bytes = retained.as_bytes();
                let symbol = try test_function_name(self.allocator, name_bytes);
                let symbol_name = try self.module.names.intern_owned(move symbol);
                let retained_module = tree.texts.at(test.module.node);
                let module_bytes = retained_module.as_bytes();
                let module_name = try self.module.names.intern(module_bytes);
                try self.tests.append(self.allocator, TestFacts {
                    symbol: symbol_name,
                    module: module_name,
                    body: test.body
                });
            },
            Struct(declared) => {
                let retained = tree.texts.at(declared.name.node);
                let name_bytes = retained.as_bytes();
                try self.struct_decls.insert(self.allocator, name_bytes, declaration);
            },
            Enum(declared) => {
                let retained = tree.texts.at(declared.name.node);
                let name_bytes = retained.as_bytes();
                try self.enum_decls.insert(self.allocator, name_bytes, declaration);
            },
            Union(declared) => {
                let retained = tree.texts.at(declared.name.node);
                let name_bytes = retained.as_bytes();
                try self.union_decls.insert(self.allocator, name_bytes, declaration);
            },
            _ => {},
        }
    }
    return;
}

/// Copies one function declaration's facts.
fn (self: &var Lowerer) function_facts(tree: &ast::Ast, function: &ast::FunctionDecl) -> !FactsHandle {
    var static_params = array::new<StaticParamFacts>(self.allocator);
    errdefer static_params.deinit(self.allocator);
    var index = 0;
    while function.signature.static_params.at(index) |param| {
        index = index + 1;
        var type_name = empty_name();
        if param.type_name |declared| {
            type_name = try self.intern_type(tree, declared);
        }
        try static_params.append(self.allocator, StaticParamFacts {
            name: try self.module.names.intern_text(tree, param.name),
            is_type: param.is_type(),
            type_name: type_name
        });
    }
    var params = array::new<ParamFacts>(self.allocator);
    errdefer params.deinit(self.allocator);
    index = 0;
    while function.signature.params.at(index) |param| {
        index = index + 1;
        try params.append(self.allocator, ParamFacts {
            name: try self.module.names.intern_text(tree, param.name),
            type_name: try self.intern_type(tree, param.type_name),
            borrow: param.borrow,
            mut_borrow: param.mut_borrow
        });
    }
    var return_type = empty_name();
    if function.signature.return_type |declared| {
        return_type = try self.intern_type(tree, declared);
    }
    let facts = FunctionFacts {
        name: try self.module.names.intern_text(tree, function.signature.name),
        static_params: move static_params,
        params: move params,
        return_type: return_type,
        extern_abi: try self.module.names.intern_text(tree, function.signature.extern_abi),
        export_abi: try self.module.names.intern_text(tree, function.signature.export_abi),
        requires_unsafe: function.signature.requires_unsafe,
        body: function.body
    };
    return FactsHandle { node: try self.decl_facts.add(self.allocator, move facts) };
}

/// Names the canonical spelling of one parsed type, the Go `typ.Text`.
fn (self: &var Lowerer) intern_type(tree: &ast::Ast, value: typ::Type) -> !Name {
    let rendered = try typ::render(self.allocator, &tree.types, value);
    return self.module.names.intern_owned(move rendered);
}

/// Copies the errdefer receivers the ownership checker retired, the Go
/// `ownership.Result`, so no borrow of the checker is kept.
fn (self: &var Lowerer) copy_retired(checker: &ownership::Checker) -> !void {
    var index = 0;
    while checker.retired_return_at(index) |statement| {
        var position = 0;
        while checker.retired_return_receiver_at(index, position) |receiver| {
            position = position + 1;
            try self.retired.append(self.allocator, RetiredReceiver {
                statement: statement.node, expression: null, receiver: receiver.node
            });
        }
        index = index + 1;
    }
    index = 0;
    while checker.retired_try_at(index) |expression| {
        var position = 0;
        while checker.retired_try_receiver_at(index, position) |receiver| {
            position = position + 1;
            try self.retired.append(self.allocator, RetiredReceiver {
                statement: null, expression: expression.node, receiver: receiver.node
            });
        }
        index = index + 1;
    }
    index = 0;
    while checker.function_pointer_mut_borrow_at(index) |expression| {
        index = index + 1;
        try self.function_pointer_mut_borrows.append(self.allocator, expression);
    }
    return;
}

/// Reports whether the ownership checker retired the errdefer on receiver
/// before this return statement, the Go
/// `Result.RetiredErrDefersForReturn` membership.
fn (self: &Lowerer) retired_for_return(
    statement: ast::Statement,
    receiver: arena::Handle<ast::ExpressionNode>
) -> bool {
    var index = 0;
    while self.retired.get(index) |entry| {
        index = index + 1;
        if entry.statement |node| {
            if node == statement.node and entry.receiver == receiver {
                return true;
            }
        }
    }
    return false;
}

/// Reports whether the ownership checker retired the errdefer on receiver
/// before this try expression, the Go `Result.RetiredErrDefersForTry`
/// membership.
fn (self: &Lowerer) retired_for_try(
    expression: ast::Expression,
    receiver: arena::Handle<ast::ExpressionNode>
) -> bool {
    var index = 0;
    while self.retired.get(index) |entry| {
        index = index + 1;
        if entry.expression |node| {
            if node == expression.node and entry.receiver == receiver {
                return true;
            }
        }
    }
    return false;
}

/// Performs declaration collection and function lowering, the Go `lower`.
fn (self: &var Lowerer) lower_module(
    tree: &var ast::Ast,
    program: &ast::Program,
    std_errors: &project::StdErrorCodes
) -> !?diagnostic::Diagnostic {
    if try self.collect_decls(tree, program, std_errors) |failed| {
        return move failed;
    }
    var index = 0;
    while self.decls.get(index) |handle| {
        index = index + 1;
        let facts = self.decl_facts.at(handle.node);
        if !is_empty(facts.extern_abi) or facts.static_params.len() > 0 {
            continue;
        }
        let name = facts.name;
        if try self.lower_function_named(tree, handle, name) |failed| {
            return move failed;
        }
    }
    if try self.lower_tests(tree) |failed| {
        return move failed;
    }
    return self.lower_pending_generics(tree);
}

/// Lowers each `test "name" { ... }` block into a function, the Go
/// `lowerTests`, so a test runs through the same lowering as the rest of the
/// program. A test body may `try`, so it lowers as a function returning
/// `!void`.
fn (self: &var Lowerer) lower_tests(tree: &var ast::Ast) -> !?diagnostic::Diagnostic {
    var index = 0;
    while self.tests.get(index) |test| {
        index = index + 1;
        let return_type = try self.module.names.intern("!void");
        let facts = FunctionFacts {
            name: test.symbol,
            static_params: array::new<StaticParamFacts>(self.allocator),
            params: array::new<ParamFacts>(self.allocator),
            return_type: return_type,
            extern_abi: empty_name(),
            export_abi: empty_name(),
            requires_unsafe: false,
            body: test.body
        };
        self.current_test_module = test.module;
        let handle = FactsHandle { node: try self.decl_facts.add(self.allocator, move facts) };
        if try self.lower_function_named(tree, handle, test.symbol) |failed| {
            return move failed;
        }
    }
    return null;
}

/// Records signatures and struct layouts, the Go `collectDecls`.
fn (self: &var Lowerer) collect_decls(
    tree: &var ast::Ast,
    program: &ast::Program,
    std_errors: &project::StdErrorCodes
) -> !?diagnostic::Diagnostic {
    var index = 0;
    var combined = array::new<ast::Declaration>(self.allocator);
    errdefer combined.deinit(self.allocator);
    while program.declarations.get(index) |declaration| {
        index = index + 1;
        match tree.declarations.at(declaration.node) {
            Struct(declared) => try self.lower_struct(tree, declared),
            Enum(declared) => try self.lower_enum(self.allocator, tree, declared),
            ErrorSet(declared) => {
                if declared.combines.len() > 0 {
                    try combined.append(self.allocator, declaration);
                } else {
                    try self.lower_error_set(self.allocator, tree, declared, std_errors);
                }
            },
            Union(declared) => try self.lower_union(self.allocator, tree, declared),
            _ => {},
        }
    }
    try self.lower_combined_error_sets(tree, move combined);
    index = 0;
    while self.decls.get(index) |handle| {
        index = index + 1;
        let facts = self.decl_facts.at(handle.node);
        let name = facts.name;
        let extern_abi = facts.extern_abi;
        let signature = try self.lower_signature(handle);
        try self.record_signature(name, signature);
        if !is_empty(extern_abi) {
            let symbol = try self.external_symbol(name);
            try self.record_extern_decl(name, ExternDecl {
                abi: extern_abi, name: symbol
            });
        }
    }
    try self.index_method_signatures();
    return null;
}

/// Groups every declared method under the name it ends with, the Go
/// `indexMethodSignatures`. The receiver's type is unknown before lowering,
/// so a method call has to union every method bearing the name; reading them
/// from here is what keeps that union from walking the whole program once
/// per call site.
fn (self: &var Lowerer) index_method_signatures() -> !void {
    var method = string::new(self.allocator);
    defer method.deinit(self.allocator);
    let count = self.signatures.len();
    var position = 0;
    while position < count {
        method.clear();
        var signature = self.scratch_signature;
        var found = false;
        if self.signatures.key_at(position) |key| {
            if stdmethod::split_method_name(key) |parts| {
                try method.append_bytes(self.allocator, parts.method);
                if self.signatures.get(key) |handle| {
                    signature = handle;
                    found = true;
                }
            }
        }
        if found {
            let method_bytes = method.as_bytes();
            try self.add_method_signature(method_bytes, signature);
        }
        position = position + 1;
    }
    // A generic method has no lowered signature until its instance is
    // requested, which happens at the call the slot analysis runs before. Its
    // declaration already says whether the receiver arrives as the binding's
    // storage, so the analysis reads that rather than instantiating to ask.
    var generic_index = 0;
    while self.generic_decls.key_at(generic_index) |key| {
        generic_index = generic_index + 1;
        let decl = self.generic_decls.get(key) orelse continue;
        if self.decl_param_count(decl) == 0 {
            continue;
        }
        let receiver = self.decl_param(decl, 0);
        if !receiver.mut_borrow {
            continue;
        }
        method.clear();
        if try self.generic_method_name(decl, &var method) {
            let method_bytes = method.as_bytes();
            try self.add_method_signature(method_bytes, self.storage_self_signature);
        }
    }
    return;
}

/// Appends the method name a generic declaration ends with, and reports
/// whether it has one, the Go `genericMethodName`.
fn (self: &Lowerer) generic_method_name(decl: FactsHandle, out: &var string::String) -> !bool {
    let facts = self.decl_facts.at(decl.node);
    let retained = name_text(&self.module.names, facts.name);
    let spelling = retained.as_bytes();
    if stdmethod::split_method_name(spelling) |parts| {
        try out.append_bytes(self.allocator, parts.method);
        return true;
    }
    return false;
}

/// Records one method under its name, the Go
/// `l.methodSigs[method] = append(l.methodSigs[method], sig)`.
fn (self: &var Lowerer) add_method_signature(method: []u8, signature: SignatureHandle) -> !void {
    let allocator = self.allocator;
    if self.method_signatures.at_mut(method) |list| {
        return list.append(allocator, signature);
    }
    var list = array::new<SignatureHandle>(allocator);
    errdefer list.deinit(allocator);
    try list.append(allocator, signature);
    return self.method_signatures.insert(allocator, method, move list);
}

/// Returns the position-th declared method named method, null past the last.
/// The Go arm reads the whole slice at once; the index is read one entry at a
/// time so the borrow ends before the body marks a name.
fn (self: &Lowerer) method_signature_at(method: []u8, position: i64) -> ?SignatureHandle {
    if self.method_signatures.at(method) |list| {
        return list.get(position);
    }
    return null;
}

/// Records the signature callers of name see, the Go `l.signatures[name] =`.
fn (self: &var Lowerer) record_signature(name: Name, signature: SignatureHandle) -> !void {
    let retained = name_text(&self.module.names, name);
    let name_bytes = retained.as_bytes();
    if self.signatures.at_mut(name_bytes) |slot| {
        slot.* = signature;
        return;
    }
    return self.signatures.insert(self.allocator, name_bytes, signature);
}

/// Records the explicit ABI and host symbol a foreign declaration links to.
fn (self: &var Lowerer) record_extern_decl(name: Name, declared: ExternDecl) -> !void {
    let id = name_id(name);
    while self.extern_decls.len() <= id {
        try self.extern_decls.append(self.allocator, ExternDecl {
            abi: empty_name(), name: empty_name()
        });
    }
    return self.extern_decls.set(id, declared);
}

/// Strips the module qualification a resolver added to a foreign declaration.
/// The host symbol is the identifier the declaration was written with.
fn (self: &var Lowerer) external_symbol(name: Name) -> !Name {
    let start = self.qualification_end(name);
    if start < 0 {
        return name;
    }
    return self.module.names.intern_slice(name, start, self.module.names.len(name));
}

/// Returns the index after the last `::` of a name, or -1 for an unqualified
/// name.
fn (self: &Lowerer) qualification_end(name: Name) -> i64 {
    let retained = name_text(&self.module.names, name);
    let bytes = retained.as_bytes();
    var index = mem::len(bytes);
    while index >= 2 {
        if bytes[index - 2] == cast<u8>(58) and bytes[index - 1] == cast<u8>(58) {
            return index;
        }
        index = index - 1;
    }
    return -1;
}

/// Converts an AST union declaration to IR metadata, the Go `lowerUnion`.
fn (self: &var Lowerer) lower_union(allocator: Allocator, tree: &ast::Ast, declared: &ast::UnionDecl) -> !void {
    var variants = map::new<[]u8, UnionVariant>(self.allocator);
    errdefer variants.deinit(self.allocator);
    var index = 0;
    while declared.variants.at(index) |variant| {
        var payload = empty_name();
        if variant.payload |declared_payload| {
            payload = try self.resolve_element_forms(tree, declared_payload);
        }
        let variant_name = try self.module.names.intern_text(tree, variant.name);
        let retained = name_text(&self.module.names, variant_name);
        let variant_bytes = retained.as_bytes();
        try variants.insert(allocator, variant_bytes, UnionVariant {
            name: variant_name, index: index, payload: payload
        });
        index = index + 1;
    }
    let name = try self.module.names.intern_text(tree, declared.name);
    let retained = name_text(&self.module.names, name);
    let name_bytes = retained.as_bytes();
    return self.module.unions.insert(allocator, name_bytes, Union { name: name, variants: move variants });
}

/// Converts an AST enum declaration to IR metadata, the Go `lowerEnum`.
fn (self: &var Lowerer) lower_enum(allocator: Allocator, tree: &ast::Ast, declared: &ast::EnumDecl) -> !void {
    var tags = map::new<[]u8, i64>(self.allocator);
    errdefer tags.deinit(self.allocator);
    var index = 0;
    while declared.tags.at(index) |tag| {
        let retained = tree.texts.at(tag.node);
        let tag_bytes = retained.as_bytes();
        try tags.insert(allocator, tag_bytes, index);
        index = index + 1;
    }
    let name = try self.module.names.intern_text(tree, declared.name);
    let retained = name_text(&self.module.names, name);
    let name_bytes = retained.as_bytes();
    return self.module.enums.insert(allocator, name_bytes, Enum {
        name: name,
        tags: move tags,
        origins: array::new<Name>(self.allocator)
    });
}

/// Converts an AST error set to IR metadata, the Go `lowerErrorSet`. An
/// error value is one integer, globally unique across every set: std members
/// keep the codes std assigns, and sets a program declares take the codes
/// after them.
fn (self: &var Lowerer) lower_error_set(
    allocator: Allocator,
    tree: &ast::Ast,
    declared: &ast::ErrorSetDecl,
    std_errors: &project::StdErrorCodes
) -> !void {
    let name = try self.module.names.intern_text(tree, declared.name);
    var members = map::new<[]u8, i64>(self.allocator);
    errdefer members.deinit(self.allocator);
    let retained = name_text(&self.module.names, name);
    let name_bytes = retained.as_bytes();
    if std_errors.sets.at(name_bytes) |codes| {
        var position = 0;
        while codes.key_at(position) |member| {
            position = position + 1;
            if codes.get(member) |code| {
                try members.insert(allocator, member, code);
            }
        }
        return self.module.error_sets.insert(allocator, name_bytes, Enum {
            name: name,
            tags: move members,
            origins: array::new<Name>(self.allocator)
        });
    }
    if self.next_error_code == 0 {
        self.next_error_code = std_errors.base;
    }
    var index = 0;
    while declared.members.at(index) |member| {
        index = index + 1;
        let member_text = tree.texts.at(member.node);
        let member_bytes = member_text.as_bytes();
        try members.insert(allocator, member_bytes, self.next_error_code);
        self.next_error_code = self.next_error_code + 1;
    }
    return self.module.error_sets.insert(allocator, name_bytes, Enum {
        name: name,
        tags: move members,
        origins: array::new<Name>(self.allocator)
    });
}

/// Records the `error C = A or B;` declarations once every declaring set is
/// filed, the Go `lowerCombinedErrorSets`. A combined set keeps no codes of
/// its own: it lists the `{ }`-form sets its members come from, resolved
/// through any combined sets it names, so its member set is a code-set union
/// and nothing is renumbered (ADR-0127).
fn (self: &var Lowerer) lower_combined_error_sets(
    tree: &ast::Ast,
    pending: array::Array<ast::Declaration>
) -> !void {
    var work = move pending;
    defer work.deinit(self.allocator);
    var done = array::new<bool>(self.allocator);
    defer done.deinit(self.allocator);
    var index = 0;
    while index < work.len() {
        try done.append(self.allocator, false);
        index = index + 1;
    }
    var remaining = work.len();
    while remaining > 0 {
        var progress = false;
        index = 0;
        while work.get(index) |declaration| {
            let position = index;
            index = index + 1;
            if done.get(position) orelse false {
                continue;
            }
            var resolved = false;
            try self.lower_combined_error_set(self.allocator, tree, declaration, &var resolved);
            if resolved {
                progress = true;
                remaining = remaining - 1;
                try done.set(position, true);
            }
        }
        if !progress {
            // A reference the checker did not already reject cannot appear
            // here; an unresolved leftover is left unfiled rather than
            // guessed at.
            return;
        }
    }
    return;
}

/// Files one combined error set when every set it names is already filed,
/// reporting whether it was.
fn (self: &var Lowerer) lower_combined_error_set(
    allocator: Allocator,
    tree: &ast::Ast,
    declaration: ast::Declaration,
    resolved: &var bool
) -> !void {
    resolved.* = false;
    var origins = array::new<Name>(self.allocator);
    errdefer origins.deinit(self.allocator);
    var seen = map::new<[]u8, bool>(self.allocator);
    defer seen.deinit(self.allocator);
    var name = empty_name();
    match tree.declarations.at(declaration.node) {
        ErrorSet(declared) => {
            name = try self.module.names.intern_text(tree, declared.name);
            var index = 0;
            while declared.combines.at(index) |reference| {
                index = index + 1;
                let reference_text = tree.texts.at(reference.node);
                let reference_bytes = reference_text.as_bytes();
                var contributed = array::new<Name>(self.allocator);
                defer contributed.deinit(self.allocator);
                if self.module.error_sets.at(reference_bytes) |part| {
                    if part.origins.len() == 0 {
                        try contributed.append(self.allocator, try self.module.names.intern(reference_bytes));
                    } else {
                        var position = 0;
                        while part.origins.at(position) |origin| {
                            position = position + 1;
                            try contributed.append(self.allocator, origin.*);
                        }
                    }
                } else {
                    origins.deinit(self.allocator);
                    return;
                }
                var position = 0;
                while contributed.at(position) |origin| {
                    position = position + 1;
                    let origin_text = name_text(&self.module.names, origin.*);
                    let origin_bytes = origin_text.as_bytes();
                    if seen.contains(origin_bytes) {
                        continue;
                    }
                    try seen.insert(allocator, origin_bytes, true);
                    try origins.append(self.allocator, origin.*);
                }
            }
        },
        _ => {
            origins.deinit(self.allocator);
            return;
        },
    }
    let retained = name_text(&self.module.names, name);
    let name_bytes = retained.as_bytes();
    try self.module.error_sets.insert(allocator, name_bytes, Enum {
        name: name,
        tags: map::new<[]u8, i64>(self.allocator),
        origins: move origins
    });
    resolved.* = true;
    return;
}

/// Converts an AST struct declaration to IR metadata, the Go `lowerStruct`.
fn (self: &var Lowerer) lower_struct(tree: &ast::Ast, declared: &ast::StructDecl) -> !void {
    var fields = array::new<Field>(self.allocator);
    errdefer fields.deinit(self.allocator);
    var index = 0;
    while declared.fields.at(index) |field| {
        index = index + 1;
        try fields.append(self.allocator, Field {
            name: try self.module.names.intern_text(tree, field.name),
            type_name: try self.resolve_element_forms(tree, field.type_name)
        });
    }
    let name = try self.module.names.intern_text(tree, declared.name);
    let retained = name_text(&self.module.names, name);
    let name_bytes = retained.as_bytes();
    return self.module.structs.insert(self.allocator, name_bytes, Struct { name: name, fields: move fields });
}

/// Names a declared type with its `std::meta::element<T>` forms resolved,
/// the Go `stdmeta.ResolveElementTypeForms(typ.Text(value))`.
fn (self: &var Lowerer) resolve_element_forms(tree: &ast::Ast, value: typ::Type) -> !Name {
    let resolved = try stdmeta::resolve_element_type_forms(self.allocator, &tree.types, value);
    return self.module.names.intern_owned(move resolved);
}

/// Extracts the callable type of a function declaration, the Go
/// `lowerSignature`, against the type bindings in force.
fn (self: &var Lowerer) lower_signature(decl: FactsHandle) -> !SignatureHandle {
    var params = array::new<Param>(self.allocator);
    errdefer params.deinit(self.allocator);
    let count = self.decl_param_count(decl);
    var index = 0;
    while index < count {
        let facts = self.decl_param(decl, index);
        index = index + 1;
        try params.append(self.allocator, try self.lower_param(facts));
    }
    let declared_return = self.decl_facts.at(decl.node).return_type;
    let resolved = try self.resolve_bound_type(declared_return);
    let returned = try self.lower_return_type(resolved);
    let requires_unsafe = self.decl_facts.at(decl.node).requires_unsafe;
    var pointer_return = resolved;
    if is_empty(pointer_return) {
        pointer_return = self.common.void_type;
    }
    let pointer = try self.declared_function_pointer_type(decl, pointer_return, requires_unsafe);
    let handle = try self.signature_nodes.add(self.allocator, Signature {
        params: move params,
        return_type: returned,
        pointer_type: pointer,
        requires_unsafe: requires_unsafe
    });
    return SignatureHandle { node: handle };
}

/// Spells the source-level callable type of a declaration. Runtime Params
/// cannot answer this: `x: &i64` and `x: i64` both travel as i64, while only
/// the former carries a borrow effect.
fn (self: &var Lowerer) declared_function_pointer_type(
    decl: FactsHandle,
    declared_return: Name,
    requires_unsafe: bool
) -> !Name {
    var text = string::new(self.allocator);
    errdefer text.deinit(self.allocator);
    if requires_unsafe {
        try text.append_bytes(self.allocator, "unsafe fn(");
    } else {
        try text.append_bytes(self.allocator, "fn(");
    }
    let count = self.decl_param_count(decl);
    var index = 0;
    while index < count {
        if index > 0 {
            try text.append_bytes(self.allocator, ", ");
        }
        let facts = self.decl_param(decl, index);
        index = index + 1;
        if facts.mut_borrow {
            try text.append_bytes(self.allocator, "&var ");
        } else {
            if facts.borrow {
                try text.append_byte(self.allocator, cast<u8>(38));
            }
        }
        let resolved = try self.resolve_bound_type(facts.type_name);
        try self.module.names.append_to(&var text, resolved);
    }
    try text.append_bytes(self.allocator, ") -> ");
    try self.module.names.append_to(&var text, declared_return);
    return self.module.names.intern_owned(move text);
}

/// Returns the number of runtime parameters a declaration has.
fn (self: &Lowerer) decl_param_count(decl: FactsHandle) -> i64 {
    let facts = self.decl_facts.at(decl.node);
    return facts.params.len();
}

/// Returns one runtime parameter of a declaration; the blank record past the
/// last, which no caller reads.
fn (self: &Lowerer) decl_param(decl: FactsHandle, index: i64) -> ParamFacts {
    let facts = self.decl_facts.at(decl.node);
    if facts.params.get(index) |param| {
        return param;
    }
    return ParamFacts { name: empty_name(), type_name: empty_name(), borrow: false, mut_borrow: false };
}

/// Returns the number of static parameters a declaration has.
fn (self: &Lowerer) decl_static_param_count(decl: FactsHandle) -> i64 {
    let facts = self.decl_facts.at(decl.node);
    return facts.static_params.len();
}

/// Returns one static parameter of a declaration; the blank record past the
/// last, which no caller reads.
fn (self: &Lowerer) decl_static_param(decl: FactsHandle, index: i64) -> StaticParamFacts {
    let facts = self.decl_facts.at(decl.node);
    if facts.static_params.get(index) |param| {
        return param;
    }
    return StaticParamFacts { name: empty_name(), is_type: false, type_name: empty_name() };
}

/// Returns the body of a declaration, null for one that has none.
fn (self: &Lowerer) decl_body(decl: FactsHandle) -> ?ast::Block {
    return self.decl_facts.at(decl.node).body;
}

/// Returns the return type of a signature.
fn (self: &Lowerer) signature_return(signature: SignatureHandle) -> Name {
    return self.signature_nodes.at(signature.node).return_type;
}

/// Returns one parameter of a signature, or null past the last.
fn (self: &Lowerer) signature_param(signature: SignatureHandle, index: i64) -> ?Param {
    let node = self.signature_nodes.at(signature.node);
    return node.params.get(index);
}

/// Returns the number of parameters a signature declares.
fn (self: &Lowerer) signature_param_count(signature: SignatureHandle) -> i64 {
    let node = self.signature_nodes.at(signature.node);
    return node.params.len();
}

/// Returns the parameter a call hands its argument at index over at, or
/// null when the view has none there.
fn (self: &Lowerer) view_param(view: ParamsView, index: i64) -> ?Param {
    let signature = view.signature orelse return null;
    return self.signature_param(signature, index + view.offset);
}

/// Returns the parameters of a signature, the Go `sig.Params`.
fn params_of(signature: SignatureHandle) -> ParamsView {
    return ParamsView { signature: signature, offset: 0 };
}

/// Drops the receiver, which a method call lowers on its own, the Go
/// `paramsAfterSelf`.
fn params_after_self(signature: SignatureHandle) -> ParamsView {
    return ParamsView { signature: signature, offset: 1 };
}

/// Returns the signature recorded under name, the Go `l.signatures[name]`.
/// Is a declaration a name used as a value refers to: the symbol it is
/// registered under and its signature.
struct ResolvedFunction {
    name: Name,
    signature: SignatureHandle
}

/// Resolves the declaration a name used as a value refers to. A callee is
/// qualified by the resolver; a name in any other position is not, so a
/// module-local function is looked up under the module the reader is inside as
/// well as under the name as written.
fn (self: &var Lowerer) function_by_value_name(name: Name) -> !?ResolvedFunction {
    if self.signature_named(name) |signature| {
        return ResolvedFunction { name: name, signature: signature };
    }
    var qualified = string::new(self.allocator);
    defer qualified.deinit(self.allocator);
    if try self.append_current_module_prefix(&var qualified) {
        let retained = name_text(&self.module.names, name);
        let bytes = retained.as_bytes();
        try qualified.append_bytes(self.allocator, bytes);
        let text = qualified.as_bytes();
        let candidate = try self.module.names.intern(text);
        if self.signature_named(candidate) |signature| {
            return ResolvedFunction { name: candidate, signature: signature };
        }
    }
    return null;
}

/// Appends the module prefix of the function being lowered, `::` included, and
/// reports whether it has one.
fn (self: &var Lowerer) append_current_module_prefix(out: &var string::String) -> !bool {
    let node = self.module.function_nodes.at(self.current.node);
    let retained = name_text(&self.module.names, node.name);
    let bytes = retained.as_bytes();
    let cut = last_namespace_end(bytes);
    if cut > 0 {
        try out.append_bytes(self.allocator, bytes[0..cut]);
        return true;
    }
    let retained_module = name_text(&self.module.names, self.current_test_module);
    let module_bytes = retained_module.as_bytes();
    if mem::len(module_bytes) == 0 {
        return false;
    }
    try out.append_bytes(self.allocator, module_bytes);
    try out.append_bytes(self.allocator, "::");
    return true;
}

/// Returns the byte after the last `::` in a name, or 0 when it has none.
fn last_namespace_end(bytes: []u8) -> i64 {
    var index = mem::len(bytes);
    while index > 1 {
        index = index - 1;
        if bytes[index] == cast<u8>(58) and bytes[index - 1] == cast<u8>(58) {
            return index + 1;
        }
    }
    return 0;
}

/// Spells the function pointer type a signature's name has as a value.
fn (self: &var Lowerer) function_pointer_type(signature: SignatureHandle) -> !Name {
    let node = self.signature_nodes.at(signature.node);
    return node.pointer_type;
}

fn (self: &Lowerer) signature_named(name: Name) -> ?SignatureHandle {
    let retained = name_text(&self.module.names, name);
    let bytes = retained.as_bytes();
    return self.signatures.get(bytes);
}

/// Reports whether name is a declared function, the Go `l.signatures[name]`
/// membership.
fn (self: &Lowerer) has_signature(name: Name) -> bool {
    let retained = name_text(&self.module.names, name);
    let bytes = retained.as_bytes();
    return self.signatures.contains(bytes);
}

/// Returns the params the lowerer declares for a callee, the Go
/// `l.signatures[name].Params`: none when it has no signature for it.
fn (self: &Lowerer) callee_params(name: Name) -> ParamsView {
    if self.signature_named(name) |signature| {
        return params_of(signature);
    }
    return no_params();
}

/// Lowers one function into SSA blocks under an explicit IR symbol name, the
/// Go `lowerFunctionNamed`. The function it builds wears the signature
/// callers were given, rather than a second reading of the same declaration.
fn (self: &var Lowerer) lower_function_named(
    tree: &var ast::Ast,
    decl: FactsHandle,
    name: Name
) -> !?diagnostic::Diagnostic {
    let signature = try self.lower_signature(decl);
    var params = array::new<Param>(self.allocator);
    errdefer params.deinit(self.allocator);
    let count = self.signature_param_count(signature);
    var index = 0;
    while index < count {
        if self.signature_param(signature, index) |param| {
            try params.append(self.allocator, param);
        }
        index = index + 1;
    }
    let export_abi = self.decl_facts.at(decl.node).export_abi;
    let declared_name = self.decl_facts.at(decl.node).name;
    var export_name = empty_name();
    if !is_empty(export_abi) {
        export_name = try self.external_symbol(declared_name);
    }
    self.current = Function {
        node: try self.module.function_nodes.add(self.allocator, FunctionNode {
            name: name,
            params: move params,
            return_type: self.signature_return(signature),
            blocks: array::new<Block>(self.allocator),
            export_abi: export_abi,
            export_name: export_name
        })
    };
    try self.module.functions.append(self.allocator, self.current);
    self.env = try self.envs.new_env();
    if try self.mutably_borrowed_locals(tree, decl) |failed| {
        return move failed;
    }
    self.next_value = 0;
    self.next_block = 0;
    while self.loops.pop() |loop| {
        loop.deinit(self.allocator);
    }
    while self.defer_frames.pop() |frame| {
        frame.deinit(self.allocator);
    }
    var value_slots = array::new<Name>(self.allocator);
    defer value_slots.deinit(self.allocator);
    index = 0;
    while index < count {
        let facts = self.decl_param(decl, index);
        if self.signature_param(signature, index) |param| {
            try self.envs.bind(self.allocator, self.env, facts.name, param.value());
            // A parameter that arrives as the caller's storage is a storage
            // name like a lent local: reads load, assignments store, and
            // address consumers take the pointer itself.
            if param.passing == Passing::CallerStorage {
                try self.slots.append(self.allocator, facts.name);
            } else {
                // One that arrives as a value and is written through needs
                // storage of its own, which is the copy it was handed. One
                // that arrives as an address already reaches storage, and it
                // is the caller's: wrapping it again would hand the callee a
                // borrow of a borrow.
                if self.has_slot(facts.name) and !self.is_reference_type(param.type_name) {
                    try value_slots.append(self.allocator, facts.name);
                }
            }
        }
        index = index + 1;
    }
    let entry = try self.module.names.intern("entry");
    self.block = try self.new_block(entry);
    var slot_index = 0;
    while value_slots.get(slot_index) |slot_name| {
        slot_index = slot_index + 1;
        if self.envs.get(self.env, slot_name) |value| {
            let slot_type = try self.module.names.prefixed("&var ", value.type_name);
            let slot = try self.emit1(Op::LocalSlot, slot_type, value);
            try self.envs.bind(self.allocator, self.env, slot_name, slot);
        }
    }
    if self.decl_body(decl) |body| {
        if try self.lower_block(tree, body) |failed| {
            return move failed;
        }
    }
    if !self.terminated() {
        // A body that runs off its end returns what a written `return;`
        // returns, which for `!void` is a wrapped success rather than a bare
        // void.
        let value = try self.return_void_value();
        self.terminate(return_terminator(value));
    }
    return null;
}

/// Gives a parameter the type the callee sees and how the call hands it
/// over, the Go `lowerParam`. A `&var` parameter is the caller's own
/// storage, because a write through it has to land there rather than in a
/// copy. A `&` parameter cannot write, so a copy is the same observation and
/// stays the cheaper shape -- except for unions, where matching needs an
/// address and the copy is made for the call.
fn (self: &var Lowerer) lower_param(facts: ParamFacts) -> !Param {
    let type_name = try self.resolve_bound_type(facts.type_name);
    var lowered = Param {
        name: try self.module.names.prefixed("%", facts.name),
        type_name: type_name,
        passing: Passing::Value
    };
    if facts.borrow or facts.mut_borrow {
        lowered = try self.borrow_ir_param(lowered, type_name, facts.mut_borrow);
    }
    return lowered;
}

/// Applies `borrow_ir_type` to one parameter record.
fn (self: &var Lowerer) borrow_ir_param(param: Param, elem: Name, mutable: bool) -> !Param {
    let passing = self.borrow_passing(elem, mutable);
    return Param {
        name: param.name,
        type_name: try self.borrow_ir_type(elem, mutable),
        passing: passing
    };
}

/// Decides how a borrow of elem travels: what it is spelled as, the Go
/// `borrowIRType` spelling half. `borrow_passing` is the other half; a
/// parameter and a return ask the same question, so they get the same
/// answer.
fn (self: &var Lowerer) borrow_ir_type(elem: Name, mutable: bool) -> !Name {
    if mutable {
        // A mutable slice borrow writes through the view's own pointer, never
        // into the caller's binding -- element writes only, no re-pointing
        // (ADR-0096) -- so the fat pointer itself is the storage and travels
        // flat, exactly like a shared slice view.
        if self.module.names.is(elem, "[]u8") {
            return elem;
        }
        return self.module.names.prefixed("&var ", elem);
    }
    if self.module.has_union(elem) {
        return self.module.names.prefixed("&", elem);
    }
    // A borrow of an owner reaches the value the caller has, not a copy of
    // it. An owner is where a container header lives, and the header is the
    // storage it describes (ADR-0131): a copy of one stops seeing what the
    // original goes on to own, so the two answer differently the moment
    // anything writes through the original -- `b.show(b.put(v))` would show
    // the value from before the put. Copy data has no such interior, so a
    // borrow of it travels flat.
    if self.is_owner_type(elem) {
        return self.module.names.prefixed("&", elem);
    }
    return elem;
}

/// Decides how a borrow of elem is handed over, the Go `borrowIRType`
/// passing half.
fn (self: &Lowerer) borrow_passing(elem: Name, mutable: bool) -> Passing {
    if mutable {
        if self.module.names.is(elem, "[]u8") {
            return Passing::Value;
        }
        return Passing::CallerStorage;
    }
    if self.module.has_union(elem) {
        return Passing::CopyAddress;
    }
    if self.is_owner_type(elem) {
        return Passing::CopyAddress;
    }
    return Passing::Value;
}

/// Gives a function's result the type it travels as, the Go
/// `lowerReturnType`, so a returned borrow follows the same rule a borrowed
/// parameter does.
fn (self: &var Lowerer) lower_return_type(name: Name) -> !Name {
    if is_empty(name) {
        return self.return_type(name);
    }
    let parsed = try self.parse_type(name);
    var is_borrow = false;
    var mutable = false;
    var elem_name = empty_name();
    match typ::root_node(&self.types, parsed) {
        Borrow(borrow) => {
            is_borrow = true;
            mutable = borrow.mutable;
            let elem = typ::child_type(parsed, borrow.elem);
            let rendered = try typ::render(self.allocator, &self.types, elem);
            elem_name = try self.module.names.intern_owned(move rendered);
        },
        _ => {},
    }
    if !is_borrow {
        return self.return_type(name);
    }
    let spelling = try self.borrow_ir_type(elem_name, mutable);
    return self.return_type(spelling);
}

/// Parses one IR type spelling through the lowerer's table, the Go
/// `l.types.Parse`.
fn (self: &var Lowerer) parse_type(name: Name) -> !typ::Type {
    let retained = name_text(&self.module.names, name);
    let bytes = retained.as_bytes();
    return self.types.parse(bytes);
}

/// Binds the type parameters in force, wherever they stand, the Go
/// `resolveType` (named resolve_bound_type here: project declares a
/// `resolve_type` with a `&var` second parameter, and the IR lowering
/// unions `&var` positions by method name). A parameter inside a static argument list counts:
/// `std::array::Array<T>` is the receiver of every Array method, and lowering
/// it as written would leave the instance carrying the parameter it was
/// instantiated away from.
fn (self: &var Lowerer) resolve_bound_type(name: Name) -> !Name {
    // A `std::meta` form written where a type goes resolves first: it names
    // a type through the capture in force rather than being one (ADR-0113).
    let resolved = try self.resolve_meta_type_deep(name);
    let args = self.current_args orelse return resolved;
    if self.bound_type(args, resolved) |bound| {
        return bound;
    }
    if self.binding_count(args) == 0 or is_empty(resolved) {
        return resolved;
    }
    let node = self.generic_args.at(args.node);
    let retained = name_text(&self.module.names, resolved);
    let bytes = retained.as_bytes();
    let substituted = try typ::substitute_owned_text(self.allocator, bytes, &node.binding_names, &node.binding_types
    );
    return self.module.names.intern_owned(move substituted);
}

/// Binds the type parameters in force across a static argument list, the Go
/// `resolveTypeArgs`. A list is not a type, so each entry is resolved on its
/// own.
fn (self: &var Lowerer) resolve_type_args(list: Name) -> !Name {
    var args = try self.split_static_args(list);
    defer args.deinit(self.allocator);
    if args.len() == 0 {
        return self.resolve_bound_type(list);
    }
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    var index = 0;
    while args.get(index) |arg| {
        if index > 0 {
            try out.append_bytes(self.allocator, ", ");
        }
        index = index + 1;
        let resolved = try self.resolve_bound_type(arg);
        try self.module.names.append_to(&var out, resolved);
    }
    return self.module.names.intern_owned(move out);
}

/// Returns what a type parameter is bound to in the bindings in force, or
/// null when name is not a bound parameter.
fn (self: &Lowerer) bound_type(args: GenericArgsHandle, name: Name) -> ?Name {
    let node = self.generic_args.at(args.node);
    var index = 0;
    while node.bindings.get(index) |binding| {
        index = index + 1;
        if same_name(binding.name, name) {
            return binding.bound;
        }
    }
    return null;
}

/// Returns the number of type parameters the bindings bind.
fn (self: &Lowerer) binding_count(args: GenericArgsHandle) -> i64 {
    let node = self.generic_args.at(args.node);
    return node.bindings.len();
}

/// Returns the compile-time value bound to name in the instance being
/// lowered, the Go `l.staticValues[name]`, or null.
fn (self: &Lowerer) static_value(name: Name) -> ?StaticValue {
    let args = self.current_args orelse return null;
    let node = self.generic_args.at(args.node);
    var index = 0;
    while node.values.get(index) |value| {
        index = index + 1;
        if same_name(value.name, name) {
            return value;
        }
    }
    return null;
}

/// Forwards a static value through an outer binding, the Go
/// `resolveStaticValue`, so a generic passing its own static value on keeps
/// the caller's argument.
fn (self: &Lowerer) resolve_static_value(text: Name) -> Name {
    if self.static_value(text) |bound| {
        return bound.text;
    }
    return text;
}

/// Returns what a function is running as when it holds no instance bindings,
/// the Go empty `typeBindings`.
fn (self: &var Lowerer) clear_bindings() -> void {
    self.current_args = null;
    return;
}
