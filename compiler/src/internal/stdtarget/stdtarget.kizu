import std::mem;

// Mechanical port of internal/stdtarget/stdtarget.go. These compiler forms
// have no runtime implementation; every semantic phase evaluates this one
// closed registry.

/// Names the host contract selected for one build.
pub enum Target {
    Native,
    WasmWasi,
    WasmBrowser,
}

/// Names one compiler-resolved std::target predicate.
pub enum Predicate {
    IsNative,
    IsWasi,
    IsBrowser,
}

/// Returns the predicate named by source text.
pub fn identify(name: []u8) -> ?Predicate {
    if mem::equal_bytes(name, "std::target::is_native") {
        return Predicate::IsNative;
    }
    if mem::equal_bytes(name, "std::target::is_wasi") {
        return Predicate::IsWasi;
    }
    if mem::equal_bytes(name, "std::target::is_browser") {
        return Predicate::IsBrowser;
    }
    return null;
}

/// Answers one predicate for the selected build target.
pub fn evaluate(target: Target, predicate: Predicate) -> bool {
    return match predicate {
        IsNative => target == Target::Native,
        IsWasi => target == Target::WasmWasi,
        IsBrowser => target == Target::WasmBrowser,
    };
}

/// Returns the source spelling of one predicate.
pub fn spelling(predicate: Predicate) -> []u8 {
    return match predicate {
        IsNative => "std::target::is_native",
        IsWasi => "std::target::is_wasi",
        IsBrowser => "std::target::is_browser",
    };
}
