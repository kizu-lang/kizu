import std::mem;
import std::testing;

fn expect_predicate(
    name: []u8,
    predicate: Predicate,
    target: Target
) -> void {
    if identify(name) |identified| {
        testing::expect(identified == predicate);
        testing::expect(mem::equal_bytes(spelling(identified), name));
        testing::expect(evaluate(target, identified));
    } else {
        testing::fail("stdtarget predicate was not found");
    }
}

test "stdtarget predicates share one closed registry" {
    expect_predicate(
        "std::target::is_native", Predicate::IsNative, Target::Native
    );
    expect_predicate(
        "std::target::is_wasi", Predicate::IsWasi, Target::WasmWasi
    );
    expect_predicate(
        "std::target::is_browser", Predicate::IsBrowser, Target::WasmBrowser
    );
    testing::expect(!evaluate(Target::Native, Predicate::IsBrowser));
    testing::expect(!evaluate(Target::WasmWasi, Predicate::IsNative));
    testing::expect(!evaluate(Target::WasmBrowser, Predicate::IsWasi));
    if identify("std::target::unknown") |_| {
        testing::fail("unknown target predicate was identified");
    }
}
