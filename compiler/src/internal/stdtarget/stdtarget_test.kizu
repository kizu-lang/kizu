import std::mem;
import std::testing;

fn expect_predicate(
    name: []u8,
    predicate: Predicate,
    target: Target
) -> void {
    if identify(name) |identified| {
        testing::expect(identified == predicate);
        testing::expect(mem::equal_bytes(spelling(identified), name));
        testing::expect(evaluate(target, identified));
    } else {
        testing::fail("stdtarget predicate was not found");
    }
}

test "stdtarget predicates share one closed registry" {
    expect_predicate(
        "std::target::is_native", Predicate::IsNative, Target::NativeDarwin
    );
    expect_predicate(
        "std::target::is_native", Predicate::IsNative, Target::NativeLinux
    );
    expect_predicate(
        "std::target::is_wasi", Predicate::IsWasi, Target::WasmWasi
    );
    expect_predicate(
        "std::target::is_browser", Predicate::IsBrowser, Target::WasmBrowser
    );
    expect_predicate(
        "std::target::is_darwin", Predicate::IsDarwin, Target::NativeDarwin
    );
    expect_predicate(
        "std::target::is_linux", Predicate::IsLinux, Target::NativeLinux
    );
    testing::expect(!evaluate(Target::NativeDarwin, Predicate::IsBrowser));
    testing::expect(!evaluate(Target::NativeDarwin, Predicate::IsLinux));
    testing::expect(!evaluate(Target::NativeLinux, Predicate::IsDarwin));
    testing::expect(!evaluate(Target::WasmWasi, Predicate::IsNative));
    testing::expect(!evaluate(Target::WasmWasi, Predicate::IsDarwin));
    testing::expect(!evaluate(Target::WasmBrowser, Predicate::IsWasi));
    if identify("std::target::unknown") |_| {
        testing::fail("unknown target predicate was identified");
    }
}

test "stdtarget names the operating system of a native target" {
    testing::expect(is_native(Target::NativeDarwin));
    testing::expect(is_native(Target::NativeLinux));
    testing::expect(!is_native(Target::WasmWasi));
    testing::expect(!is_native(Target::WasmBrowser));
    testing::expect(mem::equal_bytes(os_name(Target::NativeDarwin), "darwin"));
    testing::expect(mem::equal_bytes(os_name(Target::NativeLinux), "linux"));
    testing::expect(mem::equal_bytes(os_name(Target::WasmWasi), ""));
    testing::expect(mem::equal_bytes(os_name(Target::WasmBrowser), ""));
    if native_for("darwin") |target| {
        testing::expect(target == Target::NativeDarwin);
    } else {
        testing::fail("darwin names no native target");
    }
    if native_for("linux") |target| {
        testing::expect(target == Target::NativeLinux);
    } else {
        testing::fail("linux names no native target");
    }
    if native_for("windows") |_| {
        testing::fail("windows named a native target");
    }
    testing::expect(is_native(host()));
    if native_for(os_name(host())) |target| {
        testing::expect(target == host());
    } else {
        testing::fail("the host names no native target");
    }
}
