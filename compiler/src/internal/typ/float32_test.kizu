import std::float;
import std::mem;
import std::testing;

fn expect_f32(text: []u8, bits: u64) -> !void {
    if try parse_f32_literal(mem::page_allocator(), text) |value| {
        testing::expect_equal<u64>(bits, float::bits(value));
    } else {
        testing::fail("f32 literal did not parse");
    }
    return;
}

fn negative(bits: u64) -> u64 {
    return bits | (cast<u64>(1) << 63);
}

test "an f32 literal rounds once from its exact value" {
    try expect_f32("1.000000059604644776257986737988", 0x3ff0000020000000);
    try expect_f32("1.0000000596046447753906249", 0x3ff0000000000000);
    try expect_f32("1.000000059604644775390625", 0x3ff0000000000000);
    try expect_f32("1.000000178813934326171875", 0x3ff0000040000000);
    try expect_f32("1e-45", 0x36a0000000000000);
    try expect_f32("-1e-46", negative(0));
    try expect_f32("3.4028235e38", 0x47efffffe0000000);
    try expect_f32("340282356779733661637539395458142568447.9", 0x47efffffe0000000);
    return;
}

test "an f32 hex literal rounds once from its exact value" {
    try expect_f32("0x1.000001p+00", 0x3ff0000000000000);
    try expect_f32("0x1.00000100000000000001p+00", 0x3ff0000020000000);
    try expect_f32("-0x1.000003p+00", negative(0x3ff0000040000000));
    return;
}

test "an f32 literal past the largest f32 is out of range" {
    let allocator = mem::page_allocator();
    if try parse_f32_literal(allocator, "340282356779733661637539395458142568448.0") |_| {
        testing::fail("f32 literal should overflow");
    }
    if try parse_f32_literal(allocator, "3.5e38") |_| {
        testing::fail("f32 literal should overflow");
    }
    return;
}
