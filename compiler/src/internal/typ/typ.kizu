import compiler::internal::staticexpr;
import compiler::internal::stdmath;
import std::arena;
import std::array;
import std::float;
import std::fmt;
import std::map;
import std::mem;
import std::string;

pub error Error {
    ExpectedName,
    TrailingText,
    ExpectedBufferSize,
    BufferSizeOverflow,
    ExpectedBufferClose,
    UnclosedArguments,
    UnclosedParameters,
    ExpectedResultArrow,
    UnbalancedArgumentClose,
    UnbalancedArgumentOpen,
    EmptyStaticArgument,
}

pub struct Table {
    allocator: Allocator,
    trees: arena::Arena<TypeTree>,
    parsed: map::Map<[]u8, Type>,
}

pub struct Type {
    tree: arena::Handle<TypeTree>,
    root: arena::Handle<Node>,
}

struct TypeTree {
    nodes: arena::Arena<Node>,
    root: arena::Handle<Node>,
}

pub union Node {
    Name(Name),
    Slice(Slice),
    Buffer(Buffer),
    Borrow(Borrow),
    Optional(Optional),
    Const(Const),
    ErrorUnion(ErrorUnion),
    Func(Func),
}

pub struct Name {
    pub path: array::Array<string::String>,
    pub args: array::Array<arena::Handle<Node>>,
    pub source_site: i64,
}

pub struct Slice {
    pub elem: arena::Handle<Node>,
}

pub fn vector_kind(name: []u8) -> i64 {
    if mem::equal_bytes(name, "f64x2") { return 0; }
    if mem::equal_bytes(name, "f32x4") { return 1; }
    if mem::equal_bytes(name, "i64x2") { return 2; }
    if mem::equal_bytes(name, "i32x4") { return 3; }
    if mem::equal_bytes(name, "i16x8") { return 4; }
    if mem::equal_bytes(name, "u64x2") { return 5; }
    if mem::equal_bytes(name, "u32x4") { return 6; }
    if mem::equal_bytes(name, "u16x8") { return 7; }
    return -1;
}

pub fn vector_lane_of_kind(kind: i64) -> []u8 {
    if kind == 0 { return "f64"; }
    if kind == 1 { return "f32"; }
    if kind == 2 { return "i64"; }
    if kind == 3 { return "i32"; }
    if kind == 4 { return "i16"; }
    if kind == 5 { return "u64"; }
    if kind == 6 { return "u32"; }
    return "u16";
}

pub fn vector_lanes(name: []u8) -> i64 {
    if mem::equal_bytes(name, "f64x2") or mem::equal_bytes(name, "i64x2") or
        mem::equal_bytes(name, "u64x2") {
        return 2;
    }
    if mem::equal_bytes(name, "f32x4") or mem::equal_bytes(name, "i32x4") or
        mem::equal_bytes(name, "u32x4") {
        return 4;
    }
    if mem::equal_bytes(name, "i16x8") or mem::equal_bytes(name, "u16x8") {
        return 8;
    }
    return 0;
}

pub fn is_vector(name: []u8) -> bool {
    return vector_lanes(name) != 0;
}

pub struct Buffer {
    pub size: i64,
    pub len: string::String,
    pub elem: arena::Handle<Node>,
}

pub struct Borrow {
    pub elem: arena::Handle<Node>,
    pub mutable: bool,
}

pub struct Optional {
    pub elem: arena::Handle<Node>,
}

pub struct Const {
    pub elem: arena::Handle<Node>,
}

pub struct ErrorUnion {
    pub err: ?arena::Handle<Node>,
    pub ok: arena::Handle<Node>,
}

pub struct Func {
    pub params: array::Array<arena::Handle<Node>>,
    pub result: arena::Handle<Node>,
    pub unsafe_call: bool,
    pub c_abi: bool,
}

pub fn c_func_head() -> []u8 {
    let head =
        \\extern "c" fn(
    ;
    return head;
}

pub fn is_func_spelling(text: []u8) -> bool {
    return mem::starts_with(text, "fn(") or mem::starts_with(text, "unsafe fn(") or
        mem::starts_with(text, c_func_head());
}

pub struct BorrowOptionalParts {
    pub elem: []u8,
    pub mutable: bool,
}

pub struct ApplyParts {
    pub base: []u8,
    pub args: []u8,
}

pub struct MethodNameParts {
    pub receiver: []u8,
    pub method: []u8,
}

pub contract TypeVisitor {
    fn visit(value: &Node) -> void;
}

pub contract NameMapper {
    fn rename_path(
        allocator: Allocator,
        path: &array::Array<string::String>
    ) -> !array::Array<string::String>;
}

pub contract NameFolder {
    fn fold_name(builder: &var Builder, path: array::Array<string::String>, args: array::Array<arena::Handle<Node>>) -> !arena::Handle<Node>;
}

struct PlainNameTransform {}

struct NoReplacements {}

struct RenderedSubstitutions {
    values: map::Map<[]u8, string::String>,
}

struct Parser {
    allocator: Allocator,
    input: []u8,
    position: i64,
    nodes: arena::Arena<Node>,
}

pub struct Builder {
    allocator: Allocator,
    nodes: arena::Arena<Node>,
}

struct Span {
    start: i64,
    end: i64,
}

pub fn new(allocator: Allocator) -> Table {
    return Table {
        allocator: allocator,
        trees: arena::new<TypeTree>(allocator),
        parsed: map::new<[]u8, Type>(allocator)
    };
}

pub fn new_builder(allocator: Allocator) -> Builder {
    return Builder {
        allocator: allocator,
        nodes: arena::new<Node>(allocator)
    };
}

fn (self: &var Builder) add(node: Node) -> !arena::Handle<Node> {
    return try self.nodes.add(self.allocator, move node);
}

fn copy_path(allocator: Allocator, source: &array::Array<string::String>) -> !array::Array<string::String> {
    var path = array::new<string::String>(allocator);
    errdefer path.deinit(allocator);
    var index = 0;
    while source.at(index) |part| {
        let bytes = part.as_bytes();
        let copied = try owned_text(allocator, bytes);
        errdefer copied.deinit(allocator);
        try path.append(allocator, move copied);
        index = index + 1;
    }
    return move path;
}

fn (self: &Builder) at(handle: arena::Handle<Node>) -> &Node {
    return self.nodes.at(handle);
}

pub fn finish_builder(allocator: Allocator, builder: Builder, table: &var Table, root: arena::Handle<Node>) -> !Type {
    let tree = TypeTree { nodes: move builder.nodes, root: root };
    let tree_handle = try table.trees.add(allocator, move tree);
    return Type { tree: tree_handle, root: root };
}

fn (self: &var Table) parse(text: []u8) -> !Type {
    if self.parsed.get(text) |parsed| {
        return parsed;
    }
    let tree = try parse_tree(self.allocator, text);
    let root = tree.root;
    let tree_handle = try self.trees.add(self.allocator, move tree);
    let value = Type {
        tree: tree_handle, root: root
    };
    try self.parsed.insert(self.allocator, text, value);
    return value;
}

fn parse_tree(allocator: Allocator, text: []u8) -> !TypeTree {
    var parser = Parser {
        allocator: allocator,
        input: text,
        position: 0,
        nodes: arena::new<Node>(allocator)
    };
    errdefer parser.deinit(allocator);
    let root = try parser.parse_type();
    if parser.position != mem::len(text) {
        return Error::TrailingText;
    }
    return TypeTree {
        nodes: move parser.nodes,
        root: root
    };
}

fn (self: &var Parser) parse_type() -> !arena::Handle<Node> {
    let left = try self.parse_prefix();
    if !self.accept("!") {
        return left;
    }
    let ok = try self.parse_prefix();
    return try self.nodes.add(self.allocator, Node::ErrorUnion(ErrorUnion {
        err: left,
        ok: ok
    }));
}

fn (self: &var Parser) parse_prefix() -> !arena::Handle<Node> {
    if self.accept("!") {
        let elem = try self.parse_prefix();
        return try self.nodes.add(self.allocator, Node::ErrorUnion(ErrorUnion {
            err: null,
            ok: elem
        }));
    }
    if self.peek(cast<u8>(91)) {
        return self.parse_bracketed();
    }
    if self.accept("&var ") {
        let elem = try self.parse_prefix();
        return try self.nodes.add(self.allocator, Node::Borrow(Borrow {
            elem: elem,
            mutable: true
        }));
    }
    if self.accept("&") {
        let elem = try self.parse_prefix();
        return try self.nodes.add(self.allocator, Node::Borrow(Borrow {
            elem: elem,
            mutable: false
        }));
    }
    if self.accept("?") {
        let elem = try self.parse_prefix();
        return try self.nodes.add(self.allocator, Node::Optional(Optional { elem: elem }));
    }
    if self.accept("const ") {
        let elem = try self.parse_prefix();
        return try self.nodes.add(self.allocator, Node::Const(Const { elem: elem }));
    }
    if self.accept("unsafe fn(") {
        return self.parse_func(true, false);
    }
    if self.accept(c_func_head()) {
        return self.parse_func(false, true);
    }
    if self.accept("fn(") {
        return self.parse_func(false, false);
    }
    return self.parse_name();
}

fn (self: &var Parser) parse_func(unsafe_call: bool, c_abi: bool) -> !arena::Handle<Node> {
    var params = array::new<arena::Handle<Node>>(self.allocator);
    errdefer params.deinit(self.allocator);
    if !self.accept(")") {
        while true {
            try params.append(self.allocator, try self.parse_type());
            if self.accept(",") {
                let _ = self.accept(" ");
            } else {
                break;
            }
        }
        if !self.accept(")") {
            return Error::UnclosedParameters;
        }
    }
    if !self.accept(" -> ") {
        return Error::ExpectedResultArrow;
    }
    let result = try self.parse_type();
    return try self.nodes.add(self.allocator, Node::Func(Func {
        params: move params,
        result: result,
        unsafe_call: unsafe_call,
        c_abi: c_abi
    }));
}

fn (self: &var Parser) parse_bracketed() -> !arena::Handle<Node> {
    if self.accept("[]") {
        let elem = try self.parse_prefix();
        return try self.nodes.add(self.allocator, Node::Slice(Slice { elem: elem }));
    }
    self.position = self.position + 1;
    let start = self.position;
    try self.skip_length();
    let length = self.input[start..self.position];
    if !self.accept("]") {
        return Error::ExpectedBufferClose;
    }
    let elem = try self.parse_prefix();
    if !is_digit(length[0]) {
        let len = try owned_text(self.allocator, length);
        errdefer len.deinit(self.allocator);
        return try self.nodes.add(self.allocator, Node::Buffer(Buffer {
            size: 0,
            len: move len,
            elem: elem
        }));
    }
    let size = staticexpr::parse_i64(length) orelse return Error::BufferSizeOverflow;
    return try self.nodes.add(self.allocator, Node::Buffer(Buffer {
        size: size,
        len: string::new(self.allocator),
        elem: elem
    }));
}

fn (self: &var Parser) skip_length() -> !void {
    var depth = 0;
    let start = self.position;
    while self.position < mem::len(self.input) {
        let byte = self.input[self.position];
        if byte == cast<u8>(40) {
            depth = depth + 1;
        } else if byte == cast<u8>(41) and depth > 0 {
            depth = depth - 1;
        } else if depth == 0 and !is_length_byte(byte) {
            if start == self.position {
                return Error::ExpectedBufferSize;
            }
            return;
        }
        self.position = self.position + 1;
    }
    return Error::ExpectedBufferClose;
}

fn is_length_byte(byte: u8) -> bool {
    return byte == cast<u8>(95) or is_digit(byte) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        (byte >= cast<u8>(65) and byte <= cast<u8>(90));
}

fn (self: &var Parser) parse_name() -> !arena::Handle<Node> {
    var path = array::new<string::String>(self.allocator);
    errdefer path.deinit(self.allocator);
    while true {
        let span = self.parse_ident();
        if span.start == span.end {
            return Error::ExpectedName;
        }
        try path.append(self.allocator, try owned_text(self.allocator,
            self.input[span.start..span.end]
        ));
        if !self.accept("::") {
            break;
        }
    }
    var args = array::new<arena::Handle<Node>>(self.allocator);
    errdefer args.deinit(self.allocator);
    if self.accept("<") {
        while true {
            try args.append(self.allocator, try self.parse_type());
            if self.accept(",") {
                let _ = self.accept(" ");
            } else {
                break;
            }
        }
        if !self.accept(">") {
            return Error::UnclosedArguments;
        }
    }
    return try self.nodes.add(self.allocator, Node::Name(Name {
        path: move path,
        args: move args,
        source_site: -1
    }));
}

fn (self: &var Parser) parse_ident() -> Span {
    let start = self.position;
    while self.position < mem::len(self.input) and
        is_word(self.input[self.position]) {
        self.position = self.position + 1;
    }
    return Span { start: start, end: self.position };
}

fn (self: &Parser) peek(want: u8) -> bool {
    return self.position < mem::len(self.input) and self.input[self.position] == want;
}

fn (self: &var Parser) accept(text: []u8) -> bool {
    if !starts_with_at(self.input, self.position, text) {
        return false;
    }
    self.position = self.position + mem::len(text);
    return true;
}

fn starts_with_at(bytes: []u8, at: i64, prefix: []u8) -> bool {
    if at < 0 or at + mem::len(prefix) > mem::len(bytes) {
        return false;
    }
    var index = 0;
    while index < mem::len(prefix) {
        if bytes[at + index] != prefix[index] {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn is_word(byte: u8) -> bool {
    return byte == cast<u8>(95) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        (byte >= cast<u8>(65) and byte <= cast<u8>(90)) or
        is_digit(byte);
}

fn is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}

fn owned_text(allocator: Allocator, bytes: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, bytes);
    return move out;
}

pub fn split_args(
    allocator: Allocator,
    text: []u8
) -> !array::Array<string::String> {
    var parts = array::new<string::String>(allocator);
    errdefer parts.deinit(allocator);
    if try split_args_into(allocator, text, &var parts) |reason| {
        return reason;
    }
    return move parts;
}

pub fn split_args_optional(
    allocator: Allocator,
    text: []u8
) -> !?array::Array<string::String> {
    var parts = array::new<string::String>(allocator);
    errdefer parts.deinit(allocator);
    if try split_args_into(allocator, text, &var parts) |_| {
        parts.deinit(allocator);
        return null;
    }
    return move parts;
}

fn split_args_into(
    allocator: Allocator,
    text: []u8,
    parts: &var array::Array<string::String>
) -> !?Error {
    var depth = 0;
    var start = 0;
    var index = 0;
    var has_empty = false;
    while index < mem::len(text) {
        let byte = text[index];
        if byte == cast<u8>(60) {
            depth = depth + 1;
        } else {
            if byte == cast<u8>(62) {
                depth = depth - 1;
                if depth < 0 {
                    return Error::UnbalancedArgumentClose;
                }
            } else {
                if byte == cast<u8>(44) and depth == 0 {
                    let part = mem::trim_ascii(text[start..index]);
                    if mem::len(part) == 0 {
                        has_empty = true;
                    }
                    try parts.append(allocator, try owned_text(allocator, part));
                    start = index + 1;
                }
            }
        }
        index = index + 1;
    }
    if depth != 0 {
        return Error::UnbalancedArgumentOpen;
    }
    let final_part = mem::trim_ascii(text[start..mem::len(text)]);
    if mem::len(final_part) == 0 {
        has_empty = true;
    }
    try parts.append(allocator, try owned_text(allocator, final_part));
    if has_empty {
        return Error::EmptyStaticArgument;
    }
    return null;
}

pub fn is_map_key(text: []u8) -> bool {
    if mem::equal_bytes(text, "[]u8") or
        mem::equal_bytes(text, "i8") or mem::equal_bytes(text, "u8") or
        mem::equal_bytes(text, "i16") or mem::equal_bytes(text, "u16") or
        mem::equal_bytes(text, "i32") or mem::equal_bytes(text, "u32") or
        mem::equal_bytes(text, "i64") or mem::equal_bytes(text, "u64") {
        return true;
    }
    return mem::equal_bytes(text, "isize") or mem::equal_bytes(text, "usize");
}

pub fn map_key_type_names() -> []u8 {
    return "[]u8, i8, i16, i32, i64, u8, u16, u32, u64, isize, usize";
}

pub fn error_union_success(text: []u8) -> ?[]u8 {
    var depth = 0;
    var index = 0;
    while index < mem::len(text) {
        let byte = text[index];
        if byte == cast<u8>(60) {
            depth = depth + 1;
        }
        if byte == cast<u8>(62) {
            depth = depth - 1;
        }
        if byte == cast<u8>(33) and depth == 0 {
            return text[index + 1..];
        }
        index = index + 1;
    }
    return null;
}

pub fn optional_elem(text: []u8) -> ?[]u8 {
    if !mem::starts_with(text, "?") or mem::starts_with(text, "?ptr<") {
        return null;
    }
    return text[1..mem::len(text)];
}

pub fn borrow_optional_elem(text: []u8) -> ?BorrowOptionalParts {
    if mem::starts_with(text, "?&var ") {
        return BorrowOptionalParts {
            elem: text[6..mem::len(text)],
            mutable: true
        };
    }
    if mem::starts_with(text, "?&") {
        return BorrowOptionalParts {
            elem: text[2..mem::len(text)],
            mutable: false
        };
    }
    return null;
}

pub fn split_apply(name: []u8) -> ?ApplyParts {
    var open = 0;
    while open < mem::len(name) and name[open] != cast<u8>(60) {
        open = open + 1;
    }
    let end = mem::len(name);
    if open < 1 or open == end or name[end - 1] != cast<u8>(62) or
        open + 1 == end - 1 {
        return null;
    }
    return ApplyParts {
        base: name[0..open],
        args: name[open + 1..end - 1]
    };
}

pub fn split_method_name(name: []u8) -> ?MethodNameParts {
    var index = mem::len(name);
    while index > 0 {
        index = index - 1;
        if name[index] == cast<u8>(46) {
            return MethodNameParts {
                receiver: name[0..index],
                method: name[index + 1..mem::len(name)]
            };
        }
    }
    return null;
}

pub fn cleanup_method() -> []u8 {
    return "deinit";
}

pub fn render(
    allocator: Allocator,
    table: &Table,
    value: Type
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try append_render(allocator, &var out, table, value);
    return move out;
}

pub fn append_render(
    allocator: Allocator,
    out: &var string::String,
    table: &Table,
    value: Type
) -> !void {
    return append_tree_node(allocator,
        out,
        table.trees.at(value.tree),
        value.root
    );
}

pub fn root_node(table: &Table, value: Type) -> &Node {
    let tree = table.trees.at(value.tree);
    return tree.nodes.at(value.root);
}

pub fn child_type(
    parent: Type,
    child: arena::Handle<Node>
) -> Type {
    return Type { tree: parent.tree, root: child };
}

fn append_tree_node(
    allocator: Allocator,
    out: &var string::String,
    tree: &TypeTree,
    root: arena::Handle<Node>
) -> !void {
    let lookup = NoReplacements {};
    return append_tree_node_with<NoReplacements>(allocator,
        out, tree, root, &lookup
    );
}

fn append_tree_node_with<R>(
    allocator: Allocator,
    out: &var string::String,
    tree: &TypeTree,
    root: arena::Handle<Node>,
    lookup: &R
) -> !void {
    match tree.nodes.at(root) {
        Name(node) => try append_name_with<R>(allocator, out, tree, node, lookup),
        Slice(node) => {
            try out.append_bytes(allocator, "[]");
            try append_tree_node_with<R>(allocator, out, tree, node.elem, lookup);
        },
        Buffer(node) => {
            try out.append_byte(allocator, cast<u8>(91));
            if node.len.len() > 0 {
                let len = node.len.as_bytes();
                try out.append_bytes(allocator, len);
            } else {
                try fmt::append_i64(allocator, out, node.size);
            }
            try out.append_byte(allocator, cast<u8>(93));
            try append_tree_node_with<R>(allocator, out, tree, node.elem, lookup);
        },
        Borrow(node) => {
            if node.mutable {
                try out.append_bytes(allocator, "&var ");
            } else {
                try out.append_byte(allocator, cast<u8>(38));
            }
            try append_tree_node_with<R>(allocator, out, tree, node.elem, lookup);
        },
        Optional(node) => {
            try out.append_byte(allocator, cast<u8>(63));
            try append_tree_node_with<R>(allocator, out, tree, node.elem, lookup);
        },
        Const(node) => {
            try out.append_bytes(allocator, "const ");
            try append_tree_node_with<R>(allocator, out, tree, node.elem, lookup);
        },
        ErrorUnion(node) => {
            if node.err |err| {
                try append_tree_node_with<R>(allocator, out, tree, err, lookup);
            }
            try out.append_byte(allocator, cast<u8>(33));
            try append_tree_node_with<R>(allocator, out, tree, node.ok, lookup);
        },
        Func(node) => try append_func_with<R>(allocator, out, tree, node, lookup),
    }
    return;
}

fn append_func_with<R>(
    allocator: Allocator,
    out: &var string::String,
    tree: &TypeTree,
    node: &Func,
    lookup: &R
) -> !void {
    if node.c_abi {
        try out.append_bytes(allocator, c_func_head());
    } else if node.unsafe_call {
        try out.append_bytes(allocator, "unsafe fn(");
    } else {
        try out.append_bytes(allocator, "fn(");
    }
    var index = 0;
    while node.params.get(index) |param| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try append_tree_node_with<R>(allocator, out, tree, param, lookup);
        index = index + 1;
    }
    try out.append_bytes(allocator, ") -> ");
    return append_tree_node_with<R>(allocator, out, tree, node.result, lookup);
}

fn append_name_with<R>(
    allocator: Allocator,
    out: &var string::String,
    tree: &TypeTree,
    node: &Name,
    lookup: &R
) -> !void {
    comptime if R == type<NoReplacements> {} else {
        if node.path.len() == 1 and node.args.len() == 0 {
            if node.path.at(0) |part| {
                let bytes = part.as_bytes();
                if try lookup.append_replacement(allocator, out, bytes) {
                    return;
                }
            }
        }
    }
    try append_name_path(allocator, out, node);
    if node.args.len() == 0 {
        return;
    }
    try out.append_byte(allocator, cast<u8>(60));
    var index = 0;
    while node.args.get(index) |arg| {
        if index > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try append_tree_node_with<R>(allocator, out, tree, arg, lookup);
        index = index + 1;
    }
    try out.append_byte(allocator, cast<u8>(62));
    return;
}

fn (self: &RenderedSubstitutions) append_replacement(
    allocator: Allocator,
    out: &var string::String,
    name: []u8
) -> !bool {
    if self.values.at(name) |replacement| {
        let bytes = replacement.as_bytes();
        try out.append_bytes(allocator, bytes);
        return true;
    }
    return false;
}

fn append_name_path(allocator: Allocator, out: &var string::String, node: &Name) -> !void {
    var index = 0;
    while node.path.at(index) |part| {
        if index > 0 {
            try out.append_bytes(allocator, "::");
        }
        let bytes = part.as_bytes();
        try out.append_bytes(allocator, bytes);
        index = index + 1;
    }
    return;
}

pub fn equal(
    left_table: &Table,
    left: Type,
    right_table: &Table,
    right: Type
) -> bool {
    return equal_node(
        left_table.trees.at(left.tree),
        left.root,
        right_table.trees.at(right.tree),
        right.root
    );
}

fn equal_len(left: &string::String, right: &string::String) -> bool {
    let left_bytes = left.as_bytes();
    let right_bytes = right.as_bytes();
    return mem::equal_bytes(left_bytes, right_bytes);
}

fn equal_node(
    left: &TypeTree,
    left_handle: arena::Handle<Node>,
    right: &TypeTree,
    right_handle: arena::Handle<Node>
) -> bool {
    return match left.nodes.at(left_handle) {
        Name(a) => match right.nodes.at(right_handle) {
            Name(b) => equal_name(left, a, right, b),
            _ => false,
        },
        Slice(a) => match right.nodes.at(right_handle) {
            Slice(b) => equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        Buffer(a) => match right.nodes.at(right_handle) {
            Buffer(b) => a.size == b.size and equal_len(&a.len, &b.len) and
                equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        Borrow(a) => match right.nodes.at(right_handle) {
            Borrow(b) => a.mutable == b.mutable and
                equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        Optional(a) => match right.nodes.at(right_handle) {
            Optional(b) => equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        Const(a) => match right.nodes.at(right_handle) {
            Const(b) => equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        ErrorUnion(a) => match right.nodes.at(right_handle) {
            ErrorUnion(b) => equal_error_union(left, a, right, b),
            _ => false,
        },
        Func(a) => match right.nodes.at(right_handle) {
            Func(b) => equal_func(left, a, right, b),
            _ => false,
        },
    };
}

fn equal_func(
    left: &TypeTree,
    a: &Func,
    right: &TypeTree,
    b: &Func
) -> bool {
    if a.unsafe_call != b.unsafe_call or a.params.len() != b.params.len() {
        return false;
    }
    var index = 0;
    while a.params.get(index) |left_param| {
        if b.params.get(index) |right_param| {
            if !equal_node(left, left_param, right, right_param) {
                return false;
            }
        }
        index = index + 1;
    }
    return equal_node(left, a.result, right, b.result);
}

fn equal_name(
    left: &TypeTree,
    a: &Name,
    right: &TypeTree,
    b: &Name
) -> bool {
    if a.path.len() != b.path.len() or a.args.len() != b.args.len() {
        return false;
    }
    var index = 0;
    while a.path.at(index) |left_part| {
        if b.path.at(index) |right_part| {
            let left_bytes = left_part.as_bytes();
            let right_bytes = right_part.as_bytes();
            if !mem::equal_bytes(left_bytes, right_bytes) {
                return false;
            }
        } else {
            return false;
        }
        index = index + 1;
    }
    index = 0;
    while a.args.get(index) |left_arg| {
        if b.args.get(index) |right_arg| {
            if !equal_node(left, left_arg, right, right_arg) {
                return false;
            }
        } else {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn equal_error_union(
    left: &TypeTree,
    a: &ErrorUnion,
    right: &TypeTree,
    b: &ErrorUnion
) -> bool {
    if a.err |left_err| {
        if b.err |right_err| {
            if !equal_node(left, left_err, right, right_err) {
                return false;
            }
        } else {
            return false;
        }
    } else {
        if b.err |_| {
            return false;
        }
    }
    return equal_node(left, a.ok, right, b.ok);
}

pub fn map_names<M>(table: &var Table, value: Type, mapper: &var M) -> !Type {
    var folder = PlainNameTransform {};
    let allocator = table.allocator;
    let mapped = try map_tree<M, PlainNameTransform>(allocator, table, value, mapper, &var folder);
    return try finish_builder(allocator, move mapped.builder, table, mapped.root);
}

pub fn fold_names_into<F>(source: &Table, value: Type, destination: &var Table, folder: &var F) -> !Type {
    var mapper = PlainNameTransform {};
    return transform_names<PlainNameTransform, F>(source, value, destination, &var mapper, folder);
}

fn (self: &var PlainNameTransform) rename_path(allocator: Allocator, path: &array::Array<string::String>) -> !array::Array<string::String> {
    return copy_path(allocator, path);
}

fn (self: &var PlainNameTransform) fold_name(builder: &var Builder, path: array::Array<string::String>, args: array::Array<arena::Handle<Node>>) -> !arena::Handle<Node> {
    return builder.add(Node::Name(Name { path: move path, args: move args, source_site: -1 }));
}

fn transform_names<M, F>(source: &Table, value: Type, destination: &var Table, mapper: &var M, folder: &var F) -> !Type {
    let allocator = destination.allocator;
    let mapped = try map_tree<M, F>(allocator, source, value, mapper, folder);
    return try finish_builder(allocator, move mapped.builder, destination, mapped.root);
}

struct MappedTree {
    builder: Builder,
    root: arena::Handle<Node>,
}

fn map_tree<M, F>(allocator: Allocator, source: &Table, value: Type, mapper: &var M, folder: &var F) -> !MappedTree {
    var builder = new_builder(allocator);
    errdefer builder.deinit(allocator);
    let root = try map_names_node<M, F>(allocator, &var builder, source.trees.at(value.tree), value.root, mapper, folder);
    return MappedTree { builder: move builder, root: root };
}

fn map_names_node<M, F>(allocator: Allocator, builder: &var Builder, value: &TypeTree, handle: arena::Handle<Node>, mapper: &var M, folder: &var F) -> !arena::Handle<Node> {
    return match value.nodes.at(handle) {
        Name(node) => try map_name_node<M, F>(builder, value, node, mapper, folder),
        Slice(node) => {
            let elem = try map_names_node<M, F>(allocator, builder, value, node.elem, mapper, folder);
            try builder.nodes.add(allocator, Node::Slice(Slice { elem: elem }))
        },
        Buffer(node) => {
            let elem = try map_names_node<M, F>(allocator, builder, value, node.elem, mapper, folder);
            try add_buffer(builder, node, elem)
        },
        Borrow(node) => {
            let elem = try map_names_node<M, F>(allocator, builder, value, node.elem, mapper, folder);
            try builder.nodes.add(allocator, Node::Borrow(Borrow {
                elem: elem,
                mutable: node.mutable
            }))
        },
        Optional(node) => {
            let elem = try map_names_node<M, F>(allocator, builder, value, node.elem, mapper, folder);
            try builder.nodes.add(allocator, Node::Optional(Optional { elem: elem }))
        },
        Const(node) => {
            let elem = try map_names_node<M, F>(allocator, builder, value, node.elem, mapper, folder);
            try builder.nodes.add(allocator, Node::Const(Const { elem: elem }))
        },
        ErrorUnion(node) => try map_error_union_names<M, F>(allocator, builder, value, node, mapper, folder),
        Func(node) => try map_func_names<M, F>(builder, value, node, mapper, folder),
    };
}

fn map_func_names<M, F>(builder: &var Builder, value: &TypeTree, node: &Func, mapper: &var M, folder: &var F) -> !arena::Handle<Node> {
    let allocator = builder.allocator;
    var params = array::new<arena::Handle<Node>>(allocator);
    errdefer params.deinit(builder.allocator);
    var index = 0;
    while node.params.get(index) |param| {
        try params.append(builder.allocator, try map_names_node<M, F>(allocator, builder, value, param, mapper, folder));
        index = index + 1;
    }
    let result = try map_names_node<M, F>(allocator, builder, value, node.result, mapper, folder);
    return try builder.nodes.add(allocator, Node::Func(Func {
        params: move params,
        result: result,
        unsafe_call: node.unsafe_call,
        c_abi: node.c_abi
    }));
}

fn map_name_node<M, F>(builder: &var Builder, value: &TypeTree, node: &Name, mapper: &var M, folder: &var F) -> !arena::Handle<Node> {
    var path = try mapper.rename_path(builder.allocator, &node.path);
    errdefer path.deinit(builder.allocator);
    let allocator = builder.allocator;
    var args = array::new<arena::Handle<Node>>(allocator);
    errdefer args.deinit(builder.allocator);
    var index = 0;
    while node.args.get(index) |arg| {
        try args.append(allocator, try map_names_node<M, F>(allocator, builder, value, arg, mapper, folder));
        index = index + 1;
    }
    return folder.fold_name(builder, move path, move args);
}

fn map_error_union_names<M, F>(allocator: Allocator, builder: &var Builder, value: &TypeTree, node: &ErrorUnion, mapper: &var M, folder: &var F) -> !arena::Handle<Node> {
    let ok = try map_names_node<M, F>(allocator, builder, value, node.ok, mapper, folder);
    if node.err |source_err| {
        let err = try map_names_node<M, F>(allocator, builder, value, source_err, mapper, folder);
        return try builder.nodes.add(allocator, Node::ErrorUnion(ErrorUnion { err: err, ok: ok }));
    }
    return try builder.nodes.add(allocator, Node::ErrorUnion(ErrorUnion { err: null, ok: ok }));
}

pub fn substitute(
    table: &var Table,
    value: Type,
    substitutions: &map::Map<[]u8, Type>
) -> !Type {
    let allocator = table.allocator;
    if substitutions.len() == 0 {
        return value;
    }
    var builder = new_builder(allocator);
    errdefer builder.deinit(allocator);
    let root = try substitute_node(allocator,
        &var builder,
        table,
        table.trees.at(value.tree),
        value.root,
        substitutions,
        true
    );
    return try finish_builder(allocator, move builder, table, root);
}

pub fn wrap_borrow(
    table: &var Table,
    value: Type,
    mutable: bool
) -> !Type {
    let allocator = table.allocator;
    var substitutions = map::new<[]u8, Type>(allocator);
    defer substitutions.deinit(allocator);
    var builder = new_builder(allocator);
    errdefer builder.deinit(allocator);
    let elem = try substitute_node(allocator,
        &var builder,
        table,
        table.trees.at(value.tree),
        value.root,
        &substitutions,
        false
    );
    let root = try builder.nodes.add(allocator, Node::Borrow(Borrow {
        elem: elem,
        mutable: mutable
    }));
    return try finish_builder(allocator, move builder, table, root);
}

fn substitute_node(
    allocator: Allocator,
    builder: &var Builder,
    table: &Table,
    tree: &TypeTree,
    handle: arena::Handle<Node>,
    substitutions: &map::Map<[]u8, Type>,
    replace_names: bool
) -> !arena::Handle<Node> {
    return match tree.nodes.at(handle) {
        Name(node) => try substitute_name(
            builder,
            table,
            tree,
            node,
            substitutions,
            replace_names
        ),
        Slice(node) => {
            let elem = try substitute_node(allocator,
                builder, table, tree, node.elem, substitutions, replace_names
            );
            try builder.nodes.add(allocator, Node::Slice(Slice { elem: elem }))
        },
        Buffer(node) => {
            let elem = try substitute_node(allocator,
                builder, table, tree, node.elem, substitutions, replace_names
            );
            try add_buffer(builder, node, elem)
        },
        Borrow(node) => {
            let elem = try substitute_node(allocator,
                builder, table, tree, node.elem, substitutions, replace_names
            );
            try builder.nodes.add(allocator, Node::Borrow(Borrow {
                elem: elem,
                mutable: node.mutable
            }))
        },
        Optional(node) => {
            let elem = try substitute_node(allocator,
                builder, table, tree, node.elem, substitutions, replace_names
            );
            try builder.nodes.add(allocator, Node::Optional(Optional { elem: elem }))
        },
        Const(node) => {
            let elem = try substitute_node(allocator,
                builder, table, tree, node.elem, substitutions, replace_names
            );
            try builder.nodes.add(allocator, Node::Const(Const { elem: elem }))
        },
        ErrorUnion(node) => try substitute_error_union(allocator,
            builder,
            table,
            tree,
            node,
            substitutions,
            replace_names
        ),
        Func(node) => try substitute_func(
            builder,
            table,
            tree,
            node,
            substitutions,
            replace_names
        ),
    };
}

fn add_buffer(builder: &var Builder, node: &Buffer, elem: arena::Handle<Node>) -> !arena::Handle<Node> {
    let source = node.len.as_bytes();
    let len = try owned_text(builder.allocator, source);
    errdefer len.deinit(builder.allocator);
    return builder.add(Node::Buffer(Buffer { size: node.size, len: move len, elem: elem }));
}

fn substitute_func(
    builder: &var Builder,
    table: &Table,
    tree: &TypeTree,
    node: &Func,
    substitutions: &map::Map<[]u8, Type>,
    replace_names: bool
) -> !arena::Handle<Node> {
    let allocator = builder.allocator;
    var params = array::new<arena::Handle<Node>>(allocator);
    errdefer params.deinit(allocator);
    var index = 0;
    while node.params.get(index) |param| {
        try params.append(allocator, try substitute_node(allocator,
            builder, table, tree, param, substitutions, replace_names
        ));
        index = index + 1;
    }
    let result = try substitute_node(allocator,
        builder, table, tree, node.result, substitutions, replace_names
    );
    return try builder.nodes.add(allocator, Node::Func(Func {
        params: move params,
        result: result,
        unsafe_call: node.unsafe_call,
        c_abi: node.c_abi
    }));
}

fn substitute_name(
    builder: &var Builder,
    table: &Table,
    tree: &TypeTree,
    node: &Name,
    substitutions: &map::Map<[]u8, Type>,
    replace_names: bool
) -> !arena::Handle<Node> {
    let allocator = builder.allocator;
    if replace_names and node.path.len() == 1 and node.args.len() == 0 {
        if node.path.at(0) |part| {
            let name = part.as_bytes();
            if substitutions.get(name) |replacement| {
                return substitute_node(allocator,
                    builder,
                    table,
                    table.trees.at(replacement.tree),
                    replacement.root,
                    substitutions,
                    false
                );
            }
        }
    }
    var args = array::new<arena::Handle<Node>>(allocator);
    errdefer args.deinit(allocator);
    var index = 0;
    while node.args.get(index) |arg| {
        try args.append(allocator, try substitute_node(allocator,
            builder,
            table,
            tree,
            arg,
            substitutions,
            replace_names
        ));
        index = index + 1;
    }
    let path = try copy_path(allocator, &node.path);
    return builder.add(Node::Name(Name { path: move path, args: move args, source_site: -1 }));
}

fn substitute_error_union(
    allocator: Allocator,
    builder: &var Builder,
    table: &Table,
    tree: &TypeTree,
    node: &ErrorUnion,
    substitutions: &map::Map<[]u8, Type>,
    replace_names: bool
) -> !arena::Handle<Node> {
    let ok = try substitute_node(allocator,
        builder, table, tree, node.ok, substitutions, replace_names
    );
    if node.err |source_err| {
        let err = try substitute_node(allocator,
            builder, table, tree, source_err, substitutions, replace_names
        );
        return try builder.nodes.add(allocator, Node::ErrorUnion(ErrorUnion { err: err, ok: ok }));
    }
    return try builder.nodes.add(allocator, Node::ErrorUnion(ErrorUnion { err: null, ok: ok }));
}

pub union Bound {
    Type(Type),
    Problem(string::String),
}

pub fn bind_lengths(table: &var Table, value: Type, env: &staticexpr::Env) -> !Bound {
    let allocator = table.allocator;
    var builder = new_builder(allocator);
    errdefer builder.deinit(allocator);
    var problem = string::new(allocator);
    errdefer problem.deinit(allocator);
    let root = try bind_node(&var builder, table.trees.at(value.tree), value.root, env, &var problem);
    if problem.len() > 0 {
        builder.deinit(allocator);
        return Bound::Problem(move problem);
    }
    problem.deinit(allocator);
    return Bound::Type(try finish_builder(allocator, move builder, table, root));
}

fn bind_node(
    builder: &var Builder,
    tree: &TypeTree,
    handle: arena::Handle<Node>,
    env: &staticexpr::Env,
    problem: &var string::String
) -> !arena::Handle<Node> {
    let allocator = builder.allocator;
    return match tree.nodes.at(handle) {
        Name(node) => {
            var args = array::new<arena::Handle<Node>>(allocator);
            errdefer args.deinit(allocator);
            var index = 0;
            while node.args.get(index) |arg| {
                try args.append(allocator, try bind_node(builder, tree, arg, env, problem));
                index = index + 1;
            }
            let path = try copy_path(allocator, &node.path);
            try builder.add(Node::Name(Name { path: move path, args: move args, source_site: -1 }))
        },
        Slice(node) => {
            let elem = try bind_node(builder, tree, node.elem, env, problem);
            try builder.add(Node::Slice(Slice { elem: elem }))
        },
        Buffer(node) => try bind_buffer(builder, tree, handle, node, env, problem),
        Borrow(node) => {
            let elem = try bind_node(builder, tree, node.elem, env, problem);
            try builder.add(Node::Borrow(Borrow { elem: elem, mutable: node.mutable }))
        },
        Optional(node) => {
            let elem = try bind_node(builder, tree, node.elem, env, problem);
            try builder.add(Node::Optional(Optional { elem: elem }))
        },
        Const(node) => {
            let elem = try bind_node(builder, tree, node.elem, env, problem);
            try builder.add(Node::Const(Const { elem: elem }))
        },
        ErrorUnion(node) => {
            let ok = try bind_node(builder, tree, node.ok, env, problem);
            if node.err |source_err| {
                let err = try bind_node(builder, tree, source_err, env, problem);
                try builder.add(Node::ErrorUnion(ErrorUnion { err: err, ok: ok }))
            } else {
                try builder.add(Node::ErrorUnion(ErrorUnion { err: null, ok: ok }))
            }
        },
        Func(node) => {
            var params = array::new<arena::Handle<Node>>(allocator);
            errdefer params.deinit(allocator);
            var index = 0;
            while node.params.get(index) |param| {
                try params.append(allocator, try bind_node(builder, tree, param, env, problem));
                index = index + 1;
            }
            let result = try bind_node(builder, tree, node.result, env, problem);
            try builder.add(Node::Func(Func {
                params: move params,
                result: result,
                unsafe_call: node.unsafe_call,
                c_abi: node.c_abi
            }))
        },
    };
}

fn bind_buffer(
    builder: &var Builder,
    tree: &TypeTree,
    handle: arena::Handle<Node>,
    node: &Buffer,
    env: &staticexpr::Env,
    problem: &var string::String
) -> !arena::Handle<Node> {
    let allocator = builder.allocator;
    let elem = try bind_node(builder, tree, node.elem, env, problem);
    let len = node.len.as_bytes();
    if mem::len(len) == 0 or !try staticexpr::binds_all(allocator, len, env) {
        return add_buffer(builder, node, elem);
    }
    let outcome = try staticexpr::eval(allocator, len, env);
    match outcome {
        Value(size) => {
            if size >= 1 {
                return builder.add(Node::Buffer(Buffer {
                    size: size, len: string::new(allocator), elem: elem
                }));
            }
            if problem.len() == 0 {
                try problem.append_bytes(allocator, "length of `");
                try append_tree_node(allocator, problem, tree, handle);
                try problem.append_bytes(allocator, "` is ");
                try fmt::append_i64(allocator, problem, size);
                try problem.append_bytes(allocator, "; an array holds at least 1 element");
            }
        },
        Problem(message) => {
            defer message.deinit(allocator);
            if problem.len() == 0 {
                try problem.append_bytes(allocator, "length of `");
                try append_tree_node(allocator, problem, tree, handle);
                try problem.append_bytes(allocator, "`: ");
                let bytes = message.as_bytes();
                try problem.append_bytes(allocator, bytes);
            }
        },
    }
    return add_buffer(builder, node, elem);
}

pub fn bind_lengths_text(allocator: Allocator, text: []u8, env: &staticexpr::Env) -> !string::String {
    if !has_static_length(text) {
        return owned_text(allocator, text);
    }
    var table = new(allocator);
    defer table.deinit(allocator);
    let parsed = try table.parse(text);
    let bound = try bind_lengths(&var table, parsed, env);
    match bound {
        Type(value) => return render(allocator, &table, value),
        Problem(problem) => {
            problem.deinit(allocator);
            return owned_text(allocator, text);
        },
    }
}

pub fn length_problem(allocator: Allocator, text: []u8, env: &staticexpr::Env) -> !?string::String {
    var table = new(allocator);
    defer table.deinit(allocator);
    let parsed = try table.parse(text);
    let bound = try bind_lengths(&var table, parsed, env);
    match bound {
        Type(_) => return null,
        Problem(problem) => return move problem,
    }
}

pub fn has_static_length(text: []u8) -> bool {
    var index = 0;
    while index + 1 < mem::len(text) {
        if text[index] == cast<u8>(91) {
            let next = text[index + 1];
            if next != cast<u8>(93) and !is_digit(next) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

pub fn substitute_text(
    allocator: Allocator,
    text: []u8,
    substitutions: &map::Map<[]u8, []u8>
) -> !string::String {
    if substitutions.len() == 0 {
        return owned_text(allocator, text);
    }
    var table = new(allocator);
    defer table.deinit(allocator);
    let parsed = try table.parse(text);
    var rendered_substitutions = RenderedSubstitutions {
        values: map::new<[]u8, string::String>(allocator)
    };
    defer rendered_substitutions.deinit(allocator);
    var index = 0;
    while substitutions.key_at(index) |name| {
        if substitutions.get(name) |replacement| {
            try put_rendered_substitution(allocator, &var table, &var rendered_substitutions.values, name, replacement);
        }
        index = index + 1;
    }
    return render_substituted(allocator,
        &table,
        parsed,
        &rendered_substitutions
    );
}

pub fn substitute_owned_text(
    allocator: Allocator,
    text: []u8,
    names: &array::Array<string::String>,
    replacements: &array::Array<string::String>
) -> !string::String {
    if names.len() == 0 or names.len() != replacements.len() {
        return owned_text(allocator, text);
    }
    var table = new(allocator);
    defer table.deinit(allocator);
    let parsed = try table.parse(text);
    var rendered_substitutions = RenderedSubstitutions {
        values: map::new<[]u8, string::String>(allocator)
    };
    defer rendered_substitutions.deinit(allocator);
    var index = 0;
    while names.at(index) |name| {
        if replacements.at(index) |replacement| {
            let name_bytes = name.as_bytes();
            let replacement_bytes = replacement.as_bytes();
            try put_rendered_substitution(allocator, &var table, &var rendered_substitutions.values, name_bytes, replacement_bytes);
        }
        index = index + 1;
    }
    return render_substituted(allocator,
        &table,
        parsed,
        &rendered_substitutions
    );
}

fn put_rendered_substitution(allocator: Allocator, table: &var Table, values: &var map::Map<[]u8, string::String>, name: []u8, replacement: []u8) -> !void {
    let replacement_type = try table.parse(replacement);
    if values.at_mut(name) |existing| {
        existing.clear();
        return append_render(allocator, existing, table, replacement_type);
    }
    let replacement_text = try render(allocator, table, replacement_type);
    return values.insert(allocator, name, move replacement_text);
}

fn render_substituted(
    allocator: Allocator,
    table: &Table,
    parsed: Type,
    substitutions: &RenderedSubstitutions
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try append_tree_node_with<RenderedSubstitutions>(allocator,
        &var out,
        table.trees.at(parsed.tree),
        parsed.root,
        substitutions
    );
    return move out;
}

pub fn walk<V>(table: &Table, value: Type, visitor: &var V) -> void {
    walk_node<V>(table.trees.at(value.tree), value.root, visitor);
}

fn walk_node<V>(
    value: &TypeTree,
    handle: arena::Handle<Node>,
    visitor: &var V
) -> void {
    visitor.visit(value.nodes.at(handle));
    match value.nodes.at(handle) {
        Name(node) => {
            var index = 0;
            while node.args.get(index) |arg| {
                walk_node<V>(value, arg, visitor);
                index = index + 1;
            }
        },
        Slice(node) => walk_node<V>(value, node.elem, visitor),
        Buffer(node) => walk_node<V>(value, node.elem, visitor),
        Borrow(node) => walk_node<V>(value, node.elem, visitor),
        Optional(node) => walk_node<V>(value, node.elem, visitor),
        Const(node) => walk_node<V>(value, node.elem, visitor),
        ErrorUnion(node) => {
            if node.err |err| {
                walk_node<V>(value, err, visitor);
            }
            walk_node<V>(value, node.ok, visitor);
        },
        Func(node) => {
            var index = 0;
            while node.params.get(index) |param| {
                walk_node<V>(value, param, visitor);
                index = index + 1;
            }
            walk_node<V>(value, node.result, visitor);
        },
    }
    return;
}

pub fn shift_i64(op: []u8, value: i64, amount: i64) -> i64 {
    var count = amount;
    if count >= 64 {
        if mem::equal_bytes(op, "<<") {
            return 0;
        }
        count = 63;
    }
    if mem::equal_bytes(op, "<<") {
        return value << count;
    }
    return value >> count;
}

pub fn clean_float_literal(allocator: Allocator, text: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    let length = mem::len(text);
    while index < length {
        let ch = text[index];
        index = index + 1;
        if ch == cast<u8>(95) {
            continue;
        }
        if ch == cast<u8>(69) {
            try out.append_byte(allocator, cast<u8>(101));
            continue;
        }
        try out.append_byte(allocator, ch);
    }
    return move out;
}

pub fn parse_float_literal(allocator: Allocator, text: []u8) -> !?f64 {
    if hex_float_spelling(text) {
        return stdmath::parse_literal(text);
    }
    let value = try float::parse(allocator, text) orelse return null;
    if float::is_infinite(value) {
        return null;
    }
    return value;
}

fn hex_float_spelling(text: []u8) -> bool {
    var index = 0;
    if mem::len(text) > 0 and text[0] == cast<u8>(45) {
        index = 1;
    }
    return index + 1 < mem::len(text) and text[index] == cast<u8>(48) and
        text[index + 1] == cast<u8>(120);
}
