import std::arena;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// Mechanical port of internal/typ's type representation, table, parser,
// renderer, structural equality, and walk. One Table owns the parsed trees for
// a compiler phase; Type and child edges are copy handles into those trees.

pub error Error {
    ExpectedName,
    TrailingText,
    ExpectedBufferSize,
    BufferSizeOverflow,
    ExpectedBufferClose,
    UnclosedArguments,
    UnbalancedArgumentClose,
    UnbalancedArgumentOpen,
    EmptyStaticArgument,
}

/// Owns every parsed type tree retained by one compiler phase.
pub struct Table {
    allocator: Allocator,
    trees: arena::Arena<TypeTree>,
    parsed: map::Map<[]u8, Type>
}

/// Identifies one node in a type tree retained by a Table.
pub struct Type {
    tree: arena::Handle<TypeTree>,
    root: arena::Handle<Node>
}

// TypeTree owns the node storage for one independently built type graph.
struct TypeTree {
    nodes: arena::Arena<Node>,
    root: arena::Handle<Node>
}

/// Is one node in a parsed type.
pub union Node {
    Name(Name),
    Slice(Slice),
    Buffer(Buffer),
    Borrow(Borrow),
    Optional(Optional),
    Const(Const),
    ErrorUnion(ErrorUnion),
}

/// Is a primitive, declared type, type parameter, or generic application.
pub struct Name {
    pub path: array::Array<string::String>,
    pub args: array::Array<arena::Handle<Node>>
}

/// Is `[]T`.
pub struct Slice {
    pub elem: arena::Handle<Node>
}

/// Is `[N]T`.
pub struct Buffer {
    pub size: i64,
    pub elem: arena::Handle<Node>
}

/// Is `&T` or `&var T`.
pub struct Borrow {
    pub elem: arena::Handle<Node>,
    pub mutable: bool
}

/// Is `?T`.
pub struct Optional {
    pub elem: arena::Handle<Node>
}

/// Is `const T` inside a static argument list.
pub struct Const {
    pub elem: arena::Handle<Node>
}

/// Is `!T`, or `E!T` when err is present.
pub struct ErrorUnion {
    pub err: ?arena::Handle<Node>,
    pub ok: arena::Handle<Node>
}

/// Is the payload and mutability of a borrow optional spelling.
pub struct BorrowOptionalParts {
    pub elem: []u8,
    pub mutable: bool
}

/// Is the base and argument text of a generic application spelling.
pub struct ApplyParts {
    pub base: []u8,
    pub args: []u8
}

/// Is the receiver and method of a receiver-qualified method name.
pub struct MethodNameParts {
    pub receiver: []u8,
    pub method: []u8
}

/// Describes the structural callback Walk requires.
pub contract TypeVisitor {
    fn visit(value: &Node) -> void;
}

/// Describes the path rewrite MapNames requires.
pub contract NameMapper {
    fn rename_path(
        allocator: Allocator,
        path: &array::Array<string::String>
    ) -> !array::Array<string::String>;
}

/// Describes a post-order whole-name fold into a distinct type graph.
pub contract NameFolder {
    fn fold_name(builder: &var Builder, path: array::Array<string::String>, args: array::Array<arena::Handle<Node>>) -> !arena::Handle<Node>;
}

struct PlainNameTransform {}

// NoReplacements selects the plain static renderer instantiation.
struct NoReplacements {}

struct RenderedSubstitutions {
    values: map::Map<[]u8, string::String>
}

// parser reads one type spelling left to right while owning every node it has
// accepted so an error can release the partial tree in one visible cleanup.
struct Parser {
    allocator: Allocator,
    input: []u8,
    position: i64,
    nodes: arena::Arena<Node>
}

/// Owns one type graph until it is transferred into a phase Table.
pub struct Builder {
    allocator: Allocator,
    nodes: arena::Arena<Node>
}

struct Span {
    start: i64,
    end: i64
}

/// Creates an empty type table for one compiler phase.
pub fn new(allocator: Allocator) -> Table {
    return Table {
        allocator: allocator,
        trees: arena::new<TypeTree>(allocator),
        parsed: map::new<[]u8, Type>(allocator)
    };
}

/// Creates an empty graph builder for one parsed or transformed type.
pub fn new_builder(allocator: Allocator) -> Builder {
    return Builder {
        allocator: allocator,
        nodes: arena::new<Node>(allocator)
    };
}

/// Retains one node and returns its identity inside this graph.
fn (self: &var Builder) add(node: Node) -> arena::Handle<Node> {
    return self.nodes.add(move node);
}

fn copy_path(allocator: Allocator, source: &array::Array<string::String>) -> !array::Array<string::String> {
    var path = array::new<string::String>(allocator);
    errdefer path.deinit();
    var index = 0;
    while source.at(index) |part| {
        let bytes = part.as_bytes();
        let copied = try owned_text(allocator, bytes);
        errdefer copied.deinit();
        try path.append(move copied);
        index = index + 1;
    }
    return move path;
}

// Borrows a node already retained in this in-progress graph.
fn (self: &Builder) at(handle: arena::Handle<Node>) -> &Node {
    return self.nodes.at(handle);
}

/// Transfers the completed graph into its phase table.
pub fn finish_builder(builder: Builder, table: &var Table, root: arena::Handle<Node>) -> Type {
    let tree = TypeTree { nodes: move builder.nodes, root: root };
    let tree_handle = table.trees.add(move tree);
    return Type { tree: tree_handle, root: root };
}

/// Returns the retained type for text, parsing its tree on first use.
fn (self: &var Table) parse(text: []u8) -> !Type {
    if self.parsed.get(text) |parsed| {
        return parsed;
    }
    let tree = try parse_tree(self.allocator, text);
    let root = tree.root;
    let tree_handle = self.trees.add(move tree);
    let value = Type {
        tree: tree_handle, root: root
    };
    try self.parsed.insert(text, value);
    return value;
}

// parse_tree parses one canonical spelling into an independent owned tree.
fn parse_tree(allocator: Allocator, text: []u8) -> !TypeTree {
    var parser = Parser {
        allocator: allocator,
        input: text,
        position: 0,
        nodes: arena::new<Node>(allocator)
    };
    errdefer parser.deinit();
    let root = try parser.parse_type();
    if parser.position != mem::len(text) {
        return Error::TrailingText;
    }
    return TypeTree {
        nodes: move parser.nodes,
        root: root
    };
}

// parse_type reads a type, including the `E!T` spelling whose error type sits
// to the left of the `!`.
fn (self: &var Parser) parse_type() -> !arena::Handle<Node> {
    let left = try self.parse_prefix();
    if !self.accept("!") {
        return left;
    }
    let ok = try self.parse_prefix();
    return self.nodes.add(Node::ErrorUnion(ErrorUnion {
        err: left,
        ok: ok
    }));
}

// parse_prefix reads the spellings that wrap a type from the left.
fn (self: &var Parser) parse_prefix() -> !arena::Handle<Node> {
    if self.accept("!") {
        let elem = try self.parse_prefix();
        return self.nodes.add(Node::ErrorUnion(ErrorUnion {
            err: null,
            ok: elem
        }));
    }
    if self.peek(cast<u8>(91)) {
        return self.parse_bracketed();
    }
    if self.accept("&var ") {
        let elem = try self.parse_prefix();
        return self.nodes.add(Node::Borrow(Borrow {
            elem: elem,
            mutable: true
        }));
    }
    if self.accept("&") {
        let elem = try self.parse_prefix();
        return self.nodes.add(Node::Borrow(Borrow {
            elem: elem,
            mutable: false
        }));
    }
    if self.accept("?") {
        let elem = try self.parse_prefix();
        return self.nodes.add(Node::Optional(Optional { elem: elem }));
    }
    if self.accept("const ") {
        let elem = try self.parse_prefix();
        return self.nodes.add(Node::Const(Const { elem: elem }));
    }
    return self.parse_name();
}

// parse_bracketed reads the `[]T` and `[N]T` spellings.
fn (self: &var Parser) parse_bracketed() -> !arena::Handle<Node> {
    if self.accept("[]") {
        let elem = try self.parse_prefix();
        return self.nodes.add(Node::Slice(Slice { elem: elem }));
    }
    self.position = self.position + 1;
    let start = self.position;
    var size = 0;
    while self.position < mem::len(self.input) and
        is_digit(self.input[self.position]) {
        let digit = cast<i64>(self.input[self.position] - cast<u8>(48));
        if size > (9223372036854775807 - digit) / 10 {
            return Error::BufferSizeOverflow;
        }
        size = size * 10 + digit;
        self.position = self.position + 1;
    }
    if start == self.position {
        return Error::ExpectedBufferSize;
    }
    if !self.accept("]") {
        return Error::ExpectedBufferClose;
    }
    let elem = try self.parse_prefix();
    return self.nodes.add(Node::Buffer(Buffer {
        size: size,
        elem: elem
    }));
}

// parse_name reads a `::` separated name and its static arguments.
fn (self: &var Parser) parse_name() -> !arena::Handle<Node> {
    var path = array::new<string::String>(self.allocator);
    errdefer path.deinit();
    while true {
        let span = self.parse_ident();
        if span.start == span.end {
            return Error::ExpectedName;
        }
        try path.append(try owned_text(
            self.allocator,
            self.input[span.start..span.end]
        ));
        if !self.accept("::") {
            break;
        }
    }
    var args = array::new<arena::Handle<Node>>(self.allocator);
    errdefer args.deinit();
    if self.accept("<") {
        while true {
            try args.append(try self.parse_type());
            if self.accept(",") {
                let _ = self.accept(" ");
            } else {
                break;
            }
        }
        if !self.accept(">") {
            return Error::UnclosedArguments;
        }
    }
    return self.nodes.add(Node::Name(Name {
        path: move path,
        args: move args
    }));
}

fn (self: &var Parser) parse_ident() -> Span {
    let start = self.position;
    while self.position < mem::len(self.input) and
        is_word(self.input[self.position]) {
        self.position = self.position + 1;
    }
    return Span { start: start, end: self.position };
}

fn (self: &Parser) peek(want: u8) -> bool {
    return self.position < mem::len(self.input) and self.input[self.position] == want;
}

fn (self: &var Parser) accept(text: []u8) -> bool {
    if !starts_with_at(self.input, self.position, text) {
        return false;
    }
    self.position = self.position + mem::len(text);
    return true;
}

fn starts_with_at(bytes: []u8, at: i64, prefix: []u8) -> bool {
    if at < 0 or at + mem::len(prefix) > mem::len(bytes) {
        return false;
    }
    var index = 0;
    while index < mem::len(prefix) {
        if bytes[at + index] != prefix[index] {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn is_word(byte: u8) -> bool {
    return byte == cast<u8>(95) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        (byte >= cast<u8>(65) and byte <= cast<u8>(90)) or
        is_digit(byte);
}

fn is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}

fn owned_text(allocator: Allocator, bytes: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes(bytes);
    return move out;
}

/// Splits a static argument list at top-level commas.
pub fn split_args(
    allocator: Allocator,
    text: []u8
) -> !array::Array<string::String> {
    var parts = array::new<string::String>(allocator);
    errdefer parts.deinit();
    if try split_args_into(allocator, text, &var parts) |reason| {
        return reason;
    }
    return move parts;
}

/// Splits a valid static argument list, or returns null for malformed text.
pub fn split_args_optional(
    allocator: Allocator,
    text: []u8
) -> !?array::Array<string::String> {
    var parts = array::new<string::String>(allocator);
    errdefer parts.deinit();
    if try split_args_into(allocator, text, &var parts) |_| {
        parts.deinit();
        return null;
    }
    return move parts;
}

// Returns a parse reason as data while allocation failures stay errors.
fn split_args_into(
    allocator: Allocator,
    text: []u8,
    parts: &var array::Array<string::String>
) -> !?Error {
    var depth = 0;
    var start = 0;
    var index = 0;
    var has_empty = false;
    while index < mem::len(text) {
        let byte = text[index];
        if byte == cast<u8>(60) {
            depth = depth + 1;
        } else {
            if byte == cast<u8>(62) {
                depth = depth - 1;
                if depth < 0 {
                    return Error::UnbalancedArgumentClose;
                }
            } else {
                if byte == cast<u8>(44) and depth == 0 {
                    let part = mem::trim_ascii(text[start..index]);
                    if mem::len(part) == 0 {
                        has_empty = true;
                    }
                    try parts.append(try owned_text(allocator, part));
                    start = index + 1;
                }
            }
        }
        index = index + 1;
    }
    if depth != 0 {
        return Error::UnbalancedArgumentOpen;
    }
    // Parser-produced static spellings contain only canonical ASCII spacing;
    // source Unicode whitespace was already consumed by the lexer.
    let final_part = mem::trim_ascii(text[start..mem::len(text)]);
    if mem::len(final_part) == 0 {
        has_empty = true;
    }
    try parts.append(try owned_text(allocator, final_part));
    if has_empty {
        return Error::EmptyStaticArgument;
    }
    return null;
}

/// Returns T for the optional value spelling `?T`.
pub fn optional_elem(text: []u8) -> ?[]u8 {
    if !mem::starts_with(text, "?") or mem::starts_with(text, "?ptr<") {
        return null;
    }
    return text[1..mem::len(text)];
}

/// Splits `?&T` or `?&var T` into its payload and mutability.
pub fn borrow_optional_elem(text: []u8) -> ?BorrowOptionalParts {
    if mem::starts_with(text, "?&var ") {
        return BorrowOptionalParts {
            elem: text[6..mem::len(text)],
            mutable: true
        };
    }
    if mem::starts_with(text, "?&") {
        return BorrowOptionalParts {
            elem: text[2..mem::len(text)],
            mutable: false
        };
    }
    return null;
}

/// Splits `Base<Args>` without interpreting Base or Args.
pub fn split_apply(name: []u8) -> ?ApplyParts {
    var open = 0;
    while open < mem::len(name) and name[open] != cast<u8>(60) {
        open = open + 1;
    }
    let end = mem::len(name);
    if open < 1 or open == end or name[end - 1] != cast<u8>(62) or
        open + 1 == end - 1 {
        return null;
    }
    return ApplyParts {
        base: name[0..open],
        args: name[open + 1..end - 1]
    };
}

/// Splits a receiver-qualified method name at its last dot.
pub fn split_method_name(name: []u8) -> ?MethodNameParts {
    var index = mem::len(name);
    while index > 0 {
        index = index - 1;
        if name[index] == cast<u8>(46) {
            return MethodNameParts {
                receiver: name[0..index],
                method: name[index + 1..mem::len(name)]
            };
        }
    }
    return null;
}

/// Returns the method name that discharges an owner's consume obligation.
pub fn cleanup_method() -> []u8 {
    return "deinit";
}

/// Renders one retained type back to its canonical spelling.
pub fn render(
    allocator: Allocator,
    table: &Table,
    value: Type
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try append_render(&var out, table, value);
    return move out;
}

/// Appends one retained type's canonical spelling to caller-owned storage.
pub fn append_render(
    out: &var string::String,
    table: &Table,
    value: Type
) -> !void {
    return append_tree_node(
        out,
        table.trees.at(value.tree),
        value.root
    );
}

/// Borrows the root node represented by value from its table.
pub fn root_node(table: &Table, value: Type) -> &Node {
    let tree = table.trees.at(value.tree);
    return tree.nodes.at(value.root);
}

/// Converts one child edge into a Type handle in its parent's tree.
pub fn child_type(
    parent: Type,
    child: arena::Handle<Node>
) -> Type {
    return Type { tree: parent.tree, root: child };
}

fn append_tree_node(
    out: &var string::String,
    tree: &TypeTree,
    root: arena::Handle<Node>
) -> !void {
    let lookup = NoReplacements {};
    return append_tree_node_with<NoReplacements>(
        out, tree, root, &lookup
    );
}

fn append_tree_node_with<R>(
    out: &var string::String,
    tree: &TypeTree,
    root: arena::Handle<Node>,
    lookup: &R
) -> !void {
    match tree.nodes.at(root) {
        Name(node) => try append_name_with<R>(out, tree, node, lookup),
        Slice(node) => {
            try out.append_bytes("[]");
            try append_tree_node_with<R>(out, tree, node.elem, lookup);
        },
        Buffer(node) => {
            try out.append_byte(cast<u8>(91));
            try fmt::append_i64(out, node.size);
            try out.append_byte(cast<u8>(93));
            try append_tree_node_with<R>(out, tree, node.elem, lookup);
        },
        Borrow(node) => {
            if node.mutable {
                try out.append_bytes("&var ");
            } else {
                try out.append_byte(cast<u8>(38));
            }
            try append_tree_node_with<R>(out, tree, node.elem, lookup);
        },
        Optional(node) => {
            try out.append_byte(cast<u8>(63));
            try append_tree_node_with<R>(out, tree, node.elem, lookup);
        },
        Const(node) => {
            try out.append_bytes("const ");
            try append_tree_node_with<R>(out, tree, node.elem, lookup);
        },
        ErrorUnion(node) => {
            if node.err |err| {
                try append_tree_node_with<R>(out, tree, err, lookup);
            }
            try out.append_byte(cast<u8>(33));
            try append_tree_node_with<R>(out, tree, node.ok, lookup);
        },
    }
    return;
}

fn append_name_with<R>(
    out: &var string::String,
    tree: &TypeTree,
    node: &Name,
    lookup: &R
) -> !void {
    comptime if R == type<NoReplacements> {} else {
        if node.path.len() == 1 and node.args.len() == 0 {
            if node.path.at(0) |part| {
                let bytes = part.as_bytes();
                if try lookup.append_replacement(out, bytes) {
                    return;
                }
            }
        }
    }
    try append_name_path(out, node);
    if node.args.len() == 0 {
        return;
    }
    try out.append_byte(cast<u8>(60));
    var index = 0;
    while node.args.get(index) |arg| {
        if index > 0 {
            try out.append_bytes(", ");
        }
        try append_tree_node_with<R>(out, tree, arg, lookup);
        index = index + 1;
    }
    try out.append_byte(cast<u8>(62));
    return;
}

fn (self: &RenderedSubstitutions) append_replacement(
    out: &var string::String,
    name: []u8
) -> !bool {
    if self.values.at(name) |replacement| {
        let bytes = replacement.as_bytes();
        try out.append_bytes(bytes);
        return true;
    }
    return false;
}

fn append_name_path(out: &var string::String, node: &Name) -> !void {
    var index = 0;
    while node.path.at(index) |part| {
        if index > 0 {
            try out.append_bytes("::");
        }
        let bytes = part.as_bytes();
        try out.append_bytes(bytes);
        index = index + 1;
    }
    return;
}

/// Reports whether two type trees have the same structure.
pub fn equal(
    left_table: &Table,
    left: Type,
    right_table: &Table,
    right: Type
) -> bool {
    return equal_node(
        left_table.trees.at(left.tree),
        left.root,
        right_table.trees.at(right.tree),
        right.root
    );
}

fn equal_node(
    left: &TypeTree,
    left_handle: arena::Handle<Node>,
    right: &TypeTree,
    right_handle: arena::Handle<Node>
) -> bool {
    return match left.nodes.at(left_handle) {
        Name(a) => match right.nodes.at(right_handle) {
            Name(b) => equal_name(left, a, right, b),
            _ => false,
        },
        Slice(a) => match right.nodes.at(right_handle) {
            Slice(b) => equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        Buffer(a) => match right.nodes.at(right_handle) {
            Buffer(b) => a.size == b.size and equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        Borrow(a) => match right.nodes.at(right_handle) {
            Borrow(b) => a.mutable == b.mutable and
                equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        Optional(a) => match right.nodes.at(right_handle) {
            Optional(b) => equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        Const(a) => match right.nodes.at(right_handle) {
            Const(b) => equal_node(left, a.elem, right, b.elem),
            _ => false,
        },
        ErrorUnion(a) => match right.nodes.at(right_handle) {
            ErrorUnion(b) => equal_error_union(left, a, right, b),
            _ => false,
        },
    };
}

fn equal_name(
    left: &TypeTree,
    a: &Name,
    right: &TypeTree,
    b: &Name
) -> bool {
    if a.path.len() != b.path.len() or a.args.len() != b.args.len() {
        return false;
    }
    var index = 0;
    while a.path.at(index) |left_part| {
        if b.path.at(index) |right_part| {
            let left_bytes = left_part.as_bytes();
            let right_bytes = right_part.as_bytes();
            if !mem::equal_bytes(left_bytes, right_bytes) {
                return false;
            }
        } else {
            return false;
        }
        index = index + 1;
    }
    index = 0;
    while a.args.get(index) |left_arg| {
        if b.args.get(index) |right_arg| {
            if !equal_node(left, left_arg, right, right_arg) {
                return false;
            }
        } else {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn equal_error_union(
    left: &TypeTree,
    a: &ErrorUnion,
    right: &TypeTree,
    b: &ErrorUnion
) -> bool {
    if a.err |left_err| {
        if b.err |right_err| {
            if !equal_node(left, left_err, right, right_err) {
                return false;
            }
        } else {
            return false;
        }
    } else {
        if b.err |_| {
            return false;
        }
    }
    return equal_node(left, a.ok, right, b.ok);
}

/// Rewrites every name path while preserving the type structure around it.
pub fn map_names<M>(table: &var Table, value: Type, mapper: &var M) -> !Type {
    var folder = PlainNameTransform {};
    return transform_names<M, PlainNameTransform>(table, value, table, mapper, &var folder);
}

/// Folds whole names post-order from a borrowed graph into a distinct table.
pub fn fold_names_into<F>(source: &Table, value: Type, destination: &var Table, folder: &var F) -> !Type {
    var mapper = PlainNameTransform {};
    return transform_names<PlainNameTransform, F>(source, value, destination, &var mapper, folder);
}

fn (self: &var PlainNameTransform) rename_path(allocator: Allocator, path: &array::Array<string::String>) -> !array::Array<string::String> {
    return copy_path(allocator, path);
}

fn (self: &var PlainNameTransform) fold_name(builder: &var Builder, path: array::Array<string::String>, args: array::Array<arena::Handle<Node>>) -> !arena::Handle<Node> {
    return builder.add(Node::Name(Name { path: move path, args: move args }));
}

fn transform_names<M, F>(source: &Table, value: Type, destination: &var Table, mapper: &var M, folder: &var F) -> !Type {
    var builder = new_builder(destination.allocator);
    errdefer builder.deinit();
    let root = try map_names_node<M, F>(&var builder, source.trees.at(value.tree), value.root, mapper, folder);
    return finish_builder(move builder, destination, root);
}

fn map_names_node<M, F>(builder: &var Builder, value: &TypeTree, handle: arena::Handle<Node>, mapper: &var M, folder: &var F) -> !arena::Handle<Node> {
    return match value.nodes.at(handle) {
        Name(node) => try map_name_node<M, F>(builder, value, node, mapper, folder),
        Slice(node) => {
            let elem = try map_names_node<M, F>(builder, value, node.elem, mapper, folder);
            builder.nodes.add(Node::Slice(Slice { elem: elem }))
        },
        Buffer(node) => {
            let elem = try map_names_node<M, F>(builder, value, node.elem, mapper, folder);
            builder.nodes.add(Node::Buffer(Buffer { size: node.size, elem: elem }))
        },
        Borrow(node) => {
            let elem = try map_names_node<M, F>(builder, value, node.elem, mapper, folder);
            builder.nodes.add(Node::Borrow(Borrow {
                elem: elem,
                mutable: node.mutable
            }))
        },
        Optional(node) => {
            let elem = try map_names_node<M, F>(builder, value, node.elem, mapper, folder);
            builder.nodes.add(Node::Optional(Optional { elem: elem }))
        },
        Const(node) => {
            let elem = try map_names_node<M, F>(builder, value, node.elem, mapper, folder);
            builder.nodes.add(Node::Const(Const { elem: elem }))
        },
        ErrorUnion(node) => try map_error_union_names<M, F>(builder, value, node, mapper, folder),
    };
}

fn map_name_node<M, F>(builder: &var Builder, value: &TypeTree, node: &Name, mapper: &var M, folder: &var F) -> !arena::Handle<Node> {
    var path = try mapper.rename_path(builder.allocator, &node.path);
    errdefer path.deinit();
    let allocator = builder.allocator;
    var args = array::new<arena::Handle<Node>>(allocator);
    errdefer args.deinit();
    var index = 0;
    while node.args.get(index) |arg| {
        try args.append(try map_names_node<M, F>(builder, value, arg, mapper, folder));
        index = index + 1;
    }
    return folder.fold_name(builder, move path, move args);
}

// map_error_union_names keeps Go's callback order: success before error.
fn map_error_union_names<M, F>(builder: &var Builder, value: &TypeTree, node: &ErrorUnion, mapper: &var M, folder: &var F) -> !arena::Handle<Node> {
    let ok = try map_names_node<M, F>(builder, value, node.ok, mapper, folder);
    if node.err |source_err| {
        let err = try map_names_node<M, F>(builder, value, source_err, mapper, folder);
        return builder.nodes.add(Node::ErrorUnion(ErrorUnion { err: err, ok: ok }));
    }
    return builder.nodes.add(Node::ErrorUnion(ErrorUnion { err: null, ok: ok }));
}

/// Replaces whole-name type parameters and retains the resulting graph.
pub fn substitute(
    table: &var Table,
    value: Type,
    substitutions: &map::Map<[]u8, Type>
) -> !Type {
    if substitutions.len() == 0 {
        return value;
    }
    var builder = new_builder(table.allocator);
    errdefer builder.deinit();
    let root = try substitute_node(
        &var builder,
        table,
        table.trees.at(value.tree),
        value.root,
        substitutions,
        true
    );
    return finish_builder(move builder, table, root);
}

/// Retains one parsed type wrapped in an explicit borrow node.
pub fn wrap_borrow(
    table: &var Table,
    value: Type,
    mutable: bool
) -> !Type {
    var substitutions = map::new<[]u8, Type>(table.allocator);
    defer substitutions.deinit();
    var builder = new_builder(table.allocator);
    errdefer builder.deinit();
    let elem = try substitute_node(
        &var builder,
        table,
        table.trees.at(value.tree),
        value.root,
        &substitutions,
        false
    );
    let root = builder.nodes.add(Node::Borrow(Borrow {
        elem: elem,
        mutable: mutable
    }));
    return finish_builder(move builder, table, root);
}

fn substitute_node(
    builder: &var Builder,
    table: &Table,
    tree: &TypeTree,
    handle: arena::Handle<Node>,
    substitutions: &map::Map<[]u8, Type>,
    replace_names: bool
) -> !arena::Handle<Node> {
    return match tree.nodes.at(handle) {
        Name(node) => try substitute_name(
            builder,
            table,
            tree,
            node,
            substitutions,
            replace_names
        ),
        Slice(node) => {
            let elem = try substitute_node(
                builder, table, tree, node.elem, substitutions, replace_names
            );
            builder.nodes.add(Node::Slice(Slice { elem: elem }))
        },
        Buffer(node) => {
            let elem = try substitute_node(
                builder, table, tree, node.elem, substitutions, replace_names
            );
            builder.nodes.add(Node::Buffer(Buffer { size: node.size, elem: elem }))
        },
        Borrow(node) => {
            let elem = try substitute_node(
                builder, table, tree, node.elem, substitutions, replace_names
            );
            builder.nodes.add(Node::Borrow(Borrow {
                elem: elem,
                mutable: node.mutable
            }))
        },
        Optional(node) => {
            let elem = try substitute_node(
                builder, table, tree, node.elem, substitutions, replace_names
            );
            builder.nodes.add(Node::Optional(Optional { elem: elem }))
        },
        Const(node) => {
            let elem = try substitute_node(
                builder, table, tree, node.elem, substitutions, replace_names
            );
            builder.nodes.add(Node::Const(Const { elem: elem }))
        },
        ErrorUnion(node) => try substitute_error_union(
            builder,
            table,
            tree,
            node,
            substitutions,
            replace_names
        ),
    };
}

fn substitute_name(
    builder: &var Builder,
    table: &Table,
    tree: &TypeTree,
    node: &Name,
    substitutions: &map::Map<[]u8, Type>,
    replace_names: bool
) -> !arena::Handle<Node> {
    if replace_names and node.path.len() == 1 and node.args.len() == 0 {
        if node.path.at(0) |part| {
            let name = part.as_bytes();
            if substitutions.get(name) |replacement| {
                return substitute_node(
                    builder,
                    table,
                    table.trees.at(replacement.tree),
                    replacement.root,
                    substitutions,
                    false
                );
            }
        }
    }
    var args = array::new<arena::Handle<Node>>(builder.allocator);
    errdefer args.deinit();
    var index = 0;
    while node.args.get(index) |arg| {
        try args.append(try substitute_node(
            builder,
            table,
            tree,
            arg,
            substitutions,
            replace_names
        ));
        index = index + 1;
    }
    let path = try copy_path(builder.allocator, &node.path);
    return builder.add(Node::Name(Name { path: move path, args: move args }));
}

// substitute_error_union keeps Go's traversal order: success before error.
fn substitute_error_union(
    builder: &var Builder,
    table: &Table,
    tree: &TypeTree,
    node: &ErrorUnion,
    substitutions: &map::Map<[]u8, Type>,
    replace_names: bool
) -> !arena::Handle<Node> {
    let ok = try substitute_node(
        builder, table, tree, node.ok, substitutions, replace_names
    );
    if node.err |source_err| {
        let err = try substitute_node(
            builder, table, tree, source_err, substitutions, replace_names
        );
        return builder.nodes.add(Node::ErrorUnion(ErrorUnion { err: err, ok: ok }));
    }
    return builder.nodes.add(Node::ErrorUnion(ErrorUnion { err: null, ok: ok }));
}

/// Replaces type parameters in a spelling and renders the owned result.
pub fn substitute_text(
    allocator: Allocator,
    text: []u8,
    substitutions: &map::Map<[]u8, []u8>
) -> !string::String {
    if substitutions.len() == 0 {
        return owned_text(allocator, text);
    }
    var table = new(allocator);
    defer table.deinit();
    let parsed = try table.parse(text);
    var rendered_substitutions = RenderedSubstitutions {
        values: map::new<[]u8, string::String>(allocator)
    };
    defer rendered_substitutions.deinit();
    var index = 0;
    while substitutions.key_at(index) |name| {
        if substitutions.get(name) |replacement| {
            try put_rendered_substitution(allocator, &var table, &var rendered_substitutions.values, name, replacement);
        }
        index = index + 1;
    }
    return render_substituted(
        allocator,
        &table,
        parsed,
        &rendered_substitutions
    );
}

/// Replaces type parameters supplied as parallel owned text arrays.
pub fn substitute_owned_text(
    allocator: Allocator,
    text: []u8,
    names: &array::Array<string::String>,
    replacements: &array::Array<string::String>
) -> !string::String {
    if names.len() == 0 or names.len() != replacements.len() {
        return owned_text(allocator, text);
    }
    var table = new(allocator);
    defer table.deinit();
    let parsed = try table.parse(text);
    var rendered_substitutions = RenderedSubstitutions {
        values: map::new<[]u8, string::String>(allocator)
    };
    defer rendered_substitutions.deinit();
    var index = 0;
    while names.at(index) |name| {
        if replacements.at(index) |replacement| {
            let name_bytes = name.as_bytes();
            let replacement_bytes = replacement.as_bytes();
            try put_rendered_substitution(allocator, &var table, &var rendered_substitutions.values, name_bytes, replacement_bytes);
        }
        index = index + 1;
    }
    return render_substituted(
        allocator,
        &table,
        parsed,
        &rendered_substitutions
    );
}

fn put_rendered_substitution(allocator: Allocator, table: &var Table, values: &var map::Map<[]u8, string::String>, name: []u8, replacement: []u8) -> !void {
    let replacement_type = try table.parse(replacement);
    if values.at_mut(name) |existing| {
        existing.clear();
        return append_render(existing, table, replacement_type);
    }
    let replacement_text = try render(allocator, table, replacement_type);
    return values.insert(name, move replacement_text);
}

fn render_substituted(
    allocator: Allocator,
    table: &Table,
    parsed: Type,
    substitutions: &RenderedSubstitutions
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try append_tree_node_with<RenderedSubstitutions>(
        &var out,
        table.trees.at(parsed.tree),
        parsed.root,
        substitutions
    );
    return move out;
}

/// Calls visitor for value and every nested type, outermost first.
pub fn walk<V>(table: &Table, value: Type, visitor: &var V) -> void {
    walk_node<V>(table.trees.at(value.tree), value.root, visitor);
}

fn walk_node<V>(
    value: &TypeTree,
    handle: arena::Handle<Node>,
    visitor: &var V
) -> void {
    visitor.visit(value.nodes.at(handle));
    match value.nodes.at(handle) {
        Name(node) => {
            var index = 0;
            while node.args.get(index) |arg| {
                walk_node<V>(value, arg, visitor);
                index = index + 1;
            }
        },
        Slice(node) => walk_node<V>(value, node.elem, visitor),
        Buffer(node) => walk_node<V>(value, node.elem, visitor),
        Borrow(node) => walk_node<V>(value, node.elem, visitor),
        Optional(node) => walk_node<V>(value, node.elem, visitor),
        Const(node) => walk_node<V>(value, node.elem, visitor),
        ErrorUnion(node) => {
            if node.err |err| {
                walk_node<V>(value, err, visitor);
            }
            walk_node<V>(value, node.ok, visitor);
        },
    }
    return;
}
