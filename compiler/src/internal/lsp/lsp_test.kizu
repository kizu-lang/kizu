import std::mem;
import std::string;
import std::testing;

test "utf16_column converts scalar columns to UTF-16 code units" {
    let text =
        \\ascii
        \\let s = "é"; x
        \\let n = "日本"; x
        \\let e = "😀"; x
        \\let m = "日本😀"; x
        \\
    ;
    testing::expect_equal<i64>(0, utf16_column(text, 0, 0));
    testing::expect_equal<i64>(3, utf16_column(text, 0, 3));
    testing::expect_equal<i64>(0, utf16_column(text, 0 - 1, 3));
    testing::expect_equal<i64>(0, utf16_column(text, 0, 0 - 1));
    testing::expect_equal<i64>(13, utf16_column(text, 1, 13));
    testing::expect_equal<i64>(14, utf16_column(text, 2, 14));
    testing::expect_equal<i64>(14, utf16_column(text, 3, 13));
    testing::expect_equal<i64>(16, utf16_column(text, 4, 15));
}

test "uri_of_path and path_of_uri roundtrip paths with spaces" {
    let allocator = mem::page_allocator();
    var uri = string::new(allocator);
    defer uri.deinit(allocator);
    comptime if std::target::is_windows() {
        var sample = try string::from_bytes(allocator, "C:");
        defer sample.deinit(allocator);
        try sample.append_byte(allocator, cast<u8>(92));
        try sample.append_bytes(allocator, "my work");
        try sample.append_byte(allocator, cast<u8>(92));
        try sample.append_bytes(allocator, "main.kizu");
        let sample_bytes = sample.as_bytes();
        try uri_of_path(allocator, sample_bytes, &var uri);
        let uri_bytes = uri.as_bytes();
        testing::expect_equal<[]u8>("file:///C%3A/my%20work/main.kizu", uri_bytes);
        var decoded = string::new(allocator);
        defer decoded.deinit(allocator);
        testing::expect(try path_of_uri(allocator, uri_bytes, &var decoded));
        let decoded_bytes = decoded.as_bytes();
        testing::expect_equal<[]u8>(sample_bytes, decoded_bytes);
    } else {
        try uri_of_path(allocator, "/tmp/my work/main.kizu", &var uri);
        let uri_bytes = uri.as_bytes();
        testing::expect_equal<[]u8>("file:///tmp/my%20work/main.kizu", uri_bytes);
        var decoded = string::new(allocator);
        defer decoded.deinit(allocator);
        testing::expect(try path_of_uri(allocator, uri_bytes, &var decoded));
        let decoded_bytes = decoded.as_bytes();
        testing::expect_equal<[]u8>("/tmp/my work/main.kizu", decoded_bytes);
    }
    var rejected = string::new(allocator);
    defer rejected.deinit(allocator);
    testing::expect(!try path_of_uri(allocator, "https://example.com/a.kizu", &var rejected));
}

test "take_message reads framed JSON-RPC messages incrementally" {
    let allocator = mem::page_allocator();
    var pending = string::new(allocator);
    defer pending.deinit(allocator);
    try pending.append_bytes(allocator, "Content-Type: text/plain");
    try pending.append_byte(allocator, cast<u8>(13));
    try pending.append_byte(allocator, cast<u8>(10));
    try pending.append_bytes(allocator, "content-length: 5");
    for 0..2 |_line| {
        try pending.append_byte(allocator, cast<u8>(13));
        try pending.append_byte(allocator, cast<u8>(10));
    }
    try pending.append_bytes(allocator, "helloContent-Length: 5");
    for 0..2 |_line| {
        try pending.append_byte(allocator, cast<u8>(13));
        try pending.append_byte(allocator, cast<u8>(10));
    }
    try pending.append_bytes(allocator, "wor");

    var first = string::new(allocator);
    defer first.deinit(allocator);
    testing::expect(try take_message(allocator, &var pending, &var first));
    let first_bytes = first.as_bytes();
    testing::expect_equal<[]u8>("hello", first_bytes);

    var second = string::new(allocator);
    defer second.deinit(allocator);
    testing::expect(!try take_message(allocator, &var pending, &var second));

    try pending.append_bytes(allocator, "ld");
    testing::expect(try take_message(allocator, &var pending, &var second));
    let second_bytes = second.as_bytes();
    testing::expect_equal<[]u8>("world", second_bytes);
    testing::expect_equal<i64>(0, pending.len());
}
