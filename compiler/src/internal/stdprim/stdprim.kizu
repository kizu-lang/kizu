import std::array;
import std::mem;
import std::string;

pub enum ArgKind {
    Bytes,
    View,
    I64,
    Io,
    StringOut,
    Allocator,
    CoroEntry,
    U64,
    F64,
    U32,
    F32,
    U16,
    F32x4,
    F64x2,
    I32x4,
    I8x16,
    U8x16,
    SliceF32,
    SliceF64,
    SliceI32,
    SliceI8,
    MutSliceF32,
    MutSliceF64,
    MutSliceI32,
    MutSliceU8,
    MutSliceI8,
    Bool,
    SliceU16,
    SimdMatrix8x8F32,
    SimdMatrix8x8F16,
}

pub fn arg_kind_spelling(kind: ArgKind) -> []u8 {
    return match kind {
        Bytes => "[]u8",
        View => "[]T",
        U16 => "u16",
        I64 => "i64",
        Io => "Io",
        StringOut => "&var std::string::String",
        Allocator => "Allocator",
        CoroEntry => "fn(i64) -> void",
        U64 => "u64",
        F64 => "f64",
        U32 => "u32",
        F32 => "f32",
        F32x4 => "f32x4",
        F64x2 => "f64x2",
        I32x4 => "i32x4",
        I8x16 => "i8x16",
        U8x16 => "u8x16",
        SliceF32 => "[]f32",
        SliceF64 => "[]f64",
        SliceI32 => "[]i32",
        SliceI8 => "[]i8",
        MutSliceF32 => "&var []f32",
        MutSliceF64 => "&var []f64",
        MutSliceI32 => "&var []i32",
        MutSliceU8 => "&var []u8",
        MutSliceI8 => "&var []i8",
        Bool => "bool",
        SliceU16 => "[]u16",
        SimdMatrix8x8F32 => "std::gpu::SimdMatrix8x8F32",
        SimdMatrix8x8F16 => "std::gpu::SimdMatrix8x8F16",
    };
}

enum CoreArgs {
    NoArgs,
    Bytes,
    BytesBytes,
    View,
    I64,
    U64,
    F64,
    F64F64F64,
    U32,
    F32,
    F32F32F32,
    U16,
    F32I64,
    F32x4,
    F32x4F32x4F32x4,
    F64x2F64x2F64x2,
    I32x4,
    I32x4I8x16I8x16,
    I8x16,
    U8x16,
    U8x16U8x16,
    SliceF32I64,
    SliceF64I64,
    SliceI32I64,
    BytesI64,
    SliceI8I64,
    MutSliceF32I64F32x4,
    MutSliceF64I64F64x2,
    MutSliceI32I64I32x4,
    MutSliceU8I64U8x16,
    MutSliceI8I64I8x16,
    Allocator,
    I64Allocator,
    IoBytes,
    IoAllocBytesStringOut,
    IoAllocBytesStringOutI64,
    IoAllocStringOutI64,
    SpawnWait8,
    SpawnOutput8,
    AllocStringOut,
    IoBytesI64,
    IoBytesI64I64,
    IoBytesI64BytesBytes,
    IoI64,
    I64I64,
    IoI64I64,
    IoI64I64I64I64,
    IoI64Bytes,
    IoI64BytesI64,
    IoAllocI64StringOutI64I64,
    CoroEntryI64I64,
    Io,
    AllocatorI64I64,
    SliceU16I64I64Bool,
    SimdMatrixF32F16F16,
    SimdMatrixF32MutSliceF32I64I64,
}

pub struct CoreSignature {
    args: CoreArgs,
    pub return_type: []u8,
}

pub fn (self: &CoreSignature) args_len() -> i64 {
    return match self.args {
        NoArgs => 0,
        Bytes => 1,
        BytesBytes => 2,
        View => 1,
        I64 => 1,
        Allocator => 1,
        I64Allocator => 2,
        IoBytes => 2,
        IoAllocBytesStringOut => 4,
        IoAllocBytesStringOutI64 => 5,
        IoAllocStringOutI64 => 4,
        SpawnWait8 => 9,
        SpawnOutput8 => 11,
        AllocStringOut => 2,
        IoBytesI64 => 3,
        IoBytesI64I64 => 4,
        IoBytesI64BytesBytes => 5,
        IoI64 => 2,
        I64I64 => 2,
        IoI64I64 => 3,
        IoI64I64I64I64 => 5,
        IoI64Bytes => 3,
        IoI64BytesI64 => 4,
        IoAllocI64StringOutI64I64 => 6,
        CoroEntryI64I64 => 3,
        Io => 1,
        AllocatorI64I64 => 3,
        U64 => 1,
        F64 => 1,
        F64F64F64 => 3,
        U32 => 1,
        F32 => 1,
        F32F32F32 => 3,
        U16 => 1,
        F32I64 => 2,
        F32x4 => 1,
        F32x4F32x4F32x4 => 3,
        F64x2F64x2F64x2 => 3,
        I32x4 => 1,
        I32x4I8x16I8x16 => 3,
        I8x16 => 1,
        U8x16 => 1,
        U8x16U8x16 => 2,
        SliceF32I64 => 2,
        SliceF64I64 => 2,
        SliceI32I64 => 2,
        BytesI64 => 2,
        SliceI8I64 => 2,
        MutSliceF32I64F32x4 => 3,
        MutSliceF64I64F64x2 => 3,
        MutSliceI32I64I32x4 => 3,
        MutSliceU8I64U8x16 => 3,
        MutSliceI8I64I8x16 => 3,
        SliceU16I64I64Bool => 4,
        SimdMatrixF32F16F16 => 3,
        SimdMatrixF32MutSliceF32I64I64 => 4,
    };
}

pub fn (self: &CoreSignature) arg_at(index: i64) -> ?ArgKind {
    if index < 0 {
        return null;
    }
    if self.args == CoreArgs::Bytes {
        if index == 0 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::BytesBytes {
        if index == 0 or index == 1 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::View {
        if index == 0 {
            return ArgKind::View;
        }
        return null;
    }
    if self.args == CoreArgs::I64 {
        if index == 0 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::U64 {
        if index == 0 {
            return ArgKind::U64;
        }
        return null;
    }
    if self.args == CoreArgs::F64 {
        if index == 0 {
            return ArgKind::F64;
        }
        return null;
    }
    if self.args == CoreArgs::U32 {
        if index == 0 {
            return ArgKind::U32;
        }
        return null;
    }
    if self.args == CoreArgs::F32 {
        if index == 0 {
            return ArgKind::F32;
        }
        return null;
    }
    if self.args == CoreArgs::F32F32F32 {
        if index >= 0 and index <= 2 {
            return ArgKind::F32;
        }
        return null;
    }
    if self.args == CoreArgs::U16 {
        if index == 0 {
            return ArgKind::U16;
        }
        return null;
    }
    if self.args == CoreArgs::F32I64 {
        if index == 0 {
            return ArgKind::F32;
        }
        if index == 1 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::F64F64F64 {
        if index >= 0 and index <= 2 {
            return ArgKind::F64;
        }
        return null;
    }
    if self.args == CoreArgs::F32x4 {
        if index == 0 {
            return ArgKind::F32x4;
        }
        return null;
    }
    if self.args == CoreArgs::F32x4F32x4F32x4 {
        if index >= 0 and index <= 2 {
            return ArgKind::F32x4;
        }
        return null;
    }
    if self.args == CoreArgs::F64x2F64x2F64x2 {
        if index >= 0 and index <= 2 {
            return ArgKind::F64x2;
        }
        return null;
    }
    if self.args == CoreArgs::I32x4 {
        if index == 0 {
            return ArgKind::I32x4;
        }
        return null;
    }
    if self.args == CoreArgs::I32x4I8x16I8x16 {
        if index == 0 {
            return ArgKind::I32x4;
        }
        if index == 1 or index == 2 {
            return ArgKind::I8x16;
        }
        return null;
    }
    if self.args == CoreArgs::I8x16 {
        if index == 0 {
            return ArgKind::I8x16;
        }
        return null;
    }
    if self.args == CoreArgs::U8x16 {
        if index == 0 {
            return ArgKind::U8x16;
        }
        return null;
    }
    if self.args == CoreArgs::U8x16U8x16 {
        if index == 0 or index == 1 {
            return ArgKind::U8x16;
        }
        return null;
    }
    if self.args == CoreArgs::SliceF32I64 {
        if index == 0 { return ArgKind::SliceF32; }
        if index == 1 { return ArgKind::I64; }
        return null;
    }
    if self.args == CoreArgs::SliceF64I64 {
        if index == 0 { return ArgKind::SliceF64; }
        if index == 1 { return ArgKind::I64; }
        return null;
    }
    if self.args == CoreArgs::SliceI32I64 {
        if index == 0 { return ArgKind::SliceI32; }
        if index == 1 { return ArgKind::I64; }
        return null;
    }
    if self.args == CoreArgs::BytesI64 {
        if index == 0 { return ArgKind::Bytes; }
        if index == 1 { return ArgKind::I64; }
        return null;
    }
    if self.args == CoreArgs::SliceI8I64 {
        if index == 0 { return ArgKind::SliceI8; }
        if index == 1 { return ArgKind::I64; }
        return null;
    }
    if self.args == CoreArgs::MutSliceF32I64F32x4 {
        if index == 0 { return ArgKind::MutSliceF32; }
        if index == 1 { return ArgKind::I64; }
        if index == 2 { return ArgKind::F32x4; }
        return null;
    }
    if self.args == CoreArgs::MutSliceF64I64F64x2 {
        if index == 0 { return ArgKind::MutSliceF64; }
        if index == 1 { return ArgKind::I64; }
        if index == 2 { return ArgKind::F64x2; }
        return null;
    }
    if self.args == CoreArgs::MutSliceI32I64I32x4 {
        if index == 0 { return ArgKind::MutSliceI32; }
        if index == 1 { return ArgKind::I64; }
        if index == 2 { return ArgKind::I32x4; }
        return null;
    }
    if self.args == CoreArgs::MutSliceU8I64U8x16 {
        if index == 0 { return ArgKind::MutSliceU8; }
        if index == 1 { return ArgKind::I64; }
        if index == 2 { return ArgKind::U8x16; }
        return null;
    }
    if self.args == CoreArgs::MutSliceI8I64I8x16 {
        if index == 0 { return ArgKind::MutSliceI8; }
        if index == 1 { return ArgKind::I64; }
        if index == 2 { return ArgKind::I8x16; }
        return null;
    }
    if self.args == CoreArgs::SliceU16I64I64Bool {
        if index == 0 { return ArgKind::SliceU16; }
        if index == 1 or index == 2 { return ArgKind::I64; }
        if index == 3 { return ArgKind::Bool; }
        return null;
    }
    if self.args == CoreArgs::SimdMatrixF32F16F16 {
        if index == 0 { return ArgKind::SimdMatrix8x8F32; }
        if index == 1 or index == 2 { return ArgKind::SimdMatrix8x8F16; }
        return null;
    }
    if self.args == CoreArgs::SimdMatrixF32MutSliceF32I64I64 {
        if index == 0 { return ArgKind::SimdMatrix8x8F32; }
        if index == 1 { return ArgKind::MutSliceF32; }
        if index == 2 or index == 3 { return ArgKind::I64; }
        return null;
    }
    if self.args == CoreArgs::Allocator {
        if index == 0 {
            return ArgKind::Allocator;
        }
        return null;
    }
    if self.args == CoreArgs::I64Allocator {
        if index == 0 {
            return ArgKind::I64;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        return null;
    }
    if self.args == CoreArgs::Io {
        if index == 0 {
            return ArgKind::Io;
        }
        return null;
    }
    if self.args == CoreArgs::AllocatorI64I64 {
        if index == 0 {
            return ArgKind::Allocator;
        }
        if index == 1 or index == 2 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::CoroEntryI64I64 {
        if index == 0 {
            return ArgKind::CoroEntry;
        }
        if index == 1 {
            return ArgKind::I64;
        }
        if index == 2 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoBytes {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::IoAllocBytesStringOut {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        if index == 2 {
            return ArgKind::Bytes;
        }
        if index == 3 {
            return ArgKind::StringOut;
        }
        return null;
    }
    if self.args == CoreArgs::AllocStringOut {
        if index == 0 {
            return ArgKind::Allocator;
        }
        if index == 1 {
            return ArgKind::StringOut;
        }
        return null;
    }
    if self.args == CoreArgs::IoAllocBytesStringOutI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        if index == 2 {
            return ArgKind::Bytes;
        }
        if index == 3 {
            return ArgKind::StringOut;
        }
        if index == 4 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoAllocStringOutI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        if index == 2 {
            return ArgKind::StringOut;
        }
        if index == 3 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoBytesI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Bytes;
        }
        if index == 2 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoBytesI64BytesBytes {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 or index == 3 or index == 4 {
            return ArgKind::Bytes;
        }
        if index == 2 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoBytesI64I64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Bytes;
        }
        if index == 2 or index == 3 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::I64I64 {
        if index == 0 or index == 1 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoI64I64I64I64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index >= 1 and index <= 4 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoI64I64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 or index == 2 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoI64Bytes {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::I64;
        }
        if index == 2 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::IoI64BytesI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::I64;
        }
        if index == 2 {
            return ArgKind::Bytes;
        }
        if index == 3 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoAllocI64StringOutI64I64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        if index == 2 {
            return ArgKind::I64;
        }
        if index == 3 {
            return ArgKind::StringOut;
        }
        if index == 4 or index == 5 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::SpawnWait8 {
        if index == 0 {
            return ArgKind::I64;
        }
        if index >= 1 and index <= 8 {
            return ArgKind::Bytes;
        }
    }
    if self.args == CoreArgs::SpawnOutput8 {
        if index == 0 {
            return ArgKind::Allocator;
        }
        if index == 1 {
            return ArgKind::StringOut;
        }
        if index == 2 {
            return ArgKind::I64;
        }
        if index >= 3 and index <= 10 {
            return ArgKind::Bytes;
        }
    }
    return null;
}

pub fn simple_core_signature(name: []u8) -> ?CoreSignature {
    if mem::equal_bytes(name, "std::internal::builtin::mem_page_allocator") {
        return signature(CoreArgs::NoArgs, "Allocator");
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_allocator_from") {
        return null;
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_fixed_buffer") {
        return signature(CoreArgs::Bytes, "Allocator");
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_len") {
        return signature(CoreArgs::View, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_compare") {
        return signature(CoreArgs::BytesBytes, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::print_line") {
        return signature(CoreArgs::Bytes, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f32_bits") {
        return signature(CoreArgs::F32, "u32");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f32_from_bits") {
        return signature(CoreArgs::U32, "f32");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f64_bits") {
        return signature(CoreArgs::F64, "u64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f64_from_bits") {
        return signature(CoreArgs::U64, "f64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f64_sqrt") {
        return signature(CoreArgs::F64, "f64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f64_floor") {
        return signature(CoreArgs::F64, "f64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f64_ceil") {
        return signature(CoreArgs::F64, "f64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f64_trunc") {
        return signature(CoreArgs::F64, "f64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::f64_fma") {
        return signature(CoreArgs::F64F64F64, "f64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_fma_f32") {
        return signature(CoreArgs::F32F32F32, "f32");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_fma_f32x4") {
        return signature(CoreArgs::F32x4F32x4F32x4, "f32x4");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_fma_f64x2") {
        return signature(CoreArgs::F64x2F64x2F64x2, "f64x2");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_load_f32x4") {
        return signature(CoreArgs::SliceF32I64, "f32x4");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_load_f64x2") {
        return signature(CoreArgs::SliceF64I64, "f64x2");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_load_i32x4") {
        return signature(CoreArgs::SliceI32I64, "i32x4");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_load_u8x16") {
        return signature(CoreArgs::BytesI64, "u8x16");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_load_i8x16") {
        return signature(CoreArgs::SliceI8I64, "i8x16");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_load_i8x16_u8") {
        return signature(CoreArgs::BytesI64, "i8x16");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_store_f32x4") {
        return signature(CoreArgs::MutSliceF32I64F32x4, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_store_f64x2") {
        return signature(CoreArgs::MutSliceF64I64F64x2, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_store_i32x4") {
        return signature(CoreArgs::MutSliceI32I64I32x4, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_store_u8x16") {
        return signature(CoreArgs::MutSliceU8I64U8x16, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_store_i8x16") {
        return signature(CoreArgs::MutSliceI8I64I8x16, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_tbl16") {
        return signature(CoreArgs::U8x16U8x16, "u8x16");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_sdot_i8x16") {
        return signature(CoreArgs::I32x4I8x16I8x16, "i32x4");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_i8x16_to_f32x4_0") or
        mem::equal_bytes(name, "std::internal::builtin::simd_i8x16_to_f32x4_1") or
        mem::equal_bytes(name, "std::internal::builtin::simd_i8x16_to_f32x4_2") or
        mem::equal_bytes(name, "std::internal::builtin::simd_i8x16_to_f32x4_3") {
        return signature(CoreArgs::I8x16, "f32x4");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_f32x4_from_i32x4") {
        return signature(CoreArgs::I32x4, "f32x4");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_i32x4_from_f32x4") {
        return signature(CoreArgs::F32x4, "i32x4");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_i8x16_from_u8x16") {
        return signature(CoreArgs::U8x16, "i8x16");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_u8x16_from_i8x16") {
        return signature(CoreArgs::I8x16, "u8x16");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_popcount_u32") {
        return signature(CoreArgs::U32, "u32");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_popcount_u64") {
        return signature(CoreArgs::U64, "u64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::simd_popcount_u8x16") {
        return signature(CoreArgs::U8x16, "u8x16");
    }
    if mem::equal_bytes(name, "std::internal::builtin::gpu_thread_index") or
        mem::equal_bytes(name, "std::internal::builtin::gpu_group_index") or
