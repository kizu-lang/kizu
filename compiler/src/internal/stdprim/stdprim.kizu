import std::array;
import std::mem;
import std::string;

// Mechanical port of internal/stdprim/registry.go. Registry text is static;
// builtin_names() allocates only the caller-owned list it returns.

/// Identifies one primitive argument shape shared by static checkers.
pub enum ArgKind {
    Bytes,
    I64,
    Io,
    StringOut,
    // The allocator a primitive grows a destination buffer from. A String
    // keeps none of its own (ADR-0132).
    Allocator,
}

/// Returns the type spelling represented by kind.
pub fn arg_kind_spelling(kind: ArgKind) -> []u8 {
    return match kind {
        Bytes => "[]u8",
        I64 => "i64",
        Io => "Io",
        StringOut => "&var std::string::String",
        Allocator => "Allocator",
    };
}

enum CoreArgs {
    NoArgs,
    Bytes,
    I64,
    IoBytes,
    IoAllocBytesStringOut,
    IoAllocBytesStringOutI64,
    IoAllocStringOutI64,
    SpawnWait8,
    AllocStringOut,
    IoBytesI64,
    IoI64,
    IoI64Bytes,
    IoAllocI64StringOutI64,
}

/// Describes one simple std::internal::builtin call.
pub struct CoreSignature {
    args: CoreArgs,
    pub return_type: []u8
}

/// Returns the number of arguments declared by the signature.
pub fn (self: &CoreSignature) args_len() -> i64 {
    return match self.args {
        NoArgs => 0,
        Bytes => 1,
        I64 => 1,
        IoBytes => 2,
        IoAllocBytesStringOut => 4,
        IoAllocBytesStringOutI64 => 5,
        IoAllocStringOutI64 => 4,
        SpawnWait8 => 9,
        AllocStringOut => 2,
        IoBytesI64 => 3,
        IoI64 => 2,
        IoI64Bytes => 3,
        IoAllocI64StringOutI64 => 5,
    };
}

/// Returns one declared argument kind, or null past the end.
pub fn (self: &CoreSignature) arg_at(index: i64) -> ?ArgKind {
    if index < 0 {
        return null;
    }
    if self.args == CoreArgs::Bytes {
        if index == 0 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::I64 {
        if index == 0 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoBytes {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::IoAllocBytesStringOut {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        if index == 2 {
            return ArgKind::Bytes;
        }
        if index == 3 {
            return ArgKind::StringOut;
        }
        return null;
    }
    if self.args == CoreArgs::AllocStringOut {
        if index == 0 {
            return ArgKind::Allocator;
        }
        if index == 1 {
            return ArgKind::StringOut;
        }
        return null;
    }
    if self.args == CoreArgs::IoAllocBytesStringOutI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        if index == 2 {
            return ArgKind::Bytes;
        }
        if index == 3 {
            return ArgKind::StringOut;
        }
        if index == 4 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoAllocStringOutI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        if index == 2 {
            return ArgKind::StringOut;
        }
        if index == 3 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoBytesI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Bytes;
        }
        if index == 2 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoI64Bytes {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::I64;
        }
        if index == 2 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::IoAllocI64StringOutI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Allocator;
        }
        if index == 2 {
            return ArgKind::I64;
        }
        if index == 3 {
            return ArgKind::StringOut;
        }
        if index == 4 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::SpawnWait8 {
        if index == 0 {
            return ArgKind::I64;
        }
        if index >= 1 and index <= 8 {
            return ArgKind::Bytes;
        }
    }
    return null;
}

/// Returns a declarative core signature, or null for another primitive.
pub fn simple_core_signature(name: []u8) -> ?CoreSignature {
    if mem::equal_bytes(name, "std::internal::builtin::mem_page_allocator") {
        return signature(CoreArgs::NoArgs, "Allocator");
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_allocator_from") {
        return null;
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_fixed_buffer") {
        return signature(CoreArgs::Bytes, "Allocator");
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_len") {
        return signature(CoreArgs::Bytes, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::io_write_stdout") {
        return signature(CoreArgs::IoBytes, "std::io::Error!void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::io_write_stderr") {
        return signature(CoreArgs::IoBytes, "std::io::Error!void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_read_file_into") {
        return signature(
            CoreArgs::IoAllocBytesStringOutI64,
            "std::fs::Error!void"
        );
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_real_path_into") {
        return signature(CoreArgs::IoAllocBytesStringOut, "std::fs::Error!void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_executable_path_into") {
        return signature(CoreArgs::AllocStringOut, "std::process::Error!void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::io_read_stdin_into") {
        return signature(
            CoreArgs::IoAllocStringOutI64,
            "std::io::Error!void"
        );
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_arg_count") {
        return signature(CoreArgs::NoArgs, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_arg") {
        return signature(CoreArgs::I64, "std::process::Error![]u8");
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_env") {
        return signature(CoreArgs::Bytes, "?[]u8");
    }
    if mem::equal_bytes(
        name,
        "std::internal::builtin::process_monotonic_millis"
    ) {
        return signature(CoreArgs::NoArgs, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_unix_millis") {
        return signature(CoreArgs::NoArgs, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_spawn_wait8") {
        return signature(CoreArgs::SpawnWait8, "std::process::Error!i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::net_listen") {
        return signature(CoreArgs::IoBytesI64, "std::net::Error!i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::net_connect") {
        return signature(CoreArgs::IoBytesI64, "std::net::Error!i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::net_accept") {
        return signature(CoreArgs::IoI64, "std::net::Error!i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::net_read") {
        return signature(CoreArgs::IoAllocI64StringOutI64, "std::net::Error!i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::net_write_all") {
        return signature(CoreArgs::IoI64Bytes, "std::net::Error!void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::net_local_port") {
        return signature(CoreArgs::I64, "std::net::Error!i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::net_close") {
        return signature(CoreArgs::I64, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::test_fail") {
        return signature(CoreArgs::Bytes, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::panic") {
        return signature(CoreArgs::Bytes, "void");
    }
    return null;
}

/// Returns the public wrapper for a typed primitive, or null when absent.
pub fn typed_core_builtin(name: []u8) -> ?[]u8 {
    if mem::equal_bytes(
        name,
        "std::internal::builtin::test_fail_equal"
    ) {
        return "std::testing::expect_equal";
    }
    return null;
}

/// Reports whether name is an implemented std primitive.
pub fn primitive(name: []u8) -> bool {
    var index = 0;
    while builtin_name(index) |known| {
        if mem::equal_bytes(name, known) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

/// Returns every primitive in lexical order.
pub fn builtin_names(
    allocator: Allocator
) -> !array::Array<string::String> {
    var names = array::new<string::String>(allocator);
    errdefer names.deinit(allocator);
    var index = 0;
    while builtin_name(index) |name| {
        let owned = try string::from_bytes(allocator, name);
        errdefer owned.deinit(allocator);
        try names.append(allocator, move owned);
        index = index + 1;
    }
    return move names;
}

fn signature(args: CoreArgs, return_type: []u8) -> CoreSignature {
    return CoreSignature { args: args, return_type: return_type };
}

fn builtin_name(index: i64) -> ?[]u8 {
    if index == 0 {
        return "std::internal::builtin::arena";
    }
    if index == 1 {
        return "std::internal::builtin::arena_add";
    }
    if index == 2 {
        return "std::internal::builtin::arena_at";
    }
    if index == 3 {
        return "std::internal::builtin::arena_at_mut";
    }
    if index == 4 {
        return "std::internal::builtin::arena_deinit";
