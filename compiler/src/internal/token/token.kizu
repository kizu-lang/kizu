import compiler::internal::source;
import std::array;
import std::mem;
import std::string;

pub enum Kind {
    Illegal,
    Eof,
    Ident,
    Int,
    Float,
    String,
    CString,
    Assign,
    Plus,
    Minus,
    Bang,
    Question,
    Amp,
    Asterisk,
    Slash,
    Percent,
    Caret,
    Tilde,
    At,
    Eq,
    FatArrow,
    NotEq,
    Lt,
    Lte,
    Gt,
    Gte,
    Arrow,
    Dot,
    Range,
    Ellipsis,
    DoubleColon,
    Comma,
    Colon,
    Semicolon,
    Pipe,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Function,
    Import,
    Public,
    Let,
    Var,
    Return,
    Defer,
    ErrDefer,
    If,
    Else,
    While,
    Break,
    Continue,
    Match,
    Struct,
    Enum,
    Union,
    Contract,
    For,
    Impl,
    True,
    False,
    And,
    Or,
    Mut,
    Unsafe,
    Extern,
    Export,
    Comptime,
    Try,
    Move,
    Null,
    Orelse,
    Catch,
}

pub struct Token {
    pub kind: Kind,
    pub literal: string::String,
    pub line: i64,
    pub column: i64,
    pub doc_comments: array::Array<string::String>,
    pub source: ?source::SourceId,
}

pub fn lookup_ident(ident: []u8) -> Kind {
    let length = mem::len(ident);
    if length < 2 or length > 8 {
        return Kind::Ident;
    }
    let first = ident[0];
    if length == 2 {
        if first == cast<u8>(102) and ident[1] == cast<u8>(110) {
            return Kind::Function;
        }
        if first == cast<u8>(105) and ident[1] == cast<u8>(102) {
            return Kind::If;
        }
        if first == cast<u8>(111) and ident[1] == cast<u8>(114) {
            return Kind::Or;
        }
        return Kind::Ident;
    }
    if length == 3 {
        if first == cast<u8>(108) and mem::equal_bytes(ident, "let") {
            return Kind::Let;
        }
        if first == cast<u8>(118) and mem::equal_bytes(ident, "var") {
            return Kind::Var;
        }
        if first == cast<u8>(112) and mem::equal_bytes(ident, "pub") {
            return Kind::Public;
        }
        if first == cast<u8>(116) and mem::equal_bytes(ident, "try") {
            return Kind::Try;
        }
        if first == cast<u8>(97) and mem::equal_bytes(ident, "and") {
            return Kind::And;
        }
        if first == cast<u8>(102) and mem::equal_bytes(ident, "for") {
            return Kind::For;
        }
        if first == cast<u8>(109) and mem::equal_bytes(ident, "mut") {
            return Kind::Mut;
        }
        return Kind::Ident;
    }
    if length == 4 {
        if first == cast<u8>(101) {
            if mem::equal_bytes(ident, "else") {
                return Kind::Else;
            }
            if mem::equal_bytes(ident, "enum") {
                return Kind::Enum;
            }
            return Kind::Ident;
        }
        if first == cast<u8>(116) and mem::equal_bytes(ident, "true") {
            return Kind::True;
        }
        if first == cast<u8>(109) and mem::equal_bytes(ident, "move") {
            return Kind::Move;
        }
        if first == cast<u8>(110) and mem::equal_bytes(ident, "null") {
            return Kind::Null;
        }
        if first == cast<u8>(105) and mem::equal_bytes(ident, "impl") {
            return Kind::Impl;
        }
        return Kind::Ident;
    }
    if length == 5 {
        if first == cast<u8>(119) and mem::equal_bytes(ident, "while") {
            return Kind::While;
        }
        if first == cast<u8>(102) and mem::equal_bytes(ident, "false") {
            return Kind::False;
        }
        if first == cast<u8>(109) and mem::equal_bytes(ident, "match") {
            return Kind::Match;
        }
        if first == cast<u8>(100) and mem::equal_bytes(ident, "defer") {
            return Kind::Defer;
        }
        if first == cast<u8>(98) and mem::equal_bytes(ident, "break") {
            return Kind::Break;
        }
        if first == cast<u8>(117) and mem::equal_bytes(ident, "union") {
            return Kind::Union;
        }
        if first == cast<u8>(99) and mem::equal_bytes(ident, "catch") {
            return Kind::Catch;
        }
        return Kind::Ident;
    }
    if length == 6 {
        if first == cast<u8>(114) and mem::equal_bytes(ident, "return") {
            return Kind::Return;
        }
        if first == cast<u8>(115) and mem::equal_bytes(ident, "struct") {
            return Kind::Struct;
        }
        if first == cast<u8>(105) and mem::equal_bytes(ident, "import") {
            return Kind::Import;
        }
        if first == cast<u8>(117) and mem::equal_bytes(ident, "unsafe") {
            return Kind::Unsafe;
        }
        if first == cast<u8>(111) and mem::equal_bytes(ident, "orelse") {
            return Kind::Orelse;
        }
        if first == cast<u8>(101) {
            if mem::equal_bytes(ident, "extern") {
                return Kind::Extern;
            }
            if mem::equal_bytes(ident, "export") {
                return Kind::Export;
            }
        }
        return Kind::Ident;
    }
    if length == 8 {
        if first == cast<u8>(101) and mem::equal_bytes(ident, "errdefer") {
            return Kind::ErrDefer;
        }
        if first == cast<u8>(99) {
            if mem::equal_bytes(ident, "continue") {
                return Kind::Continue;
            }
            if mem::equal_bytes(ident, "comptime") {
                return Kind::Comptime;
            }
            if mem::equal_bytes(ident, "contract") {
                return Kind::Contract;
            }
        }
    }
    return Kind::Ident;
}

pub fn spelling(kind: Kind) -> []u8 {
    return match kind {
        Illegal => "ILLEGAL",
        Eof => "EOF",
        Ident => "IDENT",
        Int => "INT",
        Float => "FLOAT",
        String => "STRING",
        CString => "CSTRING",
        Assign => "=",
        Plus => "+",
        Minus => "-",
        Bang => "!",
        Question => "?",
        Amp => "&",
        Asterisk => "*",
        Slash => "/",
        Percent => "%",
        Caret => "^",
        Tilde => "~",
        At => "@",
        Eq => "==",
        FatArrow => "=>",
        NotEq => "!=",
        Lt => "<",
        Lte => "<=",
        Gt => ">",
        Gte => ">=",
        Arrow => "->",
        Dot => ".",
        Range => "..",
        Ellipsis => "...",
        DoubleColon => "::",
        Comma => ",",
        Colon => ":",
        Semicolon => ";",
        Pipe => "|",
        LParen => "(",
        RParen => ")",
        LBrace => "{",
        RBrace => "}",
        LBracket => "[",
        RBracket => "]",
        Function => "fn",
        Import => "import",
        Public => "pub",
        Let => "let",
        Var => "var",
        Return => "return",
        Defer => "defer",
        ErrDefer => "errdefer",
        If => "if",
        Else => "else",
        While => "while",
        Break => "break",
        Continue => "continue",
        Match => "match",
        Struct => "struct",
        Enum => "enum",
        Union => "union",
        Contract => "contract",
        For => "for",
        Impl => "impl",
        True => "true",
        False => "false",
        And => "and",
        Or => "or",
        Mut => "mut",
        Unsafe => "unsafe",
        Extern => "extern",
        Export => "export",
        Comptime => "comptime",
        Try => "try",
        Move => "move",
        Null => "null",
        Orelse => "orelse",
        Catch => "catch",
    };
}
