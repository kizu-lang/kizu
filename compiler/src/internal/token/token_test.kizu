import std::mem;
import std::testing;

fn expect_keyword(text: []u8, expected: Kind) -> void {
    testing::expect(lookup_ident(text) == expected);
}

test "token lookup recognizes every keyword" {
    expect_keyword("fn", Kind::Function);
    expect_keyword("import", Kind::Import);
    expect_keyword("pub", Kind::Public);
    expect_keyword("let", Kind::Let);
    expect_keyword("var", Kind::Var);
    expect_keyword("return", Kind::Return);
    expect_keyword("defer", Kind::Defer);
    expect_keyword("errdefer", Kind::ErrDefer);
    expect_keyword("if", Kind::If);
    expect_keyword("else", Kind::Else);
    expect_keyword("while", Kind::While);
    expect_keyword("break", Kind::Break);
    expect_keyword("continue", Kind::Continue);
    expect_keyword("match", Kind::Match);
    expect_keyword("struct", Kind::Struct);
    expect_keyword("enum", Kind::Enum);
    expect_keyword("union", Kind::Union);
    expect_keyword("contract", Kind::Contract);
    expect_keyword("for", Kind::For);
    expect_keyword("impl", Kind::Impl);
    expect_keyword("true", Kind::True);
    expect_keyword("false", Kind::False);
    expect_keyword("and", Kind::And);
    expect_keyword("or", Kind::Or);
    expect_keyword("mut", Kind::Mut);
    expect_keyword("unsafe", Kind::Unsafe);
    expect_keyword("extern", Kind::Extern);
    expect_keyword("comptime", Kind::Comptime);
    expect_keyword("try", Kind::Try);
    expect_keyword("move", Kind::Move);
    expect_keyword("null", Kind::Null);
    expect_keyword("orelse", Kind::Orelse);
}

test "token lookup keeps user names as identifiers" {
    expect_keyword("compiler", Kind::Ident);
    expect_keyword("function", Kind::Ident);
    expect_keyword("", Kind::Ident);
}

fn expect_spelling(kind: Kind, expected: []u8) -> void {
    testing::expect(mem::equal_bytes(spelling(kind), expected));
}

test "token spellings preserve Go token values" {
    expect_spelling(Kind::Illegal, "ILLEGAL");
    expect_spelling(Kind::Eof, "EOF");
    expect_spelling(Kind::Ident, "IDENT");
    expect_spelling(Kind::Int, "INT");
    expect_spelling(Kind::String, "STRING");
    expect_spelling(Kind::FatArrow, "=>");
    expect_spelling(Kind::DoubleColon, "::");
    expect_spelling(Kind::LBracket, "[");
    expect_spelling(Kind::RBracket, "]");
    expect_spelling(Kind::Function, "fn");
    expect_spelling(Kind::ErrDefer, "errdefer");
    expect_spelling(Kind::Orelse, "orelse");
}
