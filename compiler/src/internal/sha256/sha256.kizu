import std::crypto;
import std::string;

// The hex SHA-256 digest build cache keys are spelled with. Both compilers
// share one cache, so this has to be the function Go's crypto/sha256
// computes; std::crypto's FIPS 180-4 rounds are, and the vector corpus in
// compiler/tests/sha256 checks the two agree.

/// Appends the lowercase hex SHA-256 digest of bytes to out, the Go
/// `hex.EncodeToString` of `sha256.Sum256(bytes)`.
pub fn append_hex_digest(allocator: Allocator, bytes: []u8, out: &var string::String) -> !void {
    var digest = [32]u8{};
    let view = digest.as_mut_bytes();
    crypto::sha256(bytes, view);
    let digest_bytes = digest.as_bytes();
    for 0..32 |index| {
        let value = cast<i64>(digest_bytes[index]);
        try out.append_byte(allocator, hex_digit(value / 16));
        try out.append_byte(allocator, hex_digit(value % 16));
    }
    return;
}

/// The lowercase hex digit of a nibble.
fn hex_digit(nibble: i64) -> u8 {
    if nibble < 10 {
        return cast<u8>(48 + nibble);
    }
    return cast<u8>(87 + nibble);
}
