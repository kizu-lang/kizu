import std::mem;
import std::string;
import std::testing;

fn expect_string(value: &string::String, expected: []u8) -> void {
    let bytes = value.as_bytes();
    testing::expect_equal<[]u8>(expected, bytes);
}

test "stdmethod name helpers share one last-dot seam" {
    let allocator = mem::page_allocator();
    let joined = try method_name(
        allocator,
        "std::array::Array",
        "append"
    );
    defer joined.deinit(allocator);
    expect_string(&joined, "std::array::Array.append");
    if split_method_name("std::array::Array.append") |parts| {
        testing::expect_equal<[]u8>("std::array::Array", parts.receiver);
        testing::expect_equal<[]u8>("append", parts.method);
    } else {
        testing::fail("qualified method name was not split");
    }
    testing::expect_equal<[]u8>(
        "append",
        call_name("std::array::Array.append")
    );
    testing::expect_equal<[]u8>("append", call_name("append"));
    if split_method_name("append") |_| {
        testing::fail("plain call name was split as a method");
    }
}
