import compiler::internal::ast;
import compiler::internal::buildcache;
import compiler::internal::diagnostic;
import compiler::internal::fsutil;
import std::array;
import std::fmt;
import std::fs;
import std::json;
import std::map;
import std::mem;
import std::path;
import std::process;
import std::sort;
import std::string;

// Mechanical port of internal/native/build.go: linking a lowered program
// with the embedded C runtime into a host executable through the configured
// C/LLVM toolchain. The runtime object and the executable live in the
// shared build cache (compiler::internal::buildcache), keyed the same way
// the Go CLI keys them, so a build made by one CLI is reused by the other.
// Claimed temporary directories only hold the toolchain's transient inputs
// now. The LLVM IR text and the error set numbering are passed alongside
// Options rather than held in it, because a Kizu struct cannot borrow
// them.

/// Describes one native link request, the Go `Options` without the fields a
/// struct cannot borrow (`LLVMIR`, `ErrorSets`).
pub struct Options {
    pub output: string::String,
    pub triple: string::String,
    pub cpu: string::String,
    pub abi: string::String,
    pub libc: string::String,
    pub runtime: string::String,
    pub emit: string::String,
    pub linker: string::String,
    pub opt: bool,
}

/// Hands out temporary build directories: TMPDIR (or /tmp) plus
/// `kizu-native-<monotonic_millis>-<sequence>`, the Go `os.MkdirTemp`.
/// They hold the toolchain's transient inputs -- the IR, the runtime C
/// source, the host probe answer -- never the outputs, which the build
/// cache stores.
pub struct TempDirs {
    pub base: string::String,
    pub stamp: i64,
    pub next: i64,
}

/// Returns the temporary directory maker for this process.
pub fn new_temp_dirs(allocator: Allocator) -> !TempDirs {
    let dir = process::env("TMPDIR") orelse "/tmp";
    var base = try string::from_bytes(allocator, dir);
    errdefer base.deinit(allocator);
    if base.len() == 0 {
        try base.append_bytes(allocator, "/tmp");
    }
    return TempDirs { base: move base, stamp: process::monotonic_millis(), next: 0 };
}

/// Creates and returns the next temporary build directory.
pub fn (self: &var TempDirs) claim_dir(io: Io, allocator: Allocator) -> !string::String {
    var dir = string::new(allocator);
    defer dir.deinit(allocator);
    try dir.append_string(allocator, &self.base);
    try dir.append_bytes(allocator, "/kizu-native-");
    try fmt::append_i64(allocator, &var dir, self.stamp);
    try dir.append_bytes(allocator, "-");
    try fmt::append_i64(allocator, &var dir, self.next);
    self.next = self.next + 1;
    let dir_bytes = dir.as_bytes();
    try fs::create_dir(io, dir_bytes);
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_string(allocator, &dir);
    return move out;
}

/// Links a lowered program into the executable the caller names, and records
/// next to it what it was built from, the Go `Build`. It is the artifact
/// command: the output is a file the user asked for by name, so it is
/// written where they asked rather than kept in the build tree.
pub fn build(
    io: Io,
    allocator: Allocator,
    temps: &var TempDirs,
    options: &Options,
    host: &string::String,
    llvm_ir: &string::String,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>
) -> !?diagnostic::Diagnostic {
    if options.output.len() == 0 {
        return try fail_parts(allocator, "native error: output path is required", "", "");
    }
    if try validate_options(allocator, options) |failed| {
        return move failed;
    }
    var cache = try buildcache::new(io, allocator);
    defer cache.deinit(allocator);
    var source = string::new(allocator);
    defer source.deinit(allocator);
    if try runtime_source_for(allocator, sets, &var source) |failed| {
        return move failed;
    }
    let dir = try temps.claim_dir(io, allocator);
    defer dir.deinit(allocator);
    let dir_bytes = dir.as_bytes();
    var version = string::new(allocator);
    defer version.deinit(allocator);
    if try linker_version(io, allocator, dir_bytes, options, &var version) |failed| {
        errdefer failed.deinit(allocator);
        try clean_build_dir(io, allocator, dir_bytes);
        return move failed;
    }
    let version_bytes = version.as_bytes();
    var runtime_path = string::new(allocator);
    defer runtime_path.deinit(allocator);
    if try runtime_object(io, allocator, temps, &var cache, options, host, &source, version_bytes, &var runtime_path) |failed| {
        errdefer failed.deinit(allocator);
        try clean_build_dir(io, allocator, dir_bytes);
        return move failed;
    }
    let output = options.output.as_bytes();
    let parent = path::dirname(output);
    try fsutil::create_dir_all(io, parent);
    var command = array::new<string::String>(allocator);
    defer command.deinit(allocator);
    let runtime_bytes = runtime_path.as_bytes();
    let darwin = target_is_darwin(options, host);
    if try link(io, allocator, dir_bytes, runtime_bytes, output, options, darwin, target_is_arm64(options, host), version_bytes, llvm_ir, &var command) |failed| {
        errdefer failed.deinit(allocator);
        try clean_build_dir(io, allocator, dir_bytes);
        return move failed;
    }
    try clean_build_dir(io, allocator, dir_bytes);
    try write_metadata(io, allocator, options, &command);
    return null;
}

/// Returns an executable for one lowered program, linking it only when
/// nothing has it yet, the Go `Executable`: the same IR linked against the
/// same runtime by the same toolchain is the same executable however often
/// it is asked for, and the cache is shared with the Go CLI. The toolchain
/// is asked nothing until there is something to build: a run that finds its
/// executable already made needs no C toolchain at all.
pub fn executable(
    io: Io,
    allocator: Allocator,
    temps: &var TempDirs,
    options: &Options,
    host: &string::String,
    llvm_ir: &string::String,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>,
    out_exe: &var string::String
) -> !?diagnostic::Diagnostic {
    if try validate_options(allocator, options) |failed| {
        return move failed;
    }
    var cache = try buildcache::new(io, allocator);
    defer cache.deinit(allocator);
    var source = string::new(allocator);
    defer source.deinit(allocator);
    if try runtime_source_for(allocator, sets, &var source) |failed| {
        return move failed;
    }
    var target_spelling = string::new(allocator);
    defer target_spelling.deinit(allocator);
    let source_bytes = source.as_bytes();
    try executable_cache_target(allocator, &cache, options, host, source_bytes, &var target_spelling);
    let target_bytes = target_spelling.as_bytes();
    let ir_bytes = llvm_ir.as_bytes();
    let plan = try cache.get_or_build_artifact(
        io,
        allocator,
        "native-exe",
        target_bytes,
        ir_bytes,
        out_exe
    );
    match plan {
        Hit => {
            return null;
        },
        Miss(pending) => {
            errdefer pending.deinit(allocator);
            var scratch_copy = string::new(allocator);
            defer scratch_copy.deinit(allocator);
            try scratch_copy.append_string(allocator, &pending.scratch);
            let dir = try temps.claim_dir(io, allocator);
            defer dir.deinit(allocator);
            let dir_bytes = dir.as_bytes();
            let scratch_bytes = scratch_copy.as_bytes();
            var version = string::new(allocator);
            defer version.deinit(allocator);
            if try linker_version(io, allocator, dir_bytes, options, &var version) |failed| {
                errdefer failed.deinit(allocator);
                try cache.discard_artifact(io, allocator, move pending);
                try clean_build_dir(io, allocator, dir_bytes);
                return move failed;
            }
            let version_bytes = version.as_bytes();
            var runtime_path = string::new(allocator);
            defer runtime_path.deinit(allocator);
            if try runtime_object(io, allocator, temps, &var cache, options, host, &source, version_bytes, &var runtime_path) |failed| {
                errdefer failed.deinit(allocator);
                try cache.discard_artifact(io, allocator, move pending);
                try clean_build_dir(io, allocator, dir_bytes);
                return move failed;
            }
            let runtime_bytes = runtime_path.as_bytes();
            var command = array::new<string::String>(allocator);
            defer command.deinit(allocator);
            let darwin = target_is_darwin(options, host);
            if try link(io, allocator, dir_bytes, runtime_bytes, scratch_bytes, options, darwin, target_is_arm64(options, host), version_bytes, llvm_ir, &var command) |failed| {
                errdefer failed.deinit(allocator);
                try cache.discard_artifact(io, allocator, move pending);
                try clean_build_dir(io, allocator, dir_bytes);
                return move failed;
            }
            try cache.finish_artifact(io, allocator, move pending);
            try clean_build_dir(io, allocator, dir_bytes);
            return null;
        },
    }
}

/// Spells the host the way the Go toolchain key spells `runtime.GOOS` and
/// `runtime.GOARCH`, so the cache keys match the Go CLI's byte for byte.
/// std::process has no host name API: the probe runs `uname -sm` through
/// the shell into a claimed temporary file and maps the answer. A host the
/// map does not name is an error rather than a guessed key.
pub fn host_key(
    io: Io,
    allocator: Allocator,
    temps: &var TempDirs,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    let dir = try temps.claim_dir(io, allocator);
    defer dir.deinit(allocator);
    let dir_bytes = dir.as_bytes();
    let probe = try path::join(allocator, dir_bytes, "uname.txt");
    defer probe.deinit(allocator);
    var script = string::new(allocator);
    defer script.deinit(allocator);
    try script.append_bytes(allocator, "PATH=/usr/bin:/bin uname -sm > '");
    try script.append_string(allocator, &probe);
    try script.append_bytes(allocator, "'");
    let script_bytes = script.as_bytes();
    let code = try process::spawn_wait8(3, "/bin/sh", "-c", script_bytes, "", "", "", "", "");
    if code != 0 {
        try clean_build_dir(io, allocator, dir_bytes);
        return try fail_parts(allocator, "native error: host probe failed", "", "");
    }
    let probe_bytes = probe.as_bytes();
    let text = try fs::read_file(io, allocator, probe_bytes, mem::Limit::Unlimited);
    defer text.deinit(allocator);
    let answer = text.as_bytes();
    var end = mem::len(answer);
    while end > 0 and (answer[end - 1] == cast<u8>(10) or answer[end - 1] == cast<u8>(13)) {
        end = end - 1;
    }
    let trimmed = answer[0..end];
    let mapped = try append_host_of(allocator, trimmed, out);
    try clean_build_dir(io, allocator, dir_bytes);
    if !mapped {
        return try fail_parts(allocator, "native error: unsupported host `", trimmed, "`");
    }
    return null;
}

/// Returns where needle first occurs in haystack, or null, the Go
/// `strings.Index`.
fn index_of(haystack: []u8, needle: []u8) -> ?i64 {
    var start = 0;
    let size = mem::len(haystack);
    while start + mem::len(needle) <= size {
        if mem::starts_with(haystack[start..size], needle) {
            return start;
        }
        start = start + 1;
    }
    return null;
}

/// Reports whether the selected native target is a 64-bit Arm machine, the
/// Go `TargetIsArm64`. An omitted triple names the host.
pub fn target_is_arm64(options: &Options, host: &string::String) -> bool {
    if options.triple.len() == 0 {
        let host_bytes = host.as_bytes();
        if index_of(host_bytes, "-arm64") |_| {
            return true;
        }
        return false;
    }
    let triple = options.triple.as_bytes();
    return contains_ascii_fold(triple, "aarch64") or contains_ascii_fold(triple, "arm64");
}

/// Reports whether the selected native target is Darwin, whose functions keep
/// frame records. An omitted triple names host; an explicit Darwin or macOS
/// triple names Darwin even when clang is cross-compiling.
pub fn target_is_darwin(options: &Options, host: &string::String) -> bool {
    if options.triple.len() == 0 {
        let host_bytes = host.as_bytes();
        return mem::starts_with(host_bytes, "darwin-");
    }
    let triple = options.triple.as_bytes();
    return contains_ascii_fold(triple, "darwin") or contains_ascii_fold(triple, "macos");
}

fn contains_ascii_fold(haystack: []u8, needle: []u8) -> bool {
    if mem::len(needle) == 0 {
        return true;
    }
    var start = 0;
    while start + mem::len(needle) <= mem::len(haystack) {
        var index = 0;
        while index < mem::len(needle) and
            ascii_lower(haystack[start + index]) == ascii_lower(needle[index]) {
            index = index + 1;
        }
        if index == mem::len(needle) {
            return true;
        }
        start = start + 1;
    }
    return false;
}

fn ascii_lower(byte: u8) -> u8 {
    if byte >= cast<u8>(65) and byte <= cast<u8>(90) {
        return byte + cast<u8>(32);
    }
    return byte;
}

/// Maps one `uname -sm` answer to the Go `GOOS-GOARCH` spelling.
fn append_host_of(allocator: Allocator, answer: []u8, out: &var string::String) -> !bool {
    if mem::equal_bytes(answer, "Darwin arm64") {
        try out.append_bytes(allocator, "darwin-arm64");
        return true;
    }
    if mem::equal_bytes(answer, "Darwin x86_64") {
        try out.append_bytes(allocator, "darwin-amd64");
        return true;
    }
    if mem::equal_bytes(answer, "Linux x86_64") {
        try out.append_bytes(allocator, "linux-amd64");
        return true;
    }
    if mem::equal_bytes(answer, "Linux aarch64") {
        try out.append_bytes(allocator, "linux-arm64");
        return true;
    }
    return false;
}

/// Spells what changes the runtime object but is not in its source, the Go
/// `runtimeCacheTarget` over `toolchainKey`, `/`-joined in the same order,
/// then the clang's version line: the path and flags stay the same across an
/// upgrade, and an object the old clang made must not be linked into what
/// the new one builds.
fn runtime_cache_target(allocator: Allocator,
    options: &Options,
    host: &string::String,
    version: []u8,
    out: &var string::String
) -> !void {
    try out.append_bytes(allocator, "native-runtime");
    try append_toolchain_key(allocator, options, host, out);
    try out.append_byte(allocator, cast<u8>(47));
    return out.append_bytes(allocator, version);
}

/// Spells what the executable is made of besides the IR, the Go
/// `executableCacheTarget`: the toolchain key and the hash of the runtime
/// source it is linked with, so a program built against an older runtime is
/// a different artifact rather than the same one. The clang's version is not
/// part of it: an executable already made was linked whole by one clang, and
/// asking which one would cost every run the toolchain it does not need.
fn executable_cache_target(allocator: Allocator,
    cache: &buildcache::Cache,
    options: &Options,
    host: &string::String,
    runtime_source: []u8,
    out: &var string::String
) -> !void {
    try out.append_bytes(allocator, "native-exe");
    try append_toolchain_key(allocator, options, host, out);
    try out.append_byte(allocator, cast<u8>(47));
    return cache.append_content_hash(allocator, runtime_source, out);
}

/// Appends the Go `toolchainKey` parts, `/`-joined: the driver, the host
/// it builds on, and the flags it is asked to honour.
fn append_toolchain_key(allocator: Allocator,
    options: &Options,
    host: &string::String,
    out: &var string::String
) -> !void {
    try out.append_byte(allocator, cast<u8>(47));
    try out.append_string(allocator, &options.linker);
    try out.append_byte(allocator, cast<u8>(47));
    try out.append_string(allocator, host);
    if options.triple.len() > 0 {
        try out.append_bytes(allocator, "/-target/");
        try out.append_string(allocator, &options.triple);
    }
    var flags = array::new<string::String>(allocator);
    defer flags.deinit(allocator);
    try clang_optimization_flags(allocator, options.opt, target_is_arm64(options, host), &var flags);
    var index = 0;
    while flags.at(index) |flag| {
        index = index + 1;
        try out.append_byte(allocator, cast<u8>(47));
        try out.append_string(allocator, flag);
    }
    return;
}

/// Removes the transient inputs a build wrote into one claimed temporary
/// directory and the directory itself, the Go `defer os.RemoveAll` of
/// `link`, `compileRuntime` and the host and clang probes. Files a failed
/// build did not reach are skipped.
pub fn clean_build_dir(io: Io, allocator: Allocator, dir: []u8) -> !void {
    try remove_temp_file(io, allocator, dir, "runtime.c");
    try remove_temp_file(io, allocator, dir, "main.ll");
    try remove_temp_file(io, allocator, dir, "clang.args");
    try remove_temp_file(io, allocator, dir, "uname.txt");
    try remove_temp_file(io, allocator, dir, "clang-version.txt");
    let found = try fs::exists(io, dir);
    if found {
        try fs::remove_dir(io, dir);
    }
    return;
}

/// Removes one build file when it is there.
fn remove_temp_file(io: Io, allocator: Allocator, dir: []u8, name: []u8) -> !void {
    let target = try path::join(allocator, dir, name);
    defer target.deinit(allocator);
    let target_bytes = target.as_bytes();
    let found = try fs::exists(io, target_bytes);
    if found {
        try fs::remove_file(io, target_bytes);
    }
    return;
}

/// Writes the IR where the toolchain can read it and links it with the
/// runtime into output, the Go `link`. The IR is transient because the
/// executable is what is worth keeping.
fn link(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    runtime_path: []u8,
    output: []u8,
    options: &Options,
    darwin: bool,
    arm64: bool,
    version: []u8,
    llvm_ir: &string::String,
    command: &var array::Array<string::String>
) -> !?diagnostic::Diagnostic {
    var module = string::new(allocator);
    defer module.deinit(allocator);
    try module_for_linker(allocator, darwin, version, llvm_ir, &var module);
    let ir_path = try path::join(allocator, dir, "main.ll");
    defer ir_path.deinit(allocator);
    let ir_bytes = ir_path.as_bytes();
    let text = module.as_bytes();
    try fs::write_file(io, ir_bytes, text);
    return run_clang(io, allocator, dir, options, arm64, ir_bytes, runtime_path, output, command);
}

/// Writes the module as the linker is to compile it, the Go
/// `moduleForLinker`: with Apple's stack probe when Apple's clang, named by
/// its version line, links a Darwin target. Every module is emitted asking
/// for LLVM's own inline probe, with which a frame wider than a page touches
/// each page it crosses; Apple's clang calls the system __chkstk_darwin
/// helper instead, and before Apple clang 17 takes any other probe name for
/// a function to call. The choice waits until the link so that the module,
/// and the executable cache keyed by it, is the same whichever clang links it.
fn module_for_linker(
    allocator: Allocator,
    darwin: bool,
    version: []u8,
    llvm_ir: &string::String,
    out: &var string::String
) -> !void {
    let text = llvm_ir.as_bytes();
    let inline_probe =
        \\"probe-stack"="inline-asm"
    ;
    let apple_probe =
        \\"probe-stack"="__chkstk_darwin"
    ;
    let apple = index_of(version, "Apple clang") orelse -1;
    let at = index_of(text, inline_probe) orelse -1;
    if !darwin or apple < 0 or at < 0 {
        return out.append_bytes(allocator, text);
    }
    let size = mem::len(text);
    try out.append_bytes(allocator, text[0..at]);
    try out.append_bytes(allocator, apple_probe);
    return out.append_bytes(allocator, text[at + mem::len(inline_probe)..size]);
}

/// Writes the line the linker names itself with, the Go `linkerVersion`: the
/// first of its `--version` output, `Apple clang version 17.0.0
/// (clang-1700.0.13.3)` or `clang version 21.1.8`, with the spaces, tabs and
/// carriage return `strings.Trim` takes off either end. It is what tells one
/// clang from another where the path and flags are the same: the runtime
/// object is keyed by it, and the Darwin stack probe is chosen by it.
/// std::process has no output capture, so the answer goes through the build
/// directory.
fn linker_version(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    options: &Options,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    let answer_path = try path::join(allocator, dir, "clang-version.txt");
    defer answer_path.deinit(allocator);
    var script = string::new(allocator);
    defer script.deinit(allocator);
    try script.append_string(allocator, &options.linker);
    try script.append_bytes(allocator, " --version > '");
    try script.append_string(allocator, &answer_path);
    try script.append_bytes(allocator, "'");
    let script_bytes = script.as_bytes();
    let code = try process::spawn_wait8(3, "/bin/sh", "-c", script_bytes, "", "", "", "", "");
    if code != 0 {
        var status = string::new(allocator);
        defer status.deinit(allocator);
        try status.append_bytes(allocator, " --version failed: exit status ");
        try fmt::append_i64(allocator, &var status, code);
        let linker = options.linker.as_bytes();
        let status_bytes = status.as_bytes();
        return try fail_parts(allocator, "native error: ", linker, status_bytes);
    }
    let answer_bytes = answer_path.as_bytes();
    let answer = try fs::read_file(io, allocator, answer_bytes, mem::Limit::Unlimited);
    defer answer.deinit(allocator);
    let text = answer.as_bytes();
    var end = 0;
    while end < mem::len(text) and text[end] != cast<u8>(10) {
        end = end + 1;
    }
    while end > 0 and is_trimmed(text[end - 1]) {
        end = end - 1;
    }
    var start = 0;
    while start < end and is_trimmed(text[start]) {
        start = start + 1;
    }
    try out.append_bytes(allocator, text[start..end]);
    return null;
}

/// Reports whether a version line's end byte is one `strings.Trim` takes
/// off: a space, a tab or a carriage return.
fn is_trimmed(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9) or byte == cast<u8>(13);
}

/// Rejects native build modes that do not have a concrete backend yet, the
/// Go `validateOptions`.
fn validate_options(allocator: Allocator, options: &Options) -> !?diagnostic::Diagnostic {
    let libc = options.libc.as_bytes();
    if !mem::equal_bytes(libc, "on") {
        return try fail_parts(allocator, "native error: --libc ", libc, " is not implemented yet");
    }
    let runtime_mode = options.runtime.as_bytes();
    if !mem::equal_bytes(runtime_mode, "hosted") {
        return try fail_parts(allocator, "native error: --runtime ", runtime_mode, " is not implemented yet");
    }
    let emit = options.emit.as_bytes();
    if !mem::equal_bytes(emit, "exe") {
        return try fail_parts(allocator, "native error: --emit ", emit, " is not implemented yet");
    }
    if options.cpu.len() != 0 {
        return try fail_parts(allocator, "native error: --cpu is not implemented yet", "", "");
    }
    if options.abi.len() != 0 {
        return try fail_parts(allocator, "native error: --abi is not implemented yet", "", "");
    }
    let linker = options.linker.as_bytes();
    if !mem::equal_bytes(linker, "clang") {
        return try fail_parts(allocator, "native error: --linker ", linker, " is not implemented yet");
    }
    return null;
}

/// Writes the runtime C source a program is linked with, the Go
/// `runtimeSourceFor`: the runtime is part of the compiler, not part of the
/// program, and the numbers it names failures with are read from std.
fn runtime_source_for(
    allocator: Allocator,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    if try require_runtime_error_sets(allocator, sets) |failed| {
        return move failed;
    }
    try error_set_constants(allocator, sets, out);
    try out.append_bytes(allocator, runtime_source());
    return null;
}

/// Returns the compiled runtime to link, compiling it only when nothing
/// has it yet, the Go `runtimeObject`: the object lives in the shared
/// build cache under the toolchain key and the clang's version, so a
/// runtime compiled by either CLI serves both. On a miss the source is
/// compiled into the cache's scratch path through a claimed temporary
/// directory.
fn runtime_object(
    io: Io,
    allocator: Allocator,
    temps: &var TempDirs,
    cache: &var buildcache::Cache,
    options: &Options,
    host: &string::String,
    source: &string::String,
    version: []u8,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    var target_spelling = string::new(allocator);
    defer target_spelling.deinit(allocator);
    try runtime_cache_target(allocator, options, host, version, &var target_spelling);
    let target_bytes = target_spelling.as_bytes();
    let source_bytes = source.as_bytes();
    let plan = try cache.get_or_build_artifact(
        io,
        allocator,
        "native-runtime.c",
        target_bytes,
        source_bytes,
        out
    );
    match plan {
        Hit => {
            return null;
        },
        Miss(pending) => {
            errdefer pending.deinit(allocator);
            var scratch_copy = string::new(allocator);
            defer scratch_copy.deinit(allocator);
            try scratch_copy.append_string(allocator, &pending.scratch);
            let dir = try temps.claim_dir(io, allocator);
            defer dir.deinit(allocator);
            let dir_bytes = dir.as_bytes();
            let scratch_bytes = scratch_copy.as_bytes();
            if try compile_runtime(io, allocator, dir_bytes, source, scratch_bytes, options, target_is_arm64(options, host)) |failed| {
                errdefer failed.deinit(allocator);
                try cache.discard_artifact(io, allocator, move pending);
                try clean_build_dir(io, allocator, dir_bytes);
                return move failed;
            }
            try cache.finish_artifact(io, allocator, move pending);
            try clean_build_dir(io, allocator, dir_bytes);
            return null;
        },
    }
}

/// Compiles the runtime source into one object file, the Go
/// `compileRuntime`.
fn compile_runtime(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    source: &string::String,
    object: []u8,
    options: &Options,
    arm64: bool
) -> !?diagnostic::Diagnostic {
    let source_path = try path::join(allocator, dir, "runtime.c");
    defer source_path.deinit(allocator);
    let source_bytes = source_path.as_bytes();
    let text = source.as_bytes();
    try fs::write_file(io, source_bytes, text);
    var command = array::new<string::String>(allocator);
    defer command.deinit(allocator);
    let linker = options.linker.as_bytes();
    try append_copy(allocator, &var command, linker);
    try clang_flags(allocator, options, arm64, &var command);
    try append_copy(allocator, &var command, "-c");
    try append_copy(allocator, &var command, source_bytes);
    try append_copy(allocator, &var command, "-o");
    try append_copy(allocator, &var command, object);
    return spawn_clang(io, allocator, dir, options, &command);
}

/// Runs one toolchain command line, the exec of `runClang` and
/// `compileRuntime`. std::process::spawn_wait8 carries eight arguments at
/// most, and an optimized build hands clang more than that
/// (`clang [-target T] -O3 -falign-loops=32 -Xclang -mllvm -Xclang
/// -enable-tail-merge=false <a> <b> -o <output>`), so the arguments after the
/// toolchain go to a response file in the build's temporary directory, one
/// quoted word each, and clang reads them from `@file` exactly as the command
/// records them.
fn spawn_clang(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    options: &Options,
    command: &array::Array<string::String>
) -> !?diagnostic::Diagnostic {
    var words = string::new(allocator);
    defer words.deinit(allocator);
    var index = 1;
    while command.at(index) |part| {
        index = index + 1;
        let bytes = part.as_bytes();
        try append_quoted_word(allocator, &var words, bytes);
        try words.append_byte(allocator, cast<u8>(10));
    }
    let args_path = try path::join(allocator, dir, "clang.args");
    defer args_path.deinit(allocator);
    let args_bytes = args_path.as_bytes();
    let words_bytes = words.as_bytes();
    try fs::write_file(io, args_bytes, words_bytes);
    var response = try string::from_bytes(allocator, "@");
    defer response.deinit(allocator);
    try response.append_bytes(allocator, args_bytes);
    let linker = options.linker.as_bytes();
    let response_bytes = response.as_bytes();
    let code = try process::spawn_wait8(2, linker, response_bytes, "", "", "", "", "", "");
    if code != 0 {
        return try fail_linker(allocator, options, code);
    }
    return null;
}

/// Appends one argument as a single-quoted response-file word: a quote inside
/// it closes the word, is written escaped, and opens the word again.
fn append_quoted_word(allocator: Allocator, out: &var string::String, bytes: []u8) -> !void {
    try out.append_byte(allocator, cast<u8>(39));
    var index = 0;
    while index < mem::len(bytes) {
        let byte = bytes[index];
        index = index + 1;
        if byte == cast<u8>(39) {
            try out.append_bytes(allocator, "'\''");
        } else {
            try out.append_byte(allocator, byte);
        }
    }
    return out.append_byte(allocator, cast<u8>(39));
}

/// Names the sets the runtime reports its failures with, the Go
/// `runtimeErrorSets` walk: it refers to all of them whatever a program
/// uses, so a build that does not carry them would fail in the C compiler
/// with an undeclared name.
fn require_runtime_error_sets(
    allocator: Allocator,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>
) -> !?diagnostic::Diagnostic {
    if try require_error_set(allocator, sets, "std::coro::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::crypto::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::fs::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::io::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::net::Error") |failed| {
        return move failed;
    }
    return require_error_set(allocator, sets, "std::process::Error");
}

/// Rejects a build that cannot name what the runtime returns.
fn require_error_set(
    allocator: Allocator,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>,
    name: []u8
) -> !?diagnostic::Diagnostic {
    if sets.at(name) |members| {
        if members.len() > 0 {
            return null;
        }
    }
    return try fail_parts(allocator, "native error: error set `", name, "` is missing");
}

/// Writes the number each error set member lowers to, the Go
/// `errorSetConstants`, so the runtime names a failure the same way the
/// program that reads it does: set names and member names in byte order.
fn error_set_constants(
    allocator: Allocator,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>,
    out: &var string::String
) -> !void {
    if sets.len() == 0 {
        return;
    }
    var names = array::new<string::String>(allocator);
    defer names.deinit(allocator);
    try sorted_keys<map::Map<[]u8, i64>>(allocator, sets, &var names);
    try out.append_bytes(allocator, "/* Generated from the error set declarations. */");
    try out.append_byte(allocator, cast<u8>(10));
    var index = 0;
    while names.at(index) |name| {
        index = index + 1;
        let name_bytes = name.as_bytes();
        if sets.at(name_bytes) |members| {
            var spellings = array::new<string::String>(allocator);
            defer spellings.deinit(allocator);
            try sorted_keys<i64>(allocator, members, &var spellings);
            var spelling_index = 0;
            while spellings.at(spelling_index) |member| {
                spelling_index = spelling_index + 1;
                let member_bytes = member.as_bytes();
                let code = members.get(member_bytes) orelse 0;
                try out.append_bytes(allocator, "#define ");
                try append_error_constant(allocator, name_bytes, member_bytes, out);
                try out.append_bytes(allocator, " ");
                try fmt::append_i64(allocator, out, code);
                try out.append_byte(allocator, cast<u8>(10));
            }
        }
    }
    try out.append_byte(allocator, cast<u8>(10));
    return;
}

/// Collects the keys of one map in byte lexical order, the Go
/// `sort.Strings` over collected key strings.
fn sorted_keys<V>(
    allocator: Allocator,
    source: &map::Map<[]u8, V>,
    out: &var array::Array<string::String>
) -> !void {
    var index = 0;
    while source.key_at(index) |key| {
        index = index + 1;
        let name = try string::from_bytes(allocator, key);
        try out.append(allocator, move name);
    }
    return sort::strings(out);
}

/// Spells one member as a C identifier, the Go `errorConstantName`:
/// `::` and `.` in the set name become `_`, and everything is uppercased,
/// written straight into the constants text.
fn append_error_constant(allocator: Allocator, set: []u8, member: []u8, out: &var string::String) -> !void {
    try out.append_bytes(allocator, "KIZU_ERR_");
    var index = 0;
    while index < mem::len(set) {
        let byte = set[index];
        index = index + 1;
        if byte == cast<u8>(46) or (byte == cast<u8>(58) and index < mem::len(set) and set[index] == cast<u8>(58)) {
            if byte == cast<u8>(58) {
                index = index + 1;
            }
            try out.append_byte(allocator, cast<u8>(95));
            continue;
        }
        try append_upper_byte(allocator, out, byte);
    }
    try out.append_byte(allocator, cast<u8>(95));
    let snake = try camel_to_snake(allocator, member);
    defer snake.deinit(allocator);
    let total = snake.len();
    index = 0;
    while index < total {
        let snake_bytes = snake.as_bytes();
        let byte = snake_bytes[index];
        index = index + 1;
        try append_upper_byte(allocator, out, byte);
    }
    return;
}

/// Appends one byte with a lowercase letter raised to uppercase.
fn append_upper_byte(allocator: Allocator, out: &var string::String, byte: u8) -> !void {
    if byte >= cast<u8>(97) and byte <= cast<u8>(122) {
        return out.append_byte(allocator, byte - cast<u8>(32));
    }
    return out.append_byte(allocator, byte);
}

/// Separates the words in a member name for the C spelling, the Go
/// `camelToSnake`.
fn camel_to_snake(allocator: Allocator, name: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while index < mem::len(name) {
        let byte = name[index];
        if index > 0 and byte >= cast<u8>(65) and byte <= cast<u8>(90) {
            try out.append_byte(allocator, cast<u8>(95));
        }
        try out.append_byte(allocator, byte);
        index = index + 1;
    }
    return move out;
}

/// Invokes the configured C/LLVM toolchain with explicit inputs, the Go
/// `runClang`, and leaves the command it ran in command for the caller.
fn run_clang(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    options: &Options,
    arm64: bool,
    ir_path: []u8,
    runtime_path: []u8,
    output: []u8,
    command: &var array::Array<string::String>
) -> !?diagnostic::Diagnostic {
    let linker = options.linker.as_bytes();
    try append_copy(allocator, command, linker);
    try clang_flags(allocator, options, arm64, command);
    try append_copy(allocator, command, ir_path);
    try append_copy(allocator, command, runtime_path);
    try append_copy(allocator, command, "-o");
    try append_copy(allocator, command, output);
    // libm, for a float intrinsic the target has no instruction for; on
    // Darwin it is part of libSystem and the name is harmless.
    try append_copy(allocator, command, "-lm");
    return spawn_clang(io, allocator, dir, options, command);
}

/// Spells what the toolchain is asked to produce, the Go `clangFlags`.
fn clang_flags(
    allocator: Allocator,
    options: &Options,
    arm64: bool,
    out: &var array::Array<string::String>
) -> !void {
    if options.triple.len() > 0 {
        try append_copy(allocator, out, "-target");
        let triple = options.triple.as_bytes();
        try append_copy(allocator, out, triple);
    }
    return clang_optimization_flags(allocator, options.opt, arm64, out);
}

/// Selects the native toolchain optimization level, the Go
/// `clangOptimizationFlags`. `--opt` is asked for when the binary's own speed
/// is what matters, so it asks for the most the toolchain offers.
///
/// It also keeps the code generator from merging identical instruction tails
/// of blocks that jump to one successor. Arms of a dispatch loop that end in
/// the same store and step are otherwise merged into one shared tail, and
/// every iteration of those arms takes a jump into it.
///
/// And it starts every loop on a 32-byte boundary, so where a hot loop falls
/// does not depend on how much code precedes it.
///
/// And on arm64 it has float constants loaded from a literal pool rather
/// than built by a mov and three movk, which a loop calling a kernel
/// rebuilds on every call.
fn clang_optimization_flags(
    allocator: Allocator,
    opt: bool,
    arm64: bool,
    out: &var array::Array<string::String>
) -> !void {
    if !opt {
        return append_copy(allocator, out, "-O0");
    }
    try append_copy(allocator, out, "-O3");
    try append_copy(allocator, out, "-falign-loops=32");
    try append_copy(allocator, out, "-Xclang");
    try append_copy(allocator, out, "-mllvm");
    try append_copy(allocator, out, "-Xclang");
    try append_copy(allocator, out, "-enable-tail-merge=false");
    if arm64 {
        try append_copy(allocator, out, "-Xclang");
        try append_copy(allocator, out, "-target-feature");
        try append_copy(allocator, out, "-Xclang");
        try append_copy(allocator, out, "-fuse-literals");
    }
    return;
}

/// Appends one owned copy of bytes to a command line.
fn append_copy(
    allocator: Allocator,
    command: &var array::Array<string::String>,
    bytes: []u8
) -> !void {
    let value = try string::from_bytes(allocator, bytes);
    try command.append(allocator, move value);
    return;
}

/// Builds the failure one toolchain run reports, the Go
/// `fmt.Errorf("native error: %s failed: %w\n%s", ...)`. The Go error
/// carries the toolchain's combined output after the message line;
/// std::process inherits the child's streams instead, so the line here is
/// the message alone and the toolchain's own output has already reached
/// stderr.
fn fail_linker(allocator: Allocator, options: &Options, code: i64) -> !diagnostic::Diagnostic {
    var message = try string::from_bytes(allocator, "native error: ");
    defer message.deinit(allocator);
    try message.append_string(allocator, &options.linker);
    try message.append_bytes(allocator, " failed: exit status ");
    try fmt::append_i64(allocator, &var message, code);
    let text = message.as_bytes();
    return diagnostic::from_text(allocator, diagnostic::Severity::Error, ast::zero_span(), text);
}

/// Builds one failure from up to three message parts, the Go inline
/// `fmt.Errorf("native error: ...")`.
fn fail_parts(allocator: Allocator, before: []u8, value: []u8, after: []u8) -> !diagnostic::Diagnostic {
    var message = try string::from_bytes(allocator, before);
    defer message.deinit(allocator);
    try message.append_bytes(allocator, value);
    try message.append_bytes(allocator, after);
    let text = message.as_bytes();
    return diagnostic::from_text(allocator, diagnostic::Severity::Error, ast::zero_span(), text);
}

/// Records the native optimization mode in artifact metadata, the Go
/// `optimizationModeName`.
fn optimization_mode_name(opt: bool) -> []u8 {
    if opt {
        return "opt";
    }
    return "debug";
}

/// Writes the explicit build configuration used for one artifact, the Go
/// `Metadata` and `writeMetadata`: the same two-space indented JSON
/// `encoding/json` renders, next to the output as
/// `<output>.kizu-build.json`. The Go `Metadata` struct exists to carry
/// json tags, so it maps to the field sequence the encoder writes here.
fn write_metadata(
    io: Io,
    allocator: Allocator,
    options: &Options,
    command: &array::Array<string::String>
) -> !void {
    var encoder = json::encoder_with_spaces(allocator, 2);
    defer encoder.deinit(allocator);
    try encoder.begin_object();
    try encoder.write_bytes_field("target", "native");
    try write_field(&var encoder, "triple", &options.triple);
    try write_field(&var encoder, "cpu", &options.cpu);
    try write_field(&var encoder, "abi", &options.abi);
    try write_field(&var encoder, "libc", &options.libc);
    try write_field(&var encoder, "runtime", &options.runtime);
    try write_field(&var encoder, "emit", &options.emit);
    try write_field(&var encoder, "linker", &options.linker);
    let mode = optimization_mode_name(options.opt);
    try encoder.write_bytes_field("optimization_mode", mode);
    try write_field(&var encoder, "output", &options.output);
    try encoder.begin_array_field("command");
    var index = 0;
    while command.at(index) |argument| {
        index = index + 1;
        let argument_bytes = argument.as_bytes();
        try encoder.write_bytes(argument_bytes);
    }
    try encoder.end_array();
    try encoder.end_object();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(allocator, &var out);
    try out.append_byte(allocator, cast<u8>(10));
    var target = string::new(allocator);
    defer target.deinit(allocator);
    try target.append_string(allocator, &options.output);
    try target.append_bytes(allocator, ".kizu-build.json");
    let target_bytes = target.as_bytes();
    let text = out.as_bytes();
    try fs::write_file(io, target_bytes, text);
    return;
}

/// Writes one owned option value as a metadata field.
fn write_field(encoder: &var json::Encoder, name: []u8, value: &string::String) -> !void {
    let bytes = value.as_bytes();
    return encoder.write_bytes_field(name, bytes);
}
