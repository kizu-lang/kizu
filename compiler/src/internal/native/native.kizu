import compiler::internal::ast;
import compiler::internal::buildcache;
import compiler::internal::diagnostic;
import compiler::internal::fsutil;
import compiler::internal::stdtarget;
import std::array;
import std::fmt;
import std::fs;
import std::json;
import std::map;
import std::mem;
import std::path;
import std::process;
import std::sort;
import std::string;
import std::thread;

pub struct Options {
    pub output: string::String,
    pub target: stdtarget::Target,
    pub triple: string::String,
    pub cpu: string::String,
    pub abi: string::String,
    pub libc: string::String,
    pub runtime: string::String,
    pub emit: string::String,
    pub linker: string::String,
    pub opt: bool,
    pub thinlto: bool,
    pub direct: bool,
    pub own_backend: bool,
    pub libraries: array::Array<string::String>,
    pub frameworks: array::Array<string::String>,
    pub library_search: array::Array<string::String>,
    pub framework_search: array::Array<string::String>,
}

pub struct TempDirs {
    pub base: string::String,
    pub stamp: i64,
    pub next: i64,
}

pub fn new_temp_dirs(allocator: Allocator) -> !TempDirs {
    var base = string::new(allocator);
    errdefer base.deinit(allocator);
    comptime if std::target::is_windows() {
        if process::env("TMP") |dir| {
            try base.append_bytes(allocator, dir);
        } else if process::env("TEMP") |dir| {
            try base.append_bytes(allocator, dir);
        }
    } else {
        let dir = process::env("TMPDIR") orelse "/tmp";
        try base.append_bytes(allocator, dir);
        if base.len() == 0 {
            try base.append_bytes(allocator, "/tmp");
        }
    }
    return TempDirs { base: move base, stamp: process::monotonic_millis(), next: 0 };
}

pub fn (self: &var TempDirs) claim_dir(io: Io, allocator: Allocator) -> !string::String {
    var dir = string::new(allocator);
    defer dir.deinit(allocator);
    try dir.append_string(allocator, &self.base);
    try dir.append_bytes(allocator, "/kizu-native-");
    try fmt::append_i64(allocator, &var dir, self.stamp);
    try dir.append_bytes(allocator, "-");
    try fmt::append_i64(allocator, &var dir, self.next);
    self.next = self.next + 1;
    let dir_bytes = dir.as_bytes();
    try fs::create_dir(io, dir_bytes);
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_string(allocator, &dir);
    return move out;
}

pub fn build(
    io: Io,
    allocator: Allocator,
    temps: &var TempDirs,
    options: &Options,
    host: &string::String,
    units: &array::Array<string::String>,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>
) -> !?diagnostic::Diagnostic {
    if options.output.len() == 0 {
        return try fail_parts(allocator, "native error: output path is required", "", "");
    }
    if try validate_options(allocator, options) |failed| {
        return move failed;
    }
    var cache = try buildcache::new(io, allocator);
    defer cache.deinit(allocator);
    var source = string::new(allocator);
    defer source.deinit(allocator);
    if try runtime_source_for(allocator, sets, &var source) |failed| {
        return move failed;
    }
    let dir = try temps.claim_dir(io, allocator);
    defer dir.deinit(allocator);
    let dir_bytes = dir.as_bytes();
    var version = string::new(allocator);
    defer version.deinit(allocator);
    if try linker_version(allocator, options, target_is_arm64(options, host), &var version) |failed| {
        errdefer failed.deinit(allocator);
        try clean_build_dir(io, allocator, dir_bytes);
        return move failed;
    }
    let version_bytes = version.as_bytes();
    var runtime_path = string::new(allocator);
    defer runtime_path.deinit(allocator);
    if try runtime_object(io, allocator, temps, &var cache, options, host, &source, version_bytes, &var runtime_path) |failed| {
        errdefer failed.deinit(allocator);
        try clean_build_dir(io, allocator, dir_bytes);
        return move failed;
    }
    let output = options.output.as_bytes();
    let parent = path::dirname(output);
    try fsutil::create_dir_all(io, parent);
    var command = array::new<string::String>(allocator);
    defer command.deinit(allocator);
    let runtime_bytes = runtime_path.as_bytes();
    let emit = options.emit.as_bytes();
    if mem::equal_bytes(emit, "unit-obj") {
        if units.at(0) |unit| {
            var object = string::new(allocator);
            defer object.deinit(allocator);
            try stamp_object(io, allocator, runtime_bytes, unit, &var object);
            let object_bytes = object.as_bytes();
            try fs::write_file(io, output, object_bytes);
        }
        try clean_build_dir(io, allocator, dir_bytes);
        return null;
    }
    if try link(io, allocator, &var cache, dir_bytes, runtime_bytes, output, options, host, version_bytes, units, &var command) |failed| {
        errdefer failed.deinit(allocator);
        try clean_build_dir(io, allocator, dir_bytes);
        return move failed;
    }
    try clean_build_dir(io, allocator, dir_bytes);
    try write_metadata(io, allocator, options, &command);
    return null;
}

pub fn executable(
    io: Io,
    allocator: Allocator,
    temps: &var TempDirs,
    options: &Options,
    host: &string::String,
    units: &array::Array<string::String>,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>,
    out_exe: &var string::String
) -> !?diagnostic::Diagnostic {
    if try validate_options(allocator, options) |failed| {
        return move failed;
    }
    var cache = try buildcache::new(io, allocator);
    defer cache.deinit(allocator);
    var source = string::new(allocator);
    defer source.deinit(allocator);
    if try runtime_source_for(allocator, sets, &var source) |failed| {
        return move failed;
    }
    var target_spelling = string::new(allocator);
    defer target_spelling.deinit(allocator);
    let source_bytes = source.as_bytes();
    try executable_cache_target(allocator, &cache, options, host, source_bytes, &var target_spelling);
    let target_bytes = target_spelling.as_bytes();
    var digests = string::new(allocator);
    defer digests.deinit(allocator);
    try append_unit_digests(allocator, &cache, units, &var digests);
    let digest_bytes = digests.as_bytes();
    let plan = try cache.get_or_build_artifact(
        io,
        allocator,
        "native-exe",
        target_bytes,
        digest_bytes,
        out_exe
    );
    match plan {
        Hit => {
            return null;
        },
        Miss(pending) => {
            errdefer pending.deinit(allocator);
            var scratch_copy = string::new(allocator);
            defer scratch_copy.deinit(allocator);
            try scratch_copy.append_string(allocator, &pending.scratch);
            let dir = try temps.claim_dir(io, allocator);
            defer dir.deinit(allocator);
            let dir_bytes = dir.as_bytes();
            let scratch_bytes = scratch_copy.as_bytes();
            var version = string::new(allocator);
            defer version.deinit(allocator);
            if try linker_version(allocator, options, target_is_arm64(options, host), &var version) |failed| {
                errdefer failed.deinit(allocator);
                try cache.discard_artifact(io, allocator, move pending);
                try clean_build_dir(io, allocator, dir_bytes);
                return move failed;
            }
            let version_bytes = version.as_bytes();
            var runtime_path = string::new(allocator);
            defer runtime_path.deinit(allocator);
            if try runtime_object(io, allocator, temps, &var cache, options, host, &source, version_bytes, &var runtime_path) |failed| {
                errdefer failed.deinit(allocator);
                try cache.discard_artifact(io, allocator, move pending);
                try clean_build_dir(io, allocator, dir_bytes);
                return move failed;
            }
            let runtime_bytes = runtime_path.as_bytes();
            var command = array::new<string::String>(allocator);
            defer command.deinit(allocator);
            if try link(io, allocator, &var cache, dir_bytes, runtime_bytes, scratch_bytes, options, host, version_bytes, units, &var command) |failed| {
                errdefer failed.deinit(allocator);
                try cache.discard_artifact(io, allocator, move pending);
                try clean_build_dir(io, allocator, dir_bytes);
                return move failed;
            }
            try cache.finish_artifact(io, allocator, move pending);
            try clean_build_dir(io, allocator, dir_bytes);
            return null;
        },
    }
}

extern "c" fn uname(name: ptr<u8>) -> i32
pub fn host_key(allocator: Allocator, out: &var string::String) -> !?diagnostic::Diagnostic {
    var answer = string::new(allocator);
    defer answer.deinit(allocator);
    comptime if std::target::is_windows() {
        if process::env("PROCESSOR_ARCHITECTURE") |machine| {
            try answer.append_bytes(allocator, "Windows ");
            try answer.append_bytes(allocator, machine);
        }
    } else {
        var width = 65;
        comptime if std::target::is_darwin() {
            width = 256;
        }
        var buffer = [1536]u8{};
        let fields = buffer.as_mut_bytes();
        // SAFETY: fields holds 1536 bytes, more than either struct utsname, and uname(2) keeps no pointer to it
        let code = unsafe uname(mut_ptr_of(fields));
        if code != cast<i32>(0) {
            return try fail_parts(allocator, "native error: host probe failed", "", "");
        }
        try append_c_field(allocator, fields[0..width], &var answer);
        try answer.append_byte(allocator, cast<u8>(32));
        try append_c_field(allocator, fields[4 * width..5 * width], &var answer);
    }
    let text = answer.as_bytes();
    var end = mem::len(text);
    while end > 0 and (text[end - 1] == cast<u8>(10) or text[end - 1] == cast<u8>(13)) {
        end = end - 1;
    }
    let trimmed = text[0..end];
    let mapped = try append_host_of(allocator, trimmed, out);
    if !mapped {
        return try fail_parts(allocator, "native error: unsupported host `", trimmed, "`");
    }
    return null;
}

fn append_c_field(allocator: Allocator, field: []u8, out: &var string::String) -> !void {
    for 0..mem::len(field) |index| {
        if field[index] == cast<u8>(0) {
            return;
        }
        try out.append_byte(allocator, field[index]);
    }
    return;
}

fn index_of(haystack: []u8, needle: []u8) -> ?i64 {
    var start = 0;
    let size = mem::len(haystack);
    while start + mem::len(needle) <= size {
        if mem::starts_with(haystack[start..size], needle) {
            return start;
        }
        start = start + 1;
    }
    return null;
}

pub fn target_is_arm64(options: &Options, host: &string::String) -> bool {
    if options.triple.len() == 0 {
        let host_bytes = host.as_bytes();
        if index_of(host_bytes, "-arm64") |_| {
            return true;
        }
        return false;
    }
    let triple = options.triple.as_bytes();
    return contains_ascii_fold(triple, "aarch64") or contains_ascii_fold(triple, "arm64");
}

pub fn target_is_x86_64(options: &Options, host: &string::String) -> bool {
    if options.triple.len() == 0 {
        let host_bytes = host.as_bytes();
        if index_of(host_bytes, "-amd64") |_| {
            return true;
        }
        return false;
    }
    let triple = options.triple.as_bytes();
    return starts_with_ascii_fold(triple, "x86_64") or starts_with_ascii_fold(triple, "amd64");
}

fn starts_with_ascii_fold(text: []u8, prefix: []u8) -> bool {
    if mem::len(text) < mem::len(prefix) {
        return false;
    }
    var index = 0;
    while index < mem::len(prefix) {
        if ascii_lower(text[index]) != prefix[index] {
            return false;
        }
        index = index + 1;
    }
    return true;
}

pub fn target_for(
    allocator: Allocator, triple: []u8, out: &var stdtarget::Target
) -> !?diagnostic::Diagnostic {
    if mem::len(triple) == 0 {
        out.* = stdtarget::host();
        return null;
    }
    if contains_ascii_fold(triple, "darwin") or contains_ascii_fold(triple, "macos")
        or contains_ascii_fold(triple, "-ios") {
        out.* = stdtarget::Target::NativeDarwin;
        return null;
    }
    if contains_ascii_fold(triple, "linux") {
        out.* = stdtarget::Target::NativeLinux;
        return null;
    }
    let windows = contains_ascii_fold(triple, "windows");
    if contains_ascii_fold(triple, "mingw") or windows and ends_with_ascii_fold(triple, "-gnu") {
        out.* = stdtarget::Target::NativeWindows;
        return null;
    }
    if windows {
        return try fail_parts(
            allocator,
            "native error: --triple ",
            triple,
            " names the MSVC environment; a Windows target is built for the GNU one (x86_64-w64-windows-gnu)"
        );
    }
    var message = string::new(allocator);
    defer message.deinit(allocator);
    try message.append_bytes(allocator, " names no supported OS (");
    try message.append_bytes(allocator, stdtarget::native_os_spelling());
    try message.append_bytes(allocator, ")");
    let after = message.as_bytes();
    return try fail_parts(allocator, "native error: --triple ", triple, after);
}

fn ends_with_ascii_fold(text: []u8, suffix: []u8) -> bool {
    let size = mem::len(text);
    if size < mem::len(suffix) {
        return false;
    }
    return starts_with_ascii_fold(text[size - mem::len(suffix)..size], suffix);
}

fn contains_ascii_fold(haystack: []u8, needle: []u8) -> bool {
    if mem::len(needle) == 0 {
        return true;
    }
    var start = 0;
    while start + mem::len(needle) <= mem::len(haystack) {
        var index = 0;
        while index < mem::len(needle) and
            ascii_lower(haystack[start + index]) == ascii_lower(needle[index]) {
            index = index + 1;
        }
        if index == mem::len(needle) {
            return true;
        }
        start = start + 1;
    }
    return false;
}

fn ascii_lower(byte: u8) -> u8 {
    if byte >= cast<u8>(65) and byte <= cast<u8>(90) {
        return byte + cast<u8>(32);
    }
    return byte;
}

fn append_host_of(allocator: Allocator, answer: []u8, out: &var string::String) -> !bool {
    if mem::equal_bytes(answer, "Darwin arm64") {
        try out.append_bytes(allocator, "darwin-arm64");
        return true;
    }
    if mem::equal_bytes(answer, "Darwin x86_64") {
        try out.append_bytes(allocator, "darwin-amd64");
        return true;
    }
    if mem::equal_bytes(answer, "Linux x86_64") {
        try out.append_bytes(allocator, "linux-amd64");
        return true;
    }
    if mem::equal_bytes(answer, "Linux aarch64") {
        try out.append_bytes(allocator, "linux-arm64");
        return true;
    }
    if mem::equal_bytes(answer, "Windows AMD64") {
        try out.append_bytes(allocator, "windows-amd64");
        return true;
    }
    if mem::equal_bytes(answer, "Windows ARM64") {
        try out.append_bytes(allocator, "windows-arm64");
        return true;
    }
    return false;
}

fn driver(allocator: Allocator, options: &Options, arm64: bool) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    if options.target == stdtarget::Target::NativeWindows {
        if arm64 {
            try out.append_bytes(allocator, "aarch64-w64-mingw32-");
        } else {
            try out.append_bytes(allocator, "x86_64-w64-mingw32-");
        }
    }
    if direct_tools(options) {
        try out.append_bytes(allocator, "clang");
        return move out;
    }
    try out.append_string(allocator, &options.linker);
    return move out;
}

fn append_field(allocator: Allocator, out: &var string::String, value: []u8) -> !void {
    try fmt::append_i64(allocator, out, mem::len(value));
    try out.append_byte(allocator, cast<u8>(58));
    return out.append_bytes(allocator, value);
}

fn append_fields(allocator: Allocator, out: &var string::String, values: &array::Array<string::String>) -> !void {
    try fmt::append_i64(allocator, out, values.len());
    try out.append_byte(allocator, cast<u8>(10));
    var index = 0;
    while values.at(index) |value| {
        index = index + 1;
        let value_bytes = value.as_bytes();
        try append_field(allocator, out, value_bytes);
    }
    return;
}

pub fn append_build_identity(
    allocator: Allocator,
    options: &Options,
    host: &string::String,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    var version = string::new(allocator);
    defer version.deinit(allocator);
    if try linker_version(allocator, options, target_is_arm64(options, host), &var version) |failed| {
        return move failed;
    }
    let version_bytes = version.as_bytes();
    try append_field(allocator, out, version_bytes);
    let host_bytes = host.as_bytes();
    try append_field(allocator, out, host_bytes);
    try append_field(allocator, out, process::env("SDKROOT") orelse "");
    let output = options.output.as_bytes();
    try append_field(allocator, out, output);
    let triple = options.triple.as_bytes();
    try append_field(allocator, out, triple);
    let cpu = options.cpu.as_bytes();
    try append_field(allocator, out, cpu);
    let abi = options.abi.as_bytes();
    try append_field(allocator, out, abi);
    let libc = options.libc.as_bytes();
    try append_field(allocator, out, libc);
    let runtime = options.runtime.as_bytes();
    try append_field(allocator, out, runtime);
    let emit = options.emit.as_bytes();
    try append_field(allocator, out, emit);
    let linker = options.linker.as_bytes();
    try append_field(allocator, out, linker);
    try append_field(allocator, out, optimization_mode_name(options));
    if options.direct {
        try append_field(allocator, out, "direct");
    } else if options.own_backend {
        try append_field(allocator, out, "default");
    } else {
        try append_field(allocator, out, "llvm");
    }
    try append_fields(allocator, out, &options.libraries);
    try append_fields(allocator, out, &options.frameworks);
    try append_fields(allocator, out, &options.library_search);
    try append_fields(allocator, out, &options.framework_search);
    return null;
}

pub fn links_only_system(options: &Options) -> bool {
    return options.libraries.len() == 0 and options.frameworks.len() == 0 and
        options.library_search.len() == 0 and options.framework_search.len() == 0;
}

fn runtime_cache_target(allocator: Allocator,
    options: &Options,
    host: &string::String,
    version: []u8,
    out: &var string::String
) -> !void {
    try out.append_bytes(allocator, "native-runtime");
    try append_toolchain_key(allocator, options, host, out);
    try out.append_byte(allocator, cast<u8>(47));
    return out.append_bytes(allocator, version);
}

fn object_cache_target(allocator: Allocator,
    options: &Options,
    host: &string::String,
    version: []u8,
    out: &var string::String
) -> !void {
    try out.append_bytes(allocator, unit_artifact_name(options));
    try append_toolchain_key(allocator, options, host, out);
    try out.append_byte(allocator, cast<u8>(47));
    return out.append_bytes(allocator, version);
}

fn unit_artifact_name(options: &Options) -> []u8 {
    if options.thinlto {
        return "native-bc";
    }
    return "native-obj";
}

fn executable_cache_target(allocator: Allocator,
    cache: &buildcache::Cache,
    options: &Options,
    host: &string::String,
    runtime_source: []u8,
    out: &var string::String
) -> !void {
    try out.append_bytes(allocator, "native-exe");
    try append_toolchain_key(allocator, options, host, out);
    try out.append_byte(allocator, cast<u8>(47));
    return cache.append_content_hash(allocator, runtime_source, out);
}

fn append_toolchain_key(allocator: Allocator,
    options: &Options,
    host: &string::String,
    out: &var string::String
) -> !void {
    let arm64 = target_is_arm64(options, host);
    let name = try driver(allocator, options, arm64);
    defer name.deinit(allocator);
    try out.append_byte(allocator, cast<u8>(47));
    try out.append_string(allocator, &name);
    try out.append_byte(allocator, cast<u8>(47));
    try out.append_string(allocator, host);
    if options.triple.len() > 0 {
        try out.append_bytes(allocator, "/-target/");
        try out.append_string(allocator, &options.triple);
    }
    if direct_tools(options) {
        try out.append_bytes(allocator, "/as+ld");
    }
    var flags = array::new<string::String>(allocator);
    defer flags.deinit(allocator);
    try clang_optimization_flags(allocator, options.opt, target_is_arm64(options, host), &var flags);
    try thinlto_compile_flags(allocator, options, &var flags);
    try thinlto_codegen_flags(allocator, options, target_is_arm64(options, host), &var flags);
    try link_flags(allocator, options, &var flags);
    var index = 0;
    while flags.at(index) |flag| {
        index = index + 1;
        try out.append_byte(allocator, cast<u8>(47));
        try out.append_string(allocator, flag);
    }
    if process::env("SDKROOT") |sdk| {
        if mem::len(sdk) > 0 {
            try out.append_bytes(allocator, "/SDKROOT=");
            try out.append_bytes(allocator, sdk);
        }
    }
    return;
}

pub fn clean_build_dir(io: Io, allocator: Allocator, dir: []u8) -> !void {
    try remove_temp_file(io, allocator, dir, "runtime.c");
    try remove_temp_file(io, allocator, dir, "clang.args");
    let found = try fs::exists(io, dir);
    if found {
        try fs::remove_dir(io, dir);
    }
    return;
}

fn remove_temp_file(io: Io, allocator: Allocator, dir: []u8, name: []u8) -> !void {
    let target = try path::join(allocator, dir, name);
    defer target.deinit(allocator);
    let target_bytes = target.as_bytes();
    let found = try fs::exists(io, target_bytes);
    if found {
        try fs::remove_file(io, target_bytes);
    }
    return;
}

fn remove_temp_unit_file(io: Io, allocator: Allocator, dir: []u8, index: i64, extension: []u8) -> !void {
    let unit_path = try unit_file(allocator, dir, index, extension);
    defer unit_path.deinit(allocator);
    let path_bytes = unit_path.as_bytes();
    let found = try fs::exists(io, path_bytes);
    if found {
        try fs::remove_file(io, path_bytes);
    }
    return;
}

fn link(
    io: Io,
    allocator: Allocator,
    cache: &var buildcache::Cache,
    dir: []u8,
    runtime_path: []u8,
    output: []u8,
    options: &Options,
    host: &string::String,
    version: []u8,
    units: &array::Array<string::String>,
    command: &var array::Array<string::String>
) -> !?diagnostic::Diagnostic {
    if direct_tools(options) {
        if try link_with_tools(io, allocator, dir, runtime_path, output, options, units, command) |failed| {
            errdefer failed.deinit(allocator);
            try remove_unit_files(io, allocator, dir, units.len());
            return move failed;
        }
        try remove_unit_files(io, allocator, dir, units.len());
        return null;
    }
    let arm64 = target_is_arm64(options, host);
    var inputs = array::new<string::String>(allocator);
    defer inputs.deinit(allocator);
    if try unit_inputs(io, allocator, cache, dir, runtime_path, options, host, version, units, &var inputs) |failed| {
        errdefer failed.deinit(allocator);
        try remove_unit_files(io, allocator, dir, units.len());
        return move failed;
    }
    let cache_dir = cache.dir.as_bytes();
    if try run_clang(io, allocator, dir, cache_dir, options, arm64, &inputs, runtime_path, output, command) |failed| {
        errdefer failed.deinit(allocator);
        try remove_unit_files(io, allocator, dir, units.len());
        return move failed;
    }
    try remove_unit_files(io, allocator, dir, units.len());
    return null;
}

fn unit_inputs(
    io: Io,
    allocator: Allocator,
    cache: &var buildcache::Cache,
    dir: []u8,
    runtime_path: []u8,
    options: &Options,
    host: &string::String,
    version: []u8,
    units: &array::Array<string::String>,
    inputs: &var array::Array<string::String>
) -> !?diagnostic::Diagnostic {
    var index = 0;
    if options.direct {
        try direct_inputs(io, allocator, dir, runtime_path, options, units, inputs);
        return null;
    }
    if options.opt and !options.thinlto {
        while units.at(index) |unit| {
            let unit_path = try unit_text_path(io, allocator, dir, index, options);
            defer unit_path.deinit(allocator);
            index = index + 1;
            var module = string::new(allocator);
            defer module.deinit(allocator);
            try module_for_linker(allocator, options.target, version, unit, &var module);
            let path_bytes = unit_path.as_bytes();
            let text = module.as_bytes();
            try fs::write_file(io, path_bytes, text);
            try inputs.append(allocator, try string::from_bytes(allocator, path_bytes));
        }
        return null;
    }
    var target_spelling = string::new(allocator);
    defer target_spelling.deinit(allocator);
    try object_cache_target(allocator, options, host, version, &var target_spelling);
    let target_bytes = target_spelling.as_bytes();
    var jobs = array::new<UnitJob>(allocator);
    defer jobs.deinit(allocator);
    var pending_objects = array::new<buildcache::PendingArtifact>(allocator);
    defer pending_objects.deinit(allocator);
    while units.at(index) |unit| {
        let unit_index = index;
        index = index + 1;
        var digest = string::new(allocator);
        defer digest.deinit(allocator);
        let unit_bytes = unit.as_bytes();
        try cache.append_content_hash(allocator, unit_bytes, &var digest);
        let digest_bytes = digest.as_bytes();
        var object = string::new(allocator);
        errdefer object.deinit(allocator);
        let plan = try cache.get_or_build_artifact(
            io,
            allocator,
            unit_artifact_name(options),
            target_bytes,
            digest_bytes,
            &var object
        );
        match plan {
            Hit => {},
            Miss(pending) => {
                errdefer pending.deinit(allocator);
                var module = string::new(allocator);
                defer module.deinit(allocator);
                try module_for_linker(allocator, options.target, version, unit, &var module);
                let job = try prepare_unit(io, allocator, dir, unit_index, &module, &pending.scratch, options, target_is_arm64(options, host));
                try jobs.append(allocator, move job);
                try pending_objects.append(allocator, move pending);
            },
        }
        try inputs.append(allocator, move object);
    }
    if jobs.len() > 0 {
        var pool = try thread::init(io, allocator, thread::cpu_count(io));
        defer pool.deinit(allocator);
        var states = array::new<UnitJobs>(allocator);
        defer states.deinit(allocator);
        for 0..pool.threads() |_thread| {
            try states.append(allocator, try clone_jobs(allocator, &jobs));
        }
        var codes = array::new<i64>(allocator);
        defer codes.deinit(allocator);
        for 0..jobs.len() |_job| {
            try codes.append(allocator, 0);
        }
        let slots = codes.as_mut_slice();
        try thread::each_with<i64, UnitJobs, CompileFailure>(&var pool, slots, 1, &var states, compile_units);
        var code_index = 0;
        while codes.get(code_index) |code| {
            if jobs.at_mut(code_index) |job| {
                job.code = code;
            }
            code_index = code_index + 1;
        }
    }
    var job_index = 0;
    while jobs.at(job_index) |job| {
        job_index = job_index + 1;
        let pending = try pending_objects.remove(0);
        errdefer pending.deinit(allocator);
        if job.code != 0 {
            let toolchain = job.toolchain.as_bytes();
            let failed = try fail_linker(allocator, toolchain, job.code);
            errdefer failed.deinit(allocator);
            try cache.discard_artifact(io, allocator, move pending);
            while pending_objects.len() > 0 {
                let rest = try pending_objects.remove(0);
                try cache.discard_artifact(io, allocator, move rest);
            }
            return move failed;
        }
        try cache.finish_artifact(io, allocator, move pending);
    }
    return null;
}

fn append_unit_digests(
    allocator: Allocator,
    cache: &buildcache::Cache,
    units: &array::Array<string::String>,
    out: &var string::String
) -> !void {
    var index = 0;
    while units.at(index) |unit| {
        if index > 0 {
            try out.append_byte(allocator, cast<u8>(10));
        }
        index = index + 1;
        let unit_bytes = unit.as_bytes();
        try cache.append_content_hash(allocator, unit_bytes, out);
    }
    return;
}

fn unit_dir(allocator: Allocator, dir: []u8, index: i64) -> !string::String {
    var name = try string::from_bytes(allocator, "unit");
    defer name.deinit(allocator);
    try fmt::append_i64(allocator, &var name, index);
    let name_bytes = name.as_bytes();
    return path::join(allocator, dir, name_bytes);
}

fn unit_file(allocator: Allocator, dir: []u8, index: i64, extension: []u8) -> !string::String {
    let unit = try unit_dir(allocator, dir, index);
    defer unit.deinit(allocator);
    var name = try string::from_bytes(allocator, "unit");
    defer name.deinit(allocator);
    try name.append_bytes(allocator, extension);
    let unit_bytes = unit.as_bytes();
    let name_bytes = name.as_bytes();
    return path::join(allocator, unit_bytes, name_bytes);
}

fn unit_text_path(io: Io, allocator: Allocator, dir: []u8, index: i64, options: &Options) -> !string::String {
    let unit = try unit_dir(allocator, dir, index);
    defer unit.deinit(allocator);
    let unit_bytes = unit.as_bytes();
    try fs::create_dir(io, unit_bytes);
    return unit_file(allocator, dir, index, unit_extension(options));
}

fn unit_extension(options: &Options) -> []u8 {
    if options.direct {
        return ".o";
    }
    return ".ll";
}

fn remove_unit_files(io: Io, allocator: Allocator, dir: []u8, count: i64) -> !void {
    var index = 0;
    while index < count {
        try remove_temp_unit_file(io, allocator, dir, index, ".ll");
        try remove_temp_unit_file(io, allocator, dir, index, ".args");
        try remove_temp_unit_file(io, allocator, dir, index, ".o");
        let unit = try unit_dir(allocator, dir, index);
        defer unit.deinit(allocator);
        let unit_bytes = unit.as_bytes();
        let found = try fs::exists(io, unit_bytes);
        if found {
            try fs::remove_dir(io, unit_bytes);
        }
        index = index + 1;
    }
    return;
}

struct UnitJob {
    toolchain: string::String,
    response: string::String,
    code: i64,
}

error CompileFailure = thread::Error or process::Error;

fn prepare_unit(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    index: i64,
    text: &string::String,
    object: &string::String,
    options: &Options,
    arm64: bool
) -> !UnitJob {
    let unit_path = try unit_text_path(io, allocator, dir, index, options);
    defer unit_path.deinit(allocator);
    let path_bytes = unit_path.as_bytes();
    let text_bytes = text.as_bytes();
    try fs::write_file(io, path_bytes, text_bytes);
    var command = array::new<string::String>(allocator);
    defer command.deinit(allocator);
    let name = try driver(allocator, options, arm64);
    try command.append(allocator, move name);
    try clang_flags(allocator, options, arm64, &var command);
    try thinlto_compile_flags(allocator, options, &var command);
    try append_copy(allocator, &var command, "-Wno-override-module");
    try append_copy(allocator, &var command, "-c");
    try append_copy(allocator, &var command, path_bytes);
    try append_copy(allocator, &var command, "-o");
    let object_bytes = object.as_bytes();
    try append_copy(allocator, &var command, object_bytes);
    let args_path = try unit_file(allocator, dir, index, ".args");
    defer args_path.deinit(allocator);
    let args_bytes = args_path.as_bytes();
    let response = try write_response(io, allocator, args_bytes, &command);
    errdefer response.deinit(allocator);
    let toolchain = try driver(allocator, options, arm64);
    return UnitJob { toolchain: move toolchain, response: move response, code: 0 };
}

struct UnitJobs {
    jobs: array::Array<UnitJob>,
}

fn clone_jobs(allocator: Allocator, jobs: &array::Array<UnitJob>) -> !UnitJobs {
    var copies = array::new<UnitJob>(allocator);
    errdefer copies.deinit(allocator);
    var index = 0;
    while jobs.at(index) |job| {
        index = index + 1;
        let toolchain = job.toolchain.as_bytes();
        let response = job.response.as_bytes();
        let toolchain_copy = try string::from_bytes(allocator, toolchain);
        errdefer toolchain_copy.deinit(allocator);
        let response_copy = try string::from_bytes(allocator, response);
        errdefer response_copy.deinit(allocator);
        try copies.append(allocator, UnitJob {
            toolchain: move toolchain_copy,
            response: move response_copy,
            code: 0
        });
    }
    return UnitJobs { jobs: move copies };
}

fn compile_units(state: &var UnitJobs, part: &var []i64, index: i64) -> CompileFailure!void {
    if state.jobs.at(index) |job| {
        let toolchain = job.toolchain.as_bytes();
        let response = job.response.as_bytes();
        part[0] = try process::spawn_wait8(2, toolchain, response, "", "", "", "", "", "");
    }
    return;
}

fn module_for_linker(
    allocator: Allocator,
    target: stdtarget::Target,
    version: []u8,
    llvm_ir: &string::String,
    out: &var string::String
) -> !void {
    let text = llvm_ir.as_bytes();
    let inline_probe =
        \\"probe-stack"="inline-asm"
    ;
    let apple_probe =
        \\"probe-stack"="__chkstk_darwin"
    ;
    let size = mem::len(text);
    let at = index_of(text, inline_probe) orelse -1;
    if target == stdtarget::Target::NativeWindows and at >= 0 {
        try out.append_bytes(allocator, text[0..at]);
        return out.append_bytes(allocator, text[at + mem::len(inline_probe) + 1..size]);
    }
    let apple = index_of(version, "Apple clang") orelse -1;
    if target != stdtarget::Target::NativeDarwin or apple < 0 or at < 0 {
        return out.append_bytes(allocator, text);
    }
    try out.append_bytes(allocator, text[0..at]);
    try out.append_bytes(allocator, apple_probe);
    return out.append_bytes(allocator, text[at + mem::len(inline_probe)..size]);
}

fn linker_version(
    allocator: Allocator,
    options: &Options,
    arm64: bool,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    let name = try driver(allocator, options, arm64);
    defer name.deinit(allocator);
    let linker = name.as_bytes();
    var answer = string::new(allocator);
    defer answer.deinit(allocator);
    let code = try process::spawn_output8(allocator, &var answer, 2, linker, "--version", "", "", "", "", "", "");
    if code != 0 {
        var status = string::new(allocator);
        defer status.deinit(allocator);
        try status.append_bytes(allocator, " --version failed: exit status ");
        try fmt::append_i64(allocator, &var status, code);
        let status_bytes = status.as_bytes();
        return try fail_parts(allocator, "native error: ", linker, status_bytes);
    }
    let text = answer.as_bytes();
    var end = 0;
    while end < mem::len(text) and text[end] != cast<u8>(10) {
        end = end + 1;
    }
    while end > 0 and is_trimmed(text[end - 1]) {
        end = end - 1;
    }
    var start = 0;
    while start < end and is_trimmed(text[start]) {
        start = start + 1;
    }
    try out.append_bytes(allocator, text[start..end]);
    return null;
}

fn is_trimmed(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9) or byte == cast<u8>(13);
}

pub fn validate_thinlto(allocator: Allocator, options: &Options) -> !?diagnostic::Diagnostic {
    if !options.thinlto {
        return null;
    }
    if !options.opt {
        return try fail_parts(allocator, "native error: --thinlto links an optimized build; add --opt", "", "");
    }
    let emit = options.emit.as_bytes();
    if !mem::equal_bytes(emit, "exe") {
        return try fail_parts(allocator,
            "native error: --thinlto makes the code when an executable is linked; build --emit exe", "", "");
    }
    if options.target == stdtarget::Target::NativeDarwin {
        return null;
    }
    if options.target == stdtarget::Target::NativeLinux {
        let name = try driver(allocator, options, false);
        defer name.deinit(allocator);
        let linker = name.as_bytes();
        var answer = string::new(allocator);
        defer answer.deinit(allocator);
        let code = try process::spawn_output8(allocator, &var answer, 3, linker, "-fuse-ld=lld", "-Wl,--version", "", "", "", "", "");
        if code != 0 {
            var message = try string::from_bytes(allocator, "native error: --thinlto links with lld on Linux, and ");
            defer message.deinit(allocator);
            try message.append_bytes(allocator, linker);
            try message.append_bytes(allocator, " -fuse-ld=lld found none: exit status ");
            try fmt::append_i64(allocator, &var message, code);
            let message_bytes = message.as_bytes();
            return try fail_parts(allocator, message_bytes, "", "");
        }
        return null;
    }
    let os = stdtarget::os_name(options.target);
    return try fail_parts(allocator, "native error: --thinlto is not supported for ", os, " yet");
}

fn thinlto_compile_flags(
    allocator: Allocator,
    options: &Options,
    out: &var array::Array<string::String>
) -> !void {
    if options.thinlto {
        try append_copy(allocator, out, "-flto=thin");
    }
    return;
}

fn thinlto_codegen_flags(
    allocator: Allocator,
    options: &Options,
    arm64: bool,
    out: &var array::Array<string::String>
) -> !void {
    if !options.thinlto {
        return;
    }
    try append_copy(allocator, out, "-flto=thin");
    if options.target == stdtarget::Target::NativeLinux {
        try append_copy(allocator, out, "-fuse-ld=lld");
    }
    try append_copy(allocator, out, "-Wl,-mllvm,-enable-tail-merge=false");
    try append_copy(allocator, out, "-Wl,-mllvm,-align-loops=32");
    if arm64 {
        try append_copy(allocator, out, "-Wl,-mllvm,-force-target-max-vector-interleave=4");
    }
    return;
}

fn thinlto_link_flags(
    allocator: Allocator,
    options: &Options,
    arm64: bool,
    cache_dir: []u8,
    out: &var array::Array<string::String>
) -> !void {
    if !options.thinlto {
        return;
    }
    try thinlto_codegen_flags(allocator, options, arm64, out);
    let dir = try path::join(allocator, cache_dir, "thinlto");
    defer dir.deinit(allocator);
    var flag = string::new(allocator);
    defer flag.deinit(allocator);
    if options.target == stdtarget::Target::NativeLinux {
        try flag.append_bytes(allocator, "-Wl,--thinlto-cache-dir=");
    } else {
        try flag.append_bytes(allocator, "-Wl,-cache_path_lto,");
    }
    try flag.append_string(allocator, &dir);
    let flag_bytes = flag.as_bytes();
    return append_copy(allocator, out, flag_bytes);
}

fn validate_options(
    allocator: Allocator,
    options: &Options
) -> !?diagnostic::Diagnostic {
    let libc = options.libc.as_bytes();
    if !mem::equal_bytes(libc, "on") {
        return try fail_parts(allocator, "native error: --libc ", libc, " is not implemented yet");
    }
    let runtime_mode = options.runtime.as_bytes();
    if !mem::equal_bytes(runtime_mode, "hosted") {
        return try fail_parts(allocator, "native error: --runtime ", runtime_mode, " is not implemented yet");
    }
    let emit = options.emit.as_bytes();
    if mem::equal_bytes(emit, "unit-obj") {
        if !options.direct {
            return try fail_parts(allocator, "native error: --emit unit-obj writes the object of --backend direct", "", "");
        }
    } else if !mem::equal_bytes(emit, "exe") and !mem::equal_bytes(emit, "obj") {
        return try fail_parts(allocator, "native error: --emit ", emit, " is not implemented yet");
    }
    if options.cpu.len() != 0 {
        return try fail_parts(allocator, "native error: --cpu is not implemented yet", "", "");
    }
    if options.abi.len() != 0 {
        return try fail_parts(allocator, "native error: --abi is not implemented yet", "", "");
    }
    let linker = options.linker.as_bytes();
    if direct_tools(options) {
        if try validate_tools(allocator, options) |failed| {
            return move failed;
        }
    } else if !mem::equal_bytes(linker, "clang") {
        return try fail_parts(allocator, "native error: --linker ", linker, " is not implemented yet");
    }
    if options.frameworks.at(0) |framework| {
        if options.target != stdtarget::Target::NativeDarwin {
            var message = string::new(allocator);
            defer message.deinit(allocator);
            try message.append_bytes(allocator, "native error: @link_framework(");
            let framework_bytes = framework.as_bytes();
            try fmt::append_bytes_literal(allocator, &var message, framework_bytes);
            try message.append_bytes(allocator, ") needs a Darwin target");
            let message_bytes = message.as_bytes();
            return try fail_parts(allocator, message_bytes, "", "");
        }
    }
    return null;
}

fn runtime_source_for(
    allocator: Allocator,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    if try require_runtime_error_sets(allocator, sets) |failed| {
        return move failed;
    }
    try error_set_constants(allocator, sets, out);
    try out.append_bytes(allocator, runtime_source());
    return null;
}

fn runtime_object(
    io: Io,
    allocator: Allocator,
    temps: &var TempDirs,
    cache: &var buildcache::Cache,
    options: &Options,
    host: &string::String,
    source: &string::String,
    version: []u8,
    out: &var string::String
) -> !?diagnostic::Diagnostic {
    var target_spelling = string::new(allocator);
    defer target_spelling.deinit(allocator);
    try runtime_cache_target(allocator, options, host, version, &var target_spelling);
    let target_bytes = target_spelling.as_bytes();
    let source_bytes = source.as_bytes();
    let plan = try cache.get_or_build_artifact(
        io,
        allocator,
        "native-runtime.c",
        target_bytes,
        source_bytes,
        out
    );
    match plan {
        Hit => {
            return null;
        },
        Miss(pending) => {
            errdefer pending.deinit(allocator);
            var scratch_copy = string::new(allocator);
            defer scratch_copy.deinit(allocator);
            try scratch_copy.append_string(allocator, &pending.scratch);
            let dir = try temps.claim_dir(io, allocator);
            defer dir.deinit(allocator);
            let dir_bytes = dir.as_bytes();
            let scratch_bytes = scratch_copy.as_bytes();
            if try compile_runtime(io, allocator, dir_bytes, source, scratch_bytes, options, target_is_arm64(options, host)) |failed| {
                errdefer failed.deinit(allocator);
                try cache.discard_artifact(io, allocator, move pending);
                try clean_build_dir(io, allocator, dir_bytes);
                return move failed;
            }
            try cache.finish_artifact(io, allocator, move pending);
            try clean_build_dir(io, allocator, dir_bytes);
            return null;
        },
    }
}

fn compile_runtime(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    source: &string::String,
    object: []u8,
    options: &Options,
    arm64: bool
) -> !?diagnostic::Diagnostic {
    let source_path = try path::join(allocator, dir, "runtime.c");
    defer source_path.deinit(allocator);
    let source_bytes = source_path.as_bytes();
    let text = source.as_bytes();
    try fs::write_file(io, source_bytes, text);
    var command = array::new<string::String>(allocator);
    defer command.deinit(allocator);
    let name = try driver(allocator, options, arm64);
    try command.append(allocator, move name);
    try clang_flags(allocator, options, arm64, &var command);
    try append_copy(allocator, &var command, "-c");
    try append_copy(allocator, &var command, source_bytes);
    try append_copy(allocator, &var command, "-o");
    try append_copy(allocator, &var command, object);
    return spawn_clang(io, allocator, dir, &command);
}

fn spawn_clang(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    command: &array::Array<string::String>
) -> !?diagnostic::Diagnostic {
    let args_path = try path::join(allocator, dir, "clang.args");
    defer args_path.deinit(allocator);
    let args_bytes = args_path.as_bytes();
    let response = try write_response(io, allocator, args_bytes, command);
    defer response.deinit(allocator);
    let response_bytes = response.as_bytes();
    if command.at(0) |toolchain| {
        let linker = toolchain.as_bytes();
        let code = try process::spawn_wait8(2, linker, response_bytes, "", "", "", "", "", "");
        if code != 0 {
            return try fail_linker(allocator, linker, code);
        }
    }
    return null;
}

fn write_response(
    io: Io,
    allocator: Allocator,
    args_path: []u8,
    command: &array::Array<string::String>
) -> !string::String {
    var words = string::new(allocator);
    defer words.deinit(allocator);
    var index = 1;
    while command.at(index) |part| {
        index = index + 1;
        let bytes = part.as_bytes();
        try append_quoted_word(allocator, &var words, bytes);
        try words.append_byte(allocator, cast<u8>(10));
    }
    let words_bytes = words.as_bytes();
    try fs::write_file(io, args_path, words_bytes);
    var response = try string::from_bytes(allocator, "@");
    errdefer response.deinit(allocator);
    try response.append_bytes(allocator, args_path);
    return move response;
}

fn append_quoted_word(allocator: Allocator, out: &var string::String, bytes: []u8) -> !void {
    try out.append_byte(allocator, cast<u8>(39));
    var index = 0;
    while index < mem::len(bytes) {
        let byte = bytes[index];
        index = index + 1;
        if byte == cast<u8>(39) {
            try out.append_bytes(allocator, "'\''");
        } else if byte == cast<u8>(92) {
            try out.append_bytes(allocator, "\\");
        } else {
            try out.append_byte(allocator, byte);
        }
    }
    return out.append_byte(allocator, cast<u8>(39));
}

fn require_runtime_error_sets(
    allocator: Allocator,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>
) -> !?diagnostic::Diagnostic {
    if try require_error_set(allocator, sets, "std::coro::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::crypto::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::fs::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::io::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::net::Error") |failed| {
        return move failed;
    }
    if try require_error_set(allocator, sets, "std::process::Error") |failed| {
        return move failed;
    }
    return require_error_set(allocator, sets, "std::thread::Error");
}

fn require_error_set(
    allocator: Allocator,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>,
    name: []u8
) -> !?diagnostic::Diagnostic {
    if sets.at(name) |members| {
        if members.len() > 0 {
            return null;
        }
    }
    return try fail_parts(allocator, "native error: error set `", name, "` is missing");
}

fn error_set_constants(
    allocator: Allocator,
    sets: &map::Map<[]u8, map::Map<[]u8, i64>>,
    out: &var string::String
) -> !void {
    if sets.len() == 0 {
        return;
    }
    var names = array::new<string::String>(allocator);
    defer names.deinit(allocator);
    try sorted_keys<map::Map<[]u8, i64>>(allocator, sets, &var names);
    try out.append_bytes(allocator, "/* Generated from the error set declarations. */");
    try out.append_byte(allocator, cast<u8>(10));
    var index = 0;
    while names.at(index) |name| {
        index = index + 1;
        let name_bytes = name.as_bytes();
        if sets.at(name_bytes) |members| {
            var spellings = array::new<string::String>(allocator);
            defer spellings.deinit(allocator);
            try sorted_keys<i64>(allocator, members, &var spellings);
            var spelling_index = 0;
            while spellings.at(spelling_index) |member| {
                spelling_index = spelling_index + 1;
                let member_bytes = member.as_bytes();
                let code = members.get(member_bytes) orelse 0;
                try out.append_bytes(allocator, "#define ");
                try append_error_constant(allocator, name_bytes, member_bytes, out);
                try out.append_bytes(allocator, " ");
                try fmt::append_i64(allocator, out, code);
                try out.append_byte(allocator, cast<u8>(10));
            }
        }
    }
    try out.append_byte(allocator, cast<u8>(10));
    return;
}

fn sorted_keys<V>(
    allocator: Allocator,
    source: &map::Map<[]u8, V>,
    out: &var array::Array<string::String>
) -> !void {
    var index = 0;
    while source.key_at(index) |key| {
        index = index + 1;
        let name = try string::from_bytes(allocator, key);
        try out.append(allocator, move name);
    }
    return sort::strings(out);
}

fn append_error_constant(allocator: Allocator, set: []u8, member: []u8, out: &var string::String) -> !void {
    try out.append_bytes(allocator, "KIZU_ERR_");
    var index = 0;
    while index < mem::len(set) {
        let byte = set[index];
        index = index + 1;
        if byte == cast<u8>(46) or (byte == cast<u8>(58) and index < mem::len(set) and set[index] == cast<u8>(58)) {
            if byte == cast<u8>(58) {
                index = index + 1;
            }
            try out.append_byte(allocator, cast<u8>(95));
            continue;
        }
        try append_upper_byte(allocator, out, byte);
    }
    try out.append_byte(allocator, cast<u8>(95));
    let snake = try camel_to_snake(allocator, member);
    defer snake.deinit(allocator);
    let total = snake.len();
    index = 0;
    while index < total {
        let snake_bytes = snake.as_bytes();
        let byte = snake_bytes[index];
        index = index + 1;
        try append_upper_byte(allocator, out, byte);
    }
    return;
}

fn append_upper_byte(allocator: Allocator, out: &var string::String, byte: u8) -> !void {
    if byte >= cast<u8>(97) and byte <= cast<u8>(122) {
        return out.append_byte(allocator, byte - cast<u8>(32));
    }
    return out.append_byte(allocator, byte);
}

fn camel_to_snake(allocator: Allocator, name: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while index < mem::len(name) {
        let byte = name[index];
        if index > 0 and byte >= cast<u8>(65) and byte <= cast<u8>(90) {
            try out.append_byte(allocator, cast<u8>(95));
        }
        try out.append_byte(allocator, byte);
        index = index + 1;
    }
    return move out;
}

fn run_clang(
    io: Io,
    allocator: Allocator,
    dir: []u8,
    cache_dir: []u8,
    options: &Options,
    arm64: bool,
    inputs: &array::Array<string::String>,
    runtime_path: []u8,
    output: []u8,
    command: &var array::Array<string::String>
) -> !?diagnostic::Diagnostic {
    let name = try driver(allocator, options, arm64);
    try command.append(allocator, move name);
    try clang_flags(allocator, options, arm64, command);
    let emit = options.emit.as_bytes();
    let object = mem::equal_bytes(emit, "obj");
    if object {
        try append_copy(allocator, command, "-r");
        try append_copy(allocator, command, "-nostdlib");
    }
    try append_copy(allocator, command, "-Wno-override-module");
    try thinlto_link_flags(allocator, options, arm64, cache_dir, command);
    var input_index = 0;
    while inputs.at(input_index) |input| {
        input_index = input_index + 1;
        let input_bytes = input.as_bytes();
        try append_copy(allocator, command, input_bytes);
    }
    try append_copy(allocator, command, runtime_path);
    try append_copy(allocator, command, "-o");
    var linked = try string::from_bytes(allocator, output);
    defer linked.deinit(allocator);
    if options.target == stdtarget::Target::NativeWindows and !object and
        mem::len(path::extension(output)) == 0 {
        try linked.append_bytes(allocator, ".exe");
    }
    let linked_bytes = linked.as_bytes();
    try append_copy(allocator, command, linked_bytes);
    if !object {
        try link_flags(allocator, options, command);
    }
    if try spawn_clang(io, allocator, dir, command) |failed| {
        return move failed;
    }
    if !mem::equal_bytes(linked_bytes, output) {
        try fs::rename(io, linked_bytes, output);
    }
    return null;
}

fn link_flags(
    allocator: Allocator,
    options: &Options,
    out: &var array::Array<string::String>
) -> !void {
    let windows = options.target == stdtarget::Target::NativeWindows;
    if windows {
        try append_copy(allocator, out, "-static");
        try append_copy(allocator, out, "-Wl,--stack,8388608");
    }
    if options.target == stdtarget::Target::NativeDarwin {
        try append_copy(allocator, out, "-Wl,-reproducible");
    }
    try append_prefixed(allocator, "-L", &options.library_search, out);
    try append_prefixed(allocator, "-F", &options.framework_search, out);
    try append_prefixed(allocator, "-l", &options.libraries, out);
    var index = 0;
    while options.frameworks.at(index) |framework| {
        index = index + 1;
        try append_copy(allocator, out, "-framework");
        let framework_bytes = framework.as_bytes();
        try append_copy(allocator, out, framework_bytes);
    }
    try append_runtime_library(allocator, options, "m", "-lm", out);
    try append_runtime_library(allocator, options, "pthread", "-lpthread", out);
    if windows {
        try append_runtime_library(allocator, options, "ws2_32", "-lws2_32", out);
        try append_runtime_library(allocator, options, "bcrypt", "-lbcrypt", out);
    }
    return;
}

fn append_runtime_library(
    allocator: Allocator,
    options: &Options,
    name: []u8,
    flag: []u8,
    out: &var array::Array<string::String>
) -> !void {
    var index = 0;
    while options.libraries.at(index) |library| {
        index = index + 1;
        let library_bytes = library.as_bytes();
        if mem::equal_bytes(library_bytes, name) {
            return;
        }
    }
    return append_copy(allocator, out, flag);
}

fn append_prefixed(
    allocator: Allocator,
    prefix: []u8,
    values: &array::Array<string::String>,
    out: &var array::Array<string::String>
) -> !void {
    var index = 0;
    while values.at(index) |value| {
        index = index + 1;
        var flag = try string::from_bytes(allocator, prefix);
        errdefer flag.deinit(allocator);
        try flag.append_string(allocator, value);
        try out.append(allocator, move flag);
    }
    return;
}

fn clang_flags(
    allocator: Allocator,
    options: &Options,
    arm64: bool,
    out: &var array::Array<string::String>
) -> !void {
    if options.triple.len() > 0 {
        try append_copy(allocator, out, "-target");
        let triple = options.triple.as_bytes();
        try append_copy(allocator, out, triple);
    }
    return clang_optimization_flags(allocator, options.opt, arm64, out);
}

fn clang_optimization_flags(
    allocator: Allocator,
    opt: bool,
    arm64: bool,
    out: &var array::Array<string::String>
) -> !void {
    if !opt {
        return append_copy(allocator, out, "-O0");
    }
    try append_copy(allocator, out, "-O3");
    try append_copy(allocator, out, "-falign-loops=32");
    try append_copy(allocator, out, "-Xclang");
    try append_copy(allocator, out, "-mllvm");
    try append_copy(allocator, out, "-Xclang");
    try append_copy(allocator, out, "-enable-tail-merge=false");
    if arm64 {
        try append_copy(allocator, out, "-Xclang");
        try append_copy(allocator, out, "-target-feature");
        try append_copy(allocator, out, "-Xclang");
        try append_copy(allocator, out, "-fuse-literals");
        try append_copy(allocator, out, "-Xclang");
        try append_copy(allocator, out, "-mllvm");
        try append_copy(allocator, out, "-Xclang");
        try append_copy(allocator, out, "-force-target-max-vector-interleave=4");
    }
    return;
}

fn append_copy(
    allocator: Allocator,
    command: &var array::Array<string::String>,
    bytes: []u8
) -> !void {
    let value = try string::from_bytes(allocator, bytes);
    try command.append(allocator, move value);
    return;
}

fn fail_linker(allocator: Allocator, linker: []u8, code: i64) -> !diagnostic::Diagnostic {
    var message = try string::from_bytes(allocator, "native error: ");
    defer message.deinit(allocator);
    try message.append_bytes(allocator, linker);
    try message.append_bytes(allocator, " failed: exit status ");
    try fmt::append_i64(allocator, &var message, code);
    let text = message.as_bytes();
    return diagnostic::from_text(allocator, diagnostic::Severity::Error, ast::zero_span(), text);
}

fn fail_parts(allocator: Allocator, before: []u8, value: []u8, after: []u8) -> !diagnostic::Diagnostic {
    var message = try string::from_bytes(allocator, before);
    defer message.deinit(allocator);
    try message.append_bytes(allocator, value);
    try message.append_bytes(allocator, after);
    let text = message.as_bytes();
    return diagnostic::from_text(allocator, diagnostic::Severity::Error, ast::zero_span(), text);
}

fn optimization_mode_name(options: &Options) -> []u8 {
    if options.thinlto {
        return "opt-thinlto";
    }
    if options.opt {
        return "opt";
    }
    return "debug";
}

fn write_metadata(
    io: Io,
    allocator: Allocator,
    options: &Options,
    command: &array::Array<string::String>
) -> !void {
    var encoder = json::encoder_with_spaces(allocator, 2);
    defer encoder.deinit(allocator);
    try encoder.begin_object();
    try encoder.write_bytes_field("target", "native");
    try write_field(&var encoder, "triple", &options.triple);
    try write_field(&var encoder, "cpu", &options.cpu);
    try write_field(&var encoder, "abi", &options.abi);
    try write_field(&var encoder, "libc", &options.libc);
    try write_field(&var encoder, "runtime", &options.runtime);
    try write_field(&var encoder, "emit", &options.emit);
    try write_field(&var encoder, "linker", &options.linker);
    let mode = optimization_mode_name(options);
    try encoder.write_bytes_field("optimization_mode", mode);
    try write_field(&var encoder, "output", &options.output);
    try write_list_field(&var encoder, "command", command);
    try write_list_field(&var encoder, "libraries", &options.libraries);
    try write_list_field(&var encoder, "frameworks", &options.frameworks);
    try write_list_field(&var encoder, "library_search", &options.library_search);
    try write_list_field(&var encoder, "framework_search", &options.framework_search);
    try encoder.end_object();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(allocator, &var out);
    try out.append_byte(allocator, cast<u8>(10));
    var target = string::new(allocator);
    defer target.deinit(allocator);
    try target.append_string(allocator, &options.output);
    try target.append_bytes(allocator, ".kizu-build.json");
    let target_bytes = target.as_bytes();
    let text = out.as_bytes();
    try fs::write_file(io, target_bytes, text);
    return;
}

fn write_list_field(
    encoder: &var json::Encoder,
    name: []u8,
    values: &array::Array<string::String>
) -> !void {
    if values.len() == 0 {
        return encoder.write_null_field(name);
    }
    try encoder.begin_array_field(name);
    var index = 0;
    while values.at(index) |value| {
        index = index + 1;
        let value_bytes = value.as_bytes();
        try encoder.write_bytes(value_bytes);
    }
    return encoder.end_array();
}

fn write_field(encoder: &var json::Encoder, name: []u8, value: &string::String) -> !void {
    let bytes = value.as_bytes();
    return encoder.write_bytes_field(name, bytes);
}
