import compiler::internal::stdtarget;
import std::mem;
import std::testing;

fn expect_target(triple: []u8, want: stdtarget::Target) -> !void {
    let allocator = mem::page_allocator();
    var got = stdtarget::Target::WasmWasi;
    if try target_for(allocator, triple, &var got) |failed| {
        defer failed.deinit(allocator);
        testing::fail("a supported triple was refused");
        return;
    }
    testing::expect(got == want);
    return;
}

test "target_for maps the OS a triple names to its native target" {
    try expect_target("arm64-apple-darwin", stdtarget::Target::NativeDarwin);
    try expect_target("x86_64-apple-macos", stdtarget::Target::NativeDarwin);
    try expect_target("arm64-apple-ios17.0", stdtarget::Target::NativeDarwin);
    try expect_target("arm64-apple-ios17.0-simulator", stdtarget::Target::NativeDarwin);
    try expect_target("x86_64-unknown-linux-gnu", stdtarget::Target::NativeLinux);
    try expect_target("x86_64-w64-windows-gnu", stdtarget::Target::NativeWindows);
    try expect_target("x86_64-w64-mingw32", stdtarget::Target::NativeWindows);
}

fn expect_refused(triple: []u8) -> !void {
    let allocator = mem::page_allocator();
    var got = stdtarget::Target::WasmWasi;
    if try target_for(allocator, triple, &var got) |failed| {
        defer failed.deinit(allocator);
        return;
    }
    testing::fail("an unsupported triple was accepted");
    return;
}

test "target_for refuses a triple for an OS the runtime has no build for" {
    try expect_refused("x86_64-unknown-freebsd");
    try expect_refused("x86_64-pc-windows-msvc");
}
