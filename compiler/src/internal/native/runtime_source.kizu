        \\/* std::net is a thin, honest layer over the POSIX stream socket calls. A
        \\ * listener and a stream are each one descriptor; the Kizu side keeps it in a
        \\ * private field, so a program reaches a socket only through the two owners
        \\ * std::net declares. Everything above -- splitting host from port, framing
        \\ * HTTP -- is Kizu source, because it can be. */
        \\
        \\/* A descriptor is an int on every host here, so a negative value is not one.
        \\ * The Kizu owners set their field to this when they release, which is what
        \\ * makes a use after deinit a named failure rather than a read of a descriptor
        \\ * the process has since handed to something else. */
        \\#define KIZU_NET_CLOSED_FD INT64_C(-1)
        \\
        \\/* The listen backlog. Nothing above chooses it: with one connection served at
        \\ * a time, the queue is what keeps a caller from being refused while the
        \\ * previous one is answered, and 128 is what the platform defaults settled on. */
        \\#define KIZU_NET_BACKLOG 128
        \\
        \\/* How much of a body one send may be handed. Small enough that a peer which
        \\ * stopped reading cannot hold the caller past its deadline by more than this,
        \\ * and large enough that a body which fits goes in one call. */
        \\#define KIZU_NET_WRITE_CHUNK INT64_C(65536)
        \\
        \\static int64_t kizu_net_errno_failure(int code) {
        \\    switch (code) {
        \\    case EADDRINUSE:
        \\        return KIZU_ERR_STD_NET_ERROR_ADDRESS_IN_USE;
        \\    case EACCES:
        \\    case EPERM:
        \\        return KIZU_ERR_STD_NET_ERROR_PERMISSION_DENIED;
        \\    case ECONNREFUSED:
        \\        return KIZU_ERR_STD_NET_ERROR_CONNECTION_REFUSED;
        \\    case ECONNRESET:
        \\    case EPIPE:
        \\    case ENOTCONN:
        \\        return KIZU_ERR_STD_NET_ERROR_CONNECTION_RESET;
        \\    case EMFILE:
        \\    case ENFILE:
        \\        return KIZU_ERR_STD_NET_ERROR_TOO_MANY_OPEN_FILES;
        \\    case ETIMEDOUT:
        \\        return KIZU_ERR_STD_NET_ERROR_TIMED_OUT;
        \\    case EADDRNOTAVAIL:
        \\    case EAFNOSUPPORT:
        \\        return KIZU_ERR_STD_NET_ERROR_INVALID_ADDRESS;
        \\    case ENOMEM:
        \\        return KIZU_ERR_STD_NET_ERROR_OUT_OF_MEMORY;
        \\    default:
        \\        return KIZU_ERR_STD_NET_ERROR_OPERATION_FAILED;
        \\    }
        \\}
        \\
        \\/* A deadline is a moment to be finished by, not a budget each syscall gets
        \\ * back. That distinction is the whole point: a peer that sends one byte every
        \\ * four seconds never trips a four-second-per-recv timeout, but it does run out
        \\ * of a deadline. The Kizu side owns the moment and hands down what is left of
        \\ * it; these turn that into what poll wants.
        \\ *
        \\ * A negative budget means no deadline, which is what every call did before
        \\ * deadlines existed and what a stream that has not set one still does. */
        \\#define KIZU_NET_NO_DEADLINE INT64_C(-1)
        \\#define KIZU_NET_WAIT_READY INT64_C(0)
        \\#define KIZU_NET_WAIT_RETRY INT64_C(-1)
        \\
        \\/* Every socket this module hands out is non-blocking, and the waiting happens
        \\ * in poll rather than in the syscall. That is what makes a deadline exact: a
        \\ * blocking send does not come back after a partial write, it blocks until
        \\ * everything it was handed is accepted, and MSG_DONTWAIT does not change that
        \\ * on Darwin. A caller with a deadline would sit in one send past it.
        \\ *
        \\ * Nothing above sees this. Without a deadline the poll waits forever, which is
        \\ * the blocking behaviour the API already promised. */
        \\static void kizu_net_set_nonblocking(int fd) {
        \\    int flags = fcntl(fd, F_GETFL, 0);
        \\    if (flags < 0) {
        \\        return;
        \\    }
        \\    fcntl(fd, F_SETFL, flags | O_NONBLOCK);
        \\}
        \\
        \\static int64_t kizu_net_deadline(int64_t timeout_ms) {
        \\    if (timeout_ms < 0) {
        \\        return KIZU_NET_NO_DEADLINE;
        \\    }
        \\    return kizu_monotonic_millis() + timeout_ms;
        \\}
        \\
        \\/* What is left of a deadline, floored at zero: an expired one still asks, it
        \\ * just does not wait. Recomputing this per attempt is what keeps a retry from
        \\ * handing the budget back. */
        \\static int64_t kizu_net_remaining(int64_t deadline) {
        \\    if (deadline < 0) {
        \\        return KIZU_NET_NO_DEADLINE;
        \\    }
        \\    int64_t left = deadline - kizu_monotonic_millis();
        \\    return left < 0 ? 0 : left;
        \\}
