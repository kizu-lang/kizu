        \\static KizuErrorI64 kizu_std_builtin_net_listen_result(
        \\    void *io,
        \\    KizuSliceU8 host,
        \\    int64_t port
        \\) {
        \\    if (kizu_io_is_failing(io)) {
        \\        return kizu_err_i64(KIZU_ERR_STD_NET_ERROR_IO_FAILING);
