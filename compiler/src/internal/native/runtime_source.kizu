        \\
        \\/* An evented Io answers this instead of poll: the call gives the thread back
        \\ * and the loop returns to it when the descriptor is ready. Defined with the
        \\ * loop below, because it needs the coroutine the call is standing on. */
        \\static int kizu_loop_park_io(
        \\    void *io, int fd, short events, int64_t remaining, int64_t *out);
