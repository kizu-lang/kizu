        \\    if (kizu_loop_park_io(io, fd, events, remaining, &parked)) {
        \\        return parked;
        \\    }
        \\    int budget = -1;
        \\    if (remaining >= 0) {
        \\        budget = remaining > INT32_MAX ? INT32_MAX : (int)remaining;
        \\    }
        \\    struct pollfd pfd;
        \\    pfd.fd = fd;
        \\    pfd.events = events;
        \\    pfd.revents = 0;
        \\    int ready = poll(&pfd, 1, budget);
        \\    if (ready > 0) {
        \\        return KIZU_NET_WAIT_READY;
        \\    }
        \\    if (ready == 0) {
        \\        return KIZU_ERR_STD_NET_ERROR_TIMED_OUT;
        \\    }
        \\    if (errno == EINTR) {
        \\        return KIZU_NET_WAIT_RETRY;
        \\    }
        \\    return kizu_net_errno_failure(errno);
        \\}
        \\
        \\/* would_block reports the two spellings a non-blocking syscall uses for
        \\ * "nothing right now", which is the poll's answer to give, not the caller's. */
        \\static int kizu_net_would_block(int code) {
        \\    return code == EAGAIN || code == EWOULDBLOCK;
        \\}
        \\
        \\/* kizu_net_resolve turns a host and a port into the address list to try, and
        \\ * returns 0 or the failure to report. An empty host means the wildcard for a
        \\ * listener and the loopback for a connect, which is what getaddrinfo already
        \\ * says with AI_PASSIVE and a null node. */
        \\static int64_t kizu_net_resolve(
        \\    KizuSliceU8 host,
        \\    int64_t port,
        \\    int passive,
        \\    struct addrinfo **out
        \\) {
        \\    *out = NULL;
        \\    if (port < 0 || port > 65535) {
        \\        return KIZU_ERR_STD_NET_ERROR_INVALID_ADDRESS;
        \\    }
        \\    char service[8];
        \\    snprintf(service, sizeof service, "%d", (int)port);
        \\    char *node = NULL;
        \\    if (host.len > 0) {
        \\        node = kizu_slice_to_cstr(host);
        \\        if (!node) {
        \\            return KIZU_ERR_STD_NET_ERROR_OUT_OF_MEMORY;
        \\        }
        \\    }
        \\    struct addrinfo hints;
        \\    memset(&hints, 0, sizeof hints);
        \\    hints.ai_family = AF_UNSPEC;
        \\    hints.ai_socktype = SOCK_STREAM;
        \\    if (passive) {
        \\        hints.ai_flags = AI_PASSIVE;
        \\    }
        \\    int code = getaddrinfo(node, service, &hints, out);
        \\    free(node);
        \\    if (code != 0) {
        \\        *out = NULL;
        \\        if (code == EAI_MEMORY) {
        \\            return KIZU_ERR_STD_NET_ERROR_OUT_OF_MEMORY;
        \\        }
        \\        return KIZU_ERR_STD_NET_ERROR_ADDRESS_NOT_FOUND;
        \\    }
        \\    return 0;
        \\}
