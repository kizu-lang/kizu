        \\ * `io` is here because the waiting is what an Io implementation differs in.
        \\ * Everything above this reaches the network through one of the four calls that
        \\ * wait, so this is the one place an evented Io has to change. */
        \\static int64_t kizu_net_wait(void *io, int fd, short events, int64_t remaining) {
