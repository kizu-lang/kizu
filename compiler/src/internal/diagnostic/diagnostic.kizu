import compiler::internal::ast;
import compiler::internal::source;
import std::array;
import std::fmt;
import std::mem;
import std::string;

// Mechanical port of internal/diagnostic. A Diagnostic owns its structured
// text; rendering borrows the invocation SourceMap because SourceId is the
// copyable integer half of that ownership pair in Kizu.

/// Identifies whether a diagnostic blocks compilation or is advisory.
pub enum Severity {
    Error,
    Warning,
}

/// Carries structured diagnostic data shared by CLI and LSP renderers.
pub struct Diagnostic {
    pub severity: Severity,
    pub category: string::String,
    pub code: string::String,
    pub message: string::String,
    pub span: ast::Span,
    pub notes: array::Array<string::String>,
    pub help: string::String,
}

// Holds borrowed parts of one already-split input line.
struct FirstLineParts {
    severity: Severity,
    category: []u8,
    message: []u8,
}

/// Constructs one structured diagnostic from its summary fields.
pub fn new(
    allocator: Allocator,
    severity: Severity,
    category: []u8,
    span: ast::Span,
    message: []u8
) -> !Diagnostic {
    var diagnostic = Diagnostic {
        severity: severity,
        category: string::new(allocator),
        code: string::new(allocator),
        message: string::new(allocator),
        span: span,
        notes: array::new<string::String>(allocator),
        help: string::new(allocator)
    };
    errdefer diagnostic.deinit(allocator);
    try diagnostic.category.append_bytes(allocator, category);
    try diagnostic.message.append_bytes(allocator, message);
    return move diagnostic;
}

/// Parses ADR-style diagnostic text into structured fields.
pub fn from_text(
    allocator: Allocator,
    severity: Severity,
    span: ast::Span,
    text: []u8
) -> !Diagnostic {
    let length = mem::len(text);
    let first_end = line_end(text, 0);
    let parts = split_first_line(severity, text[0..first_end]);
    var diagnostic = try new(
        allocator,
        parts.severity,
        parts.category,
        span,
        parts.message
    );
    errdefer diagnostic.deinit(allocator);
    if first_end == length {
        return move diagnostic;
    }
    var start = first_end + 1;
    while start <= length {
        let end = line_end(text, start);
        try add_text_line(allocator,
            &var diagnostic,
            text[start..end]
        );
        if end == length {
            break;
        }
        start = end + 1;
    }
    return move diagnostic;
}

fn add_text_line(
    allocator: Allocator,
    diagnostic: &var Diagnostic,
    line: []u8
) -> !void {
    if mem::starts_with(line, "note: ") {
        return append_note(allocator, diagnostic, line[6..mem::len(line)]);
    }
    if mem::starts_with(line, "help: ") {
        if diagnostic.help.len() > 0 {
            try diagnostic.help.append_byte(allocator, cast<u8>(10));
        }
        return diagnostic.help.append_bytes(allocator, line[6..mem::len(line)]);
    }
    if mem::len(line) == 0 {
        return;
    }
    if diagnostic.message.len() == 0 {
        return diagnostic.message.append_bytes(allocator, line);
    }
    return append_note(allocator, diagnostic, line);
}

fn append_note(
    allocator: Allocator,
    diagnostic: &var Diagnostic,
    note: []u8
) -> !void {
    let owned = try string::from_bytes(allocator, note);
    errdefer owned.deinit(allocator);
    return diagnostic.notes.append(allocator, move owned);
}

/// Renders the ADR-0072 message form without CLI severity wrapping.
fn (self: &Diagnostic) error(
    allocator: Allocator,
    sources: &source::SourceMap
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try self.append_summary(allocator, &var out);
    if !self.span.is_zero() {
        try out.append_bytes(allocator, " at ");
        var wrote_path = false;
        if self.span.source |id| {
            wrote_path = try append_source_path(allocator, &var out, sources, id);
        }
        if wrote_path {
            try out.append_bytes(allocator, ":");
        }
        try fmt::append_i64(allocator, &var out, self.span.start.line);
        try out.append_bytes(allocator, ":");
        try fmt::append_i64(allocator, &var out, self.span.start.column);
    }
    var index = 0;
    while self.notes.at(index) |note| {
        try out.append_byte(allocator, cast<u8>(10));
        try out.append_bytes(allocator, "note: ");
        try out.append_string(allocator, note);
        index = index + 1;
    }
    if self.help.len() > 0 {
        try append_help(allocator, &var out, &self.help);
    }
    return move out;
}

fn append_source_path(allocator: Allocator,
    out: &var string::String,
    sources: &source::SourceMap,
    id: source::SourceId
) -> !bool {
    if sources.at(id) |file| {
        if file.path.len() > 0 {
            try out.append_string(allocator, &file.path);
            return true;
        }
    }
    return false;
}

fn append_help(allocator: Allocator,
    out: &var string::String,
    help: &string::String
) -> !void {
    let bytes = help.as_bytes();
    let length = mem::len(bytes);
    var start = 0;
    while start <= length {
        let end = line_end(bytes, start);
        try out.append_byte(allocator, cast<u8>(10));
        try out.append_bytes(allocator, "help: ");
        try out.append_bytes(allocator, bytes[start..end]);
        if end == length {
            break;
        }
        start = end + 1;
    }
    return;
}

/// Appends the first line without its position, the Go `summary`: the
/// category and message, or the warning and message.
fn (self: &Diagnostic) append_summary(allocator: Allocator, out: &var string::String) -> !void {
    if self.category.len() > 0 {
        try out.append_string(allocator, &self.category);
        try out.append_bytes(allocator, ": ");
    } else {
        if self.severity == Severity::Warning {
            try out.append_bytes(allocator, "warning: ");
        }
    }
    try out.append_string(allocator, &self.message);
    return;
}

/// Renders the diagnostic for a terminal (ADR-0072), the Go `CLIError`: the
/// severity and summary, then where it is -- the path and position, the
/// source line, and a marker under the span -- then the notes and help under
/// the same gutter.
fn (self: &Diagnostic) cli_error(
    allocator: Allocator,
    sources: &source::SourceMap
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    if self.severity != Severity::Warning {
        try out.append_bytes(allocator, "error: ");
    }
    try self.append_summary(allocator, &var out);
    var gutter = 0;
    if !self.span.is_zero() {
        gutter = digit_count(self.span.start.line);
        try append_snippet(allocator, &var out, sources, self.span, gutter);
    }
    var index = 0;
    while self.notes.at(index) |note| {
        try append_gutter_line(allocator, &var out, gutter, "= note: ");
        try out.append_string(allocator, note);
        index = index + 1;
    }
    if self.help.len() > 0 {
        let bytes = self.help.as_bytes();
        let length = mem::len(bytes);
        var start = 0;
        while start <= length {
            let end = line_end(bytes, start);
            try append_gutter_line(allocator, &var out, gutter, "= help: ");
            try out.append_bytes(allocator, bytes[start..end]);
            if end == length {
                break;
            }
            start = end + 1;
        }
    }
    return move out;
}

fn digit_count(value: i64) -> i64 {
    var count = 1;
    var rest = value;
    while rest >= 10 {
        rest = rest / 10;
        count = count + 1;
    }
    return count;
}

/// Starts a new line with `gutter` spaces and then `text`.
fn append_gutter_line(allocator: Allocator, out: &var string::String, gutter: i64, text: []u8) -> !void {
    try out.append_byte(allocator, cast<u8>(10));
    for 0..gutter |_i| {
        try out.append_byte(allocator, cast<u8>(32));
    }
    try out.append_bytes(allocator, text);
    return;
}

/// Writes where span is and, when its source text is at hand, the line it
/// starts on with a marker under it, the Go `writeSnippet`.
fn append_snippet(
    allocator: Allocator,
    out: &var string::String,
    sources: &source::SourceMap,
    span: ast::Span,
    gutter: i64
) -> !void {
    try append_gutter_line(allocator, out, gutter, "--> ");
    if span.source |id| {
        if sources.at(id) |file| {
            if file.path.len() > 0 {
                try out.append_string(allocator, &file.path);
                try out.append_bytes(allocator, ":");
            }
            try append_position(allocator, out, span);
            let text = file.text.as_bytes();
            return append_source_line(allocator, out, text, span, gutter);
        }
    }
    return append_position(allocator, out, span);
}

fn append_position(allocator: Allocator, out: &var string::String, span: ast::Span) -> !void {
    try fmt::append_i64(allocator, out, span.start.line);
    try out.append_bytes(allocator, ":");
    try fmt::append_i64(allocator, out, span.start.column);
    return;
}

/// Appends the line span starts on and the marker under it, when text has it.
fn append_source_line(
    allocator: Allocator,
    out: &var string::String,
    text: []u8,
    span: ast::Span,
    gutter: i64
) -> !void {
    let line = source_line(text, span.start.line) orelse return;
    try append_gutter_line(allocator, out, gutter, " |");
    try out.append_byte(allocator, cast<u8>(10));
    try fmt::append_i64(allocator, out, span.start.line);
    try out.append_bytes(allocator, " | ");
    try out.append_bytes(allocator, text[line.start..line.end]);
    try append_gutter_line(allocator, out, gutter, " | ");
    try append_marker(allocator, out, text[line.start..line.end], span);
    return;
}

/// Where one line sits in a source text, without its newline.
struct LineRange {
    start: i64,
    end: i64,
}

/// Finds the one-based line, the Go `sourceLine`.
fn source_line(text: []u8, number: i64) -> ?LineRange {
    let length = mem::len(text);
    if length == 0 or number < 1 {
        return null;
    }
    var start = 0;
    var current = 1;
    while current < number {
        let end = line_end(text, start);
        if end == length {
            return null;
        }
        start = end + 1;
        current = current + 1;
    }
    var end = line_end(text, start);
    if end > start and text[end - 1] == cast<u8>(13) {
        end = end - 1;
    }
    return LineRange { start: start, end: end };
}

/// Appends the carets under span on its first line, the Go `markerLine`.
/// Columns count bytes, so the lead-in keeps the line's tabs and gives every
/// other character one space, not one per byte; the carets cover the span on
/// that line, or to the line's last visible character when the span goes on
/// past it.
fn append_marker(allocator: Allocator, out: &var string::String, line: []u8, span: ast::Span) -> !void {
    let length = mem::len(line);
    var start = span.start.column - 1;
    if start > length {
        start = length;
    }
    if start < 0 {
        start = 0;
    }
    for 0..start |i| {
        let byte = line[i];
        if byte == cast<u8>(9) {
            try out.append_byte(allocator, byte);
        } else if (byte & cast<u8>(192)) != cast<u8>(128) {
            try out.append_byte(allocator, cast<u8>(32));
        }
    }
    var visible = length;
    while visible > start and (line[visible - 1] == cast<u8>(32) or line[visible - 1] == cast<u8>(9)) {
        visible = visible - 1;
    }
    var width = 0;
    for start..visible |i| {
        if (line[i] & cast<u8>(192)) != cast<u8>(128) {
            width = width + 1;
        }
    }
    if span.end.line == span.start.line and span.end.column > span.start.column {
        width = span.end.column - span.start.column;
    }
    if width < 1 {
        width = 1;
    }
    var rest = 0;
    for start..length |i| {
        if (line[i] & cast<u8>(192)) != cast<u8>(128) {
            rest = rest + 1;
        }
    }
    if width > rest and rest > 0 {
        width = rest;
    }
    for 0..width |_i| {
        try out.append_byte(allocator, cast<u8>(94));
    }
    return;
}

/// Returns the primary source span for the diagnostic.
fn (self: &Diagnostic) source_span() -> ast::Span {
    return self.span;
}

/// Returns the diagnostic severity for LSP and other renderers.
fn (self: &Diagnostic) severity_level() -> Severity {
    return self.severity;
}

/// Records one stable machine-readable diagnostic code.
fn (self: &var Diagnostic) with_code(allocator: Allocator, code: []u8) -> !void {
    self.code.clear();
    return self.code.append_bytes(allocator, code);
}

/// Appends one structured note line.
fn (self: &var Diagnostic) with_note(
    allocator: Allocator,
    note: []u8
) -> !void {
    return append_note(allocator, self, note);
}

/// Records one help message.
fn (self: &var Diagnostic) with_help(allocator: Allocator, help: []u8) -> !void {
    self.help.clear();
    return self.help.append_bytes(allocator, help);
}

/// Copies one diagnostic, including its notes, with allocator.
fn (self: &Diagnostic) clone(allocator: Allocator) -> !Diagnostic {
    let category = self.category.as_bytes();
    let message = self.message.as_bytes();
    var copied = try new(allocator, self.severity, category, self.span, message);
    errdefer copied.deinit(allocator);
    let code = self.code.as_bytes();
    try copied.with_code(allocator, code);
    let help = self.help.as_bytes();
    try copied.with_help(allocator, help);
    var index = 0;
    while self.notes.at(index) |note| {
        let note_bytes = note.as_bytes();
        try copied.with_note(allocator, note_bytes);
        index = index + 1;
    }
    return move copied;
}

fn split_first_line(
    default_severity: Severity,
    first: []u8
) -> FirstLineParts {
    if mem::starts_with(first, "warning: ") {
        return FirstLineParts {
            severity: Severity::Warning,
            category: "",
            message: first[9..mem::len(first)]
        };
    }
    if find_bytes(first, ": ") |index| {
        let category = first[0..index];
        if ends_with(category, "error") {
            return FirstLineParts {
                severity: default_severity,
                category: category,
                message: first[index + 2..mem::len(first)]
            };
        }
    }
    return FirstLineParts {
        severity: default_severity,
        category: "",
        message: first
    };
}

fn line_end(text: []u8, start: i64) -> i64 {
    var index = start;
    while index < mem::len(text) {
        if text[index] == cast<u8>(10) {
            return index;
        }
        index = index + 1;
    }
    return index;
}

fn find_bytes(bytes: []u8, needle: []u8) -> ?i64 {
    let needle_len = mem::len(needle);
    var index = 0;
    while index + needle_len <= mem::len(bytes) {
        if mem::equal_bytes(bytes[index..index + needle_len], needle) {
            return index;
        }
        index = index + 1;
    }
    return null;
}

fn ends_with(bytes: []u8, suffix: []u8) -> bool {
    let suffix_len = mem::len(suffix);
    let length = mem::len(bytes);
    if suffix_len > length {
        return false;
    }
    return mem::equal_bytes(bytes[length - suffix_len..length], suffix);
}

/// Gives a diagnostic that says no place the span, the Go `Locate`. A check
/// deep inside a statement often knows what is wrong but not where, and the
/// statement it is in is where to look; a diagnostic that already points
/// somewhere keeps its place.
pub fn locate(problem: Diagnostic, span: ast::Span) -> Diagnostic {
    var located = move problem;
    if located.span.is_zero() {
        located.span = span;
    }
    return move located;
}
