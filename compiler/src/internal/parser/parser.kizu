import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::lexer;
import compiler::internal::source;
import compiler::internal::token;
import compiler::internal::typ;
import std::arena;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// Mechanical port of internal/parser/parser.go. Copy handles resolve through
// a caller-owned Ast, which retains both syntax and parsed type graphs.

/// Consumes tokens and builds one source file into a caller-owned AST graph.
pub struct Parser {
    allocator: Allocator,
    scanner: lexer::Lexer,
    tokens: arena::Arena<token::Token>,
    stream: array::Array<arena::Handle<token::Token>>,
    position: i64,
    diagnostics_store: array::Array<diagnostic::Diagnostic>,
    safety: ?ast::Text
}

struct NameList {
    names: array::Array<ast::Text>,
    docs: ?map::Map<[]u8, ast::Text>
}

/// Creates a parser and primes its current and lookahead tokens.
pub fn new(allocator: Allocator, scanner: lexer::Lexer) -> !Parser {
    var input = move scanner;
    errdefer input.deinit(allocator);
    var tokens = arena::new<token::Token>(allocator);
    errdefer tokens.deinit(allocator);
    var stream = array::new<arena::Handle<token::Token>>(allocator);
    errdefer stream.deinit(allocator);
    try append_next_token(allocator, &var input, &var tokens, &var stream);
    try append_next_token(allocator, &var input, &var tokens, &var stream);
    return Parser {
        allocator: allocator,
        scanner: move input,
        tokens: move tokens,
        stream: move stream,
        position: 0,
        diagnostics_store: array::new<diagnostic::Diagnostic>(allocator),
        safety: null
    };
}

/// Renders parse errors collected so far without CLI severity wrapping.
fn (self: &Parser) errors(
    allocator: Allocator,
    sources: &source::SourceMap
) -> !array::Array<string::String> {
    var out = array::new<string::String>(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while self.diagnostics_store.at(index) |entry| {
        let rendered = try entry.error(allocator, sources);
        errdefer rendered.deinit(allocator);
        try out.append(allocator, move rendered);
        index = index + 1;
    }
    return move out;
}

/// Returns the number of structured parse diagnostics collected so far.
fn (self: &Parser) diagnostics_len() -> i64 {
    return self.diagnostics_store.len();
}

/// Borrows one structured parse diagnostic by index.
fn (self: &Parser) diagnostic(index: i64) -> ?&diagnostic::Diagnostic {
    return self.diagnostics_store.at(index);
}

fn (self: &Parser) current_token() -> &token::Token {
    let handle = self.stream.get_or_panic(self.position);
    return self.tokens.at(handle);
}

fn (self: &Parser) peek_token() -> &token::Token {
    let handle = self.stream.get_or_panic(self.position + 1);
    return self.tokens.at(handle);
}

fn (self: &Parser) current_kind() -> token::Kind {
    return self.current_token().kind;
}

fn (self: &Parser) peek_kind() -> token::Kind {
    return self.peek_token().kind;
}

fn (self: &Parser) comment_text(
    lines: &array::Array<string::String>
) -> !string::String {
    var separator_storage = [1]u8 {};
    let writable = separator_storage.as_mut_bytes();
    writable[0] = cast<u8>(10);
    let separator = separator_storage.as_bytes();
    var out = try string::join(self.allocator, lines, separator);
    string::trim_space_in_place(&var out);
    return move out;
}

fn (self: &Parser) current_comment_text() -> !string::String {
    let current = self.current_token();
    return self.comment_text(&current.doc_comments);
}

fn (self: &Parser) retain_current_literal(tree: &var ast::Ast) -> !ast::Text {
    return retain_literal(tree, self.current_token());
}

fn (self: &Parser) starts_error_set_decl() -> bool {
    return token_literal_equal(self.current_token(), "error") and
        self.peek_kind() == token::Kind::Ident;
}

/// Parses one complete source file into caller-owned declaration storage.
pub fn (self: &var Parser) parse_program(tree: &var ast::Ast) -> !ast::Program {
    let allocator = self.allocator;
    var program = ast::new_program(self.allocator);
    errdefer program.deinit(self.allocator);
    while self.current_kind() != token::Kind::Eof {
        if try self.parse_top_level_declaration(tree) |declaration| {
            try program.add_declaration(allocator, declaration);
        }
        try self.next_token();
    }
    return move program;
}

fn (self: &var Parser) parse_top_level_declaration(
    tree: &var ast::Ast
) -> !?ast::Declaration {
    let kind = self.current_kind();
    if kind == token::Kind::Import {
        return try self.parse_import_decl(tree);
    }
    if kind == token::Kind::Public {
        return try self.parse_public_decl(tree);
    }
    if kind == token::Kind::Ident {
        return try self.parse_ident_led_decl(tree);
    }
    if kind == token::Kind::Function {
        return try self.parse_function_decl(tree);
    }
    if kind == token::Kind::Unsafe {
        let docs = try self.current_comment_text();
        return try self.parse_unsafe_decl(tree, move docs, false);
    }
    if kind == token::Kind::Extern {
        return try self.parse_extern_decl(tree);
    }
    if kind == token::Kind::Export {
        return try self.parse_export_decl(tree);
    }
    if kind == token::Kind::Struct {
        return try self.parse_struct_decl(tree);
    }
    if kind == token::Kind::Enum {
        return try self.parse_enum_decl(tree);
    }
    if kind == token::Kind::Union {
        return try self.parse_union_decl(tree);
    }
    if kind == token::Kind::Contract {
        return try self.parse_contract_decl(tree, false);
    }
    if kind == token::Kind::Impl {
        return try self.parse_impl_decl(tree);
    }
    try self.error_expected_declaration();
    return null;
}

fn (self: &var Parser) parse_public_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    let docs = try self.current_comment_text();
    errdefer docs.deinit(self.allocator);
    try self.next_token();
    return self.parse_top_level_decl_with_doc(tree, move docs);
}

fn (self: &var Parser) parse_top_level_decl_with_doc(
    tree: &var ast::Ast,
    docs: string::String
) -> !ast::Declaration {
    errdefer docs.deinit(self.allocator);
    let kind = self.current_kind();
    if kind == token::Kind::Function {
        return self.parse_function_decl_with_doc(tree, move docs, true);
    }
    if kind == token::Kind::Unsafe {
        return self.parse_unsafe_decl(tree, move docs, true);
    }
    if kind == token::Kind::Extern {
        return self.parse_extern_decl_with_doc(tree, move docs, true);
    }
    if kind == token::Kind::Export {
        return self.parse_export_decl_with_doc(tree, move docs, true);
    }
    if kind == token::Kind::Struct {
        let declaration = try self.parse_struct_decl_with_doc(tree, move docs, true) orelse
            return try tree.add_recovered_declaration(token_span_at(self));
        return add_struct_decl(self.allocator, tree, move declaration);
    }
    if kind == token::Kind::Enum {
        return self.parse_enum_decl_with_doc(tree, move docs, true);
    }
    if kind == token::Kind::Union {
        return self.parse_union_decl_with_doc(tree, move docs, true);
    }
    if kind == token::Kind::Contract {
        docs.deinit(self.allocator);
        return self.parse_contract_decl(tree, true);
    }
    if kind == token::Kind::Ident and self.starts_error_set_decl() {
        return self.parse_error_set_decl_with_doc(tree, move docs, true);
    }
    try self.error_token("expected public declaration, got ", self.current_token());
    docs.deinit(self.allocator);
    return try tree.add_recovered_declaration(token_span_at(self));
}

fn (self: &var Parser) parse_import_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    var path = array::new<ast::Text>(self.allocator);
    errdefer path.deinit(self.allocator);
    if !try self.expect_peek(token::Kind::Ident) {
        path.deinit(self.allocator);
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    try path.append(self.allocator, try self.retain_current_literal(tree));
    while self.peek_kind() == token::Kind::DoubleColon {
        try self.next_token();
        if !try self.expect_peek(token::Kind::Ident) {
            path.deinit(self.allocator);
            return try tree.add_recovered_declaration(token_span_at(self));
        }
        try path.append(self.allocator, try self.retain_current_literal(tree));
    }
    let _ = try self.expect_statement_terminator("import declaration");
    return try tree.add_declaration(ast::DeclarationNode::Import(ast::ImportDecl {
        path: move path
    }));
}

// Builds the owned placeholder that declaration parsing mutates until its
// success or recovery path moves it into the Ast exactly once.
fn (self: &Parser) function_stub(
    tree: &var ast::Ast,
    public: bool,
    docs: string::String
) -> !ast::FunctionDecl {
    errdefer docs.deinit(self.allocator);
    let name = try tree.add_empty_text();
    let extern_abi = try tree.add_empty_text();
    let export_abi = try tree.add_empty_text();
    let doc = try tree.add_text(move docs);
    return ast::FunctionDecl {
        signature: ast::FunctionSignature {
            receiver: false,
            name: name,
            static_params: array::new<ast::StaticParam>(self.allocator),
            params: array::new<ast::Param>(self.allocator),
            return_type: null,
            requires_unsafe: false,
            extern_abi: extern_abi,
            export_abi: export_abi,
            public: public,
            std: false,
            span: ast::zero_span()
        },
        doc: doc,
        derived: false,
        body: null
    };
}

fn (self: &var Parser) parse_ident_led_decl(
    tree: &var ast::Ast
) -> !?ast::Declaration {
    if token_literal_equal(self.current_token(), "test") {
        return try self.parse_test_decl(tree);
    }
    if self.starts_error_set_decl() {
        return try self.parse_error_set_decl(tree);
    }
    try self.error_expected_declaration();
    return null;
}

fn (self: &var Parser) parse_test_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    if !try self.expect_peek(token::Kind::String) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let name = try self.retain_current_literal(tree);
    if !try self.expect_peek(token::Kind::LBrace) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let body = try self.parse_block_stmt(tree);
    let module = try tree.add_empty_text();
    return try tree.add_declaration(ast::DeclarationNode::Test(ast::TestDecl {
        name: name,
        body: body,
        module: module
    }));
}

fn (self: &var Parser) parse_function_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    let docs = try self.current_comment_text();
    return self.parse_function_decl_with_doc(tree, move docs, false);
}

fn (self: &var Parser) parse_function_decl_with_doc(
    tree: &var ast::Ast,
    docs: string::String,
    public: bool
) -> !ast::Declaration {
    let function = try self.function_stub(tree, public, move docs);
    return self.parse_function_after_fn(tree, move function);
}

fn (self: &var Parser) parse_function_after_fn(
    tree: &var ast::Ast,
    function: ast::FunctionDecl
) -> !ast::Declaration {
    var value = move function;
    errdefer value.deinit(self.allocator);
    if !try self.parse_function_signature_after_fn(tree, &var value.signature) {
        return add_function_decl(self.allocator, tree, move value);
    }
    if !try self.expect_peek(token::Kind::LBrace) {
        return add_function_decl(self.allocator, tree, move value);
    }
    let body = try self.parse_block_stmt(tree);
    value.body = body;
    return add_function_decl(self.allocator, tree, move value);
}

fn (self: &var Parser) parse_unsafe_decl(
    tree: &var ast::Ast,
    docs: string::String,
    public: bool
) -> !ast::Declaration {
    errdefer docs.deinit(self.allocator);
    if self.peek_kind() == token::Kind::Struct {
        try self.next_token();
        var declaration = try self.parse_struct_decl_with_doc(tree, move docs, public) orelse
            return try tree.add_recovered_declaration(token_span_at(self));
        declaration.requires_unsafe = true;
        return add_struct_decl(self.allocator, tree, move declaration);
    }
    if self.peek_kind() == token::Kind::Function {
        var function = try self.function_stub(tree, public, move docs);
        errdefer function.deinit(self.allocator);
        function.signature.requires_unsafe = true;
        try self.next_token();
        return self.parse_function_after_fn(tree, move function);
    }
    try self.error_token("expected fn or struct after unsafe, got ", self.peek_token());
    docs.deinit(self.allocator);
    return try tree.add_recovered_declaration(token_span_at(self));
}

fn (self: &var Parser) parse_extern_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    let docs = try self.current_comment_text();
    return self.parse_extern_decl_with_doc(tree, move docs, false);
}

fn (self: &var Parser) parse_extern_decl_with_doc(
    tree: &var ast::Ast,
    docs: string::String,
    public: bool
) -> !ast::Declaration {
    var function = try self.function_stub(tree, public, move docs);
    errdefer function.deinit(self.allocator);
    if !try self.expect_peek(token::Kind::String) {
        function.deinit(self.allocator);
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    function.signature.extern_abi = try self.retain_current_literal(tree);
    if !try self.expect_peek(token::Kind::Function) {
        function.deinit(self.allocator);
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let _ = try self.parse_function_signature_after_fn(tree, &var function.signature);
    return add_function_decl(self.allocator, tree, move function);
}

fn (self: &var Parser) parse_export_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    let docs = try self.current_comment_text();
    return self.parse_export_decl_with_doc(tree, move docs, false);
}

fn (self: &var Parser) parse_export_decl_with_doc(
    tree: &var ast::Ast,
    docs: string::String,
    public: bool
) -> !ast::Declaration {
    var function = try self.function_stub(tree, public, move docs);
    errdefer function.deinit(self.allocator);
    if !try self.expect_peek(token::Kind::String) {
        function.deinit(self.allocator);
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    function.signature.export_abi = try self.retain_current_literal(tree);
    if !try self.expect_peek(token::Kind::Function) {
        function.deinit(self.allocator);
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    return self.parse_function_after_fn(tree, move function);
}

fn add_function_decl(

    allocator: Allocator,
    tree: &var ast::Ast,
    function: ast::FunctionDecl
) -> !ast::Declaration {
    return try tree.add_declaration(ast::DeclarationNode::Function(move function));
}

fn (self: &var Parser) parse_enum_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    let docs = try self.current_comment_text();
    return self.parse_enum_decl_with_doc(tree, move docs, false);
}

fn (self: &var Parser) parse_enum_decl_with_doc(
    tree: &var ast::Ast,
    docs: string::String,
    public: bool
) -> !ast::Declaration {
    let doc = try tree.add_text(move docs);
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let name = try self.retain_current_literal(tree);
    if !try self.expect_peek(token::Kind::LBrace) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let list = try self.parse_name_list(self.allocator, tree, "enum tag");
    return try tree.add_declaration(ast::DeclarationNode::Enum(ast::EnumDecl {
        name: name,
        doc: doc,
        tags: move list.names,
        tag_docs: move list.docs,
        public: public
    }));
}

fn (self: &var Parser) parse_error_set_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    let docs = try self.current_comment_text();
    return self.parse_error_set_decl_with_doc(tree, move docs, false);
}

fn (self: &var Parser) parse_error_set_decl_with_doc(
    tree: &var ast::Ast,
    docs: string::String,
    public: bool
) -> !ast::Declaration {
    let doc = try tree.add_text(move docs);
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let name = try self.retain_current_literal(tree);
    if self.peek_kind() == token::Kind::Assign {
        try self.next_token();
        let combines = try self.parse_error_set_combines(tree);
        return try tree.add_declaration(ast::DeclarationNode::ErrorSet(
            ast::ErrorSetDecl {
            name: name,
            doc: doc,
            members: array::new<ast::Text>(self.allocator),
            member_docs: null,
            public: public,
            combines: move combines
        }
        ));
    }
    if !try self.expect_peek(token::Kind::LBrace) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let list = try self.parse_name_list(self.allocator, tree, "error name");
    return try tree.add_declaration(ast::DeclarationNode::ErrorSet(
        ast::ErrorSetDecl {
        name: name,
        doc: doc,
        members: move list.names,
        member_docs: move list.docs,
        public: public,
        combines: array::new<ast::Text>(self.allocator)
    }
    ));
}

// Parses the right side of `error Name = A or B;`: a list of declared set
// references joined by `or`. The `=` form declares no members of its own, so
// only names appear here.
fn (self: &var Parser) parse_error_set_combines(
    tree: &var ast::Ast
) -> !array::Array<ast::Text> {
    var combines = array::new<ast::Text>(self.allocator);
    errdefer combines.deinit(self.allocator);
    while true {
        if try self.parse_error_set_reference(tree) |reference| {
            try combines.append(self.allocator, reference);
        } else {
            return move combines;
        }
        if self.peek_kind() != token::Kind::Or {
            break;
        }
        try self.next_token();
    }
    let _ = try self.expect_peek(token::Kind::Semicolon);
    return move combines;
}

// Parses one set name on the right side of an `=` error set declaration,
// module qualification included.
fn (self: &var Parser) parse_error_set_reference(
    tree: &var ast::Ast
) -> !?ast::Text {
    if !try self.expect_peek(token::Kind::Ident) {
        return null;
    }
    var name = string::new(self.allocator);
    errdefer name.deinit(self.allocator);
    try append_token_literal(self.allocator, &var name, self.current_token());
    while self.peek_kind() == token::Kind::DoubleColon {
        try self.next_token();
        if !try self.expect_peek(token::Kind::Ident) {
            name.deinit(self.allocator);
            return null;
        }
        try name.append_bytes(self.allocator, "::");
        try append_token_literal(self.allocator, &var name, self.current_token());
    }
    return try tree.add_text(move name);
}

// Appends one token's literal bytes to an owned spelling.
fn append_token_literal(allocator: Allocator, name: &var string::String, current: &token::Token) -> !void {
    let bytes = current.literal.as_bytes();
    return name.append_bytes(allocator, bytes);
}

fn (self: &var Parser) parse_name_list(

    allocator: Allocator,
    tree: &var ast::Ast,
    label: []u8
) -> !NameList {
    var names = array::new<ast::Text>(self.allocator);
    errdefer names.deinit(self.allocator);
    var docs = map::new<[]u8, ast::Text>(self.allocator);
    errdefer docs.deinit(self.allocator);
    try self.next_token();
    while self.current_kind() != token::Kind::RBrace and
        self.current_kind() != token::Kind::Eof {
        let handle = self.stream.get_or_panic(self.position);
        if self.current_kind() != token::Kind::Ident {
            try self.error_expected(label, self.tokens.at(handle));
            return finish_name_list(self.allocator, move names, move docs);
        }
        let current = self.tokens.at(handle);
        let name = try retain_literal(tree, current);
        try names.append(self.allocator, name);
        let text = try self.comment_text(&current.doc_comments);
        if text.len() == 0 {
            text.deinit(self.allocator);
        } else {
            let retained = try tree.add_text(move text);
            let key = current.literal.as_bytes();
            try docs.insert(allocator, key, retained);
        }
        if !try self.consume_list_delimiter(label) {
            return finish_name_list(self.allocator, move names, move docs);
        }
        try self.next_token();
    }
    try self.expect_list_close(label, " list");
    return finish_name_list(self.allocator, move names, move docs);
}

fn finish_name_list(
    allocator: Allocator,
    names: array::Array<ast::Text>,
    docs: map::Map<[]u8, ast::Text>
) -> NameList {
    return NameList {
        names: move names,
        docs: tag_docs_or_null(allocator, move docs)
    };
}

fn tag_docs_or_null(
    allocator: Allocator,
    docs: map::Map<[]u8, ast::Text>
) -> ?map::Map<[]u8, ast::Text> {
    if docs.len() == 0 {
        docs.deinit(allocator);
        return null;
    }
    return move docs;
}

fn (self: &var Parser) parse_union_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    let docs = try self.current_comment_text();
    return self.parse_union_decl_with_doc(tree, move docs, false);
}

fn (self: &var Parser) parse_union_decl_with_doc(
    tree: &var ast::Ast,
    docs: string::String,
    public: bool
) -> !ast::Declaration {
    let doc = try tree.add_text(move docs);
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let name = try self.retain_current_literal(tree);
    if self.peek_kind() == token::Kind::Lt {
        try self.next_token();
        let type_params = try self.parse_generic_param_list(tree) orelse
            return try tree.add_recovered_declaration(token_span_at(self));
        errdefer type_params.deinit(self.allocator);
        if type_params.len() == 0 or !try self.expect_type_close() {
            type_params.deinit(self.allocator);
            return try tree.add_recovered_declaration(token_span_at(self));
        }
        return self.finish_union_decl(tree, name, doc, move type_params, public);
    }
    let type_params = array::new<ast::Text>(self.allocator);
    return self.finish_union_decl(tree, name, doc, move type_params, public);
}

fn (self: &var Parser) finish_union_decl(
    tree: &var ast::Ast,
    name: ast::Text,
    doc: ast::Text,
    type_params: array::Array<ast::Text>,
    public: bool
) -> !ast::Declaration {
    errdefer type_params.deinit(self.allocator);
    if !try self.expect_peek(token::Kind::LBrace) {
        type_params.deinit(self.allocator);
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let variants = try self.parse_union_variants(tree);
    return try tree.add_declaration(ast::DeclarationNode::Union(ast::UnionDecl {
        name: name,
        doc: doc,
        type_params: move type_params,
        variants: move variants,
        public: public
    }));
}

fn (self: &var Parser) parse_union_variants(
    tree: &var ast::Ast
) -> !array::Array<ast::UnionVariant> {
    var variants = array::new<ast::UnionVariant>(self.allocator);
    errdefer variants.deinit(self.allocator);
    try self.next_token();
    while self.current_kind() != token::Kind::RBrace and
        self.current_kind() != token::Kind::Eof {
        if try self.parse_union_variant(tree) |variant| {
            try variants.append(self.allocator, variant);
        } else {
            return move variants;
        }
        if !try self.consume_list_delimiter("union variant") {
            return move variants;
        }
        try self.next_token();
    }
    try self.expect_list_close("union", "");
    return move variants;
}

fn (self: &var Parser) parse_union_variant(
    tree: &var ast::Ast
) -> !?ast::UnionVariant {
    let docs = try self.current_comment_text();
    let doc = try tree.add_text(move docs);
    if self.current_kind() != token::Kind::Ident {
        try self.error_expected("union variant", self.current_token());
        return null;
    }
    let name = try retain_literal(tree, self.current_token());
    if self.peek_kind() != token::Kind::LParen {
        return ast::UnionVariant {
            name: name,
            doc: doc,
            payload: null
        };
    }
    try self.next_token();
    try self.next_token();
    let payload = try self.parse_type_name(tree);
    if payload |retained| {
        if !try self.expect_peek(token::Kind::RParen) {
            return null;
        }
        return ast::UnionVariant {
            name: name,
            doc: doc,
            payload: retained
        };
    }
    return null;
}

fn (self: &var Parser) parse_struct_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    let docs = try self.current_comment_text();
    let declaration = try self.parse_struct_decl_with_doc(tree, move docs, false) orelse
        return try tree.add_recovered_declaration(token_span_at(self));
    return add_struct_decl(self.allocator, tree, move declaration);
}

fn (self: &var Parser) parse_struct_decl_with_doc(
    tree: &var ast::Ast,
    docs: string::String,
    public: bool
) -> !?ast::StructDecl {
    let doc = try tree.add_text(move docs);
    if !try self.expect_peek(token::Kind::Ident) {
        return null;
    }
    let span = token_span_at(self);
    let name = try self.retain_current_literal(tree);
    if self.peek_kind() == token::Kind::Lt {
        try self.next_token();
        let type_params = try self.parse_generic_param_list(tree) orelse
            return null;
        errdefer type_params.deinit(self.allocator);
        if type_params.len() == 0 or !try self.expect_type_close() {
            type_params.deinit(self.allocator);
            return null;
        }
        return self.finish_struct_decl(tree, name, doc, span, move type_params, public);
    }
    let type_params = array::new<ast::Text>(self.allocator);
    return self.finish_struct_decl(tree, name, doc, span, move type_params, public);
}

fn (self: &var Parser) finish_struct_decl(
    tree: &var ast::Ast,
    name: ast::Text,
    doc: ast::Text,
    span: ast::Span,
    type_params: array::Array<ast::Text>,
    public: bool
) -> !?ast::StructDecl {
    errdefer type_params.deinit(self.allocator);
    if !try self.expect_peek(token::Kind::LBrace) {
        type_params.deinit(self.allocator);
        return null;
    }
    let fields = try self.parse_struct_fields(tree);
    return ast::StructDecl {
        name: name,
        doc: doc,
        type_params: move type_params,
        fields: move fields,
        public: public,
        span: span,
        requires_unsafe: false
    };
}

fn (self: &var Parser) parse_struct_fields(
    tree: &var ast::Ast
) -> !array::Array<ast::Field> {
    var fields = array::new<ast::Field>(self.allocator);
    errdefer fields.deinit(self.allocator);
    try self.next_token();
    while self.current_kind() != token::Kind::RBrace and
        self.current_kind() != token::Kind::Eof {
        if try self.parse_struct_field(tree) |field| {
            try fields.append(self.allocator, field);
        } else {
            return move fields;
        }
        if !try self.consume_list_delimiter("struct field") {
            return move fields;
        }
        try self.next_token();
    }
    try self.expect_list_close("struct", "");
    return move fields;
}

fn (self: &var Parser) parse_struct_field(tree: &var ast::Ast) -> !?ast::Field {
    let docs = try self.current_comment_text();
    let doc = try tree.add_text(move docs);
    var public = false;
    if self.current_kind() == token::Kind::Public {
        public = true;
        try self.next_token();
    }
    if self.current_kind() != token::Kind::Ident {
        try self.error_expected("field name", self.current_token());
        return null;
    }
    let name_handle = self.stream.get_or_panic(self.position);
    if !try self.expect_peek(token::Kind::Colon) {
        return null;
    }
    try self.next_token();
    var borrow = false;
    var mut_borrow = false;
    if self.current_kind() == token::Kind::Amp {
        borrow = true;
        try self.next_token();
        if self.current_kind() == token::Kind::Var {
            mut_borrow = true;
            try self.next_token();
        }
    }
    let parsed = try self.parse_type_name(tree);
    if parsed |type_name| {
        let name = try retain_literal(tree, self.tokens.at(name_handle));
        return ast::Field {
            name: name,
            doc: doc,
            type_name: type_name,
            borrow: borrow,
            mut_borrow: mut_borrow,
            public: public
        };
    }
    return null;
}

fn add_struct_decl(

    allocator: Allocator,
    tree: &var ast::Ast,
    declaration: ast::StructDecl
) -> !ast::Declaration {
    return try tree.add_declaration(ast::DeclarationNode::Struct(move declaration));
}

fn (self: &var Parser) parse_function_signature_after_fn(
    tree: &var ast::Ast,
    signature: &var ast::FunctionSignature
) -> !bool {
    if self.peek_kind() == token::Kind::LParen {
        if try self.parse_receiver(tree) |receiver| {
            defer receiver.deinit(self.allocator);
            var receiver_index = 0;
            while receiver.get(receiver_index) |param| {
                try signature.params.append(self.allocator, param);
                receiver_index = receiver_index + 1;
            }
            signature.receiver = true;
        } else {
            return false;
        }
    }
    if !try self.expect_peek(token::Kind::Ident) {
        return false;
    }
    let name = try self.retain_current_literal(tree);
    signature.name = name;
    signature.span = token_span_at(self);
    if self.peek_kind() == token::Kind::Lt {
        try self.next_token();
        if try self.parse_static_param_list(tree) |static_params| {
            defer static_params.deinit(self.allocator);
            var static_index = 0;
            while static_params.get(static_index) |param| {
                try signature.static_params.append(self.allocator, param);
                static_index = static_index + 1;
            }
            if static_params.len() == 0 or
                !try self.expect_type_close() {
                return false;
            }
        } else {
            return false;
        }
    }
    if !try self.expect_peek(token::Kind::LParen) {
        return false;
    }
    let params = try self.parse_params(tree);
    defer params.deinit(self.allocator);
    var index = 0;
    while params.get(index) |param| {
        try signature.params.append(self.allocator, param);
        index = index + 1;
    }
    if !try self.expect_current(token::Kind::RParen) {
        return false;
    }
    return self.parse_return_clause(tree, signature);
}

fn (self: &var Parser) parse_contract_decl(
    tree: &var ast::Ast,
    public: bool
) -> !ast::Declaration {
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let name = try self.retain_current_literal(tree);
    if !try self.expect_peek(token::Kind::LBrace) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let methods = try self.parse_contract_methods(tree);
    return try tree.add_declaration(ast::DeclarationNode::Contract(
        ast::ContractDecl {
        name: name,
        methods: move methods,
        public: public
    }
    ));
}

fn (self: &var Parser) parse_contract_methods(
    tree: &var ast::Ast
) -> !array::Array<ast::FunctionDecl> {
    var methods = array::new<ast::FunctionDecl>(self.allocator);
    errdefer methods.deinit(self.allocator);
    try self.next_token();
    while self.current_kind() != token::Kind::RBrace and
        self.current_kind() != token::Kind::Eof {
        if self.current_kind() != token::Kind::Function {
            try self.error_expected("contract method", self.current_token());
            return move methods;
        }
        if try self.parse_contract_method(tree) |method| {
            errdefer method.deinit(self.allocator);
            try methods.append(self.allocator, move method);
        } else {
            return move methods;
        }
        if self.peek_kind() == token::Kind::Semicolon {
            try self.next_token();
        }
        try self.next_token();
    }
    try self.expect_list_close("contract", "");
    return move methods;
}

fn (self: &var Parser) parse_contract_method(
    tree: &var ast::Ast
) -> !?ast::FunctionDecl {
    var method = try self.function_stub(tree, false, string::new(self.allocator));
    errdefer method.deinit(self.allocator);
    let _ = try self.parse_function_signature_after_fn(
        tree,
        &var method.signature
    );
    if method.signature.receiver {
        try self.error_text(
            "a contract method takes no receiver; it says what a method looks like, not what it is on"
        );
        method.deinit(self.allocator);
        return null;
    }
    return move method;
}

fn (self: &var Parser) parse_return_clause(
    tree: &var ast::Ast,
    signature: &var ast::FunctionSignature
) -> !bool {
    if self.peek_kind() != token::Kind::Arrow {
        return true;
    }
    try self.next_token();
    try self.next_token();
    let parsed = try self.parse_type_name(tree);
    signature.return_type = parsed;
    if parsed |_| {
        return true;
    }
    return false;
}

fn (self: &var Parser) parse_params(
    tree: &var ast::Ast
) -> !array::Array<ast::Param> {
    var params = array::new<ast::Param>(self.allocator);
    errdefer params.deinit(self.allocator);
    try self.next_token();
    if self.current_kind() == token::Kind::RParen {
        return move params;
    }
    while true {
        if self.current_kind() == token::Kind::Comptime {
            try self.error_text(
                "compile-time parameter belongs in `<...>`, not `(...)`"
            );
            return move params;
        }
        if self.current_kind() != token::Kind::Ident {
            try self.error_token("expected parameter name, got ", self.current_token());
            return move params;
        }
        let name_handle = self.stream.get_or_panic(self.position);
        if !try self.expect_peek(token::Kind::Colon) {
            return move params;
        }
        try self.next_token();
        var borrow = false;
        var mut_borrow = false;
        if self.current_kind() == token::Kind::Amp {
            borrow = true;
            try self.next_token();
            if self.current_kind() == token::Kind::Var {
                mut_borrow = true;
                try self.next_token();
            }
        }
        let parsed = try self.parse_type_name(tree);
        if parsed |type_name| {
            let name = try retain_literal(tree, self.tokens.at(name_handle));
            try params.append(self.allocator, ast::Param {
                name: name,
                type_name: type_name,
                borrow: borrow,
                mut_borrow: mut_borrow
            });
        } else {
            return move params;
        }
        if self.peek_kind() != token::Kind::Comma {
            break;
        }
        try self.next_token();
        if self.peek_kind() == token::Kind::RParen {
            break;
        }
        try self.next_token();
    }
    let _ = try self.expect_peek(token::Kind::RParen);
    return move params;
}

fn (self: &var Parser) parse_receiver(
    tree: &var ast::Ast
) -> !?array::Array<ast::Param> {
    try self.next_token();
    var params = try self.parse_params(tree);
    errdefer params.deinit(self.allocator);
    if !try self.expect_current(token::Kind::RParen) {
        params.deinit(self.allocator);
        return null;
    }
    if params.len() != 1 {
        var entry = try self.error_entry();
        errdefer entry.deinit(self.allocator);
        try entry.message.append_bytes(self.allocator, "expected one receiver in `fn (...)`, got ");
        try fmt::append_i64(self.allocator, &var entry.message, params.len());
        try self.record(move entry);
        params.deinit(self.allocator);
        return null;
    }
    return move params;
}

fn (self: &var Parser) parse_impl_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let contract_handle = self.stream.get_or_panic(self.position);
    if self.peek_kind() != token::Kind::For {
        try self.error_impl_missing_for(self.tokens.at(contract_handle));
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    try self.next_token();
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let type_handle = self.stream.get_or_panic(self.position);
    if self.peek_kind() == token::Kind::LBrace {
        try self.error_impl_body(
            self.tokens.at(contract_handle),
            self.tokens.at(type_handle)
        );
        return try tree.add_recovered_declaration(token_span_at(self));
    }
    let _ = try self.expect_statement_terminator("impl declaration");
    let contract_name = try retain_literal(tree, self.tokens.at(contract_handle));
    let type_name = try retain_literal(tree, self.tokens.at(type_handle));
    return try tree.add_declaration(ast::DeclarationNode::Impl(ast::ImplDecl {
        contract_name: contract_name,
        type_name: type_name
    }));
}

fn (self: &var Parser) expect_current(expected: token::Kind) -> !bool {
    if self.current_kind() == expected {
        return true;
    }
    try self.error_expected_kind("expected ", expected, self.current_token());
    return false;
}

fn (self: &var Parser) expect_peek(expected: token::Kind) -> !bool {
    if self.peek_kind() == expected {
        try self.next_token();
        return true;
    }
    try self.error_expected_kind("expected next token ", expected, self.peek_token());
    return false;
}

fn (self: &var Parser) expect_type_close() -> !bool {
    if self.current_kind() == token::Kind::Gt {
        if self.peek_kind() == token::Kind::Gt {
            try self.next_token();
        }
        return true;
    }
    return self.expect_peek(token::Kind::Gt);
}

fn (self: &var Parser) expect_statement_terminator(context: []u8) -> !bool {
    if self.current_kind() == token::Kind::Semicolon {
        return true;
    }
    if self.peek_kind() == token::Kind::Semicolon {
        try self.next_token();
        return true;
    }
    try self.error_context("expected `;` after ", context);
    return false;
}

fn (self: &var Parser) consume_list_delimiter(context: []u8) -> !bool {
    return match self.peek_kind() {
        Comma => {
            try self.next_token();
            true
        },
        RBrace => true,
        Eof => true,
        _ => {
            try self.error_context("expected `,` after ", context);
            false
        },
    };
}

/// Reports a brace-delimited list or block that reached the end of the file
/// before its closing brace. The loops stop at Eof so they cannot spin, but
/// stopping is not closing: a file cut off inside a body must not parse clean.
fn (self: &var Parser) expect_list_close(context: []u8, suffix: []u8) -> !void {
    if self.current_kind() != token::Kind::Eof {
        return;
    }
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, "expected `}` to close ");
    try entry.message.append_bytes(self.allocator, context);
    try entry.message.append_bytes(self.allocator, suffix);
    try entry.message.append_bytes(self.allocator, ", got end of file");
    return self.record(move entry);
}

fn (self: &var Parser) finish_expr_stmt(
    tree: &var ast::Ast,
    expression: ast::Expression
) -> !ast::Statement {
    let semicolon = match self.peek_kind() {
        Semicolon => {
            try self.next_token();
            true
        },
        RBrace => false,
        Comma => false,
        _ => {
            try self.error_text("expected `;` after expression statement");
            false
        },
    };
    return try tree.add_statement(ast::StatementNode::Expr(ast::ExprStmt {
        expr: expression,
        semicolon: semicolon
    }));
}

fn (self: &var Parser) parse_block_stmt(tree: &var ast::Ast) -> !ast::Block {
    var statements = array::new<ast::Statement>(self.allocator);
    errdefer statements.deinit(self.allocator);
    try self.next_token();
    while self.current_kind() != token::Kind::RBrace and
        self.current_kind() != token::Kind::Eof {
        let statement = try self.parse_statement(tree);
        try statements.append(self.allocator, statement);
        try self.next_token();
    }
    try self.expect_list_close("block", "");
    return try tree.add_block(ast::BlockStmt { statements: move statements });
}

fn (self: &var Parser) parse_statement(tree: &var ast::Ast) -> !ast::Statement {
    let enclosing = self.safety;
    var active = self.safety;
    active = null;
    let current = self.current_token();
    if current.safety.len() > 0 {
        let text = try self.comment_text(&current.safety);
        active = try tree.add_text(move text);
    }
    self.safety = move active;
    let statement = self.parse_statement_form(tree);
    self.safety = enclosing;
    return move statement;
}

fn (self: &var Parser) parse_statement_form(
    tree: &var ast::Ast
) -> !ast::Statement {
    if try self.parse_keyword_statement(tree) |statement| {
        return statement;
    }
    if self.current_kind() == token::Kind::Ident and
        self.peek_kind() == token::Kind::Colon {
        return self.parse_labeled_stmt(tree);
    }
    let expression = try self.parse_expression(tree, lowest_precedence());
    if self.peek_kind() == token::Kind::Assign {
        return self.parse_assign_stmt(tree, expression);
    }
    return self.finish_expr_stmt(tree, expression);
}

fn (self: &var Parser) parse_keyword_statement(
    tree: &var ast::Ast
) -> !?ast::Statement {
    let kind = self.current_kind();
    if kind == token::Kind::Let {
        return try self.parse_let_stmt(tree, false);
    }
    if kind == token::Kind::Var {
        return try self.parse_let_stmt(tree, true);
    }
    if kind == token::Kind::Return {
        return try self.parse_return_stmt(tree);
    }
    if kind == token::Kind::Defer {
        return try self.parse_defer_stmt(tree, false);
    }
    if kind == token::Kind::ErrDefer {
        return try self.parse_defer_stmt(tree, true);
    }
    if kind == token::Kind::If {
        if try self.parse_if_stmt(tree) |value| {
            return try tree.add_statement(ast::StatementNode::If(value));
        }
        return try tree.add_recovered_statement(token_span_at(self));
    }
    if kind == token::Kind::While {
        let label = try tree.add_empty_text();
        return try self.parse_while_stmt(tree, label);
    }
    if kind == token::Kind::For {
        let label = try tree.add_empty_text();
        return try self.parse_for_stmt(tree, label);
    }
    if kind == token::Kind::Break {
        return try self.parse_break_stmt(tree);
    }
    if kind == token::Kind::Continue {
        return try self.parse_continue_stmt(tree);
    }
    if kind == token::Kind::Match {
        if try self.parse_match_stmt(tree) |value| {
            return try tree.add_statement(ast::StatementNode::Match(move value));
        }
        return try tree.add_recovered_statement(token_span_at(self));
    }
    if kind == token::Kind::Comptime {
        return try self.parse_comptime_statement(tree);
    }
    return null;
}

fn (self: &var Parser) parse_comptime_statement(
    tree: &var ast::Ast
) -> !?ast::Statement {
    if self.peek_kind() == token::Kind::If {
        return try self.parse_comptime_if_stmt(tree);
    }
    if self.peek_kind() == token::Kind::For {
        return try self.parse_comptime_for_stmt(tree);
    }
    if self.peek_kind() == token::Kind::Match {
        return try self.parse_comptime_match_stmt(tree);
    }
    return null;
}

fn (self: &var Parser) parse_labeled_stmt(
    tree: &var ast::Ast
) -> !ast::Statement {
    let label = try self.retain_current_literal(tree);
    try self.next_token();
    try self.next_token();
    return match self.current_kind() {
        While => try self.parse_while_stmt(tree, label),
        For => try self.parse_for_stmt(tree, label),
        _ => {
            var entry = try self.error_entry();
            errdefer entry.deinit(self.allocator);
            try entry.message.append_bytes(self.allocator, "label `");
            try append_retained_text(self.allocator, &var entry.message, tree, label);
            try entry.message.append_bytes(self.allocator, "` must be attached to while or for");
            try self.record(move entry);
            try tree.add_recovered_statement(token_span_at(self))
        },
    };
}

fn (self: &var Parser) parse_comptime_if_stmt(
    tree: &var ast::Ast
) -> !ast::Statement {
    if !try self.expect_peek(token::Kind::If) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    try self.next_token();
    let condition = try self.parse_expression(tree, lowest_precedence());
    if !try self.expect_peek(token::Kind::LBrace) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    let consequence = try self.parse_block_stmt(tree);
    var alternative = no_block();
    if self.peek_kind() == token::Kind::Else {
        try self.next_token();
        if try self.expect_peek(token::Kind::LBrace) {
            alternative = try self.parse_block_stmt(tree);
        }
    }
    return try tree.add_statement(ast::StatementNode::ComptimeIf(
        ast::ComptimeIfStmt {
        condition: condition,
        consequence: consequence,
        alternative: alternative
    }
    ));
}

fn no_block() -> ?ast::Block {
    return null;
}

fn no_expression() -> ?ast::Expression {
    return null;
}

fn (self: &var Parser) parse_let_stmt(
    tree: &var ast::Ast,
    mutable: bool
) -> !ast::Statement {
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    let name = try self.retain_current_literal(tree);
    if !try self.expect_peek(token::Kind::Assign) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    try self.next_token();
    let value = try self.parse_expression(tree, lowest_precedence());
    let _ = try self.expect_statement_terminator("let statement");
    return try tree.add_statement(ast::StatementNode::Let(ast::LetStmt {
        mutable: mutable,
        name: name,
        value: value
    }));
}

fn (self: &var Parser) parse_assign_stmt(
    tree: &var ast::Ast,
    target: ast::Expression
) -> !ast::Statement {
    try self.next_token();
    try self.next_token();
    let value = try self.parse_expression(tree, lowest_precedence());
    let _ = try self.expect_statement_terminator("assignment");
    return try tree.add_statement(ast::StatementNode::Assign(ast::AssignStmt {
        target: target,
        value: value
    }));
}

fn (self: &var Parser) parse_return_stmt(
    tree: &var ast::Ast
) -> !ast::Statement {
    if self.peek_kind() == token::Kind::Semicolon {
        try self.next_token();
        return try tree.add_statement(ast::StatementNode::Return(
            ast::ReturnStmt { value: null }
        ));
    }
    try self.next_token();
    let value = try self.parse_expression(tree, lowest_precedence());
    let _ = try self.expect_statement_terminator("return statement");
    return try tree.add_statement(ast::StatementNode::Return(
        ast::ReturnStmt { value: value }
    ));
}

fn (self: &var Parser) parse_match_arm_return(
    tree: &var ast::Ast
) -> !ast::Statement {
    if self.peek_kind() == token::Kind::Comma or
        self.peek_kind() == token::Kind::RBrace {
        return try tree.add_statement(ast::StatementNode::Return(
            ast::ReturnStmt { value: null }
        ));
    }
    try self.next_token();
    let value = try self.parse_expression(tree, lowest_precedence());
    return try tree.add_statement(ast::StatementNode::Return(
        ast::ReturnStmt { value: value }
    ));
}

fn (self: &var Parser) parse_defer_stmt(
    tree: &var ast::Ast,
    error_path: bool
) -> !ast::Statement {
    if deferred_statement_forbidden(self.peek_kind()) {
        if error_path {
            try self.error_text("errdefer expects an expression statement");
        } else {
            try self.error_text("defer expects an expression statement");
        }
        return try tree.add_recovered_statement(token_span_at(self));
    }
    try self.next_token();
    let expression = try self.parse_expression(tree, lowest_precedence());
    if error_path {
        let _ = try self.expect_statement_terminator("errdefer statement");
        return try tree.add_statement(ast::StatementNode::ErrDefer(
            ast::ErrDeferStmt { expr: expression }
        ));
    }
    let _ = try self.expect_statement_terminator("defer statement");
    return try tree.add_statement(ast::StatementNode::Defer(
        ast::DeferStmt { expr: expression }
    ));
}

fn deferred_statement_forbidden(kind: token::Kind) -> bool {
    return kind == token::Kind::Let or
        kind == token::Kind::Var or
        kind == token::Kind::Return or
        kind == token::Kind::Defer or
        kind == token::Kind::ErrDefer or
        kind == token::Kind::LBrace;
}

fn (self: &var Parser) parse_if_stmt(tree: &var ast::Ast) -> !?ast::IfStmt {
    try self.next_token();
    let condition = try self.parse_expression(tree, lowest_precedence());
    if try self.parse_payload_capture(tree) |capture| {
        if !try self.expect_peek(token::Kind::LBrace) {
            return null;
        }
        let consequence = try self.parse_block_stmt(tree);
        var alternative = no_block();
        var err_capture = try tree.add_empty_text();
        if self.peek_kind() == token::Kind::Else {
            try self.next_token();
            // `else |err|` binds the error member of an error union condition
            // (SPEC §11.1), with the same `|name|` spelling as the success
            // capture.
            if try self.parse_payload_capture(tree) |bound| {
                err_capture = bound;
            } else {
                return null;
            }
            if try self.expect_peek(token::Kind::LBrace) {
                alternative = try self.parse_block_stmt(tree);
            }
        }
        return ast::IfStmt {
            condition: condition,
            consequence: consequence,
            alternative: alternative,
            capture: capture,
            err_capture: err_capture
        };
    }
    return null;
}

fn (self: &var Parser) parse_while_stmt(
    tree: &var ast::Ast,
    label: ast::Text
) -> !ast::Statement {
    try self.next_token();
    let condition = try self.parse_expression(tree, lowest_precedence());
    if try self.parse_payload_capture(tree) |capture| {
        if !try self.expect_peek(token::Kind::LBrace) {
            return try tree.add_recovered_statement(token_span_at(self));
        }
        let body = try self.parse_block_stmt(tree);
        return try tree.add_statement(ast::StatementNode::While(ast::WhileStmt {
            label: label,
            condition: condition,
            body: body,
            capture: capture
        }));
    }
    return try tree.add_recovered_statement(token_span_at(self));
}

fn (self: &var Parser) parse_for_stmt(
    tree: &var ast::Ast,
    label: ast::Text
) -> !ast::Statement {
    try self.next_token();
    let start = try self.parse_expression(tree, lowest_precedence());
    if !try self.expect_peek(token::Kind::Range) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    try self.next_token();
    let end = try self.parse_expression(tree, lowest_precedence());
    if !try self.expect_peek(token::Kind::Pipe) or
        !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    let name = try self.retain_current_literal(tree);
    if !try self.expect_peek(token::Kind::Pipe) or
        !try self.expect_peek(token::Kind::LBrace) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    let body = try self.parse_block_stmt(tree);
    return try tree.add_statement(ast::StatementNode::For(ast::ForStmt {
        label: label,
        name: name,
        start: start,
        end: end,
        body: body
    }));
}

fn (self: &var Parser) parse_comptime_for_stmt(
    tree: &var ast::Ast
) -> !ast::Statement {
    if !try self.expect_peek(token::Kind::For) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    try self.next_token();
    let list = try self.parse_expression(tree, lowest_precedence());
    if try self.parse_payload_capture(tree) |name| {
        if text_is_empty(tree, name) {
            try self.error_text(
                "comptime for requires a capture, as in `comptime for list |field| { ... }`"
            );
            return try tree.add_recovered_statement(token_span_at(self));
        }
        if !try self.expect_peek(token::Kind::LBrace) {
            return try tree.add_recovered_statement(token_span_at(self));
        }
        let body = try self.parse_block_stmt(tree);
        return try tree.add_statement(ast::StatementNode::ComptimeFor(
            ast::ComptimeForStmt { list: list, name: name, body: body }
        ));
    }
    return try tree.add_recovered_statement(token_span_at(self));
}

fn text_is_empty(tree: &ast::Ast, value: ast::Text) -> bool {
    return tree.texts.at(value.node).len() == 0;
}

fn (self: &var Parser) parse_comptime_match_stmt(
    tree: &var ast::Ast
) -> !ast::Statement {
    if !try self.expect_peek(token::Kind::Match) {
        return try tree.add_recovered_statement(token_span_at(self));
    }
    try self.next_token();
    let value = try self.parse_expression(tree, lowest_precedence());
    if try self.parse_variant_capture(tree) |retained_captures| {
        defer retained_captures.deinit(self.allocator);
        if retained_captures.len() == 0 {
            try self.error_text(
                "comptime match requires a capture, as in `comptime match value |variant| { ... }`"
            );
            return try tree.add_recovered_statement(token_span_at(self));
        }
        let first = retained_captures.get_or_panic(0);
        let name = ast::Text { node: first.node };
        var binding = try tree.add_empty_text();
        if retained_captures.at(1) |second| {
            binding = ast::Text { node: second.node };
        }
        if !try self.expect_peek(token::Kind::LBrace) {
            return try tree.add_recovered_statement(token_span_at(self));
        }
        let body = try self.parse_block_stmt(tree);
        return try tree.add_statement(ast::StatementNode::ComptimeMatch(
            ast::ComptimeMatchStmt {
            value: value,
            name: name,
            binding: binding,
            body: body
        }
        ));
    }
    return try tree.add_recovered_statement(token_span_at(self));
}

fn (self: &var Parser) parse_match_stmt(
    tree: &var ast::Ast
) -> !?ast::MatchStmt {
    try self.next_token();
    let value = try self.parse_expression(tree, lowest_precedence());
    if !try self.expect_peek(token::Kind::LBrace) {
        return null;
    }
    let arms = try self.parse_match_arms(tree);
    errdefer arms.deinit(self.allocator);
    return ast::MatchStmt {
        value: value,
        arms: move arms,
        meta_capture: try tree.add_empty_text(),
        meta_owner: try tree.add_empty_text()
    };
}

fn (self: &var Parser) parse_match_arms(
    tree: &var ast::Ast
) -> !array::Array<ast::MatchArm> {
    var arms = array::new<ast::MatchArm>(self.allocator);
    errdefer arms.deinit(self.allocator);
    try self.next_token();
    while self.current_kind() != token::Kind::RBrace and
        self.current_kind() != token::Kind::Eof {
        if try self.parse_match_arm(tree) |arm| {
            try arms.append(self.allocator, arm);
        } else {
            return move arms;
        }
        if !try self.consume_list_delimiter("match arm") {
            return move arms;
        }
        try self.next_token();
    }
    try self.expect_list_close("match", "");
    return move arms;
}

fn (self: &var Parser) parse_match_arm(tree: &var ast::Ast) -> !?ast::MatchArm {
    if self.current_kind() != token::Kind::Ident {
        try self.error_token("expected match tag, got ", self.current_token());
        return null;
    }
    var tag = try self.retain_current_literal(tree);
    var tag_set = try tree.add_empty_text();
    // A qualified arm (`FsError::NotFound =>`) names the error set a member
    // originates from, which a combined set needs when two of its sets
    // declare the same member name. Every segment before the last is the set
    // reference, module qualification included.
    while self.peek_kind() == token::Kind::DoubleColon {
        try self.next_token();
        if !try self.expect_peek(token::Kind::Ident) {
            return null;
        }
        tag_set = try join_qualified_text(tree, self.allocator, tag_set, tag);
        tag = try self.retain_current_literal(tree);
    }
    var binding = try tree.add_empty_text();
    if self.peek_kind() == token::Kind::LParen {
        try self.next_token();
        if !try self.expect_peek(token::Kind::Ident) {
            return null;
        }
        binding = try self.retain_current_literal(tree);
        if !try self.expect_peek(token::Kind::RParen) {
            return null;
        }
    }
    if !try self.expect_peek(token::Kind::FatArrow) {
        return null;
    }
    try self.next_token();
    if self.current_kind() == token::Kind::Return {
        let body = try self.parse_match_arm_return(tree);
        return ast::MatchArm {
            tag: tag,
            binding: binding,
            body: body,
            tag_set: tag_set
        };
    }
    if self.current_kind() == token::Kind::LBrace {
        let block = try self.parse_block_stmt(tree);
        return ast::MatchArm {
            tag: tag,
            binding: binding,
            body: block.as_statement(),
            tag_set: tag_set
        };
    }
    let body = try self.parse_statement(tree);
    return ast::MatchArm {
        tag: tag,
        binding: binding,
        body: body,
        tag_set: tag_set
    };
}

// Appends one qualifier segment to a retained set reference: an empty
// qualifier becomes the segment, a filled one gains `::segment`.
fn join_qualified_text(
    tree: &var ast::Ast,
    allocator: Allocator,
    qualifier: ast::Text,
    segment: ast::Text
) -> !ast::Text {
    let joined = try joined_qualifier(tree, allocator, qualifier, segment);
    return try tree.add_text(move joined);
}

// Renders qualifier and segment into one owned `A::B` spelling. The reads
// stay in this borrow scope so the caller may retain the result.
fn joined_qualifier(
    tree: &ast::Ast,
    allocator: Allocator,
    qualifier: ast::Text,
    segment: ast::Text
) -> !string::String {
    var joined = string::new(allocator);
    errdefer joined.deinit(allocator);
    let head = tree.texts.at(qualifier.node);
    let head_bytes = head.as_bytes();
    if head.len() > 0 {
        try joined.append_bytes(allocator, head_bytes);
        try joined.append_bytes(allocator, "::");
    }
    let tail = tree.texts.at(segment.node);
    let tail_bytes = tail.as_bytes();
    try joined.append_bytes(allocator, tail_bytes);
    return move joined;
}

fn (self: &var Parser) parse_break_stmt(tree: &var ast::Ast) -> !ast::Statement {
    let label = try self.parse_optional_branch_label(tree);
    let node = ast::BreakStmt { label: label };
    let statement = try tree.add_statement(ast::StatementNode::Break(node));
    let _ = try self.expect_statement_terminator("break statement");
    return statement;
}

fn (self: &var Parser) parse_continue_stmt(
    tree: &var ast::Ast
) -> !ast::Statement {
    let label = try self.parse_optional_branch_label(tree);
    let node = ast::ContinueStmt { label: label };
    let statement = try tree.add_statement(ast::StatementNode::Continue(node));
    let _ = try self.expect_statement_terminator("continue statement");
    return statement;
}

fn (self: &var Parser) parse_optional_branch_label(
    tree: &var ast::Ast
) -> !ast::Text {
    if self.peek_kind() != token::Kind::Colon {
        return try tree.add_empty_text();
    }
    try self.next_token();
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_empty_text();
    }
    return self.retain_current_literal(tree);
}

fn retain_literal(tree: &var ast::Ast, current: &token::Token) -> !ast::Text {
    let bytes = current.literal.as_bytes();
    return tree.add_text_from_bytes(bytes);
}

fn (self: &Parser) parse_keyword_literal_expression(
    tree: &var ast::Ast
) -> !ast::Expression {
    let node = match self.current_kind() {
        True => ast::ExpressionNode::Bool(ast::BoolExpr { value: true }),
        False => ast::ExpressionNode::Bool(ast::BoolExpr { value: false }),
        _ => ast::ExpressionNode::Null(ast::NullExpr {
            span: token_span_at(self)
        }),
    };
    return try tree.add_expression(move node);
}

fn (self: &var Parser) parse_expression(
    tree: &var ast::Ast,
    binding_power: i64
) -> !ast::Expression {
    var left = try self.parse_prefix_expression(tree);
    while self.peek_kind() != token::Kind::Semicolon {
        var type_apply = false;
        let shift = try self.shift_pair();
        if self.peek_kind() == token::Kind::Lt and !shift {
            type_apply = try self.should_parse_type_apply(tree, left);
        }
        let power = try self.peek_precedence();
        if binding_power >= power and !type_apply {
            break;
        }
        if shift {
            left = try self.parse_shift_expr(tree, left);
            continue;
        }
        let next_kind = self.peek_kind();
        if is_binary_operator(next_kind) {
            try self.next_token();
            left = try self.parse_binary_expr(tree, left);
            continue;
        }
        match next_kind {
            Orelse => {
                try self.next_token();
                left = try self.parse_guardable_expr(tree, left);
            },
            Catch => {
                try self.next_token();
                left = try self.parse_guardable_expr(tree, left);
            },
            LParen => {
                try self.next_token();
                left = try self.parse_call_expr(tree, left);
            },
            LBracket => {
                try self.next_token();
                left = try self.parse_index_expr(tree, left);
            },
            Lt => {
                try self.next_token();
                if type_apply {
                    left = try self.parse_type_apply_expr(tree, left);
                } else {
                    left = try self.parse_binary_expr(tree, left);
                }
            },
            Dot => {
                try self.next_token();
                left = try self.parse_field_expr(tree, left, false);
            },
            DoubleColon => {
                try self.next_token();
                left = try self.parse_field_expr(tree, left, true);
            },
            _ => {
                break;
            },
        }
    }
    if self.peek_kind() == token::Kind::LBrace {
        if try self.struct_literal_type_name(self.allocator,
            tree,
            left
        ) |type_name| {
            return self.parse_struct_literal_expr(tree, move type_name);
        }
    }
    return left;
}

fn is_binary_operator(kind: token::Kind) -> bool {
    return kind == token::Kind::Plus or
        kind == token::Kind::Minus or
        kind == token::Kind::Asterisk or
        kind == token::Kind::Slash or
        kind == token::Kind::Percent or
        kind == token::Kind::And or
        kind == token::Kind::Or or
        kind == token::Kind::Eq or
        kind == token::Kind::NotEq or
        kind == token::Kind::Lte or
        kind == token::Kind::Gt or
        kind == token::Kind::Gte or
        kind == token::Kind::Pipe or
        kind == token::Kind::Caret or
        kind == token::Kind::Amp;
}

fn (self: &var Parser) parse_index_expr(
    tree: &var ast::Ast,
    target: ast::Expression
) -> !ast::Expression {
    let span = token_span_at(self);
    try self.next_token();
    if self.current_kind() == token::Kind::Range {
        return self.parse_open_start_slice(tree, target, span);
    }
    let start = try self.parse_expression(tree, lowest_precedence());
    if self.peek_kind() == token::Kind::Range {
        try self.next_token();
        return self.parse_closed_start_slice(tree, target, start, span);
    }
    let _ = try self.expect_peek(token::Kind::RBracket);
    return add_index_expr(tree, target, start, null, null, false, span);
}

fn (self: &var Parser) parse_open_start_slice(
    tree: &var ast::Ast,
    target: ast::Expression,
    span: ast::Span
) -> !ast::Expression {
    if self.peek_kind() == token::Kind::RBracket {
        try self.error_text("slice expression requires at least one bound");
        return try tree.add_recovered_expression(span);
    }
    try self.next_token();
    let end = try self.parse_expression(tree, lowest_precedence());
    let _ = try self.expect_peek(token::Kind::RBracket);
    return add_index_expr(tree, target, null, null, end, true, span);
}

fn (self: &var Parser) parse_closed_start_slice(
    tree: &var ast::Ast,
    target: ast::Expression,
    start: ast::Expression,
    span: ast::Span
) -> !ast::Expression {
    if self.peek_kind() == token::Kind::RBracket {
        try self.next_token();
        return add_index_expr(tree, target, null, start, null, true, span);
    }
    try self.next_token();
    let end = try self.parse_expression(tree, lowest_precedence());
    let _ = try self.expect_peek(token::Kind::RBracket);
    return add_index_expr(tree, target, null, start, end, true, span);
}

fn add_index_expr(
    tree: &var ast::Ast,
    target: ast::Expression,
    index: ?ast::Expression,
    start: ?ast::Expression,
    end: ?ast::Expression,
    slice: bool,
    span: ast::Span
) -> !ast::Expression {
    return try tree.add_expression(ast::ExpressionNode::Index(ast::IndexExpr {
        target: target,
        index: index,
        start: start,
        end: end,
        slice: slice,
        span: span
    }));
}

fn (self: &var Parser) parse_prefix_expression(
    tree: &var ast::Ast
) -> !ast::Expression {
    let kind = self.current_kind();
    if kind == token::Kind::True or
        kind == token::Kind::False or
        kind == token::Kind::Null {
        return self.parse_keyword_literal_expression(tree);
    }
    if kind == token::Kind::Comptime or
        kind == token::Kind::Try or
        kind == token::Kind::Move or
        kind == token::Kind::Unsafe {
        return self.parse_marker_expression(tree);
    }
    if kind == token::Kind::Bang or kind == token::Kind::Minus or
        kind == token::Kind::Tilde {
        return self.parse_unary_prefix_expression(tree);
    }
    return match kind {
        Ident => try self.parse_ident_prefix_expression(tree),
        Int => try self.parse_int_literal_expression(tree),
        String => try self.retain_literal_expression(tree, true),
        If => {
            let value = try self.parse_if_stmt(tree) orelse
                return try tree.add_recovered_expression(token_span_at(self));
            try tree.add_expression(ast::ExpressionNode::If(value))
        },
        Match => {
            let value = try self.parse_match_stmt(tree) orelse
                return try tree.add_recovered_expression(token_span_at(self));
            try tree.add_expression(ast::ExpressionNode::Match(move value))
        },
        Amp => try self.parse_borrow_prefix_expression(tree),
        LParen => {
            try self.next_token();
            let inner = try self.parse_expression(tree, lowest_precedence());
            let _ = try self.expect_peek(token::Kind::RParen);
            inner
        },
        LBracket => try self.parse_buffer_literal_expr(tree),
        _ => {
            try self.error_token("expected expression, got ", self.current_token());
            try tree.add_recovered_expression(token_span_at(self))
        },
    };
}

fn (self: &Parser) retain_literal_expression(
    tree: &var ast::Ast,
    quoted: bool
) -> !ast::Expression {
    let value = try self.retain_current_literal(tree);
    if quoted {
        return try tree.add_expression(ast::ExpressionNode::String(
            ast::StringExpr { value: value }
        ));
    }
    return try tree.add_expression(ast::ExpressionNode::Int(
        ast::IntExpr { value: value }
    ));
}

// Turns the spelling of an integer literal into its decimal value, so that
// `0xFF`, `0b1111_1111`, and `255` reach the checker as one number. A
// spelling that is not a number, or does not fit 64 bits, is a parse error.
fn (self: &var Parser) parse_int_literal_expression(
    tree: &var ast::Ast
) -> !ast::Expression {
    var value = 0;
    if self.current_integer_value() |parsed| {
        value = parsed;
    } else {
        try self.error_invalid_integer();
    }
    var text = string::new(self.allocator);
    errdefer text.deinit(self.allocator);
    try fmt::append_i64(self.allocator, &var text, value);
    let retained = try tree.add_text(move text);
    return try tree.add_expression(ast::ExpressionNode::Int(
        ast::IntExpr { value: retained }
    ));
}

fn (self: &Parser) current_integer_value() -> ?i64 {
    return token_integer_value(self.current_token());
}

fn token_integer_value(current: &token::Token) -> ?i64 {
    let bytes = current.literal.as_bytes();
    return integer_literal_value(bytes);
}

fn (self: &var Parser) error_invalid_integer() -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, "invalid integer literal `");
    let current = self.current_token();
    try entry.message.append_string(self.allocator, &current.literal);
    try entry.message.append_byte(self.allocator, cast<u8>(96));
    return self.record(move entry);
}

// Reads a literal: decimal digits, or `0x` / `0b` and digits of that base,
// with `_` allowed between two digits. There is no octal form, so `017` is
// seventeen. The value must fit a signed 64-bit integer; a `-` in front is
// the unary operator, not part of the literal.
fn integer_literal_value(text: []u8) -> ?i64 {
    var base = 10;
    var index = 0;
    if mem::starts_with(text, "0x") {
        base = 16;
        index = 2;
    } else {
        if mem::starts_with(text, "0b") {
            base = 2;
            index = 2;
        }
    }
    let length = mem::len(text);
    if index >= length {
        return null;
    }
    var value = 0;
    var previous_digit = false;
    while index < length {
        let ch = text[index];
        if ch == cast<u8>(95) {
            if !previous_digit or index + 1 == length {
                return null;
            }
            previous_digit = false;
            index = index + 1;
            continue;
        }
        let digit = digit_value(ch) orelse return null;
        if digit >= base {
            return null;
        }
        if value > (9223372036854775807 - digit) / base {
            return null;
        }
        value = value * base + digit;
        previous_digit = true;
        index = index + 1;
    }
    return value;
}

// Reads one digit in any base up to 16.
fn digit_value(ch: u8) -> ?i64 {
    if ch >= cast<u8>(48) and ch <= cast<u8>(57) {
        return cast<i64>(ch) - 48;
    }
    if ch >= cast<u8>(97) and ch <= cast<u8>(102) {
        return cast<i64>(ch) - 87;
    }
    if ch >= cast<u8>(65) and ch <= cast<u8>(70) {
        return cast<i64>(ch) - 55;
    }
    return null;
}

fn (self: &var Parser) parse_borrow_prefix_expression(
    tree: &var ast::Ast
) -> !ast::Expression {
    try self.next_token();
    var operator = "&";
    if self.current_kind() == token::Kind::Var {
        operator = "&var";
        try self.next_token();
    }
    let retained_operator = try tree.add_text_from_bytes(operator);
    let right = try self.parse_expression(tree, prefix_precedence());
    return try tree.add_expression(ast::ExpressionNode::Prefix(ast::PrefixExpr {
        operator: retained_operator,
        right: right
    }));
}

fn (self: &var Parser) parse_unary_prefix_expression(
    tree: &var ast::Ast
) -> !ast::Expression {
    let operator = try self.retain_current_literal(tree);
    try self.next_token();
    let right = try self.parse_expression(tree, prefix_precedence());
    return try tree.add_expression(ast::ExpressionNode::Prefix(ast::PrefixExpr {
        operator: operator,
        right: right
    }));
}

fn prefix_precedence() -> i64 {
    return 13;
}

fn (self: &var Parser) parse_marker_expression(
    tree: &var ast::Ast
) -> !ast::Expression {
    let marker = self.current_token();
    let marker_kind = marker.kind;
    let marker_span = token_span(marker);
    try self.next_token();
    if marker_kind == token::Kind::Comptime {
        let expression = try self.parse_expression(tree, lowest_precedence());
        return try tree.add_expression(ast::ExpressionNode::Comptime(
            ast::ComptimeExpr { expr: expression }
        ));
    }
    let expression = try self.parse_expression(tree, prefix_precedence());
    if marker_kind == token::Kind::Try {
        return try tree.add_expression(ast::ExpressionNode::Try(
            ast::TryExpr { value: expression }
        ));
    }
    if marker_kind == token::Kind::Move {
        return try tree.add_expression(ast::ExpressionNode::Move(
            ast::MoveExpr { value: expression, span: marker_span }
        ));
    }
    let safety = try self.current_safety_text(tree);
    return try tree.add_expression(ast::ExpressionNode::Unsafe(
        ast::UnsafeExpr {
        value: expression,
        safety: safety,
        span: marker_span
    }
    ));
}

fn (self: &var Parser) current_safety_text(tree: &var ast::Ast) -> !ast::Text {
    if self.safety |value| {
        return ast::Text { node: value.node };
    }
    let empty = try tree.add_empty_text();
    self.safety = empty;
    return empty;
}

fn (self: &var Parser) parse_ident_prefix_expression(
    tree: &var ast::Ast
) -> !ast::Expression {
    let current = self.current_token();
    let cast_name = token_literal_equal(current, "cast");
    if cast_name and
        self.peek_kind() == token::Kind::Lt {
        return self.parse_cast_expr(tree);
    }
    let type_name = token_literal_equal(current, "type");
    if type_name and
        self.peek_kind() == token::Kind::Lt {
        return self.parse_type_expr(tree);
    }
    let starts_upper = token_literal_starts_upper(current);
    if self.peek_kind() == token::Kind::LBrace and
        starts_upper {
        let owned_name = try owned_token_literal(self.allocator, current);
        return self.parse_struct_literal_expr(tree, move owned_name);
    }
    let name = try retain_literal(tree, current);
    return try tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: name,
        span: token_span(current)
    }));
}

fn token_literal_starts_upper(current: &token::Token) -> bool {
    let bytes = current.literal.as_bytes();
    return mem::len(bytes) > 0 and
        bytes[0] >= cast<u8>(65) and bytes[0] <= cast<u8>(90);
}

fn (self: &var Parser) parse_cast_expr(
    tree: &var ast::Ast
) -> !ast::Expression {
    let keyword_span = token_span_at(self);
    if !try self.expect_peek(token::Kind::Lt) {
        return try tree.add_recovered_expression(keyword_span);
    }
    try self.next_token();
    let target_type = try self.parse_type_name(tree) orelse
        return try tree.add_recovered_expression(keyword_span);
    if !try self.expect_peek(token::Kind::Gt) or
        !try self.expect_peek(token::Kind::LParen) {
        return try tree.add_recovered_expression(token_span_at(self));
    }
    try self.next_token();
    let value = try self.parse_expression(tree, lowest_precedence());
    let _ = try self.expect_peek(token::Kind::RParen);
    return try tree.add_expression(ast::ExpressionNode::Cast(ast::CastExpr {
        target_type: target_type,
        value: value,
        keyword_span: keyword_span
    }));
}

// Parses the right side of `orelse` or `catch`: either a default expression
// or a return/break/continue guard that leaves the enclosing function or loop
// on null or failure. The two keywords share one grammar (SPEC §11.1); only
// the node they build differs.
fn (self: &var Parser) parse_guardable_expr(
    tree: &var ast::Ast,
    left: ast::Expression
) -> !ast::Expression {
    let span = token_span_at(self);
    let catch_keyword = self.current_kind() == token::Kind::Catch;
    if self.peek_kind() == token::Kind::Return {
        try self.next_token();
        var value = no_expression();
        if !self.peek_is_expression_end() {
            try self.next_token();
            value = try self.parse_expression(tree, lowest_precedence());
        }
        let exit = try tree.add_statement(ast::StatementNode::Return(
            ast::ReturnStmt { value: value }
        ));
        return add_guard(tree, left, exit, span, catch_keyword);
    }
    if self.peek_kind() == token::Kind::Break {
        try self.next_token();
        let label = try self.parse_optional_branch_label(tree);
        let exit = try tree.add_statement(ast::StatementNode::Break(
            ast::BreakStmt { label: label }
        ));
        return add_guard(tree, left, exit, span, catch_keyword);
    }
    if self.peek_kind() == token::Kind::Continue {
        try self.next_token();
        let label = try self.parse_optional_branch_label(tree);
        let exit = try tree.add_statement(ast::StatementNode::Continue(
            ast::ContinueStmt { label: label }
        ));
        return add_guard(tree, left, exit, span, catch_keyword);
    }
    return self.parse_binary_expr(tree, left);
}

fn add_guard(
    tree: &var ast::Ast,
    condition: ast::Expression,
    exit: ast::Statement,
    span: ast::Span,
    catch_keyword: bool
) -> !ast::Expression {
    if catch_keyword {
        return try tree.add_expression(ast::ExpressionNode::CatchGuard(
            ast::CatchGuardExpr {
            condition: condition,
            exit: exit,
            span: span
        }
        ));
    }
    return try tree.add_expression(ast::ExpressionNode::OrelseGuard(
        ast::OrelseGuardExpr {
        condition: condition,
        exit: exit,
        span: span
    }
    ));
}

fn (self: &var Parser) parse_binary_expr(
    tree: &var ast::Ast,
    left: ast::Expression
) -> !ast::Expression {
    let current = self.current_token();
    let operator = try retain_literal(tree, current);
    let operator_span = token_span(current);
    let binding_power = self.current_precedence();
    try self.next_token();
    let right = try self.parse_expression(tree, binding_power);
    return try tree.add_expression(ast::ExpressionNode::Binary(
        ast::BinaryExpr {
        left: left,
        operator: operator,
        operator_span: operator_span,
        right: right
    }
    ));
}

// Parses `<<` or `>>` from the two adjacent tokens at the lookahead.
fn (self: &var Parser) parse_shift_expr(
    tree: &var ast::Ast,
    left: ast::Expression
) -> !ast::Expression {
    try self.next_token();
    let first = self.current_token();
    var operator_span = token_span(first);
    operator_span.end.column = operator_span.end.column + 1;
    var spelling = "<<";
    if first.kind == token::Kind::Gt {
        spelling = ">>";
    }
    let operator = try tree.add_text_from_bytes(spelling);
    try self.next_token();
    try self.next_token();
    let right = try self.parse_expression(tree, shift_precedence());
    return try tree.add_expression(ast::ExpressionNode::Binary(
        ast::BinaryExpr {
        left: left,
        operator: operator,
        operator_span: operator_span,
        right: right
    }
    ));
}

fn (self: &var Parser) parse_call_expr(
    tree: &var ast::Ast,
    callee: ast::Expression
) -> !ast::Expression {
    var args = array::new<ast::Expression>(self.allocator);
    errdefer args.deinit(self.allocator);
    if self.peek_kind() == token::Kind::RParen {
        try self.next_token();
    } else {
        try self.next_token();
        try args.append(self.allocator, try self.parse_expression(tree, lowest_precedence()));
        while self.peek_kind() == token::Kind::Comma {
            try self.next_token();
            if self.peek_kind() == token::Kind::RParen {
                break;
            }
            try self.next_token();
            try args.append(self.allocator, try self.parse_expression(tree, lowest_precedence()));
        }
        let _ = try self.expect_peek(token::Kind::RParen);
    }
    let retained_args = try tree.add_expression_list(move args);
    return try tree.add_expression(ast::ExpressionNode::Call(ast::CallExpr {
        callee: callee,
        args: retained_args
    }));
}

fn (self: &var Parser) parse_struct_literal_expr(
    tree: &var ast::Ast,
    type_name: string::String
) -> !ast::Expression {
    let retained_type = try tree.add_text(move type_name);
    let span = token_span_at(self);
    var fields = array::new<ast::FieldValue>(self.allocator);
    errdefer fields.deinit(self.allocator);
    try self.next_token();
    try self.next_token();
    while self.current_kind() != token::Kind::RBrace and
        self.current_kind() != token::Kind::Eof {
        if try self.parse_field_value(tree) |field| {
            try fields.append(self.allocator, field);
        } else {
            fields.deinit(self.allocator);
            return try tree.add_recovered_expression(span);
        }
        if !try self.consume_list_delimiter("struct literal field") {
            fields.deinit(self.allocator);
            return try tree.add_recovered_expression(span);
        }
        try self.next_token();
    }
    try self.expect_list_close("struct literal", "");
    return try tree.add_expression(ast::ExpressionNode::StructLiteral(
        ast::StructLiteralExpr {
        type_name: retained_type,
        fields: move fields,
        span: span
    }
    ));
}

fn (self: &var Parser) parse_field_value(
    tree: &var ast::Ast
) -> !?ast::FieldValue {
    if self.current_kind() != token::Kind::Ident {
        try self.error_token("expected field name, got ", self.current_token());
        return null;
    }
    let name = try self.retain_current_literal(tree);
    if !try self.expect_peek(token::Kind::Colon) {
        return null;
    }
    try self.next_token();
    let value = try self.parse_expression(tree, lowest_precedence());
    return ast::FieldValue { name: name, value: value };
}

fn (self: &var Parser) parse_type_expr(
    tree: &var ast::Ast
) -> !ast::Expression {
    if !try self.expect_peek(token::Kind::Lt) {
        return try tree.add_recovered_expression(token_span_at(self));
    }
    try self.next_token();
    let spelling = try self.parse_static_type_arg(tree, false) orelse
        return try tree.add_recovered_expression(token_span_at(self));
    let type_name = try tree.add_text(move spelling);
    let expression = try tree.add_expression(ast::ExpressionNode::Type(
        ast::TypeExpr { type_name: type_name }
    ));
    let _ = try self.expect_type_close();
    return expression;
}

fn (self: &var Parser) parse_type_apply_expr(
    tree: &var ast::Ast,
    callee: ast::Expression
) -> !ast::Expression {
    try self.next_token();
    let spelling = try self.parse_type_arg_list(tree, false) orelse
        return try tree.add_recovered_expression(token_span_at(self));
    let type_arg = try tree.add_text(move spelling);
    let expression = try tree.add_expression(ast::ExpressionNode::TypeApply(
        ast::TypeApplyExpr { callee: callee, type_arg: type_arg }
    ));
    let _ = try self.expect_type_close();
    return expression;
}

fn (self: &var Parser) parse_field_expr(
    tree: &var ast::Ast,
    receiver: ast::Expression,
    namespace: bool
) -> !ast::Expression {
    if !namespace and self.peek_kind() == token::Kind::Asterisk {
        try self.next_token();
        return try tree.add_expression(ast::ExpressionNode::Deref(
            ast::DerefExpr {
            receiver: receiver,
            operator_span: token_span_at(self)
        }
        ));
    }
    if !try self.expect_peek(token::Kind::Ident) {
        return try tree.add_recovered_expression(token_span_at(self));
    }
    let name = try retain_literal(tree, self.current_token());
    let span = join_spans(expression_span(tree, receiver), token_span_at(self));
    return try tree.add_expression(ast::ExpressionNode::Field(ast::FieldExpr {
        receiver: receiver,
        name: name,
        namespace: namespace,
        span: span
    }));
}

fn (self: &Parser) struct_literal_type_name(
    allocator: Allocator,
    tree: &ast::Ast,
    expression: ast::Expression
) -> !?string::String {
    var parts = array::new<ast::Text>(allocator);
    defer parts.deinit(allocator);
    if !try namespace_expr_parts(allocator, tree, expression, &var parts) or
        parts.len() == 0 {
        return null;
    }
    let last = parts.get_or_panic(parts.len() - 1);
    if !text_starts_upper(tree, last) {
        return null;
    }
    if parts.len() > 1 {
        let previous = parts.get_or_panic(parts.len() - 2);
        if text_starts_upper(tree, previous) {
            return null;
        }
    }
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    var index = 0;
    while index < parts.len() {
        if index > 0 {
            try name.append_bytes(allocator, "::");
        }
        let part = parts.get_or_panic(index);
        try append_retained_text(allocator, &var name, tree, part);
        index = index + 1;
    }
    return move name;
}

fn namespace_expr_parts(

    allocator: Allocator,
    tree: &ast::Ast,
    expression: ast::Expression,
    parts: &var array::Array<ast::Text>
) -> !bool {
    match tree.expressions.at(expression.node) {
        Ident(value) => {
            try parts.append(allocator, value.name);
            return true;
        },
        Field(value) => {
            if !value.namespace or
                !try namespace_expr_parts(allocator, tree, value.receiver, parts) {
                return false;
            }
            try parts.append(allocator, value.name);
            return true;
        },
        _ => return false,
    }
}

fn text_starts_upper(tree: &ast::Ast, value: ast::Text) -> bool {
    let retained = tree.texts.at(value.node);
    let bytes = retained.as_bytes();
    return mem::len(bytes) > 0 and
        bytes[0] >= cast<u8>(65) and bytes[0] <= cast<u8>(90);
}

fn (self: &var Parser) parse_buffer_literal_expr(
    tree: &var ast::Ast
) -> !ast::Expression {
    let span = token_span_at(self);
    let type_name = try self.parse_type_name(tree) orelse
        return try tree.add_recovered_expression(span);
    match typ::root_node(&tree.types, type_name) {
        Buffer(buffer) => {
            let elem_type = typ::child_type(type_name, buffer.elem);
            let elem = try typ::render(self.allocator, &tree.types, elem_type);
            defer elem.deinit(self.allocator);
            if !string_equals_bytes(&elem, "u8") {
                try self.error_value("buffer element must be u8, got ", &elem, "");
                return try tree.add_recovered_expression(span);
            }
            if !try self.expect_peek(token::Kind::LBrace) or
                !try self.expect_peek(token::Kind::RBrace) {
                return try tree.add_recovered_expression(span);
            }
            return try tree.add_expression(ast::ExpressionNode::BufferLiteral(
                ast::BufferLiteralExpr { size: buffer.size, span: span }
            ));
        },
        _ => {},
    }
    let rendered = try typ::render(self.allocator, &tree.types, type_name);
    defer rendered.deinit(self.allocator);
    try self.error_value(
        "expected buffer literal `[N]u8{}`, got type `",
        &rendered,
        "`"
    );
    return try tree.add_recovered_expression(span);
}

fn string_equals_bytes(value: &string::String, expected: []u8) -> bool {
    let bytes = value.as_bytes();
    return mem::equal_bytes(bytes, expected);
}

fn token_span_at(parser: &Parser) -> ast::Span {
    return token_span(parser.current_token());
}

fn (self: &var Parser) parse_payload_capture(
    tree: &var ast::Ast
) -> !?ast::Text {
    if self.peek_kind() != token::Kind::Pipe {
        let empty = try tree.add_empty_text();
        return empty;
    }
    if !try self.expect_peek(token::Kind::Pipe) or
        !try self.expect_peek(token::Kind::Ident) {
        return null;
    }
    if !try self.expect_peek(token::Kind::Pipe) {
        return null;
    }
    let handle = self.stream.get_or_panic(self.position - 1);
    let capture = try retain_literal(tree, self.tokens.at(handle));
    return capture;
}

fn (self: &var Parser) parse_variant_capture(
    tree: &var ast::Ast
) -> !?array::Array<ast::Text> {
    if self.peek_kind() != token::Kind::Pipe {
        return array::new<ast::Text>(self.allocator);
    }
    if !try self.expect_peek(token::Kind::Pipe) or
        !try self.expect_peek(token::Kind::Ident) {
        return null;
    }
    let first_handle = self.stream.get_or_panic(self.position);
    if self.peek_kind() == token::Kind::Comma {
        try self.next_token();
        if !try self.expect_peek(token::Kind::Ident) {
            return null;
        }
        let second_handle = self.stream.get_or_panic(self.position);
        if !try self.expect_peek(token::Kind::Pipe) {
            return null;
        }
        var captures = array::new<ast::Text>(self.allocator);
        errdefer captures.deinit(self.allocator);
        let first = try retain_literal(tree, self.tokens.at(first_handle));
        try captures.append(self.allocator, first);
        let second = try retain_literal(tree, self.tokens.at(second_handle));
        try captures.append(self.allocator, second);
        return move captures;
    }
    if !try self.expect_peek(token::Kind::Pipe) {
        return null;
    }
    var captures = array::new<ast::Text>(self.allocator);
    errdefer captures.deinit(self.allocator);
    let first = try retain_literal(tree, self.tokens.at(first_handle));
    try captures.append(self.allocator, first);
    return move captures;
}

fn (self: &var Parser) parse_type_name(tree: &var ast::Ast) -> !?typ::Type {
    var builder = typ::new_builder(self.allocator);
    errdefer builder.deinit(self.allocator);
    let parsed = try self.parse_type_node(&var builder);
    if parsed |root| {
        return try typ::finish_builder(self.allocator, move builder, &var tree.types, root);
    }
    builder.deinit(self.allocator);
    return null;
}

fn (self: &var Parser) parse_type_node(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    match self.current_kind() {
        Bang => return self.parse_error_union_type(builder),
        Amp => return self.parse_borrow_type(builder),
        LBracket => return self.parse_bracket_type(builder),
        Question => return self.parse_optional_type(builder),
        Function => return self.parse_func_type(builder, false),
        Unsafe => return self.parse_unsafe_func_type(builder),
        Ident => return self.parse_named_type(builder),
        _ => {
            try self.error_token("expected type, got ", self.current_token());
            return null;
        },
    }
    return null;
}

// parse_unsafe_func_type reads `unsafe fn(...) -> T`. `unsafe` in a type
// position names the obligation the function it points at carries, so nothing
// else may follow it.
fn (self: &var Parser) parse_unsafe_func_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    if self.peek_kind() != token::Kind::Function {
        try self.error_token("expected `fn` after `unsafe` in a type, got ", self.peek_token());
        return null;
    }
    try self.next_token();
    return self.parse_func_type(builder, true);
}

// parse_func_type reads `fn(T, ...) -> R` with the current token on the `fn`.
fn (self: &var Parser) parse_func_type(
    builder: &var typ::Builder,
    unsafe_call: bool
) -> !?arena::Handle<typ::Node> {
    if self.peek_kind() != token::Kind::LParen {
        try self.error_token("expected `(` after `fn` in a type, got ", self.peek_token());
        return null;
    }
    try self.next_token();
    var params = array::new<arena::Handle<typ::Node>>(self.allocator);
    errdefer params.deinit(self.allocator);
    if self.peek_kind() != token::Kind::RParen {
        while true {
            try self.next_token();
            let parsed = try self.parse_type_node(builder);
            if parsed |param| {
                try params.append(self.allocator, param);
            } else {
                params.deinit(self.allocator);
                return null;
            }
            if self.peek_kind() != token::Kind::Comma {
                break;
            }
            try self.next_token();
        }
    }
    if self.peek_kind() != token::Kind::RParen {
        try self.error_token("expected `)` in a function type, got ", self.peek_token());
        params.deinit(self.allocator);
        return null;
    }
    try self.next_token();
    if self.peek_kind() != token::Kind::Arrow {
        try self.error_token("expected `->` in a function type, got ", self.peek_token());
        params.deinit(self.allocator);
        return null;
    }
    try self.next_token();
    try self.next_token();
    let parsed = try self.parse_type_node(builder);
    if parsed |result| {
        return try builder.add(typ::Node::Func(typ::Func {
            params: move params,
            result: result,
            unsafe_call: unsafe_call
        }));
    }
    params.deinit(self.allocator);
    return null;
}

fn (self: &var Parser) parse_optional_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    try self.next_token();
    let parsed = try self.parse_type_node(builder);
    if parsed |inner| {
        return try builder.add(typ::Node::Optional(typ::Optional {
            elem: inner
        }));
    }
    return null;
}

fn (self: &var Parser) parse_error_union_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    try self.next_token();
    let parsed = try self.parse_type_node(builder);
    if parsed |ok| {
        return try builder.add(typ::Node::ErrorUnion(typ::ErrorUnion {
            err: null,
            ok: ok
        }));
    }
    return null;
}

fn (self: &var Parser) parse_borrow_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    try self.next_token();
    let mutable = self.current_kind() == token::Kind::Var;
    if mutable {
        try self.next_token();
    }
    let parsed = try self.parse_type_node(builder);
    if parsed |inner| {
        return try builder.add(typ::Node::Borrow(typ::Borrow {
            elem: inner,
            mutable: mutable
        }));
    }
    return null;
}

fn (self: &var Parser) parse_named_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    var path = try self.parse_type_path();
    errdefer path.deinit(self.allocator);
    let allow_const = type_path_is_ptr(&path);
    if self.peek_kind() == token::Kind::Bang {
        let args = array::new<arena::Handle<typ::Node>>(self.allocator);
        let err = try builder.add(typ::Node::Name(typ::Name {
            path: move path,
            args: move args
        }));
        try self.next_token();
        try self.next_token();
        let parsed = try self.parse_type_node(builder);
        if parsed |ok| {
            return try builder.add(typ::Node::ErrorUnion(typ::ErrorUnion {
                err: err,
                ok: ok
            }));
        }
        return null;
    }
    if self.peek_kind() != token::Kind::Lt {
        let args = array::new<arena::Handle<typ::Node>>(self.allocator);
        return try builder.add(typ::Node::Name(typ::Name {
            path: move path,
            args: move args
        }));
    }
    var args = array::new<arena::Handle<typ::Node>>(self.allocator);
    errdefer args.deinit(self.allocator);
    try self.next_token();
    try self.next_token();
    if !try self.parse_type_arguments(builder, &var args, allow_const) or
        !try self.expect_type_close() {
        args.deinit(self.allocator);
        path.deinit(self.allocator);
        return null;
    }
    return try builder.add(typ::Node::Name(typ::Name {
        path: move path,
        args: move args
    }));
}

fn (self: &var Parser) parse_type_path() -> !array::Array<string::String> {
    var path = array::new<string::String>(self.allocator);
    errdefer path.deinit(self.allocator);
    try path.append(self.allocator, try owned_token_literal(self.allocator,
        self.current_token()
    ));
    while self.peek_kind() == token::Kind::DoubleColon {
        try self.next_token();
        if !try self.expect_peek(token::Kind::Ident) {
            return move path;
        }
        try path.append(self.allocator, try owned_token_literal(self.allocator,
            self.current_token()
        ));
    }
    return move path;
}

fn (self: &var Parser) parse_type_arguments(
    builder: &var typ::Builder,
    args: &var array::Array<arena::Handle<typ::Node>>,
    allow_const: bool
) -> !bool {
    while true {
        let parsed = try self.parse_type_argument(builder, allow_const);
        if parsed |arg| {
            try args.append(self.allocator, arg);
        } else {
            return false;
        }
        if self.peek_kind() != token::Kind::Comma {
            return true;
        }
        try self.next_token();
        if self.peek_kind() == token::Kind::Gt {
            return true;
        }
        try self.next_token();
    }
    return true;
}

fn (self: &var Parser) parse_type_arg_list(
    tree: &var ast::Ast,
    allow_const: bool
) -> !?string::String {
    var out = string::new(self.allocator);
    errdefer out.deinit(self.allocator);
    var first = true;
    while true {
        if try self.parse_static_type_arg(tree, allow_const) |arg| {
            defer arg.deinit(self.allocator);
            if !first {
                try out.append_bytes(self.allocator, ", ");
            }
            let bytes = arg.as_bytes();
            try out.append_bytes(self.allocator, bytes);
            first = false;
        } else {
            out.deinit(self.allocator);
            return null;
        }
        if self.peek_kind() != token::Kind::Comma {
            return move out;
        }
        try self.next_token();
        if self.peek_kind() == token::Kind::Gt {
            return move out;
        }
        try self.next_token();
    }
    return move out;
}

fn (self: &var Parser) parse_generic_param_list(
    tree: &var ast::Ast
) -> !?array::Array<ast::Text> {
    if try self.parse_static_param_list(tree) |params| {
        defer params.deinit(self.allocator);
        var names = array::new<ast::Text>(self.allocator);
        errdefer names.deinit(self.allocator);
        var index = 0;
        while params.at(index) |param| {
            if !param.is_type() {
                try self.error_expected_type_param(tree, param);
                names.deinit(self.allocator);
                return null;
            }
            try names.append(self.allocator, param.name);
            index = index + 1;
        }
        return move names;
    }
    return null;
}

fn (self: &var Parser) parse_static_param_list(
    tree: &var ast::Ast
) -> !?array::Array<ast::StaticParam> {
    var params = array::new<ast::StaticParam>(self.allocator);
    errdefer params.deinit(self.allocator);
    var seen = map::new<[]u8, bool>(self.allocator);
    defer seen.deinit(self.allocator);
    try self.next_token();
    while true {
        let current = self.current_token();
        if current.kind != token::Kind::Ident {
            try self.error_token("expected static parameter, got ", current);
            params.deinit(self.allocator);
            return null;
        }
        if static_param_seen(&seen, current) {
            try self.error_literal("duplicate static parameter ", current);
            params.deinit(self.allocator);
            return null;
        }
        try retain_static_param_name(self.allocator, &var seen, current);
        let name = try retain_literal(tree, current);
        if self.peek_kind() == token::Kind::Colon {
            try self.next_token();
            try self.next_token();
            let type_name = try self.parse_type_name(tree);
            try params.append(self.allocator, ast::StaticParam {
                name: name,
                type_name: type_name
            });
        } else {
            try params.append(self.allocator, ast::StaticParam {
                name: name,
                type_name: null
            });
        }
        if self.peek_kind() != token::Kind::Comma {
            return move params;
        }
        try self.next_token();
        if self.peek_kind() == token::Kind::Gt {
            return move params;
        }
        try self.next_token();
    }
    return move params;
}

fn static_param_seen(
    seen: &map::Map<[]u8, bool>,
    current: &token::Token
) -> bool {
    let key = current.literal.as_bytes();
    return seen.contains(key);
}

fn retain_static_param_name(

    allocator: Allocator,
    seen: &var map::Map<[]u8, bool>,
    current: &token::Token
) -> !void {
    let key = current.literal.as_bytes();
    return seen.insert(allocator, key, true);
}

fn append_retained_text(

    allocator: Allocator,
    out: &var string::String,
    tree: &ast::Ast,
    value: ast::Text
) -> !void {
    return append_retained_string(allocator, out, tree.texts.at(value.node));
}

fn append_retained_string(

    allocator: Allocator,
    out: &var string::String,
    retained: &string::String
) -> !void {
    let bytes = retained.as_bytes();
    return out.append_bytes(allocator, bytes);
}

fn (self: &var Parser) parse_static_type_arg(
    tree: &var ast::Ast,
    allow_const: bool
) -> !?string::String {
    let kind = self.current_kind();
    if kind == token::Kind::Ident or
        kind == token::Kind::Bang or
        kind == token::Kind::Amp or
        kind == token::Kind::LBracket or
        kind == token::Kind::Question {
        var builder = typ::new_builder(self.allocator);
        errdefer builder.deinit(self.allocator);
        let parsed = try self.parse_type_argument(&var builder, allow_const);
        if parsed |root| {
            let type_name = try typ::finish_builder(self.allocator,
                move builder,
                &var tree.types,
                root
            );
            return try typ::render(self.allocator, &tree.types, type_name);
        }
        builder.deinit(self.allocator);
        return null;
    }
    if kind == token::Kind::Int or
        kind == token::Kind::True or
        kind == token::Kind::False {
        return try owned_token_literal(self.allocator, self.current_token());
    }
    try self.error_token("expected static argument, got ", self.current_token());
    return null;
}

fn (self: &var Parser) parse_type_argument(
    builder: &var typ::Builder,
    allow_const: bool
) -> !?arena::Handle<typ::Node> {
    let is_const = self.current_kind() == token::Kind::Ident and
        token_literal_equal(self.current_token(), "const");
    if !is_const {
        return self.parse_type_node(builder);
    }
    if !allow_const {
        try self.error_text("expected static type argument, got const");
        return null;
    }
    try self.next_token();
    let parsed = try self.parse_type_node(builder);
    if parsed |inner| {
        return try builder.add(typ::Node::Const(typ::Const { elem: inner }));
    }
    return null;
}

fn (self: &var Parser) parse_bracket_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    if self.peek_kind() == token::Kind::Int {
        return self.parse_buffer_type(builder);
    }
    if !try self.expect_peek(token::Kind::RBracket) {
        return null;
    }
    try self.next_token();
    let parsed = try self.parse_type_argument(builder, false);
    if parsed |elem| {
        return try builder.add(typ::Node::Slice(typ::Slice { elem: elem }));
    }
    return null;
}

fn (self: &var Parser) parse_buffer_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    try self.next_token();
    let current = self.current_token();
    var size = 0;
    if positive_decimal(current) |parsed| {
        size = parsed;
    } else {
        try self.error_literal("buffer size must be a positive integer, got ", current);
        return null;
    }
    if !try self.expect_peek(token::Kind::RBracket) {
        return null;
    }
    try self.next_token();
    let parsed = try self.parse_type_argument(builder, false);
    if parsed |elem| {
        return try builder.add(typ::Node::Buffer(typ::Buffer {
            size: size,
            elem: elem
        }));
    }
    return null;
}

fn owned_token_literal(
    allocator: Allocator,
    current: &token::Token
) -> !string::String {
    let bytes = current.literal.as_bytes();
    return string::from_bytes(allocator, bytes);
}

fn token_literal_equal(current: &token::Token, expected: []u8) -> bool {
    let bytes = current.literal.as_bytes();
    return mem::equal_bytes(bytes, expected);
}

fn type_path_is_ptr(path: &array::Array<string::String>) -> bool {
    if path.len() != 1 {
        return false;
    }
    if path.at(0) |part| {
        let bytes = part.as_bytes();
        return mem::equal_bytes(bytes, "ptr");
    }
    return false;
}

fn positive_decimal(current: &token::Token) -> ?i64 {
    let bytes = current.literal.as_bytes();
    var value = 0;
    var index = 0;
    while index < mem::len(bytes) {
        let digit = cast<i64>(bytes[index] - cast<u8>(48));
        if value > (9223372036854775807 - digit) / 10 {
            return null;
        }
        value = value * 10 + digit;
        index = index + 1;
    }
    if value <= 0 {
        return null;
    }
    return value;
}

fn (self: &var Parser) error_expected_declaration() -> !void {
    let prefix = "expected declaration (fn, test, import, struct, enum, union, contract, impl, extern, export, pub, or unsafe), got ";
    return self.error_token(prefix, self.current_token());
}

/// Starts one error diagnostic at the current token with an empty message.
fn (self: &Parser) error_entry() -> !diagnostic::Diagnostic {
    return diagnostic_at_token(self.allocator, self.current_token(), "");
}

/// Stores one finished error diagnostic.
fn (self: &var Parser) record(entry: diagnostic::Diagnostic) -> !void {
    return self.diagnostics_store.append(self.allocator, move entry);
}

/// Records `text` as an error at the current token.
fn (self: &var Parser) error_text(text: []u8) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, text);
    return self.record(move entry);
}

/// Records `prefix` followed by `context` as an error at the current token.
fn (self: &var Parser) error_context(prefix: []u8, context: []u8) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, prefix);
    try entry.message.append_bytes(self.allocator, context);
    return self.record(move entry);
}

/// Records `prefix` followed by the description of `actual`.
fn (self: &var Parser) error_token(prefix: []u8, actual: &token::Token) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, prefix);
    try append_token_description(self.allocator, &var entry.message, actual);
    return self.record(move entry);
}

/// Records `expected <label>, got <actual>`.
fn (self: &var Parser) error_expected(label: []u8, actual: &token::Token) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, "expected ");
    try entry.message.append_bytes(self.allocator, label);
    try entry.message.append_bytes(self.allocator, ", got ");
    try append_token_description(self.allocator, &var entry.message, actual);
    return self.record(move entry);
}

/// Records `<prefix><expected kind>, got <actual>`.
fn (self: &var Parser) error_expected_kind(
    prefix: []u8,
    expected: token::Kind,
    actual: &token::Token
) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, prefix);
    try append_token_type_description(self.allocator, &var entry.message, expected);
    try entry.message.append_bytes(self.allocator, ", got ");
    try append_token_description(self.allocator, &var entry.message, actual);
    return self.record(move entry);
}

/// Records `prefix` followed by the literal bytes of `actual`.
fn (self: &var Parser) error_literal(prefix: []u8, actual: &token::Token) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, prefix);
    let bytes = actual.literal.as_bytes();
    try entry.message.append_bytes(self.allocator, bytes);
    return self.record(move entry);
}

/// Records `<prefix><value><suffix>`.
fn (self: &var Parser) error_value(
    prefix: []u8,
    value: &string::String,
    suffix: []u8
) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, prefix);
    let bytes = value.as_bytes();
    try entry.message.append_bytes(self.allocator, bytes);
    try entry.message.append_bytes(self.allocator, suffix);
    return self.record(move entry);
}

/// Records the `impl <contract> for <type>;` hint for an impl without `for`.
fn (self: &var Parser) error_impl_missing_for(contract_token: &token::Token) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, "expected `impl <contract> for ");
    let name = contract_token.literal.as_bytes();
    try entry.message.append_bytes(self.allocator, name);
    try entry.message.append_bytes(self.allocator, ";`; a method on a type is `fn (self: ");
    try entry.message.append_bytes(self.allocator, name);
    try entry.message.append_bytes(self.allocator, ") name(...)`");
    return self.record(move entry);
}

/// Records the no-body rule for `impl <contract> for <type> { ... }`.
fn (self: &var Parser) error_impl_body(
    contract_token: &token::Token,
    type_token: &token::Token
) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    let contract_name = contract_token.literal.as_bytes();
    let type_name = type_token.literal.as_bytes();
    try entry.message.append_bytes(self.allocator, "`impl ");
    try entry.message.append_bytes(self.allocator, contract_name);
    try entry.message.append_bytes(self.allocator, " for ");
    try entry.message.append_bytes(self.allocator, type_name);
    try entry.message.append_bytes(self.allocator, "` takes no body; write the methods as `fn (self: ");
    try entry.message.append_bytes(self.allocator, type_name);
    try entry.message.append_bytes(self.allocator, ") name(...)` and end this with `;`");
    return self.record(move entry);
}

/// Records `expected type parameter, got <param>`.
fn (self: &var Parser) error_expected_type_param(
    tree: &ast::Ast,
    param: &ast::StaticParam
) -> !void {
    var entry = try self.error_entry();
    errdefer entry.deinit(self.allocator);
    try entry.message.append_bytes(self.allocator, "expected type parameter, got ");
    try ast::append_static_param(self.allocator, &var entry.message, tree, param);
    return self.record(move entry);
}

fn append_token_description(

    allocator: Allocator,
    out: &var string::String,
    actual: &token::Token
) -> !void {
    let literal = actual.literal.as_bytes();
    let class = token_class_description(actual.kind);
    if mem::len(class) > 0 {
        try out.append_bytes(allocator, class);
        try out.append_byte(allocator, cast<u8>(32));
        return fmt::append_bytes_literal(allocator, out, literal);
    }
    if actual.kind == token::Kind::Illegal {
        try out.append_bytes(allocator, "illegal token");
        if mem::len(literal) > 0 {
            try out.append_byte(allocator, cast<u8>(32));
            try fmt::append_bytes_literal(allocator, out, literal);
        }
        return;
    }
    if actual.kind == token::Kind::Eof {
        return out.append_bytes(allocator, "end of file");
    }
    try out.append_byte(allocator, cast<u8>(96));
    try out.append_bytes(allocator, literal);
    return out.append_byte(allocator, cast<u8>(96));
}

fn append_token_type_description(

    allocator: Allocator,
    out: &var string::String,
    kind: token::Kind
) -> !void {
    let class = token_class_description(kind);
    if mem::len(class) > 0 {
        return out.append_bytes(allocator, class);
    }
    if kind == token::Kind::Eof {
        return out.append_bytes(allocator, "end of file");
    }
    try out.append_byte(allocator, cast<u8>(96));
    try out.append_bytes(allocator, token::spelling(kind));
    return out.append_byte(allocator, cast<u8>(96));
}

fn token_class_description(kind: token::Kind) -> []u8 {
    return match kind {
        Ident => "identifier",
        Int => "integer",
        String => "string",
        _ => "",
    };
}

fn lowest_precedence() -> i64 {
    return 1;
}

// Returns the Pratt binding power for kind, or the lowest power when kind is
// not an infix or postfix operator.
fn precedence(kind: token::Kind) -> i64 {
    return match kind {
        Orelse => 2,
        Catch => 2,
        Or => 3,
        And => 4,
        Eq => 5,
        NotEq => 5,
        Lt => 6,
        Lte => 6,
        Gt => 6,
        Gte => 6,
        Pipe => 7,
        Caret => 8,
        Amp => 9,
        Plus => 11,
        Minus => 11,
        Asterisk => 12,
        Slash => 12,
        Percent => 12,
        LParen => 14,
        LBracket => 14,
        Dot => 15,
        DoubleColon => 15,
        _ => lowest_precedence(),
    };
}

// The binding power of `<<` and `>>`, which are two tokens and so have no
// row in `precedence`.
fn shift_precedence() -> i64 {
    return 10;
}

fn (self: &Parser) current_precedence() -> i64 {
    return precedence(self.current_kind());
}

// Returns the binding power of the lookahead. A `<` `<` or `>` `>` pair is a
// shift, and a `|` that opens a payload capture binds nothing.
fn (self: &var Parser) peek_precedence() -> !i64 {
    if try self.shift_pair() {
        return shift_precedence();
    }
    if try self.capture_ahead() {
        return lowest_precedence();
    }
    return precedence(self.peek_kind());
}

// Scans until the token at `offset` past the current one is in the stream.
fn (self: &var Parser) ensure_lookahead(offset: i64) -> !void {
    let allocator = self.allocator;
    while self.position + offset >= self.stream.len() {
        try append_next_token(allocator,
            &var self.scanner,
            &var self.tokens,
            &var self.stream
        );
    }
    return;
}

fn (self: &Parser) token_at(offset: i64) -> &token::Token {
    let handle = self.stream.get_or_panic(self.position + offset);
    return self.tokens.at(handle);
}

fn (self: &var Parser) kind_at(offset: i64) -> !token::Kind {
    try self.ensure_lookahead(offset);
    return self.token_at(offset).kind;
}

// Reports whether the lookahead and the token after it spell `<<` or `>>`:
// the same character twice with nothing between them. The scanner keeps
// them apart so that `Array<Array<T>>` still closes two argument lists.
fn (self: &var Parser) shift_pair() -> !bool {
    let kind = self.peek_kind();
    if kind != token::Kind::Lt and kind != token::Kind::Gt {
        return false;
    }
    try self.ensure_lookahead(2);
    let first = self.peek_token();
    let second = self.token_at(2);
    return second.kind == kind and second.line == first.line and
        second.column == first.column + 1;
}

// Reports whether the lookahead starts a payload capture: `|name| {`, or
// `|name, name| {` for a variant capture. Any other `|` after an expression
// is the bitwise or, since no operand can begin with `{`.
fn (self: &var Parser) capture_ahead() -> !bool {
    if self.peek_kind() != token::Kind::Pipe {
        return false;
    }
    let first = try self.kind_at(2);
    if first != token::Kind::Ident {
        return false;
    }
    var offset = 3;
    while true {
        let separator = try self.kind_at(offset);
        if separator != token::Kind::Comma {
            break;
        }
        let name = try self.kind_at(offset + 1);
        if name != token::Kind::Ident {
            break;
        }
        offset = offset + 2;
    }
    let close = try self.kind_at(offset);
    let open = try self.kind_at(offset + 1);
    return close == token::Kind::Pipe and open == token::Kind::LBrace;
}

// Reports whether lookahead closes an optional expression value.
fn (self: &Parser) peek_is_expression_end() -> bool {
    return match self.peek_kind() {
        Semicolon => true,
        Comma => true,
        RBrace => true,
        RParen => true,
        RBracket => true,
        _ => false,
    };
}

// Reports whether `<...>` after expression is a static call argument list.
fn (self: &var Parser) should_parse_type_apply(
    tree: &ast::Ast,
    expression: ast::Expression
) -> !bool {
    if !can_type_apply_target(tree, expression) {
        return false;
    }
    return self.type_apply_looks_like_call();
}

// Scans through a possible static argument list, then restores the token and
// diagnostic cursors so the real parse sees the same state. A lexer allocation
// failure remains terminal for the parse because scanning may already have
// advanced; the caller propagates it and destroys the Parser.
fn (self: &var Parser) type_apply_looks_like_call() -> !bool {
    let position = self.position;
    let diagnostic_count = self.diagnostics_store.len();
    let decision = self.scan_type_apply_lookahead();
    self.restore_lookahead(position, diagnostic_count);
    return move decision;
}

fn (self: &var Parser) scan_type_apply_lookahead() -> !bool {
    try self.next_token();
    var depth = 1;
    while depth > 0 {
        try self.next_token();
        let kind = self.current_kind();
        if kind == token::Kind::Eof or
            kind == token::Kind::Semicolon or
            kind == token::Kind::LBrace or
            kind == token::Kind::RBrace {
            return false;
        }
        if kind == token::Kind::Lt {
            depth = depth + 1;
        }
        if kind == token::Kind::Gt {
            depth = depth - 1;
        }
    }
    return self.peek_kind() == token::Kind::LParen;
}

fn (self: &var Parser) restore_lookahead(
    position: i64,
    diagnostic_count: i64
) -> void {
    self.position = position;
    while self.diagnostics_store.len() > diagnostic_count {
        let abandoned = self.diagnostics_store.pop_or_panic();
        abandoned.deinit(self.allocator);
    }
    return;
}

// Reports whether expression may receive static call arguments.
fn can_type_apply_target(tree: &ast::Ast, expression: ast::Expression) -> bool {
    match tree.expressions.at(expression.node) {
        Field(value) => return value.namespace,
        Ident(value) => return retained_text_has_bytes(&tree.texts, value.name),
        _ => return false,
    }
}

fn retained_text_has_bytes(
    texts: &arena::Arena<string::String>,
    value: ast::Text
) -> bool {
    return retained_string_has_bytes(texts.at(value.node));
}

fn retained_string_has_bytes(value: &string::String) -> bool {
    return value.len() > 0;
}

// Builds a half-open diagnostic span from the current parser token.
fn diagnostic_at_token(
    allocator: Allocator,
    current: &token::Token,
    message: []u8
) -> !diagnostic::Diagnostic {
    return diagnostic::new(
        allocator,
        diagnostic::Severity::Error,
        "",
        token_span(current),
        message
    );
}

// Converts a token position into a half-open AST span.
fn token_span(current: &token::Token) -> ast::Span {
    let width = token_width(current);
    return ast::Span {
        source: current.source,
        start: ast::Position {
            line: current.line,
            column: current.column
        },
        end: ast::Position {
            line: current.line,
            column: current.column + width
        }
    };
}

// Counts scalars in lexer-normalized token text. Every byte outside the UTF-8
// continuation range begins exactly one scalar, including the replacement
// scalar used when the source contained invalid UTF-8.
fn token_width(current: &token::Token) -> i64 {
    let bytes = current.literal.as_bytes();
    var width = 0;
    var index = 0;
    while index < mem::len(bytes) {
        let byte = bytes[index];
        if byte < cast<u8>(128) or byte > cast<u8>(191) {
            width = width + 1;
        }
        index = index + 1;
    }
    if width < 1 {
        return 1;
    }
    return width;
}

// Returns the best source span currently stored on an expression.
fn expression_span(tree: &ast::Ast, expression: ast::Expression) -> ast::Span {
    match tree.expressions.at(expression.node) {
        Ident(value) => return value.span,
        Binary(value) => return value.operator_span,
        Call(value) => return expression_span(tree, value.callee),
        TypeApply(value) => return expression_span(tree, value.callee),
        Cast(value) => return value.keyword_span,
        Field(value) => return value.span,
        Deref(value) => return value.operator_span,
        _ => return ast::zero_span(),
    }
}

// Returns the range from first.start to last.end when both are known.
fn join_spans(first: ast::Span, last: ast::Span) -> ast::Span {
    if first.is_zero() {
        return last;
    }
    if last.is_zero() {
        return first;
    }
    return ast::Span {
        source: first.source,
        start: first.start,
        end: last.end
    };
}

// Advances the current token while retaining every scanned token for parser
// rewind and AST text copying.
fn (self: &var Parser) next_token() -> !void {
    let allocator = self.allocator;
    let next_position = self.position + 1;
    if next_position + 1 >= self.stream.len() {
        try append_next_token(allocator,
            &var self.scanner,
            &var self.tokens,
            &var self.stream
        );
    }
    self.position = next_position;
    return;
}

fn append_next_token(

    allocator: Allocator,
    scanner: &var lexer::Lexer,
    tokens: &var arena::Arena<token::Token>,
    stream: &var array::Array<arena::Handle<token::Token>>
) -> !void {
    // Reserve before scanning so stream growth failure cannot leave the
    // scanner frontier ahead of the ordered handle stream.
    try stream.reserve(allocator, 1);
    let next = try scanner.next_token();
    let handle = try tokens.add(allocator, move next);
    return stream.append(allocator, handle);
}
