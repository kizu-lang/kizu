import compiler::internal::ast;
import compiler::internal::lexer;
import compiler::internal::source;
import compiler::internal::token;
import compiler::internal::typ;
import std::array;
import std::mem;
import std::string;
import std::testing;

struct TypeShape {
    count: i64,
    first: i64,
    second: i64,
    third: i64,
    fourth: i64,
    fifth: i64
}

fn (self: &var TypeShape) visit(value: &typ::Node) -> void {
    let code = match value {
        Name(_) => 1,
        Slice(_) => 2,
        Buffer(_) => 3,
        Borrow(_) => 4,
        Optional(_) => 5,
        Const(_) => 6,
        ErrorUnion(_) => 7,
        Func(_) => 8,
    };
    if self.count == 0 {
        self.first = code;
    } else {
        if self.count == 1 {
            self.second = code;
        } else {
            if self.count == 2 {
                self.third = code;
            } else {
                if self.count == 3 {
                    self.fourth = code;
                } else {
                    if self.count == 4 {
                        self.fifth = code;
                    }
                }
            }
        }
    }
    self.count = self.count + 1;
    return;
}

fn expect_retained_bytes(value: &string::String, expected: []u8) -> void {
    let bytes = value.as_bytes();
    testing::expect_equal<[]u8>(expected, bytes);
    return;
}

fn expect_function_stub(
    tree: &ast::Ast,
    value: &ast::FunctionDecl,
    public: bool,
    docs: []u8
) -> void {
    testing::expect_equal<bool>(false, value.signature.receiver);
    testing::expect_equal<i64>(0, value.signature.static_params.len());
    testing::expect_equal<i64>(0, value.signature.params.len());
    if value.signature.return_type |_| {
        testing::fail("function stub retained a return type");
    }
    testing::expect_equal<bool>(false, value.signature.requires_unsafe);
    testing::expect_equal<bool>(public, value.signature.public);
    testing::expect_equal<bool>(false, value.signature.std);
    testing::expect_equal<bool>(false, value.derived);
    if value.body |_| {
        testing::fail("function stub retained a body");
    }
    expect_retained_bytes(tree.texts.at(value.signature.name.node), "");
    expect_retained_bytes(tree.texts.at(value.signature.extern_abi.node), "");
    expect_retained_bytes(tree.texts.at(value.doc.node), docs);
    return;
}

fn expect_param(
    allocator: Allocator,
    tree: &ast::Ast,
    params: &array::Array<ast::Param>,
    index: i64,
    name: []u8,
    type_name: []u8,
    borrow: bool,
    mut_borrow: bool
) -> !void {
    let param = params.get_or_panic(index);
    expect_retained_bytes(tree.texts.at(param.name.node), name);
    testing::expect_equal<bool>(borrow, param.borrow);
    testing::expect_equal<bool>(mut_borrow, param.mut_borrow);
    let rendered = try typ::render(allocator, &tree.types, param.type_name);
    defer rendered.deinit();
    expect_retained_bytes(&rendered, type_name);
    return;
}

fn parse_type_then_deinit(
    allocator: Allocator,
    tree: &var ast::Ast,
    input: []u8
) -> !?typ::Type {
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    defer value.deinit();
    return value.parse_type_name(tree);
}

fn expect_type_shape(
    allocator: Allocator,
    tree: &var ast::Ast,
    input: []u8,
    count: i64,
    first: i64,
    second: i64,
    third: i64
) -> !void {
    let parsed = try parse_type_then_deinit(allocator, tree, input);
    if parsed |type_name| {
        var shape = TypeShape {
            count: 0,
            first: 0,
            second: 0,
            third: 0,
            fourth: 0,
            fifth: 0
        };
        typ::walk<TypeShape>(&tree.types, type_name, &var shape);
        testing::expect_equal<i64>(count, shape.count);
        testing::expect_equal<i64>(first, shape.first);
        testing::expect_equal<i64>(second, shape.second);
        testing::expect_equal<i64>(third, shape.third);
    } else {
        testing::fail("parser did not retain a type shape");
    }
    return;
}

test "parser lifecycle owns its token stream and diagnostics" {
    let allocator = mem::page_allocator();
    var sources = source::new(allocator);
    defer sources.deinit();
    let path = try string::from_bytes(allocator, "sample.kizu");
    errdefer path.deinit();
    let text = try string::from_bytes(allocator, "first 2");
    errdefer text.deinit();
    let id = try sources.add(move path, move text);
    if sources.at(id) |file| {
        let input = file.text.as_bytes();
        let scanner = lexer::new_source(allocator, id, input);
        var value = try new(allocator, move scanner);
        defer value.deinit();
        testing::expect_equal<i64>(0, value.diagnostics_len());
        if value.diagnostic(0) |_| {
            testing::fail("new parser retained an unexpected diagnostic");
        }
        testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Int, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Int, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        let errors = try value.errors(allocator, &sources);
        defer errors.deinit();
        testing::expect_equal<i64>(0, errors.len());
    } else {
        testing::fail("parser source was not retained");
    }
}

test "parser normalizes lexer comment tokens across Unicode and CRLF" {
    let allocator = mem::page_allocator();
    var input = string::new(allocator);
    defer input.deinit();
    try input.append_bytes("///　first  ");
    try input.append_byte(cast<u8>(13));
    try input.append_byte(cast<u8>(10));
    try input.append_bytes("///");
    try input.append_byte(cast<u8>(13));
    try input.append_byte(cast<u8>(10));
    try input.append_bytes("/// last　");
    try input.append_byte(cast<u8>(13));
    try input.append_byte(cast<u8>(10));
    try input.append_bytes("fn main() {}");
    let source_bytes = input.as_bytes();
    var scanner = lexer::new(allocator, source_bytes);
    defer scanner.deinit();
    let actual = try scanner.next_token();
    defer actual.deinit();
    testing::expect(actual.kind == token::Kind::Function);
    testing::expect_equal<i64>(3, actual.doc_comments.len());
    let empty_scanner = lexer::new(allocator, "");
    var value = try new(allocator, move empty_scanner);
    defer value.deinit();
    let text = try value.comment_text(&actual.doc_comments);
    defer text.deinit();
    var expected = string::new(allocator);
    defer expected.deinit();
    try expected.append_bytes("first  ");
    try expected.append_byte(cast<u8>(10));
    try expected.append_byte(cast<u8>(10));
    try expected.append_bytes("last");
    let expected_bytes = expected.as_bytes();
    expect_retained_bytes(&text, expected_bytes);
}

test "parser comment normalization keeps lexer replacement scalars" {
    let allocator = mem::page_allocator();
    var input = string::new(allocator);
    defer input.deinit();
    try input.append_bytes("/// ");
    try input.append_byte(cast<u8>(255));
    try input.append_byte(cast<u8>(10));
    try input.append_bytes("fn main() {}");
    let source_bytes = input.as_bytes();
    var scanner = lexer::new(allocator, source_bytes);
    defer scanner.deinit();
    let actual = try scanner.next_token();
    defer actual.deinit();
    testing::expect_equal<i64>(1, actual.doc_comments.len());
    let empty_scanner = lexer::new(allocator, "");
    var value = try new(allocator, move empty_scanner);
    defer value.deinit();
    let text = try value.comment_text(&actual.doc_comments);
    defer text.deinit();
    expect_retained_bytes(&text, "�");
}

test "function recovery stub retains visibility docs and empty defaults" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let scanner = lexer::new(allocator, "");
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let docs = try string::from_bytes(allocator, "Retained docs.");
    var documented = value.function_stub(&var tree, true, move docs);
    defer documented.deinit();
    let empty_docs = string::new(allocator);
    let private = value.function_stub(
        &var tree,
        false,
        move empty_docs
    );
    defer private.deinit();
    value.deinit();
    expect_function_stub(&tree, &documented, true, "Retained docs.");
    expect_function_stub(&tree, &private, false, "");
    documented.signature.requires_unsafe = true;
    testing::expect(documented.signature.requires_unsafe);
}

test "parser retains extern docs ABI and signature after token cleanup" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\/// Calls the host runtime.
        \\extern "c" fn host<T>(value: &T) -> !i64 next
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_extern_decl(&var tree);
    testing::expect(value.current_kind() == token::Kind::Ident);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.declarations.at(declaration.node) {
        Function(function) => {
            expect_retained_bytes(
                tree.texts.at(function.signature.name.node),
                "host"
            );
            expect_retained_bytes(
                tree.texts.at(function.signature.extern_abi.node),
                "c"
            );
            expect_retained_bytes(
                tree.texts.at(function.doc.node),
                "Calls the host runtime."
            );
            testing::expect(!function.signature.receiver);
            testing::expect_equal<i64>(1, function.signature.static_params.len());
            testing::expect_equal<i64>(1, function.signature.params.len());
            testing::expect(!function.signature.requires_unsafe);
            testing::expect(!function.signature.public);
            testing::expect(!function.signature.std);
            testing::expect(!function.derived);
            if function.body |_| {
                testing::fail("extern declaration gained a body");
            }
            if function.signature.static_params.at(0) |param| {
                expect_retained_bytes(tree.texts.at(param.name.node), "T");
                if param.type_name |_| {
                    testing::fail("extern type parameter gained a value type");
                }
            } else {
                testing::fail("missing extern static parameter");
            }
            try expect_param(
                allocator,
                &tree,
                &function.signature.params,
                0,
                "value",
                "T",
                true,
                false
            );
            if function.signature.return_type |return_type| {
                let rendered = try typ::render(
                    allocator,
                    &tree.types,
                    return_type
                );
                defer rendered.deinit();
                expect_retained_bytes(&rendered, "!i64");
            } else {
                testing::fail("missing extern return type");
            }
        },
        _ => testing::fail("parser did not retain an extern declaration"),
    }
}

test "parser retains enum names docs and compact empty metadata" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\/// State docs.
        \\enum State {
        \\    /// Active docs.
        \\    Active,
        \\    ///
        \\    Idle,
        \\} next
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_enum_decl(&var tree);
    testing::expect(value.current_kind() == token::Kind::RBrace);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.declarations.at(declaration.node) {
        Enum(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "State");
            expect_retained_bytes(
                tree.texts.at(retained.doc.node),
                "State docs."
            );
            testing::expect_equal<i64>(2, retained.tags.len());
            if retained.tags.at(0) |tag| {
                expect_retained_bytes(tree.texts.at(tag.node), "Active");
            } else {
                testing::fail("missing first enum tag");
            }
            if retained.tags.at(1) |tag| {
                expect_retained_bytes(tree.texts.at(tag.node), "Idle");
            } else {
                testing::fail("missing second enum tag");
            }
            if retained.tag_docs |docs| {
                testing::expect_equal<i64>(1, docs.len());
                if docs.at("Active") |text| {
                    expect_retained_bytes(
                        tree.texts.at(text.node),
                        "Active docs."
                    );
                } else {
                    testing::fail("missing enum tag docs");
                }
                if docs.at("Idle") |_| {
                    testing::fail("empty tag docs were retained");
                }
            } else {
                testing::fail("documented enum lost its tag docs");
            }
            testing::expect(!retained.public);
        },
        _ => testing::fail("parser did not retain an enum declaration"),
    }
}

test "parser leaves enum doc metadata null when every tag is undocumented" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let scanner = lexer::new(allocator, "enum Empty { One }");
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_enum_decl(&var tree);
    value.deinit();
    match tree.declarations.at(declaration.node) {
        Enum(retained) => {
            testing::expect_equal<i64>(1, retained.tags.len());
            if retained.tag_docs |_| {
                testing::fail("empty enum tag docs did not remain compact");
            }
        },
        _ => testing::fail("parser did not retain an enum declaration"),
    }
}

test "parser keeps duplicate enum tags and the latest docs by name" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\enum Repeat {
        \\    /// First docs.
        \\    Same,
        \\    /// Second docs.
        \\    Same,
        \\}
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_enum_decl(&var tree);
    value.deinit();
    match tree.declarations.at(declaration.node) {
        Enum(retained) => {
            testing::expect_equal<i64>(2, retained.tags.len());
            if retained.tag_docs |docs| {
                testing::expect_equal<i64>(1, docs.len());
                if docs.at("Same") |text| {
                    expect_retained_bytes(
                        tree.texts.at(text.node),
                        "Second docs."
                    );
                } else {
                    testing::fail("duplicate tag docs were not retained");
                }
            } else {
                testing::fail("duplicate tag docs map is missing");
            }
        },
        _ => testing::fail("parser did not retain an enum declaration"),
    }
}

test "parser retains error set members and docs after token cleanup" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\/// Failure docs.
        \\error Failure {
        \\    /// Missing docs.
        \\    Missing,
        \\    Timeout,
        \\} next
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    testing::expect(value.starts_error_set_decl());
    let declaration = try value.parse_error_set_decl(&var tree);
    testing::expect(value.current_kind() == token::Kind::RBrace);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.declarations.at(declaration.node) {
        ErrorSet(retained) => {
            expect_retained_bytes(
                tree.texts.at(retained.name.node),
                "Failure"
            );
            expect_retained_bytes(
                tree.texts.at(retained.doc.node),
                "Failure docs."
            );
            testing::expect_equal<i64>(2, retained.members.len());
            if retained.members.at(0) |member| {
                expect_retained_bytes(tree.texts.at(member.node), "Missing");
            } else {
                testing::fail("missing first error set member");
            }
            if retained.members.at(1) |member| {
                expect_retained_bytes(tree.texts.at(member.node), "Timeout");
            } else {
                testing::fail("missing second error set member");
            }
            if retained.member_docs |docs| {
                testing::expect_equal<i64>(1, docs.len());
                if docs.at("Missing") |text| {
                    expect_retained_bytes(
                        tree.texts.at(text.node),
                        "Missing docs."
                    );
                } else {
                    testing::fail("missing error set member docs");
                }
                if docs.at("Timeout") |_| {
                    testing::fail("empty error set member docs were retained");
                }
            } else {
                testing::fail("documented error set lost its member docs");
            }
            testing::expect(!retained.public);
        },
        _ => testing::fail("parser did not retain an error set declaration"),
    }
}

test "parser retains generic union variants docs and payload types" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\/// Shape docs.
        \\union Shape<T> {
        \\    /// Point docs.
        \\    Point,
        \\    /// Value docs.
        \\    Value(T),
        \\    Bytes([]u8),
        \\} next
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_union_decl(&var tree);
    testing::expect(value.current_kind() == token::Kind::RBrace);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.declarations.at(declaration.node) {
        Union(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "Shape");
            expect_retained_bytes(
                tree.texts.at(retained.doc.node),
                "Shape docs."
            );
            testing::expect_equal<i64>(1, retained.type_params.len());
            if retained.type_params.at(0) |param| {
                expect_retained_bytes(tree.texts.at(param.node), "T");
            } else {
                testing::fail("missing union type parameter");
            }
            testing::expect_equal<i64>(3, retained.variants.len());
            if retained.variants.at(0) |point| {
                expect_retained_bytes(tree.texts.at(point.name.node), "Point");
                expect_retained_bytes(
                    tree.texts.at(point.doc.node),
                    "Point docs."
                );
                if point.payload |_| {
                    testing::fail("payload-free union variant gained a type");
                }
            } else {
                testing::fail("missing payload-free union variant");
            }
            if retained.variants.at(1) |variant| {
                expect_retained_bytes(tree.texts.at(variant.name.node), "Value");
                expect_retained_bytes(
                    tree.texts.at(variant.doc.node),
                    "Value docs."
                );
                if variant.payload |payload| {
                    let rendered = try typ::render(allocator, &tree.types, payload);
                    defer rendered.deinit();
                    expect_retained_bytes(&rendered, "T");
                } else {
                    testing::fail("missing named union payload type");
                }
            } else {
                testing::fail("missing named-payload union variant");
            }
            if retained.variants.at(2) |variant| {
                expect_retained_bytes(tree.texts.at(variant.name.node), "Bytes");
                expect_retained_bytes(tree.texts.at(variant.doc.node), "");
                if variant.payload |payload| {
                    let rendered = try typ::render(allocator, &tree.types, payload);
                    defer rendered.deinit();
                    expect_retained_bytes(&rendered, "[]u8");
                } else {
                    testing::fail("missing slice union payload type");
                }
            } else {
                testing::fail("missing slice-payload union variant");
            }
            testing::expect(!retained.public);
        },
        _ => testing::fail("parser did not retain a union declaration"),
    }
}

fn expect_struct_field(
    allocator: Allocator,
    tree: &ast::Ast,
    fields: &array::Array<ast::Field>,
    index: i64,
    name: []u8,
    docs: []u8,
    type_name: []u8,
    borrow: bool,
    mut_borrow: bool,
    public: bool
) -> !void {
    let field = fields.get_or_panic(index);
    expect_retained_bytes(tree.texts.at(field.name.node), name);
    expect_retained_bytes(tree.texts.at(field.doc.node), docs);
    testing::expect_equal<bool>(borrow, field.borrow);
    testing::expect_equal<bool>(mut_borrow, field.mut_borrow);
    testing::expect_equal<bool>(public, field.public);
    let rendered = try typ::render(allocator, &tree.types, field.type_name);
    defer rendered.deinit();
    expect_retained_bytes(&rendered, type_name);
    return;
}

test "parser retains generic struct fields docs borrows and visibility" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\/// User docs.
        \\struct User<T> {
        \\    /// Name docs.
        \\    pub name: []u8,
        \\    borrowed: &T,
        \\    mutable: &var T,
        \\} next
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_struct_decl(&var tree);
    testing::expect(value.current_kind() == token::Kind::RBrace);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.declarations.at(declaration.node) {
        Struct(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "User");
            expect_retained_bytes(
                tree.texts.at(retained.doc.node),
                "User docs."
            );
            testing::expect_equal<i64>(1, retained.type_params.len());
            if retained.type_params.at(0) |param| {
                expect_retained_bytes(tree.texts.at(param.node), "T");
            } else {
                testing::fail("missing struct type parameter");
            }
            testing::expect_equal<i64>(3, retained.fields.len());
            try expect_struct_field(
                allocator,
                &tree,
                &retained.fields,
                0,
                "name",
                "Name docs.",
                "[]u8",
                false,
                false,
                true
            );
            try expect_struct_field(
                allocator,
                &tree,
                &retained.fields,
                1,
                "borrowed",
                "",
                "T",
                true,
                false,
                false
            );
            try expect_struct_field(
                allocator,
                &tree,
                &retained.fields,
                2,
                "mutable",
                "",
                "T",
                true,
                true,
                false
            );
            testing::expect(!retained.public);
            testing::expect(!retained.requires_unsafe);
        },
        _ => testing::fail("parser did not retain a struct declaration"),
    }
}

test "parser keeps struct declarations mutable until final retention" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let scanner = lexer::new(allocator, "struct Guard {}");
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let docs = try string::from_bytes(allocator, "Injected docs.");
    if try value.parse_struct_decl_with_doc(&var tree, move docs, false) |node| {
        value.deinit();
        var declaration = move node;
        declaration.public = true;
        declaration.requires_unsafe = true;
        let retained = tree.add_declaration(ast::DeclarationNode::Struct(
            move declaration
        ));
        match tree.declarations.at(retained.node) {
            Struct(retained_node) => {
                expect_retained_bytes(
                    tree.texts.at(retained_node.name.node),
                    "Guard"
                );
                expect_retained_bytes(
                    tree.texts.at(retained_node.doc.node),
                    "Injected docs."
                );
                testing::expect(retained_node.public);
                testing::expect(retained_node.requires_unsafe);
            },
            _ => testing::fail("mutable struct declaration was not retained"),
        }
    } else {
        value.deinit();
        testing::fail("struct declaration was not parsed");
    }
}

test "parser preserves prefix and error union graph precedence" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    try expect_type_shape(
        allocator,
        &var tree,
        "?E!T",
        4,
        5,
        7,
        1
    );
    try expect_type_shape(
        allocator,
        &var tree,
        "&E!T",
        4,
        4,
        7,
        1
    );
    try expect_type_shape(
        allocator,
        &var tree,
        "[]E!T",
        4,
        2,
        7,
        1
    );
    try expect_type_shape(
        allocator,
        &var tree,
        "[2]E!T",
        4,
        3,
        7,
        1
    );
    try expect_type_shape(
        allocator,
        &var tree,
        "E!F!T",
        5,
        7,
        1,
        7
    );
}

test "parser retains one safety text identity for one statement" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\// SAFETY: bounds checked
        \\unsafe first() + unsafe second();
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let statement = try value.parse_statement(&var tree);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.statements.at(statement.node) {
        Expr(expression_statement) => {
            match tree.expressions.at(expression_statement.expr.node) {
                Binary(binary) => {
                    match tree.expressions.at(binary.left.node) {
                        Unsafe(left) => {
                            match tree.expressions.at(binary.right.node) {
                                Unsafe(right) => {
                                    testing::expect(
                                        left.safety.node == right.safety.node
                                    );
                                    expect_retained_bytes(
                                        tree.texts.at(left.safety.node),
                                        "bounds checked"
                                    );
                                },
                                _ => testing::fail("missing right unsafe marker"),
                            }
                        },
                        _ => testing::fail("missing left unsafe marker"),
                    }
                },
                _ => testing::fail("safety statement was not binary"),
            }
        },
        _ => testing::fail("safety expression was not a statement"),
    }
}

test "parser restores enclosing safety across nested statements" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\// SAFETY: condition checked
        \\if unsafe ready { unsafe run(); }
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    let statement = try value.parse_statement(&var tree);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.statements.at(statement.node) {
        If(branch) => {
            match tree.expressions.at(branch.condition.node) {
                Unsafe(condition) => {
                    expect_retained_bytes(
                        tree.texts.at(condition.safety.node),
                        "condition checked"
                    );
                    match tree.statements.at(branch.consequence.node) {
                        Block(block) => {
                            let nested = block.statements.get_or_panic(0);
                            match tree.statements.at(nested.node) {
                                Expr(expression_statement) => {
                                    match tree.expressions.at(
                                        expression_statement.expr.node
                                    ) {
                                        Unsafe(body) => {
                                            testing::expect(
                                                condition.safety.node !=
                                                body.safety.node
                                            );
                                            expect_retained_bytes(
                                                tree.texts.at(body.safety.node),
                                                ""
                                            );
                                        },
                                        _ => testing::fail(
                                            "nested marker was not unsafe"
                                        ),
                                    }
                                },
                                _ => testing::fail(
                                    "nested unsafe was not a statement"
                                ),
                            }
                        },
                        _ => testing::fail("if consequence was not a block"),
                    }
                },
                _ => testing::fail("if condition was not unsafe"),
            }
        },
        _ => testing::fail("safety input was not an if statement"),
    }
}

test "parser program dispatches every top-level declaration" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\import std::mem;
        \\/// Exported docs.
        \\pub fn exported() {}
        \\test "smoke" {}
        \\pub error Failure { Bad }
        \\fn local() {}
        \\pub unsafe fn raw() {}
        \\/// Raw docs.
        \\pub unsafe struct Raw {}
        \\/// Host docs.
        \\pub extern "c" fn host(value: i64)
        \\pub struct Box { pub value: i64 }
        \\pub enum Color { Red }
        \\pub union Maybe { None, Some(i64) }
        \\pub contract Writer { fn write(value: i64); }
        \\impl Writer for Box;
    ;
    let scanner = lexer::new(allocator, input);
    var value = try new(allocator, move scanner);
    errdefer value.deinit();
    var program = try value.parse_program(&var tree);
    defer program.deinit();
    testing::expect_equal<token::Kind>(
        token::Kind::Eof,
        value.current_kind()
    );
    testing::expect_equal<i64>(0, value.diagnostics_len());
    testing::expect_equal<i64>(13, program.declarations.len());
    value.deinit();
    let rendered = try ast::render_program(
        allocator,
        &tree,
        &program
    );
    defer rendered.deinit();
    let expected =
        \\import std::mem
        \\pub fn exported() {  }
        \\test "smoke" {  }
        \\pub error Failure { Bad }
        \\fn local() {  }
        \\pub unsafe fn raw() {  }
        \\pub unsafe struct Raw {  }
        \\pub extern "c" fn host(value: i64)
        \\pub struct Box { pub value: i64 }
        \\pub enum Color { Red }
        \\pub union Maybe { None, Some(i64) }
        \\pub contract Writer { fn write(value: i64); }
        \\impl Writer for Box;
    ;
    expect_retained_bytes(&rendered, expected);
    let function = program.declarations.get_or_panic(1);
    match tree.declarations.at(function.node) {
        Function(declaration) => {
            expect_retained_bytes(
                tree.texts.at(declaration.doc.node),
                "Exported docs."
            );
        },
        _ => testing::fail("program lost the public function"),
    }
    let unsafe_struct = program.declarations.get_or_panic(6);
    match tree.declarations.at(unsafe_struct.node) {
        Struct(declaration) => {
            expect_retained_bytes(
                tree.texts.at(declaration.doc.node),
                "Raw docs."
            );
        },
        _ => testing::fail("program lost the unsafe struct"),
    }
    let external = program.declarations.get_or_panic(7);
    match tree.declarations.at(external.node) {
        Function(declaration) => {
            expect_retained_bytes(
                tree.texts.at(declaration.doc.node),
                "Host docs."
            );
        },
        _ => testing::fail("program lost the extern function"),
    }
}

test "parser rendered errors outlive parser diagnostics" {
    let allocator = mem::page_allocator();
    var sources = source::new(allocator);
    defer sources.deinit();
    let path = try string::from_bytes(allocator, "sample.kizu");
    errdefer path.deinit();
    let text = try string::from_bytes(allocator, "foo");
    errdefer text.deinit();
    let id = try sources.add(move path, move text);
    if sources.at(id) |file| {
        let input = file.text.as_bytes();
        let scanner = lexer::new_source(allocator, id, input);
        var value = try new(allocator, move scanner);
        errdefer value.deinit();
        try value.error_expected_declaration();
        let errors = try value.errors(allocator, &sources);
        defer errors.deinit();
        value.deinit();
        testing::expect_equal<i64>(1, errors.len());
        if errors.at(0) |rendered| {
            let bytes = rendered.as_bytes();
            let expected =
                \\expected declaration (fn, test, import, struct, enum, union, contract, impl, extern, pub, or unsafe), got identifier "foo" at sample.kizu:1:1
            ;
            testing::expect_equal<[]u8>(expected, bytes);
        } else {
            testing::fail("parser did not render its diagnostic");
        }
    } else {
        testing::fail("parser source was not retained");
    }
}
