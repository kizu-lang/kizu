import compiler::source;
import compiler::typ;
import std::arena;
import std::array;
import std::map;
import std::string;

// Mechanical port of internal/ast's declaration, statement, and expression
// representation. Ast owns every node for one parsed program; Declaration,
// Expression, and Statement are copy handles whose types keep the three closed
// node categories distinct.

/// Owns the declaration, statement, and expression graphs for one program.
pub struct Ast {
    pub declarations: arena::Arena<DeclarationNode>,
    pub expressions: arena::Arena<ExpressionNode>,
    pub statements: arena::Arena<StatementNode>
}

/// Is the root of one parsed Kizu source file.
pub struct Program {
    pub declarations: array::Array<Declaration>
}

/// Identifies one declaration retained by an Ast.
pub struct Declaration {
    pub node: arena::Handle<DeclarationNode>
}

/// Identifies one expression retained by an Ast.
pub struct Expression {
    pub node: arena::Handle<ExpressionNode>
}

/// Identifies one statement retained by an Ast.
pub struct Statement {
    pub node: arena::Handle<StatementNode>
}

/// Identifies one block retained by an Ast.
pub struct Block {
    pub node: arena::Handle<StatementNode>
}

/// Identifies a one-based source position.
pub struct Position {
    pub line: i64,
    pub column: i64
}

/// Identifies a half-open source range.
pub struct Span {
    pub source: ?source::SourceId,
    pub start: Position,
    pub end: Position
}

/// Is one node that may appear as a top-level declaration.
pub union DeclarationNode {
    Import(ImportDecl),
    Function(FunctionDecl),
    Test(TestDecl),
    Struct(StructDecl),
    Enum(EnumDecl),
    ErrorSet(ErrorSetDecl),
    Union(UnionDecl),
    Contract(ContractDecl),
    Impl(ImplDecl),
}

/// Represents one explicit top-level module import.
pub struct ImportDecl {
    pub path: array::Array<string::String>
}

/// Is the declaration information visible to a function caller.
pub struct FunctionSignature {
    pub receiver: bool,
    pub name: string::String,
    pub static_params: array::Array<StaticParam>,
    pub params: array::Array<Param>,
    pub return_type: ?typ::Type,
    pub requires_unsafe: bool,
    pub extern_abi: string::String,
    pub public: bool,
    pub std: bool
}

/// Represents a function declaration and its optional body.
pub struct FunctionDecl {
    pub signature: FunctionSignature,
    pub doc: string::String,
    pub derived: bool,
    pub body: ?Block
}

/// Is one entry of a static argument declaration list.
pub struct StaticParam {
    pub name: string::String,
    pub type_name: ?typ::Type
}

/// Represents a top-level test block.
pub struct TestDecl {
    pub name: string::String,
    pub body: ?Block
}

/// Represents a top-level struct declaration.
pub struct StructDecl {
    pub name: string::String,
    pub doc: string::String,
    pub type_params: array::Array<string::String>,
    pub fields: array::Array<Field>,
    pub public: bool,
    pub requires_unsafe: bool
}

/// Represents a top-level tag enum declaration.
pub struct EnumDecl {
    pub name: string::String,
    pub doc: string::String,
    pub tags: array::Array<string::String>,
    pub tag_docs: ?map::Map<[]u8, string::String>,
    pub public: bool
}

/// Represents a top-level error set declaration.
pub struct ErrorSetDecl {
    pub name: string::String,
    pub doc: string::String,
    pub members: array::Array<string::String>,
    pub member_docs: ?map::Map<[]u8, string::String>,
    pub public: bool
}

/// Represents a top-level tagged union declaration.
pub struct UnionDecl {
    pub name: string::String,
    pub doc: string::String,
    pub type_params: array::Array<string::String>,
    pub variants: array::Array<UnionVariant>,
    pub public: bool
}

/// Represents one tagged union variant.
pub struct UnionVariant {
    pub name: string::String,
    pub doc: string::String,
    pub payload: ?typ::Type
}

/// Represents required method signatures.
pub struct ContractDecl {
    pub name: string::String,
    pub methods: array::Array<FunctionDecl>,
    pub public: bool
}

/// Asserts that one concrete type satisfies one contract.
pub struct ImplDecl {
    pub contract_name: string::String,
    pub type_name: string::String
}

/// Represents a named struct field.
pub struct Field {
    pub name: string::String,
    pub doc: string::String,
    pub type_name: typ::Type,
    pub borrow: bool,
    pub mut_borrow: bool,
    pub public: bool
}

/// Represents one function parameter.
pub struct Param {
    pub name: string::String,
    pub type_name: typ::Type,
    pub borrow: bool,
    pub mut_borrow: bool
}

/// Is one enum tag or union variant exposed to compile-time reflection.
pub struct MetaVariant {
    pub name: []u8,
    pub has_payload: bool
}

/// Is one node that may appear as a statement.
pub union StatementNode {
    Block(BlockStmt),
    Let(LetStmt),
    Assign(AssignStmt),
    Return(ReturnStmt),
    Defer(DeferStmt),
    ErrDefer(ErrDeferStmt),
    If(IfStmt),
    While(WhileStmt),
    For(ForStmt),
    Break(BreakStmt),
    Continue(ContinueStmt),
    Match(MatchStmt),
    ComptimeIf(ComptimeIfStmt),
    ComptimeFor(ComptimeForStmt),
    ComptimeMatch(ComptimeMatchStmt),
    Expr(ExprStmt),
}

/// Is one node that may produce a value.
pub union ExpressionNode {
    Ident(IdentExpr),
    Int(IntExpr),
    String(StringExpr),
    Null(NullExpr),
    OrelseGuard(OrelseGuardExpr),
    Bool(BoolExpr),
    Type(TypeExpr),
    Comptime(ComptimeExpr),
    Prefix(PrefixExpr),
    Binary(BinaryExpr),
    Call(CallExpr),
    TypeApply(TypeApplyExpr),
    Cast(CastExpr),
    Try(TryExpr),
    Move(MoveExpr),
    Unsafe(UnsafeExpr),
    Index(IndexExpr),
    StructLiteral(StructLiteralExpr),
    BufferLiteral(BufferLiteralExpr),
    Field(FieldExpr),
    Deref(DerefExpr),
    If(IfStmt),
    Match(MatchStmt),
}

/// Represents a sequence of statements.
pub struct BlockStmt {
    pub statements: array::Array<Statement>
}

/// Represents a let or var declaration.
pub struct LetStmt {
    pub mutable: bool,
    pub name: string::String,
    pub value: Expression
}

/// Represents assignment to an existing binding.
pub struct AssignStmt {
    pub target: Expression,
    pub value: Expression
}

/// Represents an explicit return statement.
pub struct ReturnStmt {
    pub value: ?Expression
}

/// Registers one cleanup expression for the current lexical block.
pub struct DeferStmt {
    pub expr: Expression
}

/// Registers a cleanup expression for an error-return path.
pub struct ErrDeferStmt {
    pub expr: Expression
}

/// Represents a conditional branch or conditional expression.
pub struct IfStmt {
    pub condition: Expression,
    pub consequence: Block,
    pub alternative: ?Block,
    pub capture: string::String
}

/// Represents a loop guarded by a condition expression.
pub struct WhileStmt {
    pub label: string::String,
    pub condition: Expression,
    pub body: Block,
    pub capture: string::String
}

/// Represents a bounded integer range loop.
pub struct ForStmt {
    pub label: string::String,
    pub name: string::String,
    pub start: Expression,
    pub end: Expression,
    pub body: Block
}

/// Exits the nearest loop or a named enclosing loop.
pub struct BreakStmt {
    pub label: string::String
}

/// Skips to the next iteration of the nearest or named loop.
pub struct ContinueStmt {
    pub label: string::String
}

/// Represents an enum or union tag match.
pub struct MatchStmt {
    pub value: Expression,
    pub arms: array::Array<MatchArm>,
    pub meta_capture: string::String,
    pub meta_owner: string::String
}

/// Represents one tag branch in a match.
pub struct MatchArm {
    pub tag: string::String,
    pub binding: string::String,
    pub body: Statement
}

/// Represents a branch selected during compilation.
pub struct ComptimeIfStmt {
    pub condition: Expression,
    pub consequence: Block,
    pub alternative: ?Block
}

/// Repeats a body for every element of a compile-time list.
pub struct ComptimeForStmt {
    pub list: Expression,
    pub name: string::String,
    pub body: Block
}

/// Repeats a body for every variant of a compile-time value.
pub struct ComptimeMatchStmt {
    pub value: Expression,
    pub name: string::String,
    pub binding: string::String,
    pub body: Block
}

/// Wraps an expression used as a statement.
pub struct ExprStmt {
    pub expr: Expression,
    pub semicolon: bool
}

/// Represents a name reference.
pub struct IdentExpr {
    pub name: string::String,
    pub span: Span
}

/// Represents an integer literal.
pub struct IntExpr {
    pub value: string::String
}

/// Represents a string literal.
pub struct StringExpr {
    pub value: string::String
}

/// Is the null literal of an optional type.
pub struct NullExpr {
    pub span: Span
}

/// Is `cond orelse return/break/continue`.
pub struct OrelseGuardExpr {
    pub condition: Expression,
    pub exit: Statement,
    pub span: Span
}

/// Represents a boolean literal.
pub struct BoolExpr {
    pub value: bool
}

/// Represents a compile-time type value.
pub struct TypeExpr {
    pub type_name: string::String
}

/// Represents an expression evaluated during compilation.
pub struct ComptimeExpr {
    pub expr: Expression
}

/// Represents a unary operator expression.
pub struct PrefixExpr {
    pub operator: string::String,
    pub right: Expression
}

/// Represents an infix binary operator expression.
pub struct BinaryExpr {
    pub left: Expression,
    pub operator: string::String,
    pub operator_span: Span,
    pub right: Expression
}

/// Represents a function call.
pub struct CallExpr {
    pub callee: Expression,
    pub args: array::Array<Expression>
}

/// Represents a call target with explicit static arguments.
pub struct TypeApplyExpr {
    pub callee: Expression,
    pub type_arg: string::String
}

/// Represents an explicit cast<T>(value) conversion.
pub struct CastExpr {
    pub target_type: typ::Type,
    pub value: Expression,
    pub keyword_span: Span
}

/// Unwraps a !T value or returns the error from the current function.
pub struct TryExpr {
    pub value: Expression
}

/// Marks the place an owner is handed off from.
pub struct MoveExpr {
    pub value: Expression,
    pub span: Span
}

/// Marks an expression whose memory safety the compiler does not prove.
pub struct UnsafeExpr {
    pub value: Expression,
    pub safety: string::String,
    pub span: Span
}

/// Represents checked byte indexing or one-dimensional slicing.
pub struct IndexExpr {
    pub target: Expression,
    pub index: ?Expression,
    pub start: ?Expression,
    pub end: ?Expression,
    pub slice: bool,
    pub span: Span
}

/// Represents construction of a struct value.
pub struct StructLiteralExpr {
    pub type_name: string::String,
    pub fields: array::Array<FieldValue>,
    pub span: Span
}

/// Is a zero-filled fixed-length byte buffer literal.
pub struct BufferLiteralExpr {
    pub size: i64,
    pub span: Span
}

/// Represents one field initializer in a struct literal.
pub struct FieldValue {
    pub name: string::String,
    pub value: Expression
}

/// Represents field access on a receiver expression.
pub struct FieldExpr {
    pub receiver: Expression,
    pub name: string::String,
    pub namespace: bool,
    pub span: Span
}

/// Represents explicit postfix dereference.
pub struct DerefExpr {
    pub receiver: Expression,
    pub operator_span: Span
}

/// Creates empty storage for one parsed AST.
pub fn new(allocator: Allocator) -> Ast {
    return Ast {
        declarations: arena::new<DeclarationNode>(allocator),
        expressions: arena::new<ExpressionNode>(allocator),
        statements: arena::new<StatementNode>(allocator)
    };
}

/// Creates an empty root declaration list.
pub fn new_program(allocator: Allocator) -> Program {
    return Program {
        declarations: array::new<Declaration>(allocator)
    };
}

/// Retains one declaration node and returns its typed handle.
fn (self: &var Ast) add_declaration(node: DeclarationNode) -> Declaration {
    return Declaration {
        node: self.declarations.add(move node)
    };
}

/// Appends one retained declaration to the source-file root.
fn (self: &var Program) add_declaration(declaration: Declaration) -> !void {
    return self.declarations.append(declaration);
}

/// Retains one expression node and returns its typed handle.
fn (self: &var Ast) add_expression(node: ExpressionNode) -> Expression {
    return Expression {
        node: self.expressions.add(move node)
    };
}

/// Retains one statement node and returns its typed handle.
fn (self: &var Ast) add_statement(node: StatementNode) -> Statement {
    return Statement {
        node: self.statements.add(move node)
    };
}

/// Retains one block and returns its typed handle.
fn (self: &var Ast) add_block(block: BlockStmt) -> Block {
    return Block {
        node: self.statements.add(StatementNode::Block(move block))
    };
}

/// Views a retained block as the statement node with the same identity.
fn (self: Block) as_statement() -> Statement {
    return Statement { node: self.node };
}

/// Reports whether a span has no source position.
fn (self: Span) is_zero() -> bool {
    return self.start.line == 0 or self.start.column == 0;
}

fn zero_span() -> Span {
    return Span {
        source: null,
        start: Position { line: 0, column: 0 },
        end: Position { line: 0, column: 0 }
    };
}

/// Reports whether this entry declares a type parameter.
fn (self: &StaticParam) is_type() -> bool {
    if self.type_name |_| {
        return false;
    } else {
        return true;
    }
}

/// Expands one compile-time match into the ordinary match every phase reads.
pub fn comptime_match_expansion(
    allocator: Allocator,
    stmt: &ComptimeMatchStmt,
    owner: []u8,
    variants: &array::Array<MetaVariant>
) -> !MatchStmt {
    var arms = array::new<MatchArm>(allocator);
    errdefer arms.deinit();
    try arms.reserve(variants.len());
    let body = stmt.body.as_statement();
    var index = 0;
    while variants.at(index) |variant| {
        let tag = try string::from_bytes(allocator, variant.name);
        errdefer tag.deinit();
        var binding = string::new(allocator);
        errdefer binding.deinit();
        if variant.has_payload {
            let binding_bytes = stmt.binding.as_bytes();
            try binding.append_bytes(binding_bytes);
        }
        try arms.append(MatchArm {
            tag: move tag,
            binding: move binding,
            body: body
        });
        index = index + 1;
    }
    let capture_bytes = stmt.name.as_bytes();
    let capture = try string::from_bytes(allocator, capture_bytes);
    errdefer capture.deinit();
    let meta_owner = try string::from_bytes(allocator, owner);
    return MatchStmt {
        value: stmt.value,
        arms: move arms,
        meta_capture: move capture,
        meta_owner: move meta_owner
    };
}

fn add_variant_path(
    ast: &var Ast,
    owner_name: string::String,
    variant_name: string::String
) -> Expression {
    let receiver = ast.add_expression(ExpressionNode::Ident(IdentExpr {
        name: move owner_name,
        span: zero_span()
    }));
    return ast.add_expression(ExpressionNode::Field(FieldExpr {
        receiver: receiver,
        name: move variant_name,
        namespace: true,
        span: zero_span()
    }));
}

/// Expands one reflected variant constructor into an ordinary expression.
pub fn variant_expansion(
    allocator: Allocator,
    ast: &var Ast,
    owner: []u8,
    variant: []u8,
    args: array::Array<Expression>
) -> !Expression {
    errdefer args.deinit();
    let owner_name = try string::from_bytes(allocator, owner);
    errdefer owner_name.deinit();
    let variant_name = try string::from_bytes(allocator, variant);
    errdefer variant_name.deinit();
    if args.len() == 0 {
        args.deinit();
        return add_variant_path(ast, move owner_name, move variant_name);
    }
    let path = add_variant_path(ast, move owner_name, move variant_name);
    return ast.add_expression(ExpressionNode::Call(CallExpr {
        callee: path,
        args: move args
    }));
}

/// Returns the expression covered by a value-transparent marker.
pub fn marker_value(ast: &Ast, value: Expression) -> ?Expression {
    match ast.expressions.at(value.node) {
        Comptime(node) => return node.expr,
        Unsafe(node) => return node.value,
        Move(node) => return node.value,
        _ => return null,
    }
}
