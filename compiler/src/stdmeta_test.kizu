import compiler::stdmeta;
import std::array;
import std::mem;
import std::string;
import std::testing;

fn expect_shape(
    name: []u8,
    static_args: i64,
    capture: bool,
    args: i64,
    type_form: bool,
    variadic: bool,
    worker: i64
) -> void {
    if stdmeta::lookup(name) |shape| {
        testing::expect_equal<i64>(static_args, shape.static_args);
        testing::expect_equal<bool>(capture, shape.capture);
        testing::expect_equal<i64>(args, shape.args);
        testing::expect_equal<bool>(type_form, shape.type_form);
        testing::expect_equal<bool>(variadic, shape.variadic);
        testing::expect_equal<i64>(worker, shape.worker);
    } else {
        testing::fail("stdmeta shape was not found");
    }
}

fn expect_arg(
    args: &array::Array<string::String>,
    index: i64,
    expected: []u8
) -> void {
    if args.at(index) |value| {
        let bytes = value.as_bytes();
        testing::expect_equal<[]u8>(expected, bytes);
    } else {
        testing::fail("stdmeta argument was not found");
    }
}

fn count_form(
    forms: &array::Array<stdmeta::Form>,
    expected: stdmeta::Form
) -> i64 {
    var count = 0;
    var index = 0;
    while forms.get(index) |form| {
        if form == expected {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn expect_one_form(
    forms: &array::Array<stdmeta::Form>,
    expected: stdmeta::Form
) -> void {
    testing::expect_equal<i64>(1, count_form(forms, expected));
}

fn expect_spelling(form: stdmeta::Form, expected: []u8) -> void {
    testing::expect_equal<[]u8>(expected, stdmeta::spelling(form));
}

fn expect_no_apply(allocator: Allocator, text: []u8) -> !void {
    if try stdmeta::split_apply(allocator, text) |parts| {
        parts.deinit();
        testing::fail("invalid stdmeta application was accepted");
    }
    return;
}

fn split_releasing_input(
    allocator: Allocator,
    text: string::String
) -> !?stdmeta::ApplyParts {
    defer text.deinit();
    let bytes = text.as_bytes();
    return stdmeta::split_apply(allocator, bytes);
}

test "stdmeta registry exposes every form and shape" {
    let allocator = mem::page_allocator();
    let forms = try stdmeta::names(allocator);
    defer forms.deinit();
    testing::expect_equal<i64>(21, forms.len());
    var index = 0;
    while forms.get(index) |form| {
        let name = stdmeta::spelling(form);
        if stdmeta::lookup(name) |_| {
        } else {
            testing::fail("enumerated stdmeta form has no shape");
        }
        index = index + 1;
    }

    expect_one_form(&forms, stdmeta::Form::IsStruct);
    expect_one_form(&forms, stdmeta::Form::IsEnum);
    expect_one_form(&forms, stdmeta::Form::IsUnion);
    expect_one_form(&forms, stdmeta::Form::IsOptional);
    expect_one_form(&forms, stdmeta::Form::IsArray);
    expect_one_form(&forms, stdmeta::Form::IsBox);
    expect_one_form(&forms, stdmeta::Form::IsMap);
    expect_one_form(&forms, stdmeta::Form::IsOwner);
    expect_one_form(&forms, stdmeta::Form::HasPublicFields);
    expect_one_form(&forms, stdmeta::Form::Element);
    expect_one_form(&forms, stdmeta::Form::PublicFields);
    expect_one_form(&forms, stdmeta::Form::FieldName);
    expect_one_form(&forms, stdmeta::Form::FieldType);
    expect_one_form(&forms, stdmeta::Form::Field);
    expect_one_form(&forms, stdmeta::Form::Variants);
    expect_one_form(&forms, stdmeta::Form::VariantName);
    expect_one_form(&forms, stdmeta::Form::VariantType);
    expect_one_form(&forms, stdmeta::Form::HasPayload);
    expect_one_form(&forms, stdmeta::Form::Variant);
    expect_one_form(&forms, stdmeta::Form::Construct);
    expect_one_form(&forms, stdmeta::Form::Unsupported);

    expect_spelling(stdmeta::Form::IsStruct, "std::meta::is_struct");
    expect_spelling(stdmeta::Form::IsEnum, "std::meta::is_enum");
    expect_spelling(stdmeta::Form::IsUnion, "std::meta::is_union");
    expect_spelling(stdmeta::Form::IsOptional, "std::meta::is_optional");
    expect_spelling(stdmeta::Form::IsArray, "std::meta::is_array");
    expect_spelling(stdmeta::Form::IsBox, "std::meta::is_box");
    expect_spelling(stdmeta::Form::IsMap, "std::meta::is_map");
    expect_spelling(stdmeta::Form::IsOwner, "std::meta::is_owner");
    expect_spelling(
        stdmeta::Form::HasPublicFields,
        "std::meta::has_public_fields"
    );
    expect_spelling(stdmeta::Form::Element, "std::meta::element");
    expect_spelling(stdmeta::Form::PublicFields, "std::meta::public_fields");
    expect_spelling(stdmeta::Form::FieldName, "std::meta::field_name");
    expect_spelling(stdmeta::Form::FieldType, "std::meta::field_type");
    expect_spelling(stdmeta::Form::Field, "std::meta::field");
    expect_spelling(stdmeta::Form::Variants, "std::meta::variants");
    expect_spelling(stdmeta::Form::VariantName, "std::meta::variant_name");
    expect_spelling(stdmeta::Form::VariantType, "std::meta::variant_type");
    expect_spelling(stdmeta::Form::HasPayload, "std::meta::has_payload");
    expect_spelling(stdmeta::Form::Variant, "std::meta::variant");
    expect_spelling(stdmeta::Form::Construct, "std::meta::construct");
    expect_spelling(stdmeta::Form::Unsupported, "std::meta::unsupported");

    expect_shape("std::meta::is_struct", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_enum", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_union", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_optional", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_array", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_box", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_map", 1, false, 0, false, false, 0);
    expect_shape("std::meta::is_owner", 1, false, 0, false, false, 0);
    expect_shape("std::meta::has_public_fields", 1, false, 0, false, false, 0);
    expect_shape("std::meta::element", 1, false, 0, true, false, 0);
    expect_shape("std::meta::public_fields", 1, false, 0, false, false, 0);
    expect_shape("std::meta::field_name", 2, true, 0, false, false, 0);
    expect_shape("std::meta::field_type", 2, true, 0, true, false, 0);
    expect_shape("std::meta::field", 2, true, 1, false, false, 0);
    expect_shape("std::meta::variants", 1, false, 0, false, false, 0);
    expect_shape("std::meta::variant_name", 2, true, 0, false, false, 0);
    expect_shape("std::meta::variant_type", 2, true, 0, true, false, 0);
    expect_shape("std::meta::has_payload", 2, true, 0, false, false, 0);
    expect_shape("std::meta::variant", 2, true, 0, false, true, 0);
    expect_shape("std::meta::construct", 2, false, 0, false, true, 2);
    expect_shape("std::meta::unsupported", 1, false, 0, false, false, 0);
    if stdmeta::lookup("std::meta::missing") |_| {
        testing::fail("unknown stdmeta form has a shape");
    }
}

test "stdmeta classifies predicates and variant captures" {
    testing::expect(stdmeta::predicate("std::meta::is_struct"));
    testing::expect(stdmeta::predicate("std::meta::is_enum"));
    testing::expect(stdmeta::predicate("std::meta::is_union"));
    testing::expect(stdmeta::predicate("std::meta::is_optional"));
    testing::expect(stdmeta::predicate("std::meta::is_array"));
    testing::expect(stdmeta::predicate("std::meta::is_box"));
    testing::expect(stdmeta::predicate("std::meta::is_map"));
    testing::expect(stdmeta::predicate("std::meta::is_owner"));
    testing::expect(stdmeta::predicate("std::meta::has_public_fields"));
    testing::expect(stdmeta::predicate("std::meta::has_payload"));
    testing::expect(!stdmeta::predicate("std::meta::element"));
    testing::expect(!stdmeta::predicate("std::meta::public_fields"));
    testing::expect(!stdmeta::predicate("std::meta::field_name"));
    testing::expect(!stdmeta::predicate("std::meta::field_type"));
    testing::expect(!stdmeta::predicate("std::meta::field"));
    testing::expect(!stdmeta::predicate("std::meta::variants"));
    testing::expect(!stdmeta::predicate("std::meta::variant_name"));
    testing::expect(!stdmeta::predicate("std::meta::variant_type"));
    testing::expect(!stdmeta::predicate("std::meta::variant"));
    testing::expect(!stdmeta::predicate("std::meta::construct"));
    testing::expect(!stdmeta::predicate("std::meta::unsupported"));
    testing::expect(!stdmeta::predicate("std::meta::missing"));
    testing::expect(stdmeta::variant_form(stdmeta::Form::VariantName));
    testing::expect(stdmeta::variant_form(stdmeta::Form::VariantType));
    testing::expect(stdmeta::variant_form(stdmeta::Form::HasPayload));
    testing::expect(stdmeta::variant_form(stdmeta::Form::Variant));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::IsStruct));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::IsEnum));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::IsUnion));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::IsOptional));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::IsArray));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::IsBox));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::IsMap));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::IsOwner));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::HasPublicFields));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::Element));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::PublicFields));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::FieldName));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::FieldType));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::Field));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::Variants));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::Construct));
    testing::expect(!stdmeta::variant_form(stdmeta::Form::Unsupported));
}

test "stdmeta splits nested static applications into owned arguments" {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(
        allocator,
        "　std::meta::field_type　<　std::map::Map<[]u8, std::array::Array<i64>>,　f　>　"
    );
    if try split_releasing_input(allocator, move text) |parts| {
        defer parts.deinit();
        testing::expect(parts.form == stdmeta::Form::FieldType);
        testing::expect_equal<i64>(2, parts.args.len());
        expect_arg(
            &parts.args,
            0,
            "std::map::Map<[]u8, std::array::Array<i64>>"
        );
        expect_arg(&parts.args, 1, "f");
    } else {
        testing::fail("valid stdmeta application was rejected");
    }
}

test "stdmeta rejects ordinary and malformed applications" {
    let allocator = mem::page_allocator();
    try expect_no_apply(allocator, "std::meta::field_type");
    try expect_no_apply(allocator, "other<T>");
    try expect_no_apply(allocator, "std::meta::field_type<>");
    try expect_no_apply(allocator, "std::meta::field_type<T,>");
    try expect_no_apply(allocator, "std::meta::field_type<,f>");
    try expect_no_apply(allocator, "std::meta::field_type<T, f");
    try expect_no_apply(allocator, "std::meta::field_type<T>, f>");
    try expect_no_apply(allocator, "std::meta::field_type<T<f>");
}
