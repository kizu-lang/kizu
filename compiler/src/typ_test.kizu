import compiler::typ;
import std::array;
import std::map;
import std::mem;
import std::string;
import std::testing;

fn expect_round_trip(allocator: Allocator, text: []u8) -> !void {
    var table = typ::new(allocator);
    defer table.deinit();
    let parsed = try table.parse(text);
    let rendered = try typ::render(allocator, &table, parsed);
    defer rendered.deinit();
    let bytes = rendered.as_bytes();
    testing::expect(mem::equal_bytes(bytes, text));
    return;
}

fn expect_part(
    parts: &array::Array<string::String>,
    index: i64,
    expected: []u8
) -> void {
    if parts.at(index) |part| {
        let bytes = part.as_bytes();
        testing::expect_equal<[]u8>(expected, bytes);
    } else {
        testing::fail("missing static argument");
    }
    return;
}

test "type parse renders every compiler spelling back" {
    let allocator = mem::page_allocator();
    try expect_round_trip(allocator, "i64");
    try expect_round_trip(allocator, "u8");
    try expect_round_trip(allocator, "bool");
    try expect_round_trip(allocator, "void");
    try expect_round_trip(allocator, "f64");
    try expect_round_trip(allocator, "usize");
    try expect_round_trip(allocator, "Io");
    try expect_round_trip(allocator, "Allocator");
    try expect_round_trip(allocator, "Function");
    try expect_round_trip(allocator, "Self");
    try expect_round_trip(allocator, "T");
    try expect_round_trip(allocator, "Point");
    try expect_round_trip(allocator, "std::map::Map");
    try expect_round_trip(allocator, "std::arena::Handle");
    try expect_round_trip(allocator, "[]u8");
    try expect_round_trip(allocator, "[][]u8");
    try expect_round_trip(allocator, "[]Point");
    try expect_round_trip(allocator, "[4]u8");
    try expect_round_trip(allocator, "[32]Array<Point>");
    try expect_round_trip(allocator, "&i64");
    try expect_round_trip(allocator, "&var i64");
    try expect_round_trip(allocator, "&[]u8");
    try expect_round_trip(allocator, "&var Point");
    try expect_round_trip(allocator, "?ptr<u8>");
    try expect_round_trip(allocator, "?i64");
    try expect_round_trip(allocator, "!void");
    try expect_round_trip(allocator, "!i64");
    try expect_round_trip(allocator, "![]u8");
    try expect_round_trip(allocator, "!&i64");
    try expect_round_trip(allocator, "!&var i64");
    try expect_round_trip(allocator, "Error!i64");
    try expect_round_trip(allocator, "std::fs::Error![]u8");
    try expect_round_trip(allocator, "ptr<u8>");
    try expect_round_trip(allocator, "ptr<const u8>");
    try expect_round_trip(allocator, "Array<i64>");
    try expect_round_trip(allocator, "Box<Point>");
    try expect_round_trip(allocator, "Channel<[]u8>");
    try expect_round_trip(allocator, "std::map::Map<[]u8, i64>");
    try expect_round_trip(allocator, "std::map::Map<[]u8, Array<Point>>");
    try expect_round_trip(allocator, "Pair<i64, bool>");
    try expect_round_trip(allocator, "Pair<[]u8, &var Point>");
    try expect_round_trip(allocator, "Result<!void, Error!i64>");
}

test "type equality compares structure across independent arenas" {
    let allocator = mem::page_allocator();
    var left = typ::new(allocator);
    defer left.deinit();
    var right = typ::new(allocator);
    defer right.deinit();
    let first = try left.parse("Pair<[]u8, [4]T>");
    let same = try right.parse("Pair<[]u8, [4]T>");
    let other = try right.parse("Pair<[]u8, [8]T>");
    testing::expect(typ::equal(&left, first, &right, same));
    testing::expect(!typ::equal(&left, first, &right, other));
}

test "type table reuses roots and parses nested spellings independently" {
    let allocator = mem::page_allocator();
    var table = typ::new(allocator);
    defer table.deinit();
    let first = try table.parse("ParseError!Array<i64>");
    let second = try table.parse("ParseError!Array<i64>");
    testing::expect(typ::equal(&table, first, &table, second));
    let nested = try table.parse("Array<i64>");
    let rendered = try typ::render(allocator, &table, nested);
    defer rendered.deinit();
    let bytes = rendered.as_bytes();
    testing::expect(mem::equal_bytes(bytes, "Array<i64>"));
}

test "split args trims canonical space and keeps nested types whole" {
    let allocator = mem::page_allocator();
    let parts = try typ::split_args(
        allocator,
        " []u8, std::map::Map<[]u8, i64>,  bool "
    );
    defer parts.deinit();
    testing::expect_equal<i64>(3, parts.len());
    expect_part(&parts, 0, "[]u8");
    expect_part(&parts, 1, "std::map::Map<[]u8, i64>");
    expect_part(&parts, 2, "bool");
}

pub struct Counter {
    pub total: i64,
    pub names: i64,
    pub buffers: i64
}

fn (self: &var Counter) visit(value: &typ::Node) -> void {
    self.total = self.total + 1;
    match value {
        Name(_) => {
            self.names = self.names + 1;
        },
        Buffer(_) => {
            self.buffers = self.buffers + 1;
        },
        _ => return,
    }
    return;
}

test "walk visits buffer elements outermost first" {
    let allocator = mem::page_allocator();
    var table = typ::new(allocator);
    defer table.deinit();
    let parsed = try table.parse("[4]Pair<T, bool>");
    var counter = Counter { total: 0, names: 0, buffers: 0 };
    typ::walk<Counter>(&table, parsed, &var counter);
    testing::expect_equal<i64>(4, counter.total);
    testing::expect_equal<i64>(3, counter.names);
    testing::expect_equal<i64>(1, counter.buffers);
}

test "optional spelling helpers preserve their borrowed payload" {
    if typ::optional_elem("?[]u8") |elem| {
        testing::expect(mem::equal_bytes(elem, "[]u8"));
    } else {
        testing::fail("optional value was not recognized");
    }
    if typ::optional_elem("?ptr<u8>") |_| {
        testing::fail("nullable raw pointer was treated as an optional value");
    }
    if typ::borrow_optional_elem("?&var Point") |parts| {
        testing::expect(mem::equal_bytes(parts.elem, "Point"));
        testing::expect(parts.mutable);
    } else {
        testing::fail("mutable borrow optional was not recognized");
    }
    if typ::borrow_optional_elem("?&Point") |parts| {
        testing::expect(mem::equal_bytes(parts.elem, "Point"));
        testing::expect(!parts.mutable);
    } else {
        testing::fail("shared borrow optional was not recognized");
    }
}

test "name spelling helpers split only their documented seam" {
    if typ::split_apply("std::map::Map<[]u8, i64>") |parts| {
        testing::expect(mem::equal_bytes(parts.base, "std::map::Map"));
        testing::expect(mem::equal_bytes(parts.args, "[]u8, i64"));
    } else {
        testing::fail("generic application was not recognized");
    }
    if typ::split_apply("Map<>") |_| {
        testing::fail("empty generic application was accepted");
    }
    if typ::split_method_name("Receiver.method") |parts| {
        testing::expect(mem::equal_bytes(parts.receiver, "Receiver"));
        testing::expect(mem::equal_bytes(parts.method, "method"));
    } else {
        testing::fail("method name was not recognized");
    }
    if typ::split_method_name("method") |_| {
        testing::fail("unqualified method name was accepted");
    }
    testing::expect(mem::equal_bytes(typ::cleanup_method(), "deinit"));
}

pub struct Qualifier {
    pub calls: i64
}

fn qualified_part(allocator: Allocator, bytes: []u8) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes(bytes);
    return move out;
}

fn (self: &var Qualifier) rename_path(
    allocator: Allocator,
    path: &array::Array<string::String>
) -> !array::Array<string::String> {
    self.calls = self.calls + 1;
    var out = array::new<string::String>(allocator);
    errdefer out.deinit();
    try out.append(try qualified_part(allocator, "resolved"));
    var index = 0;
    while path.at(index) |part| {
        let bytes = part.as_bytes();
        try out.append(try qualified_part(allocator, bytes));
        index = index + 1;
    }
    return move out;
}

test "map names rewrites every name and preserves surrounding structure" {
    let allocator = mem::page_allocator();
    var table = typ::new(allocator);
    defer table.deinit();
    let parsed = try table.parse("Error![4]Pair<T, bool>");
    var qualifier = Qualifier { calls: 0 };
    let mapped = try typ::map_names<Qualifier>(
        &var table,
        parsed,
        &var qualifier
    );
    let rendered = try typ::render(allocator, &table, mapped);
    defer rendered.deinit();
    let bytes = rendered.as_bytes();
    testing::expect(mem::equal_bytes(
        bytes,
        "resolved::Error![4]resolved::Pair<resolved::T, resolved::bool>"
    ));
    testing::expect_equal<i64>(4, qualifier.calls);
}

test "substitute text parses replacements once and renders canonically" {
    let allocator = mem::page_allocator();
    var empty = map::new<[]u8, []u8>(allocator);
    defer empty.deinit();
    let unchanged = try typ::substitute_text(allocator, "not a type", &empty);
    defer unchanged.deinit();
    let unchanged_bytes = unchanged.as_bytes();
    testing::expect(mem::equal_bytes(unchanged_bytes, "not a type"));
    var substitutions = map::new<[]u8, []u8>(allocator);
    defer substitutions.deinit();
    try substitutions.insert("T", "Pair<U,bool>");
    try substitutions.insert("U", "i64");
    let replaced = try typ::substitute_text(
        allocator,
        "Error!?&var Pair<T, ptr<const U>, []Timer, [4]U>",
        &substitutions
    );
    defer replaced.deinit();
    let bytes = replaced.as_bytes();
    testing::expect(mem::equal_bytes(
        bytes,
        "Error!?&var Pair<Pair<U, bool>, ptr<const i64>, []Timer, [4]i64>"
    ));
}
