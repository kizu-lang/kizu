import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ownership;
import compiler::internal::project;
import compiler::internal::types;
import std::array;
import std::fmt;
import std::fs;
import std::io;
import std::mem;
import std::string;
import std::testing;

// The check corpus in compiler/tests/check is shared with the Go loader and
// checkers, which generate each case's expectation block. This runner loads
// every case through this loader and requires the same qualified user
// declarations or the same module error, then type-checks the loaded program
// and, when the types pass, ownership-checks it, and requires the same
// diagnostics from whichever stage stopped it.

/// The blank line plus `// check` line that ends a case input.
fn check_marker() -> []u8 {
    return
        \\
        \\
        \\// check
        \\
    ;
}

/// Separates one case into its input and its expectation block.
fn split_check_case(data: []u8) -> ?i64 {
    let marker = check_marker();
    let marker_len = mem::len(marker);
    var index = mem::len(data) - marker_len;
    while index >= 0 {
        if mem::slice(data, index, index + marker_len) |candidate| {
            if mem::equal_bytes(candidate, marker) {
                return index;
            }
        }
        index = index - 1;
    }
    return null;
}

/// Appends text as one expectation line: embedded newlines become `\n`.
fn append_folded_line(out: &var string::String, text: []u8) -> !void {
    var index = 0;
    while mem::byte_at(text, index) |byte| {
        if byte == cast<u8>(10) {
            try out.append_byte(cast<u8>(92));
            try out.append_byte(cast<u8>(110));
        } else {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    return out.append_byte(cast<u8>(10));
}

/// Reports whether a merged declaration came from the standard library.
fn is_std_declaration(tree: &ast::Ast, declaration: ast::Declaration) -> bool {
    match tree.declarations.at(declaration.node) {
        Function(value) => {
            if value.signature.std {
                return true;
            }
            return text_starts_with_std(tree, value.signature.name);
        },
        Struct(value) => return text_starts_with_std(tree, value.name),
        Enum(value) => return text_starts_with_std(tree, value.name),
        ErrorSet(value) => return text_starts_with_std(tree, value.name),
        Union(value) => return text_starts_with_std(tree, value.name),
        Contract(value) => return text_starts_with_std(tree, value.name),
        Impl(value) => {
            return text_starts_with_std(tree, value.contract_name) or
                text_starts_with_std(tree, value.type_name);
        },
        _ => return false,
    }
}

fn text_starts_with_std(tree: &ast::Ast, text: ast::Text) -> bool {
    let value = tree.texts.at(text.node);
    let bytes = value.as_bytes();
    return mem::starts_with(bytes, "std::");
}

/// Renders the `load:` section of one case through this loader.
fn render_load_section(
    io: Io,
    allocator: Allocator,
    input: []u8
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes("// load:");
    try out.append_byte(cast<u8>(10));
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    var loader = try project::new_loader(io, allocator, "lib/kizu");
    defer loader.deinit(allocator);
    let loaded = try loader.load_source(&var tree, "", input);
    match loaded {
        Error(failed) => {
            defer failed.deinit(allocator);
            let text = try failed.error(allocator, &loader.sources);
            defer text.deinit(allocator);
            try out.append_bytes("// ");
            let bytes = text.as_bytes();
            try append_folded_line(&var out, bytes);
            return move out;
        },
        Program(program) => {
            defer program.deinit(allocator);
            var index = 0;
            while program.declarations.at(index) |declaration| {
                index = index + 1;
                if is_std_declaration(&tree, declaration.*) {
                    continue;
                }
                let rendered = try ast::render_declaration(allocator, &tree, declaration.*);
                defer rendered.deinit(allocator);
                let bytes = rendered.as_bytes();
                try out.append_bytes("// ");
                var byte_index = 0;
                while mem::byte_at(bytes, byte_index) |byte| {
                    try out.append_byte(byte);
                    if byte == cast<u8>(10) {
                        try out.append_bytes("// ");
                    }
                    byte_index = byte_index + 1;
                }
                try out.append_byte(cast<u8>(10));
            }
            try append_check_section(&var out, allocator, &var tree, &program);
            return move out;
        },
    }
}

/// Appends the `check:` section: `ok`, or one line per diagnostic of
/// check_all as `L:C-L:C [code] category: message` with its notes and help.
/// The type checker runs first; a program it accepts goes on to the
/// ownership checker, the gate order the CLI uses.
fn append_check_section(
    out: &var string::String,
    allocator: Allocator,
    tree: &var ast::Ast,
    program: &ast::Program
) -> !void {
    try out.append_bytes("// check:");
    try out.append_byte(cast<u8>(10));
    var diagnostics = try types::check_all(allocator, tree, program);
    defer diagnostics.deinit(allocator);
    if diagnostics.len() == 0 {
        var moves = try ownership::check_all(allocator, tree, program);
        defer moves.deinit(allocator);
        return append_diagnostic_lines(out, &moves);
    }
    return append_diagnostic_lines(out, &diagnostics);
}

/// Appends `ok` for no diagnostics, or one line per diagnostic.
fn append_diagnostic_lines(
    out: &var string::String,
    diagnostics: &array::Array<diagnostic::Diagnostic>
) -> !void {
    if diagnostics.len() == 0 {
        try out.append_bytes("// ok");
        return out.append_byte(cast<u8>(10));
    }
    var index = 0;
    while diagnostics.at(index) |entry| {
        index = index + 1;
        try append_diagnostic_line(out, entry);
    }
    return;
}

/// Renders one structured diagnostic the way the Go corpus test does.
fn append_diagnostic_line(
    out: &var string::String,
    entry: &diagnostic::Diagnostic
) -> !void {
    try out.append_bytes("// ");
    if entry.span.is_zero() {
        try out.append_bytes("-");
    } else {
        try fmt::append_i64(out, entry.span.start.line);
        try out.append_byte(cast<u8>(58));
        try fmt::append_i64(out, entry.span.start.column);
        try out.append_byte(cast<u8>(45));
        try fmt::append_i64(out, entry.span.end.line);
        try out.append_byte(cast<u8>(58));
        try fmt::append_i64(out, entry.span.end.column);
    }
    if entry.code.len() > 0 {
        try out.append_bytes(" [");
        try out.append_string(&entry.code);
        try out.append_bytes("]");
    }
    try out.append_byte(cast<u8>(32));
    if entry.category.len() > 0 {
        try out.append_string(&entry.category);
        try out.append_bytes(": ");
    }
    let message = entry.message.as_bytes();
    try append_folded_line(out, message);
    var index = 0;
    while entry.notes.at(index) |note| {
        index = index + 1;
        try out.append_bytes("//   note: ");
        let note_bytes = note.as_bytes();
        try append_folded_line(out, note_bytes);
    }
    if entry.help.len() > 0 {
        try out.append_bytes("//   help: ");
        let help = entry.help.as_bytes();
        try append_folded_line(out, help);
    }
    return;
}

test "check corpus loads and checks like the shipping compiler" {
    let allocator = mem::page_allocator();
    let io = io::blocking();
    var entries = try fs::read_dir(io, "compiler/tests/check");
    defer entries.deinit(allocator);
    var cases = 0;
    var failures = 0;
    var index = 0;
    while index < entries.len() {
        let entry = entries.get_or_panic(index);
        index = index + 1;
        if entry.is_dir {
            continue;
        }
        cases = cases + 1;
        let data = try fs::read_file(io, allocator, entry.path, mem::Limit::Unlimited);
        defer data.deinit(allocator);
        let bytes = data.as_bytes();
        if split_check_case(bytes) |cut| {
            let input = bytes[0..cut];
            let want = bytes[cut + mem::len(check_marker())..mem::len(bytes)];
            let got = try render_load_section(io, allocator, input);
            defer got.deinit(allocator);
            let got_bytes = got.as_bytes();
            if !mem::equal_bytes(want, got_bytes) {
                failures = failures + 1;
                try io::write_stderr_line(io, entry.path);
                try io::write_stderr_line(io, "--- want");
                try io::write_stderr(io, want);
                try io::write_stderr_line(io, "--- got");
                try io::write_stderr(io, got_bytes);
            }
        } else {
            failures = failures + 1;
            try io::write_stderr(io, "no `// check` marker: ");
            try io::write_stderr_line(io, entry.path);
        }
    }
    testing::expect(cases > 0);
    testing::expect_equal<i64>(0, failures);
}
