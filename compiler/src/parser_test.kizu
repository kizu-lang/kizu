import compiler::ast;
import compiler::lexer;
import compiler::parser;
import compiler::source;
import compiler::token;
import compiler::typ;
import std::array;
import std::mem;
import std::string;
import std::testing;

struct TypeShape {
    count: i64,
    first: i64,
    second: i64,
    third: i64,
    fourth: i64,
    fifth: i64
}

fn (self: &var TypeShape) visit(value: &typ::Node) -> void {
    let code = match value {
        Name(_) => 1,
        Slice(_) => 2,
        Buffer(_) => 3,
        Borrow(_) => 4,
        Optional(_) => 5,
        Const(_) => 6,
        ErrorUnion(_) => 7,
    };
    if self.count == 0 {
        self.first = code;
    } else {
        if self.count == 1 {
            self.second = code;
        } else {
            if self.count == 2 {
                self.third = code;
            } else {
                if self.count == 3 {
                    self.fourth = code;
                } else {
                    if self.count == 4 {
                        self.fifth = code;
                    }
                }
            }
        }
    }
    self.count = self.count + 1;
    return;
}

fn zero_span() -> ast::Span {
    return ast::Span {
        source: null,
        start: ast::Position { line: 0, column: 0 },
        end: ast::Position { line: 0, column: 0 }
    };
}

fn retained_text(
    allocator: Allocator,
    tree: &var ast::Ast,
    bytes: []u8
) -> !ast::Text {
    return tree.add_text_from_bytes(allocator, bytes);
}

fn expect_type_apply_lookahead(
    allocator: Allocator,
    input: []u8,
    expected: bool
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
    testing::expect_equal<token::Kind>(token::Kind::Lt, value.peek_kind());
    testing::expect_equal<bool>(expected, try value.type_apply_looks_like_call());
    testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
    testing::expect_equal<token::Kind>(token::Kind::Lt, value.peek_kind());
    testing::expect_equal<bool>(expected, try value.type_apply_looks_like_call());
    testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
    testing::expect_equal<token::Kind>(token::Kind::Lt, value.peek_kind());
    try value.next_token();
    testing::expect_equal<token::Kind>(token::Kind::Lt, value.current_kind());
    return;
}

fn expect_peek_expression_end(
    allocator: Allocator,
    input: []u8,
    expected: bool
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect_equal<bool>(expected, value.peek_is_expression_end());
    return;
}

fn expect_peek_precedence(
    allocator: Allocator,
    input: []u8,
    expected: i64
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect_equal<i64>(1, value.current_precedence());
    testing::expect_equal<i64>(expected, value.peek_precedence());
    try value.next_token();
    testing::expect_equal<i64>(expected, value.current_precedence());
    return;
}

fn expect_parser_diagnostic(
    value: &parser::Parser,
    index: i64,
    expected: []u8,
    start_column: i64,
    end_column: i64
) -> void {
    if value.diagnostic(index) |entry| {
        let message = entry.message.as_bytes();
        testing::expect_equal<[]u8>(expected, message);
        testing::expect_equal<i64>(1, entry.span.start.line);
        testing::expect_equal<i64>(start_column, entry.span.start.column);
        testing::expect_equal<i64>(1, entry.span.end.line);
        testing::expect_equal<i64>(end_column, entry.span.end.column);
    } else {
        testing::fail("missing parser diagnostic");
    }
    return;
}

fn expect_current_error(
    allocator: Allocator,
    input: []u8,
    expected_kind: token::Kind,
    expected_message: []u8,
    end_column: i64
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect(!try value.expect_current(expected_kind));
    testing::expect_equal<i64>(1, value.diagnostics_len());
    expect_parser_diagnostic(&value, 0, expected_message, 1, end_column);
    return;
}

fn expect_peek_error(
    allocator: Allocator,
    input: []u8,
    expected_kind: token::Kind,
    expected_message: []u8
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect(!try value.expect_peek(expected_kind));
    testing::expect_equal<i64>(1, value.diagnostics_len());
    expect_parser_diagnostic(&value, 0, expected_message, 1, 4);
    return;
}

fn expect_retained_bytes(value: &string::String, expected: []u8) -> void {
    let bytes = value.as_bytes();
    testing::expect_equal<[]u8>(expected, bytes);
    return;
}

fn expect_break_label(
    tree: &ast::Ast,
    statement: ast::Statement,
    expected: []u8
) -> void {
    match tree.statements.at(statement.node) {
        Break(value) => {
            expect_retained_bytes(tree.texts.at(value.label.node), expected);
        },
        _ => testing::fail("parser did not retain a break statement"),
    }
    return;
}

fn expect_continue_label(
    tree: &ast::Ast,
    statement: ast::Statement,
    expected: []u8
) -> void {
    match tree.statements.at(statement.node) {
        Continue(value) => {
            expect_retained_bytes(tree.texts.at(value.label.node), expected);
        },
        _ => testing::fail("parser did not retain a continue statement"),
    }
    return;
}

fn expect_import_path(
    tree: &ast::Ast,
    declaration: ast::Declaration,
    first: []u8,
    second: []u8,
    third: []u8
) -> void {
    match tree.declarations.at(declaration.node) {
        Import(value) => {
            var expected_len = 1;
            if mem::len(second) > 0 {
                expected_len = 2;
            }
            if mem::len(third) > 0 {
                expected_len = 3;
            }
            testing::expect_equal<i64>(expected_len, value.path.len());
            let first_part = value.path.get_or_panic(0);
            expect_retained_bytes(tree.texts.at(first_part.node), first);
            if expected_len >= 2 {
                let second_part = value.path.get_or_panic(1);
                expect_retained_bytes(tree.texts.at(second_part.node), second);
            }
            if expected_len == 3 {
                let third_part = value.path.get_or_panic(2);
                expect_retained_bytes(tree.texts.at(third_part.node), third);
            }
        },
        _ => testing::fail("parser did not retain an import declaration"),
    }
    return;
}

fn expect_empty_import_path(
    tree: &ast::Ast,
    declaration: ast::Declaration
) -> void {
    match tree.declarations.at(declaration.node) {
        Import(value) => testing::expect_equal<i64>(0, value.path.len()),
        _ => testing::fail("parser did not retain an import declaration"),
    }
    return;
}

fn expect_impl_names(
    tree: &ast::Ast,
    declaration: ast::Declaration,
    contract_name: []u8,
    type_name: []u8
) -> void {
    match tree.declarations.at(declaration.node) {
        Impl(value) => {
            expect_retained_bytes(
                tree.texts.at(value.contract_name.node),
                contract_name
            );
            expect_retained_bytes(
                tree.texts.at(value.type_name.node),
                type_name
            );
        },
        _ => testing::fail("parser did not retain an impl declaration"),
    }
    return;
}

fn expect_function_stub(
    tree: &ast::Ast,
    value: &ast::FunctionDecl,
    public: bool,
    docs: []u8
) -> void {
    testing::expect_equal<bool>(false, value.signature.receiver);
    testing::expect_equal<i64>(0, value.signature.static_params.len());
    testing::expect_equal<i64>(0, value.signature.params.len());
    if value.signature.return_type |_| {
        testing::fail("function stub retained a return type");
    }
    testing::expect_equal<bool>(false, value.signature.requires_unsafe);
    testing::expect_equal<bool>(public, value.signature.public);
    testing::expect_equal<bool>(false, value.signature.std);
    testing::expect_equal<bool>(false, value.derived);
    if value.body |_| {
        testing::fail("function stub retained a body");
    }
    expect_retained_bytes(tree.texts.at(value.signature.name.node), "");
    expect_retained_bytes(tree.texts.at(value.signature.extern_abi.node), "");
    expect_retained_bytes(tree.texts.at(value.doc.node), docs);
    return;
}

fn new_function_signature(
    allocator: Allocator,
    tree: &var ast::Ast
) -> !ast::FunctionSignature {
    let name = try tree.add_text_from_bytes(allocator, "");
    let extern_abi = try tree.add_text_from_bytes(allocator, "");
    return ast::FunctionSignature {
        receiver: false,
        name: name,
        static_params: array::new<ast::StaticParam>(allocator),
        params: array::new<ast::Param>(allocator),
        return_type: null,
        requires_unsafe: false,
        extern_abi: extern_abi,
        public: false,
        std: false
    };
}

fn expect_param(
    allocator: Allocator,
    tree: &ast::Ast,
    types: &typ::Table,
    params: &array::Array<ast::Param>,
    index: i64,
    name: []u8,
    type_name: []u8,
    borrow: bool,
    mut_borrow: bool
) -> !void {
    let param = params.get_or_panic(index);
    expect_retained_bytes(tree.texts.at(param.name.node), name);
    testing::expect_equal<bool>(borrow, param.borrow);
    testing::expect_equal<bool>(mut_borrow, param.mut_borrow);
    let rendered = try typ::render(allocator, types, param.type_name);
    defer rendered.deinit();
    expect_retained_bytes(&rendered, type_name);
    return;
}

fn expect_type_expression(
    tree: &ast::Ast,
    expression: ast::Expression,
    expected: []u8
) -> void {
    match tree.expressions.at(expression.node) {
        Type(value) => {
            expect_retained_bytes(
                tree.texts.at(value.type_name.node),
                expected
            );
        },
        _ => testing::fail("parser did not retain a type expression"),
    }
    return;
}

fn add_ident_expression(
    allocator: Allocator,
    tree: &var ast::Ast,
    name: []u8,
    start_column: i64,
    end_column: i64
) -> !ast::Expression {
    let retained = try tree.add_text_from_bytes(allocator, name);
    return tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: retained,
        span: ast::Span {
            source: null,
            start: ast::Position { line: 1, column: start_column },
            end: ast::Position { line: 1, column: end_column }
        }
    }));
}

fn add_field_expression(
    allocator: Allocator,
    tree: &var ast::Ast,
    receiver: ast::Expression,
    name: []u8,
    namespace: bool
) -> !ast::Expression {
    let retained = try tree.add_text_from_bytes(allocator, name);
    return tree.add_expression(ast::ExpressionNode::Field(ast::FieldExpr {
        receiver: receiver,
        name: retained,
        namespace: namespace,
        span: zero_span()
    }));
}

fn expect_struct_literal_type_name(
    allocator: Allocator,
    value: &parser::Parser,
    tree: &ast::Ast,
    expression: ast::Expression,
    expected: []u8
) -> !void {
    if try value.struct_literal_type_name(allocator, tree, expression) |name| {
        defer name.deinit();
        expect_retained_bytes(&name, expected);
    } else {
        testing::fail("parser rejected a struct literal type name");
    }
    return;
}

fn expect_no_struct_literal_type_name(
    allocator: Allocator,
    value: &parser::Parser,
    tree: &ast::Ast,
    expression: ast::Expression
) -> !void {
    if try value.struct_literal_type_name(allocator, tree, expression) |name| {
        name.deinit();
        testing::fail("parser accepted an invalid struct literal type name");
    }
    return;
}

fn expect_type_apply_expression(
    tree: &ast::Ast,
    expression: ast::Expression,
    callee: ast::Expression,
    expected: []u8
) -> void {
    match tree.expressions.at(expression.node) {
        TypeApply(value) => {
            testing::expect(value.callee.node == callee.node);
            expect_retained_bytes(
                tree.texts.at(value.type_arg.node),
                expected
            );
        },
        _ => testing::fail("parser did not retain a type application"),
    }
    return;
}

fn expect_error_ident(
    tree: &ast::Ast,
    expression: ast::Expression,
    start_column: i64,
    end_column: i64
) -> void {
    match tree.expressions.at(expression.node) {
        Ident(value) => {
            expect_retained_bytes(tree.texts.at(value.name.node), "<error>");
            testing::expect_equal<i64>(start_column, value.span.start.column);
            testing::expect_equal<i64>(end_column, value.span.end.column);
        },
        _ => testing::fail("parser did not retain an error identifier"),
    }
    return;
}

fn expect_buffer_literal(
    tree: &ast::Ast,
    expression: ast::Expression,
    expected_size: i64
) -> void {
    match tree.expressions.at(expression.node) {
        BufferLiteral(value) => {
            testing::expect_equal<i64>(expected_size, value.size);
            testing::expect_equal<i64>(1, value.span.start.column);
            testing::expect_equal<i64>(2, value.span.end.column);
        },
        _ => testing::fail("parser did not retain a buffer literal"),
    }
    return;
}

fn parse_break_then_deinit(
    allocator: Allocator,
    tree: &var ast::Ast,
    input: []u8
) -> !ast::Statement {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    return value.parse_break_stmt(tree);
}

fn expect_optional_text(
    tree: &ast::Ast,
    value: ?ast::Text,
    expected: []u8
) -> void {
    if value |text| {
        expect_retained_bytes(tree.texts.at(text.node), expected);
    } else {
        testing::fail("parser did not retain optional text");
    }
    return;
}

fn parse_capture_then_deinit(
    allocator: Allocator,
    tree: &var ast::Ast,
    input: []u8
) -> !?ast::Text {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    return value.parse_payload_capture(tree);
}

fn parse_type_then_deinit(
    allocator: Allocator,
    types: &var typ::Table,
    input: []u8
) -> !?typ::Type {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    return value.parse_type_name(types);
}

fn expect_parsed_type(
    allocator: Allocator,
    types: &var typ::Table,
    input: []u8,
    expected: []u8
) -> !void {
    let parsed = try parse_type_then_deinit(allocator, types, input);
    if parsed |type_name| {
        let rendered = try typ::render(allocator, types, type_name);
        defer rendered.deinit();
        expect_retained_bytes(&rendered, expected);
    } else {
        testing::fail("parser did not retain a type name");
    }
    return;
}

fn expect_type_shape(
    allocator: Allocator,
    types: &var typ::Table,
    input: []u8,
    count: i64,
    first: i64,
    second: i64,
    third: i64
) -> !void {
    let parsed = try parse_type_then_deinit(allocator, types, input);
    if parsed |type_name| {
        var shape = TypeShape {
            count: 0,
            first: 0,
            second: 0,
            third: 0,
            fourth: 0,
            fifth: 0
        };
        typ::walk<TypeShape>(types, type_name, &var shape);
        testing::expect_equal<i64>(count, shape.count);
        testing::expect_equal<i64>(first, shape.first);
        testing::expect_equal<i64>(second, shape.second);
        testing::expect_equal<i64>(third, shape.third);
    } else {
        testing::fail("parser did not retain a type shape");
    }
    return;
}

fn expect_type_error(
    allocator: Allocator,
    input: []u8,
    expected: []u8,
    start_column: i64,
    end_column: i64
) -> !void {
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    let parsed = try value.parse_type_name(&var types);
    if parsed |_| {
        testing::fail("invalid type retained a type name");
    }
    expect_parser_diagnostic(
        &value,
        0,
        expected,
        start_column,
        end_column
    );
    return;
}

fn expect_static_type_arg(
    allocator: Allocator,
    types: &var typ::Table,
    input: []u8,
    allow_const: bool,
    expected: []u8
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    if try value.parse_static_type_arg(types, allow_const) |arg| {
        value.deinit();
        defer arg.deinit();
        expect_retained_bytes(&arg, expected);
    } else {
        value.deinit();
        testing::fail("parser did not retain a static argument");
    }
    return;
}

test "parser lifecycle owns its token stream and diagnostics" {
    let allocator = mem::page_allocator();
    var sources = source::new(allocator);
    defer sources.deinit();
    let path = try string::from_bytes(allocator, "sample.kizu");
    errdefer path.deinit();
    let text = try string::from_bytes(allocator, "first 2");
    errdefer text.deinit();
    let id = try sources.add(move path, move text);
    if sources.at(id) |file| {
        let input = file.text.as_bytes();
        let scanner = lexer::new_source(allocator, id, input);
        var value = try parser::new(allocator, move scanner);
        defer value.deinit();
        testing::expect_equal<i64>(0, value.diagnostics_len());
        if value.diagnostic(0) |_| {
            testing::fail("new parser retained an unexpected diagnostic");
        }
        testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Int, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Int, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        let errors = try value.errors(allocator, &sources);
        defer errors.deinit();
        testing::expect_equal<i64>(0, errors.len());
    } else {
        testing::fail("parser source was not retained");
    }
}

test "parser normalizes lexer comment tokens across Unicode and CRLF" {
    let allocator = mem::page_allocator();
    var input = string::new(allocator);
    defer input.deinit();
    try input.append_bytes("///　first  ");
    try input.append_byte(cast<u8>(13));
    try input.append_byte(cast<u8>(10));
    try input.append_bytes("///");
    try input.append_byte(cast<u8>(13));
    try input.append_byte(cast<u8>(10));
    try input.append_bytes("/// last　");
    try input.append_byte(cast<u8>(13));
    try input.append_byte(cast<u8>(10));
    try input.append_bytes("fn main() {}");
    let source_bytes = input.as_bytes();
    var scanner = lexer::new(allocator, source_bytes);
    defer scanner.deinit();
    let actual = try scanner.next_token();
    defer actual.deinit();
    testing::expect(actual.kind == token::Kind::Function);
    testing::expect_equal<i64>(3, actual.doc_comments.len());

    let empty_scanner = lexer::new(allocator, "");
    var value = try parser::new(allocator, move empty_scanner);
    defer value.deinit();
    let text = try value.comment_text(&actual.doc_comments);
    defer text.deinit();
    var expected = string::new(allocator);
    defer expected.deinit();
    try expected.append_bytes("first  ");
    try expected.append_byte(cast<u8>(10));
    try expected.append_byte(cast<u8>(10));
    try expected.append_bytes("last");
    let expected_bytes = expected.as_bytes();
    expect_retained_bytes(&text, expected_bytes);
}

test "parser comment normalization keeps lexer replacement scalars" {
    let allocator = mem::page_allocator();
    var input = string::new(allocator);
    defer input.deinit();
    try input.append_bytes("/// ");
    try input.append_byte(cast<u8>(255));
    try input.append_byte(cast<u8>(10));
    try input.append_bytes("fn main() {}");
    let source_bytes = input.as_bytes();
    var scanner = lexer::new(allocator, source_bytes);
    defer scanner.deinit();
    let actual = try scanner.next_token();
    defer actual.deinit();
    testing::expect_equal<i64>(1, actual.doc_comments.len());

    let empty_scanner = lexer::new(allocator, "");
    var value = try parser::new(allocator, move empty_scanner);
    defer value.deinit();
    let text = try value.comment_text(&actual.doc_comments);
    defer text.deinit();
    expect_retained_bytes(&text, "�");
}

test "function recovery stub retains visibility docs and empty defaults" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let scanner = lexer::new(allocator, "");
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    let docs = try string::from_bytes(allocator, "Retained docs.");
    var documented = value.function_stub(&var tree, true, move docs);
    defer documented.deinit();
    let empty_docs = string::new(allocator);
    let private = value.function_stub(
        &var tree,
        false,
        move empty_docs
    );
    defer private.deinit();
    value.deinit();
    expect_function_stub(&tree, &documented, true, "Retained docs.");
    expect_function_stub(&tree, &private, false, "");
    documented.signature.requires_unsafe = true;
    testing::expect(documented.signature.requires_unsafe);
}

test "parser recognizes identifier-led error set declarations" {
    let allocator = mem::page_allocator();
    let declaration_scanner = lexer::new(allocator, "error Parse { Failed }");
    var declaration = try parser::new(allocator, move declaration_scanner);
    defer declaration.deinit();
    testing::expect(declaration.starts_error_set_decl());

    let brace_scanner = lexer::new(allocator, "error {");
    var brace = try parser::new(allocator, move brace_scanner);
    defer brace.deinit();
    testing::expect(!brace.starts_error_set_decl());

    let name_scanner = lexer::new(allocator, "errors Parse");
    var name = try parser::new(allocator, move name_scanner);
    defer name.deinit();
    testing::expect(!name.starts_error_set_decl());

    let literal_input =
        \\"error" Parse
    ;
    let literal_scanner = lexer::new(allocator, literal_input);
    var literal = try parser::new(allocator, move literal_scanner);
    defer literal.deinit();
    testing::expect(literal.starts_error_set_decl());
}

test "parser retains enum names docs and compact empty metadata" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\/// State docs.
        \\enum State {
        \\    /// Active docs.
        \\    Active,
        \\    ///
        \\    Idle,
        \\} next
    ;
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_enum_decl(&var tree);
    testing::expect(value.current_kind() == token::Kind::RBrace);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.declarations.at(declaration.node) {
        Enum(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "State");
            expect_retained_bytes(
                tree.texts.at(retained.doc.node),
                "State docs."
            );
            testing::expect_equal<i64>(2, retained.tags.len());
            if retained.tags.at(0) |tag| {
                expect_retained_bytes(tree.texts.at(tag.node), "Active");
            } else {
                testing::fail("missing first enum tag");
            }
            if retained.tags.at(1) |tag| {
                expect_retained_bytes(tree.texts.at(tag.node), "Idle");
            } else {
                testing::fail("missing second enum tag");
            }
            if retained.tag_docs |docs| {
                testing::expect_equal<i64>(1, docs.len());
                if docs.at("Active") |text| {
                    expect_retained_bytes(
                        tree.texts.at(text.node),
                        "Active docs."
                    );
                } else {
                    testing::fail("missing enum tag docs");
                }
                if docs.at("Idle") |_| {
                    testing::fail("empty tag docs were retained");
                }
            } else {
                testing::fail("documented enum lost its tag docs");
            }
            testing::expect(!retained.public);
        },
        _ => testing::fail("parser did not retain an enum declaration"),
    }
}

