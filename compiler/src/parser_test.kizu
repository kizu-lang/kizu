}

test "parser rejects non-type struct literal targets" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let scanner = lexer::new(allocator, "");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    let package = try add_ident_expression(allocator, &var tree, "app", 1, 4);
    let lower = try add_field_expression(
        allocator,
        &var tree,
        package,
        "user",
        true
    );
    try expect_no_struct_literal_type_name(allocator, &value, &tree, lower);
    let owner = try add_ident_expression(allocator, &var tree, "Outer", 1, 6);
    let nested_type = try add_field_expression(
        allocator,
        &var tree,
        owner,
        "Inner",
        true
    );
    try expect_no_struct_literal_type_name(
        allocator,
        &value,
        &tree,
        nested_type
    );
    let instance = try add_field_expression(
        allocator,
        &var tree,
        package,
        "User",
        false
    );
    try expect_no_struct_literal_type_name(allocator, &value, &tree, instance);
    let value_text = try tree.add_text_from_bytes(allocator, "1");
    let integer = tree.add_expression(ast::ExpressionNode::Int(ast::IntExpr {
        value: value_text
    }));
    try expect_no_struct_literal_type_name(allocator, &value, &tree, integer);
}

