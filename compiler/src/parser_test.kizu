    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    expect_impl_names(&tree, declaration, "Show", "User");
}

test "parser keeps partial impl declarations on missing words" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let empty_scanner = lexer::new(allocator, "impl ;");
    var empty = try parser::new(allocator, move empty_scanner);
    errdefer empty.deinit();
    let empty_decl = try empty.parse_impl_decl(&var tree);
    testing::expect(empty.current_kind() == token::Kind::Impl);
    testing::expect(empty.peek_kind() == token::Kind::Semicolon);
    testing::expect_equal<i64>(1, empty.diagnostics_len());
    expect_parser_diagnostic(
        &empty,
        0,
        "expected next token identifier, got `;`",
        1,
        5
    );
    empty.deinit();
    expect_impl_names(&tree, empty_decl, "", "");
    let for_scanner = lexer::new(allocator, "impl Show;");
    var missing_for = try parser::new(allocator, move for_scanner);
    errdefer missing_for.deinit();
    let for_decl = try missing_for.parse_impl_decl(&var tree);
    testing::expect(missing_for.current_kind() == token::Kind::Ident);
    testing::expect(missing_for.peek_kind() == token::Kind::Semicolon);
    testing::expect_equal<i64>(1, missing_for.diagnostics_len());
    let for_message =
        "expected `impl <contract> for Show;`; a method on a type is `fn (self: Show) name(...)`"
        ;
    expect_parser_diagnostic(&missing_for, 0, for_message, 6, 10);
    missing_for.deinit();
    expect_impl_names(&tree, for_decl, "", "");
    let type_scanner = lexer::new(allocator, "impl Show for ;");
    var missing_type = try parser::new(allocator, move type_scanner);
    errdefer missing_type.deinit();
    let type_decl = try missing_type.parse_impl_decl(&var tree);
    testing::expect(missing_type.current_kind() == token::Kind::For);
    testing::expect(missing_type.peek_kind() == token::Kind::Semicolon);
    testing::expect_equal<i64>(1, missing_type.diagnostics_len());
    expect_parser_diagnostic(
        &missing_type,
        0,
        "expected next token identifier, got `;`",
        11,
        14
    );
    missing_type.deinit();
    expect_impl_names(&tree, type_decl, "Show", "");
}

test "parser rejects impl bodies and missing terminators" {
