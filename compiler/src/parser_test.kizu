    testing::expect(terminator.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(1, terminator.diagnostics_len());
    expect_parser_diagnostic(
        &terminator,
        0,
        "expected `;` after impl declaration",
        15,
        19
    );
    terminator.deinit();
    expect_impl_names(&tree, terminator_decl, "Show", "User");
}

test "parser retains function return type graphs" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    var signature = try new_function_signature(allocator, &var tree);
    defer signature.deinit();
    let scanner = lexer::new(allocator, "fn -> !i64");
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    testing::expect(try value.parse_return_clause(&var types, &var signature));
    testing::expect(value.current_kind() == token::Kind::Ident);
    testing::expect(value.peek_kind() == token::Kind::Eof);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    if signature.return_type |return_type| {
        let rendered = try typ::render(allocator, &types, return_type);
        defer rendered.deinit();
        expect_retained_bytes(&rendered, "!i64");
    } else {
        testing::fail("parser did not retain a return type");
    }
}

test "parser return clause absence and failure preserve Go cursor behavior" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    var absent_signature = try new_function_signature(allocator, &var tree);
    defer absent_signature.deinit();
    absent_signature.return_type = try types.parse("i64");
    let absent_scanner = lexer::new(allocator, "fn body");
    var absent = try parser::new(allocator, move absent_scanner);
    defer absent.deinit();
    testing::expect(try absent.parse_return_clause(
        &var types,
        &var absent_signature
    ));
    testing::expect(absent.current_kind() == token::Kind::Function);
    testing::expect(absent.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, absent.diagnostics_len());
    if absent_signature.return_type |_| {} else {
        testing::fail("absent return clause cleared the existing type");
    }
    var failed_signature = try new_function_signature(allocator, &var tree);
    defer failed_signature.deinit();
    failed_signature.return_type = try types.parse("i64");
    let failed_scanner = lexer::new(allocator, "fn -> ;");
    var failed = try parser::new(allocator, move failed_scanner);
    defer failed.deinit();
    testing::expect(!try failed.parse_return_clause(
        &var types,
        &var failed_signature
    ));
    testing::expect(failed.current_kind() == token::Kind::Semicolon);
    testing::expect(failed.peek_kind() == token::Kind::Eof);
    testing::expect_equal<i64>(1, failed.diagnostics_len());
    if failed_signature.return_type |_| {
        testing::fail("invalid return clause retained a type");
    }
    expect_parser_diagnostic(
        &failed,
        0,
        "expected type, got `;`",
        7,
        8
    );
}

test "parser retains borrowed parameters after token cleanup" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, "(a: &i64, b: &var i64,) next");
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    let params = try value.parse_params(&var tree, &var types);
    defer params.deinit();
    testing::expect_equal<i64>(2, params.len());
    testing::expect(value.current_kind() == token::Kind::RParen);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    try expect_param(
        allocator,
        &tree,
        &types,
        &params,
        0,
        "a",
        "i64",
        true,
        false
    );
    try expect_param(
        allocator,
        &tree,
        &types,
        &params,
        1,
        "b",
        "i64",
        true,
        true
    );
}

