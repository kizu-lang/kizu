test "parser rejects receiver counts" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let empty_scanner = lexer::new(allocator, "fn () name");
    var empty = try parser::new(allocator, move empty_scanner);
    defer empty.deinit();
    if try empty.parse_receiver(&var tree, &var types) |params| {
        params.deinit();
        testing::fail("parser accepted zero receivers");
    }
    testing::expect(empty.current_kind() == token::Kind::RParen);
    testing::expect(empty.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(1, empty.diagnostics_len());
    expect_parser_diagnostic(
        &empty,
        0,
        "expected one receiver in `fn (...)`, got 0",
        5,
        6
    );
    let many_scanner = lexer::new(allocator, "fn (a: i64, b: i64) name");
    var many = try parser::new(allocator, move many_scanner);
    defer many.deinit();
    if try many.parse_receiver(&var tree, &var types) |params| {
        params.deinit();
        testing::fail("parser accepted multiple receivers");
    }
    testing::expect(many.current_kind() == token::Kind::RParen);
    testing::expect(many.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(1, many.diagnostics_len());
    expect_parser_diagnostic(
        &many,
        0,
        "expected one receiver in `fn (...)`, got 2",
        19,
        20
    );
}

