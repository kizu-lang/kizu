test "parser reports malformed parameters without appending them" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let comptime_scanner = lexer::new(allocator, "(comptime n: i64)");
    var static_param = try parser::new(allocator, move comptime_scanner);
    defer static_param.deinit();
    let comptime_params = try static_param.parse_params(&var tree, &var types);
    defer comptime_params.deinit();
    testing::expect_equal<i64>(0, comptime_params.len());
    testing::expect(static_param.current_kind() == token::Kind::Comptime);
    testing::expect(static_param.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(1, static_param.diagnostics_len());
    expect_parser_diagnostic(
        &static_param,
        0,
        "compile-time parameter belongs in `<...>`, not `(...)`",
        2,
        10
    );
    let name_scanner = lexer::new(allocator, "(1: i64)");
    var name = try parser::new(allocator, move name_scanner);
    defer name.deinit();
    let name_params = try name.parse_params(&var tree, &var types);
    defer name_params.deinit();
    testing::expect_equal<i64>(0, name_params.len());
    testing::expect(name.current_kind() == token::Kind::Int);
    testing::expect(name.peek_kind() == token::Kind::Colon);
    testing::expect_equal<i64>(1, name.diagnostics_len());
    let name_message =
        \\expected parameter name, got integer "1"
    ;
    expect_parser_diagnostic(
        &name,
        0,
        name_message,
        2,
        3
    );
    let colon_scanner = lexer::new(allocator, "(a i64)");
    var colon = try parser::new(allocator, move colon_scanner);
    defer colon.deinit();
    let colon_params = try colon.parse_params(&var tree, &var types);
    defer colon_params.deinit();
    testing::expect_equal<i64>(0, colon_params.len());
    testing::expect(colon.current_kind() == token::Kind::Ident);
    testing::expect(colon.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(1, colon.diagnostics_len());
    let colon_message =
        \\expected next token `:`, got identifier "i64"
    ;
    expect_parser_diagnostic(
        &colon,
        0,
        colon_message,
        2,
        3
    );
    let type_scanner = lexer::new(allocator, "(a: ;)");
    var type_value = try parser::new(allocator, move type_scanner);
    defer type_value.deinit();
    let type_params = try type_value.parse_params(&var tree, &var types);
    defer type_params.deinit();
    testing::expect_equal<i64>(0, type_params.len());
    testing::expect(type_value.current_kind() == token::Kind::Semicolon);
    testing::expect(type_value.peek_kind() == token::Kind::RParen);
    testing::expect_equal<i64>(1, type_value.diagnostics_len());
    expect_parser_diagnostic(
        &type_value,
        0,
        "expected type, got `;`",
        5,
        6
    );
}

