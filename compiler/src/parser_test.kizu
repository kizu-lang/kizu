    expect_parser_diagnostic(
        &empty_generic,
        0,
        "expected static parameter, got `>`",
        11,
        12
    );
    match tree.declarations.at(empty_generic_decl.node) {
        Union(retained) => {
            testing::expect_equal<i64>(0, retained.type_params.len());
            testing::expect_equal<i64>(0, retained.variants.len());
        },
        _ => testing::fail("parser accepted an empty union generic list"),
    }

    let value_param_scanner = lexer::new(
        allocator,
        "union Box<n: i64> { Value }"
    );
    var value_param = try parser::new(allocator, move value_param_scanner);
