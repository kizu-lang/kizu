test "parser retains generic union variants docs and payload types" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let input =
        \\/// Shape docs.
        \\union Shape<T> {
        \\    /// Point docs.
        \\    Point,
        \\    /// Value docs.
        \\    Value(T),
        \\    Bytes([]u8),
        \\} next
    ;
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_union_decl(&var tree, &var types);
    testing::expect(value.current_kind() == token::Kind::RBrace);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.declarations.at(declaration.node) {
        Union(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "Shape");
            expect_retained_bytes(
                tree.texts.at(retained.doc.node),
                "Shape docs."
            );
            testing::expect_equal<i64>(1, retained.type_params.len());
            if retained.type_params.at(0) |param| {
                expect_retained_bytes(tree.texts.at(param.node), "T");
            } else {
                testing::fail("missing union type parameter");
            }
            testing::expect_equal<i64>(3, retained.variants.len());
            if retained.variants.at(0) |point| {
                expect_retained_bytes(tree.texts.at(point.name.node), "Point");
                expect_retained_bytes(
                    tree.texts.at(point.doc.node),
                    "Point docs."
                );
                if point.payload |_| {
                    testing::fail("payload-free union variant gained a type");
                }
            } else {
                testing::fail("missing payload-free union variant");
            }
            if retained.variants.at(1) |variant| {
                expect_retained_bytes(tree.texts.at(variant.name.node), "Value");
                expect_retained_bytes(
                    tree.texts.at(variant.doc.node),
                    "Value docs."
                );
                if variant.payload |payload| {
                    let rendered = try typ::render(allocator, &types, payload);
                    defer rendered.deinit();
                    expect_retained_bytes(&rendered, "T");
                } else {
                    testing::fail("missing named union payload type");
                }
            } else {
                testing::fail("missing named-payload union variant");
            }
            if retained.variants.at(2) |variant| {
                expect_retained_bytes(tree.texts.at(variant.name.node), "Bytes");
                expect_retained_bytes(tree.texts.at(variant.doc.node), "");
                if variant.payload |payload| {
                    let rendered = try typ::render(allocator, &types, payload);
                    defer rendered.deinit();
                    expect_retained_bytes(&rendered, "[]u8");
                } else {
                    testing::fail("missing slice union payload type");
                }
            } else {
                testing::fail("missing slice-payload union variant");
            }
            testing::expect(!retained.public);
        },
        _ => testing::fail("parser did not retain a union declaration"),
    }
}

test "parser keeps partial union declarations after syntax errors" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let name_scanner = lexer::new(allocator, "union ;");
