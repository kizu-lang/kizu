    expect_parser_diagnostic(
        &name,
        0,
        "expected next token identifier, got `;`",
        1,
        6
    );
    match tree.declarations.at(name_decl.node) {
        Union(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "");
            testing::expect_equal<i64>(0, retained.type_params.len());
            testing::expect_equal<i64>(0, retained.variants.len());
        },
        _ => testing::fail("parser did not retain a partial union"),
    }

    let generic_scanner = lexer::new(allocator, "union Box<T {");
    var generic = try parser::new(allocator, move generic_scanner);
    defer generic.deinit();
    let generic_decl = try generic.parse_union_decl(&var tree, &var types);
    expect_parser_diagnostic(
        &generic,
        0,
        "expected next token `>`, got `{`",
        11,
        12
    );
    match tree.declarations.at(generic_decl.node) {
        Union(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "Box");
            testing::expect_equal<i64>(1, retained.type_params.len());
            testing::expect_equal<i64>(0, retained.variants.len());
        },
        _ => testing::fail("parser did not retain partial generic union"),
    }

    let empty_generic_scanner = lexer::new(allocator, "union Box<> { Value }");
    var empty_generic = try parser::new(
        allocator,
        move empty_generic_scanner
    );
