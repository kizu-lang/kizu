test "parser keeps partial type expressions and exact diagnostics" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let open_scanner = lexer::new(allocator, "type i64");
    var missing_open = try parser::new(allocator, move open_scanner);
    defer missing_open.deinit();
    let empty = try missing_open.parse_type_expr(&var tree, &var types);
    expect_type_expression(&tree, empty, "");
    let expected_open =
        \\expected next token `<`, got identifier "i64"
    ;
    expect_parser_diagnostic(
        &missing_open,
        0,
        expected_open,
        1,
        5
    );
    let arg_scanner = lexer::new(allocator, "type<+>");
    var invalid_arg = try parser::new(allocator, move arg_scanner);
    defer invalid_arg.deinit();
    let invalid = try invalid_arg.parse_type_expr(&var tree, &var types);
    expect_type_expression(&tree, invalid, "");
    expect_parser_diagnostic(
        &invalid_arg,
        0,
        "expected static argument, got `+`",
        6,
        7
    );
    testing::expect(invalid_arg.current_kind() == token::Kind::Plus);
    testing::expect(invalid_arg.peek_kind() == token::Kind::Gt);
    let close_scanner = lexer::new(allocator, "type<i64");
    var missing_close = try parser::new(allocator, move close_scanner);
    defer missing_close.deinit();
    let partial = try missing_close.parse_type_expr(&var tree, &var types);
    expect_type_expression(&tree, partial, "i64");
    expect_parser_diagnostic(
        &missing_close,
        0,
        "expected next token `>`, got end of file",
        6,
        9
    );
}

test "parser retains field namespace and dereference postfix nodes" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let receiver = try add_ident_expression(
        allocator,
        &var tree,
        "pkg",
        1,
        4
    );
    let field_scanner = lexer::new(allocator, ".field");
    var field_parser = try parser::new(allocator, move field_scanner);
    errdefer field_parser.deinit();
    let field = try field_parser.parse_field_expr(
        &var tree,
        receiver,
        false
    );
    testing::expect(field_parser.current_kind() == token::Kind::Ident);
    field_parser.deinit();
    match tree.expressions.at(field.node) {
        Field(value) => {
            testing::expect(value.receiver.node == receiver.node);
            testing::expect(!value.namespace);
            expect_retained_bytes(tree.texts.at(value.name.node), "field");
            testing::expect_equal<i64>(1, value.span.start.column);
            testing::expect_equal<i64>(7, value.span.end.column);
        },
        _ => testing::fail("parser did not retain field access"),
    }
    let namespace_scanner = lexer::new(allocator, "::Item");
    var namespace_parser = try parser::new(
        allocator,
        move namespace_scanner
    );
    defer namespace_parser.deinit();
    let namespace = try namespace_parser.parse_field_expr(
        &var tree,
        receiver,
        true
    );
    match tree.expressions.at(namespace.node) {
        Field(value) => {
            testing::expect(value.namespace);
            expect_retained_bytes(tree.texts.at(value.name.node), "Item");
        },
        _ => testing::fail("parser did not retain namespace access"),
    }
    let deref_scanner = lexer::new(allocator, ".*");
    var deref_parser = try parser::new(allocator, move deref_scanner);
    defer deref_parser.deinit();
    let deref = try deref_parser.parse_field_expr(
        &var tree,
        receiver,
        false
    );
    match tree.expressions.at(deref.node) {
        Deref(value) => {
            testing::expect(value.receiver.node == receiver.node);
            testing::expect_equal<i64>(2, value.operator_span.start.column);
            testing::expect_equal<i64>(3, value.operator_span.end.column);
        },
        _ => testing::fail("parser did not retain postfix dereference"),
    }
}

test "parser retains malformed field nodes with Go diagnostics" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
