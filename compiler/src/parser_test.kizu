    defer value.deinit();
    let field = try value.parse_field_expr(&var tree, receiver, false);
    match tree.expressions.at(field.node) {
        Field(node) => {
            expect_retained_bytes(tree.texts.at(node.name.node), "");
            testing::expect(node.span.is_zero());
        },
        _ => testing::fail("malformed field did not retain a field node"),
    }
    expect_parser_diagnostic(
