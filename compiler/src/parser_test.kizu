}

test "parser keeps partial enum name lists after syntax errors" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let name_scanner = lexer::new(allocator, "enum ;");
    var name = try parser::new(allocator, move name_scanner);
    defer name.deinit();
    let name_decl = try name.parse_enum_decl(&var tree);
    expect_parser_diagnostic(
        &name,
        0,
        "expected next token identifier, got `;`",
        1,
        5
    );
    match tree.declarations.at(name_decl.node) {
        Enum(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "");
            testing::expect_equal<i64>(0, retained.tags.len());
        },
        _ => testing::fail("parser did not retain a partial enum"),
    }

    let brace_scanner = lexer::new(allocator, "enum Color ;");
    var brace = try parser::new(allocator, move brace_scanner);
    defer brace.deinit();
    let brace_decl = try brace.parse_enum_decl(&var tree);
    expect_parser_diagnostic(
        &brace,
        0,
        "expected next token `{`, got `;`",
        6,
        11
    );
    match tree.declarations.at(brace_decl.node) {
        Enum(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "Color");
            testing::expect_equal<i64>(0, retained.tags.len());
        },
        _ => testing::fail("parser did not retain a partial enum"),
    }

    let item_scanner = lexer::new(allocator, "enum Color { 1 }");
    var item = try parser::new(allocator, move item_scanner);
    defer item.deinit();
    let item_decl = try item.parse_enum_decl(&var tree);
    testing::expect(item.current_kind() == token::Kind::Int);
    testing::expect(item.peek_kind() == token::Kind::RBrace);
    let item_message =
        \\expected enum tag, got integer "1"
    ;
    expect_parser_diagnostic(
        &item,
        0,
        item_message,
        14,
        15
    );
    match tree.declarations.at(item_decl.node) {
        Enum(retained) => testing::expect_equal<i64>(0, retained.tags.len()),
        _ => testing::fail("parser did not retain a partial enum"),
    }

    let comma_scanner = lexer::new(allocator, "enum Color { Red Green }");
    var comma = try parser::new(allocator, move comma_scanner);
    defer comma.deinit();
    let comma_decl = try comma.parse_enum_decl(&var tree);
    testing::expect(comma.current_kind() == token::Kind::Ident);
    testing::expect(comma.peek_kind() == token::Kind::Ident);
    expect_parser_diagnostic(
        &comma,
        0,
        "expected `,` after enum tag",
        14,
        17
    );
    match tree.declarations.at(comma_decl.node) {
        Enum(retained) => testing::expect_equal<i64>(1, retained.tags.len()),
        _ => testing::fail("parser did not retain a partial enum"),
    }

    let eof_scanner = lexer::new(allocator, "enum Color { Red");
    var eof = try parser::new(allocator, move eof_scanner);
    defer eof.deinit();
    let eof_decl = try eof.parse_enum_decl(&var tree);
    testing::expect(eof.current_kind() == token::Kind::Eof);
    testing::expect(eof.peek_kind() == token::Kind::Eof);
    testing::expect_equal<i64>(0, eof.diagnostics_len());
    match tree.declarations.at(eof_decl.node) {
        Enum(retained) => testing::expect_equal<i64>(1, retained.tags.len()),
        _ => testing::fail("parser did not retain an EOF partial enum"),
    }
}

test "parser retains error set members and docs after token cleanup" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let input =
        \\/// Failure docs.
        \\error Failure {
        \\    /// Missing docs.
        \\    Missing,
        \\    Timeout,
        \\} next
    ;
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    testing::expect(value.starts_error_set_decl());
    let declaration = try value.parse_error_set_decl(&var tree);
    testing::expect(value.current_kind() == token::Kind::RBrace);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    match tree.declarations.at(declaration.node) {
        ErrorSet(retained) => {
            expect_retained_bytes(
                tree.texts.at(retained.name.node),
                "Failure"
            );
            expect_retained_bytes(
                tree.texts.at(retained.doc.node),
                "Failure docs."
            );
            testing::expect_equal<i64>(2, retained.members.len());
            if retained.members.at(0) |member| {
                expect_retained_bytes(tree.texts.at(member.node), "Missing");
            } else {
                testing::fail("missing first error set member");
            }
            if retained.members.at(1) |member| {
                expect_retained_bytes(tree.texts.at(member.node), "Timeout");
            } else {
                testing::fail("missing second error set member");
            }
            if retained.member_docs |docs| {
                testing::expect_equal<i64>(1, docs.len());
                if docs.at("Missing") |text| {
                    expect_retained_bytes(
                        tree.texts.at(text.node),
                        "Missing docs."
                    );
                } else {
                    testing::fail("missing error set member docs");
                }
                if docs.at("Timeout") |_| {
                    testing::fail("empty error set member docs were retained");
                }
            } else {
                testing::fail("documented error set lost its member docs");
            }
            testing::expect(!retained.public);
        },
        _ => testing::fail("parser did not retain an error set declaration"),
    }
}

