import compiler::ast;
import compiler::lexer;
import compiler::parser;
import compiler::source;
import compiler::token;
import compiler::typ;
import std::mem;
import std::string;
import std::testing;

struct TypeShape {
    count: i64,
    first: i64,
    second: i64,
    third: i64,
    fourth: i64,
    fifth: i64
}

fn (self: &var TypeShape) visit(value: &typ::Node) -> void {
    let code = match value {
        Name(_) => 1,
        Slice(_) => 2,
        Buffer(_) => 3,
        Borrow(_) => 4,
        Optional(_) => 5,
        Const(_) => 6,
        ErrorUnion(_) => 7,
    };
    if self.count == 0 {
        self.first = code;
    } else {
        if self.count == 1 {
            self.second = code;
        } else {
            if self.count == 2 {
                self.third = code;
            } else {
                if self.count == 3 {
                    self.fourth = code;
                } else {
                    if self.count == 4 {
                        self.fifth = code;
                    }
                }
            }
        }
    }
    self.count = self.count + 1;
    return;
}

fn zero_span() -> ast::Span {
    return ast::Span {
        source: null,
        start: ast::Position { line: 0, column: 0 },
        end: ast::Position { line: 0, column: 0 }
    };
}

fn retained_text(
    allocator: Allocator,
    tree: &var ast::Ast,
    bytes: []u8
) -> !ast::Text {
    return tree.add_text_from_bytes(allocator, bytes);
}

fn expect_type_apply_lookahead(
    allocator: Allocator,
    input: []u8,
    expected: bool
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
    testing::expect_equal<token::Kind>(token::Kind::Lt, value.peek_kind());
    testing::expect_equal<bool>(expected, try value.type_apply_looks_like_call());
    testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
    testing::expect_equal<token::Kind>(token::Kind::Lt, value.peek_kind());
    testing::expect_equal<bool>(expected, try value.type_apply_looks_like_call());
    testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
    testing::expect_equal<token::Kind>(token::Kind::Lt, value.peek_kind());
    try value.next_token();
    testing::expect_equal<token::Kind>(token::Kind::Lt, value.current_kind());
    return;
}

fn expect_peek_expression_end(
    allocator: Allocator,
    input: []u8,
    expected: bool
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect_equal<bool>(expected, value.peek_is_expression_end());
    return;
}

fn expect_peek_precedence(
    allocator: Allocator,
    input: []u8,
    expected: i64
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect_equal<i64>(1, value.current_precedence());
    testing::expect_equal<i64>(expected, value.peek_precedence());
    try value.next_token();
    testing::expect_equal<i64>(expected, value.current_precedence());
    return;
}

fn expect_parser_diagnostic(
    value: &parser::Parser,
    index: i64,
    expected: []u8,
    start_column: i64,
    end_column: i64
) -> void {
    if value.diagnostic(index) |entry| {
        let message = entry.message.as_bytes();
        testing::expect_equal<[]u8>(expected, message);
        testing::expect_equal<i64>(1, entry.span.start.line);
        testing::expect_equal<i64>(start_column, entry.span.start.column);
        testing::expect_equal<i64>(1, entry.span.end.line);
        testing::expect_equal<i64>(end_column, entry.span.end.column);
    } else {
        testing::fail("missing parser diagnostic");
    }
    return;
}

fn expect_current_error(
    allocator: Allocator,
    input: []u8,
    expected_kind: token::Kind,
    expected_message: []u8,
    end_column: i64
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect(!try value.expect_current(expected_kind));
    testing::expect_equal<i64>(1, value.diagnostics_len());
    expect_parser_diagnostic(&value, 0, expected_message, 1, end_column);
    return;
}

fn expect_peek_error(
    allocator: Allocator,
    input: []u8,
    expected_kind: token::Kind,
    expected_message: []u8
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect(!try value.expect_peek(expected_kind));
    testing::expect_equal<i64>(1, value.diagnostics_len());
    expect_parser_diagnostic(&value, 0, expected_message, 1, 4);
    return;
}

fn expect_retained_bytes(value: &string::String, expected: []u8) -> void {
    let bytes = value.as_bytes();
    testing::expect_equal<[]u8>(expected, bytes);
    return;
}

fn expect_break_label(
    tree: &ast::Ast,
    statement: ast::Statement,
    expected: []u8
) -> void {
    match tree.statements.at(statement.node) {
        Break(value) => {
            expect_retained_bytes(tree.texts.at(value.label.node), expected);
        },
        _ => testing::fail("parser did not retain a break statement"),
    }
    return;
}

fn expect_continue_label(
    tree: &ast::Ast,
    statement: ast::Statement,
    expected: []u8
) -> void {
    match tree.statements.at(statement.node) {
        Continue(value) => {
            expect_retained_bytes(tree.texts.at(value.label.node), expected);
        },
        _ => testing::fail("parser did not retain a continue statement"),
    }
    return;
}

fn parse_break_then_deinit(
    allocator: Allocator,
    tree: &var ast::Ast,
    input: []u8
) -> !ast::Statement {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    return value.parse_break_stmt(tree);
}

fn expect_optional_text(
    tree: &ast::Ast,
    value: ?ast::Text,
    expected: []u8
) -> void {
    if value |text| {
        expect_retained_bytes(tree.texts.at(text.node), expected);
    } else {
        testing::fail("parser did not retain optional text");
    }
    return;
}

fn parse_capture_then_deinit(
    allocator: Allocator,
    tree: &var ast::Ast,
    input: []u8
) -> !?ast::Text {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    return value.parse_payload_capture(tree);
}

fn parse_type_then_deinit(
    allocator: Allocator,
    types: &var typ::Table,
    input: []u8
) -> !?typ::Type {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    return value.parse_type_name(types);
}

fn expect_parsed_type(
    allocator: Allocator,
    types: &var typ::Table,
    input: []u8,
    expected: []u8
) -> !void {
    let parsed = try parse_type_then_deinit(allocator, types, input);
    if parsed |type_name| {
        let rendered = try typ::render(allocator, types, type_name);
        defer rendered.deinit();
        expect_retained_bytes(&rendered, expected);
    } else {
        testing::fail("parser did not retain a type name");
    }
    return;
}

fn expect_type_shape(
    allocator: Allocator,
    types: &var typ::Table,
    input: []u8,
    count: i64,
    first: i64,
    second: i64,
    third: i64
) -> !void {
    let parsed = try parse_type_then_deinit(allocator, types, input);
    if parsed |type_name| {
        var shape = TypeShape {
            count: 0,
            first: 0,
            second: 0,
            third: 0,
            fourth: 0,
            fifth: 0
        };
        typ::walk<TypeShape>(types, type_name, &var shape);
        testing::expect_equal<i64>(count, shape.count);
        testing::expect_equal<i64>(first, shape.first);
        testing::expect_equal<i64>(second, shape.second);
        testing::expect_equal<i64>(third, shape.third);
    } else {
        testing::fail("parser did not retain a type shape");
    }
    return;
}

fn expect_type_error(
    allocator: Allocator,
    input: []u8,
    expected: []u8,
    start_column: i64,
    end_column: i64
) -> !void {
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    let parsed = try value.parse_type_name(&var types);
    if parsed |_| {
        testing::fail("invalid type retained a type name");
    }
    expect_parser_diagnostic(
        &value,
        0,
        expected,
        start_column,
        end_column
    );
    return;
}

fn expect_static_type_arg(
    allocator: Allocator,
    types: &var typ::Table,
    input: []u8,
    allow_const: bool,
    expected: []u8
) -> !void {
    let scanner = lexer::new(allocator, input);
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    if try value.parse_static_type_arg(types, allow_const) |arg| {
        value.deinit();
        defer arg.deinit();
        expect_retained_bytes(&arg, expected);
    } else {
        value.deinit();
        testing::fail("parser did not retain a static argument");
    }
    return;
}

test "parser lifecycle owns its token stream and diagnostics" {
    let allocator = mem::page_allocator();
    var sources = source::new(allocator);
    defer sources.deinit();
    let path = try string::from_bytes(allocator, "sample.kizu");
    errdefer path.deinit();
    let text = try string::from_bytes(allocator, "first 2");
    errdefer text.deinit();
    let id = try sources.add(move path, move text);
    if sources.at(id) |file| {
        let input = file.text.as_bytes();
        let scanner = lexer::new_source(allocator, id, input);
        var value = try parser::new(allocator, move scanner);
        defer value.deinit();
        testing::expect_equal<i64>(0, value.diagnostics_len());
        if value.diagnostic(0) |_| {
            testing::fail("new parser retained an unexpected diagnostic");
        }
        testing::expect_equal<token::Kind>(token::Kind::Ident, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Int, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Int, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        try value.next_token();
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.current_kind());
        testing::expect_equal<token::Kind>(token::Kind::Eof, value.peek_kind());
        let errors = try value.errors(allocator, &sources);
        defer errors.deinit();
        testing::expect_equal<i64>(0, errors.len());
    } else {
        testing::fail("parser source was not retained");
    }
}

test "type apply lookahead rewinds cached tokens" {
    let allocator = mem::page_allocator();
    try expect_type_apply_lookahead(allocator, "f<T>(x)", true);
    try expect_type_apply_lookahead(allocator, "f<Array<T>>(x)", true);
    try expect_type_apply_lookahead(allocator, "f<T> + x", false);
    try expect_type_apply_lookahead(allocator, "f<T;", false);
    try expect_type_apply_lookahead(allocator, "f<T{", false);
    try expect_type_apply_lookahead(allocator, "f<T}", false);
    try expect_type_apply_lookahead(allocator, "f<T", false);
}

test "type apply target is an identifier or namespace field" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let function_name = try retained_text(allocator, &var tree, "f");
    let empty_name = try retained_text(allocator, &var tree, "");
    let field_name = try retained_text(allocator, &var tree, "call");
    let integer_text = try retained_text(allocator, &var tree, "1");
    let function = tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: function_name,
        span: zero_span()
    }));
    let empty = tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: empty_name,
        span: zero_span()
    }));
    let namespace = tree.add_expression(ast::ExpressionNode::Field(ast::FieldExpr {
        receiver: function,
        name: field_name,
        namespace: true,
        span: zero_span()
    }));
    let instance = tree.add_expression(ast::ExpressionNode::Field(ast::FieldExpr {
        receiver: function,
        name: field_name,
        namespace: false,
        span: zero_span()
    }));
    let integer = tree.add_expression(ast::ExpressionNode::Int(ast::IntExpr {
        value: integer_text
    }));
    let scanner = lexer::new(allocator, "f<T>(x)");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect(try value.should_parse_type_apply(&tree, function));
    testing::expect(try value.should_parse_type_apply(&tree, namespace));
    testing::expect(!try value.should_parse_type_apply(&tree, empty));
    testing::expect(!try value.should_parse_type_apply(&tree, instance));
    testing::expect(!try value.should_parse_type_apply(&tree, integer));
}

test "parser precedence preserves Pratt binding order" {
    let allocator = mem::page_allocator();
    try expect_peek_precedence(allocator, "a orelse", 2);
    try expect_peek_precedence(allocator, "a or", 3);
    try expect_peek_precedence(allocator, "a and", 4);
    try expect_peek_precedence(allocator, "a ==", 5);
    try expect_peek_precedence(allocator, "a !=", 5);
    try expect_peek_precedence(allocator, "a <", 6);
    try expect_peek_precedence(allocator, "a <=", 6);
    try expect_peek_precedence(allocator, "a >", 6);
    try expect_peek_precedence(allocator, "a >=", 6);
    try expect_peek_precedence(allocator, "a +", 7);
    try expect_peek_precedence(allocator, "a -", 7);
    try expect_peek_precedence(allocator, "a *", 8);
    try expect_peek_precedence(allocator, "a /", 8);
    try expect_peek_precedence(allocator, "a %", 8);
    try expect_peek_precedence(allocator, "a (", 10);
    try expect_peek_precedence(allocator, "a [", 10);
    try expect_peek_precedence(allocator, "a .", 11);
    try expect_peek_precedence(allocator, "a ::", 11);
    try expect_peek_precedence(allocator, "a", 1);
}

test "parser recognizes optional expression terminators" {
    let allocator = mem::page_allocator();
    try expect_peek_expression_end(allocator, "a;", true);
    try expect_peek_expression_end(allocator, "a,", true);
    try expect_peek_expression_end(allocator, "a}", true);
    try expect_peek_expression_end(allocator, "a)", true);
    try expect_peek_expression_end(allocator, "a]", true);
    try expect_peek_expression_end(allocator, "a+", false);
}

test "parser expectations retain diagnostics and advance only on match" {
    let allocator = mem::page_allocator();
    let scanner = lexer::new(allocator, "foo 1");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    testing::expect(try value.expect_current(token::Kind::Ident));
    testing::expect_equal<i64>(0, value.diagnostics_len());
    testing::expect(value.current_kind() == token::Kind::Ident);
    testing::expect(value.peek_kind() == token::Kind::Int);
    testing::expect(!try value.expect_peek(token::Kind::String));
    let expected =
        \\expected next token string, got integer "1"
    ;
    expect_parser_diagnostic(&value, 0, expected, 1, 4);
    testing::expect(value.current_kind() == token::Kind::Ident);
    testing::expect(value.peek_kind() == token::Kind::Int);
    testing::expect(try value.expect_peek(token::Kind::Int));
    testing::expect(value.current_kind() == token::Kind::Int);
    testing::expect_equal<i64>(1, value.diagnostics_len());
}

test "parser type close accepts current, nested, and peek angles" {
    let allocator = mem::page_allocator();
    let current_scanner = lexer::new(allocator, "> +");
    var current = try parser::new(allocator, move current_scanner);
    defer current.deinit();
    testing::expect(try current.expect_type_close());
    testing::expect(current.current_kind() == token::Kind::Gt);
    testing::expect(current.peek_kind() == token::Kind::Plus);
    let nested_scanner = lexer::new(allocator, "> >");
    var nested = try parser::new(allocator, move nested_scanner);
    defer nested.deinit();
    testing::expect(try nested.expect_type_close());
    testing::expect(nested.current_kind() == token::Kind::Gt);
    testing::expect(nested.peek_kind() == token::Kind::Eof);
    let peek_scanner = lexer::new(allocator, "< >");
    var peek = try parser::new(allocator, move peek_scanner);
    defer peek.deinit();
    testing::expect(try peek.expect_type_close());
    testing::expect(peek.current_kind() == token::Kind::Gt);
    testing::expect(peek.peek_kind() == token::Kind::Eof);
    let mismatch_scanner = lexer::new(allocator, "< +");
    var mismatch = try parser::new(allocator, move mismatch_scanner);
    defer mismatch.deinit();
    testing::expect(!try mismatch.expect_type_close());
    let expected = "expected next token `>`, got `+`";
    expect_parser_diagnostic(&mismatch, 0, expected, 1, 2);
    testing::expect(mismatch.current_kind() == token::Kind::Lt);
    testing::expect(mismatch.peek_kind() == token::Kind::Plus);
}

test "parser statement terminators accept current and peek semicolons" {
    let allocator = mem::page_allocator();
    let current_scanner = lexer::new(allocator, "; +");
    var current = try parser::new(allocator, move current_scanner);
    defer current.deinit();
    testing::expect(try current.expect_statement_terminator("return statement"));
    testing::expect(current.current_kind() == token::Kind::Semicolon);
    testing::expect(current.peek_kind() == token::Kind::Plus);
    let peek_scanner = lexer::new(allocator, "foo ;");
    var peek = try parser::new(allocator, move peek_scanner);
    defer peek.deinit();
    testing::expect(try peek.expect_statement_terminator("return statement"));
    testing::expect(peek.current_kind() == token::Kind::Semicolon);
    testing::expect(peek.peek_kind() == token::Kind::Eof);
    let mismatch_scanner = lexer::new(allocator, "foo +");
    var mismatch = try parser::new(allocator, move mismatch_scanner);
    defer mismatch.deinit();
    testing::expect(!try mismatch.expect_statement_terminator("return statement"));
    let expected = "expected `;` after return statement";
    expect_parser_diagnostic(&mismatch, 0, expected, 1, 4);
    testing::expect(mismatch.current_kind() == token::Kind::Ident);
    testing::expect(mismatch.peek_kind() == token::Kind::Plus);
}

test "parser list delimiters accept comma, brace, and end of file" {
    let allocator = mem::page_allocator();
    let comma_scanner = lexer::new(allocator, "foo ,");
    var comma = try parser::new(allocator, move comma_scanner);
    defer comma.deinit();
    testing::expect(try comma.consume_list_delimiter("struct field"));
    testing::expect(comma.current_kind() == token::Kind::Comma);
    testing::expect(comma.peek_kind() == token::Kind::Eof);
    let brace_scanner = lexer::new(allocator, "foo }");
    var brace = try parser::new(allocator, move brace_scanner);
    defer brace.deinit();
    testing::expect(try brace.consume_list_delimiter("struct field"));
    testing::expect(brace.current_kind() == token::Kind::Ident);
    testing::expect(brace.peek_kind() == token::Kind::RBrace);
    let eof_scanner = lexer::new(allocator, "foo");
    var eof = try parser::new(allocator, move eof_scanner);
    defer eof.deinit();
    testing::expect(try eof.consume_list_delimiter("struct field"));
    testing::expect(eof.current_kind() == token::Kind::Ident);
    testing::expect(eof.peek_kind() == token::Kind::Eof);
    let mismatch_scanner = lexer::new(allocator, "foo ;");
    var mismatch = try parser::new(allocator, move mismatch_scanner);
    defer mismatch.deinit();
    testing::expect(!try mismatch.consume_list_delimiter("struct field"));
    let expected = "expected `,` after struct field";
    expect_parser_diagnostic(&mismatch, 0, expected, 1, 4);
    testing::expect(mismatch.current_kind() == token::Kind::Ident);
    testing::expect(mismatch.peek_kind() == token::Kind::Semicolon);
}

test "parser retains break and continue labels in the AST" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let break_scanner = lexer::new(allocator, "break :outer;");
    var break_parser = try parser::new(allocator, move break_scanner);
    defer break_parser.deinit();
    let break_statement = try break_parser.parse_break_stmt(&var tree);
    expect_break_label(&tree, break_statement, "outer");
    testing::expect(break_parser.current_kind() == token::Kind::Semicolon);
    testing::expect_equal<i64>(0, break_parser.diagnostics_len());
    let continue_scanner = lexer::new(allocator, "continue;");
    var continue_parser = try parser::new(allocator, move continue_scanner);
    defer continue_parser.deinit();
    let continue_statement = try continue_parser.parse_continue_stmt(&var tree);
    expect_continue_label(&tree, continue_statement, "");
    testing::expect(
        continue_parser.current_kind() == token::Kind::Semicolon
    );
    testing::expect_equal<i64>(0, continue_parser.diagnostics_len());
    let retained = try parse_break_then_deinit(
        allocator,
        &var tree,
        "break :retained;"
    );
    expect_break_label(&tree, retained, "retained");
}

test "parser retains branch nodes while reporting label and terminator errors" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let label_scanner = lexer::new(allocator, "break :;");
    var label_parser = try parser::new(allocator, move label_scanner);
    defer label_parser.deinit();
    let break_statement = try label_parser.parse_break_stmt(&var tree);
    expect_break_label(&tree, break_statement, "");
    let expected_label = "expected next token identifier, got `;`";
    expect_parser_diagnostic(&label_parser, 0, expected_label, 7, 8);
    testing::expect(label_parser.current_kind() == token::Kind::Semicolon);
    let terminator_scanner = lexer::new(allocator, "continue :outer");
    var terminator_parser = try parser::new(allocator, move terminator_scanner);
    defer terminator_parser.deinit();
    let continue_statement = try terminator_parser.parse_continue_stmt(
        &var tree
    );
    expect_continue_label(&tree, continue_statement, "outer");
    let expected_terminator = "expected `;` after continue statement";
    expect_parser_diagnostic(
        &terminator_parser,
        0,
        expected_terminator,
        11,
        16
    );
    testing::expect(terminator_parser.current_kind() == token::Kind::Ident);
    testing::expect(terminator_parser.peek_kind() == token::Kind::Eof);
}

test "parser retains keyword literal expressions" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let true_scanner = lexer::new(allocator, "true");
    var true_parser = try parser::new(allocator, move true_scanner);
    defer true_parser.deinit();
    let true_expression = true_parser.parse_keyword_literal_expression(
        &var tree
    );
    match tree.expressions.at(true_expression.node) {
        Bool(value) => testing::expect(value.value),
        _ => testing::fail("true did not retain a bool expression"),
    }
    let false_scanner = lexer::new(allocator, "false");
    var false_parser = try parser::new(allocator, move false_scanner);
    defer false_parser.deinit();
    let false_expression = false_parser.parse_keyword_literal_expression(
        &var tree
    );
    match tree.expressions.at(false_expression.node) {
        Bool(value) => testing::expect(!value.value),
        _ => testing::fail("false did not retain a bool expression"),
    }
    let null_scanner = lexer::new(allocator, "null");
    var null_parser = try parser::new(allocator, move null_scanner);
    defer null_parser.deinit();
    let null_expression = null_parser.parse_keyword_literal_expression(
        &var tree
    );
    match tree.expressions.at(null_expression.node) {
        Null(value) => {
            testing::expect_equal<i64>(1, value.span.start.line);
            testing::expect_equal<i64>(1, value.span.start.column);
            testing::expect_equal<i64>(1, value.span.end.line);
            testing::expect_equal<i64>(5, value.span.end.column);
        },
        _ => testing::fail("null did not retain a null expression"),
    }
}

test "parser retains optional payload captures after token cleanup" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let absent_scanner = lexer::new(allocator, "value +");
    var absent_parser = try parser::new(allocator, move absent_scanner);
    defer absent_parser.deinit();
    let absent = try absent_parser.parse_payload_capture(&var tree);
    expect_optional_text(&tree, absent, "");
    testing::expect(absent_parser.current_kind() == token::Kind::Ident);
    testing::expect(absent_parser.peek_kind() == token::Kind::Plus);
    let present = try parse_capture_then_deinit(
        allocator,
        &var tree,
        "value |held|"
    );
    expect_optional_text(&tree, present, "held");
}

test "parser rejects malformed payload captures without retained text" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let name_scanner = lexer::new(allocator, "value | |");
    var name_parser = try parser::new(allocator, move name_scanner);
    defer name_parser.deinit();
    let missing_name = try name_parser.parse_payload_capture(&var tree);
    if missing_name |_| {
        testing::fail("malformed capture retained a name");
    }
    let expected_name = "expected next token identifier, got `|`";
    expect_parser_diagnostic(&name_parser, 0, expected_name, 7, 8);
    testing::expect(name_parser.current_kind() == token::Kind::Pipe);
    testing::expect(name_parser.peek_kind() == token::Kind::Pipe);
    let close_scanner = lexer::new(allocator, "value |held +");
    var close_parser = try parser::new(allocator, move close_scanner);
    defer close_parser.deinit();
    let missing_close = try close_parser.parse_payload_capture(&var tree);
    if missing_close |_| {
        testing::fail("unclosed capture retained a name");
    }
    let expected_close = "expected next token `|`, got `+`";
    expect_parser_diagnostic(&close_parser, 0, expected_close, 8, 12);
    testing::expect(close_parser.current_kind() == token::Kind::Ident);
    testing::expect(close_parser.peek_kind() == token::Kind::Plus);
}

test "parser retains canonical type names after token cleanup" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    try expect_parsed_type(allocator, &var types, "i64", "i64");
    try expect_parsed_type(allocator, &var types, "?i64", "?i64");
    try expect_parsed_type(allocator, &var types, "!&var T", "!&var T");
    try expect_parsed_type(
        allocator,
        &var types,
        "ParseError!std::array::Array<T>",
        "ParseError!std::array::Array<T>"
    );
    try expect_parsed_type(allocator, &var types, "[]u8", "[]u8");
    try expect_parsed_type(allocator, &var types, "[004]u8", "[4]u8");
    try expect_parsed_type(
        allocator,
        &var types,
        "ptr<const u8>",
        "ptr<const u8>"
    );
    try expect_parsed_type(
        allocator,
        &var types,
        "Array<ptr<const u8>>",
        "Array<ptr<const u8>>"
    );
    try expect_parsed_type(
        allocator,
        &var types,
        "std::map::Map<[]u8, Array<?T>>",
        "std::map::Map<[]u8, Array<?T>>"
    );
    try expect_parsed_type(
        allocator,
        &var types,
        "Array<T,>",
        "Array<T>"
    );
    try expect_parsed_type(allocator, &var types, "E!F!T", "E!F!T");
}

test "parser preserves prefix and error union graph precedence" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    try expect_type_shape(
        allocator,
        &var types,
        "?E!T",
        4,
        5,
        7,
        1
    );
    try expect_type_shape(
        allocator,
        &var types,
        "&E!T",
        4,
        4,
        7,
        1
    );
    try expect_type_shape(
        allocator,
        &var types,
        "[]E!T",
        4,
        2,
        7,
        1
    );
    try expect_type_shape(
        allocator,
        &var types,
        "[2]E!T",
        4,
        3,
        7,
        1
    );
    try expect_type_shape(
        allocator,
        &var types,
        "E!F!T",
        5,
        7,
        1,
        7
    );
}

test "parser reports malformed type names at the current token" {
    let allocator = mem::page_allocator();
    try expect_type_error(
        allocator,
        "+",
        "expected type, got `+`",
        1,
        2
    );
    try expect_type_error(
        allocator,
        "[0]u8",
        "buffer size must be a positive integer, got 0",
        2,
        3
    );
    try expect_type_error(
        allocator,
        "[9223372036854775808]u8",
        "buffer size must be a positive integer, got 9223372036854775808",
        2,
        21
    );
    try expect_type_error(
        allocator,
        "[]const u8",
        "expected static type argument, got const",
        3,
        8
    );
    try expect_type_error(
        allocator,
        "Array<T",
        "expected next token `>`, got end of file",
        7,
        8
    );
    try expect_type_error(
        allocator,
        "Array<>",
        "expected type, got `>`",
        7,
        8
    );
}

test "parser keeps a valid namespace prefix before a malformed suffix" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, "std::+");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    let parsed = try value.parse_type_name(&var types);
    if parsed |type_name| {
        let rendered = try typ::render(allocator, &types, type_name);
        defer rendered.deinit();
        expect_retained_bytes(&rendered, "std");
    } else {
        testing::fail("valid namespace prefix was discarded");
    }
    let expected = "expected next token identifier, got `+`";
    expect_parser_diagnostic(&value, 0, expected, 4, 6);
    testing::expect(value.current_kind() == token::Kind::DoubleColon);
    testing::expect(value.peek_kind() == token::Kind::Plus);
}

test "parser applies ptr const rules to the retained partial path" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, "ptr::<const u8>");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    let parsed = try value.parse_type_name(&var types);
    if parsed |type_name| {
        let rendered = try typ::render(allocator, &types, type_name);
        defer rendered.deinit();
        expect_retained_bytes(&rendered, "ptr<const u8>");
    } else {
        testing::fail("partial ptr path did not retain const arguments");
    }
    let expected = "expected next token identifier, got `<`";
    expect_parser_diagnostic(&value, 0, expected, 4, 6);
    testing::expect(value.current_kind() == token::Kind::Gt);
    testing::expect(value.peek_kind() == token::Kind::Eof);
}

test "parser renders static arguments independently of its token stream" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    try expect_static_type_arg(
        allocator,
        &var types,
        "Array<?T>",
        false,
        "Array<?T>"
    );
    try expect_static_type_arg(
        allocator,
        &var types,
        "ptr<const u8>",
        false,
        "ptr<const u8>"
    );
    try expect_static_type_arg(
        allocator,
        &var types,
        "const u8",
        true,
        "const u8"
    );
    try expect_static_type_arg(
        allocator,
        &var types,
        "4096",
        false,
        "4096"
    );
    try expect_static_type_arg(
        allocator,
        &var types,
        "true",
        false,
        "true"
    );
}

test "parser joins static argument lists and retains closing tokens" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(
        allocator,
        "Array<T>, 4096, true,>"
    );
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    if try value.parse_type_arg_list(&var types, false) |args| {
        defer args.deinit();
        expect_retained_bytes(&args, "Array<T>, 4096, true");
    } else {
        testing::fail("parser discarded a static argument list");
    }
    testing::expect(value.current_kind() == token::Kind::Comma);
    testing::expect(value.peek_kind() == token::Kind::Gt);
    testing::expect(try value.expect_type_close());
    testing::expect(value.current_kind() == token::Kind::Gt);
}

test "parser preserves nested static argument closing tokens" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, "Array<T>>");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    if try value.parse_type_arg_list(&var types, false) |args| {
        defer args.deinit();
        expect_retained_bytes(&args, "Array<T>");
    } else {
        testing::fail("parser discarded a nested static argument");
    }
    testing::expect(value.current_kind() == token::Kind::Gt);
    testing::expect(value.peek_kind() == token::Kind::Gt);
    testing::expect(try value.expect_type_close());
    testing::expect(value.current_kind() == token::Kind::Gt);
    testing::expect(value.peek_kind() == token::Kind::Eof);
}

test "parser rejects invalid static arguments without a partial list" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, "i64, +");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    if try value.parse_type_arg_list(&var types, false) |_| {
        testing::fail("parser retained a partial static argument list");
    }
    let expected = "expected static argument, got `+`";
    expect_parser_diagnostic(&value, 0, expected, 6, 7);
    testing::expect(value.current_kind() == token::Kind::Plus);
    let const_scanner = lexer::new(allocator, "const u8");
    var const_parser = try parser::new(allocator, move const_scanner);
    defer const_parser.deinit();
    if try const_parser.parse_static_type_arg(&var types, false) |_| {
        testing::fail("parser accepted const outside an allowed position");
    }
    let const_expected = "expected static type argument, got const";
    expect_parser_diagnostic(
        &const_parser,
        0,
        const_expected,
        1,
        6
    );
}

test "parser retains static parameters in Ast and type Table owners" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, "<T, n: i64,>");
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    if try value.parse_static_param_list(&var tree, &var types) |params| {
        defer params.deinit();
        testing::expect(value.current_kind() == token::Kind::Comma);
        testing::expect(value.peek_kind() == token::Kind::Gt);
        value.deinit();
        testing::expect_equal<i64>(2, params.len());
        if params.at(0) |param| {
            expect_retained_bytes(tree.texts.at(param.name.node), "T");
            testing::expect(param.is_type());
        } else {
            testing::fail("missing type static parameter");
        }
        if params.at(1) |param| {
            expect_retained_bytes(tree.texts.at(param.name.node), "n");
            testing::expect(!param.is_type());
            if param.type_name |type_name| {
                let rendered = try typ::render(
                    allocator,
                    &types,
                    type_name
                );
                defer rendered.deinit();
                expect_retained_bytes(&rendered, "i64");
            } else {
                testing::fail("missing value parameter type");
            }
        } else {
            testing::fail("missing value static parameter");
        }
    } else {
        value.deinit();
        testing::fail("parser discarded static parameters");
    }
}

test "parser rejects duplicate and malformed static parameters" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let duplicate_scanner = lexer::new(allocator, "<T, T>");
    var duplicate = try parser::new(allocator, move duplicate_scanner);
    defer duplicate.deinit();
    if try duplicate.parse_static_param_list(&var tree, &var types) |_| {
        testing::fail("parser retained duplicate static parameters");
    }
    expect_parser_diagnostic(
        &duplicate,
        0,
        "duplicate static parameter T",
        5,
        6
    );
    let malformed_scanner = lexer::new(allocator, "<+>");
    var malformed = try parser::new(allocator, move malformed_scanner);
    defer malformed.deinit();
    if try malformed.parse_static_param_list(&var tree, &var types) |_| {
        testing::fail("parser retained a malformed static parameter");
    }
    expect_parser_diagnostic(
        &malformed,
        0,
        "expected static parameter, got `+`",
        2,
        3
    );
}

test "parser keeps Go recovery when a static parameter type is malformed" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, "<n: +>");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    if try value.parse_static_param_list(&var tree, &var types) |params| {
        defer params.deinit();
        testing::expect_equal<i64>(1, params.len());
        if params.at(0) |param| {
            expect_retained_bytes(tree.texts.at(param.name.node), "n");
            testing::expect(param.is_type());
        } else {
            testing::fail("missing recovered static parameter");
        }
    } else {
        testing::fail("parser did not preserve static parameter recovery");
    }
    expect_parser_diagnostic(
        &value,
        0,
        "expected type, got `+`",
        5,
        6
    );
    testing::expect(value.current_kind() == token::Kind::Plus);
    testing::expect(value.peek_kind() == token::Kind::Gt);
}

test "parser accepts only type entries in generic parameter lists" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    var types = typ::new(allocator);
    defer types.deinit();
    let scanner = lexer::new(allocator, "<T, U,>");
    var value = try parser::new(allocator, move scanner);
    defer value.deinit();
    if try value.parse_generic_param_list(&var tree, &var types) |names| {
        defer names.deinit();
        testing::expect_equal<i64>(2, names.len());
        if names.at(0) |name| {
            expect_retained_bytes(tree.texts.at(name.node), "T");
        } else {
            testing::fail("missing first generic parameter");
        }
        if names.at(1) |name| {
            expect_retained_bytes(tree.texts.at(name.node), "U");
        } else {
            testing::fail("missing second generic parameter");
        }
    } else {
        testing::fail("parser discarded generic parameters");
    }
    let value_scanner = lexer::new(allocator, "<T, n: i64>");
    var with_value = try parser::new(allocator, move value_scanner);
    defer with_value.deinit();
    if try with_value.parse_generic_param_list(&var tree, &var types) |_| {
        testing::fail("parser accepted a value parameter as generic type");
    }
    expect_parser_diagnostic(
        &with_value,
        0,
        "expected type parameter, got n: i64",
        8,
        11
    );
}

test "parser token diagnostics preserve every description class" {
    let allocator = mem::page_allocator();
    let identifier =
        \\expected `fn`, got identifier "foo"
    ;
    try expect_current_error(
        allocator,
        "foo",
        token::Kind::Function,
        identifier,
        4
    );
    let symbol =
        "expected identifier, got `+`"
        ;
    try expect_current_error(
        allocator,
        "+",
        token::Kind::Ident,
        symbol,
        2
    );
    let illegal =
        \\expected end of file, got illegal token "#"
    ;
    try expect_current_error(
        allocator,
        "#",
        token::Kind::Eof,
        illegal,
        2
    );
    let eof =
        "expected next token identifier, got end of file"
        ;
    try expect_peek_error(allocator, "foo", token::Kind::Ident, eof);
    let unicode =
        \\expected next token integer, got string "caf\xC3\xA9"
    ;
    let unicode_input =
        \\foo "café"
    ;
    try expect_peek_error(
        allocator,
        unicode_input,
        token::Kind::Int,
        unicode
    );
}
