    let value_param_decl = try value_param.parse_union_decl(
        &var tree,
        &var types
    );
    testing::expect(value_param.current_kind() == token::Kind::Ident);
    testing::expect(value_param.peek_kind() == token::Kind::Gt);
    expect_parser_diagnostic(
        &value_param,
        0,
        "expected type parameter, got n: i64",
        14,
        17
    );
    match tree.declarations.at(value_param_decl.node) {
        Union(retained) => {
            testing::expect_equal<i64>(0, retained.type_params.len());
            testing::expect_equal<i64>(0, retained.variants.len());
        },
        _ => testing::fail("parser accepted a union value parameter"),
    }

    let brace_scanner = lexer::new(allocator, "union Shape ;");
    var brace = try parser::new(allocator, move brace_scanner);
    defer brace.deinit();
    let brace_decl = try brace.parse_union_decl(&var tree, &var types);
    expect_parser_diagnostic(
        &brace,
        0,
        "expected next token `{`, got `;`",
        7,
        12
    );
    match tree.declarations.at(brace_decl.node) {
        Union(retained) => {
            expect_retained_bytes(tree.texts.at(retained.name.node), "Shape");
            testing::expect_equal<i64>(0, retained.variants.len());
        },
        _ => testing::fail("parser did not retain a partial union"),
    }

    let item_scanner = lexer::new(allocator, "union Shape { 1 }");
    var item = try parser::new(allocator, move item_scanner);
    defer item.deinit();
    let item_decl = try item.parse_union_decl(&var tree, &var types);
    let item_message =
        \\expected union variant, got integer "1"
    ;
    expect_parser_diagnostic(&item, 0, item_message, 15, 16);
    match tree.declarations.at(item_decl.node) {
        Union(retained) => testing::expect_equal<i64>(0, retained.variants.len()),
        _ => testing::fail("parser did not retain invalid union prefix"),
    }

    let payload_scanner = lexer::new(
        allocator,
        "union Shape { Circle(i64, Next }"
    );
    var payload = try parser::new(allocator, move payload_scanner);
    defer payload.deinit();
    let payload_decl = try payload.parse_union_decl(&var tree, &var types);
    testing::expect(payload.current_kind() == token::Kind::Ident);
    testing::expect(payload.peek_kind() == token::Kind::Comma);
    expect_parser_diagnostic(
        &payload,
        0,
        "expected next token `)`, got `,`",
        22,
        25
    );
    match tree.declarations.at(payload_decl.node) {
        Union(retained) => testing::expect_equal<i64>(0, retained.variants.len()),
        _ => testing::fail("parser retained malformed union payload"),
    }

    let comma_scanner = lexer::new(
        allocator,
        "union Shape { Point Circle(i64) }"
    );
    var comma = try parser::new(allocator, move comma_scanner);
    defer comma.deinit();
    let comma_decl = try comma.parse_union_decl(&var tree, &var types);
    testing::expect(comma.current_kind() == token::Kind::Ident);
    testing::expect(comma.peek_kind() == token::Kind::Ident);
    expect_parser_diagnostic(
        &comma,
        0,
        "expected `,` after union variant",
        15,
        20
    );
    match tree.declarations.at(comma_decl.node) {
        Union(retained) => testing::expect_equal<i64>(1, retained.variants.len()),
        _ => testing::fail("parser lost partial union variants"),
    }

    let eof_scanner = lexer::new(allocator, "union Shape { Point");
    var eof = try parser::new(allocator, move eof_scanner);
    defer eof.deinit();
    let eof_decl = try eof.parse_union_decl(&var tree, &var types);
    testing::expect(eof.current_kind() == token::Kind::Eof);
    testing::expect(eof.peek_kind() == token::Kind::Eof);
    testing::expect_equal<i64>(0, eof.diagnostics_len());
    match tree.declarations.at(eof_decl.node) {
        Union(retained) => testing::expect_equal<i64>(1, retained.variants.len()),
        _ => testing::fail("parser lost an EOF-partial union"),
    }
}

test "parser retains import paths after token cleanup" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let scanner = lexer::new(allocator, "import app::parser::ast; next");
    var value = try parser::new(allocator, move scanner);
    errdefer value.deinit();
    let declaration = try value.parse_import_decl(&var tree);
    testing::expect(value.current_kind() == token::Kind::Semicolon);
    testing::expect(value.peek_kind() == token::Kind::Ident);
    testing::expect_equal<i64>(0, value.diagnostics_len());
    value.deinit();
    expect_import_path(&tree, declaration, "app", "parser", "ast");
}

test "parser keeps partial imports after syntax errors" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let empty_scanner = lexer::new(allocator, "import ;");
    var empty = try parser::new(allocator, move empty_scanner);
    defer empty.deinit();
    let empty_decl = try empty.parse_import_decl(&var tree);
    expect_empty_import_path(&tree, empty_decl);
    expect_parser_diagnostic(
        &empty,
        0,
        "expected next token identifier, got `;`",
        1,
        7
    );
    let partial_scanner = lexer::new(allocator, "import app::;");
    var partial = try parser::new(allocator, move partial_scanner);
    errdefer partial.deinit();
    let partial_decl = try partial.parse_import_decl(&var tree);
    testing::expect(partial.current_kind() == token::Kind::DoubleColon);
    testing::expect(partial.peek_kind() == token::Kind::Semicolon);
    expect_parser_diagnostic(
        &partial,
        0,
        "expected next token identifier, got `;`",
        11,
        13
    );
    partial.deinit();
    expect_import_path(&tree, partial_decl, "app", "", "");
    let terminator_scanner = lexer::new(allocator, "import app next");
    var terminator = try parser::new(allocator, move terminator_scanner);
    errdefer terminator.deinit();
    let terminator_decl = try terminator.parse_import_decl(&var tree);
    testing::expect(terminator.current_kind() == token::Kind::Ident);
    testing::expect(terminator.peek_kind() == token::Kind::Ident);
    expect_parser_diagnostic(
        &terminator,
        0,
        "expected `;` after import declaration",
        8,
        11
    );
    terminator.deinit();
    expect_import_path(&tree, terminator_decl, "app", "", "");
}

test "parser retains impl declarations after token cleanup" {
    let allocator = mem::page_allocator();
