import compiler::internal::ast;
import compiler::internal::ir;
import compiler::internal::ownership;
import compiler::internal::pool;
import compiler::internal::project;
import compiler::internal::stdtarget;
import compiler::internal::types;
import std::fs;
import std::io;
import std::mem;
import std::string;
import std::testing;

fn ir_marker() -> []u8 {
    return
        \\
        \\
        \\// ir
        \\
    ;
}

fn split_ir_case(data: []u8) -> ?i64 {
    let marker = ir_marker();
    let marker_len = mem::len(marker);
    var index = mem::len(data) - marker_len;
    while index >= 0 {
        if mem::slice(data, index, index + marker_len) |candidate| {
            if mem::equal_bytes(candidate, marker) {
                return index;
            }
        }
        index = index - 1;
    }
    return null;
}

fn append_folded(allocator: Allocator, out: &var string::String, text: []u8) -> !void {
    var index = 0;
    while mem::byte_at(text, index) |byte| {
        if byte == cast<u8>(10) {
            try out.append_byte(allocator, cast<u8>(92));
            try out.append_byte(allocator, cast<u8>(110));
        } else {
            try out.append_byte(allocator, byte);
        }
        index = index + 1;
    }
    return out.append_byte(allocator, cast<u8>(10));
}

fn append_rendered(allocator: Allocator, out: &var string::String, rendered: []u8) -> !void {
    if mem::len(rendered) == 0 {
        return;
    }
    try out.append_bytes(allocator, "// ");
    var index = 0;
    while mem::byte_at(rendered, index) |byte| {
        try out.append_byte(allocator, byte);
        if byte == cast<u8>(10) {
            try out.append_bytes(allocator, "// ");
        }
        index = index + 1;
    }
    return out.append_byte(allocator, cast<u8>(10));
}

fn render_ir_case(
    io: Io,
    allocator: Allocator,
    std_cache: &project::StdCache,
    input: []u8
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    var loader = try project::new_loader(io, allocator, "lib/kizu");
    defer loader.deinit(allocator);
    let loaded = try loader.load_source_cached(&var tree, "", input, std_cache);
    match loaded {
        Error(failed) => {
            defer failed.deinit(allocator);
            let text = try failed.error(allocator, &loader.sources);
            defer text.deinit(allocator);
            let bytes = text.as_bytes();
            try append_both_sections(allocator, &var out, "// check failed: ", bytes);
            return move out;
        },
        Program(program) => {
            defer program.deinit(allocator);
            if try types::check(allocator, &var tree, &program) |failed| {
                defer failed.deinit(allocator);
                let text = try failed.error(allocator, &loader.sources);
                defer text.deinit(allocator);
                let bytes = text.as_bytes();
                try append_both_sections(allocator, &var out, "// check failed: ", bytes);
                return move out;
            }
            var checker = try ownership::new_checker(allocator, &tree, &program);
            defer checker.deinit(allocator);
            if try checker.check_program(&var tree, &program) |failed| {
                defer failed.deinit(allocator);
                let text = try failed.error(allocator, &loader.sources);
                defer text.deinit(allocator);
                let bytes = text.as_bytes();
                try append_both_sections(allocator, &var out, "// check failed: ", bytes);
                return move out;
            }
            var lowerer = try ir::new_lowerer(allocator, &tree, &program, &checker);
            defer lowerer.deinit(allocator);
            if try lowerer.lower(&var tree, &program, &std_cache.error_codes, &loader.sources) |failed| {
                defer failed.deinit(allocator);
                let text = try failed.error(allocator, &loader.sources);
                defer text.deinit(allocator);
                let bytes = text.as_bytes();
                try append_both_sections(allocator, &var out, "// ", bytes);
                return move out;
            }
            try out.append_bytes(allocator, "// lower:");
            try out.append_byte(allocator, cast<u8>(10));
            try append_module(allocator, &var out, &lowerer.module);
            try out.append_bytes(allocator, "// opt:");
            try out.append_byte(allocator, cast<u8>(10));
            if try ir::optimize(allocator, &var lowerer.module, stdtarget::host()) |failed| {
                defer failed.deinit(allocator);
                try out.append_bytes(allocator, "// ");
                let text = try failed.error(allocator, &loader.sources);
                defer text.deinit(allocator);
                let bytes = text.as_bytes();
                try append_folded(allocator, &var out, bytes);
                return move out;
            }
            try append_module(allocator, &var out, &lowerer.module);
            try out.append_bytes(allocator, "// opt wasm:");
            try out.append_byte(allocator, cast<u8>(10));
            try ir::reshape_for_engine(allocator, &var lowerer.module);
            if try ir::verify(allocator, &lowerer.module) |failed| {
                defer failed.deinit(allocator);
                try out.append_bytes(allocator, "// ");
                let text = try failed.error(allocator, &loader.sources);
                defer text.deinit(allocator);
                let bytes = text.as_bytes();
                try append_folded(allocator, &var out, bytes);
                return move out;
            }
            try append_module(allocator, &var out, &lowerer.module);
            return move out;
        },
    }
}

fn append_both_sections(
    allocator: Allocator,
    out: &var string::String,
    prefix: []u8,
    text: []u8
) -> !void {
    try out.append_bytes(allocator, "// lower:");
    try out.append_byte(allocator, cast<u8>(10));
    try out.append_bytes(allocator, prefix);
    try append_folded(allocator, out, text);
    try out.append_bytes(allocator, "// opt:");
    try out.append_byte(allocator, cast<u8>(10));
    try out.append_bytes(allocator, prefix);
    return append_folded(allocator, out, text);
}

fn append_module(allocator: Allocator, out: &var string::String, module: &ir::Module) -> !void {
    let rendered = try render_user_functions(allocator, module);
    defer rendered.deinit(allocator);
    let bytes = rendered.as_bytes();
    return append_rendered(allocator, out, bytes);
}

fn render_user_functions(allocator: Allocator, module: &ir::Module) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var index = 0;
    while module.functions.get(index) |function| {
        index = index + 1;
        let name = module.function_name(function);
        if module.names.starts_with(name, "std::") {
            continue;
        }
        try ir::append_function(allocator, &var out, module, function);
    }
    while out.len() > 0 and last_is_newline(&out) {
        try out.truncate(out.len() - 1);
    }
    return move out;
}

fn last_is_newline(out: &string::String) -> bool {
    let bytes = out.as_bytes();
    return bytes[out.len() - 1] == cast<u8>(10);
}

fn run_ir_corpus(io: Io, allocator: Allocator) -> !void {
    let cached = try project::load_std_cache(io, allocator, "lib/kizu");
    match cached {
        Error(failed) => {
            defer failed.deinit(allocator);
            try io::write_stderr_line(io, "std cache could not be read");
            testing::expect(false);
        },
        Cache(std_cache) => {
            defer std_cache.deinit(allocator);
            var entries = try fs::read_dir(io, allocator, "compiler/tests/ir");
            defer entries.deinit(allocator);
            var cases = 0;
            var failures = 0;
            var index = 0;
            while entries.at(index) |entry| {
                index = index + 1;
                if entry.is_dir {
                    continue;
                }
                cases = cases + 1;
                let entry_path = entry.path.as_bytes();
                let data = try fs::read_file(io, allocator, entry_path, mem::Limit::Unlimited);
                defer data.deinit(allocator);
                let bytes = data.as_bytes();
                if split_ir_case(bytes) |cut| {
                    let input = bytes[0..cut];
                    let want = bytes[cut + mem::len(ir_marker())..mem::len(bytes)];
                    let got = try render_ir_case(io, allocator, &std_cache, input);
                    defer got.deinit(allocator);
                    let got_bytes = got.as_bytes();
                    if !mem::equal_bytes(want, got_bytes) {
                        failures = failures + 1;
                        try io::write_stderr_line(io, entry_path);
                        try io::write_stderr_line(io, "--- want");
                        try io::write_stderr(io, want);
                        try io::write_stderr_line(io, "--- got");
                        try io::write_stderr(io, got_bytes);
                    }
                } else {
                    failures = failures + 1;
                    try io::write_stderr(io, "no `// ir` marker: ");
                    try io::write_stderr_line(io, entry_path);
                }
            }
            testing::expect(cases > 0);
            testing::expect_equal<i64>(0, failures);
        },
    }
    return;
}

test "ir corpus lowers like the shipping compiler" {
    var mem_pool = try pool::new(mem::page_allocator());
    defer mem_pool.deinit(mem::page_allocator());
    let allocator = pool::allocator_of(&var mem_pool);
    return run_ir_corpus(io::blocking(), allocator);
}
