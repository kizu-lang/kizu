import std::array;
import std::mem;
import std::string;

// Mechanical port of internal/stdprim/registry.go. Registry text is static;
// builtin_names() allocates only the caller-owned list it returns.

/// Identifies one primitive argument shape shared by static checkers.
pub enum ArgKind {
    Bytes,
    I64,
    Io,
    StringOut,
}

/// Returns the type spelling represented by kind.
pub fn arg_kind_spelling(kind: ArgKind) -> []u8 {
    return match kind {
        Bytes => "[]u8",
        I64 => "i64",
        Io => "Io",
        StringOut => "&var std::string::String",
    };
}

enum CoreArgs {
    NoArgs,
    Bytes,
    I64,
    IoBytes,
    IoBytesStringOutI64,
    IoStringOutI64,
    SpawnWait8,
}

/// Describes one simple std::internal::builtin call.
pub struct CoreSignature {
    args: CoreArgs,
    pub return_type: []u8
}

/// Returns the number of arguments declared by the signature.
pub fn (self: &CoreSignature) args_len() -> i64 {
    return match self.args {
        NoArgs => 0,
        Bytes => 1,
        I64 => 1,
        IoBytes => 2,
        IoBytesStringOutI64 => 4,
        IoStringOutI64 => 3,
        SpawnWait8 => 9,
    };
}

/// Returns one declared argument kind, or null past the end.
pub fn (self: &CoreSignature) arg_at(index: i64) -> ?ArgKind {
    if index < 0 {
        return null;
    }
    if self.args == CoreArgs::Bytes {
        if index == 0 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::I64 {
        if index == 0 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoBytes {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Bytes;
        }
        return null;
    }
    if self.args == CoreArgs::IoBytesStringOutI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::Bytes;
        }
        if index == 2 {
            return ArgKind::StringOut;
        }
        if index == 3 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::IoStringOutI64 {
        if index == 0 {
            return ArgKind::Io;
        }
        if index == 1 {
            return ArgKind::StringOut;
        }
        if index == 2 {
            return ArgKind::I64;
        }
        return null;
    }
    if self.args == CoreArgs::SpawnWait8 {
        if index == 0 {
            return ArgKind::I64;
        }
        if index >= 1 and index <= 8 {
            return ArgKind::Bytes;
        }
    }
    return null;
}

/// Returns a declarative core signature, or null for another primitive.
pub fn simple_core_signature(name: []u8) -> ?CoreSignature {
    if mem::equal_bytes(name, "std::internal::builtin::mem_page_allocator") {
        return signature(CoreArgs::NoArgs, "Allocator");
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_fixed_buffer") {
        return signature(CoreArgs::Bytes, "Allocator");
    }
    if mem::equal_bytes(name, "std::internal::builtin::mem_len") {
        return signature(CoreArgs::Bytes, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::io_write_stdout") {
        return signature(CoreArgs::IoBytes, "std::io::Error!void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::io_write_stderr") {
        return signature(CoreArgs::IoBytes, "std::io::Error!void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::fs_read_file_into") {
        return signature(
            CoreArgs::IoBytesStringOutI64,
            "std::fs::Error!void"
        );
    }
    if mem::equal_bytes(name, "std::internal::builtin::io_read_stdin_into") {
        return signature(
            CoreArgs::IoStringOutI64,
            "std::io::Error!void"
        );
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_arg_count") {
        return signature(CoreArgs::NoArgs, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_arg") {
        return signature(CoreArgs::I64, "std::process::Error![]u8");
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_env") {
        return signature(CoreArgs::Bytes, "?[]u8");
    }
    if mem::equal_bytes(
        name,
        "std::internal::builtin::process_monotonic_millis"
    ) {
        return signature(CoreArgs::NoArgs, "i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::process_spawn_wait8") {
        return signature(CoreArgs::SpawnWait8, "std::process::Error!i64");
    }
    if mem::equal_bytes(name, "std::internal::builtin::test_fail") {
        return signature(CoreArgs::Bytes, "void");
    }
    if mem::equal_bytes(name, "std::internal::builtin::panic") {
        return signature(CoreArgs::Bytes, "void");
    }
    return null;
}

/// Returns the public wrapper for a typed primitive, or null when absent.
pub fn typed_core_builtin(name: []u8) -> ?[]u8 {
    if mem::equal_bytes(
        name,
        "std::internal::builtin::test_fail_equal"
    ) {
        return "std::testing::expect_equal";
    }
    return null;
}

/// Reports whether name is an implemented std primitive.
pub fn primitive(name: []u8) -> bool {
    var index = 0;
    while builtin_name(index) |known| {
        if mem::equal_bytes(name, known) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

/// Returns every primitive in lexical order.
pub fn builtin_names(
    allocator: Allocator
) -> !array::Array<string::String> {
    var names = array::new<string::String>(allocator);
    errdefer names.deinit();
    var index = 0;
    while builtin_name(index) |name| {
        let owned = try string::from_bytes(allocator, name);
        errdefer owned.deinit();
        try names.append(move owned);
        index = index + 1;
    }
    return move names;
}

fn signature(args: CoreArgs, return_type: []u8) -> CoreSignature {
    return CoreSignature { args: args, return_type: return_type };
}

fn builtin_name(index: i64) -> ?[]u8 {
    if index == 0 { return "std::internal::builtin::arena"; }
    if index == 1 { return "std::internal::builtin::arena_deinit"; }
    if index == 2 { return "std::internal::builtin::arena_len"; }
    if index == 3 { return "std::internal::builtin::arena_pop_or_panic"; }
    if index == 4 { return "std::internal::builtin::array"; }
    if index == 5 { return "std::internal::builtin::array_append"; }
    if index == 6 { return "std::internal::builtin::array_as_bytes"; }
    if index == 7 { return "std::internal::builtin::array_as_mut_bytes"; }
    if index == 8 { return "std::internal::builtin::array_at"; }
    if index == 9 { return "std::internal::builtin::array_at_mut"; }
    if index == 10 { return "std::internal::builtin::array_capacity"; }
    if index == 11 { return "std::internal::builtin::array_clear"; }
    if index == 12 { return "std::internal::builtin::array_deinit"; }
    if index == 13 { return "std::internal::builtin::array_get"; }
    if index == 14 { return "std::internal::builtin::array_get_or_panic"; }
    if index == 15 { return "std::internal::builtin::array_len"; }
    if index == 16 { return "std::internal::builtin::array_pop"; }
    if index == 17 { return "std::internal::builtin::array_pop_or_panic"; }
    if index == 18 { return "std::internal::builtin::array_reserve"; }
    if index == 19 { return "std::internal::builtin::array_set"; }
    if index == 20 { return "std::internal::builtin::array_truncate"; }
    if index == 21 { return "std::internal::builtin::box"; }
    if index == 22 { return "std::internal::builtin::box_borrow"; }
    if index == 23 { return "std::internal::builtin::box_borrow_mut"; }
    if index == 24 { return "std::internal::builtin::box_deinit"; }
    if index == 25 { return "std::internal::builtin::box_take"; }
    if index == 26 { return "std::internal::builtin::fs_create_dir"; }
    if index == 27 { return "std::internal::builtin::fs_exists"; }
    if index == 28 { return "std::internal::builtin::fs_metadata"; }
    if index == 29 { return "std::internal::builtin::fs_read_dir"; }
    if index == 30 { return "std::internal::builtin::fs_read_file_into"; }
    if index == 31 { return "std::internal::builtin::fs_remove_dir"; }
    if index == 32 { return "std::internal::builtin::fs_remove_file"; }
    if index == 33 { return "std::internal::builtin::fs_rename"; }
    if index == 34 { return "std::internal::builtin::fs_write_file"; }
    if index == 35 { return "std::internal::builtin::io_blocking"; }
    if index == 36 { return "std::internal::builtin::io_evented"; }
    if index == 37 { return "std::internal::builtin::io_failing"; }
    if index == 38 { return "std::internal::builtin::io_read_stdin_into"; }
    if index == 39 { return "std::internal::builtin::io_write_stderr"; }
    if index == 40 { return "std::internal::builtin::io_write_stdout"; }
    if index == 41 { return "std::internal::builtin::map"; }
    if index == 42 { return "std::internal::builtin::map_at"; }
    if index == 43 { return "std::internal::builtin::map_at_mut"; }
    if index == 44 { return "std::internal::builtin::map_contains"; }
    if index == 45 { return "std::internal::builtin::map_deinit"; }
    if index == 46 { return "std::internal::builtin::map_get"; }
    if index == 47 { return "std::internal::builtin::map_insert"; }
    if index == 48 { return "std::internal::builtin::map_key_at"; }
    if index == 49 { return "std::internal::builtin::map_len"; }
    if index == 50 { return "std::internal::builtin::map_take_value_at"; }
    if index == 51 { return "std::internal::builtin::mem_fixed_buffer"; }
    if index == 52 { return "std::internal::builtin::mem_len"; }
    if index == 53 { return "std::internal::builtin::mem_page_allocator"; }
    if index == 54 { return "std::internal::builtin::panic"; }
    if index == 55 { return "std::internal::builtin::process_arg"; }
    if index == 56 { return "std::internal::builtin::process_arg_count"; }
    if index == 57 { return "std::internal::builtin::process_env"; }
    if index == 58 { return "std::internal::builtin::process_monotonic_millis"; }
    if index == 59 { return "std::internal::builtin::process_spawn_wait8"; }
    if index == 60 { return "std::internal::builtin::test_fail"; }
    if index == 61 { return "std::internal::builtin::test_fail_equal"; }
    return null;
}
