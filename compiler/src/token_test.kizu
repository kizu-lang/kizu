import compiler::token;
import std::mem;
import std::testing;

fn expect_keyword(text: []u8, expected: token::Kind) -> void {
    testing::expect(token::lookup_ident(text) == expected);
}

test "token lookup recognizes every keyword" {
    expect_keyword("fn", token::Kind::Function);
    expect_keyword("import", token::Kind::Import);
    expect_keyword("pub", token::Kind::Public);
    expect_keyword("let", token::Kind::Let);
    expect_keyword("var", token::Kind::Var);
    expect_keyword("return", token::Kind::Return);
    expect_keyword("defer", token::Kind::Defer);
    expect_keyword("errdefer", token::Kind::ErrDefer);
    expect_keyword("if", token::Kind::If);
    expect_keyword("else", token::Kind::Else);
    expect_keyword("while", token::Kind::While);
    expect_keyword("break", token::Kind::Break);
    expect_keyword("continue", token::Kind::Continue);
    expect_keyword("match", token::Kind::Match);
    expect_keyword("struct", token::Kind::Struct);
    expect_keyword("enum", token::Kind::Enum);
    expect_keyword("union", token::Kind::Union);
    expect_keyword("contract", token::Kind::Contract);
    expect_keyword("for", token::Kind::For);
    expect_keyword("impl", token::Kind::Impl);
    expect_keyword("true", token::Kind::True);
    expect_keyword("false", token::Kind::False);
    expect_keyword("and", token::Kind::And);
    expect_keyword("or", token::Kind::Or);
    expect_keyword("mut", token::Kind::Mut);
    expect_keyword("unsafe", token::Kind::Unsafe);
    expect_keyword("extern", token::Kind::Extern);
    expect_keyword("comptime", token::Kind::Comptime);
    expect_keyword("try", token::Kind::Try);
    expect_keyword("move", token::Kind::Move);
    expect_keyword("null", token::Kind::Null);
    expect_keyword("orelse", token::Kind::Orelse);
}

test "token lookup keeps user names as identifiers" {
    expect_keyword("compiler", token::Kind::Ident);
    expect_keyword("function", token::Kind::Ident);
    expect_keyword("", token::Kind::Ident);
}

fn expect_spelling(kind: token::Kind, expected: []u8) -> void {
    testing::expect(mem::equal_bytes(token::spelling(kind), expected));
}

test "token spellings preserve Go token values" {
    expect_spelling(token::Kind::Illegal, "ILLEGAL");
    expect_spelling(token::Kind::Eof, "EOF");
    expect_spelling(token::Kind::Ident, "IDENT");
    expect_spelling(token::Kind::Int, "INT");
    expect_spelling(token::Kind::String, "STRING");
    expect_spelling(token::Kind::FatArrow, "=>");
    expect_spelling(token::Kind::DoubleColon, "::");
    expect_spelling(token::Kind::LBracket, "[");
    expect_spelling(token::Kind::RBracket, "]");
    expect_spelling(token::Kind::Function, "fn");
    expect_spelling(token::Kind::ErrDefer, "errdefer");
    expect_spelling(token::Kind::Orelse, "orelse");
}
