import compiler::ast;
import compiler::diagnostic;
import compiler::lexer;
import compiler::source;
import compiler::token;
import compiler::typ;
import std::arena;
import std::array;
import std::fmt;
import std::map;
import std::mem;
import std::string;

// Partial mechanical port of internal/parser/parser.go. Expression handles
// borrow their Ast explicitly because the Kizu graph owner replaces Go node
// pointers retained by the runtime.

/// Consumes tokens and builds one source file into a caller-owned AST graph.
pub struct Parser {
    allocator: Allocator,
    scanner: lexer::Lexer,
    tokens: arena::Arena<token::Token>,
    stream: array::Array<arena::Handle<token::Token>>,
    position: i64,
    diagnostics_store: array::Array<diagnostic::Diagnostic>,
    safety: string::String
}

/// Creates a parser and primes its current and lookahead tokens.
pub fn new(allocator: Allocator, scanner: lexer::Lexer) -> !Parser {
    var input = move scanner;
    errdefer input.deinit();
    var tokens = arena::new<token::Token>(allocator);
    errdefer tokens.deinit();
    var stream = array::new<arena::Handle<token::Token>>(allocator);
    errdefer stream.deinit();
    try append_next_token(&var input, &var tokens, &var stream);
    try append_next_token(&var input, &var tokens, &var stream);
    return Parser {
        allocator: allocator,
        scanner: move input,
        tokens: move tokens,
        stream: move stream,
        position: 0,
        diagnostics_store: array::new<diagnostic::Diagnostic>(allocator),
        safety: string::new(allocator)
    };
}

/// Renders parse errors collected so far without CLI severity wrapping.
fn (self: &Parser) errors(
    allocator: Allocator,
    sources: &source::SourceMap
) -> !array::Array<string::String> {
    var out = array::new<string::String>(allocator);
    errdefer out.deinit();
    var index = 0;
    while self.diagnostics_store.at(index) |entry| {
        let rendered = try entry.error(allocator, sources);
        errdefer rendered.deinit();
        try out.append(move rendered);
        index = index + 1;
    }
    return move out;
}

/// Returns the number of structured parse diagnostics collected so far.
fn (self: &Parser) diagnostics_len() -> i64 {
    return self.diagnostics_store.len();
}

/// Borrows one structured parse diagnostic by index.
fn (self: &Parser) diagnostic(index: i64) -> ?&diagnostic::Diagnostic {
    return self.diagnostics_store.at(index);
}

fn (self: &Parser) current_kind() -> token::Kind {
    let handle = self.stream.get_or_panic(self.position);
    return self.tokens.at(handle).kind;
}

fn (self: &Parser) peek_kind() -> token::Kind {
    let handle = self.stream.get_or_panic(self.position + 1);
    return self.tokens.at(handle).kind;
}

fn (self: &Parser) comment_text(
    lines: &array::Array<string::String>
) -> !string::String {
    var separator_storage = [1]u8{};
    let writable = separator_storage.as_mut_bytes();
    writable[0] = cast<u8>(10);
    let separator = separator_storage.as_bytes();
    var out = try string::join(self.allocator, lines, separator);
    string::trim_space_in_place(&var out);
    return move out;
}

fn (self: &Parser) starts_error_set_decl() -> bool {
    let handle = self.stream.get_or_panic(self.position);
    let current = self.tokens.at(handle);
    let literal = current.literal.as_bytes();
    return mem::equal_bytes(literal, "error") and
        self.peek_kind() == token::Kind::Ident;
}

fn (self: &var Parser) parse_import_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    var path = array::new<ast::Text>(self.allocator);
    errdefer path.deinit();
    if !try self.expect_peek(token::Kind::Ident) {
        return add_import_decl(tree, move path);
    }
    let first_handle = self.stream.get_or_panic(self.position);
    let first = try retain_literal(
        self.allocator,
        tree,
        self.tokens.at(first_handle)
    );
    try path.append(first);
    while self.peek_kind() == token::Kind::DoubleColon {
        try self.next_token();
        if !try self.expect_peek(token::Kind::Ident) {
            return add_import_decl(tree, move path);
        }
        let handle = self.stream.get_or_panic(self.position);
        let part = try retain_literal(
            self.allocator,
            tree,
            self.tokens.at(handle)
        );
        try path.append(part);
    }
    let _ = try self.expect_statement_terminator("import declaration");
    return add_import_decl(tree, move path);
}

fn add_import_decl(
    tree: &var ast::Ast,
    path: array::Array<ast::Text>
) -> ast::Declaration {
    return tree.add_declaration(ast::DeclarationNode::Import(
        ast::ImportDecl { path: move path }
    ));
}

// Builds the owned placeholder that declaration parsing mutates until its
// success or recovery path moves it into the Ast exactly once.
fn (self: &Parser) function_stub(
    tree: &var ast::Ast,
    public: bool,
    docs: string::String
) -> ast::FunctionDecl {
    let name = tree.add_text(string::new(self.allocator));
    let extern_abi = tree.add_text(string::new(self.allocator));
    let doc = tree.add_text(move docs);
    return ast::FunctionDecl {
        signature: ast::FunctionSignature {
            receiver: false,
            name: name,
            static_params: array::new<ast::StaticParam>(self.allocator),
            params: array::new<ast::Param>(self.allocator),
            return_type: null,
            requires_unsafe: false,
            extern_abi: extern_abi,
            public: public,
            std: false
        },
        doc: doc,
        derived: false,
        body: null
    };
}

fn (self: &var Parser) parse_return_clause(
    types: &var typ::Table,
    signature: &var ast::FunctionSignature
) -> !bool {
    if self.peek_kind() != token::Kind::Arrow {
        return true;
    }
    try self.next_token();
    try self.next_token();
    let parsed = try self.parse_type_name(types);
    signature.return_type = parsed;
    if parsed |_| {
        return true;
    }
    return false;
}

fn (self: &var Parser) parse_params(
    tree: &var ast::Ast,
    types: &var typ::Table
) -> !array::Array<ast::Param> {
    var params = array::new<ast::Param>(self.allocator);
    errdefer params.deinit();
    try self.next_token();
    if self.current_kind() == token::Kind::RParen {
        return move params;
    }
    while true {
        if self.current_kind() == token::Kind::Comptime {
            try self.record_context_error(
                "compile-time parameter belongs in `<...>`, not `(...)`",
                ""
            );
            return move params;
        }
        if self.current_kind() != token::Kind::Ident {
            let handle = self.stream.get_or_panic(self.position);
            let message = try unexpected_token_message(
                self.allocator,
                "expected parameter name, got ",
                self.tokens.at(handle)
            );
            try self.record_error(move message);
            return move params;
        }
        let name_handle = self.stream.get_or_panic(self.position);
        if !try self.expect_peek(token::Kind::Colon) {
            return move params;
        }
        try self.next_token();
        var borrow = false;
        var mut_borrow = false;
        if self.current_kind() == token::Kind::Amp {
            borrow = true;
            try self.next_token();
            if self.current_kind() == token::Kind::Var {
                mut_borrow = true;
                try self.next_token();
            }
        }
        let parsed = try self.parse_type_name(types);
        if parsed |type_name| {
            let name = try retain_literal(
                self.allocator,
                tree,
                self.tokens.at(name_handle)
            );
            try params.append(ast::Param {
                name: name,
                type_name: type_name,
                borrow: borrow,
                mut_borrow: mut_borrow
            });
        } else {
            return move params;
        }
        if self.peek_kind() != token::Kind::Comma {
            break;
        }
        try self.next_token();
        if self.peek_kind() == token::Kind::RParen {
            break;
        }
        try self.next_token();
    }
    let _ = try self.expect_peek(token::Kind::RParen);
    return move params;
}

fn (self: &var Parser) parse_receiver(
    tree: &var ast::Ast,
    types: &var typ::Table
) -> !?array::Array<ast::Param> {
    try self.next_token();
    var params = try self.parse_params(tree, types);
    errdefer params.deinit();
    if !try self.expect_current(token::Kind::RParen) {
        params.deinit();
        return null;
    }
    if params.len() != 1 {
        var message = string::new(self.allocator);
        errdefer message.deinit();
        try message.append_bytes("expected one receiver in `fn (...)`, got ");
        try fmt::append_i64(&var message, params.len());
        try self.record_error(move message);
        params.deinit();
        return null;
    }
    return move params;
}

fn (self: &var Parser) parse_impl_decl(
    tree: &var ast::Ast
) -> !ast::Declaration {
    if !try self.expect_peek(token::Kind::Ident) {
        return add_empty_impl_decl(self.allocator, tree);
    }
    let contract_handle = self.stream.get_or_panic(self.position);
    if self.peek_kind() != token::Kind::For {
        let message = try impl_missing_for_message(
            self.allocator,
            self.tokens.at(contract_handle)
        );
        try self.record_error(move message);
        return add_empty_impl_decl(self.allocator, tree);
    }
    var contract_name = try owned_token_literal(
        self.allocator,
        self.tokens.at(contract_handle)
    );
    errdefer contract_name.deinit();
    try self.next_token();
    if !try self.expect_peek(token::Kind::Ident) {
        let type_name = string::new(self.allocator);
        return add_impl_decl(tree, move contract_name, move type_name);
    }
    let type_handle = self.stream.get_or_panic(self.position);
    var type_name = try owned_token_literal(
        self.allocator,
        self.tokens.at(type_handle)
    );
    errdefer type_name.deinit();
    if self.peek_kind() == token::Kind::LBrace {
        let message = try impl_body_message(
            self.allocator,
            &contract_name,
            &type_name
        );
        try self.record_error(move message);
        return add_impl_decl(tree, move contract_name, move type_name);
    }
    let _ = try self.expect_statement_terminator("impl declaration");
    return add_impl_decl(tree, move contract_name, move type_name);
}

fn add_empty_impl_decl(
    allocator: Allocator,
    tree: &var ast::Ast
) -> ast::Declaration {
    let contract_name = string::new(allocator);
    let type_name = string::new(allocator);
    return add_impl_decl(tree, move contract_name, move type_name);
}

fn add_impl_decl(
    tree: &var ast::Ast,
    contract_name: string::String,
    type_name: string::String
) -> ast::Declaration {
    let retained_contract = tree.add_text(move contract_name);
    let retained_type = tree.add_text(move type_name);
    return tree.add_declaration(ast::DeclarationNode::Impl(ast::ImplDecl {
        contract_name: retained_contract,
        type_name: retained_type
    }));
}

fn impl_missing_for_message(
    allocator: Allocator,
    contract_token: &token::Token
) -> !string::String {
    var message = string::new(allocator);
    errdefer message.deinit();
    try message.append_bytes("expected `impl <contract> for ");
    let name = contract_token.literal.as_bytes();
    try message.append_bytes(name);
    try message.append_bytes(
        ";`; a method on a type is `fn (self: "
    );
    try message.append_bytes(name);
    try message.append_bytes(") name(...)`");
    return move message;
}

fn impl_body_message(
    allocator: Allocator,
    contract_name: &string::String,
    type_name: &string::String
) -> !string::String {
    var message = string::new(allocator);
    errdefer message.deinit();
    try message.append_bytes("`impl ");
    try append_retained_string(&var message, contract_name);
    try message.append_bytes(" for ");
    try append_retained_string(&var message, type_name);
    try message.append_bytes(
        "` takes no body; write the methods as `fn (self: "
    );
    try append_retained_string(&var message, type_name);
    try message.append_bytes(") name(...)` and end this with `;`");
    return move message;
}

fn (self: &var Parser) expect_current(expected: token::Kind) -> !bool {
    if self.current_kind() == expected {
        return true;
    }
    let handle = self.stream.get_or_panic(self.position);
    let message = try expected_token_message(
        self.allocator,
        "expected ",
        expected,
        self.tokens.at(handle)
    );
    try self.record_error(move message);
    return false;
}

fn (self: &var Parser) expect_peek(expected: token::Kind) -> !bool {
    if self.peek_kind() == expected {
        try self.next_token();
        return true;
    }
    let handle = self.stream.get_or_panic(self.position + 1);
    let message = try expected_token_message(
        self.allocator,
        "expected next token ",
        expected,
        self.tokens.at(handle)
    );
    try self.record_error(move message);
    return false;
}

fn (self: &var Parser) expect_type_close() -> !bool {
    if self.current_kind() == token::Kind::Gt {
        if self.peek_kind() == token::Kind::Gt {
            try self.next_token();
        }
        return true;
    }
    return self.expect_peek(token::Kind::Gt);
}

fn (self: &var Parser) expect_statement_terminator(
    context: []u8
) -> !bool {
    if self.current_kind() == token::Kind::Semicolon {
        return true;
    }
    if self.peek_kind() == token::Kind::Semicolon {
        try self.next_token();
        return true;
    }
    try self.record_context_error("expected `;` after ", context);
    return false;
}

fn (self: &var Parser) consume_list_delimiter(context: []u8) -> !bool {
    return match self.peek_kind() {
        Comma => {
            try self.next_token();
            true
        },
        RBrace => true,
        Eof => true,
        _ => {
            try self.record_context_error("expected `,` after ", context);
            false
        },
    };
}

fn (self: &var Parser) parse_break_stmt(tree: &var ast::Ast) -> !ast::Statement {
    let label = try self.parse_optional_branch_label(tree);
    let node = ast::BreakStmt { label: label };
    let statement = tree.add_statement(ast::StatementNode::Break(node));
    let _ = try self.expect_statement_terminator("break statement");
    return statement;
}

fn (self: &var Parser) parse_continue_stmt(
    tree: &var ast::Ast
) -> !ast::Statement {
    let label = try self.parse_optional_branch_label(tree);
    let node = ast::ContinueStmt { label: label };
    let statement = tree.add_statement(ast::StatementNode::Continue(node));
    let _ = try self.expect_statement_terminator("continue statement");
    return statement;
}

fn (self: &var Parser) parse_optional_branch_label(
    tree: &var ast::Ast
) -> !ast::Text {
    if self.peek_kind() != token::Kind::Colon {
        return tree.add_text_from_bytes(self.allocator, "");
    }
    try self.next_token();
    if !try self.expect_peek(token::Kind::Ident) {
        return tree.add_text_from_bytes(self.allocator, "");
    }
    let handle = self.stream.get_or_panic(self.position);
    return retain_literal(self.allocator, tree, self.tokens.at(handle));
}

fn retain_literal(
    allocator: Allocator,
    tree: &var ast::Ast,
    current: &token::Token
) -> !ast::Text {
    let bytes = current.literal.as_bytes();
    return tree.add_text_from_bytes(allocator, bytes);
}

fn (self: &Parser) parse_keyword_literal_expression(
    tree: &var ast::Ast
) -> ast::Expression {
    let node = match self.current_kind() {
        True => ast::ExpressionNode::Bool(ast::BoolExpr { value: true }),
        False => ast::ExpressionNode::Bool(ast::BoolExpr { value: false }),
        _ => ast::ExpressionNode::Null(ast::NullExpr {
            span: token_span_at(self)
        }),
    };
    return tree.add_expression(move node);
}

fn (self: &var Parser) parse_type_expr(
    tree: &var ast::Ast,
    types: &var typ::Table
) -> !ast::Expression {
    if !try self.expect_peek(token::Kind::Lt) {
        return add_type_expr(tree, string::new(self.allocator));
    }
    try self.next_token();
    if try self.parse_static_type_arg(types, false) |spelling| {
        let expression = add_type_expr(tree, move spelling);
        let _ = try self.expect_type_close();
        return expression;
    }
    return add_type_expr(tree, string::new(self.allocator));
}

fn add_type_expr(
    tree: &var ast::Ast,
    spelling: string::String
) -> ast::Expression {
    let type_name = tree.add_text(move spelling);
    return tree.add_expression(ast::ExpressionNode::Type(
        ast::TypeExpr { type_name: type_name }
    ));
}

fn (self: &var Parser) parse_type_apply_expr(
    tree: &var ast::Ast,
    types: &var typ::Table,
    callee: ast::Expression
) -> !ast::Expression {
    try self.next_token();
    if try self.parse_type_arg_list(types, false) |spelling| {
        let expression = add_type_apply_expr(
            tree,
            callee,
            move spelling
        );
        let _ = try self.expect_type_close();
        return expression;
    }
    return add_type_apply_expr(
        tree,
        callee,
        string::new(self.allocator)
    );
}

fn add_type_apply_expr(
    tree: &var ast::Ast,
    callee: ast::Expression,
    spelling: string::String
) -> ast::Expression {
    let type_arg = tree.add_text(move spelling);
    return tree.add_expression(ast::ExpressionNode::TypeApply(
        ast::TypeApplyExpr { callee: callee, type_arg: type_arg }
    ));
}

fn (self: &var Parser) parse_field_expr(
    tree: &var ast::Ast,
    receiver: ast::Expression,
    namespace: bool
) -> !ast::Expression {
    if !namespace and self.peek_kind() == token::Kind::Asterisk {
        try self.next_token();
        return tree.add_expression(ast::ExpressionNode::Deref(
            ast::DerefExpr {
            receiver: receiver,
            operator_span: token_span_at(self)
        }
        ));
    }
    if !try self.expect_peek(token::Kind::Ident) {
        return add_field_expr(
            tree,
            receiver,
            string::new(self.allocator),
            namespace,
            zero_span()
        );
    }
    let handle = self.stream.get_or_panic(self.position);
    let name = try owned_token_literal(
        self.allocator,
        self.tokens.at(handle)
    );
    let span = join_spans(expression_span(tree, receiver), token_span_at(self));
    return add_field_expr(tree, receiver, move name, namespace, span);
}

fn add_field_expr(
    tree: &var ast::Ast,
    receiver: ast::Expression,
    name: string::String,
    namespace: bool,
    span: ast::Span
) -> ast::Expression {
    let retained_name = tree.add_text(move name);
    return tree.add_expression(ast::ExpressionNode::Field(
        ast::FieldExpr {
        receiver: receiver,
        name: retained_name,
        namespace: namespace,
        span: span
    }
    ));
}

fn (self: &Parser) struct_literal_type_name(
    allocator: Allocator,
    tree: &ast::Ast,
    expression: ast::Expression
) -> !?string::String {
    var parts = array::new<ast::Text>(allocator);
    defer parts.deinit();
    if !try namespace_expr_parts(tree, expression, &var parts) or
        parts.len() == 0 {
        return null;
    }
    let last = parts.get_or_panic(parts.len() - 1);
    if !text_starts_upper(tree, last) {
        return null;
    }
    if parts.len() > 1 {
        let previous = parts.get_or_panic(parts.len() - 2);
        if text_starts_upper(tree, previous) {
            return null;
        }
    }
    var name = string::new(allocator);
    errdefer name.deinit();
    var index = 0;
    while index < parts.len() {
        if index > 0 {
            try name.append_bytes("::");
        }
        let part = parts.get_or_panic(index);
        try append_retained_text(&var name, tree, part);
        index = index + 1;
    }
    return move name;
}

fn namespace_expr_parts(
    tree: &ast::Ast,
    expression: ast::Expression,
    parts: &var array::Array<ast::Text>
) -> !bool {
    match tree.expressions.at(expression.node) {
        Ident(value) => {
            try parts.append(value.name);
            return true;
        },
        Field(value) => {
            if !value.namespace or
                !try namespace_expr_parts(tree, value.receiver, parts) {
                return false;
            }
            try parts.append(value.name);
            return true;
        },
        _ => return false,
    }
}

fn text_starts_upper(tree: &ast::Ast, value: ast::Text) -> bool {
    let retained = tree.texts.at(value.node);
    let bytes = retained.as_bytes();
    return mem::len(bytes) > 0 and
        bytes[0] >= cast<u8>(65) and bytes[0] <= cast<u8>(90);
}

fn (self: &var Parser) parse_buffer_literal_expr(
    tree: &var ast::Ast,
    types: &var typ::Table
) -> !ast::Expression {
    let span = token_span_at(self);
    let parsed = try self.parse_type_name(types);
    if parsed |type_name| {
        match typ::root_node(types, type_name) {
            Buffer(buffer) => {
                let elem_type = typ::child_type(type_name, buffer.elem);
                let elem = try typ::render(
                    self.allocator,
                    types,
                    elem_type
                );
                defer elem.deinit();
                if !string_equals_bytes(&elem, "u8") {
                    let message = try string_value_message(
                        self.allocator,
                        "buffer element must be u8, got ",
                        &elem,
                        ""
                    );
                    try self.record_error(move message);
                    return add_error_ident(self.allocator, tree, span);
                }
                if !try self.expect_peek(token::Kind::LBrace) or
                    !try self.expect_peek(token::Kind::RBrace) {
                    return add_error_ident(self.allocator, tree, span);
                }
                return tree.add_expression(ast::ExpressionNode::BufferLiteral(
                    ast::BufferLiteralExpr { size: buffer.size, span: span }
                ));
            },
            _ => {},
        }
        let rendered = try typ::render(self.allocator, types, type_name);
        defer rendered.deinit();
        let message = try string_value_message(
            self.allocator,
            "expected buffer literal `[N]u8{}`, got type `",
            &rendered,
            "`"
        );
        try self.record_error(move message);
    }
    return add_error_ident(self.allocator, tree, span);
}

fn add_error_ident(
    allocator: Allocator,
    tree: &var ast::Ast,
    span: ast::Span
) -> !ast::Expression {
    let name = try tree.add_text_from_bytes(allocator, "<error>");
    return tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: name,
        span: span
    }));
}

fn string_equals_bytes(value: &string::String, expected: []u8) -> bool {
    let bytes = value.as_bytes();
    return mem::equal_bytes(bytes, expected);
}

fn string_value_message(
    allocator: Allocator,
    prefix: []u8,
    value: &string::String,
    suffix: []u8
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes(prefix);
    let bytes = value.as_bytes();
    try out.append_bytes(bytes);
    try out.append_bytes(suffix);
    return move out;
}

fn token_span_at(parser: &Parser) -> ast::Span {
    let handle = parser.stream.get_or_panic(parser.position);
    return token_span(parser.tokens.at(handle));
}

fn (self: &var Parser) parse_payload_capture(
    tree: &var ast::Ast
) -> !?ast::Text {
    if self.peek_kind() != token::Kind::Pipe {
        let empty = try tree.add_text_from_bytes(self.allocator, "");
        return empty;
    }
    if !try self.expect_peek(token::Kind::Pipe) or
        !try self.expect_peek(token::Kind::Ident) {
        return null;
    }
    if !try self.expect_peek(token::Kind::Pipe) {
        return null;
    }
    let handle = self.stream.get_or_panic(self.position - 1);
    let capture = try retain_literal(
        self.allocator,
        tree,
        self.tokens.at(handle)
    );
    return capture;
}

fn (self: &var Parser) parse_type_name(
    types: &var typ::Table
) -> !?typ::Type {
    var builder = typ::new_builder(self.allocator);
    errdefer builder.deinit();
    let parsed = try self.parse_type_node(&var builder);
    if parsed |root| {
        return typ::finish_builder(move builder, types, root);
    }
    builder.deinit();
    return null;
}

fn (self: &var Parser) parse_type_node(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    match self.current_kind() {
        Bang => return self.parse_error_union_type(builder),
        Amp => return self.parse_borrow_type(builder),
        LBracket => return self.parse_bracket_type(builder),
        Question => return self.parse_optional_type(builder),
        Ident => return self.parse_named_type(builder),
        _ => {
            let handle = self.stream.get_or_panic(self.position);
            let message = try unexpected_token_message(
                self.allocator,
                "expected type, got ",
                self.tokens.at(handle)
            );
            try self.record_error(move message);
            return null;
        },
    }
    return null;
}

fn (self: &var Parser) parse_optional_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    try self.next_token();
    let parsed = try self.parse_type_node(builder);
    if parsed |inner| {
        return builder.add(typ::Node::Optional(typ::Optional {
            elem: inner
        }));
    }
    return null;
}

fn (self: &var Parser) parse_error_union_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    try self.next_token();
    let parsed = try self.parse_type_node(builder);
    if parsed |ok| {
        return builder.add(typ::Node::ErrorUnion(typ::ErrorUnion {
            err: null,
            ok: ok
        }));
    }
    return null;
}

fn (self: &var Parser) parse_borrow_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    try self.next_token();
    let mutable = self.current_kind() == token::Kind::Var;
    if mutable {
        try self.next_token();
    }
    let parsed = try self.parse_type_node(builder);
    if parsed |inner| {
        return builder.add(typ::Node::Borrow(typ::Borrow {
            elem: inner,
            mutable: mutable
        }));
    }
    return null;
}

fn (self: &var Parser) parse_named_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    var path = try self.parse_type_path();
    errdefer path.deinit();
    let allow_const = type_path_is_ptr(&path);
    if self.peek_kind() == token::Kind::Bang {
        let args = array::new<arena::Handle<typ::Node>>(self.allocator);
        let err = builder.add(typ::Node::Name(typ::Name {
            path: move path,
            args: move args
        }));
        try self.next_token();
        try self.next_token();
        let parsed = try self.parse_type_node(builder);
        if parsed |ok| {
            return builder.add(typ::Node::ErrorUnion(typ::ErrorUnion {
                err: err,
                ok: ok
            }));
        }
        return null;
    }
    if self.peek_kind() != token::Kind::Lt {
        let args = array::new<arena::Handle<typ::Node>>(self.allocator);
        return builder.add(typ::Node::Name(typ::Name {
            path: move path,
            args: move args
        }));
    }
    var args = array::new<arena::Handle<typ::Node>>(self.allocator);
    errdefer args.deinit();
    try self.next_token();
    try self.next_token();
    if !try self.parse_type_arguments(builder, &var args, allow_const) or
        !try self.expect_type_close() {
        args.deinit();
        path.deinit();
        return null;
    }
    return builder.add(typ::Node::Name(typ::Name {
        path: move path,
        args: move args
    }));
}

fn (self: &var Parser) parse_type_path() -> !array::Array<string::String> {
    var path = array::new<string::String>(self.allocator);
    errdefer path.deinit();
    let first = self.stream.get_or_panic(self.position);
    try path.append(try owned_token_literal(
        self.allocator,
        self.tokens.at(first)
    ));
    while self.peek_kind() == token::Kind::DoubleColon {
        try self.next_token();
        if !try self.expect_peek(token::Kind::Ident) {
            return move path;
        }
        let part = self.stream.get_or_panic(self.position);
        try path.append(try owned_token_literal(
            self.allocator,
            self.tokens.at(part)
        ));
    }
    return move path;
}

fn (self: &var Parser) parse_type_arguments(
    builder: &var typ::Builder,
    args: &var array::Array<arena::Handle<typ::Node>>,
    allow_const: bool
) -> !bool {
    while true {
        let parsed = try self.parse_type_argument(builder, allow_const);
        if parsed |arg| {
            try args.append(arg);
        } else {
            return false;
        }
        if self.peek_kind() != token::Kind::Comma {
            return true;
        }
        try self.next_token();
        if self.peek_kind() == token::Kind::Gt {
            return true;
        }
        try self.next_token();
    }
    return true;
}

fn (self: &var Parser) parse_type_arg_list(
    types: &var typ::Table,
    allow_const: bool
) -> !?string::String {
    var out = string::new(self.allocator);
    errdefer out.deinit();
    var first = true;
    while true {
        if try self.parse_static_type_arg(types, allow_const) |arg| {
            defer arg.deinit();
            if !first {
                try out.append_bytes(", ");
            }
            let bytes = arg.as_bytes();
            try out.append_bytes(bytes);
            first = false;
        } else {
            out.deinit();
            return null;
        }
        if self.peek_kind() != token::Kind::Comma {
            return move out;
        }
        try self.next_token();
        if self.peek_kind() == token::Kind::Gt {
            return move out;
        }
        try self.next_token();
    }
    return move out;
}

fn (self: &var Parser) parse_generic_param_list(
    tree: &var ast::Ast,
    types: &var typ::Table
) -> !?array::Array<ast::Text> {
    if try self.parse_static_param_list(tree, types) |params| {
        defer params.deinit();
        var names = array::new<ast::Text>(self.allocator);
        errdefer names.deinit();
        var index = 0;
        while params.at(index) |param| {
            if !param.is_type() {
                let message = try expected_type_param_message(
                    self.allocator,
                    tree,
                    types,
                    param
                );
                try self.record_error(move message);
                names.deinit();
                return null;
            }
            try names.append(param.name);
            index = index + 1;
        }
        return move names;
    }
    return null;
}

fn (self: &var Parser) parse_static_param_list(
    tree: &var ast::Ast,
    types: &var typ::Table
) -> !?array::Array<ast::StaticParam> {
    var params = array::new<ast::StaticParam>(self.allocator);
    errdefer params.deinit();
    var seen = map::new<[]u8, bool>(self.allocator);
    defer seen.deinit();
    try self.next_token();
    while true {
        let handle = self.stream.get_or_panic(self.position);
        if self.tokens.at(handle).kind != token::Kind::Ident {
            let message = try unexpected_token_message(
                self.allocator,
                "expected static parameter, got ",
                self.tokens.at(handle)
            );
            try self.record_error(move message);
            params.deinit();
            return null;
        }
        if static_param_seen(&seen, self.tokens.at(handle)) {
            let message = try token_literal_message(
                self.allocator,
                "duplicate static parameter ",
                self.tokens.at(handle)
            );
            try self.record_error(move message);
            params.deinit();
            return null;
        }
        try retain_static_param_name(&var seen, self.tokens.at(handle));
        let name = try retain_literal(
            self.allocator,
            tree,
            self.tokens.at(handle)
        );
        if self.peek_kind() == token::Kind::Colon {
            try self.next_token();
            try self.next_token();
            let type_name = try self.parse_type_name(types);
            try params.append(ast::StaticParam {
                name: name,
                type_name: type_name
            });
        } else {
            try params.append(ast::StaticParam {
                name: name,
                type_name: null
            });
        }
        if self.peek_kind() != token::Kind::Comma {
            return move params;
        }
        try self.next_token();
        if self.peek_kind() == token::Kind::Gt {
            return move params;
        }
        try self.next_token();
    }
    return move params;
}

fn static_param_seen(
    seen: &map::Map<[]u8, bool>,
    current: &token::Token
) -> bool {
    let key = current.literal.as_bytes();
    return seen.contains(key);
}

fn retain_static_param_name(
    seen: &var map::Map<[]u8, bool>,
    current: &token::Token
) -> !void {
    let key = current.literal.as_bytes();
    return seen.insert(key, true);
}

fn expected_type_param_message(
    allocator: Allocator,
    tree: &ast::Ast,
    types: &typ::Table,
    param: &ast::StaticParam
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes("expected type parameter, got ");
    try append_retained_text(&var out, tree, param.name);
    if param.type_name |type_name| {
        try out.append_bytes(": ");
        let rendered = try typ::render(allocator, types, type_name);
        defer rendered.deinit();
        let type_bytes = rendered.as_bytes();
        try out.append_bytes(type_bytes);
    }
    return move out;
}

fn append_retained_text(
    out: &var string::String,
    tree: &ast::Ast,
    value: ast::Text
) -> !void {
    return append_retained_string(out, tree.texts.at(value.node));
}

fn append_retained_string(
    out: &var string::String,
    retained: &string::String
) -> !void {
    let bytes = retained.as_bytes();
    return out.append_bytes(bytes);
}

fn (self: &var Parser) parse_static_type_arg(
    types: &var typ::Table,
    allow_const: bool
) -> !?string::String {
    let kind = self.current_kind();
    if kind == token::Kind::Ident or
        kind == token::Kind::Bang or
        kind == token::Kind::Amp or
        kind == token::Kind::LBracket or
        kind == token::Kind::Question {
        var builder = typ::new_builder(self.allocator);
        errdefer builder.deinit();
        let parsed = try self.parse_type_argument(
            &var builder,
            allow_const
        );
        if parsed |root| {
            let type_name = typ::finish_builder(move builder, types, root);
            return try typ::render(self.allocator, types, type_name);
        }
        builder.deinit();
        return null;
    }
    if kind == token::Kind::Int or
        kind == token::Kind::True or
        kind == token::Kind::False {
        let handle = self.stream.get_or_panic(self.position);
        return try owned_token_literal(
            self.allocator,
            self.tokens.at(handle)
        );
    }
    let handle = self.stream.get_or_panic(self.position);
    let message = try unexpected_token_message(
        self.allocator,
        "expected static argument, got ",
        self.tokens.at(handle)
    );
    try self.record_error(move message);
    return null;
}

fn (self: &var Parser) parse_type_argument(
    builder: &var typ::Builder,
    allow_const: bool
) -> !?arena::Handle<typ::Node> {
    let handle = self.stream.get_or_panic(self.position);
    let is_const = self.current_kind() == token::Kind::Ident and
        token_literal_equal(self.tokens.at(handle), "const");
    if !is_const {
        return self.parse_type_node(builder);
    }
    if !allow_const {
        try self.record_context_error(
            "expected static type argument, got const",
            ""
        );
        return null;
    }
    try self.next_token();
    let parsed = try self.parse_type_node(builder);
    if parsed |inner| {
        return builder.add(typ::Node::Const(typ::Const { elem: inner }));
    }
    return null;
}

fn (self: &var Parser) parse_bracket_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    if self.peek_kind() == token::Kind::Int {
        return self.parse_buffer_type(builder);
    }
    if !try self.expect_peek(token::Kind::RBracket) {
        return null;
    }
    try self.next_token();
    let parsed = try self.parse_type_argument(builder, false);
    if parsed |elem| {
        return builder.add(typ::Node::Slice(typ::Slice { elem: elem }));
    }
    return null;
}

fn (self: &var Parser) parse_buffer_type(
    builder: &var typ::Builder
) -> !?arena::Handle<typ::Node> {
    try self.next_token();
    let handle = self.stream.get_or_panic(self.position);
    var size = 0;
    if positive_decimal(self.tokens.at(handle)) |parsed| {
        size = parsed;
    } else {
        let message = try token_literal_message(
            self.allocator,
            "buffer size must be a positive integer, got ",
            self.tokens.at(handle)
        );
        try self.record_error(move message);
        return null;
    }
    if !try self.expect_peek(token::Kind::RBracket) {
        return null;
    }
    try self.next_token();
    let parsed = try self.parse_type_argument(builder, false);
    if parsed |elem| {
        return builder.add(typ::Node::Buffer(typ::Buffer {
            size: size,
            elem: elem
        }));
    }
    return null;
}

fn owned_token_literal(
    allocator: Allocator,
    current: &token::Token
) -> !string::String {
    let bytes = current.literal.as_bytes();
    return string::from_bytes(allocator, bytes);
}

fn token_literal_equal(current: &token::Token, expected: []u8) -> bool {
    let bytes = current.literal.as_bytes();
    return mem::equal_bytes(bytes, expected);
}

fn type_path_is_ptr(path: &array::Array<string::String>) -> bool {
    if path.len() != 1 {
        return false;
    }
    if path.at(0) |part| {
        let bytes = part.as_bytes();
        return mem::equal_bytes(bytes, "ptr");
    }
    return false;
}

fn positive_decimal(current: &token::Token) -> ?i64 {
    let bytes = current.literal.as_bytes();
    var value = 0;
    var index = 0;
    while index < mem::len(bytes) {
        let digit = cast<i64>(bytes[index] - cast<u8>(48));
        if value > (9223372036854775807 - digit) / 10 {
            return null;
        }
        value = value * 10 + digit;
        index = index + 1;
    }
    if value <= 0 {
        return null;
    }
    return value;
}

fn (self: &var Parser) record_context_error(
    prefix: []u8,
    context: []u8
) -> !void {
    var message = string::new(self.allocator);
    errdefer message.deinit();
    try message.append_bytes(prefix);
    try message.append_bytes(context);
    return self.record_error(move message);
}

fn (self: &var Parser) record_error(message: string::String) -> !void {
    defer message.deinit();
    let handle = self.stream.get_or_panic(self.position);
    let bytes = message.as_bytes();
    let entry = try diagnostic_at_token(
        self.allocator,
        self.tokens.at(handle),
        bytes
    );
    errdefer entry.deinit();
    return self.diagnostics_store.append(move entry);
}

fn expected_token_message(
    allocator: Allocator,
    prefix: []u8,
    expected: token::Kind,
    actual: &token::Token
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes(prefix);
    try append_token_type_description(&var out, expected);
    try out.append_bytes(", got ");
    try append_token_description(&var out, actual);
    return move out;
}

fn unexpected_token_message(
    allocator: Allocator,
    prefix: []u8,
    actual: &token::Token
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes(prefix);
    try append_token_description(&var out, actual);
    return move out;
}

fn token_literal_message(
    allocator: Allocator,
    prefix: []u8,
    actual: &token::Token
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    try out.append_bytes(prefix);
    let bytes = actual.literal.as_bytes();
    try out.append_bytes(bytes);
    return move out;
}

fn append_token_description(
    out: &var string::String,
    actual: &token::Token
) -> !void {
    let literal = actual.literal.as_bytes();
    let class = token_class_description(actual.kind);
    if mem::len(class) > 0 {
        try out.append_bytes(class);
        try out.append_byte(cast<u8>(32));
        return fmt::append_bytes_literal(out, literal);
    }
    if actual.kind == token::Kind::Illegal {
        try out.append_bytes("illegal token");
        if mem::len(literal) > 0 {
            try out.append_byte(cast<u8>(32));
            try fmt::append_bytes_literal(out, literal);
        }
        return;
    }
    if actual.kind == token::Kind::Eof {
        return out.append_bytes("end of file");
    }
    try out.append_byte(cast<u8>(96));
    try out.append_bytes(literal);
    return out.append_byte(cast<u8>(96));
}

fn append_token_type_description(
    out: &var string::String,
    kind: token::Kind
) -> !void {
    let class = token_class_description(kind);
    if mem::len(class) > 0 {
        return out.append_bytes(class);
    }
    if kind == token::Kind::Eof {
        return out.append_bytes("end of file");
    }
    try out.append_byte(cast<u8>(96));
    try out.append_bytes(token::spelling(kind));
    return out.append_byte(cast<u8>(96));
}

fn token_class_description(kind: token::Kind) -> []u8 {
    return match kind {
        Ident => "identifier",
        Int => "integer",
        String => "string",
        _ => "",
    };
}

fn lowest_precedence() -> i64 {
    return 1;
}

// Returns the Pratt binding power for kind, or the lowest power when kind is
// not an infix or postfix operator.
fn precedence(kind: token::Kind) -> i64 {
    return match kind {
        Orelse => 2,
        Or => 3,
        And => 4,
        Eq => 5,
        NotEq => 5,
        Lt => 6,
        Lte => 6,
        Gt => 6,
        Gte => 6,
        Plus => 7,
        Minus => 7,
        Asterisk => 8,
        Slash => 8,
        Percent => 8,
        LParen => 10,
        LBracket => 10,
        Dot => 11,
        DoubleColon => 11,
        _ => lowest_precedence(),
    };
}

fn (self: &Parser) current_precedence() -> i64 {
    return precedence(self.current_kind());
}

fn (self: &Parser) peek_precedence() -> i64 {
    return precedence(self.peek_kind());
}

// Reports whether lookahead closes an optional expression value.
fn (self: &Parser) peek_is_expression_end() -> bool {
    return match self.peek_kind() {
        Semicolon => true,
        Comma => true,
        RBrace => true,
        RParen => true,
        RBracket => true,
        _ => false,
    };
}

// Reports whether `<...>` after expression is a static call argument list.
fn (self: &var Parser) should_parse_type_apply(
    tree: &ast::Ast,
    expression: ast::Expression
) -> !bool {
    if !can_type_apply_target(tree, expression) {
        return false;
    }
    return self.type_apply_looks_like_call();
}

// Scans through a possible static argument list, then restores the token and
// diagnostic cursors so the real parse sees the same state. A lexer allocation
// failure remains terminal for the parse because scanning may already have
// advanced; the caller propagates it and destroys the Parser.
fn (self: &var Parser) type_apply_looks_like_call() -> !bool {
    let position = self.position;
    let diagnostic_count = self.diagnostics_store.len();
    let decision = self.scan_type_apply_lookahead();
    self.restore_lookahead(position, diagnostic_count);
    return move decision;
}

fn (self: &var Parser) scan_type_apply_lookahead() -> !bool {
    try self.next_token();
    var depth = 1;
    while depth > 0 {
        try self.next_token();
        let kind = self.current_kind();
        if kind == token::Kind::Eof or
            kind == token::Kind::Semicolon or
            kind == token::Kind::LBrace or
            kind == token::Kind::RBrace {
            return false;
        }
        if kind == token::Kind::Lt {
            depth = depth + 1;
        }
        if kind == token::Kind::Gt {
            depth = depth - 1;
        }
    }
    return self.peek_kind() == token::Kind::LParen;
}

fn (self: &var Parser) restore_lookahead(
    position: i64,
    diagnostic_count: i64
) -> void {
    self.position = position;
    while self.diagnostics_store.len() > diagnostic_count {
        let abandoned = self.diagnostics_store.pop_or_panic();
        abandoned.deinit();
    }
    return;
}

// Reports whether expression may receive static call arguments.
fn can_type_apply_target(
    tree: &ast::Ast,
    expression: ast::Expression
) -> bool {
    match tree.expressions.at(expression.node) {
        Field(value) => return value.namespace,
        Ident(value) => return retained_text_has_bytes(&tree.texts, value.name),
        _ => return false,
    }
}

fn retained_text_has_bytes(
    texts: &arena::Arena<string::String>,
    value: ast::Text
) -> bool {
    return retained_string_has_bytes(texts.at(value.node));
}

fn retained_string_has_bytes(value: &string::String) -> bool {
    return value.len() > 0;
}

// Builds a half-open diagnostic span from the current parser token.
fn diagnostic_at_token(
    allocator: Allocator,
    current: &token::Token,
    message: []u8
) -> !diagnostic::Diagnostic {
    return diagnostic::new(
        allocator,
        diagnostic::Severity::Error,
        "",
        token_span(current),
        message
    );
}

// Converts a token position into a half-open AST span.
fn token_span(current: &token::Token) -> ast::Span {
    let width = token_width(current);
    return ast::Span {
        source: current.source,
        start: ast::Position {
            line: current.line,
            column: current.column
        },
        end: ast::Position {
            line: current.line,
            column: current.column + width
        }
    };
}

// Counts scalars in lexer-normalized token text. Every byte outside the UTF-8
// continuation range begins exactly one scalar, including the replacement
// scalar used when the source contained invalid UTF-8.
fn token_width(current: &token::Token) -> i64 {
    let bytes = current.literal.as_bytes();
    var width = 0;
    var index = 0;
    while index < mem::len(bytes) {
        let byte = bytes[index];
        if byte < cast<u8>(128) or byte > cast<u8>(191) {
            width = width + 1;
        }
        index = index + 1;
    }
    if width < 1 {
        return 1;
    }
    return width;
}

// Returns the best source span currently stored on an expression.
fn expression_span(tree: &ast::Ast, expression: ast::Expression) -> ast::Span {
    match tree.expressions.at(expression.node) {
        Ident(value) => return value.span,
        Binary(value) => return value.operator_span,
        Call(value) => return expression_span(tree, value.callee),
        TypeApply(value) => return expression_span(tree, value.callee),
        Cast(value) => return value.keyword_span,
        Field(value) => return value.span,
        Deref(value) => return value.operator_span,
        _ => return zero_span(),
    }
}

// Returns the range from first.start to last.end when both are known.
fn join_spans(first: ast::Span, last: ast::Span) -> ast::Span {
    if first.is_zero() {
        return last;
    }
    if last.is_zero() {
        return first;
    }
    return ast::Span {
        source: first.source,
        start: first.start,
        end: last.end
    };
}

// Advances the current token while retaining every scanned token for parser
// rewind and AST text copying.
fn (self: &var Parser) next_token() -> !void {
    let next_position = self.position + 1;
    if next_position + 1 >= self.stream.len() {
        try append_next_token(
            &var self.scanner,
            &var self.tokens,
            &var self.stream
        );
    }
    self.position = next_position;
    return;
}

fn append_next_token(
    scanner: &var lexer::Lexer,
    tokens: &var arena::Arena<token::Token>,
    stream: &var array::Array<arena::Handle<token::Token>>
) -> !void {
    // Reserve before scanning so stream growth failure cannot leave the
    // scanner frontier ahead of the ordered handle stream.
    try stream.reserve(1);
    let next = try scanner.next_token();
    let handle = tokens.add(move next);
    return stream.append(handle);
}

fn zero_span() -> ast::Span {
    return ast::Span {
        source: null,
        start: ast::Position { line: 0, column: 0 },
        end: ast::Position { line: 0, column: 0 }
    };
}
