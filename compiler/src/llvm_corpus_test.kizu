import compiler::internal::ast;
import compiler::internal::diagnostic;
import compiler::internal::ir;
import compiler::internal::llvm;
import compiler::internal::ownership;
import compiler::internal::pool;
import compiler::internal::project;
import compiler::internal::source;
import compiler::internal::stdtarget;
import compiler::internal::types;
import std::array;
import std::fs;
import std::io;
import std::mem;
import std::string;
import std::testing;

fn llvm_marker() -> []u8 {
    return
        \\
        \\
        \\// llvm
        \\
    ;
}

fn split_llvm_case(data: []u8) -> ?i64 {
    let marker = llvm_marker();
    let marker_len = mem::len(marker);
    var index = mem::len(data) - marker_len;
    while index >= 0 {
        if mem::slice(data, index, index + marker_len) |candidate| {
            if mem::equal_bytes(candidate, marker) {
                return index;
            }
        }
        index = index - 1;
    }
    return null;
}

fn append_folded_llvm_line(allocator: Allocator, out: &var string::String, text: []u8) -> !void {
    var index = 0;
    while mem::byte_at(text, index) |byte| {
        if byte == cast<u8>(10) {
            try out.append_byte(allocator, cast<u8>(92));
            try out.append_byte(allocator, cast<u8>(110));
        } else {
            try out.append_byte(allocator, byte);
        }
        index = index + 1;
    }
    return out.append_byte(allocator, cast<u8>(10));
}

fn append_emitted(allocator: Allocator, out: &var string::String, text: []u8) -> !void {
    try out.append_bytes(allocator, "// ");
    var index = 0;
    while mem::byte_at(text, index) |byte| {
        try out.append_byte(allocator, byte);
        if byte == cast<u8>(10) {
            try out.append_bytes(allocator, "// ");
        }
        index = index + 1;
    }
    return out.append_byte(allocator, cast<u8>(10));
}

fn keep_user_functions(allocator: Allocator, module: &var ir::Module) -> !array::Array<ir::Function> {
    var reversed = array::new<ir::Function>(allocator);
    errdefer reversed.deinit(allocator);
    while module.functions.pop() |function| {
        try reversed.append(allocator, function);
    }
    var index = reversed.len();
    while index > 0 {
        index = index - 1;
        let function = reversed.get_or_panic(index);
        let name = module.function_name(function);
        if module.names.starts_with(name, "std::") {
            continue;
        }
        try module.functions.append(allocator, function);
    }
    return move reversed;
}

fn restore_functions(allocator: Allocator, module: &var ir::Module, reversed: &array::Array<ir::Function>) -> !void {
    module.functions.clear(allocator);
    var index = reversed.len();
    while index > 0 {
        index = index - 1;
        try module.functions.append(allocator, reversed.get_or_panic(index));
    }
    return;
}

fn append_llvm_failure(
    allocator: Allocator,
    sources: &source::SourceMap,
    failed: &diagnostic::Diagnostic,
    prefix: []u8,
    out: &var string::String
) -> !void {
    try out.append_bytes(allocator, prefix);
    let text = try failed.error(allocator, sources);
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    return append_folded_llvm_line(allocator, out, bytes);
}

fn emit_llvm_section(
    allocator: Allocator,
    sources: &source::SourceMap,
    module: &var ir::Module,
    out: &var string::String
) -> !void {
    let dropped = try keep_user_functions(allocator, module);
    defer dropped.deinit(allocator);
    var emitted = string::new(allocator);
    defer emitted.deinit(allocator);
    if try llvm::emit(allocator, module, &var emitted) |failed| {
        defer failed.deinit(allocator);
        try append_llvm_failure(allocator, sources, &failed, "// ", out);
    } else {
        let emitted_bytes = emitted.as_bytes();
        try append_emitted(allocator, out, emitted_bytes);
    }
    return restore_functions(allocator, module, &dropped);
}

fn append_check_failure(
    allocator: Allocator,
    sources: &source::SourceMap,
    failed: &diagnostic::Diagnostic,
    out: &var string::String
) -> !void {
    try out.append_bytes(allocator, "// emit:");
    try out.append_byte(allocator, cast<u8>(10));
    try append_llvm_failure(allocator, sources, failed, "// check failed: ", out);
    try out.append_bytes(allocator, "// opt:");
    try out.append_byte(allocator, cast<u8>(10));
    return append_llvm_failure(allocator, sources, failed, "// check failed: ", out);
}

fn render_llvm_case(
    io: Io,
    allocator: Allocator,
    std_cache: &project::StdCache,
    input: []u8
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var tree = ast::new(allocator);
    defer tree.deinit(allocator);
    var loader = try project::new_loader(io, allocator, "lib/kizu");
    defer loader.deinit(allocator);
    let loaded = try loader.load_source_cached(&var tree, "", input, std_cache);
    match loaded {
        Error(failed) => {
            defer failed.deinit(allocator);
            try append_check_failure(allocator, &loader.sources, &failed, &var out);
            return move out;
        },
        Program(program) => {
            defer program.deinit(allocator);
            if try types::check(allocator, &var tree, &program) |failed| {
                defer failed.deinit(allocator);
                try append_check_failure(allocator, &loader.sources, &failed, &var out);
                return move out;
            }
            var checker = try ownership::new_checker(allocator, &tree, &program);
            defer checker.deinit(allocator);
            if try checker.check_program(&var tree, &program) |failed| {
                defer failed.deinit(allocator);
                try append_check_failure(allocator, &loader.sources, &failed, &var out);
                return move out;
            }
            var lowerer = try ir::new_lowerer(allocator, &tree, &program, &checker);
            defer lowerer.deinit(allocator);
            try out.append_bytes(allocator, "// emit:");
            try out.append_byte(allocator, cast<u8>(10));
            if try lowerer.lower(&var tree, &program, &std_cache.error_codes, &loader.sources) |failed| {
                defer failed.deinit(allocator);
                try append_llvm_failure(allocator, &loader.sources, &failed, "// ", &var out);
                try out.append_bytes(allocator, "// opt:");
                try out.append_byte(allocator, cast<u8>(10));
                try append_llvm_failure(allocator, &loader.sources, &failed, "// ", &var out);
                return move out;
            }
            try emit_llvm_section(allocator, &loader.sources, &var lowerer.module, &var out);
            try out.append_bytes(allocator, "// opt:");
            try out.append_byte(allocator, cast<u8>(10));
            if try ir::optimize(allocator, &var lowerer.module, stdtarget::host()) |failed| {
                defer failed.deinit(allocator);
                try append_llvm_failure(allocator, &loader.sources, &failed, "// ", &var out);
                return move out;
            }
            try emit_llvm_section(allocator, &loader.sources, &var lowerer.module, &var out);
            return move out;
        },
    }
}

fn run_llvm_corpus(io: Io, allocator: Allocator) -> !void {
    let cached = try project::load_std_cache(io, allocator, "lib/kizu");
    match cached {
        Error(failed) => {
            defer failed.deinit(allocator);
            try io::write_stderr_line(io, "std cache could not be read");
            testing::expect(false);
        },
        Cache(std_cache) => {
            defer std_cache.deinit(allocator);
            var entries = try fs::read_dir(io, allocator, "compiler/tests/llvm");
            defer entries.deinit(allocator);
            var cases = 0;
            var failures = 0;
            var index = 0;
            while entries.at(index) |entry| {
                index = index + 1;
                if entry.is_dir {
                    continue;
                }
                cases = cases + 1;
                let entry_path = entry.path.as_bytes();
                let data = try fs::read_file(io, allocator, entry_path, mem::Limit::Unlimited);
                defer data.deinit(allocator);
                let bytes = data.as_bytes();
                if split_llvm_case(bytes) |cut| {
                    let input = bytes[0..cut];
                    let want = bytes[cut + mem::len(llvm_marker())..mem::len(bytes)];
                    let got = try render_llvm_case(io, allocator, &std_cache, input);
                    defer got.deinit(allocator);
                    let got_bytes = got.as_bytes();
                    if !mem::equal_bytes(want, got_bytes) {
                        failures = failures + 1;
                        try io::write_stderr_line(io, entry_path);
                        try io::write_stderr_line(io, "--- want");
                        try io::write_stderr(io, want);
                        try io::write_stderr_line(io, "--- got");
                        try io::write_stderr(io, got_bytes);
                    }
                } else {
                    failures = failures + 1;
                    try io::write_stderr(io, "no `// llvm` marker: ");
                    try io::write_stderr_line(io, entry_path);
                }
            }
            testing::expect(cases > 0);
            testing::expect_equal<i64>(0, failures);
        },
    }
    return;
}

test "llvm corpus emits like the shipping compiler" {
    var mem_pool = try pool::new(mem::page_allocator());
    defer mem_pool.deinit(mem::page_allocator());
    let allocator = pool::allocator_of(&var mem_pool);
    return run_llvm_corpus(io::blocking(), allocator);
}
