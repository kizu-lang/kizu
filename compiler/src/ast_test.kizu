import compiler::ast;
import compiler::typ;
import std::array;
import std::map;
import std::mem;
import std::string;
import std::testing;

fn retained_text(
    allocator: Allocator,
    tree: &var ast::Ast,
    bytes: []u8
) -> !ast::Text {
    return tree.add_text_from_bytes(allocator, bytes);
}

fn zero_span() -> ast::Span {
    return ast::Span {
        source: null,
        start: ast::Position { line: 0, column: 0 },
        end: ast::Position { line: 0, column: 0 }
    };
}

fn expect_text(tree: &ast::Ast, value: ast::Text, expected: []u8) -> void {
    expect_retained_text(tree.texts.at(value.node), expected);
    return;
}

fn expect_retained_text(
    retained: &string::String,
    expected: []u8
) -> void {
    let bytes = retained.as_bytes();
    testing::expect_equal<[]u8>(expected, bytes);
    return;
}

fn add_ident_expression(
    allocator: Allocator,
    tree: &var ast::Ast,
    name: []u8
) -> !ast::Expression {
    let retained = try retained_text(allocator, tree, name);
    return tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: retained,
        span: zero_span()
    }));
}

fn add_int_expression(
    allocator: Allocator,
    tree: &var ast::Ast,
    value: []u8
) -> !ast::Expression {
    let retained = try retained_text(allocator, tree, value);
    return tree.add_expression(ast::ExpressionNode::Int(ast::IntExpr {
        value: retained
    }));
}

fn add_empty_block(
    allocator: Allocator,
    tree: &var ast::Ast
) -> ast::Block {
    return tree.add_block(ast::BlockStmt {
        statements: array::new<ast::Statement>(allocator)
    });
}

fn expect_expression_render(
    allocator: Allocator,
    tree: &ast::Ast,
    types: &typ::Table,
    expression: ast::Expression,
    expected: []u8
) -> !void {
    let rendered = try ast::render_expression(
        allocator,
        tree,
        types,
        expression
    );
    defer rendered.deinit();
    expect_retained_text(&rendered, expected);
    return;
}

fn expect_statement_render(
    allocator: Allocator,
    tree: &ast::Ast,
    types: &typ::Table,
    statement: ast::Statement,
    expected: []u8
) -> !void {
    let rendered = try ast::render_statement(
        allocator,
        tree,
        types,
        statement
    );
    defer rendered.deinit();
    expect_retained_text(&rendered, expected);
    return;
}

fn expect_block_render(
    allocator: Allocator,
    tree: &ast::Ast,
    types: &typ::Table,
    block: ast::Block,
    expected: []u8
) -> !void {
    let rendered = try ast::render_block(allocator, tree, types, block);
    defer rendered.deinit();
    expect_retained_text(&rendered, expected);
    return;
}

fn empty_signature(
    allocator: Allocator,
    tree: &var ast::Ast,
    name: []u8
) -> !ast::FunctionSignature {
    let function_name = try retained_text(allocator, tree, name);
    let extern_abi = try retained_text(allocator, tree, "");
    return ast::FunctionSignature {
        receiver: false,
        name: function_name,
        static_params: array::new<ast::StaticParam>(allocator),
        params: array::new<ast::Param>(allocator),
        return_type: null,
        requires_unsafe: false,
        extern_abi: extern_abi,
        public: false,
        std: false
    };
}

fn expect_marker_value(
    tree: &ast::Ast,
    marker: ast::Expression,
    expected: []u8
) -> void {
    if ast::marker_value(tree, marker) |inner| {
        match tree.expressions.at(inner.node) {
            Int(value) => {
                expect_text(tree, value.value, expected);
            },
            _ => testing::fail("marker did not retain its integer child"),
        }
    } else {
        testing::fail("transparent marker was not recognized");
    }
    return;
}

fn expect_block_len(tree: &ast::Ast, block: ast::Block, expected: i64) -> void {
    match tree.statements.at(block.node) {
        Block(value) => testing::expect_equal<i64>(expected, value.statements.len()),
        _ => testing::fail("block handle did not retain a block statement"),
    }
    return;
}

fn expect_variant_path(
    tree: &ast::Ast,
    path: ast::Expression,
    expected_owner: []u8,
    expected_variant: []u8
) -> void {
    match tree.expressions.at(path.node) {
        Field(field) => {
            testing::expect(field.namespace);
            testing::expect(field.span.is_zero());
            expect_text(tree, field.name, expected_variant);
            match tree.expressions.at(field.receiver.node) {
                Ident(ident) => {
                    testing::expect(ident.span.is_zero());
                    expect_text(tree, ident.name, expected_owner);
                },
                _ => testing::fail("variant owner was not an identifier"),
            }
        },
        _ => testing::fail("variant path was not a namespace field"),
    }
    return;
}

fn expect_ident_name(
    tree: &ast::Ast,
    expression: ast::Expression,
    expected: []u8
) -> void {
    match tree.expressions.at(expression.node) {
        Ident(ident) => {
            testing::expect(ident.span.is_zero());
            expect_text(tree, ident.name, expected);
        },
        _ => testing::fail("expression was not an identifier"),
    }
    return;
}

fn expect_construct_worker(
    tree: &ast::Ast,
    statement: ast::Statement,
    expected_binding: []u8,
    expected_type_arg: []u8,
    expected_args: ast::ExpressionList,
    expected_arg: ast::Expression
) -> void {
    match tree.statements.at(statement.node) {
        Let(binding) => {
            testing::expect(!binding.mutable);
            expect_text(tree, binding.name, expected_binding);
            match tree.expressions.at(binding.value.node) {
                Try(tried) => match tree.expressions.at(tried.value.node) {
                    Call(call) => {
                        testing::expect(call.args.node == expected_args.node);
                        testing::expect_equal<i64>(1, call.args.len(tree));
                        testing::expect(
                            call.args.get_or_panic(tree, 0).node == expected_arg.node
                        );
                        match tree.expressions.at(call.callee.node) {
                            TypeApply(applied) => {
                                expect_text(tree, applied.type_arg, expected_type_arg);
                                expect_ident_name(tree, applied.callee, "make");
                            },
                            _ => testing::fail("worker call had no static field argument"),
                        }
                    },
                    _ => testing::fail("worker result was not a call"),
                },
                _ => testing::fail("worker result was not tried"),
            }
        },
        _ => testing::fail("construct statement was not a binding"),
    }
    return;
}

fn expect_construct_cleanup(
    tree: &ast::Ast,
    statement: ast::Statement,
    expected_binding: []u8
) -> void {
    match tree.statements.at(statement.node) {
        ErrDefer(cleanup) => match tree.expressions.at(cleanup.expr.node) {
            Call(call) => {
                testing::expect_equal<i64>(0, call.args.len(tree));
                match tree.expressions.at(call.callee.node) {
                    Field(method) => {
                        testing::expect(!method.namespace);
                        testing::expect(method.span.is_zero());
                        expect_text(tree, method.name, "deinit");
                        expect_ident_name(tree, method.receiver, expected_binding);
                    },
                    _ => testing::fail("cleanup callee was not a method field"),
                }
            },
            _ => testing::fail("errdefer did not retain a cleanup call"),
        },
        _ => testing::fail("owner field had no errdefer"),
    }
    return;
}

fn expect_construct_field(
    tree: &ast::Ast,
    field: &ast::FieldValue,
    expected_name: []u8,
    expected_binding: []u8,
    moved: bool
) -> void {
    expect_text(tree, field.name, expected_name);
    if moved {
        match tree.expressions.at(field.value.node) {
            Move(marker) => {
                testing::expect(marker.span.is_zero());
                expect_ident_name(tree, marker.value, expected_binding);
            },
            _ => testing::fail("owner field handoff was not marked move"),
        }
    } else {
        expect_ident_name(tree, field.value, expected_binding);
    }
    return;
}

fn add_struct_with_field(
    allocator: Allocator,
    tree: &var ast::Ast,
    program: &var ast::Program,
    name: []u8,
    field_name: []u8,
    field_type: typ::Type
) -> !void {
    var fields = array::new<ast::Field>(allocator);
    errdefer fields.deinit();
    try fields.append(ast::Field {
        name: try retained_text(allocator, tree, field_name),
        doc: try retained_text(allocator, tree, ""),
        type_name: field_type,
        borrow: false,
        mut_borrow: false,
        public: false
    });
    let declaration_name = try retained_text(allocator, tree, name);
    let declaration_doc = try retained_text(allocator, tree, "");
    let declaration = tree.add_declaration(ast::DeclarationNode::Struct(
        ast::StructDecl {
        name: declaration_name,
        doc: declaration_doc,
        type_params: array::new<ast::Text>(allocator),
        fields: move fields,
        public: false,
        requires_unsafe: false
    }
    ));
    return program.add_declaration(declaration);
}

fn add_union_with_payload(
    allocator: Allocator,
    tree: &var ast::Ast,
    program: &var ast::Program,
    name: []u8,
    variant_name: []u8,
    payload: typ::Type
) -> !void {
    var variants = array::new<ast::UnionVariant>(allocator);
    errdefer variants.deinit();
    try variants.append(ast::UnionVariant {
        name: try retained_text(allocator, tree, variant_name),
        doc: try retained_text(allocator, tree, ""),
        payload: payload
    });
    let declaration_name = try retained_text(allocator, tree, name);
    let declaration_doc = try retained_text(allocator, tree, "");
    let declaration = tree.add_declaration(ast::DeclarationNode::Union(
        ast::UnionDecl {
        name: declaration_name,
        doc: declaration_doc,
        type_params: array::new<ast::Text>(allocator),
        variants: move variants,
        public: false
    }
    ));
    return program.add_declaration(declaration);
}

fn add_cleanup_function(
    allocator: Allocator,
    tree: &var ast::Ast,
    program: &var ast::Program,
    name: []u8,
    derived: bool
) -> !void {
    var signature = try empty_signature(allocator, tree, name);
    errdefer signature.deinit();
    signature.receiver = true;
    let doc = try retained_text(allocator, tree, "");
    let declaration = tree.add_declaration(ast::DeclarationNode::Function(
        ast::FunctionDecl {
        signature: move signature,
        doc: doc,
        derived: derived,
        body: null
    }
    ));
    return program.add_declaration(declaration);
}

fn expect_owner(
    owners: &map::Map<[]u8, bool>,
    name: []u8,
    expected: bool
) -> void {
    let actual = owners.get(name) orelse false;
    testing::expect(actual == expected);
    return;
}

fn expect_type_name(
    allocator: Allocator,
    types: &typ::Table,
    value: typ::Type,
    expected: []u8
) -> !void {
    let rendered = try typ::render(allocator, types, value);
    defer rendered.deinit();
    expect_retained_text(&rendered, expected);
    return;
}

fn expect_cleanup_field(
    tree: &ast::Ast,
    statement: ast::Statement,
    expected_field: []u8
) -> void {
    match tree.statements.at(statement.node) {
        Expr(value) => {
            testing::expect(value.semicolon);
            match tree.expressions.at(value.expr.node) {
                Call(call) => {
                    testing::expect_equal<i64>(0, call.args.len(tree));
                    match tree.expressions.at(call.callee.node) {
                        Field(method) => {
                            expect_text(tree, method.name, "deinit");
                            match tree.expressions.at(method.receiver.node) {
                                Field(field) => {
                                    expect_text(tree, field.name, expected_field);
                                    expect_ident_name(tree, field.receiver, "self");
                                },
                                _ => testing::fail("cleanup receiver was not a field"),
                            }
                        },
                        _ => testing::fail("cleanup callee was not a method"),
                    }
                },
                _ => testing::fail("cleanup statement was not a call"),
            }
        },
        _ => testing::fail("cleanup was not an expression statement"),
    }
    return;
}

fn expect_cleanup_ident(
    tree: &ast::Ast,
    statement: ast::Statement,
    expected: []u8
) -> void {
    match tree.statements.at(statement.node) {
        Expr(value) => match tree.expressions.at(value.expr.node) {
            Call(call) => match tree.expressions.at(call.callee.node) {
                Field(method) => {
                    expect_text(tree, method.name, "deinit");
                    expect_ident_name(tree, method.receiver, expected);
                },
                _ => testing::fail("cleanup callee was not a method"),
            },
            _ => testing::fail("cleanup statement was not a call"),
        },
        _ => testing::fail("cleanup was not an expression statement"),
    }
    return;
}

test "span zero state follows its source position" {
    let missing = zero_span();
    testing::expect(missing.is_zero());
    let present = ast::Span {
        source: null,
        start: ast::Position { line: 2, column: 4 },
        end: ast::Position { line: 2, column: 7 }
    };
    testing::expect(!present.is_zero());
}

test "function signatures return only type parameter names" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let integer = try types.parse("i64");
    var tree = ast::new(allocator);
    defer tree.deinit();
    var signature = try empty_signature(allocator, &var tree, "visit");
    defer signature.deinit();
    try signature.static_params.append(ast::StaticParam {
        name: try retained_text(allocator, &var tree, "T"),
        type_name: null
    });
    try signature.static_params.append(ast::StaticParam {
        name: try retained_text(allocator, &var tree, "count"),
        type_name: integer
    });
    try signature.static_params.append(ast::StaticParam {
        name: try retained_text(allocator, &var tree, "U"),
        type_name: null
    });
    let names = try signature.type_param_names(allocator);
    defer names.deinit();
    testing::expect_equal<i64>(2, names.len());
    if names.get(0) |name| {
        expect_text(&tree, name, "T");
    } else {
        testing::fail("missing first type parameter name");
    }
    if names.get(1) |name| {
        expect_text(&tree, name, "U");
    } else {
        testing::fail("missing second type parameter name");
    }
    testing::expect_equal<i64>(3, signature.static_params.len());

    var empty = try empty_signature(allocator, &var tree, "plain");
    defer empty.deinit();
    let empty_names = try empty.type_param_names(allocator);
    defer empty_names.deinit();
    testing::expect_equal<i64>(0, empty_names.len());
}

test "match arms recognize only the wildcard tag" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let retained_body = tree.add_block(ast::BlockStmt {
        statements: array::new<ast::Statement>(allocator)
    });
    let body = retained_body.as_statement();
    let empty = try retained_text(allocator, &var tree, "");
    let wildcard = ast::MatchArm {
        tag: try retained_text(allocator, &var tree, "_"),
        binding: empty,
        body: body
    };
    let named = ast::MatchArm {
        tag: try retained_text(allocator, &var tree, "Value"),
        binding: empty,
        body: body
    };
    testing::expect(wildcard.is_wildcard(&tree));
    testing::expect(!named.is_wildcard(&tree));
}

test "buffer literal type text preserves its stored size" {
    let allocator = mem::page_allocator();
    let positive = ast::BufferLiteralExpr {
        size: 12,
        span: zero_span()
    };
    let positive_text = try positive.type_text(allocator);
    defer positive_text.deinit();
    expect_retained_text(&positive_text, "[12]u8");

    let negative = ast::BufferLiteralExpr {
        size: -2,
        span: zero_span()
    };
    let negative_text = try negative.type_text(allocator);
    defer negative_text.deinit();
    expect_retained_text(&negative_text, "[-2]u8");
}

test "field paths retain their root and dotted suffix" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let root_span = ast::Span {
        source: null,
        start: ast::Position { line: 3, column: 4 },
        end: ast::Position { line: 3, column: 9 }
    };
    let root_name = try retained_text(allocator, &var tree, "owner");
    let root = tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: root_name,
        span: root_span
    }));
    let first_name = try retained_text(allocator, &var tree, "a");
    let first = tree.add_expression(ast::ExpressionNode::Field(ast::FieldExpr {
        receiver: root,
        name: first_name,
        namespace: false,
        span: zero_span()
    }));
    let second_name = try retained_text(allocator, &var tree, "b");
    let second = tree.add_expression(ast::ExpressionNode::Field(ast::FieldExpr {
        receiver: first,
        name: second_name,
        namespace: false,
        span: zero_span()
    }));

    if try ast::field_path_root(allocator, &tree, first) |resolved| {
        defer resolved.deinit();
        expect_text(&tree, resolved.root.name, "owner");
        testing::expect_equal<i64>(3, resolved.root.span.start.line);
        testing::expect_equal<i64>(4, resolved.root.span.start.column);
        testing::expect_equal<i64>(3, resolved.root.span.end.line);
        testing::expect_equal<i64>(9, resolved.root.span.end.column);
        expect_retained_text(&resolved.path, "a");
    } else {
        testing::fail("direct field path was not recognized");
    }
    if try ast::field_path_root(allocator, &tree, second) |resolved| {
        defer resolved.deinit();
        expect_text(&tree, resolved.root.name, "owner");
        expect_retained_text(&resolved.path, "a.b");
    } else {
        testing::fail("nested field path was not recognized");
    }
    if try ast::field_path_root(allocator, &tree, root) |resolved| {
        resolved.deinit();
        testing::fail("identifier was accepted as a field path");
    }

    let namespace_name = try retained_text(allocator, &var tree, "Item");
    let namespaced = tree.add_expression(ast::ExpressionNode::Field(ast::FieldExpr {
        receiver: root,
        name: namespace_name,
        namespace: true,
        span: zero_span()
    }));
    if try ast::field_path_root(allocator, &tree, namespaced) |resolved| {
        resolved.deinit();
        testing::fail("namespace field was accepted as a runtime path");
    }
    let nested_name = try retained_text(allocator, &var tree, "value");
    let nested_namespace = tree.add_expression(ast::ExpressionNode::Field(
        ast::FieldExpr {
            receiver: namespaced,
            name: nested_name,
            namespace: false,
            span: zero_span()
        }
    ));
    if try ast::field_path_root(allocator, &tree, nested_namespace) |resolved| {
        resolved.deinit();
        testing::fail("runtime field above a namespace field was accepted");
    }

    let integer_text = try retained_text(allocator, &var tree, "1");
    let integer = tree.add_expression(ast::ExpressionNode::Int(ast::IntExpr {
        value: integer_text
    }));
    let invalid_name = try retained_text(allocator, &var tree, "value");
    let invalid_root = tree.add_expression(ast::ExpressionNode::Field(
        ast::FieldExpr {
            receiver: integer,
            name: invalid_name,
            namespace: false,
            span: zero_span()
        }
    ));
    if try ast::field_path_root(allocator, &tree, invalid_root) |resolved| {
        resolved.deinit();
        testing::fail("non-identifier field root was accepted");
    }
}

test "expression rendering covers values operators calls and access" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let integer_type = try types.parse("i64");
    var tree = ast::new(allocator);
    defer tree.deinit();

    let x = try add_ident_expression(allocator, &var tree, "x");
    let foo = try add_ident_expression(allocator, &var tree, "foo");
    let one = try add_int_expression(allocator, &var tree, "1");
    let forty_one = try add_int_expression(allocator, &var tree, "41");
    try expect_expression_render(allocator, &tree, &types, x, "x");
    try expect_expression_render(allocator, &tree, &types, forty_one, "41");

    let string_text = try retained_text(allocator, &var tree, "café");
    let string_value = tree.add_expression(ast::ExpressionNode::String(
        ast::StringExpr { value: string_text }
    ));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        string_value,
        \\"caf\xC3\xA9"
    );
    let null_value = tree.add_expression(ast::ExpressionNode::Null(
        ast::NullExpr { span: zero_span() }
    ));
    try expect_expression_render(allocator, &tree, &types, null_value, "null");
    let true_value = tree.add_expression(ast::ExpressionNode::Bool(
        ast::BoolExpr { value: true }
    ));
    let false_value = tree.add_expression(ast::ExpressionNode::Bool(
        ast::BoolExpr { value: false }
    ));
    try expect_expression_render(allocator, &tree, &types, true_value, "true");
    try expect_expression_render(allocator, &tree, &types, false_value, "false");

    let type_name = try retained_text(allocator, &var tree, "i64");
    let type_value = tree.add_expression(ast::ExpressionNode::Type(
        ast::TypeExpr { type_name: type_name }
    ));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        type_value,
        "type<i64>"
    );
    let comptime_value = tree.add_expression(ast::ExpressionNode::Comptime(
        ast::ComptimeExpr { expr: x }
    ));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        comptime_value,
        "comptime x"
    );

    let minus = try retained_text(allocator, &var tree, "-");
    let prefix = tree.add_expression(ast::ExpressionNode::Prefix(
        ast::PrefixExpr { operator: minus, right: forty_one }
    ));
    try expect_expression_render(allocator, &tree, &types, prefix, "(-41)");
    let plus = try retained_text(allocator, &var tree, "+");
    let binary = tree.add_expression(ast::ExpressionNode::Binary(
        ast::BinaryExpr {
            left: forty_one,
            operator: plus,
            operator_span: zero_span(),
            right: one
        }
    ));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        binary,
        "(41 + 1)"
    );

    var args = array::new<ast::Expression>(allocator);
    errdefer args.deinit();
    try args.append(x);
    try args.append(forty_one);
    let retained_args = tree.add_expression_list(move args);
    let call = tree.add_expression(ast::ExpressionNode::Call(ast::CallExpr {
        callee: foo,
        args: retained_args
    }));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        call,
        "foo(x, 41)"
    );
    let static_arg = try retained_text(allocator, &var tree, "i64");
    let applied = tree.add_expression(ast::ExpressionNode::TypeApply(
        ast::TypeApplyExpr { callee: foo, type_arg: static_arg }
    ));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        applied,
        "foo<i64>"
    );
    let cast = tree.add_expression(ast::ExpressionNode::Cast(ast::CastExpr {
        target_type: integer_type,
        value: x,
        keyword_span: zero_span()
    }));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        cast,
        "cast<i64>(x)"
    );

    let tried = tree.add_expression(ast::ExpressionNode::Try(
        ast::TryExpr { value: call }
    ));
    let moved = tree.add_expression(ast::ExpressionNode::Move(
        ast::MoveExpr { value: x, span: zero_span() }
    ));
    let safety = try retained_text(allocator, &var tree, "checked by caller");
    let unsafe_value = tree.add_expression(ast::ExpressionNode::Unsafe(
        ast::UnsafeExpr { value: x, safety: safety, span: zero_span() }
    ));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        tried,
        "try foo(x, 41)"
    );
    try expect_expression_render(allocator, &tree, &types, moved, "move x");
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        unsafe_value,
        "unsafe x"
    );

    let indexed = tree.add_expression(ast::ExpressionNode::Index(
        ast::IndexExpr {
            target: x,
            index: one,
            start: null,
            end: null,
            slice: false,
            span: zero_span()
        }
    ));
    let sliced = tree.add_expression(ast::ExpressionNode::Index(
        ast::IndexExpr {
            target: x,
            index: null,
            start: one,
            end: forty_one,
            slice: true,
            span: zero_span()
        }
    ));
    let open_slice = tree.add_expression(ast::ExpressionNode::Index(
        ast::IndexExpr {
            target: x,
            index: null,
            start: null,
            end: null,
            slice: true,
            span: zero_span()
        }
    ));
    try expect_expression_render(allocator, &tree, &types, indexed, "x[1]");
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        sliced,
        "x[1..41]"
    );
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        open_slice,
        "x[..]"
    );

    let field_name = try retained_text(allocator, &var tree, "value");
    let field = tree.add_expression(ast::ExpressionNode::Field(ast::FieldExpr {
        receiver: x,
        name: field_name,
        namespace: false,
        span: zero_span()
    }));
    let owner = try add_ident_expression(allocator, &var tree, "Type");
    let variant_name = try retained_text(allocator, &var tree, "Item");
    let namespace = tree.add_expression(ast::ExpressionNode::Field(
        ast::FieldExpr {
            receiver: owner,
            name: variant_name,
            namespace: true,
            span: zero_span()
        }
    ));
    let deref = tree.add_expression(ast::ExpressionNode::Deref(
        ast::DerefExpr { receiver: x, operator_span: zero_span() }
    ));
    try expect_expression_render(allocator, &tree, &types, field, "x.value");
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        namespace,
        "Type::Item"
    );
    try expect_expression_render(allocator, &tree, &types, deref, "x.*");

    let returned = tree.add_statement(ast::StatementNode::Return(
        ast::ReturnStmt { value: x }
    ));
    let guarded = tree.add_expression(ast::ExpressionNode::OrelseGuard(
        ast::OrelseGuardExpr {
            condition: x,
            exit: returned,
            span: zero_span()
        }
    ));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        guarded,
        "(x orelse return x)"
    );
}

test "expression rendering covers composite and control forms" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let empty = try retained_text(allocator, &var tree, "");
    let value = try add_ident_expression(allocator, &var tree, "value");
    let payload = try add_ident_expression(allocator, &var tree, "payload");
    let capture_name = try retained_text(allocator, &var tree, "captured");
    let meta_owner = try retained_text(allocator, &var tree, "Option");
    let one = try add_int_expression(allocator, &var tree, "1");
    let true_value = tree.add_expression(ast::ExpressionNode::Bool(
        ast::BoolExpr { value: true }
    ));

    var fields = array::new<ast::FieldValue>(allocator);
    errdefer fields.deinit();
    try fields.append(ast::FieldValue {
        name: try retained_text(allocator, &var tree, "x"),
        value: one
    });
    try fields.append(ast::FieldValue {
        name: try retained_text(allocator, &var tree, "item"),
        value: value
    });
    let point_name = try retained_text(allocator, &var tree, "Point");
    let literal = tree.add_expression(ast::ExpressionNode::StructLiteral(
        ast::StructLiteralExpr {
            type_name: point_name,
            fields: move fields,
            span: zero_span()
        }
    ));
    let buffer = tree.add_expression(ast::ExpressionNode::BufferLiteral(
        ast::BufferLiteralExpr { size: 4, span: zero_span() }
    ));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        literal,
        "Point { x: 1, item: value }"
    );
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        buffer,
        "[4]u8{}"
    );

    let consequence = add_empty_block(allocator, &var tree);
    let alternative = add_empty_block(allocator, &var tree);
    let conditional = tree.add_expression(ast::ExpressionNode::If(ast::IfStmt {
        condition: true_value,
        consequence: consequence,
        alternative: alternative,
        capture: capture_name
    }));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        conditional,
        "if true {  } else {  }"
    );

    let bare_body = tree.add_statement(ast::StatementNode::Expr(
        ast::ExprStmt { expr: payload, semicolon: false }
    ));
    let return_body = tree.add_statement(ast::StatementNode::Return(
        ast::ReturnStmt { value: null }
    ));
    var arms = array::new<ast::MatchArm>(allocator);
    errdefer arms.deinit();
    try arms.append(ast::MatchArm {
        tag: try retained_text(allocator, &var tree, "Some"),
        binding: try retained_text(allocator, &var tree, "item"),
        body: bare_body
    });
    try arms.append(ast::MatchArm {
        tag: try retained_text(allocator, &var tree, "_"),
        binding: empty,
        body: return_body
    });
    let matched = tree.add_expression(ast::ExpressionNode::Match(ast::MatchStmt {
        value: value,
        arms: move arms,
        meta_capture: capture_name,
        meta_owner: meta_owner
    }));
    try expect_expression_render(
        allocator,
        &tree,
        &types,
        matched,
        "match value { Some(item) => payload, _ => return; }"
    );
}

test "statement rendering covers control and compile-time forms" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let empty = try retained_text(allocator, &var tree, "");
    let x_name = try retained_text(allocator, &var tree, "x");
    let outer = try retained_text(allocator, &var tree, "outer");
    let item_name = try retained_text(allocator, &var tree, "item");
    let variant_name = try retained_text(allocator, &var tree, "Variant");
    let payload_name = try retained_text(allocator, &var tree, "payload");
    let x = try add_ident_expression(allocator, &var tree, "x");
    let values = try add_ident_expression(allocator, &var tree, "values");
    let zero = try add_int_expression(allocator, &var tree, "0");
    let one = try add_int_expression(allocator, &var tree, "1");
    let three = try add_int_expression(allocator, &var tree, "3");
    let true_value = tree.add_expression(ast::ExpressionNode::Bool(
        ast::BoolExpr { value: true }
    ));
    let foo = try add_ident_expression(allocator, &var tree, "foo");
    let no_args = tree.add_expression_list(
        array::new<ast::Expression>(allocator)
    );
    let call = tree.add_expression(ast::ExpressionNode::Call(ast::CallExpr {
        callee: foo,
        args: no_args
    }));

    let let_statement = tree.add_statement(ast::StatementNode::Let(
        ast::LetStmt { mutable: false, name: x_name, value: one }
    ));
    let var_statement = tree.add_statement(ast::StatementNode::Let(
        ast::LetStmt { mutable: true, name: x_name, value: zero }
    ));
    let assignment = tree.add_statement(ast::StatementNode::Assign(
        ast::AssignStmt { target: x, value: one }
    ));
    let empty_return = tree.add_statement(ast::StatementNode::Return(
        ast::ReturnStmt { value: null }
    ));
    let value_return = tree.add_statement(ast::StatementNode::Return(
        ast::ReturnStmt { value: x }
    ));
    let deferred = tree.add_statement(ast::StatementNode::Defer(
        ast::DeferStmt { expr: call }
    ));
    let error_deferred = tree.add_statement(ast::StatementNode::ErrDefer(
        ast::ErrDeferStmt { expr: call }
    ));
    let expression_statement = tree.add_statement(ast::StatementNode::Expr(
        ast::ExprStmt { expr: x, semicolon: false }
    ));
    try expect_statement_render(
        allocator, &tree, &types, let_statement, "let x = 1;"
    );
    try expect_statement_render(
        allocator, &tree, &types, var_statement, "var x = 0;"
    );
    try expect_statement_render(
        allocator, &tree, &types, assignment, "x = 1;"
    );
    try expect_statement_render(
        allocator, &tree, &types, empty_return, "return;"
    );
    try expect_statement_render(
        allocator, &tree, &types, value_return, "return x;"
    );
    try expect_statement_render(
        allocator, &tree, &types, deferred, "defer foo();"
    );
    try expect_statement_render(
        allocator, &tree, &types, error_deferred, "errdefer foo();"
    );
    try expect_statement_render(
        allocator, &tree, &types, expression_statement, "x;"
    );

    let empty_body = add_empty_block(allocator, &var tree);
    let other_body = add_empty_block(allocator, &var tree);
    let conditional = tree.add_statement(ast::StatementNode::If(ast::IfStmt {
        condition: true_value,
        consequence: empty_body,
        alternative: other_body,
        capture: payload_name
    }));
    let while_statement = tree.add_statement(ast::StatementNode::While(
        ast::WhileStmt {
            label: outer,
            condition: true_value,
            body: empty_body,
            capture: payload_name
        }
    ));
    let for_statement = tree.add_statement(ast::StatementNode::For(
        ast::ForStmt {
            label: outer,
            name: item_name,
            start: zero,
            end: three,
            body: empty_body
        }
    ));
    let plain_break = tree.add_statement(ast::StatementNode::Break(
        ast::BreakStmt { label: empty }
    ));
    let named_break = tree.add_statement(ast::StatementNode::Break(
        ast::BreakStmt { label: outer }
    ));
    let plain_continue = tree.add_statement(ast::StatementNode::Continue(
        ast::ContinueStmt { label: empty }
    ));
    let named_continue = tree.add_statement(ast::StatementNode::Continue(
        ast::ContinueStmt { label: outer }
    ));
    try expect_statement_render(
        allocator,
        &tree,
        &types,
        conditional,
        "if true {  } else {  }"
    );
    try expect_statement_render(
        allocator,
        &tree,
        &types,
        while_statement,
        "outer: while true {  }"
    );
    try expect_statement_render(
        allocator,
        &tree,
        &types,
        for_statement,
        "outer: for 0..3 |item| {  }"
    );
    try expect_statement_render(
        allocator, &tree, &types, plain_break, "break;"
    );
    try expect_statement_render(
        allocator, &tree, &types, named_break, "break :outer;"
    );
    try expect_statement_render(
        allocator, &tree, &types, plain_continue, "continue;"
    );
    try expect_statement_render(
        allocator, &tree, &types, named_continue, "continue :outer;"
    );

    var arms = array::new<ast::MatchArm>(allocator);
    errdefer arms.deinit();
    let terminated_body = tree.add_statement(ast::StatementNode::Expr(
        ast::ExprStmt { expr: x, semicolon: true }
    ));
    try arms.append(ast::MatchArm {
        tag: try retained_text(allocator, &var tree, "Ready"),
        binding: empty,
        body: terminated_body
    });
    let match_statement = tree.add_statement(ast::StatementNode::Match(
        ast::MatchStmt {
            value: x,
            arms: move arms,
            meta_capture: payload_name,
            meta_owner: variant_name
        }
    ));
    try expect_statement_render(
        allocator,
        &tree,
        &types,
        match_statement,
        "match x { Ready => x; }"
    );

    let comptime_if = tree.add_statement(ast::StatementNode::ComptimeIf(
        ast::ComptimeIfStmt {
            condition: true_value,
            consequence: empty_body,
            alternative: other_body
        }
    ));
    let comptime_for = tree.add_statement(ast::StatementNode::ComptimeFor(
        ast::ComptimeForStmt {
            list: values,
            name: item_name,
            body: empty_body
        }
    ));
    let comptime_match = tree.add_statement(ast::StatementNode::ComptimeMatch(
        ast::ComptimeMatchStmt {
            value: x,
            name: variant_name,
            binding: payload_name,
            body: empty_body
        }
    ));
    try expect_statement_render(
        allocator,
        &tree,
        &types,
        comptime_if,
        "comptime if true {  } else {  }"
    );
    try expect_statement_render(
        allocator,
        &tree,
        &types,
        comptime_for,
        "comptime for values |item| {  }"
    );
    try expect_statement_render(
        allocator,
        &tree,
        &types,
        comptime_match,
        "comptime match x |Variant, payload| {  }"
    );

    let empty_block = add_empty_block(allocator, &var tree);
    try expect_block_render(allocator, &tree, &types, empty_block, "{  }");
    var statements = array::new<ast::Statement>(allocator);
    errdefer statements.deinit();
    try statements.append(let_statement);
    try statements.append(value_return);
    let populated_block = tree.add_block(ast::BlockStmt {
        statements: move statements
    });
    try expect_block_render(
        allocator,
        &tree,
        &types,
        populated_block,
        "{ let x = 1; return x; }"
    );
    try expect_statement_render(
        allocator,
        &tree,
        &types,
        populated_block.as_statement(),
        "{ let x = 1; return x; }"
    );
}

test "program retains declaration handles and nested contract methods" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let integer = try types.parse("i64");
    var tree = ast::new(allocator);
    defer tree.deinit();
    var program = ast::new_program(allocator);
    defer program.deinit();
    var body_statements = array::new<ast::Statement>(allocator);
    errdefer body_statements.deinit();
    let body = tree.add_block(ast::BlockStmt {
        statements: move body_statements
    });
    var signature = try empty_signature(allocator, &var tree, "visit");
    errdefer signature.deinit();
    try signature.static_params.append(ast::StaticParam {
        name: try retained_text(allocator, &var tree, "T"),
        type_name: null
    });
    try signature.static_params.append(ast::StaticParam {
        name: try retained_text(allocator, &var tree, "count"),
        type_name: integer
    });
    let function_doc = try retained_text(
        allocator,
        &var tree,
        "Visits one value."
    );
    let function_decl = ast::FunctionDecl {
        signature: move signature,
        doc: function_doc,
        derived: false,
        body: body
    };
    let function = tree.add_declaration(ast::DeclarationNode::Function(
        move function_decl
    ));
    try program.add_declaration(function);
    var methods = array::new<ast::FunctionDecl>(allocator);
    errdefer methods.deinit();
    let method_signature = try empty_signature(allocator, &var tree, "visit");
    errdefer method_signature.deinit();
    let method_doc = try retained_text(allocator, &var tree, "");
    try methods.append(ast::FunctionDecl {
        signature: move method_signature,
        doc: method_doc,
        derived: false,
        body: null
    });
    let contract_node = ast::ContractDecl {
        name: try retained_text(allocator, &var tree, "Visitor"),
        methods: move methods,
        public: true
    };
    let contract_decl = tree.add_declaration(ast::DeclarationNode::Contract(
        move contract_node
    ));
    try program.add_declaration(contract_decl);
    var tags = array::new<ast::Text>(allocator);
    errdefer tags.deinit();
    try tags.append(try retained_text(allocator, &var tree, "Ready"));
    var tag_docs = map::new<[]u8, ast::Text>(allocator);
    errdefer tag_docs.deinit();
    try tag_docs.insert(
        "Ready",
        try retained_text(allocator, &var tree, "The visitor may run.")
    );
    let enum_name = try retained_text(allocator, &var tree, "State");
    let enum_doc = try retained_text(allocator, &var tree, "Visitor state.");
    let enum_node = ast::EnumDecl {
        name: enum_name,
        doc: enum_doc,
        tags: move tags,
        tag_docs: move tag_docs,
        public: true
    };
    let enum_decl = tree.add_declaration(ast::DeclarationNode::Enum(move enum_node));
    try program.add_declaration(enum_decl);
    let error_name = try retained_text(allocator, &var tree, "Failure");
    let error_doc = try retained_text(allocator, &var tree, "");
    let error_node = ast::ErrorSetDecl {
        name: error_name,
        doc: error_doc,
        members: array::new<ast::Text>(allocator),
        member_docs: null,
        public: false
    };
    let error_decl = tree.add_declaration(ast::DeclarationNode::ErrorSet(
        move error_node
    ));
    try program.add_declaration(error_decl);
    testing::expect_equal<i64>(4, program.declarations.len());
    match tree.declarations.at(function.node) {
        Function(value) => {
            expect_text(&tree, value.signature.name, "visit");
            if value.body |retained| {
                expect_block_len(&tree, retained, 0);
            } else {
                testing::fail("function body was not retained");
            }
            if value.signature.static_params.at(0) |param| {
                testing::expect(param.is_type());
            } else {
                testing::fail("missing type parameter");
            }
            if value.signature.static_params.at(1) |param| {
                testing::expect(!param.is_type());
            } else {
                testing::fail("missing value parameter");
            }
        },
        _ => testing::fail("function handle changed node category"),
    }
    match tree.declarations.at(contract_decl.node) {
        Contract(value) => {
            testing::expect(value.public);
            testing::expect_equal<i64>(1, value.methods.len());
        },
        _ => testing::fail("contract handle changed node category"),
    }
    match tree.declarations.at(enum_decl.node) {
        Enum(value) => {
            if value.tag_docs |docs| {
                testing::expect_equal<i64>(1, docs.len());
            } else {
                testing::fail("enum tag docs were not retained");
            }
        },
        _ => testing::fail("enum handle changed node category"),
    }
    match tree.declarations.at(error_decl.node) {
        ErrorSet(value) => {
            if value.member_docs |_| {
                testing::fail("empty error docs did not remain compact");
            }
        },
        _ => testing::fail("error set handle changed node category"),
    }
}

test "deinit owner discovery includes declared and transitive holders" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let outer_type = try types.parse("Outer");
    let middle_type = try types.parse("Middle");
    let optional_inner_type = try types.parse("?Inner");
    let array_type = try types.parse("std::array::Array<u8>");
    let integer_type = try types.parse("i64");
    var tree = ast::new(allocator);
    defer tree.deinit();
    var program = ast::new_program(allocator);
    defer program.deinit();
    try add_union_with_payload(
        allocator,
        &var tree,
        &var program,
        "Slot",
        "Held",
        outer_type
    );
    try add_struct_with_field(
        allocator,
        &var tree,
        &var program,
        "Outer",
        "middle",
        middle_type
    );
    try add_struct_with_field(
        allocator,
        &var tree,
        &var program,
        "Middle",
        "inner",
        optional_inner_type
    );
    try add_struct_with_field(
        allocator,
        &var tree,
        &var program,
        "Inner",
        "bytes",
        array_type
    );
    try add_struct_with_field(
        allocator,
        &var tree,
        &var program,
        "Point",
        "x",
        integer_type
    );
    try add_cleanup_function(
        allocator,
        &var tree,
        &var program,
        "std::array::Array.deinit",
        false
    );
    try add_cleanup_function(
        allocator,
        &var tree,
        &var program,
        "Generated.deinit",
        true
    );
    try add_cleanup_function(
        allocator,
        &var tree,
        &var program,
        "Resource<u8>.deinit",
        false
    );
    let owners = try ast::deinit_owners(allocator, &tree, &types, &program);
    defer owners.deinit();
    expect_owner(&owners, "std::arena::Arena", true);
    expect_owner(&owners, "std::array::Array", true);
    expect_owner(&owners, "Generated", true);
    expect_owner(&owners, "Resource", true);
    expect_owner(&owners, "Inner", true);
    expect_owner(&owners, "Middle", true);
    expect_owner(&owners, "Outer", true);
    expect_owner(&owners, "Slot", true);
    expect_owner(&owners, "Point", false);
    let declared = try ast::declared_deinits(allocator, &tree, &program);
    defer declared.deinit();
    expect_owner(&declared, "std::arena::Arena", true);
    expect_owner(&declared, "std::array::Array", true);
    expect_owner(&declared, "Generated", false);
    expect_owner(&declared, "Resource", true);
    expect_owner(&declared, "Inner", false);
}

test "derived struct deinit consumes plain and optional owner fields" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let string_type = try types.parse("std::string::String");
    let optional_string = try types.parse("?std::string::String");
    let integer = try types.parse("i64");
    var tree = ast::new(allocator);
    defer tree.deinit();
    var fields = array::new<ast::Field>(allocator);
    errdefer fields.deinit();
    let empty = try retained_text(allocator, &var tree, "");
    try fields.append(ast::Field {
        name: try retained_text(allocator, &var tree, "name"),
        doc: empty,
        type_name: string_type,
        borrow: false,
        mut_borrow: false,
        public: false
    });
    try fields.append(ast::Field {
        name: try retained_text(allocator, &var tree, "age"),
        doc: empty,
        type_name: integer,
        borrow: false,
        mut_borrow: false,
        public: false
    });
    try fields.append(ast::Field {
        name: try retained_text(allocator, &var tree, "nick"),
        doc: empty,
        type_name: optional_string,
        borrow: false,
        mut_borrow: false,
        public: false
    });
    var type_params = array::new<ast::Text>(allocator);
    errdefer type_params.deinit();
    try type_params.append(try retained_text(allocator, &var tree, "T"));
    let visitor_name = try retained_text(allocator, &var tree, "Visitor");
    let declaration = tree.add_declaration(ast::DeclarationNode::Struct(
        ast::StructDecl {
        name: visitor_name,
        doc: empty,
        type_params: move type_params,
        fields: move fields,
        public: false,
        requires_unsafe: false
    }
    ));
    var owners = map::new<[]u8, bool>(allocator);
    defer owners.deinit();
    try owners.insert("std::string::String", true);
    if try ast::derive_deinit(
        allocator,
        &var tree,
        &var types,
        &owners,
        declaration
    ) |function| {
        let generated = tree.add_declaration(ast::DeclarationNode::Function(
            move function
        ));
        match tree.declarations.at(generated.node) {
            Function(value) => {
                testing::expect(value.derived);
                testing::expect(value.signature.receiver);
                testing::expect(!value.signature.std);
                expect_text(&tree, value.signature.name, "Visitor.deinit");
                testing::expect_equal<i64>(1, value.signature.static_params.len());
                if value.signature.static_params.at(0) |param| {
                    expect_text(&tree, param.name, "T");
                    testing::expect(param.is_type());
                } else {
                    testing::fail("derived deinit lost its type parameter");
                }
                testing::expect_equal<i64>(1, value.signature.params.len());
                if value.signature.params.at(0) |receiver| {
                    expect_text(&tree, receiver.name, "self");
                    try expect_type_name(
                        allocator,
                        &types,
                        receiver.type_name,
                        "Visitor<T>"
                    );
                } else {
                    testing::fail("derived deinit had no receiver");
                }
                if value.body |body| {
                    match tree.statements.at(body.node) {
                        Block(block) => {
                            testing::expect_equal<i64>(3, block.statements.len());
                            expect_cleanup_field(
                                &tree,
                                block.statements.get_or_panic(0),
                                "name"
                            );
                            let optional = block.statements.get_or_panic(1);
                            match tree.statements.at(optional.node) {
                                If(opened) => {
                                    expect_text(&tree, opened.capture, "held");
                                    match tree.expressions.at(opened.condition.node) {
                                        Field(field) => {
                                            expect_text(&tree, field.name, "nick");
                                            expect_ident_name(
                                                &tree,
                                                field.receiver,
                                                "self"
                                            );
                                        },
                                        _ => testing::fail(
                                            "optional owner was not read as a field"
                                        ),
                                    }
                                    match tree.statements.at(opened.consequence.node) {
                                        Block(consequence) => {
                                            testing::expect_equal<i64>(
                                                1,
                                                consequence.statements.len()
                                            );
                                            expect_cleanup_ident(
                                                &tree,
                                                consequence.statements.get_or_panic(0),
                                                "held"
                                            );
                                        },
                                        _ => testing::fail(
                                            "optional owner had no consequence block"
                                        ),
                                    }
                                },
                                _ => testing::fail("optional owner was not opened first"),
                            }
                            match tree.statements.at(
                                block.statements.get_or_panic(2).node
                            ) {
                                Return(returned) => if returned.value |_| {
                                    testing::fail("derived return carried a value");
                                },
                                _ => testing::fail("derived deinit had no final return"),
                            }
                        },
                        _ => testing::fail("derived body handle was not a block"),
                    }
                } else {
                    testing::fail("derived deinit had no body");
                }
            },
            _ => testing::fail("derived declaration was not a function"),
        }
    } else {
        testing::fail("struct holding owners got no derived deinit");
    }
}

test "derived union deinit matches every variant and consumes owner payload" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let string_type = try types.parse("std::string::String");
    let integer = try types.parse("i64");
    var tree = ast::new(allocator);
    defer tree.deinit();
    let empty = try retained_text(allocator, &var tree, "");
    var variants = array::new<ast::UnionVariant>(allocator);
    errdefer variants.deinit();
    try variants.append(ast::UnionVariant {
        name: try retained_text(allocator, &var tree, "Kept"),
        doc: empty,
        payload: string_type
    });
    try variants.append(ast::UnionVariant {
        name: try retained_text(allocator, &var tree, "Count"),
        doc: empty,
        payload: integer
    });
    try variants.append(ast::UnionVariant {
        name: try retained_text(allocator, &var tree, "Vacant"),
        doc: empty,
        payload: null
    });
    let slot_name = try retained_text(allocator, &var tree, "std::Slot");
    let declaration = tree.add_declaration(ast::DeclarationNode::Union(
        ast::UnionDecl {
        name: slot_name,
        doc: empty,
        type_params: array::new<ast::Text>(allocator),
        variants: move variants,
        public: false
    }
    ));
    var owners = map::new<[]u8, bool>(allocator);
    defer owners.deinit();
    try owners.insert("std::string::String", true);
    if try ast::derive_deinit(
        allocator,
        &var tree,
        &var types,
        &owners,
        declaration
    ) |function| {
        let generated = tree.add_declaration(ast::DeclarationNode::Function(
            move function
        ));
        match tree.declarations.at(generated.node) {
            Function(value) => {
                testing::expect(value.signature.std);
                expect_text(&tree, value.signature.name, "std::Slot.deinit");
                if value.body |body| {
                    match tree.statements.at(body.node) {
                        Block(block) => match tree.statements.at(
                            block.statements.get_or_panic(0).node
                        ) {
                            Match(selected) => {
                                testing::expect_equal<i64>(3, selected.arms.len());
                                expect_ident_name(&tree, selected.value, "self");
                                if selected.arms.at(0) |arm| {
                                    expect_text(&tree, arm.tag, "Kept");
                                    expect_text(&tree, arm.binding, "held");
                                    expect_cleanup_ident(&tree, arm.body, "held");
                                } else {
                                    testing::fail("owner variant had no match arm");
                                }
                                if selected.arms.at(1) |arm| {
                                    expect_text(&tree, arm.binding, "");
                                    expect_block_len(&tree, ast::Block {
                                        node: arm.body.node
                                    }, 0);
                                } else {
                                    testing::fail("copy variant had no match arm");
                                }
                                if selected.arms.at(2) |arm| {
                                    expect_text(&tree, arm.binding, "");
                                    expect_block_len(&tree, ast::Block {
                                        node: arm.body.node
                                    }, 0);
                                } else {
                                    testing::fail("empty variant had no match arm");
                                }
                            },
                            _ => testing::fail(
                                "union deinit body did not start with match"
                            ),
                        },
                        _ => testing::fail("derived union body was not a block"),
                    }
                } else {
                    testing::fail("derived union deinit had no body");
                }
            },
            _ => testing::fail("derived union declaration was not a function"),
        }
    } else {
        testing::fail("union carrying an owner got no derived deinit");
    }
}

test "adding derived deinits skips copy and manually cleaned types" {
    let allocator = mem::page_allocator();
    var types = typ::new(allocator);
    defer types.deinit();
    let resource = try types.parse("Resource");
    let integer = try types.parse("i64");
    var tree = ast::new(allocator);
    defer tree.deinit();
    var program = ast::new_program(allocator);
    defer program.deinit();
    try add_cleanup_function(
        allocator,
        &var tree,
        &var program,
        "Resource.deinit",
        false
    );
    try add_struct_with_field(
        allocator,
        &var tree,
        &var program,
        "Holder",
        "resource",
        resource
    );
    try add_struct_with_field(
        allocator,
        &var tree,
        &var program,
        "Manual",
        "resource",
        resource
    );
    try add_cleanup_function(
        allocator,
        &var tree,
        &var program,
        "Manual.deinit",
        false
    );
    try add_struct_with_field(
        allocator,
        &var tree,
        &var program,
        "Point",
        "x",
        integer
    );
    try ast::add_derived_deinits(
        allocator,
        &var tree,
        &var types,
        &var program
    );
    testing::expect_equal<i64>(6, program.declarations.len());
    let generated = program.declarations.get_or_panic(5);
    match tree.declarations.at(generated.node) {
        Function(value) => {
            testing::expect(value.derived);
            expect_text(&tree, value.signature.name, "Holder.deinit");
        },
        _ => testing::fail("appended derived declaration was not a function"),
    }
    try ast::add_derived_deinits(
        allocator,
        &var tree,
        &var types,
        &var program
    );
    testing::expect_equal<i64>(6, program.declarations.len());
}

test "variant helpers preserve shared bodies and ordinary expression shape" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let subject_name = try retained_text(allocator, &var tree, "slot");
    let subject = tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: subject_name,
        span: zero_span()
    }));
    var body_statements = array::new<ast::Statement>(allocator);
    errdefer body_statements.deinit();
    let body = tree.add_block(ast::BlockStmt {
        statements: move body_statements
    });
    let capture_name = try retained_text(allocator, &var tree, "variant");
    let payload_name = try retained_text(allocator, &var tree, "payload");
    let owner_name = try retained_text(allocator, &var tree, "Slot");
    let empty_name = try retained_text(allocator, &var tree, "");
    let vacant_name = try retained_text(allocator, &var tree, "Vacant");
    let held_name = try retained_text(allocator, &var tree, "Held");
    let comptime_node = ast::ComptimeMatchStmt {
        value: subject,
        name: capture_name,
        binding: payload_name,
        body: body
    };
    let comptime_stmt = tree.add_statement(ast::StatementNode::ComptimeMatch(
        comptime_node
    ));
    var variants = array::new<ast::MetaVariant>(allocator);
    defer variants.deinit();
    try variants.append(ast::MetaVariant {
        name: vacant_name,
        has_payload: false
    });
    try variants.append(ast::MetaVariant {
        name: held_name,
        has_payload: true
    });
    match tree.statements.at(comptime_stmt.node) {
        ComptimeMatch(stmt) => {
            let expanded = try ast::comptime_match_expansion(
                allocator,
                stmt,
                owner_name,
                empty_name,
                &variants
            );
            defer expanded.deinit();
            testing::expect_equal<i64>(2, expanded.arms.len());
            expect_text(&tree, expanded.meta_capture, "variant");
            expect_text(&tree, expanded.meta_owner, "Slot");
            if expanded.arms.at(0) |arm| {
                expect_text(&tree, arm.tag, "Vacant");
                expect_text(&tree, arm.binding, "");
                testing::expect(arm.body.node == body.node);
            } else {
                testing::fail("missing first expansion arm");
            }
            if expanded.arms.at(1) |arm| {
                expect_text(&tree, arm.tag, "Held");
                expect_text(&tree, arm.binding, "payload");
                testing::expect(arm.body.node == body.node);
            } else {
                testing::fail("missing second expansion arm");
            }
            expect_block_len(&tree, body, 0);
        },
        _ => testing::fail("comptime match was not retained in the statement arena"),
    }
    let no_args = tree.add_expression_list(array::new<ast::Expression>(allocator));
    let tag = try ast::variant_expansion(
        allocator,
        &var tree,
        "Slot",
        "Vacant",
        no_args
    );
    expect_variant_path(&tree, tag, "Slot", "Vacant");
    var source_args = array::new<ast::Expression>(allocator);
    errdefer source_args.deinit();
    try source_args.append(subject);
    let source_args_list = tree.add_expression_list(move source_args);
    let source_call = tree.add_expression(ast::ExpressionNode::Call(ast::CallExpr {
        callee: subject,
        args: source_args_list
    }));
    match tree.expressions.at(source_call.node) {
        Call(source) => {
            let shared_args = source.args;
            let call = try ast::variant_expansion(
                allocator,
                &var tree,
                "Slot",
                "Held",
                shared_args
            );
            match tree.expressions.at(call.node) {
                Call(value) => {
                    testing::expect(value.args.node == source_args_list.node);
                    testing::expect_equal<i64>(1, value.args.len(&tree));
                    expect_variant_path(&tree, value.callee, "Slot", "Held");
                    match tree.expressions.at(value.args.get_or_panic(&tree, 0).node) {
                        Ident(ident) => {
                            expect_text(&tree, ident.name, "slot");
                        },
                        _ => testing::fail("variant payload argument changed shape"),
                    }
                },
                _ => testing::fail("payload expansion was not a call"),
            }
        },
        _ => testing::fail("source arguments were not retained by a call"),
    }
}

test "construct expansion builds fields in order and marks owner handoff" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let subject_name = try retained_text(allocator, &var tree, "input");
    let subject = tree.add_expression(ast::ExpressionNode::Ident(ast::IdentExpr {
        name: subject_name,
        span: zero_span()
    }));
    var source_args = array::new<ast::Expression>(allocator);
    errdefer source_args.deinit();
    try source_args.append(subject);
    let source_args_list = tree.add_expression_list(move source_args);
    let source_call = tree.add_expression(ast::ExpressionNode::Call(ast::CallExpr {
        callee: subject,
        args: source_args_list
    }));
    var fields = array::new<ast::ConstructField>(allocator);
    defer fields.deinit();
    try fields.append(ast::ConstructField {
        name: "name",
        type_name: "std::string::String"
    });
    try fields.append(ast::ConstructField {
        name: "count",
        type_name: "i64"
    });
    var owners = map::new<[]u8, bool>(allocator);
    defer owners.deinit();
    try owners.insert("std::string::String", true);
    try owners.insert("std::array::Array", true);
    testing::expect(ast::owner_type(
        &owners,
        "std::array::Array<std::string::String>"
    ));
    testing::expect(!ast::owner_type(&owners, "i64"));
    match tree.expressions.at(source_call.node) {
        Call(source) => {
            let shared_args = source.args;
            let expanded = try ast::construct_expansion(
                allocator,
                &var tree,
                "User",
                "make",
                &fields,
                shared_args,
                &owners
            );
            defer expanded.deinit();
            testing::expect_equal<i64>(3, expanded.statements.len());
            expect_construct_worker(
                &tree,
                expanded.statements.get_or_panic(0),
                "construct$name",
                "User, name",
                source_args_list,
                subject
            );
            expect_construct_cleanup(
                &tree,
                expanded.statements.get_or_panic(1),
                "construct$name"
            );
            expect_construct_worker(
                &tree,
                expanded.statements.get_or_panic(2),
                "construct$count",
                "User, count",
                source_args_list,
                subject
            );
            match tree.expressions.at(expanded.literal.node) {
                StructLiteral(literal) => {
                    testing::expect(literal.span.is_zero());
                    expect_text(&tree, literal.type_name, "User");
                    testing::expect_equal<i64>(2, literal.fields.len());
                    if literal.fields.at(0) |field| {
                        expect_construct_field(
                            &tree,
                            field,
                            "name",
                            "construct$name",
                            true
                        );
                    } else {
                        testing::fail("missing owner field");
                    }
                    if literal.fields.at(1) |field| {
                        expect_construct_field(
                            &tree,
                            field,
                            "count",
                            "construct$count",
                            false
                        );
                    } else {
                        testing::fail("missing copy field");
                    }
                },
                _ => testing::fail("construct result was not a struct literal"),
            }
            match tree.expressions.at(source_call.node) {
                Call(retained) => {
                    testing::expect(retained.args.node == source_args_list.node);
                    testing::expect_equal<i64>(1, retained.args.len(&tree));
                },
                _ => testing::fail("source call changed shape"),
            }
        },
        _ => testing::fail("source arguments were not retained by a call"),
    }
}

test "typed handles retain a shared expression graph" {
    let allocator = mem::page_allocator();
    var tree = ast::new(allocator);
    defer tree.deinit();
    let literal_text = try retained_text(allocator, &var tree, "41");
    let literal = tree.add_expression(ast::ExpressionNode::Int(ast::IntExpr {
        value: literal_text
    }));
    let marker = tree.add_expression(ast::ExpressionNode::Move(ast::MoveExpr {
        value: literal,
        span: zero_span()
    }));
    let comptime_marker = tree.add_expression(ast::ExpressionNode::Comptime(
        ast::ComptimeExpr { expr: literal }
    ));
    let safety = try retained_text(
        allocator,
        &var tree,
        "integer literal has no unsafe effect"
    );
    let unsafe_marker = tree.add_expression(ast::ExpressionNode::Unsafe(ast::UnsafeExpr {
        value: literal,
        safety: safety,
        span: zero_span()
    }));
    let statement = tree.add_statement(ast::StatementNode::Expr(ast::ExprStmt {
        expr: marker,
        semicolon: true
    }));
    var statements = array::new<ast::Statement>(allocator);
    errdefer statements.deinit();
    try statements.append(statement);
    let block = tree.add_block(ast::BlockStmt {
        statements: move statements
    });
    let first_block = block.as_statement();
    let second_block = block.as_statement();
    testing::expect(first_block.node == block.node);
    testing::expect(second_block.node == block.node);
    expect_marker_value(&tree, marker, "41");
    expect_marker_value(&tree, comptime_marker, "41");
    expect_marker_value(&tree, unsafe_marker, "41");
    if ast::marker_value(&tree, literal) |_| {
        testing::fail("plain expression was treated as a marker");
    }
    match tree.statements.at(statement.node) {
        Expr(value) => testing::expect(value.semicolon),
        _ => testing::fail("statement handle changed node category"),
    }
    match tree.statements.at(first_block.node) {
        Block(value) => testing::expect_equal<i64>(1, value.statements.len()),
        _ => testing::fail("first block handle changed node category"),
    }
    match tree.statements.at(second_block.node) {
        Block(value) => testing::expect_equal<i64>(1, value.statements.len()),
        _ => testing::fail("shared block handle changed node category"),
    }
}
