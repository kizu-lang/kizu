import compiler::internal::ast;
import compiler::internal::project;
import compiler::internal::source;
import compiler::internal::types;
import std::array;
import std::map;
import std::mem;

fn analyze_with_previous(
    io: Io, allocator: Allocator, session: &Session, file: []u8, uri: []u8, key: []u8
) -> !Snapshot {
    if session.snapshots.at(key) |previous| {
        if previous.reusable {
            return analyze(io, allocator, session, file, uri, previous);
        }
    }
    if session.valid_snapshots.at(key) |previous| {
        return analyze(io, allocator, session, file, uri, previous);
    }
    let empty = Snapshot {
        sources: source::new(allocator),
        index: types::new_index(allocator),
        problems: array::new<Problem>(allocator),
        files: map::new<[]u8, project::EditorFile>(allocator),
        reusable: false
    };
    defer empty.deinit(allocator);
    return analyze(io, allocator, session, file, uri, &empty);
}

fn remember_valid_snapshot(
    allocator: Allocator, cache: &var map::Map<[]u8, Snapshot>, key: []u8, snapshot: Snapshot
) -> !void {
    if cache.remove(allocator, key) |old| {
        old.deinit(allocator);
    }
    return cache.insert(allocator, key, move snapshot);
}

fn unchanged_editor_sources(
    allocator: Allocator, loader: &project::Loader, files: &map::Map<[]u8, project::EditorFile>,
    tree: &ast::Ast, program: &ast::Program, previous: &Snapshot, unchanged: &var map::Map<i64, bool>
) -> !void {
    if !previous.reusable or previous.sources.len() != loader.sources.len() or previous.files.len() != files.len() {
        return;
    }
    var changed = map::new<[]u8, bool>(allocator);
    defer changed.deinit(allocator);
    let comparable = try changed_editor_modules(allocator, &loader.sources, files, previous, &var changed);
    if !comparable or has_changed_external_methods(tree, program, &loader.sources, files, previous, &changed) {
        return;
    }
    try loader.expand_editor_changes(&var changed);
    for 0..loader.sources.len() |at| {
        let id = source::SourceId { index: at };
        if loader.sources.at(id) |entry| {
            let file = entry.path.as_bytes();
            if files.at(file) |info| {
                let module_name = info.module_name.as_bytes();
                if !changed.contains(module_name) {
                    try unchanged.insert(allocator, at, true);
                }
            }
        }
    }
    return;
}

fn changed_editor_modules(
    allocator: Allocator, sources: &source::SourceMap, files: &map::Map<[]u8, project::EditorFile>,
    previous: &Snapshot, dirty: &var map::Map<[]u8, bool>
) -> !bool {
    for 0..sources.len() |at| {
        let id = source::SourceId { index: at };
        if sources.at(id) |after| {
            if previous.sources.at(id) |before| {
                let file = after.path.as_bytes();
                let previous_file = before.path.as_bytes();
                if !mem::equal_bytes(file, previous_file) {
                    return false;
                }
                if files.at(file) |info| {
                    if previous.files.at(file) |previous_info| {
                        if !project::same_editor_module(info, previous_info) {
                            return false;
                        }
                        let before_text = before.text.as_bytes();
                        let after_text = after.text.as_bytes();
                        if !mem::equal_bytes(before_text, after_text) {
                            let module_name = info.module_name.as_bytes();
                            try dirty.insert(allocator, module_name, true);
                        }
                    } else {
                        return false;
                    }
                } else {
                    return false;
                }
            }
        }
    }
    return true;
}

fn has_changed_external_methods(
    tree: &ast::Ast, program: &ast::Program, sources: &source::SourceMap, files: &map::Map<[]u8, project::EditorFile>,
    previous: &Snapshot, changed: &map::Map<[]u8, bool>
) -> bool {
    if changed.len() == 0 {
        return false;
    }
    var at = 0;
    while program.declarations.get(at) |decl| {
        at = at + 1;
        match tree.declarations.at(decl.node) {
            Function(value) => {
                if value.signature.receiver {
                    let name = text_bytes(tree, value.signature.name);
                    if external_method_changed(name, tree.text_span(value.signature.name), sources, files, changed) {
                        return true;
                    }
                }
            },
            _ => {},
        }
    }
    at = 0;
    while previous.index.symbols.at(at) |symbol| {
        at = at + 1;
        if symbol.kind == types::SymbolKind::Method {
            let name = symbol.qualified.as_bytes();
            if external_method_changed(name, symbol.selection, &previous.sources, &previous.files, changed) {
                return true;
            }
        }
    }
    return false;
}

fn external_method_changed(
    name: []u8, span: ast::Span, sources: &source::SourceMap, files: &map::Map<[]u8, project::EditorFile>,
    changed: &map::Map<[]u8, bool>
) -> bool {
    let id = span.source orelse return false;
    if sources.at(id) |entry| {
        let path_bytes = entry.path.as_bytes();
        if files.at(path_bytes) |info| {
            let module_name = info.module_name.as_bytes();
            if changed.contains(module_name) {
                let owner = method_owner(name);
                let owner_module = module_prefix(owner);
                return !mem::equal_bytes(owner_module, module_name);
            }
        }
    }
    return false;
}
