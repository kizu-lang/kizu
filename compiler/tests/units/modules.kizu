// module app::shapes
// A struct with an owner field gets a derived cleanup in its own module's
// unit; a private function is shared under a hidden symbol all the same; a
// generic is lowered into each unit that uses it.
import std::array;

pub struct Rect {
    pub w: i64,
    pub h: i64,
}

pub struct Bag {
    pub items: array::Array<i64>,
}

pub error ShapeError {
    Empty,
}

fn scale(value: i64) -> i64 {
    return value * 2;
}

pub fn pick<T>(first: T, second: T, take_first: bool) -> T {
    if take_first {
        return first;
    }
    return second;
}

pub fn area(rect: Rect) -> i64 {
    return pick<i64>(scale(rect.w * rect.h), 0, true);
}

pub fn checked(rect: Rect) -> ShapeError!i64 {
    if rect.w == 0 {
        return ShapeError::Empty;
    }
    return area(rect);
}

// module app::text
import app::shapes;

pub fn label() -> i64 {
    let small = shapes::Rect { w: 1, h: 2 };
    return shapes::pick<i64>(shapes::area(small), 7, false) + 100;
}

// module app
import app::shapes;
import app::text;

fn main() -> !void {
    print(try shapes::checked(shapes::Rect { w: 3, h: 4 }));
    print(text::label());
    return;
}


