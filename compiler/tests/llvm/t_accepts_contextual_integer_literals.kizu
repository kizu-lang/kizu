fn returns_error() -> !u8 { return 8 ;}
fn main() -> !void {
    var assigned = take_u8(1);
    assigned = 2;
    let _ = Byte { value: 65 };
    let _ = ByteValue::Item(66);
    let counter = Counter {};
    // SAFETY: test source
