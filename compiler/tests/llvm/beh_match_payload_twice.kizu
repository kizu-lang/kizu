import std::testing;

union Slot {
    Empty,
    A(i64),
    B(i64),
}

fn pick(s: Slot) -> i64 {
    match s {
        A(x) => { return x; },
        B(y) => { return y * 10; },
        Empty => {},
    }
    return -1;
}

// A payload binding is scoped to its arm: two matches over payload unions in
// one function stay independent, even when some arms do not bind the payload.
test "two payload matches in one function stay independent" {
    var w = -1;
    let p = Slot::A(1);
    match p {
        A(x) => { w = x; },
        B(x) => { w = x; },
        Empty => { w = 0; },
    }
    let q = Slot::B(2);
    match q {
        A(x) => { w = w + x; },
        B(x) => { w = w + x; },
        Empty => { w = 0; },
    }
    testing::expect_equal<i64>(3, w);
}

test "wildcard arms between payload matches stay independent" {
    var w = 0;
    match Slot::A(1) {
        A(x) => { w = x; },
        _ => { w = -1; },
    }
    match Slot::B(2) {
        B(z) => { w = w + z; },
        _ => {},
    }
    testing::expect_equal<i64>(3, w);
}

test "return arms and differing binding names stay independent" {
    testing::expect_equal<i64>(3, pick(Slot::A(3)));
    testing::expect_equal<i64>(30, pick(Slot::B(3)));
    testing::expect_equal<i64>(-1, pick(Slot::Empty));
}

