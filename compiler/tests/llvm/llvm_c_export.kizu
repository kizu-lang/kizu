export "c" fn lib_negate(value: i8) -> i8 {
    return 0 - value;
}

export "c" fn lib_is_small(value: u16) -> bool {
    return value < 10;
}

export "c" fn lib_scale(value: f64, by: i32) -> f64 {
    return value * cast<f64>(by);
}

fn main() -> void {
    print(lib_negate(3));
}

