fn sink(v: i64) -> !void {
    print(v);
    return;
}

fn dispatch(kind: i64) -> !void {
    if kind == 1 {
        return try sink(1);
    }
    return try sink(2);
}

fn main() -> !void {
    try dispatch(1);
    return;
}

