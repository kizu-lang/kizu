import std::array;
import std::mem;
import std::testing;

fn make_values(allocator: Allocator) -> !array::Array<i64> {
    let values = array::new<i64>(allocator);
    errdefer values.deinit(allocator);

    try values.append(allocator, 1);
    try values.append(allocator, 2);
    return move values;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let values = try make_values(allocator);
    defer values.deinit(allocator);

    testing::expect_equal<i64>(2, values.len());
    testing::expect_equal<i64>(1, values.get_or_panic(0));
    testing::expect_equal<i64>(2, values.get_or_panic(1));
    print("ok");
    return;
}

