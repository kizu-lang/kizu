import std::arena;
import std::mem;

struct User {
    age: i64,
    visits: i64,
}

// `at_mut` returns a borrow of the element behind the handle, and a capture
// is its one consumer: the arena stays mutably borrowed for the capture's
// scope, so at, add, and deinit wait until the write is done.
fn main() {
    let allocator = mem::page_allocator();
    var users = arena::new<User>(allocator);
    let alice = users.add(User { age: 30, visits: 0 });

    if users.at_mut(alice) |u| {
        u.visits = u.visits + 1;
    }

    print(users.at(alice).visits);
    print(users.at(alice).age);
    users.deinit();
}

