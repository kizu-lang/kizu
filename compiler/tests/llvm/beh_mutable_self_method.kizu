import std::array;
import std::mem;
import std::testing;

pub struct Counter {
    pub count: i64,
}

fn (self: &var Counter) bump() -> void {
    self.count = self.count + 1;
    return;
}

fn (self: &var Counter) bump_twice() -> void {
    self.bump();
    self.bump();
    return;
}

// A `&var self` method mutates the caller's binding in place, including when
// one mutating method calls another through its own borrowed receiver.
test "mutable self method writes through the receiver" {
    var hits = Counter { count: 0 };
    hits.bump_twice();
    hits.bump();
    testing::expect_equal<i64>(3, hits.count);
}

struct Selector {
    pub cursor: i64,
    pub selected: i64,
}

fn (self: &Selector) peek() -> i64 {
    return self.cursor * 10;
}

fn (self: &var Selector) select(index: i64) -> void {
    self.selected = index;
    self.cursor = self.cursor + 1;
}

fn (self: &var Selector) advance() -> void {
    self.select(self.cursor);
}

// A `&var self` call may read its own receiver in argument position: the
// exclusive borrow is two-phase and activates after the arguments settle, so
// a state machine can feed its own state to its own transition.
test "mutable self call reads its receiver in argument position" {
    var sel = Selector { cursor: 3, selected: 0 };
    sel.advance();
    testing::expect_equal<i64>(3, sel.selected);
    testing::expect_equal<i64>(4, sel.cursor);
    sel.select(sel.peek());
    testing::expect_equal<i64>(40, sel.selected);
    testing::expect_equal<i64>(5, sel.cursor);
}

struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn iter(bytes: []u8) -> BytesIter {
    return BytesIter { bytes: bytes, index: 0 };
}

fn (self: BytesIter) has_next() -> bool {
    return self.index < mem::len(self.bytes);
}

fn (self: &var BytesIter) next() -> u8 {
    let byte = self.bytes[self.index];
    self.index = self.index + 1;
    return byte;
}

// A cursor struct advancing itself is the shape an iterator takes; over
// static bytes it needs no tie.
test "mutable self methods drive a byte cursor" {
    var it = iter("kizu");
    var total = 0;
    while it.has_next() {
        total = total + cast<i64>(it.next());
    }
    testing::expect_equal<i64>(451, total);
}

pub struct Tally {
    pub hits: Counter,
    pub faults: Counter,
}

fn (self: &var Tally) record_hit() -> void {
    self.hits.bump();
}

// A `&var self` method reaches one direct field of a mutable owner: the
// exclusive borrow derives from the owner's storage, from the owner's own
// `&var self` methods and from call sites alike, and each field's borrow
// stays its own.
test "mutable self method runs on a direct field receiver" {
    var tally = Tally { hits: Counter { count: 0 }, faults: Counter { count: 0 } };
    tally.record_hit();
    tally.hits.bump();
    tally.faults.bump();
    testing::expect_equal<i64>(2, tally.hits.count);
    testing::expect_equal<i64>(1, tally.faults.count);
}

fn clear(counter: &var Counter) -> void {
    counter.count = 0;
}

// A `&var` argument projects the same one-level field storage a method
// receiver does -- bare or with explicit `&var`, the callee writes into the
// owner's field.
test "a &var argument reaches one direct field" {
    var tally = Tally { hits: Counter { count: 3 }, faults: Counter { count: 5 } };
    clear(tally.hits);
    clear(&var tally.faults);
    testing::expect_equal<i64>(0, tally.hits.count);
    testing::expect_equal<i64>(0, tally.faults.count);
}

pub struct Journal {
    pub entries: array::Array<i64>,
}

fn (self: &var Journal) push(allocator: Allocator, value: i64) -> !void {
    try self.entries.append(allocator, value);
    return;
}

fn (self: Journal) last() -> i64 {
    return self.entries.get_or_panic(self.entries.len() - 1);
}

pub struct Recorder {
    pub journal: Journal,
}

fn (self: &var Recorder) note(allocator: Allocator, value: i64) -> !void {
    try self.journal.push(allocator, value);
    return;
}

// A non-copy field -- one that owns an Array -- cannot be copied out, moved
// out, or rebuilt, so reaching its mutating methods through the owner is the
// only composition there is.
test "a mutating method reaches a non-copy field" {
    let allocator = mem::page_allocator();
    var recorder = Recorder { journal: Journal { entries: array::new<i64>(allocator) } };
    defer recorder.deinit(allocator);
    try recorder.note(allocator, 7);
    try recorder.note(allocator, 9);
    testing::expect_equal<i64>(9, recorder.journal.last());
}

pub struct Studio {
    pub recorder: Recorder,
}

fn sum_entries(entries: &array::Array<i64>) -> i64 {
    var total = 0;
    var index = 0;
    while index < entries.len() {
        total = total + entries.get_or_panic(index);
        index = index + 1;
    }
    return total;
}

// A method receiver reaches through a nested field path -- two hops to a
// `&var` method, three hops into the field's own storage API -- and a borrow
// argument lends the same nested path. Every mutation lands in the root
// owner's storage.
test "nested field paths reach methods and borrows" {
    let allocator = mem::page_allocator();
    var studio = Studio {
        recorder: Recorder { journal: Journal { entries: array::new<i64>(allocator) } },
    };
    defer studio.deinit(allocator);
    try studio.recorder.journal.push(allocator, 4);
    try studio.recorder.journal.entries.append(allocator, 6);
    testing::expect_equal<i64>(6, studio.recorder.journal.last());
    testing::expect_equal<i64>(10, sum_entries(studio.recorder.journal.entries));
}

