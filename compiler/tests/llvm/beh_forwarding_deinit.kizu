import std::mem;
import std::string;
import std::testing;

// `Pair` declares no deinit and takes the derived one; `Slot` writes its own,
// because a union payload is consumed per variant. The completeness check
// (ADR-0091) rejects a written body that misses an owner field or payload.

struct Pair {
    pub first: string::String,
    pub second: string::String,
    pub count: i64,
}

union Slot {
    Kept(string::String),
    Vacant,
}

fn (self: Slot) deinit(allocator: Allocator) -> void {
    match self {
        Kept(name) => name.deinit(allocator),
        Vacant => return,
    }
}

fn make_pair(allocator: Allocator) -> !Pair {
    var first = string::new(allocator);
    errdefer first.deinit(allocator);
    try first.append_bytes(allocator, "left");
    var second = string::new(allocator);
    errdefer second.deinit(allocator);
    try second.append_bytes(allocator, "right");
    return Pair { first: move first, second: move second, count: 2 };
}

test "forwarding deinit consumes struct owners" {
    let allocator = mem::page_allocator();
    var pair = try make_pair(allocator);
    defer pair.deinit(allocator);
    testing::expect_equal<i64>(2, pair.count);
}

test "forwarding deinit dispatches union payloads" {
    let allocator = mem::page_allocator();
    var kept = string::new(allocator);
    errdefer kept.deinit(allocator);
    try kept.append_bytes(allocator, "held");
    let slot = Slot::Kept(move kept);
    slot.deinit(allocator);

    let vacant = Slot::Vacant;
    vacant.deinit(allocator);
}

