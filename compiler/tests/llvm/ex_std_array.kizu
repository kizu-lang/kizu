import std::array;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try values.append(allocator, 10);
    try values.append(allocator, 32);
    let copied = try values.clone(allocator);
    defer copied.deinit(allocator);
    try values.set(0, 99);
    print(values.len());
    // The growth strategy is implementation-defined; only this holds.
    print(values.capacity() >= values.len());
    print(copied.get(0) orelse -1);
    print(values.get(1) orelse -1);
    return;
}

