import std::array;
import std::mem;

enum TokenKind {
    Ident,
    Number,
    Eof,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let tokens = array::new<TokenKind>(allocator);
    defer tokens.deinit(allocator);

    try tokens.append(allocator, TokenKind::Ident);
    try tokens.append(allocator, TokenKind::Number);

    print(tokens.len());
    print(tokens.get(0) orelse TokenKind::Eof);
    print(tokens.get(1) orelse TokenKind::Eof);

    return;
}

