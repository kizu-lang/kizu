enum Kind {
    Count,
    Skip,
}

fn kind_of(index: i64) -> Kind {
    if index - (index / 2) * 2 == 0 {
        return Kind::Count;
    }
    return Kind::Skip;
}

// A statement match arm takes a block (ADR-0107): assignments and multiple
// statements run in place, and `{}` is the explicit no-op arm.
fn count_even(limit: i64) -> i64 {
    var count = 0;
    var i = 0;
    while i < limit {
        match kind_of(i) {
            Count => {
                count = count + 1;
                print(i);
            },
            Skip => {},
        }
        i = i + 1;
    }
    return count;
}

// An expression match arm block ends with its value, like an if expression
// branch.
fn label_of(kind: Kind) -> []u8 {
    return match kind {
        Count => {
            let tag = "count";
            tag
        },
        Skip => "skip",
    };
}

fn main() -> !void {
    print(count_even(6));
    print(label_of(Kind::Count));
    print(label_of(Kind::Skip));
    return;
}

