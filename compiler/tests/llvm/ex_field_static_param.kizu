struct User {
    pub name: []u8,
    pub age: i64,
}

// A `Field` static parameter is one struct field, named at the call. The body
// reads it through the forms written against it, so the compiler checks and
// lowers this function once per field rather than once for the whole type --
// the same expansion a `comptime for` does, reached through a call instead.
fn label<T, f: Field>() -> []u8 {
    return std::meta::field_name<T, f>();
}

fn main() -> void {
    print(label<User, name>());
    print(label<User, age>());
}

// run
// features: comptime static-params field-static-param reflection struct
// output:
// name
// age

// llvm
// emit:
// ; Kizu LLVM IR
// %kizu.slice.u8 = type { ptr, i64 }
// %kizu.struct.User = type { %kizu.slice.u8, i64 }
// 
// @.str.0 = private unnamed_addr constant [5 x i8] c"name\00"
// @.str.1 = private unnamed_addr constant [4 x i8] c"age\00"
// 
// declare void @kizu_print_string(ptr, i64)
// declare void @kizu_print_int(i64)
// declare void @kizu_print_bool(i1)
// declare void @kizu_main_error_message(ptr, i64)
// 
// declare void @kizu_runtime_init_args(i32, ptr)
// 
// define i32 @main(i32 %kizu.argc, ptr %kizu.argv) {
// entry:
//   call void @kizu_runtime_init_args(i32 %kizu.argc, ptr %kizu.argv)
//   %kizu.1 = call %kizu.slice.u8 @label_User_name()
//   %kizu.print.slice.ptr.1 = extractvalue %kizu.slice.u8 %kizu.1, 0
//   %kizu.print.slice.len.2 = extractvalue %kizu.slice.u8 %kizu.1, 1
//   call void @kizu_print_string(ptr %kizu.print.slice.ptr.1, i64 %kizu.print.slice.len.2)
//   %kizu.3 = call %kizu.slice.u8 @label_User_age()
//   %kizu.print.slice.ptr.3 = extractvalue %kizu.slice.u8 %kizu.3, 0
//   %kizu.print.slice.len.4 = extractvalue %kizu.slice.u8 %kizu.3, 1
//   call void @kizu_print_string(ptr %kizu.print.slice.ptr.3, i64 %kizu.print.slice.len.4)
//   ret i32 0
// }
// 
// define %kizu.slice.u8 @label_User_name() {
// entry:
//   %kizu.1.ptr = getelementptr inbounds [5 x i8], ptr @.str.0, i64 0, i64 0
//   %kizu.1.base = insertvalue %kizu.slice.u8 poison, ptr %kizu.1.ptr, 0
//   %kizu.1 = insertvalue %kizu.slice.u8 %kizu.1.base, i64 4, 1
//   ret %kizu.slice.u8 %kizu.1
// }
// 
// define %kizu.slice.u8 @label_User_age() {
// entry:
//   %kizu.1.ptr = getelementptr inbounds [4 x i8], ptr @.str.1, i64 0, i64 0
//   %kizu.1.base = insertvalue %kizu.slice.u8 poison, ptr %kizu.1.ptr, 0
//   %kizu.1 = insertvalue %kizu.slice.u8 %kizu.1.base, i64 3, 1
//   ret %kizu.slice.u8 %kizu.1
// }
