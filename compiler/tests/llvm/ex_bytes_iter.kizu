import std::mem;

fn fill(bytes: &var []u8) -> void {
    bytes[0] = 10;
    bytes[1] = 20;
    bytes[2] = 30;
    return;
}

// std::mem::bytes_iter is the iterator protocol over bytes: `next() -> ?u8`
// drives the loop to exhaustion. The cursor captures the view and stays tied
// to `buf` (ADR-0100), so it can never outlive the bytes it walks.
fn main() -> !void {
    var buf = [3]u8{};
    let scratch = buf.as_mut_bytes();
    fill(scratch);
    let view = buf.as_bytes();
    var it = mem::bytes_iter(view);
    while it.next() |byte| {
        print(byte);
    }
    return;
}

