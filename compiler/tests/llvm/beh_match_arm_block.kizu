import std::testing;

enum Kind {
    Count,
    Skip,
}

fn kind_of(index: i64) -> Kind {
    if index - (index / 2) * 2 == 0 {
        return Kind::Count;
    }
    return Kind::Skip;
}

// A statement match arm block runs its statements in place (ADR-0107):
// assignments mutate the enclosing scope and the loop keeps running.
test "statement match arm block runs assignments in place" {
    var count = 0;
    var i = 0;
    while i < 6 {
        match kind_of(i) {
            Count => {
                count = count + 1;
            },
            Skip => {},
        }
        i = i + 1;
    }
    testing::expect_equal<i64>(3, count);
    testing::expect_equal<i64>(6, i);
}

// An expression match arm block yields its trailing value, like an if
// expression branch.
test "expression match arm block ends with a value" {
    let doubled = match kind_of(0) {
        Count => {
            let base = 2;
            base * 2
        },
        Skip => 0,
    };
    testing::expect_equal<i64>(4, doubled);
}

// `return` inside an arm block leaves the function like any block return.
fn first_skip(limit: i64) -> i64 {
    var i = 0;
    while i < limit {
        match kind_of(i) {
            Count => {},
            Skip => {
                return i;
            },
        }
        i = i + 1;
    }
    return -1;
}

test "return inside a match arm block leaves the function" {
    testing::expect_equal<i64>(1, first_skip(6));
    testing::expect_equal<i64>(-1, first_skip(0));
}

