import std::array;
import std::mem;
import std::sort;
import std::string;

fn make_string(allocator: Allocator, bytes: []u8) -> !string::String {
    return string::from_bytes(allocator, bytes);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var names = array::new<string::String>(allocator);
    defer names.deinit(allocator);
    try names.append(allocator, try make_string(allocator, "delta"));
    try names.append(allocator, try make_string(allocator, "alpha"));
    try names.append(allocator, try make_string(allocator, "charlie"));
    try names.append(allocator, try make_string(allocator, "alpha"));

    try sort::strings(&var names);
    var index = 0;
    while names.at(index) |name| {
        let bytes = name.as_bytes();
        print(bytes);
        index = index + 1;
    }
    return;
}

// run
// features: std-sort strings owner-safe in-place
// output:
// alpha
// alpha
// charlie
// delta

