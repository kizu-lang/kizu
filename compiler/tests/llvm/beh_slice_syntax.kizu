import std::testing;

test "slice syntax" {
    let bytes = "lexer token";
    let first = bytes[0];
    let lexer = bytes[0..5];
    let token = bytes[6..];
    let prefix = bytes[..5];

    testing::expect_equal<i64>(108, cast<i64>(first));
    testing::expect_equal<[]u8>("lexer", lexer);
    testing::expect_equal<[]u8>("token", token);
    testing::expect_equal<[]u8>("lexer", prefix);
}

