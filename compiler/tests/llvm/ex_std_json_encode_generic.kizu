import std::array;
import std::json;
import std::mem;
import std::string;

pub struct Line {
    pub sku: []u8,
    pub qty: i64,
}

pub struct Order {
    pub id: i64,
    pub lines: array::Array<Line>,
    pub note: ?i64,
}

// `encode<T>` reads the value's own shape at compile time, so the document is
// written by the type rather than by hand: a nested struct, an array of
// structs, and an unset optional each follow from what the type says.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var order = Order {
        id: 9,
        lines: array::new<Line>(allocator),
        note: null,
    };
    defer order.deinit(allocator);
    try order.lines.append(allocator, Line { sku: "a", qty: 2 });
    try order.lines.append(allocator, Line { sku: "b", qty: 4 });

    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Order>(allocator, order, out);

    let bytes = out.as_bytes();
    print(bytes);
    return;
}

