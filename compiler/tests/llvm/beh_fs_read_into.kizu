import std::fs;
import std::io;
import std::mem;
import std::string;
import std::testing;

// ADR-0091 決定 5: fs の確保 API は allocator と確保上限を source に明示し、
// 返り値は owner の String として consume 義務を負う。

test "read_file returns the file as an owned String" {
    let stdio = io::blocking();
    let allocator = mem::page_allocator();
    let text = try fs::read_file(
        stdio, allocator, "examples/fixtures/config.txt", mem::Limit::Unlimited);
    defer text.deinit(allocator);
    testing::expect_equal<i64>(16, text.len());
    try text.truncate(15);
    let view = text.as_bytes();
    testing::expect_equal<[]u8>("kizu fs fixture", view);
}

test "read_file under an explicit byte ceiling succeeds" {
    let stdio = io::blocking();
    let allocator = mem::page_allocator();
    let text = try fs::read_file(
        stdio, allocator, "examples/fixtures/config.txt", mem::Limit::Bytes(1024));
    defer text.deinit(allocator);
    testing::expect_equal<i64>(16, text.len());
}

test "read_file_into appends to the caller buffer without fs allocation" {
    let stdio = io::blocking();
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try out.append_bytes(allocator, "head:");
    try fs::read_file_into(stdio, allocator, "examples/fixtures/config.txt", &var out);
    testing::expect_equal<i64>(21, out.len());
    try out.truncate(20);
    let view = out.as_bytes();
    testing::expect_equal<[]u8>("head:kizu fs fixture", view);
}

