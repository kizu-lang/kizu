import std;
struct User {
    name: []u8,
}
fn main() {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    let alice = users.add(allocator, User { name: "alice" });
    print(users.at(alice).name);
    users.deinit(allocator);
}


