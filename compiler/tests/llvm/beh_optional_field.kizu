// entry:
//   %kizu.1 = insertvalue %kizu.opt.Point zeroinitializer, i8 0, 0
//   %kizu.2 = insertvalue %kizu.struct.Anchor zeroinitializer, %kizu.opt.Point %kizu.1, 0
