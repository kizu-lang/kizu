// if.end.3:
//   %kizu.10 = phi i64 [ %kizu.7, %if.then.1 ], [ %kizu.9, %if.else.2 ]
//   %kizu.12 = sub i64 0, 1
//   %kizu.13.ok = icmp eq i64 %kizu.12, %kizu.10
