import std::map;
import std::mem;
import std::string;
import std::testing;

test "std map many keys" {
    let allocator = mem::page_allocator();
    let table = map::new<[]u8, i64>(allocator);
    defer table.deinit(allocator);
    let key = string::new(allocator);
    defer key.deinit(allocator);

    var i = 0;
    while i < 512 {
        key.clear();
        try key.append_byte(allocator, cast<u8>(97 + i % 26));
        try key.append_byte(allocator, cast<u8>(97 + (i / 26) % 26));
        let bytes = key.as_bytes();
        try table.insert(allocator, bytes, i);
        i = i + 1;
    }
    testing::expect_equal<i64>(512, table.len());

    var total = 0;
    var j = 0;
    while j < 512 {
        key.clear();
        try key.append_byte(allocator, cast<u8>(97 + j % 26));
        try key.append_byte(allocator, cast<u8>(97 + (j / 26) % 26));
        let bytes = key.as_bytes();
        let value = table.get(bytes) orelse 0;
        total = total + value;
        j = j + 1;
    }
    testing::expect_equal<i64>(130816, total);

    try table.insert(allocator, "aa", 1000);
    testing::expect_equal<i64>(512, table.len());
    testing::expect_equal<i64>(1000, table.get("aa") orelse -1);
    testing::expect(!table.contains("zz"));

}

