struct Pair { left: i64, right: i64 }
fn touch(left: &var i64, right: &var i64) {
    print(left);
    print(right);
}
fn main() {
    var pair = Pair { left: 1, right: 2 };
    touch(&var pair.left, &var pair.right);
    print(pair.left);
    print(pair.right);
}


