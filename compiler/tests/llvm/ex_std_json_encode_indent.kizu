import std::array;
import std::json;
import std::mem;
import std::string;

pub struct Line {
    pub sku: []u8,
    pub qty: i64,
}

pub struct Order {
    pub id: i64,
    pub lines: array::Array<Line>,
}

// The indented form is the same document `encode` writes, with whitespace
// between its parts. Spaces and tabs are separate calls rather than one call
// taking the bytes: an encoder holding a `[]u8` could not be lent a view, and
// `write_bytes_field(name, string.as_bytes())` is how string data gets in.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var order = Order { id: 9, lines: array::new<Line>(allocator) };
    defer order.deinit();
    try order.lines.append(Line { sku: "a", qty: 2 });

    var out = string::new(allocator);
    defer out.deinit();
    try json::encode_with_spaces<Order>(allocator, 2, order, out);

    let bytes = out.as_bytes();
    print(bytes);
    return;
}

// run
// features: std-json std-meta comptime-for reflection formatting
// output:
// {
//   "id": 9,
//   "lines": [
//     {
//       "sku": "a",
//       "qty": 2
//     }
//   ]
// }


