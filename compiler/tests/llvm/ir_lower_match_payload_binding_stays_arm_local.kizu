union Slot {
    Empty,
    A(i64),
    B(i64),
}

fn main() {
    var w = -1;
    let p = Slot::A(1);
    match p {
        A(x) => { w = x; },
        B(x) => { w = x; },
        Empty => { w = 0; },
    }
    let q = Slot::B(2);
    match q {
        A(x) => { w = w + x; },
        B(x) => { w = w + x; },
        Empty => { w = 0; },
    }
    print(w);
}

