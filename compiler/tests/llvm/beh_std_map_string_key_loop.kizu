import std::map;
import std::mem;
import std::string;
import std::testing;

test "std map string key loop" {
    let allocator = mem::page_allocator();
    var symbols = map::new<[]u8, i64>(allocator);
    defer symbols.deinit(allocator);
    var index = 0;
    while index < 2 {
        if index >= 0 {
            var key_builder = string::new(allocator);
            defer key_builder.deinit(allocator);
            try key_builder.append_bytes(allocator, "symbol");
            let key = key_builder.as_bytes();
            try symbols.insert(allocator, key, index);
        }
        index = index + 1;
    }
    testing::expect(symbols.contains("symbol"));
}

