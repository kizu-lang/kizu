error FsError {
    NotFound,
    Denied,
}

fn describe(failure: FsError) -> []u8 {
    return match failure {
        NotFound => "not found",
        Denied => "denied",
    };
}

fn main() -> FsError!void {
    let failure = FsError::NotFound;
    print(describe(failure));
    print(describe(failure));
    return FsError::Denied;
}

