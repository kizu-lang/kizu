import std::mem;
import std::string;

// `&var []u8` carries the write permission (ADR-0096): the holder writes
// elements in place, and the String stays exclusively borrowed meanwhile.
fn upper_first(buf: &var []u8) -> void {
    if mem::len(buf) > 0 {
        buf[0] = 75;
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    defer name.deinit(allocator);
    try name.append_bytes(allocator, "kizu");

    let view = name.as_mut_bytes();
    upper_first(view);
    view[3] = 79;

    let read = name.as_bytes();
    print(read);
    return;
}

