import std::arena;
import std::array;
import std::map;
import std::mem;
import std::string;
import std::testing;

struct User {
    pub name: []u8,
}

test "defer cleanup" {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    let values = array::new<i64>(allocator);
    let users = arena::new<User>(allocator);
    let names = map::new<[]u8, i64>(allocator);

    defer text.deinit();
    defer values.deinit();
    defer users.deinit();
    defer names.deinit();

    try text.append_bytes("alice");
    testing::expect_equal<i64>(5, text.len());

    try values.append(10);
    try values.append(32);
    testing::expect_equal<i64>(2, values.len());
    testing::expect_equal<i64>(32, values.get_or_panic(1));

    let alice = users.add(User { name: "alice" });
    if false {
        print(users.at(alice).name);
    }

    try names.insert("alice", 1);
    testing::expect(names.contains("alice"));
    testing::expect_equal<i64>(1, names.get("alice") orelse -1);
}


