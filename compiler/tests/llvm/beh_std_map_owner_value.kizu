import std::array;
import std::map;
import std::mem;
import std::string;
import std::testing;

fn owned(allocator: Allocator, bytes: []u8) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes(allocator, bytes);
    return move text;
}

test "std map owner value borrow and grow" {
    let allocator = mem::page_allocator();
    var names = map::new<[]u8, string::String>(allocator);
    defer names.deinit(allocator);

    try names.insert(allocator, "first", try owned(allocator, "alice"));
    try names.insert(allocator, "last", try owned(allocator, "smith"));
    testing::expect_equal<i64>(2, names.len());

    if names.at("first") |name| {
        let bytes = name.as_bytes();
        testing::expect_equal<[]u8>("alice", bytes);
    } else {
        testing::fail("first is missing");
    }

    // at_mut borrows in place, which is how a stored owner changes without
    // leaving the map.
    if names.at_mut("last") |name| {
        try name.append_bytes(allocator, "son");
    } else {
        testing::fail("last is missing");
    }
    if names.at("last") |name| {
        let bytes = name.as_bytes();
        testing::expect_equal<[]u8>("smithson", bytes);
    } else {
        testing::fail("last is missing");
    }
}

test "std map owner value keeps insertion order" {
    let allocator = mem::page_allocator();
    var names = map::new<[]u8, string::String>(allocator);
    defer names.deinit(allocator);

    try names.insert(allocator, "b", try owned(allocator, "one"));
    try names.insert(allocator, "a", try owned(allocator, "two"));

    var joined = string::new(allocator);
    defer joined.deinit(allocator);
    var index = 0;
    while names.key_at(index) |key| {
        try joined.append_bytes(allocator, key);
        index = index + 1;
    }
    let order = joined.as_bytes();
    testing::expect_equal<[]u8>("ba", order);
}

test "std map holds containers as values" {
    let allocator = mem::page_allocator();

    // A map value that is itself a container was refused only because the
    // copy constraint masked it; nothing about nesting needed its own rule.
    var counts = map::new<[]u8, map::Map<[]u8, i64>>(allocator);
    defer counts.deinit(allocator);
    var inner = map::new<[]u8, i64>(allocator);
    errdefer inner.deinit(allocator);
    try inner.insert(allocator, "hit", 2);
    try counts.insert(allocator, "alice", move inner);
    if counts.at("alice") |held| {
        testing::expect_equal<i64>(1, held.len());
    } else {
        testing::fail("alice is missing");
    }

    var lists = map::new<[]u8, array::Array<i64>>(allocator);
    defer lists.deinit(allocator);
    var items = array::new<i64>(allocator);
    errdefer items.deinit(allocator);
    try items.append(allocator, 7);
    try lists.insert(allocator, "alice", move items);
    if lists.at("alice") |held| {
        testing::expect_equal<i64>(1, held.len());
    } else {
        testing::fail("alice is missing");
    }
}

