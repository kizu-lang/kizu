import std::mem;
import std::string;

fn append_suffix(allocator: Allocator, text: &var string::String) -> !void {
    try text.append_bytes(allocator, " suffix");
    text.clear();
    try text.append_bytes(allocator, "mutated");
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "prefix");
    try append_suffix(allocator, text);

    let bytes = text.as_bytes();
    print(bytes);
    return;
}

