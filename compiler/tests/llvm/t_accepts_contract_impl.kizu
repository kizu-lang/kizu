struct Bytes { text: []u8 }
struct File { name: []u8 }
contract Writer {
    fn write(bytes: &Bytes) -> !i64;
}
fn (self: &File) write(bytes: &Bytes) -> !i64 {
    print(self.name);
    print(bytes.text);
    return 1;
}
impl Writer for File;
fn save<W>(writer: &W, bytes: &Bytes) -> !void {
    let n = try writer.write(bytes);
    print(n);
    return;
}
fn main() -> !void {
    let file = File { name: "out" };
    let bytes = Bytes { text: "hello" };
    try save<File>(file, bytes);
    return;
}

