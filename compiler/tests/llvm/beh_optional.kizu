// declare i64 @std__mem__len(%kizu.slice.u8)
// declare ptr @std__mem__page_allocator()
// declare %kizu.opt.slice.u8 @std__mem__slice(%kizu.slice.u8, i64, i64)
// declare %kizu.opt.slice.u8 @std__process__env(%kizu.slice.u8)
// declare %kizu.error.std__mem__Error.void @std__string__String_append_bytes(%kizu.struct.std__string__String, %kizu.slice.u8)
// declare void @std__string__String_deinit(%kizu.struct.std__string__String)
// declare i64 @std__string__String_len(%kizu.struct.std__string__String)
// declare %kizu.struct.std__string__String @std__string__new(ptr)
// declare void @std__testing__expect(i1)
// 
// declare void @kizu_panic_arena_add(i64, i64)
// declare void @kizu_panic_arena_handle(i64, i64)
// declare void @kizu_panic_bounds(i64, i64, i64, i64)
// declare void @kizu_panic_expect_equal_bytes(ptr, i64, ptr, i64, i64, i64)
// declare void @kizu_panic_expect_equal_int(i64, i64, i64, i64)
// 
// define %kizu.opt.i64 @find(%kizu.slice.u8 %kizu.bytes, i8 %kizu.needle) {
// entry:
//   br label %while.header.1
// while.header.1:
//   %kizu.2 = phi i64 [ 0, %entry ], [ %kizu.12, %if.end.6 ]
//   %kizu.3 = call i64 @std__mem__len(%kizu.slice.u8 %kizu.bytes)
//   %kizu.4 = icmp slt i64 %kizu.2, %kizu.3
//   br i1 %kizu.4, label %while.body.2, label %while.end.3
// while.body.2:
//   %kizu.5 = extractvalue %kizu.slice.u8 %kizu.bytes, 1
//   %kizu.6 = icmp slt i64 %kizu.2, 0
//   br i1 %kizu.6, label %kizu.6.fail, label %kizu.6.pass
// kizu.6.fail:
//   call void @kizu_panic_bounds(i64 %kizu.2, i64 %kizu.5, i64 12, i64 17)
//   unreachable
// kizu.6.pass:
//   %kizu.7 = icmp sge i64 %kizu.2, %kizu.5
//   br i1 %kizu.7, label %kizu.7.fail, label %kizu.7.pass
// kizu.7.fail:
//   call void @kizu_panic_bounds(i64 %kizu.2, i64 %kizu.5, i64 12, i64 17)
//   unreachable
// kizu.7.pass:
//   %kizu.8.ptr = extractvalue %kizu.slice.u8 %kizu.bytes, 0
//   %kizu.8.elem.ptr = getelementptr i8, ptr %kizu.8.ptr, i64 %kizu.2
//   %kizu.8 = load i8, ptr %kizu.8.elem.ptr
//   %kizu.9 = icmp eq i8 %kizu.8, %kizu.needle
//   br i1 %kizu.9, label %if.then.4, label %if.else.5
// while.end.3:
//   %kizu.13 = insertvalue %kizu.opt.i64 zeroinitializer, i8 0, 0
//   ret %kizu.opt.i64 %kizu.13
// if.then.4:
//   %kizu.10.some = insertvalue %kizu.opt.i64 zeroinitializer, i8 1, 0
//   %kizu.10 = insertvalue %kizu.opt.i64 %kizu.10.some, i64 %kizu.2, 1
//   ret %kizu.opt.i64 %kizu.10
// if.else.5:
//   br label %if.end.6
// if.end.6:
//   %kizu.12 = add i64 %kizu.2, 1
//   br label %while.header.1
// }
// 
// define %kizu.struct.BytesIter @iter(%kizu.slice.u8 %kizu.bytes) {
// entry:
//   %kizu.2.field0 = insertvalue %kizu.struct.BytesIter zeroinitializer, %kizu.slice.u8 %kizu.bytes, 0
//   %kizu.2 = insertvalue %kizu.struct.BytesIter %kizu.2.field0, i64 0, 1
//   ret %kizu.struct.BytesIter %kizu.2
// }
// 
// define %kizu.opt.u8 @BytesIter_next(ptr %kizu.self) {
// entry:
//   %kizu.1.ptr = getelementptr %kizu.struct.BytesIter, ptr %kizu.self, i32 0, i32 1
//   %kizu.1 = load i64, ptr %kizu.1.ptr
//   %kizu.2.ptr = getelementptr %kizu.struct.BytesIter, ptr %kizu.self, i32 0, i32 0
//   %kizu.2 = load %kizu.slice.u8, ptr %kizu.2.ptr
