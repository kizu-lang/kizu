import std::arena;
import std::array;
import std::map;
import std::mem;
import std::process;
import std::string;
import std::testing;

fn find(bytes: []u8, needle: u8) -> ?i64 {
    var index = 0;
    while index < mem::len(bytes) {
        if bytes[index] == needle {
            return index;
        }
        index = index + 1;
    }
    return null;
}

// An optional return wraps its value implicitly, and `orelse` supplies the
// default on null.
test "orelse takes the value or the default" {
    testing::expect_equal<i64>(2, find("kizu", cast<u8>(122)) orelse -1);
    testing::expect_equal<i64>(-1, find("kizu", cast<u8>(120)) orelse -1);
}

// An if capture opens the payload only when a value is present.
test "if capture branches on presence" {
    var hit = 0;
    if find("kizu", cast<u8>(107)) |at| {
        hit = at + 10;
    } else {
        hit = -1;
    }
    testing::expect_equal<i64>(10, hit);
    if find("kizu", cast<u8>(120)) |at| {
        hit = at;
    } else {
        hit = -2;
    }
    testing::expect_equal<i64>(-2, hit);
}

struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn iter(bytes: []u8) -> BytesIter {
    return BytesIter { bytes: bytes, index: 0 };
}

fn (self: &var BytesIter) next() -> ?u8 {
    if self.index >= mem::len(self.bytes) {
        return null;
    }
    let byte = self.bytes[self.index];
    self.index = self.index + 1;
    return byte;
}

// A single `next() -> ?u8` drives the loop to exhaustion: the iterator
// protocol needs no separate has_next.
test "while capture loops until null" {
    var it = iter("kizu");
    var total = 0;
    while it.next() |byte| {
        total = total + cast<i64>(byte);
    }
    testing::expect_equal<i64>(451, total);
}

error ReadError {
    Broken,
}

struct Stream {
    pub bytes: []u8,
    pub index: i64,
    pub broken: bool,
}

fn (self: &var Stream) next() -> ReadError!?u8 {
    if self.broken {
        return ReadError::Broken;
    }
    if self.index >= mem::len(self.bytes) {
        return null;
    }
    let byte = self.bytes[self.index];
    self.index = self.index + 1;
    return byte;
}

fn drain(bytes: []u8, broken: bool) -> ReadError!i64 {
    var s = Stream { bytes: bytes, index: 0, broken: broken };
    var sum = 0;
    while try s.next() |byte| {
        sum = sum + cast<i64>(byte);
    }
    return sum;
}

// `E!?T` composes: the call can fail, and succeeding can still find nothing.
// One signature carries the error member, null, and the payload; the failure
// path is pinned by examples/negative/optional_stream_broken.kizu.
test "error union with optional success drives a fallible stream" {
    testing::expect_equal<i64>(451, try drain("kizu", false));
    var s = Stream { bytes: "k", index: 0, broken: false };
    testing::expect_equal<i64>(107, cast<i64>(try s.next() orelse 0));
    testing::expect_equal<i64>(0, cast<i64>(try s.next() orelse 0));
}

// Container lookups answer a question, and "not there" is an answer: the
// miss is null, not an error (docs/style.md).
test "container lookups miss as null" {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    defer values.deinit();
    try values.append(41);
    testing::expect_equal<i64>(41, values.get(0) orelse -1);
    testing::expect_equal<i64>(-1, values.get(9) orelse -1);
    testing::expect_equal<i64>(41, values.pop() orelse -1);
    testing::expect_equal<i64>(-1, values.pop() orelse -1);

    var table = map::new<[]u8, i64>(allocator);
    defer table.deinit();
    try table.insert("hit", 7);
    testing::expect_equal<i64>(7, table.get("hit") orelse -1);
    testing::expect_equal<i64>(-1, table.get("miss") orelse -1);
}

// A borrow payload rides the optional too: `at(key) -> ?&V` binds the value
// borrow as the capture, at_mut writes through it in place, and the else arm
// runs the miss path with the map no longer borrowed.
test "map at_mut updates values in place" {
    let allocator = mem::page_allocator();
    var counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit();
    try counts.insert("kizu", 41);

    if counts.at_mut("kizu") |count| {
        count.* = count.* + 1;
    } else {
        try counts.insert("kizu", 1);
    }
    if counts.at_mut("lang") |count| {
        count.* = count.* + 1;
    } else {
        try counts.insert("lang", 1);
    }

    testing::expect_equal<i64>(42, counts.get("kizu") orelse -1);
    testing::expect_equal<i64>(1, counts.get("lang") orelse -1);
    if counts.at("miss") |ghost| {
        testing::expect_equal<i64>(-1, ghost.*);
    }
}

struct Visitor {
    pub age: i64,
    pub visits: i64,
}

// An arena borrow payload writes through the handle in place: at_mut binds
// the element borrow as the capture and releases the arena at its last use.
test "arena at_mut updates elements in place" {
    let allocator = mem::page_allocator();
    var visitors = arena::new<Visitor>(allocator);
    defer visitors.deinit();
    let alice = visitors.add(Visitor { age: 30, visits: 0 });

    if visitors.at_mut(alice) |v| {
        v.visits = v.visits + 1;
    }

    testing::expect_equal<i64>(1, visitors.at(alice).visits);
    testing::expect_equal<i64>(30, visitors.at(alice).age);
}

struct Ledger {
    pub entries: array::Array<i64>,
}

fn (self: &var Ledger) bump(index: i64) -> void {
    if self.entries.at_mut(index) |v| {
        v.* = v.* + 1;
    }
}

// A capture reaches one direct container field of an owner: the borrow lands
// on that field, and a `&var self` method can hold it.
test "at_mut captures an owner's container field" {
    let allocator = mem::page_allocator();
    var ledger = Ledger { entries: array::new<i64>(allocator) };
    defer ledger.deinit();
    try ledger.entries.append(7);
    ledger.bump(0);
    if ledger.entries.at(0) |v| {
        testing::expect_equal<i64>(8, v.*);
    }
}

fn (self: &var Ledger) entry(index: i64) -> ?&var i64 {
    return self.entries.at_mut(index);
}

// A declared borrow-optional return moves the accessor out of the call site:
// the capture borrows `self` for its scope, and the body may only return a
// borrow rooted in a borrowed parameter.
test "borrow optional returns flow to the caller's capture" {
    let allocator = mem::page_allocator();
    var ledger = Ledger { entries: array::new<i64>(allocator) };
    defer ledger.deinit();
    try ledger.entries.append(7);
    if ledger.entry(0) |v| {
        v.* = v.* + 1;
    }
    testing::expect_equal<i64>(8, ledger.entries.get_or_panic(0));
    if ledger.entry(9) |ghost| {
        ghost.* = 0;
        testing::expect(false);
    }
}

fn bump_first(items: &var array::Array<i64>) -> void {
    if items.at_mut(0) |v| {
        v.* = v.* + 1;
    }
}

// A `&var` borrow is a mutable place: a helper taking the container by
// `&var` consumes at_mut itself, so update logic leaves the call site.
test "at_mut works through a &var parameter" {
    let allocator = mem::page_allocator();
    var items = array::new<i64>(allocator);
    defer items.deinit();
    try items.append(7);
    bump_first(items);
    testing::expect_equal<i64>(8, items.get_or_panic(0));
}

// A view payload rides the optional: mem::slice misses as null, and the
// unset-environment lookup does too.
test "view payloads miss as null" {
    testing::expect_equal<[]u8>("ab", mem::slice("abc", 0, 2) orelse "");
    testing::expect_equal<[]u8>("", mem::slice("abc", 0, 4) orelse "");
    testing::expect_equal<[]u8>(
        "",
        process::env("KIZU_SURELY_UNSET_VAR_12345") orelse "");
}

fn guarded_find(bytes: []u8, needle: u8) -> i64 {
    let at = find(bytes, needle) orelse return -1;
    return at + 100;
}

// `orelse return/break` is the guard form: the null arm leaves the function
// or loop, so the payload flows on without a nested capture.
test "orelse guards exit on null" {
    testing::expect_equal<i64>(102, guarded_find("kizu", cast<u8>(122)));
    testing::expect_equal<i64>(-1, guarded_find("kizu", cast<u8>(120)));

    var it = iter("kz");
    var total = 0;
    while true {
        let byte = it.next() orelse break;
        total = total + cast<i64>(byte);
    }
    testing::expect_equal<i64>(229, total);
}

fn make_name(allocator: Allocator, text: []u8) -> !string::String {
    var name = string::new(allocator);
    errdefer name.deinit();
    try name.append_bytes(text);
    return move name;
}

// An owner payload moves out through the capture and owes its cleanup there.
test "owner payload pops through the capture" {
    let allocator = mem::page_allocator();
    var names = array::new<string::String>(allocator);
    defer names.deinit();
    try names.append(try make_name(allocator, "kizu"));

    var length = 0;
    if names.pop() |taken| {
        length = taken.len();
        taken.deinit();
    }
    testing::expect_equal<i64>(4, length);
    if names.pop() |ghost| {
        ghost.deinit();
        testing::expect(false);
    }
}

fn or_one(value: ?u8) -> i64 {
    return cast<i64>(value orelse cast<u8>(1));
}

// Optionals travel as arguments, and `null` is legal wherever a `?T` is
// expected.
test "optional arguments accept null and values" {
    testing::expect_equal<i64>(1, or_one(null));
    testing::expect_equal<i64>(9, or_one(cast<u8>(9)));
}


