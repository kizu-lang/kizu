struct Trace {
    label: []u8,
}

fn (self: Trace) deinit() -> void {
    print(self.label);
}

fn run() -> i64 {
    let first = Trace { label: "first" };
    defer first.deinit();

    if true {
        let inner = Trace { label: "inner" };
        defer inner.deinit();
    }

    let second = Trace { label: "second" };
    defer second.deinit();

    return 7;
}

fn main() {
    print(run());
}

