union ConfigError {
    NotFound([]u8),
    InvalidPort(i64),
    PermissionDenied,
}

union ConfigRead {
    Ok(i64),
    Err(ConfigError),
}

fn read_port(ok: bool) -> ConfigRead {
    if ok {
        return ConfigRead::Ok(8080);
    }

    return ConfigRead::Err(ConfigError::NotFound("config.kizu"));
}

fn main() -> void {
    let result = read_port(false);

    match result {
        Ok(port) => print(port),
        Err(err) => match err {
            NotFound(path) => print(path),
            InvalidPort(port) => print(port),
            PermissionDenied => print("permission denied"),
        },
    }
}

