// `c"..."` is a C string literal: the address of the bytes between the quotes
// with one NUL after them, typed `ptr<const u8>`. A C function that takes a
// name reads up to that NUL, so a fixed name reaches it without a copy. A
// string literal `"..."` is a `[]u8` view and promises no NUL.
extern "c" fn strlen(text: ptr<const u8>) -> usize
extern "c" fn atoi(text: ptr<const u8>) -> i32
extern "c" fn strchr(text: ptr<const u8>, byte: i32) -> ?ptr<const u8>
// Counts the bytes before the NUL, the way C reads the literal.
fn length(text: ptr<const u8>) -> i64 {
    var count = 0;
    // SAFETY: text is NUL-terminated, and the walk stops at the NUL.
    while unsafe ptr_read(unsafe ptr_offset(text, count)) != 0 {
        count = count + 1;
    }
    return count;
}

fn main() -> void {
    // Writing the literal reads nothing; the call that reads it is the
    // unsafe step.
    // SAFETY: the literal is NUL-terminated.
    print(unsafe strlen(c"hello"));
    // SAFETY: the literal is NUL-terminated.
    print(unsafe atoi(c"42"));
    // The NUL is there for Kizu code too, and `c""` is the address of one NUL.
    print(length(c"hello, kizu"));
    print(length(c""));
    // A `?ptr<const u8>` position takes the literal the way it takes any
    // `ptr<const u8>`.
    let entry: ?ptr<const u8> = c"name=kizu";
    if entry |text| {
        // SAFETY: text is NUL-terminated, and 61 is `=`.
        if unsafe strchr(text, 61) |rest| {
            print(length(rest));
        }
    }
    return;
}

