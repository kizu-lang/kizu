fn main() -> void {
    var i = 0;
    outer: while i < 3 {
        var j = 0;
        while j < 3 {
            if i == 1 {
                break :outer;
            }
            print(i * 10 + j);
            j = j + 1;
        }
        i = i + 1;
    }
}

