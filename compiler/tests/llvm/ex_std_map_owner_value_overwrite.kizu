import std::map;
import std::mem;
import std::string;

fn owned(allocator: Allocator, bytes: []u8) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit();
    try text.append_bytes(bytes);
    return move text;
}

// A map that holds owner values cannot overwrite one: the value already stored
// under that key would be dropped, and the map is the only thing that still
// knows about it. So a second insert under the same key traps rather than
// leaking it. Replacing one in place is `at_mut`.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var names = map::new<[]u8, string::String>(allocator);
    defer names.deinit();

    try names.insert("first", try owned(allocator, "alice"));
    try names.insert("first", try owned(allocator, "bob"));
    return;
}

