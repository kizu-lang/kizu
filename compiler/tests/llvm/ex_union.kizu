union Shape {
    Point,
    Circle(i64),
    Label([]u8),
}

fn describe(shape: &Shape) -> void {
    match shape {
        Point => print("point"),
        Circle(radius) => print(radius),
        Label(text) => print(text),
    }
}

fn main() {
    let circle = Shape::Circle(10);
    let label = Shape::Label("name");
    describe(circle);
    describe(label);
    describe(Shape::Point);
}

// run
// features: union match
// output:
// 10
// name
// point


