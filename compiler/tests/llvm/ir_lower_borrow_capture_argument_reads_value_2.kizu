import std;
union Shape { Dot, Bar(i64) }
fn read_shape(s: &Shape) -> i64 {
    return match s {
        Dot => 0,
        Bar(n) => n,
    };
}
fn main() {
    let allocator = std::mem::page_allocator();
    var xs = std::array::new<Shape>(allocator);
    if xs.at_mut(0) |m| {
        print(read_shape(m));
    }
    xs.deinit(allocator);
}

