import std::testing;

enum Level {
    Low,
    High,
}

// The comma after the last match arm is optional (ADR-0107), matching the
// comma-separated list rule: the closing `}` terminates the last arm body.
test "expression match works without a comma after the last arm" {
    let level = Level::High;
    let label = match level { Low => "low", High => "high" };
    testing::expect_equal<[]u8>("high", label);
}

test "statement match works without a comma after the last arm" {
    var seen = 0;
    match Level::Low { Low => { seen = seen + 1; }, High => {} }
    match Level::High { Low => {}, High => { seen = seen + 10; } }
    testing::expect_equal<i64>(11, seen);
}

