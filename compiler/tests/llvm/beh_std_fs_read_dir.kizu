import std;

test "std fs read dir" {
    let io = std::io::blocking();
    // read_dir returns a deterministic order, and pinning one is the point of
    // this example. It reads a fixture directory it owns rather than a source
    // tree, so adding a file to the repository cannot break it.
    var entries = try std::fs::read_dir(io, "examples/fixtures/read_dir");
    defer entries.deinit();
    std::testing::expect(entries.len() == 3);

    let first = entries.get_or_panic(0);
    std::testing::expect_equal<[]u8>("alpha.txt", first.name);
    std::testing::expect_equal<[]u8>(
        "examples/fixtures/read_dir/alpha.txt",
        first.path
    );
    std::testing::expect(!first.is_dir);

    let second = entries.get_or_panic(1);
    std::testing::expect_equal<[]u8>("beta.txt", second.name);
    std::testing::expect(!second.is_dir);

    // `nested` sorts after both files and is the corpus's only is_dir entry.
    let third = entries.get_or_panic(2);
    std::testing::expect_equal<[]u8>("nested", third.name);
    std::testing::expect(third.is_dir);

}


