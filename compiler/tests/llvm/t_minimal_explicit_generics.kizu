fn identity<T>(value: T) -> T {
    return value;
}
fn is_i64<T>(value: T) -> bool {
    comptime if T == type<i64> {
        return true;
    } else {
        return false;
    }
}
fn main() {
    print(identity<i64>(7));
    print(is_i64<i64>(1));
    print(is_i64<bool>(false));
}

