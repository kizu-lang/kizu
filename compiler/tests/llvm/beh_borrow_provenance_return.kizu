import std::testing;

fn shared(value: &i64) -> &i64 {
    return value;
}

fn mutable(value: &var i64) -> &var i64 {
    return value;
}

test "borrow provenance return" {
    var value = 41;

    let read = shared(value);
    testing::expect(read.* == 41);

    let write = mutable(value);
    write.* = 42;

    let after = shared(value);
    testing::expect(after.* == 42);
}

// llvm
// emit:
// ; Kizu LLVM IR
// %kizu.error.void = type { i8, i64 }
// 
// @.kizu.error.names = private unnamed_addr constant [1 x { ptr, i64 }] [{ ptr, i64 } { ptr null, i64 0 }]
// 
// declare void @kizu_print_string(ptr, i64)
// declare void @kizu_print_int(i64)
// declare void @kizu_print_bool(i1)
// declare void @kizu_main_error_message(ptr, i64)
// 
// declare void @kizu_runtime_init_args(i32, ptr)
// 
// declare void @std__testing__expect(i1)
// 
// define i64 @shared(i64 %kizu.value) {
// entry:
//   ret i64 %kizu.value
// }
// 
// define ptr @mutable(ptr %kizu.value) {
// entry:
//   ret ptr %kizu.value
// }
// 
// define %kizu.error.void @test_borrow_provenance_return() {
// entry:
//   %kizu.2 = alloca i64
//   store i64 41, ptr %kizu.2
//   %kizu.3 = load i64, ptr %kizu.2
//   %kizu.4 = call i64 @shared(i64 %kizu.3)
//   %kizu.6 = icmp eq i64 %kizu.4, 41
//   call void @std__testing__expect(i1 %kizu.6)
//   %kizu.8 = call ptr @mutable(ptr %kizu.2)
//   store i64 42, ptr %kizu.8
//   %kizu.11 = load i64, ptr %kizu.2
//   %kizu.12 = call i64 @shared(i64 %kizu.11)
//   %kizu.14 = icmp eq i64 %kizu.12, 42
//   call void @std__testing__expect(i1 %kizu.14)
//   %kizu.16 = insertvalue %kizu.error.void zeroinitializer, i8 1, 0
//   ret %kizu.error.void %kizu.16
// }
