fn first<A, B>(left: A, right: B) -> A {
    return left;
}

fn second<A, B>(left: A, right: B) -> B {
    return right;
}

fn scaled<n: i64>(value: i64) -> i64 {
    return value * n;
}

fn forward<n: i64>(value: i64) -> i64 {
    return scaled<n>(value);
}

fn main() -> void {
    print(first<i64, bool>(7, true));
    print(second<i64, bool>(7, true));
    print(scaled<3>(5));
    print(scaled<4>(5));
    print(forward<6>(5));
}

