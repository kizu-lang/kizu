import std::json;
import std::mem;

pub union Note {
    Empty,
    Count(i64),
    Text(i64),
}

// A variant that carries a payload is written as the object naming it, and a
// value is one variant. Two keys name two variants, so the document does not
// say which one it is; picking either would invent an answer the bytes never
// gave.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"Count": 1, "Text": 2}
    ;
    let note = try json::decode<Note>(allocator, document);
    print(match note {
        Empty => 0,
        Count(number) => number,
        Text(number) => number,
    });
    return;
}

