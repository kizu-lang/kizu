//   %kizu.return.join.arm0.f0 = extractvalue %kizu.error.Fault.Grid %kizu.4, 0
//   %kizu.return.join.arm0.f1 = extractvalue %kizu.error.Fault.Grid %kizu.4, 1
//   br label %kizu.return.join
// if.else.2:
//   br label %if.end.3
// if.end.3:
//   %kizu.6 = srem i64 %kizu.seed, 2
//   %kizu.8 = icmp eq i64 %kizu.6, 1
//   br i1 %kizu.8, label %if.then.4, label %if.else.5
