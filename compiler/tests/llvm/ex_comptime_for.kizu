import std::fmt;
import std::mem;
import std::string;

pub struct User {
    pub id: i64,
    pub active: bool,
}

// describe walks a struct's public fields at compile time. The body is
// expanded once per field, so `f` names a different field -- and a different
// field type -- in each expansion. This is not a macro: each expansion is
// ordinary Kizu code, type checked with that field's type in hand.
fn describe<T>(allocator: Allocator, out: &var string::String, value: &T) -> !void {
    comptime for std::meta::public_fields<T>() |f| {
        try out.append_bytes(allocator, std::meta::field_name<T, f>());
        try out.append_bytes(allocator, "=");
        try append_scalar<std::meta::field_type<T, f>>(allocator, out, std::meta::field<T, f>(value));
        try out.append_bytes(allocator, ";");
    }
    return;
}

fn append_scalar<T>(allocator: Allocator, out: &var string::String, value: &T) -> !void {
    comptime if T == type<i64> {
        try fmt::append_i64(allocator, out, value.*);
    } else {
        try fmt::append_bool(allocator, out, value.*);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit(allocator);

    let user = User { id: 7, active: true };
    try describe<User>(allocator, text, user);

    let bytes = text.as_bytes();
    print(bytes);
    return;
}

