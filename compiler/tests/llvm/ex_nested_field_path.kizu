struct Budget {
    spent: i64,
    cap: i64,
}

struct Order {
    id: i64,
    budget: Budget,
}

struct Session {
    current: Order,
    count: i64,
}

fn is_over(b: &Budget) -> bool {
    return b.spent > b.cap;
}

fn boost(b: &var Budget) -> void {
    b.spent = b.spent + 10;
}

fn main() -> void {
    var s = Session {
        current: Order { id: 1, budget: Budget { spent: 3, cap: 2 } },
        count: 0,
    };
    if is_over(s.current.budget) {
        print("over");
    }
    let b = &s.current.budget;
    s.count = 5;
    print(b.spent);
    boost(&var s.current.budget);
    print(s.current.budget.spent);
    print(s.count);
}

// run
// features: borrow field-borrow mutable-borrow field-access ownership
// output:
// over
// 3
// 13
// 5

