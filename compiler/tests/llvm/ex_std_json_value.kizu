import std::json;
import std::mem;
import std::string;

// A `Value` is a document read without deciding its type first. It is an
// ordinary recursive union, not a document-object layer: `decode<Value>` goes
// through the same parser every other type does, so both routes sit behind the
// same defenses against untrusted input.
fn kind(value: &json::Value) -> []u8 {
    return match value {
        Null => "null",
        Bool(_) => "bool",
        I64(_) => "i64",
        Str(_) => "str",
        Arr(_) => "arr",
        Obj(_) => "obj",
    };
}

// Walking one is an ordinary match, and the payloads are borrowed, so nothing
// is copied and nothing has to be released here.
fn size(value: &json::Value) -> i64 {
    return match value {
        Null => 0,
        Bool(_) => 0,
        I64(number) => number,
        Str(text) => text.len(),
        Arr(items) => items.len(),
        Obj(entries) => entries.len(),
    };
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"user": "alice", "visits": [1, 2, 3], "active": null}
    ;
    var value = try json::decode<json::Value>(allocator, document);
    defer value.deinit();
    print(kind(&value));
    print(size(&value));

    // A `Value` writes back what it read. Its variants name JSON's own shapes
    // rather than a program's, so `encode` does not tag them the way it tags a
    // union a program declared: the document that comes out is the one that
    // went in, apart from whitespace.
    var out = string::new(allocator);
    defer out.deinit();
    try json::encode<json::Value>(allocator, value, out);
    let written = out.as_bytes();
    print(written);
    return;
}

// run
// features: std-json decode encode union match recursive-union std-string
// output:
// obj
// 3
// {"user":"alice","visits":[1,2,3],"active":null}


