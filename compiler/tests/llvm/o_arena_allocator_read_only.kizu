import std;
struct UserArena {}
struct UserArena2 {}

struct User {
    name: []u8,
}
fn main() {
    let allocator = std::mem::page_allocator();
    let left = std::arena::new<User, UserArena>(allocator);
    let right = std::arena::new<User, UserArena2>(allocator);
    print(left);
    print(right);
    left.deinit(allocator);
    right.deinit(allocator);
}


