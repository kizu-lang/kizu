import std;
struct User {
    name: []u8,
}
fn main() {
    let allocator = std::mem::page_allocator();
    let left = std::arena::new<User>(allocator);
    let right = std::arena::new<User>(allocator);
    print(left);
    print(right);
    left.deinit(allocator);
    right.deinit(allocator);
}


