import std::testing;

enum Mode {
    Idle,
    Busy,
}

enum Kind {
    First,
    Second,
}

fn mode_of(kind: Kind) -> Mode {
    return match kind {
        First => Mode::Busy,
        Second => Mode::Idle,
    };
}

fn assigned_mode(kind: Kind) -> Mode {
    var mode = Mode::Idle;
    match kind {
        First => { mode = Mode::Busy; },
        Second => { mode = Mode::Idle; },
    }
    return mode;
}

fn cast_of(kind: Kind, value: i64) -> u64 {
    return match kind {
        First => cast<u64>(value),
        Second => cast<u64>(0),
    };
}

test "a match expression merges enum values" {
    testing::expect(mode_of(Kind::First) == Mode::Busy);
    testing::expect(mode_of(Kind::Second) == Mode::Idle);
}

test "a match arm assigns an enum to an outer var" {
    testing::expect(assigned_mode(Kind::First) == Mode::Busy);
    testing::expect(assigned_mode(Kind::Second) == Mode::Idle);
}

test "a match expression merges no-op casts" {
    testing::expect(cast_of(Kind::First, 3) == cast<u64>(3));
    testing::expect(cast_of(Kind::Second, 5) == cast<u64>(0));
}

