// An array holds any copy data -- bool, enums, copy structs, other arrays --
// and a literal can list its elements. A nested array indexes one level per
// `[i]`.

enum Spin {
    Up,
    Down,
}

struct Point {
    x: f64,
    y: f64,
}

struct Lattice {
    cell: [3][3]f64,
    spins: [4]Spin,
    corners: [2]Point,
}

fn trace(m: [3][3]f64) -> f64 {
    return m[0][0] + m[1][1] + m[2][2];
}

fn width(points: []Point) -> f64 {
    return points[1].x - points[0].x;
}

fn main() -> void {
    let identity = [3][3]f64{
        [3]f64{ 1.0, 0.0, 0.0 },
        [3]f64{ 0.0, 1.0, 0.0 },
        [3]f64{ 0.0, 0.0, 1.0 },
    };
    var lattice = Lattice {
        cell: identity,
        spins: [4]Spin{ Spin::Up, Spin::Down, Spin::Up, Spin::Up },
        corners: [2]Point{ Point { x: 0.0, y: 0.0 }, Point { x: 2.5, y: 1.0 } },
    };
    lattice.cell[1][1] = 4.0;
    lattice.spins[3] = Spin::Down;
    print(trace(lattice.cell));
    print(trace(identity));
    var downs = 0;
    for 0..4 |i| {
        match lattice.spins[i] {
            Up => {},
            Down => {
                downs = downs + 1;
            },
        }
    }
    print(downs);
    let corners = lattice.corners;
    let view = corners.as_slice();
    print(width(view));
    var flags = [3]bool{};
    flags[1] = true;
    print(flags[0]);
    print(flags[1]);
    let row = lattice.cell[2];
    print(row[2]);
    return;
}

