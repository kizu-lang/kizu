import std::fmt;
import std::mem;
import std::string;

pub struct Profile {
    pub city: []u8,
    pub age: i64,
}

pub struct User {
    pub id: i64,
    pub profile: Profile,
    pub active: bool,
}

// render is one function that walks any struct, nested ones included: a field
// whose type is itself a struct takes the same branch, so the recursion is the
// program's, not a special case in the compiler. Each instantiation is checked
// with its own field types.
fn render<T>(out: &var string::String, value: &T) -> !void {
    comptime if std::meta::is_struct<T>() {
        try out.append_bytes("{");
        comptime for std::meta::public_fields<T>() |f| {
            try out.append_bytes(std::meta::field_name<T, f>());
            try out.append_bytes(":");
            try render<std::meta::field_type<T, f>>(out, std::meta::field<T, f>(value));
            try out.append_bytes(" ");
        }
        try out.append_bytes("}");
    } else {
        try render_scalar<T>(out, value);
    }
    return;
}

fn render_scalar<T>(out: &var string::String, value: &T) -> !void {
    comptime if T == type<i64> {
        try fmt::append_i64(out, value.*);
    } else {
        comptime if T == type<bool> {
            try fmt::append_bool(out, value.*);
        } else {
            try out.append_bytes(value.*);
        }
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit();

    let user = User {
        id: 7,
        profile: Profile { city: "kyoto", age: 30 },
        active: true,
    };
    try render<User>(text, user);

    let bytes = text.as_bytes();
    print(bytes);
    return;
}

// run
// features: comptime comptime-for std-meta reflection generics
// output:
// {id:7 profile:{city:kyoto age:30 } active:true }


