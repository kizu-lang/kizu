import std::arena;
import std::mem;

struct User {
    name: []u8,
}

// An arena travels to a helper as a borrow like any other value. The callee
// cannot see which arena a handle came from, so the signature carries the
// contract; a confusion between two known arenas is still rejected where
// both are visible. A handle moves into a call like any owned value, so a
// helper that keeps it usable hands it back.
fn find(users: &arena::Arena<User>, h: arena::Handle<User>) -> &User {
    return users.at(h);
}

fn show(users: &arena::Arena<User>, h: arena::Handle<User>) -> void {
    let user = find(users, h);
    print(user.name);
}

fn rename(users: &var arena::Arena<User>, h: arena::Handle<User>) -> arena::Handle<User> {
    if users.at_mut(h) |u| {
        u.name = "bob";
    }
    return h;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var users = arena::new<User>(allocator);
    defer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    print(users.at(alice).name);
    let renamed = rename(users, alice);
    show(&users, renamed);
    return;
}

