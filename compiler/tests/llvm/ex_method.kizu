struct Counter {
    label: []u8,
    count: i64,
}

fn (self: Counter) describe() -> void {
    print(self.label);
    print(self.count);
}

fn (self: Counter) next() -> Counter {
    return Counter { label: self.label, count: self.count + 1 };
}

fn main() {
    let start = Counter { label: "hits", count: 1 };
    start.describe();
    let stepped = start.next();
    stepped.describe();
}

