struct Plate {
    cells: [20]i64,
    tag: i64,
}

struct Tool {
    apply: fn(i64) -> i64,
    table: [20]i64,
}

error Fault {
    Empty,
    Bent,
}

struct Shelf {
    front: ?Plate,
    result: Fault!Plate,
    form: Form,
    tool: ?Tool,
    count: i64,
}

struct Tray {
    front: ?Plate,
    count: i64,
}

union Form {
    None,
    Thin(i64),
    Flat(Plate),
}

fn bare() -> Plate {
    return Plate { cells: [20]i64{}, tag: 3 };
}

fn found(seed: i64) -> Fault!Plate {
    if seed == 0 {
        return Fault::Empty;
    }
    return bare();
}

fn twice(value: i64) -> i64 {
    return value * 2;
}

// A by-value struct is the caller's storage: its wrappers are opened where
// they lie.
fn (self: Shelf) front_tag() -> i64 {
    if self.front |plate| {
        return plate.tag + self.count;
    }
    return -1;
}

fn (self: Shelf) result_tag() -> i64 {
    if self.result |plate| {
        return plate.cells[1];
    } else |failure| {
        return grade(failure);
    }
}

fn (self: Shelf) tool_entry(i: i64) -> i64 {
    if self.tool |held| {
        let apply = held.apply;
        return apply(held.table[i]);
    }
    return -2;
}

fn (self: Shelf) tool_or(other: Tool) -> Tool {
    return self.tool orelse other;
}

// A wrapper read whole out of the caller's storage is loaded from there, and
// the rest of the struct is not.
fn (self: Shelf) form_area() -> i64 {
    return area(self.form);
}

fn (self: Shelf) front_or(other: Plate) -> Plate {
    return self.front orelse other;
}

fn grade(failure: Fault) -> i64 {
    return match failure {
        Empty => -10,
        Bent => -11,
    };
}

// A union handed over by value is the aggregate it is; a large payload is
// read where the union was put.
fn area(form: Form) -> i64 {
    match form {
        None => return 0,
        Thin(width) => return width,
        Flat(plate) => return plate.tag + plate.cells[2],
    }
}

// A union behind a borrow is copied out once and opened in the copy.
fn area_of(form: &Form) -> i64 {
    match form {
        None => return 0,
        Thin(width) => return width,
        Flat(plate) => return plate.tag,
    }
}

// Wrapping a value that is kept in memory builds the wrapper in a slot.
fn put(shelf: &var Shelf, plate: &Plate) -> void {
    shelf.front = plate.*;
    shelf.form = Form::Flat(plate.*);
    return;
}

fn thin(shelf: &var Shelf, width: i64) -> void {
    shelf.form = Form::Thin(width);
    shelf.form = Form::None;
    return;
}

// A failure of another type is read by its code; one of the function's own
// type is returned as the union it is.
fn (self: Shelf) reach() -> Fault!i64 {
    let plate = try self.result;
    return plate.tag;
}

fn (self: Shelf) again() -> Fault!Plate {
    let plate = try self.result;
    return plate;
}

fn (self: Shelf) taken() -> i64 {
    let plate = self.result catch return -3;
    return plate.cells[0];
}

// An element loaded whole makes the array it lies in take its elements
// whole.
fn rotate(row: &var [3]Tray) -> i64 {
    let first = row[0];
    row[0] = row[1];
    row[1].count = first.count + 1;
    row[2] = first;
    if first.front |plate| {
        return plate.tag + row[1].count;
    }
    return -4;
}

fn main() -> !void {
    var shelf = Shelf {
        front: null,
        result: found(1),
        form: Form::None,
        tool: Tool { apply: twice, table: [20]i64{} },
        count: 4,
    };
    let plate = bare();
    put(&var shelf, plate);
    print(shelf.front_tag() + shelf.result_tag() + shelf.tool_entry(1));
    print(shelf.form_area() + area_of(shelf.form) + shelf.front_or(plate).tag);
    let spare = Tool { apply: twice, table: [20]i64{} };
    print(shelf.tool_or(spare).table[0]);
    thin(&var shelf, 5);
    print(try shelf.reach());
    let other = try shelf.again();
    print(other.tag + shelf.taken());
    let tray = Tray { front: plate, count: 1 };
    var row = [3]Tray{ tray, tray, tray };
    print(rotate(&var row));
    return;
}

