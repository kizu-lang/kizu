import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    defer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    let user = users.at(alice);
    print(user.name);
    users.deinit(allocator);
    return;
}

// run
// features: arena handle shared-borrow
// output:
// alice

// llvm
// emit:
// check failed: arena error: arena `users` was deinitialized at 11:11
// opt:
// check failed: arena error: arena `users` was deinitialized at 11:11
