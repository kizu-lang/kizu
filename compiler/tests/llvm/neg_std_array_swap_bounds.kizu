import std::array;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try values.append(allocator, 1);
    try values.swap(0, 1);
    return;
}

