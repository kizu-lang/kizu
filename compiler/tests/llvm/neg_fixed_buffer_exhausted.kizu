import std::array;
import std::mem;

fn main() -> !void {
    var buf = [64]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    var values = array::new<i64>(alloc);
    defer values.deinit();
    var index = 0;
    while index < 100 {
        try values.append(index);
        index = index + 1;
    }
    return;
}

