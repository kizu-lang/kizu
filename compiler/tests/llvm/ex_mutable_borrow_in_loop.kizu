struct Counter {
    total: i64,
}

fn add(counter: &var Counter, value: i64) -> void {
    counter.total = counter.total + value;
}

fn main() -> void {
    var counter = Counter { total: 0 };
    for 0..4 |index| {
        add(counter, index);
        if counter.total > 2 {
            add(counter, 10);
        }
    }
    print(counter.total);
}

