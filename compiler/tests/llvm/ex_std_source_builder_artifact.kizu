import std::fmt;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var artifact = string::new(allocator);
    defer artifact.deinit(allocator);

    try artifact.reserve(allocator, 64);
    try artifact.append_bytes(allocator, "define i64 @main() {");
    try artifact.append_byte(allocator, cast<u8>(10));
    try artifact.append_bytes(allocator, "  ret i64 ");
    try fmt::append_i64(allocator, artifact, 42);
    try artifact.append_byte(allocator, cast<u8>(10));
    try artifact.append_bytes(allocator, "}");

    let bytes = artifact.as_bytes();
    print(bytes);

    return;
}

