import std::array;
import std::json;
import std::mem;
import std::string;

pub struct Row {
    pub label: string::String,
    pub cells: array::Array<i64>,
}

pub struct Grid {
    pub rows: array::Array<Row>,
}

// An array decodes each element as the element type, so a document that does
// not fit is an error rather than a value quietly skipped. The element type may
// itself hold arrays, which is what makes a whole tree one call.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"rows": [{"label": "a", "cells": [1, 2]}, {"label": "bc", "cells": [3]}]}
    ;
    var grid = try json::decode<Grid>(allocator, document);
    defer grid.deinit();
    print(grid.rows.len());

    var numbers = try json::decode<array::Array<i64>>(allocator, "[4, 5, 6]");
    defer numbers.deinit();
    print(numbers.len());
    print(numbers.get_or_panic(2));
    return;
}

