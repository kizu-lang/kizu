fn run(n: i64, flag: bool) -> i64 {
    var total = 0;
    var i = 0;
    while i < n {
        let entry = i * 2;
        total = total + entry;
        i = i + 1;
    }
    if flag {
        var j = 0;
        while j < n {
            let entry = j * 3;
            total = total + entry;
            j = j + 1;
        }
    }
    return total;
}

fn main() {
    print(run(3, true));
}

