union Slot {
    Empty,
    Full(i64),
}

struct Cell {
    slot: Slot,
    count: i64,
}

fn fill(cell: &var Cell, value: i64) -> void {
    cell.slot = Slot::Full(value);
    cell.count = cell.count + 1;
}

fn main() -> void {
    var cell = Cell { slot: Slot::Empty, count: 0 };
    fill(cell, 7);
    fill(cell, 9);
    match cell.slot {
        Empty => print(0),
        Full(value) => print(value),
    }
    print(cell.count);
}

