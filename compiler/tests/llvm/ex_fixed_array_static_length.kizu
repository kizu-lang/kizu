// An array's length can be a static integer: a static parameter, a
// `comptime for` capture, or a parenthesized expression of them. Each
// instance binds the length, so one generic body serves every size.

fn dot<n: i64>(a: &[n]f64, b: &[n]f64) -> f64 {
    var sum = 0.0;
    for 0..n |i| {
        sum = sum + a[i] * b[i];
    }
    return sum;
}

fn joined<n: i64, m: i64>(left: [n]i64, right: [m]i64) -> [(n + m)]i64 {
    var out = [(n + m)]i64{};
    for 0..n |i| {
        out[i] = left[i];
    }
    for 0..m |i| {
        out[n + i] = right[i];
    }
    return out;
}

fn trace<n: i64>(m: &[n][n]f64) -> f64 {
    var sum = 0.0;
    for 0..n |i| {
        sum = sum + m[i][i];
    }
    return sum;
}

fn main() -> void {
    let a = [3]f64{ 1.0, 2.0, 3.0 };
    let b = [3]f64{ 4.0, 5.0, 6.0 };
    print(dot<3>(&a, &b));
    let both = joined<2, 3>([2]i64{ 1, 2 }, [3]i64{ 3, 4, 5 });
    print(both[4]);
    let identity = [2][2]f64{ [2]f64{ 1.0, 0.0 }, [2]f64{ 0.0, 1.0 } };
    print(trace<2>(&identity));
    comptime for 1..4 |k| {
        var ramp = [k]i64{};
        for 0..k |i| {
            ramp[i] = i + 1;
        }
        print(ramp[k - 1]);
    }
    return;
}

