// A C function may take and return an `extern "c" struct` by value. The call
// passes it the way the target's C calling convention does: in registers when
// it is small enough, through memory otherwise, as a C compiler would.
extern "c" struct Quotient {
    quot: i64,
    rem: i64,
}

/// C's `double complex`, which C lays out as two doubles.
extern "c" struct Complex {
    re: f64,
    im: f64,
}

extern "c" fn lldiv(numer: i64, denom: i64) -> Quotient
@link_library("m")
extern "c" fn cabs(value: Complex) -> f64
@link_library("m")
extern "c" fn csqrt(value: Complex) -> Complex
pub fn main() -> void {
    // SAFETY: lldiv divides by any nonzero denominator.
    let division = unsafe lldiv(17, 5);
    print(division.quot);
    print(division.rem);
    // SAFETY: cabs reads any complex value.
    print(unsafe cabs(Complex { re: 3.0, im: 4.0 }));
    // SAFETY: csqrt takes any complex value.
    let root = unsafe csqrt(Complex { re: -4.0, im: 0.0 });
    print(root.re);
    print(root.im);
    return;
}

