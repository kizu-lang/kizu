import std::array;
import std::mem;

// Each call carves its allocations out of the caller's buffer. The allocator
// and everything built from it stay tied to the buffer, so nothing escapes,
// and the buffer is reusable as soon as they are gone: a heap-free scratch
// space that resets every round.
fn round(bytes: &var []u8, seed: i64) -> !void {
    let alloc = mem::fixed_buffer(bytes);
    var values = array::new<i64>(alloc);
    defer values.deinit(alloc);
    try values.append(alloc, seed);
    try values.append(alloc, seed * seed);
    print(values.get(0) orelse -1);
    print(values.get(1) orelse -1);
    return;
}

fn main() -> !void {
    var buf = [4096]u8{};
    let scratch = buf.as_mut_bytes();
    var seed = 2;
    while seed <= 3 {
        try round(scratch, seed);
        seed = seed + 1;
    }
    return;
}

