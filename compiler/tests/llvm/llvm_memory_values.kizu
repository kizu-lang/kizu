import std::arena;
import std::array;
import std::map;
import std::mem;

struct Plate {
    cells: [20]i64,
    tag: i64,
}

struct Rack {
    top: Plate,
    low: Plate,
    count: i64,
}

fn (self: Plate) first() -> i64 {
    return self.cells[0] + self.tag;
}

fn (self: Rack) reach() -> i64 {
    return self.top.first() + self.low.tag + self.count;
}

fn shared(plate: &Plate) -> i64 {
    return plate.tag;
}

fn either(left: Plate, right: Plate, take_right: bool) -> Plate {
    var chosen = left;
    if take_right {
        chosen = right;
    }
    return chosen;
}

fn (self: Rack) upper() -> Plate {
    return self.top;
}

fn lifted(rack: &var Rack) -> Plate {
    var plate = rack.top;
    plate.tag = plate.tag + 1;
    return plate;
}

fn wrap(rack: &var Rack) -> Rack {
    let top = rack.top;
    rack.low = top;
    rack.count = shared(top) + top.first();
    return Rack { top: rack.low, low: top, count: rack.count };
}

fn maybe(rack: &var Rack, keep: bool) -> ?Plate {
    if keep {
        return rack.top;
    }
    return null;
}

fn views(plates: &var []Plate) -> i64 {
    let held = plates[0];
    plates[0] = plates[1];
    plates[1] = held;
    return held.tag;
}

fn boxed(allocator: Allocator, plate: Plate) -> !i64 {
    let cell = try mem::box<Plate>(allocator, plate);
    defer cell.deinit(allocator);
    let inside = cell.borrow();
    return inside.first();
}

fn held(allocator: Allocator, rack: &var Rack) -> !i64 {
    var plates = array::new<Plate>(allocator);
    defer plates.deinit(allocator);
    try plates.append(allocator, rack.top);
    try plates.append(allocator, rack.low);
    try plates.set(0, rack.low);
    try plates.swap(0, 1);
    let front = plates.get_or_panic(0);
    let back = plates.pop_or_panic();
    var shelf = arena::new<Plate>(allocator);
    defer shelf.deinit(allocator);
    let handle = try shelf.add(allocator, front);
    let kept = shelf.at(handle);
    var named = map::new<i64, Plate>(allocator);
    defer named.deinit(allocator);
    try named.insert(allocator, 1, back);
    return kept.tag + either(front, back, rack.count > 0).first();
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var rack = Rack {
        top: Plate { cells: [20]i64{}, tag: 1 },
        low: Plate { cells: [20]i64{}, tag: 2 },
        count: 0,
    };
    let seen = rack;
    var carried = rack.top;
    for 0..2 |round| {
        if round == 1 {
            carried = rack.low;
        }
        rack.low.tag = rack.low.tag + 10;
    }
    let made = wrap(&var rack);
    print(seen.reach() + carried.tag + made.reach());
    if maybe(&var rack, true) |plate| {
        print(plate.tag);
    }
    var pair = [2]Plate{ rack.top, rack.low };
    let lent = pair.as_mut_slice();
    print(views(&var lent));
    print(try boxed(allocator, pair[0]));
    print(try held(allocator, &var rack));
    print(rack.upper().tag + lifted(&var rack).tag);
    return;
}

