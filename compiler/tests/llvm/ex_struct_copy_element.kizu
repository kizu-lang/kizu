import std::array;
import std::mem;

struct Point {
    x: i64,
    y: i64,
}

fn norm1(p: Point) -> i64 {
    return p.x + p.y;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var points = array::new<Point>(allocator);
    defer points.deinit();
    try points.append(Point { x: 3, y: 4 });
    try points.append(Point { x: 10, y: 20 });

    // A struct whose fields are all copy is itself copy: the element comes
    // out of the array by value, and the binding survives being passed on.
    let first = points.get_or_panic(0);
    print(norm1(first));
    print(norm1(first));
    if points.get(1) |p| {
        print(norm1(p));
    }
    return;
}

