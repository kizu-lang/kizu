import std::array;
import std::mem;
import std::testing;

enum Step {
    Count,
    Skip,
}

fn step_of(index: i64) -> Step {
    if index - (index / 2) * 2 == 0 {
        return Step::Count;
    }
    return Step::Skip;
}

// `Tag => {},` is a no-op arm (ADR-0107): unlike `Tag => return,` it does not
// leave the function, so a loop around the match keeps running.
test "empty match arm skips without exiting the loop" {
    let allocator = mem::page_allocator();
    let counted = array::new<i64>(allocator);
    defer counted.deinit();
    var i = 0;
    while i < 6 {
        match step_of(i) {
            Count => try counted.append(i),
            Skip => {},
        }
        i = i + 1;
    }
    testing::expect_equal<i64>(3, counted.len());
    testing::expect_equal<i64>(0, counted.get_or_panic(0));
    testing::expect_equal<i64>(2, counted.get_or_panic(1));
    testing::expect_equal<i64>(4, counted.get_or_panic(2));
    testing::expect_equal<i64>(6, i);
}


