import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = try string::from_bytes(allocator, "lexer");
    defer text.deinit(allocator);
    let source = "lexer";
    try text.reserve(allocator, 32);
    // The growth strategy is implementation-defined; only this holds.
    print(text.capacity() >= 32);
    print(source);
    try text.append_byte(allocator, cast<u8>(32));
    try text.append_bytes(allocator, "token");
    let bytes = text.as_bytes();
    print(bytes);
    print(text.len());
    text.clear();
    print(text.capacity() >= 32);
    try text.append_bytes(allocator, "done");
    let final = text.as_bytes();
    print(final);
    return;
}

