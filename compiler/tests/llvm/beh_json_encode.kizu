import std::array;
import std::json;
import std::map;
import std::mem;
import std::string;
import std::testing;

// A scalar is a complete JSON document; `finish_into` appends the encoded
// bytes into a String the caller owns.
test "json encoder writes a scalar document" {
    let allocator = mem::page_allocator();
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encoder.write_i64(42);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(allocator, out);
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>("42", bytes);
}

test "json encoder writes bool and null documents" {
    let allocator = mem::page_allocator();
    var yes = json::encoder(allocator);
    defer yes.deinit(allocator);
    try yes.write_bool(true);
    var yes_out = string::new(allocator);
    defer yes_out.deinit(allocator);
    try yes.finish_into(allocator, yes_out);
    let yes_bytes = yes_out.as_bytes();
    testing::expect_equal<[]u8>("true", yes_bytes);

    var nothing = json::encoder(allocator);
    defer nothing.deinit(allocator);
    try nothing.write_null();
    var nothing_out = string::new(allocator);
    defer nothing_out.deinit(allocator);
    try nothing.finish_into(allocator, nothing_out);
    let nothing_bytes = nothing_out.as_bytes();
    testing::expect_equal<[]u8>("null", nothing_bytes);
}

// The comma sits between elements only, so the document closes with every
// element separated and none trailing.
test "json encoder separates array elements" {
    let allocator = mem::page_allocator();
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encoder.begin_array();
    try encoder.write_i64(3);
    try encoder.write_i64(5);
    try encoder.write_null();
    try encoder.end_array();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(allocator, out);
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>("[3,5,null]", bytes);
}

// Each nesting level tracks its own element count: the inner arrays place
// commas independently of the outer one.
test "json encoder nests arrays with independent commas" {
    let allocator = mem::page_allocator();
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encoder.begin_array();
    try encoder.begin_array();
    try encoder.end_array();
    try encoder.begin_array();
    try encoder.write_i64(1);
    try encoder.write_i64(2);
    try encoder.end_array();
    try encoder.write_i64(9);
    try encoder.end_array();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(allocator, out);
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>("[[],[1,2],9]", bytes);
}

test "json encoder writes an empty object document" {
    let allocator = mem::page_allocator();
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encoder.begin_object();
    try encoder.end_object();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(allocator, out);
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>("{}", bytes);
}

// A String's bytes reach the encoder as a lent view. The encoder holds no
// view field and returns none, so the lend ends with the call and the source
// String stays the owner of those bytes.
test "json encoder writes a borrowed String view" {
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    defer name.deinit(allocator);
    try name.append_bytes(allocator, "alice");
    let name_bytes = name.as_bytes();

    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encoder.begin_object();
    try encoder.write_bytes_field("name", name_bytes);
    try encoder.end_object();

    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(allocator, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"name":"alice"}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

pub struct Point {
    pub x: i64,
    pub y: i64,
}

pub struct Shape {
    pub name: []u8,
    pub origin: Point,
    pub filled: bool,
}

// `encode<T>` writes a struct as an object of its public fields, in
// declaration order, with a nested struct taking the same path.
test "json encode writes a struct from its own shape" {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    let point = Point { x: 3, y: 4 };
    try json::encode<Point>(allocator, point, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"x":3,"y":4}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

test "json encode nests structs and keeps declaration order" {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    let shape = Shape {
        name: "box",
        origin: Point { x: 1, y: 2 },
        filled: true,
    };
    try json::encode<Shape>(allocator, shape, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"name":"box","origin":{"x":1,"y":2},"filled":true}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// A scalar is a whole document, so encode is not limited to structs.
test "json encode writes a scalar document" {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    let count = 42;
    try json::encode<i64>(allocator, count, out);
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>("42", bytes);
}

pub struct Bag {
    pub label: []u8,
    pub items: array::Array<i64>,
}

pub struct Counted {
    pub counts: map::Map<[]u8, i64>,
}

pub struct Boxed {
    pub held: mem::Box<i64>,
}

pub struct Maybe {
    pub set: ?i64,
    pub unset: ?i64,
}

// An array field becomes a JSON array, in index order.
test "json encode writes an array field" {
    let allocator = mem::page_allocator();
    var bag = Bag { label: "nums", items: array::new<i64>(allocator) };
    defer bag.deinit(allocator);
    try bag.items.append(allocator, 3);
    try bag.items.append(allocator, 5);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Bag>(allocator, bag, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"label":"nums","items":[3,5]}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// A map becomes an object keyed by its own keys. `key_at` walks insertion
// order, so the same map encodes the same way every run.
test "json encode writes a map field in insertion order" {
    let allocator = mem::page_allocator();
    var counted = Counted { counts: map::new<[]u8, i64>(allocator) };
    defer counted.deinit(allocator);
    try counted.counts.insert(allocator, "x", 1);
    try counted.counts.insert(allocator, "y", 2);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Counted>(allocator, counted, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"counts":{"x":1,"y":2}}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// A box is the value it holds: sole ownership is a tree, so it adds no shape
// of its own to the document.
test "json encode writes through a box" {
    let allocator = mem::page_allocator();
    var boxed = Boxed { held: try mem::box<i64>(allocator, 77) };
    defer boxed.deinit(allocator);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Boxed>(allocator, boxed, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"held":77}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// An optional field carries JSON's own absent value, so a field that is unset
// is written as null rather than dropped.
test "json encode writes an unset optional as null" {
    let allocator = mem::page_allocator();
    let maybe = Maybe { set: 42, unset: null };
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Maybe>(allocator, maybe, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"set":42,"unset":null}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

pub struct Named {
    pub id: i64,
    pub name: string::String,
}

// A String is a string, not an object. Its bytes are private, so a walk that
// treated it as a struct would write `{}` and drop the text -- the shape of
// silent wrongness `unsupported` exists to prevent.
test "json encode writes a String field as a string" {
    let allocator = mem::page_allocator();
    var named = Named { id: 7, name: string::new(allocator) };
    defer named.deinit(allocator);
    try named.name.append_bytes(allocator, "alice");
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Named>(allocator, named, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"id":7,"name":"alice"}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// The indented form differs from the compact one only in the whitespace
// between parts: the same keys, the same order, the same values.
test "json encode indents nested containers" {
    let allocator = mem::page_allocator();
    var bag = Bag { label: "nums", items: array::new<i64>(allocator) };
    defer bag.deinit(allocator);
    try bag.items.append(allocator, 3);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode_with_spaces<Bag>(allocator, 2, bag, out);
    let bytes = out.as_bytes();
    let expected =
        \\{
        \\  "label": "nums",
        \\  "items": [
        \\    3
        \\  ]
        \\}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// An empty container has nothing to indent, so it stays on one line rather
// than becoming a pair of braces with a blank line between them.
test "json encode keeps empty containers on one line" {
    let allocator = mem::page_allocator();
    var bag = Bag { label: "none", items: array::new<i64>(allocator) };
    defer bag.deinit(allocator);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode_with_spaces<Bag>(allocator, 2, bag, out);
    let bytes = out.as_bytes();
    let expected =
        \\{
        \\  "label": "none",
        \\  "items": []
        \\}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// A width of zero is the compact form, so one encoder covers both.
test "json encode with zero width is the compact form" {
    let allocator = mem::page_allocator();
    var bag = Bag { label: "nums", items: array::new<i64>(allocator) };
    defer bag.deinit(allocator);
    try bag.items.append(allocator, 3);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode_with_spaces<Bag>(allocator, 0, bag, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"label":"nums","items":[3]}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

pub enum Visibility {
    Public,
    Private,
}

pub union Slot {
    Vacant,
    Number(i64),
    Label(string::String),
}

fn (self: Slot) deinit(allocator: Allocator) -> void {
    match self {
        Vacant => return,
        Number(_) => return,
        Label(text) => text.deinit(allocator),
    }
    return;
}

pub struct Entryish {
    pub visibility: Visibility,
    pub slot: Slot,
}

// An enum is a variant that carries nothing, so it writes as the string naming
// the tag rather than as an object of its own.
test "json encode writes an enum tag as a string" {
    let allocator = mem::page_allocator();
    let visibility = Visibility::Private;
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Visibility>(allocator, visibility, out);
    let bytes = out.as_bytes();
    let expected =
        \\"Private"
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// A union variant that carries nothing follows the same rule an enum tag does:
// there is one representation, not one per declaration kind.
test "json encode writes a payload-free union variant as a string" {
    let allocator = mem::page_allocator();
    var slot = Slot::Vacant;
    defer slot.deinit(allocator);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Slot>(allocator, slot, out);
    let bytes = out.as_bytes();
    let expected =
        \\"Vacant"
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// A variant that carries a payload names itself with the single key of an
// object, so the payload keeps its own shape underneath.
test "json encode writes a union payload under the variant name" {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes(allocator, "hi");
    var slot = Slot::Label(move text);
    defer slot.deinit(allocator);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Slot>(allocator, slot, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"Label":"hi"}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// A sum type inside a struct writes under its field name, so one union field
// no longer takes the whole struct out of the generic path.
test "json encode writes sum fields of a struct" {
    let allocator = mem::page_allocator();
    var entry = Entryish { visibility: Visibility::Public, slot: Slot::Number(7) };
    defer entry.deinit(allocator);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Entryish>(allocator, entry, out);
    let bytes = out.as_bytes();
    let expected =
        \\{"visibility":"Public","slot":{"Number":7}}
    ;
    testing::expect_equal<[]u8>(expected, bytes);
}

// A `Value` writes back the document it was read from: its variants name
// JSON's own shapes, so tagging them would wrap a document that already says
// what it is.
test "json encode writes a Value without tagging it" {
    let allocator = mem::page_allocator();
    let document =
        \\{"a":[1,true,null],"b":"x"}
    ;
    var value = try json::decode<json::Value>(allocator, document);
    defer value.deinit(allocator);
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<json::Value>(allocator, value, out);
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>(document, bytes);
}

// llvm
// emit:
// ; Kizu LLVM IR
// %kizu.slice.u8 = type { ptr, i64 }
// %kizu.opt.i64 = type { i8, i64 }
// 
// %kizu.error.void = type { i8, i64 }
// %kizu.error.std__json__DecodeError.std__json__Value = type { i8, %kizu.union.std__json__Value, i64 }
// %kizu.error.std__mem__Error.std__mem__Box_i64_ = type { i8, ptr, i64 }
// %kizu.error.std__mem__Error.void = type { i8, i64 }
// 
// %kizu.union.Slot = type { i64, [24 x i8] }
// %kizu.union.std__json__Value = type { i64, [40 x i8] }
// %kizu.union.std__mem__Limit = type { i64, [8 x i8] }
// 
// %kizu.struct.Bag = type { %kizu.slice.u8, %kizu.array }
// %kizu.struct.Boxed = type { ptr }
// %kizu.struct.Counted = type { %kizu.map }
// %kizu.struct.Entryish = type { i64, %kizu.union.Slot }
// %kizu.struct.Maybe = type { %kizu.opt.i64, %kizu.opt.i64 }
// %kizu.struct.Named = type { i64, %kizu.struct.std__string__String }
// %kizu.struct.Point = type { i64, i64 }
// %kizu.struct.Shape = type { %kizu.slice.u8, %kizu.struct.Point, i1 }
// %kizu.struct.std__float__Big = type { %kizu.array }
// %kizu.struct.std__float__Decimal = type { %kizu.array, i64 }
// %kizu.struct.std__float__Scan = type { %kizu.slice.u8, i64 }
// %kizu.struct.std__json__Encoder = type { ptr, %kizu.struct.std__string__String, i64, i64, i64, i1, i8, i64 }
// %kizu.struct.std__json__Member = type { i64, i64 }
// %kizu.struct.std__json__Scan = type { %kizu.array }
// %kizu.struct.std__mem__AllocatorHeader = type { i64, i64, i64, i64 }
// %kizu.struct.std__mem__BytesIter = type { %kizu.slice.u8, i64 }
// %kizu.struct.std__string__Scalar = type { i64, i64 }
// %kizu.struct.std__string__String = type { %kizu.array }
// %kizu.struct.std__string__TrimBounds = type { i64, i64 }
// 
// @.kizu.error.name.1 = private unnamed_addr constant [31 x i8] c"std::array::Error::OutOfBounds\00"
// @.kizu.error.name.47 = private unnamed_addr constant [34 x i8] c"std::json::Error::UnexpectedToken\00"
// @.kizu.error.name.48 = private unnamed_addr constant [31 x i8] c"std::json::Error::MissingField\00"
// @.kizu.error.name.49 = private unnamed_addr constant [31 x i8] c"std::json::Error::UnknownField\00"
// @.kizu.error.name.50 = private unnamed_addr constant [33 x i8] c"std::json::Error::DuplicateField\00"
// @.kizu.error.name.51 = private unnamed_addr constant [32 x i8] c"std::json::Error::InvalidNumber\00"
// @.kizu.error.name.52 = private unnamed_addr constant [32 x i8] c"std::json::Error::InvalidEscape\00"
// @.kizu.error.name.53 = private unnamed_addr constant [32 x i8] c"std::json::Error::DepthExceeded\00"
// @.kizu.error.name.54 = private unnamed_addr constant [29 x i8] c"std::mem::Error::OutOfMemory\00"
// @.kizu.error.name.77 = private unnamed_addr constant [34 x i8] c"std::string::Error::InvalidLength\00"
// @.kizu.error.names = private unnamed_addr constant [78 x { ptr, i64 }] [{ ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr @.kizu.error.name.1, i64 30 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr @.kizu.error.name.47, i64 33 }, { ptr, i64 } { ptr @.kizu.error.name.48, i64 30 }, { ptr, i64 } { ptr @.kizu.error.name.49, i64 30 }, { ptr, i64 } { ptr @.kizu.error.name.50, i64 32 }, { ptr, i64 } { ptr @.kizu.error.name.51, i64 31 }, { ptr, i64 } { ptr @.kizu.error.name.52, i64 31 }, { ptr, i64 } { ptr @.kizu.error.name.53, i64 31 }, { ptr, i64 } { ptr @.kizu.error.name.54, i64 28 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr null, i64 0 }, { ptr, i64 } { ptr @.kizu.error.name.77, i64 33 }]
// 
// @.str.0 = private unnamed_addr constant [3 x i8] c"42\00"
// @.str.1 = private unnamed_addr constant [5 x i8] c"true\00"
// @.str.10 = private unnamed_addr constant [4 x i8] c"box\00"
// @.str.11 = private unnamed_addr constant [52 x i8] c"{\22name\22:\22box\22,\22origin\22:{\22x\22:1,\22y\22:2},\22filled\22:true}\00"
// @.str.12 = private unnamed_addr constant [5 x i8] c"nums\00"
// @.str.13 = private unnamed_addr constant [31 x i8] c"{\22label\22:\22nums\22,\22items\22:[3,5]}\00"
// @.str.14 = private unnamed_addr constant [2 x i8] c"x\00"
// @.str.15 = private unnamed_addr constant [2 x i8] c"y\00"
// @.str.16 = private unnamed_addr constant [25 x i8] c"{\22counts\22:{\22x\22:1,\22y\22:2}}\00"
// @.str.17 = private unnamed_addr constant [12 x i8] c"{\22held\22:77}\00"
// @.str.18 = private unnamed_addr constant [24 x i8] c"{\22set\22:42,\22unset\22:null}\00"
// @.str.19 = private unnamed_addr constant [24 x i8] c"{\22id\22:7,\22name\22:\22alice\22}\00"
// @.str.2 = private unnamed_addr constant [5 x i8] c"null\00"
// @.str.20 = private unnamed_addr constant [46 x i8] c"{\0A  \22label\22: \22nums\22,\0A  \22items\22: [\0A    3\0A  ]\0A}\00"
// @.str.21 = private unnamed_addr constant [5 x i8] c"none\00"
// @.str.22 = private unnamed_addr constant [37 x i8] c"{\0A  \22label\22: \22none\22,\0A  \22items\22: []\0A}\00"
// @.str.23 = private unnamed_addr constant [29 x i8] c"{\22label\22:\22nums\22,\22items\22:[3]}\00"
// @.str.24 = private unnamed_addr constant [10 x i8] c"\22Private\22\00"
// @.str.25 = private unnamed_addr constant [9 x i8] c"\22Vacant\22\00"
// @.str.26 = private unnamed_addr constant [3 x i8] c"hi\00"
