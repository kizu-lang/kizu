import std;
struct User { name: []u8 }
fn show(users: &std::arena::Arena<User>, user: std::arena::Handle<User>) -> void {
    print(users.at(user).name);
}
fn main() {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    let alice = users.add(User { name: "alice" });
    show(&users, alice);
    users.deinit();
}


