import std;
struct User { name: []u8 }
struct Parsed {
    users: std::arena::Arena<User>,
    ids: std::array::Array<i64>,
}
fn (self: Parsed) deinit() -> void {
    self.users.deinit();
    self.ids.deinit();
}
fn check(values: std::array::Array<Parsed>) -> !void {
    if values.pop() |item| {
        item.deinit();
    }
    values.deinit();
    return;
}
fn main() {}

