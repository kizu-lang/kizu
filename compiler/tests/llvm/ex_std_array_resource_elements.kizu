import std::arena;
import std::array;
import std::map;
import std::mem;

struct User {
    name: []u8,
}

struct Holder {
    values: array::Array<i64>,
}

union Slot {
    Empty,
    UserHandle(arena::Handle<User>),
}

// make_holder builds its element behind one cleanup boundary: error paths
// release the partial array, the success return moves it out.
fn make_holder(allocator: Allocator) -> !Holder {
    let inner = array::new<i64>(allocator);
    errdefer inner.deinit(allocator);
    try inner.append(allocator, 7);
    return Holder { values: move inner };
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    defer users.deinit(allocator);
    let handles = array::new<arena::Handle<User>>(allocator);
    defer handles.deinit(allocator);
    let maps = array::new<map::Map<[]u8, i64>>(allocator);
    defer maps.deinit(allocator);
    let holders = array::new<Holder>(allocator);
    defer holders.deinit(allocator);
    let slots = array::new<Slot>(allocator);
    defer slots.deinit(allocator);

    let alice = users.add(allocator, User { name: "alice" });
    try handles.append(allocator, alice);
    print(handles.len());

    let table = map::new<[]u8, i64>(allocator);
    try maps.append(allocator, move table);
    let moved_table = maps.pop_or_panic();
    moved_table.deinit(allocator);

    try holders.append(allocator, try make_holder(allocator));
    let holder = holders.pop_or_panic();
    print(holder.values.get_or_panic(0));
    holder.deinit(allocator);

    let bob = users.add(allocator, User { name: "bob" });
    try slots.append(allocator, Slot::UserHandle(bob));
    print(slots.len());
    return;
}

