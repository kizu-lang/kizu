import std::mem;

// A stack buffer holds fixed-width numbers, not only bytes: `[8]u32{}` is
// eight 32-bit words, zero-filled, on the frame. Its view is `[]u32`, read
// with `as_slice` and written through `as_mut_slice`, and an index reads
// or writes one whole element -- a word, not the bytes it is made of. The
// arithmetic on what is read is the element's own: a `u32` wraps at 32
// bits (SPEC §6.9.2). A view of bytes and a view of words are different
// types; there is no reinterpreting one as the other, so what the bytes
// of a word are is written where it matters, in the order it matters.
//
// Only `[N]u8` is viewed as bytes, with `as_bytes` / `as_mut_bytes`; every
// other element has `as_slice` / `as_mut_slice`, so the name of the view
// says what it counts.

fn sum(words: []u32) -> u32 {
    var total = cast<u32>(0);
    for 0..mem::count<u32>(words) |index| {
        total = total + words[index];
    }
    return total;
}

fn main() -> void {
    var words = [8]u32{};
    let view = words.as_mut_slice();
    view[0] = 4294967295;
    view[1] = view[0] + 2;
    view[7] = cast<u32>(7) << 28;
    let read = words.as_slice();
    print(read[0]);
    print(read[1]);
    print(read[7]);
    print(mem::count<u32>(read));
    let tail = read[6..8];
    print(mem::count<u32>(tail));
    print(sum(read));

    var samples = [3]f64{};
    let sample_view = samples.as_mut_slice();
    sample_view[2] = 2.5;
    sample_view[1] = sample_view[2] * 2.0;
    let sampled = samples.as_slice();
    print(sampled[1]);

    var offsets = [2]i16{};
    let offset_view = offsets.as_mut_slice();
    offset_view[0] = cast<i16>(0 - 300);
    let offset = offsets.as_slice();
    print(offset[0]);
    return;
}

