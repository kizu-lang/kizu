import std::map;
import std::mem;

// Map.at/at_mut return a borrow optional `?&V`: the value borrow when the key
// is present, null when it is absent. A capture is the only consumer, and it
// holds the map borrowed for the value borrow's scope, so an in-place update
// costs one lookup instead of a get/insert pair.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit(allocator);

    try counts.insert(allocator, "kizu", 41);

    if counts.at("kizu") |count| {
        print(count.*);
    }

    if counts.at_mut("kizu") |count| {
        count.* = count.* + 1;
    } else {
        try counts.insert(allocator, "kizu", 1);
    }

    if counts.at_mut("lang") |count| {
        count.* = count.* + 1;
    } else {
        try counts.insert(allocator, "lang", 1);
    }

    if counts.at("kizu") |count| {
        print(count.*);
    }
    if counts.at("lang") |count| {
        print(count.*);
    }

    return;
}

