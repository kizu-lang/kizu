import std::arena;
import std::mem;

struct Node {
    value: i64,
    left: ?arena::Handle<Node>,
    right: ?arena::Handle<Node>,
}

struct Tree {
    nodes: arena::Arena<Node>,
}

fn (self: &Tree) sum(h: arena::Handle<Node>) -> i64 {
    var total = self.nodes.at(h).value;
    if self.nodes.at(h).left |l| {
        total = total + self.sum(l);
    }
    if self.nodes.at(h).right |r| {
        total = total + self.sum(r);
    }
    return total;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tree = Tree { nodes: arena::new<Node>(allocator) };
    defer tree.deinit(allocator);
    let left = try tree.nodes.add(allocator, Node { value: 1, left: null, right: null });
    let right = try tree.nodes.add(allocator, Node { value: 4, left: null, right: null });
    let root = try tree.nodes.add(allocator, Node { value: 2, left: left, right: right });
    print(tree.sum(root));
    return;
}

