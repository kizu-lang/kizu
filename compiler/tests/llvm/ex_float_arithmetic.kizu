import std::float;

fn half(value: f64) -> f64 {
    return value / 2.0;
}

fn scale(value: f32) -> f32 {
    return value * 4.0;
}

fn main() {
    print(cast<i64>(half(7.0)));
    print(cast<i64>(2.5 * 4.0 + 1e1));
    print(cast<i64>(-1.5));
    print(cast<i64>(scale(1.5)));
    print(cast<f64>(3) == 3.0);
    print(0.1 + 0.2 == 0.3);
    print(0.1 + 0.2 > 0.3);
    let nan = 0.0 / 0.0;
    print(nan == nan);
    print(nan != nan);
    print(1.0 / 0.0 > 1e22);
    print(cast<i64>(1e22 * 1e22));
    print(cast<i64>(-1e22 * 1e22));
    print(cast<i64>(nan));
    print(cast<u8>(300.0));
    print(float::bits(1.0) == 0x3FF0000000000000);
    print(float::from_bits(0x4000000000000000) == 2.0);
    return;
}

