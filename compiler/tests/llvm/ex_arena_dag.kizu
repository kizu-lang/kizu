import std::arena;
import std::mem;

struct Node {
    value: i64,
    left: ?arena::Handle<Node>,
    right: ?arena::Handle<Node>,
}

fn sum(nodes: &arena::Arena<Node>, h: arena::Handle<Node>) -> i64 {
    var total = nodes.at(h).value;
    if nodes.at(h).left |l| {
        total = total + sum(nodes, l);
    }
    if nodes.at(h).right |r| {
        total = total + sum(nodes, r);
    }
    return total;
}

fn main() {
    let allocator = mem::page_allocator();
    let nodes = arena::new<Node>(allocator);
    // A handle is a copy ID: storing `shared` in two parents leaves it
    // usable for the direct read below.
    let shared = nodes.add(allocator, Node { value: 5, left: null, right: null });
    let a = nodes.add(allocator, Node { value: 10, left: shared, right: null });
    let b = nodes.add(allocator, Node { value: 20, left: shared, right: null });
    let root = nodes.add(allocator, Node { value: 1, left: a, right: b });
    print(sum(&nodes, root));
    print(nodes.at(shared).value);
    nodes.deinit(allocator);
}

// run
// features: arena handle copy optional struct
// output:
// 41
// 5

