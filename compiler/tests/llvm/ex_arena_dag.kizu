import std::arena;
import std::mem;

struct Node {
    value: i64,
    left: ?arena::Handle<Node>,
    right: ?arena::Handle<Node>,
}

fn sum(nodes: &arena::Arena<Node>, h: arena::Handle<Node>) -> i64 {
    var total = nodes.at(h).value;
    if nodes.at(h).left |l| {
        total = total + sum(nodes, l);
    }
    if nodes.at(h).right |r| {
        total = total + sum(nodes, r);
    }
    return total;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let nodes = arena::new<Node>(allocator);
    defer nodes.deinit(allocator);
    // A handle is a copy ID: storing `shared` in two parents leaves it
    // usable for the direct read below.
    let shared = try nodes.add(allocator, Node { value: 5, left: null, right: null });
    let a = try nodes.add(allocator, Node { value: 10, left: shared, right: null });
    let b = try nodes.add(allocator, Node { value: 20, left: shared, right: null });
    let root = try nodes.add(allocator, Node { value: 1, left: a, right: b });
    print(sum(&nodes, root));
    print(nodes.at(shared).value);
    return;
}

