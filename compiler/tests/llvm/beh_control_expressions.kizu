import std::testing;

enum Color {
    Red,
    Green,
    Blue,
}

fn choose(value: i64,) -> i64 {
    return value;
}

test "control expressions" {
    let age = 20;
    let adult = if age >= 18 {
        true
    } else {
        false
    };

    let color = Color::Green;
    let label = match color {
        Red => "red",
        Green => "green",
        Blue => "blue",
    };

    testing::expect_equal<i64>(1, choose(1,));
    testing::expect(adult);
    testing::expect_equal<[]u8>("green", label);
}

