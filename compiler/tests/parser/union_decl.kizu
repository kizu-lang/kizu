union Shape {
    Point,
    Circle(i64),
    Label([]u8),
}
fn main() {
    let shape = Shape::Circle(10);
    match shape {
        Point => print("point"),
        Circle(radius) => print(radius),
        Label(text) => print(text),
    }
}

