fn at<T>(values: std::array::Array<T>, index: i64) -> !&T {
    return std::internal::builtin::array_at<T>(values, index);
}
fn at_mut<T>(values: std::array::Array<T>, index: i64) -> !&var T {
    return std::internal::builtin::array_at_mut<T>(values, index);
}

// parse
// ast:
// fn at<T>(values: std::array::Array<T>, index: i64) -> !&T { return std::internal::builtin::array_at<T>(values, index); }
// fn at_mut<T>(values: std::array::Array<T>, index: i64) -> !&var T { return std::internal::builtin::array_at_mut<T>(values, index); }
