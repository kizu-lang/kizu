extern "browser" fn set_title(text: []u8) -> void

export "browser" fn on_event(kind: i32) -> i32 {
    return kind;
}

fn main() -> void {
    // SAFETY: set_title only borrows the string bytes for this synchronous call.
    unsafe set_title("Kizu");
}

