import std::process;

// main can return std::process::ExitStatus inside an error union. The exit
// of a process is one union value rather than one integer: the entry point
// maps Success to the host's success status, so a program that finishes
// cleanly says so without naming a platform number.
fn main() -> !process::ExitStatus {
    print("exiting with success");
    return process::ExitStatus::Success;
}

// run
// features: fn union error-union std-process
// output:
// exiting with success

