// An element of an array is a place: its fields are written in place
// (`cloud.pts[1].x = v`), and so is an array held inside it
// (`cloud.pts[0].v[1] = w`). A writable view of arrays writes its elements'
// cells the same way (`rows[1][0] = x`).

struct Point {
    x: f64,
    v: [2]f64,
}

struct Cloud {
    pts: [2]Point,
}

fn bump(rows: &var [][2]f64) -> void {
    rows[1][0] = rows[1][0] + 100.0;
    return;
}

fn shift(pts: &var [2]Point) -> void {
    pts[0].x = pts[0].x + 1.0;
    pts[1].v[1] = 7.0;
    return;
}

fn corner(rows: [][2]f64, k: i64) -> f64 {
    return rows[k][0] + rows[0][1];
}

fn main() -> void {
    var grid = [2][2]f64{ [2]f64{ 1.0, 2.0 }, [2]f64{ 3.0, 4.0 } };
    let rows = grid.as_mut_slice();
    bump(&var rows);
    print(corner(rows, 1));
    var cloud = Cloud {
        pts: [2]Point{ Point { x: 1.0, v: [2]f64{} }, Point { x: 2.0, v: [2]f64{} } },
    };
    cloud.pts[1].x = 20.0;
    cloud.pts[0].v[1] = 5.0;
    shift(&var cloud.pts);
    print(cloud.pts[0].x);
    print(cloud.pts[1].x);
    print(cloud.pts[0].v[1]);
    print(cloud.pts[1].v[1]);
    var loose = [2]Point{ Point { x: 1.0, v: [2]f64{} }, Point { x: 2.0, v: [2]f64{} } };
    for 0..2 |i| {
        loose[i].x = loose[i].x * 3.0;
        loose[i].v[i] = cast<f64>(i) + 0.5;
    }
    print(loose[1].x + loose[1].v[1]);
    return;
}

