import std;

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var path = try std::path::join(allocator, "examples/fixtures", "config.txt");
    defer path.deinit(allocator);
    let path_bytes = path.as_bytes();
    let metadata = try std::fs::metadata(io, path_bytes);
    let scratch = "kizu-v02-fs-dir";
    let source = "kizu-v02-fs-dir/source.txt";
    let target = "kizu-v02-fs-dir/target.txt";

    print(try std::fs::exists(io, path_bytes));
    print(metadata.size);
    print(metadata.is_dir);

    if try std::fs::exists(io, source) {
        try std::fs::remove_file(io, source);
    }
    if try std::fs::exists(io, target) {
        try std::fs::remove_file(io, target);
    }
    if try std::fs::exists(io, scratch) {
        try std::fs::remove_dir(io, scratch);
    }
    try std::fs::create_dir(io, scratch);
    print(try std::fs::exists(io, scratch));

    try std::fs::write_file(io, source, "first version");
    try std::fs::write_file(io, source, "updated");
    print(try std::fs::exists(io, source));
    try std::fs::rename(io, source, target);
    print(try std::fs::exists(io, source));
    var contents = try std::fs::read_file(
        io,
        allocator,
        target,
        std::mem::Limit::Unlimited
    );
    defer contents.deinit(allocator);
    let contents_bytes = contents.as_bytes();
    print(contents_bytes);
    try std::fs::remove_file(io, target);
    print(try std::fs::exists(io, target));
    try std::fs::remove_dir(io, scratch);

    return;
}

// run
// features: std-fs std-path explicit-io
// dir: .
// output:
// true
// 16
// false
// true
// true
// false
// updated
// false

