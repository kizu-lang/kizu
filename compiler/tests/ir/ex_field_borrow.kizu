//   %4: []u8 = field.name %3: User
//   %5: i64 = const 31
//   %6: User = field.set.age %3: User, %5: i64
//   call.print %4: []u8
//   %8: i64 = field.age %6: User
//   call.print %8: i64
//   return void: void
// }
