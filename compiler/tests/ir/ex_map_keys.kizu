import std::map;
import std::mem;

// Map.key_at(index) returns the key at one insertion position, or null past
// the end (ADR-0088: maps iterate in insertion order). The key is a view into
// map storage, so the capture holds the map share-borrowed while it is used.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let scores = map::new<[]u8, i64>(allocator);
    defer scores.deinit(allocator);
    try scores.insert(allocator, "one", 1);
    try scores.insert(allocator, "two", 2);
    try scores.insert(allocator, "three", 3);

    var index = 0;
    while scores.key_at(index) |key| {
        print(key);
        print(scores.get(key) orelse 0);
        index = index + 1;
    }
    return;
}

// run
// features: std map iterator optional view
// output:
// one
// 1
// two
// 2
// three
// 3

