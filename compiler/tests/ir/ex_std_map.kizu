import std::map;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let table = map::new<[]u8, i64>(allocator);
    defer table.deinit(allocator);
    let key = "main";

    try table.insert(allocator, key, 1);
    try table.insert(allocator, "count", 2);

    print(table.contains(key));
    print(key);
    print(table.get("main") orelse -1);
    print(table.len());

    return;
}

// run
// features: std-map allocator error-union optional orelse
// output:
// true
// main
// 1
// 2

