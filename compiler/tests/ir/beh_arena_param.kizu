import std::arena;
import std::mem;
import std::testing;

pub struct ParamItems {}
pub struct ViaItems {}
pub struct LinkNodes {}

pub struct Item {
    pub score: i64,
}

fn (self: &Item) doubled() -> i64 {
    return self.score * 2;
}

fn read_score<M>(items: &arena::Arena<Item, M>, h: arena::Handle<Item, M>) -> i64 {
    return items.at(h).score;
}

fn find<M>(items: &arena::Arena<Item, M>, h: arena::Handle<Item, M>) -> &Item {
    return items.at(h);
}

fn bump_score<M>(items: &var arena::Arena<Item, M>, h: arena::Handle<Item, M>) -> void {
    if items.at_mut(h) |item| {
        item.score = item.score + 1;
    }
}

// An arena handed to a helper as a borrow keeps its handles usable: the
// callee cannot see where either was made, so the signature carries the
// contract and only known confusions are rejected. A handle is copy, so
// the same handle feeds each call without being handed back.
test "a borrowed arena parameter accepts its caller's handle" {
    let allocator = mem::page_allocator();
    var items = arena::new<Item, ParamItems>(allocator);
    defer items.deinit(allocator);
    let h = try items.add(allocator, Item { score: 41 });
    let item = find<ParamItems>(&items, h);
    testing::expect_equal<i64>(41, item.score);
    testing::expect_equal<i64>(82, items.at(h).doubled());
    bump_score<ParamItems>(items, h);
    testing::expect_equal<i64>(42, read_score<ParamItems>(&items, h));
}

fn read_via<M>(items: &arena::Arena<Item, M>, h: arena::Handle<Item, M>) -> i64 {
    return read_score<M>(items, h);
}

// A forwarding helper carries the marker through: its inner call names the
// same static parameter, so the arena and the handle stay the one arena's at
// every hop (ADR-0134).
test "a forwarding helper chains the arena/handle contract" {
    let allocator = mem::page_allocator();
    var items = arena::new<Item, ViaItems>(allocator);
    defer items.deinit(allocator);
    let h = try items.add(allocator, Item { score: 7 });
    testing::expect_equal<i64>(7, read_via<ViaItems>(&items, h));
}

pub struct LinkNode {
    pub value: i64,
    pub next: ?arena::Handle<LinkNode, LinkNodes>,
}

// A handle read out of an optional field has no visible origin, so a local
// arena accepts it the same way a borrowed one does.
test "a local arena accepts handles read out of fields" {
    let allocator = mem::page_allocator();
    let nodes = arena::new<LinkNode, LinkNodes>(allocator);
    defer nodes.deinit(allocator);
    let tail = try nodes.add(allocator, LinkNode { value: 2, next: null });
    let head = try nodes.add(allocator, LinkNode { value: 40, next: tail });
    var total = nodes.at(head).value;
    if nodes.at(head).next |n| {
        total = total + nodes.at(n).value;
    }
    testing::expect_equal<i64>(42, total);
}

