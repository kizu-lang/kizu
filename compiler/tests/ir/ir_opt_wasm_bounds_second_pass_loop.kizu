import std::array;
import std::mem;

fn case0(a: &var array::Array<i64>) -> !i64 {
    var i = 0;
    while i < a.len() {
        a.set(i, 1) catch return -7;
        a.set(i, 2) catch return -7;
        i = i + 1;
    }
    var s = 0;
    s = s + a.get_or_panic(0);
    s = s + a.get_or_panic(0);
    return s;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var a = array::new<i64>(allocator);
    defer a.deinit(allocator);
    try a.append(allocator, 10);
    print(try case0(&var a));
    return;
}


