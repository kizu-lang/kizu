import std::arena;
import std::mem;
import std::string;

struct Resource {
    name: string::String,
}

fn (self: Resource) deinit(allocator: Allocator) -> void {
    let name = self.name.as_bytes();
    print(name);
    self.name.deinit(allocator);
    return;
}

fn show(resource: &Resource) -> void {
    let name = resource.name.as_bytes();
    print(name);
}

fn owned_text(allocator: Allocator, bytes: []u8) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes(allocator, bytes);
    return move text;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let name = try owned_text(allocator, "released");
    let resources = arena::new<Resource>(allocator);
    defer resources.deinit(allocator);
    let resource = resources.add(allocator, Resource {
        name: move name
    });
    show(resources.at(resource));
    return;
}

// run
// features: arena owner-element deinit std-string
// output:
// released
// released

