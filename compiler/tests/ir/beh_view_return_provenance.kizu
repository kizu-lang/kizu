import std::testing;

// ADR-0098: a view return is tied to every view argument, derived from the
// signature alone. The body may return any of them; the caller treats the
// result as borrowing all of them.

fn pick(a: []u8, b: []u8, take_first: bool) -> []u8 {
    if take_first {
        return a;
    }
    return b;
}

fn larger(left: &i64, right: &i64) -> &i64 {
    if left.* >= right.* {
        return left;
    }
    return right;
}

test "multi-source borrow return picks either slice source" {
    testing::expect_equal<[]u8>(pick("left", "right", true), "left");
    testing::expect_equal<[]u8>(pick("left", "right", false), "right");
}

test "multi-source borrow return of shared references" {
    var small = 1;
    var large = 2;
    let winner = larger(small, large);
    testing::expect(winner.* == 2);
}

