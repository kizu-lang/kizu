/// test invariant
unsafe struct Buf { data: ptr<u8>, len: usize }
fn steal(b: &Buf) -> ptr<u8> {
    return b.data;
}
fn size(b: &Buf) -> usize {
    return b.len;
}
fn shrink(b: &var Buf, n: usize) -> void {
    // SAFETY: test source
    unsafe b.len = n;
}
fn wrap(p: ptr<u8>) -> Buf {
    // SAFETY: test source
    return unsafe Buf { data: p, len: 0 };
}
fn main() {}

