// A view return is tied to every view argument by the signature alone
// (ADR-0098), so the caller keeps both alive while the result lives.
fn pick(a: []u8, b: []u8, take_first: bool) -> []u8 {
    if take_first {
        return a;
    }
    return b;
}

fn main() -> !void {
    print(pick("left", "right", true));
    print(pick("left", "right", false));
    return;
}

// run
// features: borrow-provenance structural
// output:
// left
// right

