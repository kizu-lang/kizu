import std::json;
import std::mem;
import std::string;

pub struct Visit {
    pub user: string::String,
    pub count: i64,
    pub active: bool,
}

// decode reads the bytes straight into the type. The keys may arrive in any
// order, and every public field has to be named: a document that does not
// describe a `Visit` is an error rather than a value with holes in it.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"count": 12, "active": true, "user": "alice"}
    ;
    var visit = try json::decode<Visit>(allocator, document);
    defer visit.deinit(allocator);
    print(visit.user.len());
    print(visit.count);
    print(visit.active);

    // The document this produces is one that produced it: encode and decode
    // read the same set of types.
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Visit>(allocator, &visit, &var out);
    let text = out.as_bytes();
    print(text);
    return;
}

// run
// features: std-json decode encode comptime construct reflection std-string
// output:
// 5
// 12
// true
// {"user":"alice","count":12,"active":true}

