import std::fmt;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit();

    try fmt::append_i64(text, 0);
    try text.append_byte(cast<u8>(32));
    try fmt::append_i64(text, (0 - 9223372036854775807) - 1);
    try text.append_byte(cast<u8>(32));
    try fmt::append_i64(text, 42);
    try text.append_byte(cast<u8>(32));
    try fmt::append_bool(text, true);
    try text.append_byte(cast<u8>(32));
    try fmt::append_bool(text, false);
    try text.append_byte(cast<u8>(32));
    try fmt::append_bytes_literal(text, "token");
    try text.append_byte(cast<u8>(32));
    try fmt::append_bytes_literal(text, "a\b");

    let bytes = text.as_bytes();
    print(bytes);
    return;
}

