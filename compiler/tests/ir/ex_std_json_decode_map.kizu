import std::json;
import std::map;
import std::mem;
import std::string;

pub struct Report {
    pub counts: map::Map<[]u8, i64>,
    pub total: mem::Box<i64>,
}

// A map reads a JSON object whose keys are the map's own keys, and a box reads
// the value it holds. Both are the types `encode` already wrote, so a document
// encode produced is one decode reads back.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"counts": {"alice": 2, "bob": 1, "c\u0061rol": 4}, "total": 7}
    ;
    var report = try json::decode<Report>(allocator, document);
    defer report.deinit(allocator);

    // The keys come back in document order, and an escaped key is unescaped on
    // the way in rather than kept as it was spelled.
    var index = 0;
    while report.counts.key_at(index) |key| {
        print(key);
        index = index + 1;
    }
    let total = report.total.borrow();
    print(total.*);

    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Report>(allocator, &report, &var out);
    let written = out.as_bytes();
    print(written);
    return;
}

// run
// features: std-json decode encode std-map std-mem box map std-string
// output:
// alice
// bob
// carol
// 7
// {"counts":{"alice":2,"bob":1,"carol":4},"total":7}

