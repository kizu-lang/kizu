import std;
union Node {
    Left(std::string::String),
    Right(std::array::Array<i64>),
}
fn (self: Node) deinit(allocator: Allocator) -> void {
    match self {
        Left(s) => s.deinit(allocator),
        Right(a) => a.deinit(allocator),
    }
}
fn drop_node(allocator: Allocator, n: Node) -> void {
    match n {
        Left(s) => s.deinit(allocator),
        Right(a) => a.deinit(allocator),
    }
}


