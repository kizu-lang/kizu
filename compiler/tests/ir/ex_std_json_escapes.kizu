import std::json;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();

    // The bytes a JSON string has to escape: quote, backslash, newline, tab,
    // and two more control bytes with no short escape of their own.
    var raw = string::new(allocator);
    defer raw.deinit(allocator);
    try raw.append_byte(cast<u8>(34));
    try raw.append_byte(cast<u8>(92));
    try raw.append_byte(cast<u8>(10));
    try raw.append_byte(cast<u8>(9));
    try raw.append_byte(cast<u8>(1));
    try raw.append_byte(cast<u8>(31));
    let raw_bytes = raw.as_bytes();

    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);
    try encoder.write_bytes(raw_bytes);

    var out = string::new(allocator);
    defer out.deinit(allocator);
    try encoder.finish_into(out);
    let bytes = out.as_bytes();
    print(bytes);
    return;
}

