import std::fmt;
import std::mem;
import std::string;

pub struct User {
    pub id: i64,
    pub active: bool,
}

// describe walks a struct's public fields at compile time. The body is
// expanded once per field, so `f` names a different field -- and a different
// field type -- in each expansion. This is not a macro: each expansion is
// ordinary Kizu code, type checked with that field's type in hand.
fn describe<T>(out: &var string::String, value: &T) -> !void {
    comptime for std::meta::public_fields<T>() |f| {
        try out.append_bytes(std::meta::field_name<T, f>());
        try out.append_bytes("=");
        try append_scalar<std::meta::field_type<T, f>>(out, std::meta::field<T, f>(value));
        try out.append_bytes(";");
    }
    return;
}

fn append_scalar<T>(out: &var string::String, value: &T) -> !void {
    comptime if T == type<i64> {
        try fmt::append_i64(out, value.*);
    } else {
        try fmt::append_bool(out, value.*);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit();

    let user = User { id: 7, active: true };
    try describe<User>(text, user);

    let bytes = text.as_bytes();
    print(bytes);
    return;
}

// run
// features: comptime comptime-for std-meta reflection generics
// output:
// id=7;active=true;


