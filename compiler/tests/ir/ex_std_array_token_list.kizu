import std::array;
import std::mem;

enum TokenKind {
    Ident,
    Number,
    Eof,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let tokens = array::new<TokenKind>(allocator);
    defer tokens.deinit();

    try tokens.append(TokenKind::Ident);
    try tokens.append(TokenKind::Number);

    print(tokens.len());
    print(tokens.get(0) orelse TokenKind::Eof);
    print(tokens.get(1) orelse TokenKind::Eof);

    return;
}

// run
// features: std-array token-list enum
// output:
// 2
// TokenKind::Ident
// TokenKind::Number


