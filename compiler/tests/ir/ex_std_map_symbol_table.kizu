import std::map;
import std::mem;

enum SymbolKind {
    Function,
    Variable,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let symbols = map::new<[]u8, SymbolKind>(allocator);
    defer symbols.deinit(allocator);

    try symbols.insert(allocator, "main", SymbolKind::Function);
    try symbols.insert(allocator, "count", SymbolKind::Variable);

    print(symbols.get("main") orelse SymbolKind::Variable);
    print(symbols.contains("missing"));

    return;
}

// run
// features: std-map symbol-table enum
// output:
// SymbolKind::Function
// false

