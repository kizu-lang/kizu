fn main() -> void {
    var total = 0;
    for 0..5 |i| {
        total = total + i;
    }
    print(total);

    var kept = 0;
    for 0..6 |i| {
        if i == 2 {
            continue;
        }
        if i == 5 {
            break;
        }
        kept = kept + i;
    }
    print(kept);

    var cells = 0;
    for 0..3 |row| {
        for 0..4 |column| {
            cells = cells + 1;
        }
    }
    print(cells);

    var rows = 0;
    outer: for 0..3 |row| {
        for 0..3 |column| {
            if column == 1 {
                continue :outer;
            }
            rows = rows + 1;
        }
        rows = rows + 100;
    }
    print(rows);
}

