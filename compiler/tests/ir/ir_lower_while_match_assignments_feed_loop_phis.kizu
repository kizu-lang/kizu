enum Step {
    Advance,
    Stop,
}

fn main() {
    var current = 0;
    let step = Step::Advance;
    while current < 2 {
        match step {
            Advance => current = current + 1;,
            Stop => current = 2;,
        }
    }
    print(current);
}

