error FsError {
    NotFound,
    Denied,
}

fn read(ok: bool) -> FsError!i64 {
    if ok {
        return 7;
    }
    return FsError::NotFound;
}

fn describe(failure: FsError) -> []u8 {
    return match failure {
        NotFound => "not found",
        Denied => "denied",
    };
}

fn main() -> FsError!void {
    print(try read(true));
    print(describe(FsError::NotFound));
    print(describe(FsError::Denied));
    return;
}

