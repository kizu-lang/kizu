import std::mem;
import std::testing;

test "multiline literal keeps empty lines at every position" {
    let leading =
        \\
        \\
        \\// parse
        \\
    ;
    // Each `\\` line is one segment; empty segments are empty lines, also at
    // the start and end of the literal.
    testing::expect_equal<i64>(11, mem::len(leading));
    testing::expect(!mem::starts_with(leading, "// parse"));
    let middle =
        \\Usage: kizu <command>
        \\
        \\Commands:
    ;
    testing::expect_equal<i64>(32, mem::len(middle));
}


