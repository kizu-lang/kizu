//   %3: std::json::DecodeError!Visit = call.std::json::decode.Visit %1: Allocator, %2: []u8
//   %4: Visit = error.try %3: std::json::DecodeError!Visit
//   %5: &var Visit = local.slot %4: Visit
//   %6: &var std::string::String = field.addr.user %5: &var Visit
//   %7: []u8 = call.std::string::String.as_bytes %6: &var std::string::String
//   call.print %7: []u8
//   %9: i64 = field.ref.count %5: &var Visit
//   call.print %9: i64
//   %11: Visit = ref.load %5: &var Visit
//   call.Visit.deinit %11: Visit, %1: Allocator
//   %13: !void = error.ok
//   return %13: !void
// }
