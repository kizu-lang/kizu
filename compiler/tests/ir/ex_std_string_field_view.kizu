import std::json;
import std::mem;
import std::string;

pub struct Visit {
    pub user: string::String,
    pub count: i64,
}

// A `String` reached through a field lends its bytes the way any other field
// path is borrowed (ADR-0111): the borrow is tracked on `visit` under the path
// `user`, so it is the struct that cannot move while the view is alive, and a
// disjoint field stays writable.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"user": "alice", "count": 3}
    ;
    var visit = try json::decode<Visit>(allocator, document);
    defer visit.deinit(allocator);

    let name = visit.user.as_bytes();
    print(name);
    print(visit.count);
    return;
}

// run
// features: borrow field-path std-string std-json view
// output:
// alice
// 3

