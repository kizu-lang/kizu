enum Sign {
    Neg,
    Zero,
    Pos,
}

fn sign(n: i64) -> Sign {
    return if n < 0 { Sign::Neg } else { if n == 0 { Sign::Zero } else { Sign::Pos } };
}

fn label(n: i64) -> []u8 {
    return if n < 0 {
        let negative = "negative";
        negative
    } else {
        if n == 0 { "zero" } else { "positive" }
    };
}

fn mixed(n: i64) -> []u8 {
    return match sign(n) {
        Neg => if n < -10 { "very negative" } else { "negative" },
        Zero => "zero",
        Pos => if n > 100 { "huge" } else { "positive" },
    };
}

fn main() -> void {
    print(label(-1));
    print(label(0));
    print(label(7));
    print(mixed(-50));
    print(mixed(0));
    print(mixed(500));
}

// run
// features: if match control-flow expression
// output:
// negative
// zero
// positive
// very negative
// zero
// huge

