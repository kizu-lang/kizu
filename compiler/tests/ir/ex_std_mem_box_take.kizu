import std::mem;
import std::string;

fn owned_text(allocator: Allocator, bytes: []u8) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes(allocator, bytes);
    return move text;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let boxed = try mem::box<string::String>(allocator,
        try owned_text(allocator, "payload")
    );
    let text = boxed.take(allocator);
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

