import std::array;
import std::mem;
import std::string;

fn append_part(
    allocator: Allocator,
    parts: &var array::Array<string::String>,
    bytes: []u8
) -> !void {
    let part = try string::from_bytes(allocator, bytes);
    errdefer part.deinit();
    try parts.append(move part);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var parts = array::new<string::String>(allocator);
    defer parts.deinit();
    try append_part(allocator, &var parts, "　first  text");
    try append_part(allocator, &var parts, "");
    try append_part(allocator, &var parts, " last　");

    var separator_storage = [1]u8{};
    let writable = separator_storage.as_mut_bytes();
    writable[0] = cast<u8>(10);
    let separator = separator_storage.as_bytes();
    var joined = try string::join(allocator, &parts, separator);
    defer joined.deinit();
    string::trim_space_in_place(&var joined);
    let text = joined.as_bytes();
    print(text);

    var empty = array::new<string::String>(allocator);
    defer empty.deinit();
    let empty_joined = try string::join(allocator, &empty, ",");
    defer empty_joined.deinit();
    print(empty_joined.len());
    return;
}

// run
// features: std-string join trim allocator ownership unicode
// output:
// first  text
//
//  last
// 0


