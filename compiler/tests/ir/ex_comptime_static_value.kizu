// A static value is a compile-time value inside the body it is given to:
// `comptime if` reads it, and each value is its own instance, so the branch
// not taken is neither checked nor lowered for that value.
fn tenfold_even<k: i64>() -> i64 {
    comptime if k % 2 == 0 {
        return k * 10;
    } else {
        return k;
    }
}

// A static value forwards to another generic by name, the way a type
// parameter does.
fn pair<a: i64, b: i64>() -> i64 {
    return tenfold_even<a>() + tenfold_even<b>();
}

fn choose<first: bool>(x: i64, y: i64) -> i64 {
    comptime if first {
        return x;
    }
    return y;
}

fn main() -> void {
    print(tenfold_even<4>());
    // An integer-range capture fills an integer static parameter, so a loop
    // unrolled at compile time instantiates one generic per step.
    comptime for 0..3 |a| {
        comptime for 1..3 |b| {
            print(pair<a, b>());
        }
    }
    print(choose<true>(1, 2));
    print(choose<false>(1, 2));
}

// run
// features: comptime comptime-for generics
// output:
// 40
// 1
// 20
// 2
// 21
// 21
// 40
// 1
// 2

