//   cond_fail %11: bool, bounds(%rot1.b.6: i64, %in1.1: i64)
//   %12: u32 = slice.index %words: []u32, %rot1.b.6: i64
//   %13: u32 = binary.+ %rot1.b.5: u32, %12: u32
//   jump for.step.3
// for.step.3:
//   %14: i64 = const 1
//   %15: i64 = binary.+ %rot1.b.6: i64, %14: i64
//   %rot1.l0.7: bool = binary.< %15: i64, %in1.1: i64
//   branch %rot1.l0.7: bool, for.body.2, for.end.4
