// An index whose range the arithmetic already fixes needs no check: a mask
// below a fixed array's length, a shifted and or-ed pair of bit fields, and a
// constant offset into a slice taken as `start..start + n`.

fn bucket(counts: &var [256]i64, key: u32) -> void {
    counts[cast<i64>(key & 0xff)] = counts[cast<i64>(key & 0xff)] + 1;
    return;
}

fn joined(table: &var [64]i64, high: u32, low: u32) -> i64 {
    let view = table.as_mut_slice();
    view[cast<i64>(low & 0x3f)] = cast<i64>(low);
    return view[cast<i64>((high >> 29) | ((low & 0x7) << 3))];
}

fn window(values: []i64, start: i64) -> i64 {
    let part = values[start..start + 4];
    return part[0] + part[3];
}

fn main() -> void {
    var counts = [256]i64{};
    bucket(&var counts, 513);
    bucket(&var counts, 1);
    print(counts[1]);
    var table = [64]i64{};
    print(joined(&var table, 3758096384, 63));
    var values = [6]i64{ 1, 2, 3, 4, 5, 6 };
    let view = values.as_mut_slice();
    print(window(view, 2));
}

