import std::json;
import std::mem;

pub struct Counts {
    pub visits: i64,
}

// A key the type has no field for is an error. Dropping it would lose data the
// document carried, so the caller says which it wants by the name it calls:
// `decode_ignore_unknown` is the one that drops them.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"visits": 3, "errors": 1}
    ;
    let counts = try json::decode<Counts>(allocator, document);
    print(counts.visits);
    return;
}

