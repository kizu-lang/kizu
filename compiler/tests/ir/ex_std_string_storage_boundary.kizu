import std::mem;
import std::string;
import std::testing;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit(allocator);

    testing::expect_equal<i64>(0, text.len());
    try text.reserve(allocator, 16);
    // The growth strategy is implementation-defined; reserve only promises
    // room for the request.
    testing::expect(text.capacity() >= 16);
    let reserved = text.capacity();

    try text.append_bytes(allocator, "lexer");
    try text.append_byte(allocator, cast<u8>(32));
    try text.append_bytes(allocator, "token");

    let full = text.as_bytes();
    print(full);

    try text.truncate(5);
    let prefix = text.as_bytes();
    print(prefix);

    text.clear();
    testing::expect_equal<i64>(0, text.len());
    // `clear` keeps the storage it already holds.
    testing::expect_equal<i64>(reserved, text.capacity());

    return;
}

// run
// features: std-string allocator borrow capacity deinit
// output:
// lexer token
// lexer

