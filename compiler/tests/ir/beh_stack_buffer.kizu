import std::mem;
import std::testing;

// ADR-0097: `[N]u8` is a zero-filled, local-only stack buffer. Views are the
// one way in, with the same rules as String's as_bytes / as_mut_bytes.

fn fill_greeting(buf: &var []u8) -> void {
    buf[0] = 104;
    buf[1] = 105;
    return;
}

test "stack buffer starts zero-filled" {
    var buf = [4]u8{};
    let read = buf.as_bytes();
    testing::expect_equal<i64>(4, mem::len(read));
    let byte = mem::byte_at(read, 0) orelse cast<u8>(255);
    testing::expect_equal<i64>(0, cast<i64>(byte));
}

test "stack buffer writes through the mutable view" {
    var buf = [8]u8{};
    let view = buf.as_mut_bytes();
    fill_greeting(view);
    let read = buf.as_bytes();
    testing::expect(mem::equal_bytes(read[0..2], "hi"));
}

