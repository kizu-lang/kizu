struct User {
    name: []u8,
}

fn inspect(user: &User) -> void {
    print(user.name);
}

fn take(user: User) -> void {
    print(user.name);
}

fn main() -> void {
    let user = User { name: "alice" };
    inspect(user);
    take(move user);
}

// run
// features: borrow last-use ownership move
// output:
// alice
// alice


