import std::map;
import std::mem;
import std::testing;

test "map accepts the empty key" {
    var values = map::new<[]u8, i64>(mem::page_allocator());
    defer values.deinit();
    // A module path outside any package is the empty string, and a map keyed
    // by paths has to hold it like any other key.
    try values.insert("", 1);
    try values.insert("a", 2);
    testing::expect(values.contains(""));
    testing::expect_equal<i64>(1, values.get("") orelse 0);
    testing::expect_equal<i64>(2, values.get("a") orelse 0);
    testing::expect_equal<i64>(2, values.len());
}


