import std;
struct Item { value: i64 }
fn read_it(x: &Item) -> i64 {
    return x.value;
}
fn main() {
    let allocator = std::mem::page_allocator();
    var xs = std::array::new<Item>(allocator);
    if xs.at(0) |r| {
        print(read_it(r));
    }
    if xs.at_mut(0) |m| {
        print(read_it(m));
    }
    xs.deinit();
}

