enum Color { Red, Green, Blue }
union Shape { Point, Circle(i64), Label([]u8), }
fn describe(shape: &Shape) -> void {
    match shape {
        Circle(radius) => print(radius);,
        _ => print("other");,
    }
}
fn main() -> void {
    let color = Color::Blue;
    let name = match color { Red => "red", _ => "other", };
    print(name);
    describe(Shape::Label("tag"));
}

