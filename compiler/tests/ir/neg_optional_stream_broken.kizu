import std::mem;

error ReadError {
    Broken,
}

struct Stream {
    pub bytes: []u8,
    pub index: i64,
    pub broken: bool,
}

fn (self: &var Stream) next() -> ReadError!?u8 {
    if self.broken {
        return ReadError::Broken;
    }
    if self.index >= mem::len(self.bytes) {
        return null;
    }
    let byte = self.bytes[self.index];
    self.index = self.index + 1;
    return byte;
}

fn main() -> !void {
    var s = Stream { bytes: "ab", index: 0, broken: true };
    let first = try s.next() orelse 0;
    print(first);
    return;
}

