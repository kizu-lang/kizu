import std;
error BuildError { Boom }
struct User { name: []u8 }
fn make() -> !std::arena::Arena<User> {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    errdefer users.deinit(allocator);
    return move users;
}
fn main() {}

