// fn test.string_trim_recognizes_the_fixed_Unicode_White_Space_set() -> !void {
// entry:
//   %1: Allocator = call.std::mem::page_allocator
//   %2: std::string::String = call.std::string::new %1: Allocator
//   %3: &var std::string::String = local.slot %2: std::string::String
//   %4: !void = call.append_white_space_set %3: &var std::string::String
//   %5: std::string::String = ref.load %3: &var std::string::String
//   error.try %4: !void, cleanup call.std::string::String.deinit %5: std::string::String, %1: Allocator
//   %7: []u8 = const "middle"
//   %8: std::mem::Error!void = call.std::string::String.append_bytes %3: &var std::string::String, %7: []u8
//   %9: std::string::String = ref.load %3: &var std::string::String
