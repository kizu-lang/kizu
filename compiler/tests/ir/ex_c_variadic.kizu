// A C variadic function is declared with `...` after its named parameters.
// A call passes the named arguments, then any number of further ones. Nothing
// declares a type for those, so each has the type its expression has by
// itself, and Kizu converts none of them: C would widen a `u8` or an `f32` on
// the way in, so a narrower value is widened with `cast` where it is passed.
extern "c" fn snprintf(buffer: ptr<u8>, size: usize, format: ptr<const u8>, ...) -> i32
extern "c" fn malloc(size: usize) -> ptr<u8>
extern "c" fn free(p: ptr<u8>) -> void
fn main() -> void {
    // SAFETY: 64 bytes are requested, and the block is freed below.
    let buffer = unsafe malloc(64);
    let count: i32 = 3;
    let grade: u8 = 65;
    // The format asks for an `int`, a `double`, a string and an `int`.
    // SAFETY: buffer holds 64 bytes, and the arguments match the format.
    let written = unsafe snprintf(
        buffer, 64, c"%d items, %.2f each, for %s (%c)", count, 1.5, c"alice", cast<i32>(grade)
    );
    // SAFETY: snprintf wrote that many bytes at the start of the block.
    let text = unsafe view_from_ptr(buffer, cast<i64>(written));
    print(text);
    // A call may pass no further argument at all.
    // SAFETY: buffer holds 64 bytes, and the format reads no argument.
    print(unsafe snprintf(buffer, 64, c"no arguments"));
    // SAFETY: buffer came from malloc above and is not used again.
    unsafe free(buffer);
    return;
}

// run
// features: extern-c raw-pointer unsafe cast
// output:
// 3 items, 1.50 each, for alice (A)
// 12

