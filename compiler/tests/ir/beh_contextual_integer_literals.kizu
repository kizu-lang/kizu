import std::array;
import std::map;
import std::mem;
import std::string;
import std::testing;

struct Byte {
    pub value: u8,
}

union ByteValue {
    Item(u8),
}

fn (self: &Byte) replace(next: u8) -> u8 {
    return next;
}

fn identity<T>(value: T) -> T {
    return value;
}

fn take_byte(value: u8) -> u8 {
    return value;
}

fn take_i32(value: i32) -> i32 {
    return value;
}

fn fallible_byte() -> !u8 {
    return 9;
}

test "contextual integer literals" {
    let allocator = mem::page_allocator();
    var bytes = array::new<u8>(allocator);
    defer bytes.deinit();
    try bytes.append(65);
    try bytes.set(0, 66);
    testing::expect_equal<i64>(66, cast<i64>(bytes.get_or_panic(0)));

    var text = string::new(allocator);
    defer text.deinit();
    try text.append_byte(67);
    testing::expect_equal<i64>(1, text.len());

    var table = map::new<[]u8, u8>(allocator);
    defer table.deinit();
    try table.insert("answer", 68);
    testing::expect_equal<i64>(68, cast<i64>(table.get("answer") orelse 0));

    let byte = Byte { value: 71 };
    testing::expect_equal<i64>(71, cast<i64>(byte.value));

    var mutable = Byte { value: 71 };
    mutable.value = 73;
    testing::expect_equal<i64>(73, cast<i64>(mutable.value));

    match ByteValue::Item(72) {
        Item(value) => testing::expect_equal<i64>(72, cast<i64>(value));,
    }

    testing::expect_equal<i64>(255, cast<i64>(take_byte(255)));
    testing::expect_equal<i64>(-1, cast<i64>(take_i32(-1)));
    testing::expect_equal<i64>(9, cast<i64>(try fallible_byte()));
    testing::expect_equal<i64>(74, cast<i64>(byte.replace(74)));
    testing::expect_equal<i64>(75, cast<i64>(identity<u8>(75)));
    testing::expect_equal<u8>(76, identity<u8>(76));

}


