import std::array;
import std::mem;
import std::testing;

pub struct Pair {
    pub left: i64,
    pub right: i64
}

test "array clone copies elements into independent storage" {
    let allocator = mem::page_allocator();
    var source = array::new<Pair>(allocator);
    defer source.deinit();
    try source.append(Pair { left: 10, right: 20 });
    try source.append(Pair { left: 30, right: 40 });
    let copied = try source.clone(allocator);
    defer copied.deinit();
    try source.set(0, Pair { left: 99, right: 99 });
    testing::expect_equal<i64>(2, copied.len());
    testing::expect_equal<i64>(10, copied.get_or_panic(0).left);
    testing::expect_equal<i64>(40, copied.get_or_panic(1).right);
}


