import std::fs;
import std::mem;
import std::testing;

fn main() -> !void {
    let io = testing::failing_io();
    let allocator = mem::page_allocator();
    let text = try fs::read_file(
        io, allocator, "examples/fixtures/config.txt", mem::Limit::Unlimited);
    defer text.deinit();
    let view = text.as_bytes();
    print(view);
    return;
}

// run-fails
// features: io fs error-union
// error: std::fs::Error::IoFailing


