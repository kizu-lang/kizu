import std::mem;

fn main() -> !void {
    let bytes = "  lexer token  ";
    print(mem::len(bytes));
    print(mem::equal_bytes("let", "let"));
    print(mem::starts_with("lexer", "lex"));

    let trimmed = mem::trim_ascii(bytes);
    print(trimmed);

    let prefix = mem::slice(trimmed, 0, 5) orelse "";
    print(prefix);

    let first = mem::byte_at(prefix, 0) orelse cast<u8>(0);
    print(cast<i64>(first));

    let missing = mem::byte_at(prefix, 99) orelse cast<u8>(0);
    print(cast<i64>(missing));
    return;
}

// run
// features: std-mem []u8 error-union optional orelse
// output:
// 15
// true
// true
// lexer token
// lexer
// 108
// 0

