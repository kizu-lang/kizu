import std::array;
import std::json;
import std::map;
import std::mem;
import std::string;
import std::testing;

pub struct Counts {
    pub visits: i64,
    pub errors: i64,
}

pub struct Profile {
    pub name: string::String,
    pub active: bool,
}

pub struct Wrapper {
    pub head: Profile,
    pub count: i64,
}

// The document names the fields in whatever order it likes: the object is
// scanned once into where each value begins, and every field comes back for
// the one it names.
test "json decode fills fields in any key order" {
    let allocator = mem::page_allocator();
    let document =
        \\{"errors": 2, "visits": 41}
    ;
    let counts = try json::decode<Counts>(allocator, document);
    testing::expect_equal<i64>(41, counts.visits);
    testing::expect_equal<i64>(2, counts.errors);
}

// A String field owns its bytes, and the escapes are undone on the way in.
test "json decode undoes string escapes" {
    let allocator = mem::page_allocator();
    let document =
        \\{"name": "a\tbAé", "active": true}
    ;
    var profile = try json::decode<Profile>(allocator, document);
    defer profile.deinit();
    testing::expect(profile.active);
    // a, TAB, b, A, and the two bytes é is in UTF-8.
    testing::expect_equal<i64>(6, profile.name.len());
}

// A surrogate pair names one code point, so the two escapes decode to the four
// bytes of that character rather than to two halves.
test "json decode joins a surrogate pair" {
    let allocator = mem::page_allocator();
    let document =
        \\{"name": "😀", "active": false}
    ;
    var profile = try json::decode<Profile>(allocator, document);
    defer profile.deinit();
    testing::expect_equal<i64>(4, profile.name.len());
}

test "json decode reads a nested struct" {
    let allocator = mem::page_allocator();
    let document =
        \\{"count": 7, "head": {"active": true, "name": "abc"}}
    ;
    var wrapper = try json::decode<Wrapper>(allocator, document);
    defer wrapper.deinit();
    testing::expect_equal<i64>(7, wrapper.count);
    testing::expect_equal<i64>(3, wrapper.head.name.len());
}

// decode and encode read the same set of types, so a value survives the round
// trip unchanged.
test "json decode round trips through encode" {
    let allocator = mem::page_allocator();
    let document =
        \\{"name":"alice","active":true}
    ;
    var profile = try json::decode<Profile>(allocator, document);
    defer profile.deinit();
    var out = string::new(allocator);
    defer out.deinit();
    try json::encode<Profile>(allocator, profile, out);
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>(document, bytes);
}

// decode_ignore_unknown is the spelling that drops the keys the type has no
// field for, at any depth.
test "json decode_ignore_unknown drops the keys the type lacks" {
    let allocator = mem::page_allocator();
    let document =
        \\{"visits": 1, "extra": [1, {"deep": 2}], "errors": 0}
    ;
    let counts = try json::decode_ignore_unknown<Counts>(allocator, document);
    testing::expect_equal<i64>(1, counts.visits);
    testing::expect_equal<i64>(0, counts.errors);
}

test "json decode reads a negative number" {
    let allocator = mem::page_allocator();
    let document =
        \\{"visits": -12, "errors": 0}
    ;
    let counts = try json::decode<Counts>(allocator, document);
    testing::expect_equal<i64>(-12, counts.visits);
}

// A Value is a document read without deciding its type first. It is an
// ordinary recursive union, so a walk over it is an ordinary match.
fn value_kind(value: &json::Value) -> []u8 {
    return match value {
        Null => "null",
        Bool(_) => "bool",
        I64(_) => "i64",
        Str(_) => "str",
        Arr(_) => "arr",
        Obj(_) => "obj",
    };
}

fn value_size(value: &json::Value) -> i64 {
    return match value {
        Null => 0,
        Bool(_) => 0,
        I64(number) => number,
        Str(text) => text.len(),
        Arr(items) => items.len(),
        Obj(entries) => entries.len(),
    };
}

// `Obj` is a map, so a key is found by name rather than by walking the whole
// object. The value is borrowed out: a `Value` owns its contents.
fn value_at_key(value: &json::Value, key: []u8) -> []u8 {
    match value {
        Obj(entries) => {
            if entries.at(key) |held| {
                return value_kind(held);
            }
            return "missing";
        },
        Null => return "null",
        Bool(_) => return "bool",
        I64(_) => return "i64",
        Str(_) => return "str",
        Arr(_) => return "arr",
    }
}

test "json decode finds a Value object member by key" {
    let allocator = mem::page_allocator();
    let document =
        \\{"user": "alice", "visits": [1, 2]}
    ;
    var value = try json::decode<json::Value>(allocator, document);
    defer value.deinit();
    testing::expect_equal<[]u8>("str", value_at_key(&value, "user"));
    testing::expect_equal<[]u8>("arr", value_at_key(&value, "visits"));
    testing::expect_equal<[]u8>("missing", value_at_key(&value, "absent"));
}

test "json decode reads a document as a Value" {
    let allocator = mem::page_allocator();
    let document =
        \\{"n": 1, "arr": [1, "two"], "z": null}
    ;
    var value = try json::decode<json::Value>(allocator, document);
    defer value.deinit();
    testing::expect_equal<[]u8>("obj", value_kind(value));
    testing::expect_equal<i64>(3, value_size(value));
}

test "json decode reads a scalar as a Value" {
    let allocator = mem::page_allocator();
    let document =
        \\42
    ;
    var value = try json::decode<json::Value>(allocator, document);
    defer value.deinit();
    testing::expect_equal<[]u8>("i64", value_kind(value));
    testing::expect_equal<i64>(42, value_size(value));
}

test "json decode reads an array of scalars" {
    let allocator = mem::page_allocator();
    let document =
        \\[1, 2, 3]
    ;
    var numbers = try json::decode<array::Array<i64>>(allocator, document);
    defer numbers.deinit();
    testing::expect_equal<i64>(3, numbers.len());
    testing::expect_equal<i64>(3, numbers.get_or_panic(2));
}

test "json decode reads an array of owners" {
    let allocator = mem::page_allocator();
    let document =
        \\["ab", "cde"]
    ;
    var names = try json::decode<array::Array<string::String>>(allocator, document);
    defer names.deinit();
    testing::expect_equal<i64>(2, names.len());
}

pub struct Row {
    pub cells: array::Array<i64>,
}

pub struct Grid {
    pub rows: array::Array<Row>,
}

test "json decode reads arrays nested in structs" {
    let allocator = mem::page_allocator();
    let document =
        \\{"rows": [{"cells": [1, 2]}, {"cells": [3]}]}
    ;
    var grid = try json::decode<Grid>(allocator, document);
    defer grid.deinit();
    testing::expect_equal<i64>(2, grid.rows.len());
}

pub enum Level {
    Low,
    High,
}

pub union Cell {
    Missing,
    Number(i64),
    Name(string::String),
}

fn (self: Cell) deinit() -> void {
    match self {
        Missing => return,
        Number(_) => return,
        Name(text) => text.deinit(),
    }
    return;
}

pub struct Record {
    pub level: Level,
    pub cell: Cell,
}

test "json decode reads an enum tag from a string" {
    let allocator = mem::page_allocator();
    let document =
        \\"High"
    ;
    let level = try json::decode<Level>(allocator, document);
    let read = match level {
        Low => 0,
        High => 1,
    };
    testing::expect_equal<i64>(1, read);
}

test "json decode reads a payload-free union variant from a string" {
    let allocator = mem::page_allocator();
    let document =
        \\"Missing"
    ;
    var cell = try json::decode<Cell>(allocator, document);
    defer cell.deinit();
    let read = match &cell {
        Missing => 0,
        Number(_) => 1,
        Name(_) => 2,
    };
    testing::expect_equal<i64>(0, read);
}

test "json decode reads a union payload from the object naming it" {
    let allocator = mem::page_allocator();
    let document =
        \\{"Name": "ab"}
    ;
    var cell = try json::decode<Cell>(allocator, document);
    defer cell.deinit();
    let read = match &cell {
        Missing => 0,
        Number(_) => 0,
        Name(text) => text.len(),
    };
    testing::expect_equal<i64>(2, read);
}

// A struct with sum cells comes back through the same walk that wrote it, so
// the round trip closes for every type `encode` accepts.
test "json decode reads sum cells of a struct" {
    let allocator = mem::page_allocator();
    let document =
        \\{"level": "Low", "cell": {"Number": 5}}
    ;
    var record = try json::decode<Record>(allocator, document);
    defer record.deinit();
    let level = match record.level {
        Low => 0,
        High => 1,
    };
    testing::expect_equal<i64>(0, level);
    let number = match &record.cell {
        Missing => 0,
        Number(value) => value,
        Name(_) => 0,
    };
    testing::expect_equal<i64>(5, number);
}

// key_order joins a map's keys in iteration order, so a test can assert the
// order itself rather than one key at a time.
fn key_order(
    allocator: Allocator,
    counts: &map::Map<[]u8, i64>,
) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit();
    var index = 0;
    while counts.key_at(index) |key| {
        try out.append_bytes(key);
        try out.append_byte(cast<u8>(44));
        index = index + 1;
    }
    return move out;
}

// A map reads an object whose keys are its own, so unlike a struct there is no
// field list to check them against and every key is one the map holds.
test "json decode reads an object into a map" {
    let allocator = mem::page_allocator();
    let document =
        \\{"alice": 2, "bob": 1}
    ;
    var counts = try json::decode<map::Map<[]u8, i64>>(allocator, document);
    defer counts.deinit();
    testing::expect_equal<i64>(2, counts.len());
    testing::expect_equal<i64>(2, counts.get("alice") orelse 0);
    testing::expect_equal<i64>(1, counts.get("bob") orelse 0);
    // The map keeps the document's order, so the keys come back in it.
    var order = try key_order(allocator, &counts);
    defer order.deinit();
    let joined = order.as_bytes();
    testing::expect_equal<[]u8>("alice,bob,", joined);
}

// The key is unescaped on the way in and copied into the map, so what the map
// holds is a key of its own rather than a view of the document.
test "json decode undoes escapes in a map key" {
    let allocator = mem::page_allocator();
    let document =
        \\{"c\u0061rol": 4}
    ;
    var counts = try json::decode<map::Map<[]u8, i64>>(allocator, document);
    defer counts.deinit();
    var order = try key_order(allocator, &counts);
    defer order.deinit();
    let joined = order.as_bytes();
    testing::expect_equal<[]u8>("carol,", joined);
    testing::expect_equal<i64>(4, counts.get("carol") orelse 0);
}

// An object whose values are strings is the common JSON shape, and it needs a
// map value that owns its bytes: what the string carries is not a run of the
// document once its escapes are gone (ADR-0123).
test "json decode reads an object of strings into a map" {
    let allocator = mem::page_allocator();
    let document =
        \\{"first": "alice", "last": "carol"}
    ;
    var names = try json::decode<map::Map<[]u8, string::String>>(allocator, document);
    defer names.deinit();
    testing::expect_equal<i64>(2, names.len());
    if names.at("first") |name| {
        let bytes = name.as_bytes();
        testing::expect_equal<[]u8>("alice", bytes);
    } else {
        testing::fail("first is missing");
    }

    // encode reads the same map through the value borrow, so the document
    // round trips without the map ever handing a value out by copy.
    let expected =
        \\{"first":"alice","last":"carol"}
    ;
    var out = string::new(allocator);
    defer out.deinit();
    try json::encode<map::Map<[]u8, string::String>>(allocator, names, out);
    let text = out.as_bytes();
    testing::expect_equal<[]u8>(expected, text);
}

test "json decode reads an object of objects into a map" {
    let allocator = mem::page_allocator();
    let document =
        \\{"alice": {"hit": 2}, "bob": {"hit": 1, "miss": 3}}
    ;
    var counts =
        try json::decode<map::Map<[]u8, map::Map<[]u8, i64>>>(allocator, document);
    defer counts.deinit();
    testing::expect_equal<i64>(2, counts.len());
    if counts.at("bob") |held| {
        testing::expect_equal<i64>(2, held.len());
        testing::expect_equal<i64>(3, held.get("miss") orelse 0);
    } else {
        testing::fail("bob is missing");
    }
}

// A box holds one value and adds no shape of its own, so what it reads is the
// value the document holds where the box sits.
test "json decode reads a box as the value it holds" {
    let allocator = mem::page_allocator();
    var total = try json::decode<mem::Box<i64>>(allocator, "7");
    defer total.deinit();
    let held = total.borrow();
    testing::expect_equal<i64>(7, held.*);
}

pub struct Report {
    pub counts: map::Map<[]u8, i64>,
    pub total: mem::Box<i64>,
}

// A map and a box nested in a struct come back through the same walk that wrote
// them, so the round trip closes for the containers too.
test "json decode round trips a map and a box through encode" {
    let allocator = mem::page_allocator();
    let document =
        \\{"counts": {"alice": 2, "bob": 1}, "total": 3}
    ;
    var report = try json::decode<Report>(allocator, document);
    defer report.deinit();
    var out = string::new(allocator);
    defer out.deinit();
    try json::encode<Report>(allocator, &report, &var out);
    let written = out.as_bytes();
    testing::expect_equal<[]u8>(
        \\{"counts":{"alice":2,"bob":1},"total":3}
    , written);
}

pub struct Visitor {
    pub name: string::String,
    pub nick: ?i64,
}

test "json decode reads an optional field that has a value" {
    let allocator = mem::page_allocator();
    let document =
        \\{"name": "alice", "nick": 7}
    ;
    var visitor = try json::decode<Visitor>(allocator, document);
    defer visitor.deinit();
    testing::expect_equal<i64>(7, visitor.nick orelse 0);
}

// `?T` cannot hold the difference between the two ways a document says there is
// no value, so both read as null (ADR-0121).
test "json decode reads a null optional field" {
    let allocator = mem::page_allocator();
    let document =
        \\{"name": "alice", "nick": null}
    ;
    var visitor = try json::decode<Visitor>(allocator, document);
    defer visitor.deinit();
    testing::expect_equal<i64>(-1, visitor.nick orelse -1);
}

test "json decode reads an omitted optional field as null" {
    let allocator = mem::page_allocator();
    let document =
        \\{"name": "alice"}
    ;
    var visitor = try json::decode<Visitor>(allocator, document);
    defer visitor.deinit();
    testing::expect_equal<i64>(-1, visitor.nick orelse -1);
    testing::expect_equal<i64>(5, visitor.name.len());
}

pub struct Page {
    pub head: Visitor,
    pub count: i64,
}

// The rule is the field's, not the top level's: a nested struct may leave its
// own optional out.
pub struct Named {
    pub name: string::String,
    pub nick: ?string::String,
}

fn (self: Named) deinit() -> void {
    self.name.deinit();
    if self.nick |held| {
        held.deinit();
    }
    return;
}

fn expect_nick(value: &Named, expected: []u8) -> void {
    if value.nick |held| {
        let bytes = held.as_bytes();
        testing::expect_equal<[]u8>(expected, bytes);
    } else {
        testing::expect_equal<[]u8>(expected, "none");
    }
    return;
}

// An optional field whose value owns its bytes: the three document shapes read
// the same way a `?i64` field does, and the string is released with the struct.
test "json decode reads an optional string field" {
    let allocator = mem::page_allocator();

    var given = try json::decode<Named>(allocator, \\{"name": "alice", "nick": "al"}
    );
    defer given.deinit();
    expect_nick(&given, "al");

    var written = try json::decode<Named>(allocator, \\{"name": "alice", "nick": null}
    );
    defer written.deinit();
    expect_nick(&written, "none");

    var omitted = try json::decode<Named>(allocator, \\{"name": "alice"}
    );
    defer omitted.deinit();
    expect_nick(&omitted, "none");

    let expected =
        \\{"name":"alice","nick":"al"}
    ;
    var out = string::new(allocator);
    defer out.deinit();
    try json::encode<Named>(allocator, given, out);
    let text = out.as_bytes();
    testing::expect_equal<[]u8>(expected, text);
}

test "json decode reads an omitted optional field of a nested struct" {
    let allocator = mem::page_allocator();
    let document =
        \\{"count": 2, "head": {"name": "alice"}}
    ;
    var page = try json::decode<Page>(allocator, document);
    defer page.deinit();
    testing::expect_equal<i64>(2, page.count);
    testing::expect_equal<i64>(-1, page.head.nick orelse -1);
}


