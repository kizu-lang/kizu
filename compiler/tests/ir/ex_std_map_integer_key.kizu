import std::map;
import std::mem;

// A Map key may be `[]u8` or an integer type. The runtime hashes and compares
// a key as the bytes it occupies either way, so an i64 key is its own eight
// bytes and needs no encoding step to become one.
fn count_visit(visits: &var map::Map<i64, i64>, id: i64) -> mem::Error!void {
    if visits.at_mut(id) |count| {
        count.* = count.* + 1;
        return;
    }
    return visits.insert(id, 1);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var visits = map::new<i64, i64>(allocator);
    defer visits.deinit();

    try count_visit(&var visits, 101);
    try count_visit(&var visits, 205);
    try count_visit(&var visits, 101);
    try count_visit(&var visits, 377);
    try count_visit(&var visits, 205);
    try count_visit(&var visits, 101);

    // key_at walks the keys in insertion order, and an integer key leaves the
    // capture as a value rather than as a view into map storage.
    var position = 0;
    while visits.key_at(position) |id| {
        print(id);
        print(visits.get(id) orelse 0);
        position = position + 1;
    }
    return;
}

// run
// features: std-map integer-key optional capture
// output:
// 101
// 3
// 205
// 2
// 377
// 1


