import std;
struct Counts { pub visits: i64, pub n: i64 }
fn width<T, f: Field>(base: i64) -> !std::meta::field_type<T, f> {
    return base + std::mem::len(std::meta::field_name<T, f>());
}
fn main() -> !void {
    let c = try std::meta::construct<Counts, width>(100);
    print(c.visits);
    print(c.n);
    return;
}

