import std::testing;

extern "c" fn malloc(size: usize) -> ptr<u8>
extern "c" fn free(p: ptr<u8>) -> void

test "ptr_read and ptr_write round-trip a byte" {
    // SAFETY: 1 バイト書ける領域を確保する。試験専用で失敗は考えない
    let byte = unsafe malloc(1);
    // SAFETY: byte は 1 バイト書ける有効な pointer である
    unsafe ptr_write(byte, 200);
    // SAFETY: byte は直前に書いた 1 バイトを指す
    let read = unsafe ptr_read(byte);
    testing::expect_equal<i64>(200, cast<i64>(read));
    // SAFETY: byte は malloc が返した領域で、以後使わない
    unsafe free(byte);
}

test "volatile_read and volatile_write round-trip a byte" {
    // SAFETY: 1 バイト書ける領域を確保する。試験専用で失敗は考えない
    let byte = unsafe malloc(1);
    // SAFETY: byte は 1 バイト書ける有効な pointer である
    unsafe volatile_write(byte, 3);
    // SAFETY: byte は直前に書いた 1 バイトを指す
    let read = unsafe volatile_read(byte);
    testing::expect_equal<i64>(3, cast<i64>(read));
    // SAFETY: byte は malloc が返した領域で、以後使わない
    unsafe free(byte);
}

test "pointer integer casts preserve the address" {
    // SAFETY: 1 バイト書ける領域を確保する。試験専用で失敗は考えない
    let byte = unsafe malloc(1);
    // SAFETY: address の整数化は観測のみで、pointer 自体は使い続けない
    let address = unsafe int_from_ptr<usize>(byte);
    // SAFETY: address は直前に有効な pointer から得た値で、指す先は生きている
    let same = unsafe ptr_from_int<ptr<u8>>(address);
    // SAFETY: same は byte と同じ有効な 1 バイトを指す
    unsafe ptr_write(same, 7);
    // SAFETY: byte は直前に書いた 1 バイトを指す
    let read = unsafe ptr_read(byte);
    testing::expect_equal<i64>(7, cast<i64>(read));
    // SAFETY: byte は malloc が返した領域で、以後使わない
    unsafe free(byte);
}

