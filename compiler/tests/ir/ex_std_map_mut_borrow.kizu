import std::map;
import std::mem;

fn define(symbols: &var map::Map<[]u8, i64>) -> !void {
    try symbols.insert("main", 1);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var symbols = map::new<[]u8, i64>(allocator);
    defer symbols.deinit();

    try define(symbols);
    print(symbols.get("main") orelse -1);

    return;
}

