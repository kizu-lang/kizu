import std::mem;

pub struct Score {
    pub value: i64,
}

// A fixed buffer too small for one Box cell makes the allocation failure
// deterministic: box reports OutOfMemory as a recoverable error value, and
// propagating it out of main is what a runtime error report looks like.
fn main() -> !void {
    var buf = [16]u8{};
    let scratch = buf.as_mut_bytes();
    let small = mem::fixed_buffer(scratch);
    let boxed = try mem::box<Score>(small, Score { value: 1 });
    boxed.deinit(small);
    return;
}

