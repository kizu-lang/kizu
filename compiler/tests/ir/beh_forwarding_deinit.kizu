import std::mem;
import std::string;
import std::testing;

// ADR-0094: forwarding deinit bodies are hand-written. The completeness check
// (ADR-0091) rejects a body that misses an owner field or payload.

struct Pair {
    pub first: string::String,
    pub second: string::String,
    pub count: i64,
}

union Slot {
    Kept(string::String),
    Vacant,
}

fn (self: Slot) deinit() -> void {
    match self {
        Kept(name) => name.deinit(),
        Vacant => return,
    }
}

fn make_pair(allocator: Allocator) -> !Pair {
    var first = string::new(allocator);
    errdefer first.deinit();
    try first.append_bytes("left");
    var second = string::new(allocator);
    errdefer second.deinit();
    try second.append_bytes("right");
    return Pair { first: move first, second: move second, count: 2 };
}

test "forwarding deinit consumes struct owners" {
    let allocator = mem::page_allocator();
    var pair = try make_pair(allocator);
    defer pair.deinit();
    testing::expect_equal<i64>(2, pair.count);
}

test "forwarding deinit dispatches union payloads" {
    let allocator = mem::page_allocator();
    var kept = string::new(allocator);
    errdefer kept.deinit();
    try kept.append_bytes("held");
    let slot = Slot::Kept(move kept);
    slot.deinit();

    let vacant = Slot::Vacant;
    vacant.deinit();
}


