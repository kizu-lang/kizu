import std::array;
import std::map;
import std::mem;
import std::string;
import std::testing;

// ADR-0091: an owner-element container is closed at compile time. Its one
// cleanup is `deinit()`, which consumes every remaining element before
// releasing the buffer; shallow `deinit()` is a type error there.

struct Bag {
    pub names: array::Array<string::String>,
    pub count: i64,
}

fn make_name(allocator: Allocator, text: []u8) -> !string::String {
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_bytes(allocator, text);
    return move name;
}

fn make_bag(allocator: Allocator) -> !Bag {
    let names = array::new<string::String>(allocator);
    errdefer names.deinit(allocator);
    try names.append(allocator, try make_name(allocator, "alice"));
    return Bag { names: move names, count: 1 };
}

test "deinit consumes remaining owner elements" {
    let allocator = mem::page_allocator();
    let names = array::new<string::String>(allocator);
    defer names.deinit(allocator);
    try names.append(allocator, try make_name(allocator, "alice"));
    try names.append(allocator, try make_name(allocator, "bob"));
    testing::expect_equal<i64>(2, names.len());
}

test "pop before deinit consumes elements one by one" {
    let allocator = mem::page_allocator();
    let names = array::new<string::String>(allocator);
    defer names.deinit(allocator);
    try names.append(allocator, try make_name(allocator, "carol"));
    let taken = names.pop_or_panic();
    taken.deinit(allocator);
    testing::expect_equal<i64>(0, names.len());
}

fn make_table(allocator: Allocator) -> !map::Map<[]u8, i64> {
    let table = map::new<[]u8, i64>(allocator);
    errdefer table.deinit(allocator);
    try table.insert(allocator, "seen", 1);
    return move table;
}

test "deinit cleans owner containers as elements" {
    let allocator = mem::page_allocator();
    let maps = array::new<map::Map<[]u8, i64>>(allocator);
    defer maps.deinit(allocator);
    try maps.append(allocator, try make_table(allocator));
    testing::expect_equal<i64>(1, maps.len());
}

test "struct deinit forwards owner-element arrays to deinit" {
    let allocator = mem::page_allocator();
    let bag = try make_bag(allocator);
    defer bag.deinit(allocator);
    testing::expect_equal<i64>(1, bag.count);
}

