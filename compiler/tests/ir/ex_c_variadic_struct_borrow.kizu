//   %2: i32 = const 7
//   %3: Pair = struct.new {first: %1: i32, second: %2: i32}
//   %4: &var Pair = local.slot %3: Pair
//   %5: []u8 = const "42\x00"
//   %6: ptr<const u8> = slice.ptr %5: []u8
//   %7: []u8 = const "%d\x00"
//   %8: ptr<const u8> = slice.ptr %7: []u8
