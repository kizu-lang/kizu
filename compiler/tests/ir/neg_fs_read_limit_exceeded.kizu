import std;

// The fixture is 16 bytes; a 4-byte ceiling refuses the input. That is
// LimitExceeded, not OutOfMemory: memory was fine, the input broke the
// caller's declared budget.
fn main() -> !void {
    let io = std::io::blocking();
    let allocator = std::mem::page_allocator();
    let text = try std::fs::read_file(
        io, allocator, "examples/fixtures/config.txt", std::mem::Limit::Bytes(4));
    defer text.deinit(allocator);
    let view = text.as_bytes();
    print(view);
    return;
}

// run-fails
// features: io fs error-union limit
// error: std::fs::Error::LimitExceeded

