//   %15: std::array::Array<i64> = ref.load %12: &var std::array::Array<i64>
//   %16: Note = ref.load %10: &var Note
//   error.try %14: std::mem::Error!void, cleanup array.deinit %15: std::array::Array<i64>, %6: Allocator; call.Note.deinit %16: Note, %1: Allocator
