//   %5: []u8 = buffer.as_bytes %4: [512]u8
//   %6: Allocator = call.std::mem::fixed_buffer %5: []u8
//   %7: []u8 = const "kept"
//   %8: !Note = call.note %1: Allocator, %7: []u8
//   %9: Note = error.try %8: !Note
