// 確保も解放も allocator を名指します。値は自分を作った allocator の複製を
// 持たないので、`append` にも `deinit` にも必要なものは呼び出し側が綴ります
// (ADR-0132)。おかげで `Box<T>` の cell は payload だけ、`Array<T>` の header
// は `{data, len, cap}` の 3 word になり、pointer 2 本の節点が malloc の 1 つ上の
// size class に押し上げられることも、Array を持つ struct が 1 word 余分に払う
// こともなくなります。

import std::array;
import std::mem;
import std::string;

struct Note {
    title: string::String,
    tags: array::Array<i64>,
}

// owner field を持つ型の deinit は導出されます。導出された body も allocator を
// 受け取り、field へそのまま渡します —— 型ごとに引数が違わないので、
// `defer x.deinit(allocator)` の書き方は型を見ずに決まります。
fn note(allocator: Allocator, title: []u8) -> !Note {
    var name = try string::from_bytes(allocator, title);
    errdefer name.deinit(allocator);
    let tags = array::new<i64>(allocator);
    return Note {
        title: move name,
        tags: move tags
    };
}

fn main() -> !void {
    let heap = mem::page_allocator();
    var scratch_bytes = [512]u8{};
    let view = scratch_bytes.as_mut_bytes();
    // 同じ frame に 2 つの allocator があります。値ごとに、それを作った方を
    // 名指して伸ばし、名指して解放します。
    let scratch = mem::fixed_buffer(view);

    var kept = try note(heap, "kept");
    defer kept.deinit(heap);

    var temporary = array::new<i64>(scratch);
    defer temporary.deinit(scratch);

    try temporary.append(scratch, 7);
    print(temporary.get(0) orelse -1);
    print(kept.title.len());
    return;
}

// run
// features: allocator deinit derived-deinit fixed-buffer defer
// output:
// 7
// 4

// ir
// lower:
// fn note(%allocator: Allocator, %title: []u8) -> !Note {
// entry:
//   %1: std::mem::Error!std::string::String = call.std::string::from_bytes %allocator: Allocator, %title: []u8
//   %2: std::string::String = error.try %1: std::mem::Error!std::string::String
//   %3: &var std::string::String = local.slot %2: std::string::String
//   %4: std::array::Array<i64> = array.new %allocator: Allocator
//   %5: std::string::String = ref.load %3: &var std::string::String
//   %6: Note = struct.new {title: %5: std::string::String, tags: %4: std::array::Array<i64>}
//   %7: !Note = error.ok %6: Note
//   return %7: !Note
// }
// fn main() -> !void {
