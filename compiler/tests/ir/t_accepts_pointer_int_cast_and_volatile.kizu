fn main() {
    // SAFETY: test source
    let p = unsafe ptr_from_int<ptr<u32>>(0);
    // SAFETY: test source
    unsafe volatile_write(p, 1);
    // SAFETY: test source
    let value = unsafe volatile_read(p);
    print(value);}

