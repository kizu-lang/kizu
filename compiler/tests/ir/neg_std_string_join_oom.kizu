import std::array;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var parts = array::new<string::String>(allocator);
    defer parts.deinit(allocator);
    let first = try string::from_bytes(allocator, "compiler");
    errdefer first.deinit(allocator);
    try parts.append(move first);
    let second = try string::from_bytes(allocator, "frontend");
    errdefer second.deinit(allocator);
    try parts.append(move second);

    var storage = [8]u8{};
    let scratch = storage.as_mut_bytes();
    let limited = mem::fixed_buffer(scratch);
    let joined = try string::join(limited, &parts, "::");
    defer joined.deinit(limited);
    return;
}

// run-fails
// features: std-string join allocator fixed-buffer error-union
// error: std::array::Error::OutOfMemory


