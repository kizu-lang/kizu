fn sized<n: i64>() -> i64 {
    return n;
}

fn main() {
    let size = comptime 4 * 1024;
    comptime if 1 + 1 == 2 {
        print(sized<8>());
    } else {
        print(0);
    }

    print(size);
}

// run
// features: comptime
// output:
// 8
// 4096

// ir
// lower:
// fn main() -> void {
// entry:
//   %1: i64 = const 4
//   %2: i64 = const 1024
//   %3: i64 = binary.* %1: i64, %2: i64
//   %4: i64 = call.sized.8
//   call.std::fmt::print.i64 %4: i64
//   call.std::fmt::print.i64 %3: i64
//   return void: void
// }
// fn sized.8() -> i64 {
// entry:
//   %1: i64 = const 8
//   return %1: i64
// }
