import std;

test "std fs read dir" {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    // read_dir returns a deterministic order, and pinning one is the point of
    // this example. It reads a fixture directory it owns rather than a source
    // tree, so adding a file to the repository cannot break it.
    var entries = try std::fs::read_dir(io, allocator, "examples/fixtures/read_dir");
    defer entries.deinit(allocator);
    std::testing::expect(entries.len() == 3);

    if entries.at(0) |first| {
        let first_name = first.name.as_bytes();
        let first_path = first.path.as_bytes();
        std::testing::expect_equal<[]u8>("alpha.txt", first_name);
        std::testing::expect_equal<[]u8>(
            "examples/fixtures/read_dir/alpha.txt",
            first_path
        );
        std::testing::expect(!first.is_dir);
    } else {
        std::testing::fail("missing first directory entry");
    }

    if entries.at(1) |second| {
        let second_name = second.name.as_bytes();
        std::testing::expect_equal<[]u8>("beta.txt", second_name);
        std::testing::expect(!second.is_dir);
    } else {
        std::testing::fail("missing second directory entry");
    }

    // `nested` sorts after both files and is the corpus's only is_dir entry.
    if entries.at(2) |third| {
        let third_name = third.name.as_bytes();
        std::testing::expect_equal<[]u8>("nested", third_name);
        std::testing::expect(third.is_dir);
    } else {
        std::testing::fail("missing third directory entry");
    }

}


