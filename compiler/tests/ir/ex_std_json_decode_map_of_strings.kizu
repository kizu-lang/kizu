import std::json;
import std::map;
import std::mem;
import std::string;

// An object whose values are strings is the shape a map has to hold to be
// useful for JSON, and it needs a map value that owns its bytes: the decoded
// string is not a run of the document once its escapes are gone.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"first": "alice", "last": "carol"}
    ;
    var names = try json::decode<map::Map<[]u8, string::String>>(allocator, document);
    defer names.deinit(allocator);

    var index = 0;
    while names.key_at(index) |key| {
        print(key);
        index = index + 1;
    }
    if names.at("last") |name| {
        let bytes = name.as_bytes();
        print(bytes);
    }

    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<map::Map<[]u8, string::String>>(allocator, &names, &var out);
    let text = out.as_bytes();
    print(text);
    return;
}

// run
// features: std-json decode encode std-map owner std-string
// output:
// first
// last
// carol
// {"first":"alice","last":"carol"}

