/// value は増やしても呼び出し側の不変条件を壊さない値でなければならない。
unsafe fn raw_increment(value: i64) -> i64 {
    return value + 1;
}

fn main() {
    // SAFETY: 1 は増やしても壊れるものが無い
    print(unsafe raw_increment(1));
}

// check
// features: unsafe caller-obligation


