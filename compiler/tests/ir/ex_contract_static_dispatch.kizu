struct File {
    name: []u8,
}

struct Buffer {
    label: []u8,
}

contract Writer {
    fn write(text: []u8) -> !i64;
}

fn (self: &File) write(text: []u8) -> !i64 {
    print(self.name);
    print(text);
    return 1;
}

impl Writer for File;

fn (self: &Buffer) write(text: []u8) -> !i64 {
    print(self.label);
    print(text);
    return 2;
}

impl Writer for Buffer;

fn (self: &File) rename(next: []u8) -> File {
    return File { name: next };
}

fn save<W>(writer: &W, text: []u8) -> !i64 {
    return try writer.write(text);
}

fn main() -> !void {
    print(try save<File>(File { name: "file" }, "hello"));
    print(try save<Buffer>(Buffer { label: "buffer" }, "bye"));
    let old = File { name: "old" };
    let renamed = old.rename("new");
    print(renamed.name);
    return;
}

// run
// features: contract impl generics
// output:
// file
// hello
// 1
// buffer
// bye
// 2
// new

