import std::testing;

extern "c" fn malloc(size: usize) -> ptr<u8>
extern "c" fn free(p: ptr<u8>) -> void

struct Node {
    pub tag: i64,
    pub count: i64,
}

fn read_tag(node: ptr<const Node>) -> i64 {
    // SAFETY: node が有効な Node を指すことは呼び出し側が保証する
    return unsafe node.*.tag;
}

fn read_count(node: ptr<const Node>) -> i64 {
    // SAFETY: node が有効な Node を指すことは呼び出し側が保証する
    return unsafe node.*.count;
}

fn write_tag(node: ptr<Node>, tag: i64) -> void {
    // SAFETY: node が有効な Node を指すことは呼び出し側が保証する
    unsafe node.*.tag = tag;
}

fn replace(node: ptr<Node>, value: Node) -> void {
    // SAFETY: node が有効な Node を指し、上書きしてよいことは呼び出し側が保証する
    unsafe node.* = value;
}

test "raw pointer struct deref reads and writes" {
    // SAFETY: Node が収まる十分な大きさを確保する。試験専用で失敗は考えない
    let raw = unsafe malloc(64);
    // SAFETY: raw は Node 1 個分の書き込み可能な領域を指す
    let node = unsafe cast<ptr<Node>>(raw);
    // SAFETY: pointer 間 cast は値の再解釈のみで、指す先は同じ有効な Node
    let reader = unsafe cast<ptr<const Node>>(node);

    replace(node, Node { tag: 7, count: 1 });
    testing::expect_equal<i64>(7, read_tag(reader));

    write_tag(node, 42);
    testing::expect_equal<i64>(42, read_tag(reader));
    testing::expect_equal<i64>(1, read_count(reader));

    // SAFETY: raw は malloc が返した領域で、以後使わない
    unsafe free(raw);
}

test "raw pointer whole deref stores a contextual byte" {
    // SAFETY: 1 バイト書ける領域を確保する。試験専用で失敗は考えない
    let byte = unsafe malloc(1);
    // SAFETY: byte は 1 バイト書ける有効な pointer である
    unsafe byte.* = 9;
    // SAFETY: byte は直前に書いた 1 バイトを指す
    let read = unsafe byte.*;
    testing::expect_equal<i64>(9, cast<i64>(read));
    // SAFETY: byte は malloc が返した領域で、以後使わない
    unsafe free(byte);
}

