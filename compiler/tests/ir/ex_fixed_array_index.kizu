// An element of a fixed-length array is read and written by index, wherever
// the array lies: a local, a field, a `&var` parameter. An index that is a
// literal is checked when the program is; any other one traps if it is out
// of range, as a view's does.
struct Cell {
    lengths: [3]f64,
    diag: [3]f64,
}

fn trace(values: [3]f64) -> f64 {
    return values[0] + values[1] + values[2];
}

fn fill(values: &var [3]f64, scale: f64) -> void {
    for 0..3 |i| {
        values[i] = scale * cast<f64>(i + 1);
    }
    return;
}

fn countdown() -> [4]i64 {
    var out = [4]i64{};
    for 0..4 |i| {
        out[i] = 4 - i;
    }
    return out;
}

fn main() -> void {
    var cell = Cell { lengths: [3]f64{}, diag: [3]f64{} };
    for 0..3 |i| {
        cell.diag[i] = cast<f64>(i) + 1.0;
        cell.lengths[i] = cell.diag[i] * 10.0;
    }
    print(trace(cell.diag));
    print(cell.lengths[2]);
    var values = [3]f64{};
    fill(&var values, 0.5);
    print(trace(values));
    let before = values;
    values[0] = 100.0;
    print(before[0]);
    print(countdown()[0]);
    return;
}

// run
// features: stack-buffer
// output:
// 6.0
// 30.0
// 3.0
// 0.5
// 4

