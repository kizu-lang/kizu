// A struct whose layout C decides is declared `extern "c" struct`. Its
// fields are the ones C can name and are visible wherever the struct is. A C
// function takes one as `&S` or `&var S`, which it receives as a pointer.
/// Wall-clock time as C's `struct timespec`.
extern "c" struct Timespec {
    seconds: i64,
    nanoseconds: i64,
}

extern "c" fn clock_gettime(clock: i32, out: &var Timespec) -> i32
extern "c" fn nanosleep(request: &Timespec, remaining: &var Timespec) -> i32
pub fn main() -> void {
    var now = Timespec { seconds: 0, nanoseconds: 0 };
    // SAFETY: clock 0 is CLOCK_REALTIME on every host, and `now` outlives the call.
    let status = unsafe clock_gettime(0, &var now);
    print(status == 0);
    print(now.seconds > 1600000000);
    print(now.nanoseconds >= 0);
    let pause = Timespec { seconds: 0, nanoseconds: 1 };
    var left = Timespec { seconds: 0, nanoseconds: 0 };
    // SAFETY: both structs outlive the call; C reads `pause` and may write `left`.
    let slept = unsafe nanosleep(&pause, &var left);
    print(slept == 0);
    return;
}

// run
// features: extern-c extern-struct unsafe
// output:
// true
// true
// true
// true

