import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = try string::from_bytes(allocator, "lexer");
    defer text.deinit(allocator);
    let source = "lexer";
    try text.reserve(32);
    // The growth strategy is implementation-defined; only this holds.
    print(text.capacity() >= 32);
    print(source);
    try text.append_byte(cast<u8>(32));
    try text.append_bytes("token");
    let bytes = text.as_bytes();
    print(bytes);
    print(text.len());
    text.clear();
    print(text.capacity() >= 32);
    try text.append_bytes("done");
    let final = text.as_bytes();
    print(final);
    return;
}

// run
// features: std-string allocator borrow capacity from-bytes
// output:
// true
// lexer
// lexer token
// 11
// true
// done

