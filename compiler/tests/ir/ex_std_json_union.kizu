import std::json;
import std::mem;
import std::string;

pub enum Role {
    Admin,
    Guest,
}

pub union Note {
    Empty,
    Count(i64),
    Text(string::String),
}

fn (self: Note) deinit() -> void {
    match self {
        Empty => return,
        Count(_) => return,
        Text(text) => text.deinit(),
    }
    return;
}

pub struct Account {
    pub name: string::String,
    pub role: Role,
    pub note: Note,
}

fn describe(note: &Note) -> []u8 {
    return match note {
        Empty => "empty",
        Count(_) => "count",
        Text(_) => "text",
    };
}

// `encode<T>` and `decode<T>` read a sum type the way they read a struct: the
// shape comes from the declaration, not from a hand-written pair of functions.
// A variant that carries nothing is the string naming it, and one that carries
// a payload is the single-key object naming it. An enum is the case where no
// variant carries anything, so `Role::Guest` is `"Guest"` and there is no rule
// for enums of its own.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    errdefer name.deinit();
    try name.append_bytes("alice");
    var account = Account {
        name: move name,
        role: Role::Guest,
        note: Note::Count(3),
    };
    defer account.deinit();

    var out = string::new(allocator);
    defer out.deinit();
    try json::encode<Account>(allocator, account, out);
    let written = out.as_bytes();
    print(written);

    var read = try json::decode<Account>(allocator, written);
    defer read.deinit();
    let read_name = read.name.as_bytes();
    print(read_name);
    print(describe(&read.note));
    return;
}

// run
// features: std-json std-meta comptime-match reflection union enum std-string
// output:
// {"name":"alice","role":"Guest","note":{"Count":3}}
// alice
// count


