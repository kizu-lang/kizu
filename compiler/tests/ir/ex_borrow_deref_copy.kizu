fn copy_value(value: &i64) -> i64 {
    return value.*;
}

fn main() -> void {
    let value = 7;
    print(copy_value(value));
    print(value);
}

// run
// features: borrow deref copy
// output:
// 7
// 7

// ir
// lower:
// fn copy_value(%value: i64) -> i64 {
// entry:
//   return %value: i64
// }
// fn main() -> void {
// entry:
//   %1: i64 = const 7
//   %2: i64 = call.copy_value %1: i64
//   call.std::fmt::print.i64 %2: i64
//   call.std::fmt::print.i64 %1: i64
//   return void: void
// }
// opt:
// fn copy_value(%value: i64) -> i64 {
// entry:
//   return %value: i64
// }
// fn main() -> void {
// entry:
//   %1: i64 = const 7
//   %2: i64 = call.copy_value %1: i64
