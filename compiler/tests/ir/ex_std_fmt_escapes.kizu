import std::fmt;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try fmt::append_bytes_literal(allocator, text,
        \\line
        \\	tab\slashéÿ
    );
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

