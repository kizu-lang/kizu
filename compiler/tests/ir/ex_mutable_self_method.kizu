struct Counter {
    count: i64,
}

// A `&var self` method receives the caller's storage, so the write lands in
// the caller's binding rather than in a copy.
fn (self: &var Counter) bump() -> void {
    self.count = self.count + 1;
    return;
}

fn (self: &var Counter) bump_twice() -> void {
    self.bump();
    self.bump();
    return;
}

fn (self: Counter) value() -> i64 {
    return self.count;
}

fn main() {
    var hits = Counter { count: 0 };
    hits.bump_twice();
    hits.bump();
    print(hits.value());
}

// run
// features: method receiver mutable-borrow struct
// output:
// 3


