// A C function may take and return an `extern "c" struct` by value. The call
// passes it the way the target's C calling convention does: in registers when
// it is small enough, through memory otherwise, as a C compiler would.
extern "c" struct Quotient {
    quot: i64,
    rem: i64,
}

/// C's `double complex`, which C lays out as two doubles.
extern "c" struct Complex {
    re: f64,
    im: f64,
}

extern "c" fn lldiv(numer: i64, denom: i64) -> Quotient
@link_library("m")
extern "c" fn cabs(value: Complex) -> f64
@link_library("m")
extern "c" fn csqrt(value: Complex) -> Complex
pub fn main() -> void {
    // SAFETY: lldiv divides by any nonzero denominator.
    let division = unsafe lldiv(17, 5);
    print(division.quot);
    print(division.rem);
    // SAFETY: cabs reads any complex value.
    print(unsafe cabs(Complex { re: 3.0, im: 4.0 }));
    // SAFETY: csqrt takes any complex value.
    let root = unsafe csqrt(Complex { re: -4.0, im: 0.0 });
    print(root.re);
    print(root.im);
    return;
}

// run
// features: extern-c extern-struct link-library unsafe
// output:
// 3
// 2
// 5.0
// 0.0
// 2.0

// ir
// lower:
// fn main() -> void {
// entry:
//   %1: i64 = const 17
//   %2: i64 = const 5
//   %3: Quotient = extern "c" call.lldiv %1: i64, %2: i64
//   %4: i64 = field.quot %3: Quotient
//   call.std::fmt::print.i64 %4: i64
//   %6: i64 = field.rem %3: Quotient
//   call.std::fmt::print.i64 %6: i64
//   %8: f64 = const 3.0
//   %9: f64 = const 4.0
//   %10: Complex = struct.new {re: %8: f64, im: %9: f64}
//   %11: f64 = extern "c" call.cabs %10: Complex
//   call.std::fmt::print.f64 %11: f64
//   %13: f64 = const 4.0
//   %14: f64 = unary.- %13: f64
//   %15: f64 = const 0.0
//   %16: Complex = struct.new {re: %14: f64, im: %15: f64}
//   %17: Complex = extern "c" call.csqrt %16: Complex
//   %18: f64 = field.re %17: Complex
//   call.std::fmt::print.f64 %18: f64
//   %20: f64 = field.im %17: Complex
//   call.std::fmt::print.f64 %20: f64
//   return void: void
// }
