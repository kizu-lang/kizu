import std::arena;

struct UserArena {}

struct User {
    name: []u8,
}
fn main(allocator: Allocator) -> !void {
    let users = arena::new<User, UserArena>(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    print(users.at(alice).name);
    users.deinit(allocator);
    return;
}

