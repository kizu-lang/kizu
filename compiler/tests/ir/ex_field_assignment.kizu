struct User {
    name: []u8,
    age: i64,
}

fn main() -> void {
    var user = User { name: "alice", age: 30 };
    user.name = "bob";
    user.age = user.age + 1;
    print(user.name);
    print(user.age);
}

// run
// features: struct field assignment
// output:
// bob
// 31

