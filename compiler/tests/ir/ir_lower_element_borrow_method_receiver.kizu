import std;
struct Point { pub x: i64 }
fn (self: Point) sum() -> i64 { return self.x; }
fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var points = std::array::new<Point>(allocator);
    defer points.deinit();
    try points.append(Point { x: 7 });
    if points.at(0) |p| {
        print(p.sum());
    }
    return;
}

