import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let boxed = try mem::box<i64>(allocator, 42);
    let value = boxed.take();
    print(value);
    boxed.deinit();
    return;
}

// check-fails
// features: std-mem box take ownership
// error: moved value `boxed` was used


