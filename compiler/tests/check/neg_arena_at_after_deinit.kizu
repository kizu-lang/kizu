import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    errdefer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    users.deinit(allocator);
    print(users.at(alice).name);
    return;
}

// check-fails
// features: arena deinit
// error: arena `users` was deinitialized

