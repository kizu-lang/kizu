import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let alice = users.add(allocator, User { name: "alice" });
    users.deinit(allocator);
    print(users.at(alice).name);
}

// check-fails
// features: arena deinit
// error: arena `users` was deinitialized

