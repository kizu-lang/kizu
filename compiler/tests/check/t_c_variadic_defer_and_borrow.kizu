extern "c" struct Point {
    x: i32,
    y: i32,
}

extern "c" fn record(point: &Point, format: ptr<const u8>, ...) -> void
extern "c" fn report(format: ptr<const u8>, ...) -> void
fn main() -> void {
    let point = Point { x: 1, y: 2 };
    let count: u64 = 7;
    // SAFETY: the format reads no argument.
    defer unsafe report(c"done");
    // SAFETY: the format reads one unsigned long.
    defer unsafe report(c"%lu", count);
    // SAFETY: point is live for the call, and the format reads a double and a pointer.
    unsafe record(&point, c"%f %p", 2.5, c"alice");
    return;
}

