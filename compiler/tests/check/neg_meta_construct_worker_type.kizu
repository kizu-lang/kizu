import std;

struct Counts {
    pub visits: i64,
}

// The worker's result is what the struct literal puts in the field, so it has
// to be that field's type. This one returns the byte string it was reading the
// name as, which `visits` cannot hold.
fn wrong<T, f: Field>(base: i64) -> ![]u8 {
    return std::meta::field_name<T, f>();
}

fn main() -> !void {
    let counts = try std::meta::construct<Counts, wrong>(1);
    print(counts.visits);
    return;
}

// check-fails
// features: comptime construct field-static-param reflection diagnostics
// error: expects i64

