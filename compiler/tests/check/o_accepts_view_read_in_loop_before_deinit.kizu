import std::mem;
import std::string;

// A view read only inside a loop is past its last use once the loop
// statement ends, so the owner's later release does not see it borrowed:
// neither a deferred one nor an explicit one after the loop.
fn deferred() -> !void {
    let allocator = mem::page_allocator();
    var drawn = try string::from_bytes(allocator, "abcd");
    defer drawn.deinit(allocator);
    let view = drawn.as_bytes();
    for 0..mem::len(view) |index| {
        print(cast<i64>(view[index]));
    }
    return;
}

fn explicit() -> !void {
    let allocator = mem::page_allocator();
    var drawn = try string::from_bytes(allocator, "abcd");
    let view = drawn.as_bytes();
    var index = 0;
    while index < mem::len(view) {
        print(cast<i64>(view[index]));
        index = index + 1;
    }
    drawn.deinit(allocator);
    return;
}

