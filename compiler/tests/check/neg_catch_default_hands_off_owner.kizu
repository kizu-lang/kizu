import std::mem;
import std::string;

error Failure { Refused }

fn build(allocator: Allocator, fail: bool) -> Failure!string::String {
    if fail {
        return Failure::Refused;
    }
    return string::from_bytes(allocator, "built") catch return Failure::Refused;
}

// The default runs only when `build` fails. When it succeeds, `keep` is
// neither handed off nor released.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let keep = try string::from_bytes(allocator, "fallback");
    errdefer keep.deinit(allocator);
    let picked = build(allocator, false) catch move keep;
    defer picked.deinit(allocator);
    let bytes = picked.as_bytes();
    print(bytes);
    return;
}

// check-fails
// features: catch ownership move std-string error-set
// error: `keep` cannot be handed off inside the `catch` default

