// fn apply(f: ?extern "c" fn(i32) -> i32, value: i32) -> i32 { if f { return unsafe call(value); } return value; }
// fn main() -> void { var buffer = [4]i64{}; let values = buffer.as_mut_slice(); values[0] = 30; values[1] = 10; values[2] = 40; values[3] = 20; unsafe qsort(unsafe cast<ptr<u8>>(mut_ptr_of(values)), 4, 8, ascending); for 0..4 |index| { print(values[index]); } print(apply(abs, (-7))); print(apply(null, (-7))); let erased = unsafe cast<ptr<const u8>>(abs); let restored = unsafe cast<extern "c" fn(i32) -> i32>(erased); print(unsafe restored((-9))); return; }
// check:
// ok
