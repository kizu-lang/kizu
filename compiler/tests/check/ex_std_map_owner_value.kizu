// fn main() -> !void { let allocator = std::mem::page_allocator(); var names = std::map::new<[]u8, std::string::String>(allocator); defer names.deinit(allocator); try names.insert("first", try owned(allocator, "alice")); try names.insert("last", try owned(allocator, "smith")); if names.at("first") { let bytes = name.as_bytes(); print(bytes); } if names.at_mut("last") { try name.append_bytes("son"); } var index = 0; while names.key_at(index) { print(key); index = (index + 1); } if names.at("last") { let bytes = name.as_bytes(); print(bytes); } return; }
// check:
// ok
