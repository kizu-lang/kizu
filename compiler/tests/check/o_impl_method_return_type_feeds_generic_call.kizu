struct Counter { value: i64 }
fn (self: Counter) len() -> i64 {
    return self.value;
}
fn expect_equal<T>(expected: T, actual: T) -> void {
    return;
}
fn main() {
    let counter = Counter { value: 1 };
    expect_equal<i64>(1, counter.len());
}


