fn none() -> ?ptr<u8> {
    // SAFETY: address zero is null, which nothing calls.
    return unsafe ptr_from_int<ptr<u8>>(0);
}

fn main() -> void {
    // SAFETY: none; the cast is refused because it would drop the null.
    let f = unsafe cast<extern "c" fn() -> void>(none());
}

