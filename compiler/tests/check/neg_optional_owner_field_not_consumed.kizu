import std::string;

pub struct Visitor {
    pub nick: ?string::String,
}

// The deinit never opens `nick`, so the string it may hold is never released.
// A `?Owner` field is counted like any other owner field.
fn (self: Visitor) deinit() -> void {
    return;
}

fn main() -> !void {
    var visitor = Visitor { nick: null };
    defer visitor.deinit();
    return;
}

