import std::mem;
import std::string;

pub struct Visitor {
    pub nick: ?string::String,
}

// The deinit never opens `nick`, so the string it may hold is never released.
// A `?Owner` field is counted like any other owner field.
fn (self: Visitor) deinit(allocator: Allocator) -> void {
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var visitor = Visitor { nick: null };
    defer visitor.deinit(allocator);
    return;
}

// check-fails
// features: optional owner diagnostics
// error: deinit of `Visitor` must consume owner field `nick`

