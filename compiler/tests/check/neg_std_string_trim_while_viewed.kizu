import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = try string::from_bytes(allocator, " padded ");
    defer text.deinit();
    let view = text.as_bytes();
    string::trim_space_in_place(&var text);
    print(view);
    return;
}

// check-fails
// features: std-string trim mutable-borrow
// error: value `text` cannot be mutably borrowed while borrowed


