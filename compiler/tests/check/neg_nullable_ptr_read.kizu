extern "c" fn source() -> ?ptr<const u8>

fn main() {
    // SAFETY: source は null を返しうるが、ここではそれを確かめていない
    let p = unsafe source();
    // SAFETY: p の null 検査をしていないので、この行は通らない
    print(unsafe ptr_read(p));
}

// check-fails
// features: raw-pointer
// error: ptr_read` expects non-null raw pointer


