import std::map;
import std::mem;

fn kill(symbols: &var map::Map<[]u8, i64>) {
    symbols.deinit();
}

fn main() {
    let allocator = mem::page_allocator();
    var symbols = map::new<[]u8, i64>(allocator);
    kill(symbols);
}

// check-fails
// features: std-map mutable-borrow deinit
// error: requires owned Map receiver


