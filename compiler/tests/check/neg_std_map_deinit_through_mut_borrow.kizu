import std::map;
import std::mem;

fn kill(allocator: Allocator, symbols: &var map::Map<[]u8, i64>) {
    symbols.deinit(allocator);
}

fn main() {
    let allocator = mem::page_allocator();
    var symbols = map::new<[]u8, i64>(allocator);
    kill(allocator, symbols);
}

// check-fails
// features: std-map mutable-borrow deinit
// error: requires owned Map receiver

