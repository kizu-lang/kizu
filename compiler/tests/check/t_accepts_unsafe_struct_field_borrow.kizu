struct Count { n: usize }
fn (self: &var Count) set(n: usize) -> void {
    self.n = n;
}
/// test invariant
unsafe struct Buf { data: ptr<u8>, len: Count, cap: usize }
struct Plain { len: Count, cap: usize }
fn set(x: &var usize, n: usize) -> void {
    x = n;
}
fn shrink(b: &var Buf, n: usize) -> void {
    // SAFETY: n <= len
    unsafe set(&var b.cap, n);
    // SAFETY: n <= len
    unsafe b.len.set(n);
    // SAFETY: n <= len
    unsafe set(&var b.len.n, n);
}
fn plain(p: &var Plain, n: usize) -> void {
    set(&var p.cap, n);
    p.len.set(n);
    let r = &var p.len.n;
    r.* = n;
}
fn read(b: &Buf) -> usize {
    let r = &b.cap;
    return r.*;
}

