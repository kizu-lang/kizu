extern "c" struct Pair {
    first: i32,
    second: i32,
}

extern "c" struct Frame {
    origin: Pair,
    size: Pair,
}

extern "c" fn scan(text: ptr<const u8>, format: ptr<const u8>, ...) -> i32
extern "c" fn report(format: ptr<const u8>, ...) -> void
fn forward(pair: &var Pair, seen: &Pair) -> i32 {
    // SAFETY: both structs are live for the call.
    return unsafe scan(c"7", c"%d %p", &var pair, &seen);
}

fn main() -> void {
    var frame = Frame { origin: Pair { first: 0, second: 0 }, size: Pair { first: 3, second: 4 } };
    let fixed = Pair { first: 1, second: 2 };
    // SAFETY: frame and fixed are live when the scope ends.
    defer unsafe report(c"%p %p %d", &var frame, &fixed, cast<i32>(2));
    // SAFETY: frame.origin is live for the call, and fixed is read as a copy.
    let matched = unsafe scan(c"5", c"%d %p", &var frame.origin, &fixed);
    print(matched);
    // SAFETY: frame.size is live for the call.
    print(unsafe scan(c"6", c"%p", &frame.size));
    print(forward(&var frame.size, &fixed));
    return;
}

