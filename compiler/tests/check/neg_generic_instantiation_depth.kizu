import std::array;

// A generic body is checked once per set of static arguments (§13). A body
// whose own call grows its argument never repeats a set, so no instance is
// ever a second visit and nothing stops the checker on its own. The bound
// turns that into a diagnostic instead of a compiler that never returns.
fn grow<T>() -> i64 {
    comptime if T == type<i64> {
        return grow<array::Array<i64>>();
    } else {
        return grow<array::Array<T>>();
    }
}

fn main() -> void {
    print(grow<i64>());
}

// check-fails
// features: generics comptime diagnostics
// error: generic instantiation nested deeper than 64


