unsafe struct Buf {
    data: ptr<u8>,
    len: usize,
}

unsafe fn write_byte(p: ptr<u8>, value: u8) -> void {
    unsafe ptr_write(p, value);
}

fn make_buf(p: ptr<u8>) -> Buf {
    return unsafe Buf { data: p, len: 1 };
}

fn main() {}


