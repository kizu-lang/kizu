import std::mem;
import std::string;

struct Pair {
    first: string::String,
    second: string::String,
}

fn (self: Pair) deinit() -> void {
    self.first.deinit();
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let pair = Pair {
        first: string::new(allocator),
        second: string::new(allocator),
    };
    pair.deinit();
    return;
}

// check-fails
// features: ownership deinit-completeness
// error: deinit of `Pair` must consume owner field `second`


