import std::array;
import std::mem;

fn main() -> !void {
    var buf = [4096]u8{};
    let scratch = buf.as_mut_bytes();
    var values = array::new<i64>(mem::fixed_buffer(scratch));
    defer values.deinit(mem::fixed_buffer(scratch));
    try values.append(1);
    return;
}

// check-fails
// features: allocator fixed-buffer borrow
// error: `std::mem::fixed_buffer` returns a tied allocator; bind it with `let`

