import std;
struct User { name: []u8 }
fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    defer users.deinit(allocator);
    let user = User { name: "alice" };
    let alice = try users.add(allocator, move user);
    print(user.name);
    print(users.at(alice).name);
    return;
}


