import std;
struct User { name: []u8 }
fn main() {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    let user = User { name: "alice" };
    let alice = users.add(allocator, move user);
    print(user.name);
    print(users.at(alice).name);
}


