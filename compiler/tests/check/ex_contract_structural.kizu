contract Writer {
    fn write(text: []u8) -> !i64;
}

struct File {
    name: []u8,
}

struct Buffer {
    label: []u8,
}

fn (self: &File) write(text: []u8) -> !i64 {
    print(self.name);
    print(text);
    return 1;
}

// `Buffer` says what it means to be. The check runs here, and `File` above
// satisfies the same contract without saying so.
impl Writer for Buffer;

fn (self: &Buffer) write(text: []u8) -> !i64 {
    print(self.label);
    print(text);
    return 2;
}

fn save<W>(writer: &W, text: []u8) -> !i64 {
    return try writer.write(text);
}

fn main() -> !void {
    print(try save<File>(File { name: "file" }, "hello"));
    print(try save<Buffer>(Buffer { label: "buffer" }, "bye"));
    return;
}

// run
// features: contract impl structural generics
// output:
// file
// hello
// 1
// buffer
// bye
// 2


