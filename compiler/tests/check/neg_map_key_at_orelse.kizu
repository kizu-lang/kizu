import std::map;
import std::mem;

// A key view from `key_at` aliases map storage, and `orelse` would hand it
// out as a bare view no binding ties back to the map. Only a capture may
// consume it: the capture holds the map borrowed for exactly the key's scope.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let scores = map::new<[]u8, i64>(allocator);
    defer scores.deinit(allocator);
    try scores.insert("one", 1);
    let key = scores.key_at(0) orelse "";
    print(key);
    return;
}

// check-fails
// features: optional view map diagnostics
// error: view optional `?[]u8` from a container must be consumed by a capture

