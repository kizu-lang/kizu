import std;
fn copy(values: std::array::Array<i64>, allocator: Allocator) -> !void {
    defer values.deinit(allocator);
    let copied = try values.clone(allocator);
    defer copied.deinit(allocator);
    print(values.len());
    return;
}
fn main() {}

