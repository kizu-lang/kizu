import std::array;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let names = array::new<string::String>(allocator);
    defer names.deinit(allocator);
    try names.append(allocator, try string::from_bytes(allocator, "kizu"));
    let copied = try names.clone(allocator);
    copied.deinit(allocator);
    return;
}

// check-fails
// features: std-array clone copy owner
// error: `Array.clone` requires copy element

