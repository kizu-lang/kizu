import std::array;
import std::mem;

fn copy_first<T>(
    allocator: Allocator,
    into: &var array::Array<T>,
    from: &array::Array<T>
) -> !void {
    if from.at(0) |first| {
        try into.append(allocator, first.*);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try values.append(allocator, 7);
    try copy_first<i64>(allocator, values, &values);
    return;
}

// check-fails
// features: generic borrow std-array
// error: cannot be borrowed while mutably borrowed

