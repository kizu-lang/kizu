import std;
fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var name = std::string::new(allocator);
    defer name.deinit(allocator);
    try name.append_byte(cast<u8>(97));
    name = std::string::new(allocator);
    print(name.len());
    return;
}


