import std;
struct User { name: []u8 }
fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    errdefer users.deinit(allocator);
    users.deinit(allocator);
    try users.add(allocator, User { name: "alice" });
    return;
}


