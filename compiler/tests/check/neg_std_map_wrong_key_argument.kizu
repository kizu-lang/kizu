import std::map;
import std::mem;

// The key argument is checked against the map's own key type, so a `[]u8`
// lookup does not reach a map keyed by an integer.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let counts = map::new<i64, i64>(allocator);

    print(counts.get("main") orelse 0);

    counts.deinit(allocator);
    return;
}

// check-fails
// features: std-map integer-key type-check
// error: `Map.get` expects i64 key, got []u8

