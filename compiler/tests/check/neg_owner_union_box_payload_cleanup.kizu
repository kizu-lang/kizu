import std::mem;

union Slot {
    Held(mem::Box<i64>),
    Empty,
}

fn (self: Slot) deinit(allocator: Allocator) -> void {
    match self {
        Held(boxed) => print(0),
        Empty => print(0),
    }
}

fn main() -> void {}

// check-fails
// features: owner-union box cleanup
// error: owner-payload union variant `Slot::Held` must clean its payload via `boxed.deinit(allocator)`

