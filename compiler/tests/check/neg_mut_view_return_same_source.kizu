import std::mem;
import std::string;

// Two mutable sources may not name the same value: the second source would
// alias the first exclusive borrow.
fn first_of(a: &var string::String, b: &var string::String) -> &var string::String {
    if b.len() > a.len() {
        return b;
    }
    return a;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var only = string::new(allocator);
    defer only.deinit(allocator);
    let view = first_of(&var only, &var only);
    print(view.len());
    return;
}

// check-fails
// features: borrow-provenance structural
// error: value `only` cannot be borrowed while mutably borrowed

