struct User {
    name: []u8,
    age: i64,
}

fn main() -> void {
    var user = User { name: "alice", age: 30 };
    let name = &user.name;
    user.name = "bob";
    print(name.*);
}

// check-fails
// features: borrow field-borrow
// error: field `user.name` cannot be assigned while borrowed


