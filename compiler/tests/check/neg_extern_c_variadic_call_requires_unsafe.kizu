// Nothing checks that the arguments match what the callee reads, so a
// variadic call is `unsafe` like every other call into C.
extern "c" fn printf(format: ptr<const u8>, ...) -> i32
fn main() -> void {
    printf(c"%d", 1);
    return;
}

// check-fails
// features: extern-c unsafe diagnostic
// error: call to `printf` requires `unsafe`

// check
// load:
// extern "c" fn printf(format: ptr<const u8>, ...) -> i32
// fn main() -> void { printf(c"%d", 1); return; }
// check:
// 5:5-5:11 [unsafe.missing_marker] unsafe error: call to `printf` requires `unsafe`
//   help: `unsafe` here covers calls to `extern "<abi>" fn` declarations.
