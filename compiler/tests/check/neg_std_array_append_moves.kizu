import std::array;
import std::mem;

struct Box {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let values = array::new<Box>(allocator);
    defer values.deinit(allocator);
    let item = Box { text: "owned" };

    try values.append(allocator, move item);
    print(item.text);
    return;
}

// check-fails
// features: std-array move
// error: moved value

