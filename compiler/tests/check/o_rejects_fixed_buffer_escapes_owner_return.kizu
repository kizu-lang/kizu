import std;
fn leak() -> std::array::Array<i64> {
    var buf = [512]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = std::mem::fixed_buffer(scratch);
    let values = std::array::new<i64>(alloc);
    return values;
}
fn main() -> !void {
    var values = leak();
    values.deinit();
    return;
}


