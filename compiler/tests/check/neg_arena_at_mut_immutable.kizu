import std::arena;
import std::mem;

struct UserArena {}

struct User {
    visits: i64,
}

// `at_mut` writes through the arena, so the receiver must be a mutable
// binding.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    let alice = try users.add(allocator, User { visits: 0 });
    if users.at_mut(alice) |u| {
        u.visits = 1;
    }
    users.deinit(allocator);
    return;
}

// check-fails
// features: arena borrow optional mutability
// error: Arena.at_mut` requires mutable arena binding

