import std::array;
import std::mem;

fn escape_alloc() -> Allocator {
    var buf = [4096]u8{};
    let scratch = buf.as_mut_bytes();
    return mem::fixed_buffer(scratch);
}

fn main() -> !void {
    let alloc = escape_alloc();
    var values = array::new<i64>(alloc);
    defer values.deinit();
    try values.append(1);
    return;
}

// check-fails
// features: allocator fixed-buffer borrow
// error: `std::mem::fixed_buffer` returns an allocator tied to local state and cannot escape


