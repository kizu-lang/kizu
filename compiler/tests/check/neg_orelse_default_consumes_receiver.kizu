import std::mem;

fn maybe(present: bool) -> ?i64 {
    if present {
        return 7;
    }
    return null;
}

// `Box.take` consumes its receiver without a `move` marker. The default runs
// only when `maybe` yields nothing, so `boxed` would be consumed on one path
// and left unreleased on the other.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let boxed = try mem::box<i64>(allocator, 3);
    errdefer boxed.deinit(allocator);
    let picked = maybe(true) orelse boxed.take(allocator);
    print(picked);
    return;
}

// check-fails
// features: orelse ownership std-box
// error: `boxed` cannot be consumed inside the `orelse` default

