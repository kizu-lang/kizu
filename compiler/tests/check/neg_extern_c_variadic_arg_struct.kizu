// A struct has no one way to travel by value as a variadic argument, so the
// call passes its fields, or lends it with `&point` for C to read through a
// pointer.
extern "c" struct Point {
    x: i32,
    y: i32,
}

extern "c" fn printf(format: ptr<const u8>, ...) -> i32
fn main() -> void {
    let point = Point { x: 1, y: 2 };
    // SAFETY: the format reads two `int`s.
    unsafe printf(c"%d %d", point);
    return;
}

// check-fails
// features: extern-c extern-struct diagnostic
// error: arg 2 of `printf` has type Point, which a C variadic argument cannot carry

// check
// load:
// extern "c" struct Point { x: i32, y: i32 }
// extern "c" fn printf(format: ptr<const u8>, ...) -> i32
// fn main() -> void { let point = Point { x: 1, y: 2 }; unsafe printf(c"%d %d", point); return; }
// check:
