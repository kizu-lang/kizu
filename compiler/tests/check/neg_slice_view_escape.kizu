fn tail() -> []u8 {
    var buffer = [4]u8{};
    let view = buffer.as_bytes();
    return view[1..];
}

fn main() -> void {
    let escaped = tail();
    print(escaped);
    return;
}

// check-fails
// features: slice view borrow stack-buffer
// error: borrowed value `view` cannot escape

