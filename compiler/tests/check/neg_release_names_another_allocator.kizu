// tied allocator は互いに区別が付くので、取り違えは compile error です。
// tie を持たない `page_allocator()` 同士は同じ allocator なので検査は要りません。

import std::array;
import std::mem;

fn main() -> !void {
    var one = [512]u8{};
    var two = [512]u8{};
    let one_view = one.as_mut_bytes();
    let two_view = two.as_mut_bytes();
    let first = mem::fixed_buffer(one_view);
    let second = mem::fixed_buffer(two_view);
    var values = array::new<i64>(first);
    defer values.deinit(second);
    try values.append(1);
    return;
}

// check-fails
// features: allocator fixed-buffer deinit
// error: `Array.deinit` names allocator `second`, but `values` was built from another

