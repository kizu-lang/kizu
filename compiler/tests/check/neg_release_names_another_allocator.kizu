// load:
// fn main() -> !void { var one = [512]u8{}; var two = [512]u8{}; let one_view = one.as_mut_bytes(); let two_view = two.as_mut_bytes(); let first = std::mem::fixed_buffer(one_view); let second = std::mem::fixed_buffer(two_view); var values = std::array::new<i64>(first); defer values.deinit(second); try values.append(1); return; }
// check:
