struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn smuggle(bytes: []u8, out: &var BytesIter) -> void {
    out.bytes = bytes;
    return;
}

fn make() -> BytesIter {
    var buf = [4]u8{};
    let view = buf.as_bytes();
    var it = BytesIter { bytes: "", index: 0 };
    smuggle(view, it);
    return it;
}

fn main() -> !void {
    let it = make();
    print(it.index);
    return;
}

// check-fails
// features: borrow view-capture diagnostics
// error: borrowed value `view` cannot escape


