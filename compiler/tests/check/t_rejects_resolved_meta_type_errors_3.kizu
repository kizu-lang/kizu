import std;
struct Item { pub value: i64 }
struct Other { pub value: i64 }
fn inspect<T>() -> bool {
    comptime for std::meta::public_fields<T>() |f| {
        comptime if type<std::meta::field_type<Other, f>> == type<i64> {
            return true;
        } else {
            return false;
        }
    }
    return false;
}
fn main() -> void { print(inspect<Item>()); }

