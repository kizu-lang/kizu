import std::array;
import std::mem;

fn main() -> !void {
    var buf = [4096]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    var values = array::new<i64>(alloc);
    defer values.deinit(alloc);
    let sneak = buf.as_mut_bytes();
    sneak[0] = cast<u8>(255);
    try values.append(1);
    return;
}

// check-fails
// features: allocator fixed-buffer stack-buffer borrow
// error: value `buf` cannot be borrowed while mutably borrowed

