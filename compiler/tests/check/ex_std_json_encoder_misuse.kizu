import std::json;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);

    try encoder.write_i64_field("id", 7);
    return;
}

// run-fails
// features: std-json diagnostics
// error: runtime error: json encoder: field outside an object

