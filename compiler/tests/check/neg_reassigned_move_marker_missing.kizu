struct Name {
    value: []u8,
}

fn take(name: Name) {
    print(name.value);
}

// Assigning a new value makes `name` usable again. It is still a `Name`,
// which does not copy, so handing it off again takes its own `move`.
fn main() {
    var name = Name { value: "alice" };
    take(move name);
    name = Name { value: "bob" };
    take(name);
}

// check-fails
// features: move diagnostic
// error: `name` is handed off here; write `move name`

