import std::arena;
import std::mem;

struct User {
    visits: i64,
}

// The at_mut capture aliases live arena storage, so reads wait the way
// Array and Map reads do.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var users = arena::new<User>(allocator);
    errdefer users.deinit(allocator);
    let alice = try users.add(allocator, User { visits: 0 });
    if users.at_mut(alice) |u| {
        print(users.at(alice).visits);
        u.visits = 1;
    }
    users.deinit(allocator);
    return;
}

// check-fails
// features: arena mutable-borrow
// error: Arena.at` cannot read while mutably borrowed

