fn main() -> void {
    var i = 0;
    while i < 5 {
        i = i + 1;
        if i == 2 {
            continue;
        }
        if i == 4 {
            break;
        }
        print(i);
    }
}

// run
// features: while break continue
// output:
// 1
// 3


