import std::mem;
import std::string;

fn make(allocator: Allocator, flag: bool) -> ?string::String {
    if flag {
        return string::new(allocator);
    }
    return null;
}

// An owner inside an optional is invisible to move tracking, so a `?String`
// lives only where it is consumed: a capture, an `orelse`, or a return path.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let maybe = make(allocator, true);
    var out = maybe orelse string::new(allocator);
    out.deinit();
    print(1);
    return;
}

// check-fails
// features: optional owner diagnostics
// error: optional `?std::string::String` must be consumed where it is produced


