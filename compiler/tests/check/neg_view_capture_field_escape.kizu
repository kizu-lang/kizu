struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn leak() -> []u8 {
    var buf = [4]u8{};
    let view = buf.as_bytes();
    let it = BytesIter { bytes: view, index: 0 };
    return it.bytes;
}

fn main() -> !void {
    print(leak());
    return;
}

// check-fails
// features: borrow view-capture diagnostics
// error: view field `it.bytes` cannot escape its borrowed owner

