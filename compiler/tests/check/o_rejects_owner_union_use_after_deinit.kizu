import std;
union Node {
    Left(std::string::String),
    Right(std::array::Array<i64>),
}
fn (self: Node) deinit() -> void {
    match self {
        Left(s) => s.deinit(),
        Right(a) => a.deinit(),
    }
}
fn show(n: &Node) -> void { return; }
fn consume(s: std::string::String) -> void {
    let n = Node::Left(move s);
    n.deinit();
    show(n);
}


