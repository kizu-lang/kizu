// fn main() -> !void { let allocator = std::mem::page_allocator(); var parent = std::array::new<std::string::String>(allocator); defer parent.deinit(); try place(allocator, (&varparent), true); print(parent.len()); try place(allocator, (&varparent), false); print("unreachable"); return; }
