import std::mem;
import std::testing;

test "std testing assertions" {
    testing::expect(true);
    testing::expect_equal<i64>(3, 1 + 2);
    testing::expect(mem::starts_with("lexer", "lex"));
    testing::expect_equal<[]u8>("token", "token");
    if false {
        testing::fail("unreachable");
    }
}

// test
// features: std-testing trap generics
// output:
// test: ok

// check
// load:
// test "std testing assertions" { std::testing::expect(true); std::testing::expect_equal<i64>(3, (1 + 2)); std::testing::expect(std::mem::starts_with("lexer", "lex")); std::testing::expect_equal<[]u8>("token", "token"); if false { std::testing::fail("unreachable"); } }
// check:
