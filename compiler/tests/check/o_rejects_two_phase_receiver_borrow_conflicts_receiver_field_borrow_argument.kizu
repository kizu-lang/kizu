struct Registry { cursor: i64 }
fn (self: &var Registry) inspect(peek: &i64) -> void {
    self.cursor = peek.*;
}
fn main() {
    var reg = Registry { cursor: 1 };
    reg.inspect(&reg.cursor);
}


