import std;
union Node {
    Left(std::string::String),
    Right(std::array::Array<i64>),
}
fn (self: Node) deinit() -> void {
    match self {
        Left(s) => s.deinit(),
        Right(a) => a.deinit(),
    }
}
fn show(n: &Node) -> void { return; }
fn drop_node(n: Node) -> void {
    match n {
        Left(s) => s.deinit(),
        Right(a) => a.deinit(),
    }
    show(n);
}


