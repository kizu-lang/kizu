import std::array;
import std::mem;

fn main() -> !void {
    var buf = [4096]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    let alias = alloc;
    var values = array::new<i64>(alias);
    defer values.deinit();
    try values.append(1);
    return;
}

// check-fails
// features: allocator fixed-buffer borrow
// error: borrowed value `alloc` cannot escape


