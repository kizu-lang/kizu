struct Payload {
    value: i64,
}

fn (self: Payload) deinit() -> void {
}

union Node {
    Made(Payload),
    Empty,
}

fn (self: Node) deinit() -> void {
    match self {
        Made(payload) => payload.deinit(),
        Empty => {},
    }
}

fn consume_twice(node: Node) -> void {
    match node {
        Made(payload) => payload.deinit(),
        Empty => {},
    }
    match node {
        Made(payload) => payload.deinit(),
        Empty => {},
    }
    return;
}

// check-fails
// features: union match move
// error: moved value `node` was used


