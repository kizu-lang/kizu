// The function is written before the enum, so the error cannot depend on which
// declaration the reader meets first.

fn Color(n: i64) -> i64 {
    return n;
}

enum Color {
    Red,
    Green,
}

fn main() {
    print(Color(5));
}

// check-fails
// features: enum fn type-check
// error: `Color` is a type and cannot name a function


