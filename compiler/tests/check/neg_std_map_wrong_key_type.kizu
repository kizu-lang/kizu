import std::map;
import std::mem;

// A map key is hashed and compared as the bytes it occupies, so the key type
// has to be one whose bytes are its value. f64 is not: `0.0` and `-0.0` are
// equal with different bytes, and a NaN is unequal to its own bytes.
fn main() {
    let allocator = mem::page_allocator();
    let table = map::new<f64, i64>(allocator);
    print(table.len());
}

