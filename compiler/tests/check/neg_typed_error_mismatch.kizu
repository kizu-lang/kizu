error ConfigError {
    NotFound,
}

error NetworkError {
    Timeout,
}

fn read_port() -> ConfigError!i64 {
    return ConfigError::NotFound;
}

fn main() -> NetworkError!void {
    let port = try read_port();
    print(port);
    return;
}

