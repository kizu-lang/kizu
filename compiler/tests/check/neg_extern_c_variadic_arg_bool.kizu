// C widens a `bool` to `int` when it is passed as a variadic argument, and
// Kizu has no conversion from `bool` to write, so the call passes an `i32`.
extern "c" fn printf(format: ptr<const u8>, ...) -> i32
fn main() -> void {
    let ready = true;
    // SAFETY: the format reads one `int`.
    unsafe printf(c"%d", ready);
    return;
}

// check-fails
