struct Count {
    n: usize,
}

fn (self: &var Count) set(n: usize) -> void {
    self.n = n;
}

/// data は少なくとも len.n バイトの有効なメモリを指す。
unsafe struct Buf {
    data: ptr<u8>,
    len: Count,
}

fn shrink(b: &var Buf, n: usize) -> void {
    b.len.set(n);
}

// check-fails
// features: unsafe-struct raw-pointer method
// error: mutable borrow of field `Buf.len` requires `unsafe`

