import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);
    defer tokens.deinit();

    try tokens.append(Token { text: "let" });
    if tokens.at(0) |first| {
        try tokens.append(Token { text: "var" });
        print(first.text);
    }
    return;
}

// check-fails
// features: std-array borrow reallocation-safety
// error: cannot run while array is borrowed


