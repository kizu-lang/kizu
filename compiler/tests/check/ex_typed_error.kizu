error ConfigError {
    NotFound,
    InvalidPort,
}

fn read_port(ok: bool) -> ConfigError!i64 {
    if ok {
        return 8080;
    }

    return ConfigError::NotFound;
}

fn main() -> ConfigError!void {
    let port = try read_port(true);
    print(port);
    return;
}

// run
// features: typed-error try
// output:
// 8080


