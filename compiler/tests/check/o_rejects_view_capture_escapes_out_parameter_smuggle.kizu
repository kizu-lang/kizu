struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}
fn smuggle(bytes: []u8, out: &var BytesIter) -> void {
    out.bytes = bytes;
    return;
}
fn main() -> !void {
    var buf = [16]u8{};
    let view = buf.as_bytes();
    var it = BytesIter { bytes: "", index: 0 };
    smuggle(view, it);
    print(it.index);
    return;
}


