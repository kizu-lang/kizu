import std::string;

struct Partial {
    first: string::String,
    last: string::String,
}

fn take(partial: Partial) -> void {
    partial.deinit();
}

// `partial` no longer matches its own type once `first` is gone, so it cannot
// be handed on whole: the callee would reach for a field that is not there.
// Take the rest out too, or do not take any.
fn split(partial: Partial) -> void {
    let first = move partial.first;
    first.deinit();
    take(move partial);
}

fn main() -> void {
    return;
}

// check-fails
// features: ownership field-move diagnostic
// error: field `partial.first` is already consumed, so `partial` cannot be handed on whole


