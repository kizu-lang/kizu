import std::string;

struct Partial {
    first: string::String,
    last: string::String,
}

fn take(allocator: Allocator, partial: Partial) -> void {
    partial.deinit(allocator);
}

// `partial` no longer matches its own type once `first` is gone, so it cannot
// be handed on whole: the callee would reach for a field that is not there.
// Take the rest out too, or do not take any.
fn split(allocator: Allocator, partial: Partial) -> void {
    let first = move partial.first;
    first.deinit(allocator);
    take(allocator, move partial);
}

fn main() -> void {
    return;
}

