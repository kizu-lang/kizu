import std::mem;
import std::string;

// One branch releases the string and the other does not. After the merge the
// value cannot be released again without double-freeing the branch that
// already did, so the branch that skipped it leaks.
fn drop_maybe(allocator: Allocator, keep: bool) -> void {
    var name = string::new(allocator);
    if keep {
        name.deinit();
    }
    return;
}

fn main() -> void {
    let allocator = mem::page_allocator();
    drop_maybe(allocator, false);
    return;
}

// check-fails
// features: ownership deinit std-string branch
// error: owned value `name` is consumed on one branch only


