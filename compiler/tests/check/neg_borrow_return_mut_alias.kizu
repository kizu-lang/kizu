fn mutable(value: &var i64) -> &var i64 {
    return value;
}

fn main() {
    var value = 1;
    let view = mutable(value);
    print(value);
    view.* = 2;
}

// check-fails
// features: borrow-provenance mutable-borrow borrow-check
// error: cannot be read while mutably borrowed


