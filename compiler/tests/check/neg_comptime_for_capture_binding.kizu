pub struct User {
    pub id: i64,
}

// A `comptime for` capture names a field for the length of one expansion. It
// is not a value, so it cannot be bound: the only place it may be written is a
// `std::meta` static argument (ADR-0113).
fn names<T>() -> void {
    comptime for std::meta::public_fields<T>() |f| {
        let held = f;
        print(held);
    }
    return;
}

fn main() -> void {
    names<User>();
}

// check-fails
// features: comptime comptime-for std-meta
// error: undefined variable `f`


