struct User {
    name: []u8,
}

fn use(left: &User, right: &var User) -> void {
    print(left.name);
    print(right.name);
}

fn main() {
    var user = User { name: "alice" };
    use(user, user);
}

// check-fails
// features: borrow mutable-borrow
// error: cannot be mutably borrowed while borrowed

