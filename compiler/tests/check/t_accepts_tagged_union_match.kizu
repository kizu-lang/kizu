union Shape {
    Point,
    Circle(i64),
    Label([]u8),
}
fn describe(shape: &Shape) -> void {
    match shape {
        Point => print("point");,
        Circle(radius) => print(radius);,
        Label(text) => print(text);,
    }
}
fn main() {
    describe(Shape::Circle(10));
}

