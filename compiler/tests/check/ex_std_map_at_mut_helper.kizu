import std::map;
import std::mem;

// A helper that takes the map by `&var` can consume at_mut itself: a `&var`
// borrow is a mutable place, so update logic moves out of the call sites.
fn bump(allocator: Allocator, counts: &var map::Map<[]u8, i64>, key: []u8) -> !void {
    if counts.at_mut(key) |n| {
        n.* = n.* + 1;
    } else {
        try counts.insert(allocator, key, 1);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit(allocator);
    try bump(allocator, counts, "kizu");
    try bump(allocator, counts, "kizu");
    try bump(allocator, counts, "lang");
    print(counts.get("kizu") orelse -1);
    print(counts.get("lang") orelse -1);
    return;
}

// run
// features: std-map borrow optional mutable-borrow
// output:
// 2
// 1

// check
// load:
