struct Registry {
    cursor: i64,
}

fn (self: &var Registry) inspect(peek: &i64) -> void {
    self.cursor = peek.*;
}

// A borrow argument survives into the call, so one that overlaps the receiver
// conflicts when the receiver's exclusive borrow activates.
fn main() -> void {
    var reg = Registry { cursor: 1 };
    reg.inspect(&reg.cursor);
}

// check-fails
// features: method receiver mutable-borrow borrow-check
// error: cannot be mutably borrowed while field is borrowed


