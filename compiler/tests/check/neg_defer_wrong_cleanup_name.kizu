struct Handle {
    pub id: i64,
}

fn (self: Handle) deinit() -> void {
    return;
}

fn (self: Handle) close() -> void {
    return;
}

// `defer` runs one thing: the cleanup that discharges the owner's consume
// obligation. It is spelled `deinit` and nothing else, so a second method that
// happens to look like cleanup cannot be registered under it (ADR-0119).
fn main() -> void {
    let handle = Handle { id: 1 };
    defer handle.close();
    return;
}

// check-fails
// features: defer type-check ownership
// error: defer cleanup must be `deinit`, got `close`


