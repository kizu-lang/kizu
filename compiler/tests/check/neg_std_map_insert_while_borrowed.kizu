import std::map;
import std::mem;

// The capture holds the map borrowed: an insert could rehash and move the
// storage the value borrow points into, so it must wait for the capture's
// last use.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit();

    try counts.insert("kizu", 1);
    if counts.at_mut("kizu") |count| {
        try counts.insert("lang", 2);
        count.* = 2;
    }
    return;
}

// check-fails
// features: std-map borrow mutation
// error: Map.insert` cannot run while map is borrowed


