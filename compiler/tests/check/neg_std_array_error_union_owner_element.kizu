import std::array;
import std::mem;
import std::string;

error Failure { Bad }

// An owner inside `E!T` is released only by the capture that opens it, and a
// container's element cleanup has no `if` to open one with, so the array
// could never release what it holds.
fn main() -> void {
    let allocator = mem::page_allocator();
    let results = array::new<Failure!string::String>(allocator);
    defer results.deinit(allocator);
    print(results.len());
    return;
}

// check-fails
// features: std-array error-union ownership
// error: Array element cannot be an error union around an owner

