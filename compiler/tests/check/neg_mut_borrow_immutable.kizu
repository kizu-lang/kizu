struct User {
    name: []u8,
}

fn update(user: &var User) -> void {
    print(user.name);
}

fn main() {
    let user = User { name: "alice" };
    update(user);
}

// check-fails
// features: borrow mutable-borrow
// error: &var argument `user` must be mutable

