import std::array;
import std::mem;

/// pointer は有効な 1 バイト以上のメモリを指す。
unsafe struct Holder {
    pointer: ptr<u8>,
}

fn main() {
    let allocator = mem::page_allocator();
    let holders = array::new<Holder>(allocator);
    print(holders.len());
}

// check-fails
// features: std-array raw-pointer type-check
// error: Array element cannot be raw pointer

