import std::arena;
import std::mem;

struct UserArena {}
struct UserArena2 {}

struct User {
    name: []u8,
}

// The signature pairs its one borrowed arena with its one handle of the same
// T, so the caller re-derives that contract and rejects a known confusion at
// the call site — the same error the callee's body would raise if it could
// see both origins.
fn show(users: &arena::Arena<User, UserArena>, h: arena::Handle<User, UserArena>) -> void {
    print(users.at(h).name);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let a = arena::new<User, UserArena>(allocator);
    defer a.deinit(allocator);
    let b = arena::new<User, UserArena2>(allocator);
    defer b.deinit(allocator);
    let h = try a.add(allocator, User { name: "alice" });
    show(&b, h);
    return;
}

// check-fails
// features: arena handle borrow
// error: handle `h` does not belong to arena `b`

