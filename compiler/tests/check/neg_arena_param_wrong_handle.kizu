import std::arena;
import std::mem;

struct User {
    name: []u8,
}

// The signature pairs its one borrowed arena with its one handle of the same
// T, so the caller re-derives that contract and rejects a known confusion at
// the call site — the same error the callee's body would raise if it could
// see both origins.
fn show(users: &arena::Arena<User>, h: arena::Handle<User>) -> void {
    print(users.at(h).name);
}

fn main() {
    let allocator = mem::page_allocator();
    let a = arena::new<User>(allocator);
    let b = arena::new<User>(allocator);
    let h = a.add(User { name: "alice" });
    show(&b, h);
}

// check-fails
// features: arena handle borrow
// error: handle `h` does not belong to arena `b`


