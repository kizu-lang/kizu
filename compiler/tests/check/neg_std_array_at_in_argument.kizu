import std::array;
import std::mem;

// The capture context covers exactly the condition's own call: an at/at_mut
// nested in argument position still needs a capture of its own.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var items = array::new<i64>(allocator);
    defer items.deinit(allocator);
    var indexes = array::new<i64>(allocator);
    defer indexes.deinit(allocator);
    try items.append(7);
    try indexes.append(0);
    if items.at_mut(indexes.at(0)) |v| {
        v.* = 8;
    }
    return;
}

// check-fails
// features: std-array borrow optional capture
// error: Array.at` must be consumed by a capture

