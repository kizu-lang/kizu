// `&var` lends storage C may write, so the binding has to be a `var`, the
// same as for a declared `&var S` parameter.
extern "c" struct Pair {
    first: i32,
    second: i32,
}

extern "c" fn sscanf(text: ptr<const u8>, format: ptr<const u8>, ...) -> i32
fn main() -> void {
    let pair = Pair { first: 0, second: 0 };
    // SAFETY: the format writes one int at the start of pair.
    unsafe sscanf(c"42", c"%d", &var pair);
    return;
}

// check-fails
// features: extern-c extern-struct mutable-borrow diagnostic
// error: &var argument `pair` must be mutable

