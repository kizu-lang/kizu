import std::mem;
import std::path;
import std::testing;

fn main() -> !void {
    let allocator = mem::page_allocator();

    var joined_empty = try path::join(allocator, "", "");
    defer joined_empty.deinit(allocator);
    let joined_empty_bytes = joined_empty.as_bytes();
    print(joined_empty_bytes);

    var joined_absolute = try path::join(allocator, "/a", "../b/");
    defer joined_absolute.deinit(allocator);
    let joined_absolute_bytes = joined_absolute.as_bytes();
    print(joined_absolute_bytes);

    var cleaned_empty = try path::clean(allocator, "");
    defer cleaned_empty.deinit(allocator);
    let cleaned_empty_bytes = cleaned_empty.as_bytes();
    print(cleaned_empty_bytes);

    var cleaned_repeated = try path::clean(allocator, "a//./b/../c/");
    defer cleaned_repeated.deinit(allocator);
    let cleaned_repeated_bytes = cleaned_repeated.as_bytes();
    print(cleaned_repeated_bytes);

    var cleaned_parent = try path::clean(allocator, "../a/..");
    defer cleaned_parent.deinit(allocator);
    let cleaned_parent_bytes = cleaned_parent.as_bytes();
    print(cleaned_parent_bytes);

    testing::expect_equal<[]u8>(".", path::basename(""));
    testing::expect_equal<[]u8>(".", path::dirname(""));
    testing::expect_equal<[]u8>("", path::extension(""));

    testing::expect_equal<[]u8>("/", path::basename("/"));
    testing::expect_equal<[]u8>("/", path::dirname("/"));
    testing::expect_equal<[]u8>("", path::extension("/"));

    testing::expect_equal<[]u8>("b", path::basename("a/b/"));
    testing::expect_equal<[]u8>("a", path::dirname("a/b/"));
    testing::expect_equal<[]u8>("", path::extension("a/b/"));

    testing::expect_equal<[]u8>("a", path::basename("a"));
    testing::expect_equal<[]u8>(".", path::dirname("a"));
    testing::expect_equal<[]u8>(".gz", path::extension("archive.tar.gz"));
    testing::expect_equal<[]u8>(".profile", path::extension(".profile"));

    return;
}

// run
// features: std-path pure-helper edge-case
// output:
// .
// /b
// .
// a/c
// ..

