import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn consume(token: Token) {
    print(token.text);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);
    defer tokens.deinit();

    try tokens.append(Token { text: "let" });
    if tokens.at(0) |first| {
        consume(first);
    }
    return;
}

// check-fails
// features: std-array borrow escape
// error: borrowed value `first` cannot escape


