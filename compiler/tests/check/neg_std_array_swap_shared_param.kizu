import std::array;
import std::mem;

fn reorder(values: &array::Array<i64>) -> !void {
    return values.swap(0, 1);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try values.append(allocator, 1);
    try values.append(allocator, 2);
    try reorder(&values);
    return;
}

// check-fails
// features: std-array swap mutable-borrow
// error: `Array.swap` requires mutable Array receiver

