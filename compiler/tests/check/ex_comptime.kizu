fn sized<n: i64>() -> i64 {
    return n;
}

fn main() {
    let size = comptime 4 * 1024;
    comptime if 1 + 1 == 2 {
        print(sized<8>());
    } else {
        print(0);
    }

    print(size);
}

// run
// features: comptime
// output:
// 8
// 4096

