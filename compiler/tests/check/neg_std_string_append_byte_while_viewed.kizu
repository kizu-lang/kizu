import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "lexer");
    let bytes = text.as_bytes();
    try text.append_byte(allocator, cast<u8>(33));
    print(bytes);
    return;
}

// check-fails
// features: std-string borrow mutation
// error: cannot run while string is borrowed

