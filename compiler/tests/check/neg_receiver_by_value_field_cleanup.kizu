import std::mem;
import std::string;

struct Holder {
    name: string::String,
}

// Field cleanup is only allowed inside the owner's deinit (ADR-0067); a
// method with a by-value receiver is not that place.
fn (self: Holder) close(allocator: Allocator) -> void {
    self.name.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let held = Holder { name: try string::from_bytes(allocator, "abc") };
    defer held.deinit(allocator);
    held.close(allocator);
    return;
}

// check-fails
// features: ownership method deinit
// error: field cleanup `self.name.deinit` is only allowed inside owner deinit

