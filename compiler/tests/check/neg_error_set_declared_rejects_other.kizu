error FsError {
    NotFound,
}

error NetError {
    Timeout,
}

fn fetch() -> NetError!i64 {
    return NetError::Timeout;
}

fn read() -> FsError!i64 {
    return try fetch();
}

fn main() -> !void {
    print(try read());
    return;
}

// check-fails
// features: error-set error-union type-check
// error: try cannot propagate NetError


