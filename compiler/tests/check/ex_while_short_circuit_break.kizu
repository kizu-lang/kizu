fn main() -> void {
    // A short-circuit condition is tested across blocks of its own, so the
    // block the loop exits from is the last of those, not the header.
    // This loop leaves through the condition, taking that edge at run time.
    var sum = 0;
    var i = 0;
    while i < 4 and sum < 100 {
        sum = sum + i * 10;
        i = i + 1;
        if sum > 500 {
            break;
        }
    }
    print(sum);
    print(i);

    // This one leaves through the break instead, and the two names it carries
    // hold different values at the exit.
    var seen = 0;
    var j = 0;
    while j < 100 and seen < 100 {
        seen = seen + 7;
        j = j + 1;
        if j == 3 {
            break;
        }
    }
    print(seen);
    print(j);
}

// run
// features: while logical break
// output:
// 60
// 4
// 21
// 3

