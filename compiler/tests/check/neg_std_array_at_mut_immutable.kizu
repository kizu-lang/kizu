import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let tokens = array::new<Token>(allocator);
    defer tokens.deinit(allocator);

    if tokens.at_mut(0) |slot| {
        slot.* = Token { text: "var" };
    }
    return;
}

// check-fails
// features: std-array mutable-borrow
// error: requires mutable array binding

