enum Color {
    Red,
    Green,
    Blue,
}

fn main() {
    let color = Color::Blue;
    match color {
        Red => print("red"),
        Green => print("green"),
        Blue => print("blue"),
    }
}

// run
// features: match enum
// output:
// blue

