struct Name {
    value: []u8,
}

fn take(name: Name) {
    print(name.value);
}

fn probe(name: Name, p: ptr<const u8>) -> u8 {
    take(move name);
    print(name.value);
    // SAFETY: p の有効性は呼び出し側が保証する
    return unsafe ptr_read(p);
}

fn main() {}

// check-fails
// features: unsafe move
// error: moved value `name` was used


