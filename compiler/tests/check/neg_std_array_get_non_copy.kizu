import std::array;
import std::mem;

struct Box {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let values = array::new<Box>(allocator);

    try values.append(Box { text: "owned" });
    let item = values.get(0);
    print(item.text);
    return;
}

// check-fails
// features: std-array copy type-check
// error: requires copy element

