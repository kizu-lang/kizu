import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let alice = users.add(allocator, User { name: "alice" });
    let again = alice;
    users.deinit(allocator);
    print(again);
}

// check-fails
// features: arena handle deinit
// error: handle `again` cannot be used after arena `users` deinit

