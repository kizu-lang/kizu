import std::array;
import std::mem;

struct Registry {
    users: array::Array<i64>,
}

// The capture borrow lives inside the owner's field storage, so consuming the
// owner while it is held would leave the borrow dangling.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var reg = Registry { users: array::new<i64>(allocator) };
    defer reg.deinit();
    try reg.users.append(7);
    if reg.users.at_mut(0) |v| {
        reg.deinit();
        v.* = 8;
    }
    return;
}

// check-fails
// features: std-array mutable-borrow ownership
// error: cannot be moved while borrowed


