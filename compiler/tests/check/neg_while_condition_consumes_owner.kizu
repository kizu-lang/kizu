import std::mem;
import std::string;

fn eat(allocator: Allocator, name: string::String) -> bool {
    name.deinit(allocator);
    return true;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let name = try string::from_bytes(allocator, "abc");
    var count = 0;
    while eat(allocator, move name) {
        count = count + 1;
        if count > 1 {
            break;
        }
    }
    return;
}

// check-fails
// features: while ownership move
// error: owned value `name` is consumed inside a loop

