struct User {
    pub name: []u8,
}

// A field token is known only at compile time, so it belongs in `<...>`. A
// runtime argument list holds values that are moved and borrowed, and a name
// with no runtime existence cannot stand among them.
fn label(f: Field) -> []u8 {
    return "unreachable";
}

fn main() -> void {
    print("unreachable");
}

// check-fails
// features: comptime static-params field-static-param diagnostics
// error: Field parameter `f` belongs in `<...>`, not `(...)`

