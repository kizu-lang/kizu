enum Kind {
    Number,
    Missing,
}

fn pick(kind: Kind) -> i64 {
    let value = match kind {
        Number => 1,
        Missing => return 0,
    };
    return value;
}

fn main() -> !void {
    print(pick(Kind::Number));
    return;
}

