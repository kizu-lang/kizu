import std::arena;
import std::mem;

struct User {
    visits: i64,
}

// `Arena.at_mut` produces a borrow optional, and a capture is its only
// consumer: a stored `?&var T` would hold an element borrow no binding ties
// to the arena.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var users = arena::new<User>(allocator);
    let alice = try users.add(allocator, User { visits: 0 });
    let entry = users.at_mut(alice);
    users.deinit(allocator);
    return;
}

// check-fails
// features: arena borrow optional capture
// error: Arena.at_mut` must be consumed by a capture

