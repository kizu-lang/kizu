// Only an extern struct has the layout C reads through a pointer; a Kizu
// struct lent to C hands it an address whose contents it cannot read.
struct Point {
    x: i64,
    y: i64,
}

extern "c" fn move_to(point: &var Point) -> void
pub fn main() -> void {
    return;
}


// check
// load:
// struct Point { x: i64, y: i64 }
// extern "c" fn move_to(point: &var Point) -> void
// pub fn main() -> void { return; }
// check:
// 8:15-8:22 type error: C function `move_to` parameter 1 is a borrow (`&var Point`), which C cannot receive
//   note: a C function passes only what C can name: an integer, a float, `bool`, `ptr<T>`, `ptr<const T>`, a nullable pointer, or an extern struct as `&S` / `&var S`
//   help: spell the value as C sees it: `ptr<const u8>` with a `usize` length for bytes, `ptr<T>` for a value C reads or writes in place
