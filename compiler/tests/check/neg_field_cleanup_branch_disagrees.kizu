import std::mem;
import std::string;

pub struct Pair {
    pub eager: bool,
    pub first: string::String,
    pub second: string::String,
}

// `second` is released on one path only. Past the merge the path that left it
// alone can no longer release it, and releasing it after the if would release
// twice what the other path already did. Both paths must agree — the rule a
// whole owned value already follows.
fn (self: Pair) deinit(allocator: Allocator) -> void {
    self.first.deinit(allocator);
    if self.eager {
        self.second.deinit(allocator);
    }
    return;
}

fn owned(allocator: Allocator) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes("x");
    return text;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var pair = Pair {
        eager: false,
        first: try owned(allocator),
        second: try owned(allocator),
    };
    defer pair.deinit(allocator);
    return;
}

// check-fails
// features: owner cleanup diagnostics
// error: owner field `self.second` is consumed on one branch only

