import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    defer name.deinit();
    try name.append_bytes("kizu");
    let view = name.as_mut_bytes();
    print(name.len());
    view[0] = 75;
    return;
}

// check-fails
// features: mutable-slice-view
// error: `String.len` cannot read while mutably borrowed


