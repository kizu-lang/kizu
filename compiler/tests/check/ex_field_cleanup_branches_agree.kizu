import std::mem;
import std::string;

pub struct Pair {
    pub eager: bool,
    pub first: string::String,
    pub second: string::String,
}

// Both paths release `second`, so what is left after the if does not depend on
// which one ran. This is the shape the disagreement rule must not refuse.
fn (self: Pair) deinit(allocator: Allocator) -> void {
    self.first.deinit(allocator);
    if self.eager {
        self.second.deinit(allocator);
    } else {
        self.second.deinit(allocator);
    }
    return;
}

fn owned(allocator: Allocator, bytes: []u8) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes(allocator, bytes);
    return move text;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var eager = Pair {
        eager: true,
        first: try owned(allocator, "a"),
        second: try owned(allocator, "b"),
    };
    eager.deinit(allocator);
    var lazy = Pair {
        eager: false,
        first: try owned(allocator, "c"),
        second: try owned(allocator, "d"),
    };
    lazy.deinit(allocator);
    print("released");
    return;
}

// run
// features: owner cleanup std-string
// output:
// released

