import std::io;
import std::mem;
import std::string;

fn shout(handle: Io, allocator: Allocator, held: &var string::String) -> void {
    print(held.len());
    return;
}

// The worker is still standing on `name`, so the Future cannot outlive the
// frame `name` lives in. Returning it would hand back something that is about
// to be pointed at nothing.
fn start(handle: Io, allocator: Allocator) -> !io::Future {
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_bytes(allocator, "alice");
    let future = try io::async<string::String>(
        handle, allocator, shout, &var name, 65536);
    return move future;
}

fn main() -> !void {
    var future = try start(io::blocking(), mem::page_allocator());
    future.deinit();
    return;
}

// check-fails
// features: io async borrow
// error: borrowed value `future` cannot escape


