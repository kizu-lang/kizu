import std::mem;
import std::string;

fn first(view: []u8) -> ?u8 {
    if mem::len(view) == 0 {
        return null;
    }
    return view[0];
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, "abcdef");
    let view = text.as_bytes();
    text.deinit(allocator);
    let head = first(view) orelse return;
    print(head);
    return;
}

// check-fails
// features: view borrow orelse-guard std-string
// error: cannot run while string is borrowed

