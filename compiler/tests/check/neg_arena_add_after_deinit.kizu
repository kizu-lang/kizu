import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    users.deinit(allocator);
    try users.add(allocator, User { name: "alice" });
    return;
}

// check-fails
// features: arena deinit
// error: arena `users` was deinitialized

