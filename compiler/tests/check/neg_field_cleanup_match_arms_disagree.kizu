import std::mem;
import std::string;

pub union Mode {
    Fast,
    Slow,
}

pub struct Job {
    pub mode: Mode,
    pub name: string::String,
}

// One arm releases `name` and the other does not, so what is left after the
// match depends on which arm ran. The branch rule reads across every arm that
// continues past it.
fn (self: Job) deinit(allocator: Allocator) -> void {
    match self.mode {
        Fast => self.name.deinit(allocator),
        Slow => {},
    }
    return;
}

fn owned(allocator: Allocator) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes(allocator, "x");
    return text;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var job = Job { mode: Mode::Slow, name: try owned(allocator) };
    defer job.deinit(allocator);
    return;
}

// check-fails
// features: owner cleanup match diagnostics
// error: owner field `self.name` is consumed on some match arms only

