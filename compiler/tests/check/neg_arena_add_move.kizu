import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    errdefer users.deinit(allocator);
    let user = User { name: "alice" };
    let alice = try users.add(allocator, move user);
    print(user.name);
    print(users.at(alice).name);
    return;
}

// check-fails
// features: arena move
// error: moved value `user` was used

