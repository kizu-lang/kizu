import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let user = User { name: "alice" };
    let alice = users.add(move user);
    print(user.name);
    print(users.at(alice).name);
}

// check-fails
// features: arena move
// error: moved value `user` was used


