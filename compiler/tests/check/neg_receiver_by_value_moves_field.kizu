import std::mem;
import std::string;

struct Holder {
    name: string::String,
}

// Same rule as `&var self`: a field cannot be moved out of a receiver the
// caller still owns.
fn (self: Holder) unwrap() -> string::String {
    return move self.name;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let held = Holder { name: try string::from_bytes(allocator, "abc") };
    defer held.deinit(allocator);
    let taken = held.unwrap();
    taken.deinit(allocator);
    return;
}

// check-fails
// features: ownership method borrow
// error: cannot be moved out of borrowed value `self`

