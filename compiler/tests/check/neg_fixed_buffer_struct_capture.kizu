import std::array;
import std::mem;

struct Holder {
    values: array::Array<i64>,
}

fn main() -> !void {
    var buf = [4096]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    let values = array::new<i64>(alloc);
    let holder = Holder { values: values };
    holder.deinit();
    return;
}

// check-fails
// features: allocator fixed-buffer borrow struct
// error: value `values` is allocated from a tied allocator and cannot escape its frame


