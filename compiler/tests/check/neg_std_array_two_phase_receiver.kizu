import std::array;
import std::mem;

// A `&var` receiver is reserved while the arguments are evaluated
// (ADR-0106): an argument may read the array but not mutate it, whether the
// method is a user's or the std container's.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try values.append(allocator, 1);
    try values.append(allocator, values.pop_or_panic());
    print(values.len());
    return;
}

// check-fails
// features: std-array borrow two-phase
// error: `Array.pop_or_panic` cannot run while array is borrowed

