import std::mem;
import std::string;

fn maybe(allocator: Allocator, present: bool) -> !?string::String {
    if present {
        return try string::from_bytes(allocator, "present");
    }
    return null;
}

// The default runs only when `maybe` yields nothing. When it yields a value,
// `keep` is neither handed off nor released.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let keep = try string::from_bytes(allocator, "fallback");
    errdefer keep.deinit(allocator);
    let picked = try maybe(allocator, true) orelse move keep;
    defer picked.deinit(allocator);
    let bytes = picked.as_bytes();
    print(bytes);
    return;
}

// check-fails
// features: orelse ownership move std-string
// error: `keep` cannot be handed off inside the `orelse` default

