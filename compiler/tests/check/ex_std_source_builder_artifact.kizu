import std::fmt;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var artifact = string::new(allocator);
    defer artifact.deinit();

    try artifact.reserve(64);
    try artifact.append_bytes("define i64 @main() {");
    try artifact.append_byte(cast<u8>(10));
    try artifact.append_bytes("  ret i64 ");
    try fmt::append_i64(artifact, 42);
    try artifact.append_byte(cast<u8>(10));
    try artifact.append_bytes("}");

    let bytes = artifact.as_bytes();
    print(bytes);

    return;
}

// run
// features: std-string std-fmt artifact
// output:
// define i64 @main() {
//   ret i64 42
// }


// check
// load:
// fn main() -> !void { let allocator = std::mem::page_allocator(); var artifact = std::string::new(allocator); defer artifact.deinit(); try artifact.reserve(64); try artifact.append_bytes("define i64 @main() {"); try artifact.append_byte(cast<u8>(10)); try artifact.append_bytes("  ret i64 "); try std::fmt::append_i64(artifact, 42); try artifact.append_byte(cast<u8>(10)); try artifact.append_bytes("}"); let bytes = artifact.as_bytes(); print(bytes); return; }
// check:
// ok
