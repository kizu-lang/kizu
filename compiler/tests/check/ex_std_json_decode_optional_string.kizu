import std::json;
import std::mem;
import std::string;

// A string field a document may leave out is the common JSON shape, and it
// needs an optional that owns its bytes. Both ways of saying the value is
// absent read the same, because `?T` cannot hold the difference (ADR-0121).
pub struct Visitor {
    pub name: string::String,
    pub nick: ?string::String,
}

fn (self: Visitor) deinit(allocator: Allocator) -> void {
    self.name.deinit(allocator);
    if self.nick |held| {
        held.deinit(allocator);
    }
    return;
}

fn show(visitor: &Visitor) -> void {
    if visitor.nick |held| {
        let bytes = held.as_bytes();
        print(bytes);
    } else {
        print("no nick");
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();

    var given = try json::decode<Visitor>(allocator, \\{"name": "alice", "nick": "al"}
    );
    defer given.deinit(allocator);
    show(&given);

    var written = try json::decode<Visitor>(allocator, \\{"name": "alice", "nick": null}
    );
    defer written.deinit(allocator);
    show(&written);

    var omitted = try json::decode<Visitor>(allocator, \\{"name": "alice"}
    );
    defer omitted.deinit(allocator);
    show(&omitted);

    var out = string::new(allocator);
    defer out.deinit(allocator);
    try json::encode<Visitor>(allocator, &given, &var out);
    let text = out.as_bytes();
    print(text);
    return;
}

// run
// features: std-json decode encode optional owner std-string
// output:
// al
// no nick
// no nick
// {"name":"alice","nick":"al"}

