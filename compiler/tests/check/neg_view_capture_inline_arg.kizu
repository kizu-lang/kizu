struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn consume(it: BytesIter) -> i64 {
    return it.index;
}

fn main() -> !void {
    var buf = [4]u8{};
    let view = buf.as_bytes();
    print(consume(BytesIter { bytes: view, index: 0 }));
    return;
}

// check-fails
// features: borrow view-capture diagnostics
// error: borrowed value `view` cannot escape


