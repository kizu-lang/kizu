import std::math;

// Compile-time float arithmetic is f64. An f32 value is f64 rounded once on
// the way back, which a `cast<f32>` of the folded f64 spells.
fn main() -> void {
    let x = comptime math::cos<f32>(1.0);
    print(x);
}

// check-fails
// features: comptime float
// error: comptime error: `std::math::cos` is evaluated at compile time for f64 only, got `f32`

// check
// load:
// fn main() -> void { let x = comptime std::math::cos<f32>(1.0); print(x); }
// check:
