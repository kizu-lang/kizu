import std::array;
import std::mem;

fn leak_out() -> array::Array<i64> {
    var buf = [4096]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    let values = array::new<i64>(alloc);
    return values;
}

fn main() -> !void {
    var values = leak_out();
    values.deinit();
    return;
}

// check-fails
// features: allocator fixed-buffer borrow
// error: value `values` is allocated from a tied allocator and cannot escape its frame


