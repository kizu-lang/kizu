import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let alice = users.add(User { name: "alice" });
    let user = users.at(alice);
    print(user.name);
    users.deinit(allocator);
}

// run
// features: arena handle shared-borrow
// output:
// alice

