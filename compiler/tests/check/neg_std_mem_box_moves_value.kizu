import std::mem;

struct Item {
    value: i64,
}

fn (self: Item) deinit(allocator: Allocator) -> void {
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let value = Item { value: 1 };
    let item = try mem::box<Item>(allocator, move value);
    print(value.value);
    item.deinit(allocator);
    return;
}

// check-fails
// features: std-mem box move
// error: moved value `value` was used

