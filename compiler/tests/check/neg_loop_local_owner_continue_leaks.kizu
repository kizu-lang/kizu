import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var count = 0;
    while count < 3 {
        let name = try string::from_bytes(allocator, "abc");
        count = count + 1;
        if count == 2 {
            continue;
        }
        name.deinit(allocator);
    }
    return;
}

