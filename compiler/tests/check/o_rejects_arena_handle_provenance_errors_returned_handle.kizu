import std;
struct User { name: []u8 }
fn make() -> !std::arena::Handle<User> {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    defer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    return alice;
}


