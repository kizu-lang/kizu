// A struct passed by value is rewritten into the registers or the memory the
// target's C convention gives it, and a variadic call has to say exactly
// where its named parameters end. A variadic function takes a struct as
// `&S`, which is one pointer.
extern "c" struct Point {
    x: i32,
    y: i32,
}

extern "c" fn describe(point: Point, format: ptr<const u8>, ...) -> i32
fn main() -> void {
    return;
}

// check-fails
// features: extern-c extern-struct diagnostic
// error: C variadic function `describe` parameter 1 passes `Point` by value; lend it as `&Point`

// check
// load:
// extern "c" struct Point { x: i32, y: i32 }
// extern "c" fn describe(point: Point, format: ptr<const u8>, ...) -> i32
// fn main() -> void { return; }
// check:
// 10:15-10:23 type error: C variadic function `describe` parameter 1 passes `Point` by value; lend it as `&Point`
