import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

// The handle arrives from outside, so nothing here says which arena it came
// from and `at` is allowed. The arena is this frame's, so the borrow it hands
// back dies with the frame and cannot be returned.
fn escaped(alice: arena::Handle<User, UserArena>) -> &User {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    defer users.deinit(allocator);
    return users.at(alice);
}

fn main() {}

// check-fails
// features: arena borrow escape
// error: Arena.at borrow from local `users` cannot escape

