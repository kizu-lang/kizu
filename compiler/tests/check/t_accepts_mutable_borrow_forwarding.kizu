struct User { name: []u8 }
fn rename(user: &var User) -> void { user.name = "bob" ;}
fn outer(user: &var User) -> void {
    rename(user);
    user.name = "carol";
}
fn main() -> void {
    var user = User { name: "alice" };
    outer(user);
}

