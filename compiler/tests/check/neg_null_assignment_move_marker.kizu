fn show(value: ?i64) {
    print(value orelse -1);
}

// Assigning `null` leaves `slot` the `?i64` it was declared as. It still
// copies, so a `move` on it marks a hand-off that does not happen.
fn main() {
    var slot: ?i64 = 1;
    slot = null;
    show(move slot);
}

// check-fails
// features: optional null move diagnostic
// error: `slot` is copy data and hands nothing off

