struct Counter { count: i64 }
struct Holder { counter: Counter }
fn (self: &var Counter) load(owner: &Holder) -> void {
    self.count = owner.counter.count;
}
fn (self: &var Holder) go() -> void {
    self.counter.load(&self);
}


