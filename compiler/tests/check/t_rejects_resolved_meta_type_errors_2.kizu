import std;
struct Item { pub value: i64 }
fn inspect<T>() -> bool {
    comptime for std::meta::public_fields<T>() |f| {
        comptime if type<std::meta::variant_type<T, f>> == type<i64> {
            return true;
        } else {
            return false;
        }
    }
    return false;
}
fn main() -> void { print(inspect<Item>()); }

