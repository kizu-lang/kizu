import std::string;

pub struct Visitor {
    pub nick: ?string::String,
}

// The deinit opens `nick` but drops what it finds. Opening the field is what
// discharges its obligation, so the payload has to be released here.
fn (self: Visitor) deinit() -> void {
    if self.nick |held| {
        let bytes = held.as_bytes();
        print(bytes);
    }
    return;
}

fn main() -> !void {
    var visitor = Visitor { nick: null };
    defer visitor.deinit();
    return;
}

// check-fails
// features: optional owner diagnostics
// error: owned value `held` is never deinitialized


