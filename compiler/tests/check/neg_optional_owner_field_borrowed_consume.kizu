import std::mem;
import std::string;

pub struct Visitor {
    pub nick: ?string::String,
}

fn (self: Visitor) deinit(allocator: Allocator) -> void {
    if self.nick |held| {
        held.deinit(allocator);
    }
    return;
}

// The payload lives in the visitor's storage, and this function only borrows
// the visitor. Consuming what the capture binds would release memory the
// visitor still believes it owns, and its own `deinit` would release it again.
fn drop_nick(allocator: Allocator, visitor: &Visitor) -> void {
    if visitor.nick |held| {
        held.deinit(allocator);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var visitor = Visitor { nick: null };
    defer visitor.deinit(allocator);
    drop_nick(allocator, &visitor);
    return;
}

