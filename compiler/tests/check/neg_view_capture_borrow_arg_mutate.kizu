import std::mem;
import std::string;

struct SplitView {
    pub left: []u8,
    pub right: []u8
}

fn split_text(text: &string::String) -> ?SplitView {
    let bytes = text.as_bytes();
    return SplitView {
        left: bytes[0..1],
        right: bytes[1..mem::len(bytes)]
    };
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = try string::from_bytes(allocator, "abc");
    defer text.deinit(allocator);
    if split_text(&text) |parts| {
        try text.append_bytes(allocator, "d");
        print(parts.left);
    }
    return;
}

// check-fails
// features: borrow view-capture diagnostics transitive
// error: String.append_bytes` cannot run while string is borrowed

