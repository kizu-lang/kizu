import std;
fn main() -> !void {
    var buf = [512]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = std::mem::fixed_buffer(scratch);
    var values = std::array::new<i64>(alloc);
    defer values.deinit();
    let sneak = buf.as_mut_bytes();
    sneak[0] = cast<u8>(1);
    try values.append(1);
    return;
}


