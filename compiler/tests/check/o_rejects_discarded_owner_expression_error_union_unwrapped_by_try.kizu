import std;
fn make(allocator: Allocator) -> !std::string::String {
    let name = std::string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_byte(cast<u8>(97));
    return move name;
}
fn main() -> !void {
    let allocator = std::mem::page_allocator();
    try make(allocator);
    return;
}


