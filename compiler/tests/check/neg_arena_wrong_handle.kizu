import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let left = arena::new<User>(allocator);
    let right = arena::new<User>(allocator);
    let alice = left.add(User { name: "alice" });
    print(right.at(alice).name);
}

// check-fails
// features: arena handle
// error: handle `alice` does not belong to arena `right`


