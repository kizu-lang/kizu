// A Future retains its evented Io until cleanup, so the loop behind that Io
// cannot be released while the worker is still alive.

import std::io;
import std::mem;

struct Counter {
    seen: i64,
}

fn bump(handle: Io, allocator: Allocator, job: &var Counter) -> void {
    job.seen = job.seen + 1;
    return;
}

fn main() -> !void {
    var loop = try io::loop_new();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();
    var job = Counter { seen: 0 };
    var future = try io::async<Counter>(handle, allocator, bump, &var job);
    loop.deinit();
    future.deinit(allocator);
    return;
}

// check-fails
// features: io evented async borrow
// error: value `loop` cannot be moved while borrowed

