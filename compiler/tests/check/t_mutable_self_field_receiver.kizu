struct Counter { count: i64 }
fn (self: &var Counter) bump() -> void { self.count = self.count + 1; }
struct Holder { counter: Counter }
fn (self: &var Holder) go() -> void {
    self.counter.bump();
}
fn main() -> void {
    var h = Holder { counter: Counter { count: 0 } };
    h.counter.bump();
    h.go();
}

