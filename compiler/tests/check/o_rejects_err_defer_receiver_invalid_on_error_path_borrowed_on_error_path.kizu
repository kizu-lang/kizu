import std;
struct User { name: []u8 }
fn step() -> !void { return; }
fn build() -> !std::arena::Arena<User> {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    errdefer users.deinit(allocator);
    let borrowed = &users;
    try step();
    print(borrowed);
    return users;
}


