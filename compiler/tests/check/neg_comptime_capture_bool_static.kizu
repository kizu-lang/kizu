// An integer-range capture forwards like an integer literal: it fills an
// integer static parameter, and a bool parameter still wants `true` or
// `false`.
fn choose<first: bool>(x: i64, y: i64) -> i64 {
    comptime if first {
        return x;
    }
    return y;
}

fn main() -> void {
    comptime for 0..2 |i| {
        print(choose<i>(1, 2));
    }
}

// check-fails
// features: comptime comptime-for generics
// error: type error: `choose` static argument `first` expects bool, got `i`

