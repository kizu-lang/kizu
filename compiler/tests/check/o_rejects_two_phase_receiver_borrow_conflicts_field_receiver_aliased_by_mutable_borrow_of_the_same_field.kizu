struct Counter { count: i64 }
fn (self: &var Counter) steal(other: &var Counter) -> void {
    self.count = other.count;
}
struct Holder { counter: Counter }
fn (self: &var Holder) go() -> void {
    self.counter.steal(&var self.counter);
}


