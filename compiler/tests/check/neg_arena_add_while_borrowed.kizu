import std::arena;
import std::mem;

struct User {
    visits: i64,
}

// `add` grows storage by realloc, which moves every element a live borrow
// points into, so it waits for the at_mut capture to end.
fn main() {
    let allocator = mem::page_allocator();
    var users = arena::new<User>(allocator);
    let alice = users.add(User { visits: 0 });
    if users.at_mut(alice) |u| {
        let _ = users.add(User { visits: 1 });
        u.visits = 1;
    }
    users.deinit();
}

// check-fails
// features: arena mutable-borrow
// error: Arena.add` cannot run while arena is borrowed


