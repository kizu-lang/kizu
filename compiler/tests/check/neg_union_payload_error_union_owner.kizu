import std::string;

error Failure { Bad }

// An owner inside `E!T` is released only by the `if` that opens it, and a
// union's cleanup arm is one direct call: there is no place to open the
// payload, so the value could never be released.
union Slot {
    Kept(Failure!string::String),
    Vacant,
}

fn main() -> void {
    print("end");
    return;
}

// check-fails
// features: union error-union ownership
// error: union payload `Slot::Kept` cannot store an error union around an owner

