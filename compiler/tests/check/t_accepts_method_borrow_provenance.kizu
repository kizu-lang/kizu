struct Picker {
    bytes: []u8,
}
fn (self: &Picker) from_self() -> []u8 {
    return self.bytes;
}
fn (self: &Picker) from_arg(value: []u8) -> []u8 {
    return value;
}
fn forward_self(picker: &Picker) -> []u8 {
    let view = picker.from_self();
    return view;
}
fn forward_arg(picker: &Picker, value: []u8) -> []u8 {
    let view = picker.from_arg(value);
    return view;
}
fn main() {}

