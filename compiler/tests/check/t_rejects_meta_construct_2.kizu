import std;
struct Counts { pub visits: i64 }
fn wrong<T, f: Field>(base: i64) -> ![]u8 { return std::meta::field_name<T, f>(); }
fn main() -> !void {
    let counts = try std::meta::construct<Counts, wrong>(1);
    print(counts.visits);
    return;
}

