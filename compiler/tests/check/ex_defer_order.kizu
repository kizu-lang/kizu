import std::mem;

struct Trace {
    label: []u8,
}

fn (self: Trace) deinit(allocator: Allocator) -> void {
    print(self.label);
}

fn run() -> i64 {
    let allocator = mem::page_allocator();
    let first = Trace { label: "first" };
    defer first.deinit(allocator);

    if true {
        let inner = Trace { label: "inner" };
        defer inner.deinit(allocator);
    }

    let second = Trace { label: "second" };
    defer second.deinit(allocator);

    return 7;
}

fn main() {
    print(run());
}

// run
// features: defer cleanup block-exit return
// output:
// inner
// second
// first
// 7

