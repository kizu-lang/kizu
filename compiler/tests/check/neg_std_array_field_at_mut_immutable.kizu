import std::array;
import std::mem;

struct Registry {
    users: array::Array<i64>,
}

// A field of an immutable owner is not a mutable place.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let reg = Registry { users: array::new<i64>(allocator) };
    defer reg.deinit();
    try reg.users.append(7);
    if reg.users.at_mut(0) |v| {
        v.* = 8;
    }
    return;
}

// check-fails
// features: std-array borrow optional mutability
// error: Array.at_mut` requires mutable array binding


