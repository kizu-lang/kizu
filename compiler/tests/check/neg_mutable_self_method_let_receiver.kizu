struct Counter {
    count: i64,
}

fn (self: &var Counter) bump() -> void {
    self.count = self.count + 1;
    return;
}

fn main() {
    let hits = Counter { count: 0 };
    hits.bump();
    print(hits.count);
}

// check-fails
// features: method receiver mutable-borrow diagnostics
// error: method `Counter.bump` takes `&var self`, receiver `hits` must be mutable


