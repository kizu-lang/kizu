import std::array;
import std::mem;

struct Registry {
    users: array::Array<i64>,
}

// A field capture mutably borrows the owner's field, so reaching the owner
// again inside the capture waits like any read under a mutable borrow.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var reg = Registry { users: array::new<i64>(allocator) };
    defer reg.deinit();
    try reg.users.append(7);
    if reg.users.at_mut(0) |v| {
        try reg.users.append(9);
        v.* = 8;
    }
    return;
}

// check-fails
// features: std-array mutable-borrow
// error: cannot be read while mutably borrowed


