import std::array;
import std::string;
struct Store {
    parts: array::Array<string::String>,
}
fn view(store: &Store, index: i64) -> ![]u8 {
    let parts = &store.parts;
    if parts.at(index) |part| {
        let length = part.len();
        let bytes = part.as_bytes();
        return bytes[0..length];
    }
    return "";
}
fn main() {}

