struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}
fn make() -> BytesIter {
    var buf = [16]u8{};
    let view = buf.as_bytes();
    let it = BytesIter { bytes: view, index: 0 };
    return it;
}
fn main() -> !void {
    let it = make();
    print(it.index);
    return;
}


