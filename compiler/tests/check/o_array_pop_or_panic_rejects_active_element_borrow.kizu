import std;
struct Parsed { values: std::array::Array<i64> }
fn (self: Parsed) deinit() -> void {
    self.values.deinit();
}
fn observe(value: &Parsed) -> void {}
fn check(values: std::array::Array<Parsed>) -> !void {
    if values.at(0) |first| {
        let value = values.pop_or_panic();
        observe(first);
        value.deinit();
    }
    values.deinit();
    return;
}
fn main() {}


