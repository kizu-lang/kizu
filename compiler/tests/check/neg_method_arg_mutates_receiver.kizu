struct Registry {
    cursor: i64,
}

fn (self: &var Registry) next() -> i64 {
    self.cursor = self.cursor + 1;
    return self.cursor;
}

fn (self: &var Registry) select(index: i64) -> void {
    self.cursor = index;
}

// Arguments may read a `&var self` receiver, but a nested call that mutates
// the same receiver overlaps the reserved borrow.
fn (self: &var Registry) advance() -> void {
    self.select(self.next());
}

fn main() -> void {
    var reg = Registry { cursor: 1 };
    reg.advance();
}

// check-fails
// features: method receiver mutable-borrow borrow-check
// error: mutates its receiver while it is borrowed


