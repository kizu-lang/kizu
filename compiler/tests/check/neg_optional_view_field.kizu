// A view's obligation is a borrow, and the capture that would open this field
// is invisible to the rules that read field types. An owner optional states its
// obligation through the struct's `deinit`; a view has nothing to state it
// with, so it stays out.
struct Holder {
    pub bytes: ?[]u8,
}

fn main() -> !void {
    print(1);
    return;
}

// check-fails
// features: optional diagnostics
// error: struct field `Holder.bytes` cannot store an optional view


