import std;
struct UserArena {}

struct User { name: []u8 }
fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User, UserArena>(allocator);
    defer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    let p = cast<ptr<User>>(alice);
    print(p);
    return;
}

