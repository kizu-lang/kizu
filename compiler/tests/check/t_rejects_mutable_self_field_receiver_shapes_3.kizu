struct Counter { count: i64 }
fn (self: &var Counter) bump() -> void { self.count = self.count + 1; }
struct Inner { counter: Counter }
struct Outer { inner: Inner }
fn main() -> void {
    let o = Outer { inner: Inner { counter: Counter { count: 0 } } };
    o.inner.counter.bump();
}

