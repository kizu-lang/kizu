import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn make() -> arena::Arena<User, UserArena> {
    let allocator = mem::page_allocator();
    return arena::new<User, UserArena>(allocator);
}

fn main() {
    let allocator = mem::page_allocator();
    make().deinit(allocator);
}

// check-fails
// features: arena deinit
// error: requires local arena receiver

