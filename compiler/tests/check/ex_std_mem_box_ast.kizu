import std::mem;
import std::testing;

pub struct Span {
    pub start: i64,
    pub end: i64,
}

pub struct BinaryExpr {
    pub left: mem::Box<Expr>,
    pub right: mem::Box<Expr>,
}

pub union Expr {
    Ident(Span),
    Binary(BinaryExpr),
}

fn (self: Expr) deinit() -> void {
    match self {
        Ident(_) => return,
        Binary(binary) => binary.deinit(),
    }
}

fn expect_ident(expr: &Expr, expected: i64) -> !void {
    match expr {
        Ident(span) => testing::expect(expected == span.start),
        Binary(binary) => testing::fail("unexpected binary"),
    }
    return;
}

fn expect_binary(binary: BinaryExpr) -> !void {
    defer binary.deinit();
    let borrowed = binary.left.borrow();
    try expect_ident(borrowed, 1);
    return;
}

// make_binary builds its node behind one cleanup boundary: error paths release
// the boxed child, the success return moves the whole node out.
fn make_binary(allocator: Allocator) -> !Expr {
    let left_span = Span {
        start: 1,
        end: 4
    };
    let right_span = Span {
        start: 5,
        end: 8
    };
    let left = try mem::box<Expr>(allocator, Expr::Ident(left_span));
    errdefer left.deinit();
    let right = try mem::box<Expr>(allocator, Expr::Ident(right_span));
    return Expr::Binary(BinaryExpr {
        left: move left,
        right: move right
    });
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let expr = try make_binary(allocator);
    match expr {
        Ident(span) => testing::expect_equal<i64>(0, span.start),
        Binary(binary) => try expect_binary(move binary),
    }
    return;
}

