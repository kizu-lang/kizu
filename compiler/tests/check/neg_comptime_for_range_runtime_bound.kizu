// The bounds of an integer-range `comptime for` are comptime integers: the
// loop is unrolled while checking, so a bound only known at run time has no
// number to unroll to. A range on a runtime value is the runtime `for`.
fn sum_to(n: i64) -> i64 {
    var total = 0;
    comptime for 0..n |i| {
        total = total + i;
    }
    return total;
}

fn main() -> void {
    print(sum_to(4));
}

// check-fails
// features: comptime comptime-for
// error: comptime error: runtime value cannot be used

