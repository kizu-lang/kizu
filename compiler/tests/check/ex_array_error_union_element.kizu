import std::array;
import std::mem;

error ComputeError {
    Nope,
}

fn ok(value: i64) -> !i64 {
    return value;
}

fn bad() -> !i64 {
    return ComputeError::Nope;
}

fn count(results: &array::Array<!i64>) -> i64 {
    return results.len();
}

fn main() -> !void {
    var results = array::new<!i64>(mem::page_allocator());
    defer results.deinit(mem::page_allocator());
    try results.append(ok(7));
    try results.append(bad());
    print(count(&results));
    return;
}

// run
// features: std-array error-union generics
// output:
// 2

// check
// load:
