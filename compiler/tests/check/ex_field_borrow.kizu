struct User {
    name: []u8,
    age: i64,
}

fn main() -> void {
    var user = User { name: "alice", age: 30 };
    let name = &user.name;
    user.age = 31;
    print(name.*);
    print(user.age);
}

// run
// features: borrow field-borrow ownership
// output:
// alice
// 31


