// A returned `E1!T` has to fail only in ways the declared `E!T` names; a set
// with members outside E does not return into it, as `try` would not
// propagate it.
import std::mem;

error ParseError {
    Invalid,
}

fn allocate(n: i64) -> mem::Error!i64 {
    return n;
}

fn parse(n: i64) -> ParseError!i64 {
    return allocate(n);
}

pub fn main() -> void {
    return;
}


