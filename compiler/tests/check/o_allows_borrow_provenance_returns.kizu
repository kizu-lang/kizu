fn shared(value: &i64) -> &i64 {
    return value;
}
fn mutable(value: &var i64) -> &var i64 {
    return value;
}
fn main() {
    var value = 1;
    let read = shared(value);
    print(read.*);
    let write = mutable(value);
    write.* = 2;
    print(value);
}


