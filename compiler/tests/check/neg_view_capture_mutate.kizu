struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn fill(bytes: &var []u8) -> void {
    bytes[0] = 9;
    return;
}

fn main() -> !void {
    var buf = [4]u8{};
    let view = buf.as_bytes();
    let it = BytesIter { bytes: view, index: 0 };
    let scratch = buf.as_mut_bytes();
    fill(scratch);
    print(it.index);
    return;
}

// check-fails
// features: borrow view-capture diagnostics
// error: value `buf` cannot be mutably borrowed while borrowed

