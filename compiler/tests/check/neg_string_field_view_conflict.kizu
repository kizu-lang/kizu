import std::mem;
import std::string;

pub struct Holder {
    pub name: string::String,
}

// The view borrows `holder` under the path `name`, so the string it looks at
// cannot grow while it is alive: appending can move the buffer, and the view
// would point at the old one.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var holder = Holder { name: string::new(allocator) };
    defer holder.deinit();

    let seen = holder.name.as_bytes();
    try holder.name.append_bytes("grow");
    print(seen);
    return;
}

// check-fails
// features: borrow field-path std-string view diagnostics
// error: `String.append_bytes` cannot run while string is borrowed


