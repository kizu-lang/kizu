import std;
struct UserArena {}

struct User { name: []u8 }
fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User, UserArena>(allocator);
    errdefer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    users.deinit(allocator);
    print(alice);
    return;
}


