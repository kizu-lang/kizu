import std;
struct User { name: []u8 }
struct Registry { users: std::arena::Arena<User> }
fn (self: Registry) deinit() -> void {
    self.users.deinit();
    self.users.add(User { name: "alice" });
    return;
}
fn main() {
    let allocator = std::mem::page_allocator();
    let registry = Registry { users: std::arena::new<User>(allocator) };
    registry.deinit();
}


