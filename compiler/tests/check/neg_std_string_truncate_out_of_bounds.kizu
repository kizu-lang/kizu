import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "abc");
    try text.truncate(4);
    return;
}

// run-fails
// features: std-string runtime-check error-union
// error: std::string::Error::InvalidLength

