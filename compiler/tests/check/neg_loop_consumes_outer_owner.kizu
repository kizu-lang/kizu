import std::mem;
import std::string;

// The body runs an unknown number of times: zero leaves the string unreleased,
// two release it twice. A value a loop consumes is one the loop itself
// produced, which is what a `|name|` capture binds.
fn drop_repeatedly(allocator: Allocator, count: i64) -> void {
    var name = string::new(allocator);
    var i = 0;
    while i < count {
        name.deinit(allocator);
        i = i + 1;
    }
    return;
}

fn main() -> void {
    let allocator = mem::page_allocator();
    drop_repeatedly(allocator, 3);
    return;
}

// check-fails
// features: ownership deinit std-string loop
// error: owned value `name` is consumed inside a loop

