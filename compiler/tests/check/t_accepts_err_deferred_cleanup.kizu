import std;
struct User {
    name: []u8,
}
fn build() -> !std::arena::Arena<User> {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User>(allocator);
    errdefer users.deinit();
    return users;
}
fn main() {}

