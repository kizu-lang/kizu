import std::mem;
import std::string;

error Failure { Bad }

struct Item {
    name: string::String,
}

fn make(allocator: Allocator, ok: bool) -> Failure!Item {
    if !ok {
        return Failure::Bad;
    }
    let name = string::from_bytes(allocator, "abc") catch return Failure::Bad;
    return Item { name: move name };
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    if make(allocator, true) |item| {
        print(item.name.len());
    } else |err| {
        print("err");
    }
    return;
}

// check-fails
// features: error-union ownership
// error: owned value `item` is never deinitialized

