pub union Shape {
    Point,
    Circle(i64),
}

fn area<T>(value: &T) -> void {
    comptime match value |v, payload| {
        // `Point` carries nothing, so in its expansion there is no payload
        // type to name and no `payload` to bind. Which expansion this is, is
        // what `has_payload<T, v>()` answers, and the two cases are written
        // apart because they are different: one has a value, one is a name.
        try_encode<std::meta::variant_type<T, v>>(payload);
    }
    return;
}

fn try_encode<T>(value: &T) -> void {
    return;
}

fn main() -> void {
    let shape = Shape::Circle(2);
    area<Shape>(&shape);
    return;
}

