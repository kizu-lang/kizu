struct User {
    name: []u8,
}

fn take(user: User) -> void {
    print(user.name);
}

fn main() -> void {
    let user = User { name: "alice" };
    let ref = &user;
    var i = 0;
    while i < 1 {
        print(ref.name);
        i = i + 1;
    }
    take(user);
}

// check-fails
// features: borrow last-use loop
// error: value `user` cannot be moved while borrowed

