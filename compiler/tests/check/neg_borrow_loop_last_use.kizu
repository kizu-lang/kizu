struct User {
    name: []u8,
}

fn take(user: User) -> void {
    print(user.name);
}

// The loop reads `ref` on every turn, so `user` stays borrowed for the whole
// body: a hand-off after the read still meets the read of the next turn.
fn main() -> void {
    let user = User { name: "alice" };
    let ref = &user;
    var i = 0;
    while i < 1 {
        print(ref.name);
        take(move user);
        i = i + 1;
    }
}

// check-fails
// features: borrow last-use loop
// error: value `user` cannot be moved while borrowed

