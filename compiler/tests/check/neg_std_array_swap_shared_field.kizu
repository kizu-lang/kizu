import std::array;
import std::mem;

struct Values {
    items: array::Array<i64>,
}

fn reorder(values: &Values) -> !void {
    return values.items.swap(0, 1);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var items = array::new<i64>(allocator);
    errdefer items.deinit();
    try items.append(1);
    try items.append(2);
    let values = Values { items: move items };
    defer values.items.deinit();
    try reorder(&values);
    return;
}

// check-fails
// features: std-array swap mutable-borrow field
// error: `Array.swap` requires mutable Array receiver


