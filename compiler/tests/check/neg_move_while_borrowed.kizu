struct Name {
    value: []u8,
}

fn use(left: &Name, right: Name) -> void {
    print(left.value);
    print(right.value);
}

fn main() -> void {
    let name = Name { value: "alice" };
    use(name, name);
}

// check-fails
// features: borrow move
// error: value `name` cannot be moved while borrowed

