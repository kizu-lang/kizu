import std::arena;
import std::mem;

struct UserArena {}
struct UserArena2 {}

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let left = arena::new<User, UserArena>(allocator);
    defer left.deinit(allocator);
    let right = arena::new<User, UserArena2>(allocator);
    defer right.deinit(allocator);
    print(right.at(try left.add(allocator, User { name: "alice" })).name);
    return;
}

// check-fails
// features: arena handle
// error: handle from `left` does not belong to arena `right`

