import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let left = arena::new<User>(allocator);
    let right = arena::new<User>(allocator);
    print(right.at(left.add(allocator, User { name: "alice" })).name);
}

// check-fails
// features: arena handle
// error: handle from `left` does not belong to arena `right`

