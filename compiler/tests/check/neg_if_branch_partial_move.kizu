struct Name {
    value: []u8,
}

fn take(name: Name) -> void {
    print(name.value);
}

fn main() -> void {
    let name = Name { value: "alice" };
    if false {
        take(move name);
    } else {
        print("kept");
    }
    print(name.value);
}

// check-fails
// features: if move
// error: moved value `name` was used


