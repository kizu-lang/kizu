/// data は少なくとも len バイトの有効なメモリを指す。
unsafe struct Buf {
    data: ptr<u8>,
    len: usize,
}

fn shrink(b: &var Buf, n: usize) -> void {
    b.len = n;
}

// check-fails
// features: unsafe-struct raw-pointer
// error: write to field `Buf.len` requires `unsafe`


