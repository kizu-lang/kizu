// load:
// extern "c" fn strlen(text: []u8) -> usize
// fn main() -> void { let n = unsafe strlen("hello"); print(cast<i64>(n)); return; }
// check:
// 3:15-3:21 type error: C function `strlen` parameter 1 has type `[]u8`, which C cannot receive
//   note: a C function passes only what C can name: an integer, a float, `bool`, `ptr<T>`, `ptr<const T>`, or a nullable pointer
//   help: spell the value as C sees it: `ptr<const u8>` with a `usize` length for bytes, `ptr<T>` for a value C reads or writes in place
