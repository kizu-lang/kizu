extern "c" struct Pair {
    first: i32,
    second: i32,
}

extern "c" fn scan(text: ptr<const u8>, format: ptr<const u8>, ...) -> i32
fn main() -> void {
    var pair = Pair { first: 0, second: 0 };
    // SAFETY: pair is live for the call.
    print(unsafe scan(c"5", c"%d %p", &var pair, &pair));
    return;
}

