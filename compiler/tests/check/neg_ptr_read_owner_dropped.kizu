// A read through a pointer gives the pointee, so an owner read out is one
// more owner of what the pointee holds: it has to go back with `ptr_write`,
// or be released, not be dropped.
import std::string;

fn length(p: ptr<string::String>) -> i64 {
    // SAFETY: p points at a live String.
    let text = unsafe ptr_read(p);
    return text.len();
}

pub fn main() -> void {
    return;
}


