import std::map;
import std::mem;

fn define(symbols: &map::Map<[]u8, i64>) -> !void {
    try symbols.insert("main", 1);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let symbols = map::new<[]u8, i64>(allocator);

    try define(&symbols);

    symbols.deinit();
    return;
}

// check-fails
// features: std-map borrow mutation
// error: requires mutable Map receiver


