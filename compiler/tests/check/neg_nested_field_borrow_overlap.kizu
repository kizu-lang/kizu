struct Profile {
    name: []u8,
}

struct User {
    profile: Profile,
}

fn main() -> void {
    var user = User { profile: Profile { name: "alice" } };
    let name = &user.profile.name;
    user.profile = Profile { name: "bob" };
    print(name.*);
}

// check-fails
// features: borrow field-borrow
// error: field `user.profile` cannot be assigned while borrowed


