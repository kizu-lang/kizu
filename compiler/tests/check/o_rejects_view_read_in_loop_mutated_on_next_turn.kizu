import std::mem;
import std::string;

// The loop reads the view again on its next turn, so the owner stays
// borrowed for the whole body, after the read as well as before it.
fn grow() -> !void {
    let allocator = mem::page_allocator();
    var drawn = try string::from_bytes(allocator, "abcd");
    defer drawn.deinit(allocator);
    let view = drawn.as_bytes();
    var index = 0;
    while index < 2 {
        print(cast<i64>(view[0]));
        try drawn.append_bytes(allocator, "x");
        index = index + 1;
    }
    return;
}

