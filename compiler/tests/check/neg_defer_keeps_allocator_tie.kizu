import std::array;
import std::mem;
import std::string;

// The deferred release runs when the block exits, so the allocator it names
// is in use until then, and so is the string that backs the allocator.
fn main() -> !void {
    let page = mem::page_allocator();
    var text = try string::from_bytes(page, "scratch space for a fixed buffer");
    errdefer text.deinit(page);
    let scratch = text.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    var values = array::new<i64>(alloc);
    defer values.deinit(alloc);
    text.deinit(page);
    return;
}

// check-fails
// features: defer tied-allocator borrow std-string
// error: cannot run while string is borrowed

