import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    defer users.deinit(allocator);
    users.deinit(allocator);
}

// check-fails
// features: defer arena deinit
// error: arena `users` was deinitialized

