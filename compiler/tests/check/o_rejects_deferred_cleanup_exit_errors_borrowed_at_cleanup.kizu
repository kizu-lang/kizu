import std;
struct UserArena {}

struct User { name: []u8 }
fn main() {
    let allocator = std::mem::page_allocator();
    let users = std::arena::new<User, UserArena>(allocator);
    let borrowed = &users;
    defer users.deinit(allocator);
    while false { print(borrowed); }
}


