struct Name { value: []u8 }
fn pick(left: Name, right: Name) -> Name {
    let chosen = if true { move left } else { move right };
    return move chosen;
}
fn main() {
    let left = Name { value: "left" };
    let right = Name { value: "right" };
    let chosen = pick(move left, move right);
    print(left.value);
    print(chosen.value);
}


