import std::array;
import std::mem;

struct User {
    age: i64,
    visits: i64,
}

struct Registry {
    users: array::Array<User>,
}

// A borrow-optional return makes the accessor a function: the contract is
// derived from the signature (the result borrows `self`), the body may only
// return a borrow rooted in a borrowed parameter, and the caller's capture
// holds `self` borrowed for its scope.
fn (self: &var Registry) user(id: i64) -> ?&var User {
    return self.users.at_mut(id);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var reg = Registry { users: array::new<User>(allocator) };
    defer reg.deinit();
    try reg.users.append(User { age: 30, visits: 0 });
    if reg.user(0) |u| {
        u.visits = u.visits + 1;
    }
    if reg.user(0) |u| {
        print(u.visits);
        print(u.age);
    }
    return;
}

// run
// features: borrow optional signature accessor
// output:
// 1
// 30


