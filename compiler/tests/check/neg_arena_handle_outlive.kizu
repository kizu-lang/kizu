import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn make() -> !arena::Handle<User, UserArena> {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    errdefer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    return alice;
}

// check-fails
// features: arena handle
// error: handle `alice` cannot outlive its arena

