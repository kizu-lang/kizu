import std::map;
import std::mem;

// `Map.at` produces a borrow optional, and a capture is its only consumer:
// a stored `?&V` would hold a value borrow no binding ties to the map.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit(allocator);

    try counts.insert("kizu", 1);
    let count = counts.at("kizu");
    return;
}

// check-fails
// features: std-map borrow optional capture
// error: Map.at` must be consumed by a capture

// check
// load:
// fn main() -> !void { let allocator = std::mem::page_allocator(); var counts = std::map::new<[]u8, i64>(allocator); defer counts.deinit(allocator); try counts.insert("kizu", 1); let count = counts.at("kizu"); return; }
// check:
// - type error: `Map.at` must be consumed by a capture (`if m.at(key) |name|` or `while m.at(key) |name|`)
