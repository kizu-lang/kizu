import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let borrowed = &users;
    borrowed.deinit(allocator);
}

// check-fails
// features: arena borrow deinit
// error: requires owned arena receiver

