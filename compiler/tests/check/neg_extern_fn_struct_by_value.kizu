// C passes a struct in registers differently per platform; a pointer says
// the same thing everywhere, so an extern struct is lent, not passed by value.
extern "c" struct Point {
    x: i64,
    y: i64,
}

extern "c" fn move_to(point: Point) -> void
pub fn main() -> void {
    return;
}


// check
// load:
// extern "c" struct Point { x: i64, y: i64 }
// extern "c" fn move_to(point: Point) -> void
// pub fn main() -> void { return; }
// check:
// 8:15-8:22 type error: C function `move_to` parameter 1 takes extern struct `Point` by value; lend it as `&Point` or `&var Point`
//   note: a C function passes only what C can name: an integer, a float, `bool`, `ptr<T>`, `ptr<const T>`, a nullable pointer, or an extern struct as `&S` / `&var S`
//   help: spell the value as C sees it: `ptr<const u8>` with a `usize` length for bytes, `ptr<T>` for a value C reads or writes in place
