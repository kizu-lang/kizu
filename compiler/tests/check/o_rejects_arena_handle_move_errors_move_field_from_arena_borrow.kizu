import std;
struct User { name: []u8 }
struct Box { user: User }
fn take(user: User) { print(user.name); }
fn main() {
    let allocator = std::mem::page_allocator();
    let boxes = std::arena::new<Box>(allocator);
    let h = boxes.add(allocator, Box { user: User { name: "alice" } });
    take(boxes.at(h).user);
}


