union Maybe {
    A(?u8),
    B(i64),
}

fn main() -> !void {
    let m = Maybe::B(1);
    match m {
        A(v) => print(v),
        B(x) => print(x),
    }
    return;
}

// check-fails
// features: optional union diagnostics
// error: union payload `Maybe::A` cannot store an optional yet


