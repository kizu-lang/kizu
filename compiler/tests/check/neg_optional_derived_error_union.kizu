import std::array;
import std::mem;

fn ok(value: i64) -> !i64 {
    return value;
}

// `?T` never spells an optional-wrapped error union, and a generic
// instantiation cannot mint one either: pop on Array<!i64> would return
// `?!i64`, so the call is rejected the same way the literal spelling is.
fn main() -> !void {
    var results = array::new<!i64>(mem::page_allocator());
    defer results.deinit(mem::page_allocator());
    try results.append(mem::page_allocator(), ok(7));
    let first = results.pop() orelse ok(0);
    print(try first);
    return;
}

// check-fails
// features: optional error-union generics diagnostics
// error: optional cannot wrap an error union `!i64`; spell it `E!?T`

