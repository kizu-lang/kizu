import std::math;

// Compile time evaluates the std::math functions whose bits the compiler
// reproduces for every target: sin, cos, sqrt, pi and tau. Any other runs
// when the program does.
fn main() -> void {
    let x = comptime math::exp<f64>(1.0);
    print(x);
}

// check-fails
// features: comptime float
// error: comptime error: `std::math::exp` is not evaluated at compile time (std::math sin, cos, sqrt, pi and tau are)

// check
// load:
// fn main() -> void { let x = comptime std::math::exp<f64>(1.0); print(x); }
// check:
// 7:5-7:42 comptime error: `std::math::exp` is not evaluated at compile time (std::math sin, cos, sqrt, pi and tau are)
