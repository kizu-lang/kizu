import std::io;

// An Io is a permission to reach something, and an evented one reaches this
// loop. Handing it back would be handing back a permission to reach memory
// that ends with the frame, so the tie the loop gives it does not leave.
fn leak() -> io::Error!Io {
    var loop = try io::loop_new();
    defer loop.deinit();
    return io::evented(&var loop);
}

fn main() -> io::Error!void {
    let handle = try leak();
    print(handle);
    return;
}

// check-fails
// features: io evented borrow
// error: `std::io::evented` returns a value tied to local state and cannot escape


