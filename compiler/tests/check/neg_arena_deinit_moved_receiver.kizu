import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let moved = move users;
    users.deinit();
    moved.deinit();
}

// check-fails
// features: arena move deinit
// error: moved value `users` was used


