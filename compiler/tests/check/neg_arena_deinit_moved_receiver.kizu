import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    let moved = move users;
    users.deinit(allocator);
    moved.deinit(allocator);
}

// check-fails
// features: arena move deinit
// error: moved value `users` was used

