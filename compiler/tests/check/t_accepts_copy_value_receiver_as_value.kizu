struct Pair {
    a: i64,
}
fn first(p: Pair) -> i64 {
    return p.a;
}
fn (self: Pair) head() -> i64 {
    return first(self);
}
fn (self: Pair) head2() -> i64 {
    let local = self;
    return first(local) + self.a;
}
fn main() -> void {
    let p = Pair { a: 7 };
    print(p.head() + p.head2());
}

