struct User {
    name: []u8,
}

fn clone_from_borrow(user: &var User) -> User {
    return user.*;
}

fn main() -> void {
    var user = User { name: "alice" };
    let cloned = clone_from_borrow(user);
    print(cloned.name);
}

// check-fails
// features: borrow mutable-borrow move deref
// error: cannot be moved out of borrow

