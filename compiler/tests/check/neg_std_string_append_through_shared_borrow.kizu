import std::mem;
import std::string;

fn add(allocator: Allocator, text: &string::String) -> !void {
    try text.append_bytes(allocator, "x");
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    try add(text);
    print(text.len());
    return;
}

// check-fails
// features: std-string borrow mutation
// error: requires mutable String receiver

