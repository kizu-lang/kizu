struct User {
    name: []u8,
}

fn take(user: User) -> void {
    print(user.name);
}

fn main() -> void {
    let user = User { name: "alice" };
    let ref = &user;
    take(user);
    print(ref.name);
}

// check-fails
// features: borrow last-use move
// error: value `user` cannot be moved while borrowed

