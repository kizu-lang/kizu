import harness::behavior;
import std::io;
import std::mem;
import std::process;

// The test harness: what `go test ./cmd/kizu` used to do in Go, done by a
// Kizu program against a compiler binary it is given. It is built and run by
// the compiler under test (stage1), from the repository root:
//
//     kizu run compiler/tests/harness -- behavior <kizu>
//
// `behavior` runs the cases internal/conformance's format declares that have
// to cross the selfhost CLI boundary (see behavior.kizu) with <kizu> and
// checks what each prints against its declaration.

fn main() -> !process::ExitStatus {
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    if process::arg_count() != 2 {
        try io::write_stderr_line(handle, "usage: harness behavior <kizu>");
        return process::ExitStatus::Failure;
    }
    let suite = try process::arg(0);
    if !mem::equal_bytes(suite, "behavior") {
        try io::write_stderr_line(handle, "usage: harness behavior <kizu>");
        return process::ExitStatus::Failure;
    }
    let kizu = try process::arg(1);
    if try behavior::run(handle, allocator, kizu) {
        return process::ExitStatus::Success;
    }
    return process::ExitStatus::Failure;
}
