.claude/
bin/
target/
result
# release.yml builds into dist/ inside the checkout; untracked files there
# would make the release binary's version line say `modified`.
dist/

# VSCode extension tooling
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/*.vsix
editors/vscode/.vscode-test/

# Generated with the selfhost compiler: the line names the revision, so it
# changes with every commit (source: scripts/gen-selfhost-version.sh).
compiler/src/internal/version/version_source.kizu

# Local benchmark tree: kept on the machine, not in the repo.
/bench/
