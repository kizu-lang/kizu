// Every shape a C calling convention tells apart, passed to and returned from
// the C functions host.c defines. host.c runs the same calls C to C and
// compares the totals.
extern "c" struct O16 {
    a: u16,
    b: u16,
    c: u64,
}

extern "c" struct I4 {
    a: i32,
}

extern "c" struct B3 {
    a: u8,
    b: u8,
    c: u8,
}

extern "c" struct I12 {
    a: i32,
    b: i32,
    c: i32,
}

extern "c" struct F2 {
    a: f32,
    b: f32,
}

extern "c" struct F3 {
    a: f32,
    b: f32,
    c: f32,
}

extern "c" struct D2 {
    a: f64,
    b: f64,
}

extern "c" struct D4 {
    a: f64,
    b: f64,
    c: f64,
    d: f64,
}

extern "c" struct L3 {
    a: i64,
    b: i64,
    c: i64,
}

extern "c" struct DI {
    a: f64,
    b: i32,
}

extern "c" struct FID {
    a: f32,
    b: i32,
    c: f64,
}

extern "c" struct BP {
    a: bool,
    b: ptr<const u8>,
}

extern "c" struct NF {
    a: F2,
    b: f32,
}

extern "c" fn make_o16(k: i64) -> O16
extern "c" fn take_o16(v: O16) -> i64
extern "c" fn make_i4(k: i64) -> I4
extern "c" fn take_i4(v: I4) -> i64
extern "c" fn make_b3(k: i64) -> B3
extern "c" fn take_b3(v: B3) -> i64
extern "c" fn make_i12(k: i64) -> I12
extern "c" fn take_i12(v: I12) -> i64
extern "c" fn make_f2(k: i64) -> F2
extern "c" fn take_f2(v: F2) -> i64
extern "c" fn make_f3(k: i64) -> F3
extern "c" fn take_f3(v: F3) -> i64
extern "c" fn make_d2(k: i64) -> D2
extern "c" fn take_d2(v: D2) -> i64
extern "c" fn make_d4(k: i64) -> D4
extern "c" fn take_d4(v: D4) -> i64
extern "c" fn make_l3(k: i64) -> L3
extern "c" fn take_l3(v: L3) -> i64
extern "c" fn make_di(k: i64) -> DI
extern "c" fn take_di(v: DI) -> i64
extern "c" fn make_fid(k: i64) -> FID
extern "c" fn take_fid(v: FID) -> i64
extern "c" fn make_bp(k: i64) -> BP
extern "c" fn take_bp(v: BP) -> i64
extern "c" fn make_nf(k: i64) -> NF
extern "c" fn take_nf(v: NF) -> i64
extern "c" fn take_late(a: i64, b: i64, c: i64, d: i64, e: i64, o: O16, f: D2) -> i64
extern "c" fn pass_l3(v: L3, k: i64) -> L3
export "c" fn lib_run() -> i64 {
    var total: i64 = 0;
    for 1..4 |k| {
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_o16(unsafe make_o16(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_i4(unsafe make_i4(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_b3(unsafe make_b3(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_i12(unsafe make_i12(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_f2(unsafe make_f2(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_f3(unsafe make_f3(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_d2(unsafe make_d2(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_d4(unsafe make_d4(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_l3(unsafe make_l3(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_di(unsafe make_di(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_fid(unsafe make_fid(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_bp(unsafe make_bp(k));
        // SAFETY: the host defines these for any k.
        total = total + unsafe take_nf(unsafe make_nf(k));
        // SAFETY: as above.
        let o = unsafe make_o16(k);
        // SAFETY: as above.
        let l = unsafe pass_l3(unsafe make_l3(k), k);
        total = total + cast<i64>(o.a) + cast<i64>(o.b) + cast<i64>(o.c) + l.a + l.b + l.c;
        // SAFETY: as above.
        total = total + unsafe take_late(k, k, k, k, k, unsafe make_o16(k), unsafe make_d2(k));
    }
    return total;
}
