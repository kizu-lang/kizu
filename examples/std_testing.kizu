fn main() -> !void {
    try std::testing::expect(true);
    try std::testing::expect_equal_i64(3, 1 + 2);
    try std::testing::expect_equal_bool(true, std::mem::starts_with("lexer", "lex"));
    try std::testing::expect_equal_bytes("token", "token");
    if false {
        try std::testing::fail("unreachable");
    }

    return;
}
