fn main() -> !void {
    std::testing::expect(true);
    std::testing::expect(3 == 1 + 2);
    std::testing::expect(std::mem::starts_with("lexer", "lex"));
    std::testing::expect(std::mem::equal_bytes("token", "token"));
    if false {
        try std::testing::fail("unreachable");
    }

    return;
}
