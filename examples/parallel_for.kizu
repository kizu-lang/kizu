fn worker(i: i64) -> !void {
    print(i)
    return void
}

fn main() -> !void {
    let io = Io()
    let parts = std.task.partition_mut(0, 3)
    let scratch = std.task.LocalBuffer(3, 10)

    print(parts.at(1))
    print(scratch.get(2))
    try std.task.parallel_for(io, 0, 3, worker)

    return void
}
