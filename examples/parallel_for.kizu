fn worker(i: i64) -> !void {
    print(i);
    return void;
}

fn square(i: i64) -> i64 {
    return i * i;
}

fn main() -> !void {
    let io = Io();
    let parts = std.task.partition_mut(0, 4);
    let scratch = std.task.LocalBuffer(4, 10);
    parts.at(1) = 7;
    print(parts.at(1));
    print(scratch.get(2));
    try std.task.parallel_for(io, 0, 3, worker);
    std.task.parallel_map(io, parts, 0, 4, square);
    print(parts.at(0));
    print(parts.at(3));
    return void;
}
