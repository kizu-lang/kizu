import std::float;
import std::mem;

struct Point {
    x: f32,
    y: f32,
}

union Reading {
    Level(f32),
    Missing,
}

fn one() -> f32 {
    return 1.000000059604644776257986737988;
}

fn maybe() -> ?f32 {
    return -1.5;
}

fn checked() -> mem::Error!f32 {
    return 0.1;
}

fn twice(value: f32) -> f32 {
    return value * 2.0;
}

fn main() -> void {
    print(float::bits_f32(one()));
    let below: f32 = 1.0000000596046447753906249;
    print(float::bits_f32(below));
    let tie_even_down: f32 = 1.000000059604644775390625;
    print(float::bits_f32(tie_even_down));
    let tie_even_up: f32 = 1.000000178813934326171875;
    print(float::bits_f32(tie_even_up));
    let next_binade: f32 = 1.99999997;
    print(float::bits_f32(next_binade));
    let negative: f32 = -1.000000059604644776257986737988;
    print(float::bits_f32(negative));
    let max: f32 = 3.4028235e38;
    print(float::bits_f32(max));
    let below_overflow: f32 = 340282356779733661637539395458142568447.9;
    print(float::bits_f32(below_overflow));
    let smallest: f32 = 1e-45;
    print(float::bits_f32(smallest));
    let tie_to_zero: f32 = 7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625e-46;
    print(float::bits_f32(tie_to_zero));
    let above_tie: f32 = 7.0064923216240853546186479164495806564013097093825788587853414194489554134293030074331909418106079101563e-46;
    print(float::bits_f32(above_tie));
    let subnormal_tie: f32 = 3.503246160812042677309323958224790328200654854691289429392670709724477706714651503716595470905303955078125e-45;
    print(float::bits_f32(subnormal_tie));
    let subnormal_above: f32 = 3.503246160812042677309323958224790328200654854691289429392670709724477706714651503716595470905303955078126e-45;
    print(float::bits_f32(subnormal_above));
    let normal_tie: f32 = 1.1754942807573642917278829910357665133228589927589904276829631184250030649651730385585324256680905818939208984375e-38;
    print(float::bits_f32(normal_tie));
    let normal_below: f32 = 1.1754942807573642917278829910357665133228589927589904276829631184250030649651730385585324256680905818939208984374e-38;
    print(float::bits_f32(normal_below));
    if maybe() |value| {
        print(float::bits_f32(value));
    }
    let tenth = checked() catch return;
    print(float::bits_f32(tenth));
    let point = Point { x: 0.5, y: 1.000000059604644776257986737988 };
    print(float::bits_f32(point.y));
    let reading = Reading::Level(1.000000059604644776257986737988);
    match reading {
        Level(level) => print(float::bits_f32(level)),
        Missing => print("missing"),
    }
    print(float::bits_f32(twice(1.000000059604644776257986737988)));
    print(float::bits_f32(point.x + 1.000000059604644776257986737988));
    return;
}

