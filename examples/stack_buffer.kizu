import std::mem;

// A `[N]u8` stack buffer needs no allocator: `[8]u8{}` is zero-filled storage
// in the frame, and views are the one way to read or write it (ADR-0097).
fn fill_greeting(buf: &var []u8) -> void {
    buf[0] = 104;
    buf[1] = 105;
    return;
}

fn main() -> !void {
    var buf = [8]u8{};
    let view = buf.as_mut_bytes();
    fill_greeting(view);
    let read = buf.as_bytes();
    print(read[0..2]);
    print(mem::len(read));
    return;
}

// run
// features: stack-buffer mutable-slice-view
// output:
// hi
// 8
