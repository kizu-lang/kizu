struct Vec2 {
    x: i64,
    y: i64,
}

fn (self: Vec2) add(other: Vec2) -> Vec2 {
    return Vec2 { x: self.x + other.x, y: self.y + other.y };
}

fn (self: Vec2) scale(factor: i64) -> Vec2 {
    return Vec2 { x: self.x * factor, y: self.y * factor };
}

fn unit() -> Vec2 {
    return Vec2 { x: 1, y: 2 };
}

// A call result of a copy type can receive a by-value method directly, so a
// chain of value operations reads left to right without a binding per step.
fn main() -> void {
    let v = unit().add(unit()).scale(3);
    print(v.x);
    print(v.y);
    print(unit().scale(10).x);
    return;
}

// run
// features: method copy-aggregate call-result-receiver
// output:
// 6
// 12
// 10
