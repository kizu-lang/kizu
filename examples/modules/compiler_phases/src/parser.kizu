import app::ast;

pub struct ParseDiagnostic {
    pub path: []u8,
    pub line: i64,
    pub column: i64,
    pub message: []u8,
}

pub union CompileError {
    Diagnostic(ParseDiagnostic),
    Message([]u8),
}

pub fn parse_module(
    allocator: Allocator,
    ok: bool
) -> CompileError!ast::AstModule {
    if ok {
        return ast::AstModule { nodes: 7 };
    }

    let diagnostic = ParseDiagnostic {
        path: "phase.kizu",
        line: 1,
        column: 1,
        message: "parse failed"
    };
    return CompileError::Diagnostic(diagnostic);
}
