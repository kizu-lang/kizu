struct Summary {
    next: i64,
    typed_nodes: i64,
    diagnostics: i64,
}

fn summary(next: i64, typed_nodes: i64, diagnostics: i64) -> Summary {
    return Summary {
        next: next,
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
}

fn total_diagnostics(left: Summary, right: Summary) -> i64 {
    return merge_summaries(left, right).diagnostics;
}

fn merge_summaries(left: Summary, right: Summary) -> Summary {
    return summary(
        right.next,
        left.typed_nodes + right.typed_nodes,
        left.diagnostics + right.diagnostics
    );
}
