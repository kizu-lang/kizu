import std::testing;

pub fn main() -> !void {
    var total = summary(0, 0, 0);
    total = merge_summaries(total, summary(1, 2, 3));

    testing::expect_equal<i64>(1, total.next);
    testing::expect_equal<i64>(2, total.typed_nodes);
    testing::expect_equal<i64>(3, total.diagnostics);
    return;
}

test "merge keeps helper lookup working" {
    testing::expect_equal<i64>(4, total_diagnostics(summary(0, 1, 1), summary(4, 2, 3)));
}

// run
// features: modules same-module-helper assignment std-testing
// output:
