struct Summary {
    next: i64,
    typed_nodes: i64,
    diagnostics: i64,
}

fn summary(next: i64, typed_nodes: i64, diagnostics: i64) -> Summary {
    return Summary {
        next: next,
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
}

fn merge_summaries(left: Summary, right: Summary) -> Summary {
    return summary(
        right.next,
        left.typed_nodes + right.typed_nodes,
        left.diagnostics + right.diagnostics
    );
}

pub fn main() -> !void {
    var total = summary(0, 0, 0);
    total = merge_summaries(total, summary(1, 2, 3));

    std::testing::expect(1 == total.next);
    std::testing::expect(2 == total.typed_nodes);
    std::testing::expect(3 == total.diagnostics);
    return;
}
