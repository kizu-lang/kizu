import std::testing;

struct Summary {
    next: i64,
    typed_nodes: i64,
    diagnostics: i64,
}

fn summary(next: i64, typed_nodes: i64, diagnostics: i64) -> Summary {
    return Summary {
        next: next,
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
}

fn total_diagnostics(left: Summary, right: Summary) -> i64 {
    return merge_summaries(left, right).diagnostics;
}

fn merge_summaries(left: Summary, right: Summary) -> Summary {
    return summary(
        right.next,
        left.typed_nodes + right.typed_nodes,
        left.diagnostics + right.diagnostics
    );
}

pub fn main() -> !void {
    var total = summary(0, 0, 0);
    total = merge_summaries(total, summary(1, 2, 3));

    testing::expect_equal<i64>(1, total.next);
    testing::expect_equal<i64>(2, total.typed_nodes);
    testing::expect_equal<i64>(3, total.diagnostics);
    return;
}

test "merge keeps helper lookup working" {
    testing::expect_equal<i64>(4, total_diagnostics(summary(0, 1, 1), summary(4, 2, 3)));
}

// run
// features: modules same-module-helper assignment std-testing
// output:
