import std;
import target_adapters::core;

pub fn run(path: []u8) -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var input = try std::fs::read_file(
        io,
        allocator,
        path,
        std::mem::Limit::Bytes(64)
    );
    defer input.deinit(allocator);
    let bytes = input.as_bytes();
    core::report(bytes);
    return;
}
