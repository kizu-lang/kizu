import target_adapters::browser_adapter;
import target_adapters::file_adapter;

pub fn main() -> !void {
    comptime if std::target::is_native() {
        try file_adapter::run("examples/fixtures/config.txt");
    } else {
        comptime if std::target::is_wasi() {
            try file_adapter::run("examples/fixtures/config.txt");
        } else {
            comptime if std::target::is_browser() {
                browser_adapter::run();
            }
        }
    }
    return;
}

// run
// features: modules comptime target-select std-fs explicit-io
// dir: .
// output:
// 16
// 1517
