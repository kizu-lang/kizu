import std::mem;

pub fn checksum(bytes: []u8) -> i64 {
    var sum = 0;
    var index = 0;
    while index < mem::len(bytes) {
        sum = sum + cast<i64>(bytes[index]);
        index = index + 1;
    }
    return sum;
}

pub fn report(bytes: []u8) -> void {
    print(mem::len(bytes));
    print(checksum(bytes));
}
