import target_adapters::core;

extern "browser" fn read_input(destination: []u8) -> usize

export "browser" fn input_capacity() -> usize {
    return cast<usize>(64);
}

pub fn run() -> void {
    var storage = [64]u8{};
    let writable = storage.as_mut_bytes();
    // SAFETY: read_input writes at most the 64 bytes lent for this synchronous call.
    let length = unsafe read_input(writable);
    let end = cast<i64>(length);
    core::report(writable[0..end]);
}
