import app::ast;

pub union CompileError {
    Diagnostic(std::kizu::diagnostic::Diagnostic),
    Message([]u8),
}

impl CompileError {
    fn deinit(self: CompileError) -> void {
        match self {
            Diagnostic(diagnostic) => diagnostic.deinit(),
            Message(message) => message,
        }
    }
}

pub fn parse_module(
    allocator: Allocator,
    ok: bool
) -> CompileError!ast::AstModule {
    if ok {
        return ast::AstModule { nodes: 7 };
    }

    let primary = std::kizu::diagnostic::file_span(1, "phase.kizu", 0, 5, 1, 1);
    let diagnostic = std::kizu::diagnostic::Diagnostic(allocator, primary, "parse failed");
    return CompileError::Diagnostic(diagnostic);
}

pub fn parse_message_error() -> CompileError!void {
    return CompileError::Message("parse failed");
}
