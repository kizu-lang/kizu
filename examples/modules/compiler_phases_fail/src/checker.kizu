import app::ast;
import app::parser;

pub fn check_module(
    allocator: Allocator,
    ok: bool
) -> parser::CompileError!ast::CheckedModule {
    let parsed = try parser::parse_module(allocator, ok);
    if parsed.nodes < 1 {
        return parser::CompileError::Message("check failed");
    }
    return ast::CheckedModule { nodes: parsed.nodes };
}
