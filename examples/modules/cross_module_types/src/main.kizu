import app::checks;

pub fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let source_text = "fn main";
    let token = std::kizu::lexer::first_token(source_text);
    checks::accept_token(&token);
    try std::testing::expect_equal_i64(0, token.start);
    try std::testing::expect_equal_i64(2, token.end);

    let source = std::kizu::ast::source_file("main.kizu", source_text);
    let result = try std::kizu::parser::parse_first_node(allocator, source);
    let root = result.root;
    try checks::expect_fn_decl(result.ast, root, source_text, "main", 3, 7);

    let ident_source = "token";
    let ident_file = std::kizu::ast::source_file("ident.kizu", ident_source);
    let ident = try std::kizu::parser::parse_first_node(allocator, ident_file);
    let ident_root = ident.root;
    try checks::expect_ident(ident.ast, ident_root, ident_source, "token", 0, 5);

    let body_source = "fn main() { return add(1 + x); return y; }";
    let body_file = std::kizu::ast::source_file("body.kizu", body_source);
    let body = try std::kizu::parser::parse_first_node(allocator, body_file);
    let body_root = body.root;
    try checks::expect_fn_block_return_call_binary(body.ast, body_root, body_source);

    var manual_ast = std::kizu::ast::Ast(
        allocator,
        std::kizu::ast::source_file("manual.kizu", "manual")
    );
    let param_start = manual_ast.begin_children();
    let param = manual_ast.add_param(std::kizu::ast::span(0, 1), std::kizu::ast::symbol_id(0));
    try manual_ast.add_child(param);
    let params = manual_ast.finish_children(param_start);
    let name = manual_ast.add_var(std::kizu::ast::span(0, 6), std::kizu::ast::symbol_id(0));
    let empty = manual_ast.add_empty(6);
    let fn_node = manual_ast.add_fn_decl(std::kizu::ast::span(0, 6), name, params, empty);
    let field = manual_ast.add_field(std::kizu::ast::span(0, 6), std::kizu::ast::symbol_id(0), empty);
    let arm_start = manual_ast.begin_children();
    let arm = manual_ast.add_match_arm(std::kizu::ast::span(0, 6), std::kizu::ast::symbol_id(0), empty);
    try manual_ast.add_child(arm);
    let arms = manual_ast.finish_children(arm_start);
    let match_node = manual_ast.add_match(std::kizu::ast::span(0, 6), name, arms);
    try checks::expect_manual_ranges(manual_ast, fn_node, field, match_node);

    let indented = std::kizu::lexer::first_token("   lexer");
    try std::testing::expect_equal_i64(3, indented.start);
    try std::testing::expect_equal_i64(8, indented.end);

    let eof = std::kizu::lexer::first_token("   ");
    try std::testing::expect_equal_i64(3, eof.start);
    try std::testing::expect_equal_i64(3, eof.end);

    print(token.start);
    print(token.end);
    print("fn");
    print("main");
    print("token");
    print(indented.start);
    print(indented.end);
    print(eof.start);
    print(eof.end);
    return;
}
