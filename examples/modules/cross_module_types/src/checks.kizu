fn expect_int_var_shape(
    left: std::kizu::ast::AstNode,
    right: std::kizu::ast::AstNode,
    source: []u8
) -> !void {
    try expect_span(source, &left.span, "1", 23, 24);
    try expect_var_node(right, source, "x", 27, 28);
    return;
}

