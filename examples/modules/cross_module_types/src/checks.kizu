        Program(program) => return std::testing::fail("unexpected ast data");,
        TypeName(type_name) => return std::testing::fail("unexpected ast data");,
        Int(int_node) => try expect_int_var_shape(left, right, source),
        String(string_node) => return std::testing::fail("expected int");,
        FnDecl(fn_decl) => return std::testing::fail("expected int");,
        Var(var_node) => return std::testing::fail("expected int");,
        Binary(binary) => return std::testing::fail("expected int");,
        Call(call) => return std::testing::fail("expected int");,
        Block(block) => return std::testing::fail("expected int");,
        If(if_node) => return std::testing::fail("expected int");,
        Let(let_node) => return std::testing::fail("expected int");,
        Return(return_node) => return std::testing::fail("expected int");,
        Defer(defer_node) => return std::testing::fail("expected int");,
        ErrDefer(err_defer_node) => return std::testing::fail("expected int");,
        ExprStmt(expr_stmt) => return std::testing::fail("expected int");,
        Param(param_node) => return std::testing::fail("expected int");,
        Field(field_node) => return std::testing::fail("expected int");,
        StructDecl(struct_decl) => return std::testing::fail("expected int");,
        Match(match_node) => return std::testing::fail("expected int");,
        MatchArm(match_arm) => return std::testing::fail("expected int");,
        Empty => return std::testing::fail("expected int");,
            Bool(bool_node) => return std::testing::fail("expected int");,
        Prefix(prefix_node) => return std::testing::fail("expected int");,
        FieldExpr(field_expr_node) => return std::testing::fail("expected int");,
        DerefExpr(deref_expr_node) => return std::testing::fail("expected int");,
        TypeApplyExpr(type_apply) => return std::testing::fail("expected ast data");,
        CastExpr(cast_expr) => return std::testing::fail("expected ast data");,
