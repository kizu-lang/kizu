fn expect_binary_shape(
    ast: std::kizu::ast::Ast,
    arg: std::kizu::ast::AstNode,
    op: std::kizu::ast::BinaryOp,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    source: []u8
) -> !void {
    try expect_span(source, &arg.span, "1 + x", 23, 28);
    match op {
        Add => try expect_int_and_var(ast, left, right, source),
        Sub => return std::testing::fail("expected add");,
        Mul => return std::testing::fail("expected add");,
        Div => return std::testing::fail("expected add");,
        Mod => return std::testing::fail("expected add");,
        Eq => return std::testing::fail("expected add");,
        NotEq => return std::testing::fail("expected add");,
        LT => return std::testing::fail("expected add");,
        LTE => return std::testing::fail("expected add");,
        GT => return std::testing::fail("expected add");,
        GTE => return std::testing::fail("expected add");,
        And => return std::testing::fail("expected add");,
        Or => return std::testing::fail("expected add");,
    }
    return;
}

fn expect_int_and_var(
    ast: std::kizu::ast::Ast,
    left_id: std::kizu::ast::NodeId,
    right_id: std::kizu::ast::NodeId,
    source: []u8
) -> !void {
    let left = ast.get(left_id);
    let right = ast.get(right_id);
    match left.data {
        ImportDecl(import_decl) => return std::testing::fail("unexpected ast data");,
        EnumDecl(enum_decl) => return std::testing::fail("unexpected ast data");,
        ErrorSetDecl(error_set_decl) => return std::testing::fail("unexpected ast data");,
        UnionDecl(union_decl) => return std::testing::fail("unexpected ast data");,
        ImplDecl(impl_decl) => return std::testing::fail("unexpected ast data");,
