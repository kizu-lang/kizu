pub fn expect_fn_decl(
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    source: []const u8,
    name: []const u8,
    start: i64,
    end: i64
) -> !void {
    let node = ast.get(root);
    match node.data {
        FnDecl(fn_decl) => try expect_var_node(ast.get(fn_decl.name), source, name, start, end);
        Var(var_node) => return std::testing::fail("expected fn decl");
        Int(int_node) => return std::testing::fail("expected fn decl");
        Binary(binary) => return std::testing::fail("expected fn decl");
        Call(call) => return std::testing::fail("expected fn decl");
        Block(block) => return std::testing::fail("expected fn decl");
        If(if_node) => return std::testing::fail("expected fn decl");
        Let(let_node) => return std::testing::fail("expected fn decl");
        Return(return_node) => return std::testing::fail("expected fn decl");
        Empty => return std::testing::fail("expected fn decl");
    }
    return;
}

pub fn expect_ident(
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    source: []const u8,
    expected: []const u8,
    start: i64,
    end: i64
) -> !void {
    let node = ast.get(root);
    match node.data {
        FnDecl(fn_decl) => return std::testing::fail("expected ident");
        Var(var_node) => try expect_span(source, &node.span, expected, start, end);
        Int(int_node) => return std::testing::fail("expected ident");
        Binary(binary) => return std::testing::fail("expected ident");
        Call(call) => return std::testing::fail("expected ident");
        Block(block) => return std::testing::fail("expected ident");
        If(if_node) => return std::testing::fail("expected ident");
        Let(let_node) => return std::testing::fail("expected ident");
        Return(return_node) => return std::testing::fail("expected ident");
        Empty => return std::testing::fail("expected ident");
    }
    return;
}

pub fn expect_fn_block_return_call_binary(
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    let root_node = ast.get(root);
    match root_node.data {
        FnDecl(fn_decl) => try expect_block_return_call_binary(ast, fn_decl.body);
        Var(var_node) => return std::testing::fail("expected fn decl");
        Int(int_node) => return std::testing::fail("expected fn decl");
        Binary(binary) => return std::testing::fail("expected fn decl");
        Call(call) => return std::testing::fail("expected fn decl");
        Block(block) => return std::testing::fail("expected fn decl");
        If(if_node) => return std::testing::fail("expected fn decl");
        Let(let_node) => return std::testing::fail("expected fn decl");
        Return(return_node) => return std::testing::fail("expected fn decl");
        Empty => return std::testing::fail("expected fn decl");
    }
    return;
}

fn expect_var_node(
    name_node: std::kizu::ast::AstNode,
    source: []const u8,
    expected: []const u8,
    start: i64,
    end: i64
) -> !void {
    match name_node.data {
        FnDecl(inner) => return std::testing::fail("expected fn name");
        Var(var_node) => try expect_span(source, &name_node.span, expected, start, end);
        Int(int_node) => return std::testing::fail("expected fn name");
        Binary(binary) => return std::testing::fail("expected fn name");
        Call(call) => return std::testing::fail("expected fn name");
        Block(block) => return std::testing::fail("expected fn name");
        If(if_node) => return std::testing::fail("expected fn name");
        Let(let_node) => return std::testing::fail("expected fn name");
        Return(return_node) => return std::testing::fail("expected fn name");
        Empty => return std::testing::fail("expected fn name");
    }
    return;
}

fn expect_block_return_call_binary(
    ast: std::kizu::ast::Ast,
    body_id: std::kizu::ast::NodeId
) -> !void {
    let body = ast.get(body_id);
    match body.data {
        Block(block) => try expect_return_call_binary(ast, try ast.child_at(block.statements, 0));
        FnDecl(fn_decl) => return std::testing::fail("expected block");
        Var(var_node) => return std::testing::fail("expected block");
        Int(int_node) => return std::testing::fail("expected block");
        Binary(binary) => return std::testing::fail("expected block");
        Call(call) => return std::testing::fail("expected block");
        If(if_node) => return std::testing::fail("expected block");
        Let(let_node) => return std::testing::fail("expected block");
        Return(return_node) => return std::testing::fail("expected block");
        Empty => return std::testing::fail("expected block");
    }
    return;
}

fn expect_return_call_binary(
    ast: std::kizu::ast::Ast,
    statement_id: std::kizu::ast::NodeId
) -> !void {
    let statement = ast.get(statement_id);
    match statement.data {
        Return(return_node) => try expect_call_binary(ast, return_node.value);
        FnDecl(fn_decl) => return std::testing::fail("expected return");
        Var(var_node) => return std::testing::fail("expected return");
        Int(int_node) => return std::testing::fail("expected return");
        Binary(binary) => return std::testing::fail("expected return");
        Call(call) => return std::testing::fail("expected return");
        Block(block) => return std::testing::fail("expected return");
        If(if_node) => return std::testing::fail("expected return");
        Let(let_node) => return std::testing::fail("expected return");
        Empty => return std::testing::fail("expected return");
    }
    return;
}

fn expect_call_binary(
    ast: std::kizu::ast::Ast,
    value_id: std::kizu::ast::NodeId
) -> !void {
    let value = ast.get(value_id);
    match value.data {
        Call(call) => try expect_binary_arg(ast, try ast.child_at(call.args, 0));
        FnDecl(fn_decl) => return std::testing::fail("expected call");
        Var(var_node) => return std::testing::fail("expected call");
        Int(int_node) => return std::testing::fail("expected call");
        Binary(binary) => return std::testing::fail("expected call");
        Block(block) => return std::testing::fail("expected call");
        If(if_node) => return std::testing::fail("expected call");
        Let(let_node) => return std::testing::fail("expected call");
        Return(return_node) => return std::testing::fail("expected call");
        Empty => return std::testing::fail("expected call");
    }
    return;
}

fn expect_binary_arg(
    ast: std::kizu::ast::Ast,
    arg_id: std::kizu::ast::NodeId
) -> !void {
    let arg = ast.get(arg_id);
    match arg.data {
        Binary(binary) => try expect_int_and_var(ast, binary.left, binary.right);
        FnDecl(fn_decl) => return std::testing::fail("expected binary");
        Var(var_node) => return std::testing::fail("expected binary");
        Int(int_node) => return std::testing::fail("expected binary");
        Call(call) => return std::testing::fail("expected binary");
        Block(block) => return std::testing::fail("expected binary");
        If(if_node) => return std::testing::fail("expected binary");
        Let(let_node) => return std::testing::fail("expected binary");
        Return(return_node) => return std::testing::fail("expected binary");
        Empty => return std::testing::fail("expected binary");
    }
    return;
}

fn expect_int_and_var(
    ast: std::kizu::ast::Ast,
    left_id: std::kizu::ast::NodeId,
    right_id: std::kizu::ast::NodeId
) -> !void {
    let left = ast.get(left_id);
    let right = ast.get(right_id);
    match left.data {
        Int(int_node) => try expect_var_data(right);
        FnDecl(fn_decl) => return std::testing::fail("expected int");
        Var(var_node) => return std::testing::fail("expected int");
        Binary(binary) => return std::testing::fail("expected int");
        Call(call) => return std::testing::fail("expected int");
        Block(block) => return std::testing::fail("expected int");
        If(if_node) => return std::testing::fail("expected int");
        Let(let_node) => return std::testing::fail("expected int");
        Return(return_node) => return std::testing::fail("expected int");
        Empty => return std::testing::fail("expected int");
    }
    return;
}

fn expect_var_data(node: std::kizu::ast::AstNode) -> !void {
    match node.data {
        Var(var_node) => return;
        FnDecl(fn_decl) => return std::testing::fail("expected var");
        Int(int_node) => return std::testing::fail("expected var");
        Binary(binary) => return std::testing::fail("expected var");
        Call(call) => return std::testing::fail("expected var");
        Block(block) => return std::testing::fail("expected var");
        If(if_node) => return std::testing::fail("expected var");
        Let(let_node) => return std::testing::fail("expected var");
        Return(return_node) => return std::testing::fail("expected var");
        Empty => return std::testing::fail("expected var");
    }
    return;
}

fn expect_span(
    source: []const u8,
    span: &std::kizu::ast::Span,
    expected: []const u8,
    start: i64,
    end: i64
) -> !void {
    try std::testing::expect_equal_i64(start, span.start);
    try std::testing::expect_equal_i64(end, span.end);
    let text = try std::mem::slice(source, span.start, span.end);
    try std::testing::expect_equal_bytes(expected, text);
    return;
}
