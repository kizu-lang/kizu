fn expect_call_shape(
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::AstNode,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    source: []u8
) -> !void {
    try expect_span(source, &value.span, "add(1 + x)", 19, 29);
    std::testing::expect_equal<i64>(1, args.len);
    try expect_var_span(ast, callee, source, "add", 19, 22);
    try expect_binary_arg(ast, try ast.child_at(args, 0), source);
    return;
}

