fn expect_param_range(ast: std::kizu::ast::Ast, params: std::kizu::ast::ChildRange) -> !void {
    std::testing::expect_equal<i64>(1, params.len);
    let param = ast.get(try ast.child_at(params, 0));
    try expect_param_node(param);
    return;
}

