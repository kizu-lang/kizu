    try expect_var_span(ast, value, source, "z", 48, 49);
    return;
}

fn expect_var_span(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    source: []u8,
    expected: []u8,
    start: i64,
    end: i64
) -> !void {
    try expect_var_node(ast.get(node_id), source, expected, start, end);
    return;
}

