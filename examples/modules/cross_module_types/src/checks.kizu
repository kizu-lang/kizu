        ArenaNewExpr(arena_new) => return std::testing::fail("expected ast data");,
        TryExpr(try_expr_node) => return std::testing::fail("expected int");,
        ComptimeExpr(comptime_expr_node) => return std::testing::fail("expected int");,
        Assign(assign_node) => return std::testing::fail("expected int");,
        While(while_node) => return std::testing::fail("expected int");,
        For(for_node) => return std::testing::fail("expected int");,
        Break(break_node) => return std::testing::fail("expected int");,
        Continue(continue_node) => return std::testing::fail("expected int");,
        Unsafe(unsafe_node) => return std::testing::fail("expected int");,
        ComptimeIf(comptime_if_node) => return std::testing::fail("expected int");,
