fn expect_second_return_shape(
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::AstNode,
    value: std::kizu::ast::NodeId,
    source: []u8
) -> !void {
    try expect_span(source, &statement.span, "return y;", 31, 40);
    try expect_var_span(ast, value, source, "y", 38, 39);
    return;
}

