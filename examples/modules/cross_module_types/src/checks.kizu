fn expect_block_shape(
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::AstNode,
    statements: std::kizu::ast::ChildRange,
    source: []u8
) -> !void {
    try expect_span(source, &body.span, "{ return add(1 + x); return y; return z; }", 10, 52);
    std::testing::expect_equal<i64>(3, statements.len);
    try expect_return_call_binary(ast, try ast.child_at(statements, 0), source);
    try expect_return_var(ast, try ast.child_at(statements, 1), source);
    try expect_third_return_var(ast, try ast.child_at(statements, 2), source);
    return;
}

