pub fn expect_manual_ranges(
    ast: std::kizu::ast::Ast,
    fn_id: std::kizu::ast::NodeId,
    struct_id: std::kizu::ast::NodeId,
    match_id: std::kizu::ast::NodeId
) -> !void {
    try expect_manual_fn_params(ast, fn_id);
    try expect_manual_struct_fields(ast, struct_id);
    try expect_manual_match(ast, match_id);
    return;
}

