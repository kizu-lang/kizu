fn expect_span(
    source: []u8,
    span: &std::kizu::ast::Span,
    expected: []u8,
    start: i64,
    end: i64
) -> !void {
    std::testing::expect_equal<i64>(start, span.start);
    std::testing::expect_equal<i64>(end, span.end);
    let text = try std::mem::slice(source, span.start, span.end);
    std::testing::expect_equal<[]u8>(expected, text);
    return;
}
