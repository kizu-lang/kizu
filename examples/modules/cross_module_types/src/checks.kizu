pub fn expect_fn_decl(
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    source: []u8,
    name: []u8,
    start: i64,
    end: i64
) -> !void {
    let node = ast.get(root);
    match node.data {
        ImportDecl(import_decl) => return std::testing::fail("unexpected ast data");,
        EnumDecl(enum_decl) => return std::testing::fail("unexpected ast data");,
        ErrorSetDecl(error_set_decl) => return std::testing::fail("unexpected ast data");,
        UnionDecl(union_decl) => return std::testing::fail("unexpected ast data");,
        ImplDecl(impl_decl) => return std::testing::fail("unexpected ast data");,
        ContractDecl(contract_decl) => return std::testing::fail("unexpected ast data");,
        UnionVariant(union_variant) => return std::testing::fail("unexpected ast data");,
        Program(program) => return std::testing::fail("unexpected ast data");,
        TypeName(type_name) => return std::testing::fail("unexpected ast data");,
        FnDecl(fn_decl) => try expect_var_node(ast.get(fn_decl.name), source, name, start, end),
        Var(var_node) => return std::testing::fail("expected fn decl");,
        Int(int_node) => return std::testing::fail("expected fn decl");,
        String(string_node) => return std::testing::fail("expected fn decl");,
        Binary(binary) => return std::testing::fail("expected fn decl");,
        Call(call) => return std::testing::fail("expected fn decl");,
        Block(block) => return std::testing::fail("expected fn decl");,
        If(if_node) => return std::testing::fail("expected fn decl");,
        Let(let_node) => return std::testing::fail("expected fn decl");,
        Return(return_node) => return std::testing::fail("expected fn decl");,
        Defer(defer_node) => return std::testing::fail("expected fn decl");,
        ErrDefer(err_defer_node) => return std::testing::fail("expected fn decl");,
        ExprStmt(expr_stmt) => return std::testing::fail("expected fn decl");,
        Param(param_node) => return std::testing::fail("expected fn decl");,
        Field(field_node) => return std::testing::fail("expected fn decl");,
        StructDecl(struct_decl) => return std::testing::fail("expected fn decl");,
        Match(match_node) => return std::testing::fail("expected fn decl");,
        MatchArm(match_arm) => return std::testing::fail("expected fn decl");,
        Empty => return std::testing::fail("expected fn decl");,
            Bool(bool_node) => return std::testing::fail("expected fn decl");,
        Prefix(prefix_node) => return std::testing::fail("expected fn decl");,
        FieldExpr(field_expr_node) => return std::testing::fail("expected fn decl");,
        DerefExpr(deref_expr_node) => return std::testing::fail("expected fn decl");,
        TypeApplyExpr(type_apply) => return std::testing::fail("expected ast data");,
        CastExpr(cast_expr) => return std::testing::fail("expected ast data");,
        IndexExpr(index_expr) => return std::testing::fail("expected ast data");,
        StructLiteralExpr(struct_literal) => return std::testing::fail("expected ast data");,
        StructFieldInit(struct_field_init) => return std::testing::fail("expected ast data");,
        ArenaNewExpr(arena_new) => return std::testing::fail("expected ast data");,
        TryExpr(try_expr_node) => return std::testing::fail("expected fn decl");,
        ComptimeExpr(comptime_expr_node) => return std::testing::fail("expected fn decl");,
        Assign(assign_node) => return std::testing::fail("expected fn decl");,
        While(while_node) => return std::testing::fail("expected fn decl");,
        For(for_node) => return std::testing::fail("expected fn decl");,
        Break(break_node) => return std::testing::fail("expected fn decl");,
        Continue(continue_node) => return std::testing::fail("expected fn decl");,
        Unsafe(unsafe_node) => return std::testing::fail("expected fn decl");,
        ComptimeIf(comptime_if_node) => return std::testing::fail("expected fn decl");,
}
    return;
}

