import std::mem;

// `@embed_file` reads a file into the program when it is compiled. The path
// is relative to the kizu.toml of the package, and the value is a `[]u8`
// constant, as a string literal is: no escape is interpreted, and the program
// does not read the file again when it runs.
fn usage() -> []u8 {
    return @embed_file("text/help.txt");
}

fn main() {
    let help = usage();
    print(help);
    // Two calls naming one path are one piece of data in the executable.
    let again = @embed_file("text/help.txt");
    print(mem::len(again));
    print(mem::equal_bytes(help, again));
}

// run
// features: modules embed-file
// output:
// usage: app [--verbose] <file>
//
// bytes are kept as written: "quoted" \back\slash
//
// 79
// true
