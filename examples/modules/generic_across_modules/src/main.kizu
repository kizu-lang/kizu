import app::box;

// A generic is called the same way inside its own module and across an import.
// Both spellings have to reach the declaration the package registered under its
// module path, which is what a call carrying static arguments used to miss.
fn twice<T>(value: T) -> T {
    return same_here<T>(value);
}

fn same_here<T>(value: T) -> T {
    return value;
}

pub fn main() -> !void {
    std::testing::expect_equal<i64>(7, twice<i64>(7));
    std::testing::expect_equal<i64>(9, box::same_value<i64>(9));
    std::testing::expect_equal<[]u8>("kizu", box::same_value<[]u8>("kizu"));
    return;
}
