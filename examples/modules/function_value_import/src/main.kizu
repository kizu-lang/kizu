import app::scale;

fn apply(f: fn(i64) -> i64, value: i64) -> i64 {
    return f(value);
}

// An imported function can be handed over as a value, not only called: the
// path names the same function either way, so the import is used either way.
fn main() -> void {
    print(apply(scale::double, 21));
    let f = scale::triple;
    print(f(5));
    return;
}

// run
// features: modules function-pointer
// output:
// 42
// 15
