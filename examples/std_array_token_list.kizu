enum TokenKind {
    Ident,
    Number,
    Eof,
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let tokens = std::array::Array<TokenKind>(allocator);

    try tokens.append(TokenKind::Ident);
    try tokens.append(TokenKind::Number);

    print(tokens.len());
    print(try tokens.get(0));
    print(try tokens.get(1));

    tokens.deinit();
    return;
}

// run
// features: std-array token-list enum
// output:
// 2
// TokenKind::Ident
// TokenKind::Number
