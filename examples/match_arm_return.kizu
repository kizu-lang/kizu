import std::mem;
import std::string;

enum Kind {
    Number,
    Missing,
}

fn describe(kind: Kind) -> i64 {
    match kind {
        Number => print("number"),
        Missing => return 0,
    }
    return 1;
}

union Slot {
    Kept(string::String),
    Vacant,
}

// A hand-written mixed-variant deinit: `Vacant => return` is the explicit
// nothing-to-clean arm (ADR-0093).
fn (self: Slot) deinit(allocator: Allocator) -> void {
    match self {
        Kept(payload) => payload.deinit(allocator),
        Vacant => return,
    }
}

fn main() -> !void {
    print(describe(Kind::Number));
    print(describe(Kind::Missing));

    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_bytes(allocator, "kept");
    let kept = Slot::Kept(move name);
    kept.deinit(allocator);

    let vacant = Slot::Vacant;
    vacant.deinit(allocator);
    return;
}

// run
// features: match arm-return union deinit
// output:
// number
// 1
// 0
