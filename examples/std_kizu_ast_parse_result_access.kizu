pub fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "fn main() -> i64 { return 1; }";
    let file = std::kizu::ast::source_file("<memory>", source);
    let result = try std::kizu::parser::parse_program(allocator, file);

    let root_start = result.root_span_start();
    std::testing::expect(0 == root_start);
    let root = result.root_node();
    let same_root = result.node(result.root);
    result.deinit();
    return;
}
