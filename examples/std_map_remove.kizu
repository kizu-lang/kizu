import std::map;
import std::mem;
import std::string;

// remove hands the stored value back and closes the gap, so the keys that
// follow keep their insertion order. An absent key answers null. The map's
// own storage for the entry goes back to the allocator it was built from;
// an owner value leaves whole and is the caller's to release.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit(allocator);
    try counts.insert(allocator, "a", 1);
    try counts.insert(allocator, "b", 2);
    try counts.insert(allocator, "c", 3);
    if counts.remove(allocator, "b") |value| {
        print(value);
    }
    if counts.remove(allocator, "zz") |value| {
        print(value);
    } else {
        print("absent");
    }
    print(counts.len());
    var index = 0;
    while counts.key_at(index) |key| {
        print(key);
        index = index + 1;
    }
    try counts.insert(allocator, "b", 20);
    if counts.get("b") |value| {
        print(value);
    }

    var names = map::new<i64, string::String>(allocator);
    defer names.deinit(allocator);
    try names.insert(allocator, 7, try string::from_bytes(allocator, "seven"));
    try names.insert(allocator, 8, try string::from_bytes(allocator, "eight"));
    if names.remove(allocator, 7) |taken| {
        let text = taken.as_bytes();
        print(text);
        taken.deinit(allocator);
    }
    print(names.len());
    return;
}

// run
// features: std-map remove owner-element
// output:
// 2
// absent
// 2
// a
// c
// 20
// seven
// 1
