import std::mem;
import std::process;

fn main() -> !void {
    print(process::arg_count());
    let argument = try process::arg(0);
    print(argument);
    print(process::env("KIZU_TEST_ENV") orelse "");
    print(process::env("KIZU_SURELY_UNSET_VAR_12345") orelse "missing");

    let before = process::monotonic_millis();
    let after = process::monotonic_millis();
    print(after >= before);
    print(process::unix_millis() > 0);

    let allocator = mem::page_allocator();
    let executable = try process::executable_path(allocator);
    defer executable.deinit(allocator);
    let executable_bytes = executable.as_bytes();
    print(mem::len(executable_bytes) > 0);
    return;
}

// run -- input.kizu
// features: std-process std-mem allocator optional orelse error-union
// env: KIZU_TEST_ENV=env-ok
// output:
// 1
// input.kizu
// env-ok
// missing
// true
// true
// true
