// An extern declaration says which library its symbol lives in. `@link_lib`
// names the library as the linker is handed it, so `-lm` here; where the
// linker looks is the manifest's `[native]` section, not the source.
@link_lib("m")
extern "c" fn cbrt(value: f64) -> f64
fn main() -> void {
    // SAFETY: cbrt reads its argument by value and touches no memory.
    let root = unsafe cbrt(27.0);
    print(root == 3.0);
    return;
}

// run
// features: extern-c link-lib
// output:
// true
