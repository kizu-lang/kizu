import std::mem;
import std::string;

struct Noisy {
    pub name: string::String,
}

fn (self: Noisy) deinit(allocator: Allocator) -> void {
    print("released");
    self.name.deinit(allocator);
    return;
}

// `box` takes its value by value, so `name` is moved into the struct and the
// struct into the call: this frame has nothing left to clean up. When the
// allocation fails, the value was written nowhere, and the obligation is the
// callee's — `box` releases it before the error leaves. `released` is that
// cleanup running.
fn attempt(alloc: Allocator) -> !void {
    var name = string::new(alloc);
    errdefer name.deinit(alloc);
    try name.append_byte(alloc, cast<u8>(97));

    let boxed = try mem::box<Noisy>(alloc, Noisy { name: move name });
    defer boxed.deinit(alloc);
    print("unreachable");
    return;
}

fn main() -> !void {
    // The buffer has to hold the string and not the box. `fixed_buffer`
    // writes its header at the first aligned byte of what it was given, so
    // how much is left depends on where the stack put `buf` -- one alignment
    // step either way. 56 sits in the middle of the window that holds on
    // both: the point is the failure, not the number.
    var buf = [56]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    try attempt(alloc);
    return;
}

// run-fails
// features: ownership deinit errdefer box fixed-buffer allocator error-union
// error: runtime error: std::mem::Error::OutOfMemory
