import std::fmt;
import std::mem;
import std::string;

struct User {
    name: []u8,
    active: bool
}

fn (self: &User) append_display(out: &var string::String) -> !void {
    return fmt::append(out, "User(", self.name, ", active=", self.active, ")");
}

impl fmt::Display for User;

fn main() -> !void {
    let user = User { name: "Aki", active: true };
    let message = try fmt::format(
        mem::page_allocator(),
        "selected ",
        &user
    );
    defer message.deinit();
    let bytes = message.as_bytes();
    print(bytes);
    return;
}

// run
// features: runtime-argument-capture comptime-for user-display contract allocator borrow
// output:
// selected User(Aki, active=true)
