import std::json;
import std::mem;

// JSON has no spelling for NaN or an infinity. One reaching the encoder came
// from the program's own arithmetic, not from input, so it is a bug to report
// rather than a failure to recover from: the program decides what the value
// stands for before it writes the document.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);

    let zero = 0.0;
    try encoder.write_f64(zero / zero);
    return;
}

// run-fails
// features: std-json diagnostics f64
// error: runtime error: json encoder: NaN is not a JSON number
