import std::json;
import std::mem;
import std::string;

pub struct Profile {
    pub city: []u8,
    pub age: i64,
}

pub struct User {
    pub id: i64,
    pub name: []u8,
    pub profile: Profile,
    pub active: bool,
}

// `encode<T>` reads the struct's own shape at compile time, so the fields are
// written by the type rather than by hand. The nested struct takes the same
// path, and the field order is the declaration order.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit();

    let user = User {
        id: 7,
        name: "alice",
        profile: Profile { city: "kyoto", age: 30 },
        active: true,
    };
    try json::encode<User>(allocator, user, out);

    let bytes = out.as_bytes();
    print(bytes);
    return;
}

// run
// features: std-json std-meta comptime-for reflection generics
// output:
// {"id":7,"name":"alice","profile":{"city":"kyoto","age":30},"active":true}
