fn shared<'a>(value: &'a i64) -> &'a i64 {
    return value;
}

fn mutable<'a>(value: &'a mut i64) -> &'a mut i64 {
    return value;
}

fn main() -> !void {
    var value = 41;

    let read = shared(value);
    try std::testing::expect_equal_i64(read.*, 41);

    let write = mutable(value);
    write.* = 42;

    let after = shared(value);
    try std::testing::expect_equal_i64(after.*, 42);
    return;
}
