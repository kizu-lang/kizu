error FsError {
    NotFound,
}

enum Color {
    Red,
    Green,
}

// print takes one value of any type std::fmt::print has a case for: a byte
// string, an integer of any width, a bool, a float, an enum tag, or an
// error. It is a diagnostic: no Io capability, no failure to handle.
fn main() -> void {
    print("bytes");
    print(-42);
    print(cast<u8>(200));
    print(cast<u64>(0 - 1));
    print(true);
    print(0.1);
    print(1e21);
    print(cast<f32>(0.5));
    print(Color::Green);
    print(FsError::NotFound);
    return;
}

// run
// features: print i64 u64 bool float enum error-set std-fmt
// output:
// bytes
// -42
// 200
// 18446744073709551615
// true
// 0.1
// 1e21
// 0.5
// Color::Green
// FsError::NotFound
