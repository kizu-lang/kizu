struct Label {
    text: []const u8;
}

fn worker(i: i64) -> i64 {
    return i + 1;
}

fn main() -> !void {
    let io = std::io::blocking();
    let label = Label { text: "ok" };
    let values = std::task::partition_mut(0, 2);

    std::task::parallel_map(io, values, 0, 2, worker);
    print(label.text);
    print(1);
    print(2);
    return void;
}
