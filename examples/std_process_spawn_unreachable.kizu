import std;

fn wait_for_child() -> !void {
    let _ = try std::process::spawn_wait8(
        1,
        "/bin/true",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
    );
    return;
}

fn main() {
    print("portable");
}

// run
// features: std-process error-union try
// output:
// portable
