struct Node {
    tag: i64,
    name: []u8,
}

fn read_tag(node: ptr<const Node>) -> i64 {
    return unsafe node.*.tag;
}

fn write_tag(node: ptr<Node>, tag: i64) -> void {
    unsafe node.*.tag = tag;
}

fn replace(node: ptr<Node>, value: Node) -> void {
    unsafe node.* = value;
}

fn main() -> void {}

// check
// features: unsafe raw-pointer deref field-access
