import std::array;
import std::mem;
import std::string;

// One generic body is one source line per instantiation. `move value` is
// required by the `String` instantiation, which hands the string off to the
// array, and accepted by the `i64` one, which copies. Rejecting it there would
// leave the function unwritable, since a single line cannot both carry and omit
// the marker.
fn hold<T>(allocator: Allocator, value: T) -> !array::Array<T> {
    var items = array::new<T>(allocator);
    errdefer items.deinit();
    try items.append(move value);
    return move items;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var numbers = try hold<i64>(allocator, 1);
    defer numbers.deinit();
    var texts = try hold<string::String>(allocator, string::new(allocator));
    defer texts.deinit();
    print(numbers.len() + texts.len());
    return;
}

// run
// features: move generic ownership std-array std-string errdefer
// output:
// 2
