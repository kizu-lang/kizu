import std::map;
import std::mem;

struct Ticket {
    id: i64,
}

fn (self: Ticket) deinit() -> void {
    print(self.id);
    return;
}

// `Map.deinit` releases the values it holds before its storage, whether it
// is called directly or through `defer`.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var tickets = map::new<[]u8, Ticket>(allocator);
    defer tickets.deinit(allocator);
    try tickets.insert(allocator, "a", Ticket { id: 1 });
    print("end");
    return;
}

// run
// features: std-map ownership defer deinit
// pending: a deferred Map.deinit lowers to the shallow runtime op and skips value cleanup
// output:
// end
// 1
