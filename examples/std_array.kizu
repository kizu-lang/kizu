import std::array;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let values = array::new<i64>(allocator);
    defer values.deinit();

    try values.append(10);
    try values.append(32);

    print(values.len());
    // The growth strategy is implementation-defined; only this holds.
    print(values.capacity() >= values.len());
    print(values.get(0) orelse -1);
    print(values.get(1) orelse -1);

    return;
}

// run
// features: std-array allocator error-union optional orelse
// output:
// 2
// true
// 10
// 32
