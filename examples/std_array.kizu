import std::array;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let values = array::Array<i64>(allocator);

    try values.append(10);
    try values.append(32);

    print(values.len());
    // The growth strategy is implementation-defined; only this holds.
    print(values.capacity() >= values.len());
    print(try values.get(0));
    print(try values.get(1));

    values.deinit();
    return;
}

// run
// features: std-array allocator error-union
// output:
// 2
// true
// 10
// 32
