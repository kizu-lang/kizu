fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "struct User { age: i64; } fn main() { let xs = std::array::Array<i64>(allocator); let byte = cast<u8>(48); let item = bytes[0]; let part = bytes[1..3]; let user = User { age: 1 }; let nodes = arena<Node>(); }";
    let file = std::kizu::ast::source_file("expression_parity.kizu", source);
    let result = try std::kizu::parser::parse_program(allocator, file);
    accept_result(&result);
    return;
}

fn accept_result(result: &std::kizu::ast::ParseResult) -> void {
    return;
}
