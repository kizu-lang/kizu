fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "fn main() {}";
    var tokens = try std::kizu::lexer::tokenize(allocator, source);

    std::testing::expect_equal<i64>(7, tokens.len());

    let first = try tokens.get(0);
    std::testing::expect_equal<i64>(0, first.start);
    std::testing::expect_equal<i64>(2, first.end);
    let first_text = try std::mem::slice(source, first.start, first.end);
    std::testing::expect_equal<[]u8>("fn", first_text);

    let name = try tokens.get(1);
    std::testing::expect_equal<i64>(3, name.start);
    std::testing::expect_equal<i64>(7, name.end);
    let name_text = try std::mem::slice(source, name.start, name.end);
    std::testing::expect_equal<[]u8>("main", name_text);

    let eof = try tokens.get(6);
    std::testing::expect_equal<i64>(12, eof.start);
    std::testing::expect_equal<i64>(12, eof.end);

    tokens.deinit();
    return;
}
