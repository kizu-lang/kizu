fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "fn main() {}";
    var tokens = try std::kizu::lexer::tokenize(allocator, source);

    try std::testing::expect_equal_i64(7, tokens.len());

    let first = try tokens.get(0);
    try std::testing::expect_equal_i64(0, first.start);
    try std::testing::expect_equal_i64(2, first.end);
    let first_text = try std::mem::slice(source, first.start, first.end);
    try std::testing::expect_equal_bytes("fn", first_text);

    let name = try tokens.get(1);
    try std::testing::expect_equal_i64(3, name.start);
    try std::testing::expect_equal_i64(7, name.end);
    let name_text = try std::mem::slice(source, name.start, name.end);
    try std::testing::expect_equal_bytes("main", name_text);

    let eof = try tokens.get(6);
    try std::testing::expect_equal_i64(12, eof.start);
    try std::testing::expect_equal_i64(12, eof.end);

    tokens.deinit();
    return;
}
