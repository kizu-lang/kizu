fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "fn main() {}";
    var tokens = try std::kizu::lexer::tokenize(allocator, source);

    std::testing::expect(7 == tokens.len());

    let first = try tokens.get(0);
    std::testing::expect(0 == first.start);
    std::testing::expect(2 == first.end);
    let first_text = try std::mem::slice(source, first.start, first.end);
    std::testing::expect(std::mem::equal_bytes("fn", first_text));

    let name = try tokens.get(1);
    std::testing::expect(3 == name.start);
    std::testing::expect(7 == name.end);
    let name_text = try std::mem::slice(source, name.start, name.end);
    std::testing::expect(std::mem::equal_bytes("main", name_text));

    let eof = try tokens.get(6);
    std::testing::expect(12 == eof.start);
    std::testing::expect(12 == eof.end);

    tokens.deinit();
    return;
}
