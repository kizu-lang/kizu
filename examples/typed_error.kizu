union ConfigError {
    NotFound([]const u8);
    InvalidPort(i64);
}

fn read_port(ok: bool) -> ConfigError!i64 {
    if ok {
        return 8080;
    }

    return ConfigError::NotFound("config.kizu");
}

fn main() -> ConfigError!void {
    let port = try read_port(true);
    print(port);
    return;
}
