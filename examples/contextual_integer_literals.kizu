struct Byte {
    value: u8,
}

union ByteValue {
    Item(u8),
}

fn take_byte(value: u8) -> u8 {
    return value;
}

fn take_i32(value: i32) -> i32 {
    return value;
}

fn fallible_byte() -> !u8 {
    return 9;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var bytes = std::array::Array<u8>(allocator);
    try bytes.append(65);
    try bytes.set(0, 66);
    std::testing::expect_equal<i64>(66, cast<i64>(bytes.get_or_panic(0)));

    var text = std::string::String(allocator);
    try text.append_byte(67);
    std::testing::expect_equal<i64>(1, text.len());

    var table = std::map::Map<[]u8, u8>(allocator);
    try table.insert("answer", 68);
    std::testing::expect_equal<i64>(68, cast<i64>(try table.get("answer")));

    let byte = Byte { value: 71 };
    std::testing::expect_equal<i64>(71, cast<i64>(byte.value));

    match ByteValue::Item(72) {
        Item(value) => std::testing::expect_equal<i64>(72, cast<i64>(value));,
    }

    std::testing::expect_equal<i64>(255, cast<i64>(take_byte(255)));
    std::testing::expect_equal<i64>(-1, cast<i64>(take_i32(-1)));
    std::testing::expect_equal<i64>(9, cast<i64>(try fallible_byte()));

    table.deinit();
    text.deinit();
    bytes.deinit();
    return;
}
