struct User {
    name: []u8,
}

fn rename(user: &var User) -> void {
    user.name = "bob";
    print(user.name);
}

fn main() {
    var user = User { name: "alice" };
    rename(user);
    print(user.name);
}

// run
// features: borrow mutable-borrow field-access ownership
// output:
// bob
// bob
