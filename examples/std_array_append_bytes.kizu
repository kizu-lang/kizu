import std::array;
import std::mem;
import std::string;

// append_bytes copies a whole run into a byte array in one call. Appending the
// same bytes one at a time reaches the same array through one capacity check
// and one store per byte, so the run is what the method takes.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var out = array::new<u8>(allocator);
    defer out.deinit(allocator);
    try out.append_bytes(allocator, "alice");
    try out.append_bytes(allocator, " and ");
    try out.append_bytes(allocator, "bob");
    print(out.len());
    // 'a' is 97 and the run starts at the front, so the first byte is the
    // first byte of the first run.
    print(out.get_or_panic(0) == cast<u8>(97));

    // String is a byte array with a name, and its append_bytes is this one.
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "alice and bob");
    let view = text.as_bytes();
    print(view);
    print(text.len() == out.len());
    return;
}

// run
// features: std-array std-string allocator error-union append-bytes
// output:
// 13
// true
// alice and bob
// true
