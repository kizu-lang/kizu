import std::array;
import std::crypto::x509;
import std::mem;
import std::string;

// A server proves who it is with a chain of certificates: one that
// names it, signed by an issuer, signed in turn by a root the client
// already trusts. Verifying the chain is checking that each link is in
// date and signed by the next, that the first names the host, and that
// the last is vouched for by a trusted root. The chain here is a fixed
// test one so the outcome is checkable; a client takes it from the TLS
// handshake and the roots from the system's trust store.

fn bytes_of_hex(allocator: Allocator, hex: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var at = 0;
    while at + 1 < mem::len(hex) {
        let high = hex_value(hex[at]);
        let low = hex_value(hex[at + 1]);
        try out.append_byte(allocator, cast<u8>(high * 16 + low));
        at = at + 2;
    }
    return move out;
}

fn hex_value(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return value - 87;
    }
    return value - 48;
}

// The chain: a leaf for example.com, the intermediate that signed it,
// and the self-signed root that signed the intermediate. All are P-256
// with ECDSA-SHA256, valid from 2025-01-01 to 2035-01-01.
fn leaf_hex() -> []u8 {
    return "";
}

fn intermediate_hex() -> []u8 {
    return "";
}

fn root_hex() -> []u8 {
    return "";
}

fn chain_verifies(
    allocator: Allocator,
    chain: &array::Array<string::String>,
    roots: &array::Array<string::String>,
    host: []u8,
    now: i64
) -> mem::Error!void {
    if x509::verify_chain(chain, roots, host, now) {
        print("verified");
    } else |err| {
        print(match err {
            Malformed => "malformed",
            Unsupported => "unsupported",
            Expired => "expired",
            NameMismatch => "name mismatch",
            BadSignature => "bad signature",
            UnknownIssuer => "unknown issuer",
        });
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var chain = array::new<string::String>(allocator);
    defer chain.deinit(allocator);
    try chain.append(allocator, try bytes_of_hex(allocator, leaf_hex()));
    try chain.append(allocator, try bytes_of_hex(allocator, intermediate_hex()));
    var roots = array::new<string::String>(allocator);
    defer roots.deinit(allocator);
    try roots.append(allocator, try bytes_of_hex(allocator, root_hex()));

    // 2030-01-01, within the validity of all three.
    let now = 1893456000;
    try chain_verifies(allocator, &chain, &roots, "www.example.com", now);
    try chain_verifies(allocator, &chain, &roots, "api.dev.example.com", now);
    try chain_verifies(allocator, &chain, &roots, "other.example.com", now);
    try chain_verifies(allocator, &chain, &roots, "www.example.com", now + 10 * 365 * 86400);

    var nobody = array::new<string::String>(allocator);
    defer nobody.deinit(allocator);
    try chain_verifies(allocator, &chain, &nobody, "www.example.com", now);
    return;
}

// run
// features: crypto x509 certificate
// output:
// verified
// verified
// name mismatch
// expired
// unknown issuer
