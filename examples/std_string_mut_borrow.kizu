fn append_suffix(text: &mut std::string::String) -> !void {
    try text.append_bytes(" suffix");
    text.clear();
    try text.append_bytes("mutated");
    return void;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    try text.append_bytes("prefix");
    try append_suffix(text);

    let bytes = text.as_bytes();
    print(bytes);
    return void;
}
