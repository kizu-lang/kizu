import std::mem;
import std::string;

fn append_suffix(text: &var string::String) -> !void {
    try text.append_bytes(" suffix");
    text.clear();
    try text.append_bytes("mutated");
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit();
    try text.append_bytes("prefix");
    try append_suffix(text);

    let bytes = text.as_bytes();
    print(bytes);
    return;
}

// run
// features: std-string mutable-borrow
// output:
// mutated
