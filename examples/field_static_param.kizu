struct User {
    pub name: []u8,
    pub age: i64,
}

// A `Field` static parameter is one struct field, named at the call. The body
// reads it through the forms written against it, so the compiler checks and
// lowers this function once per field rather than once for the whole type --
// the same expansion a `comptime for` does, reached through a call instead.
fn label<T, f: Field>() -> []u8 {
    return std::meta::field_name<T, f>();
}

fn main() -> void {
    print(label<User, name>());
    print(label<User, age>());
}

// run
// features: comptime static-params field-static-param reflection struct
// output:
// name
// age
