fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try std::fmt::append_i64(text, 0);
    try text.append_byte(cast<u8>(32));
    try std::fmt::append_i64(text, (0 - 9223372036854775807) - 1);
    try text.append_byte(cast<u8>(32));
    try std::fmt::append_i64(text, 42);
    try text.append_byte(cast<u8>(32));
    try std::fmt::append_bool(text, true);
    try text.append_byte(cast<u8>(32));
    try std::fmt::append_bool(text, false);
    try text.append_byte(cast<u8>(32));
    try std::fmt::append_bytes_literal(text, "token");
    try text.append_byte(cast<u8>(32));
    try std::fmt::append_bytes_literal(text, "a\b");

    let bytes = text.as_bytes();
    print(bytes);
    return void;
}
