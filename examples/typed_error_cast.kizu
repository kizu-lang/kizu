union CompileError {
    Message([]const u8),
}

fn lower(ok: bool) -> !i64 {
    if ok {
        return 7;
    }
    return error("bad");
}

fn parse(ok: bool) -> CompileError!i64 {
    let value = try cast<CompileError!i64>(lower(ok));
    return value;
}

fn ensure_value(value: i64) -> !void {
    if value != 7 {
        return error("bad value");
    }
    return;
}

fn main() -> CompileError!void {
    let value = try parse(true);
    try cast<CompileError!void>(ensure_value(value));
    return;
}
