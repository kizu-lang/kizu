error FsError {
    NotFound,
}

error NetError {
    Timeout,
}

fn read_file() -> FsError!i64 {
    return FsError::NotFound;
}

fn fetch() -> NetError!i64 {
    return NetError::Timeout;
}

fn either(local: bool) -> !i64 {
    if local {
        return try read_file();
    }
    return try fetch();
}

fn main() -> !void {
    print(try either(false));
    return;
}
