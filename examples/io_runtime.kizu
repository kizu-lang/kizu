fn load(io: Io, value: i64) -> !i64 {
    return value + 1;
}

fn main() -> !void {
    let blocking = std::io::blocking();
    let blocking_group = std::task::Group(blocking);
    let blocking_task = blocking_group.spawn(load, 1);
    print(try blocking_task.await());

    let threaded = std::io::threaded();
    let threaded_group = std::task::Group(threaded);
    let threaded_task = threaded_group.spawn(load, 2);
    print(try threaded_task.await());

    let failing = std::testing::failing_io();
    let failing_group = std::task::Group(failing);
    let failing_task = failing_group.spawn(load, 3);
    print(try failing_task.await());

    return;
}
