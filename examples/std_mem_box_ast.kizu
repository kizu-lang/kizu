pub struct Span {
    pub start: i64,
    pub end: i64,
}

pub struct BinaryExpr {
    pub left: std::mem::Box<Expr>,
    pub right: std::mem::Box<Expr>,
}

pub union Expr {
    Ident(Span),
    Binary(BinaryExpr),
}

fn expect_ident(expr: &Expr, expected: i64) -> !void {
    match expr {
        Ident(span) => std::testing::expect(expected == span.start),
        Binary(binary) => std::testing::fail("unexpected binary"),
    }
    return;
}

fn expect_binary(binary: &BinaryExpr) -> !void {
    let borrowed = binary.left.borrow();
    try expect_ident(borrowed, 1);
    return;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let left_span = Span {
        start: 1,
        end: 4
    };
    let right_span = Span {
        start: 5,
        end: 8
    };
    let left_expr = Expr::Ident(left_span);
    let right_expr = Expr::Ident(right_span);
    let left_result = std::mem::Box<Expr>(allocator, left_expr);
    let right_result = std::mem::Box<Expr>(allocator, right_expr);
    let left = try left_result;
    let right = try right_result;

    let expr = Expr::Binary(BinaryExpr {
        left: left,
        right: right
    });

    match expr {
        Ident(span) => std::testing::expect_equal<i64>(0, span.start),
        Binary(binary) => try expect_binary(binary),
    }
    return;
}
