fn sum_below(limit: i64) -> i64 {
    var total = 0;
    var i = 0;
    while i < limit {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn main() {
    var n = 0;
    while n < 4 {
        print(sum_below(n));
        n = n + 1;
    }
}

// run
// features: fn while call return assignment
// output:
// 0
// 0
// 1
// 3
