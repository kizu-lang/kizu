// A native build also knows its operating system. `std::target::is_darwin()`
// and `std::target::is_linux()` answer it the way `is_native()` answers the
// build family: inside `comptime if` only, and exactly one of them is true
// for a native build.
pub fn main() -> void {
    var systems = 0;
    comptime if std::target::is_darwin() {
        systems = systems + 1;
    }
    comptime if std::target::is_linux() {
        systems = systems + 1;
    }
    print(systems);
    comptime if std::target::is_native() {
        print(systems == 1);
    }
    return;
}

// run
// features: comptime target-select
// output:
// 1
// true
