fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let table = std::map::Map<[]u8, i64>(allocator);
    let key = "main";

    try table.insert(key, 1);
    try table.insert("count", 2);

    print(table.contains(key));
    print(key);
    print(try table.get("main"));
    print(table.len());

    table.deinit();
    return;
}
