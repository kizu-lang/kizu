import std::map;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let table = map::new<[]u8, i64>(allocator);
    defer table.deinit();
    let key = "main";

    try table.insert(key, 1);
    try table.insert("count", 2);

    print(table.contains(key));
    print(key);
    print(try table.get("main"));
    print(table.len());

    return;
}

// run
// features: std-map allocator error-union
// output:
// true
// main
// 1
// 2
