import std::mem;

// find returns the index of needle, or null: absence is not an error, so the
// signature says `?i64` instead of borrowing an error set.
fn find(bytes: []u8, needle: u8) -> ?i64 {
    var index = 0;
    while index < mem::len(bytes) {
        if bytes[index] == needle {
            return index;
        }
        index = index + 1;
    }
    return null;
}

fn main() -> !void {
    let text = "kizu";
    if find(text, cast<u8>(122)) |at| {
        print(at);
    }
    print(find(text, cast<u8>(120)) orelse -1);
    return;
}

// run
// features: optional null orelse if-capture
// output:
// 2
// -1
