fn main() -> !void {
    let allocator = std::mem::page_allocator();

    var joined_empty = try std::path::join(allocator, "", "");
    let joined_empty_bytes = joined_empty.as_bytes();
    print(joined_empty_bytes);

    var joined_absolute = try std::path::join(allocator, "/a", "../b/");
    let joined_absolute_bytes = joined_absolute.as_bytes();
    print(joined_absolute_bytes);

    var cleaned_empty = try std::path::clean(allocator, "");
    let cleaned_empty_bytes = cleaned_empty.as_bytes();
    print(cleaned_empty_bytes);

    var cleaned_repeated = try std::path::clean(allocator, "a//./b/../c/");
    let cleaned_repeated_bytes = cleaned_repeated.as_bytes();
    print(cleaned_repeated_bytes);

    var cleaned_parent = try std::path::clean(allocator, "../a/..");
    let cleaned_parent_bytes = cleaned_parent.as_bytes();
    print(cleaned_parent_bytes);

    std::testing::expect(std::mem::equal_bytes(".", std::path::basename("")));
    std::testing::expect(std::mem::equal_bytes(".", std::path::dirname("")));
    std::testing::expect(std::mem::equal_bytes("", std::path::extension("")));

    std::testing::expect(std::mem::equal_bytes("/", std::path::basename("/")));
    std::testing::expect(std::mem::equal_bytes("/", std::path::dirname("/")));
    std::testing::expect(std::mem::equal_bytes("", std::path::extension("/")));

    std::testing::expect(std::mem::equal_bytes("b", std::path::basename("a/b/")));
    std::testing::expect(std::mem::equal_bytes("a", std::path::dirname("a/b/")));
    std::testing::expect(std::mem::equal_bytes("", std::path::extension("a/b/")));

    std::testing::expect(std::mem::equal_bytes("a", std::path::basename("a")));
    std::testing::expect(std::mem::equal_bytes(".", std::path::dirname("a")));
    std::testing::expect(std::mem::equal_bytes(".gz", std::path::extension("archive.tar.gz")));
    std::testing::expect(std::mem::equal_bytes(".profile", std::path::extension(".profile")));

    joined_empty.deinit();
    joined_absolute.deinit();
    cleaned_empty.deinit();
    cleaned_repeated.deinit();
    cleaned_parent.deinit();
    return;
}
