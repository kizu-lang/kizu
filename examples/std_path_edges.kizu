fn main() -> !void {
    try std::testing::expect_equal_bytes(".", std::path::basename(""));
    try std::testing::expect_equal_bytes(".", std::path::dirname(""));
    try std::testing::expect_equal_bytes("", std::path::extension(""));

    try std::testing::expect_equal_bytes("/", std::path::basename("/"));
    try std::testing::expect_equal_bytes("/", std::path::dirname("/"));
    try std::testing::expect_equal_bytes("", std::path::extension("/"));

    try std::testing::expect_equal_bytes("b", std::path::basename("a/b/"));
    try std::testing::expect_equal_bytes("a", std::path::dirname("a/b/"));
    try std::testing::expect_equal_bytes("", std::path::extension("a/b/"));

    try std::testing::expect_equal_bytes("a", std::path::basename("a"));
    try std::testing::expect_equal_bytes(".", std::path::dirname("a"));
    try std::testing::expect_equal_bytes(".gz", std::path::extension("archive.tar.gz"));
    try std::testing::expect_equal_bytes(".profile", std::path::extension(".profile"));
    return void;
}
