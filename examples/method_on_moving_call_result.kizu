import std::array;
import std::mem;

struct Vec2 {
    x: i64,
    y: i64,
}

fn (self: Vec2) scale(factor: i64) -> Vec2 {
    return Vec2 { x: self.x * factor, y: self.y * factor };
}

fn consume(allocator: Allocator, values: array::Array<i64>) -> Vec2 {
    var owned = move values;
    let count = owned.len();
    owned.deinit(allocator);
    return Vec2 { x: count, y: 2 };
}

// The receiver call is checked once, so the value it moves is moved once: a
// method on the copy result does not see `values` as used after the move.
fn main() -> !void {
    let heap = mem::page_allocator();
    var values = array::new<i64>(heap);
    errdefer values.deinit(heap);
    try values.append(heap, 7);
    let v = consume(heap, move values).scale(3);
    print(v.x);
    print(v.y);
    return;
}

// run
// features: method copy-aggregate call-result-receiver move
// output:
// 3
// 6
