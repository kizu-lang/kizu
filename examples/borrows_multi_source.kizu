// `borrows a, b` declares that the returned view may derive from either
// source, so the caller keeps both alive while the result lives (ADR-0095).
fn pick(a: []u8, b: []u8, take_first: bool) -> []u8 borrows a, b {
    if take_first {
        return a;
    }
    return b;
}

fn main() -> !void {
    print(pick("left", "right", true));
    print(pick("left", "right", false));
    return;
}

// run
// features: borrow-provenance multi-source
// output:
// left
// right
