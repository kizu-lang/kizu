fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let primary = std::kizu::diagnostic::file_span(1, "main.kizu", 4, 9, 1, 5);
    var diagnostic = std::kizu::diagnostic::Diagnostic(
        allocator,
        primary,
        "expected expression"
    );
    let related = std::kizu::diagnostic::file_span(1, "main.kizu", 0, 2, 1, 1);
    try diagnostic.add_related(related, "function starts here");

    std::testing::expect_equal<i64>(1, diagnostic.primary.source_id);
    std::testing::expect_equal<[]const u8>("main.kizu", diagnostic.primary.path);
    std::testing::expect_equal<i64>(4, diagnostic.primary.byte_start);
    std::testing::expect_equal<i64>(9, diagnostic.primary.byte_end);
    std::testing::expect_equal<i64>(1, diagnostic.primary.line);
    std::testing::expect_equal<i64>(5, diagnostic.primary.column);
    std::testing::expect_equal<[]const u8>("expected expression", diagnostic.message);
    std::testing::expect(1 == diagnostic.related_len());

    diagnostic.deinit();
    return;
}
