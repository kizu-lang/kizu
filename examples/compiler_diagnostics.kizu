fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let primary = std::kizu::diagnostic::file_span(1, "main.kizu", 4, 9, 1, 5);
    var diagnostic = std::kizu::diagnostic::Diagnostic(
        allocator,
        primary,
        "expected expression"
    );
    let related = std::kizu::diagnostic::file_span(1, "main.kizu", 0, 2, 1, 1);
    try diagnostic.add_related(related, "function starts here");

    try std::testing::expect_equal_i64(1, diagnostic.primary.source_id);
    try std::testing::expect_equal_bytes("main.kizu", diagnostic.primary.path);
    try std::testing::expect_equal_i64(4, diagnostic.primary.byte_start);
    try std::testing::expect_equal_i64(9, diagnostic.primary.byte_end);
    try std::testing::expect_equal_i64(1, diagnostic.primary.line);
    try std::testing::expect_equal_i64(5, diagnostic.primary.column);
    try std::testing::expect_equal_bytes("expected expression", diagnostic.message);
    try std::testing::expect_equal_i64(1, diagnostic.related_len());

    diagnostic.deinit();
    return;
}
