import std::crypto;
import std::io;
import std::mem;
import std::string;

// A TLS server proves it holds the private key behind its certificate by
// signing the handshake transcript. Signing with ECDSA needs a nonce that
// must never repeat under one key; here it is derived from the key and
// the digest (RFC 6979), so the same key and digest always give the same
// signature, which is the pair of numbers the RFC lists for its test key.
// Signing with RSA pads the digest, PKCS #1 v1.5 or PSS, and raises it to
// the private exponent through the primes; PSS takes a salt drawn from the
// host's randomness, so no two PSS signatures are alike.

fn bytes_of_hex(allocator: Allocator, hex: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var high = -1;
    for 0..mem::len(hex) |index| {
        let value = hex_value(hex[index]);
        if value < 0 {
            continue;
        }
        if high < 0 {
            high = value;
        } else {
            try out.append_byte(allocator, cast<u8>(high * 16 + value));
            high = -1;
        }
    }
    return move out;
}

// hex_value is the value of a hex digit, or -1 for a line break.
fn hex_value(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return value - 87;
    }
    if value >= 48 {
        return value - 48;
    }
    return -1;
}

fn hex_of(allocator: Allocator, bytes: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    let digits = "0123456789abcdef";
    for 0..mem::len(bytes) |index| {
        try out.append_byte(allocator, digits[cast<i64>(bytes[index] >> 4)]);
        try out.append_byte(allocator, digits[cast<i64>(bytes[index] & 15)]);
    }
    return move out;
}

// The P-256 key of RFC 6979 §A.2.5, private scalar and public point.
fn p256_private_key() -> []u8 {
    return "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721";
}

fn p256_public_key() -> []u8 {
    return
        \\0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6
        \\7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299
    ;
}

fn sign_ecdsa(allocator: Allocator) -> crypto::Failure!void {
    let private = try bytes_of_hex(allocator, p256_private_key());
    defer private.deinit(allocator);
    let public = try bytes_of_hex(allocator, p256_public_key());
    defer public.deinit(allocator);
    var digest = [32]u8{};
    let view = digest.as_mut_bytes();
    crypto::sha256("sample", view);
    let hash = digest.as_bytes();
    var signature = [64]u8{};
    let out = signature.as_mut_bytes();
    let private_bytes = private.as_bytes();
    try crypto::ecdsa_p256_sign(private_bytes, hash, out);
    let made = signature.as_bytes();
    let hex = try hex_of(allocator, made);
    defer hex.deinit(allocator);
    let text = hex.as_bytes();
    print(text);
    let public_bytes = public.as_bytes();
    if crypto::ecdsa_p256_verify(public_bytes, hash, made) {
        print("the ECDSA signature verifies under the public key");
    }
    return;
}

// The parts of a 2048-bit RSA key generated for this example: the
// modulus, the two primes, the exponents modulo each prime less one, and
// the coefficient, as an RSAPrivateKey holds them.
fn rsa_modulus() -> []u8 {
    return
        \\b34f516e785faa0ce779ca21f73ad86c3b307b6e8802619cf9efaecbbc27e702
        \\d8a00c0e21ff61945dbfa2567a19445bfe6c597dbb8b81db666f37cc60714b89
        \\c69e1e11fd5713aa7760861a4cbc8c3df154ab0f7a6c1a20c4b0b10e55aee507
        \\c8a83471b761b263feadb36ff9bc129bc6e28492f8be9df41e6345396b7f50c9
        \\80bd3f764e9a0ae4a6c6c1a17cca97a4cc2b09083020be150f3c23aaf1967808
        \\99ddcc9df08ef14f97051a6f6fef5219da88cb5e3d8b3fff770467cbec00c59a
        \\c1d365d3a63b1d9249304ac65841d37281a478dd04e73644e074f4aef8e7a282
        \\d72d57f5fba371e8f83f926b3ff374c8b3a3b18a6b2986c691c9a0612af69dcd
    ;
}

fn rsa_prime1() -> []u8 {
    return
        \\d9dd12e13e757c5e989b0a8ae6bd1109058b8fa4d82e1da86448affc3b41772d
        \\22c734fe06eed1887f8401631cddb179da407b753ea531e7065bc6d5bbd913f5
        \\4df67a6018fdf1434f430700c1f141dc38685aa3e57b6b63d5bece3a2c3bdf34
        \\906417c1d1d74004dae8882df8839295a4a125ecdd391ec7e5fb3c8b6c71f215
    ;
}

fn rsa_prime2() -> []u8 {
    return
        \\d2b291f986e55e4858ba542f5658d5ea680ee1fbb112312759196f1dc61a1d7e
        \\a3089968daccb2745ecc453fe81adb4fdbddcb3db140f4d900caaa4be6dd912b
        \\0f1853fd0fc09b5fb9184a7b4c721503ee8120c057f57db0ceba668fcb0ad416
        \\e607b853a398bbfb6a90d4781a83534381da6762ed1c5031b7641ff72edb42d9
    ;
}

fn rsa_exponent1() -> []u8 {
    return
        \\be88ddce2835cfc35b6b9cd8c5db6c5e9b7ee6eda03314b5049f9d69d6d8f645
        \\7f39015b78ecbc4bc859c66ccbfe070d2e975e61b79bf9fcb64ee5a25f5b065d
        \\6f05b518fe42791208ebf1dff3bdef7f8dc5961fe8befbb8a062f3316526279b
        \\6cfc5cdaa18ec2ea7c1909a04acba713409bbef35cb66bf91f658e19d18a05d1
    ;
}

fn rsa_exponent2() -> []u8 {
    return
        \\29a71bac94ba6b7529f54c073faeb83b6aeee645f7af7d0026611cd26a0367a9
        \\4d59b9da3cc712d0669d43636ae3444ff94b538e92a820bf75a49b1dfe39f724
        \\e80b0b2f9019a79db8ddd07ba795360a5cf03225543e37e6e83779671be0bc24
        \\fabcb3f7f4f390d6172f2291cbcc027dea01df467351919902844cbd7509eba1
    ;
}

fn rsa_coefficient() -> []u8 {
    return
        \\5c5d994437ee158f67b409646911999d41a81a450c913b6351e05986d9e0c521
        \\059a41e93c10275ea557d268a15ad570ca888ed2113c5babe971592122074471
        \\87f07cf94f5fef62901cf90bd07b9a7f77ff2517106878c09f44e7ab027a1e0c
        \\cd0fe7ea90d379ce8982a30c07c31e05f2ce2bf069ce9ad54caaaa34c1cbe864
    ;
}

fn sign_rsa(io: Io, allocator: Allocator) -> crypto::Failure!void {
    let n = try bytes_of_hex(allocator, rsa_modulus());
    defer n.deinit(allocator);
    let e = try bytes_of_hex(allocator, "010001");
    defer e.deinit(allocator);
    let p = try bytes_of_hex(allocator, rsa_prime1());
    defer p.deinit(allocator);
    let q = try bytes_of_hex(allocator, rsa_prime2());
    defer q.deinit(allocator);
    let dp = try bytes_of_hex(allocator, rsa_exponent1());
    defer dp.deinit(allocator);
    let dq = try bytes_of_hex(allocator, rsa_exponent2());
    defer dq.deinit(allocator);
    let qinv = try bytes_of_hex(allocator, rsa_coefficient());
    defer qinv.deinit(allocator);
    let n_bytes = n.as_bytes();
    let e_bytes = e.as_bytes();
    let p_bytes = p.as_bytes();
    let q_bytes = q.as_bytes();
    let dp_bytes = dp.as_bytes();
    let dq_bytes = dq.as_bytes();
    let qinv_bytes = qinv.as_bytes();
    let key = crypto::RsaPrivateKey {
        modulus: n_bytes,
        public_exponent: e_bytes,
        prime1: p_bytes,
        prime2: q_bytes,
        exponent1: dp_bytes,
        exponent2: dq_bytes,
        coefficient: qinv_bytes,
    };
    var digest = [32]u8{};
    let view = digest.as_mut_bytes();
    crypto::sha256("sample", view);
    let hash = digest.as_bytes();

    var pkcs1 = [256]u8{};
    let pkcs1_out = pkcs1.as_mut_bytes();
    try crypto::rsa_pkcs1_sign(crypto::Hash::Sha256, &key, hash, pkcs1_out);
    let pkcs1_made = pkcs1.as_bytes();
    if crypto::rsa_pkcs1_verify(crypto::Hash::Sha256, n_bytes, e_bytes, hash, pkcs1_made) {
        print("the PKCS #1 v1.5 signature verifies under the public key");
    }

    let salt = try crypto::random_bytes(io, allocator, 32);
    defer salt.deinit(allocator);
    let salt_bytes = salt.as_bytes();
    var pss = [256]u8{};
    let pss_out = pss.as_mut_bytes();
    try crypto::rsa_pss_sign(crypto::Hash::Sha256, &key, hash, salt_bytes, pss_out);
    let pss_made = pss.as_bytes();
    if crypto::rsa_pss_verify(crypto::Hash::Sha256, n_bytes, e_bytes, hash, pss_made) {
        print("the PSS signature verifies under the public key");
    }
    return;
}

fn main() -> !void {
    let io = io::blocking();
    let allocator = mem::page_allocator();
    try sign_ecdsa(allocator);
    try sign_rsa(io, allocator);
    return;
}

// run
// features: crypto ecdsa rsa
// output:
// efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8
// the ECDSA signature verifies under the public key
// the PKCS #1 v1.5 signature verifies under the public key
// the PSS signature verifies under the public key
