import std::array;
import std::date;
import std::mem;
import std::rand;
import std::string;
import std::testing;

// Calendar arithmetic checked against a day counter. The model is one
// integer, days since 1970-01-01, which is too simple to be wrong. Every
// command moves both sides by a signed number of days; afterwards the
// calendar's day count, weekday and ISO spelling all have to follow from
// the counter alone. Month arithmetic stays out on purpose: a day counter
// has no opinion on what one month after January 31 is.

fn gen_span(rng: &var rand::Rng, days: &i64) -> i64 {
    // Up to about four years either way, so a run crosses leap years and
    // wanders across a century.
    return rng.below(3001) - 1500;
}

fn init_counter(allocator: Allocator) -> !i64 {
    return 0;
}

// 1970-01-01 was a Thursday, ISO weekday 4. `%` follows the sign of the
// left operand, so a negative count is folded back into 0..6 by hand.
fn weekday_of(days: i64) -> i64 {
    let shifted = (days + 3) % 7;
    let folded = if shifted < 0 {
        shifted + 7
    } else {
        shifted
    };
    return folded + 1;
}

// The first draft keeps its own weekday and steps it by hand.
struct Handmade {
    today: date::Date,
    weekday: i64,
}

fn init_handmade(allocator: Allocator) -> !Handmade {
    return Handmade { today: date::from_days(0), weekday: 4 };
}

fn step_handmade(allocator: Allocator, days: &var i64, sut: &var Handmade, span: &i64) -> !bool {
    days.* = days.* + span.*;
    sut.today = sut.today.add_days(span.*);
    sut.weekday = (sut.weekday - 1 + span.*) % 7 + 1;
    return sut.today.to_days() == days.* and sut.weekday == weekday_of(days.*);
}

// The second draft asks the date for its weekday and spells it out.
struct Calendar {
    today: date::Date,
}

fn init_calendar(allocator: Allocator) -> !Calendar {
    return Calendar { today: date::from_days(0) };
}

fn step_calendar(allocator: Allocator, days: &var i64, sut: &var Calendar, span: &i64) -> !bool {
    days.* = days.* + span.*;
    sut.today = sut.today.add_days(span.*);
    let today = sut.today;
    if today.to_days() != days.* {
        return false;
    }
    let weekday = today.weekday();
    if weekday.iso_number() != weekday_of(days.*) {
        return false;
    }
    var spelled = string::new(allocator);
    defer spelled.deinit(allocator);
    try today.append_iso(allocator, &var spelled);
    let bytes = spelled.as_bytes();
    let read = try date::parse(bytes);
    return read.equals(today);
}

fn report(allocator: Allocator, trace: &array::Array<i64>) -> void {
    print("diverged after these moves:");
    var index = 0;
    while trace.get(index) |span| {
        print(span);
        index = index + 1;
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var rng = rand::new(1970);
    if try testing::run_model<i64, i64, Handmade>(
        allocator, &var rng, 500, gen_span, init_counter, init_handmade, step_handmade) |trace| {
        report(allocator, &trace);
        trace.deinit(allocator);
    } else {
        print("the handmade weekday agrees");
    }
    if try testing::run_model<i64, i64, Calendar>(
        allocator, &var rng, 500, gen_span, init_counter, init_calendar, step_calendar) |trace| {
        report(allocator, &trace);
        trace.deinit(allocator);
    } else {
        print("500 moves agree with the day counter");
    }
    return;
}

// run
// features: std-testing run-model std-date
// output:
// diverged after these moves:
// -92
// 500 moves agree with the day counter
