import std::float;
import std::math;

// A comptime expression may compute in f64: literals, + - * /, comparisons,
// `cast<f64>` of a comptime integer, and std::math sin, cos, sqrt, pi and
// tau. It folds to a literal, and the literal is the bits the same
// expression computes at run time on the target being built -- sin and cos
// are std's, not the compiler's host library -- so writing `comptime` in
// front changes when the value is computed, never which value it is.
fn main() -> void {
    // The twelfth roots of unity, one literal each: nothing is computed when
    // the program runs, and each matches the runtime call bit for bit.
    var matches = 0;
    comptime for 0..12 |k| {
        let re = comptime math::cos<f64>(math::tau<f64>() * cast<f64>(k) / 12.0);
        let im = comptime math::sin<f64>(math::tau<f64>() * cast<f64>(k) / 12.0);
        let angle = math::tau<f64>() * cast<f64>(k) / 12.0;
        if float::bits(re) == float::bits(math::cos<f64>(angle)) and
            float::bits(im) == float::bits(math::sin<f64>(angle)) {
            matches = matches + 1;
        }
    }
    print(matches);

    // A comparison decides a `comptime if`.
    comptime if math::sqrt<f64>(2.0) > 1.41421 {
        print(comptime math::sqrt<f64>(2.0) * 1000000.0);
    }
    print(comptime math::cos<f64>(math::pi<f64>() / 3.0));
}

// run
// features: comptime comptime-for float
// output:
// 12
// 1414213.5623730952
// 0.5000000000000001
