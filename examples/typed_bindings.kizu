// A binding can say its type.
//
// A local's type comes from its initializer, and that is enough almost
// always. It is not enough when the initializer says less than the binding
// means: `null` alone is no type at all, `13` is an i64 unless something asks
// for narrower, and a plain value is not the optional it is about to be kept
// as. A declared type is that something. It is the initializer's context, the
// way a parameter type is an argument's, under the same rules -- nothing here
// converts, and a type the context cannot settle is a mismatch.

struct Point {
    x: i64,
    y: i64,
}

fn main() -> void {
    // An optional that starts empty and is filled later. Without the
    // declaration `null` has nothing to be the absence of.
    var found: ?i64 = null;
    show(found);
    found = 7;
    show(found);

    // A literal takes the declared width, the way it would as an argument.
    let byte: u8 = 13;
    print(byte);

    // A plain value wraps into a declared optional, as it does into a `?T`
    // return.
    let wide: ?i64 = 9;
    print(wide orelse 0);

    // A declared type that the initializer already has is a check and
    // nothing more.
    let origin: Point = Point { x: 0, y: 0 };
    print(origin.x + origin.y);
    return;
}

fn show(value: ?i64) -> void {
    if value |present| {
        print(present);
    } else {
        print("none");
    }
    return;
}

// run
// features: optional null struct
// output:
// none
// 7
// 13
// 9
// 0
