// A function's name is a value of its signature's type. There are no closures,
// so a function pointer is exactly that: the address of a top-level function.
// Calling through one is safe -- the code it names outlives the program, and
// the type fixes the signature -- so only the pointee's own obligations, if it
// has any, ask for `unsafe`.

fn double(value: i64) -> i64 {
    return value * 2;
}

fn negate(value: i64) -> i64 {
    return 0 - value;
}

fn apply(f: fn(i64) -> i64, value: i64) -> i64 {
    return f(value);
}

fn main() -> void {
    print(apply(double, 21));
    print(apply(negate, 21));
}

// run
// features: function-pointer
// output:
// 42
// -21
