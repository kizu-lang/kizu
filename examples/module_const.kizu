const max_bytes = 48;
const limbs = (max_bytes / 4);
const wide = (limbs * 2 + 1);
const greeting = "hello";
const ratio = 1.5;
const verbose = false;
const axis = [3]f64{ 1.0, 0.0, 0.0 };

enum Mode {
    Fast,
    Exact,
}

const default_mode = Mode::Exact;

struct Number {
    limbs: [limbs]u64,
}

fn zeros<n: i64>() -> [n]u8 {
    return [n]u8{};
}

fn main() -> void {
    var buffer = [max_bytes]u8{};
    buffer[max_bytes - 1] = 7;
    let product = [wide]u64{};
    let number = Number { limbs: [limbs]u64{} };
    let padded = zeros<(max_bytes + 1)>();
    print(buffer[47]);
    print(product[24]);
    print(number.limbs[11]);
    print(padded[48]);
    print(greeting);
    print(ratio * 2.0);
    print(verbose);
    print(axis[0]);
    print(default_mode == Mode::Exact);
    print(cast<u8>(max_bytes));
}

// run
// features: comptime stack-buffer struct enum generics
// output:
// 7
// 0
// 0
// 0
// hello
// 3.0
// false
// 1.0
// true
// 48
