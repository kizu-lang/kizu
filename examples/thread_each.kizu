import std::array;
import std::io;
import std::mem;
import std::thread;

// Squares every number and notes which chunk it was in. The worker sees only
// the chunk it was handed, as its own `&var []i64`; the chunks do not overlap,
// so the threads never write the same element.
fn square(part: &var []i64, index: i64) -> void {
    for 0..mem::count<i64>(part) |i| {
        part[i] = part[i] * part[i] * 10 + index;
    }
    return;
}

// A pool runs one function over a slice on several threads at once. `each`
// cuts the slice into chunks of 3, runs them on the pool's 4 threads -- the
// caller is one of them -- and returns once every chunk has run, so `values`
// is lent for that call and no longer.
//
// On a machine with 4 cores, the same pool running 4 chunks that each spin for
// 0.36 s takes 0.48 s of wall time for 1.5 s of CPU time.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);

    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    for 0..8 |i| {
        try values.append(allocator, i);
    }
    let cells = values.as_mut_slice();
    thread::each<i64>(&var pool, cells, 3, square);
    for 0..values.len() |i| {
        print(values.get_or_panic(i));
    }
    return;
}

// run
// features: thread
// output:
// 0
// 10
// 40
// 91
// 161
// 251
// 362
// 492
