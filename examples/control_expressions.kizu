enum Color {
    Red,
    Green,
    Blue,
}

fn choose(value: i64,) -> i64 {
    return value;
}

fn main() -> !void {
    let age = 20
    let adult = if age >= 18 {
        true
    } else {
        false
    }

    let color = Color::Green
    let label = match color {
        Red => "red",
        Green => "green",
        Blue => "blue",
    }

    try std::testing::expect_equal_i64(1, choose(1,))
    try std::testing::expect_equal_bool(true, adult,)
    try std::testing::expect_equal_bytes("green", label)
    return;
}
