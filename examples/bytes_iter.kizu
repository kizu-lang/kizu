import std::mem;

struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn iter(bytes: []u8) -> BytesIter {
    return BytesIter { bytes: bytes, index: 0 };
}

fn (self: BytesIter) has_next() -> bool {
    return self.index < mem::len(self.bytes);
}

fn (self: &var BytesIter) next() -> u8 {
    let byte = self.bytes[self.index];
    self.index = self.index + 1;
    return byte;
}

fn fill(bytes: &var []u8) -> void {
    bytes[0] = 10;
    bytes[1] = 20;
    bytes[2] = 30;
    return;
}

// A cursor over a runtime stack buffer: the iterator captures the view and
// stays tied to `buf` (ADR-0100), so it can never outlive the bytes it walks.
fn main() -> !void {
    var buf = [3]u8{};
    let scratch = buf.as_mut_bytes();
    fill(scratch);
    let view = buf.as_bytes();
    var it = iter(view);
    while it.has_next() {
        print(it.next());
    }
    return;
}

// run
// features: borrow view-capture struct method iterator
// output:
// 10
// 20
// 30
