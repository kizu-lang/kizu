fn main() -> !void {
    let bytes = "  lexer token  ";
    print(std::mem::len(bytes));
    print(std::mem::equal_bytes("let", "let"));
    print(std::mem::starts_with("lexer", "lex"));

    let trimmed = std::mem::trim_ascii(bytes);
    print(trimmed);

    let prefix = try std::mem::slice(trimmed, 0, 5);
    print(prefix);

    let first = try std::mem::byte_at(prefix, 0);
    print(cast<i64>(first));
    return;
}
