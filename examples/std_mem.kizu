import std::mem;

fn main() -> !void {
    let bytes = "  lexer token  ";
    print(mem::len(bytes));
    print(mem::equal_bytes("let", "let"));
    print(mem::starts_with("lexer", "lex"));

    let trimmed = mem::trim_ascii(bytes);
    print(trimmed);

    let prefix = try mem::slice(trimmed, 0, 5);
    print(prefix);

    let first = try mem::byte_at(prefix, 0);
    print(cast<i64>(first));
    return;
}

// run
// features: std-mem []u8 error-union
// output:
// 15
// true
// true
// lexer token
// lexer
// 108
