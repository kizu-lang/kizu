fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var source = try std::path::join(allocator, "examples", "fixtures/config.txt");
    let source_bytes = source.as_bytes();
    print(source_bytes);
    print(std::path::dirname("examples/fixtures/config.txt"));
    print(std::path::basename("examples/fixtures/config.txt"));
    print(std::path::extension("examples/fixtures/config.txt"));

    var cleaned = try std::path::clean(allocator, "examples/fixtures/../fixtures/config.txt");
    let cleaned_bytes = cleaned.as_bytes();
    print(cleaned_bytes);
    source.deinit();
    cleaned.deinit();
    return;
}
