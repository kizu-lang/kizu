import std::mem;
import std::path;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var source = try path::join(allocator, "examples", "fixtures/config.txt");
    let source_bytes = source.as_bytes();
    print(source_bytes);
    print(path::dirname("examples/fixtures/config.txt"));
    print(path::basename("examples/fixtures/config.txt"));
    print(path::extension("examples/fixtures/config.txt"));

    var cleaned = try path::clean(allocator, "examples/fixtures/../fixtures/config.txt");
    let cleaned_bytes = cleaned.as_bytes();
    print(cleaned_bytes);
    source.deinit();
    cleaned.deinit();
    return;
}

// run
// features: std-path pure-helper
// output:
// examples/fixtures/config.txt
// examples/fixtures
// config.txt
// .txt
// examples/fixtures/config.txt
