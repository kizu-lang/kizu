import std::mem;
import std::string;

error Failure { Bad }

struct Item {
    name: string::String,
    id: i64,
}

fn (self: Item) deinit(allocator: Allocator) -> void {
    print(self.id);
    self.name.deinit(allocator);
    return;
}

struct Slot {
    parsed: Failure!Item,
}

fn make(allocator: Allocator, id: i64) -> Failure!Item {
    let name = string::from_bytes(allocator, "x") catch return Failure::Bad;
    return Item { name: move name, id: id };
}

// A field holding an error union with an owner payload is an owner field:
// the derived deinit releases the payload when it is there.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let slot = Slot { parsed: make(allocator, 1) };
    defer slot.deinit(allocator);
    print("end");
    return;
}

// run
// features: error-union ownership deinit derived
// output:
// end
// 1
