import std::array;
import std::mem;
import std::string;

fn make_name(allocator: Allocator, text: []u8) -> !string::String {
    var name = string::new(allocator);
    errdefer name.deinit();
    try name.append_bytes(text);
    return name;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let names = array::new<string::String>(allocator);
    // deinit_all consumes every remaining element before releasing the
    // buffer. Shallow `deinit()` on an owner-element Array is a type error.
    defer names.deinit_all();
    try names.append(try make_name(allocator, "alice"));
    try names.append(try make_name(allocator, "bob"));
    print(names.len());

    let taken = names.pop_or_panic();
    defer taken.deinit();
    let text = taken.as_bytes();
    print(text);
    print(names.len());
    return;
}

// run
// features: std-array ownership deinit-all
// output:
// 2
// bob
// 1
