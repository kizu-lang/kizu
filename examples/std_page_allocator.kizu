struct User {
    name: []const u8;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();

    let values = std::array::Array<i64>(allocator);
    defer values.deinit();

    var text = std::string::String(allocator);
    defer text.deinit();

    let names = std::map::Map<[]const u8, i64>(allocator);
    defer names.deinit();

    let users = arena<User>(allocator);
    defer users.deinit();

    try values.append(41);
    try values.append(1);
    try std::testing::expect_equal_i64(2, values.len());
    try std::testing::expect_equal_i64(41, try values.get(0));

    try text.append_bytes("page");
    try text.append_byte(cast<u8>(45));
    try text.append_bytes("allocator");
    try std::testing::expect_equal_i64(14, text.len());

    try names.insert("values", values.len());
    try std::testing::expect_equal_i64(2, try names.get("values"));

    let alice = users.add(User { name: "alice" });
    try std::testing::expect_equal_bytes("alice", users.get(alice).name);

    let more = std::array::Array<i64>(allocator);
    defer more.deinit();
    try more.append(42);
    try std::testing::expect_equal_i64(42, try more.get(0));

    return;
}
