struct User {
    name: []const u8,
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();

    let values = std::array::Array<i64>(allocator);
    defer values.deinit();

    var text = std::string::String(allocator);
    defer text.deinit();

    let names = std::map::Map<[]const u8, i64>(allocator);
    defer names.deinit();

    let users = arena<User>(allocator);
    defer users.deinit();

    try values.append(41);
    try values.append(1);
    std::testing::expect_equal<i64>(2, values.len());
    std::testing::expect_equal<i64>(41, values.get_or_panic(0));

    try text.append_bytes("page");
    try text.append_byte(cast<u8>(45));
    try text.append_bytes("allocator");
    std::testing::expect_equal<i64>(14, text.len());

    try names.insert("values", values.len());
    std::testing::expect_equal<i64>(2, try names.get("values"));

    let alice = users.add(User { name: "alice" });
    std::testing::expect_equal<[]const u8>("alice", users.get(alice).name);

    let more = std::array::Array<i64>(allocator);
    defer more.deinit();
    try more.append(42);
    std::testing::expect_equal<i64>(42, more.get_or_panic(0));

    return;
}
