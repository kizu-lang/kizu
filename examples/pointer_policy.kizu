extern "c" fn raw_byte(p: ptr<const u8>) -> u8
extern "c" fn maybe_byte() -> ?ptr<const u8>

fn read_byte(p: ptr<const u8>) -> u8 {
    return unsafe raw_byte(p);
}

fn write_byte(p: ptr<u8>, value: u8) -> void {
    unsafe ptr_write(p, value);
}

fn cast_to_mut(p: ptr<const u8>) -> ptr<u8> {
    return unsafe cast<ptr<u8>>(p);
}

// check
// features: unsafe raw-pointer
