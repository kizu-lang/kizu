// `else if` continues a branch without nesting. It is spelling for
// `else { if ... }`: captures, expression form and `comptime if` all follow
// the same rules as the nested form.
fn size_of(n: i64) -> []u8 {
    return if n < 3 { "small" } else if n < 10 { "medium" } else { "large" };
}

fn first_even(a: i64, b: i64) -> ?i64 {
    if a % 2 == 0 {
        return a;
    } else if b % 2 == 0 {
        return b;
    }
    return null;
}

pub fn main() -> void {
    print(size_of(1));
    print(size_of(5));
    print(size_of(50));
    if first_even(1, 3) |even| {
        print(even);
    } else if first_even(1, 4) |even| {
        print(even);
    } else {
        print("none");
    }
    comptime if std::target::is_browser() {
        print("browser");
    } else comptime if std::target::is_native() {
        print("native");
    } else {
        print("wasi");
    }
    return;
}

// run
// features: if if-expr optional comptime target-select
// output:
// small
// medium
// large
// 4
// native
