extern "c" fn strlen(s: ptr<const u8>) -> usize

/// data は少なくとも len バイトの読み出し可能なメモリを指す。
/// この不変条件を保つ責任はこの file の中のコードが持つ。
unsafe struct Bytes {
    data: ptr<const u8>,
    len: usize,
}

fn borrow_c_string(s: ptr<const u8>) -> Bytes {
    let size = unsafe strlen(s);
    return unsafe Bytes { data: s, len: size };
}

fn size(b: &Bytes) -> usize {
    return b.len;
}

fn raw(b: &Bytes) -> ptr<const u8> {
    return b.data;
}

fn shrink(b: &var Bytes, n: usize) -> void {
    unsafe b.len = n;
}

// check
// features: unsafe unsafe-struct raw-pointer extern-c
