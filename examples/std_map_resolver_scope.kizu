enum BindingKind {
    Function,
    Local,
    TypeName,
}

fn declare(
    symbols: &mut std::map::Map<[]const u8, BindingKind>,
    name: []const u8,
    kind: BindingKind
) -> !void {
    try symbols.insert(name, kind);
    return;
}

fn resolve(
    symbols: &std::map::Map<[]const u8, BindingKind>,
    name: []const u8
) -> !BindingKind {
    return symbols.get(name);
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var symbols = std::map::Map<[]const u8, BindingKind>(allocator);
    var owned_name = std::string::String(allocator);

    try owned_name.append_bytes("node");
    let node_name = owned_name.as_bytes();
    try symbols.insert(node_name, BindingKind::Local);
    owned_name.deinit();

    try declare(symbols, "parse_expr", BindingKind::Function);

    std::testing::expect(2 == symbols.len());
    std::testing::expect(symbols.contains("node"));
    std::testing::expect(!symbols.contains("missing"));

    let local = try resolve(symbols, "node");
    std::testing::expect(local == BindingKind::Local);

    let function = try resolve(symbols, "parse_expr");
    std::testing::expect(function == BindingKind::Function);

    symbols.deinit();
    return;
}
