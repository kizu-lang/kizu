struct Bytes {
    text: []const u8;
}

struct File {
    name: []const u8;
}

contract Writer {
    fn write(self: &Self, bytes: &Bytes) -> !i64;
}

impl File {
    fn write(self: &File, bytes: &Bytes) -> !i64 {
        print(self.name);
        print(bytes.text);
        return 2;
    }
}

satisfy Writer for File

fn save(writer: &Dyn<Writer>, bytes: &Bytes) -> !void {
    let n = try writer.write(bytes);
    print(n);
    return;
}

fn main() -> !void {
    let file = File { name: "out" };
    let bytes = Bytes { text: "hello" };
    try save(file, bytes);
    return;
}
