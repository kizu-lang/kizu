struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    let values = std::array::Array<i64>(allocator);
    let users = std::arena::Arena<User>(allocator);
    let names = std::map::Map<[]u8, i64>(allocator);

    defer text.deinit();
    defer values.deinit();
    defer users.deinit();
    defer names.deinit();

    try text.append_bytes("alice");
    std::testing::expect_equal<i64>(5, text.len());

    try values.append(10);
    try values.append(32);
    std::testing::expect_equal<i64>(2, values.len());
    std::testing::expect_equal<i64>(32, values.get_or_panic(1));

    let alice = users.add(User { name: "alice" });
    if false {
        print(users.get(alice).name);
    }

    try names.insert("alice", 1);
    std::testing::expect(names.contains("alice"));
    std::testing::expect_equal<i64>(1, try names.get("alice"));

    return;
}
