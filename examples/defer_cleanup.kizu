struct User {
    name: []const u8;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    let values = std::array::Array<i64>(allocator);
    let users = arena<User>(allocator);
    let names = std::map::Map<[]const u8, i64>(allocator);

    defer text.deinit();
    defer values.deinit();
    defer users.deinit();
    defer names.deinit();

    try text.append_bytes("alice");
    try std::testing::expect_equal_i64(5, text.len());

    try values.append(10);
    try values.append(32);
    try std::testing::expect_equal_i64(2, values.len());
    try std::testing::expect_equal_i64(32, try values.get(1));

    let alice = users.add(User { name: "alice" });
    if false {
        print(users.get(alice).name);
    }

    try names.insert("alice", 1);
    try std::testing::expect_equal_bool(true, names.contains("alice"));
    try std::testing::expect_equal_i64(1, try names.get("alice"));

    return;
}
