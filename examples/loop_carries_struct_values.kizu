struct Point {
    x: i64,
    y: i64,
}

// A struct a loop carries is a value: what one trip keeps of it does not
// change when a later trip updates or rebuilds it.
fn main() -> void {
    // The point is updated in place each trip; the copy taken on the
    // previous trip still holds the old position.
    var point = Point { x: 0, y: 0 };
    var previous = point;
    for 0..3 |i| {
        point.x = point.x + 2;
        let current = point;
        print(current.x - previous.x);
        previous = current;
    }

    // Each trip builds a new point; the one kept from the trip before is not
    // overwritten by it.
    var kept = Point { x: 0, y: 0 };
    for 1..4 |i| {
        let built = Point { x: i * 10, y: i };
        print(built.x - kept.x);
        kept = built;
    }

    // Two points trade values every trip.
    var left = Point { x: 1, y: 2 };
    var right = Point { x: 3, y: 4 };
    for 0..3 |i| {
        let swapped = left;
        left = right;
        right = swapped;
        print(left.x * 10 + right.x);
    }
}

// run
// features: struct for assignment copy
// output:
// 2
// 2
// 2
// 10
// 10
// 10
// 31
// 13
// 31
