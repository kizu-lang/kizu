fn shared(value: &i64) -> &i64 borrows value {
    return value;
}

fn mutable(value: &var i64) -> &var i64 borrows value {
    return value;
}

fn main() -> !void {
    var value = 41;

    let read = shared(value);
    std::testing::expect(read.* == 41);

    let write = mutable(value);
    write.* = 42;

    let after = shared(value);
    std::testing::expect(after.* == 42);
    return;
}
