fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    let source = "lexer";

    try text.append_bytes(source);
    print(source);

    try text.append_byte(cast<u8>(32));
    try text.append_bytes("token");

    let bytes = text.as_bytes();
    print(bytes);
    print(text.len());

    text.clear();
    try text.append_bytes("done");

    let final = text.as_bytes();
    print(final);

    text.deinit();
    return void;
}
