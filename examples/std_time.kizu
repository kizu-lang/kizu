import std::time;

fn main() {
    let timeout = time::seconds(30);
    print(timeout.as_millis());
    let budget = timeout.add(time::minutes(1));
    print(budget.as_seconds());
    let two_hours = time::hours(2);
    let rest = two_hours.sub(time::minutes(15));
    print(rest.as_minutes());
    let day = time::days(1);
    print(day.as_hours());
    let short = time::millis(1500);
    print(short.as_seconds());
    let back = time::millis(-1500);
    print(back.as_seconds());
    print(timeout.less_than(budget));
    let tripled = timeout.times(3);
    print(tripled.equals(time::millis(90000)));

    // A moment on the monotonic clock. A program writes
    // `time::instant(process::monotonic_millis())`; this one stands still.
    let started = time::instant(1000);
    let now = time::instant(3250);
    let elapsed = now.since(started);
    print(elapsed.as_millis());
    print(elapsed.greater_than(time::seconds(2)));
    let deadline = started.add(time::seconds(2));
    print(deadline.before(now));
    let earlier = now.sub(time::millis(250));
    print(earlier.equals(time::instant(3000)));

    // A moment on the wall clock, counted from the Unix epoch.
    let epoch = time::unix(0);
    let later = epoch.add(time::days(365));
    print(later.as_millis());
    let year = later.since(epoch);
    print(year.as_days());
    print(epoch.after(later));
    let expiry = time::unix_seconds(1700000000);
    print(expiry.as_millis());
    print(later.as_seconds());
    return;
}

// run
// features: std-time duration instant unix-time
// output:
// 30000
// 90
// 105
// 24
// 1
// -1
// true
// true
// 2250
// true
// true
// true
// 31536000000
// 365
// false
// 1700000000000
// 31536000
