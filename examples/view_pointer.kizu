// `ptr_of(v)` is the address of a view's first element as `ptr<const T>`,
// and `mut_ptr_of(v)` is the same address as `ptr<T>` from a writable view.
// Taking the address is safe; what uses the pointer is the `unsafe` step.
// This is how a view's memory is handed to C without copying.
import std::mem;

extern "c" fn memcmp(left: ptr<const u8>, right: ptr<const u8>, size: usize) -> i32
fn fill(values: &var []f64, count: usize, start: f64) -> void {
    let base = mut_ptr_of(values);
    var index: usize = 0;
    while index < count {
        // SAFETY: the caller passes the view's own length as count.
        let address = unsafe int_from_ptr<usize>(base) + index * 8;
        // SAFETY: address is a slot inside the view, as computed above.
        unsafe ptr_write(unsafe ptr_from_int<ptr<f64>>(address), start + 1.0);
        index = index + 1;
    }
    return;
}

fn same_bytes(left: []u8, right: []u8) -> bool {
    if mem::len(left) != mem::len(right) {
        return false;
    }
    let size = cast<usize>(mem::len(left));
    // SAFETY: both views have size bytes, and memcmp reads exactly that many.
    return unsafe memcmp(ptr_of(left), ptr_of(right), size) == 0;
}

fn main() -> void {
    var buffer = [3]f64{};
    let values = buffer.as_mut_slice();
    fill(values, 3, 1.5);
    let first = ptr_of(values);
    // SAFETY: the view still borrows the buffer, so the pointer is live.
    print(unsafe ptr_read(first) == 2.5);
    print(same_bytes("kizu", "kizu"));
    print(same_bytes("kizu", "kizo"));
    return;
}

// run
// features: extern-c raw-pointer view
// output:
// true
// true
// false
