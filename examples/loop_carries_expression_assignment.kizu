fn main() -> void {
    // An `if` used as a value is still a statement inside, so an assignment
    // written in one of its arms is a name the loop carries. Reading only the
    // statements of the body misses it, and the loop then reads what the name
    // held before it ran.
    var total = 0;
    var i = 0;
    while i < 4 {
        let step = if i > 1 { total = total + 10; total } else { total = total + 1; total };
        print(step);
        i = i + 1;
    }
    print(total);

    // The same in a `for`, and nested one expression deeper.
    var seen = 0;
    for 0..3 |j| {
        let size = double(if j > 0 { seen = seen + 2; seen } else { seen = seen + 1; seen });
        print(size);
    }
    print(seen);
}

fn double(value: i64) -> i64 {
    return value * 2;
}
