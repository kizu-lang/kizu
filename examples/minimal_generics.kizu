fn identity<T>(value: T) -> T {
    return value;
}

fn is_i64<T>(value: T) -> bool {
    comptime if T == type<i64> {
        return true;
    } else {
        return false;
    }
}

fn main() -> !void {
    std::testing::expect_equal<i64>(7, identity<i64>(7));
    std::testing::expect_equal<[]u8>("kizu", identity<[]u8>("kizu"));
    std::testing::expect(is_i64<i64>(1));
    std::testing::expect_equal<bool>(false, is_i64<bool>(false));
    return;
}
