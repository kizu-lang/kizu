fn Identity<T>(value: T) -> T {
    return value;
}

fn IsI64<T>(value: T) -> bool {
    comptime if T == type<i64> {
        return true;
    } else {
        return false;
    }
}

fn main() -> !void {
    std::testing::expect_equal<i64>(7, Identity<i64>(7));
    std::testing::expect_equal<[]const u8>("kizu", Identity<[]const u8>("kizu"));
    std::testing::expect(IsI64<i64>(1));
    std::testing::expect_equal<bool>(false, IsI64<bool>(false));
    return;
}
