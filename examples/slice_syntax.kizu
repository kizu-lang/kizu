fn main() -> !void {
    let bytes = "lexer token";
    let first = try bytes[0];
    let lexer = try bytes[0..5];
    let token = try bytes[6..];
    let prefix = try bytes[..5];

    try std::testing::expect_equal_i64(108, cast<i64>(first));
    try std::testing::expect_equal_bytes("lexer", lexer);
    try std::testing::expect_equal_bytes("token", token);
    try std::testing::expect_equal_bytes("lexer", prefix);
    return void;
}
