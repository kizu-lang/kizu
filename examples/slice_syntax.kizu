fn main() -> !void {
    let bytes = "lexer token";
    let first = bytes[0];
    let lexer = bytes[0..5];
    let token = bytes[6..];
    let prefix = bytes[..5];

    std::testing::expect(108 == cast<i64>(first));
    std::testing::expect(std::mem::equal_bytes("lexer", lexer));
    std::testing::expect(std::mem::equal_bytes("token", token));
    std::testing::expect(std::mem::equal_bytes("lexer", prefix));
    return;
}
