import std;

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var entries = try std::fs::read_dir(
        io,
        allocator,
        "examples/fixtures/read_dir"
    );
    defer entries.deinit(allocator);

    var index = 0;
    while entries.at(index) |entry| {
        let name = entry.name.as_bytes();
        let path = entry.path.as_bytes();
        print(name);
        print(path);
        print(entry.is_dir);
        index = index + 1;
    }
    return;
}

// run
// features: std-fs read-dir explicit-io
// dir: .
// output:
// alpha.txt
// examples/fixtures/read_dir/alpha.txt
// false
// beta.txt
// examples/fixtures/read_dir/beta.txt
// false
// nested
// examples/fixtures/read_dir/nested
// true
