import std::array;
import std::mem;

fn fill(row: &var []i64, value: i64) -> void {
    for 0..mem::count<i64>(row) |i| {
        row[i] = value;
    }
    return;
}

// `&var v[a..b]` lends a range of a writable view for writing: as a local
// binding, or straight into a `&var []T` parameter. While the range is lent,
// the whole of `v` is mutably borrowed -- which elements two ranges share is
// not something the checker proves -- so the next range waits for the last
// use of the previous one. A range of a range works the same way.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = array::new<i64>(allocator);
    defer counts.deinit(allocator);
    for 0..6 |i| {
        try counts.append(allocator, i);
    }
    let cells = counts.as_mut_slice();
    let head = &var cells[0..2];
    head[0] = head[0] + 100;
    fill(&var cells[2..4], 7);
    let tail = &var cells[4..6];
    let last = &var tail[1..2];
    last[0] = -1;
    for 0..6 |i| {
        print(counts.get_or_panic(i));
    }
    return;
}

// run
// features: typed_view borrow mutable-borrow slice
// output:
// 100
// 1
// 7
// 7
// 4
// -1
