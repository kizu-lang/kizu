// A static argument may be integer arithmetic in parentheses. The names in it
// are what is known at compile time where the call is written -- a static
// parameter of the caller, or a `comptime for` capture -- and the value is
// the instance: `scaled<(n * 2 + 1)>` with n = 4 is `scaled<9>`.
fn scaled<k: i64>() -> i64 {
    comptime if k > 5 {
        return k * 100;
    }
    return k;
}

fn odd_after<n: i64>() -> i64 {
    return scaled<(n * 2 + 1)>();
}

fn main() -> void {
    // The parentheses keep a `>` or `%` inside from reading as the end of
    // the list, and an index computed from two captures travels whole.
    comptime for 0..3 |row| {
        comptime for 0..3 |col| {
            print(scaled<((row * 3 + col) % 7)>());
        }
    }
    print(odd_after<4>());
    print(scaled<(-2)>());
}

// run
// features: comptime comptime-for generics
// output:
// 0
// 1
// 2
// 3
// 4
// 5
// 600
// 0
// 1
// 900
// -2
