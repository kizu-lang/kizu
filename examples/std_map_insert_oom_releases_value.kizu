import std::map;
import std::mem;

struct Ticket {
    id: i64,
}

fn (self: Ticket) deinit() -> void {
    print(self.id);
    return;
}

// A consuming call that fails still consumes (SPEC §8): an insert the
// allocator refuses releases the value it could not store.
fn main() -> !void {
    var raw = [32]u8{};
    let bytes = raw.as_mut_bytes();
    let allocator = mem::fixed_buffer(bytes);
    var tickets = map::new<i64, Ticket>(allocator);
    defer tickets.deinit(allocator);
    if tickets.insert(allocator, 1, Ticket { id: 7 }) {
        print("stored");
    } else |err| {
        print("refused");
    }
    print(tickets.len());
    return;
}

// run
// features: std-map ownership fixed-buffer error-union
// pending: Map.insert does not release the moved value when the allocator refuses
// output:
// 7
// refused
// 0
