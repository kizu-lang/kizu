import std::mem;

struct Counter {
    count: i64,
}

fn (self: Counter) deinit(allocator: Allocator) -> void {
    print(self.count);
    return;
}

// Deferred cleanup runs on the value the name holds when the block exits,
// so writes after the `defer` line are what the cleanup sees.
fn main() -> void {
    let allocator = mem::page_allocator();
    var counter = Counter { count: 0 };
    defer counter.deinit(allocator);
    counter.count = 5;
    var step = 0;
    while step < 3 {
        counter.count = counter.count + 1;
        step = step + 1;
    }
    return;
}

// run
// features: defer ownership field-assignment
// output:
// 8
