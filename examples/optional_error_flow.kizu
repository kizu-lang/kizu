error ParseError {
    Bad,
    Empty,
}

struct Pair {
    left: i64,
    right: i64
}

struct Results {
    maybe: ?Pair,
    parsed: ParseError!Pair
}

struct Cleanup {
    id: i64
}

fn (self: Cleanup) deinit() -> void {
    print(self.id);
    return;
}

fn maybe(ok: bool) -> ?i64 {
    if ok {
        return 7;
    }
    return null;
}

fn parse(ok: bool) -> ParseError!i64 {
    if ok {
        return 9;
    }
    return ParseError::Bad;
}

fn forward(ok: bool) -> ParseError!i64 {
    return try parse(ok);
}

fn maybe_pair(ok: bool) -> ?Pair {
    if ok {
        return Pair { left: 5, right: 6 };
    }
    return null;
}

fn parse_pair(ok: bool) -> ParseError!Pair {
    if ok {
        return Pair { left: 7, right: 8 };
    }
    return ParseError::Empty;
}

fn maybe_parse_pair(kind: i64) -> ParseError!?Pair {
    if kind < 0 {
        return ParseError::Bad;
    }
    if kind == 0 {
        return null;
    }
    return Pair { left: 2, right: 3 };
}

fn nested_total(kind: i64) -> ParseError!i64 {
    let pair = try maybe_parse_pair(kind) orelse Pair { left: 0, right: 0 };
    return pair.left + pair.right;
}

fn collect() -> Results {
    return Results {
        maybe: maybe_pair(true),
        parsed: parse_pair(true)
    };
}

fn cleanup_forward(ok: bool, id: i64) -> ParseError!void {
    let cleanup = Cleanup { id: id };
    errdefer cleanup.deinit();
    let value = try parse(ok);
    print(value);
    cleanup.deinit();
    return;
}

fn describe(failure: ParseError) -> i64 {
    return match failure {
        Bad => -2,
        Empty => -3,
    };
}

fn main() -> ParseError!void {
    if maybe(true) |value| {
        print(value);
    }
    print(maybe(false) orelse -1);
    if forward(true) |value| {
        print(value);
    } else |failure| {
        print(describe(failure));
    }
    if forward(false) |value| {
        print(value);
    } else |failure| {
        print(describe(failure));
    }
    if maybe_pair(true) |pair| {
        print(pair.left + pair.right);
    }
    if parse_pair(true) |pair| {
        print(pair.left + pair.right);
    } else |failure| {
        print(describe(failure));
    }
    let results = collect();
    if results.maybe |pair| {
        print(pair.left + pair.right);
    }
    if results.parsed |pair| {
        print(pair.left + pair.right);
    } else |failure| {
        print(describe(failure));
    }
    if nested_total(1) |value| {
        print(value);
    } else |failure| {
        print(describe(failure));
    }
    if nested_total(0) |value| {
        print(value);
    } else |failure| {
        print(describe(failure));
    }
    if nested_total(-1) |value| {
        print(value);
    } else |failure| {
        print(describe(failure));
    }
    if cleanup_forward(true, 41) {
        print(1);
    } else |failure| {
        print(describe(failure));
    }
    if cleanup_forward(false, 42) {
        print(1);
    } else |failure| {
        print(describe(failure));
    }
    return;
}

// run
// features: optional error-set error-union try match capture errdefer struct
// output:
// 7
// -1
// 9
// -2
// 11
// 15
// 11
// 15
// 5
// 0
// -2
// 9
// 41
// 1
// 42
// -2
