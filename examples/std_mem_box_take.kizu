import std::mem;
import std::string;

fn owned_text(allocator: Allocator, bytes: []u8) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit();
    try text.append_bytes(bytes);
    return move text;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let boxed = try mem::box<string::String>(
        allocator,
        try owned_text(allocator, "payload")
    );
    let text = boxed.take();
    defer text.deinit();
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

// run
// features: std-mem box take ownership
// output:
// payload
