struct Token {
    text: []const u8;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var tokens = std::array::Array<Token>(allocator);

    try tokens.append(Token { text: "let" });

    let first = try tokens.at(0);
    print(first.text);

    let slot = try tokens.at_mut(0);
    slot.* = Token { text: "var" };

    let updated = try tokens.at(0);
    print(updated.text);

    tokens.deinit();
    return;
}
