import std::array;
import std::mem;

struct Point {
    pub x: i64,
    pub y: i64,
}

fn sum_x(points: []Point) -> i64 {
    var total = 0;
    for 0..mem::count<Point>(points) |i| {
        total = total + points[i].x;
    }
    return total;
}

fn shift(points: &var []Point, dx: i64) -> void {
    for 0..mem::count<Point>(points) |i| {
        let p = points[i];
        points[i] = Point { x: p.x + dx, y: p.y };
    }
    return;
}

// A view's element is any copy data, not only a number: a struct of numbers
// is read out of the view as a copy and written back whole. An Array of such
// elements lends them the way an Array of numbers does.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var points = array::new<Point>(allocator);
    defer points.deinit(allocator);
    for 0..4 |i| {
        try points.append(allocator, Point { x: i, y: i * 10 });
    }
    let view = points.as_slice();
    print(sum_x(view));
    print(view[3].y);

    let cells = points.as_mut_slice();
    shift(cells, 100);
    print(cells[0].x);
    let tail = cells[2..4];
    print(sum_x(tail));
    print(points.get_or_panic(3).x);
    return;
}

// run
// features: std-array typed_view struct borrow mutable-borrow
// output:
// 6
// 30
// 100
// 205
// 103
