// A borrowed optional: the caller's `?T`, filled in by the callee.
//
// `&var ?i64` lends an optional the way `&var i64` lends an integer. The
// callee can put a value in, take it out again with `null`, and read what is
// there through the usual capture. Nothing is converted and nothing is
// copied out of the caller's hands: the storage is the caller's, and every
// write lands in it.
//
// Only an optional of copy data can be lent. A capture takes the payload
// out, and copy data comes out as a copy the caller's optional still has; an
// owner would come out as the one value there is, leaving the caller's
// optional saying it holds what it no longer does.

fn fill(slot: &var ?i64, value: i64) -> void {
    slot = value;
    return;
}

fn clear(slot: &var ?i64) -> void {
    slot = null;
    return;
}

// bump reads through the borrow and writes back through it.
fn bump(slot: &var ?i64) -> void {
    if slot |current| {
        slot = current + 1;
    }
    return;
}

// peek reads only, so it borrows without `var`.
fn peek(slot: &?i64) -> i64 {
    return slot orelse -1;
}

fn main() -> void {
    var found: ?i64 = null;
    print(peek(&found));
    fill(&var found, 7);
    print(peek(&found));
    bump(&var found);
    print(peek(&found));
    clear(&var found);
    print(peek(&found));
    return;
}

// run
// features: optional borrow null
// output:
// -1
// 7
// 8
// -1
