import std::float;
import std::mem;
import std::string;

fn show(allocator: Allocator, value: f64) -> !void {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try float::append(allocator, &var text, value);
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    try show(allocator, 0.1 + 0.2);
    try show(allocator, 100.0);
    try show(allocator, 1.0 / 3.0);
    try show(allocator, 1e21);
    try show(allocator, 1.5e-7);
    try show(allocator, -0.0);
    try show(allocator, 1.0 / 0.0);
    if try float::parse(allocator, "2.5e3") |value| {
        print(cast<i64>(value));
    }
    if try float::parse(allocator, "0.1") |value| {
        print(value == 0.1);
    }
    if try float::parse(allocator, "1_000") |_| {
        print("accepted");
    } else {
        print("not a number");
    }
    return;
}

// run
// features: std-float append parse shortest
// output:
// 0.30000000000000004
// 100.0
// 0.3333333333333333
// 1e21
// 1.5e-7
// -0.0
// inf
// 2500
// true
// not a number
