import std::arena;
import std::array;
import std::map;
import std::mem;

struct User {
    name: []u8,
}

struct Holder {
    values: array::Array<i64>,
}

fn (self: Holder) deinit() -> void {
    self.values.deinit();
}

union Slot {
    Empty,
    UserHandle(arena::Handle<User>),
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let handles = array::new<arena::Handle<User>>(allocator);
    let maps = array::new<map::Map<[]u8, i64>>(allocator);
    let holders = array::new<Holder>(allocator);
    let slots = array::new<Slot>(allocator);

    let alice = users.add(User { name: "alice" });
    try handles.append(alice);
    print(handles.len());

    let table = map::new<[]u8, i64>(allocator);
    try maps.append(table);
    let moved_table = try maps.pop();
    moved_table.deinit();

    let inner = array::new<i64>(allocator);
    try inner.append(7);
    try holders.append(Holder { values: inner });
    let holder = try holders.pop();
    print(holder.values.get_or_panic(0));
    holder.deinit();

    let bob = users.add(User { name: "bob" });
    try slots.append(Slot::UserHandle(bob));
    print(slots.len());
    slots.deinit();
    holders.deinit();
    maps.deinit();
    handles.deinit();
    users.deinit();
    return;
}

// run
// features: std-array std-map arena ownership resource-element
// output:
// 1
// 7
// 1
