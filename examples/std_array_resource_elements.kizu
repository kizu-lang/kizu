struct User {
    name: []u8,
}

struct Holder {
    values: std::array::Array<i64>,
}

impl Holder {
    fn deinit(self: Holder) -> void {
        self.values.deinit();
    }
}

union Slot {
    Empty,
    UserHandle(std::arena::Handle<User>),
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let users = std::arena::Arena<User>(allocator);
    let handles = std::array::Array<std::arena::Handle<User>>(allocator);
    let maps = std::array::Array<std::map::Map<[]u8, i64>>(allocator);
    let holders = std::array::Array<Holder>(allocator);
    let slots = std::array::Array<Slot>(allocator);

    let alice = users.add(User { name: "alice" });
    try handles.append(alice);
    print(handles.len());

    let table = std::map::Map<[]u8, i64>(allocator);
    try maps.append(table);
    let moved_table = try maps.pop();
    moved_table.deinit();

    let inner = std::array::Array<i64>(allocator);
    try inner.append(7);
    try holders.append(Holder { values: inner });
    let holder = try holders.pop();
    print(holder.values.get_or_panic(0));
    holder.deinit();

    let bob = users.add(User { name: "bob" });
    try slots.append(Slot::UserHandle(bob));
    print(slots.len());
    slots.deinit();
    holders.deinit();
    maps.deinit();
    handles.deinit();
    users.deinit();
    return;
}

// run
// features: std-array std-map arena ownership resource-element
// output:
// 1
// 7
// 1
