fn low_nibble(flags: u8) -> u8 {
    return flags & 0x0F;
}

fn main() {
    let a = 0b1100;
    let b = 0x0A;
    print(a & b);
    print(a | b);
    print(a ^ b);
    print(~a);
    print(1 << 10 | 1 << 3);
    print(1_000_000 >> 3);
    print(-16 >> 2);
    print(1 << 64);
    print(-1 >> 70);
    print((1 << 64) - 1 == -1);
    print(low_nibble(0xAB));
    let byte = cast<u8>(200);
    print(byte + 100);
    let top = cast<u64>(1) << 63;
    print(top / 2 == cast<u64>(1) << 62);
    print(top % 3);
    print(top >> 63);
    return;
}

// run
// features: bitwise shift wrap integer-literal
// output:
// 8
// 14
// 6
// -13
// 1032
// 125000
// -4
// 0
// -1
// true
// 11
// 44
// true
// 2
// 1
