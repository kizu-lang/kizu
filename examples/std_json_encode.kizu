import std::json;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var encoder = json::encoder(allocator);
    defer encoder.deinit(allocator);

    try encoder.begin_object();
    try encoder.write_i64_field("id", 7);
    try encoder.write_bytes_field("name", "al\ice");
    try encoder.write_bool_field("active", true);
    try encoder.begin_object_field("profile");
    try encoder.write_bytes_field("city", "kyoto");
    try encoder.end_object();
    try encoder.begin_array_field("tags");
    try encoder.write_i64(3);
    try encoder.write_i64(5);
    try encoder.write_null();
    try encoder.end_array();
    try encoder.end_object();

    var text = string::new(allocator);
    defer text.deinit(allocator);
    try encoder.finish_into(allocator, text);
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

// run
// features: std-json std-string method defer
// output:
// {"id":7,"name":"al\\ice","active":true,"profile":{"city":"kyoto"},"tags":[3,5,null]}
