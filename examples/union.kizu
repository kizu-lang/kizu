union Shape {
    Point
    Circle(i64)
    Label(string)
}

fn describe(shape: borrow Shape) -> void {
    match shape {
        Point => print("point")
        Circle(radius) => print(radius)
        Label(text) => print(text)
    }
}

fn main() {
    let circle = Shape.Circle(10)
    let label = Shape.Label("name")

    describe(circle)
    describe(label)
    describe(Shape.Point)
}
