import std::mem;
import std::string;

enum Step {
    Emit,
    Skip,
}

fn step_of(index: i64) -> Step {
    if index - (index / 2) * 2 == 0 {
        return Step::Emit;
    }
    return Step::Skip;
}

// `Skip => {}` is a no-op arm (ADR-0107). Unlike `Skip => return,` it does
// not leave the function, so every loop iteration still runs.
fn emit_even(limit: i64) -> void {
    var i = 0;
    while i < limit {
        match step_of(i) {
            Emit => print(i),
            Skip => {},
        }
        i = i + 1;
    }
    return;
}

union Slot {
    Kept(string::String),
    Vacant
}

// A mixed-variant deinit spells the nothing-to-clean arm `{}`.
fn (self: Slot) deinit(allocator: Allocator) -> void {
    match self {
        Kept(payload) => payload.deinit(allocator),
        Vacant => {},
    }
    return;
}

fn main() -> !void {
    emit_even(6);
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_bytes(allocator, "kept");
    let kept = Slot::Kept(move name);
    kept.deinit(allocator);
    let vacant = Slot::Vacant;
    vacant.deinit(allocator);
    print("done");
    return;
}

// run
// features: match arm-empty union deinit
// output:
// 0
// 2
// 4
// done
