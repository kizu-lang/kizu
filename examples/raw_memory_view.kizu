// Raw memory becomes a view with `view_from_ptr(p, count)`, or a writable
// one with `let v = mut_view_from_ptr(p, count)`, and `ptr_offset(p, count)`
// steps a pointer by elements. All three are `unsafe`: nothing checks that
// count elements are there, or that they stay there while the view is used.
extern "c" fn malloc(size: usize) -> ptr<u8>
extern "c" fn free(p: ptr<u8>) -> void
fn sum(values: []i64, count: i64) -> i64 {
    var total: i64 = 0;
    for 0..count |index| {
        total = total + values[index];
    }
    return total;
}

fn main() -> void {
    // SAFETY: 4 i64 cells are 32 bytes, and the block is freed below.
    let block = unsafe malloc(32);
    // SAFETY: the block holds 4 i64 cells and nothing else reads it yet.
    let cells = unsafe cast<ptr<i64>>(block);
    // SAFETY: the block has room for 4 cells, as allocated above.
    let values = unsafe mut_view_from_ptr(cells, 4);
    values[0] = 10;
    values[1] = 20;
    values[2] = 30;
    values[3] = 40;
    print(sum(values, 4));
    // SAFETY: cell 2 is inside the 4-cell block, and 2 cells follow it.
    let tail = unsafe ptr_offset(cells, 2);
    // SAFETY: 2 cells follow the pointer inside the block.
    let last_two = unsafe view_from_ptr(tail, 2);
    print(sum(last_two, 2));
    // SAFETY: block came from malloc above and no view of it is used again.
    unsafe free(block);
    return;
}

// run
// features: extern-c raw-pointer view
// output:
// 100
// 70
