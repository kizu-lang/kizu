fn define(symbols: &var std::map::Map<[]u8, i64>) -> !void {
    try symbols.insert("main", 1);
    return;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var symbols = std::map::Map<[]u8, i64>(allocator);

    try define(symbols);
    print(try symbols.get("main"));

    symbols.deinit();
    return;
}

// run
// features: std-map mutable-borrow
// output:
// 1
