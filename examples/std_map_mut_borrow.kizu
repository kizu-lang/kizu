import std::map;
import std::mem;

fn define(symbols: &var map::Map<[]u8, i64>) -> !void {
    try symbols.insert("main", 1);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var symbols = map::Map<[]u8, i64>(allocator);

    try define(symbols);
    print(try symbols.get("main"));

    symbols.deinit();
    return;
}

// run
// features: std-map mutable-borrow
// output:
// 1
