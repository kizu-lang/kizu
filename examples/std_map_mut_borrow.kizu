fn define(symbols: &mut std::map::Map<[]const u8, i64>) -> !void {
    try symbols.insert("main", 1);
    return;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var symbols = std::map::Map<[]const u8, i64>(allocator);

    try define(symbols);
    print(try symbols.get("main"));

    symbols.deinit();
    return;
}
