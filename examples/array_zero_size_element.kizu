import std::array;
import std::mem;

// An element with no fields takes no bytes, so the array's storage never
// grows: only the count does. The growth path has to notice that, because
// asking an allocator to resize a block to zero bytes is a release on some of
// them, and the array would then hold a pointer it no longer owns. Reads still
// find every element the count says is there.
struct Marker {}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var markers = array::new<Marker>(allocator);
    defer markers.deinit(allocator);
    var count = 0;
    while count < 100 {
        try markers.append(allocator, Marker {});
        count = count + 1;
    }
    print(markers.len());
    if markers.get(99) |_| {
        print("last element present");
    }
    if markers.at_mut(50) |_| {
        print("middle element present");
    }
    if markers.pop() |_| {
        print("popped");
    }
    print(markers.len());
    return;
}

// run
// features: std-array zero-size struct
// output:
// 100
// last element present
// middle element present
// popped
// 99
