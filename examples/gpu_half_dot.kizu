import std::gpu;

export "gpu" fn half_dot(out: &var []f32, packed: []u16, scales: []f32) -> void {
    let index = gpu::thread_index();
    let value = gpu::f32_from_half(packed[index]);
    let rounded = gpu::f32_from_half(gpu::half_from_f32(scales[index]));
    out[index] = gpu::fma(value, rounded, out[index]);
    return;
}

// check
// features: gpu-export
