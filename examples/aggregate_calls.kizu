struct Pair {
    first: i64,
    second: i64,
}

fn flip(pair: Pair) -> Pair {
    return Pair { first: pair.second, second: pair.first };
}

fn apply(transform: fn(Pair) -> Pair, pair: Pair) -> Pair {
    return transform(pair);
}

fn descend(pair: Pair, remaining: i64) -> Pair {
    if remaining == 0 {
        return pair;
    }
    return descend(
        Pair { first: pair.first + 1, second: pair.second + 1 },
        remaining - 1,
    );
}

fn main() -> void {
    let flipped = apply(flip, Pair { first: 1, second: 2 });
    let result = descend(flipped, 2);
    print(result.first);
    print(result.second);
}

// run
// features: struct function-pointer
// output:
// 4
// 3
