import std::fmt;
import std::mem;
import std::string;

// weighted_sum walks a 3x2 grid of weights unrolled at compile time. The
// captures are integers the body may do arithmetic on, and a `comptime if`
// written against them is decided per expansion: a cell whose row or column
// is 0 adds its term without a multiply, so no `if` reaches the binary, and
// no loop does either.
fn weighted_sum(a: i64, b: i64, c: i64) -> i64 {
    var total = 0;
    comptime for 0..3 |row| {
        comptime for 0..2 |col| {
            comptime if row * col == 0 {
                total = total + pick(a, b, c, row) + col;
            } else {
                total = total + pick(a, b, c, row) * (row * col + 1);
            }
        }
    }
    return total;
}

fn pick(a: i64, b: i64, c: i64, index: i64) -> i64 {
    if index == 0 {
        return a;
    }
    if index == 1 {
        return b;
    }
    return c;
}

// An empty range expands to nothing, and each expansion is its own scope, so
// the same capture name serves the next loop.
fn count_expansions() -> i64 {
    var count = 0;
    comptime for 4..4 |i| {
        count = count + i;
    }
    comptime for 2..5 |i| {
        count = count + i;
    }
    return count;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try fmt::append_i64(allocator, out, weighted_sum(1, 10, 100));
    try out.append_bytes(allocator, " ");
    try fmt::append_i64(allocator, out, count_expansions());
    let bytes = out.as_bytes();
    print(bytes);
    return;
}

// run
// features: comptime comptime-for
// output:
// 433 9
