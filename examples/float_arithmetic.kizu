import std::float;
import std::process;

fn half(value: f64) -> f64 {
    return value / 2.0;
}

fn scale(value: f32) -> f32 {
    return value * 4.0;
}

fn twice(value: f64) -> f64 {
    return value * 2.0;
}

fn twice_left(value: f32) -> f32 {
    return 2.0 * value;
}

// The bits of value * 2 for a value made at run time, so nothing folds it.
fn twice_bits(bits: i64) -> i64 {
    let value = float::from_bits(cast<u64>(bits + process::arg_count()));
    return cast<i64>(float::bits(twice(value)));
}

fn main() {
    print(cast<i64>(half(7.0)));
    print(cast<i64>(2.5 * 4.0 + 1e1));
    print(cast<i64>(-1.5));
    print(cast<i64>(scale(1.5)));
    print(cast<f64>(3) == 3.0);
    print(0.1 + 0.2 == 0.3);
    print(0.1 + 0.2 > 0.3);
    let nan = 0.0 / 0.0;
    print(nan == nan);
    print(nan != nan);
    print(1.0 / 0.0 > 1e22);
    print(cast<i64>(1e22 * 1e22));
    print(cast<i64>(-1e22 * 1e22));
    print(cast<i64>(nan));
    print(cast<u8>(300.0));
    print(float::bits(1.0) == 0x3FF0000000000000);
    print(float::from_bits(0x4000000000000000) == 2.0);
    // Doubling: -0 stays -0, overflow is infinity, a NaN keeps its sign
    // and payload and comes out quiet, the least subnormal doubles exactly.
    print(twice_bits(0 - 0x7FFFFFFFFFFFFFFF - 1));
    print(twice_bits(0x7FEFFFFFFFFFFFFF));
    print(twice_bits(0 - 0x10000000000000));
    print(twice_bits(0x7FF0000000000001));
    print(twice_bits(0 - 0x7FFFFFFFFFEDD));
    print(twice_bits(1));
    let small = cast<f32>(1.5) + cast<f32>(process::arg_count());
    print(cast<f64>(twice_left(small)));
    print(cast<f64>(twice_left(small * cast<f32>(2e38))) > 1e300);
    return;
}

// run
// features: float f64 f32 cast saturate nan
// output:
// 3
// 20
// -1
// 6
// true
// false
// true
// false
// true
// true
// 9223372036854775807
// -9223372036854775808
// 0
// 255
// true
// true
// -9223372036854775808
// 9218868437227405312
// -4503599627370496
// 9221120237041090561
// -2251799813684957
// 2
// 3.0
// true
