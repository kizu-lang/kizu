import std::machine;
import std::mem;

// The transition function is the only statement of the machine. The table and
// its problems are read from it by calling it for every state and event.
enum Job {
    Waiting,
    Running,
    Done,
    Forgotten,
}

enum Signal {
    Begin,
    Finish,
}

fn step(job: Job, signal: Signal) -> ?Job {
    match job {
        Waiting => match signal {
            Begin => return Job::Running,
            _ => {},
        },
        Running => match signal {
            Finish => return Job::Done,
            _ => {},
        },
        Done => {},
        Forgotten => {},
    }
    return null;
}

fn is_end(job: Job) -> bool {
    return job == Job::Done;
}

fn main() -> mem::Error!void {
    let allocator = mem::page_allocator();
    let table = try machine::table<Job, Signal>(allocator, step, Job::Waiting, is_end);
    defer table.deinit(allocator);
    var index = 0;
    while table.moves.at(index) |entry| {
        print(entry.from);
        print(entry.event);
        print(entry.to);
        index = index + 1;
    }
    var problems = try table.problems(allocator);
    defer problems.deinit(allocator);
    index = 0;
    while problems.at(index) |line| {
        let bytes = line.as_bytes();
        print(bytes);
        index = index + 1;
    }
    return;
}

// run
// features: std-machine enum match optional function-pointer
// output:
// Waiting
// Begin
// Running
// Running
// Finish
// Done
// unreached Forgotten
