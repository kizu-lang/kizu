enum Role {
    Admin;
    Guest;
}

struct User {
    name: []const u8;
    role: Role;
    score: i64;
}

fn role_name(role: Role) -> void {
    match role {
        Admin => print("admin");
        Guest => print("guest");
    }
}

fn score_bonus(comptime base: i64) -> i64 {
    return base + 1;
}

fn load_bonus() -> !i64 {
    return score_bonus(comptime 7);
}

fn show(user: &User) -> void {
    print(user.name);
    role_name(user.role);
    print(user.score);
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let users = arena<User>(allocator);
    let alice = users.add(User {
        name: "alice",
        role: Role::Admin,
        score: try load_bonus(),
    });
    let bob = users.add(User {
        name: "bob",
        role: Role::Guest,
        score: 3,
    });
    show(users.get(alice));
    show(users.get(bob));
    var i = 0;
    while i < 2 {
        print(i);
        i = i + 1;
    }

    if true {
        print("ready");
        users.deinit();
        return;
    } else {
        users.deinit();
        return error("unreachable");
    }
}
