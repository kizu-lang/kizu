enum Role {
    Admin
    Guest
}

struct User {
    name: string
    role: Role
    score: int
}

fn role_name(role: Role) -> void {
    match role {
        Admin => print("admin")
        Guest => print("guest")
    }
}

fn score_bonus(comptime base: int) -> int {
    return base + 1
}

fn load_bonus() -> result<int> {
    return ok(score_bonus(comptime 7))
}

fn show(user: borrow User) -> void {
    print(user.name)
    role_name(user.role)
    print(user.score)
}

fn main() -> result<void> {
    let users = arena<User>()
    let alice = users.add(User {
        name: "alice",
        role: Role.Admin,
        score: try load_bonus(),
    })
    let bob = users.add(User {
        name: "bob",
        role: Role.Guest,
        score: 3,
    })

    show(users.get(alice))
    show(users.get(bob))

    var i = 0
    while i < 2 {
        print(i)
        i = i + 1
    }

    if true {
        print("ready")
        return ok(void)
    } else {
        return error("unreachable")
    }
}
