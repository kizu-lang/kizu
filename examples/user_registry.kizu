import std::arena;
import std::mem;

error RegistryError {
    Unreachable,
}

struct Users {}

enum Role {
    Admin,
    Guest,
}

struct User {
    name: []u8,
    role: Role,
    score: i64,
}

fn role_name(role: Role) -> void {
    match role {
        Admin => print("admin"),
        Guest => print("guest"),
    }
}

fn score_bonus<base: i64>() -> i64 {
    return base + 1;
}

fn load_bonus() -> !i64 {
    return score_bonus<7>();
}

fn show(user: &User) -> void {
    print(user.name);
    role_name(user.role);
    print(user.score);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User, Users>(allocator);
    defer users.deinit(allocator);
    let alice = try users.add(allocator, User {
        name: "alice",
        role: Role::Admin,
        score: try load_bonus(),
    });
    let bob = try users.add(allocator, User {
        name: "bob",
        role: Role::Guest,
        score: 3,
    });
    show(users.at(alice));
    show(users.at(bob));
    var i = 0;
    while i < 2 {
        print(i);
        i = i + 1;
    }

    if true {
        print("ready");
        return;
    } else {
        return RegistryError::Unreachable;
    }
    return;
}

// run
// features: app arena struct enum match contract
// output:
// alice
// admin
// 8
// bob
// guest
// 3
// 0
// 1
// ready
