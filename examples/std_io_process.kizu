fn main() -> !void {
    let io = std::io::blocking();
    let name = try std::process::arg(0);
    let value = try std::process::env("KIZU_TEST_ENV");

    try std::io::write_stdout(io, "stdout:");
    print(std::process::arg_count());
    print(name);
    print(value);
    print(std::process::exit_code(7));

    return;
}

// run -- input.kizu
// features: std-io std-process explicit-io
// output:
// stdout:1
// input.kizu
// env-ok
// 7
