import std::crypto;
import std::mem;
import std::string;

// SHA-512 and SHA-384 are the other hashes a certificate chain may be
// signed with: a public CA's ECDSA P-384 intermediate signs with SHA-384.
// They are SHA-256's shape over 64-bit words and 128-byte blocks; SHA-384
// is SHA-512 from other starting words, cut to 48 bytes.

fn append_hex(allocator: Allocator, out: &var string::String, bytes: []u8) -> mem::Error!void {
    let digits = "0123456789abcdef";
    for 0..mem::len(bytes) |index| {
        let value = cast<i64>(bytes[index]);
        try out.append_byte(allocator, digits[value >> 4]);
        try out.append_byte(allocator, digits[value & 15]);
    }
    return;
}

fn print_hex(allocator: Allocator, bytes: []u8) -> mem::Error!void {
    var hex = string::new(allocator);
    defer hex.deinit(allocator);
    try append_hex(allocator, &var hex, bytes);
    let text = hex.as_bytes();
    print(text);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var long = [64]u8{};
    let long_view = long.as_mut_bytes();
    crypto::sha512("The quick brown fox jumps over the lazy dog", long_view);
    let long_bytes = long.as_bytes();
    try print_hex(allocator, long_bytes);
    var short = [48]u8{};
    let short_view = short.as_mut_bytes();
    crypto::sha384("The quick brown fox jumps over the lazy dog", short_view);
    let short_bytes = short.as_bytes();
    try print_hex(allocator, short_bytes);
    return;
}

// run
// features: crypto sha512 sha384
// output:
// 07e547d9586f6a73f73fbac0435ed76951218fb7d0c8d788a309d785436bbb642e93a252a954f23912547d1e8a3b5ed6e1bfd7097821233fa0538f3db854fee6
// ca737f1014a48f4c0b6dd43cb177b0afd9e5169367544c494011e3317dbf9a509cb1e5dc1e85a941bbee3d7f2afbc9b1
