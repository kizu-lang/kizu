import std::map;
import std::mem;

// insert is the Map call that buys index, entry, key, and value storage, so a
// fixed buffer refusal returns OutOfMemory from that call. Allocations already
// retained by the map stay valid and deinit releases the same partial state.
fn fill(allocator: Allocator, values: &var map::Map<i64, i64>) -> mem::Error!i64 {
    var count = 0;
    while count < 100 {
        try values.insert(allocator, count, count * 2);
        count = count + 1;
    }
    return count;
}

fn main() {
    var raw = [512]u8{};
    let bytes = raw.as_mut_bytes();
    let allocator = mem::fixed_buffer(bytes);
    var values = map::new<i64, i64>(allocator);
    defer values.deinit(allocator);
    let stored = fill(allocator, &var values) catch -1;
    print(stored);
    print("the buffer ran out, and the program chose what to do");
}

// run
// features: std-map allocator fixed-buffer error-union
// output:
// -1
// the buffer ran out, and the program chose what to do
