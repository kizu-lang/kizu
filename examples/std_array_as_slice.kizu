import std::array;
import std::mem;

fn total(values: []f64) -> f64 {
    var sum = 0.0;
    for 0..mem::count<f64>(values) |i| {
        sum = sum + values[i];
    }
    return sum;
}

fn double_all(values: &var []i64) -> void {
    for 0..mem::count<i64>(values) |i| {
        values[i] = values[i] * 2;
    }
    return;
}

// An Array of numbers lends its elements as a view, the way a stack buffer
// does: `as_slice` for reading, `as_mut_slice` for writing in place. The view
// is bound with `let`, and the Array stays borrowed until its last use, so
// nothing can grow or free the storage the view points into.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var samples = array::new<f64>(allocator);
    defer samples.deinit(allocator);
    for 0..4 |i| {
        try samples.append(allocator, cast<f64>(i) * 0.5);
    }
    let view = samples.as_slice();
    print(cast<i64>(total(view) * 10.0));
    print(mem::count<f64>(view));

    var counts = array::new<i64>(allocator);
    defer counts.deinit(allocator);
    try counts.append(allocator, 1);
    try counts.append(allocator, 2);
    try counts.append(allocator, 3);
    let cells = counts.as_mut_slice();
    cells[0] = 10;
    double_all(cells);
    print(counts.get_or_panic(0));
    print(counts.get_or_panic(2));
    try counts.append(allocator, 4);
    print(counts.len());
    return;
}

// run
// features: std-array typed_view borrow mutable-borrow
// output:
// 30
// 4
// 20
// 6
// 4
