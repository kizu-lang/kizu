// Integer arithmetic wraps at the type's width (SPEC §6.9.2): a narrow
// result is brought back into range, signed by sign extension and unsigned
// by masking, on every target. Shifts of a signed value keep the sign; a
// shift by the width or more is 0, or -1 for a negative signed value.
fn main() -> void {
    print(cast<u8>(255) + cast<u8>(1));
    print(cast<i8>(127) + cast<i8>(1));
    print(cast<i8>(0 - 128) - cast<i8>(1));
    print(cast<u16>(65535) + cast<u16>(1));
    print(cast<i16>(0 - 32768) - cast<i16>(1));
    print(cast<u32>(0 - 1) * cast<u32>(2));
    print(cast<i32>(2147483647) + cast<i32>(1));
    print(cast<i64>(1) << 63);
    print(cast<u8>(1) << 7);
    print(cast<u8>(200) << 1);
    print(cast<i8>(0 - 128) >> 7);
    print(cast<u8>(128) >> 7);
    print(cast<i8>(0 - 1) >> 8);
    print(cast<u8>(255) >> 8);
    print(cast<i16>(0 - 1) & cast<i16>(255));
    print(~cast<u8>(0));
    print(cast<u64>(0 - 1) / cast<u64>(3));
    print(cast<u32>(0 - 1) % cast<u32>(10));
    print(cast<i64>(0 - 7) / 2);
    print(cast<i64>(0 - 7) % 2);
    return;
}

// run
// features: arithmetic wrap shift bitwise cast i8 u8
// output:
// 0
// -128
// 127
// 0
// 32767
// 4294967294
// -2147483648
// -9223372036854775808
// 128
// 144
// -1
// 1
// -1
// 0
// 255
// 255
// 6148914691236517205
// 5
// -3
// -1
