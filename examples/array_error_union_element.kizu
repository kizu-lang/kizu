fn ok(value: i64) -> !i64 {
    return value;
}

fn bad() -> !i64 {
    return error("nope");
}

fn count(results: std::array::Array<!i64>) -> i64 {
    return results.len();
}

fn main() -> !void {
    var results = std::array::Array<!i64>(std::mem::page_allocator());
    try results.append(ok(7));
    try results.append(bad());
    print(count(results));
    return;
}
