// Reading a body std::http did not hold.
//
// `accept` reads the whole body into the exchange, up to the ceiling its
// caller named. That is the right shape for a form and the wrong one for an
// upload: the ceiling is there because the body is being held, and a 2 GB file
// should not be held at all.
//
// `accept_head` stops at the blank line. The body stays on the connection and
// `read_into` hands it over a piece at a time, so no ceiling applies --
// nothing is holding the body for one to bound.
//
// `read_into` rather than the socket, because reading a head reads whole
// packets: the first bytes of the body are usually already in hand, and a
// read that went straight to the socket would skip past them.
//
// The second half sends the same body chunked -- `Transfer-Encoding: chunked`,
// no Content-Length -- which is what a client that does not know the length in
// advance sends. `read_into` decodes it, so the loop above it is the same
// loop. What the caller counts is the body, not the sizes and CRLFs that
// carried it.

import std::array;
import std::fmt;
import std::http;
import std::io;
import std::mem;
import std::net;
import std::string;

error Failure = http::Error or net::Error or mem::Error or array::Error;

fn main() -> Failure!void {
    let handle = io::blocking();
    let allocator = mem::page_allocator();

    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();

    var client = try open_client(handle, allocator, port);
    defer client.deinit();
    var body = string::new(allocator);
    defer body.deinit(allocator);
    var written = 0;
    while written < 500 {
        try body.append_bytes(allocator, "0123456789");
        written = written + 1;
    }
    let body_bytes = body.as_bytes();
    try request(handle, allocator, &var client, "POST /upload HTTP/1.1", body_bytes);

    try weigh(handle, allocator, &var server);
    try show(handle, allocator, &var client);

    // The same body again, chunked. Nothing above the decoder changes.
    var chunked_client = try open_client(handle, allocator, port);
    defer chunked_client.deinit();
    try chunked_request(handle, allocator, &var chunked_client, body_bytes);
    try weigh(handle, allocator, &var server);
    try show(handle, allocator, &var chunked_client);
    return;
}

// chunked_request sends the body in pieces with their sizes in front, the way
// a client that does not know the length in advance has to.
fn chunked_request(
    handle: Io,
    allocator: Allocator,
    client: &var net::TcpStream,
    body: []u8
) -> Failure!void {
    var wire = string::new(allocator);
    defer wire.deinit(allocator);
    try wire.append_bytes(allocator, "POST /upload HTTP/1.1");
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "Host: 127.0.0.1");
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "Transfer-Encoding: chunked");
    try crlf(allocator, &var wire);
    try crlf(allocator, &var wire);
    let length = mem::len(body);
    var at = 0;
    while at < length {
        var end = at + 1500;
        if end > length {
            end = length;
        }
        try http::append_hex(allocator, &var wire, end - at);
        try crlf(allocator, &var wire);
        try wire.append_bytes(allocator, body[at..end]);
        try crlf(allocator, &var wire);
        at = end;
    }
    // The zero chunk, and the blank line that ends the trailers there are none
    // of.
    try wire.append_bytes(allocator, "0");
    try crlf(allocator, &var wire);
    try crlf(allocator, &var wire);
    let bytes = wire.as_bytes();
    try client.write_all(handle, bytes);
    return;
}

// weigh counts the upload without keeping it. A real one would write each
// piece to a file; the shape is the same -- the loop is the caller's, and the
// body never exists whole in memory.
fn weigh(handle: Io, allocator: Allocator, server: &var http::Server) -> Failure!void {
    var held = try server.accept_head(handle, allocator);
    defer held.deinit(allocator);

    // Read until the body ends. Zero is the end whichever framing carried it:
    // the declared length running out, or the terminator chunk arriving. That
    // is why this loop does not have to know which one it was.
    var seen = 0;
    var piece = string::new(allocator);
    defer piece.deinit(allocator);
    var got = try held.read_into(handle, allocator, &var piece, 4096);
    while got > 0 {
        seen = seen + got;
        // The buffer is reused, so what is held at once is one piece and not
        // the upload.
        piece.clear();
        got = try held.read_into(handle, allocator, &var piece, 4096);
    }

    var reply = string::new(allocator);
    defer reply.deinit(allocator);
    try reply.append_bytes(allocator, "counted ");
    try fmt::append_i64(allocator, &var reply, seen);
    let text = reply.as_bytes();
    try held.respond_text(handle, allocator, 200, "text/plain", text);
    return;
}

fn open_client(handle: Io, allocator: Allocator, port: i64) -> Failure!net::TcpStream {
    var address = string::new(allocator);
    defer address.deinit(allocator);
    try address.append_bytes(allocator, "127.0.0.1:");
    try fmt::append_i64(allocator, &var address, port);
    let bytes = address.as_bytes();
    let stream = try net::tcp_connect(handle, bytes);
    return move stream;
}

fn request(
    handle: Io,
    allocator: Allocator,
    client: &var net::TcpStream,
    line: []u8,
    body: []u8
) -> Failure!void {
    var wire = string::new(allocator);
    defer wire.deinit(allocator);
    try wire.append_bytes(allocator, line);
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "Host: 127.0.0.1");
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "Content-Length: ");
    try fmt::append_i64(allocator, &var wire, mem::len(body));
    try crlf(allocator, &var wire);
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, body);
    let bytes = wire.as_bytes();
    try client.write_all(handle, bytes);
    return;
}

fn show(handle: Io, allocator: Allocator, client: &var net::TcpStream) -> Failure!void {
    var reply = string::new(allocator);
    defer reply.deinit(allocator);
    var read = try client.read_into(handle, allocator, &var reply, 4096);
    while read > 0 {
        read = try client.read_into(handle, allocator, &var reply, 4096);
    }
    let wire = reply.as_bytes();
    print_lines(wire);
    return;
}

fn print_lines(wire: []u8) -> void {
    let length = mem::len(wire);
    var start = 0;
    var index = 0;
    while index < length {
        if wire[index] == cast<u8>(10) {
            var end = index;
            if end > start and wire[end - 1] == cast<u8>(13) {
                end = end - 1;
            }
            print(wire[start..end]);
            start = index + 1;
        }
        index = index + 1;
    }
    if start < length {
        print(wire[start..length]);
    }
    return;
}

fn crlf(allocator: Allocator, out: &var string::String) -> mem::Error!void {
    try out.append_byte(allocator, cast<u8>(13));
    try out.append_byte(allocator, cast<u8>(10));
    return;
}

// run
// features: net http io error-union
// output:
// HTTP/1.1 200 OK
// Content-Type: text/plain
// Content-Length: 12
// Connection: close
//
// counted 5000
// HTTP/1.1 200 OK
// Content-Type: text/plain
// Content-Length: 12
// Connection: close
//
// counted 5000
