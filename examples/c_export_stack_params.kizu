// An `export "c" fn` may take more parameters than the target has argument
// registers, scalars and floats alike. C passes the rest on the stack, laid
// out by the target's C calling convention, and the function finds them
// there. A call by name from Kizu and a call through an `extern "c" fn`
// pointer give it the same values.
export "c" fn checksum(a: i64, b: i32, c: u8, d: bool, e: i16, f: u16, g: i8, h: u32, i: u8, j: i32, k: bool, l: i16) -> i64 {
    var sum = a;
    sum = sum * 3 + cast<i64>(b);
    sum = sum * 3 + cast<i64>(c);
    if d {
        sum = sum * 3 + 1;
    } else {
        sum = sum * 3;
    }
    sum = sum * 3 + cast<i64>(e);
    sum = sum * 3 + cast<i64>(f);
    sum = sum * 3 + cast<i64>(g);
    sum = sum * 3 + cast<i64>(h);
    sum = sum * 3 + cast<i64>(i);
    sum = sum * 3 + cast<i64>(j);
    if k {
        sum = sum * 3 + 1;
    } else {
        sum = sum * 3;
    }
    sum = sum * 3 + cast<i64>(l);
    return sum;
}

export "c" fn weigh(a: f64, b: f32, c: i8, d: f64, e: f32, f: u16, g: f64, h: f32, i: f64, j: f32, k: bool, l: f64, m: f32, n: i32) -> f64 {
    var sum = a + cast<f64>(b) * 2.0 + cast<f64>(c) * 3.0 + d * 4.0 + cast<f64>(e) * 5.0 + cast<f64>(f) * 6.0;
    sum = sum + g * 7.0 + cast<f64>(h) * 8.0 + i * 9.0 + cast<f64>(j) * 10.0 + l * 12.0 + cast<f64>(m) * 13.0;
    sum = sum + cast<f64>(n) * 14.0;
    if k {
        sum = sum + 11.0;
    }
    return sum;
}

pub fn main() -> void {
    print(checksum(-7, -5, 200, true, -300, 60000, -7, 4000000000, 255, -123456, true, -2));
    let through: extern "c" fn(i64, i32, u8, bool, i16, u16, i8, u32, u8, i32, bool, i16) -> i64 = checksum;
    // SAFETY: through is checksum, which reads only its scalars.
    print(unsafe through(77, 2147483647, 1, false, 32767, 1, -128, 1, 128, -2147483648, false, -32768));
    let half = cast<f32>(0.5);
    print(weigh(1.5, half, -3, 2.25, cast<f32>(-1.5), 60000, 0.125, half, -4.0, cast<f32>(8.0), true, 3.5, cast<f32>(0.25), -100000));
    let weighed: extern "c" fn(f64, f32, i8, f64, f32, u16, f64, f32, f64, f32, bool, f64, f32, i32) -> f64 = weigh;
    // SAFETY: weighed is weigh, which reads only its scalars and floats.
    print(unsafe weighed(-0.5, cast<f32>(2.0), 127, 1.0, half, 1, 16.0, cast<f32>(-0.25), 0.75, half, false, -2.0, cast<f32>(4.0), 7));
    return;
}

// run
// features: extern-c function-pointer unsafe
// output:
// 324044385868
// 126787519780696
// -1039899.875
// 644.75
