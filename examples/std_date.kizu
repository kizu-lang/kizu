import std::date;
import std::mem;
import std::string;
import std::time;

fn print_day(allocator: Allocator, day: date::Date) -> !void {
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try day.append_iso(allocator, &var out);
    let text = out.as_bytes();
    print(text);
    return;
}

fn print_moment(allocator: Allocator, moment: date::DateTime) -> !void {
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try moment.append_iso(allocator, &var out);
    let text = out.as_bytes();
    print(text);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let issued = try date::ymd(2024, 1, 31);
    let due = issued.add_months(1, date::Overflow::Clamp);
    try print_day(allocator, due);
    let weekday = due.weekday();
    print(weekday.iso_number());
    print(due.days_since(issued));
    let carried = issued.add_months(1, date::Overflow::Carry);
    try print_day(allocator, carried);
    let renewal = issued.add_years(1, date::Overflow::Clamp);
    try print_day(allocator, renewal);
    let stamped = try date::parse_datetime("2024-02-29T09:30:00+09:00");
    try print_moment(allocator, stamped);
    let moment = stamped.to_unix();
    print(moment.as_millis());
    let paid = date::from_unix(moment.add(time::days(3)));
    try print_moment(allocator, paid);
    let paid_day = paid.date();
    print(paid_day.after(due));
    print(paid_day.days_since(due));
    return;
}

// run
// features: std-date date-time weekday iso-8601
// output:
// 2024-02-29
// 4
// 29
// 2024-03-02
// 2025-01-31
// 2024-02-29T00:30:00Z
// 1709166600000
// 2024-03-03T00:30:00Z
// true
// 3
