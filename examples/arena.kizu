import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let alice = users.add(User { name: "alice" });
    print(users.at(alice).name);
    users.deinit();
}

// run
// features: arena handle
// output:
// alice
