fn main() -> !void {
    let io = std::io::blocking();
    var entries = try std::fs::read_dir(io, "selfhost/src");
    try std::testing::expect_equal_bool(true, entries.len() >= 16);
    let first = try entries.get(0);
    try std::testing::expect_equal_bytes("ast.kizu", first.name);
    try std::testing::expect_equal_bytes("selfhost/src/ast.kizu", first.path);
    try std::testing::expect_equal_bool(false, first.is_dir);
    entries.deinit();
    return;
}
