fn main() -> !void {
    let io = std::io::blocking();
    var entries = try std::fs::read_dir(io, "selfhost/src");
    std::testing::expect(entries.len() >= 16);
    let first = try entries.get(0);
    std::testing::expect(std::mem::equal_bytes("ast.kizu", first.name));
    std::testing::expect(std::mem::equal_bytes("selfhost/src/ast.kizu", first.path));
    std::testing::expect(!first.is_dir);
    entries.deinit();
    return;
}
