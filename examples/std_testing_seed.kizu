import std::rand;
import std::testing;

// A randomized test draws from testing::seed(): `kizu test --seed N` fixes
// it, and a run without the flag reports the seed it chose when it fails, so
// any failure replays. Two generators built from one seed walk one sequence.
test "the seed names one sequence" {
    let seed = testing::seed();
    testing::expect_equal<i64>(seed, testing::seed());
    var left = rand::new(seed);
    var right = rand::new(seed);
    var step = 0;
    while step < 16 {
        testing::expect_equal<i64>(left.below(1000), right.below(1000));
        step = step + 1;
    }
}

// test
// features: std-testing std-rand seed deterministic
// output:
// test: ok
