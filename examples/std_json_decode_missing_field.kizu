import std::json;
import std::mem;
import std::string;

pub struct Visitor {
    pub name: string::String,
    pub nick: ?i64,
}

fn (self: Visitor) deinit() -> void {
    self.name.deinit();
    return;
}

// An optional field is the one field a document may leave out. Every other
// field is still required, so omitting `name` is an error rather than a value
// the walk invents.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let document =
        \\{"nick": 7}
    ;
    var visitor = try json::decode<Visitor>(allocator, document);
    defer visitor.deinit();
    return;
}

// run-fails
// features: std-json decode optional diagnostics
// error: runtime error: std::json::Error::MissingField
