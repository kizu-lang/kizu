import std::array;
import std::mem;

struct Registry {
    users: array::Array<i64>,
}

// A capture reaches one direct container field of an owner: the borrow lands
// on that field, so a `&var self` method can hold update logic the call
// sites just invoke.
fn (self: &var Registry) bump(id: i64) -> void {
    if self.users.at_mut(id) |v| {
        v.* = v.* + 1;
    }
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var reg = Registry { users: array::new<i64>(allocator) };
    defer reg.deinit(allocator);
    try reg.users.append(7);
    reg.bump(0);
    reg.bump(0);
    print(reg.users.get_or_panic(0));
    return;
}

// run
// features: std-array borrow optional mutable-borrow
// output:
// 9
