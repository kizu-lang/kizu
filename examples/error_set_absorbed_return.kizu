error FsError {
    NotFound,
}

fn inner() -> FsError!i64 {
    return FsError::NotFound;
}

fn outer() -> !i64 {
    return inner();
}

fn main() -> !void {
    print(try outer());
    return;
}

// run-fails
// features: error-set error-union absorption
// error: runtime error: FsError::NotFound
