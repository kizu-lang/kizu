struct User {
    pub name: []u8,
    pub age: i64,
}

// The result type is written as a form because neither name is bound where the
// declaration is written. Each instantiation binds both, so the two calls below
// return different types from this one body. The struct is borrowed: a generic
// call moves an owner argument exactly as a direct call would.
fn pick<T, f: Field>(value: &T) -> std::meta::field_type<T, f> {
    return std::meta::field<T, f>(value);
}

fn main() -> void {
    let user = User { name: "alice", age: 30 };
    print(pick<User, name>(&user));
    print(pick<User, age>(&user));
}

// run
// features: comptime static-params field-static-param reflection struct
// output:
// alice
// 30
