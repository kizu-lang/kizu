// One thread, three connections, waiting on all of them at once.
//
// A blocking read waits on one descriptor. That is why the HTTP server in
// examples/http_server.kizu serves one connection at a time: while it is
// waiting on one, it cannot hear the others. A poller waits on many and
// answers with which of them spoke.
//
// The loop below serves whoever spoke, not whoever connected first. The three
// clients here speak in the reverse of the order they connected, and the
// answers come back in speaking order -- which is the whole difference.
//
// There is no `evented` Io that makes an ordinary read do this behind the
// caller's back. That would be a suspension inside `read_into`, which needs
// coroutines, which needs function coloring, which SPEC §15 does not have.
// Waiting on many things is written, not switched on.
//
// The connections live in an Array, and the token a descriptor is registered
// with is its index there. That is the whole of "find the state this event
// belongs to" -- no map, no lookup, because the caller chose the token.

import std::array;
import std::fmt;
import std::io;
import std::mem;
import std::net;
import std::string;

error Failure = net::Error or mem::Error;

fn main() -> Failure!void {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var listener = try net::tcp_listen(handle, "127.0.0.1:0");
    defer listener.deinit();
    let port = try listener.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);

    // Both ends live here, because Kizu has no concurrency: the callers are
    // this process too. A real server would have only the right-hand side.
    var callers = array::new<net::TcpStream>(allocator);
    defer callers.deinit(allocator);
    var served = array::new<net::TcpStream>(allocator);
    defer served.deinit(allocator);

    // One poller, one thread, every connection at once.
    var poller = try net::poller_new(handle, 16);
    defer poller.deinit();

    var opened = 0;
    while opened < 3 {
        let caller = try connect_to(handle, &address);
        try callers.append(allocator, move caller);
        let accepted = try listener.accept(handle);
        try served.append(allocator, move accepted);
        // The token is the index. Finding the state an event belongs to is
        // then an index, because the caller is the one who chose the token.
        try watch_at(handle, &var poller, &served, opened);
        opened = opened + 1;
    }

    // Nothing has spoken, so the wait ends on its deadline with nothing ready.
    let quiet = try poller.wait(handle, net::deadline_in_millis(50));
    print("ready with nobody speaking");
    print(quiet);

    // They speak in the reverse of the order they connected, and the loop
    // follows the speaking.
    try speak(handle, &var callers, 2, "third");
    try serve_ready(handle, allocator, &var poller, &var served);
    try speak(handle, &var callers, 0, "first");
    try serve_ready(handle, allocator, &var poller, &var served);
    try speak(handle, &var callers, 1, "second");
    try serve_ready(handle, allocator, &var poller, &var served);
    return;
}

// serve_ready waits until something is ready and answers whoever it was. This
// is the loop an evented server runs: one thread, every connection, work
// driven by what arrived rather than by what was accepted first.
fn serve_ready(
    handle: Io,
    allocator: Allocator,
    poller: &var net::Poller,
    served: &var array::Array<net::TcpStream>
) -> Failure!void {
    let count = try poller.wait(handle, net::deadline_in_millis(1000));
    var index = 0;
    while index < count {
        if poller.ready(index) |event| {
            if event.readable {
                try drain_at(handle, allocator, served, event.token);
            }
        }
        index = index + 1;
    }
    return;
}

// drain_at reads what is there. The poller said this descriptor is readable,
// so the read does not wait -- which is the point: the thread is never parked
// on a connection that has nothing to say.
fn drain_at(
    handle: Io,
    allocator: Allocator,
    served: &var array::Array<net::TcpStream>,
    token: i64
) -> Failure!void {
    var said = string::new(allocator);
    defer said.deinit(allocator);
    if served.at_mut(token) |stream| {
        let count = try stream.read_into(handle, allocator, &var said, 64);
        print(token);
        print(count);
    } else {
        print("no connection for that token");
        return;
    }
    let bytes = said.as_bytes();
    print(bytes);
    return;
}

fn watch_at(
    handle: Io,
    poller: &var net::Poller,
    served: &array::Array<net::TcpStream>,
    index: i64
) -> Failure!void {
    if served.at(index) |stream| {
        try poller.watch_stream(handle, stream, index, net::Interest::Read);
    }
    return;
}

fn speak(
    handle: Io,
    callers: &var array::Array<net::TcpStream>,
    index: i64,
    text: []u8
) -> Failure!void {
    if callers.at_mut(index) |caller| {
        try caller.write_all(handle, text);
    }
    return;
}

// connect_to binds the address bytes in its own frame, so the view does not
// outlive the loop that used it.
fn connect_to(handle: Io, address: &string::String) -> Failure!net::TcpStream {
    let bytes = address.as_bytes();
    let stream = try net::tcp_connect(handle, bytes);
    return move stream;
}

fn loopback(allocator: Allocator, port: i64) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, "127.0.0.1:");
    try fmt::append_i64(allocator, &var out, port);
    return move out;
}

// run
// features: net io error-union
// output:
// ready with nobody speaking
// 0
// 2
// 5
// third
// 0
// 5
// first
// 1
// 6
// second
