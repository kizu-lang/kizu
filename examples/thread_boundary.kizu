fn worker(value: i64) -> i64 {
    return value + 1;
}

fn main() -> void {
    let io = std::io::blocking();
    let result = std::thread::scoped<i64, worker>(io, 41);
    let atomic = std::atomic::Atomic<i64>(0);
    let locked = std::sync::Mutex<i64>(3);
    atomic.store(7);
    print(result);
    print(atomic.load());
    print(locked.get());
}
