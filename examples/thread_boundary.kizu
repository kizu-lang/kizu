fn worker(value: i64) -> i64 {
    return value + 1;
}

fn main() -> void {
    let io = Io();
    let result = std::thread::scoped(io, worker, 41);
    let atomic = std::atomic::AtomicI64(0);
    let locked = std::sync::Mutex<i64>(3);
    atomic.store(7);
    print(result);
    print(atomic.load());
    print(locked.get());
}
