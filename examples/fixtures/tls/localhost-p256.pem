# localhost over a P-256 key, ECDSA-SHA256.
#
# Made once with LibreSSL 3.3.6's openssl, self-signed, a CA, subjectAltName
# DNS:localhost, valid from 2026-01-01T00:00:00Z to 9999-12-31T23:59:59Z so
# that a client reading the real clock never sees it expire. The fixtures
# next to it (*.trace) were recorded against it; replacing it means
# recording them again (nix develop -c just tls-fixtures).
#
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -pkeyopt ec_param_enc:named_curve -out localhost-p256.key.pem
#   openssl req -new -key localhost-p256.key.pem -subj /CN=localhost -out localhost-p256.csr
#   : > index.txt; echo 01 > serial
#   openssl ca -batch -config ca.cnf -selfsign -keyfile localhost-p256.key.pem \
#     -in localhost-p256.csr -md sha256 -startdate 260101000000Z -enddate 99991231235959Z \
#     -notext -out localhost-p256.pem
#
# with ca.cnf:
#
#   [ca]
#   default_ca = fixture
#   [fixture]
#   database = index.txt
#   new_certs_dir = .
#   serial = serial
#   policy = any
#   x509_extensions = leaf
#   unique_subject = no
#   [any]
#   commonName = supplied
#   [leaf]
#   basicConstraints = critical,CA:TRUE
#   subjectAltName = DNS:localhost
#
