import std::mem;

error ParseError { Empty, Negative }

fn check(value: i64) -> ParseError!void {
    if value < 0 {
        return ParseError::Negative;
    }
    return;
}

// A generic that takes a function which can fail hands that failure back in
// the function's own set: E is a static argument that names an error set, so
// `run_all<ParseError>` returns `ParseError!void` and the caller can `catch`
// it or `try` it into any set that holds ParseError.
fn run_all<E>(f: fn(i64) -> E!void, values: []i64) -> E!void {
    for 0..mem::count<i64>(values) |i| {
        try f(values[i]);
    }
    return;
}

fn first_problem(values: []i64) -> i64 {
    run_all<ParseError>(check, values) catch return 1;
    return 0;
}

fn main() -> ParseError!void {
    var good = [3]i64{};
    let good_cells = good.as_mut_slice();
    good_cells[0] = 1;
    let good_view = good.as_slice();
    print(first_problem(good_view));
    var bad = [3]i64{};
    let bad_cells = bad.as_mut_slice();
    bad_cells[1] = -4;
    let bad_view = bad.as_slice();
    print(first_problem(bad_view));
    try run_all<ParseError>(check, good_view);
    print(2);
    return;
}

// run
// features: generics error-set error-union
// output:
// 0
// 1
// 2
