import std;

fn main() -> !void {
    let io = std::io::blocking();
    let allocator = std::mem::page_allocator();
    let text = try std::fs::read_file(
        io, allocator, "examples/fixtures/config.txt", std::mem::Limit::Unlimited);
    defer text.deinit(allocator);
    let view = text.as_bytes();
    print(view);
    return;
}

// run
// features: io fs error-union
// dir: .
// output:
// kizu fs fixture
//
