import std::mem;
import std::string;

// A generic function that consumes its argument is called like any other
// consuming function: the caller writes `move`, and the value is gone after.
fn release<T>(allocator: Allocator, value: T) -> void {
    value.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, "abc");
    release<string::String>(allocator, move text);
    print("released");
    return;
}

// run
// features: generic ownership move
// output:
// released
