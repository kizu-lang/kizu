import std::arena;
import std::mem;

struct Users {}

struct User {
    name: []u8,
}

// An add is the call that buys storage, so it is the call that hears a
// refusal. A fixed buffer runs out as a matter of course, which is why that
// answer comes back as a value the caller decides about rather than stopping
// the program (ADR-0131).
fn fill(allocator: Allocator, users: &var arena::Arena<User, Users>) -> mem::Error!i64 {
    var count = 0;
    while count < 100 {
        let _ = try users.add(allocator, User { name: "alice" });
        count = count + 1;
    }
    return count;
}

fn main() {
    var raw = [64]u8{};
    let bytes = raw.as_mut_bytes();
    let allocator = mem::fixed_buffer(bytes);
    var users = arena::new<User, Users>(allocator);
    defer users.deinit(allocator);
    let stored = fill(allocator, &var users) catch -1;
    print(stored);
    print("the buffer ran out, and the program chose what to do");
}

// run
// features: arena allocator fixed-buffer error-union
// output:
// -1
// the buffer ran out, and the program chose what to do
