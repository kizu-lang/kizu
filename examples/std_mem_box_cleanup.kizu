import std::mem;

pub struct Score {
    pub value: i64
}

pub struct Noisy {
    pub value: i64
}

fn (self: Noisy) deinit(allocator: Allocator) -> void {
    print(self.value);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var score = try mem::box<Score>(allocator, Score { value: 1 });
    let writable = score.borrow_mut();
    writable.value = writable.value + 41;
    let seen = score.borrow();
    print(seen.value);
    score.deinit(allocator);
    let noisy = try mem::box<Noisy>(allocator, Noisy { value: 7 });
    noisy.deinit(allocator);
    return;
}

// run
// features: std-mem box borrow mutable-borrow deinit cleanup allocator
// output:
// 42
// 7
