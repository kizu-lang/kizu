fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    std::testing::expect_equal<i64>(0, text.len());
    try text.reserve(16);
    // The growth strategy is implementation-defined; reserve only promises
    // room for the request.
    std::testing::expect(text.capacity() >= 16);
    let reserved = text.capacity();

    try text.append_bytes("lexer");
    try text.append_byte(cast<u8>(32));
    try text.append_bytes("token");

    let full = text.as_bytes();
    print(full);

    try text.truncate(5);
    let prefix = text.as_bytes();
    print(prefix);

    text.clear();
    std::testing::expect_equal<i64>(0, text.len());
    // `clear` keeps the storage it already holds.
    std::testing::expect_equal<i64>(reserved, text.capacity());

    text.deinit();
    return;
}
