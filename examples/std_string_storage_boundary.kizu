fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try std::testing::expect_equal_i64(0, text.len());
    try text.reserve(16);
    try std::testing::expect_equal_i64(16, text.capacity());

    try text.append_bytes("lexer");
    try text.append_byte(cast<u8>(32));
    try text.append_bytes("token");

    let full = text.as_bytes();
    print(full);

    try text.truncate(5);
    let prefix = text.as_bytes();
    print(prefix);

    text.clear();
    try std::testing::expect_equal_i64(0, text.len());
    try std::testing::expect_equal_i64(16, text.capacity());

    text.deinit();
    return void;
}
