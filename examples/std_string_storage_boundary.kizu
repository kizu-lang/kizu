fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    std::testing::expect(0 == text.len());
    try text.reserve(16);
    std::testing::expect(16 == text.capacity());

    try text.append_bytes("lexer");
    try text.append_byte(cast<u8>(32));
    try text.append_bytes("token");

    let full = text.as_bytes();
    print(full);

    try text.truncate(5);
    let prefix = text.as_bytes();
    print(prefix);

    text.clear();
    std::testing::expect(0 == text.len());
    std::testing::expect(16 == text.capacity());

    text.deinit();
    return;
}
