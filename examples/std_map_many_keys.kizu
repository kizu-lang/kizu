fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let table = std::map::Map<[]u8, i64>(allocator);
    let key = std::string::String(allocator);

    var i = 0;
    while i < 512 {
        key.clear();
        try key.append_byte(cast<u8>(97 + i % 26));
        try key.append_byte(cast<u8>(97 + (i / 26) % 26));
        let bytes = key.as_bytes();
        try table.insert(bytes, i);
        i = i + 1;
    }
    std::testing::expect_equal<i64>(512, table.len());

    var total = 0;
    var j = 0;
    while j < 512 {
        key.clear();
        try key.append_byte(cast<u8>(97 + j % 26));
        try key.append_byte(cast<u8>(97 + (j / 26) % 26));
        let bytes = key.as_bytes();
        let value = try table.get(bytes);
        total = total + value;
        j = j + 1;
    }
    std::testing::expect_equal<i64>(130816, total);

    try table.insert("aa", 1000);
    std::testing::expect_equal<i64>(512, table.len());
    std::testing::expect_equal<i64>(1000, try table.get("aa"));
    std::testing::expect(!table.contains("zz"));

    key.deinit();
    table.deinit();
    return;
}
