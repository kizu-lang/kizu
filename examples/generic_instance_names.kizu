// A generic's instance and a plain function may share every character but the
// separator between the generic's name and its argument: `same<i64>` and
// `same_i64` are two functions, and every backend keeps them apart.
fn same<T>(value: T) -> T {
    return value;
}

fn same_i64(value: i64) -> i64 {
    return value + 1;
}

fn main() -> void {
    print(same<i64>(7));
    print(same_i64(7));
    return;
}

// run
// features: generics
// output:
// 7
// 8
