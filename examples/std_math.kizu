import std::float;
import std::math;
import std::mem;
import std::string;

fn show(allocator: Allocator, value: f64) -> !void {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try float::append(allocator, &var text, value);
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    try show(allocator, math::sqrt<f64>(2.0));
    try show(allocator, math::floor<f64>(-2.5));
    try show(allocator, math::ceil<f64>(-2.5));
    try show(allocator, math::trunc<f64>(-2.5));
    try show(allocator, math::round<f64>(-2.5));
    try show(allocator, math::round<f64>(0.49999999999999994));
    try show(allocator, math::abs<f64>(-3.25));
    try show(allocator, math::copysign<f64>(3.25, -0.0));
    try show(allocator, math::min<f64>(math::nan<f64>(), 1.5));
    try show(allocator, math::max<f64>(-0.0, 0.0));
    try show(allocator, math::clamp<f64>(7.0, -1.0, 1.0));
    try show(allocator, math::hypot<f64>(3.0, 4.0));
    try show(allocator, math::hypot<f64>(3.0e-200, 4.0e-200));
    try show(allocator, math::pi<f64>());
    try show(allocator, math::exp<f64>(1.0));
    try show(allocator, math::expm1<f64>(1.0e-10));
    try show(allocator, math::log<f64>(10.0));
    try show(allocator, math::log2<f64>(1024.0));
    try show(allocator, math::log10<f64>(1000.0));
    try show(allocator, math::pow<f64>(2.0, 0.5));
    try show(allocator, math::pow<f64>(-8.0, 3.0));
    try show(allocator, math::fmod<f64>(-5.5, 2.0));
    try show(allocator, math::ldexp<f64>(1.0, -1074));
    try show(allocator, math::sin<f64>(1.0));
    try show(allocator, math::cos<f64>(0.0));
    try show(allocator, math::sin_cos<f64>(1.0).cos);
    try show(allocator, math::tan<f64>(math::pi<f64>() / 4.0));
    try show(allocator, math::sin<f64>(1.0e22));
    try show(allocator, math::asin<f64>(1.0));
    try show(allocator, math::atan2<f64>(1.0, -1.0));
    try show(allocator, math::sinh<f64>(1.0));
    try show(allocator, math::tanh<f64>(0.5));
    try show(allocator, math::acosh<f64>(2.0));
    try show(allocator, math::cbrt<f64>(-8.0));
    try show(allocator, math::round_even<f64>(2.5));
    try show(allocator, math::fma<f64>(0.1, 10.0, -1.0));
    try show(allocator, 0.1 * 10.0 - 1.0);
    try show(allocator, math::modf<f64>(-2.5).fraction);
    print(math::frexp<f64>(8.0).exponent);
    let single: f32 = 2.0;
    print(math::sqrt<f32>(single));
    print(math::pi<f32>());
    print(math::round<f32>(single + 0.5));
    print(math::is_negative<f64>(-0.0));
    print(float::is_nan(math::sqrt<f64>(-1.0)));
    return;
}

