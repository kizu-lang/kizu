import std::float;
import std::math;
import std::mem;
import std::string;

fn show(allocator: Allocator, value: f64) -> !void {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    try float::append(allocator, &var text, value);
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    try show(allocator, math::sqrt(2.0));
    try show(allocator, math::floor(-2.5));
    try show(allocator, math::ceil(-2.5));
    try show(allocator, math::trunc(-2.5));
    try show(allocator, math::round(-2.5));
    try show(allocator, math::round(0.49999999999999994));
    try show(allocator, math::abs(-3.25));
    try show(allocator, math::copysign(3.25, -0.0));
    try show(allocator, math::min(math::nan(), 1.5));
    try show(allocator, math::max(-0.0, 0.0));
    try show(allocator, math::clamp(7.0, -1.0, 1.0));
    try show(allocator, math::hypot(3.0, 4.0));
    try show(allocator, math::hypot(3.0e-200, 4.0e-200));
    try show(allocator, math::pi());
    try show(allocator, math::exp(1.0));
    try show(allocator, math::expm1(1.0e-10));
    try show(allocator, math::log(10.0));
    try show(allocator, math::log2(1024.0));
    try show(allocator, math::log10(1000.0));
    try show(allocator, math::pow(2.0, 0.5));
    try show(allocator, math::pow(-8.0, 3.0));
    try show(allocator, math::fmod(-5.5, 2.0));
    try show(allocator, math::ldexp(1.0, -1074));
    try show(allocator, math::sin(1.0));
    try show(allocator, math::cos(0.0));
    try show(allocator, math::tan(math::pi() / 4.0));
    try show(allocator, math::sin(1.0e22));
    try show(allocator, math::asin(1.0));
    try show(allocator, math::atan2(1.0, -1.0));
    print(math::is_negative(-0.0));
    print(float::is_nan(math::sqrt(-1.0)));
    return;
}

// run
// features: std-math sqrt floor ceil trunc round hypot exp log pow fmod trig
// output:
// 1.4142135623730951
// -3.0
// -2.0
// -2.0
// -3.0
// 0.0
// 3.25
// -3.25
// 1.5
// 0.0
// 1.0
// 5.0
// 5e-200
// 3.141592653589793
// 2.718281828459045
// 1.00000000005e-10
// 2.302585092994046
// 10.0
// 3.0
// 1.4142135623730951
// -512.0
// -1.5
// 5e-324
// 0.8414709848078965
// 1.0
// 1.0
// -0.8522008497671889
// 1.5707963267948966
// 2.356194490192345
// true
// true
