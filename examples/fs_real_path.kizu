import std;

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let resolved = try std::fs::real_path(
        io,
        allocator,
        "examples/fixtures/real_path/./alias/../alias/nested.txt"
    );
    defer resolved.deinit(allocator);
    let bytes = resolved.as_bytes();
    let parent = std::path::dirname(bytes);
    let parent_name = std::path::basename(parent);
    let name = std::path::basename(bytes);
    print(parent_name);
    print(name);
    print(try std::fs::exists(io, bytes));
    return;
}

// run
// features: std-fs std-path real-path explicit-io
// dir: .
// output:
// target
// nested.txt
// true
