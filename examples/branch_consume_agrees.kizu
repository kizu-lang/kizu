import std::array;
import std::fmt;
import std::mem;
import std::string;

// Both branches consume the string: one hands it to the array, the other
// releases it. What a branch may not do is skip the obligation, because the
// merged value can be neither released again nor handed on (§9).
fn place(allocator: Allocator, parent: &var array::Array<string::String>, keep: bool) -> !void {
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_byte(cast<u8>(97));
    if keep {
        try parent.append(move name);
    } else {
        name.deinit(allocator);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var parent = array::new<string::String>(allocator);
    defer parent.deinit(allocator);

    try place(allocator, &var parent, true);
    try place(allocator, &var parent, false);
    try place(allocator, &var parent, true);

    var text = string::new(allocator);
    defer text.deinit(allocator);
    try fmt::append_i64(text, parent.len());
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

// run
// features: ownership deinit branch std-array std-string std-fmt errdefer move
// output:
// 2
