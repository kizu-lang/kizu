import std::arena;
import std::mem;

struct User {
    name: []u8,
}

// `Registry` declares no `deinit`, so its obligation is the arena field's. That
// field can be consumed where the value is held, which is one way of finishing
// the whole: once every owner field is gone the value owes nothing. Calling
// `registry.deinit()` instead does the same thing in one step.
struct Registry {
    users: arena::Arena<User>,
}

fn main() -> void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let registry = Registry { users: move users };
    registry.users.deinit();
    print(1);
}

// run
// features: arena deinit ownership derived field-cleanup
// output:
// 1
