fn load(io: Io, path: []u8) -> ![]u8 {
    return std::fs::read_file(io, path);
}

fn main() -> !void {
    let io = std::io::threaded();
    let group = std::task::Group(io);
    let task = group.spawn(load, "examples/fixtures/config.txt");
    let text = try task.await();
    print(text);
    return;
}
