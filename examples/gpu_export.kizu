import std::float;
import std::gpu;

fn drop_low_bits(value: f32) -> f32 {
    let bits = float::bits_f32(value);
    return float::from_bits_f32(bits & 0xffff0000);
}

export "gpu" fn add_scaled(total: &var []f32, part: []f32, scale: f32) -> void {
    let index = gpu::thread_index();
    total[index] = drop_low_bits(total[index] + part[index] * scale);
    return;
}

// check
// features: gpu-export
