fn make_values(allocator: Allocator) -> !std::array::Array<i64> {
    let values = std::array::Array<i64>(allocator);
    errdefer values.deinit();

    try values.append(1);
    try values.append(2);
    return values;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let values = try make_values(allocator);
    defer values.deinit();

    std::testing::expect_equal<i64>(2, values.len());
    std::testing::expect_equal<i64>(1, values.get_or_panic(0));
    std::testing::expect_equal<i64>(2, values.get_or_panic(1));
    print("ok");
    return;
}

// run
// features: errdefer std-array deinit error-union try std-testing
// output:
// ok
