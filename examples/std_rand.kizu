import std::rand;

fn main() {
    var rng = rand::new(42);
    print(rng.next());
    print(rng.next());
    print(rng.below(100));
    print(rng.below(100));

    var again = rand::new(42);
    print(again.next() == 2350856279);

    var other = rand::new(7);
    print(other.below(100));
    return;
}

// run
// features: std-rand deterministic seed
// output:
// 2350856279
// 1787468189
// 6
// 98
// true
// 76
