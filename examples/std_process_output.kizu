import std;
import std::mem;
import std::string;

// spawn_output8 reads what a child writes to its standard output. The child
// is this program again, started with an argument that makes it print one
// line, so the example needs no other program on the machine.
fn main() -> !void {
    if std::process::arg_count() > 0 {
        print("hello from the child");
        return;
    }
    let allocator = mem::page_allocator();
    let program = try std::process::executable_path(allocator);
    defer program.deinit(allocator);
    var output = string::new(allocator);
    defer output.deinit(allocator);
    let path = program.as_bytes();
    let code = try std::process::spawn_output8(
        allocator,
        &var output,
        2,
        path,
        "child",
        "",
        "",
        "",
        "",
        "",
        ""
    );
    print(code);
    // The child's line ends the way its platform ends a line; print adds
    // its own end.
    let text = output.as_bytes();
    var end = mem::len(text);
    while end > 0 and (text[end - 1] == cast<u8>(10) or text[end - 1] == cast<u8>(13)) {
        end = end - 1;
    }
    print(text[0..end]);
    return;
}

// run
// features: std-process error-union try
// output:
// 0
// hello from the child
