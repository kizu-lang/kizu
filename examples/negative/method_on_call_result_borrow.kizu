struct Vec2 {
    x: i64,
    y: i64,
}

fn (self: &Vec2) sum() -> i64 {
    return self.x + self.y;
}

fn unit() -> Vec2 {
    return Vec2 { x: 1, y: 2 };
}

// A call result may receive a by-value method, but a `&self` method borrows
// a place, and a temporary has none to lend; bind it first.
fn main() -> void {
    print(unit().sum());
    return;
}

// check-fails
// features: method borrow call-result-receiver
// error: method receiver must be a local binding or a field path
