struct Bytes {
    text: []u8,
}

struct File {
    name: []u8,
}

contract Writer {
    fn write(self: &Self, bytes: &Bytes) -> !i64;
}

fn save(writer: &dyn Writer, bytes: &Bytes) -> !void {
    let n = try writer.write(bytes);
    print(n);
    return;
}

fn main() -> !void {
    let file = File { name: "out" };
    let bytes = Bytes { text: "hello" };
    try save(file, bytes);
    return;
}

// check-fails
// features: contract dyn
// error: File does not satisfy `Writer`
