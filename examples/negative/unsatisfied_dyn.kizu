struct Bytes {
    text: string
}

struct File {
    name: string
}

contract Writer {
    fn write(self: borrow Self, bytes: borrow Bytes) -> result<int>
}

fn save(writer: borrow Dyn<Writer>, bytes: borrow Bytes) -> result<void> {
    let n = try writer.write(bytes)
    print(n)
    return ok(void)
}

fn main() -> result<void> {
    let file = File { name: "out" }
    let bytes = Bytes { text: "hello" }
    try save(file, bytes)
    return ok(void)
}
