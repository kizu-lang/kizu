struct Bytes {
    text: []const u8;
}

struct File {
    name: []const u8;
}

contract Writer {
    fn write(self: &Self, bytes: &Bytes) -> !i64;
}

fn save(writer: &Dyn<Writer>, bytes: &Bytes) -> !void {
    let n = try writer.write(bytes);
    print(n);
    return void;
}

fn main() -> !void {
    let file = File { name: "out" };
    let bytes = Bytes { text: "hello" };
    try save(file, bytes);
    return void;
}
