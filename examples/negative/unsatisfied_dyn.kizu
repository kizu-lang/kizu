struct Bytes {
    text: string
}

struct File {
    name: string
}

contract Writer {
    fn write(self: borrow Self, bytes: borrow Bytes) -> !i64
}

fn save(writer: borrow Dyn<Writer>, bytes: borrow Bytes) -> !void {
    let n = try writer.write(bytes)
    print(n)
    return void
}

fn main() -> !void {
    let file = File { name: "out" }
    let bytes = Bytes { text: "hello" }
    try save(file, bytes)
    return void
}
