import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn take(user: User) {
    print(user.name);
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::Arena<User>(allocator);
    let alice = users.add(User { name: "alice" });
    take(users.get(alice));
}

// check-fails
// features: arena borrow
// error: arena.get returns a local borrow and cannot be moved
