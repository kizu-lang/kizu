import std::array;
import std::mem;

unsafe struct Holder {
    pointer: ptr<u8>,
}

fn main() {
    let allocator = mem::page_allocator();
    let holders = array::Array<Holder>(allocator);
    print(holders.len());
}

// check-fails
// features: std-array raw-pointer type-check
// error: Array element cannot be raw pointer
