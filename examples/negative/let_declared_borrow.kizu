fn main() -> void {
    var count = 0;
    // A borrow is what a `&` initializer lends; the binding's type is the
    // type of what is borrowed, so a borrow type is not one to declare.
    let view: &var i64 = &var count;
    view = view + 1;
    print(count);
    return;
}

// check-fails
// features: type-check borrow diagnostics
// error: type error: `view` cannot declare a borrow type; a borrow comes from a `&` initializer
