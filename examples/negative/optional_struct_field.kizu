import std::array;

// A `?Owner` field carries the same cleanup obligation a plain owner field
// does: on the path where the value is there, someone has to release it. So the
// struct owes a `deinit`, exactly as it would for a bare `Array<i64>` field.
struct Holder {
    pub items: ?array::Array<i64>,
}

fn main() -> !void {
    print(1);
    return;
}

// check-fails
// features: optional owner diagnostics
// error: struct `Holder` holds owner field `items` and must declare deinit
