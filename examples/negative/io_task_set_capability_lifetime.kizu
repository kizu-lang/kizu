import std::io;
import std::mem;

fn make_tasks(handle: Io, allocator: Allocator) -> io::Error!io::TaskSet {
    return io::task_set_new(handle, allocator);
}

fn main() -> !void {
    var loop = try io::loop_new();
    errdefer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();
    var tasks = try make_tasks(handle, allocator);
    defer tasks.deinit(allocator);
    loop.deinit();
    return;
}

// check-fails
// features: io evented task-set borrow
// error: value `loop` cannot be moved while borrowed
