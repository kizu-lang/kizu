import std::mem;
import std::string;

fn release<T>(allocator: Allocator, value: T) -> void {
    value.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, "abc");
    release<string::String>(allocator, move text);
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

// check-fails
// features: generic ownership move
// error: moved value `text` was used
