// `public_fields` lists the fields of a struct. A type that has none is not a
// struct with an empty list, it is the wrong argument, so asking is the error
// rather than expanding to nothing.
fn names<T>() -> void {
    comptime for std::meta::public_fields<T>() |f| {
        print(std::meta::field_name<T, f>());
    }
    return;
}

fn main() -> void {
    names<i64>();
}

// check-fails
// features: comptime comptime-for std-meta
// error: expects a struct
