import std::mem;
import std::string;

struct Holder {
    name: string::String,
}

// A by-value receiver is not a consuming transfer (SPEC §8): the caller keeps
// the value, so the body holds `self` the way a borrow is held and cannot
// hand it on. Accepting this makes two owners of one String.
fn (self: Holder) into() -> Holder {
    return move self;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let held = Holder { name: try string::from_bytes(allocator, "abc") };
    defer held.deinit(allocator);
    let taken = held.into();
    taken.deinit(allocator);
    return;
}

// check-fails
// features: ownership method borrow
// error: borrowed value `self` cannot escape
