import std::time;

// The monotonic clock and the wall clock do not agree with each other, so a
// span between a reading of each is not a number. The types say so.
fn main() {
    let started = time::instant(1000);
    let stamped = time::unix(1700000000000);
    print(stamped.since(started).as_millis());
    return;
}

// check-fails
// features: std-time instant unix-time type-error
// error: arg 1 of `std::time::UnixTime.since` expects std::time::UnixTime, got std::time::Instant
