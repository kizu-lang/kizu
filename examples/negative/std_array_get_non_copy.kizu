struct Box {
    text: []u8,
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let values = std::array::Array<Box>(allocator);

    try values.append(Box { text: "owned" });
    let item = try values.get(0);
    print(item.text);
    return;
}

