import std::thread;

struct ViewCtx {
    items: []f32,
}

fn work(ctx: &ViewCtx, chunk: &var []f32, index: i64) -> thread::Error!void {
    return;
}

// Dereferencing a `&var []f32` parameter into a shared context view borrows the
// parameter, so passing both to `each_shared` is rejected as aliasing.
fn run(pool: &var thread::Pool, out: &var []f32) -> thread::Error!void {
    let ctx = ViewCtx { items: out.* };
    try thread::each_shared<f32, ViewCtx, thread::Error>(pool, out, 4, &ctx, work);
    return;
}

fn main() -> void {
    return;
}

// check-fails
// features: thread ownership
// error: value `out` cannot be mutably borrowed while borrowed
