import std::array;
import std::mem;

fn main() -> !void {
    var one = [512]u8{};
    var two = [512]u8{};
    let one_view = one.as_mut_bytes();
    let two_view = two.as_mut_bytes();
    let first = mem::fixed_buffer(one_view);
    let second = mem::fixed_buffer(two_view);
    var values = array::new<i64>(first);
    defer values.deinit(first);
    try values.append(first, 1);
    values.clear(second);
    return;
}

// check-fails
// features: std-array clear allocator fixed-buffer
// error: `Array.clear` names allocator `second`, but `values` was built from another
