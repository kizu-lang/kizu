import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    let borrowed = &users;
    users.deinit(allocator);
    print(borrowed);
}

// check-fails
// features: arena borrow deinit
// error: cannot run while arena is borrowed
