struct User {
    name: []u8,
}

fn main() {
    let allocator = std::mem::page_allocator();
    let users = std::arena::Arena<User>(allocator);
    let borrowed = &users;
    users.deinit();
    print(borrowed);
}

// check-fails
// features: arena borrow deinit
// error: cannot run while arena is borrowed
