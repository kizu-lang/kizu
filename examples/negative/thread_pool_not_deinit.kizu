import std::io;
import std::mem;
import std::thread;

fn nothing(part: &var []i64, index: i64) -> thread::Error!void {
    return;
}

// A pool owns threads that wait between rounds. Leaving it without `deinit`
// would leave them waiting after the program stopped looking, so it is an
// owner like any other.
fn main() -> thread::Error!void {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 2);
    var cells = [4]i64{};
    let view = cells.as_mut_slice();
    try thread::each<i64, thread::Error>(&var pool, view, 1, nothing);
    return;
}

// check-fails
// features: thread ownership
// error: owned value `pool` would leak on this `try`'s error exit
