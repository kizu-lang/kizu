import std::array;
import std::mem;
import std::string;

// A view is a run of equal-sized number cells; owner elements would be
// reachable through it without their cleanup, so an Array of them has none.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var names = array::new<string::String>(allocator);
    defer names.deinit(allocator);
    let view = names.as_slice();
    print(mem::count<string::String>(view));
    return;
}

// check-fails
// features: std-array typed_view ownership
// error: has no `as_slice`
