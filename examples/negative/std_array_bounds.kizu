import std::array;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let values = array::new<i64>(allocator);
    defer values.deinit();

    try values.append(1);
    print(try values.get(1));
    return;
}

// run-fails
// features: std-array bounds error-union
// error: std::array::Error::OutOfBounds
