import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, " padded ");
    defer text.deinit();
    string::trim_space_in_place(&var text);
    return;
}

// check-fails
// features: std-string trim mutable-borrow
// error: &var argument `text` must be mutable
