import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    let p = unsafe cast<ptr<User>>(alice);
    print(unsafe ptr_read(p).name);
    return;
}

// check-fails
// features: handle raw-pointer
// error: cannot cast std::arena::Handle<User> to ptr<User>
