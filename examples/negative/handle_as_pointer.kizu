import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::Arena<User>(allocator);
    let alice = users.add(User { name: "alice" });
    let p = cast<ptr<User>>(alice);
    @unsafe(ptr_read) {
        print(ptr_read(p).name);
    }
}

// check-fails
// features: handle raw-pointer
// error: cannot cast std::arena::Handle<User> to ptr<User>
