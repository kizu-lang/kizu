import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);
    defer tokens.deinit(allocator);

    try tokens.append(allocator, Token { text: "let" });
    if tokens.at(0) |first| {
        tokens.deinit(allocator);
        print(first.text);
    }
    return;
}

// check-fails
// features: std-array borrow use-after-free
// error: cannot run while array is borrowed
