struct Token {
    text: []const u8,
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var tokens = std::array::Array<Token>(allocator);

    try tokens.append(Token { text: "let" });
    let first = try tokens.at(0);
    tokens.deinit();
    print(first.text);
    return;
}
