fn load(io: Io, name: string) -> result<int> {
    print(name)
    return ok(1)
}

fn main() -> result<void> {
    let io = Io()
    let group = TaskGroup()
    let name = "config"
    let task = group.spawn(io, load, name)
    print(name)
    let value = try task.await()
    print(value)
    return ok(void)
}
