struct Config {
    name: []const u8
}

fn load(io: Io, config: Config) -> !i64 {
    print(config.name)
    return 1
}

fn main() -> !void {
    let io = Io()
    let group = TaskGroup()
    let config = Config { name: "config" }
    let task = group.spawn(io, load, config)
    print(config.name)
    let value = try task.await()
    print(value)
    return void
}
