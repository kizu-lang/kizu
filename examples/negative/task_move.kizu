struct Config {
    name: []const u8,
}

fn load(io: Io, config: Config) -> !i64 {
    print(config.name);
    return 1;
}

fn main() -> !void {
    let io = std::io::blocking();
    let group = std::task::Group(io);
    let config = Config { name: "config" };
    let task = group.spawn(load, config);
    print(config.name);
    let value = try task.await();
    print(value);
    return;
}
