import std::array;
import std::mem;

fn replace(items: &var array::Array<i64>) -> void {
    items = array::new<i64>(mem::page_allocator());
}

fn main() -> void {
    let allocator = mem::page_allocator();
    var items = array::new<i64>(allocator);
    replace(items);
    items.deinit();
    return;
}

// check-fails
// features: borrow mutable-borrow ownership
// error: owned value `items` is overwritten before cleanup
