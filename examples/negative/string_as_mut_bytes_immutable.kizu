import std::mem;
import std::string;

fn make(allocator: Allocator) -> !string::String {
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_bytes("kizu");
    return name;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let name = try make(allocator);
    defer name.deinit(allocator);
    let view = name.as_mut_bytes();
    view[0] = 75;
    return;
}

// check-fails
// features: mutable-slice-view
// error: `String.as_mut_bytes` requires mutable String binding
