// `ptr_of` takes the address of a view. Storage is not a view: an Array or
// a String lends one with `as_slice` / `as_bytes`, and that is what to pass.
fn main() -> void {
    var buffer = [4]u8{};
    let p = ptr_of(buffer);
    // SAFETY: never reached; the program is rejected above.
    print(unsafe ptr_read(p));
    return;
}

// check-fails
// features: raw-pointer view diagnostic
// error: `ptr_of` expects a view `[]T`, got [4]u8
