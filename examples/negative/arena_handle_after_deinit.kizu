import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::Arena<User>(allocator);
    let alice = users.add(User { name: "alice" });
    users.deinit();
    print(alice);
}

// check-fails
// features: arena handle deinit
// error: handle `alice` cannot be used after arena `users` deinit
