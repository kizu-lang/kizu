// A function pointer type names every argument it passes, so a variadic
// function has no pointer type to be a value of. It is called by name.
extern "c" fn printf(format: ptr<const u8>, ...) -> i32
fn main() -> void {
    let callback = printf;
    return;
}

// check-fails
// features: extern-c function-pointer diagnostic
// error: C variadic function `printf` cannot be used as a function pointer
