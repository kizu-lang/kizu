import std::array;
import std::thread;

struct Scratch {
    allocator: Allocator,
    used: i64,
}

fn grow(state: &var Scratch, chunk: &var []i64, index: i64) -> thread::Error!void {
    return;
}

// A state goes to one thread, but an Allocator copied into two states would
// be one allocator used from two threads at once.
fn run(pool: &var thread::Pool, data: &var []i64, states: &var array::Array<Scratch>) -> thread::Error!void {
    try thread::each_with<i64, Scratch, thread::Error>(pool, data, 4, states, grow);
    return;
}

fn main() -> void {
    return;
}

