import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, "abcdef");
    let view = text.as_bytes();
    let flag = true;
    let chosen = if flag { view[1..] } else { view[2..] };
    text.deinit(allocator);
    print(chosen);
    return;
}

// check-fails
// features: slice view borrow if-expression std-string
// error: cannot run while string is borrowed
