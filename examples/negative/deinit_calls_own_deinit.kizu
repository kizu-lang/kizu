import std::mem;
import std::string;

struct Job {
    name: string::String,
}

fn (self: Job) deinit(allocator: Allocator) -> void {
    self.name.deinit(allocator);
    self.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let job = Job { name: try string::from_bytes(allocator, "abc") };
    job.deinit(allocator);
    return;
}

// check-fails
// features: ownership deinit
// error: `deinit` calls itself on `self`
