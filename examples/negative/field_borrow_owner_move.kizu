struct User {
    name: []u8,
    age: i64,
}

fn take(user: User) -> void {
    print(user.name);
}

fn main() -> void {
    let user = User { name: "alice", age: 30 };
    let name = &user.name;
    take(user);
    print(name.*);
}

// check-fails
// features: borrow field-borrow move
// error: value `user` cannot be moved while borrowed
