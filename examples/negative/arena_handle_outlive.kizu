import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn make() -> arena::Handle<User> {
    let allocator = mem::page_allocator();
    let users = arena::Arena<User>(allocator);
    let alice = users.add(User { name: "alice" });
    return alice;
}

// check-fails
// features: arena handle
// error: handle `alice` cannot outlive its arena
