import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn make() -> arena::Arena<User> {
    let allocator = mem::page_allocator();
    return arena::Arena<User>(allocator);
}

fn main() {
    make().deinit();
}

// check-fails
// features: arena deinit
// error: requires local arena receiver
