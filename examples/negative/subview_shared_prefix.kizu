// A read-only view of a range is the slice itself; `&` adds nothing to it,
// so the spelling is refused rather than given a second meaning.
fn main() -> !void {
    var buf = [4]i64{};
    let cells = buf.as_mut_slice();
    let head = &cells[0..2];
    print(head[0]);
    return;
}

// check-fails
// features: typed_view borrow slice
// error: a shared view of a range is the slice itself
