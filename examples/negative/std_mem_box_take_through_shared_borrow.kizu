import std::mem;
import std::string;

fn steal(allocator: Allocator, cell: &mem::Box<string::String>) -> void {
    let text = cell.take(allocator);
    text.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let cell = try mem::box<string::String>(
        allocator, try string::from_bytes(allocator, "abc"));
    steal(allocator, &cell);
    cell.deinit(allocator);
    return;
}

// check-fails
// features: std-mem box borrow
// pending: only String / Map / Arena deinit guard their receiver
// error: `Box.take` requires owned Box receiver
