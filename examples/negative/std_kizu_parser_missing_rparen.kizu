fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let source = std::kizu::ast::source_file("bad.kizu", "add(1");
    // The parse must fail; reaching the print below would mean it did not.
    try std::kizu::parser::parse_first_node(allocator, source);
    print(1);
    return;
}
