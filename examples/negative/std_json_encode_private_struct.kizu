import std::json;
import std::mem;
import std::string;

pub struct Secret {
    token: i64,
}

pub struct Holder {
    pub secret: Secret,
}

// A struct whose state is all private has nothing a walk can read, so writing
// it as an object would emit `{}` and drop the value. An empty object is not
// what the program meant, and no test of the encoder would catch it, so the
// type is refused where it is written.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit();
    let holder = Holder { secret: Secret { token: 1 } };
    try json::encode<Holder>(allocator, holder, out);
    let bytes = out.as_bytes();
    print(bytes);
    return;
}

// check-fails
// features: std-json std-meta comptime diagnostics
// error: does not support type `Secret`
