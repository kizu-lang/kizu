// A view over raw memory is a binding, the way `as_slice` is: the binding
// is what its writability and its lifetime are read from, so the call
// cannot sit inside another expression.
fn total(values: []i64) -> i64 {
    return values[0];
}

fn main() -> void {
    var buffer = [2]i64{};
    let cells = buffer.as_mut_slice();
    let base = mut_ptr_of(cells);
    // SAFETY: the buffer has 2 cells and the view still borrows it.
    print(total(unsafe view_from_ptr(base, 2)));
    return;
}

// check-fails
// features: raw-pointer view diagnostic
// error: `view_from_ptr` must be bound with `let name = view_from_ptr(p, count)`
