import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);
    defer tokens.deinit();

    let first = try tokens.at(0);
    print(first.text);
    return;
}

// run-fails
// features: std-array bounds error-union
// error: std::array::Error::OutOfBounds
