import std::mem;

fn scratch_allocator(bytes: &var []u8) -> Allocator {
    return mem::fixed_buffer(bytes);
}

fn escape() -> Allocator {
    var buf = [1024]u8{};
    let bytes = buf.as_mut_bytes();
    let factory = scratch_allocator;
    return factory(bytes);
}

fn main() -> void {
    let _ = escape();
}

// check-fails
// features: function-pointer tied-allocator borrow-provenance
// error: `factory` returns a value tied to local state and cannot escape
