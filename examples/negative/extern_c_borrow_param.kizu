import std::mem;
import std::string;

// A borrow hands C the address of a String header, which C reads as
// whatever it expects there.
extern "c" fn puts(text: &var string::String) -> i32

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = try string::from_bytes(allocator, "hello");
    defer text.deinit(allocator);
    // SAFETY: probe
    let r = unsafe puts(&var text);
    print(cast<i64>(r));
    return;
}

// check-fails
// features: extern-c ffi borrow std-string
// error: C function `puts` parameter 1 is a borrow (`&var std::string::String`), which C cannot receive
