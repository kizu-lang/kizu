import std::mem;
import std::string;

// The checker cannot know which source the view took, so both stay borrowed
// while it lives: cleaning up the unpicked one is rejected.
fn pick_str(a: &string::String, b: &string::String, take_first: bool) -> &string::String {
    if take_first {
        return a;
    }
    return b;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var left = string::new(allocator);
    defer left.deinit(allocator);
    var right = string::new(allocator);
    let view = pick_str(&left, &right, true);
    right.deinit(allocator);
    print(view.len());
    return;
}

// check-fails
// features: borrow-provenance structural
// error: `String.deinit` cannot run while string is borrowed
