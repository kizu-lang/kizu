import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = try string::from_bytes(allocator, "abc");
    defer text.deinit(allocator);
    try text.append_string(allocator, &text);
    let bytes = text.as_bytes();
    print(bytes);
    return;
}

// check-fails
// features: std-string borrow
// error: cannot be borrowed while mutably borrowed
