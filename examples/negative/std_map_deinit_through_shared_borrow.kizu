import std::map;
import std::mem;

fn kill(symbols: &map::Map<[]u8, i64>) {
    symbols.deinit();
}

fn main() {
    let allocator = mem::page_allocator();
    let symbols = map::Map<[]u8, i64>(allocator);
    kill(&symbols);
}

// check-fails
// features: std-map borrow deinit
// error: requires owned Map receiver
