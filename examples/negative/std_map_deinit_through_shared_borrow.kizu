import std::map;
import std::mem;

fn kill(allocator: Allocator, symbols: &map::Map<[]u8, i64>) {
    symbols.deinit(allocator);
}

fn main() {
    let allocator = mem::page_allocator();
    let symbols = map::new<[]u8, i64>(allocator);
    kill(&symbols);
}

// check-fails
// features: std-map borrow deinit
// error: requires owned Map receiver
