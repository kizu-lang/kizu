import std::mem;
import std::string;

fn release(allocator: Allocator, text: string::String) -> void {
    text.deinit(allocator);
}

fn call_without_move(
    worker: fn(Allocator, string::String) -> void,
    allocator: Allocator,
    text: string::String
) -> void {
    worker(allocator, text);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, "alice");
    call_without_move(release, allocator, move text);
    return;
}

