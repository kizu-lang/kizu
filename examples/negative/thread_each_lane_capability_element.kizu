import std::thread;

struct Job {
    allocator: Allocator,
    size: i64,
}

fn grow(lane: &var []Job, index: i64) -> thread::Error!void {
    return;
}

// A lane is copied into the taking thread's own run and back, so an element
// crosses to another thread the way a chunk's does, and may not hold an
// Allocator either.
fn run(pool: &var thread::Pool, allocator: Allocator, jobs: &var []Job) -> thread::Error!void {
    try thread::each_lane<Job, thread::Error>(pool, allocator, jobs, 2, 2, grow);
    return;
}

fn main() -> void {
    return;
}

