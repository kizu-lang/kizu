import std::array;
import std::mem;
import std::string;

struct Named {
    name: string::String,
}

fn (self: Named) deinit() -> void {
    self.name.deinit();
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var items = array::new<Named>(allocator);
    defer items.deinit();
    try items.append(Named { name: string::new(allocator) });
    let n = items.get_or_panic(0);
    return;
}

