struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn main() -> !void {
    var buf = [4]u8{};
    let view = buf.as_bytes();
    let it = BytesIter { bytes: view, index: 0 };
    let it2 = it;
    print(it2.index);
    return;
}

// check-fails
// features: borrow view-capture diagnostics
// error: borrowed value `it` cannot escape
