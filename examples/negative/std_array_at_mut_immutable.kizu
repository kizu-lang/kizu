struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let tokens = std::array::Array<Token>(allocator);

    let slot = try tokens.at_mut(0);
    print(slot.text);
    return;
}

// check-fails
