import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let tokens = array::new<Token>(allocator);

    let slot = try tokens.at_mut(0);
    print(slot.text);
    return;
}

// check-fails
// features: std-array mutable-borrow
// error: requires mutable array binding
