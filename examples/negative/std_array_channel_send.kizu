struct Holder {
    values: std::array::Array<i64>;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let values = std::array::Array<i64>(allocator);
    let holder = Holder { values: values };
    let channel = std::channel::Channel<Holder>();

    channel.send(holder);
    return void;
}
