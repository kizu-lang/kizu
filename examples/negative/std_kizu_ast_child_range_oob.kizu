fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let source = std::kizu::ast::source_file("empty.kizu", "");
    var ast = std::kizu::ast::Ast(allocator, source);
    let start = ast.begin_children();
    let range = ast.finish_children(start);
    let child = try ast.child_at(range, 0);
    print(child);
    return;
}
