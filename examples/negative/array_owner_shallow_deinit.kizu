import std::array;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let names = array::new<string::String>(allocator);
    defer names.deinit();
    return;
}

// check-fails
// features: std-array ownership deinit-all
// error: `Array.deinit` would leak the owner elements `std::string::String`; use `Array.deinit_all`
