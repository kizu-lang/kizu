fn add(text: &std::string::String) -> !void {
    try text.append_bytes("x");
    return;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    try add(text);
    print(text.len());
    return;
}

