// The named parameters are still required; only what follows them is free.
extern "c" fn snprintf(buffer: ptr<u8>, size: usize, format: ptr<const u8>, ...) -> i32
extern "c" fn malloc(size: usize) -> ptr<u8>
fn main() -> void {
    // SAFETY: 16 bytes are requested.
    let buffer = unsafe malloc(16);
    // SAFETY: buffer holds 16 bytes.
    unsafe snprintf(buffer, 16);
    return;
}

