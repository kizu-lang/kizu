import std::math;

// `min`, `max`, `clamp` and `abs` take the float and the integer types. A
// bool has no larger and smaller, so the call that names it is refused there
// rather than by whatever line of std would have compared two bools.
fn main() -> void {
    let most = math::max<bool>(true, false);
    print(most);
    return;
}

// check-fails
// features: std-math comptime diagnostics
// error: `std::math::max` does not support type `bool`
