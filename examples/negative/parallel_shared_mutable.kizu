struct Accumulator {
    value: i64,
}

fn worker(acc: &var Accumulator) -> !void {
    acc.value = acc.value + 1;
    return;
}

fn main() -> !void {
    let io = std::io::blocking();
    var acc = Accumulator { value: 0 };
    try std::task::parallel_for<worker>(io, 0, 3);
    print(acc.value);
    return;
}
