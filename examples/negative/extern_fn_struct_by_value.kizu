// C passes a struct in registers differently per platform; a pointer says
// the same thing everywhere, so an extern struct is lent, not passed by value.
extern "c" struct Point {
    x: i64,
    y: i64,
}

extern "c" fn move_to(point: Point) -> void
pub fn main() -> void {
    return;
}

// check-fails
// features: extern-struct extern-c diagnostic
// error: C function `move_to` parameter 1 takes extern struct `Point` by value; lend it as `&Point` or `&var Point`
