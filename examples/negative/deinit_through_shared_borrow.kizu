import std::mem;
import std::string;

struct Holder {
    name: string::String,
}

fn (self: Holder) deinit(allocator: Allocator) -> void {
    self.name.deinit(allocator);
    return;
}

// `deinit` consumes its receiver, so it needs an owned one; a shared borrow
// leaves the lender holding a released value.
fn shut(allocator: Allocator, held: &Holder) -> void {
    held.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let held = Holder { name: try string::from_bytes(allocator, "abc") };
    shut(allocator, &held);
    held.deinit(allocator);
    return;
}

// check-fails
// features: ownership borrow deinit
// pending: only String / Map / Arena deinit guard their receiver
// error: requires owned
