// A link attribute names what the native linker resolves a symbol from, so
// it has no meaning on a browser import: the host supplies those.
@link_lib("m")
extern "browser" fn set_title(text: []u8) -> void
fn main() -> void {
    return;
}

// check-fails
// features: extern-browser link-lib diagnostic
// error: link attributes on `set_title` apply to extern "c" fn declarations
