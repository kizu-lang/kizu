// `mut_view_from_ptr` makes a writable view, so it needs a pointer that may
// write. `ptr<const T>` promises the opposite.
fn main() -> void {
    let text = "kizu";
    let base = ptr_of(text);
    // SAFETY: never reached; the program is rejected above.
    let bytes = unsafe mut_view_from_ptr(base, 4);
    bytes[0] = 107;
    return;
}

// check-fails
// features: raw-pointer view diagnostic
// error: `mut_view_from_ptr` expects mutable raw pointer, got ptr<const u8>
