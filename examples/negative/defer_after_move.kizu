import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    defer users.deinit(allocator);
    let moved = move users;
    print(moved);
}

// check-fails
// features: defer move deinit
// error: moved value
