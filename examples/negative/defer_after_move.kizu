import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    defer users.deinit();
    let moved = users;
    print(moved);
}

// check-fails
// features: defer move deinit
// error: moved value
