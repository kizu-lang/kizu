fn kill(symbols: &var std::map::Map<[]u8, i64>) {
    symbols.deinit();
}

fn main() {
    let allocator = std::mem::page_allocator();
    var symbols = std::map::Map<[]u8, i64>(allocator);
    kill(symbols);
}

