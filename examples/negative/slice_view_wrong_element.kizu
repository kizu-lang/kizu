// A view of words is not a view of bytes: `[]u32` does not pass where
// `[]u8` is expected, and nothing reinterprets one as the other.
fn first(bytes: []u8) -> u8 {
    return bytes[0];
}

fn main() -> void {
    var words = [4]u32{};
    let view = words.as_slice();
    print(first(view));
    return;
}

// check-fails
// features: stack_buffer typed_view
// error: type error: arg 1 of `first` expects []u8, got []u32
