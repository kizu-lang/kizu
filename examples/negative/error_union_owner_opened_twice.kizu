import std::mem;
import std::string;

error Failure { Bad }

struct Item {
    name: string::String,
}

fn make(allocator: Allocator, ok: bool) -> Failure!Item {
    if !ok {
        return Failure::Bad;
    }
    let name = string::from_bytes(allocator, "abc") catch return Failure::Bad;
    return Item { name: move name };
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let result = make(allocator, true);
    if result |item| {
        item.deinit(allocator);
    } else |err| {
        print("err");
    }
    if result |item| {
        item.deinit(allocator);
    } else |err| {
        print("err");
    }
    return;
}

// check-fails
// features: error-union ownership optional
// pending: an error union with an owner payload can be opened more than once
// error: must be consumed where it is produced
