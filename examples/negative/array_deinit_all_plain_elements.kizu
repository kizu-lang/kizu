import std::array;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let nums = array::new<i64>(allocator);
    defer nums.deinit_all();
    return;
}

// check-fails
// features: std-array ownership deinit-all
// error: `Array.deinit_all` is for owner elements; `i64` needs no cleanup, use `Array.deinit`
