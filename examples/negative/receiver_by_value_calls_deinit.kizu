import std::mem;
import std::string;

struct Holder {
    name: string::String,
}

fn (self: Holder) deinit(allocator: Allocator) -> void {
    self.name.deinit(allocator);
    return;
}

// `deinit` consumes its receiver, and a by-value receiver of another method
// is not owned there, so this releases what the caller still holds.
fn (self: Holder) close(allocator: Allocator) -> void {
    self.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let held = Holder { name: try string::from_bytes(allocator, "abc") };
    defer held.deinit(allocator);
    held.close(allocator);
    return;
}

// check-fails
// features: ownership method deinit
// error: requires owned
