// A static expression is evaluated while checking, so every name in it has to
// be known then. A runtime local has no value yet; a runtime value goes in
// `(...)`, not `<...>`.
fn scaled<k: i64>() -> i64 {
    return k * 100;
}

fn main() -> void {
    let n = 3;
    print(scaled<(n * 2)>());
}

// check-fails
// features: comptime generics
// error: type error: `scaled` static argument `k`: `n` is not a compile-time integer
