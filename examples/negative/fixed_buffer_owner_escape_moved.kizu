// `move` は place から値を渡すだけで、tie を落としません。tied allocator から
// 作った owner は、`move` を書いても frame を出られません。

import std::mem;
import std::string;

fn leak(bytes: &var []u8) -> !string::String {
    let tied = mem::fixed_buffer(bytes);
    let text = try string::from_bytes(tied, "x");
    return move text;
}

fn main() -> !void {
    var buf = [512]u8{};
    let scratch = buf.as_mut_bytes();
    let text = try leak(scratch);
    text.deinit(mem::page_allocator());
    return;
}

// check-fails
// features: allocator fixed-buffer borrow move
// error: value `text` is allocated from a tied allocator and cannot escape its frame
