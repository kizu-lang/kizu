// A `[]u8` is a pointer and a length; C has no one value that carries both,
// so the declaration names what C sees instead.
extern "c" fn strlen(text: []u8) -> usize

fn main() -> void {
    // SAFETY: the literal is NUL-free static data
    let n = unsafe strlen("hello");
    print(cast<i64>(n));
    return;
}

// check-fails
// features: extern-c ffi view
// error: C function `strlen` parameter 1 has type `[]u8`, which C cannot receive
