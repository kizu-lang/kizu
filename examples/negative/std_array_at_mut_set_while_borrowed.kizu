struct Token {
    text: []const u8;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var tokens = std::array::Array<Token>(allocator);

    try tokens.append(Token { text: "let" });
    let slot = try tokens.at_mut(0);
    try tokens.set(0, Token { text: "var" });
    print(slot.text);
    return void;
}
