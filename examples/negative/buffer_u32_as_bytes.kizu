// A buffer of u32 is viewed as words with `as_slice`; it has no `as_bytes`,
// because the bytes of a word are not a view but a choice of byte order.
fn main() -> void {
    var words = [4]u32{};
    let view = words.as_bytes();
    print(view[0]);
    return;
}

// check-fails
// features: stack_buffer typed_view
// error: type error: `[4]u32` has no `as_bytes`; a buffer of u32 is viewed with `as_slice`
