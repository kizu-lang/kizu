fn pick(flag: bool) -> ?i64 {
    if flag {
        return 7;
    }
    return null;
}

// The break arm of an orelse guard obeys the same placement rule as the
// statement: it needs an enclosing loop.
fn main() -> !void {
    let value = pick(true) orelse break;
    print(value);
    return;
}

// check-fails
// features: optional orelse guard diagnostics
// error: `break` used outside loop
