import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn first(tokens: &array::Array<Token>) -> !Token {
    return try tokens.at(0);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);

    try tokens.append(Token { text: "let" });
    let token = try first(tokens);
    print(token.text);
    return;
}

// check-fails
// features: std-array borrow escape
// error: Array.at` must be bound
