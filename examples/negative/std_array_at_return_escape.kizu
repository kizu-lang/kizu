struct Token {
    text: []const u8,
}

fn first(tokens: &std::array::Array<Token>) -> !Token {
    return try tokens.at(0);
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var tokens = std::array::Array<Token>(allocator);

    try tokens.append(Token { text: "let" });
    let token = try first(tokens);
    print(token.text);
    return;
}
