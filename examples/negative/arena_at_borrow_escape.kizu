import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn escaped() -> &User {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let alice = users.add(allocator, User { name: "alice" });
    return users.at(alice);
}

fn main() {}

// check-fails
// features: arena borrow escape
// error: Arena.at borrow from local `users` cannot escape
