// A folded float becomes a literal, and a literal names a finite value. An
// infinity or NaN reached at compile time is the program's error, reported
// where it is written rather than carried into the binary.
fn main() -> void {
    let x = comptime 1.0 / 0.0;
    print(x);
}

// check-fails
// features: comptime float
// error: comptime error: the value is not finite (+Inf)
