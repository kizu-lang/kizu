import std::mem;
import std::string;

fn kill(allocator: Allocator, text: &var string::String) {
    text.deinit(allocator);
}

fn main() {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    kill(allocator, text);
    print(text.len());
}

// check-fails
// features: std-string mutable-borrow deinit
// error: requires owned String receiver
