fn kill(text: &var std::string::String) {
    text.deinit();
}

fn main() {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    kill(text);
    print(text.len());
}

// check-fails
// features: std-string mutable-borrow deinit
// error: requires owned String receiver
