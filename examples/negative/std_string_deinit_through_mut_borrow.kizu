import std::mem;
import std::string;

fn kill(text: &var string::String) {
    text.deinit();
}

fn main() {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    kill(text);
    print(text.len());
}

// check-fails
// features: std-string mutable-borrow deinit
// error: requires owned String receiver
