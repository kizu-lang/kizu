import std::map;
import std::mem;

// A captured key view aliases map storage, so the capture holds the map
// share-borrowed. Inserting could grow the entries and leave the view
// dangling, so mutation waits until the key's last use.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let scores = map::new<[]u8, i64>(allocator);
    defer scores.deinit();
    try scores.insert("one", 1);
    var index = 0;
    while scores.key_at(index) |key| {
        try scores.insert("grow", 9);
        print(key);
        index = index + 1;
    }
    return;
}

// check-fails
// features: optional view map borrow diagnostics
// error: `Map.insert` cannot run while map is borrowed
