// Only an extern struct has the layout C reads through a pointer; a Kizu
// struct lent to C hands it an address whose contents it cannot read.
struct Point {
    x: i64,
    y: i64,
}

extern "c" fn move_to(point: &var Point) -> void
pub fn main() -> void {
    return;
}

// check-fails
// features: extern-c diagnostic
// error: C function `move_to` parameter 1 is a borrow (`&var Point`), which C cannot receive
