import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit();
    try text.append_bytes("a");
    let bytes = text.as_bytes();
    try text.reserve(16);
    print(bytes);
    return;
}

// check-fails
// features: std-string borrow capacity
// error: cannot run while string is borrowed
