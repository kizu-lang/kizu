// A struct that holds itself by value, even through another type, has no
// finite size. Holding the inner one through `std::mem::Box<T>` or an arena
// handle gives it one.

struct Node {
    value: i64,
    next: Link,
}

union Link {
    End,
    More(Node),
}

fn main() -> void {
    return;
}

// check-fails
// features: struct union diagnostics
// error: `Node` holds itself by value (field `Node.next`: Link, then payload `Link::More`: Node), so its size has no end
