// A union variant whose payload is the union itself has no finite inline
// layout: its size would have no end. The checker says so at the declaration,
// and names the indirection that gives it one, instead of boxing the payload
// behind the programmer's back.

union Rec {
    Node(Rec),
}

fn main() {
    return;
}

// check-fails
// features: union diagnostics
// error: `Rec` holds itself by value (payload `Rec::Node`: Rec), so its size has no end
