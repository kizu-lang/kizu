// A union variant whose payload is the union itself has no finite inline
// layout, so the tagged-union ABI cannot give it a size. The backend says so
// instead of looping or boxing the payload behind the programmer's back.

union Rec {
    Node(Rec),
}

fn main() {
    return;
}

// check-fails
// features: union diagnostics
// error: unsupported tagged-union payload shape
