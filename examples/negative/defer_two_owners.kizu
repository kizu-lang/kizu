// A deferred call consumes at most one owner. Two would need to retire
// separately when one is consumed before the exit, which one registration
// cannot express.
import std::mem;
import std::string;

fn drop_both(allocator: Allocator, left: string::String, right: string::String) -> void {
    left.deinit(allocator);
    right.deinit(allocator);
    return;
}

fn main() -> void {
    let allocator = mem::page_allocator();
    let left = string::new(allocator);
    let right = string::new(allocator);
    defer drop_both(allocator, move left, move right);
    return;
}

// check-fails
// features: defer ownership
// error: defer call consumes both `left` and `right`
