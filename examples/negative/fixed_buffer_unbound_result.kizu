import std::array;
import std::mem;

fn main() -> !void {
    var buf = [4096]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    var values = array::new<i64>(mem::page_allocator());
    values.deinit();
    values = array::new<i64>(alloc);
    defer values.deinit();
    try values.append(1);
    return;
}

// check-fails
// features: allocator fixed-buffer borrow
// error: a value allocated from a tied allocator must be bound with `let`
