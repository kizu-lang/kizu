import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = move string::new(allocator);
    defer text.deinit(allocator);
    return;
}

// check-fails
// features: move diagnostic std-string
// error: `move` marks a hand-off from a named place, and `std::string::new(allocator)` is not one
