// Stepping a pointer can leave the allocation it came from, which nothing
// checks, so `ptr_offset` is an `unsafe` operation like `ptr_from_int`.
fn main() -> void {
    let text = "kizu";
    let base = ptr_of(text);
    let next = ptr_offset(base, 1);
    // SAFETY: never reached; the program is rejected above.
    print(unsafe ptr_read(next));
    return;
}

// check-fails
// features: raw-pointer diagnostic
// error: `ptr_offset` requires `unsafe`
