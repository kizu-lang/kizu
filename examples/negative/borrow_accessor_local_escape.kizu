import std::array;
import std::mem;

// A returned borrow must be rooted in a borrowed parameter: a local
// container dies with the frame, so its element borrow cannot leave it.
fn leak(allocator: Allocator) -> ?&var i64 {
    var items = array::new<i64>(allocator);
    return items.at_mut(0);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    if leak(allocator) |v| {
        v.* = 1;
    }
    return;
}

// check-fails
// features: borrow optional signature escape
// error: must borrow a borrowed parameter
