import std::array;
import std::mem;
import std::string;

// `pop` moves the element out of the array, so `deinit_all` no longer reaches
// it. Discarding the result drops the string where nothing can clean it up:
// the consume obligation lives on a binding, and this value never gets one (§9).
fn main() -> !void {
    let allocator = mem::page_allocator();
    var parent = array::new<string::String>(allocator);
    defer parent.deinit_all();

    var name = string::new(allocator);
    errdefer name.deinit();
    try name.append_byte(cast<u8>(97));
    try parent.append(name);

    parent.pop();
    return;
}

// check-fails
// features: ownership deinit std-array std-string optional
// error: this expression produces owned `?std::string::String` and discards it
