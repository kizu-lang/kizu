import std::string;

pub struct Visitor {
    pub nick: ?string::String,
}

fn (self: Visitor) deinit() -> void {
    if self.nick |held| {
        held.deinit();
    }
    return;
}

// The payload lives in the visitor's storage, and this function only borrows
// the visitor. Consuming what the capture binds would release memory the
// visitor still believes it owns, and its own `deinit` would release it again.
fn drop_nick(visitor: &Visitor) -> void {
    if visitor.nick |held| {
        held.deinit();
    }
    return;
}

fn main() -> !void {
    var visitor = Visitor { nick: null };
    defer visitor.deinit();
    drop_nick(&visitor);
    return;
}

// check-fails
// features: optional owner diagnostics
// error: `String.deinit` requires owned String receiver
