import std::io;
import std::mem;

struct Viewed {
    bytes: []u8,
}

fn use_view(handle: Io, allocator: Allocator, state: Viewed) -> void {
    print(state.bytes);
    return;
}

fn main() -> !void {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var tasks = try io::task_set_new(handle, allocator);
    defer tasks.deinit(allocator);
    let state = Viewed { bytes: "borrowed" };
    try io::spawn<Viewed>(&var tasks, use_view, state);
    return;
}

// check-fails
// features: io task-set ownership borrow
// error: `std::io::spawn` state `Viewed` must own its data and contain no Io or Allocator
