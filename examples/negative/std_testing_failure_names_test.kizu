import std::testing;

// A failure names the test it happened in and the statement of the test body
// that reached it, even when the assertion itself sits in a helper.
fn expect_three(value: i64) -> void {
    testing::expect_equal<i64>(3, value);
    return;
}

test "the helper is blamed at its call" {
    expect_three(4);
}

// test-fails
// features: std-testing trap
// error: note: in test "the helper is blamed at its call" at
