extern "c" fn strcpy(to: ptr<u8>, from: ptr<const u8>) -> ptr<u8>
fn main() -> void {
    // SAFETY: none; the call is refused because a C string literal is constant.
    let _ = unsafe strcpy(c"hello", c"world");
    return;
}

