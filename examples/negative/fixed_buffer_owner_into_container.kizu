// tied allocator から作った owner は container の要素にもできません。同じ
// allocator の container であっても、`move` そのものが tie を渡せないためです
// (SPEC §14.3)。tie の一致を別に検査する必要はなく、要素になれないことが
// container の解放が要素へ渡す allocator を一致させます。

import std::array;
import std::mem;
import std::string;

fn main() -> !void {
    var buf = [4096]u8{};
    let view = buf.as_mut_bytes();
    let scratch = mem::fixed_buffer(view);
    var texts = array::new<string::String>(scratch);
    defer texts.deinit(scratch);
    let text = try string::from_bytes(scratch, "x");
    try texts.append(scratch, move text);
    return;
}

// check-fails
// features: allocator fixed-buffer borrow move
// error: value `text` is allocated from a tied allocator and cannot escape its frame
