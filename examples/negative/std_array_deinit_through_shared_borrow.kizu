import std::array;
import std::mem;

fn shut(allocator: Allocator, values: &array::Array<i64>) -> void {
    values.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    errdefer values.deinit(allocator);
    try values.append(allocator, 1);
    shut(allocator, &values);
    values.deinit(allocator);
    return;
}

// check-fails
// features: std-array borrow deinit
// error: `Array.deinit` requires owned Array receiver
