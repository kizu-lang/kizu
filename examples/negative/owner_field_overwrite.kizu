import std::mem;
import std::string;

struct Holder {
    pub name: string::String,
}

// Assigning over an owner field releases nothing, so the string the field held
// leaks. This is the rule owner-element `set` already carries (§9).
fn replace(holder: &var Holder, allocator: Allocator) -> void {
    holder.name = string::new(allocator);
    return;
}

fn main() -> void {
    let allocator = mem::page_allocator();
    var holder = Holder { name: string::new(allocator) };
    replace(&var holder, allocator);
    holder.deinit();
    return;
}

// check-fails
// features: ownership deinit std-string assignment
// error: owner field `holder.name` is overwritten before cleanup
