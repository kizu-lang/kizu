// A call by name passes a struct by value the way the target's C convention
// does; a call through a function pointer passes only scalars, so a C function
// that takes a struct by value is not a function pointer value.
extern "c" struct Point {
    x: i64,
    y: i64,
}

extern "c" fn move_to(point: Point) -> void

pub fn main() -> void {
    let callback = move_to;
    // SAFETY: move_to takes any point.
    unsafe callback(Point { x: 1, y: 2 });
    return;
}

// check-fails
// features: extern-struct extern-c function-pointer diagnostic
// error: C function `move_to` passes `Point`, which a C function pointer cannot carry; call it by name
