import std::string;

struct Bag {
    name: string::String,
}

fn take(bag: Bag) -> void {
    bag.deinit();
}

// The receiver arrives by value and is being taken apart, so consuming the
// field is allowed here. Handing what is left to someone else is not: that one
// sees a whole `Bag` and releases the string a second time.
fn (self: Bag) deinit() -> void {
    self.name.deinit();
    take(move self);
}

fn main() -> void {
    return;
}

// check-fails
// features: ownership field-move deinit diagnostic
// error: field `self.name` is already consumed, so `self` cannot be handed on whole
