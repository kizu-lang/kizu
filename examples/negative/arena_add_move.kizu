struct User {
    name: []u8,
}

fn main() {
    let allocator = std::mem::page_allocator();
    let users = std::arena::Arena<User>(allocator);
    let user = User { name: "alice" };
    let alice = users.add(user);
    print(user.name);
    print(users.get(alice).name);
}

// check-fails
// features: arena move
// error: moved value `user` was used
