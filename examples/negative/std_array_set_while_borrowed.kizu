struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var tokens = std::array::Array<Token>(allocator);

    try tokens.append(Token { text: "let" });
    let first = try tokens.at(0);
    try tokens.set(0, Token { text: "var" });
    print(first.text);
    return;
}

// check-fails
// features: std-array borrow mutation
// error: cannot run while array is borrowed
