struct User {
    name: []const u8,
}

fn load(io: Io, users: std::arena::Arena<User>) -> void {
    print(users);
}

fn main() -> void {
    let io = std::io::blocking();
    let allocator = std::mem::page_allocator();
    let users = std::arena::Arena<User>(allocator);
    let group = std::task::Group(io);
    let task = group.spawn(load, users);
    task.cancel();
}
