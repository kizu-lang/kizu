import std::thread;

struct SharedAlloc {
    allocator: Allocator,
}

fn work(ctx: &SharedAlloc, chunk: &var []i64, index: i64) -> thread::Error!void {
    return;
}

// A shared context reaches every worker thread at once, so it cannot carry an
// Allocator or Io capability.
fn run(pool: &var thread::Pool, data: &var []i64, ctx: &SharedAlloc) -> thread::Error!void {
    try thread::each_shared<i64, SharedAlloc, thread::Error>(pool, data, 4, ctx, work);
    return;
}

fn main() -> void {
    return;
}

