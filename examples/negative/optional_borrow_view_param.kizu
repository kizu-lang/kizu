import std::mem;

// A view is somebody's borrow, and an optional of one has nowhere to be
// kept, so there is nothing for a callee to be lent.
fn peek(slot: &?[]u8) -> i64 {
    if slot |text| {
        return mem::len(text);
    }
    return -1;
}

fn main() -> void {
    print(peek(&null));
    return;
}

// check-fails
// features: optional borrow view diagnostics
// error: type error: parameter `slot` cannot borrow `?[]u8`; only an optional of copy data (`?i64`, an enum, a handle, a plain struct) can be borrowed, because a capture through the borrow would move the payload out of the caller's optional
