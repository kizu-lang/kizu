import std::mem;
import std::string;

// `?[]u8` carries its view the same way `![]u8` does: a borrow-class view
// cannot be lent into a call whose optional return could carry it out.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    defer text.deinit();
    try text.append_bytes("kizu");
    let view = text.as_bytes();
    let escaped = mem::slice(view, 0, 2) orelse "";
    print(escaped);
    return;
}

// check-fails
// features: optional view borrow diagnostics
// error: borrowed value `view` cannot escape
