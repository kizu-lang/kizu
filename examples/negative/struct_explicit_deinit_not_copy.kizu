import std::array;
import std::mem;

// A declared deinit is a cleanup contract: the value must be consumed, so the
// type stays move-only even when every field is copy.

struct Token {
    id: i64,
}

fn (self: Token) deinit() -> void {
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);
    defer tokens.deinit_all();
    try tokens.append(Token { id: 1 });
    let t = tokens.get_or_panic(0);
    return;
}

// check-fails
// features: struct copy ownership array get
// error: `Array.get_or_panic` requires copy element
