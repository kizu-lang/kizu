import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let left = arena::new<User>(allocator);
    defer left.deinit(allocator);
    let right = arena::new<User>(allocator);
    defer right.deinit(allocator);
    let alice = try left.add(allocator, User { name: "alice" });
    print(right.at(alice).name);
    return;
}

// check-fails
// features: arena handle
// error: handle `alice` does not belong to arena `right`
