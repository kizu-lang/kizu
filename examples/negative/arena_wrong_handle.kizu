import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let left = arena::Arena<User>(allocator);
    let right = arena::Arena<User>(allocator);
    let alice = left.add(User { name: "alice" });
    print(right.get(alice).name);
}

// check-fails
// features: arena handle
// error: handle `alice` does not belong to arena `right`
