struct Budget {
    amount: i64,
}

struct Account {
    current: Budget,
    count: i64,
}

fn spend(target: &var i64, whole: Budget) -> void {
    target.* = target.* - whole.amount;
    return;
}

// A call may borrow disjoint fields of one owner, but `account.current.amount`
// lies inside `account.current`, so copying the struct out while its field is
// mutably borrowed reads the same storage twice.
fn main() -> void {
    var account = Account { current: Budget { amount: 5 }, count: 0 };
    spend(&var account.current.amount, account.current);
    print(account.current.amount);
    return;
}

// check-fails
// features: borrow field-borrow mutable-borrow ownership
// error: cannot be read while mutably borrowed
