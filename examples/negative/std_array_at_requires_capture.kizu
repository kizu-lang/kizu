import std::array;
import std::mem;

struct Token {
    text: []u8,
}

// `Array.at` produces a borrow optional, and a capture is its only consumer:
// a stored `?&T` would hold an element borrow no binding ties to the array.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);
    defer tokens.deinit(allocator);

    try tokens.append(allocator, Token { text: "let" });
    let first = tokens.at(0);
    return;
}

// check-fails
// features: std-array borrow optional capture
// error: Array.at` must be consumed by a capture
