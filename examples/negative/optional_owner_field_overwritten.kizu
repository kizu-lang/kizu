import std::mem;
import std::string;

pub struct Visitor {
    pub nick: ?string::String,
}

fn (self: Visitor) deinit(allocator: Allocator) -> void {
    if self.nick |held| {
        held.deinit(allocator);
    }
    return;
}

fn owned(allocator: Allocator, bytes: []u8) -> !string::String {
    var text = string::new(allocator);
    errdefer text.deinit(allocator);
    try text.append_bytes(bytes);
    return move text;
}

// Writing over the field releases nothing, so the string it held is lost. A
// `?Owner` field is live until the owner's deinit opens it, the same as a
// plain owner field.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var visitor = Visitor { nick: try owned(allocator, "al") };
    defer visitor.deinit(allocator);
    visitor.nick = null;
    return;
}

// check-fails
// features: optional owner diagnostics
// error: owner field `visitor.nick` is overwritten before cleanup
