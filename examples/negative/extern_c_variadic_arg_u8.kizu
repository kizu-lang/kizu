// C widens a `u8` to `int` when it is passed as a variadic argument. Kizu
// converts nothing the source does not spell, so the call says `cast<i32>`.
extern "c" fn printf(format: ptr<const u8>, ...) -> i32
fn main() -> void {
    let grade: u8 = 65;
    // SAFETY: the format reads one `int`.
    unsafe printf(c"%c", grade);
    return;
}

// check-fails
// features: extern-c cast diagnostic
// error: arg 2 of `printf` has type u8, which C promotes in a variadic call and Kizu does not; write `cast<i32>(...)`
