fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let left_source = std::kizu::ast::source_file("left.kizu", "left");
    let right_source = std::kizu::ast::source_file("right.kizu", "right");
    var left_ast = std::kizu::ast::Ast(allocator, left_source);
    var right_ast = std::kizu::ast::Ast(allocator, right_source);
    let right_start = right_ast.begin_children();
    let right_node = right_ast.add_empty(0);
    try right_ast.add_child(right_node);
    let right_range = right_ast.finish_children(right_start);
    let copied_range = right_range;
    let node = left_ast.add_struct_decl(
        std::kizu::ast::span(0, 1),
        std::kizu::ast::symbol_id(0),
        copied_range
    );
    print(left_ast.get(node).span.start);
    return;
}
