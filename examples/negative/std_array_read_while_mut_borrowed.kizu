import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);
    defer tokens.deinit(allocator);

    try tokens.append(allocator, Token { text: "let" });
    if tokens.at_mut(0) |slot| {
        print(tokens.len());
        slot.* = Token { text: "var" };
    }
    return;
}

// check-fails
// features: std-array mutable-borrow
// error: cannot read while mutably borrowed
