import std::array;
import std::mem;

struct Token {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tokens = array::new<Token>(allocator);
    defer tokens.deinit();

    try tokens.append(Token { text: "let" });
    let slot = try tokens.at_mut(0);
    print(tokens.len());
    print(slot.text);
    return;
}

// check-fails
// features: std-array mutable-borrow
// error: cannot read while mutably borrowed
