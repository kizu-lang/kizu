import std::thread;

struct Job {
    allocator: Allocator,
    size: i64,
}

fn grow(part: &var []Job, index: i64) -> thread::Error!void {
    return;
}

// Every chunk runs on its own thread. An Allocator copied into two elements
// would be one allocator used from two threads at once, so an element may
// not hold one, whatever lent the view.
fn run(pool: &var thread::Pool, jobs: &var []Job) -> thread::Error!void {
    try thread::each<Job, thread::Error>(pool, jobs, 1, grow);
    return;
}

fn main() -> void {
    return;
}

// check-fails
// features: thread ownership capability
// error: `std::thread::each` element `Job` must own its data and contain no Io or Allocator
