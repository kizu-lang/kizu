import std::mem;
import std::string;

pub struct Inner {
    pub nick: ?string::String,
}

fn (self: Inner) deinit(allocator: Allocator) -> void {
    if self.nick |held| {
        held.deinit(allocator);
    }
    return;
}

pub struct Outer {
    pub inner: Inner,
}

// The path depth changes nothing: this still reads a field out of storage the
// outer value owns. Cleanup through a nested path is refused for the same
// reason `self.inner.nick.deinit()` is — it would bypass `Inner`'s own deinit.
fn drop_nick(allocator: Allocator, outer: &Outer) -> void {
    if outer.inner.nick |held| {
        held.deinit(allocator);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var outer = Outer { inner: Inner { nick: null } };
    defer outer.deinit(allocator);
    drop_nick(allocator, &outer);
    return;
}

// check-fails
// features: optional owner diagnostics
// error: `String.deinit` requires owned String receiver
