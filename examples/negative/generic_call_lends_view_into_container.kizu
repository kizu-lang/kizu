import std::array;
import std::mem;
import std::string;

fn push<T>(allocator: Allocator, into: &var array::Array<T>, value: T) -> !void {
    try into.append(allocator, value);
    return;
}

fn fill(allocator: Allocator, into: &var array::Array<[]u8>) -> !void {
    let text = try string::from_bytes(allocator, "abc");
    defer text.deinit(allocator);
    let view = text.as_bytes();
    try push<[]u8>(allocator, into, view);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var views = array::new<[]u8>(allocator);
    defer views.deinit(allocator);
    try fill(allocator, &var views);
    print(views.get_or_panic(0));
    return;
}

// check-fails
// features: generic view borrow std-array
// error: borrowed value `view` cannot escape
