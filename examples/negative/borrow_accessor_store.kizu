import std::array;
import std::mem;

struct Registry {
    users: array::Array<i64>,
}

fn (self: Registry) deinit() -> void {
    self.users.deinit();
}

fn (self: &var Registry) user(id: i64) -> ?&var i64 {
    return self.users.at_mut(id);
}

// A borrow-optional call result has the same two consumers as at/at_mut:
// a capture condition, or a declared borrow-optional return. Storing it
// would hold a borrow no binding ties to its source.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var reg = Registry { users: array::new<i64>(allocator) };
    defer reg.deinit();
    try reg.users.append(7);
    let entry = reg.user(0);
    return;
}

// check-fails
// features: borrow optional signature capture
// error: must be consumed by a capture
