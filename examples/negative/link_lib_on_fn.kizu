// A link attribute belongs to an extern declaration; a Kizu function has no
// symbol for the linker to look for.
@link_lib("m")
fn cbrt(value: f64) -> f64 {
    return value;
}

fn main() -> void {
    return;
}

// parse-fails
// features: link-lib diagnostic
// error: link attributes apply to extern "c" fn declarations
