import std::mem;
import std::string;

fn borrow_text(text: &string::String) -> &string::String {
    return text;
}

fn call_borrow(
    worker: fn(&string::String) -> &string::String,
    text: &string::String
) -> &string::String {
    return worker(text);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    let borrowed = call_borrow(borrow_text, text);
    text.deinit(allocator);
    print(borrowed.len());
    return;
}

// check-fails
// features: function-pointer borrow-provenance
// error: `String.deinit` cannot run while string is borrowed
