struct Point {
    x: i64,
}

fn origin() -> Point {
    return Point { x: 0 };
}

// A call result is a temporary, not a place: writing its field would store
// into a value nothing holds, so the target is refused at check.
fn main() -> void {
    origin().x = 3;
}

// check-fails
// features: struct field assignment
// error: invalid assignment target `origin().x`
