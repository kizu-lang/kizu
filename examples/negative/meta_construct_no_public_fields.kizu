import std;

struct Opaque {
    count: i64,
}

fn make<T, f: Field>(base: i64) -> !std::meta::field_type<T, f> {
    return base;
}

// A type with no public field would be built from nothing, and the arguments
// the caller meant to put in it would go nowhere. `encode` refuses the same
// shape for the same reason.
fn main() -> !void {
    let value = try std::meta::construct<Opaque, make>(1);
    print("unreachable");
    return;
}

// check-fails
// features: comptime construct field-static-param reflection struct
// error: has no public field to construct `Opaque` from
