// `mut_ptr_of` gives a pointer that may write, so it needs a view that
// promises writable backing: a binding held as `&var []T`. A plain view,
// even a `var`-bound one, does not.
fn main() -> void {
    let text = "kizu";
    let p = mut_ptr_of(text);
    // SAFETY: never reached; the program is rejected above.
    unsafe ptr_write(p, 107);
    return;
}

// check-fails
// features: raw-pointer view diagnostic
// error: `mut_ptr_of` needs a writable view binding (`&var []T`), `text` is not one
