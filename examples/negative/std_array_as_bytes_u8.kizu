import std::array;
import std::mem;

// `as_bytes` is the view of `String`, the one owner of bytes; an Array<u8>
// does not lend its bytes under that name either, and the error says where
// bytes belong instead of sending the reader to `as_slice`.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var bytes = array::new<u8>(allocator);
    defer bytes.deinit(allocator);
    try bytes.append(allocator, cast<u8>(1));
    let view = bytes.as_bytes();
    print(mem::count<u8>(view));
    return;
}

// check-fails
// features: std-array typed_view
// error: type error: `std::array::Array<u8>` has no `as_bytes`; bytes are owned by `std::string::String`, whose view is `as_bytes`
