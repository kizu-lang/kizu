// A deferred call runs where no caller is listening, so it cannot fail:
// there is no path for an error to leave through.
error Error {
    Closed,
}

fn close(id: i64) -> Error!void {
    if id < 0 {
        return Error::Closed;
    }
    return;
}

fn main() -> Error!void {
    defer try close(1);
    return;
}

// check-fails
// features: defer type-check
// error: defer call cannot propagate an error with `try`
