fn build(allocator: Allocator) -> !std::array::Array<i64> {
    let values = std::array::Array<i64>(allocator);
    errdefer values.deinit();

    let moved = values;
    try moved.append(1);
    return moved;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let values = try build(allocator);
    defer values.deinit();
    return;
}

// check-fails
// features: errdefer move deinit
// error: errdefer cleanup receiver `values` was moved before an error path
