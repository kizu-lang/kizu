import std;

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let resolved = try std::fs::real_path(
        io,
        allocator,
        "examples/fixtures/real_path/loop"
    );
    defer resolved.deinit(allocator);
    return;
}

// run-fails
// features: std-fs real-path explicit-io
// dir: .
// error: std::fs::Error::OperationFailed
