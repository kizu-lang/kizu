// Each expansion of a `comptime for` is a copy of the body to check and
// lower, so the range is capped. A range this long is asking for a loop that
// runs, which is the runtime `for`.
fn main() -> void {
    var total = 0;
    comptime for 0..4096 |i| {
        total = total + i;
    }
    print(total);
}

// check-fails
// features: comptime comptime-for
// error: comptime error: comptime for 0..4096 expands 4096 times; the limit is 1024 (a longer range is a runtime `for`)
