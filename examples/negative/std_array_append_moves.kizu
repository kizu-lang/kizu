import std::array;
import std::mem;

struct Box {
    text: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let values = array::Array<Box>(allocator);
    let item = Box { text: "owned" };

    try values.append(item);
    print(item.text);
    return;
}

