pub struct Counter {
    pub value: i64,
}

fn add_both(left: &var Counter, right: &var Counter) -> void {
    left.value = left.value + right.value;
}

fn call_twice(
    worker: fn(&var Counter, &var Counter) -> void,
    counter: &var Counter
) -> void {
    worker(counter, counter);
}

fn main() -> void {
    var counter = Counter { value: 1 };
    call_twice(add_both, counter);
}

// check-fails
// features: function-pointer borrow diagnostics
// error: value `counter` cannot be borrowed while mutably borrowed
