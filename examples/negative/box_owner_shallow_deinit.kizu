import std::mem;
import std::string;

fn make_name(allocator: Allocator) -> !string::String {
    var name = string::new(allocator);
    errdefer name.deinit();
    try name.append_bytes("boxed");
    return name;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let cell = try mem::box<string::String>(allocator, try make_name(allocator));
    defer cell.deinit();
    return;
}

// check-fails
// features: std-mem box ownership deinit-all
// error: `Box.deinit` would leak the owner payload `std::string::String`; use `Box.deinit_all`
