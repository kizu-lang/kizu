import std::mem;
import std::string;

struct Bag {
    name: string::String,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let bag = Bag { name: string::new(allocator) };
    print(bag.name.len());
    return;
}

// check-fails
// features: ownership deinit-required
// error: struct `Bag` holds owner field `name` and must declare deinit
