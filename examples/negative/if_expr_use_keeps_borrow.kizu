import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, "abcdef");
    let view = text.as_bytes();
    let flag = true;
    text.deinit(allocator);
    let count = if flag { mem::len(view) } else { 0 };
    print(count);
    return;
}

// check-fails
// features: view borrow if-expression std-string
// error: cannot run while string is borrowed
