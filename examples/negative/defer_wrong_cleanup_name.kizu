struct Handle {
    pub id: i64,
}

fn (self: Handle) deinit() -> void {
    return;
}

fn (self: Handle) close() -> void {
    return;
}

// `defer` registers any void call, but registering one does not change what
// the call does: `close` is not the cleanup that discharges the owner's
// consume obligation -- only `deinit` is (ADR-0119) -- so the handle still
// owes its deinit at the end of the block.
fn main() -> void {
    let handle = Handle { id: 1 };
    defer handle.close();
    return;
}

// check-fails
// features: defer type-check ownership
// error: owned value `handle` is never deinitialized
