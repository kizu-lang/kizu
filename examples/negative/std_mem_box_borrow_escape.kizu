import std::mem;

struct Item {
    value: i64,
}

fn leak(item: mem::Box<Item>) -> Item {
    let borrowed = item.borrow();
    return borrowed;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let value = Item { value: 1 };
    let item_result = mem::Box<Item>(allocator, value);
    let item = try item_result;
    let borrowed = leak(item);
    print(borrowed.value);
    return;
}

// check-fails
// features: std-mem box borrow-check
// error: borrowed value
