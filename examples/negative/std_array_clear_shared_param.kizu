import std::array;
import std::mem;

fn empty(allocator: Allocator, values: &array::Array<i64>) -> void {
    values.clear(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try values.append(allocator, 1);
    empty(allocator, &values);
    return;
}

// check-fails
// features: std-array clear mutable-borrow
// error: `Array.clear` requires mutable Array receiver
