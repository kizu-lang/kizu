import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn take(user: User) {
    print(user.name);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    take(users.at(alice));
    return;
}

// check-fails
// features: arena borrow
// error: borrow argument cannot be passed to owning parameter
