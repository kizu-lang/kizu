import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn take(user: User) {
    print(user.name);
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let alice = users.add(User { name: "alice" });
    take(users.at(alice));
}

// check-fails
// features: arena borrow
// error: borrow argument cannot be passed to owning parameter
