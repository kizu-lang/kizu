// A C function pointer lends a struct the way a declared C function does, so
// it lends only an extern struct: C reads the address it receives through the
// layout it knows, and a Kizu struct promises none.
struct Point {
    x: i64,
    y: i64,
}

fn call(move_to: extern "c" fn(&var Point) -> void, point: &var Point) -> void {
    // SAFETY: move_to takes any point.
    unsafe move_to(point);
}

pub fn main() -> void {
    return;
}

// check-fails
// features: extern-c function-pointer diagnostic
// error: `extern "c" fn(&var Point) -> void` passes `&var Point`, which C cannot name
