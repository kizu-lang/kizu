import std::array;
import std::mem;

// A lent range is a borrow of a local view, which is a borrow of the Array
// that frame owns; neither outlives the frame.
fn head(allocator: Allocator) -> ![]i64 {
    var counts = array::new<i64>(allocator);
    defer counts.deinit(allocator);
    try counts.append(allocator, 1);
    let cells = counts.as_mut_slice();
    let row = &var cells[0..1];
    return row;
}

fn main() -> !void {
    let row = try head(mem::page_allocator());
    print(row[0]);
    return;
}

// check-fails
// features: typed_view borrow mutable-borrow slice
// error: cannot escape
