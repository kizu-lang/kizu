import std::array;
import std::mem;

fn take_first(values: &array::Array<i64>) -> !i64 {
    return try values.remove(0);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try values.append(allocator, 1);
    print(try take_first(&values));
    return;
}

// check-fails
// features: std-array remove mutable-borrow
// error: `Array.remove` requires mutable Array receiver
