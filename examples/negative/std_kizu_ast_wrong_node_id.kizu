fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let left_source = std::kizu::ast::source_file("left.kizu", "left");
    let right_source = std::kizu::ast::source_file("right.kizu", "right");
    var left_ast = std::kizu::ast::Ast(allocator, left_source);
    var right_ast = std::kizu::ast::Ast(allocator, right_source);
    let right_node = right_ast.add_empty(0);
    let node = left_ast.get(right_node);
    print(node.span.start);
    return;
}
