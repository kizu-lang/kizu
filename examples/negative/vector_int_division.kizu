// Lane-wise division exists for float lanes only; no target divides integer
// lanes in one instruction.
fn main() -> void {
    let v = i32x4 { 8, 6, 4, 2 }
    / i32x4 { 2, 2, 2, 2 };
    print(cast<i64>(v[0]));
    return;
}

// check-fails
// features: vector simd
// error: operator `/` on a vector expects float lanes
