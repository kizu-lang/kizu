struct Inner {
    x: i64,
}

struct Outer {
    inner: Inner,
}

// Mutability flows through the whole field chain: `o.inner.x` writes `o`,
// so an immutable base refuses the nested spelling the way it refuses the
// direct one.
fn main() -> void {
    let o = Outer { inner: Inner { x: 1 } };
    o.inner.x = 2;
}

// check-fails
// features: struct field assignment
// error: cannot assign field of immutable binding `o`
