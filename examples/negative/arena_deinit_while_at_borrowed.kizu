import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    errdefer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    let user = users.at(alice);
    users.deinit(allocator);
    print(user.name);
    return;
}

// check-fails
// features: arena borrow deinit
// error: cannot run while arena is borrowed
