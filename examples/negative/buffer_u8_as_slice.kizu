// A buffer of u8 is bytes, and its view is `as_bytes`, the same entry a
// String has; `as_slice` is for every other element.
fn main() -> void {
    var bytes = [4]u8{};
    let view = bytes.as_slice();
    print(view[0]);
    return;
}

// check-fails
// features: stack_buffer typed_view
// error: type error: `[4]u8` has no `as_slice`; a buffer of u8 is viewed with `as_bytes`
