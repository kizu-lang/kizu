import std::array;
import std::json;
import std::mem;
import std::string;

pub struct Bag {
    pub items: array::Array<i64>,
}

fn (self: Bag) deinit() -> void {
    self.items.deinit();
}

// `encode<T>` walks a closed set of types. A type outside it is refused where
// it is written, at compile time: a JSON encoder that silently emitted nothing
// for a field would produce a document that is wrong in a way no test of the
// encoder itself would catch.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit();
    var bag = Bag { items: array::new<i64>(allocator) };
    defer bag.deinit();
    try json::encode<Bag>(allocator, bag, out);
    let bytes = out.as_bytes();
    print(bytes);
    return;
}

// check-fails
// features: std-json std-meta comptime diagnostics
// error: does not support type `std::array::Array<i64>`
