import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    text = string::new(allocator);
    text.deinit();
    return;
}

// check-fails
// features: std-string ownership linear-consume
// error: owned value `text` is overwritten before cleanup
