import std::array;
import std::mem;

// A shared `&` borrow is not a mutable place, so at_mut through it refuses.
fn bump(items: &array::Array<i64>) -> void {
    if items.at_mut(0) |v| {
        v.* = 8;
    }
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var items = array::new<i64>(allocator);
    defer items.deinit();
    try items.append(7);
    bump(items);
    return;
}

// check-fails
// features: std-array borrow optional mutability
// error: Array.at_mut` requires mutable array binding
