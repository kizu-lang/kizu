import std::arena;
import std::mem;

struct User {
    name: []u8,
}

struct Registry {
    users: arena::Arena<User>,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    let registry = Registry { users: users };
    registry.users.deinit();
}

// check-fails
// features: arena deinit
// error: field cleanup `registry.users.deinit` is only allowed inside owner deinit
