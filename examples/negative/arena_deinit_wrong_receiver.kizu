struct User {
    name: []u8,
}

struct Registry {
    users: std::arena::Arena<User>,
}

fn main() {
    let allocator = std::mem::page_allocator();
    let users = std::arena::Arena<User>(allocator);
    let registry = Registry { users: users };
    registry.users.deinit();
}

// check-fails
// features: arena deinit
// error: field cleanup `registry.users.deinit` is only allowed inside owner deinit
