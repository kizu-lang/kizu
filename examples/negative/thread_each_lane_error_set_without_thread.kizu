import std::mem;
import std::thread;

error Failure = mem::Error;

fn nothing(lane: &var []i64, index: i64) -> Failure!void {
    return;
}

// A lane round can itself run out of memory for the runs it gathers lanes
// into, and says so with std::thread::Error. The set it returns is the
// worker's, so that set has to hold std::thread::Error too.
fn run(pool: &var thread::Pool, allocator: Allocator, cells: &var []i64) -> Failure!void {
    try thread::each_lane<i64, Failure>(pool, allocator, cells, 2, 2, nothing);
    return;
}

fn main() -> void {
    return;
}

// check-fails
// features: thread error-set
// error: `std::thread::each_lane` needs its error set `Failure` to include std::thread::Error
