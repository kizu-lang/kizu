import std::mem;
import std::string;

// The success path cleans up, but the `try` can exit first and nothing covers
// `text` on that path. `defer` or `errdefer` before the `try` fixes it.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    try text.append_bytes("hi");
    text.deinit(allocator);
    return;
}

// check-fails
// features: std-string ownership linear-consume error-path
// error: owned value `text` would leak on this `try`'s error exit
