import std::mem;
import std::string;

pub struct Visitor {
    pub nick: ?string::String,
}

// A `while` condition reads the same storage every turn, so nothing about the
// field changes when the body releases what it found: the second turn would
// release it again. Opening an owner field to consume it is `if`.
fn (self: Visitor) deinit(allocator: Allocator) -> void {
    while self.nick |held| {
        held.deinit(allocator);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var visitor = Visitor { nick: null };
    defer visitor.deinit(allocator);
    return;
}

// check-fails
// features: optional owner diagnostics
// error: `while` cannot consume owner field `self.nick`
