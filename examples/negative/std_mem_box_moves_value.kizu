import std::mem;

struct Item {
    value: i64,
}

fn (self: Item) deinit() -> void {
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let value = Item { value: 1 };
    let item_result = mem::box<Item>(allocator, value);
    let item = try item_result;
    print(value.value);
    item.deinit();
    return;
}

// check-fails
// features: std-mem box move
// error: moved value `value` was used
