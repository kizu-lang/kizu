import std::map;
import std::mem;

fn define(allocator: Allocator, symbols: &map::Map<[]u8, i64>) -> !void {
    try symbols.insert(allocator, "main", 1);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let symbols = map::new<[]u8, i64>(allocator);

    try define(allocator, &symbols);

    symbols.deinit(allocator);
    return;
}

// check-fails
// features: std-map borrow mutation
// error: requires mutable Map receiver
