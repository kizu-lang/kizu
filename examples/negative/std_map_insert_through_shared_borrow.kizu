fn define(symbols: &std::map::Map<[]const u8, i64>) -> !void {
    try symbols.insert("main", 1);
    return void;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let symbols = std::map::Map<[]const u8, i64>(allocator);

    try define(&symbols);

    symbols.deinit();
    return void;
}
