import std::mem;
import std::string;

error Failure { Boom }

fn go(allocator: Allocator) -> !void {
    let name = try string::from_bytes(allocator, "abc");
    defer name.deinit(allocator);
    errdefer name.deinit(allocator);
    return Failure::Boom;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    try go(allocator);
    return;
}

// check-fails
// features: defer errdefer ownership
// error: already has a registered `defer` cleanup
