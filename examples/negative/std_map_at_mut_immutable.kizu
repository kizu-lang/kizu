import std::map;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit(allocator);

    try counts.insert("kizu", 1);
    if counts.at_mut("kizu") |count| {
        count.* = 2;
    }
    return;
}

// check-fails
// features: std-map mutable-borrow
// error: requires mutable map binding
