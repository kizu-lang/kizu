// `unsafe fn(...)` is a different type from `fn(...)`, so an unsafe function
// cannot reach a safe call by being handed through a pointer. The marker is
// required exactly where a direct call would require it.

/// 呼び出し側は value が 0 以上であることを保証する。
unsafe fn risky(value: i64) -> i64 {
    return value + 1;
}

fn call_it(f: unsafe fn(i64) -> i64, value: i64) -> i64 {
    return f(value);
}

fn main() -> void {
    print(call_it(risky, 41));
}

// check-fails
// features: function-pointer unsafe diagnostics
// error: call through `f` requires `unsafe`
