import std::arena;
import std::mem;

struct UserArena {}

struct User {
    visits: i64,
}

// `add` grows storage by realloc, which moves every element a live borrow
// points into, so it waits for the at_mut capture to end.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var users = arena::new<User, UserArena>(allocator);
    errdefer users.deinit(allocator);
    let alice = try users.add(allocator, User { visits: 0 });
    if users.at_mut(alice) |u| {
        let _ = try users.add(allocator, User { visits: 1 });
        u.visits = 1;
    }
    users.deinit(allocator);
    return;
}

// check-fails
// features: arena mutable-borrow
// error: Arena.add` cannot run while arena is borrowed
