import std::io;
import std::mem;

struct HeldIo {
    handle: Io,
}

fn use_io(handle: Io, allocator: Allocator, state: HeldIo) -> void {
    print(state.handle == handle);
    return;
}

fn main() -> !void {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var tasks = try io::task_set_new(handle, allocator);
    defer tasks.deinit(allocator);
    let state = HeldIo { handle: handle };
    try io::spawn<HeldIo>(&var tasks, use_io, state);
    return;
}

// check-fails
// features: io task-set ownership capability
// error: `std::io::spawn` state `HeldIo` must own its data and contain no Io or Allocator
