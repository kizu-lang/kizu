import std::array;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::Array<i64>(allocator);
    defer values.deinit();

    values.get_or_panic(0);
    return;
}

// run-fails
// features: std-array bounds-check trap
// error: index out of bounds
