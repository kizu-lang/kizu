import std::mem;
import std::string;

struct Visitor {
    name: string::String,
}

fn (self: Visitor) deinit(allocator: Allocator) -> void {
    for 0..2 |_| {
        self.name.deinit(allocator);
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let visitor = Visitor { name: try string::from_bytes(allocator, "abc") };
    visitor.deinit(allocator);
    return;
}

// check-fails
// features: for ownership deinit
// error: inside a loop
