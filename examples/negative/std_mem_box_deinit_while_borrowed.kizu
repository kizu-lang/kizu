struct Item {
    value: i64;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let value = Item { value: 1 };
    let item_result = std::mem::Box<Item>(allocator, value);
    let item = try item_result;
    let borrowed = item.borrow();
    item.deinit();
    print(borrowed.value);
    return;
}
