import std::mem;

struct Item {
    value: i64,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let value = Item { value: 1 };
    let item = try mem::box<Item>(allocator, value);
    let borrowed = item.borrow();
    item.deinit(allocator);
    print(borrowed.value);
    return;
}

// check-fails
// features: std-mem box borrow-check
// error: cannot run while box is borrowed
