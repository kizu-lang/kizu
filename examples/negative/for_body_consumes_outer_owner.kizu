import std::mem;
import std::string;

fn take(allocator: Allocator, name: string::String) -> void {
    name.deinit(allocator);
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let name = try string::from_bytes(allocator, "abc");
    for 0..3 |_| {
        take(allocator, move name);
    }
    return;
}

