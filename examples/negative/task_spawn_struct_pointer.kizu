extern "c" fn source() -> ptr<i64>

struct Cell {
    raw: ptr<i64>,
}

fn load(io: Io, cell: Cell) -> void {
    print(cell.raw);
}

fn main() -> void {
    let io = std::io::blocking();
    let group = std::task::Group(io);
    unsafe {
        let cell = Cell { raw: source() };
        let task = group.spawn(load, cell);
        task.cancel();
    }
}
