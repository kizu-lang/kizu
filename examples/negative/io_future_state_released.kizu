import std::io;
import std::mem;
import std::string;

fn shout(handle: Io, allocator: Allocator, held: &var string::String) -> void {
    print(held.len());
    return;
}

// A Future stands on the state it was lent until the worker is done with it.
// Releasing that state first would leave the worker holding freed memory, so
// the lend is a borrow that lasts as long as the Future does.
fn main() -> !void {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_bytes(allocator, "alice");
    var future = try io::async<string::String>(
        handle, allocator, shout, &var name);
    name.deinit(allocator);
    future.deinit(allocator);
    return;
}

// check-fails
// features: io async borrow
// error: `String.deinit` cannot run while string is borrowed
