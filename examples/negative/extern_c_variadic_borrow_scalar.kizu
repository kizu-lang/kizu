// A variadic argument lends an `extern "c" struct` and nothing else. A value
// C writes through a pointer is declared as a field of one.
extern "c" fn sscanf(text: ptr<const u8>, format: ptr<const u8>, ...) -> i32
fn main() -> void {
    var count: i32 = 0;
    // SAFETY: the format writes one int.
    unsafe sscanf(c"42", c"%d", &var count);
    return;
}

// check-fails
// features: extern-c mutable-borrow diagnostic
// error: arg 3 of `sscanf` borrows i32, which a C variadic argument cannot carry
