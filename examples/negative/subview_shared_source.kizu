import std::array;
import std::mem;

fn fill(row: &var []i64, value: i64) -> void {
    row[0] = value;
    return;
}

// A range can be lent for writing only out of a writable view: a read-only
// view says nothing about whether its backing may be written.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = array::new<i64>(allocator);
    defer counts.deinit(allocator);
    try counts.append(allocator, 1);
    let view = counts.as_slice();
    fill(&var view[0..1], 2);
    return;
}

// check-fails
// features: typed_view borrow mutable-borrow slice
// error: needs a writable view binding
