import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, "abcdef");
    let view = text.as_bytes();
    let tail = view[1..];
    text.deinit(allocator);
    print(tail);
    return;
}

