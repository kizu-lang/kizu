import std::mem;
import std::string;

fn build(allocator: Allocator) -> !string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_byte(allocator, cast<u8>(97));
    return move out;
}

// A call result may receive a by-value method only when it is a copy value:
// an owner temporary would have nobody to release it, so it must be bound.
fn main() -> !void {
    let allocator = mem::page_allocator();
    print((try build(allocator)).len());
    return;
}

// check-fails
// features: method ownership call-result-receiver std-string
// error: method receiver must be a local binding or a field path
