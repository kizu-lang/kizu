struct Owned {
    n: i64,
}

fn (self: Owned) deinit() -> void {
    return;
}

// A capture through the borrow would take the owner out of the caller's
// optional, which would go on saying it holds one.
fn take(slot: &var ?Owned) -> void {
    if slot |owned| {
        owned.deinit();
    }
    return;
}

fn main() -> void {
    var held: ?Owned = null;
    take(&var held);
    return;
}

// check-fails
// features: optional borrow ownership diagnostics
// error: type error: parameter `slot` cannot borrow `?Owned`; only an optional of copy data (`?i64`, an enum, a handle, a plain struct) can be borrowed, because a capture through the borrow would move the payload out of the caller's optional
