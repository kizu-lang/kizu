/// data は少なくとも len バイトの有効なメモリを指す。
unsafe struct Buf {
    data: ptr<u8>,
    len: usize,
}

fn set(x: &var usize, n: usize) -> void {
    x = n;
}

fn shrink(b: &var Buf, n: usize) -> void {
    set(&var b.len, n);
}

// check-fails
// features: unsafe-struct raw-pointer borrow
// error: mutable borrow of field `Buf.len` requires `unsafe`
