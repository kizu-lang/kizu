fn view(text: &std::string::String) -> []u8 {
    return text.as_bytes();
}

fn main() {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    let bytes = view(text);
    print(bytes);
}

// check-fails
// features: std-string borrow escape
// error: String.as_bytes` must be bound
