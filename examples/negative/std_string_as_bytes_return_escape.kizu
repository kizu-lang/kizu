import std::mem;
import std::string;

fn view(text: &string::String) -> []u8 {
    return text.as_bytes();
}

fn main() {
    let allocator = mem::page_allocator();
    var text = string::new(allocator);
    let bytes = view(text);
    print(bytes);
}

// check-fails
// features: std-string borrow escape
// error: String.as_bytes` must be bound
