import std::mem;
import std::string;

fn same<T>(value: T) -> T {
    return value;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try string::from_bytes(allocator, "abc");
    let view = text.as_bytes();
    let kept = same<[]u8>(view);
    text.deinit(allocator);
    print(kept);
    return;
}

