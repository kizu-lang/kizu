import std::mem;
import std::string;

fn maybe(value: i64) -> ?i64 {
    if value > 1 {
        return null;
    }
    return value;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var count = 0;
    while count < 3 {
        let name = try string::from_bytes(allocator, "abc");
        let value = maybe(count) orelse break;
        print(value);
        name.deinit(allocator);
        count = count + 1;
    }
    return;
}

// check-fails
// features: while optional orelse ownership
// error: owned value `name`
