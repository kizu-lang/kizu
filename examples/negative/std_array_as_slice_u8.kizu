import std::array;
import std::mem;

// Bytes are owned by `String`, whose view is `as_bytes`; an Array<u8> has no
// slice view, the same rule as `[N]u8` (SPEC §7.1).
fn main() -> !void {
    let allocator = mem::page_allocator();
    var bytes = array::new<u8>(allocator);
    defer bytes.deinit(allocator);
    try bytes.append(allocator, cast<u8>(1));
    let view = bytes.as_slice();
    print(mem::count<u8>(view));
    return;
}

// check-fails
// features: std-array typed_view
// error: has no `as_slice`
