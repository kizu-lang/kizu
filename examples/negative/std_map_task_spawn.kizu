fn use_symbols(io: Io, symbols: std::map::Map<[]u8, i64>) -> void {
    print(symbols.len());
}

fn main() {
    let io = std::io::blocking();
    let group = std::task::Group(io);
    let allocator = std::mem::page_allocator();
    let symbols = std::map::Map<[]u8, i64>(allocator);
    let task = group.spawn(use_symbols, symbols);
    task.cancel();
}
