import std::array;
import std::mem;

// Growing may move the storage a live view points into, so the Array waits
// for the view's last use.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = array::new<i64>(allocator);
    defer counts.deinit(allocator);
    try counts.append(allocator, 3);
    let view = counts.as_slice();
    try counts.append(allocator, 4);
    print(view[0]);
    return;
}

// check-fails
// features: std-array typed_view borrow
// error: borrowed
