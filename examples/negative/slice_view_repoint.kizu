import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    defer name.deinit(allocator);
    try name.append_bytes(allocator, "kizu");
    let view = name.as_mut_bytes();
    view.* = "other";
    view[0] = 75;
    return;
}

// check-fails
// features: mutable-slice-view
// error: `view.*` cannot re-point a slice view; write elements with `view[i] = ...`
