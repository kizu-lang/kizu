import std::map;
import std::mem;
import std::string;

// get copies the value out of the map, which would leave two owners of the
// same bytes. An owner value leaves through the at/at_mut borrows instead.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var names = map::new<[]u8, string::String>(allocator);
    defer names.deinit(allocator);

    var name = string::new(allocator);
    errdefer name.deinit(allocator);
    try name.append_bytes("alice");
    try names.insert("first", name);

    if names.get("first") |held| {
        print(held.as_bytes());
    }
    return;
}

// check-fails
// features: std-map owner type-check
// error: `Map.get` requires copy value
