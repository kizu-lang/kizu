import std::arena;
import std::mem;

struct Node {
    value: i64,
}

// Both trees buy their node storage here, so the two arenas are the same
// arena in the source and tell themselves apart only at run time.
fn new_nodes(allocator: Allocator) -> arena::Arena<Node> {
    return arena::new<Node>(allocator);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var left = new_nodes(allocator);
    defer left.deinit(allocator);
    var right = new_nodes(allocator);
    defer right.deinit(allocator);
    let first = try left.add(allocator, Node { value: 1 });
    let second = try right.add(allocator, Node { value: 2 });
    print(left.at(first).value);
    print(right.at(second).value);
    // `first` names an element of `left`. It is in range for `right` as well,
    // so a read that did not ask which arena made it would answer 1 here and
    // never say anything was wrong.
    print(right.at(first).value);
    return;
}

// run-fails
// features: arena handle
// error: runtime error: invalid arena handle
