import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::Arena<User>(allocator);
    users.deinit();
    users.add(User { name: "alice" });
}

// check-fails
// features: arena deinit
// error: arena `users` was deinitialized
