import std::fs;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let text = try fs::read_file(
        "examples/fixtures/config.txt", allocator, "unused", mem::Limit::Unlimited);
    defer text.deinit();
    return;
}

