// C reads a struct through a pointer only when the struct has the layout C
// gives it. A Kizu struct promises no layout, so it cannot be lent to a
// variadic argument; `extern "c" struct` is the declaration that can.
struct Point {
    x: i32,
    y: i32,
}

extern "c" fn printf(format: ptr<const u8>, ...) -> i32
fn main() -> void {
    let point = Point { x: 1, y: 2 };
    // SAFETY: the format reads one pointer.
    unsafe printf(c"%p", &point);
    return;
}

// check-fails
// features: extern-c borrow diagnostic
// error: arg 2 of `printf` borrows Point, which a C variadic argument cannot carry
