import std::array;
import std::mem;
import std::string;

// A registered cleanup releases the value that was live when it was written,
// not whatever the name later stands for. Assigning over `name` would leave the
// `errdefer` above holding the string `parent` now owns. Bind the second string
// to its own name instead -- `var second = string::new(allocator);` with its own
// `errdefer` -- so one name means one value with one cleanup.
fn build(allocator: Allocator) -> !array::Array<string::String> {
    var parent = array::new<string::String>(allocator);
    errdefer parent.deinit();     // covers parent until this function returns it

    var name = string::new(allocator);
    errdefer name.deinit();           // covers this string, and only this one
    try name.append_byte(cast<u8>(97));
    try parent.append(move name);          // retires it: parent owns that string now

    name = string::new(allocator);    // rejected: the errdefer above named the first
    try name.append_byte(cast<u8>(98));
    try parent.append(name);
    return parent;
}

fn main() -> !void {
    var values = try build(mem::page_allocator());
    defer values.deinit();
    print(values.len());
    return;
}

// check-fails
// features: errdefer move assignment ownership std-array std-string
// error: `errdefer` cleanup receiver `name` cannot be assigned over
