import std::mem;
import std::string;

struct User {
    pub age: i64,
    pub nick: ?i64,
}

// Each field binds its own instance of this body, and each is checked: the
// branch an optional field selects hands `text` off without `move`, and that
// is reported although the instance `age` binds was checked first and is fine.
fn label<T, f: Field>(allocator: Allocator) -> string::String {
    let text = string::new(allocator);
    comptime if std::meta::is_optional<std::meta::field_type<T, f>>() {
        return text;
    } else {
        return move text;
    }
}

fn main() -> void {
    let allocator = mem::page_allocator();
    let first = label<User, age>(allocator);
    defer first.deinit(allocator);
    let second = label<User, nick>(allocator);
    defer second.deinit(allocator);
    print(first.len() + second.len());
}

// check-fails
// features: comptime static-params field-static-param ownership move
// error: `text` is handed off here; write `move text`
