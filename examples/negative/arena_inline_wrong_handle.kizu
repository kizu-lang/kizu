import std::arena;
import std::mem;

struct Left {}
struct Right {}

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let left = arena::new<User, Left>(allocator);
    defer left.deinit(allocator);
    let right = arena::new<User, Right>(allocator);
    defer right.deinit(allocator);
    print(right.at(try left.add(allocator, User { name: "alice" })).name);
    return;
}

// check-fails
// features: arena handle
// error: `Arena.at` expects std::arena::Handle<User, Right>, got std::arena::Handle<User, Left>
