import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let left = arena::Arena<User>(allocator);
    let right = arena::Arena<User>(allocator);
    print(right.get(left.add(User { name: "alice" })).name);
}

// check-fails
// features: arena handle
// error: handle from `left` does not belong to arena `right`
