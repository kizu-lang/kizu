import std::mem;
import std::string;

// `Bag` declares no `deinit`, so it gets the derived one. That does not make it
// less of an owner: holding a `String` is what the obligation is, and the value
// still has to be consumed before the block ends.
struct Bag {
    name: string::String,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let bag = Bag { name: string::new(allocator) };
    print(bag.name.len());
    return;
}

// check-fails
// features: ownership deinit derived
// error: owned value `bag` is never deinitialized
