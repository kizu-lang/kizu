struct Counter {
    count: i64,
}

fn (self: &var Counter) bump() -> void {
    self.count = self.count + 1;
    return;
}

fn fresh() -> Counter {
    return Counter { count: 0 };
}

// A call result may receive a by-value method, but a `&var self` method
// writes through to a place, and a temporary has none to write to.
fn main() -> void {
    fresh().bump();
    return;
}

// check-fails
// features: method mutable-borrow call-result-receiver
// error: requires a local or direct field receiver
