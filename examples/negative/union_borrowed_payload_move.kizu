struct Payload {
    value: i64,
}

fn (self: Payload) deinit(allocator: Allocator) -> void {
}

union Node {
    Made(Payload),
    Empty,
}

fn (self: Node) deinit(allocator: Allocator) -> void {
    match self {
        Made(payload) => payload.deinit(allocator),
        Empty => {},
    }
}

fn take(node: &Node) -> Payload {
    return match node {
        Made(payload) => payload,
        Empty => Payload { value: 0 },
    };
}

// check-fails
// features: union match borrow
// error: borrowed value `payload` cannot escape
