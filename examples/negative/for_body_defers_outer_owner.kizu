import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let name = try string::from_bytes(allocator, "abc");
    for 0..3 |_| {
        defer name.deinit(allocator);
        print(name.len());
    }
    return;
}

