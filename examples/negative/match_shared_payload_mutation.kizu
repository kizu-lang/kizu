import std::mem;
import std::string;

union Stream {
    Plain(string::String),
    Secure(string::String),
}

// A match through a shared borrow binds its payload as a shared borrow too:
// only a `&var` place hands the payload over mutably (SPEC §6.8).
fn (self: &Stream) push(allocator: Allocator, byte: u8) -> mem::Error!void {
    match self {
        Plain(s) => {
            try s.append_byte(allocator, byte);
        },
        Secure(s) => {},
    }
    return;
}

fn main() -> void {
    return;
}

// check-fails
// features: match union borrow mutable-borrow
// error: requires mutable String receiver
