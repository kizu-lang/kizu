import std::array;
import std::mem;

// A writable view needs a writable place: a shared borrow of the Array is
// not one.
fn bump(values: &array::Array<i64>) -> void {
    let cells = values.as_mut_slice();
    cells[0] = 1;
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = array::new<i64>(allocator);
    defer counts.deinit(allocator);
    try counts.append(allocator, 0);
    bump(&counts);
    print(counts.get_or_panic(0));
    return;
}

// check-fails
// features: std-array typed_view mutable-borrow
// error: requires mutable Array binding
