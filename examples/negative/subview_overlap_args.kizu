fn copy_first(into: &var []i64, from: &var []i64) -> void {
    into[0] = from[0];
    return;
}

// Two ranges of one view cannot be lent for writing in one call, even when
// the ranges are disjoint: the borrow is of the whole view, since which
// elements two ranges share is not something the checker proves.
fn main() -> !void {
    var buf = [4]i64{};
    let cells = buf.as_mut_slice();
    copy_first(&var cells[0..2], &var cells[2..4]);
    return;
}

// check-fails
// features: typed_view borrow mutable-borrow slice
// error: cannot be borrowed while mutably borrowed
