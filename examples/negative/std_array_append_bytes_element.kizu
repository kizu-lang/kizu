import std::array;
import std::mem;

// A byte run only spells the elements of a u8 array. Any other element type
// would have to say how many elements the run stands for, so the method is
// refused rather than given a second meaning.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var values = array::new<i64>(allocator);
    defer values.deinit();
    try values.append_bytes("alice");
    return;
}

// check-fails
// features: std-array append-bytes
// error: `Array.append_bytes` requires Array<u8>
