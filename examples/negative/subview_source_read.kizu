fn first(v: []i64) -> i64 {
    return v[0];
}

// While a range of `v` is lent for writing, `v` itself is mutably borrowed:
// reading it would alias what the range may be writing.
fn bump(v: &var []i64) -> i64 {
    let row = &var v[0..2];
    let seen = first(v);
    row[0] = seen + 1;
    return seen;
}

fn main() -> !void {
    var buf = [4]i64{};
    let cells = buf.as_mut_slice();
    print(bump(cells));
    return;
}

// check-fails
// features: typed_view borrow mutable-borrow slice
// error: cannot be read while mutably borrowed
