import std::string;

// `Sealed` declares its own `deinit`, so it holds an obligation that is not any
// field's -- the count it keeps in step with the string. Consuming fields one
// at a time never discharges that, so the value is taken whole.
struct Sealed {
    text: string::String,
    count: i64,
}

fn (self: Sealed) deinit(allocator: Allocator) -> void {
    print(self.count);
    self.text.deinit(allocator);
}

fn steal(sealed: Sealed) -> string::String {
    return move sealed.text;
}

fn main() -> void {
    return;
}

// check-fails
// features: ownership field-move diagnostic
// error: `Sealed` declares its own deinit and is consumed whole
