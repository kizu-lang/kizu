import std::mem;
import std::string;

union Stream {
    Plain(string::String),
    Secure(string::String),
}

struct Holder {
    stream: Stream,
}

fn (self: &Stream) len() -> i64 {
    return match self {
        Plain(s) => s.len(),
        Secure(s) => s.len(),
    };
}

// The payload of a match through a `&var` place is a `&var` borrow of that
// place for the whole arm, so the place cannot be read beside it (SPEC §6.8).
fn (self: &var Holder) push(allocator: Allocator, byte: u8) -> mem::Error!void {
    match self.stream {
        Plain(s) => {
            let before = self.stream.len();
            try s.append_byte(allocator, byte);
            print(before);
        },
        Secure(s) => {},
    }
    return;
}

fn main() -> void {
    return;
}

// check-fails
// features: match union borrow mutable-borrow
// error: cannot be read while mutably borrowed
