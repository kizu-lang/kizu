error FsError {
    NotFound,
}

error NetError {
    Timeout,
}

fn read() -> FsError!i64 {
    return FsError::NotFound;
}

fn main() -> void {
    if read() |value| {
        print(value);
    } else |err| {
        // The two sets share no member, so no value of one is a value of the
        // other: there is nothing for `==` to compare.
        print(err == NetError::Timeout);
    }
    return;
}

// check-fails
// features: error-set type-check
// error: type error: operator `==` operands must have same type
