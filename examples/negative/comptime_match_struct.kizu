pub struct Point {
    pub x: i64,
    pub y: i64,
}

// `comptime match` walks the variant a value holds, and a struct holds no
// variant: every field is there at once. Walking one is `comptime for` over
// its fields, which is a different question with a different answer.
fn show<T>(value: &T) -> void {
    comptime match value |v| {
        print(std::meta::variant_name<T, v>());
    }
    return;
}

fn main() -> void {
    let point = Point { x: 1, y: 2 };
    show<Point>(&point);
    return;
}

// check-fails
// features: comptime-match std-meta reflection diagnostics
// error: comptime match expects an enum or union
