import std::array;
import std::mem;

fn total(values: []i64) -> i64 {
    var sum = 0;
    for 0..mem::count<i64>(values) |i| {
        sum = sum + values[i];
    }
    return sum;
}

// A view is bound with `let` so the borrow it holds has a name and an end;
// passed straight into a call it would have neither.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = array::new<i64>(allocator);
    defer counts.deinit(allocator);
    try counts.append(allocator, 3);
    print(total(counts.as_slice()));
    return;
}

// check-fails
// features: std-array typed_view borrow
// error: must be bound with `let name = array.as_slice()`
