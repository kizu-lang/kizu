// A `[]u8` is a pointer and a length, and C reads one value per argument. A
// string goes to a variadic function as a `c"..."` literal or a raw pointer.
extern "c" fn printf(format: ptr<const u8>, ...) -> i32
fn main() -> void {
    // SAFETY: the format reads one string.
    unsafe printf(c"%s", "alice");
    return;
}

