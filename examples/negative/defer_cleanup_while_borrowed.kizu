import std::array;
import std::mem;

struct User {
    name: []u8,
}

fn show(users: &array::Array<User>) {
    print(users.len());
}

// Cleanups run in reverse: the deinit runs first, and the cleanup registered
// before it still reads the borrow afterwards.
fn main() {
    let allocator = mem::page_allocator();
    let users = array::new<User>(allocator);
    let borrowed = &users;
    defer show(borrowed);
    defer users.deinit(allocator);
}

// check-fails
// features: defer borrow deinit
// error: cannot run while array is borrowed
