import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn main() {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    let borrowed = &users;
    defer users.deinit(allocator);
    while false {
        print(borrowed);
    }
}

// check-fails
// features: defer borrow deinit
// error: cannot run while arena is borrowed
