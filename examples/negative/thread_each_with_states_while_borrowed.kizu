import std::array;
import std::io;
import std::mem;
import std::thread;

fn count(state: &var i64, chunk: &var []i64, index: i64) -> thread::Error!void {
    state.* = state.* + 1;
    return;
}

// The states are lent to the round like the data is, so the data cannot be
// a view of the same Array: one thread's state would be another's chunk.
fn main() -> thread::Error!void {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 2);
    defer pool.deinit(allocator);
    var states = array::new<i64>(allocator);
    defer states.deinit(allocator);
    let data = states.as_mut_slice();
    try thread::each_with<i64, i64, thread::Error>(&var pool, data, 1, &var states, count);
    return;
}

// check-fails
// features: thread ownership
// error: value `states` cannot be borrowed while mutably borrowed
