import std::io;
import std::mem;

fn make_tasks(handle: Io, allocator: Allocator) -> io::Error!io::TaskSet {
    return io::task_set_new(handle, allocator);
}

fn start() -> !io::TaskSet {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();
    let tasks = try make_tasks(handle, allocator);
    return move tasks;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var tasks = try start();
    tasks.deinit(allocator);
    return;
}

// check-fails
// features: io evented task-set borrow
// error: TaskSet `tasks` cannot outlive its Io or allocator
