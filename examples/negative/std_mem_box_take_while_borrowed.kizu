import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let boxed = try mem::box<i64>(allocator, 42);
    let borrowed = boxed.borrow();
    let value = boxed.take();
    print(borrowed);
    print(value);
    return;
}

// check-fails
// features: std-mem box take borrow
// error: `Box.take` cannot run while box is borrowed
