error ParseError { Empty }

fn check(value: i64) -> ParseError!void {
    return;
}

fn run_all<E>(f: fn(i64) -> E!void, n: i64) -> E!void {
    for 0..n |i| {
        try f(i);
    }
    return;
}

// The static argument that stands for the set of `E!void` has to be an error
// set. `i64!void` is not a type the source could write, so the instance is
// not one either.
fn main() -> !void {
    try run_all<i64>(check, 2);
    return;
}

// check-fails
// features: generics error-set
// error: the error of `E!T` must be an `error` set, got `i64`
