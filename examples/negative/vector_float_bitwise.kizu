// Bitwise operators on vectors are defined only for integer lanes, not float lanes.
fn main() -> void {
    let a = f32x4 { 1.0, 2.0, 3.0, 4.0 };
    let b = a & a;
    print(cast<i64>(b[0]));
    return;
}

// check-fails
// features: vector simd
// error: operator `&` on a vector expects integer lanes, got f32x4
