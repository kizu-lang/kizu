// C widens a `float` to `double` when it is passed as a variadic argument.
// Kizu converts nothing the source does not spell, so the call says
// `cast<f64>`.
extern "c" fn printf(format: ptr<const u8>, ...) -> i32
fn main() -> void {
    let ratio: f32 = 0.5;
    // SAFETY: the format reads one `double`.
    unsafe printf(c"%f", ratio);
    return;
}

// check-fails
// features: extern-c cast diagnostic
// error: arg 2 of `printf` has type f32, which C promotes in a variadic call and Kizu does not; write `cast<f64>(...)`
