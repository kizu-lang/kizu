import std::mem;
import std::string;

struct Echo {
    count: i64,
}

fn (self: &Echo) echo(bytes: []u8) -> []u8 {
    return bytes;
}

// The other half of the lend condition: a method whose return type carries a
// view could hand the lend back out, so the view stays unlendable even though
// the receiver holds none.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let echo = Echo { count: 0 };
    var text = string::new(allocator);
    defer text.deinit();
    try text.append_bytes("abc");
    let view = text.as_bytes();
    let out = echo.echo(view);
    print(out);
    return;
}

// check-fails
// features: borrow view method lend
// error: borrowed value `view` cannot escape
