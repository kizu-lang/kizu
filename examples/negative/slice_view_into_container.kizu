import std::array;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var parts = array::new<[]u8>(allocator);
    defer parts.deinit(allocator);
    let text = try string::from_bytes(allocator, "abcdef");
    defer text.deinit(allocator);
    let view = text.as_bytes();
    try parts.append(allocator, view[1..]);
    return;
}

// check-fails
// features: slice view borrow std-array
// error: borrowed value `view` cannot escape
