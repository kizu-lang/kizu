import std::arena;
import std::mem;

struct Left {}
struct Right {}

struct User {
    name: []u8,
}

// The signature names one marker for both its arena and its handle, so a
// handle another arena made cannot reach it. The contract is the type, and it
// holds at every call site without the caller re-deriving anything.
fn show(users: &arena::Arena<User, Right>, h: arena::Handle<User, Right>) -> void {
    print(users.at(h).name);
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let a = arena::new<User, Left>(allocator);
    defer a.deinit(allocator);
    let b = arena::new<User, Right>(allocator);
    defer b.deinit(allocator);
    let h = try a.add(allocator, User { name: "alice" });
    show(&b, h);
    return;
}

// check-fails
// features: arena handle borrow
// error: expects std::arena::Handle<User, Right>, got std::arena::Handle<User, Left>
