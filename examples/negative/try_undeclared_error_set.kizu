error Failure { Bad }

// `!void` declares no error set, so what `anything` fails with cannot be
// checked against Failure, and `try` cannot hand it on.
fn anything() -> !void {
    return;
}

fn run() -> Failure!void {
    try anything();
    return;
}

fn main() -> void {
    return;
}

// check-fails
// features: error-set type-check
// error: try cannot propagate an error of !void into Failure!void: !void declares no error set, so its failures cannot be checked against it
