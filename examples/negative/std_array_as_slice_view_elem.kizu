import std::array;
import std::mem;

struct Label {
    pub text: []u8,
    pub weight: i64,
}

// A view element is copy data: a struct that holds a view would put a borrow
// into storage, so an Array of them has no view.
fn main() -> !void {
    let allocator = mem::page_allocator();
    var labels = array::new<Label>(allocator);
    defer labels.deinit(allocator);
    let view = labels.as_slice();
    print(mem::count<Label>(view));
    return;
}

// check-fails
// features: std-array typed_view ownership
// error: has no `as_slice`
