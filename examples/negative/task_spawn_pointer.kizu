extern "c" fn source() -> ptr<i64>

fn load(io: Io, p: ptr<i64>) -> !i64 {
    print(p);
    return 1;
}

fn main() -> !void {
    let io = Io();
    let group = std::task::Group();
    unsafe {
        let p = source();
        let task = group.spawn(io, load, p);
        let value = try task.await();
        print(value);
    }
    return void;
}
