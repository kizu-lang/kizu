extern "c" fn source() -> ptr<i64>

fn load(io: Io, p: ptr<i64>) -> !i64 {
    print(p);
    return 1;
}

fn main() -> !void {
    let io = std::io::blocking();
    let group = std::task::Group(io);
    unsafe {
        let p = source();
        let task = group.spawn(load, p);
        let value = try task.await();
        print(value);
    }
    return;
}
