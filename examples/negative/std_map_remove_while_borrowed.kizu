import std::map;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    var counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit(allocator);
    try counts.insert(allocator, "a", 1);
    if counts.at("a") |value| {
        if counts.remove(allocator, "a") |gone| {
            print(gone);
        }
        print(value.*);
    }
    return;
}

// check-fails
// features: std-map remove borrow
// error: `Map.remove` cannot run while map is borrowed
