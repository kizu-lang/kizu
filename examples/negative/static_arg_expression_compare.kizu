// A static expression is integer arithmetic. A comparison would produce a bool
// that no integer parameter takes, and the decision it expresses belongs in a
// `comptime if` in the body.
fn scaled<k: i64>() -> i64 {
    return k * 100;
}

fn main() -> void {
    print(scaled<(2 > 1)>());
}

// parse-fails
// features: comptime generics
// error: static argument expression `(2 > 1)` is not integer arithmetic (literals, names, and + - * / % only)
