struct User {
    name: []const u8;
}

fn load(io: Io, user: handle<User>) -> void {
    print(user);
}

fn main() -> void {
    let io = std::io::blocking();
    let users = arena<User>();
    let alice = users.add(User { name: "alice" });
    let group = std::task::Group(io);
    let task = group.spawn(load, alice);
    task.cancel();
}
