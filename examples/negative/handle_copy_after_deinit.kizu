import std::arena;
import std::mem;

struct User {
    name: []u8,
}

fn read(handle: arena::Handle<User>) -> void {
    let _ = handle;
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User>(allocator);
    errdefer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    let again = alice;
    users.deinit(allocator);
    read(again);
    return;
}

// check-fails
// features: arena handle deinit
// error: handle `again` cannot be used after arena `users` deinit
