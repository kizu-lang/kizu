import std::arena;
import std::mem;

struct UserArena {}

struct User {
    name: []u8,
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    let users = arena::new<User, UserArena>(allocator);
    errdefer users.deinit(allocator);
    let alice = try users.add(allocator, User { name: "alice" });
    let again = alice;
    users.deinit(allocator);
    print(again);
    return;
}

// check-fails
// features: arena handle deinit
// error: handle `again` cannot be used after arena `users` deinit
