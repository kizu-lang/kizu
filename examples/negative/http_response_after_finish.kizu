// A finished response is finished. `finish` says the message is complete, and
// everything that would change it fails afterwards -- so a second write
// cannot arrive behind a body the connection has already framed.
//
// This is a runtime refusal rather than a compile-time one because whether a
// response has been finished depends on what ran, not on what was written.
// The type system closes what it can (a released socket is gone), and this is
// the part it cannot.

import std::http;
import std::mem;

fn main() -> http::Failure!void {
    let allocator = mem::page_allocator();
    var response = http::response_new(allocator);
    defer response.deinit(allocator);
    try response.write(allocator, "the whole answer");
    response.finish();
    try response.write(allocator, "and one more thing");
    return;
}

// run-fails
// features: http error-union
// error: runtime error: std::http::Error::ResponseFinished
