fn load(io: Io, name: &[]const u8) -> !i64 {
    print(name);
    return 1;
}

fn main() -> !void {
    let io = std::io::blocking();
    let group = std::task::Group(io);
    let name = "config";
    let task = group.spawn(load, name);
    let value = try task.await();
    print(value);
    return;
}
