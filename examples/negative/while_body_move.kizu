struct Name {
    value: []u8,
}

fn take(name: Name) -> void {
    print(name.value);
}

fn main() -> void {
    let name = Name { value: "alice" };
    while true {
        take(name);
        break;
    }
    print(name.value);
}

// check-fails
// features: while move
// error: moved value `name` was used
