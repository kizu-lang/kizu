import std::array;
import std::io;
import std::mem;
import std::thread;

struct ViewCtx {
    items: []i64,
}

fn work(ctx: &ViewCtx, chunk: &var []i64, index: i64) -> thread::Error!void {
    return;
}

// A shared context cannot carry a view into the same Array being mutably
// partitioned by `each_shared`: one thread would read while another writes.
fn main() -> thread::Error!void {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 2);
    defer pool.deinit(allocator);
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    let view = values.as_slice();
    let ctx = ViewCtx { items: view };
    let data = values.as_mut_slice();
    try thread::each_shared<i64, ViewCtx, thread::Error>(&var pool, data, 1, &ctx, work);
    return;
}

// check-fails
// features: thread ownership
// error: value `values` cannot be mutably borrowed while borrowed
