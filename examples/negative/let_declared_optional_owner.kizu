import std::mem;
import std::string;

fn main() -> void {
    let allocator = mem::page_allocator();
    // A declared `?T` wraps the value, and an optional that wraps an owner
    // is consumed where it is produced, never kept in a binding.
    let text: ?string::String = string::new(allocator);
    if text |owned| {
        owned.deinit(allocator);
    }
    return;
}

// check-fails
// features: optional ownership diagnostics
// error: move error: optional `?std::string::String` must be consumed where it is produced (capture or orelse)
