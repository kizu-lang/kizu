import std::map;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let table = map::new<[]u8, i64>(allocator);
    defer table.deinit();

    print(try table.get("missing"));

    return;
}

// run-fails
// features: std-map error-union
// error: std::map::Error::Missing
