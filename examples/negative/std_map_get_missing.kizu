import std::map;
import std::mem;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let table = map::Map<[]u8, i64>(allocator);

    print(try table.get("missing"));

    table.deinit();
    return;
}

// run-fails
// features: std-map error-union
// error: std::map::Error::Missing
