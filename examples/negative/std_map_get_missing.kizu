import std::map;
import std::mem;

// A missing key is an optional miss, not an error: `try` no longer applies.
fn main() -> !void {
    let allocator = mem::page_allocator();
    let table = map::new<[]u8, i64>(allocator);
    defer table.deinit();

    print(try table.get("missing"));

    return;
}

// check-fails
// features: std-map optional diagnostics
// error: try expects !T, got ?i64
