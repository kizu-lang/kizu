import std::mem;
import std::string;

union Slot {
    Kept(string::String),
    Vacant
}

fn (self: Slot) deinit() -> void {
    match self {
        Kept(payload) => payload.deinit(),
        Vacant => {},
    }
    return;
}

// An empty arm is a no-op, so binding an owned payload into it drops the
// payload without cleanup.
fn discard(slot: Slot) -> void {
    match slot {
        Kept(payload) => {},
        Vacant => {},
    }
    return;
}

fn main() -> !void {
    let allocator = mem::page_allocator();
    var name = string::new(allocator);
    errdefer name.deinit();
    try name.append_bytes("kept");
    discard(Slot::Kept(name));
    return;
}

// check-fails
// features: match arm-empty union ownership
// error: owned value `payload` is never deinitialized
