struct Payload {
    value: i64,
}

union Node {
    Made(Payload),
    Empty,
}

fn first(node: Node) -> i64 {
    let kept = match node {
        Made(payload) => payload.value,
        Empty => 0,
    };
    let again = match node {
        Made(payload) => payload.value,
        Empty => 0,
    };
    return kept + again;
}

// check-fails
// features: union match move
// error: moved value `node` was used
