struct Payload {
    value: i64,
}

fn (self: Payload) deinit(allocator: Allocator) -> void {
}

union Node {
    Made(Payload),
    Empty,
}

fn (self: Node) deinit(allocator: Allocator) -> void {
    match self {
        Made(payload) => payload.deinit(allocator),
        Empty => {},
    }
}

fn consume_twice(allocator: Allocator, node: Node) -> void {
    match node {
        Made(payload) => payload.deinit(allocator),
        Empty => {},
    }
    match node {
        Made(payload) => payload.deinit(allocator),
        Empty => {},
    }
    return;
}

// check-fails
// features: union match move
// error: moved value `node` was used
