import std::array;
import std::mem;
import std::string;

fn main() -> !void {
    let allocator = mem::page_allocator();
    let nested = array::new<array::Array<string::String>>(allocator);
    defer nested.deinit_all();
    return;
}

// check-fails
// features: std-array ownership deinit-all
