struct User {
    pub name: []u8,
    age: i64,
}

// A `Field` argument names a public field. A private one is not part of what
// the type says about itself, so a walk that could reach it would read state
// the type did not publish.
fn label<T, f: Field>() -> []u8 {
    return std::meta::field_name<T, f>();
}

fn main() -> void {
    print(label<User, age>());
}

// check-fails
// features: comptime static-params field-static-param reflection struct
// error: `User` has no public field `age`
