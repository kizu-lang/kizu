enum SymbolKind {
    Function,
    Variable,
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let symbols = std::map::Map<[]u8, SymbolKind>(allocator);

    try symbols.insert("main", SymbolKind::Function);
    try symbols.insert("count", SymbolKind::Variable);

    print(try symbols.get("main"));
    print(symbols.contains("missing"));

    symbols.deinit();
    return;
}

// run
// features: std-map symbol-table enum
// output:
// SymbolKind::Function
// false
