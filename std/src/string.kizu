pub struct String {
    bytes: std::array::Array<u8>,
}

pub fn String(allocator: Allocator) -> std::string::String {
    return String {
        bytes: std::array::Array<u8>(allocator)
    };
}

impl String {
    fn append_bytes(self: String, bytes: []u8) -> !void {
        var index = 0;
        let length = std::mem::len(bytes);
        while index < length {
            try self.bytes.append(bytes[index]);
            index = index + 1;
        }
        return;
    }

    fn append_byte(self: String, byte: u8) -> !void {
        try self.bytes.append(byte);
        return;
    }

    fn reserve(self: String, additional: i64) -> !void {
        if additional < 0 {
            return error("String.reserve expects non-negative i64");
        }
        try self.bytes.reserve(additional);
        return;
    }

    fn len(self: String) -> i64 {
        return self.bytes.len();
    }

    fn capacity(self: String) -> i64 {
        return self.bytes.capacity();
    }

    fn as_bytes(self: String) -> []u8 borrows self {
        return self.bytes.as_bytes();
    }

    fn clear(self: String) -> void {
        self.bytes.clear();
    }

    fn truncate(self: String, length: i64) -> !void {
        if length < 0 or length > self.len() {
            return error("String.truncate length out of bounds");
        }
        try self.bytes.truncate(length);
        return;
    }

    fn deinit(self: String) -> void {
        self.bytes.deinit();
    }
}
