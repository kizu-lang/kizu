// std::string wraps trusted owned byte storage primitives.
impl String {
    fn append_bytes(self: String, bytes: []const u8) -> !void {
        try std::builtin::string_append_bytes(self, bytes);
        return void;
    }

    fn append_byte(self: String, byte: u8) -> !void {
        try std::builtin::string_append_byte(self, byte);
        return void;
    }

    fn reserve(self: String, additional: i64) -> !void {
        try std::builtin::string_reserve(self, additional);
        return void;
    }

    fn len(self: String) -> i64 {
        return std::builtin::string_len(self);
    }

    fn capacity(self: String) -> i64 {
        return std::builtin::string_capacity(self);
    }

    fn as_bytes(self: String) -> []const u8 {
        return std::builtin::string_as_bytes(self);
    }

    fn clear(self: String) -> void {
        std::builtin::string_clear(self);
    }

    fn deinit(self: String) -> void {
        std::builtin::string_deinit(self);
    }
}
