pub error Error {
    InvalidPath,
    NotFound,
    PermissionDenied,
    IsDirectory,
    NotDirectory,
    AlreadyExists,
    DirectoryNotEmpty,
    NoSpaceLeft,
    TooManyOpenFiles,
    ReadFailed,
    WriteFailed,
    OutOfMemory,
    OperationFailed,
    IoFailing,
}

pub struct DirEntry {
    pub name: []u8,
    pub path: []u8,
    pub is_dir: bool,
}

pub struct Metadata {
    pub size: i64,
    pub is_dir: bool,
}

pub fn read_file(io: Io, path: &[]u8) -> std::fs::Error![]u8 {
    let bytes = try std::builtin::fs_read_file(io, path);
    return bytes;
}

pub fn write_file(io: Io, path: &[]u8, bytes: &[]u8) -> std::fs::Error!void {
    try std::builtin::fs_write_file(io, path, bytes);
    return;
}

pub fn rename(io: Io, from: &[]u8, to: &[]u8) -> std::fs::Error!void {
    try std::builtin::fs_rename(io, from, to);
    return;
}

pub fn exists(io: Io, path: &[]u8) -> std::fs::Error!bool {
    let found = try std::builtin::fs_exists(io, path);
    return found;
}

pub fn metadata(io: Io, path: &[]u8) -> std::fs::Error!std::fs::Metadata {
    let info = try std::builtin::fs_metadata(io, path);
    return info;
}

pub fn read_dir(
    io: Io,
    path: &[]u8
) -> std::fs::Error!std::array::Array<std::fs::DirEntry> {
    let entries = try std::builtin::fs_read_dir(io, path);
    return entries;
}

pub fn create_dir(io: Io, path: &[]u8) -> std::fs::Error!void {
    try std::builtin::fs_create_dir(io, path);
    return;
}

pub fn remove_dir(io: Io, path: &[]u8) -> std::fs::Error!void {
    try std::builtin::fs_remove_dir(io, path);
    return;
}

pub fn remove_file(io: Io, path: &[]u8) -> std::fs::Error!void {
    try std::builtin::fs_remove_file(io, path);
    return;
}
