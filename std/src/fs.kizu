pub struct DirEntry {
    pub name: []u8,
    pub path: []u8,
    pub is_dir: bool,
}

pub fn read_file(io: Io, path: &[]u8) -> ![]u8 {
    let bytes = try std::builtin::fs_read_file(io, path);
    return bytes;
}

pub fn write_file(io: Io, path: &[]u8, bytes: &[]u8) -> !void {
    try std::builtin::fs_write_file(io, path, bytes);
    return;
}

pub fn exists(io: Io, path: &[]u8) -> !bool {
    let found = try std::builtin::fs_exists(io, path);
    return found;
}

pub fn metadata(io: Io, path: &[]u8) -> !std::fs::Metadata {
    let info = try std::builtin::fs_metadata(io, path);
    return info;
}

pub fn read_dir(
    io: Io,
    path: &[]u8
) -> !std::array::Array<std::fs::DirEntry> {
    let entries = try std::builtin::fs_read_dir(io, path);
    return entries;
}

pub fn create_dir(io: Io, path: &[]u8) -> !void {
    try std::builtin::fs_create_dir(io, path);
    return;
}

pub fn remove_dir(io: Io, path: &[]u8) -> !void {
    try std::builtin::fs_remove_dir(io, path);
    return;
}

pub fn remove_file(io: Io, path: &[]u8) -> !void {
    try std::builtin::fs_remove_file(io, path);
    return;
}
