pub fn expect(condition: bool) -> !void {
    try std::builtin::testing_expect(condition);
    return void;
}

pub fn expect_equal_i64(expected: i64, actual: i64) -> !void {
    try std::builtin::testing_expect_equal_i64(expected, actual);
    return void;
}

pub fn expect_equal_bool(expected: bool, actual: bool) -> !void {
    try std::builtin::testing_expect_equal_bool(expected, actual);
    return void;
}

pub fn expect_equal_bytes(expected: []const u8, actual: []const u8) -> !void {
    try std::builtin::testing_expect_equal_bytes(expected, actual);
    return void;
}

pub fn fail(message: []const u8) -> !void {
    try std::builtin::testing_fail(message);
    return void;
}
