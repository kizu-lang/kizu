pub fn expect(condition: bool) -> !void {
    if !condition {
        return error("expected condition to be true");
    }
    return;
}

pub fn expect_equal_i64(expected: i64, actual: i64) -> !void {
    if expected != actual {
        let allocator = std::mem::page_allocator();
        var message = std::string::String(allocator);
        try message.append_bytes("expected ");
        try std::fmt::append_i64(message, expected);
        try message.append_bytes(", got ");
        try std::fmt::append_i64(message, actual);
        let bytes = message.as_bytes();
        return error(bytes);
    }
    return;
}

pub fn expect_equal_bool(expected: bool, actual: bool) -> !void {
    if expected != actual {
        let allocator = std::mem::page_allocator();
        var message = std::string::String(allocator);
        try message.append_bytes("expected ");
        try std::fmt::append_bool(message, expected);
        try message.append_bytes(", got ");
        try std::fmt::append_bool(message, actual);
        let bytes = message.as_bytes();
        return error(bytes);
    }
    return;
}

pub fn expect_equal_bytes(expected: []const u8, actual: []const u8) -> !void {
    if !std::mem::equal_bytes(expected, actual) {
        let allocator = std::mem::page_allocator();
        var message = std::string::String(allocator);
        try message.append_bytes("expected ");
        try std::fmt::append_bytes_literal(message, expected);
        try message.append_bytes(", got ");
        try std::fmt::append_bytes_literal(message, actual);
        let bytes = message.as_bytes();
        return error(bytes);
    }
    return;
}

pub fn fail(message: []const u8) -> !void {
    return error(message);
}
