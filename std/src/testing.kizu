pub fn expect(condition: bool) -> void {
    if !condition {
        std::builtin::test_fail("expected condition to be true");
    }
    return;
}

pub fn expect_equal<T>(expected: T, actual: T) -> void {
    if expected != actual {
        std::builtin::test_fail_equal<T>(expected, actual);
    }
    return;
}

// fail reports one test failure. The message is a diagnostic: it goes to
// stderr through the same trap `expect` uses, and no error value carries it
// (ADR-0086). Like `expect`, it ends the process rather than returning a
// failure the caller could ignore.
pub fn fail(message: []u8) -> void {
    std::builtin::test_fail(message);
    return;
}

// failing_io is the Io every operation refuses. A program's error paths only
// run when something fails, and a real Io cannot be asked to fail on demand.
pub fn failing_io() -> Io {
    return std::builtin::io_failing();
}
