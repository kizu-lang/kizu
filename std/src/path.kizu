// join joins slash-separated path fragments.
pub fn join(left: []const u8, right: []const u8) -> []const u8 {
    return std::builtin::path_join(left, right);
}

// clean normalizes a slash-separated path.
pub fn clean(path: []const u8) -> []const u8 {
    return std::builtin::path_clean(path);
}

// basename returns the final slash-separated path element.
pub fn basename(path: []const u8) -> []const u8 {
    let length = std::mem::len(path);
    if length == 0 {
        return ".";
    }

    let end = std::path::trim_trailing_slashes(path, length);
    if end == 1 and std::path::is_slash(path[0]) {
        return "/";
    }

    let slash = std::path::last_slash_before(path, end);
    if slash < 0 {
        return path[0..end];
    }
    return path[slash + 1..end];
}

// dirname returns all but the final slash-separated path element.
pub fn dirname(path: []const u8) -> []const u8 {
    let length = std::mem::len(path);
    if length == 0 {
        return ".";
    }

    let end = std::path::trim_trailing_slashes(path, length);
    if end == 1 and std::path::is_slash(path[0]) {
        return "/";
    }

    let slash = std::path::last_slash_before(path, end);
    if slash < 0 {
        return ".";
    }
    if slash == 0 {
        return "/";
    }

    let dir_end = std::path::trim_trailing_slashes(path, slash);
    if dir_end == 0 {
        return ".";
    }
    if dir_end == 1 and std::path::is_slash(path[0]) {
        return "/";
    }
    return path[0..dir_end];
}

// extension returns the final extension of a slash-separated path.
pub fn extension(path: []const u8) -> []const u8 {
    var index = std::mem::len(path);
    while index > 0 {
        let previous = index - 1;
        if std::path::is_slash(path[previous]) {
            return "";
        }
        if std::path::is_dot(path[previous]) {
            return path[previous..std::mem::len(path)];
        }
        index = previous;
    }
    return "";
}

// trim_trailing_slashes removes trailing slashes while preserving root.
fn trim_trailing_slashes(path: []const u8, length: i64) -> i64 {
    var end = length;
    while end > 1 and std::path::is_slash(path[end - 1]) {
        end = end - 1;
    }
    return end;
}

// last_slash_before returns the last slash index before end or -1.
fn last_slash_before(path: []const u8, end: i64) -> i64 {
    var index = end;
    while index > 0 {
        let previous = index - 1;
        if std::path::is_slash(path[previous]) {
            return previous;
        }
        index = previous;
    }
    return -1;
}

// is_slash reports whether byte is the slash separator.
fn is_slash(byte: u8) -> bool {
    return byte == cast<u8>(47);
}

// is_dot reports whether byte is the extension separator.
fn is_dot(byte: u8) -> bool {
    return byte == cast<u8>(46);
}
