pub fn Array<T>(allocator: Allocator) -> std::array::Array<T> {
    return std::builtin::array<T>(allocator);
}

fn append<T>(self: std::array::Array<T>, value: T) -> !void {
    return std::builtin::array_append<T>(self, value);
}

fn len<T>(self: std::array::Array<T>) -> i64 {
    return std::builtin::array_len<T>(self);
}

fn capacity<T>(self: std::array::Array<T>) -> i64 {
    return std::builtin::array_capacity<T>(self);
}

fn get<T>(self: std::array::Array<T>, index: i64) -> !T {
    return std::builtin::array_get<T>(self, index);
}

fn at<T>(self: std::array::Array<T>, index: i64) -> !&T {
    return std::builtin::array_at<T>(self, index);
}

fn at_mut<T>(self: std::array::Array<T>, index: i64) -> !&mut T {
    return std::builtin::array_at_mut<T>(self, index);
}

fn set<T>(self: std::array::Array<T>, index: i64, value: T) -> !void {
    return std::builtin::array_set<T>(self, index, value);
}

fn deinit<T>(self: std::array::Array<T>) -> void {
    std::builtin::array_deinit<T>(self);
}
