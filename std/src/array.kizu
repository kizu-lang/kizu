pub fn Array<T>(allocator: Allocator) -> std::array::Array<T> {
    return std::builtin::array<T>(allocator);
}

fn append<T>(self: std::array::Array<T>, value: T) -> !void {
    return std::builtin::array_append<T>(self, value);
}

fn len<T>(self: std::array::Array<T>) -> i64 {
    return std::builtin::array_len<T>(self);
}

fn capacity<T>(self: std::array::Array<T>) -> i64 {
    return std::builtin::array_capacity<T>(self);
}

fn reserve<T>(self: std::array::Array<T>, additional: i64) -> !void {
    return std::builtin::array_reserve<T>(self, additional);
}

fn pop<T>(self: std::array::Array<T>) -> !T {
    return std::builtin::array_pop<T>(self);
}

fn pop_or_panic<T>(self: std::array::Array<T>) -> T {
    return std::builtin::array_pop_or_panic<T>(self);
}

fn get<T>(self: std::array::Array<T>, index: i64) -> !T {
    return std::builtin::array_get<T>(self, index);
}

fn get_or_panic<T>(self: std::array::Array<T>, index: i64) -> T {
    return std::builtin::array_get_or_panic<T>(self, index);
}

fn at<T>(self: std::array::Array<T>, index: i64) -> !&T borrows self {
    return std::builtin::array_at<T>(self, index);
}

fn at_mut<T>(self: std::array::Array<T>, index: i64) -> !&var T borrows self {
    return std::builtin::array_at_mut<T>(self, index);
}

fn set<T>(self: std::array::Array<T>, index: i64, value: T) -> !void {
    return std::builtin::array_set<T>(self, index, value);
}

fn deinit<T>(self: std::array::Array<T>) -> void {
    std::builtin::array_deinit<T>(self);
}

fn truncate<T>(self: std::array::Array<T>, length: i64) -> !void {
    return std::builtin::array_truncate<T>(self, length);
}

fn clear<T>(self: std::array::Array<T>) -> void {
    std::builtin::array_clear<T>(self);
}

fn as_bytes<T>(self: std::array::Array<T>) -> []u8 {
    return std::builtin::array_as_bytes<T>(self);
}
