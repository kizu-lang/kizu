// page_allocator returns the default page allocator capability.
pub fn page_allocator() -> Allocator {
    return std::builtin::mem_page_allocator();
}

// len returns the byte length of a read-only byte slice.
pub fn len(bytes: []const u8) -> i64 {
    return std::builtin::mem_len(bytes);
}

// byte_at returns one checked byte from a read-only byte slice.
pub fn byte_at(bytes: []const u8, index: i64) -> !u8 {
    let byte = try std::builtin::mem_byte_at(bytes, index);
    return byte;
}

// equal_bytes compares two byte slices.
pub fn equal_bytes(left: []const u8, right: []const u8) -> bool {
    let left_len = std::mem::len(left);
    if left_len != std::mem::len(right) {
        return false;
    }

    var index = 0;
    while index < left_len {
        if left[index] != right[index] {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// starts_with reports whether bytes starts with prefix.
pub fn starts_with(bytes: []const u8, prefix: []const u8) -> bool {
    let prefix_len = std::mem::len(prefix);
    if prefix_len > std::mem::len(bytes) {
        return false;
    }

    var index = 0;
    while index < prefix_len {
        if bytes[index] != prefix[index] {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// slice returns a checked sub-slice without allocating.
pub fn slice(bytes: []const u8, start: i64, end: i64) -> ![]const u8 {
    let part = try std::builtin::mem_slice(bytes, start, end);
    return part;
}

// trim_ascii trims ASCII whitespace from both ends.
pub fn trim_ascii(bytes: []const u8) -> []const u8 {
    var start = 0;
    var end = std::mem::len(bytes);

    while start < end {
        if !std::mem::is_ascii_space(bytes[start]) {
            break;
        }
        start = start + 1;
    }

    while end > start {
        let previous = end - 1;
        if !std::mem::is_ascii_space(bytes[previous]) {
            break;
        }
        end = previous;
    }

    return bytes[start..end];
}

// is_ascii_space reports whether byte is one of the ASCII whitespace bytes.
fn is_ascii_space(byte: u8) -> bool {
    return byte == cast<u8>(32) ||
        byte == cast<u8>(9) ||
        byte == cast<u8>(10) ||
        byte == cast<u8>(13) ||
        byte == cast<u8>(11) ||
        byte == cast<u8>(12);
}
