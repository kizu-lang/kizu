pub extern "kizu_primitive" fn page_allocator() -> Allocator
pub extern "kizu_primitive" fn len(bytes: []const u8) -> i64
pub extern "kizu_primitive" fn byte_at(bytes: []const u8, index: i64) -> !i64
pub extern "kizu_primitive" fn equal_bytes(left: []const u8, right: []const u8) -> bool
pub extern "kizu_primitive" fn starts_with(bytes: []const u8, prefix: []const u8) -> bool
pub extern "kizu_primitive" fn slice(bytes: []const u8, start: i64, end: i64) -> ![]const u8
pub extern "kizu_primitive" fn trim_ascii(bytes: []const u8) -> []const u8

pub struct Allocator {
    handle: i64;
}
