pub struct SourceFile {
    pub path: []u8,
    pub text: []u8,
}

pub struct Span {
    pub start: i64,
    pub end: i64,
}

pub struct TokenId {
    pub raw: i64,
}

pub struct SymbolId {
    pub raw: i64,
}

pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    Eq,
    NotEq,
    LT,
    LTE,
    GT,
    GTE,
    And,
    Or,
}

pub enum PrefixOp {
    Not,
    Neg,
    Borrow,
    MutBorrow,
}

pub struct ChildRange {
    pub start: i64,
    pub len: i64,
}

pub struct NodeId {
    raw: std::arena::Handle<std::kizu::ast::AstNode>,
}

pub struct Ast {
    nodes: std::arena::Arena<std::kizu::ast::AstNode>,
    children: std::array::Array<std::kizu::ast::NodeId>,
    source: SourceFile,
}

pub struct AstNode {
    pub span: Span,
    pub data: AstData,
}

pub union AstData {
    Program(ProgramNode),
    Int(IntNode),
    String(StringNode),
    TypeName(TypeNameNode),
    Var(VarNode),
    Bool(BoolNode),
    Prefix(PrefixNode),
    Binary(BinaryNode),
    FieldExpr(FieldExprNode),
    DerefExpr(DerefExprNode),
    Call(CallNode),
    TypeApplyExpr(TypeApplyExprNode),
    CastExpr(CastExprNode),
    IndexExpr(IndexExprNode),
    StructLiteralExpr(StructLiteralExprNode),
    StructFieldInit(StructFieldInitNode),
    ArenaNewExpr(ArenaNewExprNode),
    TryExpr(TryExprNode),
    ComptimeExpr(ComptimeExprNode),
    Block(BlockNode),
    If(IfNode),
    Let(LetNode),
    Assign(AssignNode),
    Return(ReturnNode),
    Defer(DeferNode),
    ErrDefer(ErrDeferNode),
    ExprStmt(ExprStmtNode),
    While(WhileNode),
    For(ForNode),
    Break(BreakNode),
    Continue(ContinueNode),
    ImportDecl(ImportDeclNode),
    Param(ParamNode),
    Field(FieldNode),
    StructDecl(StructDeclNode),
    EnumDecl(EnumDeclNode),
    UnionDecl(UnionDeclNode),
    ImplDecl(ImplDeclNode),
    UnionVariant(UnionVariantNode),
    Match(MatchNode),
    MatchArm(MatchArmNode),
    Unsafe(UnsafeNode),
    ComptimeIf(ComptimeIfNode),
    FnDecl(FnDeclNode),
    Empty,
    // ContractDecl carries the required method signatures of one contract (SPEC.md 16).
    // It is appended after Empty so the variant order every earlier node already relies
    // on stays fixed.
    ContractDecl(ContractDeclNode),
}

pub struct ProgramNode {
    pub declarations: ChildRange,
}

pub struct IntNode {
    pub token: TokenId,
}

pub struct StringNode {
    pub token: TokenId,
}

pub struct TypeNameNode {
    pub name: SymbolId,
}

pub struct VarNode {
    pub name: SymbolId,
    pub doc: Span,
}

pub struct BoolNode {
    pub value: bool,
}

pub struct PrefixNode {
    pub op: PrefixOp,
    pub right: NodeId,
}

pub struct BinaryNode {
    pub op: BinaryOp,
    pub left: NodeId,
    pub right: NodeId,
}

pub struct FieldExprNode {
    pub receiver: NodeId,
    pub name: NodeId,
    pub namespace: bool,
}

pub struct DerefExprNode {
    pub receiver: NodeId,
}

pub struct CallNode {
    pub callee: NodeId,
    pub args: ChildRange,
}

pub struct TypeApplyExprNode {
    pub callee: NodeId,
    pub type_args: ChildRange,
}

pub struct CastExprNode {
    pub type_node: NodeId,
    pub value: NodeId,
}

pub struct IndexExprNode {
    pub target: NodeId,
    pub start: NodeId,
    pub end: NodeId,
    pub slice: bool,
}

pub struct StructLiteralExprNode {
    pub type_name: NodeId,
    pub fields: ChildRange,
}

pub struct StructFieldInitNode {
    pub name: NodeId,
    pub value: NodeId,
}

pub struct ArenaNewExprNode {
    pub type_node: NodeId,
    pub allocator: NodeId,
}

pub struct TryExprNode {
    pub value: NodeId,
}

pub struct ComptimeExprNode {
    pub value: NodeId,
}

pub struct BlockNode {
    pub statements: ChildRange,
}

pub struct IfNode {
    pub condition: NodeId,
    pub then_block: NodeId,
    pub else_block: NodeId,
}

pub struct LetNode {
    pub mutable: bool,
    pub name: NodeId,
    pub value: NodeId,
}

pub struct AssignNode {
    pub target: NodeId,
    pub value: NodeId,
}

pub struct ReturnNode {
    pub value: NodeId,
}

pub struct DeferNode {
    pub expr: NodeId,
}

pub struct ErrDeferNode {
    pub expr: NodeId,
}

pub struct ExprStmtNode {
    pub expr: NodeId,
}

pub struct WhileNode {
    pub label: NodeId,
    pub condition: NodeId,
    pub body: NodeId,
}

pub struct ForNode {
    pub label: NodeId,
    pub name: NodeId,
    pub start: NodeId,
    pub end: NodeId,
    pub body: NodeId,
}

pub struct BreakNode {
    pub label: NodeId,
}

pub struct ContinueNode {
    pub label: NodeId,
}

pub struct ImportDeclNode {
    pub path: ChildRange,
}

pub struct ParamNode {
    pub comptime_param: bool,
    pub name: NodeId,
    pub type_node: NodeId,
}

pub struct FieldNode {
    pub public: bool,
    pub name: NodeId,
    pub type_node: NodeId,
    pub doc: Span,
}

pub struct StructDeclNode {
    pub public: bool,
    pub name: NodeId,
    pub type_params: ChildRange,
    pub fields: ChildRange,
    pub doc: Span,
}

pub struct EnumDeclNode {
    pub public: bool,
    pub name: NodeId,
    pub tags: ChildRange,
    pub doc: Span,
}

pub struct UnionDeclNode {
    pub public: bool,
    pub name: NodeId,
    pub type_params: ChildRange,
    pub variants: ChildRange,
    pub doc: Span,
}

// ImplDeclNode carries one impl block. `contract_name` is the Empty node for an inherent
// impl and names the contract for `impl Contract for Type`.
pub struct ImplDeclNode {
    pub contract_name: NodeId,
    pub type_name: NodeId,
    pub methods: ChildRange,
}

// ContractDeclNode carries one contract declaration. Its methods are signatures without
// bodies, so each method's body node is Empty.
pub struct ContractDeclNode {
    pub public: bool,
    pub name: NodeId,
    pub methods: ChildRange,
    pub doc: Span,
}

pub struct UnionVariantNode {
    pub name: NodeId,
    pub payload: NodeId,
    pub doc: Span,
}

pub struct MatchNode {
    pub value: NodeId,
    pub arms: ChildRange,
}

pub struct MatchArmNode {
    pub pattern: NodeId,
    pub binding: NodeId,
    pub body: NodeId,
}

pub struct UnsafeNode {
    pub capabilities: ChildRange,
    pub body: NodeId,
}

pub struct ComptimeIfNode {
    pub condition: NodeId,
    pub then_block: NodeId,
    pub else_block: NodeId,
}

pub struct FnDeclNode {
    pub public: bool,
    pub requires_unsafe: bool,
    pub extern_abi: NodeId,
    pub name: NodeId,
    pub type_params: ChildRange,
    pub params: ChildRange,
    pub return_type: NodeId,
    pub return_borrow: NodeId,
    pub body: NodeId,
    pub doc: Span,
}

pub struct ParseResult {
    pub ast: Ast,
    pub root: NodeId,
}

pub fn Ast(allocator: Allocator, source: SourceFile) -> Ast {
    return Ast {
        nodes: std::arena::Arena<AstNode>(allocator),
        children: std::array::Array<NodeId>(allocator),
        source: source
    };
}

pub fn source_file(path: []u8, text: []u8) -> SourceFile {
    return SourceFile {
        path: path,
        text: text
    };
}

pub fn parse_result(ast: Ast, root: NodeId) -> ParseResult {
    return ParseResult {
        ast: ast,
        root: root
    };
}

// synth_union_construct_empty is the issue 1157 PR-P1 synthetic fixture: it constructs the
// payload-less AstData::Empty variant and returns the union value. It exercises the
// compiled-MIR backend's new tagged-union construction lowering (tag-only first form) on
// the executable path in isolation, ahead of wiring the real parser builders (P2/P3). It
// reuses AstData's existing union ABI, so no new union-type lowering is needed here.
pub fn synth_union_construct_empty() -> AstData {
    return AstData::Empty;
}

// synth_union_construct_program is the issue 1157 PR-P2 synthetic fixture: it constructs
// the single-payload AstData::Program(payload) variant from a ProgramNode value and returns
// the union. It exercises the compiled-MIR backend's payload union construction lowering
// (store discriminant + payload into the union byte buffer) on the executable path in
// isolation, ahead of wiring the real parser builders (P3). Taking the payload as a
// parameter keeps the fixture to the construction shape alone (no struct-literal payload).
pub fn synth_union_construct_program(payload: ProgramNode) -> AstData {
    return AstData::Program(payload);
}

// synth_union_construct_program_lit is the issue 1157 PR-P3 synthetic fixture: it builds
// the payload ProgramNode in place with a struct literal and constructs AstData::Program
// from it. It exercises the compiled-MIR backend's struct-literal payload union construction
// (lower the single-field struct literal to an SSA value, then store it into the union byte
// buffer) on the executable path in isolation, the shape the real parser builders use.
pub fn synth_union_construct_program_lit(declarations: ChildRange) -> AstData {
    return AstData::Program(ProgramNode{ declarations: declarations });
}

pub fn token_id(raw: i64) -> TokenId {
    return TokenId {
        raw: raw
    };
}

pub fn symbol_id(raw: i64) -> SymbolId {
    return SymbolId {
        raw: raw
    };
}

pub fn span(start: i64, end: i64) -> Span {
    return Span {
        start: start,
        end: end
    };
}

pub fn empty_span(at: i64) -> Span {
    return std::kizu::ast::span(at, at);
}

pub fn binary_add() -> BinaryOp {
    return BinaryOp::Add;
}

pub fn binary_sub() -> BinaryOp {
    return BinaryOp::Sub;
}

pub fn binary_mul() -> BinaryOp {
    return BinaryOp::Mul;
}

pub fn binary_div() -> BinaryOp {
    return BinaryOp::Div;
}

pub fn binary_mod() -> BinaryOp {
    return BinaryOp::Mod;
}

pub fn binary_eq() -> BinaryOp {
    return BinaryOp::Eq;
}

pub fn binary_not_eq() -> BinaryOp {
    return BinaryOp::NotEq;
}

pub fn binary_lt() -> BinaryOp {
    return BinaryOp::LT;
}

pub fn binary_lte() -> BinaryOp {
    return BinaryOp::LTE;
}

pub fn binary_gt() -> BinaryOp {
    return BinaryOp::GT;
}

pub fn binary_gte() -> BinaryOp {
    return BinaryOp::GTE;
}

pub fn binary_and() -> BinaryOp {
    return BinaryOp::And;
}

pub fn binary_or() -> BinaryOp {
    return BinaryOp::Or;
}

pub fn prefix_not() -> PrefixOp {
    return PrefixOp::Not;
}

pub fn prefix_neg() -> PrefixOp {
    return PrefixOp::Neg;
}

pub fn prefix_borrow() -> PrefixOp {
    return PrefixOp::Borrow;
}

pub fn prefix_mut_borrow() -> PrefixOp {
    return PrefixOp::MutBorrow;
}

// add_impl_decl builds one impl block. `contract_name` is the Empty node for an inherent
// impl and names the contract for `impl Contract for Type` (SPEC.md 16).
pub fn add_impl_decl(
    ast: Ast,
    span_value: Span,
    contract_name: NodeId,
    type_name: NodeId,
    methods: ChildRange
) -> NodeId {
    return ast.add_node(span_value, AstData::ImplDecl(ImplDeclNode {
        contract_name: contract_name,
        type_name: type_name,
        methods: methods
    }));
}

// add_contract_decl builds one contract declaration. Its methods are signatures, so each
// method node carries an Empty body.
pub fn add_contract_decl(
    ast: Ast,
    span_value: Span,
    public: bool,
    name: NodeId,
    methods: ChildRange,
    doc: Span
) -> NodeId {
    return ast.add_node(span_value, AstData::ContractDecl(ContractDeclNode {
        public: public,
        name: name,
        methods: methods,
        doc: doc
    }));
}

impl Ast {
    fn add_node(self: Ast, span_value: Span, data: AstData) -> NodeId {
        let raw = self.nodes.add(AstNode {
            span: span_value,
            data: data
        });
        return NodeId {
            raw: raw
        };
    }

    fn get(self: Ast, id: NodeId) -> AstNode {
        return self.nodes.get(id.raw);
    }

    fn len(self: Ast) -> i64 {
        return self.children.len();
    }

    fn begin_children(self: Ast) -> i64 {
        return self.children.len();
    }

    fn add_child(self: Ast, child: NodeId) -> !void {
        try self.children.append(child);
        return;
    }

    fn finish_children(self: Ast, start: i64) -> ChildRange {
        return ChildRange {
            start: start,
            len: self.children.len() - start
        };
    }

    fn child_at(self: Ast, range: ChildRange, index: i64) -> !NodeId {
        if index < 0 or index >= range.len {
            return error("child index out of bounds");
        }
        return self.children.get(range.start + index);
    }

    fn deinit(self: Ast) -> void {
        self.nodes.deinit();
        self.children.deinit();
    }

    fn add_int(self: Ast, span_value: Span, token: TokenId) -> NodeId {
        return self.add_node(span_value, AstData::Int(IntNode {
            token: token
        }));
    }

    fn add_program(self: Ast, span_value: Span, declarations: ChildRange) -> NodeId {
        return self.add_node(span_value, AstData::Program(ProgramNode {
            declarations: declarations
        }));
    }

    fn add_string(self: Ast, span_value: Span, token: TokenId) -> NodeId {
        return self.add_node(span_value, AstData::String(StringNode {
            token: token
        }));
    }

    fn add_type_name(self: Ast, span_value: Span, name: SymbolId) -> NodeId {
        return self.add_node(span_value, AstData::TypeName(TypeNameNode {
            name: name
        }));
    }

    fn add_var(self: Ast, span_value: Span, name: SymbolId) -> NodeId {
        return self.add_var_with_doc(
            span_value,
            name,
            std::kizu::ast::empty_span(span_value.start)
        );
    }

    fn add_var_with_doc(
        self: Ast,
        span_value: Span,
        name: SymbolId,
        doc: Span
    ) -> NodeId {
        return self.add_node(span_value, AstData::Var(VarNode {
            name: name,
            doc: doc
        }));
    }

    fn add_bool(self: Ast, span_value: Span, value: bool) -> NodeId {
        return self.add_node(span_value, AstData::Bool(BoolNode {
            value: value
        }));
    }

    fn add_prefix(
        self: Ast,
        span_value: Span,
        op: PrefixOp,
        right: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::Prefix(PrefixNode {
            op: op,
            right: right
        }));
    }

    fn add_binary(
        self: Ast,
        span_value: Span,
        op: BinaryOp,
        left: NodeId,
        right: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::Binary(BinaryNode {
            op: op,
            left: left,
            right: right
        }));
    }

    fn add_field_expr(
        self: Ast,
        span_value: Span,
        receiver: NodeId,
        name: NodeId,
        namespace: bool
    ) -> NodeId {
        return self.add_node(span_value, AstData::FieldExpr(FieldExprNode {
            receiver: receiver,
            name: name,
            namespace: namespace
        }));
    }

    fn add_deref_expr(self: Ast, span_value: Span, receiver: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::DerefExpr(DerefExprNode {
            receiver: receiver
        }));
    }

    fn add_call(
        self: Ast,
        span_value: Span,
        callee: NodeId,
        args: ChildRange
    ) -> NodeId {
        return self.add_node(span_value, AstData::Call(CallNode {
            callee: callee,
            args: args
        }));
    }

    fn add_type_apply_expr(
        self: Ast,
        span_value: Span,
        callee: NodeId,
        type_args: ChildRange
    ) -> NodeId {
        return self.add_node(span_value, AstData::TypeApplyExpr(TypeApplyExprNode {
            callee: callee,
            type_args: type_args
        }));
    }

    fn add_cast_expr(
        self: Ast,
        span_value: Span,
        type_node: NodeId,
        value: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::CastExpr(CastExprNode {
            type_node: type_node,
            value: value
        }));
    }

    fn add_index_expr(
        self: Ast,
        span_value: Span,
        target: NodeId,
        start: NodeId,
        end: NodeId,
        slice: bool
    ) -> NodeId {
        return self.add_node(span_value, AstData::IndexExpr(IndexExprNode {
            target: target,
            start: start,
            end: end,
            slice: slice
        }));
    }

    fn add_struct_literal_expr(
        self: Ast,
        span_value: Span,
        type_name: NodeId,
        fields: ChildRange
    ) -> NodeId {
        return self.add_node(span_value, AstData::StructLiteralExpr(StructLiteralExprNode {
            type_name: type_name,
            fields: fields
        }));
    }

    fn add_struct_field_init(
        self: Ast,
        span_value: Span,
        name: NodeId,
        value: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::StructFieldInit(StructFieldInitNode {
            name: name,
            value: value
        }));
    }

    fn add_arena_new_expr(
        self: Ast,
        span_value: Span,
        type_node: NodeId,
        allocator: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::ArenaNewExpr(ArenaNewExprNode {
            type_node: type_node,
            allocator: allocator
        }));
    }

    fn add_try_expr(self: Ast, span_value: Span, value: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::TryExpr(TryExprNode {
            value: value
        }));
    }

    fn add_comptime_expr(self: Ast, span_value: Span, value: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::ComptimeExpr(ComptimeExprNode {
            value: value
        }));
    }

    fn add_block(self: Ast, span_value: Span, statements: ChildRange) -> NodeId {
        return self.add_node(span_value, AstData::Block(BlockNode {
            statements: statements
        }));
    }

    fn add_if(
        self: Ast,
        span_value: Span,
        condition: NodeId,
        then_block: NodeId,
        else_block: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::If(IfNode {
            condition: condition,
            then_block: then_block,
            else_block: else_block
        }));
    }

    fn add_let(
        self: Ast,
        span_value: Span,
        mutable: bool,
        name: NodeId,
        value: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::Let(LetNode {
            mutable: mutable,
            name: name,
            value: value
        }));
    }

    fn add_assign(self: Ast, span_value: Span, target: NodeId, value: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::Assign(AssignNode {
            target: target,
            value: value
        }));
    }

    fn add_return(self: Ast, span_value: Span, value: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::Return(ReturnNode {
            value: value
        }));
    }

    fn add_defer(self: Ast, span_value: Span, expr: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::Defer(DeferNode {
            expr: expr
        }));
    }

    fn add_err_defer(self: Ast, span_value: Span, expr: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::ErrDefer(ErrDeferNode {
            expr: expr
        }));
    }

    fn add_expr_stmt(self: Ast, span_value: Span, expr: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::ExprStmt(ExprStmtNode {
            expr: expr
        }));
    }

    fn add_while(
        self: Ast,
        span_value: Span,
        label: NodeId,
        condition: NodeId,
        body: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::While(WhileNode {
            label: label,
            condition: condition,
            body: body
        }));
    }

    fn add_for(
        self: Ast,
        span_value: Span,
        label: NodeId,
        name: NodeId,
        start: NodeId,
        end: NodeId,
        body: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::For(ForNode {
            label: label,
            name: name,
            start: start,
            end: end,
            body: body
        }));
    }

    fn add_break(self: Ast, span_value: Span, label: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::Break(BreakNode {
            label: label
        }));
    }

    fn add_continue(self: Ast, span_value: Span, label: NodeId) -> NodeId {
        return self.add_node(span_value, AstData::Continue(ContinueNode {
            label: label
        }));
    }

    fn add_param(
        self: Ast,
        span_value: Span,
        comptime_param: bool,
        name: NodeId,
        type_node: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::Param(ParamNode {
            comptime_param: comptime_param,
            name: name,
            type_node: type_node
        }));
    }

    fn add_import_decl(self: Ast, span_value: Span, path: ChildRange) -> NodeId {
        return self.add_node(span_value, AstData::ImportDecl(ImportDeclNode {
            path: path
        }));
    }

    fn add_field(
        self: Ast,
        span_value: Span,
        public: bool,
        name: NodeId,
        type_node: NodeId
    ) -> NodeId {
        return self.add_field_with_doc(
            span_value,
            public,
            name,
            type_node,
            std::kizu::ast::empty_span(span_value.start)
        );
    }

    fn add_field_with_doc(
        self: Ast,
        span_value: Span,
        public: bool,
        name: NodeId,
        type_node: NodeId,
        doc: Span
    ) -> NodeId {
        return self.add_node(span_value, AstData::Field(FieldNode {
            public: public,
            name: name,
            type_node: type_node,
            doc: doc
        }));
    }

    fn add_struct_decl(
        self: Ast,
        span_value: Span,
        public: bool,
        name: NodeId,
        type_params: ChildRange,
        fields: ChildRange
    ) -> NodeId {
        return self.add_struct_decl_with_doc(
            span_value,
            public,
            name,
            type_params,
            fields,
            std::kizu::ast::empty_span(span_value.start)
        );
    }

    fn add_struct_decl_with_doc(
        self: Ast,
        span_value: Span,
        public: bool,
        name: NodeId,
        type_params: ChildRange,
        fields: ChildRange,
        doc: Span
    ) -> NodeId {
        return self.add_node(span_value, AstData::StructDecl(StructDeclNode {
            public: public,
            name: name,
            type_params: type_params,
            fields: fields,
            doc: doc
        }));
    }

    fn add_enum_decl(
        self: Ast,
        span_value: Span,
        public: bool,
        name: NodeId,
        tags: ChildRange
    ) -> NodeId {
        return self.add_enum_decl_with_doc(
            span_value,
            public,
            name,
            tags,
            std::kizu::ast::empty_span(span_value.start)
        );
    }

    fn add_enum_decl_with_doc(
        self: Ast,
        span_value: Span,
        public: bool,
        name: NodeId,
        tags: ChildRange,
        doc: Span
    ) -> NodeId {
        return self.add_node(span_value, AstData::EnumDecl(EnumDeclNode {
            public: public,
            name: name,
            tags: tags,
            doc: doc
        }));
    }

    fn add_union_decl(
        self: Ast,
        span_value: Span,
        public: bool,
        name: NodeId,
        type_params: ChildRange,
        variants: ChildRange
    ) -> NodeId {
        return self.add_union_decl_with_doc(
            span_value,
            public,
            name,
            type_params,
            variants,
            std::kizu::ast::empty_span(span_value.start)
        );
    }

    fn add_union_decl_with_doc(
        self: Ast,
        span_value: Span,
        public: bool,
        name: NodeId,
        type_params: ChildRange,
        variants: ChildRange,
        doc: Span
    ) -> NodeId {
        return self.add_node(span_value, AstData::UnionDecl(UnionDeclNode {
            public: public,
            name: name,
            type_params: type_params,
            variants: variants,
            doc: doc
        }));
    }

    fn add_union_variant(
        self: Ast,
        span_value: Span,
        name: NodeId,
        payload: NodeId
    ) -> NodeId {
        return self.add_union_variant_with_doc(
            span_value,
            name,
            payload,
            std::kizu::ast::empty_span(span_value.start)
        );
    }

    fn add_union_variant_with_doc(
        self: Ast,
        span_value: Span,
        name: NodeId,
        payload: NodeId,
        doc: Span
    ) -> NodeId {
        return self.add_node(span_value, AstData::UnionVariant(UnionVariantNode {
            name: name,
            payload: payload,
            doc: doc
        }));
    }

    fn add_match(self: Ast, span_value: Span, value: NodeId, arms: ChildRange) -> NodeId {
        return self.add_node(span_value, AstData::Match(MatchNode {
            value: value,
            arms: arms
        }));
    }

    fn add_match_arm(
        self: Ast,
        span_value: Span,
        pattern: NodeId,
        binding: NodeId,
        body: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::MatchArm(MatchArmNode {
            pattern: pattern,
            binding: binding,
            body: body
        }));
    }

    fn add_unsafe(
        self: Ast,
        span_value: Span,
        capabilities: ChildRange,
        body: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::Unsafe(UnsafeNode {
            capabilities: capabilities,
            body: body
        }));
    }

    fn add_comptime_if(
        self: Ast,
        span_value: Span,
        condition: NodeId,
        then_block: NodeId,
        else_block: NodeId
    ) -> NodeId {
        return self.add_node(span_value, AstData::ComptimeIf(ComptimeIfNode {
            condition: condition,
            then_block: then_block,
            else_block: else_block
        }));
    }

    fn add_fn_decl(
        self: Ast,
        span_value: Span,
        public: bool,
        requires_unsafe: bool,
        extern_abi: NodeId,
        name: NodeId,
        type_params: ChildRange,
        params: ChildRange,
        return_type: NodeId,
        return_borrow: NodeId,
        body: NodeId
    ) -> NodeId {
        return self.add_fn_decl_with_doc(
            span_value,
            public,
            requires_unsafe,
            extern_abi,
            name,
            type_params,
            params,
            return_type,
            return_borrow,
            body,
            std::kizu::ast::empty_span(span_value.start)
        );
    }

    fn add_fn_decl_with_doc(
        self: Ast,
        span_value: Span,
        public: bool,
        requires_unsafe: bool,
        extern_abi: NodeId,
        name: NodeId,
        type_params: ChildRange,
        params: ChildRange,
        return_type: NodeId,
        return_borrow: NodeId,
        body: NodeId,
        doc: Span
    ) -> NodeId {
        return self.add_node(span_value, AstData::FnDecl(FnDeclNode {
            public: public,
            requires_unsafe: requires_unsafe,
            extern_abi: extern_abi,
            name: name,
            type_params: type_params,
            params: params,
            return_type: return_type,
            return_borrow: return_borrow,
            body: body,
            doc: doc
        }));
    }

    fn add_empty(self: Ast, at: i64) -> NodeId {
        return self.add_node(std::kizu::ast::span(at, at), AstData::Empty);
    }
}

impl ParseResult {
    fn node(self: ParseResult, id: NodeId) -> AstNode {
        return self.ast.get(id);
    }

    fn root_node(self: ParseResult) -> AstNode {
        return self.ast.get(self.root);
    }

    fn root_span_start(self: ParseResult) -> i64 {
        let node = self.ast.get(self.root);
        return node.span.start;
    }

    fn child_at(self: ParseResult, range: ChildRange, index: i64) -> !NodeId {
        return self.ast.child_at(range, index);
    }

    fn deinit(self: ParseResult) -> void {
        self.ast.deinit();
    }
}

// synth_next_token advances a token-carried loop variable by returning the next i64. It is
// the free-function helper the issue 1157 PR-P4 fixture calls in its while latch.
pub fn synth_next_token(token: i64) -> i64 {
    return token + 1;
}

// synth_token_while is the issue 1157 PR-P4 synthetic fixture: a token-carried while loop
// whose induction variable is advanced by a call result ('token = synth_next_token(token)')
// rather than a numeric increment ('i = i + step'). It exercises the compiled-MIR backend's
// new token-carried while latch (plain-call latch binding the loop-head phi's %token_next)
// on the executable path in isolation, the control-flow shape the real parser's
// 'token = declaration.next' loop needs.
pub fn synth_token_while(first: i64, limit: i64) -> i64 {
    var token = first;
    while token < limit {
        token = std::kizu::ast::synth_next_token(token);
    }
    return token;
}

// synth_parse_sig is the issue 1157 PR-PA synthetic fixture: it exercises the two
// std::kizu::parser::parse_program signature types on the native executable path in
// isolation, ahead of wiring the full parser body (worker-3 control-flow). The 'source:
// SourceFile' parameter exercises the new SourceFile parameter ABI mapping, and the
// '!std::kizu::ast::ParseResult' return type exercises the new ParseResult error-union
// lowering. The body stays minimal -- it forwards an already-built Ast + root through the
// existing parse_result constructor and returns it as the error union's ok value -- so it
// adds no control-flow and reuses only signature-type ABI, never the parser's loop/cleanup
// shapes.
pub fn synth_parse_sig(
    source: std::kizu::ast::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !std::kizu::ast::ParseResult {
    return std::kizu::ast::parse_result(ast, root);
}

// synth_ctor_ast / synth_ctor_array are the issue 1157 PR-PC synthetic fixtures: they call
// the constructor-like std::kizu::ast::Ast(allocator, source) and
// std::array::Array<T>(allocator) so the new constructor stdlib-return facts (exact for Ast,
// generic for Array<T>) are exercised on the native executable path, the shape the real
// parse_program / parse_block wrappers use before reaching their bodies.
pub fn synth_ctor_ast(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> std::kizu::ast::Ast {
    return std::kizu::ast::Ast(allocator, source);
}

pub fn synth_ctor_array(
    allocator: Allocator
) -> std::array::Array<std::kizu::ast::NodeId> {
    return std::array::Array<std::kizu::ast::NodeId>(allocator);
}

// SynthLatchNode + synth_make_latch_node + synth_field_latch_while are the issue 1157 PR-PF
// fixture: a while loop whose induction variable is advanced by a field-access latch
// ('token = n.next;', n a body-local struct) rather than a numeric add or a call result. It is
// the control-flow shape the real parser's parse_program_with_declarations /
// parse_block_with_statements loop ('token = declaration.next;') needs.
pub struct SynthLatchNode {
    pub value: i64,
    pub next: i64,
}

pub fn synth_make_latch_node(token: i64) -> SynthLatchNode {
    return SynthLatchNode { value: token, next: token + 1 };
}

pub fn synth_field_latch_while(first: i64, limit: i64) -> i64 {
    var token = first;
    while token < limit {
        let n = std::kizu::ast::synth_make_latch_node(token);
        token = n.next;
    }
    return token;
}

// synth_dispatch_match is the issue 1157 PR-PH / B3 fixture: a non-bool enum-dispatch match
// statement whose arms each return a real value (an error message, an integer literal, or a
// leading local). It drives the compiled-MIR EnumDispatch lowering -- the scrutinee discriminant
// plus the exhaustive icmp/br arm chain -- end to end. The leading 'let' makes the body a
// multi-statement function so it reaches lower_multi_statement_function's Match dispatch branch
// rather than the single-statement return path.
pub fn synth_dispatch_match(op: std::kizu::ast::BinaryOp) -> !i64 {
    let fallback = 7;
    match op {
        Add => return error("synth dispatch add unsupported");,
        Sub => return 2;,
        _ => return fallback;,
    }
}
