pub struct Span {
    pub start: i64;
    pub end: i64;
}

pub union Node {
    FnDecl(Span)
    Ident(Span)
    Empty
}

pub fn fn_decl(name_start: i64, name_end: i64) -> Node {
    return Node::FnDecl(Span {
        start: name_start,
        end: name_end
    });
}

pub fn ident(start: i64, end: i64) -> Node {
    return Node::Ident(Span {
        start: start,
        end: end
    });
}

pub fn empty() -> Node {
    return Node::Empty;
}
