pub struct FileSpan {
    pub source_id: i64,
    pub path: []u8,
    pub byte_start: i64,
    pub byte_end: i64,
    pub line: i64,
    pub column: i64,
}

pub struct RelatedSpan {
    pub span: std::kizu::diagnostic::FileSpan,
    pub message: []u8,
}

pub struct Diagnostic {
    pub primary: std::kizu::diagnostic::FileSpan,
    pub message: []u8,
    related: std::array::Array<std::kizu::diagnostic::RelatedSpan>,
}

pub fn file_span(
    source_id: i64,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    line: i64,
    column: i64
) -> std::kizu::diagnostic::FileSpan {
    return FileSpan {
        source_id: source_id,
        path: path,
        byte_start: byte_start,
        byte_end: byte_end,
        line: line,
        column: column
    };
}

pub fn related_span(
    span: std::kizu::diagnostic::FileSpan,
    message: []u8
) -> std::kizu::diagnostic::RelatedSpan {
    return RelatedSpan {
        span: span,
        message: message
    };
}

pub fn Diagnostic(
    allocator: Allocator,
    primary: std::kizu::diagnostic::FileSpan,
    message: []u8
) -> std::kizu::diagnostic::Diagnostic {
    return Diagnostic {
        primary: primary,
        message: message,
        related: std::array::Array<std::kizu::diagnostic::RelatedSpan>(allocator)
    };
}

impl Diagnostic {
    fn add_related(
        self: Diagnostic,
        span: std::kizu::diagnostic::FileSpan,
        message: []u8
    ) -> !void {
        let related = std::kizu::diagnostic::related_span(span, message);
        try self.related.append(related);
        return;
    }

    fn related_len(self: Diagnostic) -> i64 {
        return self.related.len();
    }

    fn related_get(
        self: Diagnostic,
        index: i64
    ) -> !std::kizu::diagnostic::RelatedSpan {
        return self.related.get(index);
    }

    fn deinit(self: Diagnostic) -> void {
        self.related.deinit();
    }
}
