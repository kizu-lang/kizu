fn parse_type_name(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let end = try std::kizu::parser::parse_type_end(text, token);
    let node = ast.add_type_name(
        std::kizu::ast::span(token.start, end.end),
        std::kizu::ast::symbol_id(token.start)
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, end));
}

