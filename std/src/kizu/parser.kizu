pub fn parse_first_node(source: []const u8) -> !std::kizu::ast::Node {
    let token = std::kizu::lexer::first_token(source);
    match token.kind {
        Fn => return std::kizu::parser::parse_fn_decl(source);
        Ident => return std::kizu::parser::parse_first_ident(source);
        Eof => return std::kizu::ast::empty();
    }
}

fn parse_fn_decl(source: []const u8) -> !std::kizu::ast::Node {
    let fn_token = std::kizu::lexer::first_token(source);
    let name = std::kizu::lexer::next_token(source, fn_token);
    match name.kind {
        Fn => return error("expected function name");
        Ident => return std::kizu::ast::fn_decl(name.start, name.end);
        Eof => return error("expected function name");
    }
}

fn parse_first_ident(source: []const u8) -> std::kizu::ast::Node {
    let token = std::kizu::lexer::first_token(source);
    return std::kizu::ast::ident(token.start, token.end);
}
