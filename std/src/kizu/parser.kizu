struct ParseNode {
    node: std::kizu::ast::NodeId;
    next: std::kizu::lexer::Token;
}

pub fn parse_first_node(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    let token = std::kizu::lexer::first_token(source.text);
    match token.kind {
        Fn => return std::kizu::parser::parse_fn_decl_result(allocator, source);
        Ident => return std::kizu::parser::parse_expr_result(allocator, source);
        Number => return std::kizu::parser::parse_expr_result(allocator, source);
        String => return std::kizu::parser::parse_expr_result(allocator, source);
        Eof => return std::kizu::parser::parse_empty_result(allocator, source, token.start);
        Return => return error("unexpected return");
        LBrace => return error("unexpected block");
        RBrace => return error("unexpected right brace");
        LParen => return error("unexpected left paren");
        RParen => return error("unexpected right paren");
        Semicolon => return error("unexpected semicolon");
        Comma => return error("unexpected comma");
        Colon => return error("unexpected colon");
        Arrow => return error("unexpected arrow");
        Plus => return error("unexpected plus");
        Asterisk => return error("unexpected asterisk");
    }
}

pub fn parse_program(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    let text = source.text;
    var ast = std::kizu::ast::Ast(allocator, source);
    var declarations = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_program_with_declarations(
        allocator,
        declarations,
        ast,
        text,
        std::kizu::lexer::first_token(text)
    );
    declarations.deinit();
    return result;
}

fn parse_program_with_declarations(
    allocator: Allocator,
    declarations: &mut std::array::Array<std::kizu::ast::NodeId>,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    first: std::kizu::lexer::Token
) -> !std::kizu::ast::ParseResult {
    var token = first;
    while !std::kizu::parser::is_eof_token(token) {
        let declaration = try std::kizu::parser::parse_top_level_decl(allocator, ast, text, token);
        try declarations.append(declaration.node);
        token = declaration.next;
    }
    let child_start = ast.begin_children();
    var index = 0;
    while index < declarations.len() {
        try ast.add_child(try declarations.get(index));
        index = index + 1;
    }
    let range = ast.finish_children(child_start);
    let root = ast.add_program(std::kizu::ast::span(first.start, token.end), range);
    return std::kizu::ast::parse_result(ast, root);
}

fn parse_top_level_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    match token.kind {
        Fn => return std::kizu::parser::parse_fn_decl(allocator, ast, text, token);
        Eof => return error("expected declaration");
        Return => return error("expected declaration");
        Ident => return error("expected declaration");
        Number => return error("expected declaration");
        String => return error("expected declaration");
        LBrace => return error("expected declaration");
        RBrace => return error("expected declaration");
        LParen => return error("expected declaration");
        RParen => return error("expected declaration");
        Semicolon => return error("expected declaration");
        Comma => return error("expected declaration");
        Colon => return error("expected declaration");
        Arrow => return error("expected declaration");
        Plus => return error("expected declaration");
        Asterisk => return error("expected declaration");
    }
}

fn parse_fn_decl_result(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    let text = source.text;
    var ast = std::kizu::ast::Ast(allocator, source);
    let fn_token = std::kizu::lexer::first_token(text);
    let root = try std::kizu::parser::parse_fn_decl(allocator, ast, text, fn_token);
    return std::kizu::ast::parse_result(ast, root.node);
}

fn parse_fn_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    fn_token: std::kizu::lexer::Token
) -> !ParseNode {
    let name = std::kizu::lexer::next_token(text, fn_token);
    match name.kind {
        Fn => return error("expected function name");
        Ident => return std::kizu::parser::parse_fn_body_node(allocator, ast, text, fn_token, name);
        Eof => return error("expected function name");
        Return => return error("expected function name");
        Number => return error("expected function name");
        String => return error("expected function name");
        LBrace => return error("expected function name");
        RBrace => return error("expected function name");
        LParen => return error("expected function name");
        RParen => return error("expected function name");
        Semicolon => return error("expected function name");
        Comma => return error("expected function name");
        Colon => return error("expected function name");
        Arrow => return error("expected function name");
        Plus => return error("expected function name");
        Asterisk => return error("expected function name");
    }
}

fn parse_expr_result(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    let text = source.text;
    var ast = std::kizu::ast::Ast(allocator, source);
    let expr = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::first_token(text)
    );
    return std::kizu::ast::parse_result(ast, expr.node);
}

fn parse_empty_result(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile,
    at: i64
) -> std::kizu::ast::ParseResult {
    var ast = std::kizu::ast::Ast(allocator, source);
    let root = ast.add_empty(at);
    return std::kizu::ast::parse_result(ast, root);
}

fn parse_fn_body_node(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    fn_token: std::kizu::lexer::Token,
    name: std::kizu::lexer::Token
) -> !ParseNode {
    let name_node = ast.add_var(
        std::kizu::ast::span(name.start, name.end),
        std::kizu::ast::symbol_id(name.start)
    );
    let params = try std::kizu::parser::parse_optional_params(ast, text, std::kizu::lexer::next_token(text, name));
    let return_type = try std::kizu::parser::parse_optional_return_type(ast, text, params.next);
    let body = try std::kizu::parser::parse_optional_block(allocator, ast, text, return_type.next);
    let body_node = ast.get(body.node);
    let root = ast.add_fn_decl(
        std::kizu::ast::span(fn_token.start, body_node.span.end),
        name_node,
        params.range,
        return_type.node,
        body.node
    );
    return std::kizu::parser::parse_node(root, body.next);
}

fn parse_optional_params(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseRange {
    match token.kind {
        LParen => return std::kizu::parser::parse_params(ast, text, token);
        LBrace => return std::kizu::parser::empty_range(ast, token);
        Eof => return std::kizu::parser::empty_range(ast, token);
        Fn => return error("expected params or block");
        Return => return error("expected params or block");
        Ident => return error("expected params or block");
        Number => return error("expected params or block");
        String => return error("expected params or block");
        RBrace => return error("expected params or block");
        RParen => return error("expected params or block");
        Semicolon => return error("expected params or block");
        Comma => return error("expected params or block");
        Colon => return error("expected params or block");
        Arrow => return error("expected params or block");
        Plus => return error("expected params or block");
        Asterisk => return error("expected params or block");
    }
}

fn parse_params(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseRange {
    let first = std::kizu::lexer::next_token(text, open);
    match first.kind {
        RParen => return std::kizu::parser::empty_range(ast, std::kizu::lexer::next_token(text, first));
        Ident => return std::kizu::parser::parse_non_empty_params(ast, text, first);
        Fn => return error("expected right paren");
        Return => return error("expected right paren");
        Number => return error("expected right paren");
        String => return error("expected right paren");
        LBrace => return error("expected right paren");
        LParen => return error("expected right paren");
        RBrace => return error("expected right paren");
        Semicolon => return error("expected right paren");
        Comma => return error("expected right paren");
        Colon => return error("expected right paren");
        Arrow => return error("expected right paren");
        Plus => return error("expected right paren");
        Asterisk => return error("expected right paren");
        Eof => return error("expected right paren");
    }
}

fn parse_non_empty_params(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    first: std::kizu::lexer::Token
) -> !ParseRange {
    let child_start = ast.begin_children();
    let close = try std::kizu::parser::parse_param_list(ast, text, first);
    let range = ast.finish_children(child_start);
    return ParseRange {
        range: range,
        next: std::kizu::lexer::next_token(text, close)
    };
}

fn parse_param_list(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    let param = try std::kizu::parser::parse_param(ast, text, token);
    try ast.add_child(param.node);
    match param.next.kind {
        Comma => return std::kizu::parser::parse_param_after_comma(
            ast,
            text,
            std::kizu::lexer::next_token(text, param.next)
        );
        RParen => return param.next;
        Fn => return error("expected comma or right paren");
        Return => return error("expected comma or right paren");
        Ident => return error("expected comma or right paren");
        Number => return error("expected comma or right paren");
        String => return error("expected comma or right paren");
        LBrace => return error("expected comma or right paren");
        LParen => return error("expected comma or right paren");
        RBrace => return error("expected comma or right paren");
        Semicolon => return error("expected comma or right paren");
        Colon => return error("expected comma or right paren");
        Arrow => return error("expected comma or right paren");
        Plus => return error("expected comma or right paren");
        Asterisk => return error("expected comma or right paren");
        Eof => return error("expected right paren");
    }
}

fn parse_param_after_comma(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    match token.kind {
        RParen => return token;
        Ident => return std::kizu::parser::parse_param_list(ast, text, token);
        Fn => return error("expected parameter");
        Return => return error("expected parameter");
        Number => return error("expected parameter");
        String => return error("expected parameter");
        LBrace => return error("expected parameter");
        LParen => return error("expected parameter");
        RBrace => return error("expected parameter");
        Semicolon => return error("expected parameter");
        Comma => return error("expected parameter");
        Colon => return error("expected parameter");
        Arrow => return error("expected parameter");
        Plus => return error("expected parameter");
        Asterisk => return error("expected parameter");
        Eof => return error("expected right paren");
    }
}

fn parse_param(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    name: std::kizu::lexer::Token
) -> !ParseNode {
    let colon = std::kizu::lexer::next_token(text, name);
    let type_token = try std::kizu::parser::expect_colon(text, colon);
    let type_name = try std::kizu::parser::parse_type_name(ast, text, type_token);
    let type_node = ast.get(type_name.node);
    let name_node = ast.add_var(
        std::kizu::ast::span(name.start, name.end),
        std::kizu::ast::symbol_id(name.start)
    );
    let node = ast.add_param(
        std::kizu::ast::span(name.start, type_node.span.end),
        name_node,
        type_name.node
    );
    return std::kizu::parser::parse_node(node, type_name.next);
}

fn expect_colon(
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    match token.kind {
        Colon => return std::kizu::lexer::next_token(text, token);
        Fn => return error("expected colon");
        Return => return error("expected colon");
        Ident => return error("expected colon");
        Number => return error("expected colon");
        String => return error("expected colon");
        LBrace => return error("expected colon");
        RBrace => return error("expected colon");
        LParen => return error("expected colon");
        RParen => return error("expected colon");
        Semicolon => return error("expected colon");
        Comma => return error("expected colon");
        Arrow => return error("expected colon");
        Plus => return error("expected colon");
        Asterisk => return error("expected colon");
        Eof => return error("expected colon");
    }
}

fn parse_optional_return_type(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    match token.kind {
        Arrow => return std::kizu::parser::parse_type_name(
            ast,
            text,
            std::kizu::lexer::next_token(text, token)
        );
        LBrace => return std::kizu::parser::empty_parse_node(ast, token);
        Eof => return std::kizu::parser::empty_parse_node(ast, token);
        Fn => return error("expected return type or block");
        Return => return error("expected return type or block");
        Ident => return error("expected return type or block");
        Number => return error("expected return type or block");
        String => return error("expected return type or block");
        RBrace => return error("expected return type or block");
        LParen => return error("expected return type or block");
        RParen => return error("expected return type or block");
        Semicolon => return error("expected return type or block");
        Comma => return error("expected return type or block");
        Colon => return error("expected return type or block");
        Plus => return error("expected return type or block");
        Asterisk => return error("expected return type or block");
    }
}

fn parse_type_name(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    match token.kind {
        Ident => return std::kizu::parser::parse_ident_type_name(ast, text, token);
        Fn => return error("expected type name");
        Return => return error("expected type name");
        Number => return error("expected type name");
        String => return error("expected type name");
        LBrace => return error("expected type name");
        RBrace => return error("expected type name");
        LParen => return error("expected type name");
        RParen => return error("expected type name");
        Semicolon => return error("expected type name");
        Comma => return error("expected type name");
        Colon => return error("expected type name");
        Arrow => return error("expected type name");
        Plus => return error("expected type name");
        Asterisk => return error("expected type name");
        Eof => return error("expected type name");
    }
}

fn parse_ident_type_name(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> ParseNode {
    let node = ast.add_type_name(
        std::kizu::ast::span(token.start, token.end),
        std::kizu::ast::symbol_id(token.start)
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, token));
}

fn parse_optional_block(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    match token.kind {
        LBrace => return std::kizu::parser::parse_block(allocator, ast, text, token);
        Eof => return std::kizu::parser::empty_parse_node(ast, token);
        Fn => return error("expected block");
        Return => return error("expected block");
        Ident => return error("expected block");
        Number => return error("expected block");
        String => return error("expected block");
        RBrace => return error("expected block");
        LParen => return error("expected block");
        RParen => return error("expected block");
        Semicolon => return error("expected block");
        Comma => return error("expected block");
        Colon => return error("expected block");
        Arrow => return error("expected block");
        Plus => return error("expected block");
        Asterisk => return error("expected block");
    }
}

fn parse_block(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseNode {
    var statements = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_block_with_statements(
        allocator,
        statements,
        ast,
        text,
        open
    );
    statements.deinit();
    return result;
}

fn parse_block_with_statements(
    allocator: Allocator,
    statements: &mut std::array::Array<std::kizu::ast::NodeId>,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseNode {
    var token = std::kizu::lexer::next_token(text, open);
    while !std::kizu::parser::is_block_close_token(token) {
        let statement = try std::kizu::parser::parse_statement(allocator, ast, text, token);
        try statements.append(statement.node);
        token = statement.next;
    }
    let close = try std::kizu::parser::expect_block_close(token);
    let child_start = ast.begin_children();
    var index = 0;
    while index < statements.len() {
        try ast.add_child(try statements.get(index));
        index = index + 1;
    }
    let range = ast.finish_children(child_start);
    let node = ast.add_block(std::kizu::ast::span(open.start, close.end), range);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, close));
}

fn is_eof_token(token: std::kizu::lexer::Token) -> bool {
    match token.kind {
        Eof => return true;
        Fn => return false;
        Return => return false;
        Ident => return false;
        Number => return false;
        String => return false;
        LBrace => return false;
        RBrace => return false;
        LParen => return false;
        RParen => return false;
        Semicolon => return false;
        Comma => return false;
        Colon => return false;
        Arrow => return false;
        Plus => return false;
        Asterisk => return false;
    }
}

fn is_block_close_token(token: std::kizu::lexer::Token) -> bool {
    match token.kind {
        RBrace => return true;
        Fn => return false;
        Return => return false;
        Ident => return false;
        Number => return false;
        String => return false;
        LBrace => return false;
        LParen => return false;
        RParen => return false;
        Semicolon => return false;
        Comma => return false;
        Colon => return false;
        Arrow => return false;
        Plus => return false;
        Asterisk => return false;
        Eof => return false;
    }
}

fn parse_statement(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    match token.kind {
        Return => return std::kizu::parser::parse_return(allocator, ast, text, token);
        Ident => return std::kizu::parser::parse_expr_statement(allocator, ast, text, token);
        Number => return std::kizu::parser::parse_expr_statement(allocator, ast, text, token);
        String => return std::kizu::parser::parse_expr_statement(allocator, ast, text, token);
        Fn => return error("expected statement");
        LBrace => return error("expected statement");
        RBrace => return error("expected statement");
        LParen => return error("expected statement");
        RParen => return error("expected statement");
        Semicolon => return error("expected statement");
        Comma => return error("expected statement");
        Colon => return error("expected statement");
        Arrow => return error("expected statement");
        Plus => return error("expected statement");
        Asterisk => return error("expected statement");
        Eof => return error("expected right brace");
    }
}

fn expect_block_close(token: std::kizu::lexer::Token) -> !std::kizu::lexer::Token {
    match token.kind {
        RBrace => return token;
        Return => return error("expected statement");
        Eof => return error("expected right brace");
        Fn => return error("expected statement");
        Ident => return error("expected statement");
        Number => return error("expected statement");
        String => return error("expected statement");
        LBrace => return error("expected statement");
        LParen => return error("expected statement");
        RParen => return error("expected statement");
        Semicolon => return error("expected statement");
        Comma => return error("expected statement");
        Colon => return error("expected statement");
        Arrow => return error("expected statement");
        Plus => return error("expected statement");
        Asterisk => return error("expected statement");
    }
}

fn parse_return(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let value = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, token)
    );
    match value.next.kind {
        Semicolon => return std::kizu::parser::finish_return(ast, text, token, value);
        Fn => return error("expected semicolon");
        Return => return error("expected semicolon");
        Ident => return error("expected semicolon");
        Number => return error("expected semicolon");
        String => return error("expected semicolon");
        LBrace => return error("expected semicolon");
        RBrace => return error("expected semicolon");
        LParen => return error("expected semicolon");
        RParen => return error("expected semicolon");
        Eof => return error("expected semicolon");
        Comma => return error("expected semicolon");
        Colon => return error("expected semicolon");
        Arrow => return error("expected semicolon");
        Plus => return error("expected semicolon");
        Asterisk => return error("expected semicolon");
    }
}

fn finish_return(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    value: ParseNode
) -> ParseNode {
    let node = ast.add_return(std::kizu::ast::span(token.start, value.next.end), value.node);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, value.next));
}

fn parse_expr_statement(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let expr = try std::kizu::parser::parse_expr(allocator, ast, text, token);
    match expr.next.kind {
        Semicolon => return std::kizu::parser::finish_expr_statement(ast, text, expr);
        Fn => return error("expected semicolon");
        Return => return error("expected semicolon");
        Ident => return error("expected semicolon");
        Number => return error("expected semicolon");
        String => return error("expected semicolon");
        LBrace => return error("expected semicolon");
        RBrace => return error("expected semicolon");
        LParen => return error("expected semicolon");
        RParen => return error("expected semicolon");
        Eof => return error("expected semicolon");
        Comma => return error("expected semicolon");
        Colon => return error("expected semicolon");
        Arrow => return error("expected semicolon");
        Plus => return error("expected semicolon");
        Asterisk => return error("expected semicolon");
    }
}

fn finish_expr_statement(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    expr: ParseNode
) -> ParseNode {
    let expr_node = ast.get(expr.node);
    let node = ast.add_expr_stmt(std::kizu::ast::span(expr_node.span.start, expr.next.end), expr.node);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, expr.next));
}

fn parse_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    return std::kizu::parser::parse_binary_expr(allocator, ast, text, token, 0);
}

fn parse_binary_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    min_precedence: i64
) -> !ParseNode {
    var left = try std::kizu::parser::parse_primary(allocator, ast, text, token);
    var precedence = std::kizu::parser::binary_precedence(left.next);
    while precedence >= min_precedence {
        let op = left.next;
        let right_token = std::kizu::lexer::next_token(text, op);
        let right = try std::kizu::parser::parse_binary_expr(
            allocator,
            ast,
            text,
            right_token,
            precedence + 1
        );
        left = try std::kizu::parser::finish_binary(ast, op, left, right);
        precedence = std::kizu::parser::binary_precedence(left.next);
    }
    return left;
}

fn binary_precedence(token: std::kizu::lexer::Token) -> i64 {
    match token.kind {
        Plus => return 10;
        Asterisk => return 20;
        Fn => return 0 - 1;
        Return => return 0 - 1;
        Ident => return 0 - 1;
        Number => return 0 - 1;
        String => return 0 - 1;
        LBrace => return 0 - 1;
        RBrace => return 0 - 1;
        LParen => return 0 - 1;
        RParen => return 0 - 1;
        Semicolon => return 0 - 1;
        Comma => return 0 - 1;
        Colon => return 0 - 1;
        Arrow => return 0 - 1;
        Eof => return 0 - 1;
    }
}

fn finish_binary(
    ast: std::kizu::ast::Ast,
    op: std::kizu::lexer::Token,
    left: ParseNode,
    right: ParseNode
) -> !ParseNode {
    let left_node = ast.get(left.node);
    let right_node = ast.get(right.node);
    let node = ast.add_binary(
        std::kizu::ast::span(left_node.span.start, right_node.span.end),
        try std::kizu::parser::binary_op(op),
        left.node,
        right.node
    );
    return std::kizu::parser::parse_node(node, right.next);
}

fn binary_op(token: std::kizu::lexer::Token) -> !std::kizu::ast::BinaryOp {
    match token.kind {
        Plus => return std::kizu::ast::binary_add();
        Asterisk => return std::kizu::ast::binary_mul();
        Fn => return error("expected binary operator");
        Return => return error("expected binary operator");
        Ident => return error("expected binary operator");
        Number => return error("expected binary operator");
        String => return error("expected binary operator");
        LBrace => return error("expected binary operator");
        RBrace => return error("expected binary operator");
        LParen => return error("expected binary operator");
        RParen => return error("expected binary operator");
        Semicolon => return error("expected binary operator");
        Comma => return error("expected binary operator");
        Colon => return error("expected binary operator");
        Arrow => return error("expected binary operator");
        Eof => return error("expected binary operator");
    }
}

fn parse_primary(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    match token.kind {
        Ident => return std::kizu::parser::parse_ident_or_call(allocator, ast, text, token);
        Number => return std::kizu::parser::parse_int(ast, text, token);
        String => return std::kizu::parser::parse_string(ast, text, token);
        Fn => return error("expected expression");
        Return => return error("expected expression");
        LBrace => return error("expected expression");
        RBrace => return error("expected expression");
        LParen => return error("expected expression");
        RParen => return error("expected expression");
        Semicolon => return error("expected expression");
        Comma => return error("expected expression");
        Colon => return error("expected expression");
        Arrow => return error("expected expression");
        Plus => return error("expected expression");
        Asterisk => return error("expected expression");
        Eof => return error("expected expression");
    }
}

fn parse_int(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> ParseNode {
    let node = ast.add_int(
        std::kizu::ast::span(token.start, token.end),
        std::kizu::ast::token_id(token.start)
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, token));
}

fn parse_string(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> ParseNode {
    let node = ast.add_string(
        std::kizu::ast::span(token.start, token.end),
        std::kizu::ast::token_id(token.start)
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, token));
}

fn parse_ident_or_call(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let callee = ast.add_var(
        std::kizu::ast::span(token.start, token.end),
        std::kizu::ast::symbol_id(token.start)
    );
    let next = std::kizu::lexer::next_token(text, token);
    match next.kind {
        LParen => return std::kizu::parser::parse_call(allocator, ast, text, token, callee, next);
        Fn => return std::kizu::parser::parse_node(callee, next);
        Return => return std::kizu::parser::parse_node(callee, next);
        Ident => return std::kizu::parser::parse_node(callee, next);
        Number => return std::kizu::parser::parse_node(callee, next);
        String => return std::kizu::parser::parse_node(callee, next);
        LBrace => return std::kizu::parser::parse_node(callee, next);
        RBrace => return std::kizu::parser::parse_node(callee, next);
        RParen => return std::kizu::parser::parse_node(callee, next);
        Semicolon => return std::kizu::parser::parse_node(callee, next);
        Comma => return std::kizu::parser::parse_node(callee, next);
        Colon => return std::kizu::parser::parse_node(callee, next);
        Arrow => return std::kizu::parser::parse_node(callee, next);
        Plus => return std::kizu::parser::parse_node(callee, next);
        Asterisk => return std::kizu::parser::parse_node(callee, next);
        Eof => return std::kizu::parser::parse_node(callee, next);
    }
}

fn parse_call(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    callee_token: std::kizu::lexer::Token,
    callee: std::kizu::ast::NodeId,
    open: std::kizu::lexer::Token
) -> !ParseNode {
    var args = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_call_with_args(args, allocator, ast, text, callee_token, callee, open);
    args.deinit();
    return result;
}

fn parse_call_with_args(
    args: &mut std::array::Array<std::kizu::ast::NodeId>,
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    callee_token: std::kizu::lexer::Token,
    callee: std::kizu::ast::NodeId,
    open: std::kizu::lexer::Token
) -> !ParseNode {
    var close = std::kizu::lexer::next_token(text, open);
    while !std::kizu::parser::is_call_close_token(close) {
        let start_token = try std::kizu::parser::expect_call_arg_start(close);
        let arg = try std::kizu::parser::parse_expr(allocator, ast, text, start_token);
        try args.append(arg.node);
        close = try std::kizu::parser::next_call_arg_token(text, arg.next);
    }
    let start = ast.begin_children();
    var index = 0;
    while index < args.len() {
        try ast.add_child(try args.get(index));
        index = index + 1;
    }
    let range = ast.finish_children(start);
    let node = ast.add_call(std::kizu::ast::span(callee_token.start, close.end), callee, range);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, close));
}

fn is_call_close_token(token: std::kizu::lexer::Token) -> bool {
    match token.kind {
        RParen => return true;
        Fn => return false;
        Return => return false;
        Ident => return false;
        Number => return false;
        String => return false;
        LBrace => return false;
        RBrace => return false;
        LParen => return false;
        Semicolon => return false;
        Comma => return false;
        Colon => return false;
        Arrow => return false;
        Plus => return false;
        Asterisk => return false;
        Eof => return false;
    }
}

fn expect_call_arg_start(
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    match token.kind {
        Ident => return token;
        Number => return token;
        String => return token;
        Fn => return error("expected call arg");
        Return => return error("expected call arg");
        LBrace => return error("expected call arg");
        RBrace => return error("expected call arg");
        LParen => return error("expected call arg");
        RParen => return error("expected call arg");
        Semicolon => return error("expected call arg");
        Comma => return error("expected call arg");
        Colon => return error("expected call arg");
        Arrow => return error("expected call arg");
        Plus => return error("expected call arg");
        Asterisk => return error("expected call arg");
        Eof => return error("expected right paren");
    }
}

fn next_call_arg_token(
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    match token.kind {
        Comma => return std::kizu::lexer::next_token(text, token);
        RParen => return token;
        Fn => return error("expected comma or right paren");
        Return => return error("expected comma or right paren");
        Ident => return error("expected comma or right paren");
        Number => return error("expected comma or right paren");
        String => return error("expected comma or right paren");
        LBrace => return error("expected comma or right paren");
        LParen => return error("expected comma or right paren");
        RBrace => return error("expected comma or right paren");
        Semicolon => return error("expected comma or right paren");
        Colon => return error("expected comma or right paren");
        Arrow => return error("expected comma or right paren");
        Plus => return error("expected comma or right paren");
        Asterisk => return error("expected comma or right paren");
        Eof => return error("expected right paren");
    }
}

fn empty_parse_node(ast: std::kizu::ast::Ast, token: std::kizu::lexer::Token) -> ParseNode {
    return std::kizu::parser::parse_node(ast.add_empty(token.start), token);
}

fn parse_node(node: std::kizu::ast::NodeId, next: std::kizu::lexer::Token) -> ParseNode {
    return ParseNode {
        node: node,
        next: next
    };
}

struct ParseRange {
    range: std::kizu::ast::ChildRange;
    next: std::kizu::lexer::Token;
}

fn empty_range(ast: std::kizu::ast::Ast, next: std::kizu::lexer::Token) -> ParseRange {
    let start = ast.begin_children();
    return ParseRange {
        range: ast.finish_children(start),
        next: next
    };
}
