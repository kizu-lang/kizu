fn parse_let(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    mutable: bool
) -> !ParseNode {
    let name_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, token));
    let name = ast.add_var(
        std::kizu::ast::span(name_token.start, name_token.end),
        std::kizu::ast::symbol_id(name_token.start)
    );
    let assign = try std::kizu::parser::expect_assign(std::kizu::lexer::next_token(text, name_token));
    let value = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, assign)
    );
    let semicolon = try std::kizu::parser::expect_semicolon(value.next);
    let node = ast.add_let(
        std::kizu::ast::span(token.start, semicolon.end),
        mutable,
        name,
        value.node
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, semicolon));
}

