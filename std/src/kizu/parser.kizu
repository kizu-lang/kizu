fn parse_non_empty_params(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    first: std::kizu::lexer::Token
) -> !ParseRange {
    let child_start = ast.begin_children();
    let close = try std::kizu::parser::parse_param_list(ast, text, first);
    let range = ast.finish_children(child_start);
    return ParseRange {
        range: range,
        next: std::kizu::lexer::next_token(text, close)
    };
}

fn parse_param_list(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    let param = try std::kizu::parser::parse_param(ast, text, token);
    try ast.add_child(param.node);
    match param.next.kind {
        Import => return error("expected comma or right paren");
        Pub => return error("expected comma or right paren");
        Struct => return error("expected comma or right paren");
        Enum => return error("expected comma or right paren");
        Union => return error("expected comma or right paren");
        Extern => return error("expected comma or right paren");
        Comma => return std::kizu::parser::parse_param_after_comma(
            ast,
            text,
            std::kizu::lexer::next_token(text, param.next)
        );
        RParen => return param.next;
        Fn => return error("expected comma or right paren");
        Return => return error("expected comma or right paren");
        Ident => return error("expected comma or right paren");
        Lifetime => return error("expected comma or right paren");
        Number => return error("expected comma or right paren");
        String => return error("expected comma or right paren");
        LBrace => return error("expected comma or right paren");
        LParen => return error("expected comma or right paren");
