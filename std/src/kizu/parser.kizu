        Percent => return error("expected parameter");
        Dot => return error("expected parameter");
        Range => return error("expected parameter");
        Pipe => return error("expected parameter");
}
}

fn parse_param(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    var is_comptime = false;
    var name = token;
    if std::kizu::parser::is_comptime_token(token) {
        is_comptime = true;
        name = std::kizu::lexer::next_token(text, token);
    }
    name = try std::kizu::parser::expect_ident(name);
    let colon = std::kizu::lexer::next_token(text, name);
    let type_token = try std::kizu::parser::expect_colon(text, colon);
    let type_name = try std::kizu::parser::parse_type_name(ast, text, type_token);
    let type_node = ast.get(type_name.node);
    let name_node = ast.add_var(
        std::kizu::ast::span(name.start, name.end),
        std::kizu::ast::symbol_id(name.start)
    );
    let node = ast.add_param(
        std::kizu::ast::span(token.start, type_node.span.end),
        is_comptime,
        name_node,
        type_name.node
    );
    return std::kizu::parser::parse_node(node, type_name.next);
}

