        Arrow => return error("expected parameter");
        Bang => return error("expected parameter");
        Amp => return error("expected parameter");
        Mut => return error("expected parameter");
        LBracket => return error("expected parameter");
        RBracket => return error("expected parameter");
        LT => return error("expected parameter");
        GT => return error("expected parameter");
        Question => return error("expected parameter");
        DoubleColon => return error("expected parameter");
        Plus => return error("expected parameter");
        Asterisk => return error("expected parameter");
        Eof => return error("expected right paren");
        Let => return error("expected parameter");
        Var => return error("expected parameter");
        If => return error("expected parameter");
        Else => return error("expected parameter");
        While => return error("expected parameter");
        For => return error("expected parameter");
        Break => return error("expected parameter");
