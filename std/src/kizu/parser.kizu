fn parse_labeled_statement(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    label_token: std::kizu::lexer::Token
) -> !ParseNode {
    let label = ast.add_var(
        std::kizu::ast::span(label_token.start, label_token.end),
        std::kizu::ast::symbol_id(label_token.start)
    );
    let loop_token = std::kizu::lexer::next_token(
        text,
        std::kizu::lexer::next_token(text, label_token)
    );
    match loop_token.kind {
        Import => return error("label must attach to loop");
        Pub => return error("label must attach to loop");
        Struct => return error("label must attach to loop");
        Enum => return error("label must attach to loop");
        Union => return error("label must attach to loop");
        Extern => return error("label must attach to loop");
        While => return std::kizu::parser::parse_while(allocator, ast, text, loop_token, label);
        For => return std::kizu::parser::parse_for(allocator, ast, text, loop_token, label);
        Fn => return error("label must attach to loop");
        Let => return error("label must attach to loop");
        Var => return error("label must attach to loop");
        Return => return error("label must attach to loop");
        If => return error("label must attach to loop");
        Else => return error("label must attach to loop");
        Break => return error("label must attach to loop");
        Continue => return error("label must attach to loop");
        Match => return error("label must attach to loop");
        Unsafe => return error("label must attach to loop");
        Comptime => return error("label must attach to loop");
        Try => return error("label must attach to loop");
        True => return error("label must attach to loop");
        False => return error("label must attach to loop");
        And => return error("label must attach to loop");
        Or => return error("label must attach to loop");
        Ident => return error("label must attach to loop");
        Lifetime => return error("label must attach to loop");
        Number => return error("label must attach to loop");
        String => return error("label must attach to loop");
        LBrace => return error("label must attach to loop");
        RBrace => return error("label must attach to loop");
        LParen => return error("label must attach to loop");
        RParen => return error("label must attach to loop");
        Semicolon => return error("label must attach to loop");
        Comma => return error("label must attach to loop");
        Colon => return error("label must attach to loop");
        DoubleColon => return error("label must attach to loop");
        Assign => return error("label must attach to loop");
        Arrow => return error("label must attach to loop");
        FatArrow => return error("label must attach to loop");
        Bang => return error("label must attach to loop");
        Eq => return error("label must attach to loop");
        NotEq => return error("label must attach to loop");
        Amp => return error("label must attach to loop");
        LBracket => return error("label must attach to loop");
        RBracket => return error("label must attach to loop");
        LT => return error("label must attach to loop");
        LTE => return error("label must attach to loop");
        GT => return error("label must attach to loop");
        GTE => return error("label must attach to loop");
        Question => return error("label must attach to loop");
        Plus => return error("label must attach to loop");
        Minus => return error("label must attach to loop");
        Asterisk => return error("label must attach to loop");
        Slash => return error("label must attach to loop");
        Percent => return error("label must attach to loop");
        Dot => return error("label must attach to loop");
        Range => return error("label must attach to loop");
        Pipe => return error("label must attach to loop");
        Mut => return error("label must attach to loop");
        Eof => return error("label must attach to loop");
    }
}

