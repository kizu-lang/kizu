fn parse_return_value(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    value_token: std::kizu::lexer::Token
) -> !ParseNode {
    let value = try std::kizu::parser::parse_expr(allocator, ast, text, value_token);
    let semicolon = try std::kizu::parser::expect_semicolon(value.next);
    let node = ast.add_return(std::kizu::ast::span(token.start, semicolon.end), value.node);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, semicolon));
}

fn finish_empty_return(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    semicolon: std::kizu::lexer::Token
) -> ParseNode {
    let node = ast.add_return(
        std::kizu::ast::span(token.start, semicolon.end),
        ast.add_empty(semicolon.start)
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, semicolon));
}

fn parse_expr_or_assign_statement(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let expr = try std::kizu::parser::parse_expr(allocator, ast, text, token);
    match expr.next.kind {
        Import => return error("expected semicolon");
        Pub => return error("expected semicolon");
        Struct => return error("expected semicolon");
        Enum => return error("expected semicolon");
        Union => return error("expected semicolon");
        Extern => return error("expected semicolon");
        Assign => return std::kizu::parser::parse_assign(allocator, ast, text, expr);
        Semicolon => return std::kizu::parser::finish_expr_statement(ast, text, expr, expr.next);
        Fn => return error("expected semicolon");
        Let => return error("expected semicolon");
        Var => return error("expected semicolon");
        Return => return error("expected semicolon");
        If => return error("expected semicolon");
        Else => return error("expected semicolon");
        While => return error("expected semicolon");
        For => return error("expected semicolon");
        Break => return error("expected semicolon");
        Continue => return error("expected semicolon");
        Match => return error("expected semicolon");
        Unsafe => return error("expected semicolon");
        Comptime => return error("expected semicolon");
        Try => return error("expected semicolon");
        True => return error("expected semicolon");
        False => return error("expected semicolon");
        And => return error("expected semicolon");
        Or => return error("expected semicolon");
        Ident => return error("expected semicolon");
        Lifetime => return error("expected semicolon");
        Number => return error("expected semicolon");
        String => return error("expected semicolon");
        LBrace => return error("expected semicolon");
        RBrace => return error("expected semicolon");
        LParen => return error("expected semicolon");
        RParen => return error("expected semicolon");
        Eof => return error("expected semicolon");
        Comma => return error("expected semicolon");
        Colon => return error("expected semicolon");
        Arrow => return error("expected semicolon");
        FatArrow => return error("expected semicolon");
        Bang => return error("expected semicolon");
        Eq => return error("expected semicolon");
        NotEq => return error("expected semicolon");
        Amp => return error("expected semicolon");
        Mut => return error("expected semicolon");
        LBracket => return error("expected semicolon");
        RBracket => return error("expected semicolon");
        LT => return error("expected semicolon");
        LTE => return error("expected semicolon");
        GT => return error("expected semicolon");
        GTE => return error("expected semicolon");
        Question => return error("expected semicolon");
        DoubleColon => return error("expected semicolon");
        Plus => return error("expected semicolon");
        Minus => return error("expected semicolon");
        Asterisk => return error("expected semicolon");
        Slash => return error("expected semicolon");
        Percent => return error("expected semicolon");
        Dot => return error("expected semicolon");
        Range => return error("expected semicolon");
        Pipe => return error("expected semicolon");
    }
}

fn parse_assign(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    target: ParseNode
) -> !ParseNode {
    let value = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, target.next)
    );
    let semicolon = try std::kizu::parser::expect_semicolon(value.next);
    let target_node = ast.get(target.node);
    let node = ast.add_assign(
        std::kizu::ast::span(target_node.span.start, semicolon.end),
        target.node,
        value.node
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, semicolon));
}

fn finish_expr_statement(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    expr: ParseNode,
    semicolon: std::kizu::lexer::Token
) -> ParseNode {
    let expr_node = ast.get(expr.node);
    let node = ast.add_expr_stmt(std::kizu::ast::span(expr_node.span.start, semicolon.end), expr.node);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, semicolon));
}

fn parse_if(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let condition = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, token)
    );
    let then_open = try std::kizu::parser::expect_lbrace(condition.next);
    let then_block = try std::kizu::parser::parse_block(allocator, ast, text, then_open);
    let else_block = try std::kizu::parser::parse_optional_else(allocator, ast, text, then_block.next);
    let else_node = ast.get(else_block.node);
    let node = ast.add_if(
        std::kizu::ast::span(token.start, else_node.span.end),
        condition.node,
        then_block.node,
        else_block.node
    );
    return std::kizu::parser::parse_node(node, else_block.next);
}

fn parse_else_block(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let open = try std::kizu::parser::expect_lbrace(std::kizu::lexer::next_token(text, token));
    return std::kizu::parser::parse_block(allocator, ast, text, open);
}

fn parse_while(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    label: std::kizu::ast::NodeId
) -> !ParseNode {
    let condition = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, token)
    );
    let open = try std::kizu::parser::expect_lbrace(condition.next);
    let body = try std::kizu::parser::parse_block(allocator, ast, text, open);
    let body_node = ast.get(body.node);
    let label_node = ast.get(label);
    let node = ast.add_while(
        std::kizu::ast::span(label_node.span.start, body_node.span.end),
        label,
        condition.node,
        body.node
    );
    return std::kizu::parser::parse_node(node, body.next);
}

fn parse_for(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    label: std::kizu::ast::NodeId
) -> !ParseNode {
    let start_expr = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, token)
    );
    let range = try std::kizu::parser::expect_range(start_expr.next);
    let end_expr = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, range)
    );
    let first_pipe = try std::kizu::parser::expect_pipe(end_expr.next);
    let name_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, first_pipe));
    let name = ast.add_var(
        std::kizu::ast::span(name_token.start, name_token.end),
        std::kizu::ast::symbol_id(name_token.start)
    );
    let second_pipe = try std::kizu::parser::expect_pipe(std::kizu::lexer::next_token(text, name_token));
    let open = try std::kizu::parser::expect_lbrace(std::kizu::lexer::next_token(text, second_pipe));
    let body = try std::kizu::parser::parse_block(allocator, ast, text, open);
    let body_node = ast.get(body.node);
    let label_node = ast.get(label);
    let node = ast.add_for(
        std::kizu::ast::span(label_node.span.start, body_node.span.end),
        label,
        name,
        start_expr.node,
        end_expr.node,
        body.node
    );
    return std::kizu::parser::parse_node(node, body.next);
}

fn parse_break(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let label = try std::kizu::parser::parse_optional_branch_label(ast, text, token);
    let semicolon = try std::kizu::parser::expect_semicolon(label.next);
    let node = ast.add_break(std::kizu::ast::span(token.start, semicolon.end), label.node);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, semicolon));
}

fn parse_continue(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let label = try std::kizu::parser::parse_optional_branch_label(ast, text, token);
    let semicolon = try std::kizu::parser::expect_semicolon(label.next);
    let node = ast.add_continue(std::kizu::ast::span(token.start, semicolon.end), label.node);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, semicolon));
}

fn parse_branch_label(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    colon: std::kizu::lexer::Token
) -> !ParseNode {
    let label_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, colon));
    let label = ast.add_var(
        std::kizu::ast::span(label_token.start, label_token.end),
        std::kizu::ast::symbol_id(label_token.start)
    );
    return std::kizu::parser::parse_node(label, std::kizu::lexer::next_token(text, label_token));
}

fn parse_unsafe(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let open = try std::kizu::parser::expect_lbrace(std::kizu::lexer::next_token(text, token));
    let body = try std::kizu::parser::parse_block(allocator, ast, text, open);
    let body_node = ast.get(body.node);
    let node = ast.add_unsafe(std::kizu::ast::span(token.start, body_node.span.end), body.node);
    return std::kizu::parser::parse_node(node, body.next);
}

fn parse_comptime_if(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    comptime_token: std::kizu::lexer::Token
) -> !ParseNode {
    let if_token = std::kizu::lexer::next_token(text, comptime_token);
    let condition = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, if_token)
    );
    let then_open = try std::kizu::parser::expect_lbrace(condition.next);
    let then_block = try std::kizu::parser::parse_block(allocator, ast, text, then_open);
    let else_block = try std::kizu::parser::parse_optional_else(allocator, ast, text, then_block.next);
    let else_node = ast.get(else_block.node);
    let node = ast.add_comptime_if(
        std::kizu::ast::span(comptime_token.start, else_node.span.end),
        condition.node,
        then_block.node,
        else_block.node
    );
    return std::kizu::parser::parse_node(node, else_block.next);
}

fn parse_match(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let value = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, token)
    );
    let open = try std::kizu::parser::expect_lbrace(value.next);
    var arms = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_match_with_arms(allocator, arms, ast, text, token, value, open);
    arms.deinit();
    return result;
}

fn parse_match_with_arms(
    allocator: Allocator,
    arms: &mut std::array::Array<std::kizu::ast::NodeId>,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    match_token: std::kizu::lexer::Token,
    value: ParseNode,
    open: std::kizu::lexer::Token
) -> !ParseNode {
    var token = std::kizu::lexer::next_token(text, open);
    while !std::kizu::parser::is_block_close_token(token) {
        let arm = try std::kizu::parser::parse_match_arm(allocator, ast, text, token);
        try arms.append(arm.node);
        token = std::kizu::parser::next_match_arm_token(text, arm.next);
    }
    let close = try std::kizu::parser::expect_block_close(token);
    let start = ast.begin_children();
    var index = 0;
    while index < arms.len() {
        try ast.add_child(try arms.get(index));
        index = index + 1;
    }
    let range = ast.finish_children(start);
    let node = ast.add_match(std::kizu::ast::span(match_token.start, close.end), value.node, range);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, close));
}

fn parse_match_arm(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    pattern_token: std::kizu::lexer::Token
) -> !ParseNode {
    let pattern = ast.add_var(
        std::kizu::ast::span(pattern_token.start, pattern_token.end),
        std::kizu::ast::symbol_id(pattern_token.start)
    );
    let after_pattern = std::kizu::lexer::next_token(text, pattern_token);
    let binding = try std::kizu::parser::parse_optional_match_binding(ast, text, after_pattern);
    let arrow = try std::kizu::parser::expect_fat_arrow(binding.next);
    let body = try std::kizu::parser::parse_statement(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, arrow)
    );
    let body_node = ast.get(body.node);
    let node = ast.add_match_arm(
        std::kizu::ast::span(pattern_token.start, body_node.span.end),
        pattern,
        binding.node,
        body.node
    );
    return std::kizu::parser::parse_node(node, body.next);
}

fn parse_match_binding(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseNode {
    let name_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, open));
    let close = try std::kizu::parser::expect_right_paren(std::kizu::lexer::next_token(text, name_token));
    let name = ast.add_var(
        std::kizu::ast::span(name_token.start, name_token.end),
        std::kizu::ast::symbol_id(name_token.start)
    );
    return std::kizu::parser::parse_node(name, std::kizu::lexer::next_token(text, close));
}

fn parse_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    return std::kizu::parser::parse_binary_expr(allocator, ast, text, token, 0);
}

fn parse_binary_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    min_precedence: i64
) -> !ParseNode {
    var left = try std::kizu::parser::parse_primary(allocator, ast, text, token);
    var precedence = std::kizu::parser::binary_precedence(left.next);
    while precedence >= min_precedence {
        let op = left.next;
        let right_token = std::kizu::lexer::next_token(text, op);
        let right = try std::kizu::parser::parse_binary_expr(
            allocator,
            ast,
            text,
            right_token,
            precedence + 1
        );
        left = try std::kizu::parser::finish_binary(ast, op, left, right);
        precedence = std::kizu::parser::binary_precedence(left.next);
    }
    return left;
}

fn finish_binary(
    ast: std::kizu::ast::Ast,
    op: std::kizu::lexer::Token,
    left: ParseNode,
    right: ParseNode
) -> !ParseNode {
    let left_node = ast.get(left.node);
    let right_node = ast.get(right.node);
    let node = ast.add_binary(
        std::kizu::ast::span(left_node.span.start, right_node.span.end),
        try std::kizu::parser::binary_op(op),
        left.node,
        right.node
    );
    return std::kizu::parser::parse_node(node, right.next);
}

fn parse_primary(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    match token.kind {
        Import => return error("expected expression");
        Pub => return error("expected expression");
        Struct => return error("expected expression");
        Enum => return error("expected expression");
        Union => return error("expected expression");
        Extern => return error("expected expression");
        Ident => return std::kizu::parser::parse_ident_primary(allocator, ast, text, token);
        Lifetime => return error("expected expression");
        Number => return std::kizu::parser::parse_postfix_expr(
            allocator,
            ast,
            text,
            std::kizu::parser::parse_int(ast, text, token)
        );
        String => return std::kizu::parser::parse_postfix_expr(
            allocator,
            ast,
            text,
            std::kizu::parser::parse_string(ast, text, token)
        );
        True => return std::kizu::parser::parse_bool(ast, text, token, true);
        False => return std::kizu::parser::parse_bool(ast, text, token, false);
        Try => return std::kizu::parser::parse_try_expr(allocator, ast, text, token);
        Comptime => return std::kizu::parser::parse_comptime_expr(allocator, ast, text, token);
        Bang => return std::kizu::parser::parse_prefix_expr(allocator, ast, text, token);
        Minus => return std::kizu::parser::parse_prefix_expr(allocator, ast, text, token);
        Amp => return std::kizu::parser::parse_prefix_expr(allocator, ast, text, token);
        LParen => return std::kizu::parser::parse_grouped_expr(allocator, ast, text, token);
        Fn => return error("expected expression");
        Let => return error("expected expression");
        Var => return error("expected expression");
        Return => return error("expected expression");
        If => return error("expected expression");
        Else => return error("expected expression");
        While => return error("expected expression");
        For => return error("expected expression");
        Break => return error("expected expression");
        Continue => return error("expected expression");
        Match => return error("expected expression");
        Unsafe => return error("expected expression");
        And => return error("expected expression");
        Or => return error("expected expression");
        LBrace => return error("expected expression");
        RBrace => return error("expected expression");
        RParen => return error("expected expression");
        Semicolon => return error("expected expression");
        Comma => return error("expected expression");
        Colon => return error("expected expression");
        DoubleColon => return error("expected expression");
        Assign => return error("expected expression");
        Arrow => return error("expected expression");
        FatArrow => return error("expected expression");
        Eq => return error("expected expression");
        NotEq => return error("expected expression");
        Mut => return error("expected expression");
        LBracket => return error("expected expression");
        RBracket => return error("expected expression");
        LT => return error("expected expression");
        LTE => return error("expected expression");
        GT => return error("expected expression");
        GTE => return error("expected expression");
        Question => return error("expected expression");
        Plus => return error("expected expression");
        Asterisk => return error("expected expression");
        Slash => return error("expected expression");
        Percent => return error("expected expression");
        Dot => return error("expected expression");
        Range => return error("expected expression");
        Pipe => return error("expected expression");
        Eof => return error("expected expression");
    }
}

fn parse_int(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> ParseNode {
    let node = ast.add_int(
        std::kizu::ast::span(token.start, token.end),
        std::kizu::ast::token_id(token.start)
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, token));
}

fn parse_string(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> ParseNode {
    let node = ast.add_string(
        std::kizu::ast::span(token.start, token.end),
        std::kizu::ast::token_id(token.start)
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, token));
}

fn parse_bool(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    value: bool
) -> ParseNode {
    let node = ast.add_bool(std::kizu::ast::span(token.start, token.end), value);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, token));
}

fn parse_ident(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> ParseNode {
    let node = ast.add_var(
        std::kizu::ast::span(token.start, token.end),
        std::kizu::ast::symbol_id(token.start)
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, token));
}

fn parse_ident_primary(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let next = std::kizu::lexer::next_token(text, token);
    let cast_name = try std::kizu::parser::is_token_text(text, token, "cast");
    if cast_name {
        if std::kizu::parser::is_lt_token(next) {
            return std::kizu::parser::parse_cast_expr(allocator, ast, text, token);
        }
    }
    let arena_name = try std::kizu::parser::is_token_text(text, token, "arena");
    if arena_name {
        if std::kizu::parser::is_lt_token(next) {
            return std::kizu::parser::parse_arena_new_expr(allocator, ast, text, token);
        }
    }
    return std::kizu::parser::parse_postfix_expr(
        allocator,
        ast,
        text,
        std::kizu::parser::parse_ident(ast, text, token)
    );
}

fn parse_cast_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let open = std::kizu::lexer::next_token(text, token);
    let type_node = try std::kizu::parser::parse_type_name(
        ast,
        text,
        std::kizu::lexer::next_token(text, open)
    );
    let close_type = try std::kizu::parser::expect_gt(type_node.next);
    let open_args = try std::kizu::parser::expect_left_paren(
        std::kizu::lexer::next_token(text, close_type)
    );
    let value = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, open_args)
    );
    let close_args = try std::kizu::parser::expect_right_paren(value.next);
    let node = ast.add_cast_expr(
        std::kizu::ast::span(token.start, close_args.end),
        type_node.node,
        value.node
    );
    return std::kizu::parser::parse_postfix_expr(
        allocator,
        ast,
        text,
        std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, close_args))
    );
}

fn parse_arena_new_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let open_type = std::kizu::lexer::next_token(text, token);
    let type_node = try std::kizu::parser::parse_type_name(
        ast,
        text,
        std::kizu::lexer::next_token(text, open_type)
    );
    let close_type = try std::kizu::parser::expect_gt(type_node.next);
    let open_args = try std::kizu::parser::expect_left_paren(
        std::kizu::lexer::next_token(text, close_type)
    );
    let close_args = try std::kizu::parser::expect_right_paren(
        std::kizu::lexer::next_token(text, open_args)
    );
    let node = ast.add_arena_new_expr(
        std::kizu::ast::span(token.start, close_args.end),
        type_node.node
    );
    return std::kizu::parser::parse_postfix_expr(
        allocator,
        ast,
        text,
        std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, close_args))
    );
}

fn parse_grouped_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let expr = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, token)
    );
    let close = try std::kizu::parser::expect_right_paren(expr.next);
    return std::kizu::parser::parse_postfix_expr(
        allocator,
        ast,
        text,
        std::kizu::parser::parse_node(expr.node, std::kizu::lexer::next_token(text, close))
    );
}

fn parse_try_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let value = try std::kizu::parser::parse_binary_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, token),
        30
    );
    let value_node = ast.get(value.node);
    let node = ast.add_try_expr(std::kizu::ast::span(token.start, value_node.span.end), value.node);
    return std::kizu::parser::parse_node(node, value.next);
}

fn parse_comptime_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let value = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, token)
    );
    let value_node = ast.get(value.node);
    let node = ast.add_comptime_expr(std::kizu::ast::span(token.start, value_node.span.end), value.node);
    return std::kizu::parser::parse_node(node, value.next);
}

fn parse_prefix_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let op = try std::kizu::parser::prefix_op(text, token);
    let right_start = try std::kizu::parser::prefix_right_start(text, token);
    let right = try std::kizu::parser::parse_binary_expr(allocator, ast, text, right_start, 30);
    let right_node = ast.get(right.node);
    let node = ast.add_prefix(std::kizu::ast::span(token.start, right_node.span.end), op, right.node);
    return std::kizu::parser::parse_node(node, right.next);
}

fn prefix_right_start(
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    let next = std::kizu::lexer::next_token(text, token);
    match token.kind {
        Import => return error("expected prefix operator");
        Pub => return error("expected prefix operator");
        Struct => return error("expected prefix operator");
        Enum => return error("expected prefix operator");
        Union => return error("expected prefix operator");
        Extern => return error("expected prefix operator");
        Amp => return std::kizu::parser::prefix_borrow_right_start(text, next);
        Bang => return next;
        Minus => return next;
        Fn => return error("expected prefix operator");
        Let => return error("expected prefix operator");
