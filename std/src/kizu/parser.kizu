fn parse_ident_type_arg_end(
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    let is_const = try std::kizu::parser::is_token_text(text, token, "const");
    if is_const {
        return std::kizu::parser::parse_type_end(
            text,
            std::kizu::lexer::next_token(text, token)
        );
    }
    return std::kizu::parser::parse_type_end(text, token);
}

fn parse_generic_type_end(
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    var current = std::kizu::lexer::next_token(text, open);
    while true {
        let arg_end = try std::kizu::parser::parse_type_arg_end(text, current);
        let next = std::kizu::lexer::next_token(text, arg_end);
        match next.kind {
            Import => return error("expected comma or greater than");
            Pub => return error("expected comma or greater than");
            Struct => return error("expected comma or greater than");
            Enum => return error("expected comma or greater than");
            Union => return error("expected comma or greater than");
            Extern => return error("expected comma or greater than");
            GT => return next;
            Comma => current = try std::kizu::parser::next_generic_type_arg(text, next);
            Fn => return error("expected comma or greater than");
            Return => return error("expected comma or greater than");
            Ident => return error("expected comma or greater than");
        Lifetime => return error("expected comma or greater than");
            Number => return error("expected comma or greater than");
            String => return error("expected comma or greater than");
            LBrace => return error("expected comma or greater than");
            RBrace => return error("expected comma or greater than");
            LParen => return error("expected comma or greater than");
            RParen => return error("expected comma or greater than");
            Semicolon => return error("expected comma or greater than");
            Colon => return error("expected comma or greater than");
            Arrow => return error("expected comma or greater than");
            Bang => return error("expected comma or greater than");
            Amp => return error("expected comma or greater than");
            Mut => return error("expected comma or greater than");
            LBracket => return error("expected comma or greater than");
            RBracket => return error("expected comma or greater than");
            LT => return error("expected comma or greater than");
            Question => return error("expected comma or greater than");
            DoubleColon => return error("expected comma or greater than");
            Plus => return error("expected comma or greater than");
            Asterisk => return error("expected comma or greater than");
            Eof => return error("expected greater than");
                Let => return error("expected comma or greater than");
        Var => return error("expected comma or greater than");
        If => return error("expected comma or greater than");
        Else => return error("expected comma or greater than");
        While => return error("expected comma or greater than");
        For => return error("expected comma or greater than");
        Break => return error("expected comma or greater than");
        Continue => return error("expected comma or greater than");
        Match => return error("expected comma or greater than");
        Unsafe => return error("expected comma or greater than");
        Comptime => return error("expected comma or greater than");
        Try => return error("expected comma or greater than");
        True => return error("expected comma or greater than");
        False => return error("expected comma or greater than");
        And => return error("expected comma or greater than");
        Or => return error("expected comma or greater than");
        Assign => return error("expected comma or greater than");
        FatArrow => return error("expected comma or greater than");
        Eq => return error("expected comma or greater than");
        NotEq => return error("expected comma or greater than");
        LTE => return error("expected comma or greater than");
        GTE => return error("expected comma or greater than");
        Minus => return error("expected comma or greater than");
        Slash => return error("expected comma or greater than");
        Percent => return error("expected comma or greater than");
        Dot => return error("expected comma or greater than");
        Range => return error("expected comma or greater than");
        Pipe => return error("expected comma or greater than");
}
    }
    return error("expected greater than");
}

