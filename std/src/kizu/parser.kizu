fn parse_postfix_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    first: ParseNode
) -> !ParseNode {
    var left = first;
    while true {
        if std::kizu::parser::is_type_apply_start(ast, text, left) {
            left = try std::kizu::parser::parse_type_apply_expr(allocator, ast, text, left);
        } else {
            if std::kizu::parser::is_postfix_start(left.next) {
                left = try std::kizu::parser::parse_one_postfix(allocator, ast, text, left);
            } else {
                if std::kizu::parser::is_struct_literal_start(ast, text, left) {
                    left = try std::kizu::parser::parse_struct_literal_expr(allocator, ast, text, left);
                } else {
                    return left;
                }
            }
        }
    }
    return left;
}

fn parse_one_postfix(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode
) -> !ParseNode {
    match left.next.kind {
            Import => return error("expected postfix operator");
            Pub => return error("expected postfix operator");
            Struct => return error("expected postfix operator");
            Enum => return error("expected postfix operator");
            Union => return error("expected postfix operator");
            Extern => return error("expected postfix operator");
        LParen => return std::kizu::parser::parse_call(allocator, ast, text, left.node, left.next);
        DoubleColon => return std::kizu::parser::parse_field_expr(ast, text, left, true);
        Dot => return std::kizu::parser::parse_field_expr(ast, text, left, false);
        LBracket => return std::kizu::parser::parse_index_expr(allocator, ast, text, left);
            Fn => return error("expected postfix operator");
        Let => return error("expected postfix operator");
        Var => return error("expected postfix operator");
        Return => return error("expected postfix operator");
        If => return error("expected postfix operator");
        Else => return error("expected postfix operator");
        While => return error("expected postfix operator");
        For => return error("expected postfix operator");
        Break => return error("expected postfix operator");
        Continue => return error("expected postfix operator");
        Match => return error("expected postfix operator");
        Unsafe => return error("expected postfix operator");
        Comptime => return error("expected postfix operator");
        Try => return error("expected postfix operator");
        True => return error("expected postfix operator");
        False => return error("expected postfix operator");
        And => return error("expected postfix operator");
        Or => return error("expected postfix operator");
        Ident => return error("expected postfix operator");
        Lifetime => return error("expected postfix operator");
        Number => return error("expected postfix operator");
        LBrace => return error("expected postfix operator");
        RBrace => return error("expected postfix operator");
        RParen => return error("expected postfix operator");
        Semicolon => return error("expected postfix operator");
        Comma => return error("expected postfix operator");
        Colon => return error("expected postfix operator");
        Assign => return error("expected postfix operator");
        Arrow => return error("expected postfix operator");
        FatArrow => return error("expected postfix operator");
        Bang => return error("expected postfix operator");
        Eq => return error("expected postfix operator");
        NotEq => return error("expected postfix operator");
        Amp => return error("expected postfix operator");
        RBracket => return error("expected postfix operator");
        LT => return error("expected postfix operator");
        LTE => return error("expected postfix operator");
        GT => return error("expected postfix operator");
        GTE => return error("expected postfix operator");
        Question => return error("expected postfix operator");
        Plus => return error("expected postfix operator");
        Minus => return error("expected postfix operator");
        Asterisk => return error("expected postfix operator");
