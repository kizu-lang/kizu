        RBracket => return error("expected comma or right paren");
        LT => return error("expected comma or right paren");
        GT => return error("expected comma or right paren");
        Question => return error("expected comma or right paren");
        DoubleColon => return error("expected comma or right paren");
        Plus => return error("expected comma or right paren");
        Asterisk => return error("expected comma or right paren");
        Eof => return error("expected right paren");
            Let => return error("expected comma or right paren");
        Var => return error("expected comma or right paren");
        If => return error("expected comma or right paren");
        Else => return error("expected comma or right paren");
        While => return error("expected comma or right paren");
        For => return error("expected comma or right paren");
        Break => return error("expected comma or right paren");
        Continue => return error("expected comma or right paren");
        Match => return error("expected comma or right paren");
        Unsafe => return error("expected comma or right paren");
        Comptime => return error("expected comma or right paren");
        Try => return error("expected comma or right paren");
        True => return error("expected comma or right paren");
        False => return error("expected comma or right paren");
        And => return error("expected comma or right paren");
        Or => return error("expected comma or right paren");
        Assign => return error("expected comma or right paren");
        FatArrow => return error("expected comma or right paren");
        Eq => return error("expected comma or right paren");
        NotEq => return error("expected comma or right paren");
        LTE => return error("expected comma or right paren");
        GTE => return error("expected comma or right paren");
        Minus => return error("expected comma or right paren");
        Slash => return error("expected comma or right paren");
        Percent => return error("expected comma or right paren");
        Dot => return error("expected comma or right paren");
        Range => return error("expected comma or right paren");
        Pipe => return error("expected comma or right paren");
}
}

fn parse_param_after_comma(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    match token.kind {
        RParen => return token;
        Ident => return std::kizu::parser::parse_param_list(ast, text, token);
        Comptime => return std::kizu::parser::parse_param_list(ast, text, token);
        Lifetime => return error("expected parameter");
        Fn => return error("expected parameter");
        Import => return error("expected parameter");
        Pub => return error("expected parameter");
        Struct => return error("expected parameter");
        Enum => return error("expected parameter");
        Union => return error("expected parameter");
