fn parse_expr_result(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    let text = source.text;
    var ast = std::kizu::ast::Ast(allocator, source);
    let expr = try std::kizu::parser::parse_expr(
        allocator,
        ast,
        text,
        std::kizu::lexer::first_token(text)
    );
    return std::kizu::ast::parse_result(ast, expr.node);
}

fn parse_empty_result(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile,
    at: i64
) -> std::kizu::ast::ParseResult {
    var ast = std::kizu::ast::Ast(allocator, source);
    let root = ast.add_empty(at);
    return std::kizu::ast::parse_result(ast, root);
}

fn parse_fn_body_node(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    fn_token: std::kizu::lexer::Token,
    public: bool,
    unsafe_decl: bool,
    extern_abi: std::kizu::ast::NodeId,
    name: std::kizu::lexer::Token,
    require_body: bool
) -> !ParseNode {
    let name_node = ast.add_var(
        std::kizu::ast::span(name.start, name.end),
        std::kizu::ast::symbol_id(name.start)
    );
    let type_params = try std::kizu::parser::parse_optional_type_params(
        ast,
        text,
        std::kizu::lexer::next_token(text, name)
    );
    let params = try std::kizu::parser::parse_required_params(ast, text, type_params.next);
    let return_type = try std::kizu::parser::parse_signature_return_type(ast, text, params.next);
    let body = try std::kizu::parser::parse_signature_body(
        allocator,
        ast,
        text,
        return_type.next,
        require_body
    );
    let body_node = ast.get(body.node);
    let root = ast.add_fn_decl(
        std::kizu::ast::span(fn_token.start, body_node.span.end),
        public,
        unsafe_decl,
        extern_abi,
        name_node,
        type_params.range,
        params.range,
        return_type.node,
        body.node
    );
    return std::kizu::parser::parse_node(root, body.next);
}

fn parse_unsafe_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    unsafe_token: std::kizu::lexer::Token,
    public: bool
) -> !ParseNode {
    let next = std::kizu::lexer::next_token(text, unsafe_token);
    match next.kind {
        Fn => return std::kizu::parser::parse_fn_decl(
            allocator,
            ast,
            text,
            next,
            public,
            true,
            ast.add_empty(unsafe_token.start),
            true
        );
        Extern => return std::kizu::parser::parse_extern_decl(
            allocator,
            ast,
            text,
            next,
            public,
            true
        );
        Import => return error("expected fn or extern after unsafe");
        Pub => return error("expected fn or extern after unsafe");
        Struct => return error("expected fn or extern after unsafe");
        Enum => return error("expected fn or extern after unsafe");
        Union => return error("expected fn or extern after unsafe");
        Let => return error("expected fn or extern after unsafe");
        Var => return error("expected fn or extern after unsafe");
        Return => return error("expected fn or extern after unsafe");
        If => return error("expected fn or extern after unsafe");
        Else => return error("expected fn or extern after unsafe");
        While => return error("expected fn or extern after unsafe");
        For => return error("expected fn or extern after unsafe");
        Break => return error("expected fn or extern after unsafe");
        Continue => return error("expected fn or extern after unsafe");
        Match => return error("expected fn or extern after unsafe");
        Unsafe => return error("expected fn or extern after unsafe");
        Comptime => return error("expected fn or extern after unsafe");
        Try => return error("expected fn or extern after unsafe");
        True => return error("expected fn or extern after unsafe");
        False => return error("expected fn or extern after unsafe");
        And => return error("expected fn or extern after unsafe");
        Or => return error("expected fn or extern after unsafe");
        Ident => return error("expected fn or extern after unsafe");
        Lifetime => return error("expected fn or extern after unsafe");
        Number => return error("expected fn or extern after unsafe");
        String => return error("expected fn or extern after unsafe");
        LBrace => return error("expected fn or extern after unsafe");
        RBrace => return error("expected fn or extern after unsafe");
        LParen => return error("expected fn or extern after unsafe");
        RParen => return error("expected fn or extern after unsafe");
        Semicolon => return error("expected fn or extern after unsafe");
        Comma => return error("expected fn or extern after unsafe");
        Colon => return error("expected fn or extern after unsafe");
        DoubleColon => return error("expected fn or extern after unsafe");
        Assign => return error("expected fn or extern after unsafe");
        Arrow => return error("expected fn or extern after unsafe");
        FatArrow => return error("expected fn or extern after unsafe");
        Bang => return error("expected fn or extern after unsafe");
        Eq => return error("expected fn or extern after unsafe");
        NotEq => return error("expected fn or extern after unsafe");
        Amp => return error("expected fn or extern after unsafe");
        LBracket => return error("expected fn or extern after unsafe");
        RBracket => return error("expected fn or extern after unsafe");
        LT => return error("expected fn or extern after unsafe");
        LTE => return error("expected fn or extern after unsafe");
        GT => return error("expected fn or extern after unsafe");
        GTE => return error("expected fn or extern after unsafe");
        Question => return error("expected fn or extern after unsafe");
        Plus => return error("expected fn or extern after unsafe");
        Minus => return error("expected fn or extern after unsafe");
        Asterisk => return error("expected fn or extern after unsafe");
        Slash => return error("expected fn or extern after unsafe");
        Percent => return error("expected fn or extern after unsafe");
        Dot => return error("expected fn or extern after unsafe");
        Range => return error("expected fn or extern after unsafe");
        Pipe => return error("expected fn or extern after unsafe");
        Mut => return error("expected fn or extern after unsafe");
        Eof => return error("expected fn or extern after unsafe");
    }
}

fn parse_extern_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    extern_token: std::kizu::lexer::Token,
    public: bool,
    unsafe_decl: bool
) -> !ParseNode {
    let abi_token = try std::kizu::parser::expect_string(
        std::kizu::lexer::next_token(text, extern_token)
    );
    let abi = ast.add_string(
        std::kizu::ast::span(abi_token.start, abi_token.end),
        std::kizu::ast::token_id(abi_token.start)
    );
    let fn_token = try std::kizu::parser::expect_fn(std::kizu::lexer::next_token(text, abi_token));
    return std::kizu::parser::parse_fn_decl(
        allocator,
        ast,
        text,
        fn_token,
        public,
        unsafe_decl,
        abi,
        false
    );
}

fn parse_import_decl(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    import_token: std::kizu::lexer::Token
) -> !ParseNode {
    let start = ast.begin_children();
    let first = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, import_token));
    try std::kizu::parser::add_name_child(ast, first);
    let end = try std::kizu::parser::parse_import_segments(ast, text, std::kizu::lexer::next_token(text, first));
    let range = ast.finish_children(start);
    let node = ast.add_import_decl(std::kizu::ast::span(import_token.start, end.end), range);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, end));
}

fn parse_import_segments(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    first: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    var token = first;
    while std::kizu::parser::is_double_colon(token) {
        let segment = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, token));
        try std::kizu::parser::add_name_child(ast, segment);
        token = std::kizu::lexer::next_token(text, segment);
    }
    return std::kizu::parser::expect_semicolon(token);
}

fn parse_struct_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    struct_token: std::kizu::lexer::Token,
    public: bool
) -> !ParseNode {
    let name_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, struct_token));
    let name = std::kizu::parser::name_node(ast, name_token);
    let type_params = try std::kizu::parser::parse_optional_type_params(
        ast,
        text,
        std::kizu::lexer::next_token(text, name_token)
    );
    let open = try std::kizu::parser::expect_lbrace(type_params.next);
    let fields = try std::kizu::parser::parse_struct_fields(allocator, ast, text, open);
    let node = ast.add_struct_decl(
        std::kizu::ast::span(struct_token.start, fields.next.start),
        public,
        name,
        type_params.range,
        fields.range
    );
    return std::kizu::parser::parse_node(node, fields.next);
}

fn parse_struct_fields(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseRange {
    var fields = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_struct_fields_with_array(fields, ast, text, open);
    fields.deinit();
    return result;
}

fn parse_struct_fields_with_array(
    fields: &mut std::array::Array<std::kizu::ast::NodeId>,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseRange {
    var token = std::kizu::lexer::next_token(text, open);
    while !std::kizu::parser::is_block_close_token(token) {
        let field = try std::kizu::parser::parse_struct_field(ast, text, token);
        try fields.append(field.node);
        token = std::kizu::parser::next_decl_item_token(text, field.next);
    }
    let close = try std::kizu::parser::expect_block_close(token);
    let start = ast.begin_children();
    var index = 0;
    while index < fields.len() {
        try ast.add_child(try fields.get(index));
        index = index + 1;
    }
    return ParseRange {
        range: ast.finish_children(start),
        next: std::kizu::lexer::next_token(text, close)
    };
}

fn parse_struct_field(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    var public = false;
    var name_token = token;
    if std::kizu::parser::is_pub_token(token) {
        public = true;
        name_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, token));
    }
    name_token = try std::kizu::parser::expect_ident(name_token);
    let colon = try std::kizu::parser::expect_colon(
        text,
        std::kizu::lexer::next_token(text, name_token)
    );
    let type_name = try std::kizu::parser::parse_type_name(ast, text, colon);
    let type_node = ast.get(type_name.node);
    let node = ast.add_field(
        std::kizu::ast::span(token.start, type_node.span.end),
        public,
        std::kizu::parser::name_node(ast, name_token),
        type_name.node
    );
    return std::kizu::parser::parse_node(node, type_name.next);
}

fn parse_enum_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    enum_token: std::kizu::lexer::Token,
    public: bool
) -> !ParseNode {
    let name_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, enum_token));
    let name = std::kizu::parser::name_node(ast, name_token);
    let open = try std::kizu::parser::expect_lbrace(std::kizu::lexer::next_token(text, name_token));
    let tags = try std::kizu::parser::parse_enum_tags(allocator, ast, text, open);
    let node = ast.add_enum_decl(
        std::kizu::ast::span(enum_token.start, tags.next.start),
        public,
        name,
        tags.range
    );
    return std::kizu::parser::parse_node(node, tags.next);
}

fn parse_enum_tags(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseRange {
    var tags = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_enum_tags_with_array(tags, ast, text, open);
    tags.deinit();
    return result;
}

fn parse_enum_tags_with_array(
    tags: &mut std::array::Array<std::kizu::ast::NodeId>,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseRange {
    var token = std::kizu::lexer::next_token(text, open);
    while !std::kizu::parser::is_block_close_token(token) {
        let tag = try std::kizu::parser::expect_ident(token);
        try tags.append(std::kizu::parser::name_node(ast, tag));
        token = std::kizu::parser::next_decl_item_token(text, std::kizu::lexer::next_token(text, tag));
    }
    let close = try std::kizu::parser::expect_block_close(token);
    let start = ast.begin_children();
    var index = 0;
    while index < tags.len() {
        try ast.add_child(try tags.get(index));
        index = index + 1;
    }
    return ParseRange {
        range: ast.finish_children(start),
        next: std::kizu::lexer::next_token(text, close)
    };
}

fn parse_union_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    union_token: std::kizu::lexer::Token,
    public: bool
) -> !ParseNode {
    let name_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, union_token));
    let name = std::kizu::parser::name_node(ast, name_token);
    let type_params = try std::kizu::parser::parse_optional_type_params(
        ast,
        text,
        std::kizu::lexer::next_token(text, name_token)
    );
    let open = try std::kizu::parser::expect_lbrace(type_params.next);
    let variants = try std::kizu::parser::parse_union_variants(allocator, ast, text, open);
    let node = ast.add_union_decl(
        std::kizu::ast::span(union_token.start, variants.next.start),
        public,
        name,
        type_params.range,
        variants.range
    );
    return std::kizu::parser::parse_node(node, variants.next);
}

fn parse_union_variants(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseRange {
    var variants = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_union_variants_with_array(variants, ast, text, open);
    variants.deinit();
    return result;
}

fn parse_union_variants_with_array(
    variants: &mut std::array::Array<std::kizu::ast::NodeId>,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseRange {
    var token = std::kizu::lexer::next_token(text, open);
    while !std::kizu::parser::is_block_close_token(token) {
        let variant = try std::kizu::parser::parse_union_variant(ast, text, token);
        try variants.append(variant.node);
        token = std::kizu::parser::next_decl_item_token(text, variant.next);
    }
    let close = try std::kizu::parser::expect_block_close(token);
    let start = ast.begin_children();
    var index = 0;
    while index < variants.len() {
        try ast.add_child(try variants.get(index));
        index = index + 1;
    }
    return ParseRange {
        range: ast.finish_children(start),
        next: std::kizu::lexer::next_token(text, close)
    };
}

fn parse_union_variant(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let name_token = try std::kizu::parser::expect_ident(token);
    let payload = try std::kizu::parser::parse_optional_variant_payload(
        ast,
        text,
        std::kizu::lexer::next_token(text, name_token)
    );
    let payload_node = ast.get(payload.node);
    let node = ast.add_union_variant(
        std::kizu::ast::span(name_token.start, payload_node.span.end),
        std::kizu::parser::name_node(ast, name_token),
        payload.node
    );
    return std::kizu::parser::parse_node(node, payload.next);
}

fn parse_optional_variant_payload(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    if !std::kizu::parser::is_left_paren_token(token) {
        return std::kizu::parser::empty_parse_node(ast, token);
    }
    let payload = try std::kizu::parser::parse_type_name(
        ast,
        text,
        std::kizu::lexer::next_token(text, token)
    );
    let close = try std::kizu::parser::expect_right_paren(payload.next);
    return std::kizu::parser::parse_node(payload.node, std::kizu::lexer::next_token(text, close));
}

fn add_name_child(ast: std::kizu::ast::Ast, token: std::kizu::lexer::Token) -> !void {
    try ast.add_child(std::kizu::parser::name_node(ast, token));
    return;
}

fn name_node(ast: std::kizu::ast::Ast, token: std::kizu::lexer::Token) -> std::kizu::ast::NodeId {
    return ast.add_var(
        std::kizu::ast::span(token.start, token.end),
        std::kizu::ast::symbol_id(token.start)
    );
}

fn next_decl_item_token(
    text: []const u8,
    token: std::kizu::lexer::Token
) -> std::kizu::lexer::Token {
    if std::kizu::parser::is_decl_item_separator(token) {
        return std::kizu::lexer::next_token(text, token);
    }
    return token;
}

fn parse_optional_type_params(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseRange {
    if std::kizu::parser::is_lt_token(token) {
        return std::kizu::parser::parse_type_params(ast, text, token);
    }
    return std::kizu::parser::empty_range(ast, token);
}

fn parse_type_params(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    open: std::kizu::lexer::Token
) -> !ParseRange {
    let start = ast.begin_children();
    var token = std::kizu::lexer::next_token(text, open);
    while !std::kizu::parser::is_gt_token(token) {
        let name = try std::kizu::parser::expect_type_param(token);
        try ast.add_child(std::kizu::parser::name_node(ast, name));
        let next = std::kizu::lexer::next_token(text, name);
        if std::kizu::parser::is_comma_token(next) {
            token = std::kizu::lexer::next_token(text, next);
        } else {
            let close = try std::kizu::parser::expect_gt(next);
            return ParseRange {
                range: ast.finish_children(start),
                next: std::kizu::lexer::next_token(text, close)
            };
        }
    }
    return ParseRange {
        range: ast.finish_children(start),
        next: std::kizu::lexer::next_token(text, token)
    };
}

fn parse_required_params(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseRange {
    let open = try std::kizu::parser::expect_left_paren(token);
    return std::kizu::parser::parse_params(ast, text, open);
}

fn parse_signature_return_type(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    if std::kizu::parser::is_arrow_token(token) {
        return std::kizu::parser::parse_type_name(
            ast,
            text,
            std::kizu::lexer::next_token(text, token)
        );
    }
    return std::kizu::parser::empty_parse_node(ast, token);
}

fn parse_signature_body(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    require_body: bool
) -> !ParseNode {
    if require_body {
        let open = try std::kizu::parser::expect_lbrace(token);
        return std::kizu::parser::parse_block(allocator, ast, text, open);
    }
    return std::kizu::parser::empty_parse_node(ast, token);
}

