}
}

fn parse_type_apply_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode
) -> !ParseNode {
    var type_args = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_type_apply_expr_with_args(
        type_args,
        ast,
        text,
        left
    );
    type_args.deinit();
    return try result;
}

fn parse_type_apply_expr_with_args(
    type_args: &mut std::array::Array<std::kizu::ast::NodeId>,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode
) -> !ParseNode {
    var current = std::kizu::lexer::next_token(text, left.next);
    while true {
        let arg = try std::kizu::parser::parse_type_name(ast, text, current);
        try type_args.append(arg.node);
        if std::kizu::parser::is_single_token_byte(text, arg.next, cast<u8>(62)) {
            let start = ast.begin_children();
            var index = 0;
            while index < type_args.len() {
                try ast.add_child(try type_args.get(index));
                index = index + 1;
            }
            let range = ast.finish_children(start);
            let callee_node = ast.get(left.node);
            let node = ast.add_type_apply_expr(
                std::kizu::ast::span(callee_node.span.start, arg.next.end),
                left.node,
                range
            );
            return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, arg.next));
        }
        if !std::kizu::parser::is_single_token_byte(text, arg.next, cast<u8>(44)) {
            return error("expected comma or greater than");
        }
        current = std::kizu::lexer::next_token(text, arg.next);
    }
    return error("expected greater than");
}

fn parse_index_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode
) -> !ParseNode {
    let first = std::kizu::lexer::next_token(text, left.next);
    if std::kizu::parser::is_double_token_byte(text, first, cast<u8>(46), cast<u8>(46)) {
        return std::kizu::parser::parse_open_start_slice(allocator, ast, text, left, first);
    }
    let start = try std::kizu::parser::parse_expr(allocator, ast, text, first);
    if std::kizu::parser::is_double_token_byte(text, start.next, cast<u8>(46), cast<u8>(46)) {
        return std::kizu::parser::parse_closed_start_slice(
            allocator,
            ast,
            text,
            left,
            start,
            start.next
        );
    }
    let close = try std::kizu::parser::expect_right_bracket_token(text, start.next);
    let empty = ast.add_empty(close.start);
    let target_node = ast.get(left.node);
    let node = ast.add_index_expr(
        std::kizu::ast::span(target_node.span.start, close.end),
        left.node,
        start.node,
        empty,
        false
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, close));
}

fn parse_open_start_slice(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode,
    range_token: std::kizu::lexer::Token
) -> !ParseNode {
    let end_start = std::kizu::lexer::next_token(text, range_token);
    if std::kizu::parser::is_single_token_byte(text, end_start, cast<u8>(93)) {
        return error("slice expression requires at least one bound");
    }
    let end = try std::kizu::parser::parse_expr(allocator, ast, text, end_start);
    let close = try std::kizu::parser::expect_right_bracket_token(text, end.next);
    let start = ast.add_empty(range_token.start);
    return std::kizu::parser::finish_slice_expr(ast, text, left, start, end.node, close);
}

fn parse_closed_start_slice(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode,
    start: ParseNode,
    range_token: std::kizu::lexer::Token
) -> !ParseNode {
    let end_start = std::kizu::lexer::next_token(text, range_token);
    if std::kizu::parser::is_single_token_byte(text, end_start, cast<u8>(93)) {
        let end = ast.add_empty(end_start.start);
        return std::kizu::parser::finish_slice_expr(ast, text, left, start.node, end, end_start);
    }
    let end = try std::kizu::parser::parse_expr(allocator, ast, text, end_start);
    let close = try std::kizu::parser::expect_right_bracket_token(text, end.next);
    return std::kizu::parser::finish_slice_expr(ast, text, left, start.node, end.node, close);
}

fn finish_slice_expr(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    close: std::kizu::lexer::Token
) -> ParseNode {
    let target_node = ast.get(left.node);
    let node = ast.add_index_expr(
        std::kizu::ast::span(target_node.span.start, close.end),
        left.node,
        start,
        end,
        true
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, close));
}

fn parse_struct_literal_expr(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode
) -> !ParseNode {
    var fields = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_struct_literal_expr_with_fields(
        fields,
        allocator,
        ast,
        text,
        left
    );
    fields.deinit();
    return try result;
}

fn parse_struct_literal_expr_with_fields(
    fields: &mut std::array::Array<std::kizu::ast::NodeId>,
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode
) -> !ParseNode {
    var current = std::kizu::lexer::next_token(text, left.next);
    while !std::kizu::parser::is_single_token_byte(text, current, cast<u8>(125)) {
        let field = try std::kizu::parser::parse_struct_field_init(
            allocator,
            ast,
            text,
            current
        );
        try fields.append(field.node);
        current = try std::kizu::parser::next_struct_literal_field_token(text, field.next);
    }
    let start = ast.begin_children();
    var index = 0;
    while index < fields.len() {
        try ast.add_child(try fields.get(index));
        index = index + 1;
    }
    let range = ast.finish_children(start);
    let type_node = ast.get(left.node);
    let node = ast.add_struct_literal_expr(
        std::kizu::ast::span(type_node.span.start, current.end),
        left.node,
        range
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, current));
}

fn parse_struct_field_init(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    let name_token = try std::kizu::parser::expect_ident(token);
    let value_start = try std::kizu::parser::expect_colon(
        text,
        std::kizu::lexer::next_token(text, name_token)
    );
    let value = try std::kizu::parser::parse_expr(allocator, ast, text, value_start);
    let name = ast.add_var(
        std::kizu::ast::span(name_token.start, name_token.end),
        std::kizu::ast::symbol_id(name_token.start)
    );
    let value_node = ast.get(value.node);
    let node = ast.add_struct_field_init(
        std::kizu::ast::span(name_token.start, value_node.span.end),
        name,
        value.node
    );
    return std::kizu::parser::parse_node(node, value.next);
}

fn next_struct_literal_field_token(
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    if std::kizu::parser::is_single_token_byte(text, token, cast<u8>(125)) {
        return token;
    }
    if std::kizu::parser::is_single_token_byte(text, token, cast<u8>(44)) {
        return std::kizu::lexer::next_token(text, token);
    }
    if std::kizu::parser::is_single_token_byte(text, token, cast<u8>(59)) {
        return std::kizu::lexer::next_token(text, token);
    }
    return error("expected comma, semicolon, or right brace");
}

fn parse_field_expr(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    receiver: ParseNode,
    namespace: bool
) -> !ParseNode {
    let name_token = try std::kizu::parser::expect_ident(std::kizu::lexer::next_token(text, receiver.next));
    let name = ast.add_var(
        std::kizu::ast::span(name_token.start, name_token.end),
        std::kizu::ast::symbol_id(name_token.start)
    );
    let receiver_node = ast.get(receiver.node);
    let node = ast.add_field_expr(
        std::kizu::ast::span(receiver_node.span.start, name_token.end),
        receiver.node,
        name,
        namespace
    );
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, name_token));
}

fn parse_call(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    callee: std::kizu::ast::NodeId,
    open: std::kizu::lexer::Token
) -> !ParseNode {
    var args = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_call_with_args(args, allocator, ast, text, callee, open);
    args.deinit();
    return result;
}

fn parse_call_with_args(
    args: &mut std::array::Array<std::kizu::ast::NodeId>,
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    callee: std::kizu::ast::NodeId,
    open: std::kizu::lexer::Token
) -> !ParseNode {
    var close = std::kizu::lexer::next_token(text, open);
    while !std::kizu::parser::is_call_close_token(close) {
        let start_token = try std::kizu::parser::expect_call_arg_start(close);
        let arg = try std::kizu::parser::parse_expr(allocator, ast, text, start_token);
        try args.append(arg.node);
        close = try std::kizu::parser::next_call_arg_token(text, arg.next);
    }
    let start = ast.begin_children();
    var index = 0;
    while index < args.len() {
        try ast.add_child(try args.get(index));
        index = index + 1;
    }
    let range = ast.finish_children(start);
    let callee_node = ast.get(callee);
    let node = ast.add_call(std::kizu::ast::span(callee_node.span.start, close.end), callee, range);
    return std::kizu::parser::parse_node(node, std::kizu::lexer::next_token(text, close));
}

fn empty_parse_node(ast: std::kizu::ast::Ast, token: std::kizu::lexer::Token) -> ParseNode {
    return std::kizu::parser::parse_node(ast.add_empty(token.start), token);
}

fn parse_node(node: std::kizu::ast::NodeId, next: std::kizu::lexer::Token) -> ParseNode {
    return ParseNode {
        node: node,
        next: next
    };
}

struct ParseRange {
    range: std::kizu::ast::ChildRange;
    next: std::kizu::lexer::Token;
}

fn empty_range(ast: std::kizu::ast::Ast, next: std::kizu::lexer::Token) -> ParseRange {
    let start = ast.begin_children();
    return ParseRange {
        range: ast.finish_children(start),
        next: next
    };
}

fn is_single_token_byte(
    text: []const u8,
    token: std::kizu::lexer::Token,
    byte: u8
) -> bool {
    if token.end != token.start + 1 {
        return false;
    }
    return text[token.start] == byte;
}

fn is_double_token_byte(
    text: []const u8,
    token: std::kizu::lexer::Token,
    first: u8,
    second: u8
) -> bool {
    if token.end != token.start + 2 {
        return false;
    }
    if text[token.start] != first {
        return false;
    }
    return text[token.start + 1] == second;
}

fn expect_right_bracket_token(
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    if std::kizu::parser::is_single_token_byte(text, token, cast<u8>(93)) {
        return token;
    }
    return error("expected right bracket");
}

fn is_type_apply_start(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode
) -> bool {
    if !std::kizu::parser::is_lt_token(left.next) {
        return false;
    }
    let node = ast.get(left.node);
    return std::kizu::parser::is_namespace_path_span(text, &node.span);
}

fn is_struct_literal_start(
    ast: std::kizu::ast::Ast,
    text: []const u8,
    left: ParseNode
) -> bool {
    if !std::kizu::parser::is_single_token_byte(text, left.next, cast<u8>(123)) {
        return false;
    }
    let node = ast.get(left.node);
    return std::kizu::parser::is_struct_literal_type_span(text, &node.span);
}

fn is_namespace_path_span(source: []const u8, span: &std::kizu::ast::Span) -> bool {
    var index = span.start;
    var need_segment = true;
    var saw_namespace = false;
    while index < span.end {
        let byte = source[index];
        if std::kizu::parser::is_name_byte(byte) {
            need_segment = false;
            index = index + 1;
        } else {
            if !std::kizu::parser::is_double_colon_at(source, span.end, index) {
                return false;
            }
            if need_segment {
                return false;
            }
            saw_namespace = true;
            need_segment = true;
            index = index + 2;
        }
    }
    if need_segment {
        return false;
    }
    return saw_namespace;
}

fn is_struct_literal_type_span(source: []const u8, span: &std::kizu::ast::Span) -> bool {
    var index = span.start;
    var segment_start = span.start;
    var previous_segment_start = span.start;
    var segment_count = 0;
    var need_segment = true;
    while index < span.end {
        let byte = source[index];
        if std::kizu::parser::is_name_byte(byte) {
            if need_segment {
                previous_segment_start = segment_start;
                segment_start = index;
                segment_count = segment_count + 1;
                need_segment = false;
            }
            index = index + 1;
        } else {
            if !std::kizu::parser::is_double_colon_at(source, span.end, index) {
                return false;
            }
            if need_segment {
                return false;
            }
            need_segment = true;
            index = index + 2;
        }
    }
    if need_segment {
        return false;
    }
    if !std::kizu::parser::is_upper_byte(source[segment_start]) {
        return false;
    }
    if segment_count > 1 {
        if std::kizu::parser::is_upper_byte(source[previous_segment_start]) {
            return false;
        }
    }
    return true;
}

fn is_double_colon_at(source: []const u8, end: i64, index: i64) -> bool {
    if index + 1 >= end {
        return false;
    }
    if source[index] != cast<u8>(58) {
        return false;
    }
    return source[index + 1] == cast<u8>(58);
}

fn is_name_byte(byte: u8) -> bool {
    return std::kizu::parser::is_upper_byte(byte) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        (byte >= cast<u8>(48) and byte <= cast<u8>(57)) or
        byte == cast<u8>(95);
}

fn is_upper_byte(byte: u8) -> bool {
    return byte >= cast<u8>(65) and byte <= cast<u8>(90);
}

fn expect_block_close(token: std::kizu::lexer::Token) -> !std::kizu::lexer::Token {
    match token.kind {
        Import => return error("expected statement");
        Pub => return error("expected statement");
        Struct => return error("expected statement");
        Enum => return error("expected statement");
        Union => return error("expected statement");
        Extern => return error("expected statement");
        RBrace => return token;
        Eof => return error("expected right brace");
        Fn => return error("expected statement");
        Let => return error("expected statement");
        Var => return error("expected statement");
        Return => return error("expected statement");
        If => return error("expected statement");
        Else => return error("expected statement");
        While => return error("expected statement");
        For => return error("expected statement");
        Break => return error("expected statement");
        Continue => return error("expected statement");
        Match => return error("expected statement");
        Unsafe => return error("expected statement");
        Comptime => return error("expected statement");
        Try => return error("expected statement");
        True => return error("expected statement");
        False => return error("expected statement");
        And => return error("expected statement");
        Or => return error("expected statement");
        Ident => return error("expected statement");
        Lifetime => return error("expected statement");
        Number => return error("expected statement");
        LBrace => return error("expected statement");
        LParen => return error("expected statement");
        RParen => return error("expected statement");
        Semicolon => return error("expected statement");
        Comma => return error("expected statement");
        Colon => return error("expected statement");
        DoubleColon => return error("expected statement");
        Assign => return error("expected statement");
        Arrow => return error("expected statement");
        FatArrow => return error("expected statement");
        Bang => return error("expected statement");
        Eq => return error("expected statement");
        NotEq => return error("expected statement");
        Amp => return error("expected statement");
        LBracket => return error("expected statement");
        RBracket => return error("expected statement");
        LT => return error("expected statement");
        LTE => return error("expected statement");
        GT => return error("expected statement");
        GTE => return error("expected statement");
        Question => return error("expected statement");
        Plus => return error("expected statement");
        Minus => return error("expected statement");
        Asterisk => return error("expected statement");
        Slash => return error("expected statement");
        Percent => return error("expected statement");
        Dot => return error("expected statement");
        Range => return error("expected statement");
        Pipe => return error("expected statement");
        Mut => return error("expected statement");
        String => return error("expected statement");
    }
}

