struct ParseNode {
    node: std::kizu::ast::NodeId;
    next: std::kizu::lexer::Token;
}

pub fn parse_first_node(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    let token = std::kizu::lexer::first_token(source.text);
    match token.kind {
        Import => return std::kizu::parser::parse_decl_result(allocator, source);
        Pub => return std::kizu::parser::parse_decl_result(allocator, source);
        Fn => return std::kizu::parser::parse_decl_result(allocator, source);
        Unsafe => return std::kizu::parser::parse_decl_result(allocator, source);
        Extern => return std::kizu::parser::parse_decl_result(allocator, source);
        Struct => return std::kizu::parser::parse_decl_result(allocator, source);
        Enum => return std::kizu::parser::parse_decl_result(allocator, source);
        Union => return std::kizu::parser::parse_decl_result(allocator, source);
        Ident => return std::kizu::parser::parse_expr_result(allocator, source);
        Lifetime => return error("unexpected lifetime");
        Number => return std::kizu::parser::parse_expr_result(allocator, source);
        String => return std::kizu::parser::parse_expr_result(allocator, source);
        Eof => return std::kizu::parser::parse_empty_result(allocator, source, token.start);
        Return => return error("unexpected return");
        LBrace => return error("unexpected block");
        RBrace => return error("unexpected right brace");
        LParen => return error("unexpected left paren");
        RParen => return error("unexpected right paren");
        Semicolon => return error("unexpected semicolon");
        Comma => return error("unexpected comma");
        Colon => return error("unexpected colon");
        Arrow => return error("unexpected arrow");
        Bang => return error("unexpected arrow");
        Amp => return error("unexpected arrow");
        Mut => return error("unexpected arrow");
        LBracket => return error("unexpected arrow");
        RBracket => return error("unexpected arrow");
        LT => return error("unexpected arrow");
        GT => return error("unexpected arrow");
        Question => return error("unexpected arrow");
        DoubleColon => return error("unexpected arrow");
        Plus => return error("unexpected plus");
        Asterisk => return error("unexpected asterisk");
            Let => return error("unexpected let");
        Var => return error("unexpected var");
        If => return error("unexpected if");
        Else => return error("unexpected else");
        While => return error("unexpected while");
        For => return error("unexpected for");
        Break => return error("unexpected break");
        Continue => return error("unexpected continue");
        Match => return error("unexpected match");
        Comptime => return error("unexpected comptime");
        Try => return std::kizu::parser::parse_expr_result(allocator, source);
        True => return std::kizu::parser::parse_expr_result(allocator, source);
        False => return std::kizu::parser::parse_expr_result(allocator, source);
        And => return error("unexpected and");
        Or => return error("unexpected or");
        Assign => return error("unexpected assign");
        FatArrow => return error("unexpected fat arrow");
        Eq => return error("unexpected equality");
        NotEq => return error("unexpected equality");
        LTE => return error("unexpected comparison");
        GTE => return error("unexpected comparison");
        Minus => return std::kizu::parser::parse_expr_result(allocator, source);
        Slash => return error("unexpected slash");
        Percent => return error("unexpected percent");
        Dot => return error("unexpected dot");
        Range => return error("unexpected range");
        Pipe => return error("unexpected pipe");
}
}

pub fn parse_program(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    let text = source.text;
    var ast = std::kizu::ast::Ast(allocator, source);
    var declarations = std::array::Array<std::kizu::ast::NodeId>(allocator);
    let result = std::kizu::parser::parse_program_with_declarations(
        allocator,
        declarations,
        ast,
        text,
        std::kizu::lexer::first_token(text)
    );
    declarations.deinit();
    return result;
}

fn parse_program_with_declarations(
    allocator: Allocator,
    declarations: &mut std::array::Array<std::kizu::ast::NodeId>,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    first: std::kizu::lexer::Token
) -> !std::kizu::ast::ParseResult {
    var token = first;
    while !std::kizu::parser::is_eof_token(token) {
        let declaration = try std::kizu::parser::parse_top_level_decl(allocator, ast, text, token);
        try declarations.append(declaration.node);
        token = declaration.next;
    }
    let child_start = ast.begin_children();
    var index = 0;
    while index < declarations.len() {
        try ast.add_child(try declarations.get(index));
        index = index + 1;
    }
    let range = ast.finish_children(child_start);
    let root = ast.add_program(std::kizu::ast::span(first.start, token.end), range);
    return std::kizu::ast::parse_result(ast, root);
}

fn parse_top_level_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    return std::kizu::parser::parse_decl_with_visibility(allocator, ast, text, token, false);
}

fn parse_decl_with_visibility(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token,
    public: bool
) -> !ParseNode {
    match token.kind {
        Import => return std::kizu::parser::parse_import_decl(ast, text, token);
        Pub => return std::kizu::parser::parse_public_decl(allocator, ast, text, token);
        Fn => return std::kizu::parser::parse_fn_decl(
            allocator,
            ast,
            text,
            token,
            public,
            false,
            ast.add_empty(token.start),
            true
        );
        Unsafe => return std::kizu::parser::parse_unsafe_decl(allocator, ast, text, token, public);
        Extern => return std::kizu::parser::parse_extern_decl(allocator, ast, text, token, public, false);
        Struct => return std::kizu::parser::parse_struct_decl(allocator, ast, text, token, public);
        Enum => return std::kizu::parser::parse_enum_decl(allocator, ast, text, token, public);
        Union => return std::kizu::parser::parse_union_decl(allocator, ast, text, token, public);
        Eof => return error("expected declaration");
        Return => return error("expected declaration");
        Ident => return error("expected declaration");
        Lifetime => return error("expected declaration");
        Number => return error("expected declaration");
        String => return error("expected declaration");
        LBrace => return error("expected declaration");
        RBrace => return error("expected declaration");
        LParen => return error("expected declaration");
        RParen => return error("expected declaration");
        Semicolon => return error("expected declaration");
        Comma => return error("expected declaration");
        Colon => return error("expected declaration");
        Arrow => return error("expected declaration");
        Bang => return error("expected declaration");
        Amp => return error("expected declaration");
        Mut => return error("expected declaration");
        LBracket => return error("expected declaration");
        RBracket => return error("expected declaration");
        LT => return error("expected declaration");
        GT => return error("expected declaration");
        Question => return error("expected declaration");
        DoubleColon => return error("expected declaration");
        Plus => return error("expected declaration");
        Asterisk => return error("expected declaration");
        Let => return error("expected declaration");
        Var => return error("expected declaration");
        If => return error("expected declaration");
        Else => return error("expected declaration");
        While => return error("expected declaration");
        For => return error("expected declaration");
        Break => return error("expected declaration");
        Continue => return error("expected declaration");
        Match => return error("expected declaration");
        Comptime => return error("expected declaration");
        Try => return error("expected declaration");
        True => return error("expected declaration");
        False => return error("expected declaration");
        And => return error("expected declaration");
        Or => return error("expected declaration");
        Assign => return error("expected declaration");
        FatArrow => return error("expected declaration");
        Eq => return error("expected declaration");
        NotEq => return error("expected declaration");
        LTE => return error("expected declaration");
        GTE => return error("expected declaration");
        Minus => return error("expected declaration");
        Slash => return error("expected declaration");
        Percent => return error("expected declaration");
        Dot => return error("expected declaration");
        Range => return error("expected declaration");
        Pipe => return error("expected declaration");
}
}

fn parse_public_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    pub_token: std::kizu::lexer::Token
) -> !ParseNode {
    return std::kizu::parser::parse_decl_with_visibility(
        allocator,
        ast,
        text,
        std::kizu::lexer::next_token(text, pub_token),
        true
    );
}

fn parse_decl_result(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    let text = source.text;
    var ast = std::kizu::ast::Ast(allocator, source);
    let root = try std::kizu::parser::parse_top_level_decl(
        allocator,
        ast,
        text,
        std::kizu::lexer::first_token(text)
    );
    return std::kizu::ast::parse_result(ast, root.node);
}

fn parse_fn_decl_result(
    allocator: Allocator,
    source: std::kizu::ast::SourceFile
) -> !std::kizu::ast::ParseResult {
    return std::kizu::parser::parse_decl_result(allocator, source);
}

fn parse_fn_decl(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    fn_token: std::kizu::lexer::Token,
    public: bool,
    unsafe_decl: bool,
    extern_abi: std::kizu::ast::NodeId,
    require_body: bool
) -> !ParseNode {
    let name = std::kizu::lexer::next_token(text, fn_token);
    match name.kind {
        Fn => return error("expected function name");
        Ident => return std::kizu::parser::parse_fn_body_node(
            allocator,
            ast,
            text,
            fn_token,
            public,
            unsafe_decl,
            extern_abi,
            name,
            require_body
        );
        Lifetime => return error("expected function name");
        Eof => return error("expected function name");
        Import => return error("expected function name");
        Pub => return error("expected function name");
        Struct => return error("expected function name");
        Enum => return error("expected function name");
        Union => return error("expected function name");
        Extern => return error("expected function name");
        Return => return error("expected function name");
        Number => return error("expected function name");
        String => return error("expected function name");
        LBrace => return error("expected function name");
        RBrace => return error("expected function name");
        LParen => return error("expected function name");
        RParen => return error("expected function name");
        Semicolon => return error("expected function name");
        Comma => return error("expected function name");
        Colon => return error("expected function name");
        Arrow => return error("expected function name");
        Bang => return error("expected function name");
        Amp => return error("expected function name");
        Mut => return error("expected function name");
        LBracket => return error("expected function name");
        RBracket => return error("expected function name");
        LT => return error("expected function name");
        GT => return error("expected function name");
        Question => return error("expected function name");
        DoubleColon => return error("expected function name");
        Plus => return error("expected function name");
        Asterisk => return error("expected function name");
            Let => return error("expected function name");
        Var => return error("expected function name");
        If => return error("expected function name");
        Else => return error("expected function name");
        While => return error("expected function name");
        For => return error("expected function name");
        Break => return error("expected function name");
        Continue => return error("expected function name");
        Match => return error("expected function name");
        Unsafe => return error("expected function name");
        Comptime => return error("expected function name");
        Try => return error("expected function name");
        True => return error("expected function name");
        False => return error("expected function name");
