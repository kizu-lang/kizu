fn parse_type_base_end(
    text: []const u8,
    first: std::kizu::lexer::Token
) -> !std::kizu::lexer::Token {
    var end = first;
    var next = std::kizu::lexer::next_token(text, end);
    while std::kizu::parser::is_double_colon(next) {
        let segment = std::kizu::lexer::next_token(text, next);
        end = try std::kizu::parser::expect_type_segment(segment);
        next = std::kizu::lexer::next_token(text, end);
    }
    return end;
}

