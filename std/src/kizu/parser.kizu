fn parse_statement(
    allocator: Allocator,
    ast: std::kizu::ast::Ast,
    text: []const u8,
    token: std::kizu::lexer::Token
) -> !ParseNode {
    match token.kind {
        Import => return error("expected statement");
        Pub => return error("expected statement");
        Struct => return error("expected statement");
        Enum => return error("expected statement");
        Union => return error("expected statement");
        Extern => return error("expected statement");
        Let => return std::kizu::parser::parse_let(allocator, ast, text, token, false);
        Var => return std::kizu::parser::parse_let(allocator, ast, text, token, true);
        Return => return std::kizu::parser::parse_return(allocator, ast, text, token);
        If => return std::kizu::parser::parse_if(allocator, ast, text, token);
        While => return std::kizu::parser::parse_while(allocator, ast, text, token, ast.add_empty(token.start));
        For => return std::kizu::parser::parse_for(allocator, ast, text, token, ast.add_empty(token.start));
        Break => return std::kizu::parser::parse_break(ast, text, token);
        Continue => return std::kizu::parser::parse_continue(ast, text, token);
        Match => return std::kizu::parser::parse_match(allocator, ast, text, token);
        Unsafe => return std::kizu::parser::parse_unsafe(allocator, ast, text, token);
        Comptime => return std::kizu::parser::parse_comptime_statement(allocator, ast, text, token);
        Ident => return std::kizu::parser::parse_ident_statement(allocator, ast, text, token);
        Lifetime => return error("expected statement");
        Number => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        String => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        True => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        False => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        Try => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        Bang => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        Minus => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        Amp => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        LParen => return std::kizu::parser::parse_expr_or_assign_statement(allocator, ast, text, token);
        Eof => return error("expected right brace");
        Fn => return error("expected statement");
        Else => return error("expected statement");
        And => return error("expected statement");
        Or => return error("expected statement");
        LBrace => return error("expected statement");
        RBrace => return error("expected statement");
        RParen => return error("expected statement");
        Semicolon => return error("expected statement");
        Comma => return error("expected statement");
        Colon => return error("expected statement");
        DoubleColon => return error("expected statement");
        Assign => return error("expected statement");
        Arrow => return error("expected statement");
        FatArrow => return error("expected statement");
        Eq => return error("expected statement");
        NotEq => return error("expected statement");
        LBracket => return error("expected statement");
        RBracket => return error("expected statement");
        LT => return error("expected statement");
        LTE => return error("expected statement");
        GT => return error("expected statement");
        GTE => return error("expected statement");
        Question => return error("expected statement");
        Plus => return error("expected statement");
