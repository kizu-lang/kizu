pub enum TokenKind {
    Fn
    Return
    Ident
    Number
    LBrace
    RBrace
    LParen
    RParen
    Semicolon
    Comma
    Colon
    Arrow
    Plus
    Asterisk
    String
    Eof
}

pub struct Token {
    pub kind: std::kizu::lexer::TokenKind;
    pub start: i64;
    pub end: i64;
}

pub fn first_token(source: []const u8) -> std::kizu::lexer::Token {
    return std::kizu::lexer::token_at(source, 0);
}

pub fn next_token(
    source: []const u8,
    previous: std::kizu::lexer::Token
) -> std::kizu::lexer::Token {
    return std::kizu::lexer::token_at(source, previous.end);
}

fn token_at(source: []const u8, offset: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var start = offset;
    while start < length and std::kizu::lexer::is_space(source[start]) {
        start = start + 1;
    }
    if start >= length {
        return std::kizu::lexer::token(TokenKind::Eof, start, start);
    }

    let byte = source[start];
    if byte == cast<u8>(123) {
        return std::kizu::lexer::token(TokenKind::LBrace, start, start + 1);
    }
    if byte == cast<u8>(125) {
        return std::kizu::lexer::token(TokenKind::RBrace, start, start + 1);
    }
    if byte == cast<u8>(40) {
        return std::kizu::lexer::token(TokenKind::LParen, start, start + 1);
    }
    if byte == cast<u8>(41) {
        return std::kizu::lexer::token(TokenKind::RParen, start, start + 1);
    }
    if byte == cast<u8>(59) {
        return std::kizu::lexer::token(TokenKind::Semicolon, start, start + 1);
    }
    if byte == cast<u8>(44) {
        return std::kizu::lexer::token(TokenKind::Comma, start, start + 1);
    }
    if byte == cast<u8>(58) {
        return std::kizu::lexer::token(TokenKind::Colon, start, start + 1);
    }
    if byte == cast<u8>(45) and start + 1 < length and source[start + 1] == cast<u8>(62) {
        return std::kizu::lexer::token(TokenKind::Arrow, start, start + 2);
    }
    if byte == cast<u8>(43) {
        return std::kizu::lexer::token(TokenKind::Plus, start, start + 1);
    }
    if byte == cast<u8>(42) {
        return std::kizu::lexer::token(TokenKind::Asterisk, start, start + 1);
    }
    if byte == cast<u8>(34) {
        return std::kizu::lexer::string_token(source, start);
    }
    if std::kizu::lexer::is_digit(byte) {
        return std::kizu::lexer::number_token(source, start);
    }
    return std::kizu::lexer::word_token(source, start);
}

fn word_token(source: []const u8, start: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var end = start;
    while end < length and std::kizu::lexer::is_word(source[end]) {
        end = end + 1;
    }
    let text = source[start..end];
    if std::mem::equal_bytes(text, "fn") {
        return std::kizu::lexer::token(TokenKind::Fn, start, end);
    }
    if std::mem::equal_bytes(text, "return") {
        return std::kizu::lexer::token(TokenKind::Return, start, end);
    }
    return std::kizu::lexer::token(TokenKind::Ident, start, end);
}

fn number_token(source: []const u8, start: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var end = start;
    while end < length and std::kizu::lexer::is_digit(source[end]) {
        end = end + 1;
    }
    return std::kizu::lexer::token(TokenKind::Number, start, end);
}

fn string_token(source: []const u8, start: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var end = start + 1;
    while end < length and source[end] != cast<u8>(34) {
        end = end + 1;
    }
    if end < length {
        return std::kizu::lexer::token(TokenKind::String, start, end + 1);
    }
    return std::kizu::lexer::token(TokenKind::String, start, end);
}

fn token(kind: std::kizu::lexer::TokenKind, start: i64, end: i64) -> std::kizu::lexer::Token {
    return Token {
        kind: kind,
        start: start,
        end: end
    };
}

fn is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(10) or
        byte == cast<u8>(9) or byte == cast<u8>(13);
}

fn is_word(byte: u8) -> bool {
    return std::kizu::lexer::is_alpha(byte) or std::kizu::lexer::is_digit(byte);
}

fn is_alpha(byte: u8) -> bool {
    return (byte >= cast<u8>(65) and byte <= cast<u8>(90)) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        byte == cast<u8>(95);
}

fn is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}
