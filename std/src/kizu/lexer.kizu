pub enum TokenKind {
    Fn
    Ident
    Eof
}

pub struct Token {
    pub kind: std::kizu::lexer::TokenKind;
    pub start: i64;
    pub end: i64;
}

pub fn first_token(source: []const u8) -> std::kizu::lexer::Token {
    return std::kizu::lexer::token_at(source, 0);
}

pub fn next_token(
    source: []const u8,
    previous: std::kizu::lexer::Token,
) -> std::kizu::lexer::Token {
    return std::kizu::lexer::token_at(source, previous.end);
}

fn token_at(source: []const u8, offset: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var start = offset;
    while start < length and std::kizu::lexer::is_space(source[start]) {
        start = start + 1;
    }
    if start >= length {
        return Token {
            kind: TokenKind::Eof,
            start: start,
            end: start
        };
    }

    var end = start;
    while end < length and !std::kizu::lexer::is_space(source[end]) {
        end = end + 1;
    }
    let text = source[start..end];
    if std::mem::equal_bytes(text, "fn") {
        return Token {
            kind: TokenKind::Fn,
            start: start,
            end: end
        };
    }

    return Token {
        kind: TokenKind::Ident,
        start: start,
        end: end
    };
}

fn is_space(byte: u8) -> bool {
    return byte == cast<u8>(32);
}
