pub enum TokenKind {
    Fn
    Import
    Pub
    Struct
    Enum
    Union
    Extern
    Let
    Var
    Return
    If
    Else
    While
    For
    Break
    Continue
    Match
    Unsafe
    Comptime
    Try
    True
    False
    And
    Or
    Ident
    Number
    LBrace
    RBrace
    LParen
    RParen
    Semicolon
    Comma
    Colon
    DoubleColon
    Assign
    Arrow
    FatArrow
    Bang
    Eq
    NotEq
    Amp
    LBracket
    RBracket
    LT
    LTE
    GT
    GTE
    Question
    Plus
    Minus
    Asterisk
    Slash
    Percent
    Dot
    Range
    Pipe
    Mut
    String
    Eof
}

pub struct Token {
    pub kind: std::kizu::lexer::TokenKind;
    pub start: i64;
    pub end: i64;
}

pub fn first_token(source: []const u8) -> std::kizu::lexer::Token {
    return std::kizu::lexer::token_at(source, 0);
}

pub fn next_token(
    source: []const u8,
    previous: std::kizu::lexer::Token
) -> std::kizu::lexer::Token {
    return std::kizu::lexer::token_at(source, previous.end);
}

fn token_at(source: []const u8, offset: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var start = offset;
    var scanning = true;
    while scanning {
        while start < length and std::kizu::lexer::is_space(source[start]) {
            start = start + 1;
        }
        if start + 1 < length and source[start] == cast<u8>(47) and
            source[start + 1] == cast<u8>(47) {
            start = std::kizu::lexer::skip_line_comment(source, start + 2);
        } else {
            scanning = false;
        }
    }
    if start >= length {
        return std::kizu::lexer::token(TokenKind::Eof, start, start);
    }

    let byte = source[start];
    if byte == cast<u8>(123) {
        return std::kizu::lexer::token(TokenKind::LBrace, start, start + 1);
    }
    if byte == cast<u8>(125) {
        return std::kizu::lexer::token(TokenKind::RBrace, start, start + 1);
    }
    if byte == cast<u8>(40) {
        return std::kizu::lexer::token(TokenKind::LParen, start, start + 1);
    }
    if byte == cast<u8>(41) {
        return std::kizu::lexer::token(TokenKind::RParen, start, start + 1);
    }
    if byte == cast<u8>(59) {
        return std::kizu::lexer::token(TokenKind::Semicolon, start, start + 1);
    }
    if byte == cast<u8>(44) {
        return std::kizu::lexer::token(TokenKind::Comma, start, start + 1);
    }
    if byte == cast<u8>(33) {
        if start + 1 < length and source[start + 1] == cast<u8>(61) {
            return std::kizu::lexer::token(TokenKind::NotEq, start, start + 2);
        }
        return std::kizu::lexer::token(TokenKind::Bang, start, start + 1);
    }
    if byte == cast<u8>(38) {
        return std::kizu::lexer::token(TokenKind::Amp, start, start + 1);
    }
    if byte == cast<u8>(60) {
        if start + 1 < length and source[start + 1] == cast<u8>(61) {
            return std::kizu::lexer::token(TokenKind::LTE, start, start + 2);
        }
        return std::kizu::lexer::token(TokenKind::LT, start, start + 1);
    }
    if byte == cast<u8>(62) {
        if start + 1 < length and source[start + 1] == cast<u8>(61) {
            return std::kizu::lexer::token(TokenKind::GTE, start, start + 2);
        }
        return std::kizu::lexer::token(TokenKind::GT, start, start + 1);
    }
    if byte == cast<u8>(63) {
        return std::kizu::lexer::token(TokenKind::Question, start, start + 1);
    }
    if byte == cast<u8>(91) {
        return std::kizu::lexer::token(TokenKind::LBracket, start, start + 1);
    }
    if byte == cast<u8>(93) {
        return std::kizu::lexer::token(TokenKind::RBracket, start, start + 1);
    }
    if byte == cast<u8>(58) {
        if start + 1 < length and source[start + 1] == cast<u8>(58) {
            return std::kizu::lexer::token(TokenKind::DoubleColon, start, start + 2);
        }
        return std::kizu::lexer::token(TokenKind::Colon, start, start + 1);
    }
    if byte == cast<u8>(45) and start + 1 < length and source[start + 1] == cast<u8>(62) {
        return std::kizu::lexer::token(TokenKind::Arrow, start, start + 2);
    }
    if byte == cast<u8>(45) {
        return std::kizu::lexer::token(TokenKind::Minus, start, start + 1);
    }
    if byte == cast<u8>(61) {
        if start + 1 < length and source[start + 1] == cast<u8>(61) {
            return std::kizu::lexer::token(TokenKind::Eq, start, start + 2);
        }
        if start + 1 < length and source[start + 1] == cast<u8>(62) {
            return std::kizu::lexer::token(TokenKind::FatArrow, start, start + 2);
        }
        return std::kizu::lexer::token(TokenKind::Assign, start, start + 1);
    }
    if byte == cast<u8>(43) {
        return std::kizu::lexer::token(TokenKind::Plus, start, start + 1);
    }
    if byte == cast<u8>(42) {
        return std::kizu::lexer::token(TokenKind::Asterisk, start, start + 1);
    }
    if byte == cast<u8>(47) {
        return std::kizu::lexer::token(TokenKind::Slash, start, start + 1);
    }
    if byte == cast<u8>(37) {
        return std::kizu::lexer::token(TokenKind::Percent, start, start + 1);
    }
    if byte == cast<u8>(46) {
        if start + 1 < length and source[start + 1] == cast<u8>(46) {
            return std::kizu::lexer::token(TokenKind::Range, start, start + 2);
        }
        return std::kizu::lexer::token(TokenKind::Dot, start, start + 1);
    }
    if byte == cast<u8>(124) {
        return std::kizu::lexer::token(TokenKind::Pipe, start, start + 1);
    }
    if byte == cast<u8>(34) {
        return std::kizu::lexer::string_token(source, start);
    }
    if std::kizu::lexer::is_digit(byte) {
        return std::kizu::lexer::number_token(source, start);
    }
    return std::kizu::lexer::word_token(source, start);
}

fn word_token(source: []const u8, start: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var end = start;
    while end < length and std::kizu::lexer::is_word(source[end]) {
        end = end + 1;
    }
    let text = source[start..end];
    if std::mem::equal_bytes(text, "fn") {
        return std::kizu::lexer::token(TokenKind::Fn, start, end);
    }
    if std::mem::equal_bytes(text, "import") {
        return std::kizu::lexer::token(TokenKind::Import, start, end);
    }
    if std::mem::equal_bytes(text, "pub") {
        return std::kizu::lexer::token(TokenKind::Pub, start, end);
    }
    if std::mem::equal_bytes(text, "struct") {
        return std::kizu::lexer::token(TokenKind::Struct, start, end);
    }
    if std::mem::equal_bytes(text, "enum") {
        return std::kizu::lexer::token(TokenKind::Enum, start, end);
    }
    if std::mem::equal_bytes(text, "union") {
        return std::kizu::lexer::token(TokenKind::Union, start, end);
    }
    if std::mem::equal_bytes(text, "extern") {
        return std::kizu::lexer::token(TokenKind::Extern, start, end);
    }
    if std::mem::equal_bytes(text, "let") {
        return std::kizu::lexer::token(TokenKind::Let, start, end);
    }
    if std::mem::equal_bytes(text, "var") {
        return std::kizu::lexer::token(TokenKind::Var, start, end);
    }
    if std::mem::equal_bytes(text, "return") {
        return std::kizu::lexer::token(TokenKind::Return, start, end);
    }
    if std::mem::equal_bytes(text, "if") {
        return std::kizu::lexer::token(TokenKind::If, start, end);
    }
    if std::mem::equal_bytes(text, "else") {
        return std::kizu::lexer::token(TokenKind::Else, start, end);
    }
    if std::mem::equal_bytes(text, "while") {
        return std::kizu::lexer::token(TokenKind::While, start, end);
    }
    if std::mem::equal_bytes(text, "for") {
        return std::kizu::lexer::token(TokenKind::For, start, end);
    }
    if std::mem::equal_bytes(text, "break") {
        return std::kizu::lexer::token(TokenKind::Break, start, end);
    }
    if std::mem::equal_bytes(text, "continue") {
        return std::kizu::lexer::token(TokenKind::Continue, start, end);
    }
    if std::mem::equal_bytes(text, "match") {
        return std::kizu::lexer::token(TokenKind::Match, start, end);
    }
    if std::mem::equal_bytes(text, "unsafe") {
        return std::kizu::lexer::token(TokenKind::Unsafe, start, end);
    }
    if std::mem::equal_bytes(text, "comptime") {
        return std::kizu::lexer::token(TokenKind::Comptime, start, end);
    }
    if std::mem::equal_bytes(text, "try") {
        return std::kizu::lexer::token(TokenKind::Try, start, end);
    }
    if std::mem::equal_bytes(text, "true") {
        return std::kizu::lexer::token(TokenKind::True, start, end);
    }
    if std::mem::equal_bytes(text, "false") {
        return std::kizu::lexer::token(TokenKind::False, start, end);
    }
    if std::mem::equal_bytes(text, "and") {
        return std::kizu::lexer::token(TokenKind::And, start, end);
    }
    if std::mem::equal_bytes(text, "or") {
        return std::kizu::lexer::token(TokenKind::Or, start, end);
    }
    if std::mem::equal_bytes(text, "mut") {
        return std::kizu::lexer::token(TokenKind::Mut, start, end);
    }
    return std::kizu::lexer::token(TokenKind::Ident, start, end);
}

fn skip_line_comment(source: []const u8, start: i64) -> i64 {
    let length = std::mem::len(source);
    var end = start;
    while end < length and source[end] != cast<u8>(10) {
        end = end + 1;
    }
    return end;
}

fn number_token(source: []const u8, start: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var end = start;
    while end < length and std::kizu::lexer::is_digit(source[end]) {
        end = end + 1;
    }
    return std::kizu::lexer::token(TokenKind::Number, start, end);
}

fn string_token(source: []const u8, start: i64) -> std::kizu::lexer::Token {
    let length = std::mem::len(source);
    var end = start + 1;
    while end < length and source[end] != cast<u8>(34) {
        end = end + 1;
    }
    if end < length {
        return std::kizu::lexer::token(TokenKind::String, start, end + 1);
    }
    return std::kizu::lexer::token(TokenKind::String, start, end);
}

fn token(kind: std::kizu::lexer::TokenKind, start: i64, end: i64) -> std::kizu::lexer::Token {
    return Token {
        kind: kind,
        start: start,
        end: end
    };
}

fn is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(10) or
        byte == cast<u8>(9) or byte == cast<u8>(13);
}

fn is_word(byte: u8) -> bool {
    return std::kizu::lexer::is_alpha(byte) or std::kizu::lexer::is_digit(byte);
}

fn is_alpha(byte: u8) -> bool {
    return (byte >= cast<u8>(65) and byte <= cast<u8>(90)) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        byte == cast<u8>(95);
}

fn is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}
