pub fn basename(path: []u8) -> []u8 borrows path {
    let length = std::mem::len(path);
    if length == 0 {
        return ".";
    }

    let end = std::path_bits::trim_trailing_slashes(path, length);
    if end == 1 and std::path_bits::is_slash(path[0]) {
        return "/";
    }

    let slash = std::path_bits::last_slash_before(path, end);
    if slash < 0 {
        return path[0..end];
    }
    return path[slash + 1..end];
}

pub fn dirname(path: []u8) -> []u8 borrows path {
    let length = std::mem::len(path);
    if length == 0 {
        return ".";
    }

    let end = std::path_bits::trim_trailing_slashes(path, length);
    if end == 1 and std::path_bits::is_slash(path[0]) {
        return "/";
    }

    let slash = std::path_bits::last_slash_before(path, end);
    if slash < 0 {
        return ".";
    }
    if slash == 0 {
        return "/";
    }

    let dir_end = std::path_bits::trim_trailing_slashes(path, slash);
    if dir_end == 0 {
        return ".";
    }
    if dir_end == 1 and std::path_bits::is_slash(path[0]) {
        return "/";
    }
    return path[0..dir_end];
}

pub fn extension(path: []u8) -> []u8 borrows path {
    var index = std::mem::len(path);
    while index > 0 {
        let previous = index - 1;
        if std::path_bits::is_slash(path[previous]) {
            return "";
        }
        if std::path_bits::is_dot(path[previous]) {
            return path[previous..std::mem::len(path)];
        }
        index = previous;
    }
    return "";
}

pub fn trim_trailing_slashes(path: []u8, length: i64) -> i64 {
    var end = length;
    while end > 1 and std::path_bits::is_slash(path[end - 1]) {
        end = end - 1;
    }
    return end;
}

pub fn last_slash_before(path: []u8, end: i64) -> i64 {
    var index = end;
    while index > 0 {
        let previous = index - 1;
        if std::path_bits::is_slash(path[previous]) {
            return previous;
        }
        index = previous;
    }
    return -1;
}

pub fn is_slash(byte: u8) -> bool {
    return byte == cast<u8>(47);
}

pub fn is_dot(byte: u8) -> bool {
    return byte == cast<u8>(46);
}
