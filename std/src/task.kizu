pub fn Group(io: Io) -> TaskGroup {
    return std::builtin::task_group(io);
}

pub fn Queue() -> Queue {
    return std::builtin::task_queue();
}

pub fn partition_mut(init: i64, count: i64) -> Partition {
    return std::builtin::task_partition_mut(init, count);
}

pub fn LocalBuffer(count: i64, init: i64) -> LocalBuffer {
    return std::builtin::task_local_buffer(count, init);
}

pub fn parallel_for(io: Io, start: i64, end: i64, comptime worker: Function) -> !void {
    try std::builtin::task_parallel_for(io, start, end, worker);
    return;
}

pub fn parallel_map(
    io: Io,
    partition: &mut Partition,
    start: i64,
    end: i64,
    comptime worker: Function
) -> void {
    std::builtin::task_parallel_map(io, partition, start, end, worker);
}
