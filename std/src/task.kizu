pub fn Group(io: Io) -> TaskGroup {
    return std::builtin::task_group(io);
}

pub fn Queue() -> Queue {
    return std::builtin::task_queue();
}

pub fn partition_mut(init: i64, count: i64) -> Partition {
    return std::builtin::task_partition_mut(init, count);
}

pub fn LocalBuffer(count: i64, init: i64) -> LocalBuffer {
    return std::builtin::task_local_buffer(count, init);
}

pub fn parallel_for<worker: Function>(io: Io, start: i64, end: i64) -> !void {
    try std::builtin::task_parallel_for<worker>(io, start, end);
    return;
}

pub fn parallel_map<worker: Function>(
    io: Io,
    partition: &var Partition,
    start: i64,
    end: i64
) -> void {
    std::builtin::task_parallel_map<worker>(io, partition, start, end);
}
