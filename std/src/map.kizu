pub fn Map<K, V>(allocator: Allocator) -> std::map::Map<K, V> {
    return std::builtin::map<K, V>(allocator);
}

fn insert<V>(self: std::map::Map<[]const u8, V>, key: []const u8, value: V) -> !void {
    return std::builtin::map_insert<[]const u8, V>(self, key, value);
}

fn get<V>(self: std::map::Map<[]const u8, V>, key: []const u8) -> !V {
    return std::builtin::map_get<[]const u8, V>(self, key);
}

fn contains<V>(self: std::map::Map<[]const u8, V>, key: []const u8) -> bool {
    return std::builtin::map_contains<[]const u8, V>(self, key);
}

fn len<V>(self: std::map::Map<[]const u8, V>) -> i64 {
    return std::builtin::map_len<[]const u8, V>(self);
}

fn deinit<V>(self: std::map::Map<[]const u8, V>) -> void {
    std::builtin::map_deinit<[]const u8, V>(self);
}
