pub struct Io {
    mode: i64;
}

pub extern "kizu_primitive" fn blocking() -> Io
pub extern "kizu_primitive" fn threaded() -> Io
pub extern "kizu_primitive" fn evented() -> Io
pub extern "kizu_primitive" fn failing() -> Io
pub extern "kizu_primitive" fn write_stdout(io: Io, bytes: []const u8) -> !void
pub extern "kizu_primitive" fn write_stderr(io: Io, bytes: []const u8) -> !void
pub extern "kizu_primitive" fn read_stdin(io: Io) -> ![]const u8
