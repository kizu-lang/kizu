pub fn blocking() -> Io {
    return std::builtin::io_blocking();
}

pub fn threaded() -> Io {
    return std::builtin::io_threaded();
}

pub fn failing() -> Io {
    return std::builtin::io_failing();
}

pub fn write_stdout(io: Io, bytes: []const u8) -> !void {
    try std::builtin::io_write_stdout(io, bytes);
    return;
}

pub fn write_stderr(io: Io, bytes: []const u8) -> !void {
    try std::builtin::io_write_stderr(io, bytes);
    return;
}

pub fn read_stdin(io: Io) -> ![]const u8 {
    let bytes = try std::builtin::io_read_stdin(io);
    return bytes;
}
