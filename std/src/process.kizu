pub fn arg_count() -> i64 {
    return std::builtin::process_arg_count();
}

pub fn arg(index: i64) -> ![]const u8 {
    let value = try std::builtin::process_arg(index);
    return value;
}

pub fn env(name: []const u8) -> ![]const u8 {
    let value = try std::builtin::process_env(name);
    return value;
}

pub fn exit_code(code: i64) -> i64 {
    return std::builtin::process_exit_code(code);
}
