import app::lexer;

pub struct Token {}

fn tokens() -> void {
    let name = "hello";
    var value = 1 + 2 - 3 * 4 / 5 % 6;

    if value == 1 != false {
        value = value + 1;
    } else {
        while value < 10 <= 11 > 0 >= 0 {
            break;
            continue;
        }
    }

    match Color::Red {
        Red => return void;
    }

    unsafe extern comptime try mut;
    contract Writer {}
    satisfy Writer for File;
    impl File {}
    union Result { Ok Error }
    enum Color { Red Green }
    value.field..range;
    items[0]? &value | other;
}
