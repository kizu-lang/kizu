fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let values = std::array::Array<i64>(allocator);
    let text = std::string::String(allocator);
    let table = std::map::Map<[]const u8, i64>(allocator);

    values.deinit();
    text.deinit();
    table.deinit();
    return;
}
