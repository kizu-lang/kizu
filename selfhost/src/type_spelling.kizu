// TypeLayer stores offsets only. Callers supply the original spelling to the
// accessors, so no parsed fact can outlive or disguise its source owner.
pub struct TypeLayer {
    pub kind: i64,
    pub constructor_start: i64,
    pub constructor_end: i64,
    pub first_child_start: i64,
    pub first_child_end: i64,
    pub second_child_start: i64,
    pub second_child_end: i64,
    pub arguments_start: i64,
    pub arguments_end: i64,
    pub has_arguments: bool,
}

pub fn layer_named() -> i64 { return 1; }
pub fn layer_borrow() -> i64 { return 2; }
pub fn layer_borrow_var() -> i64 { return 3; }
pub fn layer_slice() -> i64 { return 4; }
pub fn layer_nullable() -> i64 { return 5; }
pub fn layer_dynamic() -> i64 { return 6; }
pub fn layer_error_union() -> i64 { return 7; }
pub fn layer_const() -> i64 { return 8; }

pub fn constructor(layer: &TypeLayer, spelling: []u8) -> ![]u8 borrows spelling {
    return spelling[layer.constructor_start..layer.constructor_end];
}

pub fn first_child(layer: &TypeLayer, spelling: []u8) -> ![]u8 borrows spelling {
    return spelling[layer.first_child_start..layer.first_child_end];
}

pub fn second_child(layer: &TypeLayer, spelling: []u8) -> ![]u8 borrows spelling {
    return spelling[layer.second_child_start..layer.second_child_end];
}

pub fn arguments(layer: &TypeLayer, spelling: []u8) -> ![]u8 borrows spelling {
    return spelling[layer.arguments_start..layer.arguments_end];
}

pub fn parse(type_name: []u8) -> !TypeLayer {
    let start = trim_start(type_name, 0, std::mem::len(type_name));
    let end = trim_end(type_name, start, std::mem::len(type_name));
    if start == end { return error("empty exact type spelling"); }
    try validate_delimiters(type_name, start, end);
    if starts_with_at(type_name, start, end, "!") {
        let child_start = trim_start(type_name, start + 1, end);
        if child_start == end { return error("error union success type missing"); }
        return layer(
            layer_error_union(), start, start + 1,
            start, start, child_start, end, start, start, false
        );
    }
    if starts_with_at(type_name, start, end, "&var ") {
        return unary_layer(layer_borrow_var(), type_name, start, start + 4, start + 5, end);
    }
    if starts_with_at(type_name, start, end, "&") {
        return unary_layer(layer_borrow(), type_name, start, start + 1, start + 1, end);
    }
    if starts_with_at(type_name, start, end, "[]") {
        return unary_layer(layer_slice(), type_name, start, start + 2, start + 2, end);
    }
    if starts_with_at(type_name, start, end, "?") {
        return unary_layer(layer_nullable(), type_name, start, start + 1, start + 1, end);
    }
    if starts_with_at(type_name, start, end, "dyn ") {
        return unary_layer(layer_dynamic(), type_name, start, start + 3, start + 4, end);
    }
    if starts_with_at(type_name, start, end, "const ") {
        return unary_layer(layer_const(), type_name, start, start + 5, start + 6, end);
    }
    let bang = top_level_byte(type_name, start, end, cast<u8>(33));
    if bang >= 0 {
        let left_start = trim_start(type_name, start, bang);
        let left_end = trim_end(type_name, left_start, bang);
        let right_start = trim_start(type_name, bang + 1, end);
        let right_end = trim_end(type_name, right_start, end);
        if left_start == left_end or right_start == right_end {
            return error("typed error union child type missing");
        }
        return layer(
            layer_error_union(), bang, bang + 1,
            left_start, left_end, right_start, right_end, start, start, false
        );
    }
    let open = top_level_byte(type_name, start, end, cast<u8>(60));
    if open < 0 {
        return layer(
            layer_named(), start, end,
            start, start, start, start, start, start, false
        );
    }
    let constructor_end = trim_end(type_name, start, open);
    if constructor_end == start { return error("generic type constructor missing"); }
    if type_name[end - 1] != cast<u8>(62) {
        return error("generic type closing delimiter missing");
    }
    let arguments_start = open + 1;
    let arguments_end = end - 1;
    if trim_start(type_name, arguments_start, arguments_end) == arguments_end {
        return error("generic type arguments missing");
    }
    let argument_bytes = type_name[arguments_start..arguments_end];
    try validate_arguments(argument_bytes);
    return layer(
        layer_named(), start, constructor_end,
        start, start, start, start, arguments_start, arguments_end, true
    );
}

fn layer(
    kind: i64,
    constructor_start: i64,
    constructor_end: i64,
    first_child_start: i64,
    first_child_end: i64,
    second_child_start: i64,
    second_child_end: i64,
    arguments_start: i64,
    arguments_end: i64,
    has_arguments: bool
) -> TypeLayer {
    return TypeLayer {
        kind: kind,
        constructor_start: constructor_start,
        constructor_end: constructor_end,
        first_child_start: first_child_start,
        first_child_end: first_child_end,
        second_child_start: second_child_start,
        second_child_end: second_child_end,
        arguments_start: arguments_start,
        arguments_end: arguments_end,
        has_arguments: has_arguments
    };
}

fn unary_layer(
    kind: i64,
    spelling: []u8,
    constructor_start: i64,
    constructor_end: i64,
    child_start: i64,
    end: i64
) -> !TypeLayer {
    let start = trim_start(spelling, child_start, end);
    if start == end { return error("type wrapper child missing"); }
    return layer(
        kind, constructor_start, constructor_end,
        start, end, end, end, end, end, false
    );
}

pub fn next_argument(arguments: []u8, start: i64) -> ![]u8 borrows arguments {
    if start < 0 or start >= std::mem::len(arguments) {
        return error("type argument cursor out of range");
    }
    var depth = 0;
    var index = start;
    while index < std::mem::len(arguments) {
        let byte = arguments[index];
        if byte == cast<u8>(60) { depth = depth + 1; }
        else {
            if byte == cast<u8>(62) { depth = depth - 1; }
            else {
                if byte == cast<u8>(44) and depth == 0 {
                    let value = std::mem::trim_ascii(arguments[start..index]);
                    if std::mem::len(value) == 0 { return error("empty type argument"); }
                    return value;
                }
            }
        }
        if depth < 0 { return error("unbalanced nested type arguments"); }
        index = index + 1;
    }
    if depth != 0 { return error("unbalanced nested type arguments"); }
    let value = std::mem::trim_ascii(arguments[start..std::mem::len(arguments)]);
    if std::mem::len(value) == 0 { return error("empty type argument"); }
    return value;
}

pub fn next_argument_start(arguments: []u8, start: i64) -> !i64 {
    let ignored = try next_argument(arguments, start);
    var depth = 0;
    var index = start;
    while index < std::mem::len(arguments) {
        let byte = arguments[index];
        if byte == cast<u8>(60) { depth = depth + 1; }
        else {
            if byte == cast<u8>(62) { depth = depth - 1; }
            else {
                if byte == cast<u8>(44) and depth == 0 {
                    index = trim_start(arguments, index + 1, std::mem::len(arguments));
                    if index == std::mem::len(arguments) {
                        return error("trailing type argument separator");
                    }
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return std::mem::len(arguments);
}

fn validate_arguments(arguments: []u8) -> !void {
    var start = 0;
    while start < std::mem::len(arguments) {
        let argument = try next_argument(arguments, start);
        let ignored = try parse(argument);
        start = try next_argument_start(arguments, start);
    }
    return;
}

fn validate_delimiters(value: []u8, start: i64, end: i64) -> !void {
    var depth = 0;
    var index = start;
    while index < end {
        if value[index] == cast<u8>(60) { depth = depth + 1; }
        else {
            if value[index] == cast<u8>(62) {
                depth = depth - 1;
                if depth < 0 { return error("unbalanced type delimiters"); }
            }
        }
        index = index + 1;
    }
    if depth != 0 { return error("unbalanced type delimiters"); }
    return;
}

fn top_level_byte(value: []u8, start: i64, end: i64, wanted: u8) -> i64 {
    var depth = 0;
    var index = start;
    while index < end {
        let byte = value[index];
        if byte == wanted and depth == 0 { return index; }
        if byte == cast<u8>(60) { depth = depth + 1; }
        else { if byte == cast<u8>(62) { depth = depth - 1; } }
        index = index + 1;
    }
    return -1;
}

fn trim_start(value: []u8, start: i64, end: i64) -> i64 {
    var index = start;
    while index < end {
        let byte = value[index];
        if byte != cast<u8>(32) and byte != cast<u8>(9) { return index; }
        index = index + 1;
    }
    return index;
}

fn trim_end(value: []u8, start: i64, end: i64) -> i64 {
    var index = end;
    while index > start {
        let previous = index - 1;
        let byte = value[previous];
        if byte != cast<u8>(32) and byte != cast<u8>(9) { return index; }
        index = previous;
    }
    return index;
}

fn starts_with_at(value: []u8, start: i64, end: i64, prefix: []u8) -> bool {
    if end - start < std::mem::len(prefix) { return false; }
    return std::mem::equal_bytes(
        value[start..start + std::mem::len(prefix)],
        prefix
    );
}
