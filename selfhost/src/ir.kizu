// Module: IR boundary for the future self-host compiler backend handoff.

pub enum InstructionKind {
    Const
    Call
    Return
}

pub struct Instruction {
    pub kind: InstructionKind;
    pub result_type: []const u8;
}

pub struct BlockSummary {
    pub name: []const u8;
    pub instruction_count: i64;
    pub has_terminator: bool;
}

pub struct FunctionSummary {
    pub name: []const u8;
    pub return_type: []const u8;
    pub block_count: i64;
    pub instruction_count: i64;
}

pub struct ModuleSummary {
    pub function_count: i64;
    pub block_count: i64;
    pub instruction_count: i64;
}

// instruction creates one normalized IR instruction fact.
pub fn instruction(kind: InstructionKind, result_type: []const u8) -> Instruction {
    return Instruction {
        kind: kind,
        result_type: result_type,
    };
}

// block creates a block summary for deterministic oracle comparisons.
pub fn block(
    name: []const u8,
    instruction_count: i64,
    has_terminator: bool
) -> BlockSummary {
    return BlockSummary {
        name: name,
        instruction_count: instruction_count,
        has_terminator: has_terminator,
    };
}

// function creates a function-level IR summary.
pub fn function(
    name: []const u8,
    return_type: []const u8,
    block_count: i64,
    instruction_count: i64
) -> FunctionSummary {
    return FunctionSummary {
        name: name,
        return_type: return_type,
        block_count: block_count,
        instruction_count: instruction_count,
    };
}

// module creates a module-level IR summary.
pub fn module(
    function_count: i64,
    block_count: i64,
    instruction_count: i64
) -> ModuleSummary {
    return ModuleSummary {
        function_count: function_count,
        block_count: block_count,
        instruction_count: instruction_count,
    };
}

// function_matches reports whether two function summaries match.
pub fn function_matches(left: &FunctionSummary, right: &FunctionSummary) -> bool {
    if !std::mem::equal_bytes(left.name, right.name) {
        return false;
    }
    if !std::mem::equal_bytes(left.return_type, right.return_type) {
        return false;
    }
    if left.block_count != right.block_count {
        return false;
    }
    return left.instruction_count == right.instruction_count;
}

// ready exposes the IR module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
