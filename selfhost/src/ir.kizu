import selfhost::ownership;
import selfhost::ownership::data;
import selfhost::resolver;
import selfhost::ir::executable_contract;
import selfhost::source;
import selfhost::source::loader;
import selfhost::types;

pub struct IrSummary {
    pub blocks: i64,
    pub entry_points: i64,
}

pub struct IrArtifact {
    pub ir_path: []u8,
    pub manifest_path: []u8,
    pub bytes: i64,
    pub manifest_bytes: i64,
}

pub fn lower(checked: &data::CheckedPackage) -> IrSummary {
    return IrSummary {
        blocks: checked.checked_nodes,
        entry_points: 1
    };
}

pub fn emit_selfhost_artifacts(
    allocator: Allocator,
    io: Io,
    root: []u8
) -> !IrArtifact {
    var files = try loader::load_selfhost_sources(allocator, io, root);
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    let checked = try ownership::check_package(allocator, files, typed);
    std::testing::expect_equal<i64>(0, checked.diagnostics);
    let artifact = try emit_checked_artifacts(allocator, io, files, checked);
    files.deinit();
    return artifact;
}

pub fn emit_checked_artifacts(
    allocator: Allocator,
    io: Io,
    files: &std::array::Array<source::SourceFile>,
    checked: &data::CheckedPackage
) -> !IrArtifact {
    let lowered = lower(checked);

    try ensure_selfhost_target(io);
    var text = try render_ir_artifact(allocator, files, lowered, checked);
    let text_view = text.as_bytes();
    let byte_len = try write_artifact_bytes(
        io,
        "target/selfhost/selfhost.ir",
        text_view,
        text.len()
    );
    text.deinit();

    var manifest = try render_shape_manifest(allocator);
    let manifest_view = manifest.as_bytes();
    let manifest_len = try write_artifact_bytes(
        io,
        "target/selfhost/selfhost.ir.manifest",
        manifest_view,
        manifest.len()
    );
    manifest.deinit();

    return IrArtifact {
        ir_path: "target/selfhost/selfhost.ir",
        manifest_path: "target/selfhost/selfhost.ir.manifest",
        bytes: byte_len,
        manifest_bytes: manifest_len
    };
}

pub fn handoff_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var files = try loader::load_selfhost_sources(allocator, io, "selfhost");
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    let checked = try ownership::check_package(allocator, files, typed);
    std::testing::expect_equal<i64>(0, checked.diagnostics);
    std::testing::expect(checked.resources > 0);
    let lowered = lower(checked);
    std::testing::expect(lowered.blocks > 0);
    std::testing::expect_equal<i64>(1, lowered.entry_points);

    print("ir-handoff-blocks");
    print(lowered.blocks);
    print("ir-handoff-entry-points");
    print(lowered.entry_points);
    print("ir-handoff-diagnostics");
    print(0);

    files.deinit();
    return;
}

fn ensure_selfhost_target(io: Io) -> !void {
    if !(try std::fs::exists(io, "target")) {
        try std::fs::create_dir(io, "target");
    }
    if !(try std::fs::exists(io, "target/selfhost")) {
        try std::fs::create_dir(io, "target/selfhost");
    }
    return;
}

fn write_artifact_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_ir_artifact(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    lowered: IrSummary,
    checked: &data::CheckedPackage
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-ir-v0");
    try append_line(out, "package selfhost");
    try out.append_bytes("module ");
    let module_path =
        checked.module.path[checked.module.module_start..checked.module.module_end];
    if std::mem::len(module_path) > 0 {
        try source::append_module_path_text(out, module_path);
    } else {
        try out.append_bytes(checked.entry_function.module);
    }
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry ");
    try out.append_bytes(checked.entry_function.module);
    try out.append_bytes("::");
    try out.append_bytes(checked.entry_function.name);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "ir-contract selfhost-checked-package-v1");
    try append_checked_entry_fact(out, checked);
    try append_line(out, "hosted-entry @kizu_selfhost__cli_main");
    try append_line(out, "hosted-smoke @kizu_selfhost__smoke");
    try executable_contract::append_facts(allocator, out, files);
    try append_key_i64(out, "checked-nodes ", checked.checked_nodes);
    try append_key_i64(out, "checked-resources ", checked.resources);
    try append_key_i64(out, "checked-borrows ", checked.borrows);
    try append_key_i64(out, "checked-diagnostics ", checked.diagnostics);
    if lowered.blocks > 0 {
        try append_line(out, "blocks present");
    }
    if lowered.entry_points == 1 {
        try append_line(out, "entry-points 1");
    }
    if checked.resources > 0 {
        try append_line(out, "resources present");
    }
    if checked.borrows > 0 {
        try append_line(out, "borrows present");
    }
    if checked.diagnostics == 0 {
        try append_line(out, "diagnostics 0");
    }
    return out;
}

fn append_checked_entry_fact(
    out: &var std::string::String,
    checked: &data::CheckedPackage
) -> !void {
    try out.append_bytes("checked-entry ");
    try out.append_bytes(checked.entry_function.module);
    try out.append_bytes("::");
    try out.append_bytes(checked.entry_function.name);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_key_i64(
    out: &var std::string::String,
    key: []u8,
    value: i64
) -> !void {
    try out.append_bytes(key);
    try std::fmt::append_i64(out, value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn render_shape_manifest(allocator: Allocator) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-ir-shape-v0");
    try append_line(out, "manifest-version selfhost-abi-v0");
    try append_line(out, "node-kind function");
    try append_line(out, "node-kind block");
    try append_line(out, "node-kind diagnostic");
    try append_line(out, "value-type i64");
    try append_line(out, "value-type bool");
    try append_line(out, "value-type []u8");
    try append_line(out, "value-type record");
    try append_line(out, "value-type error-union");
    try append_line(out, "value-type handle");
    try append_line(out, "storage local");
    try append_line(out, "storage owned-container");
    try append_line(out, "storage borrowed-view");
    try append_line(out, "storage arena");
    try append_line(out, "storage handle");
    try append_line(out, "call direct");
    try append_line(out, "call direct-record-roundtrip");
    try append_line(out, "call std-primitive");
    try append_line(out, "cleanup deinit");
    try append_line(out, "host-capabilities selfhost-host-v0");
    try append_line(out, "external std::mem::page_allocator");
    try append_line(out, "external std::fs::exists");
    try append_line(out, "external std::fs::metadata");
    try append_line(out, "external std::fs::read_dir");
    try append_line(out, "external std::fs::read_file");
    try append_line(out, "external std::fs::write_file");
    try append_line(out, "external std::fs::create_dir");
    try append_line(out, "external std::io::blocking");
    try append_line(out, "external std::io::write_stdout");
    try append_line(out, "external std::io::write_stderr");
    try append_line(out, "external std::process::arg_count");
    try append_line(out, "external std::process::arg");
    try append_line(out, "external std::process::env");
    try append_line(out, "external std::process::exit_code");
    try append_line(out, "manifest-complete selfhost-abi-v0");
    return out;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
