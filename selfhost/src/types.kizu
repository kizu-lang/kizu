        local_types,
        function_param_sources,
        function_returns
    );
    if value_found.found {
        return value_found;
    }
    return first_argument_type_mismatch_in_statement_range(
        allocator,
        file,
        ast,
        arms,
        local_types,
        function_param_sources,
        function_returns
    );
}

fn first_assignment_type_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !AssignmentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_assignment_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_assignment_type_mismatch_in_function(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.body,
            function_returns
        );,
        _ => return no_assignment_type_mismatch();,
    }
}

fn first_assignment_type_mismatch_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !AssignmentTypeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_assignment_type_mismatch_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_assignment_type_mismatch();
}

fn first_assignment_type_mismatch_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !AssignmentTypeSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    let locals = try collect_function_statement_locals(
        allocator,
        file,
        ast,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let found = try first_assignment_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        function_returns
    );
    local_types.deinit();
    local_mutability.deinit();
    return found;
}

fn first_assignment_type_mismatch_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !AssignmentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_assignment_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            function_returns
        );,
        Assign(assign_node) => return assignment_type_mismatch_for_assign(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            local_types,
            function_returns
        );,
        If(if_node) => return first_assignment_type_mismatch_in_two_statements(
            allocator,
            file,
            ast,
            if_node.then_block,
            if_node.else_block,
            local_types,
            function_returns
        );,
        While(while_node) => return first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            while_node.body,
            local_types,
            function_returns
        );,
        For(for_node) => return first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            for_node.body,
            local_types,
            function_returns
        );,
        Match(match_node) => return first_assignment_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            match_node.arms,
            local_types,
            function_returns
        );,
        MatchArm(match_arm) => return first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            function_returns
        );,
        Unsafe(unsafe_node) => return first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return first_assignment_type_mismatch_in_two_statements(
            allocator,
            file,
            ast,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types,
            function_returns
        );,
        _ => return no_assignment_type_mismatch();,
    }
}

fn first_assignment_type_mismatch_in_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !AssignmentTypeSummary {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        let found = try first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            child,
            local_types,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_assignment_type_mismatch();
}

fn first_assignment_type_mismatch_in_two_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !AssignmentTypeSummary {
    let first_found = try first_assignment_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        first,
        local_types,
        function_returns
    );
    if first_found.found {
        return first_found;
    }
    return first_assignment_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        second,
        local_types,
        function_returns
    );
}

fn assignment_type_mismatch_for_assign(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !AssignmentTypeSummary {
    let target_node = ast.get(target);
    match target_node.data {
        Var(var_node) => return assignment_type_mismatch_for_var_assign(
            allocator,
            file,
            ast,
            target,
            value,
            local_types,
            function_returns
        );,
        _ => return no_assignment_type_mismatch();,
    }
}

fn assignment_type_mismatch_for_var_assign(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !AssignmentTypeSummary {
    let name = ast_node_text(file, ast, target);
    if !local_types.contains(name) {
        return no_assignment_type_mismatch();
    }
    let expected = try local_types.get(name);
    let actual = try infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    if known_type_mismatch(expected, actual) {
        let value_node = ast.get(value);
        return assignment_type_summary(
            true,
            value_node.span.start,
            value_node.span.end,
            expected,
            actual
        );
    }
    return no_assignment_type_mismatch();
}

