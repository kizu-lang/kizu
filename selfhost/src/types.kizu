import selfhost::lexer;
import selfhost::resolver;
import selfhost::source;

pub enum TypeKind {
    Primitive,
    Function,
    Struct,
    Union,
    Enum,
    ErrorUnion,
    Optional,
    Container,
}

pub struct TypeSummary {
    pub modules: i64,
    pub symbols: i64,
    pub functions: i64,
    pub typed_nodes: i64,
    pub diagnostics: i64,
}

struct TypeScanSummary {
    next: i64,
    typed_nodes: i64,
    diagnostics: i64,
}

struct MatchArmScanSummary {
    explicit_count: i64,
    wildcard: bool,
    diagnostic_found: bool,
    diagnostic_kind: i64,
    diagnostic_name: []u8,
    diagnostic_tag: []u8,
}

pub struct FunctionCallSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub expected: i64,
    pub observed: i64,
}

pub struct TypeReferenceSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub expected: i64,
    pub observed: i64,
}

pub struct ReturnTypeSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
}

pub struct ArgumentTypeSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
}

pub struct AssignmentTypeSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
}

pub struct ImmutableAssignmentSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub name: []u8,
}

pub struct InvalidAssignmentTargetSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
}

pub struct UndefinedVariableSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub name: []u8,
}

pub struct MatchDiagnosticSummary {
    pub found: bool,
    pub kind: i64,
    pub name: []u8,
    pub tag: []u8,
}

pub struct FunctionSignature {
    pub params: i64,
    pub param_source: []u8,
    pub return_type: []u8,
    pub public: bool,
    pub span_start: i64,
    pub span_end: i64,
}

pub fn check(resolved: resolver::ResolveSummary) -> TypeSummary {
    return TypeSummary {
        modules: resolved.modules,
        symbols: resolved.symbols,
        functions: 0,
        typed_nodes: resolved.symbols,
        diagnostics: resolved.diagnostics
    };
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    resolved: resolver::ResolveSummary
) -> !TypeSummary {
    var kinds = std::map::Map<[]u8, TypeKind>(allocator);
    var arities = std::map::Map<[]u8, i64>(allocator);
    var copyable = std::map::Map<[]u8, bool>(allocator);
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var function_param_sources = std::map::Map<[]u8, []u8>(allocator);
    var function_returns = std::map::Map<[]u8, []u8>(allocator);
    var function_visibility = std::map::Map<[]u8, bool>(allocator);
    var function_span_starts = std::map::Map<[]u8, i64>(allocator);
    var function_span_ends = std::map::Map<[]u8, i64>(allocator);
    try seed_builtin_types(kinds, arities, copyable);

    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if source::is_source_code(file.kind) {
            var tokens = try lexer::tokenize(allocator, file.text);
            try collect_declared_types(allocator, file, tokens, kinds, arities, copyable);
            try collect_function_signatures(
                allocator,
                file,
                tokens,
                function_arities,
                function_param_sources,
                function_returns,
                function_visibility,
                function_span_starts,
                function_span_ends
            );
            tokens.deinit();
        }
        index = index + 1;
    }

    var typed_nodes = 0;
    var diagnostics = resolved.diagnostics;
    index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if source::is_source_code(file.kind) {
            var tokens = try lexer::tokenize(allocator, file.text);
            let scan = try check_file_type_references(allocator, file, tokens, kinds, arities);
            typed_nodes = typed_nodes + scan.typed_nodes;
            diagnostics = diagnostics + scan.diagnostics;
            if source::is_frontend_source(file.kind) {
                let call_scan = try check_file_function_references(
                    allocator,
                    file,
                    tokens,
                    function_arities
                );
                let body_scan = try check_file_body_ast(allocator, file, function_returns);
                typed_nodes = typed_nodes + call_scan.typed_nodes;
                diagnostics = diagnostics + call_scan.diagnostics;
                typed_nodes = typed_nodes + body_scan.typed_nodes;
                diagnostics = diagnostics + body_scan.diagnostics;
            }
            tokens.deinit();
        }
        index = index + 1;
    }

    let summary = TypeSummary {
        modules: resolved.modules,
        symbols: kinds.len(),
        functions: function_arities.len(),
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
    kinds.deinit();
    arities.deinit();
    copyable.deinit();
    function_arities.deinit();
    function_param_sources.deinit();
    function_returns.deinit();
    function_visibility.deinit();
    function_span_starts.deinit();
    function_span_ends.deinit();
    return summary;
}

pub fn first_function_call_error(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    source_text: []u8
) -> !FunctionCallSummary {
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var function_param_sources = std::map::Map<[]u8, []u8>(allocator);
    var function_returns = std::map::Map<[]u8, []u8>(allocator);
    var function_visibility = std::map::Map<[]u8, bool>(allocator);
    var function_span_starts = std::map::Map<[]u8, i64>(allocator);
    var function_span_ends = std::map::Map<[]u8, i64>(allocator);
    try collect_package_function_signatures(
        allocator,
        files,
        function_arities,
        function_param_sources,
        function_returns,
        function_visibility,
        function_span_starts,
        function_span_ends
    );
    let found = try first_function_call_error_reference(allocator, files, source_text, function_arities);
    function_arities.deinit();
    function_param_sources.deinit();
    function_returns.deinit();
    function_visibility.deinit();
    function_span_starts.deinit();
    function_span_ends.deinit();
    return found;
}

pub fn first_user_function_call_error(
    allocator: Allocator,
    path: []u8,
    text: []u8
) -> !FunctionCallSummary {
    let file = source::SourceFile {
        id: 0,
        kind: source::SourceKind::User,
        module: "main",
        path: path,
        text: text
    };
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var function_param_sources = std::map::Map<[]u8, []u8>(allocator);
    var function_returns = std::map::Map<[]u8, []u8>(allocator);
    var function_visibility = std::map::Map<[]u8, bool>(allocator);
    var function_span_starts = std::map::Map<[]u8, i64>(allocator);
    var function_span_ends = std::map::Map<[]u8, i64>(allocator);
    var tokens = try lexer::tokenize(allocator, text);
    try collect_function_signatures(
        allocator,
        &file,
        tokens,
        function_arities,
        function_param_sources,
        function_returns,
        function_visibility,
        function_span_starts,
        function_span_ends
    );
    let found = try source_local_function_call_error(allocator, &file, text, tokens, function_arities);
    tokens.deinit();
    function_arities.deinit();
    function_param_sources.deinit();
    function_returns.deinit();
    function_visibility.deinit();
    function_span_starts.deinit();
    function_span_ends.deinit();
    return found;
}

pub fn first_type_reference_error(
    allocator: Allocator,
    path: []u8,
    text: []u8
) -> !TypeReferenceSummary {
    let file = source::SourceFile {
        id: 0,
        kind: source::SourceKind::User,
        module: "main",
        path: path,
        text: text
    };
    var kinds = std::map::Map<[]u8, TypeKind>(allocator);
    var arities = std::map::Map<[]u8, i64>(allocator);
    var copyable = std::map::Map<[]u8, bool>(allocator);
    try seed_builtin_types(kinds, arities, copyable);
    var tokens = try lexer::tokenize(allocator, text);
    try collect_declared_types(allocator, &file, tokens, kinds, arities, copyable);
    try collect_type_parameters(&file, tokens, kinds, arities, copyable);
    let found = try first_type_error_in_file(allocator, &file, tokens, kinds, arities);
    tokens.deinit();
    kinds.deinit();
    arities.deinit();
    copyable.deinit();
    return found;
}

pub fn first_argument_type_mismatch(
    allocator: Allocator,
    path: []u8,
    text: []u8
) -> !ArgumentTypeSummary {
    let file = source::SourceFile {
        id: 0,
        kind: source::SourceKind::User,
        module: "main",
        path: path,
        text: text
    };
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var function_param_sources = std::map::Map<[]u8, []u8>(allocator);
    var local_function_param_sources = std::map::Map<[]u8, []u8>(allocator);
    var function_returns = std::map::Map<[]u8, []u8>(allocator);
    var function_visibility = std::map::Map<[]u8, bool>(allocator);
    var function_span_starts = std::map::Map<[]u8, i64>(allocator);
    var function_span_ends = std::map::Map<[]u8, i64>(allocator);
    var tokens = try lexer::tokenize(allocator, text);
    try collect_function_signatures(
        allocator,
        &file,
        tokens,
        function_arities,
        function_param_sources,
        function_returns,
        function_visibility,
        function_span_starts,
        function_span_ends
    );
    try collect_local_function_param_sources(&file, tokens, local_function_param_sources);
    tokens.deinit();

    let ast_source = std::kizu::ast::source_file(path, text);
    let result = try std::kizu::parser::parse_program(allocator, ast_source);
    let found = try first_argument_type_mismatch_node(
        allocator,
        &file,
        result.ast,
        result.root,
        local_function_param_sources,
        function_returns
    );
    result.deinit();
    function_arities.deinit();
    function_param_sources.deinit();
    local_function_param_sources.deinit();
    function_returns.deinit();
    function_visibility.deinit();
    function_span_starts.deinit();
    function_span_ends.deinit();
    return found;
}

