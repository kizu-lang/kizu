fn first_argument_type_mismatch_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_sources: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !ArgumentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_argument_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            function_param_sources,
            function_returns
        );,
        Let(let_node) => return first_argument_type_mismatch_in_expression(
            allocator,
