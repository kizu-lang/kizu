// Module: type checker boundary for the future self-host compiler.

import selfhost::lexer;
import selfhost::token;

pub enum TypeKind {
    Void
    Bool
    I64
    U8
    Bytes
    ErrorUnion
    User
    Unknown
}

pub struct TypeInfo {
    pub kind: TypeKind;
    pub name: []const u8;
    pub success_type: []const u8;
    pub is_copy: bool;
    pub is_error_union: bool;
}

// classify returns the type facts needed by early self-host checker stages.
pub fn classify(name: []const u8) -> !TypeInfo {
    if std::mem::equal_bytes(name, "void") {
        return primitive(TypeKind::Void, name, true);
    }
    if std::mem::equal_bytes(name, "bool") {
        return primitive(TypeKind::Bool, name, true);
    }
    if std::mem::equal_bytes(name, "i64") {
        return primitive(TypeKind::I64, name, true);
    }
    if std::mem::equal_bytes(name, "u8") {
        return primitive(TypeKind::U8, name, true);
    }
    if std::mem::equal_bytes(name, "[]const u8") {
        return primitive(TypeKind::Bytes, name, false);
    }
    if std::mem::starts_with(name, "!") {
        return TypeInfo {
            kind: TypeKind::ErrorUnion,
            name: name,
            success_type: try std::mem::slice(name, 1, std::mem::len(name)),
            is_copy: false,
            is_error_union: true,
        };
    }
    if try is_ident_start(name) {
        return primitive(TypeKind::User, name, false);
    }
    return primitive(TypeKind::Unknown, name, false);
}

// same reports exact type spelling equality.
pub fn same(left: &TypeInfo, right: &TypeInfo) -> bool {
    return std::mem::equal_bytes(left.name, right.name);
}

// can_copy reports whether a type can be copied by default.
pub fn can_copy(info: &TypeInfo) -> bool {
    return info.is_copy;
}

// print_type_snapshot writes selected function signature type facts.
pub fn print_type_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    var index = 0;

    print("selfhost type snapshot");
    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            try print_function_type(tokens, index);
        }
        index = index + 1;
    }
    print("selfhost type snapshot end");
    return void;
}

// print_type_env_snapshot writes selected local binding type facts.
pub fn print_type_env_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    var index = 0;

    print("selfhost type env snapshot");
    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Let {
            try print_local_type_binding(tokens, index, "let");
        }
        if current.kind == token::TokenKind::Var {
            try print_local_type_binding(tokens, index, "var");
        }
        index = index + 1;
    }
    print("selfhost type env snapshot end");
    return void;
}

// print_type_check_snapshot writes selected pass/fail type checker facts.
pub fn print_type_check_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    let message = try type_error_message(tokens);

    print("selfhost type check snapshot");
    if std::mem::equal_bytes(message, "") {
        print("status");
        print("pass");
    } else {
        print("status");
        print("fail");
        print("message");
        print(message);
    }
    print("selfhost type check snapshot end");
    return void;
}

// source_diagnostic returns the first selected type checker diagnostic.
pub fn source_diagnostic(source: []const u8) -> ![]const u8 {
    var tokens = try lexer::lex(source);
    return try type_error_message(tokens);
}

// print_function_type writes one function name and normalized return type.
fn print_function_type(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("fn");
    print(name.literal);
    print("return");
    print(try function_return_type(tokens, start + 2));
    return void;
}

// function_return_type returns the explicit return type or default void.
fn function_return_type(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return "void";
        }
        if current.kind == token::TokenKind::Arrow {
            return try normalized_type_name(tokens, index + 1);
        }
        index = index + 1;
    }
    return "void";
}

// print_local_type_binding writes one inferred local binding type.
fn print_local_type_binding(
    tokens: &std::array::Array<token::Token>,
    start: i64,
    mutability: []const u8
) -> !void {
    let name = try tokens.at(start + 1);
    let init = try local_initializer_index(tokens, start);
    if init >= 0 {
        print(mutability);
        print(name.literal);
        print(try infer_local_type(tokens, init));
    }
    return void;
}

// local_initializer_index returns the token index after a local assignment.
fn local_initializer_index(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Assign {
            return index + 1;
        }
        if current.kind == token::TokenKind::Semicolon {
            return -1;
        }
        index = index + 1;
    }
    return -1;
}

// infer_local_type returns the normalized type for selected local initializers.
fn infer_local_type(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let current = try tokens.at(start);
    if current.kind == token::TokenKind::String {
        return "[]const u8";
    }
    if current.kind == token::TokenKind::Number {
        return "i64";
    }
    if current.kind == token::TokenKind::True {
        return "bool";
    }
    if current.kind == token::TokenKind::False {
        return "bool";
    }
    if current.kind == token::TokenKind::Ident {
        let next = try tokens.at(start + 1);
        if next.kind == token::TokenKind::LBrace {
            return current.literal;
        }
    }
    return "unknown";
}

// normalized_type_name returns selected source-level type spellings.
fn normalized_type_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let current = try tokens.at(start);

    if current.kind == token::TokenKind::Bang {
        let next = try tokens.at(start + 1);
        if next.kind == token::TokenKind::LBracket {
            return "![]const u8";
        }
        if std::mem::equal_bytes(next.literal, "void") {
            return "!void";
        }
        if std::mem::equal_bytes(next.literal, "i64") {
            return "!i64";
        }
        return "!";
    }
    if current.kind == token::TokenKind::LBracket {
        return "[]const u8";
    }
    return current.literal;
}

// type_error_message returns selected type checker diagnostics.
fn type_error_message(tokens: &std::array::Array<token::Token>) -> ![]const u8 {
    if try has_missing_return_error(tokens) {
        return "type error: function `bad` must return i64";
    }
    if try has_equal_bytes_type_error(tokens) {
        return "type error: `std::mem::equal_bytes` arg 2 expects []const u8";
    }
    if try has_unknown_field_error(tokens) {
        return "type error: unknown field";
    }
    return "";
}

// has_missing_return_error detects non-void functions without a direct return.
fn has_missing_return_error(tokens: &std::array::Array<token::Token>) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            if try function_requires_value_return(tokens, index) {
                if !try function_has_direct_return(tokens, index) {
                    return true;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// function_requires_value_return reports whether a function has non-void output.
fn function_requires_value_return(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::Arrow {
            let typ = try tokens.at(index + 1);
            return !std::mem::equal_bytes(typ.literal, "void");
        }
        index = index + 1;
    }
    return false;
}

// function_has_direct_return reports whether the function body returns directly.
fn function_has_direct_return(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start;
    var depth = 0;
    var in_body = false;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            depth = depth + 1;
            in_body = true;
        } else {
            if current.kind == token::TokenKind::RBrace {
                depth = depth - 1;
                if in_body {
                    if depth == 0 {
                        return false;
                    }
                }
            } else {
                if current.kind == token::TokenKind::Return {
                    if depth == 1 {
                        return true;
                    }
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// has_equal_bytes_type_error detects a selected std::mem type mismatch.
fn has_equal_bytes_type_error(tokens: &std::array::Array<token::Token>) -> !bool {
    var index = 0;

    while index + 8 < tokens.len() {
        let current = try tokens.at(index);
        let callee = try tokens.at(index + 4);
        if current.kind == token::TokenKind::Ident {
            if std::mem::equal_bytes(callee.literal, "equal_bytes") {
                if try call_second_arg_is_number(tokens, index + 5) {
                    return true;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// call_second_arg_is_number checks the selected two-argument call shape.
fn call_second_arg_is_number(tokens: &std::array::Array<token::Token>, lparen: i64) -> !bool {
    var index = lparen;
    var seen_comma = false;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::RParen {
            return false;
        }
        if seen_comma {
            return current.kind == token::TokenKind::Number;
        }
        if current.kind == token::TokenKind::Comma {
            seen_comma = true;
        }
        index = index + 1;
    }
    return false;
}

// has_unknown_field_error detects the selected invalid field fixture.
fn has_unknown_field_error(tokens: &std::array::Array<token::Token>) -> !bool {
    if try struct_has_field(tokens, "age") {
        return false;
    }
    var index = 0;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        let next = try tokens.at(index + 1);
        if current.kind == token::TokenKind::Dot {
            if std::mem::equal_bytes(next.literal, "age") {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// struct_has_field reports whether a selected field appears in a struct body.
fn struct_has_field(tokens: &std::array::Array<token::Token>, name: []const u8) -> !bool {
    var index = 0;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        let next = try tokens.at(index + 1);
        if current.kind == token::TokenKind::Ident {
            if std::mem::equal_bytes(current.literal, name) {
                if next.kind == token::TokenKind::Colon {
                    return true;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// primitive constructs a non-error type summary.
fn primitive(kind: TypeKind, name: []const u8, is_copy: bool) -> TypeInfo {
    return TypeInfo {
        kind: kind,
        name: name,
        success_type: "",
        is_copy: is_copy,
        is_error_union: false,
    };
}

// is_ident_start accepts the first byte shape for a user type spelling.
fn is_ident_start(name: []const u8) -> !bool {
    if std::mem::len(name) == 0 {
        return false;
    }
    let first = try std::mem::byte_at(name, 0);
    if first >= cast<u8>(65) {
        if first <= cast<u8>(90) {
            return true;
        }
    }
    if first >= cast<u8>(97) {
        return first <= cast<u8>(122);
    }
    return first == cast<u8>(95);
}

// ready exposes the type module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
