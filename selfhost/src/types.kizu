import selfhost::diagnostic;
import selfhost::resolver;
import selfhost::source;
import selfhost::types::checker;
import selfhost::types::expression_facts;
import selfhost::types::model;
import selfhost::types::reports;

pub fn check(resolved: resolver::ResolveSummary) -> model::TypeSummary {
    return checker::check(resolved);
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    resolved: resolver::ResolveSummary
) -> !model::TypeSummary {
    return checker::check_sources(allocator, files, resolved);
}

pub fn check_parsed_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed_sources: &std::array::Array<std::kizu::ast::ParseResult>,
    parsed_source_indexes: &std::array::Array<i64>,
    resolved: resolver::ResolveSummary
) -> !model::TypeSummary {
    return checker::check_parsed_sources(
        allocator,
        files,
        parsed_sources,
        parsed_source_indexes,
        resolved
    );
}

pub fn first_package_function_call_error_ast_node(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !model::FunctionCallSummary {
    return checker::first_package_function_call_error_ast_node(
        allocator,
        files,
        file,
        ast,
        root
    );
}

pub fn function_call_diagnostic(
    allocator: Allocator,
    path: []u8,
    file_text: []u8,
    call_error: model::FunctionCallSummary
) -> !diagnostic::Report {
    return reports::from_function_call_summary(allocator, path, file_text, call_error);
}

pub fn first_pre_move_check_diagnostic_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !diagnostic::Report {
    return try checker::first_pre_move_check_diagnostic_ast_node(
        allocator,
        file,
        ast,
        root
    );
}

pub fn first_pre_move_check_diagnostic_ast_node_with_types(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !diagnostic::Report {
    return try checker::first_pre_move_check_diagnostic_ast_node_with_types(
        allocator,
        file,
        ast,
        root,
        kinds,
        arities,
        copyable
    );
}

pub fn first_pre_move_check_diagnostic_ast_node_with_facts(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !diagnostic::Report {
    return try checker::first_pre_move_check_diagnostic_ast_node_with_facts(
        allocator,
        file,
        ast,
        root,
        kinds,
        arities,
        copyable,
        expression_types
    );
}

pub fn first_post_move_check_diagnostic_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !diagnostic::Report {
    return try checker::first_post_move_check_diagnostic_ast_node(
        allocator,
        file,
        ast,
        root
    );
}

pub fn first_post_move_check_diagnostic_ast_node_with_facts(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !diagnostic::Report {
    return try checker::first_post_move_check_diagnostic_ast_node_with_facts(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
}

pub fn collect_struct_resolution_facts_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try checker::collect_struct_resolution_facts_from_ast(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    return;
}

pub fn collect_nominal_resolution_facts_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try checker::collect_nominal_resolution_facts_from_ast(
        allocator, file, ast, root, expression_types
    );
    return;
}

pub fn collect_struct_field_resolution_facts_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try checker::collect_struct_field_resolution_facts_from_ast(
        allocator, file, ast, root, expression_types
    );
    return;
}
