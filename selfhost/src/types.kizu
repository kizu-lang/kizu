import selfhost::lexer;
import selfhost::resolver;
import selfhost::source;

pub enum TypeKind {
    Primitive,
    Function,
    Struct,
    Union,
    Enum,
    ErrorUnion,
    Optional,
    Container,
}

pub struct TypeSummary {
    pub modules: i64,
    pub symbols: i64,
    pub functions: i64,
    pub typed_nodes: i64,
    pub diagnostics: i64,
}

struct TypeScanSummary {
    next: i64,
    typed_nodes: i64,
    diagnostics: i64,
}

pub struct FunctionSignature {
    pub params: i64,
    pub param_source: []const u8,
    pub return_type: []const u8,
    pub public: bool,
    pub span_start: i64,
    pub span_end: i64,
}

pub fn check(resolved: resolver::ResolveSummary) -> TypeSummary {
    return TypeSummary {
        modules: resolved.modules,
        symbols: resolved.symbols,
        functions: 0,
        typed_nodes: resolved.symbols,
        diagnostics: resolved.diagnostics
    };
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    resolved: resolver::ResolveSummary
) -> !TypeSummary {
    var kinds = std::map::Map<[]const u8, TypeKind>(allocator);
    var arities = std::map::Map<[]const u8, i64>(allocator);
    var copyable = std::map::Map<[]const u8, bool>(allocator);
    var function_arities = std::map::Map<[]const u8, i64>(allocator);
    var function_param_sources = std::map::Map<[]const u8, []const u8>(allocator);
    var function_returns = std::map::Map<[]const u8, []const u8>(allocator);
    var function_visibility = std::map::Map<[]const u8, bool>(allocator);
    var function_span_starts = std::map::Map<[]const u8, i64>(allocator);
    var function_span_ends = std::map::Map<[]const u8, i64>(allocator);
    try seed_builtin_types(kinds, arities, copyable);

    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind != source::SourceKind::User {
            var tokens = try lexer::tokenize(allocator, file.text);
            try collect_declared_types(allocator, file, tokens, kinds, arities, copyable);
            try collect_function_signatures(
                allocator,
                file,
                tokens,
                function_arities,
                function_param_sources,
                function_returns,
                function_visibility,
                function_span_starts,
                function_span_ends
            );
            tokens.deinit();
        }
        index = index + 1;
    }

    var typed_nodes = 0;
    var diagnostics = resolved.diagnostics;
    index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind != source::SourceKind::User {
            var tokens = try lexer::tokenize(allocator, file.text);
            let scan = try check_file_type_references(allocator, file, tokens, kinds, arities);
            typed_nodes = typed_nodes + scan.typed_nodes;
            diagnostics = diagnostics + scan.diagnostics;
            if file.kind == source::SourceKind::Selfhost {
                let call_scan = try check_file_function_references(
                    allocator,
                    file,
                    tokens,
                    function_arities
                );
                let body_scan = try check_file_body_ast(allocator, file, function_returns);
                typed_nodes = typed_nodes + call_scan.typed_nodes;
                diagnostics = diagnostics + call_scan.diagnostics;
                typed_nodes = typed_nodes + body_scan.typed_nodes;
                diagnostics = diagnostics + body_scan.diagnostics;
            }
            tokens.deinit();
        }
        index = index + 1;
    }

    let summary = TypeSummary {
        modules: resolved.modules,
        symbols: kinds.len(),
        functions: function_arities.len(),
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
    kinds.deinit();
    arities.deinit();
    copyable.deinit();
    function_arities.deinit();
    function_param_sources.deinit();
    function_returns.deinit();
    function_visibility.deinit();
    function_span_starts.deinit();
    function_span_ends.deinit();
    return summary;
}

pub fn declare_type(
    kinds: &mut std::map::Map<[]const u8, TypeKind>,
    arities: &mut std::map::Map<[]const u8, i64>,
    copyable: &mut std::map::Map<[]const u8, bool>,
    name: []const u8,
    kind: TypeKind,
    arity: i64,
    copy: bool
) -> !void {
    if kinds.contains(name) {
        return error("duplicate type");
    }
    try kinds.insert(name, kind);
    try arities.insert(name, arity);
    try copyable.insert(name, copy);
    return;
}

pub fn lookup_kind(
    kinds: &std::map::Map<[]const u8, TypeKind>,
    name: []const u8
) -> !TypeKind {
    return kinds.get(name);
}

pub fn arity_of(
    arities: &std::map::Map<[]const u8, i64>,
    name: []const u8
) -> !i64 {
    return arities.get(name);
}

pub fn is_copyable(
    copyable: &std::map::Map<[]const u8, bool>,
    name: []const u8
) -> !bool {
    return copyable.get(name);
}

pub fn declare_function(
    arities: &mut std::map::Map<[]const u8, i64>,
    param_sources: &mut std::map::Map<[]const u8, []const u8>,
    returns: &mut std::map::Map<[]const u8, []const u8>,
    visibility: &mut std::map::Map<[]const u8, bool>,
    span_starts: &mut std::map::Map<[]const u8, i64>,
    span_ends: &mut std::map::Map<[]const u8, i64>,
    name: []const u8,
    signature: FunctionSignature
) -> !void {
    if arities.contains(name) {
        return error("duplicate function");
    }
    try arities.insert(name, signature.params);
    try param_sources.insert(name, signature.param_source);
    try returns.insert(name, signature.return_type);
    try visibility.insert(name, signature.public);
    try span_starts.insert(name, signature.span_start);
    try span_ends.insert(name, signature.span_end);
    return;
}

pub fn lookup_function(
    arities: &std::map::Map<[]const u8, i64>,
    param_sources: &std::map::Map<[]const u8, []const u8>,
    returns: &std::map::Map<[]const u8, []const u8>,
    visibility: &std::map::Map<[]const u8, bool>,
    span_starts: &std::map::Map<[]const u8, i64>,
    span_ends: &std::map::Map<[]const u8, i64>,
    name: []const u8
) -> !FunctionSignature {
    return FunctionSignature {
        params: try arities.get(name),
        param_source: try param_sources.get(name),
        return_type: try returns.get(name),
        public: try visibility.get(name),
        span_start: try span_starts.get(name),
        span_end: try span_ends.get(name)
    };
}

pub fn summarize(
    kinds: &std::map::Map<[]const u8, TypeKind>,
    diagnostics: i64
) -> TypeSummary {
    return TypeSummary {
        modules: 1,
        symbols: kinds.len(),
        functions: 0,
        typed_nodes: kinds.len(),
        diagnostics: diagnostics
    };
}

fn seed_builtin_types(
    kinds: &mut std::map::Map<[]const u8, TypeKind>,
    arities: &mut std::map::Map<[]const u8, i64>,
    copyable: &mut std::map::Map<[]const u8, bool>
) -> !void {
    try kinds.insert("void", TypeKind::Primitive);
    try arities.insert("void", 0);
    try copyable.insert("void", true);
    try kinds.insert("bool", TypeKind::Primitive);
    try arities.insert("bool", 0);
    try copyable.insert("bool", true);
    try kinds.insert("i64", TypeKind::Primitive);
    try arities.insert("i64", 0);
    try copyable.insert("i64", true);
    try kinds.insert("u8", TypeKind::Primitive);
    try arities.insert("u8", 0);
    try copyable.insert("u8", true);
    try kinds.insert("Allocator", TypeKind::Primitive);
    try arities.insert("Allocator", 0);
    try copyable.insert("Allocator", true);
    try kinds.insert("Io", TypeKind::Primitive);
    try arities.insert("Io", 0);
    try copyable.insert("Io", true);
    try kinds.insert("Function", TypeKind::Primitive);
    try arities.insert("Function", 0);
    try copyable.insert("Function", true);
    try kinds.insert("std::arena::Arena", TypeKind::Container);
    try arities.insert("std::arena::Arena", 1);
    try copyable.insert("std::arena::Arena", false);
    try kinds.insert("std::arena::Handle", TypeKind::Container);
    try arities.insert("std::arena::Handle", 1);
    try copyable.insert("std::arena::Handle", true);
    try kinds.insert("std::array::Array", TypeKind::Container);
    try arities.insert("std::array::Array", 1);
    try copyable.insert("std::array::Array", false);
    try kinds.insert("std::map::Map", TypeKind::Container);
    try arities.insert("std::map::Map", 2);
    try copyable.insert("std::map::Map", false);
    try kinds.insert("std::mem::Box", TypeKind::Container);
    try arities.insert("std::mem::Box", 1);
    try copyable.insert("std::mem::Box", false);
    try kinds.insert("std::fs::Metadata", TypeKind::Struct);
    try arities.insert("std::fs::Metadata", 0);
    try copyable.insert("std::fs::Metadata", true);
    return;
}

fn collect_declared_types(
    allocator: Allocator,
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    kinds: &mut std::map::Map<[]const u8, TypeKind>,
    arities: &mut std::map::Map<[]const u8, i64>,
    copyable: &mut std::map::Map<[]const u8, bool>
) -> !void {
    var index = 0;
    var depth = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        let text = token_text(file.text, token);
        var handled = false;
        if std::mem::equal_bytes(text, "{") {
            depth = depth + 1;
            handled = true;
        }
        if !handled and std::mem::equal_bytes(text, "}") {
            depth = depth - 1;
            handled = true;
        }
        if !handled and depth == 0 and is_type_declaration(text) {
            if index + 1 < tokens.len() {
                let name = try tokens.get(index + 1);
                let name_text = token_text(file.text, name);
                var qualified = std::string::String(allocator);
                try append_module_name(qualified, file);
                try qualified.append_bytes("::");
                try qualified.append_bytes(name_text);
                let type_name = qualified.as_bytes();
                try kinds.insert(type_name, type_kind(text));
                try arities.insert(type_name, try type_decl_arity(file.text, tokens, index + 2));
                try copyable.insert(type_name, type_decl_copyable(text));
                qualified.deinit();
            }
        }
        index = index + 1;
    }
    return;
}

fn collect_function_signatures(
    allocator: Allocator,
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    arities: &mut std::map::Map<[]const u8, i64>,
    param_sources: &mut std::map::Map<[]const u8, []const u8>,
    returns: &mut std::map::Map<[]const u8, []const u8>,
    visibility: &mut std::map::Map<[]const u8, bool>,
    span_starts: &mut std::map::Map<[]const u8, i64>,
    span_ends: &mut std::map::Map<[]const u8, i64>
) -> !void {
    var index = 0;
    var depth = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        let text = token_text(file.text, token);
        var handled = false;
        if std::mem::equal_bytes(text, "{") {
            depth = depth + 1;
            handled = true;
        }
        if !handled and std::mem::equal_bytes(text, "}") {
            depth = depth - 1;
            handled = true;
        }
        if !handled and depth == 0 and std::mem::equal_bytes(text, "fn") {
            if index + 1 < tokens.len() {
                let name = try tokens.get(index + 1);
                let name_text = token_text(file.text, name);
                let open = try function_param_open(file.text, tokens, index);
                let close = try function_param_close(file.text, tokens, open);
                let params = try count_function_params(file.text, tokens, open, close);
                let param_source = try function_param_source(file.text, tokens, open, close);
                let return_type = try function_return_type(file.text, tokens, close + 1);
                var qualified = std::string::String(allocator);
                try append_module_name(qualified, file);
                try qualified.append_bytes("::");
                try qualified.append_bytes(name_text);
                let function_name = qualified.as_bytes();
                if arities.contains(function_name) {
                    return error("duplicate function");
                }
                try arities.insert(function_name, params);
                try param_sources.insert(function_name, param_source);
                try returns.insert(function_name, return_type);
                try visibility.insert(function_name, try function_public_at(file.text, tokens, index));
                try span_starts.insert(function_name, name.start);
                try span_ends.insert(function_name, name.end);
                qualified.deinit();
            }
        }
        index = index + 1;
    }
    return;
}

fn function_param_open(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    fn_index: i64
) -> !i64 {
    var cursor = fn_index + 2;
    if cursor >= tokens.len() {
        return cursor;
    }
    let token = try tokens.get(cursor);
    if std::mem::equal_bytes(token_text(source_text, token), "<") {
        return skip_balanced_angle(source_text, tokens, cursor);
    }
    return cursor;
}

fn skip_balanced_angle(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !i64 {
    var depth = 0;
    var cursor = open_index;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        let text = token_text(source_text, token);
        if std::mem::equal_bytes(text, "<") {
            depth = depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                depth = depth - 1;
                if depth == 0 {
                    return cursor + 1;
                }
            }
        }
        cursor = cursor + 1;
    }
    return cursor;
}

fn function_param_close(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !i64 {
    var depth = 0;
    var cursor = open_index;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        let text = token_text(source_text, token);
        if std::mem::equal_bytes(text, "(") {
            depth = depth + 1;
        } else {
            if std::mem::equal_bytes(text, ")") {
                depth = depth - 1;
                if depth == 0 {
                    return cursor;
                }
            }
        }
        cursor = cursor + 1;
    }
    return cursor;
}

fn function_param_source(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64,
    close_index: i64
) -> ![]const u8 {
    if open_index + 1 >= close_index {
        return "";
    }
    let start = try tokens.get(open_index + 1);
    let end = try tokens.get(close_index - 1);
    return std::mem::trim_ascii(source_text[start.start..end.end]);
}

fn count_function_params(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64,
    close_index: i64
) -> !i64 {
    if open_index + 1 >= close_index {
        return 0;
    }
    var count = 1;
    var angle_depth = 0;
    var paren_depth = 0;
    var bracket_depth = 0;
    var brace_depth = 0;
    var cursor = open_index + 1;
    while cursor < close_index {
        let token = try tokens.get(cursor);
        let text = token_text(source_text, token);
        if std::mem::equal_bytes(text, "<") {
            angle_depth = angle_depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                angle_depth = angle_depth - 1;
            } else {
                if std::mem::equal_bytes(text, "(") {
                    paren_depth = paren_depth + 1;
                } else {
                    if std::mem::equal_bytes(text, ")") {
                        paren_depth = paren_depth - 1;
                    } else {
                        if std::mem::equal_bytes(text, "[") {
                            bracket_depth = bracket_depth + 1;
                        } else {
                            if std::mem::equal_bytes(text, "]") {
                                bracket_depth = bracket_depth - 1;
                            } else {
                                if std::mem::equal_bytes(text, "{") {
                                    brace_depth = brace_depth + 1;
                                } else {
                                    if std::mem::equal_bytes(text, "}") {
                                        brace_depth = brace_depth - 1;
                                    }
                                }
                            }
                        }
                    }
                }
                if angle_depth == 0 and
                    paren_depth == 0 and
                    bracket_depth == 0 and
                    brace_depth == 0 and
                    std::mem::equal_bytes(text, ",") {
                    count = count + 1;
                }
            }
        }
        cursor = cursor + 1;
    }
    return count;
}

fn function_return_type(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> ![]const u8 {
    if index >= tokens.len() {
        return "void";
    }
    let token = try tokens.get(index);
    if !std::mem::equal_bytes(token_text(source_text, token), "->") {
        return "void";
    }
    let start_token = try tokens.get(index + 1);
    let end = try function_return_type_end(source_text, tokens, index + 1);
    if end <= index {
        return "void";
    }
    let end_token = try tokens.get(end);
    return std::mem::trim_ascii(source_text[start_token.start..end_token.end]);
}

fn function_return_type_end(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    start: i64
) -> !i64 {
    var cursor = start;
    var end = start;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        let text = token_text(source_text, token);
        if std::mem::equal_bytes(text, "{") or std::mem::equal_bytes(text, ";") {
            return end;
        }
        end = cursor;
        cursor = cursor + 1;
    }
    return end;
}

fn function_public_at(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    if index > 0 and try token_at_equals(source_text, tokens, index - 1, "pub") {
        return true;
    }
    if index > 1 and try token_at_equals(source_text, tokens, index - 2, "pub") {
        return true;
    }
    if index > 2 and try token_at_equals(source_text, tokens, index - 3, "pub") {
        return true;
    }
    return false;
}

fn token_at_equals(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    expected: []const u8
) -> !bool {
    let token = try tokens.get(index);
    return std::mem::equal_bytes(token_text(source_text, token), expected);
}

fn check_file_type_references(
    allocator: Allocator,
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    kinds: &std::map::Map<[]const u8, TypeKind>,
    arities: &std::map::Map<[]const u8, i64>
) -> !TypeScanSummary {
    var typed_nodes = 0;
    var diagnostics = 0;
    var index = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        let text = token_text(file.text, token);
        var handled = false;
        if std::mem::equal_bytes(text, "->") or
            (std::mem::equal_bytes(text, ":") and try is_type_annotation_colon(file.text, tokens, index)) {
            let scan = try scan_type_range(
                allocator,
                file,
                tokens,
                "",
                index + 1,
                kinds,
                arities
            );
            typed_nodes = typed_nodes + scan.typed_nodes;
            diagnostics = diagnostics + scan.diagnostics;
            index = scan.next;
            handled = true;
        }
        if !handled and try is_cast_type_start(file.text, tokens, index) {
            let scan = try scan_type_arguments(
                allocator,
                file,
                tokens,
                "",
                index + 2,
                kinds,
                arities
            );
            typed_nodes = typed_nodes + scan.typed_nodes;
            diagnostics = diagnostics + scan.diagnostics;
            index = scan.next;
            handled = true;
        }
        if !handled {
            let path_end = try qualified_path_end(file.text, tokens, index);
            if path_end >= index and try is_generic_constructor_at(file.text, tokens, index, path_end) {
                let scan = try scan_type_arguments(
                    allocator,
                    file,
                    tokens,
                    "",
                    path_end + 2,
                    kinds,
                    arities
                );
                typed_nodes = typed_nodes + scan.typed_nodes;
                diagnostics = diagnostics + scan.diagnostics;
                index = scan.next;
                handled = true;
            }
        }
        if !handled {
            index = index + 1;
        }
    }
    return TypeScanSummary {
        next: index,
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
}

fn check_file_function_references(
    allocator: Allocator,
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    functions: &std::map::Map<[]const u8, i64>
) -> !TypeScanSummary {
    var index = 0;
    var typed_nodes = 0;
    var diagnostics = 0;
    while index < tokens.len() {
        let path_end = try qualified_path_end(file.text, tokens, index);
        if path_end >= index and try is_function_call_at(file.text, tokens, index, path_end) {
            let checked = try check_function_call_at(allocator, file, tokens, functions, index, path_end);
            typed_nodes = typed_nodes + checked.typed_nodes;
            diagnostics = diagnostics + checked.diagnostics;
            index = checked.next;
        } else {
            index = index + 1;
        }
    }
    return type_scan_summary(index, typed_nodes, diagnostics);
}

fn check_function_call_at(
    allocator: Allocator,
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    functions: &std::map::Map<[]const u8, i64>,
    start: i64,
    end: i64
) -> !TypeScanSummary {
    let first = try tokens.get(start);
    let last = try tokens.get(end);
    let name = file.text[first.start..last.end];
    let close = try function_param_close(file.text, tokens, end + 1);
    if should_skip_function_reference(name) {
        return type_scan_summary(close + 1, 0, 0);
    }
    var resolved = std::string::String(allocator);
    try append_resolved_function_name(resolved, file, name);
    let key = resolved.as_bytes();
    var diagnostics = 0;
    if functions.contains(key) {
        let expected = try functions.get(key);
        let observed = try count_function_params(file.text, tokens, end + 1, close);
        if expected != observed {
            diagnostics = 1;
        }
    } else {
        if !last_segment_starts_with_uppercase(name) {
            diagnostics = 1;
        }
    }
    resolved.deinit();
    return type_scan_summary(close + 1, 1, diagnostics);
}

fn is_function_call_at(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    start: i64,
    end: i64
) -> !bool {
    if start > 0 and try token_at_equals(source_text, tokens, start - 1, ".") {
        return false;
    }
    if start > 0 and try token_at_equals(source_text, tokens, start - 1, "::") {
        return false;
    }
    if end + 1 >= tokens.len() {
        return false;
    }
    return try token_at_equals(source_text, tokens, end + 1, "(");
}

fn should_skip_function_reference(name: []const u8) -> bool {
    return std::mem::equal_bytes(name, "print") or
        std::mem::equal_bytes(name, "error") or
        std::mem::equal_bytes(name, "cast") or
        std::mem::equal_bytes(name, "return") or
        std::mem::equal_bytes(name, "or") or
        std::mem::equal_bytes(name, "and") or
        std::mem::equal_bytes(name, "if") or
        std::mem::equal_bytes(name, "while") or
        std::mem::equal_bytes(name, "for") or
        std::mem::equal_bytes(name, "match");
}

fn append_resolved_function_name(
    out: &mut std::string::String,
    file: &source::SourceFile,
    name: []const u8
) -> !void {
    if std::mem::starts_with(name, "std::") or std::mem::starts_with(name, "selfhost::") {
        try out.append_bytes(name);
        return;
    }
    if is_qualified_name(name) {
        try out.append_bytes("selfhost::");
        try out.append_bytes(name);
        return;
    }
    if file.kind == source::SourceKind::Std {
        try out.append_bytes("std::");
    } else {
        try out.append_bytes("selfhost::");
    }
    try out.append_bytes(file.module);
    try out.append_bytes("::");
    try out.append_bytes(name);
    return;
}

fn last_segment_starts_with_uppercase(name: []const u8) -> bool {
    var start = 0;
    var index = 0;
    while index + 1 < std::mem::len(name) {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            start = index + 2;
        }
        index = index + 1;
    }
    if start >= std::mem::len(name) {
        return false;
    }
    let byte = name[start];
    return byte >= cast<u8>(65) and byte <= cast<u8>(90);
}

fn check_file_body_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let ast_source = std::kizu::ast::source_file(file.path, file.text);
    let result = try std::kizu::parser::parse_program(allocator, ast_source);
    let traversal = try scan_body_ast_node(result.ast, result.root);
    let statements = try check_ast_statements(
        allocator,
        file,
        result.ast,
        result.root,
        function_returns
    );
    let summary = merge_type_summaries(traversal, statements);
    result.deinit();
    return summary;
}

fn scan_body_ast_node(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !TypeScanSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return scan_body_range_node(ast, program.declarations);,
        ImportDecl(import_decl) => return scan_body_range_node(ast, import_decl.path);,
        StructDecl(struct_decl) => return scan_body_struct_decl(
            ast,
            struct_decl.name,
            struct_decl.type_params,
            struct_decl.fields
        );,
        EnumDecl(enum_decl) => return scan_body_name_range_node(ast, enum_decl.name, enum_decl.tags);,
        UnionDecl(union_decl) => return scan_body_union_decl(
            ast,
            union_decl.name,
            union_decl.type_params,
            union_decl.variants
        );,
        UnionVariant(union_variant) => return scan_body_two_child_node(
            ast,
            union_variant.name,
            union_variant.payload
        );,
        FnDecl(fn_decl) => return scan_body_fn_decl(
            ast,
            fn_decl.extern_abi,
            fn_decl.name,
            fn_decl.type_params,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body
        );,
        Param(param_node) => return scan_body_two_child_node(ast, param_node.name, param_node.type_node);,
        Field(field_node) => return scan_body_two_child_node(ast, field_node.name, field_node.type_node);,
        Block(block) => return scan_body_range_node(ast, block.statements);,
        Let(let_node) => return scan_body_two_child_node(ast, let_node.name, let_node.value);,
        Assign(assign_node) => return scan_body_two_child_node(ast, assign_node.target, assign_node.value);,
        Return(return_node) => return scan_body_one_child_node(ast, return_node.value);,
        Defer(defer_node) => return scan_body_one_child_node(ast, defer_node.expr);,
        ExprStmt(expr_stmt) => return scan_body_one_child_node(ast, expr_stmt.expr);,
        If(if_node) => return scan_body_three_child_node(
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block
        );,
        While(while_node) => return scan_body_three_child_node(
            ast,
            while_node.label,
            while_node.condition,
            while_node.body
        );,
        For(for_node) => return scan_body_five_child_node(
            ast,
            for_node.label,
            for_node.name,
            for_node.start,
            for_node.end,
            for_node.body
        );,
        Break(break_node) => return scan_body_one_child_node(ast, break_node.label);,
        Continue(continue_node) => return scan_body_one_child_node(ast, continue_node.label);,
        Match(match_node) => return scan_body_child_range_node(ast, match_node.value, match_node.arms);,
        MatchArm(match_arm) => return scan_body_three_child_node(
            ast,
            match_arm.pattern,
            match_arm.binding,
            match_arm.body
        );,
        Unsafe(unsafe_node) => return scan_body_one_child_node(ast, unsafe_node.body);,
        ComptimeIf(comptime_if_node) => return scan_body_three_child_node(
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block
        );,
        Prefix(prefix_node) => return scan_body_one_child_node(ast, prefix_node.right);,
        Binary(binary) => return scan_body_two_child_node(ast, binary.left, binary.right);,
        FieldExpr(field_expr_node) => return scan_body_two_child_node(
            ast,
            field_expr_node.receiver,
            field_expr_node.name
        );,
        DerefExpr(deref_expr_node) => return scan_body_one_child_node(ast, deref_expr_node.receiver);,
        Call(call_node) => return scan_body_child_range_node(ast, call_node.callee, call_node.args);,
        TypeApplyExpr(type_apply) => return scan_body_child_range_node(
            ast,
            type_apply.callee,
            type_apply.type_args
        );,
        CastExpr(cast_expr) => return scan_body_two_child_node(
            ast,
            cast_expr.type_node,
            cast_expr.value
        );,
        IndexExpr(index_expr) => return scan_body_three_child_node(
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end
        );,
        StructLiteralExpr(struct_literal) => return scan_body_child_range_node(
            ast,
            struct_literal.type_name,
            struct_literal.fields
        );,
        StructFieldInit(struct_field_init) => return scan_body_two_child_node(
            ast,
            struct_field_init.name,
            struct_field_init.value
        );,
        ArenaNewExpr(arena_new) => return scan_body_two_child_node(
            ast,
            arena_new.type_node,
            arena_new.allocator
        );,
        TryExpr(try_expr_node) => return scan_body_one_child_node(ast, try_expr_node.value);,
        ComptimeExpr(comptime_expr_node) => return scan_body_one_child_node(
            ast,
            comptime_expr_node.value
        );,
        TypeName(type_name) => return body_node_summary();,
        Var(var_node) => return body_node_summary();,
        Int(int_node) => return body_node_summary();,
        String(string_node) => return body_node_summary();,
        Bool(bool_node) => return body_node_summary();,
        Empty => return body_node_summary();,
    }
}

fn scan_body_struct_decl(
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    fields: std::kizu::ast::ChildRange
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, name));
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, type_params));
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, fields));
    return summary;
}

fn scan_body_union_decl(
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    variants: std::kizu::ast::ChildRange
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, name));
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, type_params));
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, variants));
    return summary;
}

fn scan_body_fn_decl(
    ast: std::kizu::ast::Ast,
    extern_abi: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, extern_abi));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, name));
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, type_params));
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, params));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, return_type));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, body));
    return summary;
}

fn scan_body_name_range_node(
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, name));
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, range));
    return summary;
}

fn scan_body_range_node(
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, range));
    return summary;
}

fn scan_body_child_range_node(
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, child));
    summary = merge_type_summaries(summary, try scan_body_child_range(ast, range));
    return summary;
}

fn scan_body_one_child_node(
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, child));
    return summary;
}

fn scan_body_two_child_node(
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, first));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, second));
    return summary;
}

fn scan_body_three_child_node(
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, first));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, second));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, third));
    return summary;
}

fn scan_body_five_child_node(
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    fourth: std::kizu::ast::NodeId,
    fifth: std::kizu::ast::NodeId
) -> !TypeScanSummary {
    var summary = body_node_summary();
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, first));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, second));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, third));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, fourth));
    summary = merge_type_summaries(summary, try scan_body_ast_node(ast, fifth));
    return summary;
}

fn scan_body_child_range(
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !TypeScanSummary {
    var summary = type_scan_summary(range.start + range.len, 0, 0);
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        summary = merge_type_summaries(summary, try scan_body_ast_node(ast, child));
        index = index + 1;
    }
    return summary;
}

fn body_node_summary() -> TypeScanSummary {
    return type_scan_summary(0, 1, 0);
}

fn check_ast_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return check_statement_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        Empty => return type_scan_summary(0, 0, 0);,
        ImportDecl(import_decl) => return type_scan_summary(0, 0, 0);,
        StructDecl(struct_decl) => return type_scan_summary(0, 0, 0);,
        EnumDecl(enum_decl) => return type_scan_summary(0, 0, 0);,
        UnionDecl(union_decl) => return type_scan_summary(0, 0, 0);,
        FnDecl(fn_decl) => return check_function_statements(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            function_returns
        );,
        Int(int_node) => return type_scan_summary(0, 0, 0);,
        String(string_node) => return type_scan_summary(0, 0, 0);,
        TypeName(type_name) => return type_scan_summary(0, 0, 0);,
        Var(var_node) => return type_scan_summary(0, 0, 0);,
        Bool(bool_node) => return type_scan_summary(0, 0, 0);,
        Prefix(prefix_node) => return type_scan_summary(0, 0, 0);,
        Binary(binary) => return type_scan_summary(0, 0, 0);,
        FieldExpr(field_expr_node) => return type_scan_summary(0, 0, 0);,
        DerefExpr(deref_expr_node) => return type_scan_summary(0, 0, 0);,
        Call(call_node) => return type_scan_summary(0, 0, 0);,
        TypeApplyExpr(type_apply) => return type_scan_summary(0, 0, 0);,
        CastExpr(cast_expr) => return type_scan_summary(0, 0, 0);,
        IndexExpr(index_expr) => return type_scan_summary(0, 0, 0);,
        StructLiteralExpr(struct_literal) => return type_scan_summary(0, 0, 0);,
        StructFieldInit(struct_field_init) => return type_scan_summary(0, 0, 0);,
        ArenaNewExpr(arena_new) => return type_scan_summary(0, 0, 0);,
        TryExpr(try_expr_node) => return type_scan_summary(0, 0, 0);,
        ComptimeExpr(comptime_expr_node) => return type_scan_summary(0, 0, 0);,
        Block(block) => return type_scan_summary(0, 0, 0);,
        If(if_node) => return type_scan_summary(0, 0, 0);,
        Let(let_node) => return type_scan_summary(0, 0, 0);,
        Assign(assign_node) => return type_scan_summary(0, 0, 0);,
        Return(return_node) => return type_scan_summary(0, 0, 0);,
        Defer(defer_node) => return type_scan_summary(0, 0, 0);,
        ExprStmt(expr_stmt) => return type_scan_summary(0, 0, 0);,
        While(while_node) => return type_scan_summary(0, 0, 0);,
        For(for_node) => return type_scan_summary(0, 0, 0);,
        Break(break_node) => return type_scan_summary(0, 0, 0);,
        Continue(continue_node) => return type_scan_summary(0, 0, 0);,
        Param(param_node) => return type_scan_summary(0, 0, 0);,
        Field(field_node) => return type_scan_summary(0, 0, 0);,
        UnionVariant(union_variant) => return type_scan_summary(0, 0, 0);,
        Match(match_node) => return type_scan_summary(0, 0, 0);,
        MatchArm(match_arm) => return type_scan_summary(0, 0, 0);,
        Unsafe(unsafe_node) => return type_scan_summary(0, 0, 0);,
        ComptimeIf(comptime_if_node) => return type_scan_summary(0, 0, 0);,
    }
}

fn check_statement_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    var summary = type_scan_summary(0, 0, 0);
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        summary = merge_type_summaries(
            summary,
            try check_ast_statements(allocator, file, ast, child, function_returns)
        );
        index = index + 1;
    }
    return summary;
}

fn check_function_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    var local_types = std::map::Map<[]const u8, []const u8>(allocator);
    var local_mutability = std::map::Map<[]const u8, bool>(allocator);
    var summary = try collect_function_statement_locals(
        allocator,
        file,
        ast,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let expected_return = try function_statement_return_type(
        allocator,
        file,
        ast,
        name,
        return_type,
        function_returns
    );
    summary = merge_type_summaries(
        summary,
        try check_statement_node(
            allocator,
            file,
            ast,
            body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        )
    );
    local_types.deinit();
    local_mutability.deinit();
    return summary;
}

fn collect_function_statement_locals(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    local_types: &mut std::map::Map<[]const u8, []const u8>,
    local_mutability: &mut std::map::Map<[]const u8, bool>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    var diagnostics = 0;
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        let param_text = ast_node_text(file, ast, child);
        var token = std::kizu::lexer::first_token(param_text);
        if std::mem::equal_bytes(token_text(param_text, token), "comptime") {
            token = std::kizu::lexer::next_token(param_text, token);
        }
        let name = token_text(param_text, token);
        var cursor = std::kizu::lexer::next_token(param_text, token);
        while !std::mem::equal_bytes(token_text(param_text, cursor), ":") and
            !std::mem::equal_bytes(token_text(param_text, cursor), "") {
            cursor = std::kizu::lexer::next_token(param_text, cursor);
        }
        var type_name = "unknown";
        if std::mem::equal_bytes(token_text(param_text, cursor), ":") {
            let first_type = std::kizu::lexer::next_token(param_text, cursor);
            if !std::mem::equal_bytes(token_text(param_text, first_type), "") {
                var type_end = first_type.end;
                var type_cursor = first_type;
                while !std::mem::equal_bytes(token_text(param_text, type_cursor), "") {
                    type_end = type_cursor.end;
                    type_cursor = std::kizu::lexer::next_token(param_text, type_cursor);
                }
                type_name = std::mem::trim_ascii(param_text[first_type.start..type_end]);
            }
        }
        if !local_types.contains(name) {
            try local_types.insert(name, type_name);
            try local_mutability.insert(name, false);
        }
        index = index + 1;
    }
    let body_text = ast_node_text(file, ast, body);
    var body_token = std::kizu::lexer::first_token(body_text);
    while !std::mem::equal_bytes(token_text(body_text, body_token), "") {
        let text = token_text(body_text, body_token);
        if std::mem::equal_bytes(text, "let") or std::mem::equal_bytes(text, "var") {
            let name_token = std::kizu::lexer::next_token(body_text, body_token);
            let name = token_text(body_text, name_token);
            if !local_types.contains(name) {
                let assign = std::kizu::lexer::next_token(body_text, name_token);
                let first_value = std::kizu::lexer::next_token(body_text, assign);
                let value_end = local_initializer_end(body_text, first_value);
                let type_name = try infer_initializer_text_type(
                    allocator,
                    file,
                    body_text,
                    first_value,
                    value_end,
                    local_types,
                    function_returns
                );
                try local_types.insert(name, type_name);
                try local_mutability.insert(name, std::mem::equal_bytes(text, "var"));
            }
        }
        body_token = std::kizu::lexer::next_token(body_text, body_token);
    }
    return type_scan_summary(0, params.len, diagnostics);
}

fn function_statement_return_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    var qualified = std::string::String(allocator);
    try append_module_name(qualified, file);
    try qualified.append_bytes("::");
    try qualified.append_bytes(ast_node_text(file, ast, name));
    let key = qualified.as_bytes();
    var expected = ast_return_type_text(file, ast, return_type);
    if function_returns.contains(key) {
        expected = try function_returns.get(key);
    }
    qualified.deinit();
    return expected;
}

fn check_statement_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    expected_return: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return check_statement_block(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Let(let_node) => return check_let_statement(
            allocator,
            file,
            ast,
            let_node.mutable,
            let_node.name,
            let_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        Assign(assign_node) => return check_assign_statement(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        Return(return_node) => return check_return_statement(
            allocator,
            file,
            ast,
            return_node.value,
            local_types,
            expected_return,
            function_returns
        );,
        Defer(defer_node) => return check_expr_statement(
            allocator,
            file,
            ast,
            defer_node.expr,
            local_types,
            function_returns
        );,
        ExprStmt(expr_stmt) => return check_expr_statement(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            local_types,
            function_returns
        );,
        If(if_node) => return check_if_statement(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        While(while_node) => return check_while_statement(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        For(for_node) => return check_for_statement(
            allocator,
            file,
            ast,
            for_node.name,
            for_node.start,
            for_node.end,
            for_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Match(match_node) => return check_match_statement(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        MatchArm(match_arm) => return check_statement_node(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Unsafe(unsafe_node) => return check_statement_node(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return check_if_statement(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Break(break_node) => return type_scan_summary(0, 1, 0);,
        Continue(continue_node) => return type_scan_summary(0, 1, 0);,
        Empty => return type_scan_summary(0, 0, 0);,
        Program(program) => return type_scan_summary(0, 0, 0);,
        ImportDecl(import_decl) => return type_scan_summary(0, 0, 0);,
        Param(param_node) => return type_scan_summary(0, 0, 0);,
        Field(field_node) => return type_scan_summary(0, 0, 0);,
        StructDecl(struct_decl) => return type_scan_summary(0, 0, 0);,
        EnumDecl(enum_decl) => return type_scan_summary(0, 0, 0);,
        UnionDecl(union_decl) => return type_scan_summary(0, 0, 0);,
        UnionVariant(union_variant) => return type_scan_summary(0, 0, 0);,
        FnDecl(fn_decl) => return type_scan_summary(0, 0, 0);,
        Int(int_node) => return type_scan_summary(0, 1, 0);,
        String(string_node) => return type_scan_summary(0, 1, 0);,
        TypeName(type_name) => return type_scan_summary(0, 1, 0);,
        Var(var_node) => return type_scan_summary(0, 1, 0);,
        Bool(bool_node) => return type_scan_summary(0, 1, 0);,
        Prefix(prefix_node) => return type_scan_summary(0, 1, 0);,
        Binary(binary) => return type_scan_summary(0, 1, 0);,
        FieldExpr(field_expr_node) => return type_scan_summary(0, 1, 0);,
        DerefExpr(deref_expr_node) => return type_scan_summary(0, 1, 0);,
        Call(call_node) => return type_scan_summary(0, 1, 0);,
        TypeApplyExpr(type_apply) => return type_scan_summary(0, 1, 0);,
        CastExpr(cast_expr) => return type_scan_summary(0, 1, 0);,
        IndexExpr(index_expr) => return type_scan_summary(0, 1, 0);,
        StructLiteralExpr(struct_literal) => return type_scan_summary(0, 1, 0);,
        StructFieldInit(struct_field_init) => return type_scan_summary(0, 1, 0);,
        ArenaNewExpr(arena_new) => return type_scan_summary(0, 1, 0);,
        TryExpr(try_expr_node) => return type_scan_summary(0, 1, 0);,
        ComptimeExpr(comptime_expr_node) => return type_scan_summary(0, 1, 0);,
    }
}

fn check_statement_block(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    expected_return: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    var summary = type_scan_summary(0, 1, 0);
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        summary = merge_type_summaries(
            summary,
            try check_statement_node(
                allocator,
                file,
                ast,
                child,
                local_types,
                local_mutability,
                expected_return,
                function_returns
            )
        );
        index = index + 1;
    }
    return summary;
}

fn check_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    expected_return: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    var summary = type_scan_summary(0, 1, 0);
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        summary = merge_type_summaries(
            summary,
            try check_statement_node(
                allocator,
                file,
                ast,
                child,
                local_types,
                local_mutability,
                expected_return,
                function_returns
            )
        );
        index = index + 1;
    }
    return summary;
}

fn check_let_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    mutable: bool,
    name_id: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let name = ast_node_text(file, ast, name_id);
    let value_type = try infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    var diagnostics = 0;
    if !local_types.contains(name) {
        diagnostics = diagnostics + 1;
    }
    return type_scan_summary(0, 1, diagnostics);
}

fn check_assign_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let target_node = ast.get(target);
    match target_node.data {
        Var(var_node) => return check_assign_var_statement(
            allocator,
            file,
            ast,
            target,
            value,
            local_types,
            local_mutability,
            function_returns
        );,
        FieldExpr(field_expr_node) => return type_scan_summary(0, 1, 0);,
        DerefExpr(deref_expr_node) => return type_scan_summary(0, 1, 0);,
        IndexExpr(index_expr) => return type_scan_summary(0, 1, 0);,
        Empty => return invalid_assignment_target_summary();,
        Int(int_node) => return invalid_assignment_target_summary();,
        String(string_node) => return invalid_assignment_target_summary();,
        TypeName(type_name) => return invalid_assignment_target_summary();,
        Bool(bool_node) => return invalid_assignment_target_summary();,
        Prefix(prefix_node) => return invalid_assignment_target_summary();,
        Binary(binary) => return invalid_assignment_target_summary();,
        Call(call_node) => return invalid_assignment_target_summary();,
        TypeApplyExpr(type_apply) => return invalid_assignment_target_summary();,
        CastExpr(cast_expr) => return invalid_assignment_target_summary();,
        StructLiteralExpr(struct_literal) => return invalid_assignment_target_summary();,
        StructFieldInit(struct_field_init) => return invalid_assignment_target_summary();,
        ArenaNewExpr(arena_new) => return invalid_assignment_target_summary();,
        TryExpr(try_expr_node) => return invalid_assignment_target_summary();,
        ComptimeExpr(comptime_expr_node) => return invalid_assignment_target_summary();,
        Block(block) => return invalid_assignment_target_summary();,
        If(if_node) => return invalid_assignment_target_summary();,
        Let(let_node) => return invalid_assignment_target_summary();,
        Assign(assign_node) => return invalid_assignment_target_summary();,
        Return(return_node) => return invalid_assignment_target_summary();,
        Defer(defer_node) => return invalid_assignment_target_summary();,
        ExprStmt(expr_stmt) => return invalid_assignment_target_summary();,
        While(while_node) => return invalid_assignment_target_summary();,
        For(for_node) => return invalid_assignment_target_summary();,
        Break(break_node) => return invalid_assignment_target_summary();,
        Continue(continue_node) => return invalid_assignment_target_summary();,
        ImportDecl(import_decl) => return invalid_assignment_target_summary();,
        Param(param_node) => return invalid_assignment_target_summary();,
        Field(field_node) => return invalid_assignment_target_summary();,
        StructDecl(struct_decl) => return invalid_assignment_target_summary();,
        EnumDecl(enum_decl) => return invalid_assignment_target_summary();,
        UnionDecl(union_decl) => return invalid_assignment_target_summary();,
        UnionVariant(union_variant) => return invalid_assignment_target_summary();,
        Match(match_node) => return invalid_assignment_target_summary();,
        MatchArm(match_arm) => return invalid_assignment_target_summary();,
        Unsafe(unsafe_node) => return invalid_assignment_target_summary();,
        ComptimeIf(comptime_if_node) => return invalid_assignment_target_summary();,
        FnDecl(fn_decl) => return invalid_assignment_target_summary();,
        Program(program) => return invalid_assignment_target_summary();,
    }
}

fn check_assign_var_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let name = ast_node_text(file, ast, target);
    if !local_types.contains(name) {
        return type_scan_summary(0, 1, 1);
    }
    var diagnostics = 0;
    let mutable = try local_mutability.get(name);
    if !mutable {
        diagnostics = diagnostics + 1;
    }
    let target_type = try local_types.get(name);
    let value_type = try infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    if known_type_mismatch(target_type, value_type) {
        diagnostics = diagnostics + 1;
    }
    return type_scan_summary(0, 1, diagnostics);
}

fn invalid_assignment_target_summary() -> TypeScanSummary {
    return type_scan_summary(0, 1, 1);
}

fn check_return_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    expected_return: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let value_type = try infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    var diagnostics = 0;
    if std::mem::equal_bytes(expected_return, "void") and known_type_mismatch(expected_return, value_type) {
        diagnostics = 1;
    }
    return type_scan_summary(0, 1, diagnostics);
}

fn check_expr_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let value_type = try infer_expression_type(
        allocator,
        file,
        ast,
        expr,
        local_types,
        function_returns
    );
    if std::mem::equal_bytes(value_type, "unknown") {
        return type_scan_summary(0, 1, 0);
    }
    return type_scan_summary(0, 1, 0);
}

fn check_if_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    expected_return: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    var summary = try check_condition_statement(
        allocator,
        file,
        ast,
        condition,
        local_types,
        function_returns
    );
    summary = merge_type_summaries(
        summary,
        try check_statement_node(
            allocator,
            file,
            ast,
            then_block,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        )
    );
    summary = merge_type_summaries(
        summary,
        try check_statement_node(
            allocator,
            file,
            ast,
            else_block,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        )
    );
    return summary;
}

fn check_while_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    expected_return: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    var summary = try check_condition_statement(
        allocator,
        file,
        ast,
        condition,
        local_types,
        function_returns
    );
    summary = merge_type_summaries(
        summary,
        try check_statement_node(
            allocator,
            file,
            ast,
            body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        )
    );
    return summary;
}

fn check_for_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name_id: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    expected_return: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let name = ast_node_text(file, ast, name_id);
    var diagnostics = 0;
    if local_types.contains(name) {
        diagnostics = diagnostics + 1;
    }
    let start_type = try infer_expression_type(
        allocator,
        file,
        ast,
        start,
        local_types,
        function_returns
    );
    let end_type = try infer_expression_type(
        allocator,
        file,
        ast,
        end,
        local_types,
        function_returns
    );
    if known_type_mismatch("i64", start_type) {
        diagnostics = diagnostics + 1;
    }
    if known_type_mismatch("i64", end_type) {
        diagnostics = diagnostics + 1;
    }
    var summary = type_scan_summary(0, 1, diagnostics);
    summary = merge_type_summaries(
        summary,
        try check_statement_node(
            allocator,
            file,
            ast,
            body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        )
    );
    return summary;
}

fn check_match_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]const u8, []const u8>,
    local_mutability: &std::map::Map<[]const u8, bool>,
    expected_return: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let value_type = try infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    var diagnostics = 0;
    if unsupported_match_value_type(value_type) {
        diagnostics = diagnostics + 1;
    }
    var summary = type_scan_summary(0, 1, diagnostics);
    summary = merge_type_summaries(
        summary,
        try check_statement_range(
            allocator,
            file,
            ast,
            arms,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        )
    );
    return summary;
}

fn unsupported_match_value_type(value_type: []const u8) -> bool {
    if std::mem::equal_bytes(value_type, "unknown") {
        return false;
    }
    if std::mem::starts_with(value_type, "?") or
        std::mem::starts_with(value_type, "!") or
        bytes_contains(value_type, "!") {
        return false;
    }
    return is_scalar_comparable_type(value_type);
}

fn check_condition_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> !TypeScanSummary {
    let condition_type = try infer_expression_type(
        allocator,
        file,
        ast,
        condition,
        local_types,
        function_returns
    );
    var diagnostics = 0;
    if known_type_mismatch("bool", condition_type) {
        diagnostics = 1;
    }
    return type_scan_summary(0, 1, diagnostics);
}

fn infer_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    let node = ast.get(node_id);
    match node.data {
        Int(int_node) => return "i64";,
        String(string_node) => return "[]const u8";,
        Bool(bool_node) => return "bool";,
        Empty => return "void";,
        Var(var_node) => return infer_var_expression_type(file, ast, node_id, local_types);,
        Binary(binary) => return binary_expression_type(binary.op);,
        Prefix(prefix_node) => return prefix_expression_type(prefix_node.op);,
        CastExpr(cast_expr) => return ast_return_type_text(file, ast, cast_expr.type_node);,
        ComptimeExpr(comptime_expr_node) => return infer_expression_type(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            local_types,
            function_returns
        );,
        TryExpr(try_expr_node) => return success_type_of(try infer_expression_type(
            allocator,
            file,
            ast,
            try_expr_node.value,
            local_types,
            function_returns
        ));,
        FieldExpr(field_expr_node) => return field_expression_type(
            file,
            ast,
            field_expr_node.name
        );,
        DerefExpr(deref_expr_node) => return "unknown";,
        Call(call_node) => return call_expression_type(
            allocator,
            file,
            ast,
            call_node.callee,
            local_types,
            function_returns
        );,
        TypeApplyExpr(type_apply) => return ast_node_text(file, ast, node_id);,
        IndexExpr(index_expr) => return index_expression_type(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.slice,
            local_types,
            function_returns
        );,
        StructLiteralExpr(struct_literal) => return ast_node_text(file, ast, struct_literal.type_name);,
        StructFieldInit(struct_field_init) => return "unknown";,
        ArenaNewExpr(arena_new) => return arena_expression_type(file, ast, arena_new.type_node);,
        Block(block) => return "unknown";,
        If(if_node) => return "unknown";,
        Let(let_node) => return "unknown";,
        Assign(assign_node) => return "unknown";,
        Return(return_node) => return "unknown";,
        Defer(defer_node) => return "unknown";,
        ExprStmt(expr_stmt) => return "unknown";,
        While(while_node) => return "unknown";,
        For(for_node) => return "unknown";,
        Break(break_node) => return "void";,
        Continue(continue_node) => return "void";,
        Program(program) => return "unknown";,
        ImportDecl(import_decl) => return "unknown";,
        Param(param_node) => return "unknown";,
        Field(field_node) => return "unknown";,
        StructDecl(struct_decl) => return "unknown";,
        EnumDecl(enum_decl) => return "unknown";,
        UnionDecl(union_decl) => return "unknown";,
        UnionVariant(union_variant) => return "unknown";,
        Match(match_node) => return "unknown";,
        MatchArm(match_arm) => return "unknown";,
        Unsafe(unsafe_node) => return "unknown";,
        ComptimeIf(comptime_if_node) => return "unknown";,
        FnDecl(fn_decl) => return "unknown";,
        TypeName(type_name) => return ast_node_text(file, ast, node_id);,
    }
}

fn local_initializer_end(
    source_text: []const u8,
    start: std::kizu::lexer::Token
) -> std::kizu::lexer::Token {
    var cursor = start;
    var end = start;
    var angle_depth = 0;
    var paren_depth = 0;
    var bracket_depth = 0;
    var brace_depth = 0;
    while !std::mem::equal_bytes(token_text(source_text, cursor), "") {
        let text = token_text(source_text, cursor);
        if angle_depth == 0 and
            paren_depth == 0 and
            bracket_depth == 0 and
            brace_depth == 0 and
            std::mem::equal_bytes(text, ";") {
            return end;
        }
        if std::mem::equal_bytes(text, "<") {
            angle_depth = angle_depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                angle_depth = angle_depth - 1;
            } else {
                if std::mem::equal_bytes(text, "(") {
                    paren_depth = paren_depth + 1;
                } else {
                    if std::mem::equal_bytes(text, ")") {
                        paren_depth = paren_depth - 1;
                    } else {
                        if std::mem::equal_bytes(text, "[") {
                            bracket_depth = bracket_depth + 1;
                        } else {
                            if std::mem::equal_bytes(text, "]") {
                                bracket_depth = bracket_depth - 1;
                            } else {
                                if std::mem::equal_bytes(text, "{") {
                                    brace_depth = brace_depth + 1;
                                } else {
                                    if std::mem::equal_bytes(text, "}") {
                                        brace_depth = brace_depth - 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        end = cursor;
        cursor = std::kizu::lexer::next_token(source_text, cursor);
    }
    return end;
}

fn infer_initializer_text_type(
    allocator: Allocator,
    file: &source::SourceFile,
    source_text: []const u8,
    start: std::kizu::lexer::Token,
    end: std::kizu::lexer::Token,
    local_types: &std::map::Map<[]const u8, []const u8>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    if end.end < start.start {
        return "unknown";
    }
    let expression = std::mem::trim_ascii(source_text[start.start..end.end]);
    return infer_expression_text_type(allocator, file, expression, local_types, function_returns);
}

fn infer_expression_text_type(
    allocator: Allocator,
    file: &source::SourceFile,
    expression: []const u8,
    local_types: &std::map::Map<[]const u8, []const u8>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    let text = std::mem::trim_ascii(expression);
    if std::mem::len(text) < 1 {
        return "unknown";
    }
    let first = std::kizu::lexer::first_token(text);
    let first_text = token_text(text, first);
    if std::mem::equal_bytes(first_text, "try") {
        return success_type_of(try infer_expression_text_type(
            allocator,
            file,
            text[first.end..std::mem::len(text)],
            local_types,
            function_returns
        ));
    }
    if std::mem::equal_bytes(first_text, "true") or std::mem::equal_bytes(first_text, "false") {
        return "bool";
    }
    if text[0] == cast<u8>(34) {
        return "[]const u8";
    }
    if text[0] >= cast<u8>(48) and text[0] <= cast<u8>(57) {
        return "i64";
    }
    if std::mem::equal_bytes(first_text, "cast") {
        return cast_expression_text_type(text);
    }
    if local_types.contains(text) {
        return local_types.get(text);
    }
    let callee = expression_callee_text(text);
    if !std::mem::equal_bytes(callee, "") {
        if is_generic_constructor_text(callee) {
            return callee;
        }
        let method_type = try method_call_text_type(callee, local_types);
        if !std::mem::equal_bytes(method_type, "unknown") {
            return method_type;
        }
        return resolved_function_return_type(allocator, file, callee, function_returns);
    }
    return field_text_type(text);
}

fn expression_callee_text(expression: []const u8) -> []const u8 {
    var cursor = std::kizu::lexer::first_token(expression);
    var end = cursor;
    var angle_depth = 0;
    while !std::mem::equal_bytes(token_text(expression, cursor), "") {
        let text = token_text(expression, cursor);
        if angle_depth == 0 and std::mem::equal_bytes(text, "(") {
            return std::mem::trim_ascii(expression[0..end.end]);
        }
        if std::mem::equal_bytes(text, "<") {
            angle_depth = angle_depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                angle_depth = angle_depth - 1;
            }
        }
        end = cursor;
        cursor = std::kizu::lexer::next_token(expression, cursor);
    }
    return "";
}

fn cast_expression_text_type(expression: []const u8) -> []const u8 {
    var cursor = std::kizu::lexer::first_token(expression);
    while !std::mem::equal_bytes(token_text(expression, cursor), "") and
        !std::mem::equal_bytes(token_text(expression, cursor), "<") {
        cursor = std::kizu::lexer::next_token(expression, cursor);
    }
    if !std::mem::equal_bytes(token_text(expression, cursor), "<") {
        return "unknown";
    }
    let first_type = std::kizu::lexer::next_token(expression, cursor);
    var type_end = first_type;
    var depth = 1;
    cursor = first_type;
    while !std::mem::equal_bytes(token_text(expression, cursor), "") and depth > 0 {
        let text = token_text(expression, cursor);
        if std::mem::equal_bytes(text, "<") {
            depth = depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                depth = depth - 1;
                if depth == 0 {
                    return std::mem::trim_ascii(expression[first_type.start..type_end.end]);
                }
            }
        }
        type_end = cursor;
        cursor = std::kizu::lexer::next_token(expression, cursor);
    }
    return "unknown";
}

fn success_type_of(value_type: []const u8) -> []const u8 {
    if std::mem::starts_with(value_type, "!") {
        return value_type[1..std::mem::len(value_type)];
    }
    var index = 0;
    while index < std::mem::len(value_type) {
        if value_type[index] == cast<u8>(33) {
            return value_type[index + 1..std::mem::len(value_type)];
        }
        index = index + 1;
    }
    return value_type;
}

fn field_expression_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId
) -> []const u8 {
    return field_name_type(ast_node_text(file, ast, name));
}

fn call_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    let callee_text = ast_node_text(file, ast, callee);
    if is_generic_constructor_text(callee_text) {
        return callee_text;
    }
    let method_type = try method_call_text_type(callee_text, local_types);
    if !std::mem::equal_bytes(method_type, "unknown") {
        return method_type;
    }
    return resolved_function_return_type(allocator, file, callee_text, function_returns);
}

fn index_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    slice: bool,
    local_types: &std::map::Map<[]const u8, []const u8>,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    let target_type = try infer_expression_type(
        allocator,
        file,
        ast,
        target,
        local_types,
        function_returns
    );
    if slice {
        if is_const_u8_slice(target_type) {
            return "[]const u8";
        }
        if std::mem::starts_with(target_type, "[]") {
            return target_type;
        }
        return "unknown";
    }
    if is_const_u8_slice(target_type) {
        return "u8";
    }
    return "unknown";
}

fn arena_expression_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> []const u8 {
    let type_name = ast_node_text(file, ast, type_node);
    if std::mem::equal_bytes(type_name, "") {
        return "unknown";
    }
    return "unknown";
}

fn field_text_type(expression: []const u8) -> []const u8 {
    var start = 0;
    var index = 0;
    while index < std::mem::len(expression) {
        if expression[index] == cast<u8>(46) {
            start = index + 1;
        }
        index = index + 1;
    }
    return field_name_type(expression[start..std::mem::len(expression)]);
}

fn field_name_type(field: []const u8) -> []const u8 {
    if std::mem::equal_bytes(field, "start") or
        std::mem::equal_bytes(field, "end") or
        std::mem::equal_bytes(field, "line") or
        std::mem::equal_bytes(field, "column") or
        std::mem::equal_bytes(field, "raw") or
        std::mem::equal_bytes(field, "len") or
        std::mem::equal_bytes(field, "source_id") or
        std::mem::equal_bytes(field, "byte_start") or
        std::mem::equal_bytes(field, "byte_end") or
        std::mem::equal_bytes(field, "span_start") or
        std::mem::equal_bytes(field, "span_end") {
        return "i64";
    }
    if std::mem::equal_bytes(field, "modules") or
        std::mem::equal_bytes(field, "symbols") or
        std::mem::equal_bytes(field, "functions") or
        std::mem::equal_bytes(field, "typed_nodes") or
        std::mem::equal_bytes(field, "diagnostics") or
        std::mem::equal_bytes(field, "params") or
        std::mem::equal_bytes(field, "tokens") or
        std::mem::equal_bytes(field, "bytes") or
        std::mem::equal_bytes(field, "declarations") or
        std::mem::equal_bytes(field, "nodes") {
        return "i64";
    }
    if std::mem::equal_bytes(field, "public") or
        std::mem::equal_bytes(field, "unsafe_decl") or
        std::mem::equal_bytes(field, "comptime_param") or
        std::mem::equal_bytes(field, "mutable") or
        std::mem::equal_bytes(field, "slice") or
        std::mem::equal_bytes(field, "namespace") or
        std::mem::equal_bytes(field, "value") or
        std::mem::equal_bytes(field, "diagnostic") or
        std::mem::equal_bytes(field, "is_dir") {
        return "bool";
    }
    if std::mem::equal_bytes(field, "path") or
        std::mem::equal_bytes(field, "text") or
        std::mem::equal_bytes(field, "module") or
        std::mem::equal_bytes(field, "message") or
        std::mem::equal_bytes(field, "name") or
        std::mem::equal_bytes(field, "return_type") or
        std::mem::equal_bytes(field, "param_source") {
        return "[]const u8";
    }
    return "unknown";
}

fn method_call_text_type(
    callee: []const u8,
    local_types: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    let method = last_field_segment(callee);
    var receiver_type = "unknown";
    var last_dot = -1;
    var index = 0;
    while index < std::mem::len(callee) {
        if callee[index] == cast<u8>(46) {
            last_dot = index;
        }
        index = index + 1;
    }
    if last_dot > 0 {
        let receiver = callee[0..last_dot];
        if local_types.contains(receiver) {
            receiver_type = try local_types.get(receiver);
        }
    }
    return method_return_type(method, receiver_type);
}

fn last_field_segment(text: []const u8) -> []const u8 {
    var start = 0;
    var index = 0;
    while index < std::mem::len(text) {
        if text[index] == cast<u8>(46) {
            start = index + 1;
        }
        index = index + 1;
    }
    return text[start..std::mem::len(text)];
}

fn method_return_type(method: []const u8, receiver_type: []const u8) -> []const u8 {
    if std::mem::equal_bytes(method, "len") or std::mem::equal_bytes(method, "capacity") {
        return "i64";
    }
    if std::mem::equal_bytes(method, "contains") {
        return "bool";
    }
    if std::mem::equal_bytes(method, "as_bytes") {
        return "[]const u8";
    }
    if std::mem::equal_bytes(method, "append") or
        std::mem::equal_bytes(method, "append_bytes") or
        std::mem::equal_bytes(method, "append_byte") or
        std::mem::equal_bytes(method, "reserve") or
        std::mem::equal_bytes(method, "set") or
        std::mem::equal_bytes(method, "clear") or
        std::mem::equal_bytes(method, "truncate") or
        std::mem::equal_bytes(method, "deinit") {
        return "void";
    }
    if std::mem::equal_bytes(method, "get") or
        std::mem::equal_bytes(method, "at") or
        std::mem::equal_bytes(method, "at_mut") {
        return container_element_type(receiver_type);
    }
    return "unknown";
}

fn container_element_type(type_name: []const u8) -> []const u8 {
    if std::mem::starts_with(type_name, "std::array::Array<") {
        return first_generic_argument(type_name);
    }
    if std::mem::starts_with(type_name, "std::map::Map<") {
        return second_generic_argument(type_name);
    }
    return "unknown";
}

fn first_generic_argument(type_name: []const u8) -> []const u8 {
    var index = 0;
    while index < std::mem::len(type_name) and type_name[index] != cast<u8>(60) {
        index = index + 1;
    }
    if index >= std::mem::len(type_name) {
        return "unknown";
    }
    let start = index + 1;
    index = start;
    var depth = 1;
    while index < std::mem::len(type_name) and depth > 0 {
        let byte = type_name[index];
        if byte == cast<u8>(60) {
            depth = depth + 1;
        } else {
            if byte == cast<u8>(62) {
                depth = depth - 1;
                if depth == 0 {
                    return std::mem::trim_ascii(type_name[start..index]);
                }
            } else {
                if depth == 1 and byte == cast<u8>(44) {
                    return std::mem::trim_ascii(type_name[start..index]);
                }
            }
        }
        index = index + 1;
    }
    return "unknown";
}

fn second_generic_argument(type_name: []const u8) -> []const u8 {
    var index = 0;
    var depth = 0;
    var start = -1;
    while index < std::mem::len(type_name) {
        let byte = type_name[index];
        if byte == cast<u8>(60) {
            depth = depth + 1;
        } else {
            if byte == cast<u8>(62) {
                if depth == 1 and start >= 0 {
                    return std::mem::trim_ascii(type_name[start..index]);
                }
                depth = depth - 1;
            } else {
                if byte == cast<u8>(44) and depth == 1 {
                    start = index + 1;
                }
            }
        }
        index = index + 1;
    }
    return "unknown";
}

fn is_generic_constructor_text(text: []const u8) -> bool {
    return std::mem::starts_with(text, "std::array::Array<") or
        std::mem::starts_with(text, "std::map::Map<") or
        std::mem::starts_with(text, "std::mem::Box<") or
        std::mem::starts_with(text, "std::arena::Arena<") or
        std::mem::starts_with(text, "std::arena::Handle<");
}

fn resolved_function_return_type(
    allocator: Allocator,
    file: &source::SourceFile,
    name: []const u8,
    function_returns: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    if should_skip_function_reference(name) {
        return "unknown";
    }
    var resolved = std::string::String(allocator);
    try append_resolved_function_name(resolved, file, name);
    let key = resolved.as_bytes();
    var result = "unknown";
    if function_returns.contains(key) {
        result = try function_returns.get(key);
    }
    resolved.deinit();
    return result;
}

fn infer_var_expression_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]const u8, []const u8>
) -> ![]const u8 {
    let name = ast_node_text(file, ast, node_id);
    if local_types.contains(name) {
        return local_types.get(name);
    }
    return "unknown";
}

fn binary_expression_type(op: std::kizu::ast::BinaryOp) -> []const u8 {
    match op {
        Add => return "i64";,
        Sub => return "i64";,
        Mul => return "i64";,
        Div => return "i64";,
        Mod => return "i64";,
        Eq => return "bool";,
        NotEq => return "bool";,
        LT => return "bool";,
        LTE => return "bool";,
        GT => return "bool";,
        GTE => return "bool";,
        And => return "bool";,
        Or => return "bool";,
    }
}

fn prefix_expression_type(op: std::kizu::ast::PrefixOp) -> []const u8 {
    match op {
        Not => return "bool";,
        Neg => return "i64";,
        Borrow => return "unknown";,
        MutBorrow => return "unknown";,
    }
}

fn known_type_mismatch(expected: []const u8, actual: []const u8) -> bool {
    if std::mem::equal_bytes(expected, "unknown") or std::mem::equal_bytes(actual, "unknown") {
        return false;
    }
    if std::mem::starts_with(expected, "!") {
        return false;
    }
    if std::mem::starts_with(actual, "!") or bytes_contains(actual, "!") {
        return false;
    }
    if is_const_u8_slice(expected) or is_const_u8_slice(actual) {
        return !(is_const_u8_slice(expected) and is_const_u8_slice(actual));
    }
    if !is_scalar_comparable_type(expected) or !is_scalar_comparable_type(actual) {
        return false;
    }
    return !std::mem::equal_bytes(expected, actual);
}

fn is_scalar_comparable_type(type_name: []const u8) -> bool {
    return std::mem::equal_bytes(type_name, "void") or
        std::mem::equal_bytes(type_name, "bool") or
        std::mem::equal_bytes(type_name, "i64") or
        std::mem::equal_bytes(type_name, "u8") or
        std::mem::equal_bytes(type_name, "Allocator") or
        std::mem::equal_bytes(type_name, "Io");
}

fn is_const_u8_slice(type_name: []const u8) -> bool {
    if std::mem::equal_bytes(type_name, "[]const u8") {
        return true;
    }
    return std::mem::starts_with(type_name, "[]") and bytes_contains(type_name, "const u8");
}

fn bytes_contains(haystack: []const u8, needle: []const u8) -> bool {
    let needle_len = std::mem::len(needle);
    if needle_len < 1 {
        return true;
    }
    if needle_len > std::mem::len(haystack) {
        return false;
    }
    var index = 0;
    while index + needle_len <= std::mem::len(haystack) {
        if std::mem::equal_bytes(haystack[index..index + needle_len], needle) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn ast_return_type_text(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []const u8 {
    let node = ast.get(node_id);
    match node.data {
        Empty => return "void";,
        Int(int_node) => return ast_node_text(file, ast, node_id);,
        String(string_node) => return ast_node_text(file, ast, node_id);,
        TypeName(type_name) => return ast_node_text(file, ast, node_id);,
        Var(var_node) => return ast_node_text(file, ast, node_id);,
        Bool(bool_node) => return ast_node_text(file, ast, node_id);,
        Prefix(prefix_node) => return ast_node_text(file, ast, node_id);,
        Binary(binary) => return ast_node_text(file, ast, node_id);,
        FieldExpr(field_expr_node) => return ast_node_text(file, ast, node_id);,
        DerefExpr(deref_expr_node) => return ast_node_text(file, ast, node_id);,
        Call(call_node) => return ast_node_text(file, ast, node_id);,
        TypeApplyExpr(type_apply) => return ast_node_text(file, ast, node_id);,
        CastExpr(cast_expr) => return ast_node_text(file, ast, node_id);,
        IndexExpr(index_expr) => return ast_node_text(file, ast, node_id);,
        StructLiteralExpr(struct_literal) => return ast_node_text(file, ast, node_id);,
        StructFieldInit(struct_field_init) => return ast_node_text(file, ast, node_id);,
        ArenaNewExpr(arena_new) => return ast_node_text(file, ast, node_id);,
        TryExpr(try_expr_node) => return ast_node_text(file, ast, node_id);,
        ComptimeExpr(comptime_expr_node) => return ast_node_text(file, ast, node_id);,
        Block(block) => return ast_node_text(file, ast, node_id);,
        If(if_node) => return ast_node_text(file, ast, node_id);,
        Let(let_node) => return ast_node_text(file, ast, node_id);,
        Assign(assign_node) => return ast_node_text(file, ast, node_id);,
        Return(return_node) => return ast_node_text(file, ast, node_id);,
        Defer(defer_node) => return ast_node_text(file, ast, node_id);,
        ExprStmt(expr_stmt) => return ast_node_text(file, ast, node_id);,
        While(while_node) => return ast_node_text(file, ast, node_id);,
        For(for_node) => return ast_node_text(file, ast, node_id);,
        Break(break_node) => return ast_node_text(file, ast, node_id);,
        Continue(continue_node) => return ast_node_text(file, ast, node_id);,
        ImportDecl(import_decl) => return ast_node_text(file, ast, node_id);,
        Param(param_node) => return ast_node_text(file, ast, node_id);,
        Field(field_node) => return ast_node_text(file, ast, node_id);,
        StructDecl(struct_decl) => return ast_node_text(file, ast, node_id);,
        EnumDecl(enum_decl) => return ast_node_text(file, ast, node_id);,
        UnionDecl(union_decl) => return ast_node_text(file, ast, node_id);,
        UnionVariant(union_variant) => return ast_node_text(file, ast, node_id);,
        Match(match_node) => return ast_node_text(file, ast, node_id);,
        MatchArm(match_arm) => return ast_node_text(file, ast, node_id);,
        Unsafe(unsafe_node) => return ast_node_text(file, ast, node_id);,
        ComptimeIf(comptime_if_node) => return ast_node_text(file, ast, node_id);,
        FnDecl(fn_decl) => return ast_node_text(file, ast, node_id);,
        Program(program) => return ast_node_text(file, ast, node_id);,
    }
}

fn ast_node_text(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []const u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(file.text[span.start..span.end]);
}

fn scan_type_range(
    allocator: Allocator,
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    module: []const u8,
    start: i64,
    kinds: &std::map::Map<[]const u8, TypeKind>,
    arities: &std::map::Map<[]const u8, i64>
) -> !TypeScanSummary {
    var index = start;
    var angle_depth = 0;
    var paren_depth = 0;
    var typed_nodes = 0;
    var diagnostics = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        let text = token_text(file.text, token);
        if angle_depth == 0 and paren_depth == 0 and is_type_range_end(text) {
            return type_scan_summary(index, typed_nodes, diagnostics);
        }
        if std::mem::equal_bytes(text, "<") {
            angle_depth = angle_depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                angle_depth = angle_depth - 1;
            } else {
                if std::mem::equal_bytes(text, "(") {
                    paren_depth = paren_depth + 1;
                } else {
                    if std::mem::equal_bytes(text, ")") {
                        paren_depth = paren_depth - 1;
                    }
                }
            }
        }
        let path_end = try qualified_path_end(file.text, tokens, index);
        if path_end >= index {
            let checked = try check_type_name_at(
                allocator,
                file,
                tokens,
                module,
                index,
                path_end,
                kinds,
                arities
            );
            typed_nodes = typed_nodes + checked.typed_nodes;
            diagnostics = diagnostics + checked.diagnostics;
            index = path_end + 1;
        } else {
            index = index + 1;
        }
    }
    return type_scan_summary(index, typed_nodes, diagnostics);
}

fn scan_type_arguments(
    allocator: Allocator,
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    module: []const u8,
    start: i64,
    kinds: &std::map::Map<[]const u8, TypeKind>,
    arities: &std::map::Map<[]const u8, i64>
) -> !TypeScanSummary {
    var index = start;
    var depth = 1;
    var typed_nodes = 0;
    var diagnostics = 0;
    while index < tokens.len() and depth > 0 {
        let token = try tokens.get(index);
        let text = token_text(file.text, token);
        if std::mem::equal_bytes(text, "<") {
            depth = depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                depth = depth - 1;
            }
        }
        if depth > 0 {
            let path_end = try qualified_path_end(file.text, tokens, index);
            if path_end >= index {
                let checked = try check_type_name_at(
                    allocator,
                    file,
                    tokens,
                    module,
                    index,
                    path_end,
                    kinds,
                    arities
                );
                typed_nodes = typed_nodes + checked.typed_nodes;
                diagnostics = diagnostics + checked.diagnostics;
                index = path_end + 1;
            } else {
                index = index + 1;
            }
        } else {
            index = index + 1;
        }
    }
    return type_scan_summary(index, typed_nodes, diagnostics);
}

fn check_type_name_at(
    allocator: Allocator,
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    module: []const u8,
    start: i64,
    end: i64,
    kinds: &std::map::Map<[]const u8, TypeKind>,
    arities: &std::map::Map<[]const u8, i64>
) -> !TypeScanSummary {
    let first = try tokens.get(start);
    let last = try tokens.get(end);
    let name = file.text[first.start..last.end];
    if should_ignore_type_name(name) {
        return type_scan_summary(end + 1, 0, 0);
    }
    if type_name_exists(kinds, name) {
        let observed = try observed_type_arity(file.text, tokens, end + 1);
        return type_scan_summary(end + 1, 1, try arity_diagnostic(arities, name, observed));
    }
    return type_scan_summary(end + 1, 1, 1);
}

fn type_name_exists(
    kinds: &std::map::Map<[]const u8, TypeKind>,
    name: []const u8
) -> bool {
    if kinds.contains(name) {
        return true;
    }
    if is_unqualified_type_like(name) {
        return true;
    }
    if is_relative_qualified_name(name) {
        return true;
    }
    if is_qualified_name(name) {
        return false;
    }
    return false;
}

fn qualified_module_name(
    allocator: Allocator,
    file: &source::SourceFile
) -> !std::string::String {
    var name = std::string::String(allocator);
    try append_module_name(name, file);
    return name;
}

fn append_module_name(
    name: &mut std::string::String,
    file: &source::SourceFile
) -> !void {
    if file.kind == source::SourceKind::Std {
        try name.append_bytes("std::");
    } else {
        try name.append_bytes("selfhost::");
    }
    try name.append_bytes(file.module);
    return;
}

fn token_text(
    source_text: []const u8,
    token: std::kizu::lexer::Token
) -> []const u8 {
    return source_text[token.start..token.end];
}

fn type_scan_summary(next: i64, typed_nodes: i64, diagnostics: i64) -> TypeScanSummary {
    return TypeScanSummary {
        next: next,
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
}

fn merge_type_summaries(left: TypeScanSummary, right: TypeScanSummary) -> TypeScanSummary {
    return TypeScanSummary {
        next: right.next,
        typed_nodes: left.typed_nodes + right.typed_nodes,
        diagnostics: left.diagnostics + right.diagnostics
    };
}

fn is_type_declaration(text: []const u8) -> bool {
    return std::mem::equal_bytes(text, "struct") or
        std::mem::equal_bytes(text, "enum") or
        std::mem::equal_bytes(text, "union");
}

fn type_kind(text: []const u8) -> TypeKind {
    if std::mem::equal_bytes(text, "enum") {
        return TypeKind::Enum;
    }
    if std::mem::equal_bytes(text, "union") {
        return TypeKind::Union;
    }
    return TypeKind::Struct;
}

fn type_decl_copyable(text: []const u8) -> bool {
    return !std::mem::equal_bytes(text, "union");
}

fn type_decl_arity(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    if index >= tokens.len() {
        return 0;
    }
    let token = try tokens.get(index);
    if !std::mem::equal_bytes(token_text(source_text, token), "<") {
        return 0;
    }
    return count_type_arguments(source_text, tokens, index);
}

fn is_type_range_end(text: []const u8) -> bool {
    return std::mem::equal_bytes(text, ",") or
        std::mem::equal_bytes(text, ")") or
        std::mem::equal_bytes(text, "{") or
        std::mem::equal_bytes(text, ";") or
        std::mem::equal_bytes(text, "=") or
        std::mem::equal_bytes(text, "borrows");
}

fn is_type_start_candidate(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    if index >= tokens.len() {
        return false;
    }
    let token = try tokens.get(index);
    let text = token_text(source_text, token);
    if std::mem::equal_bytes(text, "!") or
        std::mem::equal_bytes(text, "?") or
        std::mem::equal_bytes(text, "&") or
        std::mem::equal_bytes(text, "[") {
        return true;
    }
    if is_builtin_type_name(text) {
        return true;
    }
    if starts_with_uppercase(text) {
        return true;
    }
    if index + 1 < tokens.len() {
        let next = try tokens.get(index + 1);
        if std::mem::equal_bytes(token_text(source_text, next), "::") {
            return true;
        }
    }
    return false;
}

fn is_type_annotation_colon(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    let candidate = try is_type_start_candidate(source_text, tokens, index + 1);
    if !candidate {
        return false;
    }
    var cursor = index + 1;
    var angle_depth = 0;
    var paren_depth = 0;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        let text = token_text(source_text, token);
        if angle_depth == 0 and paren_depth == 0 and is_type_range_end(text) {
            return true;
        }
        if std::mem::equal_bytes(text, ".") {
            return false;
        }
        if std::mem::equal_bytes(text, "(") {
            return false;
        }
        if std::mem::equal_bytes(text, "<") {
            angle_depth = angle_depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                angle_depth = angle_depth - 1;
            } else {
                if std::mem::equal_bytes(text, ")") {
                    paren_depth = paren_depth - 1;
                }
            }
        }
        cursor = cursor + 1;
    }
    return true;
}

fn is_builtin_type_name(text: []const u8) -> bool {
    return std::mem::equal_bytes(text, "void") or
        std::mem::equal_bytes(text, "bool") or
        std::mem::equal_bytes(text, "i64") or
        std::mem::equal_bytes(text, "u8") or
        std::mem::equal_bytes(text, "Allocator") or
        std::mem::equal_bytes(text, "Io") or
        std::mem::equal_bytes(text, "Function");
}

fn should_ignore_type_name(name: []const u8) -> bool {
    return std::mem::equal_bytes(name, "const") or
        std::mem::equal_bytes(name, "mut") or
        std::mem::equal_bytes(name, "comptime") or
        std::mem::equal_bytes(name, "pub");
}

fn is_unqualified_type_like(name: []const u8) -> bool {
    if std::mem::len(name) < 1 {
        return false;
    }
    return starts_with_uppercase(name);
}

fn starts_with_uppercase(name: []const u8) -> bool {
    if std::mem::len(name) < 1 {
        return false;
    }
    let byte = name[0];
    return byte >= cast<u8>(65) and byte <= cast<u8>(90);
}

fn is_qualified_name(name: []const u8) -> bool {
    var index = 0;
    while index + 1 < std::mem::len(name) {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn is_relative_qualified_name(name: []const u8) -> bool {
    if !is_qualified_name(name) {
        return false;
    }
    return !std::mem::starts_with(name, "std::") and
        !std::mem::starts_with(name, "selfhost::");
}

fn observed_type_arity(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    if index >= tokens.len() {
        return 0;
    }
    let token = try tokens.get(index);
    if !std::mem::equal_bytes(token_text(source_text, token), "<") {
        return 0;
    }
    return count_type_arguments(source_text, tokens, index);
}

fn count_type_arguments(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !i64 {
    var count = 1;
    var depth = 1;
    var cursor = open_index + 1;
    while cursor < tokens.len() and depth > 0 {
        let current = try tokens.get(cursor);
        let text = token_text(source_text, current);
        if std::mem::equal_bytes(text, "<") {
            depth = depth + 1;
        } else {
            if std::mem::equal_bytes(text, ">") {
                depth = depth - 1;
            } else {
                if depth == 1 and std::mem::equal_bytes(text, ",") {
                    count = count + 1;
                }
            }
        }
        cursor = cursor + 1;
    }
    return count;
}

fn arity_diagnostic(
    arities: &std::map::Map<[]const u8, i64>,
    name: []const u8,
    observed: i64
) -> !i64 {
    if !arities.contains(name) {
        return 0;
    }
    let expected = try arities.get(name);
    if expected != observed {
        return 1;
    }
    return 0;
}

fn qualified_path_end(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    if index >= tokens.len() {
        return -1;
    }
    let first = try tokens.get(index);
    if !is_type_name_segment(token_text(source_text, first)) {
        return -1;
    }
    var end = index;
    var cursor = index + 1;
    while cursor + 1 < tokens.len() {
        let separator = try tokens.get(cursor);
        let next = try tokens.get(cursor + 1);
        if std::mem::equal_bytes(token_text(source_text, separator), "::") and
            is_type_name_segment(token_text(source_text, next)) {
            end = cursor + 1;
            cursor = cursor + 2;
        } else {
            return end;
        }
    }
    return end;
}

fn is_type_name_segment(text: []const u8) -> bool {
    if should_ignore_type_name(text) {
        return false;
    }
    if std::mem::equal_bytes(text, "") {
        return false;
    }
    let byte = text[0];
    return (byte >= cast<u8>(65) and byte <= cast<u8>(90)) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        byte == cast<u8>(95);
}

fn is_cast_type_start(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let current = try tokens.get(index);
    let next = try tokens.get(index + 1);
    return std::mem::equal_bytes(token_text(source_text, current), "cast") and
        std::mem::equal_bytes(token_text(source_text, next), "<");
}

fn is_generic_constructor_at(
    source_text: []const u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    start: i64,
    end: i64
) -> !bool {
    if end + 1 >= tokens.len() {
        return false;
    }
    let open = try tokens.get(end + 1);
    if !std::mem::equal_bytes(token_text(source_text, open), "<") {
        return false;
    }
    let first = try tokens.get(start);
    let last = try tokens.get(end);
    let name = source_text[first.start..last.end];
    return std::mem::equal_bytes(name, "std::array::Array") or
        std::mem::equal_bytes(name, "std::map::Map") or
        std::mem::equal_bytes(name, "std::mem::Box") or
        std::mem::equal_bytes(name, "std::arena::Arena") or
        std::mem::equal_bytes(name, "std::arena::Handle");
}

pub fn unknown_type(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "unknown type");
}

