import selfhost::lexer;

pub enum SourceKind {
    Manifest,
    User,
    Std,
    Selfhost,
}

pub struct SourceFile {
    pub id: i64,
    pub kind: SourceKind,
    pub package_name: []u8,
    pub path: []u8,
    pub text: []u8,
}

pub struct PackageSummary {
    pub sources: i64,
    pub manifest_sources: i64,
    pub selfhost_sources: i64,
    pub std_sources: i64,
    pub diagnostics: i64,
    pub related: i64,
}

pub fn load_selfhost_package(
    allocator: Allocator,
    io: Io,
    root: []u8
) -> !PackageSummary {
    var files = try load_selfhost_sources(allocator, io, root);
    let manifest_sources = try count_kind(files, SourceKind::Manifest);
    let selfhost_sources = try count_kind(files, SourceKind::Selfhost);
    let std_sources = try count_kind(files, SourceKind::Std);
    let summary = summarize(
        files.len(),
        manifest_sources,
        selfhost_sources,
        std_sources,
        0,
        0
    );
    files.deinit();
    return summary;
}

pub fn load_selfhost_sources(
    allocator: Allocator,
    io: Io,
    root: []u8
) -> !std::array::Array<SourceFile> {
    var files = std::array::Array<SourceFile>(allocator);

    var manifest_path = try std::path::join(allocator, root, "kizu.toml");
    let manifest_bytes = manifest_path.as_bytes();
    let manifest_text = try std::fs::read_file(io, manifest_bytes);
    manifest_path.deinit();
    if !valid_manifest(manifest_text) {
        return error("invalid manifest");
    }
    let package_name = try manifest_package_name(manifest_text);
    try validate_manifest_module_root(allocator, io, root, manifest_text);
    try files.append(source_file(
        0,
        SourceKind::Manifest,
        package_name,
        "selfhost/kizu.toml",
        manifest_text
    ));
    var next_id = 1;

    var source_dir = try std::path::join(allocator, root, "src");
    let source_dir_path = source_dir.as_bytes();
    next_id = try append_selfhost_source_dir(files, io, source_dir_path, next_id, package_name);
    source_dir.deinit();

    next_id = try append_frontend_std_sources(files, io, next_id);
    return files;
}

pub fn load_package_sources(
    allocator: Allocator,
    io: Io,
    root: []u8
) -> !std::array::Array<SourceFile> {
    var files = std::array::Array<SourceFile>(allocator);

    var manifest_path = try std::path::join(allocator, root, "kizu.toml");
    let manifest_bytes = manifest_path.as_bytes();
    let manifest_text = try std::fs::read_file(io, manifest_bytes);
    manifest_path.deinit();
    if !valid_manifest(manifest_text) {
        return error("invalid manifest");
    }
    let package_name = try manifest_package_name(manifest_text);
    try validate_manifest_module_root(allocator, io, root, manifest_text);
    try files.append(source_file(0, SourceKind::Manifest, package_name, root, manifest_text));
    var next_id = 1;

    var source_dir = try std::path::join(allocator, root, "src");
    let source_dir_path = source_dir.as_bytes();
    let package_source_start = next_id;
    next_id = try append_selfhost_source_dir(files, io, source_dir_path, next_id, package_name);
    source_dir.deinit();

    next_id = try append_package_referenced_frontend_std_sources(
        allocator,
        files,
        io,
        next_id,
        package_source_start
    );
    return files;
}

pub fn load_file_sources(
    allocator: Allocator,
    io: Io,
    path: []u8,
    text: []u8
) -> !std::array::Array<SourceFile> {
    var files = std::array::Array<SourceFile>(allocator);
    if std::mem::len(module_path_for(SourceKind::User, path)) < 1 {
        return error("invalid module");
    }
    try files.append(source_file(0, SourceKind::User, "selfhost", path, text));
    try append_referenced_frontend_std_sources(allocator, files, io, 1, text);
    return files;
}

pub fn summarize(
    sources: i64,
    manifest_sources: i64,
    selfhost_sources: i64,
    std_sources: i64,
    diagnostics: i64,
    related: i64
) -> PackageSummary {
    return PackageSummary {
        sources: sources,
        manifest_sources: manifest_sources,
        selfhost_sources: selfhost_sources,
        std_sources: std_sources,
        diagnostics: diagnostics,
        related: related
    };
}

pub fn count_kind(
    files: &std::array::Array<SourceFile>,
    kind: SourceKind
) -> !i64 {
    var index = 0;
    var count = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind == kind {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

pub fn is_source_code(kind: SourceKind) -> bool {
    return kind != SourceKind::Manifest;
}

pub fn is_frontend_source(kind: SourceKind) -> bool {
    return kind == SourceKind::User or kind == SourceKind::Selfhost;
}

pub fn module_path(file: &SourceFile) -> []u8 borrows file {
    return module_path_for(file.kind, file.path);
}

pub fn append_module_path(
    out: &var std::string::String,
    file: &SourceFile
) -> !void {
    try append_module_path_text(out, module_path(file));
    return;
}

pub fn append_module_path_for(
    out: &var std::string::String,
    kind: SourceKind,
    path: []u8
) -> !void {
    try append_module_path_text(out, module_path_for(kind, path));
    return;
}

pub fn append_qualified_module_name(
    out: &var std::string::String,
    file: &SourceFile
) -> !void {
    try append_package_prefix(out, file);
    try out.append_bytes("::");
    try append_module_path(out, file);
    return;
}

pub fn append_package_prefix(
    out: &var std::string::String,
    file: &SourceFile
) -> !void {
    if file.kind == SourceKind::Std {
        try out.append_bytes("std");
        return;
    }
    if std::mem::len(file.package_name) > 0 {
        try out.append_bytes(file.package_name);
        return;
    }
    try out.append_bytes("selfhost");
    return;
}

pub fn is_absolute_name_for_file(file: &SourceFile, name: []u8) -> bool {
    return std::mem::starts_with(name, "std::") or
        std::mem::starts_with(name, "selfhost::") or
        starts_with_package_prefix(file, name);
}

pub fn starts_with_package_prefix(file: &SourceFile, name: []u8) -> bool {
    let package_name = file.package_name;
    let package_len = std::mem::len(package_name);
    if package_len < 1 {
        return false;
    }
    if std::mem::len(name) <= package_len + 2 {
        return false;
    }
    return std::mem::equal_bytes(name[0..package_len], package_name) and
        name[package_len] == cast<u8>(58) and
        name[package_len + 1] == cast<u8>(58);
}

pub fn strip_package_prefix(file: &SourceFile, name: []u8) -> []u8 borrows name {
    let package_name = file.package_name;
    let package_len = std::mem::len(package_name);
    if starts_with_package_prefix(file, name) {
        return name[package_len + 2..std::mem::len(name)];
    }
    return name;
}

pub fn append_module_path_text(
    out: &var std::string::String,
    module: []u8
) -> !void {
    var index = 0;
    while index < std::mem::len(module) {
        let byte = module[index];
        if byte == cast<u8>(47) {
            try out.append_bytes("::");
        } else {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    return;
}

pub fn span(
    source_id: i64,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    line: i64,
    column: i64
) -> std::kizu::diagnostic::FileSpan {
    return std::kizu::diagnostic::file_span(
        source_id,
        path,
        byte_start,
        byte_end,
        line,
        column
    );
}

pub fn missing_file(
    allocator: Allocator,
    path: []u8
) -> std::kizu::diagnostic::Diagnostic {
    let primary = span(0, path, 0, 0, 1, 1);
    return std::kizu::diagnostic::Diagnostic(allocator, primary, "missing file");
}

pub fn invalid_manifest(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    let primary = span(0, path, byte_start, byte_end, 1, byte_start + 1);
    return std::kizu::diagnostic::Diagnostic(allocator, primary, "invalid manifest");
}

pub fn duplicate_module(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    previous_path: []u8,
    previous_start: i64,
    previous_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    var report = std::kizu::diagnostic::Diagnostic(
        allocator,
        span(0, path, byte_start, byte_end, 1, byte_start + 1),
        "duplicate module"
    );
    try report.add_related(
        span(1, previous_path, previous_start, previous_end, 1, previous_start + 1),
        "previous module"
    );
    return report;
}

pub fn import_cycle(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    edge_path: []u8,
    edge_start: i64,
    edge_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    var report = std::kizu::diagnostic::Diagnostic(
        allocator,
        span(0, path, byte_start, byte_end, 1, byte_start + 1),
        "import cycle"
    );
    try report.add_related(
        span(1, edge_path, edge_start, edge_end, 1, edge_start + 1),
        "cycle edge"
    );
    return report;
}

fn append_std_source(
    files: &var std::array::Array<SourceFile>,
    io: Io,
    id: i64,
    path: []u8
) -> !void {
    let text = try std::fs::read_file(io, path);
    try files.append(source_file(id, SourceKind::Std, "std", path, text));
    return;
}

fn append_selfhost_source_dir(
    files: &var std::array::Array<SourceFile>,
    io: Io,
    dir: &[]u8,
    next_id: i64,
    package_name: []u8
) -> !i64 {
    var id = next_id;
    var entries = try std::fs::read_dir(io, dir);
    var index = 0;
    while index < entries.len() {
        let entry = try entries.get(index);
        if entry.is_dir {
            id = try append_selfhost_source_dir(
                files,
                io,
                entry.path,
                id,
                package_name
            );
        } else {
            if std::mem::equal_bytes(std::path::extension(entry.name), ".kizu") {
                if std::mem::len(module_path_for(SourceKind::Selfhost, entry.path)) < 1 {
                    return error("invalid module");
                }
                let text = try std::fs::read_file(io, entry.path);
                try files.append(source_file(id, SourceKind::Selfhost, package_name, entry.path, text));
                id = id + 1;
            }
        }
        index = index + 1;
    }
    entries.deinit();
    return id;
}

fn append_frontend_std_sources(
    files: &var std::array::Array<SourceFile>,
    io: Io,
    next_id: i64
) -> !i64 {
    var id = next_id;
    try append_std_source(files, io, id, "std/src/mem.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/array.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/string.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/map.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/fmt.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/testing.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/fs.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/path.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/io.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/process.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/kizu/ast.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/kizu/lexer.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/kizu/parser.kizu");
    id = id + 1;
    try append_std_source(files, io, id, "std/src/kizu/diagnostic.kizu");
    id = id + 1;
    return id;
}

fn append_referenced_frontend_std_sources(
    allocator: Allocator,
    files: &var std::array::Array<SourceFile>,
    io: Io,
    next_id: i64,
    text: []u8
) -> !i64 {
    var pending = std::array::Array<[]u8>(allocator);
    defer pending.deinit();
    var seen = std::map::Map<[]u8, bool>(allocator);
    defer seen.deinit();

    try queue_frontend_std_references(allocator, text, pending, seen);

    var id = next_id;
    var index = 0;
    while index < pending.len() {
        let path = try pending.get(index);
        let std_text = try std::fs::read_file(io, path);
        try files.append(source_file(id, SourceKind::Std, "std", path, std_text));
        id = id + 1;
        try queue_frontend_std_references(allocator, std_text, pending, seen);
        index = index + 1;
    }
    return id;
}

fn append_package_referenced_frontend_std_sources(
    allocator: Allocator,
    files: &var std::array::Array<SourceFile>,
    io: Io,
    next_id: i64,
    package_source_start: i64
) -> !i64 {
    var pending = std::array::Array<[]u8>(allocator);
    defer pending.deinit();
    var seen = std::map::Map<[]u8, bool>(allocator);
    defer seen.deinit();

    var source_index = package_source_start;
    while source_index < next_id {
        let file = try files.at(source_index);
        try queue_frontend_std_references(allocator, file.text, pending, seen);
        source_index = source_index + 1;
    }

    var id = next_id;
    var pending_index = 0;
    while pending_index < pending.len() {
        let path = try pending.get(pending_index);
        let std_text = try std::fs::read_file(io, path);
        try files.append(source_file(id, SourceKind::Std, "std", path, std_text));
        id = id + 1;
        try queue_frontend_std_references(allocator, std_text, pending, seen);
        pending_index = pending_index + 1;
    }
    return id;
}

fn queue_frontend_std_references(
    allocator: Allocator,
    text: []u8,
    pending: &var std::array::Array<[]u8>,
    seen: &var std::map::Map<[]u8, bool>
) -> !void {
    var tokens = try lexer::tokenize(allocator, text);
    defer tokens.deinit();

    var index = 0;
    while index + 2 < tokens.len() {
        let first = try tokens.get(index);
        let separator = try tokens.get(index + 1);
        let module = try tokens.get(index + 2);
        if is_ident_text(text, first, "std") and is_double_colon(separator) and
            is_ident(module) {
            try queue_frontend_std_reference(text, &tokens, index + 2, pending, seen);
        }
        index = index + 1;
    }
    return;
}

fn queue_frontend_std_reference(
    text: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    module_index: i64,
    pending: &var std::array::Array<[]u8>,
    seen: &var std::map::Map<[]u8, bool>
) -> !void {
    let module = try tokens.get(module_index);
    let module_text = lexer::token_text(text, module);
    var submodule_text = "";
    if std::mem::equal_bytes(module_text, "kizu") and module_index + 2 < tokens.len() {
        let separator = try tokens.get(module_index + 1);
        let submodule = try tokens.get(module_index + 2);
        if is_double_colon(separator) and is_ident(submodule) {
            submodule_text = lexer::token_text(text, submodule);
        }
    }
    let path = frontend_std_source_path(module_text, submodule_text);
    if std::mem::equal_bytes(path, "") {
        return;
    }
    if seen.contains(path) {
        return;
    }
    try seen.insert(path, true);
    try pending.append(path);
    return;
}

fn frontend_std_source_path(module: []u8, submodule: []u8) -> []u8 {
    if std::mem::equal_bytes(module, "mem") {
        return "std/src/mem.kizu";
    }
    if std::mem::equal_bytes(module, "array") {
        return "std/src/array.kizu";
    }
    if std::mem::equal_bytes(module, "string") {
        return "std/src/string.kizu";
    }
    if std::mem::equal_bytes(module, "map") {
        return "std/src/map.kizu";
    }
    if std::mem::equal_bytes(module, "fmt") {
        return "std/src/fmt.kizu";
    }
    if std::mem::equal_bytes(module, "testing") {
        return "std/src/testing.kizu";
    }
    if std::mem::equal_bytes(module, "fs") {
        return "std/src/fs.kizu";
    }
    if std::mem::equal_bytes(module, "path") {
        return "std/src/path.kizu";
    }
    if std::mem::equal_bytes(module, "io") {
        return "std/src/io.kizu";
    }
    if std::mem::equal_bytes(module, "process") {
        return "std/src/process.kizu";
    }
    return frontend_kizu_std_source_path(module, submodule);
}

fn frontend_kizu_std_source_path(module: []u8, submodule: []u8) -> []u8 {
    if !std::mem::equal_bytes(module, "kizu") {
        return "";
    }
    if std::mem::equal_bytes(submodule, "ast") {
        return "std/src/kizu/ast.kizu";
    }
    if std::mem::equal_bytes(submodule, "lexer") {
        return "std/src/kizu/lexer.kizu";
    }
    if std::mem::equal_bytes(submodule, "parser") {
        return "std/src/kizu/parser.kizu";
    }
    if std::mem::equal_bytes(submodule, "diagnostic") {
        return "std/src/kizu/diagnostic.kizu";
    }
    return "";
}

fn is_ident(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        _ => false,
    };
}

fn is_ident_text(text: []u8, token: std::kizu::lexer::Token, expected: []u8) -> bool {
    if !is_ident(token) {
        return false;
    }
    return std::mem::equal_bytes(lexer::token_text(text, token), expected);
}

fn is_double_colon(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        DoubleColon => true,
        _ => false,
    };
}

fn source_file(
    id: i64,
    kind: SourceKind,
    package_name: []u8,
    path: []u8,
    text: []u8
) -> SourceFile {
    return SourceFile {
        id: id,
        kind: kind,
        package_name: package_name,
        path: path,
        text: text
    };
}

fn valid_manifest(text: []u8) -> bool {
    return std::mem::starts_with(text, "[package]");
}

fn manifest_package_name(text: []u8) -> ![]u8 borrows text {
    return try manifest_quoted_marker_value(text, "name = ");
}

fn manifest_module_root(text: []u8) -> ![]u8 borrows text {
    let root = try manifest_quoted_marker_value(text, "root = ");
    if std::mem::len(root) < 1 {
        return error("invalid manifest");
    }
    return root;
}

fn validate_manifest_module_root(
    allocator: Allocator,
    io: Io,
    root: []u8,
    manifest_text: []u8
) -> !void {
    let module_root = try manifest_module_root(manifest_text);
    var root_path = try std::path::join(allocator, root, module_root);
    let root_path_bytes = root_path.as_bytes();
    let root_exists = try std::fs::exists(io, root_path_bytes);
    root_path.deinit();
    if !root_exists {
        return error("missing module root");
    }
    return;
}

fn manifest_quoted_marker_value(text: []u8, marker: []u8) -> ![]u8 borrows text {
    let marker_len = std::mem::len(marker);
    var index = 0;
    while index + marker_len <= std::mem::len(text) {
        if std::mem::equal_bytes(text[index..index + marker_len], marker) {
            let quote = index + marker_len;
            if quote >= std::mem::len(text) or text[quote] != cast<u8>(34) {
                return error("invalid manifest");
            }
            let start = quote + 1;
            var end = start;
            while end < std::mem::len(text) {
                if text[end] == cast<u8>(34) {
                    return text[start..end];
                }
                end = end + 1;
            }
            return error("invalid manifest");
        }
        index = index + 1;
    }
    return error("invalid manifest");
}

fn module_name(file_name: []u8) -> []u8 borrows file_name {
    let length = std::mem::len(file_name);
    if length > 5 and std::mem::equal_bytes(file_name[length - 5..length], ".kizu") {
        return file_name[0..length - 5];
    }
    return file_name;
}

fn module_path_for(kind: SourceKind, path: []u8) -> []u8 borrows path {
    if kind == SourceKind::Manifest {
        return "manifest";
    }
    if kind == SourceKind::Std {
        return path_after_prefix(path, "std/src");
    }
    if kind == SourceKind::Selfhost {
        return package_module_path(path);
    }
    return module_name(std::path::basename(path));
}

fn package_module_path(path: []u8) -> []u8 borrows path {
    let start = package_src_module_start(path);
    if start < 0 {
        return module_name(std::path::basename(path));
    }
    return strip_kizu_suffix(path[start..std::mem::len(path)]);
}

fn package_src_module_start(path: []u8) -> i64 {
    let length = std::mem::len(path);
    var index = 0;
    var result = -1;
    while index + 4 <= length {
        if path_src_segment_at(path, index) {
            result = index + 4;
        }
        index = index + 1;
    }
    return result;
}

fn path_src_segment_at(path: []u8, index: i64) -> bool {
    if index > 0 and path[index - 1] != cast<u8>(47) {
        return false;
    }
    return std::mem::equal_bytes(path[index..index + 4], "src/");
}

fn strip_kizu_suffix(path: []u8) -> []u8 borrows path {
    let length = std::mem::len(path);
    if length > 5 and std::mem::equal_bytes(path[length - 5..length], ".kizu") {
        return path[0..length - 5];
    }
    return path;
}

fn path_after_prefix(path: []u8, prefix: []u8) -> []u8 borrows path {
    var start = std::mem::len(prefix);
    let length = std::mem::len(path);
    if start < length and path[start] == cast<u8>(47) {
        start = start + 1;
    }
    var end = length;
    if end > start + 5 and std::mem::equal_bytes(path[end - 5..end], ".kizu") {
        end = end - 5;
    }
    return path[start..end];
}
