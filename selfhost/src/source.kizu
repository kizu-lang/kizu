import selfhost::source::diagnostics;
import selfhost::source::manifest;

pub enum SourceKind {
    Manifest,
    User,
    Std,
    Selfhost,
}

pub struct SourceFile {
    pub id: i64,
    pub kind: SourceKind,
    pub package_name: []u8,
    pub module_start: i64,
    pub module_end: i64,
    pub path: []u8,
    pub text: []u8,
}

pub struct PackageSummary {
    pub sources: i64,
    pub manifest_sources: i64,
    pub selfhost_sources: i64,
    pub std_sources: i64,
    pub diagnostics: i64,
    pub related: i64,
}

pub fn summarize(
    sources: i64,
    manifest_sources: i64,
    selfhost_sources: i64,
    std_sources: i64,
    diagnostics: i64,
    related: i64
) -> PackageSummary {
    return PackageSummary {
        sources: sources,
        manifest_sources: manifest_sources,
        selfhost_sources: selfhost_sources,
        std_sources: std_sources,
        diagnostics: diagnostics,
        related: related
    };
}

pub fn count_kind(
    files: &std::array::Array<SourceFile>,
    kind: SourceKind
) -> !i64 {
    var index = 0;
    var count = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind == kind {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

pub fn is_source_code(kind: SourceKind) -> bool {
    return kind != SourceKind::Manifest;
}

pub fn is_frontend_source(kind: SourceKind) -> bool {
    return kind == SourceKind::User or kind == SourceKind::Selfhost;
}

pub fn module_path(file: &SourceFile) -> []u8 borrows file {
    if file.kind == SourceKind::Manifest {
        return "manifest";
    }
    return file.path[file.module_start..file.module_end];
}

pub fn append_module_path(
    out: &var std::string::String,
    file: &SourceFile
) -> !void {
    try append_module_path_text(out, module_path(file));
    return;
}

pub fn append_qualified_module_name(
    out: &var std::string::String,
    file: &SourceFile
) -> !void {
    try append_package_prefix(out, file);
    let module = module_path(file);
    if std::mem::len(module) > 0 {
        try out.append_bytes("::");
        try append_module_path_text(out, module);
    }
    return;
}

pub fn append_package_prefix(
    out: &var std::string::String,
    file: &SourceFile
) -> !void {
    if file.kind == SourceKind::Std {
        try out.append_bytes("std");
        return;
    }
    if std::mem::len(file.package_name) > 0 {
        try out.append_bytes(file.package_name);
        return;
    }
    try out.append_bytes("selfhost");
    return;
}

// first_path_separator returns the offset of a qualified name's first '::', or -1 when the name
// has a single segment. The separator's own spacing is insignificant -- 'std::testing::expect'
// and 'std :: testing :: expect' name the same path -- so every prefix question below is asked
// about the first segment rather than about a leading substring of the raw text.
pub fn first_path_separator(name: []u8) -> i64 {
    let length = std::mem::len(name);
    var index = 0;
    while index + 1 < length {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// first_path_segment returns a qualified name's leading segment without the whitespace that may
// surround it.
pub fn first_path_segment(name: []u8) -> []u8 borrows name {
    let separator = first_path_separator(name);
    if separator < 0 {
        return std::mem::trim_ascii(name);
    }
    return std::mem::trim_ascii(name[0..separator]);
}

pub fn is_absolute_name_for_file(file: &SourceFile, name: []u8) -> bool {
    if first_path_separator(name) >= 0 {
        let head = first_path_segment(name);
        if std::mem::equal_bytes(head, "std") or std::mem::equal_bytes(head, "selfhost") {
            return true;
        }
    }
    return starts_with_package_prefix(file, name);
}

pub fn starts_with_package_prefix(file: &SourceFile, name: []u8) -> bool {
    let package_name = file.package_name;
    if std::mem::len(package_name) < 1 {
        return false;
    }
    return std::mem::equal_bytes(first_path_segment(name), package_name);
}

pub fn strip_package_prefix(file: &SourceFile, name: []u8) -> []u8 borrows name {
    if !starts_with_package_prefix(file, name) {
        return name;
    }
    let separator = first_path_separator(name);
    if separator < 0 {
        return "";
    }
    return std::mem::trim_ascii(name[separator + 2..std::mem::len(name)]);
}

pub fn append_module_path_text(
    out: &var std::string::String,
    module: []u8
) -> !void {
    var index = 0;
    while index < std::mem::len(module) {
        let byte = module[index];
        if byte == cast<u8>(47) {
            try out.append_bytes("::");
        } else {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    return;
}

pub fn span(
    source_id: i64,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    line: i64,
    column: i64
) -> std::kizu::diagnostic::FileSpan {
    return diagnostics::span(
        source_id,
        path,
        byte_start,
        byte_end,
        line,
        column
    );
}

pub fn missing_file(
    allocator: Allocator,
    path: []u8
) -> std::kizu::diagnostic::Diagnostic {
    return diagnostics::missing_file(allocator, path);
}

pub fn invalid_manifest(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return diagnostics::invalid_manifest(allocator, path, byte_start, byte_end);
}

pub fn duplicate_module(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    previous_path: []u8,
    previous_start: i64,
    previous_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    return try diagnostics::duplicate_module(
        allocator,
        path,
        byte_start,
        byte_end,
        previous_path,
        previous_start,
        previous_end
    );
}

pub fn import_cycle(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    edge_path: []u8,
    edge_start: i64,
    edge_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    return try diagnostics::import_cycle(
        allocator,
        path,
        byte_start,
        byte_end,
        edge_path,
        edge_start,
        edge_end
    );
}

pub fn is_manifest_text(text: []u8) -> bool {
    return manifest::is_manifest_text(text);
}
