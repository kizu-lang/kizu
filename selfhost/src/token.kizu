pub enum TokenKind {
    Ident
    Number
    Eof
}

pub struct Token {
    pub kind: TokenKind;
    pub start: i64;
    pub end: i64;
}

pub fn eof() -> Token {
    return Token {
        kind: TokenKind::Eof,
        start: 0,
        end: 0
    };
}

pub fn span_len(token: Token) -> i64 {
    return token.end - token.start;
}
