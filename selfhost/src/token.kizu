// Module: token definitions for the future self-host compiler frontend.

pub enum TokenKind {
    Illegal
    Eof
    Ident
}

pub struct Token {
    pub kind: TokenKind;
    pub start: i64;
    pub end: i64;
    pub line: i64;
    pub column: i64;
}

// ready exposes a minimal public surface until token logic is ported.
pub fn ready() -> bool {
    return true;
}
