pub enum Type {
    Amp
    And
    Arrow
    Assign
    Asterisk
    Bang
    Break
    Colon
    Comma
    Comptime
    Continue
    Contract
    Dot
    DoubleColon
    EOF
    Else
    Enum
    Eq
    Extern
    False
    FatArrow
    For
    Function
    GT
    GTE
    Ident
    If
    Illegal
    Impl
    Import
    Int
    LBrace
    LBracket
    LParen
    LT
    LTE
    Let
    Match
    Minus
    Mut
    NotEq
    Or
    Percent
    Pipe
    Plus
    Public
    Question
    RBrace
    RBracket
    RParen
    Range
    Return
    Satisfy
    Semicolon
    Slash
    String
    Struct
    True
    Try
    Union
    Unsafe
    Var
    While
}

pub struct Token {
    pub Type: Type
    pub Literal: []const u8
    pub Line: i64
    pub Column: i64
}

pub fn LookupIdent(ident: []const u8) -> Type {
    if ident == "and" {
        return Type::And;
    }
    if ident == "break" {
        return Type::Break;
    }
    if ident == "comptime" {
        return Type::Comptime;
    }
    if ident == "continue" {
        return Type::Continue;
    }
    if ident == "contract" {
        return Type::Contract;
    }
    if ident == "else" {
        return Type::Else;
    }
    if ident == "enum" {
        return Type::Enum;
    }
    if ident == "extern" {
        return Type::Extern;
    }
    if ident == "false" {
        return Type::False;
    }
    if ident == "fn" {
        return Type::Function;
    }
    if ident == "for" {
        return Type::For;
    }
    if ident == "if" {
        return Type::If;
    }
    if ident == "impl" {
        return Type::Impl;
    }
    if ident == "import" {
        return Type::Import;
    }
    if ident == "let" {
        return Type::Let;
    }
    if ident == "match" {
        return Type::Match;
    }
    if ident == "mut" {
        return Type::Mut;
    }
    if ident == "or" {
        return Type::Or;
    }
    if ident == "pub" {
        return Type::Public;
    }
    if ident == "return" {
        return Type::Return;
    }
    if ident == "satisfy" {
        return Type::Satisfy;
    }
    if ident == "struct" {
        return Type::Struct;
    }
    if ident == "true" {
        return Type::True;
    }
    if ident == "try" {
        return Type::Try;
    }
    if ident == "union" {
        return Type::Union;
    }
    if ident == "unsafe" {
        return Type::Unsafe;
    }
    if ident == "var" {
        return Type::Var;
    }
    if ident == "while" {
        return Type::While;
    }
    return Type::Ident;
}

pub fn EOFToken() -> Token {
    return Token {
        Type: Type::EOF,
        Literal: "",
        Line: 0,
        Column: 0,
    };
}

pub fn New(kind: Type, literal: []const u8, line: i64, column: i64) -> Token {
    return Token {
        Type: kind,
        Literal: literal,
        Line: line,
        Column: column,
    };
}
