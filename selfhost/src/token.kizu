// Module: token definitions for the future self-host compiler frontend.

pub enum TokenKind {
    Illegal
    Eof
    Ident
    Number
    String
    Assign
    Plus
    Minus
    Bang
    Question
    Amp
    Asterisk
    Slash
    Percent
    Eq
    FatArrow
    NotEq
    LT
    LTE
    GT
    GTE
    Arrow
    Dot
    Range
    DoubleColon
    Comma
    Colon
    Semicolon
    Pipe
    LParen
    RParen
    LBrace
    RBrace
    LBracket
    RBracket
    Import
    Public
    Fn
    Let
    Var
    Return
    If
    Else
    While
    Break
    Continue
    Match
    Struct
    Enum
    Union
    Contract
    Satisfy
    For
    Impl
    True
    False
    Mut
    Unsafe
    Extern
    Comptime
    Try
}

pub struct Token {
    pub kind: TokenKind;
    pub literal: []const u8;
    pub start: i64;
    pub end: i64;
    pub line: i64;
    pub column: i64;
}

// kind_name returns the stable snapshot name for one token kind.
pub fn kind_name(kind: TokenKind) -> []const u8 {
    let core = core_kind_name(kind);
    if std::mem::len(core) > 0 {
        return core;
    }
    let operator = operator_kind_name(kind);
    if std::mem::len(operator) > 0 {
        return operator;
    }
    let punctuation = punctuation_kind_name(kind);
    if std::mem::len(punctuation) > 0 {
        return punctuation;
    }
    return keyword_kind_name(kind);
}

// core_kind_name returns stable names for scalar token kinds.
fn core_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::Illegal {
        return "token.TokenKind::Illegal";
    }
    if kind == TokenKind::Eof {
        return "token.TokenKind::Eof";
    }
    if kind == TokenKind::Ident {
        return "token.TokenKind::Ident";
    }
    if kind == TokenKind::Number {
        return "token.TokenKind::Number";
    }
    if kind == TokenKind::String {
        return "token.TokenKind::String";
    }
    return "";
}

// operator_kind_name returns stable names for operator token kinds.
fn operator_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::Assign {
        return "token.TokenKind::Assign";
    }
    if kind == TokenKind::Plus {
        return "token.TokenKind::Plus";
    }
    if kind == TokenKind::Minus {
        return "token.TokenKind::Minus";
    }
    if kind == TokenKind::Bang {
        return "token.TokenKind::Bang";
    }
    if kind == TokenKind::Question {
        return "token.TokenKind::Question";
    }
    if kind == TokenKind::Amp {
        return "token.TokenKind::Amp";
    }
    if kind == TokenKind::Asterisk {
        return "token.TokenKind::Asterisk";
    }
    if kind == TokenKind::Slash {
        return "token.TokenKind::Slash";
    }
    if kind == TokenKind::Percent {
        return "token.TokenKind::Percent";
    }
    return comparison_kind_name(kind);
}

// comparison_kind_name returns stable names for comparison token kinds.
fn comparison_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::Eq {
        return "token.TokenKind::Eq";
    }
    if kind == TokenKind::FatArrow {
        return "token.TokenKind::FatArrow";
    }
    if kind == TokenKind::NotEq {
        return "token.TokenKind::NotEq";
    }
    if kind == TokenKind::LT {
        return "token.TokenKind::LT";
    }
    if kind == TokenKind::LTE {
        return "token.TokenKind::LTE";
    }
    if kind == TokenKind::GT {
        return "token.TokenKind::GT";
    }
    if kind == TokenKind::GTE {
        return "token.TokenKind::GTE";
    }
    if kind == TokenKind::Arrow {
        return "token.TokenKind::Arrow";
    }
    return namespace_kind_name(kind);
}

// namespace_kind_name returns stable names for dotted token kinds.
fn namespace_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::Dot {
        return "token.TokenKind::Dot";
    }
    if kind == TokenKind::Range {
        return "token.TokenKind::Range";
    }
    if kind == TokenKind::DoubleColon {
        return "token.TokenKind::DoubleColon";
    }
    return "";
}

// punctuation_kind_name returns stable names for delimiter token kinds.
fn punctuation_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::Comma {
        return "token.TokenKind::Comma";
    }
    if kind == TokenKind::Colon {
        return "token.TokenKind::Colon";
    }
    if kind == TokenKind::Semicolon {
        return "token.TokenKind::Semicolon";
    }
    if kind == TokenKind::Pipe {
        return "token.TokenKind::Pipe";
    }
    return bracket_kind_name(kind);
}

// bracket_kind_name returns stable names for grouping token kinds.
fn bracket_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::LParen {
        return "token.TokenKind::LParen";
    }
    if kind == TokenKind::RParen {
        return "token.TokenKind::RParen";
    }
    if kind == TokenKind::LBrace {
        return "token.TokenKind::LBrace";
    }
    if kind == TokenKind::RBrace {
        return "token.TokenKind::RBrace";
    }
    if kind == TokenKind::LBracket {
        return "token.TokenKind::LBracket";
    }
    if kind == TokenKind::RBracket {
        return "token.TokenKind::RBracket";
    }
    return "";
}

// keyword_kind_name returns stable names for keyword token kinds.
fn keyword_kind_name(kind: TokenKind) -> []const u8 {
    let control = control_keyword_kind_name(kind);
    if std::mem::len(control) > 0 {
        return control;
    }
    let declaration = declaration_keyword_kind_name(kind);
    if std::mem::len(declaration) > 0 {
        return declaration;
    }
    return modifier_keyword_kind_name(kind);
}

// control_keyword_kind_name returns names for control and binding keywords.
fn control_keyword_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::Import {
        return "token.TokenKind::Import";
    }
    if kind == TokenKind::Public {
        return "token.TokenKind::Public";
    }
    if kind == TokenKind::Fn {
        return "token.TokenKind::Fn";
    }
    if kind == TokenKind::Let {
        return "token.TokenKind::Let";
    }
    if kind == TokenKind::Var {
        return "token.TokenKind::Var";
    }
    if kind == TokenKind::Return {
        return "token.TokenKind::Return";
    }
    if kind == TokenKind::If {
        return "token.TokenKind::If";
    }
    if kind == TokenKind::Else {
        return "token.TokenKind::Else";
    }
    if kind == TokenKind::While {
        return "token.TokenKind::While";
    }
    return loop_keyword_kind_name(kind);
}

// loop_keyword_kind_name returns names for loop-control keywords.
fn loop_keyword_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::Break {
        return "token.TokenKind::Break";
    }
    if kind == TokenKind::Continue {
        return "token.TokenKind::Continue";
    }
    if kind == TokenKind::Match {
        return "token.TokenKind::Match";
    }
    return "";
}

// declaration_keyword_kind_name returns names for declaration keywords.
fn declaration_keyword_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::Struct {
        return "token.TokenKind::Struct";
    }
    if kind == TokenKind::Enum {
        return "token.TokenKind::Enum";
    }
    if kind == TokenKind::Union {
        return "token.TokenKind::Union";
    }
    if kind == TokenKind::Contract {
        return "token.TokenKind::Contract";
    }
    if kind == TokenKind::Satisfy {
        return "token.TokenKind::Satisfy";
    }
    if kind == TokenKind::For {
        return "token.TokenKind::For";
    }
    if kind == TokenKind::Impl {
        return "token.TokenKind::Impl";
    }
    return "";
}

// modifier_keyword_kind_name returns names for value and modifier keywords.
fn modifier_keyword_kind_name(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::True {
        return "token.TokenKind::True";
    }
    if kind == TokenKind::False {
        return "token.TokenKind::False";
    }
    if kind == TokenKind::Mut {
        return "token.TokenKind::Mut";
    }
    if kind == TokenKind::Unsafe {
        return "token.TokenKind::Unsafe";
    }
    if kind == TokenKind::Extern {
        return "token.TokenKind::Extern";
    }
    if kind == TokenKind::Comptime {
        return "token.TokenKind::Comptime";
    }
    if kind == TokenKind::Try {
        return "token.TokenKind::Try";
    }
    return "";
}

// ready exposes the token module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
