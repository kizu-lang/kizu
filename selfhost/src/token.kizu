// Module: token definitions for the future self-host compiler frontend.

pub enum TokenKind {
    Illegal
    Eof
    Ident
    Number
    String
    Assign
    Plus
    Minus
    Bang
    Question
    Amp
    Asterisk
    Slash
    Percent
    Eq
    FatArrow
    NotEq
    LT
    LTE
    GT
    GTE
    Arrow
    Dot
    Range
    DoubleColon
    Comma
    Colon
    Semicolon
    Pipe
    LParen
    RParen
    LBrace
    RBrace
    LBracket
    RBracket
    Import
    Public
    Fn
    Let
    Var
    Return
    If
    Else
    While
    Break
    Continue
    Match
    Struct
    Enum
    Union
    Contract
    Satisfy
    For
    Impl
    True
    False
    Mut
    Unsafe
    Extern
    Comptime
    Try
}

pub struct Token {
    pub kind: TokenKind;
    pub literal: []const u8;
    pub start: i64;
    pub end: i64;
    pub line: i64;
    pub column: i64;
}

// ready exposes the token module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
