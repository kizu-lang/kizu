// function_is_selfhost_package_target_body identifies the CLI package predicate.
fn function_is_selfhost_package_target_body(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost") {
        return false;
    }
    return std::mem::equal_bytes(name, "is_selfhost_package_target");
}

// function_is_compile_command_wrapper identifies source-to-command wrappers.
fn function_is_compile_command_wrapper(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost::compiler") {
        return false;
    }
    if std::mem::equal_bytes(name, "check_source") {
        return true;
    }
    return std::mem::equal_bytes(name, "build_source");
}

// function_is_compile_source_body identifies the source report constructor.
fn function_is_compile_source_body(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost::compiler") {
        return false;
    }
    return std::mem::equal_bytes(name, "compile_source");
}

// function_is_lex_and_parse_source_body identifies the frontend report body.
fn function_is_lex_and_parse_source_body(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost::compiler") {
        return false;
    }
    return std::mem::equal_bytes(name, "lex_and_parse_source");
}

// function_is_parser_parse_token_stream_body identifies parser summary lowering.
fn function_is_parser_parse_token_stream_body(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost::parser") {
        return false;
