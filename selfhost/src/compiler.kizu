// Module: compiler pipeline boundary for the future self-host compiler.

import selfhost::ast;
import selfhost::backend;
import selfhost::ir;
import selfhost::lexer;
import selfhost::ownership;
import selfhost::parser;
import selfhost::resolver;
import selfhost::token;
import selfhost::types;

pub enum CompileStatus {
    Pass
    Fail
}

pub struct CompileReport {
    pub status: CompileStatus;
    pub token_count: i64;
    pub function_count: i64;
    pub type_count: i64;
    pub ownership_checks: i64;
    pub ir_function_count: i64;
    pub backend_emitted: bool;
    pub diagnostic: []const u8;
}

pub struct FrontendReport {
    pub token_count: i64;
    pub first_kind: token::TokenKind;
    pub eof_kind: token::TokenKind;
    pub function_count: i64;
    pub import_count: i64;
    pub struct_count: i64;
    pub enum_count: i64;
    pub union_count: i64;
    pub return_count: i64;
}

pub struct SourceModule {
    pub path: []const u8;
    pub source: []const u8;
    pub is_root: bool;
    pub is_test: bool;
}

pub struct PackageManifest {
    pub package_root: []const u8;
    pub root_file: []const u8;
}

pub struct ModuleSpec {
    pub path: []const u8;
    pub file: []const u8;
}

pub struct PackageReport {
    pub status: CompileStatus;
    pub module_count: i64;
    pub compiled_module_count: i64;
    pub token_count: i64;
    pub function_count: i64;
    pub import_count: i64;
    pub type_count: i64;
    pub ownership_checks: i64;
    pub ir_function_count: i64;
    pub backend_emitted: bool;
    pub root_found: bool;
    pub diagnostic: []const u8;
}

pub struct CommandReport {
    pub command: []const u8;
    pub target: []const u8;
    pub status: CompileStatus;
    pub backend_emitted: bool;
    pub diagnostic: []const u8;
}

// status_name returns the CLI spelling for a compile status.
pub fn status_name(status: CompileStatus) -> []const u8 {
    if status == CompileStatus::Pass {
        return "pass";
    }
    return "fail";
}

// compile_source runs the self-host phase order over one source buffer.
pub fn compile_source(source: []const u8, target_name: []const u8) -> !CompileReport {
    let frontend = try lex_and_parse_source(source);
    let parsed = ast::ParseSummary {
        function_count: frontend.function_count,
        import_count: frontend.import_count,
        struct_count: frontend.struct_count,
        enum_count: frontend.enum_count,
        union_count: frontend.union_count,
        return_count: frontend.return_count,
    };
    let typed = try type_summary(&parsed);
    let ownership_report = ownership_summary(&typed);
    let lowered = ir::module(parsed.function_count, parsed.function_count, parsed.return_count);
    let target_info = backend::target(target_name);
    let artifact = backend::artifact(
        &target_info,
        lowered.function_count,
        lowered.instruction_count
    );

    return CompileReport {
        status: CompileStatus::Pass,
        token_count: frontend.token_count,
        function_count: parsed.function_count,
        type_count: typed.type_count,
        ownership_checks: ownership_report.check_count,
        ir_function_count: lowered.function_count,
        backend_emitted: artifact.emitted,
        diagnostic: "",
    };
}

// check_source runs the CLI check path over one source buffer.
pub fn check_source(source: []const u8) -> !CommandReport {
    let report = try compile_source(source, "llvm");
    return command_report("check", "llvm", report);
}

// build_source runs the CLI build path over one source buffer and target.
pub fn build_source(source: []const u8, target_name: []const u8) -> !CommandReport {
    let report = try compile_source(source, target_name);
    return command_report("build", target_name, report);
}

// command_report converts a compile report into CLI-facing command facts.
fn command_report(
    command: []const u8,
    target_name: []const u8,
    report: CompileReport
) -> CommandReport {
    return CommandReport {
        command: command,
        target: target_name,
        status: report.status,
        backend_emitted: report.backend_emitted,
        diagnostic: report.diagnostic,
    };
}

// lex_and_parse_source runs the Kizu-native lexer token stream into the parser.
pub fn lex_and_parse_source(source: []const u8) -> !FrontendReport {
    var tokens = try lexer::lex(source);
    token::ready();
    let parsed = try parser::parse_token_stream(tokens);
    let first = try tokens.at(0);
    let eof = try tokens.at(tokens.len() - 1);

    return FrontendReport {
        token_count: tokens.len(),
        first_kind: first.kind,
        eof_kind: eof.kind,
        function_count: parsed.function_count,
        import_count: parsed.import_count,
        struct_count: parsed.struct_count,
        enum_count: parsed.enum_count,
        union_count: parsed.union_count,
        return_count: parsed.return_count,
    };
}

// lex_file_snapshot prints Kizu-owned lexer facts for one process argument path.
pub fn lex_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try print_token_snapshot(source);
    return void;
}

// print_token_snapshot writes the complete Kizu lexer token stream.
pub fn print_token_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    var index = 0;

    print("selfhost lexer token snapshots");
    while index < tokens.len() {
        let current = try tokens.at(index);
        print(token::kind_name(current.kind));
        print(current.literal);
        print(current.start);
        print(current.end);
        print(current.line);
        print(current.column);
        index = index + 1;
    }
    print("selfhost lexer token snapshots end");
    return void;
}

// parse_file_snapshot prints Kizu-owned parser facts for one process argument path.
pub fn parse_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try print_parser_snapshot(source);
    return void;
}

// resolve_file_snapshot prints Kizu-owned resolver facts for one source path.
pub fn resolve_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try resolver::print_module_graph_snapshot(source);
    try resolver::print_resolver_diagnostic_snapshot(source, path);
    return void;
}

// type_file_snapshot prints Kizu-owned type checker facts for one source path.
pub fn type_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try types::print_type_snapshot(source);
    try types::print_type_env_snapshot(source);
    try types::print_type_check_snapshot(source);
    return void;
}

// print_parser_snapshot writes selected parser AST facts, spans, and diagnostics.
pub fn print_parser_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    let declarations = try parser::parse_declarations(tokens);
    var index = 0;

    print("selfhost parser declaration snapshots");
    while index < declarations.len() {
        let current = try declarations.at(index);
        print(ast_node_kind_name(current.kind));
        print(current.name);
        print(current.span.start);
        print(current.span.end);
        print(current.span.line);
        print(current.span.column);
        index = index + 1;
    }
    print("selfhost parser declaration snapshots end");
    try parser::print_detail_snapshot(tokens);
    return void;
}

// ast_node_kind_name returns stable parser snapshot names for declaration kinds.
fn ast_node_kind_name(kind: ast::NodeKind) -> []const u8 {
    if kind == ast::NodeKind::Import {
        return "ImportDecl";
    }
    if kind == ast::NodeKind::Function {
        return "FunctionDecl";
    }
    if kind == ast::NodeKind::Struct {
        return "StructDecl";
    }
    if kind == ast::NodeKind::Enum {
        return "EnumDecl";
    }
    if kind == ast::NodeKind::Union {
        return "UnionDecl";
    }
    if kind == ast::NodeKind::Contract {
        return "ContractDecl";
    }
    if kind == ast::NodeKind::Impl {
        return "ImplDecl";
    }
    if kind == ast::NodeKind::Satisfy {
        return "SatisfyDecl";
    }
    return "UnknownDecl";
}

// compile_package runs the self-host package pipeline over explicit sources.
pub fn compile_package(
    modules: &std::array::Array<SourceModule>,
    target_name: []const u8
) -> !PackageReport {
    var report = empty_package_report();
    var index = 0;

    while index < modules.len() {
        let module = try modules.at(index);
        report.module_count = report.module_count + 1;
        if module_is_root(&module) {
            report.root_found = true;
        }
        if !module.is_test {
            let next = try compile_package_module(&module);
            report = merge_package_report(report, &next);
        }
        index = index + 1;
    }
    return finish_package_report(report, target_name);
}

// compile_self_check compiles the checked-in self-host package from files.
pub fn compile_self_check() -> !PackageReport {
    return try compile_selfhost_package_check();
}

// compile_selfhost_package_check keeps the old entry name on the file-backed path.
pub fn compile_selfhost_package_check() -> !PackageReport {
    let io = std::io::blocking();
    return try compile_selfhost_package_from_files(io);
}

// compile_selfhost_package_from_files loads the checked-in package through std::fs.
pub fn compile_selfhost_package_from_files(io: Io) -> !PackageReport {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    return try compile_package(&modules, "llvm");
}

// load_selfhost_package_from_files validates filesystem-backed package discovery.
pub fn load_selfhost_package_from_files(io: Io) -> !PackageReport {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    return try summarize_loaded_package(&modules);
}

// append_manifest_modules loads compiler modules described by the manifest roots.
fn append_manifest_modules(
    io: Io,
    manifest: &PackageManifest,
    modules: &mut std::array::Array<SourceModule>
) -> !void {
    let allocator = std::mem::page_allocator();
    var specs = std::array::Array<ModuleSpec>(allocator);
    try append_selfhost_module_specs(specs);

    var index = 0;
    while index < specs.len() {
        let spec = try specs.at(index);
        try modules.append(try read_manifest_module(io, manifest, &spec));
        index = index + 1;
    }
    return void;
}

// append_selfhost_module_specs records the current checked-in compiler modules.
fn append_selfhost_module_specs(modules: &mut std::array::Array<ModuleSpec>) -> !void {
    try modules.append(module_spec("selfhost::main", "main.kizu"));
    try modules.append(module_spec("selfhost::ast", "ast.kizu"));
    try modules.append(module_spec("selfhost::backend", "backend.kizu"));
    try modules.append(module_spec("selfhost::cache_contract", "cache_contract.kizu"));
    try modules.append(module_spec("selfhost::compiler", "compiler.kizu"));
    try modules.append(module_spec("selfhost::diagnostics", "diagnostics.kizu"));
    try modules.append(module_spec("selfhost::ir", "ir.kizu"));
    try modules.append(module_spec("selfhost::lexer", "lexer.kizu"));
    try modules.append(module_spec("selfhost::ownership", "ownership.kizu"));
    try modules.append(module_spec("selfhost::parser", "parser.kizu"));
    try modules.append(module_spec("selfhost::resolver", "resolver.kizu"));
    try modules.append(module_spec("selfhost::token", "token.kizu"));
    try modules.append(module_spec("selfhost::types", "types.kizu"));
    return void;
}

// module_spec constructs one manifest graph candidate.
fn module_spec(path: []const u8, file: []const u8) -> ModuleSpec {
    return ModuleSpec {
        path: path,
        file: file,
    };
}

// read_manifest_module loads one source file from the manifest source root.
fn read_manifest_module(
    io: Io,
    manifest: &PackageManifest,
    spec: &ModuleSpec
) -> !SourceModule {
    let path = try selfhost_module_file(manifest.package_root, spec.file);
    let root = std::mem::equal_bytes(path, manifest.root_file);
    return try read_source_file(io, spec.path, path, root);
}

// read_selfhost_manifest loads and validates the checked-in manifest subset.
fn read_selfhost_manifest(io: Io) -> !PackageManifest {
    let root = try selfhost_package_root(io);
    let source = try std::fs::read_file(io, try selfhost_manifest_file(root));
    if std::mem::len(source) == 0 {
        return error("empty selfhost manifest");
    }
    let valid_name = try manifest_has_value(source, "name", "selfhost");
    if !valid_name {
        return error("invalid selfhost manifest package");
    }
    let valid_root = try manifest_has_value(source, "root", "src/main.kizu");
    if !valid_root {
        return error("invalid selfhost manifest root");
    }
    let valid_paths = try manifest_has_value(source, "paths", "src");
    if !valid_paths {
        return error("invalid selfhost manifest paths");
    }
    return PackageManifest {
        package_root: root,
        root_file: try selfhost_module_file(root, "main.kizu"),
    };
}

// selfhost_manifest_file returns the manifest path for a selected package root.
fn selfhost_manifest_file(root: []const u8) -> ![]const u8 {
    if std::mem::equal_bytes(root, "selfhost") {
        return "selfhost/kizu.toml";
    }
    if std::mem::equal_bytes(root, "../../selfhost") {
        return "../../selfhost/kizu.toml";
    }
    return error("missing selfhost package file");
}

// selfhost_module_file returns a source path below the selected manifest root.
fn selfhost_module_file(root: []const u8, file: []const u8) -> ![]const u8 {
    if std::mem::equal_bytes(root, "selfhost") {
        return try selfhost_root_module_file(file);
    }
    if std::mem::equal_bytes(root, "../../selfhost") {
        return try selfhost_package_test_module_file(file);
    }
    return error("missing selfhost package file");
}

// selfhost_root_module_file returns a repo-root relative source path.
fn selfhost_root_module_file(file: []const u8) -> ![]const u8 {
    if std::mem::equal_bytes(file, "main.kizu") { return "selfhost/src/main.kizu"; }
    if std::mem::equal_bytes(file, "ast.kizu") { return "selfhost/src/ast.kizu"; }
    if std::mem::equal_bytes(file, "backend.kizu") { return "selfhost/src/backend.kizu"; }
    if std::mem::equal_bytes(file, "cache_contract.kizu") {
        return "selfhost/src/cache_contract.kizu";
    }
    if std::mem::equal_bytes(file, "compiler.kizu") { return "selfhost/src/compiler.kizu"; }
    if std::mem::equal_bytes(file, "diagnostics.kizu") {
        return "selfhost/src/diagnostics.kizu";
    }
    if std::mem::equal_bytes(file, "ir.kizu") { return "selfhost/src/ir.kizu"; }
    if std::mem::equal_bytes(file, "lexer.kizu") { return "selfhost/src/lexer.kizu"; }
    if std::mem::equal_bytes(file, "ownership.kizu") {
        return "selfhost/src/ownership.kizu";
    }
    if std::mem::equal_bytes(file, "parser.kizu") { return "selfhost/src/parser.kizu"; }
    if std::mem::equal_bytes(file, "resolver.kizu") { return "selfhost/src/resolver.kizu"; }
    if std::mem::equal_bytes(file, "token.kizu") { return "selfhost/src/token.kizu"; }
    if std::mem::equal_bytes(file, "types.kizu") { return "selfhost/src/types.kizu"; }
    return error("missing selfhost package file");
}

// selfhost_package_test_module_file returns a cmd/kizu relative source path.
fn selfhost_package_test_module_file(file: []const u8) -> ![]const u8 {
    if std::mem::equal_bytes(file, "main.kizu") { return "../../selfhost/src/main.kizu"; }
    if std::mem::equal_bytes(file, "ast.kizu") { return "../../selfhost/src/ast.kizu"; }
    if std::mem::equal_bytes(file, "backend.kizu") { return "../../selfhost/src/backend.kizu"; }
    if std::mem::equal_bytes(file, "cache_contract.kizu") {
        return "../../selfhost/src/cache_contract.kizu";
    }
    if std::mem::equal_bytes(file, "compiler.kizu") {
        return "../../selfhost/src/compiler.kizu";
    }
    if std::mem::equal_bytes(file, "diagnostics.kizu") {
        return "../../selfhost/src/diagnostics.kizu";
    }
    if std::mem::equal_bytes(file, "ir.kizu") { return "../../selfhost/src/ir.kizu"; }
    if std::mem::equal_bytes(file, "lexer.kizu") { return "../../selfhost/src/lexer.kizu"; }
    if std::mem::equal_bytes(file, "ownership.kizu") {
        return "../../selfhost/src/ownership.kizu";
    }
    if std::mem::equal_bytes(file, "parser.kizu") { return "../../selfhost/src/parser.kizu"; }
    if std::mem::equal_bytes(file, "resolver.kizu") {
        return "../../selfhost/src/resolver.kizu";
    }
    if std::mem::equal_bytes(file, "token.kizu") { return "../../selfhost/src/token.kizu"; }
    if std::mem::equal_bytes(file, "types.kizu") { return "../../selfhost/src/types.kizu"; }
    return error("missing selfhost package file");
}

// selfhost_package_root selects the checked-in package root from common CWDs.
fn selfhost_package_root(io: Io) -> ![]const u8 {
    let root_exists = try std::fs::exists(io, "selfhost/kizu.toml");
    if root_exists {
        return "selfhost";
    }
    let package_test_exists = try std::fs::exists(io, "../../selfhost/kizu.toml");
    if package_test_exists {
        return "../../selfhost";
    }
    return error("missing selfhost package file");
}

// manifest_has_value reports whether a manifest key has a quoted value.
fn manifest_has_value(source: []const u8, key: []const u8, value: []const u8) -> !bool {
    var start = 0;
    let length = std::mem::len(source);

    while start < length {
        let end = try manifest_line_end(source, start);
        let line = try std::mem::slice(source, start, end);
        if std::mem::starts_with(line, key) {
            if try manifest_line_value_matches(line, value) {
                return true;
            }
        }
        start = end + 1;
    }
    return false;
}

// manifest_line_value_matches compares the first quoted value on a line.
fn manifest_line_value_matches(line: []const u8, value: []const u8) -> !bool {
    let first = try manifest_quote_after(line, 0);
    if first < 0 {
        return false;
    }
    let second = try manifest_quote_after(line, first + 1);
    if second < 0 {
        return false;
    }
    let parsed = try std::mem::slice(line, first + 1, second);
    return std::mem::equal_bytes(parsed, value);
}

// manifest_quote_after returns the first quote offset at or after start.
fn manifest_quote_after(line: []const u8, start: i64) -> !i64 {
    var index = start;
    let length = std::mem::len(line);

    while index < length {
        let byte = try std::mem::byte_at(line, index);
        if byte == cast<u8>(34) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// manifest_line_end returns the end offset for one line without the newline.
fn manifest_line_end(source: []const u8, start: i64) -> !i64 {
    var end = start;
    let length = std::mem::len(source);

    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if byte == cast<u8>(10) {
            return end;
        }
        end = end + 1;
    }
    return end;
}

// read_source_file reads one package module from an explicit filesystem path.
fn read_source_file(
    io: Io,
    module_path: []const u8,
    file_path: []const u8,
    is_root: bool
) -> !SourceModule {
    let source = try std::fs::read_file(io, file_path);
    if std::mem::len(source) == 0 {
        return error("empty package module");
    }
    return source_module(module_path, source, is_root, false);
}

// summarize_loaded_package reports source loading without running full lowering.
fn summarize_loaded_package(modules: &std::array::Array<SourceModule>) -> !PackageReport {
    var report = empty_package_report();
    var index = 0;

    report.status = CompileStatus::Pass;
    while index < modules.len() {
        let module = try modules.at(index);
        report.module_count = report.module_count + 1;
        if !module.is_test {
            report.compiled_module_count = report.compiled_module_count + 1;
        }
        if module_is_root(&module) {
            report.root_found = true;
        }
        index = index + 1;
    }
    return report;
}

// module_is_root reports whether a source module is the package entry module.
fn module_is_root(module: &SourceModule) -> bool {
    if module.is_root {
        return true;
    }
    return std::mem::equal_bytes(module.path, "selfhost::main");
}

// ready exposes the compiler module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}

pub struct TypeSummary {
    pub type_count: i64;
    pub copyable_scalar_count: i64;
    pub noncopy_value_count: i64;
}

pub struct OwnershipSummary {
    pub check_count: i64;
    pub rejected_count: i64;
}

// source_module constructs one explicit package source input.
fn source_module(
    path: []const u8,
    source: []const u8,
    is_root: bool,
    is_test: bool
) -> SourceModule {
    return SourceModule {
        path: path,
        source: source,
        is_root: is_root,
        is_test: is_test,
    };
}

// empty_package_report creates the mutable aggregate used by package compile.
fn empty_package_report() -> PackageReport {
    return PackageReport {
        status: CompileStatus::Pass,
        module_count: 0,
        compiled_module_count: 0,
        token_count: 0,
        function_count: 0,
        import_count: 0,
        type_count: 0,
        ownership_checks: 0,
        ir_function_count: 0,
        backend_emitted: false,
        root_found: false,
        diagnostic: "",
    };
}

// compile_package_module compiles one non-test module at summary granularity.
fn compile_package_module(module: &SourceModule) -> !PackageReport {
    try resolver::resolve_module_path(module.path);
    let compiled = try compile_source(module.source, "llvm");
    let imports = try module_import_count(module.source);

    return PackageReport {
        status: compiled.status,
        module_count: 0,
        compiled_module_count: 1,
        token_count: compiled.token_count,
        function_count: compiled.function_count,
        import_count: imports,
        type_count: compiled.type_count,
        ownership_checks: compiled.ownership_checks,
        ir_function_count: compiled.ir_function_count,
        backend_emitted: compiled.backend_emitted,
        root_found: false,
        diagnostic: compiled.diagnostic,
    };
}

// merge_package_report combines package aggregate counters.
fn merge_package_report(current: PackageReport, next: &PackageReport) -> PackageReport {
    return PackageReport {
        status: merge_status(current.status, next.status),
        module_count: current.module_count,
        compiled_module_count: current.compiled_module_count + next.compiled_module_count,
        token_count: current.token_count + next.token_count,
        function_count: current.function_count + next.function_count,
        import_count: current.import_count + next.import_count,
        type_count: current.type_count + next.type_count,
        ownership_checks: current.ownership_checks + next.ownership_checks,
        ir_function_count: current.ir_function_count + next.ir_function_count,
        backend_emitted: current.backend_emitted,
        root_found: current.root_found,
        diagnostic: next.diagnostic,
    };
}

// merge_status keeps failures sticky across package module compilation.
fn merge_status(left: CompileStatus, right: CompileStatus) -> CompileStatus {
    if left == CompileStatus::Fail {
        return CompileStatus::Fail;
    }
    return right;
}

// finish_package_report applies root and backend checks after all modules compile.
fn finish_package_report(report: PackageReport, target_name: []const u8) -> PackageReport {
    let target_info = backend::target(target_name);
    let artifact = backend::artifact(&target_info, report.ir_function_count, report.function_count);

    if !report.root_found {
        return package_failure(&report, "missing package root");
    }
    if !artifact.emitted {
        return package_failure(&report, "unsupported backend target");
    }
    return PackageReport {
        status: CompileStatus::Pass,
        module_count: report.module_count,
        compiled_module_count: report.compiled_module_count,
        token_count: report.token_count,
        function_count: report.function_count,
        import_count: report.import_count,
        type_count: report.type_count,
        ownership_checks: report.ownership_checks,
        ir_function_count: report.ir_function_count,
        backend_emitted: artifact.emitted,
        root_found: report.root_found,
        diagnostic: report.diagnostic,
    };
}

// package_failure marks a package report as failed without hiding diagnostics.
fn package_failure(report: &PackageReport, diagnostic: []const u8) -> PackageReport {
    return PackageReport {
        status: CompileStatus::Fail,
        module_count: report.module_count,
        compiled_module_count: report.compiled_module_count,
        token_count: report.token_count,
        function_count: report.function_count,
        import_count: report.import_count,
        type_count: report.type_count,
        ownership_checks: report.ownership_checks,
        ir_function_count: report.ir_function_count,
        backend_emitted: false,
        root_found: report.root_found,
        diagnostic: diagnostic,
    };
}

// module_import_count counts imports through the same lexer/parser boundary.
fn module_import_count(source: []const u8) -> !i64 {
    var tokens = try lexer::lex(source);
    let parsed = try parser::parse_tokens(tokens);
    return parsed.import_count;
}

// type_summary mirrors the Go type checker phase at summary granularity.
fn type_summary(parsed: &ast::ParseSummary) -> !TypeSummary {
    let void_type = try types::classify("void");
    let bool_type = try types::classify("bool");
    let bytes_type = try types::classify("[]const u8");
    var copyable = 0;
    var noncopy = 0;

    if types::can_copy(&void_type) {
        copyable = copyable + 1;
    }
    if types::can_copy(&bool_type) {
        copyable = copyable + 1;
    }
    if !types::can_copy(&bytes_type) {
        noncopy = noncopy + 1;
    }

    return TypeSummary {
        type_count: parsed.struct_count + parsed.enum_count + parsed.union_count,
        copyable_scalar_count: copyable,
        noncopy_value_count: noncopy,
    };
}

// ownership_summary mirrors the Go ownership checker phase at summary granularity.
fn ownership_summary(summary: &TypeSummary) -> OwnershipSummary {
    let copy_state = ownership::owned(true);
    let moved = ownership::move_value(&copy_state);
    let owned_state = ownership::owned(false);
    let borrowed = ownership::borrow_shared(&owned_state);
    let restored = ownership::end_borrow(&borrowed.next);
    let moved_owned = ownership::move_value(&restored);
    var rejected = 0;

    if !moved.allowed {
        rejected = rejected + 1;
    }
    if !moved_owned.allowed {
        rejected = rejected + 1;
    }

    return OwnershipSummary {
        check_count: summary.copyable_scalar_count + summary.noncopy_value_count,
        rejected_count: rejected,
    };
}
