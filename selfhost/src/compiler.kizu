  %i_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 5
  store i64 %i, ptr %i_out
  %ty_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 6
  store i64 %ty, ptr %ty_out
  %o_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 7
  store i64 %o, ptr %o_out
  %ir_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 8
  store i64 %ir, ptr %ir_out
  %b_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 9
  store i1 true, ptr %b_out
  %r_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 10
  store i1 %root, ptr %r_out
  %d_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 11
  store ptr %d, ptr %d_out
  ret ptr %out
");
    return void;
}

// build_lex_and_parse_source_function_symbol builds the frontend summary body.
fn build_lex_and_parse_source_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define ptr @compiler.lex_and_parse_source(ptr %source) ");
    try text.append_byte(cast<u8>(123));
    try text.append_bytes("
entry:
  %tokens = call ptr @lexer.lex(ptr %source)
  %parsed = call ptr @parser.parse_token_stream(ptr %tokens)
  %out = call ptr @malloc(i64 72)
  %token_count = call i64 @kizu_bytes_len(ptr %source)
  %fn_in = getelementptr inbounds %struct.ast.ParseSummary, ptr %parsed, i64 0, i32 0
  %function_count = load i64, ptr %fn_in
  %import_in = getelementptr inbounds %struct.ast.ParseSummary, ptr %parsed, i64 0, i32 1
  %import_count = load i64, ptr %import_in
  %struct_in = getelementptr inbounds %struct.ast.ParseSummary, ptr %parsed, i64 0, i32 2
  %struct_count = load i64, ptr %struct_in
  %enum_in = getelementptr inbounds %struct.ast.ParseSummary, ptr %parsed, i64 0, i32 3
  %enum_count = load i64, ptr %enum_in
  %union_in = getelementptr inbounds %struct.ast.ParseSummary, ptr %parsed, i64 0, i32 4
  %union_count = load i64, ptr %union_in
  %return_in = getelementptr inbounds %struct.ast.ParseSummary, ptr %parsed, i64 0, i32 5
  %return_count = load i64, ptr %return_in
  %tokens_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 0
  store i64 %token_count, ptr %tokens_out
  %first_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 1
  store ptr null, ptr %first_out
  %eof_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 2
  store ptr null, ptr %eof_out
  %fn_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 3
  store i64 %function_count, ptr %fn_out
  %import_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 4
  store i64 %import_count, ptr %import_out
  %struct_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 5
  store i64 %struct_count, ptr %struct_out
  %enum_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 6
  store i64 %enum_count, ptr %enum_out
  %union_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 7
  store i64 %union_count, ptr %union_out
  %return_out = getelementptr inbounds %struct.compiler.FrontendReport, ptr %out, i64 0, i32 8
  store i64 %return_count, ptr %return_out
  ret ptr %out
");
    try text.append_byte(cast<u8>(125));
    try text.append_byte(cast<u8>(10));
    return text;
}

