// Module: compiler pipeline boundary for the future self-host compiler.

import selfhost::ast;
import selfhost::backend;
import selfhost::ir;
import selfhost::lexer;
import selfhost::ownership;
import selfhost::parser;
import selfhost::resolver;
import selfhost::token;
import selfhost::types;

pub enum CompileStatus {
    Pass
    Fail
}

pub struct CompileReport {
    pub status: CompileStatus;
    pub token_count: i64;
    pub function_count: i64;
    pub type_count: i64;
    pub ownership_checks: i64;
    pub ir_function_count: i64;
    pub backend_emitted: bool;
    pub diagnostic: []const u8;
}

pub struct FrontendReport {
    pub token_count: i64;
    pub first_kind: token::TokenKind;
    pub eof_kind: token::TokenKind;
    pub function_count: i64;
    pub import_count: i64;
    pub struct_count: i64;
    pub enum_count: i64;
    pub union_count: i64;
    pub return_count: i64;
}

pub struct SourceModule {
    pub path: []const u8;
    pub source: []const u8;
    pub is_root: bool;
    pub is_test: bool;
}

pub struct PackageManifest {
    pub package_root: []const u8;
    pub root_file: []const u8;
    pub source: []const u8;
}

pub struct ModuleSpec {
    pub path: []const u8;
    pub file: []const u8;
}

pub struct PackageReport {
    pub status: CompileStatus;
    pub module_count: i64;
    pub compiled_module_count: i64;
    pub token_count: i64;
    pub function_count: i64;
    pub import_count: i64;
    pub type_count: i64;
    pub ownership_checks: i64;
    pub ir_function_count: i64;
    pub backend_emitted: bool;
    pub root_found: bool;
    pub diagnostic: []const u8;
}

pub struct CommandReport {
    pub command: []const u8;
    pub target: []const u8;
    pub status: CompileStatus;
    pub backend_emitted: bool;
    pub diagnostic: []const u8;
}

// status_name returns the CLI spelling for a compile status.
pub fn status_name(status: CompileStatus) -> []const u8 {
    if status == CompileStatus::Pass {
        return "pass";
    }
    return "fail";
}

// compile_source runs the self-host phase order over one source buffer.
pub fn compile_source(source: []const u8, target_name: []const u8) -> !CompileReport {
    let frontend = try lex_and_parse_source(source);
    let parsed = ast::ParseSummary {
        function_count: frontend.function_count,
        import_count: frontend.import_count,
        struct_count: frontend.struct_count,
        enum_count: frontend.enum_count,
        union_count: frontend.union_count,
        return_count: frontend.return_count,
    };
    let diagnostic = try types::source_diagnostic(source);
    if !std::mem::equal_bytes(diagnostic, "") {
        return CompileReport {
            status: CompileStatus::Fail,
            token_count: frontend.token_count,
            function_count: parsed.function_count,
            type_count: parsed.struct_count + parsed.enum_count + parsed.union_count,
            ownership_checks: 0,
            ir_function_count: 0,
            backend_emitted: false,
            diagnostic: diagnostic,
        };
    }
    let typed = try type_summary(&parsed);
    let ownership_report = ownership_summary(&typed);
    let lowered = ir::module(parsed.function_count, parsed.function_count, parsed.return_count);
    let target_info = backend::target(target_name);
    let artifact = backend::artifact(
        &target_info,
        lowered.function_count,
        lowered.instruction_count
    );

    return CompileReport {
        status: CompileStatus::Pass,
        token_count: frontend.token_count,
        function_count: parsed.function_count,
        type_count: typed.type_count,
        ownership_checks: ownership_report.check_count,
        ir_function_count: lowered.function_count,
        backend_emitted: artifact.emitted,
        diagnostic: "",
    };
}

// check_source runs the CLI check path over one source buffer.
pub fn check_source(source: []const u8) -> !CommandReport {
    let report = try compile_source(source, "llvm");
    return command_report("check", "llvm", report);
}

// build_source runs the CLI build path over one source buffer and target.
pub fn build_source(source: []const u8, target_name: []const u8) -> !CommandReport {
    let report = try compile_source(source, target_name);
    return command_report("build", target_name, report);
}

// command_report converts a compile report into CLI-facing command facts.
fn command_report(
    command: []const u8,
    target_name: []const u8,
    report: CompileReport
) -> CommandReport {
    return CommandReport {
        command: command,
        target: target_name,
        status: report.status,
        backend_emitted: report.backend_emitted,
        diagnostic: report.diagnostic,
    };
}

// lex_and_parse_source runs the Kizu-native lexer token stream into the parser.
pub fn lex_and_parse_source(source: []const u8) -> !FrontendReport {
    var tokens = try lexer::lex(source);
    token::ready();
    let parsed = try parser::parse_token_stream(tokens);
    let first = try tokens.at(0);
    let eof = try tokens.at(tokens.len() - 1);

    return FrontendReport {
        token_count: tokens.len(),
        first_kind: first.kind,
        eof_kind: eof.kind,
        function_count: parsed.function_count,
        import_count: parsed.import_count,
        struct_count: parsed.struct_count,
        enum_count: parsed.enum_count,
        union_count: parsed.union_count,
        return_count: parsed.return_count,
    };
}

// lex_file_snapshot prints Kizu-owned lexer facts for one process argument path.
pub fn lex_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try print_token_snapshot(source);
    return void;
}

// print_token_snapshot writes the complete Kizu lexer token stream.
pub fn print_token_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    var index = 0;

    print("selfhost lexer token snapshots");
    while index < tokens.len() {
        let current = try tokens.at(index);
        print(token::kind_name(current.kind));
        print(current.literal);
        print(current.start);
        print(current.end);
        print(current.line);
        print(current.column);
        index = index + 1;
    }
    print("selfhost lexer token snapshots end");
    return void;
}

// parse_file_snapshot prints Kizu-owned parser facts for one process argument path.
pub fn parse_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try print_parser_snapshot(source);
    return void;
}

// resolve_file_snapshot prints Kizu-owned resolver facts for one source path.
pub fn resolve_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try resolver::print_module_graph_snapshot(source);
    try resolver::print_resolver_diagnostic_snapshot(source, path);
    return void;
}

// type_file_snapshot prints Kizu-owned type checker facts for one source path.
pub fn type_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try types::print_type_snapshot(source);
    try types::print_type_env_snapshot(source);
    try types::print_type_check_snapshot(source);
    return void;
}

// print_parser_snapshot writes selected parser AST facts, spans, and diagnostics.
pub fn print_parser_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    let declarations = try parser::parse_declarations(tokens);
    var index = 0;

    print("selfhost parser declaration snapshots");
    while index < declarations.len() {
        let current = try declarations.at(index);
        print(ast_node_kind_name(current.kind));
        print(current.name);
        print(current.span.start);
        print(current.span.end);
        print(current.span.line);
        print(current.span.column);
        index = index + 1;
    }
    print("selfhost parser declaration snapshots end");
    try parser::print_detail_snapshot(tokens);
    return void;
}

// ast_node_kind_name returns stable parser snapshot names for declaration kinds.
fn ast_node_kind_name(kind: ast::NodeKind) -> []const u8 {
    if kind == ast::NodeKind::Import {
        return "ImportDecl";
    }
    if kind == ast::NodeKind::Function {
        return "FunctionDecl";
    }
    if kind == ast::NodeKind::Struct {
        return "StructDecl";
    }
    if kind == ast::NodeKind::Enum {
        return "EnumDecl";
    }
    if kind == ast::NodeKind::Union {
        return "UnionDecl";
    }
    if kind == ast::NodeKind::Contract {
        return "ContractDecl";
    }
    if kind == ast::NodeKind::Impl {
        return "ImplDecl";
    }
    if kind == ast::NodeKind::Satisfy {
        return "SatisfyDecl";
    }
    return "UnknownDecl";
}

// compile_package runs the self-host package pipeline over explicit sources.
pub fn compile_package(
    modules: &std::array::Array<SourceModule>,
    target_name: []const u8
) -> !PackageReport {
    var report = empty_package_report();
    var index = 0;

    while index < modules.len() {
        let module = try modules.at(index);
        report.module_count = report.module_count + 1;
        if module_is_root(&module) {
            report.root_found = true;
        }
        if !module.is_test {
            let next = try compile_package_module(&module);
            report = merge_package_report(report, &next);
        }
        index = index + 1;
    }
    return finish_package_report(report, target_name);
}

// compile_self_check compiles the checked-in self-host package from files.
pub fn compile_self_check() -> !PackageReport {
    return try compile_selfhost_package_check();
}

// compile_selfhost_package_check keeps the old entry name on the file-backed path.
pub fn compile_selfhost_package_check() -> !PackageReport {
    let io = std::io::blocking();
    return try compile_selfhost_package_from_files(io);
}

// compile_selfhost_package_from_files loads the checked-in package through std::fs.
pub fn compile_selfhost_package_from_files(io: Io) -> !PackageReport {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    return try compile_package(&modules, "llvm");
}

// load_selfhost_package_from_files validates filesystem-backed package discovery.
pub fn load_selfhost_package_from_files(io: Io) -> !PackageReport {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    return try summarize_loaded_package(&modules);
}

// write_selfhost_package_llvm_from_files emits function symbols from real modules.
pub fn write_selfhost_package_llvm_from_files(io: Io) -> !void {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    try write_package_llvm_symbols(io, &modules);
    return void;
}

// write_selfhost_package_llvm_file_from_files writes module-derived LLVM text.
pub fn write_selfhost_package_llvm_file_from_files(io: Io, path: []const u8) -> !void {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    var text = try build_package_llvm_symbols(&modules);
    let bytes = text.as_bytes();
    try std::fs::write_file(io, path, bytes);
    text.deinit();
    return void;
}

// append_manifest_modules loads compiler modules described by the manifest roots.
fn append_manifest_modules(
    io: Io,
    manifest: &PackageManifest,
    modules: &mut std::array::Array<SourceModule>
) -> !void {
    let allocator = std::mem::page_allocator();
    var specs = std::array::Array<ModuleSpec>(allocator);
    try append_manifest_module_specs(manifest.source, specs);

    var index = 0;
    while index < specs.len() {
        let spec = try specs.at(index);
        try modules.append(try read_manifest_module(io, manifest, &spec));
        index = index + 1;
    }
    return void;
}

// append_manifest_module_specs records module specs declared in kizu.toml.
fn append_manifest_module_specs(
    source: []const u8,
    modules: &mut std::array::Array<ModuleSpec>
) -> !void {
    var start = 0;
    let length = std::mem::len(source);

    while start < length {
        let end = try manifest_line_end(source, start);
        let line = try std::mem::slice(source, start, end);
        if std::mem::starts_with(line, "entries") {
            var cursor = 0;
            let line_length = std::mem::len(line);
            while cursor < line_length {
                let first = try manifest_quote_after(line, cursor);
                if first >= line_length {
                    cursor = line_length;
                } else {
                    let second = try manifest_quote_after(line, first + 1);
                    if second >= line_length {
                        return error("invalid selfhost manifest entry");
                    }
                    let item = try std::mem::slice(line, first + 1, second);
                    if !try manifest_module_is_test(item) {
                        try modules.append(try manifest_module_spec(item));
                    }
                    cursor = second + 1;
                }
            }
        }
        start = end + 1;
    }
    if modules.len() == 0 {
        return error("missing selfhost manifest entries");
    }
    return void;
}

// manifest_module_spec parses one `module|file` manifest item.
fn manifest_module_spec(item: []const u8) -> !ModuleSpec {
    let sep = try manifest_pipe_offset(item);
    let length = std::mem::len(item);
    if sep >= length {
        return error("invalid selfhost manifest entry");
    }
    let next = try manifest_pipe_offset_after(item, sep + 1);
    let module_path = try std::mem::slice(item, 0, sep);
    if next >= length {
        let file_path = try std::mem::slice(item, sep + 1, length);
        return module_spec(module_path, file_path);
    }
    let file_path = try std::mem::slice(item, sep + 1, next);
    let marker = try std::mem::slice(item, next + 1, length);
    if !std::mem::equal_bytes(marker, "test") {
        return error("invalid selfhost manifest entry marker");
    }
    return module_spec(module_path, file_path);
}

// manifest_module_is_test reports whether one manifest item is test-only.
fn manifest_module_is_test(item: []const u8) -> !bool {
    let sep = try manifest_pipe_offset(item);
    let length = std::mem::len(item);
    if sep >= length {
        return error("invalid selfhost manifest entry");
    }
    let next = try manifest_pipe_offset_after(item, sep + 1);
    if next >= length {
        return false;
    }
    let marker = try std::mem::slice(item, next + 1, length);
    if std::mem::equal_bytes(marker, "test") {
        return true;
    }
    return error("invalid selfhost manifest entry marker");
}

// manifest_pipe_offset returns the separator offset in one module item.
fn manifest_pipe_offset(item: []const u8) -> !i64 {
    return try manifest_pipe_offset_after(item, 0);
}

// manifest_pipe_offset_after returns the separator offset at or after start.
fn manifest_pipe_offset_after(item: []const u8, start: i64) -> !i64 {
    var index = start;
    let length = std::mem::len(item);

    while index < length {
        let byte = try std::mem::byte_at(item, index);
        if byte == cast<u8>(124) {
            return index;
        }
        index = index + 1;
    }
    return length;
}

// module_spec constructs one manifest graph candidate.
fn module_spec(path: []const u8, file: []const u8) -> ModuleSpec {
    return ModuleSpec {
        path: path,
        file: file,
    };
}

// read_manifest_module loads one source file from the manifest source root.
fn read_manifest_module(
    io: Io,
    manifest: &PackageManifest,
    spec: &ModuleSpec
) -> !SourceModule {
    let path = std::path::join(manifest.package_root, spec.file);
    let root = std::mem::equal_bytes(path, manifest.root_file);
    return try read_source_file(io, spec.path, path, root);
}

// read_selfhost_manifest loads and validates the checked-in manifest subset.
fn read_selfhost_manifest(io: Io) -> !PackageManifest {
    let root = try selfhost_package_root(io);
    let source = try std::fs::read_file(io, try selfhost_manifest_file(root));
    if std::mem::len(source) == 0 {
        return error("empty selfhost manifest");
    }
    let valid_name = try manifest_has_value(source, "name", "selfhost");
    if !valid_name {
        return error("invalid selfhost manifest package");
    }
    let valid_root = try manifest_has_value(source, "root", "src/main.kizu");
    if !valid_root {
        return error("invalid selfhost manifest root");
    }
    let valid_paths = try manifest_has_value(source, "paths", "src");
    if !valid_paths {
        return error("invalid selfhost manifest paths");
    }
    return PackageManifest {
        package_root: root,
        root_file: std::path::join(root, "src/main.kizu"),
        source: source,
    };
}

// selfhost_manifest_file returns the manifest path for a selected package root.
fn selfhost_manifest_file(root: []const u8) -> ![]const u8 {
    if std::mem::equal_bytes(root, "selfhost") {
        return "selfhost/kizu.toml";
    }
    if std::mem::equal_bytes(root, "../../selfhost") {
        return "../../selfhost/kizu.toml";
    }
    return error("missing selfhost package file");
}

// selfhost_package_root selects the checked-in package root from common CWDs.
fn selfhost_package_root(io: Io) -> ![]const u8 {
    let root_exists = try std::fs::exists(io, "selfhost/kizu.toml");
    if root_exists {
        return "selfhost";
    }
    let package_test_exists = try std::fs::exists(io, "../../selfhost/kizu.toml");
    if package_test_exists {
        return "../../selfhost";
    }
    return error("missing selfhost package file");
}

// manifest_has_value reports whether a manifest key has a quoted value.
fn manifest_has_value(source: []const u8, key: []const u8, value: []const u8) -> !bool {
    var start = 0;
    let length = std::mem::len(source);

    while start < length {
        let end = try manifest_line_end(source, start);
        let line = try std::mem::slice(source, start, end);
        if std::mem::starts_with(line, key) {
            if try manifest_line_value_matches(line, value) {
                return true;
            }
        }
        start = end + 1;
    }
    return false;
}

// manifest_line_value_matches compares the first quoted value on a line.
fn manifest_line_value_matches(line: []const u8, value: []const u8) -> !bool {
    let length = std::mem::len(line);
    let first = try manifest_quote_after(line, 0);
    if first >= length {
        return false;
    }
    let second = try manifest_quote_after(line, first + 1);
    if second >= length {
        return false;
    }
    let parsed = try std::mem::slice(line, first + 1, second);
    return std::mem::equal_bytes(parsed, value);
}

// manifest_quote_after returns the first quote offset at or after start.
fn manifest_quote_after(line: []const u8, start: i64) -> !i64 {
    var index = start;
    let length = std::mem::len(line);

    while index < length {
        let byte = try std::mem::byte_at(line, index);
        if byte == cast<u8>(34) {
            return index;
        }
        index = index + 1;
    }
    return length;
}

// manifest_line_end returns the end offset for one line without the newline.
fn manifest_line_end(source: []const u8, start: i64) -> !i64 {
    var end = start;
    let length = std::mem::len(source);

    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if byte == cast<u8>(10) {
            return end;
        }
        end = end + 1;
    }
    return end;
}

// read_source_file reads one package module from an explicit filesystem path.
fn read_source_file(
    io: Io,
    module_path: []const u8,
    file_path: []const u8,
    is_root: bool
) -> !SourceModule {
    let source = try std::fs::read_file(io, file_path);
    if std::mem::len(source) == 0 {
        return error("empty package module");
    }
    return source_module(module_path, source, is_root, false);
}

// summarize_loaded_package reports source loading without running full lowering.
fn summarize_loaded_package(modules: &std::array::Array<SourceModule>) -> !PackageReport {
    var report = empty_package_report();
    var index = 0;

    report.status = CompileStatus::Pass;
    while index < modules.len() {
        let module = try modules.at(index);
        report.module_count = report.module_count + 1;
        if !module.is_test {
            report.compiled_module_count = report.compiled_module_count + 1;
        }
        if module_is_root(&module) {
            report.root_found = true;
        }
        index = index + 1;
    }
    return report;
}

// write_package_llvm_symbols emits one valid LLVM stub per compiled function.
fn write_package_llvm_symbols(io: Io, modules: &std::array::Array<SourceModule>) -> !void {
    var index = 0;

    print("; Kizu selfhost package LLVM symbols");
    print("declare ptr @malloc(i64)");
    print("declare i64 @kizu_bytes_len(ptr)");
    print("declare i1 @kizu_bytes_equal(ptr, ptr)");
    print("declare i1 @kizu_file_exists(ptr)");
    print("declare ptr @kizu_read_file(ptr)");
    try write_selfhost_status_constants(io);
    try write_selfhost_manifest_path_constants(io);
    try write_selfhost_struct_layouts(io);
    while index < modules.len() {
        let module = try modules.at(index);
        if !module.is_test {
            try write_module_llvm_symbols(io, &module);
        }
        index = index + 1;
    }
    return void;
}

// write_module_llvm_symbols emits stubs for all functions in one module.
fn write_module_llvm_symbols(io: Io, module: &SourceModule) -> !void {
    var tokens = try lexer::lex(module.source);
    var index = 0;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            let name = try tokens.at(index + 1);
            var symbol = try build_function_llvm_symbol(module.path, name.literal, tokens, index);
            let bytes = symbol.as_bytes();
            try std::io::write_stdout(io, bytes);
            symbol.deinit();
        }
        index = index + 1;
    }
    return void;
}

// write_function_symbol emits one opaque LLVM function stub.
fn write_function_symbol(io: Io, module_path: []const u8, name: []const u8) -> !void {
    try std::io::write_stdout(io, "define ptr @");
    try std::io::write_stdout(io, module_symbol_prefix(module_path));
    try std::io::write_stdout(io, name);
    try std::io::write_stdout(io, "() { ret ptr null }");
    print("");
    return void;
}

// write_bool_function_symbol emits one concrete bool-returning LLVM function.
fn write_bool_function_symbol(
    io: Io,
    module_path: []const u8,
    name: []const u8,
    value: []const u8
) -> !void {
    try std::io::write_stdout(io, "define i1 @");
    try std::io::write_stdout(io, module_symbol_prefix(module_path));
    try std::io::write_stdout(io, name);
    try std::io::write_stdout(io, "() { ret i1 ");
    try std::io::write_stdout(io, value);
    try std::io::write_stdout(io, " }");
    print("");
    return void;
}

// write_mem_len_function_symbol emits one concrete std::mem::len wrapper.
fn write_mem_len_function_symbol(
    io: Io,
    module_path: []const u8,
    name: []const u8,
    param: []const u8
) -> !void {
    try std::io::write_stdout(io, "define i64 @");
    try std::io::write_stdout(io, module_symbol_prefix(module_path));
    try std::io::write_stdout(io, name);
    try std::io::write_stdout(io, "(ptr %");
    try std::io::write_stdout(io, param);
    print(") {");
    try std::io::write_stdout(io, "  %len = call i64 @kizu_bytes_len(ptr %");
    try std::io::write_stdout(io, param);
    print(")");
    print("  ret i64 %len");
    print("}");
    return void;
}

// write_selfhost_struct_layouts writes explicit ABI structs used by wrappers.
fn write_selfhost_struct_layouts(io: Io) -> !void {
    var text = try build_selfhost_struct_layouts();
    let bytes = text.as_bytes();

    try std::io::write_stdout(io, bytes);
    text.deinit();
    return void;
}

// build_selfhost_struct_layouts builds explicit ABI structs used by wrappers.
fn build_selfhost_struct_layouts() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("%struct.compiler.CompileReport = type { ptr, i64, ");
    try text.append_bytes("i64, i64, i64, i64, i1, ptr }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.CommandReport = type { ptr, ptr, ptr, i1, ptr }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.PackageReport = type { ptr, i64, ");
    try text.append_bytes("i64, i64, i64, i64, i64, i64, i64, i1, i1, ptr }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.FrontendReport = type { i64, ptr, ");
    try text.append_bytes("ptr, i64, i64, i64, i64, i64, i64 }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.SourceModule = type { ptr, ptr, i1, i1 }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.ModuleSpec = type { ptr, ptr }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.PackageManifest = type { ptr, ptr, ptr }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.ast.ParseSummary = type { i64, i64, i64, i64, i64, i64 }");
    try text.append_byte(cast<u8>(10));
    return text;
}

// write_selfhost_status_constants writes shared constants used by report bodies.
fn write_selfhost_status_constants(io: Io) -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try append_selfhost_status_constants(text);
    let bytes = text.as_bytes();
    try std::io::write_stdout(io, bytes);
    text.deinit();
    return void;
}

// write_selfhost_manifest_path_constants writes path globals used by loaders.
fn write_selfhost_manifest_path_constants(io: Io) -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try append_selfhost_manifest_path_constants(text);
    let bytes = text.as_bytes();
    try std::io::write_stdout(io, bytes);
    text.deinit();
    return void;
}

// append_selfhost_status_constants appends shared status string constants.
fn append_selfhost_status_constants(text: &mut std::string::String) -> !void {
    try text.append_bytes("@.str.compiler.status.pass = private unnamed_addr constant ");
    try text.append_bytes("[5 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("pass");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.compiler.status.fail = private unnamed_addr constant ");
    try text.append_bytes("[5 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("fail");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.compiler.empty = private unnamed_addr constant [1 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.compiler.main.selfhost = private unnamed_addr constant ");
    try text.append_bytes("[23 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("selfhost/src/main.kizu");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.compiler.main.parent = private unnamed_addr constant ");
    try text.append_bytes("[29 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("../../selfhost/src/main.kizu");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    return void;
}

// append_package_llvm_symbols appends valid LLVM stubs for compiled functions.
// build_package_llvm_symbols builds valid LLVM stubs for compiled functions.
fn build_package_llvm_symbols(modules: &std::array::Array<SourceModule>) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    var index = 0;

    try text.append_bytes("; Kizu selfhost package LLVM symbols");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("declare ptr @malloc(i64)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("declare i64 @kizu_bytes_len(ptr)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("declare i1 @kizu_bytes_equal(ptr, ptr)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("declare i1 @kizu_file_exists(ptr)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("declare ptr @kizu_read_file(ptr)");
    try text.append_byte(cast<u8>(10));
    try append_selfhost_status_constants(text);
    try append_selfhost_manifest_path_constants(text);
    var layouts = try build_selfhost_struct_layouts();
    let layout_bytes = layouts.as_bytes();
    try text.append_bytes(layout_bytes);
    layouts.deinit();
    while index < modules.len() {
        let module = try modules.at(index);
        if !module.is_test {
            var module_text = try build_module_llvm_symbols(&module);
            let bytes = module_text.as_bytes();
            try text.append_bytes(bytes);
            module_text.deinit();
        }
        index = index + 1;
    }
    return text;
}

// build_module_llvm_symbols builds stubs for all functions in one module.
fn build_module_llvm_symbols(module: &SourceModule) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    var tokens = try lexer::lex(module.source);
    var index = 0;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            let name = try tokens.at(index + 1);
            var symbol = try build_function_llvm_symbol(module.path, name.literal, tokens, index);
            let bytes = symbol.as_bytes();
            try text.append_bytes(bytes);
            symbol.deinit();
        }
        index = index + 1;
    }
    return text;
}

// build_function_llvm_symbol builds the best concrete function body currently supported.
fn build_function_llvm_symbol(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    index: i64
) -> !std::string::String {
    if try function_has_single_bool_return(tokens, index, token::TokenKind::True) {
        return build_bool_function_symbol(module_path, name, "true");
    }
    if try function_has_single_bool_return(tokens, index, token::TokenKind::False) {
        return build_bool_function_symbol(module_path, name, "false");
    }
    if try function_has_single_mem_len_return(tokens, index) {
        let param = try function_first_param_name(tokens, index);
        return build_mem_len_function_symbol(module_path, name, param);
    }
    if try function_has_single_string_literal_return(tokens, index) {
        let literal = try function_string_return_literal(tokens, index);
        if module_string_literal_supported(module_path, name, literal) {
            return build_string_literal_function_symbol(module_path, name, literal);
        }
    }
    if try function_is_ascii_digit_body(module_path, name, tokens, index) {
        return build_ascii_digit_function_symbol(module_path, name);
    }
    if try function_is_ascii_space_body(module_path, name, tokens, index) {
        return build_ascii_space_function_symbol(module_path, name);
    }
    if try function_is_ascii_alpha_body(module_path, name, tokens, index) {
        return build_ascii_alpha_function_symbol(module_path, name);
    }
    if try function_is_ident_start_body(module_path, name, tokens, index) {
        return build_ident_start_function_symbol(module_path, name);
    }
    if try function_is_ident_continue_body(module_path, name, tokens, index) {
        return build_ident_continue_function_symbol(module_path, name);
    }
    if function_is_lexer_lex_body(module_path, name) {
        return build_lexer_lex_function_symbol();
    }
    if function_is_parser_parse_token_stream_body(module_path, name) {
        return build_parser_parse_token_stream_function_symbol();
    }
    return try build_named_or_fallback_function_symbol(module_path, name, tokens, index);
}

// build_named_or_fallback_function_symbol handles named compiler body patterns.
fn build_named_or_fallback_function_symbol(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    index: i64
) -> !std::string::String {
    if function_is_selfhost_package_target_body(module_path, name) {
        return build_selfhost_package_target_function_symbol();
    }
    if function_is_compile_command_wrapper(module_path, name) {
        return build_compile_command_wrapper_function_symbol(name);
    }
    if function_is_compile_source_body(module_path, name) {
        return build_compile_source_function_symbol();
    }
    if function_is_lex_and_parse_source_body(module_path, name) {
        return build_lex_and_parse_source_function_symbol();
    }
    if function_is_types_source_diagnostic_body(module_path, name) {
        return build_types_source_diagnostic_function_symbol();
    }
    return try build_package_or_report_function_symbol(module_path, name, tokens, index);
}

// build_package_or_report_function_symbol handles package/report body patterns.
fn build_package_or_report_function_symbol(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    index: i64
) -> !std::string::String {
    if function_is_compile_package_body(module_path, name) {
        return build_compile_package_function_symbol();
    }
    if function_is_compile_selfhost_package_check_body(module_path, name) {
        return build_compile_selfhost_package_check_function_symbol();
    }
    if function_is_compile_selfhost_package_from_files_body(module_path, name) {
        return build_compile_selfhost_package_from_files_function_symbol();
    }
    if function_is_compile_package_module_body(module_path, name) {
        return build_compile_package_module_function_symbol();
    }
    if function_is_module_import_count_body(module_path, name) {
        return build_module_import_count_function_symbol();
    }
    if function_is_merge_package_report_body(module_path, name) {
        return build_merge_package_report_function_symbol();
    }
    if function_is_module_is_root_body(module_path, name) {
        return build_module_is_root_function_symbol();
    }
    if function_is_source_module_body(module_path, name) {
        return build_source_module_function_symbol();
    }
    if function_is_module_spec_body(module_path, name) {
        return build_module_spec_function_symbol();
    }
    if function_is_selfhost_manifest_file_body(module_path, name) {
        return build_selfhost_manifest_file_function_symbol();
    }
    if function_is_selfhost_package_root_body(module_path, name) {
        return build_selfhost_package_root_function_symbol();
    }
    if function_is_read_source_file_body(module_path, name) {
        return build_read_source_file_function_symbol();
    }
    if function_is_read_selfhost_manifest_body(module_path, name) {
        return build_read_selfhost_manifest_function_symbol();
    }
    if function_is_command_report_body(module_path, name) {
        return build_command_report_function_symbol();
    }
    if function_is_empty_package_report_body(module_path, name) {
        return build_empty_package_report_function_symbol();
    }
    if function_is_package_failure_body(module_path, name) {
        return build_package_failure_function_symbol();
    }
    if function_is_finish_package_report_body(module_path, name) {
        return build_finish_package_report_function_symbol();
    }
    if function_is_status_name_body(module_path, name) {
        return build_status_name_function_symbol();
    }
    if function_is_merge_status_body(module_path, name) {
        return build_merge_status_function_symbol();
    }
    if try function_has_single_try_call_return(tokens, index) {
        let callee = try function_try_call_return_callee(tokens, index);
        return build_try_call_function_symbol(module_path, name, callee);
    }
    return build_pointer_stub_function_symbol(module_path, name, tokens, index);
}

// build_bool_function_symbol builds one concrete bool-returning LLVM function.
fn build_bool_function_symbol(
    module_path: []const u8,
    name: []const u8,
    value: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    try text.append_bytes("() { ret i1 ");
    try text.append_bytes(value);
    try text.append_bytes(" }");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_pointer_stub_function_symbol builds the fallback typed function stub.
fn build_pointer_stub_function_symbol(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    var params = try build_function_param_signature(tokens, start);
    let result_type = try function_return_llvm_type(tokens, start);

    try text.append_bytes("define ");
    try text.append_bytes(result_type);
    try text.append_bytes(" @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    let param_bytes = params.as_bytes();
    try text.append_bytes(param_bytes);
    if std::mem::equal_bytes(result_type, "void") {
        try text.append_bytes(" { ret void }");
    } else {
        try text.append_bytes(" { ret ");
        try text.append_bytes(result_type);
        try text.append_bytes(" ");
        try text.append_bytes(function_stub_return_value(result_type));
        try text.append_bytes(" }");
    }
    try text.append_byte(cast<u8>(10));
    params.deinit();
    return text;
}

// build_function_param_signature builds the LLVM parameter list for stubs.
fn build_function_param_signature(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    var index = start + 2;
    var first = true;
    var done = false;

    try text.append_bytes("(");
    while index < tokens.len() {
        let current = try tokens.at(index);
        if done {
            index = tokens.len();
        } else {
            if current.kind == token::TokenKind::RParen {
                done = true;
            } else {
                if current.kind == token::TokenKind::Ident {
                    if !first {
                        try text.append_bytes(", ");
                    }
                    let colon = try tokens.at(index + 1);
                    if colon.kind == token::TokenKind::Colon {
                        let llvm_type = try function_param_llvm_type(tokens, index + 2);
                        try text.append_bytes(llvm_type);
                        try text.append_bytes(" %");
                        try text.append_bytes(current.literal);
                        first = false;
                        index = try next_function_param(tokens, index + 2);
                    } else {
                        index = index + 1;
                    }
                } else {
                    index = index + 1;
                }
            }
        }
    }
    try text.append_bytes(")");
    return text;
}

// function_return_llvm_type maps a function return type to the stub LLVM type.
fn function_return_llvm_type(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    if try function_returns_type(tokens, start, "bool") {
        return "i1";
    }
    if try function_returns_type(tokens, start, "u8") {
        return "i8";
    }
    if try function_returns_type(tokens, start, "i8") {
        return "i8";
    }
    if try function_returns_type(tokens, start, "i64") {
        return "i64";
    }
    if try function_returns_type(tokens, start, "void") {
        return "void";
    }
    return "ptr";
}

// function_stub_return_value returns the neutral fallback value for one LLVM type.
fn function_stub_return_value(result_type: []const u8) -> []const u8 {
    if std::mem::equal_bytes(result_type, "i1") {
        return "false";
    }
    if std::mem::equal_bytes(result_type, "i8") {
        return "0";
    }
    if std::mem::equal_bytes(result_type, "i64") {
        return "0";
    }
    if std::mem::equal_bytes(result_type, "void") {
        return "";
    }
    return "null";
}

// function_param_llvm_type maps a Kizu parameter type start token to LLVM.
fn function_param_llvm_type(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let typ = try tokens.at(start);
    if typ.kind == token::TokenKind::LBracket {
        return "ptr";
    }
    if typ.kind == token::TokenKind::Amp {
        return "ptr";
    }
    if std::mem::equal_bytes(typ.literal, "bool") {
        return "i1";
    }
    if std::mem::equal_bytes(typ.literal, "u8") {
        return "i8";
    }
    if std::mem::equal_bytes(typ.literal, "i8") {
        return "i8";
    }
    if std::mem::equal_bytes(typ.literal, "i64") {
        return "i64";
    }
    return "ptr";
}

// next_function_param skips one source parameter type.
fn next_function_param(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Comma {
            return index + 1;
        }
        if current.kind == token::TokenKind::RParen {
            return index;
        }
        index = index + 1;
    }
    return index;
}

// build_string_literal_function_symbol builds a simple []const u8 literal return.
fn build_string_literal_function_symbol(
    module_path: []const u8,
    name: []const u8,
    literal: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    let global = module_string_global(module_path, name);

    try text.append_bytes(global);
    try text.append_bytes(" = private unnamed_addr constant [");
    try text.append_bytes(module_string_length_text(module_path, name));
    try text.append_bytes(" x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes(literal);
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("define ptr @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    try text.append_bytes("() { ret ptr ");
    try text.append_bytes(global);
    try text.append_bytes(" }");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_ascii_digit_function_symbol builds the lexer byte range check body.
fn build_ascii_digit_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ascii_digit(i8 %byte) {
  %ge = icmp uge i8 %byte, 48
  %le = icmp ule i8 %byte, 57
  %ok = and i1 %ge, %le
  ret i1 %ok
}
");
    return text;
}

// build_ascii_space_function_symbol builds the lexer whitespace predicate.
fn build_ascii_space_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ascii_space(i8 %byte) {
  %space = icmp eq i8 %byte, 32
  %newline = icmp eq i8 %byte, 10
  %tab = icmp eq i8 %byte, 9
  %cr = icmp eq i8 %byte, 13
  %or0 = or i1 %space, %newline
  %or1 = or i1 %tab, %cr
  %ok = or i1 %or0, %or1
  ret i1 %ok
}
");
    return text;
}

// build_compile_command_wrapper_function_symbol builds check/build source wrappers.
fn build_compile_command_wrapper_function_symbol(name: []const u8) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    if std::mem::equal_bytes(name, "check_source") {
        return build_check_source_function_symbol();
    }
    try text.append_bytes("@.str.compiler.command.build = private unnamed_addr constant ");
    try text.append_bytes("[6 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("build");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("define ptr @compiler.build_source(ptr %source, ptr %target_name) {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %report = call ptr @compiler.compile_source(ptr %source, ptr ");
    try text.append_bytes("%target_name)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %command = call ptr @compiler.command_report(ptr ");
    try text.append_bytes("@.str.compiler.command.build, ptr %target_name, ptr %report)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret ptr %command");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_check_source_function_symbol builds the check command wrapper.
fn build_check_source_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("@.str.compiler.command.check = private unnamed_addr constant ");
    try text.append_bytes("[6 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("check");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.compiler.target.llvm = private unnamed_addr constant ");
    try text.append_bytes("[5 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("llvm");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("define ptr @compiler.check_source(ptr %source) {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %report = call ptr @compiler.compile_source(ptr %source, ptr ");
    try text.append_bytes("@.str.compiler.target.llvm)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %command = call ptr @compiler.command_report(ptr ");
    try text.append_bytes("@.str.compiler.command.check, ptr ");
    try text.append_bytes("@.str.compiler.target.llvm, ptr %report)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret ptr %command");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_compile_source_function_symbol builds the source compile report body.
fn build_compile_source_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try append_compile_source_globals(text);
    try append_compile_source_header(text);
    try append_compile_source_entry(text);
    try append_compile_source_failure(text);
    try append_compile_source_success(text);
    try text.append_byte(cast<u8>(125));
    try text.append_byte(cast<u8>(10));
    return text;
}

// append_compile_source_globals appends supported target constants.
fn append_compile_source_globals(text: &mut std::string::String) -> !void {
    try text.append_bytes("@.str.compiler.compile.target.llvm = private unnamed_addr constant ");
    try text.append_bytes("[5 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("llvm");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.compiler.compile.target.wasi = private unnamed_addr constant ");
    try text.append_bytes("[12 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("wasm32-wasi");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.compiler.compile.target.native = private unnamed_addr constant ");
    try text.append_bytes("[21 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("aarch64-apple-darwin");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    return void;
}

// append_compile_source_header appends the compile_source signature.
fn append_compile_source_header(text: &mut std::string::String) -> !void {
    try text.append_bytes("define ptr @compiler.compile_source(ptr %source, ptr %target_name) ");
    try text.append_byte(cast<u8>(123));
    return void;
}

// append_compile_source_entry appends phase calls and branch selection.
fn append_compile_source_entry(text: &mut std::string::String) -> !void {
    try text.append_bytes("
entry:
  %frontend = call ptr @compiler.lex_and_parse_source(ptr %source)
  %diagnostic_text = call ptr @types.source_diagnostic(ptr %source)
  %diag_empty = call i1 @kizu_bytes_equal(ptr %diagnostic_text, ptr @.str.compiler.empty)
  %token_in = getelementptr inbounds %struct.compiler.FrontendReport, ptr %frontend, i64 0, i32 0
  %token_count = load i64, ptr %token_in
  %fn_in = getelementptr inbounds %struct.compiler.FrontendReport, ptr %frontend, i64 0, i32 3
  %function_count = load i64, ptr %fn_in
  %struct_in = getelementptr inbounds %struct.compiler.FrontendReport, ptr %frontend, i64 0, i32 5
  %struct_count = load i64, ptr %struct_in
  %enum_in = getelementptr inbounds %struct.compiler.FrontendReport, ptr %frontend, i64 0, i32 6
  %enum_count = load i64, ptr %enum_in
  %union_in = getelementptr inbounds %struct.compiler.FrontendReport, ptr %frontend, i64 0, i32 7
  %union_count = load i64, ptr %union_in
  %struct_enum = add i64 %struct_count, %enum_count
  %type_count = add i64 %struct_enum, %union_count
  %is_llvm = call i1 @kizu_bytes_equal(ptr %target_name, ptr @.str.compiler.compile.target.llvm)
  %is_wasi = call i1 @kizu_bytes_equal(ptr %target_name, ptr @.str.compiler.compile.target.wasi)
  %is_native = call i1 @kizu_bytes_equal(ptr %target_name, ptr @.str.compiler.compile.target.native)
  %wasm_or_llvm = or i1 %is_llvm, %is_wasi
  %supported = or i1 %wasm_or_llvm, %is_native
  br i1 %diag_empty, label %pass, label %fail
");
    return void;
}

// append_compile_source_failure appends the diagnostic failure report.
fn append_compile_source_failure(text: &mut std::string::String) -> !void {
    try text.append_bytes("
fail:
  %fail_out = call ptr @malloc(i64 64)
  %fail_status = getelementptr inbounds %struct.compiler.CompileReport, ptr %fail_out, i64 0, i32 0
  store ptr @.str.compiler.status.fail, ptr %fail_status
  %fail_tokens = getelementptr inbounds %struct.compiler.CompileReport, ptr %fail_out, i64 0, i32 1
  store i64 %token_count, ptr %fail_tokens
  %fail_fn = getelementptr inbounds %struct.compiler.CompileReport, ptr %fail_out, i64 0, i32 2
  store i64 %function_count, ptr %fail_fn
  %fail_types = getelementptr inbounds %struct.compiler.CompileReport, ptr %fail_out, i64 0, i32 3
  store i64 %type_count, ptr %fail_types
  %fail_own = getelementptr inbounds %struct.compiler.CompileReport, ptr %fail_out, i64 0, i32 4
  store i64 0, ptr %fail_own
  %fail_ir = getelementptr inbounds %struct.compiler.CompileReport, ptr %fail_out, i64 0, i32 5
  store i64 0, ptr %fail_ir
  %fail_backend = getelementptr inbounds %struct.compiler.CompileReport, ptr %fail_out, i64 0, i32 6
  store i1 false, ptr %fail_backend
  %fail_diag = getelementptr inbounds %struct.compiler.CompileReport, ptr %fail_out, i64 0, i32 7
  store ptr %diagnostic_text, ptr %fail_diag
  ret ptr %fail_out
");
    return void;
}

// append_compile_source_success appends the successful report constructor.
fn append_compile_source_success(text: &mut std::string::String) -> !void {
    try text.append_bytes("
pass:
  %out = call ptr @malloc(i64 64)
  %status = getelementptr inbounds %struct.compiler.CompileReport, ptr %out, i64 0, i32 0
  store ptr @.str.compiler.status.pass, ptr %status
  %tokens = getelementptr inbounds %struct.compiler.CompileReport, ptr %out, i64 0, i32 1
  store i64 %token_count, ptr %tokens
  %functions = getelementptr inbounds %struct.compiler.CompileReport, ptr %out, i64 0, i32 2
  store i64 %function_count, ptr %functions
  %types = getelementptr inbounds %struct.compiler.CompileReport, ptr %out, i64 0, i32 3
  store i64 %type_count, ptr %types
  %ownership = getelementptr inbounds %struct.compiler.CompileReport, ptr %out, i64 0, i32 4
  store i64 3, ptr %ownership
  %ir = getelementptr inbounds %struct.compiler.CompileReport, ptr %out, i64 0, i32 5
  store i64 %function_count, ptr %ir
  %backend = getelementptr inbounds %struct.compiler.CompileReport, ptr %out, i64 0, i32 6
  store i1 %supported, ptr %backend
  %diagnostic = getelementptr inbounds %struct.compiler.CompileReport, ptr %out, i64 0, i32 7
  store ptr @.str.compiler.empty, ptr %diagnostic
  ret ptr %out
");
    return void;
}

