    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store ptr %target_name, ptr %target_slot");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %status_slot = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CommandReport, ");
    try text.append_bytes("ptr %out, i64 0, i32 2");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store ptr %status, ptr %status_slot");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %emitted_slot = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CommandReport, ");
    try text.append_bytes("ptr %out, i64 0, i32 3");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store i1 %emitted, ptr %emitted_slot");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %diagnostic_slot = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CommandReport, ptr %out, i64 0, i32 4");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store ptr %diagnostic, ptr %diagnostic_slot");
    try text.append_byte(cast<u8>(10));
    return void;
}

// build_selfhost_package_target_function_symbol builds the package path predicate.
fn build_selfhost_package_target_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("@.str.selfhost_target.0 = private unnamed_addr constant [9 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("selfhost");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.selfhost_target.1 = private unnamed_addr constant [15 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("../../selfhost");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.selfhost_target.2 = private unnamed_addr constant [19 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("selfhost/kizu.toml");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("define i1 @is_selfhost_package_target(ptr %path) {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %match0 = call i1 @kizu_bytes_equal(ptr %path, ptr ");
    try text.append_bytes("@.str.selfhost_target.0)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %match1 = call i1 @kizu_bytes_equal(ptr %path, ptr ");
    try text.append_bytes("@.str.selfhost_target.1)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %or0 = or i1 %match0, %match1");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %match2 = call i1 @kizu_bytes_equal(ptr %path, ptr ");
    try text.append_bytes("@.str.selfhost_target.2)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %ok = or i1 %or0, %match2");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret i1 %ok");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_ascii_alpha_function_symbol builds the lexer ASCII letter predicate.
fn build_ascii_alpha_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ascii_alpha(i8 %byte) {
  %upper_ge = icmp uge i8 %byte, 65
  %upper_le = icmp ule i8 %byte, 90
  %upper = and i1 %upper_ge, %upper_le
  %lower_ge = icmp uge i8 %byte, 97
  %lower_le = icmp ule i8 %byte, 122
  %lower = and i1 %lower_ge, %lower_le
  %ok = or i1 %upper, %lower
  ret i1 %ok
}
");
    return text;
}

// build_ident_start_function_symbol builds the lexer identifier-start predicate.
fn build_ident_start_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ident_start(i8 %byte) {
  %alpha = call i1 @lexer.is_ascii_alpha(i8 %byte)
  %underscore = icmp eq i8 %byte, 95
  %ok = or i1 %alpha, %underscore
  ret i1 %ok
}
");
    return text;
}

// build_ident_continue_function_symbol builds the lexer identifier-continuation predicate.
fn build_ident_continue_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ident_continue(i8 %byte) {
  %start = call i1 @lexer.is_ident_start(i8 %byte)
  %digit = call i1 @lexer.is_ascii_digit(i8 %byte)
  %ok = or i1 %start, %digit
  ret i1 %ok
}
");
    return text;
}

// build_try_call_function_symbol builds a no-arg `return try callee();` wrapper.
fn build_try_call_function_symbol(
    module_path: []const u8,
    name: []const u8,
    callee: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define ptr @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    try text.append_bytes("() {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %result = call ptr @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(callee);
    try text.append_bytes("()");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret ptr %result");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_mem_len_function_symbol builds one concrete std::mem::len wrapper.
fn build_mem_len_function_symbol(
    module_path: []const u8,
    name: []const u8,
    param: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i64 @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    try text.append_bytes("(ptr %");
    try text.append_bytes(param);
    try text.append_bytes(") {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %len = call i64 @kizu_bytes_len(ptr %");
    try text.append_bytes(param);
    try text.append_bytes(")");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret i64 %len");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// function_has_single_bool_return detects a body containing only one bool return.
fn function_has_single_bool_return(
    tokens: &std::array::Array<token::Token>,
    start: i64,
    value: token::TokenKind
) -> !bool {
    let returns_bool = try function_returns_bool(tokens, start);
    if !returns_bool {
        return false;
    }
    let index = try function_body_start(tokens, start);
    if index < 0 {
        return false;
    }
    if index + 3 >= tokens.len() {
        return false;
    }
    let ret = try tokens.at(index);
    let literal = try tokens.at(index + 1);
    let semicolon = try tokens.at(index + 2);
    let close = try tokens.at(index + 3);
    if ret.kind != token::TokenKind::Return {
        return false;
    }
    if literal.kind != value {
        return false;
    }
    if semicolon.kind != token::TokenKind::Semicolon {
        return false;
    }
    return close.kind == token::TokenKind::RBrace;
}

// function_has_single_string_literal_return detects simple []const u8 literals.
fn function_has_single_string_literal_return(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    let returns_bytes = try function_returns_bytes(tokens, start);
    if !returns_bytes {
        return false;
    }
    let no_params = try function_has_no_params(tokens, start);
    if !no_params {
        return false;
    }
    let index = try function_body_start(tokens, start);
    if index < 0 {
        return false;
    }
    if index + 3 >= tokens.len() {
        return false;
    }
    let ret = try tokens.at(index);
    let literal = try tokens.at(index + 1);
    let semi = try tokens.at(index + 2);
    let close = try tokens.at(index + 3);
    if ret.kind != token::TokenKind::Return {
        return false;
    }
    if literal.kind != token::TokenKind::String {
        return false;
    }
    let simple = try string_literal_is_llvm_simple(literal.literal);
    if !simple {
        return false;
    }
    if semi.kind != token::TokenKind::Semicolon {
        return false;
    }
    return close.kind == token::TokenKind::RBrace;
}

// function_string_return_literal returns the literal from an exact string body.
fn function_string_return_literal(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let index = try function_body_start(tokens, start);
    let literal = try tokens.at(index + 1);
    return literal.literal;
}

// string_literal_is_llvm_simple rejects bytes needing LLVM c-string escaping.
fn string_literal_is_llvm_simple(literal: []const u8) -> !bool {
    var index = 0;
    let length = std::mem::len(literal);

    while index < length {
        let byte = try std::mem::byte_at(literal, index);
        if byte == cast<u8>(10) {
            return false;
        }
        if byte == cast<u8>(34) {
            return false;
        }
        if byte == cast<u8>(92) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// function_is_ascii_digit_body detects the canonical lexer digit range check.
fn function_is_ascii_digit_body(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if !std::mem::equal_bytes(module_path, "selfhost::lexer") {
        return false;
    }
    if !std::mem::equal_bytes(name, "is_ascii_digit") {
        return false;
    }
    if !try function_returns_bool(tokens, start) {
        return false;
    }
    return try function_first_param_is_u8(tokens, start);
}

