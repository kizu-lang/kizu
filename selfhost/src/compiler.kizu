}

// function_is_types_source_diagnostic_body identifies type diagnostic summary.
fn function_is_types_source_diagnostic_body(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost::types") {
