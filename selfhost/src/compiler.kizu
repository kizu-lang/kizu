entry:
  %tokens = call ptr @lexer.lex(ptr %source)
  %parsed = call ptr @parser.parse_token_stream(ptr %tokens)
  %imports_in = getelementptr inbounds %struct.ast.ParseSummary, ptr %parsed, i64 0, i32 1
  %imports = load i64, ptr %imports_in
  ret i64 %imports
");
    try text.append_byte(cast<u8>(125));
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_merge_package_report_function_symbol builds aggregate package merging.
fn build_merge_package_report_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try append_merge_package_report_header(text);
    try append_merge_package_report_loads(text);
    try append_merge_package_report_stores(text);
    try text.append_bytes("  ret ptr %out");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// append_merge_package_report_header appends allocation and status merge setup.
fn append_merge_package_report_header(text: &mut std::string::String) -> !void {
    try text.append_bytes("define ptr @compiler.merge_package_report(ptr %current, ptr %next) ");
    try text.append_byte(cast<u8>(123));
    try text.append_bytes("
entry:
  %out = call ptr @malloc(i64 96)
  %ls_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 0
  %ls = load ptr, ptr %ls_in
  %rs_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 0
  %rs = load ptr, ptr %rs_in
  %merged_status = call ptr @compiler.merge_status(ptr %ls, ptr %rs)
");
    return void;
}

// append_merge_package_report_loads appends counter and field reads.
fn append_merge_package_report_loads(text: &mut std::string::String) -> !void {
    try text.append_bytes("
  %module_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 1
  %module_count = load i64, ptr %module_in
  %lc_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 2
  %left_compiled = load i64, ptr %lc_in
  %rc_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 2
  %right_compiled = load i64, ptr %rc_in
  %compiled_sum = add i64 %left_compiled, %right_compiled
  %lt_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 3
  %left_tokens = load i64, ptr %lt_in
  %right_tokens_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 3
  %right_tokens = load i64, ptr %right_tokens_in
  %tokens_sum = add i64 %left_tokens, %right_tokens
  %left_fn_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 4
  %left_fn = load i64, ptr %left_fn_in
  %right_fn_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 4
  %right_fn = load i64, ptr %right_fn_in
  %fn_sum = add i64 %left_fn, %right_fn
  %li_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 5
  %left_imports = load i64, ptr %li_in
  %right_imports_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 5
  %right_imports = load i64, ptr %right_imports_in
  %imports_sum = add i64 %left_imports, %right_imports
");
    return void;
}

// append_merge_package_report_stores appends aggregate stores and return fields.
fn append_merge_package_report_stores(text: &mut std::string::String) -> !void {
    try text.append_bytes("
  %left_types_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 6
  %left_types = load i64, ptr %left_types_in
  %right_types_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 6
  %right_types = load i64, ptr %right_types_in
  %types_sum = add i64 %left_types, %right_types
  %left_own_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 7
  %left_own = load i64, ptr %left_own_in
  %right_own_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 7
  %right_own = load i64, ptr %right_own_in
  %own_sum = add i64 %left_own, %right_own
  %left_ir_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 8
  %left_ir = load i64, ptr %left_ir_in
  %right_ir_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 8
  %right_ir = load i64, ptr %right_ir_in
  %ir_sum = add i64 %left_ir, %right_ir
  %backend_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 9
  %backend = load i1, ptr %backend_in
  %root_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %current, i64 0, i32 10
  %root = load i1, ptr %root_in
  %diag_in = getelementptr inbounds %struct.compiler.PackageReport, ptr %next, i64 0, i32 11
  %diag = load ptr, ptr %diag_in
  %s_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 0
  store ptr %merged_status, ptr %s_out
  %m_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 1
  store i64 %module_count, ptr %m_out
  %c_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 2
  store i64 %compiled_sum, ptr %c_out
  %t_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 3
  store i64 %tokens_sum, ptr %t_out
  %f_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 4
  store i64 %fn_sum, ptr %f_out
  %i_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 5
  store i64 %imports_sum, ptr %i_out
  %ty_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 6
  store i64 %types_sum, ptr %ty_out
  %o_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 7
