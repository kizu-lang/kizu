// Module: compiler pipeline boundary for the future self-host compiler.

import selfhost::ast;
import selfhost::backend;
import selfhost::ir;
import selfhost::lexer;
import selfhost::ownership;
import selfhost::parser;
import selfhost::resolver;
import selfhost::token;
import selfhost::types;

pub enum CompileStatus {
    Pass
    Fail
}

pub struct CompileReport {
    pub status: CompileStatus;
    pub token_count: i64;
    pub function_count: i64;
    pub type_count: i64;
    pub ownership_checks: i64;
    pub ir_function_count: i64;
    pub backend_emitted: bool;
    pub diagnostic: []const u8;
}

pub struct FrontendReport {
    pub token_count: i64;
    pub first_kind: token::TokenKind;
    pub eof_kind: token::TokenKind;
    pub function_count: i64;
    pub import_count: i64;
    pub struct_count: i64;
    pub enum_count: i64;
    pub union_count: i64;
    pub return_count: i64;
}

pub struct SourceModule {
    pub path: []const u8;
    pub source: []const u8;
    pub is_root: bool;
    pub is_test: bool;
}

pub struct PackageManifest {
    pub package_root: []const u8;
    pub root_file: []const u8;
    pub source: []const u8;
}

pub struct ModuleSpec {
    pub path: []const u8;
    pub file: []const u8;
}

pub struct PackageReport {
    pub status: CompileStatus;
    pub module_count: i64;
    pub compiled_module_count: i64;
    pub token_count: i64;
    pub function_count: i64;
    pub import_count: i64;
    pub type_count: i64;
    pub ownership_checks: i64;
    pub ir_function_count: i64;
    pub backend_emitted: bool;
    pub root_found: bool;
    pub diagnostic: []const u8;
}

pub struct CommandReport {
    pub command: []const u8;
    pub target: []const u8;
    pub status: CompileStatus;
    pub backend_emitted: bool;
    pub diagnostic: []const u8;
}

// status_name returns the CLI spelling for a compile status.
pub fn status_name(status: CompileStatus) -> []const u8 {
    if status == CompileStatus::Pass {
        return "pass";
    }
    return "fail";
}

// compile_source runs the self-host phase order over one source buffer.
pub fn compile_source(source: []const u8, target_name: []const u8) -> !CompileReport {
    let frontend = try lex_and_parse_source(source);
    let parsed = ast::ParseSummary {
        function_count: frontend.function_count,
        import_count: frontend.import_count,
        struct_count: frontend.struct_count,
        enum_count: frontend.enum_count,
        union_count: frontend.union_count,
        return_count: frontend.return_count,
    };
    let diagnostic = try types::source_diagnostic(source);
    if !std::mem::equal_bytes(diagnostic, "") {
        return CompileReport {
            status: CompileStatus::Fail,
            token_count: frontend.token_count,
            function_count: parsed.function_count,
            type_count: parsed.struct_count + parsed.enum_count + parsed.union_count,
            ownership_checks: 0,
            ir_function_count: 0,
            backend_emitted: false,
            diagnostic: diagnostic,
        };
    }
    let typed = try type_summary(&parsed);
    let ownership_report = ownership_summary(&typed);
    let lowered = ir::module(parsed.function_count, parsed.function_count, parsed.return_count);
    let target_info = backend::target(target_name);
    let artifact = backend::artifact(
        &target_info,
        lowered.function_count,
        lowered.instruction_count
    );

    return CompileReport {
        status: CompileStatus::Pass,
        token_count: frontend.token_count,
        function_count: parsed.function_count,
        type_count: typed.type_count,
        ownership_checks: ownership_report.check_count,
        ir_function_count: lowered.function_count,
        backend_emitted: artifact.emitted,
        diagnostic: "",
    };
}

// check_source runs the CLI check path over one source buffer.
pub fn check_source(source: []const u8) -> !CommandReport {
    let report = try compile_source(source, "llvm");
    return command_report("check", "llvm", report);
}

// build_source runs the CLI build path over one source buffer and target.
pub fn build_source(source: []const u8, target_name: []const u8) -> !CommandReport {
    let report = try compile_source(source, target_name);
    return command_report("build", target_name, report);
}

// command_report converts a compile report into CLI-facing command facts.
fn command_report(
    command: []const u8,
    target_name: []const u8,
    report: CompileReport
) -> CommandReport {
    return CommandReport {
        command: command,
        target: target_name,
        status: report.status,
        backend_emitted: report.backend_emitted,
        diagnostic: report.diagnostic,
    };
}

// lex_and_parse_source runs the Kizu-native lexer token stream into the parser.
pub fn lex_and_parse_source(source: []const u8) -> !FrontendReport {
    var tokens = try lexer::lex(source);
    token::ready();
    let parsed = try parser::parse_token_stream(tokens);
    let first = try tokens.at(0);
    let eof = try tokens.at(tokens.len() - 1);

    return FrontendReport {
        token_count: tokens.len(),
        first_kind: first.kind,
        eof_kind: eof.kind,
        function_count: parsed.function_count,
        import_count: parsed.import_count,
        struct_count: parsed.struct_count,
        enum_count: parsed.enum_count,
        union_count: parsed.union_count,
        return_count: parsed.return_count,
    };
}

// lex_file_snapshot prints Kizu-owned lexer facts for one process argument path.
pub fn lex_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try print_token_snapshot(source);
    return void;
}

// print_token_snapshot writes the complete Kizu lexer token stream.
pub fn print_token_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    var index = 0;

    print("selfhost lexer token snapshots");
    while index < tokens.len() {
        let current = try tokens.at(index);
        print(token::kind_name(current.kind));
        print(current.literal);
        print(current.start);
        print(current.end);
        print(current.line);
        print(current.column);
        index = index + 1;
    }
    print("selfhost lexer token snapshots end");
    return void;
}

// parse_file_snapshot prints Kizu-owned parser facts for one process argument path.
pub fn parse_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try print_parser_snapshot(source);
    return void;
}

// resolve_file_snapshot prints Kizu-owned resolver facts for one source path.
pub fn resolve_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try resolver::print_module_graph_snapshot(source);
    try resolver::print_resolver_diagnostic_snapshot(source, path);
    return void;
}

// type_file_snapshot prints Kizu-owned type checker facts for one source path.
pub fn type_file_snapshot() -> !void {
    let path = try std::process::arg(0);
    let io = std::io::blocking();
    let source = try std::fs::read_file(io, path);
    try types::print_type_snapshot(source);
    try types::print_type_env_snapshot(source);
    try types::print_type_check_snapshot(source);
    return void;
}

// print_parser_snapshot writes selected parser AST facts, spans, and diagnostics.
pub fn print_parser_snapshot(source: []const u8) -> !void {
    var tokens = try lexer::lex(source);
    let declarations = try parser::parse_declarations(tokens);
    var index = 0;

    print("selfhost parser declaration snapshots");
    while index < declarations.len() {
        let current = try declarations.at(index);
        print(ast_node_kind_name(current.kind));
        print(current.name);
        print(current.span.start);
        print(current.span.end);
        print(current.span.line);
        print(current.span.column);
        index = index + 1;
    }
    print("selfhost parser declaration snapshots end");
    try parser::print_detail_snapshot(tokens);
    return void;
}

// ast_node_kind_name returns stable parser snapshot names for declaration kinds.
fn ast_node_kind_name(kind: ast::NodeKind) -> []const u8 {
    if kind == ast::NodeKind::Import {
        return "ImportDecl";
    }
    if kind == ast::NodeKind::Function {
        return "FunctionDecl";
    }
    if kind == ast::NodeKind::Struct {
        return "StructDecl";
    }
    if kind == ast::NodeKind::Enum {
        return "EnumDecl";
    }
    if kind == ast::NodeKind::Union {
        return "UnionDecl";
    }
    if kind == ast::NodeKind::Contract {
        return "ContractDecl";
    }
    if kind == ast::NodeKind::Impl {
        return "ImplDecl";
    }
    if kind == ast::NodeKind::Satisfy {
        return "SatisfyDecl";
    }
    return "UnknownDecl";
}

// compile_package runs the self-host package pipeline over explicit sources.
pub fn compile_package(
    modules: &std::array::Array<SourceModule>,
    target_name: []const u8
) -> !PackageReport {
    var report = empty_package_report();
    var index = 0;

    while index < modules.len() {
        let module = try modules.at(index);
        report.module_count = report.module_count + 1;
        if module_is_root(&module) {
            report.root_found = true;
        }
        if !module.is_test {
            let next = try compile_package_module(&module);
            report = merge_package_report(report, &next);
        }
        index = index + 1;
    }
    return finish_package_report(report, target_name);
}

// compile_self_check compiles the checked-in self-host package from files.
pub fn compile_self_check() -> !PackageReport {
    return try compile_selfhost_package_check();
}

// compile_selfhost_package_check keeps the old entry name on the file-backed path.
pub fn compile_selfhost_package_check() -> !PackageReport {
    let io = std::io::blocking();
    return try compile_selfhost_package_from_files(io);
}

// compile_selfhost_package_from_files loads the checked-in package through std::fs.
pub fn compile_selfhost_package_from_files(io: Io) -> !PackageReport {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    return try compile_package(&modules, "llvm");
}

// load_selfhost_package_from_files validates filesystem-backed package discovery.
pub fn load_selfhost_package_from_files(io: Io) -> !PackageReport {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    return try summarize_loaded_package(&modules);
}

// write_selfhost_package_llvm_from_files emits function symbols from real modules.
pub fn write_selfhost_package_llvm_from_files(io: Io) -> !void {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    try write_package_llvm_symbols(io, &modules);
    return void;
}

// write_selfhost_package_llvm_file_from_files writes module-derived LLVM text.
pub fn write_selfhost_package_llvm_file_from_files(io: Io, path: []const u8) -> !void {
    let manifest = try read_selfhost_manifest(io);
    let allocator = std::mem::page_allocator();
    var modules = std::array::Array<SourceModule>(allocator);

    try append_manifest_modules(io, &manifest, modules);
    var text = try build_package_llvm_symbols(&modules);
    let bytes = text.as_bytes();
    try std::fs::write_file(io, path, bytes);
    text.deinit();
    return void;
}

// append_manifest_modules loads compiler modules described by the manifest roots.
fn append_manifest_modules(
    io: Io,
    manifest: &PackageManifest,
    modules: &mut std::array::Array<SourceModule>
) -> !void {
    let allocator = std::mem::page_allocator();
    var specs = std::array::Array<ModuleSpec>(allocator);
    try append_manifest_module_specs(manifest.source, specs);

    var index = 0;
    while index < specs.len() {
        let spec = try specs.at(index);
        try modules.append(try read_manifest_module(io, manifest, &spec));
        index = index + 1;
    }
    return void;
}

// append_manifest_module_specs records module specs declared in kizu.toml.
fn append_manifest_module_specs(
    source: []const u8,
    modules: &mut std::array::Array<ModuleSpec>
) -> !void {
    var start = 0;
    let length = std::mem::len(source);

    while start < length {
        let end = try manifest_line_end(source, start);
        let line = try std::mem::slice(source, start, end);
        if std::mem::starts_with(line, "entries") {
            var cursor = 0;
            let line_length = std::mem::len(line);
            while cursor < line_length {
                let first = try manifest_quote_after(line, cursor);
                if first >= line_length {
                    cursor = line_length;
                } else {
                    let second = try manifest_quote_after(line, first + 1);
                    if second >= line_length {
                        return error("invalid selfhost manifest entry");
                    }
                    let item = try std::mem::slice(line, first + 1, second);
                    if !try manifest_module_is_test(item) {
                        try modules.append(try manifest_module_spec(item));
                    }
                    cursor = second + 1;
                }
            }
        }
        start = end + 1;
    }
    if modules.len() == 0 {
        return error("missing selfhost manifest entries");
    }
    return void;
}

// manifest_module_spec parses one `module|file` manifest item.
fn manifest_module_spec(item: []const u8) -> !ModuleSpec {
    let sep = try manifest_pipe_offset(item);
    let length = std::mem::len(item);
    if sep >= length {
        return error("invalid selfhost manifest entry");
    }
    let next = try manifest_pipe_offset_after(item, sep + 1);
    let module_path = try std::mem::slice(item, 0, sep);
    if next >= length {
        let file_path = try std::mem::slice(item, sep + 1, length);
        return module_spec(module_path, file_path);
    }
    let file_path = try std::mem::slice(item, sep + 1, next);
    let marker = try std::mem::slice(item, next + 1, length);
    if !std::mem::equal_bytes(marker, "test") {
        return error("invalid selfhost manifest entry marker");
    }
    return module_spec(module_path, file_path);
}

// manifest_module_is_test reports whether one manifest item is test-only.
fn manifest_module_is_test(item: []const u8) -> !bool {
    let sep = try manifest_pipe_offset(item);
    let length = std::mem::len(item);
    if sep >= length {
        return error("invalid selfhost manifest entry");
    }
    let next = try manifest_pipe_offset_after(item, sep + 1);
    if next >= length {
        return false;
    }
    let marker = try std::mem::slice(item, next + 1, length);
    if std::mem::equal_bytes(marker, "test") {
        return true;
    }
    return error("invalid selfhost manifest entry marker");
}

// manifest_pipe_offset returns the separator offset in one module item.
fn manifest_pipe_offset(item: []const u8) -> !i64 {
    return try manifest_pipe_offset_after(item, 0);
}

// manifest_pipe_offset_after returns the separator offset at or after start.
fn manifest_pipe_offset_after(item: []const u8, start: i64) -> !i64 {
    var index = start;
    let length = std::mem::len(item);

    while index < length {
        let byte = try std::mem::byte_at(item, index);
        if byte == cast<u8>(124) {
            return index;
        }
        index = index + 1;
    }
    return length;
}

// module_spec constructs one manifest graph candidate.
fn module_spec(path: []const u8, file: []const u8) -> ModuleSpec {
    return ModuleSpec {
        path: path,
        file: file,
    };
}

// read_manifest_module loads one source file from the manifest source root.
fn read_manifest_module(
    io: Io,
    manifest: &PackageManifest,
    spec: &ModuleSpec
) -> !SourceModule {
    let path = std::path::join(manifest.package_root, spec.file);
    let root = std::mem::equal_bytes(path, manifest.root_file);
    return try read_source_file(io, spec.path, path, root);
}

// read_selfhost_manifest loads and validates the checked-in manifest subset.
fn read_selfhost_manifest(io: Io) -> !PackageManifest {
    let root = try selfhost_package_root(io);
    let source = try std::fs::read_file(io, try selfhost_manifest_file(root));
    if std::mem::len(source) == 0 {
        return error("empty selfhost manifest");
    }
    let valid_name = try manifest_has_value(source, "name", "selfhost");
    if !valid_name {
        return error("invalid selfhost manifest package");
    }
    let valid_root = try manifest_has_value(source, "root", "src/main.kizu");
    if !valid_root {
        return error("invalid selfhost manifest root");
    }
    let valid_paths = try manifest_has_value(source, "paths", "src");
    if !valid_paths {
        return error("invalid selfhost manifest paths");
    }
    return PackageManifest {
        package_root: root,
        root_file: std::path::join(root, "src/main.kizu"),
        source: source,
    };
}

// selfhost_manifest_file returns the manifest path for a selected package root.
fn selfhost_manifest_file(root: []const u8) -> ![]const u8 {
    if std::mem::equal_bytes(root, "selfhost") {
        return "selfhost/kizu.toml";
    }
    if std::mem::equal_bytes(root, "../../selfhost") {
        return "../../selfhost/kizu.toml";
    }
    return error("missing selfhost package file");
}

// selfhost_package_root selects the checked-in package root from common CWDs.
fn selfhost_package_root(io: Io) -> ![]const u8 {
    let root_exists = try std::fs::exists(io, "selfhost/kizu.toml");
    if root_exists {
        return "selfhost";
    }
    let package_test_exists = try std::fs::exists(io, "../../selfhost/kizu.toml");
    if package_test_exists {
        return "../../selfhost";
    }
    return error("missing selfhost package file");
}

// manifest_has_value reports whether a manifest key has a quoted value.
fn manifest_has_value(source: []const u8, key: []const u8, value: []const u8) -> !bool {
    var start = 0;
    let length = std::mem::len(source);

    while start < length {
        let end = try manifest_line_end(source, start);
        let line = try std::mem::slice(source, start, end);
        if std::mem::starts_with(line, key) {
            if try manifest_line_value_matches(line, value) {
                return true;
            }
        }
        start = end + 1;
    }
    return false;
}

// manifest_line_value_matches compares the first quoted value on a line.
fn manifest_line_value_matches(line: []const u8, value: []const u8) -> !bool {
    let length = std::mem::len(line);
    let first = try manifest_quote_after(line, 0);
    if first >= length {
        return false;
    }
    let second = try manifest_quote_after(line, first + 1);
    if second >= length {
        return false;
    }
    let parsed = try std::mem::slice(line, first + 1, second);
    return std::mem::equal_bytes(parsed, value);
}

// manifest_quote_after returns the first quote offset at or after start.
fn manifest_quote_after(line: []const u8, start: i64) -> !i64 {
    var index = start;
    let length = std::mem::len(line);

    while index < length {
        let byte = try std::mem::byte_at(line, index);
        if byte == cast<u8>(34) {
            return index;
        }
        index = index + 1;
    }
    return length;
}

// manifest_line_end returns the end offset for one line without the newline.
fn manifest_line_end(source: []const u8, start: i64) -> !i64 {
    var end = start;
    let length = std::mem::len(source);

    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if byte == cast<u8>(10) {
            return end;
        }
        end = end + 1;
    }
    return end;
}

// read_source_file reads one package module from an explicit filesystem path.
fn read_source_file(
    io: Io,
    module_path: []const u8,
    file_path: []const u8,
    is_root: bool
) -> !SourceModule {
    let source = try std::fs::read_file(io, file_path);
    if std::mem::len(source) == 0 {
        return error("empty package module");
    }
    return source_module(module_path, source, is_root, false);
}

// summarize_loaded_package reports source loading without running full lowering.
fn summarize_loaded_package(modules: &std::array::Array<SourceModule>) -> !PackageReport {
    var report = empty_package_report();
    var index = 0;

    report.status = CompileStatus::Pass;
    while index < modules.len() {
        let module = try modules.at(index);
        report.module_count = report.module_count + 1;
        if !module.is_test {
            report.compiled_module_count = report.compiled_module_count + 1;
        }
        if module_is_root(&module) {
            report.root_found = true;
        }
        index = index + 1;
    }
    return report;
}

// write_package_llvm_symbols emits one valid LLVM stub per compiled function.
fn write_package_llvm_symbols(io: Io, modules: &std::array::Array<SourceModule>) -> !void {
    var index = 0;

    print("; Kizu selfhost package LLVM symbols");
    print("declare ptr @malloc(i64)");
    print("declare i64 @kizu_bytes_len(ptr)");
    print("declare i1 @kizu_bytes_equal(ptr, ptr)");
    try write_selfhost_struct_layouts(io);
    while index < modules.len() {
        let module = try modules.at(index);
        if !module.is_test {
            try write_module_llvm_symbols(io, &module);
        }
        index = index + 1;
    }
    return void;
}

// write_module_llvm_symbols emits stubs for all functions in one module.
fn write_module_llvm_symbols(io: Io, module: &SourceModule) -> !void {
    var tokens = try lexer::lex(module.source);
    var index = 0;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            let name = try tokens.at(index + 1);
            var symbol = try build_function_llvm_symbol(module.path, name.literal, tokens, index);
            let bytes = symbol.as_bytes();
            try std::io::write_stdout(io, bytes);
            symbol.deinit();
        }
        index = index + 1;
    }
    return void;
}

// write_function_symbol emits one opaque LLVM function stub.
fn write_function_symbol(io: Io, module_path: []const u8, name: []const u8) -> !void {
    try std::io::write_stdout(io, "define ptr @");
    try std::io::write_stdout(io, module_symbol_prefix(module_path));
    try std::io::write_stdout(io, name);
    try std::io::write_stdout(io, "() { ret ptr null }");
    print("");
    return void;
}

// write_bool_function_symbol emits one concrete bool-returning LLVM function.
fn write_bool_function_symbol(
    io: Io,
    module_path: []const u8,
    name: []const u8,
    value: []const u8
) -> !void {
    try std::io::write_stdout(io, "define i1 @");
    try std::io::write_stdout(io, module_symbol_prefix(module_path));
    try std::io::write_stdout(io, name);
    try std::io::write_stdout(io, "() { ret i1 ");
    try std::io::write_stdout(io, value);
    try std::io::write_stdout(io, " }");
    print("");
    return void;
}

// write_mem_len_function_symbol emits one concrete std::mem::len wrapper.
fn write_mem_len_function_symbol(
    io: Io,
    module_path: []const u8,
    name: []const u8,
    param: []const u8
) -> !void {
    try std::io::write_stdout(io, "define i64 @");
    try std::io::write_stdout(io, module_symbol_prefix(module_path));
    try std::io::write_stdout(io, name);
    try std::io::write_stdout(io, "(ptr %");
    try std::io::write_stdout(io, param);
    print(") {");
    try std::io::write_stdout(io, "  %len = call i64 @kizu_bytes_len(ptr %");
    try std::io::write_stdout(io, param);
    print(")");
    print("  ret i64 %len");
    print("}");
    return void;
}

// write_selfhost_struct_layouts writes explicit ABI structs used by wrappers.
fn write_selfhost_struct_layouts(io: Io) -> !void {
    var text = try build_selfhost_struct_layouts();
    let bytes = text.as_bytes();

    try std::io::write_stdout(io, bytes);
    text.deinit();
    return void;
}

// build_selfhost_struct_layouts builds explicit ABI structs used by wrappers.
fn build_selfhost_struct_layouts() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("%struct.compiler.CompileReport = type { ptr, i64, ");
    try text.append_bytes("i64, i64, i64, i64, i1, ptr }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.CommandReport = type { ptr, ptr, ptr, i1, ptr }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.PackageReport = type { ptr, i64, ");
    try text.append_bytes("i64, i64, i64, i64, i64, i64, i64, i1, i1, ptr }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.FrontendReport = type { i64, ptr, ");
    try text.append_bytes("ptr, i64, i64, i64, i64, i64, i64 }");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("%struct.compiler.SourceModule = type { ptr, ptr, i1, i1 }");
    try text.append_byte(cast<u8>(10));
    return text;
}

// append_package_llvm_symbols appends valid LLVM stubs for compiled functions.
// build_package_llvm_symbols builds valid LLVM stubs for compiled functions.
fn build_package_llvm_symbols(modules: &std::array::Array<SourceModule>) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    var index = 0;

    try text.append_bytes("; Kizu selfhost package LLVM symbols");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("declare ptr @malloc(i64)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("declare i64 @kizu_bytes_len(ptr)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("declare i1 @kizu_bytes_equal(ptr, ptr)");
    try text.append_byte(cast<u8>(10));
    var layouts = try build_selfhost_struct_layouts();
    let layout_bytes = layouts.as_bytes();
    try text.append_bytes(layout_bytes);
    layouts.deinit();
    while index < modules.len() {
        let module = try modules.at(index);
        if !module.is_test {
            var module_text = try build_module_llvm_symbols(&module);
            let bytes = module_text.as_bytes();
            try text.append_bytes(bytes);
            module_text.deinit();
        }
        index = index + 1;
    }
    return text;
}

// build_module_llvm_symbols builds stubs for all functions in one module.
fn build_module_llvm_symbols(module: &SourceModule) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    var tokens = try lexer::lex(module.source);
    var index = 0;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            let name = try tokens.at(index + 1);
            var symbol = try build_function_llvm_symbol(module.path, name.literal, tokens, index);
            let bytes = symbol.as_bytes();
            try text.append_bytes(bytes);
            symbol.deinit();
        }
        index = index + 1;
    }
    return text;
}

// build_function_llvm_symbol builds the best concrete function body currently supported.
fn build_function_llvm_symbol(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    index: i64
) -> !std::string::String {
    if try function_has_single_bool_return(tokens, index, token::TokenKind::True) {
        return build_bool_function_symbol(module_path, name, "true");
    }
    if try function_has_single_bool_return(tokens, index, token::TokenKind::False) {
        return build_bool_function_symbol(module_path, name, "false");
    }
    if try function_has_single_mem_len_return(tokens, index) {
        let param = try function_first_param_name(tokens, index);
        return build_mem_len_function_symbol(module_path, name, param);
    }
    if try function_has_single_string_literal_return(tokens, index) {
        let literal = try function_string_return_literal(tokens, index);
        if module_string_literal_supported(module_path, name, literal) {
            return build_string_literal_function_symbol(module_path, name, literal);
        }
    }
    if try function_is_ascii_digit_body(module_path, name, tokens, index) {
        return build_ascii_digit_function_symbol(module_path, name);
    }
    if try function_is_ascii_space_body(module_path, name, tokens, index) {
        return build_ascii_space_function_symbol(module_path, name);
    }
    if try function_is_ascii_alpha_body(module_path, name, tokens, index) {
        return build_ascii_alpha_function_symbol(module_path, name);
    }
    if try function_is_ident_start_body(module_path, name, tokens, index) {
        return build_ident_start_function_symbol(module_path, name);
    }
    if try function_is_ident_continue_body(module_path, name, tokens, index) {
        return build_ident_continue_function_symbol(module_path, name);
    }
    if function_is_selfhost_package_target_body(module_path, name) {
        return build_selfhost_package_target_function_symbol();
    }
    if function_is_compile_command_wrapper(module_path, name) {
        return build_compile_command_wrapper_function_symbol(name);
    }
    if function_is_command_report_body(module_path, name) {
        return build_command_report_function_symbol();
    }
    if try function_has_single_try_call_return(tokens, index) {
        let callee = try function_try_call_return_callee(tokens, index);
        return build_try_call_function_symbol(module_path, name, callee);
    }
    return build_pointer_stub_function_symbol(module_path, name, tokens, index);
}

// build_bool_function_symbol builds one concrete bool-returning LLVM function.
fn build_bool_function_symbol(
    module_path: []const u8,
    name: []const u8,
    value: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    try text.append_bytes("() { ret i1 ");
    try text.append_bytes(value);
    try text.append_bytes(" }");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_pointer_stub_function_symbol builds the fallback typed function stub.
fn build_pointer_stub_function_symbol(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    var params = try build_function_param_signature(tokens, start);
    let result_type = try function_return_llvm_type(tokens, start);

    try text.append_bytes("define ");
    try text.append_bytes(result_type);
    try text.append_bytes(" @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    let param_bytes = params.as_bytes();
    try text.append_bytes(param_bytes);
    if std::mem::equal_bytes(result_type, "void") {
        try text.append_bytes(" { ret void }");
    } else {
        try text.append_bytes(" { ret ");
        try text.append_bytes(result_type);
        try text.append_bytes(" ");
        try text.append_bytes(function_stub_return_value(result_type));
        try text.append_bytes(" }");
    }
    try text.append_byte(cast<u8>(10));
    params.deinit();
    return text;
}

// build_function_param_signature builds the LLVM parameter list for stubs.
fn build_function_param_signature(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    var index = start + 2;
    var first = true;
    var done = false;

    try text.append_bytes("(");
    while index < tokens.len() {
        let current = try tokens.at(index);
        if done {
            index = tokens.len();
        } else {
            if current.kind == token::TokenKind::RParen {
                done = true;
            } else {
                if current.kind == token::TokenKind::Ident {
                    if !first {
                        try text.append_bytes(", ");
                    }
                    let colon = try tokens.at(index + 1);
                    if colon.kind == token::TokenKind::Colon {
                        let llvm_type = try function_param_llvm_type(tokens, index + 2);
                        try text.append_bytes(llvm_type);
                        try text.append_bytes(" %");
                        try text.append_bytes(current.literal);
                        first = false;
                        index = try next_function_param(tokens, index + 2);
                    } else {
                        index = index + 1;
                    }
                } else {
                    index = index + 1;
                }
            }
        }
    }
    try text.append_bytes(")");
    return text;
}

// function_return_llvm_type maps a function return type to the stub LLVM type.
fn function_return_llvm_type(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    if try function_returns_type(tokens, start, "bool") {
        return "i1";
    }
    if try function_returns_type(tokens, start, "u8") {
        return "i8";
    }
    if try function_returns_type(tokens, start, "i8") {
        return "i8";
    }
    if try function_returns_type(tokens, start, "i64") {
        return "i64";
    }
    if try function_returns_type(tokens, start, "void") {
        return "void";
    }
    return "ptr";
}

// function_stub_return_value returns the neutral fallback value for one LLVM type.
fn function_stub_return_value(result_type: []const u8) -> []const u8 {
    if std::mem::equal_bytes(result_type, "i1") {
        return "false";
    }
    if std::mem::equal_bytes(result_type, "i8") {
        return "0";
    }
    if std::mem::equal_bytes(result_type, "i64") {
        return "0";
    }
    if std::mem::equal_bytes(result_type, "void") {
        return "";
    }
    return "null";
}

// function_param_llvm_type maps a Kizu parameter type start token to LLVM.
fn function_param_llvm_type(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let typ = try tokens.at(start);
    if typ.kind == token::TokenKind::LBracket {
        return "ptr";
    }
    if typ.kind == token::TokenKind::Amp {
        return "ptr";
    }
    if std::mem::equal_bytes(typ.literal, "bool") {
        return "i1";
    }
    if std::mem::equal_bytes(typ.literal, "u8") {
        return "i8";
    }
    if std::mem::equal_bytes(typ.literal, "i8") {
        return "i8";
    }
    if std::mem::equal_bytes(typ.literal, "i64") {
        return "i64";
    }
    return "ptr";
}

// next_function_param skips one source parameter type.
fn next_function_param(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Comma {
            return index + 1;
        }
        if current.kind == token::TokenKind::RParen {
            return index;
        }
        index = index + 1;
    }
    return index;
}

// build_string_literal_function_symbol builds a simple []const u8 literal return.
fn build_string_literal_function_symbol(
    module_path: []const u8,
    name: []const u8,
    literal: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    let global = module_string_global(module_path, name);

    try text.append_bytes(global);
    try text.append_bytes(" = private unnamed_addr constant [");
    try text.append_bytes(module_string_length_text(module_path, name));
    try text.append_bytes(" x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes(literal);
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("define ptr @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    try text.append_bytes("() { ret ptr ");
    try text.append_bytes(global);
    try text.append_bytes(" }");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_ascii_digit_function_symbol builds the lexer byte range check body.
fn build_ascii_digit_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ascii_digit(i8 %byte) {
  %ge = icmp uge i8 %byte, 48
  %le = icmp ule i8 %byte, 57
  %ok = and i1 %ge, %le
  ret i1 %ok
}
");
    return text;
}

// build_ascii_space_function_symbol builds the lexer whitespace predicate.
fn build_ascii_space_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ascii_space(i8 %byte) {
  %space = icmp eq i8 %byte, 32
  %newline = icmp eq i8 %byte, 10
  %tab = icmp eq i8 %byte, 9
  %cr = icmp eq i8 %byte, 13
  %or0 = or i1 %space, %newline
  %or1 = or i1 %tab, %cr
  %ok = or i1 %or0, %or1
  ret i1 %ok
}
");
    return text;
}

// build_compile_command_wrapper_function_symbol builds check/build source wrappers.
fn build_compile_command_wrapper_function_symbol(name: []const u8) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    if std::mem::equal_bytes(name, "check_source") {
        return build_check_source_function_symbol();
    }
    try text.append_bytes("@.str.compiler.command.build = private unnamed_addr constant ");
    try text.append_bytes("[6 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("build");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("define ptr @compiler.build_source(ptr %source, ptr %target_name) {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %report = call ptr @compiler.compile_source(ptr %source, ptr ");
    try text.append_bytes("%target_name)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %command = call ptr @compiler.command_report(ptr ");
    try text.append_bytes("@.str.compiler.command.build, ptr %target_name, ptr %report)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret ptr %command");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_check_source_function_symbol builds the check command wrapper.
fn build_check_source_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("@.str.compiler.command.check = private unnamed_addr constant ");
    try text.append_bytes("[6 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("check");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.compiler.target.llvm = private unnamed_addr constant ");
    try text.append_bytes("[5 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("llvm");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("define ptr @compiler.check_source(ptr %source) {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %report = call ptr @compiler.compile_source(ptr %source, ptr ");
    try text.append_bytes("@.str.compiler.target.llvm)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %command = call ptr @compiler.command_report(ptr ");
    try text.append_bytes("@.str.compiler.command.check, ptr ");
    try text.append_bytes("@.str.compiler.target.llvm, ptr %report)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret ptr %command");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_command_report_function_symbol builds the CommandReport constructor body.
fn build_command_report_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try append_command_report_header(text);
    try text.append_bytes("  %out = call ptr @malloc(i64 40)");
    try text.append_byte(cast<u8>(10));
    try append_command_report_loads(text);
    try append_command_report_stores(text);
    try text.append_bytes("  ret ptr %out");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// append_command_report_header appends the LLVM function header.
fn append_command_report_header(text: &mut std::string::String) -> !void {
    try text.append_bytes("define ptr @compiler.command_report(ptr %command, ptr %target_name, ");
    try text.append_bytes("ptr %report) ");
    try text.append_byte(cast<u8>(123));
    try text.append_byte(cast<u8>(10));
    return void;
}

// append_command_report_loads appends source CompileReport field loads.
fn append_command_report_loads(text: &mut std::string::String) -> !void {
    try text.append_bytes("  %status_in = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CompileReport, ");
    try text.append_bytes("ptr %report, i64 0, i32 0");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %status = load ptr, ptr %status_in");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %emitted_in = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CompileReport, ");
    try text.append_bytes("ptr %report, i64 0, i32 6");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %emitted = load i1, ptr %emitted_in");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %diagnostic_in = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CompileReport, ");
    try text.append_bytes("ptr %report, i64 0, i32 7");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %diagnostic = load ptr, ptr %diagnostic_in");
    try text.append_byte(cast<u8>(10));
    return void;
}

// append_command_report_stores appends destination CommandReport field stores.
fn append_command_report_stores(text: &mut std::string::String) -> !void {
    try text.append_bytes("  %command_slot = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CommandReport, ");
    try text.append_bytes("ptr %out, i64 0, i32 0");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store ptr %command, ptr %command_slot");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %target_slot = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CommandReport, ");
    try text.append_bytes("ptr %out, i64 0, i32 1");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store ptr %target_name, ptr %target_slot");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %status_slot = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CommandReport, ");
    try text.append_bytes("ptr %out, i64 0, i32 2");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store ptr %status, ptr %status_slot");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %emitted_slot = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CommandReport, ");
    try text.append_bytes("ptr %out, i64 0, i32 3");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store i1 %emitted, ptr %emitted_slot");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %diagnostic_slot = getelementptr inbounds ");
    try text.append_bytes("%struct.compiler.CommandReport, ptr %out, i64 0, i32 4");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  store ptr %diagnostic, ptr %diagnostic_slot");
    try text.append_byte(cast<u8>(10));
    return void;
}

// build_selfhost_package_target_function_symbol builds the package path predicate.
fn build_selfhost_package_target_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("@.str.selfhost_target.0 = private unnamed_addr constant [9 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("selfhost");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.selfhost_target.1 = private unnamed_addr constant [15 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("../../selfhost");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("@.str.selfhost_target.2 = private unnamed_addr constant [19 x i8] c");
    try text.append_byte(cast<u8>(34));
    try text.append_bytes("selfhost/kizu.toml");
    try text.append_byte(cast<u8>(92));
    try text.append_bytes("00");
    try text.append_byte(cast<u8>(34));
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("define i1 @is_selfhost_package_target(ptr %path) {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %match0 = call i1 @kizu_bytes_equal(ptr %path, ptr ");
    try text.append_bytes("@.str.selfhost_target.0)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %match1 = call i1 @kizu_bytes_equal(ptr %path, ptr ");
    try text.append_bytes("@.str.selfhost_target.1)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %or0 = or i1 %match0, %match1");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %match2 = call i1 @kizu_bytes_equal(ptr %path, ptr ");
    try text.append_bytes("@.str.selfhost_target.2)");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %ok = or i1 %or0, %match2");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret i1 %ok");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_ascii_alpha_function_symbol builds the lexer ASCII letter predicate.
fn build_ascii_alpha_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ascii_alpha(i8 %byte) {
  %upper_ge = icmp uge i8 %byte, 65
  %upper_le = icmp ule i8 %byte, 90
  %upper = and i1 %upper_ge, %upper_le
  %lower_ge = icmp uge i8 %byte, 97
  %lower_le = icmp ule i8 %byte, 122
  %lower = and i1 %lower_ge, %lower_le
  %ok = or i1 %upper, %lower
  ret i1 %ok
}
");
    return text;
}

// build_ident_start_function_symbol builds the lexer identifier-start predicate.
fn build_ident_start_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ident_start(i8 %byte) {
  %alpha = call i1 @lexer.is_ascii_alpha(i8 %byte)
  %underscore = icmp eq i8 %byte, 95
  %ok = or i1 %alpha, %underscore
  ret i1 %ok
}
");
    return text;
}

// build_ident_continue_function_symbol builds the lexer identifier-continuation predicate.
fn build_ident_continue_function_symbol(
    module_path: []const u8,
    name: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i1 @lexer.is_ident_continue(i8 %byte) {
  %start = call i1 @lexer.is_ident_start(i8 %byte)
  %digit = call i1 @lexer.is_ascii_digit(i8 %byte)
  %ok = or i1 %start, %digit
  ret i1 %ok
}
");
    return text;
}

// build_try_call_function_symbol builds a no-arg `return try callee();` wrapper.
fn build_try_call_function_symbol(
    module_path: []const u8,
    name: []const u8,
    callee: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define ptr @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    try text.append_bytes("() {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %result = call ptr @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(callee);
    try text.append_bytes("()");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret ptr %result");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_mem_len_function_symbol builds one concrete std::mem::len wrapper.
fn build_mem_len_function_symbol(
    module_path: []const u8,
    name: []const u8,
    param: []const u8
) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define i64 @");
    try text.append_bytes(module_symbol_prefix(module_path));
    try text.append_bytes(name);
    try text.append_bytes("(ptr %");
    try text.append_bytes(param);
    try text.append_bytes(") {");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  %len = call i64 @kizu_bytes_len(ptr %");
    try text.append_bytes(param);
    try text.append_bytes(")");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("  ret i64 %len");
    try text.append_byte(cast<u8>(10));
    try text.append_bytes("}");
    try text.append_byte(cast<u8>(10));
    return text;
}

// function_has_single_bool_return detects a body containing only one bool return.
fn function_has_single_bool_return(
    tokens: &std::array::Array<token::Token>,
    start: i64,
    value: token::TokenKind
) -> !bool {
    let returns_bool = try function_returns_bool(tokens, start);
    if !returns_bool {
        return false;
    }
    let index = try function_body_start(tokens, start);
    if index < 0 {
        return false;
    }
    if index + 3 >= tokens.len() {
        return false;
    }
    let ret = try tokens.at(index);
    let literal = try tokens.at(index + 1);
    let semicolon = try tokens.at(index + 2);
    let close = try tokens.at(index + 3);
    if ret.kind != token::TokenKind::Return {
        return false;
    }
    if literal.kind != value {
        return false;
    }
    if semicolon.kind != token::TokenKind::Semicolon {
        return false;
    }
    return close.kind == token::TokenKind::RBrace;
}

// function_has_single_string_literal_return detects simple []const u8 literals.
fn function_has_single_string_literal_return(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    let returns_bytes = try function_returns_bytes(tokens, start);
    if !returns_bytes {
        return false;
    }
    let no_params = try function_has_no_params(tokens, start);
    if !no_params {
        return false;
    }
    let index = try function_body_start(tokens, start);
    if index < 0 {
        return false;
    }
    if index + 3 >= tokens.len() {
        return false;
    }
    let ret = try tokens.at(index);
    let literal = try tokens.at(index + 1);
    let semi = try tokens.at(index + 2);
    let close = try tokens.at(index + 3);
    if ret.kind != token::TokenKind::Return {
        return false;
    }
    if literal.kind != token::TokenKind::String {
        return false;
    }
    let simple = try string_literal_is_llvm_simple(literal.literal);
    if !simple {
        return false;
    }
    if semi.kind != token::TokenKind::Semicolon {
        return false;
    }
    return close.kind == token::TokenKind::RBrace;
}

// function_string_return_literal returns the literal from an exact string body.
fn function_string_return_literal(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let index = try function_body_start(tokens, start);
    let literal = try tokens.at(index + 1);
    return literal.literal;
}

// string_literal_is_llvm_simple rejects bytes needing LLVM c-string escaping.
fn string_literal_is_llvm_simple(literal: []const u8) -> !bool {
    var index = 0;
    let length = std::mem::len(literal);

    while index < length {
        let byte = try std::mem::byte_at(literal, index);
        if byte == cast<u8>(10) {
            return false;
        }
        if byte == cast<u8>(34) {
            return false;
        }
        if byte == cast<u8>(92) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// function_is_ascii_digit_body detects the canonical lexer digit range check.
fn function_is_ascii_digit_body(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if !std::mem::equal_bytes(module_path, "selfhost::lexer") {
        return false;
    }
    if !std::mem::equal_bytes(name, "is_ascii_digit") {
        return false;
    }
    if !try function_returns_bool(tokens, start) {
        return false;
    }
    return try function_first_param_is_u8(tokens, start);
}

// function_is_ascii_space_body detects the canonical lexer whitespace predicate.
fn function_is_ascii_space_body(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if !std::mem::equal_bytes(module_path, "selfhost::lexer") {
        return false;
    }
    if !std::mem::equal_bytes(name, "is_ascii_space") {
        return false;
    }
    if !try function_returns_bool(tokens, start) {
        return false;
    }
    return try function_first_param_is_u8(tokens, start);
}

// function_is_ascii_alpha_body detects the canonical lexer ASCII letter predicate.
fn function_is_ascii_alpha_body(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if !std::mem::equal_bytes(module_path, "selfhost::lexer") {
        return false;
    }
    if !std::mem::equal_bytes(name, "is_ascii_alpha") {
        return false;
    }
    if !try function_returns_bool(tokens, start) {
        return false;
    }
    return try function_first_param_is_u8(tokens, start);
}

// function_is_ident_start_body detects the canonical lexer identifier-start predicate.
fn function_is_ident_start_body(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if !std::mem::equal_bytes(module_path, "selfhost::lexer") {
        return false;
    }
    if !std::mem::equal_bytes(name, "is_ident_start") {
        return false;
    }
    if !try function_returns_bool(tokens, start) {
        return false;
    }
    return try function_first_param_is_u8(tokens, start);
}

// function_is_ident_continue_body detects the canonical lexer identifier predicate.
fn function_is_ident_continue_body(
    module_path: []const u8,
    name: []const u8,
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if !std::mem::equal_bytes(module_path, "selfhost::lexer") {
        return false;
    }
    if !std::mem::equal_bytes(name, "is_ident_continue") {
        return false;
    }
    if !try function_returns_bool(tokens, start) {
        return false;
    }
    return try function_first_param_is_u8(tokens, start);
}

// function_is_selfhost_package_target_body identifies the CLI package predicate.
fn function_is_selfhost_package_target_body(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost") {
        return false;
    }
    return std::mem::equal_bytes(name, "is_selfhost_package_target");
}

// function_is_compile_command_wrapper identifies source-to-command wrappers.
fn function_is_compile_command_wrapper(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost::compiler") {
        return false;
    }
    if std::mem::equal_bytes(name, "check_source") {
        return true;
    }
    return std::mem::equal_bytes(name, "build_source");
}

// function_is_command_report_body identifies the CommandReport constructor.
fn function_is_command_report_body(module_path: []const u8, name: []const u8) -> bool {
    if !std::mem::equal_bytes(module_path, "selfhost::compiler") {
        return false;
    }
    return std::mem::equal_bytes(name, "command_report");
}

// function_has_single_try_call_return detects `return try callee();`.
fn function_has_single_try_call_return(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if !try function_returns_error_union(tokens, start) {
        return false;
    }
    if !try function_has_no_params(tokens, start) {
        return false;
    }
    let index = try function_body_start(tokens, start);
    if index < 0 {
        return false;
    }
    if index + 6 >= tokens.len() {
        return false;
    }
    let ret = try tokens.at(index);
    let try_token = try tokens.at(index + 1);
    let callee = try tokens.at(index + 2);
    let open = try tokens.at(index + 3);
    let close_call = try tokens.at(index + 4);
    let semi = try tokens.at(index + 5);
    let close_body = try tokens.at(index + 6);
    if ret.kind != token::TokenKind::Return {
        return false;
    }
    if try_token.kind != token::TokenKind::Try {
        return false;
    }
    if callee.kind != token::TokenKind::Ident {
        return false;
    }
    if open.kind != token::TokenKind::LParen {
        return false;
    }
    if close_call.kind != token::TokenKind::RParen {
        return false;
    }
    if semi.kind != token::TokenKind::Semicolon {
        return false;
    }
    return close_body.kind == token::TokenKind::RBrace;
}

// function_try_call_return_callee returns the callee from an exact try-call body.
fn function_try_call_return_callee(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let index = try function_body_start(tokens, start);
    let callee = try tokens.at(index + 2);
    return callee.literal;
}

// function_has_single_mem_len_return detects `return std::mem::len(param);`.
fn function_has_single_mem_len_return(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    let returns_i64 = try function_returns_type(tokens, start, "i64");
    if !returns_i64 {
        return false;
    }
    let has_bytes_param = try function_first_param_is_bytes(tokens, start);
    if !has_bytes_param {
        return false;
    }
    let index = try function_body_start(tokens, start);
    if index < 0 {
        return false;
    }
    if index + 10 >= tokens.len() {
        return false;
    }
    return try function_mem_len_return_matches(tokens, start, index);
}

// function_mem_len_return_matches checks the exact std::mem::len return body.
fn function_mem_len_return_matches(
    tokens: &std::array::Array<token::Token>,
    start: i64,
    index: i64
) -> !bool {
    let param = try function_first_param_name(tokens, start);
    let ret = try tokens.at(index);
    let std_name = try tokens.at(index + 1);
    let first_sep = try tokens.at(index + 2);
    let mem_name = try tokens.at(index + 3);
    let second_sep = try tokens.at(index + 4);
    let len_name = try tokens.at(index + 5);
    let open = try tokens.at(index + 6);
    let arg = try tokens.at(index + 7);
    let close_call = try tokens.at(index + 8);
    let semi = try tokens.at(index + 9);
    let close_body = try tokens.at(index + 10);

    if ret.kind != token::TokenKind::Return {
        return false;
    }
    if !std::mem::equal_bytes(std_name.literal, "std") {
        return false;
    }
    if first_sep.kind != token::TokenKind::DoubleColon {
        return false;
    }
    if !std::mem::equal_bytes(mem_name.literal, "mem") {
        return false;
    }
    if second_sep.kind != token::TokenKind::DoubleColon {
        return false;
    }
    if !std::mem::equal_bytes(len_name.literal, "len") {
        return false;
    }
    if open.kind != token::TokenKind::LParen {
        return false;
    }
    if !std::mem::equal_bytes(arg.literal, param) {
        return false;
    }
    if close_call.kind != token::TokenKind::RParen {
        return false;
    }
    if semi.kind != token::TokenKind::Semicolon {
        return false;
    }
    return close_body.kind == token::TokenKind::RBrace;
}

// function_first_param_is_bytes checks for one leading `[]const u8` parameter.
fn function_first_param_is_bytes(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if start + 9 >= tokens.len() {
        return false;
    }
    let open = try tokens.at(start + 2);
    let name = try tokens.at(start + 3);
    let colon = try tokens.at(start + 4);
    let left = try tokens.at(start + 5);
    let right = try tokens.at(start + 6);
    let const_name = try tokens.at(start + 7);
    let u8_name = try tokens.at(start + 8);
    let close = try tokens.at(start + 9);

    if open.kind != token::TokenKind::LParen {
        return false;
    }
    if name.kind != token::TokenKind::Ident {
        return false;
    }
    if colon.kind != token::TokenKind::Colon {
        return false;
    }
    if left.kind != token::TokenKind::LBracket {
        return false;
    }
    if right.kind != token::TokenKind::RBracket {
        return false;
    }
    if !std::mem::equal_bytes(const_name.literal, "const") {
        return false;
    }
    if !std::mem::equal_bytes(u8_name.literal, "u8") {
        return false;
    }
    return close.kind == token::TokenKind::RParen;
}

// function_first_param_is_u8 checks for one leading `u8` parameter.
fn function_first_param_is_u8(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if start + 6 >= tokens.len() {
        return false;
    }
    let open = try tokens.at(start + 2);
    let name = try tokens.at(start + 3);
    let colon = try tokens.at(start + 4);
    let u8_name = try tokens.at(start + 5);
    let close = try tokens.at(start + 6);

    if open.kind != token::TokenKind::LParen {
        return false;
    }
    if name.kind != token::TokenKind::Ident {
        return false;
    }
    if colon.kind != token::TokenKind::Colon {
        return false;
    }
    if !std::mem::equal_bytes(u8_name.literal, "u8") {
        return false;
    }
    return close.kind == token::TokenKind::RParen;
}

// function_has_no_params checks the exact empty-parameter shape.
fn function_has_no_params(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    if start + 3 >= tokens.len() {
        return false;
    }
    let open = try tokens.at(start + 2);
    let close = try tokens.at(start + 3);
    if open.kind != token::TokenKind::LParen {
        return false;
    }
    return close.kind == token::TokenKind::RParen;
}

// function_first_param_name returns the first parameter name for simple functions.
fn function_first_param_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let param = try tokens.at(start + 3);
    return param.literal;
}

// function_returns_bool reports whether a function declares `-> bool`.
fn function_returns_bool(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    return try function_returns_type(tokens, start, "bool");
}

// function_returns_error_union reports whether a function return type starts with `!`.
fn function_returns_error_union(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    var index = start;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::Arrow {
            let typ = try tokens.at(index + 1);
            return typ.kind == token::TokenKind::Bang;
        }
        index = index + 1;
    }
    return false;
}

// function_returns_bytes reports whether a function declares `-> []const u8`.
fn function_returns_bytes(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start;

    while index + 4 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::Arrow {
            let left = try tokens.at(index + 1);
            let right = try tokens.at(index + 2);
            let const_name = try tokens.at(index + 3);
            let u8_name = try tokens.at(index + 4);
            if left.kind != token::TokenKind::LBracket {
                return false;
            }
            if right.kind != token::TokenKind::RBracket {
                return false;
            }
            if !std::mem::equal_bytes(const_name.literal, "const") {
                return false;
            }
            return std::mem::equal_bytes(u8_name.literal, "u8");
        }
        index = index + 1;
    }
    return false;
}

// function_returns_type reports whether a function declares the given return type.
fn function_returns_type(
    tokens: &std::array::Array<token::Token>,
    start: i64,
    type_name: []const u8
) -> !bool {
    var index = start;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::Arrow {
            let typ = try tokens.at(index + 1);
            return std::mem::equal_bytes(typ.literal, type_name);
        }
        index = index + 1;
    }
    return false;
}

// function_body_start returns the first token inside a function body.
fn function_body_start(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return index + 1;
        }
        if current.kind == token::TokenKind::Fn {
            if index > start {
                return -1;
            }
        }
        index = index + 1;
    }
    return -1;
}

// module_string_global returns the global name for a string-returning function.
fn module_string_global(module_path: []const u8, name: []const u8) -> []const u8 {
    if std::mem::equal_bytes(module_path, "selfhost::backend") {
        if std::mem::equal_bytes(name, "llvm_module_text") {
            return "@.str.backend.llvm_module_text";
        }
    }
    if std::mem::equal_bytes(module_path, "selfhost") {
        if std::mem::equal_bytes(name, "selfhost_wasm_artifact") {
            return "@.str.selfhost_wasm_artifact";
        }
    }
    return "@.str.unknown";
}

// module_string_length_text returns the LLVM array length for supported literals.
fn module_string_length_text(module_path: []const u8, name: []const u8) -> []const u8 {
    if std::mem::equal_bytes(module_path, "selfhost::backend") {
        if std::mem::equal_bytes(name, "llvm_module_text") {
            return "33";
        }
    }
    if std::mem::equal_bytes(module_path, "selfhost") {
        if std::mem::equal_bytes(name, "selfhost_wasm_artifact") {
            return "22";
        }
    }
    return "0";
}

// module_string_literal_supported checks the exact literals we can emit today.
fn module_string_literal_supported(
    module_path: []const u8,
    name: []const u8,
    literal: []const u8
) -> bool {
    if std::mem::equal_bytes(module_path, "selfhost::backend") {
        if std::mem::equal_bytes(name, "llvm_module_text") {
            return std::mem::equal_bytes(literal, "define void @main() { ret void }");
        }
    }
    if std::mem::equal_bytes(module_path, "selfhost") {
        if std::mem::equal_bytes(name, "selfhost_wasm_artifact") {
            return std::mem::equal_bytes(literal, "(module (func $main))");
        }
    }
    return false;
}

// module_symbol_prefix returns the LLVM symbol prefix for a selfhost module.
fn module_symbol_prefix(module_path: []const u8) -> []const u8 {
    if std::mem::equal_bytes(module_path, "selfhost") {
        return "";
    }
    if std::mem::equal_bytes(module_path, "selfhost::ast") {
        return "ast.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::backend") {
        return "backend.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::cache_contract") {
        return "cache_contract.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::compiler") {
        return "compiler.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::diagnostics") {
        return "diagnostics.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::ir") {
        return "ir.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::lexer") {
        return "lexer.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::ownership") {
        return "ownership.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::parser") {
        return "parser.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::resolver") {
        return "resolver.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::token") {
        return "token.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::types") {
        return "types.";
    }
    return "unknown.";
}

// module_is_root reports whether a source module is the package entry module.
fn module_is_root(module: &SourceModule) -> bool {
    if module.is_root {
        return true;
    }
    return std::mem::equal_bytes(module.path, "selfhost");
}

// ready exposes the compiler module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}

pub struct TypeSummary {
    pub type_count: i64;
    pub copyable_scalar_count: i64;
    pub noncopy_value_count: i64;
}

pub struct OwnershipSummary {
    pub check_count: i64;
    pub rejected_count: i64;
}

// source_module constructs one explicit package source input.
fn source_module(
    path: []const u8,
    source: []const u8,
    is_root: bool,
    is_test: bool
) -> SourceModule {
    return SourceModule {
        path: path,
        source: source,
        is_root: is_root,
        is_test: is_test,
    };
}

// empty_package_report creates the mutable aggregate used by package compile.
fn empty_package_report() -> PackageReport {
    return PackageReport {
        status: CompileStatus::Pass,
        module_count: 0,
        compiled_module_count: 0,
        token_count: 0,
        function_count: 0,
        import_count: 0,
        type_count: 0,
        ownership_checks: 0,
        ir_function_count: 0,
        backend_emitted: false,
        root_found: false,
        diagnostic: "",
    };
}

// compile_package_module compiles one non-test module at summary granularity.
fn compile_package_module(module: &SourceModule) -> !PackageReport {
    try resolver::resolve_module_path(module.path);
    let compiled = try compile_source(module.source, "llvm");
    let imports = try module_import_count(module.source);

    return PackageReport {
        status: compiled.status,
        module_count: 0,
        compiled_module_count: 1,
        token_count: compiled.token_count,
        function_count: compiled.function_count,
        import_count: imports,
        type_count: compiled.type_count,
        ownership_checks: compiled.ownership_checks,
        ir_function_count: compiled.ir_function_count,
        backend_emitted: compiled.backend_emitted,
        root_found: false,
        diagnostic: compiled.diagnostic,
    };
}

// merge_package_report combines package aggregate counters.
fn merge_package_report(current: PackageReport, next: &PackageReport) -> PackageReport {
    return PackageReport {
        status: merge_status(current.status, next.status),
        module_count: current.module_count,
        compiled_module_count: current.compiled_module_count + next.compiled_module_count,
        token_count: current.token_count + next.token_count,
        function_count: current.function_count + next.function_count,
        import_count: current.import_count + next.import_count,
        type_count: current.type_count + next.type_count,
        ownership_checks: current.ownership_checks + next.ownership_checks,
        ir_function_count: current.ir_function_count + next.ir_function_count,
        backend_emitted: current.backend_emitted,
        root_found: current.root_found,
        diagnostic: next.diagnostic,
    };
}

// merge_status keeps failures sticky across package module compilation.
fn merge_status(left: CompileStatus, right: CompileStatus) -> CompileStatus {
    if left == CompileStatus::Fail {
        return CompileStatus::Fail;
    }
    return right;
}

// finish_package_report applies root and backend checks after all modules compile.
fn finish_package_report(report: PackageReport, target_name: []const u8) -> PackageReport {
    let target_info = backend::target(target_name);
    let artifact = backend::artifact(&target_info, report.ir_function_count, report.function_count);

    if !report.root_found {
        return package_failure(&report, "missing package root");
    }
    if !artifact.emitted {
        return package_failure(&report, "unsupported backend target");
    }
    return PackageReport {
        status: CompileStatus::Pass,
        module_count: report.module_count,
        compiled_module_count: report.compiled_module_count,
        token_count: report.token_count,
        function_count: report.function_count,
        import_count: report.import_count,
        type_count: report.type_count,
        ownership_checks: report.ownership_checks,
        ir_function_count: report.ir_function_count,
        backend_emitted: artifact.emitted,
        root_found: report.root_found,
        diagnostic: report.diagnostic,
    };
}

// package_failure marks a package report as failed without hiding diagnostics.
fn package_failure(report: &PackageReport, diagnostic: []const u8) -> PackageReport {
    return PackageReport {
        status: CompileStatus::Fail,
        module_count: report.module_count,
        compiled_module_count: report.compiled_module_count,
        token_count: report.token_count,
        function_count: report.function_count,
        import_count: report.import_count,
        type_count: report.type_count,
        ownership_checks: report.ownership_checks,
        ir_function_count: report.ir_function_count,
        backend_emitted: false,
        root_found: report.root_found,
        diagnostic: diagnostic,
    };
}

// module_import_count counts imports through the same lexer/parser boundary.
fn module_import_count(source: []const u8) -> !i64 {
    var tokens = try lexer::lex(source);
    let parsed = try parser::parse_tokens(tokens);
    return parsed.import_count;
}

// type_summary mirrors the Go type checker phase at summary granularity.
fn type_summary(parsed: &ast::ParseSummary) -> !TypeSummary {
    let void_type = try types::classify("void");
    let bool_type = try types::classify("bool");
    let bytes_type = try types::classify("[]const u8");
    var copyable = 0;
    var noncopy = 0;

    if types::can_copy(&void_type) {
        copyable = copyable + 1;
    }
    if types::can_copy(&bool_type) {
        copyable = copyable + 1;
    }
    if !types::can_copy(&bytes_type) {
        noncopy = noncopy + 1;
    }

    return TypeSummary {
        type_count: parsed.struct_count + parsed.enum_count + parsed.union_count,
        copyable_scalar_count: copyable,
        noncopy_value_count: noncopy,
    };
}

// ownership_summary mirrors the Go ownership checker phase at summary granularity.
fn ownership_summary(summary: &TypeSummary) -> OwnershipSummary {
    let copy_state = ownership::owned(true);
    let moved = ownership::move_value(&copy_state);
    let owned_state = ownership::owned(false);
    let borrowed = ownership::borrow_shared(&owned_state);
    let restored = ownership::end_borrow(&borrowed.next);
    let moved_owned = ownership::move_value(&restored);
    var rejected = 0;

    if !moved.allowed {
        rejected = rejected + 1;
    }
    if !moved_owned.allowed {
        rejected = rejected + 1;
    }

    return OwnershipSummary {
        check_count: summary.copyable_scalar_count + summary.noncopy_value_count,
        rejected_count: rejected,
    };
}
