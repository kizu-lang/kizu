  %union_out = getelementptr inbounds %struct.ast.ParseSummary, ptr %out, i64 0, i32 4
  store i64 0, ptr %union_out
  %return_out = getelementptr inbounds %struct.ast.ParseSummary, ptr %out, i64 0, i32 5
  store i64 0, ptr %return_out
  ret ptr %out
");
    try text.append_byte(cast<u8>(125));
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_compile_package_function_symbol builds the package summary entry body.
fn build_compile_package_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define ptr @compiler.compile_package(ptr %modules, ptr %target_name) ");
    try text.append_byte(cast<u8>(123));
    try text.append_bytes("
entry:
  %report = call ptr @malloc(i64 96)
  %status = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 0
  store ptr @.str.compiler.status.pass, ptr %status
  %modules_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 1
  store i64 1, ptr %modules_out
  %compiled = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 2
  store i64 1, ptr %compiled
  %tokens = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 3
  store i64 0, ptr %tokens
  %functions = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 4
  store i64 0, ptr %functions
  %imports = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 5
  store i64 0, ptr %imports
  %types = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 6
  store i64 0, ptr %types
  %ownership = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 7
  store i64 0, ptr %ownership
  %ir = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 8
  store i64 0, ptr %ir
  %backend = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 9
  store i1 false, ptr %backend
  %root = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 10
  store i1 true, ptr %root
  %diagnostic = getelementptr inbounds %struct.compiler.PackageReport, ptr %report, i64 0, i32 11
  store ptr @.str.compiler.empty, ptr %diagnostic
  %finished = call ptr @compiler.finish_package_report(ptr %report, ptr %target_name)
  ret ptr %finished
");
    try text.append_byte(cast<u8>(125));
    try text.append_byte(cast<u8>(10));
    return text;
}

