// build_merge_status_function_symbol builds sticky failure status merging.
fn build_merge_status_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define ptr @compiler.merge_status(ptr %left, ptr %right) ");
    try text.append_byte(cast<u8>(123));
    try text.append_bytes("
entry:
  %left_failed = icmp eq ptr %left, @.str.compiler.status.fail
  br i1 %left_failed, label %failed, label %right_status
failed:
  ret ptr @.str.compiler.status.fail
right_status:
  ret ptr %right
");
    try text.append_byte(cast<u8>(125));
    try text.append_byte(cast<u8>(10));
    return text;
}

