// build_compile_package_module_function_symbol builds one module report body.
fn build_compile_package_module_function_symbol() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try text.append_bytes("define ptr @compiler.compile_package_module(ptr %module) ");
    try text.append_byte(cast<u8>(123));
    try text.append_bytes("
entry:
  %source_in = getelementptr inbounds %struct.compiler.SourceModule, ptr %module, i64 0, i32 1
  %source = load ptr, ptr %source_in
  %compiled = call ptr @compiler.compile_source(ptr %source, ptr @.str.compiler.compile.target.llvm)
  %imports = call i64 @compiler.module_import_count(ptr %source)
  %out = call ptr @malloc(i64 96)
  %status_in = getelementptr inbounds %struct.compiler.CompileReport, ptr %compiled, i64 0, i32 0
  %status = load ptr, ptr %status_in
  %token_in = getelementptr inbounds %struct.compiler.CompileReport, ptr %compiled, i64 0, i32 1
  %token_count = load i64, ptr %token_in
  %fn_in = getelementptr inbounds %struct.compiler.CompileReport, ptr %compiled, i64 0, i32 2
  %function_count = load i64, ptr %fn_in
  %type_in = getelementptr inbounds %struct.compiler.CompileReport, ptr %compiled, i64 0, i32 3
  %type_count = load i64, ptr %type_in
  %own_in = getelementptr inbounds %struct.compiler.CompileReport, ptr %compiled, i64 0, i32 4
  %ownership = load i64, ptr %own_in
  %ir_in = getelementptr inbounds %struct.compiler.CompileReport, ptr %compiled, i64 0, i32 5
  %ir_count = load i64, ptr %ir_in
  %backend_in = getelementptr inbounds %struct.compiler.CompileReport, ptr %compiled, i64 0, i32 6
  %backend = load i1, ptr %backend_in
  %diag_in = getelementptr inbounds %struct.compiler.CompileReport, ptr %compiled, i64 0, i32 7
  %diagnostic = load ptr, ptr %diag_in
  %status_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 0
  store ptr %status, ptr %status_out
  %modules_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 1
  store i64 0, ptr %modules_out
  %compiled_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 2
  store i64 1, ptr %compiled_out
  %tokens_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 3
  store i64 %token_count, ptr %tokens_out
  %fn_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 4
  store i64 %function_count, ptr %fn_out
  %imports_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 5
  store i64 %imports, ptr %imports_out
  %types_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 6
  store i64 %type_count, ptr %types_out
  %own_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 7
  store i64 %ownership, ptr %own_out
  %ir_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 8
  store i64 %ir_count, ptr %ir_out
  %backend_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 9
  store i1 %backend, ptr %backend_out
  %root_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 10
  store i1 false, ptr %root_out
  %diag_out = getelementptr inbounds %struct.compiler.PackageReport, ptr %out, i64 0, i32 11
  store ptr %diagnostic, ptr %diag_out
  ret ptr %out
");
    try text.append_byte(cast<u8>(125));
    try text.append_byte(cast<u8>(10));
    return text;
}

// build_module_import_count_function_symbol returns import count through parser.
fn build_module_import_count_function_symbol() -> !std::string::String {
