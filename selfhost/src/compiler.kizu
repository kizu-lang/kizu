entry:
  %out = call ptr @malloc(i64 48)
  %fn_out = getelementptr inbounds %struct.ast.ParseSummary, ptr %out, i64 0, i32 0
  store i64 0, ptr %fn_out
  %import_out = getelementptr inbounds %struct.ast.ParseSummary, ptr %out, i64 0, i32 1
  store i64 0, ptr %import_out
  %struct_out = getelementptr inbounds %struct.ast.ParseSummary, ptr %out, i64 0, i32 2
