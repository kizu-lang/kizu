// function_has_single_try_call_return detects `return try callee();`.
fn function_has_single_try_call_return(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if !try function_returns_error_union(tokens, start) {
        return false;
    }
    if !try function_has_no_params(tokens, start) {
        return false;
    }
    let index = try function_body_start(tokens, start);
    if index < 0 {
        return false;
    }
    if index + 6 >= tokens.len() {
        return false;
    }
    let ret = try tokens.at(index);
    let try_token = try tokens.at(index + 1);
    let callee = try tokens.at(index + 2);
    let open = try tokens.at(index + 3);
    let close_call = try tokens.at(index + 4);
    let semi = try tokens.at(index + 5);
    let close_body = try tokens.at(index + 6);
    if ret.kind != token::TokenKind::Return {
        return false;
    }
    if try_token.kind != token::TokenKind::Try {
        return false;
    }
    if callee.kind != token::TokenKind::Ident {
        return false;
    }
    if open.kind != token::TokenKind::LParen {
        return false;
    }
    if close_call.kind != token::TokenKind::RParen {
        return false;
    }
    if semi.kind != token::TokenKind::Semicolon {
        return false;
    }
    return close_body.kind == token::TokenKind::RBrace;
}

// function_try_call_return_callee returns the callee from an exact try-call body.
fn function_try_call_return_callee(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let index = try function_body_start(tokens, start);
    let callee = try tokens.at(index + 2);
    return callee.literal;
}

// function_has_single_mem_len_return detects `return std::mem::len(param);`.
fn function_has_single_mem_len_return(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    let returns_i64 = try function_returns_type(tokens, start, "i64");
    if !returns_i64 {
        return false;
    }
    let has_bytes_param = try function_first_param_is_bytes(tokens, start);
    if !has_bytes_param {
        return false;
    }
    let index = try function_body_start(tokens, start);
    if index < 0 {
        return false;
    }
    if index + 10 >= tokens.len() {
        return false;
    }
    return try function_mem_len_return_matches(tokens, start, index);
}

// function_mem_len_return_matches checks the exact std::mem::len return body.
fn function_mem_len_return_matches(
    tokens: &std::array::Array<token::Token>,
    start: i64,
    index: i64
) -> !bool {
    let param = try function_first_param_name(tokens, start);
    let ret = try tokens.at(index);
    let std_name = try tokens.at(index + 1);
    let first_sep = try tokens.at(index + 2);
    let mem_name = try tokens.at(index + 3);
    let second_sep = try tokens.at(index + 4);
    let len_name = try tokens.at(index + 5);
    let open = try tokens.at(index + 6);
    let arg = try tokens.at(index + 7);
    let close_call = try tokens.at(index + 8);
    let semi = try tokens.at(index + 9);
    let close_body = try tokens.at(index + 10);

    if ret.kind != token::TokenKind::Return {
        return false;
    }
    if !std::mem::equal_bytes(std_name.literal, "std") {
        return false;
    }
    if first_sep.kind != token::TokenKind::DoubleColon {
        return false;
    }
    if !std::mem::equal_bytes(mem_name.literal, "mem") {
        return false;
    }
    if second_sep.kind != token::TokenKind::DoubleColon {
        return false;
    }
    if !std::mem::equal_bytes(len_name.literal, "len") {
        return false;
    }
    if open.kind != token::TokenKind::LParen {
        return false;
    }
    if !std::mem::equal_bytes(arg.literal, param) {
        return false;
    }
    if close_call.kind != token::TokenKind::RParen {
        return false;
    }
    if semi.kind != token::TokenKind::Semicolon {
        return false;
    }
    return close_body.kind == token::TokenKind::RBrace;
}

// function_first_param_is_bytes checks for one leading `[]const u8` parameter.
fn function_first_param_is_bytes(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if start + 9 >= tokens.len() {
        return false;
    }
    let open = try tokens.at(start + 2);
    let name = try tokens.at(start + 3);
    let colon = try tokens.at(start + 4);
    let left = try tokens.at(start + 5);
    let right = try tokens.at(start + 6);
    let const_name = try tokens.at(start + 7);
    let u8_name = try tokens.at(start + 8);
    let close = try tokens.at(start + 9);

    if open.kind != token::TokenKind::LParen {
        return false;
    }
    if name.kind != token::TokenKind::Ident {
        return false;
    }
    if colon.kind != token::TokenKind::Colon {
        return false;
    }
    if left.kind != token::TokenKind::LBracket {
        return false;
    }
    if right.kind != token::TokenKind::RBracket {
        return false;
    }
    if !std::mem::equal_bytes(const_name.literal, "const") {
        return false;
    }
    if !std::mem::equal_bytes(u8_name.literal, "u8") {
        return false;
    }
    return close.kind == token::TokenKind::RParen;
}

// function_first_param_is_u8 checks for one leading `u8` parameter.
fn function_first_param_is_u8(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    if start + 6 >= tokens.len() {
        return false;
    }
    let open = try tokens.at(start + 2);
    let name = try tokens.at(start + 3);
    let colon = try tokens.at(start + 4);
    let u8_name = try tokens.at(start + 5);
    let close = try tokens.at(start + 6);

    if open.kind != token::TokenKind::LParen {
        return false;
    }
    if name.kind != token::TokenKind::Ident {
        return false;
    }
    if colon.kind != token::TokenKind::Colon {
        return false;
    }
    if !std::mem::equal_bytes(u8_name.literal, "u8") {
        return false;
    }
    return close.kind == token::TokenKind::RParen;
}

// function_has_no_params checks the exact empty-parameter shape.
fn function_has_no_params(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    if start + 3 >= tokens.len() {
        return false;
    }
    let open = try tokens.at(start + 2);
    let close = try tokens.at(start + 3);
    if open.kind != token::TokenKind::LParen {
        return false;
    }
    return close.kind == token::TokenKind::RParen;
}

// function_first_param_name returns the first parameter name for simple functions.
fn function_first_param_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let param = try tokens.at(start + 3);
    return param.literal;
}

// function_returns_bool reports whether a function declares `-> bool`.
fn function_returns_bool(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    return try function_returns_type(tokens, start, "bool");
}

// function_returns_error_union reports whether a function return type starts with `!`.
fn function_returns_error_union(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !bool {
    var index = start;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::Arrow {
            let typ = try tokens.at(index + 1);
            return typ.kind == token::TokenKind::Bang;
        }
        index = index + 1;
    }
    return false;
}

// function_returns_bytes reports whether a function declares `-> []const u8`.
fn function_returns_bytes(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start;

    while index + 4 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::Arrow {
            let left = try tokens.at(index + 1);
            let right = try tokens.at(index + 2);
            let const_name = try tokens.at(index + 3);
            let u8_name = try tokens.at(index + 4);
            if left.kind != token::TokenKind::LBracket {
                return false;
            }
            if right.kind != token::TokenKind::RBracket {
                return false;
            }
            if !std::mem::equal_bytes(const_name.literal, "const") {
                return false;
            }
            return std::mem::equal_bytes(u8_name.literal, "u8");
        }
        index = index + 1;
    }
    return false;
}

// function_returns_type reports whether a function declares the given return type.
fn function_returns_type(
    tokens: &std::array::Array<token::Token>,
    start: i64,
    type_name: []const u8
) -> !bool {
    var index = start;

    while index + 1 < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::Arrow {
            let typ = try tokens.at(index + 1);
            return std::mem::equal_bytes(typ.literal, type_name);
        }
        index = index + 1;
    }
    return false;
}

// function_body_start returns the first token inside a function body.
fn function_body_start(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return index + 1;
        }
        if current.kind == token::TokenKind::Fn {
            if index > start {
                return -1;
            }
        }
        index = index + 1;
    }
    return -1;
}

// module_string_global returns the global name for a string-returning function.
fn module_string_global(module_path: []const u8, name: []const u8) -> []const u8 {
    if std::mem::equal_bytes(module_path, "selfhost::backend") {
        if std::mem::equal_bytes(name, "llvm_module_text") {
            return "@.str.backend.llvm_module_text";
        }
    }
    if std::mem::equal_bytes(module_path, "selfhost") {
        if std::mem::equal_bytes(name, "selfhost_wasm_artifact") {
            return "@.str.selfhost_wasm_artifact";
        }
    }
    return "@.str.unknown";
}

// module_string_length_text returns the LLVM array length for supported literals.
fn module_string_length_text(module_path: []const u8, name: []const u8) -> []const u8 {
    if std::mem::equal_bytes(module_path, "selfhost::backend") {
        if std::mem::equal_bytes(name, "llvm_module_text") {
            return "33";
        }
    }
    if std::mem::equal_bytes(module_path, "selfhost") {
        if std::mem::equal_bytes(name, "selfhost_wasm_artifact") {
            return "22";
        }
    }
    return "0";
}

// module_string_literal_supported checks the exact literals we can emit today.
fn module_string_literal_supported(
    module_path: []const u8,
    name: []const u8,
    literal: []const u8
) -> bool {
    if std::mem::equal_bytes(module_path, "selfhost::backend") {
        if std::mem::equal_bytes(name, "llvm_module_text") {
            return std::mem::equal_bytes(literal, "define void @main() { ret void }");
        }
    }
    if std::mem::equal_bytes(module_path, "selfhost") {
        if std::mem::equal_bytes(name, "selfhost_wasm_artifact") {
            return std::mem::equal_bytes(literal, "(module (func $main))");
        }
    }
    return false;
}

// module_symbol_prefix returns the LLVM symbol prefix for a selfhost module.
fn module_symbol_prefix(module_path: []const u8) -> []const u8 {
    if std::mem::equal_bytes(module_path, "selfhost") {
        return "";
    }
    if std::mem::equal_bytes(module_path, "selfhost::ast") {
        return "ast.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::backend") {
        return "backend.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::cache_contract") {
        return "cache_contract.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::compiler") {
        return "compiler.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::diagnostics") {
        return "diagnostics.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::ir") {
        return "ir.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::lexer") {
        return "lexer.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::ownership") {
        return "ownership.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::parser") {
        return "parser.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::resolver") {
        return "resolver.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::token") {
        return "token.";
    }
    if std::mem::equal_bytes(module_path, "selfhost::types") {
        return "types.";
    }
    return "unknown.";
}

// module_is_root reports whether a source module is the package entry module.
fn module_is_root(module: &SourceModule) -> bool {
    if module.is_root {
        return true;
    }
    return std::mem::equal_bytes(module.path, "selfhost");
}

// ready exposes the compiler module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}

pub struct TypeSummary {
    pub type_count: i64;
    pub copyable_scalar_count: i64;
    pub noncopy_value_count: i64;
}

pub struct OwnershipSummary {
    pub check_count: i64;
    pub rejected_count: i64;
}

// source_module constructs one explicit package source input.
fn source_module(
    path: []const u8,
    source: []const u8,
    is_root: bool,
    is_test: bool
) -> SourceModule {
    return SourceModule {
        path: path,
        source: source,
        is_root: is_root,
        is_test: is_test,
    };
}

// empty_package_report creates the mutable aggregate used by package compile.
fn empty_package_report() -> PackageReport {
    return PackageReport {
        status: CompileStatus::Pass,
        module_count: 0,
        compiled_module_count: 0,
        token_count: 0,
        function_count: 0,
        import_count: 0,
        type_count: 0,
        ownership_checks: 0,
        ir_function_count: 0,
        backend_emitted: false,
        root_found: false,
        diagnostic: "",
    };
}

// compile_package_module compiles one non-test module at summary granularity.
fn compile_package_module(module: &SourceModule) -> !PackageReport {
    try resolver::resolve_module_path(module.path);
    let compiled = try compile_source(module.source, "llvm");
    let imports = try module_import_count(module.source);

    return PackageReport {
        status: compiled.status,
        module_count: 0,
        compiled_module_count: 1,
        token_count: compiled.token_count,
        function_count: compiled.function_count,
        import_count: imports,
        type_count: compiled.type_count,
        ownership_checks: compiled.ownership_checks,
        ir_function_count: compiled.ir_function_count,
        backend_emitted: compiled.backend_emitted,
        root_found: false,
        diagnostic: compiled.diagnostic,
    };
}

// merge_package_report combines package aggregate counters.
fn merge_package_report(current: PackageReport, next: &PackageReport) -> PackageReport {
    return PackageReport {
        status: merge_status(current.status, next.status),
        module_count: current.module_count,
        compiled_module_count: current.compiled_module_count + next.compiled_module_count,
        token_count: current.token_count + next.token_count,
        function_count: current.function_count + next.function_count,
        import_count: current.import_count + next.import_count,
        type_count: current.type_count + next.type_count,
        ownership_checks: current.ownership_checks + next.ownership_checks,
        ir_function_count: current.ir_function_count + next.ir_function_count,
        backend_emitted: current.backend_emitted,
        root_found: current.root_found,
        diagnostic: next.diagnostic,
    };
}

// merge_status keeps failures sticky across package module compilation.
fn merge_status(left: CompileStatus, right: CompileStatus) -> CompileStatus {
    if left == CompileStatus::Fail {
        return CompileStatus::Fail;
    }
    return right;
}

// finish_package_report applies root and backend checks after all modules compile.
fn finish_package_report(report: PackageReport, target_name: []const u8) -> PackageReport {
    let target_info = backend::target(target_name);
    let artifact = backend::artifact(&target_info, report.ir_function_count, report.function_count);

    if !report.root_found {
        return package_failure(&report, "missing package root");
    }
    if !artifact.emitted {
        return package_failure(&report, "unsupported backend target");
    }
    return PackageReport {
        status: CompileStatus::Pass,
        module_count: report.module_count,
        compiled_module_count: report.compiled_module_count,
        token_count: report.token_count,
        function_count: report.function_count,
        import_count: report.import_count,
        type_count: report.type_count,
        ownership_checks: report.ownership_checks,
        ir_function_count: report.ir_function_count,
        backend_emitted: artifact.emitted,
        root_found: report.root_found,
        diagnostic: report.diagnostic,
    };
}

// package_failure marks a package report as failed without hiding diagnostics.
fn package_failure(report: &PackageReport, diagnostic: []const u8) -> PackageReport {
    return PackageReport {
        status: CompileStatus::Fail,
        module_count: report.module_count,
        compiled_module_count: report.compiled_module_count,
        token_count: report.token_count,
        function_count: report.function_count,
        import_count: report.import_count,
        type_count: report.type_count,
        ownership_checks: report.ownership_checks,
        ir_function_count: report.ir_function_count,
        backend_emitted: false,
        root_found: report.root_found,
        diagnostic: diagnostic,
    };
}

// module_import_count counts imports through the same lexer/parser boundary.
fn module_import_count(source: []const u8) -> !i64 {
    var tokens = try lexer::lex(source);
    let parsed = try parser::parse_tokens(tokens);
    return parsed.import_count;
}

// type_summary mirrors the Go type checker phase at summary granularity.
fn type_summary(parsed: &ast::ParseSummary) -> !TypeSummary {
    let void_type = try types::classify("void");
    let bool_type = try types::classify("bool");
    let bytes_type = try types::classify("[]const u8");
    var copyable = 0;
    var noncopy = 0;

    if types::can_copy(&void_type) {
        copyable = copyable + 1;
    }
    if types::can_copy(&bool_type) {
        copyable = copyable + 1;
    }
    if !types::can_copy(&bytes_type) {
        noncopy = noncopy + 1;
    }

    return TypeSummary {
        type_count: parsed.struct_count + parsed.enum_count + parsed.union_count,
        copyable_scalar_count: copyable,
        noncopy_value_count: noncopy,
    };
}

// ownership_summary mirrors the Go ownership checker phase at summary granularity.
fn ownership_summary(summary: &TypeSummary) -> OwnershipSummary {
    let copy_state = ownership::owned(true);
    let moved = ownership::move_value(&copy_state);
    let owned_state = ownership::owned(false);
    let borrowed = ownership::borrow_shared(&owned_state);
    let restored = ownership::end_borrow(&borrowed.next);
    let moved_owned = ownership::move_value(&restored);
    var rejected = 0;

    if !moved.allowed {
        rejected = rejected + 1;
    }
    if !moved_owned.allowed {
        rejected = rejected + 1;
    }

    return OwnershipSummary {
        check_count: summary.copyable_scalar_count + summary.noncopy_value_count,
        rejected_count: rejected,
    };
}
