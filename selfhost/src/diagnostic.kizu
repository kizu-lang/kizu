pub struct FileSpan {
    pub path: []const u8;
    pub start: i64;
    pub end: i64;
}

pub struct Diagnostic {
    pub primary: FileSpan;
    pub message: []const u8;
}

pub fn file_span(path: []const u8, start: i64, end: i64) -> FileSpan {
    return FileSpan {
        path: path,
        start: start,
        end: end
    };
}

pub fn Diagnostic(primary: FileSpan, message: []const u8) -> Diagnostic {
    return Diagnostic {
        primary: primary,
        message: message
    };
}
