pub struct FileSpan {
    pub path: []u8,
    pub start: i64,
    pub end: i64,
    pub line: i64,
    pub column: i64,
}

pub struct Diagnostic {
    pub primary: FileSpan,
    pub message: []u8,
}

pub struct Report {
    pub ok: bool,
    pub found: bool,
    pub warning: bool,
    pub primary: FileSpan,
    pub message: std::string::String,
    pub note_1: std::string::String,
    pub note_2: std::string::String,
    pub help: std::string::String,
}

pub fn file_span(path: []u8, start: i64, end: i64) -> FileSpan {
    return FileSpan {
        path: path,
        start: start,
        end: end,
        line: 0,
        column: 0
    };
}

pub fn file_span_at(
    path: []u8,
    start: i64,
    end: i64,
    line: i64,
    column: i64
) -> FileSpan {
    return FileSpan {
        path: path,
        start: start,
        end: end,
        line: line,
        column: column
    };
}

pub fn empty_span(path: []u8) -> FileSpan {
    return FileSpan {
        path: path,
        start: -1,
        end: -1,
        line: 0,
        column: 0
    };
}

pub fn Diagnostic(primary: FileSpan, message: []u8) -> Diagnostic {
    return Diagnostic {
        primary: primary,
        message: message
    };
}

pub fn no_report(allocator: Allocator) -> Report {
    return Report {
        ok: true,
        found: false,
        warning: false,
        primary: empty_span(""),
        message: std::string::String(allocator),
        note_1: std::string::String(allocator),
        note_2: std::string::String(allocator),
        help: std::string::String(allocator)
    };
}

pub fn error_report(
    allocator: Allocator,
    primary: FileSpan
) -> Report {
    return Report {
        ok: false,
        found: true,
        warning: false,
        primary: primary,
        message: std::string::String(allocator),
        note_1: std::string::String(allocator),
        note_2: std::string::String(allocator),
        help: std::string::String(allocator)
    };
}

pub fn warning_report(
    allocator: Allocator,
    primary: FileSpan
) -> Report {
    return Report {
        ok: true,
        found: true,
        warning: true,
        primary: primary,
        message: std::string::String(allocator),
        note_1: std::string::String(allocator),
        note_2: std::string::String(allocator),
        help: std::string::String(allocator)
    };
}

impl Report {
    fn add_note(self: Report, note: []u8) -> !void {
        if std::mem::equal_bytes(note, "") {
            return;
        }
        if self.note_1.len() == 0 {
            try self.note_1.append_bytes(note);
            return;
        }
        if self.note_2.len() == 0 {
            try self.note_2.append_bytes(note);
        }
        return;
    }

    fn set_help(self: Report, help: []u8) -> !void {
        if std::mem::equal_bytes(help, "") {
            return;
        }
        try self.help.append_bytes(help);
        return;
    }

    fn deinit(self: Report) -> void {
        self.message.deinit();
        self.note_1.deinit();
        self.note_2.deinit();
        self.help.deinit();
    }
}
