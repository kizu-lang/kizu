// Module: component tests for self-host IR summary boundaries.

import selfhost::ir;

// ir_component_test checks deterministic IR summary facts.
pub fn ir_component_test() -> !void {
    let ret = ir::instruction(ir::InstructionKind::Return, "void");
    let entry = ir::block("entry", 1, true);
    let main_fn = ir::function("main", "void", 1, 1);
    let same_fn = ir::function("main", "void", 1, 1);
    let module = ir::module(1, 1, 1);

    try std::testing::expect(ret.kind == ir::InstructionKind::Return);
    try std::testing::expect_equal_bytes("void", ret.result_type);
    try std::testing::expect_equal_bytes("entry", entry.name);
    try std::testing::expect(entry.has_terminator);
    try std::testing::expect_equal_i64(1, main_fn.block_count);
    try std::testing::expect_equal_i64(1, module.function_count);
    try std::testing::expect(ir::function_matches(&main_fn, &same_fn));
    return void;
}
