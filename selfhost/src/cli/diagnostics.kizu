import selfhost::cli::output;
import selfhost::diagnostic;
import selfhost::types;
import selfhost::types::model;

struct LineColumn {
    line: i64,
    column: i64,
}

pub fn parse_validation_error(
    allocator: Allocator,
    io: Io,
    path: []u8,
    validation: &var diagnostic::Report
) -> !void {
    let span = report_span(&validation.primary, "");
    try write_owned_prefixed_line(allocator, io, "error", &var validation.message, span);
    if validation.note_1.len() > 0 {
        try write_owned_prefixed_line(allocator, io, "note", &var validation.note_1, note_span());
    }
    if validation.note_2.len() > 0 {
        try write_owned_prefixed_line(allocator, io, "note", &var validation.note_2, note_span());
    }
    if validation.help.len() > 0 {
        try write_owned_prefixed_line(allocator, io, "help", &var validation.help, note_span());
    }
    try output::error_line(allocator, io, "error: parse failed");
    return;
}

pub fn move_error(
    allocator: Allocator,
    io: Io,
    path: []u8,
    file_text: []u8,
    start: i64,
    end: i64,
    name: []u8
) -> !void {
    let primary = diagnostic::file_span(path, start, end);
    var report = diagnostic::error_report(allocator, primary);
    try report.message.append_bytes("move error: moved value `");
    try report.message.append_bytes(name);
    try report.message.append_bytes("` was used");
    defer report.deinit();
    try write_report(allocator, io, file_text, &var report);
    return;
}

pub fn duplicate_symbol_error(
    allocator: Allocator,
    io: Io,
    name: []u8
) -> !void {
    try std::io::write_stderr(io, "error: duplicate symbol `");
    try std::io::write_stderr(io, name);
    try output::error_line(allocator, io, "`");
    return;
}

pub fn function_call_summary_error(
    allocator: Allocator,
    io: Io,
    path: []u8,
    text: []u8,
    call_error: model::FunctionCallSummary
) -> !void {
    var report = try types::function_call_diagnostic(allocator, path, text, call_error);
    defer report.deinit();
    try write_report(allocator, io, text, &var report);
    return;
}

pub fn check_summary_error(
    allocator: Allocator,
    io: Io,
    path: []u8,
    file_text: []u8,
    diagnostic: diagnostic::Report
) -> !bool {
    var report = diagnostic;
    defer report.deinit();
    return try write_report(allocator, io, file_text, &var report);
}

fn write_report(
    allocator: Allocator,
    io: Io,
    file_text: []u8,
    diagnostic: &var diagnostic::Report
) -> !bool {
    if !diagnostic.found {
        return true;
    }
    var prefix = "error";
    if diagnostic.warning {
        prefix = "warning";
    }
    let span = report_span(&diagnostic.primary, file_text);
    try write_owned_prefixed_line(allocator, io, prefix, &var diagnostic.message, span);
    if diagnostic.note_1.len() > 0 {
        try write_owned_prefixed_line(allocator, io, "note", &var diagnostic.note_1, note_span());
    }
    if diagnostic.note_2.len() > 0 {
        try write_owned_prefixed_line(allocator, io, "note", &var diagnostic.note_2, note_span());
    }
    if diagnostic.help.len() > 0 {
        try write_owned_prefixed_line(allocator, io, "help", &var diagnostic.help, note_span());
    }
    return false;
}

fn write_type_reference_summary_error(
    allocator: Allocator,
    io: Io,
    path: []u8,
    file_text: []u8,
    diagnostic: &model::CheckDiagnosticSummary
) -> !void {
    let name = file_text[diagnostic.start..diagnostic.end];
    let span = primary_span(path, file_text, diagnostic.start, diagnostic.end);
    if diagnostic.detail_kind == 1 {
        var message = std::string::String(allocator);
        try message.append_bytes("type error: unknown type `");
        try message.append_bytes(name);
        try message.append_bytes("`");
        try write_owned_prefixed_line(allocator, io, "error", message, span);
        message.deinit();
        return;
    }
    if diagnostic.detail_kind == 2 {
        var message = std::string::String(allocator);
        try message.append_bytes("type error: type `");
        try message.append_bytes(name);
        try message.append_bytes("` expects ");
        try std::fmt::append_i64(message, diagnostic.expected);
        try message.append_bytes(" type arguments, got ");
        try std::fmt::append_i64(message, diagnostic.observed);
        try write_owned_prefixed_line(allocator, io, "error", message, span);
        message.deinit();
        return;
    }
    try output::error_line(allocator, io, "error: check failed");
    return;
}

fn write_match_summary_error(
    allocator: Allocator,
    io: Io,
    path: []u8,
    diagnostic: &model::CheckDiagnosticSummary
) -> !void {
    let span = empty_span(path);
    if diagnostic.detail_kind == 1 {
        var message = std::string::String(allocator);
        try message.append_bytes("type error: match expects enum or union, got ");
        try message.append_bytes(diagnostic.name);
        try write_owned_prefixed_line(allocator, io, "error", message, span);
        message.deinit();
        return;
    }
    if diagnostic.detail_kind == 2 {
        try write_match_tag_message(
            allocator,
            io,
            span,
            "type error: unknown match tag `",
            diagnostic.name,
            diagnostic.tag
        );
        return;
    }
    if diagnostic.detail_kind == 3 {
        try write_match_tag_message(
            allocator,
            io,
            span,
            "type error: duplicate match tag `",
            diagnostic.name,
            diagnostic.tag
        );
        return;
    }
    if diagnostic.detail_kind == 4 {
        var message = std::string::String(allocator);
        try message.append_bytes("type error: match on `");
        try message.append_bytes(diagnostic.name);
        try message.append_bytes("` is not exhaustive");
        try write_owned_prefixed_line(allocator, io, "error", message, span);
        message.deinit();
        return;
    }
    if diagnostic.detail_kind == 5 {
        try write_message_error(
            allocator,
            io,
            span,
            "type error: wildcard match arm must be last"
        );
        return;
    }
    if diagnostic.detail_kind == 6 {
        try write_message_error(
            allocator,
            io,
            span,
            "type error: wildcard match arm cannot bind payload"
        );
        return;
    }
    if diagnostic.detail_kind == 7 {
        try write_message_error(
            allocator,
            io,
            span,
            "type error: duplicate wildcard match arm"
        );
        return;
    }
    if diagnostic.detail_kind == 8 {
        try write_match_tag_message(
            allocator,
            io,
            span,
            "type error: enum tag has no payload `",
            diagnostic.name,
            diagnostic.tag
        );
        return;
    }
    try output::error_line(allocator, io, "error: check failed");
    return;
}

fn write_expected_got_summary_error(
    allocator: Allocator,
    io: Io,
    path: []u8,
    file_text: []u8,
    start: i64,
    end: i64,
    prefix: []u8,
    expected: []u8,
    actual: []u8
) -> !void {
    let span = primary_span(path, file_text, start, end);
    var message = std::string::String(allocator);
    try message.append_bytes(prefix);
    try message.append_bytes(expected);
    try message.append_bytes(", got ");
    try message.append_bytes(actual);
    try write_owned_prefixed_line(allocator, io, "error", message, span);
    message.deinit();
    return;
}

fn write_match_tag_message(
    allocator: Allocator,
    io: Io,
    span: std::kizu::diagnostic::FileSpan,
    prefix: []u8,
    name: []u8,
    tag: []u8
) -> !void {
    var message = std::string::String(allocator);
    try message.append_bytes(prefix);
    try message.append_bytes(name);
    try message.append_bytes("::");
    try message.append_bytes(tag);
    try message.append_bytes("`");
    try write_owned_prefixed_line(allocator, io, "error", message, span);
    message.deinit();
    return;
}

fn write_message_error(
    allocator: Allocator,
    io: Io,
    span: std::kizu::diagnostic::FileSpan,
    message: []u8
) -> !void {
    try write_prefixed_line(allocator, io, "error", message, span);
    return;
}

fn write_owned_prefixed_line(
    allocator: Allocator,
    io: Io,
    prefix: []u8,
    message: &var std::string::String,
    span: std::kizu::diagnostic::FileSpan
) -> !void {
    var line = std::string::String(allocator);
    try line.append_bytes(prefix);
    try line.append_bytes(": ");
    let message_bytes = message.as_bytes();
    try line.append_bytes(message_bytes);
    try append_span_suffix(line, span);
    let bytes = line.as_bytes();
    try std::io::write_stderr(io, bytes);
    try output::stderr_newline(allocator, io);
    line.deinit();
    return;
}

fn write_prefixed_line(
    allocator: Allocator,
    io: Io,
    prefix: []u8,
    message: []u8,
    span: std::kizu::diagnostic::FileSpan
) -> !void {
    var line = std::string::String(allocator);
    try line.append_bytes(prefix);
    try line.append_bytes(": ");
    try line.append_bytes(message);
    try append_span_suffix(line, span);
    let bytes = line.as_bytes();
    try std::io::write_stderr(io, bytes);
    try output::stderr_newline(allocator, io);
    line.deinit();
    return;
}

fn append_span_suffix(
    out: &var std::string::String,
    span: std::kizu::diagnostic::FileSpan
) -> !void {
    if span.line < 1 or span.column < 1 {
        return;
    }
    try out.append_bytes(" at ");
    try std::fmt::append_i64(out, span.line);
    try out.append_byte(cast<u8>(58));
    try std::fmt::append_i64(out, span.column);
    return;
}

fn primary_span(
    path: []u8,
    source: []u8,
    start: i64,
    end: i64
) -> std::kizu::diagnostic::FileSpan {
    let clamped_start = clamp_offset(source, start);
    let clamped_end = clamp_end(source, clamped_start, end);
    let position = line_column_for_offset(source, clamped_start);
    return std::kizu::diagnostic::file_span(
        0,
        path,
        clamped_start,
        clamped_end,
        position.line,
        position.column
    );
}

fn report_span(
    primary: &diagnostic::FileSpan,
    source: []u8
) -> std::kizu::diagnostic::FileSpan {
    if primary.line > 0 and primary.column > 0 {
        return std::kizu::diagnostic::file_span(
            0,
            primary.path,
            primary.start,
            primary.end,
            primary.line,
            primary.column
        );
    }
    if primary.start < 0 {
        return empty_span(primary.path);
    }
    return primary_span(primary.path, source, primary.start, primary.end);
}

fn empty_span(path: []u8) -> std::kizu::diagnostic::FileSpan {
    return std::kizu::diagnostic::file_span(0, path, 0, 0, 0, 0);
}

fn note_span() -> std::kizu::diagnostic::FileSpan {
    return std::kizu::diagnostic::file_span(0, "", 0, 0, 0, 0);
}

fn line_column_for_offset(source: []u8, offset: i64) -> LineColumn {
    let limit = clamp_offset(source, offset);
    var line = 1;
    var column = 1;
    var index = 0;
    while index < limit {
        if source[index] == cast<u8>(10) {
            line = line + 1;
            column = 1;
        } else {
            column = column + 1;
        }
        index = index + 1;
    }
    return LineColumn {
        line: line,
        column: column
    };
}

fn clamp_offset(source: []u8, offset: i64) -> i64 {
    if offset < 0 {
        return 0;
    }
    let length = std::mem::len(source);
    if offset > length {
        return length;
    }
    return offset;
}

fn clamp_end(source: []u8, start: i64, end: i64) -> i64 {
    let clamped_end = clamp_offset(source, end);
    if clamped_end < start {
        return start;
    }
    return clamped_end;
}
