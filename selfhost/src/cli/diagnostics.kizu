import selfhost::cli::output;
import selfhost::parser::validation;
import selfhost::types::model;

pub fn parse_validation_error(
    allocator: Allocator,
    io: Io,
    validation: validation::ParseValidation
) -> !void {
    var line = std::string::String(allocator);
    try line.append_bytes("error: ");
    try line.append_bytes(validation.message);
    if !std::mem::equal_bytes(validation.got, "") {
        try line.append_bytes(", got ");
        try line.append_bytes(validation.got);
    }
    try line.append_bytes(" at ");
    try std::fmt::append_i64(line, validation.line);
    try line.append_byte(cast<u8>(58));
    try std::fmt::append_i64(line, validation.column);
    let bytes = line.as_bytes();
    try std::io::write_stderr(io, bytes);
    try output::stderr_newline(allocator, io);
    line.deinit();
    try output::error_line(allocator, io, "error: parse failed");
    return;
}

pub fn move_error(
    allocator: Allocator,
    io: Io,
    name: []u8
) -> !void {
    try std::io::write_stderr(io, "error: move error: moved value `");
    try std::io::write_stderr(io, name);
    try output::error_line(allocator, io, "` was used");
    return;
}

pub fn duplicate_symbol_error(
    allocator: Allocator,
    io: Io,
    name: []u8
) -> !void {
    try std::io::write_stderr(io, "error: duplicate symbol `");
    try std::io::write_stderr(io, name);
    try output::error_line(allocator, io, "`");
    return;
}

pub fn unknown_function_error(
    allocator: Allocator,
    io: Io,
    name: []u8
) -> !void {
    try std::io::write_stderr(io, "error: unknown function `");
    try std::io::write_stderr(io, name);
    try output::error_line(allocator, io, "`");
    return;
}

pub fn function_call_error(
    allocator: Allocator,
    io: Io,
    text: []u8,
    call_error: model::FunctionCallSummary
) -> !void {
    let name = text[call_error.start..call_error.end];
    if call_error.kind == 1 {
        try unknown_function_error(allocator, io, name);
        return;
    }
    if call_error.kind == 2 {
        try function_arity_error(
            allocator,
            io,
            name,
            call_error.expected,
            call_error.observed
        );
        return;
    }
    try output::error_line(allocator, io, "error: check failed");
    return;
}

pub fn match_error(
    allocator: Allocator,
    io: Io,
    diagnostic: model::MatchDiagnosticSummary
) -> !void {
    if diagnostic.kind == 1 {
        try std::io::write_stderr(io, "error: type error: match expects enum or union, got ");
        try output::error_line(allocator, io, diagnostic.name);
        return;
    }
    if diagnostic.kind == 2 {
        try match_tag_error(
            allocator,
            io,
            "error: type error: unknown match tag `",
            diagnostic.name,
            diagnostic.tag
        );
        return;
    }
    if diagnostic.kind == 3 {
        try match_tag_error(
            allocator,
            io,
            "error: type error: duplicate match tag `",
            diagnostic.name,
            diagnostic.tag
        );
        return;
    }
    if diagnostic.kind == 4 {
        try std::io::write_stderr(io, "error: type error: match on `");
        try std::io::write_stderr(io, diagnostic.name);
        try output::error_line(allocator, io, "` is not exhaustive");
        return;
    }
    if diagnostic.kind == 5 {
        try output::error_line(allocator, io, "error: type error: wildcard match arm must be last");
        return;
    }
    if diagnostic.kind == 6 {
        try output::error_line(
            allocator,
            io,
            "error: type error: wildcard match arm cannot bind payload"
        );
        return;
    }
    if diagnostic.kind == 7 {
        try output::error_line(allocator, io, "error: type error: duplicate wildcard match arm");
        return;
    }
    if diagnostic.kind == 8 {
        try match_tag_error(
            allocator,
            io,
            "error: type error: enum tag has no payload `",
            diagnostic.name,
            diagnostic.tag
        );
        return;
    }
    try output::error_line(allocator, io, "error: check failed");
    return;
}

pub fn unknown_type_error(
    allocator: Allocator,
    io: Io,
    name: []u8
) -> !void {
    try std::io::write_stderr(io, "error: unknown type `");
    try std::io::write_stderr(io, name);
    try output::error_line(allocator, io, "`");
    return;
}

pub fn function_arity_error(
    allocator: Allocator,
    io: Io,
    name: []u8,
    expected: i64,
    observed: i64
) -> !void {
    try std::io::write_stderr(io, "error: function `");
    try std::io::write_stderr(io, name);
    try std::io::write_stderr(io, "` expects ");
    var line = std::string::String(allocator);
    try std::fmt::append_i64(line, expected);
    try line.append_bytes(" argument, got ");
    try std::fmt::append_i64(line, observed);
    let bytes = line.as_bytes();
    try std::io::write_stderr(io, bytes);
    try output::stderr_newline(allocator, io);
    line.deinit();
    return;
}

pub fn type_arity_error(
    allocator: Allocator,
    io: Io,
    name: []u8,
    expected: i64,
    observed: i64
) -> !void {
    try std::io::write_stderr(io, "error: type `");
    try std::io::write_stderr(io, name);
    try std::io::write_stderr(io, "` expects ");
    var line = std::string::String(allocator);
    try std::fmt::append_i64(line, expected);
    try line.append_bytes(" type arguments, got ");
    try std::fmt::append_i64(line, observed);
    let bytes = line.as_bytes();
    try std::io::write_stderr(io, bytes);
    try output::stderr_newline(allocator, io);
    line.deinit();
    return;
}

fn match_tag_error(
    allocator: Allocator,
    io: Io,
    prefix: []u8,
    name: []u8,
    tag: []u8
) -> !void {
    try std::io::write_stderr(io, prefix);
    try std::io::write_stderr(io, name);
    try std::io::write_stderr(io, "::");
    try std::io::write_stderr(io, tag);
    try output::error_line(allocator, io, "`");
    return;
}
