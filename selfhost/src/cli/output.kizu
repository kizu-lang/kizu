pub fn usage(allocator: Allocator, io: Io) -> !void {
    try error_line(allocator, io, "usage: selfhost <check|stage|parse|run|test|fmt> <target>");
    return;
}

pub fn unsupported_run_codegen(allocator: Allocator, io: Io) -> !void {
    try error_line(allocator, io, "unsupported run codegen program");
    return;
}

pub fn deferred_public_command(allocator: Allocator, io: Io, command: []u8) -> !void {
    var message = std::string::String(allocator);
    try message.append_bytes("selfhost: command '");
    try message.append_bytes(command);
    try message.append_bytes("' is not owned yet; deferred to Go cmd/kizu");
    let bytes = message.as_bytes();
    try std::io::write_stderr(io, bytes);
    try stderr_newline(allocator, io);
    message.deinit();
    return;
}

pub fn line(allocator: Allocator, io: Io, text: []u8) -> !void {
    try std::io::write_stdout(io, text);
    try stdout_newline(allocator, io);
    return;
}

pub fn error_line(allocator: Allocator, io: Io, text: []u8) -> !void {
    try std::io::write_stderr(io, text);
    try stderr_newline(allocator, io);
    return;
}

pub fn stdout_newline(allocator: Allocator, io: Io) -> !void {
    var line = std::string::String(allocator);
    try line.append_byte(cast<u8>(10));
    let bytes = line.as_bytes();
    try std::io::write_stdout(io, bytes);
    line.deinit();
    return;
}

pub fn stderr_newline(allocator: Allocator, io: Io) -> !void {
    var line = std::string::String(allocator);
    try line.append_byte(cast<u8>(10));
    let bytes = line.as_bytes();
    try std::io::write_stderr(io, bytes);
    line.deinit();
    return;
}
