import selfhost::backend;
import selfhost::cli::check;
import selfhost::cli::diagnostics;
import selfhost::cli::output;
import selfhost::parser;
import selfhost::parser::validation;
import selfhost::source;

struct RunPrintPayload {
    found: bool,
    payload: []u8,
}

pub fn run_smoke_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    let parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        return try write_parse_failure(allocator, io, parsed_validation);
    }
    var files = try source::load_file_sources(allocator, io, path, file_text);
    defer files.deinit();
    let file = try files.at(0);
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    defer parsed.deinit();
    if !(try check::fast_diagnostics_ast_node(allocator, io, files, file, parsed.ast, parsed.root)) {
        return std::process::exit_code(1);
    }
    let print_payload = try ast_print_string_payload(file_text, parsed.ast, parsed.root);
    if print_payload.found {
        let artifact = try backend::emit_run_print_artifact(
            allocator,
            io,
            path,
            print_payload.payload
        );
        if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
            return std::process::exit_code(0);
        }
    }
    try output::usage(allocator, io);
    return std::process::exit_code(64);
}

pub fn test_smoke_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    let parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        return try write_parse_failure(allocator, io, parsed_validation);
    }
    var files = try source::load_file_sources(allocator, io, path, file_text);
    defer files.deinit();
    let file = try files.at(0);
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    defer parsed.deinit();
    if !(try check::fast_diagnostics_ast_node(allocator, io, files, file, parsed.ast, parsed.root)) {
        return std::process::exit_code(1);
    }
    let expect = try ast_testing_expect_value(file_text, parsed.ast, parsed.root);
    if expect == 1 {
        let artifact = try backend::emit_test_expect_ok_artifact(allocator, io, path);
        if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
            return std::process::exit_code(0);
        }
    }
    if expect == 0 {
        let artifact = try backend::emit_test_expect_failure_artifact(allocator, io, path);
        if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
            return std::process::exit_code(0);
        }
    }
    try output::usage(allocator, io);
    return std::process::exit_code(64);
}

fn write_parse_failure(
    allocator: Allocator,
    io: Io,
    parsed_validation: validation::ParseValidation
) -> !i64 {
    try diagnostics::parse_validation_error(allocator, io, parsed_validation);
    return std::process::exit_code(1);
}

fn ast_print_string_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !RunPrintPayload {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try ast_range_print_string_payload(text, ast, program.declarations),
        FnDecl(fn_decl) => try ast_fn_print_string_payload(text, ast, fn_decl.name, fn_decl.body),
        Block(block) => try ast_range_print_string_payload(text, ast, block.statements),
        ExprStmt(expr_stmt) => try ast_print_string_payload(text, ast, expr_stmt.expr),
        Call(call_node) => try ast_call_print_string_payload(
            text,
            ast,
            call_node.callee,
            call_node.args
        ),
        TypeApplyExpr(type_apply) => try ast_print_string_payload(text, ast, type_apply.callee),
        TryExpr(try_expr_node) => try ast_print_string_payload(text, ast, try_expr_node.value),
        ComptimeExpr(comptime_expr_node) => try ast_print_string_payload(
            text,
            ast,
            comptime_expr_node.value
        ),
        Unsafe(unsafe_node) => try ast_print_string_payload(text, ast, unsafe_node.body),
        If(if_node) => try ast_if_print_string_payload(
            text,
            ast,
            if_node.then_block,
            if_node.else_block
        ),
        Empty => run_print_not_found(text),
        ImportDecl(import_decl) => run_print_not_found(text),
        StructDecl(struct_decl) => run_print_not_found(text),
        EnumDecl(enum_decl) => run_print_not_found(text),
        UnionDecl(union_decl) => run_print_not_found(text),
        Int(int_node) => run_print_not_found(text),
        String(string_node) => run_print_not_found(text),
        TypeName(type_name) => run_print_not_found(text),
        Var(var_node) => run_print_not_found(text),
        Bool(bool_node) => run_print_not_found(text),
        Prefix(prefix_node) => run_print_not_found(text),
        Binary(binary) => run_print_not_found(text),
        FieldExpr(field_expr_node) => run_print_not_found(text),
        DerefExpr(deref_expr_node) => run_print_not_found(text),
        CastExpr(cast_expr) => run_print_not_found(text),
        IndexExpr(index_expr) => run_print_not_found(text),
        StructLiteralExpr(struct_literal) => run_print_not_found(text),
        StructFieldInit(struct_field_init) => run_print_not_found(text),
        ArenaNewExpr(arena_new) => run_print_not_found(text),
        Let(let_node) => run_print_not_found(text),
        Assign(assign_node) => run_print_not_found(text),
        Return(return_node) => run_print_not_found(text),
        Defer(defer_node) => run_print_not_found(text),
        While(while_node) => run_print_not_found(text),
        For(for_node) => run_print_not_found(text),
        Break(break_node) => run_print_not_found(text),
        Continue(continue_node) => run_print_not_found(text),
        Param(param_node) => run_print_not_found(text),
        Field(field_node) => run_print_not_found(text),
        UnionVariant(union_variant) => run_print_not_found(text),
        Match(match_node) => run_print_not_found(text),
        MatchArm(match_arm) => run_print_not_found(text),
        ComptimeIf(comptime_if_node) => run_print_not_found(text),
    };
}

fn ast_fn_print_string_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !RunPrintPayload {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "main") {
        return run_print_not_found(text);
    }
    return try ast_print_string_payload(text, ast, body);
}

fn ast_range_print_string_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !RunPrintPayload {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let payload = try ast_print_string_payload(text, ast, child);
        if payload.found {
            return payload;
        }
        index = index + 1;
    }
    return run_print_not_found(text);
}

fn ast_call_print_string_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !RunPrintPayload {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return run_print_not_found(text);
    }
    let arg = try ast.child_at(args, 0);
    return ast_string_literal_payload(text, ast, arg);
}

fn ast_string_literal_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> RunPrintPayload {
    let node = ast.get(node_id);
    return match node.data {
        String(string_node) => run_print_payload_from_literal(
            text,
            ast_node_text(text, ast, node_id)
        ),
        _ => run_print_not_found(text),
    };
}

fn run_print_payload_from_literal(text: []u8, literal: []u8) -> RunPrintPayload {
    let length = std::mem::len(literal);
    if length < 2 {
        return run_print_not_found(text);
    }
    if literal[0] != cast<u8>(34) or literal[length - 1] != cast<u8>(34) {
        return run_print_not_found(text);
    }
    let payload = literal[1..length - 1];
    if !is_supported_run_print_payload(payload) {
        return run_print_not_found(text);
    }
    return RunPrintPayload {
        found: true,
        payload: payload
    };
}

fn is_supported_run_print_payload(payload: []u8) -> bool {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte < cast<u8>(32) or byte > cast<u8>(126) {
            return false;
        }
        if byte == cast<u8>(34) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn run_print_not_found(text: []u8) -> RunPrintPayload {
    return RunPrintPayload {
        found: false,
        payload: text[0..0]
    };
}

fn ast_if_print_string_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId
) -> !RunPrintPayload {
    let then_payload = try ast_print_string_payload(text, ast, then_block);
    if then_payload.found {
        return then_payload;
    }
    return try ast_print_string_payload(text, ast, else_block);
}

fn ast_testing_expect_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try ast_expect_value_in_range(text, ast, program.declarations),
        FnDecl(fn_decl) => try ast_testing_expect_value(text, ast, fn_decl.body),
        Block(block) => try ast_expect_value_in_range(text, ast, block.statements),
        ExprStmt(expr_stmt) => try ast_testing_expect_value(text, ast, expr_stmt.expr),
        Call(call_node) => try ast_call_expect_value(text, ast, call_node.callee, call_node.args),
        TypeApplyExpr(type_apply) => try ast_testing_expect_value(text, ast, type_apply.callee),
        TryExpr(try_expr_node) => try ast_testing_expect_value(text, ast, try_expr_node.value),
        ComptimeExpr(comptime_expr_node) => try ast_testing_expect_value(text, ast, comptime_expr_node.value),
        Unsafe(unsafe_node) => try ast_testing_expect_value(text, ast, unsafe_node.body),
        If(if_node) => try ast_expect_value_in_two_nodes(
            text,
            ast,
            if_node.then_block,
            if_node.else_block
        ),
        Empty => -1,
        ImportDecl(import_decl) => -1,
        StructDecl(struct_decl) => -1,
        EnumDecl(enum_decl) => -1,
        UnionDecl(union_decl) => -1,
        Int(int_node) => -1,
        String(string_node) => -1,
        TypeName(type_name) => -1,
        Var(var_node) => -1,
        Bool(bool_node) => -1,
        Prefix(prefix_node) => -1,
        Binary(binary) => -1,
        FieldExpr(field_expr_node) => -1,
        DerefExpr(deref_expr_node) => -1,
        CastExpr(cast_expr) => -1,
        IndexExpr(index_expr) => -1,
        StructLiteralExpr(struct_literal) => -1,
        StructFieldInit(struct_field_init) => -1,
        ArenaNewExpr(arena_new) => -1,
        Let(let_node) => -1,
        Assign(assign_node) => -1,
        Return(return_node) => -1,
        Defer(defer_node) => -1,
        While(while_node) => -1,
        For(for_node) => -1,
        Break(break_node) => -1,
        Continue(continue_node) => -1,
        Param(param_node) => -1,
        Field(field_node) => -1,
        UnionVariant(union_variant) => -1,
        Match(match_node) => -1,
        MatchArm(match_arm) => -1,
        ComptimeIf(comptime_if_node) => -1,
    };
}

fn ast_expect_value_in_range(
    text: []u8,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !i64 {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let value = try ast_testing_expect_value(text, ast, child);
        if value != -1 {
            return value;
        }
        index = index + 1;
    }
    return -1;
}

fn ast_call_expect_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "std::testing::expect") or args.len != 1 {
        return -1;
    }
    let arg = try ast.child_at(args, 0);
    return ast_bool_value(ast, arg);
}

fn ast_expect_value_in_two_nodes(
    text: []u8,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId
) -> !i64 {
    let first_value = try ast_testing_expect_value(text, ast, first);
    if first_value != -1 {
        return first_value;
    }
    return try ast_testing_expect_value(text, ast, second);
}

fn ast_bool_value(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> i64 {
    let node = ast.get(node_id);
    return match node.data {
        Bool(bool_node) => bool_value_as_i64(bool_node.value),
        Program(program) => -1,
        Empty => -1,
        ImportDecl(import_decl) => -1,
        StructDecl(struct_decl) => -1,
        EnumDecl(enum_decl) => -1,
        UnionDecl(union_decl) => -1,
        FnDecl(fn_decl) => -1,
        Int(int_node) => -1,
        String(string_node) => -1,
        TypeName(type_name) => -1,
        Var(var_node) => -1,
        Prefix(prefix_node) => -1,
        Binary(binary) => -1,
        FieldExpr(field_expr_node) => -1,
        DerefExpr(deref_expr_node) => -1,
        Call(call_node) => -1,
        TypeApplyExpr(type_apply) => -1,
        CastExpr(cast_expr) => -1,
        IndexExpr(index_expr) => -1,
        StructLiteralExpr(struct_literal) => -1,
        StructFieldInit(struct_field_init) => -1,
        ArenaNewExpr(arena_new) => -1,
        TryExpr(try_expr_node) => -1,
        ComptimeExpr(comptime_expr_node) => -1,
        Block(block) => -1,
        If(if_node) => -1,
        Let(let_node) => -1,
        Assign(assign_node) => -1,
        Return(return_node) => -1,
        Defer(defer_node) => -1,
        ExprStmt(expr_stmt) => -1,
        While(while_node) => -1,
        For(for_node) => -1,
        Break(break_node) => -1,
        Continue(continue_node) => -1,
        Param(param_node) => -1,
        Field(field_node) => -1,
        UnionVariant(union_variant) => -1,
        Match(match_node) => -1,
        MatchArm(match_arm) => -1,
        Unsafe(unsafe_node) => -1,
        ComptimeIf(comptime_if_node) => -1,
    };
}

fn bool_value_as_i64(value: bool) -> i64 {
    if value {
        return 1;
    }
    return 0;
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
