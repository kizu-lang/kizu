import selfhost::backend;
import selfhost::cli::check;
import selfhost::cli::diagnostics;
import selfhost::cli::output;
import selfhost::diagnostic;
import selfhost::ir::code_render;
import selfhost::parser;
import selfhost::source::loader;
import selfhost::types::constructor_facts;

// Hosted stage2 has already completed the static check before entering this helper.
// Keep ConstructorFacts construction and collection on the compiled Kizu side so the
// handwritten CLI LLVM only passes the real source inputs across one stable boundary.
pub fn render_checked_run_artifact(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    parsed: std::kizu::ast::ParseResult
) -> !std::string::String {
    var constructor_identities = constructor_facts::init(allocator);
    // The hosted CLI is a one-shot process. Its current compiled MIR can deinit an
    // owned Array local, but cannot yet lower ConstructorFacts aggregate deinit; the
    // process therefore owns these facts until exit, matching the renderer tape arrays.
    try constructor_facts::collect_checked(
        text,
        parsed.ast,
        parsed.root,
        &var constructor_identities
    );
    let atomic_constructor_id = constructor_facts::constructor_atomic();
    let bool_type_id = constructor_facts::type_bool();
    let channel_constructor_id = constructor_facts::constructor_channel();
    let i64_type_id = constructor_facts::type_i64();
    return try code_render::render_run_artifact(
        allocator,
        source_path,
        text,
        parsed,
        &constructor_identities,
        atomic_constructor_id,
        bool_type_id,
        channel_constructor_id,
        i64_type_id
    );
}

pub fn run_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    var parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    defer parsed_validation.deinit();
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        return try write_parse_failure(allocator, io, path, &var parsed_validation);
    }
    var files = try loader::load_file_sources(allocator, io, path, file_text);
    defer files.deinit();
    let file = try files.at(0);
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    defer parsed.deinit();
    var constructor_identities = constructor_facts::init(allocator);
    defer constructor_identities.deinit();
    let atomic_constructor_id = constructor_facts::constructor_atomic();
    let bool_type_id = constructor_facts::type_bool();
    let channel_constructor_id = constructor_facts::constructor_channel();
    let i64_type_id = constructor_facts::type_i64();
    if !(try check::checked_ast_node(
        allocator,
        io,
        files,
        file,
        parsed.ast,
        parsed.root,
        &var constructor_identities
    )) {
        return std::process::exit_code(1);
    }
    var module = try backend::render_run_codegen_artifact(
        allocator,
        path,
        file_text,
        parsed.ast,
        parsed.root,
        &constructor_identities,
        atomic_constructor_id,
        bool_type_id,
        channel_constructor_id,
        i64_type_id
    );
    defer module.deinit();
    let module_bytes = module.as_bytes();
    let module_len = module.len();
    let artifact = try backend::emit_rendered_run_artifact(
        allocator,
        io,
        path,
        module_bytes,
        module_len
    );
    if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
        var ll_path = try backend::run_artifact_ll_path(allocator, path);
        defer ll_path.deinit();
        var executable_path = try backend::run_artifact_executable_path(allocator, path);
        defer executable_path.deinit();
        let ll_path_bytes = ll_path.as_bytes();
        let executable_path_bytes = executable_path.as_bytes();
        let link_code = try backend::link_run_artifact(ll_path_bytes, executable_path_bytes);
        if link_code != 0 {
            try output::usage(allocator, io);
            return std::process::exit_code(64);
        }
        return try backend::execute_run_artifact(executable_path_bytes);
    }
    try output::unsupported_run_codegen(allocator, io);
    return std::process::exit_code(64);
}

pub fn test_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    var parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    defer parsed_validation.deinit();
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        return try write_parse_failure(allocator, io, path, &var parsed_validation);
    }
    var files = try loader::load_file_sources(allocator, io, path, file_text);
    defer files.deinit();
    let file = try files.at(0);
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    defer parsed.deinit();
    var constructor_identities = constructor_facts::init(allocator);
    defer constructor_identities.deinit();
    if !(try check::checked_ast_node(
        allocator,
        io,
        files,
        file,
        parsed.ast,
        parsed.root,
        &var constructor_identities
    )) {
        return std::process::exit_code(1);
    }
    let executable = try backend::lower_test_executable(file_text, parsed.ast, parsed.root);
    if backend::test_executable_supported(&executable) {
        let artifact = try backend::emit_test_executable_artifact(
            allocator,
            io,
            path,
            executable
        );
        if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
            var ll_path = try backend::test_artifact_ll_path(allocator, path);
            defer ll_path.deinit();
            var executable_path = try backend::test_artifact_executable_path(allocator, path);
            defer executable_path.deinit();
            let ll_path_bytes = ll_path.as_bytes();
            let executable_path_bytes = executable_path.as_bytes();
            let link_code = try backend::link_run_artifact(ll_path_bytes, executable_path_bytes);
            if link_code != 0 {
                try output::usage(allocator, io);
                return std::process::exit_code(64);
            }
            return try backend::execute_run_artifact(executable_path_bytes);
        }
    }
    try output::usage(allocator, io);
    return std::process::exit_code(64);
}

fn write_parse_failure(
    allocator: Allocator,
    io: Io,
    path: []u8,
    parsed_validation: &var diagnostic::Report
) -> !i64 {
    try diagnostics::parse_validation_error(allocator, io, path, parsed_validation);
    return std::process::exit_code(1);
}
