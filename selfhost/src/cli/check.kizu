import selfhost::cli::diagnostics;
import selfhost::cli::output;
import selfhost::ownership;
import selfhost::parser;
import selfhost::parser::validation;
import selfhost::resolver;
import selfhost::source;
import selfhost::source::loader;
import selfhost::types;
import selfhost::types::function_calls;
import selfhost::types::model;
import selfhost::types::type_refs;

pub fn file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    let parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        return try write_parse_failure_exit(allocator, io, parsed_validation);
    }

    var files = try loader::load_file_sources(allocator, io, path, file_text);
    defer files.deinit();
    let file = try files.at(0);
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    defer parsed.deinit();
    if !(try fast_diagnostics_ast_node(allocator, io, files, file, parsed.ast, parsed.root)) {
        return std::process::exit_code(1);
    }

    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    let checked = try ownership::check_package(allocator, files, typed);

    if checked.diagnostics != 0 {
        try output::error_line(allocator, io, "error: check failed");
        return std::process::exit_code(1);
    }
    try output::line(allocator, io, "check: ok");
    return std::process::exit_code(0);
}

pub fn package_cli(allocator: Allocator, io: Io, root: []u8) -> !i64 {
    var files = try loader::load_package_sources(allocator, io, root);
    defer files.deinit();

    if !(try package_fast_diagnostics(allocator, io, files)) {
        try output::error_line(allocator, io, "error: check failed");
        return std::process::exit_code(1);
    }
    try output::line(allocator, io, "check: ok");
    return std::process::exit_code(0);
}

pub fn package_diagnostics(allocator: Allocator, io: Io, root: []u8) -> !i64 {
    var files = try loader::load_package_sources(allocator, io, root);
    defer files.deinit();

    return try package_diagnostics_loaded(allocator, files);
}

fn package_diagnostics_loaded(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>
) -> !i64 {
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    let checked = try ownership::check_package(allocator, files, typed);
    return checked.diagnostics;
}

struct FastDiagnosticContext {
    function_arities: std::map::Map<[]u8, i64>,
    type_kinds: std::map::Map<[]u8, model::TypeKind>,
    type_arities: std::map::Map<[]u8, i64>,
    copyable_types: std::map::Map<[]u8, bool>,
    borrow_params: std::map::Map<[]u8, bool>,
}

fn FastDiagnosticContext(allocator: Allocator) -> FastDiagnosticContext {
    return FastDiagnosticContext {
        function_arities: std::map::Map<[]u8, i64>(allocator),
        type_kinds: std::map::Map<[]u8, model::TypeKind>(allocator),
        type_arities: std::map::Map<[]u8, i64>(allocator),
        copyable_types: std::map::Map<[]u8, bool>(allocator),
        borrow_params: std::map::Map<[]u8, bool>(allocator)
    };
}

impl FastDiagnosticContext {
    fn deinit(self: FastDiagnosticContext) -> void {
        self.function_arities.deinit();
        self.type_kinds.deinit();
        self.type_arities.deinit();
        self.copyable_types.deinit();
        self.borrow_params.deinit();
    }
}

fn seed_fast_diagnostic_context(facts: &var FastDiagnosticContext) -> !void {
    try type_refs::seed_builtin_types(
        &var facts.type_kinds,
        &var facts.type_arities,
        &var facts.copyable_types
    );
    return;
}

fn package_fast_diagnostics(
    allocator: Allocator,
    io: Io,
    files: &std::array::Array<source::SourceFile>
) -> !bool {
    var parsed_sources = std::array::Array<std::kizu::ast::ParseResult>(allocator);
    var parsed_file_indexes = std::array::Array<i64>(allocator);
    var facts = FastDiagnosticContext(allocator);
    defer facts.deinit();
    try seed_fast_diagnostic_context(&var facts);
    var ok = try parse_package_fast_diagnostic_sources(
        allocator,
        io,
        files,
        parsed_sources,
        parsed_file_indexes,
        &var facts
    );
    var index = 0;
    while ok and index < parsed_sources.len() {
        let file_index = try parsed_file_indexes.get(index);
        let file = try files.at(file_index);
        if source::is_frontend_source(file.kind) {
            let parsed = try parsed_sources.at(index);
            if !(try fast_diagnostics_ast_node_with_context(
                allocator,
                io,
                files,
                file,
                parsed.ast,
                parsed.root,
                &var facts,
                true
            )) {
                ok = false;
            }
        }
        index = index + 1;
    }
    while parsed_sources.len() > 0 {
        let parsed = try parsed_sources.pop();
        parsed.deinit();
    }
    parsed_sources.deinit();
    parsed_file_indexes.deinit();
    return ok;
}

fn parse_package_fast_diagnostic_sources(
    allocator: Allocator,
    io: Io,
    files: &std::array::Array<source::SourceFile>,
    parsed_sources: &var std::array::Array<std::kizu::ast::ParseResult>,
    parsed_file_indexes: &var std::array::Array<i64>,
    facts: &var FastDiagnosticContext
) -> !bool {
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if source::is_source_code(file.kind) {
            if !(try parse_package_fast_diagnostic_source(
                allocator,
                io,
                file,
                index,
                parsed_sources,
                parsed_file_indexes,
                facts
            )) {
                return false;
            }
        }
        index = index + 1;
    }
    return true;
}

fn parse_package_fast_diagnostic_source(
    allocator: Allocator,
    io: Io,
    file: &source::SourceFile,
    file_index: i64,
    parsed_sources: &var std::array::Array<std::kizu::ast::ParseResult>,
    parsed_file_indexes: &var std::array::Array<i64>,
    facts: &var FastDiagnosticContext
) -> !bool {
    if source::is_frontend_source(file.kind) {
        let parsed_validation = try parser::validate_diagnostic_file(
            allocator,
            file.path,
            file.text
        );
        let validation_ok = parsed_validation.ok;
        if !validation_ok {
            return try write_parse_failure(allocator, io, parsed_validation);
        }
        let parsed = try parser::parse_validated_file(
            allocator,
            file.path,
            file.text,
            validation_ok
        );
        try append_package_fast_diagnostic_source(
            allocator,
            file,
            file_index,
            parsed,
            parsed_sources,
            parsed_file_indexes,
            facts
        );
        return true;
    }
    let parsed = try parser::parse_checked_file(
        allocator,
        file.path,
        file.text
    );
    try append_package_fast_diagnostic_source(
        allocator,
        file,
        file_index,
        parsed,
        parsed_sources,
        parsed_file_indexes,
        facts
    );
    return true;
}

fn append_package_fast_diagnostic_source(
    allocator: Allocator,
    file: &source::SourceFile,
    file_index: i64,
    parsed: std::kizu::ast::ParseResult,
    parsed_sources: &var std::array::Array<std::kizu::ast::ParseResult>,
    parsed_file_indexes: &var std::array::Array<i64>,
    facts: &var FastDiagnosticContext
) -> !void {
    try type_refs::collect_declared_types_from_ast(
        allocator,
        file,
        parsed.ast,
        parsed.root,
        &var facts.type_kinds,
        &var facts.type_arities,
        &var facts.copyable_types
    );
    try ownership::collect_borrow_param_keys(
        allocator,
        file,
        parsed.ast,
        parsed.root,
        &var facts.borrow_params
    );
    try function_calls::collect_function_arities_from_ast(
        allocator,
        file,
        &parsed.ast,
        parsed.root,
        &var facts.function_arities
    );
    try parsed_sources.append(parsed);
    try parsed_file_indexes.append(file_index);
    return;
}

pub fn fast_diagnostics(
    allocator: Allocator,
    io: Io,
    path: []u8,
    file_text: []u8
) -> !bool {
    let parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        return try write_parse_failure(allocator, io, parsed_validation);
    }
    var files = try loader::load_file_sources(allocator, io, path, file_text);
    defer files.deinit();
    let file = try files.at(0);
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    defer parsed.deinit();

    return try fast_diagnostics_ast_node(allocator, io, files, file, parsed.ast, parsed.root);
}

pub fn fast_diagnostics_ast_node(
    allocator: Allocator,
    io: Io,
    files: &std::array::Array<source::SourceFile>,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !bool {
    var facts = FastDiagnosticContext(allocator);
    defer facts.deinit();
    try seed_fast_diagnostic_context(&var facts);
    try type_refs::collect_declared_types_from_ast(
        allocator,
        file,
        ast,
        root,
        &var facts.type_kinds,
        &var facts.type_arities,
        &var facts.copyable_types
    );
    try ownership::collect_borrow_param_keys(
        allocator,
        file,
        ast,
        root,
        &var facts.borrow_params
    );
    return try fast_diagnostics_ast_node_with_context(
        allocator,
        io,
        files,
        file,
        ast,
        root,
        &var facts,
        false
    );
}

fn fast_diagnostics_ast_node_with_context(
    allocator: Allocator,
    io: Io,
    files: &std::array::Array<source::SourceFile>,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    facts: &var FastDiagnosticContext,
    use_cached_arities: bool
) -> !bool {
    let duplicate = try resolver::first_duplicate_declaration_ast_node(
        allocator,
        file,
        ast,
        root
    );
    if duplicate.found {
        let duplicate_name = file.text[duplicate.start..duplicate.end];
        try diagnostics::duplicate_symbol_error(allocator, io, duplicate_name);
        return false;
    }

    let pre_move = try types::first_pre_move_check_diagnostic_ast_node_with_types(
        allocator,
        file,
        ast,
        root,
        &var facts.type_kinds,
        &var facts.type_arities,
        &var facts.copyable_types
    );
    if !(try write_check_diagnostic(allocator, io, file.text, &pre_move)) {
        return false;
    }

    let moved_name = try ownership::first_use_after_move_name_ast_node_with_borrow_params(
        allocator,
        file,
        ast,
        root,
        &facts.borrow_params
    );
    if !std::mem::equal_bytes(moved_name, "") {
        try diagnostics::move_error(allocator, io, moved_name);
        return false;
    }

    let post_move = try types::first_post_move_check_diagnostic_ast_node(
        allocator,
        file,
        ast,
        root
    );
    if !(try write_check_diagnostic(allocator, io, file.text, &post_move)) {
        return false;
    }
    if use_cached_arities and !(try write_cached_package_function_call_diagnostic(
        allocator,
        io,
        file,
        &ast,
        root,
        &facts.function_arities
    )) {
        return false;
    }
    if !use_cached_arities and !(try write_package_function_call_diagnostic(
        allocator,
        io,
        files,
        file,
        &ast,
        root
    )) {
        return false;
    }
    return true;
}

fn write_parse_failure(
    allocator: Allocator,
    io: Io,
    parsed_validation: validation::ParseValidation
) -> !bool {
    try diagnostics::parse_validation_error(allocator, io, parsed_validation);
    return false;
}

fn write_parse_failure_exit(
    allocator: Allocator,
    io: Io,
    parsed_validation: validation::ParseValidation
) -> !i64 {
    try diagnostics::parse_validation_error(allocator, io, parsed_validation);
    return std::process::exit_code(1);
}

fn write_check_diagnostic(
    allocator: Allocator,
    io: Io,
    file_text: []u8,
    diagnostic: &model::CheckDiagnosticSummary
) -> !bool {
    if !diagnostic.found {
        return true;
    }
    if diagnostic.kind == 1 {
        return try write_check_type_reference_diagnostic(allocator, io, file_text, diagnostic);
    }
    if diagnostic.kind == 2 {
        let match_summary = model::MatchDiagnosticSummary {
            found: true,
            kind: diagnostic.detail_kind,
            name: diagnostic.name,
            tag: diagnostic.tag
        };
        try diagnostics::match_error(allocator, io, match_summary);
        return false;
    }
    if diagnostic.kind == 3 {
        try output::error_line(allocator, io, "error: type error: return type mismatch");
        return false;
    }
    if diagnostic.kind == 4 {
        let call_summary = model::FunctionCallSummary {
            found: true,
            kind: diagnostic.detail_kind,
            start: diagnostic.start,
            end: diagnostic.end,
            expected: diagnostic.expected,
            observed: diagnostic.observed
        };
        try diagnostics::function_call_error(allocator, io, file_text, call_summary);
        return false;
    }
    if diagnostic.kind == 5 {
        try std::io::write_stderr(io, "error: type error: undefined variable `");
        try std::io::write_stderr(io, diagnostic.name);
        try output::error_line(allocator, io, "`");
        return false;
    }
    if diagnostic.kind == 6 {
        try output::error_line(allocator, io, "error: type error: argument type mismatch");
        return false;
    }
    if diagnostic.kind == 7 {
        try std::io::write_stderr(io, "error: type error: cannot assign to immutable binding `");
        try std::io::write_stderr(io, diagnostic.name);
        try output::error_line(allocator, io, "`");
        return false;
    }
    if diagnostic.kind == 8 {
        try std::io::write_stderr(io, "error: type error: invalid assignment target `");
        try std::io::write_stderr(io, file_text[diagnostic.start..diagnostic.end]);
        try output::error_line(allocator, io, "`");
        return false;
    }
    if diagnostic.kind == 9 {
        try output::error_line(allocator, io, "error: type error: assignment type mismatch");
        return false;
    }
    if diagnostic.kind == 10 {
        try std::io::write_stderr(io, "error: type error: function `");
        try std::io::write_stderr(io, diagnostic.name);
        try std::io::write_stderr(io, "` must return ");
        try std::io::write_stderr(io, diagnostic.expected_text);
        try output::stderr_newline(allocator, io);
        return false;
    }
    try output::error_line(allocator, io, "error: check failed");
    return false;
}

fn write_check_type_reference_diagnostic(
    allocator: Allocator,
    io: Io,
    file_text: []u8,
    diagnostic: &model::CheckDiagnosticSummary
) -> !bool {
    let name = file_text[diagnostic.start..diagnostic.end];
    if diagnostic.detail_kind == 1 {
        try diagnostics::unknown_type_error(allocator, io, name);
        return false;
    }
    if diagnostic.detail_kind == 2 {
        try diagnostics::type_arity_error(
            allocator,
            io,
            name,
            diagnostic.expected,
            diagnostic.observed
        );
        return false;
    }
    try output::error_line(allocator, io, "error: check failed");
    return false;
}

fn write_package_function_call_diagnostic(
    allocator: Allocator,
    io: Io,
    files: &std::array::Array<source::SourceFile>,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !bool {
    let call_error = try types::first_package_function_call_error_ast_node(
        allocator,
        files,
        file,
        ast,
        root
    );
    if call_error.found {
        try diagnostics::function_call_error(allocator, io, file.text, call_error);
        return false;
    }
    return true;
}

fn write_cached_package_function_call_diagnostic(
    allocator: Allocator,
    io: Io,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_arities: &std::map::Map<[]u8, i64>
) -> !bool {
    let call_error = try function_calls::first_function_call_error_ast_node(
        allocator,
        file,
        ast,
        root,
        function_arities,
        false
    );
    if call_error.found {
        try diagnostics::function_call_error(allocator, io, file.text, call_error);
        return false;
    }
    return true;
}
