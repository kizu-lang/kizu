import selfhost::cache::key;
import selfhost::cache::layout;
import selfhost::cache::metadata;
import selfhost::cache::prune;
import selfhost::cache::status;
import selfhost::cache::storage;
import selfhost::source;

pub enum CacheBackend {
    Interpreter,
    Llvm,
    Wat,
    C,
}

pub enum OptimizationMode {
    Debug,
    ReleaseSafe,
    ReleaseFast,
    ReleaseSmall,
}

pub struct CacheKeyInput {
    pub compiler_version: []u8,
    pub manifest_path: []u8,
    pub manifest_hash: []u8,
    pub module_graph_hash: []u8,
    pub source_hashes: []u8,
    pub public_interface_hash: []u8,
    pub target: []u8,
    pub backend: CacheBackend,
    pub optimization_mode: OptimizationMode,
    pub stdlib_hash: []u8,
    pub stdlib_version: []u8,
}

pub struct CacheKey {
    pub fingerprint: i64,
}

pub struct CacheEntryMetadata {
    pub key: CacheKey,
    pub input_description: []u8,
    pub artifact_path: []u8,
}

pub struct CacheLookup {
    pub found: bool,
    pub artifact_path: []u8,
    pub metadata: CacheEntryMetadata,
}

pub struct CacheStatus {
    pub dir: []u8,
    pub entries: i64,
    pub size_bytes: i64,
}

pub struct CachePrunePolicy {
    pub delete_all: bool,
    pub max_entries: i64,
    pub max_bytes: i64,
}

pub struct CachePruneReport {
    pub removed_entries: i64,
    pub freed_bytes: i64,
    pub remaining_entries: i64,
}

pub struct CacheRebuildReason {
    pub hit: bool,
    pub no_previous_build: bool,
    pub compiler_version_changed: bool,
    pub manifest_changed: bool,
    pub module_graph_changed: bool,
    pub source_changed: bool,
    pub public_interface_changed: bool,
    pub target_changed: bool,
    pub backend_changed: bool,
    pub optimization_mode_changed: bool,
    pub stdlib_changed: bool,
}

struct PruneFourKeys {
    a: CacheKey,
    b: CacheKey,
    c: CacheKey,
    d: CacheKey,
}

pub struct StageCacheInput {
    pub manifest_hash: i64,
    pub module_graph_hash: i64,
    pub source_hashes: i64,
    pub public_interface_hash: i64,
    pub stdlib_hash: i64,
}

pub fn compute_key(input: &CacheKeyInput) -> CacheKey {
    return CacheKey {
        fingerprint: key::compute_fingerprint(
            input.compiler_version,
            input.manifest_path,
            input.manifest_hash,
            input.module_graph_hash,
            input.source_hashes,
            input.public_interface_hash,
            input.target,
            backend_name(input.backend),
            optimization_mode_name(input.optimization_mode),
            input.stdlib_hash,
            input.stdlib_version
        )
    };
}

pub fn cache_root_dir() -> []u8 {
    return layout::cache_root_dir();
}

pub fn cache_entry_dir() -> []u8 {
    return layout::cache_entry_dir();
}

pub fn cache_artifact_dir() -> []u8 {
    return layout::cache_artifact_dir();
}

pub fn cache_entry_metadata_path(
    allocator: Allocator,
    key: &CacheKey
) -> !std::string::String {
    return try layout::cache_entry_metadata_path(allocator, key.fingerprint);
}

pub fn cache_entry_artifact_path(
    allocator: Allocator,
    key: &CacheKey
) -> !std::string::String {
    return try layout::cache_entry_artifact_path(allocator, key.fingerprint);
}

pub fn ensure_cache_layout(io: Io) -> !void {
    try layout::ensure_cache_layout(io);
    return;
}

pub fn write_entry(
    allocator: Allocator,
    io: Io,
    input: CacheKeyInput,
    artifact: []u8
) -> !CacheEntryMetadata {
    let entry_metadata = try storage::write_entry(
        allocator,
        io,
        input.compiler_version,
        input.manifest_path,
        input.manifest_hash,
        input.module_graph_hash,
        input.source_hashes,
        input.public_interface_hash,
        input.target,
        backend_name(input.backend),
        optimization_mode_name(input.optimization_mode),
        input.stdlib_hash,
        input.stdlib_version,
        artifact
    );
    return cache_entry_metadata_from_storage(entry_metadata);
}

pub fn read_entry(
    allocator: Allocator,
    io: Io,
    key: &CacheKey
) -> !CacheEntryMetadata {
    let entry_metadata = try storage::read_entry(allocator, io, key.fingerprint);
    return cache_entry_metadata_from_storage(entry_metadata);
}

pub fn lookup_entry(
    allocator: Allocator,
    io: Io,
    key: &CacheKey
) -> !CacheLookup {
    let lookup = try storage::lookup_entry(allocator, io, key.fingerprint);
    return CacheLookup {
        found: lookup.found,
        artifact_path: lookup.artifact_path,
        metadata: CacheEntryMetadata {
            key: CacheKey { fingerprint: lookup.fingerprint },
            input_description: lookup.input_description,
            artifact_path: lookup.artifact_path
        }
    };
}

fn cache_entry_metadata_from_storage(entry_metadata: metadata::EntryMetadata) -> CacheEntryMetadata {
    return CacheEntryMetadata {
        key: CacheKey { fingerprint: entry_metadata.fingerprint },
        input_description: entry_metadata.input_description,
        artifact_path: entry_metadata.artifact_path
    };
}

pub fn cache_status(io: Io) -> !CacheStatus {
    let counts = try status::cache_status(io);
    return CacheStatus {
        dir: cache_root_dir(),
        entries: counts.entries,
        size_bytes: counts.size_bytes
    };
}

pub fn cache_prune_all_policy() -> CachePrunePolicy {
    return CachePrunePolicy {
        delete_all: true,
        max_entries: -1,
        max_bytes: -1
    };
}

pub fn prune_cache(io: Io, policy: CachePrunePolicy) -> !CachePruneReport {
    let report = try prune::prune_cache(
        io,
        policy.delete_all,
        policy.max_entries,
        policy.max_bytes
    );
    return CachePruneReport {
        removed_entries: report.removed_entries,
        freed_bytes: report.freed_bytes,
        remaining_entries: report.remaining_entries
    };
}

pub fn stage_cache_input(
    files: &std::array::Array<source::SourceFile>
) -> !StageCacheInput {
    return StageCacheInput {
        manifest_hash: try hash_selected_sources(files, true, false, false),
        module_graph_hash: try stage_module_graph_hash(files),
        source_hashes: try hash_selected_sources(files, false, true, true),
        public_interface_hash: try hash_selected_sources(files, false, true, true),
        stdlib_hash: try hash_selected_sources(files, false, false, true)
    };
}

fn stage_module_graph_hash(files: &std::array::Array<source::SourceFile>) -> !i64 {
    var fingerprint = 17;
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        fingerprint = fingerprint_append_bytes(fingerprint, source_kind_name(file.kind));
        fingerprint = fingerprint_append_byte(fingerprint, cast<u8>(58));
        fingerprint = fingerprint_append_bytes(fingerprint, file.package_name);
        fingerprint = fingerprint_append_byte(fingerprint, cast<u8>(58));
        fingerprint = fingerprint_append_bytes(fingerprint, source::module_path(file));
        fingerprint = fingerprint_append_byte(fingerprint, cast<u8>(58));
        fingerprint = fingerprint_append_bytes(fingerprint, file.path);
        fingerprint = fingerprint_append_byte(fingerprint, cast<u8>(10));
        index = index + 1;
    }
    return fingerprint;
}

fn hash_selected_sources(
    files: &std::array::Array<source::SourceFile>,
    include_manifest: bool,
    include_selfhost: bool,
    include_std: bool
) -> !i64 {
    var fingerprint = 17;
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if include_source_kind(file.kind, include_manifest, include_selfhost, include_std) {
            fingerprint = fingerprint_append_bytes(fingerprint, source_kind_name(file.kind));
            fingerprint = fingerprint_append_byte(fingerprint, cast<u8>(58));
            fingerprint = fingerprint_append_bytes(fingerprint, file.path);
            fingerprint = fingerprint_append_byte(fingerprint, cast<u8>(58));
            fingerprint = fingerprint_append_bytes(fingerprint, file.text);
            fingerprint = fingerprint_append_byte(fingerprint, cast<u8>(10));
        }
        index = index + 1;
    }
    return fingerprint;
}

pub fn stage_key(input: &StageCacheInput) -> CacheKey {
    return CacheKey { fingerprint: stage_fingerprint(input) };
}

pub fn write_stage_entry(
    allocator: Allocator,
    io: Io,
    input: &StageCacheInput,
    artifact: &[]u8
) -> !CacheEntryMetadata {
    try layout::ensure_cache_layout(io);
    let fingerprint = stage_fingerprint(input);
    var artifact_path = try layout::cache_entry_artifact_path(allocator, fingerprint);
    let artifact_path_bytes = artifact_path.as_bytes();
    try std::fs::write_file(io, artifact_path_bytes, artifact);

    var input_description = std::string::String(allocator);
    try append_stage_input_description(input_description, input);
    let input_description_bytes = input_description.as_bytes();
    var metadata_path = try layout::cache_entry_metadata_path(allocator, fingerprint);
    var metadata_bytes = std::string::String(allocator);
    try metadata::append_line(metadata_bytes, "kizu-cache-entry-v0");
    try metadata_bytes.append_bytes("fingerprint ");
    try std::fmt::append_i64(metadata_bytes, fingerprint);
    try metadata_bytes.append_byte(cast<u8>(10));
    try metadata_bytes.append_bytes("input-description ");
    try metadata_bytes.append_bytes(input_description_bytes);
    try metadata_bytes.append_byte(cast<u8>(10));
    try metadata_bytes.append_bytes("artifact ");
    try metadata_bytes.append_bytes(artifact_path_bytes);
    try metadata_bytes.append_byte(cast<u8>(10));
    let metadata_path_bytes = metadata_path.as_bytes();
    let metadata_view = metadata_bytes.as_bytes();
    try std::fs::write_file(io, metadata_path_bytes, metadata_view);
    metadata_path.deinit();
    metadata_bytes.deinit();
    input_description.deinit();
    artifact_path.deinit();
    let entry_key = CacheKey { fingerprint: fingerprint };
    return try read_entry(allocator, io, &entry_key);
}

fn stage_fingerprint(input: &StageCacheInput) -> i64 {
    var state = 17;
    state = stage_mix_bytes(state, "compiler-version", stage_compiler_version());
    state = stage_mix_bytes(state, "manifest-path", stage_manifest_path());
    state = stage_mix_i64(state, "manifest-hash", input.manifest_hash);
    state = stage_mix_i64(state, "module-graph-hash", input.module_graph_hash);
    state = stage_mix_i64(state, "source-hashes", input.source_hashes);
    state = stage_mix_i64(state, "public-interface-hash", input.public_interface_hash);
    state = stage_mix_bytes(state, "target", stage_target());
    state = stage_mix_bytes(state, "backend", "llvm");
    state = stage_mix_bytes(state, "optimization-mode", "debug");
    state = stage_mix_i64(state, "stdlib-hash", input.stdlib_hash);
    state = stage_mix_bytes(state, "stdlib-version", stage_stdlib_version());
    return state;
}

fn stage_mix_bytes(state: i64, name: []u8, value: []u8) -> i64 {
    var next = fingerprint_append_bytes(state, name);
    next = fingerprint_append_byte(next, cast<u8>(0));
    next = fingerprint_append_bytes(next, value);
    next = fingerprint_append_byte(next, cast<u8>(10));
    return next;
}

fn stage_mix_i64(state: i64, name: []u8, value: i64) -> i64 {
    var next = fingerprint_append_bytes(state, name);
    next = fingerprint_append_byte(next, cast<u8>(0));
    var divisor = 1;
    while divisor * 10 <= value {
        divisor = divisor * 10;
    }
    var current = value;
    while divisor > 0 {
        let digit = current / divisor;
        next = fingerprint_append_byte(next, cast<u8>(48 + digit));
        current = current - (digit * divisor);
        divisor = divisor / 10;
    }
    next = fingerprint_append_byte(next, cast<u8>(10));
    return next;
}

fn append_stage_input_description(
    out: &var std::string::String,
    input: &StageCacheInput
) -> !void {
    try metadata::append_input_pair(out, "compiler-version", stage_compiler_version());
    try metadata::append_input_pair(out, "manifest-path", stage_manifest_path());
    try append_stage_input_pair_i64(out, "manifest-hash", input.manifest_hash);
    try append_stage_input_pair_i64(out, "module-graph-hash", input.module_graph_hash);
    try append_stage_input_pair_i64(out, "source-hashes", input.source_hashes);
    try append_stage_input_pair_i64(out, "public-interface-hash", input.public_interface_hash);
    try metadata::append_input_pair(out, "target", stage_target());
    try metadata::append_input_pair(out, "backend", "llvm");
    try metadata::append_input_pair(out, "optimization-mode", "debug");
    try append_stage_input_pair_i64(out, "stdlib-hash", input.stdlib_hash);
    try metadata::append_input_pair(out, "stdlib-version", stage_stdlib_version());
    return;
}

fn append_stage_input_pair_i64(
    out: &var std::string::String,
    name: []u8,
    value: i64
) -> !void {
    if out.len() > 0 {
        try out.append_byte(cast<u8>(59));
    }
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(61));
    try std::fmt::append_i64(out, value);
    return;
}

fn stage_compiler_version() -> []u8 { return "selfhost-stage-cache-v0"; }
fn stage_manifest_path() -> []u8 { return "selfhost/kizu.toml"; }
fn stage_target() -> []u8 { return "native-hosted-selfhost-abi-v0"; }
fn stage_stdlib_version() -> []u8 { return "selfhost-abi-v0"; }

fn include_source_kind(
    kind: source::SourceKind,
    include_manifest: bool,
    include_selfhost: bool,
    include_std: bool
) -> bool {
    if kind == source::SourceKind::Manifest {
        return include_manifest;
    }
    if kind == source::SourceKind::Selfhost {
        return include_selfhost;
    }
    if kind == source::SourceKind::Std {
        return include_std;
    }
    return false;
}

fn source_kind_name(kind: source::SourceKind) -> []u8 {
    if kind == source::SourceKind::Manifest {
        return "manifest";
    }
    if kind == source::SourceKind::Selfhost {
        return "selfhost";
    }
    if kind == source::SourceKind::Std {
        return "std";
    }
    return "user";
}

fn hash_bytes_to_string(allocator: Allocator, bytes: []u8) -> !std::string::String {
    return try fingerprint_to_string(allocator, fingerprint_bytes(bytes));
}

fn fingerprint_to_string(allocator: Allocator, fingerprint: i64) -> !std::string::String {
    var out = std::string::String(allocator);
    try std::fmt::append_i64(out, fingerprint);
    return out;
}

fn fingerprint_bytes(bytes: []u8) -> i64 {
    var state = 17;
    return fingerprint_append_bytes(state, bytes);
}

fn fingerprint_append_bytes(state: i64, bytes: []u8) -> i64 {
    var next = state;
    var index = 0;
    while index < std::mem::len(bytes) {
        next = fingerprint_append_byte(next, bytes[index]);
        index = index + 1;
    }
    return next;
}

fn fingerprint_append_byte(state: i64, byte: u8) -> i64 {
    return ((state * 257) + cast<i64>(byte) + 1) % 1000000007;
}

pub fn compare_rebuild_inputs(
    current: &CacheKeyInput,
    previous_found: bool,
    previous_input_description: []u8
) -> !CacheRebuildReason {
    if !previous_found {
        return no_previous_rebuild_reason();
    }

    var reason = empty_rebuild_reason();
    reason.compiler_version_changed = try metadata::input_field_changed(
        previous_input_description,
        "compiler-version",
        current.compiler_version
    );
    reason.manifest_changed = (try metadata::input_field_changed(
        previous_input_description,
        "manifest-path",
        current.manifest_path
    )) or (try metadata::input_field_changed(
        previous_input_description,
        "manifest-hash",
        current.manifest_hash
    ));
    reason.module_graph_changed = try metadata::input_field_changed(
        previous_input_description,
        "module-graph-hash",
        current.module_graph_hash
    );
    reason.source_changed = try metadata::input_field_changed(
        previous_input_description,
        "source-hashes",
        current.source_hashes
    );
    reason.public_interface_changed = try metadata::input_field_changed(
        previous_input_description,
        "public-interface-hash",
        current.public_interface_hash
    );
    reason.target_changed = try metadata::input_field_changed(
        previous_input_description,
        "target",
        current.target
    );
    reason.backend_changed = try metadata::input_field_changed(
        previous_input_description,
        "backend",
        backend_name(current.backend)
    );
    reason.optimization_mode_changed = try metadata::input_field_changed(
        previous_input_description,
        "optimization-mode",
        optimization_mode_name(current.optimization_mode)
    );
    reason.stdlib_changed = (try metadata::input_field_changed(
        previous_input_description,
        "stdlib-hash",
        current.stdlib_hash
    )) or (try metadata::input_field_changed(
        previous_input_description,
        "stdlib-version",
        current.stdlib_version
    ));
    reason.hit = !rebuild_reason_changed(&reason);
    return reason;
}

pub fn gate() -> !void {
    let base = sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    let same = sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    let base_key = compute_key(&base);
    let same_key = compute_key(&same);
    std::testing::expect_equal<i64>(base_key.fingerprint, same_key.fingerprint);

    expect_changed(&base_key, sample_input("0.3.1", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0"));
    expect_changed(&base_key, sample_input_at_path("package/kizu.toml"));
    expect_changed(&base_key, sample_input("0.3.0", "manifest-b", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0"));
    expect_changed(&base_key, sample_input("0.3.0", "manifest-a", "graph-b", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0"));
    expect_changed(&base_key, sample_input("0.3.0", "manifest-a", "graph-a", "source-b", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0"));
    expect_changed(&base_key, sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-b", "x86_64-linux", "stdlib-a", "0.3.0"));
    expect_changed(&base_key, sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "aarch64-linux", "stdlib-a", "0.3.0"));
    expect_changed(&base_key, CacheKeyInput {
        compiler_version: "0.3.0",
        manifest_path: "selfhost/kizu.toml",
        manifest_hash: "manifest-a",
        module_graph_hash: "graph-a",
        source_hashes: "source-a",
        public_interface_hash: "iface-a",
        target: "x86_64-linux",
        backend: CacheBackend::Wat,
        optimization_mode: OptimizationMode::Debug,
        stdlib_hash: "stdlib-a",
        stdlib_version: "0.3.0"
    });
    expect_changed(&base_key, CacheKeyInput {
        compiler_version: "0.3.0",
        manifest_path: "selfhost/kizu.toml",
        manifest_hash: "manifest-a",
        module_graph_hash: "graph-a",
        source_hashes: "source-a",
        public_interface_hash: "iface-a",
        target: "x86_64-linux",
        backend: CacheBackend::Llvm,
        optimization_mode: OptimizationMode::ReleaseSafe,
        stdlib_hash: "stdlib-a",
        stdlib_version: "0.3.0"
    });
    expect_changed(&base_key, sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-b", "0.3.0"));
    expect_changed(&base_key, sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.1"));

    print("cache-key");
    print(base_key.fingerprint);

    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let status_base = sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    let why_base = sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    try gate_status_and_prune(allocator, io, status_base);
    try gate_why_rebuild(why_base);
    try gate_storage_roundtrip(allocator, io, base);
    return;
}

fn sample_input(
    compiler_version: []u8,
    manifest_hash: []u8,
    module_graph_hash: []u8,
    source_hashes: []u8,
    public_interface_hash: []u8,
    target: []u8,
    stdlib_hash: []u8,
    stdlib_version: []u8
) -> CacheKeyInput {
    return CacheKeyInput {
        compiler_version: compiler_version,
        manifest_path: "selfhost/kizu.toml",
        manifest_hash: manifest_hash,
        module_graph_hash: module_graph_hash,
        source_hashes: source_hashes,
        public_interface_hash: public_interface_hash,
        target: target,
        backend: CacheBackend::Llvm,
        optimization_mode: OptimizationMode::Debug,
        stdlib_hash: stdlib_hash,
        stdlib_version: stdlib_version
    };
}

fn sample_input_at_path(manifest_path: []u8) -> CacheKeyInput {
    return CacheKeyInput {
        compiler_version: "0.3.0",
        manifest_path: manifest_path,
        manifest_hash: "manifest-a",
        module_graph_hash: "graph-a",
        source_hashes: "source-a",
        public_interface_hash: "iface-a",
        target: "x86_64-linux",
        backend: CacheBackend::Llvm,
        optimization_mode: OptimizationMode::Debug,
        stdlib_hash: "stdlib-a",
        stdlib_version: "0.3.0"
    };
}

fn expect_changed(base_key: &CacheKey, input: CacheKeyInput) -> void {
    let changed_key = compute_key(&input);
    std::testing::expect(base_key.fingerprint != changed_key.fingerprint);
    return;
}

fn gate_storage_roundtrip(
    allocator: Allocator,
    io: Io,
    input: CacheKeyInput
) -> !void {
    var written = try write_entry(allocator, io, input, "selfhost-cache-artifact\n");
    var read = try read_entry(allocator, io, &written.key);
    var lookup = try lookup_entry(allocator, io, &written.key);

    expect_metadata_equal(&written, &read);
    std::testing::expect(lookup.found);
    expect_metadata_equal(&written, &lookup.metadata);
    let artifact = try std::fs::read_file(io, read.artifact_path);
    std::testing::expect_equal<[]u8>("selfhost-cache-artifact\n", artifact);

    print("cache-entry");
    print(read.key.fingerprint);
    print("cache-lookup");
    print(lookup.metadata.key.fingerprint);

    return;
}

fn gate_status_and_prune(
    allocator: Allocator,
    io: Io,
    base: CacheKeyInput
) -> !void {
    let artifact_a = "artifact-a\n";
    let artifact_b = "artifact-b\n";
    let cleanup = try prune_cache(io, cache_prune_all_policy());
    std::testing::expect(cleanup.removed_entries >= 0);
    std::testing::expect(cleanup.freed_bytes >= 0);
    std::testing::expect_equal<i64>(0, cleanup.remaining_entries);

    let empty = try cache_status(io);
    std::testing::expect(std::mem::equal_bytes(empty.dir, cache_root_dir()));
    std::testing::expect_equal<i64>(0, empty.entries);
    std::testing::expect_equal<i64>(0, empty.size_bytes);

    let other = sample_input("0.3.0", "manifest-prune", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    let first = try write_entry(allocator, io, base, artifact_a);
    let second = try write_entry(allocator, io, other, artifact_b);
    std::testing::expect(first.key.fingerprint != second.key.fingerprint);

    let filled = try cache_status(io);
    std::testing::expect_equal<i64>(2, filled.entries);
    std::testing::expect_equal<i64>(
        std::mem::len(artifact_a) + std::mem::len(artifact_b),
        filled.size_bytes
    );

    let pruned = try prune_cache(io, cache_prune_all_policy());
    std::testing::expect_equal<i64>(2, pruned.removed_entries);
    std::testing::expect_equal<i64>(
        std::mem::len(artifact_a) + std::mem::len(artifact_b),
        pruned.freed_bytes
    );
    std::testing::expect_equal<i64>(0, pruned.remaining_entries);

    let after = try cache_status(io);
    std::testing::expect_equal<i64>(0, after.entries);
    std::testing::expect_equal<i64>(0, after.size_bytes);
    try gate_bounded_prune(allocator, io);
    return;
}

fn gate_bounded_prune(allocator: Allocator, io: Io) -> !void {
    let artifact = "bounded-prune";
    let bytes = std::mem::len(artifact);
    try gate_bounded_prune_case(allocator, io, artifact, 4, bytes * 4, 0);
    try gate_bounded_prune_case(allocator, io, artifact, 3, -1, 1);
    try gate_bounded_prune_case(allocator, io, artifact, -1, bytes * 3, 1);
    try gate_bounded_prune_case(allocator, io, artifact, 2, bytes * 2, 2);
    let cleanup = try prune_cache(io, cache_prune_all_policy());
    std::testing::expect(cleanup.removed_entries >= 0);
    std::testing::expect(cleanup.freed_bytes >= 0);
    std::testing::expect_equal<i64>(0, cleanup.remaining_entries);
    return;
}

fn gate_bounded_prune_case(
    allocator: Allocator,
    io: Io,
    artifact: []u8,
    max_entries: i64,
    max_bytes: i64,
    removed_count: i64
) -> !void {
    try clear_cache_for_gate(io);
    let bytes = std::mem::len(artifact);
    let keys = try write_four_prune_entries(allocator, io, artifact);
    let report = try prune_cache(io, bounded_prune_policy(max_entries, max_bytes));
    let remaining = 4 - removed_count;
    expect_prune_report(report, removed_count, bytes * removed_count, remaining);
    try expect_cache_status_counts(io, remaining, bytes * remaining);
    try expect_four_key_lookups(allocator, io, &keys, removed_count);
    return;
}

fn clear_cache_for_gate(io: Io) -> !void {
    let cleanup = try prune_cache(io, cache_prune_all_policy());
    std::testing::expect(cleanup.removed_entries >= 0);
    std::testing::expect(cleanup.freed_bytes >= 0);
    std::testing::expect_equal<i64>(0, cleanup.remaining_entries);
    return;
}

fn bounded_prune_policy(max_entries: i64, max_bytes: i64) -> CachePrunePolicy {
    return CachePrunePolicy {
        delete_all: false,
        max_entries: max_entries,
        max_bytes: max_bytes
    };
}

fn write_four_prune_entries(
    allocator: Allocator,
    io: Io,
    artifact: []u8
) -> !PruneFourKeys {
    let input_a = sample_input("0.3.0", "bounded-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    let input_b = sample_input("0.3.0", "bounded-b", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    let input_c = sample_input("0.3.0", "bounded-c", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    let input_d = sample_input("0.3.0", "bounded-d", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    let written_a = try write_entry(allocator, io, input_a, artifact);
    let written_b = try write_entry(allocator, io, input_b, artifact);
    let written_c = try write_entry(allocator, io, input_c, artifact);
    let written_d = try write_entry(allocator, io, input_d, artifact);
    return PruneFourKeys {
        a: CacheKey { fingerprint: written_a.key.fingerprint },
        b: CacheKey { fingerprint: written_b.key.fingerprint },
        c: CacheKey { fingerprint: written_c.key.fingerprint },
        d: CacheKey { fingerprint: written_d.key.fingerprint }
    };
}

fn expect_prune_report(
    report: CachePruneReport,
    removed_entries: i64,
    freed_bytes: i64,
    remaining_entries: i64
) -> void {
    std::testing::expect_equal<i64>(removed_entries, report.removed_entries);
    std::testing::expect_equal<i64>(freed_bytes, report.freed_bytes);
    std::testing::expect_equal<i64>(remaining_entries, report.remaining_entries);
    return;
}

fn expect_cache_status_counts(io: Io, entries: i64, bytes: i64) -> !void {
    let status = try cache_status(io);
    std::testing::expect_equal<i64>(entries, status.entries);
    std::testing::expect_equal<i64>(bytes, status.size_bytes);
    return;
}

fn expect_four_key_lookups(
    allocator: Allocator,
    io: Io,
    keys: &PruneFourKeys,
    removed_count: i64
) -> !void {
    try expect_lookup_found(allocator, io, &keys.a, key_rank_four(&keys.a, keys) >= removed_count);
    try expect_lookup_found(allocator, io, &keys.b, key_rank_four(&keys.b, keys) >= removed_count);
    try expect_lookup_found(allocator, io, &keys.c, key_rank_four(&keys.c, keys) >= removed_count);
    try expect_lookup_found(allocator, io, &keys.d, key_rank_four(&keys.d, keys) >= removed_count);
    return;
}

fn expect_lookup_found(
    allocator: Allocator,
    io: Io,
    key: &CacheKey,
    found: bool
) -> !void {
    let lookup = try lookup_entry(allocator, io, key);
    std::testing::expect_equal<bool>(found, lookup.found);
    return;
}

fn key_rank_four(key: &CacheKey, keys: &PruneFourKeys) -> i64 {
    var rank = 0;
    if keys.a.fingerprint < key.fingerprint {
        rank = rank + 1;
    }
    if keys.b.fingerprint < key.fingerprint {
        rank = rank + 1;
    }
    if keys.c.fingerprint < key.fingerprint {
        rank = rank + 1;
    }
    if keys.d.fingerprint < key.fingerprint {
        rank = rank + 1;
    }
    return rank;
}

fn gate_why_rebuild(base: CacheKeyInput) -> !void {
    let previous_bytes = "compiler-version=0.3.0;manifest-path=selfhost/kizu.toml;manifest-hash=manifest-a;module-graph-hash=graph-a;source-hashes=source-a;public-interface-hash=iface-a;target=x86_64-linux;backend=llvm;optimization-mode=debug;stdlib-hash=stdlib-a;stdlib-version=0.3.0";
    let hit = try compare_rebuild_inputs(&base, true, previous_bytes);
    expect_hit_reason(&hit);

    let no_previous = try compare_rebuild_inputs(&base, false, "");
    expect_no_previous_reason(&no_previous);

    let compiler_changed = sample_input("0.3.1", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&compiler_changed, true, previous_bytes),
        "compiler-version"
    );
    let manifest_changed = sample_input_at_path("package/kizu.toml");
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&manifest_changed, true, previous_bytes),
        "manifest"
    );
    let graph_changed = sample_input("0.3.0", "manifest-a", "graph-b", "source-a", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&graph_changed, true, previous_bytes),
        "module-graph"
    );
    let source_changed = sample_input("0.3.0", "manifest-a", "graph-a", "source-b", "iface-a", "x86_64-linux", "stdlib-a", "0.3.0");
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&source_changed, true, previous_bytes),
        "source"
    );
    let interface_changed = sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-b", "x86_64-linux", "stdlib-a", "0.3.0");
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&interface_changed, true, previous_bytes),
        "public-interface"
    );
    let target_changed = sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "aarch64-linux", "stdlib-a", "0.3.0");
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&target_changed, true, previous_bytes),
        "target"
    );
    let backend_changed = CacheKeyInput {
        compiler_version: "0.3.0",
        manifest_path: "selfhost/kizu.toml",
        manifest_hash: "manifest-a",
        module_graph_hash: "graph-a",
        source_hashes: "source-a",
        public_interface_hash: "iface-a",
        target: "x86_64-linux",
        backend: CacheBackend::Wat,
        optimization_mode: OptimizationMode::Debug,
        stdlib_hash: "stdlib-a",
        stdlib_version: "0.3.0"
    };
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&backend_changed, true, previous_bytes),
        "backend"
    );
    let optimization_changed = CacheKeyInput {
        compiler_version: "0.3.0",
        manifest_path: "selfhost/kizu.toml",
        manifest_hash: "manifest-a",
        module_graph_hash: "graph-a",
        source_hashes: "source-a",
        public_interface_hash: "iface-a",
        target: "x86_64-linux",
        backend: CacheBackend::Llvm,
        optimization_mode: OptimizationMode::ReleaseSafe,
        stdlib_hash: "stdlib-a",
        stdlib_version: "0.3.0"
    };
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&optimization_changed, true, previous_bytes),
        "optimization-mode"
    );
    let stdlib_changed = sample_input("0.3.0", "manifest-a", "graph-a", "source-a", "iface-a", "x86_64-linux", "stdlib-b", "0.3.0");
    expect_single_rebuild_input_change(
        try compare_rebuild_inputs(&stdlib_changed, true, previous_bytes),
        "stdlib"
    );
    return;
}

fn expect_metadata_equal(
    expected: &CacheEntryMetadata,
    actual: &CacheEntryMetadata
) -> void {
    std::testing::expect_equal<i64>(
        expected.key.fingerprint,
        actual.key.fingerprint
    );
    std::testing::expect(std::mem::equal_bytes(
        expected.input_description,
        actual.input_description
    ));
    std::testing::expect(std::mem::equal_bytes(
        expected.artifact_path,
        actual.artifact_path
    ));
    return;
}

fn empty_rebuild_reason() -> CacheRebuildReason {
    return rebuild_reason_with_no_previous(false);
}

fn no_previous_rebuild_reason() -> CacheRebuildReason {
    return rebuild_reason_with_no_previous(true);
}

fn rebuild_reason_with_no_previous(no_previous_build: bool) -> CacheRebuildReason {
    return CacheRebuildReason {
        hit: false,
        no_previous_build: no_previous_build,
        compiler_version_changed: false,
        manifest_changed: false,
        module_graph_changed: false,
        source_changed: false,
        public_interface_changed: false,
        target_changed: false,
        backend_changed: false,
        optimization_mode_changed: false,
        stdlib_changed: false
    };
}

fn rebuild_reason_changed(reason: &CacheRebuildReason) -> bool {
    return reason.compiler_version_changed or
        reason.manifest_changed or
        reason.module_graph_changed or
        reason.source_changed or
        reason.public_interface_changed or
        reason.target_changed or
        reason.backend_changed or
        reason.optimization_mode_changed or
        reason.stdlib_changed;
}

fn expect_hit_reason(reason: &CacheRebuildReason) -> void {
    std::testing::expect(reason.hit);
    std::testing::expect(!reason.no_previous_build);
    std::testing::expect(!rebuild_reason_changed(reason));
    return;
}

fn expect_no_previous_reason(reason: &CacheRebuildReason) -> void {
    std::testing::expect(!reason.hit);
    std::testing::expect(reason.no_previous_build);
    std::testing::expect(!rebuild_reason_changed(reason));
    return;
}

fn expect_single_rebuild_input_change(
    reason: CacheRebuildReason,
    name: []u8
) -> void {
    std::testing::expect(!reason.hit);
    std::testing::expect(!reason.no_previous_build);
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "compiler-version"),
        reason.compiler_version_changed
    );
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "manifest"),
        reason.manifest_changed
    );
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "module-graph"),
        reason.module_graph_changed
    );
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "source"),
        reason.source_changed
    );
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "public-interface"),
        reason.public_interface_changed
    );
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "target"),
        reason.target_changed
    );
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "backend"),
        reason.backend_changed
    );
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "optimization-mode"),
        reason.optimization_mode_changed
    );
    std::testing::expect_equal<bool>(
        std::mem::equal_bytes(name, "stdlib"),
        reason.stdlib_changed
    );
    return;
}

fn backend_name(backend: CacheBackend) -> []u8 {
    if backend == CacheBackend::Interpreter {
        return "interpreter";
    }
    if backend == CacheBackend::Llvm {
        return "llvm";
    }
    if backend == CacheBackend::Wat {
        return "wat";
    }
    return "c";
}

fn optimization_mode_name(mode: OptimizationMode) -> []u8 {
    if mode == OptimizationMode::Debug {
        return "debug";
    }
    if mode == OptimizationMode::ReleaseSafe {
        return "release-safe";
    }
    if mode == OptimizationMode::ReleaseFast {
        return "release-fast";
    }
    return "release-small";
}
