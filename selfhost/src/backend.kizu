import selfhost::ir;
import selfhost::backend::data;
import selfhost::backend::hosted;
import selfhost::backend::llvm;

pub fn summarize(program_ir: ir::IrSummary) -> data::BackendSummary {
    return data::BackendSummary {
        artifacts: program_ir.blocks
    };
}

pub fn consume_ir_artifact(io: Io, path: &[]u8) -> !data::BackendSummary {
    return llvm::consume_ir_artifact(io, path);
}

pub fn emit_llvm_artifact(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !data::LlvmArtifact {
    return llvm::emit_llvm_artifact(allocator, io, ir_path, manifest_path);
}

pub fn emit_run_print_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    stdout_payload: []u8
) -> !data::RunArtifact {
    return hosted::emit_run_print_artifact(allocator, io, source_path, stdout_payload);
}

pub fn emit_test_expect_ok_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8
) -> !data::TestArtifact {
    return hosted::emit_test_expect_ok_artifact(allocator, io, source_path);
}

pub fn emit_test_expect_failure_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8
) -> !data::TestArtifact {
    return hosted::emit_test_expect_failure_artifact(allocator, io, source_path);
}
