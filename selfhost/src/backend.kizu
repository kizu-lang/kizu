import selfhost::ir;
import selfhost::backend::data;
import selfhost::backend::executable;
import selfhost::backend::hosted;
import selfhost::backend::llvm;
import selfhost::ir::code_render;
import selfhost::parser;
import selfhost::source;

pub fn summarize(program_ir: ir::IrSummary) -> data::BackendSummary {
    return data::BackendSummary {
        artifacts: program_ir.blocks
    };
}

pub fn consume_ir_artifact(io: Io, path: &[]u8) -> !data::BackendSummary {
    return llvm::consume_ir_artifact(io, path);
}

pub fn emit_llvm_artifact(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !data::LlvmArtifact {
    return llvm::emit_llvm_artifact(allocator, io, ir_path, manifest_path);
}

pub fn render_run_codegen_artifact(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !std::string::String {
    let rendered = try code_render::render_run_ast_artifact(allocator, source_path, text, ast, root);
    return rendered;
}

pub fn emit_run_sources_codegen_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    files: &std::array::Array<source::SourceFile>
) -> !data::RunArtifact {
    var combined = std::string::String(allocator);
    defer combined.deinit();
    try append_run_source_files(&var combined, files, 0);
    let combined_bytes = combined.as_bytes();
    try ensure_run_sources_temp_dir(io);
    let combined_path = "target/selfhost/run_codegen_combined.kizu";
    try std::fs::write_file(io, combined_path, &combined_bytes);
    let combined_owned = try std::fs::read_file(io, combined_path);
    let parsed = try parser::parse_checked_file(allocator, source_path, combined_owned);
    defer parsed.deinit();
    var rendered = try code_render::render_run_ast_artifact(
        allocator,
        source_path,
        combined_owned,
        parsed.ast,
        parsed.root
    );
    defer rendered.deinit();
    let rendered_bytes = rendered.as_bytes();
    return try emit_rendered_run_artifact(
        allocator,
        io,
        source_path,
        rendered_bytes,
        rendered.len()
    );
}

fn ensure_run_sources_temp_dir(io: Io) -> !void {
    if !(try std::fs::exists(io, "target")) {
        try std::fs::create_dir(io, "target");
    }
    if !(try std::fs::exists(io, "target/selfhost")) {
        try std::fs::create_dir(io, "target/selfhost");
    }
    return;
}

fn append_run_source_files(
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>,
    index: i64
) -> !void {
    if index >= files.len() {
        return;
    }
    let file = try files.at(index);
    if run_codegen_should_inline_source(&file) {
        try append_run_source_module_marker(out, &file);
        try append_run_source_with_module_markers(out, &file);
        try out.append_byte(cast<u8>(10));
    }
    let after = index + 1;
    try append_run_source_files(out, files, after);
    return;
}

fn append_run_source_with_module_markers(
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let text = file.text;
    let length = std::mem::len(text);
    var chunk_start = 0;
    var index = 0;
    var lines = 0;
    while index < length {
        if text[index] == cast<u8>(10) {
            lines = lines + 1;
            if lines == 64 {
                let after = index + 1;
                try out.append_bytes(text[chunk_start..after]);
                try append_run_source_module_marker(out, file);
                chunk_start = after;
                lines = 0;
            }
        }
        index = index + 1;
    }
    if chunk_start < length {
        try out.append_bytes(text[chunk_start..length]);
    }
    return;
}

fn run_codegen_should_inline_source(file: &source::SourceFile) -> bool {
    if !source::is_source_code(file.kind) {
        return false;
    }
    if file.kind != source::SourceKind::Std {
        return true;
    }
    return std::mem::starts_with(file.path, "std/src/kizu/");
}

fn append_run_source_module_marker(
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    try out.append_bytes("// kizu:module ");
    try source::append_qualified_module_name(out, file);
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn emit_rendered_run_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    artifact: &[]u8,
    artifact_len: i64
) -> !data::RunArtifact {
    return hosted::emit_rendered_run_artifact(allocator, io, source_path, artifact, artifact_len);
}

