import selfhost::ir;
import selfhost::backend::data;
import selfhost::backend::executable;
import selfhost::backend::hosted;
import selfhost::backend::llvm;
import selfhost::ir::code_render;
import selfhost::types::constructor_facts;

pub fn summarize(program_ir: ir::IrSummary) -> data::BackendSummary {
    return data::BackendSummary {
        artifacts: program_ir.blocks
    };
}

pub fn consume_ir_artifact(io: Io, path: &[]u8) -> !data::BackendSummary {
    return llvm::consume_ir_artifact(io, path);
}

pub fn emit_llvm_artifact(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !data::LlvmArtifact {
    return llvm::emit_llvm_artifact(allocator, io, ir_path, manifest_path);
}

pub fn render_run_codegen_artifact(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    constructor_identities: &constructor_facts::ConstructorFacts,
    atomic_constructor_id: i64,
    bool_type_id: i64,
    channel_constructor_id: i64,
    i64_type_id: i64,
    slice_type_id: i64
) -> !std::string::String {
    let rendered = try code_render::render_run_ast_artifact(
        allocator,
        source_path,
        text,
        ast,
        root,
        constructor_identities,
        atomic_constructor_id,
        bool_type_id,
        channel_constructor_id,
        i64_type_id,
        slice_type_id
    );
    return rendered;
}

pub fn emit_rendered_run_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    artifact: &[]u8,
    artifact_len: i64
) -> !data::RunArtifact {
    return hosted::emit_rendered_run_artifact(allocator, io, source_path, artifact, artifact_len);
}

pub fn run_artifact_ll_path(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    return try hosted::run_artifact_ll_path(allocator, source_path);
}

pub fn run_artifact_executable_path(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    return try hosted::run_artifact_executable_path(allocator, source_path);
}

pub fn link_run_artifact(
    ll_path: &[]u8,
    executable_path: &[]u8
) -> !i64 {
    return try hosted::link_run_artifact(ll_path, executable_path);
}

pub fn execute_run_artifact(executable_path: &[]u8) -> !i64 {
    return try hosted::execute_run_artifact(executable_path);
}

pub fn emit_test_executable_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    executable: data::Executable
) -> !data::TestArtifact {
    return hosted::emit_test_executable_artifact(allocator, io, source_path, executable);
}

pub fn test_artifact_ll_path(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    return try hosted::test_artifact_ll_path(allocator, source_path);
}

pub fn test_artifact_executable_path(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    return try hosted::test_artifact_executable_path(allocator, source_path);
}

pub fn lower_test_executable(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::Executable {
    return try executable::lower_test_executable(text, ast, root);
}

pub fn test_executable_supported(executable: &data::Executable) -> bool {
    if executable.kind != data::ExecutableKind::Call {
        return false;
    }
    if !std::mem::equal_bytes(executable.callee, "std::testing::expect") {
        return false;
    }
    return std::mem::equal_bytes(executable.payload, "true") or
        std::mem::equal_bytes(executable.payload, "false");
}
