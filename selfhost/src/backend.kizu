fn validate_ir_artifact(bytes: []const u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-v0") {
        return error("invalid IR artifact");
    }
    if !bytes_contains(bytes, "package selfhost") {
        return error("unsupported IR artifact package");
    }
    return;
}

fn validate_shape_manifest(bytes: []const u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-shape-v0") {
        return error("invalid IR shape manifest");
    }
    try require_shape(bytes, "manifest-version selfhost-abi-v0");
    try require_shape(bytes, "node-kind function");
    try require_shape(bytes, "node-kind block");
    try require_shape(bytes, "node-kind diagnostic");
    try require_shape(bytes, "value-type i64");
    try require_shape(bytes, "value-type bool");
    try require_shape(bytes, "value-type []const u8");
    try require_shape(bytes, "value-type record");
    try require_shape(bytes, "value-type error-union");
    try require_shape(bytes, "value-type handle");
    try require_shape(bytes, "storage local");
    try require_shape(bytes, "storage owned-container");
    try require_shape(bytes, "storage borrowed-view");
    try require_shape(bytes, "storage arena");
    try require_shape(bytes, "storage handle");
    try require_shape(bytes, "call direct");
    try require_shape(bytes, "call direct-record-roundtrip");
    try require_shape(bytes, "call std-primitive");
    try require_shape(bytes, "cleanup deinit");
    try require_shape(bytes, "host-capabilities selfhost-host-v0");
    try require_shape(bytes, "external std::mem::page_allocator");
    try require_shape(bytes, "external std::fs::exists");
    try require_shape(bytes, "external std::fs::metadata");
    try require_shape(bytes, "external std::fs::read_dir");
    try require_shape(bytes, "external std::fs::read_file");
    try require_shape(bytes, "external std::fs::write_file");
    try require_shape(bytes, "external std::fs::create_dir");
    try require_shape(bytes, "external std::io::blocking");
    try require_shape(bytes, "external std::io::write_stdout");
    try require_shape(bytes, "external std::io::write_stderr");
    try require_shape(bytes, "external std::process::arg_count");
    try require_shape(bytes, "external std::process::arg");
    try require_shape(bytes, "external std::process::env");
    try require_shape(bytes, "external std::process::exit_code");
    try require_shape(bytes, "manifest-complete selfhost-abi-v0");
    return;
}

fn require_shape(bytes: []const u8, shape: []const u8) -> !void {
    if !bytes_contains(bytes, shape) {
        return error("unsupported IR shape manifest");
    }
    return;
}

fn write_backend_bytes(
    io: Io,
    path: &[]const u8,
    bytes: &[]const u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_llvm_module(
    allocator: Allocator,
    ir_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "; kizu selfhost bootstrap ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(ir_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.handle = type { ptr, i64 }");
    try append_line(out, "%kizu.fs.metadata = type { i64, i1 }");
    try append_line(out, "%kizu.error.bool = type { i1, i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.i64 = type { i1, i64, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.owned = type { i1, %kizu.owned, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.error.metadata = type { i1, %kizu.fs.metadata, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "");
    try append_cli_globals(out);
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "declare %kizu.error.bool @kizu_rt_fs_exists(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.metadata @kizu_rt_fs_metadata(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.owned @kizu_rt_fs_read_dir(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_rename(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_arg_count()");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_arg(i64)");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_env(%kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "declare void @kizu_rt_process_exit(i64) noreturn");
    try append_line(out, "declare void @kizu_rt_owned_deinit(%kizu.owned)");
    try append_line(out, "declare void @kizu_rt_trap(%kizu.slice.u8) noreturn");
    try append_line(out, "declare i64 @kizu_selfhost__runtime_storage_smoke()");
    try append_line(out, "declare i64 @kizu_selfhost__host_capability_smoke()");
    try append_line(out, "");
    try append_cli_functions(out);
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_selfhost__smoke() {");
    try append_line(out, "entry:");
    try append_line(out, "  ret i64 0");
    try append_line(out, "}");
    return out;
}

fn render_llvm_metadata(
    allocator: Allocator,
    ir_path: []const u8,
    manifest_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-llvm-artifact-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    try append_line(out, "output target/selfhost/selfhost.ll");
    try append_line(out, "runtime-storage target/selfhost/selfhost.storage.ll");
    try append_line(out, "host-runtime target/selfhost/selfhost.host.ll");
    try append_line(out, "host-runtime-metadata target/selfhost/selfhost.host.ll.meta");
    try append_line(out, "storage-backend selfhost-runtime-ll");
    try append_line(out, "host-capabilities selfhost-host-v0");
    try append_line(out, "abi-record summary-i64-slice");
    try append_line(out, "abi-error-union summary-success-failure");
    try append_line(out, "abi-call direct-record-roundtrip");
    try append_line(out, "go-stdprim-storage none");
    try append_line(out, "go-stdprim-host none");
    try append_line(out, "linker-process deferred issue-459");
    try append_line(out, "entry @kizu_selfhost__cli_main");
    try append_line(out, "cli-command check selfhost");
    try append_line(out, "cli-command stage selfhost");
    try append_line(out, "cli-command check file source");
    try append_line(out, "cli-command parse file source");
    try append_line(out, "cli-command run file source print-call");
    try append_line(out, "cli-command test file source expect-call");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/parse-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/check-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/run-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/test-parity.tsv");
    try append_line(out, "cli-hosted-smoke no-go");
    try append_line(out, "validation go test ./cmd/kizu -run TestSelfhostBackendArtifactGate");
    try append_line(out, "external @kizu_rt_mem_page_allocator");
    try append_line(out, "external @kizu_rt_io_blocking");
    try append_line(out, "external @kizu_rt_fs_exists");
    try append_line(out, "external @kizu_rt_fs_metadata");
    try append_line(out, "external @kizu_rt_fs_read_dir");
    try append_line(out, "external @kizu_rt_fs_read_file");
    try append_line(out, "external @kizu_rt_fs_write_file");
    try append_line(out, "external @kizu_rt_fs_create_dir");
    try append_line(out, "external @kizu_rt_fs_rename");
    try append_line(out, "external @kizu_rt_io_write_stdout");
    try append_line(out, "external @kizu_rt_io_write_stderr");
    try append_line(out, "external @kizu_rt_process_arg_count");
    try append_line(out, "external @kizu_rt_process_arg");
    try append_line(out, "external @kizu_rt_process_env");
    try append_line(out, "external @kizu_rt_process_exit_code");
    try append_line(out, "external @kizu_rt_process_exit");
    try append_line(out, "external @kizu_rt_owned_deinit");
    try append_line(out, "external @kizu_rt_trap");
    try append_line(out, "unsupported-policy blocker");
    try append_line(out, "deferred tagged-union-payload issue-495");
    return out;
}

fn render_run_hello_llvm(
    allocator: Allocator,
    source_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "; kizu run artifact ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "");
    try out.append_bytes("@.kizu.run.stdout = private unnamed_addr constant [12 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("hello, kizu\0A");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_run_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %ptr = getelementptr inbounds [12 x i8], ptr @.kizu.run.stdout, i64 0, i64 0");
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %base, i64 12, 1");
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %slice)");
    try append_line(out, "  %code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return out;
}

fn render_run_hello_metadata(
    allocator: Allocator,
    source_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-run-artifact-v0");
    try append_line(out, "issue #569");
    try append_key_value(out, "source ", source_path);
    try append_line(out, "output target/selfhost/run/run_hello.ll");
    try append_line(out, "abi selfhost-abi-v0");
    try append_line(out, "entry @kizu_run_main");
    try append_line(out, "runtime target/selfhost/stage2/selfhost.host.ll");
    try append_line(out, "go.cmd-kizu-fallback none");
    try append_line(out, "artifact_mode hosted-artifact");
    return out;
}

fn render_test_expect_ok_llvm(
    allocator: Allocator,
    source_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_test_artifact_header(out, source_path);
    try out.append_bytes("@.kizu.test.ok = private unnamed_addr constant [9 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("test: ok\0A");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_test_artifact_body(out, "ok", "9", "stdout", "0");
    return out;
}

fn render_test_expect_failure_llvm(
    allocator: Allocator,
    source_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_test_artifact_header(out, source_path);
    try out.append_bytes("@.kizu.test.failure = private unnamed_addr constant [52 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("error: runtime error: expected condition to be true\0A");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_test_artifact_body(out, "failure", "52", "stderr", "1");
    return out;
}

fn append_test_artifact_header(
    out: &mut std::string::String,
    source: []const u8
) -> !void {
    try append_line(out, "; kizu test artifact ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "");
    return;
}

fn append_test_artifact_body(
    out: &mut std::string::String,
    global: []const u8,
    size: []const u8,
    stream: []const u8,
    code: []const u8
) -> !void {
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("declare %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(stream);
    try out.append_bytes("(%kizu.owned, %kizu.slice.u8)");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_test_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("  %ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.test.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try out.append_bytes("  %slice = insertvalue %kizu.slice.u8 %base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %write = call %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(stream);
    try out.append_bytes("(%kizu.owned %io, %kizu.slice.u8 %slice)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %code = call i64 @kizu_rt_process_exit_code(i64 ");
    try out.append_bytes(code);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return;
}

fn render_test_expect_ok_metadata(
    allocator: Allocator,
    source_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_test_metadata(
        out,
        source_path,
        "target/selfhost/test/test_expect_ok.ll"
    );
    return out;
}

fn render_test_expect_failure_metadata(
