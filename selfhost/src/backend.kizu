import selfhost::ir;
import selfhost::ir::codegen;
import selfhost::backend::data;
import selfhost::backend::executable;
import selfhost::backend::hosted;
import selfhost::backend::llvm;

pub fn summarize(program_ir: ir::IrSummary) -> data::BackendSummary {
    return data::BackendSummary {
        artifacts: program_ir.blocks
    };
}

pub fn consume_ir_artifact(io: Io, path: &[]u8) -> !data::BackendSummary {
    return llvm::consume_ir_artifact(io, path);
}

pub fn emit_llvm_artifact(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !data::LlvmArtifact {
    return llvm::emit_llvm_artifact(allocator, io, ir_path, manifest_path);
}

pub fn lower_run_codegen_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    scratch: &var std::string::String
) -> !codegen::Program {
    return try codegen::lower_run_program(text, ast, root, scratch);
}

pub fn run_codegen_supported(program: &codegen::Program) -> bool {
    return codegen::lowered_program_supported(program);
}

pub fn emit_run_codegen_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    program: codegen::Program
) -> !data::RunArtifact {
    return hosted::emit_run_codegen_artifact(allocator, io, source_path, program);
}

pub fn run_artifact_ll_path(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    return try hosted::run_artifact_ll_path(allocator, source_path);
}

pub fn run_artifact_executable_path(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    return try hosted::run_artifact_executable_path(allocator, source_path);
}

pub fn link_run_artifact(
    ll_path: &[]u8,
    executable_path: &[]u8
) -> !i64 {
    return try hosted::link_run_artifact(ll_path, executable_path);
}

pub fn execute_run_artifact(executable_path: &[]u8) -> !i64 {
    return try hosted::execute_run_artifact(executable_path);
}

pub fn emit_test_executable_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    executable: data::Executable
) -> !data::TestArtifact {
    return hosted::emit_test_executable_artifact(allocator, io, source_path, executable);
}

pub fn lower_test_executable(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::Executable {
    return try executable::lower_test_executable(text, ast, root);
}

pub fn test_executable_supported(executable: &data::Executable) -> bool {
    if executable.kind != data::ExecutableKind::Call {
        return false;
    }
    if !std::mem::equal_bytes(executable.callee, "std::testing::expect") {
        return false;
    }
    return std::mem::equal_bytes(executable.payload, "true") or
        std::mem::equal_bytes(executable.payload, "false");
}
