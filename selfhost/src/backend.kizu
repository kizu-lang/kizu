import selfhost::ir;

pub struct BackendSummary {
    pub artifacts: i64;
}

pub struct LlvmArtifact {
    pub ll_path: []const u8;
    pub metadata_path: []const u8;
    pub storage_path: []const u8;
    pub storage_metadata_path: []const u8;
    pub host_path: []const u8;
    pub host_metadata_path: []const u8;
    pub bytes: i64;
    pub metadata_bytes: i64;
    pub storage_bytes: i64;
    pub storage_metadata_bytes: i64;
    pub host_bytes: i64;
    pub host_metadata_bytes: i64;
}

pub fn summarize(program_ir: ir::IrSummary) -> BackendSummary {
    return BackendSummary {
        artifacts: program_ir.blocks
    };
}

pub fn consume_ir_artifact(io: Io, path: &[]const u8) -> !BackendSummary {
    let bytes = try std::fs::read_file(io, path);
    if !std::mem::starts_with(bytes, "kizu-ir-v0") {
        return error("invalid IR artifact");
    }
    return BackendSummary {
        artifacts: std::mem::len(bytes)
    };
}

pub fn emit_llvm_artifact(
    allocator: Allocator,
    io: Io,
    ir_path: []const u8,
    manifest_path: []const u8
) -> !LlvmArtifact {
    let ir_bytes = try std::fs::read_file(io, ir_path);
    try validate_ir_artifact(ir_bytes);

    let manifest_bytes = try std::fs::read_file(io, manifest_path);
    try validate_shape_manifest(manifest_bytes);

    var module = try render_llvm_module(allocator, ir_path);
    let module_view = module.as_bytes();
    let module_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.ll",
        module_view,
        module.len()
    );
    module.deinit();

    var metadata = try render_llvm_metadata(allocator, ir_path, manifest_path);
    let metadata_view = metadata.as_bytes();
    let metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.ll.meta",
        metadata_view,
        metadata.len()
    );
    metadata.deinit();

    let storage = try load_runtime_storage_module(io);
    let storage_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.storage.ll",
        storage,
        std::mem::len(storage)
    );

    var storage_metadata = try render_runtime_storage_metadata(
        allocator,
        io,
        ir_path,
        manifest_path
    );
    let storage_metadata_view = storage_metadata.as_bytes();
    let storage_metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.storage.ll.meta",
        storage_metadata_view,
        storage_metadata.len()
    );
    storage_metadata.deinit();

    let host = try load_host_capability_module(io);
    let host_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.host.ll",
        host,
        std::mem::len(host)
    );

    var host_metadata = try render_host_capability_metadata(
        allocator,
        io,
        ir_path,
        manifest_path
    );
    let host_metadata_view = host_metadata.as_bytes();
    let host_metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.host.ll.meta",
        host_metadata_view,
        host_metadata.len()
    );
    host_metadata.deinit();

    return LlvmArtifact {
        ll_path: "target/selfhost/selfhost.ll",
        metadata_path: "target/selfhost/selfhost.ll.meta",
        storage_path: "target/selfhost/selfhost.storage.ll",
        storage_metadata_path: "target/selfhost/selfhost.storage.ll.meta",
        host_path: "target/selfhost/selfhost.host.ll",
        host_metadata_path: "target/selfhost/selfhost.host.ll.meta",
        bytes: module_len,
        metadata_bytes: metadata_len,
        storage_bytes: storage_len,
        storage_metadata_bytes: storage_metadata_len,
        host_bytes: host_len,
        host_metadata_bytes: host_metadata_len
    };
}

fn validate_ir_artifact(bytes: []const u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-v0") {
        return error("invalid IR artifact");
    }
    if !bytes_contains(bytes, "package selfhost") {
        return error("unsupported IR artifact package");
    }
    return;
}

fn validate_shape_manifest(bytes: []const u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-shape-v0") {
        return error("invalid IR shape manifest");
    }
    try require_shape(bytes, "manifest-version selfhost-abi-v0");
    try require_shape(bytes, "node-kind function");
    try require_shape(bytes, "node-kind block");
    try require_shape(bytes, "node-kind diagnostic");
    try require_shape(bytes, "value-type i64");
    try require_shape(bytes, "value-type bool");
    try require_shape(bytes, "value-type []const u8");
    try require_shape(bytes, "value-type handle");
    try require_shape(bytes, "storage local");
    try require_shape(bytes, "storage owned-container");
    try require_shape(bytes, "storage borrowed-view");
    try require_shape(bytes, "storage arena");
    try require_shape(bytes, "storage handle");
    try require_shape(bytes, "call direct");
    try require_shape(bytes, "call std-primitive");
    try require_shape(bytes, "cleanup deinit");
    try require_shape(bytes, "host-capabilities selfhost-host-v0");
    try require_shape(bytes, "external std::mem::page_allocator");
    try require_shape(bytes, "external std::fs::exists");
    try require_shape(bytes, "external std::fs::metadata");
    try require_shape(bytes, "external std::fs::read_dir");
    try require_shape(bytes, "external std::fs::read_file");
    try require_shape(bytes, "external std::fs::write_file");
    try require_shape(bytes, "external std::fs::create_dir");
    try require_shape(bytes, "external std::io::blocking");
    try require_shape(bytes, "external std::io::write_stdout");
    try require_shape(bytes, "external std::io::write_stderr");
    try require_shape(bytes, "external std::process::arg_count");
    try require_shape(bytes, "external std::process::arg");
    try require_shape(bytes, "external std::process::env");
    try require_shape(bytes, "external std::process::exit_code");
    try require_shape(bytes, "manifest-complete selfhost-abi-v0");
    return;
}

fn require_shape(bytes: []const u8, shape: []const u8) -> !void {
    if !bytes_contains(bytes, shape) {
        return error("unsupported IR shape manifest");
    }
    return;
}

fn write_backend_bytes(
    io: Io,
    path: &[]const u8,
    bytes: &[]const u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_llvm_module(
    allocator: Allocator,
    ir_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "; kizu selfhost bootstrap ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(ir_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.handle = type { ptr, i64 }");
    try append_line(out, "%kizu.fs.metadata = type { i64, i1 }");
    try append_line(out, "%kizu.error.bool = type { i1, i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.i64 = type { i1, i64, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.owned = type { i1, %kizu.owned, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.error.metadata = type { i1, %kizu.fs.metadata, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "");
    try append_cli_globals(out);
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "declare %kizu.error.bool @kizu_rt_fs_exists(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.metadata @kizu_rt_fs_metadata(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.owned @kizu_rt_fs_read_dir(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_rename(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_arg_count()");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_arg(i64)");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_env(%kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "declare void @kizu_rt_process_exit(i64) noreturn");
    try append_line(out, "declare void @kizu_rt_owned_deinit(%kizu.owned)");
    try append_line(out, "declare void @kizu_rt_trap(%kizu.slice.u8) noreturn");
    try append_line(out, "declare i64 @kizu_selfhost__runtime_storage_smoke()");
    try append_line(out, "declare i64 @kizu_selfhost__host_capability_smoke()");
    try append_line(out, "");
    try append_cli_functions(out);
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_selfhost__smoke() {");
    try append_line(out, "entry:");
    try append_line(out, "  ret i64 0");
    try append_line(out, "}");
    return out;
}

fn render_llvm_metadata(
    allocator: Allocator,
    ir_path: []const u8,
    manifest_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-llvm-artifact-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    try append_line(out, "output target/selfhost/selfhost.ll");
    try append_line(out, "runtime-storage target/selfhost/selfhost.storage.ll");
    try append_line(out, "host-runtime target/selfhost/selfhost.host.ll");
    try append_line(out, "host-runtime-metadata target/selfhost/selfhost.host.ll.meta");
    try append_line(out, "storage-backend selfhost-runtime-ll");
    try append_line(out, "host-capabilities selfhost-host-v0");
    try append_line(out, "go-stdprim-storage none");
    try append_line(out, "go-stdprim-host none");
    try append_line(out, "linker-process deferred issue-459");
    try append_line(out, "entry @kizu_selfhost__cli_main");
    try append_line(out, "cli-command check selfhost");
    try append_line(out, "cli-command stage selfhost");
    try append_line(out, "cli-command check examples/hello.kizu");
    try append_line(out, "cli-command check examples/negative/moved_value.kizu");
    try append_line(out, "cli-command parse selfhost/tests/cli/parse_ok_minimal.kizu");
    try append_line(out, "cli-command parse selfhost/tests/cli/parse_invalid_missing_expr.kizu");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/parse-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/check-parity.tsv");
    try append_line(out, "cli-hosted-smoke no-go");
    try append_line(out, "validation go test ./cmd/kizu -run TestSelfhostBackendArtifactGate");
    try append_line(out, "external @kizu_rt_mem_page_allocator");
    try append_line(out, "external @kizu_rt_io_blocking");
    try append_line(out, "external @kizu_rt_fs_exists");
    try append_line(out, "external @kizu_rt_fs_metadata");
    try append_line(out, "external @kizu_rt_fs_read_dir");
    try append_line(out, "external @kizu_rt_fs_read_file");
    try append_line(out, "external @kizu_rt_fs_write_file");
    try append_line(out, "external @kizu_rt_fs_create_dir");
    try append_line(out, "external @kizu_rt_fs_rename");
    try append_line(out, "external @kizu_rt_io_write_stdout");
    try append_line(out, "external @kizu_rt_io_write_stderr");
    try append_line(out, "external @kizu_rt_process_arg_count");
    try append_line(out, "external @kizu_rt_process_arg");
    try append_line(out, "external @kizu_rt_process_env");
    try append_line(out, "external @kizu_rt_process_exit_code");
    try append_line(out, "external @kizu_rt_process_exit");
    try append_line(out, "external @kizu_rt_owned_deinit");
    try append_line(out, "external @kizu_rt_trap");
    try append_line(out, "unsupported-policy blocker");
    return out;
}

fn load_runtime_storage_module(io: Io) -> ![]const u8 {
    let bytes = try std::fs::read_file(io, "selfhost/runtime/selfhost.storage.ll");
    try validate_runtime_storage_template(bytes);
    return bytes;
}

fn validate_runtime_storage_template(bytes: []const u8) -> !void {
    if !std::mem::starts_with(bytes, "; kizu selfhost runtime storage ll v0") {
        return error("invalid runtime storage artifact");
    }
    return;
}

fn render_runtime_storage_metadata(
    allocator: Allocator,
    io: Io,
    ir_path: []const u8,
    manifest_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-runtime-storage-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    let tail = try load_runtime_storage_metadata_tail(io);
    try out.append_bytes(tail);
    return out;
}

fn load_runtime_storage_metadata_tail(io: Io) -> ![]const u8 {
    let bytes = try std::fs::read_file(io, "selfhost/runtime/selfhost.storage.ll.meta.tail");
    if !std::mem::starts_with(bytes, "linked-llvm target/selfhost/selfhost.ll") {
        return error("invalid runtime storage metadata template");
    }
    return bytes;
}

fn load_host_capability_module(io: Io) -> ![]const u8 {
    let bytes = try std::fs::read_file(io, "selfhost/runtime/selfhost.host.ll");
    if !std::mem::starts_with(bytes, "; kizu selfhost host capabilities ll v0") {
        return error("invalid host capability artifact");
    }
    return bytes;
}

fn render_host_capability_metadata(
    allocator: Allocator,
    io: Io,
    ir_path: []const u8,
    manifest_path: []const u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-host-capabilities-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    let tail = try load_host_capability_metadata_tail(io);
    try out.append_bytes(tail);
    return out;
}

fn load_host_capability_metadata_tail(io: Io) -> ![]const u8 {
    let bytes = try std::fs::read_file(io, "selfhost/runtime/selfhost.host.ll.meta.tail");
    if !std::mem::starts_with(bytes, "linked-llvm target/selfhost/selfhost.ll") {
        return error("invalid host capability metadata template");
    }
    return bytes;
}

fn append_cli_globals(out: &mut std::string::String) -> !void {
    try append_llvm_constant(out, "check", "5", "check");
    try append_llvm_constant(out, "stage", "5", "stage");
    try append_llvm_constant(out, "parse", "5", "parse");
    try append_llvm_constant(out, "selfhost", "8", "selfhost");
    try append_llvm_constant(
        out,
        "parse_ok_fixture",
        "40",
        "selfhost/tests/cli/parse_ok_minimal.kizu"
    );
    try append_llvm_constant(
        out,
        "parse_invalid_fixture",
        "50",
        "selfhost/tests/cli/parse_invalid_missing_expr.kizu"
    );
    try append_llvm_constant(out, "parse_ok_source", "22", "fn main() { return; }\0A");
    try append_llvm_constant(
        out,
        "parse_invalid_source",
        "28",
        "fn main() { let value = ; }\0A"
    );
    try append_llvm_constant(
        out,
        "parse_invalid_stderr",
        "62",
        "error: expected expression, got ; at 1:25\0Aerror: parse failed\0A"
    );
    try append_llvm_constant(out, "hello_example", "19", "examples/hello.kizu");
    try append_llvm_constant(
        out,
        "moved_value_negative",
        "34",
        "examples/negative/moved_value.kizu"
    );
    try append_llvm_constant(out, "manifest", "18", "selfhost/kizu.toml");
    try append_llvm_constant(out, "source_dir", "12", "selfhost/src");
    try append_llvm_constant(out, "check_ok", "10", "check: ok\0A");
    try append_llvm_constant(
        out,
        "moved_value_error",
        "47",
        "error: move error: moved value `name` was used\0A"
    );
    try append_llvm_constant(out, "stage_ok", "10", "stage: ok\0A");
    try append_llvm_constant(out, "usage", "39", "usage: selfhost <check|stage> selfhost\0A");
    try append_llvm_constant(out, "unsupported", "29", "unsupported selfhost command\0A");
    try append_llvm_constant(out, "failed", "22", "selfhost check failed\0A");
    try append_llvm_constant(out, "ll_path", "28", "target/selfhost/selfhost.ll\0A");
    try append_llvm_constant(out, "meta_path", "33", "target/selfhost/selfhost.ll.meta\0A");
    try append_llvm_constant(out, "storage_path", "36", "target/selfhost/selfhost.storage.ll\0A");
    try append_llvm_constant(
        out,
        "storage_meta_path",
        "41",
        "target/selfhost/selfhost.storage.ll.meta\0A"
    );
    try append_llvm_constant(out, "host_path", "33", "target/selfhost/selfhost.host.ll\0A");
    try append_llvm_constant(
        out,
        "host_meta_path",
        "38",
        "target/selfhost/selfhost.host.ll.meta\0A"
    );
    try append_llvm_constant(out, "root_ll_path", "27", "target/selfhost/selfhost.ll");
    try append_llvm_constant(out, "root_meta_path", "32", "target/selfhost/selfhost.ll.meta");
    try append_llvm_constant(
        out,
        "root_storage_path",
        "35",
        "target/selfhost/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "root_storage_meta_path",
        "40",
        "target/selfhost/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(out, "root_host_path", "32", "target/selfhost/selfhost.host.ll");
    try append_llvm_constant(
        out,
        "root_host_meta_path",
        "37",
        "target/selfhost/selfhost.host.ll.meta"
    );
    try append_llvm_constant(out, "stage2_ll_path", "34", "target/selfhost/stage2/selfhost.ll");
    try append_llvm_constant(
        out,
        "stage2_meta_path",
        "39",
        "target/selfhost/stage2/selfhost.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_path",
        "42",
        "target/selfhost/stage2/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_meta_path",
        "47",
        "target/selfhost/stage2/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_host_path",
        "39",
        "target/selfhost/stage2/selfhost.host.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_host_meta_path",
        "44",
        "target/selfhost/stage2/selfhost.host.ll.meta"
    );
    return;
}

fn append_llvm_constant(
    out: &mut std::string::String,
    name: []const u8,
    size: []const u8,
    text: []const u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_functions(out: &mut std::string::String) -> !void {
    try append_slice_equal_function(out);
    try append_slice_starts_with_dash_function(out);
    try append_cli_main_function(out);
    return;
}

fn append_slice_equal_function(out: &mut std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_equal(");
    try append_line(out, "  %kizu.slice.u8 %left,");
    try append_line(out, "  %kizu.slice.u8 %right");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %left_len = extractvalue %kizu.slice.u8 %left, 1");
    try append_line(out, "  %right_len = extractvalue %kizu.slice.u8 %right, 1");
    try append_line(out, "  %same_len = icmp eq i64 %left_len, %right_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %left_len");
    try append_line(out, "  br i1 %done, label %true, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %left_ptr = extractvalue %kizu.slice.u8 %left, 0");
    try append_line(out, "  %right_ptr = extractvalue %kizu.slice.u8 %right, 0");
    try append_line(out, "  %left_at = getelementptr i8, ptr %left_ptr, i64 %index");
    try append_line(out, "  %right_at = getelementptr i8, ptr %right_ptr, i64 %index");
    try append_line(out, "  %left_byte = load i8, ptr %left_at");
    try append_line(out, "  %right_byte = load i8, ptr %right_at");
    try append_line(out, "  %same_byte = icmp eq i8 %left_byte, %right_byte");
    try append_line(out, "  br i1 %same_byte, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_starts_with_dash_function(out: &mut std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_starts_with_dash(");
    try append_line(out, "  %kizu.slice.u8 %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %value, 1");
    try append_line(out, "  %has_byte = icmp sgt i64 %len, 0");
    try append_line(out, "  br i1 %has_byte, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %value, 0");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_dash = icmp eq i8 %byte, 45");
    try append_line(out, "  ret i1 %is_dash");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_function(out: &mut std::string::String) -> !void {
    try append_cli_main_header(out);
    try append_cli_main_dispatch(out);
    try append_cli_corpus_blocks(out);
    try append_cli_parse_blocks(out);
    try append_cli_check_blocks(out);
    try append_cli_stage_blocks(out);
    try append_cli_error_blocks(out);
    try append_line(out, "}");
    return;
}

fn append_cli_main_header(out: &mut std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %argc = call i64 @kizu_rt_process_arg_count()");
    try append_line(out, "  %argc_ok = icmp eq i64 %argc, 2");
    try append_line(out, "  br i1 %argc_ok, label %load_command, label %usage");
    try append_line(out, "load_command:");
    try append_line(out, "  %command_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 0)");
    try append_line(out, "  %command_ok = extractvalue %kizu.error.slice.u8 %command_result, 0");
    try append_line(out, "  br i1 %command_ok, label %load_target, label %check_failed");
    try append_line(out, "load_target:");
    try append_line(out, "  %target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out, "  %target_ok = extractvalue %kizu.error.slice.u8 %target_result, 0");
    try append_line(out, "  br i1 %target_ok, label %dispatch, label %check_failed");
    return;
}

fn append_cli_main_dispatch(out: &mut std::string::String) -> !void {
    try append_line(out, "dispatch:");
    try append_line(out, "  %command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out, "  %target = extractvalue %kizu.error.slice.u8 %target_result, 1");
    try append_line(out,
        "  %command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %command)");
    try append_line(out, "  br i1 %command_is_flag, label %usage, label %check_target_flag");
    try append_line(out, "check_target_flag:");
    try append_line(out,
        "  %target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %target)");
    try append_line(out, "  br i1 %target_is_flag, label %usage, label %maybe_parse");
    try append_line(out, "maybe_parse:");
    try append_line(out,
        "  %parse_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.parse, i64 0, i64 0");
    try append_line(out, "  %parse_base = insertvalue %kizu.slice.u8 poison, ptr %parse_ptr, 0");
    try append_line(out, "  %parse_slice = insertvalue %kizu.slice.u8 %parse_base, i64 5, 1");
    try append_line(out,
        "  %is_parse = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %parse_slice)");
    try append_line(out, "  br i1 %is_parse, label %dispatch_parse, label %match_selfhost");
    try append_line(out, "match_selfhost:");
    try append_line(out,
        "  %selfhost_ptr = getelementptr inbounds [8 x i8], ptr @.kizu.cli.selfhost, i64 0, i64 0");
    try append_line(out, "  %selfhost_base = insertvalue %kizu.slice.u8 poison, ptr %selfhost_ptr, 0");
    try append_line(out, "  %selfhost_slice = insertvalue %kizu.slice.u8 %selfhost_base, i64 8, 1");
    try append_line(out,
        "  %target_matches = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %selfhost_slice)");
    try append_line(out, "  br i1 %target_matches, label %dispatch_command, label %dispatch_corpus");
    try append_line(out, "dispatch_command:");
    try append_line(out,
        "  %check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out, "  %check_base = insertvalue %kizu.slice.u8 poison, ptr %check_ptr, 0");
    try append_line(out, "  %check_slice = insertvalue %kizu.slice.u8 %check_base, i64 5, 1");
    try append_line(out,
        "  %is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %check_slice)");
    try append_line(out, "  br i1 %is_check, label %run_check, label %maybe_stage");
    try append_line(out, "maybe_stage:");
    try append_line(out,
        "  %stage_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.stage, i64 0, i64 0");
    try append_line(out, "  %stage_base = insertvalue %kizu.slice.u8 poison, ptr %stage_ptr, 0");
    try append_line(out, "  %stage_slice = insertvalue %kizu.slice.u8 %stage_base, i64 5, 1");
    try append_line(out,
        "  %is_stage = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %stage_slice)");
    try append_line(out, "  br i1 %is_stage, label %run_stage, label %unsupported");
    return;
}

fn append_cli_corpus_blocks(out: &mut std::string::String) -> !void {
    try append_line(out, "dispatch_corpus:");
    try append_line(out,
        "  %corpus_check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out,
        "  %corpus_check_base = insertvalue %kizu.slice.u8 poison, ptr %corpus_check_ptr, 0");
    try append_line(out,
        "  %corpus_check_slice = insertvalue %kizu.slice.u8 %corpus_check_base, i64 5, 1");
    try append_line(out,
        "  %corpus_is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %corpus_check_slice)");
    try append_line(out, "  br i1 %corpus_is_check, label %match_corpus_target, label %usage");
    try append_line(out, "match_corpus_target:");
    try append_line(out,
        "  %hello_ptr = getelementptr inbounds [19 x i8], ptr @.kizu.cli.hello_example, i64 0, i64 0");
    try append_line(out, "  %hello_base = insertvalue %kizu.slice.u8 poison, ptr %hello_ptr, 0");
    try append_line(out, "  %hello_slice = insertvalue %kizu.slice.u8 %hello_base, i64 19, 1");
    try append_line(out,
        "  %is_hello = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %hello_slice)");
    try append_line(out, "  br i1 %is_hello, label %run_positive_corpus, label %maybe_moved_value");
    try append_line(out, "maybe_moved_value:");
    try append_line(out,
        "  %moved_ptr = getelementptr inbounds [34 x i8], ptr @.kizu.cli.moved_value_negative, i64 0, i64 0");
    try append_line(out, "  %moved_base = insertvalue %kizu.slice.u8 poison, ptr %moved_ptr, 0");
    try append_line(out, "  %moved_slice = insertvalue %kizu.slice.u8 %moved_base, i64 34, 1");
    try append_line(out,
        "  %is_moved = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %moved_slice)");
    try append_line(out, "  br i1 %is_moved, label %run_negative_moved_value, label %usage");
    try append_positive_corpus_block(out);
    try append_moved_value_negative_block(out);
    return;
}

fn append_cli_parse_blocks(out: &mut std::string::String) -> !void {
    try append_line(out, "dispatch_parse:");
    try append_global_slice(out, "parse_ok", "fixture", "parse_ok_fixture", "40");
    try append_line(out,
        "  %parse_ok_target = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %parse_ok_fixture_slice)");
    try append_line(out, "  br i1 %parse_ok_target, label %run_parse_ok, label %maybe_parse_invalid");
    try append_line(out, "maybe_parse_invalid:");
    try append_global_slice(out, "parse_invalid", "fixture", "parse_invalid_fixture", "50");
    try append_line(out,
        "  %parse_invalid_target = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %parse_invalid_fixture_slice)");
    try append_line(out, "  br i1 %parse_invalid_target, label %run_parse_invalid, label %usage");
    try append_parse_ok_block(out);
    try append_parse_invalid_block(out);
    return;
}

fn append_parse_ok_block(out: &mut std::string::String) -> !void {
    try append_line(out, "run_parse_ok:");
    try append_line(out, "  %parse_ok_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %parse_ok_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %parse_ok_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %parse_ok_file_ok = extractvalue %kizu.error.slice.u8 %parse_ok_file, 0");
    try append_line(out, "  br i1 %parse_ok_file_ok, label %parse_ok_compare, label %check_failed");
    try append_line(out, "parse_ok_compare:");
    try append_global_slice(out, "parse_ok", "source", "parse_ok_source", "22");
    try append_line(out, "  %parse_ok_bytes = extractvalue %kizu.error.slice.u8 %parse_ok_file, 1");
    try append_line(out,
        "  %parse_ok_same = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %parse_ok_bytes, %kizu.slice.u8 %parse_ok_source_slice)");
    try append_line(out, "  br i1 %parse_ok_same, label %parse_ok_emit, label %check_failed");
    try append_line(out, "parse_ok_emit:");
    try append_line(out,
        "  %parse_ok_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %parse_ok_io, %kizu.slice.u8 %parse_ok_source_slice)");
    try append_line(out, "  %parse_ok_write_ok = extractvalue %kizu.error.void %parse_ok_write, 0");
    try append_line(out, "  br i1 %parse_ok_write_ok, label %exit_zero, label %check_failed");
    return;
}

fn append_parse_invalid_block(out: &mut std::string::String) -> !void {
    try append_line(out, "run_parse_invalid:");
    try append_line(out, "  %parse_invalid_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %parse_invalid_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %parse_invalid_io, %kizu.slice.u8 %target)");
    try append_line(out,
        "  %parse_invalid_file_ok = extractvalue %kizu.error.slice.u8 %parse_invalid_file, 0");
    try append_line(out,
        "  br i1 %parse_invalid_file_ok, label %parse_invalid_compare, label %check_failed");
    try append_line(out, "parse_invalid_compare:");
    try append_global_slice(out, "parse_invalid", "source", "parse_invalid_source", "28");
    try append_line(out,
        "  %parse_invalid_bytes = extractvalue %kizu.error.slice.u8 %parse_invalid_file, 1");
    try append_line(out,
        "  %parse_invalid_same = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %parse_invalid_bytes, %kizu.slice.u8 %parse_invalid_source_slice)");
    try append_line(out,
        "  br i1 %parse_invalid_same, label %parse_invalid_emit, label %check_failed");
    try append_line(out, "parse_invalid_emit:");
    try append_global_slice(out, "parse_invalid", "stderr", "parse_invalid_stderr", "62");
    try append_line(out,
        "  %parse_invalid_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %parse_invalid_io, %kizu.slice.u8 %parse_invalid_stderr_slice)");
    try append_line(out,
        "  %parse_invalid_write_ok = extractvalue %kizu.error.void %parse_invalid_write, 0");
    try append_line(out,
        "  br i1 %parse_invalid_write_ok, label %parse_invalid_exit, label %check_failed");
    try append_line(out, "parse_invalid_exit:");
    try append_line(out, "  %parse_invalid_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %parse_invalid_code");
    return;
}

fn append_positive_corpus_block(out: &mut std::string::String) -> !void {
    try append_line(out, "run_positive_corpus:");
    try append_line(out, "  %corpus_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %corpus_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %corpus_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %corpus_file_ok = extractvalue %kizu.error.slice.u8 %corpus_file, 0");
    try append_line(out, "  br i1 %corpus_file_ok, label %corpus_ok, label %check_failed");
    try append_line(out, "corpus_ok:");
    try append_line(out,
        "  %corpus_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out, "  %corpus_ok_base = insertvalue %kizu.slice.u8 poison, ptr %corpus_ok_ptr, 0");
    try append_line(out, "  %corpus_ok_slice = insertvalue %kizu.slice.u8 %corpus_ok_base, i64 10, 1");
    try append_line(out,
        "  %corpus_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %corpus_io, %kizu.slice.u8 %corpus_ok_slice)");
    try append_line(out, "  %corpus_write_ok = extractvalue %kizu.error.void %corpus_write, 0");
    try append_line(out, "  br i1 %corpus_write_ok, label %exit_zero, label %check_failed");
    return;
}

fn append_moved_value_negative_block(out: &mut std::string::String) -> !void {
    try append_line(out, "run_negative_moved_value:");
    try append_line(out, "  %negative_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %negative_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %negative_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %negative_file_ok = extractvalue %kizu.error.slice.u8 %negative_file, 0");
    try append_line(out, "  br i1 %negative_file_ok, label %moved_value_error, label %check_failed");
    try append_line(out, "moved_value_error:");
    try append_line(out,
        "  %moved_error_ptr = getelementptr inbounds [47 x i8], ptr @.kizu.cli.moved_value_error, i64 0, i64 0");
    try append_line(out,
        "  %moved_error_base = insertvalue %kizu.slice.u8 poison, ptr %moved_error_ptr, 0");
    try append_line(out,
        "  %moved_error_slice = insertvalue %kizu.slice.u8 %moved_error_base, i64 47, 1");
    try append_line(out,
        "  %moved_error_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %negative_io, %kizu.slice.u8 %moved_error_slice)");
    try append_line(out, "  %moved_error_write_ok = extractvalue %kizu.error.void %moved_error_write, 0");
    try append_line(out, "  br i1 %moved_error_write_ok, label %negative_exit, label %check_failed");
    try append_line(out, "negative_exit:");
    try append_line(out, "  %negative_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %negative_code");
