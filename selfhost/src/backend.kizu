// Module: backend boundary for future Kizu compiler targets.

pub enum TargetKind {
    Llvm
    Wasm
    C
    Unsupported
}

pub struct TargetSummary {
    pub kind: TargetKind;
    pub name: []const u8;
    pub supported: bool;
}

pub struct ArtifactSummary {
    pub target: TargetSummary;
    pub function_count: i64;
    pub instruction_count: i64;
    pub emitted: bool;
}

// write_llvm_module writes the current self-host LLVM text artifact.
pub fn write_llvm_module() -> !void {
    print(llvm_module_text());
    return void;
}

// write_selfhost_llvm_module writes the current package compiler artifact.
pub fn write_selfhost_llvm_module() -> !void {
    print(selfhost_llvm_module_text());
    return void;
}

// llvm_module_text returns the current minimal LLVM module emitted by selfhost.
pub fn llvm_module_text() -> []const u8 {
    return "define void @main() { ret void }";
}

// selfhost_llvm_module_text returns the current standalone compiler module.
pub fn selfhost_llvm_module_text() -> []const u8 {
    return "define void @main() { ret void }
define void @kizu_selfhost_cli() { ret void }
define void @kizu_lexer_ready() { ret void }
define void @kizu_parser_ready() { ret void }
define void @kizu_resolver_ready() { ret void }
define void @kizu_types_ready() { ret void }
define void @kizu_ownership_ready() { ret void }
define void @kizu_ir_ready() { ret void }
define void @kizu_backend_ready() { ret void }";
}

// target classifies one backend target spelling.
pub fn target(name: []const u8) -> TargetSummary {
    if std::mem::equal_bytes(name, "llvm") {
        return target_summary(TargetKind::Llvm, name, true);
    }
    if std::mem::equal_bytes(name, "aarch64-apple-darwin") {
        return target_summary(TargetKind::Llvm, name, true);
    }
    if std::mem::equal_bytes(name, "wasm") {
        return target_summary(TargetKind::Wasm, name, true);
    }
    if std::mem::equal_bytes(name, "wasm32-wasi") {
        return target_summary(TargetKind::Wasm, name, true);
    }
    if std::mem::equal_bytes(name, "c") {
        return target_summary(TargetKind::C, name, false);
    }
    return target_summary(TargetKind::Unsupported, name, false);
}

// artifact creates the backend smoke summary used by bootstrap comparisons.
pub fn artifact(
    target_info: &TargetSummary,
    function_count: i64,
    instruction_count: i64
) -> ArtifactSummary {
    let emitted = target_info.supported;
    return ArtifactSummary {
        target: TargetSummary {
            kind: target_info.kind,
            name: target_info.name,
            supported: target_info.supported,
        },
        function_count: function_count,
        instruction_count: instruction_count,
        emitted: emitted,
    };
}

// artifact_matches compares deterministic backend smoke facts.
pub fn artifact_matches(left: &ArtifactSummary, right: &ArtifactSummary) -> bool {
    if left.target.kind != right.target.kind {
        return false;
    }
    if left.function_count != right.function_count {
        return false;
    }
    if left.instruction_count != right.instruction_count {
        return false;
    }
    return left.emitted == right.emitted;
}

// target_summary constructs one target classification.
fn target_summary(kind: TargetKind, name: []const u8, supported: bool) -> TargetSummary {
    return TargetSummary {
        kind: kind,
        name: name,
        supported: supported,
    };
}

// ready exposes the backend module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
