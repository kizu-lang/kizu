import selfhost::ir;

pub struct BackendSummary {
    pub artifacts: i64;
}

pub fn summarize(program_ir: ir::IrSummary) -> BackendSummary {
    return BackendSummary {
        artifacts: program_ir.blocks
    };
}

pub fn consume_ir_artifact(io: Io, path: &[]const u8) -> !BackendSummary {
    let bytes = try std::fs::read_file(io, path);
    if !std::mem::starts_with(bytes, "kizu-ir-v0") {
        return error("invalid IR artifact");
    }
    return BackendSummary {
        artifacts: std::mem::len(bytes)
    };
}
