import selfhost::lexer;
import selfhost::parser;

pub fn gate() -> parser::ParseError!void {
    let allocator = std::mem::page_allocator();
    let path = "selfhost/src/parser_oracle.kizu";
    let source = "import selfhost::lexer; fn main() -> void { let x = 1 + 2; return; }";
    var tokens = try cast<parser::ParseError!std::array::Array<std::kizu::lexer::Token>>(
        lexer::tokenize(allocator, source)
    );
    let token_count = tokens.len();
    let result = try parser::parse_tokens(allocator, path, source, &tokens);

    let summary = parser::summarize(result, token_count, 2);
    try cast<parser::ParseError!void>(std::testing::expect_equal_i64(23, summary.tokens));
    try cast<parser::ParseError!void>(std::testing::expect_equal_i64(2, summary.declarations));
    try cast<parser::ParseError!void>(std::testing::expect_equal_i64(0, summary.diagnostics));
    try cast<parser::ParseError!void>(std::testing::expect_equal_bool(true, summary.nodes > 0));

    try expect_diagnostic();
    tokens.deinit();

    print("parser-tokens");
    print(summary.tokens);
    print("parser-declarations");
    print(summary.declarations);
    print("parser-diagnostics");
    print(summary.diagnostics);
    print("parser-typed-diagnostics");
    print(1);
    return;
}

fn expect_diagnostic() -> parser::ParseError!void {
    let err = parser::diagnostic_error("selfhost/src/parser.kizu", 5, 9, "parse failed");
    let summary = parser::summarize_error(err);
    try cast<parser::ParseError!void>(std::testing::expect_equal_bool(true, summary.diagnostic));
    try cast<parser::ParseError!void>(std::testing::expect_equal_i64(5, summary.start));
    try cast<parser::ParseError!void>(std::testing::expect_equal_i64(9, summary.end));
    return;
}
