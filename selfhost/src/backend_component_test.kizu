// Module: component tests for self-host backend summary boundaries.

import selfhost::backend;

// backend_component_test checks target and artifact summary facts.
pub fn backend_component_test() -> !void {
    let llvm = backend::target("llvm");
    let wasm = backend::target("wasm");
    let c_target = backend::target("c");
    try std::testing::expect(llvm.kind == backend::TargetKind::Llvm);
    try std::testing::expect(llvm.supported);

    let artifact = backend::artifact(&llvm, 1, 3);
    let same_target = backend::target("llvm");
    let same = backend::artifact(&same_target, 1, 3);

    try std::testing::expect(wasm.kind == backend::TargetKind::Wasm);
    try std::testing::expect(c_target.supported == false);
    try std::testing::expect(artifact.emitted);
    try std::testing::expect_equal_i64(1, artifact.function_count);
    try std::testing::expect_equal_i64(3, artifact.instruction_count);
    try std::testing::expect(backend::artifact_matches(&artifact, &same));
    return void;
}
