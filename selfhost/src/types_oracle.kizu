pub fn constructor_resolution_regression_gate() -> !void {
    std::testing::expect(type_constructor::is_builtin_name("std::array::Array"));
    std::testing::expect(!(try type_constructor::is_builtin_application(
        "std::array::Array"
    )));
    std::testing::expect(try type_constructor::is_builtin_application(
        "std::array::Array<i64>"
    ));
    std::testing::expect(!(try type_constructor::is_builtin_application(
        "identity<i64>"
    )));

    let allocator = std::mem::page_allocator();
    let module = "types/generic_function_constructor_regression";
    let text = "fn identity<T>(value: T) -> T { return value; } fn read() -> i64 { return identity<i64>(7); }";
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(source::SourceFile {
        id: 0,
        kind: source::SourceKind::Selfhost,
        package_name: "selfhost",
        module_start: 0,
        module_end: std::mem::len(module),
        path: module,
        text: text
    });
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    std::testing::expect_equal<i64>(0, typed.diagnostics);
    print("constructor-resolution-regression-ok");
    return;
}

pub fn nested_type_spelling_regression_gate() -> !void {
    let spelling = "Outer<i64, Inner<?ptr<u8>, std::map::Map<[]u8, i64>>>";
    let outer = try type_spelling::parse(spelling);
    std::testing::expect(outer.has_arguments);
    std::testing::expect_equal<[]u8>(
        "Outer", try type_spelling::constructor(&outer, spelling)
    );
    let arguments = try type_spelling::arguments(&outer, spelling);
    let first = try type_spelling::next_argument(arguments, 0);
    std::testing::expect_equal<[]u8>("i64", first);
    let second_start = try type_spelling::next_argument_start(arguments, 0);
    let second = try type_spelling::next_argument(arguments, second_start);
    let nested = try type_spelling::parse(second);
    std::testing::expect_equal<[]u8>(
        "Inner", try type_spelling::constructor(&nested, second)
    );
    let nested_arguments = try type_spelling::arguments(&nested, second);
    let nested_second_start = try type_spelling::next_argument_start(
        nested_arguments, 0
    );
    let nested_second = try type_spelling::next_argument(
        nested_arguments, nested_second_start
    );
    let map = try type_spelling::parse(nested_second);
    std::testing::expect_equal<[]u8>(
        "std::map::Map",
        try type_spelling::constructor(&map, nested_second)
    );
    print("nested-type-spelling-regression-ok");
    return;
}

pub fn malformed_empty_type_arguments_gate() -> !void {
    let ignored = try type_spelling::parse("Foo<>");
    return;
}

pub fn malformed_trailing_type_argument_gate() -> !void {
    let ignored = try type_spelling::parse("Foo<T,>");
    return;
}

pub fn malformed_unbalanced_type_gate() -> !void {
    let ignored = try type_spelling::parse("Foo>");
    return;
}

pub fn malformed_nested_empty_type_gate() -> !void {
    let ignored = try type_spelling::parse("Foo<Bar<>>");
    return;
}

pub fn unknown_owner_field_regression_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let module = "types/unknown_owner_field_regression";
    let text = "fn read<T>(record: T) -> bool { return record.value; }";
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(source::SourceFile {
        id: 0,
        kind: source::SourceKind::Selfhost,
        package_name: "selfhost",
        module_start: 0,
        module_end: std::mem::len(module),
        path: module,
        text: text
    });
    var parsed_sources = try parser::parse_source_files(allocator, files);
    defer parsed_sources.deinit();
    let parsed_items = &parsed_sources.parsed;
    let parsed = try parsed_items.at(0);
    let value = try first_function_return_value(&parsed.ast, parsed.root);
    var locals = std::map::Map<[]u8, []u8>(allocator);
    var facts = expression_facts::init(allocator);
    defer locals.deinit();
    defer facts.deinit();
    try locals.insert("record", "T");
    let file = try files.at(0);
    let inferred = try expression_infer::infer_expression_type(
        allocator, file, parsed.ast, value, locals, facts
    );
    std::testing::expect_equal<[]u8>("unknown", inferred);
    print("unknown-owner-field-regression-ok");
    return;
}

fn first_function_return_value(
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let root_node = ast.get(root);
    match root_node.data {
        Program(program) => return first_declaration_return_value(
            ast, program.declarations
        );,
        _ => return error("expected program");,
    }
}

fn first_declaration_return_value(
    ast: &std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !std::kizu::ast::NodeId {
    let declaration = try ast.child_at(declarations, 0);
    let declaration_node = ast.get(declaration);
    match declaration_node.data {
        FnDecl(function) => return first_block_return_value(ast, function.body);,
        _ => return error("expected function declaration");,
    }
}

fn first_block_return_value(
    ast: &std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let body_node = ast.get(body);
    match body_node.data {
        Block(block) => return first_statement_return_value(
            ast, block.statements
        );,
        _ => return error("expected function block");,
    }
}

fn first_statement_return_value(
    ast: &std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !std::kizu::ast::NodeId {
    let statement = try ast.child_at(statements, 0);
    let statement_node = ast.get(statement);
    match statement_node.data {
        Return(return_node) => return return_node.value;,
        _ => return error("expected return statement");,
    }
}

