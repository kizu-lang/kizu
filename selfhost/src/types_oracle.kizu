pub fn exact_struct_field_owner_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let alpha_module = "types/exact_struct_field_owner_alpha";
    let beta_module = "types/exact_struct_field_owner_beta";
    let gamma_module = "types/exact_struct_field_owner_gamma";
    let alpha_text = "struct Record { value: bool } fn read(record: Record) -> bool { return record.value; }";
    let beta_text = "pub struct Record { pub value: i64, pub nested: std::array::Array<?Record> } fn read(record: Record) -> i64 { return record.value; } fn identity(record: Record) -> Record { return record; }";
    let gamma_text = "import selfhost::types::exact_struct_field_owner_beta; fn read(record: exact_struct_field_owner_beta::Record) -> i64 { return record.value; } fn array_read(records: std::array::Array<exact_struct_field_owner_beta::Record>) -> i64 { let record = try records.at(0); return record.value; }";
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(source::SourceFile {
        id: 0,
        kind: source::SourceKind::Selfhost,
        package_name: "selfhost",
        module_start: 0,
        module_end: std::mem::len(alpha_module),
        path: alpha_module,
        text: alpha_text
    });
    try files.append(source::SourceFile {
        id: 1,
        kind: source::SourceKind::Selfhost,
        package_name: "selfhost",
        module_start: 0,
        module_end: std::mem::len(beta_module),
        path: beta_module,
        text: beta_text
    });
    try files.append(source::SourceFile {
        id: 2,
        kind: source::SourceKind::Selfhost,
        package_name: "selfhost",
        module_start: 0,
        module_end: std::mem::len(gamma_module),
        path: gamma_module,
        text: gamma_text
    });
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    std::testing::expect_equal<i64>(0, typed.diagnostics);

    var parsed_sources = try parser::parse_source_files(allocator, files);
    try check_exact_struct_field_package_facts(allocator, files, &parsed_sources);
    try parser::deinit_parsed_source_files(parsed_sources);
    print("exact-struct-field-owner-ok");
    return;
}

fn check_exact_struct_field_package_facts(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed_sources: &parser::ParsedSourceFiles
) -> !void {
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var expression_types = expression_facts::init(allocator);
    defer function_arities.deinit();
    defer expression_types.deinit();
    let parsed_results = &parsed_sources.parsed;
    let source_indexes = &parsed_sources.source_indexes;
    var index = 0;
    while index < parsed_results.len() {
        let parsed = try parsed_results.at(index);
        let source_index = try source_indexes.get(index);
        let parsed_file = try files.at(source_index);
        try types::collect_nominal_resolution_facts_from_ast(
            allocator,
            parsed_file,
            parsed.ast,
            parsed.root,
            expression_types
        );
        index = index + 1;
    }
    index = 0;
    while index < parsed_results.len() {
        let parsed = try parsed_results.at(index);
        let source_index = try source_indexes.get(index);
        let parsed_file = try files.at(source_index);
        try function_calls::collect_function_signatures_from_ast(
            allocator,
            parsed_file,
            &parsed.ast,
            parsed.root,
            function_arities,
            expression_types
        );
        try types::collect_struct_field_resolution_facts_from_ast(
            allocator,
            parsed_file,
            parsed.ast,
            parsed.root,
            expression_types
        );
        index = index + 1;
    }
    let beta_file = try files.at(1);
    var nested_key = std::string::String(allocator);
    defer nested_key.deinit();
    try expression_infer::append_struct_field_key(
        nested_key,
        allocator,
        beta_file,
        "Record",
        "nested",
        expression_types
    );
    let nested_key_bytes = nested_key.as_bytes();
    std::testing::expect(expression_types.contains_field(&nested_key_bytes));
    let nested_type = try expression_types.get_field(&nested_key_bytes);
    std::testing::expect_equal<[]u8>(
        "std::array::Array<?selfhost::types::exact_struct_field_owner_beta::Record>",
        nested_type
    );
    let identity_type = try expression_types.get_source(
        "selfhost::types::exact_struct_field_owner_beta::identity"
    );
    std::testing::expect_equal<[]u8>(
        "selfhost::types::exact_struct_field_owner_beta::Record",
        identity_type
    );
    let gamma_parsed = try parsed_results.at(2);
    let gamma_file = try files.at(2);
    var report = try types::first_post_move_check_diagnostic_ast_node_with_facts(
        allocator,
        gamma_file,
        gamma_parsed.ast,
        gamma_parsed.root,
        expression_types
    );
    std::testing::expect_equal<bool>(false, report.found);
    report.deinit();
    return;
}

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var kinds = std::map::Map<[]u8, model::TypeKind>(allocator);
    var arities = std::map::Map<[]u8, i64>(allocator);
    var copyable = std::map::Map<[]u8, bool>(allocator);
    var files = try loader::load_selfhost_sources(allocator, io, "selfhost");

    try symbols::declare_type(kinds, arities, copyable, "void", model::TypeKind::Primitive, 0, true);
    try symbols::declare_type(kinds, arities, copyable, "i64", model::TypeKind::Primitive, 0, true);
    try symbols::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::lexer::summarize",
        model::TypeKind::Function,
        1,
        true
    );
    try symbols::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::token::TokenKind",
        model::TypeKind::Enum,
        0,
        true
    );
    try symbols::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::token::Token",
        model::TypeKind::Struct,
        0,
        true
    );
    try symbols::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::parser::ParseError",
        model::TypeKind::Union,
        0,
        false
    );
    try symbols::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::parser::ParseError!i64",
        model::TypeKind::ErrorUnion,
        2,
        false
    );
    try symbols::declare_type(
        kinds,
        arities,
        copyable,
        "?selfhost::ast::NodeId",
        model::TypeKind::Optional,
        1,
        true
    );
    try symbols::declare_type(
        kinds,
        arities,
        copyable,
        "std::map::Map<[]u8, selfhost::types::model::TypeKind>",
        model::TypeKind::Container,
        2,
        false
    );

    try expect_types(kinds, arities, copyable);
    try expect_diagnostics(allocator);

    let summary = symbols::summarize(kinds, 19);
    let resolved = try resolver::resolve_sources(allocator, files);
    let production = try types::check_sources(allocator, files, resolved);
    std::testing::expect_equal<i64>(1, summary.modules);
    std::testing::expect_equal<i64>(9, summary.symbols);
    std::testing::expect_equal<i64>(0, summary.functions);
    std::testing::expect_equal<i64>(9, summary.typed_nodes);
    std::testing::expect_equal<i64>(19, summary.diagnostics);
    std::testing::expect(production.modules > 0);
    std::testing::expect(production.symbols > 0);
    std::testing::expect(production.functions > 0);
    std::testing::expect(production.typed_nodes > 0);
    std::testing::expect_equal<i64>(0, production.diagnostics);

    files.deinit();
    kinds.deinit();
    arities.deinit();
    copyable.deinit();

    print("type-modules");
    print(production.modules);
    print("type-production-symbols");
    print(production.symbols);
    print("type-production-functions");
    print(production.functions);
    print("type-production-typed-nodes");
    print(production.typed_nodes);
    print("type-production-diagnostics");
    print(production.diagnostics);
    print("type-symbols");
    print(summary.symbols);
    print("type-typed-nodes");
    print(summary.typed_nodes);
    print("type-diagnostics");
    print(summary.diagnostics);
    return;
}

fn expect_types(
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    copyable: &std::map::Map<[]u8, bool>
) -> !void {
    let primitive = try symbols::lookup_kind(kinds, "i64");
    std::testing::expect(primitive == model::TypeKind::Primitive);
    let function = try symbols::lookup_kind(kinds, "selfhost::lexer::summarize");
    std::testing::expect(function == model::TypeKind::Function);
    let token = try symbols::lookup_kind(kinds, "selfhost::token::Token");
    std::testing::expect(token == model::TypeKind::Struct);
    let parse_error = try symbols::lookup_kind(kinds, "selfhost::parser::ParseError");
    std::testing::expect(parse_error == model::TypeKind::Union);
    let error_union = try symbols::lookup_kind(kinds, "selfhost::parser::ParseError!i64");
    std::testing::expect(error_union == model::TypeKind::ErrorUnion);
    let container = try symbols::lookup_kind(kinds, "std::map::Map<[]u8, selfhost::types::model::TypeKind>");
    std::testing::expect(container == model::TypeKind::Container);

    let map_arity = try symbols::arity_of(
        arities,
        "std::map::Map<[]u8, selfhost::types::model::TypeKind>"
    );
    std::testing::expect_equal<i64>(2, map_arity);
    let token_copy = try symbols::is_copyable(copyable, "selfhost::token::Token");
    std::testing::expect(token_copy);
    let error_copy = try symbols::is_copyable(copyable, "selfhost::parser::ParseError");
    std::testing::expect(!error_copy);
    return;
}

fn expect_diagnostics(allocator: Allocator) -> !void {
    var unknown = diagnostic::unknown_type(allocator, "selfhost/src/types.kizu", 5, 10);
    try expect_diagnostic(unknown, "unknown type", 5, 10);

    var arity = diagnostic::wrong_arity(allocator, "selfhost/src/types.kizu", 12, 18);
    try expect_diagnostic(arity, "wrong type arity", 12, 18);

    var mismatch = diagnostic::type_mismatch(allocator, "selfhost/src/types.kizu", 20, 29);
    try expect_diagnostic(mismatch, "type mismatch", 20, 29);

    var unsupported = diagnostic::unsupported_feature(allocator, "selfhost/src/types.kizu", 31, 43);
    try expect_diagnostic(unsupported, "unsupported type feature", 31, 43);

    var local = diagnostic::unknown_local(allocator, "selfhost/src/types.kizu", 44, 50);
    try expect_diagnostic(local, "unknown local", 44, 50);

    var duplicate = diagnostic::duplicate_local(allocator, "selfhost/src/types.kizu", 51, 56);
    try expect_diagnostic(duplicate, "duplicate local", 51, 56);

    var target = diagnostic::invalid_assignment_target(allocator, "selfhost/src/types.kizu", 57, 64);
    try expect_diagnostic(target, "invalid assignment target", 57, 64);

    var return_mismatch = diagnostic::return_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        65,
        72
    );
    try expect_diagnostic(return_mismatch, "return type mismatch", 65, 72);

    var argument_mismatch = diagnostic::argument_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        73,
        81
    );
    try expect_diagnostic(argument_mismatch, "argument type mismatch", 73, 81);

    var field_mismatch = diagnostic::field_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        82,
        91
    );
    try expect_diagnostic(field_mismatch, "field type mismatch", 82, 91);

    var struct_mismatch = diagnostic::struct_literal_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        92,
        106
    );
    try expect_diagnostic(struct_mismatch, "struct literal type mismatch", 92, 106);

    var cast_mismatch = diagnostic::cast_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        107,
        111
    );
    try expect_diagnostic(cast_mismatch, "cast type mismatch", 107, 111);

    var generic_mismatch = diagnostic::generic_constructor_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        112,
        130
    );
    try expect_diagnostic(
        generic_mismatch,
        "generic constructor type mismatch",
        112,
        130
    );

    var match_mismatch = diagnostic::match_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        131,
        140
    );
    try expect_diagnostic(match_mismatch, "match type mismatch", 131, 140);

    var enum_mismatch = diagnostic::enum_variant_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        141,
        153
    );
    try expect_diagnostic(enum_mismatch, "enum variant mismatch", 141, 153);

    var union_mismatch = diagnostic::union_payload_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        154,
        167
    );
    try expect_diagnostic(union_mismatch, "union payload mismatch", 154, 167);

    var optional_mismatch = diagnostic::optional_match_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        168,
        182
    );
    try expect_diagnostic(optional_mismatch, "optional match mismatch", 168, 182);

    var error_mismatch = diagnostic::error_union_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        183,
        196
    );
    try expect_diagnostic(error_mismatch, "error union mismatch", 183, 196);

    var exhaustiveness = diagnostic::non_exhaustive_match(
        allocator,
        "selfhost/src/types.kizu",
        197,
        213
    );
    try expect_diagnostic(exhaustiveness, "non-exhaustive match", 197, 213);
    return;
}

fn expect_diagnostic(
    diagnostic: std::kizu::diagnostic::Diagnostic,
    message: []u8,
    byte_start: i64,
    byte_end: i64
) -> !void {
    std::testing::expect_equal<[]u8>(message, diagnostic.message);
    std::testing::expect_equal<i64>(byte_start, diagnostic.primary.byte_start);
    std::testing::expect_equal<i64>(byte_end, diagnostic.primary.byte_end);
    diagnostic.deinit();
    return;
}
