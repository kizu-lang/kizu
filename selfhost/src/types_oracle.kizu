import selfhost::resolver;
import selfhost::source;
import selfhost::types;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var kinds = std::map::Map<[]const u8, types::TypeKind>(allocator);
    var arities = std::map::Map<[]const u8, i64>(allocator);
    var copyable = std::map::Map<[]const u8, bool>(allocator);
    var files = try source::load_selfhost_sources(allocator, io, "selfhost");

    try types::declare_type(kinds, arities, copyable, "void", types::TypeKind::Primitive, 0, true);
    try types::declare_type(kinds, arities, copyable, "i64", types::TypeKind::Primitive, 0, true);
    try types::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::lexer::summarize",
        types::TypeKind::Function,
        1,
        true
    );
    try types::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::token::TokenKind",
        types::TypeKind::Enum,
        0,
        true
    );
    try types::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::token::Token",
        types::TypeKind::Struct,
        0,
        true
    );
    try types::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::parser::ParseError",
        types::TypeKind::Union,
        0,
        false
    );
    try types::declare_type(
        kinds,
        arities,
        copyable,
        "selfhost::parser::ParseError!i64",
        types::TypeKind::ErrorUnion,
        2,
        false
    );
    try types::declare_type(
        kinds,
        arities,
        copyable,
        "?selfhost::ast::NodeId",
        types::TypeKind::Optional,
        1,
        true
    );
    try types::declare_type(
        kinds,
        arities,
        copyable,
        "std::map::Map<[]const u8, selfhost::types::TypeKind>",
        types::TypeKind::Container,
        2,
        false
    );

    try expect_types(kinds, arities, copyable);
    try expect_diagnostics(allocator);

    let summary = types::summarize(kinds, 19);
    let resolved = try resolver::resolve_sources(allocator, files);
    let production = try types::check_sources(allocator, files, resolved);
    try std::testing::expect_equal_i64(1, summary.modules);
    try std::testing::expect_equal_i64(9, summary.symbols);
    try std::testing::expect_equal_i64(0, summary.functions);
    try std::testing::expect_equal_i64(9, summary.typed_nodes);
    try std::testing::expect_equal_i64(19, summary.diagnostics);
    try std::testing::expect_equal_i64(31, production.modules);
    try std::testing::expect_equal_i64(98, production.symbols);
    try std::testing::expect_equal_i64(556, production.functions);
    try std::testing::expect_equal_i64(40369, production.typed_nodes);
    try std::testing::expect_equal_i64(0, production.diagnostics);

    files.deinit();
    kinds.deinit();
    arities.deinit();
    copyable.deinit();

    print("type-modules");
    print(production.modules);
    print("type-production-symbols");
    print(production.symbols);
    print("type-production-functions");
    print(production.functions);
    print("type-production-typed-nodes");
    print(production.typed_nodes);
    print("type-symbols");
    print(summary.symbols);
    print("type-typed-nodes");
    print(summary.typed_nodes);
    print("type-diagnostics");
    print(summary.diagnostics);
    return;
}

fn expect_types(
    kinds: &std::map::Map<[]const u8, types::TypeKind>,
    arities: &std::map::Map<[]const u8, i64>,
    copyable: &std::map::Map<[]const u8, bool>
) -> !void {
    let primitive = try types::lookup_kind(kinds, "i64");
    try std::testing::expect_equal_bool(true, primitive == types::TypeKind::Primitive);
    let function = try types::lookup_kind(kinds, "selfhost::lexer::summarize");
    try std::testing::expect_equal_bool(true, function == types::TypeKind::Function);
    let token = try types::lookup_kind(kinds, "selfhost::token::Token");
    try std::testing::expect_equal_bool(true, token == types::TypeKind::Struct);
    let parse_error = try types::lookup_kind(kinds, "selfhost::parser::ParseError");
    try std::testing::expect_equal_bool(true, parse_error == types::TypeKind::Union);
    let error_union = try types::lookup_kind(kinds, "selfhost::parser::ParseError!i64");
    try std::testing::expect_equal_bool(true, error_union == types::TypeKind::ErrorUnion);
    let container = try types::lookup_kind(kinds, "std::map::Map<[]const u8, selfhost::types::TypeKind>");
    try std::testing::expect_equal_bool(true, container == types::TypeKind::Container);

    let map_arity = try types::arity_of(
        arities,
        "std::map::Map<[]const u8, selfhost::types::TypeKind>"
    );
    try std::testing::expect_equal_i64(2, map_arity);
    let token_copy = try types::is_copyable(copyable, "selfhost::token::Token");
    try std::testing::expect_equal_bool(true, token_copy);
    let error_copy = try types::is_copyable(copyable, "selfhost::parser::ParseError");
    try std::testing::expect_equal_bool(false, error_copy);
    return;
}

fn expect_diagnostics(allocator: Allocator) -> !void {
    var unknown = types::unknown_type(allocator, "selfhost/src/types.kizu", 5, 10);
    try expect_diagnostic(unknown, "unknown type", 5, 10);

    var arity = types::wrong_arity(allocator, "selfhost/src/types.kizu", 12, 18);
    try expect_diagnostic(arity, "wrong type arity", 12, 18);

    var mismatch = types::type_mismatch(allocator, "selfhost/src/types.kizu", 20, 29);
    try expect_diagnostic(mismatch, "type mismatch", 20, 29);

    var unsupported = types::unsupported_feature(allocator, "selfhost/src/types.kizu", 31, 43);
    try expect_diagnostic(unsupported, "unsupported type feature", 31, 43);

    var local = types::unknown_local(allocator, "selfhost/src/types.kizu", 44, 50);
    try expect_diagnostic(local, "unknown local", 44, 50);

    var duplicate = types::duplicate_local(allocator, "selfhost/src/types.kizu", 51, 56);
    try expect_diagnostic(duplicate, "duplicate local", 51, 56);

    var target = types::invalid_assignment_target(allocator, "selfhost/src/types.kizu", 57, 64);
    try expect_diagnostic(target, "invalid assignment target", 57, 64);

    var return_mismatch = types::return_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        65,
        72
    );
    try expect_diagnostic(return_mismatch, "return type mismatch", 65, 72);

    var argument_mismatch = types::argument_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        73,
        81
    );
    try expect_diagnostic(argument_mismatch, "argument type mismatch", 73, 81);

    var field_mismatch = types::field_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        82,
        91
    );
    try expect_diagnostic(field_mismatch, "field type mismatch", 82, 91);

    var struct_mismatch = types::struct_literal_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        92,
        106
    );
    try expect_diagnostic(struct_mismatch, "struct literal type mismatch", 92, 106);

    var cast_mismatch = types::cast_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        107,
        111
    );
    try expect_diagnostic(cast_mismatch, "cast type mismatch", 107, 111);

    var generic_mismatch = types::generic_constructor_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        112,
        130
    );
    try expect_diagnostic(
        generic_mismatch,
        "generic constructor type mismatch",
        112,
        130
    );

    var match_mismatch = types::match_type_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        131,
        140
    );
    try expect_diagnostic(match_mismatch, "match type mismatch", 131, 140);

    var enum_mismatch = types::enum_variant_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        141,
        153
    );
    try expect_diagnostic(enum_mismatch, "enum variant mismatch", 141, 153);

    var union_mismatch = types::union_payload_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        154,
        167
    );
    try expect_diagnostic(union_mismatch, "union payload mismatch", 154, 167);

    var optional_mismatch = types::optional_match_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        168,
        182
    );
    try expect_diagnostic(optional_mismatch, "optional match mismatch", 168, 182);

    var error_mismatch = types::error_union_mismatch(
        allocator,
        "selfhost/src/types.kizu",
        183,
        196
    );
    try expect_diagnostic(error_mismatch, "error union mismatch", 183, 196);

    var exhaustiveness = types::non_exhaustive_match(
        allocator,
        "selfhost/src/types.kizu",
        197,
        213
    );
    try expect_diagnostic(exhaustiveness, "non-exhaustive match", 197, 213);
    return;
}

fn expect_diagnostic(
    diagnostic: std::kizu::diagnostic::Diagnostic,
    message: []const u8,
    byte_start: i64,
    byte_end: i64
) -> !void {
    try std::testing::expect_equal_bytes(message, diagnostic.message);
    try std::testing::expect_equal_i64(byte_start, diagnostic.primary.byte_start);
    try std::testing::expect_equal_i64(byte_end, diagnostic.primary.byte_end);
    diagnostic.deinit();
    return;
}
