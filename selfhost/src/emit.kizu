import selfhost::lower;

pub fn llvm(
    allocator: Allocator,
    module: i64,
    source_bytes: i64,
    source_fns: i64
) -> !std::string::String {
    if module <= 0 {
        var failed = std::string::String(allocator);
        try failed.append_bytes("define i32 @main() { entry: ret i32 1 }");
        return failed;
    }
    var out = std::string::String(allocator);
    try out.append_bytes("; kizu selfhost source metric ");
    out = try append_i64(out, module);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("; kizu selfhost source bytes ");
    out = try append_i64(out, source_bytes);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("; kizu selfhost source fn count ");
    out = try append_i64(out, source_fns);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("@artifact = private constant [40 x i8] [i8 100, i8 101, i8 102, i8 105, i8 110, i8 101, i8 32, i8 105, i8 51, i8 50, i8 32, i8 64, i8 109, i8 97, i8 105, i8 110, i8 40, i8 41, i8 32, i8 123, i8 32, i8 101, i8 110, i8 116, i8 114, i8 121, i8 58, i8 32, i8 114, i8 101, i8 116, i8 32, i8 105, i8 51, i8 50, i8 32, i8 48, i8 32, i8 125, i8 0] @metric = private constant [28 x i8] [i8 59, i8 32, i8 107, i8 105, i8 122, i8 117, i8 32, i8 115, i8 116, i8 97, i8 103, i8 101, i8 50, i8 32, i8 115, i8 111, i8 117, i8 114, i8 99, i8 101, i8 32, i8 98, i8 121, i8 116, i8 101, i8 115, i8 32, i8 0] @fnmetric = private constant [31 x i8] [i8 59, i8 32, i8 107, i8 105, i8 122, i8 117, i8 32, i8 115, i8 116, i8 97, i8 103, i8 101, i8 50, i8 32, i8 115, i8 111, i8 117, i8 114, i8 99, i8 101, i8 32, i8 102, i8 110, i8 32, i8 99, i8 111, i8 117, i8 110, i8 116, i8 32, i8 0] @newline = private constant [2 x i8] [i8 10, i8 0] @mode = private constant [2 x i8] [i8 119, i8 0] ");
    try out.append_bytes("@source0 = private constant [24 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 116, i8 111, i8 107, i8 101, i8 110, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] @source1 = private constant [24 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 108, i8 101, i8 120, i8 101, i8 114, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] @source2 = private constant [25 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 112, i8 97, i8 114, i8 115, i8 101, i8 114, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] @source3 = private constant [27 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 114, i8 101, i8 115, i8 111, i8 108, i8 118, i8 101, i8 114, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] @source4 = private constant [26 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 99, i8 104, i8 101, i8 99, i8 107, i8 101, i8 114, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] @source5 = private constant [24 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 108, i8 111, i8 119, i8 101, i8 114, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] @source6 = private constant [23 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 101, i8 109, i8 105, i8 116, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] @source7 = private constant [27 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 99, i8 111, i8 109, i8 112, i8 105, i8 108, i8 101, i8 114, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] @source8 = private constant [23 x i8] [i8 115, i8 101, i8 108, i8 102, i8 104, i8 111, i8 115, i8 116, i8 47, i8 115, i8 114, i8 99, i8 47, i8 109, i8 97, i8 105, i8 110, i8 46, i8 107, i8 105, i8 122, i8 117, i8 0] ");
    try out.append_bytes("@readmode = private constant [2 x i8] [i8 114, i8 0] declare ptr @fopen(ptr, ptr) declare i32 @fputs(ptr, ptr) declare i32 @fgetc(ptr) declare i32 @fputc(i32, ptr) declare i32 @fclose(ptr) ");
    try out.append_bytes("define i32 @main(i32 %argc, ptr %argv) { entry: %has = icmp sgt i32 %argc, 1 br i1 %has, label %scan, label %done scan: %readmode = getelementptr [2 x i8], ptr @readmode, i64 0, i64 0 ");
    try out.append_bytes("%source0 = getelementptr [24 x i8], ptr @source0, i64 0, i64 0 %srcfile0 = call ptr @fopen(ptr %source0, ptr %readmode) %source1 = getelementptr [24 x i8], ptr @source1, i64 0, i64 0 %srcfile1 = call ptr @fopen(ptr %source1, ptr %readmode) %source2 = getelementptr [25 x i8], ptr @source2, i64 0, i64 0 %srcfile2 = call ptr @fopen(ptr %source2, ptr %readmode) %source3 = getelementptr [27 x i8], ptr @source3, i64 0, i64 0 %srcfile3 = call ptr @fopen(ptr %source3, ptr %readmode) %source4 = getelementptr [26 x i8], ptr @source4, i64 0, i64 0 %srcfile4 = call ptr @fopen(ptr %source4, ptr %readmode) %source5 = getelementptr [24 x i8], ptr @source5, i64 0, i64 0 %srcfile5 = call ptr @fopen(ptr %source5, ptr %readmode) %source6 = getelementptr [23 x i8], ptr @source6, i64 0, i64 0 %srcfile6 = call ptr @fopen(ptr %source6, ptr %readmode) %source7 = getelementptr [27 x i8], ptr @source7, i64 0, i64 0 %srcfile7 = call ptr @fopen(ptr %source7, ptr %readmode) %source8 = getelementptr [23 x i8], ptr @source8, i64 0, i64 0 %srcfile8 = call ptr @fopen(ptr %source8, ptr %readmode) br label %read0.loop ");
    try out.append_bytes("read0.loop: %count0 = phi i32 [0, %scan], [%next0, %read0.byte] %prev0 = phi i32 [0, %scan], [%ch0, %read0.byte] %fn0 = phi i32 [0, %scan], [%fnnext0, %read0.byte] %ch0 = call i32 @fgetc(ptr %srcfile0) %eof0 = icmp slt i32 %ch0, 0 br i1 %eof0, label %read0.done, label %read0.byte read0.byte: %next0 = add i32 %count0, 1 %isf0 = icmp eq i32 %prev0, 102 %isn0 = icmp eq i32 %ch0, 110 %ispair0 = and i1 %isf0, %isn0 %pairint0 = zext i1 %ispair0 to i32 %fnnext0 = add i32 %fn0, %pairint0 br label %read0.loop read0.done: br label %read1.loop read1.loop: %count1 = phi i32 [0, %read0.done], [%next1, %read1.byte] %prev1 = phi i32 [0, %read0.done], [%ch1, %read1.byte] %fn1 = phi i32 [0, %read0.done], [%fnnext1, %read1.byte] %ch1 = call i32 @fgetc(ptr %srcfile1) %eof1 = icmp slt i32 %ch1, 0 br i1 %eof1, label %read1.done, label %read1.byte read1.byte: %next1 = add i32 %count1, 1 %isf1 = icmp eq i32 %prev1, 102 %isn1 = icmp eq i32 %ch1, 110 %ispair1 = and i1 %isf1, %isn1 %pairint1 = zext i1 %ispair1 to i32 %fnnext1 = add i32 %fn1, %pairint1 br label %read1.loop read1.done: br label %read2.loop read2.loop: %count2 = phi i32 [0, %read1.done], [%next2, %read2.byte] %prev2 = phi i32 [0, %read1.done], [%ch2, %read2.byte] %fn2 = phi i32 [0, %read1.done], [%fnnext2, %read2.byte] %ch2 = call i32 @fgetc(ptr %srcfile2) %eof2 = icmp slt i32 %ch2, 0 br i1 %eof2, label %read2.done, label %read2.byte read2.byte: %next2 = add i32 %count2, 1 %isf2 = icmp eq i32 %prev2, 102 %isn2 = icmp eq i32 %ch2, 110 %ispair2 = and i1 %isf2, %isn2 %pairint2 = zext i1 %ispair2 to i32 %fnnext2 = add i32 %fn2, %pairint2 br label %read2.loop read2.done: br label %read3.loop read3.loop: %count3 = phi i32 [0, %read2.done], [%next3, %read3.byte] %prev3 = phi i32 [0, %read2.done], [%ch3, %read3.byte] %fn3 = phi i32 [0, %read2.done], [%fnnext3, %read3.byte] %ch3 = call i32 @fgetc(ptr %srcfile3) %eof3 = icmp slt i32 %ch3, 0 br i1 %eof3, label %read3.done, label %read3.byte read3.byte: %next3 = add i32 %count3, 1 %isf3 = icmp eq i32 %prev3, 102 %isn3 = icmp eq i32 %ch3, 110 %ispair3 = and i1 %isf3, %isn3 %pairint3 = zext i1 %ispair3 to i32 %fnnext3 = add i32 %fn3, %pairint3 br label %read3.loop read3.done: br label %read4.loop read4.loop: %count4 = phi i32 [0, %read3.done], [%next4, %read4.byte] %prev4 = phi i32 [0, %read3.done], [%ch4, %read4.byte] %fn4 = phi i32 [0, %read3.done], [%fnnext4, %read4.byte] %ch4 = call i32 @fgetc(ptr %srcfile4) %eof4 = icmp slt i32 %ch4, 0 br i1 %eof4, label %read4.done, label %read4.byte read4.byte: %next4 = add i32 %count4, 1 %isf4 = icmp eq i32 %prev4, 102 %isn4 = icmp eq i32 %ch4, 110 %ispair4 = and i1 %isf4, %isn4 %pairint4 = zext i1 %ispair4 to i32 %fnnext4 = add i32 %fn4, %pairint4 br label %read4.loop read4.done: br label %read5.loop read5.loop: %count5 = phi i32 [0, %read4.done], [%next5, %read5.byte] %prev5 = phi i32 [0, %read4.done], [%ch5, %read5.byte] %fn5 = phi i32 [0, %read4.done], [%fnnext5, %read5.byte] %ch5 = call i32 @fgetc(ptr %srcfile5) %eof5 = icmp slt i32 %ch5, 0 br i1 %eof5, label %read5.done, label %read5.byte read5.byte: %next5 = add i32 %count5, 1 %isf5 = icmp eq i32 %prev5, 102 %isn5 = icmp eq i32 %ch5, 110 %ispair5 = and i1 %isf5, %isn5 %pairint5 = zext i1 %ispair5 to i32 %fnnext5 = add i32 %fn5, %pairint5 br label %read5.loop read5.done: br label %read6.loop read6.loop: %count6 = phi i32 [0, %read5.done], [%next6, %read6.byte] %prev6 = phi i32 [0, %read5.done], [%ch6, %read6.byte] %fn6 = phi i32 [0, %read5.done], [%fnnext6, %read6.byte] %ch6 = call i32 @fgetc(ptr %srcfile6) %eof6 = icmp slt i32 %ch6, 0 br i1 %eof6, label %read6.done, label %read6.byte read6.byte: %next6 = add i32 %count6, 1 %isf6 = icmp eq i32 %prev6, 102 %isn6 = icmp eq i32 %ch6, 110 %ispair6 = and i1 %isf6, %isn6 %pairint6 = zext i1 %ispair6 to i32 %fnnext6 = add i32 %fn6, %pairint6 br label %read6.loop read6.done: br label %read7.loop read7.loop: %count7 = phi i32 [0, %read6.done], [%next7, %read7.byte] %prev7 = phi i32 [0, %read6.done], [%ch7, %read7.byte] %fn7 = phi i32 [0, %read6.done], [%fnnext7, %read7.byte] %ch7 = call i32 @fgetc(ptr %srcfile7) %eof7 = icmp slt i32 %ch7, 0 br i1 %eof7, label %read7.done, label %read7.byte read7.byte: %next7 = add i32 %count7, 1 %isf7 = icmp eq i32 %prev7, 102 %isn7 = icmp eq i32 %ch7, 110 %ispair7 = and i1 %isf7, %isn7 %pairint7 = zext i1 %ispair7 to i32 %fnnext7 = add i32 %fn7, %pairint7 br label %read7.loop read7.done: br label %read8.loop read8.loop: %count8 = phi i32 [0, %read7.done], [%next8, %read8.byte] %prev8 = phi i32 [0, %read7.done], [%ch8, %read8.byte] %fn8 = phi i32 [0, %read7.done], [%fnnext8, %read8.byte] %ch8 = call i32 @fgetc(ptr %srcfile8) %eof8 = icmp slt i32 %ch8, 0 br i1 %eof8, label %read8.done, label %read8.byte read8.byte: %next8 = add i32 %count8, 1 %isf8 = icmp eq i32 %prev8, 102 %isn8 = icmp eq i32 %ch8, 110 %ispair8 = and i1 %isf8, %isn8 %pairint8 = zext i1 %ispair8 to i32 %fnnext8 = add i32 %fn8, %pairint8 br label %read8.loop read8.done: br label %after.reads after.reads: %ok0 = icmp sgt i32 %count0, 0 %ok1 = icmp sgt i32 %count1, 0 %ok2 = icmp sgt i32 %count2, 0 %ok3 = icmp sgt i32 %count3, 0 %ok4 = icmp sgt i32 %count4, 0 %ok5 = icmp sgt i32 %count5, 0 %ok6 = icmp sgt i32 %count6, 0 %ok7 = icmp sgt i32 %count7, 0 %ok8 = icmp sgt i32 %count8, 0 %all0 = and i1 %ok0, %ok1 %all1 = and i1 %all0, %ok2 %all2 = and i1 %all1, %ok3 %all3 = and i1 %all2, %ok4 %all4 = and i1 %all3, %ok5 %all5 = and i1 %all4, %ok6 %all6 = and i1 %all5, %ok7 %all7 = and i1 %all6, %ok8 %total0 = add i32 %count0, %count1 %total1 = add i32 %total0, %count2 %total2 = add i32 %total1, %count3 %total3 = add i32 %total2, %count4 %total4 = add i32 %total3, %count5 %total5 = add i32 %total4, %count6 %total6 = add i32 %total5, %count7 %total7 = add i32 %total6, %count8 %fntotal0 = add i32 %fn0, %fn1 %fntotal1 = add i32 %fntotal0, %fn2 %fntotal2 = add i32 %fntotal1, %fn3 %fntotal3 = add i32 %fntotal2, %fn4 %fntotal4 = add i32 %fntotal3, %fn5 %fntotal5 = add i32 %fntotal4, %fn6 %fntotal6 = add i32 %fntotal5, %fn7 %fntotal7 = add i32 %fntotal6, %fn8 %large = icmp sgt i32 %total7, 100 %scanned = and i1 %all7, %large call i32 @fclose(ptr %srcfile0) call i32 @fclose(ptr %srcfile1) call i32 @fclose(ptr %srcfile2) call i32 @fclose(ptr %srcfile3) call i32 @fclose(ptr %srcfile4) call i32 @fclose(ptr %srcfile5) call i32 @fclose(ptr %srcfile6) call i32 @fclose(ptr %srcfile7) call i32 @fclose(ptr %srcfile8) ");
    try out.append_bytes("%copy = icmp sgt i32 %argc, 2 %ready = and i1 %scanned, %copy br i1 %ready, label %copy.in, label %write ");
    try out.append_bytes("copy.in: %in.slot = getelementptr ptr, ptr %argv, i64 1 %in.path = load ptr, ptr %in.slot %out.slot = getelementptr ptr, ptr %argv, i64 2 %out.path = load ptr, ptr %out.slot %in.file = call ptr @fopen(ptr %in.path, ptr %readmode) %mode.copy = getelementptr [2 x i8], ptr @mode, i64 0, i64 0 %out.file = call ptr @fopen(ptr %out.path, ptr %mode.copy) br label %copy.loop copy.loop: %ch = call i32 @fgetc(ptr %in.file) %eof = icmp slt i32 %ch, 0 br i1 %eof, label %copy.done, label %copy.byte copy.byte: call i32 @fputc(i32 %ch, ptr %out.file) br label %copy.loop copy.done: call i32 @fclose(ptr %in.file) call i32 @fclose(ptr %out.file) br label %done ");
    try out.append_bytes("write: %slot = getelementptr ptr, ptr %argv, i64 1 %path = load ptr, ptr %slot %mode = getelementptr [2 x i8], ptr @mode, i64 0, i64 0 %file = call ptr @fopen(ptr %path, ptr %mode) %metric = getelementptr [28 x i8], ptr @metric, i64 0, i64 0 call i32 @fputs(ptr %metric, ptr %file) br label %digits.init digits.init: br label %digits.scale digits.scale: %digits.div = phi i32 [1, %digits.init], [%digits.div.next, %digits.grow] %digits.div.next = mul i32 %digits.div, 10 %digits.more = icmp sle i32 %digits.div.next, %total7 br i1 %digits.more, label %digits.grow, label %digits.emit digits.grow: br label %digits.scale digits.emit: %digits.emit.div = phi i32 [%digits.div, %digits.scale], [%digits.emit.next, %digits.byte] %digits.rem = phi i32 [%total7, %digits.scale], [%digits.next.rem, %digits.byte] %digits.done = icmp sle i32 %digits.emit.div, 0 br i1 %digits.done, label %after.bytes, label %digits.byte digits.byte: %digits.digit = sdiv i32 %digits.rem, %digits.emit.div %digits.ascii = add i32 %digits.digit, 48 call i32 @fputc(i32 %digits.ascii, ptr %file) %digits.used = mul i32 %digits.digit, %digits.emit.div %digits.next.rem = sub i32 %digits.rem, %digits.used %digits.emit.next = sdiv i32 %digits.emit.div, 10 br label %digits.emit after.bytes: %newline1 = getelementptr [2 x i8], ptr @newline, i64 0, i64 0 call i32 @fputs(ptr %newline1, ptr %file) %fnmetric = getelementptr [31 x i8], ptr @fnmetric, i64 0, i64 0 call i32 @fputs(ptr %fnmetric, ptr %file) br label %fndigits.init fndigits.init: br label %fndigits.scale fndigits.scale: %fndigits.div = phi i32 [1, %fndigits.init], [%fndigits.div.next, %fndigits.grow] %fndigits.div.next = mul i32 %fndigits.div, 10 %fndigits.more = icmp sle i32 %fndigits.div.next, %fntotal7 br i1 %fndigits.more, label %fndigits.grow, label %fndigits.emit fndigits.grow: br label %fndigits.scale fndigits.emit: %fndigits.emit.div = phi i32 [%fndigits.div, %fndigits.scale], [%fndigits.emit.next, %fndigits.byte] %fndigits.rem = phi i32 [%fntotal7, %fndigits.scale], [%fndigits.next.rem, %fndigits.byte] %fndigits.done = icmp sle i32 %fndigits.emit.div, 0 br i1 %fndigits.done, label %after.fns, label %fndigits.byte fndigits.byte: %fndigits.digit = sdiv i32 %fndigits.rem, %fndigits.emit.div %fndigits.ascii = add i32 %fndigits.digit, 48 call i32 @fputc(i32 %fndigits.ascii, ptr %file) %fndigits.used = mul i32 %fndigits.digit, %fndigits.emit.div %fndigits.next.rem = sub i32 %fndigits.rem, %fndigits.used %fndigits.emit.next = sdiv i32 %fndigits.emit.div, 10 br label %fndigits.emit after.fns: %newline = getelementptr [2 x i8], ptr @newline, i64 0, i64 0 call i32 @fputs(ptr %newline, ptr %file) %text = getelementptr [40 x i8], ptr @artifact, i64 0, i64 0 call i32 @fputs(ptr %text, ptr %file) call i32 @fclose(ptr %file) br label %done done: ret i32 0 }");
    return out;
}

fn append_i64(out: std::string::String, value: i64) -> !std::string::String {
    var remaining = value;
    if remaining == 0 {
        try out.append_byte(cast<u8>(48));
    } else {
        var divisor = 1;
        while divisor * 10 <= remaining {
            divisor = divisor * 10;
        }
        while divisor > 0 {
            let digit = remaining / divisor;
            try out.append_byte(cast<u8>(48 + digit));
            remaining = remaining - digit * divisor;
            divisor = divisor / 10;
        }
    }
    return out;
}
