    try out.append_bytes("br i1 %scanned, label %write, label %done ");
    try out.append_bytes("write: %slot = getelementptr ptr, ptr %argv, i64 1 %path = load ptr, ptr %slot %mode = getelementptr [2 x i8], ptr @mode, i64 0, i64 0 %file = call ptr @fopen(ptr %path, ptr %mode) %parsemetric = getelementptr [29 x i8], ptr @parsemetric, i64 0, i64 0 call i32 @fputs(ptr %parsemetric, ptr %file) br label %parsedigits.init parsedigits.init: br label %parsedigits.scale parsedigits.scale: %parsedigits.div = phi i32 [1, %parsedigits.init], [%parsedigits.div.next, %parsedigits.grow] %parsedigits.div.next = mul i32 %parsedigits.div, 10 %parsedigits.more = icmp sle i32 %parsedigits.div.next, %parsetotal br i1 %parsedigits.more, label %parsedigits.grow, label %parsedigits.emit parsedigits.grow: br label %parsedigits.scale parsedigits.emit: %parsedigits.emit.div = phi i32 [%parsedigits.div, %parsedigits.scale], [%parsedigits.emit.next, %parsedigits.byte] %parsedigits.rem = phi i32 [%parsetotal, %parsedigits.scale], [%parsedigits.next.rem, %parsedigits.byte] %parsedigits.done = icmp sle i32 %parsedigits.emit.div, 0 br i1 %parsedigits.done, label %after.parse, label %parsedigits.byte parsedigits.byte: %parsedigits.digit = sdiv i32 %parsedigits.rem, %parsedigits.emit.div %parsedigits.ascii = add i32 %parsedigits.digit, 48 call i32 @fputc(i32 %parsedigits.ascii, ptr %file) %parsedigits.used = mul i32 %parsedigits.digit, %parsedigits.emit.div %parsedigits.next.rem = sub i32 %parsedigits.rem, %parsedigits.used %parsedigits.emit.next = sdiv i32 %parsedigits.emit.div, 10 br label %parsedigits.emit after.parse: %newline0 = getelementptr [2 x i8], ptr @newline, i64 0, i64 0 call i32 @fputs(ptr %newline0, ptr %file) %metric = getelementptr [28 x i8], ptr @metric, i64 0, i64 0 call i32 @fputs(ptr %metric, ptr %file) br label %digits.init digits.init: br label %digits.scale digits.scale: %digits.div = phi i32 [1, %digits.init], [%digits.div.next, %digits.grow] %digits.div.next = mul i32 %digits.div, 10 %digits.more = icmp sle i32 %digits.div.next, %total7 br i1 %digits.more, label %digits.grow, label %digits.emit digits.grow: br label %digits.scale digits.emit: %digits.emit.div = phi i32 [%digits.div, %digits.scale], [%digits.emit.next, %digits.byte] %digits.rem = phi i32 [%total7, %digits.scale], [%digits.next.rem, %digits.byte] %digits.done = icmp sle i32 %digits.emit.div, 0 br i1 %digits.done, label %after.bytes, label %digits.byte digits.byte: %digits.digit = sdiv i32 %digits.rem, %digits.emit.div %digits.ascii = add i32 %digits.digit, 48 call i32 @fputc(i32 %digits.ascii, ptr %file) %digits.used = mul i32 %digits.digit, %digits.emit.div %digits.next.rem = sub i32 %digits.rem, %digits.used %digits.emit.next = sdiv i32 %digits.emit.div, 10 br label %digits.emit after.bytes: %newline1 = getelementptr [2 x i8], ptr @newline, i64 0, i64 0 call i32 @fputs(ptr %newline1, ptr %file) %fnmetric = getelementptr [31 x i8], ptr @fnmetric, i64 0, i64 0 call i32 @fputs(ptr %fnmetric, ptr %file) br label %fndigits.init fndigits.init: br label %fndigits.scale fndigits.scale: %fndigits.div = phi i32 [1, %fndigits.init], [%fndigits.div.next, %fndigits.grow] %fndigits.div.next = mul i32 %fndigits.div, 10 %fndigits.more = icmp sle i32 %fndigits.div.next, %fntotal7 br i1 %fndigits.more, label %fndigits.grow, label %fndigits.emit fndigits.grow: br label %fndigits.scale fndigits.emit: %fndigits.emit.div = phi i32 [%fndigits.div, %fndigits.scale], [%fndigits.emit.next, %fndigits.byte] %fndigits.rem = phi i32 [%fntotal7, %fndigits.scale], [%fndigits.next.rem, %fndigits.byte] %fndigits.done = icmp sle i32 %fndigits.emit.div, 0 br i1 %fndigits.done, label %after.fns, label %fndigits.byte fndigits.byte: %fndigits.digit = sdiv i32 %fndigits.rem, %fndigits.emit.div %fndigits.ascii = add i32 %fndigits.digit, 48 call i32 @fputc(i32 %fndigits.ascii, ptr %file) %fndigits.used = mul i32 %fndigits.digit, %fndigits.emit.div %fndigits.next.rem = sub i32 %fndigits.rem, %fndigits.used %fndigits.emit.next = sdiv i32 %fndigits.emit.div, 10 br label %fndigits.emit after.fns: %newline = getelementptr [2 x i8], ptr @newline, i64 0, i64 0 call i32 @fputs(ptr %newline, ptr %file) %text = getelementptr [40 x i8], ptr @artifact, i64 0, i64 0 call i32 @fputs(ptr %text, ptr %file) call i32 @fclose(ptr %file) br label %done done: ret i32 0 }");
    return out;
}

fn append_i64(out: std::string::String, value: i64) -> !std::string::String {
    var remaining = value;
    if remaining == 0 {
        try out.append_byte(cast<u8>(48));
    } else {
        var divisor = 1;
        while divisor * 10 <= remaining {
            divisor = divisor * 10;
        }
        while divisor > 0 {
            let digit = remaining / divisor;
            try out.append_byte(cast<u8>(48 + digit));
            remaining = remaining - digit * divisor;
            divisor = divisor / 10;
        }
    }
    return out;
}
