import selfhost::ir::package_type_resolution;

pub fn len(table: &package_type_resolution::CanonicalTypeFacts) -> i64 {
    return table.records.len();
}

pub fn kind(table: &package_type_resolution::CanonicalTypeFacts, id: i64) -> !i64 {
    let records = &table.records;
    let record = try records.at(id);
    return record.kind;
}

pub fn intrinsic_kind(table: &package_type_resolution::CanonicalTypeFacts, id: i64) -> !i64 {
    let records = &table.records;
    let record = try records.at(id);
    return record.intrinsic_kind;
}

pub fn declaration_component(table: &package_type_resolution::CanonicalTypeFacts, id: i64) -> !i64 {
    let records = &table.records;
    let record = try records.at(id);
    return record.declaration_component_id;
}

pub fn declaration_index(table: &package_type_resolution::CanonicalTypeFacts, id: i64) -> !i64 {
    let records = &table.records;
    let record = try records.at(id);
    return record.declaration_index;
}

pub fn formal_owner_kind(table: &package_type_resolution::CanonicalTypeFacts, id: i64) -> !i64 {
    let records = &table.records;
    let record = try records.at(id);
    return record.formal_owner_kind;
}

pub fn formal_owner_id(table: &package_type_resolution::CanonicalTypeFacts, id: i64) -> !i64 {
    let records = &table.records;
    let record = try records.at(id);
    return record.formal_owner_id;
}

pub fn formal_slot(table: &package_type_resolution::CanonicalTypeFacts, id: i64) -> !i64 {
    let records = &table.records;
    let record = try records.at(id);
    return record.formal_slot;
}

pub fn child_len(table: &package_type_resolution::CanonicalTypeFacts, id: i64) -> !i64 {
    let records = &table.records;
    let record = try records.at(id);
    return record.child_len;
}

pub fn child(
    table: &package_type_resolution::CanonicalTypeFacts,
    id: i64,
    index: i64
) -> !i64 {
    let count = try child_len(table, id);
    if index < 0 or index >= count {
        return error("canonical type child index out of range");
    }
    let records = &table.records;
    let record = try records.at(id);
    return table.child_ids.get(record.child_start + index);
}

pub fn kind_name(kind_value: i64) -> ![]u8 {
    if kind_value == package_type_resolution::type_kind_intrinsic() { return "intrinsic"; }
    if kind_value == package_type_resolution::type_kind_declared() { return "declared"; }
    if kind_value == package_type_resolution::type_kind_formal() { return "formal"; }
    if kind_value == package_type_resolution::type_kind_borrow() { return "borrow"; }
    if kind_value == package_type_resolution::type_kind_borrow_var() { return "borrow-var"; }
    if kind_value == package_type_resolution::type_kind_slice() { return "slice"; }
    if kind_value == package_type_resolution::type_kind_nullable() { return "nullable"; }
    if kind_value == package_type_resolution::type_kind_dynamic() { return "dynamic"; }
    if kind_value == package_type_resolution::type_kind_error_union() { return "error-union"; }
    if kind_value == package_type_resolution::type_kind_const() { return "const"; }
    if kind_value == package_type_resolution::type_kind_function_item() { return "function-item"; }
    return error("unknown canonical type kind");
}
