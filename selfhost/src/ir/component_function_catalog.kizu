import selfhost::parser;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "fn add(left: i64, right: i64) -> i64 { return left; }
fn zero() -> i64 { return 0; }";
    var result = try parser::parse_checked_file(
        allocator,
        "component_function_catalog_gate.kizu",
        source
    );
    defer result.deinit();
    var catalog = try collect_from_ast(allocator, source, result.ast, result.root, "demo");
    defer catalog.deinit();

    std::testing::expect_equal<i64>(2, len(&catalog));
    try expect_local_name(&catalog, 0, "add");
    try expect_local_name(&catalog, 1, "zero");
    try expect_appended_qualified_name(allocator, &catalog, 0, "demo::add");
    std::testing::expect(try qualified_function_name_matches(&catalog, 0, "demo::add"));
    std::testing::expect(!(try qualified_function_name_matches(&catalog, 0, "demo::zero")));

    let add_index = try find_local_function_index(&catalog, "add");
    let zero_index = try find_qualified_function_index(&catalog, "demo::zero");
    std::testing::expect_equal<i64>(0, add_index);
    std::testing::expect_equal<i64>(1, zero_index);
    let add_signature = try function_signature(&catalog, add_index);
    let zero_signature = try function_signature(&catalog, zero_index);
    try expect_add_signature(
        source,
        result.ast,
        add_signature.params,
        add_signature.return_type
    );
    try expect_zero_signature(
        source,
        result.ast,
        zero_signature.params,
        zero_signature.return_type
    );

    print("component-catalog-functions");
    print(len(&catalog));
    print("component-catalog-add-index");
    print(add_index);
    print("component-catalog-zero-index");
    print(zero_index);
    return;
}

fn expect_local_name(
    catalog: &ComponentFunctionCatalog,
    index: i64,
    expected: []u8
) -> !void {
    let name = try local_function_name(catalog, index);
    std::testing::expect_equal<[]u8>(expected, name);
    return;
}

fn expect_appended_qualified_name(
    allocator: Allocator,
    catalog: &ComponentFunctionCatalog,
    index: i64,
    expected: []u8
) -> !void {
    var qualified = std::string::String(allocator);
    defer qualified.deinit();
    try append_qualified_function_name(&var qualified, catalog, index);
    let qualified_bytes = qualified.as_bytes();
    std::testing::expect_equal<[]u8>(expected, qualified_bytes);
    return;
}

fn expect_add_signature(
    source: []u8,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId
) -> !void {
    std::testing::expect_equal<i64>(2, params.len);
    try expect_param(source, ast, params, 0, "left", "i64");
    try expect_param(source, ast, params, 1, "right", "i64");
    expect_type_text(source, ast, return_type, "i64");
    return;
}

fn expect_zero_signature(
    source: []u8,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId
) -> !void {
    std::testing::expect_equal<i64>(0, params.len);
    expect_type_text(source, ast, return_type, "i64");
    return;
}

fn expect_param(
    source: []u8,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    index: i64,
    expected_name: []u8,
    expected_type: []u8
) -> !void {
    let param_id = try ast.child_at(params, index);
    let node = ast.get(param_id);
    match node.data {
        Param(param) => return expect_param_nodes(
            source,
            ast,
            param.name,
            param.type_node,
            expected_name,
            expected_type
        );,
        _ => return std::testing::fail("expected component function param");,
    }
}

fn expect_param_nodes(
    source: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    expected_name: []u8,
    expected_type: []u8
) -> !void {
    std::testing::expect_equal<[]u8>(expected_name, ast_node_text(source, ast, name));
    expect_type_text(source, ast, type_node, expected_type);
    return;
}

fn expect_type_text(
    source: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    expected: []u8
) -> void {
    std::testing::expect_equal<[]u8>(expected, ast_node_text(source, ast, node_id));
    return;
}

fn ast_node_text(
    source: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 borrows source {
    let span = ast.get(node_id).span;
    return std::mem::trim_ascii(source[span.start..span.end]);
}

pub struct ComponentFunctionSignature {
    pub params: std::kizu::ast::ChildRange,
    pub return_type: std::kizu::ast::NodeId,
}

pub struct ComponentFunctionEntry {
    pub node_id: std::kizu::ast::NodeId,
    pub signature: ComponentFunctionSignature,
    pub local_start: i64,
    pub local_end: i64,
}

pub struct ComponentFunctionName {
    source_text: []u8,
    component_prefix: []u8,
    local_start: i64,
    local_end: i64,
}

pub struct ComponentFunctionCatalog {
    source_text: []u8,
    component_prefix: []u8,
    // Keep entry fields in copy-friendly arrays until selfhost Array borrowing
    // supports reading non-copy aggregate entries from catalog fields.
    function_node_ids: std::array::Array<std::kizu::ast::NodeId>,
    local_starts: std::array::Array<i64>,
    local_ends: std::array::Array<i64>,
    param_starts: std::array::Array<i64>,
    param_lens: std::array::Array<i64>,
    return_type_node_ids: std::array::Array<std::kizu::ast::NodeId>,
}

pub fn collect_from_ast(
    allocator: Allocator,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    component_prefix: []u8
) -> !ComponentFunctionCatalog {
    var catalog = ComponentFunctionCatalog {
        source_text: text,
        component_prefix: component_prefix,
        function_node_ids: std::array::Array<std::kizu::ast::NodeId>(allocator),
        local_starts: std::array::Array<i64>(allocator),
        local_ends: std::array::Array<i64>(allocator),
        param_starts: std::array::Array<i64>(allocator),
        param_lens: std::array::Array<i64>(allocator),
        return_type_node_ids: std::array::Array<std::kizu::ast::NodeId>(allocator)
    };
    try collect_node(&var catalog, text, ast, root);
    return catalog;
}

pub fn single_function_name(qualified_name: []u8) -> ComponentFunctionName {
    return ComponentFunctionName {
        source_text: qualified_name,
        component_prefix: "",
        local_start: 0,
        local_end: std::mem::len(qualified_name)
    };
}

pub fn len(catalog: &ComponentFunctionCatalog) -> i64 {
    return catalog.function_node_ids.len();
}

pub fn entry(
    catalog: &ComponentFunctionCatalog,
    index: i64
) -> !ComponentFunctionEntry {
    return ComponentFunctionEntry {
        node_id: try function_node_id(catalog, index),
        signature: try function_signature(catalog, index),
        local_start: try catalog.local_starts.get(index),
        local_end: try catalog.local_ends.get(index)
    };
}

pub fn local_function_name(
    catalog: &ComponentFunctionCatalog,
    index: i64
) -> ![]u8 borrows catalog {
    let start = try catalog.local_starts.get(index);
    let end = try catalog.local_ends.get(index);
    return catalog.source_text[start..end];
}

pub fn append_qualified_function_name(
    out: &var std::string::String,
    catalog: &ComponentFunctionCatalog,
    index: i64
) -> !void {
    let name = try function_name(catalog, index);
    try append_function_name(out, &name);
    return;
}

pub fn function_name(
    catalog: &ComponentFunctionCatalog,
    index: i64
) -> !ComponentFunctionName {
    return ComponentFunctionName {
        source_text: catalog.source_text,
        component_prefix: catalog.component_prefix,
        local_start: try catalog.local_starts.get(index),
        local_end: try catalog.local_ends.get(index)
    };
}

pub fn append_function_name(
    out: &var std::string::String,
    name: &ComponentFunctionName
) -> !void {
    if std::mem::len(name.component_prefix) > 0 {
        try out.append_bytes(name.component_prefix);
        try out.append_bytes("::");
    }
    try out.append_bytes(name.source_text[name.local_start..name.local_end]);
    return;
}

pub fn qualified_function_name(
    allocator: Allocator,
    catalog: &ComponentFunctionCatalog,
    index: i64
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_qualified_function_name(&var out, catalog, index);
    return out;
}

pub fn function_node_id(
    catalog: &ComponentFunctionCatalog,
    index: i64
) -> !std::kizu::ast::NodeId {
    return try catalog.function_node_ids.get(index);
}

pub fn function_signature(
    catalog: &ComponentFunctionCatalog,
    index: i64
) -> !ComponentFunctionSignature {
    let param_start = try catalog.param_starts.get(index);
    let param_len = try catalog.param_lens.get(index);
    return ComponentFunctionSignature {
        params: std::kizu::ast::ChildRange {
            start: param_start,
            len: param_len
        },
        return_type: try catalog.return_type_node_ids.get(index)
    };
}

pub fn find_local_function_index(
    catalog: &ComponentFunctionCatalog,
    local_name: []u8
) -> !i64 {
    var index = 0;
    while index < catalog.function_node_ids.len() {
        let name = try local_function_name(catalog, index);
        if std::mem::equal_bytes(name, local_name) {
            return index;
        }
        index = index + 1;
    }
    return error("component function not found");
}

pub fn find_qualified_function_index(
    catalog: &ComponentFunctionCatalog,
    qualified_name: []u8
) -> !i64 {
    var index = 0;
    while index < catalog.function_node_ids.len() {
        if try qualified_function_name_matches(catalog, index, qualified_name) {
            return index;
        }
        index = index + 1;
    }
    return error("component function not found");
}

pub fn qualified_function_name_matches(
    catalog: &ComponentFunctionCatalog,
    index: i64,
    qualified_name: []u8
) -> !bool {
    let local_name = try local_function_name(catalog, index);
    let prefix_len = std::mem::len(catalog.component_prefix);
    let local_len = std::mem::len(local_name);
    if prefix_len == 0 {
        return std::mem::equal_bytes(qualified_name, local_name);
    }
    if std::mem::len(qualified_name) != prefix_len + 2 + local_len {
        return false;
    }
    if !std::mem::equal_bytes(qualified_name[0..prefix_len], catalog.component_prefix) {
        return false;
    }
    if qualified_name[prefix_len] != cast<u8>(58) or
        qualified_name[prefix_len + 1] != cast<u8>(58) {
        return false;
    }
    return std::mem::equal_bytes(
        qualified_name[prefix_len + 2..std::mem::len(qualified_name)],
        local_name
    );
}

fn collect_node(
    catalog: &var ComponentFunctionCatalog,
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return collect_range(catalog, text, ast, program.declarations);,
        FnDecl(fn_decl) => return append_function_from_decl(
            catalog,
            text,
            ast,
            node_id,
            fn_decl.name,
            fn_decl.params,
            fn_decl.return_type
        );,
        _ => return;,
    }
    return;
}

fn collect_range(
    catalog: &var ComponentFunctionCatalog,
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_node(catalog, text, ast, child);
        index = index + 1;
    }
    return;
}

fn append_function_from_decl(
    catalog: &var ComponentFunctionCatalog,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_node: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId
) -> !void {
    let name_span = ast.get(name).span;
    let local_name = std::mem::trim_ascii(text[name_span.start..name_span.end]);
    if contains_local_function(catalog, local_name) {
        return error("duplicate component function");
    }
    try catalog.function_node_ids.append(function_node);
    try catalog.local_starts.append(name_span.start);
    try catalog.local_ends.append(name_span.end);
    try catalog.param_starts.append(params.start);
    try catalog.param_lens.append(params.len);
    try catalog.return_type_node_ids.append(return_type);
    return;
}

fn contains_local_function(catalog: &ComponentFunctionCatalog, local_name: []u8) -> bool {
    var index = 0;
    while index < catalog.function_node_ids.len() {
        let start = catalog.local_starts.get_or_panic(index);
        let end = catalog.local_ends.get_or_panic(index);
        let name = catalog.source_text[start..end];
        if std::mem::equal_bytes(name, local_name) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

impl ComponentFunctionCatalog {
    fn deinit(self: ComponentFunctionCatalog) -> void {
        self.function_node_ids.deinit();
        self.local_starts.deinit();
        self.local_ends.deinit();
        self.param_starts.deinit();
        self.param_lens.deinit();
        self.return_type_node_ids.deinit();
        return;
    }
}
