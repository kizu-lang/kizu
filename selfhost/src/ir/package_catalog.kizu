import selfhost::ir::package_function_identity;
import selfhost::ir::exact_name_index;

pub fn declared_type_struct_kind() -> i64 { return 1; }
pub fn declared_type_enum_kind() -> i64 { return 2; }
pub fn declared_type_union_kind() -> i64 { return 3; }
pub fn function_param_runtime_mode() -> i64 { return 1; }
pub fn function_param_comptime_mode() -> i64 { return 2; }

struct FunctionParamLayout {
    function_index: i64,
    ordinal: i64,
    name: []u8,
    type_spelling: []u8,
    mode: i64,
    is_receiver: bool,
    runtime_ordinal: i64,
}

pub fn function_len(catalog: &PackageFunctionCatalog) -> i64 {
    return catalog.function_names.len();
}

pub fn component_len(catalog: &PackageFunctionCatalog) -> i64 {
    return catalog.component_names.len();
}

pub fn exact_top_level_function_entry(
    catalog: &PackageFunctionCatalog,
    component_id: i64,
    name: []u8
) -> !i64 {
    if component_id < 0 or component_id >= catalog.component_names.len() {
        return -1;
    }
    return exact_name_index::lookup(
        &catalog.top_level_function_index,
        &catalog.function_component_ids,
        &catalog.function_names,
        component_id,
        name
    );
}

pub fn exact_declared_impl_method_entry(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64,
    name: []u8
) -> !i64 {
    if declaration_index < 0 or
        declaration_index >= catalog.declared_type_names.len() {
        return -1;
    }
    return exact_name_index::lookup(
        &catalog.declared_impl_method_index,
        &catalog.function_owner_declaration_indices,
        &catalog.function_names,
        declaration_index,
        name
    );
}

pub fn function_return_type_at(catalog: &PackageFunctionCatalog, index: i64) -> []u8 {
    return catalog.function_return_type_names.get_or_panic(index);
}

pub fn function_owner_type_at(catalog: &PackageFunctionCatalog, index: i64) -> []u8 {
    return catalog.function_owner_type_names.get_or_panic(index);
}

pub fn function_component_id_at(catalog: &PackageFunctionCatalog, index: i64) -> i64 {
    return catalog.function_component_ids.get_or_panic(index);
}

pub fn function_owner_declaration_index_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> i64 {
    return catalog.function_owner_declaration_indices.get_or_panic(index);
}

pub fn function_is_impl_method_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> bool {
    return catalog.function_method_ordinals.get_or_panic(index) >= 0;
}


pub fn function_type_parameter_len(
    catalog: &PackageFunctionCatalog,
    function_index: i64
) -> i64 {
    return catalog.function_type_parameter_lens.get_or_panic(function_index);
}

pub fn function_type_parameter_name(
    catalog: &PackageFunctionCatalog,
    function_index: i64,
    parameter_index: i64
) -> ![]u8 {
    let len = function_type_parameter_len(catalog, function_index);
    if parameter_index < 0 or parameter_index >= len {
        return error("function type parameter index out of range");
    }
    let start = catalog.function_type_parameter_starts.get_or_panic(function_index);
    return catalog.function_type_parameter_names.get(start + parameter_index);
}

pub fn function_param_len(
    catalog: &PackageFunctionCatalog,
    function_index: i64
) -> i64 {
    return catalog.function_param_lens.get_or_panic(function_index);
}

pub fn function_param_name(
    catalog: &PackageFunctionCatalog,
    function_index: i64,
    param_index: i64
) -> ![]u8 {
    let index = try checked_function_param_index(
        catalog, function_index, param_index
    );
    let params = &catalog.function_params;
    let record = try params.at(index);
    return record.name;
}

pub fn function_param_type_spelling(
    catalog: &PackageFunctionCatalog,
    function_index: i64,
    param_index: i64
) -> ![]u8 {
    let index = try checked_function_param_index(
        catalog, function_index, param_index
    );
    let params = &catalog.function_params;
    let record = try params.at(index);
    return record.type_spelling;
}

pub fn function_param_mode(
    catalog: &PackageFunctionCatalog,
    function_index: i64,
    param_index: i64
) -> !i64 {
    let index = try checked_function_param_index(
        catalog, function_index, param_index
    );
    let params = &catalog.function_params;
    let record = try params.at(index);
    return record.mode;
}

pub fn function_param_is_receiver(
    catalog: &PackageFunctionCatalog,
    function_index: i64,
    param_index: i64
) -> !bool {
    let index = try checked_function_param_index(
        catalog, function_index, param_index
    );
    let params = &catalog.function_params;
    let record = try params.at(index);
    return record.is_receiver;
}

pub fn function_param_runtime_ordinal(
    catalog: &PackageFunctionCatalog,
    function_index: i64,
    param_index: i64
) -> !i64 {
    let index = try checked_function_param_index(
        catalog, function_index, param_index
    );
    let params = &catalog.function_params;
    let record = try params.at(index);
    return record.runtime_ordinal;
}

fn checked_function_param_index(
    catalog: &PackageFunctionCatalog,
    function_index: i64,
    param_index: i64
) -> !i64 {
    if function_index < 0 or function_index >= catalog.function_names.len() {
        return error("function parameter owner index out of range");
    }
    let len = function_param_len(catalog, function_index);
    if param_index < 0 or param_index >= len {
        return error("function parameter index out of range");
    }
    let index = catalog.function_param_starts.get_or_panic(function_index) +
        param_index;
    let params = &catalog.function_params;
    let record = try params.at(index);
    if record.function_index != function_index or record.ordinal != param_index {
        return error("function parameter layout identity mismatch");
    }
    return index;
}

pub fn struct_field_template_len(catalog: &PackageFunctionCatalog) -> i64 {
    return catalog.struct_field_names.len();
}

pub fn declared_struct_field_start(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64
) -> i64 {
    return catalog.declared_type_struct_field_starts.get_or_panic(declaration_index);
}

pub fn declared_struct_field_len(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64
) -> i64 {
    return catalog.declared_type_struct_field_lens.get_or_panic(declaration_index);
}

pub fn struct_field_template_component_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> i64 { return catalog.struct_component_ids.get_or_panic(index); }

pub fn struct_field_template_declaration_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> i64 { return catalog.struct_declaration_indices.get_or_panic(index); }

pub fn struct_field_template_name_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> []u8 { return catalog.struct_field_names.get_or_panic(index); }

pub fn struct_field_template_spelling_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> []u8 { return catalog.struct_field_type_names.get_or_panic(index); }

pub fn union_payload_template_len(catalog: &PackageFunctionCatalog) -> i64 {
    return catalog.union_variant_names.len();
}

pub fn declared_union_variant_start(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64
) -> i64 {
    return catalog.declared_type_union_variant_starts.get_or_panic(declaration_index);
}

pub fn declared_union_variant_len(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64
) -> i64 {
    return catalog.declared_type_union_variant_lens.get_or_panic(declaration_index);
}

pub fn declared_type_kind_at(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64
) -> i64 {
    return catalog.declared_type_kinds.get_or_panic(declaration_index);
}

pub fn declared_type_parameter_len(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64
) -> i64 {
    return catalog.declared_type_parameter_lens.get_or_panic(declaration_index);
}

pub fn declared_type_parameter_name(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64,
    parameter_index: i64
) -> ![]u8 {
    let len = declared_type_parameter_len(catalog, declaration_index);
    if parameter_index < 0 or parameter_index >= len {
        return error("declared type parameter index out of range");
    }
    let start = catalog.declared_type_parameter_starts.get_or_panic(
        declaration_index
    );
    return catalog.declared_type_parameter_names.get(start + parameter_index);
}

pub fn declared_match_variant_len(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64
) -> i64 {
    let kind = declared_type_kind_at(catalog, declaration_index);
    if kind == declared_type_enum_kind() {
        return catalog.declared_type_enum_tag_lens.get_or_panic(declaration_index);
    }
    if kind == declared_type_union_kind() {
        return declared_union_variant_len(catalog, declaration_index);
    }
    return -1;
}

pub fn declared_match_variant_exists(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64,
    variant_name: []u8
) -> bool {
    let kind = declared_type_kind_at(catalog, declaration_index);
    var start = 0;
    var len = 0;
    if kind == declared_type_enum_kind() {
        start = catalog.declared_type_enum_tag_starts.get_or_panic(declaration_index);
        len = catalog.declared_type_enum_tag_lens.get_or_panic(declaration_index);
        var enum_index = start;
        while enum_index < start + len {
            if std::mem::equal_bytes(
                catalog.enum_tag_names.get_or_panic(enum_index), variant_name
            ) { return true; }
            enum_index = enum_index + 1;
        }
        return false;
    }
    if kind != declared_type_union_kind() { return false; }
    start = declared_union_variant_start(catalog, declaration_index);
    len = declared_union_variant_len(catalog, declaration_index);
    var union_index = start;
    while union_index < start + len {
        if std::mem::equal_bytes(
            catalog.union_variant_names.get_or_panic(union_index), variant_name
        ) { return true; }
        union_index = union_index + 1;
    }
    return false;
}

pub fn declared_union_variant_has_payload(
    catalog: &PackageFunctionCatalog,
    declaration_index: i64,
    variant_name: []u8
) -> !bool {
    if declared_type_kind_at(catalog, declaration_index) !=
        declared_type_union_kind() {
        return error("declared type is not a union");
    }
    let start = declared_union_variant_start(catalog, declaration_index);
    let len = declared_union_variant_len(catalog, declaration_index);
    var index = start;
    var found = -1;
    while index < start + len {
        if std::mem::equal_bytes(
            catalog.union_variant_names.get_or_panic(index), variant_name
        ) {
            if found >= 0 { return error("duplicate package union variant"); }
            found = index;
        }
        index = index + 1;
    }
    if found < 0 { return error("package union variant not found"); }
    return std::mem::len(std::mem::trim_ascii(
        catalog.union_variant_payload_type_names.get_or_panic(found)
    )) > 0;
}

pub fn union_payload_template_component_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> i64 { return catalog.union_component_ids.get_or_panic(index); }

pub fn union_payload_template_declaration_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> i64 { return catalog.union_declaration_indices.get_or_panic(index); }

pub fn union_payload_template_name_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> []u8 { return catalog.union_variant_names.get_or_panic(index); }

pub fn union_payload_template_spelling_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> []u8 { return catalog.union_variant_payload_type_names.get_or_panic(index); }

pub struct PackageFunctionCatalog {
    component_package_names: std::array::Array<[]u8>,
    component_names: std::array::Array<[]u8>,
    component_function_starts: std::array::Array<i64>,
    component_declared_type_starts: std::array::Array<i64>,
    component_import_starts: std::array::Array<i64>,
    component_import_lens: std::array::Array<i64>,
    import_owner_component_ids: std::array::Array<i64>,
    import_alias_names: std::array::Array<[]u8>,
    import_target_component_ids: std::array::Array<i64>,
    function_component_ids: std::array::Array<i64>,
    function_local_ids: std::array::Array<i64>,
    function_names: std::array::Array<[]u8>,
    function_owner_type_names: std::array::Array<[]u8>,
    function_owner_declaration_indices: std::array::Array<i64>,
    function_return_type_names: std::array::Array<[]u8>,
    function_type_parameter_starts: std::array::Array<i64>,
    function_type_parameter_lens: std::array::Array<i64>,
    function_type_parameter_names: std::array::Array<[]u8>,
    function_param_starts: std::array::Array<i64>,
    function_param_lens: std::array::Array<i64>,
    function_params: std::array::Array<FunctionParamLayout>,
    function_name_starts: std::array::Array<i64>,
    function_name_ends: std::array::Array<i64>,
    // Stable top-level declaration ordinals, never NodeIds borrowed from a
    // temporary parsed AST.
    function_decl_ordinals: std::array::Array<i64>,
    function_method_ordinals: std::array::Array<i64>,
    // Immutable exact indexes built after registration and owner linking.
    // Zero is empty; occupied slots store function_index + 1.
    top_level_function_index: exact_name_index::ExactNameIndex,
    declared_impl_method_index: exact_name_index::ExactNameIndex,
    // One row per nominal source declaration. Unlike the field/variant tables,
    // this registry is not repeated per member and is therefore the exact
    // identity source for resolving a type spelling to its declaring component.
    declared_type_component_ids: std::array::Array<i64>,
    declared_type_names: std::array::Array<[]u8>,
    declared_type_kinds: std::array::Array<i64>,
    declared_type_parameter_starts: std::array::Array<i64>,
    declared_type_parameter_lens: std::array::Array<i64>,
    declared_type_parameter_names: std::array::Array<[]u8>,
    declared_type_struct_field_starts: std::array::Array<i64>,
    declared_type_struct_field_lens: std::array::Array<i64>,
    declared_type_enum_tag_starts: std::array::Array<i64>,
    declared_type_enum_tag_lens: std::array::Array<i64>,
    declared_type_union_variant_starts: std::array::Array<i64>,
    declared_type_union_variant_lens: std::array::Array<i64>,
    enum_tag_names: std::array::Array<[]u8>,
    struct_component_ids: std::array::Array<i64>,
    struct_declaration_indices: std::array::Array<i64>,
    struct_field_names: std::array::Array<[]u8>,
    struct_field_type_names: std::array::Array<[]u8>,
    union_component_ids: std::array::Array<i64>,
    union_declaration_indices: std::array::Array<i64>,
    union_names: std::array::Array<[]u8>,
    union_variant_names: std::array::Array<[]u8>,
    union_variant_payload_type_names: std::array::Array<[]u8>,
    next_local_ids: std::array::Array<i64>,
}

pub fn init(allocator: Allocator) -> PackageFunctionCatalog {
    return PackageFunctionCatalog {
        component_package_names: std::array::Array<[]u8>(allocator),
        component_names: std::array::Array<[]u8>(allocator),
        component_function_starts: std::array::Array<i64>(allocator),
        component_declared_type_starts: std::array::Array<i64>(allocator),
        component_import_starts: std::array::Array<i64>(allocator),
        component_import_lens: std::array::Array<i64>(allocator),
        import_owner_component_ids: std::array::Array<i64>(allocator),
        import_alias_names: std::array::Array<[]u8>(allocator),
        import_target_component_ids: std::array::Array<i64>(allocator),
        function_component_ids: std::array::Array<i64>(allocator),
        function_local_ids: std::array::Array<i64>(allocator),
        function_names: std::array::Array<[]u8>(allocator),
        function_owner_type_names: std::array::Array<[]u8>(allocator),
        function_owner_declaration_indices: std::array::Array<i64>(allocator),
        function_return_type_names: std::array::Array<[]u8>(allocator),
        function_type_parameter_starts: std::array::Array<i64>(allocator),
        function_type_parameter_lens: std::array::Array<i64>(allocator),
        function_type_parameter_names: std::array::Array<[]u8>(allocator),
        function_param_starts: std::array::Array<i64>(allocator),
        function_param_lens: std::array::Array<i64>(allocator),
        function_params: std::array::Array<FunctionParamLayout>(allocator),
        function_name_starts: std::array::Array<i64>(allocator),
        function_name_ends: std::array::Array<i64>(allocator),
        function_decl_ordinals: std::array::Array<i64>(allocator),
        function_method_ordinals: std::array::Array<i64>(allocator),
        top_level_function_index: exact_name_index::init(allocator),
        declared_impl_method_index: exact_name_index::init(allocator),
        declared_type_component_ids: std::array::Array<i64>(allocator),
        declared_type_names: std::array::Array<[]u8>(allocator),
        declared_type_kinds: std::array::Array<i64>(allocator),
        declared_type_parameter_starts: std::array::Array<i64>(allocator),
        declared_type_parameter_lens: std::array::Array<i64>(allocator),
        declared_type_parameter_names: std::array::Array<[]u8>(allocator),
        declared_type_struct_field_starts: std::array::Array<i64>(allocator),
        declared_type_struct_field_lens: std::array::Array<i64>(allocator),
        declared_type_enum_tag_starts: std::array::Array<i64>(allocator),
        declared_type_enum_tag_lens: std::array::Array<i64>(allocator),
        declared_type_union_variant_starts: std::array::Array<i64>(allocator),
        declared_type_union_variant_lens: std::array::Array<i64>(allocator),
        enum_tag_names: std::array::Array<[]u8>(allocator),
        struct_component_ids: std::array::Array<i64>(allocator),
        struct_declaration_indices: std::array::Array<i64>(allocator),
        struct_field_names: std::array::Array<[]u8>(allocator),
        struct_field_type_names: std::array::Array<[]u8>(allocator),
        union_component_ids: std::array::Array<i64>(allocator),
        union_declaration_indices: std::array::Array<i64>(allocator),
        union_names: std::array::Array<[]u8>(allocator),
        union_variant_names: std::array::Array<[]u8>(allocator),
        union_variant_payload_type_names: std::array::Array<[]u8>(allocator),
        next_local_ids: std::array::Array<i64>(allocator)
    };
}

pub fn finalize_exact_function_indexes(
    catalog: &var PackageFunctionCatalog
) -> !void {
    if exact_function_indexes_finalized(catalog) {
        return error("package function exact indexes already finalized");
    }
    var top_level_count = 0;
    var declared_method_count = 0;
    var function_index = 0;
    while function_index < catalog.function_names.len() {
        if std::mem::len(
            catalog.function_owner_type_names.get_or_panic(function_index)
        ) == 0 {
            top_level_count = top_level_count + 1;
        }
        if catalog.function_method_ordinals.get_or_panic(function_index) >= 0 and
            catalog.function_owner_declaration_indices.get_or_panic(function_index) >= 0 {
            declared_method_count = declared_method_count + 1;
        }
        function_index = function_index + 1;
    }
    try exact_name_index::finalize(
        &var catalog.top_level_function_index, top_level_count
    );
    try exact_name_index::finalize(
        &var catalog.declared_impl_method_index, declared_method_count
    );
    function_index = 0;
    while function_index < catalog.function_names.len() {
        if std::mem::len(
            catalog.function_owner_type_names.get_or_panic(function_index)
        ) == 0 {
            try insert_top_level_function_index(catalog, function_index);
        }
        if catalog.function_method_ordinals.get_or_panic(function_index) >= 0 and
            catalog.function_owner_declaration_indices.get_or_panic(function_index) >= 0 {
            try insert_declared_impl_method_index(catalog, function_index);
        }
        function_index = function_index + 1;
    }
    return;
}

pub fn finalize_collected_catalog(catalog: &var PackageFunctionCatalog) -> !void {
    if catalog.component_import_starts.len() != catalog.component_names.len() or
        catalog.component_import_lens.len() != catalog.component_names.len() {
        return error("package import collection is incomplete");
    }
    try link_function_owner_declarations(catalog);
    return finalize_exact_function_indexes(catalog);
}

fn exact_function_indexes_finalized(catalog: &PackageFunctionCatalog) -> bool {
    return exact_name_index::is_finalized(&catalog.top_level_function_index) or
        exact_name_index::is_finalized(&catalog.declared_impl_method_index);
}

fn insert_top_level_function_index(
    catalog: &var PackageFunctionCatalog,
    function_index: i64
) -> !void {
    let insertion = try exact_name_index::prepare_insert(
        &catalog.top_level_function_index,
        &catalog.function_component_ids,
        &catalog.function_names,
        function_index
    );
    if insertion.duplicate {
        return error("duplicate exact top-level function identity");
    }
    return exact_name_index::commit_insert(
        &var catalog.top_level_function_index, &insertion, function_index
    );
}

fn insert_declared_impl_method_index(
    catalog: &var PackageFunctionCatalog,
    function_index: i64
) -> !void {
    let insertion = try exact_name_index::prepare_insert(
        &catalog.declared_impl_method_index,
        &catalog.function_owner_declaration_indices,
        &catalog.function_names,
        function_index
    );
    if insertion.duplicate {
        return error("duplicate exact declared impl method identity");
    }
    return exact_name_index::commit_insert(
        &var catalog.declared_impl_method_index, &insertion, function_index
    );
}

fn link_function_owner_declarations(
    catalog: &var PackageFunctionCatalog
) -> !void {
    var function_index = 0;
    while function_index < catalog.function_names.len() {
        let owner_name = catalog.function_owner_type_names.get_or_panic(function_index);
        if std::mem::len(owner_name) > 0 {
            let component = catalog.function_component_ids.get_or_panic(function_index);
            var declaration_index = component_declared_type_start(catalog, component);
            let declaration_end = component_declared_type_end(catalog, component);
            var found = -1;
            while declaration_index < declaration_end {
                if std::mem::equal_bytes(
                    catalog.declared_type_names.get_or_panic(declaration_index),
                    owner_name
                ) {
                    if found >= 0 { return error("duplicate impl owner declaration"); }
                    found = declaration_index;
                }
                declaration_index = declaration_index + 1;
            }
            if found >= 0 {
                try catalog.function_owner_declaration_indices.set(function_index, found);
            }
        }
        function_index = function_index + 1;
    }
    return;
}

pub fn begin_component_imports(
    catalog: &var PackageFunctionCatalog,
    owner_component: i64
) -> !void {
    try require_component(catalog, owner_component);
    if owner_component != catalog.component_import_starts.len() or
        owner_component != catalog.component_import_lens.len() {
        return error("package imports must register in component order");
    }
    try catalog.component_import_starts.append(catalog.import_alias_names.len());
    return;
}

pub fn finish_component_imports(
    catalog: &var PackageFunctionCatalog,
    owner_component: i64
) -> !void {
    try require_component(catalog, owner_component);
    if catalog.component_import_starts.len() != owner_component + 1 or
        catalog.component_import_lens.len() != owner_component {
        return error("package imports must finish in component order");
    }
    let start = component_import_start(catalog, owner_component);
    try catalog.component_import_lens.append(
        catalog.import_alias_names.len() - start
    );
    return;
}

pub fn append_component_import(
    catalog: &var PackageFunctionCatalog,
    owner_component: i64,
    alias: []u8,
    target_component: i64
) -> !void {
    try require_component(catalog, owner_component);
    if catalog.component_import_starts.len() != owner_component + 1 or
        catalog.component_import_lens.len() != owner_component {
        return error("package imports must append in component order");
    }
    try require_component(catalog, target_component);
    var existing = component_import_start(catalog, owner_component);
    while existing < catalog.import_alias_names.len() {
        if std::mem::equal_bytes(
            catalog.import_alias_names.get_or_panic(existing), alias
        ) {
            if catalog.import_target_component_ids.get_or_panic(existing) ==
                target_component {
                return;
            }
            return error("conflicting package import alias");
        }
        existing = existing + 1;
    }
    try catalog.import_owner_component_ids.append(owner_component);
    try catalog.import_alias_names.append(alias);
    try catalog.import_target_component_ids.append(target_component);
    return;
}
pub fn register_struct_type(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    type_name: []u8,
    field_count: i64
) -> !i64 {
    let declaration_index = try register_declared_type(
        catalog, component_value, type_name, declared_type_struct_kind()
    );
    try catalog.declared_type_struct_field_starts.set(
        declaration_index, catalog.struct_field_names.len()
    );
    try catalog.declared_type_struct_field_lens.set(declaration_index, field_count);
    return declaration_index;
}

pub fn register_union_type(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    type_name: []u8,
    variant_count: i64
) -> !i64 {
    let declaration_index = try register_declared_type(
        catalog, component_value, type_name, declared_type_union_kind()
    );
    try catalog.declared_type_union_variant_starts.set(
        declaration_index, catalog.union_variant_names.len()
    );
    try catalog.declared_type_union_variant_lens.set(
        declaration_index, variant_count
    );
    return declaration_index;
}

pub fn register_enum_type(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    type_name: []u8,
    tag_count: i64
) -> !i64 {
    let declaration_index = try register_declared_type(
        catalog, component_value, type_name,
        declared_type_enum_kind()
    );
    try catalog.declared_type_enum_tag_starts.set(
        declaration_index, catalog.enum_tag_names.len()
    );
    try catalog.declared_type_enum_tag_lens.set(declaration_index, tag_count);
    return declaration_index;
}

fn register_declared_type(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    type_name: []u8,
    kind: i64
) -> !i64 {
    if (component_value + 1) != catalog.component_names.len() {
        return error("package types must register contiguously by component");
    }
    var index = component_declared_type_start(catalog, component_value);
    while index < catalog.declared_type_names.len() {
        if std::mem::equal_bytes(
            catalog.declared_type_names.get_or_panic(index), type_name
        ) {
            return error("duplicate package type declaration");
        }
        index = index + 1;
    }
    try catalog.declared_type_component_ids.append(component_value);
    try catalog.declared_type_names.append(type_name);
    try catalog.declared_type_kinds.append(kind);
    try catalog.declared_type_parameter_starts.append(
        catalog.declared_type_parameter_names.len()
    );
    try catalog.declared_type_parameter_lens.append(0);
    try catalog.declared_type_struct_field_starts.append(0);
    try catalog.declared_type_struct_field_lens.append(0);
    try catalog.declared_type_enum_tag_starts.append(0);
    try catalog.declared_type_enum_tag_lens.append(0);
    try catalog.declared_type_union_variant_starts.append(0);
    try catalog.declared_type_union_variant_lens.append(0);
    return catalog.declared_type_names.len() - 1;
}

pub fn append_declared_type_parameter(
    catalog: &var PackageFunctionCatalog,
    declaration_index: i64,
    name: []u8
) -> !void {
    if declaration_index < 0 or declaration_index >= catalog.declared_type_names.len() {
        return error("declared type parameter owner index out of range");
    }
    if declaration_index + 1 != catalog.declared_type_names.len() {
        return error("declared type parameters must register with their owner");
    }
    let start = catalog.declared_type_parameter_starts.get_or_panic(
        declaration_index
    );
    let len = catalog.declared_type_parameter_lens.get_or_panic(
        declaration_index
    );
    if start + len != catalog.declared_type_parameter_names.len() {
        return error("declared type parameters must register contiguously");
    }
    var parameter = start;
    while parameter < start + len {
        if std::mem::equal_bytes(
            catalog.declared_type_parameter_names.get_or_panic(parameter), name
        ) {
            return error("duplicate declared type parameter");
        }
        parameter = parameter + 1;
    }
    try catalog.declared_type_parameter_names.append(name);
    try catalog.declared_type_parameter_lens.set(declaration_index, len + 1);
    return;
}

pub fn append_enum_tag(
    catalog: &var PackageFunctionCatalog,
    declaration_index: i64,
    tag: []u8
) -> !void {
    let start = catalog.declared_type_enum_tag_starts.get_or_panic(declaration_index);
    var index = start;
    while index < catalog.enum_tag_names.len() {
        if std::mem::equal_bytes(catalog.enum_tag_names.get_or_panic(index), tag) {
            return error("duplicate package enum tag");
        }
        index = index + 1;
    }
    try catalog.enum_tag_names.append(tag);
    return;
}

pub fn append_function_type_parameter(
    catalog: &var PackageFunctionCatalog,
    function_index: i64,
    name: []u8
) -> !void {
    let start = catalog.function_type_parameter_starts.get_or_panic(function_index);
    let len = catalog.function_type_parameter_lens.get_or_panic(function_index);
    if start + len != catalog.function_type_parameter_names.len() {
        return error("package function type parameters must register contiguously");
    }
    var parameter = start;
    while parameter < start + len {
        if std::mem::equal_bytes(
            catalog.function_type_parameter_names.get_or_panic(parameter), name
        ) {
            return error("duplicate package type parameter");
        }
        parameter = parameter + 1;
    }
    try catalog.function_type_parameter_names.append(name);
    try catalog.function_type_parameter_lens.set(function_index, len + 1);
    return;
}

pub fn append_function_param_layout(
    catalog: &var PackageFunctionCatalog,
    function_index: i64,
    name: []u8,
    type_spelling: []u8,
    comptime_param: bool
) -> !void {
    if function_index < 0 or function_index >= catalog.function_names.len() {
        return error("function parameter owner index out of range");
    }
    let start = catalog.function_param_starts.get_or_panic(function_index);
    let len = catalog.function_param_lens.get_or_panic(function_index);
    if start + len != catalog.function_params.len() {
        return error("package function parameters must register contiguously");
    }
    var existing = start;
    while existing < start + len {
        if std::mem::equal_bytes(
            try function_param_name(catalog, function_index, existing - start),
            name
        ) {
            return error("duplicate package function parameter");
        }
        existing = existing + 1;
    }
    var mode = function_param_runtime_mode();
    if comptime_param { mode = function_param_comptime_mode(); }
    let is_receiver = std::mem::equal_bytes(name, "self");
    if is_receiver and len != 0 {
        return error("function receiver parameter must be first");
    }
    var runtime_ordinal = -1;
    if mode == function_param_runtime_mode() {
        runtime_ordinal = 0;
        var runtime_index = start;
        while runtime_index < start + len {
            if try function_param_mode(
                catalog, function_index, runtime_index - start
            ) == function_param_runtime_mode() {
                runtime_ordinal = runtime_ordinal + 1;
            }
            runtime_index = runtime_index + 1;
        }
    }
    try catalog.function_params.append(FunctionParamLayout {
        function_index: function_index,
        ordinal: len,
        name: name,
        type_spelling: type_spelling,
        mode: mode,
        is_receiver: is_receiver,
        runtime_ordinal: runtime_ordinal
    });
    try catalog.function_param_lens.set(function_index, len + 1);
    return;
}

pub fn append_union_variant(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    declaration_index: i64,
    union_name: []u8,
    variant_name: []u8,
    payload_type_name: []u8
) -> !void {
    if declaration_index < 0 or declaration_index >= catalog.declared_type_names.len() or
        declared_type_kind_at(catalog, declaration_index) != declared_type_union_kind() {
        return error("union variant owner is not a declared union");
    }
    let start = declared_union_variant_start(catalog, declaration_index);
    let appended = catalog.union_variant_names.len() - start;
    if appended < 0 or appended >= declared_union_variant_len(catalog, declaration_index) {
        return error("union variants must register in declared owner order");
    }
    var index = start;
    while index < catalog.union_variant_names.len() {
        if catalog.union_declaration_indices.get_or_panic(index) != declaration_index {
            return error("union variant owner rows are not contiguous");
        }
        if std::mem::equal_bytes(
            catalog.union_variant_names.get_or_panic(index), variant_name
        ) {
            return error("duplicate package union variant");
        }
        index = index + 1;
    }
    try catalog.union_component_ids.append(component_value);
    try catalog.union_declaration_indices.append(declaration_index);
    try catalog.union_names.append(union_name);
    try catalog.union_variant_names.append(variant_name);
    try catalog.union_variant_payload_type_names.append(payload_type_name);
    return;
}

pub fn append_struct_field(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    declaration_index: i64,
    field_name: []u8,
    field_type_name: []u8
) -> !void {
    if declaration_index < 0 or declaration_index >= catalog.declared_type_names.len() or
        declared_type_kind_at(catalog, declaration_index) != declared_type_struct_kind() {
        return error("struct field owner is not a declared struct");
    }
    let start = declared_struct_field_start(catalog, declaration_index);
    let appended = catalog.struct_field_names.len() - start;
    if appended < 0 or appended >= declared_struct_field_len(catalog, declaration_index) {
        return error("struct fields must register in declared owner order");
    }
    var index = start;
    while index < catalog.struct_field_names.len() {
        if catalog.struct_declaration_indices.get_or_panic(index) != declaration_index {
            return error("struct field owner rows are not contiguous");
        }
        if std::mem::equal_bytes(
            catalog.struct_field_names.get_or_panic(index), field_name
        ) {
            return error("duplicate package struct field");
        }
        index = index + 1;
    }
    try catalog.struct_component_ids.append(component_value);
    try catalog.struct_declaration_indices.append(declaration_index);
    try catalog.struct_field_names.append(field_name);
    try catalog.struct_field_type_names.append(field_type_name);
    return;
}

// register_component assigns a stable dense ID in parsed package order.
pub fn register_component(
    catalog: &var PackageFunctionCatalog,
    package_name: []u8,
    component_name: []u8
) -> !i64 {
    if exact_function_indexes_finalized(catalog) {
        return error("package function catalog already finalized");
    }
    if find_component(catalog, package_name, component_name) >= 0 {
        return error("duplicate package component");
    }
    let id = catalog.component_names.len();
    try catalog.component_package_names.append(package_name);
    try catalog.component_names.append(component_name);
    try catalog.component_function_starts.append(catalog.function_names.len());
    try catalog.component_declared_type_starts.append(
        catalog.declared_type_names.len()
    );
    try catalog.next_local_ids.append(0);
    return id;
}

// register_function assigns a dense per-component ID in parsed declaration
// order. The node is retained so codegen can emit the exact resolved definition.
pub fn register_function(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    local_name: []u8,
    owner_type_name: []u8,
    return_type_name: []u8,
    declaration_ordinal: i64,
    method_ordinal: i64,
    name_start: i64,
    name_end: i64
) -> !package_function_identity::FunctionTarget {
    if exact_function_indexes_finalized(catalog) {
        return error("package function catalog already finalized");
    }
    try require_component(catalog, component_value);
    if (component_value + 1) != catalog.component_names.len() {
        return error("package functions must register contiguously by component");
    }
    if find_owned_function(catalog, component_value, owner_type_name, local_name) >= 0 {
        return error("duplicate package function");
    }
    let local_id = try catalog.next_local_ids.get(component_value);
    if catalog.function_names.len() !=
        component_function_start(catalog, component_value) + local_id {
        return error("package function component range is not contiguous");
    }
    if name_start < 0 or name_end <= name_start {
        return error("package function name span is invalid");
    }
    if local_id > 0 {
        let previous = catalog.function_names.len() - 1;
        let previous_start = catalog.function_name_starts.get_or_panic(previous);
        let previous_end = catalog.function_name_ends.get_or_panic(previous);
        if name_start <= previous_start {
            return error("package function name spans must register in source order");
        }
        if name_start < previous_end {
            return error("package function name spans must not overlap");
        }
    }
    try catalog.next_local_ids.set(component_value, local_id + 1);
    try catalog.function_component_ids.append(component_value);
    try catalog.function_local_ids.append(local_id);
    try catalog.function_names.append(local_name);
    try catalog.function_owner_type_names.append(owner_type_name);
    try catalog.function_owner_declaration_indices.append(-1);
    try catalog.function_return_type_names.append(return_type_name);
    try catalog.function_type_parameter_starts.append(
        catalog.function_type_parameter_names.len()
    );
    try catalog.function_type_parameter_lens.append(0);
    try catalog.function_param_starts.append(catalog.function_params.len());
    try catalog.function_param_lens.append(0);
    try catalog.function_name_starts.append(name_start);
    try catalog.function_name_ends.append(name_end);
    try catalog.function_decl_ordinals.append(declaration_ordinal);
    try catalog.function_method_ordinals.append(method_ordinal);
    return package_function_identity::FunctionTarget {
        component: package_function_identity::ComponentId { value: component_value },
        function: package_function_identity::FunctionId { value: local_id }
    };
}

pub fn target_slot(catalog: &PackageFunctionCatalog, target: package_function_identity::FunctionTarget) -> !i64 {
    let component_value = package_function_identity::target_component_value(&target);
    let function_value = package_function_identity::target_function_value(&target);
    try require_component(catalog, component_value);
    let slot = try catalog.component_function_starts.get(component_value) + function_value;
    if slot < 0 or slot >= catalog.function_names.len() or
        try catalog.function_component_ids.get(slot) != component_value or
        try catalog.function_local_ids.get(slot) != function_value {
        return error("resolved function target not found");
    }
    return slot;
}


fn find_component(
    catalog: &PackageFunctionCatalog,
    package_name: []u8,
    name: []u8
) -> i64 {
    var index = 0;
    while index < catalog.component_names.len() {
        if std::mem::equal_bytes(
            catalog.component_package_names.get_or_panic(index), package_name
        ) and std::mem::equal_bytes(catalog.component_names.get_or_panic(index), name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn component_function_start(
    catalog: &PackageFunctionCatalog,
    component_value: i64
) -> i64 {
    return catalog.component_function_starts.get_or_panic(component_value);
}

fn component_function_end(
    catalog: &PackageFunctionCatalog,
    component_value: i64
) -> i64 {
    if component_value + 1 < catalog.component_function_starts.len() {
        return catalog.component_function_starts.get_or_panic(component_value + 1);
    }
    return catalog.function_names.len();
}

fn component_declared_type_start(
    catalog: &PackageFunctionCatalog,
    component_value: i64
) -> i64 {
    return catalog.component_declared_type_starts.get_or_panic(component_value);
}

fn component_declared_type_end(
    catalog: &PackageFunctionCatalog,
    component_value: i64
) -> i64 {
    if component_value + 1 < catalog.component_declared_type_starts.len() {
        return catalog.component_declared_type_starts.get_or_panic(
            component_value + 1
        );
    }
    return catalog.declared_type_names.len();
}

fn component_import_start(
    catalog: &PackageFunctionCatalog,
    component_value: i64
) -> i64 {
    return catalog.component_import_starts.get_or_panic(component_value);
}

fn component_import_end(
    catalog: &PackageFunctionCatalog,
    component_value: i64
) -> i64 {
    return component_import_start(catalog, component_value) +
        catalog.component_import_lens.get_or_panic(component_value);
}

fn find_owned_function(catalog: &PackageFunctionCatalog, component_value: i64, owner: []u8, name: []u8) -> i64 {
    if component_value < 0 or component_value >= catalog.component_names.len() {
        return -1;
    }
    var index = component_function_start(catalog, component_value);
    let end = component_function_end(catalog, component_value);
    while index < end {
        if std::mem::equal_bytes(catalog.function_owner_type_names.get_or_panic(index), owner) and
            std::mem::equal_bytes(catalog.function_names.get_or_panic(index), name) { return index; }
        index = index + 1;
    }
    return -1;
}

pub fn target_at_entry(catalog: &PackageFunctionCatalog, index: i64) -> !package_function_identity::FunctionTarget {
    return package_function_identity::FunctionTarget {
        component: package_function_identity::ComponentId { value: try catalog.function_component_ids.get(index) },
        function: package_function_identity::FunctionId { value: try catalog.function_local_ids.get(index) }
    };
}

fn require_component(catalog: &PackageFunctionCatalog, component_value: i64) -> !void {
    if component_value < 0 or component_value >= catalog.component_names.len() {
        return error("package component id out of range");
    }
    return;
}

impl PackageFunctionCatalog {
    fn deinit(self: PackageFunctionCatalog) -> void {
        self.component_package_names.deinit();
        self.component_names.deinit();
        self.component_function_starts.deinit();
        self.component_declared_type_starts.deinit();
        self.component_import_starts.deinit();
        self.component_import_lens.deinit();
        self.import_owner_component_ids.deinit();
        self.import_alias_names.deinit();
        self.import_target_component_ids.deinit();
        self.function_component_ids.deinit();
        self.function_local_ids.deinit();
        self.function_names.deinit();
        self.function_owner_type_names.deinit();
        self.function_owner_declaration_indices.deinit();
        self.function_return_type_names.deinit();
        self.function_type_parameter_starts.deinit();
        self.function_type_parameter_lens.deinit();
        self.function_type_parameter_names.deinit();
        self.function_param_starts.deinit();
        self.function_param_lens.deinit();
        self.function_params.deinit();
        self.function_name_starts.deinit();
        self.function_name_ends.deinit();
        self.function_decl_ordinals.deinit();
        self.function_method_ordinals.deinit();
        self.top_level_function_index.deinit();
        self.declared_impl_method_index.deinit();
        self.declared_type_component_ids.deinit();
        self.declared_type_names.deinit();
        self.declared_type_kinds.deinit();
        self.declared_type_parameter_starts.deinit();
        self.declared_type_parameter_lens.deinit();
        self.declared_type_parameter_names.deinit();
        self.declared_type_struct_field_starts.deinit();
        self.declared_type_struct_field_lens.deinit();
        self.declared_type_enum_tag_starts.deinit();
        self.declared_type_enum_tag_lens.deinit();
        self.declared_type_union_variant_starts.deinit();
        self.declared_type_union_variant_lens.deinit();
        self.enum_tag_names.deinit();
        self.struct_component_ids.deinit();
        self.struct_declaration_indices.deinit();
        self.struct_field_names.deinit();
        self.struct_field_type_names.deinit();
        self.union_component_ids.deinit();
        self.union_declaration_indices.deinit();
        self.union_names.deinit();
        self.union_variant_names.deinit();
        self.union_variant_payload_type_names.deinit();
        self.next_local_ids.deinit();
        return;
    }
}



// Stable read-only row boundaries for exact lookup and graph emission.
pub fn component_by_name(catalog: &PackageFunctionCatalog, package_name: []u8, component_name: []u8) -> i64 {
    return find_component(catalog, package_name, component_name);
}
pub fn component_package_name_at(catalog: &PackageFunctionCatalog, component: i64) -> []u8 {
    return catalog.component_package_names.get_or_panic(component);
}
pub fn component_name_at(catalog: &PackageFunctionCatalog, component: i64) -> []u8 {
    return catalog.component_names.get_or_panic(component);
}
pub fn component_function_start_at(catalog: &PackageFunctionCatalog, component: i64) -> i64 {
    return component_function_start(catalog, component);
}
pub fn component_function_end_at(catalog: &PackageFunctionCatalog, component: i64) -> i64 {
    return component_function_end(catalog, component);
}
pub fn component_declared_type_start_at(catalog: &PackageFunctionCatalog, component: i64) -> i64 {
    return component_declared_type_start(catalog, component);
}
pub fn component_declared_type_end_at(catalog: &PackageFunctionCatalog, component: i64) -> i64 {
    return component_declared_type_end(catalog, component);
}
pub fn component_import_start_at(catalog: &PackageFunctionCatalog, component: i64) -> i64 {
    return component_import_start(catalog, component);
}
pub fn component_import_end_at(catalog: &PackageFunctionCatalog, component: i64) -> i64 {
    return component_import_end(catalog, component);
}
pub fn import_alias_at(catalog: &PackageFunctionCatalog, index: i64) -> []u8 {
    return catalog.import_alias_names.get_or_panic(index);
}
pub fn import_len(catalog: &PackageFunctionCatalog) -> i64 {
    return catalog.import_alias_names.len();
}
pub fn import_owner_component_at(catalog: &PackageFunctionCatalog, index: i64) -> i64 {
    return catalog.import_owner_component_ids.get_or_panic(index);
}
pub fn import_target_component_at(catalog: &PackageFunctionCatalog, index: i64) -> i64 {
    return catalog.import_target_component_ids.get_or_panic(index);
}
pub fn function_name_at(catalog: &PackageFunctionCatalog, index: i64) -> []u8 {
    return catalog.function_names.get_or_panic(index);
}
pub fn function_local_id_at(catalog: &PackageFunctionCatalog, index: i64) -> i64 {
    return catalog.function_local_ids.get_or_panic(index);
}
pub fn function_name_start_at(catalog: &PackageFunctionCatalog, index: i64) -> i64 {
    return catalog.function_name_starts.get_or_panic(index);
}
pub fn function_name_end_at(catalog: &PackageFunctionCatalog, index: i64) -> i64 {
    return catalog.function_name_ends.get_or_panic(index);
}
pub fn function_declaration_ordinal_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> i64 { return catalog.function_decl_ordinals.get_or_panic(index); }
pub fn function_method_ordinal_at(
    catalog: &PackageFunctionCatalog,
    index: i64
) -> i64 { return catalog.function_method_ordinals.get_or_panic(index); }
pub fn declared_type_len(catalog: &PackageFunctionCatalog) -> i64 {
    return catalog.declared_type_names.len();
}
pub fn declared_type_name_at(catalog: &PackageFunctionCatalog, index: i64) -> []u8 {
    return catalog.declared_type_names.get_or_panic(index);
}
pub fn declared_type_component_at(catalog: &PackageFunctionCatalog, index: i64) -> i64 {
    return catalog.declared_type_component_ids.get_or_panic(index);
}
pub fn union_variant_name_at(catalog: &PackageFunctionCatalog, index: i64) -> []u8 {
    return catalog.union_variant_names.get_or_panic(index);
}
