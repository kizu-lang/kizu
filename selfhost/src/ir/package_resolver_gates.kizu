fn resolver_test_file(id: i64, module: []u8, text: []u8) -> source::SourceFile {
    return source::SourceFile {
        id: id,
        kind: source::SourceKind::Selfhost,
        package_name: "selfhost",
        module_start: 0,
        module_end: std::mem::len(module),
        path: module,
        text: text
    };
}

fn resolver_std_test_file(id: i64, module: []u8, text: []u8) -> source::SourceFile {
    return source::SourceFile {
        id: id,
        kind: source::SourceKind::Std,
        package_name: "std",
        module_start: 0,
        module_end: std::mem::len(module),
        path: module,
        text: text
    };
}

fn resolve_test_files(allocator: Allocator, files: &std::array::Array<source::SourceFile>) -> !package_call_facts::ResolvedCallTargets {
    var parsed = try parser::parse_source_files(allocator, files);
    var catalog = try package_catalog_collect::collect_from_parsed_files(
        allocator, files, &parsed
    );
    defer catalog.deinit();
    let calls = try package_call_resolution::resolve_package_calls(
        allocator, files, &parsed, &catalog
    );
    try parser::deinit_parsed_source_files(parsed);
    return calls;
}

fn expect_single_builtin_operation(
    calls: &package_call_facts::ResolvedCallTargets,
    operation: []u8
) -> !void {
    std::testing::expect_equal<i64>(0, package_call_facts::resolved_call_len(calls));
    std::testing::expect_equal<i64>(1, package_call_facts::builtin_call_len(calls));
    std::testing::expect_equal<[]u8>(
        operation, try package_call_facts::builtin_call_operation_name(calls, 0)
    );
    return;
}

pub fn package_generic_owner_identity_canonical_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var catalog = package_catalog::init(allocator);
    defer catalog.deinit();
    let component = try package_catalog::register_component(
        &var catalog, "std", "map"
    );
    try package_catalog::begin_component_imports(&var catalog, component);
    try package_catalog::finish_component_imports(&var catalog, component);
    let target = try package_catalog::register_function(
        &var catalog, component, "get", "std::map::Map<[]u8, V>",
        "V", 0, 0, 0, 3
    );
    try package_catalog::append_function_type_parameter(&var catalog, 0, "V");
    try package_catalog::finalize_collected_catalog(&var catalog);

    let slot = try package_catalog::target_slot(
        &catalog, package_function_identity::copy_function_target(&target)
    );
    let resolved = try package_catalog::target_at_entry(&catalog, slot);
    std::testing::expect(package_function_identity::same_target(
        package_function_identity::copy_function_target(&target),
        package_function_identity::copy_function_target(&resolved)
    ));

    var qualified = std::string::String(allocator);
    defer qualified.deinit();
    try package_dependency_graph::append_target_qualified_name(
        &var qualified, &catalog,
        package_function_identity::copy_function_target(&resolved)
    );
    let qualified_bytes = qualified.as_bytes();
    std::testing::expect_equal<[]u8>(
        "std::map::std::map::_map<[]u8,_v>_get", qualified_bytes
    );

    var facts = std::string::String(allocator);
    defer facts.deinit();
    try package_dependency_graph::append_function_owner_module_facts(
        &var facts, &catalog
    );
    try package_dependency_graph::append_function_type_parameter_facts(
        &var facts, &catalog
    );
    let fact_bytes = facts.as_bytes();
    std::testing::expect_equal<[]u8>(
        "function-owner-module std::map::std::map::_map<[]u8,_v>_get std::map::
function-type-parameter std::map::std::map::_map<[]u8,_v>_get 0 V
",
        fact_bytes
    );
    return;
}

pub fn package_type_store_structural_interning_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var catalog = package_catalog::init(allocator);
    defer catalog.deinit();
    let component = try package_catalog::register_component(
        &var catalog, "selfhost", "resolver/type_intern"
    );
    let other_component = try package_catalog::register_component(
        &var catalog, "selfhost", "resolver/type_intern_other"
    );
    try package_catalog::begin_component_imports(&var catalog, component);
    try package_catalog::finish_component_imports(&var catalog, component);
    try package_catalog::begin_component_imports(&var catalog, other_component);
    try package_catalog::finish_component_imports(&var catalog, other_component);
    var store = try package_type_resolution::type_store(allocator, &catalog);
    defer store.deinit();
    var environment = package_type_environment::environment(allocator);
    defer environment.deinit();
    let first_leaf = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "i64", &var store, &environment
    );
    let second_leaf = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "i64", &var store, &environment
    );
    let first_generic = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "std::array::Array<i64>", &var store, &environment
    );
    let second_generic = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "std::array::Array<i64>", &var store, &environment
    );
    let other_leaf = try package_type_template_resolution::resolve_in_environment(
        &catalog, other_component, "i64", &var store, &environment
    );
    let other_generic = try package_type_template_resolution::resolve_in_environment(
        &catalog, other_component, "std::array::Array<i64>", &var store, &environment
    );
    let bool_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "bool", &var store, &environment
    );
    let i8_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "i8", &var store, &environment
    );
    let i16_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "i16", &var store, &environment
    );
    let i32_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "i32", &var store, &environment
    );
    let u8_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "u8", &var store, &environment
    );
    let u16_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "u16", &var store, &environment
    );
    let u32_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "u32", &var store, &environment
    );
    let u64_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "u64", &var store, &environment
    );
    let usize_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "usize", &var store, &environment
    );
    let isize_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "isize", &var store, &environment
    );
    let f32_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "f32", &var store, &environment
    );
    let f64_type = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "f64", &var store, &environment
    );
    let generic_after_rehash = try package_type_template_resolution::resolve_in_environment(
        &catalog, component, "std::array::Array<i64>", &var store, &environment
    );
    std::testing::expect_equal<i64>(first_leaf.type_id, second_leaf.type_id);
    std::testing::expect_equal<i64>(first_generic.type_id, second_generic.type_id);
    std::testing::expect_equal<i64>(first_generic.type_id, generic_after_rehash.type_id);
    std::testing::expect(first_leaf.type_id != other_leaf.type_id);
    std::testing::expect(first_generic.type_id != other_generic.type_id);
    std::testing::expect(bool_type.type_id != i8_type.type_id);
    std::testing::expect(i16_type.type_id != i32_type.type_id);
    std::testing::expect(u8_type.type_id != u16_type.type_id);
    std::testing::expect(u32_type.type_id != u64_type.type_id);
    std::testing::expect(usize_type.type_id != isize_type.type_id);
    std::testing::expect(f32_type.type_id != f64_type.type_id);
    std::testing::expect(try package_type_resolution::same_type(
        &store, &first_generic, &second_generic
    ));
    std::testing::expect(try package_type_resolution::same_type(
        &store, &first_generic, &other_generic
    ));
    return;
}

pub fn package_catalog_dense_function_range_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var catalog = package_catalog::init(allocator);
    defer catalog.deinit();
    let first = try package_catalog::register_component(
        &var catalog, "selfhost", "resolver/dense_first"
    );
    let root = try package_catalog::register_function(
        &var catalog, first,
        "root", "", "void", 0, -1, 10, 14
    );
    let touch = try package_catalog::register_function(
        &var catalog, first,
        "touch", "Owner", "void", 1, 0, 20, 25
    );
    let second = try package_catalog::register_component(
        &var catalog, "selfhost", "resolver/dense_second"
    );
    let worker = try package_catalog::register_function(
        &var catalog, second, "worker", "", "void", 0, -1, 30, 36
    );
    try package_catalog::finalize_exact_function_indexes(&var catalog);
    let resolved_root = try package_exact_lookup::resolve_call(
        &catalog, "selfhost", "resolver/dense_first", "root"
    );
    let resolved_touch = try package_catalog::target_at_entry(
        &catalog, package_catalog::component_function_start_at(
            &catalog, first
        ) + 1
    );
    let resolved_worker = try package_exact_lookup::exact_qualified_function_target(
        &catalog, "selfhost::resolver::dense_second::worker"
    );
    std::testing::expect(package_function_identity::same_target(root, resolved_root));
    std::testing::expect(package_function_identity::same_target(touch, resolved_touch));
    std::testing::expect(package_function_identity::same_target(worker, resolved_worker));
    return;
}

pub fn package_catalog_function_span_binary_search_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(resolver_test_file(
        0, "resolver/span_binary",
        "fn first() -> void {} struct Item {} impl Item { fn middle_a(self: Item) -> void {} fn middle_b(self: Item) -> void {} } fn last() -> void {}"
    ));
    var parsed = try parser::parse_source_files(allocator, &files);
    var catalog = try package_catalog_collect::collect_from_parsed_files(
        allocator, &files, &parsed
    );
    defer catalog.deinit();
    let component = package_catalog::component_by_name(
        &catalog, "selfhost", "resolver/span_binary"
    );
    let first = package_catalog::component_function_start_at(&catalog, component);
    let function_end = package_catalog::component_function_end_at(&catalog, component);
    let middle_a = first + 1;
    let middle_b = first + 2;
    let last = function_end - 1;
    std::testing::expect_equal<i64>(4, function_end - first);
    std::testing::expect(!package_catalog::function_is_impl_method_at(
        &catalog, first
    ));
    std::testing::expect(package_catalog::function_is_impl_method_at(
        &catalog, middle_a
    ));
    std::testing::expect(package_catalog::function_is_impl_method_at(
        &catalog, middle_b
    ));
    std::testing::expect(!package_catalog::function_is_impl_method_at(
        &catalog, last
    ));
    std::testing::expect_equal<i64>(
        first,
        package_exact_lookup::function_entry_by_name_span(
            &catalog, component,
            package_catalog::function_name_start_at(&catalog, first),
            package_catalog::function_name_end_at(&catalog, first)
        )
    );
    std::testing::expect_equal<i64>(
        middle_b,
        package_exact_lookup::function_entry_by_name_span(
            &catalog, component,
            package_catalog::function_name_start_at(&catalog, middle_b),
            package_catalog::function_name_end_at(&catalog, middle_b)
        )
    );
    std::testing::expect_equal<i64>(
        last,
        package_exact_lookup::function_entry_by_name_span(
            &catalog, component,
            package_catalog::function_name_start_at(&catalog, last),
            package_catalog::function_name_end_at(&catalog, last)
        )
    );
    std::testing::expect_equal<i64>(
        -1,
        package_exact_lookup::function_entry_by_name_span(
            &catalog, component,
            package_catalog::function_name_start_at(&catalog, middle_a) + 1,
            package_catalog::function_name_end_at(&catalog, middle_a)
        )
    );
    std::testing::expect_equal<i64>(
        -1,
        package_exact_lookup::function_entry_by_name_span(
            &catalog, component,
            package_catalog::function_name_start_at(&catalog, middle_a),
            package_catalog::function_name_end_at(&catalog, middle_a) + 1
        )
    );
    try parser::deinit_parsed_source_files(parsed);
    return;
}

