}

pub fn package_catalog_exact_index_corrupt_row_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var owner_ids = std::array::Array<i64>(allocator);
    defer owner_ids.deinit();
    var names = std::array::Array<[]u8>(allocator);
    defer names.deinit();
    try owner_ids.append(7);
    try names.append("a");

    var index = exact_name_index::init(allocator);
    defer index.deinit();
    try exact_name_index::finalize(&var index, 1);
    let insertion = try exact_name_index::prepare_insert(
        &index, &owner_ids, &names, 0
    );
    try exact_name_index::commit_insert(&var index, &insertion, 0);

    var missing_owner_ids = std::array::Array<i64>(allocator);
    defer missing_owner_ids.deinit();
    var missing_names = std::array::Array<[]u8>(allocator);
    defer missing_names.deinit();
    let entry = try exact_name_index::lookup(
        &index, &missing_owner_ids, &missing_names, 7, "a"
    );
    return;
}

pub fn package_catalog_exact_index_capacity_overflow_gate() -> !void {
    let maximum = 144115188075855872;
    std::testing::expect_equal<i64>(16, try exact_name_index::capacity(0));
    std::testing::expect_equal<i64>(
        maximum, try exact_name_index::capacity(maximum / 2)
    );
    let overflow = try exact_name_index::capacity(maximum / 2 + 1);
    return;
}

