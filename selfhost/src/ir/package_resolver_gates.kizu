pub fn package_resolver_owned_constructor_descriptor_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(resolver_std_test_file(
        0,
        "array",
        "pub fn Array<T>(allocator: Allocator) -> std::array::Array<T> { return std::builtin::array<T>(allocator); }"
    ));
    try files.append(resolver_std_test_file(
        1,
        "map",
        "pub fn Map<K,V>(allocator: Allocator) -> std::map::Map<K,V> { return std::builtin::map<K,V>(allocator); }"
    ));
    try files.append(resolver_test_file(
        2,
        "resolver/owned_constructor",
        "fn make<T>(allocator: Allocator) -> std::array::Array<T> { return std::array::Array<T>(allocator); } fn root(allocator: Allocator) -> void { let direct = std::array::Array<i64>(allocator); let arena = std::arena::Arena<u8>(allocator); let map = std::map::Map<[]u8,i64>(allocator); let indirect = make<i64>(allocator); }"
    ));
    var calls = try resolve_test_files(allocator, &files);
    defer calls.deinit();
    // The Array call inside make and the direct root call are nominal constructors.
    // The root call to make returns Array but is deliberately not a constructor.
    // Arena is a direct external-shape constructor.
    std::testing::expect_equal<i64>(4, package_call_facts::owned_constructor_len(&calls));
    std::testing::expect_equal<i64>(
        builtin_contract::owned_container_action_construct(),
        try package_call_facts::owned_constructor_action(&calls, 0)
    );
    std::testing::expect_equal<[]u8>(
        "T", try package_call_facts::owned_constructor_type_argument(&calls, 0, 0)
    );
    std::testing::expect_equal<i64>(
        builtin_contract::owned_container_action_construct(),
        try package_call_facts::owned_constructor_action(&calls, 1)
    );
    std::testing::expect_equal<[]u8>(
        "i64", try package_call_facts::owned_constructor_type_argument(&calls, 1, 0)
    );
    std::testing::expect_equal<i64>(
        builtin_contract::owned_container_action_construct(),
        try package_call_facts::owned_constructor_action(&calls, 2)
    );
    std::testing::expect_equal<[]u8>(
        "u8", try package_call_facts::owned_constructor_type_argument(&calls, 2, 0)
    );
    std::testing::expect_equal<i64>(
        2, try package_call_facts::owned_constructor_type_argument_len(&calls, 3)
    );
    std::testing::expect_equal<[]u8>(
        "[]u8", try package_call_facts::owned_constructor_type_argument(&calls, 3, 0)
    );
    std::testing::expect_equal<[]u8>(
        "i64", try package_call_facts::owned_constructor_type_argument(&calls, 3, 1)
    );
    return;
}

