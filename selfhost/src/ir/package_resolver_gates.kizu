    ));
    var parsed = try parser::parse_source_files(allocator, &files);
    var catalog = try package_catalog_collect::collect_from_parsed_files(
        allocator, &files, &parsed
    );
    defer catalog.deinit();
    let function_index = 0;
    std::testing::expect_equal<i64>(4, package_catalog::function_param_len(
        &catalog, function_index
    ));
    std::testing::expect_equal<[]u8>(
        "schema", try package_catalog::function_param_name(
            &catalog, function_index, 1
        )
    );
    std::testing::expect_equal<[]u8>(
        "T", try package_catalog::function_param_type_spelling(
            &catalog, function_index, 1
        )
    );
    std::testing::expect_equal<i64>(
        package_catalog::function_param_comptime_mode(),
        try package_catalog::function_param_mode(&catalog, function_index, 1)
    );
    std::testing::expect(try package_catalog::function_param_is_receiver(
