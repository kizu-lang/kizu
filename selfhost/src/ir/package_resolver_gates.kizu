pub fn package_resolver_channel_recv_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(resolver_test_file(
        0, "resolver/channel_recv",
        "struct Model { value: i64, }
fn root_models(channel: Channel<std::array::Array<Model>>) -> void { let items = channel.recv(); }
fn root_bytes(channel: Channel<[]u8>) -> void { let bytes = channel.recv(); }"
    ));
    var calls = try resolve_test_files(allocator, &files);
    defer calls.deinit();
    std::testing::expect_equal<i64>(0, package_call_facts::resolved_call_len(&calls));
    std::testing::expect_equal<i64>(2, package_call_facts::builtin_call_len(&calls));
    std::testing::expect_equal<[]u8>(
        "channel-recv", try package_call_facts::builtin_call_operation_name(&calls, 0)
    );
    std::testing::expect_equal<[]u8>(
        "channel-recv", try package_call_facts::builtin_call_operation_name(&calls, 1)
    );
    std::testing::expect_equal<i64>(
        2, package_call_facts::call_type_len(&calls)
    );
    let models_actual_len = try package_call_facts::call_type_actual_len(
        &calls, 0
    );
    let bytes_actual_len = try package_call_facts::call_type_actual_len(
        &calls, 1
    );
    std::testing::expect_equal<i64>(1, models_actual_len);
    std::testing::expect_equal<i64>(1, bytes_actual_len);
    let models_actual = try package_call_facts::call_type_actual(&calls, 0, 0);
    let bytes_actual = try package_call_facts::call_type_actual(&calls, 1, 0);
    std::testing::expect(models_actual != bytes_actual);
    std::testing::expect_equal<i64>(
        models_actual, try package_call_facts::call_type_result(&calls, 0)
    );
    std::testing::expect_equal<i64>(
        bytes_actual, try package_call_facts::call_type_result(&calls, 1)
    );
    return;
}

