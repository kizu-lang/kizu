pub fn package_catalog_exact_index_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(resolver_test_file(
        0, "resolver/index_owner",
        "import selfhost::fixture::index_left; import selfhost::fixture::index_right; fn root() -> void {}"
    ));
    try files.append(resolver_test_file(
        1, "fixture/index_left",
        "pub struct First {} pub struct Second {} impl First { fn a(self: First) -> void {} fn q(self: First) -> void {} } impl Second { fn a(self: Second) -> void {} } pub fn a() -> void {} pub fn q() -> void {}"
    ));
    try files.append(resolver_test_file(
        2, "fixture/index_right",
        "pub struct First {} impl First { fn a(self: First) -> void {} } pub fn a() -> void {} pub fn q() -> void {}"
    ));
    var parsed = try parser::parse_source_files(allocator, &files);
    var catalog = try package_catalog_collect::collect_from_parsed_files(
        allocator, &files, &parsed
    );
    defer catalog.deinit();
    let owner = package_catalog::component_by_name(
        &catalog, "selfhost", "resolver/index_owner"
    );
    let left = package_catalog::component_by_name(
        &catalog, "selfhost", "fixture/index_left"
    );
    let right = package_catalog::component_by_name(
        &catalog, "selfhost", "fixture/index_right"
    );
    let left_a = try package_catalog::exact_top_level_function_entry(
        &catalog, left, "a"
    );
    let left_q = try package_catalog::exact_top_level_function_entry(
        &catalog, left, "q"
    );
    let right_a = try package_catalog::exact_top_level_function_entry(
        &catalog, right, "a"
    );
    std::testing::expect(left_a >= 0);
    std::testing::expect(left_q >= 0);
    std::testing::expect(right_a >= 0);
    std::testing::expect(left_a != left_q);
    std::testing::expect(left_a != right_a);
    std::testing::expect_equal<i64>(
        left_a,
        try package_exact_lookup::qualified_function_entry(
            &catalog, owner, "index_left::a"
        )
    );
    let left_a_target = try package_catalog::target_at_entry(&catalog, left_a);
    let canonical_left_a = try package_exact_lookup::exact_qualified_function_target(
        &catalog, "selfhost::fixture::index_left::a"
    );
    std::testing::expect(package_function_identity::same_target(
        left_a_target, canonical_left_a
    ));
    std::testing::expect_equal<i64>(
        -1, try package_catalog::exact_top_level_function_entry(
            &catalog, left, "missing"
        )
    );
    let left_first = try package_exact_lookup::declared_type_identity(
        &catalog, left, "First"
    );
    let left_second = try package_exact_lookup::declared_type_identity(
        &catalog, left, "Second"
    );
    let right_first = try package_exact_lookup::declared_type_identity(
        &catalog, right, "First"
    );
    let first_a = try package_exact_lookup::declared_impl_method_entry(
        &catalog, left_first.declaration_index, "a"
    );
    let first_q = try package_exact_lookup::declared_impl_method_entry(
        &catalog, left_first.declaration_index, "q"
    );
    let second_a = try package_exact_lookup::declared_impl_method_entry(
        &catalog, left_second.declaration_index, "a"
    );
    let right_first_a = try package_exact_lookup::declared_impl_method_entry(
        &catalog, right_first.declaration_index, "a"
    );
    std::testing::expect(first_a >= 0);
    std::testing::expect(first_q >= 0);
    std::testing::expect(second_a >= 0);
    std::testing::expect(right_first_a >= 0);
    std::testing::expect(first_a != first_q);
    std::testing::expect(first_a != second_a);
    std::testing::expect(first_a != right_first_a);
    std::testing::expect_equal<i64>(
        -1,
        try package_exact_lookup::declared_impl_method_entry(
            &catalog, left_first.declaration_index, "missing"
        )
    );
    try parser::deinit_parsed_source_files(parsed);
    return;
}

pub fn package_catalog_exact_index_unfinalized_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var catalog = package_catalog::init(allocator);
    defer catalog.deinit();
    let component = try package_catalog::register_component(
        &var catalog, "selfhost", "resolver/index_unfinalized"
    );
    let target = try package_catalog::register_function(
        &var catalog, component,
        "a", "", "void", 0, -1, 0, 1
    );
    let entry = try package_catalog::exact_top_level_function_entry(
        &catalog, component, "a"
    );
