pub fn package_catalog_component_owned_ranges_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(resolver_test_file(
        0,
        "resolver/range_owner_first",
        "import selfhost::fixture::range_first; struct Value { number: i64, } fn root(value: Value) -> void { let number = value.number; print(number); range_first::target(); }"
    ));
    try files.append(resolver_test_file(
        1,
        "resolver/range_owner_second",
        "import selfhost::fixture::range_second; struct Value { flag: bool, } fn root(value: Value) -> void { let flag = value.flag; print(flag); range_second::target(); }"
    ));
    try files.append(resolver_test_file(
        2, "fixture/range_first", "pub fn target() -> void {}"
    ));
    try files.append(resolver_test_file(
        3, "fixture/range_second", "pub fn target() -> void {}"
    ));
    var calls = try resolve_test_files(allocator, &files);
    defer calls.deinit();
    std::testing::expect_equal<i64>(2, package_call_facts::resolved_call_len(&calls));
    std::testing::expect_equal<i64>(2, package_call_facts::builtin_call_len(&calls));
    return;
}

pub fn package_catalog_reject_out_of_order_import_begin_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var catalog = package_catalog::init(allocator);
    defer catalog.deinit();
    let first = try package_catalog::register_component(
        &var catalog, "selfhost", "resolver/import_order_first"
    );
    let second = try package_catalog::register_component(
        &var catalog, "selfhost", "resolver/import_order_second"
    );
    try package_catalog::begin_component_imports(&var catalog, second);
    return;
}

