        "union State { Ready, Value(i64), } fn root(state: State) -> void { let ready = state == State::Ready; print(ready); }"
    ));
    var calls = try resolve_test_files(allocator, &files);
    defer calls.deinit();
    return expect_single_builtin_operation(&calls, "print");
}

pub fn package_resolver_duplicate_enum_tag_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(resolver_test_file(
        0,
        "resolver/duplicate_enum_tag",
        "enum State { Ready, Ready, } fn root(state: State) -> void { let value = match state { _ => 1, }; print(value); }"
    ));
    var calls = try resolve_test_files(allocator, &files);
    defer calls.deinit();
    return;
}
