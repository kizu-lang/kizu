// Substitution scratch owns only transaction-local formal-to-TypeId bindings.
// Type equality and template instantiation stay with the package TypeStore.
pub struct Substitutions {
    entries: std::array::Array<Substitution>,
}

struct Substitution {
    owner_kind: i64,
    owner_id: i64,
    slot: i64,
    type_id: i64,
}

pub fn substitutions(allocator: Allocator) -> Substitutions {
    return Substitutions {
        entries: std::array::Array<Substitution>(allocator)
    };
}

pub fn mark(bindings: &Substitutions) -> i64 {
    return bindings.entries.len();
}

pub fn clear_to(bindings: &var Substitutions, saved_mark: i64) -> !void {
    if saved_mark < 0 or saved_mark > bindings.entries.len() {
        return error("substitution scratch mark out of range");
    }
    while bindings.entries.len() > saved_mark {
        let ignored = try bindings.entries.pop();
    }
    return;
}

pub fn lookup(
    bindings: &Substitutions,
    owner_kind: i64,
    owner_id: i64,
    slot: i64
) -> !i64 {
    var index = bindings.entries.len();
    while index > 0 {
        index = index - 1;
        let entries = &bindings.entries;
        let substitution = try entries.at(index);
        if substitution.owner_kind == owner_kind and
            substitution.owner_id == owner_id and substitution.slot == slot {
            return substitution.type_id;
        }
    }
    return -1;
}

pub fn append(
    bindings: &var Substitutions,
    owner_kind: i64,
    owner_id: i64,
    slot: i64,
    type_id: i64
) -> !void {
    try bindings.entries.append(Substitution {
        owner_kind: owner_kind,
        owner_id: owner_id,
        slot: slot,
        type_id: type_id
    });
    return;
}

impl Substitutions {
    fn deinit(self: Substitutions) -> void {
        self.entries.deinit();
        return;
    }
}
