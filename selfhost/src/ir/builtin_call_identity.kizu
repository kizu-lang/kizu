import selfhost::ir::package_call_facts;
import selfhost::ir::intrinsic_type_contract;

// Closed builtin identities are shared by call traversal and exact call-result
// typing. Every accepted runtime spelling or receiver operation is classified
// here once; callers may not invent fallback identities.

pub struct BuiltinIdentity {
    pub kind: i64,
    pub operation: i64,
    pub canonical_identity: []u8,
    pub result_template: TypeApplyResultTemplate,
}

pub enum TypeApplyResultShape {
    None,
    Intrinsic,
    ErrorIntrinsic,
    Actual,
    ErrorActual,
    BorrowActual,
    ErrorBorrowActual,
    BorrowVarActual,
    ErrorBorrowVarActual,
}

pub struct TypeApplyResultTemplate {
    pub shape: TypeApplyResultShape,
    pub intrinsic_kind: i64,
    pub actual_slot: i64,
}

fn result_template(shape: TypeApplyResultShape, intrinsic_kind: i64, actual_slot: i64) -> TypeApplyResultTemplate {
    return TypeApplyResultTemplate {
        shape: shape, intrinsic_kind: intrinsic_kind, actual_slot: actual_slot
    };
}

fn no_result_template() -> TypeApplyResultTemplate {
    return TypeApplyResultTemplate {
        shape: TypeApplyResultShape::None, intrinsic_kind: -1, actual_slot: -1
    };
}

pub fn copy_result_template(
    value: &TypeApplyResultTemplate
) -> TypeApplyResultTemplate {
    return TypeApplyResultTemplate {
        shape: value.shape,
        intrinsic_kind: value.intrinsic_kind,
        actual_slot: value.actual_slot
    };
}

// Generic builtin result templates are the shared semantic signature table for
// type-applied free calls. Emitters and backends consume inferred TypeIds and
// never repeat these builtin identities.
fn type_apply_result_template(canonical_identity: []u8) -> TypeApplyResultTemplate {
    if std::mem::equal_bytes(canonical_identity, "std::builtin::array") or
        std::mem::equal_bytes(canonical_identity, "std::array::Array") {
        return result_template(TypeApplyResultShape::Intrinsic, intrinsic_type_contract::kind_array(), -1);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::map") {
        return result_template(TypeApplyResultShape::Intrinsic, intrinsic_type_contract::kind_map(), -1);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::atomic") {
        return result_template(TypeApplyResultShape::Intrinsic, intrinsic_type_contract::kind_atomic(), -1);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::channel") {
        return result_template(TypeApplyResultShape::Intrinsic, intrinsic_type_contract::kind_channel(), -1);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::mutex") {
        return result_template(TypeApplyResultShape::Intrinsic, intrinsic_type_contract::kind_mutex(), -1);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::box") {
        return result_template(TypeApplyResultShape::ErrorIntrinsic, intrinsic_type_contract::kind_box(), -1);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::array_get") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::array_pop") {
        return result_template(TypeApplyResultShape::ErrorActual, -1, 0);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::array_get_or_panic") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::array_pop_or_panic") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::atomic_load") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::channel_recv") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::mutex_get") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::thread_scoped") {
        return result_template(TypeApplyResultShape::Actual, -1, 0);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::array_at") {
        return result_template(TypeApplyResultShape::ErrorBorrowActual, -1, 0);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::array_at_mut") {
        return result_template(TypeApplyResultShape::ErrorBorrowVarActual, -1, 0);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::box_borrow") {
        return result_template(TypeApplyResultShape::BorrowActual, -1, 0);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::box_borrow_mut") {
        return result_template(TypeApplyResultShape::BorrowVarActual, -1, 0);
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::map_get") {
        return result_template(TypeApplyResultShape::ErrorActual, -1, 1);
    }
    return no_result_template();
}

pub fn builtin_identity(name: []u8) -> BuiltinIdentity {
    let value = std::mem::trim_ascii(name);
    if std::mem::equal_bytes(value, "print") or
        std::mem::equal_bytes(value, "error") {
        if std::mem::equal_bytes(value, "print") {
            return language_builtin_identity(package_call_facts::builtin_operation_print());
        }
        return language_builtin_identity(package_call_facts::builtin_operation_error());
    }
    if std::mem::equal_bytes(value, "std::array::Array") or
        std::mem::equal_bytes(value, "std::mem::page_allocator") or
        std::mem::equal_bytes(value, "std::mem::byte_at") or
        std::mem::equal_bytes(value, "std::mem::equal_bytes") or
        std::mem::equal_bytes(value, "std::mem::is_ascii_space") or
        std::mem::equal_bytes(value, "std::mem::len") or
        std::mem::equal_bytes(value, "std::mem::slice") or
        std::mem::equal_bytes(value, "std::mem::starts_with") or
        std::mem::equal_bytes(value, "std::mem::trim_ascii") or
        std::mem::equal_bytes(value, "std::fmt::append_bool") or
        std::mem::equal_bytes(value, "std::fmt::append_bytes_literal") or
        std::mem::equal_bytes(value, "std::fmt::append_i64") or
        std::mem::equal_bytes(value, "std::io::blocking") or
        std::mem::equal_bytes(value, "std::io::write_stdout") or
        std::mem::equal_bytes(value, "std::io::write_stderr") or
        std::mem::equal_bytes(value, "std::fs::create_dir") or
        std::mem::equal_bytes(value, "std::fs::exists") or
        std::mem::equal_bytes(value, "std::fs::metadata") or
        std::mem::equal_bytes(value, "std::fs::read_dir") or
        std::mem::equal_bytes(value, "std::fs::read_file") or
        std::mem::equal_bytes(value, "std::fs::remove_file") or
        std::mem::equal_bytes(value, "std::fs::rename") or
        std::mem::equal_bytes(value, "std::fs::write_file") or
        std::mem::equal_bytes(value, "std::process::arg") or
        std::mem::equal_bytes(value, "std::process::arg_count") or
        std::mem::equal_bytes(value, "std::process::env") or
        std::mem::equal_bytes(value, "std::process::env_or_empty") or
        std::mem::equal_bytes(value, "std::process::exit_code") or
        std::mem::equal_bytes(value, "std::process::monotonic_millis") {
        return free_runtime_builtin_identity(value);
    }
    if std::mem::equal_bytes(value, "std::builtin::array") or
        std::mem::equal_bytes(value, "std::builtin::array_append") or
        std::mem::equal_bytes(value, "std::builtin::array_at") or
        std::mem::equal_bytes(value, "std::builtin::array_at_mut") or
        std::mem::equal_bytes(value, "std::builtin::array_capacity") or
        std::mem::equal_bytes(value, "std::builtin::array_deinit") or
        std::mem::equal_bytes(value, "std::builtin::array_get") or
        std::mem::equal_bytes(value, "std::builtin::array_get_or_panic") or
        std::mem::equal_bytes(value, "std::builtin::array_len") or
        std::mem::equal_bytes(value, "std::builtin::array_pop") or
        std::mem::equal_bytes(value, "std::builtin::array_pop_or_panic") or
        std::mem::equal_bytes(value, "std::builtin::array_reserve") or
        std::mem::equal_bytes(value, "std::builtin::array_set") or
        std::mem::equal_bytes(value, "std::builtin::atomic") or
        std::mem::equal_bytes(value, "std::builtin::atomic_load") or
        std::mem::equal_bytes(value, "std::builtin::atomic_store") or
        std::mem::equal_bytes(value, "std::builtin::box") or
        std::mem::equal_bytes(value, "std::builtin::box_borrow") or
        std::mem::equal_bytes(value, "std::builtin::box_borrow_mut") or
        std::mem::equal_bytes(value, "std::builtin::box_deinit") or
        std::mem::equal_bytes(value, "std::builtin::channel") or
        std::mem::equal_bytes(value, "std::builtin::channel_recv") or
        std::mem::equal_bytes(value, "std::builtin::channel_send") or
        std::mem::equal_bytes(value, "std::builtin::fs_create_dir") or
        std::mem::equal_bytes(value, "std::builtin::fs_exists") or
        std::mem::equal_bytes(value, "std::builtin::fs_metadata") or
        std::mem::equal_bytes(value, "std::builtin::fs_read_dir") or
        std::mem::equal_bytes(value, "std::builtin::fs_read_file") or
        std::mem::equal_bytes(value, "std::builtin::fs_remove_dir") or
        std::mem::equal_bytes(value, "std::builtin::fs_remove_file") or
        std::mem::equal_bytes(value, "std::builtin::fs_rename") or
        std::mem::equal_bytes(value, "std::builtin::fs_write_file") or
        std::mem::equal_bytes(value, "std::builtin::io_blocking") or
        std::mem::equal_bytes(value, "std::builtin::io_failing") or
        std::mem::equal_bytes(value, "std::builtin::io_read_stdin") or
        std::mem::equal_bytes(value, "std::builtin::io_threaded") or
        std::mem::equal_bytes(value, "std::builtin::io_write_stderr") or
        std::mem::equal_bytes(value, "std::builtin::io_write_stdout") or
        std::mem::equal_bytes(value, "std::builtin::map") or
        std::mem::equal_bytes(value, "std::builtin::map_contains") or
        std::mem::equal_bytes(value, "std::builtin::map_deinit") or
        std::mem::equal_bytes(value, "std::builtin::map_get") or
        std::mem::equal_bytes(value, "std::builtin::map_insert") or
        std::mem::equal_bytes(value, "std::builtin::map_len") or
        std::mem::equal_bytes(value, "std::builtin::mem_len") or
        std::mem::equal_bytes(value, "std::builtin::mem_page_allocator") or
        std::mem::equal_bytes(value, "std::builtin::mutex") or
        std::mem::equal_bytes(value, "std::builtin::mutex_get") or
        std::mem::equal_bytes(value, "std::builtin::process_arg") or
        std::mem::equal_bytes(value, "std::builtin::process_arg_count") or
        std::mem::equal_bytes(value, "std::builtin::process_env") or
        std::mem::equal_bytes(value, "std::builtin::process_env_or_empty") or
        std::mem::equal_bytes(value, "std::builtin::process_monotonic_millis") or
        std::mem::equal_bytes(value, "std::builtin::process_spawn_wait8") or
        std::mem::equal_bytes(value, "std::builtin::task_group") or
        std::mem::equal_bytes(value, "std::builtin::task_local_buffer") or
        std::mem::equal_bytes(value, "std::builtin::task_parallel_for") or
        std::mem::equal_bytes(value, "std::builtin::task_parallel_map") or
        std::mem::equal_bytes(value, "std::builtin::task_partition_mut") or
        std::mem::equal_bytes(value, "std::builtin::task_queue") or
        std::mem::equal_bytes(value, "std::builtin::test_fail") or
        std::mem::equal_bytes(value, "std::builtin::test_fail_equal") or
        std::mem::equal_bytes(value, "std::builtin::thread_scoped") {
        return free_runtime_builtin_identity(value);
    }
    return no_builtin_identity();
}

fn no_builtin_identity() -> BuiltinIdentity {
    return BuiltinIdentity {
        kind: package_call_facts::builtin_none_kind(),
        operation: package_call_facts::builtin_operation_none(),
        canonical_identity: "", result_template: no_result_template()
    };
}

fn language_builtin_identity(operation: i64) -> BuiltinIdentity {
    return BuiltinIdentity {
        kind: package_call_facts::builtin_language_kind(), operation: operation,
        canonical_identity: "", result_template: no_result_template()
    };
}

fn free_runtime_builtin_identity(canonical_identity: []u8) -> BuiltinIdentity {
    return BuiltinIdentity {
        kind: package_call_facts::builtin_runtime_kind(),
        operation: package_call_facts::builtin_operation_none(),
        canonical_identity: canonical_identity,
        result_template: type_apply_result_template(canonical_identity)
    };
}

fn receiver_runtime_builtin_identity(operation: i64) -> BuiltinIdentity {
    return BuiltinIdentity {
        kind: package_call_facts::builtin_runtime_kind(), operation: operation,
        canonical_identity: "", result_template: no_result_template()
    };
}

pub fn external_shape_builtin_identity(operation: i64) -> BuiltinIdentity {
    return BuiltinIdentity {
        kind: package_call_facts::builtin_external_shape_kind(), operation: operation,
        canonical_identity: "", result_template: no_result_template()
    };
}

// free_runtime_return_type is the sole canonical ABI identity-to-result
// boundary for non-receiver runtime calls. The structural spelling includes
// fallibility; downstream type inference must not inspect the callee name.
pub fn free_runtime_return_type(canonical_identity: []u8) -> []u8 {
    if std::mem::equal_bytes(canonical_identity, "std::mem::page_allocator") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::mem_page_allocator") {
        return "Allocator";
    }
    if std::mem::equal_bytes(canonical_identity, "std::mem::len") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::mem_len") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::array_len") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::array_capacity") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::map_len") or
        std::mem::equal_bytes(canonical_identity, "std::process::arg_count") or
        std::mem::equal_bytes(canonical_identity, "std::process::monotonic_millis") or
        std::mem::equal_bytes(canonical_identity, "std::process::exit_code") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::process_arg_count") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::process_monotonic_millis") {
        return "i64";
    }
    if std::mem::equal_bytes(canonical_identity, "std::mem::byte_at") {
        return "!u8";
    }
    if std::mem::equal_bytes(canonical_identity, "std::mem::equal_bytes") or
        std::mem::equal_bytes(canonical_identity, "std::mem::is_ascii_space") or
        std::mem::equal_bytes(canonical_identity, "std::mem::starts_with") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::map_contains") {
        return "bool";
    }
    if std::mem::equal_bytes(canonical_identity, "std::fs::exists") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::fs_exists") {
        return "!bool";
    }
    if std::mem::equal_bytes(canonical_identity, "std::mem::trim_ascii") or
        std::mem::equal_bytes(canonical_identity, "std::process::env_or_empty") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::process_env_or_empty") {
        return "[]u8";
    }
    if std::mem::equal_bytes(canonical_identity, "std::mem::slice") or
        std::mem::equal_bytes(canonical_identity, "std::fs::read_file") or
        std::mem::equal_bytes(canonical_identity, "std::process::arg") or
        std::mem::equal_bytes(canonical_identity, "std::process::env") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::fs_read_file") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::io_read_stdin") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::process_arg") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::process_env") {
        return "![]u8";
    }
    if std::mem::equal_bytes(canonical_identity, "std::io::blocking") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::io_blocking") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::io_threaded") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::io_failing") {
        return "Io";
    }
    if std::mem::equal_bytes(canonical_identity, "std::fmt::append_bool") or
        std::mem::equal_bytes(canonical_identity, "std::fmt::append_bytes_literal") or
        std::mem::equal_bytes(canonical_identity, "std::fmt::append_i64") or
        std::mem::equal_bytes(canonical_identity, "std::io::write_stdout") or
        std::mem::equal_bytes(canonical_identity, "std::io::write_stderr") or
        std::mem::equal_bytes(canonical_identity, "std::fs::create_dir") or
        std::mem::equal_bytes(canonical_identity, "std::fs::remove_file") or
        std::mem::equal_bytes(canonical_identity, "std::fs::rename") or
        std::mem::equal_bytes(canonical_identity, "std::fs::write_file") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::fs_create_dir") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::fs_remove_dir") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::fs_remove_file") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::fs_rename") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::fs_write_file") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::io_write_stdout") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::io_write_stderr") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::array_append") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::array_reserve") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::array_set") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::map_insert") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::task_parallel_for") {
        return "!void";
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::process_spawn_wait8") {
        return "!i64";
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::fs_metadata") or
        std::mem::equal_bytes(canonical_identity, "std::fs::metadata") {
        return "!std::fs::Metadata";
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::fs_read_dir") or
        std::mem::equal_bytes(canonical_identity, "std::fs::read_dir") {
        return "!std::array::Array<std::fs::DirEntry>";
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::task_group") {
        return "TaskGroup";
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::task_queue") {
        return "Queue";
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::task_partition_mut") {
        return "Partition";
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::task_local_buffer") {
        return "LocalBuffer";
    }
    if std::mem::equal_bytes(canonical_identity, "std::builtin::array_deinit") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::box_deinit") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::map_deinit") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::atomic_store") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::channel_send") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::task_parallel_map") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::test_fail") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::test_fail_equal") {
        return "void";
    }
    return "";
}

// The caller supplies the proven intrinsic TypeId kind. Runtime method
// classification never reconstructs a family from source/canonical spelling.
pub fn runtime_intrinsic_method_identity(
    intrinsic_kind: i64,
    method: []u8
) -> BuiltinIdentity {
    let operation = runtime_receiver_method_operation(intrinsic_kind, method);
    if operation == package_call_facts::builtin_operation_none() {
        return no_builtin_identity();
    }
    return receiver_runtime_builtin_identity(operation);
}

pub fn runtime_external_family_method_identity(
    family: []u8,
    method: []u8
) -> BuiltinIdentity {
    var operation = package_call_facts::builtin_operation_none();
    if std::mem::equal_bytes(family, "string") {
        if std::mem::equal_bytes(method, "append_bytes") {
            operation = package_call_facts::builtin_operation_string_append_bytes();
        } else {
            if std::mem::equal_bytes(method, "append_byte") {
                operation = package_call_facts::builtin_operation_string_append_byte();
            } else {
                if std::mem::equal_bytes(method, "reserve") {
                    operation = package_call_facts::builtin_operation_string_reserve();
                } else {
                    if std::mem::equal_bytes(method, "len") {
                        operation = package_call_facts::builtin_operation_string_len();
                    } else {
                        if std::mem::equal_bytes(method, "capacity") {
                            operation = package_call_facts::builtin_operation_string_capacity();
                        } else {
                            if std::mem::equal_bytes(method, "as_bytes") {
                                operation = package_call_facts::builtin_operation_string_as_bytes();
                            } else {
                                if std::mem::equal_bytes(method, "clear") {
                                    operation = package_call_facts::builtin_operation_string_clear();
                                } else {
                                    if std::mem::equal_bytes(method, "truncate") {
                                        operation = package_call_facts::builtin_operation_string_truncate();
                                    } else {
                                        if std::mem::equal_bytes(method, "deinit") {
                                            operation = package_call_facts::builtin_operation_string_deinit();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if operation == package_call_facts::builtin_operation_none() {
        return no_builtin_identity();
    }
    return receiver_runtime_builtin_identity(operation);
}

fn runtime_receiver_method_operation(intrinsic_kind: i64, method: []u8) -> i64 {
    if intrinsic_kind == intrinsic_type_contract::kind_array() {
        if std::mem::equal_bytes(method, "append") { return package_call_facts::builtin_operation_array_append(); }
        if std::mem::equal_bytes(method, "len") { return package_call_facts::builtin_operation_array_len(); }
        if std::mem::equal_bytes(method, "capacity") { return package_call_facts::builtin_operation_array_capacity(); }
        if std::mem::equal_bytes(method, "pop") { return package_call_facts::builtin_operation_array_pop(); }
        if std::mem::equal_bytes(method, "pop_or_panic") {
            return package_call_facts::builtin_operation_array_pop_or_panic();
        }
        if std::mem::equal_bytes(method, "get") { return package_call_facts::builtin_operation_array_get(); }
        if std::mem::equal_bytes(method, "get_or_panic") { return package_call_facts::builtin_operation_array_get_or_panic(); }
        if std::mem::equal_bytes(method, "at") { return package_call_facts::builtin_operation_array_at(); }
        if std::mem::equal_bytes(method, "at_mut") { return package_call_facts::builtin_operation_array_at_mut(); }
        if std::mem::equal_bytes(method, "set") { return package_call_facts::builtin_operation_array_set(); }
        if std::mem::equal_bytes(method, "reserve") { return package_call_facts::builtin_operation_array_reserve(); }
        if std::mem::equal_bytes(method, "truncate") { return package_call_facts::builtin_operation_array_truncate(); }
        if std::mem::equal_bytes(method, "clear") { return package_call_facts::builtin_operation_array_clear(); }
        if std::mem::equal_bytes(method, "as_bytes") { return package_call_facts::builtin_operation_array_as_bytes(); }
        if std::mem::equal_bytes(method, "deinit") { return package_call_facts::builtin_operation_array_deinit(); }
    }
    if intrinsic_kind == intrinsic_type_contract::kind_arena() {
        if std::mem::equal_bytes(method, "add") { return package_call_facts::builtin_operation_arena_add(); }
        if std::mem::equal_bytes(method, "get") { return package_call_facts::builtin_operation_arena_get(); }
        if std::mem::equal_bytes(method, "deinit") { return package_call_facts::builtin_operation_arena_deinit(); }
    }
    if intrinsic_kind == intrinsic_type_contract::kind_map() {
        if std::mem::equal_bytes(method, "insert") { return package_call_facts::builtin_operation_map_insert(); }
        if std::mem::equal_bytes(method, "get") { return package_call_facts::builtin_operation_map_get(); }
        if std::mem::equal_bytes(method, "contains") { return package_call_facts::builtin_operation_map_contains(); }
        if std::mem::equal_bytes(method, "len") { return package_call_facts::builtin_operation_map_len(); }
        if std::mem::equal_bytes(method, "deinit") { return package_call_facts::builtin_operation_map_deinit(); }
    }
    if intrinsic_kind == intrinsic_type_contract::kind_box() {
        if std::mem::equal_bytes(method, "borrow") { return package_call_facts::builtin_operation_box_borrow(); }
        if std::mem::equal_bytes(method, "borrow_mut") { return package_call_facts::builtin_operation_box_borrow_mut(); }
        if std::mem::equal_bytes(method, "deinit") { return package_call_facts::builtin_operation_box_deinit(); }
    }
    if intrinsic_kind == intrinsic_type_contract::kind_channel() {
        if std::mem::equal_bytes(method, "send") { return package_call_facts::builtin_operation_channel_send(); }
        if std::mem::equal_bytes(method, "recv") { return package_call_facts::builtin_operation_channel_recv(); }
        if std::mem::equal_bytes(method, "close") { return package_call_facts::builtin_operation_channel_close(); }
    }
    if intrinsic_kind == intrinsic_type_contract::kind_atomic() {
        if std::mem::equal_bytes(method, "load") { return package_call_facts::builtin_operation_atomic_load(); }
        if std::mem::equal_bytes(method, "store") { return package_call_facts::builtin_operation_atomic_store(); }
    }
    if intrinsic_kind == intrinsic_type_contract::kind_mutex() and std::mem::equal_bytes(method, "get") { return package_call_facts::builtin_operation_mutex_get(); }
    if intrinsic_kind == intrinsic_type_contract::kind_task() {
        if std::mem::equal_bytes(method, "await") { return package_call_facts::builtin_operation_task_await(); }
        if std::mem::equal_bytes(method, "cancel") { return package_call_facts::builtin_operation_task_cancel(); }
    }
    if intrinsic_kind == intrinsic_type_contract::kind_task_group() and std::mem::equal_bytes(method, "spawn") { return package_call_facts::builtin_operation_task_spawn(); }
    if intrinsic_kind == intrinsic_type_contract::kind_queue() {
        if std::mem::equal_bytes(method, "enqueue") { return package_call_facts::builtin_operation_queue_enqueue(); }
        if std::mem::equal_bytes(method, "drain") { return package_call_facts::builtin_operation_queue_drain(); }
    }
    if intrinsic_kind == intrinsic_type_contract::kind_partition() and std::mem::equal_bytes(method, "at") { return package_call_facts::builtin_operation_partition_at(); }
    if intrinsic_kind == intrinsic_type_contract::kind_local_buffer() and std::mem::equal_bytes(method, "get") { return package_call_facts::builtin_operation_local_buffer_get(); }
    return package_call_facts::builtin_operation_none();
}

pub fn is_external_type_apply_identity(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "std::arena::Arena") or
        std::mem::equal_bytes(name, "ptr_from_int") or
        std::mem::equal_bytes(name, "int_from_ptr");
}

pub fn external_type_apply_identity(name: []u8) -> BuiltinIdentity {
    if std::mem::equal_bytes(name, "std::arena::Arena") {
        return external_shape_builtin_identity(package_call_facts::builtin_operation_arena_new());
    }
    if std::mem::equal_bytes(name, "ptr_from_int") {
        return language_builtin_identity(package_call_facts::builtin_operation_ptr_from_int());
    }
    if std::mem::equal_bytes(name, "int_from_ptr") {
        return language_builtin_identity(package_call_facts::builtin_operation_int_from_ptr());
    }
    return no_builtin_identity();
}
