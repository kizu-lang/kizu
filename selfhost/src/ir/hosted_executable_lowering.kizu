pub fn append_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    local_name: []u8,
    qualified_name: []u8
) -> !void {
    let body = try function_body_node(text, ast, root, local_name);
    let count = try lowering_case_count(ast, body);
    if count < 1 {
        return error("missing selected hosted lowering cases");
    }
    try append_case_count(out, qualified_name, count);

    var index = 0;
    while index < count {
        let if_node = try lowering_case_if_node(ast, body, index);
        let struct_literal = try lowering_case_return_struct(ast, if_node);
        try append_case_fact(
            out,
            "hosted-lowering-case-kind ",
            qualified_name,
            index,
            try lowering_case_kind(text, ast, if_node)
        );
        try append_case_llvm_c_string_fact(
            out,
            "hosted-lowering-case-comment-llvm ",
            qualified_name,
            index,
            try struct_field_string_value(text, ast, struct_literal, "comment")
        );
        try append_case_fact(
            out,
            "hosted-lowering-case-entry ",
            qualified_name,
            index,
            try struct_field_string_value(text, ast, struct_literal, "entry")
        );
        try append_case_fact(
            out,
            "hosted-lowering-case-global ",
            qualified_name,
            index,
            try struct_field_string_or_none(text, ast, struct_literal, "global")
        );
        try append_case_fact(
            out,
            "hosted-lowering-case-stream ",
            qualified_name,
            index,
            try struct_field_enum_value(text, ast, struct_literal, "output_stream")
        );
        try append_case_fact(
            out,
            "hosted-lowering-case-newline ",
            qualified_name,
            index,
            try struct_field_token_value(text, ast, struct_literal, "append_newline")
        );
        try append_case_fact(
            out,
            "hosted-lowering-case-exit ",
            qualified_name,
            index,
            try struct_field_token_value(text, ast, struct_literal, "exit_code")
        );
        let payload_kind = try struct_field_payload_kind(text, ast, struct_literal);
        try append_case_fact(
            out,
            "hosted-lowering-case-payload ",
            qualified_name,
            index,
            payload_kind
        );
        if std::mem::equal_bytes(payload_kind, "literal") {
            try append_case_llvm_c_string_fact(
                out,
                "hosted-lowering-case-payload-llvm ",
                qualified_name,
                index,
                try struct_field_payload_literal(text, ast, struct_literal)
            );
        }
        index = index + 1;
    }
    return;
}

fn append_case_llvm_c_string_fact(
    out: &var std::string::String,
    prefix: []u8,
    function_name: []u8,
    index: i64,
    value: []u8
) -> !void {
    try out.append_bytes(prefix);
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    try append_llvm_c_string_token(out, value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_c_string_token(out: &var std::string::String, value: []u8) -> !void {
    var index = 0;
    let len = std::mem::len(value);
    while index < len {
        let byte = value[index];
        if byte == cast<u8>(32) {
            try out.append_bytes("\20");
        } else {
            if byte == cast<u8>(34) {
                try out.append_bytes("\22");
            } else {
                if byte == cast<u8>(92) {
                    try out.append_bytes("\5C");
                } else {
                    if byte == cast<u8>(10) {
                        try out.append_bytes("\0A");
                    } else {
                        try out.append_byte(byte);
                    }
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn append_case_count(
    out: &var std::string::String,
    function_name: []u8,
    count: i64
) -> !void {
    try out.append_bytes("hosted-lowering-case-count ");
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, count);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_case_fact(
    out: &var std::string::String,
    prefix: []u8,
    function_name: []u8,
    index: i64,
    value: []u8
) -> !void {
    try out.append_bytes(prefix);
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn lowering_case_count(
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(body);
    match node.data {
        Block(block) => return try lowering_case_count_in_range(ast, block.statements);,
        _ => return error("missing selected hosted lowering cases");,
    }
}

fn lowering_case_count_in_range(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !i64 {
    var count = 0;
    while count < statements.len {
        let statement = try ast.child_at(statements, count);
        let statement_node = ast.get(statement);
        match statement_node.data {
            If(if_node) => count = count + 1;,
            _ => return count;,
        }
    }
    return count;
}

fn lowering_case_if_node(
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId,
    index: i64
) -> !std::kizu::ast::NodeId {
    let node = ast.get(body);
    match node.data {
        Block(block) => return try lowering_case_if_node_in_range(ast, block.statements, index);,
        _ => return error("missing selected hosted lowering cases");,
    }
}

fn lowering_case_if_node_in_range(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    index: i64
) -> !std::kizu::ast::NodeId {
    let statement = try ast.child_at(statements, index);
    let statement_node = ast.get(statement);
    match statement_node.data {
        If(if_node) => return statement;,
        _ => return error("missing selected hosted lowering case");,
    }
}

fn lowering_case_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    if_node_id: std::kizu::ast::NodeId
) -> ![]u8 {
    let if_node = ast.get(if_node_id);
    match if_node.data {
        If(if_data) => return try lowering_case_kind_from_condition(text, ast, if_data.condition);,
        _ => return error("unsupported selected hosted lowering condition");,
    }
}

fn lowering_case_kind_from_condition(
    text: []u8,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId
) -> ![]u8 {
    try require_binary_eq(ast, condition);
    let left = try binary_left(ast, condition);
    let right = try binary_right(ast, condition);
    try require_kind_field_expr(text, ast, left);
    return try enum_variant_name(text, ast, right);
}

fn require_binary_eq(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Binary(binary) => return require_binary_eq_op(binary.op);,
        _ => return error("unsupported selected hosted lowering condition");,
    }
}

fn require_binary_eq_op(op: std::kizu::ast::BinaryOp) -> !void {
    if op == std::kizu::ast::binary_eq() {
        return;
    }
    return error("unsupported selected hosted lowering condition");
}

fn binary_left(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        Binary(binary) => return binary.left;,
        _ => return error("unsupported selected hosted lowering condition");,
    }
}

fn binary_right(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        Binary(binary) => return binary.right;,
        _ => return error("unsupported selected hosted lowering condition");,
    }
}

fn require_kind_field_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        FieldExpr(field_expr) => return require_kind_field_name(text, ast, field_expr.name);,
        _ => return error("unsupported selected hosted lowering condition");,
    }
}

fn require_kind_field_name(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId
) -> !void {
    if std::mem::equal_bytes(ast_node_text(text, ast, name), "kind") {
        return;
    }
    return error("unsupported selected hosted lowering condition");
}

fn lowering_case_return_struct(
    ast: std::kizu::ast::Ast,
    if_node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let if_node = ast.get(if_node_id);
    match if_node.data {
        If(if_data) => return try return_struct_in_block(ast, if_data.then_block);,
        _ => return error("missing selected hosted lowering result");,
    }
}

fn return_struct_in_block(
    ast: std::kizu::ast::Ast,
    block_node: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(block_node);
    match node.data {
        Block(block) => return try return_struct_in_range(ast, block.statements);,
        _ => return error("missing selected hosted lowering result");,
    }
}

fn return_struct_in_range(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !std::kizu::ast::NodeId {
    if statements.len < 1 {
        return error("missing selected hosted lowering result");
    }
    let statement = try ast.child_at(statements, 0);
    let statement_node = ast.get(statement);
    match statement_node.data {
        Return(return_node) => return try return_struct_literal(ast, return_node.value);,
        _ => return error("missing selected hosted lowering result");,
    }
}

fn return_struct_literal(
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let value_node = ast.get(value);
    match value_node.data {
        StructLiteralExpr(struct_literal) => return value;,
        _ => return error("missing selected hosted lowering result");,
    }
}

fn struct_field_string_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    struct_literal: std::kizu::ast::NodeId,
    field_name: []u8
) -> ![]u8 {
    let value = try struct_field_value(ast, text, struct_literal, field_name);
    return try string_literal_value(text, ast, value);
}

fn struct_field_string_or_none(
    text: []u8,
    ast: std::kizu::ast::Ast,
    struct_literal: std::kizu::ast::NodeId,
    field_name: []u8
) -> ![]u8 {
    let value = try struct_field_string_value(text, ast, struct_literal, field_name);
    if std::mem::len(value) == 0 {
        return "none";
    }
    return value;
}

fn struct_field_enum_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    struct_literal: std::kizu::ast::NodeId,
    field_name: []u8
) -> ![]u8 {
    let value = try struct_field_value(ast, text, struct_literal, field_name);
    return try enum_variant_name(text, ast, value);
}

fn struct_field_token_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    struct_literal: std::kizu::ast::NodeId,
    field_name: []u8
) -> ![]u8 {
    let value = try struct_field_value(ast, text, struct_literal, field_name);
    return ast_node_text(text, ast, value);
}

fn struct_field_payload_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    struct_literal: std::kizu::ast::NodeId
) -> ![]u8 {
    let value = try struct_field_value(ast, text, struct_literal, "output_payload");
    let node = ast.get(value);
    match node.data {
        String(string_node) => return "literal";,
        FieldExpr(field_expr) => return "executable-field";,
        IndexExpr(index_expr) => return "empty-source-slice";,
        _ => return error("unsupported selected hosted lowering payload");,
    }
}

fn struct_field_payload_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    struct_literal: std::kizu::ast::NodeId
) -> ![]u8 {
    let value = try struct_field_value(ast, text, struct_literal, "output_payload");
    return try string_literal_value(text, ast, value);
}

fn struct_field_value(
    ast: std::kizu::ast::Ast,
    text: []u8,
    struct_literal: std::kizu::ast::NodeId,
    field_name: []u8
) -> !std::kizu::ast::NodeId {
    let node = ast.get(struct_literal);
    match node.data {
        StructLiteralExpr(struct_data) => return try struct_field_value_in_range(
            ast,
            text,
            struct_data.fields,
            field_name
        );,
        _ => return error("missing selected hosted lowering field");,
    }
}

fn struct_field_value_in_range(
    ast: std::kizu::ast::Ast,
    text: []u8,
    fields: std::kizu::ast::ChildRange,
    field_name: []u8
) -> !std::kizu::ast::NodeId {
    var index = 0;
    while index < fields.len {
        let field = try ast.child_at(fields, index);
        if try struct_field_matches(ast, text, field, field_name) {
            return try struct_field_value_at(ast, field);
        }
        index = index + 1;
    }
    return error("missing selected hosted lowering field");
}

fn struct_field_matches(
    ast: std::kizu::ast::Ast,
    text: []u8,
    field: std::kizu::ast::NodeId,
    field_name: []u8
) -> !bool {
    let node = ast.get(field);
    match node.data {
        StructFieldInit(field_init) => return std::mem::equal_bytes(
            ast_node_text(text, ast, field_init.name),
            field_name
        );,
        _ => return error("missing selected hosted lowering field");,
    }
}

fn struct_field_value_at(
    ast: std::kizu::ast::Ast,
    field: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(field);
    match node.data {
        StructFieldInit(field_init) => return field_init.value;,
        _ => return error("missing selected hosted lowering field");,
    }
}

fn enum_variant_name(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ![]u8 {
    let node = ast.get(node_id);
    match node.data {
        FieldExpr(field_expr) => return ast_node_text(text, ast, field_expr.name);,
        _ => return error("unsupported selected hosted lowering enum value");,
    }
}

fn string_literal_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ![]u8 {
    let node = ast.get(node_id);
    match node.data {
        String(string_node) => return try string_literal_value_from_node(text, ast, node_id);,
        _ => return error("unsupported selected hosted lowering string value");,
    }
}

fn string_literal_value_from_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ![]u8 {
    let token = ast_node_text(text, ast, node_id);
    let len = std::mem::len(token);
    if len < 2 {
        return error("invalid selected hosted lowering string value");
    }
    if token[0] != cast<u8>(34) or token[len - 1] != cast<u8>(34) {
        return error("invalid selected hosted lowering string value");
    }
    let value = token[1..len - 1];
    if bytes_contains_byte(value, cast<u8>(92)) or
        bytes_contains_byte(value, cast<u8>(10)) {
        return error("unsupported selected hosted lowering string value");
    }
    return value;
}

fn function_body_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    let function_node_id = try function_node(text, ast, root, function_name);
    return try function_body_from_node(ast, function_node_id);
}

fn function_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    let node = ast.get(root);
    match node.data {
        Program(program) => return try function_node_in_program(
            text,
            ast,
            program.declarations,
            function_name
        );,
        _ => return error("missing selected hosted lowering source");,
    }
}

fn function_node_in_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if function_node_matches(text, ast, child, function_name) {
            return child;
        }
        index = index + 1;
    }
    return error("missing selected hosted lowering source");
}

fn function_node_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        FnDecl(fn_decl) => std::mem::equal_bytes(
            ast_node_text(text, ast, fn_decl.name),
            name
        ),
        _ => false,
    };
}

fn function_body_from_node(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return fn_decl.body;,
        _ => return error("missing selected hosted lowering source");,
    }
}

fn bytes_contains_byte(bytes: []u8, needle: u8) -> bool {
    var index = 0;
    let len = std::mem::len(bytes);
    while index < len {
        if bytes[index] == needle {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
