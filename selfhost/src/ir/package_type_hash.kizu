pub fn identity_none() -> i64 { return 0; }
pub fn identity_intrinsic() -> i64 { return 1; }
pub fn identity_declaration() -> i64 { return 2; }
pub fn identity_formal() -> i64 { return 3; }

pub struct Identity {
    pub kind: i64,
    pub identity_kind: i64,
    pub intrinsic_kind: i64,
    pub declaration_component_id: i64,
    pub declaration_index: i64,
    pub spelling_component_id: i64,
    pub formal_owner_kind: i64,
    pub formal_owner_id: i64,
    pub formal_slot: i64,
}

pub fn hash_array(
    identity: &Identity,
    children: &std::array::Array<i64>,
    modulus: i64
) -> !i64 {
    var hash = hash_identity(identity, modulus);
    hash = step(hash, children.len(), modulus);
    var index = 0;
    while index < children.len() {
        hash = step(hash, try children.get(index), modulus);
        index = index + 1;
    }
    return hash;
}

pub fn hash_flat(
    identity: &Identity,
    children: &std::array::Array<i64>,
    child_start: i64,
    child_len: i64,
    modulus: i64
) -> !i64 {
    var hash = hash_identity(identity, modulus);
    hash = step(hash, child_len, modulus);
    var index = 0;
    while index < child_len {
        hash = step(hash, try children.get(child_start + index), modulus);
        index = index + 1;
    }
    return hash;
}

pub fn next_slot(slot: i64, slot_len: i64) -> i64 {
    if slot + 1 == slot_len { return 0; }
    return slot + 1;
}

fn hash_identity(identity: &Identity, modulus: i64) -> i64 {
    var hash = step(0, identity.kind, modulus);
    hash = step(hash, identity.spelling_component_id, modulus);
    if identity.identity_kind == identity_intrinsic() {
        hash = step(hash, identity.intrinsic_kind, modulus);
    }
    if identity.identity_kind == identity_declaration() {
        hash = step(hash, identity.declaration_component_id, modulus);
        hash = step(hash, identity.declaration_index, modulus);
    }
    if identity.identity_kind == identity_formal() {
        hash = step(hash, identity.formal_owner_kind, modulus);
        hash = step(hash, identity.formal_owner_id, modulus);
        hash = step(hash, identity.formal_slot, modulus);
    }
    return hash;
}

// step computes state*33+value modulo modulus without overflowing: each
// doubling and addition is reduced before the next operation.
fn step(state: i64, value: i64, modulus: i64) -> i64 {
    var times_32 = state;
    var shift = 0;
    while shift < 5 {
        times_32 = add_mod(times_32, times_32, modulus);
        shift = shift + 1;
    }
    let times_33 = add_mod(times_32, state, modulus);
    return add_mod(times_33, normalize(value, modulus), modulus);
}

fn normalize(value: i64, modulus: i64) -> i64 {
    let reduced = value % modulus;
    if reduced < 0 { return reduced + modulus; }
    return reduced;
}

fn add_mod(left: i64, right: i64, modulus: i64) -> i64 {
    let remaining = modulus - left;
    if right >= remaining { return right - remaining; }
    return left + right;
}
