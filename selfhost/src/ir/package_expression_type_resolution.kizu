import selfhost::ir::builtin_call_identity;
import selfhost::ir::intrinsic_type_contract;
import selfhost::ir::package_type_resolution;
import selfhost::ir::package_type_environment;
import selfhost::ir::package_type_template_resolution;
import selfhost::ir::package_builtin_type_resolution;
import selfhost::ir::package_prepared_types;
import selfhost::ir::package_call_facts;
import selfhost::ir::package_catalog;
import selfhost::ir::package_exact_lookup;
import selfhost::ir::package_function_identity;

pub struct CalleeResolution {
    pub kind: i64,
    pub target_index: i64,
    pub builtin_kind: i64,
    pub builtin_operation: i64,
    pub builtin_identity: []u8,
    pub builtin_result_template: builtin_call_identity::TypeApplyResultTemplate,
}

struct MatchArmType {
    result: package_type_resolution::ResolvedType,
    wildcard: bool,
}

// builtin_call_identity::BuiltinIdentity is the closed resolver-owned classification for calls which
// do not name package functions. Source spellings are accepted only here.
pub fn callee_resolved_kind() -> i64 { return 1; }
pub fn callee_non_package_kind() -> i64 { return 2; }
pub fn callee_unresolved_kind() -> i64 { return 3; }
pub fn callee_unresolved_method_kind() -> i64 { return 4; }

fn source_callee_resolution(target_index: i64) -> CalleeResolution {
    return CalleeResolution {
        kind: callee_resolved_kind(), target_index: target_index,
        builtin_kind: package_call_facts::builtin_none_kind(),
        builtin_operation: package_call_facts::builtin_operation_none(), builtin_identity: "",
        builtin_result_template: builtin_call_identity::TypeApplyResultTemplate {
            shape: builtin_call_identity::TypeApplyResultShape::None,
            intrinsic_kind: -1, actual_slot: -1
        }
    };
}

fn builtin_callee_resolution(identity: &builtin_call_identity::BuiltinIdentity) -> CalleeResolution {
    return CalleeResolution {
        kind: callee_non_package_kind(), target_index: -1,
        builtin_kind: identity.kind, builtin_operation: identity.operation,
        builtin_identity: identity.canonical_identity,
        builtin_result_template: builtin_call_identity::copy_result_template(
            &identity.result_template
        )
    };
}

fn unresolved_callee_resolution(kind: i64) -> CalleeResolution {
    return CalleeResolution {
        kind: kind, target_index: -1, builtin_kind: package_call_facts::builtin_none_kind(),
        builtin_operation: package_call_facts::builtin_operation_none(), builtin_identity: "",
        builtin_result_template: builtin_call_identity::TypeApplyResultTemplate {
            shape: builtin_call_identity::TypeApplyResultShape::None,
            intrinsic_kind: -1, actual_slot: -1
        }
    };
}

fn copy_callee_resolution(resolution: &CalleeResolution) -> CalleeResolution {
    return CalleeResolution {
        kind: resolution.kind, target_index: resolution.target_index,
        builtin_kind: resolution.builtin_kind,
        builtin_operation: resolution.builtin_operation,
        builtin_identity: resolution.builtin_identity,
        builtin_result_template: builtin_call_identity::copy_result_template(
            &resolution.builtin_result_template
        )
    };
}


pub fn resolve_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog, local_types: &package_type_environment::Environment, catalog: &package_catalog::PackageFunctionCatalog, component_id: i64) -> !CalleeResolution {
    let node = ast.get(callee);
    match node.data {
        Var(_) => return resolve_var_callee(
            text, ast, callee, type_store, local_types, catalog, component_id
        );,
        FieldExpr(field) => return resolve_field_callee(text, ast, callee, field.receiver, field.name, field.namespace, type_store, prepared_types, local_types, catalog, component_id);,
        TypeApplyExpr(type_apply) => return resolve_type_apply_callee(
            text, ast, type_apply.callee, type_apply.type_args,
            type_store, prepared_types, local_types, catalog, component_id
        );,
        _ => return unresolved_callee_resolution(callee_unresolved_kind());,
    }
    return unresolved_callee_resolution(callee_unresolved_kind());
}

fn resolve_var_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, type_store: &package_type_resolution::TypeStore, local_types: &package_type_environment::Environment, catalog: &package_catalog::PackageFunctionCatalog, component_id: i64) -> !CalleeResolution {
    let name = node_text(text, ast, callee);
    let local = try package_type_environment::lookup(type_store, local_types, name);
    if local.type_id >= 0 {
        return unresolved_callee_resolution(callee_unresolved_kind());
    }
    let target = try package_exact_lookup::local_function_entry(
        catalog, component_id, name
    );
    if target >= 0 { return source_callee_resolution(target); }
    let builtin = builtin_call_identity::builtin_identity(name);
    if builtin.kind != package_call_facts::builtin_none_kind() {
        return builtin_callee_resolution(&builtin);
    }
    return unresolved_callee_resolution(callee_unresolved_kind());
}

fn resolve_type_apply_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, type_args: std::kizu::ast::ChildRange, type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog, local_types: &package_type_environment::Environment, catalog: &package_catalog::PackageFunctionCatalog, component_id: i64) -> !CalleeResolution {
    let node = ast.get(callee);
    match node.data {
        Var(_) => return resolve_type_apply_var_callee(
            text, ast, callee, type_args,
            type_store, prepared_types, local_types, catalog, component_id
        );,
        FieldExpr(field) => return resolve_type_apply_field_callee(
            text, ast, callee, type_args,
            field.receiver, field.name, field.namespace,
            type_store, prepared_types, local_types, catalog, component_id
        );,
        _ => return unresolved_callee_resolution(callee_unresolved_kind());,
    }
    return unresolved_callee_resolution(callee_unresolved_kind());
}

fn resolve_type_apply_var_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, type_args: std::kizu::ast::ChildRange, type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog, local_types: &package_type_environment::Environment, catalog: &package_catalog::PackageFunctionCatalog, component_id: i64) -> !CalleeResolution {
    let resolution = try resolve_var_callee(
        text, ast, callee, type_store, local_types, catalog, component_id
    );
    if resolution.kind != callee_unresolved_kind() {
        return validate_source_type_application(
            text, ast, type_args, &resolution,
            type_store, prepared_types, local_types, catalog, component_id
        );
    }
    if builtin_call_identity::is_external_type_apply_identity(node_text(text, ast, callee)) {
        let external = builtin_call_identity::external_type_apply_identity(node_text(text, ast, callee));
        return builtin_callee_resolution(&external);
    }
    return unresolved_callee_resolution(callee_unresolved_kind());
}

fn resolve_type_apply_field_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, type_args: std::kizu::ast::ChildRange, receiver: std::kizu::ast::NodeId, name: std::kizu::ast::NodeId, namespace: bool, type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog, local_types: &package_type_environment::Environment, catalog: &package_catalog::PackageFunctionCatalog, component_id: i64) -> !CalleeResolution {
    let resolution = try resolve_field_callee(
        text, ast, callee, receiver, name, namespace, type_store, prepared_types, local_types, catalog, component_id
    );
    if resolution.kind != callee_unresolved_kind() {
        return validate_source_type_application(
            text, ast, type_args, &resolution,
            type_store, prepared_types, local_types, catalog, component_id
        );
    }
    if namespace and builtin_call_identity::is_external_type_apply_identity(node_text(text, ast, callee)) {
        let external = builtin_call_identity::external_type_apply_identity(node_text(text, ast, callee));
        return builtin_callee_resolution(&external);
    }
    return unresolved_callee_resolution(callee_unresolved_kind());
}

fn validate_source_type_application(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    type_args: std::kizu::ast::ChildRange,
    resolution: &CalleeResolution,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !CalleeResolution {
    if resolution.kind != callee_resolved_kind() {
        return copy_callee_resolution(resolution);
    }
    if type_args.len != package_catalog::function_type_parameter_len(
        catalog, resolution.target_index
    ) {
        return error("function type argument arity mismatch");
    }
    var index = 0;
    while index < type_args.len {
        let type_node = try ast.child_at(type_args, index);
        let actual = try resolve_type_spelling(
            catalog, component_id, node_text(text, ast, type_node),
            type_store, prepared_types, local_types
        );
        if actual.type_id < 0 {
            return error("generic call type argument unresolved");
        }
        index = index + 1;
    }
    return copy_callee_resolution(resolution);
}

fn resolve_field_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, receiver: std::kizu::ast::NodeId, name: std::kizu::ast::NodeId, namespace: bool, type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog, local_types: &package_type_environment::Environment, catalog: &package_catalog::PackageFunctionCatalog, component_id: i64) -> !CalleeResolution {
    if namespace {
        let qualified = node_text(text, ast, callee);
        let target = try package_exact_lookup::qualified_function_entry(
            catalog, component_id, qualified
        );
        if target >= 0 { return source_callee_resolution(target); }
        let builtin = builtin_call_identity::builtin_identity(qualified);
        if builtin.kind != package_call_facts::builtin_none_kind() {
            return builtin_callee_resolution(&builtin);
        }
        if try package_exact_lookup::exact_union_variant(
            catalog, component_id, node_text(text, ast, receiver),
            node_text(text, ast, name)
        ) {
            let external = builtin_call_identity::external_shape_builtin_identity(package_call_facts::builtin_operation_union_construct());
            return builtin_callee_resolution(&external);
        }
        return unresolved_callee_resolution(callee_unresolved_kind());
    }
    let receiver_type = try infer_exact_expression_type(
        text, ast, receiver, type_store, prepared_types, local_types, catalog, component_id
    );
    let owner = try package_type_resolution::without_borrow(
        type_store, &receiver_type
    );
    if owner.kind == package_type_resolution::type_kind_declared() {
        let declaration_component = owner.declaration_component_id;
        let external_family =
            try intrinsic_type_contract::external_abi_owned_family_for_declaration(
                package_catalog::component_package_name_at(
                    catalog, declaration_component
                ),
                package_catalog::component_name_at(catalog, declaration_component),
                owner.constructor_name
            );
        if std::mem::len(external_family) > 0 {
            let runtime_method =
                builtin_call_identity::runtime_external_family_method_identity(
                    external_family, node_text(text, ast, name)
                );
            if runtime_method.kind != package_call_facts::builtin_none_kind() {
                return builtin_callee_resolution(&runtime_method);
            }
        }
        let target = try package_exact_lookup::declared_impl_method_entry(
            catalog, owner.declaration_index, node_text(text, ast, name)
        );
        if target >= 0 { return source_callee_resolution(target); }
        return unresolved_callee_resolution(callee_unresolved_method_kind());
    }
    if owner.kind == package_type_resolution::type_kind_intrinsic() and
        owner.declaration_index < 0 {
        let runtime_method = builtin_call_identity::runtime_intrinsic_method_identity(
            owner.intrinsic_kind, node_text(text, ast, name)
        );
        if runtime_method.kind != package_call_facts::builtin_none_kind() {
            return builtin_callee_resolution(&runtime_method);
        }
    }
    return unresolved_callee_resolution(callee_unresolved_method_kind());
}

pub fn infer_exact_expression_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let node = ast.get(node_id);
    match node.data {
        Empty => return resolve_type_spelling(catalog, component_id, "void", type_store, prepared_types, local_types);,
        Int(int_node) => return resolve_type_spelling(catalog, component_id, "i64", type_store, prepared_types, local_types);,
        String(string_node) => return resolve_type_spelling(catalog, component_id, "[]u8", type_store, prepared_types, local_types);,
        Bool(bool_node) => return resolve_type_spelling(catalog, component_id, "bool", type_store, prepared_types, local_types);,
        Var(var_node) => return infer_exact_var_or_function_item_type(
            text, ast, node_id, type_store, local_types, catalog, component_id
        );,
        Prefix(prefix) => return infer_exact_prefix_type(
            text, ast, prefix.op, prefix.right, type_store, prepared_types,
            local_types, catalog, component_id
        );,
        Binary(binary) => return infer_exact_binary_type(
            text, ast, binary.op, binary.left, binary.right,
            type_store, prepared_types, local_types, catalog, component_id
        );,
        DerefExpr(deref) => return infer_exact_dereference_type(
            text, ast, deref.receiver, type_store, prepared_types,
            local_types, catalog, component_id
        );,
        TryExpr(try_expr) => return infer_exact_try_type(
            text, ast, try_expr.value, type_store, prepared_types, local_types,
            catalog, component_id
        );,
        ComptimeExpr(comptime_expr) => return infer_exact_expression_type(text, ast, comptime_expr.value, type_store, prepared_types, local_types, catalog, component_id);,
        CastExpr(cast_expr) => return resolve_type_spelling(catalog, component_id, node_text(text, ast, cast_expr.type_node), type_store, prepared_types, local_types);,
        TypeApplyExpr(type_apply) => return infer_exact_type_apply_expression_type(
            text, ast, node_id, type_apply.callee, type_apply.type_args, type_store,
            prepared_types, local_types, catalog, component_id
        );,
        StructLiteralExpr(struct_literal) => return resolve_type_spelling(catalog, component_id, node_text(text, ast, struct_literal.type_name), type_store, prepared_types, local_types);,
        ArenaNewExpr(arena_new) => return resolve_type_spelling(catalog, component_id, node_text(text, ast, arena_new.type_node), type_store, prepared_types, local_types);,
        FieldExpr(field) => return infer_exact_field_type(text, ast, field.receiver, field.name, field.namespace, type_store, prepared_types, local_types, catalog, component_id);,
        Call(call) => return infer_exact_call_type(
            text, ast, call.callee, call.args, type_store, prepared_types,
            local_types, catalog, component_id
        );,
        IndexExpr(index_expr) => return infer_exact_index_type(text, ast, index_expr.target, index_expr.slice, type_store, prepared_types, local_types, catalog, component_id);,
        Match(match_node) => return infer_exact_match_type(
            text, ast, match_node.value, match_node.arms,
            type_store, prepared_types, local_types, catalog, component_id
        );,
        Block(block) => return infer_exact_block_value_type(
            text, ast, block.statements, type_store, prepared_types,
            local_types, catalog, component_id
        );,
        If(if_node) => return infer_exact_if_type(
            text, ast, if_node.condition, if_node.then_block,
            if_node.else_block, type_store, prepared_types,
            local_types, catalog, component_id
        );,
        ExprStmt(expr_stmt) => return infer_exact_expression_type(
            text, ast, expr_stmt.expr, type_store, prepared_types,
            local_types, catalog, component_id
        );,
        _ => return package_type_resolution::unknown_type();,
    }
}

fn infer_exact_binary_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    op: std::kizu::ast::BinaryOp,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let left_type = try infer_exact_expression_type(
        text, ast, left, type_store, prepared_types, local_types,
        catalog, component_id
    );
    let right_type = try infer_exact_expression_type(
        text, ast, right, type_store, prepared_types, local_types,
        catalog, component_id
    );
    if left_type.type_id < 0 or right_type.type_id < 0 {
        return error("binary operand type unresolved");
    }
    if op == std::kizu::ast::binary_and() or
        op == std::kizu::ast::binary_or() {
        if !package_type_resolution::is_bool_type(&left_type) or
            !package_type_resolution::is_bool_type(&right_type) {
            return error("logical binary operator requires bool operands");
        }
        return package_type_resolution::copy(&left_type);
    }
    if !(try package_type_resolution::same_type(
        type_store, &left_type, &right_type
    )) {
        return error("binary operator operands must have same type");
    }
    if op == std::kizu::ast::binary_eq() or
        op == std::kizu::ast::binary_not_eq() {
        return resolve_type_spelling(
            catalog, component_id, "bool",
            type_store, prepared_types, local_types
        );
    }
    if !package_type_resolution::is_numeric_type(&left_type) {
        return error("binary operator requires numeric operands");
    }
    if op == std::kizu::ast::binary_mod() and
        !package_type_resolution::is_integer_type(&left_type) {
        return error("modulo operator requires integer operands");
    }
    if op == std::kizu::ast::binary_lt() or
        op == std::kizu::ast::binary_lte() or
        op == std::kizu::ast::binary_gt() or
        op == std::kizu::ast::binary_gte() {
        return resolve_type_spelling(
            catalog, component_id, "bool",
            type_store, prepared_types, local_types
        );
    }
    return package_type_resolution::copy(&left_type);
}

fn infer_exact_match_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let inferred_value = try infer_exact_expression_type(
        text, ast, value, type_store, prepared_types, local_types,
        catalog, component_id
    );
    let owner = try package_type_resolution::without_borrow(
        type_store, &inferred_value
    );
    if owner.kind != package_type_resolution::type_kind_declared() or
        owner.declaration_index < 0 {
        return error("match expression requires exact enum or union type");
    }
    let declaration_kind = package_catalog::declared_type_kind_at(
        catalog, owner.declaration_index
    );
    if declaration_kind != package_catalog::declared_type_enum_kind() and
        declaration_kind != package_catalog::declared_type_union_kind() {
        return error("match expression requires exact enum or union type");
    }
    if arms.len == 0 { return error("match expression has no arms"); }
    var seen = std::array::Array<[]u8>(std::mem::page_allocator());
    defer seen.deinit();
    var result = package_type_resolution::unknown_type();
    var has_result = false;
    var wildcard = false;
    var index = 0;
    while index < arms.len {
        let arm_type = try infer_exact_match_arm_node_type(
            text, ast, try ast.child_at(arms, index), index, arms.len, wildcard,
            &owner, declaration_kind, type_store, prepared_types,
            local_types, catalog, component_id, &var seen
        );
        if arm_type.wildcard { wildcard = true; }
        if !has_result {
            result = package_type_resolution::copy(&arm_type.result);
            has_result = true;
        } else {
            if !(try package_type_resolution::same_type(
                type_store, &result, &arm_type.result
            )) { return error("match expression arm types differ"); }
        }
        index = index + 1;
    }
    if !wildcard and seen.len() != package_catalog::declared_match_variant_len(
        catalog, owner.declaration_index
    ) { return error("match expression is not exhaustive"); }
    if !has_result { return error("match expression result type unresolved"); }
    return result;
}

fn infer_exact_block_value_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    if statements.len == 0 {
        return error("expression block must end with a value");
    }
    var block_types = try package_type_environment::clone(
        std::mem::page_allocator(), local_types
    );
    defer block_types.deinit();
    try package_type_environment::enter_scope(&var block_types);
    return infer_exact_current_scope_block_value_type(
        text, ast, statements, type_store, prepared_types,
        &var block_types, catalog, component_id
    );
}

fn infer_exact_current_scope_block_value_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &var package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    if statements.len == 0 {
        return error("expression block must end with a value");
    }
    var index = 0;
    while index + 1 < statements.len {
        try bind_exact_block_statement_type(
            text, ast, try ast.child_at(statements, index),
            type_store, prepared_types, local_types,
            catalog, component_id
        );
        index = index + 1;
    }
    let result = try infer_exact_expression_type(
        text, ast, try ast.child_at(statements, statements.len - 1),
        type_store, prepared_types, local_types, catalog, component_id
    );
    if result.type_id < 0 {
        return error("expression block result type unresolved");
    }
    return result;
}

fn infer_exact_if_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let condition_type = try infer_exact_expression_type(
        text, ast, condition, type_store, prepared_types,
        local_types, catalog, component_id
    );
    if !package_type_resolution::is_bool_type(&condition_type) {
        return error("if expression condition must be bool");
    }
    let else_node = ast.get(else_block);
    match else_node.data {
        Empty => return error("if expression requires else branch");,
        _ => return infer_exact_if_branch_types(
            text, ast, then_block, else_block, type_store,
            prepared_types, local_types, catalog, component_id
        );,
    }
}

fn infer_exact_if_branch_types(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let then_type = try infer_exact_expression_type(
        text, ast, then_block, type_store, prepared_types,
        local_types, catalog, component_id
    );
    let else_type = try infer_exact_expression_type(
        text, ast, else_block, type_store, prepared_types,
        local_types, catalog, component_id
    );
    if then_type.type_id < 0 or else_type.type_id < 0 {
        return error("if expression branch result type unresolved");
    }
    if !(try package_type_resolution::same_type(
        type_store, &then_type, &else_type
    )) { return error("if expression branch types differ"); }
    return package_type_resolution::copy(&then_type);
}

fn bind_exact_block_statement_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &var package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !void {
    let node = ast.get(statement);
    match node.data {
        Let(let_node) => return bind_exact_block_let_type(
            text, ast, &let_node, type_store, prepared_types,
            local_types, catalog, component_id
        );,
        Return(return_node) => return error(
            "expression block cannot contain early return"
        );,
        _ => return;,
    }
}

fn bind_exact_block_let_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    let_node: &std::kizu::ast::LetNode,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &var package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !void {
    let value_type = try infer_exact_expression_type(
        text, ast, let_node.value, type_store, prepared_types,
        local_types, catalog, component_id
    );
    return package_type_environment::insert(
        local_types, node_text(text, ast, let_node.name), value_type
    );
}

fn infer_exact_match_arm_node_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    arm_node_id: std::kizu::ast::NodeId,
    arm_index: i64,
    arm_len: i64,
    wildcard_seen: bool,
    owner: &package_type_resolution::ResolvedType,
    declaration_kind: i64,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64,
    seen: &var std::array::Array<[]u8>
) -> !MatchArmType {
    let node = ast.get(arm_node_id);
    match node.data {
        MatchArm(arm) => return infer_exact_match_arm_type(
            text, ast, &arm, arm_index, arm_len, wildcard_seen,
            owner, declaration_kind, type_store, prepared_types,
            local_types, catalog, component_id, seen
        );,
        _ => return error("match expression member is not MatchArm");,
    }
}

fn infer_exact_match_arm_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    arm: &std::kizu::ast::MatchArmNode,
    arm_index: i64,
    arm_len: i64,
    wildcard_seen: bool,
    owner: &package_type_resolution::ResolvedType,
    declaration_kind: i64,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64,
    seen: &var std::array::Array<[]u8>
) -> !MatchArmType {
    let pattern = node_text(text, ast, arm.pattern);
    let binding = node_text(text, ast, arm.binding);
    let wildcard = std::mem::equal_bytes(pattern, "_");
    if wildcard {
        if wildcard_seen { return error("duplicate wildcard match arm"); }
        if arm_index + 1 != arm_len {
            return error("wildcard match arm must be last");
        }
        if std::mem::len(binding) != 0 {
            return error("wildcard match arm cannot bind payload");
        }
    } else {
        if !package_catalog::declared_match_variant_exists(
            catalog, owner.declaration_index, pattern
        ) { return error("unknown match variant"); }
        if contains_name(seen, pattern) {
            return error("duplicate match variant");
        }
        try seen.append(pattern);
    }
    var arm_types = try package_type_environment::clone(
        std::mem::page_allocator(), local_types
    );
    defer arm_types.deinit();
    try package_type_environment::enter_scope(&var arm_types);
    if std::mem::len(binding) > 0 {
        if declaration_kind == package_catalog::declared_type_enum_kind() {
            return error("enum match arm cannot bind payload");
        }
        let payload = try package_prepared_types::instantiate_union_payload(
            prepared_types, catalog, type_store, owner, pattern
        );
        try package_type_environment::insert(&var arm_types, binding, payload);
    }
    let result = try infer_exact_match_arm_body_type(
        text, ast, arm.body, type_store, prepared_types,
        &var arm_types, catalog, component_id
    );
    if result.type_id < 0 {
        return error("match expression arm result type unresolved");
    }
    return MatchArmType {
        result: package_type_resolution::copy(&result),
        wildcard: wildcard
    };
}

fn infer_exact_match_arm_body_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &var package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let node = ast.get(body);
    match node.data {
        Block(block) => return infer_exact_current_scope_block_value_type(
            text, ast, block.statements, type_store, prepared_types,
            local_types, catalog, component_id
        );,
        _ => return infer_exact_expression_type(
            text, ast, body, type_store, prepared_types,
            local_types, catalog, component_id
        );,
    }
}

fn contains_name(names: &std::array::Array<[]u8>, wanted: []u8) -> bool {
    var index = 0;
    while index < names.len() {
        if std::mem::equal_bytes(names.get_or_panic(index), wanted) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn infer_exact_type_apply_expression_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    type_apply: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    if std::mem::equal_bytes(node_text(text, ast, callee), "type") {
        return resolve_type_spelling(
            catalog, component_id, "type", type_store, prepared_types, local_types
        );
    }
    let resolution = try resolve_callee(
        text, ast, type_apply, type_store, prepared_types,
        local_types, catalog, component_id
    );
    if resolution.kind == callee_resolved_kind() {
        var actuals = std::array::Array<i64>(std::mem::page_allocator());
        defer actuals.deinit();
        var index = 0;
        while index < type_args.len {
            let type_node = try ast.child_at(type_args, index);
            let actual = try resolve_type_spelling(
                catalog, component_id, node_text(text, ast, type_node),
                type_store, prepared_types, local_types
            );
            if actual.type_id < 0 {
                return error("function item type argument unresolved");
            }
            try actuals.append(actual.type_id);
            index = index + 1;
        }
        return function_item_type(
            type_store, catalog, component_id, resolution.target_index, &actuals
        );
    }
    return resolve_type_spelling(
        catalog, component_id, node_text(text, ast, type_apply),
        type_store, prepared_types, local_types
    );
}

fn infer_exact_prefix_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    op: std::kizu::ast::PrefixOp,
    right: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let value = try infer_exact_expression_type(
        text, ast, right, type_store, prepared_types, local_types,
        catalog, component_id
    );
    if op == std::kizu::ast::prefix_borrow() {
        return package_type_resolution::builtin_borrow(type_store, &value, false);
    }
    if op == std::kizu::ast::prefix_mut_borrow() {
        return package_type_resolution::builtin_borrow(type_store, &value, true);
    }
    return package_type_resolution::copy(&value);
}

fn infer_exact_dereference_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let receiver_type = try infer_exact_expression_type(
        text, ast, receiver, type_store, prepared_types, local_types,
        catalog, component_id
    );
    return package_type_resolution::dereference_type(type_store, &receiver_type);
}

fn infer_exact_try_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let inferred = try infer_exact_expression_type(
        text, ast, value, type_store, prepared_types, local_types, catalog, component_id
    );
    return package_type_resolution::success_type(type_store, &inferred);
}

fn exact_var_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    type_store: &package_type_resolution::TypeStore,
    local_types: &package_type_environment::Environment
) -> !package_type_resolution::ResolvedType {
    let name = node_text(text, ast, node_id);
    return package_type_environment::lookup(type_store, local_types, name);
}

fn infer_exact_var_or_function_item_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let local = try exact_var_type(text, ast, node_id, type_store, local_types);
    if local.type_id >= 0 { return local; }
    let target_index = try package_exact_lookup::local_function_entry(
        catalog, component_id, node_text(text, ast, node_id)
    );
    if target_index < 0 { return package_type_resolution::unknown_type(); }
    var actuals = std::array::Array<i64>(std::mem::page_allocator());
    defer actuals.deinit();
    return function_item_type(
        type_store, catalog, component_id, target_index, &actuals
    );
}

fn function_item_type(
    type_store: &var package_type_resolution::TypeStore,
    catalog: &package_catalog::PackageFunctionCatalog,
    spelling_component_id: i64,
    target_index: i64,
    actuals: &std::array::Array<i64>
) -> !package_type_resolution::ResolvedType {
    if actuals.len() != package_catalog::function_type_parameter_len(
        catalog, target_index
    ) {
        return error("function item type argument arity mismatch");
    }
    let target = try package_catalog::target_at_entry(catalog, target_index);
    return package_type_resolution::function_item(
        type_store, spelling_component_id,
        package_function_identity::target_component_value(&target),
        package_function_identity::target_function_value(&target), actuals
    );
}

fn infer_exact_field_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    if namespace {
        return infer_exact_namespace_variant_type(
            text, ast, receiver, name, type_store, prepared_types,
            local_types, catalog, component_id
        );
    }
    let receiver_type = try infer_exact_expression_type(
        text, ast, receiver, type_store, prepared_types, local_types, catalog, component_id
    );
    let owner = try package_type_resolution::without_borrow(
        type_store, &receiver_type
    );
    return package_prepared_types::instantiate_struct_field(
        prepared_types, catalog, type_store, &owner,
        node_text(text, ast, name)
    );
}

fn infer_exact_namespace_variant_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let owner = try resolve_type_spelling(
        catalog, component_id, node_text(text, ast, receiver),
        type_store, prepared_types, local_types
    );
    if owner.kind != package_type_resolution::type_kind_declared() or
        owner.declaration_index < 0 {
        return error("namespace value owner is not an exact declared type");
    }
    let declaration_kind = package_catalog::declared_type_kind_at(
        catalog, owner.declaration_index
    );
    if declaration_kind != package_catalog::declared_type_enum_kind() and
        declaration_kind != package_catalog::declared_type_union_kind() {
        return error("namespace value owner is not an enum or union");
    }
    let variant = node_text(text, ast, name);
    if !package_catalog::declared_match_variant_exists(
        catalog, owner.declaration_index, variant
    ) { return error("namespace enum or union variant not found"); }
    if declaration_kind == package_catalog::declared_type_union_kind() and
        try package_catalog::declared_union_variant_has_payload(
            catalog, owner.declaration_index, variant
        ) {
        return error("union payload variant requires constructor call");
    }
    return owner;
}

fn infer_exact_call_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let callee_node = ast.get(callee);
    match callee_node.data {
        TypeApplyExpr(type_apply) => return infer_exact_type_apply_call_type(
            text, ast, callee, type_apply.callee, type_apply.type_args,
            type_store, prepared_types, local_types, catalog, component_id
        );,
        FieldExpr(field) => if field.namespace and try package_exact_lookup::exact_union_variant(
            catalog, component_id, node_text(text, ast, field.receiver),
            node_text(text, ast, field.name)
        ) { return resolve_type_spelling(
            catalog, component_id, node_text(text, ast, field.receiver), type_store, prepared_types, local_types
        ); },
        _ => return infer_exact_resolved_call_type(
            text, ast, callee, args, type_store, prepared_types,
            local_types, catalog, component_id
        );,
    }
    return infer_exact_resolved_call_type(
        text, ast, callee, args, type_store, prepared_types,
        local_types, catalog, component_id
    );
}

fn infer_exact_type_apply_call_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    type_apply: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let applied_type = node_text(text, ast, type_apply);
    let external = builtin_call_identity::external_type_apply_identity(
        node_text(text, ast, callee)
    );
    if external.kind != package_call_facts::builtin_none_kind() {
        if external.operation == package_call_facts::builtin_operation_arena_new() {
            return resolve_type_spelling(
                catalog, component_id, applied_type,
                type_store, prepared_types, local_types
            );
        }
        if external.operation == package_call_facts::builtin_operation_ptr_from_int() or
            external.operation == package_call_facts::builtin_operation_int_from_ptr() {
            return resolve_single_type_argument(
                text, ast, type_args, type_store, prepared_types,
                local_types, catalog, component_id
            );
        }
        return error("external type application has no result descriptor");
    }
    let resolution = try resolve_callee(
        text, ast, type_apply, type_store, prepared_types, local_types, catalog, component_id
    );
    var actuals = std::array::Array<i64>(std::mem::page_allocator());
    defer actuals.deinit();
    var index = 0;
    while index < type_args.len {
        let type_node = try ast.child_at(type_args, index);
        let actual = try resolve_type_spelling(
            catalog, component_id, node_text(text, ast, type_node),
            type_store, prepared_types, local_types
        );
        if actual.type_id < 0 { return error("generic call type argument unresolved"); }
        try actuals.append(actual.type_id);
        index = index + 1;
    }
    if resolution.kind == callee_resolved_kind() {
        return package_prepared_types::instantiate_function_return(
            prepared_types, catalog, type_store,
            resolution.target_index, &actuals
        );
    }
    if resolution.kind == callee_non_package_kind() {
        return package_builtin_type_resolution::type_apply_operation_return_type(
            catalog, type_store, local_types, component_id,
            resolution.builtin_identity, &resolution.builtin_result_template, &actuals
        );
    }
    return error("type-applied call has no exact result template");
}

fn resolve_single_type_argument(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    type_args: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    if type_args.len != 1 {
        return error("external type application arity mismatch");
    }
    let type_node = try ast.child_at(type_args, 0);
    let result = try resolve_type_spelling(
        catalog, component_id, node_text(text, ast, type_node),
        type_store, prepared_types, local_types
    );
    if result.type_id < 0 {
        return error("external type application result type unresolved");
    }
    return result;
}

fn infer_exact_resolved_call_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let resolution = try resolve_callee(
        text, ast, callee, type_store, prepared_types, local_types, catalog, component_id
    );
    if resolution.kind == callee_resolved_kind() {
        return resolved_call_return_type(catalog, &resolution, type_store, prepared_types, local_types);
    }
    let callee_node = ast.get(callee);
    match callee_node.data {
        FieldExpr(field) => if !field.namespace {
            let receiver_type = try infer_exact_expression_type(
                text, ast, field.receiver, type_store, prepared_types, local_types, catalog, component_id
            );
            if resolution.builtin_operation == package_call_facts::builtin_operation_task_spawn() {
                return infer_exact_task_spawn_type(
                    text, ast, args, type_store, prepared_types, local_types,
                    catalog, component_id, &receiver_type
                );
            }
            return package_builtin_type_resolution::receiver_operation_return_type(
                catalog, type_store, local_types, &receiver_type,
                resolution.builtin_operation
            );
        } else {
            return package_builtin_type_resolution::free_operation_return_type(
                catalog, type_store, local_types, component_id,
                resolution.builtin_operation, resolution.builtin_identity
            );
        },
        _ => return package_builtin_type_resolution::free_operation_return_type(
            catalog, type_store, local_types, component_id,
            resolution.builtin_operation, resolution.builtin_identity
        );,
    }
    return error("call result type resolution reached unreachable branch");
}

fn infer_exact_task_spawn_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    args: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64,
    receiver: &package_type_resolution::ResolvedType
) -> !package_type_resolution::ResolvedType {
    if args.len < 1 { return error("task spawn has no worker argument"); }
    let worker_node = try ast.child_at(args, 0);
    let worker_ast = ast.get(worker_node);
    match worker_ast.data {
        Var(_) => return exact_task_spawn_worker_type(
            text, ast, worker_node, type_store, prepared_types,
            catalog, component_id, receiver
        );,
        TypeApplyExpr(type_apply) => return exact_generic_task_spawn_worker_type(
            text, ast, worker_node, type_apply.type_args,
            type_store, prepared_types, local_types, catalog,
            component_id, receiver
        );,
        _ => return error("task spawn worker is not an exact function variable");,
    }
    return error("task spawn worker is not an exact function variable");
}

fn exact_generic_task_spawn_worker_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    worker_node: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64,
    receiver: &package_type_resolution::ResolvedType
) -> !package_type_resolution::ResolvedType {
    let resolution = try resolve_callee(
        text, ast, worker_node, type_store, prepared_types,
        local_types, catalog, component_id
    );
    if resolution.kind != callee_resolved_kind() {
        return error("generic task spawn worker has no exact function target");
    }
    var actuals = std::array::Array<i64>(std::mem::page_allocator());
    defer actuals.deinit();
    var index = 0;
    while index < type_args.len {
        let type_node = try ast.child_at(type_args, index);
        let actual = try resolve_type_spelling(
            catalog, component_id, node_text(text, ast, type_node),
            type_store, prepared_types, local_types
        );
        if actual.type_id < 0 {
            return error("generic task spawn worker type argument unresolved");
        }
        try actuals.append(actual.type_id);
        index = index + 1;
    }
    let worker_result = try package_prepared_types::instantiate_function_return(
        prepared_types, catalog, type_store, resolution.target_index, &actuals
    );
    return package_builtin_type_resolution::task_spawn_return_type(
        type_store, receiver, &worker_result
    );
}

fn exact_task_spawn_worker_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    worker_node: std::kizu::ast::NodeId,
    type_store: &var package_type_resolution::TypeStore,
    prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64,
    receiver: &package_type_resolution::ResolvedType
) -> !package_type_resolution::ResolvedType {
    let worker = try package_exact_lookup::local_function_entry(
        catalog, component_id, node_text(text, ast, worker_node)
    );
    if worker < 0 { return error("task spawn worker function not found"); }
    if package_catalog::function_type_parameter_len(catalog, worker) != 0 {
        return error("generic task spawn worker requires explicit type application");
    }
    let worker_result = try package_prepared_types::function_return(
        prepared_types, type_store, worker
    );
    return package_builtin_type_resolution::task_spawn_return_type(
        type_store, receiver, &worker_result
    );
}

fn resolved_call_return_type(
    catalog: &package_catalog::PackageFunctionCatalog,
    resolution: &CalleeResolution,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment
) -> !package_type_resolution::ResolvedType {
    if resolution.kind == callee_resolved_kind() {
        var actuals = std::array::Array<i64>(std::mem::page_allocator());
        defer actuals.deinit();
        return package_prepared_types::instantiate_function_return(
            prepared_types, catalog, type_store,
            resolution.target_index, &actuals
        );
    }
    return package_type_resolution::unknown_type();
}

pub fn resolve_type_spelling(
    catalog: &package_catalog::PackageFunctionCatalog,
    spelling_component_id: i64,
    full_spelling: []u8,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment
) -> !package_type_resolution::ResolvedType {
    return package_type_template_resolution::resolve_in_environment(
        catalog, spelling_component_id, full_spelling, type_store, local_types
    );
}

fn infer_exact_index_type(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    slice: bool,
    type_store: &var package_type_resolution::TypeStore, prepared_types: &var package_prepared_types::PreparedTypeCatalog,
    local_types: &package_type_environment::Environment,
    catalog: &package_catalog::PackageFunctionCatalog,
    component_id: i64
) -> !package_type_resolution::ResolvedType {
    let inferred_target = try infer_exact_expression_type(
        text, ast, target, type_store, prepared_types, local_types, catalog, component_id
    );
    let target_type = try package_type_resolution::without_borrow(
        type_store, &inferred_target
    );
    if target_type.kind == package_type_resolution::type_kind_slice() {
        if slice { return package_type_resolution::copy(&target_type); }
        return package_type_resolution::type_child(type_store, &target_type, 0);
    }
    if target_type.kind == package_type_resolution::type_kind_intrinsic() and
        target_type.intrinsic_kind == package_type_resolution::intrinsic_array_kind() {
        return package_type_resolution::type_argument(type_store, &target_type, 0);
    }
    return package_type_resolution::unknown_type();
}

fn node_text(text: []u8, ast: &std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> []u8 {
    let span = ast.get(node_id).span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
