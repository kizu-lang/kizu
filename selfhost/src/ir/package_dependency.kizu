import selfhost::parser;
import selfhost::source;

// Package-wide numeric identities used after name resolution. Names are kept by
// the catalog for diagnostics and resolver lookup only; closure and backend
// consumers use ComponentId / FunctionId exclusively.

pub struct ComponentId {
    pub value: i64,
}

pub struct FunctionId {
    pub value: i64,
}

pub struct FunctionTarget {
    pub component: ComponentId,
    pub function: FunctionId,
}

pub struct CallDependency {
    pub call_node: std::kizu::ast::NodeId,
    pub caller: FunctionTarget,
    pub target: FunctionTarget,
}

// DependencyRecord is the explicit IR handoff. It intentionally contains no
// source, callee, symbol, or LLVM spelling.
pub struct DependencyRecord {
    pub caller_component_id: i64,
    pub caller_function_id: i64,
    pub target_component_id: i64,
    pub target_function_id: i64,
}

pub struct DependencyGraph {
    caller_component_ids: std::array::Array<i64>,
    caller_function_ids: std::array::Array<i64>,
    target_component_ids: std::array::Array<i64>,
    target_function_ids: std::array::Array<i64>,
    adjacency_starts: std::array::Array<i64>,
    adjacency_lens: std::array::Array<i64>,
}

// ResolvedCallTargets is the checker/resolver-owned per-call-node handoff.
// NodeId values are used only while their owning parsed AST remains alive.
pub struct ResolvedCallTargets {
    caller_component_ids: std::array::Array<i64>,
    caller_function_ids: std::array::Array<i64>,
    call_nodes: std::array::Array<std::kizu::ast::NodeId>,
    call_starts: std::array::Array<i64>,
    call_ends: std::array::Array<i64>,
    target_component_ids: std::array::Array<i64>,
    target_function_ids: std::array::Array<i64>,
}

// CalleeResolution is the resolver boundary between source-shaped calls and
// numeric package dependency identities. A non-package result is deliberate;
// an unresolved result is never allowed to disappear from the graph.
struct CalleeResolution {
    kind: i64,
    target_index: i64,
}

fn callee_resolved_kind() -> i64 { return 1; }
fn callee_non_package_kind() -> i64 { return 2; }
fn callee_unresolved_kind() -> i64 { return 3; }
fn callee_unresolved_method_kind() -> i64 { return 4; }

pub struct FunctionTargetQueue {
    component_ids: std::array::Array<i64>,
    function_ids: std::array::Array<i64>,
    enqueued: std::array::Array<i64>,
}

pub struct EmittedTargets {
    slots: std::array::Array<i64>,
}

pub fn emitted_targets(allocator: Allocator, catalog: &PackageFunctionCatalog) -> !EmittedTargets {
    var emitted = EmittedTargets { slots: std::array::Array<i64>(allocator) };
    var index = 0;
    while index < function_len(catalog) {
        try emitted.slots.append(0);
        index = index + 1;
    }
    return emitted;
}

pub fn claim(
    emitted: &var EmittedTargets,
    catalog: &PackageFunctionCatalog,
    target: &FunctionTarget
) -> !bool {
    let slot = try target_slot(catalog, copy_target(target));
    if try emitted.slots.get(slot) != 0 { return false; }
    try emitted.slots.set(slot, 1);
    return true;
}

pub fn source_function_target(
    catalog: &PackageFunctionCatalog,
    file: &source::SourceFile,
    local_name: []u8
) -> !FunctionTarget {
    return resolve_call(catalog, package_prefix(file), source::module_path(file), local_name);
}

pub fn function_target_queue(allocator: Allocator, catalog: &PackageFunctionCatalog) -> !FunctionTargetQueue {
    var queue = FunctionTargetQueue {
        component_ids: std::array::Array<i64>(allocator),
        function_ids: std::array::Array<i64>(allocator),
        enqueued: std::array::Array<i64>(allocator)
    };
    var index = 0;
    while index < catalog.function_names.len() {
        try queue.enqueued.append(0);
        index = index + 1;
    }
    return queue;
}

pub fn queue_len(queue: &FunctionTargetQueue) -> i64 {
    return queue.component_ids.len();
}

pub fn queue_target(queue: &FunctionTargetQueue, index: i64) -> !FunctionTarget {
    return FunctionTarget {
        component: ComponentId { value: try queue.component_ids.get(index) },
        function: FunctionId { value: try queue.function_ids.get(index) }
    };
}

pub fn queue_append(queue: &var FunctionTargetQueue, catalog: &PackageFunctionCatalog, target: FunctionTarget) -> !void {
    let component_id = target.component.value;
    let function_id = target.function.value;
    let slot = try target_slot(catalog, target);
    if try queue.enqueued.get(slot) == 0 {
        try queue.component_ids.append(component_id);
        try queue.function_ids.append(function_id);
        try queue.enqueued.set(slot, 1);
    }
    return;
}

pub fn queue_append_dependencies(
    queue: &var FunctionTargetQueue,
    catalog: &PackageFunctionCatalog,
    graph: &DependencyGraph,
    function: FunctionTarget
) -> !void {
    return append_closure_targets(
        function, graph, catalog, queue
    );
}

pub fn append_target_qualified_name(
    out: &var std::string::String,
    catalog: &PackageFunctionCatalog,
    target: FunctionTarget
) -> !void {
    let index = find_target(catalog, target);
    if index < 0 { return error("resolved function target not found"); }
    let component = try catalog.function_component_ids.get(index);
    try out.append_bytes(try catalog.component_package_names.get(component));
    try out.append_bytes("::");
    try out.append_bytes(try catalog.component_names.get(component));
    try out.append_bytes("::");
    try out.append_bytes(try catalog.function_names.get(index));
    return;
}

pub fn target_local_name(
    catalog: &PackageFunctionCatalog,
    target: FunctionTarget
) -> ![]u8 {
    let index = find_target(catalog, target);
    if index < 0 { return error("resolved function target not found"); }
    return catalog.function_names.get(index);
}

pub fn function_len(catalog: &PackageFunctionCatalog) -> i64 {
    return catalog.function_names.len();
}

pub fn resolved_call_target(
    calls: &ResolvedCallTargets,
    caller_component_id: i64,
    ast: &std::kizu::ast::Ast,
    call_node: std::kizu::ast::NodeId
) -> !FunctionTarget {
    let call_span = ast.get(call_node).span;
    var index = 0;
    while index < calls.call_nodes.len() {
        if try calls.caller_component_ids.get(index) == caller_component_id and
            try calls.call_starts.get(index) == call_span.start and
            try calls.call_ends.get(index) == call_span.end {
            return FunctionTarget {
                component: ComponentId { value: try calls.target_component_ids.get(index) },
                function: FunctionId { value: try calls.target_function_ids.get(index) }
            };
        }
        index = index + 1;
    }
    return error("resolved call target not found");
}

pub fn resolved_call_targets(allocator: Allocator) -> ResolvedCallTargets {
    return ResolvedCallTargets {
        caller_component_ids: std::array::Array<i64>(allocator),
        caller_function_ids: std::array::Array<i64>(allocator),
        call_nodes: std::array::Array<std::kizu::ast::NodeId>(allocator),
        call_starts: std::array::Array<i64>(allocator),
        call_ends: std::array::Array<i64>(allocator),
        target_component_ids: std::array::Array<i64>(allocator),
        target_function_ids: std::array::Array<i64>(allocator)
    };
}

pub fn resolved_call_len(calls: &ResolvedCallTargets) -> i64 { return calls.call_nodes.len(); }

pub fn append_resolved_call(
    calls: &var ResolvedCallTargets,
    ast: &std::kizu::ast::Ast,
    call_node: std::kizu::ast::NodeId,
    caller: FunctionTarget,
    target: FunctionTarget
) -> !void {
    let caller_component_id = caller.component.value;
    let caller_function_id = caller.function.value;
    let target_component_id = target.component.value;
    let target_function_id = target.function.value;
    try calls.caller_component_ids.append(caller_component_id);
    try calls.caller_function_ids.append(caller_function_id);
    try calls.call_nodes.append(call_node);
    let call_span = ast.get(call_node).span;
    try calls.call_starts.append(call_span.start);
    try calls.call_ends.append(call_span.end);
    try calls.target_component_ids.append(target_component_id);
    try calls.target_function_ids.append(target_function_id);
    return;
}

pub fn append_resolved_dependencies(
    graph: &var DependencyGraph,
    catalog: &PackageFunctionCatalog,
    calls: &ResolvedCallTargets
) -> !void {
    var index = 0;
    while index < calls.call_nodes.len() {
        try append_dependency(graph, catalog, DependencyRecord {
            caller_component_id: try calls.caller_component_ids.get(index),
            caller_function_id: try calls.caller_function_ids.get(index),
            target_component_id: try calls.target_component_ids.get(index),
            target_function_id: try calls.target_function_ids.get(index)
        });
        index = index + 1;
    }
    return;
}

// resolve_package_calls is pass two of package identity construction. It walks
// every function body while its parsed AST is alive and records the exact
// numeric target for calls which name package functions. Known non-package
// runtime/external shapes are omitted explicitly; package-shaped misses fail.
pub fn resolve_package_calls(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed_files: &parser::ParsedSourceFiles,
    catalog: &PackageFunctionCatalog
) -> !ResolvedCallTargets {
    var calls = resolved_call_targets(allocator);
    let parsed_results = &parsed_files.parsed;
    var parsed_index = 0;
    while parsed_index < parsed_results.len() {
        let source_index = try parsed_files.source_indexes.get(parsed_index);
        let file = try files.at(source_index);
        let parsed = try parsed_results.at(parsed_index);
        let component_id = find_component(catalog, package_prefix(file), source::module_path(file));
        if component_id < 0 {
            return error("resolver component not found");
        }
        try resolve_calls_node(
            file.text, &parsed.ast, parsed.root, catalog, component_id,
            FunctionTarget { component: ComponentId { value: component_id }, function: FunctionId { value: -1 } },
            std::kizu::ast::ChildRange { start: 0, len: 0 }, &var calls
        );
        parsed_index = parsed_index + 1;
    }
    return calls;
}

fn resolve_calls_node(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    catalog: &PackageFunctionCatalog,
    component_id: i64,
    caller: FunctionTarget,
    params: std::kizu::ast::ChildRange,
    calls: &var ResolvedCallTargets
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return resolve_calls_range(text, ast, program.declarations, catalog, component_id, copy_target(&caller), params, calls);,
        ImplDecl(impl_decl) => return resolve_calls_range(text, ast, impl_decl.methods, catalog, component_id, copy_target(&caller), params, calls);,
        FnDecl(fn_decl) => return resolve_function_calls(text, ast, node_id, fn_decl.name, fn_decl.params, fn_decl.body, catalog, component_id, calls);,
        Call(call) => return resolve_call_node(text, ast, node_id, call.callee, call.args, catalog, component_id, copy_target(&caller), params, calls);,
        Prefix(prefix) => return resolve_calls_node(text, ast, prefix.right, catalog, component_id, copy_target(&caller), params, calls);,
        Binary(binary) => return resolve_calls_two(text, ast, binary.left, binary.right, catalog, component_id, copy_target(&caller), params, calls);,
        FieldExpr(field) => return resolve_calls_node(text, ast, field.receiver, catalog, component_id, copy_target(&caller), params, calls);,
        DerefExpr(deref) => return resolve_calls_node(text, ast, deref.receiver, catalog, component_id, copy_target(&caller), params, calls);,
        TypeApplyExpr(type_apply) => return resolve_calls_node_range(text, ast, type_apply.callee, type_apply.type_args, catalog, component_id, copy_target(&caller), params, calls);,
        CastExpr(cast_expr) => return resolve_calls_two(text, ast, cast_expr.type_node, cast_expr.value, catalog, component_id, copy_target(&caller), params, calls);,
        IndexExpr(index_expr) => return resolve_calls_three(text, ast, index_expr.target, index_expr.start, index_expr.end, catalog, component_id, copy_target(&caller), params, calls);,
        StructLiteralExpr(struct_literal) => return resolve_calls_node_range(text, ast, struct_literal.type_name, struct_literal.fields, catalog, component_id, copy_target(&caller), params, calls);,
        StructFieldInit(field_init) => return resolve_calls_two(text, ast, field_init.name, field_init.value, catalog, component_id, copy_target(&caller), params, calls);,
        ArenaNewExpr(arena_new) => return resolve_calls_two(text, ast, arena_new.type_node, arena_new.allocator, catalog, component_id, copy_target(&caller), params, calls);,
        TryExpr(try_expr) => return resolve_calls_node(text, ast, try_expr.value, catalog, component_id, copy_target(&caller), params, calls);,
        ComptimeExpr(comptime_expr) => return resolve_calls_node(text, ast, comptime_expr.value, catalog, component_id, copy_target(&caller), params, calls);,
        Block(block) => return resolve_calls_range(text, ast, block.statements, catalog, component_id, copy_target(&caller), params, calls);,
        If(if_node) => return resolve_calls_three(text, ast, if_node.condition, if_node.then_block, if_node.else_block, catalog, component_id, copy_target(&caller), params, calls);,
        Let(let_node) => return resolve_calls_two(text, ast, let_node.name, let_node.value, catalog, component_id, copy_target(&caller), params, calls);,
        Assign(assign) => return resolve_calls_two(text, ast, assign.target, assign.value, catalog, component_id, copy_target(&caller), params, calls);,
        Return(return_node) => return resolve_calls_node(text, ast, return_node.value, catalog, component_id, copy_target(&caller), params, calls);,
        Defer(defer_node) => return resolve_calls_node(text, ast, defer_node.expr, catalog, component_id, copy_target(&caller), params, calls);,
        ErrDefer(err_defer_node) => return resolve_calls_node(text, ast, err_defer_node.expr, catalog, component_id, copy_target(&caller), params, calls);,
        ExprStmt(expr_stmt) => return resolve_calls_node(text, ast, expr_stmt.expr, catalog, component_id, copy_target(&caller), params, calls);,
        While(while_node) => return resolve_calls_three(text, ast, while_node.label, while_node.condition, while_node.body, catalog, component_id, copy_target(&caller), params, calls);,
        For(for_node) => return resolve_calls_five(text, ast, for_node.label, for_node.name, for_node.start, for_node.end, for_node.body, catalog, component_id, copy_target(&caller), params, calls);,
        Match(match_node) => return resolve_calls_node_range(text, ast, match_node.value, match_node.arms, catalog, component_id, copy_target(&caller), params, calls);,
        MatchArm(match_arm) => return resolve_calls_three(text, ast, match_arm.pattern, match_arm.binding, match_arm.body, catalog, component_id, copy_target(&caller), params, calls);,
        Unsafe(unsafe_node) => return resolve_calls_node(text, ast, unsafe_node.body, catalog, component_id, copy_target(&caller), params, calls);,
        ComptimeIf(comptime_if) => return resolve_calls_three(text, ast, comptime_if.condition, comptime_if.then_block, comptime_if.else_block, catalog, component_id, copy_target(&caller), params, calls);,
        _ => return;,
    }
}

fn resolve_function_calls(text: []u8, ast: &std::kizu::ast::Ast, declaration: std::kizu::ast::NodeId, name: std::kizu::ast::NodeId, params: std::kizu::ast::ChildRange, body: std::kizu::ast::NodeId, catalog: &PackageFunctionCatalog, component_id: i64, calls: &var ResolvedCallTargets) -> !void {
    let name_span = ast.get(name).span;
    let entry = find_function_by_span(catalog, component_id, name_span.start, name_span.end);
    if entry < 0 { return error("resolver caller not found"); }
    return resolve_calls_node(text, ast, body, catalog, component_id, try target_at(catalog, entry), params, calls);
}

fn resolve_call_node(text: []u8, ast: &std::kizu::ast::Ast, call_node: std::kizu::ast::NodeId, callee: std::kizu::ast::NodeId, args: std::kizu::ast::ChildRange, catalog: &PackageFunctionCatalog, component_id: i64, caller: FunctionTarget, params: std::kizu::ast::ChildRange, calls: &var ResolvedCallTargets) -> !void {
    if caller.function.value >= 0 {
        let resolution = try resolve_callee(text, ast, callee, params, catalog, component_id);
        if resolution.kind == callee_unresolved_kind() { return error("unresolved qualified package call target"); }
        if resolution.kind == callee_unresolved_method_kind() { return error("unresolved receiver package method target"); }
        if resolution.kind == callee_resolved_kind() {
            try append_resolved_call(calls, ast, call_node, copy_target(&caller), try target_at(catalog, resolution.target_index));
        }
    }
    try resolve_calls_node(text, ast, callee, catalog, component_id, copy_target(&caller), params, calls);
    return resolve_calls_range(text, ast, args, catalog, component_id, copy_target(&caller), params, calls);
}

fn resolve_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, params: std::kizu::ast::ChildRange, catalog: &PackageFunctionCatalog, component_id: i64) -> !CalleeResolution {
    let node = ast.get(callee);
    match node.data {
        Var(_) => return resolve_var_callee(text, ast, callee, catalog, component_id);,
        FieldExpr(field) => return resolve_field_callee(text, ast, callee, field.receiver, field.name, field.namespace, params, catalog);,
        _ => return CalleeResolution { kind: callee_non_package_kind(), target_index: -1 };,
    }
    return CalleeResolution { kind: callee_non_package_kind(), target_index: -1 };
}

fn resolve_var_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, catalog: &PackageFunctionCatalog, component_id: i64) -> CalleeResolution {
    let target = find_function(catalog, component_id, node_text(text, ast, callee));
    if target >= 0 { return CalleeResolution { kind: callee_resolved_kind(), target_index: target }; }
    return CalleeResolution { kind: callee_non_package_kind(), target_index: -1 };
}

fn resolve_field_callee(text: []u8, ast: &std::kizu::ast::Ast, callee: std::kizu::ast::NodeId, receiver: std::kizu::ast::NodeId, name: std::kizu::ast::NodeId, namespace: bool, params: std::kizu::ast::ChildRange, catalog: &PackageFunctionCatalog) -> !CalleeResolution {
    if namespace {
        let qualified = node_text(text, ast, callee);
        let target = find_qualified_function(catalog, qualified);
        if target >= 0 { return CalleeResolution { kind: callee_resolved_kind(), target_index: target }; }
        if qualified_mentions_catalog_std_component(qualified, catalog) {
            return CalleeResolution { kind: callee_non_package_kind(), target_index: -1 };
        }
        if qualified_mentions_catalog_component(qualified, catalog) {
            return CalleeResolution { kind: callee_unresolved_kind(), target_index: -1 };
        }
        return CalleeResolution { kind: callee_non_package_kind(), target_index: -1 };
    }
    let receiver_type = try find_param_type(text, ast, params, node_text(text, ast, receiver));
    if std::mem::len(receiver_type) == 0 {
        return CalleeResolution { kind: callee_non_package_kind(), target_index: -1 };
    }
    let target = find_type_method(catalog, receiver_type, node_text(text, ast, name));
    if target >= 0 { return CalleeResolution { kind: callee_resolved_kind(), target_index: target }; }
    if type_mentions_catalog_std_component(receiver_type, catalog) {
        return CalleeResolution { kind: callee_non_package_kind(), target_index: -1 };
    }
    return CalleeResolution { kind: callee_unresolved_method_kind(), target_index: -1 };
}

fn type_mentions_catalog_std_component(type_name: []u8, catalog: &PackageFunctionCatalog) -> bool {
    var component = 0;
    while component < catalog.component_names.len() {
        if std::mem::equal_bytes(catalog.component_package_names.get_or_panic(component), "std") and
            type_mentions_component(type_name, "std", catalog.component_names.get_or_panic(component)) { return true; }
        component = component + 1;
    }
    return false;
}

fn qualified_mentions_catalog_std_component(qualified: []u8, catalog: &PackageFunctionCatalog) -> bool {
    let trimmed = std::mem::trim_ascii(qualified);
    var component = 0;
    while component < catalog.component_names.len() {
        if std::mem::equal_bytes(catalog.component_package_names.get_or_panic(component), "std") and
            qualified_has_component_prefix(trimmed, "std", catalog.component_names.get_or_panic(component)) { return true; }
        component = component + 1;
    }
    return false;
}

fn qualified_mentions_catalog_component(qualified: []u8, catalog: &PackageFunctionCatalog) -> bool {
    let trimmed = std::mem::trim_ascii(qualified);
    var component = 0;
    while component < catalog.component_names.len() {
        let package_name = catalog.component_package_names.get_or_panic(component);
        let component_name = catalog.component_names.get_or_panic(component);
        if qualified_has_component_prefix(trimmed, package_name, component_name) {
            return true;
        }
        component = component + 1;
    }
    return false;
}

fn qualified_has_component_prefix(value: []u8, package_name: []u8, component_name: []u8) -> bool {
    let package_len = std::mem::len(package_name);
    if std::mem::len(value) <= package_len + 2 or
        !std::mem::equal_bytes(value[0..package_len], package_name) or
        !std::mem::equal_bytes(value[package_len..package_len + 2], "::") { return false; }
    var value_index = package_len + 2;
    var component_index = 0;
    while component_index < std::mem::len(component_name) {
        if std::mem::equal_bytes(component_name[component_index..component_index + 1], "/") {
            if value_index + 2 > std::mem::len(value) or
                !std::mem::equal_bytes(value[value_index..value_index + 2], "::") { return false; }
            value_index = value_index + 2;
        } else {
            if value_index >= std::mem::len(value) or
                !std::mem::equal_bytes(value[value_index..value_index + 1], component_name[component_index..component_index + 1]) { return false; }
            value_index = value_index + 1;
        }
        component_index = component_index + 1;
    }
    return value_index + 2 < std::mem::len(value) and
        std::mem::equal_bytes(value[value_index..value_index + 2], "::");
}

fn find_param_type(text: []u8, ast: &std::kizu::ast::Ast, params: std::kizu::ast::ChildRange, receiver: []u8) -> ![]u8 {
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        let node = ast.get(child);
        match node.data {
            Param(param) => if std::mem::equal_bytes(node_text(text, ast, param.name), receiver) { return node_text(text, ast, param.type_node); },
            _ => return "";,
        }
        index = index + 1;
    }
    return "";
}

fn find_qualified_function(catalog: &PackageFunctionCatalog, qualified: []u8) -> i64 {
    var index = 0;
    while index < catalog.function_names.len() {
        let component = catalog.function_component_ids.get_or_panic(index);
        let package_name = catalog.component_package_names.get_or_panic(component);
        let component_name = catalog.component_names.get_or_panic(component);
        let function_name = catalog.function_names.get_or_panic(index);
        if qualified_matches(qualified, package_name, component_name, function_name) { return index; }
        index = index + 1;
    }
    return -1;
}

fn find_type_method(catalog: &PackageFunctionCatalog, type_name: []u8, method: []u8) -> i64 {
    var index = 0;
    var candidate = -1;
    while index < catalog.function_names.len() {
        let component = catalog.function_component_ids.get_or_panic(index);
        if std::mem::equal_bytes(catalog.function_names.get_or_panic(index), method) and
            type_mentions_owner(type_name, catalog.function_owner_type_names.get_or_panic(index)) {
            if type_mentions_component(type_name, catalog.component_package_names.get_or_panic(component), catalog.component_names.get_or_panic(component)) { return index; }
            if candidate >= 0 { return -1; }
            candidate = index;
        }
        index = index + 1;
    }
    return candidate;
}

fn type_mentions_owner(value: []u8, owner: []u8) -> bool {
    if std::mem::len(owner) == 0 { return false; }
    let trimmed = std::mem::trim_ascii(value);
    let owner_len = std::mem::len(owner);
    if std::mem::len(trimmed) < owner_len { return false; }
    return std::mem::equal_bytes(trimmed[std::mem::len(trimmed) - owner_len..std::mem::len(trimmed)], owner);
}

fn qualified_matches(value: []u8, package_name: []u8, component_name: []u8, function_name: []u8) -> bool {
    let expected_len = std::mem::len(package_name) + 2 + std::mem::len(component_name) + 2 + std::mem::len(function_name);
    if std::mem::len(value) != expected_len { return false; }
    let package_end = std::mem::len(package_name);
    let component_start = package_end + 2;
    let component_end = component_start + std::mem::len(component_name);
    return std::mem::equal_bytes(value[0..package_end], package_name) and
        std::mem::equal_bytes(value[component_start..component_end], component_name) and
        std::mem::equal_bytes(value[component_end + 2..expected_len], function_name);
}

fn type_mentions_component(value: []u8, package_name: []u8, component_name: []u8) -> bool {
    let trimmed = std::mem::trim_ascii(value);
    var start = 0;
    if std::mem::starts_with(trimmed, "&var ") { start = 5; }
    else {
        if std::mem::starts_with(trimmed, "&") { start = 1; }
        else {
            if std::mem::starts_with(trimmed, "var ") { start = 4; }
        }
    }
    let minimum_len = std::mem::len(package_name) + 2 + std::mem::len(component_name) + 2 + 1;
    if std::mem::len(trimmed) - start < minimum_len { return false; }
    let package_end = start + std::mem::len(package_name);
    let component_start = package_end + 2;
    if !std::mem::equal_bytes(trimmed[start..package_end], package_name) { return false; }
    var value_index = component_start;
    var component_index = 0;
    while component_index < std::mem::len(component_name) {
        if std::mem::equal_bytes(component_name[component_index..component_index + 1], "/") {
            if value_index + 2 > std::mem::len(trimmed) or
                !std::mem::equal_bytes(trimmed[value_index..value_index + 2], "::") { return false; }
            value_index = value_index + 2;
        } else {
            if value_index >= std::mem::len(trimmed) or
                !std::mem::equal_bytes(trimmed[value_index..value_index + 1], component_name[component_index..component_index + 1]) { return false; }
            value_index = value_index + 1;
        }
        component_index = component_index + 1;
    }
    return value_index + 2 <= std::mem::len(trimmed) and
        std::mem::equal_bytes(trimmed[value_index..value_index + 2], "::");
}

fn node_text(text: []u8, ast: &std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> []u8 {
    let span = ast.get(node_id).span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}

fn copy_target(target: &FunctionTarget) -> FunctionTarget {
    return FunctionTarget { component: ComponentId { value: target.component.value }, function: FunctionId { value: target.function.value } };
}

fn resolve_calls_range(text: []u8, ast: &std::kizu::ast::Ast, range: std::kizu::ast::ChildRange, catalog: &PackageFunctionCatalog, component_id: i64, caller: FunctionTarget, params: std::kizu::ast::ChildRange, calls: &var ResolvedCallTargets) -> !void { var index = 0; while index < range.len { try resolve_calls_node(text, ast, try ast.child_at(range, index), catalog, component_id, copy_target(&caller), params, calls); index = index + 1; } return; }
fn resolve_calls_two(text: []u8, ast: &std::kizu::ast::Ast, a: std::kizu::ast::NodeId, b: std::kizu::ast::NodeId, catalog: &PackageFunctionCatalog, component_id: i64, caller: FunctionTarget, params: std::kizu::ast::ChildRange, calls: &var ResolvedCallTargets) -> !void { try resolve_calls_node(text, ast, a, catalog, component_id, copy_target(&caller), params, calls); return resolve_calls_node(text, ast, b, catalog, component_id, copy_target(&caller), params, calls); }
fn resolve_calls_three(text: []u8, ast: &std::kizu::ast::Ast, a: std::kizu::ast::NodeId, b: std::kizu::ast::NodeId, c: std::kizu::ast::NodeId, catalog: &PackageFunctionCatalog, component_id: i64, caller: FunctionTarget, params: std::kizu::ast::ChildRange, calls: &var ResolvedCallTargets) -> !void { try resolve_calls_two(text, ast, a, b, catalog, component_id, copy_target(&caller), params, calls); return resolve_calls_node(text, ast, c, catalog, component_id, copy_target(&caller), params, calls); }
fn resolve_calls_five(text: []u8, ast: &std::kizu::ast::Ast, a: std::kizu::ast::NodeId, b: std::kizu::ast::NodeId, c: std::kizu::ast::NodeId, d: std::kizu::ast::NodeId, e: std::kizu::ast::NodeId, catalog: &PackageFunctionCatalog, component_id: i64, caller: FunctionTarget, params: std::kizu::ast::ChildRange, calls: &var ResolvedCallTargets) -> !void { try resolve_calls_three(text, ast, a, b, c, catalog, component_id, copy_target(&caller), params, calls); return resolve_calls_two(text, ast, d, e, catalog, component_id, copy_target(&caller), params, calls); }
fn resolve_calls_node_range(text: []u8, ast: &std::kizu::ast::Ast, node: std::kizu::ast::NodeId, range: std::kizu::ast::ChildRange, catalog: &PackageFunctionCatalog, component_id: i64, caller: FunctionTarget, params: std::kizu::ast::ChildRange, calls: &var ResolvedCallTargets) -> !void { try resolve_calls_node(text, ast, node, catalog, component_id, copy_target(&caller), params, calls); return resolve_calls_range(text, ast, range, catalog, component_id, copy_target(&caller), params, calls); }

pub fn dependency_graph(allocator: Allocator, catalog: &PackageFunctionCatalog) -> !DependencyGraph {
    var graph = DependencyGraph {
        caller_component_ids: std::array::Array<i64>(allocator),
        caller_function_ids: std::array::Array<i64>(allocator),
        target_component_ids: std::array::Array<i64>(allocator),
        target_function_ids: std::array::Array<i64>(allocator),
        adjacency_starts: std::array::Array<i64>(allocator),
        adjacency_lens: std::array::Array<i64>(allocator)
    };
    var index = 0;
    while index < catalog.function_names.len() {
        try graph.adjacency_starts.append(-1);
        try graph.adjacency_lens.append(0);
        index = index + 1;
    }
    return graph;
}

pub fn append_dependency(graph: &var DependencyGraph, catalog: &PackageFunctionCatalog, record: DependencyRecord) -> !void {
    let edge_index = graph.caller_component_ids.len();
    let slot = try target_slot(catalog, FunctionTarget { component: ComponentId { value: record.caller_component_id }, function: FunctionId { value: record.caller_function_id } });
    if try graph.adjacency_starts.get(slot) < 0 {
        try graph.adjacency_starts.set(slot, edge_index);
        try graph.adjacency_lens.set(slot, 1);
    } else {
        let range_len = try graph.adjacency_lens.get(slot);
        if try graph.adjacency_starts.get(slot) + range_len != edge_index {
            return error("dependency caller edges are not contiguous");
        }
        try graph.adjacency_lens.set(slot, range_len + 1);
    }
    try graph.caller_component_ids.append(record.caller_component_id);
    try graph.caller_function_ids.append(record.caller_function_id);
    try graph.target_component_ids.append(record.target_component_id);
    try graph.target_function_ids.append(record.target_function_id);
    return;
}

pub fn dependency_len(graph: &DependencyGraph) -> i64 { return graph.caller_component_ids.len(); }

pub fn dependency_at(graph: &DependencyGraph, index: i64) -> !DependencyRecord {
    return DependencyRecord {
        caller_component_id: try graph.caller_component_ids.get(index),
        caller_function_id: try graph.caller_function_ids.get(index),
        target_component_id: try graph.target_component_ids.get(index),
        target_function_id: try graph.target_function_ids.get(index)
    };
}

pub struct PackageFunctionCatalog {
    component_package_names: std::array::Array<[]u8>,
    component_names: std::array::Array<[]u8>,
    component_function_starts: std::array::Array<i64>,
    function_component_ids: std::array::Array<i64>,
    function_local_ids: std::array::Array<i64>,
    function_names: std::array::Array<[]u8>,
    function_owner_type_names: std::array::Array<[]u8>,
    function_name_starts: std::array::Array<i64>,
    function_name_ends: std::array::Array<i64>,
    // Stable top-level declaration ordinals, never NodeIds borrowed from a
    // temporary parsed AST.
    function_decl_ordinals: std::array::Array<i64>,
    function_method_ordinals: std::array::Array<i64>,
    next_local_ids: std::array::Array<i64>,
}

pub fn init(allocator: Allocator) -> PackageFunctionCatalog {
    return PackageFunctionCatalog {
        component_package_names: std::array::Array<[]u8>(allocator),
        component_names: std::array::Array<[]u8>(allocator),
        component_function_starts: std::array::Array<i64>(allocator),
        function_component_ids: std::array::Array<i64>(allocator),
        function_local_ids: std::array::Array<i64>(allocator),
        function_names: std::array::Array<[]u8>(allocator),
        function_owner_type_names: std::array::Array<[]u8>(allocator),
        function_name_starts: std::array::Array<i64>(allocator),
        function_name_ends: std::array::Array<i64>(allocator),
        function_decl_ordinals: std::array::Array<i64>(allocator),
        function_method_ordinals: std::array::Array<i64>(allocator),
        next_local_ids: std::array::Array<i64>(allocator)
    };
}

// collect_from_files is pass one of executable fact construction. Every source
// component is parsed and registered before any component closure is emitted.
// Parsed ASTs are released after registration. The catalog retains only source-
// backed names and declaration ordinals; consumers explicitly re-resolve a
// definition in the AST they currently own.
pub fn collect_from_files(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>
) -> !PackageFunctionCatalog {
    var catalog = init(allocator);
    var file_index = 0;
    while file_index < files.len() {
        let file = try files.at(file_index);
        if source::is_source_code(file.kind) {
            let component = try register_component(
                &var catalog, package_prefix(file), source::module_path(file)
            );
            let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
            try register_ast_functions(&var catalog, component.value, file.text, &parsed.ast, parsed.root);
            parsed.deinit();
        }
        file_index = file_index + 1;
    }
    return catalog;
}

pub fn collect_from_parsed_files(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed_files: &parser::ParsedSourceFiles
) -> !PackageFunctionCatalog {
    var catalog = init(allocator);
    let parsed_results = &parsed_files.parsed;
    var parsed_index = 0;
    while parsed_index < parsed_results.len() {
        let source_index = try parsed_files.source_indexes.get(parsed_index);
        let file = try files.at(source_index);
        let parsed = try parsed_results.at(parsed_index);
        let component = try register_component(
            &var catalog, package_prefix(file), source::module_path(file)
        );
        try register_ast_functions(
            &var catalog, component.value, file.text, &parsed.ast, parsed.root
        );
        parsed_index = parsed_index + 1;
    }
    return catalog;
}

fn package_prefix(file: &source::SourceFile) -> []u8 borrows file {
    if file.kind == source::SourceKind::Std {
        return "std";
    }
    if std::mem::len(file.package_name) > 0 {
        return file.package_name;
    }
    return "selfhost";
}

fn register_ast_functions(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return register_ast_function_range(
            catalog, component_value, text, ast, program.declarations
        );,
        _ => return;,
    }
    return;
}

fn register_ast_function(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    declaration_ordinal: i64,
    name: std::kizu::ast::NodeId
) -> !void {
    let name_span = ast.get(name).span;
    let ignored = try register_function(
        catalog,
        ComponentId { value: component_value },
        std::mem::trim_ascii(text[name_span.start..name_span.end]),
        "",
        declaration_ordinal,
        -1,
        name_span.start,
        name_span.end
    );
    if ignored.function.value < 0 {
        return error("package function id out of range");
    }
    return;
}

fn register_ast_function_range(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        try register_ast_declaration(catalog, component_value, text, ast, child, index);
        index = index + 1;
    }
    return;
}

fn register_ast_declaration(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    declaration_ordinal: i64
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return register_ast_function(
            catalog, component_value, text, ast, declaration_ordinal, fn_decl.name
        );,
        ImplDecl(impl_decl) => return register_impl_methods(
            catalog, component_value, text, ast, declaration_ordinal,
            node_text(text, ast, impl_decl.type_name), impl_decl.methods
        );,
        _ => return;,
    }
    return;
}

fn register_impl_methods(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    declaration_ordinal: i64,
    owner_type_name: []u8,
    methods: std::kizu::ast::ChildRange
) -> !void {
    var method_ordinal = 0;
    while method_ordinal < methods.len {
        let method_node = try ast.child_at(methods, method_ordinal);
        let node = ast.get(method_node);
        match node.data {
            FnDecl(fn_decl) => try register_impl_method(
                catalog, component_value, text, ast, declaration_ordinal,
                owner_type_name, method_ordinal, fn_decl.name
            );,
            _ => return error("impl member is not function");,
        }
        method_ordinal = method_ordinal + 1;
    }
    return;
}

fn register_impl_method(
    catalog: &var PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    declaration_ordinal: i64,
    owner_type_name: []u8,
    method_ordinal: i64,
    name: std::kizu::ast::NodeId
) -> !void {
    let span = ast.get(name).span;
    let ignored = try register_function(
        catalog,
        ComponentId { value: component_value },
        std::mem::trim_ascii(text[span.start..span.end]),
        owner_type_name,
        declaration_ordinal,
        method_ordinal,
        span.start,
        span.end
    );
    if ignored.function.value < 0 {
        return error("package method id out of range");
    }
    return;
}

// register_component assigns a stable dense ID in parsed package order.
pub fn register_component(
    catalog: &var PackageFunctionCatalog,
    package_name: []u8,
    component_name: []u8
) -> !ComponentId {
    if find_component(catalog, package_name, component_name) >= 0 {
        return error("duplicate package component");
    }
    let id = catalog.component_names.len();
    try catalog.component_package_names.append(package_name);
    try catalog.component_names.append(component_name);
    try catalog.component_function_starts.append(catalog.function_names.len());
    try catalog.next_local_ids.append(0);
    return ComponentId { value: id };
}

// register_function assigns a dense per-component ID in parsed declaration
// order. The node is retained so codegen can emit the exact resolved definition.
pub fn register_function(
    catalog: &var PackageFunctionCatalog,
    component: ComponentId,
    local_name: []u8,
    owner_type_name: []u8,
    declaration_ordinal: i64,
    method_ordinal: i64,
    name_start: i64,
    name_end: i64
) -> !FunctionTarget {
    let component_value = component.value;
    try require_component(catalog, component_value);
    if find_owned_function(catalog, component_value, owner_type_name, local_name) >= 0 {
        return error("duplicate package function");
    }
    let local_id = try catalog.next_local_ids.get(component_value);
    try catalog.next_local_ids.set(component_value, local_id + 1);
    try catalog.function_component_ids.append(component_value);
    try catalog.function_local_ids.append(local_id);
    try catalog.function_names.append(local_name);
    try catalog.function_owner_type_names.append(owner_type_name);
    try catalog.function_name_starts.append(name_start);
    try catalog.function_name_ends.append(name_end);
    try catalog.function_decl_ordinals.append(declaration_ordinal);
    try catalog.function_method_ordinals.append(method_ordinal);
    return FunctionTarget {
        component: ComponentId { value: component_value },
        function: FunctionId { value: local_id }
    };
}

// resolve_call is the only name-bearing boundary. A resolver records its exact
// target on the call node; later phases never repeat this lookup.
pub fn resolve_call(
    catalog: &PackageFunctionCatalog,
    package_name: []u8,
    component_name: []u8,
    local_name: []u8
) -> !FunctionTarget {
    let component_value = find_component(catalog, package_name, component_name);
    if component_value < 0 {
        return error("unresolved call target component");
    }
    let entry_index = find_function(catalog, component_value, local_name);
    if entry_index < 0 {
        return error("unresolved call target function");
    }
    return target_at(catalog, entry_index);
}

pub fn definition_node(
    catalog: &PackageFunctionCatalog,
    target: FunctionTarget,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let index = try target_slot(catalog, target);
    let ordinal = try catalog.function_decl_ordinals.get(index);
    let method_ordinal = try catalog.function_method_ordinals.get(index);
    let root_node = ast.get(root);
    match root_node.data {
        Program(program) => return definition_node_in_program(
            ast, program.declarations, ordinal, method_ordinal
        );,
        _ => return error("package definition root is not program");,
    }
    return error("package definition root is not program");
}

fn definition_node_in_program(
    ast: &std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    declaration_ordinal: i64,
    method_ordinal: i64
) -> !std::kizu::ast::NodeId {
    let declaration = try ast.child_at(declarations, declaration_ordinal);
    if method_ordinal < 0 {
        return declaration;
    }
    let node = ast.get(declaration);
    match node.data {
        ImplDecl(impl_decl) => return ast.child_at(impl_decl.methods, method_ordinal);,
        _ => return error("package method owner is not impl");,
    }
    return error("package method owner is not impl");
}

pub fn dependency_record(edge: CallDependency) -> DependencyRecord {
    return DependencyRecord {
        caller_component_id: edge.caller.component.value,
        caller_function_id: edge.caller.function.value,
        target_component_id: edge.target.component.value,
        target_function_id: edge.target.function.value
    };
}

pub fn dependency_target(record: DependencyRecord) -> FunctionTarget {
    return FunctionTarget {
        component: ComponentId { value: record.target_component_id },
        function: FunctionId { value: record.target_function_id }
    };
}

pub fn same_target(left: FunctionTarget, right: FunctionTarget) -> bool {
    return left.component.value == right.component.value and
        left.function.value == right.function.value;
}

// append_closure_targets is a numeric BFS step. The caller decides which roots
// are seeded and repeatedly invokes it for newly reached functions.
pub fn append_closure_targets(
    function: FunctionTarget,
    graph: &DependencyGraph,
    catalog: &PackageFunctionCatalog,
    queue: &var FunctionTargetQueue
) -> !void {
    let slot = try target_slot(catalog, function);
    let start = try graph.adjacency_starts.get(slot);
    if start < 0 { return; }
    let len = try graph.adjacency_lens.get(slot);
    var offset = 0;
    while offset < len {
        try queue_append(queue, catalog, FunctionTarget {
            component: ComponentId { value: try graph.target_component_ids.get(start + offset) },
            function: FunctionId { value: try graph.target_function_ids.get(start + offset) }
        });
        offset = offset + 1;
    }
    return;
}

pub fn target_slot(catalog: &PackageFunctionCatalog, target: FunctionTarget) -> !i64 {
    try require_component(catalog, target.component.value);
    let slot = try catalog.component_function_starts.get(target.component.value) + target.function.value;
    if slot < 0 or slot >= catalog.function_names.len() or
        try catalog.function_component_ids.get(slot) != target.component.value or
        try catalog.function_local_ids.get(slot) != target.function.value {
        return error("resolved function target not found");
    }
    return slot;
}

fn contains_target(
    components: &std::array::Array<i64>,
    functions: &std::array::Array<i64>,
    target_component_id: i64,
    target_function_id: i64
) -> bool {
    var index = 0;
    while index < components.len() {
        if components.get_or_panic(index) == target_component_id and
            functions.get_or_panic(index) == target_function_id {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn find_component(
    catalog: &PackageFunctionCatalog,
    package_name: []u8,
    name: []u8
) -> i64 {
    var index = 0;
    while index < catalog.component_names.len() {
        if std::mem::equal_bytes(
            catalog.component_package_names.get_or_panic(index), package_name
        ) and std::mem::equal_bytes(catalog.component_names.get_or_panic(index), name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn find_function(
    catalog: &PackageFunctionCatalog,
    component_value: i64,
    name: []u8
) -> i64 {
    var index = 0;
    while index < catalog.function_names.len() {
        if catalog.function_component_ids.get_or_panic(index) == component_value and
            std::mem::len(catalog.function_owner_type_names.get_or_panic(index)) == 0 and
            std::mem::equal_bytes(catalog.function_names.get_or_panic(index), name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn find_function_by_span(catalog: &PackageFunctionCatalog, component_value: i64, start: i64, end: i64) -> i64 {
    var index = 0;
    while index < catalog.function_names.len() {
        if catalog.function_component_ids.get_or_panic(index) == component_value and
            catalog.function_name_starts.get_or_panic(index) == start and
            catalog.function_name_ends.get_or_panic(index) == end { return index; }
        index = index + 1;
    }
    return -1;
}

fn find_owned_function(catalog: &PackageFunctionCatalog, component_value: i64, owner: []u8, name: []u8) -> i64 {
    var index = 0;
    while index < catalog.function_names.len() {
        if catalog.function_component_ids.get_or_panic(index) == component_value and
            std::mem::equal_bytes(catalog.function_owner_type_names.get_or_panic(index), owner) and
            std::mem::equal_bytes(catalog.function_names.get_or_panic(index), name) { return index; }
        index = index + 1;
    }
    return -1;
}

fn find_target(catalog: &PackageFunctionCatalog, target: FunctionTarget) -> i64 {
    var index = 0;
    while index < catalog.function_names.len() {
        if catalog.function_component_ids.get_or_panic(index) == target.component.value and
            catalog.function_local_ids.get_or_panic(index) == target.function.value {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn target_at(catalog: &PackageFunctionCatalog, index: i64) -> !FunctionTarget {
    return FunctionTarget {
        component: ComponentId { value: try catalog.function_component_ids.get(index) },
        function: FunctionId { value: try catalog.function_local_ids.get(index) }
    };
}

fn require_component(catalog: &PackageFunctionCatalog, component_value: i64) -> !void {
    if component_value < 0 or component_value >= catalog.component_names.len() {
        return error("package component id out of range");
    }
    return;
}

impl PackageFunctionCatalog {
    fn deinit(self: PackageFunctionCatalog) -> void {
        self.component_package_names.deinit();
        self.component_names.deinit();
        self.component_function_starts.deinit();
        self.function_component_ids.deinit();
        self.function_local_ids.deinit();
        self.function_names.deinit();
        self.function_owner_type_names.deinit();
        self.function_name_starts.deinit();
        self.function_name_ends.deinit();
        self.function_decl_ordinals.deinit();
        self.function_method_ordinals.deinit();
        self.next_local_ids.deinit();
        return;
    }
}

impl DependencyGraph {
    fn deinit(self: DependencyGraph) -> void {
        self.caller_component_ids.deinit();
        self.caller_function_ids.deinit();
        self.target_component_ids.deinit();
        self.target_function_ids.deinit();
        self.adjacency_starts.deinit();
        self.adjacency_lens.deinit();
        return;
    }
}

impl ResolvedCallTargets {
    fn deinit(self: ResolvedCallTargets) -> void {
        self.caller_component_ids.deinit();
        self.caller_function_ids.deinit();
        self.call_nodes.deinit();
        self.call_starts.deinit();
        self.call_ends.deinit();
        self.target_component_ids.deinit();
        self.target_function_ids.deinit();
        return;
    }
}

impl FunctionTargetQueue {
    fn deinit(self: FunctionTargetQueue) -> void {
        self.component_ids.deinit();
        self.function_ids.deinit();
        self.enqueued.deinit();
        return;
    }
}

impl EmittedTargets {
    fn deinit(self: EmittedTargets) -> void {
        self.slots.deinit();
        return;
    }
}
