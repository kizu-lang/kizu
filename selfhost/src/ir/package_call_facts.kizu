pub fn resolved_call_targets(allocator: Allocator) -> ResolvedCallTargets {
    return ResolvedCallTargets {
        caller_component_ids: std::array::Array<i64>(allocator),
        caller_function_ids: std::array::Array<i64>(allocator),
        call_nodes: std::array::Array<std::kizu::ast::NodeId>(allocator),
        call_starts: std::array::Array<i64>(allocator),
        call_ends: std::array::Array<i64>(allocator),
        target_component_ids: std::array::Array<i64>(allocator),
        target_function_ids: std::array::Array<i64>(allocator),
        indirect_caller_component_ids: std::array::Array<i64>(allocator),
        indirect_caller_function_ids: std::array::Array<i64>(allocator),
        indirect_target_component_ids: std::array::Array<i64>(allocator),
        indirect_target_function_ids: std::array::Array<i64>(allocator),
        builtin_caller_component_ids: std::array::Array<i64>(allocator),
        builtin_caller_function_ids: std::array::Array<i64>(allocator),
        builtin_call_nodes: std::array::Array<std::kizu::ast::NodeId>(allocator),
        builtin_call_starts: std::array::Array<i64>(allocator),
        builtin_call_ends: std::array::Array<i64>(allocator),
        builtin_kinds: std::array::Array<i64>(allocator),
        builtin_operations: std::array::Array<i64>(allocator),
        builtin_identities: std::array::Array<[]u8>(allocator),
        owned_constructor_caller_component_ids: std::array::Array<i64>(allocator),
        owned_constructor_caller_function_ids: std::array::Array<i64>(allocator),
        owned_constructor_call_starts: std::array::Array<i64>(allocator),
        owned_constructor_call_ends: std::array::Array<i64>(allocator),
        owned_constructor_families: std::array::Array<i64>(allocator),
        owned_constructor_actions: std::array::Array<i64>(allocator),
        owned_constructor_result_constructors: std::array::Array<[]u8>(allocator),
        owned_constructor_result_spellings: std::array::Array<[]u8>(allocator),
        owned_constructor_type_argument_starts: std::array::Array<i64>(allocator),
        owned_constructor_type_argument_lens: std::array::Array<i64>(allocator),
        owned_constructor_type_argument_spellings: std::array::Array<[]u8>(allocator),
        call_types: std::array::Array<CallTypeRecord>(allocator),
        call_type_explicit_ids: std::array::Array<i64>(allocator),
        call_type_actual_ids: std::array::Array<i64>(allocator),
        call_static_bindings: std::array::Array<StaticBindingRecord>(allocator)
    };
}

pub fn call_type_len(calls: &ResolvedCallTargets) -> i64 {
    return calls.call_types.len();
}
pub fn call_type_caller(calls: &ResolvedCallTargets, index: i64) -> !package_function_identity::FunctionTarget {
    let records = &calls.call_types; let record = try records.at(index);
    return package_function_identity::FunctionTarget {
        component: package_function_identity::ComponentId { value: record.caller_component_id },
        function: package_function_identity::FunctionId { value: record.caller_function_id }
    };
}
pub fn call_type_span_start(calls: &ResolvedCallTargets, index: i64) -> !i64 { let records = &calls.call_types; let record = try records.at(index); return record.span_start; }
pub fn call_type_span_end(calls: &ResolvedCallTargets, index: i64) -> !i64 { let records = &calls.call_types; let record = try records.at(index); return record.span_end; }
pub fn call_type_receiver(calls: &ResolvedCallTargets, index: i64) -> !i64 { let records = &calls.call_types; let record = try records.at(index); return record.receiver_id; }
pub fn call_type_result(calls: &ResolvedCallTargets, index: i64) -> !i64 { let records = &calls.call_types; let record = try records.at(index); return record.result_id; }
pub fn call_type_explicit_len(calls: &ResolvedCallTargets, index: i64) -> !i64 { let records = &calls.call_types; let record = try records.at(index); return record.explicit_len; }
pub fn call_type_explicit(calls: &ResolvedCallTargets, index: i64, arg: i64) -> !i64 {
    let len = try call_type_explicit_len(calls, index);
    if arg < 0 or arg >= len { return error("call explicit type index out of range"); }
    let records = &calls.call_types;
    let record = try records.at(index);
    return calls.call_type_explicit_ids.get(record.explicit_start + arg);
}
pub fn call_type_actual_len(calls: &ResolvedCallTargets, index: i64) -> !i64 { let records = &calls.call_types; let record = try records.at(index); return record.type_actual_len; }
pub fn call_type_actual(calls: &ResolvedCallTargets, index: i64, arg: i64) -> !i64 {
    let len = try call_type_actual_len(calls, index);
    if arg < 0 or arg >= len { return error("call type actual index out of range"); }
    let records = &calls.call_types;
    let record = try records.at(index);
    return calls.call_type_actual_ids.get(record.type_actual_start + arg);
}
pub fn call_static_binding_len(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    let records = &calls.call_types;
    let record = try records.at(index);
    return record.static_binding_len;
}
pub fn call_static_binding(
    calls: &ResolvedCallTargets,
    index: i64,
    binding_index: i64
) -> !StaticBindingRecord {
    let records = &calls.call_types;
    let record = try records.at(index);
    if binding_index < 0 or binding_index >= record.static_binding_len {
        return error("call static binding index out of range");
    }
    let bindings = &calls.call_static_bindings;
    let binding = try bindings.at(
        record.static_binding_start + binding_index
    );
    return StaticBindingRecord {
        kind: binding.kind,
        canonical_type_id: binding.canonical_type_id,
        value_bits: binding.value_bits,
        function_component_id: binding.function_component_id,
        function_id: binding.function_id
    };
}

pub fn append_call_types(
    calls: &var ResolvedCallTargets,
    store: &package_type_resolution::TypeStore,
    ast: &std::kizu::ast::Ast,
    call_node: std::kizu::ast::NodeId,
    caller: package_function_identity::FunctionTarget,
    receiver_type_id: i64,
    explicit_type_ids: &std::array::Array<i64>,
    type_actual_ids: &std::array::Array<i64>,
    static_bindings: &std::array::Array<StaticBindingInput>,
    result_type_id: i64
) -> !void {
    let span = ast.get(call_node).span;
    var receiver = -1;
    if receiver_type_id >= 0 {
        let value = try package_type_resolution::type_at(store, receiver_type_id);
        let canonical_receiver = try package_type_resolution::canonicalize_type(store, &value);
        receiver = package_type_resolution::canonical_type_id_value(&canonical_receiver);
    }
    let result_value = try package_type_resolution::type_at(store, result_type_id);
    let canonical_result = try package_type_resolution::canonicalize_type(store, &result_value);
    let result = package_type_resolution::canonical_type_id_value(&canonical_result);
    var explicit_canonical = std::array::Array<i64>(std::mem::page_allocator());
    defer explicit_canonical.deinit();
    var actual_canonical = std::array::Array<i64>(std::mem::page_allocator());
    defer actual_canonical.deinit();
    var canonical_bindings = std::array::Array<StaticBindingRecord>(
        std::mem::page_allocator()
    );
    defer canonical_bindings.deinit();
    try append_canonical_type_vector(&var explicit_canonical, store, explicit_type_ids);
    try append_canonical_type_vector(&var actual_canonical, store, type_actual_ids);
    var binding_index = 0;
    while binding_index < static_bindings.len() {
        let binding = try static_bindings.at(binding_index);
        if binding.kind != static_binding_type_kind() and
            binding.kind != static_binding_scalar_kind() and
            binding.kind != static_binding_function_kind() {
            return error("unsupported call static binding kind");
        }
        if binding.kind == static_binding_type_kind() {
            if binding.value_bits != 0 or binding.function_component_id != -1 or
                binding.function_id != -1 {
                return error("call type static binding payload invalid");
            }
        } else {
            if binding.kind == static_binding_scalar_kind() {
                if binding.function_component_id != -1 or
                    binding.function_id != -1 {
                    return error("call scalar static binding payload invalid");
                }
            } else {
                if binding.value_bits != 0 or
                    binding.function_component_id < 0 or binding.function_id < 0 {
                    return error("call function static binding payload invalid");
                }
            }
        }
        let binding_type = try package_type_resolution::type_at(
            store, binding.type_id
        );
        let canonical_binding_type = try package_type_resolution::canonicalize_type(
            store, &binding_type
        );
        try canonical_bindings.append(StaticBindingRecord {
            kind: binding.kind,
            canonical_type_id:
                package_type_resolution::canonical_type_id_value(
                    &canonical_binding_type
                ),
            value_bits: binding.value_bits,
            function_component_id: binding.function_component_id,
            function_id: binding.function_id
        });
        binding_index = binding_index + 1;
    }
    try calls.call_types.reserve(1);
    try calls.call_type_explicit_ids.reserve(explicit_canonical.len());
    try calls.call_type_actual_ids.reserve(actual_canonical.len());
    try calls.call_static_bindings.reserve(canonical_bindings.len());
    let explicit_start = calls.call_type_explicit_ids.len();
    let type_actual_start = calls.call_type_actual_ids.len();
    let static_binding_start = calls.call_static_bindings.len();
    let explicit_result = append_i64_vector(
        &var calls.call_type_explicit_ids, &explicit_canonical
    );
    if calls.call_type_explicit_ids.len() != explicit_start + explicit_canonical.len() {
        try clear_i64_vector_to(&var calls.call_type_explicit_ids, explicit_start);
    }
    try explicit_result;
    let actual_result = append_i64_vector(
        &var calls.call_type_actual_ids, &actual_canonical
    );
    if calls.call_type_actual_ids.len() != type_actual_start + actual_canonical.len() {
        try clear_i64_vector_to(&var calls.call_type_explicit_ids, explicit_start);
        try clear_i64_vector_to(&var calls.call_type_actual_ids, type_actual_start);
    }
    try actual_result;
    let binding_result = append_static_binding_vector(
        &var calls.call_static_bindings, &canonical_bindings
    );
    if calls.call_static_bindings.len() !=
        static_binding_start + canonical_bindings.len() {
        try clear_i64_vector_to(&var calls.call_type_explicit_ids, explicit_start);
        try clear_i64_vector_to(&var calls.call_type_actual_ids, type_actual_start);
        try clear_static_binding_vector_to(
            &var calls.call_static_bindings, static_binding_start
        );
    }
    try binding_result;
    let record_index = calls.call_types.len();
    let append_result = calls.call_types.append(CallTypeRecord {
        caller_component_id: package_function_identity::target_component_value(&caller),
        caller_function_id: package_function_identity::target_function_value(&caller),
        span_start: span.start, span_end: span.end,
        receiver_id: receiver, result_id: result,
        explicit_start: explicit_start, explicit_len: explicit_type_ids.len(),
        type_actual_start: type_actual_start, type_actual_len: type_actual_ids.len(),
        static_binding_start: static_binding_start,
        static_binding_len: static_bindings.len()
    });
    if calls.call_types.len() == record_index {
        try clear_i64_vector_to(&var calls.call_type_explicit_ids, explicit_start);
        try clear_i64_vector_to(&var calls.call_type_actual_ids, type_actual_start);
        while calls.call_static_bindings.len() > static_binding_start {
            let ignored_binding = try calls.call_static_bindings.pop();
        }
    }
    try append_result;
    return;
}

fn append_i64_vector(
    destination: &var std::array::Array<i64>,
    source: &std::array::Array<i64>
) -> !void {
    var index = 0;
    while index < source.len() { try destination.append(try source.get(index)); index = index + 1; }
    return;
}

fn append_static_binding_vector(
    destination: &var std::array::Array<StaticBindingRecord>,
    source: &std::array::Array<StaticBindingRecord>
) -> !void {
    var index = 0;
    while index < source.len() {
        let binding = try source.at(index);
        try destination.append(StaticBindingRecord {
            kind: binding.kind,
            canonical_type_id: binding.canonical_type_id,
            value_bits: binding.value_bits,
            function_component_id: binding.function_component_id,
            function_id: binding.function_id
        });
        index = index + 1;
    }
    return;
}

fn clear_i64_vector_to(destination: &var std::array::Array<i64>, mark: i64) -> !void {
    while destination.len() > mark { let ignored = try destination.pop(); }
    return;
}

fn clear_static_binding_vector_to(
    destination: &var std::array::Array<StaticBindingRecord>,
    mark: i64
) -> !void {
    while destination.len() > mark {
        let ignored = try destination.pop();
    }
    return;
}

fn append_canonical_type_vector(
    destination: &var std::array::Array<i64>,
    store: &package_type_resolution::TypeStore,
    ids: &std::array::Array<i64>
) -> !void {
    var index = 0;
    while index < ids.len() {
        let value = try package_type_resolution::type_at(store, try ids.get(index));
        let canonical = try package_type_resolution::canonicalize_type(store, &value);
        try destination.append(package_type_resolution::canonical_type_id_value(&canonical));
        index = index + 1;
    }
    return;
}

pub fn resolved_call_len(calls: &ResolvedCallTargets) -> i64 { return calls.call_nodes.len(); }

pub fn indirect_dependency_len(calls: &ResolvedCallTargets) -> i64 {
    return calls.indirect_target_function_ids.len();
}

pub fn indirect_dependency_record(
    calls: &ResolvedCallTargets, index: i64
) -> !package_function_identity::DependencyRecord {
    return package_function_identity::DependencyRecord {
        caller_component_id: try calls.indirect_caller_component_ids.get(index),
        caller_function_id: try calls.indirect_caller_function_ids.get(index),
        target_component_id: try calls.indirect_target_component_ids.get(index),
        target_function_id: try calls.indirect_target_function_ids.get(index)
    };
}

pub fn append_indirect_dependency(
    calls: &var ResolvedCallTargets,
    caller: package_function_identity::FunctionTarget,
    target: package_function_identity::FunctionTarget
) -> !void {
    try calls.indirect_caller_component_ids.append(
        package_function_identity::target_component_value(&caller)
    );
    try calls.indirect_caller_function_ids.append(
        package_function_identity::target_function_value(&caller)
    );
    try calls.indirect_target_component_ids.append(
        package_function_identity::target_component_value(&target)
    );
    try calls.indirect_target_function_ids.append(
        package_function_identity::target_function_value(&target)
    );
    return;
}

pub fn resolved_call_span_start(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.call_starts.get(index);
}

pub fn resolved_call_span_end(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.call_ends.get(index);
}

pub fn resolved_call_record(calls: &ResolvedCallTargets, index: i64) -> !package_function_identity::DependencyRecord {
    return package_function_identity::DependencyRecord {
        caller_component_id: try calls.caller_component_ids.get(index),
        caller_function_id: try calls.caller_function_ids.get(index),
        target_component_id: try calls.target_component_ids.get(index),
        target_function_id: try calls.target_function_ids.get(index)
    };
}

pub fn builtin_call_len(calls: &ResolvedCallTargets) -> i64 {
    return calls.builtin_call_nodes.len();
}

pub fn builtin_call_span_start(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.builtin_call_starts.get(index);
}

pub fn builtin_call_span_end(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.builtin_call_ends.get(index);
}

pub fn builtin_call_caller(calls: &ResolvedCallTargets, index: i64) -> !package_function_identity::FunctionTarget {
    return package_function_identity::FunctionTarget {
        component: package_function_identity::ComponentId { value: try calls.builtin_caller_component_ids.get(index) },
        function: package_function_identity::FunctionId { value: try calls.builtin_caller_function_ids.get(index) }
    };
}

pub fn builtin_call_caller_component_id(
    calls: &ResolvedCallTargets,
    index: i64
) -> !i64 {
    return calls.builtin_caller_component_ids.get(index);
}

pub fn builtin_call_caller_function_id(
    calls: &ResolvedCallTargets,
    index: i64
) -> !i64 {
    return calls.builtin_caller_function_ids.get(index);
}

pub fn builtin_call_kind(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.builtin_kinds.get(index);
}

pub fn builtin_kind_name(kind: i64) -> ![]u8 {
    return builtin_contract::kind_name(kind);
}

pub fn builtin_call_identity(calls: &ResolvedCallTargets, index: i64) -> ![]u8 {
    return calls.builtin_identities.get(index);
}

pub fn builtin_call_operation_name(calls: &ResolvedCallTargets, index: i64) -> ![]u8 {
    return builtin_operation_name(try calls.builtin_operations.get(index));
}

pub fn owned_constructor_len(calls: &ResolvedCallTargets) -> i64 {
    return calls.owned_constructor_call_starts.len();
}

pub fn owned_constructor_caller(
    calls: &ResolvedCallTargets,
    index: i64
) -> !package_function_identity::FunctionTarget {
    return package_function_identity::FunctionTarget {
        component: package_function_identity::ComponentId {
            value: try calls.owned_constructor_caller_component_ids.get(index)
        },
        function: package_function_identity::FunctionId {
            value: try calls.owned_constructor_caller_function_ids.get(index)
        }
    };
}

pub fn owned_constructor_span_start(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.owned_constructor_call_starts.get(index);
}

pub fn owned_constructor_span_end(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.owned_constructor_call_ends.get(index);
}

pub fn owned_constructor_family(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.owned_constructor_families.get(index);
}

pub fn owned_constructor_action(calls: &ResolvedCallTargets, index: i64) -> !i64 {
    return calls.owned_constructor_actions.get(index);
}

pub fn owned_constructor_result_constructor(
    calls: &ResolvedCallTargets,
    index: i64
) -> ![]u8 {
    return calls.owned_constructor_result_constructors.get(index);
}

pub fn owned_constructor_result_spelling(
    calls: &ResolvedCallTargets,
    index: i64
) -> ![]u8 {
    return calls.owned_constructor_result_spellings.get(index);
}

pub fn owned_constructor_type_argument_len(
    calls: &ResolvedCallTargets,
    index: i64
) -> !i64 {
    return calls.owned_constructor_type_argument_lens.get(index);
}

pub fn owned_constructor_type_argument(
    calls: &ResolvedCallTargets,
    index: i64,
    argument_index: i64
) -> ![]u8 {
    let argument_len = try owned_constructor_type_argument_len(calls, index);
    if argument_index < 0 or argument_index >= argument_len {
        return error("owned constructor type argument index out of range");
    }
    return calls.owned_constructor_type_argument_spellings.get(
        try calls.owned_constructor_type_argument_starts.get(index) + argument_index
    );
}

pub fn builtin_operation_name(operation: i64) -> ![]u8 {
    return builtin_contract::operation_name(operation);
}

pub fn append_owned_constructor(
    calls: &var ResolvedCallTargets,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    call_node: std::kizu::ast::NodeId,
    type_arguments: std::kizu::ast::ChildRange,
    caller: package_function_identity::FunctionTarget,
    family: i64,
    action: i64,
    result_constructor: []u8,
    result_spelling: []u8
) -> !void {
    if family == builtin_contract::owned_container_family_none() {
        return error("resolved owned constructor has no family");
    }
    let descriptor = builtin_contract::owned_container_constructor(family);
    if !descriptor.found { return error("resolved owned constructor has no descriptor"); }
    if descriptor.action != action {
        return error("resolved owned constructor family and action mismatch");
    }
    let call_span = ast.get(call_node).span;
    let caller_component_id = package_function_identity::target_component_value(&caller);
    let caller_function_id = package_function_identity::target_function_value(&caller);
    try calls.owned_constructor_caller_component_ids.append(caller_component_id);
    try calls.owned_constructor_caller_function_ids.append(caller_function_id);
    try calls.owned_constructor_call_starts.append(call_span.start);
    try calls.owned_constructor_call_ends.append(call_span.end);
    try calls.owned_constructor_families.append(family);
    try calls.owned_constructor_actions.append(action);
    try calls.owned_constructor_result_constructors.append(result_constructor);
    try calls.owned_constructor_result_spellings.append(result_spelling);
    try calls.owned_constructor_type_argument_starts.append(
        calls.owned_constructor_type_argument_spellings.len()
    );
    try calls.owned_constructor_type_argument_lens.append(type_arguments.len);
    var type_argument_index = 0;
    while type_argument_index < type_arguments.len {
        let type_argument_node = try ast.child_at(type_arguments, type_argument_index);
        let type_argument_span = ast.get(type_argument_node).span;
        try calls.owned_constructor_type_argument_spellings.append(
            std::mem::trim_ascii(text[type_argument_span.start..type_argument_span.end])
        );
        type_argument_index = type_argument_index + 1;
    }
    return;
}

pub fn append_resolved_call(
    calls: &var ResolvedCallTargets,
    ast: &std::kizu::ast::Ast,
    call_node: std::kizu::ast::NodeId,
    caller: package_function_identity::FunctionTarget,
    target: package_function_identity::FunctionTarget
) -> !void {
    let caller_component_id = package_function_identity::target_component_value(&caller);
    let caller_function_id = package_function_identity::target_function_value(&caller);
    let target_component_id = package_function_identity::target_component_value(&target);
    let target_function_id = package_function_identity::target_function_value(&target);
    try calls.caller_component_ids.append(caller_component_id);
    try calls.caller_function_ids.append(caller_function_id);
    try calls.call_nodes.append(call_node);
    let call_span = ast.get(call_node).span;
    try calls.call_starts.append(call_span.start);
    try calls.call_ends.append(call_span.end);
    try calls.target_component_ids.append(target_component_id);
    try calls.target_function_ids.append(target_function_id);
    return;
}

pub fn append_builtin_call(
    calls: &var ResolvedCallTargets,
    ast: &std::kizu::ast::Ast,
    call_node: std::kizu::ast::NodeId,
    caller: package_function_identity::FunctionTarget,
    kind: i64,
    operation: i64,
    canonical_identity: []u8
) -> !void {
    let kind_value = builtin_contract::kind(kind);
    if !kind_value.found {
        return error("resolved builtin call has invalid kind");
    }
    let operation_value = builtin_contract::operation(operation);
    if !operation_value.found {
        return error("resolved builtin call has invalid operation");
    }
    if !builtin_contract::valid_pair(kind, operation) {
        return error("resolved builtin call kind and operation mismatch");
    }
    if operation_value.requires_identity and std::mem::len(canonical_identity) == 0 {
        return error("resolved builtin call has no exact identity");
    }
    if !operation_value.requires_identity and std::mem::len(canonical_identity) != 0 {
        return error("resolved builtin call has overlapping identities");
    }
    let caller_component_id = package_function_identity::target_component_value(&caller);
    let caller_function_id = package_function_identity::target_function_value(&caller);
    try calls.builtin_caller_component_ids.append(caller_component_id);
    try calls.builtin_caller_function_ids.append(caller_function_id);
    try calls.builtin_call_nodes.append(call_node);
    let call_span = ast.get(call_node).span;
    try calls.builtin_call_starts.append(call_span.start);
    try calls.builtin_call_ends.append(call_span.end);
    try calls.builtin_kinds.append(kind);
    try calls.builtin_operations.append(operation);
    try calls.builtin_identities.append(canonical_identity);
    return;
}


impl ResolvedCallTargets {
    fn deinit(self: ResolvedCallTargets) -> void {
        self.caller_component_ids.deinit();
        self.caller_function_ids.deinit();
        self.call_nodes.deinit();
        self.call_starts.deinit();
        self.call_ends.deinit();
        self.target_component_ids.deinit();
        self.target_function_ids.deinit();
        self.indirect_target_function_ids.deinit();
        self.indirect_target_component_ids.deinit();
        self.indirect_caller_function_ids.deinit();
        self.indirect_caller_component_ids.deinit();
        self.builtin_caller_component_ids.deinit();
        self.builtin_caller_function_ids.deinit();
        self.builtin_call_nodes.deinit();
        self.builtin_call_starts.deinit();
        self.builtin_call_ends.deinit();
        self.builtin_kinds.deinit();
        self.builtin_operations.deinit();
        self.builtin_identities.deinit();
        self.owned_constructor_caller_component_ids.deinit();
        self.owned_constructor_caller_function_ids.deinit();
        self.owned_constructor_call_starts.deinit();
        self.owned_constructor_call_ends.deinit();
        self.owned_constructor_families.deinit();
        self.owned_constructor_actions.deinit();
        self.owned_constructor_result_constructors.deinit();
        self.owned_constructor_result_spellings.deinit();
        self.owned_constructor_type_argument_spellings.deinit();
        self.call_types.deinit();
        self.call_type_explicit_ids.deinit();
        self.call_type_actual_ids.deinit();
        self.call_static_bindings.deinit();
        self.owned_constructor_type_argument_lens.deinit();
        self.owned_constructor_type_argument_starts.deinit();
        return;
    }
}
