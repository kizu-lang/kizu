pub fn builtin_language_kind() -> i64 { return builtin_contract::kind_language(); }
pub fn builtin_runtime_kind() -> i64 { return builtin_contract::kind_runtime(); }
pub fn builtin_external_shape_kind() -> i64 { return builtin_contract::kind_external_shape(); }

