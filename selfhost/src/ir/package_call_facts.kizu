import selfhost::ir::builtin_contract;
import selfhost::ir::package_function_identity;
import selfhost::ir::package_type_resolution;

pub struct ResolvedCallTargets {
    caller_component_ids: std::array::Array<i64>,
    caller_function_ids: std::array::Array<i64>,
    call_nodes: std::array::Array<std::kizu::ast::NodeId>,
    call_starts: std::array::Array<i64>,
    call_ends: std::array::Array<i64>,
    target_component_ids: std::array::Array<i64>,
    target_function_ids: std::array::Array<i64>,
    indirect_caller_component_ids: std::array::Array<i64>,
    indirect_caller_function_ids: std::array::Array<i64>,
    indirect_target_component_ids: std::array::Array<i64>,
    indirect_target_function_ids: std::array::Array<i64>,
    builtin_caller_component_ids: std::array::Array<i64>,
    builtin_caller_function_ids: std::array::Array<i64>,
    builtin_call_nodes: std::array::Array<std::kizu::ast::NodeId>,
    builtin_call_starts: std::array::Array<i64>,
    builtin_call_ends: std::array::Array<i64>,
    builtin_kinds: std::array::Array<i64>,
    builtin_operations: std::array::Array<i64>,
    builtin_identities: std::array::Array<[]u8>,
    owned_constructor_caller_component_ids: std::array::Array<i64>,
    owned_constructor_caller_function_ids: std::array::Array<i64>,
    owned_constructor_call_starts: std::array::Array<i64>,
    owned_constructor_call_ends: std::array::Array<i64>,
    owned_constructor_families: std::array::Array<i64>,
    owned_constructor_actions: std::array::Array<i64>,
    owned_constructor_result_constructors: std::array::Array<[]u8>,
    owned_constructor_result_spellings: std::array::Array<[]u8>,
    owned_constructor_type_argument_starts: std::array::Array<i64>,
    owned_constructor_type_argument_lens: std::array::Array<i64>,
    owned_constructor_type_argument_spellings: std::array::Array<[]u8>,
    call_types: std::array::Array<CallTypeRecord>,
    call_type_explicit_ids: std::array::Array<i64>,
    call_type_actual_ids: std::array::Array<i64>,
    call_static_bindings: std::array::Array<StaticBindingRecord>,
}

pub fn static_binding_type_kind() -> i64 { return 1; }
pub fn static_binding_scalar_kind() -> i64 { return 2; }
pub fn static_binding_function_kind() -> i64 { return 3; }

pub struct StaticBindingInput {
    pub kind: i64,
    pub type_id: i64,
    pub value_bits: i64,
    pub function_component_id: i64,
    pub function_id: i64,
}

pub struct StaticBindingRecord {
    pub kind: i64,
    pub canonical_type_id: i64,
    pub value_bits: i64,
    pub function_component_id: i64,
    pub function_id: i64,
}

struct CallTypeRecord {
    caller_component_id: i64,
    caller_function_id: i64,
    span_start: i64,
    span_end: i64,
    receiver_id: i64,
    result_id: i64,
    explicit_start: i64,
    explicit_len: i64,
    type_actual_start: i64,
    type_actual_len: i64,
    static_binding_start: i64,
    static_binding_len: i64,
}

// Call-fact storage keeps this public vocabulary, while IDs and names are owned
// by builtin_contract so frontend and backend consumers cannot drift.
