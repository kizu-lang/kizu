// ExactNameIndex is an immutable open-addressed index from
// `(i64 owner, []u8 name)` to a row in caller-owned parallel arrays. It owns
// only the slot table: names and owner IDs stay in their domain catalog.
pub struct ExactNameIndex {
    slots: std::array::Array<i64>,
}

pub fn init(allocator: Allocator) -> ExactNameIndex {
    return ExactNameIndex {
        slots: std::array::Array<i64>(allocator)
    };
}

impl ExactNameIndex {
    fn deinit(self: ExactNameIndex) -> void {
        self.slots.deinit();
        return;
    }
}

pub fn is_finalized(index: &ExactNameIndex) -> bool {
    return index.slots.len() > 0;
}

pub fn finalize(index: &var ExactNameIndex, entry_count: i64) -> !void {
    if is_finalized(index) {
        return error("exact name index already finalized");
    }
    let slot_count = try capacity(entry_count);
    try index.slots.reserve(slot_count);
    var slot = 0;
    while slot < slot_count {
        try index.slots.append(0);
        slot = slot + 1;
    }
    return;
}

pub struct ExactNameInsert {
    pub duplicate: bool,
    pub slot: i64,
}

// prepare_insert finds the immutable insertion slot before the caller mutates
// its index field. Keeping discovery and commit separate lets a catalog supply
// sibling owner/name arrays without overlapping mutable and immutable borrows.
pub fn prepare_insert(
    index: &ExactNameIndex,
    owner_ids: &std::array::Array<i64>,
    names: &std::array::Array<[]u8>,
    row: i64
) -> !ExactNameInsert {
    if !is_finalized(index) {
        return error("exact name index is not finalized");
    }
    if row < 0 or row >= owner_ids.len() or row >= names.len() {
        return error("exact name index row out of range");
    }
    let owner_id = owner_ids.get_or_panic(row);
    let name = names.get_or_panic(row);
    let slot_len = index.slots.len();
    var slot = key_hash(owner_id, name, slot_len);
    var probes = 0;
    while probes < slot_len {
        let encoded = index.slots.get_or_panic(slot);
        if encoded == 0 {
            return ExactNameInsert { duplicate: false, slot: slot };
        }
        let candidate = encoded - 1;
        if candidate < 0 or candidate >= owner_ids.len() or
            candidate >= names.len() {
            return error("exact name index contains invalid row");
        }
        if owner_ids.get_or_panic(candidate) == owner_id and
            std::mem::equal_bytes(names.get_or_panic(candidate), name) {
            return ExactNameInsert { duplicate: true, slot: slot };
        }
        slot = next_slot(slot, slot_len);
        probes = probes + 1;
    }
    return error("exact name index is full");
}

pub fn commit_insert(
    index: &var ExactNameIndex,
    insertion: &ExactNameInsert,
    row: i64
) -> !void {
    if !is_finalized(index) {
        return error("exact name index is not finalized");
    }
    if insertion.duplicate {
        return error("exact name index duplicate cannot be committed");
    }
    if insertion.slot < 0 or insertion.slot >= index.slots.len() {
        return error("exact name index insertion slot out of range");
    }
    if index.slots.get_or_panic(insertion.slot) != 0 {
        return error("exact name index insertion slot is occupied");
    }
    if row < 0 or row == 9223372036854775807 {
        return error("exact name index row cannot be encoded");
    }
    try index.slots.set(insertion.slot, row + 1);
    return;
}

pub fn lookup(
    index: &ExactNameIndex,
    owner_ids: &std::array::Array<i64>,
    names: &std::array::Array<[]u8>,
    owner_id: i64,
    name: []u8
) -> !i64 {
    if !is_finalized(index) {
        return error("exact name index is not finalized");
    }
    let slot_len = index.slots.len();
    var slot = key_hash(owner_id, name, slot_len);
    var probes = 0;
    while probes < slot_len {
        let encoded = index.slots.get_or_panic(slot);
        if encoded == 0 { return -1; }
        let candidate = encoded - 1;
        if candidate < 0 or candidate >= owner_ids.len() or
            candidate >= names.len() {
            return error("exact name index contains invalid row");
        }
        if owner_ids.get_or_panic(candidate) == owner_id and
            std::mem::equal_bytes(names.get_or_panic(candidate), name) {
            return candidate;
        }
        slot = next_slot(slot, slot_len);
        probes = probes + 1;
    }
    return -1;
}

pub fn capacity(entry_count: i64) -> !i64 {
    if entry_count < 0 {
        return error("exact name index entry count is negative");
    }
    var result = 16;
    while entry_count > result / 2 {
        if result >= maximum_capacity() {
            return error("exact name index capacity overflow");
        }
        result = result + result;
    }
    return result;
}

fn maximum_capacity() -> i64 {
    // 2^57 keeps every power-of-two modulus in the direct hash arithmetic's
    // proven i64-safe range.
    return 144115188075855872;
}

fn key_hash(owner_id: i64, name: []u8, modulus: i64) -> i64 {
    var hash = hash_step(0, owner_id, modulus);
    hash = hash_step(hash, std::mem::len(name), modulus);
    var byte_index = 0;
    while byte_index < std::mem::len(name) {
        hash = hash_step(hash, cast<i64>(name[byte_index]), modulus);
        byte_index = byte_index + 1;
    }
    return hash;
}

fn hash_step(state: i64, value: i64, modulus: i64) -> i64 {
    let normalized = hash_normalize(value, modulus);
    return (state * 33 + normalized) % modulus;
}

fn hash_normalize(value: i64, modulus: i64) -> i64 {
    let reduced = value % modulus;
    if reduced < 0 { return reduced + modulus; }
    return reduced;
}

fn next_slot(slot: i64, slot_len: i64) -> i64 {
    if slot + 1 == slot_len { return 0; }
    return slot + 1;
}
