import selfhost::backend::data;

pub enum LoweredStatementKind {
    Unsupported,
    ExprStmt,
}

pub enum LoweredExpressionKind {
    Unsupported,
    Call,
}

pub enum LoweredValueKind {
    Unsupported,
    BoolLiteral,
}

pub struct LoweredValue {
    pub kind: LoweredValueKind,
    pub name: []u8,
    pub payload: []u8,
}

pub struct LoweredExpression {
    pub kind: LoweredExpressionKind,
    pub callee: []u8,
    pub argument: LoweredValue,
}

pub struct LoweredStatement {
    pub kind: LoweredStatementKind,
    pub expr: LoweredExpression,
}

pub struct LoweredBlock {
    pub statement: LoweredStatement,
}

pub struct LoweredFunction {
    pub body: LoweredBlock,
}

pub fn lower_test_executable(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::Executable {
    let executable_function = try lower_test_program(text, ast, root);
    return lower_function(text, executable_function);
}

fn lower_test_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !LoweredFunction {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_test_program_declarations(text, ast, program.declarations),
        _ => unsupported_function(text),
    };
}

fn lower_test_program_declarations(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !LoweredFunction {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let executable_function = match node.data {
            FnDecl(fn_decl) => try lower_test_function(
                text,
                ast,
                fn_decl.name,
                fn_decl.return_type,
                fn_decl.body
            ),
            _ => unsupported_function(text),
        };
        if executable_function.body.statement.kind != LoweredStatementKind::Unsupported {
            return executable_function;
        }
        index = index + 1;
    }
    return unsupported_function(text);
}

fn lower_test_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !LoweredFunction {
    let name_node = ast.get(name);
    let is_test_name = match name_node.data {
        String(string_node) => true,
        _ => false,
    };
    if !is_test_name {
        return unsupported_function(text);
    }

    let node = ast.get(body);
    return match node.data {
        Block(block) => LoweredFunction {
            body: try lower_test_block(text, ast, return_type, block.statements)
        },
        _ => unsupported_function(text),
    };
}

fn lower_test_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    return_type: std::kizu::ast::NodeId,
    statements: std::kizu::ast::ChildRange
) -> !LoweredBlock {
    let statement_count = try lower_test_effective_statement_count(ast, statements);
    if statement_count == 0 {
        return unsupported_block(text);
    }
    if !lower_test_return_type_supported(text, ast, return_type) {
        return unsupported_block(text);
    }
    return LoweredBlock {
        statement: try lower_test_statement_sequence(text, ast, statements, statement_count)
    };
}

fn lower_test_effective_statement_count(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !i64 {
    if statements.len == 0 {
        return 0;
    }
    let last_index = statements.len - 1;
    let last_statement = try ast.child_at(statements, last_index);
    let last_node = ast.get(last_statement);
    let trailing_empty_return = match last_node.data {
        Return(return_node) => is_empty_node(ast, return_node.value),
        _ => false,
    };
    if trailing_empty_return {
        return last_index;
    }
    return statements.len;
}

fn lower_test_return_type_supported(
    text: []u8,
    ast: std::kizu::ast::Ast,
    return_type: std::kizu::ast::NodeId
) -> bool {
    let return_type_node = ast.get(return_type);
    return match return_type_node.data {
        Empty => true,
        TypeName(type_name) => std::mem::equal_bytes(
            ast_node_text(text, ast, return_type),
            "void"
        ),
        _ => false,
    };
}

fn lower_test_statement_sequence(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    statement_count: i64
) -> !LoweredStatement {
    var index = 0;
    while index < statement_count {
        let statement = try ast.child_at(statements, index);
        let lowered = try lower_test_statement(text, ast, statement);
        if !lower_test_call_statement_supported(&lowered) {
            return unsupported_statement(text);
        }
        if lowered.expr.argument.kind != LoweredValueKind::BoolLiteral {
            return unsupported_statement(text);
        }
        let payload = lowered.expr.argument.payload;
        if std::mem::equal_bytes(payload, "false") {
            return lower_test_failure_statement(text);
        }
        if !std::mem::equal_bytes(payload, "true") {
            return unsupported_statement(text);
        }
        index = index + 1;
    }
    return lower_test_noop_success_statement(text);
}

fn lower_test_call_statement_supported(statement: &LoweredStatement) -> bool {
    return statement.kind == LoweredStatementKind::ExprStmt and
        statement.expr.kind == LoweredExpressionKind::Call;
}

fn lower_test_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId
) -> !LoweredStatement {
    let node = ast.get(statement);
    return match node.data {
        ExprStmt(expr_stmt) => try lower_test_expr_statement(text, ast, expr_stmt.expr),
        If(if_node) => try lower_test_if_statement(
            text,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block
        ),
        _ => unsupported_statement(text),
    };
}

fn lower_test_if_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    condition_node: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId
) -> !LoweredStatement {
    let condition = lower_test_bool_literal(text, ast, condition_node);
    if condition.kind != LoweredValueKind::BoolLiteral {
        return unsupported_statement(text);
    }
    if !is_empty_node(ast, else_block) {
        return unsupported_statement(text);
    }

    let then_statement = try lower_test_single_statement_block(text, ast, then_block);
    if then_statement.kind != LoweredStatementKind::ExprStmt or
        then_statement.expr.kind != LoweredExpressionKind::Call {
        return unsupported_statement(text);
    }

    if lower_test_bool_payload_is_true(&condition) {
        return then_statement;
    }
    if lower_test_bool_payload_is_false(&condition) {
        return lower_test_noop_success_statement(text);
    }
    return unsupported_statement(text);
}

fn lower_test_single_statement_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    block_node: std::kizu::ast::NodeId
) -> !LoweredStatement {
    let node = ast.get(block_node);
    return match node.data {
        Block(block) => try lower_test_single_statement_range(text, ast, block.statements),
        _ => unsupported_statement(text),
    };
}

fn lower_test_single_statement_range(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !LoweredStatement {
    if statements.len != 1 {
        return unsupported_statement(text);
    }
    let statement = try ast.child_at(statements, 0);
    let node = ast.get(statement);
    return match node.data {
        ExprStmt(expr_stmt) => try lower_test_expr_statement(text, ast, expr_stmt.expr),
        _ => unsupported_statement(text),
    };
}

fn lower_test_expr_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> !LoweredStatement {
    return LoweredStatement {
        kind: LoweredStatementKind::ExprStmt,
        expr: try lower_test_expr(text, ast, expr)
    };
}

fn lower_test_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> !LoweredExpression {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_test_call_expr(
            text,
            ast,
            call_node.callee,
            call_node.args
        ),
        _ => unsupported_expr(text),
    };
}

fn lower_test_call_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !LoweredExpression {
    if !callee_is_testing_expect(text, ast, callee) or
        args.len != 1 {
        return unsupported_expr(text);
    }
    let arg = try ast.child_at(args, 0);
    let argument = lower_test_bool_literal(text, ast, arg);
    if argument.kind != LoweredValueKind::BoolLiteral {
        return unsupported_expr(text);
    }
    return LoweredExpression {
        kind: LoweredExpressionKind::Call,
        callee: "std::testing::expect",
        argument: argument
    };
}

fn callee_is_testing_expect(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(expect_field) => expect_field.namespace and
            std::mem::equal_bytes(ast_node_text(text, ast, expect_field.name), "expect") and
            callee_receiver_is_testing(text, ast, expect_field.receiver),
        _ => false,
    };
}

fn callee_receiver_is_testing(
    text: []u8,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(receiver);
    return match node.data {
        FieldExpr(testing_field) => testing_field.namespace and
            std::mem::equal_bytes(ast_node_text(text, ast, testing_field.name), "testing") and
            callee_receiver_is_std(text, ast, testing_field.receiver),
        _ => false,
    };
}

fn callee_receiver_is_std(
    text: []u8,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(receiver);
    return match node.data {
        Var(var_node) => std::mem::equal_bytes(ast_node_text(text, ast, receiver), "std"),
        _ => false,
    };
}

fn lower_test_bool_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    arg: std::kizu::ast::NodeId
) -> LoweredValue {
    let node = ast.get(arg);
    return match node.data {
        Bool(bool_node) => LoweredValue {
            kind: LoweredValueKind::BoolLiteral,
            name: text[0..0],
            payload: ast_node_text(text, ast, arg)
        },
        _ => unsupported_value(text),
    };
}

fn lower_test_bool_payload_is_true(value: &LoweredValue) -> bool {
    return value.kind == LoweredValueKind::BoolLiteral and
        std::mem::equal_bytes(value.payload, "true");
}

fn lower_test_bool_payload_is_false(value: &LoweredValue) -> bool {
    return value.kind == LoweredValueKind::BoolLiteral and
        std::mem::equal_bytes(value.payload, "false");
}

fn lower_test_noop_success_statement(text: []u8) -> LoweredStatement {
    return LoweredStatement {
        kind: LoweredStatementKind::ExprStmt,
        expr: LoweredExpression {
            kind: LoweredExpressionKind::Call,
            callee: "std::testing::expect",
            argument: LoweredValue {
                kind: LoweredValueKind::BoolLiteral,
                name: text[0..0],
                payload: "true"
            }
        }
    };
}

fn lower_test_failure_statement(text: []u8) -> LoweredStatement {
    return LoweredStatement {
        kind: LoweredStatementKind::ExprStmt,
        expr: LoweredExpression {
            kind: LoweredExpressionKind::Call,
            callee: "std::testing::expect",
            argument: LoweredValue {
                kind: LoweredValueKind::BoolLiteral,
                name: text[0..0],
                payload: "false"
            }
        }
    };
}

fn lower_function(text: []u8, executable_function: LoweredFunction) -> data::Executable {
    if executable_function.body.statement.kind == LoweredStatementKind::ExprStmt and
        executable_function.body.statement.expr.kind == LoweredExpressionKind::Call {
        return data::Executable {
            kind: data::ExecutableKind::Call,
            callee: executable_function.body.statement.expr.callee,
            payload: executable_function.body.statement.expr.argument.payload
        };
    }
    return unsupported_executable(text);
}

fn unsupported_function(text: []u8) -> LoweredFunction {
    return LoweredFunction {
        body: unsupported_block(text)
    };
}

fn unsupported_block(text: []u8) -> LoweredBlock {
    return LoweredBlock {
        statement: unsupported_statement(text)
    };
}

fn unsupported_statement(text: []u8) -> LoweredStatement {
    return LoweredStatement {
        kind: LoweredStatementKind::Unsupported,
        expr: unsupported_expr(text)
    };
}

fn unsupported_expr(text: []u8) -> LoweredExpression {
    return LoweredExpression {
        kind: LoweredExpressionKind::Unsupported,
        callee: text[0..0],
        argument: unsupported_value(text)
    };
}

fn unsupported_value(text: []u8) -> LoweredValue {
    return LoweredValue {
        kind: LoweredValueKind::Unsupported,
        name: text[0..0],
        payload: text[0..0]
    };
}

fn unsupported_executable(text: []u8) -> data::Executable {
    return data::Executable {
        kind: data::ExecutableKind::Unsupported,
        callee: text[0..0],
        payload: text[0..0]
    };
}

fn is_empty_node(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Empty => true,
        _ => false,
    };
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
