import selfhost::backend::data;

pub enum ExecutableStatementKind {
    Unsupported,
    ReturnVoid,
    ExprStmt,
    LocalBinding,
}

pub enum ExecutableExpressionKind {
    Unsupported,
    Call,
}

pub enum ExecutableValueKind {
    Unsupported,
    StringLiteral,
    BoolLiteral,
    LocalRef,
}

pub struct ExecutableValue {
    pub kind: ExecutableValueKind,
    pub name: []u8,
    pub payload: []u8,
}

pub struct ExecutableExpression {
    pub kind: ExecutableExpressionKind,
    pub callee: []u8,
    pub argument: ExecutableValue,
}

pub struct ExecutableStatement {
    pub kind: ExecutableStatementKind,
    pub local_name: []u8,
    pub local_value: ExecutableValue,
    pub expr: ExecutableExpression,
}

pub struct ExecutableBlock {
    pub statement: ExecutableStatement,
}

pub struct ExecutableFunction {
    pub body: ExecutableBlock,
}

pub fn lower_run_executable(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::Executable {
    let executable_function = try lower_run_program(text, ast, root);
    return lower_function(text, executable_function);
}

pub fn lower_test_executable(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::Executable {
    let executable_function = try lower_test_program(text, ast, root);
    return lower_function(text, executable_function);
}

fn lower_run_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !ExecutableFunction {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_run_program_declarations(text, ast, program.declarations),
        _ => unsupported_function(text),
    };
}

fn lower_run_program_declarations(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !ExecutableFunction {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let executable_function = match node.data {
            FnDecl(fn_decl) => try lower_run_function(text, ast, fn_decl.name, fn_decl.body),
            _ => unsupported_function(text),
        };
        if executable_function.body.statement.kind != ExecutableStatementKind::Unsupported {
            return executable_function;
        }
        index = index + 1;
    }
    return unsupported_function(text);
}

fn lower_run_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !ExecutableFunction {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "main") {
        return unsupported_function(text);
    }

    let node = ast.get(body);
    return match node.data {
        Block(block) => ExecutableFunction {
            body: try lower_run_block(text, ast, block.statements)
        },
        _ => unsupported_function(text),
    };
}

fn lower_test_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !ExecutableFunction {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_test_program_declarations(text, ast, program.declarations),
        _ => unsupported_function(text),
    };
}

fn lower_test_program_declarations(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !ExecutableFunction {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let executable_function = match node.data {
            FnDecl(fn_decl) => try lower_test_function(
                text,
                ast,
                fn_decl.name,
                fn_decl.return_type,
                fn_decl.body
            ),
            _ => unsupported_function(text),
        };
        if executable_function.body.statement.kind != ExecutableStatementKind::Unsupported {
            return executable_function;
        }
        index = index + 1;
    }
    return unsupported_function(text);
}

fn lower_test_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !ExecutableFunction {
    let name_node = ast.get(name);
    let is_test_name = match name_node.data {
        String(string_node) => true,
        _ => false,
    };
    if !is_test_name {
        return unsupported_function(text);
    }

    let node = ast.get(body);
    return match node.data {
        Block(block) => ExecutableFunction {
            body: try lower_test_block(text, ast, return_type, block.statements)
        },
        _ => unsupported_function(text),
    };
}

fn lower_test_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    return_type: std::kizu::ast::NodeId,
    statements: std::kizu::ast::ChildRange
) -> !ExecutableBlock {
    if statements.len == 1 {
        let return_type_node = ast.get(return_type);
        let return_type_supported = match return_type_node.data {
            Empty => true,
            TypeName(type_name) => std::mem::equal_bytes(
                ast_node_text(text, ast, return_type),
                "void"
            ),
            _ => false,
        };
        if !return_type_supported {
            return unsupported_block(text);
        }
        let statement = try ast.child_at(statements, 0);
        return ExecutableBlock {
            statement: try lower_test_statement(text, ast, statement)
        };
    }
    if statements.len != 2 {
        return unsupported_block(text);
    }
    let expect_statement = try ast.child_at(statements, 0);
    let return_statement = try ast.child_at(statements, 1);
    let return_node = ast.get(return_statement);
    let empty_return_statement = match return_node.data {
        Return(return_node) => is_empty_node(ast, return_node.value),
        _ => false,
    };
    if !empty_return_statement {
        return unsupported_block(text);
    }
    return ExecutableBlock {
        statement: try lower_test_statement(text, ast, expect_statement)
    };
}

fn lower_test_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId
) -> !ExecutableStatement {
    let node = ast.get(statement);
    return match node.data {
        ExprStmt(expr_stmt) => try lower_test_expr_statement(text, ast, expr_stmt.expr),
        _ => unsupported_statement(text),
    };
}

fn lower_test_expr_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> !ExecutableStatement {
    return ExecutableStatement {
        kind: ExecutableStatementKind::ExprStmt,
        local_name: text[0..0],
        local_value: unsupported_value(text),
        expr: try lower_test_expr(text, ast, expr)
    };
}

fn lower_test_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> !ExecutableExpression {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_test_call_expr(
            text,
            ast,
            call_node.callee,
            call_node.args
        ),
        _ => unsupported_expr(text),
    };
}

fn lower_test_call_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !ExecutableExpression {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "std::testing::expect") or
        args.len != 1 {
        return unsupported_expr(text);
    }
    let arg = try ast.child_at(args, 0);
    let argument = lower_test_bool_literal(text, ast, arg);
    if argument.kind != ExecutableValueKind::BoolLiteral {
        return unsupported_expr(text);
    }
    return ExecutableExpression {
        kind: ExecutableExpressionKind::Call,
        callee: "std::testing::expect",
        argument: argument
    };
}

fn lower_test_bool_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    arg: std::kizu::ast::NodeId
) -> ExecutableValue {
    let node = ast.get(arg);
    return match node.data {
        Bool(bool_node) => ExecutableValue {
            kind: ExecutableValueKind::BoolLiteral,
            name: text[0..0],
            payload: ast_node_text(text, ast, arg)
        },
        _ => unsupported_value(text),
    };
}

fn lower_run_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !ExecutableBlock {
    var local_name = text[0..0];
    var local_payload = text[0..0];
    var index = 0;
    while index < statements.len {
        let statement_node = try ast.child_at(statements, index);
        let statement = try lower_run_statement(
            text,
            ast,
            statement_node,
            local_name,
            local_payload
        );
        if statement.kind == ExecutableStatementKind::LocalBinding {
            if std::mem::len(local_name) != 0 {
                return unsupported_block(text);
            }
            if statement.local_value.kind != ExecutableValueKind::StringLiteral {
                return unsupported_block(text);
            }
            local_name = statement.local_name;
            local_payload = statement.local_value.payload;
        } else {
            if index + 1 != statements.len {
                return unsupported_block(text);
            }
            return ExecutableBlock {
                statement: statement
            };
        }
        index = index + 1;
    }
    return unsupported_block(text);
}

fn lower_run_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    local_name: []u8,
    local_payload: []u8
) -> !ExecutableStatement {
    let node = ast.get(statement);
    return match node.data {
        Return(return_node) => lower_return_statement(text, ast, return_node.value),
        Let(let_node) => lower_let_statement(text, ast, let_node.name, let_node.value),
        ExprStmt(expr_stmt) => try lower_expr_statement(
            text,
            ast,
            expr_stmt.expr,
            local_name,
            local_payload
        ),
        _ => unsupported_statement(text),
    };
}

fn lower_let_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> ExecutableStatement {
    let lowered_value = lower_string_literal_argument(text, ast, value);
    if lowered_value.kind != ExecutableValueKind::StringLiteral {
        return unsupported_statement(text);
    }
    return ExecutableStatement {
        kind: ExecutableStatementKind::LocalBinding,
        local_name: ast_node_text(text, ast, name),
        local_value: lowered_value,
        expr: unsupported_expr(text)
    };
}

fn lower_return_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> ExecutableStatement {
    if !is_empty_node(ast, value) {
        return unsupported_statement(text);
    }
    return ExecutableStatement {
        kind: ExecutableStatementKind::ReturnVoid,
        local_name: text[0..0],
        local_value: unsupported_value(text),
        expr: unsupported_expr(text)
    };
}

fn lower_expr_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    local_name: []u8,
    local_payload: []u8
) -> !ExecutableStatement {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => ExecutableStatement {
            kind: ExecutableStatementKind::ExprStmt,
            local_name: text[0..0],
            local_value: unsupported_value(text),
            expr: try lower_call_expr(
                text,
                ast,
                call_node.callee,
                call_node.args,
                local_name,
                local_payload
            )
        },
        _ => unsupported_statement(text),
    };
}

fn lower_call_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_name: []u8,
    local_payload: []u8
) -> !ExecutableExpression {
    let callee_text = ast_node_text(text, ast, callee);
    if !std::mem::equal_bytes(callee_text, "print") or args.len != 1 {
        return unsupported_expr(text);
    }
    let arg = try ast.child_at(args, 0);
    let argument = lower_print_argument(text, ast, arg, local_name, local_payload);
    if argument.kind != ExecutableValueKind::StringLiteral and
        argument.kind != ExecutableValueKind::LocalRef {
        return unsupported_expr(text);
    }
    return ExecutableExpression {
        kind: ExecutableExpressionKind::Call,
        callee: callee_text,
        argument: argument
    };
}

fn lower_print_argument(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_name: []u8,
    local_payload: []u8
) -> ExecutableValue {
    let node = ast.get(node_id);
    return match node.data {
        String(string_node) => lower_string_literal(text, ast_node_text(text, ast, node_id)),
        Var(var_node) => lower_local_string_argument(text, ast, node_id, local_name, local_payload),
        _ => unsupported_value(text),
    };
}

fn lower_local_string_argument(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_name: []u8,
    local_payload: []u8
) -> ExecutableValue {
    if std::mem::len(local_name) == 0 {
        return unsupported_value(text);
    }
    if !std::mem::equal_bytes(ast_node_text(text, ast, node_id), local_name) {
        return unsupported_value(text);
    }
    return ExecutableValue {
        kind: ExecutableValueKind::LocalRef,
        name: local_name,
        payload: local_payload
    };
}

fn lower_string_literal_argument(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ExecutableValue {
    let node = ast.get(node_id);
    return match node.data {
        String(string_node) => lower_string_literal(text, ast_node_text(text, ast, node_id)),
        _ => unsupported_value(text),
    };
}

fn lower_string_literal(text: []u8, literal: []u8) -> ExecutableValue {
    let length = std::mem::len(literal);
    if length < string_literal_min_length() {
        return unsupported_value(text);
    }
    let quote = cast<u8>(string_literal_quote_byte());
    if literal[0] != quote or literal[length - 1] != quote {
        return unsupported_value(text);
    }
    let payload = literal[1..length - 1];
    if !is_print_payload_supported(payload) {
        return unsupported_value(text);
    }
    return ExecutableValue {
        kind: ExecutableValueKind::StringLiteral,
        name: text[0..0],
        payload: payload
    };
}

fn is_print_payload_supported(payload: []u8) -> bool {
    var index = 0;
    let length = std::mem::len(payload);
    let min = cast<u8>(32);
    let max = cast<u8>(126);
    let quote = cast<u8>(string_literal_quote_byte());
    while index < length {
        let byte = payload[index];
        if byte < min or byte > max {
            return false;
        }
        if byte == quote {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn string_literal_quote_byte() -> i64 {
    return 34;
}

fn string_literal_min_length() -> i64 {
    return 2;
}

fn lower_function(text: []u8, executable_function: ExecutableFunction) -> data::Executable {
    if executable_function.body.statement.kind == ExecutableStatementKind::ExprStmt and
        executable_function.body.statement.expr.kind == ExecutableExpressionKind::Call {
        return data::Executable {
            kind: data::ExecutableKind::Call,
            callee: executable_function.body.statement.expr.callee,
            payload: executable_function.body.statement.expr.argument.payload
        };
    }
    if executable_function.body.statement.kind == ExecutableStatementKind::ReturnVoid {
        return data::Executable {
            kind: data::ExecutableKind::RunReturnVoid,
            callee: text[0..0],
            payload: text[0..0]
        };
    }
    return unsupported_executable(text);
}

fn unsupported_function(text: []u8) -> ExecutableFunction {
    return ExecutableFunction {
        body: unsupported_block(text)
    };
}

fn unsupported_block(text: []u8) -> ExecutableBlock {
    return ExecutableBlock {
        statement: unsupported_statement(text)
    };
}

fn unsupported_statement(text: []u8) -> ExecutableStatement {
    return ExecutableStatement {
        kind: ExecutableStatementKind::Unsupported,
        local_name: text[0..0],
        local_value: unsupported_value(text),
        expr: unsupported_expr(text)
    };
}

fn unsupported_expr(text: []u8) -> ExecutableExpression {
    return ExecutableExpression {
        kind: ExecutableExpressionKind::Unsupported,
        callee: text[0..0],
        argument: unsupported_value(text)
    };
}

fn unsupported_value(text: []u8) -> ExecutableValue {
    return ExecutableValue {
        kind: ExecutableValueKind::Unsupported,
        name: text[0..0],
        payload: text[0..0]
    };
}

fn unsupported_executable(text: []u8) -> data::Executable {
    return data::Executable {
        kind: data::ExecutableKind::Unsupported,
        callee: text[0..0],
        payload: text[0..0]
    };
}

fn is_empty_node(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Empty => true,
        _ => false,
    };
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
