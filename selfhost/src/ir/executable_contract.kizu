import selfhost::parser;
import selfhost::source;

pub fn append_facts(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>
) -> !void {
    var data_found = false;
    var executable_found = false;
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind == source::SourceKind::Selfhost {
            let module = source::module_path(file);
            if std::mem::equal_bytes(module, "backend/data") {
                try append_backend_data_facts(allocator, out, file);
                data_found = true;
            }
            if std::mem::equal_bytes(module, "backend/executable") {
                try append_backend_executable_facts(allocator, out, file);
                executable_found = true;
            }
        }
        index = index + 1;
    }
    if !data_found {
        return error("missing executable ABI data source");
    }
    if !executable_found {
        return error("missing executable lowering source");
    }
    return;
}

fn append_backend_data_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try require_struct_fields(
        file.text,
        parsed.ast,
        parsed.root,
        "ExecutableAst",
        "kind",
        "ExecutableAstKind",
        "payload",
        "[]u8"
    );
    try require_struct_fields(
        file.text,
        parsed.ast,
        parsed.root,
        "Executable",
        "kind",
        "ExecutableKind",
        "stdout_payload",
        "[]u8"
    );

    try append_line(out, "executable-contract-source data selfhost::backend::data");
    try append_line(out, "hosted-executable-abi executable-result-layout-v1");
    try append_line(out, "executable-ast-layout kind:i64 payload:[]u8");
    try append_line(out, "executable-layout kind:i64 stdout_payload:[]u8");
    try append_enum_kind_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "ExecutableAstKind",
        "executable-ast-kind "
    );
    try append_enum_kind_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "ExecutableKind",
        "executable-kind "
    );
    return;
}

fn append_backend_executable_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try require_function(file.text, parsed.ast, parsed.root, "lower_run_executable");
    try require_function(file.text, parsed.ast, parsed.root, "parse_run_executable_ast");
    try require_function(file.text, parsed.ast, parsed.root, "lower_run_executable_ast");
    try require_function(file.text, parsed.ast, parsed.root, "lower_test_executable");
    try require_function(file.text, parsed.ast, parsed.root, "parse_test_executable_ast");
    try require_function(file.text, parsed.ast, parsed.root, "lower_test_executable_ast");

    try append_line(out, "executable-contract-source lowering selfhost::backend::executable");
    try append_line(out, "frontend-executable-lowering checked-ast-bounded");
    try append_line(out, "hosted-executable-ast executable-ast-rules-v1");
    try append_line(out, "executable-ast-rule MainScan LeadingFunctions");
    try append_line(out, "executable-ast-rule RunPrintCall MainPrintString");
    try append_line(out, "executable-ast-rule RunReturnVoid MainReturnVoid");
    try append_line(out, "executable-ast-rule TestExpectTrue MainExpectTrue");
    try append_line(out, "executable-ast-rule TestExpectFalse MainExpectFalse");
    try append_line(out, "hosted-executable-lowering executable-ir-rules-v1");
    try append_executable_lowering_rule_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_executable_ast"
    );
    try append_executable_lowering_rule_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_executable_ast"
    );
    return;
}

fn append_enum_kind_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    enum_name: []u8,
    fact_prefix: []u8
) -> !void {
    let node = ast.get(root);
    match node.data {
        Program(program) => return append_enum_kind_facts_for_program(
            out,
            text,
            ast,
            program.declarations,
            enum_name,
            fact_prefix
        );,
        _ => return error("missing executable enum");,
    }
}

fn append_enum_kind_facts_for_program(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    enum_name: []u8,
    fact_prefix: []u8
) -> !void {
    if try append_enum_kind_facts_in_range(
        out,
        text,
        ast,
        declarations,
        enum_name,
        fact_prefix
    ) {
        return;
    }
    return error("missing executable enum");
}

fn append_enum_kind_facts_in_range(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    enum_name: []u8,
    fact_prefix: []u8
) -> !bool {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if try append_enum_decl_kind_facts_from_node(
            out,
            text,
            ast,
            child,
            enum_name,
            fact_prefix
        ) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn append_enum_decl_kind_facts_from_node(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    enum_name: []u8,
    fact_prefix: []u8
) -> !bool {
    let node = ast.get(node_id);
    match node.data {
        EnumDecl(enum_decl) => return try append_enum_decl_kind_facts(
            out,
            text,
            ast,
            enum_decl.name,
            enum_decl.tags,
            enum_name,
            fact_prefix
        );,
        _ => return false;,
    }
}

fn append_enum_decl_kind_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    tags: std::kizu::ast::ChildRange,
    enum_name: []u8,
    fact_prefix: []u8
) -> !bool {
    if std::mem::equal_bytes(ast_node_text(text, ast, name), enum_name) {
        try append_enum_tag_facts(out, text, ast, tags, fact_prefix);
        return true;
    }
    return false;
}

fn append_enum_tag_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    tags: std::kizu::ast::ChildRange,
    fact_prefix: []u8
) -> !void {
    var index = 0;
    while index < tags.len {
        let tag = try ast.child_at(tags, index);
        try out.append_bytes(fact_prefix);
        try out.append_bytes(ast_node_text(text, ast, tag));
        try out.append_bytes(" ");
        try std::fmt::append_i64(out, index);
        try out.append_byte(cast<u8>(10));
        index = index + 1;
    }
    return;
}

fn require_struct_fields(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    struct_name: []u8,
    first_name: []u8,
    first_type: []u8,
    second_name: []u8,
    second_type: []u8
) -> !void {
    let node = ast.get(root);
    match node.data {
        Program(program) => return require_struct_fields_in_program(
            text,
            ast,
            program.declarations,
            struct_name,
            first_name,
            first_type,
            second_name,
            second_type
        );,
        _ => return error("invalid executable ABI struct");,
    }
}

fn require_struct_fields_in_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    struct_name: []u8,
    first_name: []u8,
    first_type: []u8,
    second_name: []u8,
    second_type: []u8
) -> !void {
    if try struct_fields_match(
        text,
        ast,
        declarations,
        struct_name,
        first_name,
        first_type,
        second_name,
        second_type
    ) {
        return;
    }
    return error("invalid executable ABI struct");
}

fn struct_fields_match(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    struct_name: []u8,
    first_name: []u8,
    first_type: []u8,
    second_name: []u8,
    second_type: []u8
) -> !bool {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if try struct_fields_match_node(
            text,
            ast,
            child,
            struct_name,
            first_name,
            first_type,
            second_name,
            second_type
        ) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn struct_fields_match_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    struct_name: []u8,
    first_name: []u8,
    first_type: []u8,
    second_name: []u8,
    second_type: []u8
) -> !bool {
    let node = ast.get(node_id);
    match node.data {
        StructDecl(struct_decl) => return try struct_decl_fields_match(
            text,
            ast,
            struct_decl.name,
            struct_decl.fields,
            struct_name,
            first_name,
            first_type,
            second_name,
            second_type
        );,
        _ => return false;,
    }
}

fn struct_decl_fields_match(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    struct_name: []u8,
    first_name: []u8,
    first_type: []u8,
    second_name: []u8,
    second_type: []u8
) -> !bool {
    if std::mem::equal_bytes(ast_node_text(text, ast, name), struct_name) {
        return try struct_field_range_matches(
            text,
            ast,
            fields,
            first_name,
            first_type,
            second_name,
            second_type
        );
    }
    return false;
}

fn struct_field_range_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    fields: std::kizu::ast::ChildRange,
    first_name: []u8,
    first_type: []u8,
    second_name: []u8,
    second_type: []u8
) -> !bool {
    if fields.len != 2 {
        return false;
    }
    let first = try ast.child_at(fields, 0);
    let second = try ast.child_at(fields, 1);
    return field_matches(text, ast, first, first_name, first_type) and
        field_matches(text, ast, second, second_name, second_type);
}

fn field_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field_id: std::kizu::ast::NodeId,
    expected_name: []u8,
    expected_type: []u8
) -> bool {
    let node = ast.get(field_id);
    return match node.data {
        Field(field_node) => std::mem::equal_bytes(
            ast_node_text(text, ast, field_node.name),
            expected_name
        ) and std::mem::equal_bytes(
            ast_node_text(text, ast, field_node.type_node),
            expected_type
        ),
        _ => false,
    };
}

fn require_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    name: []u8
) -> !void {
    let node = ast.get(root);
    match node.data {
        Program(program) => return require_function_in_program(
            text,
            ast,
            program.declarations,
            name
        );,
        _ => return error("missing executable lowering function");,
    }
}

fn require_function_in_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    name: []u8
) -> !void {
    if try function_exists(text, ast, declarations, name) {
        return;
    }
    return error("missing executable lowering function");
}

fn function_exists(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    name: []u8
) -> !bool {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if function_node_matches(text, ast, child, name) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn function_node_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        FnDecl(fn_decl) => std::mem::equal_bytes(
            ast_node_text(text, ast, fn_decl.name),
            name
        ),
        _ => false,
    };
}

fn append_executable_lowering_rule_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8
) -> !void {
    let node = ast.get(root);
    match node.data {
        Program(program) => return append_executable_lowering_rule_facts_in_program(
            out,
            text,
            ast,
            program.declarations,
            function_name
        );,
        _ => return error("missing executable lowering function");,
    }
}

fn append_executable_lowering_rule_facts_in_program(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if try append_executable_lowering_rule_facts_from_node(
            out,
            text,
            ast,
            child,
            function_name
        ) {
            return;
        }
        index = index + 1;
    }
    return error("missing executable lowering function");
}

fn append_executable_lowering_rule_facts_from_node(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_name: []u8
) -> !bool {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return try append_executable_lowering_rule_facts_from_fn(
            out,
            text,
            ast,
            fn_decl.name,
            fn_decl.body,
            function_name
        );,
        _ => return false;,
    }
}

fn append_executable_lowering_rule_facts_from_fn(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    function_name: []u8
) -> !bool {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), function_name) {
        return false;
    }
    try append_executable_lowering_rule_facts_from_body(out, text, ast, body);
    return true;
}

fn append_executable_lowering_rule_facts_from_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(body);
    match node.data {
        Block(block) => return append_executable_lowering_rule_facts_in_block(
            out,
            text,
            ast,
            block.statements
        );,
        _ => return error("invalid executable lowering function");,
    }
}

fn append_executable_lowering_rule_facts_in_block(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !void {
    var found = false;
    var index = 0;
    while index < statements.len {
        let statement = try ast.child_at(statements, index);
        if try append_executable_lowering_rule_fact_from_statement(out, text, ast, statement) {
            found = true;
        }
        index = index + 1;
    }
    if !found {
        return error("missing executable lowering rule");
    }
    return;
}

fn append_executable_lowering_rule_fact_from_statement(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId
) -> !bool {
    let node = ast.get(statement);
    match node.data {
        If(if_node) => return try append_executable_lowering_rule_fact_from_if(
            out,
            text,
            ast,
            if_node.condition,
            if_node.then_block
        );,
        _ => return false;,
    }
}

fn append_executable_lowering_rule_fact_from_if(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId
) -> !bool {
    let node = ast.get(condition);
    match node.data {
        Binary(binary) => return try append_executable_lowering_rule_fact_from_binary(
            out,
            text,
            ast,
            binary.op,
            binary.left,
            binary.right,
            then_block
        );,
        _ => return false;,
    }
}

fn append_executable_lowering_rule_fact_from_binary(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    op: std::kizu::ast::BinaryOp,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId
) -> !bool {
    if op != std::kizu::ast::binary_eq() {
        return false;
    }
    if !std::mem::equal_bytes(ast_node_text(text, ast, left), "executable_ast.kind") {
        return false;
    }
    if !node_text_starts_with(text, ast, right, "data::ExecutableAstKind::") {
        return false;
    }
    let executable_kind = try executable_kind_node_from_then_block(text, ast, then_block);
    try out.append_bytes("executable-lowering-rule ");
    try append_enum_suffix(out, text, ast, right, "data::ExecutableAstKind::");
    try out.append_bytes(" ");
    try append_enum_suffix(out, text, ast, executable_kind, "data::ExecutableKind::");
    try out.append_byte(cast<u8>(10));
    return true;
}

fn executable_kind_node_from_then_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    then_block: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(then_block);
    match node.data {
        Block(block) => return try executable_kind_node_from_block(text, ast, block.statements);,
        _ => return error("invalid executable lowering rule");,
    }
}

fn executable_kind_node_from_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !std::kizu::ast::NodeId {
    if statements.len < 1 {
        return error("invalid executable lowering rule");
    }
    let statement = try ast.child_at(statements, 0);
    return try executable_kind_node_from_return_statement(text, ast, statement);
}

fn executable_kind_node_from_return_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(statement);
    match node.data {
        Return(return_node) => return try executable_kind_node_from_return_value(
            text,
            ast,
            return_node.value
        );,
        _ => return error("invalid executable lowering rule");,
    }
}

fn executable_kind_node_from_return_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(value);
    match node.data {
        StructLiteralExpr(struct_literal) => return try executable_kind_node_from_struct_literal(
            text,
            ast,
            struct_literal.type_name,
            struct_literal.fields
        );,
        _ => return error("invalid executable lowering rule");,
    }
}

fn executable_kind_node_from_struct_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange
) -> !std::kizu::ast::NodeId {
    if !std::mem::equal_bytes(ast_node_text(text, ast, type_name), "data::Executable") {
        return error("invalid executable lowering rule");
    }
    if fields.len < 1 {
        return error("invalid executable lowering rule");
    }
    let field = try ast.child_at(fields, 0);
    return try executable_kind_node_from_kind_field(text, ast, field);
}

fn executable_kind_node_from_kind_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(field);
    match node.data {
        StructFieldInit(field_init) => return executable_kind_node_from_field_init(
            text,
            ast,
            field_init.name,
            field_init.value
        );,
        _ => return error("invalid executable lowering rule");,
    }
}

fn executable_kind_node_from_field_init(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "kind") {
        return error("invalid executable lowering rule");
    }
    if !node_text_starts_with(text, ast, value, "data::ExecutableKind::") {
        return error("invalid executable lowering rule");
    }
    return value;
}

fn node_text_starts_with(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    prefix: []u8
) -> bool {
    return std::mem::starts_with(ast_node_text(text, ast, node_id), prefix);
}

fn append_enum_suffix(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    prefix: []u8
) -> !void {
    if !node_text_starts_with(text, ast, node_id, prefix) {
        return error("invalid executable lowering rule");
    }
    let node = ast.get(node_id);
    let span = &node.span;
    try out.append_bytes(text[span.start + std::mem::len(prefix)..span.end]);
    return;
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
