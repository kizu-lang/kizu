import selfhost::ir::package_catalog;
import selfhost::ir::package_type_resolution;

// Environment is lexical only. Semantic records remain in the package-wide
// TypeStore and bindings carry only stable TypeIds.
pub struct Environment {
    locals: std::array::Array<LocalBinding>,
    type_parameters: std::array::Array<FormalBinding>,
    scope_starts: std::array::Array<i64>,
    self_type_id: i64,
}

struct LocalBinding { name: []u8, type_id: i64 }
struct FormalBinding { name: []u8, owner_kind: i64, owner_id: i64, slot: i64 }

pub struct FormalLookup {
    pub found: bool,
    pub owner_kind: i64,
    pub owner_id: i64,
    pub slot: i64,
}

pub fn environment(allocator: Allocator) -> Environment {
    return Environment {
        locals: std::array::Array<LocalBinding>(allocator),
        type_parameters: std::array::Array<FormalBinding>(allocator),
        scope_starts: std::array::Array<i64>(allocator),
        self_type_id: -1
    };
}

// Match-expression arms isolate lexical bindings while sharing the TypeStore.
pub fn clone(allocator: Allocator, source: &Environment) -> !Environment {
    var result = environment(allocator);
    errdefer result.deinit();
    var index = 0;
    while index < source.locals.len() {
        let locals = &source.locals;
        let binding = try locals.at(index);
        try result.locals.append(LocalBinding {
            name: binding.name,
            type_id: binding.type_id
        });
        index = index + 1;
    }
    index = 0;
    while index < source.type_parameters.len() {
        let type_parameters = &source.type_parameters;
        let binding = try type_parameters.at(index);
        try result.type_parameters.append(FormalBinding {
            name: binding.name,
            owner_kind: binding.owner_kind,
            owner_id: binding.owner_id,
            slot: binding.slot
        });
        index = index + 1;
    }
    index = 0;
    while index < source.scope_starts.len() {
        try result.scope_starts.append(try source.scope_starts.get(index));
        index = index + 1;
    }
    result.self_type_id = source.self_type_id;
    return result;
}

pub fn self_type_id(type_environment: &Environment) -> i64 {
    return type_environment.self_type_id;
}

pub fn exact_formal(
    catalog: &package_catalog::PackageFunctionCatalog,
    type_environment: &Environment,
    owner_kind: i64,
    owner_id: i64,
    name: []u8
) -> !FormalLookup {
    if owner_kind == package_type_resolution::formal_owner_function() {
        var slot = 0;
        while slot < package_catalog::function_type_parameter_len(catalog, owner_id) {
            if std::mem::equal_bytes(
                try package_catalog::function_type_parameter_name(catalog, owner_id, slot), name
            ) {
                return found_formal(owner_kind, owner_id, slot);
            }
            slot = slot + 1;
        }
        return missing_formal();
    }
    if owner_kind == package_type_resolution::formal_owner_declared() {
        var slot = 0;
        while slot < package_catalog::declared_type_parameter_len(catalog, owner_id) {
            if std::mem::equal_bytes(
                try package_catalog::declared_type_parameter_name(
                    catalog, owner_id, slot
                ),
                name
            ) {
                return found_formal(owner_kind, owner_id, slot);
            }
            slot = slot + 1;
        }
        return missing_formal();
    }
    var index = 0;
    while index < type_environment.type_parameters.len() {
        let formals = &type_environment.type_parameters;
        let formal = try formals.at(index);
        if std::mem::equal_bytes(formal.name, name) {
            return found_formal(formal.owner_kind, formal.owner_id, formal.slot);
        }
        index = index + 1;
    }
    return missing_formal();
}

pub fn append_type_parameter(
    type_environment: &var Environment,
    name: []u8,
    owner_kind: i64,
    owner_id: i64,
    slot: i64
) -> !void {
    var index = 0;
    while index < type_environment.type_parameters.len() {
        let formals = &type_environment.type_parameters;
        let formal = try formals.at(index);
        if std::mem::equal_bytes(formal.name, name) {
            return error("duplicate resolver type parameter");
        }
        index = index + 1;
    }
    try type_environment.type_parameters.append(FormalBinding {
        name: name,
        owner_kind: owner_kind,
        owner_id: owner_id,
        slot: slot
    });
    return;
}

pub fn bind_self_type(
    type_environment: &var Environment,
    value: &package_type_resolution::ResolvedType
) -> !void {
    if value.type_id < 0 { return error("cannot bind Self to unknown type"); }
    if type_environment.self_type_id >= 0 {
        return error("resolver Self type already bound");
    }
    type_environment.self_type_id = value.type_id;
    return;
}

pub fn enter_scope(type_environment: &var Environment) -> !void {
    try type_environment.scope_starts.append(type_environment.locals.len());
    return;
}

pub fn leave_scope(type_environment: &var Environment) -> !void {
    if type_environment.scope_starts.len() == 0 {
        return error("resolver lexical scope stack underflow");
    }
    let start = type_environment.scope_starts.get_or_panic(
        type_environment.scope_starts.len() - 1
    );
    while type_environment.locals.len() > start {
        let ignored = try type_environment.locals.pop();
    }
    let ignored_scope = try type_environment.scope_starts.pop();
    return;
}

pub fn insert(
    type_environment: &var Environment,
    name: []u8,
    type_value: package_type_resolution::ResolvedType
) -> !void {
    if type_value.type_id < 0 { return error("resolver cannot bind unknown type"); }
    var scope_start = 0;
    if type_environment.scope_starts.len() > 0 {
        scope_start = type_environment.scope_starts.get_or_panic(
            type_environment.scope_starts.len() - 1
        );
    }
    var index = type_environment.locals.len();
    while index > scope_start {
        index = index - 1;
        let locals = &type_environment.locals;
        let binding = try locals.at(index);
        if std::mem::equal_bytes(binding.name, name) {
            return error("resolver duplicate local in lexical scope");
        }
    }
    try type_environment.locals.append(LocalBinding {
        name: name,
        type_id: type_value.type_id
    });
    return;
}

pub fn lookup(
    store: &package_type_resolution::TypeStore,
    type_environment: &Environment,
    name: []u8
) -> !package_type_resolution::ResolvedType {
    var index = type_environment.locals.len();
    while index > 0 {
        index = index - 1;
        let locals = &type_environment.locals;
        let binding = try locals.at(index);
        if std::mem::equal_bytes(binding.name, name) {
            return package_type_resolution::type_at(store, binding.type_id);
        }
    }
    return package_type_resolution::unknown_type();
}

fn found_formal(owner_kind: i64, owner_id: i64, slot: i64) -> FormalLookup {
    return FormalLookup {
        found: true,
        owner_kind: owner_kind,
        owner_id: owner_id,
        slot: slot
    };
}

fn missing_formal() -> FormalLookup {
    return FormalLookup {
        found: false,
        owner_kind: package_type_resolution::formal_owner_none(),
        owner_id: -1,
        slot: -1
    };
}

impl Environment {
    fn deinit(self: Environment) -> void {
        self.locals.deinit();
        self.type_parameters.deinit();
        self.scope_starts.deinit();
        return;
    }
}
