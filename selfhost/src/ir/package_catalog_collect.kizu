import selfhost::ir::package_catalog;
import selfhost::parser;
import selfhost::source;

fn node_text(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let span = ast.get(node_id).span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}

pub fn collect_from_parsed_files(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed_files: &parser::ParsedSourceFiles
) -> !package_catalog::PackageFunctionCatalog {
    var catalog = package_catalog::init(allocator);
    errdefer catalog.deinit();
    let parsed_results = &parsed_files.parsed;
    var component_ids = std::array::Array<i64>(allocator);
    defer component_ids.deinit();
    try component_ids.reserve(parsed_results.len());
    var parsed_index = 0;
    while parsed_index < parsed_results.len() {
        let source_index = try parsed_files.source_indexes.get(parsed_index);
        let file = try files.at(source_index);
        let parsed = try parsed_results.at(parsed_index);
        let component = try package_catalog::register_component(
            &var catalog, package_prefix(file), source::module_path(file)
        );
        if component != parsed_index {
            return error("package component id does not match parsed order");
        }
        try component_ids.append(component);
        try register_ast_functions(
            &var catalog, component, file.text, &parsed.ast, parsed.root
        );
        parsed_index = parsed_index + 1;
    }
    parsed_index = 0;
    while parsed_index < parsed_results.len() {
        let source_index = try parsed_files.source_indexes.get(parsed_index);
        let file = try files.at(source_index);
        let parsed = try parsed_results.at(parsed_index);
        let owner_component = try component_ids.get(parsed_index);
        try validate_component_source_identity(
            &catalog, owner_component, parsed_index, file
        );
        try register_ast_imports(
            &var catalog, owner_component, file.text, &parsed.ast, parsed.root
        );
        parsed_index = parsed_index + 1;
    }
    try package_catalog::finalize_collected_catalog(&var catalog);
    return catalog;
}

fn validate_component_source_identity(
    catalog: &package_catalog::PackageFunctionCatalog,
    component: i64,
    parsed_index: i64,
    file: &source::SourceFile
) -> !void {
    if component != parsed_index or component < 0 or
        component >= package_catalog::component_len(catalog) {
        return error("package component id does not match parsed order");
    }
    if !std::mem::equal_bytes(
        package_catalog::component_package_name_at(catalog, component),
        package_prefix(file)
    ) or !std::mem::equal_bytes(
        package_catalog::component_name_at(catalog, component),
        source::module_path(file)
    ) {
        return error("package component id does not match parsed source");
    }
    return;
}

fn register_ast_imports(
    catalog: &var package_catalog::PackageFunctionCatalog,
    owner_component: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !void {
    try package_catalog::begin_component_imports(catalog, owner_component);
    let node = ast.get(node_id);
    match node.data {
        Program(program) => try register_import_range(
            catalog, owner_component, text, ast, program.declarations
        );,
        _ => return error("package import root is not program");,
    }
    return package_catalog::finish_component_imports(catalog, owner_component);
}

fn register_import_range(
    catalog: &var package_catalog::PackageFunctionCatalog,
    owner_component: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < declarations.len {
        try register_import_declaration(
            catalog, owner_component, text, ast,
            try ast.child_at(declarations, index)
        );
        index = index + 1;
    }
    return;
}

fn register_import_declaration(
    catalog: &var package_catalog::PackageFunctionCatalog,
    owner_component: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !void {
    let declaration = ast.get(node_id);
    match declaration.data {
        ImportDecl(import_decl) => return register_import_path(
            catalog, owner_component, text, ast, import_decl.path
        );,
        _ => return;,
    }
}

fn register_import_path(
    catalog: &var package_catalog::PackageFunctionCatalog,
    owner_component: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    path: std::kizu::ast::ChildRange
) -> !void {
    if path.len < 2 { return error("package import path too short"); }
    let first = node_text(text, ast, try ast.child_at(path, 0));
    let alias = node_text(text, ast, try ast.child_at(path, path.len - 1));
    var target_component = -1;
    var component = 0;
    while component < package_catalog::component_len(catalog) {
        if std::mem::equal_bytes(
            package_catalog::component_package_name_at(catalog, component), first
        ) and try import_component_path_matches(
            text, ast, path,
            package_catalog::component_name_at(catalog, component)
        ) {
            if target_component >= 0 {
                return error("ambiguous package import target");
            }
            target_component = component;
        }
        component = component + 1;
    }
    if target_component < 0 { return error("package import target missing"); }
    return package_catalog::append_component_import(
        catalog, owner_component, alias, target_component
    );
}

fn import_component_path_matches(
    text: []u8,
    ast: &std::kizu::ast::Ast,
    path: std::kizu::ast::ChildRange,
    component_name: []u8
) -> !bool {
    var path_index = 1;
    var component_start = 0;
    var component_end = 0;
    while path_index < path.len {
        if component_start >= std::mem::len(component_name) { return false; }
        component_end = component_start;
        while component_end < std::mem::len(component_name) and
            component_name[component_end] != cast<u8>(47) {
            component_end = component_end + 1;
        }
        if !std::mem::equal_bytes(
            node_text(text, ast, try ast.child_at(path, path_index)),
            component_name[component_start..component_end]
        ) { return false; }
        component_start = component_end + 1;
        path_index = path_index + 1;
    }
    return component_end == std::mem::len(component_name);
}

fn register_ast_functions(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return register_ast_function_range(
            catalog, component_value, text, ast, program.declarations
        );,
        _ => return;,
    }
    return;
}

fn register_ast_function_range(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < range.len {
        try register_ast_declaration(
            catalog, component_value, text, ast,
            try ast.child_at(range, index), index
        );
        index = index + 1;
    }
    return;
}

fn register_ast_declaration(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    declaration_ordinal: i64
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return register_ast_function(
            catalog, component_value, text, ast, declaration_ordinal,
            fn_decl.name, fn_decl.type_params, fn_decl.params, fn_decl.return_type
        );,
        ImplDecl(impl_decl) => return register_impl_methods(
            catalog, component_value, text, ast, declaration_ordinal,
            node_text(text, ast, impl_decl.type_name), impl_decl.methods
        );,
        StructDecl(struct_decl) => return register_struct_declaration(
            catalog, component_value, text, ast,
            struct_decl.name, struct_decl.type_params, struct_decl.fields
        );,
        EnumDecl(enum_decl) => return register_enum_declaration(
            catalog, component_value, text, ast, enum_decl.name, enum_decl.tags
        );,
        UnionDecl(union_decl) => return register_union_declaration(
            catalog, component_value, text, ast,
            union_decl.name, union_decl.type_params, union_decl.variants
        );,
        _ => return;,
    }
    return;
}

fn register_ast_function(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    declaration_ordinal: i64,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId
) -> !void {
    let name_span = ast.get(name).span;
    var owner_type_name = text[0..0];
    if params.len > 0 {
        let first_param_node = ast.get(try ast.child_at(params, 0));
        match first_param_node.data {
            Param(first_param) => if std::mem::equal_bytes(
                node_text(text, ast, first_param.name), "self"
            ) {
                owner_type_name = node_text(text, ast, first_param.type_node);
            },
            _ => return error("package function parameter is not Param");,
        }
    }
    let target = try package_catalog::register_function(
        catalog, component_value,
        std::mem::trim_ascii(text[name_span.start..name_span.end]),
        owner_type_name, node_text(text, ast, return_type),
        declaration_ordinal, -1, name_span.start, name_span.end
    );
    let function_index = package_catalog::function_len(catalog) - 1;
    try append_type_parameters(catalog, function_index, text, ast, type_params);
    return append_function_params(catalog, function_index, text, ast, params);
}

fn register_struct_declaration(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    fields: std::kizu::ast::ChildRange
) -> !void {
    let declaration_index = try package_catalog::register_struct_type(
        catalog, component_value, node_text(text, ast, name), fields.len
    );
    try append_declared_type_parameters(
        catalog, declaration_index, text, ast, type_params
    );
    var index = 0;
    while index < fields.len {
        let field_node = ast.get(try ast.child_at(fields, index));
        match field_node.data {
            Field(field) => try package_catalog::append_struct_field(
                catalog, component_value, declaration_index,
                node_text(text, ast, field.name),
                node_text(text, ast, field.type_node)
            );,
            _ => return error("package struct member is not field");,
        }
        index = index + 1;
    }
    return;
}

fn register_union_declaration(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    variants: std::kizu::ast::ChildRange
) -> !void {
    let union_name = node_text(text, ast, name);
    let declaration_index = try package_catalog::register_union_type(
        catalog, component_value, union_name, variants.len
    );
    try append_declared_type_parameters(
        catalog, declaration_index, text, ast, type_params
    );
    var index = 0;
    while index < variants.len {
        let variant_node = ast.get(try ast.child_at(variants, index));
        match variant_node.data {
            UnionVariant(variant) => try package_catalog::append_union_variant(
                catalog, component_value, declaration_index, union_name,
                node_text(text, ast, variant.name),
                node_text(text, ast, variant.payload)
            );,
            _ => return error("package union member is not variant");,
        }
        index = index + 1;
    }
    return;
}

fn register_enum_declaration(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    tags: std::kizu::ast::ChildRange
) -> !void {
    let declaration_index = try package_catalog::register_enum_type(
        catalog, component_value, node_text(text, ast, name), tags.len
    );
    var index = 0;
    while index < tags.len {
        try package_catalog::append_enum_tag(
            catalog, declaration_index,
            node_text(text, ast, try ast.child_at(tags, index))
        );
        index = index + 1;
    }
    return;
}

fn register_impl_methods(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    declaration_ordinal: i64,
    owner_type_name: []u8,
    methods: std::kizu::ast::ChildRange
) -> !void {
    var method_ordinal = 0;
    while method_ordinal < methods.len {
        let node = ast.get(try ast.child_at(methods, method_ordinal));
        match node.data {
            FnDecl(fn_decl) => try register_impl_method(
                catalog, component_value, text, ast, declaration_ordinal,
                owner_type_name, method_ordinal, fn_decl.name,
                fn_decl.type_params, fn_decl.params, fn_decl.return_type
            );,
            _ => return error("impl member is not function");,
        }
        method_ordinal = method_ordinal + 1;
    }
    return;
}

fn register_impl_method(
    catalog: &var package_catalog::PackageFunctionCatalog,
    component_value: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    declaration_ordinal: i64,
    owner_type_name: []u8,
    method_ordinal: i64,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId
) -> !void {
    let span = ast.get(name).span;
    let target = try package_catalog::register_function(
        catalog, component_value,
        std::mem::trim_ascii(text[span.start..span.end]), owner_type_name,
        node_text(text, ast, return_type), declaration_ordinal,
        method_ordinal, span.start, span.end
    );
    let function_index = package_catalog::function_len(catalog) - 1;
    try append_type_parameters(catalog, function_index, text, ast, type_params);
    return append_function_params(catalog, function_index, text, ast, params);
}

fn append_type_parameters(
    catalog: &var package_catalog::PackageFunctionCatalog,
    function_index: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    type_params: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < type_params.len {
        try package_catalog::append_function_type_parameter(
            catalog, function_index,
            node_text(text, ast, try ast.child_at(type_params, index))
        );
        index = index + 1;
    }
    return;
}

fn append_declared_type_parameters(
    catalog: &var package_catalog::PackageFunctionCatalog,
    declaration_index: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    type_params: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < type_params.len {
        try package_catalog::append_declared_type_parameter(
            catalog, declaration_index,
            node_text(text, ast, try ast.child_at(type_params, index))
        );
        index = index + 1;
    }
    return;
}

fn append_function_params(
    catalog: &var package_catalog::PackageFunctionCatalog,
    function_index: i64,
    text: []u8,
    ast: &std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < params.len {
        let node = ast.get(try ast.child_at(params, index));
        match node.data {
            Param(param) => try package_catalog::append_function_param_layout(
                catalog,
                function_index,
                node_text(text, ast, param.name),
                node_text(text, ast, param.type_node),
                param.comptime_param
            );,
            _ => return error("package function parameter is not Param");,
        }
        index = index + 1;
    }
    return;
}

fn package_prefix(file: &source::SourceFile) -> []u8 borrows file {
    if file.kind == source::SourceKind::Std { return "std"; }
    if std::mem::len(file.package_name) > 0 { return file.package_name; }
    return "selfhost";
}
