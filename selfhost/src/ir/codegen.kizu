}

pub fn code_op_try_array_get() -> i64 {
    return 124;
}

pub fn code_op_map_len() -> i64 {
    return 125;
}

// STRUCT_DECL records a returned struct's ABI shape at the head of the tape:
// 'op name_start name_end field_count [field_name_start field_name_end field_kind]...'.
// Supported field kinds are i64, bool, []u8, and declared struct records.
pub fn code_op_struct_decl() -> i64 {
    return 117;
}

// STRUCT_PACK materializes a struct literal into the declaration-order LLVM
// aggregate used across a function boundary:
// 'op dst struct_decl_pos field_count [field_value]...'.
pub fn code_op_struct_pack() -> i64 {
    return 118;
}

// STRUCT_FIELD extracts one field from a runtime struct aggregate:
// 'op dst src struct_decl_pos field_index'.
pub fn code_op_struct_field() -> i64 {
    return 119;
}

// SLICE_INDEX reads one byte from a '%kizu.slice.u8' value at an i64 index and
// zero-extends it to i64: 'op dst slice_value index_value'. It backs the element
// index expression 'b[i]' (slice == false).
pub fn code_op_slice_index() -> i64 {
    return 126;
}

// SLICE_LEN reads the length field of a '%kizu.slice.u8' value as an i64:
// 'op dst slice_value'. It backs 'std::mem::len(s)' over a '[]u8' or str slice;
// the length is already i64, so no extension is needed.
pub fn code_op_slice_len() -> i64 {
    return 127;
}

// SLICE_RANGE builds a sub-slice of a '%kizu.slice.u8' value over the i64 range
// '[start, end)': 'op dst slice_value start_value end_value'. It offsets the
// source data pointer by 'start' and sets the new length to 'end - start',
// backing the range slice expression 'b[i..j]' (slice == true). Its result is a
// '%kizu.slice.u8' value (kind code_kind_slice()), not an i64 like SLICE_INDEX.
pub fn code_op_slice_range() -> i64 {
    return 128;
}

// ARRAY_SET stores an element into an Array<T> at an i64 index, backing the
// 'try xs.set(i, v)' mutation: 'op receiver_value index_value value_value
// element_kind'. The renderer bounds-checks the index through
// 'kizu_rt_array_at' (propagating its error like Array.get) and then stores the
// value into the element pointer for i64, bool, and []u8 element kinds. It
// yields void, so it carries no destination value.
pub fn code_op_try_array_set() -> i64 {
    return 129;
}

// ARRAY_POP removes the last element from an Array<T> and yields it as !T:
// 'op dst receiver_value element_kind'. The renderer checks the last index through
// 'kizu_rt_array_at', loads the element, then decrements the array length.
pub fn code_op_try_array_pop() -> i64 {
    return 130;
}

// STORAGE_CAPACITY reads the capacity field of an owned Array<T> or String:
// 'op dst receiver_value'. The renderer selects the runtime storage layout from
// the receiver value kind and loads field index 3 as an i64.
pub fn code_op_storage_capacity() -> i64 {
    return 131;
}

// STORAGE_CLEAR resets the length of an owned String to zero while preserving
// its capacity and buffer: 'op receiver_value receiver_kind'. The renderer
// stores i64 0 into the length field (struct index 2), matching Go's
// String.clear. Only owned String is accepted (the Go reference exposes no
// Array.clear, so the array path is intentionally left unsupported for parity).
pub fn code_op_storage_clear() -> i64 {
    return 145;
}

// STRING_TRUNCATE stores a new length into an owned String after the renderer's
// bounds check: 'op receiver_value length_value'. Capacity is unchanged.
pub fn code_op_try_string_truncate() -> i64 {
    return 132;
}

// MEM_STARTS_WITH compares the head of a '%kizu.slice.u8' value against a prefix
// slice and yields an i1: 'op dst bytes_value prefix_value'. The renderer returns
// false when the prefix is longer than the bytes, then loops over the prefix
// length comparing bytes. It backs 'std::mem::starts_with(bytes, prefix)'.
pub fn code_op_mem_starts_with() -> i64 {
    return 133;
}

// MEM_TRIM_ASCII builds a sub-slice of a '%kizu.slice.u8' value with ASCII
// whitespace trimmed from both ends: 'op dst slice_value'. The renderer scans the
// head and tail past the ASCII whitespace bytes and assembles a fresh
// '%kizu.slice.u8' aggregate. It backs 'std::mem::trim_ascii(bytes)'.
pub fn code_op_mem_trim_ascii() -> i64 {
    return 134;
}

// PATH_BASENAME / PATH_DIRNAME / PATH_EXTENSION build a sub-slice of a
// '%kizu.slice.u8' value following std::path_bits semantics: 'op dst slice_value'.
// All three are pure byte-slice scans with no I/O or allocation; the renderer owns
// the slash/dot scan loops and the slice assembly, returning a '%kizu.slice.u8'
// value (kind slice). basename/dirname return the literal '.' (a private module
// global) for the empty / no-slash shapes and the '/' root as the path[0..1]
// sub-slice; extension returns the empty slice as '{ptr, 0}'.
pub fn code_op_path_basename() -> i64 {
    return 135;
}

pub fn code_op_path_dirname() -> i64 {
    return 136;
}

pub fn code_op_path_extension() -> i64 {
    return 137;
}

// FS_EXISTS / FS_METADATA / FS_CREATE_DIR lower the I/O-bearing fs core helpers
// onto their existing runtime symbols. FS_EXISTS ('op dst io path') and
// FS_METADATA ('op dst io path') yield a result value (a bool, kind bool; a
// '%kizu.fs.metadata' aggregate, kind fs_metadata) by extracting the success arm
// of the runtime error union and propagating its error arm; FS_CREATE_DIR
// ('op io path') is a statement that yields no value (it propagates on error and
// continues otherwise). All three build the path slice via lower_code_arg_slice,
// so the path may be a string literal or a runtime '[]u8' value.
pub fn code_op_fs_exists() -> i64 {
    return 138;
}

pub fn code_op_fs_metadata() -> i64 {
    return 139;
}

pub fn code_op_fs_create_dir() -> i64 {
    return 140;
}

// FS_METADATA_FIELD reads a field of a '%kizu.fs.metadata' value: 'op dst src
// field_index', where field 0 is 'size' (i64) and field 1 is 'is_dir' (i1/bool).
// The renderer extracts the field straight out of the aggregate SSA value.
pub fn code_op_fs_metadata_field() -> i64 {
    return 141;
}

// Box<i64> uses the runtime error-owned ABI. BOX_NEW creates a !Box<i64>
// value, TRY_BOX_NEW unwraps it at a try boundary, and BOX_BORROW_I64 reads a
// shared i64 borrow through the checked runtime borrow view.
pub fn code_op_box_new() -> i64 {
    return 142;
}

pub fn code_op_try_box_new() -> i64 {
    return 143;
}

pub fn code_op_box_borrow_i64() -> i64 {
    return 144;
}

// TRY_CALL_OWNED_STRING calls a user '!std::string::String' function and unwraps
// its '%kizu.error.owned' result: 'op dst callee_start callee_end arg_count' with
// the args copied into scratch (the same record shape as TRY_CALL_I64). The
// renderer branches on the ok flag -- propagating the message on failure and
// extracting the owned-String payload (struct index 1) on success. 146 is the
// next free op after STORAGE_CLEAR (145).
pub fn code_op_try_call_owned_string() -> i64 {
    return 146;
}

// DEFER_DEINIT / ERRDEFER_DEINIT record cleanup stack entries. They are inert
// in normal render flow; error propagation renderers scan active records and
// emit the deinit calls inside their fail blocks. ERRDEFER_SCOPE_END closes the
// active interval for records declared at or after its lower-bound tape index.
pub fn code_op_errdefer_deinit() -> i64 {
    return 147;
}

pub fn code_op_errdefer_scope_end() -> i64 {
    return 148;
}

pub fn code_op_defer_deinit() -> i64 {
    return 149;
}

// TRY_PATH_JOIN / TRY_PATH_CLEAN lower std::path::join / clean into owned
// String-producing helpers: JOIN is 'op dst allocator left_slice right_slice',
// CLEAN is 'op dst allocator path_slice'. Both render through '%kizu.error.owned'.
pub fn code_op_try_path_join() -> i64 {
    return 150;
}

pub fn code_op_try_path_clean() -> i64 {
    return 151;
}

// ARRAY_AT_MUT bounds-checks an Array<T> index and yields a pointer to the
// element storage: 'op dst receiver_value index_value element_kind'. It shares
// the ARRAY_SET/GET runtime check path and leaves load/store semantics to the
// mutable-borrow deref path.
pub fn code_op_try_array_at_mut() -> i64 {
    return 152;
}

// TRY_CALL_TYPED_ERROR_* mirrors TRY_CALL/TRY_CALL_I64 for functions declared as
// 'Error!void' or 'Error!i64'. The failure payload is the runtime union aggregate
// for the concrete error union type, so typed errors do not collapse into the
// untyped message-slice ABI.
pub fn code_op_try_call_typed_error_void() -> i64 {
    return 153;
}

pub fn code_op_try_call_typed_error_i64() -> i64 {
    return 154;
}

// STRING_RESERVE grows an owned String's backing byte storage without changing
// its length: 'op receiver_value additional_value'. The renderer delegates to
// kizu_rt_string_reserve so capacity growth stays in the runtime storage module
// rather than duplicating allocation/copy/free logic in every artifact.
pub fn code_op_try_string_reserve() -> i64 {
    return 155;
}

fn code_defer_runtime_deinit_tag() -> i64 {
    return 0 - 10;
}

// code_loop_kind_while / code_loop_kind_for tag a break/continue's target loop so
// the renderer picks the while (condition latch) or for (increment latch) labels.
pub fn code_loop_kind_while() -> i64 {
    return 0;
}

pub fn code_loop_kind_for() -> i64 {
    return 1;
}

// code_var_slot_base offsets a var local's stored value so a locals lookup can
// tell a var (alloca slot) from a let (SSA value). A var local stores
// base + slot; reads at or above the base resolve to slot = value - base and
// emit a VAR_LOAD, while let values stay below it and resolve to their SSA id.
// Run programs never approach this many SSA values, so the spaces never overlap.
pub fn code_var_slot_base() -> i64 {
    return 1000000000;
}

// code_slice_var_slot_base offsets a '[]u8' 'var' local's stored value so a
// locals lookup tells a slice var slot ('%sslot', VAR_*_SLICE) from an i64 var
// slot (code_var_slot_base) and a let. A slice var stores slice_base + slot;
// reads at or above it resolve to slice slot = value - slice_base, while i64 var
// slots and let values stay below it. It sits between the i64 var slot space and
// the loop-label base so the three spaces never overlap.
pub fn code_slice_var_slot_base() -> i64 {
    return 1500000000;
}

// code_local_is_slice_slot reports whether a resolved local value is a slice var
// slot (at or above the slice slot base, below the loop-label base).
pub fn code_local_is_slice_slot(bound: i64) -> bool {
    if bound < code_slice_var_slot_base() {
        return false;
    }
    return bound < code_loop_label_base();
}

// code_loop_label_base offsets a loop label's stored value so a locals lookup can
// tell a label from a let value or a var slot: a label stores
// base + loop_begin * 2 + loop_kind, far above the var slot space.
pub fn code_loop_label_base() -> i64 {
    return 2000000000;
}

pub fn code_kind_i64() -> i64 {
    return 1;
}

pub fn code_kind_str() -> i64 {
    return 2;
}

// code_kind_bool marks an i1 comparison result on the kinds parallel array; the
// renderer emits it as an icmp and an if condition consumes it as i1.
pub fn code_kind_bool() -> i64 {
    return 3;
}

// Return-kind ids are stored on FUNC_BEGIN records. Bool stays outside the
// scalar value-kind range because return kind 3 is already the error-union-i64
// ABI, while call results still use code_kind_bool().
pub fn code_return_kind_bool() -> i64 {
    return 900;
}

// code_return_kind_slice marks a '[]u8' (runtime slice) return on FUNC_BEGIN
// records. Like the bool return kind it stays outside the scalar value-kind range
// so it never collides with the i64/error-union/struct-base return codes; its
// result value-kind is code_kind_slice().
pub fn code_return_kind_slice() -> i64 {
    return 901;
}

// code_return_kind_owned_string_err marks a '!std::string::String' error-union
// owned-String return on FUNC_BEGIN records. Like the bool/slice return kinds it
// stays in the high return-kind band (902, after bool 900 and slice 901) so it
// never collides with the scalar/struct/union value-kind codes; its success
// value-kind is code_kind_owned_string() and its render ABI is the
// '%kizu.error.owned' aggregate.
pub fn code_return_kind_owned_string_err() -> i64 {
    return 902;
}

fn code_return_kind_owned_array_i64_err() -> i64 {
    return 903;
}

fn code_return_kind_owned_array_bool_err() -> i64 {
    return 904;
}

fn code_return_kind_owned_array_slice_err() -> i64 {
    return 905;
}

fn code_return_kind_typed_error_i64() -> i64 {
    return 906;
}

fn code_return_kind_typed_error_void() -> i64 {
    return 907;
}

// code_kind_owned marks a '%kizu.owned' runtime handle value (e.g. the io handle
// returned by std::io::blocking()). code_kind_slice marks a runtime
// '%kizu.slice.u8' value (e.g. the bytes returned by std::fs::read_file), as
// distinct from code_kind_str, which names a CONST_STR global rather than an SSA
// slice value.
pub fn code_kind_owned() -> i64 {
    return 4;
}

pub fn code_kind_slice() -> i64 {
    return 5;
}

pub fn code_kind_handle() -> i64 {
    return 6;
}

pub fn code_kind_owned_string() -> i64 {
    return 7;
}

pub fn code_kind_owned_array_i64() -> i64 {
    return 8;
}

pub fn code_kind_owned_array_bool() -> i64 {
    return 11;
}

pub fn code_kind_owned_array_slice() -> i64 {
    return 12;
}

pub fn code_kind_owned_map_i64() -> i64 {
    return 9;
}

pub fn code_kind_borrowed_map_i64() -> i64 {
    return 13;
}

pub fn code_kind_mut_borrowed_map_i64() -> i64 {
    return 14;
}

// code_kind_fs_metadata marks a '%kizu.fs.metadata' aggregate value (the success
// arm of 'try std::fs::metadata(...)'). It stays a scalar kind below
// code_kind_struct_base so a field read dispatches to FS_METADATA_FIELD instead of
// the record-backed struct path.
pub fn code_kind_fs_metadata() -> i64 {
    return 15;
}

// code_kind_owned_map_bool marks a 'Map<[]u8, bool>' handle. It shares the
// i64-valued '%kizu.rt.map' storage and runtime symbols of code_kind_owned_map_i64();
// the bool value is packed into the i64 slot (zext 0/1) at insert and restored
// (icmp ne 0) on get, mirroring how Array<EnumType> reuses the i64 element store.
// 16 is the next free scalar kind value (13/14 are the PR-b borrowed maps, 15 is
// fs_metadata), so it never collides with the i64/enum/borrow map kinds.
pub fn code_kind_owned_map_bool() -> i64 {
    return 16;
}

pub fn code_kind_owned_box_i64() -> i64 {
    return 17;
}

pub fn code_kind_error_box_i64() -> i64 {
    return 18;
}

// code_kind_mut_borrow_i64 marks a scalar '&var i64' parameter (and the
// VAR_ADDR value a caller passes for one): unlike the value-model read borrow
// '&i64', the mutable borrow flows as a 'ptr' to the caller's i64 var slot so a
// callee 'n.*' read/write loads/stores through it and the mutation is observed
// by the caller. It stays a small scalar kind below code_kind_struct_base; the
// renderer maps it to 'ptr'.
pub fn code_kind_mut_borrow_i64() -> i64 {
    return 19;
}

pub fn code_kind_is_mut_borrow_scalar(kind: i64) -> bool {
    return kind == code_kind_mut_borrow_i64();
}

// code_kind_mut_borrow_slice marks a '&var []u8' parameter (and the
// VAR_ADDR_SLICE value a caller passes for one): like the scalar mutable borrow
// it flows as a 'ptr' to the caller's slice var slot so a callee 's.*' read/write
// loads/stores the '%kizu.slice.u8' value through it and the mutation is observed
// by the caller. The renderer maps it to 'ptr'.
pub fn code_kind_mut_borrow_slice() -> i64 {
    return 20;
}

pub fn code_kind_is_mut_borrow_slice(kind: i64) -> bool {
    return kind == code_kind_mut_borrow_slice();
}

// code_kind_is_mut_borrow_ptr reports any '&var' pointer kind (scalar i64 or
// slice []u8): both flow as a 'ptr' to a caller var slot and render identically.
pub fn code_kind_is_mut_borrow_ptr(kind: i64) -> bool {
    if code_kind_is_mut_borrow_scalar(kind) {
        return true;
    }
    return code_kind_is_mut_borrow_slice(kind);
}

pub fn code_kind_is_owned_box(kind: i64) -> bool {
    return kind == code_kind_owned_box_i64();
}

fn code_kind_owned_map_enum_base() -> i64 {
    return 0 - 600000000;
}

fn code_kind_owned_map_enum(enum_decl_pos: i64) -> i64 {
    return code_kind_owned_map_enum_base() - enum_decl_pos;
}

fn code_kind_is_owned_map_enum(kind: i64) -> bool {
    if kind > code_kind_owned_map_enum_base() {
        return false;
    }
    return kind > code_kind_owned_array_struct_base();
}

fn code_kind_owned_map_enum_decl_pos(kind: i64) -> i64 {
    return code_kind_owned_map_enum_base() - kind;
}

pub fn code_kind_is_owned_map(kind: i64) -> bool {
    if kind == code_kind_owned_map_i64() {
        return true;
    }
    if kind == code_kind_owned_map_bool() {
        return true;
    }
    return code_kind_is_owned_map_enum(kind);
}

pub fn code_kind_is_borrowed_map(kind: i64) -> bool {
    if kind == code_kind_borrowed_map_i64() {
        return true;
    }
    return kind == code_kind_mut_borrowed_map_i64();
}

fn code_kind_is_map_handle(kind: i64) -> bool {
    if code_kind_is_owned_map(kind) {
        return true;
    }
    return code_kind_is_borrowed_map(kind);
}

fn code_kind_is_mutable_map_handle(kind: i64) -> bool {
    if code_kind_is_owned_map(kind) {
        return true;
    }
    return kind == code_kind_mut_borrowed_map_i64();
}

pub fn code_kind_arena() -> i64 {
    return 10;
}

pub fn code_kind_owned_arena_slice_struct() -> i64 {
    return code_kind_arena();
}

fn code_kind_arena_record_base() -> i64 {
    return 0 - 1000000000;
}

fn code_kind_arena_record(record_pos: i64) -> i64 {
    return code_kind_arena_record_base() - record_pos;
}

pub fn code_kind_is_arena(kind: i64) -> bool {
    if kind == code_kind_arena() {
        return true;
    }
    return kind <= code_kind_arena_record_base();
}

// code_kind_is_enum_value reports whether a kinds entry is a record-backed enum
// value (an ENUM_CONST literal or an ENUM_DECL-typed result). Both carry the
// i64-tag ABI, so callers can route them through the i64 element path; STRUCT_LIT
// and STRUCT_DECL records (different ABI) and every scalar kind return false.
fn code_kind_is_enum_value(
    code: &var std::array::Array<i64>,
    kind: i64
) -> !bool {
    let base = code_kind_struct_base();
    if kind < base {
        return false;
    }
    let record_pos = kind - base;
    if record_pos >= code.len() {
        return false;
    }
    let op = try code.get(record_pos);
    if op == code_op_enum_const() {
        return true;
    }
    return op == code_op_enum_decl();
}

fn code_kind_arena_record_pos(kind: i64) -> i64 {
    if kind <= code_kind_arena_record_base() {
        return code_kind_arena_record_base() - kind;
    }
    return 0 - 1;
}

fn code_kind_is_owned_resource(kind: i64) -> bool {
    if kind == code_kind_owned_string() {
        return true;
    }
    if code_kind_is_owned_array(kind) {
        return true;
    }
    if code_kind_is_owned_map(kind) {
        return true;
    }
    if code_kind_is_owned_box(kind) {
        return true;
    }
    return code_kind_is_arena(kind);
}

pub fn code_kind_is_owned_array(kind: i64) -> bool {
    if kind == code_kind_owned_array_i64() {
        return true;
    }
    if kind == code_kind_owned_array_bool() {
        return true;
    }
    if kind == code_kind_owned_array_slice() {
        return true;
    }
    if code_kind_is_owned_array_enum(kind) {
        return true;
    }
    return code_kind_is_owned_array_struct(kind);
}

fn code_array_element_kind(code: &var std::array::Array<i64>, array_kind: i64) -> !i64 {
    if array_kind == code_kind_owned_array_i64() {
        return code_kind_i64();
    }
    if array_kind == code_kind_owned_array_bool() {
        return code_kind_bool();
    }
    if array_kind == code_kind_owned_array_slice() {
        return code_kind_slice();
    }
    if code_kind_is_owned_array_enum(array_kind) {
        return code_kind_i64();
    }
    if code_kind_is_owned_array_struct(array_kind) {
        let record_pos = code_kind_owned_array_struct_record_pos(array_kind);
        return try struct_param_first_field_kind(code, record_pos);
    }
    return 0 - 1;
}

fn code_array_element_size(code: &var std::array::Array<i64>, array_kind: i64) -> !i64 {
    let element_kind = try code_array_element_kind(code, array_kind);
    if element_kind == code_kind_i64() {
        return 8;
    }
    if element_kind == code_kind_bool() {
        return 1;
    }
    if element_kind == code_kind_slice() {
        return 16;
    }
    return 0 - 1;
}

// An Array<EnumType> carries the i64-tag ABI like Array<i64>, but it must also
// remember which enum its elements are so Array.get can restore the enum
// identity on the result value: a bare owned_array_i64 kind erases that, and a
// later print would emit the raw discriminant tag instead of the variant name
// (issue 1347). The kind encodes the element enum's ENUM_DECL record position below a
// dedicated base, kept above the arena-record band so it is never mistaken for
// an arena handle. Storage/append/len stay on the i64 element path
// (code_array_element_kind reports i64); only the get result kind differs.
fn code_kind_owned_array_enum_base() -> i64 {
    return 0 - 500000000;
}

fn code_kind_owned_array_enum(enum_decl_pos: i64) -> i64 {
    return code_kind_owned_array_enum_base() - enum_decl_pos;
}

fn code_kind_is_owned_array_enum(kind: i64) -> bool {
    if kind > code_kind_owned_array_enum_base() {
        return false;
    }
    return kind > code_kind_owned_map_enum_base();
}

fn code_kind_owned_array_enum_decl_pos(kind: i64) -> i64 {
    return code_kind_owned_array_enum_base() - kind;
}

// Array<SingleFieldStruct> stores the single field using the field's ABI, while
// the value kind exposed by Array.at/get is a STRUCT_PARAM record so '.field'
// reads stay type-directed and identity-lowered. The encoded record position is
// the STRUCT_PARAM record, not the original STRUCT_DECL.
fn code_kind_owned_array_struct_base() -> i64 {
    return 0 - 700000000;
}

fn code_kind_owned_array_struct(struct_param_pos: i64) -> i64 {
    return code_kind_owned_array_struct_base() - struct_param_pos;
}

fn code_kind_is_owned_array_struct(kind: i64) -> bool {
    if kind > code_kind_owned_array_struct_base() {
        return false;
    }
    return kind > code_kind_arena_record_base();
}

fn code_kind_owned_array_struct_record_pos(kind: i64) -> i64 {
    return code_kind_owned_array_struct_base() - kind;
}

fn struct_param_first_field_kind(
    code: &var std::array::Array<i64>,
    record_pos: i64
) -> !i64 {
    return try code.get(record_pos + 4);
}

// code_array_get_result_kind reports the kinds-array entry for an Array.get
// result: an enum-element array restores the enum record-backed value kind
// (struct_base + ENUM_DECL pos, the same kind a plain enum value carries) so the
// result prints as the variant name; a single-field struct array restores its
// STRUCT_PARAM record kind so field reads unwrap through the field ABI; every
// other array yields its scalar element kind.
fn code_array_get_result_kind(code: &var std::array::Array<i64>, receiver_kind: i64) -> !i64 {
    if code_kind_is_owned_array_struct(receiver_kind) {
        let record_pos = code_kind_owned_array_struct_record_pos(receiver_kind);
        let record_base = code_kind_struct_base();
        return record_base + record_pos;
    }
    if !code_kind_is_owned_array_enum(receiver_kind) {
        return try code_array_element_kind(code, receiver_kind);
    }
    let enum_pos = code_kind_owned_array_enum_decl_pos(receiver_kind);
    let record_base = code_kind_struct_base();
    return record_base + enum_pos;
}

fn code_map_value_kind(map_kind: i64) -> i64 {
    if map_kind == code_kind_owned_map_i64() {
        return code_kind_i64();
    }
    if map_kind == code_kind_owned_map_bool() {
        return code_kind_bool();
    }
    if code_kind_is_borrowed_map(map_kind) {
        return code_kind_i64();
    }
    if code_kind_is_owned_map_enum(map_kind) {
        return code_kind_i64();
    }
    return 0 - 1;
}

fn code_map_get_result_kind(map_kind: i64) -> i64 {
    if !code_kind_is_owned_map_enum(map_kind) {
        return code_map_value_kind(map_kind);
    }
    let enum_pos = code_kind_owned_map_enum_decl_pos(map_kind);
    let record_base = code_kind_struct_base();
    return record_base + enum_pos;
}

// code_kind_struct_base marks a record-backed value on the kinds array: the
// entry stores base + <record tape index> for STRUCT_LIT and ENUM_CONST values,
// so a consumer recovers the record position directly from the kind (the opcode
// at that position tells the two apart) while every scalar kind check rejects
// record-backed values without a dedicated guard.
pub fn code_kind_struct_base() -> i64 {
    return 1000;
}

fn code_binary_kind(op: std::kizu::ast::BinaryOp) -> i64 {
    if op == std::kizu::ast::binary_add() {
        return 1;
    }
    if op == std::kizu::ast::binary_sub() {
        return 2;
    }
    if op == std::kizu::ast::binary_mul() {
        return 3;
    }
    if op == std::kizu::ast::binary_div() {
        return 4;
    }
    if op == std::kizu::ast::binary_mod() {
        return 11;
    }
    if op == std::kizu::ast::binary_eq() {
        return 5;
    }
    if op == std::kizu::ast::binary_not_eq() {
        return 6;
    }
    if op == std::kizu::ast::binary_lt() {
        return 7;
    }
    if op == std::kizu::ast::binary_lte() {
        return 8;
    }
    if op == std::kizu::ast::binary_gt() {
        return 9;
    }
    if op == std::kizu::ast::binary_gte() {
        return 10;
    }
    return 0;
}

// code_binary_kind_is_comparison reports whether a binary kind id is a comparison
// (eq/not_eq/lt/lte/gt/gte); such results are i1 booleans, the rest are i64.
fn code_binary_kind_is_comparison(kind: i64) -> bool {
    return kind >= 5 and kind <= 10;
}

// code_return_kind classifies a function's declared return type for the tape:
// 0 = void (empty or 'void'), 1 = i64, 2 = error-union void ('!void'),
// 3 = error-union i64 ('!i64'), code_return_kind_bool() = bool,
// code_return_kind_owned_*_err() = '%kizu.error.owned' success payload,
// record_base + <UNION_DECL position> for a
// declared union (the runtime aggregate return), record_base + <ENUM_DECL
// position> for a declared enum (the i64 tag ABI with enum identity),
// record_base + <STRUCT_DECL position> for a declared struct aggregate, -1 = a
// type the tape does not own yet.
fn code_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    if is_empty_node(ast, type_node) {
        return 0;
    }
    if type_node_is_i64(text, ast, type_node) {
        return 1;
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return code_return_kind_bool();
    }
    if std::mem::equal_bytes(type_text, "void") {
        return 0;
    }
    if std::mem::equal_bytes(type_text, "!void") {
        return 2;
    }
    if std::mem::equal_bytes(type_text, "!i64") {
        return 3;
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_return_kind_slice();
    }
    if std::mem::equal_bytes(type_text, "std::string::String") {
        return code_kind_owned_string();
    }
    if std::mem::equal_bytes(type_text, "!std::string::String") {
        return code_return_kind_owned_string_err();
    }
    let array_err = code_error_union_array_return_kind(type_text);
    if array_err != code_kind_missing() {
        return array_err;
    }
    let typed_err = try code_typed_error_union_return_kind(text, ast, type_node, code);
    if typed_err != code_kind_missing() {
        return typed_err;
    }
    let union_kind = try code_param_union_kind(text, ast, type_node, code);
    if union_kind >= 0 {
        return union_kind;
    }
    let enum_kind = try code_return_enum_kind(text, ast, type_node, code);
    if enum_kind >= 0 {
        return enum_kind;
    }
    let struct_kind = try code_return_struct_kind(text, ast, type_node, code);
    if struct_kind >= 0 {
        return struct_kind;
    }
    return 0 - 1;
}

fn code_return_kind_result_kind(ret_kind: i64) -> i64 {
    let bool_ret = code_return_kind_bool();
    if ret_kind == bool_ret {
        return code_kind_bool();
    }
    let slice_ret = code_return_kind_slice();
    if ret_kind == slice_ret {
        return code_kind_slice();
    }
    if ret_kind == code_return_kind_owned_string_err() {
        return code_kind_owned_string();
    }
    let array_result = code_error_union_array_result_kind(ret_kind);
    if array_result != code_kind_missing() {
        return array_result;
    }
    if ret_kind == code_return_kind_typed_error_i64() {
        return code_kind_i64();
    }
    return ret_kind;
}

fn code_error_union_array_return_kind(type_text: []u8) -> i64 {
    let prefix = "!std::array::Array<";
    if !std::mem::starts_with(type_text, prefix) {
        return code_kind_missing();
    }
    let text_len = std::mem::len(type_text);
    let prefix_len = std::mem::len(prefix);
    if text_len <= prefix_len {
        return code_kind_missing();
    }
    let last = text_len - 1;
    if type_text[last] != cast<u8>(62) {
        return code_kind_missing();
    }
    let element = type_text[prefix_len..last];
    if std::mem::equal_bytes(element, "i64") {
        return code_return_kind_owned_array_i64_err();
    }
    if std::mem::equal_bytes(element, "bool") {
        return code_return_kind_owned_array_bool_err();
    }
    if std::mem::equal_bytes(element, "[]u8") {
        return code_return_kind_owned_array_slice_err();
    }
    return code_kind_missing();
}

fn code_error_union_array_result_kind(ret_kind: i64) -> i64 {
    if ret_kind == code_return_kind_owned_array_i64_err() {
        return code_kind_owned_array_i64();
    }
    if ret_kind == code_return_kind_owned_array_bool_err() {
        return code_kind_owned_array_bool();
    }
    if ret_kind == code_return_kind_owned_array_slice_err() {
        return code_kind_owned_array_slice();
    }
    return code_kind_missing();
}

// code_typed_error_union_return_kind classifies 'Error!i64' and 'Error!void'
// return annotations when Error names a declared union. The run tape uses a
// shared typed-error ABI whose failure field is a '%kizu.run.union' payload; the
// checker has already proven that try propagation only crosses matching error
// union types.
fn code_typed_error_union_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let span = code_node_span(text, ast, type_node);
    let bang = code_typed_error_bang_index(text, span.end, span.start);
    if bang <= span.start {
        return code_kind_missing();
    }
    let success_start = bang + 1;
    if success_start >= span.end {
        return code_kind_missing();
    }
    let union_pos = try union_decl_pos_by_span(text, code, span.start, bang, 0);
    if union_pos < 0 {
        return code_kind_missing();
    }
    let success = text[success_start..span.end];
    if std::mem::equal_bytes(success, "i64") {
        return code_return_kind_typed_error_i64();
    }
    if std::mem::equal_bytes(success, "void") {
        return code_return_kind_typed_error_void();
    }
    return code_kind_missing();
}

fn code_typed_error_bang_index(text: []u8, end: i64, index: i64) -> i64 {
    if index >= end {
        return 0 - 1;
    }
    let bang = cast<u8>(33);
    if text[index] == bang {
        return index;
    }
    let next = index + 1;
    return code_typed_error_bang_index(text, end, next);
}

// code_node_span returns the trimmed (start, end) byte span of a node's source
// text, so identifier operands land on the tape as exact spans.
fn code_node_span(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> PayloadSpan {
    let node = ast.get(node_id);
    let span_start = node.span.start;
    let span_end = node.span.end;
    let start = code_span_trim_start(text, span_start, span_end);
    let end = code_span_trim_end(text, start, span_end);
    return PayloadSpan {
        start: start,
        end: end
    };
}

fn code_span_trim_start(text: []u8, start: i64, end: i64) -> i64 {
    if start >= end {
        return start;
    }
    if !code_span_space(text[start]) {
        return start;
    }
    let after = start + 1;
    return code_span_trim_start(text, after, end);
}

fn code_span_trim_end(text: []u8, start: i64, end: i64) -> i64 {
    if end <= start {
        return end;
    }
    let last = end - 1;
    if !code_span_space(text[last]) {
        return end;
    }
    return code_span_trim_end(text, start, last);
}

fn code_span_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or
        byte == cast<u8>(9) or
        byte == cast<u8>(10) or
        byte == cast<u8>(13);
}

// lower_code_module lowers the whole checked file onto the tape: every
// top-level declaration must be a function the tape owns.
pub fn lower_code_module(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>
) -> !CodeEval {
    try scratch_init(args_scratch);
    return try lower_code_program(text, ast, root, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records);
}

// scratch_init seeds the call-arg scratch as an explicit stack: slot 0 holds the
// stack pointer (the next free slot) and the argument slots start at 1. A nested
// call argument allocates its own frame above its caller's reserved slots and the
// pointer pops back when each CALL record copies its frame, so arbitrarily nested
// call arguments keep every frame contiguous without an array-truncate primitive
// (dead deeper slots are overwritten through scratch_put).
fn scratch_init(args_scratch: &var std::array::Array<i64>) -> !void {
    try args_scratch.append(1);
    return;
}

// lower_code_program dispatches the checked file's root onto the declaration walk.
fn lower_code_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_code_program_decls(text, ast, program.declarations, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records),
        _ => code_eval_unsupported(0),
    };
}

// lower_code_program_decls emits declaration identity records at the head of the
// tape, then walks the functions. UNION_DECL records come first so the existing
// union lookup can stop at the first non-union record; ENUM_DECL records follow
// to preserve enum identity for function return values, then STRUCT_DECL records
// preserve returned struct ABI shapes.
fn lower_code_program_decls(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>
) -> !CodeEval {
    let decls_eval = try emit_union_decl_records(text, ast, decls, code, 0);
    if !decls_eval.ok {
        return code_eval_unsupported(decls_eval.next);
    }
    let enum_eval = try emit_enum_decl_records(text, ast, decls, code, 0);
    if !enum_eval.ok {
        return code_eval_unsupported(enum_eval.next);
    }
    let struct_eval = try emit_struct_decl_records(text, ast, decls, code, 0);
    if !struct_eval.ok {
        return code_eval_unsupported(struct_eval.next);
    }
    return try lower_code_declarations(text, ast, decls, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, 0, struct_eval.next);
}

// emit_union_decl_records walks the top-level declarations and records every
// union's runtime layout before any function record lands on the tape.
fn emit_union_decl_records(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !CodeEval {
    if index >= decls.len {
        return code_eval_value(0, 0);
    }
    let child = try ast.child_at(decls, index);
    let eval = try emit_union_decl_record(text, ast, child, code);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try emit_union_decl_records(text, ast, decls, code, after);
}

// emit_union_decl_record routes one top-level declaration: a union emits its
// layout record, every other declaration emits nothing (the pass allocates no
// tape values, so the eval's value ids stay at zero).
fn emit_union_decl_record(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        UnionDecl(union_decl) => try emit_one_union_decl(text, ast, union_decl.name, union_decl.variants, code),
        _ => code_eval_value(0, 0),
    };
}

fn emit_one_union_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    variants: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let name_span = code_node_span(text, ast, name);
    let op_union_decl = code_op_union_decl();
    try code.append(op_union_decl);
    try code.append(name_span.start);
    try code.append(name_span.end);
    try code.append(variants.len);
    return try append_union_decl_variants(text, ast, variants, code, 0);
}

fn append_union_decl_variants(
    text: []u8,
    ast: std::kizu::ast::Ast,
    variants: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !CodeEval {
    if index >= variants.len {
        return code_eval_value(0, 0);
    }
    let child = try ast.child_at(variants, index);
    let eval = try append_union_decl_variant(text, ast, child, code);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try append_union_decl_variants(text, ast, variants, code, after);
}

// append_union_decl_variant routes one declared variant into its layout entry
// (a non-variant child appends nothing; the pass allocates no tape values).
fn append_union_decl_variant(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        UnionVariant(variant) => try append_union_variant_entry(text, ast, variant.name, variant.payload, code),
        _ => code_eval_value(0, 0),
    };
}

fn append_union_variant_entry(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    payload: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let name_span = code_node_span(text, ast, name);
    try code.append(name_span.start);
    try code.append(name_span.end);
    let payload_kind = try union_payload_kind(text, ast, code, payload);
    try code.append(payload_kind);
    return code_eval_value(0, 0);
}

fn emit_enum_decl_records(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !CodeEval {
    if index >= decls.len {
        return code_eval_value(0, 0);
    }
    let child = try ast.child_at(decls, index);
    let eval = try emit_enum_decl_record(text, ast, child, code);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try emit_enum_decl_records(text, ast, decls, code, after);
}

fn emit_enum_decl_record(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        EnumDecl(enum_decl) => try emit_one_enum_decl(text, ast, enum_decl.name, enum_decl.tags, code),
        _ => code_eval_value(0, 0),
    };
}

fn emit_one_enum_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    tags: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let name_span = code_node_span(text, ast, name);
    let op_enum_decl = code_op_enum_decl();
    try code.append(op_enum_decl);
    try code.append(name_span.start);
    try code.append(name_span.end);
    try code.append(tags.len);
    return try append_enum_decl_variants(text, ast, tags, code, 0);
}

fn append_enum_decl_variants(
    text: []u8,
    ast: std::kizu::ast::Ast,
    tags: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !CodeEval {
    if index >= tags.len {
        return code_eval_value(0, 0);
    }
    let child = try ast.child_at(tags, index);
    let tag_span = code_node_span(text, ast, child);
    try code.append(tag_span.start);
    try code.append(tag_span.end);
    let after = index + 1;
    return try append_enum_decl_variants(text, ast, tags, code, after);
}

fn emit_struct_decl_records(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !CodeEval {
    if index >= decls.len {
        return code_eval_value(0, 0);
    }
    let child = try ast.child_at(decls, index);
    let eval = try emit_struct_decl_record(text, ast, child, code);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try emit_struct_decl_records(text, ast, decls, code, after);
}

fn emit_struct_decl_record(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        StructDecl(struct_decl) => try emit_one_struct_decl(text, ast, struct_decl.name, struct_decl.fields, code),
        _ => code_eval_value(0, 0),
    };
}

fn emit_one_struct_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    if fields.len == 0 {
        return code_eval_value(0, 0);
    }
    let supported = try struct_decl_fields_supported(text, ast, fields, code, 0);
    if !supported {
        return code_eval_value(0, 0);
    }
    let name_span = code_node_span(text, ast, name);
    let op_struct_decl = code_op_struct_decl();
    try code.append(op_struct_decl);
    try code.append(name_span.start);
    try code.append(name_span.end);
    try code.append(fields.len);
    return try append_struct_decl_fields(text, ast, fields, code, 0);
}

fn struct_decl_fields_supported(
    text: []u8,
    ast: std::kizu::ast::Ast,
    fields: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !bool {
    if index >= fields.len {
        return true;
    }
    let child = try ast.child_at(fields, index);
    let kind = try code_struct_decl_field_kind(text, ast, child, code);
    if kind < 0 {
        return false;
    }
    let after = index + 1;
    return try struct_decl_fields_supported(text, ast, fields, code, after);
}

fn append_struct_decl_fields(
    text: []u8,
    ast: std::kizu::ast::Ast,
    fields: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !CodeEval {
    if index >= fields.len {
        return code_eval_value(0, 0);
    }
    let child = try ast.child_at(fields, index);
    let eval = try append_struct_decl_field(text, ast, child, code);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try append_struct_decl_fields(text, ast, fields, code, after);
}

fn append_struct_decl_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        Field(field_node) => try append_struct_decl_field_entry(text, ast, field_node.name, field_node.type_node, code),
        _ => code_eval_unsupported(0),
    };
}

fn append_struct_decl_field_entry(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let name_span = code_node_span(text, ast, name);
    try code.append(name_span.start);
    try code.append(name_span.end);
    let field_kind = try code_struct_decl_field_type_kind(text, ast, type_node, code);
    try code.append(field_kind);
    return code_eval_value(0, 0);
}

fn code_struct_decl_field_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let node = ast.get(field_id);
    return match node.data {
        Field(field_node) => try code_struct_decl_field_type_kind(text, ast, field_node.type_node, code),
        _ => code_kind_missing(),
    };
}

fn code_struct_decl_field_type_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    if type_node_is_i64(text, ast, type_node) {
        return code_kind_i64();
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return code_kind_bool();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_kind_slice();
    }
    return try code_return_struct_kind(text, ast, type_node, code);
}

// union_payload_kind classifies a variant payload type for the runtime layout:
// 0 for a payload-less variant, kind i64 or kind slice for the supported
// payload types, and -1 for anything else (functions touching that union stay
// unsupported when the payload is read).
fn union_payload_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    code: &var std::array::Array<i64>,
    payload: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(payload);
    return match node.data {
        Empty => 0,
        _ => try union_payload_type_kind(text, ast, code, payload),
    };
}

fn union_payload_type_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    code: &var std::array::Array<i64>,
    payload: std::kizu::ast::NodeId
) -> !i64 {
    let type_text = ast_node_text(text, ast, payload);
    if std::mem::equal_bytes(type_text, "i64") {
        return code_kind_i64();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_kind_slice();
    }
    return try union_payload_union_kind(text, ast, code, payload);
}

// union_payload_union_kind classifies a union-typed variant payload: when the
// payload type names a union already emitted on the tape, the layout entry
// stores record_base + <its UNION_DECL position>, the same kind a runtime union
// value of that type carries. UNION_PACK then boxes the nested union on the heap
// and UNION_PAYLOAD loads it back, while a match arm binds the inner union value
// with that kind so its own variants resolve. Any other payload type stays
// unclassified (-1), keeping the enclosing union unsupported when it is read.
fn union_payload_union_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    code: &var std::array::Array<i64>,
    payload: std::kizu::ast::NodeId
) -> !i64 {
    let span = code_node_span(text, ast, payload);
    let decl_pos = try union_decl_pos_by_span(text, code, span.start, span.end, 0);
    if decl_pos < 0 {
        return 0 - 1;
    }
    return code_kind_struct_base() + decl_pos;
}

fn lower_code_declarations(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= decls.len {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(decls, index);
    let eval = try lower_code_function(text, ast, decls, child, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_declarations(text, ast, decls, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, after, eval.next);
}

fn lower_code_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    decl_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(decl_id);
    // A struct or enum declaration emits nothing: struct literals carry their
    // own field names, enum constants resolve their tags against the
    // declaration on demand, and the checked AST already validated both.
    return match node.data {
        FnDecl(fn_decl) => try lower_code_fn_decl(text, ast, decls, fn_decl.name, fn_decl.params, fn_decl.return_type, fn_decl.body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, next_value),
        StructDecl(struct_decl) => code_eval_value(0, next_value),
        EnumDecl(enum_decl) => code_eval_value(0, next_value),
        UnionDecl(union_decl) => code_eval_value(0, next_value),
        ImplDecl(impl_decl) => try lower_code_impl_decl(text, ast, decls, impl_decl.type_name, impl_decl.methods, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_impl_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_name: std::kizu::ast::NodeId,
    methods: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_impl_methods(text, ast, decls, type_name, methods, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, 0, next_value);
    return eval;
}

fn lower_code_impl_methods(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_name: std::kizu::ast::NodeId,
    methods: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= methods.len {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(methods, index);
    let eval = try lower_code_impl_method(text, ast, decls, type_name, child, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    let next_eval = try lower_code_impl_methods(text, ast, decls, type_name, methods, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, after, eval.next);
    return next_eval;
}

fn lower_code_impl_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_name: std::kizu::ast::NodeId,
    method: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(method);
    return match node.data {
        FnDecl(fn_decl) => try lower_code_method_fn_decl(text, ast, decls, type_name, fn_decl.name, fn_decl.params, fn_decl.return_type, fn_decl.body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_fn_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let ret_kind = try code_return_kind(text, ast, return_type, code);
    if ret_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    // A run function is named by an identifier; a test declaration (whose name
    // is a string literal) is not a run-tape function.
    if !code_node_is_var(ast, name) {
        return code_eval_unsupported(next_value);
    }
    let name_span = code_node_span(text, ast, name);
    let op_func_begin = code_op_func_begin();
    try code.append(op_func_begin);
    try code.append(name_span.start);
    try code.append(name_span.end);
    try code.append(params.len);
    try code.append(ret_kind);
    // The renderer names parameter SSA temps from their value ids; params are
    // assigned sequentially from next_value, so record that base on the tape.
    try code.append(next_value);
    let locals_base = local_starts.len();
    let params_eval = try lower_code_params(text, ast, decls, params, code, kinds, local_starts, local_ends, local_values, 0, next_value);
    if !params_eval.ok {
        return code_eval_unsupported(params_eval.next);
    }
    // A function body starts outside any loop; bind the no-loop sentinel to a
    // local so it reaches lower_code_body as a plain arg (an arith literal like
    // '0 - 1' passed straight to a call is outside the compiled call-arg shape).
    let no_loop = 0 - 1;
    // The function's top block shares its scope with the parameters (a let that
    // re-binds a parameter name is the checker-illegal duplicate), so its scope
    // base is locals_base rather than the post-params length.
    let body_eval = try lower_code_body_scoped(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, locals_base, no_loop, no_loop, params_eval.next);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let op_func_end = code_op_func_end();
    try code.append(op_func_end);
    return code_eval_value(0, body_eval.next);
}

fn lower_code_method_fn_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_name: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let ret_kind = try code_return_kind(text, ast, return_type, code);
    if ret_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    if !code_node_is_var(ast, name) {
        return code_eval_unsupported(next_value);
    }
    let type_span = code_node_span(text, ast, type_name);
    let name_span = code_node_span(text, ast, name);
    let op_func_begin = code_op_method_func_begin();
    try code.append(op_func_begin);
    try code.append(type_span.start);
    try code.append(type_span.end);
    try code.append(name_span.start);
    try code.append(name_span.end);
    try code.append(params.len);
    try code.append(ret_kind);
    try code.append(next_value);
    let locals_base = local_starts.len();
    let params_eval = try lower_code_params(text, ast, decls, params, code, kinds, local_starts, local_ends, local_values, 0, next_value);
    if !params_eval.ok {
        return code_eval_unsupported(params_eval.next);
    }
    let no_loop = 0 - 1;
    let body_eval = try lower_code_body_scoped(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, locals_base, no_loop, no_loop, params_eval.next);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let op_func_end = code_op_func_end();
    try code.append(op_func_end);
    return code_eval_value(0, body_eval.next);
}

// code_node_is_var reports whether a node is a bare identifier (Var) node. It is
// the single let+return-match accessor shape the compiled traversal path lowers
// (bool-literal arms).
fn code_node_is_var(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Var(var_node) => true,
        _ => false,
    };
}

// lower_code_body walks a nested block's statements onto the tape inside a fresh
// binding scope: bindings introduced in the block shadow outer ones while it is
// open and stop resolving once it closes.
fn lower_code_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let scope_base = local_starts.len();
    return try lower_code_body_scoped(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, scope_base, loop_begin, loop_kind, next_value);
}

fn lower_code_body_scoped(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let body_node = ast.get(body);
    return match body_node.data {
        Block(block) => try lower_code_scoped_statements(text, ast, decls, block.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, scope_base, loop_begin, loop_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_scoped_statements lowers one block's statements and then blanks the
// bindings the block introduced (at or above scope_base), closing the scope.
fn lower_code_scoped_statements(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let defer_base = defer_records.len();
    let errdefer_base = code.len();
    let eval = try lower_code_statements(text, ast, decls, statements, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, scope_base, loop_begin, loop_kind, 0, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let defer_eval = try lower_code_defer_range(text, ast, decls, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, defer_base, eval.next);
    if !defer_eval.ok {
        return code_eval_unsupported(defer_eval.next);
    }
    let op_errdefer_scope_end = code_op_errdefer_scope_end();
    try code.append(op_errdefer_scope_end);
    try code.append(errdefer_base);
    try scrub_code_locals(local_starts, local_ends, scope_base);
    return code_eval_value(0, defer_eval.next);
}

// scrub_code_locals blanks the name spans of every local bound at or above mark:
// the locals arrays have no truncate primitive, and an empty span never matches
// an identifier, so a closed scope's bindings stop resolving in place.
fn scrub_code_locals(
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    mark: i64
) -> !void {
    let used = local_starts.len();
    if mark >= used {
        return;
    }
    try local_starts.set(mark, 0);
    try local_ends.set(mark, 0);
    let after = mark + 1;
    try scrub_code_locals(local_starts, local_ends, after);
    return;
}

fn lower_code_defer(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    expr: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_code_defer_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_defer_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let runtime_defer = try append_code_defer_runtime_deinit(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, next_value);
    if runtime_defer.ok {
        return runtime_defer;
    }
    let method_kind = try code_method_call_return_kind(text, ast, decls, code, callee);
    if method_kind == 0 {
        return try append_code_defer_method_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, 1, next_value);
    }
    if method_kind == 1 {
        return try append_code_defer_method_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, 1, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_errdefer(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    expr: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_code_errdefer_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_errdefer_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_errdefer_deinit_field(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_errdefer_deinit_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let method = ast_node_text(text, ast, name);
    if !std::mem::equal_bytes(method, "deinit") {
        return code_eval_unsupported(next_value);
    }
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let receiver_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    if !code_kind_is_owned_resource(receiver_kind) {
        return code_eval_unsupported(receiver_eval.next);
    }
    let op_errdefer_deinit = code_op_errdefer_deinit();
    try code.append(op_errdefer_deinit);
    try code.append(receiver_eval.value_id);
    try code.append(receiver_kind);
    return code_eval_value(0, receiver_eval.next);
}

fn append_code_defer_runtime_deinit(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try append_code_defer_runtime_deinit_field(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn append_code_defer_runtime_deinit_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let method = ast_node_text(text, ast, name);
    if !std::mem::equal_bytes(method, "deinit") {
        return code_eval_unsupported(next_value);
    }
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let receiver_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    if !code_kind_is_owned_resource(receiver_kind) {
        return code_eval_unsupported(receiver_eval.next);
    }
    let op_defer_deinit = code_op_defer_deinit();
    try code.append(op_defer_deinit);
    try code.append(receiver_eval.value_id);
    try code.append(receiver_kind);
    let tag = code_defer_runtime_deinit_tag();
    try defer_records.append(tag);
    try defer_records.append(0);
    try defer_records.append(receiver_kind);
    try defer_records.append(1);
    try defer_records.append(1);
    try defer_records.append(receiver_eval.value_id);
    try defer_records.append(7);
    return code_eval_value(0, receiver_eval.next);
}

fn append_code_defer_method_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    result_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try append_code_defer_field_method_call(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, result_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn append_code_defer_field_method_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    result_kind: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let scratch_base = try args_scratch.get(0);
    let arg_base = scratch_base + 1;
    try args_scratch.set(0, arg_base);
    let receiver_eval = try lower_code_method_receiver_arg(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    let record_base = code_kind_struct_base();
    if receiver_kind < record_base {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_record_pos = receiver_kind - record_base;
    let receiver_op = try code.get(receiver_record_pos);
    let op_struct_decl = code_op_struct_decl();
    if receiver_op != op_struct_decl {
        return code_eval_unsupported(receiver_eval.next);
    }
    let type_start = try code.get(receiver_record_pos + 1);
    let type_end = try code.get(receiver_record_pos + 2);
    try scratch_put(args_scratch, scratch_base, receiver_eval.value_id);
    let no_user_callee = code_no_user_callee();
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, arg_base, no_user_callee, no_user_callee, 0, receiver_eval.next);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    let name_span = code_node_span(text, ast, name);
    let arg_count = args.len + 1;
    try defer_records.append(name_span.start);
    try defer_records.append(name_span.end);
    try defer_records.append(result_kind);
    try defer_records.append(arg_count);
    try defer_records.append(1);
    try defer_records.append(type_start);
    try defer_records.append(type_end);
    let scratch_bound = scratch_base + arg_count;
    try append_code_defer_args(defer_records, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    let record_size = arg_count + 8;
    try defer_records.append(record_size);
    return code_eval_value(0, args_eval.next);
}

fn append_code_defer_args(
    defer_records: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    index: i64,
    bound: i64
) -> !void {
    if index >= bound {
        return;
    }
    let arg_value = try args_scratch.get(index);
    try defer_records.append(arg_value);
    let after = index + 1;
    try append_code_defer_args(defer_records, args_scratch, after, bound);
    return;
}

fn lower_code_defer_range(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    lower_bound: i64,
    next_value: i64
) -> !CodeEval {
    let count = defer_records.len();
    if count <= lower_bound {
        return code_eval_value(0, next_value);
    }
    return try lower_code_defer_range_from(text, ast, decls, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, lower_bound, count, next_value);
}

fn lower_code_defer_range_from(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    lower_bound: i64,
    upper_bound: i64,
    next_value: i64
) -> !CodeEval {
    if upper_bound <= lower_bound {
        return code_eval_value(0, next_value);
    }
    let size_pos = upper_bound - 1;
    let record_size = try defer_records.get(size_pos);
    let record_index = upper_bound - record_size;
    if record_index < lower_bound {
        return code_eval_unsupported(next_value);
    }
    let eval = try emit_code_defer_record(code, kinds, defer_records, record_index, next_value, true);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    return try lower_code_defer_range_from(text, ast, decls, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, lower_bound, record_index, eval.next);
}

fn emit_code_defer_record(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    record_index: i64,
    next_value: i64,
    deactivate: bool
) -> !CodeEval {
    let active_pos = record_index + 4;
    let active = try defer_records.get(active_pos);
    if active == 0 {
        return code_eval_value(0, next_value);
    }
    let name_start = try defer_records.get(record_index);
    let runtime_tag = code_defer_runtime_deinit_tag();
    if name_start == runtime_tag {
        return try emit_code_defer_runtime_deinit(code, defer_records, record_index, next_value, deactivate);
    }
    let op_method_call = code_op_method_call();
    try code.append(op_method_call);
    try code.append(next_value);
    let type_start_pos = record_index + 5;
    let type_start = try defer_records.get(type_start_pos);
    try code.append(type_start);
    let type_end_pos = record_index + 6;
    let type_end = try defer_records.get(type_end_pos);
    try code.append(type_end);
    try code.append(name_start);
    let name_end_pos = record_index + 1;
    let name_end = try defer_records.get(name_end_pos);
    try code.append(name_end);
    let result_kind_pos = record_index + 2;
    let result_kind = try defer_records.get(result_kind_pos);
    let arg_count_pos = record_index + 3;
    let arg_count = try defer_records.get(arg_count_pos);
    try code.append(arg_count);
    let args_start = record_index + 7;
    let args_end = args_start + arg_count;
    try copy_code_defer_args(code, defer_records, args_start, args_end);
    if deactivate {
        try defer_records.set(active_pos, 0);
    }
    try kinds.append(result_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn emit_code_defer_runtime_deinit(
    code: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    record_index: i64,
    next_value: i64,
    deactivate: bool
) -> !CodeEval {
    let receiver_kind_pos = record_index + 2;
    let receiver_kind = try defer_records.get(receiver_kind_pos);
    let receiver_pos = record_index + 5;
    let receiver_value = try defer_records.get(receiver_pos);
    if code_kind_is_arena(receiver_kind) {
        let op_arena_deinit = code_op_arena_deinit();
        try code.append(op_arena_deinit);
        try code.append(receiver_value);
    } else {
        let op_deinit = code_op_storage_deinit();
        try code.append(op_deinit);
        try code.append(receiver_value);
        try code.append(receiver_kind);
    }
    if deactivate {
        let active_pos = record_index + 4;
        try defer_records.set(active_pos, 0);
    }
    return code_eval_value(0, next_value);
}

// Early exits need the same LIFO cleanup instructions as lexical scope end, but
// must not consume the compile-time active flags: a sibling branch may still fall
// through and need the original defer record at the normal scope end.
fn lower_code_defer_range_for_exit(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    lower_bound: i64,
    next_value: i64
) -> !CodeEval {
    let count = defer_records.len();
    if count <= lower_bound {
        return code_eval_value(0, next_value);
    }
    return try lower_code_defer_range_for_exit_from(code, kinds, defer_records, lower_bound, count, next_value);
}

fn lower_code_defer_range_for_exit_from(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    lower_bound: i64,
    upper_bound: i64,
    next_value: i64
) -> !CodeEval {
    if upper_bound <= lower_bound {
        return code_eval_value(0, next_value);
    }
    let size_pos = upper_bound - 1;
    let record_size = try defer_records.get(size_pos);
    let record_index = upper_bound - record_size;
    if record_index < lower_bound {
        return code_eval_unsupported(next_value);
    }
    let eval = try emit_code_defer_record(code, kinds, defer_records, record_index, next_value, false);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    return try lower_code_defer_range_for_exit_from(code, kinds, defer_records, lower_bound, record_index, eval.next);
}

fn copy_code_defer_args(
    code: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    index: i64,
    bound: i64
) -> !void {
    if index >= bound {
        return;
    }
    let arg_value = try defer_records.get(index);
    try code.append(arg_value);
    let after = index + 1;
    try copy_code_defer_args(code, defer_records, after, bound);
    return;
}

// lower_code_params binds every parameter name to the next sequential value id;
// code_param_kind owns the supported ABI classification for each declared type.
fn lower_code_params(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= params.len {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(params, index);
    let eval = try lower_code_param_node(text, ast, decls, child, code, kinds, local_starts, local_ends, local_values, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_params(text, ast, decls, params, code, kinds, local_starts, local_ends, local_values, after, eval.next);
}

fn lower_code_param_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        Param(param) => try lower_code_param(text, ast, decls, param.name, param.type_node, code, kinds, local_starts, local_ends, local_values, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_param(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    name: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let param_kind = try code_param_kind(text, ast, decls, type_node, code);
    if param_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    let name_span = code_node_span(text, ast, name);
    try local_starts.append(name_span.start);
    try local_ends.append(name_span.end);
    try local_values.append(next_value);
    try kinds.append(param_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// union_decl_pos_by_span returns the UNION_DECL record position whose union
// name matches the span text (-1 when no record carries it). The declaration
// pass put every UNION_DECL at the head of the tape, so the scan stops at the
// first record with any other opcode.
fn union_decl_pos_by_span(
    text: []u8,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    pos: i64
) -> !i64 {
    let total = code.len();
    if pos >= total {
        return 0 - 1;
    }
    let op = try code.get(pos);
    let op_union_decl = code_op_union_decl();
    if op != op_union_decl {
        return 0 - 1;
    }
    let rec_name_start_pos = pos + 1;
    let rec_name_start = try code.get(rec_name_start_pos);
    let rec_name_end_pos = pos + 2;
    let rec_name_end = try code.get(rec_name_end_pos);
    let rec_name = text[rec_name_start..rec_name_end];
    let wanted = text[name_start..name_end];
    let count_pos = pos + 3;
    let variant_count = try code.get(count_pos);
    let entry_slots = variant_count * 3;
    let next_pos = pos + 4 + entry_slots;
    if !std::mem::equal_bytes(rec_name, wanted) {
        return try union_decl_pos_by_span(text, code, name_start, name_end, next_pos);
    }
    return pos;
}

fn code_union_decl_record_end(code: &var std::array::Array<i64>, pos: i64) -> !i64 {
    let count_pos = pos + 3;
    let variant_count = try code.get(count_pos);
    let entry_slots = variant_count * 3;
    return pos + 4 + entry_slots;
}

fn code_enum_decl_record_end(code: &var std::array::Array<i64>, pos: i64) -> !i64 {
    let count_pos = pos + 3;
    let variant_count = try code.get(count_pos);
    let entry_slots = variant_count * 2;
    return pos + 4 + entry_slots;
}

fn code_struct_decl_record_end(code: &var std::array::Array<i64>, pos: i64) -> !i64 {
    let count_pos = pos + 3;
    let field_count = try code.get(count_pos);
    let entry_slots = field_count * 3;
    return pos + 4 + entry_slots;
}

fn enum_decl_pos_by_span(
    text: []u8,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    pos: i64
) -> !i64 {
    let total = code.len();
    if pos >= total {
        return 0 - 1;
    }
    let op = try code.get(pos);
    let op_union_decl = code_op_union_decl();
    if op == op_union_decl {
        return try enum_decl_pos_after_union(text, code, name_start, name_end, pos);
    }
    let op_enum_decl = code_op_enum_decl();
    if op != op_enum_decl {
        return 0 - 1;
    }
    let rec_name_start = try code.get(pos + 1);
    let rec_name_end = try code.get(pos + 2);
    let rec_name = text[rec_name_start..rec_name_end];
    let wanted = text[name_start..name_end];
    let next_pos = try code_enum_decl_record_end(code, pos);
    if !std::mem::equal_bytes(rec_name, wanted) {
        return try enum_decl_pos_by_span(text, code, name_start, name_end, next_pos);
    }
    return pos;
}

fn enum_decl_pos_after_union(
    text: []u8,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    pos: i64
) -> !i64 {
    let next_union = try code_union_decl_record_end(code, pos);
    return try enum_decl_pos_by_span(text, code, name_start, name_end, next_union);
}

fn struct_decl_pos_by_span(
    text: []u8,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    pos: i64
) -> !i64 {
    let total = code.len();
    if pos >= total {
        return 0 - 1;
    }
    let op = try code.get(pos);
    let op_union_decl = code_op_union_decl();
    if op == op_union_decl {
        return try struct_decl_pos_after_union(text, code, name_start, name_end, pos);
    }
    let op_enum_decl = code_op_enum_decl();
    if op == op_enum_decl {
        return try struct_decl_pos_after_enum(text, code, name_start, name_end, pos);
    }
    let op_struct_decl = code_op_struct_decl();
    if op != op_struct_decl {
        return 0 - 1;
    }
    let rec_name_start = try code.get(pos + 1);
    let rec_name_end = try code.get(pos + 2);
    let rec_name = text[rec_name_start..rec_name_end];
    let wanted = text[name_start..name_end];
    let next_pos = try code_struct_decl_record_end(code, pos);
    if !std::mem::equal_bytes(rec_name, wanted) {
        return try struct_decl_pos_by_span(text, code, name_start, name_end, next_pos);
    }
    return pos;
}

fn struct_decl_pos_after_union(
    text: []u8,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    pos: i64
) -> !i64 {
    let next_union = try code_union_decl_record_end(code, pos);
    return try struct_decl_pos_by_span(text, code, name_start, name_end, next_union);
}

fn struct_decl_pos_after_enum(
    text: []u8,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    pos: i64
) -> !i64 {
    let next_enum = try code_enum_decl_record_end(code, pos);
    return try struct_decl_pos_by_span(text, code, name_start, name_end, next_enum);
}

// union_decl_variant_index returns the declaration-order index (the runtime
// tag) of the named variant in the UNION_DECL record (-1 when the record does
// not carry it).
fn union_decl_variant_index(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    variant_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= variant_count {
        return 0 - 1;
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 4 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let entry_name = text[entry_name_start..entry_name_end];
    let wanted = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, wanted) {
        return try union_decl_variant_index(text, code, record_pos, variant_count, name_start, name_end, after);
    }
    return index;
}

// code_param_kind classifies a parameter's declared type for the tape: scalar,
// slice, runtime-owned handles, and supported borrowed map parameters render
// directly, unions reference their UNION_DECL record, and single-field struct
// parameters reference a STRUCT_PARAM record so field reads resolve from type
// metadata instead of source identifier spelling.
fn code_param_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    if type_node_is_i64(text, ast, type_node) {
        return code_kind_i64();
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return code_kind_bool();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_kind_slice();
    }
    if std::mem::equal_bytes(type_text, "Allocator") {
        return code_kind_owned();
    }
    if std::mem::equal_bytes(type_text, "std::mem::Allocator") {
        return code_kind_owned();
    }
    if std::mem::equal_bytes(type_text, "std::string::String") {
        return code_kind_owned_string();
    }
    // A supported borrow parameter flows on the value tape as its referent
    // handle/value kind. General '&var T' write-back semantics are still
    // unsupported; only the map handle case below is unwrapped for interior ops.
    let borrow_kind = read_borrow_referent_kind(type_text);
    if borrow_kind >= 0 {
        return borrow_kind;
    }
    let union_kind = try code_param_union_kind(text, ast, type_node, code);
    if union_kind >= 0 {
        return union_kind;
    }
    // An enum-typed parameter resolves to its ENUM_DECL record (record_base +
    // position), the same kind code_return_kind assigns an enum return: a value
    // match over the parameter then reaches the supported enum-decl scrutinee.
    let enum_kind = try code_return_enum_kind(text, ast, type_node, code);
    if enum_kind >= 0 {
        return enum_kind;
    }
    // A by-value struct param resolves to its STRUCT_DECL record, and a read
    // borrow '&Struct' resolves to the same record kind: the borrow flows on the
    // value tape with identity semantics, so field reads share the struct
    // metadata. code_param_struct_kind skips the borrow's leading '&'.
    let struct_kind = try code_param_struct_kind(text, ast, type_node, code);
    if struct_kind >= 0 {
        return struct_kind;
    }
    return try code_param_single_field_struct_kind(text, ast, decls, type_node, code, 0);
}

// read_borrow_referent_kind resolves a read borrow '&T' parameter to the tape
// kind of its referent 'T' for the scalar/slice kinds that resolve by type text
// alone (i64, bool, []u8). It also resolves handle-backed borrows: &Map/&var
// Map<i64> parameters keep the map runtime ABI, and &var std::string::String
// keeps the owned String handle ABI because mutations happen inside the runtime
// storage object behind the handle.
fn read_borrow_referent_kind(type_text: []u8) -> i64 {
    let length = std::mem::len(type_text);
    if length < 2 {
        return 0 - 1;
    }
    let amp = cast<u8>(38);
    if type_text[0] != amp {
        return 0 - 1;
    }
    let referent = type_text[1..length];
    if std::mem::starts_with(referent, "var ") {
        return mut_borrow_referent_kind(referent);
    }
    if std::mem::equal_bytes(referent, "var") {
        return 0 - 1;
    }
    if std::mem::equal_bytes(referent, "std::map::Map<[]u8, i64>") {
        return code_kind_borrowed_map_i64();
    }
    if std::mem::equal_bytes(referent, "std::map::Map<[]u8,i64>") {
        return code_kind_borrowed_map_i64();
    }
    if std::mem::equal_bytes(referent, "std::map::Map <[]u8, i64>") {
        return code_kind_borrowed_map_i64();
    }
    if std::mem::equal_bytes(referent, "i64") {
        return code_kind_i64();
    }
    if std::mem::equal_bytes(referent, "bool") {
        return code_kind_bool();
    }
    if std::mem::equal_bytes(referent, "[]u8") {
        return code_kind_slice();
    }
    return 0 - 1;
}

fn mut_borrow_map_referent_kind(referent: []u8) -> i64 {
    let referent_len = std::mem::len(referent);
    let unwrapped = referent[4..referent_len];
    if std::mem::equal_bytes(unwrapped, "std::map::Map<[]u8, i64>") {
        return code_kind_mut_borrowed_map_i64();
    }
    if std::mem::equal_bytes(unwrapped, "std::map::Map<[]u8,i64>") {
        return code_kind_mut_borrowed_map_i64();
    }
    if std::mem::equal_bytes(unwrapped, "std::map::Map <[]u8, i64>") {
        return code_kind_mut_borrowed_map_i64();
    }
    return 0 - 1;
}

// mut_borrow_referent_kind resolves a '&var T' referent ('var T'): supported
// handle-backed resources keep their runtime handle ABI, while i64 and []u8
// locals use pointer write-back slots. Anything else stays -1 (unchanged).
fn mut_borrow_referent_kind(referent: []u8) -> i64 {
    let map_kind = mut_borrow_map_referent_kind(referent);
    if map_kind >= 0 {
        return map_kind;
    }
    let handle_kind = mut_borrow_handle_referent_kind(referent);
    if handle_kind >= 0 {
        return handle_kind;
    }
    let slice_kind = mut_borrow_slice_referent_kind(referent);
    if slice_kind >= 0 {
        return slice_kind;
    }
    return mut_borrow_scalar_referent_kind(referent);
}

// mut_borrow_handle_referent_kind resolves mutable borrows of runtime handles
// whose mutation is interior to the runtime object. A String handle is a
// '%kizu.owned' value pointing at '%kizu.rt.string'; append/clear update that
// pointee, so passing the handle by value preserves caller-visible mutation.
fn mut_borrow_handle_referent_kind(referent: []u8) -> i64 {
    let referent_len = std::mem::len(referent);
    let unwrapped = referent[4..referent_len];
    if std::mem::equal_bytes(unwrapped, "std::string::String") {
        return code_kind_owned_string();
    }
    return 0 - 1;
}

// mut_borrow_slice_referent_kind resolves a '&var []u8' referent ('var []u8') to
// the slice pointer write-back kind. Any other referent stays -1 (unchanged).
fn mut_borrow_slice_referent_kind(referent: []u8) -> i64 {
    let referent_len = std::mem::len(referent);
    let unwrapped = referent[4..referent_len];
    if std::mem::equal_bytes(unwrapped, "[]u8") {
        return code_kind_mut_borrow_slice();
    }
    return 0 - 1;
}

// mut_borrow_scalar_referent_kind resolves a scalar '&var T' referent ('var T')
// to its pointer write-back kind. Only 'i64' is a scalar slot here ('[]u8' is
// resolved earlier by mut_borrow_slice_referent_kind); bool and other scalars
// stay -1 (unsupported, unchanged behaviour).
fn mut_borrow_scalar_referent_kind(referent: []u8) -> i64 {
    let referent_len = std::mem::len(referent);
    let unwrapped = referent[4..referent_len];
    if std::mem::equal_bytes(unwrapped, "i64") {
        return code_kind_mut_borrow_i64();
    }
    return 0 - 1;
}

fn code_param_single_field_struct_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let kind = try code_decl_single_field_struct_kind(text, ast, child, type_node, code);
    let after = index + 1;
    if kind >= 0 {
        return kind;
    }
    return try code_param_single_field_struct_kind(text, ast, decls, type_node, code, after);
}

fn code_decl_single_field_struct_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        StructDecl(struct_decl) => try code_struct_decl_single_field_kind(text, ast, struct_decl.name, struct_decl.fields, type_node, code),
        _ => code_kind_missing(),
    };
}

fn code_struct_decl_single_field_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let type_text = ast_node_text(text, ast, type_node);
    if !std::mem::equal_bytes(decl_name, type_text) {
        return 0 - 1;
    }
    if fields.len != 1 {
        return 0 - 1;
    }
    let field_id = try ast.child_at(fields, 0);
    return try code_single_field_struct_param_kind(text, ast, field_id, code);
}

fn code_single_field_struct_param_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let node = ast.get(field_id);
    return match node.data {
        Field(field_node) => try append_code_struct_param_kind(text, ast, field_node.name, field_node.type_node, code),
        _ => code_kind_missing(),
    };
}

fn append_code_struct_param_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field_name: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let field_kind = try code_struct_param_field_kind(text, ast, type_node, code);
    if field_kind < 0 {
        return code_kind_missing();
    }
    let record_pos = code.len();
    let op_struct_param = code_op_struct_param();
    try code.append(op_struct_param);
    try code.append(1);
    let field_span = code_node_span(text, ast, field_name);
    try code.append(field_span.start);
    try code.append(field_span.end);
    try code.append(field_kind);
    let record_base = code_kind_struct_base();
    return record_base + record_pos;
}

fn code_struct_param_field_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    if type_node_is_i64(text, ast, type_node) {
        return code_kind_i64();
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return code_kind_bool();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_kind_slice();
    }
    let union_kind = try code_param_union_kind(text, ast, type_node, code);
    if union_kind >= 0 {
        return union_kind;
    }
    return 0 - 1;
}

fn code_return_enum_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let span = code_node_span(text, ast, type_node);
    let pos = try enum_decl_pos_by_span(text, code, span.start, span.end, 0);
    if pos < 0 {
        return 0 - 1;
    }
    let record_base = code_kind_struct_base();
    return record_base + pos;
}

fn code_return_struct_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let span = code_node_span(text, ast, type_node);
    let pos = try struct_decl_pos_by_span(text, code, span.start, span.end, 0);
    if pos < 0 {
        return 0 - 1;
    }
    let record_base = code_kind_struct_base();
    return record_base + pos;
}

// code_param_struct_kind resolves a struct-typed parameter to its STRUCT_DECL
// record kind (record_base + position). A read borrow '&MyStruct' resolves to the
// same kind as the by-value 'MyStruct' param: a read borrow flows on the value
// tape with identity value semantics (the borrow operand is the referent value
// itself), so field reads resolve from the same struct metadata. The leading '&'
// is skipped via borrow_param_name_start so the name span matches the struct
// declaration; a by-value param has no '&' and resolves unchanged. The struct is
// identified structurally by matching its STRUCT_DECL record, not by name.
fn code_param_struct_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let span = code_node_span(text, ast, type_node);
    let name_start = borrow_param_name_start(text, span.start);
    let pos = try struct_decl_pos_by_span(text, code, name_start, span.end, 0);
    if pos < 0 {
        return 0 - 1;
    }
    let record_base = code_kind_struct_base();
    return record_base + pos;
}

// code_param_union_kind resolves a union-typed parameter ('Shape' or the
// '&Shape' borrow, passed by value as the runtime aggregate) against the
// UNION_DECL records: the kind stores record_base + <record position>.
fn code_param_union_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let span = code_node_span(text, ast, type_node);
    let name_start = borrow_param_name_start(text, span.start);
    let pos = try union_decl_pos_by_span(text, code, name_start, span.end, 0);
    if pos < 0 {
        return 0 - 1;
    }
    let record_base = code_kind_struct_base();
    return record_base + pos;
}

// borrow_param_name_start skips a borrow's leading '&' so a borrowed parameter's
// type name span ('&Shape', '&MyStruct') matches the by-value declaration name.
// A by-value parameter has no '&' and the span start is returned unchanged.
fn borrow_param_name_start(text: []u8, start: i64) -> i64 {
    let amp = cast<u8>(38);
    if text[start] == amp {
        return start + 1;
    }
    return start;
}

fn lower_code_statements(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= statements.len {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(statements, index);
    let eval = try lower_code_statement(text, ast, decls, child, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, scope_base, loop_begin, loop_kind, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_statements(text, ast, decls, statements, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, scope_base, loop_begin, loop_kind, after, eval.next);
}

fn lower_code_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statement: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(statement);
    return match node.data {
        Let(let_node) => try lower_code_let(text, ast, decls, let_node.mutable, let_node.name, let_node.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, next_value),
        Assign(assign_node) => try lower_code_assign(text, ast, decls, assign_node.target, assign_node.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        ExprStmt(expr_stmt) => try lower_code_expr_statement(text, ast, decls, expr_stmt.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Return(return_node) => try lower_code_return_with_defers(text, ast, decls, return_node.value, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, next_value),
        Defer(defer_node) => try lower_code_defer(text, ast, decls, defer_node.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, next_value),
        ErrDefer(err_defer_node) => try lower_code_errdefer(text, ast, decls, err_defer_node.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        If(if_node) => try lower_code_if(text, ast, decls, if_node.condition, if_node.then_block, if_node.else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value),
        Match(match_node) => try lower_code_match(text, ast, decls, match_node.value, match_node.arms, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value),
        While(while_node) => try lower_code_while(text, ast, decls, while_node.label, while_node.condition, while_node.body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, next_value),
        For(for_node) => try lower_code_for(text, ast, decls, for_node.label, for_node.name, for_node.start, for_node.end, for_node.body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, next_value),
        Break(break_node) => try lower_code_break(text, ast, break_node.label, code, kinds, local_starts, local_ends, local_values, defer_records, locals_base, loop_begin, loop_kind, next_value),
        Continue(continue_node) => try lower_code_continue(text, ast, continue_node.label, code, kinds, local_starts, local_ends, local_values, defer_records, locals_base, loop_begin, loop_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_if lowers an 'if <cond> { <then> } else { <else> }' statement onto the
// tape: the condition expression lowers to an i1 value, then IF_BEGIN records that
// value, the then-block statements follow, IF_ELSE separates the else-block, and
// IF_END closes it. IF_ELSE/IF_END carry the IF_BEGIN tape index so the renderer's
// labels match. A missing else (Empty) renders an empty else block; an 'else if'
// chains through lower_code_else_block.
fn lower_code_if(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let condition_text = ast_node_text(text, ast, condition);
    if std::mem::equal_bytes(condition_text, "true") {
        return try lower_code_body(text, ast, decls, then_block, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
    }
    if std::mem::equal_bytes(condition_text, "false") {
        return try lower_code_else_block(text, ast, decls, else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
    }
    let cond_eval = try lower_code_expr(text, ast, decls, condition, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !cond_eval.ok {
        return code_eval_unsupported(cond_eval.next);
    }
    let if_begin_index = code.len();
    let op_if_begin = code_op_if_begin();
    try code.append(op_if_begin);
    try code.append(cond_eval.value_id);
    let then_eval = try lower_code_body(text, ast, decls, then_block, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, cond_eval.next);
    if !then_eval.ok {
        return code_eval_unsupported(then_eval.next);
    }
    let op_if_else = code_op_if_else();
    try code.append(op_if_else);
    try code.append(if_begin_index);
    let else_eval = try lower_code_else_block(text, ast, decls, else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, then_eval.next);
    if !else_eval.ok {
        return code_eval_unsupported(else_eval.next);
    }
    let op_if_end = code_op_if_end();
    try code.append(op_if_end);
    try code.append(if_begin_index);
    return code_eval_value(0, else_eval.next);
}

// lower_code_else_block lowers the else arm: an Empty node is a no-else if (the
// else block stays empty), a Block lowers its statements, and an If is an
// 'else if' chained through lower_code_if (its own IF records nest on the tape).
fn lower_code_else_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(else_block);
    return match node.data {
        Empty => code_eval_value(0, next_value),
        Block(block) => try lower_code_nested_statements(text, ast, decls, block.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value),
        If(if_node) => try lower_code_if(text, ast, decls, if_node.condition, if_node.then_block, if_node.else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_match lowers a statement-position 'match <enum/union> { ... }' as
// a nested if/else chain of tag comparisons over the structured IF records; a
// '_' arm lowers as the unconditional tail. Enum call results carry an ENUM_DECL
// kind so bare arm patterns can resolve against the enum declaration while the
// value itself remains an i64 tag.
fn lower_code_match(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let value_eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let value_kind = try kinds.get(value_eval.value_id);
    let record_base = code_kind_struct_base();
    if value_kind < record_base {
        return code_eval_unsupported(value_eval.next);
    }
    let record_pos = value_kind - record_base;
    let record_op = try code.get(record_pos);
    let op_enum_const = code_op_enum_const();
    let op_enum_decl = code_op_enum_decl();
    let op_union_const = code_op_union_const();
    let op_union_decl = code_op_union_decl();
    let is_enum = record_op == op_enum_const;
    let is_enum_runtime = record_op == op_enum_decl;
    let is_union = record_op == op_union_const;
    let is_runtime = record_op == op_union_decl;
    let supported = is_enum or is_enum_runtime or is_union or is_runtime;
    if !supported {
        return code_eval_unsupported(value_eval.next);
    }
    if arms.len == 0 {
        return code_eval_unsupported(value_eval.next);
    }
    if is_runtime {
        return try lower_code_runtime_match(text, ast, decls, value_eval.value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, value_eval.next);
    }
    let no_payload_src = 0 - 1;
    return try lower_code_match_arms(text, ast, decls, value_eval.value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, no_payload_src, 0, value_eval.next);
}

// lower_code_runtime_match lowers a match over a runtime union value (a
// UNION_DECL-backed kind): the UNION_TAG read materializes the value's tag
// once and the arm chain compares it against the declaration-order variant
// indices, binding payloads through UNION_PAYLOAD inside the matching arm.
fn lower_code_runtime_match(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let op_union_tag = code_op_union_tag();
    try code.append(op_union_tag);
    try code.append(next_value);
    try code.append(value_id);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let tag_value = next_value;
    let after_tag = next_value + 1;
    return try lower_code_match_arms(text, ast, decls, tag_value, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, value_id, 0, after_tag);
}

// lower_code_match_arms dispatches the arm at index into the nested if chain
// (past the last arm the chain is complete and nothing more lowers).
fn lower_code_match_arms(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    payload_src: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= arms.len {
        return code_eval_value(0, next_value);
    }
    let arm = try ast.child_at(arms, index);
    return try lower_code_match_arm_node(text, ast, decls, value_id, record_pos, arms, arm, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, payload_src, index, next_value);
}

fn lower_code_match_arm_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    arm: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    payload_src: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(arm);
    return match node.data {
        MatchArm(match_arm) => try lower_code_match_arm(text, ast, decls, value_id, record_pos, arms, match_arm.pattern, match_arm.binding, match_arm.body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, payload_src, index, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_match_arm lowers one arm: a '_' pattern lowers its body
// unconditionally (the chain tail), any other pattern compares the matched
// value against its variant tag and the remaining arms nest in the else branch.
fn lower_code_match_arm(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    pattern: std::kizu::ast::NodeId,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    payload_src: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let pattern_text = ast_node_text(text, ast, pattern);
    let tail_index = index + 1;
    let is_tail = tail_index == arms.len;
    if std::mem::equal_bytes(pattern_text, "_") {
        return try lower_code_match_wildcard(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, is_tail, next_value);
    }
    let pattern_span = code_node_span(text, ast, pattern);
    let tag = try match_pattern_tag(text, ast, decls, code, record_pos, pattern_span.start, pattern_span.end);
    if tag < 0 {
        return code_eval_unsupported(next_value);
    }
    let op_const = code_op_const_int();
    try code.append(op_const);
    try code.append(next_value);
    try code.append(tag);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let tag_value = next_value;
    let cond_value = next_value + 1;
    let op_binary = code_op_binary();
    let eq_kind = code_binary_kind(std::kizu::ast::binary_eq());
    try code.append(op_binary);
    try code.append(cond_value);
    try code.append(eq_kind);
    try code.append(value_id);
    try code.append(tag_value);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let after_cond = cond_value + 1;
    let if_begin_index = code.len();
    let op_if_begin = code_op_if_begin();
    try code.append(op_if_begin);
    try code.append(cond_value);
    let arm_payload_kind = try match_arm_payload_kind(code, record_pos, tag);
    let body_eval = try lower_code_match_arm_body(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, record_pos, payload_src, arm_payload_kind, after_cond);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let op_if_else = code_op_if_else();
    try code.append(op_if_else);
    try code.append(if_begin_index);
    let after = index + 1;
    let rest_eval = try lower_code_match_arms(text, ast, decls, value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, payload_src, after, body_eval.next);
    if !rest_eval.ok {
        return code_eval_unsupported(rest_eval.next);
    }
    let op_if_end = code_op_if_end();
    try code.append(op_if_end);
    try code.append(if_begin_index);
    return code_eval_value(0, rest_eval.next);
}

// match_pattern_tag resolves an arm pattern against the matched record's
// declaration: ENUM_DECL and UNION_DECL records keep their variant entries
// inline, and compile-time ENUM_CONST/UNION_CONST records keep the declaration
// name span at +4/+5.
fn match_pattern_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    p_start: i64,
    p_end: i64
) -> !i64 {
    // Dispatch on the record opcode before touching the +4/+5 slots: a
    // UNION_DECL keeps its own variant entries there, so only the compile-time
    // record paths read them as the declaration name span.
    let record_op = try code.get(record_pos);
    let op_union_decl = code_op_union_decl();
    if record_op == op_union_decl {
        return try union_decl_pattern_tag(text, code, record_pos, p_start, p_end);
    }
    let op_enum_decl = code_op_enum_decl();
    if record_op == op_enum_decl {
        return try enum_decl_pattern_tag(text, code, record_pos, p_start, p_end);
    }
    let name_start_pos = record_pos + 4;
    let name_start = try code.get(name_start_pos);
    let name_end_pos = record_pos + 5;
    let name_end = try code.get(name_end_pos);
    let op_union_const = code_op_union_const();
    if record_op == op_union_const {
        return try union_variant_tag_lookup(text, ast, decls, name_start, name_end, p_start, p_end, 0);
    }
    return try enum_variant_tag_lookup(text, ast, decls, name_start, name_end, p_start, p_end, 0);
}

fn enum_decl_pattern_tag(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    p_start: i64,
    p_end: i64
) -> !i64 {
    let count_pos = record_pos + 3;
    let variant_count = try code.get(count_pos);
    return try enum_decl_variant_index(text, code, record_pos, variant_count, p_start, p_end, 0);
}

// enum_decl_variant_index returns the declaration-order index of the named
// variant in an ENUM_DECL record (-1 when the record does not carry it).
fn enum_decl_variant_index(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    variant_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= variant_count {
        return 0 - 1;
    }
    let entry_slots = index * 2;
    let entry_pos = record_pos + 4 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let entry_name = text[entry_name_start..entry_name_end];
    let wanted = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, wanted) {
        return try enum_decl_variant_index(text, code, record_pos, variant_count, name_start, name_end, after);
    }
    return index;
}

// union_decl_pattern_tag resolves an arm pattern against a UNION_DECL record's
// own variant entries (a runtime match needs no AST declaration walk).
fn union_decl_pattern_tag(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    p_start: i64,
    p_end: i64
) -> !i64 {
    let count_pos = record_pos + 3;
    let variant_count = try code.get(count_pos);
    return try union_decl_variant_index(text, code, record_pos, variant_count, p_start, p_end, 0);
}

// match_arm_payload_kind reads the matched variant's payload kind from a
// UNION_DECL record (0 for the compile-time record paths, whose payload flows
// through the UNION_CONST record instead).
fn match_arm_payload_kind(
    code: &var std::array::Array<i64>,
    record_pos: i64,
    tag: i64
) -> !i64 {
    let record_op = try code.get(record_pos);
    let op_union_decl = code_op_union_decl();
    if record_op != op_union_decl {
        return 0;
    }
    let entry_slots = tag * 3;
    let entry_pos = record_pos + 4 + entry_slots;
    let kind_pos = entry_pos + 2;
    let payload_kind = try code.get(kind_pos);
    return payload_kind;
}

// lower_code_match_arm_body lowers one matching arm's body with the union
// payload bound under the arm's binding name when the matched record carries
// one (the binding row blanks after the body so it stays arm-scoped); every
// other shape lowers the body directly.
fn lower_code_match_arm_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    record_pos: i64,
    payload_src: i64,
    arm_payload_kind: i64,
    next_value: i64
) -> !CodeEval {
    let record_op = try code.get(record_pos);
    let op_union_decl = code_op_union_decl();
    if record_op == op_union_decl {
        return try lower_code_runtime_payload_body(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, payload_src, arm_payload_kind, next_value);
    }
    let op_union_const = code_op_union_const();
    if record_op != op_union_const {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
    }
    let payload_pos = record_pos + 7;
    let payload_value = try code.get(payload_pos);
    if payload_value < 0 {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
    }
    let binding_empty = match_binding_is_empty(ast, binding);
    if binding_empty {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
    }
    let binding_span = code_node_span(text, ast, binding);
    let row = local_starts.len();
    try local_starts.append(binding_span.start);
    try local_ends.append(binding_span.end);
    try local_values.append(payload_value);
    let body_eval = try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
    try local_starts.set(row, 0);
    try local_ends.set(row, 0);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    return code_eval_value(0, body_eval.next);
}

// lower_code_runtime_payload_body lowers a runtime-union arm body: a variant
// carrying a payload extracts it through UNION_PAYLOAD inside the arm's then
// branch and binds it under the arm's binding name (the row blanks after the
// body so it stays arm-scoped); a payload-less variant or an unbound payload
// lowers the body directly.
fn lower_code_runtime_payload_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    payload_src: i64,
    arm_payload_kind: i64,
    next_value: i64
) -> !CodeEval {
    if arm_payload_kind == 0 {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
    }
    // A negative payload kind marks a payload type the layout pass could not
    // classify; extracting it would mis-type the binding, so the arm stays
    // unsupported.
    if arm_payload_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    let binding_empty = match_binding_is_empty(ast, binding);
    if binding_empty {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
    }
    let op_union_payload = code_op_union_payload();
    try code.append(op_union_payload);
    try code.append(next_value);
    try code.append(payload_src);
    try code.append(arm_payload_kind);
    try kinds.append(arm_payload_kind);
    let binding_span = code_node_span(text, ast, binding);
    let row = local_starts.len();
    try local_starts.append(binding_span.start);
    try local_ends.append(binding_span.end);
    try local_values.append(next_value);
    let after_payload = next_value + 1;
    let body_eval = try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, after_payload);
    try local_starts.set(row, 0);
    try local_ends.set(row, 0);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    return code_eval_value(0, body_eval.next);
}

// match_binding_is_empty reports whether the arm carries no payload binding.
fn match_binding_is_empty(
    ast: std::kizu::ast::Ast,
    binding: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(binding);
    return match node.data {
        Empty => true,
        _ => false,
    };
}

// lower_code_match_wildcard lowers a '_' arm body unconditionally. The checker
// rejects a non-final wildcard ('wildcard match arm must be last'); the is_tail
// guard keeps a hypothetical unchecked tape from silently dropping the arms
// behind one.
fn lower_code_match_wildcard(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    is_tail: bool,
    next_value: i64
) -> !CodeEval {
    if !is_tail {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value);
}

// lower_code_match_body lowers one arm body: a bare call or try-call lowers as
// the matching statement form, a block opens its own binding scope.
fn lower_code_match_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(body);
    return match node.data {
        ExprStmt(expr_stmt) => try lower_code_expr_statement(text, ast, decls, expr_stmt.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Call(call_node) => try lower_code_statement_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        TryExpr(try_expr) => try lower_code_try_statement(text, ast, decls, try_expr.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        // A bare 'match' arm body lowers as a nested match (the same dispatch a
        // statement-position match takes), so an outer union arm can fan out into
        // a match over its bound payload (e.g. a union-typed error payload).
        Match(match_node) => try lower_code_match(text, ast, decls, match_node.value, match_node.arms, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value),
        Block(block) => try lower_code_nested_statements(text, ast, decls, block.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, loop_begin, loop_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_if_expr lowers a value-position 'if <cond> { <value> } else
// { <value> }': every branch's trailing expression stores into one result slot
// (the then branch declares it and picks the slot kind; the else branch must
// match) and the merged load past IF_END yields the expression value. The
// reference grammar requires a block else for the expression form, and the
// checker guarantees both branches yield agreeing values.
fn lower_code_if_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    // The result slot reserves a blank locals row like the match expression's.
    let slot = local_starts.len();
    try local_starts.append(0);
    try local_ends.append(0);
    try local_values.append(0);
    let unknown_kind = 0 - 1;
    let chain_eval = try lower_code_if_expr_chain(text, ast, decls, condition, then_block, else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, unknown_kind, next_value);
    if !chain_eval.ok {
        return code_eval_unsupported(chain_eval.next);
    }
    let slot_kind = chain_eval.value_id;
    let load_op = value_slot_load_op(slot_kind);
    try code.append(load_op);
    try code.append(chain_eval.next);
    try code.append(slot);
    try kinds.append(slot_kind);
    let after_value = chain_eval.next + 1;
    return code_eval_value(chain_eval.next, after_value);
}

// lower_code_if_expr_chain lowers one if link of a value-position if into the
// shared result slot and returns the slot kind through the eval's value_id
// (the declaring branch picks it when slot_kind arrives as -1).
fn lower_code_if_expr_chain(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    let cond_eval = try lower_code_expr(text, ast, decls, condition, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !cond_eval.ok {
        return code_eval_unsupported(cond_eval.next);
    }
    let if_begin_index = code.len();
    let op_if_begin = code_op_if_begin();
    try code.append(op_if_begin);
    try code.append(cond_eval.value_id);
    let then_eval = try lower_code_branch_value(text, ast, decls, then_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, cond_eval.next);
    if !then_eval.ok {
        return code_eval_unsupported(then_eval.next);
    }
    let chosen_kind = then_eval.value_id;
    let op_if_else = code_op_if_else();
    try code.append(op_if_else);
    try code.append(if_begin_index);
    let else_eval = try lower_code_else_value(text, ast, decls, else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, chosen_kind, then_eval.next);
    if !else_eval.ok {
        return code_eval_unsupported(else_eval.next);
    }
    let op_if_end = code_op_if_end();
    try code.append(op_if_end);
    try code.append(if_begin_index);
    return code_eval_value(chosen_kind, else_eval.next);
}

// lower_code_else_value routes a value-position else arm: a block stores its
// trailing value, an 'else if' chains into the shared slot, and a missing else
// (checker-illegal for an if expression) stays unsupported.
fn lower_code_else_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(else_block);
    return match node.data {
        Block(block) => try lower_code_block_value(text, ast, decls, block.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, next_value),
        If(if_node) => try lower_code_if_expr_chain(text, ast, decls, if_node.condition, if_node.then_block, if_node.else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_branch_value dispatches a value branch (a Block whose trailing
// ExprStmt is the branch value).
fn lower_code_branch_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(block);
    return match node.data {
        Block(b) => try lower_code_block_value(text, ast, decls, b.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_block_value lowers a value branch body: the leading statements
// lower in their own scope, the trailing expression lowers to the branch value
// (strings materialize through STR_SLICE), and the value stores into the
// result slot through lower_code_value_store.
fn lower_code_block_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    if statements.len == 0 {
        return code_eval_unsupported(next_value);
    }
    let mark = local_starts.len();
    let lead_len = statements.len - 1;
    let lead_eval = try lower_code_value_leads(text, ast, decls, statements, lead_len, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, mark, 0, next_value);
    if !lead_eval.ok {
        return code_eval_unsupported(lead_eval.next);
    }
    let trailing = try ast.child_at(statements, lead_len);
    let value_eval = try lower_code_trailing_value(text, ast, decls, trailing, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, lead_eval.next);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let stored_eval = try lower_code_arg_slice(text, code, kinds, value_eval.value_id, value_eval.next);
    let stored_kind = try kinds.get(stored_eval.value_id);
    try scrub_code_locals(local_starts, local_ends, mark);
    return try lower_code_value_store(code, slot, slot_kind, stored_kind, stored_eval.value_id, stored_eval.next);
}

// lower_code_value_leads lowers the branch statements before the trailing
// value expression (break/continue carry no enclosing loop context here, so
// they stay unsupported inside a value branch).
fn lower_code_value_leads(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    bound: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= bound {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(statements, index);
    let eval = try lower_code_value_lead_statement(text, ast, decls, child, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_value_leads(text, ast, decls, statements, bound, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, after, eval.next);
}

fn lower_code_value_lead_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statement: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(statement);
    return match node.data {
        Let(let_node) => try lower_code_let(text, ast, decls, let_node.mutable, let_node.name, let_node.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, next_value),
        Assign(assign_node) => try lower_code_assign(text, ast, decls, assign_node.target, assign_node.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        ExprStmt(expr_stmt) => try lower_code_expr_statement(text, ast, decls, expr_stmt.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_trailing_value lowers a trailing value expression: the real
// parser wraps it as an ExprStmt (unwrapped here), the hosted CLI boundary
// hands the bare expression node directly, and any non-expression node falls
// to the expression dispatch's own unsupported result.
fn lower_code_trailing_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    trailing: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(trailing);
    return match node.data {
        ExprStmt(expr_stmt) => try lower_code_expr(text, ast, decls, expr_stmt.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => try lower_code_expr(text, ast, decls, trailing, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
    };
}

// lower_code_value_store writes a branch value into the result slot: the
// declaring branch (slot_kind -1) emits the slot's decl and returns the chosen
// kind through the eval's value_id, every other branch kind-checks and stores.
fn lower_code_value_store(
    code: &var std::array::Array<i64>,
    slot: i64,
    slot_kind: i64,
    stored_kind: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let unknown_kind = 0 - 1;
    if slot_kind == unknown_kind {
        return try lower_code_value_decl(code, slot, stored_kind, value_id, next_value);
    }
    if stored_kind != slot_kind {
        return code_eval_unsupported(next_value);
    }
    let store_op = value_slot_store_op(slot_kind);
    try code.append(store_op);
    try code.append(slot);
    try code.append(value_id);
    return code_eval_value(slot_kind, next_value);
}

// lower_code_value_decl emits the declaring branch's slot decl and returns the
// chosen kind through the eval's value_id.
fn lower_code_value_decl(
    code: &var std::array::Array<i64>,
    slot: i64,
    stored_kind: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let decl_op = value_slot_decl_op(stored_kind);
    if decl_op < 0 {
        return code_eval_unsupported(next_value);
    }
    try code.append(decl_op);
    try code.append(slot);
    try code.append(value_id);
    return code_eval_value(stored_kind, next_value);
}

// value_slot_decl_op / value_slot_store_op / value_slot_load_op pick the slot
// trio for a value-position if/match result kind (-1 = not slot-backed).
fn value_slot_decl_op(stored_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if stored_kind == kind_i64 {
        return code_op_var_decl();
    }
    let kind_bool = code_kind_bool();
    if stored_kind == kind_bool {
        return code_op_var_decl_bool();
    }
    let kind_slice = code_kind_slice();
    if stored_kind == kind_slice {
        return code_op_var_decl_slice();
    }
    return 0 - 1;
}

fn value_slot_store_op(slot_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if slot_kind == kind_i64 {
        return code_op_var_store();
    }
    let kind_bool = code_kind_bool();
    if slot_kind == kind_bool {
        return code_op_var_store_bool();
    }
    return code_op_var_store_slice();
}

fn value_slot_load_op(slot_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if slot_kind == kind_i64 {
        return code_op_var_load();
    }
    let kind_bool = code_kind_bool();
    if slot_kind == kind_bool {
        return code_op_var_load_bool();
    }
    return code_op_var_load_slice();
}

// lower_code_match_expr lowers a value-position 'match <enum/union> { ... }':
// the arms reuse the statement match's tag chain, every arm's value expression
// stores into one result slot (the first arm declares it), and the merged load
// past the chain yields the expression value. The lowering leans on the
// checker's exhaustiveness guarantee: if no arm matched at runtime the result
// slot would read uninitialized, so an unchecked tape must not reach this.
fn lower_code_match_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let value_eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let value_kind = try kinds.get(value_eval.value_id);
    let record_base = code_kind_struct_base();
    if value_kind < record_base {
        return code_eval_unsupported(value_eval.next);
    }
    let record_pos = value_kind - record_base;
    let record_op = try code.get(record_pos);
    let op_enum_const = code_op_enum_const();
    let op_enum_decl = code_op_enum_decl();
    let op_union_const = code_op_union_const();
    let is_supported = record_op == op_enum_const or
        record_op == op_enum_decl or
        record_op == op_union_const;
    if !is_supported {
        return code_eval_unsupported(value_eval.next);
    }
    if arms.len == 0 {
        return code_eval_unsupported(value_eval.next);
    }
    let slot = local_starts.len();
    try local_starts.append(0);
    try local_ends.append(0);
    try local_values.append(0);
    let unknown_kind = 0 - 1;
    let arms_eval = try lower_code_match_expr_arms(text, ast, decls, value_eval.value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, unknown_kind, 0, value_eval.next);
    if !arms_eval.ok {
        return code_eval_unsupported(arms_eval.next);
    }
    let slot_kind = arms_eval.value_id;
    let load_op = value_slot_load_op(slot_kind);
    try code.append(load_op);
    try code.append(arms_eval.next);
    try code.append(slot);
    try kinds.append(slot_kind);
    let after_value = arms_eval.next + 1;
    return code_eval_value(arms_eval.next, after_value);
}

// lower_code_match_expr_arms dispatches the value arm at index into the nested
// if chain (the chain kind flows through the eval's value_id).
fn lower_code_match_expr_arms(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= arms.len {
        return code_eval_value(slot_kind, next_value);
    }
    let arm = try ast.child_at(arms, index);
    return try lower_code_match_expr_arm_node(text, ast, decls, value_id, record_pos, arms, arm, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, index, next_value);
}

fn lower_code_match_expr_arm_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    arm: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(arm);
    return match node.data {
        MatchArm(match_arm) => try lower_code_match_expr_arm(text, ast, decls, value_id, record_pos, arms, match_arm.pattern, match_arm.binding, match_arm.body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, index, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_match_expr_arm lowers one value arm: a '_' tail stores its value
// unconditionally, any other pattern compares the tag and the remaining arms
// nest in the else branch (sharing the slot kind the first arm chose).
fn lower_code_match_expr_arm(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    pattern: std::kizu::ast::NodeId,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let pattern_text = ast_node_text(text, ast, pattern);
    let tail_index = index + 1;
    let is_tail = tail_index == arms.len;
    if std::mem::equal_bytes(pattern_text, "_") {
        return try lower_code_match_expr_wildcard(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, record_pos, slot, slot_kind, is_tail, next_value);
    }
    let pattern_span = code_node_span(text, ast, pattern);
    let tag = try match_pattern_tag(text, ast, decls, code, record_pos, pattern_span.start, pattern_span.end);
    if tag < 0 {
        return code_eval_unsupported(next_value);
    }
    let op_const = code_op_const_int();
    try code.append(op_const);
    try code.append(next_value);
    try code.append(tag);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let tag_value = next_value;
    let cond_value = next_value + 1;
    let op_binary = code_op_binary();
    let eq_kind = code_binary_kind(std::kizu::ast::binary_eq());
    try code.append(op_binary);
    try code.append(cond_value);
    try code.append(eq_kind);
    try code.append(value_id);
    try code.append(tag_value);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let after_cond = cond_value + 1;
    let if_begin_index = code.len();
    let op_if_begin = code_op_if_begin();
    try code.append(op_if_begin);
    try code.append(cond_value);
    let body_eval = try lower_code_match_expr_arm_value(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, record_pos, slot, slot_kind, after_cond);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let chosen_kind = body_eval.value_id;
    let op_if_else = code_op_if_else();
    try code.append(op_if_else);
    try code.append(if_begin_index);
    let after = index + 1;
    let rest_eval = try lower_code_match_expr_arms(text, ast, decls, value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, chosen_kind, after, body_eval.next);
    if !rest_eval.ok {
        return code_eval_unsupported(rest_eval.next);
    }
    let op_if_end = code_op_if_end();
    try code.append(op_if_end);
    try code.append(if_begin_index);
    return code_eval_value(chosen_kind, rest_eval.next);
}

// lower_code_match_expr_wildcard stores the '_' arm's value unconditionally
// (the guard mirrors the statement match: a non-final wildcard is rejected).
fn lower_code_match_expr_wildcard(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    record_pos: i64,
    slot: i64,
    slot_kind: i64,
    is_tail: bool,
    next_value: i64
) -> !CodeEval {
    if !is_tail {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_match_expr_arm_value(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, record_pos, slot, slot_kind, next_value);
}

// lower_code_match_expr_arm_value lowers one value arm's body expression (with
// the union payload bound under the arm's binding name when the matched record
// carries one) and stores it into the result slot.
fn lower_code_match_expr_arm_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    record_pos: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    let row = try match_expr_bind_payload(text, ast, binding, code, local_starts, local_ends, local_values, record_pos);
    let value_eval = try lower_code_trailing_value(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    try match_expr_unbind_payload(local_starts, local_ends, row);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let stored_eval = try lower_code_arg_slice(text, code, kinds, value_eval.value_id, value_eval.next);
    let stored_kind = try kinds.get(stored_eval.value_id);
    return try lower_code_value_store(code, slot, slot_kind, stored_kind, stored_eval.value_id, stored_eval.next);
}

// match_expr_bind_payload binds the union payload under the arm's binding name
// (returning the binding row, or -1 when nothing binds).
fn match_expr_bind_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    binding: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    record_pos: i64
) -> !i64 {
    let record_op = try code.get(record_pos);
    let op_union_const = code_op_union_const();
    if record_op != op_union_const {
        return 0 - 1;
    }
    let payload_pos = record_pos + 7;
    let payload_value = try code.get(payload_pos);
    if payload_value < 0 {
        return 0 - 1;
    }
    let binding_empty = match_binding_is_empty(ast, binding);
    if binding_empty {
        return 0 - 1;
    }
    let binding_span = code_node_span(text, ast, binding);
    let row = local_starts.len();
    try local_starts.append(binding_span.start);
    try local_ends.append(binding_span.end);
    try local_values.append(payload_value);
    return row;
}

// match_expr_unbind_payload blanks the payload binding row after the arm body.
fn match_expr_unbind_payload(
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    row: i64
) -> !void {
    if row < 0 {
        return;
    }
    try local_starts.set(row, 0);
    try local_ends.set(row, 0);
    return;
}

// lower_code_nested_statements opens a fresh binding scope for a statement list
// that arrives without its own Block node walk (the else arm's block).
fn lower_code_nested_statements(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let scope_base = local_starts.len();
    return try lower_code_scoped_statements(text, ast, decls, statements, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, scope_base, loop_begin, loop_kind, next_value);
}

// lower_code_let binds a let local: the value expression lowers to a tape
// value id and the name span joins the function's locals. A name already bound
// in this function is not owned by the tape (the unified unsupported result).
fn lower_code_let(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    mutable: bool,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    next_value: i64
) -> !CodeEval {
    // Re-binding a name already bound in this same scope is the checker-illegal
    // duplicate (shadowing an outer scope's binding is fine: the new binding
    // simply appends and the backward lookup resolves it first).
    let name_span = code_node_span(text, ast, name);
    let existing = try code_scope_lookup(text, local_starts, local_ends, local_values, scope_base, name_span.start, name_span.end);
    if existing >= 0 {
        return code_eval_unsupported(next_value);
    }
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    if mutable {
        return try lower_code_var_binding(text, name_span.start, name_span.end, eval.value_id, code, kinds, local_starts, local_ends, local_values, args_scratch, eval.next);
    }
    try local_starts.append(name_span.start);
    try local_ends.append(name_span.end);
    try local_values.append(eval.value_id);
    return code_eval_value(eval.value_id, eval.next);
}

// lower_code_var_binding routes a 'var' init by its kind: an i64 init takes an
// i64 slot, an owned runtime handle/resource is bound directly for method
// mutation, a struct-literal init scalarizes into per-field slots, and any other kind
// (bool/str/slice) is not owned by the tape yet.
fn lower_code_var_binding(
    text: []u8,
    name_start: i64,
    name_end: i64,
    init_value_id: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let kind_i64 = code_kind_i64();
    let init_kind = try kinds.get(init_value_id);
    if init_kind == kind_i64 {
        return try bind_code_var(text, name_start, name_end, init_value_id, code, local_starts, local_ends, local_values, next_value);
    }
    let kind_slice = code_kind_slice();
    let kind_str = code_kind_str();
    if init_kind == kind_slice or init_kind == kind_str {
        return try bind_code_slice_var(text, name_start, name_end, init_value_id, code, kinds, local_starts, local_ends, local_values, next_value);
    }
    let kind_owned = code_kind_owned();
    if init_kind == kind_owned or code_kind_is_owned_resource(init_kind) {
        return try bind_code_owned_var(name_start, name_end, init_value_id, local_starts, local_ends, local_values, next_value);
    }
    let record_base = code_kind_struct_base();
    if init_kind < record_base {
        return code_eval_unsupported(next_value);
    }
    let record_pos = init_kind - record_base;
    let record_op = try code.get(record_pos);
    let op_struct_lit = code_op_struct_lit();
    if record_op != op_struct_lit {
        return code_eval_unsupported(next_value);
    }
    let struct_eval = try emit_var_struct_from_lit(text, record_pos, code, kinds, local_starts, local_ends, local_values, args_scratch, next_value);
    if !struct_eval.ok {
        return code_eval_unsupported(struct_eval.next);
    }
    try local_starts.append(name_start);
    try local_ends.append(name_end);
    try local_values.append(struct_eval.value_id);
    return struct_eval;
}

fn bind_code_owned_var(
    name_start: i64,
    name_end: i64,
    init_value_id: i64,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    try local_starts.append(name_start);
    try local_ends.append(name_end);
    try local_values.append(init_value_id);
    return code_eval_value(init_value_id, next_value);
}

// emit_var_struct_from_lit scalarizes a struct literal into mutable slots:
// scalar fields take their matching slot trio, nested struct literals recursively
// become child VAR_STRUCT values, and the parent record stores explicit
// slot/value metadata for each field.
fn emit_var_struct_from_lit(
    text: []u8,
    record_pos: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let count_pos = record_pos + 4;
    let field_count = try code.get(count_pos);
    let scratch_base = try args_scratch.get(0);
    let field_meta_slots = field_count * 2;
    let scratch_bound = scratch_base + field_meta_slots;
    try args_scratch.set(0, scratch_bound);
    let decls_eval = try emit_var_struct_decls(text, code, kinds, local_starts, local_ends, local_values, args_scratch, record_pos, field_count, scratch_base, 0, next_value);
    if !decls_eval.ok {
        return try code_eval_unsupported_after_scratch_reset(args_scratch, scratch_base, decls_eval.next);
    }
    let type_start = try code.get(record_pos + 2);
    let type_end = try code.get(record_pos + 3);
    let var_struct_pos = code.len();
    let op_var_struct = code_op_var_struct();
    try code.append(op_var_struct);
    try code.append(decls_eval.next);
    try code.append(type_start);
    try code.append(type_end);
    try code.append(field_count);
    try append_var_struct_fields(code, record_pos, field_count, args_scratch, scratch_base, 0);
    try args_scratch.set(0, scratch_base);
    let record_base = code_kind_struct_base();
    let record_kind = record_base + var_struct_pos;
    try kinds.append(record_kind);
    let after_value = decls_eval.next + 1;
    return code_eval_value(decls_eval.next, after_value);
}

// emit_var_struct_decls walks the STRUCT_LIT record's fields and emits one slot
// decl per scalar field (reserving its blank locals row); nested struct literal
// fields recursively emit their own VAR_STRUCT value.
fn emit_var_struct_decls(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= field_count {
        return code_eval_value(0, next_value);
    }
    let entry_slots = index * 3;
    let value_pos = record_pos + 7 + entry_slots;
    let field_value = try code.get(value_pos);
    let meta_slots = index * 2;
    let out_pos = scratch_base + meta_slots;
    let kind_pos = out_pos + 1;
    let eval = try emit_one_var_struct_decl(text, code, kinds, local_starts, local_ends, local_values, args_scratch, field_value, out_pos, kind_pos, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try emit_var_struct_decls(text, code, kinds, local_starts, local_ends, local_values, args_scratch, record_pos, field_count, scratch_base, after, eval.next);
}

// emit_one_var_struct_decl gives one scalarized field its slot: the slot id is
// the blank locals row this decl reserves (the row's empty span never matches a
// name lookup).
fn emit_one_var_struct_decl(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    field_value: i64,
    out_pos: i64,
    kind_pos: i64,
    next_value: i64
) -> !CodeEval {
    let field_kind = try kinds.get(field_value);
    let record_base = code_kind_struct_base();
    if field_kind >= record_base {
        return try emit_one_var_struct_record_decl(text, code, kinds, local_starts, local_ends, local_values, args_scratch, field_value, field_kind, out_pos, kind_pos, next_value);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, field_value, next_value);
    let stored_kind = try kinds.get(slice_eval.value_id);
    let slot = local_starts.len();
    let kind_i64 = code_kind_i64();
    let slice_kind = code_kind_slice();
    let kind_bool = code_kind_bool();
    let scalar_ok = stored_kind == kind_i64 or stored_kind == slice_kind or stored_kind == kind_bool;
    if !scalar_ok {
        return code_eval_unsupported(slice_eval.next);
    }
    let decl_op = var_struct_decl_op(stored_kind);
    try code.append(decl_op);
    try code.append(slot);
    try code.append(slice_eval.value_id);
    try local_starts.append(0);
    try local_ends.append(0);
    try local_values.append(0);
    try scratch_put(args_scratch, out_pos, slot);
    try scratch_put(args_scratch, kind_pos, stored_kind);
    return code_eval_value(0, slice_eval.next);
}

fn emit_one_var_struct_record_decl(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    field_value: i64,
    field_kind: i64,
    out_pos: i64,
    kind_pos: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    let record_pos = field_kind - record_base;
    let op = try code.get(record_pos);
    let op_struct_lit = code_op_struct_lit();
    if op != op_struct_lit {
        return code_eval_unsupported(next_value);
    }
    let struct_eval = try emit_var_struct_from_lit(text, record_pos, code, kinds, local_starts, local_ends, local_values, args_scratch, next_value);
    if !struct_eval.ok {
        return code_eval_unsupported(struct_eval.next);
    }
    let nested_kind = try kinds.get(struct_eval.value_id);
    try scratch_put(args_scratch, out_pos, struct_eval.value_id);
    try scratch_put(args_scratch, kind_pos, nested_kind);
    return code_eval_value(0, struct_eval.next);
}

// var_struct_decl_op picks the slot trio for a scalarized field's stored kind.
fn var_struct_decl_op(stored_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if stored_kind == kind_i64 {
        return code_op_var_decl();
    }
    let kind_bool = code_kind_bool();
    if stored_kind == kind_bool {
        return code_op_var_decl_bool();
    }
    return code_op_var_decl_slice();
}

// append_var_struct_fields copies each field's name span plus the explicit
// slot/value and kind metadata produced by emit_var_struct_decls.
fn append_var_struct_fields(
    code: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    args_scratch: &var std::array::Array<i64>,
    scratch_base: i64,
    index: i64
) -> !void {
    if index >= field_count {
        return;
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 5 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let meta_slots = index * 2;
    let out_pos = scratch_base + meta_slots;
    let kind_pos = out_pos + 1;
    let slot_or_value = try args_scratch.get(out_pos);
    let slot_kind = try args_scratch.get(kind_pos);
    try code.append(entry_name_start);
    try code.append(entry_name_end);
    try code.append(slot_or_value);
    try code.append(slot_kind);
    let after = index + 1;
    try append_var_struct_fields(code, record_pos, field_count, args_scratch, scratch_base, after);
    return;
}

// bind_code_var binds a 'var' local to a fresh alloca slot and emits the VAR_DECL
// record that stores its init value. The slot id is the local's index in the
// parallel arrays (globally unique within the lowering run), stored offset by
// code_var_slot_base so a locals lookup distinguishes the var from a let value.
fn bind_code_var(
    text: []u8,
    name_start: i64,
    name_end: i64,
    init_value_id: i64,
    code: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let slot = local_starts.len();
    let op_var_decl = code_op_var_decl();
    try code.append(op_var_decl);
    try code.append(slot);
    try code.append(init_value_id);
    let stored = code_var_slot_base() + slot;
    try local_starts.append(name_start);
    try local_ends.append(name_end);
    try local_values.append(stored);
    return code_eval_value(init_value_id, next_value);
}

// bind_code_slice_var binds a '[]u8' 'var' local to a '%sslot' slice slot: the
// init value materializes to a slice (a 'str' literal through STR_SLICE, an
// existing slice value unchanged) and a VAR_DECL_SLICE stores it. The slot id is
// the local's index, stored offset by code_slice_var_slot_base so a locals lookup
// resolves it as a slice slot (distinct from the i64 var slot space).
fn bind_code_slice_var(
    text: []u8,
    name_start: i64,
    name_end: i64,
    init_value_id: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let slice_eval = try lower_code_arg_slice(text, code, kinds, init_value_id, next_value);
    if !slice_eval.ok {
        return code_eval_unsupported(slice_eval.next);
    }
    let slot = local_starts.len();
    let op_var_decl_slice = code_op_var_decl_slice();
    try code.append(op_var_decl_slice);
    try code.append(slot);
    try code.append(slice_eval.value_id);
    let stored = code_slice_var_slot_base() + slot;
    try local_starts.append(name_start);
    try local_ends.append(name_end);
    try local_values.append(stored);
    return code_eval_value(slice_eval.value_id, slice_eval.next);
}

// lower_code_assign lowers 'name = <expr>' for a var local: the value lowers to a
// tape value and a VAR_STORE writes it into the var's slot. The target must be a
// bare var name already bound as a var (a let or unknown name is not owned here).
fn lower_code_assign(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    // '<receiver>.* = <expr>' over a mutable borrow stores through the pointer.
    // The receiver must resolve to a '&var i64' or '&var []u8' value; the store
    // form follows the pointer's kind. Any other deref target is not an owned
    // write here.
    let deref_ptr = try code_assign_deref_ptr(text, ast, target, kinds, local_starts, local_ends, local_values, locals_base);
    if deref_ptr >= 0 {
        return try lower_code_deref_store_any(text, deref_ptr, eval.value_id, code, kinds, eval.next);
    }
    let field_entry = try code_assign_field_entry(text, ast, target, code, kinds, local_starts, local_ends, local_values, locals_base);
    if field_entry >= 0 {
        return try lower_code_field_assign(text, field_entry, eval.value_id, code, kinds, eval.next);
    }
    // 'name = <expr>' over a '[]u8' var reassigns its slice slot: the value
    // materializes to a slice and a VAR_STORE_SLICE writes it.
    let slice_slot = try code_assign_slice_slot(text, ast, target, local_starts, local_ends, local_values, locals_base);
    if slice_slot >= 0 {
        return try lower_code_slice_var_store(text, slice_slot, eval.value_id, code, kinds, eval.next);
    }
    let slot = try code_assign_target_slot(text, ast, target, local_starts, local_ends, local_values, locals_base);
    if slot < 0 {
        return code_eval_unsupported(eval.next);
    }
    // Var slots are i64 allocas; storing a non-i64 value is not owned yet.
    let kind_i64 = code_kind_i64();
    let stored_kind = try kinds.get(eval.value_id);
    if stored_kind != kind_i64 {
        return code_eval_unsupported(eval.next);
    }
    let op_var_store = code_op_var_store();
    try code.append(op_var_store);
    try code.append(slot);
    try code.append(eval.value_id);
    return code_eval_value(eval.value_id, eval.next);
}

// lower_code_deref_store_any dispatches a '<&var T>.* = <expr>' store on the
// pointer's kind: a '&var []u8' slice pointer takes the slice store, every other
// (scalar i64) pointer the i64 store.
fn lower_code_deref_store_any(
    text: []u8,
    deref_ptr: i64,
    value_id: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let ptr_kind = try kinds.get(deref_ptr);
    if code_kind_is_mut_borrow_slice(ptr_kind) {
        return try lower_code_deref_store_slice(text, deref_ptr, value_id, code, kinds, next_value);
    }
    return try lower_code_deref_store(deref_ptr, value_id, code, kinds, next_value);
}

// lower_code_deref_store emits the PTR_STORE for '<&var i64>.* = <i64>'. The
// stored value must be i64 (a var slot's ABI); any other kind is not an owned
// write and stays unsupported.
fn lower_code_deref_store(
    deref_ptr: i64,
    value_id: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let kind_i64 = code_kind_i64();
    let stored_kind = try kinds.get(value_id);
    if stored_kind != kind_i64 {
        return code_eval_unsupported(next_value);
    }
    return try emit_code_ptr_store(deref_ptr, value_id, code, next_value);
}

// lower_code_deref_store_slice emits the PTR_STORE_SLICE for '<&var []u8>.* =
// <expr>'. The value materializes to a slice (a 'str' literal through STR_SLICE,
// an existing slice unchanged); a non-slice value is not an owned write.
fn lower_code_deref_store_slice(
    text: []u8,
    deref_ptr: i64,
    value_id: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let slice_eval = try lower_code_slice_store_value(text, code, kinds, value_id, next_value);
    if !slice_eval.ok {
        return code_eval_unsupported(slice_eval.next);
    }
    let stored_kind = try kinds.get(slice_eval.value_id);
    let kind_slice = code_kind_slice();
    if stored_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    return try emit_code_ptr_store_slice(deref_ptr, slice_eval.value_id, code, slice_eval.next);
}

fn lower_code_slice_store_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let direct = try lower_code_arg_slice(text, code, kinds, value_id, next_value);
    if !direct.ok {
        return code_eval_unsupported(direct.next);
    }
    let direct_kind = try kinds.get(direct.value_id);
    if direct_kind == code_kind_slice() {
        return direct;
    }
    return try lower_code_single_field_struct_slice_value(text, code, kinds, value_id, next_value);
}

fn lower_code_single_field_struct_slice_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    let value_kind = try kinds.get(value_id);
    if value_kind < record_base {
        return code_eval_unsupported(next_value);
    }
    let record_pos = value_kind - record_base;
    let op = try code.get(record_pos);
    let op_struct_lit = code_op_struct_lit();
    if op != op_struct_lit {
        return code_eval_unsupported(next_value);
    }
    let field_count = try code.get(record_pos + 4);
    if field_count != 1 {
        return code_eval_unsupported(next_value);
    }
    let first_field_value = try code.get(record_pos + 7);
    let field_eval = try lower_code_arg_slice(text, code, kinds, first_field_value, next_value);
    let field_kind = try kinds.get(field_eval.value_id);
    if field_kind != code_kind_slice() {
        return code_eval_unsupported(field_eval.next);
    }
    return field_eval;
}

// lower_code_slice_var_store materializes the assigned value to a slice and emits
// VAR_STORE_SLICE into a '[]u8' var's slice slot. A non-slice value is not owned.
fn lower_code_slice_var_store(
    text: []u8,
    slot: i64,
    value_id: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let slice_eval = try lower_code_arg_slice(text, code, kinds, value_id, next_value);
    if !slice_eval.ok {
        return code_eval_unsupported(slice_eval.next);
    }
    let stored_kind = try kinds.get(slice_eval.value_id);
    let kind_slice = code_kind_slice();
    if stored_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    let op_var_store_slice = code_op_var_store_slice();
    try code.append(op_var_store_slice);
    try code.append(slot);
    try code.append(slice_eval.value_id);
    return code_eval_value(slice_eval.value_id, slice_eval.next);
}

// code_assign_field_entry resolves an assignment target to its scalarized
// var-struct field entry (-1 when the target is not 'var_struct.field').
fn code_assign_field_entry(
    text: []u8,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let node = ast.get(target);
    return match node.data {
        FieldExpr(field_expr) => try code_assign_field_expr_entry(text, ast, field_expr.receiver, field_expr.name, field_expr.namespace, code, kinds, local_starts, local_ends, local_values, locals_base),
        _ => code_assign_no_field(),
    };
}

fn code_assign_no_field() -> i64 {
    return 0 - 1;
}

// code_assign_deref_ptr resolves a '<receiver>.* = ...' assignment target to the
// receiver's mutable borrow pointer value id (-1 when the target is not a deref
// of a bare mutable borrow). The receiver must be a bare var bound to a
// code_kind_mut_borrow_i64 or code_kind_mut_borrow_slice value (a '&var i64' or
// '&var []u8' parameter); the caller picks the store form from the pointer kind.
fn code_assign_deref_ptr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let node = ast.get(target);
    return match node.data {
        DerefExpr(deref_expr) => try code_assign_deref_receiver_ptr(text, ast, deref_expr.receiver, kinds, local_starts, local_ends, local_values, locals_base),
        _ => code_assign_no_field(),
    };
}

fn code_assign_deref_receiver_ptr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let node = ast.get(receiver);
    return match node.data {
        Var(var_node) => try code_assign_deref_var_ptr(text, ast, receiver, kinds, local_starts, local_ends, local_values, locals_base),
        _ => code_assign_no_field(),
    };
}

fn code_assign_deref_var_ptr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let name_span = code_node_span(text, ast, receiver);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    if bound < 0 {
        return 0 - 1;
    }
    let bound_kind = try kinds.get(bound);
    if !code_kind_is_mut_borrow_ptr(bound_kind) {
        return 0 - 1;
    }
    return bound;
}

// code_assign_field_expr_entry resolves a '<name>.<field>' assignment target:
// the receiver must be a local bound to a VAR_STRUCT record value (nested
// receivers and let structs stay unsupported).
fn code_assign_field_expr_entry(
    text: []u8,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    if namespace {
        return 0 - 1;
    }
    let receiver_span = code_node_span(text, ast, receiver);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, receiver_span.start, receiver_span.end);
    if bound < 0 {
        return 0 - 1;
    }
    let slot_floor = code_var_slot_base();
    if bound >= slot_floor {
        return 0 - 1;
    }
    let value_kind = try kinds.get(bound);
    let record_base = code_kind_struct_base();
    if value_kind < record_base {
        return 0 - 1;
    }
    let record_pos = value_kind - record_base;
    let record_op = try code.get(record_pos);
    let op_var_struct = code_op_var_struct();
    if record_op != op_var_struct {
        return 0 - 1;
    }
    let count_pos = record_pos + 4;
    let field_count = try code.get(count_pos);
    let name_span = code_node_span(text, ast, name);
    return try var_struct_field_entry(text, code, record_pos, field_count, name_span.start, name_span.end, 0);
}

// lower_code_field_assign lowers 'obj.field = <expr>;' for a scalarized var
// struct: the value lowers (a string materializes through STR_SLICE), its kind
// must match the field's slot kind, and the matching store writes the slot.
fn lower_code_field_assign(
    text: []u8,
    field_entry: i64,
    value_id: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let kind_pos = field_entry + 3;
    let slot_kind = try code.get(kind_pos);
    let record_base = code_kind_struct_base();
    if slot_kind >= record_base {
        return try lower_code_nested_var_struct_assign(text, code, kinds, field_entry, value_id, next_value);
    }
    let slot_pos = field_entry + 2;
    let slot = try code.get(slot_pos);
    let slice_eval = try lower_code_arg_slice(text, code, kinds, value_id, next_value);
    let stored_kind = try kinds.get(slice_eval.value_id);
    if stored_kind != slot_kind {
        return code_eval_unsupported(slice_eval.next);
    }
    let store_op = var_struct_store_op(slot_kind);
    try code.append(store_op);
    try code.append(slot);
    try code.append(slice_eval.value_id);
    return code_eval_value(slice_eval.value_id, slice_eval.next);
}

fn lower_code_nested_var_struct_assign(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    field_entry: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let kind_pos = field_entry + 3;
    let slot_kind = try code.get(kind_pos);
    let record_base = code_kind_struct_base();
    let record_pos = slot_kind - record_base;
    return try lower_code_nested_var_struct_assign_record(text, code, kinds, record_pos, value_id, next_value);
}

fn lower_code_nested_var_struct_assign_record(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    record_pos: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let op = try code.get(record_pos);
    let op_var_struct = code_op_var_struct();
    if op != op_var_struct {
        return code_eval_unsupported(next_value);
    }
    let source_kind = try kinds.get(value_id);
    let assign_eval = try lower_code_var_struct_assign_fields(text, code, kinds, record_pos, value_id, source_kind, 0, next_value);
    if !assign_eval.ok {
        return code_eval_unsupported(assign_eval.next);
    }
    return code_eval_value(value_id, assign_eval.next);
}

fn lower_code_var_struct_assign_fields(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    target_record_pos: i64,
    source_value: i64,
    source_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let field_count = try code.get(target_record_pos + 4);
    if index >= field_count {
        return code_eval_value(source_value, next_value);
    }
    let entry_slots = index * 4;
    let entry_pos = target_record_pos + 5 + entry_slots;
    let name_start = try code.get(entry_pos);
    let name_end = try code.get(entry_pos + 1);
    let field_eval = try lower_code_source_struct_field_value(text, code, kinds, source_value, source_kind, name_start, name_end, next_value);
    if !field_eval.ok {
        return code_eval_unsupported(field_eval.next);
    }
    let store_eval = try lower_code_var_struct_store_entry_value(text, code, kinds, entry_pos, field_eval.value_id, field_eval.next);
    if !store_eval.ok {
        return code_eval_unsupported(store_eval.next);
    }
    let after = index + 1;
    return try lower_code_var_struct_assign_fields(text, code, kinds, target_record_pos, source_value, source_kind, after, store_eval.next);
}

fn lower_code_var_struct_store_entry_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    field_entry: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let kind_pos = field_entry + 3;
    let slot_kind = try code.get(kind_pos);
    let record_base = code_kind_struct_base();
    if slot_kind >= record_base {
        return try lower_code_var_struct_store_nested_entry_kind(text, code, kinds, slot_kind, value_id, next_value);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, value_id, next_value);
    let stored_kind = try kinds.get(slice_eval.value_id);
    if stored_kind != slot_kind {
        return code_eval_unsupported(slice_eval.next);
    }
    let slot_pos = field_entry + 2;
    let slot = try code.get(slot_pos);
    let store_op = var_struct_store_op(slot_kind);
    try code.append(store_op);
    try code.append(slot);
    try code.append(slice_eval.value_id);
    return code_eval_value(slice_eval.value_id, slice_eval.next);
}

fn lower_code_var_struct_store_nested_entry_kind(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    slot_kind: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    let nested_record_pos = slot_kind - record_base;
    return try lower_code_var_struct_store_nested_entry_value(text, code, kinds, nested_record_pos, value_id, next_value);
}

fn lower_code_var_struct_store_nested_entry_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    nested_record_pos: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let op = try code.get(nested_record_pos);
    let op_var_struct = code_op_var_struct();
    if op != op_var_struct {
        return code_eval_unsupported(next_value);
    }
    let source_kind = try kinds.get(value_id);
    return try lower_code_var_struct_assign_fields(text, code, kinds, nested_record_pos, value_id, source_kind, 0, next_value);
}

fn lower_code_source_struct_field_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    source_value: i64,
    source_kind: i64,
    name_start: i64,
    name_end: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    if source_kind < record_base {
        return code_eval_unsupported(next_value);
    }
    let source_record_pos = source_kind - record_base;
    let op = try code.get(source_record_pos);
    let op_struct_lit = code_op_struct_lit();
    if op == op_struct_lit {
        return try lower_code_source_struct_lit_field_value(text, code, source_record_pos, name_start, name_end, next_value);
    }
    let op_struct_decl = code_op_struct_decl();
    if op == op_struct_decl {
        return try lower_code_struct_decl_field_read_by_span(text, code, kinds, source_record_pos, source_value, name_start, name_end, next_value);
    }
    let op_var_struct = code_op_var_struct();
    if op == op_var_struct {
        return try lower_code_source_var_struct_field_value(text, code, kinds, source_record_pos, name_start, name_end, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_source_struct_lit_field_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    source_record_pos: i64,
    name_start: i64,
    name_end: i64,
    next_value: i64
) -> !CodeEval {
    let field_count = try code.get(source_record_pos + 4);
    let field_value = try struct_record_field(text, code, source_record_pos, field_count, name_start, name_end, 0);
    if field_value < 0 {
        return code_eval_unsupported(next_value);
    }
    return code_eval_value(field_value, next_value);
}

fn lower_code_source_var_struct_field_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    source_record_pos: i64,
    name_start: i64,
    name_end: i64,
    next_value: i64
) -> !CodeEval {
    let field_count = try code.get(source_record_pos + 4);
    let field_entry = try var_struct_field_entry(text, code, source_record_pos, field_count, name_start, name_end, 0);
    if field_entry < 0 {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_var_struct_entry_value(code, kinds, field_entry, next_value);
}

// code_assign_target_slot resolves an assignment target to its var slot, or -1
// when the target is not a bare var name bound as a var (the tape owns only var
// reassignment, not let rebinding or field/index targets).
fn code_assign_target_slot(
    text: []u8,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let node = ast.get(target);
    return match node.data {
        Var(var_node) => try code_var_slot_of(text, ast, target, local_starts, local_ends, local_values, locals_base),
        _ => code_unbound_slot(),
    };
}

// code_unbound_slot returns the -1 sentinel a slot lookup uses for an unbound or
// non-var target. It is a call so the match arm stays one of the traversal arm
// shapes (a call) rather than the arith expression '0 - 1' the lowering rejects.
fn code_unbound_slot() -> i64 {
    return 0 - 1;
}

// code_var_slot_of returns the i64 var slot bound to a Var-node name, or -1 when
// the name is unbound, a let (below the slot base), or a slice var slot (resolved
// by code_slice_var_slot_of instead).
fn code_var_slot_of(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let name_span = code_node_span(text, ast, node_id);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    if code_local_is_slice_slot(bound) {
        return 0 - 1;
    }
    let base = code_var_slot_base();
    if bound < base {
        return 0 - 1;
    }
    return bound - base;
}

// code_slice_var_slot_of returns the slice var slot bound to a Var-node name, or
// -1 when the name is unbound, a let, or an i64 var slot.
fn code_slice_var_slot_of(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let name_span = code_node_span(text, ast, node_id);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    if !code_local_is_slice_slot(bound) {
        return 0 - 1;
    }
    return bound - code_slice_var_slot_base();
}

// code_assign_slice_slot resolves an assignment target to its slice var slot
// ('%sslot'), or -1 when the target is not a bare var bound as a slice var.
fn code_assign_slice_slot(
    text: []u8,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let node = ast.get(target);
    return match node.data {
        Var(var_node) => try code_slice_var_slot_of(text, ast, target, local_starts, local_ends, local_values, locals_base),
        _ => code_unbound_slot(),
    };
}

// lower_code_while lowers 'while <cond> { <body> }' onto the tape: WHILE_BEGIN
// opens the condition block, the condition expression lowers to an i1 value,
// WHILE_COND branches on it, the body statements follow with this loop as their
// break/continue target, and WHILE_END closes the loop. All three records carry
// the WHILE_BEGIN tape index so the renderer's labels match.
fn lower_code_while(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    label: std::kizu::ast::NodeId,
    condition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let while_begin_index = code.len();
    let label_mark = local_starts.len();
    let kind_label_while = code_loop_kind_while();
    try bind_code_loop_label(text, ast, label, local_starts, local_ends, local_values, while_begin_index, kind_label_while);
    let op_while_begin = code_op_while_begin();
    try code.append(op_while_begin);
    try code.append(while_begin_index);
    let loop_defer_base = defer_records.len();
    try code.append(loop_defer_base);
    let cond_eval = try lower_code_expr(text, ast, decls, condition, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !cond_eval.ok {
        return code_eval_unsupported(cond_eval.next);
    }
    let op_while_cond = code_op_while_cond();
    try code.append(op_while_cond);
    try code.append(cond_eval.value_id);
    try code.append(while_begin_index);
    let kind_while = code_loop_kind_while();
    let body_eval = try lower_code_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, while_begin_index, kind_while, cond_eval.next);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let op_while_end = code_op_while_end();
    try code.append(op_while_end);
    try code.append(while_begin_index);
    try scrub_code_locals(local_starts, local_ends, label_mark);
    return code_eval_value(0, body_eval.next);
}

// lower_code_for lowers 'for <start>..<end> |name| { <body> }': the start and end
// bounds lower to values, the induction name binds to a fresh var slot, FOR_BEGIN
// seeds the slot and opens the bounded condition block (carrying the load/compare
// temp ids), the body statements follow with this loop as their break/continue
// target, and FOR_END emits the increment latch (carrying its temp ids).
fn lower_code_for(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    label: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let start_eval = try lower_code_expr(text, ast, decls, start, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !start_eval.ok {
        return code_eval_unsupported(start_eval.next);
    }
    let end_eval = try lower_code_expr(text, ast, decls, end, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, start_eval.next);
    if !end_eval.ok {
        return code_eval_unsupported(end_eval.next);
    }
    // The induction name binds in its own loop scope: it may shadow any outer
    // binding and is scrubbed once the loop closes.
    let name_span = code_node_span(text, ast, name);
    let induction_mark = local_starts.len();
    let slot = induction_mark;
    let stored = code_var_slot_base() + slot;
    try local_starts.append(name_span.start);
    try local_ends.append(name_span.end);
    try local_values.append(stored);
    // FOR_BEGIN's condition block loads the induction slot and compares it to the
    // end bound; both temps take fresh value ids (with parallel kinds entries).
    let cond_load_value = end_eval.next;
    let cond_cmp_value = cond_load_value + 1;
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let for_begin_index = code.len();
    let op_for_begin = code_op_for_begin();
    try code.append(op_for_begin);
    try code.append(for_begin_index);
    try code.append(slot);
    try code.append(start_eval.value_id);
    try code.append(end_eval.value_id);
    try code.append(cond_load_value);
    try code.append(cond_cmp_value);
    let loop_defer_base = defer_records.len();
    try code.append(loop_defer_base);
    let kind_for = code_loop_kind_for();
    try bind_code_loop_label(text, ast, label, local_starts, local_ends, local_values, for_begin_index, kind_for);
    let body_next = cond_cmp_value + 1;
    let body_eval = try lower_code_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, defer_records, locals_base, for_begin_index, kind_for, body_next);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    // FOR_END's latch loads the slot, adds one, and stores it back; both temps
    // take fresh value ids (with parallel kinds entries).
    let latch_load_value = body_eval.next;
    let latch_add_value = latch_load_value + 1;
    try kinds.append(kind_i64);
    try kinds.append(kind_i64);
    let op_for_end = code_op_for_end();
    try code.append(op_for_end);
    try code.append(for_begin_index);
    try code.append(slot);
    try code.append(latch_load_value);
    try code.append(latch_add_value);
    try scrub_code_locals(local_starts, local_ends, induction_mark);
    let after_value = latch_add_value + 1;
    return code_eval_value(0, after_value);
}

// lower_code_break / lower_code_continue emit the BREAK / CONTINUE record for the
// enclosing loop (a bare statement) or for the loop the statement's label names.
// Outside any loop (loop_begin < 0) a bare statement is not owned.
fn lower_code_break(
    text: []u8,
    ast: std::kizu::ast::Ast,
    label: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let op_break = code_op_break();
    if is_empty_node(ast, label) {
        return try emit_code_loop_exit_with_defers(code, kinds, defer_records, op_break, loop_begin, loop_kind, next_value);
    }
    let target = try code_loop_label_target(text, ast, label, local_starts, local_ends, local_values, locals_base);
    if target < 0 {
        return code_eval_unsupported(next_value);
    }
    let target_begin = code_loop_label_target_begin(target);
    let target_kind = code_loop_label_target_kind(target, target_begin);
    return try emit_code_loop_exit_with_defers(code, kinds, defer_records, op_break, target_begin, target_kind, next_value);
}

fn lower_code_continue(
    text: []u8,
    ast: std::kizu::ast::Ast,
    label: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let op_continue = code_op_continue();
    if is_empty_node(ast, label) {
        return try emit_code_loop_exit_with_defers(code, kinds, defer_records, op_continue, loop_begin, loop_kind, next_value);
    }
    let target = try code_loop_label_target(text, ast, label, local_starts, local_ends, local_values, locals_base);
    if target < 0 {
        return code_eval_unsupported(next_value);
    }
    let target_begin = code_loop_label_target_begin(target);
    let target_kind = code_loop_label_target_kind(target, target_begin);
    return try emit_code_loop_exit_with_defers(code, kinds, defer_records, op_continue, target_begin, target_kind, next_value);
}

fn emit_code_loop_exit_with_defers(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    op: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    if loop_begin < 0 {
        return code_eval_unsupported(next_value);
    }
    let defer_base = try code_loop_defer_base(code, loop_begin, loop_kind);
    let defer_eval = try lower_code_defer_range_for_exit(code, kinds, defer_records, defer_base, next_value);
    if !defer_eval.ok {
        return code_eval_unsupported(defer_eval.next);
    }
    return try emit_code_loop_exit(code, op, loop_begin, loop_kind, defer_eval.next);
}

// emit_code_loop_exit appends one BREAK or CONTINUE record targeting the loop
// whose WHILE/FOR begin index and kind are given.
fn emit_code_loop_exit(
    code: &var std::array::Array<i64>,
    op: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    if loop_begin < 0 {
        return code_eval_unsupported(next_value);
    }
    try code.append(op);
    try code.append(loop_begin);
    try code.append(loop_kind);
    return code_eval_value(0, next_value);
}

fn code_loop_defer_base(
    code: &std::array::Array<i64>,
    loop_begin: i64,
    loop_kind: i64
) -> !i64 {
    let kind_while = code_loop_kind_while();
    if loop_kind == kind_while {
        return try code.get(loop_begin + 2);
    }
    return try code.get(loop_begin + 7);
}

// bind_code_loop_label registers a loop's label (when present) as a scoped
// binding whose value encodes the loop's begin index and kind, so a labeled
// break/continue resolves its target through the ordinary locals lookup and the
// binding stops resolving once the loop's scrub closes it.
fn bind_code_loop_label(
    text: []u8,
    ast: std::kizu::ast::Ast,
    label: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    loop_begin: i64,
    loop_kind: i64
) -> !void {
    if is_empty_node(ast, label) {
        return;
    }
    let name_span = code_node_span(text, ast, label);
    let doubled = loop_begin * 2;
    let tagged = doubled + loop_kind;
    let stored = code_loop_label_base() + tagged;
    try local_starts.append(name_span.start);
    try local_ends.append(name_span.end);
    try local_values.append(stored);
    return;
}

// code_loop_label_target resolves a label name to its encoded loop value, or -1
// when the name is unbound or bound to something that is not a loop label.
fn code_loop_label_target(
    text: []u8,
    ast: std::kizu::ast::Ast,
    label: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let name_span = code_node_span(text, ast, label);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    let base = code_loop_label_base();
    if bound < base {
        return 0 - 1;
    }
    return bound;
}

// code_loop_label_target_begin / code_loop_label_target_kind decode an encoded
// loop-label value back into the target loop's begin index and kind.
fn code_loop_label_target_begin(target: i64) -> i64 {
    let encoded = target - code_loop_label_base();
    let begin = encoded / 2;
    return begin;
}

fn code_loop_label_target_kind(target: i64, target_begin: i64) -> i64 {
    let encoded = target - code_loop_label_base();
    let doubled = target_begin * 2;
    let kind = encoded - doubled;
    return kind;
}

// lower_code_expr_statement lowers a statement-position expression; the tape
// owns the print(<expr>) call, recorded with the argument's value kind so the
// renderer picks the string or decimal writer.
fn lower_code_expr_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    expr: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_code_statement_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        TryExpr(try_expr) => try lower_code_try_statement(text, ast, decls, try_expr.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_statement_call routes a statement-position call: print(<expr>) keeps
// its PRINT record, every other callee lowers as an ordinary user CALL whose
// result value simply stays unused.
fn lower_code_statement_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "print") {
        return try lower_code_print_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::testing::expect") {
        return try lower_code_expect_call(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::starts_with(callee_text, "std::testing::expect_equal") {
        return try lower_code_expect_equal_call(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let runtime_eval = try lower_code_runtime_statement_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if runtime_eval.ok {
        return runtime_eval;
    }
    let method_kind = try code_method_call_return_kind(text, ast, decls, code, callee);
    if method_kind >= 0 {
        return try emit_code_method_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, true, next_value);
    }
    return try lower_code_user_call_statement(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

fn lower_code_runtime_statement_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_runtime_field_statement_call(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_runtime_field_statement_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let method = ast_node_text(text, ast, name);
    if std::mem::equal_bytes(method, "clear") {
        if args.len != 0 {
            return code_eval_unsupported(next_value);
        }
        let clear_receiver_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
        if !clear_receiver_eval.ok {
            return code_eval_unsupported(clear_receiver_eval.next);
        }
        let clear_receiver_kind = try kinds.get(clear_receiver_eval.value_id);
        if clear_receiver_kind != code_kind_owned_string() {
            return code_eval_unsupported(clear_receiver_eval.next);
        }
        let op_clear = code_op_storage_clear();
        try code.append(op_clear);
        try code.append(clear_receiver_eval.value_id);
        try code.append(clear_receiver_kind);
        return code_eval_value(0, clear_receiver_eval.next);
    }
    if !std::mem::equal_bytes(method, "deinit") {
        return code_eval_unsupported(next_value);
    }
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let receiver_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    if !code_kind_is_owned_resource(receiver_kind) {
        return code_eval_unsupported(receiver_eval.next);
    }
    if code_kind_is_arena(receiver_kind) {
        let op_arena_deinit = code_op_arena_deinit();
        try code.append(op_arena_deinit);
        try code.append(receiver_eval.value_id);
    } else {
        let op_deinit = code_op_storage_deinit();
        try code.append(op_deinit);
        try code.append(receiver_eval.value_id);
        try code.append(receiver_kind);
    }
    return code_eval_value(0, receiver_eval.next);
}

// lower_code_expect_call lowers 'std::testing::expect(<cond>)': the single
// argument lowers to an i1 value and the EXPECT record branches on it.
fn lower_code_expect_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let cond_kind = try kinds.get(eval.value_id);
    let kind_bool = code_kind_bool();
    if cond_kind != kind_bool {
        return code_eval_unsupported(eval.next);
    }
    let op_expect = code_op_expect();
    try code.append(op_expect);
    try code.append(eval.value_id);
    return code_eval_value(0, eval.next);
}

fn lower_code_expect_equal_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let expected_arg = try ast.child_at(args, 0);
    let expected_eval = try lower_code_expr(text, ast, decls, expected_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !expected_eval.ok {
        return code_eval_unsupported(expected_eval.next);
    }
    let actual_arg = try ast.child_at(args, 1);
    let actual_eval = try lower_code_expr(text, ast, decls, actual_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, expected_eval.next);
    if !actual_eval.ok {
        return code_eval_unsupported(actual_eval.next);
    }
    let kind_i64 = code_kind_i64();
    let expected_kind = try kinds.get(expected_eval.value_id);
    let actual_kind = try kinds.get(actual_eval.value_id);
    if expected_kind == kind_i64 {
        if actual_kind == kind_i64 {
            let op_binary = code_op_binary();
            let cond_value = actual_eval.next;
            try code.append(op_binary);
            try code.append(cond_value);
            try code.append(5);
            try code.append(expected_eval.value_id);
            try code.append(actual_eval.value_id);
            let kind_bool = code_kind_bool();
            try kinds.append(kind_bool);
            let op_expect = code_op_expect();
            try code.append(op_expect);
            try code.append(cond_value);
            let after_value = cond_value + 1;
            return code_eval_value(0, after_value);
        }
    }
    // Non-i64 operands lower as a '%kizu.slice.u8' byte equality: both operands
    // materialize through the same str/[]u8 boundary as std::mem::equal_bytes
    // (lower_code_arg_slice), MEM_EQUAL_BYTES produces a bool, and EXPECT
    // consumes it. This unblocks 'expect_equal<[]u8>' purely from the resolved
    // operand KIND, without inspecting the generic type-argument text.
    let left_slice = try lower_code_arg_slice(text, code, kinds, expected_eval.value_id, actual_eval.next);
    let kind_slice = code_kind_slice();
    let left_kind = try kinds.get(left_slice.value_id);
    if left_kind != kind_slice {
        return code_eval_unsupported(left_slice.next);
    }
    let right_slice = try lower_code_arg_slice(text, code, kinds, actual_eval.value_id, left_slice.next);
    let right_kind = try kinds.get(right_slice.value_id);
    if right_kind != kind_slice {
        return code_eval_unsupported(right_slice.next);
    }
    let result_value = right_slice.next;
    let op_mem_equal = code_op_mem_equal_bytes();
    try code.append(op_mem_equal);
    try code.append(result_value);
    try code.append(left_slice.value_id);
    try code.append(right_slice.value_id);
    let slice_kind_bool = code_kind_bool();
    try kinds.append(slice_kind_bool);
    let op_expect_slice = code_op_expect();
    try code.append(op_expect_slice);
    try code.append(result_value);
    let slice_after_value = result_value + 1;
    return code_eval_value(0, slice_after_value);
}

// lower_code_user_call_statement lowers a statement-position call to a declared
// void (kind 0), i64 (kind 1), or bool function as a CALL record; a void callee
// compiles as an i64 define returning 0, so the same record shape serves both.
fn lower_code_user_call_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let callee_kind = try code_callee_return_kind(text, ast, decls, code, callee_span.start, callee_span.end, 0);
    // A void callee defines (and calls) through the i64 ABI, so its discarded
    // result records the i64 kind.
    if callee_kind == 0 {
        return try emit_code_user_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, 1, next_value);
    }
    if callee_kind == 1 {
        return try emit_code_user_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, 1, next_value);
    }
    let bool_ret = code_return_kind_bool();
    let kind_bool = code_kind_bool();
    if callee_kind == bool_ret {
        return try emit_code_user_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, kind_bool, next_value);
    }
    // A discarded 'act();' on an error-union callee emits the same TRY_CALL
    // records as 'try act();'; with no runtime error the success value is simply
    // dropped, matching the Go runner which ignores the error in statement
    // position. '!void' (kind 2) uses TRY_CALL, '!i64' (kind 3) uses TRY_CALL_I64.
    if callee_kind == 2 {
        return try emit_code_try_call_void(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if callee_kind == 3 {
        return try emit_code_try_call_i64(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if callee_kind == code_return_kind_typed_error_void() {
        return try emit_code_try_call_typed_error_void(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if callee_kind == code_return_kind_typed_error_i64() {
        return try emit_code_try_call_typed_error_i64(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

// lower_code_try_statement lowers a 'try <call>;' statement: the try value must be
// a direct call to an error-union-void function, lowered onto the tape as TRY_CALL.
fn lower_code_try_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    call_expr: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(call_expr);
    return match node.data {
        Call(call_node) => try lower_code_try_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_try_call lowers 'try <callee>(<args>)' where callee is a declared
// error-union-void function: the argument expressions lower first, then the
// TRY_CALL record carries the callee name span, the argument count, and the
// argument value ids copied off the scratch tail. The try yields no value, so
// no result value id is consumed.
fn lower_code_try_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "std::fmt::append_i64") {
        return try lower_code_try_string_append_i64(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::fmt::append_bool") {
        return try lower_code_try_string_append_bool(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::fmt::append_bytes_literal") {
        return try lower_code_try_string_append_bytes_literal(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let append_byte_eval = try lower_code_try_string_append_byte_method(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if append_byte_eval.ok {
        return append_byte_eval;
    }
    if std::mem::equal_bytes(callee_text, "std::io::write_stdout") {
        return try lower_code_try_io_write_stdout(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::io::write_stderr") {
        return try lower_code_try_io_write_stderr(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::fs::create_dir") {
        return try lower_code_fs_create_dir(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let runtime_eval = try lower_code_try_runtime_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if runtime_eval.ok {
        return runtime_eval;
    }
    let callee_span = code_node_span(text, ast, callee);
    let callee_kind = try code_callee_return_kind(text, ast, decls, code, callee_span.start, callee_span.end, 0);
    if callee_kind == 2 {
        return try emit_code_try_call_void(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    // A statement-position 'try <!i64 callee>();' discards the success value;
    // the TRY_CALL_I64 record still allocates its result id.
    if callee_kind == 3 {
        return try emit_code_try_call_i64(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if callee_kind == code_return_kind_typed_error_void() {
        return try emit_code_try_call_typed_error_void(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if callee_kind == code_return_kind_typed_error_i64() {
        return try emit_code_try_call_typed_error_i64(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_try_string_append_i64(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let kind_i64 = code_kind_i64();
    let op = code_op_try_string_append_i64();
    return try lower_code_try_string_append_two_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, kind_i64, op, next_value);
}

fn lower_code_try_string_append_bool(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let kind_bool = code_kind_bool();
    let op = code_op_try_string_append_bool();
    return try lower_code_try_string_append_two_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, kind_bool, op, next_value);
}

fn lower_code_try_string_append_bytes_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let kind_slice = code_kind_slice();
    let op = code_op_try_string_append_bytes_literal();
    return try lower_code_try_string_append_two_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, kind_slice, op, next_value);
}

fn lower_code_try_string_append_two_args(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    arg_kind: i64,
    op: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let receiver_arg = try ast.child_at(args, 0);
    let receiver_eval = try lower_code_expr(text, ast, decls, receiver_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    let kind_owned = code_kind_owned();
    let kind_string = code_kind_owned_string();
    if receiver_kind != kind_owned and receiver_kind != kind_string {
        return code_eval_unsupported(receiver_eval.next);
    }
    let value_arg = try ast.child_at(args, 1);
    let value_eval = try lower_code_expr(text, ast, decls, value_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let stored_eval = try lower_code_arg_slice(text, code, kinds, value_eval.value_id, value_eval.next);
    let stored_kind = try kinds.get(stored_eval.value_id);
    if stored_kind != arg_kind {
        return code_eval_unsupported(stored_eval.next);
    }
    try code.append(op);
    try code.append(receiver_eval.value_id);
    try code.append(stored_eval.value_id);
    return code_eval_value(0, stored_eval.next);
}

fn lower_code_try_string_append_byte_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_try_string_append_byte_field(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_try_string_append_byte_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let method = ast_node_text(text, ast, name);
    if !std::mem::equal_bytes(method, "append_byte") {
        return code_eval_unsupported(next_value);
    }
    let receiver_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    let kind_owned = code_kind_owned();
    let kind_string = code_kind_owned_string();
    if receiver_kind != kind_owned and receiver_kind != kind_string {
        return code_eval_unsupported(receiver_eval.next);
    }
    let value_arg = try ast.child_at(args, 0);
    let value_eval = try lower_code_expr(text, ast, decls, value_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let value_kind = try kinds.get(value_eval.value_id);
    let i64_like = try code_operand_is_i64_like(code, value_kind);
    if !i64_like {
        return code_eval_unsupported(value_eval.next);
    }
    let op_append_byte = code_op_try_string_append_byte();
    try code.append(op_append_byte);
    try code.append(receiver_eval.value_id);
    try code.append(value_eval.value_id);
    return code_eval_value(0, value_eval.next);
}

fn lower_code_try_runtime_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_try_runtime_field_call(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_try_runtime_field_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let receiver_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    let method = ast_node_text(text, ast, name);
    if receiver_kind == code_kind_owned_string() {
        return try lower_code_try_string_method(text, ast, decls, method, receiver_eval.value_id, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    if code_kind_is_owned_array(receiver_kind) {
        return try lower_code_try_array_method(text, ast, decls, method, receiver_eval.value_id, receiver_kind, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    if code_kind_is_mutable_map_handle(receiver_kind) {
        return try lower_code_try_map_method(text, ast, decls, method, receiver_eval.value_id, receiver_kind, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    return code_eval_unsupported(receiver_eval.next);
}

fn lower_code_try_string_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    method: []u8,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if std::mem::equal_bytes(method, "truncate") {
        return try lower_code_try_string_truncate(text, ast, decls, receiver_value, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(method, "reserve") {
        return try lower_code_try_string_reserve(text, ast, decls, receiver_value, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if !std::mem::equal_bytes(method, "append_bytes") {
        return code_eval_unsupported(next_value);
    }
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let arg_eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !arg_eval.ok {
        return code_eval_unsupported(arg_eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, arg_eval.value_id, arg_eval.next);
    let slice_kind = code_kind_slice();
    let actual_kind = try kinds.get(slice_eval.value_id);
    if actual_kind != slice_kind {
        return code_eval_unsupported(slice_eval.next);
    }
    let op = code_op_try_string_append_bytes();
    try code.append(op);
    try code.append(receiver_value);
    try code.append(slice_eval.value_id);
    return code_eval_value(0, slice_eval.next);
}

fn lower_code_try_string_truncate(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let arg_eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !arg_eval.ok {
        return code_eval_unsupported(arg_eval.next);
    }
    let kind_i64 = code_kind_i64();
    let actual_kind = try kinds.get(arg_eval.value_id);
    if actual_kind != kind_i64 {
        return code_eval_unsupported(arg_eval.next);
    }
    let op = code_op_try_string_truncate();
    try code.append(op);
    try code.append(receiver_value);
    try code.append(arg_eval.value_id);
    return code_eval_value(0, arg_eval.next);
}

// String.reserve(additional) is a capacity hint that never changes the string's
// length or bytes, but its capacity is observable through String.capacity().
// Lower it to the runtime storage helper instead of treating it as a no-op.
fn lower_code_try_string_reserve(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let arg_eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !arg_eval.ok {
        return code_eval_unsupported(arg_eval.next);
    }
    let kind_i64 = code_kind_i64();
    let actual_kind = try kinds.get(arg_eval.value_id);
    if actual_kind != kind_i64 {
        return code_eval_unsupported(arg_eval.next);
    }
    let op = code_op_try_string_reserve();
    try code.append(op);
    try code.append(receiver_value);
    try code.append(arg_eval.value_id);
    return code_eval_value(0, arg_eval.next);
}

fn lower_code_try_array_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    method: []u8,
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if std::mem::equal_bytes(method, "set") {
        return try lower_code_try_array_set(text, ast, decls, receiver_value, receiver_kind, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if !std::mem::equal_bytes(method, "append") {
        return code_eval_unsupported(next_value);
    }
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let arg_eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !arg_eval.ok {
        return code_eval_unsupported(arg_eval.next);
    }
    let element_eval = try lower_code_array_element_value(text, code, kinds, receiver_kind, arg_eval.value_id, arg_eval.next);
    let element_kind = try code_array_element_kind(code, receiver_kind);
    if element_kind == code_kind_i64() {
        let op_array_append_i64 = code_op_try_array_append_i64();
        try code.append(op_array_append_i64);
        try code.append(receiver_value);
        try code.append(element_eval.value_id);
    }
    if element_kind != code_kind_i64() {
        let op_array_append = code_op_try_array_append();
        try code.append(op_array_append);
        try code.append(receiver_value);
        try code.append(element_eval.value_id);
        try code.append(element_kind);
    }
    return code_eval_value(0, element_eval.next);
}

fn lower_code_array_element_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    receiver_kind: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let element_kind = try code_array_element_kind(code, receiver_kind);
    if code_kind_is_owned_array_struct(receiver_kind) {
        return try lower_code_array_struct_element_value(text, code, kinds, receiver_kind, value_id, element_kind, next_value);
    }
    let element_eval = try lower_code_arg_slice(text, code, kinds, value_id, next_value);
    let element_value = element_eval.value_id;
    let element_next = element_eval.next;
    let value_kind = try kinds.get(element_value);
    if value_kind == element_kind {
        return code_eval_value(element_value, element_next);
    }
    // Array<EnumType> instantiates as an i64-tag array: an enum element value is
    // its i64 discriminant at runtime, so it lowers through the i64 element path.
    let value_is_enum = try code_kind_is_enum_value(code, value_kind);
    if element_kind != code_kind_i64() {
        return code_eval_unsupported(element_next);
    }
    if !value_is_enum {
        return code_eval_unsupported(element_next);
    }
    return code_eval_value(element_value, element_next);
}

fn lower_code_array_struct_element_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    receiver_kind: i64,
    value_id: i64,
    element_kind: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    let value_kind = try kinds.get(value_id);
    let param_pos = code_kind_owned_array_struct_record_pos(receiver_kind);
    if value_kind == record_base + param_pos {
        return code_eval_value(value_id, next_value);
    }
    if value_kind < record_base {
        return code_eval_unsupported(next_value);
    }
    let value_record_pos = value_kind - record_base;
    let op = try code.get(value_record_pos);
    let op_struct_lit = code_op_struct_lit();
    if op != op_struct_lit {
        return code_eval_unsupported(next_value);
    }
    let field_start = try code.get(param_pos + 2);
    let field_end = try code.get(param_pos + 3);
    let field_count = try code.get(value_record_pos + 4);
    let field_value = try struct_record_field(text, code, value_record_pos, field_count, field_start, field_end, 0);
    if field_value < 0 {
        return code_eval_unsupported(next_value);
    }
    let field_eval = try lower_code_arg_slice(text, code, kinds, field_value, next_value);
    let field_kind = try kinds.get(field_eval.value_id);
    if field_kind != element_kind {
        return code_eval_unsupported(field_eval.next);
    }
    return field_eval;
}

// lower_code_try_array_set lowers 'try xs.set(i, v)' to ARRAY_SET. The index
// argument lowers first (it must be an i64), then the value argument, mirroring
// the append element-kind handling so an enum-typed value stores through the
// i64 element path. It yields void.
fn lower_code_try_array_set(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let index_arg = try ast.child_at(args, 0);
    let index_eval = try lower_code_expr(text, ast, decls, index_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !index_eval.ok {
        return code_eval_unsupported(index_eval.next);
    }
    let kind_i64 = code_kind_i64();
    let index_kind = try kinds.get(index_eval.value_id);
    if index_kind != kind_i64 {
        return code_eval_unsupported(index_eval.next);
    }
    let value_arg = try ast.child_at(args, 1);
    let value_eval = try lower_code_expr(text, ast, decls, value_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, index_eval.next);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let element_eval = try lower_code_array_element_value(text, code, kinds, receiver_kind, value_eval.value_id, value_eval.next);
    let element_kind = try code_array_element_kind(code, receiver_kind);
    let op_try_array_set = code_op_try_array_set();
    try code.append(op_try_array_set);
    try code.append(receiver_value);
    try code.append(index_eval.value_id);
    try code.append(element_eval.value_id);
    try code.append(element_kind);
    return code_eval_value(0, element_eval.next);
}

fn lower_code_try_map_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    method: []u8,
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if !std::mem::equal_bytes(method, "insert") {
        return code_eval_unsupported(next_value);
    }
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let key_arg = try ast.child_at(args, 0);
    let key_eval = try lower_code_expr(text, ast, decls, key_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !key_eval.ok {
        return code_eval_unsupported(key_eval.next);
    }
    let key_slice = try lower_code_arg_slice(text, code, kinds, key_eval.value_id, key_eval.next);
    let value_arg = try ast.child_at(args, 1);
    let value_eval = try lower_code_expr(text, ast, decls, value_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, key_slice.next);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let kind_slice = code_kind_slice();
    let map_value_kind = code_map_value_kind(receiver_kind);
    let key_kind = try kinds.get(key_slice.value_id);
    let value_kind = try kinds.get(value_eval.value_id);
    if key_kind != kind_slice {
        return code_eval_unsupported(value_eval.next);
    }
    if value_kind != map_value_kind {
        let value_is_enum = try code_kind_is_enum_value(code, value_kind);
        if map_value_kind != code_kind_i64() {
            return code_eval_unsupported(value_eval.next);
        }
        if !value_is_enum {
            return code_eval_unsupported(value_eval.next);
        }
    }
    let op = code_op_try_map_insert_i64();
    try code.append(op);
    try code.append(receiver_value);
    try code.append(key_slice.value_id);
    try code.append(value_eval.value_id);
    return code_eval_value(0, value_eval.next);
}

// lower_code_try_io_write_stdout / lower_code_try_io_write_stderr bind their
// stream tag in their own frame so the dispatch above stays a run of
// single-statement guards.
fn lower_code_try_io_write_stdout(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let stream = code_io_stream_stdout();
    return try lower_code_try_io_write(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, stream, next_value);
}

fn lower_code_try_io_write_stderr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let stream = code_io_stream_stderr();
    return try lower_code_try_io_write(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, stream, next_value);
}

// lower_code_try_io_write lowers 'try std::io::write_stdout/write_stderr(io,
// bytes)': the io handle must lower to a kind-owned value and the message to a
// kind-slice value (a string literal materializes through STR_SLICE), then the
// TRY_IO_WRITE record carries both value ids and the stream tag.
fn lower_code_try_io_write(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    stream: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let io_arg = try ast.child_at(args, 0);
    let io_eval = try lower_code_expr(text, ast, decls, io_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !io_eval.ok {
        return code_eval_unsupported(io_eval.next);
    }
    let io_kind = try kinds.get(io_eval.value_id);
    let owned_kind = code_kind_owned();
    if io_kind != owned_kind {
        return code_eval_unsupported(io_eval.next);
    }
    let msg_arg = try ast.child_at(args, 1);
    let msg_eval = try lower_code_expr(text, ast, decls, msg_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, io_eval.next);
    if !msg_eval.ok {
        return code_eval_unsupported(msg_eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, msg_eval.value_id, msg_eval.next);
    let msg_kind = try kinds.get(slice_eval.value_id);
    let slice_kind = code_kind_slice();
    if msg_kind != slice_kind {
        return code_eval_unsupported(slice_eval.next);
    }
    let op_try_io_write = code_op_try_io_write();
    try code.append(op_try_io_write);
    try code.append(io_eval.value_id);
    try code.append(slice_eval.value_id);
    try code.append(stream);
    return code_eval_value(0, slice_eval.next);
}

// emit_code_try_call_void appends the TRY_CALL record for an error-union-void
// callee (the try yields no value).
fn emit_code_try_call_void(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op_try_call = code_op_try_call();
    return try emit_code_try_call_void_record(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, op_try_call, next_value);
}

fn emit_code_try_call_typed_error_void(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op_try_call = code_op_try_call_typed_error_void();
    return try emit_code_try_call_void_record(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, op_try_call, next_value);
}

fn emit_code_try_call_void_record(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    op_try_call: i64,
    next_value: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let scratch_base = try args_scratch.get(0);
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, callee_span.start, callee_span.end, 0, next_value);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    try code.append(op_try_call);
    try code.append(callee_span.start);
    try code.append(callee_span.end);
    try code.append(args.len);
    let arg_count = args.len;
    let scratch_bound = scratch_base + arg_count;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    return code_eval_value(0, args_eval.next);
}

// emit_code_try_call_i64 appends the TRY_CALL_I64 record for an error-union-i64
// callee; the try yields the extracted i64 success value as the result.
fn emit_code_try_call_i64(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op_try_call_i64 = code_op_try_call_i64();
    return try emit_code_try_call_i64_record(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, op_try_call_i64, next_value);
}

fn emit_code_try_call_typed_error_i64(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op_try_call_i64 = code_op_try_call_typed_error_i64();
    return try emit_code_try_call_i64_record(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, op_try_call_i64, next_value);
}

fn emit_code_try_call_i64_record(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    op_try_call_i64: i64,
    next_value: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let scratch_base = try args_scratch.get(0);
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, callee_span.start, callee_span.end, 0, next_value);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    try code.append(op_try_call_i64);
    try code.append(args_eval.next);
    try code.append(callee_span.start);
    try code.append(callee_span.end);
    try code.append(args.len);
    let arg_count = args.len;
    let scratch_bound = scratch_base + arg_count;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let result_value = args_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// emit_code_try_call_error_owned lowers 'try <callee>(...)' when the callee
// returns a '%kizu.error.owned' aggregate. The caller supplies the success
// value-kind, so the same record covers owned String and owned Array handles.
fn emit_code_try_call_error_owned(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64,
    result_kind: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let scratch_base = try args_scratch.get(0);
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, callee_span.start, callee_span.end, 0, next_value);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    let op_try_call_owned_string = code_op_try_call_owned_string();
    try code.append(op_try_call_owned_string);
    try code.append(args_eval.next);
    try code.append(callee_span.start);
    try code.append(callee_span.end);
    try code.append(args.len);
    let arg_count = args.len;
    let scratch_bound = scratch_base + arg_count;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    try kinds.append(result_kind);
    let result_value = args_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_print_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if !std::mem::equal_bytes(callee_text, "print") {
        return code_eval_unsupported(next_value);
    }
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let kind = try kinds.get(eval.value_id);
    // Record-backed values print only when their record carries a printable
    // scalar/slice representation: ENUM_CONST writes the qualified variant name,
    // ENUM_DECL dispatches the runtime tag through its declaration variants, and
    // STRUCT_PARAM unwraps to the parameter field ABI. Other struct records have
    // no printable SSA temp, so 'print(<struct>)' stays unsupported.
    let record_base = code_kind_struct_base();
    if kind >= record_base {
        return try lower_code_print_record(code, eval.value_id, kind, record_base, eval.next);
    }
    let op_print = code_op_print();
    try code.append(op_print);
    try code.append(eval.value_id);
    try code.append(kind);
    return code_eval_value(eval.value_id, eval.next);
}

// lower_code_print_record keeps printable record-backed values on the tape.
// ENUM_CONST resolves to its qualified variant text; ENUM_DECL resolves its
// runtime tag against declaration variant spans; a STRUCT_PARAM resolves through
// the receiver parameter metadata to the field ABI kind. UNION_CONST stays
// rejected on purpose: the renderer's string-globals walk emits enum globals
// only, so admitting a union here would reference an undefined global (lift both
// sides together if union printing ever lands).
fn lower_code_print_record(
    code: &var std::array::Array<i64>,
    value_id: i64,
    kind: i64,
    record_base: i64,
    next_value: i64
) -> !CodeEval {
    let record_pos = kind - record_base;
    let record_op = try code.get(record_pos);
    let op_enum_const = code_op_enum_const();
    let op_enum_decl = code_op_enum_decl();
    let op_struct_param = code_op_struct_param();
    let is_enum = record_op == op_enum_const;
    let is_enum_runtime = record_op == op_enum_decl;
    let is_struct_param = record_op == op_struct_param;
    let printable = is_enum or is_enum_runtime or is_struct_param;
    if !printable {
        return code_eval_unsupported(next_value);
    }
    let op_print = code_op_print();
    try code.append(op_print);
    try code.append(value_id);
    try code.append(kind);
    return code_eval_value(value_id, next_value);
}

fn lower_code_return_with_defers(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    defer_records: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if code_return_value_is_error_call(text, ast, value) {
        return try lower_code_return(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let defer_eval = try lower_code_defer_range_for_exit(code, kinds, defer_records, 0, next_value);
    if !defer_eval.ok {
        return code_eval_unsupported(defer_eval.next);
    }
    return try lower_code_return(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, defer_eval.next);
}

fn code_return_value_is_error_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(value);
    return match node.data {
        Call(call_node) => code_call_is_error(text, ast, call_node.callee),
        _ => false,
    };
}

fn code_call_is_error(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> bool {
    return std::mem::equal_bytes(ast_node_text(text, ast, callee), "error");
}

fn lower_code_return(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(value);
    return match node.data {
        Empty => try lower_code_return_void(code, next_value),
        Call(call_node) => try lower_code_return_call(text, ast, decls, value, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        StructLiteralExpr(struct_lit) => try lower_code_return_struct_literal(text, ast, decls, struct_lit.type_name, struct_lit.fields, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => try lower_code_return_value(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
    };
}

fn lower_code_return_void(
    code: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_ret_void = code_op_ret_void();
    try code.append(op_ret_void);
    return code_eval_value(0, next_value);
}

// lower_code_return_call splits a 'return <call>' between the error-union failure
// builtin ('return error("msg")') and an ordinary i64-returning call: 'error' is
// not a declared function, so it never reaches the normal call lowering.
fn lower_code_return_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "error") {
        return try lower_code_return_error(text, ast, args, code, kinds, next_value);
    }
    return try lower_code_return_value(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

// lower_code_return_error lowers 'return error("msg")': the message string literal
// lowers to a CONST_STR value (its '@.kizu.run.s<id>' global is rendered with the
// other string globals) and the RET_ERR_FAIL record carries that value id.
fn lower_code_return_error(
    text: []u8,
    ast: std::kizu::ast::Ast,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let eval = try lower_code_string(text, ast, arg, code, kinds, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let op_ret_err_fail = code_op_ret_err_fail();
    try code.append(op_ret_err_fail);
    try code.append(eval.value_id);
    return code_eval_value(0, eval.next);
}

fn lower_code_return_struct_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let lit_eval = try lower_code_struct_literal(text, ast, decls, type_name, fields, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !lit_eval.ok {
        return code_eval_unsupported(lit_eval.next);
    }
    let lit_kind = try kinds.get(lit_eval.value_id);
    let record_base = code_kind_struct_base();
    if lit_kind < record_base {
        return code_eval_unsupported(lit_eval.next);
    }
    let lit_record_pos = lit_kind - record_base;
    let pack_eval = try lower_code_struct_return_pack(text, ast, type_name, lit_record_pos, code, kinds, args_scratch, lit_eval.next);
    if !pack_eval.ok {
        return code_eval_unsupported(pack_eval.next);
    }
    let op_ret_value = code_op_ret_value();
    try code.append(op_ret_value);
    try code.append(pack_eval.value_id);
    return code_eval_value(pack_eval.value_id, pack_eval.next);
}

fn lower_code_struct_return_pack(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_name: std::kizu::ast::NodeId,
    lit_record_pos: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let type_span = code_node_span(text, ast, type_name);
    return try lower_code_struct_pack_from_span(text, type_span.start, type_span.end, lit_record_pos, code, kinds, args_scratch, next_value);
}

fn lower_code_struct_pack_from_span(
    text: []u8,
    type_start: i64,
    type_end: i64,
    lit_record_pos: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let decl_pos = try struct_decl_pos_by_span(text, code, type_start, type_end, 0);
    if decl_pos < 0 {
        return code_eval_unsupported(next_value);
    }
    let record_base = code_kind_struct_base();
    let source_kind = record_base + lit_record_pos;
    let no_source_value = 0 - 1;
    return try lower_code_struct_pack_from_decl(text, decl_pos, no_source_value, source_kind, code, kinds, args_scratch, next_value);
}

fn lower_code_struct_pack_from_decl(
    text: []u8,
    decl_pos: i64,
    source_value: i64,
    source_kind: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    if source_kind < record_base {
        return code_eval_unsupported(next_value);
    }
    let source_record_pos = source_kind - record_base;
    let field_count = try code.get(decl_pos + 3);
    let source_count = try code_struct_source_field_count(code, source_record_pos);
    if field_count != source_count {
        return code_eval_unsupported(next_value);
    }
    let scratch_base = try args_scratch.get(0);
    let scratch_bound = scratch_base + field_count;
    try args_scratch.set(0, scratch_bound);
    let fields_eval = try prepare_code_struct_pack_fields(text, code, kinds, decl_pos, source_value, source_kind, field_count, args_scratch, scratch_base, 0, next_value);
    if !fields_eval.ok {
        return try code_eval_unsupported_after_scratch_reset(args_scratch, scratch_base, fields_eval.next);
    }
    let op_pack = code_op_struct_pack();
    try code.append(op_pack);
    try code.append(fields_eval.next);
    try code.append(decl_pos);
    try code.append(field_count);
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    let struct_kind = record_base + decl_pos;
    try kinds.append(struct_kind);
    let result_value = fields_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn code_struct_source_field_count(
    code: &var std::array::Array<i64>,
    source_record_pos: i64
) -> !i64 {
    let op = try code.get(source_record_pos);
    let field_count = try code.get(source_record_pos + 4);
    let op_struct_lit = code_op_struct_lit();
    if op == op_struct_lit {
        return field_count;
    }
    let op_var_struct = code_op_var_struct();
    if op == op_var_struct {
        return field_count;
    }
    return 0 - 1;
}

fn prepare_code_struct_pack_fields(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    decl_pos: i64,
    source_value: i64,
    source_kind: i64,
    field_count: i64,
    args_scratch: &var std::array::Array<i64>,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= field_count {
        return code_eval_value(0, next_value);
    }
    let entry_slots = index * 3;
    let entry_pos = decl_pos + 4 + entry_slots;
    let name_start = try code.get(entry_pos);
    let name_end = try code.get(entry_pos + 1);
    let field_kind = try code.get(entry_pos + 2);
    let raw_eval = try lower_code_source_struct_field_value(text, code, kinds, source_value, source_kind, name_start, name_end, next_value);
    if !raw_eval.ok {
        return code_eval_unsupported(raw_eval.next);
    }
    let field_eval = try code_struct_pack_field_payload_value(text, code, kinds, raw_eval.value_id, field_kind, args_scratch, raw_eval.next);
    if !field_eval.ok {
        return code_eval_unsupported(field_eval.next);
    }
    let value_pos = scratch_base + index;
    try scratch_put(args_scratch, value_pos, field_eval.value_id);
    let after = index + 1;
    return try prepare_code_struct_pack_fields(text, code, kinds, decl_pos, source_value, source_kind, field_count, args_scratch, scratch_base, after, field_eval.next);
}

fn code_struct_pack_field_payload_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    raw_value: i64,
    field_kind: i64,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    if field_kind >= record_base {
        return try code_struct_pack_record_field_payload_value(text, code, kinds, raw_value, field_kind, args_scratch, next_value);
    }
    let slice_kind = code_kind_slice();
    if field_kind == slice_kind {
        return try code_arena_struct_slice_field_payload_value(text, code, kinds, raw_value, next_value);
    }
    let raw_kind = try kinds.get(raw_value);
    if raw_kind != field_kind {
        return code_eval_unsupported(next_value);
    }
    return code_eval_value(raw_value, next_value);
}

fn code_struct_pack_record_field_payload_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    raw_value: i64,
    field_kind: i64,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let raw_kind = try kinds.get(raw_value);
    let record_base = code_kind_struct_base();
    if raw_kind < record_base {
        return code_eval_unsupported(next_value);
    }
    let raw_record_pos = raw_kind - record_base;
    let raw_op = try code.get(raw_record_pos);
    let op_struct_decl = code_op_struct_decl();
    let raw_decl_mismatch = raw_op == op_struct_decl and raw_kind != field_kind;
    if raw_decl_mismatch {
        return code_eval_unsupported(next_value);
    }
    if raw_op == op_struct_decl {
        return code_eval_value(raw_value, next_value);
    }
    let op_struct_lit = code_op_struct_lit();
    let op_var_struct = code_op_var_struct();
    let raw_packable = raw_op == op_struct_lit or raw_op == op_var_struct;
    if !raw_packable {
        return code_eval_unsupported(next_value);
    }
    let decl_pos = field_kind - record_base;
    return try lower_code_struct_pack_from_decl(text, decl_pos, raw_value, raw_kind, code, kinds, args_scratch, next_value);
}

fn lower_code_return_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    // A return is a function boundary like a call argument: a UNION_CONST value
    // packs into the runtime union aggregate before the terminator records it.
    let stored_eval = try lower_code_arg_value(text, code, kinds, args_scratch, eval.value_id, eval.next);
    if !stored_eval.ok {
        return code_eval_unsupported(stored_eval.next);
    }
    let op_ret_value = code_op_ret_value();
    try code.append(op_ret_value);
    try code.append(stored_eval.value_id);
    return code_eval_value(stored_eval.value_id, stored_eval.next);
}

// code_local_lookup resolves a name against this function's locals (down to
// locals_base) and returns the bound value id, or -1 when the name is unbound.
// The scan walks backward so the newest binding wins: an inner-scope shadowing
// binding resolves while its block is open, and once scrub_code_locals blanks
// it the outer binding resolves again.
fn code_local_lookup(
    text: []u8,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let last = local_starts.len() - 1;
    return try code_local_lookup_from(text, local_starts, local_ends, local_values, locals_base, last, name_start, name_end);
}

// code_scope_lookup resolves a name against one open scope only (the bindings at
// or above scope_base), backing the same-scope duplicate-let rejection.
fn code_scope_lookup(
    text: []u8,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    scope_base: i64,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let last = local_starts.len() - 1;
    return try code_local_lookup_from(text, local_starts, local_ends, local_values, scope_base, last, name_start, name_end);
}

// code_local_lookup_from walks the locals backward from index down to floor.
fn code_local_lookup_from(
    text: []u8,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    floor: i64,
    index: i64,
    name_start: i64,
    name_end: i64
) -> !i64 {
    if index < floor {
        return 0 - 1;
    }
    let bound_start = try local_starts.get(index);
    let bound_end = try local_ends.get(index);
    let bound_name = text[bound_start..bound_end];
    let name = text[name_start..name_end];
    let before = index - 1;
    if !std::mem::equal_bytes(bound_name, name) {
        return try code_local_lookup_from(text, local_starts, local_ends, local_values, floor, before, name_start, name_end);
    }
    let bound_value = try local_values.get(index);
    return bound_value;
}

fn lower_code_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(node_id);
    return match node.data {
        Int(int_node) => try lower_code_int(text, ast, node_id, code, kinds, next_value),
        String(string_node) => try lower_code_string(text, ast, node_id, code, kinds, next_value),
        Bool(bool_node) => try lower_code_bool(text, ast, node_id, code, kinds, next_value),
        Var(var_node) => try lower_code_var(text, ast, node_id, code, kinds, local_starts, local_ends, local_values, locals_base, next_value),
        CastExpr(cast_expr) => try lower_code_cast(text, ast, decls, cast_expr.type_node, cast_expr.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Prefix(prefix_node) => try lower_code_prefix(text, ast, decls, prefix_node.op, prefix_node.right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Binary(binary) => try lower_code_binary(text, ast, decls, binary.op, binary.left, binary.right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Call(call_node) => try lower_code_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        FieldExpr(field_expr) => try lower_code_field_expr(text, ast, decls, node_id, field_expr.receiver, field_expr.name, field_expr.namespace, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        StructLiteralExpr(struct_lit) => try lower_code_struct_literal(text, ast, decls, struct_lit.type_name, struct_lit.fields, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        TryExpr(try_expr) => try lower_code_try_expr(text, ast, decls, try_expr.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        If(if_node) => try lower_code_if_expr(text, ast, decls, if_node.condition, if_node.then_block, if_node.else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Match(match_node) => try lower_code_match_expr(text, ast, decls, match_node.value, match_node.arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        IndexExpr(index_expr) => try lower_code_index(text, ast, decls, index_expr.target, index_expr.start, index_expr.end, index_expr.slice, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        // A read deref '<expr>.*' over a value-model read borrow '&T' is an
        // identity (the dual of the read borrow arm in lower_code_prefix). Over a
        // mutable scalar borrow '&var i64' (a 'ptr' value), it instead loads the
        // pointee i64. lower_code_deref_read picks the right form from the
        // receiver's kind. Write-back through '<expr>.* =' is an assignment target,
        // handled in lower_code_assign, not this read path.
        DerefExpr(deref_expr) => try lower_code_deref_read(text, ast, decls, deref_expr.receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_deref_read lowers '<receiver>.*': the receiver lowers first, then a
// mutable scalar borrow ('&var i64', a 'ptr' value) loads its pointee through
// PTR_LOAD, a mutable slice borrow ('&var []u8') through PTR_LOAD_SLICE, while
// every other kind keeps the value-model identity.
fn lower_code_deref_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let receiver_kind = try kinds.get(eval.value_id);
    if code_kind_is_mut_borrow_scalar(receiver_kind) {
        return try emit_code_ptr_load(eval.value_id, code, kinds, eval.next);
    }
    if code_kind_is_mut_borrow_slice(receiver_kind) {
        return try emit_code_ptr_load_slice(eval.value_id, code, kinds, eval.next);
    }
    return code_eval_value(eval.value_id, eval.next);
}

fn lower_code_int(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let literal_text = ast_node_text(text, ast, node_id);
    let literal = try parse_int_literal(literal_text);
    let op_const = code_op_const_int();
    try code.append(op_const);
    try code.append(next_value);
    try code.append(literal);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// lower_code_string lowers a string literal (a quoted one-line literal or a
// '\\'-prefixed multiline literal) to a CONST_STR record. The record is
// 'op dst seg_count start1 end1 ... startN endN': each segment is a raw source
// payload span and the renderer joins consecutive segments with one newline byte,
// matching the reference lexer's decoded multiline payload.
fn lower_code_string(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(node_id);
    let span_start = node.span.start;
    let span_end = node.span.end;
    if is_multiline_literal(text, span_start, span_end) {
        return try lower_code_multiline_string(text, span_start, span_end, code, kinds, next_value);
    }
    let payload = string_literal_span(text, ast, node_id);
    if payload.start < 0 {
        return code_eval_unsupported(next_value);
    }
    let op_const_str = code_op_const_str();
    let one_segment = 1;
    try code.append(op_const_str);
    try code.append(next_value);
    try code.append(one_segment);
    try code.append(payload.start);
    try code.append(payload.end);
    let kind_str = code_kind_str();
    try kinds.append(kind_str);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// is_multiline_literal reports whether the literal span starts with the '\\'
// multiline marker (two backslash bytes).
fn is_multiline_literal(text: []u8, start: i64, end: i64) -> bool {
    if end - start < 2 {
        return false;
    }
    let backslash = cast<u8>(92);
    if text[start] != backslash {
        return false;
    }
    return text[start + 1] == backslash;
}

// lower_code_multiline_string lowers a '\\'-prefixed multiline literal: every
// '\\' line contributes one payload span segment to the CONST_STR record.
fn lower_code_multiline_string(
    text: []u8,
    span_start: i64,
    span_end: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let seg_count = multiline_segment_count(text, span_start, span_end);
    if seg_count <= 0 {
        return code_eval_unsupported(next_value);
    }
    let op_const_str = code_op_const_str();
    try code.append(op_const_str);
    try code.append(next_value);
    try code.append(seg_count);
    try append_multiline_segments(text, span_start, span_end, code);
    let kind_str = code_kind_str();
    try kinds.append(kind_str);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// multiline_segment_count walks the literal's '\\' lines and returns how many
// segments it contains, or 0 when the shape or a payload byte is unsupported.
fn multiline_segment_count(text: []u8, span_start: i64, span_end: i64) -> i64 {
    return multiline_count_from(text, span_start, span_end, 0);
}

// multiline_count_from counts the segments from the '\\' marker at marker_pos to
// the end of the literal span (0 on an unsupported payload byte or marker shape).
fn multiline_count_from(
    text: []u8,
    marker_pos: i64,
    span_end: i64,
    count: i64
) -> i64 {
    let seg_start = marker_pos + 2;
    let seg_end = multiline_segment_line_end(text, seg_start, span_end);
    let payload = text[seg_start..seg_end];
    if !is_multiline_payload_supported(payload) {
        return 0;
    }
    let next = multiline_next_segment(text, seg_end, span_end);
    let total = count + 1;
    if next == 0 - 1 {
        return total;
    }
    if next < 0 {
        return 0;
    }
    return multiline_count_from(text, next, span_end, total);
}

// append_multiline_segments appends each segment's payload span (start then end)
// to the CONST_STR record from the '\\' marker at marker_pos, mirroring the
// multiline_count_from walk (which already validated every segment).
fn append_multiline_segments(
    text: []u8,
    marker_pos: i64,
    span_end: i64,
    code: &var std::array::Array<i64>
) -> !void {
    let seg_start = marker_pos + 2;
    let seg_end = multiline_segment_line_end(text, seg_start, span_end);
    try code.append(seg_start);
    try code.append(seg_end);
    let next = multiline_next_segment(text, seg_end, span_end);
    if next < 0 {
        return;
    }
    try append_multiline_segments(text, next, span_end, code);
    return;
}

// multiline_segment_line_end returns the segment's payload end: the next newline
// byte at or after pos inside the literal span, or the span end for the final line.
fn multiline_segment_line_end(text: []u8, pos: i64, span_end: i64) -> i64 {
    if pos >= span_end {
        return span_end;
    }
    let newline = cast<u8>(10);
    if text[pos] == newline {
        return pos;
    }
    let after = pos + 1;
    return multiline_segment_line_end(text, after, span_end);
}

// multiline_next_segment returns the next segment's '\\' position after a line's
// newline, -1 at the clean end of the literal, or -2 on an unexpected byte.
fn multiline_next_segment(text: []u8, line_end: i64, span_end: i64) -> i64 {
    if line_end >= span_end {
        return 0 - 1;
    }
    let after_newline = line_end + 1;
    let pos = skip_multiline_indent(text, after_newline, span_end);
    let marker_end = pos + 1;
    if marker_end >= span_end {
        return 0 - 2;
    }
    let backslash = cast<u8>(92);
    if text[pos] != backslash or text[pos + 1] != backslash {
        return 0 - 2;
    }
    return pos;
}

// skip_multiline_indent returns the first position at or after pos whose byte is
// not the whitespace the lexer skips between a line's newline and the next '\\'.
fn skip_multiline_indent(text: []u8, pos: i64, span_end: i64) -> i64 {
    if pos >= span_end {
        return pos;
    }
    if !is_multiline_indent_byte(text[pos]) {
        return pos;
    }
    let after = pos + 1;
    return skip_multiline_indent(text, after, span_end);
}

// is_multiline_indent_byte reports whether byte is the whitespace the lexer skips
// between a multiline line's newline and the next '\\' marker.
fn is_multiline_indent_byte(byte: u8) -> bool {
    let space = cast<u8>(32);
    let tab = cast<u8>(9);
    let carriage = cast<u8>(13);
    return byte == space or byte == tab or byte == carriage;
}

// is_multiline_payload_supported accepts printable ASCII segment bytes; the quote
// byte is allowed because the CONST_STR renderer escapes it, and the empty payload
// of a blank '\\' line is accepted without iteration.
fn is_multiline_payload_supported(payload: []u8) -> bool {
    var index = 0;
    let min = cast<u8>(32);
    let max = cast<u8>(126);
    while index < std::mem::len(payload) {
        let byte = payload[index];
        if byte < min {
            return false;
        }
        if byte > max {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// lower_code_bool lowers a 'true'/'false' literal to a CONST_BOOL record producing
// an i1 value (kind bool); the literal lands on the tape as 1 or 0.
fn lower_code_bool(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let literal_text = ast_node_text(text, ast, node_id);
    let literal = code_bool_literal(literal_text);
    let op_const_bool = code_op_const_bool();
    try code.append(op_const_bool);
    try code.append(next_value);
    try code.append(literal);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// code_bool_literal maps a bool literal's source text to its tape value (1 for
// 'true', 0 otherwise).
fn code_bool_literal(literal_text: []u8) -> i64 {
    if std::mem::equal_bytes(literal_text, "true") {
        return 1;
    }
    return 0;
}

// lower_code_prefix lowers a prefix expression; the tape owns logical not ('!')
// of an i1 operand only (negation and borrows are not owned yet).
fn lower_code_prefix(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    op: std::kizu::ast::PrefixOp,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if op == std::kizu::ast::prefix_not() {
        return try lower_code_not(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    // A read borrow '&<expr>' evaluates to the same value (and kind) as the
    // operand it borrows: the tape is a value model, so a read-only borrow is
    // an identity on the value side. The mutable borrow '&var <expr>' keeps the
    // write-back semantics that this pass does not model, so it stays
    // unsupported and falls through to the diagnostic below.
    if op == std::kizu::ast::prefix_borrow() {
        return try lower_code_expr(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    // A mutable borrow '&var <var>' lowers by referent ABI: i64/[]u8 vars pass
    // the address of the caller slot, while owned String handles pass the handle
    // value because its runtime methods mutate storage behind the handle. Other
    // operands stay unsupported and fall through to the diagnostic.
    if op == std::kizu::ast::prefix_mut_borrow() {
        return try lower_code_mut_borrow_value(text, ast, right, code, kinds, local_starts, local_ends, local_values, locals_base, next_value);
    }
    // A unary minus '-<expr>' lowers as '0 - <expr>' through the existing BINARY
    // sub path, so the renderer needs no change. A bool/slice operand has no i64
    // temp and stays unsupported (handled inside lower_code_neg).
    if op == std::kizu::ast::prefix_neg() {
        return try lower_code_neg(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

// lower_code_neg lowers a unary minus '-<operand>' as '0 - <operand>': it first
// emits a const-0 i64 (the same CONST_INT record lower_code_int emits) as the sub
// record's left operand, lowers the operand as the right, guards that the operand
// is i64-like (the BINARY record types both operands as i64, so a bool/slice
// operand is not owned by it -- the same guard lower_code_binary uses), then emits
// the BINARY sub record (kind 2) with an i64 result. Values thread exactly as
// lower_code_binary threads its two operands, so '-x', '-f()', '-5 + 3', and
// 'return -7' all flow through this one general form -- no source-literal folding.
fn lower_code_neg(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    // Emit the const-0 left operand: op, value id, literal 0, kind i64.
    let op_const = code_op_const_int();
    let zero_literal = 0;
    try code.append(op_const);
    try code.append(next_value);
    try code.append(zero_literal);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let zero_value = next_value;
    let after_zero = next_value + 1;
    // Lower the operand as the right side, starting after the const-0 value.
    let operand_eval = try lower_code_expr(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, after_zero);
    if !operand_eval.ok {
        return code_eval_unsupported(operand_eval.next);
    }
    let operand_kind = try kinds.get(operand_eval.value_id);
    let operand_i64_like = try code_operand_is_i64_like(code, operand_kind);
    if !operand_i64_like {
        return code_eval_unsupported(operand_eval.next);
    }
    // Emit the BINARY sub record (kind 2): op, result value, kind, left (const 0),
    // right (operand). The result is i64.
    let op_binary = code_op_binary();
    let sub_kind = 2;
    try code.append(op_binary);
    try code.append(operand_eval.next);
    try code.append(sub_kind);
    try code.append(zero_value);
    try code.append(operand_eval.value_id);
    try kinds.append(kind_i64);
    let result_value = operand_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_mut_borrow_value lowers '&var <var>' by the referent's storage ABI:
// i64 and []u8 vars resolve to alloca-slot addresses (VAR_ADDR/VAR_ADDR_SLICE),
// while owned String handles keep their value ABI because append/clear mutate the
// runtime object behind the handle. A non-addressable operand stays unsupported,
// the same safe fallback the value model used before.
fn lower_code_mut_borrow_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let slice_slot = try code_slice_var_slot_of(text, ast, right, local_starts, local_ends, local_values, locals_base);
    if slice_slot >= 0 {
        return try emit_code_var_addr_slice(slice_slot, code, kinds, next_value);
    }
    let slot = try code_var_slot_of(text, ast, right, local_starts, local_ends, local_values, locals_base);
    if slot >= 0 {
        return try emit_code_var_addr(slot, code, kinds, next_value);
    }
    return try lower_code_mut_borrow_owned_string_handle(text, ast, right, code, kinds, local_starts, local_ends, local_values, locals_base, next_value);
}

// lower_code_mut_borrow_owned_string_handle accepts '&var <local String>' without
// adding a pointer slot: '%kizu.owned' carries the address of the runtime string
// object, and String mutation ops update that object. Reassigning through the
// borrow remains unsupported by the assignment path; this only enables interior
// String mutation methods such as append_bytes and clear.
fn lower_code_mut_borrow_owned_string_handle(
    text: []u8,
    ast: std::kizu::ast::Ast,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_var(text, ast, right, code, kinds, local_starts, local_ends, local_values, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let kind = try kinds.get(eval.value_id);
    if kind != code_kind_owned_string() {
        return code_eval_unsupported(eval.next);
    }
    return eval;
}

// emit_code_var_addr appends a VAR_ADDR record producing the address of a var
// slot as a 'ptr' value (kind code_kind_mut_borrow_i64).
fn emit_code_var_addr(
    slot: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_var_addr = code_op_var_addr();
    try code.append(op_var_addr);
    try code.append(next_value);
    try code.append(slot);
    let mut_borrow_kind = code_kind_mut_borrow_i64();
    try kinds.append(mut_borrow_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// emit_code_ptr_load appends a PTR_LOAD reading an i64 through a '&var i64'
// pointer value, producing a fresh i64 value.
fn emit_code_ptr_load(
    ptr_value: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_ptr_load = code_op_ptr_load();
    try code.append(op_ptr_load);
    try code.append(next_value);
    try code.append(ptr_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// emit_code_ptr_store appends a PTR_STORE writing an i64 value through a
// '&var i64' pointer value. It yields no new SSA value (like VAR_STORE).
fn emit_code_ptr_store(
    ptr_value: i64,
    value_id: i64,
    code: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_ptr_store = code_op_ptr_store();
    try code.append(op_ptr_store);
    try code.append(ptr_value);
    try code.append(value_id);
    return code_eval_value(value_id, next_value);
}

// emit_code_var_addr_slice appends a VAR_ADDR_SLICE record producing the address
// of a slice var slot as a 'ptr' value (kind code_kind_mut_borrow_slice).
fn emit_code_var_addr_slice(
    slot: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_var_addr_slice = code_op_var_addr_slice();
    try code.append(op_var_addr_slice);
    try code.append(next_value);
    try code.append(slot);
    let mut_borrow_kind = code_kind_mut_borrow_slice();
    try kinds.append(mut_borrow_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// emit_code_ptr_load_slice appends a PTR_LOAD_SLICE reading a '%kizu.slice.u8'
// value through a '&var []u8' pointer value, producing a fresh slice value.
fn emit_code_ptr_load_slice(
    ptr_value: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_ptr_load_slice = code_op_ptr_load_slice();
    try code.append(op_ptr_load_slice);
    try code.append(next_value);
    try code.append(ptr_value);
    let kind_slice = code_kind_slice();
    try kinds.append(kind_slice);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// emit_code_ptr_store_slice appends a PTR_STORE_SLICE writing a slice value
// through a '&var []u8' pointer value. It yields no new SSA value (like
// VAR_STORE_SLICE).
fn emit_code_ptr_store_slice(
    ptr_value: i64,
    value_id: i64,
    code: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_ptr_store_slice = code_op_ptr_store_slice();
    try code.append(op_ptr_store_slice);
    try code.append(ptr_value);
    try code.append(value_id);
    return code_eval_value(value_id, next_value);
}

// lower_code_not lowers '!<expr>': the operand lowers to an i1 value and the NOT
// record produces its negation in a fresh value (kind bool).
fn lower_code_not(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let operand_eval = try lower_code_expr(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !operand_eval.ok {
        return code_eval_unsupported(operand_eval.next);
    }
    let operand_kind = try kinds.get(operand_eval.value_id);
    let kind_bool = code_kind_bool();
    if operand_kind != kind_bool {
        return code_eval_unsupported(operand_eval.next);
    }
    let op_not = code_op_not();
    try code.append(op_not);
    try code.append(operand_eval.next);
    try code.append(operand_eval.value_id);
    try kinds.append(kind_bool);
    let result_value = operand_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_var(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let name_span = code_node_span(text, ast, node_id);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    if bound < 0 {
        return code_eval_unsupported(next_value);
    }
    // A var local lives in an alloca slot: emit a VAR_LOAD into a fresh value so
    // each read observes the latest stored value. A slice var slot loads through
    // VAR_LOAD_SLICE instead. Both slots are computed before their guard (binding
    // the subtraction to a local) and each emission is its own helper, so every
    // guard stays a single-statement 'return try <call>' whose arg is a plain
    // local -- the shape the compiled call-arg lowering models.
    let slice_base = code_slice_var_slot_base();
    let slice_slot = bound - slice_base;
    if code_local_is_slice_slot(bound) {
        return try emit_code_var_load_slice(slice_slot, code, kinds, next_value);
    }
    let base = code_var_slot_base();
    let slot = bound - base;
    if bound >= base {
        return try emit_code_var_load(slot, code, kinds, next_value);
    }
    return code_eval_value(bound, next_value);
}

// lower_code_cast keeps checked casts as their operand value. The
// frontend/checker owns target validity; typed consumers validate the operand
// kind and truncate where needed, such as append_byte's i8 boundary.
fn lower_code_cast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_node: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    return code_eval_value(eval.value_id, eval.next);
}

// lower_code_struct_literal scalarizes a struct literal: every field initializer
// lowers to its own tape value (through the same scratch-stack frames call
// arguments use), then the STRUCT_LIT record stores each field's name span and
// value id. The literal's own value renders nothing -- its kinds entry stores
// the record position so field reads resolve through it.
fn lower_code_struct_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let scratch_base = try args_scratch.get(0);
    let fields_eval = try lower_code_struct_fields(text, ast, decls, fields, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, 0, next_value);
    if !fields_eval.ok {
        return code_eval_unsupported(fields_eval.next);
    }
    let record_pos = code.len();
    let op_struct_lit = code_op_struct_lit();
    let type_span = code_node_span(text, ast, type_name);
    try code.append(op_struct_lit);
    try code.append(fields_eval.next);
    try code.append(type_span.start);
    try code.append(type_span.end);
    try code.append(fields.len);
    // The fields walk left [name_start, name_end, value] per field on the
    // scratch frame, so the record copies the frame verbatim.
    let entry_slots = fields.len * 3;
    let scratch_bound = scratch_base + entry_slots;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    let struct_base = code_kind_struct_base();
    let struct_kind = struct_base + record_pos;
    try kinds.append(struct_kind);
    let result_value = fields_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_struct_fields lowers each field initializer into the literal's
// scratch frame: field i owns slots [scratch_base + 3i, scratch_base + 3i + 2]
// holding its name span start, name span end, and lowered value id, mirroring
// the call-argument stack discipline so nested literals and calls keep their
// frames.
fn lower_code_struct_fields(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    fields: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= fields.len {
        return code_eval_value(0, next_value);
    }
    let field = try ast.child_at(fields, index);
    let eval = try lower_code_struct_field_node(text, ast, decls, field, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, index, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_struct_fields(text, ast, decls, fields, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, after, eval.next);
}

fn lower_code_struct_field_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    field: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(field);
    return match node.data {
        StructFieldInit(init) => try lower_code_struct_field(text, ast, decls, init.name, init.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, index, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_struct_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let entry_slots = index * 3;
    let entry_base = scratch_base + entry_slots;
    let name_end_slot = entry_base + 1;
    let value_slot = entry_base + 2;
    let next_free = value_slot + 1;
    try args_scratch.set(0, next_free);
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let name_span = code_node_span(text, ast, name);
    try scratch_put(args_scratch, entry_base, name_span.start);
    try scratch_put(args_scratch, name_end_slot, name_span.end);
    try scratch_put(args_scratch, value_slot, eval.value_id);
    return code_eval_value(eval.value_id, eval.next);
}

// lower_code_field_expr resolves a '.' field read at lowering time: struct
// literals and var-struct locals resolve to their field values/slots, while
// single-field struct parameters validate the field against the receiver's
// STRUCT_PARAM metadata and reuse the receiver ABI value. A namespaced
// 'Enum::Variant' read lowers to its ENUM_CONST tag instead.
fn lower_code_field_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return try lower_code_enum_const(text, ast, decls, node_id, receiver, name, code, kinds, next_value);
    }
    let arena_get_receiver = try code_field_receiver_is_runtime_arena_get(text, ast, decls, code, receiver);
    if arena_get_receiver {
        return try lower_code_runtime_arena_get_field_receiver(text, ast, decls, receiver, name, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let base_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !base_eval.ok {
        return code_eval_unsupported(base_eval.next);
    }
    let base_kind = try kinds.get(base_eval.value_id);
    if base_kind == code_kind_slice() {
        return code_eval_value(base_eval.value_id, base_eval.next);
    }
    if base_kind == code_kind_fs_metadata() {
        return try lower_code_fs_metadata_field(text, ast, name, code, kinds, base_eval.value_id, base_eval.next);
    }
    let struct_base = code_kind_struct_base();
    if base_kind < struct_base {
        return code_eval_unsupported(base_eval.next);
    }
    let record_pos = base_kind - struct_base;
    let record_op = try code.get(record_pos);
    let op_var_struct = code_op_var_struct();
    if record_op == op_var_struct {
        return try lower_code_var_struct_read(text, ast, name, code, kinds, record_pos, base_eval.next);
    }
    let op_struct_param = code_op_struct_param();
    if record_op == op_struct_param {
        return try lower_code_struct_param_field_read(text, ast, name, code, record_pos, base_eval.value_id, base_eval.next);
    }
    let op_struct_decl = code_op_struct_decl();
    if record_op == op_struct_decl {
        return try lower_code_struct_decl_field_read(text, ast, name, code, kinds, record_pos, base_eval.value_id, base_eval.next);
    }
    let op_struct_lit = code_op_struct_lit();
    if record_op != op_struct_lit {
        return code_eval_unsupported(base_eval.next);
    }
    let count_pos = record_pos + 4;
    let field_count = try code.get(count_pos);
    let name_span = code_node_span(text, ast, name);
    let field_value = try struct_record_field(text, code, record_pos, field_count, name_span.start, name_span.end, 0);
    if field_value < 0 {
        return code_eval_unsupported(base_eval.next);
    }
    return code_eval_value(field_value, base_eval.next);
}

fn lower_code_struct_param_field_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let count_pos = record_pos + 1;
    let field_count = try code.get(count_pos);
    let name_span = code_node_span(text, ast, name);
    let field_kind = try struct_param_record_field_kind(text, code, record_pos, field_count, name_span.start, name_span.end, 0);
    if field_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    return code_eval_value(value_id, next_value);
}

fn lower_code_struct_decl_field_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    record_pos: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let count_pos = record_pos + 3;
    let field_count = try code.get(count_pos);
    let name_span = code_node_span(text, ast, name);
    return try lower_code_struct_decl_field_read_by_count(text, code, kinds, record_pos, value_id, field_count, name_span.start, name_span.end, next_value);
}

fn lower_code_struct_decl_field_read_by_span(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    record_pos: i64,
    value_id: i64,
    name_start: i64,
    name_end: i64,
    next_value: i64
) -> !CodeEval {
    let count_pos = record_pos + 3;
    let field_count = try code.get(count_pos);
    return try lower_code_struct_decl_field_read_by_count(text, code, kinds, record_pos, value_id, field_count, name_start, name_end, next_value);
}

fn lower_code_struct_decl_field_read_by_count(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    record_pos: i64,
    value_id: i64,
    field_count: i64,
    name_start: i64,
    name_end: i64,
    next_value: i64
) -> !CodeEval {
    let field_index = try struct_decl_record_field_index(text, code, record_pos, field_count, name_start, name_end, 0);
    if field_index < 0 {
        return code_eval_unsupported(next_value);
    }
    let field_kind = try struct_decl_record_field_kind(code, record_pos, field_index);
    let op_field = code_op_struct_field();
    try code.append(op_field);
    try code.append(next_value);
    try code.append(value_id);
    try code.append(record_pos);
    try code.append(field_index);
    try kinds.append(field_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn struct_decl_record_field_index(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= field_count {
        return 0 - 1;
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 4 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_name_end = try code.get(entry_pos + 1);
    let entry_name = text[entry_name_start..entry_name_end];
    let wanted = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, wanted) {
        return try struct_decl_record_field_index(text, code, record_pos, field_count, name_start, name_end, after);
    }
    return index;
}

fn struct_decl_record_field_kind(
    code: &var std::array::Array<i64>,
    record_pos: i64,
    field_index: i64
) -> !i64 {
    let entry_slots = field_index * 3;
    let entry_pos = record_pos + 4 + entry_slots;
    let kind_pos = entry_pos + 2;
    let field_kind = try code.get(kind_pos);
    return field_kind;
}

fn struct_param_record_field_kind(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= field_count {
        return 0 - 1;
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 2 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let entry_name = text[entry_name_start..entry_name_end];
    let wanted = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, wanted) {
        return try struct_param_record_field_kind(text, code, record_pos, field_count, name_start, name_end, after);
    }
    let kind_pos = entry_pos + 2;
    let field_kind = try code.get(kind_pos);
    return field_kind;
}

fn code_field_receiver_is_runtime_arena_get(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    receiver: std::kizu::ast::NodeId
) -> !bool {
    let node = ast.get(receiver);
    return match node.data {
        Call(call_node) => try code_call_is_runtime_arena_get(text, ast, decls, code, call_node.callee),
        _ => false,
    };
}

fn code_call_is_runtime_arena_get(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    callee: std::kizu::ast::NodeId
) -> !bool {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try code_field_method_is_runtime_arena_get(text, ast, decls, code, field_expr.name, field_expr.namespace),
        _ => false,
    };
}

fn code_field_method_is_runtime_arena_get(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    name: std::kizu::ast::NodeId,
    namespace: bool
) -> !bool {
    if namespace {
        return false;
    }
    let method_kind = try code_field_method_return_kind(text, ast, decls, code, name, namespace);
    if method_kind != code_kind_missing() {
        return false;
    }
    let method = ast_node_text(text, ast, name);
    return std::mem::equal_bytes(method, "get");
}

fn lower_code_runtime_arena_get_field_receiver(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    field_name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(receiver);
    return match node.data {
        Call(call_node) => try lower_code_runtime_arena_get_field_call(text, ast, decls, call_node.callee, call_node.args, field_name, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_runtime_arena_get_field_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    field_name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_runtime_arena_get_field_method(text, ast, decls, field_expr.receiver, field_expr.namespace, args, field_name, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_runtime_arena_get_field_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    method_receiver: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    field_name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let receiver_eval = try lower_code_expr(text, ast, decls, method_receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    if !code_kind_is_arena(receiver_kind) {
        return code_eval_unsupported(receiver_eval.next);
    }
    let element_start = try code_arena_kind_element_span_part(code, receiver_kind, 0);
    if element_start < 0 {
        return try lower_code_arena_get_slice_struct_field(text, ast, decls, receiver_eval.value_id, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    let element_end = try code_arena_kind_element_span_part(code, receiver_kind, 1);
    if element_end < 0 {
        return code_eval_unsupported(receiver_eval.next);
    }
    let field_span = code_node_span(text, ast, field_name);
    let kind_part = code_arena_layout_part_kind();
    let layout_kind = try code_arena_struct_field_layout_part_by_span(text, ast, decls, element_start, element_end, field_span.start, field_span.end, kind_part, 0);
    if layout_kind < 0 {
        return code_eval_unsupported(receiver_eval.next);
    }
    let count_part = code_arena_layout_part_count();
    let layout_count = try code_arena_struct_field_layout_part_by_span(text, ast, decls, element_start, element_end, field_span.start, field_span.end, count_part, 0);
    let slice_kind = code_kind_slice();
    let single_slice = layout_count == 1 and layout_kind == slice_kind;
    if single_slice {
        return try lower_code_arena_get_slice_struct_field(text, ast, decls, receiver_eval.value_id, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    let offset_part = code_arena_layout_part_offset();
    let layout_offset = try code_arena_struct_field_layout_part_by_span(text, ast, decls, element_start, element_end, field_span.start, field_span.end, offset_part, 0);
    let size_part = code_arena_layout_part_size();
    let layout_size = try code_arena_struct_field_layout_part_by_span(text, ast, decls, element_start, element_end, field_span.start, field_span.end, size_part, 0);
    return try lower_code_arena_get_struct_field(text, ast, decls, receiver_eval.value_id, args, layout_offset, layout_size, layout_kind, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
}

// lower_code_var_struct_read loads a scalarized var-struct field from its slot
// into a fresh value, or returns a nested VAR_STRUCT value directly.
fn lower_code_var_struct_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    record_pos: i64,
    next_value: i64
) -> !CodeEval {
    let name_span = code_node_span(text, ast, name);
    let count_pos = record_pos + 4;
    let field_count = try code.get(count_pos);
    // 'field_entry' (not 'entry') keeps the binding clear of the function's
    // LLVM entry block label in the compiled value namespace.
    let field_entry = try var_struct_field_entry(text, code, record_pos, field_count, name_span.start, name_span.end, 0);
    if field_entry < 0 {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_var_struct_entry_value(code, kinds, field_entry, next_value);
}

fn lower_code_var_struct_entry_value(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    field_entry: i64,
    next_value: i64
) -> !CodeEval {
    let slot_pos = field_entry + 2;
    let slot_or_value = try code.get(slot_pos);
    let kind_pos = field_entry + 3;
    let slot_kind = try code.get(kind_pos);
    let record_base = code_kind_struct_base();
    if slot_kind >= record_base {
        return code_eval_value(slot_or_value, next_value);
    }
    let load_op = var_struct_load_op(slot_kind);
    try code.append(load_op);
    try code.append(next_value);
    try code.append(slot_or_value);
    try kinds.append(slot_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// var_struct_field_entry walks the VAR_STRUCT record's field entries and returns
// the matching entry's tape position (-1 when the record does not carry it).
fn var_struct_field_entry(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= field_count {
        return 0 - 1;
    }
    let entry_slots = index * 4;
    let entry_pos = record_pos + 5 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let entry_name = text[entry_name_start..entry_name_end];
    let name = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, name) {
        return try var_struct_field_entry(text, code, record_pos, field_count, name_start, name_end, after);
    }
    return entry_pos;
}

// var_struct_load_op / var_struct_store_op pick the slot trio matching a
// scalarized field's slot kind.
fn var_struct_load_op(slot_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if slot_kind == kind_i64 {
        return code_op_var_load();
    }
    let kind_bool = code_kind_bool();
    if slot_kind == kind_bool {
        return code_op_var_load_bool();
    }
    return code_op_var_load_slice();
}

fn var_struct_store_op(slot_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if slot_kind == kind_i64 {
        return code_op_var_store();
    }
    let kind_bool = code_kind_bool();
    if slot_kind == kind_bool {
        return code_op_var_store_bool();
    }
    return code_op_var_store_slice();
}

// lower_code_enum_const lowers 'Enum::Variant': the variant resolves to its
// declaration-order tag against the named enum declaration, and the ENUM_CONST
// record keeps the qualified and enum-name source spans so print renders the
// variant name and match arms resolve their patterns.
fn lower_code_enum_const(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let enum_span = code_node_span(text, ast, receiver);
    let variant_span = code_node_span(text, ast, name);
    let tag = try enum_variant_tag_lookup(text, ast, decls, enum_span.start, enum_span.end, variant_span.start, variant_span.end, 0);
    if tag < 0 {
        return try lower_code_union_const_read(text, ast, decls, node_id, enum_span.start, enum_span.end, variant_span.start, variant_span.end, code, kinds, next_value);
    }
    let qual_span = code_node_span(text, ast, node_id);
    let record_pos = code.len();
    let op_enum_const = code_op_enum_const();
    try code.append(op_enum_const);
    try code.append(next_value);
    try code.append(qual_span.start);
    try code.append(qual_span.end);
    try code.append(enum_span.start);
    try code.append(enum_span.end);
    try code.append(tag);
    let record_base = code_kind_struct_base();
    let record_kind = record_base + record_pos;
    try kinds.append(record_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// lower_code_union_const_read lowers a payload-less 'Union::Variant' read (the
// fallback when no enum declaration carries the variant): the UNION_CONST
// record stores -1 as its payload value id.
fn lower_code_union_const_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    union_start: i64,
    union_end: i64,
    var_start: i64,
    var_end: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let tag = try union_variant_tag_lookup(text, ast, decls, union_start, union_end, var_start, var_end, 0);
    if tag < 0 {
        return code_eval_unsupported(next_value);
    }
    let qual_span = code_node_span(text, ast, node_id);
    let no_payload = 0 - 1;
    return try lower_code_union_const(qual_span.start, qual_span.end, union_start, union_end, tag, no_payload, code, kinds, next_value);
}

// enum_variant_tag_lookup scans the top-level declarations for the enum whose
// name matches the receiver span and returns the named variant's
// declaration-order tag (-1 when no declaration carries it).
fn enum_variant_tag_lookup(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    enum_start: i64,
    enum_end: i64,
    var_start: i64,
    var_end: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let tag = try enum_decl_variant_tag(text, ast, child, enum_start, enum_end, var_start, var_end);
    let after = index + 1;
    if tag > 0 - 2 {
        return tag;
    }
    return try enum_variant_tag_lookup(text, ast, decls, enum_start, enum_end, var_start, var_end, after);
}

// enum_decl_variant_tag classifies one declaration against the enum name span:
// -2 = not the named enum (keep scanning), otherwise the variant's tag.
fn enum_decl_variant_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    enum_start: i64,
    enum_end: i64,
    var_start: i64,
    var_end: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        EnumDecl(enum_decl) => try enum_named_variant_tag(text, ast, enum_decl.name, enum_decl.tags, enum_start, enum_end, var_start, var_end),
        _ => code_decl_kind_skip(),
    };
}

fn enum_named_variant_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    tags: std::kizu::ast::ChildRange,
    enum_start: i64,
    enum_end: i64,
    var_start: i64,
    var_end: i64
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let enum_name = text[enum_start..enum_end];
    if !std::mem::equal_bytes(decl_name, enum_name) {
        return 0 - 2;
    }
    return try enum_tags_index(text, ast, tags, var_start, var_end, 0);
}

// enum_tags_index returns the declaration-order index of the named variant in
// the enum's tag list (-1 when the list does not carry it).
fn enum_tags_index(
    text: []u8,
    ast: std::kizu::ast::Ast,
    tags: std::kizu::ast::ChildRange,
    var_start: i64,
    var_end: i64,
    index: i64
) -> !i64 {
    if index >= tags.len {
        return 0 - 1;
    }
    let child = try ast.child_at(tags, index);
    let tag_text = ast_node_text(text, ast, child);
    let variant_name = text[var_start..var_end];
    let after = index + 1;
    if !std::mem::equal_bytes(tag_text, variant_name) {
        return try enum_tags_index(text, ast, tags, var_start, var_end, after);
    }
    return index;
}

// union_variant_tag_lookup mirrors enum_variant_tag_lookup over the union
// declarations: it returns the named variant's declaration-order tag.
fn union_variant_tag_lookup(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    union_start: i64,
    union_end: i64,
    var_start: i64,
    var_end: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let tag = try union_decl_variant_tag(text, ast, child, union_start, union_end, var_start, var_end);
    let after = index + 1;
    if tag > 0 - 2 {
        return tag;
    }
    return try union_variant_tag_lookup(text, ast, decls, union_start, union_end, var_start, var_end, after);
}

// union_decl_variant_tag classifies one declaration against the union name span:
// -2 = not the named union (keep scanning), otherwise the variant's tag.
fn union_decl_variant_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    union_start: i64,
    union_end: i64,
    var_start: i64,
    var_end: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        UnionDecl(union_decl) => try union_named_variant_tag(text, ast, union_decl.name, union_decl.variants, union_start, union_end, var_start, var_end),
        _ => code_decl_kind_skip(),
    };
}

fn union_named_variant_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    variants: std::kizu::ast::ChildRange,
    union_start: i64,
    union_end: i64,
    var_start: i64,
    var_end: i64
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let union_name = text[union_start..union_end];
    if !std::mem::equal_bytes(decl_name, union_name) {
        return 0 - 2;
    }
    return try union_variants_index(text, ast, variants, var_start, var_end, 0);
}

// union_variants_index returns the declaration-order index of the named variant
// in the union's variant list (-1 when the list does not carry it).
fn union_variants_index(
    text: []u8,
    ast: std::kizu::ast::Ast,
    variants: std::kizu::ast::ChildRange,
    var_start: i64,
    var_end: i64,
    index: i64
) -> !i64 {
    if index >= variants.len {
        return 0 - 1;
    }
    let child = try ast.child_at(variants, index);
    let matched = try union_variant_matches(text, ast, child, var_start, var_end);
    let after = index + 1;
    if matched {
        return index;
    }
    return try union_variants_index(text, ast, variants, var_start, var_end, after);
}

fn union_variant_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    var_start: i64,
    var_end: i64
) -> !bool {
    let node = ast.get(child);
    return match node.data {
        UnionVariant(variant) => union_variant_name_matches(text, ast, variant.name, var_start, var_end),
        _ => union_variant_no_match(),
    };
}

fn union_variant_name_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    var_start: i64,
    var_end: i64
) -> bool {
    let variant_text = ast_node_text(text, ast, name);
    let wanted = text[var_start..var_end];
    return std::mem::equal_bytes(variant_text, wanted);
}

fn union_variant_no_match() -> bool {
    return false;
}

// lower_code_union_const emits a UNION_CONST record for the resolved variant tag
// and payload value (-1 for a payload-less variant read).
fn lower_code_union_const(
    qual_start: i64,
    qual_end: i64,
    union_start: i64,
    union_end: i64,
    tag: i64,
    payload_value: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let record_pos = code.len();
    let op_union_const = code_op_union_const();
    try code.append(op_union_const);
    try code.append(next_value);
    try code.append(qual_start);
    try code.append(qual_end);
    try code.append(union_start);
    try code.append(union_end);
    try code.append(tag);
    try code.append(payload_value);
    let record_base = code_kind_struct_base();
    let record_kind = record_base + record_pos;
    try kinds.append(record_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// struct_record_field walks the STRUCT_LIT record's field entries and returns
// the value id bound to the named field (-1 when the record does not carry it).
fn struct_record_field(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= field_count {
        return 0 - 1;
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 5 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let entry_name = text[entry_name_start..entry_name_end];
    let name = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, name) {
        return try struct_record_field(text, code, record_pos, field_count, name_start, name_end, after);
    }
    let value_pos = entry_pos + 2;
    let entry_value = try code.get(value_pos);
    return entry_value;
}

// emit_code_var_load appends a VAR_LOAD record reading var slot into a fresh i64
// SSA value (with its parallel kinds entry) and returns that value.
fn emit_code_var_load(
    slot: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_var_load = code_op_var_load();
    try code.append(op_var_load);
    try code.append(next_value);
    try code.append(slot);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// emit_code_var_load_slice appends a VAR_LOAD_SLICE record reading a slice var
// slot into a fresh '%kizu.slice.u8' value (kind slice) and returns that value.
fn emit_code_var_load_slice(
    slot: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_var_load_slice = code_op_var_load_slice();
    try code.append(op_var_load_slice);
    try code.append(next_value);
    try code.append(slot);
    let kind_slice = code_kind_slice();
    try kinds.append(kind_slice);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_binary(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    op: std::kizu::ast::BinaryOp,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if op == std::kizu::ast::binary_and() {
        return try lower_code_logical(text, ast, decls, left, right, 0, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if op == std::kizu::ast::binary_or() {
        return try lower_code_logical(text, ast, decls, left, right, 1, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let kind = code_binary_kind(op);
    if kind == 0 {
        return code_eval_unsupported(next_value);
    }
    let left_eval = try lower_code_expr(text, ast, decls, left, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !left_eval.ok {
        return code_eval_unsupported(left_eval.next);
    }
    let right_eval = try lower_code_expr(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, left_eval.next);
    if !right_eval.ok {
        return code_eval_unsupported(right_eval.next);
    }
    // The BINARY record types both operands as i64 (icmp/arith on '%v' i64
    // temps), so a bool/str/slice operand is not owned by this record. An
    // enum-valued operand passes: an ENUM_CONST literal or an ENUM_DECL-typed
    // value (e.g. an enum param) both carry the i64-tag ABI, so their SSA temp
    // is the i64 tag and enum equality lowers as a plain icmp (the checker owns
    // operator legality).
    let left_kind = try kinds.get(left_eval.value_id);
    let left_i64_like = try code_operand_is_i64_like(code, left_kind);
    let left_enum = try code_kind_is_enum_value(code, left_kind);
    if !left_i64_like and !left_enum {
        return code_eval_unsupported(right_eval.next);
    }
    let right_kind = try kinds.get(right_eval.value_id);
    let right_i64_like = try code_operand_is_i64_like(code, right_kind);
    let right_enum = try code_kind_is_enum_value(code, right_kind);
    if !right_i64_like and !right_enum {
        return code_eval_unsupported(right_eval.next);
    }
    let op_binary = code_op_binary();
    try code.append(op_binary);
    try code.append(right_eval.next);
    try code.append(kind);
    try code.append(left_eval.value_id);
    try code.append(right_eval.value_id);
    if code_binary_kind_is_comparison(kind) {
        let kind_bool = code_kind_bool();
        try kinds.append(kind_bool);
    } else {
        let kind_i64 = code_kind_i64();
        try kinds.append(kind_i64);
    }
    let result_value = right_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_index lowers an element index 'b[i]' (slice == false) on a
// '%kizu.slice.u8' target: the target lowers to a slice value, the index lowers
// to an i64-like value, then SLICE_INDEX reads the byte and yields an i64. A range
// slice 'b[i..j]' (slice == true) routes to lower_code_index_range, which yields a
// '%kizu.slice.u8' sub-slice value instead.
fn lower_code_index(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    target: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    slice: bool,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if slice {
        return try lower_code_index_range(text, ast, decls, target, start, end, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let target_eval = try lower_code_expr(text, ast, decls, target, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !target_eval.ok {
        return code_eval_unsupported(target_eval.next);
    }
    // A 'str'-kind literal has no materialized '%kizu.slice.u8' SSA temp, so it is
    // lowered through STR_SLICE (the same boundary materialization a user-call
    // argument uses); a value already of slice kind passes through unchanged. The
    // value id and cursor bind to plain locals before the call (the shape the
    // compiled call-arg lowering models).
    let target_value = target_eval.value_id;
    let target_next = target_eval.next;
    let slice_eval = try lower_code_arg_slice(text, code, kinds, target_value, target_next);
    if !slice_eval.ok {
        return code_eval_unsupported(slice_eval.next);
    }
    let target_kind = try kinds.get(slice_eval.value_id);
    let kind_slice = code_kind_slice();
    if target_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    let index_eval = try lower_code_expr(text, ast, decls, start, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slice_eval.next);
    if !index_eval.ok {
        return code_eval_unsupported(index_eval.next);
    }
    let index_kind = try kinds.get(index_eval.value_id);
    let index_i64_like = try code_operand_is_i64_like(code, index_kind);
    if !index_i64_like {
        return code_eval_unsupported(index_eval.next);
    }
    // Emit SLICE_INDEX inline (matching the BINARY record shape): the result
    // value id is the next free value, and the SSA byte read zero-extends to i64.
    let slice_value = slice_eval.value_id;
    let index_value = index_eval.value_id;
    let result_value = index_eval.next;
    let op_slice_index = code_op_slice_index();
    try code.append(op_slice_index);
    try code.append(result_value);
    try code.append(slice_value);
    try code.append(index_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_index_range lowers a range slice 'b[i..j]' (slice == true) on a
// '%kizu.slice.u8' target: the target lowers to a slice value, both bounds lower
// to i64-like values, then SLICE_RANGE offsets the data pointer by 'start' and
// sets the new length to 'end - start'. Open-ended forms reuse the same path: a
// missing start 'b[..j]' synthesizes CONST_INT 0 and a missing end 'b[i..]'
// synthesizes SLICE_LEN of the slice (its full length). ('b[..]' with both bounds
// omitted is rejected earlier by the parser, so it never reaches here.) Its
// result is a '%kizu.slice.u8' value
// (kind slice), so an immutable 'let' binds it as an SSA slice and print() / a
// VAR_DECL_SLICE slot consume it the same way a std::fs::read_file slice flows.
fn lower_code_index_range(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    target: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let target_eval = try lower_code_expr(text, ast, decls, target, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !target_eval.ok {
        return code_eval_unsupported(target_eval.next);
    }
    // A 'str'-kind literal materializes through STR_SLICE (the same boundary a
    // user-call argument or an element index 'b[i]' uses); a value already of
    // slice kind passes through unchanged.
    let target_value = target_eval.value_id;
    let target_next = target_eval.next;
    let slice_eval = try lower_code_arg_slice(text, code, kinds, target_value, target_next);
    if !slice_eval.ok {
        return code_eval_unsupported(slice_eval.next);
    }
    let target_kind = try kinds.get(slice_eval.value_id);
    let kind_slice = code_kind_slice();
    if target_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    // An open-low slice 'b[..j]' leaves 'start' an Empty node; lower_code_range_start
    // synthesizes CONST_INT 0 there. An explicit start lowers as before. The
    // synthesized 0 is i64 by construction, so the i64-like check below still passes.
    let start_eval = try lower_code_range_start(text, ast, decls, start, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slice_eval.next);
    if !start_eval.ok {
        return code_eval_unsupported(start_eval.next);
    }
    let start_kind = try kinds.get(start_eval.value_id);
    let start_i64_like = try code_operand_is_i64_like(code, start_kind);
    if !start_i64_like {
        return code_eval_unsupported(start_eval.next);
    }
    // An open-high slice 'b[i..]' leaves 'end' an Empty node; lower_code_range_end
    // synthesizes SLICE_LEN of the materialized slice (its full length) there. An
    // explicit end lowers as before; the synthesized length is i64 by construction.
    let end_eval = try lower_code_range_end(text, ast, decls, end, slice_eval.value_id, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, start_eval.next);
    if !end_eval.ok {
        return code_eval_unsupported(end_eval.next);
    }
    let end_kind = try kinds.get(end_eval.value_id);
    let end_i64_like = try code_operand_is_i64_like(code, end_kind);
    if !end_i64_like {
        return code_eval_unsupported(end_eval.next);
    }
    // Emit SLICE_RANGE inline: 'op dst slice_value start_value end_value'. The
    // result value id is the next free value and its kind is slice.
    let slice_value = slice_eval.value_id;
    let start_value = start_eval.value_id;
    let end_value = end_eval.value_id;
    let result_value = end_eval.next;
    let op_slice_range = code_op_slice_range();
    try code.append(op_slice_range);
    try code.append(result_value);
    try code.append(slice_value);
    try code.append(start_value);
    try code.append(end_value);
    let kind_slice_result = code_kind_slice();
    try kinds.append(kind_slice_result);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_range_start resolves the start bound of a range slice. A present
// 'start' lowers as an explicit expr (the closed 'b[i..j]' path, unchanged); an
// Empty 'start' (open-low 'b[..j]') synthesizes a CONST_INT 0 so SLICE_RANGE
// begins the sub-slice at the slice head. The synthesized result is kind i64.
fn lower_code_range_start(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    start: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if !is_empty_node(ast, start) {
        return try lower_code_expr(text, ast, decls, start, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let op_const = code_op_const_int();
    try code.append(op_const);
    try code.append(next_value);
    try code.append(0);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    return code_eval_value(next_value, next_value + 1);
}

// lower_code_range_end resolves the end bound of a range slice. A present 'end'
// lowers as an explicit expr (the closed 'b[i..j]' path, unchanged); an Empty
// 'end' (open-high 'b[i..]') synthesizes SLICE_LEN of the materialized slice so
// SLICE_RANGE runs the sub-slice to the tail. The synthesized result is kind i64.
fn lower_code_range_end(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    end: std::kizu::ast::NodeId,
    slice_value: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if !is_empty_node(ast, end) {
        return try lower_code_expr(text, ast, decls, end, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let op_len = code_op_slice_len();
    try code.append(op_len);
    try code.append(next_value);
    try code.append(slice_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    return code_eval_value(next_value, next_value + 1);
}

// code_operand_is_i64_like accepts an i64 operand or an ENUM_CONST-backed value
// (whose SSA temp is its i64 tag), so tag comparisons lower as a plain icmp.
fn code_operand_is_i64_like(code: &var std::array::Array<i64>, kind: i64) -> !bool {
    let kind_i64 = code_kind_i64();
    if kind == kind_i64 {
        return true;
    }
    let record_base = code_kind_struct_base();
    if kind < record_base {
        return false;
    }
    let record_pos = kind - record_base;
    let record_op = try code.get(record_pos);
    let op_enum_const = code_op_enum_const();
    return record_op == op_enum_const;
}

// lower_code_logical lowers a short-circuit 'and'/'or' (is_or 0/1): the left
// operand lowers first, SC_BEGIN stores it into the record's i1 slot and branches
// past the right operand when the left already decides the result, the right
// operand records follow, and SC_END stores the right value and loads the slot
// into the result value. Both operands must be i1 (kind bool).
fn lower_code_logical(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    is_or: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let left_eval = try lower_code_expr(text, ast, decls, left, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !left_eval.ok {
        return code_eval_unsupported(left_eval.next);
    }
    let kind_bool = code_kind_bool();
    let left_kind = try kinds.get(left_eval.value_id);
    if left_kind != kind_bool {
        return code_eval_unsupported(left_eval.next);
    }
    let sc_index = code.len();
    let op_sc_begin = code_op_sc_begin();
    try code.append(op_sc_begin);
    try code.append(sc_index);
    try code.append(left_eval.value_id);
    try code.append(is_or);
    let right_eval = try lower_code_expr(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, left_eval.next);
    if !right_eval.ok {
        return code_eval_unsupported(right_eval.next);
    }
    let right_kind = try kinds.get(right_eval.value_id);
    if right_kind != kind_bool {
        return code_eval_unsupported(right_eval.next);
    }
    let op_sc_end = code_op_sc_end();
    try code.append(op_sc_end);
    try code.append(sc_index);
    try code.append(right_eval.value_id);
    try code.append(right_eval.next);
    try kinds.append(kind_bool);
    let result_value = right_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_call lowers a direct call to a user-declared i64 function: the
// argument expressions lower first (their value ids collect in args_scratch),
// then the CALL record carries the callee name span, the argument count, and
// the argument value ids copied off the scratch tail.
fn lower_code_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "std::mem::page_allocator") {
        return try lower_code_page_allocator(args, code, kinds, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::io::blocking") {
        return try lower_code_io_blocking(args, code, kinds, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::string::String") {
        return try lower_code_string_new(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::mem::equal_bytes") {
        return try lower_code_mem_equal_bytes(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::mem::len") {
        return try lower_code_mem_len(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::mem::starts_with") {
        return try lower_code_mem_starts_with(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::mem::trim_ascii") {
        return try lower_code_mem_trim_ascii(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::path::basename") {
        return try lower_code_path_basename(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::path::dirname") {
        return try lower_code_path_dirname(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::path::extension") {
        return try lower_code_path_extension(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let runtime_ctor = try lower_code_runtime_constructor(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if runtime_ctor.ok {
        return runtime_ctor;
    }
    // The union-constructor probe resolves the callee against the union
    // declarations without touching the tape; only a resolved constructor
    // commits to the union path, so a failure past this point (an unsupported
    // payload) stays a final unsupported program instead of falling through to
    // the user-call path over a partially written tape.
    let union_tag = try code_callee_union_tag(text, ast, decls, callee);
    if union_tag >= 0 {
        return try lower_code_union_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let method_kind = try code_method_call_return_kind(text, ast, decls, code, callee);
    if method_kind >= 0 {
        return try emit_code_method_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, false, next_value);
    }
    let runtime_method = try lower_code_runtime_expr_method(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if runtime_method.ok {
        return runtime_method;
    }
    let record_base = code_kind_struct_base();
    let callee_span = code_node_span(text, ast, callee);
    let callee_kind = try code_callee_return_kind(text, ast, decls, code, callee_span.start, callee_span.end, 0);
    let is_i64_ret = callee_kind == 1;
    let bool_ret = code_return_kind_bool();
    let is_bool_ret = callee_kind == bool_ret;
    let slice_ret = code_return_kind_slice();
    let is_slice_ret = callee_kind == slice_ret;
    let is_union_ret = callee_kind >= record_base;
    let is_owned_string_ret = callee_kind == code_kind_owned_string();
    let value_ret = is_i64_ret or is_bool_ret or is_slice_ret or is_union_ret or is_owned_string_ret;
    if !value_ret {
        return code_eval_unsupported(next_value);
    }
    let result_kind = code_return_kind_result_kind(callee_kind);
    return try emit_code_user_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, result_kind, next_value);
}

fn lower_code_page_allocator(
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op_page = code_op_page_allocator();
    try code.append(op_page);
    try code.append(next_value);
    let kind_owned = code_kind_owned();
    try kinds.append(kind_owned);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_runtime_constructor(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let arena_new = try lower_code_arena_new(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if arena_new.ok {
        return arena_new;
    }
    let array_new = try lower_code_array_new(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if array_new.ok {
        return array_new;
    }
    let map_new = try lower_code_map_new(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if map_new.ok {
        return map_new;
    }
    let box_kind = try code_callee_box_kind(text, ast, callee);
    if box_kind >= 0 {
        return try lower_code_box_new(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_box_new(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let box_kind = try code_callee_box_kind(text, ast, callee);
    if box_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let allocator_arg = try ast.child_at(args, 0);
    let allocator_eval = try lower_code_expr(text, ast, decls, allocator_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !allocator_eval.ok {
        return code_eval_unsupported(allocator_eval.next);
    }
    let allocator_kind = try kinds.get(allocator_eval.value_id);
    if allocator_kind != code_kind_owned() {
        return code_eval_unsupported(allocator_eval.next);
    }
    let value_arg = try ast.child_at(args, 1);
    let value_eval = try lower_code_expr(text, ast, decls, value_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, allocator_eval.next);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let value_kind = try kinds.get(value_eval.value_id);
    let kind_i64 = code_kind_i64();
    if value_kind != kind_i64 {
        return code_eval_unsupported(value_eval.next);
    }
    let op_box_new = code_op_box_new();
    try code.append(op_box_new);
    try code.append(value_eval.next);
    try code.append(allocator_eval.value_id);
    try code.append(value_eval.value_id);
    let kind_error_box = code_kind_error_box_i64();
    try kinds.append(kind_error_box);
    let result_value = value_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn code_callee_box_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(callee);
    return match node.data {
        TypeApplyExpr(type_apply) => try code_type_apply_box_kind(text, ast, type_apply.callee, type_apply.type_args),
        _ => code_no_box_kind(),
    };
}

fn code_no_box_kind() -> i64 {
    return 0 - 1;
}

fn code_type_apply_box_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange
) -> !i64 {
    if type_args.len != 1 {
        return code_no_box_kind();
    }
    if !std::mem::equal_bytes(ast_node_text(text, ast, type_callee), "std::mem::Box") {
        return code_no_box_kind();
    }
    let type_arg = try ast.child_at(type_args, 0);
    if type_node_is_i64(text, ast, type_arg) {
        return code_kind_owned_box_i64();
    }
    return code_no_box_kind();
}

fn lower_code_map_new(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let kind_map = try code_callee_map_kind(text, ast, callee, code);
    if kind_map == code_no_map_kind() {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_storage_new(text, ast, decls, args, kind_map, 0, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

fn code_callee_map_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let node = ast.get(callee);
    return match node.data {
        TypeApplyExpr(type_apply) => try code_type_apply_map_kind(text, ast, type_apply.callee, type_apply.type_args, code),
        _ => code_no_map_kind(),
    };
}

fn code_no_map_kind() -> i64 {
    return 0 - 1;
}

fn code_type_apply_map_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>
) -> !i64 {
    if type_args.len != 2 {
        return code_no_map_kind();
    }
    if !std::mem::equal_bytes(ast_node_text(text, ast, type_callee), "std::map::Map") {
        return code_no_map_kind();
    }
    let key_arg = try ast.child_at(type_args, 0);
    let key_text = ast_node_text(text, ast, key_arg);
    if !std::mem::equal_bytes(key_text, "[]u8") {
        return code_no_map_kind();
    }
    let value_arg = try ast.child_at(type_args, 1);
    return try code_map_value_arg_kind(text, ast, value_arg, code);
}

fn code_map_value_arg_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value_arg: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    if type_node_is_i64(text, ast, value_arg) {
        return code_kind_owned_map_i64();
    }
    if std::mem::equal_bytes(ast_node_text(text, ast, value_arg), "bool") {
        return code_kind_owned_map_bool();
    }
    let span = code_node_span(text, ast, value_arg);
    let enum_pos = try enum_decl_pos_by_span(text, code, span.start, span.end, 0);
    if enum_pos >= 0 {
        return code_kind_owned_map_enum(enum_pos);
    }
    return code_no_map_kind();
}

fn lower_code_array_new(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let kind_array = try code_callee_array_kind(text, ast, callee, code);
    // code_no_array_kind() (-1) marks "not an Array<...>"; an enum-element array
    // carries its own negative kind (ENUM_DECL pos embedded below a dedicated
    // base), so match the sentinel exactly rather than rejecting every negative
    // kind, which would discard Array<EnumType> (issue 1347).
    if kind_array == code_no_array_kind() {
        return code_eval_unsupported(next_value);
    }
    let element_size = try code_array_element_size(code, kind_array);
    return try lower_code_storage_new(text, ast, decls, args, kind_array, element_size, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

fn code_callee_array_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let node = ast.get(callee);
    return match node.data {
        TypeApplyExpr(type_apply) => try code_type_apply_array_kind(text, ast, type_apply.callee, type_apply.type_args, code),
        _ => code_no_array_kind(),
    };
}

fn code_no_array_kind() -> i64 {
    return 0 - 1;
}

fn code_type_apply_array_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>
) -> !i64 {
    if type_args.len != 1 {
        return 0 - 1;
    }
    if !std::mem::equal_bytes(ast_node_text(text, ast, type_callee), "std::array::Array") {
        return 0 - 1;
    }
    let type_arg = try ast.child_at(type_args, 0);
    return try code_array_type_arg_kind(text, ast, type_arg, code);
}

fn code_array_type_arg_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_arg: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    if type_node_is_i64(text, ast, type_arg) {
        return code_kind_owned_array_i64();
    }
    let type_text = ast_node_text(text, ast, type_arg);
    if std::mem::equal_bytes(type_text, "bool") {
        return code_kind_owned_array_bool();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_kind_owned_array_slice();
    }
    // A declared enum element has the i64-tag ABI (an 8-byte discriminant), so
    // Array<EnumType> lowers onto the same storage path as Array<i64>. The kind
    // embeds the ENUM_DECL record position so Array.get can restore the enum
    // identity on the result value (issue 1347). We only take this branch when the
    // type_arg resolves against an ENUM_DECL record on the tape; bare
    // identifiers (e.g. struct element types, whose ABI differs) stay
    // unsupported.
    let span = code_node_span(text, ast, type_arg);
    let enum_pos = try enum_decl_pos_by_span(text, code, span.start, span.end, 0);
    if enum_pos >= 0 {
        return code_kind_owned_array_enum(enum_pos);
    }
    let struct_pos = try struct_decl_pos_by_span(text, code, span.start, span.end, 0);
    if struct_pos >= 0 {
        return try append_code_owned_array_struct_kind(code, struct_pos);
    }
    return 0 - 1;
}

fn append_code_owned_array_struct_kind(
    code: &var std::array::Array<i64>,
    struct_pos: i64
) -> !i64 {
    let field_count = try code.get(struct_pos + 3);
    if field_count != 1 {
        return code_no_array_kind();
    }
    let field_name_start = try code.get(struct_pos + 4);
    let field_name_end = try code.get(struct_pos + 5);
    let field_kind = try code.get(struct_pos + 6);
    if !code_array_struct_field_kind_supported(field_kind) {
        return code_no_array_kind();
    }
    let record_pos = code.len();
    let op_struct_param = code_op_struct_param();
    try code.append(op_struct_param);
    try code.append(1);
    try code.append(field_name_start);
    try code.append(field_name_end);
    try code.append(field_kind);
    return code_kind_owned_array_struct(record_pos);
}

fn code_array_struct_field_kind_supported(field_kind: i64) -> bool {
    if field_kind == code_kind_i64() {
        return true;
    }
    if field_kind == code_kind_bool() {
        return true;
    }
    return field_kind == code_kind_slice();
}

fn lower_code_arena_new(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let element_size = try code_arena_callee_element_size(text, ast, decls, callee);
    if element_size < 0 {
        return code_eval_unsupported(next_value);
    }
    let element_start = try code_arena_callee_element_span_part(text, ast, callee, 0);
    if element_start < 0 {
        return code_eval_unsupported(next_value);
    }
    let element_end = try code_arena_callee_element_span_part(text, ast, callee, 1);
    if element_end < 0 {
        return code_eval_unsupported(next_value);
    }
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let allocator_arg = try ast.child_at(args, 0);
    let allocator_eval = try lower_code_expr(text, ast, decls, allocator_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !allocator_eval.ok {
        return code_eval_unsupported(allocator_eval.next);
    }
    let allocator_kind = try kinds.get(allocator_eval.value_id);
    if allocator_kind != code_kind_owned() {
        return code_eval_unsupported(allocator_eval.next);
    }
    let record_pos = code.len();
    let op = code_op_arena_new();
    try code.append(op);
    try code.append(allocator_eval.next);
    try code.append(allocator_eval.value_id);
    try code.append(element_size);
    try code.append(element_start);
    try code.append(element_end);
    let kind_arena = code_kind_arena_record(record_pos);
    try kinds.append(kind_arena);
    let result_value = allocator_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn code_arena_callee_element_span_part(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    part: i64
) -> !i64 {
    let node = ast.get(callee);
    return match node.data {
        TypeApplyExpr(type_apply) => try code_arena_type_apply_element_span_part(text, ast, type_apply.callee, type_apply.type_args, part),
        _ => code_arena_missing_size(),
    };
}

fn code_arena_type_apply_element_span_part(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    part: i64
) -> !i64 {
    if type_args.len != 1 {
        return 0 - 1;
    }
    let callee_text = ast_node_text(text, ast, type_callee);
    if !std::mem::equal_bytes(callee_text, "std::arena::Arena") {
        return 0 - 1;
    }
    let element_type = try ast.child_at(type_args, 0);
    let span = code_node_span(text, ast, element_type);
    if part == 0 {
        return span.start;
    }
    return span.end;
}

fn code_arena_callee_element_size(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(callee);
    return match node.data {
        TypeApplyExpr(type_apply) => try code_arena_type_apply_element_size(text, ast, decls, type_apply.callee, type_apply.type_args),
        _ => code_arena_missing_size(),
    };
}

fn code_arena_type_apply_element_size(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange
) -> !i64 {
    if type_args.len != 1 {
        return 0 - 1;
    }
    let callee_text = ast_node_text(text, ast, type_callee);
    if !std::mem::equal_bytes(callee_text, "std::arena::Arena") {
        return 0 - 1;
    }
    let element_type = try ast.child_at(type_args, 0);
    return try code_arena_element_size(text, ast, decls, element_type, 0);
}

fn code_arena_element_size(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_node: std::kizu::ast::NodeId,
    index: i64
) -> !i64 {
    if type_node_is_i64(text, ast, type_node) {
        return 8;
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return 1;
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return 16;
    }
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let size = try code_decl_arena_struct_size(text, ast, child, type_node);
    if size >= 0 {
        return size;
    }
    let after = index + 1;
    return try code_arena_element_size(text, ast, decls, type_node, after);
}

fn code_decl_arena_struct_size(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        StructDecl(struct_decl) => try code_struct_decl_arena_size(text, ast, struct_decl.name, struct_decl.fields, type_node),
        _ => code_arena_missing_size(),
    };
}

fn code_struct_decl_arena_size(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    type_node: std::kizu::ast::NodeId
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let type_text = ast_node_text(text, ast, type_node);
    if !std::mem::equal_bytes(decl_name, type_text) {
        return 0 - 1;
    }
    if fields.len == 0 {
        return 0 - 1;
    }
    return try code_arena_struct_fields_size(text, ast, fields, 0, 0, 1);
}

fn code_arena_struct_fields_size(
    text: []u8,
    ast: std::kizu::ast::Ast,
    fields: std::kizu::ast::ChildRange,
    index: i64,
    size: i64,
    align: i64
) -> !i64 {
    if index >= fields.len {
        return code_arena_round_up(size, align);
    }
    let field_id = try ast.child_at(fields, index);
    let field_size = try code_arena_struct_field_size(text, ast, field_id);
    if field_size < 0 {
        return 0 - 1;
    }
    let field_align = try code_arena_struct_field_align(text, ast, field_id);
    if field_align < 0 {
        return 0 - 1;
    }
    let field_offset = code_arena_round_up(size, field_align);
    let next_size = field_offset + field_size;
    let next_align = code_arena_max_align(align, field_align);
    let after = index + 1;
    return try code_arena_struct_fields_size(text, ast, fields, after, next_size, next_align);
}

fn code_arena_struct_field_size(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field_id: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(field_id);
    return match node.data {
        Field(field_node) => code_arena_field_type_size(text, ast, field_node.type_node),
        _ => code_arena_missing_size(),
    };
}

fn code_arena_struct_field_align(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field_id: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(field_id);
    return match node.data {
        Field(field_node) => code_arena_field_type_align(text, ast, field_node.type_node),
        _ => code_arena_missing_size(),
    };
}

fn code_arena_missing_size() -> i64 {
    return 0 - 1;
}

fn code_arena_field_type_size(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> i64 {
    if type_node_is_i64(text, ast, type_node) {
        return 8;
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return 1;
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return 16;
    }
    return 0 - 1;
}

fn code_arena_field_type_align(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> i64 {
    if type_node_is_i64(text, ast, type_node) {
        return 8;
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return 1;
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return 8;
    }
    return 0 - 1;
}

fn code_arena_round_up(value: i64, align: i64) -> i64 {
    if align <= 1 {
        return value;
    }
    let adjusted = value + align - 1;
    return (adjusted / align) * align;
}

fn code_arena_max_align(left: i64, right: i64) -> i64 {
    if right > left {
        return right;
    }
    return left;
}

fn code_arena_layout_part_offset() -> i64 {
    return 0;
}

fn code_arena_layout_part_size() -> i64 {
    return 1;
}

fn code_arena_layout_part_kind() -> i64 {
    return 2;
}

fn code_arena_layout_part_count() -> i64 {
    return 3;
}

fn code_arena_layout_part(
    part: i64,
    offset: i64,
    size: i64,
    kind: i64,
    field_count: i64
) -> i64 {
    if part == code_arena_layout_part_offset() {
        return offset;
    }
    if part == code_arena_layout_part_size() {
        return size;
    }
    if part == code_arena_layout_part_kind() {
        return kind;
    }
    if part == code_arena_layout_part_count() {
        return field_count;
    }
    return 0 - 1;
}

fn code_arena_struct_field_layout_part_by_span(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_start: i64,
    type_end: i64,
    field_start: i64,
    field_end: i64,
    part: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let value = try code_decl_arena_struct_field_layout_part_by_span(text, ast, child, type_start, type_end, field_start, field_end, part);
    if value >= 0 {
        return value;
    }
    let after = index + 1;
    return try code_arena_struct_field_layout_part_by_span(text, ast, decls, type_start, type_end, field_start, field_end, part, after);
}

fn code_decl_arena_struct_field_layout_part_by_span(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    type_start: i64,
    type_end: i64,
    field_start: i64,
    field_end: i64,
    part: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        StructDecl(struct_decl) => try code_struct_decl_arena_field_layout_part_by_span(text, ast, struct_decl.name, struct_decl.fields, type_start, type_end, field_start, field_end, part),
        _ => code_arena_missing_size(),
    };
}

fn code_struct_decl_arena_field_layout_part_by_span(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    type_start: i64,
    type_end: i64,
    field_start: i64,
    field_end: i64,
    part: i64
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let type_text = text[type_start..type_end];
    if !std::mem::equal_bytes(decl_name, type_text) {
        return 0 - 1;
    }
    if fields.len == 0 {
        return 0 - 1;
    }
    return try code_arena_struct_fields_field_layout_part(text, ast, fields, field_start, field_end, part, 0, 0, 1);
}

fn code_arena_struct_fields_field_layout_part(
    text: []u8,
    ast: std::kizu::ast::Ast,
    fields: std::kizu::ast::ChildRange,
    field_start: i64,
    field_end: i64,
    part: i64,
    index: i64,
    size: i64,
    align: i64
) -> !i64 {
    if index >= fields.len {
        return 0 - 1;
    }
    let field_id = try ast.child_at(fields, index);
    let field_size = try code_arena_struct_field_size(text, ast, field_id);
    if field_size < 0 {
        return 0 - 1;
    }
    let field_align = try code_arena_struct_field_align(text, ast, field_id);
    if field_align < 0 {
        return 0 - 1;
    }
    let field_kind = try code_arena_struct_field_kind(text, ast, field_id);
    if field_kind < 0 {
        return 0 - 1;
    }
    let field_offset = code_arena_round_up(size, field_align);
    let name_matches = try code_arena_struct_field_name_matches(text, ast, field_id, field_start, field_end);
    if name_matches == 1 {
        return code_arena_layout_part(part, field_offset, field_size, field_kind, fields.len);
    }
    let next_size = field_offset + field_size;
    let next_align = code_arena_max_align(align, field_align);
    let after = index + 1;
    return try code_arena_struct_fields_field_layout_part(text, ast, fields, field_start, field_end, part, after, next_size, next_align);
}

fn code_arena_struct_field_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field_id: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(field_id);
    return match node.data {
        Field(field_node) => code_arena_field_type_kind(text, ast, field_node.type_node),
        _ => code_arena_missing_size(),
    };
}

fn code_arena_struct_field_name_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field_id: std::kizu::ast::NodeId,
    field_start: i64,
    field_end: i64
) -> !i64 {
    let node = ast.get(field_id);
    return match node.data {
        Field(field_node) => code_arena_field_name_matches(text, ast, field_node.name, field_start, field_end),
        _ => 0,
    };
}

fn code_arena_field_name_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    field_start: i64,
    field_end: i64
) -> i64 {
    let declared = ast_node_text(text, ast, name);
    let wanted = text[field_start..field_end];
    if std::mem::equal_bytes(declared, wanted) {
        return 1;
    }
    return 0;
}

fn code_arena_field_type_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> i64 {
    if type_node_is_i64(text, ast, type_node) {
        return code_kind_i64();
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return code_kind_bool();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_kind_slice();
    }
    return 0 - 1;
}

fn code_arena_kind_element_span_part(
    code: &var std::array::Array<i64>,
    kind: i64,
    part: i64
) -> !i64 {
    let record_pos = code_kind_arena_record_pos(kind);
    if record_pos < 0 {
        return 0 - 1;
    }
    let type_start_pos = record_pos + 4;
    let type_start = try code.get(type_start_pos);
    let type_end_pos = record_pos + 5;
    let type_end = try code.get(type_end_pos);
    if part == 0 {
        return type_start;
    }
    return type_end;
}

fn lower_code_mem_page_allocator(
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_mem_page_allocator();
    try code.append(op);
    try code.append(next_value);
    let kind_owned = code_kind_owned();
    try kinds.append(kind_owned);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_string_new(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let allocator_arg = try ast.child_at(args, 0);
    let allocator_eval = try lower_code_expr(text, ast, decls, allocator_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !allocator_eval.ok {
        return code_eval_unsupported(allocator_eval.next);
    }
    let kind_owned = code_kind_owned();
    let allocator_kind = try kinds.get(allocator_eval.value_id);
    if allocator_kind != kind_owned {
        return code_eval_unsupported(allocator_eval.next);
    }
    let op_string_new = code_op_string_new();
    try code.append(op_string_new);
    try code.append(allocator_eval.next);
    try code.append(allocator_eval.value_id);
    let kind_string = code_kind_owned_string();
    try kinds.append(kind_string);
    let result_value = allocator_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_storage_new(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    result_kind: i64,
    element_size: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let allocator_arg = try ast.child_at(args, 0);
    let allocator_eval = try lower_code_expr(text, ast, decls, allocator_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !allocator_eval.ok {
        return code_eval_unsupported(allocator_eval.next);
    }
    let allocator_kind = try kinds.get(allocator_eval.value_id);
    if allocator_kind != code_kind_owned() {
        return code_eval_unsupported(allocator_eval.next);
    }
    let op = code_op_storage_new();
    try code.append(op);
    try code.append(allocator_eval.next);
    try code.append(result_kind);
    try code.append(allocator_eval.value_id);
    try code.append(element_size);
    try kinds.append(result_kind);
    let result_value = allocator_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_runtime_expr_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_runtime_field_expr_method(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_runtime_field_expr_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let receiver_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    let method = ast_node_text(text, ast, name);
    if receiver_kind == code_kind_owned_string() {
        return try lower_code_string_expr_method(method, receiver_eval.value_id, args, code, kinds, receiver_eval.next);
    }
    if code_kind_is_owned_array(receiver_kind) {
        return try lower_code_array_expr_method(text, ast, decls, method, receiver_eval.value_id, receiver_kind, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    if code_kind_is_map_handle(receiver_kind) {
        return try lower_code_map_i64_expr_method(text, ast, decls, method, receiver_eval.value_id, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    if code_kind_is_arena(receiver_kind) {
        return try lower_code_arena_expr_method(text, ast, decls, method, receiver_eval.value_id, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    if code_kind_is_owned_box(receiver_kind) {
        return try lower_code_box_i64_expr_method(method, receiver_eval.value_id, args, code, kinds, receiver_eval.next);
    }
    return code_eval_unsupported(receiver_eval.next);
}

fn lower_code_box_i64_expr_method(
    method: []u8,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if std::mem::equal_bytes(method, "borrow") {
        return try lower_code_box_borrow_i64_expr(receiver_value, args, code, kinds, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_box_borrow_i64_expr(
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_box_borrow_i64();
    try code.append(op);
    try code.append(next_value);
    try code.append(receiver_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_string_expr_method(
    method: []u8,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if std::mem::equal_bytes(method, "as_bytes") {
        return try lower_code_string_as_bytes_expr(receiver_value, args, code, kinds, next_value);
    }
    if std::mem::equal_bytes(method, "len") {
        return try lower_code_string_len_expr(receiver_value, args, code, kinds, next_value);
    }
    if std::mem::equal_bytes(method, "capacity") {
        return try lower_code_string_capacity_expr(receiver_value, args, code, kinds, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_string_as_bytes_expr(
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_string_as_bytes();
    try code.append(op);
    try code.append(next_value);
    try code.append(receiver_value);
    let kind_slice = code_kind_slice();
    try kinds.append(kind_slice);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_string_len_expr(
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_string_len();
    try code.append(op);
    try code.append(next_value);
    try code.append(receiver_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_string_capacity_expr(
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_storage_capacity();
    try code.append(op);
    try code.append(next_value);
    try code.append(receiver_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_mem_equal_bytes(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let left_arg = try ast.child_at(args, 0);
    let left_eval = try lower_code_expr(text, ast, decls, left_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !left_eval.ok {
        return code_eval_unsupported(left_eval.next);
    }
    let left_slice = try lower_code_arg_slice(text, code, kinds, left_eval.value_id, left_eval.next);
    let kind_slice = code_kind_slice();
    let left_kind = try kinds.get(left_slice.value_id);
    if left_kind != kind_slice {
        return code_eval_unsupported(left_slice.next);
    }
    let right_arg = try ast.child_at(args, 1);
    let right_eval = try lower_code_expr(text, ast, decls, right_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, left_slice.next);
    if !right_eval.ok {
        return code_eval_unsupported(right_eval.next);
    }
    let right_slice = try lower_code_arg_slice(text, code, kinds, right_eval.value_id, right_eval.next);
    let right_kind = try kinds.get(right_slice.value_id);
    if right_kind != kind_slice {
        return code_eval_unsupported(right_slice.next);
    }
    let result_value = right_slice.next;
    let op = code_op_mem_equal_bytes();
    try code.append(op);
    try code.append(result_value);
    try code.append(left_slice.value_id);
    try code.append(right_slice.value_id);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_mem_len lowers 'std::mem::len(s)' over a '[]u8' or str slice: the
// argument lowers to a value, a str-kind literal is materialized to a
// '%kizu.slice.u8' via lower_code_arg_slice (the same boundary the equal_bytes
// arguments use), and SLICE_LEN reads the length field as an i64. Any argument
// that is not a slice after materialization stays unsupported.
fn lower_code_mem_len(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let arg_eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !arg_eval.ok {
        return code_eval_unsupported(arg_eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, arg_eval.value_id, arg_eval.next);
    let kind_slice = code_kind_slice();
    let slice_kind = try kinds.get(slice_eval.value_id);
    if slice_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    let result_value = slice_eval.next;
    let op = code_op_slice_len();
    try code.append(op);
    try code.append(result_value);
    try code.append(slice_eval.value_id);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_mem_byte_at lowers 'try std::mem::byte_at(s, i)' over a '[]u8' or str
// slice: it reuses the element-index path's SLICE_INDEX op (the same record the
// 'b[i]' expression emits), reading one byte and zero-extending it to an i64. The
// std byte_at bounds-checks before 'bytes[index]'; the run path matches the Go
// baseline on in-range indices, the only shape tracker 1070 admits.
fn lower_code_mem_byte_at(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let slice_arg = try ast.child_at(args, 0);
    let slice_expr = try lower_code_expr(text, ast, decls, slice_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !slice_expr.ok {
        return code_eval_unsupported(slice_expr.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, slice_expr.value_id, slice_expr.next);
    let kind_slice = code_kind_slice();
    let slice_kind = try kinds.get(slice_eval.value_id);
    if slice_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    let index_arg = try ast.child_at(args, 1);
    let index_eval = try lower_code_expr(text, ast, decls, index_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slice_eval.next);
    if !index_eval.ok {
        return code_eval_unsupported(index_eval.next);
    }
    let index_kind = try kinds.get(index_eval.value_id);
    let index_i64_like = try code_operand_is_i64_like(code, index_kind);
    if !index_i64_like {
        return code_eval_unsupported(index_eval.next);
    }
    let result_value = index_eval.next;
    let op = code_op_slice_index();
    try code.append(op);
    try code.append(result_value);
    try code.append(slice_eval.value_id);
    try code.append(index_eval.value_id);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_mem_slice lowers 'try std::mem::slice(s, start, end)' over a '[]u8' or
// str slice: it reuses the range-slice path's SLICE_RANGE op (the same record the
// closed 'b[start..end]' expression emits), offsetting the data pointer by 'start'
// and setting the new length to 'end - start'. The std slice bounds-checks before
// 'bytes[start..end]'; the run path matches the Go baseline on in-range bounds,
// the only shape tracker 1070 admits. Its result is a '%kizu.slice.u8' value (kind slice).
fn lower_code_mem_slice(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 3 {
        return code_eval_unsupported(next_value);
    }
    let slice_arg = try ast.child_at(args, 0);
    let slice_expr = try lower_code_expr(text, ast, decls, slice_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !slice_expr.ok {
        return code_eval_unsupported(slice_expr.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, slice_expr.value_id, slice_expr.next);
    let kind_slice = code_kind_slice();
    let slice_kind = try kinds.get(slice_eval.value_id);
    if slice_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    let start_arg = try ast.child_at(args, 1);
    let start_eval = try lower_code_expr(text, ast, decls, start_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slice_eval.next);
    if !start_eval.ok {
        return code_eval_unsupported(start_eval.next);
    }
    let start_kind = try kinds.get(start_eval.value_id);
    let start_i64_like = try code_operand_is_i64_like(code, start_kind);
    if !start_i64_like {
        return code_eval_unsupported(start_eval.next);
    }
    let end_arg = try ast.child_at(args, 2);
    let end_eval = try lower_code_expr(text, ast, decls, end_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, start_eval.next);
    if !end_eval.ok {
        return code_eval_unsupported(end_eval.next);
    }
    let end_kind = try kinds.get(end_eval.value_id);
    let end_i64_like = try code_operand_is_i64_like(code, end_kind);
    if !end_i64_like {
        return code_eval_unsupported(end_eval.next);
    }
    let result_value = end_eval.next;
    let op = code_op_slice_range();
    try code.append(op);
    try code.append(result_value);
    try code.append(slice_eval.value_id);
    try code.append(start_eval.value_id);
    try code.append(end_eval.value_id);
    let kind_slice_result = code_kind_slice();
    try kinds.append(kind_slice_result);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_mem_starts_with lowers 'std::mem::starts_with(bytes, prefix)' over
// '[]u8' or str slices: both arguments materialize to '%kizu.slice.u8' values (the
// same boundary equal_bytes uses), then MEM_STARTS_WITH yields the i1 result. The
// renderer owns the length guard and the prefix-length comparison loop.
fn lower_code_mem_starts_with(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let bytes_arg = try ast.child_at(args, 0);
    let bytes_expr = try lower_code_expr(text, ast, decls, bytes_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !bytes_expr.ok {
        return code_eval_unsupported(bytes_expr.next);
    }
    let bytes_slice = try lower_code_arg_slice(text, code, kinds, bytes_expr.value_id, bytes_expr.next);
    let kind_slice = code_kind_slice();
    let bytes_kind = try kinds.get(bytes_slice.value_id);
    if bytes_kind != kind_slice {
        return code_eval_unsupported(bytes_slice.next);
    }
    let prefix_arg = try ast.child_at(args, 1);
    let prefix_expr = try lower_code_expr(text, ast, decls, prefix_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, bytes_slice.next);
    if !prefix_expr.ok {
        return code_eval_unsupported(prefix_expr.next);
    }
    let prefix_slice = try lower_code_arg_slice(text, code, kinds, prefix_expr.value_id, prefix_expr.next);
    let prefix_kind = try kinds.get(prefix_slice.value_id);
    if prefix_kind != kind_slice {
        return code_eval_unsupported(prefix_slice.next);
    }
    let result_value = prefix_slice.next;
    let op = code_op_mem_starts_with();
    try code.append(op);
    try code.append(result_value);
    try code.append(bytes_slice.value_id);
    try code.append(prefix_slice.value_id);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_mem_trim_ascii lowers 'std::mem::trim_ascii(bytes)' over a '[]u8' or
// str slice: the argument materializes to a '%kizu.slice.u8' value, then
// MEM_TRIM_ASCII yields the trimmed sub-slice. The renderer owns the head/tail
// whitespace scan and the slice assembly. Its result is a '%kizu.slice.u8' value
// (kind slice), so print() / a slice slot consume it like any range slice.
fn lower_code_mem_trim_ascii(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let arg_eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !arg_eval.ok {
        return code_eval_unsupported(arg_eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, arg_eval.value_id, arg_eval.next);
    let kind_slice = code_kind_slice();
    let slice_kind = try kinds.get(slice_eval.value_id);
    if slice_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    let result_value = slice_eval.next;
    let op = code_op_mem_trim_ascii();
    try code.append(op);
    try code.append(result_value);
    try code.append(slice_eval.value_id);
    let kind_slice_result = code_kind_slice();
    try kinds.append(kind_slice_result);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_path_basename / dirname / extension bind their op in the function body
// (compiled-MIR forbids a function-call argument and a 'let' in an if-then body, so
// the std::path dispatch stays a single 'return try' per callee) and delegate to the
// shared lower_code_path_component over PATH_BASENAME / PATH_DIRNAME / PATH_EXTENSION.
fn lower_code_path_basename(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op = code_op_path_basename();
    return try lower_code_path_component(op, text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

fn lower_code_path_dirname(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op = code_op_path_dirname();
    return try lower_code_path_component(op, text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

fn lower_code_path_extension(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op = code_op_path_extension();
    return try lower_code_path_component(op, text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

// lower_code_path_component lowers std::path::basename / dirname / extension over a
// '[]u8' or str slice argument. Identical in shape to lower_code_mem_trim_ascii:
// the argument materializes to a '%kizu.slice.u8' value, then the path op ('op'
// is one of PATH_BASENAME/PATH_DIRNAME/PATH_EXTENSION) yields the sub-slice the
// renderer scans out. Its result is a '%kizu.slice.u8' value (kind slice).
fn lower_code_path_component(
    op: i64,
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let arg_eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !arg_eval.ok {
        return code_eval_unsupported(arg_eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, arg_eval.value_id, arg_eval.next);
    let kind_slice = code_kind_slice();
    let slice_kind = try kinds.get(slice_eval.value_id);
    if slice_kind != kind_slice {
        return code_eval_unsupported(slice_eval.next);
    }
    let result_value = slice_eval.next;
    try code.append(op);
    try code.append(result_value);
    try code.append(slice_eval.value_id);
    let kind_slice_result = code_kind_slice();
    try kinds.append(kind_slice_result);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_array_expr_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    method: []u8,
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if std::mem::equal_bytes(method, "len") {
        return try lower_code_array_len(receiver_value, args, code, kinds, next_value);
    }
    if std::mem::equal_bytes(method, "capacity") {
        return try lower_code_array_capacity(receiver_value, args, code, kinds, next_value);
    }
    if std::mem::equal_bytes(method, "get_or_panic") {
        return try lower_code_array_get(text, ast, decls, receiver_value, receiver_kind, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_array_len(
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_array_len();
    try code.append(op);
    try code.append(next_value);
    try code.append(receiver_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_array_capacity(
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_storage_capacity();
    try code.append(op);
    try code.append(next_value);
    try code.append(receiver_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_array_get(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let index_arg = try ast.child_at(args, 0);
    let index_eval = try lower_code_expr(text, ast, decls, index_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !index_eval.ok {
        return code_eval_unsupported(index_eval.next);
    }
    let kind_i64 = code_kind_i64();
    let index_kind = try kinds.get(index_eval.value_id);
    if index_kind != kind_i64 {
        return code_eval_unsupported(index_eval.next);
    }
    let element_kind = try code_array_element_kind(code, receiver_kind);
    if element_kind == kind_i64 {
        let op_array_get_i64 = code_op_array_get_i64();
        try code.append(op_array_get_i64);
        try code.append(index_eval.next);
        try code.append(receiver_value);
        try code.append(index_eval.value_id);
    }
    if element_kind != kind_i64 {
        let op_array_get = code_op_array_get();
        try code.append(op_array_get);
        try code.append(index_eval.next);
        try code.append(receiver_value);
        try code.append(index_eval.value_id);
        try code.append(element_kind);
    }
    let result_kind = try code_array_get_result_kind(code, receiver_kind);
    try kinds.append(result_kind);
    let result_value = index_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_map_i64_expr_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    method: []u8,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if std::mem::equal_bytes(method, "len") {
        return try lower_code_map_len(receiver_value, args, code, kinds, next_value);
    }
    if std::mem::equal_bytes(method, "contains") {
        return try lower_code_map_contains(text, ast, decls, receiver_value, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_map_len(
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_map_len();
    try code.append(op);
    try code.append(next_value);
    try code.append(receiver_value);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_map_contains(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let key_arg = try ast.child_at(args, 0);
    let key_eval = try lower_code_expr(text, ast, decls, key_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !key_eval.ok {
        return code_eval_unsupported(key_eval.next);
    }
    let key_slice = try lower_code_arg_slice(text, code, kinds, key_eval.value_id, key_eval.next);
    let kind_slice = code_kind_slice();
    let key_kind = try kinds.get(key_slice.value_id);
    if key_kind != kind_slice {
        return code_eval_unsupported(key_slice.next);
    }
    let op = code_op_map_contains();
    try code.append(op);
    try code.append(key_slice.next);
    try code.append(receiver_value);
    try code.append(key_slice.value_id);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let result_value = key_slice.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_arena_expr_method(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    method: []u8,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if std::mem::equal_bytes(method, "add") {
        return try lower_code_arena_add(text, ast, decls, receiver_value, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(method, "get") {
        return try lower_code_arena_get_slice_struct_field(text, ast, decls, receiver_value, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_arena_add(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let element_arg = try ast.child_at(args, 0);
    let element_eval = try lower_code_expr(text, ast, decls, element_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !element_eval.ok {
        return code_eval_unsupported(element_eval.next);
    }
    let element_kind = try kinds.get(element_eval.value_id);
    let record_base = code_kind_struct_base();
    if element_kind < record_base {
        return code_eval_unsupported(element_eval.next);
    }
    let record_pos = element_kind - record_base;
    let field_value = try arena_single_slice_field_value(code, kinds, record_pos);
    if field_value >= 0 {
        return try lower_code_arena_add_single_field(text, ast, decls, element_arg, receiver_value, record_pos, field_value, code, kinds, args_scratch, element_eval.next);
    }
    return try lower_code_arena_add_struct(text, ast, decls, element_arg, receiver_value, record_pos, code, kinds, args_scratch, element_eval.next);
}

fn lower_code_arena_add_single_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    element_arg: std::kizu::ast::NodeId,
    receiver_value: i64,
    record_pos: i64,
    field_value: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let field_slice = try lower_code_arg_slice(text, code, kinds, field_value, next_value);
    let kind_slice = code_kind_slice();
    let field_kind = try kinds.get(field_slice.value_id);
    if field_kind == kind_slice {
        return try finish_code_arena_add_slice_struct(receiver_value, field_slice.value_id, code, kinds, field_slice.next);
    }
    return try lower_code_arena_add_struct(text, ast, decls, element_arg, receiver_value, record_pos, code, kinds, args_scratch, next_value);
}

fn finish_code_arena_add_slice_struct(
    receiver_value: i64,
    field_value: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op = code_op_arena_add_slice_struct();
    try code.append(op);
    try code.append(next_value);
    try code.append(receiver_value);
    try code.append(field_value);
    let kind_handle = code_kind_handle();
    try kinds.append(kind_handle);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_arena_add_struct(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    element_arg: std::kizu::ast::NodeId,
    receiver_value: i64,
    record_pos: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(element_arg);
    return match node.data {
        StructLiteralExpr(struct_lit) => try lower_code_arena_add_struct_literal(text, ast, decls, struct_lit.type_name, receiver_value, record_pos, code, kinds, args_scratch, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_arena_add_struct_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_name: std::kizu::ast::NodeId,
    receiver_value: i64,
    record_pos: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let payload_size = try code_arena_element_size(text, ast, decls, type_name, 0);
    if payload_size < 0 {
        return code_eval_unsupported(next_value);
    }
    let count_pos = record_pos + 4;
    let field_count = try code.get(count_pos);
    if field_count <= 0 {
        return code_eval_unsupported(next_value);
    }
    let scratch_base = try args_scratch.get(0);
    let scratch_bound = scratch_base + field_count * 4;
    try args_scratch.set(0, scratch_bound);
    let type_span = code_node_span(text, ast, type_name);
    let fields_eval = try prepare_code_arena_add_struct_fields(text, ast, decls, type_span.start, type_span.end, record_pos, field_count, code, kinds, args_scratch, scratch_base, 0, next_value);
    if !fields_eval.ok {
        return try code_eval_unsupported_after_scratch_reset(args_scratch, scratch_base, fields_eval.next);
    }
    let op = code_op_arena_add_struct();
    try code.append(op);
    try code.append(fields_eval.next);
    try code.append(receiver_value);
    try code.append(payload_size);
    try code.append(field_count);
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    let kind_handle = code_kind_handle();
    try kinds.append(kind_handle);
    let result_value = fields_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn code_eval_unsupported_after_scratch_reset(
    args_scratch: &var std::array::Array<i64>,
    scratch_base: i64,
    next_value: i64
) -> !CodeEval {
    try args_scratch.set(0, scratch_base);
    return code_eval_unsupported(next_value);
}

fn prepare_code_arena_add_struct_fields(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    type_start: i64,
    type_end: i64,
    record_pos: i64,
    field_count: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= field_count {
        return code_eval_value(0, next_value);
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 5 + entry_slots;
    let name_start = try code.get(entry_pos);
    let name_end_pos = entry_pos + 1;
    let name_end = try code.get(name_end_pos);
    let value_pos = entry_pos + 2;
    let raw_value = try code.get(value_pos);
    let kind_part = code_arena_layout_part_kind();
    let layout_kind = try code_arena_struct_field_layout_part_by_span(text, ast, decls, type_start, type_end, name_start, name_end, kind_part, 0);
    if layout_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    let value_eval = try code_arena_struct_field_payload_value(text, code, kinds, raw_value, layout_kind, next_value);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let offset_part = code_arena_layout_part_offset();
    let layout_offset = try code_arena_struct_field_layout_part_by_span(text, ast, decls, type_start, type_end, name_start, name_end, offset_part, 0);
    let size_part = code_arena_layout_part_size();
    let layout_size = try code_arena_struct_field_layout_part_by_span(text, ast, decls, type_start, type_end, name_start, name_end, size_part, 0);
    let out_pos = scratch_base + index * 4;
    try scratch_put(args_scratch, out_pos, layout_offset);
    let size_pos = out_pos + 1;
    try scratch_put(args_scratch, size_pos, layout_size);
    let kind_pos = out_pos + 2;
    try scratch_put(args_scratch, kind_pos, layout_kind);
    let value_out_pos = out_pos + 3;
    try scratch_put(args_scratch, value_out_pos, value_eval.value_id);
    let after = index + 1;
    return try prepare_code_arena_add_struct_fields(text, ast, decls, type_start, type_end, record_pos, field_count, code, kinds, args_scratch, scratch_base, after, value_eval.next);
}

fn code_arena_struct_field_payload_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    raw_value: i64,
    layout_kind: i64,
    next_value: i64
) -> !CodeEval {
    if layout_kind == code_kind_slice() {
        return try code_arena_struct_slice_field_payload_value(text, code, kinds, raw_value, next_value);
    }
    let raw_kind = try kinds.get(raw_value);
    if raw_kind != layout_kind {
        return code_eval_unsupported(next_value);
    }
    return code_eval_value(raw_value, next_value);
}

fn code_arena_struct_slice_field_payload_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    raw_value: i64,
    next_value: i64
) -> !CodeEval {
    let slice_eval = try lower_code_arg_slice(text, code, kinds, raw_value, next_value);
    let slice_kind = try kinds.get(slice_eval.value_id);
    if slice_kind != code_kind_slice() {
        return code_eval_unsupported(slice_eval.next);
    }
    return slice_eval;
}

fn lower_code_arena_get_slice_struct_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let handle_arg = try ast.child_at(args, 0);
    let handle_eval = try lower_code_expr(text, ast, decls, handle_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !handle_eval.ok {
        return code_eval_unsupported(handle_eval.next);
    }
    let handle_kind = try kinds.get(handle_eval.value_id);
    if handle_kind != code_kind_handle() {
        return code_eval_unsupported(handle_eval.next);
    }
    let op = code_op_arena_get_slice_struct_field();
    try code.append(op);
    try code.append(handle_eval.next);
    try code.append(receiver_value);
    try code.append(handle_eval.value_id);
    let kind_slice = code_kind_slice();
    try kinds.append(kind_slice);
    let result_value = handle_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_arena_get_struct_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    args: std::kizu::ast::ChildRange,
    field_offset: i64,
    field_size: i64,
    field_kind: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let handle_arg = try ast.child_at(args, 0);
    let handle_eval = try lower_code_expr(text, ast, decls, handle_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !handle_eval.ok {
        return code_eval_unsupported(handle_eval.next);
    }
    let handle_kind = try kinds.get(handle_eval.value_id);
    if handle_kind != code_kind_handle() {
        return code_eval_unsupported(handle_eval.next);
    }
    let op = code_op_arena_get_struct_field();
    try code.append(op);
    try code.append(handle_eval.next);
    try code.append(receiver_value);
    try code.append(handle_eval.value_id);
    try code.append(field_offset);
    try code.append(field_size);
    try code.append(field_kind);
    try kinds.append(field_kind);
    let result_value = handle_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn arena_single_slice_field_value(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    record_pos: i64
) -> !i64 {
    let op = try code.get(record_pos);
    let op_struct_lit = code_op_struct_lit();
    if op != op_struct_lit {
        return 0 - 1;
    }
    let count_pos = record_pos + 4;
    let field_count = try code.get(count_pos);
    if field_count != 1 {
        return 0 - 1;
    }
    let value_pos = record_pos + 7;
    let value_id = try code.get(value_pos);
    return value_id;
}

// code_callee_union_tag resolves a call's callee against the union declarations
// without touching the tape (-1 when the callee is not a union constructor), so
// the call dispatch commits to the union path before any lowering side effect.
fn code_callee_union_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try code_callee_union_field_tag(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace),
        _ => code_assign_no_field(),
    };
}

fn code_callee_union_field_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool
) -> !i64 {
    if !namespace {
        return 0 - 1;
    }
    let union_span = code_node_span(text, ast, receiver);
    let variant_span = code_node_span(text, ast, name);
    return try union_variant_tag_lookup(text, ast, decls, union_span.start, union_span.end, variant_span.start, variant_span.end, 0);
}

// lower_code_union_call routes a call whose callee is a namespaced
// 'Union::Variant' path into the UNION_CONST construction.
fn lower_code_union_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_union_ctor(text, ast, decls, callee, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_union_ctor lowers 'Union::Variant(<payload>)': the variant must
// resolve against a union declaration (a miss keeps the tape untouched so the
// caller falls through), the single payload argument lowers to its own value,
// and the UNION_CONST record keeps the spans, tag, and payload value id.
fn lower_code_union_ctor(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if !namespace {
        return code_eval_unsupported(next_value);
    }
    let union_span = code_node_span(text, ast, receiver);
    let variant_span = code_node_span(text, ast, name);
    let tag = try union_variant_tag_lookup(text, ast, decls, union_span.start, union_span.end, variant_span.start, variant_span.end, 0);
    if tag < 0 {
        return code_eval_unsupported(next_value);
    }
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let payload_arg = try ast.child_at(args, 0);
    let payload_eval = try lower_code_expr(text, ast, decls, payload_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !payload_eval.ok {
        return code_eval_unsupported(payload_eval.next);
    }
    let qual_span = code_node_span(text, ast, callee);
    return try lower_code_union_const(qual_span.start, qual_span.end, union_span.start, union_span.end, tag, payload_eval.value_id, code, kinds, payload_eval.next);
}

// emit_code_user_call lowers the arguments into a fresh scratch frame and appends
// the CALL record for a declared user callee (shared by expression calls and
// statement calls). The frame pops back to its base once the record copies it,
// so a call nested inside another call's argument leaves its caller's frame
// intact. The result value takes a fresh i64 id whether or not it is consumed.
fn emit_code_user_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    result_kind: i64,
    next_value: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let scratch_base = try args_scratch.get(0);
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, callee_span.start, callee_span.end, 0, next_value);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    let op_call = code_op_call();
    try code.append(op_call);
    try code.append(args_eval.next);
    try code.append(callee_span.start);
    try code.append(callee_span.end);
    try code.append(args.len);
    let arg_count = args.len;
    let scratch_bound = scratch_base + arg_count;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    try kinds.append(result_kind);
    let result_value = args_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn emit_code_method_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    allow_void: bool,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try emit_code_field_method_call(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, allow_void, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn emit_code_field_method_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    allow_void: bool,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let scratch_base = try args_scratch.get(0);
    let arg_base = scratch_base + 1;
    try args_scratch.set(0, arg_base);
    let receiver_eval = try lower_code_method_receiver_arg(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    let record_base = code_kind_struct_base();
    if receiver_kind < record_base {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_record_pos = receiver_kind - record_base;
    let receiver_op = try code.get(receiver_record_pos);
    let op_struct_decl = code_op_struct_decl();
    if receiver_op != op_struct_decl {
        return code_eval_unsupported(receiver_eval.next);
    }
    let name_span = code_node_span(text, ast, name);
    let type_start = try code.get(receiver_record_pos + 1);
    let type_end = try code.get(receiver_record_pos + 2);
    let method_kind = try code_impl_method_return_kind_for_type(text, ast, decls, code, type_start, type_end, name_span.start, name_span.end, 0);
    let method_i64_ret = method_kind == 1;
    let method_record_ret = method_kind >= record_base;
    let method_void_ret = method_kind == 0;
    let method_bool_ret = method_kind == code_return_kind_bool();
    let method_slice_ret = method_kind == code_return_kind_slice();
    if method_void_ret and !allow_void {
        return code_eval_unsupported(receiver_eval.next);
    }
    if !method_i64_ret and !method_record_ret and !method_void_ret and !method_bool_ret and !method_slice_ret {
        return code_eval_unsupported(receiver_eval.next);
    }
    try scratch_put(args_scratch, scratch_base, receiver_eval.value_id);
    let no_user_callee = code_no_user_callee();
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, arg_base, no_user_callee, no_user_callee, 0, receiver_eval.next);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    let op_call = code_op_method_call();
    try code.append(op_call);
    try code.append(args_eval.next);
    try code.append(type_start);
    try code.append(type_end);
    try code.append(name_span.start);
    try code.append(name_span.end);
    let arg_count = args.len + 1;
    try code.append(arg_count);
    let scratch_bound = scratch_base + arg_count;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    var result_kind = code_return_kind_result_kind(method_kind);
    if method_kind == 0 {
        result_kind = code_kind_i64();
    }
    try kinds.append(result_kind);
    let result_value = args_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_method_receiver_arg(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let kind = try kinds.get(eval.value_id);
    let record_base = code_kind_struct_base();
    if kind >= record_base {
        return try lower_code_method_receiver_record_arg(text, code, kinds, args_scratch, eval.value_id, kind, eval.next);
    }
    return code_eval_unsupported(eval.next);
}

fn lower_code_method_receiver_record_arg(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    value_id: i64,
    kind: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    let record_pos = kind - record_base;
    let op = try code.get(record_pos);
    let op_struct_lit = code_op_struct_lit();
    if op == op_struct_lit {
        return try lower_code_method_receiver_struct_lit_arg(text, code, kinds, args_scratch, record_pos, next_value);
    }
    let op_struct_decl = code_op_struct_decl();
    if op == op_struct_decl {
        return code_eval_value(value_id, next_value);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_method_receiver_struct_lit_arg(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    record_pos: i64,
    next_value: i64
) -> !CodeEval {
    let type_start = try code.get(record_pos + 2);
    let type_end = try code.get(record_pos + 3);
    let pack_eval = try lower_code_struct_pack_from_span(text, type_start, type_end, record_pos, code, kinds, args_scratch, next_value);
    if !pack_eval.ok {
        return code_eval_unsupported(pack_eval.next);
    }
    return pack_eval;
}

// lower_code_io_blocking lowers a 'std::io::blocking()' call to the IO_BLOCKING
// record producing a '%kizu.owned' io handle value (kind owned).
fn lower_code_io_blocking(
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op_io_blocking = code_op_io_blocking();
    try code.append(op_io_blocking);
    try code.append(next_value);
    let kind_owned = code_kind_owned();
    try kinds.append(kind_owned);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// lower_code_try_expr lowers a 'try <call>' in expression position (the right-hand
// side of a let): the only error-union-yielding builtin the tape owns is
// std::fs::read_file, whose try yields the read bytes slice.
fn lower_code_try_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    call_expr: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(call_expr);
    return match node.data {
        Call(call_node) => try lower_code_try_call_expr(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Var(var_node) => try lower_code_try_box_local(text, ast, call_expr, code, kinds, local_starts, local_ends, local_values, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_try_call_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "std::fs::read_file") {
        return try lower_code_try_fs_read(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::fs::exists") {
        return try lower_code_fs_exists(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::fs::metadata") {
        return try lower_code_fs_metadata(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::mem::byte_at") {
        return try lower_code_mem_byte_at(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::mem::slice") {
        return try lower_code_mem_slice(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::path::join") {
        return try lower_code_try_path_join(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::path::clean") {
        return try lower_code_try_path_clean(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let box_kind = try code_callee_box_kind(text, ast, callee);
    if box_kind >= 0 {
        return try lower_code_try_box_call_expr(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let runtime_eval = try lower_code_try_runtime_expr_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if runtime_eval.ok {
        return runtime_eval;
    }
    // A 'try <callee>(...)' of a declared error-union-i64 function yields the
    // extracted i64 success value.
    let callee_span = code_node_span(text, ast, callee);
    let callee_kind = try code_callee_return_kind(text, ast, decls, code, callee_span.start, callee_span.end, 0);
    if callee_kind == 3 {
        return try emit_code_try_call_i64(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if callee_kind == code_return_kind_typed_error_i64() {
        return try emit_code_try_call_typed_error_i64(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    // A 'try <callee>(...)' of a declared '!std::string::String' function yields
    // the moved-out owned-String success payload.
    if callee_kind == code_return_kind_owned_string_err() {
        return try emit_code_try_call_error_owned(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value, code_kind_owned_string());
    }
    let owned_array_kind = code_error_union_array_result_kind(callee_kind);
    if owned_array_kind != code_kind_missing() {
        return try emit_code_try_call_error_owned(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value, owned_array_kind);
    }
    return code_eval_unsupported(next_value);
}

fn lower_code_try_path_join(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 3 {
        return code_eval_unsupported(next_value);
    }
    let allocator_arg = try ast.child_at(args, 0);
    let allocator_eval = try lower_code_expr(text, ast, decls, allocator_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !allocator_eval.ok {
        return code_eval_unsupported(allocator_eval.next);
    }
    let allocator_kind = try kinds.get(allocator_eval.value_id);
    if allocator_kind != code_kind_owned() {
        return code_eval_unsupported(allocator_eval.next);
    }
    let left_arg = try ast.child_at(args, 1);
    let left_eval = try lower_code_expr(text, ast, decls, left_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, allocator_eval.next);
    if !left_eval.ok {
        return code_eval_unsupported(left_eval.next);
    }
    let left_slice = try lower_code_arg_slice(text, code, kinds, left_eval.value_id, left_eval.next);
    if !left_slice.ok {
        return code_eval_unsupported(left_slice.next);
    }
    let right_arg = try ast.child_at(args, 2);
    let right_eval = try lower_code_expr(text, ast, decls, right_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, left_slice.next);
    if !right_eval.ok {
        return code_eval_unsupported(right_eval.next);
    }
    let right_slice = try lower_code_arg_slice(text, code, kinds, right_eval.value_id, right_eval.next);
    if !right_slice.ok {
        return code_eval_unsupported(right_slice.next);
    }
    return try emit_code_try_path_join(code, kinds, allocator_eval.value_id, left_slice.value_id, right_slice.value_id, right_slice.next);
}

fn lower_code_try_path_clean(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let allocator_arg = try ast.child_at(args, 0);
    let allocator_eval = try lower_code_expr(text, ast, decls, allocator_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !allocator_eval.ok {
        return code_eval_unsupported(allocator_eval.next);
    }
    let allocator_kind = try kinds.get(allocator_eval.value_id);
    if allocator_kind != code_kind_owned() {
        return code_eval_unsupported(allocator_eval.next);
    }
    let path_arg = try ast.child_at(args, 1);
    let path_eval = try lower_code_expr(text, ast, decls, path_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, allocator_eval.next);
    if !path_eval.ok {
        return code_eval_unsupported(path_eval.next);
    }
    let path_slice = try lower_code_arg_slice(text, code, kinds, path_eval.value_id, path_eval.next);
    if !path_slice.ok {
        return code_eval_unsupported(path_slice.next);
    }
    return try emit_code_try_path_clean(code, kinds, allocator_eval.value_id, path_slice.value_id, path_slice.next);
}

fn emit_code_try_path_join(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    allocator_value: i64,
    left_value: i64,
    right_value: i64,
    next_value: i64
) -> !CodeEval {
    let op = code_op_try_path_join();
    try code.append(op);
    try code.append(next_value);
    try code.append(allocator_value);
    try code.append(left_value);
    try code.append(right_value);
    try kinds.append(code_kind_owned_string());
    let after = next_value + 1;
    return code_eval_value(next_value, after);
}

fn emit_code_try_path_clean(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    allocator_value: i64,
    path_value: i64,
    next_value: i64
) -> !CodeEval {
    let op = code_op_try_path_clean();
    try code.append(op);
    try code.append(next_value);
    try code.append(allocator_value);
    try code.append(path_value);
    try kinds.append(code_kind_owned_string());
    let after = next_value + 1;
    return code_eval_value(next_value, after);
}

fn lower_code_try_box_call_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let box_new = try lower_code_box_new(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !box_new.ok {
        return code_eval_unsupported(box_new.next);
    }
    return try lower_code_try_box_value(box_new.value_id, code, kinds, box_new.next);
}

fn lower_code_try_box_local(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let name_span = code_node_span(text, ast, node_id);
    let value_id = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    if value_id < 0 {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_try_box_value(value_id, code, kinds, next_value);
}

fn lower_code_try_box_value(
    source_value: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let source_kind = try kinds.get(source_value);
    if source_kind != code_kind_error_box_i64() {
        return code_eval_unsupported(next_value);
    }
    let op_try_box_new = code_op_try_box_new();
    try code.append(op_try_box_new);
    try code.append(next_value);
    try code.append(source_value);
    let kind_box = code_kind_owned_box_i64();
    try kinds.append(kind_box);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_try_runtime_expr_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_try_runtime_field_expr_call(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_try_runtime_field_expr_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return code_eval_unsupported(next_value);
    }
    let method = ast_node_text(text, ast, name);
    let method_is_get = std::mem::equal_bytes(method, "get");
    let method_is_pop = std::mem::equal_bytes(method, "pop");
    // 'xs.at(i)' returns '!&T borrows self', but in the tape's value model a
    // read borrow followed by the identity read deref '.*' yields the element
    // value itself, so a read-use 'at' lowers exactly like 'get' (the write-use
    // 'r.* = v' path is out of scope and never reaches this element lowering).
    let method_is_at = std::mem::equal_bytes(method, "at");
    let method_is_at_mut = std::mem::equal_bytes(method, "at_mut");
    let method_supported = method_is_get or method_is_pop or method_is_at or method_is_at_mut;
    if !method_supported {
        return code_eval_unsupported(next_value);
    }
    let receiver_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !receiver_eval.ok {
        return code_eval_unsupported(receiver_eval.next);
    }
    let receiver_kind = try kinds.get(receiver_eval.value_id);
    if code_kind_is_owned_array(receiver_kind) {
        return try lower_code_try_array_get_or_pop(text, ast, decls, receiver_eval.value_id, receiver_kind, method_is_pop, method_is_at_mut, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
    }
    if method_is_pop or method_is_at or method_is_at_mut {
        return code_eval_unsupported(receiver_eval.next);
    }
    if !code_kind_is_map_handle(receiver_kind) {
        return code_eval_unsupported(receiver_eval.next);
    }
    return try lower_code_try_map_get_i64(text, ast, decls, receiver_eval.value_id, receiver_kind, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, receiver_eval.next);
}

fn lower_code_try_array_get_or_pop(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    receiver_kind: i64,
    method_is_pop: bool,
    method_is_at_mut: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if method_is_at_mut {
        return try lower_code_try_array_at_mut(text, ast, decls, receiver_value, receiver_kind, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if method_is_pop {
        return try lower_code_try_array_pop(receiver_value, receiver_kind, args, code, kinds, next_value);
    }
    return try lower_code_try_array_get(text, ast, decls, receiver_value, receiver_kind, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

fn lower_code_try_array_at_mut(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let index_arg = try ast.child_at(args, 0);
    let index_eval = try lower_code_expr(text, ast, decls, index_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !index_eval.ok {
        return code_eval_unsupported(index_eval.next);
    }
    let kind_i64 = code_kind_i64();
    let index_kind = try kinds.get(index_eval.value_id);
    if index_kind != kind_i64 {
        return code_eval_unsupported(index_eval.next);
    }
    let element_kind = try code_array_element_kind(code, receiver_kind);
    let borrow_kind = code_array_mut_borrow_kind(element_kind);
    if borrow_kind < 0 {
        return code_eval_unsupported(index_eval.next);
    }
    let result_value = index_eval.next;
    let op = code_op_try_array_at_mut();
    try code.append(op);
    try code.append(result_value);
    try code.append(receiver_value);
    try code.append(index_eval.value_id);
    try code.append(element_kind);
    try kinds.append(borrow_kind);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn code_array_mut_borrow_kind(element_kind: i64) -> i64 {
    if element_kind == code_kind_i64() {
        return code_kind_mut_borrow_i64();
    }
    if element_kind == code_kind_slice() {
        return code_kind_mut_borrow_slice();
    }
    return 0 - 1;
}

fn lower_code_try_array_pop(
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let result_value = next_value;
    let element_kind = try code_array_element_kind(code, receiver_kind);
    let op_try_array_pop = code_op_try_array_pop();
    try code.append(op_try_array_pop);
    try code.append(result_value);
    try code.append(receiver_value);
    try code.append(element_kind);
    let result_kind = try code_array_get_result_kind(code, receiver_kind);
    try kinds.append(result_kind);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_try_array_get(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let index_arg = try ast.child_at(args, 0);
    let index_eval = try lower_code_expr(text, ast, decls, index_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !index_eval.ok {
        return code_eval_unsupported(index_eval.next);
    }
    let kind_i64 = code_kind_i64();
    let index_kind = try kinds.get(index_eval.value_id);
    if index_kind != kind_i64 {
        return code_eval_unsupported(index_eval.next);
    }
    let result_value = index_eval.next;
    let element_kind = try code_array_element_kind(code, receiver_kind);
    if element_kind == kind_i64 {
        let op_try_array_get_i64 = code_op_try_array_get_i64();
        try code.append(op_try_array_get_i64);
        try code.append(result_value);
        try code.append(receiver_value);
        try code.append(index_eval.value_id);
    }
    if element_kind != kind_i64 {
        let op_try_array_get = code_op_try_array_get();
        try code.append(op_try_array_get);
        try code.append(result_value);
        try code.append(receiver_value);
        try code.append(index_eval.value_id);
        try code.append(element_kind);
    }
    let result_kind = try code_array_get_result_kind(code, receiver_kind);
    try kinds.append(result_kind);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_try_map_get_i64(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver_value: i64,
    receiver_kind: i64,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let key_arg = try ast.child_at(args, 0);
    let key_eval = try lower_code_expr(text, ast, decls, key_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !key_eval.ok {
        return code_eval_unsupported(key_eval.next);
    }
    let key_slice = try lower_code_arg_slice(text, code, kinds, key_eval.value_id, key_eval.next);
    let kind_slice = code_kind_slice();
    let key_kind = try kinds.get(key_slice.value_id);
    if key_kind != kind_slice {
        return code_eval_unsupported(key_slice.next);
    }
    let result_value = key_slice.next;
    let op = code_op_try_map_get_i64();
    try code.append(op);
    try code.append(result_value);
    try code.append(receiver_value);
    try code.append(key_slice.value_id);
    let result_kind = code_map_get_result_kind(receiver_kind);
    try kinds.append(result_kind);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_try_fs_read lowers 'try std::fs::read_file(io, path)': the io handle
// and path string lower to value ids first, then TRY_FS_READ records them with a
// fresh result value id (kind slice) for the read bytes.
fn lower_code_try_fs_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let io_arg = try ast.child_at(args, 0);
    let io_eval = try lower_code_expr(text, ast, decls, io_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !io_eval.ok {
        return code_eval_unsupported(io_eval.next);
    }
    let path_arg = try ast.child_at(args, 1);
    let path_eval = try lower_code_expr(text, ast, decls, path_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, io_eval.next);
    if !path_eval.ok {
        return code_eval_unsupported(path_eval.next);
    }
    let op_try_fs_read = code_op_try_fs_read();
    let result_value = path_eval.next;
    try code.append(op_try_fs_read);
    try code.append(result_value);
    try code.append(io_eval.value_id);
    try code.append(path_eval.value_id);
    let kind_slice = code_kind_slice();
    try kinds.append(kind_slice);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_fs_exists / lower_code_fs_metadata are thin wrappers that bind the op
// and result kind in a 'let' before the shared stat-call lowering (a compiled-MIR
// call cannot take a function-call result directly as an argument, so the op id
// must come from a local).
fn lower_code_fs_exists(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op = code_op_fs_exists();
    let result_kind = code_kind_bool();
    return try lower_code_fs_stat_call(op, result_kind, text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

fn lower_code_fs_metadata(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let op = code_op_fs_metadata();
    let result_kind = code_kind_fs_metadata();
    return try lower_code_fs_stat_call(op, result_kind, text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

// lower_code_fs_stat_call lowers the shared 'try std::fs::exists/metadata(io,
// path)' shape: the io handle lowers to a kind-owned value, the path materializes
// to a kind-slice value, and the record carries '<op> dst io path' with the
// caller's result kind appended for the extracted success value.
fn lower_code_fs_stat_call(
    op: i64,
    result_kind: i64,
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let io_arg = try ast.child_at(args, 0);
    let io_eval = try lower_code_expr(text, ast, decls, io_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !io_eval.ok {
        return code_eval_unsupported(io_eval.next);
    }
    let io_kind = try kinds.get(io_eval.value_id);
    let owned_kind = code_kind_owned();
    if io_kind != owned_kind {
        return code_eval_unsupported(io_eval.next);
    }
    let path_arg = try ast.child_at(args, 1);
    let path_eval = try lower_code_expr(text, ast, decls, path_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, io_eval.next);
    if !path_eval.ok {
        return code_eval_unsupported(path_eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, path_eval.value_id, path_eval.next);
    let path_kind = try kinds.get(slice_eval.value_id);
    let slice_kind = code_kind_slice();
    if path_kind != slice_kind {
        return code_eval_unsupported(slice_eval.next);
    }
    let result_value = slice_eval.next;
    try code.append(op);
    try code.append(result_value);
    try code.append(io_eval.value_id);
    try code.append(slice_eval.value_id);
    try kinds.append(result_kind);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_fs_create_dir lowers 'try std::fs::create_dir(io, path)' as a
// statement: like the stat calls it lowers a kind-owned io handle and a kind-slice
// path, but the record carries only '<op> io path' (no result value) because
// create_dir yields '!void'.
fn lower_code_fs_create_dir(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let io_arg = try ast.child_at(args, 0);
    let io_eval = try lower_code_expr(text, ast, decls, io_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !io_eval.ok {
        return code_eval_unsupported(io_eval.next);
    }
    let io_kind = try kinds.get(io_eval.value_id);
    let owned_kind = code_kind_owned();
    if io_kind != owned_kind {
        return code_eval_unsupported(io_eval.next);
    }
    let path_arg = try ast.child_at(args, 1);
    let path_eval = try lower_code_expr(text, ast, decls, path_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, io_eval.next);
    if !path_eval.ok {
        return code_eval_unsupported(path_eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, path_eval.value_id, path_eval.next);
    let path_kind = try kinds.get(slice_eval.value_id);
    let slice_kind = code_kind_slice();
    if path_kind != slice_kind {
        return code_eval_unsupported(slice_eval.next);
    }
    let op = code_op_fs_create_dir();
    try code.append(op);
    try code.append(io_eval.value_id);
    try code.append(slice_eval.value_id);
    return code_eval_value(0, slice_eval.next);
}

// lower_code_fs_metadata_field resolves a '.size' / '.is_dir' read on a
// '%kizu.fs.metadata' value into an FS_METADATA_FIELD record carrying the field
// index (0 = size, 1 = is_dir); the result kind is i64 for size and bool for
// is_dir.
fn lower_code_fs_metadata_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    src_value: i64,
    next_value: i64
) -> !CodeEval {
    let field_name = ast_node_text(text, ast, name);
    let field_index = fs_metadata_field_index(field_name);
    if field_index < 0 {
        return code_eval_unsupported(next_value);
    }
    let op = code_op_fs_metadata_field();
    try code.append(op);
    try code.append(next_value);
    try code.append(src_value);
    try code.append(field_index);
    let field_kind = fs_metadata_field_kind(field_index);
    try kinds.append(field_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn fs_metadata_field_index(field_name: []u8) -> i64 {
    if std::mem::equal_bytes(field_name, "size") {
        return 0;
    }
    if std::mem::equal_bytes(field_name, "is_dir") {
        return 1;
    }
    return 0 - 1;
}

fn fs_metadata_field_kind(field_index: i64) -> i64 {
    if field_index == 0 {
        return code_kind_i64();
    }
    return code_kind_bool();
}

// lower_code_args lowers each call argument into its caller's scratch frame
// [scratch_base, scratch_base + args.len): before an argument lowers, the stack
// pointer (args_scratch slot 0) moves past the argument's reserved slot so any
// nested call inside it allocates its own frame strictly above, and after it
// lowers, scratch_put writes the result id into the reserved slot (overwriting
// whatever a nested frame left there).
fn lower_code_args(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    callee_name_start: i64,
    callee_name_end: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= args.len {
        return code_eval_value(0, next_value);
    }
    let arg = try ast.child_at(args, index);
    let arg_slot = scratch_base + index;
    let next_free = arg_slot + 1;
    try args_scratch.set(0, next_free);
    // A user call whose callee param at this index is a '&var i64' or '&var []u8'
    // takes the caller var's slot address (a 'ptr'), not a loaded value, so the
    // callee writes back through it. Both 'foo(x)' and 'foo(&var x)' marshal the
    // same way here. callee_name_start < 0 (e.g. method calls) skips the probe.
    let mut_param_kind = try code_arg_callee_param_kind(text, ast, decls, callee_name_start, callee_name_end, index);
    if code_kind_is_mut_borrow_ptr(mut_param_kind) {
        return try lower_code_mut_borrow_arg_chain(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, callee_name_start, callee_name_end, arg, arg_slot, index, next_value);
    }
    let eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let arg_eval = try lower_code_arg_value(text, code, kinds, args_scratch, eval.value_id, eval.next);
    try scratch_put(args_scratch, arg_slot, arg_eval.value_id);
    let after = index + 1;
    return try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, callee_name_start, callee_name_end, after, arg_eval.next);
}

// lower_code_mut_borrow_arg_chain marshals one pointer-backed '&var' argument as
// a caller-slot pointer, records it in the scratch row, and continues lowering
// the remaining arguments. It is a single-statement tail of lower_code_args's
// mut-borrow branch so each then-body stays a lone 'return try <call>'.
fn lower_code_mut_borrow_arg_chain(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    callee_name_start: i64,
    callee_name_end: i64,
    arg: std::kizu::ast::NodeId,
    arg_slot: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let mb_eval = try lower_code_mut_borrow_call_arg(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !mb_eval.ok {
        return code_eval_unsupported(mb_eval.next);
    }
    try scratch_put(args_scratch, arg_slot, mb_eval.value_id);
    let after_mut = index + 1;
    return try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, callee_name_start, callee_name_end, after_mut, mb_eval.next);
}

// code_no_user_callee is the sentinel callee-name-start a method call passes to
// lower_code_args so the pointer-backed '&var' caller-slot probe is skipped
// (method params are out of this PR's scope). It is a call, not an inline
// '0 - 1', so the argument the call site forwards stays a plain local (the
// compiled call-arg lowering rejects a bare arithmetic literal as a positional
// argument).
fn code_no_user_callee() -> i64 {
    return 0 - 1;
}

// code_arg_callee_param_kind returns the tape kind of the callee's parameter at
// param_index for a user call, or -1 when the callee is unknown (method calls
// pass callee_name_start < 0) or the parameter is not resolvable. It is a pure
// text probe over the declaration's parameter types (no tape side effects), used
// only to detect scalar '&var i64' parameters for caller-slot pointer passing.
fn code_arg_callee_param_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee_name_start: i64,
    callee_name_end: i64,
    param_index: i64
) -> !i64 {
    if callee_name_start < 0 {
        return 0 - 1;
    }
    return try code_callee_param_kind(text, ast, decls, callee_name_start, callee_name_end, param_index, 0);
}

// lower_code_mut_borrow_call_arg marshals one pointer-backed '&var' argument: a
// bare var takes its slot address, and an explicit '&var <var>' prefix lowers
// through the prefix arm. Handle-backed mutable borrows such as String skip this
// branch because their parameter kind is the handle kind, not a pointer kind.
fn lower_code_mut_borrow_call_arg(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    arg: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(arg);
    return match node.data {
        Var(var_node) => try lower_code_mut_borrow_value(text, ast, arg, code, kinds, local_starts, local_ends, local_values, locals_base, next_value),
        Prefix(prefix_node) => try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// code_callee_param_kind scans the program declarations for the named function
// and returns the read-borrow kind text of its parameter at param_index (the
// dual of code_callee_return_kind for parameters). -2 from a declaration means
// "not this function, keep scanning"; -1 means resolved but not a borrow kind.
fn code_callee_param_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    name_start: i64,
    name_end: i64,
    param_index: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let kind = try code_decl_param_kind(text, ast, child, name_start, name_end, param_index);
    let after = index + 1;
    if kind > 0 - 2 {
        return kind;
    }
    return try code_callee_param_kind(text, ast, decls, name_start, name_end, param_index, after);
}

fn code_decl_param_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    name_start: i64,
    name_end: i64,
    param_index: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        FnDecl(fn_decl) => try code_fn_decl_param_kind(text, ast, fn_decl.name, fn_decl.params, name_start, name_end, param_index),
        _ => code_decl_kind_skip(),
    };
}

fn code_fn_decl_param_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    name_start: i64,
    name_end: i64,
    param_index: i64
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let callee_name = text[name_start..name_end];
    if !std::mem::equal_bytes(decl_name, callee_name) {
        return 0 - 2;
    }
    if param_index >= params.len {
        return 0 - 1;
    }
    let param_child = try ast.child_at(params, param_index);
    return try code_param_node_borrow_kind(text, ast, param_child);
}

fn code_param_node_borrow_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    param_child: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(param_child);
    return match node.data {
        Param(param) => code_param_borrow_text_kind(text, ast, param.type_node),
        _ => code_unbound_slot(),
    };
}

fn code_param_borrow_text_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> i64 {
    let type_text = ast_node_text(text, ast, type_node);
    return read_borrow_referent_kind(type_text);
}

// lower_code_arg_value materializes values that cross a user-call boundary:
// string literals become runtime slices, UNION_CONST records become runtime
// union aggregates, and STRUCT_LIT records become declaration-order struct
// aggregates.
fn lower_code_arg_value(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let arg_kind = try kinds.get(value_id);
    let record_base = code_kind_struct_base();
    if arg_kind < record_base {
        return try lower_code_arg_slice(text, code, kinds, value_id, next_value);
    }
    let record_pos = arg_kind - record_base;
    let op = try code.get(record_pos);
    let op_struct_lit = code_op_struct_lit();
    if op == op_struct_lit {
        return try lower_code_method_receiver_struct_lit_arg(text, code, kinds, args_scratch, record_pos, next_value);
    }
    let op_var_struct = code_op_var_struct();
    if op == op_var_struct {
        return try lower_code_var_struct_arg(text, code, kinds, args_scratch, value_id, arg_kind, next_value);
    }
    return try lower_code_arg_slice(text, code, kinds, value_id, next_value);
}

fn lower_code_var_struct_arg(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    value_id: i64,
    value_kind: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    let record_pos = value_kind - record_base;
    let type_start = try code.get(record_pos + 2);
    let type_end = try code.get(record_pos + 3);
    let decl_pos = try struct_decl_pos_by_span(text, code, type_start, type_end, 0);
    if decl_pos < 0 {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_struct_pack_from_decl(text, decl_pos, value_id, value_kind, code, kinds, args_scratch, next_value);
}

// lower_code_arg_slice materializes a string argument (kind str, a CONST_STR
// global) as a runtime slice value through a STR_SLICE record, so a user call
// passes every argument as a typed SSA value. Arguments of any other kind pass
// through unchanged.
fn lower_code_arg_slice(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    // 'arg_kind' (not 'kind') keeps the binding clear of the '<name>_slice' temp
    // names the compiled Array.get lowering derives from it.
    let arg_kind = try kinds.get(value_id);
    let kind_str = code_kind_str();
    let record_base = code_kind_struct_base();
    if arg_kind >= record_base {
        return try lower_code_arg_record(text, code, kinds, value_id, arg_kind, next_value);
    }
    if arg_kind != kind_str {
        return code_eval_value(value_id, next_value);
    }
    let op_str_slice = code_op_str_slice();
    try code.append(op_str_slice);
    try code.append(next_value);
    try code.append(value_id);
    let slice_kind = code_kind_slice();
    try kinds.append(slice_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// lower_code_arg_record converts a record-backed value at a boundary: a
// UNION_CONST packs into the runtime union aggregate (the UNION_DECL resolved
// through the record's union name span); any other record-backed value passes
// through unchanged.
fn lower_code_arg_record(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    value_id: i64,
    arg_kind: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    let record_pos = arg_kind - record_base;
    let op = try code.get(record_pos);
    let op_union_const = code_op_union_const();
    if op != op_union_const {
        return code_eval_value(value_id, next_value);
    }
    let union_start_pos = record_pos + 4;
    let union_start = try code.get(union_start_pos);
    let union_end_pos = record_pos + 5;
    let union_end = try code.get(union_end_pos);
    let decl_pos = try union_decl_pos_by_span(text, code, union_start, union_end, 0);
    if decl_pos < 0 {
        return code_eval_unsupported(next_value);
    }
    let payload_pos = record_pos + 7;
    let raw_payload = try code.get(payload_pos);
    let payload_eval = try lower_code_union_arg_payload(text, code, kinds, raw_payload, next_value);
    if !payload_eval.ok {
        return code_eval_unsupported(payload_eval.next);
    }
    return try lower_code_union_pack(code, kinds, value_id, payload_eval.value_id, decl_pos, payload_eval.next);
}

// lower_code_union_arg_payload materializes a UNION_CONST's payload for the
// pack: a str payload converts to its slice; a missing payload (-1) passes
// through so the pack records the payload-less shape.
fn lower_code_union_arg_payload(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    payload_value: i64,
    next_value: i64
) -> !CodeEval {
    if payload_value < 0 {
        return code_eval_value(payload_value, next_value);
    }
    return try lower_code_arg_slice(text, code, kinds, payload_value, next_value);
}

// lower_code_union_pack appends the UNION_PACK record building a runtime union
// value from its tag value (the UNION_CONST dst renders as the i64 tag) and
// payload; the dst's kind references the union's UNION_DECL record.
fn lower_code_union_pack(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    tag_value: i64,
    payload_value: i64,
    decl_pos: i64,
    next_value: i64
) -> !CodeEval {
    let payload_kind = try union_pack_payload_kind(kinds, payload_value);
    let op_union_pack = code_op_union_pack();
    try code.append(op_union_pack);
    try code.append(next_value);
    try code.append(tag_value);
    try code.append(payload_value);
    try code.append(payload_kind);
    let record_base = code_kind_struct_base();
    let union_kind = record_base + decl_pos;
    try kinds.append(union_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// union_pack_payload_kind reads the packed payload's value kind (0 marks the
// payload-less shape).
fn union_pack_payload_kind(
    kinds: &var std::array::Array<i64>,
    payload_value: i64
) -> !i64 {
    if payload_value < 0 {
        return 0;
    }
    let payload_kind = try kinds.get(payload_value);
    return payload_kind;
}

// scratch_put stores value into stack slot pos, growing the array first when a
// reserved slot has not been written yet (a slot is written only after its
// argument lowers, so the array may still be shorter than pos).
fn scratch_put(
    args_scratch: &var std::array::Array<i64>,
    pos: i64,
    value: i64
) -> !void {
    try scratch_grow(args_scratch, pos);
    try args_scratch.set(pos, value);
    return;
}

// scratch_grow appends zero slots until the stack array covers slot pos.
fn scratch_grow(
    args_scratch: &var std::array::Array<i64>,
    pos: i64
) -> !void {
    let used = args_scratch.len();
    if used > pos {
        return;
    }
    try args_scratch.append(0);
    try scratch_grow(args_scratch, pos);
    return;
}

// copy_code_args copies one call's scratch frame [index, bound) onto the tape.
fn copy_code_args(
    code: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    index: i64,
    bound: i64
) -> !void {
    if index >= bound {
        return;
    }
    let value = try args_scratch.get(index);
    try code.append(value);
    let after = index + 1;
    try copy_code_args(code, args_scratch, after, bound);
    return;
}

// code_callee_return_kind scans the top-level declarations for the function
// whose name matches the callee span and classifies its declared return type.
fn code_callee_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let kind = try code_decl_return_kind(text, ast, child, code, name_start, name_end);
    let after = index + 1;
    if kind > 0 - 2 {
        return kind;
    }
    return try code_callee_return_kind(text, ast, decls, code, name_start, name_end, after);
}

fn code_method_call_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    callee: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try code_field_method_return_kind(text, ast, decls, code, field_expr.name, field_expr.namespace),
        _ => code_kind_missing(),
    };
}

fn code_field_method_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    name: std::kizu::ast::NodeId,
    namespace: bool
) -> !i64 {
    if namespace {
        return 0 - 1;
    }
    let name_span = code_node_span(text, ast, name);
    return try code_impl_method_return_kind(text, ast, decls, code, name_span.start, name_span.end, 0);
}

fn code_impl_method_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let kind = try code_impl_decl_method_return_kind(text, ast, child, code, name_start, name_end);
    let after = index + 1;
    if kind > 0 - 2 {
        return kind;
    }
    return try code_impl_method_return_kind(text, ast, decls, code, name_start, name_end, after);
}

fn code_impl_method_return_kind_for_type(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    type_start: i64,
    type_end: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let kind = try code_impl_decl_method_return_kind_for_type(text, ast, child, code, type_start, type_end, name_start, name_end);
    let after = index + 1;
    if kind > 0 - 2 {
        return kind;
    }
    return try code_impl_method_return_kind_for_type(text, ast, decls, code, type_start, type_end, name_start, name_end, after);
}

fn code_impl_decl_method_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        ImplDecl(impl_decl) => try code_impl_methods_return_kind(text, ast, impl_decl.methods, code, name_start, name_end, 0),
        _ => code_decl_kind_skip(),
    };
}

fn code_impl_decl_method_return_kind_for_type(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    type_start: i64,
    type_end: i64,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        ImplDecl(impl_decl) => try code_impl_methods_return_kind_for_type(text, ast, impl_decl.type_name, impl_decl.methods, code, type_start, type_end, name_start, name_end),
        _ => code_decl_kind_skip(),
    };
}

fn code_impl_methods_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    methods: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= methods.len {
        return code_decl_kind_skip();
    }
    let method = try ast.child_at(methods, index);
    let kind = try code_impl_method_decl_return_kind(text, ast, method, code, name_start, name_end);
    let after = index + 1;
    if kind > 0 - 2 {
        return kind;
    }
    return try code_impl_methods_return_kind(text, ast, methods, code, name_start, name_end, after);
}

fn code_impl_methods_return_kind_for_type(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_name: std::kizu::ast::NodeId,
    methods: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    type_start: i64,
    type_end: i64,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let impl_type = ast_node_text(text, ast, type_name);
    let wanted_type = text[type_start..type_end];
    if !std::mem::equal_bytes(impl_type, wanted_type) {
        return code_decl_kind_skip();
    }
    return try code_impl_methods_return_kind(text, ast, methods, code, name_start, name_end, 0);
}

fn code_impl_method_decl_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    method: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let node = ast.get(method);
    return match node.data {
        FnDecl(fn_decl) => try code_fn_decl_return_kind(text, ast, fn_decl.name, fn_decl.return_type, code, name_start, name_end),
        _ => code_decl_kind_skip(),
    };
}

// code_decl_return_kind classifies one declaration against the callee name span:
// -2 = not the named function (keep scanning), otherwise its return kind.
fn code_decl_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        FnDecl(fn_decl) => try code_fn_decl_return_kind(text, ast, fn_decl.name, fn_decl.return_type, code, name_start, name_end),
        _ => code_decl_kind_skip(),
    };
}

fn code_decl_kind_skip() -> i64 {
    return 0 - 2;
}

fn code_kind_missing() -> i64 {
    return 0 - 1;
}

// code_fn_decl_return_kind classifies one declaration against the callee name:
// -2 = the names differ (keep scanning), otherwise the declaration's return
// kind through code_return_kind.
fn code_fn_decl_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let callee_name = text[name_start..name_end];
    if !std::mem::equal_bytes(decl_name, callee_name) {
        return 0 - 2;
    }
    let ret_kind = try code_return_kind(text, ast, return_type, code);
    return ret_kind;
}
