pub enum ValueKind {
    None,
    ConstString,
    FsReadBytes,
}

pub struct Value {
    pub kind: ValueKind,
    pub name: []u8,
    pub string_payload: []u8,
}

pub enum InstructionKind {
    None,
    ConstString,
    Call,
    ReturnVoid,
}

pub struct Instruction {
    pub kind: InstructionKind,
    pub result_kind: ValueKind,
    pub result_name: []u8,
    pub result_payload: []u8,
    pub callee: []u8,
    pub argument_kind: ValueKind,
    pub argument_name: []u8,
    pub argument_payload: []u8,
}

pub struct CodegenBlock {
    pub label: []u8,
    pub instruction_count: i64,
}

pub struct CodegenFunction {
    pub name: []u8,
    pub block_count: i64,
}

pub struct Program {
    pub function_count: i64,
    pub function_name: []u8,
    pub block_count: i64,
    pub block_label: []u8,
    pub instruction_count: i64,
    pub first_kind: InstructionKind,
    pub first_result_kind: ValueKind,
    pub first_result_name: []u8,
    pub first_result_payload: []u8,
    pub second_kind: InstructionKind,
    pub second_callee: []u8,
    pub second_argument_kind: ValueKind,
    pub second_argument_name: []u8,
    pub second_argument_payload: []u8,
    pub third_kind: InstructionKind,
    pub from_codegen_lowering: bool,
    pub i64_function_name: []u8,
    pub i64_param_count: i64,
    pub i64_return_op: RunBinaryOp,
    pub i64_call_callee: []u8,
    pub i64_call_arg0: i64,
    pub i64_call_arg1: i64,
    pub loop_start_value: i64,
    pub loop_bound: i64,
    pub loop_continue_value: i64,
    pub loop_break_value: i64,
}

pub enum RunStatementKind {
    None,
    Print,
    ReturnVoid,
    TryVoidPrintReturn,
    LoopI64Print,
    FsReadPrintReturn,
}

pub enum RunArgumentKind {
    None,
    ConstString,
    I64Call,
    FsReadFile,
}

pub enum RunBinaryOp {
    None,
    Add,
    Sub,
    Mul,
    Div,
}

pub struct RunAst {
    pub ok: bool,
    pub function_count: i64,
    pub function_name: []u8,
    pub block_count: i64,
    pub statement_count: i64,
    pub final_statement_kind: RunStatementKind,
    pub final_callee: []u8,
    pub final_argument_kind: RunArgumentKind,
    pub final_argument_payload: []u8,
    pub i64_function_name: []u8,
    pub i64_param_count: i64,
    pub i64_return_op: RunBinaryOp,
    pub i64_call_callee: []u8,
    pub i64_call_arg0: i64,
    pub i64_call_arg1: i64,
    pub loop_start_value: i64,
    pub loop_bound: i64,
    pub loop_continue_value: i64,
    pub loop_break_value: i64,
}

pub fn main_print_program(payload: []u8) -> Program {
    return build_main_print_program(payload, false);
}

fn lowered_main_print_program(payload: []u8) -> Program {
    return build_main_print_program(payload, true);
}

fn build_main_print_program(payload: []u8, from_codegen_lowering: bool) -> Program {
    let function = CodegenFunction {
        name: "main",
        block_count: 1
    };
    let block = CodegenBlock {
        label: "entry",
        instruction_count: 3
    };
    let value = const_string_value("s0", payload);
    let first = const_string_instruction(value);
    let argument = const_string_value("s0", payload);
    let second = call_instruction("print", argument);
    let third = return_void_instruction();
    return Program {
        function_count: 1,
        function_name: function.name,
        block_count: function.block_count,
        block_label: block.label,
        instruction_count: block.instruction_count,
        first_kind: first.kind,
        first_result_kind: first.result_kind,
        first_result_name: first.result_name,
        first_result_payload: first.result_payload,
        second_kind: second.kind,
        second_callee: second.callee,
        second_argument_kind: second.argument_kind,
        second_argument_name: second.argument_name,
        second_argument_payload: second.argument_payload,
        third_kind: third.kind,
        from_codegen_lowering: from_codegen_lowering,
        i64_function_name: payload[0..0],
        i64_param_count: 0,
        i64_return_op: RunBinaryOp::None,
        i64_call_callee: payload[0..0],
        i64_call_arg0: 0,
        i64_call_arg1: 0,
        loop_start_value: 0,
        loop_bound: 0,
        loop_continue_value: 0,
        loop_break_value: 0
    };
}

pub fn unsupported_program(empty: []u8) -> Program {
    return Program {
        function_count: 0,
        function_name: empty[0..0],
        block_count: 0,
        block_label: empty[0..0],
        instruction_count: 0,
        first_kind: InstructionKind::None,
        first_result_kind: ValueKind::None,
        first_result_name: empty[0..0],
        first_result_payload: empty[0..0],
        second_kind: InstructionKind::None,
        second_callee: empty[0..0],
        second_argument_kind: ValueKind::None,
        second_argument_name: empty[0..0],
        second_argument_payload: empty[0..0],
        third_kind: InstructionKind::None,
        from_codegen_lowering: false,
        i64_function_name: empty[0..0],
        i64_param_count: 0,
        i64_return_op: RunBinaryOp::None,
        i64_call_callee: empty[0..0],
        i64_call_arg0: 0,
        i64_call_arg1: 0,
        loop_start_value: 0,
        loop_bound: 0,
        loop_continue_value: 0,
        loop_break_value: 0
    };
}

pub fn program_supported(program: &Program) -> bool {
    if main_print_payload(program).kind == ValueKind::ConstString {
        return true;
    }
    if return_void_program_supported(program) {
        return true;
    }
    if try_void_program_supported(program) {
        return true;
    }
    if loop_i64_program_supported(program) {
        return true;
    }
    if fs_read_program_supported(program) {
        return true;
    }
    if program.function_count != 2 {
        return false;
    }
    if !std::mem::equal_bytes(program.function_name, "main") {
        return false;
    }
    if program.i64_param_count != 2 {
        return false;
    }
    if std::mem::len(program.i64_function_name) == 0 {
        return false;
    }
    if !std::mem::equal_bytes(program.i64_function_name, program.i64_call_callee) {
        return false;
    }
    return program.i64_return_op == RunBinaryOp::Add or
        program.i64_return_op == RunBinaryOp::Sub or
        program.i64_return_op == RunBinaryOp::Mul or
        program.i64_return_op == RunBinaryOp::Div;
}

pub fn lowered_program_supported(program: &Program) -> bool {
    return program_supported(program) and program.from_codegen_lowering;
}

pub fn require_main_print(program: &Program) -> !void {
    let payload = main_print_payload(program);
    if payload.kind != ValueKind::ConstString {
        return error("unsupported codegen program");
    }
    if !std::mem::equal_bytes(program.function_name, "main") {
        return error("unsupported codegen function");
    }
    return;
}

pub fn require_lowered_main_print(program: &Program) -> !void {
    try require_main_print(program);
    if !program.from_codegen_lowering {
        return error("codegen program was not produced by checked AST lowering");
    }
    return;
}

pub fn stdout_payload(program: &Program) -> ![]u8 {
    let payload = main_print_payload(program);
    if payload.kind == ValueKind::ConstString {
        return payload.string_payload;
    }
    if try_void_program_supported(program) {
        return program.second_argument_payload;
    }
    return error("unsupported codegen stdout payload");
}

pub fn fs_read_program_supported(program: &Program) -> bool {
    if program.function_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(program.function_name, "main") {
        return false;
    }
    if program.block_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(program.block_label, "entry") {
        return false;
    }
    if program.instruction_count != 4 {
        return false;
    }
    if program.first_kind != InstructionKind::Call {
        return false;
    }
    if program.first_result_kind != ValueKind::FsReadBytes {
        return false;
    }
    if std::mem::len(program.first_result_payload) == 0 {
        return false;
    }
    if program.second_kind != InstructionKind::Call {
        return false;
    }
    if !std::mem::equal_bytes(program.second_callee, "print") {
        return false;
    }
    if program.second_argument_kind != ValueKind::FsReadBytes {
        return false;
    }
    if !std::mem::equal_bytes(program.first_result_name, program.second_argument_name) {
        return false;
    }
    return program.third_kind == InstructionKind::ReturnVoid;
}

pub fn i64_call_program_supported(program: &Program) -> bool {
    if program.function_count != 2 {
        return false;
    }
    if !std::mem::equal_bytes(program.function_name, "main") {
        return false;
    }
    if program.i64_param_count != 2 {
        return false;
    }
    if std::mem::len(program.i64_function_name) == 0 {
        return false;
    }
    if !std::mem::equal_bytes(program.i64_function_name, program.i64_call_callee) {
        return false;
    }
    return program.i64_return_op == RunBinaryOp::Add or
        program.i64_return_op == RunBinaryOp::Sub or
        program.i64_return_op == RunBinaryOp::Mul or
        program.i64_return_op == RunBinaryOp::Div;
}

pub fn return_void_program_supported(program: &Program) -> bool {
    if program.function_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(program.function_name, "main") {
        return false;
    }
    if program.block_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(program.block_label, "entry") {
        return false;
    }
    if program.instruction_count != 1 {
        return false;
    }
    if program.first_kind != InstructionKind::None {
        return false;
    }
    if program.second_kind != InstructionKind::None {
        return false;
    }
    return program.third_kind == InstructionKind::ReturnVoid;
}

pub fn try_void_program_supported(program: &Program) -> bool {
    if program.function_count != 2 {
        return false;
    }
    if !std::mem::equal_bytes(program.function_name, "main") {
        return false;
    }
    if program.block_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(program.block_label, "entry") {
        return false;
    }
    if program.instruction_count != 3 {
        return false;
    }
    if program.first_kind != InstructionKind::Call {
        return false;
    }
    if program.first_result_kind != ValueKind::None {
        return false;
    }
    if program.second_kind != InstructionKind::Call {
        return false;
    }
    if !std::mem::equal_bytes(program.second_callee, "print") {
        return false;
    }
    if program.second_argument_kind != ValueKind::ConstString {
        return false;
    }
    if program.third_kind != InstructionKind::ReturnVoid {
        return false;
    }
    if program.i64_param_count != 0 {
        return false;
    }
    if std::mem::len(program.i64_function_name) == 0 {
        return false;
    }
    if !std::mem::equal_bytes(program.i64_function_name, program.i64_call_callee) {
        return false;
    }
    return program.i64_call_arg0 == 0 or program.i64_call_arg0 == 1;
}

pub fn loop_i64_program_supported(program: &Program) -> bool {
    if program.function_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(program.function_name, "main") {
        return false;
    }
    if program.block_count != 4 {
        return false;
    }
    if !std::mem::equal_bytes(program.block_label, "entry") {
        return false;
    }
    if program.instruction_count != 0 {
        return false;
    }
    if program.first_kind != InstructionKind::None {
        return false;
    }
    if program.second_kind != InstructionKind::None {
        return false;
    }
    if program.third_kind != InstructionKind::ReturnVoid {
        return false;
    }
    if program.loop_start_value < 0 {
        return false;
    }
    if program.loop_bound <= program.loop_start_value {
        return false;
    }
    if program.loop_continue_value < program.loop_start_value or
        program.loop_break_value < program.loop_start_value {
        return false;
    }
    if program.loop_continue_value >= program.loop_bound or program.loop_break_value >= program.loop_bound {
        return false;
    }
    if program.loop_continue_value == program.loop_break_value {
        return false;
    }
    return true;
}

pub fn metadata_for_program(program: &Program) -> []u8 {
    if program.from_codegen_lowering {
        return metadata_line();
    }
    return "none";
}

fn main_print_payload(program: &Program) -> Value {
    if program.function_count != 1 or program.block_count != 1 {
        return none_value(program.function_name);
    }
    if !std::mem::equal_bytes(program.block_label, "entry") {
        return none_value(program.function_name);
    }
    if program.instruction_count != 3 {
        return none_value(program.function_name);
    }
    if program.first_kind != InstructionKind::ConstString {
        return none_value(program.function_name);
    }
    if program.second_kind != InstructionKind::Call or !std::mem::equal_bytes(program.second_callee, "print") {
        return none_value(program.function_name);
    }
    if program.third_kind != InstructionKind::ReturnVoid {
        return none_value(program.function_name);
    }
    if program.first_result_kind != ValueKind::ConstString or program.second_argument_kind != ValueKind::ConstString {
        return none_value(program.function_name);
    }
    if !std::mem::equal_bytes(program.first_result_name, program.second_argument_name) {
        return none_value(program.function_name);
    }
    return const_string_value(program.first_result_name, program.first_result_payload);
}

fn const_string_value(name: []u8, payload: []u8) -> Value {
    return Value {
        kind: ValueKind::ConstString,
        name: name,
        string_payload: payload
    };
}

fn none_value(empty: []u8) -> Value {
    return Value {
        kind: ValueKind::None,
        name: empty[0..0],
        string_payload: empty[0..0]
    };
}

fn const_string_instruction(value: Value) -> Instruction {
    return Instruction {
        kind: InstructionKind::ConstString,
        result_kind: value.kind,
        result_name: value.name,
        result_payload: value.string_payload,
        callee: "",
        argument_kind: ValueKind::None,
        argument_name: value.name[0..0],
        argument_payload: value.string_payload[0..0]
    };
}

fn call_instruction(callee: []u8, argument: Value) -> Instruction {
    return Instruction {
        kind: InstructionKind::Call,
        result_kind: ValueKind::None,
        result_name: callee[0..0],
        result_payload: callee[0..0],
        callee: callee,
        argument_kind: argument.kind,
        argument_name: argument.name,
        argument_payload: argument.string_payload
    };
}

fn return_void_instruction() -> Instruction {
    return Instruction {
        kind: InstructionKind::ReturnVoid,
        result_kind: ValueKind::None,
        result_name: "",
        result_payload: "",
        callee: "",
        argument_kind: ValueKind::None,
        argument_name: "",
        argument_payload: ""
    };
}

pub fn lower_run_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    scratch: &var std::string::String
) -> !Program {
    let run_ast = try lower_run_ast(text, ast, root);
    let string_program = lower_run_ast_to_program(text, &run_ast);
    if program_supported(&string_program) {
        return string_program;
    }
    return try lower_run_int_program(scratch, text, ast, root);
}

pub fn lower_run_parse_result(
    text: []u8,
    parsed: std::kizu::ast::ParseResult
) -> !RunAst {
    let run_ast = try lower_run_ast(text, parsed.ast, parsed.root);
    return run_ast;
}

pub fn lower_run_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !RunAst {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_run_ast_declarations(text, ast, program.declarations),
        _ => unsupported_run_ast(text[0..0]),
    };
}

fn lower_run_ast_declarations(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !RunAst {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let run_ast = match node.data {
            FnDecl(fn_decl) => try lower_run_ast_function(
                text,
                ast,
                declarations,
                fn_decl.name,
                fn_decl.body
            ),
            _ => unsupported_run_ast(text[0..0]),
        };
        if run_ast_supported(&run_ast) {
            return run_ast;
        }
        index = index + 1;
    }
    return unsupported_run_ast(text[0..0]);
}

fn lower_run_ast_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !RunAst {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "main") {
        return unsupported_run_ast(text[0..0]);
    }

    let node = ast.get(body);
    return match node.data {
        Block(block) => try lower_run_ast_block(
            text,
            ast,
            declarations,
            ast_node_text(text, ast, name),
            block.statements
        ),
        _ => unsupported_run_ast(text[0..0]),
    };
}

struct LocalBinding {
    name: []u8,
    payload_start: i64,
    payload_end: i64,
}

struct LocalTable {
    count: i64,
    first: LocalBinding,
    second: LocalBinding,
}

fn lower_run_ast_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8,
    statements: std::kizu::ast::ChildRange
) -> !RunAst {
    let fs_read = try lower_fs_read_block(text, ast, function_name, statements);
    if fs_read.ok {
        return fs_read;
    }
    let try_void = try lower_try_void_block(text, ast, declarations, function_name, statements);
    if try_void.ok {
        return try_void;
    }
    let loop_i64 = try lower_loop_i64_block(text, ast, function_name, statements);
    if loop_i64.ok {
        return loop_i64;
    }

    var locals = empty_local_table(text);
    var index = 0;
    while index < statements.len {
        let statement = try ast.child_at(statements, index);
        let node = ast.get(statement);
        let terminal = index + 1 == statements.len;
        if !terminal {
            let binding = match node.data {
                Let(let_node) => lower_let_binding(text, ast, &locals, let_node.name, let_node.value),
                _ => empty_local(text),
            };
            if std::mem::len(binding.name) == 0 {
                return unsupported_run_ast(text[0..0]);
            }
            locals = insert_local(text, &locals, &binding);
            index = index + 1;
        } else {
            return match node.data {
                ExprStmt(expr_stmt) => try lower_print_statement(
                    text,
                    ast,
                    declarations,
                    function_name,
                    statements.len,
                    &locals,
                    expr_stmt.expr
                ),
                Return(return_node) => lower_return_void_statement(
                    text,
                    ast,
                    function_name,
                    statements.len,
                    return_node.value
                ),
                _ => unsupported_run_ast(text[0..0]),
            };
        }
    }
    return unsupported_run_ast(text[0..0]);
}

struct FsReadBinding {
    name: []u8,
    path_start: i64,
    path_end: i64,
}

fn lower_fs_read_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statements: std::kizu::ast::ChildRange
) -> !RunAst {
    if statements.len != 4 {
        return unsupported_run_ast(text[0..0]);
    }
    let io_statement = try ast.child_at(statements, 0);
    let io_name = fs_io_binding_name(text, ast, io_statement);
    if std::mem::len(io_name) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let read_statement = try ast.child_at(statements, 1);
    let read_binding = try fs_read_binding(text, ast, read_statement, io_name);
    if std::mem::len(read_binding.name) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let print_statement = try ast.child_at(statements, 2);
    if !(try fs_read_print_statement_ok(text, ast, print_statement, read_binding.name)) {
        return unsupported_run_ast(text[0..0]);
    }
    let return_statement = try ast.child_at(statements, 3);
    if !return_void_statement_ok(ast, return_statement) {
        return unsupported_run_ast(text[0..0]);
    }
    let path = text[read_binding.path_start..read_binding.path_end];
    return fs_read_run_ast(function_name, statements.len, "print", path);
}

fn fs_io_binding_name(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(statement);
    match node.data {
        Let(let_node) => return fs_io_let_name(
            text,
            ast,
            let_node.mutable,
            let_node.name,
            let_node.value
        );,
        _ => return text[0..0];,
    }
}

fn fs_io_let_name(
    text: []u8,
    ast: std::kizu::ast::Ast,
    mutable: bool,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> []u8 borrows text {
    if mutable {
        return text[0..0];
    }
    if !zero_arg_call_named(text, ast, value, "std::io::blocking") {
        return text[0..0];
    }
    return ast_node_text(text, ast, name);
}

fn fs_read_binding(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    io_name: []u8
) -> !FsReadBinding {
    let node = ast.get(statement);
    match node.data {
        Let(let_node) => return try fs_read_let_binding(
            text,
            ast,
            let_node.mutable,
            let_node.name,
            let_node.value,
            io_name
        );,
        _ => return empty_fs_read_binding(text);,
    }
}

fn fs_read_let_binding(
    text: []u8,
    ast: std::kizu::ast::Ast,
    mutable: bool,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    io_name: []u8
) -> !FsReadBinding {
    if mutable {
        return empty_fs_read_binding(text);
    }
    let local_name = ast_node_text(text, ast, name);
    if std::mem::len(local_name) == 0 or std::mem::equal_bytes(local_name, io_name) {
        return empty_fs_read_binding(text);
    }
    let path = try fs_read_try_path(text, ast, value, io_name);
    if path.start < 0 {
        return empty_fs_read_binding(text);
    }
    return FsReadBinding {
        name: local_name,
        path_start: path.start,
        path_end: path.end
    };
}

fn fs_read_try_path(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    io_name: []u8
) -> !PayloadSpan {
    let node = ast.get(value);
    match node.data {
        TryExpr(try_expr) => return try fs_read_call_path(text, ast, try_expr.value, io_name);,
        _ => return empty_payload_span();,
    }
}

fn fs_read_call_path(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    io_name: []u8
) -> !PayloadSpan {
    let node = ast.get(value);
    match node.data {
        Call(call_node) => return try fs_read_call_args_path(
            text,
            ast,
            call_node.callee,
            call_node.args,
            io_name
        );,
        _ => return empty_payload_span();,
    }
}

fn fs_read_call_args_path(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    io_name: []u8
) -> !PayloadSpan {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "std::fs::read_file") {
        return empty_payload_span();
    }
    if args.len != 2 {
        return empty_payload_span();
    }
    let io_arg = try ast.child_at(args, 0);
    if !node_text_is_var(text, ast, io_arg, io_name) {
        return empty_payload_span();
    }
    let path_arg = try ast.child_at(args, 1);
    return string_literal_span(text, ast, path_arg);
}

fn fs_read_print_statement_ok(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    local_name: []u8
) -> !bool {
    let node = ast.get(statement);
    match node.data {
        ExprStmt(expr_stmt) => return try fs_read_print_expr_ok(text, ast, expr_stmt.expr, local_name);,
        _ => return false;,
    }
}

fn fs_read_print_expr_ok(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    local_name: []u8
) -> !bool {
    let node = ast.get(expr);
    match node.data {
        Call(call_node) => return try fs_read_print_call_ok(
            text,
            ast,
            call_node.callee,
            call_node.args,
            local_name
        );,
        _ => return false;,
    }
}

fn fs_read_print_call_ok(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_name: []u8
) -> !bool {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return false;
    }
    let arg = try ast.child_at(args, 0);
    return node_text_is_var(text, ast, arg, local_name);
}

fn zero_arg_call_named(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    expected: []u8
) -> bool {
    let node = ast.get(value);
    match node.data {
        Call(call_node) => return call_node.args.len == 0 and
            std::mem::equal_bytes(ast_node_text(text, ast, call_node.callee), expected);,
        _ => return false;,
    }
}

fn empty_fs_read_binding(text: []u8) -> FsReadBinding {
    return FsReadBinding {
        name: text[0..0],
        path_start: -1,
        path_end: -1
    };
}

fn lower_try_void_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8,
    statements: std::kizu::ast::ChildRange
) -> !RunAst {
    if statements.len != 3 {
        return unsupported_run_ast(text[0..0]);
    }
    let try_statement = try ast.child_at(statements, 0);
    let try_callee = try_void_statement_callee(text, ast, try_statement);
    if std::mem::len(try_callee) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let helper_exit_code = try try_void_helper_exit_code(text, ast, declarations, try_callee);
    if helper_exit_code < 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let print_statement = try ast.child_at(statements, 1);
    let payload = try print_statement_payload(text, ast, print_statement);
    if payload.start < 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let payload_text = text[payload.start..payload.end];
    if std::mem::len(payload_text) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let return_statement = try ast.child_at(statements, 2);
    if !return_void_statement_ok(ast, return_statement) {
        return unsupported_run_ast(text[0..0]);
    }
    return try_void_run_ast(
        function_name,
        statements.len,
        "print",
        payload_text,
        try_callee,
        helper_exit_code
    );
}

fn lower_loop_i64_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statements: std::kizu::ast::ChildRange
) -> !RunAst {
    if statements.len == 1 {
        let for_statement = try ast.child_at(statements, 0);
        let for_node = ast.get(for_statement);
        match for_node.data {
            For(loop_node) => return try lower_loop_i64_for(
                text,
                ast,
                function_name,
                statements.len,
                loop_node.label,
                loop_node.name,
                loop_node.start,
                loop_node.end,
                loop_node.body
            );,
            _ => return unsupported_run_ast(text[0..0]);,
        }
    }
    if statements.len != 2 {
        return unsupported_run_ast(text[0..0]);
    }
    let init_statement = try ast.child_at(statements, 0);
    let loop_statement = try ast.child_at(statements, 1);
    let init_node = ast.get(init_statement);
    match init_node.data {
        Let(let_node) => return try lower_loop_i64_let_while(
            text,
            ast,
            function_name,
            statements.len,
            let_node.mutable,
            let_node.name,
            let_node.value,
            loop_statement
        );,
        _ => return unsupported_run_ast(text[0..0]);,
    }
}

fn lower_loop_i64_for(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statement_count: i64,
    label: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !RunAst {
    if !is_empty_node(ast, label) {
        return unsupported_run_ast(text[0..0]);
    }
    let local_name = ast_node_text(text, ast, name);
    if std::mem::len(local_name) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let start_value = try call_arg_i64_literal(text, ast, start);
    if start_value < 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let bound = try call_arg_i64_literal(text, ast, end);
    if bound <= start_value {
        return unsupported_run_ast(text[0..0]);
    }
    let body_node = ast.get(body);
    match body_node.data {
        Block(block) => return try lower_loop_i64_for_body(
            text,
            ast,
            function_name,
            statement_count,
            local_name,
            start_value,
            bound,
            block.statements
        );,
        _ => return unsupported_run_ast(text[0..0]);,
    }
}

fn lower_loop_i64_let_while(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statement_count: i64,
    mutable: bool,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    loop_statement: std::kizu::ast::NodeId
) -> !RunAst {
    if !mutable {
        return unsupported_run_ast(text[0..0]);
    }
    let local_name = ast_node_text(text, ast, name);
    if std::mem::len(local_name) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let init_value = try call_arg_i64_literal(text, ast, value);
    if init_value != 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let loop_node = ast.get(loop_statement);
    match loop_node.data {
        While(while_node) => return try lower_loop_i64_while(
            text,
            ast,
            function_name,
            statement_count,
            local_name,
            while_node.label,
            while_node.condition,
            while_node.body
        );,
        _ => return unsupported_run_ast(text[0..0]);,
    }
}

fn lower_loop_i64_while(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statement_count: i64,
    local_name: []u8,
    label: std::kizu::ast::NodeId,
    condition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !RunAst {
    if !is_empty_node(ast, label) {
        return unsupported_run_ast(text[0..0]);
    }
    let bound = try loop_var_int_binary(text, ast, condition, local_name, std::kizu::ast::binary_lt());
    if bound <= 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let loop_start = 1;
    let loop_bound = bound + 1;
    let body_node = ast.get(body);
    match body_node.data {
        Block(block) => return try lower_loop_i64_body(
            text,
            ast,
            function_name,
            statement_count,
            local_name,
            loop_start,
            loop_bound,
            block.statements
        );,
        _ => return unsupported_run_ast(text[0..0]);,
    }
}

fn lower_loop_i64_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statement_count: i64,
    local_name: []u8,
    start_value: i64,
    bound: i64,
    body_statements: std::kizu::ast::ChildRange
) -> !RunAst {
    if body_statements.len != 4 {
        return unsupported_run_ast(text[0..0]);
    }
    let increment_statement = try ast.child_at(body_statements, 0);
    let step = try loop_increment_step(text, ast, increment_statement, local_name);
    if step != 1 {
        return unsupported_run_ast(text[0..0]);
    }
    let continue_statement = try ast.child_at(body_statements, 1);
    let continue_value = try loop_if_terminal_value(text, ast, continue_statement, local_name, true);
    if continue_value <= 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let break_statement = try ast.child_at(body_statements, 2);
    let break_value = try loop_if_terminal_value(text, ast, break_statement, local_name, false);
    if break_value <= 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let print_statement = try ast.child_at(body_statements, 3);
    if !(try loop_print_statement_ok(text, ast, print_statement, local_name)) {
        return unsupported_run_ast(text[0..0]);
    }
    return loop_i64_run_ast(
        function_name,
        statement_count,
        "print",
        start_value,
        bound,
        continue_value,
        break_value
    );
}

fn lower_loop_i64_for_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statement_count: i64,
    local_name: []u8,
    start_value: i64,
    bound: i64,
    body_statements: std::kizu::ast::ChildRange
) -> !RunAst {
    if body_statements.len != 3 {
        return unsupported_run_ast(text[0..0]);
    }
    let continue_statement = try ast.child_at(body_statements, 0);
    let continue_value = try loop_if_terminal_value(text, ast, continue_statement, local_name, true);
    if continue_value < start_value {
        return unsupported_run_ast(text[0..0]);
    }
    let break_statement = try ast.child_at(body_statements, 1);
    let break_value = try loop_if_terminal_value(text, ast, break_statement, local_name, false);
    if break_value < start_value {
        return unsupported_run_ast(text[0..0]);
    }
    let print_statement = try ast.child_at(body_statements, 2);
    if !(try loop_print_statement_ok(text, ast, print_statement, local_name)) {
        return unsupported_run_ast(text[0..0]);
    }
    return loop_i64_run_ast(
        function_name,
        statement_count,
        "print",
        start_value,
        bound,
        continue_value,
        break_value
    );
}

fn loop_increment_step(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    local_name: []u8
) -> !i64 {
    let node = ast.get(statement);
    match node.data {
        Assign(assign_node) => return try loop_assign_step(text, ast, assign_node.target, assign_node.value, local_name);,
        _ => return -1;,
    }
}

fn loop_assign_step(
    text: []u8,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_name: []u8
) -> !i64 {
    if !node_text_is_var(text, ast, target, local_name) {
        return -1;
    }
    return try loop_var_int_binary(
        text,
        ast,
        value,
        local_name,
        std::kizu::ast::binary_add()
    );
}

fn loop_if_terminal_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    local_name: []u8,
    want_continue: bool
) -> !i64 {
    let node = ast.get(statement);
    match node.data {
        If(if_node) => return try loop_if_value(
            text,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            local_name,
            want_continue
        );,
        _ => return -1;,
    }
}

fn loop_if_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    local_name: []u8,
    want_continue: bool
) -> !i64 {
    if !is_empty_node(ast, else_block) {
        return -1;
    }
    if !(try loop_then_terminal_ok(ast, then_block, want_continue)) {
        return -1;
    }
    return try loop_var_int_binary(
        text,
        ast,
        condition,
        local_name,
        std::kizu::ast::binary_eq()
    );
}

fn loop_then_terminal_ok(
    ast: std::kizu::ast::Ast,
    then_block: std::kizu::ast::NodeId,
    want_continue: bool
) -> !bool {
    let node = ast.get(then_block);
    match node.data {
        Block(block) => return try loop_then_block_ok(ast, block.statements, want_continue);,
        _ => return false;,
    }
}

fn loop_then_block_ok(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    want_continue: bool
) -> !bool {
    if statements.len != 1 {
        return false;
    }
    let child = try ast.child_at(statements, 0);
    return loop_terminal_statement_ok(ast, child, want_continue);
}

fn loop_terminal_statement_ok(
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    want_continue: bool
) -> bool {
    let node = ast.get(statement);
    match node.data {
        Continue(continue_node) => return want_continue and is_empty_node(ast, continue_node.label);,
        Break(break_node) => return !want_continue and is_empty_node(ast, break_node.label);,
        _ => return false;,
    }
}

fn loop_print_statement_ok(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    local_name: []u8
) -> !bool {
    let node = ast.get(statement);
    match node.data {
        ExprStmt(expr_stmt) => return try loop_print_expr_ok(text, ast, expr_stmt.expr, local_name);,
        _ => return false;,
    }
}

fn loop_print_expr_ok(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    local_name: []u8
) -> !bool {
    let node = ast.get(expr);
    match node.data {
        Call(call_node) => return try loop_print_call_ok(text, ast, call_node.callee, call_node.args, local_name);,
        _ => return false;,
    }
}

fn loop_print_call_ok(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_name: []u8
) -> !bool {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return false;
    }
    let arg = try ast.child_at(args, 0);
    return node_text_is_var(text, ast, arg, local_name);
}

fn loop_var_int_binary(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_name: []u8,
    op: std::kizu::ast::BinaryOp
) -> !i64 {
    let node = ast.get(node_id);
    match node.data {
        Binary(binary) => return try loop_binary_value(text, ast, binary.op, binary.left, binary.right, local_name, op);,
        _ => return -1;,
    }
}

fn loop_binary_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    actual_op: std::kizu::ast::BinaryOp,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    local_name: []u8,
    expected_op: std::kizu::ast::BinaryOp
) -> !i64 {
    if actual_op != expected_op {
        return -1;
    }
    if !node_text_is_var(text, ast, left, local_name) {
        return -1;
    }
    return try call_arg_i64_literal(text, ast, right);
}

fn try_void_statement_callee(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(statement);
    match node.data {
        ExprStmt(expr_stmt) => return try_void_expr_callee(text, ast, expr_stmt.expr);,
        _ => return text[0..0];,
    }
}

fn try_void_expr_callee(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(expr);
    match node.data {
        TryExpr(try_expr) => return try_void_value_callee(text, ast, try_expr.value);,
        _ => return text[0..0];,
    }
}

fn try_void_value_callee(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(value);
    match node.data {
        Call(call_node) => return try_void_call_callee(text, ast, call_node.callee, call_node.args);,
        _ => return text[0..0];,
    }
}

fn try_void_call_callee(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> []u8 borrows text {
    if args.len != 0 {
        return text[0..0];
    }
    return ast_node_text(text, ast, callee);
}

fn try_void_helper_exit_code(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    callee: []u8
) -> !i64 {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let exit_code = try try_void_helper_function_exit_code(text, ast, child, callee);
        if exit_code >= 0 {
            return exit_code;
        }
        index = index + 1;
    }
    return -1;
}

fn try_void_helper_function_exit_code(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declaration: std::kizu::ast::NodeId,
    callee: []u8
) -> !i64 {
    let node = ast.get(declaration);
    match node.data {
        FnDecl(fn_decl) => return try try_void_helper_decl_exit_code(
            text,
            ast,
            callee,
            fn_decl.name,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body
        );,
        _ => return -1;,
    }
}

fn try_void_helper_decl_exit_code(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: []u8,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !i64 {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), callee) {
        return -1;
    }
    if params.len != 0 or !type_node_is_error_union_void(text, ast, return_type) {
        return -1;
    }
    let node = ast.get(body);
    match node.data {
        Block(block) => return try try_void_helper_block_exit_code(text, ast, block.statements);,
        _ => return -1;,
    }
}

fn try_void_helper_block_exit_code(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !i64 {
    if statements.len != 1 {
        return -1;
    }
    let statement = try ast.child_at(statements, 0);
    let node = ast.get(statement);
    match node.data {
        Return(return_node) => return try try_void_return_exit_code(text, ast, return_node.value);,
        _ => return -1;,
    }
}

fn try_void_return_exit_code(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> !i64 {
    if is_empty_node(ast, value) {
        return 0;
    }
    return try error_void_return_exit_code(text, ast, value);
}

fn error_void_return_exit_code(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(value);
    match node.data {
        Call(call_node) => return try error_void_call_exit_code(text, ast, call_node.callee, call_node.args);,
        _ => return -1;,
    }
}

fn error_void_call_exit_code(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "error") {
        return -1;
    }
    if args.len != 1 {
        return -1;
    }
    let arg = try ast.child_at(args, 0);
    let payload = string_literal_span(text, ast, arg);
    if payload.start < 0 {
        return -1;
    }
    return 1;
}

fn print_statement_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId
) -> !PayloadSpan {
    let node = ast.get(statement);
    match node.data {
        ExprStmt(expr_stmt) => return try print_expr_payload(text, ast, expr_stmt.expr);,
        _ => return empty_payload_span();,
    }
}

fn print_expr_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> !PayloadSpan {
    let node = ast.get(expr);
    match node.data {
        Call(call_node) => return try print_call_payload(text, ast, call_node.callee, call_node.args);,
        _ => return empty_payload_span();,
    }
}

fn print_call_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !PayloadSpan {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return empty_payload_span();
    }
    let arg = try ast.child_at(args, 0);
    return string_literal_span(text, ast, arg);
}

fn return_void_statement_ok(ast: std::kizu::ast::Ast, statement: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(statement);
    return match node.data {
        Return(return_node) => is_empty_node(ast, return_node.value),
        _ => false,
    };
}

fn lower_let_binding(
    text: []u8,
    ast: std::kizu::ast::Ast,
    locals: &LocalTable,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> LocalBinding {
    let local_name = ast_node_text(text, ast, name);
    if local_table_contains(locals, local_name) or locals.count >= 2 {
        return empty_local(text);
    }
    let payload = string_literal_span(text, ast, value);
    if payload.start < 0 {
        return empty_local(text);
    }
    return LocalBinding {
        name: local_name,
        payload_start: payload.start,
        payload_end: payload.end
    };
}

fn lower_return_void_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statement_count: i64,
    value: std::kizu::ast::NodeId
) -> RunAst {
    if !is_empty_node(ast, value) {
        return unsupported_run_ast(text[0..0]);
    }
    return return_void_run_ast(text, function_name, statement_count);
}

fn lower_print_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8,
    statement_count: i64,
    locals: &LocalTable,
    expr: std::kizu::ast::NodeId
) -> !RunAst {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_print_call(
            text,
            ast,
            declarations,
            function_name,
            statement_count,
            locals,
            call_node.callee,
            call_node.args
        ),
        _ => unsupported_run_ast(text[0..0]),
    };
}

fn lower_print_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8,
    statement_count: i64,
    locals: &LocalTable,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !RunAst {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return unsupported_run_ast(text[0..0]);
    }
    let arg = try ast.child_at(args, 0);
    let i64_call = try lower_print_i64_call(text, ast, declarations, function_name, statement_count, callee, arg);
    if run_ast_i64_call_supported(&i64_call) {
        return i64_call;
    }
    let payload = print_payload(text, ast, locals, arg);
    if payload.start < 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let payload_text = text[payload.start..payload.end];
    if std::mem::len(payload_text) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    return print_run_ast(function_name, statement_count, ast_node_text(text, ast, callee), payload_text);
}

fn lower_print_i64_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8,
    statement_count: i64,
    print_callee: std::kizu::ast::NodeId,
    arg: std::kizu::ast::NodeId
) -> !RunAst {
    let node = ast.get(arg);
    return match node.data {
        Call(call_node) => try lower_direct_i64_print_call(
            text,
            ast,
            declarations,
            function_name,
            statement_count,
            print_callee,
            call_node.callee,
            call_node.args
        ),
        _ => unsupported_run_ast(text[0..0]),
    };
}

fn lower_direct_i64_print_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8,
    statement_count: i64,
    print_callee: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !RunAst {
    if args.len != 2 {
        return unsupported_run_ast(text[0..0]);
    }
    let callee_name = ast_node_text(text, ast, callee);
    if std::mem::len(callee_name) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let arg0_node = try ast.child_at(args, 0);
    let arg1_node = try ast.child_at(args, 1);
    let arg0 = try call_arg_i64_literal(text, ast, arg0_node);
    let arg1 = try call_arg_i64_literal(text, ast, arg1_node);
    if arg0 < 0 or arg1 < 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let op = try find_i64_binary_function(text, ast, declarations, callee_name);
    if op == RunBinaryOp::None {
        return unsupported_run_ast(text[0..0]);
    }
    if op == RunBinaryOp::Div and arg1 == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    if op == RunBinaryOp::Sub and arg0 < arg1 {
        return unsupported_run_ast(text[0..0]);
    }
    return i64_call_run_ast(
        function_name,
        statement_count,
        ast_node_text(text, ast, print_callee),
        callee_name,
        op,
        arg0,
        arg1
    );
}

fn call_arg_i64_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(node_id);
    return match node.data {
        Int(int_node) => try parse_int_literal(ast_node_text(text, ast, node_id)),
        _ => -1,
    };
}

fn find_i64_binary_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    callee_name: []u8
) -> !RunBinaryOp {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let op = try lower_i64_function_node(text, ast, callee_name, child);
        if op != RunBinaryOp::None {
            return op;
        }
        index = index + 1;
    }
    return RunBinaryOp::None;
}

fn lower_i64_function_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee_name: []u8,
    fn_node: std::kizu::ast::NodeId
) -> !RunBinaryOp {
    let node = ast.get(fn_node);
    match node.data {
        FnDecl(fn_decl) => return try lower_i64_function_decl(
            text,
            ast,
            callee_name,
            fn_decl.name,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body
        );,
        _ => return RunBinaryOp::None;,
    }
}

fn lower_i64_function_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee_name: []u8,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !RunBinaryOp {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), callee_name) {
        return RunBinaryOp::None;
    }
    if params.len != 2 or !type_node_is_i64(text, ast, return_type) {
        return RunBinaryOp::None;
    }
    let param0 = try ast.child_at(params, 0);
    let param1 = try ast.child_at(params, 1);
    let param0_name = param_i64_name(text, ast, param0);
    let param1_name = param_i64_name(text, ast, param1);
    if std::mem::len(param0_name) == 0 or std::mem::len(param1_name) == 0 {
        return RunBinaryOp::None;
    }
    let node = ast.get(body);
    match node.data {
        Block(block) => return try lower_i64_function_block(
            text,
            ast,
            block.statements,
            param0_name,
            param1_name
        );,
        _ => return RunBinaryOp::None;,
    }
}

fn lower_i64_function_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    param0_name: []u8,
    param1_name: []u8
) -> !RunBinaryOp {
    if statements.len != 1 {
        return RunBinaryOp::None;
    }
    let statement = try ast.child_at(statements, 0);
    let node = ast.get(statement);
    match node.data {
        Return(return_node) => return lower_i64_return_expr(
            text,
            ast,
            return_node.value,
            param0_name,
            param1_name
        );,
        _ => return RunBinaryOp::None;,
    }
}

fn lower_i64_return_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    param0_name: []u8,
    param1_name: []u8
) -> RunBinaryOp {
    let node = ast.get(value);
    match node.data {
        Binary(binary) => return lower_i64_return_binary(
            text,
            ast,
            binary.op,
            binary.left,
            binary.right,
            param0_name,
            param1_name
        );,
        _ => return RunBinaryOp::None;,
    }
}

fn lower_i64_return_binary(
    text: []u8,
    ast: std::kizu::ast::Ast,
    op: std::kizu::ast::BinaryOp,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    param0_name: []u8,
    param1_name: []u8
) -> RunBinaryOp {
    if !node_text_is_var(text, ast, left, param0_name) or
        !node_text_is_var(text, ast, right, param1_name) {
        return RunBinaryOp::None;
    }
    return run_binary_op(op);
}

fn node_text_is_var(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    expected: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Var(var_node) => std::mem::equal_bytes(ast_node_text(text, ast, node_id), expected),
        _ => false,
    };
}

fn is_empty_node(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Empty => true,
        _ => false,
    };
}

fn param_i64_name(
    text: []u8,
    ast: std::kizu::ast::Ast,
    param: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(param);
    match node.data {
        Param(param_node) => return param_name_if_i64(
            text,
            ast,
            param_node.name,
            param_node.type_node,
            param_node.comptime_param
        );,
        _ => return text[0..0];,
    }
}

fn param_name_if_i64(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    comptime_param: bool
) -> []u8 borrows text {
    if comptime_param or !type_node_is_i64(text, ast, type_node) {
        return text[0..0];
    }
    return ast_node_text(text, ast, name);
}

fn type_node_is_i64(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> bool {
    return std::mem::equal_bytes(ast_node_text(text, ast, type_node), "i64");
}

fn type_node_is_error_union_void(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> bool {
    return std::mem::equal_bytes(ast_node_text(text, ast, type_node), "!void");
}

fn run_binary_op(op: std::kizu::ast::BinaryOp) -> RunBinaryOp {
    if op == std::kizu::ast::binary_add() {
        return RunBinaryOp::Add;
    }
    if op == std::kizu::ast::binary_sub() {
        return RunBinaryOp::Sub;
    }
    if op == std::kizu::ast::binary_mul() {
        return RunBinaryOp::Mul;
    }
    if op == std::kizu::ast::binary_div() {
        return RunBinaryOp::Div;
    }
    return RunBinaryOp::None;
}

fn lower_run_ast_to_program(text: []u8, run_ast: &RunAst) -> Program {
    if !run_ast_supported(run_ast) {
        return unsupported_program(text[0..0]);
    }
    if run_ast_i64_call_supported(run_ast) {
        return lowered_i64_call_program(run_ast);
    }
    if loop_i64_run_ast_supported(run_ast) {
        return lowered_loop_i64_program(run_ast);
    }
    if run_ast.final_statement_kind == RunStatementKind::TryVoidPrintReturn {
        return lowered_try_void_program(run_ast);
    }
    if run_ast.final_statement_kind == RunStatementKind::FsReadPrintReturn {
        return lowered_fs_read_program(run_ast);
    }
    if run_ast.final_statement_kind == RunStatementKind::ReturnVoid {
        return lowered_return_void_program(run_ast);
    }
    return lowered_main_print_program(run_ast.final_argument_payload);
}

fn run_ast_supported(run_ast: &RunAst) -> bool {
    if !run_ast.ok {
        return false;
    }
    if run_ast.block_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.function_name, "main") {
        return false;
    }
    if run_ast.statement_count < 1 {
        return false;
    }
    if run_ast.final_statement_kind == RunStatementKind::ReturnVoid {
        return run_ast.function_count == 1;
    }
    if run_ast.final_statement_kind == RunStatementKind::TryVoidPrintReturn {
        return try_void_run_ast_supported(run_ast);
    }
    if run_ast.final_statement_kind == RunStatementKind::LoopI64Print {
        return loop_i64_run_ast_supported(run_ast);
    }
    if run_ast.final_statement_kind == RunStatementKind::FsReadPrintReturn {
        return fs_read_run_ast_supported(run_ast);
    }
    if run_ast.final_statement_kind != RunStatementKind::Print {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.final_callee, "print") {
        return false;
    }
    if run_ast.function_count == 1 {
        return run_ast.final_argument_kind == RunArgumentKind::ConstString;
    }
    if run_ast.function_count != 2 {
        return false;
    }
    if run_ast.statement_count != 1 {
        return false;
    }
    if run_ast.final_argument_kind != RunArgumentKind::I64Call {
        return false;
    }
    if run_ast.i64_param_count != 2 {
        return false;
    }
    if std::mem::len(run_ast.i64_function_name) == 0 {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.i64_function_name, run_ast.i64_call_callee) {
        return false;
    }
    return run_ast.i64_return_op == RunBinaryOp::Add or
        run_ast.i64_return_op == RunBinaryOp::Sub or
        run_ast.i64_return_op == RunBinaryOp::Mul or
        run_ast.i64_return_op == RunBinaryOp::Div;
}

fn fs_read_run_ast_supported(run_ast: &RunAst) -> bool {
    if run_ast.function_count != 1 {
        return false;
    }
    if run_ast.statement_count != 4 {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.final_callee, "print") {
        return false;
    }
    if run_ast.final_argument_kind != RunArgumentKind::FsReadFile {
        return false;
    }
    return std::mem::len(run_ast.final_argument_payload) != 0;
}

fn try_void_run_ast_supported(run_ast: &RunAst) -> bool {
    if run_ast.function_count != 2 {
        return false;
    }
    if run_ast.statement_count != 3 {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.final_callee, "print") {
        return false;
    }
    if run_ast.final_argument_kind != RunArgumentKind::ConstString {
        return false;
    }
    if std::mem::len(run_ast.i64_function_name) == 0 {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.i64_function_name, run_ast.i64_call_callee) {
        return false;
    }
    if run_ast.i64_param_count != 0 {
        return false;
    }
    if run_ast.i64_call_arg0 == 0 {
        return true;
    }
    return run_ast.i64_call_arg0 == 1;
}

fn loop_i64_run_ast_supported(run_ast: &RunAst) -> bool {
    if run_ast.function_count != 1 {
        return false;
    }
    if run_ast.statement_count != 1 and run_ast.statement_count != 2 {
        return false;
    }
    if run_ast.final_statement_kind != RunStatementKind::LoopI64Print {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.final_callee, "print") {
        return false;
    }
    if run_ast.final_argument_kind != RunArgumentKind::None {
        return false;
    }
    if run_ast.loop_start_value < 0 {
        return false;
    }
    if run_ast.loop_bound <= run_ast.loop_start_value {
        return false;
    }
    if run_ast.loop_continue_value < run_ast.loop_start_value or
        run_ast.loop_break_value < run_ast.loop_start_value {
        return false;
    }
    if run_ast.loop_continue_value >= run_ast.loop_bound or run_ast.loop_break_value >= run_ast.loop_bound {
        return false;
    }
    if run_ast.loop_continue_value == run_ast.loop_break_value {
        return false;
    }
    return true;
}

fn run_ast_i64_call_supported(run_ast: &RunAst) -> bool {
    if !run_ast.ok {
        return false;
    }
    if run_ast.function_count != 2 {
        return false;
    }
    if run_ast.block_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.function_name, "main") {
        return false;
    }
    if run_ast.statement_count != 1 {
        return false;
    }
    if run_ast.final_statement_kind != RunStatementKind::Print {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.final_callee, "print") {
        return false;
    }
    if run_ast.final_argument_kind != RunArgumentKind::I64Call {
        return false;
    }
    if run_ast.i64_param_count != 2 {
        return false;
    }
    if std::mem::len(run_ast.i64_function_name) == 0 {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.i64_function_name, run_ast.i64_call_callee) {
        return false;
    }
    return run_ast.i64_return_op == RunBinaryOp::Add or
        run_ast.i64_return_op == RunBinaryOp::Sub or
        run_ast.i64_return_op == RunBinaryOp::Mul or
        run_ast.i64_return_op == RunBinaryOp::Div;
}

fn print_run_ast(
    function_name: []u8,
    statement_count: i64,
    callee: []u8,
    payload: []u8
) -> RunAst {
    return RunAst {
        ok: true,
        function_count: 1,
        function_name: function_name,
        block_count: 1,
        statement_count: statement_count,
        final_statement_kind: RunStatementKind::Print,
        final_callee: callee,
        final_argument_kind: RunArgumentKind::ConstString,
        final_argument_payload: payload,
        i64_function_name: payload[0..0],
        i64_param_count: 0,
        i64_return_op: RunBinaryOp::None,
        i64_call_callee: payload[0..0],
        i64_call_arg0: 0,
        i64_call_arg1: 0,
        loop_start_value: 0,
        loop_bound: 0,
        loop_continue_value: 0,
        loop_break_value: 0
    };
}

fn i64_call_run_ast(
    function_name: []u8,
    statement_count: i64,
    print_callee: []u8,
    callee: []u8,
    op: RunBinaryOp,
    arg0: i64,
    arg1: i64
) -> RunAst {
    return RunAst {
        ok: true,
        function_count: 2,
        function_name: function_name,
        block_count: 1,
        statement_count: statement_count,
        final_statement_kind: RunStatementKind::Print,
        final_callee: print_callee,
        final_argument_kind: RunArgumentKind::I64Call,
        final_argument_payload: callee[0..0],
        i64_function_name: callee,
        i64_param_count: 2,
        i64_return_op: op,
        i64_call_callee: callee,
        i64_call_arg0: arg0,
        i64_call_arg1: arg1,
        loop_start_value: 0,
        loop_bound: 0,
        loop_continue_value: 0,
        loop_break_value: 0
    };
}

fn loop_i64_run_ast(
    function_name: []u8,
    statement_count: i64,
    print_callee: []u8,
    start_value: i64,
    bound: i64,
    continue_value: i64,
    break_value: i64
) -> RunAst {
    return RunAst {
        ok: true,
        function_count: 1,
        function_name: function_name,
        block_count: 1,
        statement_count: statement_count,
        final_statement_kind: RunStatementKind::LoopI64Print,
        final_callee: print_callee,
        final_argument_kind: RunArgumentKind::None,
        final_argument_payload: function_name[0..0],
        i64_function_name: function_name[0..0],
        i64_param_count: 0,
        i64_return_op: RunBinaryOp::None,
        i64_call_callee: function_name[0..0],
        i64_call_arg0: 0,
        i64_call_arg1: 0,
        loop_start_value: start_value,
        loop_bound: bound,
        loop_continue_value: continue_value,
        loop_break_value: break_value
    };
}

fn fs_read_run_ast(
    function_name: []u8,
    statement_count: i64,
    print_callee: []u8,
    path: []u8
) -> RunAst {
    return RunAst {
        ok: true,
        function_count: 1,
        function_name: function_name,
        block_count: 1,
        statement_count: statement_count,
        final_statement_kind: RunStatementKind::FsReadPrintReturn,
        final_callee: print_callee,
        final_argument_kind: RunArgumentKind::FsReadFile,
        final_argument_payload: path,
        i64_function_name: function_name[0..0],
        i64_param_count: 0,
        i64_return_op: RunBinaryOp::None,
        i64_call_callee: function_name[0..0],
        i64_call_arg0: 0,
        i64_call_arg1: 0,
        loop_start_value: 0,
        loop_bound: 0,
        loop_continue_value: 0,
        loop_break_value: 0
    };
}

fn return_void_run_ast(text: []u8, function_name: []u8, statement_count: i64) -> RunAst {
    return RunAst {
        ok: true,
        function_count: 1,
        function_name: function_name,
        block_count: 1,
        statement_count: statement_count,
        final_statement_kind: RunStatementKind::ReturnVoid,
        final_callee: text[0..0],
        final_argument_kind: RunArgumentKind::None,
        final_argument_payload: text[0..0],
        i64_function_name: text[0..0],
        i64_param_count: 0,
