struct PayloadSpan {
    start: i64,
    end: i64,
}

fn print_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    locals: &LocalTable,
    arg: std::kizu::ast::NodeId
) -> PayloadSpan {
    let node = ast.get(arg);
    return match node.data {
        String(string_node) => string_literal_span(text, ast, arg),
        Var(var_node) => local_payload_span(locals, ast_node_text(text, ast, arg)),
        _ => empty_payload_span(),
    };
}

fn string_literal_span(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> PayloadSpan {
    let node = ast.get(node_id);
    let span = &node.span;
    let literal = text[span.start..span.end];
    let length = span.end - span.start;
    if length < 2 {
        return empty_payload_span();
    }
    let quote = cast<u8>(34);
    if literal[0] != quote or literal[length - 1] != quote {
        return empty_payload_span();
    }
    let payload_start = span.start + 1;
    let payload_end = span.end - 1;
    let payload = text[payload_start..payload_end];
    if !is_payload_supported(payload) {
        return empty_payload_span();
    }
    return PayloadSpan {
        start: payload_start,
        end: payload_end
    };
}

fn empty_payload_span() -> PayloadSpan {
    return PayloadSpan {
        start: -1,
        end: -1
    };
}

fn is_payload_supported(payload: []u8) -> bool {
    var index = 0;
    let min = cast<u8>(32);
    let max = cast<u8>(126);
    let quote = cast<u8>(34);
    while index < std::mem::len(payload) {
        let byte = payload[index];
        if byte < min {
            return false;
        }
        if byte > max {
            return false;
        }
        if byte == quote {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn empty_local_table(text: []u8) -> LocalTable {
    return LocalTable {
        count: 0,
        first: empty_local(text),
        second: empty_local(text)
    };
}

fn empty_local(text: []u8) -> LocalBinding {
    return LocalBinding {
        name: text[0..0],
        payload_start: -1,
        payload_end: -1
    };
}

fn insert_local(text: []u8, locals: &LocalTable, binding: &LocalBinding) -> LocalTable {
    if locals.count == 0 {
        return LocalTable {
            count: 1,
            first: LocalBinding {
                name: binding.name,
                payload_start: binding.payload_start,
                payload_end: binding.payload_end
            },
            second: empty_local(text)
        };
    }
    return LocalTable {
        count: 2,
        first: LocalBinding {
            name: locals.first.name,
            payload_start: locals.first.payload_start,
            payload_end: locals.first.payload_end
        },
        second: LocalBinding {
            name: binding.name,
            payload_start: binding.payload_start,
            payload_end: binding.payload_end
        }
    };
}

fn local_table_contains(locals: &LocalTable, name: []u8) -> bool {
    if locals.count >= 1 and std::mem::equal_bytes(locals.first.name, name) {
        return true;
    }
    if locals.count >= 2 and std::mem::equal_bytes(locals.second.name, name) {
        return true;
    }
    return false;
}

fn local_payload_span(locals: &LocalTable, name: []u8) -> PayloadSpan {
    if locals.count >= 1 and std::mem::equal_bytes(locals.first.name, name) {
        return PayloadSpan {
            start: locals.first.payload_start,
            end: locals.first.payload_end
        };
    }
    if locals.count >= 2 and std::mem::equal_bytes(locals.second.name, name) {
        return PayloadSpan {
            start: locals.second.payload_start,
            end: locals.second.payload_end
        };
    }
    return empty_payload_span();
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}

pub fn metadata_line() -> []u8 {
    return "selfhost::ir::codegen::Program function-block-instruction-v0";
}

// lower_run_int_program lowers a bounded constant subset of main to the existing
// const-string program shape by evaluating the program at compile time over the
// checked AST: integer let locals, integer arithmetic (add/sub/mul/div),
// boolean/comparison conditions, and if/else selection, terminating in a single
// print of a string literal or an integer expression. The computed payload
// (decimal text for integers) is rendered into the caller-owned scratch buffer.
// Non-matching programs return an unsupported program so the caller falls back to
// the string-print run path.
//
// These functions are intentionally excluded from the IR artifact's selected
// body-fact set: the stage2 self-compilation path reproduces only the bounded
// const-string run shape, so threading a scratch String through the selected
// lowering functions would emit signatures the fact pipeline cannot model. Keeping
// the constant-evaluation path here lets the interpreter and the from-source
// native compiler run it while the stage2 program shape stays unchanged.
pub fn lower_run_int_program(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !Program {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_int_declarations(scratch, text, ast, program.declarations),
        _ => unsupported_program(text[0..0]),
    };
}

fn lower_int_declarations(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !Program {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let program = match node.data {
            FnDecl(fn_decl) => try lower_int_function(scratch, text, ast, declarations, fn_decl.name, fn_decl.body),
            _ => unsupported_program(text[0..0]),
        };
        if program_supported(&program) {
            return program;
        }
        index = index + 1;
    }
    return unsupported_program(text[0..0]);
}

fn lower_int_function(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !Program {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "main") {
        return unsupported_program(text[0..0]);
    }
    let node = ast.get(body);
    return match node.data {
        Block(block) => try lower_const_block(scratch, text, ast, block.statements, empty_int_env(text, decls)),
        _ => unsupported_program(text[0..0]),
    };
}

// lower_const_block evaluates a block at compile time: leading integer let
// bindings extend the environment, and the terminal statement is either a print
// (producing the program payload) or an if/else whose taken branch block is
// evaluated with the same environment.
fn lower_const_block(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    env: IntEnv
) -> !Program {
    var current = env;
    var index = 0;
    while index < statements.len {
        let statement = try ast.child_at(statements, index);
        let node = ast.get(statement);
        let terminal = index + 1 == statements.len;
        if terminal {
            return match node.data {
                ExprStmt(expr_stmt) => try lower_const_print_statement(scratch, text, ast, expr_stmt.expr, &current),
                If(if_node) => try lower_const_if(scratch, text, ast, if_node.condition, if_node.then_block, if_node.else_block, &current),
                _ => unsupported_program(text[0..0]),
            };
        }
        let next = match node.data {
            Let(let_node) => try extend_int_env(text, ast, &current, let_node.name, let_node.value),
            _ => overflow_from(&current),
        };
        if next.count < 0 {
            return unsupported_program(text[0..0]);
        }
        current = next;
        index = index + 1;
    }
    return unsupported_program(text[0..0]);
}

fn lower_const_if(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !Program {
    let taken = try eval_bool_expr(text, ast, condition, env);
    var block = else_block;
    if taken {
        block = then_block;
    }
    let node = ast.get(block);
    return match node.data {
        Block(inner) => try lower_const_block(scratch, text, ast, inner.statements, copy_int_env(env)),
        _ => unsupported_program(text[0..0]),
    };
}

fn lower_const_print_statement(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !Program {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_const_print_call(scratch, text, ast, call_node.callee, call_node.args, env),
        _ => unsupported_program(text[0..0]),
    };
}

fn lower_const_print_call(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    env: &IntEnv
) -> !Program {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return unsupported_program(text[0..0]);
    }
    let arg = try ast.child_at(args, 0);
    let arg_node = ast.get(arg);
    return match arg_node.data {
        String(string_node) => lower_const_string_print(text, ast, arg),
        Int(int_node) => try lower_const_int_print(scratch, text, ast, arg, env),
        Binary(binary) => try lower_const_int_print(scratch, text, ast, arg, env),
        Call(call_node) => try lower_const_int_print(scratch, text, ast, arg, env),
        _ => unsupported_program(text[0..0]),
    };
}

fn lower_const_string_print(
    text: []u8,
    ast: std::kizu::ast::Ast,
    arg: std::kizu::ast::NodeId
) -> Program {
    let payload = string_literal_span(text, ast, arg);
    if payload.start < 0 {
        return unsupported_program(text[0..0]);
    }
    let payload_text = text[payload.start..payload.end];
    if std::mem::len(payload_text) == 0 {
        return unsupported_program(text[0..0]);
    }
    return lowered_main_print_program(payload_text);
}

fn lower_const_int_print(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    arg: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !Program {
    let value = try eval_int_expr(text, ast, arg, env);
    let start = scratch.len();
    try std::fmt::append_i64(scratch, value);
    let end = scratch.len();
    let decimal = scratch.as_bytes();
    let payload_text = decimal[start..end];
    if std::mem::len(payload_text) == 0 {
        return unsupported_program(text[0..0]);
    }
    return lowered_main_print_program(payload_text);
}

// IntEnv is a bounded compile-time environment of integer locals plus the
// program's top-level declarations (so calls can resolve user functions). A
// negative count marks an environment that overflowed the supported slot budget.
struct IntEnv {
    count: i64,
    decls: std::kizu::ast::ChildRange,
    name0: []u8,
    value0: i64,
    name1: []u8,
    value1: i64,
    name2: []u8,
    value2: i64,
}

fn copy_int_env(env: &IntEnv) -> IntEnv {
    return IntEnv {
        count: env.count,
        decls: env.decls,
        name0: env.name0,
        value0: env.value0,
        name1: env.name1,
        value1: env.value1,
        name2: env.name2,
        value2: env.value2
    };
}

fn empty_int_env(text: []u8, decls: std::kizu::ast::ChildRange) -> IntEnv {
    return IntEnv {
        count: 0,
        decls: decls,
        name0: text[0..0],
        value0: 0,
        name1: text[0..0],
        value1: 0,
        name2: text[0..0],
        value2: 0
    };
}

fn overflow_from(env: &IntEnv) -> IntEnv {
    return IntEnv {
        count: -1,
        decls: env.decls,
        name0: env.name0,
        value0: env.value0,
        name1: env.name1,
        value1: env.value1,
        name2: env.name2,
        value2: env.value2
    };
}

fn int_env_put(env: &IntEnv, name: []u8, value: i64) -> IntEnv {
    if env.count == 0 {
        return IntEnv {
            count: 1,
            decls: env.decls,
            name0: name,
            value0: value,
            name1: env.name1,
            value1: env.value1,
            name2: env.name2,
            value2: env.value2
        };
    }
    if env.count == 1 {
        return IntEnv {
            count: 2,
            decls: env.decls,
            name0: env.name0,
            value0: env.value0,
            name1: name,
            value1: value,
            name2: env.name2,
            value2: env.value2
        };
    }
    if env.count == 2 {
        return IntEnv {
            count: 3,
            decls: env.decls,
            name0: env.name0,
            value0: env.value0,
            name1: env.name1,
            value1: env.value1,
            name2: name,
            value2: value
        };
    }
    return overflow_from(env);
}

fn extend_int_env(
    text: []u8,
    ast: std::kizu::ast::Ast,
    env: &IntEnv,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> !IntEnv {
    let local_name = ast_node_text(text, ast, name);
    let local_value = try eval_int_expr(text, ast, value, env);
    return int_env_put(env, local_name, local_value);
}

fn int_env_value(env: &IntEnv, name: []u8) -> !i64 {
    if env.count >= 1 and std::mem::equal_bytes(env.name0, name) {
        return env.value0;
    }
    if env.count >= 2 and std::mem::equal_bytes(env.name1, name) {
        return env.value1;
    }
    if env.count >= 3 and std::mem::equal_bytes(env.name2, name) {
        return env.value2;
    }
    return error("unknown integer local in run codegen");
}

// eval_int_expr evaluates an integer literal, local reference, arithmetic
// expression, or direct call to a user function to a constant i64. The parser
// already encodes operator precedence in the tree shape, so a direct post-order
// fold yields the value.
fn eval_int_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !i64 {
    let node = ast.get(node_id);
    return match node.data {
        Int(int_node) => try parse_int_literal(ast_node_text(text, ast, node_id)),
        Var(var_node) => try int_env_value(env, ast_node_text(text, ast, node_id)),
        Binary(binary) => try eval_int_binary(text, ast, binary.op, binary.left, binary.right, env),
        Call(call_node) => try eval_call(text, ast, env, call_node.callee, call_node.args),
        _ => try unsupported_int_expr(),
    };
}

fn unsupported_int_expr() -> !i64 {
    return error("unsupported integer expression in run codegen");
}

// eval_call evaluates a direct call to a user-declared function by binding its
// evaluated arguments to its parameters and evaluating the function body. The
// callee must be a plain identifier naming a function in the program's
// declarations; argument expressions are evaluated in the caller's environment.
fn eval_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    caller_env: &IntEnv,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    let name = ast_node_text(text, ast, callee);
    var index = 0;
    while index < caller_env.decls.len {
        let child = try ast.child_at(caller_env.decls, index);
        let node = ast.get(child);
        let matched = match node.data {
            FnDecl(fn_decl) => std::mem::equal_bytes(ast_node_text(text, ast, fn_decl.name), name),
            _ => false,
        };
        if matched {
            return try eval_fn_decl(text, ast, caller_env, child, args);
        }
        index = index + 1;
    }
    return error("unknown function in run codegen");
}

fn eval_fn_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    caller_env: &IntEnv,
    fn_node: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    let node = ast.get(fn_node);
    return match node.data {
        FnDecl(fn_decl) => try eval_fn_body(text, ast, caller_env, fn_decl.params, fn_decl.body, args),
        _ => try unsupported_int_expr(),
    };
}

fn eval_fn_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    caller_env: &IntEnv,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    if params.len != args.len {
        return error("argument count mismatch in run codegen");
    }
    var param_env = empty_int_env(text, caller_env.decls);
    var index = 0;
    while index < params.len {
        let param = try ast.child_at(params, index);
        let arg = try ast.child_at(args, index);
        let pname = param_name(text, ast, param);
        if std::mem::len(pname) == 0 {
            return error("unsupported parameter in run codegen");
        }
        let pvalue = try eval_int_expr(text, ast, arg, caller_env);
        let extended = int_env_put(&param_env, pname, pvalue);
        if extended.count < 0 {
            return error("too many parameters in run codegen");
        }
        param_env = extended;
        index = index + 1;
    }
    return try eval_function_body(text, ast, body, &param_env);
}

fn param_name(
    text: []u8,
    ast: std::kizu::ast::Ast,
    param: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(param);
    match node.data {
        Param(param_node) => return ast_node_text(text, ast, param_node.name);,
        _ => return text[0..0];,
    }
}

fn eval_function_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !i64 {
    let node = ast.get(body);
    return match node.data {
        Block(block) => try eval_block_return(text, ast, block.statements, env),
        _ => try unsupported_int_expr(),
    };
}

// eval_block_return evaluates a function body block: optional leading integer
// let bindings extend the environment, and the terminal statement must be a
// return of an integer expression.
fn eval_block_return(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    env: &IntEnv
) -> !i64 {
    var current = copy_int_env(env);
    var index = 0;
    while index < statements.len {
        let statement = try ast.child_at(statements, index);
        let node = ast.get(statement);
        let terminal = index + 1 == statements.len;
        if terminal {
            return match node.data {
                Return(return_node) => try eval_int_expr(text, ast, return_node.value, &current),
                _ => try unsupported_int_expr(),
            };
        }
        let next = match node.data {
            Let(let_node) => try extend_int_env(text, ast, &current, let_node.name, let_node.value),
            _ => overflow_from(&current),
        };
        if next.count < 0 {
            return error("unsupported function body in run codegen");
        }
        current = next;
        index = index + 1;
    }
    return error("function body has no return in run codegen");
}

fn eval_int_binary(
    text: []u8,
    ast: std::kizu::ast::Ast,
    op: std::kizu::ast::BinaryOp,
    left_id: std::kizu::ast::NodeId,
    right_id: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !i64 {
    let left = try eval_int_expr(text, ast, left_id, env);
    let right = try eval_int_expr(text, ast, right_id, env);
    if op == std::kizu::ast::binary_add() {
        return left + right;
    }
    if op == std::kizu::ast::binary_sub() {
        return left - right;
    }
    if op == std::kizu::ast::binary_mul() {
        return left * right;
    }
    if op == std::kizu::ast::binary_div() {
        if right == 0 {
            return error("division by zero in run codegen");
        }
        return left / right;
    }
    return error("unsupported integer operator in run codegen");
}

// eval_bool_expr evaluates a boolean literal, integer comparison, or logical
// (and/or) expression to a constant bool over the integer environment.
fn eval_bool_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !bool {
    let node = ast.get(node_id);
    return match node.data {
        Bool(bool_node) => try parse_bool_literal(ast_node_text(text, ast, node_id)),
        Binary(binary) => try eval_bool_binary(text, ast, binary.op, binary.left, binary.right, env),
        _ => try unsupported_bool_expr(),
    };
}

fn unsupported_bool_expr() -> !bool {
    return error("unsupported boolean expression in run codegen");
}

fn parse_bool_literal(literal: []u8) -> !bool {
    if std::mem::equal_bytes(literal, "true") {
        return true;
    }
    if std::mem::equal_bytes(literal, "false") {
        return false;
    }
    return error("unsupported boolean literal in run codegen");
}

fn eval_bool_binary(
    text: []u8,
    ast: std::kizu::ast::Ast,
    op: std::kizu::ast::BinaryOp,
    left_id: std::kizu::ast::NodeId,
    right_id: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !bool {
    if op == std::kizu::ast::binary_and() {
        let left = try eval_bool_expr(text, ast, left_id, env);
        let right = try eval_bool_expr(text, ast, right_id, env);
        return left and right;
    }
    if op == std::kizu::ast::binary_or() {
        let left = try eval_bool_expr(text, ast, left_id, env);
        let right = try eval_bool_expr(text, ast, right_id, env);
        return left or right;
    }
    let left = try eval_int_expr(text, ast, left_id, env);
    let right = try eval_int_expr(text, ast, right_id, env);
    if op == std::kizu::ast::binary_eq() {
        return left == right;
    }
    if op == std::kizu::ast::binary_not_eq() {
        return left != right;
    }
    if op == std::kizu::ast::binary_lt() {
        return left < right;
    }
    if op == std::kizu::ast::binary_lte() {
        return left <= right;
    }
    if op == std::kizu::ast::binary_gt() {
        return left > right;
    }
    if op == std::kizu::ast::binary_gte() {
        return left >= right;
    }
    return error("unsupported boolean operator in run codegen");
}

fn parse_int_literal(literal: []u8) -> !i64 {
    let length = std::mem::len(literal);
    if length == 0 {
        return error("empty integer literal in run codegen");
    }
    var index = 0;
    var value = 0;
    while index < length {
        let byte = literal[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return error("unsupported integer literal in run codegen");
        }
        value = value * 10 + cast<i64>(byte - cast<u8>(48));
        index = index + 1;
    }
    return value;
}

// ---------------------------------------------------------------------------
// Run codegen IR v1: the flat function-block-instruction tape.
//
// The tape is a runtime-owned Array<i64> of records 'opcode dst operands...';
// string operands are (start, end) spans into the run source text, so the
// lowering needs no string allocation. lower_code_module walks the whole
// checked file: every function lowers to FUNC_BEGIN/FUNC_END records framing
// its statement records, and every expression lowers through the recursive
// descent to a tape value id. CodeEval threads the SSA value counter; kinds
// records every value id's kind (i64 or str) so print and call sites resolve
// operand types without re-walking the AST. Locals bind name spans to value
// ids in three parallel arrays scanned from each function's locals_base, and
// args_scratch carries call-argument value ids between the argument walk and
// the CALL record. ok=false marks a construct the tape lowering does not own
// yet, so callers report the single unified unsupported diagnostic instead of
// dispatching to a shape-specific path. List walks recurse instead of mutating
// loop-carried scalars, matching the loop shapes the compiled MIR lowers.
// ---------------------------------------------------------------------------

pub struct CodeEval {
    pub ok: bool,
    pub value_id: i64,
    pub next: i64,
}

fn code_eval_unsupported(next_value: i64) -> CodeEval {
    return CodeEval {
        ok: false,
        value_id: 0,
        next: next_value
    };
}

fn code_eval_value(value: i64, next_value: i64) -> CodeEval {
    return CodeEval {
        ok: true,
        value_id: value,
        next: next_value
    };
}

pub fn code_op_const_int() -> i64 {
    return 1;
}

pub fn code_op_binary() -> i64 {
    return 2;
}

pub fn code_op_const_str() -> i64 {
    return 3;
}

pub fn code_op_call() -> i64 {
    return 4;
}

// CONST_BOOL materializes a 'true'/'false' literal as an i1 value: the record is
// 'op dst literal' where literal is 1 (true) or 0 (false).
pub fn code_op_const_bool() -> i64 {
    return 5;
}

// NOT computes the logical negation of an i1 operand: the record is 'op dst operand'.
pub fn code_op_not() -> i64 {
    return 6;
}

// STR_SLICE materializes a CONST_STR global as a runtime '%kizu.slice.u8' value:
// the record is 'op dst src' where src is the CONST_STR value id and dst the
// resulting slice value (kind slice). User calls take string arguments through it
// so the call renderer passes every argument as a typed SSA value.
pub fn code_op_str_slice() -> i64 {
    return 7;
}

// STRUCT_LIT scalarizes a struct literal at lowering time: the record is
// 'op dst field_count name_start1 name_end1 value1 ...' where each value id is
// the field initializer's lowered tape value. The renderer emits nothing for it
// (the dst value is never referenced by LLVM); a field read resolves through
// the record back to the field's own value id.
pub fn code_op_struct_lit() -> i64 {
    return 8;
}

// ENUM_CONST materializes an 'Enum::Variant' read as its declaration-order tag:
// the record is 'op dst qual_start qual_end enum_start enum_end tag' where the
// qual span covers the 'Enum::Variant' source text (print renders it verbatim)
// and the enum span names the declaration match arm patterns resolve against.
// The dst value renders as the i64 tag constant.
pub fn code_op_enum_const() -> i64 {
    return 9;
}

// UNION_CONST materializes a 'Union::Variant(<payload>)' construction (or a
// payload-less variant read) as its declaration-order tag: the record extends
// ENUM_CONST's layout with a trailing payload value id ('op dst qual_start
// qual_end union_start union_end tag payload', payload -1 when the variant
// carries none), so match arms bind the payload under their binding name.
pub fn code_op_union_const() -> i64 {
    return 12;
}

// UNION_DECL records one union declaration's runtime layout at the head of the
// tape (the declaration pass emits every union before any function): the record
// is 'op name_start name_end variant_count [vname_start vname_end payload_kind]
// per variant' where payload_kind is 0 (none), kind i64, or kind slice. A
// runtime union value's kinds entry stores record_base + <UNION_DECL position>,
// so parameters and match arms resolve variants against it.
pub fn code_op_union_decl() -> i64 {
    return 13;
}

// UNION_PACK materializes a compile-time UNION_CONST value as a runtime
// '%kizu.run.union' aggregate when it crosses a function boundary: the record
// is 'op dst tag_value payload_value payload_kind' (payload_value -1 when the
// variant carries none). The dst's kinds entry references the UNION_DECL.
pub fn code_op_union_pack() -> i64 {
    return 14;
}

// UNION_TAG reads a runtime union value's tag ('op dst src'); UNION_PAYLOAD
// extracts its payload field ('op dst src payload_kind', field 1 for i64 and
// field 2 for slice payloads).
pub fn code_op_union_tag() -> i64 {
    return 15;
}

pub fn code_op_union_payload() -> i64 {
    return 16;
}

pub fn code_op_func_begin() -> i64 {
    return 10;
}

pub fn code_op_func_end() -> i64 {
    return 11;
}

pub fn code_op_print() -> i64 {
    return 20;
}

pub fn code_op_ret_void() -> i64 {
    return 30;
}

pub fn code_op_ret_value() -> i64 {
    return 31;
}

// TRY_CALL frames a 'try <call>' of an error-union-void callee: the renderer emits
// the call, extracts the ok flag, and branches into a fail block that propagates
// the error (a user error-union function returns it, kizu_run_main exits 1) or a
// cont block that resumes the body. It carries the callee name span and the
// argument value ids (no result value: a try of !void yields nothing).
pub fn code_op_try_call() -> i64 {
    return 32;
}

// RET_ERR_FAIL frames a 'return error("msg")' in an error-union-void function: it
// carries the message string's value id (a CONST_STR record already emitted the
// '@.kizu.run.s<id>' global) so the renderer returns an error union whose ok flag
// is false and whose slice points at that message global.
pub fn code_op_ret_err_fail() -> i64 {
    return 33;
}

// IO_BLOCKING frames a 'std::io::blocking()' call producing a '%kizu.owned' io
// handle value. It carries the result value id (kind owned).
pub fn code_op_io_blocking() -> i64 {
    return 34;
}

// TRY_CALL_I64 frames a 'try <call>' of an error-union-i64 callee: the renderer
// emits the %kizu.error.i64 call, branches into a fail block that propagates the
// error by the surrounding ABI (kizu_run_main exits 1, an error-union function
// re-wraps the message) or a cont block that extracts the i64 success value into
// the result. Its record mirrors CALL: 'op result callee_start callee_end
// arg_count args...', so the CALL record-end walk serves it.
pub fn code_op_try_call_i64() -> i64 {
    return 36;
}

// EXPECT frames a 'std::testing::expect(<bool>)' statement: the renderer branches
// on the i1 condition and the fail block traps the process with the runtime
// expectation message (stderr + exit 1). The record is 'op cond'.
pub fn code_op_expect() -> i64 {
    return 37;
}

// TRY_IO_WRITE frames a 'try std::io::write_stdout/write_stderr(io, bytes)'
// statement: the record is 'op io_value msg_value stream'. The renderer calls
// the matching runtime write and branches into a fail block that propagates the
// error by the surrounding ABI (the try yields no value).
pub fn code_op_try_io_write() -> i64 {
    return 38;
}

// code_io_stream_stdout / code_io_stream_stderr tag a TRY_IO_WRITE record's
// target stream.
pub fn code_io_stream_stdout() -> i64 {
    return 0;
}

pub fn code_io_stream_stderr() -> i64 {
    return 1;
}

// TRY_FS_READ frames a 'try std::fs::read_file(io, path)' expression: the renderer
// builds the path slice from the CONST_STR global, calls the runtime read, and
// branches into a fail block that propagates (kizu_run_main exits 1, an
// error-union-void caller returns the error) or a cont block that extracts the
// bytes slice into the result value. It carries the result value id (kind slice),
// the io handle value id, and the path string value id.
pub fn code_op_try_fs_read() -> i64 {
    return 35;
}

// Structured control-flow opcodes. They carry fixed arity so the linear tape
// walk (tape_record_end) skips them like any other record; the renderer emits
// matching LLVM labels from the IF_BEGIN tape index (IF_ELSE/IF_END carry that
// begin index so their labels match without a render-time block stack).
pub fn code_op_if_begin() -> i64 {
    return 40;
}

pub fn code_op_if_else() -> i64 {
    return 41;
}

pub fn code_op_if_end() -> i64 {
    return 42;
}

// Mutable-local (var) opcodes back the alloca memory model: VAR_DECL stores a
// var's init value into its stack slot, VAR_LOAD reads the slot into a fresh SSA
// value, VAR_STORE writes a value back. The slot id names the '%slot<id>' alloca
// the renderer hoists to the function entry; let bindings stay SSA, so only
// reassigned vars take a slot.
pub fn code_op_var_decl() -> i64 {
    return 50;
}

pub fn code_op_var_load() -> i64 {
    return 51;
}

pub fn code_op_var_store() -> i64 {
    return 52;
}

// VAR_DECL_SLICE / VAR_LOAD_SLICE / VAR_STORE_SLICE mirror the i64 var slot trio
// for '%kizu.slice.u8' slots ('%sslot<id>'), backing scalarized var-struct
// slice fields (a string field materializes through STR_SLICE first).
pub fn code_op_var_decl_slice() -> i64 {
    return 53;
}

pub fn code_op_var_load_slice() -> i64 {
    return 54;
}

pub fn code_op_var_store_slice() -> i64 {
    return 55;
}

// VAR_STRUCT scalarizes a 'var' struct binding: the record is
// 'op dst field_count [name_start name_end slot kind] per field' where each
// field owns its own slot and the kind (i64 or slice) selects the slot trio its
// reads and assignments use. The renderer emits nothing for the record itself.
pub fn code_op_var_struct() -> i64 {
    return 56;
}

// VAR_DECL_BOOL / VAR_LOAD_BOOL / VAR_STORE_BOOL mirror the var slot trios for
// i1 slots ('%bslot<id>'), backing value-position if/match results whose
// branches yield bool values.
pub fn code_op_var_decl_bool() -> i64 {
    return 57;
}

pub fn code_op_var_load_bool() -> i64 {
    return 58;
}

pub fn code_op_var_store_bool() -> i64 {
    return 59;
}

// While-loop opcodes frame a 'while <cond> { <body> }': WHILE_BEGIN opens the
// condition block, WHILE_COND branches on the lowered i1 condition into the body
// or past the loop, WHILE_END closes the body back to the condition block. Each
// carries the WHILE_BEGIN tape index so the renderer's labels match without a
// render-time block stack.
pub fn code_op_while_begin() -> i64 {
    return 60;
}

pub fn code_op_while_cond() -> i64 {
    return 61;
}

pub fn code_op_while_end() -> i64 {
    return 62;
}

// For-range opcodes frame a 'for <start>..<end> |name| { <body> }': FOR_BEGIN
// seeds the induction slot from the start value and opens the condition block
// (loading the slot and comparing against the end value), FOR_END emits the
// latch (increment the slot) and closes the loop. FOR_BEGIN carries the temp
// value ids its load/compare use; FOR_END carries the temp ids its latch uses.
pub fn code_op_for_begin() -> i64 {
    return 70;
}

pub fn code_op_for_end() -> i64 {
    return 73;
}

// Break/continue opcodes carry the enclosing loop's begin index and its loop
// kind (0 = while, 1 = for) so the renderer targets the right exit/continue
// label; for loops continue at their latch, while loops at their condition.
pub fn code_op_break() -> i64 {
    return 80;
}

pub fn code_op_continue() -> i64 {
    return 81;
}

// Short-circuit opcodes frame an 'and'/'or' whose right operand must not evaluate
// when the left already decides the result (SPEC: 'and' and 'or' short-circuit).
// SC_BEGIN stores the left i1 into the record's own i1 slot (named by the SC_BEGIN
// tape index, hoisted to the function entry like var slots) and branches: an 'and'
// enters the right-operand block only when the left is true, an 'or' only when it
// is false. The right operand records follow, and SC_END stores the right value
// into the slot, closes the block, and loads the slot into the result value.
pub fn code_op_sc_begin() -> i64 {
    return 90;
}

pub fn code_op_sc_end() -> i64 {
    return 91;
}

// code_loop_kind_while / code_loop_kind_for tag a break/continue's target loop so
// the renderer picks the while (condition latch) or for (increment latch) labels.
pub fn code_loop_kind_while() -> i64 {
    return 0;
}

pub fn code_loop_kind_for() -> i64 {
    return 1;
}

// code_var_slot_base offsets a var local's stored value so a locals lookup can
// tell a var (alloca slot) from a let (SSA value). A var local stores
// base + slot; reads at or above the base resolve to slot = value - base and
// emit a VAR_LOAD, while let values stay below it and resolve to their SSA id.
// Run programs never approach this many SSA values, so the spaces never overlap.
pub fn code_var_slot_base() -> i64 {
    return 1000000000;
}

// code_loop_label_base offsets a loop label's stored value so a locals lookup can
// tell a label from a let value or a var slot: a label stores
// base + loop_begin * 2 + loop_kind, far above the var slot space.
pub fn code_loop_label_base() -> i64 {
    return 2000000000;
}

pub fn code_kind_i64() -> i64 {
    return 1;
}

pub fn code_kind_str() -> i64 {
    return 2;
}

// code_kind_bool marks an i1 comparison result on the kinds parallel array; the
// renderer emits it as an icmp and an if condition consumes it as i1.
pub fn code_kind_bool() -> i64 {
    return 3;
}

// code_kind_owned marks a '%kizu.owned' runtime handle value (e.g. the io handle
// returned by std::io::blocking()). code_kind_slice marks a runtime
// '%kizu.slice.u8' value (e.g. the bytes returned by std::fs::read_file), as
// distinct from code_kind_str, which names a CONST_STR global rather than an SSA
// slice value.
pub fn code_kind_owned() -> i64 {
    return 4;
}

pub fn code_kind_slice() -> i64 {
    return 5;
}

// code_kind_struct_base marks a record-backed value on the kinds array: the
// entry stores base + <record tape index> for STRUCT_LIT and ENUM_CONST values,
// so a consumer recovers the record position directly from the kind (the opcode
// at that position tells the two apart) while every scalar kind check rejects
// record-backed values without a dedicated guard.
pub fn code_kind_struct_base() -> i64 {
    return 1000;
}

fn code_binary_kind(op: std::kizu::ast::BinaryOp) -> i64 {
    if op == std::kizu::ast::binary_add() {
        return 1;
    }
    if op == std::kizu::ast::binary_sub() {
        return 2;
    }
    if op == std::kizu::ast::binary_mul() {
        return 3;
    }
    if op == std::kizu::ast::binary_div() {
        return 4;
    }
    if op == std::kizu::ast::binary_mod() {
        return 11;
    }
    if op == std::kizu::ast::binary_eq() {
        return 5;
    }
    if op == std::kizu::ast::binary_not_eq() {
        return 6;
    }
    if op == std::kizu::ast::binary_lt() {
        return 7;
    }
    if op == std::kizu::ast::binary_lte() {
        return 8;
    }
    if op == std::kizu::ast::binary_gt() {
        return 9;
    }
    if op == std::kizu::ast::binary_gte() {
        return 10;
    }
    return 0;
}

// code_binary_kind_is_comparison reports whether a binary kind id is a comparison
// (eq/not_eq/lt/lte/gt/gte); such results are i1 booleans, the rest are i64.
fn code_binary_kind_is_comparison(kind: i64) -> bool {
    return kind >= 5 and kind <= 10;
}

// code_return_kind classifies a function's declared return type for the tape:
// 0 = void (empty or 'void'), 1 = i64, 2 = error-union void ('!void'),
// 3 = error-union i64 ('!i64'), record_base + <UNION_DECL position> for a
// declared union (the runtime aggregate return), -1 = a type the tape does not
// own yet.
fn code_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    if is_empty_node(ast, type_node) {
        return 0;
    }
    if type_node_is_i64(text, ast, type_node) {
        return 1;
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "void") {
        return 0;
    }
    if std::mem::equal_bytes(type_text, "!void") {
        return 2;
    }
    if std::mem::equal_bytes(type_text, "!i64") {
        return 3;
    }
    let union_kind = try code_param_union_kind(text, ast, type_node, code);
    return union_kind;
}

// code_node_span returns the trimmed (start, end) byte span of a node's source
// text, so identifier operands land on the tape as exact spans.
fn code_node_span(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> PayloadSpan {
    let node = ast.get(node_id);
    let span_start = node.span.start;
    let span_end = node.span.end;
    let start = code_span_trim_start(text, span_start, span_end);
    let end = code_span_trim_end(text, start, span_end);
    return PayloadSpan {
        start: start,
        end: end
    };
}

fn code_span_trim_start(text: []u8, start: i64, end: i64) -> i64 {
    if start >= end {
        return start;
    }
    if !code_span_space(text[start]) {
        return start;
    }
    let after = start + 1;
    return code_span_trim_start(text, after, end);
}

fn code_span_trim_end(text: []u8, start: i64, end: i64) -> i64 {
    if end <= start {
        return end;
    }
    let last = end - 1;
    if !code_span_space(text[last]) {
        return end;
    }
    return code_span_trim_end(text, start, last);
}

fn code_span_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or
        byte == cast<u8>(9) or
        byte == cast<u8>(10) or
        byte == cast<u8>(13);
}

// lower_code_module lowers the whole checked file onto the tape: every
// top-level declaration must be a function the tape owns.
pub fn lower_code_module(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>
) -> !CodeEval {
    try scratch_init(args_scratch);
    return try lower_code_program(text, ast, root, code, kinds, local_starts, local_ends, local_values, args_scratch);
}

// scratch_init seeds the call-arg scratch as an explicit stack: slot 0 holds the
// stack pointer (the next free slot) and the argument slots start at 1. A nested
// call argument allocates its own frame above its caller's reserved slots and the
// pointer pops back when each CALL record copies its frame, so arbitrarily nested
// call arguments keep every frame contiguous without an array-truncate primitive
// (dead deeper slots are overwritten through scratch_put).
fn scratch_init(args_scratch: &var std::array::Array<i64>) -> !void {
    try args_scratch.append(1);
    return;
}

// lower_code_program dispatches the checked file's root onto the declaration walk.
fn lower_code_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_code_program_decls(text, ast, program.declarations, code, kinds, local_starts, local_ends, local_values, args_scratch),
        _ => code_eval_unsupported(0),
    };
}

// lower_code_program_decls emits every union declaration's UNION_DECL record
// at the head of the tape (so parameter classification and runtime match arms
// can resolve them regardless of declaration order), then walks the functions.
fn lower_code_program_decls(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>
) -> !CodeEval {
    let decls_eval = try emit_union_decl_records(text, ast, decls, code, 0);
    if !decls_eval.ok {
        return code_eval_unsupported(decls_eval.next);
    }
    return try lower_code_declarations(text, ast, decls, code, kinds, local_starts, local_ends, local_values, args_scratch, 0, decls_eval.next);
}

// emit_union_decl_records walks the top-level declarations and records every
// union's runtime layout before any function record lands on the tape.
fn emit_union_decl_records(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !CodeEval {
    if index >= decls.len {
        return code_eval_value(0, 0);
    }
    let child = try ast.child_at(decls, index);
    let eval = try emit_union_decl_record(text, ast, child, code);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try emit_union_decl_records(text, ast, decls, code, after);
}

// emit_union_decl_record routes one top-level declaration: a union emits its
// layout record, every other declaration emits nothing (the pass allocates no
// tape values, so the eval's value ids stay at zero).
fn emit_union_decl_record(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        UnionDecl(union_decl) => try emit_one_union_decl(text, ast, union_decl.name, union_decl.variants, code),
        _ => code_eval_value(0, 0),
    };
}

fn emit_one_union_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    variants: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let name_span = code_node_span(text, ast, name);
    let op_union_decl = code_op_union_decl();
    try code.append(op_union_decl);
    try code.append(name_span.start);
    try code.append(name_span.end);
    try code.append(variants.len);
    return try append_union_decl_variants(text, ast, variants, code, 0);
}

fn append_union_decl_variants(
    text: []u8,
    ast: std::kizu::ast::Ast,
    variants: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    index: i64
) -> !CodeEval {
    if index >= variants.len {
        return code_eval_value(0, 0);
    }
    let child = try ast.child_at(variants, index);
    let eval = try append_union_decl_variant(text, ast, child, code);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try append_union_decl_variants(text, ast, variants, code, after);
}

// append_union_decl_variant routes one declared variant into its layout entry
// (a non-variant child appends nothing; the pass allocates no tape values).
fn append_union_decl_variant(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        UnionVariant(variant) => try append_union_variant_entry(text, ast, variant.name, variant.payload, code),
        _ => code_eval_value(0, 0),
    };
}

fn append_union_variant_entry(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    payload: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !CodeEval {
    let name_span = code_node_span(text, ast, name);
    try code.append(name_span.start);
    try code.append(name_span.end);
    let payload_kind = try union_payload_kind(text, ast, payload);
    try code.append(payload_kind);
    return code_eval_value(0, 0);
}

// union_payload_kind classifies a variant payload type for the runtime layout:
// 0 for a payload-less variant, kind i64 or kind slice for the supported
// payload types, and -1 for anything else (functions touching that union stay
// unsupported when the payload is read).
fn union_payload_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    payload: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(payload);
    return match node.data {
        Empty => 0,
        _ => union_payload_type_kind(text, ast, payload),
    };
}

fn union_payload_type_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    payload: std::kizu::ast::NodeId
) -> i64 {
    let type_text = ast_node_text(text, ast, payload);
    if std::mem::equal_bytes(type_text, "i64") {
        return code_kind_i64();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_kind_slice();
    }
    return 0 - 1;
}

fn lower_code_declarations(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= decls.len {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(decls, index);
    let eval = try lower_code_function(text, ast, decls, child, code, kinds, local_starts, local_ends, local_values, args_scratch, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_declarations(text, ast, decls, code, kinds, local_starts, local_ends, local_values, args_scratch, after, eval.next);
}

fn lower_code_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    decl_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(decl_id);
    // A struct or enum declaration emits nothing: struct literals carry their
    // own field names, enum constants resolve their tags against the
    // declaration on demand, and the checked AST already validated both.
    return match node.data {
        FnDecl(fn_decl) => try lower_code_fn_decl(text, ast, decls, fn_decl.name, fn_decl.params, fn_decl.return_type, fn_decl.body, code, kinds, local_starts, local_ends, local_values, args_scratch, next_value),
        StructDecl(struct_decl) => code_eval_value(0, next_value),
        EnumDecl(enum_decl) => code_eval_value(0, next_value),
        UnionDecl(union_decl) => code_eval_value(0, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_fn_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let ret_kind = try code_return_kind(text, ast, return_type, code);
    if ret_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    // A run function is named by an identifier; a test declaration (whose name
    // is a string literal) is not a run-tape function.
    if !code_node_is_var(ast, name) {
        return code_eval_unsupported(next_value);
    }
    let name_span = code_node_span(text, ast, name);
    let op_func_begin = code_op_func_begin();
    try code.append(op_func_begin);
    try code.append(name_span.start);
    try code.append(name_span.end);
    try code.append(params.len);
    try code.append(ret_kind);
    // The renderer names parameter SSA temps from their value ids; params are
    // assigned sequentially from next_value, so record that base on the tape.
    try code.append(next_value);
    let locals_base = local_starts.len();
    let params_eval = try lower_code_params(text, ast, params, code, kinds, local_starts, local_ends, local_values, 0, next_value);
    if !params_eval.ok {
        return code_eval_unsupported(params_eval.next);
    }
    // A function body starts outside any loop; bind the no-loop sentinel to a
    // local so it reaches lower_code_body as a plain arg (an arith literal like
    // '0 - 1' passed straight to a call is outside the compiled call-arg shape).
    let no_loop = 0 - 1;
    // The function's top block shares its scope with the parameters (a let that
    // re-binds a parameter name is the checker-illegal duplicate), so its scope
    // base is locals_base rather than the post-params length.
    let body_eval = try lower_code_body_scoped(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, locals_base, no_loop, no_loop, params_eval.next);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let op_func_end = code_op_func_end();
    try code.append(op_func_end);
    return code_eval_value(0, body_eval.next);
}

// code_node_is_var reports whether a node is a bare identifier (Var) node. It is
// the single let+return-match accessor shape the compiled traversal path lowers
// (bool-literal arms).
fn code_node_is_var(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Var(var_node) => true,
        _ => false,
    };
}

// lower_code_body walks a nested block's statements onto the tape inside a fresh
// binding scope: bindings introduced in the block shadow outer ones while it is
// open and stop resolving once it closes.
fn lower_code_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let scope_base = local_starts.len();
    return try lower_code_body_scoped(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, loop_begin, loop_kind, next_value);
}

fn lower_code_body_scoped(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let body_node = ast.get(body);
    return match body_node.data {
        Block(block) => try lower_code_scoped_statements(text, ast, decls, block.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, loop_begin, loop_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_scoped_statements lowers one block's statements and then blanks the
// bindings the block introduced (at or above scope_base), closing the scope.
fn lower_code_scoped_statements(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_statements(text, ast, decls, statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, loop_begin, loop_kind, 0, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    try scrub_code_locals(local_starts, local_ends, scope_base);
    return code_eval_value(0, eval.next);
}

// scrub_code_locals blanks the name spans of every local bound at or above mark:
// the locals arrays have no truncate primitive, and an empty span never matches
// an identifier, so a closed scope's bindings stop resolving in place.
fn scrub_code_locals(
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    mark: i64
) -> !void {
    let used = local_starts.len();
    if mark >= used {
        return;
    }
    try local_starts.set(mark, 0);
    try local_ends.set(mark, 0);
    let after = mark + 1;
    try scrub_code_locals(local_starts, local_ends, after);
    return;
}

// lower_code_params binds every parameter name to the next sequential value
// id; the tape owns i64 parameters only, so each declared type must be i64.
fn lower_code_params(
    text: []u8,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= params.len {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(params, index);
    let eval = try lower_code_param_node(text, ast, child, code, kinds, local_starts, local_ends, local_values, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_params(text, ast, params, code, kinds, local_starts, local_ends, local_values, after, eval.next);
}

fn lower_code_param_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(child);
    return match node.data {
        Param(param) => try lower_code_param(text, ast, param.name, param.type_node, code, kinds, local_starts, local_ends, local_values, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_param(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let param_kind = try code_param_kind(text, ast, type_node, code);
    if param_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    let name_span = code_node_span(text, ast, name);
    try local_starts.append(name_span.start);
    try local_ends.append(name_span.end);
    try local_values.append(next_value);
    try kinds.append(param_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// union_decl_pos_by_span returns the UNION_DECL record position whose union
// name matches the span text (-1 when no record carries it). The declaration
// pass put every UNION_DECL at the head of the tape, so the scan stops at the
// first record with any other opcode.
fn union_decl_pos_by_span(
    text: []u8,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    pos: i64
) -> !i64 {
    let total = code.len();
    if pos >= total {
        return 0 - 1;
    }
    let op = try code.get(pos);
    let op_union_decl = code_op_union_decl();
    if op != op_union_decl {
        return 0 - 1;
    }
    let rec_name_start_pos = pos + 1;
    let rec_name_start = try code.get(rec_name_start_pos);
    let rec_name_end_pos = pos + 2;
    let rec_name_end = try code.get(rec_name_end_pos);
    let rec_name = text[rec_name_start..rec_name_end];
    let wanted = text[name_start..name_end];
    let count_pos = pos + 3;
    let variant_count = try code.get(count_pos);
    let entry_slots = variant_count * 3;
    let next_pos = pos + 4 + entry_slots;
    if !std::mem::equal_bytes(rec_name, wanted) {
        return try union_decl_pos_by_span(text, code, name_start, name_end, next_pos);
    }
    return pos;
}

// union_decl_variant_index returns the declaration-order index (the runtime
// tag) of the named variant in the UNION_DECL record (-1 when the record does
// not carry it).
fn union_decl_variant_index(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    variant_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= variant_count {
        return 0 - 1;
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 4 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let entry_name = text[entry_name_start..entry_name_end];
    let wanted = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, wanted) {
        return try union_decl_variant_index(text, code, record_pos, variant_count, name_start, name_end, after);
    }
    return index;
}

// code_param_kind classifies a parameter's declared type for the tape: i64
// parameters are kind i64 (rendered 'i64'), bool parameters kind bool (rendered
// 'i1'), []u8 parameters kind slice (rendered '%kizu.slice.u8'), and any other
// type is not owned yet (-1).
fn code_param_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    if type_node_is_i64(text, ast, type_node) {
        return code_kind_i64();
    }
    let type_text = ast_node_text(text, ast, type_node);
    if std::mem::equal_bytes(type_text, "bool") {
        return code_kind_bool();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return code_kind_slice();
    }
    return try code_param_union_kind(text, ast, type_node, code);
}

// code_param_union_kind resolves a union-typed parameter ('Shape' or the
// '&Shape' borrow, passed by value as the runtime aggregate) against the
// UNION_DECL records: the kind stores record_base + <record position>.
fn code_param_union_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>
) -> !i64 {
    let span = code_node_span(text, ast, type_node);
    let name_start = union_param_name_start(text, span.start);
    let pos = try union_decl_pos_by_span(text, code, name_start, span.end, 0);
    if pos < 0 {
        return 0 - 1;
    }
    let record_base = code_kind_struct_base();
    return record_base + pos;
}

// union_param_name_start skips a borrow's leading '&' so the union name span
// matches the declaration.
fn union_param_name_start(text: []u8, start: i64) -> i64 {
    let amp = cast<u8>(38);
    if text[start] == amp {
        return start + 1;
    }
    return start;
}

fn lower_code_statements(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= statements.len {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(statements, index);
    let eval = try lower_code_statement(text, ast, decls, child, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, loop_begin, loop_kind, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_statements(text, ast, decls, statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, loop_begin, loop_kind, after, eval.next);
}

fn lower_code_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statement: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(statement);
    return match node.data {
        Let(let_node) => try lower_code_let(text, ast, decls, let_node.mutable, let_node.name, let_node.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, next_value),
        Assign(assign_node) => try lower_code_assign(text, ast, decls, assign_node.target, assign_node.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        ExprStmt(expr_stmt) => try lower_code_expr_statement(text, ast, decls, expr_stmt.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Return(return_node) => try lower_code_return(text, ast, decls, return_node.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        If(if_node) => try lower_code_if(text, ast, decls, if_node.condition, if_node.then_block, if_node.else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value),
        Match(match_node) => try lower_code_match(text, ast, decls, match_node.value, match_node.arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value),
        While(while_node) => try lower_code_while(text, ast, decls, while_node.label, while_node.condition, while_node.body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        For(for_node) => try lower_code_for(text, ast, decls, for_node.label, for_node.name, for_node.start, for_node.end, for_node.body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Break(break_node) => try lower_code_break(text, ast, break_node.label, code, local_starts, local_ends, local_values, locals_base, loop_begin, loop_kind, next_value),
        Continue(continue_node) => try lower_code_continue(text, ast, continue_node.label, code, local_starts, local_ends, local_values, locals_base, loop_begin, loop_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_if lowers an 'if <cond> { <then> } else { <else> }' statement onto the
// tape: the condition expression lowers to an i1 value, then IF_BEGIN records that
// value, the then-block statements follow, IF_ELSE separates the else-block, and
// IF_END closes it. IF_ELSE/IF_END carry the IF_BEGIN tape index so the renderer's
// labels match. A missing else (Empty) renders an empty else block; an 'else if'
// chains through lower_code_else_block.
fn lower_code_if(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let cond_eval = try lower_code_expr(text, ast, decls, condition, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !cond_eval.ok {
        return code_eval_unsupported(cond_eval.next);
    }
    let if_begin_index = code.len();
    let op_if_begin = code_op_if_begin();
    try code.append(op_if_begin);
    try code.append(cond_eval.value_id);
    let then_eval = try lower_code_body(text, ast, decls, then_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, cond_eval.next);
    if !then_eval.ok {
        return code_eval_unsupported(then_eval.next);
    }
    let op_if_else = code_op_if_else();
    try code.append(op_if_else);
    try code.append(if_begin_index);
    let else_eval = try lower_code_else_block(text, ast, decls, else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, then_eval.next);
    if !else_eval.ok {
        return code_eval_unsupported(else_eval.next);
    }
    let op_if_end = code_op_if_end();
    try code.append(op_if_end);
    try code.append(if_begin_index);
    return code_eval_value(0, else_eval.next);
}

// lower_code_else_block lowers the else arm: an Empty node is a no-else if (the
// else block stays empty), a Block lowers its statements, and an If is an
// 'else if' chained through lower_code_if (its own IF records nest on the tape).
fn lower_code_else_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(else_block);
    return match node.data {
        Empty => code_eval_value(0, next_value),
        Block(block) => try lower_code_nested_statements(text, ast, decls, block.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value),
        If(if_node) => try lower_code_if(text, ast, decls, if_node.condition, if_node.then_block, if_node.else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_match lowers a statement-position 'match <enum> { ... }' as a
// nested if/else chain of tag comparisons over the structured IF records; a
// '_' arm lowers as the unconditional tail. The matched value must trace to an
// ENUM_CONST record so the arm patterns resolve against its enum declaration.
fn lower_code_match(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let value_eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let value_kind = try kinds.get(value_eval.value_id);
    let record_base = code_kind_struct_base();
    if value_kind < record_base {
        return code_eval_unsupported(value_eval.next);
    }
    let record_pos = value_kind - record_base;
    let record_op = try code.get(record_pos);
    let op_enum_const = code_op_enum_const();
    let op_union_const = code_op_union_const();
    let op_union_decl = code_op_union_decl();
    let is_enum = record_op == op_enum_const;
    let is_union = record_op == op_union_const;
    let is_runtime = record_op == op_union_decl;
    let supported = is_enum or is_union or is_runtime;
    if !supported {
        return code_eval_unsupported(value_eval.next);
    }
    if arms.len == 0 {
        return code_eval_unsupported(value_eval.next);
    }
    if is_runtime {
        return try lower_code_runtime_match(text, ast, decls, value_eval.value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, value_eval.next);
    }
    let no_payload_src = 0 - 1;
    return try lower_code_match_arms(text, ast, decls, value_eval.value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, no_payload_src, 0, value_eval.next);
}

// lower_code_runtime_match lowers a match over a runtime union value (a
// UNION_DECL-backed kind): the UNION_TAG read materializes the value's tag
// once and the arm chain compares it against the declaration-order variant
// indices, binding payloads through UNION_PAYLOAD inside the matching arm.
fn lower_code_runtime_match(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let op_union_tag = code_op_union_tag();
    try code.append(op_union_tag);
    try code.append(next_value);
    try code.append(value_id);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let tag_value = next_value;
    let after_tag = next_value + 1;
    return try lower_code_match_arms(text, ast, decls, tag_value, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, value_id, 0, after_tag);
}

// lower_code_match_arms dispatches the arm at index into the nested if chain
// (past the last arm the chain is complete and nothing more lowers).
fn lower_code_match_arms(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    payload_src: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= arms.len {
        return code_eval_value(0, next_value);
    }
    let arm = try ast.child_at(arms, index);
    return try lower_code_match_arm_node(text, ast, decls, value_id, record_pos, arms, arm, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, payload_src, index, next_value);
}

fn lower_code_match_arm_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    arm: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    payload_src: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(arm);
    return match node.data {
        MatchArm(match_arm) => try lower_code_match_arm(text, ast, decls, value_id, record_pos, arms, match_arm.pattern, match_arm.binding, match_arm.body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, payload_src, index, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_match_arm lowers one arm: a '_' pattern lowers its body
// unconditionally (the chain tail), any other pattern compares the matched
// value against its variant tag and the remaining arms nest in the else branch.
fn lower_code_match_arm(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    pattern: std::kizu::ast::NodeId,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    payload_src: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let pattern_text = ast_node_text(text, ast, pattern);
    let tail_index = index + 1;
    let is_tail = tail_index == arms.len;
    if std::mem::equal_bytes(pattern_text, "_") {
        return try lower_code_match_wildcard(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, is_tail, next_value);
    }
    let pattern_span = code_node_span(text, ast, pattern);
    let tag = try match_pattern_tag(text, ast, decls, code, record_pos, pattern_span.start, pattern_span.end);
    if tag < 0 {
        return code_eval_unsupported(next_value);
    }
    let op_const = code_op_const_int();
    try code.append(op_const);
    try code.append(next_value);
    try code.append(tag);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let tag_value = next_value;
    let cond_value = next_value + 1;
    let op_binary = code_op_binary();
    let eq_kind = code_binary_kind(std::kizu::ast::binary_eq());
    try code.append(op_binary);
    try code.append(cond_value);
    try code.append(eq_kind);
    try code.append(value_id);
    try code.append(tag_value);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let after_cond = cond_value + 1;
    let if_begin_index = code.len();
    let op_if_begin = code_op_if_begin();
    try code.append(op_if_begin);
    try code.append(cond_value);
    let arm_payload_kind = try match_arm_payload_kind(code, record_pos, tag);
    let body_eval = try lower_code_match_arm_body(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, record_pos, payload_src, arm_payload_kind, after_cond);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let op_if_else = code_op_if_else();
    try code.append(op_if_else);
    try code.append(if_begin_index);
    let after = index + 1;
    let rest_eval = try lower_code_match_arms(text, ast, decls, value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, payload_src, after, body_eval.next);
    if !rest_eval.ok {
        return code_eval_unsupported(rest_eval.next);
    }
    let op_if_end = code_op_if_end();
    try code.append(op_if_end);
    try code.append(if_begin_index);
    return code_eval_value(0, rest_eval.next);
}

// match_pattern_tag resolves an arm pattern against the matched record's
// declaration: an ENUM_CONST record resolves through the enum declarations, a
// UNION_CONST record through the unions (both keep the name span at +4/+5).
fn match_pattern_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    p_start: i64,
    p_end: i64
) -> !i64 {
    // Dispatch on the record opcode before touching the +4/+5 slots: a
    // UNION_DECL keeps its own variant entries there, so only the compile-time
    // record paths read them as the declaration name span.
    let record_op = try code.get(record_pos);
    let op_union_decl = code_op_union_decl();
    if record_op == op_union_decl {
        return try union_decl_pattern_tag(text, code, record_pos, p_start, p_end);
    }
    let name_start_pos = record_pos + 4;
    let name_start = try code.get(name_start_pos);
    let name_end_pos = record_pos + 5;
    let name_end = try code.get(name_end_pos);
    let op_union_const = code_op_union_const();
    if record_op == op_union_const {
        return try union_variant_tag_lookup(text, ast, decls, name_start, name_end, p_start, p_end, 0);
    }
    return try enum_variant_tag_lookup(text, ast, decls, name_start, name_end, p_start, p_end, 0);
}

// union_decl_pattern_tag resolves an arm pattern against a UNION_DECL record's
// own variant entries (a runtime match needs no AST declaration walk).
fn union_decl_pattern_tag(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    p_start: i64,
    p_end: i64
) -> !i64 {
    let count_pos = record_pos + 3;
    let variant_count = try code.get(count_pos);
    return try union_decl_variant_index(text, code, record_pos, variant_count, p_start, p_end, 0);
}

// match_arm_payload_kind reads the matched variant's payload kind from a
// UNION_DECL record (0 for the compile-time record paths, whose payload flows
// through the UNION_CONST record instead).
fn match_arm_payload_kind(
    code: &var std::array::Array<i64>,
    record_pos: i64,
    tag: i64
) -> !i64 {
    let record_op = try code.get(record_pos);
    let op_union_decl = code_op_union_decl();
    if record_op != op_union_decl {
        return 0;
    }
    let entry_slots = tag * 3;
    let entry_pos = record_pos + 4 + entry_slots;
    let kind_pos = entry_pos + 2;
    let payload_kind = try code.get(kind_pos);
    return payload_kind;
}

// lower_code_match_arm_body lowers one matching arm's body with the union
// payload bound under the arm's binding name when the matched record carries
// one (the binding row blanks after the body so it stays arm-scoped); every
// other shape lowers the body directly.
fn lower_code_match_arm_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    record_pos: i64,
    payload_src: i64,
    arm_payload_kind: i64,
    next_value: i64
) -> !CodeEval {
    let record_op = try code.get(record_pos);
    let op_union_decl = code_op_union_decl();
    if record_op == op_union_decl {
        return try lower_code_runtime_payload_body(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, payload_src, arm_payload_kind, next_value);
    }
    let op_union_const = code_op_union_const();
    if record_op != op_union_const {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value);
    }
    let payload_pos = record_pos + 7;
    let payload_value = try code.get(payload_pos);
    if payload_value < 0 {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value);
    }
    let binding_empty = match_binding_is_empty(ast, binding);
    if binding_empty {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value);
    }
    let binding_span = code_node_span(text, ast, binding);
    let row = local_starts.len();
    try local_starts.append(binding_span.start);
    try local_ends.append(binding_span.end);
    try local_values.append(payload_value);
    let body_eval = try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value);
    try local_starts.set(row, 0);
    try local_ends.set(row, 0);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    return code_eval_value(0, body_eval.next);
}

// lower_code_runtime_payload_body lowers a runtime-union arm body: a variant
// carrying a payload extracts it through UNION_PAYLOAD inside the arm's then
// branch and binds it under the arm's binding name (the row blanks after the
// body so it stays arm-scoped); a payload-less variant or an unbound payload
// lowers the body directly.
fn lower_code_runtime_payload_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    payload_src: i64,
    arm_payload_kind: i64,
    next_value: i64
) -> !CodeEval {
    if arm_payload_kind == 0 {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value);
    }
    // A negative payload kind marks a payload type the layout pass could not
    // classify; extracting it would mis-type the binding, so the arm stays
    // unsupported.
    if arm_payload_kind < 0 {
        return code_eval_unsupported(next_value);
    }
    let binding_empty = match_binding_is_empty(ast, binding);
    if binding_empty {
        return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value);
    }
    let op_union_payload = code_op_union_payload();
    try code.append(op_union_payload);
    try code.append(next_value);
    try code.append(payload_src);
    try code.append(arm_payload_kind);
    try kinds.append(arm_payload_kind);
    let binding_span = code_node_span(text, ast, binding);
    let row = local_starts.len();
    try local_starts.append(binding_span.start);
    try local_ends.append(binding_span.end);
    try local_values.append(next_value);
    let after_payload = next_value + 1;
    let body_eval = try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, after_payload);
    try local_starts.set(row, 0);
    try local_ends.set(row, 0);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    return code_eval_value(0, body_eval.next);
}

// match_binding_is_empty reports whether the arm carries no payload binding.
fn match_binding_is_empty(
    ast: std::kizu::ast::Ast,
    binding: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(binding);
    return match node.data {
        Empty => true,
        _ => false,
    };
}

// lower_code_match_wildcard lowers a '_' arm body unconditionally. The checker
// rejects a non-final wildcard ('wildcard match arm must be last'); the is_tail
// guard keeps a hypothetical unchecked tape from silently dropping the arms
// behind one.
fn lower_code_match_wildcard(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    is_tail: bool,
    next_value: i64
) -> !CodeEval {
    if !is_tail {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_match_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value);
}

// lower_code_match_body lowers one arm body: a bare call or try-call lowers as
// the matching statement form, a block opens its own binding scope.
fn lower_code_match_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(body);
    return match node.data {
        ExprStmt(expr_stmt) => try lower_code_expr_statement(text, ast, decls, expr_stmt.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Call(call_node) => try lower_code_statement_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        TryExpr(try_expr) => try lower_code_try_statement(text, ast, decls, try_expr.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Block(block) => try lower_code_nested_statements(text, ast, decls, block.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, loop_begin, loop_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_if_expr lowers a value-position 'if <cond> { <value> } else
// { <value> }': every branch's trailing expression stores into one result slot
// (the then branch declares it and picks the slot kind; the else branch must
// match) and the merged load past IF_END yields the expression value. The
// reference grammar requires a block else for the expression form, and the
// checker guarantees both branches yield agreeing values.
fn lower_code_if_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    // The result slot reserves a blank locals row like the match expression's.
    let slot = local_starts.len();
    try local_starts.append(0);
    try local_ends.append(0);
    try local_values.append(0);
    let unknown_kind = 0 - 1;
    let chain_eval = try lower_code_if_expr_chain(text, ast, decls, condition, then_block, else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, unknown_kind, next_value);
    if !chain_eval.ok {
        return code_eval_unsupported(chain_eval.next);
    }
    let slot_kind = chain_eval.value_id;
    let load_op = value_slot_load_op(slot_kind);
    try code.append(load_op);
    try code.append(chain_eval.next);
    try code.append(slot);
    try kinds.append(slot_kind);
    let after_value = chain_eval.next + 1;
    return code_eval_value(chain_eval.next, after_value);
}

// lower_code_if_expr_chain lowers one if link of a value-position if into the
// shared result slot and returns the slot kind through the eval's value_id
// (the declaring branch picks it when slot_kind arrives as -1).
fn lower_code_if_expr_chain(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    let cond_eval = try lower_code_expr(text, ast, decls, condition, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !cond_eval.ok {
        return code_eval_unsupported(cond_eval.next);
    }
    let if_begin_index = code.len();
    let op_if_begin = code_op_if_begin();
    try code.append(op_if_begin);
    try code.append(cond_eval.value_id);
    let then_eval = try lower_code_branch_value(text, ast, decls, then_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, cond_eval.next);
    if !then_eval.ok {
        return code_eval_unsupported(then_eval.next);
    }
    let chosen_kind = then_eval.value_id;
    let op_if_else = code_op_if_else();
    try code.append(op_if_else);
    try code.append(if_begin_index);
    let else_eval = try lower_code_else_value(text, ast, decls, else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, chosen_kind, then_eval.next);
    if !else_eval.ok {
        return code_eval_unsupported(else_eval.next);
    }
    let op_if_end = code_op_if_end();
    try code.append(op_if_end);
    try code.append(if_begin_index);
    return code_eval_value(chosen_kind, else_eval.next);
}

// lower_code_else_value routes a value-position else arm: a block stores its
// trailing value, an 'else if' chains into the shared slot, and a missing else
// (checker-illegal for an if expression) stays unsupported.
fn lower_code_else_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    else_block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(else_block);
    return match node.data {
        Block(block) => try lower_code_block_value(text, ast, decls, block.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, next_value),
        If(if_node) => try lower_code_if_expr_chain(text, ast, decls, if_node.condition, if_node.then_block, if_node.else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_branch_value dispatches a value branch (a Block whose trailing
// ExprStmt is the branch value).
fn lower_code_branch_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    block: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(block);
    return match node.data {
        Block(b) => try lower_code_block_value(text, ast, decls, b.statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_block_value lowers a value branch body: the leading statements
// lower in their own scope, the trailing expression lowers to the branch value
// (strings materialize through STR_SLICE), and the value stores into the
// result slot through lower_code_value_store.
fn lower_code_block_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    if statements.len == 0 {
        return code_eval_unsupported(next_value);
    }
    let mark = local_starts.len();
    let lead_len = statements.len - 1;
    let lead_eval = try lower_code_value_leads(text, ast, decls, statements, lead_len, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, mark, 0, next_value);
    if !lead_eval.ok {
        return code_eval_unsupported(lead_eval.next);
    }
    let trailing = try ast.child_at(statements, lead_len);
    let value_eval = try lower_code_trailing_value(text, ast, decls, trailing, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, lead_eval.next);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let stored_eval = try lower_code_arg_slice(text, code, kinds, value_eval.value_id, value_eval.next);
    let stored_kind = try kinds.get(stored_eval.value_id);
    try scrub_code_locals(local_starts, local_ends, mark);
    return try lower_code_value_store(code, slot, slot_kind, stored_kind, stored_eval.value_id, stored_eval.next);
}

// lower_code_value_leads lowers the branch statements before the trailing
// value expression (break/continue carry no enclosing loop context here, so
// they stay unsupported inside a value branch).
fn lower_code_value_leads(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    bound: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= bound {
        return code_eval_value(0, next_value);
    }
    let child = try ast.child_at(statements, index);
    let no_loop = 0 - 1;
    let eval = try lower_code_statement(text, ast, decls, child, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, no_loop, 0, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_value_leads(text, ast, decls, statements, bound, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, after, eval.next);
}

// lower_code_trailing_value lowers a trailing value expression: the real
// parser wraps it as an ExprStmt (unwrapped here), the hosted CLI boundary
// hands the bare expression node directly, and any non-expression node falls
// to the expression dispatch's own unsupported result.
fn lower_code_trailing_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    trailing: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(trailing);
    return match node.data {
        ExprStmt(expr_stmt) => try lower_code_expr(text, ast, decls, expr_stmt.expr, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => try lower_code_expr(text, ast, decls, trailing, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
    };
}

// lower_code_value_store writes a branch value into the result slot: the
// declaring branch (slot_kind -1) emits the slot's decl and returns the chosen
// kind through the eval's value_id, every other branch kind-checks and stores.
fn lower_code_value_store(
    code: &var std::array::Array<i64>,
    slot: i64,
    slot_kind: i64,
    stored_kind: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let unknown_kind = 0 - 1;
    if slot_kind == unknown_kind {
        return try lower_code_value_decl(code, slot, stored_kind, value_id, next_value);
    }
    if stored_kind != slot_kind {
        return code_eval_unsupported(next_value);
    }
    let store_op = value_slot_store_op(slot_kind);
    try code.append(store_op);
    try code.append(slot);
    try code.append(value_id);
    return code_eval_value(slot_kind, next_value);
}

// lower_code_value_decl emits the declaring branch's slot decl and returns the
// chosen kind through the eval's value_id.
fn lower_code_value_decl(
    code: &var std::array::Array<i64>,
    slot: i64,
    stored_kind: i64,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    let decl_op = value_slot_decl_op(stored_kind);
    if decl_op < 0 {
        return code_eval_unsupported(next_value);
    }
    try code.append(decl_op);
    try code.append(slot);
    try code.append(value_id);
    return code_eval_value(stored_kind, next_value);
}

// value_slot_decl_op / value_slot_store_op / value_slot_load_op pick the slot
// trio for a value-position if/match result kind (-1 = not slot-backed).
fn value_slot_decl_op(stored_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if stored_kind == kind_i64 {
        return code_op_var_decl();
    }
    let kind_bool = code_kind_bool();
    if stored_kind == kind_bool {
        return code_op_var_decl_bool();
    }
    let kind_slice = code_kind_slice();
    if stored_kind == kind_slice {
        return code_op_var_decl_slice();
    }
    return 0 - 1;
}

fn value_slot_store_op(slot_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if slot_kind == kind_i64 {
        return code_op_var_store();
    }
    let kind_bool = code_kind_bool();
    if slot_kind == kind_bool {
        return code_op_var_store_bool();
    }
    return code_op_var_store_slice();
}

fn value_slot_load_op(slot_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if slot_kind == kind_i64 {
        return code_op_var_load();
    }
    let kind_bool = code_kind_bool();
    if slot_kind == kind_bool {
        return code_op_var_load_bool();
    }
    return code_op_var_load_slice();
}

// lower_code_match_expr lowers a value-position 'match <enum/union> { ... }':
// the arms reuse the statement match's tag chain, every arm's value expression
// stores into one result slot (the first arm declares it), and the merged load
// past the chain yields the expression value. The lowering leans on the
// checker's exhaustiveness guarantee: if no arm matched at runtime the result
// slot would read uninitialized, so an unchecked tape must not reach this.
fn lower_code_match_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let value_eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let value_kind = try kinds.get(value_eval.value_id);
    let record_base = code_kind_struct_base();
    if value_kind < record_base {
        return code_eval_unsupported(value_eval.next);
    }
    let record_pos = value_kind - record_base;
    let record_op = try code.get(record_pos);
    let op_enum_const = code_op_enum_const();
    let op_union_const = code_op_union_const();
    if record_op != op_enum_const {
        if record_op != op_union_const {
            return code_eval_unsupported(value_eval.next);
        }
    }
    if arms.len == 0 {
        return code_eval_unsupported(value_eval.next);
    }
    let slot = local_starts.len();
    try local_starts.append(0);
    try local_ends.append(0);
    try local_values.append(0);
    let unknown_kind = 0 - 1;
    let arms_eval = try lower_code_match_expr_arms(text, ast, decls, value_eval.value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, unknown_kind, 0, value_eval.next);
    if !arms_eval.ok {
        return code_eval_unsupported(arms_eval.next);
    }
    let slot_kind = arms_eval.value_id;
    let load_op = value_slot_load_op(slot_kind);
    try code.append(load_op);
    try code.append(arms_eval.next);
    try code.append(slot);
    try kinds.append(slot_kind);
    let after_value = arms_eval.next + 1;
    return code_eval_value(arms_eval.next, after_value);
}

// lower_code_match_expr_arms dispatches the value arm at index into the nested
// if chain (the chain kind flows through the eval's value_id).
fn lower_code_match_expr_arms(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= arms.len {
        return code_eval_value(slot_kind, next_value);
    }
    let arm = try ast.child_at(arms, index);
    return try lower_code_match_expr_arm_node(text, ast, decls, value_id, record_pos, arms, arm, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, index, next_value);
}

fn lower_code_match_expr_arm_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    arm: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(arm);
    return match node.data {
        MatchArm(match_arm) => try lower_code_match_expr_arm(text, ast, decls, value_id, record_pos, arms, match_arm.pattern, match_arm.binding, match_arm.body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, slot_kind, index, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_match_expr_arm lowers one value arm: a '_' tail stores its value
// unconditionally, any other pattern compares the tag and the remaining arms
// nest in the else branch (sharing the slot kind the first arm chose).
fn lower_code_match_expr_arm(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value_id: i64,
    record_pos: i64,
    arms: std::kizu::ast::ChildRange,
    pattern: std::kizu::ast::NodeId,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    slot: i64,
    slot_kind: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let pattern_text = ast_node_text(text, ast, pattern);
    let tail_index = index + 1;
    let is_tail = tail_index == arms.len;
    if std::mem::equal_bytes(pattern_text, "_") {
        return try lower_code_match_expr_wildcard(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, record_pos, slot, slot_kind, is_tail, next_value);
    }
    let pattern_span = code_node_span(text, ast, pattern);
    let tag = try match_pattern_tag(text, ast, decls, code, record_pos, pattern_span.start, pattern_span.end);
    if tag < 0 {
        return code_eval_unsupported(next_value);
    }
    let op_const = code_op_const_int();
    try code.append(op_const);
    try code.append(next_value);
    try code.append(tag);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let tag_value = next_value;
    let cond_value = next_value + 1;
    let op_binary = code_op_binary();
    let eq_kind = code_binary_kind(std::kizu::ast::binary_eq());
    try code.append(op_binary);
    try code.append(cond_value);
    try code.append(eq_kind);
    try code.append(value_id);
    try code.append(tag_value);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let after_cond = cond_value + 1;
    let if_begin_index = code.len();
    let op_if_begin = code_op_if_begin();
    try code.append(op_if_begin);
    try code.append(cond_value);
    let body_eval = try lower_code_match_expr_arm_value(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, record_pos, slot, slot_kind, after_cond);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let chosen_kind = body_eval.value_id;
    let op_if_else = code_op_if_else();
    try code.append(op_if_else);
    try code.append(if_begin_index);
    let after = index + 1;
    let rest_eval = try lower_code_match_expr_arms(text, ast, decls, value_id, record_pos, arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, slot, chosen_kind, after, body_eval.next);
    if !rest_eval.ok {
        return code_eval_unsupported(rest_eval.next);
    }
    let op_if_end = code_op_if_end();
    try code.append(op_if_end);
    try code.append(if_begin_index);
    return code_eval_value(chosen_kind, rest_eval.next);
}

// lower_code_match_expr_wildcard stores the '_' arm's value unconditionally
// (the guard mirrors the statement match: a non-final wildcard is rejected).
fn lower_code_match_expr_wildcard(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    record_pos: i64,
    slot: i64,
    slot_kind: i64,
    is_tail: bool,
    next_value: i64
) -> !CodeEval {
    if !is_tail {
        return code_eval_unsupported(next_value);
    }
    return try lower_code_match_expr_arm_value(text, ast, decls, binding, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, record_pos, slot, slot_kind, next_value);
}

// lower_code_match_expr_arm_value lowers one value arm's body expression (with
// the union payload bound under the arm's binding name when the matched record
// carries one) and stores it into the result slot.
fn lower_code_match_expr_arm_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    record_pos: i64,
    slot: i64,
    slot_kind: i64,
    next_value: i64
) -> !CodeEval {
    let row = try match_expr_bind_payload(text, ast, binding, code, local_starts, local_ends, local_values, record_pos);
    let value_eval = try lower_code_trailing_value(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    try match_expr_unbind_payload(local_starts, local_ends, row);
    if !value_eval.ok {
        return code_eval_unsupported(value_eval.next);
    }
    let stored_eval = try lower_code_arg_slice(text, code, kinds, value_eval.value_id, value_eval.next);
    let stored_kind = try kinds.get(stored_eval.value_id);
    return try lower_code_value_store(code, slot, slot_kind, stored_kind, stored_eval.value_id, stored_eval.next);
}

// match_expr_bind_payload binds the union payload under the arm's binding name
// (returning the binding row, or -1 when nothing binds).
fn match_expr_bind_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    binding: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    record_pos: i64
) -> !i64 {
    let record_op = try code.get(record_pos);
    let op_union_const = code_op_union_const();
    if record_op != op_union_const {
        return 0 - 1;
    }
    let payload_pos = record_pos + 7;
    let payload_value = try code.get(payload_pos);
    if payload_value < 0 {
        return 0 - 1;
    }
    let binding_empty = match_binding_is_empty(ast, binding);
    if binding_empty {
        return 0 - 1;
    }
    let binding_span = code_node_span(text, ast, binding);
    let row = local_starts.len();
    try local_starts.append(binding_span.start);
    try local_ends.append(binding_span.end);
    try local_values.append(payload_value);
    return row;
}

// match_expr_unbind_payload blanks the payload binding row after the arm body.
fn match_expr_unbind_payload(
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    row: i64
) -> !void {
    if row < 0 {
        return;
    }
    try local_starts.set(row, 0);
    try local_ends.set(row, 0);
    return;
}

// lower_code_nested_statements opens a fresh binding scope for a statement list
// that arrives without its own Block node walk (the else arm's block).
fn lower_code_nested_statements(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    statements: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let scope_base = local_starts.len();
    return try lower_code_scoped_statements(text, ast, decls, statements, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scope_base, loop_begin, loop_kind, next_value);
}

// lower_code_let binds a let local: the value expression lowers to a tape
// value id and the name span joins the function's locals. A name already bound
// in this function is not owned by the tape (the unified unsupported result).
fn lower_code_let(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    mutable: bool,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scope_base: i64,
    next_value: i64
) -> !CodeEval {
    // Re-binding a name already bound in this same scope is the checker-illegal
    // duplicate (shadowing an outer scope's binding is fine: the new binding
    // simply appends and the backward lookup resolves it first).
    let name_span = code_node_span(text, ast, name);
    let existing = try code_scope_lookup(text, local_starts, local_ends, local_values, scope_base, name_span.start, name_span.end);
    if existing >= 0 {
        return code_eval_unsupported(next_value);
    }
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    if mutable {
        return try lower_code_var_binding(text, name_span.start, name_span.end, eval.value_id, code, kinds, local_starts, local_ends, local_values, eval.next);
    }
    try local_starts.append(name_span.start);
    try local_ends.append(name_span.end);
    try local_values.append(eval.value_id);
    return code_eval_value(eval.value_id, eval.next);
}

// lower_code_var_binding routes a 'var' init by its kind: an i64 init takes an
// i64 slot, a struct-literal init scalarizes into per-field slots, and any
// other kind (bool/str/slice) is not owned by the tape yet.
fn lower_code_var_binding(
    text: []u8,
    name_start: i64,
    name_end: i64,
    init_value_id: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let kind_i64 = code_kind_i64();
    let init_kind = try kinds.get(init_value_id);
    if init_kind == kind_i64 {
        return try bind_code_var(text, name_start, name_end, init_value_id, code, local_starts, local_ends, local_values, next_value);
    }
    let record_base = code_kind_struct_base();
    if init_kind < record_base {
        return code_eval_unsupported(next_value);
    }
    let record_pos = init_kind - record_base;
    let record_op = try code.get(record_pos);
    let op_struct_lit = code_op_struct_lit();
    if record_op != op_struct_lit {
        return code_eval_unsupported(next_value);
    }
    return try bind_code_var_struct(text, name_start, name_end, record_pos, code, kinds, local_starts, local_ends, local_values, next_value);
}

// bind_code_var_struct scalarizes a 'var <name> = <struct literal>' binding:
// every literal field takes its own slot (i64 fields through the i64 trio,
// str/slice fields through the slice trio after STR_SLICE materialization),
// the VAR_STRUCT record maps the field names to their slots and kinds, and the
// local binds the record's dst value like a let binding.
fn bind_code_var_struct(
    text: []u8,
    name_start: i64,
    name_end: i64,
    record_pos: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let count_pos = record_pos + 2;
    let field_count = try code.get(count_pos);
    // Slot ids come from the locals-array length, so the two field walks see the
    // same deterministic numbering: the decl walk reserves one blank row per
    // field, then the record walk recomputes slot_base + index.
    let slot_base = local_starts.len();
    let decls_eval = try emit_var_struct_decls(text, code, kinds, local_starts, local_ends, local_values, record_pos, field_count, 0, next_value);
    if !decls_eval.ok {
        return code_eval_unsupported(decls_eval.next);
    }
    let var_struct_pos = code.len();
    let op_var_struct = code_op_var_struct();
    try code.append(op_var_struct);
    try code.append(decls_eval.next);
    try code.append(field_count);
    try append_var_struct_fields(code, kinds, record_pos, field_count, slot_base, 0);
    let record_base = code_kind_struct_base();
    let record_kind = record_base + var_struct_pos;
    try kinds.append(record_kind);
    try local_starts.append(name_start);
    try local_ends.append(name_end);
    try local_values.append(decls_eval.next);
    let after_value = decls_eval.next + 1;
    return code_eval_value(decls_eval.next, after_value);
}

// emit_var_struct_decls walks the STRUCT_LIT record's fields and emits one slot
// decl per field (reserving its blank locals row); a str field materializes its
// slice first, and any other non-i64/non-slice field is unsupported.
fn emit_var_struct_decls(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= field_count {
        return code_eval_value(0, next_value);
    }
    let entry_slots = index * 3;
    let value_pos = record_pos + 5 + entry_slots;
    let field_value = try code.get(value_pos);
    let eval = try emit_one_var_struct_decl(text, code, kinds, local_starts, local_ends, local_values, field_value, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try emit_var_struct_decls(text, code, kinds, local_starts, local_ends, local_values, record_pos, field_count, after, eval.next);
}

// emit_one_var_struct_decl gives one scalarized field its slot: the slot id is
// the blank locals row this decl reserves (the row's empty span never matches a
// name lookup).
fn emit_one_var_struct_decl(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    field_value: i64,
    next_value: i64
) -> !CodeEval {
    let slice_eval = try lower_code_arg_slice(text, code, kinds, field_value, next_value);
    let stored_kind = try kinds.get(slice_eval.value_id);
    let slot = local_starts.len();
    let kind_i64 = code_kind_i64();
    let slice_kind = code_kind_slice();
    if stored_kind != kind_i64 {
        if stored_kind != slice_kind {
            return code_eval_unsupported(slice_eval.next);
        }
    }
    let decl_op = var_struct_decl_op(stored_kind);
    try code.append(decl_op);
    try code.append(slot);
    try code.append(slice_eval.value_id);
    try local_starts.append(0);
    try local_ends.append(0);
    try local_values.append(0);
    return code_eval_value(slice_eval.value_id, slice_eval.next);
}

// var_struct_decl_op picks the slot trio for a scalarized field's stored kind.
fn var_struct_decl_op(stored_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if stored_kind == kind_i64 {
        return code_op_var_decl();
    }
    return code_op_var_decl_slice();
}

// var_struct_slot_kind maps a literal field's original kind to its slot kind:
// an i64 field keeps an i64 slot, a str/slice field takes a slice slot. The
// fallthrough is only reachable for str/slice because emit_var_struct_decls
// already rejected every other kind before this walk runs.
fn var_struct_slot_kind(field_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if field_kind == kind_i64 {
        return kind_i64;
    }
    return code_kind_slice();
}

// append_var_struct_fields copies each field's name span, recomputed slot, and
// slot kind onto the VAR_STRUCT record, mirroring the emit_var_struct_decls walk.
fn append_var_struct_fields(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    slot_base: i64,
    index: i64
) -> !void {
    if index >= field_count {
        return;
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 3 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let value_pos = entry_pos + 2;
    let field_value = try code.get(value_pos);
    let field_kind = try kinds.get(field_value);
    let slot_kind = var_struct_slot_kind(field_kind);
    let slot = slot_base + index;
    try code.append(entry_name_start);
    try code.append(entry_name_end);
    try code.append(slot);
    try code.append(slot_kind);
    let after = index + 1;
    try append_var_struct_fields(code, kinds, record_pos, field_count, slot_base, after);
    return;
}

// bind_code_var binds a 'var' local to a fresh alloca slot and emits the VAR_DECL
// record that stores its init value. The slot id is the local's index in the
// parallel arrays (globally unique within the lowering run), stored offset by
// code_var_slot_base so a locals lookup distinguishes the var from a let value.
fn bind_code_var(
    text: []u8,
    name_start: i64,
    name_end: i64,
    init_value_id: i64,
    code: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let slot = local_starts.len();
    let op_var_decl = code_op_var_decl();
    try code.append(op_var_decl);
    try code.append(slot);
    try code.append(init_value_id);
    let stored = code_var_slot_base() + slot;
    try local_starts.append(name_start);
    try local_ends.append(name_end);
    try local_values.append(stored);
    return code_eval_value(init_value_id, next_value);
}

// lower_code_assign lowers 'name = <expr>' for a var local: the value lowers to a
// tape value and a VAR_STORE writes it into the var's slot. The target must be a
// bare var name already bound as a var (a let or unknown name is not owned here).
fn lower_code_assign(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let field_entry = try code_assign_field_entry(text, ast, target, code, kinds, local_starts, local_ends, local_values, locals_base);
    if field_entry >= 0 {
        return try lower_code_field_assign(text, ast, decls, field_entry, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let slot = try code_assign_target_slot(text, ast, target, local_starts, local_ends, local_values, locals_base);
    if slot < 0 {
        return code_eval_unsupported(next_value);
    }
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    // Var slots are i64 allocas; storing a non-i64 value is not owned yet.
    let kind_i64 = code_kind_i64();
    let stored_kind = try kinds.get(eval.value_id);
    if stored_kind != kind_i64 {
        return code_eval_unsupported(eval.next);
    }
    let op_var_store = code_op_var_store();
    try code.append(op_var_store);
    try code.append(slot);
    try code.append(eval.value_id);
    return code_eval_value(eval.value_id, eval.next);
}

// code_assign_field_entry resolves an assignment target to its scalarized
// var-struct field entry (-1 when the target is not 'var_struct.field').
fn code_assign_field_entry(
    text: []u8,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let node = ast.get(target);
    return match node.data {
        FieldExpr(field_expr) => try code_assign_field_expr_entry(text, ast, field_expr.receiver, field_expr.name, field_expr.namespace, code, kinds, local_starts, local_ends, local_values, locals_base),
        _ => code_assign_no_field(),
    };
}

fn code_assign_no_field() -> i64 {
    return 0 - 1;
}

// code_assign_field_expr_entry resolves a '<name>.<field>' assignment target:
// the receiver must be a local bound to a VAR_STRUCT record value (nested
// receivers and let structs stay unsupported).
fn code_assign_field_expr_entry(
    text: []u8,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    if namespace {
        return 0 - 1;
    }
    let receiver_span = code_node_span(text, ast, receiver);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, receiver_span.start, receiver_span.end);
    if bound < 0 {
        return 0 - 1;
    }
    let slot_floor = code_var_slot_base();
    if bound >= slot_floor {
        return 0 - 1;
    }
    let value_kind = try kinds.get(bound);
    let record_base = code_kind_struct_base();
    if value_kind < record_base {
        return 0 - 1;
    }
    let record_pos = value_kind - record_base;
    let record_op = try code.get(record_pos);
    let op_var_struct = code_op_var_struct();
    if record_op != op_var_struct {
        return 0 - 1;
    }
    let count_pos = record_pos + 2;
    let field_count = try code.get(count_pos);
    let name_span = code_node_span(text, ast, name);
    return try var_struct_field_entry(text, code, record_pos, field_count, name_span.start, name_span.end, 0);
}

// lower_code_field_assign lowers 'obj.field = <expr>;' for a scalarized var
// struct: the value lowers (a string materializes through STR_SLICE), its kind
// must match the field's slot kind, and the matching store writes the slot.
fn lower_code_field_assign(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    field_entry: i64,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, eval.value_id, eval.next);
    let stored_kind = try kinds.get(slice_eval.value_id);
    let kind_pos = field_entry + 3;
    let slot_kind = try code.get(kind_pos);
    if stored_kind != slot_kind {
        return code_eval_unsupported(slice_eval.next);
    }
    let slot_pos = field_entry + 2;
    let slot = try code.get(slot_pos);
    let store_op = var_struct_store_op(slot_kind);
    try code.append(store_op);
    try code.append(slot);
    try code.append(slice_eval.value_id);
    return code_eval_value(slice_eval.value_id, slice_eval.next);
}

// code_assign_target_slot resolves an assignment target to its var slot, or -1
// when the target is not a bare var name bound as a var (the tape owns only var
// reassignment, not let rebinding or field/index targets).
fn code_assign_target_slot(
    text: []u8,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let node = ast.get(target);
    return match node.data {
        Var(var_node) => try code_var_slot_of(text, ast, target, local_starts, local_ends, local_values, locals_base),
        _ => code_unbound_slot(),
    };
}

// code_unbound_slot returns the -1 sentinel a slot lookup uses for an unbound or
// non-var target. It is a call so the match arm stays one of the traversal arm
// shapes (a call) rather than the arith expression '0 - 1' the lowering rejects.
fn code_unbound_slot() -> i64 {
    return 0 - 1;
}

// code_var_slot_of returns the var slot bound to a Var-node name, or -1 when the
// name is unbound or bound as a let (a non-var value below the slot base).
fn code_var_slot_of(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let name_span = code_node_span(text, ast, node_id);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    let base = code_var_slot_base();
    if bound < base {
        return 0 - 1;
    }
    return bound - base;
}

// lower_code_while lowers 'while <cond> { <body> }' onto the tape: WHILE_BEGIN
// opens the condition block, the condition expression lowers to an i1 value,
// WHILE_COND branches on it, the body statements follow with this loop as their
// break/continue target, and WHILE_END closes the loop. All three records carry
// the WHILE_BEGIN tape index so the renderer's labels match.
fn lower_code_while(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    label: std::kizu::ast::NodeId,
    condition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let while_begin_index = code.len();
    let label_mark = local_starts.len();
    let kind_label_while = code_loop_kind_while();
    try bind_code_loop_label(text, ast, label, local_starts, local_ends, local_values, while_begin_index, kind_label_while);
    let op_while_begin = code_op_while_begin();
    try code.append(op_while_begin);
    try code.append(while_begin_index);
    let cond_eval = try lower_code_expr(text, ast, decls, condition, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !cond_eval.ok {
        return code_eval_unsupported(cond_eval.next);
    }
    let op_while_cond = code_op_while_cond();
    try code.append(op_while_cond);
    try code.append(cond_eval.value_id);
    try code.append(while_begin_index);
    let kind_while = code_loop_kind_while();
    let body_eval = try lower_code_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, while_begin_index, kind_while, cond_eval.next);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    let op_while_end = code_op_while_end();
    try code.append(op_while_end);
    try code.append(while_begin_index);
    try scrub_code_locals(local_starts, local_ends, label_mark);
    return code_eval_value(0, body_eval.next);
}

// lower_code_for lowers 'for <start>..<end> |name| { <body> }': the start and end
// bounds lower to values, the induction name binds to a fresh var slot, FOR_BEGIN
// seeds the slot and opens the bounded condition block (carrying the load/compare
// temp ids), the body statements follow with this loop as their break/continue
// target, and FOR_END emits the increment latch (carrying its temp ids).
fn lower_code_for(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    label: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let start_eval = try lower_code_expr(text, ast, decls, start, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !start_eval.ok {
        return code_eval_unsupported(start_eval.next);
    }
    let end_eval = try lower_code_expr(text, ast, decls, end, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, start_eval.next);
    if !end_eval.ok {
        return code_eval_unsupported(end_eval.next);
    }
    // The induction name binds in its own loop scope: it may shadow any outer
    // binding and is scrubbed once the loop closes.
    let name_span = code_node_span(text, ast, name);
    let induction_mark = local_starts.len();
    let slot = induction_mark;
    let stored = code_var_slot_base() + slot;
    try local_starts.append(name_span.start);
    try local_ends.append(name_span.end);
    try local_values.append(stored);
    // FOR_BEGIN's condition block loads the induction slot and compares it to the
    // end bound; both temps take fresh value ids (with parallel kinds entries).
    let cond_load_value = end_eval.next;
    let cond_cmp_value = cond_load_value + 1;
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let for_begin_index = code.len();
    let op_for_begin = code_op_for_begin();
    try code.append(op_for_begin);
    try code.append(for_begin_index);
    try code.append(slot);
    try code.append(start_eval.value_id);
    try code.append(end_eval.value_id);
    try code.append(cond_load_value);
    try code.append(cond_cmp_value);
    let kind_for = code_loop_kind_for();
    try bind_code_loop_label(text, ast, label, local_starts, local_ends, local_values, for_begin_index, kind_for);
    let body_next = cond_cmp_value + 1;
    let body_eval = try lower_code_body(text, ast, decls, body, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, for_begin_index, kind_for, body_next);
    if !body_eval.ok {
        return code_eval_unsupported(body_eval.next);
    }
    // FOR_END's latch loads the slot, adds one, and stores it back; both temps
    // take fresh value ids (with parallel kinds entries).
    let latch_load_value = body_eval.next;
    let latch_add_value = latch_load_value + 1;
    try kinds.append(kind_i64);
    try kinds.append(kind_i64);
    let op_for_end = code_op_for_end();
    try code.append(op_for_end);
    try code.append(for_begin_index);
    try code.append(slot);
    try code.append(latch_load_value);
    try code.append(latch_add_value);
    try scrub_code_locals(local_starts, local_ends, induction_mark);
    let after_value = latch_add_value + 1;
    return code_eval_value(0, after_value);
}

// lower_code_break / lower_code_continue emit the BREAK / CONTINUE record for the
// enclosing loop (a bare statement) or for the loop the statement's label names.
// Outside any loop (loop_begin < 0) a bare statement is not owned.
fn lower_code_break(
    text: []u8,
    ast: std::kizu::ast::Ast,
    label: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let op_break = code_op_break();
    if is_empty_node(ast, label) {
        return try emit_code_loop_exit(code, op_break, loop_begin, loop_kind, next_value);
    }
    let target = try code_loop_label_target(text, ast, label, local_starts, local_ends, local_values, locals_base);
    if target < 0 {
        return code_eval_unsupported(next_value);
    }
    let target_begin = code_loop_label_target_begin(target);
    let target_kind = code_loop_label_target_kind(target, target_begin);
    return try emit_code_loop_exit(code, op_break, target_begin, target_kind, next_value);
}

fn lower_code_continue(
    text: []u8,
    ast: std::kizu::ast::Ast,
    label: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    let op_continue = code_op_continue();
    if is_empty_node(ast, label) {
        return try emit_code_loop_exit(code, op_continue, loop_begin, loop_kind, next_value);
    }
    let target = try code_loop_label_target(text, ast, label, local_starts, local_ends, local_values, locals_base);
    if target < 0 {
        return code_eval_unsupported(next_value);
    }
    let target_begin = code_loop_label_target_begin(target);
    let target_kind = code_loop_label_target_kind(target, target_begin);
    return try emit_code_loop_exit(code, op_continue, target_begin, target_kind, next_value);
}

// emit_code_loop_exit appends one BREAK or CONTINUE record targeting the loop
// whose WHILE/FOR begin index and kind are given.
fn emit_code_loop_exit(
    code: &var std::array::Array<i64>,
    op: i64,
    loop_begin: i64,
    loop_kind: i64,
    next_value: i64
) -> !CodeEval {
    if loop_begin < 0 {
        return code_eval_unsupported(next_value);
    }
    try code.append(op);
    try code.append(loop_begin);
    try code.append(loop_kind);
    return code_eval_value(0, next_value);
}

// bind_code_loop_label registers a loop's label (when present) as a scoped
// binding whose value encodes the loop's begin index and kind, so a labeled
// break/continue resolves its target through the ordinary locals lookup and the
// binding stops resolving once the loop's scrub closes it.
fn bind_code_loop_label(
    text: []u8,
    ast: std::kizu::ast::Ast,
    label: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    loop_begin: i64,
    loop_kind: i64
) -> !void {
    if is_empty_node(ast, label) {
        return;
    }
    let name_span = code_node_span(text, ast, label);
    let doubled = loop_begin * 2;
    let tagged = doubled + loop_kind;
    let stored = code_loop_label_base() + tagged;
    try local_starts.append(name_span.start);
    try local_ends.append(name_span.end);
    try local_values.append(stored);
    return;
}

// code_loop_label_target resolves a label name to its encoded loop value, or -1
// when the name is unbound or bound to something that is not a loop label.
fn code_loop_label_target(
    text: []u8,
    ast: std::kizu::ast::Ast,
    label: std::kizu::ast::NodeId,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64
) -> !i64 {
    let name_span = code_node_span(text, ast, label);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    let base = code_loop_label_base();
    if bound < base {
        return 0 - 1;
    }
    return bound;
}

// code_loop_label_target_begin / code_loop_label_target_kind decode an encoded
// loop-label value back into the target loop's begin index and kind.
fn code_loop_label_target_begin(target: i64) -> i64 {
    let encoded = target - code_loop_label_base();
    let begin = encoded / 2;
    return begin;
}

fn code_loop_label_target_kind(target: i64, target_begin: i64) -> i64 {
    let encoded = target - code_loop_label_base();
    let doubled = target_begin * 2;
    let kind = encoded - doubled;
    return kind;
}

// lower_code_expr_statement lowers a statement-position expression; the tape
// owns the print(<expr>) call, recorded with the argument's value kind so the
// renderer picks the string or decimal writer.
fn lower_code_expr_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    expr: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_code_statement_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        TryExpr(try_expr) => try lower_code_try_statement(text, ast, decls, try_expr.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_statement_call routes a statement-position call: print(<expr>) keeps
// its PRINT record, every other callee lowers as an ordinary user CALL whose
// result value simply stays unused.
fn lower_code_statement_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "print") {
        return try lower_code_print_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::testing::expect") {
        return try lower_code_expect_call(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return try lower_code_user_call_statement(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

// lower_code_expect_call lowers 'std::testing::expect(<cond>)': the single
// argument lowers to an i1 value and the EXPECT record branches on it.
fn lower_code_expect_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let cond_kind = try kinds.get(eval.value_id);
    let kind_bool = code_kind_bool();
    if cond_kind != kind_bool {
        return code_eval_unsupported(eval.next);
    }
    let op_expect = code_op_expect();
    try code.append(op_expect);
    try code.append(eval.value_id);
    return code_eval_value(0, eval.next);
}

// lower_code_user_call_statement lowers a statement-position call to a declared
// void (kind 0) or i64 (kind 1) function as a CALL record; a void callee compiles
// as an i64 define returning 0, so the same record shape serves both.
fn lower_code_user_call_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let callee_kind = try code_callee_return_kind(text, ast, decls, code, callee_span.start, callee_span.end, 0);
    // A void callee defines (and calls) through the i64 ABI, so its discarded
    // result records the i64 kind.
    if callee_kind == 0 {
        return try emit_code_user_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, 1, next_value);
    }
    if callee_kind == 1 {
        return try emit_code_user_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, 1, next_value);
    }
    return code_eval_unsupported(next_value);
}

// lower_code_try_statement lowers a 'try <call>;' statement: the try value must be
// a direct call to an error-union-void function, lowered onto the tape as TRY_CALL.
fn lower_code_try_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    call_expr: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(call_expr);
    return match node.data {
        Call(call_node) => try lower_code_try_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_try_call lowers 'try <callee>(<args>)' where callee is a declared
// error-union-void function: the argument expressions lower first, then the
// TRY_CALL record carries the callee name span, the argument count, and the
// argument value ids copied off the scratch tail. The try yields no value, so
// no result value id is consumed.
fn lower_code_try_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "std::io::write_stdout") {
        return try lower_code_try_io_write_stdout(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if std::mem::equal_bytes(callee_text, "std::io::write_stderr") {
        return try lower_code_try_io_write_stderr(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let callee_span = code_node_span(text, ast, callee);
    let callee_kind = try code_callee_return_kind(text, ast, decls, code, callee_span.start, callee_span.end, 0);
    if callee_kind == 2 {
        return try emit_code_try_call_void(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    // A statement-position 'try <!i64 callee>();' discards the success value;
    // the TRY_CALL_I64 record still allocates its result id.
    if callee_kind == 3 {
        return try emit_code_try_call_i64(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

// lower_code_try_io_write_stdout / lower_code_try_io_write_stderr bind their
// stream tag in their own frame so the dispatch above stays a run of
// single-statement guards.
fn lower_code_try_io_write_stdout(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let stream = code_io_stream_stdout();
    return try lower_code_try_io_write(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, stream, next_value);
}

fn lower_code_try_io_write_stderr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let stream = code_io_stream_stderr();
    return try lower_code_try_io_write(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, stream, next_value);
}

// lower_code_try_io_write lowers 'try std::io::write_stdout/write_stderr(io,
// bytes)': the io handle must lower to a kind-owned value and the message to a
// kind-slice value (a string literal materializes through STR_SLICE), then the
// TRY_IO_WRITE record carries both value ids and the stream tag.
fn lower_code_try_io_write(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    stream: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let io_arg = try ast.child_at(args, 0);
    let io_eval = try lower_code_expr(text, ast, decls, io_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !io_eval.ok {
        return code_eval_unsupported(io_eval.next);
    }
    let io_kind = try kinds.get(io_eval.value_id);
    let owned_kind = code_kind_owned();
    if io_kind != owned_kind {
        return code_eval_unsupported(io_eval.next);
    }
    let msg_arg = try ast.child_at(args, 1);
    let msg_eval = try lower_code_expr(text, ast, decls, msg_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, io_eval.next);
    if !msg_eval.ok {
        return code_eval_unsupported(msg_eval.next);
    }
    let slice_eval = try lower_code_arg_slice(text, code, kinds, msg_eval.value_id, msg_eval.next);
    let msg_kind = try kinds.get(slice_eval.value_id);
    let slice_kind = code_kind_slice();
    if msg_kind != slice_kind {
        return code_eval_unsupported(slice_eval.next);
    }
    let op_try_io_write = code_op_try_io_write();
    try code.append(op_try_io_write);
    try code.append(io_eval.value_id);
    try code.append(slice_eval.value_id);
    try code.append(stream);
    return code_eval_value(0, slice_eval.next);
}

// emit_code_try_call_void appends the TRY_CALL record for an error-union-void
// callee (the try yields no value).
fn emit_code_try_call_void(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let scratch_base = try args_scratch.get(0);
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, 0, next_value);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    let op_try_call = code_op_try_call();
    try code.append(op_try_call);
    try code.append(callee_span.start);
    try code.append(callee_span.end);
    try code.append(args.len);
    let arg_count = args.len;
    let scratch_bound = scratch_base + arg_count;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    return code_eval_value(0, args_eval.next);
}

// emit_code_try_call_i64 appends the TRY_CALL_I64 record for an error-union-i64
// callee; the try yields the extracted i64 success value as the result.
fn emit_code_try_call_i64(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let scratch_base = try args_scratch.get(0);
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, 0, next_value);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    let op_try_call_i64 = code_op_try_call_i64();
    try code.append(op_try_call_i64);
    try code.append(args_eval.next);
    try code.append(callee_span.start);
    try code.append(callee_span.end);
    try code.append(args.len);
    let arg_count = args.len;
    let scratch_bound = scratch_base + arg_count;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let result_value = args_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_print_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if !std::mem::equal_bytes(callee_text, "print") {
        return code_eval_unsupported(next_value);
    }
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let kind = try kinds.get(eval.value_id);
    // A record-backed value prints only when its record is an ENUM_CONST (the
    // renderer writes the qualified variant name from the record's span); a
    // struct value has no printable SSA temp, so 'print(<struct>)' stays an
    // explicit unsupported program.
    let record_base = code_kind_struct_base();
    if kind >= record_base {
        return try lower_code_print_record(code, eval.value_id, kind, record_base, eval.next);
    }
    let op_print = code_op_print();
    try code.append(op_print);
    try code.append(eval.value_id);
    try code.append(kind);
    return code_eval_value(eval.value_id, eval.next);
}

// lower_code_print_record keeps 'print(<enum>)' on the tape (the PRINT record
// carries the record kind so the renderer resolves the ENUM_CONST span) and
// rejects every other record-backed value. UNION_CONST stays rejected on
// purpose: the renderer's string-globals walk emits '@.kizu.run.e' globals for
// ENUM_CONST records only, so admitting a union here would reference an
// undefined global (lift both sides together if union printing ever lands).
fn lower_code_print_record(
    code: &var std::array::Array<i64>,
    value_id: i64,
    kind: i64,
    record_base: i64,
    next_value: i64
) -> !CodeEval {
    let record_pos = kind - record_base;
    let record_op = try code.get(record_pos);
    let op_enum_const = code_op_enum_const();
    if record_op != op_enum_const {
        return code_eval_unsupported(next_value);
    }
    let op_print = code_op_print();
    try code.append(op_print);
    try code.append(value_id);
    try code.append(kind);
    return code_eval_value(value_id, next_value);
}

fn lower_code_return(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(value);
    return match node.data {
        Empty => try lower_code_return_void(code, next_value),
        Call(call_node) => try lower_code_return_call(text, ast, decls, value, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => try lower_code_return_value(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
    };
}

fn lower_code_return_void(
    code: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_ret_void = code_op_ret_void();
    try code.append(op_ret_void);
    return code_eval_value(0, next_value);
}

// lower_code_return_call splits a 'return <call>' between the error-union failure
// builtin ('return error("msg")') and an ordinary i64-returning call: 'error' is
// not a declared function, so it never reaches the normal call lowering.
fn lower_code_return_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "error") {
        return try lower_code_return_error(text, ast, args, code, kinds, next_value);
    }
    return try lower_code_return_value(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
}

// lower_code_return_error lowers 'return error("msg")': the message string literal
// lowers to a CONST_STR value (its '@.kizu.run.s<id>' global is rendered with the
// other string globals) and the RET_ERR_FAIL record carries that value id.
fn lower_code_return_error(
    text: []u8,
    ast: std::kizu::ast::Ast,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let arg = try ast.child_at(args, 0);
    let eval = try lower_code_string(text, ast, arg, code, kinds, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let op_ret_err_fail = code_op_ret_err_fail();
    try code.append(op_ret_err_fail);
    try code.append(eval.value_id);
    return code_eval_value(0, eval.next);
}

fn lower_code_return_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    // A return is a function boundary like a call argument: a UNION_CONST value
    // packs into the runtime union aggregate before the terminator records it.
    let stored_eval = try lower_code_arg_slice(text, code, kinds, eval.value_id, eval.next);
    if !stored_eval.ok {
        return code_eval_unsupported(stored_eval.next);
    }
    let op_ret_value = code_op_ret_value();
    try code.append(op_ret_value);
    try code.append(stored_eval.value_id);
    return code_eval_value(stored_eval.value_id, stored_eval.next);
}

// code_local_lookup resolves a name against this function's locals (down to
// locals_base) and returns the bound value id, or -1 when the name is unbound.
// The scan walks backward so the newest binding wins: an inner-scope shadowing
// binding resolves while its block is open, and once scrub_code_locals blanks
// it the outer binding resolves again.
fn code_local_lookup(
    text: []u8,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let last = local_starts.len() - 1;
    return try code_local_lookup_from(text, local_starts, local_ends, local_values, locals_base, last, name_start, name_end);
}

// code_scope_lookup resolves a name against one open scope only (the bindings at
// or above scope_base), backing the same-scope duplicate-let rejection.
fn code_scope_lookup(
    text: []u8,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    scope_base: i64,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let last = local_starts.len() - 1;
    return try code_local_lookup_from(text, local_starts, local_ends, local_values, scope_base, last, name_start, name_end);
}

// code_local_lookup_from walks the locals backward from index down to floor.
fn code_local_lookup_from(
    text: []u8,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    floor: i64,
    index: i64,
    name_start: i64,
    name_end: i64
) -> !i64 {
    if index < floor {
        return 0 - 1;
    }
    let bound_start = try local_starts.get(index);
    let bound_end = try local_ends.get(index);
    let bound_name = text[bound_start..bound_end];
    let name = text[name_start..name_end];
    let before = index - 1;
    if !std::mem::equal_bytes(bound_name, name) {
        return try code_local_lookup_from(text, local_starts, local_ends, local_values, floor, before, name_start, name_end);
    }
    let bound_value = try local_values.get(index);
    return bound_value;
}

fn lower_code_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(node_id);
    return match node.data {
        Int(int_node) => try lower_code_int(text, ast, node_id, code, kinds, next_value),
        String(string_node) => try lower_code_string(text, ast, node_id, code, kinds, next_value),
        Bool(bool_node) => try lower_code_bool(text, ast, node_id, code, kinds, next_value),
        Var(var_node) => try lower_code_var(text, ast, node_id, code, kinds, local_starts, local_ends, local_values, locals_base, next_value),
        Prefix(prefix_node) => try lower_code_prefix(text, ast, decls, prefix_node.op, prefix_node.right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Binary(binary) => try lower_code_binary(text, ast, decls, binary.op, binary.left, binary.right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Call(call_node) => try lower_code_call(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        FieldExpr(field_expr) => try lower_code_field_expr(text, ast, decls, node_id, field_expr.receiver, field_expr.name, field_expr.namespace, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        StructLiteralExpr(struct_lit) => try lower_code_struct_literal(text, ast, decls, struct_lit.fields, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        TryExpr(try_expr) => try lower_code_try_expr(text, ast, decls, try_expr.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        If(if_node) => try lower_code_if_expr(text, ast, decls, if_node.condition, if_node.then_block, if_node.else_block, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        Match(match_node) => try lower_code_match_expr(text, ast, decls, match_node.value, match_node.arms, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_int(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let literal_text = ast_node_text(text, ast, node_id);
    let literal = try parse_int_literal(literal_text);
    let op_const = code_op_const_int();
    try code.append(op_const);
    try code.append(next_value);
    try code.append(literal);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// lower_code_string lowers a string literal (a quoted one-line literal or a
// '\\'-prefixed multiline literal) to a CONST_STR record. The record is
// 'op dst seg_count start1 end1 ... startN endN': each segment is a raw source
// payload span and the renderer joins consecutive segments with one newline byte,
// matching the reference lexer's decoded multiline payload.
fn lower_code_string(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(node_id);
    let span_start = node.span.start;
    let span_end = node.span.end;
    if is_multiline_literal(text, span_start, span_end) {
        return try lower_code_multiline_string(text, span_start, span_end, code, kinds, next_value);
    }
    let payload = string_literal_span(text, ast, node_id);
    if payload.start < 0 {
        return code_eval_unsupported(next_value);
    }
    let op_const_str = code_op_const_str();
    let one_segment = 1;
    try code.append(op_const_str);
    try code.append(next_value);
    try code.append(one_segment);
    try code.append(payload.start);
    try code.append(payload.end);
    let kind_str = code_kind_str();
    try kinds.append(kind_str);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// is_multiline_literal reports whether the literal span starts with the '\\'
// multiline marker (two backslash bytes).
fn is_multiline_literal(text: []u8, start: i64, end: i64) -> bool {
    if end - start < 2 {
        return false;
    }
    let backslash = cast<u8>(92);
    if text[start] != backslash {
        return false;
    }
    return text[start + 1] == backslash;
}

// lower_code_multiline_string lowers a '\\'-prefixed multiline literal: every
// '\\' line contributes one payload span segment to the CONST_STR record.
fn lower_code_multiline_string(
    text: []u8,
    span_start: i64,
    span_end: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let seg_count = multiline_segment_count(text, span_start, span_end);
    if seg_count <= 0 {
        return code_eval_unsupported(next_value);
    }
    let op_const_str = code_op_const_str();
    try code.append(op_const_str);
    try code.append(next_value);
    try code.append(seg_count);
    try append_multiline_segments(text, span_start, span_end, code);
    let kind_str = code_kind_str();
    try kinds.append(kind_str);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// multiline_segment_count walks the literal's '\\' lines and returns how many
// segments it contains, or 0 when the shape or a payload byte is unsupported.
fn multiline_segment_count(text: []u8, span_start: i64, span_end: i64) -> i64 {
    return multiline_count_from(text, span_start, span_end, 0);
}

// multiline_count_from counts the segments from the '\\' marker at marker_pos to
// the end of the literal span (0 on an unsupported payload byte or marker shape).
fn multiline_count_from(
    text: []u8,
    marker_pos: i64,
    span_end: i64,
    count: i64
) -> i64 {
    let seg_start = marker_pos + 2;
    let seg_end = multiline_segment_line_end(text, seg_start, span_end);
    let payload = text[seg_start..seg_end];
    if !is_multiline_payload_supported(payload) {
        return 0;
    }
    let next = multiline_next_segment(text, seg_end, span_end);
    let total = count + 1;
    if next == 0 - 1 {
        return total;
    }
    if next < 0 {
        return 0;
    }
    return multiline_count_from(text, next, span_end, total);
}

// append_multiline_segments appends each segment's payload span (start then end)
// to the CONST_STR record from the '\\' marker at marker_pos, mirroring the
// multiline_count_from walk (which already validated every segment).
fn append_multiline_segments(
    text: []u8,
    marker_pos: i64,
    span_end: i64,
    code: &var std::array::Array<i64>
) -> !void {
    let seg_start = marker_pos + 2;
    let seg_end = multiline_segment_line_end(text, seg_start, span_end);
    try code.append(seg_start);
    try code.append(seg_end);
    let next = multiline_next_segment(text, seg_end, span_end);
    if next < 0 {
        return;
    }
    try append_multiline_segments(text, next, span_end, code);
    return;
}

// multiline_segment_line_end returns the segment's payload end: the next newline
// byte at or after pos inside the literal span, or the span end for the final line.
fn multiline_segment_line_end(text: []u8, pos: i64, span_end: i64) -> i64 {
    if pos >= span_end {
        return span_end;
    }
    let newline = cast<u8>(10);
    if text[pos] == newline {
        return pos;
    }
    let after = pos + 1;
    return multiline_segment_line_end(text, after, span_end);
}

// multiline_next_segment returns the next segment's '\\' position after a line's
// newline, -1 at the clean end of the literal, or -2 on an unexpected byte.
fn multiline_next_segment(text: []u8, line_end: i64, span_end: i64) -> i64 {
    if line_end >= span_end {
        return 0 - 1;
    }
    let after_newline = line_end + 1;
    let pos = skip_multiline_indent(text, after_newline, span_end);
    let marker_end = pos + 1;
    if marker_end >= span_end {
        return 0 - 2;
    }
    let backslash = cast<u8>(92);
    if text[pos] != backslash or text[pos + 1] != backslash {
        return 0 - 2;
    }
    return pos;
}

// skip_multiline_indent returns the first position at or after pos whose byte is
// not the whitespace the lexer skips between a line's newline and the next '\\'.
fn skip_multiline_indent(text: []u8, pos: i64, span_end: i64) -> i64 {
    if pos >= span_end {
        return pos;
    }
    if !is_multiline_indent_byte(text[pos]) {
        return pos;
    }
    let after = pos + 1;
    return skip_multiline_indent(text, after, span_end);
}

// is_multiline_indent_byte reports whether byte is the whitespace the lexer skips
// between a multiline line's newline and the next '\\' marker.
fn is_multiline_indent_byte(byte: u8) -> bool {
    let space = cast<u8>(32);
    let tab = cast<u8>(9);
    let carriage = cast<u8>(13);
    return byte == space or byte == tab or byte == carriage;
}

// is_multiline_payload_supported accepts printable ASCII segment bytes; the quote
// byte is allowed because the CONST_STR renderer escapes it, and the empty payload
// of a blank '\\' line is accepted without iteration.
fn is_multiline_payload_supported(payload: []u8) -> bool {
    var index = 0;
    let min = cast<u8>(32);
    let max = cast<u8>(126);
    while index < std::mem::len(payload) {
        let byte = payload[index];
        if byte < min {
            return false;
        }
        if byte > max {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// lower_code_bool lowers a 'true'/'false' literal to a CONST_BOOL record producing
// an i1 value (kind bool); the literal lands on the tape as 1 or 0.
fn lower_code_bool(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let literal_text = ast_node_text(text, ast, node_id);
    let literal = code_bool_literal(literal_text);
    let op_const_bool = code_op_const_bool();
    try code.append(op_const_bool);
    try code.append(next_value);
    try code.append(literal);
    let kind_bool = code_kind_bool();
    try kinds.append(kind_bool);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// code_bool_literal maps a bool literal's source text to its tape value (1 for
// 'true', 0 otherwise).
fn code_bool_literal(literal_text: []u8) -> i64 {
    if std::mem::equal_bytes(literal_text, "true") {
        return 1;
    }
    return 0;
}

// lower_code_prefix lowers a prefix expression; the tape owns logical not ('!')
// of an i1 operand only (negation and borrows are not owned yet).
fn lower_code_prefix(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    op: std::kizu::ast::PrefixOp,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if op == std::kizu::ast::prefix_not() {
        return try lower_code_not(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

// lower_code_not lowers '!<expr>': the operand lowers to an i1 value and the NOT
// record produces its negation in a fresh value (kind bool).
fn lower_code_not(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let operand_eval = try lower_code_expr(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !operand_eval.ok {
        return code_eval_unsupported(operand_eval.next);
    }
    let operand_kind = try kinds.get(operand_eval.value_id);
    let kind_bool = code_kind_bool();
    if operand_kind != kind_bool {
        return code_eval_unsupported(operand_eval.next);
    }
    let op_not = code_op_not();
    try code.append(op_not);
    try code.append(operand_eval.next);
    try code.append(operand_eval.value_id);
    try kinds.append(kind_bool);
    let result_value = operand_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

fn lower_code_var(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let name_span = code_node_span(text, ast, node_id);
    let bound = try code_local_lookup(text, local_starts, local_ends, local_values, locals_base, name_span.start, name_span.end);
    if bound < 0 {
        return code_eval_unsupported(next_value);
    }
    let base = code_var_slot_base();
    // A var local lives in an alloca slot: emit a VAR_LOAD into a fresh value so
    // each read observes the latest stored value. The slot is computed before the
    // guard (binding the subtraction to a local) and the emission is its own
    // helper, so this guard stays a single-statement 'return try <call>' whose arg
    // is a plain local -- the shape the compiled call-arg lowering models.
    let slot = bound - base;
    if bound >= base {
        return try emit_code_var_load(slot, code, kinds, next_value);
    }
    return code_eval_value(bound, next_value);
}

// lower_code_struct_literal scalarizes a struct literal: every field initializer
// lowers to its own tape value (through the same scratch-stack frames call
// arguments use), then the STRUCT_LIT record stores each field's name span and
// value id. The literal's own value renders nothing -- its kinds entry stores
// the record position so field reads resolve through it.
fn lower_code_struct_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    fields: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let scratch_base = try args_scratch.get(0);
    let fields_eval = try lower_code_struct_fields(text, ast, decls, fields, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, 0, next_value);
    if !fields_eval.ok {
        return code_eval_unsupported(fields_eval.next);
    }
    let record_pos = code.len();
    let op_struct_lit = code_op_struct_lit();
    try code.append(op_struct_lit);
    try code.append(fields_eval.next);
    try code.append(fields.len);
    // The fields walk left [name_start, name_end, value] per field on the
    // scratch frame, so the record copies the frame verbatim.
    let entry_slots = fields.len * 3;
    let scratch_bound = scratch_base + entry_slots;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    let struct_base = code_kind_struct_base();
    let struct_kind = struct_base + record_pos;
    try kinds.append(struct_kind);
    let result_value = fields_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_struct_fields lowers each field initializer into the literal's
// scratch frame: field i owns slots [scratch_base + 3i, scratch_base + 3i + 2]
// holding its name span start, name span end, and lowered value id, mirroring
// the call-argument stack discipline so nested literals and calls keep their
// frames.
fn lower_code_struct_fields(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    fields: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= fields.len {
        return code_eval_value(0, next_value);
    }
    let field = try ast.child_at(fields, index);
    let eval = try lower_code_struct_field_node(text, ast, decls, field, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, index, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let after = index + 1;
    return try lower_code_struct_fields(text, ast, decls, fields, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, after, eval.next);
}

fn lower_code_struct_field_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    field: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(field);
    return match node.data {
        StructFieldInit(init) => try lower_code_struct_field(text, ast, decls, init.name, init.value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, index, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_struct_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    let entry_slots = index * 3;
    let entry_base = scratch_base + entry_slots;
    let name_end_slot = entry_base + 1;
    let value_slot = entry_base + 2;
    let next_free = value_slot + 1;
    try args_scratch.set(0, next_free);
    let eval = try lower_code_expr(text, ast, decls, value, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let name_span = code_node_span(text, ast, name);
    try scratch_put(args_scratch, entry_base, name_span.start);
    try scratch_put(args_scratch, name_end_slot, name_span.end);
    try scratch_put(args_scratch, value_slot, eval.value_id);
    return code_eval_value(eval.value_id, eval.next);
}

// lower_code_field_expr resolves a '.' field read at lowering time: the receiver
// must evaluate to a struct literal value (its kinds entry stores the STRUCT_LIT
// record position) and the read resolves to the field's own value id without
// emitting any record. Nested struct fields chain through the same resolution. A
// namespaced 'Enum::Variant' read lowers to its ENUM_CONST tag instead.
fn lower_code_field_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if namespace {
        return try lower_code_enum_const(text, ast, decls, node_id, receiver, name, code, kinds, next_value);
    }
    let base_eval = try lower_code_expr(text, ast, decls, receiver, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !base_eval.ok {
        return code_eval_unsupported(base_eval.next);
    }
    let base_kind = try kinds.get(base_eval.value_id);
    let struct_base = code_kind_struct_base();
    if base_kind < struct_base {
        return code_eval_unsupported(base_eval.next);
    }
    let record_pos = base_kind - struct_base;
    let record_op = try code.get(record_pos);
    let op_var_struct = code_op_var_struct();
    if record_op == op_var_struct {
        return try lower_code_var_struct_read(text, ast, name, code, kinds, record_pos, base_eval.next);
    }
    let op_struct_lit = code_op_struct_lit();
    if record_op != op_struct_lit {
        return code_eval_unsupported(base_eval.next);
    }
    let count_pos = record_pos + 2;
    let field_count = try code.get(count_pos);
    let name_span = code_node_span(text, ast, name);
    let field_value = try struct_record_field(text, code, record_pos, field_count, name_span.start, name_span.end, 0);
    if field_value < 0 {
        return code_eval_unsupported(base_eval.next);
    }
    return code_eval_value(field_value, base_eval.next);
}

// lower_code_var_struct_read loads a scalarized var-struct field from its slot
// into a fresh value (the slot kind picks the i64 or slice load).
fn lower_code_var_struct_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    record_pos: i64,
    next_value: i64
) -> !CodeEval {
    let name_span = code_node_span(text, ast, name);
    let count_pos = record_pos + 2;
    let field_count = try code.get(count_pos);
    // 'field_entry' (not 'entry') keeps the binding clear of the function's
    // LLVM entry block label in the compiled value namespace.
    let field_entry = try var_struct_field_entry(text, code, record_pos, field_count, name_span.start, name_span.end, 0);
    if field_entry < 0 {
        return code_eval_unsupported(next_value);
    }
    let slot_pos = field_entry + 2;
    let slot = try code.get(slot_pos);
    let kind_pos = field_entry + 3;
    let slot_kind = try code.get(kind_pos);
    let load_op = var_struct_load_op(slot_kind);
    try code.append(load_op);
    try code.append(next_value);
    try code.append(slot);
    try kinds.append(slot_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// var_struct_field_entry walks the VAR_STRUCT record's field entries and returns
// the matching entry's tape position (-1 when the record does not carry it).
fn var_struct_field_entry(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= field_count {
        return 0 - 1;
    }
    let entry_slots = index * 4;
    let entry_pos = record_pos + 3 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let entry_name = text[entry_name_start..entry_name_end];
    let name = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, name) {
        return try var_struct_field_entry(text, code, record_pos, field_count, name_start, name_end, after);
    }
    return entry_pos;
}

// var_struct_load_op / var_struct_store_op pick the slot trio matching a
// scalarized field's slot kind.
fn var_struct_load_op(slot_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if slot_kind == kind_i64 {
        return code_op_var_load();
    }
    return code_op_var_load_slice();
}

fn var_struct_store_op(slot_kind: i64) -> i64 {
    let kind_i64 = code_kind_i64();
    if slot_kind == kind_i64 {
        return code_op_var_store();
    }
    return code_op_var_store_slice();
}

// lower_code_enum_const lowers 'Enum::Variant': the variant resolves to its
// declaration-order tag against the named enum declaration, and the ENUM_CONST
// record keeps the qualified and enum-name source spans so print renders the
// variant name and match arms resolve their patterns.
fn lower_code_enum_const(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let enum_span = code_node_span(text, ast, receiver);
    let variant_span = code_node_span(text, ast, name);
    let tag = try enum_variant_tag_lookup(text, ast, decls, enum_span.start, enum_span.end, variant_span.start, variant_span.end, 0);
    if tag < 0 {
        return try lower_code_union_const_read(text, ast, decls, node_id, enum_span.start, enum_span.end, variant_span.start, variant_span.end, code, kinds, next_value);
    }
    let qual_span = code_node_span(text, ast, node_id);
    let record_pos = code.len();
    let op_enum_const = code_op_enum_const();
    try code.append(op_enum_const);
    try code.append(next_value);
    try code.append(qual_span.start);
    try code.append(qual_span.end);
    try code.append(enum_span.start);
    try code.append(enum_span.end);
    try code.append(tag);
    let record_base = code_kind_struct_base();
    let record_kind = record_base + record_pos;
    try kinds.append(record_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// lower_code_union_const_read lowers a payload-less 'Union::Variant' read (the
// fallback when no enum declaration carries the variant): the UNION_CONST
// record stores -1 as its payload value id.
fn lower_code_union_const_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    union_start: i64,
    union_end: i64,
    var_start: i64,
    var_end: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let tag = try union_variant_tag_lookup(text, ast, decls, union_start, union_end, var_start, var_end, 0);
    if tag < 0 {
        return code_eval_unsupported(next_value);
    }
    let qual_span = code_node_span(text, ast, node_id);
    let no_payload = 0 - 1;
    return try lower_code_union_const(qual_span.start, qual_span.end, union_start, union_end, tag, no_payload, code, kinds, next_value);
}

// enum_variant_tag_lookup scans the top-level declarations for the enum whose
// name matches the receiver span and returns the named variant's
// declaration-order tag (-1 when no declaration carries it).
fn enum_variant_tag_lookup(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    enum_start: i64,
    enum_end: i64,
    var_start: i64,
    var_end: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let tag = try enum_decl_variant_tag(text, ast, child, enum_start, enum_end, var_start, var_end);
    let after = index + 1;
    if tag > 0 - 2 {
        return tag;
    }
    return try enum_variant_tag_lookup(text, ast, decls, enum_start, enum_end, var_start, var_end, after);
}

// enum_decl_variant_tag classifies one declaration against the enum name span:
// -2 = not the named enum (keep scanning), otherwise the variant's tag.
fn enum_decl_variant_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    enum_start: i64,
    enum_end: i64,
    var_start: i64,
    var_end: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        EnumDecl(enum_decl) => try enum_named_variant_tag(text, ast, enum_decl.name, enum_decl.tags, enum_start, enum_end, var_start, var_end),
        _ => code_decl_kind_skip(),
    };
}

fn enum_named_variant_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    tags: std::kizu::ast::ChildRange,
    enum_start: i64,
    enum_end: i64,
    var_start: i64,
    var_end: i64
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let enum_name = text[enum_start..enum_end];
    if !std::mem::equal_bytes(decl_name, enum_name) {
        return 0 - 2;
    }
    return try enum_tags_index(text, ast, tags, var_start, var_end, 0);
}

// enum_tags_index returns the declaration-order index of the named variant in
// the enum's tag list (-1 when the list does not carry it).
fn enum_tags_index(
    text: []u8,
    ast: std::kizu::ast::Ast,
    tags: std::kizu::ast::ChildRange,
    var_start: i64,
    var_end: i64,
    index: i64
) -> !i64 {
    if index >= tags.len {
        return 0 - 1;
    }
    let child = try ast.child_at(tags, index);
    let tag_text = ast_node_text(text, ast, child);
    let variant_name = text[var_start..var_end];
    let after = index + 1;
    if !std::mem::equal_bytes(tag_text, variant_name) {
        return try enum_tags_index(text, ast, tags, var_start, var_end, after);
    }
    return index;
}

// union_variant_tag_lookup mirrors enum_variant_tag_lookup over the union
// declarations: it returns the named variant's declaration-order tag.
fn union_variant_tag_lookup(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    union_start: i64,
    union_end: i64,
    var_start: i64,
    var_end: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let tag = try union_decl_variant_tag(text, ast, child, union_start, union_end, var_start, var_end);
    let after = index + 1;
    if tag > 0 - 2 {
        return tag;
    }
    return try union_variant_tag_lookup(text, ast, decls, union_start, union_end, var_start, var_end, after);
}

// union_decl_variant_tag classifies one declaration against the union name span:
// -2 = not the named union (keep scanning), otherwise the variant's tag.
fn union_decl_variant_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    union_start: i64,
    union_end: i64,
    var_start: i64,
    var_end: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        UnionDecl(union_decl) => try union_named_variant_tag(text, ast, union_decl.name, union_decl.variants, union_start, union_end, var_start, var_end),
        _ => code_decl_kind_skip(),
    };
}

fn union_named_variant_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    variants: std::kizu::ast::ChildRange,
    union_start: i64,
    union_end: i64,
    var_start: i64,
    var_end: i64
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let union_name = text[union_start..union_end];
    if !std::mem::equal_bytes(decl_name, union_name) {
        return 0 - 2;
    }
    return try union_variants_index(text, ast, variants, var_start, var_end, 0);
}

// union_variants_index returns the declaration-order index of the named variant
// in the union's variant list (-1 when the list does not carry it).
fn union_variants_index(
    text: []u8,
    ast: std::kizu::ast::Ast,
    variants: std::kizu::ast::ChildRange,
    var_start: i64,
    var_end: i64,
    index: i64
) -> !i64 {
    if index >= variants.len {
        return 0 - 1;
    }
    let child = try ast.child_at(variants, index);
    let matched = try union_variant_matches(text, ast, child, var_start, var_end);
    let after = index + 1;
    if matched {
        return index;
    }
    return try union_variants_index(text, ast, variants, var_start, var_end, after);
}

fn union_variant_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    var_start: i64,
    var_end: i64
) -> !bool {
    let node = ast.get(child);
    return match node.data {
        UnionVariant(variant) => union_variant_name_matches(text, ast, variant.name, var_start, var_end),
        _ => union_variant_no_match(),
    };
}

fn union_variant_name_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    var_start: i64,
    var_end: i64
) -> bool {
    let variant_text = ast_node_text(text, ast, name);
    let wanted = text[var_start..var_end];
    return std::mem::equal_bytes(variant_text, wanted);
}

fn union_variant_no_match() -> bool {
    return false;
}

// lower_code_union_const emits a UNION_CONST record for the resolved variant tag
// and payload value (-1 for a payload-less variant read).
fn lower_code_union_const(
    qual_start: i64,
    qual_end: i64,
    union_start: i64,
    union_end: i64,
    tag: i64,
    payload_value: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let record_pos = code.len();
    let op_union_const = code_op_union_const();
    try code.append(op_union_const);
    try code.append(next_value);
    try code.append(qual_start);
    try code.append(qual_end);
    try code.append(union_start);
    try code.append(union_end);
    try code.append(tag);
    try code.append(payload_value);
    let record_base = code_kind_struct_base();
    let record_kind = record_base + record_pos;
    try kinds.append(record_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// struct_record_field walks the STRUCT_LIT record's field entries and returns
// the value id bound to the named field (-1 when the record does not carry it).
fn struct_record_field(
    text: []u8,
    code: &var std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= field_count {
        return 0 - 1;
    }
    let entry_slots = index * 3;
    let entry_pos = record_pos + 3 + entry_slots;
    let entry_name_start = try code.get(entry_pos);
    let entry_end_pos = entry_pos + 1;
    let entry_name_end = try code.get(entry_end_pos);
    let entry_name = text[entry_name_start..entry_name_end];
    let name = text[name_start..name_end];
    let after = index + 1;
    if !std::mem::equal_bytes(entry_name, name) {
        return try struct_record_field(text, code, record_pos, field_count, name_start, name_end, after);
    }
    let value_pos = entry_pos + 2;
    let entry_value = try code.get(value_pos);
    return entry_value;
}

// emit_code_var_load appends a VAR_LOAD record reading var slot into a fresh i64
// SSA value (with its parallel kinds entry) and returns that value.
fn emit_code_var_load(
    slot: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    let op_var_load = code_op_var_load();
    try code.append(op_var_load);
    try code.append(next_value);
    try code.append(slot);
    let kind_i64 = code_kind_i64();
    try kinds.append(kind_i64);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

fn lower_code_binary(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    op: std::kizu::ast::BinaryOp,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if op == std::kizu::ast::binary_and() {
        return try lower_code_logical(text, ast, decls, left, right, 0, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    if op == std::kizu::ast::binary_or() {
        return try lower_code_logical(text, ast, decls, left, right, 1, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let kind = code_binary_kind(op);
    if kind == 0 {
        return code_eval_unsupported(next_value);
    }
    let left_eval = try lower_code_expr(text, ast, decls, left, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !left_eval.ok {
        return code_eval_unsupported(left_eval.next);
    }
    let right_eval = try lower_code_expr(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, left_eval.next);
    if !right_eval.ok {
        return code_eval_unsupported(right_eval.next);
    }
    // The BINARY record types both operands as i64 (icmp/arith on '%v' i64
    // temps), so a bool/str/slice operand is not owned by this record. An
    // ENUM_CONST-backed operand passes: its SSA temp is its i64 tag, so enum
    // equality lowers as a plain icmp (the checker owns operator legality).
    let left_kind = try kinds.get(left_eval.value_id);
    let left_i64_like = try code_operand_is_i64_like(code, left_kind);
    if !left_i64_like {
        return code_eval_unsupported(right_eval.next);
    }
    let right_kind = try kinds.get(right_eval.value_id);
    let right_i64_like = try code_operand_is_i64_like(code, right_kind);
    if !right_i64_like {
        return code_eval_unsupported(right_eval.next);
    }
    let op_binary = code_op_binary();
    try code.append(op_binary);
    try code.append(right_eval.next);
    try code.append(kind);
    try code.append(left_eval.value_id);
    try code.append(right_eval.value_id);
    if code_binary_kind_is_comparison(kind) {
        let kind_bool = code_kind_bool();
        try kinds.append(kind_bool);
    } else {
        let kind_i64 = code_kind_i64();
        try kinds.append(kind_i64);
    }
    let result_value = right_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// code_operand_is_i64_like accepts an i64 operand or an ENUM_CONST-backed value
// (whose SSA temp is its i64 tag), so tag comparisons lower as a plain icmp.
fn code_operand_is_i64_like(code: &var std::array::Array<i64>, kind: i64) -> !bool {
    let kind_i64 = code_kind_i64();
    if kind == kind_i64 {
        return true;
    }
    let record_base = code_kind_struct_base();
    if kind < record_base {
        return false;
    }
    let record_pos = kind - record_base;
    let record_op = try code.get(record_pos);
    let op_enum_const = code_op_enum_const();
    return record_op == op_enum_const;
}

// lower_code_logical lowers a short-circuit 'and'/'or' (is_or 0/1): the left
// operand lowers first, SC_BEGIN stores it into the record's i1 slot and branches
// past the right operand when the left already decides the result, the right
// operand records follow, and SC_END stores the right value and loads the slot
// into the result value. Both operands must be i1 (kind bool).
fn lower_code_logical(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    is_or: i64,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let left_eval = try lower_code_expr(text, ast, decls, left, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !left_eval.ok {
        return code_eval_unsupported(left_eval.next);
    }
    let kind_bool = code_kind_bool();
    let left_kind = try kinds.get(left_eval.value_id);
    if left_kind != kind_bool {
        return code_eval_unsupported(left_eval.next);
    }
    let sc_index = code.len();
    let op_sc_begin = code_op_sc_begin();
    try code.append(op_sc_begin);
    try code.append(sc_index);
    try code.append(left_eval.value_id);
    try code.append(is_or);
    let right_eval = try lower_code_expr(text, ast, decls, right, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, left_eval.next);
    if !right_eval.ok {
        return code_eval_unsupported(right_eval.next);
    }
    let right_kind = try kinds.get(right_eval.value_id);
    if right_kind != kind_bool {
        return code_eval_unsupported(right_eval.next);
    }
    let op_sc_end = code_op_sc_end();
    try code.append(op_sc_end);
    try code.append(sc_index);
    try code.append(right_eval.value_id);
    try code.append(right_eval.next);
    try kinds.append(kind_bool);
    let result_value = right_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_call lowers a direct call to a user-declared i64 function: the
// argument expressions lower first (their value ids collect in args_scratch),
// then the CALL record carries the callee name span, the argument count, and
// the argument value ids copied off the scratch tail.
fn lower_code_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "std::io::blocking") {
        return try lower_code_io_blocking(args, code, kinds, next_value);
    }
    // The union-constructor probe resolves the callee against the union
    // declarations without touching the tape; only a resolved constructor
    // commits to the union path, so a failure past this point (an unsupported
    // payload) stays a final unsupported program instead of falling through to
    // the user-call path over a partially written tape.
    let union_tag = try code_callee_union_tag(text, ast, decls, callee);
    if union_tag >= 0 {
        return try lower_code_union_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    let callee_span = code_node_span(text, ast, callee);
    let callee_kind = try code_callee_return_kind(text, ast, decls, code, callee_span.start, callee_span.end, 0);
    let record_base = code_kind_struct_base();
    let is_i64_ret = callee_kind == 1;
    let is_union_ret = callee_kind >= record_base;
    let value_ret = is_i64_ret or is_union_ret;
    if !value_ret {
        return code_eval_unsupported(next_value);
    }
    return try emit_code_user_call(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, callee_kind, next_value);
}

// code_callee_union_tag resolves a call's callee against the union declarations
// without touching the tape (-1 when the callee is not a union constructor), so
// the call dispatch commits to the union path before any lowering side effect.
fn code_callee_union_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try code_callee_union_field_tag(text, ast, decls, field_expr.receiver, field_expr.name, field_expr.namespace),
        _ => code_assign_no_field(),
    };
}

fn code_callee_union_field_tag(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool
) -> !i64 {
    if !namespace {
        return 0 - 1;
    }
    let union_span = code_node_span(text, ast, receiver);
    let variant_span = code_node_span(text, ast, name);
    return try union_variant_tag_lookup(text, ast, decls, union_span.start, union_span.end, variant_span.start, variant_span.end, 0);
}

// lower_code_union_call routes a call whose callee is a namespaced
// 'Union::Variant' path into the UNION_CONST construction.
fn lower_code_union_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(callee);
    return match node.data {
        FieldExpr(field_expr) => try lower_code_union_ctor(text, ast, decls, callee, field_expr.receiver, field_expr.name, field_expr.namespace, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

// lower_code_union_ctor lowers 'Union::Variant(<payload>)': the variant must
// resolve against a union declaration (a miss keeps the tape untouched so the
// caller falls through), the single payload argument lowers to its own value,
// and the UNION_CONST record keeps the spans, tag, and payload value id.
fn lower_code_union_ctor(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if !namespace {
        return code_eval_unsupported(next_value);
    }
    let union_span = code_node_span(text, ast, receiver);
    let variant_span = code_node_span(text, ast, name);
    let tag = try union_variant_tag_lookup(text, ast, decls, union_span.start, union_span.end, variant_span.start, variant_span.end, 0);
    if tag < 0 {
        return code_eval_unsupported(next_value);
    }
    if args.len != 1 {
        return code_eval_unsupported(next_value);
    }
    let payload_arg = try ast.child_at(args, 0);
    let payload_eval = try lower_code_expr(text, ast, decls, payload_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !payload_eval.ok {
        return code_eval_unsupported(payload_eval.next);
    }
    let qual_span = code_node_span(text, ast, callee);
    return try lower_code_union_const(qual_span.start, qual_span.end, union_span.start, union_span.end, tag, payload_eval.value_id, code, kinds, payload_eval.next);
}

// emit_code_user_call lowers the arguments into a fresh scratch frame and appends
// the CALL record for a declared user callee (shared by expression calls and
// statement calls). The frame pops back to its base once the record copies it,
// so a call nested inside another call's argument leaves its caller's frame
// intact. The result value takes a fresh i64 id whether or not it is consumed.
fn emit_code_user_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    result_kind: i64,
    next_value: i64
) -> !CodeEval {
    let callee_span = code_node_span(text, ast, callee);
    let scratch_base = try args_scratch.get(0);
    let args_eval = try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, 0, next_value);
    if !args_eval.ok {
        return code_eval_unsupported(args_eval.next);
    }
    let op_call = code_op_call();
    try code.append(op_call);
    try code.append(args_eval.next);
    try code.append(callee_span.start);
    try code.append(callee_span.end);
    try code.append(args.len);
    let arg_count = args.len;
    let scratch_bound = scratch_base + arg_count;
    try copy_code_args(code, args_scratch, scratch_base, scratch_bound);
    try args_scratch.set(0, scratch_base);
    try kinds.append(result_kind);
    let result_value = args_eval.next;
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_io_blocking lowers a 'std::io::blocking()' call to the IO_BLOCKING
// record producing a '%kizu.owned' io handle value (kind owned).
fn lower_code_io_blocking(
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    next_value: i64
) -> !CodeEval {
    if args.len != 0 {
        return code_eval_unsupported(next_value);
    }
    let op_io_blocking = code_op_io_blocking();
    try code.append(op_io_blocking);
    try code.append(next_value);
    let kind_owned = code_kind_owned();
    try kinds.append(kind_owned);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// lower_code_try_expr lowers a 'try <call>' in expression position (the right-hand
// side of a let): the only error-union-yielding builtin the tape owns is
// std::fs::read_file, whose try yields the read bytes slice.
fn lower_code_try_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    call_expr: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let node = ast.get(call_expr);
    return match node.data {
        Call(call_node) => try lower_code_try_call_expr(text, ast, decls, call_node.callee, call_node.args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value),
        _ => code_eval_unsupported(next_value),
    };
}

fn lower_code_try_call_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::equal_bytes(callee_text, "std::fs::read_file") {
        return try lower_code_try_fs_read(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    // A 'try <callee>(...)' of a declared error-union-i64 function yields the
    // extracted i64 success value.
    let callee_span = code_node_span(text, ast, callee);
    let callee_kind = try code_callee_return_kind(text, ast, decls, code, callee_span.start, callee_span.end, 0);
    if callee_kind == 3 {
        return try emit_code_try_call_i64(text, ast, decls, callee, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    }
    return code_eval_unsupported(next_value);
}

// lower_code_try_fs_read lowers 'try std::fs::read_file(io, path)': the io handle
// and path string lower to value ids first, then TRY_FS_READ records them with a
// fresh result value id (kind slice) for the read bytes.
fn lower_code_try_fs_read(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    next_value: i64
) -> !CodeEval {
    if args.len != 2 {
        return code_eval_unsupported(next_value);
    }
    let io_arg = try ast.child_at(args, 0);
    let io_eval = try lower_code_expr(text, ast, decls, io_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !io_eval.ok {
        return code_eval_unsupported(io_eval.next);
    }
    let path_arg = try ast.child_at(args, 1);
    let path_eval = try lower_code_expr(text, ast, decls, path_arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, io_eval.next);
    if !path_eval.ok {
        return code_eval_unsupported(path_eval.next);
    }
    let op_try_fs_read = code_op_try_fs_read();
    let result_value = path_eval.next;
    try code.append(op_try_fs_read);
    try code.append(result_value);
    try code.append(io_eval.value_id);
    try code.append(path_eval.value_id);
    let kind_slice = code_kind_slice();
    try kinds.append(kind_slice);
    let after_value = result_value + 1;
    return code_eval_value(result_value, after_value);
}

// lower_code_args lowers each call argument into its caller's scratch frame
// [scratch_base, scratch_base + args.len): before an argument lowers, the stack
// pointer (args_scratch slot 0) moves past the argument's reserved slot so any
// nested call inside it allocates its own frame strictly above, and after it
// lowers, scratch_put writes the result id into the reserved slot (overwriting
// whatever a nested frame left there).
fn lower_code_args(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    args: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    local_starts: &var std::array::Array<i64>,
    local_ends: &var std::array::Array<i64>,
    local_values: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    locals_base: i64,
    scratch_base: i64,
    index: i64,
    next_value: i64
) -> !CodeEval {
    if index >= args.len {
        return code_eval_value(0, next_value);
    }
    let arg = try ast.child_at(args, index);
    let arg_slot = scratch_base + index;
    let next_free = arg_slot + 1;
    try args_scratch.set(0, next_free);
    let eval = try lower_code_expr(text, ast, decls, arg, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, next_value);
    if !eval.ok {
        return code_eval_unsupported(eval.next);
    }
    let arg_eval = try lower_code_arg_slice(text, code, kinds, eval.value_id, eval.next);
    try scratch_put(args_scratch, arg_slot, arg_eval.value_id);
    let after = index + 1;
    return try lower_code_args(text, ast, decls, args, code, kinds, local_starts, local_ends, local_values, args_scratch, locals_base, scratch_base, after, arg_eval.next);
}

// lower_code_arg_slice materializes a string argument (kind str, a CONST_STR
// global) as a runtime slice value through a STR_SLICE record, so a user call
// passes every argument as a typed SSA value. Arguments of any other kind pass
// through unchanged.
fn lower_code_arg_slice(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    value_id: i64,
    next_value: i64
) -> !CodeEval {
    // 'arg_kind' (not 'kind') keeps the binding clear of the '<name>_slice' temp
    // names the compiled Array.get lowering derives from it.
    let arg_kind = try kinds.get(value_id);
    let kind_str = code_kind_str();
    let record_base = code_kind_struct_base();
    if arg_kind >= record_base {
        return try lower_code_arg_record(text, code, kinds, value_id, arg_kind, next_value);
    }
    if arg_kind != kind_str {
        return code_eval_value(value_id, next_value);
    }
    let op_str_slice = code_op_str_slice();
    try code.append(op_str_slice);
    try code.append(next_value);
    try code.append(value_id);
    let slice_kind = code_kind_slice();
    try kinds.append(slice_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// lower_code_arg_record converts a record-backed value at a boundary: a
// UNION_CONST packs into the runtime union aggregate (the UNION_DECL resolved
// through the record's union name span); any other record-backed value passes
// through unchanged.
fn lower_code_arg_record(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    value_id: i64,
    arg_kind: i64,
    next_value: i64
) -> !CodeEval {
    let record_base = code_kind_struct_base();
    let record_pos = arg_kind - record_base;
    let op = try code.get(record_pos);
    let op_union_const = code_op_union_const();
    if op != op_union_const {
        return code_eval_value(value_id, next_value);
    }
    let union_start_pos = record_pos + 4;
    let union_start = try code.get(union_start_pos);
    let union_end_pos = record_pos + 5;
    let union_end = try code.get(union_end_pos);
    let decl_pos = try union_decl_pos_by_span(text, code, union_start, union_end, 0);
    if decl_pos < 0 {
        return code_eval_unsupported(next_value);
    }
    let payload_pos = record_pos + 7;
    let raw_payload = try code.get(payload_pos);
    let payload_eval = try lower_code_union_arg_payload(text, code, kinds, raw_payload, next_value);
    if !payload_eval.ok {
        return code_eval_unsupported(payload_eval.next);
    }
    return try lower_code_union_pack(code, kinds, value_id, payload_eval.value_id, decl_pos, payload_eval.next);
}

// lower_code_union_arg_payload materializes a UNION_CONST's payload for the
// pack: a str payload converts to its slice; a missing payload (-1) passes
// through so the pack records the payload-less shape.
fn lower_code_union_arg_payload(
    text: []u8,
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    payload_value: i64,
    next_value: i64
) -> !CodeEval {
    if payload_value < 0 {
        return code_eval_value(payload_value, next_value);
    }
    return try lower_code_arg_slice(text, code, kinds, payload_value, next_value);
}

// lower_code_union_pack appends the UNION_PACK record building a runtime union
// value from its tag value (the UNION_CONST dst renders as the i64 tag) and
// payload; the dst's kind references the union's UNION_DECL record.
fn lower_code_union_pack(
    code: &var std::array::Array<i64>,
    kinds: &var std::array::Array<i64>,
    tag_value: i64,
    payload_value: i64,
    decl_pos: i64,
    next_value: i64
) -> !CodeEval {
    let payload_kind = try union_pack_payload_kind(kinds, payload_value);
    let op_union_pack = code_op_union_pack();
    try code.append(op_union_pack);
    try code.append(next_value);
    try code.append(tag_value);
    try code.append(payload_value);
    try code.append(payload_kind);
    let record_base = code_kind_struct_base();
    let union_kind = record_base + decl_pos;
    try kinds.append(union_kind);
    let after_value = next_value + 1;
    return code_eval_value(next_value, after_value);
}

// union_pack_payload_kind reads the packed payload's value kind (0 marks the
// payload-less shape).
fn union_pack_payload_kind(
    kinds: &var std::array::Array<i64>,
    payload_value: i64
) -> !i64 {
    if payload_value < 0 {
        return 0;
    }
    let payload_kind = try kinds.get(payload_value);
    return payload_kind;
}

// scratch_put stores value into stack slot pos, growing the array first when a
// reserved slot has not been written yet (a slot is written only after its
// argument lowers, so the array may still be shorter than pos).
fn scratch_put(
    args_scratch: &var std::array::Array<i64>,
    pos: i64,
    value: i64
) -> !void {
    try scratch_grow(args_scratch, pos);
    try args_scratch.set(pos, value);
    return;
}

// scratch_grow appends zero slots until the stack array covers slot pos.
fn scratch_grow(
    args_scratch: &var std::array::Array<i64>,
    pos: i64
) -> !void {
    let used = args_scratch.len();
    if used > pos {
        return;
    }
    try args_scratch.append(0);
    try scratch_grow(args_scratch, pos);
    return;
}

// copy_code_args copies one call's scratch frame [index, bound) onto the tape.
fn copy_code_args(
    code: &var std::array::Array<i64>,
    args_scratch: &var std::array::Array<i64>,
    index: i64,
    bound: i64
) -> !void {
    if index >= bound {
        return;
    }
    let value = try args_scratch.get(index);
    try code.append(value);
    let after = index + 1;
    try copy_code_args(code, args_scratch, after, bound);
    return;
}

// code_callee_return_kind scans the top-level declarations for the function
// whose name matches the callee span and classifies its declared return type.
fn code_callee_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64,
    index: i64
) -> !i64 {
    if index >= decls.len {
        return 0 - 1;
    }
    let child = try ast.child_at(decls, index);
    let kind = try code_decl_return_kind(text, ast, child, code, name_start, name_end);
    let after = index + 1;
    if kind > 0 - 2 {
        return kind;
    }
    return try code_callee_return_kind(text, ast, decls, code, name_start, name_end, after);
}

// code_decl_return_kind classifies one declaration against the callee name span:
// -2 = not the named function (keep scanning), otherwise its return kind.
fn code_decl_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let node = ast.get(child);
    return match node.data {
        FnDecl(fn_decl) => try code_fn_decl_return_kind(text, ast, fn_decl.name, fn_decl.return_type, code, name_start, name_end),
        _ => code_decl_kind_skip(),
    };
}

fn code_decl_kind_skip() -> i64 {
    return 0 - 2;
}

// code_fn_decl_return_kind classifies one declaration against the callee name:
// -2 = the names differ (keep scanning), otherwise the declaration's return
// kind through code_return_kind.
fn code_fn_decl_return_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    code: &var std::array::Array<i64>,
    name_start: i64,
    name_end: i64
) -> !i64 {
    let decl_name = ast_node_text(text, ast, name);
    let callee_name = text[name_start..name_end];
    if !std::mem::equal_bytes(decl_name, callee_name) {
        return 0 - 2;
    }
    let ret_kind = try code_return_kind(text, ast, return_type, code);
    return ret_kind;
}
