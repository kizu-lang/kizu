        i64_call_callee: try_callee,
        i64_call_arg0: helper_exit_code,
        i64_call_arg1: 0,
        loop_start_value: 0,
        loop_bound: 0,
        loop_continue_value: 0,
        loop_break_value: 0
    };
}

fn unsupported_run_ast(empty: []u8) -> RunAst {
