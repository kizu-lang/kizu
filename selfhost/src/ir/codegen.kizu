pub enum ValueKind {
    None,
    ConstString,
}

pub struct Value {
    pub kind: ValueKind,
    pub name: []u8,
    pub string_payload: []u8,
}

pub enum InstructionKind {
    None,
    ConstString,
    Call,
    ReturnVoid,
}

pub struct Instruction {
    pub kind: InstructionKind,
    pub result_kind: ValueKind,
    pub result_name: []u8,
    pub result_payload: []u8,
    pub callee: []u8,
    pub argument_kind: ValueKind,
    pub argument_name: []u8,
    pub argument_payload: []u8,
}

pub struct CodegenBlock {
    pub label: []u8,
    pub instruction_count: i64,
}

pub struct CodegenFunction {
    pub name: []u8,
    pub block_count: i64,
}

pub struct Program {
    pub function_count: i64,
    pub function_name: []u8,
    pub block_count: i64,
    pub block_label: []u8,
    pub instruction_count: i64,
    pub first_kind: InstructionKind,
    pub first_result_kind: ValueKind,
    pub first_result_name: []u8,
    pub first_result_payload: []u8,
    pub second_kind: InstructionKind,
    pub second_callee: []u8,
    pub second_argument_kind: ValueKind,
    pub second_argument_name: []u8,
    pub second_argument_payload: []u8,
    pub third_kind: InstructionKind,
    pub from_codegen_lowering: bool,
}

pub enum RunStatementKind {
    None,
    Print,
}

pub enum RunArgumentKind {
    None,
    ConstString,
}

pub struct RunAst {
    pub ok: bool,
    pub function_count: i64,
    pub function_name: []u8,
    pub block_count: i64,
    pub statement_count: i64,
    pub final_statement_kind: RunStatementKind,
    pub final_callee: []u8,
    pub final_argument_kind: RunArgumentKind,
    pub final_argument_payload: []u8,
}

pub fn main_print_program(payload: []u8) -> Program {
    return build_main_print_program(payload, false);
}

fn lowered_main_print_program(payload: []u8) -> Program {
    return build_main_print_program(payload, true);
}

fn build_main_print_program(payload: []u8, from_codegen_lowering: bool) -> Program {
    let function = CodegenFunction {
        name: "main",
        block_count: 1
    };
    let block = CodegenBlock {
        label: "entry",
        instruction_count: 3
    };
    let value = const_string_value("s0", payload);
    let first = const_string_instruction(value);
    let argument = const_string_value("s0", payload);
    let second = call_instruction("print", argument);
    let third = return_void_instruction();
    return Program {
        function_count: 1,
        function_name: function.name,
        block_count: function.block_count,
        block_label: block.label,
        instruction_count: block.instruction_count,
        first_kind: first.kind,
        first_result_kind: first.result_kind,
        first_result_name: first.result_name,
        first_result_payload: first.result_payload,
        second_kind: second.kind,
        second_callee: second.callee,
        second_argument_kind: second.argument_kind,
        second_argument_name: second.argument_name,
        second_argument_payload: second.argument_payload,
        third_kind: third.kind,
        from_codegen_lowering: from_codegen_lowering
    };
}

pub fn unsupported_program(empty: []u8) -> Program {
    return Program {
        function_count: 0,
        function_name: empty[0..0],
        block_count: 0,
        block_label: empty[0..0],
        instruction_count: 0,
        first_kind: InstructionKind::None,
        first_result_kind: ValueKind::None,
        first_result_name: empty[0..0],
        first_result_payload: empty[0..0],
        second_kind: InstructionKind::None,
        second_callee: empty[0..0],
        second_argument_kind: ValueKind::None,
        second_argument_name: empty[0..0],
        second_argument_payload: empty[0..0],
        third_kind: InstructionKind::None,
        from_codegen_lowering: false
    };
}

pub fn program_supported(program: &Program) -> bool {
    return main_print_payload(program).kind == ValueKind::ConstString;
}

pub fn lowered_program_supported(program: &Program) -> bool {
    return program_supported(program) and program.from_codegen_lowering;
}

pub fn require_main_print(program: &Program) -> !void {
    let payload = main_print_payload(program);
    if payload.kind != ValueKind::ConstString {
        return error("unsupported codegen program");
    }
    if !std::mem::equal_bytes(program.function_name, "main") {
        return error("unsupported codegen function");
    }
    return;
}

pub fn require_lowered_main_print(program: &Program) -> !void {
    try require_main_print(program);
    if !program.from_codegen_lowering {
        return error("codegen program was not produced by checked AST lowering");
    }
    return;
}

pub fn stdout_payload(program: &Program) -> ![]u8 {
    let payload = main_print_payload(program);
    if payload.kind != ValueKind::ConstString {
        return error("unsupported codegen stdout payload");
    }
    return payload.string_payload;
}

pub fn metadata_for_program(program: &Program) -> []u8 {
    if program.from_codegen_lowering {
        return metadata_line();
    }
    return "none";
}

fn main_print_payload(program: &Program) -> Value {
    if program.function_count != 1 or program.block_count != 1 {
        return none_value(program.function_name);
    }
    if !std::mem::equal_bytes(program.block_label, "entry") {
        return none_value(program.function_name);
    }
    if program.instruction_count != 3 {
        return none_value(program.function_name);
    }
    if program.first_kind != InstructionKind::ConstString {
        return none_value(program.function_name);
    }
    if program.second_kind != InstructionKind::Call or !std::mem::equal_bytes(program.second_callee, "print") {
        return none_value(program.function_name);
    }
    if program.third_kind != InstructionKind::ReturnVoid {
        return none_value(program.function_name);
    }
    if program.first_result_kind != ValueKind::ConstString or program.second_argument_kind != ValueKind::ConstString {
        return none_value(program.function_name);
    }
    if !std::mem::equal_bytes(program.first_result_name, program.second_argument_name) {
        return none_value(program.function_name);
    }
    return const_string_value(program.first_result_name, program.first_result_payload);
}

fn const_string_value(name: []u8, payload: []u8) -> Value {
    return Value {
        kind: ValueKind::ConstString,
        name: name,
        string_payload: payload
    };
}

fn none_value(empty: []u8) -> Value {
    return Value {
        kind: ValueKind::None,
        name: empty[0..0],
        string_payload: empty[0..0]
    };
}

fn const_string_instruction(value: Value) -> Instruction {
    return Instruction {
        kind: InstructionKind::ConstString,
        result_kind: value.kind,
        result_name: value.name,
        result_payload: value.string_payload,
        callee: "",
        argument_kind: ValueKind::None,
        argument_name: value.name[0..0],
        argument_payload: value.string_payload[0..0]
    };
}

fn call_instruction(callee: []u8, argument: Value) -> Instruction {
    return Instruction {
        kind: InstructionKind::Call,
        result_kind: ValueKind::None,
        result_name: callee[0..0],
        result_payload: callee[0..0],
        callee: callee,
        argument_kind: argument.kind,
        argument_name: argument.name,
        argument_payload: argument.string_payload
    };
}

fn return_void_instruction() -> Instruction {
    return Instruction {
        kind: InstructionKind::ReturnVoid,
        result_kind: ValueKind::None,
        result_name: "",
        result_payload: "",
        callee: "",
        argument_kind: ValueKind::None,
        argument_name: "",
        argument_payload: ""
    };
}

pub fn lower_run_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !Program {
    let run_ast = try lower_run_ast(text, ast, root);
    return lower_run_ast_to_program(text, &run_ast);
}

pub fn lower_run_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !RunAst {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_run_ast_declarations(text, ast, program.declarations),
        _ => unsupported_run_ast(text[0..0]),
    };
}

fn lower_run_ast_declarations(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !RunAst {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let run_ast = match node.data {
            FnDecl(fn_decl) => try lower_run_ast_function(text, ast, fn_decl.name, fn_decl.body),
            _ => unsupported_run_ast(text[0..0]),
        };
        if run_ast_supported(&run_ast) {
            return run_ast;
        }
        index = index + 1;
    }
    return unsupported_run_ast(text[0..0]);
}

fn lower_run_ast_function(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !RunAst {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "main") {
        return unsupported_run_ast(text[0..0]);
    }

    let node = ast.get(body);
    return match node.data {
        Block(block) => try lower_run_ast_block(text, ast, ast_node_text(text, ast, name), block.statements),
        _ => unsupported_run_ast(text[0..0]),
    };
}

struct LocalBinding {
    name: []u8,
    payload_start: i64,
    payload_end: i64,
}

struct LocalTable {
    count: i64,
    first: LocalBinding,
    second: LocalBinding,
}

fn lower_run_ast_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statements: std::kizu::ast::ChildRange
) -> !RunAst {
    var locals = empty_local_table(text);
    var index = 0;
    while index < statements.len {
        let statement = try ast.child_at(statements, index);
        let node = ast.get(statement);
        let terminal = index + 1 == statements.len;
        if !terminal {
            let binding = match node.data {
                Let(let_node) => lower_let_binding(text, ast, &locals, let_node.name, let_node.value),
                _ => empty_local(text),
            };
            if std::mem::len(binding.name) == 0 {
                return unsupported_run_ast(text[0..0]);
            }
            locals = insert_local(text, &locals, &binding);
            index = index + 1;
        } else {
            return match node.data {
                ExprStmt(expr_stmt) => try lower_print_statement(
                    text,
                    ast,
                    function_name,
                    statements.len,
                    &locals,
                    expr_stmt.expr
                ),
                _ => unsupported_run_ast(text[0..0]),
            };
        }
    }
    return unsupported_run_ast(text[0..0]);
}

fn lower_let_binding(
    text: []u8,
    ast: std::kizu::ast::Ast,
    locals: &LocalTable,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> LocalBinding {
    let local_name = ast_node_text(text, ast, name);
    if local_table_contains(locals, local_name) or locals.count >= 2 {
        return empty_local(text);
    }
    let payload = string_literal_span(text, ast, value);
    if payload.start < 0 {
        return empty_local(text);
    }
    return LocalBinding {
        name: local_name,
        payload_start: payload.start,
        payload_end: payload.end
    };
}

fn lower_print_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statement_count: i64,
    locals: &LocalTable,
    expr: std::kizu::ast::NodeId
) -> !RunAst {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_print_call(
            text,
            ast,
            function_name,
            statement_count,
            locals,
            call_node.callee,
            call_node.args
        ),
        _ => unsupported_run_ast(text[0..0]),
    };
}

fn lower_print_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    statement_count: i64,
    locals: &LocalTable,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !RunAst {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return unsupported_run_ast(text[0..0]);
    }
    let arg = try ast.child_at(args, 0);
    let payload = print_payload(text, ast, locals, arg);
    if payload.start < 0 {
        return unsupported_run_ast(text[0..0]);
    }
    let payload_text = text[payload.start..payload.end];
    if std::mem::len(payload_text) == 0 {
        return unsupported_run_ast(text[0..0]);
    }
    return print_run_ast(function_name, statement_count, ast_node_text(text, ast, callee), payload_text);
}

fn lower_run_ast_to_program(text: []u8, run_ast: &RunAst) -> Program {
    if !run_ast_supported(run_ast) {
        return unsupported_program(text[0..0]);
    }
    return lowered_main_print_program(run_ast.final_argument_payload);
}

fn run_ast_supported(run_ast: &RunAst) -> bool {
    if !run_ast.ok {
        return false;
    }
    if run_ast.function_count != 1 or run_ast.block_count != 1 {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.function_name, "main") {
        return false;
    }
    if run_ast.statement_count < 1 {
        return false;
    }
    if run_ast.final_statement_kind != RunStatementKind::Print {
        return false;
    }
    if !std::mem::equal_bytes(run_ast.final_callee, "print") {
        return false;
    }
    return run_ast.final_argument_kind == RunArgumentKind::ConstString;
}

fn print_run_ast(
    function_name: []u8,
    statement_count: i64,
    callee: []u8,
    payload: []u8
) -> RunAst {
    return RunAst {
        ok: true,
        function_count: 1,
        function_name: function_name,
        block_count: 1,
        statement_count: statement_count,
        final_statement_kind: RunStatementKind::Print,
        final_callee: callee,
        final_argument_kind: RunArgumentKind::ConstString,
        final_argument_payload: payload
    };
}

fn unsupported_run_ast(empty: []u8) -> RunAst {
    return RunAst {
        ok: false,
        function_count: 0,
        function_name: empty[0..0],
        block_count: 0,
        statement_count: 0,
        final_statement_kind: RunStatementKind::None,
        final_callee: empty[0..0],
        final_argument_kind: RunArgumentKind::None,
        final_argument_payload: empty[0..0]
    };
}

struct PayloadSpan {
    start: i64,
    end: i64,
}

fn print_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    locals: &LocalTable,
    arg: std::kizu::ast::NodeId
) -> PayloadSpan {
    let node = ast.get(arg);
    return match node.data {
        String(string_node) => string_literal_span(text, ast, arg),
        Var(var_node) => local_payload_span(locals, ast_node_text(text, ast, arg)),
        _ => empty_payload_span(),
    };
}

fn string_literal_span(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> PayloadSpan {
    let node = ast.get(node_id);
    let span = &node.span;
    let literal = text[span.start..span.end];
    let length = span.end - span.start;
    if length < 2 {
        return empty_payload_span();
    }
    let quote = cast<u8>(34);
    if literal[0] != quote or literal[length - 1] != quote {
        return empty_payload_span();
    }
    let payload_start = span.start + 1;
    let payload_end = span.end - 1;
    let payload = text[payload_start..payload_end];
    if !is_payload_supported(payload) {
        return empty_payload_span();
    }
    return PayloadSpan {
        start: payload_start,
        end: payload_end
    };
}

fn empty_payload_span() -> PayloadSpan {
    return PayloadSpan {
        start: -1,
        end: -1
    };
}

fn is_payload_supported(payload: []u8) -> bool {
    var index = 0;
    let min = cast<u8>(32);
    let max = cast<u8>(126);
    let quote = cast<u8>(34);
    while index < std::mem::len(payload) {
        let byte = payload[index];
        if byte < min or byte > max or byte == quote {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn empty_local_table(text: []u8) -> LocalTable {
    return LocalTable {
        count: 0,
        first: empty_local(text),
        second: empty_local(text)
    };
}

fn empty_local(text: []u8) -> LocalBinding {
    return LocalBinding {
        name: text[0..0],
        payload_start: -1,
        payload_end: -1
    };
}

fn insert_local(text: []u8, locals: &LocalTable, binding: &LocalBinding) -> LocalTable {
    if locals.count == 0 {
        return LocalTable {
            count: 1,
            first: LocalBinding {
                name: binding.name,
                payload_start: binding.payload_start,
                payload_end: binding.payload_end
            },
            second: empty_local(text)
        };
    }
    return LocalTable {
        count: 2,
        first: LocalBinding {
            name: locals.first.name,
            payload_start: locals.first.payload_start,
            payload_end: locals.first.payload_end
        },
        second: LocalBinding {
            name: binding.name,
            payload_start: binding.payload_start,
            payload_end: binding.payload_end
        }
    };
}

fn local_table_contains(locals: &LocalTable, name: []u8) -> bool {
    if locals.count >= 1 and std::mem::equal_bytes(locals.first.name, name) {
        return true;
    }
    if locals.count >= 2 and std::mem::equal_bytes(locals.second.name, name) {
        return true;
    }
    return false;
}

fn local_payload_span(locals: &LocalTable, name: []u8) -> PayloadSpan {
    if locals.count >= 1 and std::mem::equal_bytes(locals.first.name, name) {
        return PayloadSpan {
            start: locals.first.payload_start,
            end: locals.first.payload_end
        };
    }
    if locals.count >= 2 and std::mem::equal_bytes(locals.second.name, name) {
        return PayloadSpan {
            start: locals.second.payload_start,
            end: locals.second.payload_end
        };
    }
    return empty_payload_span();
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}

pub fn metadata_line() -> []u8 {
    return "selfhost::ir::codegen::Program function-block-instruction-v0";
}

// lower_run_int_program lowers a bounded constant subset of main to the existing
// const-string program shape by evaluating the program at compile time over the
// checked AST: integer let locals, integer arithmetic (add/sub/mul/div),
// boolean/comparison conditions, and if/else selection, terminating in a single
// print of a string literal or an integer expression. The computed payload
// (decimal text for integers) is rendered into the caller-owned scratch buffer.
// Non-matching programs return an unsupported program so the caller falls back to
// the string-print run path.
//
// These functions are intentionally excluded from the IR artifact's selected
// body-fact set: the stage2 self-compilation path reproduces only the bounded
// const-string run shape, so threading a scratch String through the selected
// lowering functions would emit signatures the fact pipeline cannot model. Keeping
// the constant-evaluation path here lets the interpreter and the from-source
// native compiler run it while the stage2 program shape stays unchanged.
pub fn lower_run_int_program(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !Program {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try lower_int_declarations(scratch, text, ast, program.declarations),
        _ => unsupported_program(text[0..0]),
    };
}

fn lower_int_declarations(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !Program {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let program = match node.data {
            FnDecl(fn_decl) => try lower_int_function(scratch, text, ast, declarations, fn_decl.name, fn_decl.body),
            _ => unsupported_program(text[0..0]),
        };
        if program_supported(&program) {
            return program;
        }
        index = index + 1;
    }
    return unsupported_program(text[0..0]);
}

fn lower_int_function(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    decls: std::kizu::ast::ChildRange,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !Program {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "main") {
        return unsupported_program(text[0..0]);
    }
    let node = ast.get(body);
    return match node.data {
        Block(block) => try lower_const_block(scratch, text, ast, block.statements, empty_int_env(text, decls)),
        _ => unsupported_program(text[0..0]),
    };
}

// lower_const_block evaluates a block at compile time: leading integer let
// bindings extend the environment, and the terminal statement is either a print
// (producing the program payload) or an if/else whose taken branch block is
// evaluated with the same environment.
fn lower_const_block(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    env: IntEnv
) -> !Program {
    var current = env;
    var index = 0;
    while index < statements.len {
        let statement = try ast.child_at(statements, index);
        let node = ast.get(statement);
        let terminal = index + 1 == statements.len;
        if terminal {
            return match node.data {
                ExprStmt(expr_stmt) => try lower_const_print_statement(scratch, text, ast, expr_stmt.expr, &current),
                If(if_node) => try lower_const_if(scratch, text, ast, if_node.condition, if_node.then_block, if_node.else_block, &current),
                _ => unsupported_program(text[0..0]),
            };
        }
        let next = match node.data {
            Let(let_node) => try extend_int_env(text, ast, &current, let_node.name, let_node.value),
            _ => overflow_from(&current),
        };
        if next.count < 0 {
            return unsupported_program(text[0..0]);
        }
        current = next;
        index = index + 1;
    }
    return unsupported_program(text[0..0]);
}

fn lower_const_if(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !Program {
    let taken = try eval_bool_expr(text, ast, condition, env);
    var block = else_block;
    if taken {
        block = then_block;
    }
    let node = ast.get(block);
    return match node.data {
        Block(inner) => try lower_const_block(scratch, text, ast, inner.statements, copy_int_env(env)),
        _ => unsupported_program(text[0..0]),
    };
}

fn lower_const_print_statement(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !Program {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try lower_const_print_call(scratch, text, ast, call_node.callee, call_node.args, env),
        _ => unsupported_program(text[0..0]),
    };
}

fn lower_const_print_call(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    env: &IntEnv
) -> !Program {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return unsupported_program(text[0..0]);
    }
    let arg = try ast.child_at(args, 0);
    let arg_node = ast.get(arg);
    return match arg_node.data {
        String(string_node) => lower_const_string_print(text, ast, arg),
        Int(int_node) => try lower_const_int_print(scratch, text, ast, arg, env),
        Binary(binary) => try lower_const_int_print(scratch, text, ast, arg, env),
        Call(call_node) => try lower_const_int_print(scratch, text, ast, arg, env),
        _ => unsupported_program(text[0..0]),
    };
}

fn lower_const_string_print(
    text: []u8,
    ast: std::kizu::ast::Ast,
    arg: std::kizu::ast::NodeId
) -> Program {
    let payload = string_literal_span(text, ast, arg);
    if payload.start < 0 {
        return unsupported_program(text[0..0]);
    }
    let payload_text = text[payload.start..payload.end];
    if std::mem::len(payload_text) == 0 {
        return unsupported_program(text[0..0]);
    }
    return lowered_main_print_program(payload_text);
}

fn lower_const_int_print(
    scratch: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    arg: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !Program {
    let value = try eval_int_expr(text, ast, arg, env);
    let start = scratch.len();
    try std::fmt::append_i64(scratch, value);
    let end = scratch.len();
    let decimal = scratch.as_bytes();
    let payload_text = decimal[start..end];
    if std::mem::len(payload_text) == 0 {
        return unsupported_program(text[0..0]);
    }
    return lowered_main_print_program(payload_text);
}

// IntEnv is a bounded compile-time environment of integer locals plus the
// program's top-level declarations (so calls can resolve user functions). A
// negative count marks an environment that overflowed the supported slot budget.
struct IntEnv {
    count: i64,
    decls: std::kizu::ast::ChildRange,
    name0: []u8,
    value0: i64,
    name1: []u8,
    value1: i64,
    name2: []u8,
    value2: i64,
}

fn copy_int_env(env: &IntEnv) -> IntEnv {
    return IntEnv {
        count: env.count,
        decls: env.decls,
        name0: env.name0,
        value0: env.value0,
        name1: env.name1,
        value1: env.value1,
        name2: env.name2,
        value2: env.value2
    };
}

fn empty_int_env(text: []u8, decls: std::kizu::ast::ChildRange) -> IntEnv {
    return IntEnv {
        count: 0,
        decls: decls,
        name0: text[0..0],
        value0: 0,
        name1: text[0..0],
        value1: 0,
        name2: text[0..0],
        value2: 0
    };
}

fn overflow_from(env: &IntEnv) -> IntEnv {
    return IntEnv {
        count: -1,
        decls: env.decls,
        name0: env.name0,
        value0: env.value0,
        name1: env.name1,
        value1: env.value1,
        name2: env.name2,
        value2: env.value2
    };
}

fn int_env_put(env: &IntEnv, name: []u8, value: i64) -> IntEnv {
    if env.count == 0 {
        return IntEnv {
            count: 1,
            decls: env.decls,
            name0: name,
            value0: value,
            name1: env.name1,
            value1: env.value1,
            name2: env.name2,
            value2: env.value2
        };
    }
    if env.count == 1 {
        return IntEnv {
            count: 2,
            decls: env.decls,
            name0: env.name0,
            value0: env.value0,
            name1: name,
            value1: value,
            name2: env.name2,
            value2: env.value2
        };
    }
    if env.count == 2 {
        return IntEnv {
            count: 3,
            decls: env.decls,
            name0: env.name0,
            value0: env.value0,
            name1: env.name1,
            value1: env.value1,
            name2: name,
            value2: value
        };
    }
    return overflow_from(env);
}

fn extend_int_env(
    text: []u8,
    ast: std::kizu::ast::Ast,
    env: &IntEnv,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> !IntEnv {
    let local_name = ast_node_text(text, ast, name);
    let local_value = try eval_int_expr(text, ast, value, env);
    return int_env_put(env, local_name, local_value);
}

fn int_env_value(env: &IntEnv, name: []u8) -> !i64 {
    if env.count >= 1 and std::mem::equal_bytes(env.name0, name) {
        return env.value0;
    }
    if env.count >= 2 and std::mem::equal_bytes(env.name1, name) {
        return env.value1;
    }
    if env.count >= 3 and std::mem::equal_bytes(env.name2, name) {
        return env.value2;
    }
    return error("unknown integer local in run codegen");
}

// eval_int_expr evaluates an integer literal, local reference, arithmetic
// expression, or direct call to a user function to a constant i64. The parser
// already encodes operator precedence in the tree shape, so a direct post-order
// fold yields the value.
fn eval_int_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !i64 {
    let node = ast.get(node_id);
    return match node.data {
        Int(int_node) => try parse_int_literal(ast_node_text(text, ast, node_id)),
        Var(var_node) => try int_env_value(env, ast_node_text(text, ast, node_id)),
        Binary(binary) => try eval_int_binary(text, ast, binary.op, binary.left, binary.right, env),
        Call(call_node) => try eval_call(text, ast, env, call_node.callee, call_node.args),
        _ => try unsupported_int_expr(),
    };
}

fn unsupported_int_expr() -> !i64 {
    return error("unsupported integer expression in run codegen");
}

// eval_call evaluates a direct call to a user-declared function by binding its
// evaluated arguments to its parameters and evaluating the function body. The
// callee must be a plain identifier naming a function in the program's
// declarations; argument expressions are evaluated in the caller's environment.
fn eval_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    caller_env: &IntEnv,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    let name = ast_node_text(text, ast, callee);
    var index = 0;
    while index < caller_env.decls.len {
        let child = try ast.child_at(caller_env.decls, index);
        let node = ast.get(child);
        let matched = match node.data {
            FnDecl(fn_decl) => std::mem::equal_bytes(ast_node_text(text, ast, fn_decl.name), name),
            _ => false,
        };
        if matched {
            return try eval_fn_decl(text, ast, caller_env, child, args);
        }
        index = index + 1;
    }
    return error("unknown function in run codegen");
}

fn eval_fn_decl(
    text: []u8,
    ast: std::kizu::ast::Ast,
    caller_env: &IntEnv,
    fn_node: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    let node = ast.get(fn_node);
    return match node.data {
        FnDecl(fn_decl) => try eval_fn_body(text, ast, caller_env, fn_decl.params, fn_decl.body, args),
        _ => try unsupported_int_expr(),
    };
}

fn eval_fn_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    caller_env: &IntEnv,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    if params.len != args.len {
        return error("argument count mismatch in run codegen");
    }
    var param_env = empty_int_env(text, caller_env.decls);
    var index = 0;
    while index < params.len {
        let param = try ast.child_at(params, index);
        let arg = try ast.child_at(args, index);
        let pname = param_name(text, ast, param);
        if std::mem::len(pname) == 0 {
            return error("unsupported parameter in run codegen");
        }
        let pvalue = try eval_int_expr(text, ast, arg, caller_env);
        let extended = int_env_put(&param_env, pname, pvalue);
        if extended.count < 0 {
            return error("too many parameters in run codegen");
        }
        param_env = extended;
        index = index + 1;
    }
    return try eval_function_body(text, ast, body, &param_env);
}

fn param_name(
    text: []u8,
    ast: std::kizu::ast::Ast,
    param: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(param);
    match node.data {
        Param(param_node) => return ast_node_text(text, ast, param_node.name);,
        _ => return text[0..0];,
    }
}

fn eval_function_body(
    text: []u8,
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !i64 {
    let node = ast.get(body);
    return match node.data {
        Block(block) => try eval_block_return(text, ast, block.statements, env),
        _ => try unsupported_int_expr(),
    };
}

// eval_block_return evaluates a function body block: optional leading integer
// let bindings extend the environment, and the terminal statement must be a
// return of an integer expression.
fn eval_block_return(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    env: &IntEnv
) -> !i64 {
    var current = copy_int_env(env);
    var index = 0;
    while index < statements.len {
        let statement = try ast.child_at(statements, index);
        let node = ast.get(statement);
        let terminal = index + 1 == statements.len;
        if terminal {
            return match node.data {
                Return(return_node) => try eval_int_expr(text, ast, return_node.value, &current),
                _ => try unsupported_int_expr(),
            };
        }
        let next = match node.data {
            Let(let_node) => try extend_int_env(text, ast, &current, let_node.name, let_node.value),
            _ => overflow_from(&current),
        };
        if next.count < 0 {
            return error("unsupported function body in run codegen");
        }
        current = next;
        index = index + 1;
    }
    return error("function body has no return in run codegen");
}

fn eval_int_binary(
    text: []u8,
    ast: std::kizu::ast::Ast,
    op: std::kizu::ast::BinaryOp,
    left_id: std::kizu::ast::NodeId,
    right_id: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !i64 {
    let left = try eval_int_expr(text, ast, left_id, env);
    let right = try eval_int_expr(text, ast, right_id, env);
    if op == std::kizu::ast::binary_add() {
        return left + right;
    }
    if op == std::kizu::ast::binary_sub() {
        return left - right;
    }
    if op == std::kizu::ast::binary_mul() {
        return left * right;
    }
    if op == std::kizu::ast::binary_div() {
        if right == 0 {
            return error("division by zero in run codegen");
        }
        return left / right;
    }
    return error("unsupported integer operator in run codegen");
}

// eval_bool_expr evaluates a boolean literal, integer comparison, or logical
// (and/or) expression to a constant bool over the integer environment.
fn eval_bool_expr(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !bool {
    let node = ast.get(node_id);
    return match node.data {
        Bool(bool_node) => try parse_bool_literal(ast_node_text(text, ast, node_id)),
        Binary(binary) => try eval_bool_binary(text, ast, binary.op, binary.left, binary.right, env),
        _ => try unsupported_bool_expr(),
    };
}

fn unsupported_bool_expr() -> !bool {
    return error("unsupported boolean expression in run codegen");
}

fn parse_bool_literal(literal: []u8) -> !bool {
    if std::mem::equal_bytes(literal, "true") {
        return true;
    }
    if std::mem::equal_bytes(literal, "false") {
        return false;
    }
    return error("unsupported boolean literal in run codegen");
}

fn eval_bool_binary(
    text: []u8,
    ast: std::kizu::ast::Ast,
    op: std::kizu::ast::BinaryOp,
    left_id: std::kizu::ast::NodeId,
    right_id: std::kizu::ast::NodeId,
    env: &IntEnv
) -> !bool {
    if op == std::kizu::ast::binary_and() {
        let left = try eval_bool_expr(text, ast, left_id, env);
        let right = try eval_bool_expr(text, ast, right_id, env);
        return left and right;
    }
    if op == std::kizu::ast::binary_or() {
        let left = try eval_bool_expr(text, ast, left_id, env);
        let right = try eval_bool_expr(text, ast, right_id, env);
        return left or right;
    }
    let left = try eval_int_expr(text, ast, left_id, env);
    let right = try eval_int_expr(text, ast, right_id, env);
    if op == std::kizu::ast::binary_eq() {
        return left == right;
    }
    if op == std::kizu::ast::binary_not_eq() {
        return left != right;
    }
    if op == std::kizu::ast::binary_lt() {
        return left < right;
    }
    if op == std::kizu::ast::binary_lte() {
        return left <= right;
    }
    if op == std::kizu::ast::binary_gt() {
        return left > right;
    }
    if op == std::kizu::ast::binary_gte() {
        return left >= right;
    }
    return error("unsupported boolean operator in run codegen");
}

fn parse_int_literal(literal: []u8) -> !i64 {
    let length = std::mem::len(literal);
    if length == 0 {
        return error("empty integer literal in run codegen");
    }
    var index = 0;
    var value = 0;
    while index < length {
        let byte = literal[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return error("unsupported integer literal in run codegen");
        }
        value = value * 10 + cast<i64>(byte - cast<u8>(48));
        index = index + 1;
    }
    return value;
}
