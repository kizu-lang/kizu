pub fn append_run_lowering_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> !void {
    let function_name = "selfhost::backend::executable::lower_run_executable_ast";
    try append_selected_body_lowering(out, function_name, "checked-run-executable");
    try append_lowering_rule_facts_from_body(
        out,
        text,
        ast,
        body,
        "selected-run-body-lowering-rule "
    );
    try require_unsupported_return(text, ast, body);
    try append_selected_body_unsupported(out, function_name);
    return;
}

pub fn append_test_lowering_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> !void {
    let function_name = "selfhost::backend::executable::lower_test_executable_ast";
    try append_selected_body_lowering(out, function_name, "checked-test-executable");
    try append_lowering_rule_facts_from_body(
        out,
        text,
        ast,
        body,
        "selected-test-body-lowering-rule "
    );
    try require_unsupported_return(text, ast, body);
    try append_selected_body_unsupported(out, function_name);
    return;
}

fn append_selected_body_lowering(
    out: &var std::string::String,
    function_name: []u8,
    role: []u8
) -> !void {
    try out.append_bytes("selected-body-lowering ");
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(role);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_selected_body_unsupported(
    out: &var std::string::String,
    function_name: []u8
) -> !void {
    try out.append_bytes("selected-body-lowering-unsupported ");
    try out.append_bytes(function_name);
    try out.append_bytes(" unsupported_executable");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_lowering_rule_facts_from_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId,
    fact_prefix: []u8
) -> !void {
    let node = ast.get(body);
    match node.data {
        Block(block) => return append_lowering_rule_facts_in_block(
            out,
            text,
            ast,
            block.statements,
            fact_prefix
        );,
        _ => return error("invalid selected body lowering source");,
    }
}

fn append_lowering_rule_facts_in_block(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    fact_prefix: []u8
) -> !void {
    var found = false;
    var index = 0;
    while index < statements.len {
        let statement = try ast.child_at(statements, index);
        if try append_lowering_rule_fact_from_statement(
            out,
            text,
            ast,
            statement,
            fact_prefix
        ) {
            found = true;
        }
        index = index + 1;
    }
    if !found {
        return error("missing selected body lowering rule");
    }
    return;
}

fn append_lowering_rule_fact_from_statement(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    fact_prefix: []u8
) -> !bool {
    let node = ast.get(statement);
    match node.data {
        If(if_node) => return try append_lowering_rule_fact_from_if(
            out,
            text,
            ast,
            if_node.condition,
            if_node.then_block,
            fact_prefix
        );,
        _ => return false;,
    }
}

fn append_lowering_rule_fact_from_if(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    fact_prefix: []u8
) -> !bool {
    let node = ast.get(condition);
    match node.data {
        Binary(binary) => return try append_lowering_rule_fact_from_binary(
            out,
            text,
            ast,
            binary.op,
            binary.left,
            binary.right,
            then_block,
            fact_prefix
        );,
        _ => return false;,
    }
}

fn append_lowering_rule_fact_from_binary(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    op: std::kizu::ast::BinaryOp,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    fact_prefix: []u8
) -> !bool {
    if op != std::kizu::ast::binary_eq() {
        return false;
    }
    if !std::mem::equal_bytes(ast_node_text(text, ast, left), "executable_ast.kind") {
        return false;
    }
    if !node_text_starts_with(text, ast, right, "data::ExecutableAstKind::") {
        return false;
    }
    let executable_kind = try executable_kind_node_from_then_block(text, ast, then_block);
    try out.append_bytes(fact_prefix);
    try append_enum_suffix(out, text, ast, right, "data::ExecutableAstKind::");
    try out.append_byte(cast<u8>(32));
    try append_enum_suffix(out, text, ast, executable_kind, "data::ExecutableKind::");
    try out.append_byte(cast<u8>(10));
    return true;
}

fn executable_kind_node_from_then_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    then_block: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(then_block);
    match node.data {
        Block(block) => return try executable_kind_node_from_block(text, ast, block.statements);,
        _ => return error("invalid selected body lowering rule");,
    }
}

fn executable_kind_node_from_block(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !std::kizu::ast::NodeId {
    if statements.len < 1 {
        return error("invalid selected body lowering rule");
    }
    let statement = try ast.child_at(statements, 0);
    return try executable_kind_node_from_return_statement(text, ast, statement);
}

fn executable_kind_node_from_return_statement(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(statement);
    match node.data {
        Return(return_node) => return try executable_kind_node_from_return_value(
            text,
            ast,
            return_node.value
        );,
        _ => return error("invalid selected body lowering rule");,
    }
}

fn executable_kind_node_from_return_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(value);
    match node.data {
        StructLiteralExpr(struct_literal) => return try executable_kind_node_from_struct_literal(
            text,
            ast,
            struct_literal.type_name,
            struct_literal.fields
        );,
        _ => return error("invalid selected body lowering rule");,
    }
}

fn executable_kind_node_from_struct_literal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange
) -> !std::kizu::ast::NodeId {
    if !std::mem::equal_bytes(ast_node_text(text, ast, type_name), "data::Executable") {
        return error("invalid selected body lowering rule");
    }
    if fields.len < 1 {
        return error("invalid selected body lowering rule");
    }
    let field = try ast.child_at(fields, 0);
    return try executable_kind_node_from_kind_field(text, ast, field);
}

fn executable_kind_node_from_kind_field(
    text: []u8,
    ast: std::kizu::ast::Ast,
    field: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(field);
    match node.data {
        StructFieldInit(field_init) => return executable_kind_node_from_field_init(
            text,
            ast,
            field_init.name,
            field_init.value
        );,
        _ => return error("invalid selected body lowering rule");,
    }
}

fn executable_kind_node_from_field_init(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "kind") {
        return error("invalid selected body lowering rule");
    }
    if !node_text_starts_with(text, ast, value, "data::ExecutableKind::") {
        return error("invalid selected body lowering rule");
    }
    return value;
}

fn require_unsupported_return(
    text: []u8,
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> !void {
    if try body_contains_unsupported_return(text, ast, body) {
        return;
    }
    return error("missing selected body unsupported executable return");
}

fn body_contains_unsupported_return(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !bool {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return try range_contains_unsupported_return(text, ast, block.statements);,
        Return(return_node) => return return_calls_unsupported(text, ast, return_node.value);,
        If(if_node) => return try if_contains_unsupported_return(
            text,
            ast,
            if_node.then_block,
            if_node.else_block
        );,
        _ => return false;,
    }
}

fn if_contains_unsupported_return(
    text: []u8,
    ast: std::kizu::ast::Ast,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId
) -> !bool {
    if try body_contains_unsupported_return(text, ast, then_block) {
        return true;
    }
    return try body_contains_unsupported_return(text, ast, else_block);
}

fn range_contains_unsupported_return(
    text: []u8,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !bool {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        if try body_contains_unsupported_return(text, ast, child) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn return_calls_unsupported(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(value);
    return match node.data {
        Call(call_node) => std::mem::equal_bytes(
            ast_node_text(text, ast, call_node.callee),
            "unsupported_executable"
        ),
        _ => false,
    };
}

fn node_text_starts_with(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    prefix: []u8
) -> bool {
    return std::mem::starts_with(ast_node_text(text, ast, node_id), prefix);
}

fn append_enum_suffix(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    prefix: []u8
) -> !void {
    if !node_text_starts_with(text, ast, node_id, prefix) {
        return error("invalid selected body lowering rule");
    }
    let node = ast.get(node_id);
    let span = &node.span;
    try out.append_bytes(text[span.start + std::mem::len(prefix)..span.end]);
    return;
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
