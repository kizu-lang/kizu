import selfhost::ir::package_catalog;
import selfhost::ir::builtin_contract;
import selfhost::ir::intrinsic_type_contract;
import selfhost::ir::package_type_hash;
import selfhost::ir::package_type_substitutions;

pub struct ResolvedType {
    pub type_id: i64,
    pub kind: i64,
    pub full_spelling: []u8,
    pub constructor_name: []u8,
    pub intrinsic_kind: i64,
    pub declaration_index: i64,
    pub declaration_component_id: i64,
    pub spelling_component_id: i64,
}

pub struct TypeStore {
    records: std::array::Array<TypeRecord>,
    record_child_type_ids: std::array::Array<i64>,
    intrinsic_leaf_type_ids: std::array::Array<i64>,
    type_index_entries: std::array::Array<i64>,
    canonical_records: std::array::Array<CanonicalTypeRecord>,
    canonical_child_ids: std::array::Array<i64>,
    canonical_index_entries: std::array::Array<i64>,
}

// CanonicalTypeId is a package-wide semantic identity. Unlike TypeId it never
// contains the component in which a spelling happened to occur.
pub struct CanonicalTypeId { pub value: i64 }

// Keep the numeric representation owned by the semantic type module.  Callers
// must not depend on cross-module field-name inference for the common `value`
// spelling used by several unrelated records.
pub fn canonical_type_id_value(id: &CanonicalTypeId) -> i64 {
    return id.value;
}

pub struct CanonicalTypeFacts {
    pub records: std::array::Array<CanonicalTypeRecord>,
    pub child_ids: std::array::Array<i64>,
}

pub struct CanonicalTypeRecord {
    pub kind: i64,
    pub intrinsic_kind: i64,
    pub declaration_component_id: i64,
    pub declaration_index: i64,
    pub formal_owner_kind: i64,
    pub formal_owner_id: i64,
    pub formal_slot: i64,
    pub child_start: i64,
    pub child_len: i64,
}

// Substitution scratch is transaction-scoped. Callers take a mark, perform
// one instantiation, and restore the prior mark before propagating its result.
struct TypeRecord {
    kind: i64,
    full_spelling: []u8,
    constructor_name: []u8,
    intrinsic_kind: i64,
    declaration_index: i64,
    declaration_component_id: i64,
    spelling_component_id: i64,
    formal_owner_kind: i64,
    formal_owner_id: i64,
    formal_slot: i64,
    child_start: i64,
    child_len: i64,
    canonical_id: i64,
}

struct TypeIndexLookup {
    found: bool,
    type_id: i64,
}

pub fn no_declaration_component() -> i64 { return -1; }
pub fn type_kind_intrinsic() -> i64 { return 1; }
pub fn type_kind_declared() -> i64 { return 2; }
pub fn type_kind_formal() -> i64 { return 3; }
pub fn type_kind_borrow() -> i64 { return 4; }
pub fn type_kind_borrow_var() -> i64 { return 5; }
pub fn type_kind_slice() -> i64 { return 6; }
pub fn type_kind_nullable() -> i64 { return 7; }
pub fn type_kind_dynamic() -> i64 { return 8; }
pub fn type_kind_error_union() -> i64 { return 9; }
pub fn type_kind_const() -> i64 { return 10; }
pub fn type_kind_function_item() -> i64 { return 11; }
pub fn intrinsic_array_kind() -> i64 { return intrinsic_type_contract::kind_array(); }
pub fn intrinsic_arena_kind() -> i64 { return intrinsic_type_contract::kind_arena(); }
pub fn intrinsic_arena_handle_kind() -> i64 { return intrinsic_type_contract::kind_arena_handle(); }
pub fn intrinsic_map_kind() -> i64 { return intrinsic_type_contract::kind_map(); }
pub fn intrinsic_box_kind() -> i64 { return intrinsic_type_contract::kind_box(); }
pub fn intrinsic_channel_kind() -> i64 { return intrinsic_type_contract::kind_channel(); }
pub fn intrinsic_atomic_kind() -> i64 { return intrinsic_type_contract::kind_atomic(); }
pub fn intrinsic_mutex_kind() -> i64 { return intrinsic_type_contract::kind_mutex(); }
pub fn intrinsic_task_kind() -> i64 { return intrinsic_type_contract::kind_task(); }
pub fn intrinsic_task_group_kind() -> i64 { return intrinsic_type_contract::kind_task_group(); }
pub fn intrinsic_queue_kind() -> i64 { return intrinsic_type_contract::kind_queue(); }
pub fn intrinsic_partition_kind() -> i64 { return intrinsic_type_contract::kind_partition(); }
pub fn intrinsic_local_buffer_kind() -> i64 { return intrinsic_type_contract::kind_local_buffer(); }

// intrinsic_owned_container_family is the single TypeId-kind bridge from
// semantic intrinsic types to the canonical owned-container contract. It is
// independent of create/destroy operations and never uses deinit as a
// constructor proof.
pub fn intrinsic_owned_container_family(intrinsic_kind: i64) -> i64 {
    if intrinsic_kind == intrinsic_array_kind() {
        return builtin_contract::owned_container_family_sequence();
    }
    if intrinsic_kind == intrinsic_arena_kind() {
        return builtin_contract::owned_container_family_sequence();
    }
    if intrinsic_kind == intrinsic_map_kind() {
        return builtin_contract::owned_container_family_map();
    }
    if intrinsic_kind == intrinsic_box_kind() {
        return builtin_contract::owned_container_family_box();
    }
    return builtin_contract::owned_container_family_none();
}
pub fn formal_owner_function() -> i64 { return 1; }
pub fn formal_owner_declared() -> i64 { return 2; }
pub fn formal_owner_none() -> i64 { return -1; }

pub fn unknown_type() -> ResolvedType {
    return ResolvedType {
        type_id: -1, kind: 0, full_spelling: "unknown",
        constructor_name: "unknown", intrinsic_kind: -1,
        declaration_index: -1,
        declaration_component_id: no_declaration_component(),
        spelling_component_id: no_declaration_component()
    };
}

pub fn type_store(
    allocator: Allocator,
    catalog: &package_catalog::PackageFunctionCatalog
) -> !TypeStore {
    var store = TypeStore {
        records: std::array::Array<TypeRecord>(allocator),
        record_child_type_ids: std::array::Array<i64>(allocator),
        intrinsic_leaf_type_ids: std::array::Array<i64>(allocator),
        type_index_entries: std::array::Array<i64>(allocator),
        canonical_records: std::array::Array<CanonicalTypeRecord>(allocator),
        canonical_child_ids: std::array::Array<i64>(allocator),
        canonical_index_entries: std::array::Array<i64>(allocator)
    };
    errdefer store.deinit();
    let intrinsic_stride = intrinsic_local_buffer_kind() + 1;
    let intrinsic_slot_len = package_catalog::component_len(catalog) * intrinsic_stride;
    try store.intrinsic_leaf_type_ids.reserve(intrinsic_slot_len);
    var index = 0;
    while index < intrinsic_slot_len {
        try store.intrinsic_leaf_type_ids.append(-1);
        index = index + 1;
    }
    try append_empty_type_index_entries(&var store.type_index_entries, 16);
    try append_empty_type_index_entries(&var store.canonical_index_entries, 16);
    return store;
}

pub fn canonical_type_facts(allocator: Allocator) -> CanonicalTypeFacts {
    return CanonicalTypeFacts {
        records: std::array::Array<CanonicalTypeRecord>(allocator),
        child_ids: std::array::Array<i64>(allocator)
    };
}

// Function items have one package-qualified declaration identity plus the
// ordered canonical type actuals that determine their specialization. They
// are semantic compile-time values with a common pointer ABI; source spelling
// is provenance only and never participates in CanonicalTypeId equality.
pub fn function_item(
    store: &var TypeStore,
    spelling_component_id: i64,
    target_component_id: i64,
    target_function_id: i64,
    type_actual_ids: &std::array::Array<i64>
) -> !ResolvedType {
    return intern_type_record(
        store, type_kind_function_item(), "function-item", "function-item", -1,
        target_function_id, target_component_id, spelling_component_id,
        formal_owner_none(), -1, -1, type_actual_ids
    );
}

pub fn intrinsic_application(
    store: &var TypeStore,
    spelling_component_id: i64,
    intrinsic_kind: i64,
    type_argument_ids: &std::array::Array<i64>
) -> !ResolvedType {
    if type_argument_ids.len() != intrinsic_type_contract::arity(intrinsic_kind) {
        return error("intrinsic application arity mismatch");
    }
    let identity = try intrinsic_type_contract::canonical_name(intrinsic_kind);
    return intern_type_record(
        store, type_kind_intrinsic(), identity, identity, intrinsic_kind,
        -1, no_declaration_component(), spelling_component_id,
        formal_owner_none(), -1, -1, type_argument_ids
    );
}

pub fn canonicalize_type(
    store: &TypeStore,
    value: &ResolvedType
) -> !CanonicalTypeId {
    if value.type_id < 0 { return error("cannot canonicalize unknown type"); }
    let records = &store.records;
    let record = try records.at(value.type_id);
    if record.canonical_id < 0 { return error("type record has no canonical identity"); }
    return CanonicalTypeId { value: record.canonical_id };
}

pub fn snapshot_canonical_types(
    store: &TypeStore,
    allocator: Allocator
) -> !CanonicalTypeFacts {
    var result = canonical_type_facts(allocator);
    errdefer result.deinit();
    try result.records.reserve(store.canonical_records.len());
    try result.child_ids.reserve(store.canonical_child_ids.len());
    var index = 0;
    while index < store.canonical_records.len() {
        let records = &store.canonical_records;
        let record = try records.at(index);
        try result.records.append(CanonicalTypeRecord {
            kind: record.kind, intrinsic_kind: record.intrinsic_kind,
            declaration_component_id: record.declaration_component_id,
            declaration_index: record.declaration_index,
            formal_owner_kind: record.formal_owner_kind,
            formal_owner_id: record.formal_owner_id,
            formal_slot: record.formal_slot,
            child_start: record.child_start, child_len: record.child_len
        });
        index = index + 1;
    }
    index = 0;
    while index < store.canonical_child_ids.len() {
        try result.child_ids.append(try store.canonical_child_ids.get(index));
        index = index + 1;
    }
    return result;
}

fn canonical_fact_key_matches(
    facts: &CanonicalTypeFacts,
    candidate_id: i64,
    template: &CanonicalTypeRecord,
    children: &std::array::Array<i64>
) -> !bool {
    let records = &facts.records;
    let candidate = try records.at(candidate_id);
    if candidate.kind != template.kind or
        candidate.intrinsic_kind != template.intrinsic_kind or
        candidate.declaration_component_id != template.declaration_component_id or
        candidate.declaration_index != template.declaration_index or
        candidate.formal_owner_kind != template.formal_owner_kind or
        candidate.formal_owner_id != template.formal_owner_id or
        candidate.formal_slot != template.formal_slot or
        candidate.child_len != children.len() {
        return false;
    }
    var child = 0;
    while child < candidate.child_len {
        if try facts.child_ids.get(candidate.child_start + child) !=
            try children.get(child) {
            return false;
        }
        child = child + 1;
    }
    return true;
}

// instantiate_canonical_template is the producer-owned recursive
// formal-to-actual operation. Backend lowering consumes only the exact
// CanonicalTypeId facts produced here and never reparses or substitutes source
// type spelling.
pub fn instantiate_canonical_template(
    facts: &CanonicalTypeFacts,
    template_id: i64,
    formal_owner_id: i64,
    actuals: &std::array::Array<i64>
) -> !i64 {
    if template_id < 0 or template_id >= facts.records.len() {
        return error("canonical template identity out of range");
    }
    let records = &facts.records;
    let source = try records.at(template_id);
    let template = CanonicalTypeRecord {
        kind: source.kind,
        intrinsic_kind: source.intrinsic_kind,
        declaration_component_id: source.declaration_component_id,
        declaration_index: source.declaration_index,
        formal_owner_kind: source.formal_owner_kind,
        formal_owner_id: source.formal_owner_id,
        formal_slot: source.formal_slot,
        child_start: source.child_start,
        child_len: source.child_len
    };
    if template.kind == type_kind_formal() and
        template.formal_owner_kind == formal_owner_function() and
        template.formal_owner_id == formal_owner_id {
        if template.formal_slot < 0 or template.formal_slot >= actuals.len() {
            return error("canonical template formal slot has no actual");
        }
        return actuals.get(template.formal_slot);
    }
    if template.child_len == 0 { return template_id; }

    var children = std::array::Array<i64>(std::mem::page_allocator());
    defer children.deinit();
    var changed = false;
    var child = 0;
    while child < template.child_len {
        let original = try facts.child_ids.get(template.child_start + child);
        let instantiated = try instantiate_canonical_template(
            facts, original, formal_owner_id, actuals
        );
        if instantiated != original { changed = true; }
        try children.append(instantiated);
        child = child + 1;
    }
    if !changed { return template_id; }

    var candidate = 0;
    while candidate < facts.records.len() {
        if try canonical_fact_key_matches(facts, candidate, &template, &children) {
            return candidate;
        }
        candidate = candidate + 1;
    }
    return error("instantiated canonical type was not interned by frontend resolution");
}

pub fn intern_type_wrapper(
    store: &var TypeStore,
    kind: i64,
    full_spelling: []u8,
    constructor_name: []u8,
    spelling_component_id: i64,
    children: &std::array::Array<i64>
) -> !ResolvedType {
    return intern_type_record(
        store, kind, full_spelling, constructor_name,
        -1, -1, no_declaration_component(), spelling_component_id,
        formal_owner_none(), -1, -1, children
    );
}

pub fn intern_type_leaf(
    store: &var TypeStore,
    kind: i64,
    full_spelling: []u8,
    constructor_name: []u8,
    intrinsic: i64,
    declaration_index: i64,
    declaration_component_id: i64,
    spelling_component_id: i64,
    formal_owner_kind: i64,
    formal_owner_id: i64,
    formal_slot: i64
) -> !ResolvedType {
    var children = std::array::Array<i64>(std::mem::page_allocator());
    defer children.deinit();
    return intern_type_record(
        store, kind, full_spelling, constructor_name, intrinsic,
        declaration_index, declaration_component_id, spelling_component_id,
        formal_owner_kind, formal_owner_id, formal_slot, &children
    );
}

pub fn intern_type_record(
    store: &var TypeStore,
    kind: i64,
    full_spelling: []u8,
    constructor_name: []u8,
    intrinsic: i64,
    declaration_index: i64,
    declaration_component_id: i64,
    spelling_component_id: i64,
    formal_owner_kind: i64,
    formal_owner_id: i64,
    formal_slot: i64,
    children: &std::array::Array<i64>
) -> !ResolvedType {
    var index = 0;
    while index < children.len() {
        let child_id = try children.get(index);
        if child_id < 0 or child_id >= store.records.len() {
            return error("package type record child must already exist");
        }
        index = index + 1;
    }
    let intrinsic_stride = intrinsic_local_buffer_kind() + 1;
    var intrinsic_leaf_slot = -1;
    if children.len() == 0 and kind == type_kind_intrinsic() and intrinsic >= 0 and
        intrinsic < intrinsic_stride and spelling_component_id >= 0 {
        intrinsic_leaf_slot = spelling_component_id * intrinsic_stride + intrinsic;
    }
    if intrinsic_leaf_slot >= 0 and
        intrinsic_leaf_slot < store.intrinsic_leaf_type_ids.len() {
        let cached = try store.intrinsic_leaf_type_ids.get(intrinsic_leaf_slot);
        if cached >= 0 { return type_at(store, cached); }
    }
    let indexed = try lookup_type_index(
        store, kind, intrinsic, declaration_index, declaration_component_id,
        spelling_component_id, formal_owner_kind, formal_owner_id, formal_slot,
        children
    );
    if indexed.found { return type_at(store, indexed.type_id); }
    try ensure_type_index_capacity(store);
    try store.records.reserve(1);
    try store.record_child_type_ids.reserve(children.len());
    var canonical_children = std::array::Array<i64>(std::mem::page_allocator());
    defer canonical_children.deinit();
    try canonical_children.reserve(children.len());
    index = 0;
    while index < children.len() {
        let records = &store.records;
        let child_record = try records.at(try children.get(index));
        if child_record.canonical_id < 0 {
            return error("package type child has no canonical identity");
        }
        try canonical_children.append(child_record.canonical_id);
        index = index + 1;
    }
    let canonical_id = try intern_canonical_type(
        store, kind, intrinsic,
        declaration_component_id, declaration_index,
        formal_owner_kind, formal_owner_id, formal_slot,
        &canonical_children
    );
    let type_id = store.records.len();
    if type_id == 9223372036854775807 {
        return error("package type id overflow");
    }
    let child_start = store.record_child_type_ids.len();
    let append_result = append_record_rows(store, children, TypeRecord {
        kind: kind, full_spelling: full_spelling,
        constructor_name: constructor_name, intrinsic_kind: intrinsic,
        declaration_index: declaration_index,
        declaration_component_id: declaration_component_id,
        spelling_component_id: spelling_component_id,
        formal_owner_kind: formal_owner_kind,
        formal_owner_id: formal_owner_id, formal_slot: formal_slot,
        child_start: child_start, child_len: children.len(),
        canonical_id: canonical_id
    });
    if store.records.len() == type_id {
        try clear_record_children_to(store, child_start);
    }
    try append_result;
    // Rehash establishes an empty in-bounds slot before this allocation-free
    // commit. An impossible Array.set failure aborts package resolution, whose
    // caller then destroys the TypeStore; a partially indexed store is never
    // returned or reused.
    try insert_record_in_type_index(store, type_id);
    if intrinsic_leaf_slot >= 0 and
        intrinsic_leaf_slot < store.intrinsic_leaf_type_ids.len() {
        try store.intrinsic_leaf_type_ids.set(intrinsic_leaf_slot, type_id);
    }
    return type_at(store, type_id);
}

fn intern_canonical_type(
    store: &var TypeStore,
    kind: i64,
    intrinsic: i64,
    declaration_component_id: i64,
    declaration_index: i64,
    formal_owner_kind: i64,
    formal_owner_id: i64,
    formal_slot: i64,
    children: &std::array::Array<i64>
) -> !i64 {
    try ensure_canonical_index_capacity(store);
    let slot_len = store.canonical_index_entries.len();
    var identity = type_hash_identity(
        kind, intrinsic, declaration_component_id, declaration_index,
        no_declaration_component(), formal_owner_kind, formal_owner_id, formal_slot
    );
    var slot = try package_type_hash::hash_array(&identity, children, slot_len);
    var probes = 0;
    while probes < slot_len {
        let encoded = try store.canonical_index_entries.get(slot);
        if encoded == 0 {
            try store.canonical_records.reserve(1);
            try store.canonical_child_ids.reserve(children.len());
            let id = store.canonical_records.len();
            let child_start = store.canonical_child_ids.len();
            let children_result = append_canonical_children(
                &var store.canonical_child_ids, children
            );
            if store.canonical_child_ids.len() != child_start + children.len() {
                try clear_canonical_children_to(store, child_start);
            }
            try children_result;
            let append_result = store.canonical_records.append(CanonicalTypeRecord {
                kind: kind, intrinsic_kind: intrinsic,
                declaration_component_id: declaration_component_id,
                declaration_index: declaration_index,
                formal_owner_kind: formal_owner_kind,
                formal_owner_id: formal_owner_id, formal_slot: formal_slot,
                child_start: child_start, child_len: children.len()
            });
            if store.canonical_records.len() == id {
                try clear_canonical_children_to(store, child_start);
            }
            try append_result;
            // The hash slot was proven empty and is in bounds. After all
            // allocation-bearing appends commit, this set cannot allocate.
            try store.canonical_index_entries.set(slot, id + 1);
            return id;
        }
        let id = encoded - 1;
        if try canonical_key_matches(
            store, id, kind, intrinsic, declaration_component_id,
            declaration_index, formal_owner_kind, formal_owner_id,
            formal_slot, children
        ) { return id; }
        slot = package_type_hash::next_slot(slot, slot_len);
        probes = probes + 1;
    }
    return error("canonical type index is full");
}

fn append_canonical_children(
    destination: &var std::array::Array<i64>,
    children: &std::array::Array<i64>
) -> !void {
    var index = 0;
    while index < children.len() {
        try destination.append(try children.get(index));
        index = index + 1;
    }
    return;
}

fn clear_canonical_children_to(store: &var TypeStore, mark: i64) -> !void {
    while store.canonical_child_ids.len() > mark {
        let ignored = try store.canonical_child_ids.pop();
    }
    return;
}

fn canonical_key_matches(
    store: &TypeStore, id: i64, kind: i64, intrinsic: i64,
    declaration_component_id: i64, declaration_index: i64,
    formal_owner_kind: i64, formal_owner_id: i64, formal_slot: i64,
    children: &std::array::Array<i64>
) -> !bool {
    let records = &store.canonical_records;
    let record = try records.at(id);
    if record.kind != kind or record.child_len != children.len() { return false; }
    if kind == type_kind_intrinsic() and record.intrinsic_kind != intrinsic { return false; }
    if (kind == type_kind_declared() or kind == type_kind_function_item()) and
        (record.declaration_component_id != declaration_component_id or
        record.declaration_index != declaration_index) { return false; }
    if kind == type_kind_formal() and
        (record.formal_owner_kind != formal_owner_kind or
        record.formal_owner_id != formal_owner_id or
        record.formal_slot != formal_slot) { return false; }
    var index = 0;
    while index < children.len() {
        if try store.canonical_child_ids.get(record.child_start + index) != try children.get(index) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn ensure_canonical_index_capacity(store: &var TypeStore) -> !void {
    let capacity = store.canonical_index_entries.len();
    if capacity <= 0 { return error("canonical type index has no slots"); }
    let load_limit = capacity - (capacity / 4);
    if store.canonical_records.len() < load_limit { return; }
    if capacity > 4611686018427387903 { return error("canonical type index capacity overflow"); }
    let next = capacity + capacity;
    try append_empty_type_index_entries(&var store.canonical_index_entries, capacity);
    var slot = 0;
    while slot < next { try store.canonical_index_entries.set(slot, 0); slot = slot + 1; }
    var id = 0;
    while id < store.canonical_records.len() {
        let records = &store.canonical_records;
        let record = try records.at(id);
        var identity = type_hash_identity(
            record.kind, record.intrinsic_kind,
            record.declaration_component_id, record.declaration_index,
            no_declaration_component(), record.formal_owner_kind,
            record.formal_owner_id, record.formal_slot
        );
        slot = try package_type_hash::hash_flat(
            &identity, &store.canonical_child_ids,
            record.child_start, record.child_len, next
        );
        while try store.canonical_index_entries.get(slot) != 0 {
            slot = package_type_hash::next_slot(slot, next);
        }
        try store.canonical_index_entries.set(slot, id + 1);
        id = id + 1;
    }
    return;
}

fn append_empty_type_index_entries(
    entries: &var std::array::Array<i64>,
    count: i64
) -> !void {
    try entries.reserve(count);
    var index = 0;
    while index < count {
        try entries.append(0);
        index = index + 1;
    }
    return;
}

// lookup_type_index probes the numeric semantic key. Source spellings are
// intentionally absent: aliases that resolve to the same constructor and
// children share a TypeId within one spelling component.
fn lookup_type_index(
    store: &TypeStore,
    kind: i64,
    intrinsic: i64,
    declaration_index: i64,
    declaration_component_id: i64,
    spelling_component_id: i64,
    formal_owner_kind: i64,
    formal_owner_id: i64,
    formal_slot: i64,
    children: &std::array::Array<i64>
) -> !TypeIndexLookup {
    let slot_len = store.type_index_entries.len();
    if slot_len <= 0 { return error("package type index has no slots"); }
    var identity = type_hash_identity(
        kind, intrinsic, declaration_component_id, declaration_index,
        spelling_component_id, formal_owner_kind, formal_owner_id, formal_slot
    );
    var slot = try package_type_hash::hash_array(&identity, children, slot_len);
    var probes = 0;
    while probes < slot_len {
        let encoded = try store.type_index_entries.get(slot);
        if encoded == 0 {
            return TypeIndexLookup { found: false, type_id: -1 };
        }
        let candidate_id = encoded - 1;
        if try record_matches_type_key(
            store, candidate_id, kind, intrinsic, declaration_index,
            declaration_component_id, spelling_component_id,
            formal_owner_kind, formal_owner_id, formal_slot, children
        ) {
            return TypeIndexLookup { found: true, type_id: candidate_id };
        }
        slot = package_type_hash::next_slot(slot, slot_len);
        probes = probes + 1;
    }
    return error("package type index is full");
}

fn record_matches_type_key(
    store: &TypeStore,
    candidate_id: i64,
    kind: i64,
    intrinsic: i64,
    declaration_index: i64,
    declaration_component_id: i64,
    spelling_component_id: i64,
    formal_owner_kind: i64,
    formal_owner_id: i64,
    formal_slot: i64,
    children: &std::array::Array<i64>
) -> !bool {
    let records = &store.records;
    let candidate = try records.at(candidate_id);
    if candidate.kind != kind or
        candidate.spelling_component_id != spelling_component_id or
        candidate.child_len != children.len() {
        return false;
    }
    if kind == type_kind_intrinsic() and candidate.intrinsic_kind != intrinsic {
        return false;
    }
    if (kind == type_kind_declared() or kind == type_kind_function_item()) and
        (candidate.declaration_index != declaration_index or
        candidate.declaration_component_id != declaration_component_id) {
        return false;
    }
    if kind == type_kind_formal() and
        (candidate.formal_owner_kind != formal_owner_kind or
        candidate.formal_owner_id != formal_owner_id or
        candidate.formal_slot != formal_slot) {
        return false;
    }
    var index = 0;
    while index < children.len() {
        if store.record_child_type_ids.get_or_panic(candidate.child_start + index) !=
            try children.get(index) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn ensure_type_index_capacity(store: &var TypeStore) -> !void {
    let capacity = store.type_index_entries.len();
    if capacity <= 0 { return error("package type index has no slots"); }
    let load_limit = capacity - (capacity / 4);
    if store.records.len() < load_limit { return; }
    if capacity > 4611686018427387903 {
        return error("package type index capacity overflow");
    }
    let next_capacity = capacity + capacity;
    try append_empty_type_index_entries(&var store.type_index_entries, capacity);
    var slot = 0;
    while slot < next_capacity {
        try store.type_index_entries.set(slot, 0);
        slot = slot + 1;
    }
    var type_id = 0;
    while type_id < store.records.len() {
        try insert_record_in_type_index(store, type_id);
        type_id = type_id + 1;
    }
    return;
}

fn insert_record_in_type_index(
    store: &var TypeStore,
    type_id: i64
) -> !void {
    let slot = try type_index_slot_for_record(store, type_id);
    if try store.type_index_entries.get(slot) != 0 {
        return error("package type index has no empty slot");
    }
    try store.type_index_entries.set(slot, type_id + 1);
    return;
}

fn type_index_slot_for_record(
    store: &TypeStore,
    type_id: i64
) -> !i64 {
    let records = &store.records;
    let record = try records.at(type_id);
    let slot_len = store.type_index_entries.len();
    if slot_len <= 0 { return error("package type index has no slots"); }
    var identity = type_hash_identity(
        record.kind, record.intrinsic_kind,
        record.declaration_component_id, record.declaration_index,
        record.spelling_component_id, record.formal_owner_kind,
        record.formal_owner_id, record.formal_slot
    );
    var slot = try package_type_hash::hash_flat(
        &identity, &store.record_child_type_ids,
        record.child_start, record.child_len, slot_len
    );
    var probes = 0;
    while probes < slot_len {
        if try store.type_index_entries.get(slot) == 0 { return slot; }
        slot = package_type_hash::next_slot(slot, slot_len);
        probes = probes + 1;
    }
    return error("package type index is full");
}

fn type_hash_identity(
    kind: i64,
    intrinsic: i64,
    declaration_component_id: i64,
    declaration_index: i64,
    spelling_component_id: i64,
    formal_owner_kind: i64,
    formal_owner_id: i64,
    formal_slot: i64
) -> package_type_hash::Identity {
    var identity_kind = package_type_hash::identity_none();
    if kind == type_kind_intrinsic() {
        identity_kind = package_type_hash::identity_intrinsic();
    } else {
        if kind == type_kind_declared() or kind == type_kind_function_item() {
            identity_kind = package_type_hash::identity_declaration();
        } else {
            if kind == type_kind_formal() {
                identity_kind = package_type_hash::identity_formal();
            }
        }
    }
    return package_type_hash::Identity {
        kind: kind,
        identity_kind: identity_kind,
        intrinsic_kind: intrinsic,
        declaration_component_id: declaration_component_id,
        declaration_index: declaration_index,
        spelling_component_id: spelling_component_id,
        formal_owner_kind: formal_owner_kind,
        formal_owner_id: formal_owner_id,
        formal_slot: formal_slot
    };
}

fn append_record_rows(
    store: &var TypeStore,
    children: &std::array::Array<i64>,
    record: TypeRecord
) -> !void {
    var index = 0;
    while index < children.len() {
        try store.record_child_type_ids.append(try children.get(index));
        index = index + 1;
    }
    try store.records.append(record);
    return;
}

fn clear_record_children_to(store: &var TypeStore, mark: i64) -> !void {
    if mark < 0 or mark > store.record_child_type_ids.len() {
        return error("package type child rollback mark out of range");
    }
    while store.record_child_type_ids.len() > mark {
        let ignored = try store.record_child_type_ids.pop();
    }
    return;
}

pub fn type_at(store: &TypeStore, type_id: i64) -> !ResolvedType {
    if type_id < 0 or type_id >= store.records.len() {
        return error("package TypeId out of range");
    }
    let records = &store.records;
    let record = try records.at(type_id);
    return ResolvedType {
        type_id: type_id,
        kind: record.kind, full_spelling: record.full_spelling,
        constructor_name: record.constructor_name,
        intrinsic_kind: record.intrinsic_kind,
        declaration_index: record.declaration_index,
        declaration_component_id: record.declaration_component_id,
        spelling_component_id: record.spelling_component_id
    };
}

pub fn type_argument_len(store: &TypeStore, value: &ResolvedType) -> !i64 {
    if value.type_id < 0 { return 0; }
    if value.kind != type_kind_intrinsic() and value.kind != type_kind_declared() {
        return 0;
    }
    let records = &store.records;
    let record = try records.at(value.type_id);
    return record.child_len;
}

pub fn type_child_len(store: &TypeStore, value: &ResolvedType) -> !i64 {
    if value.type_id < 0 { return error("unknown type has no children"); }
    let records = &store.records;
    let record = try records.at(value.type_id);
    return record.child_len;
}

pub fn function_formal_slot(
    store: &TypeStore,
    value: &ResolvedType,
    function_index: i64
) -> !i64 {
    if value.type_id < 0 or value.kind != type_kind_formal() {
        return -1;
    }
    let records = &store.records;
    let record = try records.at(value.type_id);
    if record.formal_owner_kind != formal_owner_function() or
        record.formal_owner_id != function_index {
        return -1;
    }
    return record.formal_slot;
}

pub fn type_argument(
    store: &TypeStore,
    value: &ResolvedType,
    index: i64
) -> !ResolvedType {
    let len = try type_argument_len(store, value);
    if index < 0 or index >= len { return error("type argument index out of range"); }
    return type_child(store, value, index);
}

pub fn type_child(
    store: &TypeStore,
    value: &ResolvedType,
    index: i64
) -> !ResolvedType {
    if value.type_id < 0 { return error("unknown type has no child"); }
    let records = &store.records;
    let record = try records.at(value.type_id);
    let len = record.child_len;
    if index < 0 or index >= len { return error("type child index out of range"); }
    return type_at(
        store, store.record_child_type_ids.get_or_panic(record.child_start + index)
    );
}

pub fn success_type(store: &TypeStore, value: &ResolvedType) -> !ResolvedType {
    if value.kind != type_kind_error_union() {
        return error("try expects an error-union type");
    }
    return type_child(store, value, 1);
}

pub fn without_borrow(store: &TypeStore, value: &ResolvedType) -> !ResolvedType {
    if value.kind == type_kind_borrow() or value.kind == type_kind_borrow_var() {
        return type_child(store, value, 0);
    }
    return copy(value);
}

// dereference_type implements the structural read result of `value.*`.
// Nullable pointers are intentionally rejected; they require an explicit
// non-null conversion policy before dereference.  Reading through const strips
// the pointee qualifier while mutation checks remain a separate concern.
pub fn dereference_type(
    store: &TypeStore,
    value: &ResolvedType
) -> !ResolvedType {
    if value.kind == type_kind_borrow() or value.kind == type_kind_borrow_var() {
        return type_child(store, value, 0);
    }
    if value.kind == type_kind_nullable() {
        return error("nullable raw pointer cannot be dereferenced");
    }
    if value.kind != type_kind_intrinsic() or value.intrinsic_kind != 23 {
        return error("dereference expects a borrow or raw pointer");
    }
    let pointee = try type_argument(store, value, 0);
    if pointee.kind == type_kind_const() {
        return type_child(store, &pointee, 0);
    }
    return pointee;
}

pub fn builtin_error_union(
    store: &var TypeStore,
    success: &ResolvedType
) -> !ResolvedType {
    let error_type = try intern_type_leaf(
        store, type_kind_intrinsic(), "error", "error", 50,
        -1, no_declaration_component(), success.spelling_component_id,
        formal_owner_none(), -1, -1
    );
    var children = std::array::Array<i64>(std::mem::page_allocator());
    defer children.deinit();
    try children.append(error_type.type_id);
    try children.append(success.type_id);
    return intern_type_wrapper(
        store, type_kind_error_union(), "builtin error union", "!",
        success.spelling_component_id, &children
    );
}

pub fn builtin_borrow(
    store: &var TypeStore,
    value: &ResolvedType,
    mutable: bool
) -> !ResolvedType {
    var children = std::array::Array<i64>(std::mem::page_allocator());
    defer children.deinit();
    try children.append(value.type_id);
    if mutable {
        return intern_type_wrapper(
            store, type_kind_borrow_var(), "builtin mutable borrow", "&var",
            value.spelling_component_id, &children
        );
    }
    return intern_type_wrapper(
        store, type_kind_borrow(), "builtin borrow", "&",
        value.spelling_component_id, &children
    );
}

pub fn builtin_arena_handle(
    store: &var TypeStore,
    argument: &ResolvedType
) -> !ResolvedType {
    var children = std::array::Array<i64>(std::mem::page_allocator());
    defer children.deinit();
    try children.append(argument.type_id);
    return intern_type_record(
        store, type_kind_intrinsic(), "builtin intrinsic application",
        "std::arena::Handle", intrinsic_arena_handle_kind(),
        -1, no_declaration_component(),
        argument.spelling_component_id, formal_owner_none(), -1, -1, &children
    );
}

pub fn builtin_task(
    store: &var TypeStore,
    result: &ResolvedType
) -> !ResolvedType {
    var children = std::array::Array<i64>(std::mem::page_allocator());
    defer children.deinit();
    try children.append(result.type_id);
    return intern_type_record(
        store, type_kind_intrinsic(), "builtin intrinsic application",
        "Task", intrinsic_task_kind(), -1, no_declaration_component(),
        result.spelling_component_id, formal_owner_none(), -1, -1, &children
    );
}

pub fn copy(value: &ResolvedType) -> ResolvedType {
    return ResolvedType {
        type_id: value.type_id, kind: value.kind,
        full_spelling: value.full_spelling,
        constructor_name: value.constructor_name,
        intrinsic_kind: value.intrinsic_kind,
        declaration_index: value.declaration_index,
        declaration_component_id: value.declaration_component_id,
        spelling_component_id: value.spelling_component_id
    };
}

pub fn same_constructor(left: &ResolvedType, right: &ResolvedType) -> bool {
    if left.kind != right.kind { return false; }
    if left.kind == type_kind_declared() {
        return left.declaration_index == right.declaration_index;
    }
    if left.kind == type_kind_intrinsic() {
        return left.intrinsic_kind == right.intrinsic_kind;
    }
    if left.kind == type_kind_formal() { return true; }
    return std::mem::equal_bytes(left.constructor_name, right.constructor_name);
}

// Binary expression typing consumes semantic primitive categories from the
// resolved type identity. Callers do not need spelling allowlists, and declared
// types that happen to reuse a primitive-looking local name never qualify.
pub fn is_bool_type(value: &ResolvedType) -> bool {
    return value.kind == type_kind_intrinsic() and value.intrinsic_kind == 2;
}

pub fn is_numeric_type(value: &ResolvedType) -> bool {
    return value.kind == type_kind_intrinsic() and
        value.intrinsic_kind >= 3 and value.intrinsic_kind <= 14;
}

pub fn is_integer_type(value: &ResolvedType) -> bool {
    return value.kind == type_kind_intrinsic() and
        value.intrinsic_kind >= 3 and value.intrinsic_kind <= 12;
}

pub fn same_type(
    store: &TypeStore,
    left: &ResolvedType,
    right: &ResolvedType
) -> !bool {
    if left.type_id < 0 or right.type_id < 0 { return false; }
    let records = &store.records;
    let left_record = try records.at(left.type_id);
    let right_record = try records.at(right.type_id);
    if left_record.canonical_id < 0 or right_record.canonical_id < 0 {
        return error("package type has no canonical identity");
    }
    return left_record.canonical_id == right_record.canonical_id;
}

pub fn bind_substitution(
    store: &TypeStore,
    bindings: &var package_type_substitutions::Substitutions,
    owner_kind: i64,
    owner_id: i64,
    slot: i64,
    actual: &ResolvedType
) -> !void {
    if actual.type_id < 0 { return error("cannot bind unknown substitution type"); }
    let existing_id = try package_type_substitutions::lookup(
        bindings, owner_kind, owner_id, slot
    );
    if existing_id >= 0 {
        let existing = try type_at(store, existing_id);
        if try same_type(store, &existing, actual) { return; }
        return error("repeated formal substitution mismatch");
    }
    return package_type_substitutions::append(
        bindings, owner_kind, owner_id, slot, actual.type_id
    );
}

pub fn instantiate_template(
    store: &var TypeStore,
    template: &ResolvedType,
    bindings: &package_type_substitutions::Substitutions
) -> !ResolvedType {
    if template.type_id < 0 { return error("cannot instantiate unknown type template"); }
    let records = &store.records;
    let record = try records.at(template.type_id);
    if template.kind == type_kind_formal() {
        let actual_id = try package_type_substitutions::lookup(
            bindings, record.formal_owner_kind,
            record.formal_owner_id, record.formal_slot
        );
        if actual_id < 0 { return error("generic type formal has no exact substitution"); }
        return type_at(store, actual_id);
    }
    let intrinsic = record.intrinsic_kind;
    let declaration_index = record.declaration_index;
    let declaration_component_id = record.declaration_component_id;
    let spelling_component_id = record.spelling_component_id;
    let formal_owner_kind = record.formal_owner_kind;
    let formal_owner_id = record.formal_owner_id;
    let formal_slot = record.formal_slot;
    let child_len = record.child_len;
    if child_len == 0 { return copy(template); }
    var children = std::array::Array<i64>(std::mem::page_allocator());
    defer children.deinit();
    var index = 0;
    var changed = false;
    while index < child_len {
        let child = try type_child(store, template, index);
        let instantiated = try instantiate_template(store, &child, bindings);
        if instantiated.type_id != child.type_id { changed = true; }
        try children.append(instantiated.type_id);
        index = index + 1;
    }
    if !changed { return copy(template); }
    return intern_type_record(
        store, template.kind, template.full_spelling, template.constructor_name,
        intrinsic, declaration_index, declaration_component_id,
        spelling_component_id, formal_owner_kind, formal_owner_id,
        formal_slot, &children
    );
}

impl TypeStore {
    fn deinit(self: TypeStore) -> void {
        self.canonical_records.deinit();
        self.canonical_child_ids.deinit();
        self.canonical_index_entries.deinit();
        self.type_index_entries.deinit();
        self.intrinsic_leaf_type_ids.deinit();
        self.records.deinit();
        self.record_child_type_ids.deinit();
        return;
    }
}

impl CanonicalTypeFacts {
    fn deinit(self: CanonicalTypeFacts) -> void {
        self.records.deinit();
        self.child_ids.deinit();
        return;
    }
}
