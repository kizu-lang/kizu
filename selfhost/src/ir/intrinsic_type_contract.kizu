import selfhost::abi::fixed_abi_contract;

// IntrinsicTypeContract is the dependency-neutral semantic identity shared by
// the package TypeStore, fact-token canonicalization, and ABI fact emission.
// Source aliases such as Channel are accepted only here; every emitted fact
// uses the canonical identity returned by canonical_name.

pub fn kind_void() -> i64 { return 1; }
pub fn kind_bool() -> i64 { return 2; }
pub fn kind_i8() -> i64 { return 3; }
pub fn kind_i16() -> i64 { return 4; }
pub fn kind_i32() -> i64 { return 5; }
pub fn kind_i64() -> i64 { return 6; }
pub fn kind_u8() -> i64 { return 7; }
pub fn kind_u16() -> i64 { return 8; }
pub fn kind_u32() -> i64 { return 9; }
pub fn kind_u64() -> i64 { return 10; }
pub fn kind_usize() -> i64 { return 11; }
pub fn kind_isize() -> i64 { return 12; }
pub fn kind_f32() -> i64 { return 13; }
pub fn kind_f64() -> i64 { return 14; }
pub fn kind_allocator() -> i64 { return 20; }
pub fn kind_function() -> i64 { return 21; }
pub fn kind_io() -> i64 { return 22; }
pub fn kind_ptr() -> i64 { return 23; }
pub fn kind_meta_type() -> i64 { return 24; }
pub fn kind_array() -> i64 { return 30; }
pub fn kind_arena() -> i64 { return 31; }
pub fn kind_arena_handle() -> i64 { return 32; }
pub fn kind_map() -> i64 { return 33; }
pub fn kind_box() -> i64 { return 34; }
pub fn kind_channel() -> i64 { return 35; }
pub fn kind_atomic() -> i64 { return 36; }
pub fn kind_mutex() -> i64 { return 37; }
pub fn kind_task() -> i64 { return 38; }
pub fn kind_option() -> i64 { return 39; }
pub fn kind_task_group() -> i64 { return 40; }
pub fn kind_queue() -> i64 { return 41; }
pub fn kind_partition() -> i64 { return 42; }
pub fn kind_local_buffer() -> i64 { return 43; }
pub fn kind_error() -> i64 { return 50; }

pub fn is_signed_integer_kind(kind: i64) -> bool {
    return kind == kind_i8() or kind == kind_i16() or
        kind == kind_i32() or kind == kind_i64() or kind == kind_isize();
}

pub fn is_unsigned_integer_kind(kind: i64) -> bool {
    return kind == kind_u8() or kind == kind_u16() or
        kind == kind_u32() or kind == kind_u64() or kind == kind_usize();
}

pub fn from_source_name(name: []u8) -> i64 {
    if std::mem::equal_bytes(name, "void") { return kind_void(); }
    if std::mem::equal_bytes(name, "bool") { return kind_bool(); }
    if std::mem::equal_bytes(name, "i8") { return kind_i8(); }
    if std::mem::equal_bytes(name, "i16") { return kind_i16(); }
    if std::mem::equal_bytes(name, "i32") { return kind_i32(); }
    if std::mem::equal_bytes(name, "i64") { return kind_i64(); }
    if std::mem::equal_bytes(name, "u8") { return kind_u8(); }
    if std::mem::equal_bytes(name, "u16") { return kind_u16(); }
    if std::mem::equal_bytes(name, "u32") { return kind_u32(); }
    if std::mem::equal_bytes(name, "u64") { return kind_u64(); }
    if std::mem::equal_bytes(name, "usize") { return kind_usize(); }
    if std::mem::equal_bytes(name, "isize") { return kind_isize(); }
    if std::mem::equal_bytes(name, "f32") { return kind_f32(); }
    if std::mem::equal_bytes(name, "f64") { return kind_f64(); }
    if std::mem::equal_bytes(name, "Allocator") { return kind_allocator(); }
    if std::mem::equal_bytes(name, "Function") { return kind_function(); }
    if std::mem::equal_bytes(name, "Io") { return kind_io(); }
    if std::mem::equal_bytes(name, "ptr") { return kind_ptr(); }
    if std::mem::equal_bytes(name, "type") { return kind_meta_type(); }
    if std::mem::equal_bytes(name, "std::array::Array") { return kind_array(); }
    if std::mem::equal_bytes(name, "std::arena::Arena") { return kind_arena(); }
    if std::mem::equal_bytes(name, "std::arena::Handle") { return kind_arena_handle(); }
    if std::mem::equal_bytes(name, "std::map::Map") { return kind_map(); }
    if std::mem::equal_bytes(name, "std::mem::Box") { return kind_box(); }
    if std::mem::equal_bytes(name, "Channel") or
        std::mem::equal_bytes(name, "std::channel::Channel") { return kind_channel(); }
    if std::mem::equal_bytes(name, "Atomic") or
        std::mem::equal_bytes(name, "std::atomic::Atomic") { return kind_atomic(); }
    if std::mem::equal_bytes(name, "Mutex") { return kind_mutex(); }
    if std::mem::equal_bytes(name, "Task") { return kind_task(); }
    if std::mem::equal_bytes(name, "option") { return kind_option(); }
    if std::mem::equal_bytes(name, "TaskGroup") { return kind_task_group(); }
    if std::mem::equal_bytes(name, "Queue") { return kind_queue(); }
    if std::mem::equal_bytes(name, "Partition") { return kind_partition(); }
    if std::mem::equal_bytes(name, "LocalBuffer") { return kind_local_buffer(); }
    return -1;
}

pub fn canonical_name(kind: i64) -> ![]u8 {
    if kind == kind_void() { return "void"; }
    if kind == kind_bool() { return "bool"; }
    if kind == kind_i8() { return "i8"; }
    if kind == kind_i16() { return "i16"; }
    if kind == kind_i32() { return "i32"; }
    if kind == kind_i64() { return "i64"; }
    if kind == kind_u8() { return "u8"; }
    if kind == kind_u16() { return "u16"; }
    if kind == kind_u32() { return "u32"; }
    if kind == kind_u64() { return "u64"; }
    if kind == kind_usize() { return "usize"; }
    if kind == kind_isize() { return "isize"; }
    if kind == kind_f32() { return "f32"; }
    if kind == kind_f64() { return "f64"; }
    if kind == kind_allocator() { return "Allocator"; }
    if kind == kind_function() { return "Function"; }
    if kind == kind_io() { return "Io"; }
    if kind == kind_ptr() { return "ptr"; }
    if kind == kind_meta_type() { return "type"; }
    if kind == kind_array() { return "std::array::Array"; }
    if kind == kind_arena() { return "std::arena::Arena"; }
    if kind == kind_arena_handle() { return "std::arena::Handle"; }
    if kind == kind_map() { return "std::map::Map"; }
    if kind == kind_box() { return "std::mem::Box"; }
    if kind == kind_channel() { return "std::channel::Channel"; }
    if kind == kind_atomic() { return "std::atomic::Atomic"; }
    if kind == kind_mutex() { return "Mutex"; }
    if kind == kind_task() { return "Task"; }
    if kind == kind_option() { return "option"; }
    if kind == kind_task_group() { return "TaskGroup"; }
    if kind == kind_queue() { return "Queue"; }
    if kind == kind_partition() { return "Partition"; }
    if kind == kind_local_buffer() { return "LocalBuffer"; }
    if kind == kind_error() { return "error"; }
    return error("intrinsic type contract: invalid kind");
}

pub fn arity(kind: i64) -> i64 {
    if kind == kind_map() { return 2; }
    if kind == kind_ptr() or (kind >= kind_array() and kind <= kind_option()) {
        return 1;
    }
    return 0;
}

// External ABI representations are owned here as semantic contracts, not by
// source declarations. A declaration emitter must suppress its nominal layout
// facts when this lookup succeeds, so one identity never has two competing
// representation owners.
pub enum ExternalAbiDependence {
    Fixed,
    TypeArguments,
}

pub struct ExternalAbiContract {
    pub identity: []u8,
    pub fixed_abi: fixed_abi_contract::FixedAbi,
    pub generic_arity: i64,
    pub dependence: ExternalAbiDependence,
    pub nullable: bool,
    pub owned_family: []u8,
}

pub fn external_abi_len() -> i64 { return 12; }

// external_abi_contract_at is the single index-owned table for external
// semantic identity and ABI capabilities. Constructor-wide abi-repr facts are
// valid only for Fixed dependence; a future type-argument-dependent ABI must
// use application-specific facts instead of adding another parallel table.
pub fn external_abi_contract_at(index: i64) -> !ExternalAbiContract {
    if index == 0 {
        return try intrinsic_external_abi_contract(
            kind_allocator(), fixed_abi_contract::FixedAbiKind::Owned,
            false, ""
        );
    }
    if index == 1 {
        return try intrinsic_external_abi_contract(
            kind_io(), fixed_abi_contract::FixedAbiKind::Owned, false, ""
        );
    }
    if index == 2 {
        return try intrinsic_external_abi_contract(
            kind_array(), fixed_abi_contract::FixedAbiKind::Owned,
            false, "sequence"
        );
    }
    if index == 3 {
        return try intrinsic_external_abi_contract(
            kind_map(), fixed_abi_contract::FixedAbiKind::Owned, false, "map"
        );
    }
    if index == 4 {
        return try intrinsic_external_abi_contract(
            kind_arena(), fixed_abi_contract::FixedAbiKind::Owned,
            false, "sequence"
        );
    }
    if index == 5 {
        return try intrinsic_external_abi_contract(
            kind_arena_handle(), fixed_abi_contract::FixedAbiKind::Handle,
            false, ""
        );
    }
    if index == 6 {
        return try intrinsic_external_abi_contract(
            kind_box(), fixed_abi_contract::FixedAbiKind::Owned, false, "box"
        );
    }
    if index == 7 {
        return try intrinsic_external_abi_contract(
            kind_atomic(), fixed_abi_contract::FixedAbiKind::Pointer, false, ""
        );
    }
    if index == 8 {
        return try intrinsic_external_abi_contract(
            kind_channel(), fixed_abi_contract::FixedAbiKind::Pointer, false, ""
        );
    }
    if index == 9 {
        return external_abi_contract(
            "std::string::String", fixed_abi_contract::FixedAbiKind::Owned,
            0, false, "string"
        );
    }
    if index == 10 {
        return try intrinsic_external_abi_contract(
            kind_ptr(), fixed_abi_contract::FixedAbiKind::Pointer, true, ""
        );
    }
    if index == 11 {
        return external_abi_contract(
            "[]u8", fixed_abi_contract::FixedAbiKind::SliceU8, 0, false, ""
        );
    }
    return error("intrinsic type contract: external ABI index out of range");
}

fn intrinsic_external_abi_contract(
    intrinsic_kind: i64,
    abi_kind: fixed_abi_contract::FixedAbiKind,
    nullable: bool,
    owned_family: []u8
) -> !ExternalAbiContract {
    return external_abi_contract(
        try canonical_name(intrinsic_kind), abi_kind, arity(intrinsic_kind),
        nullable, owned_family
    );
}

fn external_abi_contract(
    identity: []u8,
    abi_kind: fixed_abi_contract::FixedAbiKind,
    generic_arity: i64,
    nullable: bool,
    owned_family: []u8
) -> ExternalAbiContract {
    return ExternalAbiContract {
        identity: identity,
        fixed_abi: fixed_abi_contract::describe(abi_kind),
        generic_arity: generic_arity,
        dependence: ExternalAbiDependence::Fixed,
        nullable: nullable,
        owned_family: owned_family
    };
}

pub fn has_external_abi_declaration(
    module_prefix: []u8,
    local_name: []u8
) -> !bool {
    let declaration_len = std::mem::len(module_prefix) + std::mem::len(local_name);
    var index = 0;
    while index < external_abi_len() {
        let entry = try external_abi_contract_at(index);
        let identity = entry.identity;
        if std::mem::len(identity) == declaration_len and
            std::mem::starts_with(identity, module_prefix) and
            std::mem::equal_bytes(
                identity[std::mem::len(module_prefix)..declaration_len], local_name
            ) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn external_identity_matches_declaration(
    identity: []u8,
    package_name: []u8,
    component_name: []u8,
    local_name: []u8
) -> bool {
    var expected_len =
        std::mem::len(package_name) + 2 +
        std::mem::len(component_name) + 2 +
        std::mem::len(local_name);
    var component_index = 0;
    while component_index < std::mem::len(component_name) {
        if component_name[component_index] == cast<u8>(47) {
            expected_len = expected_len + 1;
        }
        component_index = component_index + 1;
    }
    if std::mem::len(identity) != expected_len or
        !std::mem::starts_with(identity, package_name) {
        return false;
    }
    var identity_index = std::mem::len(package_name);
    if identity[identity_index] != cast<u8>(58) or
        identity[identity_index + 1] != cast<u8>(58) {
        return false;
    }
    identity_index = identity_index + 2;
    component_index = 0;
    while component_index < std::mem::len(component_name) {
        let byte = component_name[component_index];
        if byte == cast<u8>(47) {
            if identity[identity_index] != cast<u8>(58) or
                identity[identity_index + 1] != cast<u8>(58) {
                return false;
            }
            identity_index = identity_index + 2;
        } else {
            if identity[identity_index] != byte { return false; }
            identity_index = identity_index + 1;
        }
        component_index = component_index + 1;
    }
    if identity[identity_index] != cast<u8>(58) or
        identity[identity_index + 1] != cast<u8>(58) {
        return false;
    }
    identity_index = identity_index + 2;
    return std::mem::equal_bytes(
        identity[identity_index..std::mem::len(identity)], local_name
    );
}

pub fn external_abi_owned_family_for_declaration(
    package_name: []u8,
    component_name: []u8,
    local_name: []u8
) -> ![]u8 {
    var index = 0;
    while index < external_abi_len() {
        let entry = try external_abi_contract_at(index);
        if external_identity_matches_declaration(
            entry.identity, package_name, component_name, local_name
        ) {
            return entry.owned_family;
        }
        index = index + 1;
    }
    return "";
}
