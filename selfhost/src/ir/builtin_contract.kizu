import selfhost::abi::semantic_signature;

// BuiltinContract is the dependency-neutral identity shared by package call
// resolution and compiled fact consumers. Operation IDs, emitted names, valid
// kinds, and identity requirements have exactly one owner here.
pub struct BuiltinKind {
    pub found: bool,
    pub id: i64,
    pub name: []u8,
}

pub struct BuiltinOperation {
    pub found: bool,
    pub id: i64,
    pub kind: i64,
    pub name: []u8,
    pub requires_identity: bool,
}

pub enum LanguageBuiltinLowering { None, Print, }

pub struct LanguageBuiltinAbi {
    pub found: bool,
    pub param_count: i64,
    pub lowering: LanguageBuiltinLowering,
}

pub enum PrintRuntimeTransport {
    Unsupported,
    SliceU8,
    SignedInteger,
    UnsignedInteger,
    Bool,
}

pub struct PrintRuntimeAbi {
    pub found: bool,
    pub symbol: []u8,
    pub transport: PrintRuntimeTransport,
}

// FreeRuntimeAbi is the backend-neutral contract for a non-package runtime
// call. The descriptor owns the runtime symbol and the semantic source-argument
// schema together, so call classification cannot acquire a symbol without the
// matching argument contract. Physical LLVM types remain owned by the canonical
// type/external-ABI facts consumed by the backend.
pub struct FreeRuntimeAbi {
    pub found: bool,
    pub symbol: []u8,
    pub arg_schema: i64,
}

// RuntimeMethodAbi is the backend-neutral ABI for a receiver builtin. The
// receiver itself is intentionally absent from arg_schema: lowering derives its
// ABI from the call-site TypeId, then appends these ordered explicit source
// arguments. A selector may retain its semantic type while choosing an erased
// runtime storage class at the physical call boundary.
pub struct RuntimeMethodAbi {
    pub found: bool,
    pub symbol: []u8,
    pub return_selector: RuntimeTypeSelector,
    pub param_count: i64,
    pub param0: RuntimeTypeSelector,
    pub param1: RuntimeTypeSelector,
    pub result_transport: RuntimeResultTransport,
}

pub enum RuntimeTypeSelectorKind { None, Fixed, ReceiverChild, }
pub enum RuntimeStorageClass { Semantic, ScalarI64, ByteView, }
pub enum RuntimeResultTransport { Semantic, ByteView, ErrorByteView, }

pub struct RuntimeTypeSelector {
    pub kind: RuntimeTypeSelectorKind,
    pub fixed_type: []u8,
    pub receiver_child_slot: i64,
    pub storage_class: RuntimeStorageClass,
}

// OwnedContainerOperation is the backend-neutral lowering family attached to
// builtin operations that create or destroy an owned runtime handle. Callers
// consume this numeric descriptor after exact call resolution; they must not
// recover the family from a receiver or callee spelling.
pub struct OwnedContainerOperation {
    pub found: bool,
    pub action: i64,
    pub family: i64,
}

// OwnedContainerConstructor is the canonical constructor capability for an
// owned family. It is independent of runtime operations: a source constructor
// must never borrow a deinit operation merely to prove its lowering family.
pub struct OwnedContainerConstructor {
    pub found: bool,
    pub action: i64,
    pub family: i64,
}

pub struct OwnedContainerConstructorRuntime {
    pub found: bool,
    pub symbol: []u8,
    // Ordered source type-argument slot whose concrete LLVM sizeof is passed
    // after the allocator. -1 means this runtime constructor takes no size.
    pub type_size_argument_slot: i64,
}

pub fn owned_container_action_none() -> i64 { return 0; }
pub fn owned_container_action_construct() -> i64 { return 1; }
pub fn owned_container_action_deinit() -> i64 { return 2; }
pub fn owned_container_family_none() -> i64 { return 0; }
pub fn owned_container_family_sequence() -> i64 { return 1; }
pub fn owned_container_family_string() -> i64 { return 2; }
pub fn owned_container_family_map() -> i64 { return 3; }
pub fn owned_container_family_box() -> i64 { return 4; }


pub fn owned_container_action_name(action: i64) -> ![]u8 {
    if action == owned_container_action_construct() { return "construct"; }
    if action == owned_container_action_deinit() { return "deinit"; }
    return error("builtin contract: invalid owned-container action");
}

pub fn owned_container_action_from_name(name: []u8) -> i64 {
    if std::mem::equal_bytes(name, "construct") {
        return owned_container_action_construct();
    }
    if std::mem::equal_bytes(name, "deinit") {
        return owned_container_action_deinit();
    }
    return owned_container_action_none();
}

pub fn owned_container_family_name(family: i64) -> ![]u8 {
    if family == owned_container_family_sequence() { return "sequence"; }
    if family == owned_container_family_string() { return "string"; }
    if family == owned_container_family_map() { return "map"; }
    if family == owned_container_family_box() { return "box"; }
    return error("builtin contract: invalid owned-container family");
}

pub fn owned_container_family_from_name(name: []u8) -> i64 {
    if std::mem::equal_bytes(name, "sequence") { return owned_container_family_sequence(); }
    if std::mem::equal_bytes(name, "string") { return owned_container_family_string(); }
    if std::mem::equal_bytes(name, "map") { return owned_container_family_map(); }
    if std::mem::equal_bytes(name, "box") { return owned_container_family_box(); }
    return owned_container_family_none();
}

pub fn kind_none() -> i64 { return 0; }
pub fn kind_language() -> i64 { return 1; }
pub fn kind_runtime() -> i64 { return 2; }
pub fn kind_external_shape() -> i64 { return 3; }
pub fn kind_max_id() -> i64 { return kind_external_shape(); }

pub fn operation_none() -> i64 { return 0; }
pub fn operation_print() -> i64 { return 1; }
pub fn operation_error() -> i64 { return 2; }
pub fn operation_union_construct() -> i64 { return 3; }
pub fn operation_arena_new() -> i64 { return 4; }
pub fn operation_ptr_from_int() -> i64 { return 5; }
pub fn operation_int_from_ptr() -> i64 { return 6; }
pub fn operation_array_append() -> i64 { return 20; }
pub fn operation_array_len() -> i64 { return 21; }
pub fn operation_array_capacity() -> i64 { return 22; }
pub fn operation_array_pop() -> i64 { return 23; }
pub fn operation_array_get() -> i64 { return 24; }
pub fn operation_array_get_or_panic() -> i64 { return 25; }
pub fn operation_array_at() -> i64 { return 26; }
pub fn operation_array_at_mut() -> i64 { return 27; }
pub fn operation_array_set() -> i64 { return 28; }
pub fn operation_array_reserve() -> i64 { return 29; }
pub fn operation_array_truncate() -> i64 { return 30; }
pub fn operation_array_clear() -> i64 { return 31; }
pub fn operation_array_as_bytes() -> i64 { return 32; }
pub fn operation_array_deinit() -> i64 { return 33; }
pub fn operation_array_pop_or_panic() -> i64 { return 34; }
pub fn operation_arena_add() -> i64 { return 40; }
pub fn operation_arena_get() -> i64 { return 41; }
pub fn operation_arena_deinit() -> i64 { return 42; }
pub fn operation_string_append_bytes() -> i64 { return 50; }
pub fn operation_string_append_byte() -> i64 { return 51; }
pub fn operation_string_reserve() -> i64 { return 52; }
pub fn operation_string_len() -> i64 { return 53; }
pub fn operation_string_capacity() -> i64 { return 54; }
pub fn operation_string_as_bytes() -> i64 { return 55; }
pub fn operation_string_clear() -> i64 { return 56; }
pub fn operation_string_truncate() -> i64 { return 57; }
pub fn operation_string_deinit() -> i64 { return 58; }
pub fn operation_map_insert() -> i64 { return 60; }
pub fn operation_map_get() -> i64 { return 61; }
pub fn operation_map_contains() -> i64 { return 62; }
pub fn operation_map_len() -> i64 { return 63; }
pub fn operation_map_deinit() -> i64 { return 64; }
pub fn operation_box_borrow() -> i64 { return 70; }
pub fn operation_box_borrow_mut() -> i64 { return 71; }
pub fn operation_box_deinit() -> i64 { return 72; }
pub fn operation_channel_send() -> i64 { return 80; }
pub fn operation_channel_recv() -> i64 { return 81; }
pub fn operation_channel_close() -> i64 { return 82; }
pub fn operation_atomic_load() -> i64 { return 90; }
pub fn operation_atomic_store() -> i64 { return 91; }
pub fn operation_mutex_get() -> i64 { return 92; }
pub fn operation_task_spawn() -> i64 { return 100; }
pub fn operation_task_await() -> i64 { return 101; }
pub fn operation_task_cancel() -> i64 { return 102; }
pub fn operation_queue_enqueue() -> i64 { return 103; }
pub fn operation_queue_drain() -> i64 { return 104; }
pub fn operation_partition_at() -> i64 { return 105; }
pub fn operation_local_buffer_get() -> i64 { return 106; }
pub fn operation_max_id() -> i64 { return operation_local_buffer_get(); }

pub fn language_builtin_abi(operation_id: i64) -> LanguageBuiltinAbi {
    if operation_id == operation_print() {
        return LanguageBuiltinAbi {
            found: true,
            param_count: 1,
            lowering: LanguageBuiltinLowering::Print
        };
    }
    return LanguageBuiltinAbi {
        found: false,
        param_count: 0,
        lowering: LanguageBuiltinLowering::None
    };
}

pub fn print_runtime_abi(transport: PrintRuntimeTransport) -> PrintRuntimeAbi {
    if transport == PrintRuntimeTransport::SliceU8 {
        return PrintRuntimeAbi {
            found: true, symbol: "kizu_print_string", transport: transport
        };
    }
    if transport == PrintRuntimeTransport::SignedInteger or
        transport == PrintRuntimeTransport::UnsignedInteger {
        return PrintRuntimeAbi {
            found: true, symbol: "kizu_print_int", transport: transport
        };
    }
    if transport == PrintRuntimeTransport::Bool {
        return PrintRuntimeAbi {
            found: true, symbol: "kizu_print_bool", transport: transport
        };
    }
    return PrintRuntimeAbi {
        found: false, symbol: "", transport: PrintRuntimeTransport::Unsupported
    };
}

fn known_kind(id: i64, name: []u8) -> BuiltinKind {
    return BuiltinKind { found: true, id: id, name: name };
}

fn unknown_kind() -> BuiltinKind {
    return BuiltinKind { found: false, id: -1, name: "" };
}

pub fn kind(id: i64) -> BuiltinKind {
    if id == kind_language() { return known_kind(id, "language"); }
    if id == kind_runtime() { return known_kind(id, "runtime"); }
    if id == kind_external_shape() { return known_kind(id, "external-shape"); }
    return unknown_kind();
}

pub fn kind_from_name(name: []u8) -> i64 {
    var id = kind_language();
    while id <= kind_max_id() {
        let candidate = kind(id);
        if candidate.found and std::mem::equal_bytes(candidate.name, name) {
            return candidate.id;
        }
        id = id + 1;
    }
    return -1;
}

pub fn kind_name(id: i64) -> ![]u8 {
    let candidate = kind(id);
    if !candidate.found { return error("builtin contract: invalid kind"); }
    return candidate.name;
}

fn known_operation(
    id: i64,
    kind_id: i64,
    name: []u8,
    requires_identity: bool
) -> BuiltinOperation {
    return BuiltinOperation {
        found: true,
        id: id,
        kind: kind_id,
        name: name,
        requires_identity: requires_identity
    };
}

fn unknown_operation() -> BuiltinOperation {
    return BuiltinOperation {
        found: false,
        id: -1,
        kind: kind_none(),
        name: "",
        requires_identity: false
    };
}

pub fn operation(id: i64) -> BuiltinOperation {
    if id == operation_none() { return known_operation(id, kind_runtime(), "free-runtime", true); }
    if id == operation_print() { return known_operation(id, kind_language(), "print", false); }
    if id == operation_error() { return known_operation(id, kind_language(), "error", false); }
    if id == operation_union_construct() { return known_operation(id, kind_external_shape(), "union-construct", false); }
    if id == operation_arena_new() { return known_operation(id, kind_external_shape(), "arena-new", false); }
    if id == operation_ptr_from_int() { return known_operation(id, kind_language(), "ptr-from-int", false); }
    if id == operation_int_from_ptr() { return known_operation(id, kind_language(), "int-from-ptr", false); }
    if id == operation_array_append() { return known_operation(id, kind_runtime(), "array-append", false); }
    if id == operation_array_len() { return known_operation(id, kind_runtime(), "array-len", false); }
    if id == operation_array_capacity() { return known_operation(id, kind_runtime(), "array-capacity", false); }
    if id == operation_array_pop() { return known_operation(id, kind_runtime(), "array-pop", false); }
    if id == operation_array_get() { return known_operation(id, kind_runtime(), "array-get", false); }
    if id == operation_array_get_or_panic() { return known_operation(id, kind_runtime(), "array-get-or-panic", false); }
    if id == operation_array_at() { return known_operation(id, kind_runtime(), "array-at", false); }
    if id == operation_array_at_mut() { return known_operation(id, kind_runtime(), "array-at-mut", false); }
    if id == operation_array_set() { return known_operation(id, kind_runtime(), "array-set", false); }
    if id == operation_array_reserve() { return known_operation(id, kind_runtime(), "array-reserve", false); }
    if id == operation_array_truncate() { return known_operation(id, kind_runtime(), "array-truncate", false); }
    if id == operation_array_clear() { return known_operation(id, kind_runtime(), "array-clear", false); }
    if id == operation_array_as_bytes() { return known_operation(id, kind_runtime(), "array-as-bytes", false); }
    if id == operation_array_deinit() { return known_operation(id, kind_runtime(), "array-deinit", false); }
    if id == operation_array_pop_or_panic() {
        return known_operation(id, kind_runtime(), "array-pop-or-panic", false);
    }
    if id == operation_arena_add() { return known_operation(id, kind_runtime(), "arena-add", false); }
    if id == operation_arena_get() { return known_operation(id, kind_runtime(), "arena-get", false); }
    if id == operation_arena_deinit() { return known_operation(id, kind_runtime(), "arena-deinit", false); }
    if id == operation_string_append_bytes() { return known_operation(id, kind_runtime(), "string-append-bytes", false); }
    if id == operation_string_append_byte() { return known_operation(id, kind_runtime(), "string-append-byte", false); }
    if id == operation_string_reserve() { return known_operation(id, kind_runtime(), "string-reserve", false); }
    if id == operation_string_len() { return known_operation(id, kind_runtime(), "string-len", false); }
    if id == operation_string_capacity() { return known_operation(id, kind_runtime(), "string-capacity", false); }
    if id == operation_string_as_bytes() { return known_operation(id, kind_runtime(), "string-as-bytes", false); }
    if id == operation_string_clear() { return known_operation(id, kind_runtime(), "string-clear", false); }
    if id == operation_string_truncate() { return known_operation(id, kind_runtime(), "string-truncate", false); }
    if id == operation_string_deinit() { return known_operation(id, kind_runtime(), "string-deinit", false); }
    if id == operation_map_insert() { return known_operation(id, kind_runtime(), "map-insert", false); }
    if id == operation_map_get() { return known_operation(id, kind_runtime(), "map-get", false); }
    if id == operation_map_contains() { return known_operation(id, kind_runtime(), "map-contains", false); }
    if id == operation_map_len() { return known_operation(id, kind_runtime(), "map-len", false); }
    if id == operation_map_deinit() { return known_operation(id, kind_runtime(), "map-deinit", false); }
    if id == operation_box_borrow() { return known_operation(id, kind_runtime(), "box-borrow", false); }
    if id == operation_box_borrow_mut() { return known_operation(id, kind_runtime(), "box-borrow-mut", false); }
    if id == operation_box_deinit() { return known_operation(id, kind_runtime(), "box-deinit", false); }
    if id == operation_channel_send() { return known_operation(id, kind_runtime(), "channel-send", false); }
    if id == operation_channel_recv() { return known_operation(id, kind_runtime(), "channel-recv", false); }
    if id == operation_channel_close() { return known_operation(id, kind_runtime(), "channel-close", false); }
    if id == operation_atomic_load() { return known_operation(id, kind_runtime(), "atomic-load", false); }
    if id == operation_atomic_store() { return known_operation(id, kind_runtime(), "atomic-store", false); }
    if id == operation_mutex_get() { return known_operation(id, kind_runtime(), "mutex-get", false); }
    if id == operation_task_spawn() { return known_operation(id, kind_runtime(), "task-spawn", false); }
    if id == operation_task_await() { return known_operation(id, kind_runtime(), "task-await", false); }
    if id == operation_task_cancel() { return known_operation(id, kind_runtime(), "task-cancel", false); }
    if id == operation_queue_enqueue() { return known_operation(id, kind_runtime(), "queue-enqueue", false); }
    if id == operation_queue_drain() { return known_operation(id, kind_runtime(), "queue-drain", false); }
    if id == operation_partition_at() { return known_operation(id, kind_runtime(), "partition-at", false); }
    if id == operation_local_buffer_get() { return known_operation(id, kind_runtime(), "local-buffer-get", false); }
    return unknown_operation();
}

pub fn operation_from_name(name: []u8) -> i64 {
    var id = operation_none();
    while id <= operation_max_id() {
        let candidate = operation(id);
        if candidate.found and std::mem::equal_bytes(candidate.name, name) {
            return candidate.id;
        }
        id = id + 1;
    }
    return -1;
}

pub fn operation_name(id: i64) -> ![]u8 {
    let candidate = operation(id);
    if !candidate.found { return error("builtin contract: invalid operation"); }
    return candidate.name;
}

pub fn valid_pair(kind_id: i64, operation_id: i64) -> bool {
    let kind_value = kind(kind_id);
    let operation_value = operation(operation_id);
    return kind_value.found and operation_value.found and
        operation_value.kind == kind_value.id;
}

pub fn operation_requires_identity(operation_id: i64) -> !bool {
    let candidate = operation(operation_id);
    if !candidate.found { return error("builtin contract: invalid operation"); }
    return candidate.requires_identity;
}

fn free_runtime_arg_schema_none() -> i64 { return 0; }
fn free_runtime_arg_schema_slice() -> i64 { return 1; }
fn free_runtime_arg_schema_io_slice() -> i64 { return 2; }

fn known_free_runtime_abi(symbol: []u8, arg_schema: i64) -> FreeRuntimeAbi {
    return FreeRuntimeAbi { found: true, symbol: symbol, arg_schema: arg_schema };
}

fn unknown_free_runtime_abi() -> FreeRuntimeAbi {
    return FreeRuntimeAbi { found: false, symbol: "", arg_schema: -1 };
}

// Free runtime calls have no package function target. This is their single
// closed identity-to-call-contract table. Source aliases and their canonical
// builtin spellings intentionally select the same descriptor.
pub fn free_runtime_abi(canonical_identity: []u8) -> FreeRuntimeAbi {
    if std::mem::equal_bytes(canonical_identity, "std::mem::page_allocator") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::mem_page_allocator") {
        return known_free_runtime_abi(
            "kizu_rt_mem_page_allocator", free_runtime_arg_schema_none()
        );
    }
    if std::mem::equal_bytes(canonical_identity, "std::mem::len") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::mem_len") {
        return known_free_runtime_abi(
            "kizu_selfhost__slice_len", free_runtime_arg_schema_slice()
        );
    }
    if std::mem::equal_bytes(canonical_identity, "std::fs::read_file") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::fs_read_file") {
        return known_free_runtime_abi(
            "kizu_rt_fs_read_file", free_runtime_arg_schema_io_slice()
        );
    }
    if std::mem::equal_bytes(canonical_identity, "std::io::write_stderr") or
        std::mem::equal_bytes(canonical_identity, "std::builtin::io_write_stderr") {
        return known_free_runtime_abi(
            "kizu_rt_io_write_stderr", free_runtime_arg_schema_io_slice()
        );
    }
    return unknown_free_runtime_abi();
}

pub fn free_runtime_symbol(canonical_identity: []u8) -> ![]u8 {
    let abi = free_runtime_abi(canonical_identity);
    if !abi.found { return error("builtin contract: free runtime symbol not found"); }
    return abi.symbol;
}

pub fn free_runtime_arg_count(canonical_identity: []u8) -> !i64 {
    let abi = free_runtime_abi(canonical_identity);
    if !abi.found {
        return error("builtin contract: free runtime argument ABI not found");
    }
    if abi.arg_schema == free_runtime_arg_schema_none() { return 0; }
    if abi.arg_schema == free_runtime_arg_schema_slice() { return 1; }
    if abi.arg_schema == free_runtime_arg_schema_io_slice() { return 2; }
    return error("builtin contract: invalid free runtime argument schema");
}

pub fn free_runtime_arg_type(
    canonical_identity: []u8,
    arg_index: i64
) -> ![]u8 {
    let abi = free_runtime_abi(canonical_identity);
    if !abi.found {
        return error("builtin contract: free runtime argument ABI not found");
    }
    let arg_count = try free_runtime_arg_count(canonical_identity);
    if arg_index < 0 or arg_index >= arg_count {
        return error("builtin contract: free runtime argument index out of range");
    }
    if abi.arg_schema == free_runtime_arg_schema_slice() { return "[]u8"; }
    if abi.arg_schema == free_runtime_arg_schema_io_slice() {
        if arg_index == 0 { return "Io"; }
        return "[]u8";
    }
    return error("builtin contract: invalid free runtime argument schema");
}

fn fixed_runtime_type(spelling: []u8) -> RuntimeTypeSelector {
    return RuntimeTypeSelector {
        kind: RuntimeTypeSelectorKind::Fixed,
        fixed_type: spelling, receiver_child_slot: -1,
        storage_class: RuntimeStorageClass::Semantic
    };
}

fn receiver_child_runtime_type(
    slot: i64, storage_class: RuntimeStorageClass
) -> RuntimeTypeSelector {
    return RuntimeTypeSelector {
        kind: RuntimeTypeSelectorKind::ReceiverChild,
        fixed_type: "", receiver_child_slot: slot,
        storage_class: storage_class
    };
}

fn no_runtime_type() -> RuntimeTypeSelector {
    return RuntimeTypeSelector {
        kind: RuntimeTypeSelectorKind::None,
        fixed_type: "", receiver_child_slot: -1,
        storage_class: RuntimeStorageClass::Semantic
    };
}

fn known_runtime_method_abi(
    symbol: []u8, return_type: RuntimeTypeSelector,
    param_count: i64, param0: RuntimeTypeSelector, param1: RuntimeTypeSelector,
    result_transport: RuntimeResultTransport
) -> RuntimeMethodAbi {
    return RuntimeMethodAbi {
        found: true,
        symbol: symbol,
        return_selector: return_type, param_count: param_count,
        param0: param0, param1: param1,
        result_transport: result_transport
    };
}

fn unknown_runtime_method_abi() -> RuntimeMethodAbi {
    return RuntimeMethodAbi {
        found: false,
        symbol: "",
        return_selector: no_runtime_type(), param_count: 0,
        param0: no_runtime_type(), param1: no_runtime_type(),
        result_transport: RuntimeResultTransport::Semantic
    };
}

// runtime_method_abi is keyed by the resolved builtin operation, never by a
// source method spelling. Generic argument selectors are interpreted against
// canonical call facts and then encoded with the selected runtime storage class.
pub fn runtime_method_abi(operation_id: i64) -> RuntimeMethodAbi {
    if operation_id == operation_array_len() {
        return known_runtime_method_abi(
            "kizu_rt_array_len", fixed_runtime_type("i64"), 0,
            no_runtime_type(), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_string_len() {
        return known_runtime_method_abi(
            "kizu_rt_string_len", fixed_runtime_type("i64"), 0,
            no_runtime_type(), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_array_append() {
        return known_runtime_method_abi(
            "kizu_rt_array_append", fixed_runtime_type("!void"), 1,
            receiver_child_runtime_type(0, RuntimeStorageClass::ByteView),
            no_runtime_type(), RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_array_set() {
        return known_runtime_method_abi(
            "kizu_rt_array_set", fixed_runtime_type("!void"), 2,
            fixed_runtime_type("i64"),
            receiver_child_runtime_type(0, RuntimeStorageClass::ByteView),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_string_append_bytes() {
        return known_runtime_method_abi(
            "kizu_rt_string_append_bytes", fixed_runtime_type("!void"), 1,
            fixed_runtime_type("[]u8"), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_string_append_byte() {
        return known_runtime_method_abi(
            "kizu_rt_string_append_byte", fixed_runtime_type("!void"), 1,
            fixed_runtime_type("u8"), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_string_reserve() {
        return known_runtime_method_abi(
            "kizu_rt_string_reserve", fixed_runtime_type("!void"), 1,
            fixed_runtime_type("i64"), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_string_as_bytes() {
        return known_runtime_method_abi(
            "kizu_rt_string_as_bytes", fixed_runtime_type("[]u8"), 0,
            no_runtime_type(), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_map_len() {
        return known_runtime_method_abi(
            "kizu_rt_map_len", fixed_runtime_type("i64"), 0,
            no_runtime_type(), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_array_deinit() or
        operation_id == operation_arena_deinit() or
        operation_id == operation_string_deinit() or
        operation_id == operation_map_deinit() or
        operation_id == operation_box_deinit() {
        return known_runtime_method_abi(
            "kizu_rt_owned_deinit", fixed_runtime_type("void"), 0,
            no_runtime_type(), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_array_get() or
        operation_id == operation_array_at() or
        operation_id == operation_array_at_mut() {
        return known_runtime_method_abi(
            "kizu_rt_array_at", receiver_child_runtime_type(
                0, RuntimeStorageClass::Semantic
            ), 1, fixed_runtime_type("i64"), no_runtime_type(),
            RuntimeResultTransport::ErrorByteView
        );
    }
    if operation_id == operation_map_contains() {
        return known_runtime_method_abi(
            "kizu_rt_map_contains", fixed_runtime_type("bool"), 1,
            fixed_runtime_type("[]u8"), no_runtime_type(),
            RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_map_insert() {
        return known_runtime_method_abi(
            "kizu_rt_map_insert", fixed_runtime_type("!void"), 2,
            fixed_runtime_type("[]u8"), receiver_child_runtime_type(
                1, RuntimeStorageClass::ByteView
            ), RuntimeResultTransport::Semantic
        );
    }
    if operation_id == operation_map_get() {
        return known_runtime_method_abi(
            "kizu_rt_map_get", receiver_child_runtime_type(
                1, RuntimeStorageClass::Semantic
            ), 1, fixed_runtime_type("[]u8"), no_runtime_type(),
            RuntimeResultTransport::ErrorByteView
        );
    }
    if operation_id == operation_array_pop_or_panic() {
        return known_runtime_method_abi(
            "kizu_rt_array_pop_or_panic", receiver_child_runtime_type(
                0, RuntimeStorageClass::Semantic
            ), 0, no_runtime_type(), no_runtime_type(),
            RuntimeResultTransport::ByteView
        );
    }
    // Arena.add stores the element as a byte view and answers with the arena handle that names
    // it. The handle is a representation of its own (%kizu.handle), not the i64 a length-style
    // runtime method returns, so the return selector has to say so: a caller binding the result
    // ('let raw = self.nodes.add(node);') reads its type from here.
    if operation_id == operation_arena_add() {
        return known_runtime_method_abi(
            "kizu_rt_arena_add", fixed_runtime_type("std::arena::Handle"), 1,
            receiver_child_runtime_type(0, RuntimeStorageClass::ByteView),
            no_runtime_type(), RuntimeResultTransport::Semantic
        );
    }
    return unknown_runtime_method_abi();
}

pub fn runtime_method_arg_count(operation_id: i64) -> !i64 {
    let abi = runtime_method_abi(operation_id);
    if !abi.found {
        return error("builtin contract: runtime method ABI not found");
    }
    return abi.param_count;
}

pub fn runtime_method_arg_selector(
    operation_id: i64, arg_index: i64
) -> !RuntimeTypeSelector {
    let abi = runtime_method_abi(operation_id);
    if !abi.found {
        return error("builtin contract: runtime method ABI not found");
    }
    if arg_index < 0 or arg_index >= abi.param_count {
        return error("builtin contract: runtime method argument index out of range");
    }
    if arg_index == 0 { return copy_runtime_type_selector(&abi.param0); }
    return copy_runtime_type_selector(&abi.param1);
}

pub fn copy_runtime_type_selector(
    selector: &RuntimeTypeSelector
) -> RuntimeTypeSelector {
    return RuntimeTypeSelector {
        kind: selector.kind,
        fixed_type: selector.fixed_type,
        receiver_child_slot: selector.receiver_child_slot,
        storage_class: selector.storage_class
    };
}

pub fn owned_container_operation(operation_id: i64) -> OwnedContainerOperation {
    if operation_id == operation_arena_new() {
        return OwnedContainerOperation {
            found: true,
            action: owned_container_action_construct(),
            family: owned_container_family_sequence()
        };
    }
    if operation_id == operation_array_deinit() {
        return OwnedContainerOperation {
            found: true,
            action: owned_container_action_deinit(),
            family: owned_container_family_sequence()
        };
    }
    if operation_id == operation_arena_deinit() {
        return OwnedContainerOperation {
            found: true,
            action: owned_container_action_deinit(),
            family: owned_container_family_sequence()
        };
    }
    if operation_id == operation_string_deinit() {
        return OwnedContainerOperation {
            found: true,
            action: owned_container_action_deinit(),
            family: owned_container_family_string()
        };
    }
    if operation_id == operation_map_deinit() {
        return OwnedContainerOperation {
            found: true,
            action: owned_container_action_deinit(),
            family: owned_container_family_map()
        };
    }
    if operation_id == operation_box_deinit() {
        return OwnedContainerOperation {
            found: true,
            action: owned_container_action_deinit(),
            family: owned_container_family_box()
        };
    }
    return OwnedContainerOperation {
        found: false,
        action: owned_container_action_none(),
        family: owned_container_family_none()
    };
}

pub fn owned_container_constructor(family: i64) -> OwnedContainerConstructor {
    if family == owned_container_family_sequence() or
        family == owned_container_family_string() or
        family == owned_container_family_map() or
        family == owned_container_family_box() {
        return OwnedContainerConstructor {
            found: true,
            action: owned_container_action_construct(),
            family: family
        };
    }
    return OwnedContainerConstructor {
        found: false,
        action: owned_container_action_none(),
        family: owned_container_family_none()
    };
}

// owned_container_constructor_runtime describes only constructor call shapes
// implemented by the compiled runtime boundary. Families with a different
// source ABI (for example Box, which also carries a payload and is fallible)
// remain fail-closed until their own descriptor is added.
pub fn owned_container_constructor_runtime(
    family: i64
) -> OwnedContainerConstructorRuntime {
    if family == owned_container_family_sequence() {
        return OwnedContainerConstructorRuntime {
            found: true,
            symbol: "kizu_rt_array_new",
            type_size_argument_slot: 0
        };
    }
    if family == owned_container_family_map() {
        return OwnedContainerConstructorRuntime {
            found: true,
            symbol: "kizu_rt_map_new",
            type_size_argument_slot: 1
        };
    }
    return OwnedContainerConstructorRuntime {
        found: false,
        symbol: "",
        type_size_argument_slot: -1
    };
}

pub fn valid_pairs_gate() -> !void {
    var kind_id = kind_language();
    while kind_id <= kind_max_id() {
        let candidate_kind = kind(kind_id);
        std::testing::expect(candidate_kind.found);
        std::testing::expect(kind_from_name(candidate_kind.name) == kind_id);
        kind_id = kind_id + 1;
    }
    var operation_id = operation_none();
    while operation_id <= operation_max_id() {
        let candidate_operation = operation(operation_id);
        if candidate_operation.found {
            std::testing::expect(valid_pair(candidate_operation.kind, operation_id));
            std::testing::expect(
                operation_from_name(candidate_operation.name) == operation_id
            );
            std::testing::expect(
                (try operation_requires_identity(operation_id)) ==
                    candidate_operation.requires_identity
            );
        }
        operation_id = operation_id + 1;
    }
    std::testing::expect(valid_pair(kind_language(), operation_print()));
    let print_builtin = language_builtin_abi(operation_print());
    std::testing::expect(print_builtin.found);
    std::testing::expect(print_builtin.param_count == 1);
    std::testing::expect(
        print_builtin.lowering == LanguageBuiltinLowering::Print
    );
    std::testing::expect_equal<[]u8>(
        "kizu_print_string",
        print_runtime_abi(PrintRuntimeTransport::SliceU8).symbol
    );
    std::testing::expect_equal<[]u8>(
        "kizu_print_int",
        print_runtime_abi(PrintRuntimeTransport::SignedInteger).symbol
    );
    std::testing::expect_equal<[]u8>(
        "kizu_print_int",
        print_runtime_abi(PrintRuntimeTransport::UnsignedInteger).symbol
    );
    std::testing::expect_equal<[]u8>(
        "kizu_print_bool",
        print_runtime_abi(PrintRuntimeTransport::Bool).symbol
    );
    std::testing::expect(valid_pair(kind_runtime(), operation_none()));
    std::testing::expect(valid_pair(kind_runtime(), operation_channel_recv()));
    std::testing::expect(valid_pair(kind_external_shape(), operation_union_construct()));
    std::testing::expect_equal<[]u8>("channel-recv", try operation_name(operation_channel_recv()));
    std::testing::expect(operation_from_name("channel-recv") == operation_channel_recv());
    std::testing::expect_equal<[]u8>("runtime", try kind_name(kind_runtime()));
    std::testing::expect(kind_from_name("runtime") == kind_runtime());
    std::testing::expect(try operation_requires_identity(operation_none()));
    let arena_new = owned_container_operation(operation_arena_new());
    std::testing::expect(arena_new.found);
    std::testing::expect(arena_new.action == owned_container_action_construct());
    std::testing::expect(arena_new.family == owned_container_family_sequence());
    std::testing::expect_equal<[]u8>(
        "sequence", try owned_container_family_name(arena_new.family)
    );
    std::testing::expect(
        owned_container_family_from_name("sequence") == arena_new.family
    );
    let sequence_constructor = owned_container_constructor(
        owned_container_family_sequence()
    );
    std::testing::expect(sequence_constructor.found);
    std::testing::expect(
        sequence_constructor.action == owned_container_action_construct()
    );
    std::testing::expect_equal<[]u8>(
        "construct", try owned_container_action_name(sequence_constructor.action)
    );
    std::testing::expect(
        owned_container_action_from_name("construct") == sequence_constructor.action
    );
    let array_deinit = owned_container_operation(operation_array_deinit());
    std::testing::expect(array_deinit.found);
    std::testing::expect(array_deinit.action == owned_container_action_deinit());
    let arena_deinit = owned_container_operation(operation_arena_deinit());
    std::testing::expect(arena_deinit.found);
    std::testing::expect(arena_deinit.action == owned_container_action_deinit());
    let contains_abi = runtime_method_abi(operation_map_contains());
    std::testing::expect(contains_abi.found);
    std::testing::expect_equal<[]u8>("kizu_rt_map_contains", contains_abi.symbol);
    std::testing::expect(
        contains_abi.return_selector.kind == RuntimeTypeSelectorKind::Fixed
    );
    std::testing::expect_equal<[]u8>(
        "bool", contains_abi.return_selector.fixed_type
    );
    std::testing::expect(try runtime_method_arg_count(operation_map_contains()) == 1);
    std::testing::expect_equal<[]u8>(
        "[]u8", (try runtime_method_arg_selector(
            operation_map_contains(), 0
        )).fixed_type
    );
    let array_len_abi = runtime_method_abi(operation_array_len());
    std::testing::expect(array_len_abi.found);
    std::testing::expect_equal<[]u8>(
        "kizu_rt_array_len", array_len_abi.symbol
    );
    std::testing::expect(
        try runtime_method_arg_count(operation_array_len()) == 0
    );
    let string_len_abi = runtime_method_abi(operation_string_len());
    std::testing::expect(string_len_abi.found);
    std::testing::expect_equal<[]u8>(
        "kizu_rt_string_len", string_len_abi.symbol
    );
    let get_abi = runtime_method_abi(operation_map_get());
    std::testing::expect(get_abi.found);
    std::testing::expect_equal<[]u8>("kizu_rt_map_get", get_abi.symbol);
    std::testing::expect(
        get_abi.return_selector.kind == RuntimeTypeSelectorKind::ReceiverChild
    );
    std::testing::expect(get_abi.return_selector.receiver_child_slot == 1);
    std::testing::expect(
        get_abi.result_transport == RuntimeResultTransport::ErrorByteView
    );
    std::testing::expect(try runtime_method_arg_count(operation_map_get()) == 1);
    let pop_abi = runtime_method_abi(operation_array_pop_or_panic());
    std::testing::expect(pop_abi.found);
    std::testing::expect_equal<[]u8>(
        "kizu_rt_array_pop_or_panic", pop_abi.symbol
    );
    std::testing::expect(
        pop_abi.return_selector.kind ==
            RuntimeTypeSelectorKind::ReceiverChild
    );
    std::testing::expect(
        pop_abi.return_selector.receiver_child_slot == 0
    );
    std::testing::expect(
        pop_abi.result_transport == RuntimeResultTransport::ByteView
    );
    std::testing::expect(
        try runtime_method_arg_count(operation_array_pop_or_panic()) == 0
    );
    return;
}

pub fn invalid_pairs_gate() -> !void {
    std::testing::expect(!valid_pair(kind_language(), operation_array_len()));
    std::testing::expect(!valid_pair(kind_runtime(), operation_print()));
    std::testing::expect(!valid_pair(kind_external_shape(), operation_arena_add()));
    std::testing::expect(!valid_pair(kind_none(), operation_none()));
    std::testing::expect(!valid_pair(kind_runtime(), 7));
    std::testing::expect(operation_from_name("unknown-operation") < 0);
    std::testing::expect(kind_from_name("unknown-kind") < 0);
    std::testing::expect(!owned_container_operation(operation_array_len()).found);
    std::testing::expect(!owned_container_operation(7).found);
    let map_insert = runtime_method_abi(operation_map_insert());
    std::testing::expect(map_insert.found);
    std::testing::expect(try runtime_method_arg_count(operation_map_insert()) == 2);
    std::testing::expect(
        (try runtime_method_arg_selector(operation_map_insert(), 1)).kind ==
            RuntimeTypeSelectorKind::ReceiverChild
    );
    std::testing::expect(
        (try runtime_method_arg_selector(operation_map_insert(), 1)).storage_class ==
            RuntimeStorageClass::ByteView
    );
    std::testing::expect(!runtime_method_abi(7).found);
    std::testing::expect(
        !owned_container_constructor(owned_container_family_none()).found
    );
    std::testing::expect(
        owned_container_constructor_runtime(
            owned_container_family_sequence()
        ).type_size_argument_slot == 0
    );
    std::testing::expect(
        owned_container_constructor_runtime(
            owned_container_family_map()
        ).type_size_argument_slot == 1
    );
    std::testing::expect(
        owned_container_action_from_name("unknown-action") ==
            owned_container_action_none()
    );
    return;
}

pub fn free_runtime_abi_gate() -> !void {
    print(try free_runtime_symbol("std::builtin::mem_len"));
    print(try free_runtime_arg_type("std::builtin::mem_len", 0));
    print(try free_runtime_symbol("std::builtin::mem_page_allocator"));
    std::testing::expect(try free_runtime_arg_count(
        "std::builtin::mem_page_allocator"
    ) == 0);
    return;
}

pub fn free_runtime_arg_out_of_range_gate() -> !void {
    print(try free_runtime_arg_type("std::builtin::mem_len", 1));
    return;
}

pub fn reachable_free_runtime_abi_gate() -> !void {
    // Generic constructors require concrete call-site lowering because their
    // physical runtime calls carry type metadata not present in the source args.
    std::testing::expect(!free_runtime_abi("std::builtin::array").found);
    std::testing::expect(!free_runtime_abi("std::builtin::map").found);
    try print_free_runtime_abi("std::builtin::fs_read_file");
    try print_free_runtime_abi("std::builtin::io_write_stderr");
    return;
}

fn print_free_runtime_abi(identity: []u8) -> !void {
    let abi = free_runtime_abi(identity);
    std::testing::expect(abi.found);
    print(abi.symbol);
    print(try free_runtime_arg_count(identity));
    var arg_index = 0;
    while arg_index < try free_runtime_arg_count(identity) {
        print(try free_runtime_arg_type(identity, arg_index));
        arg_index = arg_index + 1;
    }
    return;
}

pub fn unknown_free_runtime_identity_gate() -> !void {
    print(try free_runtime_symbol("std::builtin::unknown"));
    return;
}
