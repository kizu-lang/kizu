import selfhost::parser;
import selfhost::ir::executable_body;
import selfhost::ir::executable_body_parsing;
import selfhost::ir::hosted_artifact_paths;
import selfhost::ir::hosted_executable_lowering;
import selfhost::source;

pub fn append_facts(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>
) -> !void {
    var execute_found = false;
    var executable_found = false;
    var hosted_found = false;

    try append_line(out, "executable-selected-signatures checked-ast-signature-v1");
    try append_line(out, "executable-selected-body-ir checked-ast-body-v1");
    try append_line(out, "executable-selected-helper-body-ir checked-ast-helper-body-v1");
    try append_line(out, "executable-selected-body-parsing checked-ast-body-parsing-v1");
    try append_line(out, "executable-selected-body-lowering checked-ast-body-lowering-v1");
    try append_line(out, "executable-hosted-artifact-paths checked-ast-hosted-artifact-v1");
    try append_line(out, "executable-hosted-lowering checked-ast-hosted-lowering-v1");

    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind == source::SourceKind::Selfhost {
            let module = source::module_path(file);
            if std::mem::equal_bytes(module, "cli/execute") {
                try append_execute_function_facts(allocator, out, file);
                execute_found = true;
            }
            if std::mem::equal_bytes(module, "backend/executable") {
                try append_executable_function_facts(allocator, out, file);
                executable_found = true;
            }
            if std::mem::equal_bytes(module, "backend/hosted") {
                try append_hosted_function_facts(allocator, out, file);
                hosted_found = true;
            }
        }
        index = index + 1;
    }
    if !execute_found {
        return error("missing executable CLI source");
    }
    if !executable_found {
        return error("missing executable lowering source");
    }
    if !hosted_found {
        return error("missing executable hosted backend source");
    }
    return;
}

fn append_execute_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "run_file_cli",
        "check::checked_ast_node("
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "run_file_cli",
        "backend::lower_run_executable("
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "run_file_cli",
        "backend::emit_run_executable_artifact("
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "run_file_cli",
        "selfhost::cli::execute::run_file_cli",
        "checked-run-artifact"
    );

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "test_file_cli",
        "check::checked_ast_node("
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "test_file_cli",
        "backend::lower_test_executable("
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "test_file_cli",
        "backend::emit_test_executable_artifact("
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "test_file_cli",
        "selfhost::cli::execute::test_file_cli",
        "checked-test-artifact"
    );
    return;
}

fn append_executable_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_executable",
        "parse_run_executable_ast("
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_executable",
        "lower_run_executable_ast("
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_executable",
        "selfhost::backend::executable::lower_run_executable",
        "checked-run-wrapper"
    );

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "parse_run_executable_ast",
        "parse_run_program_ast("
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "parse_run_executable_ast",
        "selfhost::backend::executable::parse_run_executable_ast",
        "checked-run-ast"
    );
    try executable_body_parsing::append_main_scan_fact(
        out,
        file.text,
        parsed.ast,
        parsed.root
    );
    try executable_body_parsing::append_run_parsing_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root
    );

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_executable_ast",
        "data::ExecutableKind::RunPrintString"
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_executable_ast",
        "data::ExecutableKind::RunReturnVoid"
    );
    let run_lowering_function = try function_node(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_executable_ast"
    );
    let run_lowering_body = try function_body_from_node(parsed.ast, run_lowering_function);
    try append_selected_function_signature(
        out,
        file.text,
        parsed.ast,
        run_lowering_function,
        "selfhost::backend::executable::lower_run_executable_ast",
        "checked-run-executable"
    );
    try append_selected_function_with_body_node(
        out,
        file.text,
        parsed.ast,
        "selfhost::backend::executable::lower_run_executable_ast",
        "checked-run-executable",
        run_lowering_body
    );

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_executable",
        "parse_test_executable_ast("
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_executable",
        "lower_test_executable_ast("
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_executable",
        "selfhost::backend::executable::lower_test_executable",
        "checked-test-wrapper"
    );

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "parse_test_executable_ast",
        "parse_test_program_ast("
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "parse_test_executable_ast",
        "selfhost::backend::executable::parse_test_executable_ast",
        "checked-test-ast"
    );
    try executable_body_parsing::append_test_parsing_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root
    );

    try append_executable_helper_body_facts(out, file.text, parsed.ast, parsed.root);

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_executable_ast",
        "data::ExecutableKind::TestExpectOk"
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_executable_ast",
        "data::ExecutableKind::TestExpectFailure"
    );
    let test_lowering_function = try function_node(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_executable_ast"
    );
    let test_lowering_body = try function_body_from_node(parsed.ast, test_lowering_function);
    try append_selected_function_signature(
        out,
        file.text,
        parsed.ast,
        test_lowering_function,
        "selfhost::backend::executable::lower_test_executable_ast",
        "checked-test-executable"
    );
    try append_selected_function_with_body_node(
        out,
        file.text,
        parsed.ast,
        "selfhost::backend::executable::lower_test_executable_ast",
        "checked-test-executable",
        test_lowering_body
    );
    return;
}

fn append_executable_helper_body_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_run_program_ast",
        "selfhost::backend::executable::parse_run_program_ast",
        "checked-run-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_run_fn_ast",
        "selfhost::backend::executable::parse_run_fn_ast",
        "checked-run-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_run_block_ast",
        "selfhost::backend::executable::parse_run_block_ast",
        "checked-run-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_run_return_stmt_ast",
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        "checked-run-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_run_print_stmt_ast",
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        "checked-run-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_run_print_call_ast",
        "selfhost::backend::executable::parse_run_print_call_ast",
        "checked-run-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "run_string_literal_payload",
        "selfhost::backend::executable::run_string_literal_payload",
        "checked-run-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "run_payload_from_literal",
        "selfhost::backend::executable::run_payload_from_literal",
        "checked-run-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "is_supported_run_print_payload",
        "selfhost::backend::executable::is_supported_run_print_payload",
        "checked-run-ast-helper"
    );

    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_test_program_ast",
        "selfhost::backend::executable::parse_test_program_ast",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_test_fn_ast",
        "selfhost::backend::executable::parse_test_fn_ast",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_test_block_ast",
        "selfhost::backend::executable::parse_test_block_ast",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_test_expect_statement_ast",
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "is_void_return_type",
        "selfhost::backend::executable::is_void_return_type",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_expect_stmt_ast",
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "parse_expect_call_ast",
        "selfhost::backend::executable::parse_expect_call_ast",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "is_empty_return",
        "selfhost::backend::executable::is_empty_return",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "expect_bool_value",
        "selfhost::backend::executable::expect_bool_value",
        "checked-test-ast-helper"
    );
    try append_selected_helper_body(
        out,
        text,
        ast,
        root,
        "bool_value_as_i64",
