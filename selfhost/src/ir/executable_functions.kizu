    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_codegen_program",
        "selfhost::backend::lower_run_codegen_program",
        "checked-run-codegen-wrapper"
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
