        "checked-run-codegen-consumer"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "stdout_payload",
        "selfhost::ir::codegen::stdout_payload",
        "checked-run-codegen-consumer"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "metadata_for_program",
        "selfhost::ir::codegen::metadata_for_program",
        "checked-run-codegen-consumer"
    );
    try append_selected_helper_body(
