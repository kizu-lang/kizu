fn append_hosted_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "emit_run_executable_artifact",
        "write_run_artifact("
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "emit_run_executable_artifact",
        "ensure_hosted_artifact_dir("
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "emit_run_executable_artifact",
        "selfhost::backend::hosted::emit_run_executable_artifact",
        "hosted-run-writer"
    );
    try hosted_artifact_paths::append_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "emit_run_executable_artifact",
        "selfhost::backend::hosted::emit_run_executable_artifact"
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "write_run_metadata",
        "append_common_metadata("
    );
    try hosted_artifact_paths::append_metadata_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "write_run_metadata",
        "selfhost::backend::hosted::write_run_metadata"
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_hosted_executable",
        "data::HostedExecutable"
    );
    try hosted_executable_lowering::append_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_hosted_executable",
        "selfhost::backend::hosted::lower_run_hosted_executable"
    );

    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "emit_test_executable_artifact",
        "write_test_artifact("
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "emit_test_executable_artifact",
        "ensure_hosted_artifact_dir("
    );
    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "emit_test_executable_artifact",
        "selfhost::backend::hosted::emit_test_executable_artifact",
        "hosted-test-writer"
    );
    try hosted_artifact_paths::append_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "emit_test_executable_artifact",
        "selfhost::backend::hosted::emit_test_executable_artifact"
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "write_test_metadata",
        "append_common_metadata("
    );
    try hosted_artifact_paths::append_metadata_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "write_test_metadata",
        "selfhost::backend::hosted::write_test_metadata"
    );
    try require_function_body_fragment(
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_hosted_executable",
        "data::HostedExecutable"
    );
    try hosted_executable_lowering::append_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "lower_test_hosted_executable",
        "selfhost::backend::hosted::lower_test_hosted_executable"
    );
    try hosted_artifact_paths::append_common_metadata_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root
    );
    return;
}

fn append_selected_function_with_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    local_name: []u8,
    qualified_name: []u8,
    role: []u8
) -> !void {
    let function_node_id = try function_node(text, ast, root, local_name);
    try append_selected_function_signature(out, text, ast, function_node_id, qualified_name, role);
    let body = try function_body_from_node(ast, function_node_id);
    try append_selected_function_with_body_node(out, text, ast, qualified_name, role, body);
    return;
}

fn append_selected_function_with_body_node(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    role: []u8,
    body: std::kizu::ast::NodeId
) -> !void {
    try executable_body::append_function_body_ir(out, text, ast, qualified_name, role, body);
    return;
}

fn append_selected_helper_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    local_name: []u8,
    qualified_name: []u8,
    role: []u8
) -> !void {
    let function_node_id = try function_node(text, ast, root, local_name);
    try append_selected_function_signature(out, text, ast, function_node_id, qualified_name, role);
    let body = try function_body_from_node(ast, function_node_id);
    try executable_body::append_helper_body_ir(out, text, ast, qualified_name, role, body);
    return;
}

fn append_selected_function_signature(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function: std::kizu::ast::NodeId,
    qualified_name: []u8,
    role: []u8
) -> !void {
    let node = ast.get(function);
    match node.data {
        FnDecl(fn_decl) => return try append_selected_function_signature_from_decl(
            out,
            text,
            ast,
            qualified_name,
            role,
            fn_decl.params,
            fn_decl.return_type
        );,
        _ => return error("missing selected executable function body");,
    }
}

fn append_selected_function_signature_from_decl(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    role: []u8,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId
) -> !void {
    try append_selected_signature_param_count(out, qualified_name, params.len);
    try append_selected_signature_return(out, text, ast, qualified_name, return_type);
    try append_selected_signature_params(out, text, ast, qualified_name, params);
    return;
}

fn append_selected_signature_param_count(
    out: &var std::string::String,
    qualified_name: []u8,
    count: i64
) -> !void {
    try out.append_bytes("selected-signature-param-count ");
    try out.append_bytes(qualified_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, count);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_selected_signature_return(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    return_type: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes("selected-signature-return ");
    try out.append_bytes(qualified_name);
    try out.append_byte(cast<u8>(32));
    try append_type_token(out, text, ast, return_type);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_selected_signature_params(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    params: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < params.len {
        let param = try ast.child_at(params, index);
        try append_selected_signature_param(out, text, ast, qualified_name, index, param);
        index = index + 1;
    }
    return;
}

fn append_selected_signature_param(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    index: i64,
    param: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(param);
    match node.data {
        Param(param_node) => return try append_selected_signature_param_from_node(
            out,
            text,
            ast,
            qualified_name,
            index,
            param_node.name,
            param_node.comptime_param,
            param_node.type_node
        );,
        _ => return error("missing selected executable function body");,
    }
}

fn append_selected_signature_param_from_node(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    index: i64,
    name: std::kizu::ast::NodeId,
    comptime_param: bool,
    type_node: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes("selected-signature-param ");
    try out.append_bytes(qualified_name);
    try out.append_byte(cast<u8>(35));
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(ast_node_text(text, ast, name));
    try out.append_byte(cast<u8>(58));
    if comptime_param {
        try out.append_bytes("comptime");
    } else {
        try out.append_bytes("runtime");
    }
    try out.append_byte(cast<u8>(58));
    try append_type_token(out, text, ast, type_node);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_type_token(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(type_node);
    match node.data {
        Empty => return try append_void_type_token(out);,
        _ => return try append_ast_type_token(out, text, ast, type_node);,
    }
}

fn append_void_type_token(out: &var std::string::String) -> !void {
    try out.append_bytes("void");
    return;
}

fn append_ast_type_token(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> !void {
    let type_text = ast_node_text(text, ast, type_node);
    try append_non_space_token(out, type_text);
    return;
}

fn append_non_space_token(out: &var std::string::String, text: []u8) -> !void {
    var index = 0;
    let len = std::mem::len(text);
    while index < len {
        let byte = text[index];
        if byte == cast<u8>(32) or byte == cast<u8>(9) {
            try out.append_byte(cast<u8>(95));
        } else {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    return;
}

fn require_function_body_fragment(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8,
    fragment: []u8
) -> !void {
    let body = try function_body_node(text, ast, root, function_name);
    if !node_text_contains(text, ast, body, fragment) {
        return error("missing selected executable function body");
    }
    return;
}

fn function_body_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    let function_node_id = try function_node(text, ast, root, function_name);
    return try function_body_from_node(ast, function_node_id);
}

fn function_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    let node = ast.get(root);
    match node.data {
        Program(program) => return try function_node_in_program(
            text,
            ast,
            program.declarations,
            function_name
        );,
        _ => return error("missing selected executable function body");,
    }
}

fn function_node_in_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if function_node_matches(text, ast, child, function_name) {
            return child;
        }
        index = index + 1;
    }
    return error("missing selected executable function body");
}

fn function_node_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        FnDecl(fn_decl) => std::mem::equal_bytes(
            ast_node_text(text, ast, fn_decl.name),
            name
        ),
        _ => false,
    };
}

fn function_body_from_node(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return fn_decl.body;,
        _ => return error("missing selected executable function body");,
    }
}

fn node_text_contains(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    fragment: []u8
) -> bool {
    return bytes_contains(ast_node_text(text, ast, node_id), fragment);
}

fn bytes_contains(bytes: []u8, needle: []u8) -> bool {
    let byte_len = std::mem::len(bytes);
    let needle_len = std::mem::len(needle);
    if needle_len == 0 {
        return true;
    }
    if needle_len > byte_len {
        return false;
    }
    let last_start = byte_len - needle_len;
    var index = 0;
    while index <= last_start {
        if std::mem::equal_bytes(bytes[index..index + needle_len], needle) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
