fn append_execute_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "run_file_cli",
        "selfhost::cli::execute::run_file_cli",
        "checked-run-artifact"
    );

    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "test_file_cli",
        "selfhost::cli::execute::test_file_cli",
        "checked-test-artifact"
    );
    return;
}

