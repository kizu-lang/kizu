import selfhost::parser;
import selfhost::ir::component_function_catalog;
import selfhost::ir::executable_body;
import selfhost::ir::function_signature;
import selfhost::source;

pub fn append_facts(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>
) -> !void {
    var execute_found = false;
    var codegen_found = false;
    var code_render_found = false;
    var backend_found = false;
    var executable_found = false;
    var hosted_found = false;
    var lexer_found = false;
    var source_found = false;
    var loader_found = false;
    var ast_found = false;
    var diagnostic_found = false;
    var mem_found = false;
    var selfhost_ast_found = false;
    var format_found = false;

    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind == source::SourceKind::Std {
            let std_module = source::module_path(file);
            if std::mem::equal_bytes(std_module, "kizu/ast") {
                try append_ast_function_facts(allocator, out, file);
                ast_found = true;
            }
            if std::mem::equal_bytes(std_module, "kizu/diagnostic") {
                try append_diagnostic_function_facts(allocator, out, file);
                diagnostic_found = true;
            }
            if std::mem::equal_bytes(std_module, "mem") {
                try append_mem_function_facts(allocator, out, file);
                mem_found = true;
            }
            if std::mem::equal_bytes(std_module, "kizu/lexer") {
                try append_kizu_lexer_function_facts(allocator, out, file);
            }
            if std::mem::equal_bytes(std_module, "kizu/parser") {
                try append_kizu_parser_function_facts(allocator, out, file);
            }
        }
        if file.kind == source::SourceKind::Selfhost {
            let module = source::module_path(file);
            if std::mem::equal_bytes(module, "cli/execute") {
                try append_execute_function_facts(allocator, out, file);
                execute_found = true;
            }
            if std::mem::equal_bytes(module, "ir/codegen") {
                try append_codegen_function_facts(allocator, out, file);
                codegen_found = true;
            }
            if std::mem::equal_bytes(module, "ir/code_render") {
                try append_code_render_function_facts(allocator, out, file);
                code_render_found = true;
            }
            if std::mem::equal_bytes(module, "backend") {
                try append_backend_function_facts(allocator, out, file);
                backend_found = true;
            }
            if std::mem::equal_bytes(module, "backend/executable") {
                try append_executable_function_facts(allocator, out, file);
                executable_found = true;
            }
            if std::mem::equal_bytes(module, "backend/hosted") {
                try append_hosted_function_facts(allocator, out, file);
                hosted_found = true;
            }
            if std::mem::equal_bytes(module, "lexer") {
                try append_lexer_function_facts(allocator, out, file);
                lexer_found = true;
            }
            if std::mem::equal_bytes(module, "source") {
                try append_source_function_facts(allocator, out, file);
                source_found = true;
            }
            if std::mem::equal_bytes(module, "source/loader") {
                try append_loader_function_facts(allocator, out, file);
                loader_found = true;
            }
            if std::mem::equal_bytes(module, "ast") {
                try append_selfhost_ast_function_facts(allocator, out, file);
                selfhost_ast_found = true;
            }
            if std::mem::equal_bytes(module, "parser/format") {
                try append_format_function_facts(allocator, out, file);
                format_found = true;
            }
        }
        index = index + 1;
    }
    if !execute_found {
        return error("missing executable CLI source");
    }
    if !codegen_found {
        return error("missing codegen source");
    }
    if !code_render_found {
        return error("missing code render source");
    }
    if !backend_found {
        return error("missing backend source");
    }
    if !executable_found {
        return error("missing executable lowering source");
    }
    if !hosted_found {
        return error("missing executable hosted backend source");
    }
    if !lexer_found {
        return error("missing lexer source");
    }
    if !source_found {
        return error("missing source source");
    }
    if !loader_found {
        return error("missing source loader source");
    }
    if !ast_found {
        return error("missing std kizu ast source");
    }
    if !diagnostic_found {
        return error("missing std kizu diagnostic source");
    }
    if !mem_found {
        return error("missing std mem source");
    }
    if !selfhost_ast_found {
        return error("missing selfhost ast source");
    }
    if !format_found {
        return error("missing selfhost parser format source");
    }
    return;
}

// append_mem_function_facts emits the signature + body facts for the std::mem slice/text helpers
// compiled into stage2: is_ascii_space + trim_ascii for ast_node_text, plus starts_with for source
// and CLI prefix predicates. They are registered here so stdlib callers resolve to
// selfhost-owned compiled symbols instead of static Go-owned helpers.
fn append_mem_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "is_ascii_space",
        "std::mem::is_ascii_space",
        "checked-text-accessor"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "trim_ascii",
        "std::mem::trim_ascii",
        "checked-text-accessor"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "starts_with",
        "std::mem::starts_with",
        "checked-mem-starts-with"
    );
    try append_stdlib_symbol_fact(out, "std::mem::starts_with", "kizu_std__mem_starts_with", "bool");
    return;
}

// append_kizu_lexer_function_facts emits the signature + body facts for the std::kizu::lexer leaf
// byte classifiers the tokenizer depends on (tracker 961, scope 4 prerequisite): is_alpha /
// is_digit / is_space (or-chain / range byte predicates over a single i8) and is_word (which
// or-combines is_alpha / is_digit). They are the bottom of the lexer compile chain the eventual
// scanner removal needs (source -> Ast requires the compiled tokenizer). is_word's calls resolve
// their i8 argument type through the is_alpha / is_digit stdlib-symbol arg-type facts.
fn append_kizu_lexer_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    var catalog = try component_function_catalog::collect_from_ast(
        allocator,
        file.text,
        parsed.ast,
        parsed.root,
        "std::kizu::lexer"
    );
    defer catalog.deinit();
    try append_qualified_type_llvm_fact(
        out, "std::kizu::lexer::Position"
    );
    // Position's field layout (line -> 0, column -> 1) lets advance_byte resolve
    // initial.line / initial.column as struct field accesses (tracker 961, scope 4
    // prerequisite).
    try append_selected_struct_field_facts(
        out, file.text, parsed.ast, parsed.root,
        "Position", "std::kizu::lexer::Position"
    );
    // Token is the tokenizer's output record; its type-llvm mapping, the TokenKind
    // enum-variant facts (so TokenKind lowers to i64), and Token's field layout
    // (kind -> 0 .. doc_end -> 6) are the type/facts base the first_token / next_token /
    // token_at tokenizer cluster will consume (tracker 961, scope 4 prerequisite).
    try append_qualified_type_llvm_fact(
        out, "std::kizu::lexer::Token"
    );
    try append_selected_enum_variant_facts(
        out, file.text, parsed.ast, parsed.root,
        "TokenKind", "std::kizu::lexer::TokenKind"
    );
    try append_selected_struct_field_facts(
        out, file.text, parsed.ast, parsed.root,
        "Token", "std::kizu::lexer::Token"
    );
    try append_stdlib_symbol_fact_arg(
        out, "std::kizu::lexer::is_alpha", "kizu_kizu__lexer_is_alpha", "bool", "i8"
    );
    try append_stdlib_symbol_fact_arg(
        out, "std::kizu::lexer::is_digit", "kizu_kizu__lexer_is_digit", "bool", "i8"
    );
    // position is compiled (below) and also called by advance_byte, so it carries a
    // stdlib-symbol fact: callers resolve its i64 arguments and Position struct return
    // through the lower_call_* stdlib path (tracker 961, scope 4 prerequisite).
    try append_stdlib_symbol_fact_arg(
        out, "std::kizu::lexer::position", "kizu_kizu__lexer_position",
        "std::kizu::lexer::Position", "i64"
    );
    try append_kizu_lexer_reachable_helper_bodies(
        out,
        file.text,
        parsed.ast,
        &catalog
    );
    // tokenize builds the Array<Token> by folding first_token / next_token; it is the tokenizer's
    // top-level driver feeding the parser (tracker 961, scope 4 prerequisite).
    try append_selected_helper_body(
        out, file.text, parsed.ast, parsed.root,
        "tokenize", "std::kizu::lexer::tokenize", "checked-lexer-scan"
    );
    return;
}

fn append_kizu_lexer_reachable_helper_bodies(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog
) -> !void {
    var pending = std::array::Array<i64>(std::mem::page_allocator());
    var emitted = std::array::Array<i64>(std::mem::page_allocator());
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "first_token"));
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "next_token"));
    var index = 0;
    while index < pending.len() {
        let function_index = try pending.get(index);
        if !(try closure_index_seen(&emitted, function_index)) {
            try append_kizu_lexer_closure_helper_body(
                out,
                text,
                ast,
                catalog,
                function_index,
                &var pending
            );
            try emitted.append(function_index);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn append_kizu_lexer_closure_helper_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    function_index: i64,
    pending: &var std::array::Array<i64>
) -> !void {
    let local_name = try component_function_catalog::local_function_name(catalog, function_index);
    let function_node_id = try component_function_catalog::function_node_id(catalog, function_index);
    try function_signature::append_catalog(out, text, ast, function_node_id, catalog, function_index);
    let body = try function_body_from_node(ast, function_node_id);
    try executable_body::append_catalog_helper_body_ir(
        out,
        text,
        ast,
        catalog,
        function_index,
        kizu_lexer_closure_role(local_name),
        body
    );
    try collect_catalog_closure_direct_callees(
        text,
        ast,
        body,
        catalog,
        pending,
        "std::kizu::lexer::",
        "std lexer closure: unsupported call form",
        "std lexer closure: unsupported qualified callee"
    );
    return;
}

fn kizu_lexer_closure_role(local_name: []u8) -> []u8 {
    if std::mem::equal_bytes(local_name, "position") {
        return "checked-lexer-position";
    }
    if std::mem::equal_bytes(local_name, "is_alpha") or
        std::mem::equal_bytes(local_name, "is_digit") or
        std::mem::equal_bytes(local_name, "is_word") or
        std::mem::equal_bytes(local_name, "is_space") {
        return "checked-lexer-classifier";
    }
    if std::mem::equal_bytes(local_name, "advance_byte") or
        std::mem::equal_bytes(local_name, "advance_position") {
        return "checked-lexer-advance";
    }
    if std::mem::equal_bytes(local_name, "token") or
        std::mem::equal_bytes(local_name, "attach_doc") {
        return "checked-lexer-token";
    }
    return "checked-lexer-scan";
}

// append_kizu_parser_function_facts emits the signature + body facts for the std::kizu::parser
// TokenKind predicates compiled into stage2 (tracker 961, scope 4 prerequisite). They match over a
// Token's TokenKind field and return bool; the Token field layout and TokenKind discriminants come
// from the lexer facts.
fn append_kizu_parser_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    try append_type_llvm_fact(
        out, "std::kizu::parser::ParseNode", "%kizu.kizu.parser.parse_node"
    );
    try append_selected_struct_field_facts(
        out, file.text, parsed.ast, parsed.root,
        "ParseNode", "std::kizu::parser::ParseNode"
    );
    var catalog = try component_function_catalog::collect_from_ast(
        allocator,
        file.text,
        parsed.ast,
        parsed.root,
        "std::kizu::parser"
    );
    defer catalog.deinit();
    // Byte-level parser predicates used by postfix/type parsing. These keep parser progress on
    // the tokenized source path instead of growing the legacy run scanner. The stdlib-symbol
    // facts make fully-qualified parser helper calls resolve to their compiled symbols and
    // argument types when later parser helpers call them.
    try append_stdlib_symbol_fact_arg(
        out, "std::kizu::parser::is_lt_token", "kizu_kizu__parser_is_lt_token",
        "bool", "%kizu.kizu.lexer.token"
    );
    try append_stdlib_symbol_fact_arg(
        out, "std::kizu::parser::is_postfix_start", "kizu_kizu__parser_is_postfix_start",
        "bool", "%kizu.kizu.lexer.token"
    );
    try append_stdlib_symbol_fact_args3(
        out, "std::kizu::parser::is_single_token_byte",
        "kizu_kizu__parser_is_single_token_byte",
        "bool", "%kizu.slice.u8", "%kizu.kizu.lexer.token", "i8"
    );
    try append_stdlib_symbol_fact_args3(
        out, "std::kizu::parser::is_double_colon_at", "kizu_kizu__parser_is_double_colon_at",
        "bool", "%kizu.slice.u8", "i64", "i64"
    );
    try append_stdlib_symbol_fact_arg(
        out, "std::kizu::parser::is_name_byte", "kizu_kizu__parser_is_name_byte", "bool", "i8"
    );
    try append_stdlib_symbol_fact_arg(
        out, "std::kizu::parser::is_upper_byte", "kizu_kizu__parser_is_upper_byte", "bool", "i8"
    );
    try append_stdlib_symbol_fact_args2(
        out, "std::kizu::parser::is_namespace_path_span",
        "kizu_kizu__parser_is_namespace_path_span",
        "bool", "%kizu.slice.u8", "%kizu.kizu.ast.span"
    );
    try append_stdlib_symbol_fact_args2(
        out, "std::kizu::parser::is_struct_literal_type_span",
        "kizu_kizu__parser_is_struct_literal_type_span",
        "bool", "%kizu.slice.u8", "%kizu.kizu.ast.span"
    );
    try append_stdlib_symbol_fact_args3(
        out, "std::kizu::parser::is_type_apply_start",
        "kizu_kizu__parser_is_type_apply_start",
        "bool", "%kizu.kizu.ast.ast", "%kizu.slice.u8", "%kizu.kizu.parser.parse_node"
    );
    try append_stdlib_symbol_fact_args3(
        out, "std::kizu::parser::is_struct_literal_start",
        "kizu_kizu__parser_is_struct_literal_start",
        "bool", "%kizu.kizu.ast.ast", "%kizu.slice.u8", "%kizu.kizu.parser.parse_node"
    );
    var pending = std::array::Array<i64>(std::mem::page_allocator());
    var emitted = std::array::Array<i64>(std::mem::page_allocator());
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_double_colon");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_eof_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_left_brace_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_right_brace_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_block_close_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_ident_kind");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_postfix_start");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_call_close_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_pub_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_comptime_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_decl_item_separator");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_lt_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_gt_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_comma_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_arrow_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_left_paren_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_right_paren_token");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_single_token_byte");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_double_token_byte");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_type_apply_start");
    try append_kizu_parser_closure_seed(&var pending, &catalog, "is_struct_literal_start");
    var index = 0;
    while index < pending.len() {
        let function_index = try pending.get(index);
        if !(try closure_index_seen(&emitted, function_index)) {
            try append_kizu_parser_closure_helper_body(
                out,
                file.text,
                parsed.ast,
                &catalog,
                function_index,
                &var pending
            );
            try emitted.append(function_index);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn append_kizu_parser_closure_seed(
    pending: &var std::array::Array<i64>,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    local_name: []u8
) -> !void {
    try pending.append(try component_function_catalog::find_local_function_index(catalog, local_name));
    return;
}

fn append_kizu_parser_closure_helper_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    function_index: i64,
    pending: &var std::array::Array<i64>
) -> !void {
    let local_name = try component_function_catalog::local_function_name(catalog, function_index);
    let function_node_id = try component_function_catalog::function_node_id(catalog, function_index);
    try function_signature::append_catalog(out, text, ast, function_node_id, catalog, function_index);
    let body = try function_body_from_node(ast, function_node_id);
    try executable_body::append_catalog_helper_body_ir(
        out,
        text,
        ast,
        catalog,
        function_index,
        kizu_parser_closure_role(local_name),
        body
    );
    try collect_catalog_closure_direct_callees(
        text,
        ast,
        body,
        catalog,
        pending,
        "std::kizu::parser::",
        "std parser closure: unsupported call form",
        "std parser closure: unsupported qualified callee"
    );
    return;
}

// append_format_function_facts emits the signature + body facts for the
// selfhost::parser::format read-only helper closure compiled into stage2 (issue 1165
// / issue 1162). The seeds are the in-degree-zero read-only roots: the four TokenKind
// predicates (is_import_token / is_ident_token / is_double_colon_token /
// is_semicolon_token, each 'return match token.kind { Variant => true, _ => false }'
// over a std::kizu::lexer::Token value) and token_text, the span-slice accessor
// 'return source[token.start..token.end]'. Each member's signature + body facts are
// emitted from the shared component catalog so the backend can lower them through the
// token-kind predicate MIR and the generic expression / restricted-loop paths with no
// handwritten per-helper metadata table. The seed set has since grown along the BFS
// frontier to the token-array read / scan-while helpers (next_token_text_equals,
// index_after_import, index_after_leading_imports), the import-sort comparator cluster
// (compare_bytes, import_path_less), the scan-shift insertion sort sort_import_indices and
// the leading-import collector leading_import_indices (both lowered through compiled_struct_cf
// with general loop-carried-variable SSA + the Array<i64>.get/set/append mutation ABI), and the
// sorted import output cluster append_import_decl / append_sorted_imports (the first members that
// mutate a '&var std::string::String' accumulator, lowered through compiled_struct_cf with the
// @kizu_rt_string_append_* ABI), the indentation emitter append_indent (the String-append counter
// loop, also lowered through compiled_struct_cf with the @kizu_rt_string_append_bytes ABI), and the
// two leaf byte classifiers of the comment-preservation cluster is_horizontal_space / is_line_break
// (single-return short-circuit 'or' predicates over a u8, lowered through the generic
// short-circuit-or-return path), and finally the comment-preservation driver
// append_preserved_line_comments itself (the first member returning a struct in an error union,
// '-> !CommentFormatState', lowered through compiled_struct_cf::append_comment_preserve_function via
// the CommentFormatState struct value + error-union ABI), and the whole-formatter entry
// format_source, which the stage2 fmt command now calls directly.
fn append_format_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    var catalog = try component_function_catalog::collect_from_ast(
        allocator,
        file.text,
        parsed.ast,
        parsed.root,
        "selfhost::parser::format"
    );
    defer catalog.deinit();
    var pending = std::array::Array<i64>(std::mem::page_allocator());
    var emitted = std::array::Array<i64>(std::mem::page_allocator());
    // The read-only seed set: the four TokenKind predicates plus the token_text
    // span-slice accessor. All five are leaves, so the BFS closure is exactly these.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_import_token"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_ident_token"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_double_colon_token"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_semicolon_token"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "token_text"));
    // next_token_text_equals is the first token-array read helper on the compiled path
    // (issue 1165): it reads tokens.len() / tokens.get(index + 1) on a value-receiver
    // Array<Token> param, calls lexer::is_eof across the module boundary, and compares the
    // next token text. Its body BFS pulls in token_text (already a seed) and references
    // lexer::is_eof as an allowed external callee.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "next_token_text_equals"));
    // index_after_import is the first token-array scan-while helper on the compiled path
    // (issue 1165): 'var index = import_index; while index < tokens.len() { let token =
    // try tokens.get(index); if is_semicolon_token(token) { return index + 1; } if
    // lexer::is_eof(token) { return index; } index = index + 1; } return index;'. It
    // exercises the generic bounded counter loop with a parameter-seeded induction
    // variable and i64 early returns. Its body BFS pulls in is_semicolon_token (already a
    // seed) and references lexer::is_eof as an allowed external callee; tokens.len() /
    // tokens.get(...) are inline Array<Token> read builtins, not closure members.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "index_after_import"));
    // index_after_leading_imports is the first token-array scan-while helper whose loop latch
    // is a loop-carried try-call (issue 1165): 'var index = 0; while index < tokens.len() {
    // let token = try tokens.get(index); if !is_import_token(token) { return index; } index =
    // try index_after_import(tokens, index); } return index;'. It exercises the generic loop
    // latch update where the induction variable is reassigned by a try-call whose i64 success
    // feeds the loop-head phi and whose failure propagates as this function's error union. Its
    // body BFS pulls in is_import_token (already a seed) and index_after_import (resolved as a
    // local closure member through the call edge).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "index_after_leading_imports"));
    // compare_bytes is the first import-sort helper on the compiled path (issue 1165 /
    // 1162): 'var index = 0; let left_len = std::mem::len(left); let right_len =
    // std::mem::len(right); while index < left_len and index < right_len { if left[index]
    // < right[index] { return 0 - 1; } if left[index] > right[index] { return 1; } index =
    // index + 1; } ...'. It exercises the short-circuit 'and' while header over two pure
    // length locals, []u8 index loads in the body guards, and i64 early returns. It is a
    // BFS leaf: its only callee is std::mem::len (an intrinsic the closure ignores), so it
    // pulls in no new members.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "compare_bytes"));
    // import_path_less is the first multi-counter import-sort helper on the compiled path
    // (issue 1165 / 1162): 'var left_index = left + 1; var right_index = right + 1; while
    // left_index < tokens.len() and right_index < tokens.len() { let left_token = try
    // tokens.get(left_index); ...; let comparison = compare_bytes(token_text(source,
    // left_token), token_text(source, right_token)); ...; left_index = left_index + 1;
    // right_index = right_index + 1; } return false;'. It exercises two lockstep induction
    // counters with base-plus-offset inits, a short-circuit 'and' header reading both, a body
    // let bound to a nested-call-argument free call, and a prefix-not call return. Its body
    // BFS pulls in is_semicolon_token, token_text, and compare_bytes (all already seeded
    // members); tokens.len()/tokens.get(...) are inline Array<Token> read builtins.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "import_path_less"));
    // sort_import_indices is the first structured-control-flow import-sort helper on the
    // compiled path (issue 1165 / 1162): 'var index = 1; while index < indices.len() { var
    // cursor = index; var scanning = true; while scanning and cursor > 0 { let left = try
    // indices.get(cursor - 1); let right = try indices.get(cursor); if try
    // import_path_less(source, tokens, right, left) { try indices.set(cursor - 1, right); try
    // indices.set(cursor, left); cursor = cursor - 1; } else { scanning = false; } } index =
    // index + 1; } return;'. It is the scan-shift insertion sort: an outer counter loop, a
    // nested scan loop carrying a cursor and a boolean flag through loop-head phis, an
    // if/else that re-merges into the loop, a try-call import_path_less condition, and
    // Array<i64>.get/set element reads/writes through the element-size-generic
    // @kizu_rt_array_at / @kizu_rt_array_set ABI on the '&var std::array::Array<i64>' param.
    // It lowers through compiled_struct_cf rather than the i64-induction While machinery. Its
    // body BFS pulls in import_path_less (already a seeded member).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "sort_import_indices"));
    // leading_import_indices is the first structured-control-flow collector on the compiled
    // path (issue 1165 / 1162): 'var indices = std::array::Array<i64>(allocator); var index =
    // 0; while index < tokens.len() { let token = try tokens.get(index); if
    // !is_import_token(token) { index = tokens.len(); } else { try indices.append(index); index
    // = try index_after_import(tokens, index); } } try sort_import_indices(source, tokens, &var
    // indices); return indices;'. It builds a runtime-owned Array<i64> through the
    // element-size-generic @kizu_rt_array_new / @kizu_rt_array_append ABI, scans the token array
    // through an if/else branch-merge loop (a loop-terminating 'index = tokens.len()' on one
    // arm, an append-then-try-advance on the other re-merging at a loop-latch phi), then sorts
    // the collected indices in place and returns the filled array as the '!std::array::Array<i64>'
    // success (a %kizu.error.owned wrap). It lowers through compiled_struct_cf rather than the
    // i64-induction While machinery. Its body BFS pulls in is_import_token, index_after_import,
    // and sort_import_indices (all already seeded members).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "leading_import_indices"));
    // append_import_decl is the first selfhost::parser::format member that mutates a '&var
    // std::string::String' accumulator on the compiled path (issue 1165 / 1162): 'try
    // out.append_bytes("import "); var index = import_index + 1; while index < tokens.len() {
    // let token = try tokens.get(index); let text = token_text(source, token); if
    // is_semicolon_token(token) { try out.append_bytes(";"); return; } if is_ident_token(token)
    // or is_double_colon_token(token) { try out.append_bytes(text); } index = index + 1; }
    // return;'. It appends the 'import ' prefix and the ';' terminator as string literals through
    // the @kizu_rt_string_append_bytes runtime ABI, reads each token's text via token_text, and
    // emits the import path identifiers, scanning the import's tokens through a loop carrying an
    // early-return semicolon branch and a fall-through 'ident or double-colon' text append. It
    // lowers through compiled_struct_cf rather than the i64-induction While machinery. Its body
    // BFS pulls in token_text, is_semicolon_token, is_ident_token, and is_double_colon_token (all
    // already seeded members).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "append_import_decl"));
    // append_sorted_imports is the import-cluster emitter on the compiled path (issue 1165 /
    // 1162): 'var index = 0; while index < indices.len() { let import_index = try
    // indices.get(index); try append_import_decl(out, source, tokens, import_index); try
    // out.append_byte(cast<u8>(10)); index = index + 1; } return;'. It scans the sorted indices
    // array and, for each, appends a single import declaration via append_import_decl followed by
    // a newline byte through the @kizu_rt_string_append_byte ABI. It lowers through
    // compiled_struct_cf rather than the i64-induction While machinery. Its body BFS pulls in
    // append_import_decl (an already seeded member).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "append_sorted_imports"));
    // append_indent is the indentation emitter on the compiled path (issue 1165 / 1162): 'var
    // index = 0; while index < depth { try out.append_bytes("    "); index = index + 1; } return;'.
    // It mutates a '&var std::string::String' accumulator inside an i64 counter loop, appending the
    // four-space indentation string literal through the @kizu_rt_string_append_bytes runtime ABI on
    // each iteration. It lowers through compiled_struct_cf rather than the i64-induction While
    // machinery. It is a BFS leaf: its only callee is the out.append_bytes runtime builtin, so it
    // pulls in no new members.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "append_indent"));
    // is_horizontal_space and is_line_break are the two leaf byte classifiers of the comment-
    // preservation cluster on the compiled path (issue 1165 / 1162): 'return byte == cast<u8>(<a>)
    // or byte == cast<u8>(<b>);', a single-return short-circuit 'or' of two u8 equality tests over
    // a u8 parameter. They lower through the generic short-circuit-or-return path. They are BFS
    // leaves (their only callee is the cast intrinsic), so they pull in no new members.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_horizontal_space"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_line_break"));
    // after_line_break is the first comment-preservation scalar helper to move onto the compiled
    // path (issue 1165 / 1162): 'let length = std::mem::len(source); if source[index] ==
    // cast<u8>(13) and index + 1 < length and source[index + 1] == cast<u8>(10) { return index +
    // 2; } return index + 1;'. Its if-condition is a three-operand short-circuit 'and' chain whose
    // trailing 'source[index + 1]' byte load is guarded by the 'index + 1 < length' bounds check,
    // so it lowers through the generic multi-statement path's short-circuit if-chain (the first
    // operand fills the unguarded entry block, the rest each evaluate in their own guarded block)
    // instead of an eager 'and i1' that would load past the slice. It is a BFS leaf: its only
    // callees are std::mem::len and the cast intrinsic, so it pulls in no new members.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "after_line_break"));
    // line_end_excluding_break scans forward to the end of a line on the compiled path (issue
    // 1165 / 1162): 'var index = start; let length = std::mem::len(source); while index < length
    // and !is_line_break(source[index]) { index = index + 1; } return index;'. Its while header is
    // a genuine short-circuit 'and' whose second operand '!is_line_break(source[index])' loads
    // source[index] only when 'index < length' holds, so it lowers through the multi-statement
    // path's new short-circuit while header (the first operand drives the loop head, the guarded
    // load runs in a loopN_head_rhs block) rather than an eager 'and i1' that would read past the
    // slice. Its body BFS pulls in is_line_break (an already seeded member).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "line_end_excluding_break"));
    // line_end_including_break is the same forward scan plus a trailing 'if index < length {
    // return after_line_break(source, index); } return index;' that folds a trailing CRLF/LF into
    // the line (issue 1165 / 1162). The while header reuses the short-circuit-while capability; the
    // tail is a single-comparison if whose then-block is a 'return <callee>(..)' ReturnCall the
    // generic multi-statement if path already lowers. Its body BFS pulls in is_line_break and
    // after_line_break (both already seeded members).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "line_end_including_break"));
    // line_comment_is_full_line scans backward from a line comment's start to decide whether only
    // horizontal whitespace precedes it on the line (issue 1165 / 1162): 'var index =
    // comment_start; while index > 0 { let previous = index - 1; if is_line_break(source[previous])
    // { return true; } if !is_horizontal_space(source[previous]) { return false; } index = previous;
    // } return true;'. It is the first compiled helper whose while header is a single 'index > 0'
    // comparison against a literal (a downward counter, not an upward bound), whose loop body opens
    // with a 'let previous = index - 1' decrement local feeding both a checked 'source[previous]'
    // byte load passed as a call argument and the 'index = previous' latch, and whose body carries
    // two boolean early returns. Its body BFS pulls in is_line_break and is_horizontal_space (both
    // already seeded members).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "line_comment_is_full_line"));
    // line_comment_has_blank_after scans forward from a line comment's end to decide whether a blank
    // line follows it (issue 1165 / 1162): 'var cursor = line_end_including_break(source,
    // comment_end); while cursor < end { if is_horizontal_space(source[cursor]) { cursor = cursor +
    // 1; continue; } return is_line_break(source[cursor]); } return false;'. It is the first compiled
    // helper with a continue-latch loop: its induction variable advances inside a body 'if <cond> {
    // cursor = cursor + 1; continue; }' rather than a trailing increment, its primary init is
    // call-seeded ('var cursor = line_end_including_break(...)') so the call runs in the preheader,
    // and its non-continue path returns 'is_line_break(source[cursor])' (a return whose call argument
    // is a checked byte load). Its body BFS pulls in line_end_including_break, is_horizontal_space and
    // is_line_break (all already seeded members).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "line_comment_has_blank_after"));
    // line_comment_has_blank_before scans backward from a line comment's start to decide whether a
    // blank line precedes it (issue 1165 / 1162): 'var cursor = comment_start; while cursor > start {
    // let previous = cursor - 1; if is_horizontal_space(source[previous]) { cursor = previous;
    // continue; } if !is_line_break(source[previous]) { return false; } cursor = previous; while
    // cursor > start { let before = cursor - 1; if is_horizontal_space(source[before]) { cursor =
    // before; continue; } return is_line_break(source[before]); } return false; } return false;'. It
    // is the first compiled helper with a nested continue-latch loop and the first whose continue-latch
    // step is a copy-decrement: both scans advance the cursor inside a body 'if <cond> { cursor =
    // previous; continue; }' whose latch reads the decrement local rather than a constant-step add,
    // both headers are non-literal 'cursor > start' comparisons, and the inner scan reuses the cursor
    // induction (renamed so its loop-head phi does not clash with the outer scan's). Its body BFS pulls
    // in is_horizontal_space and is_line_break (both already seeded members).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "line_comment_has_blank_before"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "should_insert_space"));
    // lbrace_opens_enum_decl is the first compiled helper with a leading-decrement loop (issue 1165 /
    // 1162): 'var cursor = index; while cursor > 0 { cursor = cursor - 1; let token = try
    // tokens.get(cursor); let text = token_text(source, token); if equal_bytes(text, "enum") { return
    // true; } if equal_bytes(text, "{") or equal_bytes(text, "}") or equal_bytes(text, ";") { return
    // false; } } return false;'. Its induction variable advances through the body-opening 'cursor =
    // cursor - 1' self-decrement rather than a trailing increment, so the loop-head phi is reseated
    // onto a reserved counter and the decrement is synthesized as a body 'let cursor = <head> - 1'
    // whose value every later body read resolves to. Its BFS pulls in token_text (already seeded) and
    // reads a value-receiver Array<Token> through tokens.get.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "lbrace_opens_enum_decl"));
    // The sibling brace-depth scans use the same backward token loop and add a loop-carried scalar
    // (brace_depth) mutated inside conditional then-blocks. They exercise the generic scalar-select
    // join plus loop-head carried-scalar phi path rather than formatter-specific dispatch.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_match_arm_trailing_comma"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "rbrace_closes_enum_decl"));
    // append_preserved_line_comments is the comment-preservation driver (issue 1165 / 1162): the
    // first selfhost::parser::format member returning a struct in an error union
    // ('-> !CommentFormatState'). It mutates a '&var std::string::String' accumulator, threads the
    // loop-carried scalar state current_last / current_at_line_start / current_after_comment through
    // a forward 'while index < end' scan loop whose if/else comment arm scans a '// ...' full-line
    // comment, and closes with 'return CommentFormatState { ... };'. It lowers through
    // compiled_struct_cf::append_comment_preserve_function (dispatched by its
    // %kizu.error.comment_format_state return type). Its body BFS reaches the already-seeded
    // line_comment_is_full_line / line_comment_has_blank_before / line_comment_has_blank_after /
    // line_end_excluding_break / line_end_including_break / append_indent helpers.
    let comment_driver_index = try component_function_catalog::find_local_function_index(
        &catalog, "append_preserved_line_comments"
    );
    try pending.append(comment_driver_index);
    let comment_driver_node = try component_function_catalog::function_node_id(
        &catalog, comment_driver_index
    );
    try append_return_payload_struct_type_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        comment_driver_node,
        "selfhost::parser::format::"
    );
    // The next read-only helpers join the closure through the shared catalog + BFS without new
    // per-helper lowering (issue 1165 / 1162). They lower through the existing generic
    // single-statement / multi-statement expression paths:
    //   - is_top_level_decl_start: a single-return short-circuit 'or' of std::mem::equal_bytes calls
    //     (the no_space_before / no_space_after shape), a BFS leaf.
    //   - starts_new_top_level_decl: a leading 'if !is_top_level_decl_start(current) { return false; }'
    //     guard plus a prefix-not-of-short-circuit-or return; BFS pulls in is_top_level_decl_start.
    //   - last_byte: a single-return checked single-element index load 'text[std::mem::len(text) - 1]'.
    //   - has_line_comment_between: a 'while index + 1 < end' scan whose body carries a short-circuit
    //     '//' byte-pair guard with an early return true (first 'counter + 1' while header), a BFS leaf.
    //   - rbrace_wants_newline: two early-return guards, a token_text let, and a prefix-not of a
    //     ten-operand short-circuit 'or' over the next token's text; BFS pulls in token_text and
    //     references lexer::is_eof across the module boundary.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_top_level_decl_start"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "starts_new_top_level_decl"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "last_byte"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "has_line_comment_between"));
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "rbrace_wants_newline"));
    //   - is_trailing_comma: a ',' early-return guard, two 'let <name> = try next_token_text_equals(...)'
    //     let-try binds with bool early returns, an 'if !(try next_token_text_equals(...)) { return
    //     false; }' guard, and a 'return !(try is_match_arm_trailing_comma(...));' tail. The two
    //     sub-expression try-calls (a prefix-not of a try-call in an if condition, and a prefix-not of a
    //     try-call as the return value) hoist into preceding synthetic let-try binds whose bound bool is
    //     read back as the prefix-not operand; BFS pulls in next_token_text_equals and
    //     is_match_arm_trailing_comma (both already seeded).
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "is_trailing_comma"));
    // format_source is the formatter driver now compiled into stage2 (issue 1165 / 1162). It
    // allocates the output String, tokenizes the source, runs the helper closure above, and returns
    // the owned String handle consumed by the hosted CLI fmt path.
    try pending.append(try component_function_catalog::find_local_function_index(&catalog, "format_source"));
    var index = 0;
    while index < pending.len() {
        let function_index = try pending.get(index);
        if !(try closure_index_seen(&emitted, function_index)) {
            try append_format_closure_helper_body(
                out,
                file.text,
                parsed.ast,
                &catalog,
                function_index,
                &var pending
            );
            try emitted.append(function_index);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn append_format_closure_helper_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    function_index: i64,
    pending: &var std::array::Array<i64>
) -> !void {
    let local_name = try component_function_catalog::local_function_name(catalog, function_index);
    let function_node_id = try component_function_catalog::function_node_id(catalog, function_index);
    try function_signature::append_catalog(out, text, ast, function_node_id, catalog, function_index);
    let body = try function_body_from_node(ast, function_node_id);
    try executable_body::append_catalog_helper_body_ir(
        out,
        text,
        ast,
        catalog,
        function_index,
        format_closure_role(local_name),
        body
    );
    try collect_catalog_closure_direct_callees(
        text,
        ast,
        body,
        catalog,
        pending,
        "selfhost::parser::format::",
        "format closure: unsupported call form",
        "format closure: unsupported qualified callee"
    );
    return;
}

fn format_closure_role(local_name: []u8) -> []u8 {
    if std::mem::equal_bytes(local_name, "token_text") {
        return "checked-format-span-text";
    }
    return "checked-format-predicate";
}

fn kizu_parser_closure_role(local_name: []u8) -> []u8 {
    if std::mem::equal_bytes(local_name, "is_single_token_byte") or
        std::mem::equal_bytes(local_name, "is_double_token_byte") or
        std::mem::equal_bytes(local_name, "is_double_colon_at") or
        std::mem::equal_bytes(local_name, "is_name_byte") or
        std::mem::equal_bytes(local_name, "is_upper_byte") {
        return "checked-parser-byte";
    }
    if std::mem::equal_bytes(local_name, "is_namespace_path_span") or
        std::mem::equal_bytes(local_name, "is_struct_literal_type_span") {
        return "checked-parser-span-predicate";
    }
    if std::mem::equal_bytes(local_name, "is_type_apply_start") or
        std::mem::equal_bytes(local_name, "is_struct_literal_start") {
        return "checked-parser-postfix-start";
    }
    return "checked-parser-predicate";
}

// append_diagnostic_function_facts emits the facts backing the first checked
// Array<T>.get accessor compiled into stage2: std::kizu::diagnostic::Diagnostic.related_get
// (tracker 961). It lands the Diagnostic struct field layout (so self.related resolves
// to field index 2), the RelatedSpan element type-llvm mapping (so the get accessor can
// load the element by value), and the related_get method signature + body, which lowers
// to the checked @kizu_rt_array_at runtime call returning the element as !RelatedSpan. It
// deliberately touches neither the AstNode/AstData union nor any Arena.get accessor.
fn append_diagnostic_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    try append_selected_struct_field_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "Diagnostic",
        "std::kizu::diagnostic::Diagnostic"
    );
    try append_type_llvm_fact(
        out,
        "std::kizu::diagnostic::RelatedSpan",
        "%kizu.kizu.diagnostic.related_span"
    );
    try append_selected_impl_method_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "Diagnostic",
        "related_get",
        "std::kizu::diagnostic::diagnostic_related_get",
        "checked-ast-readonly"
    );
    return;
}

// append_ast_function_facts emits the facts backing the first read-only AST
// accessor compiled into stage2: std::kizu::ast::Ast.len (tracker 961). It lands
// the Ast struct field layout (so self.children resolves to field index 1) and the
// Ast.len method signature + body, which lowers to an array_len builtin call over
// the children Array. It deliberately touches neither the AstNode/AstData union nor
// any Arena.get / array_get / error-union accessor.
pub fn append_ast_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    try append_selected_struct_field_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "Ast",
        "std::kizu::ast::Ast"
    );
    try append_selected_enum_variant_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "BinaryOp",
        "std::kizu::ast::BinaryOp"
    );
    // The BinaryOp constant accessors back the run codegen tape lowering's operator
    // mapping (code_binary_kind compares the matched Binary payload op against
    // them). Each body is a single 'return BinaryOp::<Variant>;' enum-field return,
    // compiled through the existing enum-field-return path, so the tape lowering
    // resolves them as real compiled cross-module callees rather than a handwritten
    // operator tag table.
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_add",
        "std::kizu::ast::binary_add",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_sub",
        "std::kizu::ast::binary_sub",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_mul",
        "std::kizu::ast::binary_mul",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_div",
        "std::kizu::ast::binary_div",
        "checked-ast-readonly"
    );
    // The comparison BinaryOp accessors back the run codegen tape's if-condition
    // lowering (code_binary_kind eq/not_eq/lt/lte/gt/gte); they compile through the
    // same enum-field-return path as the arithmetic accessors above.
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_eq",
        "std::kizu::ast::binary_eq",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_not_eq",
        "std::kizu::ast::binary_not_eq",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_lt",
        "std::kizu::ast::binary_lt",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_lte",
        "std::kizu::ast::binary_lte",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_gt",
        "std::kizu::ast::binary_gt",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "binary_gte",
        "std::kizu::ast::binary_gte",
        "checked-ast-readonly"
    );
    try append_selected_impl_method_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "Ast",
        "len",
        "std::kizu::ast::ast_len",
        "checked-ast-readonly"
    );
    // Ast.child_at composes the checked Array<NodeId>.get accessor with a bounds-check
    // return error(...) (tracker 961). It needs the ChildRange struct fields (range.start
    // = field 0, range.len = field 1) for its index expression and bound, plus the NodeId
    // element type-llvm mapping so self.children.get(...) can load the NodeId by value.
    try append_selected_struct_field_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "ChildRange",
        "std::kizu::ast::ChildRange"
    );
    try append_type_llvm_fact(
        out,
        "std::kizu::ast::NodeId",
        "%kizu.kizu.ast.node_id"
    );
    try append_selected_impl_method_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "Ast",
        "child_at",
        "std::kizu::ast::ast_child_at",
        "checked-ast-readonly"
    );
    // Ast.add_node constructs an AstNode (Span + AstData union) and appends it to the
    // nodes Arena, exercising the AstNode/AstData tagged-union value-type ABI (tracker
    // 961). It needs the AstNode struct fields (span = field 0, data = field 1) to build
    // the element struct, and the Span / AstData / AstNode type-llvm mappings so the
    // union value flows through whole without modelling the 44 variant payload structs.
    try append_selected_struct_field_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "ParseResult",
        "std::kizu::ast::ParseResult"
    );
    try append_selected_struct_field_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "AstNode",
        "std::kizu::ast::AstNode"
    );
    try append_selected_struct_field_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "NodeId",
        "std::kizu::ast::NodeId"
    );
    try append_selected_struct_field_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "Span",
        "std::kizu::ast::Span"
    );
    try append_type_llvm_fact(out, "std::kizu::ast::Span", "%kizu.kizu.ast.span");
    try append_type_llvm_fact(out, "std::kizu::ast::AstData", "%kizu.kizu.ast.ast_data");
    try append_type_llvm_fact(out, "std::kizu::ast::AstNode", "%kizu.kizu.ast.ast_node");
    try append_type_llvm_fact(out, "std::kizu::ast::ParseResult", "%kizu.kizu.ast.parse_result");
    // Ast is the tree receiver every node_count cluster function takes; its type-llvm
    // mapping lets the recursive calls resolve the receiver argument type (tracker 961).
    try append_type_llvm_fact(out, "std::kizu::ast::Ast", "%kizu.kizu.ast.ast");
    try append_selected_impl_method_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "Ast",
        "add_node",
        "std::kizu::ast::ast_add_node",
        "checked-ast-readonly"
    );
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "parse_result",
        "std::kizu::ast::parse_result",
        "checked-ast-constructor"
    );
    // Ast.get reads an AstNode back out of the nodes Arena by value (tracker 961). It
    // reuses the AstNode/AstData union value-type ABI: self.nodes.get(id.raw) calls the
    // checked @kizu_rt_arena_get and loads the AstNode element, trapping on an
    // out-of-bounds index. It needs only the already-emitted Ast/NodeId struct fields
    // and the AstNode type-llvm mapping.
    try append_selected_impl_method_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "Ast",
        "get",
        "std::kizu::ast::ast_get",
        "checked-ast-readonly"
    );
    // The AstData variant payload structs backing the read-only match-over-AstData AST
    // accessors compiled into stage2 (selfhost::ast::declaration_count and the node_count
    // traversal cluster, tracker 961). append_ast_node_variant_facts walks the AstData
    // union in declaration order and emits, for every variant, a union-variant fact whose
    // discriminant tag is the real declaration index (never hardcoded); for each variant
    // whose payload struct an accessor reads by value, it also emits the struct's type-llvm
    // mapping and struct-field facts. The five leaf variants and the payload-less Empty are
    // recorded as union-variant facts only: their arms return the literal 1.
    try append_ast_node_variant_facts(out, file.text, parsed.ast, parsed.root);
    return;
}

// append_ast_node_variant_facts walks the AstData union in declaration order and emits the
// union-variant fact for every variant (the discriminant tag is the declaration index) plus
// the type-llvm + struct-field facts for each variant whose payload struct the node_count
// traversal cluster reads by value (tracker 961). Every fact is appended to out directly
// from the variant's source name (a borrow of text) and string literals, so no intermediate
// String value is constructed or threaded through the helper chain.
fn append_ast_node_variant_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    let union_node_id = try union_node(text, ast, root, "AstData");
    let node = ast.get(union_node_id);
    match node.data {
        UnionDecl(union_decl) => try append_ast_node_variants_loop(
            out,
            text,
            ast,
            root,
            union_decl.variants
        );,
        _ => return error("missing AstData union");,
    }
    return;
}

fn append_ast_node_variants_loop(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    variants: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < variants.len {
        let child = try ast.child_at(variants, index);
        let name = try union_variant_name_text(text, ast, child);
        try emit_one_ast_node_variant(out, text, ast, root, name, index);
        index = index + 1;
    }
    return;
}

// ast_node_variant_kind classifies an AstData variant: 0 = its payload struct is read by
// the node_count cluster (modelled in stage2), 1 = a leaf variant whose arm returns the
// literal 1 (payload struct unmodelled), 2 = the payload-less Empty variant.
fn ast_node_variant_kind(name: []u8) -> i64 {
    if std::mem::equal_bytes(name, "Empty") { return 2; }
    if std::mem::equal_bytes(name, "Int") { return 1; }
    if std::mem::equal_bytes(name, "String") { return 1; }
    if std::mem::equal_bytes(name, "TypeName") { return 1; }
    if std::mem::equal_bytes(name, "Var") { return 1; }
    if std::mem::equal_bytes(name, "Bool") { return 1; }
    return 0;
}

fn emit_one_ast_node_variant(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    name: []u8,
    index: i64
) -> !void {
    let kind = ast_node_variant_kind(name);
    try emit_ast_node_union_variant_fact(out, name, index, kind);
    if kind == 0 {
        try emit_ast_node_type_llvm_fact(out, name);
        try emit_ast_node_struct_field_facts(out, text, ast, root, name);
    }
    return;
}

// emit_ast_node_union_variant_fact appends a 'union-variant std::kizu::ast::AstData <name>
// <tag> <payload>' fact. The payload is the 'std::kizu::ast::<name>Node' qualified type, or
// 'void' for the payload-less Empty variant (kind 2).
fn emit_ast_node_union_variant_fact(
    out: &var std::string::String,
    name: []u8,
    index: i64,
    kind: i64
) -> !void {
    try out.append_bytes("union-variant std::kizu::ast::AstData ");
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    if kind == 2 {
        try out.append_bytes("void");
    } else {
        try out.append_bytes("std::kizu::ast::");
        try out.append_bytes(name);
        try out.append_bytes("Node");
    }
    try out.append_byte(cast<u8>(10));
    return;
}

// emit_ast_node_type_llvm_fact appends a 'type-llvm std::kizu::ast::<name>Node
// %kizu.kizu.ast.<snake>_node' fact for a modelled variant payload struct.
fn emit_ast_node_type_llvm_fact(out: &var std::string::String, name: []u8) -> !void {
    try out.append_bytes("type-llvm std::kizu::ast::");
    try out.append_bytes(name);
    try out.append_bytes("Node %kizu.kizu.ast.");
    try append_camel_to_snake(out, name);
    try out.append_bytes("_node");
    try out.append_byte(cast<u8>(10));
    return;
}

// emit_ast_node_struct_field_facts finds the StructDecl named '<name>Node' and emits a
// 'struct-field std::kizu::ast::<name>Node <index> <field> <type>' fact per field, matching
// the layout append_selected_struct_field_facts emits for the explicitly-named structs.
fn emit_ast_node_struct_field_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    name: []u8
) -> !void {
    let struct_node_id = try find_ast_node_struct(text, ast, root, name);
    let node = ast.get(struct_node_id);
    match node.data {
        StructDecl(struct_decl) => try emit_ast_node_struct_fields(
            out,
            text,
            ast,
            name,
            struct_decl.fields
        );,
        _ => return error("missing AstData node struct");,
    }
    return;
}

fn emit_ast_node_struct_fields(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: []u8,
    fields: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < fields.len {
        let field = try ast.child_at(fields, index);
        let node = ast.get(field);
        match node.data {
            Field(field_node) => try emit_ast_node_struct_field(
                out,
                text,
                ast,
                name,
                index,
                field_node.name,
                field_node.type_node
            );,
            _ => return error("missing AstData node struct field");,
        }
        index = index + 1;
    }
    return;
}

fn emit_ast_node_struct_field(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: []u8,
    index: i64,
    field_name: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes("struct-field std::kizu::ast::");
    try out.append_bytes(name);
    try out.append_bytes("Node ");
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    let field_text = ast_node_text(text, ast, field_name);
    try out.append_bytes(field_text);
    try out.append_byte(cast<u8>(32));
    try function_signature::append_type_token_pub(out, text, ast, type_node);
    try out.append_byte(cast<u8>(10));
    return;
}

// find_ast_node_struct returns the StructDecl whose declared name is '<name>Node', comparing
// bytes directly so no search string is allocated (tracker 961).
fn find_ast_node_struct(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    name: []u8
) -> !std::kizu::ast::NodeId {
    let node = ast.get(root);
    match node.data {
        Program(program) => return find_ast_node_struct_in_program(
            text,
            ast,
            program.declarations,
            name
        );,
        _ => return error("missing AstData node struct");,
    }
}

fn find_ast_node_struct_in_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    name: []u8
) -> !std::kizu::ast::NodeId {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if ast_node_struct_name_matches(text, ast, child, name) {
            return child;
        }
        index = index + 1;
    }
    return error("missing AstData node struct");
}

fn ast_node_struct_name_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        StructDecl(struct_decl) => struct_name_is_variant_node(text, ast, struct_decl.name, name),
        _ => false,
    };
}

// struct_name_is_variant_node reports whether the struct name text equals name ++ "Node".
fn struct_name_is_variant_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name_node: std::kizu::ast::NodeId,
    name: []u8
) -> bool {
    let struct_name = ast_node_text(text, ast, name_node);
    let struct_len = std::mem::len(struct_name);
    let name_len = std::mem::len(name);
    if struct_len != name_len + 4 {
        return false;
    }
    if !std::mem::starts_with(struct_name, name) {
        return false;
    }
    return std::mem::equal_bytes(struct_name[name_len..struct_len], "Node");
}

// append_camel_to_snake appends name to out converting CamelCase to snake_case: each
// uppercase byte becomes '_' (skipped at the front) + its lowercase form. ProgramNode ->
// program_node, FnDecl -> fn_decl, TypeApplyExpr -> type_apply_expr (tracker 961).
fn append_camel_to_snake(out: &var std::string::String, name: []u8) -> !void {
    let len = std::mem::len(name);
    var i = 0;
    while i < len {
        let byte = name[i];
        if byte >= cast<u8>(65) and byte <= cast<u8>(90) {
            if i > 0 {
                try out.append_byte(cast<u8>(95));
            }
            try out.append_byte(byte + cast<u8>(32));
        } else {
            try out.append_byte(byte);
        }
        i = i + 1;
    }
    return;
}

// append_selfhost_ast_function_facts emits the facts backing the first match-over-AstData
// read-only AST accessor compiled into stage2: selfhost::ast::declaration_count (tracker
// 961). Its body is 'let node = tree.get(root); return match node.data {
// Program(program) => program.declarations.len, _ => 0 };', which lowers to an Ast.get
// call binding an AstNode, a union tag dispatch on AstData, and the active arm's payload
// field access. The AstData/ProgramNode/ChildRange struct, type-llvm, and union-variant
// facts it consumes are emitted alongside std::kizu::ast above.
pub fn append_selfhost_ast_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    var catalog = try component_function_catalog::collect_from_ast(
        allocator,
        file.text,
        parsed.ast,
        parsed.root,
        "selfhost::ast"
    );
    defer catalog.deinit();

    var pending = std::array::Array<i64>(std::mem::page_allocator());
    var emitted = std::array::Array<i64>(std::mem::page_allocator());
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "declaration_count"));
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "node_count"));
    var index = 0;
    while index < pending.len() {
        let function_index = try pending.get(index);
        if !(try closure_index_seen(&emitted, function_index)) {
            try append_selfhost_ast_closure_helper_body(
                out,
                file.text,
                parsed.ast,
                &catalog,
                function_index,
                &var pending
            );
            try emitted.append(function_index);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn append_selfhost_ast_closure_helper_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    function_index: i64,
    pending: &var std::array::Array<i64>
) -> !void {
    let local_name = try component_function_catalog::local_function_name(catalog, function_index);
    let function_node_id = try component_function_catalog::function_node_id(catalog, function_index);
    try function_signature::append_catalog(out, text, ast, function_node_id, catalog, function_index);
    let body = try function_body_from_node(ast, function_node_id);
    try executable_body::append_catalog_helper_body_ir(
        out,
        text,
        ast,
        catalog,
        function_index,
        selfhost_ast_closure_role(local_name),
        body
    );
    try collect_catalog_closure_direct_callees(
        text,
        ast,
        body,
        catalog,
        pending,
        "selfhost::ast::",
        "selfhost ast closure: unsupported call form",
        "selfhost ast closure: unsupported qualified callee"
    );
    return;
}

fn selfhost_ast_closure_role(local_name: []u8) -> []u8 {
    if std::mem::equal_bytes(local_name, "declaration_count") {
        return "checked-ast-match";
    }
    return "checked-ast-traversal";
}

// append_selected_function_signature emits only the function-signature facts (return type
// + param types) for a top-level helper named local_name, without its body. It backs the
// type/facts foundation for functions whose lowering lands in a later PR (tracker 961).
fn append_selected_function_signature(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    local_name: []u8,
    qualified_name: []u8
) -> !void {
    let function_node_id = try function_node(text, ast, root, local_name);
    try function_signature::append(out, text, ast, function_node_id, qualified_name);
    return;
}

fn union_variant_name_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ![]u8 {
    let node = ast.get(node_id);
    match node.data {
        UnionVariant(variant) => return ast_node_text(text, ast, variant.name);,
        _ => return error("expected union variant");,
    }
}

fn emit_union_variant_fact(
    out: &var std::string::String,
    qualified_union: []u8,
    variant_name: []u8,
    index: i64,
    payload_qualified: []u8
) -> !void {
    try out.append_bytes("union-variant ");
    try out.append_bytes(qualified_union);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(variant_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(payload_qualified);
    try out.append_byte(cast<u8>(10));
    return;
}

fn union_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    union_name: []u8
) -> !std::kizu::ast::NodeId {
    let node = ast.get(root);
    match node.data {
        Program(program) => return union_node_in_program(
            text,
            ast,
            program.declarations,
            union_name
        );,
        _ => return error("missing selected executable union");,
    }
}

fn union_node_in_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    union_name: []u8
) -> !std::kizu::ast::NodeId {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if union_node_matches(text, ast, child, union_name) {
            return child;
        }
        index = index + 1;
    }
    return error("missing selected executable union");
}

fn union_node_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        UnionDecl(union_decl) => std::mem::equal_bytes(
            ast_node_text(text, ast, union_decl.name),
            name
        ),
        _ => false,
    };
}

fn append_source_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    var catalog = try component_function_catalog::collect_from_ast(
        allocator,
        file.text,
        parsed.ast,
        parsed.root,
        "selfhost::source"
    );
    defer catalog.deinit();
    try append_type_llvm_fact(out, "selfhost::source::SourceFile", "%kizu.selfhost.source.source_file");
    try append_selected_struct_field_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "SourceFile",
        "selfhost::source::SourceFile"
    );
    try append_selected_enum_variant_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "SourceKind",
        "source::SourceKind"
    );
    try append_selected_enum_variant_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "SourceKind",
        "selfhost::source::SourceKind"
    );
    try append_source_reachable_helper_bodies(
        out,
        file.text,
        parsed.ast,
        &catalog
    );
    return;
}

// append_source_reachable_helper_bodies keeps the source-module frontend slice on explicit seeds
// plus direct callees resolved through the component function catalog.
fn append_source_reachable_helper_bodies(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog
) -> !void {
    var pending = std::array::Array<i64>(std::mem::page_allocator());
    var emitted = std::array::Array<i64>(std::mem::page_allocator());
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "is_source_code"));
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "is_frontend_source"));
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "module_path"));
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "is_absolute_name_for_file"));
    var index = 0;
    while index < pending.len() {
        let function_index = try pending.get(index);
        if !(try closure_index_seen(&emitted, function_index)) {
            try append_source_closure_helper_body(
                out,
                text,
                ast,
                catalog,
                function_index,
                &var pending
            );
            try emitted.append(function_index);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn append_source_closure_helper_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    function_index: i64,
    pending: &var std::array::Array<i64>
) -> !void {
    let local_name = try component_function_catalog::local_function_name(catalog, function_index);
    let role = source_closure_role(local_name);
    let function_node_id = try component_function_catalog::function_node_id(catalog, function_index);
    try function_signature::append_catalog(out, text, ast, function_node_id, catalog, function_index);
    let body = try function_body_from_node(ast, function_node_id);
    try executable_body::append_catalog_helper_body_ir(
        out,
        text,
        ast,
        catalog,
        function_index,
        role,
        body
    );
    try collect_catalog_closure_direct_callees(
        text,
        ast,
        body,
        catalog,
        pending,
        "selfhost::source::",
        "source closure: unsupported call form",
        "source closure: unsupported qualified callee"
    );
    return;
}

fn closure_index_seen(
    indexes: &std::array::Array<i64>,
    function_index: i64
) -> !bool {
    var index = 0;
    while index < indexes.len() {
        let existing = try indexes.get(index);
        if existing == function_index {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn source_closure_role(local_name: []u8) -> []u8 {
    if std::mem::equal_bytes(local_name, "is_source_code") or
        std::mem::equal_bytes(local_name, "is_frontend_source") {
        return "source-kind";
    }
    return "source-file";
}

fn collect_catalog_closure_direct_callees(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => try collect_catalog_closure_direct_callees_in_range(
            text, ast, program.declarations, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        Prefix(prefix) => try collect_catalog_closure_direct_callees(
            text, ast, prefix.right, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        Binary(binary) => try collect_catalog_closure_two_node_callees(
            text, ast, binary.left, binary.right, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        FieldExpr(field) => try collect_catalog_closure_direct_callees(
            text, ast, field.receiver, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        DerefExpr(deref) => try collect_catalog_closure_direct_callees(
            text, ast, deref.receiver, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        Call(call) => try collect_catalog_closure_call_parts(
            text, ast, call.callee, call.args, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        TypeApplyExpr(type_apply) => try collect_catalog_closure_node_range_callees(
            text, ast, type_apply.callee, type_apply.type_args, catalog, pending,
            qualified_prefix, unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        CastExpr(cast_expr) => try collect_catalog_closure_direct_callees(
            text, ast, cast_expr.value, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        IndexExpr(index_expr) => try collect_catalog_closure_three_node_callees(
            text, ast, index_expr.target, index_expr.start, index_expr.end, catalog,
            pending, qualified_prefix, unsupported_call_form_error,
            unsupported_qualified_callee_error
        );,
        StructLiteralExpr(struct_literal) => try collect_catalog_closure_direct_callees_in_range(
            text, ast, struct_literal.fields, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        StructFieldInit(field_init) => try collect_catalog_closure_direct_callees(
            text, ast, field_init.value, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        ArenaNewExpr(arena_new) => try collect_catalog_closure_direct_callees(
            text, ast, arena_new.allocator, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        TryExpr(try_expr) => try collect_catalog_closure_direct_callees(
            text, ast, try_expr.value, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        ComptimeExpr(comptime_expr) => try collect_catalog_closure_direct_callees(
            text, ast, comptime_expr.value, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        Block(block) => try collect_catalog_closure_direct_callees_in_range(
            text, ast, block.statements, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        If(if_node) => try collect_catalog_closure_three_node_callees(
            text, ast, if_node.condition, if_node.then_block, if_node.else_block,
            catalog, pending, qualified_prefix, unsupported_call_form_error,
            unsupported_qualified_callee_error
        );,
        Let(let_node) => try collect_catalog_closure_direct_callees(
            text, ast, let_node.value, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        Assign(assign) => try collect_catalog_closure_two_node_callees(
            text, ast, assign.target, assign.value, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        Return(return_node) => try collect_catalog_closure_direct_callees(
            text, ast, return_node.value, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        Defer(defer_node) => try collect_catalog_closure_direct_callees(
            text, ast, defer_node.expr, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        ErrDefer(err_defer_node) => try collect_catalog_closure_direct_callees(
            text, ast, err_defer_node.expr, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        ExprStmt(expr_stmt) => try collect_catalog_closure_direct_callees(
            text, ast, expr_stmt.expr, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        While(while_node) => try collect_catalog_closure_three_node_callees(
            text, ast, while_node.label, while_node.condition, while_node.body,
            catalog, pending, qualified_prefix, unsupported_call_form_error,
            unsupported_qualified_callee_error
        );,
        For(for_node) => try collect_catalog_closure_five_node_callees(
            text, ast, for_node.label, for_node.name, for_node.start, for_node.end,
            for_node.body, catalog, pending, qualified_prefix, unsupported_call_form_error,
            unsupported_qualified_callee_error
        );,
        Match(match_node) => try collect_catalog_closure_node_range_callees(
            text, ast, match_node.value, match_node.arms, catalog, pending,
            qualified_prefix, unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        MatchArm(match_arm) => try collect_catalog_closure_direct_callees(
            text, ast, match_arm.body, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        Unsafe(unsafe_node) => try collect_catalog_closure_direct_callees(
            text, ast, unsafe_node.body, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        ComptimeIf(comptime_if) => try collect_catalog_closure_three_node_callees(
            text, ast, comptime_if.condition, comptime_if.then_block,
            comptime_if.else_block, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        FnDecl(fn_decl) => try collect_catalog_closure_direct_callees(
            text, ast, fn_decl.body, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        _ => return;,
    }
    return;
}

fn collect_catalog_closure_direct_callees_in_range(
    text: []u8,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        try collect_catalog_closure_direct_callees(
            text, ast, child, catalog, pending, qualified_prefix,
            unsupported_call_form_error, unsupported_qualified_callee_error
        );
        index = index + 1;
    }
    return;
}

fn collect_catalog_closure_two_node_callees(
    text: []u8,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    try collect_catalog_closure_direct_callees(
        text, ast, first, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees(
        text, ast, second, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    return;
}

fn collect_catalog_closure_three_node_callees(
    text: []u8,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    try collect_catalog_closure_direct_callees(
        text, ast, first, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees(
        text, ast, second, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees(
        text, ast, third, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    return;
}

fn collect_catalog_closure_five_node_callees(
    text: []u8,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    fourth: std::kizu::ast::NodeId,
    fifth: std::kizu::ast::NodeId,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    try collect_catalog_closure_direct_callees(
        text, ast, first, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees(
        text, ast, second, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees(
        text, ast, third, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees(
        text, ast, fourth, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees(
        text, ast, fifth, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    return;
}

fn collect_catalog_closure_node_range_callees(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    try collect_catalog_closure_direct_callees(
        text, ast, node_id, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees_in_range(
        text, ast, range, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    return;
}

fn collect_catalog_closure_call_parts(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    try collect_catalog_closure_call_callee(
        text, ast, callee, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    try collect_catalog_closure_direct_callees_in_range(
        text, ast, args, catalog, pending, qualified_prefix,
        unsupported_call_form_error, unsupported_qualified_callee_error
    );
    return;
}

fn collect_catalog_closure_call_callee(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    let callee_text = ast_node_text(text, ast, callee);
    if std::mem::starts_with(callee_text, "std::mem::") {
        return;
    }
    if std::mem::equal_bytes(callee_text, "error") {
        return;
    }
    // The 'std::array::Array<T>(<allocator>)' constructor is the element-size-generic
    // @kizu_rt_array_new runtime builtin lowered inline, not a component function, so the
    // closure does not walk it (issue 1165).
    if std::mem::starts_with(callee_text, "std::array::Array") {
        return;
    }
    // The 'std::string::String(<allocator>)' value constructor is the runtime-owned
    // byte-buffer handle lowered inline through the @kizu_rt_string_new ABI (routed via the
    // std::string::String stdlib-symbol fact), not a component function, so the closure does
    // not walk it -- mirroring the std::array::Array constructor handling (issue 1165 / 1162).
    if std::mem::equal_bytes(callee_text, "std::string::String") {
        return;
    }
    if collect_catalog_closure_external_callee_allowed(callee_text, qualified_prefix) {
        return;
    }
    let node = ast.get(callee);
    match node.data {
        Var(_) => return collect_catalog_closure_var_callee(callee_text, catalog, pending);,
        FieldExpr(field) => return collect_catalog_closure_field_callee(
            text, ast, field.namespace, field.name, callee_text, catalog, pending,
            qualified_prefix, unsupported_call_form_error, unsupported_qualified_callee_error
        );,
        _ => return error(unsupported_call_form_error);,
    }
    return;
}

// collect_catalog_closure_field_callee classifies a FieldExpr callee. A field-mode
// method on a value receiver (tokens.len() / tokens.get(...) / indices.set(...) /
// indices.append(...)) is an Array<T> element builtin lowered inline through the
// element-size-generic array runtime ABI, not a component function, so the closure does
// not walk it (issue 1165); the std::string::String mutators out.append_bytes(...) /
// out.append_byte(...) lower inline through the @kizu_rt_string_append_* ABI the same way.
// '.deinit()' is the owned-handle destructor shared by std::array::Array<T> and
// std::string::String: both lower it inline through their runtime free ABI, so it is a generic
// owned-handle builtin rather than a component member (it carries no resolved receiver type at
// this pre-resolution AST layer, so it is admitted at the same generic value-method level as the
// element / append builtins, not narrowed by receiver). Its necessity is exercised on the real
// format_source walk by format_driver_facts_gate, whose driver frees format_tokens / leading_imports
// through '.deinit()' (issue 1165 / 1162). Any other value-method callee is an explicit error. A
// namespace-mode FieldExpr is a qualified callee resolved against the component prefix.
fn collect_catalog_closure_field_callee(
    text: []u8,
    ast: std::kizu::ast::Ast,
    namespace: bool,
    name_node: std::kizu::ast::NodeId,
    callee_text: []u8,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_call_form_error: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    if !namespace {
        let method = ast_node_text(text, ast, name_node);
        if std::mem::equal_bytes(method, "len") or std::mem::equal_bytes(method, "get") or
            std::mem::equal_bytes(method, "set") or std::mem::equal_bytes(method, "append") or
            std::mem::equal_bytes(method, "append_bytes") or
            std::mem::equal_bytes(method, "append_byte") or
            std::mem::equal_bytes(method, "deinit") {
            return;
        }
        return error(unsupported_call_form_error);
    }
    return collect_catalog_closure_qualified_callee(
        callee_text, catalog, pending, qualified_prefix, unsupported_qualified_callee_error
    );
}

fn collect_catalog_closure_external_callee_allowed(
    callee_text: []u8,
    qualified_prefix: []u8
) -> bool {
    if std::mem::equal_bytes(qualified_prefix, "selfhost::parser::format::") {
        // The formatter's token-array predicates call lexer::is_eof (the std::kizu::lexer
        // Token EOF predicate) through the 'lexer' import alias. It is emitted by the std
        // lexer compiled closure, so the format closure references it as an external
        // callee instead of walking it (issue 1165). format_source additionally seeds its
        // token stream through lexer::tokenize (the selfhost::lexer tokenizer entry), another
        // cross-module callee emitted by the lexer closure, so it is allowed the same way
        // (issue 1165 / 1162).
        return std::mem::equal_bytes(callee_text, "lexer::is_eof") or
            std::mem::equal_bytes(callee_text, "lexer::tokenize");
    }
    if std::mem::equal_bytes(qualified_prefix, "std::kizu::parser::") {
        return std::mem::equal_bytes(callee_text, "ast.get");
    }
    if std::mem::equal_bytes(qualified_prefix, "selfhost::ir::codegen::") {
        return codegen_closure_external_callee_allowed(callee_text);
    }
    if std::mem::equal_bytes(qualified_prefix, "selfhost::ir::code_render::") {
        return code_render_closure_external_callee_allowed(callee_text);
    }
    if std::mem::equal_bytes(qualified_prefix, "selfhost::backend::executable::") {
        return executable_closure_external_callee_allowed(callee_text);
    }
    if std::mem::equal_bytes(qualified_prefix, "selfhost::backend::hosted::") {
        return hosted_closure_external_callee_allowed(callee_text);
    }
    if std::mem::equal_bytes(qualified_prefix, "selfhost::backend::") {
        return backend_wrapper_external_callee_allowed(callee_text);
    }
    if !std::mem::equal_bytes(qualified_prefix, "selfhost::ast::") {
        return false;
    }
    return std::mem::equal_bytes(callee_text, "tree.get") or
        std::mem::equal_bytes(callee_text, "tree.child_at");
}

// executable_closure_external_callee_allowed enumerates the executable_lowering
// module boundary callees the selected executable closure is allowed to cross
// without emitting their bodies. lower_test_executable delegates to
// executable_lowering::lower_test_executable, whose body facts are owned by the
// executable lowering IR rather than this backend closure. Anything outside this
// explicit allowlist falls through to the shared collector's qualified-callee
// error instead of being silently dropped.
fn executable_closure_external_callee_allowed(callee_text: []u8) -> bool {
    return std::mem::equal_bytes(callee_text, "ast.get") or
        std::mem::equal_bytes(callee_text, "executable_lowering::lower_test_executable");
}

// hosted_closure_external_callee_allowed enumerates the codegen module boundary
// callees the seeded hosted helper closure is allowed to cross without emitting
// their bodies. The closure now seeds from hosted_executable_metadata_from_codegen,
// whose only codegen crossing is metadata_for_program (the stdout_payload crossing
// moved onto the selected render_main_print_llvm body). Anything outside this
// explicit allowlist falls through to the shared collector's qualified-callee
// error instead of being silently dropped.
fn hosted_closure_external_callee_allowed(callee_text: []u8) -> bool {
    return std::mem::equal_bytes(callee_text, "codegen::metadata_for_program");
}

// backend_wrapper_external_callee_allowed enumerates the cross-component module
// boundary callees the selected backend wrapper closure is allowed to cross
// without emitting their bodies. lower_run_codegen_program delegates to
// codegen::lower_run_program and emit_run_codegen_artifact delegates to
// hosted::emit_run_codegen_artifact, whose body facts are owned by the codegen
// and hosted closures respectively. Anything outside this explicit allowlist
// falls through to the shared collector's qualified-callee error instead of being
// silently dropped.
fn backend_wrapper_external_callee_allowed(callee_text: []u8) -> bool {
    return std::mem::equal_bytes(callee_text, "codegen::lower_run_program") or
        std::mem::equal_bytes(callee_text, "hosted::emit_run_codegen_artifact");
}

// code_render_closure_external_callee_allowed enumerates the cross-module callees the
// run tape renderer references: the selfhost::ir::codegen opcode/value-kind constant
// accessors (codegen::code_op_* / codegen::code_kind_*), pure i64 returns already
// compiled by the codegen closure, referenced here without re-walking them.
fn code_render_closure_external_callee_allowed(callee_text: []u8) -> bool {
    // render_run_artifact lowers the parsed run source into the tape through the
    // codegen module's lower_code_module entry, already compiled by the codegen
    // closure, so the render closure references it without re-walking it.
    if std::mem::equal_bytes(callee_text, "codegen::lower_code_module") {
        return true;
    }
    return std::mem::starts_with(callee_text, "codegen::code_op_") or
        std::mem::starts_with(callee_text, "codegen::code_kind_") or
        std::mem::starts_with(callee_text, "codegen::code_loop_kind_");
}

fn codegen_closure_external_callee_allowed(callee_text: []u8) -> bool {
    if std::mem::equal_bytes(callee_text, "ast.get") {
        return true;
    }
    if std::mem::equal_bytes(callee_text, "ast.child_at") {
        return true;
    }
    if std::mem::starts_with(callee_text, "std::kizu::ast::binary_") {
        return codegen_closure_binary_op_accessor_allowed(callee_text);
    }
    // lower_run_int_program is documented in codegen.kizu as outside the selected
    // stage2 IR body-fact set because it depends on mutable String scratch APIs.
    return std::mem::equal_bytes(callee_text, "lower_run_int_program");
}

fn codegen_closure_binary_op_accessor_allowed(callee_text: []u8) -> bool {
    return std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_add") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_sub") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_mul") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_div") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_eq") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_not_eq") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_lt") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_lte") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_gt") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_gte") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_and") or
        std::mem::equal_bytes(callee_text, "std::kizu::ast::binary_or");
}

fn collect_catalog_closure_var_callee(
    callee_text: []u8,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>
) -> !void {
    try pending.append(try component_function_catalog::find_local_function_index(catalog, callee_text));
    return;
}

fn collect_catalog_closure_qualified_callee(
    callee_text: []u8,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    pending: &var std::array::Array<i64>,
    qualified_prefix: []u8,
    unsupported_qualified_callee_error: []u8
) -> !void {
    if !std::mem::starts_with(callee_text, qualified_prefix) {
        return error(unsupported_qualified_callee_error);
    }
    try pending.append(try component_function_catalog::find_qualified_function_index(catalog, callee_text));
    return;
}

fn append_loader_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();
    var catalog = try component_function_catalog::collect_from_ast(
        allocator,
        file.text,
        parsed.ast,
        parsed.root,
        "selfhost::source::loader"
    );
    defer catalog.deinit();
    try append_type_llvm_fact(out, "source::SourceFile", "%kizu.selfhost.source.source_file");
    try append_loader_reachable_helper_bodies(
        out,
        file.text,
        parsed.ast,
        &catalog
    );
    return;
}

fn append_loader_reachable_helper_bodies(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog
) -> !void {
    var pending = std::array::Array<i64>(std::mem::page_allocator());
    var emitted = std::array::Array<i64>(std::mem::page_allocator());
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "package_module_end"));
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "is_manifest_root_source"));
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "package_module_start"));
    try pending.append(try component_function_catalog::find_local_function_index(catalog, "source_file"));
    var index = 0;
    while index < pending.len() {
        let function_index = try pending.get(index);
        if !(try closure_index_seen(&emitted, function_index)) {
            try append_loader_closure_helper_body(
                out,
                text,
                ast,
                catalog,
                function_index,
                &var pending
            );
            try emitted.append(function_index);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn append_loader_closure_helper_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    function_index: i64,
    pending: &var std::array::Array<i64>
) -> !void {
    let function_node_id = try component_function_catalog::function_node_id(catalog, function_index);
    try function_signature::append_catalog(out, text, ast, function_node_id, catalog, function_index);
    let body = try function_body_from_node(ast, function_node_id);
    try executable_body::append_catalog_helper_body_ir(
        out,
        text,
        ast,
        catalog,
        function_index,
        "loader-path",
        body
    );
    try collect_catalog_closure_direct_callees(
        text,
        ast,
        body,
        catalog,
        pending,
        "selfhost::source::loader::",
        "loader closure: unsupported call form",
        "loader closure: unsupported qualified callee"
    );
    return;
}

fn append_lexer_function_facts(
    allocator: Allocator,
