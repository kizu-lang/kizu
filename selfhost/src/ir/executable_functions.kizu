}

fn append_codegen_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try append_selected_enum_variant_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "ValueKind",
        "selfhost::ir::codegen::ValueKind"
    );
    try append_selected_enum_variant_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "InstructionKind",
        "selfhost::ir::codegen::InstructionKind"
    );
    try append_selected_enum_variant_facts(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "RunStatementKind",
