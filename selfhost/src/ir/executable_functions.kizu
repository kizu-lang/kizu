    // ast_node_text is the span-based text slicing accessor the run-codegen AST traversal
    // depends on (tracker 961): it binds an AstNode via Ast.get, slices the source text by the
    // node's span, and trims the slice via std::mem::trim_ascii. It is registered in the codegen
    // module so the run path's recursive callee symbol resolves once the scanner is removed.
    try append_selected_helper_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "ast_node_text",
        "selfhost::ir::codegen::ast_node_text",
        "checked-text-accessor"
    );
