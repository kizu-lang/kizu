import selfhost::parser;
import selfhost::ir::executable_body;
import selfhost::ir::function_signature;
import selfhost::source;

pub fn append_facts(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>
) -> !void {
    var execute_found = false;
    var codegen_found = false;
    var backend_found = false;
    var executable_found = false;
    var hosted_found = false;

    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind == source::SourceKind::Selfhost {
            let module = source::module_path(file);
            if std::mem::equal_bytes(module, "cli/execute") {
                try append_execute_function_facts(allocator, out, file);
                execute_found = true;
            }
            if std::mem::equal_bytes(module, "ir/codegen") {
                try append_codegen_function_facts(allocator, out, file);
                codegen_found = true;
            }
            if std::mem::equal_bytes(module, "backend") {
                try append_backend_function_facts(allocator, out, file);
                backend_found = true;
            }
            if std::mem::equal_bytes(module, "backend/executable") {
                try append_executable_function_facts(allocator, out, file);
                executable_found = true;
            }
            if std::mem::equal_bytes(module, "backend/hosted") {
                try append_hosted_function_facts(allocator, out, file);
                hosted_found = true;
            }
        }
        index = index + 1;
    }
    if !execute_found {
        return error("missing executable CLI source");
    }
    if !codegen_found {
        return error("missing codegen source");
    }
    if !backend_found {
        return error("missing backend source");
    }
    if !executable_found {
        return error("missing executable lowering source");
    }
    if !hosted_found {
        return error("missing executable hosted backend source");
    }
    return;
}

fn append_codegen_function_facts(
    allocator: Allocator,
    out: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    defer parsed.deinit();

    try append_selected_function_with_body(
        out,
        file.text,
        parsed.ast,
        parsed.root,
        "lower_run_program",
        "selfhost::ir::codegen::lower_run_program",
        "checked-run-codegen-lowering"
