import selfhost::ownership::data;

pub struct SourceFunctionRoot {
    pub source_id: i64,
    pub name_start: i64,
    pub name_end: i64,
}

enum PackageClosureRootKind {
    ExternalAbi,
    SourceFunctions,
}

fn function_body_from_node(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return fn_decl.body;,
        _ => return error("missing selected executable function body");,
    }
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let span = ast.get(node_id).span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}

pub fn append_facts(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>
) -> !void {
    try package_type_facts::append_core_abi_representation_facts(out);

    // Pass one owns package identity construction. No closure is emitted until
    // every parsed component and function has received its stable numeric ID.
    var parsed_package = try parser::parse_source_files(allocator, files);
    var roots = std::array::Array<SourceFunctionRoot>(allocator);
    defer roots.deinit();
    let result = append_facts_from_parsed(
        allocator, out, files, &parsed_package,
        PackageClosureRootKind::ExternalAbi, &roots
    );
    try parser::deinit_parsed_source_files(parsed_package);
    return result;
}

pub fn append_source_root_facts(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>,
    parsed_package: &parser::ParsedSourceFiles,
    roots: &std::array::Array<SourceFunctionRoot>
) -> !void {
    if roots.len() == 0 {
        return error("source function roots missing");
    }
    try package_type_facts::append_core_abi_representation_facts(out);
    return append_facts_from_parsed(
        allocator, out, files, parsed_package,
        PackageClosureRootKind::SourceFunctions, roots
    );
}

pub fn checked_entry_root(
    files: &std::array::Array<source::SourceFile>,
    checked: &data::CheckedPackage
) -> !SourceFunctionRoot {
    if checked.diagnostics != 0 {
        return error("checked entry root requires a diagnostic-free package");
    }
    if checked.entry_function.span_start < 0 or
        checked.entry_function.span_end <= checked.entry_function.span_start {
        return error("checked entry root span invalid");
    }
    var matched = false;
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.id == checked.module.source_id {
            if matched {
                return error("checked entry root source ID is not unique");
            }
            if file.kind != checked.module.kind or
                file.module_start != checked.module.module_start or
                file.module_end != checked.module.module_end or
                !std::mem::equal_bytes(file.path, checked.module.path) {
                return error("checked entry root source identity mismatch");
            }
            matched = true;
        }
        index = index + 1;
    }
    if !matched {
        return error("checked entry root source missing");
    }
    return SourceFunctionRoot {
        source_id: checked.module.source_id,
        name_start: checked.entry_function.span_start,
        name_end: checked.entry_function.span_end
    };
}

fn append_facts_from_parsed(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>,
    parsed_package: &parser::ParsedSourceFiles,
    root_kind: PackageClosureRootKind,
    source_roots: &std::array::Array<SourceFunctionRoot>
) -> !void {
    var package_catalog = try package_catalog_collect::collect_from_parsed_files(
        allocator, files, parsed_package
    );
    defer package_catalog.deinit();
    try package_dependency_graph::append_package_root_facts(out, &package_catalog);
    try package_dependency_graph::append_module_alias_facts(out, &package_catalog);
    try package_dependency_graph::append_function_owner_module_facts(out, &package_catalog);
    try package_dependency_graph::append_function_type_parameter_facts(
        out, &package_catalog
    );
    // Type discovery is package-wide and independent from function reachability.
    // This includes type-only components such as selfhost::backend::data; LLVM
    // declarations remain demand-driven by reachable-type roots in the backend.
    try package_type_facts::append_package_component_type_facts(
        out, files, parsed_package, &package_catalog
    );
    var resolved_package_calls = try package_call_resolution::resolve_package_calls_with_types(
        allocator, files, parsed_package, &package_catalog
    );
    defer resolved_package_calls.deinit();
    var package_dependencies = try package_dependency_graph::dependency_graph(allocator, &package_catalog);
    defer package_dependencies.deinit();
    try package_call_resolution::append_resolved_dependencies(
        &var package_dependencies, &package_catalog, &resolved_package_calls.calls
    );
    var emitted_targets = try package_dependency_graph::body_emission_registry(allocator, &package_catalog);
    defer emitted_targets.deinit();
    if root_kind == PackageClosureRootKind::ExternalAbi {
        try append_numeric_package_closure(
            allocator, out, files, parsed_package, &package_catalog, &package_dependencies,
            &var emitted_targets
        );
    }
    if root_kind == PackageClosureRootKind::SourceFunctions {
        try append_source_numeric_package_closure(
            allocator, out, files, parsed_package, &package_catalog, &package_dependencies,
            source_roots, &var emitted_targets
        );
    }

    var semantic_session = package_semantic_session::init(allocator);
    defer semantic_session.deinit();
    try package_semantic_session::append_reachable_instances(
        &var semantic_session,
        allocator,
        &package_catalog,
        &resolved_package_calls.calls,
        &resolved_package_calls.canonical_types,
        &emitted_targets
    );
    try package_semantic_session::append_function_instance_facts(
        out, &semantic_session, &package_catalog
    );
    try append_resolved_call_target_facts(
        out, &package_catalog, &resolved_package_calls.calls,
        &resolved_package_calls.canonical_types, &emitted_targets
    );
    return;
}

// numeric_package_collector_gate drives the production package parser,
// numeric call resolver, dependency graph, and definition emitter from the
// production checked ConstructorFacts handoff.
pub fn numeric_package_collector_gate() -> !void {
    var out = try numeric_package_collector_facts();
    defer out.deinit();
    let output = out.as_bytes();
    print(output);
    return;
}

// numeric_package_collector_facts returns the owned production resolver output
// so backend gates exercise the same file handoff as the CLI.
pub fn numeric_package_collector_facts() -> !std::string::String {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var files = try loader::load_selfhost_sources(allocator, io, "selfhost");
    defer files.deinit();
    var parsed = try parser::parse_source_files(allocator, &files);
    let result = numeric_package_collector_facts_from_parsed(
        allocator, &files, &parsed
    );
    try parser::deinit_parsed_source_files(parsed);
    return result;
}

fn numeric_package_collector_facts_from_parsed(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed: &parser::ParsedSourceFiles
) -> !std::string::String {
    var catalog = try package_catalog_collect::collect_from_parsed_files(
        allocator, files, parsed
    );
    defer catalog.deinit();
    var graph = try package_dependency_graph::dependency_graph(allocator, &catalog);
    defer graph.deinit();
    var resolved_calls = try package_call_resolution::resolve_package_calls_with_types(
        allocator, files, parsed, &catalog
    );
    defer resolved_calls.deinit();
    try package_call_resolution::append_resolved_dependencies(
        &var graph, &catalog, &resolved_calls.calls
    );
    var emitted = try package_dependency_graph::body_emission_registry(allocator, &catalog);
    defer emitted.deinit();
    var out = std::string::String(allocator);
    errdefer out.deinit();
    try package_type_facts::append_package_component_type_facts(
        &var out, files, parsed, &catalog
    );
    try package_dependency_graph::append_function_owner_module_facts(&var out, &catalog);
    try package_dependency_graph::append_function_type_parameter_facts(
        &var out, &catalog
    );
    try append_numeric_package_closure(
        allocator, &var out, files, parsed, &catalog, &graph,
        &var emitted
    );
    var semantic_session = package_semantic_session::init(allocator);
    defer semantic_session.deinit();
    try package_semantic_session::append_reachable_instances(
        &var semantic_session,
        allocator,
        &catalog,
        &resolved_calls.calls,
        &resolved_calls.canonical_types,
        &emitted
    );
    try package_semantic_session::append_function_instance_facts(
        &var out, &semantic_session, &catalog
    );
    try append_resolved_call_target_facts(
        &var out, &catalog, &resolved_calls.calls,
        &resolved_calls.canonical_types, &emitted
    );
    return out;
}

fn append_numeric_package_closure(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>,
    parsed_files: &parser::ParsedSourceFiles,
    catalog: &package_catalog::PackageFunctionCatalog,
    graph: &package_dependency_graph::DependencyGraph,
    emitted_targets: &var package_dependency_graph::BodyEmissionRegistry
) -> !void {
    try append_package_identity_bounds(out, catalog);
    var pending = try package_dependency_graph::function_target_queue(allocator, catalog);
    defer pending.deinit();
    try append_external_abi_roots(out, catalog, &var pending, allocator);
    return append_numeric_package_closure_from_queue(
        out, files, parsed_files, catalog, graph, &var pending, emitted_targets
    );
}

fn append_source_numeric_package_closure(
    allocator: Allocator,
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>,
    parsed_files: &parser::ParsedSourceFiles,
    catalog: &package_catalog::PackageFunctionCatalog,
    graph: &package_dependency_graph::DependencyGraph,
    roots: &std::array::Array<SourceFunctionRoot>,
    emitted_targets: &var package_dependency_graph::BodyEmissionRegistry
) -> !void {
    try append_package_identity_bounds(out, catalog);
    var pending = try package_dependency_graph::function_target_queue(allocator, catalog);
    defer pending.deinit();
    try append_source_function_roots(
        out, files, catalog, roots, &var pending
    );
    return append_numeric_package_closure_from_queue(
        out, files, parsed_files, catalog, graph, &var pending, emitted_targets
    );
}

fn append_package_identity_bounds(
    out: &var std::string::String,
    catalog: &package_catalog::PackageFunctionCatalog
) -> !void {
    try out.append_bytes("package-identity-bounds ");
    try std::fmt::append_i64(out, package_catalog::component_len(catalog));
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, package_catalog::function_len(catalog));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_external_abi_roots(
    out: &var std::string::String,
    catalog: &package_catalog::PackageFunctionCatalog,
    pending: &var package_dependency_graph::FunctionTargetQueue,
    allocator: Allocator
) -> !void {
    var entrypoints = try external_abi_entrypoints::collect(allocator);
    defer entrypoints.deinit();
    let manifest_entries = &entrypoints.entrypoints;
    var entrypoint_index = 0;
    while entrypoint_index < external_abi_entrypoints::len(&entrypoints) {
        let entrypoint = try manifest_entries.at(entrypoint_index);
        let target = try package_exact_lookup::resolve_call(
            catalog,
            entrypoint.package_name,
            entrypoint.module_path,
            entrypoint.function_name
        );
        try out.append_bytes("external-abi-entrypoint ");
        try external_abi_entrypoints::append_qualified_name(out, &entrypoint);
        try out.append_byte(cast<u8>(10));
        try package_dependency_graph::queue_append(pending, catalog, target);
        entrypoint_index = entrypoint_index + 1;
    }
    return;
}

fn append_source_function_roots(
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>,
    catalog: &package_catalog::PackageFunctionCatalog,
    roots: &std::array::Array<SourceFunctionRoot>,
    pending: &var package_dependency_graph::FunctionTargetQueue
) -> !void {
    var index = 0;
    while index < roots.len() {
        let root = try roots.at(index);
        let target = try source_function_root_target(files, catalog, &root);
        let before = package_dependency_graph::queue_len(pending);
        try package_dependency_graph::queue_append(
            pending, catalog,
            package_function_identity::copy_function_target(&target)
        );
        if package_dependency_graph::queue_len(pending) != before + 1 {
            return error("duplicate source function root");
        }
        try out.append_bytes("program-entry ");
        try std::fmt::append_i64(
            out, package_function_identity::target_component_value(&target)
        );
        try out.append_byte(cast<u8>(32));
        try std::fmt::append_i64(
            out, package_function_identity::target_function_value(&target)
        );
        try out.append_byte(cast<u8>(32));
        try package_dependency_graph::append_target_qualified_name(
            out, catalog, target
        );
        try out.append_byte(cast<u8>(10));
        index = index + 1;
    }
    return;
}

fn source_function_root_target(
    files: &std::array::Array<source::SourceFile>,
    catalog: &package_catalog::PackageFunctionCatalog,
    root: &SourceFunctionRoot
) -> !package_function_identity::FunctionTarget {
    if root.name_start < 0 or root.name_end <= root.name_start {
        return error("source function root span invalid");
    }
    var source_index = -1;
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.id == root.source_id {
            if source_index >= 0 {
                return error("source function root source ID is not unique");
            }
            source_index = index;
        }
        index = index + 1;
    }
    if source_index < 0 {
        return error("source function root source missing");
    }
    let file = try files.at(source_index);
    let component = package_exact_lookup::component_for_source(catalog, file);
    if component < 0 {
        return error("source function root component missing");
    }
    let entry = package_exact_lookup::function_entry_by_name_span(
        catalog, component, root.name_start, root.name_end
    );
    if entry < 0 {
        return error("source function root function missing");
    }
    return package_catalog::target_at_entry(catalog, entry);
}

fn append_numeric_package_closure_from_queue(
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>,
    parsed_files: &parser::ParsedSourceFiles,
    catalog: &package_catalog::PackageFunctionCatalog,
    graph: &package_dependency_graph::DependencyGraph,
    pending: &var package_dependency_graph::FunctionTargetQueue,
    emitted_targets: &var package_dependency_graph::BodyEmissionRegistry
) -> !void {
    var index = 0;
    while index < package_dependency_graph::queue_len(pending) {
        let target = try package_dependency_graph::queue_target(pending, index);
        if try package_dependency_graph::record_body_emission(emitted_targets, catalog, &target) {
            try append_numeric_package_definition(
                out, files, parsed_files, catalog, target
            );
        }
        let dependency_source = try package_dependency_graph::queue_target(pending, index);
        try package_dependency_graph::queue_append_dependencies(
            pending, catalog, graph, dependency_source
        );
        index = index + 1;
    }
    try append_numeric_dependency_records(out, catalog, graph, emitted_targets);
    return;
}

fn append_numeric_package_definition(
    out: &var std::string::String,
    files: &std::array::Array<source::SourceFile>,
    parsed_files: &parser::ParsedSourceFiles,
    catalog: &package_catalog::PackageFunctionCatalog,
    target: package_function_identity::FunctionTarget
) -> !void {
    let component_id = package_function_identity::target_component_value(&target);
    let function_id = package_function_identity::target_function_value(&target);
    try out.append_bytes("package-definition ");
    try std::fmt::append_i64(out, component_id);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, function_id);
    try out.append_byte(cast<u8>(10));
    let parsed_index = component_id;
    let source_index = try parsed_files.source_indexes.get(parsed_index);
    let file = try files.at(source_index);
    let parsed_results = &parsed_files.parsed;
    let parsed = try parsed_results.at(parsed_index);
    let definition_target = package_function_identity::copy_function_target(&target);
    let definition = try package_definition_lookup::definition_node(
        catalog, definition_target, &parsed.ast, parsed.root
    );
    let function_index = try package_catalog::target_slot(
        catalog, package_function_identity::copy_function_target(&target)
    );
    var qualified_name = std::string::String(std::mem::page_allocator());
    defer qualified_name.deinit();
    try package_dependency_graph::append_target_qualified_name(&var qualified_name, catalog, target);
    let qualified_name_bytes = qualified_name.as_bytes();
    try out.append_bytes("package-definition-name ");
    try std::fmt::append_i64(out, component_id);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, function_id);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(qualified_name_bytes);
    try out.append_byte(cast<u8>(10));
    let body = try function_body_from_node(parsed.ast, definition);
    try append_numeric_package_definition_body(
        out, file.text, parsed.ast, definition, body, &qualified_name_bytes
    );
    return;
}

fn append_numeric_package_definition_body(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    definition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    qualified_name: &[]u8
) -> !void {
    let name = qualified_name.*;
    try function_signature::append(out, text, ast, definition, name);
    try executable_body::append_helper_body_ir(
        out, text, ast, name, "numeric-package-dependency", body
    );
    return;
}

// append_resolved_call_target_facts is the single source-call target producer
// for every claimed source body, regardless of which helper/selected/hosted
// emitter produced that body's facts. ResolvedCallTargets already uses source
// spans as its stable checker-to-emitter identity, so no body-byte rescan or
// symbol-name reconstruction participates.
fn append_resolved_call_target_facts(
    out: &var std::string::String,
    catalog: &package_catalog::PackageFunctionCatalog,
    calls: &package_call_facts::ResolvedCallTargets,
    canonical_types: &package_type_resolution::CanonicalTypeFacts,
    emitted: &package_dependency_graph::BodyEmissionRegistry
) -> !void {
    try append_canonical_type_facts(out, catalog, canonical_types);
    var call_span_slots = std::array::Array<i64>(std::mem::page_allocator());
    defer call_span_slots.deinit();
    let slot_len = (
        package_call_facts::resolved_call_len(calls) +
        package_call_facts::builtin_call_len(calls)
    ) * 2 + 1;
    var slot_index = 0;
    while slot_index < slot_len {
        try call_span_slots.append(0);
        slot_index = slot_index + 1;
    }
    var index = 0;
    while index < package_call_facts::resolved_call_len(calls) {
        let record = try package_call_facts::resolved_call_record(calls, index);
        let caller = package_function_identity::FunctionTarget {
            component: package_function_identity::ComponentId {
                value: record.caller_component_id
            },
            function: package_function_identity::FunctionId {
                value: record.caller_function_id
            }
        };
        if try package_dependency_graph::is_body_emitted(
            emitted,
            catalog,
            package_function_identity::FunctionTarget {
                component: package_function_identity::ComponentId {
                    value: record.caller_component_id
                },
                function: package_function_identity::FunctionId {
                    value: record.caller_function_id
                }
            }
        ) {
            try claim_source_call_span(&var call_span_slots, calls, index);
            let target = package_function_identity::FunctionTarget {
                component: package_function_identity::ComponentId {
                    value: record.target_component_id
                },
                function: package_function_identity::FunctionId {
                    value: record.target_function_id
                }
            };
            try out.append_bytes("body-call-target ");
            try package_dependency_graph::append_target_qualified_name(out, catalog, caller);
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(
                out, try package_call_facts::resolved_call_span_start(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(
                out, try package_call_facts::resolved_call_span_end(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            try package_dependency_graph::append_target_qualified_name(out, catalog, target);
            try out.append_byte(cast<u8>(10));
        }
        index = index + 1;
    }
    index = 0;
    while index < package_call_facts::builtin_call_len(calls) {
        let caller = try package_call_facts::builtin_call_caller(calls, index);
        if try package_dependency_graph::is_body_emitted(
            emitted,
            catalog,
            package_function_identity::copy_function_target(&caller)
        ) {
            try claim_builtin_call_span(&var call_span_slots, calls, index);
            try out.append_bytes("body-call-builtin ");
            try package_dependency_graph::append_target_qualified_name(out, catalog, caller);
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(
                out, try package_call_facts::builtin_call_span_start(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(
                out, try package_call_facts::builtin_call_span_end(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            try out.append_bytes(
                try package_call_facts::builtin_kind_name(
                    try package_call_facts::builtin_call_kind(calls, index)
                )
            );
            try out.append_byte(cast<u8>(32));
            try out.append_bytes(
                try package_call_facts::builtin_call_operation_name(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            let builtin_identity = try package_call_facts::builtin_call_identity(calls, index);
            if std::mem::len(builtin_identity) == 0 {
                try out.append_byte(cast<u8>(45));
            } else {
                try out.append_bytes(builtin_identity);
            }
            try out.append_byte(cast<u8>(10));
        }
        index = index + 1;
    }
    index = 0;
    while index < package_call_facts::owned_constructor_len(calls) {
        let caller = try package_call_facts::owned_constructor_caller(calls, index);
        if try package_dependency_graph::is_body_emitted(
            emitted, catalog, package_function_identity::copy_function_target(&caller)
        ) {
            try out.append_bytes("body-call-owned-constructor ");
            try package_dependency_graph::append_target_qualified_name(out, catalog, caller);
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(
                out, try package_call_facts::owned_constructor_span_start(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(
                out, try package_call_facts::owned_constructor_span_end(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            try out.append_bytes(try builtin_contract::owned_container_family_name(
                try package_call_facts::owned_constructor_family(calls, index)
            ));
            try out.append_byte(cast<u8>(32));
            try out.append_bytes(try builtin_contract::owned_container_action_name(
                try package_call_facts::owned_constructor_action(calls, index)
            ));
            try out.append_byte(cast<u8>(32));
            try out.append_bytes(
                try package_call_facts::owned_constructor_result_constructor(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            try package_type_token::append_canonical(
                out, try package_call_facts::owned_constructor_result_spelling(calls, index)
            );
            try out.append_byte(cast<u8>(32));
            let type_argument_len = try package_call_facts::owned_constructor_type_argument_len(
                calls, index
            );
            try std::fmt::append_i64(out, type_argument_len);
            var type_argument_index = 0;
            while type_argument_index < type_argument_len {
                try out.append_byte(cast<u8>(32));
                try package_type_token::append_canonical(
                    out,
                    try package_call_facts::owned_constructor_type_argument(
                        calls, index, type_argument_index
                    )
                );
                type_argument_index = type_argument_index + 1;
            }
            try out.append_byte(cast<u8>(10));
        }
        index = index + 1;
    }
    index = 0;
    while index < package_call_facts::call_type_len(calls) {
        let caller = try package_call_facts::call_type_caller(calls, index);
        if try package_dependency_graph::is_body_emitted(
            emitted, catalog, package_function_identity::copy_function_target(&caller)
        ) {
            try out.append_bytes("body-call-type-ids ");
            try package_dependency_graph::append_target_qualified_name(out, catalog, caller);
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(out, try package_call_facts::call_type_span_start(calls, index));
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(out, try package_call_facts::call_type_span_end(calls, index));
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(out, try package_call_facts::call_type_receiver(calls, index));
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(out, try package_call_facts::call_type_result(calls, index));
            let runtime_len = try package_call_facts::call_type_explicit_len(calls, index);
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(out, runtime_len);
            var arg = 0;
            while arg < runtime_len {
                try out.append_byte(cast<u8>(32));
                try std::fmt::append_i64(out, try package_call_facts::call_type_explicit(calls, index, arg));
                arg = arg + 1;
            }
            let actual_len = try package_call_facts::call_type_actual_len(calls, index);
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(out, actual_len);
            arg = 0;
            while arg < actual_len {
                try out.append_byte(cast<u8>(32));
                try std::fmt::append_i64(out, try package_call_facts::call_type_actual(calls, index, arg));
                arg = arg + 1;
            }
            try out.append_byte(cast<u8>(10));
        }
        index = index + 1;
    }
    return;
}

fn append_canonical_type_facts(
    out: &var std::string::String,
    catalog: &package_catalog::PackageFunctionCatalog,
    types: &package_type_resolution::CanonicalTypeFacts
) -> !void {
    var id = 0;
    while id < package_canonical_type_facts::len(types) {
        let kind = try package_canonical_type_facts::kind(types, id);
        try out.append_bytes("canonical-type ");
        try std::fmt::append_i64(out, id);
        try out.append_byte(cast<u8>(32));
        try out.append_bytes(try package_canonical_type_facts::kind_name(kind));
        try out.append_byte(cast<u8>(32));
        if kind == package_type_resolution::type_kind_intrinsic() {
            try out.append_bytes(try intrinsic_type_contract::canonical_name(
                try package_canonical_type_facts::intrinsic_kind(types, id)
            ));
        } else {
            if kind == package_type_resolution::type_kind_declared() {
                let component = try package_canonical_type_facts::declaration_component(types, id);
                try package_dependency_graph::append_component_prefix(out, catalog, component);
                try out.append_bytes(package_catalog::declared_type_name_at(
                    catalog, try package_canonical_type_facts::declaration_index(types, id)
                ));
            } else {
                if kind == package_type_resolution::type_kind_formal() {
                    let owner_kind =
                        try package_canonical_type_facts::formal_owner_kind(
                            types, id
                        );
                    let owner_id =
                        try package_canonical_type_facts::formal_owner_id(types, id);
                    if owner_kind ==
                        package_type_resolution::formal_owner_function() {
                        try package_dependency_graph::append_target_qualified_name(
                            out, catalog,
                            try package_catalog::target_at_entry(catalog, owner_id)
                        );
                    } else {
                        if owner_kind !=
                            package_type_resolution::formal_owner_declared() {
                            return error("canonical formal owner kind invalid");
                        }
                        try package_dependency_graph::append_component_prefix(
                            out,
                            catalog,
                            package_catalog::declared_type_component_at(
                                catalog, owner_id
                            )
                        );
                        try out.append_bytes(
                            package_catalog::declared_type_name_at(catalog, owner_id)
                        );
                    }
                } else {
                    if kind == package_type_resolution::type_kind_function_item() {
                        try package_dependency_graph::append_target_qualified_name(
                            out, catalog,
                            package_function_identity::FunctionTarget {
                                component: package_function_identity::ComponentId {
                                    value: try package_canonical_type_facts::declaration_component(types, id)
                                },
                                function: package_function_identity::FunctionId {
                                    value: try package_canonical_type_facts::declaration_index(types, id)
                                }
                            }
                        );
                    } else {
                        try out.append_byte(cast<u8>(45));
                    }
                }
            }
        }
        try out.append_byte(cast<u8>(32));
        if kind == package_type_resolution::type_kind_intrinsic() {
            try std::fmt::append_i64(
                out, try package_canonical_type_facts::intrinsic_kind(types, id)
            );
            try out.append_bytes(" -1");
        } else {
            if kind == package_type_resolution::type_kind_declared() or
                kind == package_type_resolution::type_kind_function_item() {
                try std::fmt::append_i64(
                    out, try package_canonical_type_facts::declaration_component(types, id)
                );
                try out.append_byte(cast<u8>(32));
                try std::fmt::append_i64(
                    out, try package_canonical_type_facts::declaration_index(types, id)
                );
            } else {
                if kind == package_type_resolution::type_kind_formal() {
                    try std::fmt::append_i64(
                        out, try package_canonical_type_facts::formal_owner_kind(types, id)
                    );
                    try out.append_byte(cast<u8>(32));
                    try std::fmt::append_i64(
                        out, try package_canonical_type_facts::formal_slot(types, id)
                    );
                } else {
                    try out.append_bytes("-1 -1");
                }
            }
        }
        let child_len = try package_canonical_type_facts::child_len(types, id);
        try out.append_byte(cast<u8>(32));
        try std::fmt::append_i64(out, child_len);
        var child = 0;
        while child < child_len {
            let child_id = try package_canonical_type_facts::child(types, id, child);
            if child_id < 0 or child_id >= id {
                return error("canonical type child must precede parent");
            }
            try out.append_byte(cast<u8>(32));
            try std::fmt::append_i64(out, child_id);
            child = child + 1;
        }
        try out.append_byte(cast<u8>(10));
        id = id + 1;
    }
    return;
}

// claim_source_call_span rejects duplicate source-call classifications in the
// artifact producer itself. Open addressing keeps this validation linear in the
// resolved call count and independent from emitted body byte size.
fn claim_source_call_span(
    slots: &var std::array::Array<i64>,
    calls: &package_call_facts::ResolvedCallTargets,
    call_index: i64
) -> !void {
    let record = try package_call_facts::resolved_call_record(calls, call_index);
    let span_start = try package_call_facts::resolved_call_span_start(calls, call_index);
    let span_end = try package_call_facts::resolved_call_span_end(calls, call_index);
    let slot_len = slots.len();
    var slot = record.caller_component_id % slot_len;
    slot = (slot + record.caller_function_id) % slot_len;
    slot = (slot + span_start) % slot_len;
    slot = (slot + span_end) % slot_len;
    while try slots.get(slot) != 0 {
        if try classified_call_span_equals(
            calls, try slots.get(slot), record.caller_component_id,
            record.caller_function_id, span_start, span_end
        ) {
            return error("body call target: duplicate resolved call span");
        }
        slot = (slot + 1) % slot_len;
    }
    try slots.set(slot, call_index + 1);
    return;
}

fn claim_builtin_call_span(
    slots: &var std::array::Array<i64>,
    calls: &package_call_facts::ResolvedCallTargets,
    call_index: i64
) -> !void {
    let span_start = try package_call_facts::builtin_call_span_start(calls, call_index);
    let span_end = try package_call_facts::builtin_call_span_end(calls, call_index);
    let slot_len = slots.len();
    let caller_component_id = try package_call_facts::builtin_call_caller_component_id(
        calls, call_index
    );
    let caller_function_id = try package_call_facts::builtin_call_caller_function_id(
        calls, call_index
    );
    var slot = caller_component_id % slot_len;
    slot = (slot + caller_function_id) % slot_len;
    slot = (slot + span_start) % slot_len;
    slot = (slot + span_end) % slot_len;
    while try slots.get(slot) != 0 {
        if try classified_call_span_equals(
            calls, try slots.get(slot), caller_component_id,
            caller_function_id, span_start, span_end
        ) {
            return error("body call target: duplicate or overlapping call classification");
        }
        slot = (slot + 1) % slot_len;
    }
    try slots.set(slot, 0 - call_index - 1);
    return;
}

fn classified_call_span_equals(
    calls: &package_call_facts::ResolvedCallTargets,
    encoded_index: i64,
    caller_component: i64,
    caller_function: i64,
    span_start: i64,
    span_end: i64
) -> !bool {
    if encoded_index > 0 {
        let source_index = encoded_index - 1;
        let record = try package_call_facts::resolved_call_record(calls, source_index);
        return record.caller_component_id == caller_component and
            record.caller_function_id == caller_function and
            try package_call_facts::resolved_call_span_start(calls, source_index) == span_start and
            try package_call_facts::resolved_call_span_end(calls, source_index) == span_end;
    }
    let builtin_index = 0 - encoded_index - 1;
    return try package_call_facts::builtin_call_caller_component_id(calls, builtin_index) == caller_component and
        try package_call_facts::builtin_call_caller_function_id(calls, builtin_index) == caller_function and
        try package_call_facts::builtin_call_span_start(calls, builtin_index) == span_start and
        try package_call_facts::builtin_call_span_end(calls, builtin_index) == span_end;
}

fn append_numeric_dependency_records(
    out: &var std::string::String,
    catalog: &package_catalog::PackageFunctionCatalog,
    graph: &package_dependency_graph::DependencyGraph,
    emitted: &package_dependency_graph::BodyEmissionRegistry
) -> !void {
    var index = 0;
    while index < package_dependency_graph::dependency_len(graph) {
        let record = try package_dependency_graph::dependency_at(graph, index);
        let caller = package_function_identity::FunctionTarget {
            component: package_function_identity::ComponentId { value: record.caller_component_id },
            function: package_function_identity::FunctionId { value: record.caller_function_id }
        };
        if !(try package_dependency_graph::is_body_emitted(emitted, catalog, caller)) {
            index = index + 1;
            continue;
        }
        try out.append_bytes("package-dependency ");
        try std::fmt::append_i64(out, record.caller_component_id);
        try out.append_byte(cast<u8>(32));
        try std::fmt::append_i64(out, record.caller_function_id);
        try out.append_byte(cast<u8>(32));
        try std::fmt::append_i64(out, record.target_component_id);
        try out.append_byte(cast<u8>(32));
        try std::fmt::append_i64(out, record.target_function_id);
        try out.append_byte(cast<u8>(10));
        try out.append_bytes("package-reference ");
        try std::fmt::append_i64(out, record.target_component_id);
        try out.append_byte(cast<u8>(32));
        try std::fmt::append_i64(out, record.target_function_id);
        try out.append_byte(cast<u8>(10));
        index = index + 1;
    }
    return;
}
