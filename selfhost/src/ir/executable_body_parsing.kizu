pub fn append_main_scan_fact(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    try require_function_body_kind(
        text,
        ast,
        root,
        "parse_run_program_ast",
        "While"
    );
    try require_function_body_kind(
        text,
        ast,
        root,
        "parse_test_program_ast",
        "While"
    );
    return;
}

pub fn append_run_parsing_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    try require_function_body_token(
        text,
        ast,
        root,
        "parse_run_print_call_ast",
        "RunPrintCall"
    );
    try require_function_body_token(
        text,
        ast,
        root,
        "parse_run_return_stmt_ast",
        "RunReturnVoid"
    );
    return;
}

pub fn append_test_parsing_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    try require_function_body_token(
        text,
        ast,
        root,
        "parse_expect_call_ast",
        "std::testing::expect"
    );
    try require_function_body_token(
        text,
        ast,
        root,
        "parse_expect_call_ast",
        "TestExpectTrue"
    );
    try require_function_body_token(
        text,
        ast,
        root,
        "parse_expect_call_ast",
        "TestExpectFalse"
    );
    return;
}

fn require_function_body_kind(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8,
    kind: []u8
) -> !void {
    let body = try function_body_node(text, ast, root, function_name);
    if !(try node_contains_kind(ast, body, kind)) {
        return error("missing selected executable AST parsing source");
    }
    return;
}

fn require_function_body_token(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8,
    token: []u8
) -> !void {
    let body = try function_body_node(text, ast, root, function_name);
    if !(try node_contains_token(text, ast, body, token)) {
        return error("missing selected executable AST parsing source");
    }
    return;
}

fn node_contains_kind(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    kind: []u8
) -> !bool {
    if std::mem::equal_bytes(node_kind_text(ast, node_id), kind) {
        return true;
    }
    return try node_children_contain_kind(ast, node_id, kind);
}

fn node_contains_token(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    token: []u8
) -> !bool {
    if node_token_matches(text, ast, node_id, token) {
        return true;
    }
    return try node_children_contain_token(text, ast, node_id, token);
}

fn range_contains_kind(
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    kind: []u8
) -> !bool {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        if try node_contains_kind(ast, child, kind) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn range_contains_token(
    text: []u8,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    token: []u8
) -> !bool {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        if try node_contains_token(text, ast, child, token) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn node_children_contain_kind(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    kind: []u8
) -> !bool {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try range_contains_kind(ast, program.declarations, kind),
        Block(block) => try range_contains_kind(ast, block.statements, kind),
        Let(let_node) => try node_contains_kind(ast, let_node.name, kind) or
            try node_contains_kind(ast, let_node.value, kind),
        Assign(assign_node) => try node_contains_kind(ast, assign_node.target, kind) or
            try node_contains_kind(ast, assign_node.value, kind),
        Return(return_node) => try node_contains_kind(ast, return_node.value, kind),
        Defer(defer_node) => try node_contains_kind(ast, defer_node.expr, kind),
        ExprStmt(expr_stmt) => try node_contains_kind(ast, expr_stmt.expr, kind),
        If(if_node) => try node_contains_kind(ast, if_node.condition, kind) or
            try node_contains_kind(ast, if_node.then_block, kind) or
            try node_contains_kind(ast, if_node.else_block, kind),
        ComptimeIf(comptime_if_node) => try node_contains_kind(
            ast,
            comptime_if_node.condition,
            kind
        ) or try node_contains_kind(ast, comptime_if_node.then_block, kind) or
            try node_contains_kind(ast, comptime_if_node.else_block, kind),
        While(while_node) => try node_contains_kind(ast, while_node.label, kind) or
            try node_contains_kind(ast, while_node.condition, kind) or
            try node_contains_kind(ast, while_node.body, kind),
        For(for_node) => try node_contains_kind(ast, for_node.label, kind) or
            try node_contains_kind(ast, for_node.name, kind) or
            try node_contains_kind(ast, for_node.start, kind) or
            try node_contains_kind(ast, for_node.end, kind) or
            try node_contains_kind(ast, for_node.body, kind),
        Break(break_node) => try node_contains_kind(ast, break_node.label, kind),
        Continue(continue_node) => try node_contains_kind(ast, continue_node.label, kind),
        Unsafe(unsafe_node) => try range_contains_kind(ast, unsafe_node.capabilities, kind) or
            try node_contains_kind(ast, unsafe_node.body, kind),
        Match(match_node) => try node_contains_kind(ast, match_node.value, kind) or
            try range_contains_kind(ast, match_node.arms, kind),
        MatchArm(match_arm) => try node_contains_kind(ast, match_arm.pattern, kind) or
            try node_contains_kind(ast, match_arm.binding, kind) or
            try node_contains_kind(ast, match_arm.body, kind),
        Prefix(prefix_node) => try node_contains_kind(ast, prefix_node.right, kind),
        Binary(binary) => try node_contains_kind(ast, binary.left, kind) or
            try node_contains_kind(ast, binary.right, kind),
        FieldExpr(field_expr) => try node_contains_kind(ast, field_expr.receiver, kind) or
            try node_contains_kind(ast, field_expr.name, kind),
        DerefExpr(deref_expr) => try node_contains_kind(ast, deref_expr.receiver, kind),
        Call(call_node) => try node_contains_kind(ast, call_node.callee, kind) or
            try range_contains_kind(ast, call_node.args, kind),
        TypeApplyExpr(type_apply) => try node_contains_kind(ast, type_apply.callee, kind) or
            try range_contains_kind(ast, type_apply.type_args, kind),
        CastExpr(cast_expr) => try node_contains_kind(ast, cast_expr.type_node, kind) or
            try node_contains_kind(ast, cast_expr.value, kind),
        IndexExpr(index_expr) => try node_contains_kind(ast, index_expr.target, kind) or
            try node_contains_kind(ast, index_expr.start, kind) or
            try node_contains_kind(ast, index_expr.end, kind),
        StructLiteralExpr(struct_literal) => try node_contains_kind(
            ast,
            struct_literal.type_name,
            kind
        ) or try range_contains_kind(ast, struct_literal.fields, kind),
        StructFieldInit(field_init) => try node_contains_kind(ast, field_init.name, kind) or
            try node_contains_kind(ast, field_init.value, kind),
        ArenaNewExpr(arena_new) => try node_contains_kind(ast, arena_new.type_node, kind) or
            try node_contains_kind(ast, arena_new.allocator, kind),
        TryExpr(try_expr) => try node_contains_kind(ast, try_expr.value, kind),
        ComptimeExpr(comptime_expr) => try node_contains_kind(ast, comptime_expr.value, kind),
        _ => false,
    };
}

fn node_children_contain_token(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    token: []u8
) -> !bool {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try range_contains_token(text, ast, program.declarations, token),
        Block(block) => try range_contains_token(text, ast, block.statements, token),
        Let(let_node) => try node_contains_token(text, ast, let_node.name, token) or
            try node_contains_token(text, ast, let_node.value, token),
        Assign(assign_node) => try node_contains_token(text, ast, assign_node.target, token) or
            try node_contains_token(text, ast, assign_node.value, token),
        Return(return_node) => try node_contains_token(text, ast, return_node.value, token),
        Defer(defer_node) => try node_contains_token(text, ast, defer_node.expr, token),
        ExprStmt(expr_stmt) => try node_contains_token(text, ast, expr_stmt.expr, token),
        If(if_node) => try node_contains_token(text, ast, if_node.condition, token) or
            try node_contains_token(text, ast, if_node.then_block, token) or
            try node_contains_token(text, ast, if_node.else_block, token),
        ComptimeIf(comptime_if_node) => try node_contains_token(
            text,
            ast,
            comptime_if_node.condition,
            token
        ) or try node_contains_token(text, ast, comptime_if_node.then_block, token) or
            try node_contains_token(text, ast, comptime_if_node.else_block, token),
        While(while_node) => try node_contains_token(text, ast, while_node.label, token) or
            try node_contains_token(text, ast, while_node.condition, token) or
            try node_contains_token(text, ast, while_node.body, token),
        For(for_node) => try node_contains_token(text, ast, for_node.label, token) or
            try node_contains_token(text, ast, for_node.name, token) or
            try node_contains_token(text, ast, for_node.start, token) or
            try node_contains_token(text, ast, for_node.end, token) or
            try node_contains_token(text, ast, for_node.body, token),
        Break(break_node) => try node_contains_token(text, ast, break_node.label, token),
        Continue(continue_node) => try node_contains_token(text, ast, continue_node.label, token),
        Unsafe(unsafe_node) => try range_contains_token(
            text,
            ast,
            unsafe_node.capabilities,
            token
        ) or try node_contains_token(text, ast, unsafe_node.body, token),
        Match(match_node) => try node_contains_token(text, ast, match_node.value, token) or
            try range_contains_token(text, ast, match_node.arms, token),
        MatchArm(match_arm) => try node_contains_token(text, ast, match_arm.pattern, token) or
            try node_contains_token(text, ast, match_arm.binding, token) or
            try node_contains_token(text, ast, match_arm.body, token),
        Prefix(prefix_node) => try node_contains_token(text, ast, prefix_node.right, token),
        Binary(binary) => try node_contains_token(text, ast, binary.left, token) or
            try node_contains_token(text, ast, binary.right, token),
        FieldExpr(field_expr) => try node_contains_token(text, ast, field_expr.receiver, token) or
            try node_contains_token(text, ast, field_expr.name, token),
        DerefExpr(deref_expr) => try node_contains_token(text, ast, deref_expr.receiver, token),
        Call(call_node) => try node_contains_token(text, ast, call_node.callee, token) or
            try range_contains_token(text, ast, call_node.args, token),
        TypeApplyExpr(type_apply) => try node_contains_token(text, ast, type_apply.callee, token) or
            try range_contains_token(text, ast, type_apply.type_args, token),
        CastExpr(cast_expr) => try node_contains_token(text, ast, cast_expr.type_node, token) or
            try node_contains_token(text, ast, cast_expr.value, token),
        IndexExpr(index_expr) => try node_contains_token(text, ast, index_expr.target, token) or
            try node_contains_token(text, ast, index_expr.start, token) or
            try node_contains_token(text, ast, index_expr.end, token),
        StructLiteralExpr(struct_literal) => try node_contains_token(
            text,
            ast,
            struct_literal.type_name,
            token
        ) or try range_contains_token(text, ast, struct_literal.fields, token),
        StructFieldInit(field_init) => try node_contains_token(text, ast, field_init.name, token) or
            try node_contains_token(text, ast, field_init.value, token),
        ArenaNewExpr(arena_new) => try node_contains_token(text, ast, arena_new.type_node, token) or
            try node_contains_token(text, ast, arena_new.allocator, token),
        TryExpr(try_expr) => try node_contains_token(text, ast, try_expr.value, token),
        ComptimeExpr(comptime_expr) => try node_contains_token(text, ast, comptime_expr.value, token),
        _ => false,
    };
}

fn node_token_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    token: []u8
) -> bool {
    let node = ast.get(node_id);
    match node.data {
        String(string_node) => return string_literal_value_matches(text, ast, node_id, token);,
        _ => return std::mem::equal_bytes(ast_node_text(text, ast, node_id), token);,
    }
}

fn string_literal_value_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    token: []u8
) -> bool {
    let literal = ast_node_text(text, ast, node_id);
    let len = std::mem::len(literal);
    if len < 2 {
        return false;
    }
    if literal[0] != cast<u8>(34) or literal[len - 1] != cast<u8>(34) {
        return false;
    }
    return std::mem::equal_bytes(literal[1..len - 1], token);
}

fn node_kind_text(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> []u8 {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => "Program",
        Int(int_node) => "Int",
        String(string_node) => "String",
        TypeName(type_name) => "TypeName",
        Var(var_node) => "Var",
        Bool(bool_node) => "Bool",
        Prefix(prefix_node) => "Prefix",
        Binary(binary) => "Binary",
        FieldExpr(field_expr) => "FieldExpr",
        DerefExpr(deref_expr) => "DerefExpr",
        Call(call_node) => "Call",
        TypeApplyExpr(type_apply) => "TypeApplyExpr",
        CastExpr(cast_expr) => "CastExpr",
        IndexExpr(index_expr) => "IndexExpr",
        StructLiteralExpr(struct_literal) => "StructLiteralExpr",
        StructFieldInit(field_init) => "StructFieldInit",
        ArenaNewExpr(arena_new) => "ArenaNewExpr",
        TryExpr(try_expr) => "TryExpr",
        ComptimeExpr(comptime_expr) => "ComptimeExpr",
        Block(block) => "Block",
        If(if_node) => "If",
        Let(let_node) => "Let",
        Assign(assign_node) => "Assign",
        Return(return_node) => "Return",
        Defer(defer_node) => "Defer",
        ExprStmt(expr_stmt) => "ExprStmt",
        While(while_node) => "While",
        For(for_node) => "For",
        Break(break_node) => "Break",
        Continue(continue_node) => "Continue",
        ImportDecl(import_decl) => "ImportDecl",
        Param(param) => "Param",
        Field(field) => "Field",
        StructDecl(struct_decl) => "StructDecl",
        EnumDecl(enum_decl) => "EnumDecl",
        UnionDecl(union_decl) => "UnionDecl",
        ImplDecl(impl_decl) => "ImplDecl",
        UnionVariant(variant) => "UnionVariant",
        Match(match_node) => "Match",
        MatchArm(match_arm) => "MatchArm",
        Unsafe(unsafe_node) => "Unsafe",
        ComptimeIf(comptime_if_node) => "ComptimeIf",
        FnDecl(fn_decl) => "FnDecl",
        Empty => "Empty",
    };
}

fn function_body_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    let node = ast.get(root);
    match node.data {
        Program(program) => return try function_body_node_in_program(
            text,
            ast,
            program.declarations,
            function_name
        );,
        _ => return error("missing selected executable AST parsing source");,
    }
}

fn function_body_node_in_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if function_node_matches(text, ast, child, function_name) {
            return try function_body_from_node(ast, child);
        }
        index = index + 1;
    }
    return error("missing selected executable AST parsing source");
}

fn function_node_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        FnDecl(fn_decl) => std::mem::equal_bytes(
            ast_node_text(text, ast, fn_decl.name),
            name
        ),
        _ => false,
    };
}

fn function_body_from_node(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return fn_decl.body;,
        _ => return error("missing selected executable AST parsing source");,
    }
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
