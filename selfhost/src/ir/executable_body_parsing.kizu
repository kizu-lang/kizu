pub fn append_main_scan_fact(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    try require_function_body_fragment(
        text,
        ast,
        root,
        "parse_run_program_ast",
        "while index < declarations.len"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_run_program_ast",
        "parse_run_fn_ast"
    );
    try require_function_body_fragment(
        text,
        ast,
        root,
        "parse_test_program_ast",
        "while index < declarations.len"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_test_program_ast",
        "parse_test_fn_ast"
    );
    return;
}

pub fn append_run_parsing_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    try append_selected_body_parsing(
        out,
        "selfhost::backend::executable::parse_run_executable_ast",
        "checked-run-ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_run_executable_ast",
        "parse_run_program_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_run_fn_ast",
        "parse_run_block_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_run_block_ast",
        "parse_run_print_stmt_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_run_block_ast",
        "parse_run_return_stmt_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_run_return_stmt_ast",
        "is_empty_node"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_run_print_stmt_ast",
        "parse_run_print_call_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_run_print_call_ast",
        "run_string_literal_payload"
    );
    try require_function_body_fragment(
        text,
        ast,
        root,
        "parse_run_print_call_ast",
        "data::ExecutableAstKind::RunPrintCall"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "run_payload_from_literal",
        "is_supported_run_print_payload"
    );
    try require_function_body_fragment(
        text,
        ast,
        root,
        "parse_run_return_stmt_ast",
        "data::ExecutableAstKind::RunReturnVoid"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "run_string_literal_payload",
        "run_payload_from_literal"
    );
    return;
}

pub fn append_test_parsing_facts(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !void {
    try append_selected_body_parsing(
        out,
        "selfhost::backend::executable::parse_test_executable_ast",
        "checked-test-ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_test_executable_ast",
        "parse_test_program_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_test_fn_ast",
        "parse_test_block_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_test_block_ast",
        "is_void_return_type"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_test_block_ast",
        "parse_test_expect_statement_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_test_block_ast",
        "is_empty_return"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_test_expect_statement_ast",
        "parse_expect_stmt_ast"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_expect_stmt_ast",
        "parse_expect_call_ast"
    );
    try require_function_body_fragment(
        text,
        ast,
        root,
        "parse_expect_call_ast",
        "std::testing::expect"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "parse_expect_call_ast",
        "expect_bool_value"
    );
    try require_function_body_fragment(
        text,
        ast,
        root,
        "parse_expect_call_ast",
        "data::ExecutableAstKind::TestExpectTrue"
    );
    try require_function_body_fragment(
        text,
        ast,
        root,
        "parse_expect_call_ast",
        "data::ExecutableAstKind::TestExpectFalse"
    );
    try append_executable_body_parsing_call(
        out,
        text,
        ast,
        root,
        "expect_bool_value",
        "bool_value_as_i64"
    );
    return;
}

fn append_selected_body_parsing(
    out: &var std::string::String,
    function_name: []u8,
    role: []u8
) -> !void {
    try out.append_bytes("selected-body-parsing ");
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(role);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_executable_body_parsing_call(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8,
    callee: []u8
) -> !void {
    try require_function_body_fragment(text, ast, root, function_name, callee);
    try out.append_bytes("selected-body-parsing-call ");
    try out.append_bytes("selfhost::backend::executable::");
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(35));
    try out.append_bytes(callee);
    try out.append_bytes(" checked-call");
    try out.append_byte(cast<u8>(10));
    return;
}

fn require_function_body_fragment(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8,
    fragment: []u8
) -> !void {
    let body = try function_body_node(text, ast, root, function_name);
    if !node_text_contains(text, ast, body, fragment) {
        return error("missing selected executable AST parsing source");
    }
    return;
}

fn function_body_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    let node = ast.get(root);
    match node.data {
        Program(program) => return try function_body_node_in_program(
            text,
            ast,
            program.declarations,
            function_name
        );,
        _ => return error("missing selected executable AST parsing source");,
    }
}

fn function_body_node_in_program(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_name: []u8
) -> !std::kizu::ast::NodeId {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        if function_node_matches(text, ast, child, function_name) {
            return try function_body_from_node(ast, child);
        }
        index = index + 1;
    }
    return error("missing selected executable AST parsing source");
}

fn function_node_matches(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        FnDecl(fn_decl) => std::mem::equal_bytes(
            ast_node_text(text, ast, fn_decl.name),
            name
        ),
        _ => false,
    };
}

fn function_body_from_node(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return fn_decl.body;,
        _ => return error("missing selected executable AST parsing source");,
    }
}

fn node_text_contains(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    fragment: []u8
) -> bool {
    return bytes_contains(ast_node_text(text, ast, node_id), fragment);
}

fn bytes_contains(bytes: []u8, needle: []u8) -> bool {
    let byte_len = std::mem::len(bytes);
    let needle_len = std::mem::len(needle);
    if needle_len == 0 {
        return true;
    }
    if needle_len > byte_len {
        return false;
    }
    let last_start = byte_len - needle_len;
    var index = 0;
    while index <= last_start {
        if std::mem::equal_bytes(bytes[index..index + needle_len], needle) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
