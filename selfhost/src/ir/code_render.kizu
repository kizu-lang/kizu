import selfhost::ir::codegen;

// Run codegen IR v1 renderer: walk the flat function-block-instruction tape
// (the Array<i64> records lower_code_module emits, with the run source text for
// string/name spans) and produce the run artifact LLVM module text.
//
// The renderer is the generic counterpart of the old per-shape hosted renderers:
// it iterates the tape opcodes instead of matching a fixed Program shape. Every
// value id names an SSA temp '%v<id>'; CONST_STR payloads become module globals
// '@.kizu.run.s<id>'; PRINT dispatches on the recorded value kind to the string
// or i64 writer.
//
// The cluster is written to compile into stage2 through the generic compiled-MIR
// subset: opcode constants are bound to locals before they are compared (no call
// in a condition), control flow uses early-return guards and tail recursion (no
// loop-carried scalars), and i64 formatting uses the local recursive wi helper
// rather than the std::fmt String builder. Kizu string literals do not interpret
// backslash escapes, so every emitted line is written through wl (bytes then a
// real newline byte) and partial fragments through w; quote/newline bytes are
// appended as explicit byte values.

pub fn render_tape_module(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>
) -> !std::string::String {
    var out = std::string::String(allocator);
    try render_preamble(&var out, source_path);
    try render_string_globals(&var out, text, code, 0);
    try render_functions(&var out, text, code, kinds, 0);
    try render_main_wrapper(&var out);
    return out;
}

// render_run_artifact is the generic run pipeline entry: it lowers a parsed run
// source into the run codegen IR v1 tape (codegen::lower_code_module) and renders
// that tape to the executable LLVM module text. It replaces the per-shape hosted
// renderers -- a single tape walk handles any program the lowering accepts.
pub fn render_run_artifact(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    parsed: std::kizu::ast::ParseResult
) -> !std::string::String {
    let rendered = try render_run_ast_artifact(allocator, source_path, text, parsed.ast, parsed.root);
    return rendered;
}

pub fn render_run_ast_artifact(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !std::string::String {
    var code = std::array::Array<i64>(allocator);
    var kinds = std::array::Array<i64>(allocator);
    var local_starts = std::array::Array<i64>(allocator);
    var local_ends = std::array::Array<i64>(allocator);
    var local_values = std::array::Array<i64>(allocator);
    var args_scratch = std::array::Array<i64>(allocator);
    var defer_records = std::array::Array<i64>(allocator);
    let eval = try codegen::lower_code_module(
        text,
        ast,
        root,
        &var code,
        &var kinds,
        &var local_starts,
        &var local_ends,
        &var local_values,
        &var args_scratch,
        &var defer_records
    );
    if !eval.ok {
        return error("render run artifact: run source lowering not supported");
    }
    let rendered = try render_tape_module(allocator, source_path, text, &code, &kinds);
    return rendered;
}

// render_bool_print_global emits one of the bool print payload globals
// ('true'/'false' plus a newline byte) behind its constant header.
fn render_bool_print_global(
    out: &var std::string::String,
    header: []u8,
    word: []u8
) -> !void {
    try w(out, header);
    try out.append_byte(cast<u8>(34));
    try w(out, word);
    try w(out, "\0A");
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

// expect_fail_message is the runtime expectation-failure line
// std::testing::expect traps with (matching the reference compiler's message).
fn expect_fail_message() -> []u8 {
    return "error: runtime error: expected condition to be true";
}

// render_expect_fail_global emits the expectation-failure message global the
// EXPECT fail blocks point their trap slice at (message plus a newline byte).
fn render_expect_fail_global(out: &var std::string::String) -> !void {
    let message = expect_fail_message();
    let message_len = std::mem::len(message);
    let payload_len = message_len + 1;
    try w(out, "@.kizu.run.expect_fail = private unnamed_addr constant [");
    try wi(out, payload_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try w(out, message);
    try w(out, "\0A");
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

// w appends a fragment with no trailing newline.
fn w(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    return;
}

// wl appends a full line plus a real newline byte.
fn wl(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}

// nl appends a single newline byte.
fn nl(out: &var std::string::String) -> !void {
    try out.append_byte(cast<u8>(10));
    return;
}

// wi appends a non-negative i64 as decimal digits. The renderer only emits
// non-negative ids/spans/literals, so a most-significant-first recursive digit
// walk (each frame appends one digit byte) avoids the std::fmt String builder,
// which is outside the compiled-MIR subset this cluster lowers through.
fn wi(out: &var std::string::String, value: i64) -> !void {
    // Emit the high-order digits first by recursing on value/10 when there is a
    // carry, then append this frame's least-significant digit. Written without an
    // early return so the body stays a single fall-through path the compiled-MIR
    // void then-body lowering models (the renderer compiles into stage2).
    if value >= 10 {
        let high = value / 10;
        try wi(out, high);
    }
    let tens = value / 10;
    let digit = value - tens * 10;
    let digit_byte = cast<u8>(48 + digit);
    try out.append_byte(digit_byte);
    return;
}

fn render_preamble(out: &var std::string::String, source_path: []u8) -> !void {
    try wl(out, "; kizu codegen run artifact ll v1");
    try w(out, "source_filename = ");
    try out.append_byte(cast<u8>(34));
    try w(out, source_path);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    try nl(out);
    try wl(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try wl(out, "%kizu.owned = type { ptr }");
    try wl(out, "%kizu.handle = type { ptr, i64 }");
    try wl(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try wl(out, "%kizu.error.i64 = type { i1, i64, %kizu.slice.u8 }");
    try wl(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try wl(out, "%kizu.run.union = type { i64, i64, %kizu.slice.u8 }");
    try wl(out, "%kizu.rt.map = type { ptr, i64, ptr, i64, i64, ptr, i64, i64 }");
    try nl(out);
    try wl(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try wl(out, "declare ptr @kizu_rt_alloc(ptr, i64)");
    try wl(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try wl(out, "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.owned @kizu_rt_string_new(%kizu.owned)");
    try wl(out, "declare %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned, i8)");
    try wl(out, "declare %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned)");
    try wl(out, "declare i64 @kizu_rt_string_len(%kizu.owned)");
    try wl(out, "declare void @kizu_rt_string_deinit(%kizu.owned)");
    try wl(out, "declare %kizu.owned @kizu_rt_array_new(%kizu.owned, i64)");
    try wl(out, "declare %kizu.error.void @kizu_rt_array_append(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare i64 @kizu_rt_array_len(%kizu.owned)");
    try wl(out, "declare %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned, i64)");
    try wl(out, "declare void @kizu_rt_array_deinit(%kizu.owned)");
    try wl(out, "declare %kizu.owned @kizu_rt_map_new(%kizu.owned)");
    try wl(out, "declare %kizu.error.void @kizu_rt_map_insert(%kizu.owned, %kizu.slice.u8, i64)");
    try wl(out, "declare i1 @kizu_rt_map_contains(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.i64 @kizu_rt_map_get_i64(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare void @kizu_rt_map_deinit(%kizu.owned)");
    try wl(out, "declare %kizu.owned @kizu_rt_arena_new(%kizu.owned, i64)");
    try wl(out, "declare %kizu.handle @kizu_rt_arena_add(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.slice.u8 @kizu_rt_arena_get(%kizu.owned, %kizu.handle)");
    try wl(out, "declare void @kizu_rt_arena_deinit(%kizu.owned)");
    try wl(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try wl(out, "declare void @kizu_rt_trap(%kizu.slice.u8)");
    try wl(out, "declare void @kizu_host_init(i32, ptr)");
    try nl(out);
    try wl(out, "@.kizu.run.newline = private unnamed_addr constant [1 x i8] [i8 10]");
    try wl(out, "@.kizu.run.true_word = private unnamed_addr constant [4 x i8] [i8 116, i8 114, i8 117, i8 101]");
    try wl(out, "@.kizu.run.false_word = private unnamed_addr constant [5 x i8] [i8 102, i8 97, i8 108, i8 115, i8 101]");
    try render_bool_print_global(out, "@.kizu.run.bool_true = private unnamed_addr constant [5 x i8] c", "true");
    try render_bool_print_global(out, "@.kizu.run.bool_false = private unnamed_addr constant [6 x i8] c", "false");
    try render_expect_fail_global(out);
    try nl(out);
    try render_i64_decimal_helper(out);
    try render_string_format_helpers(out);
    return;
}

// render_i64_decimal_helper emits @kizu_run_i64_decimal: format an i64 into a
// page-allocated 20-byte buffer and return the trimmed decimal slice. It backs the
// PRINT path for i64 values.
fn render_i64_decimal_helper(out: &var std::string::String) -> !void {
    try wl(out, "define %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try wl(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try wl(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 20)");
    try wl(out, "  %allocated = icmp ne ptr %buffer, null");
    try wl(out, "  br i1 %allocated, label %check_zero, label %alloc_failed");
    try wl(out, "check_zero:");
    try wl(out, "  %is_zero = icmp eq i64 %value, 0");
    try wl(out, "  br i1 %is_zero, label %zero, label %nonzero");
    try wl(out, "zero:");
    try wl(out, "  %zero_ptr = getelementptr i8, ptr %buffer, i64 19");
    try wl(out, "  store i8 48, ptr %zero_ptr");
    try wl(out, "  br label %finish_zero");
    try wl(out, "nonzero:");
    try wl(out, "  %is_negative = icmp slt i64 %value, 0");
    try wl(out, "  br i1 %is_negative, label %negative, label %positive");
    try wl(out, "negative:");
    try wl(out, "  br label %loop");
    try wl(out, "positive:");
    try wl(out, "  %positive_current = sub i64 0, %value");
    try wl(out, "  br label %loop");
    try wl(out, "loop:");
    try wl(out, "  %current = phi i64 [ %value, %negative ], [ %positive_current, %positive ], [ %quotient, %loop ]");
    try wl(out, "  %write_index = phi i64 [ 19, %negative ], [ 19, %positive ], [ %next_index, %loop ]");
    try wl(out, "  %raw_digit = srem i64 %current, 10");
    try wl(out, "  %digit = sub i64 0, %raw_digit");
    try wl(out, "  %digit_byte_i64 = add i64 %digit, 48");
    try wl(out, "  %digit_byte = trunc i64 %digit_byte_i64 to i8");
    try wl(out, "  %digit_ptr = getelementptr i8, ptr %buffer, i64 %write_index");
    try wl(out, "  store i8 %digit_byte, ptr %digit_ptr");
    try wl(out, "  %quotient = sdiv i64 %current, 10");
    try wl(out, "  %next_index = sub i64 %write_index, 1");
    try wl(out, "  %done = icmp eq i64 %quotient, 0");
    try wl(out, "  br i1 %done, label %maybe_sign, label %loop");
    try wl(out, "maybe_sign:");
    try wl(out, "  br i1 %is_negative, label %write_sign, label %finish_loop");
    try wl(out, "write_sign:");
    try wl(out, "  %sign_ptr = getelementptr i8, ptr %buffer, i64 %next_index");
    try wl(out, "  store i8 45, ptr %sign_ptr");
    try wl(out, "  br label %finish_sign");
    try wl(out, "finish_zero:");
    try wl(out, "  br label %success");
    try wl(out, "finish_loop:");
    try wl(out, "  br label %success");
    try wl(out, "finish_sign:");
    try wl(out, "  br label %success");
    try wl(out, "success:");
    try wl(out, "  %start = phi i64 [ 19, %finish_zero ], [ %write_index, %finish_loop ], [ %next_index, %finish_sign ]");
    try wl(out, "  %len = sub i64 20, %start");
    try wl(out, "  %start_ptr = getelementptr i8, ptr %buffer, i64 %start");
    try wl(out, "  %slice_base = insertvalue %kizu.slice.u8 poison, ptr %start_ptr, 0");
    try wl(out, "  %slice = insertvalue %kizu.slice.u8 %slice_base, i64 %len, 1");
    try wl(out, "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try wl(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %slice, 1");
    try wl(out, "  ret %kizu.error.slice.u8 %result");
    try wl(out, "alloc_failed:");
    try wl(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try wl(out, "}");
    try nl(out);
    return;
}

fn render_string_format_helpers(out: &var std::string::String) -> !void {
    try wl(out, "define %kizu.error.void @kizu_run_string_append_i64(%kizu.owned %text, i64 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %decimal = call %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %value)");
    try wl(out, "  %ok = extractvalue %kizu.error.slice.u8 %decimal, 0");
    try wl(out, "  br i1 %ok, label %append, label %fail");
    try wl(out, "append:");
    try wl(out, "  %slice = extractvalue %kizu.error.slice.u8 %decimal, 1");
    try wl(out, "  %result = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %text, %kizu.slice.u8 %slice)");
    try wl(out, "  ret %kizu.error.void %result");
    try wl(out, "fail:");
    try wl(out, "  ret %kizu.error.void zeroinitializer");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_bool(%kizu.owned %text, i1 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %ptr = select i1 %value, ptr @.kizu.run.true_word, ptr @.kizu.run.false_word");
    try wl(out, "  %len = select i1 %value, i64 4, i64 5");
    try wl(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try wl(out, "  %slice = insertvalue %kizu.slice.u8 %base, i64 %len, 1");
    try wl(out, "  %result = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %text, %kizu.slice.u8 %slice)");
    try wl(out, "  ret %kizu.error.void %result");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define i8 @kizu_run_hex_digit(i8 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %low = icmp ult i8 %value, 10");
    try wl(out, "  %num = add i8 %value, 48");
    try wl(out, "  %hex = add i8 %value, 87");
    try wl(out, "  %result = select i1 %low, i8 %num, i8 %hex");
    try wl(out, "  ret i8 %result");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 %second) {");
    try wl(out, "entry:");
    try wl(out, "  %first = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 92)");
    try wl(out, "  %first_ok = extractvalue %kizu.error.void %first, 0");
    try wl(out, "  br i1 %first_ok, label %append_second, label %fail");
    try wl(out, "append_second:");
    try wl(out, "  %result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 %second)");
    try wl(out, "  ret %kizu.error.void %result");
    try wl(out, "fail:");
    try wl(out, "  ret %kizu.error.void %first");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_hex_escape(%kizu.owned %text, i8 %byte) {");
    try wl(out, "entry:");
    try wl(out, "  %high_nibble = lshr i8 %byte, 4");
    try wl(out, "  %low_nibble = and i8 %byte, 15");
    try wl(out, "  %high = call i8 @kizu_run_hex_digit(i8 %high_nibble)");
    try wl(out, "  %low = call i8 @kizu_run_hex_digit(i8 %low_nibble)");
    try wl(out, "  %slash = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 92)");
    try wl(out, "  %slash_ok = extractvalue %kizu.error.void %slash, 0");
    try wl(out, "  br i1 %slash_ok, label %write_x, label %slash_fail");
    try wl(out, "write_x:");
    try wl(out, "  %x = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 120)");
    try wl(out, "  %x_ok = extractvalue %kizu.error.void %x, 0");
    try wl(out, "  br i1 %x_ok, label %write_high, label %x_fail");
    try wl(out, "write_high:");
    try wl(out, "  %high_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 %high)");
    try wl(out, "  %high_ok = extractvalue %kizu.error.void %high_result, 0");
    try wl(out, "  br i1 %high_ok, label %write_low, label %high_fail");
    try wl(out, "write_low:");
    try wl(out, "  %low_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 %low)");
    try wl(out, "  ret %kizu.error.void %low_result");
    try wl(out, "slash_fail:");
    try wl(out, "  ret %kizu.error.void %slash");
    try wl(out, "x_fail:");
    try wl(out, "  ret %kizu.error.void %x");
    try wl(out, "high_fail:");
    try wl(out, "  ret %kizu.error.void %high_result");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_escaped_byte(%kizu.owned %text, i8 %byte) {");
    try wl(out, "entry:");
    try wl(out, "  %is_quote = icmp eq i8 %byte, 34");
    try wl(out, "  br i1 %is_quote, label %quote, label %check_backslash");
    try wl(out, "quote:");
    try wl(out, "  %quote_result = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 34)");
    try wl(out, "  ret %kizu.error.void %quote_result");
    try wl(out, "check_backslash:");
    try wl(out, "  %is_backslash = icmp eq i8 %byte, 92");
    try wl(out, "  br i1 %is_backslash, label %backslash, label %check_newline");
    try wl(out, "backslash:");
    try wl(out, "  %backslash_result = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 92)");
    try wl(out, "  ret %kizu.error.void %backslash_result");
    try wl(out, "check_newline:");
    try wl(out, "  %is_newline = icmp eq i8 %byte, 10");
    try wl(out, "  br i1 %is_newline, label %newline, label %check_return");
    try wl(out, "newline:");
    try wl(out, "  %newline_result = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 110)");
    try wl(out, "  ret %kizu.error.void %newline_result");
    try wl(out, "check_return:");
    try wl(out, "  %is_return = icmp eq i8 %byte, 13");
    try wl(out, "  br i1 %is_return, label %return_byte, label %check_tab");
    try wl(out, "return_byte:");
    try wl(out, "  %return_result = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 114)");
    try wl(out, "  ret %kizu.error.void %return_result");
    try wl(out, "check_tab:");
    try wl(out, "  %is_tab = icmp eq i8 %byte, 9");
    try wl(out, "  br i1 %is_tab, label %tab, label %check_printable");
    try wl(out, "tab:");
    try wl(out, "  %tab_result = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 116)");
    try wl(out, "  ret %kizu.error.void %tab_result");
    try wl(out, "check_printable:");
    try wl(out, "  %ge_space = icmp uge i8 %byte, 32");
    try wl(out, "  %le_tilde = icmp ule i8 %byte, 126");
    try wl(out, "  %printable = and i1 %ge_space, %le_tilde");
    try wl(out, "  br i1 %printable, label %plain, label %hex");
    try wl(out, "plain:");
    try wl(out, "  %plain_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 %byte)");
    try wl(out, "  ret %kizu.error.void %plain_result");
    try wl(out, "hex:");
    try wl(out, "  %hex_result = call %kizu.error.void @kizu_run_string_append_hex_escape(%kizu.owned %text, i8 %byte)");
    try wl(out, "  ret %kizu.error.void %hex_result");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_bytes_literal(%kizu.owned %text, %kizu.slice.u8 %bytes) {");
    try wl(out, "entry:");
    try wl(out, "  %open = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 34)");
    try wl(out, "  %open_ok = extractvalue %kizu.error.void %open, 0");
    try wl(out, "  br i1 %open_ok, label %loop, label %open_fail");
    try wl(out, "loop:");
    try wl(out, "  %ptr = extractvalue %kizu.slice.u8 %bytes, 0");
    try wl(out, "  %len = extractvalue %kizu.slice.u8 %bytes, 1");
    try wl(out, "  br label %loop_head");
    try wl(out, "loop_head:");
    try wl(out, "  %i = phi i64 [ 0, %loop ], [ %next, %step_ok ]");
    try wl(out, "  %done = icmp sge i64 %i, %len");
    try wl(out, "  br i1 %done, label %close, label %step");
    try wl(out, "step:");
    try wl(out, "  %byte_ptr = getelementptr i8, ptr %ptr, i64 %i");
    try wl(out, "  %byte = load i8, ptr %byte_ptr");
    try wl(out, "  %step_result = call %kizu.error.void @kizu_run_string_append_escaped_byte(%kizu.owned %text, i8 %byte)");
    try wl(out, "  %step_ok_flag = extractvalue %kizu.error.void %step_result, 0");
    try wl(out, "  br i1 %step_ok_flag, label %step_ok, label %step_fail");
    try wl(out, "step_ok:");
    try wl(out, "  %next = add i64 %i, 1");
    try wl(out, "  br label %loop_head");
    try wl(out, "close:");
    try wl(out, "  %close_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 34)");
    try wl(out, "  ret %kizu.error.void %close_result");
    try wl(out, "open_fail:");
    try wl(out, "  ret %kizu.error.void %open");
    try wl(out, "step_fail:");
    try wl(out, "  ret %kizu.error.void %step_result");
    try wl(out, "}");
    try nl(out);
    return;
}

// render_string_globals walks the tape and emits a private constant for every
// CONST_STR record's payload span (named '@.kizu.run.s<dst>'), every ENUM_CONST
// record's qualified variant span (named '@.kizu.run.e<dst>'), and every
// ENUM_DECL variant span (named '@.kizu.run.ed<record>v<tag>'). UNION_CONST
// records get no global: the print lowering rejects union values, so nothing
// references enum globals for them (lift both sides together if union printing
// ever lands).
fn render_string_globals(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    if index >= code.len() {
        return;
    }
    let op = try code.get(index);
    let const_str = codegen::code_op_const_str();
    let next = try tape_record_end(code, index);
    if op == const_str {
        try render_one_string_global(out, text, code, index);
    }
    let enum_const = codegen::code_op_enum_const();
    if op == enum_const {
        try render_one_enum_global(out, text, code, index);
    }
    let enum_decl = codegen::code_op_enum_decl();
    if op == enum_decl {
        try render_enum_decl_globals(out, text, code, index, 0);
    }
    try render_string_globals(out, text, code, next);
    return;
}

// render_one_enum_global emits the qualified 'Enum::Variant' source text the
// ENUM_CONST record at index spans, so print writes the variant name verbatim.
fn render_one_enum_global(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let qual_start = try code.get(index + 2);
    let qual_end = try code.get(index + 3);
    let payload = text[qual_start..qual_end];
    let byte_len = qual_end - qual_start;
    try w(out, "@.kizu.run.e");
    try wi(out, dst);
    try w(out, " = private unnamed_addr constant [");
    try wi(out, byte_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try render_llvm_c_bytes(out, payload);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

fn render_enum_decl_globals(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    record_pos: i64,
    index: i64
) -> !void {
    let count_pos = record_pos + 3;
    let variant_count = try code.get(count_pos);
    if index >= variant_count {
        return;
    }
    try render_one_enum_decl_global(out, text, code, record_pos, index);
    let after = index + 1;
    try render_enum_decl_globals(out, text, code, record_pos, after);
    return;
}

fn render_one_enum_decl_global(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    record_pos: i64,
    tag: i64
) -> !void {
    let enum_start = try code.get(record_pos + 1);
    let enum_end = try code.get(record_pos + 2);
    let entry_pos = enum_decl_variant_entry_pos(record_pos, tag);
    let var_start = try code.get(entry_pos);
    let name_end_pos = entry_pos + 1;
    let var_end = try code.get(name_end_pos);
    let enum_name = text[enum_start..enum_end];
    let variant_name = text[var_start..var_end];
    let enum_len = enum_end - enum_start;
    let variant_len = var_end - var_start;
    let byte_len = enum_len + 2 + variant_len;
    try w(out, "@.kizu.run.ed");
    try wi(out, record_pos);
    try w(out, "v");
    try wi(out, tag);
    try w(out, " = private unnamed_addr constant [");
    try wi(out, byte_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try render_llvm_c_bytes(out, enum_name);
    try w(out, "::");
    try render_llvm_c_bytes(out, variant_name);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

fn render_one_string_global(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let byte_len = try tape_const_str_payload_length(code, index);
    try w(out, "@.kizu.run.s");
    try wi(out, dst);
    try w(out, " = private unnamed_addr constant [");
    try wi(out, byte_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try render_const_str_segments(out, text, code, index);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

// render_const_str_segments renders every payload span segment of the CONST_STR
// record at index, joining consecutive segments with an escaped newline byte.
fn render_const_str_segments(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let seg_count = try code.get(index + 2);
    try render_const_str_segment(out, text, code, index, seg_count, 0);
    return;
}

// render_const_str_segment renders the segment at seg then recurses to the next,
// prefixing every segment after the first with an escaped newline byte.
fn render_const_str_segment(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64,
    seg_count: i64,
    seg: i64
) -> !void {
    if seg >= seg_count {
        return;
    }
    // Bind each span slot so the get() calls take locals rather than nested
    // binary args (the call-arg lowering only models 'base + <int literal>').
    let span_slots = seg * 2;
    let start_slot = index + 3 + span_slots;
    let end_slot = start_slot + 1;
    let seg_start = try code.get(start_slot);
    let seg_end = try code.get(end_slot);
    let payload = text[seg_start..seg_end];
    let newline = cast<u8>(10);
    if seg > 0 {
        try render_llvm_c_byte(out, newline);
    }
    try render_llvm_c_bytes(out, payload);
    let after = seg + 1;
    try render_const_str_segment(out, text, code, index, seg_count, after);
    return;
}

// render_functions walks the tape function by function: each FUNC_BEGIN..FUNC_END
// span renders one LLVM define ('main' is the kizu_run_main entry, every other
// function a kizu_run_user_<name> i64 define), then the walk resumes past FUNC_END.
fn render_functions(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !void {
    if index >= code.len() {
        return;
    }
    let after = try render_function_or_skip(out, text, code, kinds, index);
    try render_functions(out, text, code, kinds, after);
    return;
}

// render_function_or_skip renders the function whose FUNC_BEGIN is at index (or
// skips a stray non-function record) and returns the next tape index to walk from.
fn render_function_or_skip(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !i64 {
    let op = try code.get(index);
    let func_begin = codegen::code_op_func_begin();
    if op == func_begin {
        return try render_one_function(out, text, code, kinds, index);
    }
    let method_func_begin = codegen::code_op_method_func_begin();
    if op == method_func_begin {
        return try render_one_method_function(out, text, code, kinds, index);
    }
    return try tape_record_end(code, index);
}

// render_one_function renders the function whose FUNC_BEGIN is at func_index and
// returns the tape index past its FUNC_END.
fn render_one_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    func_index: i64
) -> !i64 {
    let name_start = try code.get(func_index + 1);
    let name_end = try code.get(func_index + 2);
    let param_count = try code.get(func_index + 3);
    let ret_kind = try code.get(func_index + 4);
    let param_base = try code.get(func_index + 5);
    let name = text[name_start..name_end];
    let body_start = func_index + 6;
    let func_end = try tape_function_end(code, body_start);
    // Each renderer returns the tape index past its FUNC_END so this stays a pair of
    // single-statement early-return guards (the shape the compiled-MIR if-lowering
    // models), keeping render_one_function free of a multi-statement then-body.
    if std::mem::equal_bytes(name, "main") {
        return try render_main_function(out, text, code, kinds, body_start, func_end);
    }
    return try render_user_function(out, text, code, kinds, name, param_base, param_count, ret_kind, body_start, func_end);
}

fn render_one_method_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    func_index: i64
) -> !i64 {
    let type_start = try code.get(func_index + 1);
    let type_end = try code.get(func_index + 2);
    let name_start = try code.get(func_index + 3);
    let name_end = try code.get(func_index + 4);
    let param_count = try code.get(func_index + 5);
    let ret_kind = try code.get(func_index + 6);
    let param_base = try code.get(func_index + 7);
    let type_name = text[type_start..type_end];
    let name = text[name_start..name_end];
    let body_start = func_index + 8;
    let func_end = try tape_function_end(code, body_start);
    return try render_user_method_function(out, text, code, kinds, type_name, name, param_base, param_count, ret_kind, body_start, func_end);
}

// The return ABI selects how returns and try-propagations render: MAIN is the
// kizu_run_main i64 entry (a void return is exit 0, a try failure exits 1),
// USER_I64 is an ordinary i64-returning user define, and USER_ERR_VOID is a
// '%kizu.error.void'-returning user define (a void return is the ok union, a try
// failure returns the propagated error).
fn ret_abi_main() -> i64 {
    return 0;
}

fn ret_abi_user_i64() -> i64 {
    return 1;
}

fn ret_abi_user_err_void() -> i64 {
    return 2;
}

fn ret_abi_user_err_i64() -> i64 {
    return 3;
}

fn ret_abi_user_bool() -> i64 {
    return 4;
}

fn return_kind_bool() -> i64 {
    return 900;
}

// user_ret_abi maps a user function's declared return kind (0 void, 1 i64, 2
// error-union void, 3 error-union i64, bool) to its render ABI.
fn user_ret_abi(ret_kind: i64) -> i64 {
    if ret_kind == 2 {
        return ret_abi_user_err_void();
    }
    if ret_kind == 3 {
        return ret_abi_user_err_i64();
    }
    let bool_ret = return_kind_bool();
    if ret_kind == bool_ret {
        return ret_abi_user_bool();
    }
    return ret_abi_user_i64();
}

fn render_main_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    body_start: i64,
    func_end: i64
) -> !i64 {
    try wl(out, "define i64 @kizu_run_main() {");
    try wl(out, "entry:");
    try wl(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try render_var_allocas(out, code, body_start, func_end);
    let main_abi = ret_abi_main();
    try render_body(out, text, code, kinds, body_start, func_end, main_abi);
    // Every return record terminates its block and opens a fresh dead label, so
    // the body always leaves one open block; the process-exit tail terminates it
    // (as the live void fall-through or as dead code after a trailing return).
    try render_main_tail(out);
    try wl(out, "}");
    try nl(out);
    return func_end + 1;
}

// render_main_tail emits the process-exit terminator closing kizu_run_main's
// final open block.
fn render_main_tail(out: &var std::string::String) -> !void {
    try wl(out, "  %exit_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try wl(out, "  ret i64 %exit_code");
    return;
}

fn render_user_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    name: []u8,
    param_base: i64,
    param_count: i64,
    ret_kind: i64,
    body_start: i64,
    func_end: i64
) -> !i64 {
    try render_user_define_head(out, code, name, ret_kind);
    try w(out, "(");
    try render_param_list(out, code, kinds, param_base, param_count, 0);
    try wl(out, ") {");
    try wl(out, "entry:");
    // A user function that prints needs the io handle the print writers reference;
    // bind it at entry only when the body actually contains a PRINT record.
    let prints = try body_has_print(code, body_start, func_end);
    if prints {
        try wl(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    }
    try render_var_allocas(out, code, body_start, func_end);
    let abi = user_ret_abi(ret_kind);
    try render_body(out, text, code, kinds, body_start, func_end, abi);
    // Every return record terminates its block and opens a fresh dead label, so
    // the body always leaves one open block; the ABI default terminator closes it
    // (an i64 function returns 0, an error-union-void function the ok union).
    try render_user_tail(out, code, abi, ret_kind);
    try wl(out, "}");
    try nl(out);
    return func_end + 1;
}

fn render_user_method_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    type_name: []u8,
    name: []u8,
    param_base: i64,
    param_count: i64,
    ret_kind: i64,
    body_start: i64,
    func_end: i64
) -> !i64 {
    try render_user_method_define_head(out, code, type_name, name, ret_kind);
    try w(out, "(");
    try render_param_list(out, code, kinds, param_base, param_count, 0);
    try wl(out, ") {");
    try wl(out, "entry:");
    let prints = try body_has_print(code, body_start, func_end);
    if prints {
        try wl(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    }
    try render_var_allocas(out, code, body_start, func_end);
    let abi = user_ret_abi(ret_kind);
    try render_body(out, text, code, kinds, body_start, func_end, abi);
    try render_user_tail(out, code, abi, ret_kind);
    try wl(out, "}");
    try nl(out);
    return func_end + 1;
}

// render_user_define_head writes the 'define <ret> @kizu_run_user_<name>' opener
// whose return type follows the declared kind: '%kizu.error.void' for '!void',
// '%kizu.error.i64' for '!i64', i1 for bool, and i64 for other word returns.
fn render_user_define_head(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    name: []u8,
    ret_kind: i64
) -> !void {
    let is_err_void = ret_kind == 2;
    let is_err_i64 = ret_kind == 3;
    let bool_ret = return_kind_bool();
    let is_bool = ret_kind == bool_ret;
    let is_union_ret = try value_kind_is_union(code, ret_kind);
    let is_struct_ret = try value_kind_is_struct_decl(code, ret_kind);
    if is_err_void {
        try w(out, "define %kizu.error.void @kizu_run_user_");
    }
    if is_err_i64 {
        try w(out, "define %kizu.error.i64 @kizu_run_user_");
    }
    if is_union_ret {
        try w(out, "define %kizu.run.union @kizu_run_user_");
    }
    if is_struct_ret {
        try render_user_define_head_struct(out, code, ret_kind);
    }
    if is_bool {
        try w(out, "define i1 @kizu_run_user_");
    }
    let is_word_ret = !is_err_void and !is_err_i64 and !is_bool and !is_union_ret and !is_struct_ret;
    if is_word_ret {
        try w(out, "define i64 @kizu_run_user_");
    }
    try w(out, name);
    return;
}

fn render_user_define_head_struct(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    ret_kind: i64
) -> !void {
    try w(out, "define ");
    try render_struct_decl_value_type(out, code, ret_kind);
    try w(out, " @kizu_run_user_");
    return;
}

fn render_user_method_define_head(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    type_name: []u8,
    name: []u8,
    ret_kind: i64
) -> !void {
    try w(out, "define ");
    try render_user_return_type(out, code, ret_kind);
    try w(out, " @kizu_run_user_");
    try render_method_symbol(out, type_name, name);
    return;
}

fn render_user_return_type(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    ret_kind: i64
) -> !void {
    let is_err_void = ret_kind == 2;
    let is_err_i64 = ret_kind == 3;
    let bool_ret = return_kind_bool();
    let is_bool = ret_kind == bool_ret;
    let is_union_ret = try value_kind_is_union(code, ret_kind);
    let is_struct_ret = try value_kind_is_struct_decl(code, ret_kind);
    if is_err_void {
        try w(out, "%kizu.error.void");
    }
    if is_err_i64 {
        try w(out, "%kizu.error.i64");
    }
    if is_union_ret {
        try w(out, "%kizu.run.union");
    }
    if is_struct_ret {
        try render_struct_decl_value_type(out, code, ret_kind);
    }
    if is_bool {
        try w(out, "i1");
    }
    let is_word_ret = !is_err_void and !is_err_i64 and !is_bool and !is_union_ret and !is_struct_ret;
    if is_word_ret {
        try w(out, "i64");
    }
    return;
}

fn render_method_symbol(out: &var std::string::String, type_name: []u8, name: []u8) -> !void {
    try w(out, type_name);
    try w(out, "__");
    try w(out, name);
    return;
}

// render_user_tail closes a user function body's final open block with the
// default terminator for its ABI.
fn render_user_tail(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    abi: i64,
    ret_kind: i64
) -> !void {
    let err_void = ret_abi_user_err_void();
    let err_i64 = ret_abi_user_err_i64();
    let is_err_void = abi == err_void;
    let is_err_i64 = abi == err_i64;
    let bool_ret = return_kind_bool();
    let is_bool = ret_kind == bool_ret;
    let is_union_ret = try value_kind_is_union(code, ret_kind);
    let is_struct_ret = try value_kind_is_struct_decl(code, ret_kind);
    if is_err_void {
        try render_ret_err_ok(out);
    }
    if is_err_i64 {
        try wl(out, "  ret %kizu.error.i64 { i1 true, i64 0, %kizu.slice.u8 zeroinitializer }");
    }
    // The checker guarantees a union-returning body ends with a return, so this
    // tail only types the dead fall-through block.
    if is_union_ret {
        try wl(out, "  ret %kizu.run.union zeroinitializer");
    }
    if is_struct_ret {
        try render_user_tail_struct(out, code, ret_kind);
    }
    if is_bool {
        try wl(out, "  ret i1 false");
    }
    let is_word_ret = !is_err_void and !is_err_i64 and !is_bool and !is_union_ret and !is_struct_ret;
    if is_word_ret {
        try wl(out, "  ret i64 0");
    }
    return;
}

fn render_user_tail_struct(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    ret_kind: i64
) -> !void {
    try w(out, "  ret ");
    try render_struct_decl_value_type(out, code, ret_kind);
    try wl(out, " zeroinitializer");
    return;
}

// render_param_list emits '<type> %v<param_base+i>' separated by commas, typing
// each parameter from its value kind (i1 for bool, i64 otherwise).
fn render_param_list(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    param_base: i64,
    param_count: i64,
    index: i64
) -> !void {
    if index >= param_count {
        return;
    }
    if index > 0 {
        try w(out, ", ");
    }
    // Bind the slot id so the wi() call takes a local rather than a 'base + index'
    // binary arg (the call-arg lowering only models 'base + <int literal>').
    let slot = param_base + index;
    let kind = try kinds.get(slot);
    try render_value_type(out, code, kind);
    try w(out, " %v");
    try wi(out, slot);
    let after = index + 1;
    try render_param_list(out, code, kinds, param_base, param_count, after);
    return;
}

// render_value_type writes the LLVM type for a tape value kind: bool values are
// 'i1', slice values '%kizu.slice.u8', UNION_DECL-backed values the runtime
// union aggregate, every other scalar value 'i64'.
fn render_value_type(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kind: i64
) -> !void {
    let kind_bool = codegen::code_kind_bool();
    let kind_slice = codegen::code_kind_slice();
    let kind_handle = codegen::code_kind_handle();
    let is_bool = kind == kind_bool;
    let is_slice = kind == kind_slice;
    let is_handle = kind == kind_handle;
    let is_owned = value_kind_is_owned(kind);
    let is_union = try value_kind_is_union(code, kind);
    let is_struct_decl = try value_kind_is_struct_decl(code, kind);
    let is_struct_param = try value_kind_is_struct_param(code, kind);
    if is_bool {
        try w(out, "i1");
    }
    if is_slice {
        try w(out, "%kizu.slice.u8");
    }
    if is_handle {
        try w(out, "%kizu.handle");
    }
    if is_owned {
        try w(out, "%kizu.owned");
    }
    if is_union {
        try w(out, "%kizu.run.union");
    }
    if is_struct_decl {
        try render_struct_decl_value_type(out, code, kind);
    }
    if is_struct_param {
        try render_struct_param_value_type(out, code, kind);
    }
    let scalar = !is_bool and !is_slice and !is_handle and !is_owned and !is_union and !is_struct_decl and !is_struct_param;
    if scalar {
        try w(out, "i64");
    }
    return;
}

fn value_kind_is_owned(kind: i64) -> bool {
    if kind == codegen::code_kind_owned() {
        return true;
    }
    if kind == codegen::code_kind_owned_string() {
        return true;
    }
    if codegen::code_kind_is_owned_array(kind) {
        return true;
    }
    if kind == codegen::code_kind_owned_map_i64() {
        return true;
    }
    return codegen::code_kind_is_arena(kind);
}

// value_kind_is_union reports whether a record-backed value kind references a
// UNION_DECL record (a value of the runtime union aggregate type).
fn value_kind_is_union(code: &std::array::Array<i64>, kind: i64) -> !bool {
    let record_base = codegen::code_kind_struct_base();
    if kind < record_base {
        return false;
    }
    let record_pos = kind - record_base;
    let op = try code.get(record_pos);
    let op_union_decl = codegen::code_op_union_decl();
    return op == op_union_decl;
}

fn value_kind_is_struct_decl(code: &std::array::Array<i64>, kind: i64) -> !bool {
    let record_base = codegen::code_kind_struct_base();
    if kind < record_base {
        return false;
    }
    let record_pos = kind - record_base;
    let op = try code.get(record_pos);
    let op_struct_decl = codegen::code_op_struct_decl();
    return op == op_struct_decl;
}

fn render_struct_decl_value_type(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kind: i64
) -> !void {
    let record_base = codegen::code_kind_struct_base();
    let record_pos = kind - record_base;
    try render_struct_decl_type_at(out, code, record_pos);
    return;
}

fn render_struct_decl_type_at(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    record_pos: i64
) -> !void {
    let field_count = try code.get(record_pos + 3);
    try w(out, "{ ");
    try render_struct_decl_type_fields(out, code, record_pos, field_count, 0);
    try w(out, " }");
    return;
}

fn render_struct_decl_type_fields(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    index: i64
) -> !void {
    if index >= field_count {
        return;
    }
    if index > 0 {
        try w(out, ", ");
    }
    let field_kind = try struct_decl_field_kind(code, record_pos, index);
    try render_value_type(out, code, field_kind);
    let after = index + 1;
    try render_struct_decl_type_fields(out, code, record_pos, field_count, after);
    return;
}

fn struct_decl_field_kind(
    code: &std::array::Array<i64>,
    record_pos: i64,
    index: i64
) -> !i64 {
    let entry_slots = index * 3;
    let entry_pos = record_pos + 4 + entry_slots;
    let field_kind = try code.get(entry_pos + 2);
    return field_kind;
}

fn value_kind_is_struct_param(code: &std::array::Array<i64>, kind: i64) -> !bool {
    let record_base = codegen::code_kind_struct_base();
    if kind < record_base {
        return false;
    }
    let record_pos = kind - record_base;
    let op = try code.get(record_pos);
    let op_struct_param = codegen::code_op_struct_param();
    return op == op_struct_param;
}

fn render_struct_param_value_type(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kind: i64
) -> !void {
    let field_kind = try struct_param_first_field_kind(code, kind);
    try render_value_type(out, code, field_kind);
    return;
}

fn struct_param_first_field_kind(code: &std::array::Array<i64>, kind: i64) -> !i64 {
    let record_base = codegen::code_kind_struct_base();
    let record_pos = kind - record_base;
    let kind_pos = record_pos + 4;
    let field_kind = try code.get(kind_pos);
    return field_kind;
}

// tape_function_end returns the index of the FUNC_END record closing the function
// whose body begins at index.
fn tape_function_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    // Bind the tape length once so the bounds guard returns a local rather than a
    // 'return code.len();' the compiled-MIR if-then early-return path would treat as
    // a free-function call.
    let total = code.len();
    if index >= total {
        return total;
    }
    let op = try code.get(index);
    let func_end = codegen::code_op_func_end();
    if op == func_end {
        return index;
    }
    let next = try tape_record_end(code, index);
    return try tape_function_end(code, next);
}

// body_has_print reports whether the records in [index, func_end) include a PRINT.
fn body_has_print(
    code: &std::array::Array<i64>,
    index: i64,
    func_end: i64
) -> !bool {
    if index >= func_end {
        return false;
    }
    let op = try code.get(index);
    let print_op = codegen::code_op_print();
    if op == print_op {
        return true;
    }
    let next = try tape_record_end(code, index);
    return try body_has_print(code, next, func_end);
}

// render_var_allocas hoists one 'alloca i64' to the function entry for every var
// slot the body declares: a VAR_DECL slot (a 'var' local) or a FOR_BEGIN slot (a
// for-loop induction var). Hoisting all slots to entry keeps every VAR_LOAD/STORE
// and the for latch dominated by the alloca regardless of loop nesting.
fn render_var_allocas(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    func_end: i64
) -> !void {
    if index >= func_end {
        return;
    }
    let op = try code.get(index);
    let var_decl = codegen::code_op_var_decl();
    if op == var_decl {
        let decl_slot = try code.get(index + 1);
        try render_one_alloca(out, decl_slot);
    }
    let var_decl_slice = codegen::code_op_var_decl_slice();
    if op == var_decl_slice {
        let slice_slot = try code.get(index + 1);
        try render_one_slice_alloca(out, slice_slot);
    }
    let var_decl_bool = codegen::code_op_var_decl_bool();
    if op == var_decl_bool {
        let bool_slot = try code.get(index + 1);
        try render_one_bool_alloca(out, bool_slot);
    }
    let for_begin = codegen::code_op_for_begin();
    if op == for_begin {
        let for_slot = try code.get(index + 2);
        try render_one_alloca(out, for_slot);
    }
    let sc_begin = codegen::code_op_sc_begin();
    if op == sc_begin {
        let sc_slot = try code.get(index + 1);
        try render_one_sc_alloca(out, sc_slot);
    }
    let next = try tape_record_end(code, index);
    try render_var_allocas(out, code, next, func_end);
    return;
}

// render_one_alloca emits '%slot<id> = alloca i64' for one var slot.
fn render_one_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %slot");
    try wi(out, slot);
    try wl(out, " = alloca i64");
    return;
}

// render_one_slice_alloca emits '%sslot<id> = alloca %kizu.slice.u8' for one
// scalarized slice-field slot.
fn render_one_slice_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %sslot");
    try wi(out, slot);
    try wl(out, " = alloca %kizu.slice.u8");
    return;
}

// render_one_bool_alloca emits '%bslot<id> = alloca i1' for one value-position
// if/match result slot whose branches yield bool values.
fn render_one_bool_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %bslot");
    try wi(out, slot);
    try wl(out, " = alloca i1");
    return;
}

// render_one_sc_alloca emits '%sc<id> = alloca i1' for one short-circuit slot
// (named by its SC_BEGIN tape index and hoisted to the function entry).
fn render_one_sc_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %sc");
    try wi(out, slot);
    try wl(out, " = alloca i1");
    return;
}

// render_body renders the records in [index, func_end) of one function body.
fn render_body(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    func_end: i64,
    abi: i64
) -> !void {
    if index >= func_end {
        return;
    }
    let next = try tape_record_end(code, index);
    try render_one_instruction(out, text, code, kinds, index, abi);
    try render_body(out, text, code, kinds, next, func_end, abi);
    return;
}

fn render_one_instruction(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    // The opcodes are mutually exclusive, so each writer runs under its own void
    // then-body guard and the function falls through to a single return -- the shape
    // both the Go reference compiler and the compiled-MIR void if-lowering accept (a
    // 'return try <void call>;' identity tail is rejected by the former).
    let op = try code.get(index);
    let const_int = codegen::code_op_const_int();
    if op == const_int {
        try render_const_int(out, code, index);
    }
    let const_bool = codegen::code_op_const_bool();
    if op == const_bool {
        try render_const_bool(out, code, index);
    }
    let not_op = codegen::code_op_not();
    if op == not_op {
        try render_not(out, code, index);
    }
    let binary = codegen::code_op_binary();
    if op == binary {
        try render_binary(out, code, index);
    }
    let sc_begin = codegen::code_op_sc_begin();
    if op == sc_begin {
        try render_sc_begin(out, code, index);
    }
    let sc_end = codegen::code_op_sc_end();
    if op == sc_end {
        try render_sc_end(out, code, index);
    }
    let print_op = codegen::code_op_print();
    if op == print_op {
        try render_print(out, code, index);
    }
    let str_slice = codegen::code_op_str_slice();
    if op == str_slice {
        try render_str_slice(out, code, index);
    }
    let enum_const = codegen::code_op_enum_const();
    if op == enum_const {
        try render_enum_const(out, code, index);
    }
    // A UNION_CONST shares ENUM_CONST's dst/tag offsets, so the tag-constant
    // renderer serves both (the payload value renders through its own record).
    let union_const = codegen::code_op_union_const();
    if op == union_const {
        try render_enum_const(out, code, index);
    }
    let union_pack = codegen::code_op_union_pack();
    if op == union_pack {
        try render_union_pack(out, code, index);
    }
    let union_tag = codegen::code_op_union_tag();
    if op == union_tag {
        try render_union_tag(out, code, index);
    }
    let union_payload = codegen::code_op_union_payload();
    if op == union_payload {
        try render_union_payload(out, code, index);
    }
    let struct_pack = codegen::code_op_struct_pack();
    if op == struct_pack {
        try render_struct_pack(out, code, index);
    }
    let struct_field = codegen::code_op_struct_field();
    if op == struct_field {
        try render_struct_field(out, code, index);
    }
    let call = codegen::code_op_call();
    if op == call {
        try render_call(out, text, code, kinds, index);
    }
    let method_call = codegen::code_op_method_call();
    if op == method_call {
        try render_method_call(out, text, code, kinds, index);
    }
    let try_call = codegen::code_op_try_call();
    if op == try_call {
        try render_try_call(out, text, code, kinds, index, abi);
    }
    let try_call_i64 = codegen::code_op_try_call_i64();
    if op == try_call_i64 {
        try render_try_call_i64(out, text, code, kinds, index, abi);
    }
    let expect_op = codegen::code_op_expect();
    if op == expect_op {
        try render_expect(out, code, index);
    }
    let ret_value = codegen::code_op_ret_value();
    if op == ret_value {
        try render_ret_value(out, code, kinds, index, abi);
    }
    let ret_void = codegen::code_op_ret_void();
    if op == ret_void {
        try render_ret_void(out, index, abi);
    }
    let ret_err_fail = codegen::code_op_ret_err_fail();
    if op == ret_err_fail {
        try render_ret_err_fail(out, code, index, abi);
    }
    let io_blocking = codegen::code_op_io_blocking();
    if op == io_blocking {
        try render_io_blocking(out, code, index);
    }
    let page_allocator = codegen::code_op_page_allocator();
    if op == page_allocator {
        try render_page_allocator(out, code, index);
    }
    let string_new = codegen::code_op_string_new();
    if op == string_new {
        try render_string_new(out, code, index);
    }
    let string_as_bytes = codegen::code_op_string_as_bytes();
    if op == string_as_bytes {
        try render_string_as_bytes(out, code, index);
    }
    let mem_equal_bytes = codegen::code_op_mem_equal_bytes();
    if op == mem_equal_bytes {
        try render_mem_equal_bytes(out, code, index);
    }
    let try_fs_read = codegen::code_op_try_fs_read();
    if op == try_fs_read {
        try render_try_fs_read(out, code, index, abi);
    }
    let try_io_write = codegen::code_op_try_io_write();
    if op == try_io_write {
        try render_try_io_write(out, code, index, abi);
    }
    let try_string_append_i64 = codegen::code_op_try_string_append_i64();
    if op == try_string_append_i64 {
        try render_try_string_append_i64(out, code, index, abi);
    }
    let try_string_append_bool = codegen::code_op_try_string_append_bool();
    if op == try_string_append_bool {
        try render_try_string_append_bool(out, code, index, abi);
    }
    let try_string_append_bytes_literal = codegen::code_op_try_string_append_bytes_literal();
    if op == try_string_append_bytes_literal {
        try render_try_string_append_bytes_literal(out, code, index, abi);
    }
    let try_string_append_byte = codegen::code_op_try_string_append_byte();
    if op == try_string_append_byte {
        try render_try_string_append_byte(out, code, index, abi);
    }
    let mem_page_allocator = codegen::code_op_mem_page_allocator();
    if op == mem_page_allocator {
        try render_mem_page_allocator(out, code, index);
    }
    let storage_new = codegen::code_op_storage_new();
    if op == storage_new {
        try render_storage_new(out, code, index);
    }
    let storage_deinit = codegen::code_op_storage_deinit();
    if op == storage_deinit {
        try render_storage_deinit(out, code, index);
    }
    let arena_new = codegen::code_op_arena_new();
    if op == arena_new {
        try render_arena_new(out, code, index);
    }
    let arena_deinit = codegen::code_op_arena_deinit();
    if op == arena_deinit {
        try render_arena_deinit(out, code, index);
    }
    let string_len = codegen::code_op_string_len();
    if op == string_len {
        try render_string_len(out, code, index);
    }
    let try_string_append = codegen::code_op_try_string_append_bytes();
    if op == try_string_append {
        try render_try_string_append_bytes(out, code, index, abi);
    }
    let array_len = codegen::code_op_array_len();
    if op == array_len {
        try render_array_len(out, code, index);
    }
    let try_array_append = codegen::code_op_try_array_append_i64();
    if op == try_array_append {
        try render_try_array_append_i64(out, code, index, abi);
    }
    let try_array_append_value = codegen::code_op_try_array_append();
    if op == try_array_append_value {
        try render_try_array_append(out, code, index, abi);
    }
    let try_array_get = codegen::code_op_try_array_get_i64();
    if op == try_array_get {
        try render_try_array_get_i64(out, code, index, abi);
    }
    let try_array_get_value = codegen::code_op_try_array_get();
    if op == try_array_get_value {
        try render_try_array_get(out, code, index, abi);
    }
    let array_get = codegen::code_op_array_get_i64();
    if op == array_get {
        try render_array_get_i64(out, code, index);
    }
    let array_get_value = codegen::code_op_array_get();
    if op == array_get_value {
        try render_array_get(out, code, index);
    }
    let try_map_insert = codegen::code_op_try_map_insert_i64();
    if op == try_map_insert {
        try render_try_map_insert_i64(out, code, index, abi);
    }
    let map_contains = codegen::code_op_map_contains();
    if op == map_contains {
        try render_map_contains(out, code, index);
    }
    let map_len = codegen::code_op_map_len();
    if op == map_len {
        try render_map_len(out, code, index);
    }
    let try_map_get = codegen::code_op_try_map_get_i64();
    if op == try_map_get {
        try render_try_map_get_i64(out, code, index, abi);
    }
    let arena_add = codegen::code_op_arena_add_slice_struct();
    if op == arena_add {
        try render_arena_add_slice_struct(out, code, index);
    }
    let arena_get = codegen::code_op_arena_get_slice_struct_field();
    if op == arena_get {
        try render_arena_get_slice_struct_field(out, code, index);
    }
    let arena_add_struct = codegen::code_op_arena_add_struct();
    if op == arena_add_struct {
        try render_arena_add_struct(out, code, index);
    }
    let arena_get_struct = codegen::code_op_arena_get_struct_field();
    if op == arena_get_struct {
        try render_arena_get_struct_field(out, code, index);
    }
    let if_begin = codegen::code_op_if_begin();
    if op == if_begin {
        try render_if_begin(out, code, index);
    }
    let if_else = codegen::code_op_if_else();
    if op == if_else {
        try render_if_else(out, code, index);
    }
    let if_end = codegen::code_op_if_end();
    if op == if_end {
        try render_if_end(out, code, index);
    }
    let var_decl = codegen::code_op_var_decl();
    if op == var_decl {
        try render_var_decl(out, code, index);
    }
    let var_load = codegen::code_op_var_load();
    if op == var_load {
        try render_var_load(out, code, index);
    }
    let var_store = codegen::code_op_var_store();
    if op == var_store {
        try render_var_store(out, code, index);
    }
    let var_decl_slice = codegen::code_op_var_decl_slice();
    if op == var_decl_slice {
        try render_var_decl_slice(out, code, index);
    }
    let var_load_slice = codegen::code_op_var_load_slice();
    if op == var_load_slice {
        try render_var_load_slice(out, code, index);
    }
    let var_store_slice = codegen::code_op_var_store_slice();
    if op == var_store_slice {
        try render_var_store_slice(out, code, index);
    }
    let var_decl_bool = codegen::code_op_var_decl_bool();
    if op == var_decl_bool {
        try render_var_decl_bool(out, code, index);
    }
    let var_load_bool = codegen::code_op_var_load_bool();
    if op == var_load_bool {
        try render_var_load_bool(out, code, index);
    }
    let var_store_bool = codegen::code_op_var_store_bool();
    if op == var_store_bool {
        try render_var_store_bool(out, code, index);
    }
    let while_begin = codegen::code_op_while_begin();
    if op == while_begin {
        try render_while_begin(out, code, index);
    }
    let while_cond = codegen::code_op_while_cond();
    if op == while_cond {
        try render_while_cond(out, code, index);
    }
    let while_end = codegen::code_op_while_end();
    if op == while_end {
        try render_while_end(out, code, index);
    }
    let for_begin = codegen::code_op_for_begin();
    if op == for_begin {
        try render_for_begin(out, code, index);
    }
    let for_end = codegen::code_op_for_end();
    if op == for_end {
        try render_for_end(out, code, index);
    }
    let break_op = codegen::code_op_break();
    if op == break_op {
        try render_break(out, code, index);
    }
    let continue_op = codegen::code_op_continue();
    if op == continue_op {
        try render_continue(out, code, index);
    }
    return;
}

// render_var_decl stores a var local's init value into its alloca slot; the
// '%slot<id>' alloca is hoisted to the function entry by render_var_allocas.
fn render_var_decl(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let init_value = try code.get(index + 2);
    try w(out, "  store i64 %v");
    try wi(out, init_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_load reads a var local's alloca slot into a fresh SSA value.
fn render_var_load(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_store writes an SSA value back into a var local's alloca slot.
fn render_var_store(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store i64 %v");
    try wi(out, value_id);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_decl_slice / render_var_load_slice / render_var_store_slice mirror
// the i64 var slot trio for '%kizu.slice.u8' slots ('%sslot<id>').
fn render_var_decl_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let init_value = try code.get(index + 2);
    try w(out, "  store %kizu.slice.u8 %v");
    try wi(out, init_value);
    try w(out, ", ptr %sslot");
    try wi(out, slot);
    try nl(out);
    return;
}

fn render_var_load_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load %kizu.slice.u8, ptr %sslot");
    try wi(out, slot);
    try nl(out);
    return;
}

fn render_var_store_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store %kizu.slice.u8 %v");
    try wi(out, value_id);
    try w(out, ", ptr %sslot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_decl_bool / render_var_load_bool / render_var_store_bool mirror
// the var slot trios for i1 slots ('%bslot<id>').
fn render_var_decl_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let init_value = try code.get(index + 2);
    try w(out, "  store i1 %v");
    try wi(out, init_value);
    try w(out, ", ptr %bslot");
    try wi(out, slot);
    try nl(out);
    return;
}

fn render_var_load_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i1, ptr %bslot");
    try wi(out, slot);
    try nl(out);
    return;
}

fn render_var_store_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store i1 %v");
    try wi(out, value_id);
    try w(out, ", ptr %bslot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_while_begin closes the current block into the condition block and opens
// it; the condition expression records follow and produce the i1 WHILE_COND tests.
fn render_while_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %wcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wcond_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_while_cond branches on the lowered i1 condition into the loop body or
// past the loop, then opens the body block.
fn render_while_cond(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let cond = try code.get(index + 1);
    let begin = try code.get(index + 2);
    try w(out, "  br i1 %v");
    try wi(out, cond);
    try w(out, ", label %wbody_");
    try wi(out, begin);
    try w(out, ", label %wend_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wbody_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_while_end closes the body back to the condition block and opens the exit
// block break targets.
fn render_while_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %wcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wend_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_for_begin seeds the induction slot from the start value and opens the
// bounded condition block: it loads the slot and compares it against the end
// value, branching into the body or past the loop.
fn render_for_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let slot = try code.get(index + 2);
    let start_value = try code.get(index + 3);
    let end_value = try code.get(index + 4);
    let load_value = try code.get(index + 5);
    let cmp_value = try code.get(index + 6);
    try w(out, "  store i64 %v");
    try wi(out, start_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  br label %fcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fcond_");
    try wi(out, begin);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, load_value);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  %v");
    try wi(out, cmp_value);
    try w(out, " = icmp slt i64 %v");
    try wi(out, load_value);
    try w(out, ", %v");
    try wi(out, end_value);
    try nl(out);
    try w(out, "  br i1 %v");
    try wi(out, cmp_value);
    try w(out, ", label %fbody_");
    try wi(out, begin);
    try w(out, ", label %fend_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fbody_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_for_end emits the increment latch (the continue target) and opens the
// exit block (the break target): the body falls through to the latch, which loads
// the slot, adds one, stores it back, and branches to the condition block.
fn render_for_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let slot = try code.get(index + 2);
    let load_value = try code.get(index + 3);
    let add_value = try code.get(index + 4);
    try w(out, "  br label %flatch_");
    try wi(out, begin);
    try nl(out);
    try w(out, "flatch_");
    try wi(out, begin);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, load_value);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  %v");
    try wi(out, add_value);
    try w(out, " = add i64 %v");
    try wi(out, load_value);
    try wl(out, ", 1");
    try w(out, "  store i64 %v");
    try wi(out, add_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  br label %fcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fend_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_break branches to the enclosing loop's exit label and opens a fresh dead
// block so any records the lowering emitted after the break stay well-formed LLVM.
fn render_break(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let exit_prefix = loop_exit_label_prefix(kind);
    try w(out, "  br label %");
    try w(out, exit_prefix);
    try wi(out, begin);
    try nl(out);
    try render_dead_label(out, index);
    return;
}

// render_continue branches to the enclosing loop's continue label (the while
// condition block or the for latch) and opens a fresh dead block.
fn render_continue(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let cont_prefix = loop_continue_label_prefix(kind);
    try w(out, "  br label %");
    try w(out, cont_prefix);
    try wi(out, begin);
    try nl(out);
    try render_dead_label(out, index);
    return;
}

// render_dead_label opens a uniquely named block after a break/continue terminator
// so the records following it in the same statement list remain in a labeled block.
fn render_dead_label(
    out: &var std::string::String,
    index: i64
) -> !void {
    try w(out, "dead_");
    try wi(out, index);
    try wl(out, ":");
    return;
}

// loop_exit_label_prefix maps a loop kind to its break-target label prefix.
fn loop_exit_label_prefix(kind: i64) -> []u8 {
    let kind_for = codegen::code_loop_kind_for();
    if kind == kind_for {
        return "fend_";
    }
    return "wend_";
}

// loop_continue_label_prefix maps a loop kind to its continue-target label prefix
// (for loops continue at their increment latch, while loops at the condition).
fn loop_continue_label_prefix(kind: i64) -> []u8 {
    let kind_for = codegen::code_loop_kind_for();
    if kind == kind_for {
        return "flatch_";
    }
    return "wcond_";
}

// render_if_begin emits the conditional branch for an IF_BEGIN record: it tests the
// i1 condition value and branches to the then/else labels keyed by this record's
// own tape index, then opens the then label.
fn render_if_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let cond = try code.get(index + 1);
    try w(out, "  br i1 %v");
    try wi(out, cond);
    try w(out, ", label %then_");
    try wi(out, index);
    try w(out, ", label %else_");
    try wi(out, index);
    try nl(out);
    try w(out, "then_");
    try wi(out, index);
    try wl(out, ":");
    return;
}

// render_if_else closes the then block (branch to the end label) and opens the else
// label; the IF_ELSE record carries its IF_BEGIN tape index so the labels match.
fn render_if_else(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %end_");
    try wi(out, begin);
    try nl(out);
    try w(out, "else_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_if_end closes the else block (branch to the end label) and opens the end
// label; the IF_END record carries its IF_BEGIN tape index so the labels match.
fn render_if_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %end_");
    try wi(out, begin);
    try nl(out);
    try w(out, "end_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

fn render_const_int(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let literal = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = add i64 0, ");
    try wi(out, literal);
    try nl(out);
    return;
}

// render_const_bool materializes a bool literal as an i1 SSA value: the tape
// literal is 1 (true) or 0 (false), compared against zero.
fn render_const_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let literal = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = icmp ne i64 ");
    try wi(out, literal);
    try wl(out, ", 0");
    return;
}

// render_not emits the logical negation of an i1 operand ('xor i1 <op>, true').
fn render_not(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let operand = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = xor i1 %v");
    try wi(out, operand);
    try wl(out, ", true");
    return;
}

// render_sc_begin opens a short-circuit 'and'/'or': store the left i1 into the
// record's slot, then branch into the right-operand block only when the left does
// not already decide the result (an 'and' skips on false, an 'or' skips on true).
fn render_sc_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let lhs = try code.get(index + 2);
    let is_or = try code.get(index + 3);
    try w(out, "  store i1 %v");
    try wi(out, lhs);
    try w(out, ", ptr %sc");
    try wi(out, begin);
    try nl(out);
    try w(out, "  br i1 %v");
    try wi(out, lhs);
    if is_or == 1 {
        try render_sc_branch(out, begin, "scend_", "scrhs_");
    }
    if is_or != 1 {
        try render_sc_branch(out, begin, "scrhs_", "scend_");
    }
    try w(out, "scrhs_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_sc_branch writes the ', label %<a><begin>, label %<b><begin>' tail of the
// SC_BEGIN conditional branch.
fn render_sc_branch(
    out: &var std::string::String,
    begin: i64,
    true_prefix: []u8,
    false_prefix: []u8
) -> !void {
    try w(out, ", label %");
    try w(out, true_prefix);
    try wi(out, begin);
    try w(out, ", label %");
    try w(out, false_prefix);
    try wi(out, begin);
    try nl(out);
    return;
}

// render_sc_end closes a short-circuit 'and'/'or': store the right i1 into the
// slot, fall into the join block, and load the slot into the result value.
fn render_sc_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let rhs = try code.get(index + 2);
    let dst = try code.get(index + 3);
    try w(out, "  store i1 %v");
    try wi(out, rhs);
    try w(out, ", ptr %sc");
    try wi(out, begin);
    try nl(out);
    try w(out, "  br label %scend_");
    try wi(out, begin);
    try nl(out);
    try w(out, "scend_");
    try wi(out, begin);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i1, ptr %sc");
    try wi(out, begin);
    try nl(out);
    return;
}

// render_ret_value emits the value-return terminator for the surrounding ABI,
// then opens a fresh dead block (like break/continue do) so a return in a nested
// block leaves the structural records that follow it in a labeled block. The
// kizu_run_main entry discards its return value (a run process exits 0 on
// success, matching the reference compiler); an error-union-i64 function wraps
// the value into its ok union.
fn render_ret_value(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let value_id = try code.get(index + 1);
    let main_abi = ret_abi_main();
    let err_i64 = ret_abi_user_err_i64();
    if abi == main_abi {
        try wl(out, "  ret i64 0");
    }
    if abi == err_i64 {
        try render_ret_value_err_i64(out, index, value_id);
    }
    if abi != main_abi {
        if abi != err_i64 {
            try render_ret_value_plain(out, code, kinds, value_id);
        }
    }
    try render_dead_label(out, index);
    return;
}

// render_ret_value_plain emits the plain return terminator typed from the
// returned value's kind (i64 scalars, the union aggregate for union returns).
fn render_ret_value_plain(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    value_id: i64
) -> !void {
    let value_kind = try kinds.get(value_id);
    try w(out, "  ret ");
    try render_value_type(out, code, value_kind);
    try w(out, " %v");
    try wi(out, value_id);
    try nl(out);
    return;
}

// render_ret_value_err_i64 wraps an i64 return value into the ok
// '%kizu.error.i64' union through an index-suffixed temp.
fn render_ret_value_err_i64(
    out: &var std::string::String,
    index: i64,
    value_id: i64
) -> !void {
    try w(out, "  %rv");
    try wi(out, index);
    try w(out, " = insertvalue %kizu.error.i64 { i1 true, i64 0, %kizu.slice.u8 zeroinitializer }, i64 %v");
    try wi(out, value_id);
    try wl(out, ", 1");
    try w(out, "  ret %kizu.error.i64 %rv");
    try wi(out, index);
    try nl(out);
    return;
}

// render_ret_void emits the terminator for a 'return;' statement, then opens a
// fresh dead block. Plain scalar functions use their ABI default value, while an
// error-union-void function yields the ok union.
fn render_ret_void(out: &var std::string::String, index: i64, abi: i64) -> !void {
    let err_void = ret_abi_user_err_void();
    let bool_abi = ret_abi_user_bool();
    if abi == err_void {
        try render_ret_err_ok(out);
    }
    if abi == bool_abi {
        try wl(out, "  ret i1 false");
    }
    if abi != err_void {
        if abi != bool_abi {
            try wl(out, "  ret i64 0");
        }
    }
    try render_dead_label(out, index);
    return;
}

// render_ret_err_ok returns the success '%kizu.error.void' union (ok flag true,
// empty message slice) as an inline aggregate constant so no SSA temp is needed.
fn render_ret_err_ok(out: &var std::string::String) -> !void {
    try wl(out, "  ret %kizu.error.void { i1 true, %kizu.slice.u8 zeroinitializer }");
    return;
}

// render_ret_err_fail returns the failure '%kizu.error.void' union for a
// 'return error("msg")': the ok flag is false and the message slice points at the
// message string global the CONST_STR record emitted ('@.kizu.run.s<value_id>').
fn render_ret_err_fail(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let value_id = try code.get(index + 1);
    let main_abi = ret_abi_main();
    let err_i64 = ret_abi_user_err_i64();
    if abi == main_abi {
        try render_ret_err_fail_exit(out, index);
    }
    if abi == err_i64 {
        try render_ret_err_fail_i64(out, code, value_id);
    }
    if abi != main_abi {
        if abi != err_i64 {
            try render_ret_err_fail_void(out, code, value_id);
        }
    }
    try render_dead_label(out, index);
    return;
}

// render_ret_err_fail_exit maps a 'return error("msg")' in kizu_run_main to the
// process-exit-1 path.
fn render_ret_err_fail_exit(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %ef");
    try wi(out, index);
    try wl(out, "_exit = call i64 @kizu_rt_process_exit_code(i64 1)");
    try w(out, "  ret i64 %ef");
    try wi(out, index);
    try wl(out, "_exit");
    return;
}

fn render_ret_err_fail_void(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64
) -> !void {
    let byte_len = try tape_string_length(code, value_id, 0);
    try w(out, "  ret %kizu.error.void { i1 false, %kizu.slice.u8 { ptr @.kizu.run.s");
    try wi(out, value_id);
    try w(out, ", i64 ");
    try wi(out, byte_len);
    try wl(out, " } }");
    return;
}

fn render_ret_err_fail_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64
) -> !void {
    let byte_len = try tape_string_length(code, value_id, 0);
    try w(out, "  ret %kizu.error.i64 { i1 false, i64 0, %kizu.slice.u8 { ptr @.kizu.run.s");
    try wi(out, value_id);
    try w(out, ", i64 ");
    try wi(out, byte_len);
    try wl(out, " } }");
    return;
}

fn render_binary(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let left = try code.get(index + 3);
    let right = try code.get(index + 4);
    // A comparison kind (5..10) lowers to an i1 'icmp <pred>'; the arithmetic
    // kinds (including 11 = srem) lower to their i64 mnemonic. Both branches are
    // void then-bodies falling through to a single return (the shape the
    // compiled-MIR if-lowering models).
    let is_compare = kind >= 5 and kind <= 10;
    if is_compare {
        try render_binary_compare(out, dst, kind, left, right);
    }
    if !is_compare {
        try render_binary_arith(out, dst, kind, left, right);
    }
    return;
}

fn render_binary_arith(
    out: &var std::string::String,
    dst: i64,
    kind: i64,
    left: i64,
    right: i64
) -> !void {
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = ");
    let mnemonic = binary_op_mnemonic(kind);
    try w(out, mnemonic);
    try w(out, " i64 %v");
    try wi(out, left);
    try w(out, ", %v");
    try wi(out, right);
    try nl(out);
    return;
}

fn render_binary_compare(
    out: &var std::string::String,
    dst: i64,
    kind: i64,
    left: i64,
    right: i64
) -> !void {
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = icmp ");
    let predicate = binary_compare_predicate(kind);
    try w(out, predicate);
    try w(out, " i64 %v");
    try wi(out, left);
    try w(out, ", %v");
    try wi(out, right);
    try nl(out);
    return;
}

fn binary_op_mnemonic(kind: i64) -> []u8 {
    if kind == 1 {
        return "add";
    }
    if kind == 2 {
        return "sub";
    }
    if kind == 3 {
        return "mul";
    }
    if kind == 11 {
        return "srem";
    }
    return "sdiv";
}

// binary_compare_predicate maps a comparison binary kind (5..10) to its signed
// LLVM icmp predicate.
fn binary_compare_predicate(kind: i64) -> []u8 {
    if kind == 5 {
        return "eq";
    }
    if kind == 6 {
        return "ne";
    }
    if kind == 7 {
        return "slt";
    }
    if kind == 8 {
        return "sle";
    }
    if kind == 9 {
        return "sgt";
    }
    return "sge";
}

// render_call emits '%v<dst> = call i64 @kizu_run_user_<callee>(<type> %v<arg>, ...)'.
fn render_call(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let callee_start = try code.get(index + 2);
    let callee_end = try code.get(index + 3);
    let arg_count = try code.get(index + 4);
    let callee = text[callee_start..callee_end];
    let dst_kind = try kinds.get(dst);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call ");
    try render_value_type(out, code, dst_kind);
    try w(out, " @kizu_run_user_");
    try w(out, callee);
    try w(out, "(");
    try render_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    return;
}

fn render_method_call(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let type_start = try code.get(index + 2);
    let type_end = try code.get(index + 3);
    let name_start = try code.get(index + 4);
    let name_end = try code.get(index + 5);
    let arg_count = try code.get(index + 6);
    let type_name = text[type_start..type_end];
    let name = text[name_start..name_end];
    let dst_kind = try kinds.get(dst);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call ");
    try render_value_type(out, code, dst_kind);
    try w(out, " @kizu_run_user_");
    try render_method_symbol(out, type_name, name);
    try w(out, "(");
    try render_method_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    return;
}

// render_call_args emits the '<type> %v<arg>' operands read from the CALL record's
// trailing arg-id list (which begins at index + 5), typing each argument from its
// value kind.
fn render_call_args(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    arg_count: i64,
    arg_index: i64
) -> !void {
    if arg_index >= arg_count {
        return;
    }
    if arg_index > 0 {
        try w(out, ", ");
    }
    let arg_value = try code.get(index + 5 + arg_index);
    let arg_kind = try kinds.get(arg_value);
    try render_value_type(out, code, arg_kind);
    try w(out, " %v");
    try wi(out, arg_value);
    let after = arg_index + 1;
    try render_call_args(out, code, kinds, index, arg_count, after);
    return;
}

fn render_method_call_args(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    arg_count: i64,
    arg_index: i64
) -> !void {
    if arg_index >= arg_count {
        return;
    }
    if arg_index > 0 {
        try w(out, ", ");
    }
    let arg_value = try code.get(index + 7 + arg_index);
    let arg_kind = try kinds.get(arg_value);
    try render_value_type(out, code, arg_kind);
    try w(out, " %v");
    try wi(out, arg_value);
    let after = arg_index + 1;
    try render_method_call_args(out, code, kinds, index, arg_count, after);
    return;
}

// render_try_call emits a 'try <callee>()' of an error-union-void function: call
// the '%kizu.error.void' callee, extract its ok flag, and branch into a fail block
// that propagates the error or a cont block that resumes the body. SSA temps and
// labels are suffixed with the record's tape index so they stay unique.
fn render_try_call(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let callee_start = try code.get(index + 1);
    let callee_end = try code.get(index + 2);
    let arg_count = try code.get(index + 3);
    let callee = text[callee_start..callee_end];
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_run_user_");
    try w(out, callee);
    try w(out, "(");
    try render_try_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_propagate(out, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

// render_try_call_args emits the '<type> %v<arg>' operands read from the TRY_CALL
// record's trailing arg-id list (which begins at index + 4: TRY_CALL has no
// leading result value id), typing each argument from its value kind.
fn render_try_call_args(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    arg_count: i64,
    arg_index: i64
) -> !void {
    if arg_index >= arg_count {
        return;
    }
    if arg_index > 0 {
        try w(out, ", ");
    }
    let arg_value = try code.get(index + 4 + arg_index);
    let arg_kind = try kinds.get(arg_value);
    try render_value_type(out, code, arg_kind);
    try w(out, " %v");
    try wi(out, arg_value);
    let after = arg_index + 1;
    try render_try_call_args(out, code, kinds, index, arg_count, after);
    return;
}

// render_try_call_i64 emits a 'try <callee>(...)' of an error-union-i64 function:
// call the '%kizu.error.i64' callee, extract its ok flag, and branch into a fail
// block that propagates the error by the surrounding ABI or a cont block that
// extracts the i64 success value into the result. SSA temps and labels are
// suffixed with the record's tape index so they stay unique.
fn render_try_call_i64(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let callee_start = try code.get(index + 2);
    let callee_end = try code.get(index + 3);
    let arg_count = try code.get(index + 4);
    let callee = text[callee_start..callee_end];
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.i64 @kizu_run_user_");
    try w(out, callee);
    try w(out, "(");
    try render_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_i64_propagate(out, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 1");
    return;
}

// render_try_i64_propagate emits the fail-block terminator for a try over an
// error-union-i64 callee: kizu_run_main exits 1, an error-union-void function
// re-wraps the message into its own union, and an error-union-i64 function
// propagates a fresh failed union carrying the message.
fn render_try_i64_propagate(out: &var std::string::String, index: i64, abi: i64) -> !void {
    let main_abi = ret_abi_main();
    let err_i64 = ret_abi_user_err_i64();
    if abi == main_abi {
        try render_try_propagate_exit(out, index);
    }
    if abi == err_i64 {
        try render_try_i64_propagate_err_i64(out, index);
    }
    if abi != main_abi {
        if abi != err_i64 {
            try render_try_i64_propagate_err_void(out, index);
        }
    }
    return;
}

// render_try_i64_propagate_err_i64 forwards a failed error-union-i64 try as the
// surrounding error-union-i64 function's own failed union.
fn render_try_i64_propagate_err_i64(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.i64 { i1 false, i64 0, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_pm, 2");
    try w(out, "  ret %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, "_pv");
    return;
}

// render_try_i64_propagate_err_void re-wraps a failed error-union-i64 try into the
// surrounding error-union-void function's own union.
fn render_try_i64_propagate_err_void(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.void { i1 false, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_pm, 1");
    try w(out, "  ret %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, "_pv");
    return;
}

// render_expect branches on the lowered i1 expectation: the fail block traps the
// process with the runtime expectation message (stderr + exit 1, noreturn), and
// the cont block resumes the body. Labels are suffixed with the record's tape
// index so they stay unique.
fn render_expect(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let cond = try code.get(index + 1);
    let message_len = std::mem::len(expect_fail_message());
    let payload_len = message_len + 1;
    try w(out, "  br i1 %v");
    try wi(out, cond);
    try w(out, ", label %ex");
    try wi(out, index);
    try w(out, "_cont, label %ex");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "ex");
    try wi(out, index);
    try wl(out, "_fail:");
    try w(out, "  %ex");
    try wi(out, index);
    try wl(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.expect_fail, 0");
    try w(out, "  %ex");
    try wi(out, index);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %ex");
    try wi(out, index);
    try w(out, "_base, i64 ");
    try wi(out, payload_len);
    try wl(out, ", 1");
    try w(out, "  call void @kizu_rt_trap(%kizu.slice.u8 %ex");
    try wi(out, index);
    try wl(out, "_slice)");
    try wl(out, "  unreachable");
    try w(out, "ex");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

// render_try_propagate emits the fail-block terminator for a try: the kizu_run_main
// entry exits the process with code 1, every other (error-union-void) function
// returns the propagated error union.
fn render_try_propagate(out: &var std::string::String, index: i64, abi: i64) -> !void {
    let main_abi = ret_abi_main();
    if abi == main_abi {
        try render_try_propagate_exit(out, index);
    }
    if abi != main_abi {
        try render_try_propagate_error(out, index, abi);
    }
    return;
}

fn render_try_propagate_exit(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try wl(out, "_exit = call i64 @kizu_rt_process_exit_code(i64 1)");
    try w(out, "  ret i64 %tc");
    try wi(out, index);
    try wl(out, "_exit");
    return;
}

fn render_try_propagate_error(out: &var std::string::String, index: i64, abi: i64) -> !void {
    let err_i64 = ret_abi_user_err_i64();
    if abi == err_i64 {
        try render_try_propagate_error_i64(out, index);
    }
    if abi != err_i64 {
        try render_try_propagate_error_void(out, index);
    }
    return;
}

// render_try_propagate_error_i64 re-wraps a failed '%kizu.error.void' try into the
// surrounding error-union-i64 function's own union.
fn render_try_propagate_error_i64(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_emsg = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 1");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_eu = insertvalue %kizu.error.i64 { i1 false, i64 0, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_emsg, 2");
    try w(out, "  ret %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, "_eu");
    return;
}

fn render_try_propagate_error_void(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  ret %kizu.error.void %tc");
    try wi(out, index);
    try nl(out);
    return;
}

// render_io_blocking emits 'std::io::blocking()': a runtime io handle into the
// result value (a '%kizu.owned' SSA value).
fn render_io_blocking(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    try w(out, "  %v");
    try wi(out, dst);
    try wl(out, " = call %kizu.owned @kizu_rt_io_blocking()");
    return;
}

fn render_page_allocator(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    try w(out, "  %v");
    try wi(out, dst);
    try wl(out, " = call %kizu.owned @kizu_rt_mem_page_allocator()");
    return;
}

fn render_string_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let allocator = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.owned @kizu_rt_string_new(%kizu.owned %v");
    try wi(out, allocator);
    try wl(out, ")");
    return;
}

fn render_string_as_bytes(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let text_value = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %v");
    try wi(out, text_value);
    try wl(out, ")");
    return;
}

fn render_mem_equal_bytes(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let left = try code.get(index + 2);
    let right = try code.get(index + 3);
    try w(out, "  %eb");
    try wi(out, index);
    try wl(out, "_i = alloca i64");
    try w(out, "  %eb");
    try wi(out, index);
    try wl(out, "_result = alloca i1");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_left_ptr = extractvalue %kizu.slice.u8 %v");
    try wi(out, left);
    try wl(out, ", 0");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_left_len = extractvalue %kizu.slice.u8 %v");
    try wi(out, left);
    try wl(out, ", 1");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_right_ptr = extractvalue %kizu.slice.u8 %v");
    try wi(out, right);
    try wl(out, ", 0");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_right_len = extractvalue %kizu.slice.u8 %v");
    try wi(out, right);
    try wl(out, ", 1");
    try w(out, "  store i64 0, ptr %eb");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  store i1 false, ptr %eb");
    try wi(out, index);
    try wl(out, "_result");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_len_eq = icmp eq i64 %eb");
    try wi(out, index);
    try w(out, "_left_len, %eb");
    try wi(out, index);
    try wl(out, "_right_len");
    try w(out, "  br i1 %eb");
    try wi(out, index);
    try w(out, "_len_eq, label %ebcheck_");
    try wi(out, index);
    try w(out, ", label %ebdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebcheck_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_index = load i64, ptr %eb");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_at_end = icmp sge i64 %eb");
    try wi(out, index);
    try w(out, "_index, %eb");
    try wi(out, index);
    try wl(out, "_left_len");
    try w(out, "  br i1 %eb");
    try wi(out, index);
    try w(out, "_at_end, label %ebsuccess_");
    try wi(out, index);
    try w(out, ", label %ebcompare_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebcompare_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_left_byte_ptr = getelementptr i8, ptr %eb");
    try wi(out, index);
    try w(out, "_left_ptr, i64 %eb");
    try wi(out, index);
    try wl(out, "_index");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_right_byte_ptr = getelementptr i8, ptr %eb");
    try wi(out, index);
    try w(out, "_right_ptr, i64 %eb");
    try wi(out, index);
    try wl(out, "_index");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_left_byte = load i8, ptr %eb");
    try wi(out, index);
    try wl(out, "_left_byte_ptr");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_right_byte = load i8, ptr %eb");
    try wi(out, index);
    try wl(out, "_right_byte_ptr");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_byte_eq = icmp eq i8 %eb");
    try wi(out, index);
    try w(out, "_left_byte, %eb");
    try wi(out, index);
    try wl(out, "_right_byte");
    try w(out, "  br i1 %eb");
    try wi(out, index);
    try w(out, "_byte_eq, label %ebnext_");
    try wi(out, index);
    try w(out, ", label %ebdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebnext_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_next = add i64 %eb");
    try wi(out, index);
    try wl(out, "_index, 1");
    try w(out, "  store i64 %eb");
    try wi(out, index);
    try w(out, "_next, ptr %eb");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  br label %ebcheck_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebsuccess_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  store i1 true, ptr %eb");
    try wi(out, index);
    try wl(out, "_result");
    try w(out, "  br label %ebdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebdone_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i1, ptr %eb");
    try wi(out, index);
    try wl(out, "_result");
    return;
}

fn render_try_string_append_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
