import selfhost::ir::codegen;

// Run codegen IR v1 renderer: walk the flat function-block-instruction tape
// (the Array<i64> records lower_code_module emits, with the run source text for
// string/name spans) and produce the run artifact LLVM module text.
//
// The renderer is the generic counterpart of the old per-shape hosted renderers:
// it iterates the tape opcodes instead of matching a fixed Program shape. Every
// value id names an SSA temp '%v<id>'; CONST_STR payloads become module globals
// '@.kizu.run.s<id>'; PRINT dispatches on the recorded value kind to the string
// or i64 writer.
//
// The cluster is written to compile into stage2 through the generic compiled-MIR
// subset: opcode constants are bound to locals before they are compared (no call
// in a condition), control flow uses early-return guards and tail recursion (no
// loop-carried scalars), and i64 formatting uses the local recursive wi helper
// rather than the std::fmt String builder. Kizu string literals do not interpret
// backslash escapes, so every emitted line is written through wl (bytes then a
// real newline byte) and partial fragments through w; quote/newline bytes are
// appended as explicit byte values.

pub fn render_tape_module(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>
) -> !std::string::String {
    var out = std::string::String(allocator);
    try render_preamble(&var out, source_path);
    try render_string_globals(&var out, text, code, 0);
    try render_functions(&var out, text, code, kinds, 0);
    try render_main_wrapper(&var out);
    return out;
}

// render_run_artifact is the generic run pipeline entry: it lowers a parsed run
// source into the run codegen IR v1 tape (codegen::lower_code_module) and renders
// that tape to the executable LLVM module text. It replaces the per-shape hosted
// renderers -- a single tape walk handles any program the lowering accepts.
pub fn render_run_artifact(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    parsed: std::kizu::ast::ParseResult
) -> !std::string::String {
    var code = std::array::Array<i64>(allocator);
    var kinds = std::array::Array<i64>(allocator);
    var local_starts = std::array::Array<i64>(allocator);
    var local_ends = std::array::Array<i64>(allocator);
    var local_values = std::array::Array<i64>(allocator);
    var args_scratch = std::array::Array<i64>(allocator);
    let eval = try codegen::lower_code_module(
        text,
        parsed.ast,
        parsed.root,
        &var code,
        &var kinds,
        &var local_starts,
        &var local_ends,
        &var local_values,
        &var args_scratch
    );
    if !eval.ok {
        return error("render run artifact: run source lowering not supported");
    }
    return try render_tape_module(allocator, source_path, text, &code, &kinds);
}

// w appends a fragment with no trailing newline.
fn w(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    return;
}

// wl appends a full line plus a real newline byte.
fn wl(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}

// nl appends a single newline byte.
fn nl(out: &var std::string::String) -> !void {
    try out.append_byte(cast<u8>(10));
    return;
}

// wi appends a non-negative i64 as decimal digits. The renderer only emits
// non-negative ids/spans/literals, so a most-significant-first recursive digit
// walk (each frame appends one digit byte) avoids the std::fmt String builder,
// which is outside the compiled-MIR subset this cluster lowers through.
fn wi(out: &var std::string::String, value: i64) -> !void {
    // Emit the high-order digits first by recursing on value/10 when there is a
    // carry, then append this frame's least-significant digit. Written without an
    // early return so the body stays a single fall-through path the compiled-MIR
    // void then-body lowering models (the renderer compiles into stage2).
    if value >= 10 {
        let high = value / 10;
        try wi(out, high);
    }
    let tens = value / 10;
    let digit = value - tens * 10;
    let digit_byte = cast<u8>(48 + digit);
    try out.append_byte(digit_byte);
    return;
}

fn render_preamble(out: &var std::string::String, source_path: []u8) -> !void {
    try wl(out, "; kizu codegen run artifact ll v1");
    try w(out, "source_filename = ");
    try out.append_byte(cast<u8>(34));
    try w(out, source_path);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    try nl(out);
    try wl(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try wl(out, "%kizu.owned = type { ptr }");
    try wl(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try wl(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try nl(out);
    try wl(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try wl(out, "declare ptr @kizu_rt_alloc(ptr, i64)");
    try wl(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try wl(out, "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try wl(out, "declare void @kizu_host_init(i32, ptr)");
    try nl(out);
    try wl(out, "@.kizu.run.newline = private unnamed_addr constant [1 x i8] [i8 10]");
    try nl(out);
    try render_i64_decimal_helper(out);
    return;
}

// render_i64_decimal_helper emits @kizu_run_i64_decimal: format an i64 into a
// page-allocated 20-byte buffer and return the trimmed decimal slice. It backs the
// PRINT path for i64 values.
fn render_i64_decimal_helper(out: &var std::string::String) -> !void {
    try wl(out, "define %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try wl(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try wl(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 20)");
    try wl(out, "  %allocated = icmp ne ptr %buffer, null");
    try wl(out, "  br i1 %allocated, label %check_zero, label %alloc_failed");
    try wl(out, "check_zero:");
    try wl(out, "  %is_zero = icmp eq i64 %value, 0");
    try wl(out, "  br i1 %is_zero, label %zero, label %loop");
    try wl(out, "zero:");
    try wl(out, "  %zero_ptr = getelementptr i8, ptr %buffer, i64 19");
    try wl(out, "  store i8 48, ptr %zero_ptr");
    try wl(out, "  br label %finish_zero");
    try wl(out, "loop:");
    try wl(out, "  %current = phi i64 [ %value, %check_zero ], [ %quotient, %loop ]");
    try wl(out, "  %write_index = phi i64 [ 19, %check_zero ], [ %next_index, %loop ]");
    try wl(out, "  %digit = srem i64 %current, 10");
    try wl(out, "  %digit_byte_i64 = add i64 %digit, 48");
    try wl(out, "  %digit_byte = trunc i64 %digit_byte_i64 to i8");
    try wl(out, "  %digit_ptr = getelementptr i8, ptr %buffer, i64 %write_index");
    try wl(out, "  store i8 %digit_byte, ptr %digit_ptr");
    try wl(out, "  %quotient = sdiv i64 %current, 10");
    try wl(out, "  %next_index = sub i64 %write_index, 1");
    try wl(out, "  %done = icmp eq i64 %quotient, 0");
    try wl(out, "  br i1 %done, label %finish_loop, label %loop");
    try wl(out, "finish_zero:");
    try wl(out, "  br label %success");
    try wl(out, "finish_loop:");
    try wl(out, "  br label %success");
    try wl(out, "success:");
    try wl(out, "  %start = phi i64 [ 19, %finish_zero ], [ %write_index, %finish_loop ]");
    try wl(out, "  %len = sub i64 20, %start");
    try wl(out, "  %start_ptr = getelementptr i8, ptr %buffer, i64 %start");
    try wl(out, "  %slice_base = insertvalue %kizu.slice.u8 poison, ptr %start_ptr, 0");
    try wl(out, "  %slice = insertvalue %kizu.slice.u8 %slice_base, i64 %len, 1");
    try wl(out, "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try wl(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %slice, 1");
    try wl(out, "  ret %kizu.error.slice.u8 %result");
    try wl(out, "alloc_failed:");
    try wl(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try wl(out, "}");
    try nl(out);
    return;
}

// render_string_globals walks the tape and emits a private constant for every
// CONST_STR record's payload span, named '@.kizu.run.s<dst>'.
fn render_string_globals(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    if index >= code.len() {
        return;
    }
    let op = try code.get(index);
    let const_str = codegen::code_op_const_str();
    let next = try tape_record_end(code, index);
    if op == const_str {
        try render_one_string_global(out, text, code, index);
    }
    try render_string_globals(out, text, code, next);
    return;
}

fn render_one_string_global(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let payload_start = try code.get(index + 2);
    let payload_end = try code.get(index + 3);
    let payload = text[payload_start..payload_end];
    let byte_len = payload_end - payload_start;
    try w(out, "@.kizu.run.s");
    try wi(out, dst);
    try w(out, " = private unnamed_addr constant [");
    try wi(out, byte_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try render_llvm_c_bytes(out, payload);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

// render_functions walks the tape function by function: each FUNC_BEGIN..FUNC_END
// span renders one LLVM define ('main' is the kizu_run_main entry, every other
// function a kizu_run_user_<name> i64 define), then the walk resumes past FUNC_END.
fn render_functions(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !void {
    if index >= code.len() {
        return;
    }
    let after = try render_function_or_skip(out, text, code, kinds, index);
    try render_functions(out, text, code, kinds, after);
    return;
}

// render_function_or_skip renders the function whose FUNC_BEGIN is at index (or
// skips a stray non-function record) and returns the next tape index to walk from.
fn render_function_or_skip(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !i64 {
    let op = try code.get(index);
    let func_begin = codegen::code_op_func_begin();
    if op != func_begin {
        return try tape_record_end(code, index);
    }
    return try render_one_function(out, text, code, kinds, index);
}

// render_one_function renders the function whose FUNC_BEGIN is at func_index and
// returns the tape index past its FUNC_END.
fn render_one_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    func_index: i64
) -> !i64 {
    let name_start = try code.get(func_index + 1);
    let name_end = try code.get(func_index + 2);
    let param_count = try code.get(func_index + 3);
    let param_base = try code.get(func_index + 5);
    let name = text[name_start..name_end];
    let body_start = func_index + 6;
    let func_end = try tape_function_end(code, body_start);
    // Each renderer returns the tape index past its FUNC_END so this stays a pair of
    // single-statement early-return guards (the shape the compiled-MIR if-lowering
    // models), keeping render_one_function free of a multi-statement then-body.
    if std::mem::equal_bytes(name, "main") {
        return try render_main_function(out, text, code, kinds, body_start, func_end);
    }
    return try render_user_function(out, text, code, kinds, name, param_base, param_count, body_start, func_end);
}

fn render_main_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    body_start: i64,
    func_end: i64
) -> !i64 {
    try wl(out, "define i64 @kizu_run_main() {");
    try wl(out, "entry:");
    try wl(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try render_var_allocas(out, code, body_start, func_end);
    try render_body(out, text, code, kinds, body_start, func_end);
    try wl(out, "  %exit_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try wl(out, "  ret i64 %exit_code");
    try wl(out, "}");
    try nl(out);
    return func_end + 1;
}

fn render_user_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    name: []u8,
    param_base: i64,
    param_count: i64,
    body_start: i64,
    func_end: i64
) -> !i64 {
    try w(out, "define i64 @kizu_run_user_");
    try w(out, name);
    try w(out, "(");
    try render_param_list(out, param_base, param_count, 0);
    try wl(out, ") {");
    try wl(out, "entry:");
    // A user function that prints needs the io handle the print writers reference;
    // bind it at entry only when the body actually contains a PRINT record.
    let prints = try body_has_print(code, body_start, func_end);
    if prints {
        try wl(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    }
    try render_var_allocas(out, code, body_start, func_end);
    try render_body(out, text, code, kinds, body_start, func_end);
    try wl(out, "}");
    try nl(out);
    return func_end + 1;
}

// render_param_list emits 'i64 %v<param_base+i>' separated by commas.
fn render_param_list(
    out: &var std::string::String,
    param_base: i64,
    param_count: i64,
    index: i64
) -> !void {
    if index >= param_count {
        return;
    }
    if index > 0 {
        try w(out, ", ");
    }
    try w(out, "i64 %v");
    // Bind the slot id so the wi() call takes a local rather than a 'base + index'
    // binary arg (the call-arg lowering only models 'base + <int literal>').
    let slot = param_base + index;
    try wi(out, slot);
    let after = index + 1;
    try render_param_list(out, param_base, param_count, after);
    return;
}

// tape_function_end returns the index of the FUNC_END record closing the function
// whose body begins at index.
fn tape_function_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    // Bind the tape length once so the bounds guard returns a local rather than a
    // 'return code.len();' the compiled-MIR if-then early-return path would treat as
    // a free-function call.
    let total = code.len();
    if index >= total {
        return total;
    }
    let op = try code.get(index);
    let func_end = codegen::code_op_func_end();
    if op == func_end {
        return index;
    }
    let next = try tape_record_end(code, index);
    return try tape_function_end(code, next);
}

// body_has_print reports whether the records in [index, func_end) include a PRINT.
fn body_has_print(
    code: &std::array::Array<i64>,
    index: i64,
    func_end: i64
) -> !bool {
    if index >= func_end {
        return false;
    }
    let op = try code.get(index);
    let print_op = codegen::code_op_print();
    if op == print_op {
        return true;
    }
    let next = try tape_record_end(code, index);
    return try body_has_print(code, next, func_end);
}

// render_var_allocas hoists one 'alloca i64' to the function entry for every var
// slot the body declares: a VAR_DECL slot (a 'var' local) or a FOR_BEGIN slot (a
// for-loop induction var). Hoisting all slots to entry keeps every VAR_LOAD/STORE
// and the for latch dominated by the alloca regardless of loop nesting.
fn render_var_allocas(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    func_end: i64
) -> !void {
    if index >= func_end {
        return;
    }
    let op = try code.get(index);
    let var_decl = codegen::code_op_var_decl();
    if op == var_decl {
        let decl_slot = try code.get(index + 1);
        try render_one_alloca(out, decl_slot);
    }
    let for_begin = codegen::code_op_for_begin();
    if op == for_begin {
        let for_slot = try code.get(index + 2);
        try render_one_alloca(out, for_slot);
    }
    let next = try tape_record_end(code, index);
    try render_var_allocas(out, code, next, func_end);
    return;
}

// render_one_alloca emits '%slot<id> = alloca i64' for one var slot.
fn render_one_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %slot");
    try wi(out, slot);
    try wl(out, " = alloca i64");
    return;
}

// render_body renders the records in [index, func_end) of one function body.
fn render_body(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    func_end: i64
) -> !void {
    if index >= func_end {
        return;
    }
    let next = try tape_record_end(code, index);
    try render_one_instruction(out, text, code, kinds, index);
    try render_body(out, text, code, kinds, next, func_end);
    return;
}

fn render_one_instruction(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !void {
    // The opcodes are mutually exclusive, so each writer runs under its own void
    // then-body guard and the function falls through to a single return -- the shape
    // both the Go reference compiler and the compiled-MIR void if-lowering accept (a
    // 'return try <void call>;' identity tail is rejected by the former).
    let op = try code.get(index);
    let const_int = codegen::code_op_const_int();
    if op == const_int {
        try render_const_int(out, code, index);
    }
    let binary = codegen::code_op_binary();
    if op == binary {
        try render_binary(out, code, index);
    }
    let print_op = codegen::code_op_print();
    if op == print_op {
        try render_print(out, code, index);
    }
    let call = codegen::code_op_call();
    if op == call {
        try render_call(out, text, code, index);
    }
    let ret_value = codegen::code_op_ret_value();
    if op == ret_value {
        try render_ret_value(out, code, index);
    }
    let if_begin = codegen::code_op_if_begin();
    if op == if_begin {
        try render_if_begin(out, code, index);
    }
    let if_else = codegen::code_op_if_else();
    if op == if_else {
        try render_if_else(out, code, index);
    }
    let if_end = codegen::code_op_if_end();
    if op == if_end {
        try render_if_end(out, code, index);
    }
    let var_decl = codegen::code_op_var_decl();
    if op == var_decl {
        try render_var_decl(out, code, index);
    }
    let var_load = codegen::code_op_var_load();
    if op == var_load {
        try render_var_load(out, code, index);
    }
    let var_store = codegen::code_op_var_store();
    if op == var_store {
        try render_var_store(out, code, index);
    }
    let while_begin = codegen::code_op_while_begin();
    if op == while_begin {
        try render_while_begin(out, code, index);
    }
    let while_cond = codegen::code_op_while_cond();
    if op == while_cond {
        try render_while_cond(out, code, index);
    }
    let while_end = codegen::code_op_while_end();
    if op == while_end {
        try render_while_end(out, code, index);
    }
    let for_begin = codegen::code_op_for_begin();
    if op == for_begin {
        try render_for_begin(out, code, index);
    }
    let for_end = codegen::code_op_for_end();
    if op == for_end {
        try render_for_end(out, code, index);
    }
    let break_op = codegen::code_op_break();
    if op == break_op {
        try render_break(out, code, index);
    }
    let continue_op = codegen::code_op_continue();
    if op == continue_op {
        try render_continue(out, code, index);
    }
    return;
}

// render_var_decl stores a var local's init value into its alloca slot; the
// '%slot<id>' alloca is hoisted to the function entry by render_var_allocas.
fn render_var_decl(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let init_value = try code.get(index + 2);
    try w(out, "  store i64 %v");
    try wi(out, init_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_load reads a var local's alloca slot into a fresh SSA value.
fn render_var_load(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_store writes an SSA value back into a var local's alloca slot.
fn render_var_store(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store i64 %v");
    try wi(out, value_id);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_while_begin closes the current block into the condition block and opens
// it; the condition expression records follow and produce the i1 WHILE_COND tests.
fn render_while_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %wcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wcond_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_while_cond branches on the lowered i1 condition into the loop body or
// past the loop, then opens the body block.
fn render_while_cond(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let cond = try code.get(index + 1);
    let begin = try code.get(index + 2);
    try w(out, "  br i1 %v");
    try wi(out, cond);
    try w(out, ", label %wbody_");
    try wi(out, begin);
    try w(out, ", label %wend_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wbody_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_while_end closes the body back to the condition block and opens the exit
// block break targets.
fn render_while_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %wcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wend_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_for_begin seeds the induction slot from the start value and opens the
// bounded condition block: it loads the slot and compares it against the end
// value, branching into the body or past the loop.
fn render_for_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let slot = try code.get(index + 2);
    let start_value = try code.get(index + 3);
    let end_value = try code.get(index + 4);
    let load_value = try code.get(index + 5);
    let cmp_value = try code.get(index + 6);
    try w(out, "  store i64 %v");
    try wi(out, start_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  br label %fcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fcond_");
    try wi(out, begin);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, load_value);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  %v");
    try wi(out, cmp_value);
    try w(out, " = icmp slt i64 %v");
    try wi(out, load_value);
    try w(out, ", %v");
    try wi(out, end_value);
    try nl(out);
    try w(out, "  br i1 %v");
    try wi(out, cmp_value);
    try w(out, ", label %fbody_");
    try wi(out, begin);
    try w(out, ", label %fend_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fbody_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_for_end emits the increment latch (the continue target) and opens the
// exit block (the break target): the body falls through to the latch, which loads
// the slot, adds one, stores it back, and branches to the condition block.
fn render_for_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let slot = try code.get(index + 2);
    let load_value = try code.get(index + 3);
    let add_value = try code.get(index + 4);
    try w(out, "  br label %flatch_");
    try wi(out, begin);
    try nl(out);
    try w(out, "flatch_");
    try wi(out, begin);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, load_value);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  %v");
    try wi(out, add_value);
    try w(out, " = add i64 %v");
    try wi(out, load_value);
    try wl(out, ", 1");
    try w(out, "  store i64 %v");
    try wi(out, add_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  br label %fcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fend_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_break branches to the enclosing loop's exit label and opens a fresh dead
// block so any records the lowering emitted after the break stay well-formed LLVM.
fn render_break(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let exit_prefix = loop_exit_label_prefix(kind);
    try w(out, "  br label %");
    try w(out, exit_prefix);
    try wi(out, begin);
    try nl(out);
    try render_dead_label(out, index);
    return;
}

// render_continue branches to the enclosing loop's continue label (the while
// condition block or the for latch) and opens a fresh dead block.
fn render_continue(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let cont_prefix = loop_continue_label_prefix(kind);
    try w(out, "  br label %");
    try w(out, cont_prefix);
    try wi(out, begin);
    try nl(out);
    try render_dead_label(out, index);
    return;
}

// render_dead_label opens a uniquely named block after a break/continue terminator
// so the records following it in the same statement list remain in a labeled block.
fn render_dead_label(
    out: &var std::string::String,
    index: i64
) -> !void {
    try w(out, "dead_");
    try wi(out, index);
    try wl(out, ":");
    return;
}

// loop_exit_label_prefix maps a loop kind to its break-target label prefix.
fn loop_exit_label_prefix(kind: i64) -> []u8 {
    let kind_for = codegen::code_loop_kind_for();
    if kind == kind_for {
        return "fend_";
    }
    return "wend_";
}

// loop_continue_label_prefix maps a loop kind to its continue-target label prefix
// (for loops continue at their increment latch, while loops at the condition).
fn loop_continue_label_prefix(kind: i64) -> []u8 {
    let kind_for = codegen::code_loop_kind_for();
    if kind == kind_for {
        return "flatch_";
    }
    return "wcond_";
}

// render_if_begin emits the conditional branch for an IF_BEGIN record: it tests the
// i1 condition value and branches to the then/else labels keyed by this record's
// own tape index, then opens the then label.
fn render_if_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let cond = try code.get(index + 1);
    try w(out, "  br i1 %v");
    try wi(out, cond);
    try w(out, ", label %then_");
    try wi(out, index);
    try w(out, ", label %else_");
    try wi(out, index);
    try nl(out);
    try w(out, "then_");
    try wi(out, index);
    try wl(out, ":");
    return;
}

// render_if_else closes the then block (branch to the end label) and opens the else
// label; the IF_ELSE record carries its IF_BEGIN tape index so the labels match.
fn render_if_else(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %end_");
    try wi(out, begin);
    try nl(out);
    try w(out, "else_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_if_end closes the else block (branch to the end label) and opens the end
// label; the IF_END record carries its IF_BEGIN tape index so the labels match.
fn render_if_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %end_");
    try wi(out, begin);
    try nl(out);
    try w(out, "end_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

fn render_const_int(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let literal = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = add i64 0, ");
    try wi(out, literal);
    try nl(out);
    return;
}

fn render_ret_value(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let value_id = try code.get(index + 1);
    try w(out, "  ret i64 %v");
    try wi(out, value_id);
    try nl(out);
    return;
}

fn render_binary(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let left = try code.get(index + 3);
    let right = try code.get(index + 4);
    // A comparison kind lowers to an i1 'icmp <pred>'; the arithmetic kinds lower
    // to their i64 mnemonic. Both branches are void then-bodies falling through to
    // a single return (the shape the compiled-MIR if-lowering models).
    let is_compare = kind >= 5;
    if is_compare {
        try render_binary_compare(out, dst, kind, left, right);
    }
    if !is_compare {
        try render_binary_arith(out, dst, kind, left, right);
    }
    return;
}

fn render_binary_arith(
    out: &var std::string::String,
    dst: i64,
    kind: i64,
    left: i64,
    right: i64
) -> !void {
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = ");
    let mnemonic = binary_op_mnemonic(kind);
    try w(out, mnemonic);
    try w(out, " i64 %v");
    try wi(out, left);
    try w(out, ", %v");
    try wi(out, right);
    try nl(out);
    return;
}

fn render_binary_compare(
    out: &var std::string::String,
    dst: i64,
    kind: i64,
    left: i64,
    right: i64
) -> !void {
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = icmp ");
    let predicate = binary_compare_predicate(kind);
    try w(out, predicate);
    try w(out, " i64 %v");
    try wi(out, left);
    try w(out, ", %v");
    try wi(out, right);
    try nl(out);
    return;
}

fn binary_op_mnemonic(kind: i64) -> []u8 {
    if kind == 1 {
        return "add";
    }
    if kind == 2 {
        return "sub";
    }
    if kind == 3 {
        return "mul";
    }
    return "sdiv";
}

// binary_compare_predicate maps a comparison binary kind (5..10) to its signed
// LLVM icmp predicate.
fn binary_compare_predicate(kind: i64) -> []u8 {
    if kind == 5 {
        return "eq";
    }
    if kind == 6 {
        return "ne";
    }
    if kind == 7 {
        return "slt";
    }
    if kind == 8 {
        return "sle";
    }
    if kind == 9 {
        return "sgt";
    }
    return "sge";
}

// render_call emits '%v<dst> = call i64 @kizu_run_user_<callee>(i64 %v<arg>, ...)'.
fn render_call(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let callee_start = try code.get(index + 2);
    let callee_end = try code.get(index + 3);
    let arg_count = try code.get(index + 4);
    let callee = text[callee_start..callee_end];
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call i64 @kizu_run_user_");
    try w(out, callee);
    try w(out, "(");
    try render_call_args(out, code, index, arg_count, 0);
    try wl(out, ")");
    return;
}

// render_call_args emits the 'i64 %v<arg>' operands read from the CALL record's
// trailing arg-id list (which begins at index + 5).
fn render_call_args(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    arg_count: i64,
    arg_index: i64
) -> !void {
    if arg_index >= arg_count {
        return;
    }
    if arg_index > 0 {
        try w(out, ", ");
    }
    let arg_value = try code.get(index + 5 + arg_index);
    try w(out, "i64 %v");
    try wi(out, arg_value);
    let after = arg_index + 1;
    try render_call_args(out, code, index, arg_count, after);
    return;
}

// render_print emits the write for a print(<value>) record then the trailing
// newline print() appends: a string value writes its global slice straight to
// stdout; an i64 value formats through the decimal helper first.
fn render_print(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let value_id = try code.get(index + 1);
    let value_kind = try code.get(index + 2);
    let kind_str = codegen::code_kind_str();
    // Dispatch on the recorded value kind through mutually exclusive void then-body
    // guards (each leaf writer also emits the trailing newline) and fall through to a
    // single return -- the shape both the Go reference compiler and the compiled-MIR
    // void if-lowering accept.
    let is_string = value_kind == kind_str;
    if is_string {
        try render_print_string_line(out, code, value_id);
    }
    if !is_string {
        try render_print_i64_line(out, value_id);
    }
    return;
}

// render_print_string_line writes a string print value (its global slice) followed
// by the trailing newline print() appends.
fn render_print_string_line(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64
) -> !void {
    let byte_len = try tape_string_length(code, value_id, 0);
    try render_print_string(out, value_id, byte_len);
    try render_print_newline(out, value_id);
    return;
}

// render_print_i64_line formats an i64 print value through the decimal helper then
// writes the trailing newline.
fn render_print_i64_line(out: &var std::string::String, value_id: i64) -> !void {
    try render_print_i64(out, value_id);
    try render_print_newline(out, value_id);
    return;
}

// tape_string_length scans the tape for the CONST_STR record whose dst is value_id
// and returns its payload byte length, so the print slice carries the exact length.
fn tape_string_length(
    code: &std::array::Array<i64>,
    value_id: i64,
    index: i64
) -> !i64 {
    if index >= code.len() {
        return error("render: print string value has no CONST_STR record");
    }
    let op = try code.get(index);
    let const_str = codegen::code_op_const_str();
    let next = try tape_record_end(code, index);
    if op == const_str {
        let dst = try code.get(index + 1);
        if dst == value_id {
            return try tape_const_str_payload_length(code, index);
        }
    }
    return try tape_string_length(code, value_id, next);
}

// tape_const_str_payload_length returns the payload byte length of the CONST_STR
// record at index (its end span minus its start span), kept in its own function so
// the matching guard stays a single-statement 'return try <call>;'.
fn tape_const_str_payload_length(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let payload_start = try code.get(index + 2);
    let payload_end = try code.get(index + 3);
    return payload_end - payload_start;
}

fn render_print_string(
    out: &var std::string::String,
    value_id: i64,
    byte_len: i64
) -> !void {
    try w(out, "  %ps");
    try wi(out, value_id);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.s");
    try wi(out, value_id);
    try wl(out, ", 0");
    try w(out, "  %ps");
    try wi(out, value_id);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %ps");
    try wi(out, value_id);
    try w(out, "_base, i64 ");
    try wi(out, byte_len);
    try wl(out, ", 1");
    try w(out, "  %ps");
    try wi(out, value_id);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %ps");
    try wi(out, value_id);
    try wl(out, "_slice)");
    return;
}

fn render_print_i64(out: &var std::string::String, value_id: i64) -> !void {
    try w(out, "  %pi");
    try wi(out, value_id);
    try w(out, "_dec = call %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %v");
    try wi(out, value_id);
    try wl(out, ")");
    try w(out, "  %pi");
    try wi(out, value_id);
    try w(out, "_slice = extractvalue %kizu.error.slice.u8 %pi");
    try wi(out, value_id);
    try wl(out, "_dec, 1");
    try w(out, "  %pi");
    try wi(out, value_id);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %pi");
    try wi(out, value_id);
    try wl(out, "_slice)");
    return;
}

// render_print_newline writes the trailing newline print() appends after its payload.
fn render_print_newline(out: &var std::string::String, value_id: i64) -> !void {
    try w(out, "  %pn");
    try wi(out, value_id);
    try wl(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.newline, 0");
    try w(out, "  %pn");
    try wi(out, value_id);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %pn");
    try wi(out, value_id);
    try wl(out, "_base, i64 1, 1");
    try w(out, "  %pn");
    try wi(out, value_id);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %pn");
    try wi(out, value_id);
    try wl(out, "_slice)");
    return;
}

fn render_main_wrapper(out: &var std::string::String) -> !void {
    try wl(out, "define i32 @main(i32 %argc, ptr %argv) {");
    try wl(out, "entry:");
    try wl(out, "  call void @kizu_host_init(i32 %argc, ptr %argv)");
    try wl(out, "  %code = call i64 @kizu_run_main()");
    try wl(out, "  %exit = trunc i64 %code to i32");
    try wl(out, "  ret i32 %exit");
    try wl(out, "}");
    return;
}

// tape_call_record_end returns the index past a CALL record, reading its trailing
// variable arg-id count (kept out of tape_record_end so the call branch stays a
// single-statement return the compiled-MIR if-lowering models).
fn tape_call_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let arg_count = try code.get(index + 4);
    return index + 5 + arg_count;
}

// tape_record_end returns the tape index just past the record beginning at index,
// using each opcode's fixed arity (CALL carries a trailing variable arg-id list).
fn tape_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let op = try code.get(index);
    let const_int = codegen::code_op_const_int();
    if op == const_int {
        return index + 3;
    }
    let const_str = codegen::code_op_const_str();
    if op == const_str {
        return index + 4;
    }
    let binary = codegen::code_op_binary();
    if op == binary {
        return index + 5;
    }
    let call = codegen::code_op_call();
    if op == call {
        return try tape_call_record_end(code, index);
    }
    let print_op = codegen::code_op_print();
    if op == print_op {
        return index + 3;
    }
    let func_begin = codegen::code_op_func_begin();
    if op == func_begin {
        return index + 6;
    }
    let func_end = codegen::code_op_func_end();
    if op == func_end {
        return index + 1;
    }
    let ret_void = codegen::code_op_ret_void();
    if op == ret_void {
        return index + 1;
    }
    let ret_value = codegen::code_op_ret_value();
    if op == ret_value {
        return index + 2;
    }
    let if_begin = codegen::code_op_if_begin();
    if op == if_begin {
        return index + 2;
    }
    let if_else = codegen::code_op_if_else();
    if op == if_else {
        return index + 2;
    }
    let if_end = codegen::code_op_if_end();
    if op == if_end {
        return index + 2;
    }
    let var_decl = codegen::code_op_var_decl();
    if op == var_decl {
        return index + 3;
    }
    let var_load = codegen::code_op_var_load();
    if op == var_load {
        return index + 3;
    }
    let var_store = codegen::code_op_var_store();
    if op == var_store {
        return index + 3;
    }
    let while_begin = codegen::code_op_while_begin();
    if op == while_begin {
        return index + 2;
    }
    let while_cond = codegen::code_op_while_cond();
    if op == while_cond {
        return index + 3;
    }
    let while_end = codegen::code_op_while_end();
    if op == while_end {
        return index + 2;
    }
    let for_begin = codegen::code_op_for_begin();
    if op == for_begin {
        return index + 7;
    }
    let for_end = codegen::code_op_for_end();
    if op == for_end {
        return index + 5;
    }
    let break_op = codegen::code_op_break();
    if op == break_op {
        return index + 3;
    }
    let continue_op = codegen::code_op_continue();
    if op == continue_op {
        return index + 3;
    }
    return code.len();
}

fn render_llvm_c_bytes(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        try render_llvm_c_byte(out, byte);
        index = index + 1;
    }
    return;
}

fn render_llvm_c_byte(out: &var std::string::String, byte: u8) -> !void {
    // Escape the three c-string metacharacters through mutually exclusive void
    // then-body guards and append any other byte verbatim, falling through to a
    // single return -- the shape both the Go reference compiler and the compiled-MIR
    // void if-lowering accept (a 'return try <void call>;' tail is rejected by the former).
    let quote = cast<u8>(34);
    let backslash = cast<u8>(92);
    let newline = cast<u8>(10);
    let is_special = byte == quote or byte == backslash or byte == newline;
    if byte == quote {
        try w(out, "\22");
    }
    if byte == backslash {
        try w(out, "\5C");
    }
    if byte == newline {
        try w(out, "\0A");
    }
    if !is_special {
        try out.append_byte(byte);
    }
    return;
}
