// render_try_call_owned_string emits a value-position 'try <callee>(...)' of an
// error-union owned-String function: call the '%kizu.error.owned' callee, branch
// on its ok flag, propagate the message on failure (the shared runtime message
// propagate), and extract the owned-String success payload (struct index 1) into
// the result on the cont path. Temps/labels are suffixed with the tape index so
// they stay unique.
fn render_try_call_owned_string(
    out: &var std::string::String,
