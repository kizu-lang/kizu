fn render_one_instruction_control_var_i64(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    op: i64
) -> !void {
    let var_decl = codegen::code_op_var_decl();
    if op == var_decl {
        try render_var_decl(out, code, index);
    }
    let var_load = codegen::code_op_var_load();
    if op == var_load {
        try render_var_load(out, code, index);
    }
    let var_store = codegen::code_op_var_store();
    if op == var_store {
        try render_var_store(out, code, index);
    }
    let var_addr = codegen::code_op_var_addr();
    if op == var_addr {
        try render_var_addr(out, code, index);
    }
    let ptr_load = codegen::code_op_ptr_load();
    if op == ptr_load {
        try render_ptr_load(out, code, index);
    }
    let ptr_store = codegen::code_op_ptr_store();
    if op == ptr_store {
        try render_ptr_store(out, code, index);
    }
    return;
}

fn render_one_instruction_control_var_slice(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    op: i64
) -> !void {
    let var_decl_slice = codegen::code_op_var_decl_slice();
    if op == var_decl_slice {
        try render_var_decl_slice(out, code, index);
    }
    let var_load_slice = codegen::code_op_var_load_slice();
    if op == var_load_slice {
        try render_var_load_slice(out, code, index);
    }
    let var_store_slice = codegen::code_op_var_store_slice();
    if op == var_store_slice {
        try render_var_store_slice(out, code, index);
    }
    let var_addr_slice = codegen::code_op_var_addr_slice();
    if op == var_addr_slice {
        try render_var_addr_slice(out, code, index);
    }
    let ptr_load_slice = codegen::code_op_ptr_load_slice();
    if op == ptr_load_slice {
        try render_ptr_load_slice(out, code, index);
    }
    let ptr_store_slice = codegen::code_op_ptr_store_slice();
    if op == ptr_store_slice {
        try render_ptr_store_slice(out, code, index);
    }
    return;
}

fn render_one_instruction_control_var_bool(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    op: i64
) -> !void {
    let var_decl_bool = codegen::code_op_var_decl_bool();
    if op == var_decl_bool {
        try render_var_decl_bool(out, code, index);
    }
    let var_load_bool = codegen::code_op_var_load_bool();
    if op == var_load_bool {
        try render_var_load_bool(out, code, index);
    }
    let var_store_bool = codegen::code_op_var_store_bool();
    if op == var_store_bool {
        try render_var_store_bool(out, code, index);
    }
    return;
}

fn render_one_instruction_control_loop(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    op: i64
) -> !void {
    let while_begin = codegen::code_op_while_begin();
    if op == while_begin {
        try render_while_begin(out, code, index);
    }
    let while_cond = codegen::code_op_while_cond();
    if op == while_cond {
        try render_while_cond(out, code, index);
    }
    let while_end = codegen::code_op_while_end();
    if op == while_end {
        try render_while_end(out, code, index);
    }
    let for_begin = codegen::code_op_for_begin();
    if op == for_begin {
        try render_for_begin(out, code, index);
    }
    let for_end = codegen::code_op_for_end();
    if op == for_end {
        try render_for_end(out, code, index);
    }
    let break_op = codegen::code_op_break();
    if op == break_op {
        try render_break(out, code, index);
    }
    let continue_op = codegen::code_op_continue();
    if op == continue_op {
        try render_continue(out, code, index);
    }
    return;
}

// render_var_decl stores a var local's init value into its alloca slot; the
// '%slot<id>' alloca is hoisted to the function entry by render_var_allocas.
fn render_var_decl(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let init_value = try code.get(index + 2);
    try w(out, "  store i64 %v");
    try wi(out, init_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_load reads a var local's alloca slot into a fresh SSA value.
fn render_var_load(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_store writes an SSA value back into a var local's alloca slot.
fn render_var_store(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store i64 %v");
    try wi(out, value_id);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_addr materializes a var slot's address as a 'ptr' SSA value so it
// can be passed to a '&var i64' parameter. The getelementptr at offset 0 is a
// no-op address-of that names the alloca pointer under '%v<dst>'.
fn render_var_addr(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = getelementptr i64, ptr %slot");
    try wi(out, slot);
    try w(out, ", i64 0");
    try nl(out);
    return;
}

// render_ptr_load reads an i64 through a '&var i64' pointer value into a fresh
// SSA value.
fn render_ptr_load(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let ptr_value = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i64, ptr %v");
    try wi(out, ptr_value);
    try nl(out);
    return;
}

// render_ptr_store writes an i64 SSA value through a '&var i64' pointer value,
// so the caller's var slot observes the mutation.
fn render_ptr_store(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let ptr_value = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store i64 %v");
    try wi(out, value_id);
    try w(out, ", ptr %v");
    try wi(out, ptr_value);
    try nl(out);
    return;
}

// render_var_addr_slice materializes a slice var slot's address as a 'ptr' SSA
// value so it can be passed to a '&var []u8' parameter. The getelementptr at
// offset 0 is a no-op address-of that names the '%sslot' alloca under '%v<dst>'.
fn render_var_addr_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = getelementptr %kizu.slice.u8, ptr %sslot");
    try wi(out, slot);
    try w(out, ", i64 0");
    try nl(out);
    return;
}

// render_ptr_load_slice reads a '%kizu.slice.u8' value through a '&var []u8'
// pointer value into a fresh SSA value.
fn render_ptr_load_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let ptr_value = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load %kizu.slice.u8, ptr %v");
    try wi(out, ptr_value);
    try nl(out);
    return;
}

// render_ptr_store_slice writes a '%kizu.slice.u8' SSA value through a '&var []u8'
// pointer value, so the caller's slice var slot observes the mutation.
fn render_ptr_store_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let ptr_value = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store %kizu.slice.u8 %v");
    try wi(out, value_id);
    try w(out, ", ptr %v");
    try wi(out, ptr_value);
    try nl(out);
    return;
}

// render_var_decl_slice / render_var_load_slice / render_var_store_slice mirror
// the i64 var slot trio for '%kizu.slice.u8' slots ('%sslot<id>').
fn render_var_decl_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let init_value = try code.get(index + 2);
    try w(out, "  store %kizu.slice.u8 %v");
    try wi(out, init_value);
    try w(out, ", ptr %sslot");
    try wi(out, slot);
    try nl(out);
    return;
}

fn render_var_load_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load %kizu.slice.u8, ptr %sslot");
    try wi(out, slot);
    try nl(out);
    return;
}

fn render_var_store_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store %kizu.slice.u8 %v");
    try wi(out, value_id);
    try w(out, ", ptr %sslot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_var_decl_bool / render_var_load_bool / render_var_store_bool mirror
// the var slot trios for i1 slots ('%bslot<id>').
fn render_var_decl_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let init_value = try code.get(index + 2);
    try w(out, "  store i1 %v");
    try wi(out, init_value);
    try w(out, ", ptr %bslot");
    try wi(out, slot);
    try nl(out);
    return;
}

fn render_var_load_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slot = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i1, ptr %bslot");
    try wi(out, slot);
    try nl(out);
    return;
}

fn render_var_store_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let slot = try code.get(index + 1);
    let value_id = try code.get(index + 2);
    try w(out, "  store i1 %v");
    try wi(out, value_id);
    try w(out, ", ptr %bslot");
    try wi(out, slot);
    try nl(out);
    return;
}

// render_while_begin closes the current block into the condition block and opens
// it; the condition expression records follow and produce the i1 WHILE_COND tests.
fn render_while_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %wcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wcond_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_while_cond branches on the lowered i1 condition into the loop body or
// past the loop, then opens the body block.
fn render_while_cond(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let cond = try code.get(index + 1);
    let begin = try code.get(index + 2);
    try w(out, "  br i1 %v");
    try wi(out, cond);
    try w(out, ", label %wbody_");
    try wi(out, begin);
    try w(out, ", label %wend_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wbody_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_while_end closes the body back to the condition block and opens the exit
// block break targets.
fn render_while_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %wcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "wend_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_for_begin seeds the induction slot from the start value and opens the
// bounded condition block: it loads the slot and compares it against the end
// value, branching into the body or past the loop.
fn render_for_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let slot = try code.get(index + 2);
    let start_value = try code.get(index + 3);
    let end_value = try code.get(index + 4);
    let load_value = try code.get(index + 5);
    let cmp_value = try code.get(index + 6);
    try w(out, "  store i64 %v");
    try wi(out, start_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  br label %fcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fcond_");
    try wi(out, begin);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, load_value);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  %v");
    try wi(out, cmp_value);
    try w(out, " = icmp slt i64 %v");
    try wi(out, load_value);
    try w(out, ", %v");
    try wi(out, end_value);
    try nl(out);
    try w(out, "  br i1 %v");
    try wi(out, cmp_value);
    try w(out, ", label %fbody_");
    try wi(out, begin);
    try w(out, ", label %fend_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fbody_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_for_end emits the increment latch (the continue target) and opens the
// exit block (the break target): the body falls through to the latch, which loads
// the slot, adds one, stores it back, and branches to the condition block.
fn render_for_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let slot = try code.get(index + 2);
    let load_value = try code.get(index + 3);
    let add_value = try code.get(index + 4);
    try w(out, "  br label %flatch_");
    try wi(out, begin);
    try nl(out);
    try w(out, "flatch_");
    try wi(out, begin);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, load_value);
    try w(out, " = load i64, ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  %v");
    try wi(out, add_value);
    try w(out, " = add i64 %v");
    try wi(out, load_value);
    try wl(out, ", 1");
    try w(out, "  store i64 %v");
    try wi(out, add_value);
    try w(out, ", ptr %slot");
    try wi(out, slot);
    try nl(out);
    try w(out, "  br label %fcond_");
    try wi(out, begin);
    try nl(out);
    try w(out, "fend_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_break branches to the enclosing loop's exit label and opens a fresh dead
// block so any records the lowering emitted after the break stay well-formed LLVM.
fn render_break(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let exit_prefix = loop_exit_label_prefix(kind);
    try w(out, "  br label %");
    try w(out, exit_prefix);
    try wi(out, begin);
    try nl(out);
    try render_dead_label(out, index);
    return;
}

// render_continue branches to the enclosing loop's continue label (the while
// condition block or the for latch) and opens a fresh dead block.
fn render_continue(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let cont_prefix = loop_continue_label_prefix(kind);
    try w(out, "  br label %");
    try w(out, cont_prefix);
    try wi(out, begin);
    try nl(out);
    try render_dead_label(out, index);
    return;
}

// render_dead_label opens a uniquely named block after a break/continue terminator
// so the records following it in the same statement list remain in a labeled block.
fn render_dead_label(
    out: &var std::string::String,
    index: i64
) -> !void {
    try w(out, "dead_");
    try wi(out, index);
    try wl(out, ":");
    return;
}

// loop_exit_label_prefix maps a loop kind to its break-target label prefix.
fn loop_exit_label_prefix(kind: i64) -> []u8 {
    let kind_for = codegen::code_loop_kind_for();
    if kind == kind_for {
        return "fend_";
    }
    return "wend_";
}

// loop_continue_label_prefix maps a loop kind to its continue-target label prefix
// (for loops continue at their increment latch, while loops at the condition).
fn loop_continue_label_prefix(kind: i64) -> []u8 {
    let kind_for = codegen::code_loop_kind_for();
    if kind == kind_for {
        return "flatch_";
    }
    return "wcond_";
}

// render_if_begin emits the conditional branch for an IF_BEGIN record: it tests the
// i1 condition value and branches to the then/else labels keyed by this record's
// own tape index, then opens the then label.
fn render_if_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let cond = try code.get(index + 1);
    try w(out, "  br i1 %v");
    try wi(out, cond);
    try w(out, ", label %then_");
    try wi(out, index);
    try w(out, ", label %else_");
    try wi(out, index);
    try nl(out);
    try w(out, "then_");
    try wi(out, index);
    try wl(out, ":");
    return;
}

// render_if_else closes the then block (branch to the end label) and opens the else
// label; the IF_ELSE record carries its IF_BEGIN tape index so the labels match.
fn render_if_else(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %end_");
    try wi(out, begin);
    try nl(out);
    try w(out, "else_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_if_end closes the else block (branch to the end label) and opens the end
// label; the IF_END record carries its IF_BEGIN tape index so the labels match.
fn render_if_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    try w(out, "  br label %end_");
    try wi(out, begin);
    try nl(out);
    try w(out, "end_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

fn render_const_int(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let literal = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = add i64 0, ");
    try wi(out, literal);
    try nl(out);
    return;
}

// render_const_bool materializes a bool literal as an i1 SSA value: the tape
// literal is 1 (true) or 0 (false), compared against zero.
fn render_const_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let literal = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = icmp ne i64 ");
    try wi(out, literal);
    try wl(out, ", 0");
    return;
}

fn render_atomic_bool_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let init = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = getelementptr i8, ptr %atomic");
    try wi(out, dst);
    try wl(out, ", i64 0");
    try w(out, "  %ab");
    try wi(out, index);
    try w(out, " = zext i1 %v");
    try wi(out, init);
    try wl(out, " to i8");
    try w(out, "  store atomic i8 %ab");
    try wi(out, index);
    try w(out, ", ptr %v");
    try wi(out, dst);
    try wl(out, " seq_cst, align 1");
    return;
}

fn render_atomic_bool_load(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let receiver = try code.get(index + 2);
    try w(out, "  %abl");
    try wi(out, index);
    try w(out, " = load atomic i8, ptr %v");
    try wi(out, receiver);
    try wl(out, " seq_cst, align 1");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = icmp ne i8 %abl");
    try wi(out, index);
    try wl(out, ", 0");
    return;
}

// render_not emits the logical negation of an i1 operand ('xor i1 <op>, true').
fn render_not(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let operand = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = xor i1 %v");
    try wi(out, operand);
    try wl(out, ", true");
    return;
}

// render_sc_begin opens a short-circuit 'and'/'or': store the left i1 into the
// record's slot, then branch into the right-operand block only when the left does
// not already decide the result (an 'and' skips on false, an 'or' skips on true).
fn render_sc_begin(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let lhs = try code.get(index + 2);
    let is_or = try code.get(index + 3);
    try w(out, "  store i1 %v");
    try wi(out, lhs);
    try w(out, ", ptr %sc");
    try wi(out, begin);
    try nl(out);
    try w(out, "  br i1 %v");
    try wi(out, lhs);
    if is_or == 1 {
        try render_sc_branch(out, begin, "scend_", "scrhs_");
    }
    if is_or != 1 {
        try render_sc_branch(out, begin, "scrhs_", "scend_");
    }
    try w(out, "scrhs_");
    try wi(out, begin);
    try wl(out, ":");
    return;
}

// render_sc_branch writes the ', label %<a><begin>, label %<b><begin>' tail of the
// SC_BEGIN conditional branch.
fn render_sc_branch(
    out: &var std::string::String,
    begin: i64,
    true_prefix: []u8,
    false_prefix: []u8
) -> !void {
    try w(out, ", label %");
    try w(out, true_prefix);
    try wi(out, begin);
    try w(out, ", label %");
    try w(out, false_prefix);
    try wi(out, begin);
    try nl(out);
    return;
}

// render_sc_end closes a short-circuit 'and'/'or': store the right i1 into the
// slot, fall into the join block, and load the slot into the result value.
fn render_sc_end(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let begin = try code.get(index + 1);
    let rhs = try code.get(index + 2);
    let dst = try code.get(index + 3);
    try w(out, "  store i1 %v");
    try wi(out, rhs);
    try w(out, ", ptr %sc");
    try wi(out, begin);
    try nl(out);
    try w(out, "  br label %scend_");
    try wi(out, begin);
    try nl(out);
    try w(out, "scend_");
    try wi(out, begin);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i1, ptr %sc");
    try wi(out, begin);
    try nl(out);
    return;
}

// render_ret_value emits the value-return terminator for the surrounding ABI,
// then opens a fresh dead block (like break/continue do) so a return in a nested
// block leaves the structural records that follow it in a labeled block. The
// kizu_run_main entry discards its return value (a run process exits 0 on
// success, matching the reference compiler); an error-union-i64 function wraps
// the value into its ok union.
fn render_ret_value(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let value_id = try code.get(index + 1);
    let main_abi = ret_abi_main();
    let err_i64 = ret_abi_user_err_i64();
    let err_owned = ret_abi_user_err_owned();
    let typed_err_void = ret_abi_user_typed_error_void();
    let typed_err_i64 = ret_abi_user_typed_error_i64();
    if abi == main_abi {
        try wl(out, "  ret i64 0");
    }
    if abi == err_i64 {
        try render_ret_value_err_i64(out, index, value_id);
    }
    if abi == err_owned {
        try render_ret_value_err_owned(out, index, value_id);
    }
    if abi == typed_err_void {
        try render_ret_value_typed_error_void(out, code, kinds, index, value_id);
    }
    if abi == typed_err_i64 {
        try render_ret_value_typed_error_i64(out, code, kinds, index, value_id);
    }
    if abi != main_abi {
        if abi != err_i64 {
            if abi != err_owned {
                if abi != typed_err_void {
                    if abi != typed_err_i64 {
                        try render_ret_value_plain(out, code, kinds, value_id);
                    }
                }
            }
        }
    }
    try render_dead_label(out, index);
    return;
}

// render_ret_value_plain emits the plain return terminator typed from the
// returned value's kind (i64 scalars, the union aggregate for union returns).
fn render_ret_value_plain(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    value_id: i64
) -> !void {
    let value_kind = try kinds.get(value_id);
    try w(out, "  ret ");
    try render_value_type(out, code, value_kind);
    try w(out, " %v");
    try wi(out, value_id);
    try nl(out);
    return;
}

// render_ret_value_err_i64 wraps an i64 return value into the ok
// '%kizu.error.i64' union through an index-suffixed temp.
fn render_ret_value_err_i64(
    out: &var std::string::String,
    index: i64,
    value_id: i64
) -> !void {
    try w(out, "  %rv");
    try wi(out, index);
    try w(out, " = insertvalue %kizu.error.i64 { i1 true, i64 0, %kizu.slice.u8 zeroinitializer }, i64 %v");
    try wi(out, value_id);
    try wl(out, ", 1");
    try w(out, "  ret %kizu.error.i64 %rv");
    try wi(out, index);
    try nl(out);
    return;
}

// render_ret_value_err_owned wraps an owned-String return value into the ok
// '%kizu.error.owned' union through an index-suffixed temp: the moved-out handle
// becomes the success payload at struct index 1.
fn render_ret_value_err_owned(
    out: &var std::string::String,
    index: i64,
    value_id: i64
) -> !void {
    try w(out, "  %rv");
    try wi(out, index);
    try w(out, " = insertvalue %kizu.error.owned { i1 true, %kizu.owned zeroinitializer, %kizu.slice.u8 zeroinitializer }, %kizu.owned %v");
    try wi(out, value_id);
    try wl(out, ", 1");
    try w(out, "  ret %kizu.error.owned %rv");
    try wi(out, index);
    try nl(out);
    return;
}

// render_ret_value_typed_error_i64 returns either an i64 success payload or a
// typed error-union failure payload. The failure is already a '%kizu.run.union'
// value produced by UNION_PACK from 'Error::Variant(...)'.
fn render_ret_value_typed_error_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    value_id: i64
) -> !void {
    let value_kind = try kinds.get(value_id);
    let is_error_payload = try value_kind_is_union(code, value_kind);
    if is_error_payload {
        try w(out, "  %rv");
        try wi(out, index);
        try w(out, " = insertvalue %kizu.error.union.i64 { i1 false, i64 0, %kizu.run.union zeroinitializer }, %kizu.run.union %v");
        try wi(out, value_id);
        try wl(out, ", 2");
        try w(out, "  ret %kizu.error.union.i64 %rv");
        try wi(out, index);
        try nl(out);
    }
    if !is_error_payload {
        try w(out, "  %rv");
        try wi(out, index);
        try w(out, " = insertvalue %kizu.error.union.i64 { i1 true, i64 0, %kizu.run.union zeroinitializer }, i64 %v");
        try wi(out, value_id);
        try wl(out, ", 1");
        try w(out, "  ret %kizu.error.union.i64 %rv");
        try wi(out, index);
        try nl(out);
    }
    return;
}

fn render_ret_value_typed_error_void(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    value_id: i64
) -> !void {
    let value_kind = try kinds.get(value_id);
    let is_error_payload = try value_kind_is_union(code, value_kind);
    if is_error_payload {
        try w(out, "  %rv");
        try wi(out, index);
        try w(out, " = insertvalue %kizu.error.union.void { i1 false, %kizu.run.union zeroinitializer }, %kizu.run.union %v");
        try wi(out, value_id);
        try wl(out, ", 1");
        try w(out, "  ret %kizu.error.union.void %rv");
        try wi(out, index);
        try nl(out);
    }
    if !is_error_payload {
        try wl(out, "  ret %kizu.error.union.void { i1 true, %kizu.run.union zeroinitializer }");
    }
    return;
}

// render_ret_void emits the terminator for a 'return;' statement, then opens a
// fresh dead block. Plain scalar functions use their ABI default value, while an
// error-union-void function yields the ok union.
fn render_ret_void(out: &var std::string::String, index: i64, abi: i64) -> !void {
    let err_void = ret_abi_user_err_void();
    let bool_abi = ret_abi_user_bool();
    let typed_err_void = ret_abi_user_typed_error_void();
    if abi == err_void {
        try render_ret_err_ok(out);
    }
    if abi == typed_err_void {
        try wl(out, "  ret %kizu.error.union.void { i1 true, %kizu.run.union zeroinitializer }");
    }
    if abi == bool_abi {
        try wl(out, "  ret i1 false");
    }
    if abi != err_void {
        if abi != typed_err_void {
            if abi != bool_abi {
                try wl(out, "  ret i64 0");
            }
        }
    }
    try render_dead_label(out, index);
    return;
}

// render_ret_err_ok returns the success '%kizu.error.void' union (ok flag true,
// empty message slice) as an inline aggregate constant so no SSA temp is needed.
fn render_ret_err_ok(out: &var std::string::String) -> !void {
    try wl(out, "  ret %kizu.error.void { i1 true, %kizu.slice.u8 zeroinitializer }");
    return;
}

// render_ret_err_fail returns the failure '%kizu.error.void' union for a
// 'return error("msg")': the ok flag is false and the message slice points at the
// message string global the CONST_STR record emitted ('@.kizu.run.s<value_id>').
fn render_ret_err_fail(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let value_id = try code.get(index + 1);
    let main_abi = ret_abi_main();
    let err_i64 = ret_abi_user_err_i64();
    let err_owned = ret_abi_user_err_owned();
    try render_error_cleanup(out, code, index);
    if abi == main_abi {
        try render_ret_err_fail_exit(out, index);
    }
    if abi == err_i64 {
        try render_ret_err_fail_i64(out, code, value_id);
    }
    if abi == err_owned {
        try render_ret_err_fail_owned(out, code, value_id);
    }
    if abi != main_abi {
        if abi != err_i64 {
            if abi != err_owned {
                try render_ret_err_fail_void(out, code, value_id);
            }
        }
    }
    try render_dead_label(out, index);
    return;
}

// render_ret_err_fail_exit maps a 'return error("msg")' in kizu_run_main to the
// process-exit-1 path.
fn render_ret_err_fail_exit(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %ef");
    try wi(out, index);
    try wl(out, "_exit = call i64 @kizu_rt_process_exit_code(i64 1)");
    try w(out, "  ret i64 %ef");
    try wi(out, index);
    try wl(out, "_exit");
    return;
}

fn render_ret_err_fail_void(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64
) -> !void {
    let byte_len = try tape_string_length(code, value_id, 0);
    try w(out, "  ret %kizu.error.void { i1 false, %kizu.slice.u8 { ptr @.kizu.run.s");
    try wi(out, value_id);
    try w(out, ", i64 ");
    try wi(out, byte_len);
    try wl(out, " } }");
    return;
}

fn render_ret_err_fail_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64
) -> !void {
    let byte_len = try tape_string_length(code, value_id, 0);
    try w(out, "  ret %kizu.error.i64 { i1 false, i64 0, %kizu.slice.u8 { ptr @.kizu.run.s");
    try wi(out, value_id);
    try w(out, ", i64 ");
    try wi(out, byte_len);
    try wl(out, " } }");
    return;
}

// render_ret_err_fail_owned maps a 'return error("msg")' in a
// '!std::string::String' function to its failed '%kizu.error.owned' union: the ok
// flag is false, the owned payload is left zero, and the message slice points at
// the CONST_STR global.
fn render_ret_err_fail_owned(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64
) -> !void {
    let byte_len = try tape_string_length(code, value_id, 0);
    try w(out, "  ret %kizu.error.owned { i1 false, %kizu.owned zeroinitializer, %kizu.slice.u8 { ptr @.kizu.run.s");
    try wi(out, value_id);
    try w(out, ", i64 ");
    try wi(out, byte_len);
    try wl(out, " } }");
    return;
}

fn render_binary(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let left = try code.get(index + 3);
    let right = try code.get(index + 4);
    // A comparison kind (5..10) lowers to an i1 'icmp <pred>'; the arithmetic
    // kinds (including 11 = srem) lower to their i64 mnemonic. Both branches are
    // void then-bodies falling through to a single return (the shape the
    // compiled-MIR if-lowering models).
    let is_compare = kind >= 5 and kind <= 10;
    if is_compare {
        try render_binary_compare(out, dst, kind, left, right);
    }
    if !is_compare {
        try render_binary_arith(out, dst, kind, left, right);
    }
    return;
}

fn render_binary_arith(
    out: &var std::string::String,
    dst: i64,
    kind: i64,
    left: i64,
    right: i64
) -> !void {
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = ");
    let mnemonic = binary_op_mnemonic(kind);
    try w(out, mnemonic);
    try w(out, " i64 %v");
    try wi(out, left);
    try w(out, ", %v");
    try wi(out, right);
    try nl(out);
    return;
}

fn render_binary_compare(
    out: &var std::string::String,
    dst: i64,
    kind: i64,
    left: i64,
    right: i64
) -> !void {
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = icmp ");
    let predicate = binary_compare_predicate(kind);
    try w(out, predicate);
    try w(out, " i64 %v");
    try wi(out, left);
    try w(out, ", %v");
    try wi(out, right);
    try nl(out);
    return;
}

fn binary_op_mnemonic(kind: i64) -> []u8 {
    if kind == 1 {
        return "add";
    }
    if kind == 2 {
        return "sub";
    }
    if kind == 3 {
        return "mul";
    }
    if kind == 11 {
        return "srem";
    }
    return "sdiv";
}

// binary_compare_predicate maps a comparison binary kind (5..10) to its signed
// LLVM icmp predicate.
fn binary_compare_predicate(kind: i64) -> []u8 {
    if kind == 5 {
        return "eq";
    }
    if kind == 6 {
        return "ne";
    }
    if kind == 7 {
        return "slt";
    }
    if kind == 8 {
        return "sle";
    }
    if kind == 9 {
        return "sgt";
    }
    return "sge";
}

// render_call emits '%v<dst> = call i64 @kizu_run_user_<callee>(<type> %v<arg>, ...)'.
fn render_call(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let callee_start = try code.get(index + 2);
    let callee_end = try code.get(index + 3);
    let arg_count = try code.get(index + 4);
    let callee = text[callee_start..callee_end];
    let dst_kind = try kinds.get(dst);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call ");
    try render_value_type(out, code, dst_kind);
    try w(out, " @kizu_run_user_");
    try w(out, callee);
    try w(out, "(");
    try render_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    return;
}

fn render_method_call(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let type_start = try code.get(index + 2);
    let type_end = try code.get(index + 3);
    let name_start = try code.get(index + 4);
    let name_end = try code.get(index + 5);
    let arg_count = try code.get(index + 6);
    let type_name = text[type_start..type_end];
    let name = text[name_start..name_end];
    let dst_kind = try kinds.get(dst);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call ");
    try render_value_type(out, code, dst_kind);
    try w(out, " @kizu_run_user_");
    try render_method_symbol(out, type_name, name);
    try w(out, "(");
    try render_method_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    return;
}

// render_call_args emits the '<type> %v<arg>' operands read from the CALL record's
// trailing arg-id list (which begins at index + 5), typing each argument from its
// value kind.
fn render_call_args(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    arg_count: i64,
    arg_index: i64
) -> !void {
    if arg_index >= arg_count {
        return;
    }
    if arg_index > 0 {
        try w(out, ", ");
    }
    let arg_value = try code.get(index + 5 + arg_index);
    let arg_kind = try kinds.get(arg_value);
    try render_value_type(out, code, arg_kind);
    try w(out, " %v");
    try wi(out, arg_value);
    let after = arg_index + 1;
    try render_call_args(out, code, kinds, index, arg_count, after);
    return;
}

fn render_method_call_args(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    arg_count: i64,
    arg_index: i64
) -> !void {
    if arg_index >= arg_count {
        return;
    }
    if arg_index > 0 {
        try w(out, ", ");
    }
    let arg_value = try code.get(index + 7 + arg_index);
    let arg_kind = try kinds.get(arg_value);
    try render_value_type(out, code, arg_kind);
    try w(out, " %v");
    try wi(out, arg_value);
    let after = arg_index + 1;
    try render_method_call_args(out, code, kinds, index, arg_count, after);
    return;
}

// render_try_call emits a 'try <callee>()' of an error-union-void function: call
// the '%kizu.error.void' callee, extract its ok flag, and branch into a fail block
// that propagates the error or a cont block that resumes the body. SSA temps and
// labels are suffixed with the record's tape index so they stay unique.
fn render_try_call(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let callee_start = try code.get(index + 1);
    let callee_end = try code.get(index + 2);
    let arg_count = try code.get(index + 3);
    let callee = text[callee_start..callee_end];
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_run_user_");
    try w(out, callee);
    try w(out, "(");
    try render_try_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_propagate(out, code, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

// render_try_call_args emits the '<type> %v<arg>' operands read from the TRY_CALL
// record's trailing arg-id list (which begins at index + 4: TRY_CALL has no
// leading result value id), typing each argument from its value kind.
fn render_try_call_args(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    arg_count: i64,
    arg_index: i64
) -> !void {
    if arg_index >= arg_count {
        return;
    }
    if arg_index > 0 {
        try w(out, ", ");
    }
    let arg_value = try code.get(index + 4 + arg_index);
    let arg_kind = try kinds.get(arg_value);
    try render_value_type(out, code, arg_kind);
    try w(out, " %v");
    try wi(out, arg_value);
    let after = arg_index + 1;
    try render_try_call_args(out, code, kinds, index, arg_count, after);
    return;
}

// render_try_call_i64 emits a 'try <callee>(...)' of an error-union-i64 function:
// call the '%kizu.error.i64' callee, extract its ok flag, and branch into a fail
// block that propagates the error by the surrounding ABI or a cont block that
// extracts the i64 success value into the result. SSA temps and labels are
// suffixed with the record's tape index so they stay unique.
fn render_try_call_i64(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let callee_start = try code.get(index + 2);
    let callee_end = try code.get(index + 3);
    let arg_count = try code.get(index + 4);
    let callee = text[callee_start..callee_end];
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.i64 @kizu_run_user_");
    try w(out, callee);
    try w(out, "(");
    try render_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_i64_propagate(out, code, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 1");
    return;
}

