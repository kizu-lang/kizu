    if op == union_tag {
        try render_union_tag(out, code, index);
    }
    let union_payload = codegen::code_op_union_payload();
    if op == union_payload {
        try render_union_payload(out, code, index);
    }
    let struct_pack = codegen::code_op_struct_pack();
    if op == struct_pack {
        try render_struct_pack(out, code, index);
    }
    let struct_field = codegen::code_op_struct_field();
    if op == struct_field {
        try render_struct_field(out, code, index);
