    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_byte = trunc i64 %v");
    try wi(out, value);
    try wl(out, " to i8");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %v");
    try wi(out, text_value);
