    try wi(out, index);
    try w(out, " = call %kizu.error.owned @kizu_run_path_clean(%kizu.owned %v");
    try wi(out, allocator);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, path);
    try wl(out, ")");
    try render_try_path_owned_result(out, code, index, dst, abi);
    return;
}

fn render_try_path_owned_result(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    dst: i64,
    abi: i64
) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.owned %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.owned %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try render_runtime_message_propagate(out, code, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.owned %tc");
    try wi(out, index);
    try wl(out, ", 1");
    return;
}

// render_try_i64_propagate emits the fail-block terminator for a try over an
// error-union-i64 callee: kizu_run_main exits 1, an error-union-void function
// re-wraps the message into its own union, and an error-union-i64 function
// propagates a fresh failed union carrying the message.
fn render_try_i64_propagate(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    try render_error_cleanup(out, code, index);
    let main_abi = ret_abi_main();
    let err_i64 = ret_abi_user_err_i64();
    let err_owned = ret_abi_user_err_owned();
    if abi == main_abi {
        try render_try_propagate_exit(out, index);
    }
    if abi == err_i64 {
        try render_try_i64_propagate_err_i64(out, index);
    }
    if abi == err_owned {
        try render_try_i64_propagate_err_owned(out, index);
    }
    if abi != main_abi {
        if abi != err_i64 {
            if abi != err_owned {
                try render_try_i64_propagate_err_void(out, index);
            }
        }
    }
    return;
}

// render_try_i64_propagate_err_i64 forwards a failed error-union-i64 try as the
// surrounding error-union-i64 function's own failed union.
fn render_try_i64_propagate_err_i64(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.i64 { i1 false, i64 0, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_pm, 2");
    try w(out, "  ret %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, "_pv");
    return;
}

// render_try_i64_propagate_err_void re-wraps a failed error-union-i64 try into the
// surrounding error-union-void function's own union.
fn render_try_i64_propagate_err_void(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.void { i1 false, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_pm, 1");
    try w(out, "  ret %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, "_pv");
    return;
}

// render_try_i64_propagate_err_owned re-wraps a failed error-union-i64 try into
// the surrounding '!std::string::String' function's own '%kizu.error.owned' union.
fn render_try_i64_propagate_err_owned(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.owned { i1 false, %kizu.owned zeroinitializer, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_pm, 2");
    try w(out, "  ret %kizu.error.owned %tc");
    try wi(out, index);
    try wl(out, "_pv");
    return;
}

fn render_try_typed_error_i64_propagate(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    try render_error_cleanup(out, code, index);
    let main_abi = ret_abi_main();
    let typed_err_i64 = ret_abi_user_typed_error_i64();
    let typed_err_void = ret_abi_user_typed_error_void();
    if abi == main_abi {
        try render_try_propagate_exit(out, index);
    }
    if abi == typed_err_i64 {
        try render_try_typed_error_i64_propagate_err_i64(out, index);
    }
    if abi == typed_err_void {
        try render_try_typed_error_i64_propagate_err_void(out, index);
    }
    return;
}

fn render_try_typed_error_i64_propagate_err_i64(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.union.i64 %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.union.i64 { i1 false, i64 0, %kizu.run.union zeroinitializer }, %kizu.run.union %tc");
    try wi(out, index);
    try wl(out, "_pm, 2");
    try w(out, "  ret %kizu.error.union.i64 %tc");
    try wi(out, index);
    try wl(out, "_pv");
    return;
}

