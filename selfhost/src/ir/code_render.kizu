    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let receiver = try code.get(index + 1);
    let bytes = try code.get(index + 2);
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %v");
    try wi(out, receiver);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, bytes);
    try wl(out, ")");
    try render_try_void_result(out, index, abi);
    return;
}

