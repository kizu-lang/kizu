fn render_try_array_get_i64_kind(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    element_kind: i64
) -> !void {
    let dst = try code.get(index + 1);
    let receiver = try code.get(index + 2);
    let item_index = try code.get(index + 3);
    try w(out, "  %ag");
    try wi(out, index);
    try w(out, " = call %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned %v");
    try wi(out, receiver);
    try w(out, ", i64 %v");
    try wi(out, item_index);
    try wl(out, ")");
    try w(out, "  %ag");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.slice.u8 %ag");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %ag");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.slice.u8 %ag");
    try wi(out, index);
    try wl(out, ", 2");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = insertvalue %kizu.error.i64 { i1 false, i64 0, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_pm, 2");
    try render_try_i64_propagate(out, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    try w(out, "  %ag");
    try wi(out, index);
    try w(out, "_slice = extractvalue %kizu.error.slice.u8 %ag");
    try wi(out, index);
    try wl(out, ", 1");
    try w(out, "  %ag");
    try wi(out, index);
    try w(out, "_ptr = extractvalue %kizu.slice.u8 %ag");
    try wi(out, index);
    try wl(out, "_slice, 0");
    try render_array_get_load(out, dst, index, element_kind);
    return;
}

fn render_try_array_get_kind(
    out: &var std::string::String,
