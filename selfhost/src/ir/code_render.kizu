    let callee_end = try code.get(index + 3);
    let arg_count = try code.get(index + 4);
    let callee = text[callee_start..callee_end];
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.owned @kizu_run_user_");
    try w(out, callee);
    try w(out, "(");
    try render_call_args(out, code, kinds, index, arg_count, 0);
    try wl(out, ")");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.owned %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.owned %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try render_runtime_message_propagate(out, code, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.owned %tc");
    try wi(out, index);
    try wl(out, ", 1");
    return;
}

fn render_try_path_join(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let allocator = try code.get(index + 2);
    let left = try code.get(index + 3);
    let right = try code.get(index + 4);
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.owned @kizu_run_path_join(%kizu.owned %v");
    try wi(out, allocator);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, left);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, right);
    try wl(out, ")");
    try render_try_path_owned_result(out, code, index, dst, abi);
    return;
}

fn render_try_path_clean(
    out: &var std::string::String,
