    try w(out, " = call %kizu.error.void @kizu_run_string_append_bool(%kizu.owned %v");
    try wi(out, text_value);
    try w(out, ", i1 %v");
    try wi(out, value);
    try wl(out, ")");
    try render_try_error_void_tail(out, code, index, abi);
    return;
}

fn render_try_string_append_bytes_literal(
