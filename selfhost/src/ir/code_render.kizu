fn render_try_string_append_byte(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let text_value = try code.get(index + 1);
    let value = try code.get(index + 2);
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_byte = trunc i64 %v");
    try wi(out, value);
    try wl(out, " to i8");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %v");
    try wi(out, text_value);
    try w(out, ", i8 %tc");
    try wi(out, index);
    try wl(out, "_byte)");
    try render_try_error_void_tail(out, code, index, abi);
    return;
}

fn render_try_error_void_tail(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_propagate(out, code, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

// render_try_fs_read emits 'try std::fs::read_file(io, path)': build the path slice
// from its CONST_STR global, call the runtime read, extract the ok flag, and branch
// into a fail block that propagates the error or a cont block that extracts the read
// bytes slice into the result value. SSA temps and labels are suffixed with the
// result value id so they stay unique.
fn render_try_fs_read(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let io_value = try code.get(index + 2);
    let path_value = try code.get(index + 3);
    let path_len = try tape_string_length(code, path_value, 0);
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, "_pathbase = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.s");
    try wi(out, path_value);
    try wl(out, ", 0");
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, "_path = insertvalue %kizu.slice.u8 %fr");
    try wi(out, dst);
    try w(out, "_pathbase, i64 ");
    try wi(out, path_len);
    try wl(out, ", 1");
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, " = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %v");
    try wi(out, io_value);
    try w(out, ", %kizu.slice.u8 %fr");
    try wi(out, dst);
    try wl(out, "_path)");
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, "_ok = extractvalue %kizu.error.slice.u8 %fr");
    try wi(out, dst);
    try wl(out, ", 0");
    try w(out, "  br i1 %fr");
    try wi(out, dst);
    try w(out, "_ok, label %fr");
    try wi(out, dst);
    try w(out, "_cont, label %fr");
    try wi(out, dst);
    try wl(out, "_fail");
    try w(out, "fr");
    try wi(out, dst);
    try wl(out, "_fail:");
    try render_fs_read_propagate(out, code, index, dst, abi);
    try w(out, "fr");
    try wi(out, dst);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.slice.u8 %fr");
    try wi(out, dst);
    try wl(out, ", 1");
    return;
}

// render_try_io_write emits a 'try std::io::write_stdout/write_stderr(io, bytes)'
// statement: call the stream's runtime write with the io handle and the message
// slice, extract the ok flag, and branch into a fail block that propagates the
// error by the surrounding ABI or a cont block that resumes the body. The '%tc'
// temp prefix matches TRY_CALL's so render_try_propagate serves both records.
fn render_try_io_write(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let io_value = try code.get(index + 1);
    let msg_value = try code.get(index + 2);
    let stream = try code.get(index + 3);
    let stderr_stream = codegen::code_io_stream_stderr();
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_rt_io_write_");
    if stream == stderr_stream {
        try w(out, "stderr");
    }
    if stream != stderr_stream {
        try w(out, "stdout");
    }
    try w(out, "(%kizu.owned %v");
    try wi(out, io_value);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, msg_value);
    try wl(out, ")");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_propagate(out, code, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

// render_fs_exists emits 'try std::fs::exists(io, path)': call the runtime stat,
// extract the ok flag, and branch into a fail block that propagates the error or a
// cont block that extracts the i1 result into the result value. The '%fr' temp
// prefix matches TRY_FS_READ's so render_fs_read_propagate serves both records.
fn render_fs_exists(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let io_value = try code.get(index + 2);
    let path_value = try code.get(index + 3);
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, " = call %kizu.error.bool @kizu_rt_fs_exists(%kizu.owned %v");
    try wi(out, io_value);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, path_value);
    try wl(out, ")");
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, "_ok = extractvalue %kizu.error.bool %fr");
    try wi(out, dst);
    try wl(out, ", 0");
    try w(out, "  br i1 %fr");
    try wi(out, dst);
    try w(out, "_ok, label %fr");
    try wi(out, dst);
    try w(out, "_cont, label %fr");
    try wi(out, dst);
    try wl(out, "_fail");
    try w(out, "fr");
    try wi(out, dst);
    try wl(out, "_fail:");
    try render_fs_read_propagate(out, code, index, dst, abi);
    try w(out, "fr");
    try wi(out, dst);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.bool %fr");
    try wi(out, dst);
    try wl(out, ", 1");
    return;
}

// render_fs_metadata emits 'try std::fs::metadata(io, path)': it mirrors
// render_fs_exists but the runtime returns a '%kizu.error.metadata' union and the
// cont block extracts the '%kizu.fs.metadata' aggregate into the result value (a
// later FS_METADATA_FIELD reads its size / is_dir fields).
fn render_fs_metadata(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let io_value = try code.get(index + 2);
    let path_value = try code.get(index + 3);
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, " = call %kizu.error.metadata @kizu_rt_fs_metadata(%kizu.owned %v");
    try wi(out, io_value);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, path_value);
    try wl(out, ")");
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, "_ok = extractvalue %kizu.error.metadata %fr");
    try wi(out, dst);
    try wl(out, ", 0");
    try w(out, "  br i1 %fr");
    try wi(out, dst);
    try w(out, "_ok, label %fr");
    try wi(out, dst);
    try w(out, "_cont, label %fr");
    try wi(out, dst);
    try wl(out, "_fail");
    try w(out, "fr");
    try wi(out, dst);
    try wl(out, "_fail:");
    try render_fs_read_propagate(out, code, index, dst, abi);
    try w(out, "fr");
    try wi(out, dst);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.metadata %fr");
    try wi(out, dst);
    try wl(out, ", 1");
    return;
}

// render_fs_metadata_field reads one field of a '%kizu.fs.metadata' value into the
// result value: field 0 (size) is an i64, field 1 (is_dir) an i1, both straight
// out of the aggregate SSA value.
fn render_fs_metadata_field(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let src = try code.get(index + 2);
    let field_index = try code.get(index + 3);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.fs.metadata %v");
    try wi(out, src);
    try w(out, ", ");
    try wi(out, field_index);
    try nl(out);
    return;
}

// render_fs_create_dir emits 'try std::fs::create_dir(io, path)' as a statement:
// call the runtime create, extract the ok flag, and branch into a fail block that
// propagates the error by the surrounding ABI or a cont block that resumes the
// body. The '%tc' temp prefix matches TRY_CALL's so render_try_propagate serves it.
fn render_fs_create_dir(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let io_value = try code.get(index + 1);
    let path_value = try code.get(index + 2);
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned %v");
    try wi(out, io_value);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, path_value);
    try wl(out, ")");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_propagate(out, code, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

fn render_mem_page_allocator(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    try w(out, "  %v");
    try wi(out, dst);
    try wl(out, " = call %kizu.owned @kizu_rt_mem_page_allocator()");
    return;
}

fn render_storage_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let allocator = try code.get(index + 3);
    let element_size = try code.get(index + 4);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.owned @");
    let symbol = storage_new_symbol(kind);
    try w(out, symbol);
    try w(out, "(%kizu.owned %v");
    try wi(out, allocator);
    let needs_size = storage_new_needs_size(kind);
    if needs_size {
        try w(out, ", i64 ");
        try wi(out, element_size);
    }
    try wl(out, ")");
    return;
}

fn storage_new_symbol(kind: i64) -> []u8 {
    if kind == codegen::code_kind_owned_string() {
        return "kizu_rt_string_new";
    }
    if codegen::code_kind_is_owned_array(kind) {
        return "kizu_rt_array_new";
    }
    if codegen::code_kind_is_owned_map(kind) {
        return "kizu_rt_map_new";
    }
    return "kizu_rt_arena_new";
}

fn storage_new_needs_size(kind: i64) -> bool {
    if codegen::code_kind_is_owned_array(kind) {
        return true;
    }
    return codegen::code_kind_is_arena(kind);
}

fn render_storage_deinit(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let receiver = try code.get(index + 1);
    let kind = try code.get(index + 2);
    try w(out, "  call void @");
    let symbol = storage_deinit_symbol(kind);
    try w(out, symbol);
    try w(out, "(%kizu.owned %v");
    try wi(out, receiver);
    try wl(out, ")");
    return;
}

fn render_error_cleanup(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    current_index: i64
) -> !void {
    let body_start = try tape_current_body_start(code, current_index, 0, 0);
    try render_error_cleanup_before(out, code, body_start, current_index, current_index);
    return;
}

fn render_error_cleanup_before(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    lower: i64,
    upper: i64,
    current_index: i64
) -> !void {
    let none = 0 - 1;
    let last = try last_active_error_cleanup_before(code, lower, upper, current_index, lower, none);
    if last < 0 {
        return;
    }
    try render_storage_deinit(out, code, last);
    try render_error_cleanup_before(out, code, lower, last, current_index);
    return;
}

fn last_active_error_cleanup_before(
    code: &std::array::Array<i64>,
    lower: i64,
    upper: i64,
    current_index: i64,
    scan: i64,
    best: i64
) -> !i64 {
    if scan >= upper {
        return best;
    }
    let op = try code.get(scan);
    let next = try tape_record_end(code, scan);
    if code_op_is_error_cleanup_deinit(op) {
        let active = try cleanup_deinit_active_at(code, scan, current_index, next);
        if active {
            return try last_active_error_cleanup_before(code, lower, upper, current_index, next, scan);
        }
    }
    return try last_active_error_cleanup_before(code, lower, upper, current_index, next, best);
}

fn code_op_is_error_cleanup_deinit(op: i64) -> bool {
    let defer_deinit = codegen::code_op_defer_deinit();
    if op == defer_deinit {
        return true;
    }
    let errdefer_deinit = codegen::code_op_errdefer_deinit();
    return op == errdefer_deinit;
}

fn cleanup_deinit_active_at(
    code: &std::array::Array<i64>,
    record_index: i64,
    current_index: i64,
    scan: i64
) -> !bool {
    if scan >= current_index {
        return true;
    }
    let op = try code.get(scan);
    let next = try tape_record_end(code, scan);
    let scope_end = codegen::code_op_errdefer_scope_end();
    if op == scope_end {
        let lower_bound = try code.get(scan + 1);
        if record_index >= lower_bound {
            return false;
        }
    }
    return try cleanup_deinit_active_at(code, record_index, current_index, next);
}

fn tape_current_body_start(
    code: &std::array::Array<i64>,
    target_index: i64,
    scan: i64,
    best: i64
) -> !i64 {
    if scan >= target_index {
        return best;
    }
    let op = try code.get(scan);
    let next = try tape_record_end(code, scan);
    let func_begin = codegen::code_op_func_begin();
    if op == func_begin {
        let body_start = scan + 6;
        return try tape_current_body_start(code, target_index, next, body_start);
    }
    let method_func_begin = codegen::code_op_method_func_begin();
    if op == method_func_begin {
        let body_start = scan + 8;
        return try tape_current_body_start(code, target_index, next, body_start);
    }
    return try tape_current_body_start(code, target_index, next, best);
}

fn render_arena_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let allocator = try code.get(index + 2);
    let element_size = try code.get(index + 3);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.owned @kizu_rt_arena_new(%kizu.owned %v");
    try wi(out, allocator);
    try w(out, ", i64 ");
    try wi(out, element_size);
    try wl(out, ")");
    return;
}

fn render_arena_deinit(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let receiver = try code.get(index + 1);
    try w(out, "  call void @kizu_rt_arena_deinit(%kizu.owned %v");
    try wi(out, receiver);
    try wl(out, ")");
    return;
}

fn storage_deinit_symbol(kind: i64) -> []u8 {
    if kind == codegen::code_kind_owned_string() {
        return "kizu_rt_string_deinit";
    }
    if codegen::code_kind_is_owned_array(kind) {
        return "kizu_rt_array_deinit";
    }
    if codegen::code_kind_is_owned_map(kind) {
        return "kizu_rt_map_deinit";
    }
    if codegen::code_kind_is_owned_box(kind) {
        return "kizu_rt_box_deinit";
    }
    return "kizu_rt_arena_deinit";
}

fn render_box_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let allocator = try code.get(index + 2);
    let value = try code.get(index + 3);
    try w(out, "  %bn");
    try wi(out, index);
    try wl(out, "_slot = alloca i64");
    try w(out, "  store i64 %v");
    try wi(out, value);
    try w(out, ", ptr %bn");
    try wi(out, index);
    try wl(out, "_slot");
    try w(out, "  %bn");
    try wi(out, index);
    try w(out, "_payload_base = insertvalue %kizu.slice.u8 poison, ptr %bn");
    try wi(out, index);
    try wl(out, "_slot, 0");
    try w(out, "  %bn");
    try wi(out, index);
    try w(out, "_payload = insertvalue %kizu.slice.u8 %bn");
    try wi(out, index);
    try wl(out, "_payload_base, i64 8, 1");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.error.owned @kizu_rt_box_new(%kizu.owned %v");
    try wi(out, allocator);
    try w(out, ", %kizu.slice.u8 %bn");
    try wi(out, index);
    try wl(out, "_payload)");
    return;
}

fn render_try_box_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let source = try code.get(index + 2);
    try w(out, "  %tb");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.owned %v");
    try wi(out, source);
    try wl(out, ", 0");
    try w(out, "  br i1 %tb");
    try wi(out, index);
    try w(out, "_ok, label %tb");
    try wi(out, index);
    try w(out, "_cont, label %tb");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tb");
    try wi(out, index);
    try wl(out, "_fail:");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.owned %v");
    try wi(out, source);
    try wl(out, ", 2");
    try render_runtime_message_propagate(out, code, index, abi);
    try w(out, "tb");
    try wi(out, index);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.owned %v");
    try wi(out, source);
    try wl(out, ", 1");
    return;
}

fn render_box_borrow_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let receiver = try code.get(index + 2);
    try w(out, "  %bb");
    try wi(out, index);
    try w(out, " = call %kizu.error.slice.u8 @kizu_rt_box_borrow(%kizu.owned %v");
    try wi(out, receiver);
    try wl(out, ")");
    try w(out, "  %bb");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.slice.u8 %bb");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %bb");
    try wi(out, index);
    try w(out, "_ok, label %bb");
    try wi(out, index);
    try w(out, "_cont, label %bb");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "bb");
    try wi(out, index);
    try wl(out, "_fail:");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.slice.u8 %bb");
    try wi(out, index);
    try wl(out, ", 2");
    try render_runtime_message_propagate(out, code, index, abi);
    try w(out, "bb");
    try wi(out, index);
    try wl(out, "_cont:");
    try w(out, "  %bb");
    try wi(out, index);
    try w(out, "_slice = extractvalue %kizu.error.slice.u8 %bb");
    try wi(out, index);
    try wl(out, ", 1");
    try w(out, "  %bb");
    try wi(out, index);
    try w(out, "_ptr = extractvalue %kizu.slice.u8 %bb");
    try wi(out, index);
    try wl(out, "_slice, 0");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i64, ptr %bb");
    try wi(out, index);
    try wl(out, "_ptr");
    return;
}

fn render_runtime_message_propagate(
    out: &var std::string::String,
