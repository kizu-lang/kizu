fn render_try_array_append_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let element_kind = codegen::code_kind_i64();
    try render_try_array_append_kind(out, code, index, abi, element_kind);
    return;
}

fn render_try_array_append(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let element_kind = try code.get(index + 3);
    try render_try_array_append_kind(out, code, index, abi, element_kind);
    return;
}

fn render_try_array_append_kind(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    element_kind: i64
) -> !void {
    let receiver = try code.get(index + 1);
    let value = try code.get(index + 2);
    try render_array_append_slot(out, index, value, element_kind);
    try w(out, "  %aa");
    try wi(out, index);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr %aa");
    try wi(out, index);
    try wl(out, "_slot, 0");
    try w(out, "  %aa");
    try wi(out, index);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %aa");
    try wi(out, index);
    try w(out, "_base, i64 ");
    let element_size = array_element_size(element_kind);
    try wi(out, element_size);
    try wl(out, ", 1");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_rt_array_append(%kizu.owned %v");
    try wi(out, receiver);
    try w(out, ", %kizu.slice.u8 %aa");
    try wi(out, index);
    try wl(out, "_slice)");
    try render_try_void_result(out, index, abi);
    return;
}

fn render_array_append_slot(out: &var std::string::String, index: i64, value: i64, element_kind: i64) -> !void {
    if element_kind == codegen::code_kind_bool() {
        try w(out, "  %aa");
        try wi(out, index);
        try w(out, "_byte = zext i1 %v");
        try wi(out, value);
        try wl(out, " to i8");
        try w(out, "  %aa");
        try wi(out, index);
        try wl(out, "_slot = alloca i8");
        try w(out, "  store i8 %aa");
        try wi(out, index);
        try w(out, "_byte, ptr %aa");
        try wi(out, index);
        try wl(out, "_slot");
    }
    if element_kind == codegen::code_kind_i64() {
        try w(out, "  %aa");
        try wi(out, index);
        try wl(out, "_slot = alloca i64");
        try w(out, "  store i64 %v");
        try wi(out, value);
        try w(out, ", ptr %aa");
        try wi(out, index);
        try wl(out, "_slot");
    }
    if element_kind == codegen::code_kind_slice() {
        try w(out, "  %aa");
        try wi(out, index);
        try wl(out, "_slot = alloca %kizu.slice.u8");
        try w(out, "  store %kizu.slice.u8 %v");
        try wi(out, value);
        try w(out, ", ptr %aa");
        try wi(out, index);
        try wl(out, "_slot");
    }
    return;
}

fn array_element_size(element_kind: i64) -> i64 {
    if element_kind == codegen::code_kind_bool() {
        return 1;
    }
    if element_kind == codegen::code_kind_slice() {
        return 16;
    }
    return 8;
}

fn render_try_void_result(out: &var std::string::String, index: i64, abi: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_propagate(out, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

fn render_array_get_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let element_kind = codegen::code_kind_i64();
    try render_array_get_kind(out, code, index, element_kind);
    return;
}

fn render_array_get(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let element_kind = try code.get(index + 4);
    try render_array_get_kind(out, code, index, element_kind);
    return;
}

fn render_array_get_kind(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    element_kind: i64
) -> !void {
    let dst = try code.get(index + 1);
    let receiver = try code.get(index + 2);
    let item_index = try code.get(index + 3);
    try w(out, "  %ag");
    try wi(out, dst);
    try w(out, " = call %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned %v");
    try wi(out, receiver);
    try w(out, ", i64 %v");
    try wi(out, item_index);
    try wl(out, ")");
    try w(out, "  %ag");
    try wi(out, dst);
    try w(out, "_ok = extractvalue %kizu.error.slice.u8 %ag");
    try wi(out, dst);
    try wl(out, ", 0");
    try w(out, "  br i1 %ag");
    try wi(out, dst);
    try w(out, "_ok, label %ag");
    try wi(out, dst);
    try w(out, "_cont, label %ag");
    try wi(out, dst);
    try wl(out, "_fail");
    try w(out, "ag");
    try wi(out, dst);
    try wl(out, "_fail:");
    try w(out, "  %ag");
    try wi(out, dst);
    try w(out, "_msg = extractvalue %kizu.error.slice.u8 %ag");
    try wi(out, dst);
    try wl(out, ", 2");
    try w(out, "  call void @kizu_rt_trap(%kizu.slice.u8 %ag");
    try wi(out, dst);
    try wl(out, "_msg)");
    try wl(out, "  unreachable");
    try w(out, "ag");
    try wi(out, dst);
    try wl(out, "_cont:");
    try w(out, "  %ag");
    try wi(out, dst);
    try w(out, "_slice = extractvalue %kizu.error.slice.u8 %ag");
    try wi(out, dst);
    try wl(out, ", 1");
    try w(out, "  %ag");
    try wi(out, dst);
    try w(out, "_ptr = extractvalue %kizu.slice.u8 %ag");
    try wi(out, dst);
    try wl(out, "_slice, 0");
    try render_array_get_load(out, dst, dst, element_kind);
    return;
}

fn render_array_get_load(out: &var std::string::String, value_id: i64, temp_id: i64, element_kind: i64) -> !void {
    if element_kind == codegen::code_kind_bool() {
        try w(out, "  %ag");
        try wi(out, temp_id);
        try w(out, "_byte = load i8, ptr %ag");
        try wi(out, temp_id);
        try wl(out, "_ptr");
        try w(out, "  %v");
        try wi(out, value_id);
        try w(out, " = icmp ne i8 %ag");
        try wi(out, temp_id);
        try wl(out, "_byte, 0");
    }
    if element_kind == codegen::code_kind_i64() {
        try w(out, "  %v");
        try wi(out, value_id);
        try w(out, " = load i64, ptr %ag");
        try wi(out, temp_id);
        try wl(out, "_ptr");
    }
    if element_kind == codegen::code_kind_slice() {
        try w(out, "  %v");
        try wi(out, value_id);
        try w(out, " = load %kizu.slice.u8, ptr %ag");
        try wi(out, temp_id);
        try wl(out, "_ptr");
    }
    return;
}

fn render_try_array_get_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let element_kind = codegen::code_kind_i64();
    try render_try_array_get_i64_kind(out, code, index, abi, element_kind);
    return;
}

