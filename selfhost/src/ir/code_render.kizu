import selfhost::ir::codegen;
import selfhost::types::constructor_facts;

// Run codegen IR v1 renderer: walk the flat function-block-instruction tape
// (the Array<i64> records lower_code_module emits, with the run source text for
// string/name spans) and produce the run artifact LLVM module text.
//
// The renderer is the generic counterpart of the old per-shape hosted renderers:
// it iterates the tape opcodes instead of matching a fixed Program shape. Every
// value id names an SSA temp '%v<id>'; CONST_STR payloads become module globals
// '@.kizu.run.s<id>'; PRINT dispatches on the recorded value kind to the string
// or i64 writer.
//
// The cluster is written to compile into stage2 through the generic compiled-MIR
// subset: opcode constants are bound to locals before they are compared (no call
// in a condition), control flow uses early-return guards and tail recursion (no
// loop-carried scalars), and i64 formatting uses the local recursive wi helper
// rather than the std::fmt String builder. Kizu string literals do not interpret
// backslash escapes, so every emitted line is written through wl (bytes then a
// real newline byte) and partial fragments through w; quote/newline bytes are
// appended as explicit byte values.

pub fn render_tape_module(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>
) -> !std::string::String {
    var out = std::string::String(allocator);
    try render_preamble(&var out, source_path);
    try render_string_globals(&var out, text, code, 0);
    try render_functions(&var out, text, code, kinds, 0);
    try render_main_wrapper(&var out);
    return out;
}

// render_run_artifact is the generic run pipeline entry: it lowers a parsed run
// source into the run codegen IR v1 tape (codegen::lower_code_module) and renders
// that tape to the executable LLVM module text. It replaces the per-shape hosted
// renderers -- a single tape walk handles any program the lowering accepts.
pub fn render_run_artifact(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    parsed: std::kizu::ast::ParseResult,
    constructor_identities: &constructor_facts::ConstructorFacts,
    atomic_constructor_id: i64,
    bool_type_id: i64
) -> !std::string::String {
    let rendered = try render_run_ast_artifact(
        allocator,
        source_path,
        text,
        parsed.ast,
        parsed.root,
        constructor_identities,
        atomic_constructor_id,
        bool_type_id
    );
    return rendered;
}

pub fn render_run_ast_artifact(
    allocator: Allocator,
    source_path: []u8,
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    constructor_identities: &constructor_facts::ConstructorFacts,
    atomic_constructor_id: i64,
    bool_type_id: i64
) -> !std::string::String {
    var code = std::array::Array<i64>(allocator);
    var kinds = std::array::Array<i64>(allocator);
    var local_starts = std::array::Array<i64>(allocator);
    var local_ends = std::array::Array<i64>(allocator);
    var local_values = std::array::Array<i64>(allocator);
    var args_scratch = std::array::Array<i64>(allocator);
    var defer_records = std::array::Array<i64>(allocator);
    let eval = try codegen::lower_code_module(
        text,
        ast,
        root,
        constructor_identities,
        atomic_constructor_id,
        bool_type_id,
        &var code,
        &var kinds,
        &var local_starts,
        &var local_ends,
        &var local_values,
        &var args_scratch,
        &var defer_records
    );
    if !eval.ok {
        return error("render run artifact: run source lowering not supported");
    }
    let rendered = try render_tape_module(allocator, source_path, text, &code, &kinds);
    return rendered;
}

// render_bool_print_global emits one of the bool print payload globals
// ('true'/'false' plus a newline byte) behind its constant header.
fn render_bool_print_global(
    out: &var std::string::String,
    header: []u8,
    word: []u8
) -> !void {
    try w(out, header);
    try out.append_byte(cast<u8>(34));
    try w(out, word);
    try w(out, "\0A");
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

// expect_fail_message is the runtime expectation-failure line
// std::testing::expect traps with (matching the reference compiler's message).
fn expect_fail_message() -> []u8 {
    return "error: runtime error: expected condition to be true";
}

// render_expect_fail_global emits the expectation-failure message global the
// EXPECT fail blocks point their trap slice at (message plus a newline byte).
fn render_expect_fail_global(out: &var std::string::String) -> !void {
    let message = expect_fail_message();
    let message_len = std::mem::len(message);
    let payload_len = message_len + 1;
    try w(out, "@.kizu.run.expect_fail = private unnamed_addr constant [");
    try wi(out, payload_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try w(out, message);
    try w(out, "\0A");
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

// w appends a fragment with no trailing newline.
fn w(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    return;
}

// wl appends a full line plus a real newline byte.
fn wl(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}

// wr appends a positioned token 'prefix<index>suffix' with no trailing newline. It
// compresses the per-token register/label emits the path renderers share, where
// every name embeds the record index for uniqueness.
fn wr(
    out: &var std::string::String,
    prefix: []u8,
    index: i64,
    suffix: []u8
) -> !void {
    try w(out, prefix);
    try wi(out, index);
    try w(out, suffix);
    return;
}

// wrl is wr plus a trailing newline.
fn wrl(
    out: &var std::string::String,
    prefix: []u8,
    index: i64,
    suffix: []u8
) -> !void {
    try wr(out, prefix, index, suffix);
    try nl(out);
    return;
}

// nl appends a single newline byte.
fn nl(out: &var std::string::String) -> !void {
    try out.append_byte(cast<u8>(10));
    return;
}

// wi appends a non-negative i64 as decimal digits. The renderer only emits
// non-negative ids/spans/literals, so a most-significant-first recursive digit
// walk (each frame appends one digit byte) avoids the std::fmt String builder,
// which is outside the compiled-MIR subset this cluster lowers through.
fn wi(out: &var std::string::String, value: i64) -> !void {
    // Emit the high-order digits first by recursing on value/10 when there is a
    // carry, then append this frame's least-significant digit. Written without an
    // early return so the body stays a single fall-through path the compiled-MIR
    // void then-body lowering models (the renderer compiles into stage2).
    if value >= 10 {
        let high = value / 10;
        try wi(out, high);
    }
    let tens = value / 10;
    let digit = value - tens * 10;
    let digit_byte = cast<u8>(48 + digit);
    try out.append_byte(digit_byte);
    return;
}

fn render_preamble(out: &var std::string::String, source_path: []u8) -> !void {
    try wl(out, "; kizu codegen run artifact ll v1");
    try w(out, "source_filename = ");
    try out.append_byte(cast<u8>(34));
    try w(out, source_path);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    try nl(out);
    try wl(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try wl(out, "%kizu.owned = type { ptr }");
    try wl(out, "%kizu.handle = type { ptr, i64 }");
    try wl(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try wl(out, "%kizu.error.i64 = type { i1, i64, %kizu.slice.u8 }");
    try wl(out, "%kizu.error.bool = type { i1, i1, %kizu.slice.u8 }");
    try wl(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try wl(out, "%kizu.fs.metadata = type { i64, i1 }");
    try wl(out, "%kizu.error.metadata = type { i1, %kizu.fs.metadata, %kizu.slice.u8 }");
    try wl(out, "%kizu.error.owned = type { i1, %kizu.owned, %kizu.slice.u8 }");
    try wl(out, "%kizu.run.union = type { i64, i64, %kizu.slice.u8 }");
    try wl(out, "%kizu.error.union.void = type { i1, %kizu.run.union }");
    try wl(out, "%kizu.error.union.i64 = type { i1, i64, %kizu.run.union }");
    try wl(out, "%kizu.rt.array = type { ptr, ptr, i64, i64, i64 }");
    try wl(out, "%kizu.rt.string = type { ptr, ptr, i64, i64 }");
    try wl(out, "%kizu.rt.map = type { ptr, i64, ptr, i64, i64, ptr, i64, i64 }");
    try wl(out, "%kizu.rt.box = type { ptr, ptr, i64 }");
    try nl(out);
    try wl(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try wl(out, "declare ptr @kizu_rt_alloc(ptr, i64)");
    try wl(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try wl(out, "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.bool @kizu_rt_fs_exists(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.metadata @kizu_rt_fs_metadata(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.owned @kizu_rt_string_new(%kizu.owned)");
    try wl(out, "declare %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned, i8)");
    try wl(out, "declare %kizu.error.void @kizu_rt_string_reserve(%kizu.owned, i64)");
    try wl(out, "declare %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned)");
    try wl(out, "declare i64 @kizu_rt_string_len(%kizu.owned)");
    try wl(out, "declare void @kizu_rt_string_deinit(%kizu.owned)");
    try wl(out, "declare %kizu.owned @kizu_rt_array_new(%kizu.owned, i64)");
    try wl(out, "declare %kizu.error.void @kizu_rt_array_append(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare i64 @kizu_rt_array_len(%kizu.owned)");
    try wl(out, "declare %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned, i64)");
    try wl(out, "declare void @kizu_rt_array_deinit(%kizu.owned)");
    try wl(out, "declare %kizu.owned @kizu_rt_map_new(%kizu.owned)");
    try wl(out, "declare %kizu.error.void @kizu_rt_map_insert(%kizu.owned, %kizu.slice.u8, i64)");
    try wl(out, "declare i1 @kizu_rt_map_contains(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.i64 @kizu_rt_map_get_i64(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare void @kizu_rt_map_deinit(%kizu.owned)");
    try wl(out, "declare %kizu.error.owned @kizu_rt_box_new(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.slice.u8 @kizu_rt_box_borrow(%kizu.owned)");
    try wl(out, "declare void @kizu_rt_box_deinit(%kizu.owned)");
    try wl(out, "declare %kizu.owned @kizu_rt_arena_new(%kizu.owned, i64)");
    try wl(out, "declare %kizu.handle @kizu_rt_arena_add(%kizu.owned, %kizu.slice.u8)");
    try wl(out, "declare %kizu.error.slice.u8 @kizu_rt_arena_get(%kizu.owned, %kizu.handle)");
    try wl(out, "declare void @kizu_rt_arena_deinit(%kizu.owned)");
    try wl(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try wl(out, "declare void @kizu_rt_trap(%kizu.slice.u8)");
    try wl(out, "declare void @kizu_host_init(i32, ptr)");
    try nl(out);
    try wl(out, "@.kizu.run.newline = private unnamed_addr constant [1 x i8] [i8 10]");
    try wl(out, "@.kizu.run.path_dot = private unnamed_addr constant [1 x i8] [i8 46]");
    try wl(out, "@.kizu.run.true_word = private unnamed_addr constant [4 x i8] [i8 116, i8 114, i8 117, i8 101]");
    try wl(out, "@.kizu.run.false_word = private unnamed_addr constant [5 x i8] [i8 102, i8 97, i8 108, i8 115, i8 101]");
    try render_bool_print_global(out, "@.kizu.run.bool_true = private unnamed_addr constant [5 x i8] c", "true");
    try render_bool_print_global(out, "@.kizu.run.bool_false = private unnamed_addr constant [6 x i8] c", "false");
    try render_expect_fail_global(out);
    try w(out, "@.kizu.run.string_truncate_oob = private unnamed_addr constant [36 x i8] c");
    try out.append_byte(cast<u8>(34));
    try w(out, "String.truncate length out of bounds");
    try out.append_byte(cast<u8>(34));
    try nl(out);
    try nl(out);
    try render_i64_decimal_helper(out);
    try render_string_format_helpers(out);
    try render_path_string_helpers(out);
    return;
}

// render_i64_decimal_helper emits @kizu_run_i64_decimal: format an i64 into a
// page-allocated 20-byte buffer and return the trimmed decimal slice. It backs the
// PRINT path for i64 values.
fn render_i64_decimal_helper(out: &var std::string::String) -> !void {
    try wl(out, "define %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try wl(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try wl(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 20)");
    try wl(out, "  %allocated = icmp ne ptr %buffer, null");
    try wl(out, "  br i1 %allocated, label %check_zero, label %alloc_failed");
    try wl(out, "check_zero:");
    try wl(out, "  %is_zero = icmp eq i64 %value, 0");
    try wl(out, "  br i1 %is_zero, label %zero, label %nonzero");
    try wl(out, "zero:");
    try wl(out, "  %zero_ptr = getelementptr i8, ptr %buffer, i64 19");
    try wl(out, "  store i8 48, ptr %zero_ptr");
    try wl(out, "  br label %finish_zero");
    try wl(out, "nonzero:");
    try wl(out, "  %is_negative = icmp slt i64 %value, 0");
    try wl(out, "  br i1 %is_negative, label %negative, label %positive");
    try wl(out, "negative:");
    try wl(out, "  br label %loop");
    try wl(out, "positive:");
    try wl(out, "  %positive_current = sub i64 0, %value");
    try wl(out, "  br label %loop");
    try wl(out, "loop:");
    try wl(out, "  %current = phi i64 [ %value, %negative ], [ %positive_current, %positive ], [ %quotient, %loop ]");
    try wl(out, "  %write_index = phi i64 [ 19, %negative ], [ 19, %positive ], [ %next_index, %loop ]");
    try wl(out, "  %raw_digit = srem i64 %current, 10");
    try wl(out, "  %digit = sub i64 0, %raw_digit");
    try wl(out, "  %digit_byte_i64 = add i64 %digit, 48");
    try wl(out, "  %digit_byte = trunc i64 %digit_byte_i64 to i8");
    try wl(out, "  %digit_ptr = getelementptr i8, ptr %buffer, i64 %write_index");
    try wl(out, "  store i8 %digit_byte, ptr %digit_ptr");
    try wl(out, "  %quotient = sdiv i64 %current, 10");
    try wl(out, "  %next_index = sub i64 %write_index, 1");
    try wl(out, "  %done = icmp eq i64 %quotient, 0");
    try wl(out, "  br i1 %done, label %maybe_sign, label %loop");
    try wl(out, "maybe_sign:");
    try wl(out, "  br i1 %is_negative, label %write_sign, label %finish_loop");
    try wl(out, "write_sign:");
    try wl(out, "  %sign_ptr = getelementptr i8, ptr %buffer, i64 %next_index");
    try wl(out, "  store i8 45, ptr %sign_ptr");
    try wl(out, "  br label %finish_sign");
    try wl(out, "finish_zero:");
    try wl(out, "  br label %success");
    try wl(out, "finish_loop:");
    try wl(out, "  br label %success");
    try wl(out, "finish_sign:");
    try wl(out, "  br label %success");
    try wl(out, "success:");
    try wl(out, "  %start = phi i64 [ 19, %finish_zero ], [ %write_index, %finish_loop ], [ %next_index, %finish_sign ]");
    try wl(out, "  %len = sub i64 20, %start");
    try wl(out, "  %start_ptr = getelementptr i8, ptr %buffer, i64 %start");
    try wl(out, "  %slice_base = insertvalue %kizu.slice.u8 poison, ptr %start_ptr, 0");
    try wl(out, "  %slice = insertvalue %kizu.slice.u8 %slice_base, i64 %len, 1");
    try wl(out, "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try wl(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %slice, 1");
    try wl(out, "  ret %kizu.error.slice.u8 %result");
    try wl(out, "alloc_failed:");
    try wl(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try wl(out, "}");
    try nl(out);
    return;
}

fn render_string_format_helpers(out: &var std::string::String) -> !void {
    try wl(out, "define %kizu.error.void @kizu_run_string_append_i64(%kizu.owned %text, i64 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %decimal = call %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %value)");
    try wl(out, "  %ok = extractvalue %kizu.error.slice.u8 %decimal, 0");
    try wl(out, "  br i1 %ok, label %append, label %fail");
    try wl(out, "append:");
    try wl(out, "  %slice = extractvalue %kizu.error.slice.u8 %decimal, 1");
    try wl(out, "  %result = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %text, %kizu.slice.u8 %slice)");
    try wl(out, "  ret %kizu.error.void %result");
    try wl(out, "fail:");
    try wl(out, "  ret %kizu.error.void zeroinitializer");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_bool(%kizu.owned %text, i1 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %ptr = select i1 %value, ptr @.kizu.run.true_word, ptr @.kizu.run.false_word");
    try wl(out, "  %len = select i1 %value, i64 4, i64 5");
    try wl(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try wl(out, "  %slice = insertvalue %kizu.slice.u8 %base, i64 %len, 1");
    try wl(out, "  %result = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %text, %kizu.slice.u8 %slice)");
    try wl(out, "  ret %kizu.error.void %result");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define i8 @kizu_run_hex_digit(i8 %value) {");
    try wl(out, "entry:");
    try wl(out, "  %low = icmp ult i8 %value, 10");
    try wl(out, "  %num = add i8 %value, 48");
    try wl(out, "  %hex = add i8 %value, 55");
    try wl(out, "  %result = select i1 %low, i8 %num, i8 %hex");
    try wl(out, "  ret i8 %result");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 %second) {");
    try wl(out, "entry:");
    try wl(out, "  %first = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 92)");
    try wl(out, "  %first_ok = extractvalue %kizu.error.void %first, 0");
    try wl(out, "  br i1 %first_ok, label %append_second, label %fail");
    try wl(out, "append_second:");
    try wl(out, "  %result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 %second)");
    try wl(out, "  ret %kizu.error.void %result");
    try wl(out, "fail:");
    try wl(out, "  ret %kizu.error.void %first");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_double_escape_pair(%kizu.owned %text, i8 %second) {");
    try wl(out, "entry:");
    try wl(out, "  %first = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 92)");
    try wl(out, "  %first_ok = extractvalue %kizu.error.void %first, 0");
    try wl(out, "  br i1 %first_ok, label %append_pair, label %fail");
    try wl(out, "append_pair:");
    try wl(out, "  %result = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 %second)");
    try wl(out, "  ret %kizu.error.void %result");
    try wl(out, "fail:");
    try wl(out, "  ret %kizu.error.void %first");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_hex_escape(%kizu.owned %text, i8 %byte) {");
    try wl(out, "entry:");
    try wl(out, "  %high_nibble = lshr i8 %byte, 4");
    try wl(out, "  %low_nibble = and i8 %byte, 15");
    try wl(out, "  %high = call i8 @kizu_run_hex_digit(i8 %high_nibble)");
    try wl(out, "  %low = call i8 @kizu_run_hex_digit(i8 %low_nibble)");
    try wl(out, "  %slash = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 92)");
    try wl(out, "  %slash_ok = extractvalue %kizu.error.void %slash, 0");
    try wl(out, "  br i1 %slash_ok, label %write_x, label %slash_fail");
    try wl(out, "write_x:");
    try wl(out, "  %x = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 120)");
    try wl(out, "  %x_ok = extractvalue %kizu.error.void %x, 0");
    try wl(out, "  br i1 %x_ok, label %write_high, label %x_fail");
    try wl(out, "write_high:");
    try wl(out, "  %high_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 %high)");
    try wl(out, "  %high_ok = extractvalue %kizu.error.void %high_result, 0");
    try wl(out, "  br i1 %high_ok, label %write_low, label %high_fail");
    try wl(out, "write_low:");
    try wl(out, "  %low_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 %low)");
    try wl(out, "  ret %kizu.error.void %low_result");
    try wl(out, "slash_fail:");
    try wl(out, "  ret %kizu.error.void %slash");
    try wl(out, "x_fail:");
    try wl(out, "  ret %kizu.error.void %x");
    try wl(out, "high_fail:");
    try wl(out, "  ret %kizu.error.void %high_result");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_escaped_byte(%kizu.owned %text, i8 %byte) {");
    try wl(out, "entry:");
    try wl(out, "  %is_quote = icmp eq i8 %byte, 34");
    try wl(out, "  br i1 %is_quote, label %quote, label %check_backslash");
    try wl(out, "quote:");
    try wl(out, "  %quote_result = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 34)");
    try wl(out, "  ret %kizu.error.void %quote_result");
    try wl(out, "check_backslash:");
    try wl(out, "  %is_backslash = icmp eq i8 %byte, 92");
    try wl(out, "  br i1 %is_backslash, label %backslash, label %check_newline");
    try wl(out, "backslash:");
    try wl(out, "  %backslash_result = call %kizu.error.void @kizu_run_string_append_escape_pair(%kizu.owned %text, i8 92)");
    try wl(out, "  ret %kizu.error.void %backslash_result");
    try wl(out, "check_newline:");
    try wl(out, "  %is_newline = icmp eq i8 %byte, 10");
    try wl(out, "  br i1 %is_newline, label %newline, label %check_return");
    try wl(out, "newline:");
    try wl(out, "  %newline_result = call %kizu.error.void @kizu_run_string_append_double_escape_pair(%kizu.owned %text, i8 110)");
    try wl(out, "  ret %kizu.error.void %newline_result");
    try wl(out, "check_return:");
    try wl(out, "  %is_return = icmp eq i8 %byte, 13");
    try wl(out, "  br i1 %is_return, label %return_byte, label %check_tab");
    try wl(out, "return_byte:");
    try wl(out, "  %return_result = call %kizu.error.void @kizu_run_string_append_double_escape_pair(%kizu.owned %text, i8 114)");
    try wl(out, "  ret %kizu.error.void %return_result");
    try wl(out, "check_tab:");
    try wl(out, "  %is_tab = icmp eq i8 %byte, 9");
    try wl(out, "  br i1 %is_tab, label %tab, label %check_printable");
    try wl(out, "tab:");
    try wl(out, "  %tab_result = call %kizu.error.void @kizu_run_string_append_double_escape_pair(%kizu.owned %text, i8 116)");
    try wl(out, "  ret %kizu.error.void %tab_result");
    try wl(out, "check_printable:");
    try wl(out, "  %ge_space = icmp uge i8 %byte, 32");
    try wl(out, "  %le_tilde = icmp ule i8 %byte, 126");
    try wl(out, "  %printable = and i1 %ge_space, %le_tilde");
    try wl(out, "  br i1 %printable, label %plain, label %hex");
    try wl(out, "plain:");
    try wl(out, "  %plain_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 %byte)");
    try wl(out, "  ret %kizu.error.void %plain_result");
    try wl(out, "hex:");
    try wl(out, "  %hex_result = call %kizu.error.void @kizu_run_string_append_hex_escape(%kizu.owned %text, i8 %byte)");
    try wl(out, "  ret %kizu.error.void %hex_result");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.void @kizu_run_string_append_bytes_literal(%kizu.owned %text, %kizu.slice.u8 %bytes) {");
    try wl(out, "entry:");
    try wl(out, "  %open = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 34)");
    try wl(out, "  %open_ok = extractvalue %kizu.error.void %open, 0");
    try wl(out, "  br i1 %open_ok, label %loop, label %open_fail");
    try wl(out, "loop:");
    try wl(out, "  %ptr = extractvalue %kizu.slice.u8 %bytes, 0");
    try wl(out, "  %len = extractvalue %kizu.slice.u8 %bytes, 1");
    try wl(out, "  br label %loop_head");
    try wl(out, "loop_head:");
    try wl(out, "  %i = phi i64 [ 0, %loop ], [ %next, %step_ok ]");
    try wl(out, "  %done = icmp sge i64 %i, %len");
    try wl(out, "  br i1 %done, label %close, label %step");
    try wl(out, "step:");
    try wl(out, "  %byte_ptr = getelementptr i8, ptr %ptr, i64 %i");
    try wl(out, "  %byte = load i8, ptr %byte_ptr");
    try wl(out, "  %step_result = call %kizu.error.void @kizu_run_string_append_escaped_byte(%kizu.owned %text, i8 %byte)");
    try wl(out, "  %step_ok_flag = extractvalue %kizu.error.void %step_result, 0");
    try wl(out, "  br i1 %step_ok_flag, label %step_ok, label %step_fail");
    try wl(out, "step_ok:");
    try wl(out, "  %next = add i64 %i, 1");
    try wl(out, "  br label %loop_head");
    try wl(out, "close:");
    try wl(out, "  %close_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %text, i8 34)");
    try wl(out, "  ret %kizu.error.void %close_result");
    try wl(out, "open_fail:");
    try wl(out, "  ret %kizu.error.void %open");
    try wl(out, "step_fail:");
    try wl(out, "  ret %kizu.error.void %step_result");
    try wl(out, "}");
    try nl(out);
    return;
}

fn render_path_string_helpers(out: &var std::string::String) -> !void {
    try wl(out, "define i64 @kizu_run_path_parent_len(%kizu.owned %out, i1 %absolute) {");
    try wl(out, "entry:");
    try wl(out, "  %bytes = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %out)");
    try wl(out, "  %ptr = extractvalue %kizu.slice.u8 %bytes, 0");
    try wl(out, "  %len = extractvalue %kizu.slice.u8 %bytes, 1");
    try wl(out, "  %start = sub i64 %len, 1");
    try wl(out, "  br label %loop");
    try wl(out, "loop:");
    try wl(out, "  %i = phi i64 [ %start, %entry ], [ %prev, %step ]");
    try wl(out, "  %below_zero = icmp slt i64 %i, 0");
    try wl(out, "  br i1 %below_zero, label %none, label %check");
    try wl(out, "check:");
    try wl(out, "  %byte_ptr = getelementptr i8, ptr %ptr, i64 %i");
    try wl(out, "  %byte = load i8, ptr %byte_ptr");
    try wl(out, "  %is_slash = icmp eq i8 %byte, 47");
    try wl(out, "  br i1 %is_slash, label %found, label %step");
    try wl(out, "step:");
    try wl(out, "  %prev = sub i64 %i, 1");
    try wl(out, "  br label %loop");
    try wl(out, "found:");
    try wl(out, "  %at_root = icmp eq i64 %i, 0");
    try wl(out, "  %root_len = select i1 %absolute, i64 1, i64 0");
    try wl(out, "  %result = select i1 %at_root, i64 %root_len, i64 %i");
    try wl(out, "  ret i64 %result");
    try wl(out, "none:");
    try wl(out, "  ret i64 0");
    try wl(out, "}");
    try nl(out);
    try wl(out, "define %kizu.error.i64 @kizu_run_path_append_components(%kizu.owned %out, %kizu.slice.u8 %path, i1 %absolute, i64 %initial_depth) {");
    try wl(out, "entry:");
    try wl(out, "  %ptr = extractvalue %kizu.slice.u8 %path, 0");
    try wl(out, "  %len = extractvalue %kizu.slice.u8 %path, 1");
    try wl(out, "  br label %loop");
    try wl(out, "loop:");
    try wl(out, "  %index = phi i64 [ 0, %entry ], [ %seg_i, %dot_continue ], [ %seg_i, %pop_parent ], [ %seg_i, %leading_abs_continue ], [ %seg_i, %leading_done ], [ %seg_i, %normal_done ]");
    try wl(out, "  %depth = phi i64 [ %initial_depth, %entry ], [ %depth, %dot_continue ], [ %next_depth_pop, %pop_parent ], [ %depth, %leading_abs_continue ], [ %depth, %leading_done ], [ %next_depth_normal, %normal_done ]");
    try wl(out, "  %loop_done = icmp sge i64 %index, %len");
    try wl(out, "  br i1 %loop_done, label %success, label %skip_head");
    try wl(out, "skip_head:");
    try wl(out, "  %skip_i = phi i64 [ %index, %loop ], [ %skip_next, %skip_body ]");
    try wl(out, "  %skip_end = icmp sge i64 %skip_i, %len");
    try wl(out, "  br i1 %skip_end, label %success, label %skip_check");
    try wl(out, "skip_check:");
    try wl(out, "  %skip_ptr = getelementptr i8, ptr %ptr, i64 %skip_i");
    try wl(out, "  %skip_byte = load i8, ptr %skip_ptr");
    try wl(out, "  %skip_is_slash = icmp eq i8 %skip_byte, 47");
    try wl(out, "  br i1 %skip_is_slash, label %skip_body, label %segment_head");
    try wl(out, "skip_body:");
    try wl(out, "  %skip_next = add i64 %skip_i, 1");
    try wl(out, "  br label %skip_head");
    try wl(out, "segment_head:");
    try wl(out, "  %seg_i = phi i64 [ %skip_i, %skip_check ], [ %seg_next, %segment_body ]");
    try wl(out, "  %seg_end = icmp sge i64 %seg_i, %len");
    try wl(out, "  br i1 %seg_end, label %segment_done, label %segment_check");
    try wl(out, "segment_check:");
    try wl(out, "  %seg_ptr = getelementptr i8, ptr %ptr, i64 %seg_i");
    try wl(out, "  %seg_byte = load i8, ptr %seg_ptr");
    try wl(out, "  %seg_is_slash = icmp eq i8 %seg_byte, 47");
    try wl(out, "  br i1 %seg_is_slash, label %segment_done, label %segment_body");
    try wl(out, "segment_body:");
    try wl(out, "  %seg_next = add i64 %seg_i, 1");
    try wl(out, "  br label %segment_head");
    try wl(out, "segment_done:");
    try wl(out, "  %seg_len = sub i64 %seg_i, %skip_i");
    try wl(out, "  %len_is_one = icmp eq i64 %seg_len, 1");
    try wl(out, "  br i1 %len_is_one, label %check_dot, label %check_dotdot_len");
    try wl(out, "check_dot:");
    try wl(out, "  %dot_ptr = getelementptr i8, ptr %ptr, i64 %skip_i");
    try wl(out, "  %dot_byte = load i8, ptr %dot_ptr");
    try wl(out, "  %is_dot = icmp eq i8 %dot_byte, 46");
    try wl(out, "  br i1 %is_dot, label %dot_continue, label %normal");
    try wl(out, "dot_continue:");
    try wl(out, "  br label %loop");
    try wl(out, "check_dotdot_len:");
    try wl(out, "  %len_is_two = icmp eq i64 %seg_len, 2");
    try wl(out, "  br i1 %len_is_two, label %check_dotdot, label %normal");
    try wl(out, "check_dotdot:");
    try wl(out, "  %dd0_ptr = getelementptr i8, ptr %ptr, i64 %skip_i");
    try wl(out, "  %dd1_index = add i64 %skip_i, 1");
    try wl(out, "  %dd1_ptr = getelementptr i8, ptr %ptr, i64 %dd1_index");
    try wl(out, "  %dd0 = load i8, ptr %dd0_ptr");
    try wl(out, "  %dd1 = load i8, ptr %dd1_ptr");
    try wl(out, "  %dd0_ok = icmp eq i8 %dd0, 46");
    try wl(out, "  %dd1_ok = icmp eq i8 %dd1, 46");
    try wl(out, "  %is_dotdot = and i1 %dd0_ok, %dd1_ok");
    try wl(out, "  br i1 %is_dotdot, label %dotdot, label %normal");
    try wl(out, "dotdot:");
    try wl(out, "  %has_depth = icmp sgt i64 %depth, 0");
    try wl(out, "  br i1 %has_depth, label %pop_parent, label %leading_parent");
    try wl(out, "pop_parent:");
    try wl(out, "  %parent_len = call i64 @kizu_run_path_parent_len(%kizu.owned %out, i1 %absolute)");
    try wl(out, "  %out_raw = extractvalue %kizu.owned %out, 0");
    try wl(out, "  %len_field = getelementptr inbounds %kizu.rt.string, ptr %out_raw, i32 0, i32 2");
    try wl(out, "  store i64 %parent_len, ptr %len_field");
    try wl(out, "  %next_depth_pop = sub i64 %depth, 1");
    try wl(out, "  br label %loop");
    try wl(out, "leading_parent:");
    try wl(out, "  br i1 %absolute, label %leading_abs_continue, label %leading_append");
    try wl(out, "leading_abs_continue:");
    try wl(out, "  br label %loop");
    try wl(out, "leading_append:");
    try wl(out, "  %leading_before = call i64 @kizu_rt_string_len(%kizu.owned %out)");
    try wl(out, "  %leading_has_before = icmp sgt i64 %leading_before, 0");
    try wl(out, "  br i1 %leading_has_before, label %leading_sep, label %leading_segment");
    try wl(out, "leading_sep:");
    try wl(out, "  %leading_sep_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %out, i8 47)");
    try wl(out, "  %leading_sep_ok = extractvalue %kizu.error.void %leading_sep_result, 0");
    try wl(out, "  br i1 %leading_sep_ok, label %leading_segment, label %fail_leading_sep");
    try wl(out, "leading_segment:");
    try wl(out, "  %leading_seg_ptr = getelementptr i8, ptr %ptr, i64 %skip_i");
    try wl(out, "  %leading_seg_base = insertvalue %kizu.slice.u8 poison, ptr %leading_seg_ptr, 0");
    try wl(out, "  %leading_seg = insertvalue %kizu.slice.u8 %leading_seg_base, i64 %seg_len, 1");
    try wl(out, "  %leading_result = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %out, %kizu.slice.u8 %leading_seg)");
    try wl(out, "  %leading_ok = extractvalue %kizu.error.void %leading_result, 0");
    try wl(out, "  br i1 %leading_ok, label %leading_done, label %fail_leading_segment");
    try wl(out, "leading_done:");
    try wl(out, "  br label %loop");
    try wl(out, "normal:");
    try wl(out, "  %before = call i64 @kizu_rt_string_len(%kizu.owned %out)");
    try wl(out, "  %has_before = icmp sgt i64 %before, 0");
    try wl(out, "  %before_is_root = icmp eq i64 %before, 1");
    try wl(out, "  %absolute_root = and i1 %absolute, %before_is_root");
    try wl(out, "  %not_absolute_root = xor i1 %absolute_root, true");
    try wl(out, "  %need_sep = and i1 %has_before, %not_absolute_root");
    try wl(out, "  br i1 %need_sep, label %normal_sep, label %normal_segment");
    try wl(out, "normal_sep:");
    try wl(out, "  %sep_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %out, i8 47)");
    try wl(out, "  %sep_ok = extractvalue %kizu.error.void %sep_result, 0");
    try wl(out, "  br i1 %sep_ok, label %normal_segment, label %fail_sep");
    try wl(out, "normal_segment:");
    try wl(out, "  %normal_seg_ptr = getelementptr i8, ptr %ptr, i64 %skip_i");
    try wl(out, "  %normal_seg_base = insertvalue %kizu.slice.u8 poison, ptr %normal_seg_ptr, 0");
    try wl(out, "  %normal_seg = insertvalue %kizu.slice.u8 %normal_seg_base, i64 %seg_len, 1");
    try wl(out, "  %segment_result = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %out, %kizu.slice.u8 %normal_seg)");
    try wl(out, "  %segment_ok = extractvalue %kizu.error.void %segment_result, 0");
    try wl(out, "  br i1 %segment_ok, label %normal_done, label %fail_segment");
    try wl(out, "normal_done:");
    try wl(out, "  %next_depth_normal = add i64 %depth, 1");
    try wl(out, "  br label %loop");
    try wl(out, "success:");
    try wl(out, "  %ok_flag = insertvalue %kizu.error.i64 zeroinitializer, i1 true, 0");
    try wl(out, "  %ok_depth = insertvalue %kizu.error.i64 %ok_flag, i64 %depth, 1");
    try wl(out, "  ret %kizu.error.i64 %ok_depth");
    try wl(out, "fail_sep:");
    try wl(out, "  %sep_msg = extractvalue %kizu.error.void %sep_result, 1");
    try wl(out, "  %sep_fail = insertvalue %kizu.error.i64 zeroinitializer, %kizu.slice.u8 %sep_msg, 2");
    try wl(out, "  ret %kizu.error.i64 %sep_fail");
    try wl(out, "fail_segment:");
    try wl(out, "  %segment_msg = extractvalue %kizu.error.void %segment_result, 1");
    try wl(out, "  %segment_fail = insertvalue %kizu.error.i64 zeroinitializer, %kizu.slice.u8 %segment_msg, 2");
    try wl(out, "  ret %kizu.error.i64 %segment_fail");
    try wl(out, "fail_leading_sep:");
    try wl(out, "  %leading_sep_msg = extractvalue %kizu.error.void %leading_sep_result, 1");
    try wl(out, "  %leading_sep_fail = insertvalue %kizu.error.i64 zeroinitializer, %kizu.slice.u8 %leading_sep_msg, 2");
    try wl(out, "  ret %kizu.error.i64 %leading_sep_fail");
    try wl(out, "fail_leading_segment:");
    try wl(out, "  %leading_msg = extractvalue %kizu.error.void %leading_result, 1");
    try wl(out, "  %leading_fail = insertvalue %kizu.error.i64 zeroinitializer, %kizu.slice.u8 %leading_msg, 2");
    try wl(out, "  ret %kizu.error.i64 %leading_fail");
    try wl(out, "}");
    try nl(out);
    try render_path_clean_helper(out);
    try render_path_join_helper(out);
    return;
}

fn render_path_owned_success(out: &var std::string::String) -> !void {
    try wl(out, "success:");
    try wl(out, "  %ok_flag = insertvalue %kizu.error.owned zeroinitializer, i1 true, 0");
    try wl(out, "  %ok_owned = insertvalue %kizu.error.owned %ok_flag, %kizu.owned %out, 1");
    try wl(out, "  ret %kizu.error.owned %ok_owned");
    return;
}

fn render_path_dot_append(out: &var std::string::String) -> !void {
    try wl(out, "append_dot:");
    try wl(out, "  %dot_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.path_dot, 0");
    try wl(out, "  %dot_slice = insertvalue %kizu.slice.u8 %dot_base, i64 1, 1");
    try wl(out, "  %dot_result = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %out, %kizu.slice.u8 %dot_slice)");
    try wl(out, "  %dot_ok = extractvalue %kizu.error.void %dot_result, 0");
    try wl(out, "  br i1 %dot_ok, label %success, label %fail_dot");
    return;
}

fn render_path_owned_failures(out: &var std::string::String) -> !void {
    try wl(out, "fail_root:");
    try wl(out, "  %root_msg = extractvalue %kizu.error.void %root_result, 1");
    try wl(out, "  call void @kizu_rt_string_deinit(%kizu.owned %out)");
    try wl(out, "  %root_fail = insertvalue %kizu.error.owned zeroinitializer, %kizu.slice.u8 %root_msg, 2");
    try wl(out, "  ret %kizu.error.owned %root_fail");
    try wl(out, "fail_parts:");
    try wl(out, "  %parts_msg = extractvalue %kizu.error.i64 %parts, 2");
    try wl(out, "  call void @kizu_rt_string_deinit(%kizu.owned %out)");
    try wl(out, "  %parts_fail = insertvalue %kizu.error.owned zeroinitializer, %kizu.slice.u8 %parts_msg, 2");
    try wl(out, "  ret %kizu.error.owned %parts_fail");
    try wl(out, "fail_dot:");
    try wl(out, "  %dot_msg = extractvalue %kizu.error.void %dot_result, 1");
    try wl(out, "  call void @kizu_rt_string_deinit(%kizu.owned %out)");
    try wl(out, "  %dot_fail = insertvalue %kizu.error.owned zeroinitializer, %kizu.slice.u8 %dot_msg, 2");
    try wl(out, "  ret %kizu.error.owned %dot_fail");
    return;
}

fn render_path_clean_helper(out: &var std::string::String) -> !void {
    try wl(out, "define %kizu.error.owned @kizu_run_path_clean(%kizu.owned %allocator, %kizu.slice.u8 %path) {");
    try wl(out, "entry:");
    try wl(out, "  %out = call %kizu.owned @kizu_rt_string_new(%kizu.owned %allocator)");
    try wl(out, "  %len = extractvalue %kizu.slice.u8 %path, 1");
    try wl(out, "  %has_first = icmp sgt i64 %len, 0");
    try wl(out, "  br i1 %has_first, label %check_absolute, label %after_absolute");
    try wl(out, "check_absolute:");
    try wl(out, "  %ptr = extractvalue %kizu.slice.u8 %path, 0");
    try wl(out, "  %first_ptr = getelementptr i8, ptr %ptr, i64 0");
    try wl(out, "  %first = load i8, ptr %first_ptr");
    try wl(out, "  %first_slash = icmp eq i8 %first, 47");
    try wl(out, "  br label %after_absolute");
    try wl(out, "after_absolute:");
    try wl(out, "  %absolute = phi i1 [ %first_slash, %check_absolute ], [ false, %entry ]");
    try wl(out, "  br i1 %absolute, label %append_root, label %append_parts");
    try wl(out, "append_root:");
    try wl(out, "  %root_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %out, i8 47)");
    try wl(out, "  %root_ok = extractvalue %kizu.error.void %root_result, 0");
    try wl(out, "  br i1 %root_ok, label %append_parts, label %fail_root");
    try wl(out, "append_parts:");
    try wl(out, "  %parts = call %kizu.error.i64 @kizu_run_path_append_components(%kizu.owned %out, %kizu.slice.u8 %path, i1 %absolute, i64 0)");
    try wl(out, "  %parts_ok = extractvalue %kizu.error.i64 %parts, 0");
    try wl(out, "  br i1 %parts_ok, label %maybe_dot, label %fail_parts");
    try wl(out, "maybe_dot:");
    try wl(out, "  %out_len = call i64 @kizu_rt_string_len(%kizu.owned %out)");
    try wl(out, "  %out_empty = icmp eq i64 %out_len, 0");
    try wl(out, "  br i1 %out_empty, label %append_dot, label %success");
    try render_path_dot_append(out);
    try render_path_owned_success(out);
    try render_path_owned_failures(out);
    try wl(out, "}");
    try nl(out);
    return;
}

fn render_path_join_helper(out: &var std::string::String) -> !void {
    try wl(out, "define %kizu.error.owned @kizu_run_path_join(%kizu.owned %allocator, %kizu.slice.u8 %left, %kizu.slice.u8 %right) {");
    try wl(out, "entry:");
    try wl(out, "  %out = call %kizu.owned @kizu_rt_string_new(%kizu.owned %allocator)");
    try wl(out, "  %left_len = extractvalue %kizu.slice.u8 %left, 1");
    try wl(out, "  %left_nonempty = icmp sgt i64 %left_len, 0");
    try wl(out, "  br i1 %left_nonempty, label %left_absolute, label %right_absolute_gate");
    try wl(out, "left_absolute:");
    try wl(out, "  %left_ptr = extractvalue %kizu.slice.u8 %left, 0");
    try wl(out, "  %left_first_ptr = getelementptr i8, ptr %left_ptr, i64 0");
    try wl(out, "  %left_first = load i8, ptr %left_first_ptr");
    try wl(out, "  %left_slash = icmp eq i8 %left_first, 47");
    try wl(out, "  br label %after_absolute");
    try wl(out, "right_absolute_gate:");
    try wl(out, "  %right_len = extractvalue %kizu.slice.u8 %right, 1");
    try wl(out, "  %right_nonempty = icmp sgt i64 %right_len, 0");
    try wl(out, "  br i1 %right_nonempty, label %right_absolute, label %after_absolute");
    try wl(out, "right_absolute:");
    try wl(out, "  %right_ptr = extractvalue %kizu.slice.u8 %right, 0");
    try wl(out, "  %right_first_ptr = getelementptr i8, ptr %right_ptr, i64 0");
    try wl(out, "  %right_first = load i8, ptr %right_first_ptr");
    try wl(out, "  %right_slash = icmp eq i8 %right_first, 47");
    try wl(out, "  br label %after_absolute");
    try wl(out, "after_absolute:");
    try wl(out, "  %absolute = phi i1 [ %left_slash, %left_absolute ], [ %right_slash, %right_absolute ], [ false, %right_absolute_gate ]");
    try wl(out, "  br i1 %absolute, label %append_root, label %append_left");
    try wl(out, "append_root:");
    try wl(out, "  %root_result = call %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %out, i8 47)");
    try wl(out, "  %root_ok = extractvalue %kizu.error.void %root_result, 0");
    try wl(out, "  br i1 %root_ok, label %append_left, label %fail_root");
    try wl(out, "append_left:");
    try wl(out, "  %left_parts = call %kizu.error.i64 @kizu_run_path_append_components(%kizu.owned %out, %kizu.slice.u8 %left, i1 %absolute, i64 0)");
    try wl(out, "  %left_ok = extractvalue %kizu.error.i64 %left_parts, 0");
    try wl(out, "  br i1 %left_ok, label %append_right, label %fail_left");
    try wl(out, "append_right:");
    try wl(out, "  %left_depth = extractvalue %kizu.error.i64 %left_parts, 1");
    try wl(out, "  %parts = call %kizu.error.i64 @kizu_run_path_append_components(%kizu.owned %out, %kizu.slice.u8 %right, i1 %absolute, i64 %left_depth)");
    try wl(out, "  %parts_ok = extractvalue %kizu.error.i64 %parts, 0");
    try wl(out, "  br i1 %parts_ok, label %maybe_dot, label %fail_parts");
    try wl(out, "maybe_dot:");
    try wl(out, "  %out_len = call i64 @kizu_rt_string_len(%kizu.owned %out)");
    try wl(out, "  %out_empty = icmp eq i64 %out_len, 0");
    try wl(out, "  br i1 %out_empty, label %append_dot, label %success");
    try render_path_dot_append(out);
    try render_path_owned_success(out);
    try wl(out, "fail_left:");
    try wl(out, "  %left_msg = extractvalue %kizu.error.i64 %left_parts, 2");
    try wl(out, "  call void @kizu_rt_string_deinit(%kizu.owned %out)");
    try wl(out, "  %left_fail = insertvalue %kizu.error.owned zeroinitializer, %kizu.slice.u8 %left_msg, 2");
    try wl(out, "  ret %kizu.error.owned %left_fail");
    try render_path_owned_failures(out);
    try wl(out, "}");
    try nl(out);
    return;
}

// render_string_globals walks the tape and emits a private constant for every
// CONST_STR record's payload span (named '@.kizu.run.s<dst>'), every ENUM_CONST
// record's qualified variant span (named '@.kizu.run.e<dst>'), and every
// ENUM_DECL variant span (named '@.kizu.run.ed<record>v<tag>'). UNION_CONST
// records get no global: the print lowering rejects union values, so nothing
// references enum globals for them (lift both sides together if union printing
// ever lands).
fn render_string_globals(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    if index >= code.len() {
        return;
    }
    let op = try code.get(index);
    let const_str = codegen::code_op_const_str();
    let next = try tape_record_end(code, index);
    if op == const_str {
        try render_one_string_global(out, text, code, index);
    }
    let enum_const = codegen::code_op_enum_const();
    if op == enum_const {
        try render_one_enum_global(out, text, code, index);
    }
    let enum_decl = codegen::code_op_enum_decl();
    if op == enum_decl {
        try render_enum_decl_globals(out, text, code, index, 0);
    }
    try render_string_globals(out, text, code, next);
    return;
}

// render_one_enum_global emits the qualified 'Enum::Variant' source text the
// ENUM_CONST record at index spans, so print writes the variant name verbatim.
fn render_one_enum_global(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let qual_start = try code.get(index + 2);
    let qual_end = try code.get(index + 3);
    let payload = text[qual_start..qual_end];
    let byte_len = qual_end - qual_start;
    try w(out, "@.kizu.run.e");
    try wi(out, dst);
    try w(out, " = private unnamed_addr constant [");
    try wi(out, byte_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try render_llvm_c_bytes(out, payload);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

fn render_enum_decl_globals(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    record_pos: i64,
    index: i64
) -> !void {
    let count_pos = record_pos + 3;
    let variant_count = try code.get(count_pos);
    if index >= variant_count {
        return;
    }
    try render_one_enum_decl_global(out, text, code, record_pos, index);
    let after = index + 1;
    try render_enum_decl_globals(out, text, code, record_pos, after);
    return;
}

fn render_one_enum_decl_global(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    record_pos: i64,
    tag: i64
) -> !void {
    let enum_start = try code.get(record_pos + 1);
    let enum_end = try code.get(record_pos + 2);
    let entry_pos = enum_decl_variant_entry_pos(record_pos, tag);
    let var_start = try code.get(entry_pos);
    let name_end_pos = entry_pos + 1;
    let var_end = try code.get(name_end_pos);
    let enum_name = text[enum_start..enum_end];
    let variant_name = text[var_start..var_end];
    let enum_len = enum_end - enum_start;
    let variant_len = var_end - var_start;
    let byte_len = enum_len + 2 + variant_len;
    try w(out, "@.kizu.run.ed");
    try wi(out, record_pos);
    try w(out, "v");
    try wi(out, tag);
    try w(out, " = private unnamed_addr constant [");
    try wi(out, byte_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try render_llvm_c_bytes(out, enum_name);
    try w(out, "::");
    try render_llvm_c_bytes(out, variant_name);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

fn render_one_string_global(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let byte_len = try tape_const_str_payload_length(code, index);
    try w(out, "@.kizu.run.s");
    try wi(out, dst);
    try w(out, " = private unnamed_addr constant [");
    try wi(out, byte_len);
    try w(out, " x i8] c");
    try out.append_byte(cast<u8>(34));
    try render_const_str_segments(out, text, code, index);
    try out.append_byte(cast<u8>(34));
    try nl(out);
    return;
}

// render_const_str_segments renders every payload span segment of the CONST_STR
// record at index, joining consecutive segments with an escaped newline byte.
fn render_const_str_segments(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let seg_count = try code.get(index + 2);
    try render_const_str_segment(out, text, code, index, seg_count, 0);
    return;
}

// render_const_str_segment renders the segment at seg then recurses to the next,
// prefixing every segment after the first with an escaped newline byte.
fn render_const_str_segment(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    index: i64,
    seg_count: i64,
    seg: i64
) -> !void {
    if seg >= seg_count {
        return;
    }
    // Bind each span slot so the get() calls take locals rather than nested
    // binary args (the call-arg lowering only models 'base + <int literal>').
    let span_slots = seg * 2;
    let start_slot = index + 3 + span_slots;
    let end_slot = start_slot + 1;
    let seg_start = try code.get(start_slot);
    let seg_end = try code.get(end_slot);
    let payload = text[seg_start..seg_end];
    let newline = cast<u8>(10);
    if seg > 0 {
        try render_llvm_c_byte(out, newline);
    }
    try render_llvm_c_bytes(out, payload);
    let after = seg + 1;
    try render_const_str_segment(out, text, code, index, seg_count, after);
    return;
}

// render_functions walks the tape function by function: each FUNC_BEGIN..FUNC_END
// span renders one LLVM define ('main' is the kizu_run_main entry, every other
// function a kizu_run_user_<name> i64 define), then the walk resumes past FUNC_END.
fn render_functions(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !void {
    if index >= code.len() {
        return;
    }
    let after = try render_function_or_skip(out, text, code, kinds, index);
    try render_functions(out, text, code, kinds, after);
    return;
}

// render_function_or_skip renders the function whose FUNC_BEGIN is at index (or
// skips a stray non-function record) and returns the next tape index to walk from.
fn render_function_or_skip(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64
) -> !i64 {
    let op = try code.get(index);
    let func_begin = codegen::code_op_func_begin();
    if op == func_begin {
        return try render_one_function(out, text, code, kinds, index);
    }
    let method_func_begin = codegen::code_op_method_func_begin();
    if op == method_func_begin {
        return try render_one_method_function(out, text, code, kinds, index);
    }
    return try tape_record_end(code, index);
}

// render_one_function renders the function whose FUNC_BEGIN is at func_index and
// returns the tape index past its FUNC_END.
fn render_one_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    func_index: i64
) -> !i64 {
    let name_start = try code.get(func_index + 1);
    let name_end = try code.get(func_index + 2);
    let param_count = try code.get(func_index + 3);
    let ret_kind = try code.get(func_index + 4);
    let param_base = try code.get(func_index + 5);
    let name = text[name_start..name_end];
    let body_start = func_index + 6;
    let func_end = try tape_function_end(code, body_start);
    // Each renderer returns the tape index past its FUNC_END so this stays a pair of
    // single-statement early-return guards (the shape the compiled-MIR if-lowering
    // models), keeping render_one_function free of a multi-statement then-body.
    if std::mem::equal_bytes(name, "main") {
        return try render_main_function(out, text, code, kinds, body_start, func_end);
    }
    return try render_user_function(out, text, code, kinds, name, param_base, param_count, ret_kind, body_start, func_end);
}

fn render_one_method_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    func_index: i64
) -> !i64 {
    let type_start = try code.get(func_index + 1);
    let type_end = try code.get(func_index + 2);
    let name_start = try code.get(func_index + 3);
    let name_end = try code.get(func_index + 4);
    let param_count = try code.get(func_index + 5);
    let ret_kind = try code.get(func_index + 6);
    let param_base = try code.get(func_index + 7);
    let type_name = text[type_start..type_end];
    let name = text[name_start..name_end];
    let body_start = func_index + 8;
    let func_end = try tape_function_end(code, body_start);
    return try render_user_method_function(out, text, code, kinds, type_name, name, param_base, param_count, ret_kind, body_start, func_end);
}

// The return ABI selects how returns and try-propagations render: MAIN is the
// kizu_run_main i64 entry (a void return is exit 0, a try failure exits 1),
// USER_I64 is an ordinary i64-returning user define, and USER_ERR_VOID is a
// '%kizu.error.void'-returning user define (a void return is the ok union, a try
// failure returns the propagated error).
fn ret_abi_main() -> i64 {
    return 0;
}

fn ret_abi_user_i64() -> i64 {
    return 1;
}

fn ret_abi_user_err_void() -> i64 {
    return 2;
}

fn ret_abi_user_err_i64() -> i64 {
    return 3;
}

fn ret_abi_user_bool() -> i64 {
    return 4;
}

fn ret_abi_user_slice() -> i64 {
    return 5;
}

fn ret_abi_user_err_owned() -> i64 {
    return 6;
}

fn ret_abi_user_typed_error_void() -> i64 {
    return 7;
}

fn ret_abi_user_typed_error_i64() -> i64 {
    return 8;
}

fn return_kind_bool() -> i64 {
    return 900;
}

fn return_kind_slice() -> i64 {
    return 901;
}

// return_kind_owned_string_err mirrors codegen::code_return_kind_owned_string_err
// (902) as a code_render-local constant, like return_kind_bool/return_kind_slice
// above. Referencing the codegen accessor directly is a 'code_return_kind_'
// qualified callee the code_render closure does not whitelist (only code_op_/
// code_kind_/code_loop_kind_/code_io_stream_), so it stays local to keep the
// native self-compile closure happy.
fn return_kind_owned_string_err() -> i64 {
    return 902;
}

fn return_kind_owned_array_i64_err() -> i64 {
    return 903;
}

fn return_kind_owned_array_bool_err() -> i64 {
    return 904;
}

fn return_kind_owned_array_slice_err() -> i64 {
    return 905;
}

fn return_kind_typed_error_i64() -> i64 {
    return 906;
}

fn return_kind_typed_error_void() -> i64 {
    return 907;
}

fn return_kind_is_owned_array_err(ret_kind: i64) -> bool {
    if ret_kind == return_kind_owned_array_i64_err() {
        return true;
    }
    if ret_kind == return_kind_owned_array_bool_err() {
        return true;
    }
    return ret_kind == return_kind_owned_array_slice_err();
}

// user_ret_abi maps a user function's declared return kind (0 void, 1 i64, 2
// error-union void, 3 error-union i64, bool, '[]u8' slice, error-owned
// aggregates) to its render ABI.
fn user_ret_abi(ret_kind: i64) -> i64 {
    if ret_kind == 2 {
        return ret_abi_user_err_void();
    }
    if ret_kind == 3 {
        return ret_abi_user_err_i64();
    }
    let bool_ret = return_kind_bool();
    if ret_kind == bool_ret {
        return ret_abi_user_bool();
    }
    let slice_ret = return_kind_slice();
    if ret_kind == slice_ret {
        return ret_abi_user_slice();
    }
    if ret_kind == return_kind_owned_string_err() {
        return ret_abi_user_err_owned();
    }
    if return_kind_is_owned_array_err(ret_kind) {
        return ret_abi_user_err_owned();
    }
    if ret_kind == return_kind_typed_error_void() {
        return ret_abi_user_typed_error_void();
    }
    if ret_kind == return_kind_typed_error_i64() {
        return ret_abi_user_typed_error_i64();
    }
    return ret_abi_user_i64();
}

fn render_main_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    body_start: i64,
    func_end: i64
) -> !i64 {
    try wl(out, "define i64 @kizu_run_main() {");
    try wl(out, "entry:");
    try wl(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try render_var_allocas(out, code, body_start, func_end);
    let main_abi = ret_abi_main();
    try render_body(out, text, code, kinds, body_start, func_end, main_abi);
    // Every return record terminates its block and opens a fresh dead label, so
    // the body always leaves one open block; the process-exit tail terminates it
    // (as the live void fall-through or as dead code after a trailing return).
    try render_main_tail(out);
    try wl(out, "}");
    try nl(out);
    return func_end + 1;
}

// render_main_tail emits the process-exit terminator closing kizu_run_main's
// final open block.
fn render_main_tail(out: &var std::string::String) -> !void {
    try wl(out, "  %exit_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try wl(out, "  ret i64 %exit_code");
    return;
}

fn render_user_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    name: []u8,
    param_base: i64,
    param_count: i64,
    ret_kind: i64,
    body_start: i64,
    func_end: i64
) -> !i64 {
    try render_user_define_head(out, code, name, ret_kind);
    try w(out, "(");
    try render_param_list(out, code, kinds, param_base, param_count, 0);
    try wl(out, ") {");
    try wl(out, "entry:");
    // A user function that prints needs the io handle the print writers reference;
    // bind it at entry only when the body actually contains a PRINT record.
    let prints = try body_has_print(code, body_start, func_end);
    if prints {
        try wl(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    }
    try render_var_allocas(out, code, body_start, func_end);
    let abi = user_ret_abi(ret_kind);
    try render_body(out, text, code, kinds, body_start, func_end, abi);
    // Every return record terminates its block and opens a fresh dead label, so
    // the body always leaves one open block; the ABI default terminator closes it
    // (an i64 function returns 0, an error-union-void function the ok union).
    try render_user_tail(out, code, abi, ret_kind);
    try wl(out, "}");
    try nl(out);
    return func_end + 1;
}

fn render_user_method_function(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    type_name: []u8,
    name: []u8,
    param_base: i64,
    param_count: i64,
    ret_kind: i64,
    body_start: i64,
    func_end: i64
) -> !i64 {
    try render_user_method_define_head(out, code, type_name, name, ret_kind);
    try w(out, "(");
    try render_param_list(out, code, kinds, param_base, param_count, 0);
    try wl(out, ") {");
    try wl(out, "entry:");
    let prints = try body_has_print(code, body_start, func_end);
    if prints {
        try wl(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    }
    try render_var_allocas(out, code, body_start, func_end);
    let abi = user_ret_abi(ret_kind);
    try render_body(out, text, code, kinds, body_start, func_end, abi);
    try render_user_tail(out, code, abi, ret_kind);
    try wl(out, "}");
    try nl(out);
    return func_end + 1;
}

// render_user_define_head writes the 'define <ret> @kizu_run_user_<name>' opener
// whose return type follows the declared kind: '%kizu.error.void' for '!void',
// '%kizu.error.i64' for '!i64', i1 for bool, and i64 for other word returns.
fn render_user_define_head(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    name: []u8,
    ret_kind: i64
) -> !void {
    let is_err_void = ret_kind == 2;
    let is_err_i64 = ret_kind == 3;
    let bool_ret = return_kind_bool();
    let is_bool = ret_kind == bool_ret;
    let slice_ret = return_kind_slice();
    let is_slice = ret_kind == slice_ret;
    let is_union_ret = try value_kind_is_union(code, ret_kind);
    let is_struct_ret = try value_kind_is_struct_decl(code, ret_kind);
    let is_owned_string = ret_kind == codegen::code_kind_owned_string();
    let is_owned_string_err = ret_kind == return_kind_owned_string_err();
    let is_owned_array_err = return_kind_is_owned_array_err(ret_kind);
    let is_typed_error_void = ret_kind == return_kind_typed_error_void();
    let is_typed_error_i64 = ret_kind == return_kind_typed_error_i64();
    if is_err_void {
        try w(out, "define %kizu.error.void @kizu_run_user_");
    }
    if is_err_i64 {
        try w(out, "define %kizu.error.i64 @kizu_run_user_");
    }
    if is_typed_error_void {
        try w(out, "define %kizu.error.union.void @kizu_run_user_");
    }
    if is_typed_error_i64 {
        try w(out, "define %kizu.error.union.i64 @kizu_run_user_");
    }
    if is_union_ret {
        try w(out, "define %kizu.run.union @kizu_run_user_");
    }
    if is_struct_ret {
        try render_user_define_head_struct(out, code, ret_kind);
    }
    if is_bool {
        try w(out, "define i1 @kizu_run_user_");
    }
    if is_slice {
        try w(out, "define %kizu.slice.u8 @kizu_run_user_");
    }
    if is_owned_string {
        try w(out, "define %kizu.owned @kizu_run_user_");
    }
    if is_owned_string_err {
        try w(out, "define %kizu.error.owned @kizu_run_user_");
    }
    if is_owned_array_err {
        try w(out, "define %kizu.error.owned @kizu_run_user_");
    }
    let is_word_ret = !is_err_void and !is_err_i64 and !is_typed_error_void and !is_typed_error_i64 and !is_bool and !is_slice and !is_union_ret and !is_struct_ret and !is_owned_string and !is_owned_string_err and !is_owned_array_err;
    if is_word_ret {
        try w(out, "define i64 @kizu_run_user_");
    }
    try w(out, name);
    return;
}

fn render_user_define_head_struct(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    ret_kind: i64
) -> !void {
    try w(out, "define ");
    try render_struct_decl_value_type(out, code, ret_kind);
    try w(out, " @kizu_run_user_");
    return;
}

fn render_user_method_define_head(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    type_name: []u8,
    name: []u8,
    ret_kind: i64
) -> !void {
    try w(out, "define ");
    try render_user_return_type(out, code, ret_kind);
    try w(out, " @kizu_run_user_");
    try render_method_symbol(out, type_name, name);
    return;
}

fn render_user_return_type(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    ret_kind: i64
) -> !void {
    let is_err_void = ret_kind == 2;
    let is_err_i64 = ret_kind == 3;
    let bool_ret = return_kind_bool();
    let is_bool = ret_kind == bool_ret;
    let slice_ret = return_kind_slice();
    let is_slice = ret_kind == slice_ret;
    let is_union_ret = try value_kind_is_union(code, ret_kind);
    let is_struct_ret = try value_kind_is_struct_decl(code, ret_kind);
    let is_owned_string = ret_kind == codegen::code_kind_owned_string();
    let is_owned_string_err = ret_kind == return_kind_owned_string_err();
    let is_owned_array_err = return_kind_is_owned_array_err(ret_kind);
    let is_typed_error_void = ret_kind == return_kind_typed_error_void();
    let is_typed_error_i64 = ret_kind == return_kind_typed_error_i64();
    if is_err_void {
        try w(out, "%kizu.error.void");
    }
    if is_err_i64 {
        try w(out, "%kizu.error.i64");
    }
    if is_typed_error_void {
        try w(out, "%kizu.error.union.void");
    }
    if is_typed_error_i64 {
        try w(out, "%kizu.error.union.i64");
    }
    if is_union_ret {
        try w(out, "%kizu.run.union");
    }
    if is_struct_ret {
        try render_struct_decl_value_type(out, code, ret_kind);
    }
    if is_bool {
        try w(out, "i1");
    }
    if is_slice {
        try w(out, "%kizu.slice.u8");
    }
    if is_owned_string {
        try w(out, "%kizu.owned");
    }
    if is_owned_string_err {
        try w(out, "%kizu.error.owned");
    }
    if is_owned_array_err {
        try w(out, "%kizu.error.owned");
    }
    let is_word_ret = !is_err_void and !is_err_i64 and !is_typed_error_void and !is_typed_error_i64 and !is_bool and !is_slice and !is_union_ret and !is_struct_ret and !is_owned_string and !is_owned_string_err and !is_owned_array_err;
    if is_word_ret {
        try w(out, "i64");
    }
    return;
}

fn render_method_symbol(out: &var std::string::String, type_name: []u8, name: []u8) -> !void {
    try w(out, type_name);
    try w(out, "__");
    try w(out, name);
    return;
}

// render_user_tail closes a user function body's final open block with the
// default terminator for its ABI.
fn render_user_tail(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    abi: i64,
    ret_kind: i64
) -> !void {
    let err_void = ret_abi_user_err_void();
    let err_i64 = ret_abi_user_err_i64();
    let is_err_void = abi == err_void;
    let is_err_i64 = abi == err_i64;
    let err_owned = ret_abi_user_err_owned();
    let is_err_owned = abi == err_owned;
    let typed_err_void = ret_abi_user_typed_error_void();
    let is_typed_err_void = abi == typed_err_void;
    let typed_err_i64 = ret_abi_user_typed_error_i64();
    let is_typed_err_i64 = abi == typed_err_i64;
    let bool_ret = return_kind_bool();
    let is_bool = ret_kind == bool_ret;
    let slice_ret = return_kind_slice();
    let is_slice = ret_kind == slice_ret;
    let is_union_ret = try value_kind_is_union(code, ret_kind);
    let is_struct_ret = try value_kind_is_struct_decl(code, ret_kind);
    let is_owned_string = ret_kind == codegen::code_kind_owned_string();
    if is_err_void {
        try render_ret_err_ok(out);
    }
    if is_err_i64 {
        try wl(out, "  ret %kizu.error.i64 { i1 true, i64 0, %kizu.slice.u8 zeroinitializer }");
    }
    if is_typed_err_void {
        try wl(out, "  ret %kizu.error.union.void { i1 true, %kizu.run.union zeroinitializer }");
    }
    if is_typed_err_i64 {
        try wl(out, "  ret %kizu.error.union.i64 { i1 true, i64 0, %kizu.run.union zeroinitializer }");
    }
    // The checker guarantees a union-returning body ends with a return, so this
    // tail only types the dead fall-through block.
    if is_union_ret {
        try wl(out, "  ret %kizu.run.union zeroinitializer");
    }
    if is_struct_ret {
        try render_user_tail_struct(out, code, ret_kind);
    }
    if is_bool {
        try wl(out, "  ret i1 false");
    }
    if is_slice {
        try wl(out, "  ret %kizu.slice.u8 zeroinitializer");
    }
    if is_owned_string {
        try wl(out, "  ret %kizu.owned zeroinitializer");
    }
    if is_err_owned {
        try wl(out, "  ret %kizu.error.owned { i1 true, %kizu.owned zeroinitializer, %kizu.slice.u8 zeroinitializer }");
    }
    let is_word_ret = !is_err_void and !is_err_i64 and !is_typed_err_void and !is_typed_err_i64 and !is_bool and !is_slice and !is_union_ret and !is_struct_ret and !is_owned_string and !is_err_owned;
    if is_word_ret {
        try wl(out, "  ret i64 0");
    }
    return;
}

fn render_user_tail_struct(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    ret_kind: i64
) -> !void {
    try w(out, "  ret ");
    try render_struct_decl_value_type(out, code, ret_kind);
    try wl(out, " zeroinitializer");
    return;
}

// render_param_list emits '<type> %v<param_base+i>' separated by commas, typing
// each parameter from its value kind (i1 for bool, i64 otherwise).
fn render_param_list(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    param_base: i64,
    param_count: i64,
    index: i64
) -> !void {
    if index >= param_count {
        return;
    }
    if index > 0 {
        try w(out, ", ");
    }
    // Bind the slot id so the wi() call takes a local rather than a 'base + index'
    // binary arg (the call-arg lowering only models 'base + <int literal>').
    let slot = param_base + index;
    let kind = try kinds.get(slot);
    try render_value_type(out, code, kind);
    try w(out, " %v");
    try wi(out, slot);
    let after = index + 1;
    try render_param_list(out, code, kinds, param_base, param_count, after);
    return;
}

// render_value_type writes the LLVM type for a tape value kind: bool values are
// 'i1', slice values '%kizu.slice.u8', UNION_DECL-backed values the runtime
// union aggregate, every other scalar value 'i64'.
fn render_value_type(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kind: i64
) -> !void {
    let kind_bool = codegen::code_kind_bool();
    let kind_slice = codegen::code_kind_slice();
    let kind_handle = codegen::code_kind_handle();
    let kind_error_box = codegen::code_kind_error_box_i64();
    let is_bool = kind == kind_bool;
    let is_slice = kind == kind_slice;
    let is_handle = kind == kind_handle;
    let is_mut_borrow = codegen::code_kind_is_mut_borrow_ptr(kind);
    let is_atomic_bool = kind == codegen::code_kind_atomic_bool();
    let is_error_box = kind == kind_error_box;
    let is_owned = value_kind_is_owned(kind);
    let is_union = try value_kind_is_union(code, kind);
    let is_struct_decl = try value_kind_is_struct_decl(code, kind);
    let is_struct_param = try value_kind_is_struct_param(code, kind);
    if is_bool {
        try w(out, "i1");
    }
    if is_slice {
        try w(out, "%kizu.slice.u8");
    }
    if is_handle {
        try w(out, "%kizu.handle");
    }
    // A '&var i64' or '&var []u8' parameter/argument is a pointer to the caller's
    // var slot; the body loads/stores through it (PTR_LOAD/PTR_STORE or the slice
    // variants PTR_LOAD_SLICE/PTR_STORE_SLICE).
    if is_mut_borrow {
        try w(out, "ptr");
    }
    if is_atomic_bool {
        try w(out, "ptr");
    }
    if is_owned {
        try w(out, "%kizu.owned");
    }
    if is_error_box {
        try w(out, "%kizu.error.owned");
    }
    if is_union {
        try w(out, "%kizu.run.union");
    }
    if is_struct_decl {
        try render_struct_decl_value_type(out, code, kind);
    }
    if is_struct_param {
        try render_struct_param_value_type(out, code, kind);
    }
    let scalar = !is_bool and !is_slice and !is_handle and !is_mut_borrow and !is_atomic_bool and !is_error_box and !is_owned and !is_union and !is_struct_decl and !is_struct_param;
    if scalar {
        try w(out, "i64");
    }
    return;
}

fn value_kind_is_owned(kind: i64) -> bool {
    if kind == codegen::code_kind_owned() {
        return true;
    }
    if kind == codegen::code_kind_owned_string() {
        return true;
    }
    if codegen::code_kind_is_owned_array(kind) {
        return true;
    }
    if codegen::code_kind_is_owned_map(kind) {
        return true;
    }
    if codegen::code_kind_is_owned_box(kind) {
        return true;
    }
    if codegen::code_kind_is_borrowed_map(kind) {
        return true;
    }
    return codegen::code_kind_is_arena(kind);
}

// value_kind_is_union reports whether a record-backed value kind references a
// UNION_DECL record (a value of the runtime union aggregate type).
fn value_kind_is_union(code: &std::array::Array<i64>, kind: i64) -> !bool {
    let record_base = codegen::code_kind_struct_base();
    if kind < record_base {
        return false;
    }
    let record_pos = kind - record_base;
    let op = try code.get(record_pos);
    let op_union_decl = codegen::code_op_union_decl();
    return op == op_union_decl;
}

fn value_kind_is_struct_decl(code: &std::array::Array<i64>, kind: i64) -> !bool {
    let record_base = codegen::code_kind_struct_base();
    if kind < record_base {
        return false;
    }
    let record_pos = kind - record_base;
    let op = try code.get(record_pos);
    let op_struct_decl = codegen::code_op_struct_decl();
    return op == op_struct_decl;
}

fn render_struct_decl_value_type(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kind: i64
) -> !void {
    let record_base = codegen::code_kind_struct_base();
    let record_pos = kind - record_base;
    try render_struct_decl_type_at(out, code, record_pos);
    return;
}

fn render_struct_decl_type_at(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    record_pos: i64
) -> !void {
    let field_count = try code.get(record_pos + 3);
    try w(out, "{ ");
    try render_struct_decl_type_fields(out, code, record_pos, field_count, 0);
    try w(out, " }");
    return;
}

fn render_struct_decl_type_fields(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    record_pos: i64,
    field_count: i64,
    index: i64
) -> !void {
    if index >= field_count {
        return;
    }
    if index > 0 {
        try w(out, ", ");
    }
    let field_kind = try struct_decl_field_kind(code, record_pos, index);
    try render_value_type(out, code, field_kind);
    let after = index + 1;
    try render_struct_decl_type_fields(out, code, record_pos, field_count, after);
    return;
}

fn struct_decl_field_kind(
    code: &std::array::Array<i64>,
    record_pos: i64,
    index: i64
) -> !i64 {
    let entry_slots = index * 3;
    let entry_pos = record_pos + 4 + entry_slots;
    let field_kind = try code.get(entry_pos + 2);
    return field_kind;
}

fn value_kind_is_struct_param(code: &std::array::Array<i64>, kind: i64) -> !bool {
    let record_base = codegen::code_kind_struct_base();
    if kind < record_base {
        return false;
    }
    let record_pos = kind - record_base;
    let op = try code.get(record_pos);
    let op_struct_param = codegen::code_op_struct_param();
    return op == op_struct_param;
}

fn render_struct_param_value_type(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    kind: i64
) -> !void {
    let field_kind = try struct_param_first_field_kind(code, kind);
    try render_value_type(out, code, field_kind);
    return;
}

fn struct_param_first_field_kind(code: &std::array::Array<i64>, kind: i64) -> !i64 {
    let record_base = codegen::code_kind_struct_base();
    let record_pos = kind - record_base;
    let kind_pos = record_pos + 4;
    let field_kind = try code.get(kind_pos);
    return field_kind;
}

// tape_function_end returns the index of the FUNC_END record closing the function
// whose body begins at index.
fn tape_function_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    // Bind the tape length once so the bounds guard returns a local rather than a
    // 'return code.len();' the compiled-MIR if-then early-return path would treat as
    // a free-function call.
    let total = code.len();
    if index >= total {
        return total;
    }
    let op = try code.get(index);
    let func_end = codegen::code_op_func_end();
    if op == func_end {
        return index;
    }
    let next = try tape_record_end(code, index);
    return try tape_function_end(code, next);
}

// body_has_print reports whether the records in [index, func_end) include a PRINT.
fn body_has_print(
    code: &std::array::Array<i64>,
    index: i64,
    func_end: i64
) -> !bool {
    if index >= func_end {
        return false;
    }
    let op = try code.get(index);
    let print_op = codegen::code_op_print();
    if op == print_op {
        return true;
    }
    let next = try tape_record_end(code, index);
    return try body_has_print(code, next, func_end);
}

// render_var_allocas hoists one 'alloca i64' to the function entry for every var
// slot the body declares: a VAR_DECL slot (a 'var' local) or a FOR_BEGIN slot (a
// for-loop induction var). Hoisting all slots to entry keeps every VAR_LOAD/STORE
// and the for latch dominated by the alloca regardless of loop nesting.
fn render_var_allocas(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    func_end: i64
) -> !void {
    if index >= func_end {
        return;
    }
    let op = try code.get(index);
    let var_decl = codegen::code_op_var_decl();
    if op == var_decl {
        let decl_slot = try code.get(index + 1);
        try render_one_alloca(out, decl_slot);
    }
    let var_decl_slice = codegen::code_op_var_decl_slice();
    if op == var_decl_slice {
        let slice_slot = try code.get(index + 1);
        try render_one_slice_alloca(out, slice_slot);
    }
    let var_decl_bool = codegen::code_op_var_decl_bool();
    if op == var_decl_bool {
        let bool_slot = try code.get(index + 1);
        try render_one_bool_alloca(out, bool_slot);
    }
    let for_begin = codegen::code_op_for_begin();
    if op == for_begin {
        let for_slot = try code.get(index + 2);
        try render_one_alloca(out, for_slot);
    }
    let sc_begin = codegen::code_op_sc_begin();
    if op == sc_begin {
        let sc_slot = try code.get(index + 1);
        try render_one_sc_alloca(out, sc_slot);
    }
    let atomic_new = codegen::code_op_atomic_bool_new();
    if op == atomic_new {
        let atomic_slot = try code.get(index + 1);
        try render_one_atomic_bool_alloca(out, atomic_slot);
    }
    let next = try tape_record_end(code, index);
    try render_var_allocas(out, code, next, func_end);
    return;
}

// render_one_alloca emits '%slot<id> = alloca i64' for one var slot.
fn render_one_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %slot");
    try wi(out, slot);
    try wl(out, " = alloca i64");
    return;
}

// render_one_slice_alloca emits '%sslot<id> = alloca %kizu.slice.u8' for one
// scalarized slice-field slot.
fn render_one_slice_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %sslot");
    try wi(out, slot);
    try wl(out, " = alloca %kizu.slice.u8");
    return;
}

// render_one_bool_alloca emits '%bslot<id> = alloca i1' for one value-position
// if/match result slot whose branches yield bool values.
fn render_one_bool_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %bslot");
    try wi(out, slot);
    try wl(out, " = alloca i1");
    return;
}

fn render_one_atomic_bool_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %atomic");
    try wi(out, slot);
    try wl(out, " = alloca i8, align 1");
    return;
}

// render_one_sc_alloca emits '%sc<id> = alloca i1' for one short-circuit slot
// (named by its SC_BEGIN tape index and hoisted to the function entry).
fn render_one_sc_alloca(out: &var std::string::String, slot: i64) -> !void {
    try w(out, "  %sc");
    try wi(out, slot);
    try wl(out, " = alloca i1");
    return;
}

// render_body renders the records in [index, func_end) of one function body.
fn render_body(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    func_end: i64,
    abi: i64
) -> !void {
    if index >= func_end {
        return;
    }
    let next = try tape_record_end(code, index);
    try render_one_instruction(out, text, code, kinds, index, abi);
    try render_body(out, text, code, kinds, next, func_end, abi);
    return;
}

fn render_one_instruction(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    // The opcodes are mutually exclusive, so each writer runs under its own void
    // then-body guard and the function falls through to a single return -- the shape
    // both the Go reference compiler and the compiled-MIR void if-lowering accept (a
    // 'return try <void call>;' identity tail is rejected by the former).
    let op = try code.get(index);
    try render_one_instruction_core(out, text, code, kinds, index, abi, op);
    try render_one_instruction_runtime(out, text, code, kinds, index, abi, op);
    try render_one_instruction_storage(out, text, code, kinds, index, abi, op);
    try render_one_instruction_control(out, text, code, kinds, index, abi, op);
    return;
}

fn render_one_instruction_core(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    op: i64
) -> !void {
    try render_one_instruction_core_scalar(out, text, code, kinds, index, abi, op);
    try render_one_instruction_core_aggregate_call(out, text, code, kinds, index, abi, op);
    return;
}

fn render_one_instruction_core_scalar(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    op: i64
) -> !void {
    let const_int = codegen::code_op_const_int();
    if op == const_int {
        try render_const_int(out, code, index);
    }
    let const_bool = codegen::code_op_const_bool();
    if op == const_bool {
        try render_const_bool(out, code, index);
    }
    let atomic_bool_new = codegen::code_op_atomic_bool_new();
    if op == atomic_bool_new {
        try render_atomic_bool_new(out, code, index);
    }
    let atomic_bool_load = codegen::code_op_atomic_bool_load();
    if op == atomic_bool_load {
        try render_atomic_bool_load(out, code, index);
    }
    let not_op = codegen::code_op_not();
    if op == not_op {
        try render_not(out, code, index);
    }
    let binary = codegen::code_op_binary();
    if op == binary {
        try render_binary(out, code, index);
    }
    let sc_begin = codegen::code_op_sc_begin();
    if op == sc_begin {
        try render_sc_begin(out, code, index);
    }
    let sc_end = codegen::code_op_sc_end();
    if op == sc_end {
        try render_sc_end(out, code, index);
    }
    let print_op = codegen::code_op_print();
    if op == print_op {
        try render_print(out, code, index);
    }
    let str_slice = codegen::code_op_str_slice();
    if op == str_slice {
        try render_str_slice(out, code, index);
    }
    let enum_const = codegen::code_op_enum_const();
    if op == enum_const {
        try render_enum_const(out, code, index);
    }
    // A UNION_CONST shares ENUM_CONST's dst/tag offsets, so the tag-constant
    // renderer serves both (the payload value renders through its own record).
    let union_const = codegen::code_op_union_const();
    if op == union_const {
        try render_enum_const(out, code, index);
    }
    return;
}

fn render_one_instruction_core_aggregate_call(
    out: &var std::string::String,
    text: []u8,
    code: &std::array::Array<i64>,
    kinds: &std::array::Array<i64>,
    index: i64,
    abi: i64,
    op: i64
) -> !void {
