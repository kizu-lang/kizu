fn render_arena_add_slice_struct(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let arena = try code.get(index + 2);
    let field = try code.get(index + 3);
    try w(out, "  %ar");
    try wi(out, dst);
    try wl(out, "_slot = alloca %kizu.slice.u8");
    try w(out, "  store %kizu.slice.u8 %v");
    try wi(out, field);
    try w(out, ", ptr %ar");
    try wi(out, dst);
    try wl(out, "_slot");
    try w(out, "  %ar");
    try wi(out, dst);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr %ar");
    try wi(out, dst);
    try wl(out, "_slot, 0");
    try w(out, "  %ar");
    try wi(out, dst);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %ar");
    try wi(out, dst);
    try wl(out, "_base, i64 16, 1");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.handle @kizu_rt_arena_add(%kizu.owned %v");
    try wi(out, arena);
    try w(out, ", %kizu.slice.u8 %ar");
    try wi(out, dst);
    try wl(out, "_slice)");
    return;
}

fn render_arena_get_slice_struct_field(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let arena = try code.get(index + 2);
    let handle = try code.get(index + 3);
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, " = call %kizu.error.slice.u8 @kizu_rt_arena_get(%kizu.owned %v");
    try wi(out, arena);
    try w(out, ", %kizu.handle %v");
    try wi(out, handle);
    try wl(out, ")");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_ok = extractvalue %kizu.error.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, ", 0");
    try w(out, "  br i1 %arg");
    try wi(out, dst);
    try w(out, "_ok, label %arg");
    try wi(out, dst);
    try w(out, "_cont, label %arg");
    try wi(out, dst);
    try wl(out, "_fail");
    try w(out, "arg");
    try wi(out, dst);
    try wl(out, "_fail:");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_msg = extractvalue %kizu.error.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, ", 2");
    try w(out, "  call void @kizu_rt_trap(%kizu.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, "_msg)");
    try wl(out, "  unreachable");
    try w(out, "arg");
    try wi(out, dst);
    try wl(out, "_cont:");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_slice = extractvalue %kizu.error.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, ", 1");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_ptr = extractvalue %kizu.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, "_slice, 0");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load %kizu.slice.u8, ptr %arg");
    try wi(out, dst);
    try wl(out, "_ptr");
    return;
}

fn render_arena_add_struct(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let arena = try code.get(index + 2);
    let payload_size = try code.get(index + 3);
    let field_count = try code.get(index + 4);
    try w(out, "  %ar");
    try wi(out, dst);
    try w(out, "_slot = alloca i8, i64 ");
    try wi(out, payload_size);
    try nl(out);
    try render_arena_add_struct_fields(out, code, dst, index + 5, field_count, 0);
    try w(out, "  %ar");
    try wi(out, dst);
    try w(out, "_slice0 = insertvalue %kizu.slice.u8 poison, ptr %ar");
    try wi(out, dst);
    try wl(out, "_slot, 0");
    try w(out, "  %ar");
    try wi(out, dst);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %ar");
    try wi(out, dst);
    try w(out, "_slice0, i64 ");
    try wi(out, payload_size);
    try wl(out, ", 1");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.handle @kizu_rt_arena_add(%kizu.owned %v");
    try wi(out, arena);
    try w(out, ", %kizu.slice.u8 %ar");
    try wi(out, dst);
    try wl(out, "_slice)");
    return;
}

fn render_arena_add_struct_fields(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    dst: i64,
    fields_start: i64,
    field_count: i64,
    index: i64
) -> !void {
    if index < field_count {
        let entry_pos = fields_start + index * 4;
        let offset = try code.get(entry_pos);
        let kind_pos = entry_pos + 2;
        let kind = try code.get(kind_pos);
        let value_pos = entry_pos + 3;
        let value = try code.get(value_pos);
        try w(out, "  %ar");
        try wi(out, dst);
        try w(out, "_f");
        try wi(out, index);
        try w(out, " = getelementptr i8, ptr %ar");
        try wi(out, dst);
        try w(out, "_slot, i64 ");
        try wi(out, offset);
        try nl(out);
        try render_arena_add_struct_field_store(out, dst, index, kind, value);
        let after = index + 1;
        try render_arena_add_struct_fields(out, code, dst, fields_start, field_count, after);
    }
    return;
}

fn render_arena_add_struct_field_store(
    out: &var std::string::String,
    dst: i64,
    index: i64,
    kind: i64,
    value: i64
) -> !void {
    if kind == codegen::code_kind_i64() {
        try w(out, "  store i64 %v");
        try wi(out, value);
        try w(out, ", ptr %ar");
        try wi(out, dst);
        try w(out, "_f");
        try wi(out, index);
        try nl(out);
    }
    if kind == codegen::code_kind_bool() {
        try w(out, "  %ar");
        try wi(out, dst);
        try w(out, "_b");
        try wi(out, index);
        try w(out, " = zext i1 %v");
        try wi(out, value);
        try wl(out, " to i8");
        try w(out, "  store i8 %ar");
        try wi(out, dst);
        try w(out, "_b");
        try wi(out, index);
        try w(out, ", ptr %ar");
        try wi(out, dst);
        try w(out, "_f");
        try wi(out, index);
        try nl(out);
    }
    if kind == codegen::code_kind_slice() {
        try w(out, "  store %kizu.slice.u8 %v");
        try wi(out, value);
        try w(out, ", ptr %ar");
        try wi(out, dst);
        try w(out, "_f");
        try wi(out, index);
        try nl(out);
    }
    return;
}

fn render_arena_get_struct_field(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let arena = try code.get(index + 2);
    let handle = try code.get(index + 3);
    let offset = try code.get(index + 4);
    let kind_pos = index + 6;
    let kind = try code.get(kind_pos);
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, " = call %kizu.error.slice.u8 @kizu_rt_arena_get(%kizu.owned %v");
    try wi(out, arena);
    try w(out, ", %kizu.handle %v");
    try wi(out, handle);
    try wl(out, ")");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_ok = extractvalue %kizu.error.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, ", 0");
    try w(out, "  br i1 %arg");
    try wi(out, dst);
    try w(out, "_ok, label %arg");
    try wi(out, dst);
    try w(out, "_cont, label %arg");
    try wi(out, dst);
    try wl(out, "_fail");
    try w(out, "arg");
    try wi(out, dst);
    try wl(out, "_fail:");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_msg = extractvalue %kizu.error.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, ", 2");
    try w(out, "  call void @kizu_rt_trap(%kizu.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, "_msg)");
    try wl(out, "  unreachable");
    try w(out, "arg");
    try wi(out, dst);
    try wl(out, "_cont:");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_slice = extractvalue %kizu.error.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, ", 1");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_ptr = extractvalue %kizu.slice.u8 %arg");
    try wi(out, dst);
    try wl(out, "_slice, 0");
    try w(out, "  %arg");
    try wi(out, dst);
    try w(out, "_field = getelementptr i8, ptr %arg");
    try wi(out, dst);
    try w(out, "_ptr, i64 ");
    try wi(out, offset);
    try nl(out);
    try render_arena_get_struct_field_load(out, dst, kind);
    return;
}

fn render_arena_get_struct_field_load(
    out: &var std::string::String,
    dst: i64,
    kind: i64
) -> !void {
    if kind == codegen::code_kind_i64() {
        try w(out, "  %v");
        try wi(out, dst);
        try w(out, " = load i64, ptr %arg");
        try wi(out, dst);
        try wl(out, "_field");
    }
    if kind == codegen::code_kind_bool() {
        try w(out, "  %arg");
        try wi(out, dst);
        try w(out, "_byte = load i8, ptr %arg");
        try wi(out, dst);
        try wl(out, "_field");
        try w(out, "  %v");
        try wi(out, dst);
        try w(out, " = icmp ne i8 %arg");
        try wi(out, dst);
        try wl(out, "_byte, 0");
    }
    if kind == codegen::code_kind_slice() {
        try w(out, "  %v");
        try wi(out, dst);
        try w(out, " = load %kizu.slice.u8, ptr %arg");
        try wi(out, dst);
        try wl(out, "_field");
    }
    return;
}

// render_fs_read_propagate emits the fail-block terminator for a try fs read: the
// kizu_run_main entry exits the process with code 1, every other (error-union-void)
// function returns a failed error union.
fn render_fs_read_propagate(out: &var std::string::String, dst: i64, abi: i64) -> !void {
    let main_abi = ret_abi_main();
    let err_i64 = ret_abi_user_err_i64();
    if abi == main_abi {
        try render_fs_read_propagate_exit(out, dst);
    }
    if abi == err_i64 {
        try wl(out, "  ret %kizu.error.i64 { i1 false, i64 0, %kizu.slice.u8 zeroinitializer }");
    }
    if abi != main_abi {
        if abi != err_i64 {
            try render_ret_err_void_fail(out);
        }
    }
    return;
}

fn render_fs_read_propagate_exit(out: &var std::string::String, dst: i64) -> !void {
    try w(out, "  %fr");
    try wi(out, dst);
    try wl(out, "_exit = call i64 @kizu_rt_process_exit_code(i64 1)");
    try w(out, "  ret i64 %fr");
    try wi(out, dst);
    try wl(out, "_exit");
    return;
}

// render_ret_err_void_fail returns a failed '%kizu.error.void' union with an empty
// message slice as an inline aggregate constant (no SSA temp needed).
fn render_ret_err_void_fail(out: &var std::string::String) -> !void {
    try wl(out, "  ret %kizu.error.void { i1 false, %kizu.slice.u8 zeroinitializer }");
    return;
}

// render_print emits the write for a print(<value>) record then the trailing
// newline print() appends: a string value writes its global slice straight to
// stdout; an i64 value formats through the decimal helper first.
fn render_print(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let value_id = try code.get(index + 1);
    let value_kind = try code.get(index + 2);
    let kind_str = codegen::code_kind_str();
    let kind_slice = codegen::code_kind_slice();
    let kind_bool = codegen::code_kind_bool();
    // Dispatch on the recorded value kind through mutually exclusive void then-body
    // guards (each leaf writer also emits the trailing newline) and fall through to a
    // single return -- the shape both the Go reference compiler and the compiled-MIR
    // void if-lowering accept. A str value writes its global slice, a slice value
    // writes its SSA slice directly, a bool selects its word payload, and any
    // other value formats as i64.
    let record_base = codegen::code_kind_struct_base();
    let is_struct_param = try value_kind_is_struct_param(code, value_kind);
    let is_string = value_kind == kind_str;
    let is_slice = value_kind == kind_slice;
    let is_bool = value_kind == kind_bool;
    let is_record = value_kind >= record_base and !is_struct_param;
    let not_str_slice = !is_string and !is_slice;
    let not_bool_record = !is_bool and !is_record and !is_struct_param;
    let is_i64 = not_str_slice and not_bool_record;
    if is_string {
        try render_print_string_line(out, code, value_id, index);
    }
    if is_slice {
        try render_print_slice_line(out, value_id, index);
    }
    if is_bool {
        try render_print_bool_line(out, value_id, index);
    }
    if is_record {
        try render_print_enum_line(out, code, value_id, value_kind, index);
    }
    if is_struct_param {
        try render_print_struct_param_line(out, code, value_id, value_kind, index);
    }
    if is_i64 {
        try render_print_i64_line(out, value_id, index);
    }
    return;
}

fn render_print_struct_param_line(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64,
    value_kind: i64,
    suffix: i64
) -> !void {
    let field_kind = try struct_param_first_field_kind(code, value_kind);
    let kind_slice = codegen::code_kind_slice();
    let kind_bool = codegen::code_kind_bool();
    let is_slice = field_kind == kind_slice;
    let is_bool = field_kind == kind_bool;
    let is_i64 = !is_slice and !is_bool;
    if is_slice {
        try render_print_slice_line(out, value_id, suffix);
    }
    if is_bool {
        try render_print_bool_line(out, value_id, suffix);
    }
    if is_i64 {
        try render_print_i64_line(out, value_id, suffix);
    }
    return;
}

// render_print_enum_line writes enum record-backed print values. ENUM_CONST
// keeps the existing qualified-name global path, while ENUM_DECL dispatches a
// runtime tag to the variant globals emitted from the declaration record.
fn render_print_enum_line(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64,
    value_kind: i64,
    suffix: i64
) -> !void {
    let record_base = codegen::code_kind_struct_base();
    let record_pos = value_kind - record_base;
    let record_op = try code.get(record_pos);
    let enum_const = codegen::code_op_enum_const();
    if record_op == enum_const {
        try render_print_enum_const_line(out, code, record_pos, suffix);
    }
    let enum_decl = codegen::code_op_enum_decl();
    if record_op == enum_decl {
        try render_print_runtime_enum_line(out, code, value_id, record_pos, suffix);
    }
    return;
}

fn render_print_enum_const_line(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    record_pos: i64,
    suffix: i64
) -> !void {
    let dst = try code.get(record_pos + 1);
    let qual_start = try code.get(record_pos + 2);
    let qual_end = try code.get(record_pos + 3);
    let byte_len = qual_end - qual_start;
    try w(out, "  %pe");
    try wi(out, suffix);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.e");
    try wi(out, dst);
    try wl(out, ", 0");
    try w(out, "  %pe");
    try wi(out, suffix);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %pe");
    try wi(out, suffix);
    try w(out, "_base, i64 ");
    try wi(out, byte_len);
    try wl(out, ", 1");
    try w(out, "  %pe");
    try wi(out, suffix);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %pe");
    try wi(out, suffix);
    try wl(out, "_slice)");
    try render_print_newline(out, suffix);
    return;
}

fn render_print_runtime_enum_line(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64,
    record_pos: i64,
    suffix: i64
) -> !void {
    let count_pos = record_pos + 3;
    let variant_count = try code.get(count_pos);
    try w(out, "  switch i64 %v");
    try wi(out, value_id);
    try w(out, ", label %pe");
    try wi(out, suffix);
    try wl(out, "_bad [");
    try render_print_runtime_enum_switch_entries(out, suffix, variant_count, 0);
    try wl(out, "  ]");
    try w(out, "pe");
    try wi(out, suffix);
    try wl(out, "_bad:");
    try wl(out, "  unreachable");
    try render_print_runtime_enum_cases(out, code, record_pos, suffix, variant_count, 0);
    try w(out, "pe");
    try wi(out, suffix);
    try wl(out, "_done:");
    try render_print_newline(out, suffix);
    return;
}

fn render_print_runtime_enum_switch_entries(
    out: &var std::string::String,
    suffix: i64,
    variant_count: i64,
    tag: i64
) -> !void {
    if tag >= variant_count {
        return;
    }
    try w(out, "    i64 ");
    try wi(out, tag);
    try w(out, ", label %pe");
    try wi(out, suffix);
    try w(out, "_case");
    try wi(out, tag);
    try nl(out);
    let after = tag + 1;
    try render_print_runtime_enum_switch_entries(out, suffix, variant_count, after);
    return;
}

fn render_print_runtime_enum_cases(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    record_pos: i64,
    suffix: i64,
    variant_count: i64,
    tag: i64
) -> !void {
    if tag >= variant_count {
        return;
    }
    try render_print_runtime_enum_case(out, code, record_pos, suffix, tag);
    let after = tag + 1;
    try render_print_runtime_enum_cases(out, code, record_pos, suffix, variant_count, after);
    return;
}

fn render_print_runtime_enum_case(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    record_pos: i64,
    suffix: i64,
    tag: i64
) -> !void {
    let byte_len = try enum_decl_variant_byte_len(code, record_pos, tag);
    try w(out, "pe");
    try wi(out, suffix);
    try w(out, "_case");
    try wi(out, tag);
    try wl(out, ":");
    try w(out, "  %pe");
    try wi(out, suffix);
    try w(out, "_");
    try wi(out, tag);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.ed");
    try wi(out, record_pos);
    try w(out, "v");
    try wi(out, tag);
    try wl(out, ", 0");
    try w(out, "  %pe");
    try wi(out, suffix);
    try w(out, "_");
    try wi(out, tag);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %pe");
    try wi(out, suffix);
    try w(out, "_");
    try wi(out, tag);
    try w(out, "_base, i64 ");
    try wi(out, byte_len);
    try wl(out, ", 1");
    try w(out, "  %pe");
    try wi(out, suffix);
    try w(out, "_");
    try wi(out, tag);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %pe");
    try wi(out, suffix);
    try w(out, "_");
    try wi(out, tag);
    try wl(out, "_slice)");
    try w(out, "  br label %pe");
    try wi(out, suffix);
    try wl(out, "_done");
    return;
}

fn enum_decl_variant_byte_len(
    code: &std::array::Array<i64>,
    record_pos: i64,
    tag: i64
) -> !i64 {
    let enum_start = try code.get(record_pos + 1);
    let enum_end = try code.get(record_pos + 2);
    let entry_pos = enum_decl_variant_entry_pos(record_pos, tag);
    let var_start = try code.get(entry_pos);
    let name_end_pos = entry_pos + 1;
    let var_end = try code.get(name_end_pos);
    let enum_len = enum_end - enum_start;
    let variant_len = var_end - var_start;
    return enum_len + 2 + variant_len;
}

fn enum_decl_variant_entry_pos(record_pos: i64, tag: i64) -> i64 {
    let entry_slots = tag * 2;
    return record_pos + 4 + entry_slots;
}

// render_print_slice_line writes a runtime slice print value (its '%v<id>' SSA
// '%kizu.slice.u8') followed by the trailing newline print() appends.
fn render_print_slice_line(out: &var std::string::String, value_id: i64, suffix: i64) -> !void {
    try render_print_slice(out, value_id, suffix);
    try render_print_newline(out, suffix);
    return;
}

fn render_print_slice(out: &var std::string::String, value_id: i64, suffix: i64) -> !void {
    try w(out, "  %psl");
    try wi(out, suffix);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %v");
    try wi(out, value_id);
    try wl(out, ")");
    return;
}

// render_enum_const materializes an 'Enum::Variant' read as its i64 tag (the
// qualified-name global is only consumed by print).
fn render_enum_const(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let tag_pos = index + 6;
    let tag = try code.get(tag_pos);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = add i64 0, ");
    try wi(out, tag);
    try nl(out);
    return;
}

// render_union_pack materializes a runtime union aggregate: the tag inserts
// into field 0, an i64 payload into field 1, a slice payload into field 2 (a
// payload-less variant zeroes field 1 so the dst is a fully named value).
fn render_union_pack(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let tag_value = try code.get(index + 2);
    let payload_value = try code.get(index + 3);
    let payload_kind = try code.get(index + 4);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, "_tag = insertvalue %kizu.run.union poison, i64 %v");
    try wi(out, tag_value);
    try wl(out, ", 0");
    let kind_slice = codegen::code_kind_slice();
    let has_payload = payload_value >= 0;
    let is_slice = has_payload and payload_kind == kind_slice;
    let is_word = has_payload and payload_kind != kind_slice;
    if is_slice {
        try render_union_pack_field(out, dst, payload_value, 2);
    }
    if is_word {
        try render_union_pack_field(out, dst, payload_value, 1);
    }
    if !has_payload {
        try render_union_pack_empty(out, dst);
    }
    return;
}

// render_union_pack_field writes the payload insert closing a UNION_PACK.
fn render_union_pack_field(
    out: &var std::string::String,
    dst: i64,
    payload_value: i64,
    field: i64
) -> !void {
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = insertvalue %kizu.run.union %v");
    try wi(out, dst);
    try w(out, "_tag, ");
    if field == 2 {
        try w(out, "%kizu.slice.u8");
    }
    if field != 2 {
        try w(out, "i64");
    }
    try w(out, " %v");
    try wi(out, payload_value);
    try w(out, ", ");
    try wi(out, field);
    try nl(out);
    return;
}

// render_union_pack_empty closes a payload-less UNION_PACK by zeroing field 1.
fn render_union_pack_empty(out: &var std::string::String, dst: i64) -> !void {
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = insertvalue %kizu.run.union %v");
    try wi(out, dst);
    try wl(out, "_tag, i64 0, 1");
    return;
}

// render_union_tag reads a runtime union value's declaration-order tag.
fn render_union_tag(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let src = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.run.union %v");
    try wi(out, src);
    try wl(out, ", 0");
    return;
}

// render_union_payload extracts a runtime union value's payload field: field 1
// carries an i64 payload, field 2 a slice payload.
fn render_union_payload(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let src = try code.get(index + 2);
    let payload_kind = try code.get(index + 3);
    let kind_slice = codegen::code_kind_slice();
    let field = union_payload_field(payload_kind, kind_slice);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.run.union %v");
    try wi(out, src);
    try w(out, ", ");
    try wi(out, field);
    try nl(out);
    return;
}

// union_payload_field maps a payload kind to its aggregate field index.
fn union_payload_field(payload_kind: i64, kind_slice: i64) -> i64 {
    if payload_kind == kind_slice {
        return 2;
    }
    return 1;
}

fn render_struct_pack(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let record_pos = try code.get(index + 2);
    let field_count = try code.get(index + 3);
    try render_struct_pack_fields(out, code, index, dst, record_pos, field_count, 0);
    return;
}

fn render_struct_pack_fields(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    pack_pos: i64,
    dst: i64,
    record_pos: i64,
    field_count: i64,
    index: i64
) -> !void {
    if index >= field_count {
        return;
    }
    try w(out, "  ");
    try render_struct_pack_result(out, dst, index, field_count);
    try w(out, " = insertvalue ");
    try render_struct_decl_type_at(out, code, record_pos);
    try w(out, " ");
    try render_struct_pack_input(out, dst, index);
    try w(out, ", ");
    let field_kind = try struct_decl_field_kind(code, record_pos, index);
    try render_value_type(out, code, field_kind);
    try w(out, " %v");
    let value = try code.get(pack_pos + 4 + index);
    try wi(out, value);
    try w(out, ", ");
    try wi(out, index);
    try nl(out);
    let after = index + 1;
    try render_struct_pack_fields(out, code, pack_pos, dst, record_pos, field_count, after);
    return;
}

fn render_struct_pack_result(
    out: &var std::string::String,
    dst: i64,
    index: i64,
    field_count: i64
) -> !void {
    let next = index + 1;
    if next == field_count {
        try render_struct_pack_result_value(out, dst);
    }
    if next != field_count {
        try render_struct_pack_result_temp(out, dst, index);
    }
    return;
}

fn render_struct_pack_result_value(out: &var std::string::String, dst: i64) -> !void {
    try w(out, "%v");
    try wi(out, dst);
    return;
}

fn render_struct_pack_result_temp(
    out: &var std::string::String,
    dst: i64,
    index: i64
) -> !void {
    try w(out, "%sp");
    try wi(out, dst);
    try w(out, "_");
    try wi(out, index);
    return;
}

fn render_struct_pack_input(
    out: &var std::string::String,
    dst: i64,
    index: i64
) -> !void {
    if index == 0 {
        try w(out, "poison");
    }
    if index != 0 {
        try render_struct_pack_input_temp(out, dst, index);
    }
    return;
}

fn render_struct_pack_input_temp(
    out: &var std::string::String,
    dst: i64,
    index: i64
) -> !void {
    let before = index - 1;
    try w(out, "%sp");
    try wi(out, dst);
    try w(out, "_");
    try wi(out, before);
    return;
}

fn render_struct_field(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let src = try code.get(index + 2);
    let record_pos = try code.get(index + 3);
    let field_index = try code.get(index + 4);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue ");
    try render_struct_decl_type_at(out, code, record_pos);
    try w(out, " %v");
    try wi(out, src);
    try w(out, ", ");
    try wi(out, field_index);
    try nl(out);
    return;
}

// render_str_slice materializes a CONST_STR global as a '%kizu.slice.u8' SSA
// value: an insertvalue pair builds the slice from the '@.kizu.run.s<src>'
// global pointer and its payload byte length.
fn render_str_slice(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let src = try code.get(index + 2);
    let byte_len = try tape_string_length(code, src, 0);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.s");
    try wi(out, src);
    try wl(out, ", 0");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = insertvalue %kizu.slice.u8 %v");
    try wi(out, dst);
    try w(out, "_base, i64 ");
    try wi(out, byte_len);
    try wl(out, ", 1");
    return;
}

// render_print_string_line writes a string print value (its global slice) followed
// by the trailing newline print() appends.
fn render_print_string_line(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    value_id: i64,
    suffix: i64
) -> !void {
    let byte_len = try tape_string_length(code, value_id, 0);
    try render_print_string(out, value_id, byte_len, suffix);
    try render_print_newline(out, suffix);
    return;
}

// render_print_bool_line selects the 'true'/'false' word payload (each carries
// its own trailing newline) from the i1 value and writes it to stdout.
fn render_print_bool_line(out: &var std::string::String, value_id: i64, suffix: i64) -> !void {
    try w(out, "  %pb");
    try wi(out, suffix);
    try w(out, "_ptr = select i1 %v");
    try wi(out, value_id);
    try wl(out, ", ptr @.kizu.run.bool_true, ptr @.kizu.run.bool_false");
    try w(out, "  %pb");
    try wi(out, suffix);
    try w(out, "_len = select i1 %v");
    try wi(out, value_id);
    try wl(out, ", i64 5, i64 6");
    try w(out, "  %pb");
    try wi(out, suffix);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr %pb");
    try wi(out, suffix);
    try wl(out, "_ptr, 0");
    try w(out, "  %pb");
    try wi(out, suffix);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %pb");
    try wi(out, suffix);
    try w(out, "_base, i64 %pb");
    try wi(out, suffix);
    try wl(out, "_len, 1");
    try w(out, "  %pb");
    try wi(out, suffix);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %pb");
    try wi(out, suffix);
    try wl(out, "_slice)");
    return;
}

// render_print_i64_line formats an i64 print value through the decimal helper then
// writes the trailing newline.
fn render_print_i64_line(out: &var std::string::String, value_id: i64, suffix: i64) -> !void {
    try render_print_i64(out, value_id, suffix);
    try render_print_newline(out, suffix);
    return;
}

// tape_string_length scans the tape for the CONST_STR record whose dst is value_id
// and returns its payload byte length, so the print slice carries the exact length.
fn tape_string_length(
    code: &std::array::Array<i64>,
    value_id: i64,
    index: i64
) -> !i64 {
    if index >= code.len() {
        return error("render: print string value has no CONST_STR record");
    }
    let op = try code.get(index);
    let const_str = codegen::code_op_const_str();
    let next = try tape_record_end(code, index);
    if op == const_str {
        let dst = try code.get(index + 1);
        if dst == value_id {
            return try tape_const_str_payload_length(code, index);
        }
    }
    return try tape_string_length(code, value_id, next);
}

// tape_const_str_payload_length returns the payload byte length of the CONST_STR
// record at index: the sum of its segment span lengths plus one joining newline
// byte between consecutive segments. The lowering only emits records with at
// least one segment, so the join count 'seg_count - 1' is never negative.
fn tape_const_str_payload_length(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let seg_count = try code.get(index + 2);
    let joins = seg_count - 1;
    let spans = try tape_const_str_spans_length(code, index, seg_count, 0);
    return spans + joins;
}

// tape_const_str_spans_length sums the payload span lengths of the CONST_STR
// record's segments [seg, seg_count).
fn tape_const_str_spans_length(
    code: &std::array::Array<i64>,
    index: i64,
    seg_count: i64,
    seg: i64
) -> !i64 {
    if seg >= seg_count {
        return 0;
    }
    // Bind each span slot so the get() calls take locals rather than nested
    // binary args (the call-arg lowering only models 'base + <int literal>').
    let span_slots = seg * 2;
    let start_slot = index + 3 + span_slots;
    let end_slot = start_slot + 1;
    let seg_start = try code.get(start_slot);
    let seg_end = try code.get(end_slot);
    let seg_len = seg_end - seg_start;
    let after = seg + 1;
    let rest = try tape_const_str_spans_length(code, index, seg_count, after);
    return seg_len + rest;
}

fn render_print_string(
    out: &var std::string::String,
    value_id: i64,
    byte_len: i64,
    suffix: i64
) -> !void {
    try w(out, "  %ps");
    try wi(out, suffix);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.s");
    try wi(out, value_id);
    try wl(out, ", 0");
    try w(out, "  %ps");
    try wi(out, suffix);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %ps");
    try wi(out, suffix);
    try w(out, "_base, i64 ");
    try wi(out, byte_len);
    try wl(out, ", 1");
    try w(out, "  %ps");
    try wi(out, suffix);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %ps");
    try wi(out, suffix);
    try wl(out, "_slice)");
    return;
}

fn render_print_i64(out: &var std::string::String, value_id: i64, suffix: i64) -> !void {
    try w(out, "  %pi");
    try wi(out, suffix);
    try w(out, "_dec = call %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %v");
    try wi(out, value_id);
    try wl(out, ")");
    try w(out, "  %pi");
    try wi(out, suffix);
    try w(out, "_slice = extractvalue %kizu.error.slice.u8 %pi");
    try wi(out, suffix);
    try wl(out, "_dec, 1");
    try w(out, "  %pi");
    try wi(out, suffix);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %pi");
    try wi(out, suffix);
    try wl(out, "_slice)");
    return;
}

// render_print_newline writes the trailing newline print() appends after its payload.
fn render_print_newline(out: &var std::string::String, suffix: i64) -> !void {
    try w(out, "  %pn");
    try wi(out, suffix);
    try wl(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.newline, 0");
    try w(out, "  %pn");
    try wi(out, suffix);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %pn");
    try wi(out, suffix);
    try wl(out, "_base, i64 1, 1");
    try w(out, "  %pn");
    try wi(out, suffix);
    try w(out, "_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %pn");
    try wi(out, suffix);
    try wl(out, "_slice)");
    return;
}

fn render_main_wrapper(out: &var std::string::String) -> !void {
    try wl(out, "define i32 @main(i32 %argc, ptr %argv) {");
    try wl(out, "entry:");
    try wl(out, "  call void @kizu_host_init(i32 %argc, ptr %argv)");
    try wl(out, "  %code = call i64 @kizu_run_main()");
    try wl(out, "  %exit = trunc i64 %code to i32");
    try wl(out, "  ret i32 %exit");
    try wl(out, "}");
    return;
}

// tape_call_record_end returns the index past a CALL record, reading its trailing
// variable arg-id count (kept out of tape_record_end so the call branch stays a
// single-statement return the compiled-MIR if-lowering models).
fn tape_call_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let arg_count = try code.get(index + 4);
    return index + 5 + arg_count;
}

fn tape_method_call_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let arg_count = try code.get(index + 6);
    return index + 7 + arg_count;
}

// tape_try_call_record_end returns the index past a TRY_CALL record. TRY_CALL has
// no result value, so its arg-id list begins at index + 4 (one slot earlier than
// CALL's, which carries a leading result value id).
fn tape_try_call_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let arg_count = try code.get(index + 3);
    return index + 4 + arg_count;
}

// tape_const_str_record_end returns the index past a CONST_STR record, reading
// its segment count ('op dst seg_count start1 end1 ... startN endN').
fn tape_const_str_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let seg_count = try code.get(index + 2);
    let span_slots = seg_count * 2;
    return index + 3 + span_slots;
}

// tape_struct_lit_record_end returns the index past a STRUCT_LIT record, reading
// its field count ('op dst type_start type_end field_count [name_start name_end value] per field').
// The renderer emits nothing for the record itself: struct field reads were
// already resolved to the field values' own ids at lowering time.
fn tape_struct_lit_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let field_count = try code.get(index + 4);
    let field_slots = field_count * 3;
    return index + 5 + field_slots;
}

// tape_arena_add_struct_record_end returns the index past an ARENA_ADD_STRUCT
// record ('op dst arena payload_size field_count [offset size kind value]...').
fn tape_arena_add_struct_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let field_count = try code.get(index + 4);
    let field_slots = field_count * 4;
    return index + 5 + field_slots;
}

// tape_var_struct_record_end returns the index past a VAR_STRUCT record, reading
// its field count ('op dst field_count [name_start name_end slot kind] per
// field'). The renderer emits nothing for the record itself: field reads and
// assignments were already lowered onto the slot trios.
fn tape_var_struct_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let field_count = try code.get(index + 2);
    let field_slots = field_count * 4;
    return index + 3 + field_slots;
}

// tape_record_end returns the tape index just past the record beginning at index,
// using each opcode's fixed arity (CALL carries a trailing variable arg-id list).
// tape_union_decl_record_end steps past a UNION_DECL record: the fixed head
// ('op name_start name_end variant_count') plus three slots per variant.
fn tape_union_decl_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let variant_count = try code.get(index + 3);
    let entry_slots = variant_count * 3;
    return index + 4 + entry_slots;
}

// tape_enum_decl_record_end steps past an ENUM_DECL record: the fixed head plus
// two source-span slots per variant.
fn tape_enum_decl_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let variant_count = try code.get(index + 3);
    let entry_slots = variant_count * 2;
    return index + 4 + entry_slots;
}

fn tape_struct_param_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let field_count = try code.get(index + 1);
    let field_slots = field_count * 3;
    return index + 2 + field_slots;
}

fn tape_struct_decl_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let field_count = try code.get(index + 3);
    let field_slots = field_count * 3;
    return index + 4 + field_slots;
}

fn tape_struct_pack_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let field_count = try code.get(index + 3);
    return index + 4 + field_count;
}

fn tape_record_end(code: &std::array::Array<i64>, index: i64) -> !i64 {
    let op = try code.get(index);
    let const_int = codegen::code_op_const_int();
    if op == const_int {
        return index + 3;
    }
    let const_bool = codegen::code_op_const_bool();
    if op == const_bool {
        return index + 3;
    }
    let not_op = codegen::code_op_not();
    if op == not_op {
        return index + 3;
    }
    let const_str = codegen::code_op_const_str();
    if op == const_str {
        return try tape_const_str_record_end(code, index);
    }
    let str_slice = codegen::code_op_str_slice();
    if op == str_slice {
        return index + 3;
    }
    let try_io_write = codegen::code_op_try_io_write();
    if op == try_io_write {
        return index + 4;
    }
    let page_allocator = codegen::code_op_page_allocator();
    if op == page_allocator {
        return index + 2;
    }
    let string_new = codegen::code_op_string_new();
    if op == string_new {
        return index + 3;
    }
    let string_as_bytes = codegen::code_op_string_as_bytes();
    if op == string_as_bytes {
        return index + 3;
    }
    let mem_equal_bytes = codegen::code_op_mem_equal_bytes();
    if op == mem_equal_bytes {
        return index + 4;
    }
    let try_string_append_i64 = codegen::code_op_try_string_append_i64();
    if op == try_string_append_i64 {
        return index + 3;
    }
    let try_string_append_bool = codegen::code_op_try_string_append_bool();
    if op == try_string_append_bool {
        return index + 3;
    }
    let try_string_append_bytes_literal = codegen::code_op_try_string_append_bytes_literal();
    if op == try_string_append_bytes_literal {
        return index + 3;
    }
    let try_string_append_byte = codegen::code_op_try_string_append_byte();
    if op == try_string_append_byte {
        return index + 3;
    }
    let mem_page_allocator = codegen::code_op_mem_page_allocator();
    if op == mem_page_allocator {
        return index + 2;
    }
    let storage_new = codegen::code_op_storage_new();
    if op == storage_new {
        return index + 5;
    }
    let storage_deinit = codegen::code_op_storage_deinit();
    if op == storage_deinit {
        return index + 3;
    }
    let arena_new = codegen::code_op_arena_new();
    if op == arena_new {
        return index + 6;
    }
    let arena_deinit = codegen::code_op_arena_deinit();
    if op == arena_deinit {
        return index + 2;
    }
    let string_len = codegen::code_op_string_len();
    if op == string_len {
        return index + 3;
    }
    let try_string_append = codegen::code_op_try_string_append_bytes();
    if op == try_string_append {
        return index + 3;
    }
    let array_len = codegen::code_op_array_len();
    if op == array_len {
        return index + 3;
    }
    let try_array_append = codegen::code_op_try_array_append_i64();
    if op == try_array_append {
        return index + 3;
    }
    let try_array_append_value = codegen::code_op_try_array_append();
    if op == try_array_append_value {
        return index + 4;
    }
    let try_array_get = codegen::code_op_try_array_get_i64();
    if op == try_array_get {
        return index + 4;
    }
    let try_array_get_value = codegen::code_op_try_array_get();
    if op == try_array_get_value {
        return index + 5;
    }
    let array_get = codegen::code_op_array_get_i64();
    if op == array_get {
        return index + 4;
    }
    let array_get_value = codegen::code_op_array_get();
    if op == array_get_value {
        return index + 5;
    }
    let try_map_insert = codegen::code_op_try_map_insert_i64();
    if op == try_map_insert {
        return index + 4;
    }
    let map_contains = codegen::code_op_map_contains();
    if op == map_contains {
        return index + 4;
    }
    let map_len = codegen::code_op_map_len();
    if op == map_len {
        return index + 3;
    }
    let try_map_get = codegen::code_op_try_map_get_i64();
    if op == try_map_get {
        return index + 4;
    }
    let arena_add = codegen::code_op_arena_add_slice_struct();
    if op == arena_add {
        return index + 4;
    }
    let arena_get = codegen::code_op_arena_get_slice_struct_field();
    if op == arena_get {
        return index + 4;
    }
    let arena_add_struct = codegen::code_op_arena_add_struct();
    if op == arena_add_struct {
        return try tape_arena_add_struct_record_end(code, index);
    }
    let arena_get_struct = codegen::code_op_arena_get_struct_field();
    if op == arena_get_struct {
        return index + 7;
    }
    let struct_lit = codegen::code_op_struct_lit();
    if op == struct_lit {
        return try tape_struct_lit_record_end(code, index);
    }
    let enum_const = codegen::code_op_enum_const();
    if op == enum_const {
        return index + 7;
    }
    let enum_decl = codegen::code_op_enum_decl();
    if op == enum_decl {
        return try tape_enum_decl_record_end(code, index);
    }
    let union_const = codegen::code_op_union_const();
    if op == union_const {
        return index + 8;
    }
    let union_decl = codegen::code_op_union_decl();
    if op == union_decl {
        return try tape_union_decl_record_end(code, index);
    }
    let union_pack = codegen::code_op_union_pack();
    if op == union_pack {
        return index + 5;
    }
    let union_tag = codegen::code_op_union_tag();
    if op == union_tag {
        return index + 3;
    }
    let union_payload = codegen::code_op_union_payload();
    if op == union_payload {
        return index + 4;
    }
    let struct_decl = codegen::code_op_struct_decl();
    if op == struct_decl {
        return try tape_struct_decl_record_end(code, index);
    }
    let struct_pack = codegen::code_op_struct_pack();
    if op == struct_pack {
        return try tape_struct_pack_record_end(code, index);
    }
    let struct_field = codegen::code_op_struct_field();
    if op == struct_field {
        return index + 5;
    }
    let binary = codegen::code_op_binary();
    if op == binary {
        return index + 5;
    }
    let sc_begin = codegen::code_op_sc_begin();
    if op == sc_begin {
        return index + 4;
    }
    let sc_end = codegen::code_op_sc_end();
    if op == sc_end {
        return index + 4;
    }
    let call = codegen::code_op_call();
    if op == call {
        return try tape_call_record_end(code, index);
    }
    let method_call = codegen::code_op_method_call();
    if op == method_call {
        return try tape_method_call_record_end(code, index);
    }
    let try_call = codegen::code_op_try_call();
    if op == try_call {
        return try tape_try_call_record_end(code, index);
    }
    let try_call_i64 = codegen::code_op_try_call_i64();
    if op == try_call_i64 {
        return try tape_call_record_end(code, index);
    }
    let expect_op = codegen::code_op_expect();
    if op == expect_op {
        return index + 2;
    }
    let ret_err_fail = codegen::code_op_ret_err_fail();
    if op == ret_err_fail {
        return index + 2;
    }
    let io_blocking = codegen::code_op_io_blocking();
    if op == io_blocking {
        return index + 2;
    }
    let try_fs_read = codegen::code_op_try_fs_read();
    if op == try_fs_read {
        return index + 4;
    }
    let print_op = codegen::code_op_print();
    if op == print_op {
        return index + 3;
    }
    let func_begin = codegen::code_op_func_begin();
    if op == func_begin {
        return index + 6;
    }
    let method_func_begin = codegen::code_op_method_func_begin();
    if op == method_func_begin {
        return index + 8;
    }
    let struct_param = codegen::code_op_struct_param();
    if op == struct_param {
        return try tape_struct_param_record_end(code, index);
    }
    let func_end = codegen::code_op_func_end();
    if op == func_end {
        return index + 1;
    }
    let ret_void = codegen::code_op_ret_void();
    if op == ret_void {
        return index + 1;
    }
    let ret_value = codegen::code_op_ret_value();
    if op == ret_value {
        return index + 2;
    }
    let if_begin = codegen::code_op_if_begin();
    if op == if_begin {
        return index + 2;
    }
    let if_else = codegen::code_op_if_else();
    if op == if_else {
        return index + 2;
    }
    let if_end = codegen::code_op_if_end();
    if op == if_end {
        return index + 2;
    }
    let var_decl = codegen::code_op_var_decl();
    if op == var_decl {
        return index + 3;
    }
    let var_load = codegen::code_op_var_load();
    if op == var_load {
        return index + 3;
    }
    let var_store = codegen::code_op_var_store();
    if op == var_store {
        return index + 3;
    }
    let var_decl_slice = codegen::code_op_var_decl_slice();
    if op == var_decl_slice {
        return index + 3;
    }
    let var_load_slice = codegen::code_op_var_load_slice();
    if op == var_load_slice {
        return index + 3;
    }
    let var_store_slice = codegen::code_op_var_store_slice();
    if op == var_store_slice {
        return index + 3;
    }
    let var_decl_bool = codegen::code_op_var_decl_bool();
    if op == var_decl_bool {
        return index + 3;
    }
    let var_load_bool = codegen::code_op_var_load_bool();
    if op == var_load_bool {
        return index + 3;
    }
    let var_store_bool = codegen::code_op_var_store_bool();
    if op == var_store_bool {
        return index + 3;
    }
    let var_struct = codegen::code_op_var_struct();
    if op == var_struct {
        return try tape_var_struct_record_end(code, index);
    }
    let while_begin = codegen::code_op_while_begin();
    if op == while_begin {
        return index + 2;
    }
    let while_cond = codegen::code_op_while_cond();
    if op == while_cond {
        return index + 3;
    }
    let while_end = codegen::code_op_while_end();
    if op == while_end {
        return index + 2;
    }
    let for_begin = codegen::code_op_for_begin();
    if op == for_begin {
        return index + 7;
    }
    let for_end = codegen::code_op_for_end();
    if op == for_end {
        return index + 5;
    }
    let break_op = codegen::code_op_break();
    if op == break_op {
        return index + 3;
    }
    let continue_op = codegen::code_op_continue();
    if op == continue_op {
        return index + 3;
    }
    return code.len();
}

fn render_llvm_c_bytes(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        try render_llvm_c_byte(out, byte);
        index = index + 1;
    }
    return;
}

fn render_llvm_c_byte(out: &var std::string::String, byte: u8) -> !void {
    // Escape the three c-string metacharacters through mutually exclusive void
    // then-body guards and append any other byte verbatim, falling through to a
    // single return -- the shape both the Go reference compiler and the compiled-MIR
    // void if-lowering accept (a 'return try <void call>;' tail is rejected by the former).
    let quote = cast<u8>(34);
    let backslash = cast<u8>(92);
    let newline = cast<u8>(10);
    let is_special = byte == quote or byte == backslash or byte == newline;
    if byte == quote {
        try w(out, "\22");
    }
    if byte == backslash {
        try w(out, "\5C");
    }
    if byte == newline {
        try w(out, "\0A");
    }
    if !is_special {
        try out.append_byte(byte);
    }
    return;
}
