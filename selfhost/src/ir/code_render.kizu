        try render_try_typed_error_void_propagate_err_i64(out, index);
    }
    if abi == typed_err_void {
        try render_try_typed_error_void_propagate_err_void(out, index);
    }
    return;
}

fn render_try_typed_error_void_propagate_err_i64(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.union.void %tc");
    try wi(out, index);
    try wl(out, ", 1");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.union.i64 { i1 false, i64 0, %kizu.run.union zeroinitializer }, %kizu.run.union %tc");
    try wi(out, index);
    try wl(out, "_pm, 2");
    try w(out, "  ret %kizu.error.union.i64 %tc");
    try wi(out, index);
    try wl(out, "_pv");
    return;
}

fn render_try_typed_error_void_propagate_err_void(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.union.void %tc");
    try wi(out, index);
    try wl(out, ", 1");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.union.void { i1 false, %kizu.run.union zeroinitializer }, %kizu.run.union %tc");
    try wi(out, index);
    try wl(out, "_pm, 1");
    try w(out, "  ret %kizu.error.union.void %tc");
    try wi(out, index);
