    try wi(out, receiver);
    try w(out, ", i64 %v");
    try wi(out, item_index);
    try wl(out, ")");
    try w(out, "  %ag");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.slice.u8 %ag");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %ag");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
