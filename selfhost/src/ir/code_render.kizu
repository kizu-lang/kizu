// render_expect branches on the lowered i1 expectation: the fail block traps the
// process with the runtime expectation message (stderr + exit 1, noreturn), and
// the cont block resumes the body. Labels are suffixed with the record's tape
// index so they stay unique.
fn render_expect(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let cond = try code.get(index + 1);
    let message_len = std::mem::len(expect_fail_message());
    let payload_len = message_len + 1;
    try w(out, "  br i1 %v");
    try wi(out, cond);
    try w(out, ", label %ex");
    try wi(out, index);
    try w(out, "_cont, label %ex");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "ex");
    try wi(out, index);
    try wl(out, "_fail:");
    try w(out, "  %ex");
    try wi(out, index);
    try wl(out, "_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.expect_fail, 0");
    try w(out, "  %ex");
    try wi(out, index);
    try w(out, "_slice = insertvalue %kizu.slice.u8 %ex");
    try wi(out, index);
    try w(out, "_base, i64 ");
    try wi(out, payload_len);
    try wl(out, ", 1");
    try w(out, "  call void @kizu_rt_trap(%kizu.slice.u8 %ex");
    try wi(out, index);
    try wl(out, "_slice)");
    try wl(out, "  unreachable");
    try w(out, "ex");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

// render_try_propagate emits the fail-block terminator for a try: the kizu_run_main
// entry exits the process with code 1, every other (error-union-void) function
// returns the propagated error union.
fn render_try_propagate(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    try render_error_cleanup(out, code, index);
    let main_abi = ret_abi_main();
    if abi == main_abi {
        try render_try_propagate_exit(out, index);
    }
    if abi != main_abi {
        try render_try_propagate_error(out, index, abi);
    }
    return;
}

fn render_try_propagate_exit(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try wl(out, "_exit = call i64 @kizu_rt_process_exit_code(i64 1)");
    try w(out, "  ret i64 %tc");
    try wi(out, index);
    try wl(out, "_exit");
    return;
}

fn render_try_propagate_error(out: &var std::string::String, index: i64, abi: i64) -> !void {
    let err_i64 = ret_abi_user_err_i64();
    let err_owned = ret_abi_user_err_owned();
    if abi == err_i64 {
        try render_try_propagate_error_i64(out, index);
    }
    if abi == err_owned {
        try render_try_propagate_error_owned(out, index);
    }
    if abi != err_i64 {
        if abi != err_owned {
            try render_try_propagate_error_void(out, index);
        }
    }
    return;
}

// render_try_propagate_error_i64 re-wraps a failed '%kizu.error.void' try into the
// surrounding error-union-i64 function's own union.
fn render_try_propagate_error_i64(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_emsg = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 1");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_eu = insertvalue %kizu.error.i64 { i1 false, i64 0, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_emsg, 2");
    try w(out, "  ret %kizu.error.i64 %tc");
    try wi(out, index);
    try wl(out, "_eu");
    return;
}

// render_try_propagate_error_owned re-wraps a failed '%kizu.error.void' try into
// the surrounding '!std::string::String' function's own failed '%kizu.error.owned'
// union.
fn render_try_propagate_error_owned(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_emsg = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 1");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_eu = insertvalue %kizu.error.owned { i1 false, %kizu.owned zeroinitializer, %kizu.slice.u8 zeroinitializer }, %kizu.slice.u8 %tc");
    try wi(out, index);
    try wl(out, "_emsg, 2");
    try w(out, "  ret %kizu.error.owned %tc");
    try wi(out, index);
    try wl(out, "_eu");
    return;
}

fn render_try_propagate_error_void(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  ret %kizu.error.void %tc");
    try wi(out, index);
    try nl(out);
    return;
}

// render_io_blocking emits 'std::io::blocking()': a runtime io handle into the
// result value (a '%kizu.owned' SSA value).
fn render_io_blocking(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    try w(out, "  %v");
    try wi(out, dst);
    try wl(out, " = call %kizu.owned @kizu_rt_io_blocking()");
    return;
}

fn render_page_allocator(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    try w(out, "  %v");
    try wi(out, dst);
    try wl(out, " = call %kizu.owned @kizu_rt_mem_page_allocator()");
    return;
}

fn render_string_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let allocator = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.owned @kizu_rt_string_new(%kizu.owned %v");
    try wi(out, allocator);
    try wl(out, ")");
    return;
}

fn render_string_as_bytes(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let text_value = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %v");
    try wi(out, text_value);
    try wl(out, ")");
    return;
}

fn render_mem_equal_bytes(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let left = try code.get(index + 2);
    let right = try code.get(index + 3);
    try w(out, "  %eb");
    try wi(out, index);
    try wl(out, "_i = alloca i64");
    try w(out, "  %eb");
    try wi(out, index);
    try wl(out, "_result = alloca i1");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_left_ptr = extractvalue %kizu.slice.u8 %v");
    try wi(out, left);
    try wl(out, ", 0");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_left_len = extractvalue %kizu.slice.u8 %v");
    try wi(out, left);
    try wl(out, ", 1");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_right_ptr = extractvalue %kizu.slice.u8 %v");
    try wi(out, right);
    try wl(out, ", 0");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_right_len = extractvalue %kizu.slice.u8 %v");
    try wi(out, right);
    try wl(out, ", 1");
    try w(out, "  store i64 0, ptr %eb");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  store i1 false, ptr %eb");
    try wi(out, index);
    try wl(out, "_result");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_len_eq = icmp eq i64 %eb");
    try wi(out, index);
    try w(out, "_left_len, %eb");
    try wi(out, index);
    try wl(out, "_right_len");
    try w(out, "  br i1 %eb");
    try wi(out, index);
    try w(out, "_len_eq, label %ebcheck_");
    try wi(out, index);
    try w(out, ", label %ebdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebcheck_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_index = load i64, ptr %eb");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_at_end = icmp sge i64 %eb");
    try wi(out, index);
    try w(out, "_index, %eb");
    try wi(out, index);
    try wl(out, "_left_len");
    try w(out, "  br i1 %eb");
    try wi(out, index);
    try w(out, "_at_end, label %ebsuccess_");
    try wi(out, index);
    try w(out, ", label %ebcompare_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebcompare_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_left_byte_ptr = getelementptr i8, ptr %eb");
    try wi(out, index);
    try w(out, "_left_ptr, i64 %eb");
    try wi(out, index);
    try wl(out, "_index");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_right_byte_ptr = getelementptr i8, ptr %eb");
    try wi(out, index);
    try w(out, "_right_ptr, i64 %eb");
    try wi(out, index);
    try wl(out, "_index");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_left_byte = load i8, ptr %eb");
    try wi(out, index);
    try wl(out, "_left_byte_ptr");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_right_byte = load i8, ptr %eb");
    try wi(out, index);
    try wl(out, "_right_byte_ptr");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_byte_eq = icmp eq i8 %eb");
    try wi(out, index);
    try w(out, "_left_byte, %eb");
    try wi(out, index);
    try wl(out, "_right_byte");
    try w(out, "  br i1 %eb");
    try wi(out, index);
    try w(out, "_byte_eq, label %ebnext_");
    try wi(out, index);
    try w(out, ", label %ebdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebnext_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %eb");
    try wi(out, index);
    try w(out, "_next = add i64 %eb");
    try wi(out, index);
    try wl(out, "_index, 1");
    try w(out, "  store i64 %eb");
    try wi(out, index);
    try w(out, "_next, ptr %eb");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  br label %ebcheck_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebsuccess_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  store i1 true, ptr %eb");
    try wi(out, index);
    try wl(out, "_result");
    try w(out, "  br label %ebdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "ebdone_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i1, ptr %eb");
    try wi(out, index);
    try wl(out, "_result");
    return;
}

// render_mem_starts_with lowers MEM_STARTS_WITH into the i1 result '%v<dst>'. It
// mirrors render_mem_equal_bytes but guards on 'prefix_len <= bytes_len' (rather
// than length equality) and iterates over the prefix length: a prefix longer than
// the bytes yields false, otherwise the first byte mismatch yields false and a
// fully matched prefix yields true. The '%sw<index>_*' temporaries and 'sw*_'
// labels are keyed by the record position so they stay unique.
fn render_mem_starts_with(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let bytes = try code.get(index + 2);
    let prefix = try code.get(index + 3);
    try w(out, "  %sw");
    try wi(out, index);
    try wl(out, "_i = alloca i64");
    try w(out, "  %sw");
    try wi(out, index);
    try wl(out, "_result = alloca i1");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_bytes_ptr = extractvalue %kizu.slice.u8 %v");
    try wi(out, bytes);
    try wl(out, ", 0");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_bytes_len = extractvalue %kizu.slice.u8 %v");
    try wi(out, bytes);
    try wl(out, ", 1");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_prefix_ptr = extractvalue %kizu.slice.u8 %v");
    try wi(out, prefix);
    try wl(out, ", 0");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_prefix_len = extractvalue %kizu.slice.u8 %v");
    try wi(out, prefix);
    try wl(out, ", 1");
    try w(out, "  store i64 0, ptr %sw");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  store i1 false, ptr %sw");
    try wi(out, index);
    try wl(out, "_result");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_len_ok = icmp sle i64 %sw");
    try wi(out, index);
    try w(out, "_prefix_len, %sw");
    try wi(out, index);
    try wl(out, "_bytes_len");
    try w(out, "  br i1 %sw");
    try wi(out, index);
    try w(out, "_len_ok, label %swcheck_");
    try wi(out, index);
    try w(out, ", label %swdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "swcheck_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_index = load i64, ptr %sw");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_at_end = icmp sge i64 %sw");
    try wi(out, index);
    try w(out, "_index, %sw");
    try wi(out, index);
    try wl(out, "_prefix_len");
    try w(out, "  br i1 %sw");
    try wi(out, index);
    try w(out, "_at_end, label %swsuccess_");
    try wi(out, index);
    try w(out, ", label %swcompare_");
    try wi(out, index);
    try nl(out);
    try w(out, "swcompare_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_bytes_byte_ptr = getelementptr i8, ptr %sw");
    try wi(out, index);
    try w(out, "_bytes_ptr, i64 %sw");
    try wi(out, index);
    try wl(out, "_index");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_prefix_byte_ptr = getelementptr i8, ptr %sw");
    try wi(out, index);
    try w(out, "_prefix_ptr, i64 %sw");
    try wi(out, index);
    try wl(out, "_index");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_bytes_byte = load i8, ptr %sw");
    try wi(out, index);
    try wl(out, "_bytes_byte_ptr");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_prefix_byte = load i8, ptr %sw");
    try wi(out, index);
    try wl(out, "_prefix_byte_ptr");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_byte_eq = icmp eq i8 %sw");
    try wi(out, index);
    try w(out, "_bytes_byte, %sw");
    try wi(out, index);
    try wl(out, "_prefix_byte");
    try w(out, "  br i1 %sw");
    try wi(out, index);
    try w(out, "_byte_eq, label %swnext_");
    try wi(out, index);
    try w(out, ", label %swdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "swnext_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %sw");
    try wi(out, index);
    try w(out, "_next = add i64 %sw");
    try wi(out, index);
    try wl(out, "_index, 1");
    try w(out, "  store i64 %sw");
    try wi(out, index);
    try w(out, "_next, ptr %sw");
    try wi(out, index);
    try wl(out, "_i");
    try w(out, "  br label %swcheck_");
    try wi(out, index);
    try nl(out);
    try w(out, "swsuccess_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  store i1 true, ptr %sw");
    try wi(out, index);
    try wl(out, "_result");
    try w(out, "  br label %swdone_");
    try wi(out, index);
    try nl(out);
    try w(out, "swdone_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = load i1, ptr %sw");
    try wi(out, index);
    try wl(out, "_result");
    return;
}

// render_mem_trim_ascii lowers MEM_TRIM_ASCII into the trimmed sub-slice '%v<dst>'.
// It scans the head forward past ASCII whitespace bytes (advancing a start cursor)
// and the tail backward past ASCII whitespace bytes (retreating an end cursor),
// then assembles a fresh '%kizu.slice.u8' aggregate '{ptr+start, end-start}'. The
// whitespace test matches std::mem::is_ascii_space ({9,10,11,12,13,32}) as
// 'byte == 32 or (byte >= 9 and byte <= 13)'. The '%ta<index>_*' temporaries and
// 'ta*_' labels are keyed by the record position so they stay unique.
fn render_mem_trim_ascii(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slice_value = try code.get(index + 2);
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_ptr = extractvalue %kizu.slice.u8 %v");
    try wi(out, slice_value);
    try wl(out, ", 0");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_len = extractvalue %kizu.slice.u8 %v");
    try wi(out, slice_value);
    try wl(out, ", 1");
    try w(out, "  %ta");
    try wi(out, index);
    try wl(out, "_start = alloca i64");
    try w(out, "  %ta");
    try wi(out, index);
    try wl(out, "_end = alloca i64");
    try w(out, "  store i64 0, ptr %ta");
    try wi(out, index);
    try wl(out, "_start");
    try w(out, "  store i64 %ta");
    try wi(out, index);
    try w(out, "_len, ptr %ta");
    try wi(out, index);
    try wl(out, "_end");
    try w(out, "  br label %tahead_");
    try wi(out, index);
    try nl(out);
    try w(out, "tahead_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_s = load i64, ptr %ta");
    try wi(out, index);
    try wl(out, "_start");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_e = load i64, ptr %ta");
    try wi(out, index);
    try wl(out, "_end");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_head_lt = icmp slt i64 %ta");
    try wi(out, index);
    try w(out, "_s, %ta");
    try wi(out, index);
    try wl(out, "_e");
    try w(out, "  br i1 %ta");
    try wi(out, index);
    try w(out, "_head_lt, label %taheadcheck_");
    try wi(out, index);
    try w(out, ", label %tatail_");
    try wi(out, index);
    try nl(out);
    try w(out, "taheadcheck_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_head_gep = getelementptr i8, ptr %ta");
    try wi(out, index);
    try w(out, "_ptr, i64 %ta");
    try wi(out, index);
    try wl(out, "_s");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_head_byte = load i8, ptr %ta");
    try wi(out, index);
    try wl(out, "_head_gep");
    try render_ascii_space_test(out, index, "head");
    try w(out, "  br i1 %ta");
    try wi(out, index);
    try w(out, "_head_space, label %taheadadv_");
    try wi(out, index);
    try w(out, ", label %tatail_");
    try wi(out, index);
    try nl(out);
    try w(out, "taheadadv_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_s_next = add i64 %ta");
    try wi(out, index);
    try wl(out, "_s, 1");
    try w(out, "  store i64 %ta");
    try wi(out, index);
    try w(out, "_s_next, ptr %ta");
    try wi(out, index);
    try wl(out, "_start");
    try w(out, "  br label %tahead_");
    try wi(out, index);
    try nl(out);
    try w(out, "tatail_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_s2 = load i64, ptr %ta");
    try wi(out, index);
    try wl(out, "_start");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_e2 = load i64, ptr %ta");
    try wi(out, index);
    try wl(out, "_end");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_tail_gt = icmp sgt i64 %ta");
    try wi(out, index);
    try w(out, "_e2, %ta");
    try wi(out, index);
    try wl(out, "_s2");
    try w(out, "  br i1 %ta");
    try wi(out, index);
    try w(out, "_tail_gt, label %tatailcheck_");
    try wi(out, index);
    try w(out, ", label %tabuild_");
    try wi(out, index);
    try nl(out);
    try w(out, "tatailcheck_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_prev = sub i64 %ta");
    try wi(out, index);
    try wl(out, "_e2, 1");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_tail_gep = getelementptr i8, ptr %ta");
    try wi(out, index);
    try w(out, "_ptr, i64 %ta");
    try wi(out, index);
    try wl(out, "_prev");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_tail_byte = load i8, ptr %ta");
    try wi(out, index);
    try wl(out, "_tail_gep");
    try render_ascii_space_test(out, index, "tail");
    try w(out, "  br i1 %ta");
    try wi(out, index);
    try w(out, "_tail_space, label %tatailadv_");
    try wi(out, index);
    try w(out, ", label %tabuild_");
    try wi(out, index);
    try nl(out);
    try w(out, "tatailadv_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  store i64 %ta");
    try wi(out, index);
    try w(out, "_prev, ptr %ta");
    try wi(out, index);
    try wl(out, "_end");
    try w(out, "  br label %tatail_");
    try wi(out, index);
    try nl(out);
    try w(out, "tabuild_");
    try wi(out, index);
    try wl(out, ":");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_fs = load i64, ptr %ta");
    try wi(out, index);
    try wl(out, "_start");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_fe = load i64, ptr %ta");
    try wi(out, index);
    try wl(out, "_end");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_data = getelementptr i8, ptr %ta");
    try wi(out, index);
    try w(out, "_ptr, i64 %ta");
    try wi(out, index);
    try wl(out, "_fs");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_newlen = sub i64 %ta");
    try wi(out, index);
    try w(out, "_fe, %ta");
    try wi(out, index);
    try wl(out, "_fs");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr %ta");
    try wi(out, index);
    try wl(out, "_data, 0");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = insertvalue %kizu.slice.u8 %v");
    try wi(out, dst);
    try w(out, "_base, i64 %ta");
    try wi(out, index);
    try wl(out, "_newlen, 1");
    return;
}

// render_ascii_space_test emits the ASCII-whitespace predicate for the byte temp
// '%ta<index>_<side>_byte' into '%ta<index>_<side>_space', matching
// std::mem::is_ascii_space: 'byte == 32 or (byte >= 9 and byte <= 13)'.
fn render_ascii_space_test(
    out: &var std::string::String,
    index: i64,
    side: []u8
) -> !void {
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try w(out, "_is_sp = icmp eq i8 %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try wl(out, "_byte, 32");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try w(out, "_ge9 = icmp uge i8 %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try wl(out, "_byte, 9");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try w(out, "_le13 = icmp ule i8 %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try wl(out, "_byte, 13");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try w(out, "_ctrl = and i1 %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try w(out, "_ge9, %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try wl(out, "_le13");
    try w(out, "  %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try w(out, "_space = or i1 %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try w(out, "_is_sp, %ta");
    try wi(out, index);
    try w(out, "_");
    try w(out, side);
    try wl(out, "_ctrl");
    return;
}

// ptmp writes a path-record value temp or label reference '%p<index><tag><sub>'.
// Every name the path renderers emit is keyed by the record index for uniqueness;
// the per-block <tag> (e.g. "_bt", or "" for the shared ptr/len/result names)
// keeps repeated loops in one record distinct.
fn ptmp(
    out: &var std::string::String,
    index: i64,
    tag: []u8,
    sub: []u8
) -> !void {
    try w(out, "%p");
    try wi(out, index);
    try w(out, tag);
    try w(out, sub);
    return;
}

// plbl defines the matching path-record block label 'p<index><tag><sub>:' (no '%',
// trailing newline). The reference form is ptmp(out, index, tag, sub).
fn plbl(
    out: &var std::string::String,
    index: i64,
    tag: []u8,
    sub: []u8
) -> !void {
    try w(out, "p");
    try wi(out, index);
    try w(out, tag);
    try w(out, sub);
    try wl(out, ":");
    return;
}

// render_path_extract emits the shared head for a path component op: the source
// slice's pointer and length ('%p<index>_ptr' / '%p<index>_len') plus the result
// pointer/length alloca slots every branch stores into before the build join.
fn render_path_extract(
    out: &var std::string::String,
    index: i64,
    slice_value: i64
) -> !void {
    try w(out, "  ");
    try ptmp(out, index, "", "_ptr");
    try w(out, " = extractvalue %kizu.slice.u8 %v");
    try wi(out, slice_value);
    try wl(out, ", 0");
    try w(out, "  ");
    try ptmp(out, index, "", "_len");
    try w(out, " = extractvalue %kizu.slice.u8 %v");
    try wi(out, slice_value);
    try wl(out, ", 1");
    try w(out, "  ");
    try ptmp(out, index, "", "_rptr");
    try wl(out, " = alloca ptr");
    try w(out, "  ");
    try ptmp(out, index, "", "_rlen");
    try wl(out, " = alloca i64");
    return;
}

// render_path_trim emits std::path_bits::trim_trailing_slashes over '%p<index>_ptr'
// seeded from the length register '%p<index><in_suffix>': it walks the end cursor
// down while end > 1 and the byte before it is '/' (47). The trimmed end lands in
// '%p<index><tag>_end'.
fn render_path_trim(
    out: &var std::string::String,
    index: i64,
    tag: []u8,
    in_suffix: []u8
) -> !void {
    try w(out, "  ");
    try ptmp(out, index, tag, "_slot");
    try wl(out, " = alloca i64");
    try w(out, "  store i64 ");
    try ptmp(out, index, "", in_suffix);
    try w(out, ", ptr ");
    try ptmp(out, index, tag, "_slot");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, tag, "_loop");
    try nl(out);
    try plbl(out, index, tag, "_loop");
    try w(out, "  ");
    try ptmp(out, index, tag, "_e");
    try w(out, " = load i64, ptr ");
    try ptmp(out, index, tag, "_slot");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, tag, "_gt1");
    try w(out, " = icmp sgt i64 ");
    try ptmp(out, index, tag, "_e");
    try wl(out, ", 1");
    try w(out, "  br i1 ");
    try ptmp(out, index, tag, "_gt1");
    try w(out, ", label ");
    try ptmp(out, index, tag, "_chk");
    try w(out, ", label ");
    try ptmp(out, index, tag, "_after");
    try nl(out);
    try plbl(out, index, tag, "_chk");
    try w(out, "  ");
    try ptmp(out, index, tag, "_prev");
    try w(out, " = sub i64 ");
    try ptmp(out, index, tag, "_e");
    try wl(out, ", 1");
    try w(out, "  ");
    try ptmp(out, index, tag, "_gep");
    try w(out, " = getelementptr i8, ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", i64 ");
    try ptmp(out, index, tag, "_prev");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, tag, "_byte");
    try w(out, " = load i8, ptr ");
    try ptmp(out, index, tag, "_gep");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, tag, "_iss");
    try w(out, " = icmp eq i8 ");
    try ptmp(out, index, tag, "_byte");
    try wl(out, ", 47");
    try w(out, "  br i1 ");
    try ptmp(out, index, tag, "_iss");
    try w(out, ", label ");
    try ptmp(out, index, tag, "_adv");
    try w(out, ", label ");
    try ptmp(out, index, tag, "_after");
    try nl(out);
    try plbl(out, index, tag, "_adv");
    try w(out, "  store i64 ");
    try ptmp(out, index, tag, "_prev");
    try w(out, ", ptr ");
    try ptmp(out, index, tag, "_slot");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, tag, "_loop");
    try nl(out);
    try plbl(out, index, tag, "_after");
    try w(out, "  ");
    try ptmp(out, index, tag, "_end");
    try w(out, " = load i64, ptr ");
    try ptmp(out, index, tag, "_slot");
    try nl(out);
    return;
}

// render_path_last_slash emits std::path_bits::last_slash_before over
// '%p<index>_ptr' from the end register '%p<index><end_suffix>' down to 1: the
// index of the last '/' (47) before end lands in '%p<index><tag>_slash', or -1.
fn render_path_last_slash(
    out: &var std::string::String,
    index: i64,
    tag: []u8,
    end_suffix: []u8
) -> !void {
    try w(out, "  ");
    try ptmp(out, index, tag, "_res");
    try wl(out, " = alloca i64");
    try w(out, "  store i64 -1, ptr ");
    try ptmp(out, index, tag, "_res");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, tag, "_idx");
    try wl(out, " = alloca i64");
    try w(out, "  store i64 ");
    try ptmp(out, index, "", end_suffix);
    try w(out, ", ptr ");
    try ptmp(out, index, tag, "_idx");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, tag, "_sloop");
    try nl(out);
    try plbl(out, index, tag, "_sloop");
    try w(out, "  ");
    try ptmp(out, index, tag, "_si");
    try w(out, " = load i64, ptr ");
    try ptmp(out, index, tag, "_idx");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, tag, "_sgt0");
    try w(out, " = icmp sgt i64 ");
    try ptmp(out, index, tag, "_si");
    try wl(out, ", 0");
    try w(out, "  br i1 ");
    try ptmp(out, index, tag, "_sgt0");
    try w(out, ", label ");
    try ptmp(out, index, tag, "_schk");
    try w(out, ", label ");
    try ptmp(out, index, tag, "_safter");
    try nl(out);
    try plbl(out, index, tag, "_schk");
    try w(out, "  ");
    try ptmp(out, index, tag, "_sprev");
    try w(out, " = sub i64 ");
    try ptmp(out, index, tag, "_si");
    try wl(out, ", 1");
    try w(out, "  ");
    try ptmp(out, index, tag, "_sgep");
    try w(out, " = getelementptr i8, ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", i64 ");
    try ptmp(out, index, tag, "_sprev");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, tag, "_sbyte");
    try w(out, " = load i8, ptr ");
    try ptmp(out, index, tag, "_sgep");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, tag, "_siss");
    try w(out, " = icmp eq i8 ");
    try ptmp(out, index, tag, "_sbyte");
    try wl(out, ", 47");
    try w(out, "  br i1 ");
    try ptmp(out, index, tag, "_siss");
    try w(out, ", label ");
    try ptmp(out, index, tag, "_sfound");
    try w(out, ", label ");
    try ptmp(out, index, tag, "_sadv");
    try nl(out);
    try plbl(out, index, tag, "_sfound");
    try w(out, "  store i64 ");
    try ptmp(out, index, tag, "_sprev");
    try w(out, ", ptr ");
    try ptmp(out, index, tag, "_res");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, tag, "_safter");
    try nl(out);
    try plbl(out, index, tag, "_sadv");
    try w(out, "  store i64 ");
    try ptmp(out, index, tag, "_sprev");
    try w(out, ", ptr ");
    try ptmp(out, index, tag, "_idx");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, tag, "_sloop");
    try nl(out);
    try plbl(out, index, tag, "_safter");
    try w(out, "  ");
    try ptmp(out, index, tag, "_slash");
    try w(out, " = load i64, ptr ");
    try ptmp(out, index, tag, "_res");
    try nl(out);
    return;
}

// render_path_store_dot stores the '.' literal result ('{ @.kizu.run.path_dot, 1 }')
// into the result slots and branches to the build join. It backs the empty-path and
// no-slash shapes of basename/dirname.
fn render_path_store_dot(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  store ptr @.kizu.run.path_dot, ptr ");
    try ptmp(out, index, "", "_rptr");
    try nl(out);
    try w(out, "  store i64 1, ptr ");
    try ptmp(out, index, "", "_rlen");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_done");
    try nl(out);
    return;
}

// render_path_store_root stores the '/' root result as the path[0..1] sub-slice
// ('{ ptr, 1 }') and branches to the build join. The byte at offset 0 is always
// '/' on this path, so the sub-slice is byte-identical to the literal "/".
fn render_path_store_root(out: &var std::string::String, index: i64) -> !void {
    try w(out, "  store ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rptr");
    try nl(out);
    try w(out, "  store i64 1, ptr ");
    try ptmp(out, index, "", "_rlen");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_done");
    try nl(out);
    return;
}

// render_path_build defines the 'p<index>_done' join block: it loads the result
// slots and assembles the '%kizu.slice.u8' aggregate '%v<dst>'. Like
// render_mem_trim_ascii it leaves no terminator so the next record continues here.
fn render_path_build(
    out: &var std::string::String,
    index: i64,
    dst: i64
) -> !void {
    try plbl(out, index, "", "_done");
    try w(out, "  ");
    try ptmp(out, index, "", "_fptr");
    try w(out, " = load ptr, ptr ");
    try ptmp(out, index, "", "_rptr");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, "", "_flen");
    try w(out, " = load i64, ptr ");
    try ptmp(out, index, "", "_rlen");
    try nl(out);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr ");
    try ptmp(out, index, "", "_fptr");
    try wl(out, ", 0");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = insertvalue %kizu.slice.u8 %v");
    try wi(out, dst);
    try w(out, "_base, i64 ");
    try ptmp(out, index, "", "_flen");
    try wl(out, ", 1");
    return;
}

// render_path_root_test emits the shared '%p<index>_b0s' predicate
// 'is_slash(path[0])' and, for basename/dirname, the 'end == 1 and is_slash(path[0])'
// root branch. The byte load is dominated by the non-empty guard, so path[0] is
// always in bounds here. '%p<index>_b0s' is reused by dirname's dir_end root check.
fn render_path_root_test(
    out: &var std::string::String,
    index: i64,
    end_suffix: []u8
) -> !void {
    try w(out, "  ");
    try ptmp(out, index, "", "_b0");
    try w(out, " = load i8, ptr ");
    try ptmp(out, index, "", "_ptr");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, "", "_b0s");
    try w(out, " = icmp eq i8 ");
    try ptmp(out, index, "", "_b0");
    try wl(out, ", 47");
    try w(out, "  ");
    try ptmp(out, index, "", "_e1");
    try w(out, " = icmp eq i64 ");
    try ptmp(out, index, "", end_suffix);
    try wl(out, ", 1");
    try w(out, "  ");
    try ptmp(out, index, "", "_root1");
    try w(out, " = and i1 ");
    try ptmp(out, index, "", "_e1");
    try w(out, ", ");
    try ptmp(out, index, "", "_b0s");
    try nl(out);
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_root1");
    try w(out, ", label ");
    try ptmp(out, index, "", "_root");
    try w(out, ", label ");
    try ptmp(out, index, "", "_nr");
    try nl(out);
    try plbl(out, index, "", "_nr");
    return;
}

// render_path_basename lowers PATH_BASENAME following std::path_bits::basename:
// empty -> ".", trailing slashes trimmed to 'end', the "/" root, then the last
// slash before 'end' selects path[0..end] (no slash) or path[slash+1..end].
fn render_path_basename(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slice_value = try code.get(index + 2);
    try render_path_extract(out, index, slice_value);
    try w(out, "  ");
    try ptmp(out, index, "", "_empty");
    try w(out, " = icmp eq i64 ");
    try ptmp(out, index, "", "_len");
    try wl(out, ", 0");
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_empty");
    try w(out, ", label ");
    try ptmp(out, index, "", "_dot");
    try w(out, ", label ");
    try ptmp(out, index, "", "_ne");
    try nl(out);
    try plbl(out, index, "", "_ne");
    try render_path_trim(out, index, "_bt", "_len");
    try render_path_root_test(out, index, "_bt_end");
    try render_path_last_slash(out, index, "_bs", "_bt_end");
    try w(out, "  ");
    try ptmp(out, index, "", "_nosl");
    try w(out, " = icmp slt i64 ");
    try ptmp(out, index, "_bs", "_slash");
    try wl(out, ", 0");
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_nosl");
    try w(out, ", label ");
    try ptmp(out, index, "", "_full");
    try w(out, ", label ");
    try ptmp(out, index, "", "_sub");
    try nl(out);
    try plbl(out, index, "", "_full");
    try w(out, "  store ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rptr");
    try nl(out);
    try w(out, "  store i64 ");
    try ptmp(out, index, "_bt", "_end");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rlen");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_done");
    try nl(out);
    try plbl(out, index, "", "_sub");
    try w(out, "  ");
    try ptmp(out, index, "", "_st");
    try w(out, " = add i64 ");
    try ptmp(out, index, "_bs", "_slash");
    try wl(out, ", 1");
    try w(out, "  ");
    try ptmp(out, index, "", "_dgep");
    try w(out, " = getelementptr i8, ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", i64 ");
    try ptmp(out, index, "", "_st");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, "", "_nl");
    try w(out, " = sub i64 ");
    try ptmp(out, index, "_bt", "_end");
    try w(out, ", ");
    try ptmp(out, index, "", "_st");
    try nl(out);
    try w(out, "  store ptr ");
    try ptmp(out, index, "", "_dgep");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rptr");
    try nl(out);
    try w(out, "  store i64 ");
    try ptmp(out, index, "", "_nl");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rlen");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_done");
    try nl(out);
    try plbl(out, index, "", "_dot");
    try render_path_store_dot(out, index);
    try plbl(out, index, "", "_root");
    try render_path_store_root(out, index);
    try render_path_build(out, index, dst);
    return;
}

// render_path_dirname lowers PATH_DIRNAME following std::path_bits::dirname:
// empty -> ".", the "/" root, no slash -> ".", slash at 0 -> "/", else the parent
// directory is path[0..dir_end] where dir_end trims trailing slashes before the
// final separator (with the dir_end == 1 root collapsing back to "/").
fn render_path_dirname(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slice_value = try code.get(index + 2);
    try render_path_extract(out, index, slice_value);
    try w(out, "  ");
    try ptmp(out, index, "", "_empty");
    try w(out, " = icmp eq i64 ");
    try ptmp(out, index, "", "_len");
    try wl(out, ", 0");
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_empty");
    try w(out, ", label ");
    try ptmp(out, index, "", "_dot");
    try w(out, ", label ");
    try ptmp(out, index, "", "_ne");
    try nl(out);
    try plbl(out, index, "", "_ne");
    try render_path_trim(out, index, "_dt", "_len");
    try render_path_root_test(out, index, "_dt_end");
    try render_path_last_slash(out, index, "_ds", "_dt_end");
    try w(out, "  ");
    try ptmp(out, index, "", "_nosl");
    try w(out, " = icmp slt i64 ");
    try ptmp(out, index, "_ds", "_slash");
    try wl(out, ", 0");
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_nosl");
    try w(out, ", label ");
    try ptmp(out, index, "", "_dot");
    try w(out, ", label ");
    try ptmp(out, index, "", "_hs");
    try nl(out);
    try plbl(out, index, "", "_hs");
    try w(out, "  ");
    try ptmp(out, index, "", "_s0");
    try w(out, " = icmp eq i64 ");
    try ptmp(out, index, "_ds", "_slash");
    try wl(out, ", 0");
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_s0");
    try w(out, ", label ");
    try ptmp(out, index, "", "_root");
    try w(out, ", label ");
    try ptmp(out, index, "", "_de");
    try nl(out);
    try plbl(out, index, "", "_de");
    try render_path_trim(out, index, "_d2", "_ds_slash");
    try w(out, "  ");
    try ptmp(out, index, "", "_de1");
    try w(out, " = icmp eq i64 ");
    try ptmp(out, index, "_d2", "_end");
    try wl(out, ", 1");
    try w(out, "  ");
    try ptmp(out, index, "", "_rootd");
    try w(out, " = and i1 ");
    try ptmp(out, index, "", "_de1");
    try w(out, ", ");
    try ptmp(out, index, "", "_b0s");
    try nl(out);
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_rootd");
    try w(out, ", label ");
    try ptmp(out, index, "", "_root");
    try w(out, ", label ");
    try ptmp(out, index, "", "_dfull");
    try nl(out);
    try plbl(out, index, "", "_dfull");
    try w(out, "  store ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rptr");
    try nl(out);
    try w(out, "  store i64 ");
    try ptmp(out, index, "_d2", "_end");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rlen");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_done");
    try nl(out);
    try plbl(out, index, "", "_dot");
    try render_path_store_dot(out, index);
    try plbl(out, index, "", "_root");
    try render_path_store_root(out, index);
    try render_path_build(out, index, dst);
    return;
}

// render_path_extension lowers PATH_EXTENSION following std::path_bits::extension:
// scanning back from the end, a '/' (47) before any '.' yields the empty slice and
// a '.' (46) yields path[dot..len]; reaching the start also yields the empty slice.
fn render_path_extension(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let slice_value = try code.get(index + 2);
    try render_path_extract(out, index, slice_value);
    try w(out, "  ");
    try ptmp(out, index, "", "_xidx");
    try wl(out, " = alloca i64");
    try w(out, "  store i64 ");
    try ptmp(out, index, "", "_len");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_xidx");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_xloop");
    try nl(out);
    try plbl(out, index, "", "_xloop");
    try w(out, "  ");
    try ptmp(out, index, "", "_xi");
    try w(out, " = load i64, ptr ");
    try ptmp(out, index, "", "_xidx");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, "", "_xgt0");
    try w(out, " = icmp sgt i64 ");
    try ptmp(out, index, "", "_xi");
    try wl(out, ", 0");
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_xgt0");
    try w(out, ", label ");
    try ptmp(out, index, "", "_xchk");
    try w(out, ", label ");
    try ptmp(out, index, "", "_xempty");
    try nl(out);
    try plbl(out, index, "", "_xchk");
    try w(out, "  ");
    try ptmp(out, index, "", "_xprev");
    try w(out, " = sub i64 ");
    try ptmp(out, index, "", "_xi");
    try wl(out, ", 1");
    try w(out, "  ");
    try ptmp(out, index, "", "_xgep");
    try w(out, " = getelementptr i8, ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", i64 ");
    try ptmp(out, index, "", "_xprev");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, "", "_xbyte");
    try w(out, " = load i8, ptr ");
    try ptmp(out, index, "", "_xgep");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, "", "_xsl");
    try w(out, " = icmp eq i8 ");
    try ptmp(out, index, "", "_xbyte");
    try wl(out, ", 47");
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_xsl");
    try w(out, ", label ");
    try ptmp(out, index, "", "_xempty");
    try w(out, ", label ");
    try ptmp(out, index, "", "_xdotchk");
    try nl(out);
    try plbl(out, index, "", "_xdotchk");
    try w(out, "  ");
    try ptmp(out, index, "", "_xdot");
    try w(out, " = icmp eq i8 ");
    try ptmp(out, index, "", "_xbyte");
    try wl(out, ", 46");
    try w(out, "  br i1 ");
    try ptmp(out, index, "", "_xdot");
    try w(out, ", label ");
    try ptmp(out, index, "", "_xfound");
    try w(out, ", label ");
    try ptmp(out, index, "", "_xadv");
    try nl(out);
    try plbl(out, index, "", "_xadv");
    try w(out, "  store i64 ");
    try ptmp(out, index, "", "_xprev");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_xidx");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_xloop");
    try nl(out);
    try plbl(out, index, "", "_xfound");
    try w(out, "  ");
    try ptmp(out, index, "", "_xfgep");
    try w(out, " = getelementptr i8, ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", i64 ");
    try ptmp(out, index, "", "_xprev");
    try nl(out);
    try w(out, "  ");
    try ptmp(out, index, "", "_xflen");
    try w(out, " = sub i64 ");
    try ptmp(out, index, "", "_len");
    try w(out, ", ");
    try ptmp(out, index, "", "_xprev");
    try nl(out);
    try w(out, "  store ptr ");
    try ptmp(out, index, "", "_xfgep");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rptr");
    try nl(out);
    try w(out, "  store i64 ");
    try ptmp(out, index, "", "_xflen");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rlen");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_done");
    try nl(out);
    try plbl(out, index, "", "_xempty");
    try w(out, "  store ptr ");
    try ptmp(out, index, "", "_ptr");
    try w(out, ", ptr ");
    try ptmp(out, index, "", "_rptr");
    try nl(out);
    try w(out, "  store i64 0, ptr ");
    try ptmp(out, index, "", "_rlen");
    try nl(out);
    try w(out, "  br label ");
    try ptmp(out, index, "", "_done");
    try nl(out);
    try render_path_build(out, index, dst);
    return;
}

fn render_try_string_append_i64(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let text_value = try code.get(index + 1);
    let value = try code.get(index + 2);
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_run_string_append_i64(%kizu.owned %v");
    try wi(out, text_value);
    try w(out, ", i64 %v");
    try wi(out, value);
    try wl(out, ")");
    try render_try_error_void_tail(out, code, index, abi);
    return;
}

fn render_try_string_append_bool(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
