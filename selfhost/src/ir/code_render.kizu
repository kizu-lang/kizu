    return;
}

fn render_try_error_void_tail(out: &var std::string::String, index: i64, abi: i64) -> !void {
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_propagate(out, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

// render_try_fs_read emits 'try std::fs::read_file(io, path)': build the path slice
// from its CONST_STR global, call the runtime read, extract the ok flag, and branch
// into a fail block that propagates the error or a cont block that extracts the read
// bytes slice into the result value. SSA temps and labels are suffixed with the
// result value id so they stay unique.
fn render_try_fs_read(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let dst = try code.get(index + 1);
    let io_value = try code.get(index + 2);
    let path_value = try code.get(index + 3);
    let path_len = try tape_string_length(code, path_value, 0);
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, "_pathbase = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.s");
    try wi(out, path_value);
    try wl(out, ", 0");
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, "_path = insertvalue %kizu.slice.u8 %fr");
    try wi(out, dst);
    try w(out, "_pathbase, i64 ");
    try wi(out, path_len);
    try wl(out, ", 1");
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, " = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %v");
    try wi(out, io_value);
    try w(out, ", %kizu.slice.u8 %fr");
    try wi(out, dst);
    try wl(out, "_path)");
    try w(out, "  %fr");
    try wi(out, dst);
    try w(out, "_ok = extractvalue %kizu.error.slice.u8 %fr");
    try wi(out, dst);
    try wl(out, ", 0");
    try w(out, "  br i1 %fr");
    try wi(out, dst);
    try w(out, "_ok, label %fr");
    try wi(out, dst);
    try w(out, "_cont, label %fr");
    try wi(out, dst);
    try wl(out, "_fail");
    try w(out, "fr");
    try wi(out, dst);
    try wl(out, "_fail:");
    try render_fs_read_propagate(out, dst, abi);
    try w(out, "fr");
    try wi(out, dst);
    try wl(out, "_cont:");
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = extractvalue %kizu.error.slice.u8 %fr");
    try wi(out, dst);
    try wl(out, ", 1");
    return;
}

// render_try_io_write emits a 'try std::io::write_stdout/write_stderr(io, bytes)'
// statement: call the stream's runtime write with the io handle and the message
// slice, extract the ok flag, and branch into a fail block that propagates the
// error by the surrounding ABI or a cont block that resumes the body. The '%tc'
// temp prefix matches TRY_CALL's so render_try_propagate serves both records.
fn render_try_io_write(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64,
    abi: i64
) -> !void {
    let io_value = try code.get(index + 1);
    let msg_value = try code.get(index + 2);
    let stream = try code.get(index + 3);
    let stderr_stream = codegen::code_io_stream_stderr();
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, " = call %kizu.error.void @kizu_rt_io_write_");
    if stream == stderr_stream {
        try w(out, "stderr");
    }
    if stream != stderr_stream {
        try w(out, "stdout");
    }
    try w(out, "(%kizu.owned %v");
    try wi(out, io_value);
    try w(out, ", %kizu.slice.u8 %v");
    try wi(out, msg_value);
    try wl(out, ")");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_ok = extractvalue %kizu.error.void %tc");
    try wi(out, index);
    try wl(out, ", 0");
    try w(out, "  br i1 %tc");
    try wi(out, index);
    try w(out, "_ok, label %tc");
    try wi(out, index);
    try w(out, "_cont, label %tc");
    try wi(out, index);
    try wl(out, "_fail");
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_fail:");
    try render_try_propagate(out, index, abi);
    try w(out, "tc");
    try wi(out, index);
    try wl(out, "_cont:");
    return;
}

fn render_mem_page_allocator(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    try w(out, "  %v");
    try wi(out, dst);
    try wl(out, " = call %kizu.owned @kizu_rt_mem_page_allocator()");
    return;
}

fn render_storage_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let kind = try code.get(index + 2);
    let allocator = try code.get(index + 3);
    let element_size = try code.get(index + 4);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.owned @");
    let symbol = storage_new_symbol(kind);
    try w(out, symbol);
    try w(out, "(%kizu.owned %v");
    try wi(out, allocator);
    let needs_size = storage_new_needs_size(kind);
    if needs_size {
        try w(out, ", i64 ");
        try wi(out, element_size);
    }
    try wl(out, ")");
    return;
}

fn storage_new_symbol(kind: i64) -> []u8 {
    if kind == codegen::code_kind_owned_string() {
        return "kizu_rt_string_new";
    }
    if codegen::code_kind_is_owned_array(kind) {
        return "kizu_rt_array_new";
    }
    if kind == codegen::code_kind_owned_map_i64() {
        return "kizu_rt_map_new";
    }
    return "kizu_rt_arena_new";
}

fn storage_new_needs_size(kind: i64) -> bool {
    if codegen::code_kind_is_owned_array(kind) {
        return true;
    }
    return codegen::code_kind_is_arena(kind);
}

fn render_storage_deinit(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let receiver = try code.get(index + 1);
    let kind = try code.get(index + 2);
    try w(out, "  call void @");
    let symbol = storage_deinit_symbol(kind);
    try w(out, symbol);
    try w(out, "(%kizu.owned %v");
    try wi(out, receiver);
    try wl(out, ")");
    return;
}

fn render_arena_new(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let allocator = try code.get(index + 2);
    let element_size = try code.get(index + 3);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call %kizu.owned @kizu_rt_arena_new(%kizu.owned %v");
    try wi(out, allocator);
    try w(out, ", i64 ");
    try wi(out, element_size);
    try wl(out, ")");
    return;
}

fn render_arena_deinit(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let receiver = try code.get(index + 1);
    try w(out, "  call void @kizu_rt_arena_deinit(%kizu.owned %v");
    try wi(out, receiver);
    try wl(out, ")");
    return;
}

fn storage_deinit_symbol(kind: i64) -> []u8 {
    if kind == codegen::code_kind_owned_string() {
        return "kizu_rt_string_deinit";
    }
    if codegen::code_kind_is_owned_array(kind) {
        return "kizu_rt_array_deinit";
    }
    if kind == codegen::code_kind_owned_map_i64() {
        return "kizu_rt_map_deinit";
    }
    return "kizu_rt_arena_deinit";
}

fn render_string_len(
    out: &var std::string::String,
    code: &std::array::Array<i64>,
    index: i64
) -> !void {
    let dst = try code.get(index + 1);
    let receiver = try code.get(index + 2);
    try w(out, "  %v");
    try wi(out, dst);
    try w(out, " = call i64 @kizu_rt_string_len(%kizu.owned %v");
    try wi(out, receiver);
    try wl(out, ")");
    return;
}

