    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pm = extractvalue %kizu.error.union.i64 %tc");
    try wi(out, index);
    try wl(out, ", 2");
    try w(out, "  %tc");
    try wi(out, index);
    try w(out, "_pv = insertvalue %kizu.error.union.void { i1 false, %kizu.run.union zeroinitializer }, %kizu.run.union %tc");
    try wi(out, index);
    try wl(out, "_pm, 1");
    try w(out, "  ret %kizu.error.union.void %tc");
