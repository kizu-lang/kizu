import selfhost::ir::component_function_catalog;
import selfhost::ir::package_type_token;

pub fn append(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function: std::kizu::ast::NodeId,
    qualified_name: []u8
) -> !void {
    let name = component_function_catalog::single_function_name(qualified_name);
    try append_name(out, text, ast, function, &name);
    return;
}


pub fn append_catalog(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function: std::kizu::ast::NodeId,
    catalog: &component_function_catalog::ComponentFunctionCatalog,
    function_index: i64
) -> !void {
    let name = try component_function_catalog::function_name(catalog, function_index);
    try append_name(out, text, ast, function, &name);
    return;
}

fn append_name(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function: std::kizu::ast::NodeId,
    function_name: &component_function_catalog::ComponentFunctionName
) -> !void {
    let node = ast.get(function);
    match node.data {
        FnDecl(fn_decl) => return append_from_decl(
            out,
            text,
            ast,
            function_name,
            fn_decl.params,
            fn_decl.return_type
        );,
        _ => return error("missing executable function signature");,
    }
}

fn append_from_decl(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: &component_function_catalog::ComponentFunctionName,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId
) -> !void {
    try append_return(out, text, ast, function_name, return_type);
    try append_params(out, text, ast, function_name, params);
    return;
}

fn append_return(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: &component_function_catalog::ComponentFunctionName,
    return_type: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes("function-signature-return ");
    try component_function_catalog::append_function_name(out, function_name);
    try out.append_byte(cast<u8>(32));
    try append_type_token(out, text, ast, return_type);
    try out.append_byte(cast<u8>(10));
    try append_reachable_type(out, text, ast, function_name, return_type);
    return;
}

fn append_params(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: &component_function_catalog::ComponentFunctionName,
    params: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < params.len {
        let param = try ast.child_at(params, index);
        try append_param(out, text, ast, function_name, index, param);
        index = index + 1;
    }
    return;
}

fn append_param(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: &component_function_catalog::ComponentFunctionName,
    index: i64,
    param: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(param);
    match node.data {
        Param(param_node) => return append_param_from_node(
            out,
            text,
            ast,
            function_name,
            index,
            param_node.name,
            param_node.comptime_param,
            param_node.type_node
        );,
        _ => return error("missing executable function signature");,
    }
}

fn append_param_from_node(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: &component_function_catalog::ComponentFunctionName,
    index: i64,
    name: std::kizu::ast::NodeId,
    comptime_param: bool,
    type_node: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes("function-signature-param ");
    try component_function_catalog::append_function_name(out, function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(ast_node_text(text, ast, name));
    try out.append_byte(cast<u8>(58));
    if comptime_param {
        try out.append_bytes("comptime");
    } else {
        try out.append_bytes("runtime");
    }
    try out.append_byte(cast<u8>(58));
    try append_type_token(out, text, ast, type_node);
    try out.append_byte(cast<u8>(10));
    if !comptime_param {
        try append_reachable_type(out, text, ast, function_name, type_node);
    }
    return;
}

fn append_reachable_type(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: &component_function_catalog::ComponentFunctionName,
    type_node: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes("reachable-type ");
    try component_function_catalog::append_function_name(out, function_name);
    try out.append_byte(cast<u8>(32));
    try append_type_token(out, text, ast, type_node);
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn append_type_token_pub(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> !void {
    try append_type_token(out, text, ast, type_node);
    return;
}

fn append_type_token(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(type_node);
    match node.data {
        Empty => return append_void_type_token(out);,
        _ => return append_ast_type_token(out, text, ast, type_node);,
    }
}

fn append_void_type_token(out: &var std::string::String) -> !void {
    try out.append_bytes("void");
    return;
}

fn append_ast_type_token(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> !void {
    return package_type_token::append_canonical(
        out, ast_node_text(text, ast, type_node)
    );
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(node_id);
    let span = node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
