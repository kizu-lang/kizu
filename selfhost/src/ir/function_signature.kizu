pub fn append(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function: std::kizu::ast::NodeId,
    qualified_name: []u8
) -> !void {
    let node = ast.get(function);
    match node.data {
        FnDecl(fn_decl) => return try append_from_decl(
            out,
            text,
            ast,
            qualified_name,
            fn_decl.params,
            fn_decl.return_type
        );,
        _ => return error("missing executable function signature");,
    }
}

fn append_from_decl(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId
) -> !void {
    try append_return(out, text, ast, qualified_name, return_type);
    try append_params(out, text, ast, qualified_name, params);
    return;
}

fn append_return(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    return_type: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes("function-signature-return ");
    try out.append_bytes(qualified_name);
    try out.append_byte(cast<u8>(32));
    try append_type_token(out, text, ast, return_type);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_params(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    params: std::kizu::ast::ChildRange
) -> !void {
    var index = 0;
    while index < params.len {
        let param = try ast.child_at(params, index);
        try append_param(out, text, ast, qualified_name, index, param);
        index = index + 1;
    }
    return;
}

fn append_param(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    index: i64,
    param: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(param);
    match node.data {
        Param(param_node) => return try append_param_from_node(
            out,
            text,
            ast,
            qualified_name,
            index,
            param_node.name,
            param_node.comptime_param,
            param_node.type_node
        );,
        _ => return error("missing executable function signature");,
    }
}

fn append_param_from_node(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    qualified_name: []u8,
    index: i64,
    name: std::kizu::ast::NodeId,
    comptime_param: bool,
    type_node: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes("function-signature-param ");
    try out.append_bytes(qualified_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(ast_node_text(text, ast, name));
    try out.append_byte(cast<u8>(58));
    if comptime_param {
        try out.append_bytes("comptime");
    } else {
        try out.append_bytes("runtime");
    }
    try out.append_byte(cast<u8>(58));
    try append_type_token(out, text, ast, type_node);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_type_token(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(type_node);
    match node.data {
        Empty => return try append_void_type_token(out);,
        _ => return try append_ast_type_token(out, text, ast, type_node);,
    }
}

fn append_void_type_token(out: &var std::string::String) -> !void {
    try out.append_bytes("void");
    return;
}

fn append_ast_type_token(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> !void {
    try append_non_space_token(out, ast_node_text(text, ast, type_node));
    return;
}

fn append_non_space_token(out: &var std::string::String, text: []u8) -> !void {
    var index = 0;
    let len = std::mem::len(text);
    while index < len {
        let byte = text[index];
        if byte == cast<u8>(32) or byte == cast<u8>(9) {
            try out.append_byte(cast<u8>(95));
        } else {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    return;
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(node_id);
    let span = node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
