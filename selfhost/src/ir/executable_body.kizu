pub fn append_function_body_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    role: []u8,
    body: std::kizu::ast::NodeId
) -> !void {
    try append_body_ir(
        out,
        text,
        ast,
        function_name,
        role,
        body,
        "selected-function-body-end "
    );
    return;
}

pub fn append_helper_body_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    role: []u8,
    body: std::kizu::ast::NodeId
) -> !void {
    try append_body_ir(
        out,
        text,
        ast,
        function_name,
        role,
        body,
        "selected-helper-body-end "
    );
    return;
}

fn append_body_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    role: []u8,
    body: std::kizu::ast::NodeId,
    end_prefix: []u8
) -> !void {
    let node_count = try append_body_node_ir(out, text, ast, function_name, body, 0, 0);
    try out.append_bytes(end_prefix);
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, node_count);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_body_node_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    node_id: std::kizu::ast::NodeId,
    sequence: i64,
    depth: i64
) -> !i64 {
    let node = ast.get(node_id);
    try append_body_node_fact(out, function_name, sequence, depth, node_id, ast);
    try append_body_detail_fact(out, text, ast, function_name, sequence, node_id);

    let next = sequence + 1;
    match node.data {
        Block(block) => return try append_body_range_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "statement",
            block.statements,
            next,
            depth + 1
        );,
        Let(let_node) => return try append_body_two_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "name",
            let_node.name,
            "value",
            let_node.value,
            next,
            depth + 1
        );,
        Assign(assign_node) => return try append_body_two_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "target",
            assign_node.target,
            "value",
            assign_node.value,
            next,
            depth + 1
        );,
        Return(return_node) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "value",
            return_node.value,
            next,
            depth + 1
        );,
        Defer(defer_node) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "expr",
            defer_node.expr,
            next,
            depth + 1
        );,
        ExprStmt(expr_stmt) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "expr",
            expr_stmt.expr,
            next,
            depth + 1
        );,
        If(if_node) => return try append_body_three_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "condition",
            if_node.condition,
            "then",
            if_node.then_block,
            "else",
            if_node.else_block,
            next,
            depth + 1
        );,
        ComptimeIf(comptime_if_node) => return try append_body_three_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "condition",
            comptime_if_node.condition,
            "then",
            comptime_if_node.then_block,
            "else",
            comptime_if_node.else_block,
            next,
            depth + 1
        );,
        While(while_node) => return try append_body_three_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "label",
            while_node.label,
            "condition",
            while_node.condition,
            "body",
            while_node.body,
            next,
            depth + 1
        );,
        For(for_node) => return try append_body_five_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            for_node.label,
            for_node.name,
            for_node.start,
            for_node.end,
            for_node.body,
            next,
            depth + 1
        );,
        Break(break_node) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "label",
            break_node.label,
            next,
            depth + 1
        );,
        Continue(continue_node) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "label",
            continue_node.label,
            next,
            depth + 1
        );,
        Unsafe(unsafe_node) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "body",
            unsafe_node.body,
            next,
            depth + 1
        );,
        Match(match_node) => return try append_body_one_range_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "value",
            match_node.value,
            "arm",
            match_node.arms,
            next,
            depth + 1
        );,
        MatchArm(match_arm) => return try append_body_three_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "pattern",
            match_arm.pattern,
            "binding",
            match_arm.binding,
            "body",
            match_arm.body,
            next,
            depth + 1
        );,
        Prefix(prefix_node) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "right",
            prefix_node.right,
            next,
            depth + 1
        );,
        Binary(binary) => return try append_body_two_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "left",
            binary.left,
            "right",
            binary.right,
            next,
            depth + 1
        );,
        FieldExpr(field_expr) => return try append_body_two_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "receiver",
            field_expr.receiver,
            "name",
            field_expr.name,
            next,
            depth + 1
        );,
        DerefExpr(deref_expr) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "receiver",
            deref_expr.receiver,
            next,
            depth + 1
        );,
        Call(call_node) => return try append_body_one_range_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "callee",
            call_node.callee,
            "arg",
            call_node.args,
            next,
            depth + 1
        );,
        TypeApplyExpr(type_apply) => return try append_body_one_range_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "callee",
            type_apply.callee,
            "type-arg",
            type_apply.type_args,
            next,
            depth + 1
        );,
        CastExpr(cast_expr) => return try append_body_two_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "type",
            cast_expr.type_node,
            "value",
            cast_expr.value,
            next,
            depth + 1
        );,
        IndexExpr(index_expr) => return try append_body_three_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "target",
            index_expr.target,
            "start",
            index_expr.start,
            "end",
            index_expr.end,
            next,
            depth + 1
        );,
        StructLiteralExpr(struct_literal) => return try append_body_one_range_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "type",
            struct_literal.type_name,
            "field",
            struct_literal.fields,
            next,
            depth + 1
        );,
        StructFieldInit(field_init) => return try append_body_two_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "name",
            field_init.name,
            "value",
            field_init.value,
            next,
            depth + 1
        );,
        ArenaNewExpr(arena_new) => return try append_body_two_children_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "type",
            arena_new.type_node,
            "allocator",
            arena_new.allocator,
            next,
            depth + 1
        );,
        TryExpr(try_expr) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "value",
            try_expr.value,
            next,
            depth + 1
        );,
        ComptimeExpr(comptime_expr) => return try append_body_single_child_ir(
            out,
            text,
            ast,
            function_name,
            sequence,
            "value",
            comptime_expr.value,
            next,
            depth + 1
        );,
        _ => return next;,
    }
}

fn append_body_single_child_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    child: std::kizu::ast::NodeId,
    next_sequence: i64,
    depth: i64
) -> !i64 {
    try append_body_edge(out, function_name, parent_sequence, edge, 0, next_sequence);
    return try append_body_node_ir(
        out,
        text,
        ast,
        function_name,
        child,
        next_sequence,
        depth
    );
}

fn append_body_two_children_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    parent_sequence: i64,
    first_edge: []u8,
    first: std::kizu::ast::NodeId,
    second_edge: []u8,
    second: std::kizu::ast::NodeId,
    next_sequence: i64,
    depth: i64
) -> !i64 {
    var next = try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        first_edge,
        first,
        next_sequence,
        depth
    );
    return try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        second_edge,
        second,
        next,
        depth
    );
}

fn append_body_three_children_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    parent_sequence: i64,
    first_edge: []u8,
    first: std::kizu::ast::NodeId,
    second_edge: []u8,
    second: std::kizu::ast::NodeId,
    third_edge: []u8,
    third: std::kizu::ast::NodeId,
    next_sequence: i64,
    depth: i64
) -> !i64 {
    var next = try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        first_edge,
        first,
        next_sequence,
        depth
    );
    next = try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        second_edge,
        second,
        next,
        depth
    );
    return try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        third_edge,
        third,
        next,
        depth
    );
}

fn append_body_five_children_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    parent_sequence: i64,
    label: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    next_sequence: i64,
    depth: i64
) -> !i64 {
    var next = try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        "label",
        label,
        next_sequence,
        depth
    );
    next = try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        "name",
        name,
        next,
        depth
    );
    next = try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        "start",
        start,
        next,
        depth
    );
    next = try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        "end",
        end,
        next,
        depth
    );
    return try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        "body",
        body,
        next,
        depth
    );
}

fn append_body_one_range_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    parent_sequence: i64,
    child_edge: []u8,
    child: std::kizu::ast::NodeId,
    range_edge: []u8,
    range: std::kizu::ast::ChildRange,
    next_sequence: i64,
    depth: i64
) -> !i64 {
    let next = try append_body_single_child_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        child_edge,
        child,
        next_sequence,
        depth
    );
    return try append_body_range_ir(
        out,
        text,
        ast,
        function_name,
        parent_sequence,
        range_edge,
        range,
        next,
        depth
    );
}

fn append_body_range_ir(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    range: std::kizu::ast::ChildRange,
    next_sequence: i64,
    depth: i64
) -> !i64 {
    var next = next_sequence;
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        try append_body_edge(out, function_name, parent_sequence, edge, index, next);
        next = try append_body_node_ir(out, text, ast, function_name, child, next, depth);
        index = index + 1;
    }
    return next;
}

fn append_body_node_fact(
    out: &var std::string::String,
    function_name: []u8,
    sequence: i64,
    depth: i64,
    node_id: std::kizu::ast::NodeId,
    ast: std::kizu::ast::Ast
) -> !void {
    let node = ast.get(node_id);
    try out.append_bytes("body-node ");
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, sequence);
    try out.append_bytes(" depth ");
    try std::fmt::append_i64(out, depth);
    try out.append_bytes(" kind ");
    try out.append_bytes(body_node_kind(ast, node_id));
    try out.append_bytes(" span ");
    try std::fmt::append_i64(out, node.span.start);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, node.span.end);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_body_edge(
    out: &var std::string::String,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    index: i64,
    child_sequence: i64
) -> !void {
    try out.append_bytes("body-edge ");
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, parent_sequence);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(edge);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, child_sequence);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_body_detail_fact(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    sequence: i64,
    node_id: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Let(let_node) => return try append_body_named_node_fact(
            out,
            "body-let ",
            function_name,
            sequence,
            text,
            ast,
            let_node.name
        );,
        Call(call_node) => return try append_body_call_fact(
            out,
            text,
            ast,
            function_name,
            sequence,
            call_node.callee,
            call_node.args.len
        );,
        Return(return_node) => return try append_body_kind_ref_fact(
            out,
            "body-return ",
            function_name,
            sequence,
            ast,
            return_node.value
        );,
        StructLiteralExpr(struct_literal) => return try append_body_named_node_fact(
            out,
            "body-struct-literal ",
            function_name,
            sequence,
            text,
            ast,
            struct_literal.type_name
        );,
        StructFieldInit(field_init) => return try append_body_named_node_fact(
            out,
            "body-field-init ",
            function_name,
            sequence,
            text,
            ast,
            field_init.name
        );,
        FieldExpr(field_expr) => return try append_body_field_expr_fact(
            out,
            text,
            ast,
            function_name,
            sequence,
            field_expr.name,
            field_expr.namespace
        );,
        TypeApplyExpr(type_apply) => return try append_body_call_fact(
            out,
            text,
            ast,
            function_name,
            sequence,
            type_apply.callee,
            type_apply.type_args.len
        );,
        Binary(binary) => return try append_body_op_fact(
            out,
            "body-binary ",
            function_name,
            sequence,
            binary_op_text(binary.op)
        );,
        Prefix(prefix_node) => return try append_body_op_fact(
            out,
            "body-prefix ",
            function_name,
            sequence,
            prefix_op_text(prefix_node.op)
        );,
        TryExpr(try_expr) => return try append_body_kind_ref_fact(
            out,
            "body-try ",
            function_name,
            sequence,
            ast,
            try_expr.value
        );,
        Var(var_node) => return try append_body_named_node_fact(
            out,
            "body-token ",
            function_name,
            sequence,
            text,
            ast,
            node_id
        );,
        TypeName(type_name) => return try append_body_named_node_fact(
            out,
            "body-token ",
            function_name,
            sequence,
            text,
            ast,
            node_id
        );,
        String(string_node) => return try append_body_named_node_fact(
            out,
            "body-token ",
            function_name,
            sequence,
            text,
            ast,
            node_id
        );,
        Int(int_node) => return try append_body_named_node_fact(
            out,
            "body-token ",
            function_name,
            sequence,
            text,
            ast,
            node_id
        );,
        Bool(bool_node) => return try append_body_named_node_fact(
            out, "body-token ", function_name, sequence, text, ast, node_id
        );,
        _ => return;,
    }
}

fn append_body_call_fact(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    sequence: i64,
    callee: std::kizu::ast::NodeId,
    arg_count: i64
) -> !void {
    try out.append_bytes("body-call ");
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, sequence);
    try out.append_byte(cast<u8>(32));
    try append_body_node_text_token(out, text, ast, callee);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, arg_count);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_body_named_node_fact(
    out: &var std::string::String,
    prefix: []u8,
    function_name: []u8,
    sequence: i64,
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes(prefix);
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, sequence);
    try out.append_byte(cast<u8>(32));
    try append_body_node_text_token(out, text, ast, value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_body_kind_ref_fact(
    out: &var std::string::String,
    prefix: []u8,
    function_name: []u8,
    sequence: i64,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> !void {
    try out.append_bytes(prefix);
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, sequence);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(body_node_kind(ast, value));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_body_field_expr_fact(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    sequence: i64,
    name: std::kizu::ast::NodeId,
    namespace: bool
) -> !void {
    try out.append_bytes("body-field-expr ");
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, sequence);
    try out.append_byte(cast<u8>(32));
    try append_body_node_text_token(out, text, ast, name);
    try out.append_byte(cast<u8>(32));
    if namespace {
        try out.append_bytes("namespace");
    } else {
        try out.append_bytes("field");
    }
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_body_op_fact(
    out: &var std::string::String,
    prefix: []u8,
    function_name: []u8,
    sequence: i64,
    op: []u8
) -> !void {
    try out.append_bytes(prefix);
    try out.append_bytes(function_name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, sequence);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(op);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_body_node_text_token(
    out: &var std::string::String,
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !void {
    let token = ast_node_text(text, ast, node_id);
    if !is_body_ir_token(token) {
        return error("unsupported selected function body token");
    }
    try out.append_bytes(token);
    return;
}

fn is_body_ir_token(text: []u8) -> bool {
    let length = std::mem::len(text);
    if length == 0 {
        return false;
    }
    var index = 0;
    while index < length {
        let byte = text[index];
        if byte == cast<u8>(32) or
            byte == cast<u8>(9) or
            byte == cast<u8>(10) or
            byte == cast<u8>(13) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn binary_op_text(op: std::kizu::ast::BinaryOp) -> []u8 {
    if op == std::kizu::ast::binary_add() { return "add"; }
    if op == std::kizu::ast::binary_sub() { return "sub"; }
    if op == std::kizu::ast::binary_mul() { return "mul"; }
    if op == std::kizu::ast::binary_div() { return "div"; }
    if op == std::kizu::ast::binary_mod() { return "mod"; }
    if op == std::kizu::ast::binary_eq() { return "eq"; }
    if op == std::kizu::ast::binary_not_eq() { return "not-eq"; }
    if op == std::kizu::ast::binary_lt() { return "lt"; }
    if op == std::kizu::ast::binary_lte() { return "lte"; }
    if op == std::kizu::ast::binary_gt() { return "gt"; }
    if op == std::kizu::ast::binary_gte() { return "gte"; }
    if op == std::kizu::ast::binary_and() { return "and"; }
    if op == std::kizu::ast::binary_or() { return "or"; }
    return "unknown";
}

fn prefix_op_text(op: std::kizu::ast::PrefixOp) -> []u8 {
    if op == std::kizu::ast::prefix_not() { return "not"; }
    if op == std::kizu::ast::prefix_neg() { return "neg"; }
    if op == std::kizu::ast::prefix_borrow() { return "borrow"; }
    if op == std::kizu::ast::prefix_mut_borrow() { return "mut-borrow"; }
    return "unknown";
}

fn body_node_kind(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    return match node.data {
        Block(block) => "Block",
        Let(let_node) => "Let",
        Assign(assign_node) => "Assign",
        Return(return_node) => "Return",
        Defer(defer_node) => "Defer",
        ExprStmt(expr_stmt) => "ExprStmt",
        If(if_node) => "If",
        While(while_node) => "While",
        For(for_node) => "For",
        Break(break_node) => "Break",
        Continue(continue_node) => "Continue",
        Unsafe(unsafe_node) => "Unsafe",
        ComptimeIf(comptime_if_node) => "ComptimeIf",
        Match(match_node) => "Match",
        MatchArm(match_arm) => "MatchArm",
        Prefix(prefix_node) => "Prefix",
        Binary(binary) => "Binary",
        FieldExpr(field_expr_node) => "FieldExpr",
        DerefExpr(deref_expr_node) => "DerefExpr",
        Call(call_node) => "Call",
        TypeApplyExpr(type_apply) => "TypeApplyExpr",
        CastExpr(cast_expr) => "CastExpr",
        IndexExpr(index_expr) => "IndexExpr",
        StructLiteralExpr(struct_literal) => "StructLiteralExpr",
        StructFieldInit(struct_field_init) => "StructFieldInit",
        ArenaNewExpr(arena_new) => "ArenaNewExpr",
        TryExpr(try_expr_node) => "TryExpr",
        ComptimeExpr(comptime_expr_node) => "ComptimeExpr",
        Int(int_node) => "Int",
        String(string_node) => "String",
        TypeName(type_name) => "TypeName",
        Var(var_node) => "Var",
        Bool(bool_node) => "Bool",
        Empty => "Empty",
        _ => "Unsupported",
    };
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    return std::mem::trim_ascii(text[node.span.start..node.span.end]);
}
