import selfhost::ownership::data;

pub fn declare_resource(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    name: []u8,
    kind: data::ResourceKind
) -> !void {
    if states.contains(name) {
        return error("duplicate resource");
    }
    try states.insert(name, data::OwnershipState::Available);
    try kinds.insert(name, kind);
    return;
}

pub fn declare_tracked_resource(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    name: []u8,
    kind: data::ResourceKind
) -> !void {
    try declare_resource(states, kinds, name, kind);
    try resources.append(name);
    return;
}

pub fn fork_resources(
    states: &std::map::Map<[]u8, data::OwnershipState>,
    kinds: &std::map::Map<[]u8, data::ResourceKind>,
    resources: &std::array::Array<[]u8>,
    branch_states: &var std::map::Map<[]u8, data::OwnershipState>,
    branch_kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    branch_resources: &var std::array::Array<[]u8>
) -> !void {
    var index = 0;
    while index < resources.len() {
        let name = try resources.get(index);
        try branch_states.insert(name, try states.get(name));
        try branch_kinds.insert(name, try kinds.get(name));
        try branch_resources.append(name);
        index = index + 1;
    }
    return;
}

pub fn merge_branch_moves(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    resources: &std::array::Array<[]u8>,
    branch_states: &std::map::Map<[]u8, data::OwnershipState>
) -> !void {
    var index = 0;
    while index < resources.len() {
        let name = try resources.get(index);
        let branch_state = try branch_states.get(name);
        if branch_state == data::OwnershipState::Moved or
            branch_state == data::OwnershipState::Deinitialized {
            try states.insert(name, branch_state);
        }
        index = index + 1;
    }
    return;
}

pub fn move_value(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    name: []u8
) -> !void {
    let current = try states.get(name);
    if current != data::OwnershipState::Available {
        return error("move requires available value");
    }
    try states.insert(name, data::OwnershipState::Moved);
    return;
}

pub fn shared_borrow(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    name: []u8
) -> !void {
    let current = try states.get(name);
    if current == data::OwnershipState::MutBorrowed or current == data::OwnershipState::Moved {
        return error("shared borrow blocked");
    }
    if current == data::OwnershipState::Deinitialized {
        return error("borrow after deinit");
    }
    try states.insert(name, data::OwnershipState::SharedBorrowed);
    return;
}

pub fn record_borrow(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    name: []u8,
    mutable: bool
) -> !void {
    if mutable {
        try mut_borrow(states, name);
        return;
    }
    let current = try states.get(name);
    if current == data::OwnershipState::MutBorrowed or current == data::OwnershipState::Moved {
        return error("shared borrow blocked");
    }
    if current == data::OwnershipState::Deinitialized {
        return error("borrow after deinit");
    }
    try states.insert(name, data::OwnershipState::SharedBorrowed);
    return;
}

pub fn mut_borrow(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    name: []u8
) -> !void {
    let current = try states.get(name);
    if current != data::OwnershipState::Available {
        return error("mutable borrow requires available value");
    }
    try states.insert(name, data::OwnershipState::MutBorrowed);
    return;
}

pub fn release_borrow(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    name: []u8
) -> !void {
    let current = try states.get(name);
    if current == data::OwnershipState::SharedBorrowed or
        current == data::OwnershipState::MutBorrowed {
        try states.insert(name, data::OwnershipState::Available);
        return;
    }
    return error("release requires active borrow");
}

pub fn deinit_resource(
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    name: []u8
) -> !void {
    let current = try states.get(name);
    if current != data::OwnershipState::Available {
        return error("deinit requires available value");
    }
    try states.insert(name, data::OwnershipState::Deinitialized);
    return;
}

pub fn state_of(
    states: &std::map::Map<[]u8, data::OwnershipState>,
    name: []u8
) -> !data::OwnershipState {
    return states.get(name);
}

pub fn kind_of(
    kinds: &std::map::Map<[]u8, data::ResourceKind>,
    name: []u8
) -> !data::ResourceKind {
    return kinds.get(name);
}

pub fn summarize(
    states: &std::map::Map<[]u8, data::OwnershipState>,
    borrows: i64,
    errors: i64
) -> data::OwnershipSummary {
    return data::OwnershipSummary {
        resources: states.len(),
        checked_nodes: states.len(),
        borrows: borrows,
        errors: errors
    };
}
