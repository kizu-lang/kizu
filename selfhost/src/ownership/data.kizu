import selfhost::source;

pub enum ResourceKind {
    Value,
    Record,
    Array,
    Map,
    String,
    Arena,
    Handle,
    BorrowedView,
}

pub enum OwnershipState {
    Available,
    Moved,
    SharedBorrowed,
    MutBorrowed,
    Deinitialized,
}

pub struct OwnershipSummary {
    pub resources: i64,
    pub checked_nodes: i64,
    pub borrows: i64,
    pub errors: i64,
}

pub struct CheckedModuleRef {
    pub source_id: i64,
    pub kind: source::SourceKind,
    pub path: []u8,
}

pub struct CheckedFunctionRef {
    pub module: []u8,
    pub name: []u8,
    pub span_start: i64,
    pub span_end: i64,
}

pub struct OwnershipFact {
    pub name: []u8,
    pub kind: ResourceKind,
    pub state: OwnershipState,
}

pub struct CheckedPackage {
    pub diagnostics: i64,
    pub resources: i64,
    pub checked_nodes: i64,
    pub borrows: i64,
    pub module: CheckedModuleRef,
    pub entry_function: CheckedFunctionRef,
    pub root_fact: OwnershipFact,
    pub summary: OwnershipSummary,
}
