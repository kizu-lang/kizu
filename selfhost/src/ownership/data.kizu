import selfhost::source;

pub enum ResourceKind {
    Value,
    Record,
    Array,
    Map,
    String,
    Arena,
    Handle,
    BorrowedView,
}

pub enum OwnershipState {
    Available,
    Moved,
    SharedBorrowed,
    MutBorrowed,
    Deinitialized,
}

pub struct OwnershipSummary {
    pub resources: i64,
    pub checked_nodes: i64,
    pub borrows: i64,
    pub errors: i64,
}

pub struct UseAfterMoveSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub name: []u8,
}

pub struct CheckedModuleRef {
    pub source_id: i64,
    pub kind: source::SourceKind,
    pub module_start: i64,
    pub module_end: i64,
    pub path: []u8,
}

pub struct CheckedFunctionRef {
    pub module: []u8,
    pub name: []u8,
    pub span_start: i64,
    pub span_end: i64,
}

pub struct OwnershipFact {
    pub name: []u8,
    pub kind: ResourceKind,
    pub state: OwnershipState,
}

pub struct CheckedPackage {
    pub diagnostics: i64,
    pub resources: i64,
    pub checked_nodes: i64,
    pub borrows: i64,
    pub module: CheckedModuleRef,
    pub entry_function: CheckedFunctionRef,
    pub root_fact: OwnershipFact,
    pub summary: OwnershipSummary,
}

pub fn use_after_move_summary(
    found: bool,
    start: i64,
    end: i64,
    name: []u8
) -> UseAfterMoveSummary {
    return UseAfterMoveSummary {
        found: found,
        start: start,
        end: end,
        name: name
    };
}

pub fn no_use_after_move() -> UseAfterMoveSummary {
    return use_after_move_summary(false, 0, 0, "");
}
