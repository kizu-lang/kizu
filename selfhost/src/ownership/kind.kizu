fn borrow_target_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(target);
    match node.data {
        Var(var_node) => return ast_node_text(file, ast, target);,
        FieldExpr(field_expr_node) => return borrow_target_name(file, ast, field_expr_node.receiver);,
        DerefExpr(deref_expr_node) => return borrow_target_name(file, ast, deref_expr_node.receiver);,
        TryExpr(try_expr_node) => return borrow_target_name(file, ast, try_expr_node.value);,
        ComptimeExpr(comptime_expr_node) => return borrow_target_name(file, ast, comptime_expr_node.value);,
        Program(program) => return "";,
        FnDecl(fn_decl) => return "";,
        Empty => return "";,
        Int(int_node) => return "";,
        String(string_node) => return "";,
        TypeName(type_name) => return "";,
        Bool(bool_node) => return "";,
        Prefix(prefix_node) => return "";,
        Binary(binary) => return "";,
        Call(call_node) => return "";,
        TypeApplyExpr(type_apply) => return "";,
        CastExpr(cast_expr) => return "";,
        IndexExpr(index_expr) => return "";,
        StructLiteralExpr(struct_literal) => return "";,
        StructFieldInit(struct_field_init) => return "";,
        ArenaNewExpr(arena_new) => return "";,
        Block(block) => return "";,
        If(if_node) => return "";,
        Let(let_node) => return "";,
        Assign(assign_node) => return "";,
        Return(return_node) => return "";,
        Defer(defer_node) => return "";,
        ExprStmt(expr_stmt) => return "";,
        While(while_node) => return "";,
        For(for_node) => return "";,
        Break(break_node) => return "";,
        Continue(continue_node) => return "";,
        ImportDecl(import_decl) => return "";,
        Param(param_node) => return "";,
        Field(field_node) => return "";,
        StructDecl(struct_decl) => return "";,
        EnumDecl(enum_decl) => return "";,
        UnionDecl(union_decl) => return "";,
        UnionVariant(union_variant) => return "";,
        Match(match_node) => return "";,
        MatchArm(match_arm) => return "";,
        Unsafe(unsafe_node) => return "";,
        ComptimeIf(comptime_if_node) => return "";,
    }
}

fn prefix_initializer_kind(op: std::kizu::ast::PrefixOp) -> data::ResourceKind {
    if op == std::kizu::ast::prefix_borrow() or op == std::kizu::ast::prefix_mut_borrow() {
        return data::ResourceKind::BorrowedView;
    }
    return data::ResourceKind::Value;
}

fn call_initializer_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> data::ResourceKind {
    let node = ast.get(callee);
    match node.data {
        FieldExpr(field_expr_node) => return field_call_initializer_kind(
            file,
            ast,
            callee,
            field_expr_node.name,
            field_expr_node.namespace
        );,
        Program(program) => return resource_kind_for_text(ast_node_text(file, ast, callee));,
        FnDecl(fn_decl) => return data::ResourceKind::Value;,
        Empty => return data::ResourceKind::Value;,
        Int(int_node) => return data::ResourceKind::Value;,
        String(string_node) => return data::ResourceKind::Value;,
        TypeName(type_name) => return resource_kind_for_text(ast_node_text(file, ast, callee));,
        Var(var_node) => return resource_kind_for_text(ast_node_text(file, ast, callee));,
        Bool(bool_node) => return data::ResourceKind::Value;,
        Prefix(prefix_node) => return data::ResourceKind::Value;,
        Binary(binary) => return data::ResourceKind::Value;,
        DerefExpr(deref_expr_node) => return data::ResourceKind::Value;,
        Call(call_node) => return data::ResourceKind::Value;,
        TypeApplyExpr(type_apply) => return resource_kind_for_text(ast_node_text(file, ast, callee));,
        CastExpr(cast_expr) => return data::ResourceKind::Value;,
        IndexExpr(index_expr) => return data::ResourceKind::Value;,
        StructLiteralExpr(struct_literal) => return data::ResourceKind::Value;,
        StructFieldInit(struct_field_init) => return data::ResourceKind::Value;,
        ArenaNewExpr(arena_new) => return data::ResourceKind::Arena;,
        TryExpr(try_expr_node) => return data::ResourceKind::Value;,
        ComptimeExpr(comptime_expr_node) => return data::ResourceKind::Value;,
        Block(block) => return data::ResourceKind::Value;,
        If(if_node) => return data::ResourceKind::Value;,
        Let(let_node) => return data::ResourceKind::Value;,
        Assign(assign_node) => return data::ResourceKind::Value;,
        Return(return_node) => return data::ResourceKind::Value;,
        Defer(defer_node) => return data::ResourceKind::Value;,
        ExprStmt(expr_stmt) => return data::ResourceKind::Value;,
        While(while_node) => return data::ResourceKind::Value;,
        For(for_node) => return data::ResourceKind::Value;,
        Break(break_node) => return data::ResourceKind::Value;,
        Continue(continue_node) => return data::ResourceKind::Value;,
        ImportDecl(import_decl) => return data::ResourceKind::Value;,
        Param(param_node) => return data::ResourceKind::Value;,
        Field(field_node) => return data::ResourceKind::Value;,
        StructDecl(struct_decl) => return data::ResourceKind::Value;,
        EnumDecl(enum_decl) => return data::ResourceKind::Value;,
        UnionDecl(union_decl) => return data::ResourceKind::Value;,
        UnionVariant(union_variant) => return data::ResourceKind::Value;,
        Match(match_node) => return data::ResourceKind::Value;,
        MatchArm(match_arm) => return data::ResourceKind::Value;,
        Unsafe(unsafe_node) => return data::ResourceKind::Value;,
        ComptimeIf(comptime_if_node) => return data::ResourceKind::Value;,
    }
}

fn field_call_initializer_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool
) -> data::ResourceKind {
    if is_as_bytes_method(file, ast, name, namespace) {
        return data::ResourceKind::BorrowedView;
    }
    return resource_kind_for_text(ast_node_text(file, ast, callee));
}

fn initializer_var_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, data::ResourceKind>
) -> !data::ResourceKind {
    let text = ast_node_text(file, ast, value);
    if kinds.contains(text) {
        return try kinds.get(text);
    }
    return data::ResourceKind::Value;
}

pub fn initializer_state_resource_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, data::ResourceKind>
) -> !data::ResourceKind {
    let node = ast.get(value);
    match node.data {
        Var(var_node) => return initializer_var_kind(file, ast, value, kinds);,
        TryExpr(try_expr_node) => return try initializer_state_resource_kind(
            file,
            ast,
            try_expr_node.value,
            kinds
        );,
        Program(program) => return try initializer_resource_kind(file, ast, value);,
        FnDecl(fn_decl) => return try initializer_resource_kind(file, ast, value);,
        Empty => return try initializer_resource_kind(file, ast, value);,
        Int(int_node) => return try initializer_resource_kind(file, ast, value);,
        String(string_node) => return try initializer_resource_kind(file, ast, value);,
        TypeName(type_name) => return try initializer_resource_kind(file, ast, value);,
        Bool(bool_node) => return try initializer_resource_kind(file, ast, value);,
        Prefix(prefix_node) => return try initializer_resource_kind(file, ast, value);,
        Binary(binary) => return try initializer_resource_kind(file, ast, value);,
        FieldExpr(field_expr_node) => return try initializer_resource_kind(file, ast, value);,
        DerefExpr(deref_expr_node) => return try initializer_resource_kind(file, ast, value);,
        Call(call_node) => return try initializer_resource_kind(file, ast, value);,
        TypeApplyExpr(type_apply) => return try initializer_resource_kind(file, ast, value);,
        CastExpr(cast_expr) => return try initializer_resource_kind(file, ast, value);,
        IndexExpr(index_expr) => return try initializer_resource_kind(file, ast, value);,
        StructLiteralExpr(struct_literal) => return try initializer_resource_kind(file, ast, value);,
        StructFieldInit(struct_field_init) => return try initializer_resource_kind(file, ast, value);,
        ArenaNewExpr(arena_new) => return try initializer_resource_kind(file, ast, value);,
        ComptimeExpr(comptime_expr_node) => return try initializer_resource_kind(file, ast, value);,
        Block(block) => return try initializer_resource_kind(file, ast, value);,
        If(if_node) => return try initializer_resource_kind(file, ast, value);,
        Let(let_node) => return try initializer_resource_kind(file, ast, value);,
        Assign(assign_node) => return try initializer_resource_kind(file, ast, value);,
        Return(return_node) => return try initializer_resource_kind(file, ast, value);,
        Defer(defer_node) => return try initializer_resource_kind(file, ast, value);,
        ExprStmt(expr_stmt) => return try initializer_resource_kind(file, ast, value);,
        While(while_node) => return try initializer_resource_kind(file, ast, value);,
        For(for_node) => return try initializer_resource_kind(file, ast, value);,
        Break(break_node) => return try initializer_resource_kind(file, ast, value);,
        Continue(continue_node) => return try initializer_resource_kind(file, ast, value);,
        ImportDecl(import_decl) => return try initializer_resource_kind(file, ast, value);,
        Param(param_node) => return try initializer_resource_kind(file, ast, value);,
        Field(field_node) => return try initializer_resource_kind(file, ast, value);,
        StructDecl(struct_decl) => return try initializer_resource_kind(file, ast, value);,
        EnumDecl(enum_decl) => return try initializer_resource_kind(file, ast, value);,
        UnionDecl(union_decl) => return try initializer_resource_kind(file, ast, value);,
        UnionVariant(union_variant) => return try initializer_resource_kind(file, ast, value);,
        Match(match_node) => return try initializer_resource_kind(file, ast, value);,
        MatchArm(match_arm) => return try initializer_resource_kind(file, ast, value);,
        Unsafe(unsafe_node) => return try initializer_resource_kind(file, ast, value);,
        ComptimeIf(comptime_if_node) => return try initializer_resource_kind(file, ast, value);,
    }
}

