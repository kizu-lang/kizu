import selfhost::source;
import selfhost::ownership::data;

pub fn param_binding_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return ast_node_text(file, ast, param_node.name);,
        Program(program) => return "";,
        Empty => return "";,
        ImportDecl(import_decl) => return "";,
        StructDecl(struct_decl) => return "";,
        EnumDecl(enum_decl) => return "";,
        UnionDecl(union_decl) => return "";,
        FnDecl(fn_decl) => return "";,
        Int(int_node) => return "";,
        String(string_node) => return "";,
        TypeName(type_name) => return "";,
        Var(var_node) => return "";,
        Bool(bool_node) => return "";,
        Prefix(prefix_node) => return "";,
        Binary(binary) => return "";,
        FieldExpr(field_expr_node) => return "";,
        DerefExpr(deref_expr_node) => return "";,
        Call(call_node) => return "";,
        TypeApplyExpr(type_apply) => return "";,
        CastExpr(cast_expr) => return "";,
        IndexExpr(index_expr) => return "";,
        StructLiteralExpr(struct_literal) => return "";,
        StructFieldInit(struct_field_init) => return "";,
        ArenaNewExpr(arena_new) => return "";,
        TryExpr(try_expr_node) => return "";,
        ComptimeExpr(comptime_expr_node) => return "";,
        Block(block) => return "";,
        If(if_node) => return "";,
        Let(let_node) => return "";,
        Assign(assign_node) => return "";,
        Return(return_node) => return "";,
        Defer(defer_node) => return "";,
        ExprStmt(expr_stmt) => return "";,
        While(while_node) => return "";,
        For(for_node) => return "";,
        Break(break_node) => return "";,
        Continue(continue_node) => return "";,
        Field(field_node) => return "";,
        UnionVariant(union_variant) => return "";,
        Match(match_node) => return "";,
        MatchArm(match_arm) => return "";,
        Unsafe(unsafe_node) => return "";,
        ComptimeIf(comptime_if_node) => return "";,
    }
}

pub fn param_resource_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> data::ResourceKind {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return resource_kind_for_type(ast_node_text(file, ast, param_node.type_node));,
        Program(program) => return data::ResourceKind::Value;,
        Empty => return data::ResourceKind::Value;,
        ImportDecl(import_decl) => return data::ResourceKind::Value;,
        StructDecl(struct_decl) => return data::ResourceKind::Value;,
        EnumDecl(enum_decl) => return data::ResourceKind::Value;,
        UnionDecl(union_decl) => return data::ResourceKind::Value;,
        FnDecl(fn_decl) => return data::ResourceKind::Value;,
        Int(int_node) => return data::ResourceKind::Value;,
        String(string_node) => return data::ResourceKind::Value;,
        TypeName(type_name) => return data::ResourceKind::Value;,
        Var(var_node) => return data::ResourceKind::Value;,
        Bool(bool_node) => return data::ResourceKind::Value;,
        Prefix(prefix_node) => return data::ResourceKind::Value;,
        Binary(binary) => return data::ResourceKind::Value;,
        FieldExpr(field_expr_node) => return data::ResourceKind::Value;,
        DerefExpr(deref_expr_node) => return data::ResourceKind::Value;,
        Call(call_node) => return data::ResourceKind::Value;,
        TypeApplyExpr(type_apply) => return data::ResourceKind::Value;,
        CastExpr(cast_expr) => return data::ResourceKind::Value;,
        IndexExpr(index_expr) => return data::ResourceKind::Value;,
        StructLiteralExpr(struct_literal) => return data::ResourceKind::Value;,
        StructFieldInit(struct_field_init) => return data::ResourceKind::Value;,
        ArenaNewExpr(arena_new) => return data::ResourceKind::Value;,
        TryExpr(try_expr_node) => return data::ResourceKind::Value;,
        ComptimeExpr(comptime_expr_node) => return data::ResourceKind::Value;,
        Block(block) => return data::ResourceKind::Value;,
        If(if_node) => return data::ResourceKind::Value;,
        Let(let_node) => return data::ResourceKind::Value;,
        Assign(assign_node) => return data::ResourceKind::Value;,
        Return(return_node) => return data::ResourceKind::Value;,
        Defer(defer_node) => return data::ResourceKind::Value;,
        ExprStmt(expr_stmt) => return data::ResourceKind::Value;,
        While(while_node) => return data::ResourceKind::Value;,
        For(for_node) => return data::ResourceKind::Value;,
        Break(break_node) => return data::ResourceKind::Value;,
        Continue(continue_node) => return data::ResourceKind::Value;,
        Field(field_node) => return data::ResourceKind::Value;,
        UnionVariant(union_variant) => return data::ResourceKind::Value;,
        Match(match_node) => return data::ResourceKind::Value;,
        MatchArm(match_arm) => return data::ResourceKind::Value;,
        Unsafe(unsafe_node) => return data::ResourceKind::Value;,
        ComptimeIf(comptime_if_node) => return data::ResourceKind::Value;,
    }
}

pub fn function_body_statements(
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> std::kizu::ast::ChildRange {
    let node = ast.get(body);
    return match node.data {
        Block(block) => block.statements,
        Program(program) => empty_child_range(),
        Empty => empty_child_range(),
        ImportDecl(import_decl) => empty_child_range(),
        StructDecl(struct_decl) => empty_child_range(),
        EnumDecl(enum_decl) => empty_child_range(),
        UnionDecl(union_decl) => empty_child_range(),
        FnDecl(fn_decl) => empty_child_range(),
        Int(int_node) => empty_child_range(),
        String(string_node) => empty_child_range(),
        TypeName(type_name) => empty_child_range(),
        Var(var_node) => empty_child_range(),
        Bool(bool_node) => empty_child_range(),
        Prefix(prefix_node) => empty_child_range(),
        Binary(binary) => empty_child_range(),
        FieldExpr(field_expr_node) => empty_child_range(),
        DerefExpr(deref_expr_node) => empty_child_range(),
        Call(call_node) => empty_child_range(),
        TypeApplyExpr(type_apply) => empty_child_range(),
        CastExpr(cast_expr) => empty_child_range(),
        IndexExpr(index_expr) => empty_child_range(),
        StructLiteralExpr(struct_literal) => empty_child_range(),
        StructFieldInit(struct_field_init) => empty_child_range(),
        ArenaNewExpr(arena_new) => empty_child_range(),
        TryExpr(try_expr_node) => empty_child_range(),
        ComptimeExpr(comptime_expr_node) => empty_child_range(),
        If(if_node) => empty_child_range(),
        Let(let_node) => empty_child_range(),
        Assign(assign_node) => empty_child_range(),
        Return(return_node) => empty_child_range(),
        Defer(defer_node) => empty_child_range(),
        ExprStmt(expr_stmt) => empty_child_range(),
        While(while_node) => empty_child_range(),
        For(for_node) => empty_child_range(),
        Break(break_node) => empty_child_range(),
        Continue(continue_node) => empty_child_range(),
        Param(param_node) => empty_child_range(),
        Field(field_node) => empty_child_range(),
        UnionVariant(union_variant) => empty_child_range(),
        Match(match_node) => empty_child_range(),
        MatchArm(match_arm) => empty_child_range(),
        Unsafe(unsafe_node) => empty_child_range(),
        ComptimeIf(comptime_if_node) => empty_child_range(),
    };
}

fn empty_child_range() -> std::kizu::ast::ChildRange {
    return std::kizu::ast::ChildRange { start: 0, len: 0 };
}

pub fn statement_is_let(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Let(let_node) => true,
        Program(program) => false,
        Empty => false,
        ImportDecl(import_decl) => false,
        StructDecl(struct_decl) => false,
        EnumDecl(enum_decl) => false,
        UnionDecl(union_decl) => false,
        FnDecl(fn_decl) => false,
        Int(int_node) => false,
        String(string_node) => false,
        TypeName(type_name) => false,
        Var(var_node) => false,
        Bool(bool_node) => false,
        Prefix(prefix_node) => false,
        Binary(binary) => false,
        FieldExpr(field_expr_node) => false,
        DerefExpr(deref_expr_node) => false,
        Call(call_node) => false,
        TypeApplyExpr(type_apply) => false,
        CastExpr(cast_expr) => false,
        IndexExpr(index_expr) => false,
        StructLiteralExpr(struct_literal) => false,
        StructFieldInit(struct_field_init) => false,
        ArenaNewExpr(arena_new) => false,
        TryExpr(try_expr_node) => false,
        ComptimeExpr(comptime_expr_node) => false,
        Block(block) => false,
        If(if_node) => false,
        Assign(assign_node) => false,
        Return(return_node) => false,
        Defer(defer_node) => false,
        ExprStmt(expr_stmt) => false,
        While(while_node) => false,
        For(for_node) => false,
        Break(break_node) => false,
        Continue(continue_node) => false,
        Param(param_node) => false,
        Field(field_node) => false,
        UnionVariant(union_variant) => false,
        Match(match_node) => false,
        MatchArm(match_arm) => false,
        Unsafe(unsafe_node) => false,
        ComptimeIf(comptime_if_node) => false,
    };
}

