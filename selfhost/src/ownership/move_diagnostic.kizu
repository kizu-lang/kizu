import selfhost::source;
import selfhost::ownership::borrow_param_keys;
import selfhost::ownership::data;
import selfhost::ownership::kind;
import selfhost::ownership::state;

pub fn first_use_after_move_summary_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::UseAfterMoveSummary {
    var borrow_params = std::map::Map<[]u8, bool>(allocator);
    try borrow_param_keys::collect_borrow_param_keys(allocator, file, ast, root, borrow_params);
    let result = try first_use_after_move_ast_node(
        allocator,
        file,
        ast,
        root,
        borrow_params
    );
    borrow_params.deinit();
    return result;
}

pub fn first_use_after_move_summary_ast_node_with_borrow_params(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    return first_use_after_move_ast_node(allocator, file, ast, root, borrow_params);
}

pub fn first_use_after_move_name_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> ![]u8 {
    let summary = try first_use_after_move_summary_ast_node(allocator, file, ast, root);
    if summary.found {
        return summary.name;
    }
    return "";
}

pub fn first_use_after_move_name_ast_node_with_borrow_params(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    borrow_params: &std::map::Map<[]u8, bool>
) -> ![]u8 {
    let summary = try first_use_after_move_summary_ast_node_with_borrow_params(
        allocator,
        file,
        ast,
        root,
        borrow_params
    );
    if summary.found {
        return summary.name;
    }
    return "";
}

fn first_use_after_move_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try first_use_after_move_in_decl_range(
            allocator,
            file,
            ast,
            program.declarations,
            borrow_params
        ),
        FnDecl(fn_decl) => try first_use_after_move_in_function(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.body,
            borrow_params
        ),
        ImportDecl(import_decl) => data::no_use_after_move(),
        StructDecl(struct_decl) => data::no_use_after_move(),
        EnumDecl(enum_decl) => data::no_use_after_move(),
        UnionDecl(union_decl) => data::no_use_after_move(),
        ContractDecl(contract_decl) => data::no_use_after_move(),
        ImplDecl(impl_decl) => try first_use_after_move_in_decl_range(
            allocator,
            file,
            ast,
            impl_decl.methods,
            borrow_params
        ),
        Empty => data::no_use_after_move(),
        Int(int_node) => data::no_use_after_move(),
        String(string_node) => data::no_use_after_move(),
        TypeName(type_name) => data::no_use_after_move(),
        Var(var_node) => data::no_use_after_move(),
        Bool(bool_node) => data::no_use_after_move(),
        Prefix(prefix_node) => data::no_use_after_move(),
        Binary(binary) => data::no_use_after_move(),
        FieldExpr(field_expr_node) => data::no_use_after_move(),
        DerefExpr(deref_expr_node) => data::no_use_after_move(),
        Call(call_node) => data::no_use_after_move(),
        TypeApplyExpr(type_apply) => data::no_use_after_move(),
        CastExpr(cast_expr) => data::no_use_after_move(),
        IndexExpr(index_expr) => data::no_use_after_move(),
        StructLiteralExpr(struct_literal) => data::no_use_after_move(),
        StructFieldInit(struct_field_init) => data::no_use_after_move(),
        ArenaNewExpr(arena_new) => data::no_use_after_move(),
        TryExpr(try_expr_node) => data::no_use_after_move(),
        ComptimeExpr(comptime_expr_node) => data::no_use_after_move(),
        Block(block) => data::no_use_after_move(),
        If(if_node) => data::no_use_after_move(),
        Let(let_node) => data::no_use_after_move(),
        Assign(assign_node) => data::no_use_after_move(),
        Return(return_node) => data::no_use_after_move(),
        Defer(defer_node) => data::no_use_after_move(),
        ErrDefer(err_defer_node) => data::no_use_after_move(),
        ExprStmt(expr_stmt) => data::no_use_after_move(),
        While(while_node) => data::no_use_after_move(),
        For(for_node) => data::no_use_after_move(),
        Break(break_node) => data::no_use_after_move(),
        Continue(continue_node) => data::no_use_after_move(),
        Param(param_node) => data::no_use_after_move(),
        Field(field_node) => data::no_use_after_move(),
        UnionVariant(union_variant) => data::no_use_after_move(),
        Match(match_node) => data::no_use_after_move(),
        MatchArm(match_arm) => data::no_use_after_move(),
        Unsafe(unsafe_node) => data::no_use_after_move(),
        ComptimeIf(comptime_if_node) => data::no_use_after_move(),
    };
}

fn first_use_after_move_in_decl_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let name = try first_use_after_move_ast_node(
            allocator,
            file,
            ast,
            child,
            borrow_params
        );
        if name.found {
            return name;
        }
        index = index + 1;
    }
    return data::no_use_after_move();
}

fn first_use_after_move_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    var states = std::map::Map<[]u8, data::OwnershipState>(allocator);
    var kinds = std::map::Map<[]u8, data::ResourceKind>(allocator);
    var resources = std::array::Array<[]u8>(allocator);
    var param_index = 0;
    while param_index < params.len {
        let param_child = try ast.child_at(params, param_index);
        let param_name = kind::param_binding_name(file, ast, param_child);
        if !std::mem::equal_bytes(param_name, "") {
            try state::declare_tracked_resource(
                states,
                kinds,
                resources,
                param_name,
                kind::param_resource_kind(file, ast, param_child)
            );
        }
        param_index = param_index + 1;
    }

    var result = data::no_use_after_move();
    let statements = kind::function_body_statements(ast, body);
    var statement_index = 0;
    while statement_index < statements.len and !result.found {
        let statement = try ast.child_at(statements, statement_index);
        result = try first_use_after_move_statement(
            file,
            ast,
            statement,
            states,
            kinds,
            resources,
            borrow_params
        );
        statement_index = statement_index + 1;
    }
    states.deinit();
    kinds.deinit();
    resources.deinit();
    return result;
}

fn first_use_after_move_statement(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    let node = ast.get(statement);
    return match node.data {
        Let(let_node) => try first_use_after_move_let(
            file,
            ast,
            let_node.name,
            let_node.value,
            states,
            kinds,
            resources,
            borrow_params
        ),
        ExprStmt(expr_stmt) => try first_use_after_move_expr(
            file,
            ast,
            expr_stmt.expr,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        Assign(assign_node) => try first_use_after_move_expr(
            file,
            ast,
            assign_node.value,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        Return(return_node) => try first_use_after_move_expr(
            file,
            ast,
            return_node.value,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        Defer(defer_node) => try first_use_after_move_expr(
            file,
            ast,
            defer_node.expr,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        ErrDefer(err_defer_node) => try first_use_after_move_expr(
            file,
            ast,
            err_defer_node.expr,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        Block(block) => try first_use_after_move_statement_range(
            file,
            ast,
            block.statements,
            states,
            kinds,
            resources,
            borrow_params
        ),
        If(if_node) => try first_use_after_move_if(
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            states,
            kinds,
            resources,
            borrow_params
        ),
        While(while_node) => try first_use_after_move_while(
            file,
            ast,
            while_node.condition,
            while_node.body,
            states,
            kinds,
            resources,
            borrow_params
        ),
        Program(program) => data::no_use_after_move(),
        FnDecl(fn_decl) => data::no_use_after_move(),
        Empty => data::no_use_after_move(),
        ImportDecl(import_decl) => data::no_use_after_move(),
        StructDecl(struct_decl) => data::no_use_after_move(),
        EnumDecl(enum_decl) => data::no_use_after_move(),
        UnionDecl(union_decl) => data::no_use_after_move(),
        ContractDecl(contract_decl) => data::no_use_after_move(),
        ImplDecl(impl_decl) => data::no_use_after_move(),
        Int(int_node) => data::no_use_after_move(),
        String(string_node) => data::no_use_after_move(),
        TypeName(type_name) => data::no_use_after_move(),
        Var(var_node) => data::no_use_after_move(),
        Bool(bool_node) => data::no_use_after_move(),
        Prefix(prefix_node) => data::no_use_after_move(),
        Binary(binary) => data::no_use_after_move(),
        FieldExpr(field_expr_node) => data::no_use_after_move(),
        DerefExpr(deref_expr_node) => data::no_use_after_move(),
        Call(call_node) => data::no_use_after_move(),
        TypeApplyExpr(type_apply) => data::no_use_after_move(),
        CastExpr(cast_expr) => data::no_use_after_move(),
        IndexExpr(index_expr) => data::no_use_after_move(),
        StructLiteralExpr(struct_literal) => data::no_use_after_move(),
        StructFieldInit(struct_field_init) => data::no_use_after_move(),
        ArenaNewExpr(arena_new) => data::no_use_after_move(),
        TryExpr(try_expr_node) => data::no_use_after_move(),
        ComptimeExpr(comptime_expr_node) => data::no_use_after_move(),
        For(for_node) => data::no_use_after_move(),
        Break(break_node) => data::no_use_after_move(),
        Continue(continue_node) => data::no_use_after_move(),
        Param(param_node) => data::no_use_after_move(),
        Field(field_node) => data::no_use_after_move(),
        UnionVariant(union_variant) => data::no_use_after_move(),
        Match(match_node) => data::no_use_after_move(),
        MatchArm(match_arm) => data::no_use_after_move(),
        Unsafe(unsafe_node) => data::no_use_after_move(),
        ComptimeIf(comptime_if_node) => data::no_use_after_move(),
    };
}

fn first_use_after_move_statement_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    var index = 0;
    while index < range.len {
        let statement = try ast.child_at(range, index);
        let name = try first_use_after_move_statement(
            file,
            ast,
            statement,
            states,
            kinds,
            resources,
            borrow_params
        );
        if name.found {
            return name;
        }
        index = index + 1;
    }
    return data::no_use_after_move();
}

fn first_use_after_move_if(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    let condition_name = try first_use_after_move_expr(
        file,
        ast,
        condition,
        states,
        kinds,
        resources,
        borrow_params,
        false
    );
    if condition_name.found {
        return condition_name;
    }

    var then_states = std::map::Map<[]u8, data::OwnershipState>(std::mem::page_allocator());
    var then_kinds = std::map::Map<[]u8, data::ResourceKind>(std::mem::page_allocator());
    var then_resources = std::array::Array<[]u8>(std::mem::page_allocator());
    try state::fork_resources(states, kinds, resources, then_states, then_kinds, then_resources);
    let then_name = try first_use_after_move_statement(
        file,
        ast,
        then_block,
        then_states,
        then_kinds,
        then_resources,
        borrow_params
    );

    var else_states = std::map::Map<[]u8, data::OwnershipState>(std::mem::page_allocator());
    var else_kinds = std::map::Map<[]u8, data::ResourceKind>(std::mem::page_allocator());
    var else_resources = std::array::Array<[]u8>(std::mem::page_allocator());
    try state::fork_resources(states, kinds, resources, else_states, else_kinds, else_resources);
    var result = then_name;
    if !result.found {
        result = try first_use_after_move_statement(
            file,
            ast,
            else_block,
            else_states,
            else_kinds,
            else_resources,
            borrow_params
        );
    }

    if !result.found {
        try state::merge_branch_moves(states, resources, then_states);
        try state::merge_branch_moves(states, resources, else_states);
    }
    then_states.deinit();
    then_kinds.deinit();
    then_resources.deinit();
    else_states.deinit();
    else_kinds.deinit();
    else_resources.deinit();
    return result;
}

fn first_use_after_move_while(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    let condition_name = try first_use_after_move_expr(
        file,
        ast,
        condition,
        states,
        kinds,
        resources,
        borrow_params,
        false
    );
    if condition_name.found {
        return condition_name;
    }

    var body_states = std::map::Map<[]u8, data::OwnershipState>(std::mem::page_allocator());
    var body_kinds = std::map::Map<[]u8, data::ResourceKind>(std::mem::page_allocator());
    var body_resources = std::array::Array<[]u8>(std::mem::page_allocator());
    try state::fork_resources(states, kinds, resources, body_states, body_kinds, body_resources);
    let body_name = try first_use_after_move_statement(
        file,
        ast,
        body,
        body_states,
        body_kinds,
        body_resources,
        borrow_params
    );

    if !body_name.found {
        try state::merge_branch_moves(states, resources, body_states);
    }
    body_states.deinit();
    body_kinds.deinit();
    body_resources.deinit();
    return body_name;
}

fn first_use_after_move_let(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    let used = try first_use_after_move_expr(
        file,
        ast,
        value,
        states,
        kinds,
        resources,
        borrow_params,
        true
    );
    if used.found {
        return used;
    }
    let name_text = kind::ast_node_text(file, ast, name);
    if !std::mem::equal_bytes(name_text, "") and !states.contains(name_text) {
        let kind = try move_check_initializer_kind(file, ast, value, kinds);
        try state::declare_tracked_resource(states, kinds, resources, name_text, kind);
    }
    return data::no_use_after_move();
}

fn first_use_after_move_expr(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>,
    move_direct: bool
) -> !data::UseAfterMoveSummary {
    let base = moved_base_name(file, ast, expr);
    if !std::mem::equal_bytes(base, "") and states.contains(base) {
        let state = try states.get(base);
        if state == data::OwnershipState::Moved {
            return use_after_move_summary(ast, expr, base);
        }
    }
    let node = ast.get(expr);
    return match node.data {
        Var(var_node) => try move_direct_name_if_needed(file, ast, expr, states, kinds, move_direct),
        FieldExpr(field_expr) => try first_use_after_move_expr(
            file,
            ast,
            field_expr.receiver,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        Call(call_node) => try first_use_after_move_call(
            file,
            ast,
            call_node.callee,
            call_node.args,
            states,
            kinds,
            resources,
            borrow_params
        ),
        StructLiteralExpr(struct_literal) => try first_use_after_move_expr_range(
            file,
            ast,
            struct_literal.fields,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        StructFieldInit(field_init) => try first_use_after_move_expr(
            file,
            ast,
            field_init.value,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        Prefix(prefix_node) => try first_use_after_move_expr(
            file,
            ast,
            prefix_node.right,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        Binary(binary) => try first_use_after_move_two_exprs(
            file,
            ast,
            binary.left,
            binary.right,
            states,
            kinds,
            resources,
            borrow_params
        ),
        TypeApplyExpr(type_apply) => try first_use_after_move_expr(
            file,
            ast,
            type_apply.callee,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        TryExpr(try_expr_node) => try first_use_after_move_expr(
            file,
            ast,
            try_expr_node.value,
            states,
            kinds,
            resources,
            borrow_params,
            move_direct
        ),
        ComptimeExpr(comptime_expr_node) => try first_use_after_move_expr(
            file,
            ast,
            comptime_expr_node.value,
            states,
            kinds,
            resources,
            borrow_params,
            move_direct
        ),
        DerefExpr(deref_expr) => try first_use_after_move_expr(
            file,
            ast,
            deref_expr.receiver,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        IndexExpr(index_expr) => try first_use_after_move_index(
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end,
            states,
            kinds,
            resources,
            borrow_params
        ),
        Program(program) => data::no_use_after_move(),
        FnDecl(fn_decl) => data::no_use_after_move(),
        Empty => data::no_use_after_move(),
        ImportDecl(import_decl) => data::no_use_after_move(),
        StructDecl(struct_decl) => data::no_use_after_move(),
        EnumDecl(enum_decl) => data::no_use_after_move(),
        UnionDecl(union_decl) => data::no_use_after_move(),
        ContractDecl(contract_decl) => data::no_use_after_move(),
        ImplDecl(impl_decl) => data::no_use_after_move(),
        Int(int_node) => data::no_use_after_move(),
        String(string_node) => data::no_use_after_move(),
        TypeName(type_name) => data::no_use_after_move(),
        Bool(bool_node) => data::no_use_after_move(),
        CastExpr(cast_expr) => try first_use_after_move_expr(
            file,
            ast,
            cast_expr.value,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        ArenaNewExpr(arena_new) => try first_use_after_move_expr(
            file,
            ast,
            arena_new.allocator,
            states,
            kinds,
            resources,
            borrow_params,
            false
        ),
        Block(block) => try first_use_after_move_statement_range(
            file,
            ast,
            block.statements,
            states,
            kinds,
            resources,
            borrow_params
        ),
        If(if_node) => try first_use_after_move_if(
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            states,
            kinds,
            resources,
            borrow_params
        ),
        Let(let_node) => data::no_use_after_move(),
        Assign(assign_node) => data::no_use_after_move(),
        Return(return_node) => data::no_use_after_move(),
        Defer(defer_node) => data::no_use_after_move(),
        ErrDefer(err_defer_node) => data::no_use_after_move(),
        ExprStmt(expr_stmt) => data::no_use_after_move(),
        While(while_node) => data::no_use_after_move(),
        For(for_node) => data::no_use_after_move(),
        Break(break_node) => data::no_use_after_move(),
        Continue(continue_node) => data::no_use_after_move(),
        Param(param_node) => data::no_use_after_move(),
        Field(field_node) => data::no_use_after_move(),
        UnionVariant(union_variant) => data::no_use_after_move(),
        Match(match_node) => data::no_use_after_move(),
        MatchArm(match_arm) => data::no_use_after_move(),
        Unsafe(unsafe_node) => data::no_use_after_move(),
        ComptimeIf(comptime_if_node) => data::no_use_after_move(),
    };
}

fn first_use_after_move_call(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    let callee_name = try first_use_after_move_expr(
        file,
        ast,
        callee,
        states,
        kinds,
        resources,
        borrow_params,
        false
    );
    if callee_name.found {
        return callee_name;
    }
    var index = 0;
    while index < args.len {
        let child = try ast.child_at(args, index);
        let move_direct = try call_arg_moves_direct(
            file,
            ast,
            callee,
            index,
            borrow_params
        );
        let name = try first_use_after_move_expr(
            file,
            ast,
            child,
            states,
            kinds,
            resources,
            borrow_params,
            move_direct
        );
        if name.found {
            return name;
        }
        index = index + 1;
    }
    return data::no_use_after_move();
}

fn first_use_after_move_expr_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>,
    move_direct: bool
) -> !data::UseAfterMoveSummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let name = try first_use_after_move_expr(
            file,
            ast,
            child,
            states,
            kinds,
            resources,
            borrow_params,
            move_direct
        );
        if name.found {
            return name;
        }
        index = index + 1;
    }
    return data::no_use_after_move();
}

fn first_use_after_move_two_exprs(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    let left_name = try first_use_after_move_expr(
        file,
        ast,
        left,
        states,
        kinds,
        resources,
        borrow_params,
        false
    );
    if left_name.found {
        return left_name;
    }
    return try first_use_after_move_expr(
        file,
        ast,
        right,
        states,
        kinds,
        resources,
        borrow_params,
        false
    );
}

fn first_use_after_move_index(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    resources: &var std::array::Array<[]u8>,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    let target_name = try first_use_after_move_expr(
        file,
        ast,
        target,
        states,
        kinds,
        resources,
        borrow_params,
        false
    );
    if target_name.found {
        return target_name;
    }
    return try first_use_after_move_two_exprs(
        file,
        ast,
        start,
        end,
        states,
        kinds,
        resources,
        borrow_params
    );
}

fn move_direct_name_if_needed(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    move_direct: bool
) -> !data::UseAfterMoveSummary {
    if !move_direct {
        return data::no_use_after_move();
    }
    let name = kind::ast_node_text(file, ast, expr);
    if !states.contains(name) {
        return data::no_use_after_move();
    }
    let state = try states.get(name);
    if state == data::OwnershipState::Moved {
        return use_after_move_summary(ast, expr, name);
    }
    let kind = try kinds.get(name);
    if kind::resource_kind_moves(kind) {
        try state::move_value(states, name);
    }
    return data::no_use_after_move();
}

fn use_after_move_summary(
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    name: []u8
) -> data::UseAfterMoveSummary {
    let node = ast.get(expr);
    return data::use_after_move_summary(true, node.span.start, node.span.end, name);
}

fn moved_base_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(expr);
    return match node.data {
        Var(var_node) => kind::ast_node_text(file, ast, expr),
        FieldExpr(field_expr) => moved_base_name(file, ast, field_expr.receiver),
        DerefExpr(deref_expr) => moved_base_name(file, ast, deref_expr.receiver),
        TryExpr(try_expr_node) => moved_base_name(file, ast, try_expr_node.value),
        ComptimeExpr(comptime_expr_node) => moved_base_name(file, ast, comptime_expr_node.value),
        Program(program) => "",
        FnDecl(fn_decl) => "",
        Empty => "",
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        ContractDecl(contract_decl) => "",
        ImplDecl(impl_decl) => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Bool(bool_node) => "",
        Prefix(prefix_node) => "",
        Binary(binary) => "",
        Call(call_node) => "",
        TypeApplyExpr(type_apply) => "",
        CastExpr(cast_expr) => "",
        IndexExpr(index_expr) => "",
        StructLiteralExpr(struct_literal) => "",
        StructFieldInit(struct_field_init) => "",
        ArenaNewExpr(arena_new) => "",
        Block(block) => "",
        If(if_node) => "",
        Let(let_node) => "",
        Assign(assign_node) => "",
        Return(return_node) => "",
        Defer(defer_node) => "",
        ErrDefer(err_defer_node) => "",
        ExprStmt(expr_stmt) => "",
        While(while_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn call_arg_moves_direct(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    arg_index: i64,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !bool {
    let text = kind::ast_node_text(file, ast, callee);
    if std::mem::equal_bytes(text, "print") or std::mem::equal_bytes(text, "std::testing::expect") {
        return false;
    }
    if std_fmt_string_arg_borrows(text, arg_index) {
        return false;
    }
    var key = try borrow_param_keys::function_param_key(std::mem::page_allocator(), text, arg_index);
    let key_bytes = key.as_bytes();
    let borrows = borrow_params.contains(key_bytes);
    key.deinit();
    return !borrows;
}

fn std_fmt_string_arg_borrows(callee_text: []u8, arg_index: i64) -> bool {
    if arg_index != 0 {
        return false;
    }
    if std::mem::equal_bytes(callee_text, "std::fmt::append_i64") {
        return true;
    }
    if std::mem::equal_bytes(callee_text, "std::fmt::append_bool") {
        return true;
    }
    if std::mem::equal_bytes(callee_text, "std::fmt::append_bytes_literal") {
        return true;
    }
    return false;
}

fn move_check_initializer_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, data::ResourceKind>
) -> !data::ResourceKind {
    if initializer_is_record_literal(ast, value) {
        return data::ResourceKind::Record;
    }
    return try kind::initializer_state_resource_kind(file, ast, value, kinds);
}

fn initializer_is_record_literal(
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(value);
    return match node.data {
        StructLiteralExpr(struct_literal) => true,
        _ => false,
    };
}
