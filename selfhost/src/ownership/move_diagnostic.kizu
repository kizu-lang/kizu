import selfhost::parser;
import selfhost::source;
import selfhost::ownership::data;
import selfhost::ownership::kind;
import selfhost::ownership::state;

pub fn first_use_after_move_name(
    allocator: Allocator,
    path: []u8,
    text: []u8
) -> ![]u8 {
    let file = source::SourceFile {
        id: 0,
        kind: source::SourceKind::User,
        path: path,
        text: text
    };
    let result = try parser::parse_checked_file(allocator, file.path, file.text);
    let name = try first_use_after_move_ast_node(allocator, &file, result.ast, result.root);
    result.deinit();
    return name;
}

fn first_use_after_move_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ![]u8 {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try first_use_after_move_in_decl_range(
            allocator,
            file,
            ast,
            program.declarations
        ),
        FnDecl(fn_decl) => try first_use_after_move_in_function(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.body
        ),
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        Empty => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Var(var_node) => "",
        Bool(bool_node) => "",
        Prefix(prefix_node) => "",
        Binary(binary) => "",
        FieldExpr(field_expr_node) => "",
        DerefExpr(deref_expr_node) => "",
        Call(call_node) => "",
        TypeApplyExpr(type_apply) => "",
        CastExpr(cast_expr) => "",
        IndexExpr(index_expr) => "",
        StructLiteralExpr(struct_literal) => "",
        StructFieldInit(struct_field_init) => "",
        ArenaNewExpr(arena_new) => "",
        TryExpr(try_expr_node) => "",
        ComptimeExpr(comptime_expr_node) => "",
        Block(block) => "",
        If(if_node) => "",
        Let(let_node) => "",
        Assign(assign_node) => "",
        Return(return_node) => "",
        Defer(defer_node) => "",
        ExprStmt(expr_stmt) => "",
        While(while_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn first_use_after_move_in_decl_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> ![]u8 {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let name = try first_use_after_move_ast_node(allocator, file, ast, child);
        if !std::mem::equal_bytes(name, "") {
            return name;
        }
        index = index + 1;
    }
    return "";
}

fn first_use_after_move_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId
) -> ![]u8 {
    var states = std::map::Map<[]u8, data::OwnershipState>(allocator);
    var kinds = std::map::Map<[]u8, data::ResourceKind>(allocator);
    var param_index = 0;
    while param_index < params.len {
        let param_child = try ast.child_at(params, param_index);
        let param_name = kind::param_binding_name(file, ast, param_child);
        if !std::mem::equal_bytes(param_name, "") {
            try state::declare_resource(states, kinds, param_name, kind::param_resource_kind(file, ast, param_child));
        }
        param_index = param_index + 1;
    }

    var result = "";
    let statements = kind::function_body_statements(ast, body);
    var statement_index = 0;
    while statement_index < statements.len and std::mem::equal_bytes(result, "") {
        let statement = try ast.child_at(statements, statement_index);
        result = try first_use_after_move_statement(
            file,
            ast,
            statement,
            states,
            kinds
        );
        statement_index = statement_index + 1;
    }
    states.deinit();
    kinds.deinit();
    return result;
}

fn first_use_after_move_statement(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>
) -> ![]u8 {
    let node = ast.get(statement);
    return match node.data {
        Let(let_node) => try first_use_after_move_let(
            file,
            ast,
            let_node.name,
            let_node.value,
            states,
            kinds
        ),
        ExprStmt(expr_stmt) => try first_use_after_move_expr(
            file,
            ast,
            expr_stmt.expr,
            states,
            kinds,
            false
        ),
        Assign(assign_node) => try first_use_after_move_expr(
            file,
            ast,
            assign_node.value,
            states,
            kinds,
            false
        ),
        Return(return_node) => try first_use_after_move_expr(
            file,
            ast,
            return_node.value,
            states,
            kinds,
            false
        ),
        Defer(defer_node) => try first_use_after_move_expr(
            file,
            ast,
            defer_node.expr,
            states,
            kinds,
            false
        ),
        Block(block) => try first_use_after_move_statement_range(
            file,
            ast,
            block.statements,
            states,
            kinds
        ),
        If(if_node) => try first_use_after_move_if(
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            states,
            kinds
        ),
        While(while_node) => try first_use_after_move_if(
            file,
            ast,
            while_node.condition,
            while_node.body,
            ast.add_empty(0),
            states,
            kinds
        ),
        Program(program) => "",
        FnDecl(fn_decl) => "",
        Empty => "",
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Var(var_node) => "",
        Bool(bool_node) => "",
        Prefix(prefix_node) => "",
        Binary(binary) => "",
        FieldExpr(field_expr_node) => "",
        DerefExpr(deref_expr_node) => "",
        Call(call_node) => "",
        TypeApplyExpr(type_apply) => "",
        CastExpr(cast_expr) => "",
        IndexExpr(index_expr) => "",
        StructLiteralExpr(struct_literal) => "",
        StructFieldInit(struct_field_init) => "",
        ArenaNewExpr(arena_new) => "",
        TryExpr(try_expr_node) => "",
        ComptimeExpr(comptime_expr_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn first_use_after_move_statement_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>
) -> ![]u8 {
    var index = 0;
    while index < range.len {
        let statement = try ast.child_at(range, index);
        let name = try first_use_after_move_statement(file, ast, statement, states, kinds);
        if !std::mem::equal_bytes(name, "") {
            return name;
        }
        index = index + 1;
    }
    return "";
}

fn first_use_after_move_if(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>
) -> ![]u8 {
    let condition_name = try first_use_after_move_expr(file, ast, condition, states, kinds, false);
    if !std::mem::equal_bytes(condition_name, "") {
        return condition_name;
    }
    let then_name = try first_use_after_move_statement(file, ast, then_block, states, kinds);
    if !std::mem::equal_bytes(then_name, "") {
        return then_name;
    }
    return try first_use_after_move_statement(file, ast, else_block, states, kinds);
}

fn first_use_after_move_let(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>
) -> ![]u8 {
    let used = try first_use_after_move_expr(file, ast, value, states, kinds, true);
    if !std::mem::equal_bytes(used, "") {
        return used;
    }
    let name_text = kind::ast_node_text(file, ast, name);
    if !std::mem::equal_bytes(name_text, "") and !states.contains(name_text) {
        let kind = try move_check_initializer_kind(file, ast, value, kinds);
        try state::declare_resource(states, kinds, name_text, kind);
    }
    return "";
}

fn first_use_after_move_expr(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    move_direct: bool
) -> ![]u8 {
    let base = moved_base_name(file, ast, expr);
    if !std::mem::equal_bytes(base, "") and states.contains(base) {
        let state = try states.get(base);
        if state == data::OwnershipState::Moved {
            return base;
        }
    }
    let node = ast.get(expr);
    return match node.data {
        Var(var_node) => try move_direct_name_if_needed(file, ast, expr, states, kinds, move_direct),
        FieldExpr(field_expr) => try first_use_after_move_expr(
            file,
            ast,
            field_expr.receiver,
            states,
            kinds,
            false
        ),
        Call(call_node) => try first_use_after_move_call(
            file,
            ast,
            call_node.callee,
            call_node.args,
            states,
            kinds
        ),
        StructLiteralExpr(struct_literal) => try first_use_after_move_expr_range(
            file,
            ast,
            struct_literal.fields,
            states,
            kinds,
            false
        ),
        StructFieldInit(field_init) => try first_use_after_move_expr(
            file,
            ast,
            field_init.value,
            states,
            kinds,
            false
        ),
        Prefix(prefix_node) => try first_use_after_move_expr(
            file,
            ast,
            prefix_node.right,
            states,
            kinds,
            false
        ),
        Binary(binary) => try first_use_after_move_two_exprs(
            file,
            ast,
            binary.left,
            binary.right,
            states,
            kinds
        ),
        TypeApplyExpr(type_apply) => try first_use_after_move_expr(
            file,
            ast,
            type_apply.callee,
            states,
            kinds,
            false
        ),
        TryExpr(try_expr_node) => try first_use_after_move_expr(
            file,
            ast,
            try_expr_node.value,
            states,
            kinds,
            move_direct
        ),
        ComptimeExpr(comptime_expr_node) => try first_use_after_move_expr(
            file,
            ast,
            comptime_expr_node.value,
            states,
            kinds,
            move_direct
        ),
        DerefExpr(deref_expr) => try first_use_after_move_expr(
            file,
            ast,
            deref_expr.receiver,
            states,
            kinds,
            false
        ),
        IndexExpr(index_expr) => try first_use_after_move_index(
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end,
            states,
            kinds
        ),
        Program(program) => "",
        FnDecl(fn_decl) => "",
        Empty => "",
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Bool(bool_node) => "",
        CastExpr(cast_expr) => try first_use_after_move_expr(
            file,
            ast,
            cast_expr.value,
            states,
            kinds,
            false
        ),
        ArenaNewExpr(arena_new) => try first_use_after_move_expr(
            file,
            ast,
            arena_new.allocator,
            states,
            kinds,
            false
        ),
        Block(block) => try first_use_after_move_statement_range(file, ast, block.statements, states, kinds),
        If(if_node) => try first_use_after_move_if(
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            states,
            kinds
        ),
        Let(let_node) => "",
        Assign(assign_node) => "",
        Return(return_node) => "",
        Defer(defer_node) => "",
        ExprStmt(expr_stmt) => "",
        While(while_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn first_use_after_move_call(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>
) -> ![]u8 {
    let callee_name = try first_use_after_move_expr(file, ast, callee, states, kinds, false);
    if !std::mem::equal_bytes(callee_name, "") {
        return callee_name;
    }
    return try first_use_after_move_expr_range(
        file,
        ast,
        args,
        states,
        kinds,
        call_moves_direct_args(file, ast, callee)
    );
}

fn first_use_after_move_expr_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    move_direct: bool
) -> ![]u8 {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let name = try first_use_after_move_expr(file, ast, child, states, kinds, move_direct);
        if !std::mem::equal_bytes(name, "") {
            return name;
        }
        index = index + 1;
    }
    return "";
}

fn first_use_after_move_two_exprs(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>
) -> ![]u8 {
    let left_name = try first_use_after_move_expr(file, ast, left, states, kinds, false);
    if !std::mem::equal_bytes(left_name, "") {
        return left_name;
    }
    return try first_use_after_move_expr(file, ast, right, states, kinds, false);
}

fn first_use_after_move_index(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>
) -> ![]u8 {
    let target_name = try first_use_after_move_expr(file, ast, target, states, kinds, false);
    if !std::mem::equal_bytes(target_name, "") {
        return target_name;
    }
    return try first_use_after_move_two_exprs(file, ast, start, end, states, kinds);
}

fn move_direct_name_if_needed(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, data::OwnershipState>,
    kinds: &var std::map::Map<[]u8, data::ResourceKind>,
    move_direct: bool
) -> ![]u8 {
    if !move_direct {
        return "";
    }
    let name = kind::ast_node_text(file, ast, expr);
    if !states.contains(name) {
        return "";
    }
    let state = try states.get(name);
    if state == data::OwnershipState::Moved {
        return name;
    }
    let kind = try kinds.get(name);
    if kind::resource_kind_moves(kind) {
        try state::move_value(states, name);
    }
    return "";
}

fn moved_base_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(expr);
    return match node.data {
        Var(var_node) => kind::ast_node_text(file, ast, expr),
        FieldExpr(field_expr) => moved_base_name(file, ast, field_expr.receiver),
        DerefExpr(deref_expr) => moved_base_name(file, ast, deref_expr.receiver),
        TryExpr(try_expr_node) => moved_base_name(file, ast, try_expr_node.value),
        ComptimeExpr(comptime_expr_node) => moved_base_name(file, ast, comptime_expr_node.value),
        Program(program) => "",
        FnDecl(fn_decl) => "",
        Empty => "",
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Bool(bool_node) => "",
        Prefix(prefix_node) => "",
        Binary(binary) => "",
        Call(call_node) => "",
        TypeApplyExpr(type_apply) => "",
        CastExpr(cast_expr) => "",
        IndexExpr(index_expr) => "",
        StructLiteralExpr(struct_literal) => "",
        StructFieldInit(struct_field_init) => "",
        ArenaNewExpr(arena_new) => "",
        Block(block) => "",
        If(if_node) => "",
        Let(let_node) => "",
        Assign(assign_node) => "",
        Return(return_node) => "",
        Defer(defer_node) => "",
        ExprStmt(expr_stmt) => "",
        While(while_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn call_moves_direct_args(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> bool {
    let text = kind::ast_node_text(file, ast, callee);
    return !std::mem::equal_bytes(text, "print") and
        !std::mem::equal_bytes(text, "std::testing::expect");
}

fn move_check_initializer_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, data::ResourceKind>
) -> !data::ResourceKind {
    if initializer_text_is_record_literal(file, ast, value) {
        return data::ResourceKind::Record;
    }
    return try kind::initializer_state_resource_kind(file, ast, value, kinds);
}

fn initializer_text_is_record_literal(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> bool {
    let text = kind::ast_node_text(file, ast, value);
    return !std::mem::starts_with(text, "{") and bytes_contains(text, "{");
}
fn bytes_contains(haystack: []u8, needle: []u8) -> bool {
    let needle_len = std::mem::len(needle);
    if needle_len < 1 {
        return true;
    }
    if needle_len > std::mem::len(haystack) {
        return false;
    }
    var index = 0;
    while index + needle_len <= std::mem::len(haystack) {
        if std::mem::equal_bytes(haystack[index..index + needle_len], needle) {
            return true;
        }
        index = index + 1;
    }
    return false;
}
