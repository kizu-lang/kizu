// Module: lexer component tests for the future self-host compiler frontend.

import selfhost::lexer;
import selfhost::token;

// lexer_ready_test checks the package-level lexer API through std::testing.
pub fn lexer_ready_test() -> !void {
    try std::testing::expect(lexer::ready());
    try std::testing::expect_equal_i64(0, lexer::source_len(""));

    let eof = lexer::eof_token("");
    try std::testing::expect(eof.kind == token::TokenKind::Eof);
    try std::testing::expect_equal_i64(0, eof.start);
    try std::testing::expect_equal_i64(0, eof.end);
    try std::testing::expect_equal_i64(1, eof.line);
    try std::testing::expect_equal_i64(1, eof.column);
    return void;
}
