import selfhost::source;
import selfhost::source::manifest;
import selfhost::source::std_index;

pub fn load_selfhost_package(
    allocator: Allocator,
    io: Io,
    root: []u8
) -> !source::PackageSummary {
    var files = try load_selfhost_sources(allocator, io, root);
    let manifest_sources = try source::count_kind(files, source::SourceKind::Manifest);
    let selfhost_sources = try source::count_kind(files, source::SourceKind::Selfhost);
    let std_sources = try source::count_kind(files, source::SourceKind::Std);
    let summary = source::summarize(
        files.len(),
        manifest_sources,
        selfhost_sources,
        std_sources,
        0,
        0
    );
    files.deinit();
    return summary;
}

pub fn load_selfhost_sources(
    allocator: Allocator,
    io: Io,
    root: []u8
) -> !std::array::Array<source::SourceFile> {
    var files = std::array::Array<source::SourceFile>(allocator);

    var manifest_path = try std::path::join(allocator, root, "kizu.toml");
    let manifest_bytes = manifest_path.as_bytes();
    let manifest_text = try std::fs::read_file(io, manifest_bytes);
    manifest_path.deinit();
    if !manifest::is_manifest_text(manifest_text) {
        return error("invalid manifest");
    }
    let package_name = try manifest::package_name(manifest_text);
    try manifest::validate_module_root(allocator, io, root, manifest_text);
    let module_root = try manifest::module_root(manifest_text);
    try files.append(source_file(
        0,
        source::SourceKind::Manifest,
        package_name,
        0,
        0,
        "selfhost/kizu.toml",
        manifest_text
    ));
    var next_id = 1;

    var source_dir = try std::path::join(allocator, root, "src");
    let source_dir_len = source_dir.len();
    let source_dir_path = source_dir.as_bytes();
    next_id = try append_selfhost_source_dir(
        files,
        io,
        source_dir_path,
        source_dir_len,
        module_root,
        next_id,
        package_name
    );
    source_dir.deinit();

    next_id = try append_frontend_std_sources(files, io, next_id);
    return files;
}

pub fn load_package_sources(
    allocator: Allocator,
    io: Io,
    root: []u8
) -> !std::array::Array<source::SourceFile> {
    var files = std::array::Array<source::SourceFile>(allocator);

    var manifest_path = try std::path::join(allocator, root, "kizu.toml");
    let manifest_bytes = manifest_path.as_bytes();
    let manifest_text = try std::fs::read_file(io, manifest_bytes);
    manifest_path.deinit();
    if !manifest::is_manifest_text(manifest_text) {
        return error("invalid manifest");
    }
    let package_name = try manifest::package_name(manifest_text);
    try manifest::validate_module_root(allocator, io, root, manifest_text);
    let module_root = try manifest::module_root(manifest_text);
    try files.append(source_file(
        0,
        source::SourceKind::Manifest,
        package_name,
        0,
        0,
        root,
        manifest_text
    ));
    var next_id = 1;

    let package_source_start = next_id;
    next_id = try append_manifest_package_source_dirs(
        allocator,
        files,
        io,
        root,
        manifest_text,
        module_root,
        next_id,
        package_name
    );

    next_id = try append_package_referenced_frontend_std_sources(
        allocator,
        files,
        io,
        next_id,
        package_source_start
    );
    return files;
}

pub fn load_file_sources(
    allocator: Allocator,
    io: Io,
    path: []u8,
    text: []u8
) -> !std::array::Array<source::SourceFile> {
    var files = std::array::Array<source::SourceFile>(allocator);
    if module_end_for(path) <= module_start_for(source::SourceKind::User, path) {
        return error("invalid module");
    }
    try files.append(source_file(
        0,
        source::SourceKind::User,
        "selfhost",
        module_start_for(source::SourceKind::User, path),
        module_end_for(path),
        path,
        text
    ));
    try append_referenced_frontend_std_sources(allocator, files, io, 1, text);
    return files;
}

fn append_std_source(
    files: &var std::array::Array<source::SourceFile>,
    io: Io,
    id: i64,
    path: []u8
) -> !i64 {
    let text = try std::fs::read_file(io, path);
    try append_std_source_text(files, id, path, text);
    return id + 1;
}

fn append_std_source_text(
    files: &var std::array::Array<source::SourceFile>,
    id: i64,
    path: []u8,
    text: []u8
) -> !void {
    try files.append(source_file(
        id,
        source::SourceKind::Std,
        "std",
        module_start_for(source::SourceKind::Std, path),
        module_end_for(path),
        path,
        text
    ));
    return;
}

fn append_selfhost_source_dir(
    files: &var std::array::Array<source::SourceFile>,
    io: Io,
    dir: &[]u8,
    source_root_len: i64,
    module_root: []u8,
    next_id: i64,
    package_name: []u8
) -> !i64 {
    var id = next_id;
    var entries = try std::fs::read_dir(io, dir);
    var index = 0;
    while index < entries.len() {
        let entry = try entries.get(index);
        if entry.is_dir {
            id = try append_selfhost_source_dir(
                files,
                io,
                entry.path,
                source_root_len,
                module_root,
                id,
                package_name
            );
        } else {
            if std::mem::equal_bytes(std::path::extension(entry.name), ".kizu") {
                var module_start = 0;
                var module_end = 0;
                if !is_manifest_root_source(module_root, entry.path) {
                    module_start = package_module_start(source_root_len, entry.path);
                    module_end = package_module_end(entry.path, module_start);
                    if module_end <= module_start {
                        return error("invalid module");
                    }
                }
                if try source_module_exists(files, package_name, entry.path, module_start, module_end) {
                    return error("duplicate module");
                }
                let text = try std::fs::read_file(io, entry.path);
                try files.append(source_file(
                    id,
                    source::SourceKind::Selfhost,
                    package_name,
                    module_start,
                    module_end,
                    entry.path,
                    text
                ));
                id = id + 1;
            }
        }
        index = index + 1;
    }
    entries.deinit();
    return id;
}

fn source_module_exists(
    files: &std::array::Array<source::SourceFile>,
    package_name: []u8,
    path: []u8,
    module_start: i64,
    module_end: i64
) -> !bool {
    let module = path[module_start..module_end];
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind == source::SourceKind::Selfhost and
            std::mem::equal_bytes(file.package_name, package_name) and
            std::mem::equal_bytes(source::module_path(file), module) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn append_manifest_package_source_dirs(
    allocator: Allocator,
    files: &var std::array::Array<source::SourceFile>,
    io: Io,
    root: []u8,
    manifest_text: []u8,
    module_root: []u8,
    next_id: i64,
    package_name: []u8
) -> !i64 {
    let paths_start = manifest::paths_array_start(manifest_text);
    if paths_start < 0 {
        return try append_package_source_dir(
            allocator,
            files,
            io,
            root,
            "src",
            module_root,
            next_id,
            package_name
        );
    }
    return try append_manifest_path_array_source_dirs(
        allocator,
        files,
        io,
        root,
        manifest_text,
        paths_start,
        module_root,
        next_id,
        package_name
    );
}

fn append_manifest_path_array_source_dirs(
    allocator: Allocator,
    files: &var std::array::Array<source::SourceFile>,
    io: Io,
    root: []u8,
    manifest_text: []u8,
    paths_start: i64,
    module_root: []u8,
    next_id: i64,
    package_name: []u8
) -> !i64 {
    var id = next_id;
    var found = false;
    var index = paths_start;
    while index < std::mem::len(manifest_text) {
        if manifest_text[index] == cast<u8>(93) {
            if found {
                return id;
            }
            return try append_package_source_dir(
                allocator,
                files,
                io,
                root,
                "src",
                module_root,
                id,
                package_name
            );
        }
        if manifest_text[index] == cast<u8>(34) {
            let path_start = index + 1;
            var path_end = path_start;
            while path_end < std::mem::len(manifest_text) {
                if manifest_text[path_end] == cast<u8>(34) {
                    let path = manifest_text[path_start..path_end];
                    id = try append_package_source_dir(
                        allocator,
                        files,
                        io,
                        root,
                        path,
                        module_root,
                        id,
                        package_name
                    );
                    found = true;
                    index = path_end + 1;
                    break;
                }
                path_end = path_end + 1;
            }
            if path_end >= std::mem::len(manifest_text) {
                return error("invalid manifest");
            }
        } else {
            if !manifest::path_array_separator_byte(manifest_text[index]) {
                return error("invalid manifest");
            }
            index = index + 1;
        }
    }
    return error("invalid manifest");
}

fn append_package_source_dir(
    allocator: Allocator,
    files: &var std::array::Array<source::SourceFile>,
    io: Io,
    root: []u8,
    source_path: []u8,
    module_root: []u8,
    next_id: i64,
    package_name: []u8
) -> !i64 {
    if std::mem::len(source_path) < 1 {
        return error("invalid manifest");
    }
    var source_dir = try std::path::join(allocator, root, source_path);
    let source_dir_len = source_dir.len();
    let source_dir_path = source_dir.as_bytes();
    let id = try append_selfhost_source_dir(
        files,
        io,
        source_dir_path,
        source_dir_len,
        module_root,
        next_id,
        package_name
    );
    source_dir.deinit();
    return id;
}

fn append_frontend_std_sources(
    files: &var std::array::Array<source::SourceFile>,
    io: Io,
    next_id: i64
) -> !i64 {
    var id = next_id;
    id = try append_std_source(files, io, id, "std/src/mem.kizu");
    id = try append_std_source(files, io, id, "std/src/array.kizu");
    id = try append_std_source(files, io, id, "std/src/string.kizu");
    id = try append_std_source(files, io, id, "std/src/map.kizu");
    id = try append_std_source(files, io, id, "std/src/fmt.kizu");
    id = try append_std_source(files, io, id, "std/src/testing.kizu");
    id = try append_std_source(files, io, id, "std/src/fs.kizu");
    id = try append_std_source(files, io, id, "std/src/path.kizu");
    id = try append_std_source(files, io, id, "std/src/path_bits.kizu");
    id = try append_std_source(files, io, id, "std/src/io.kizu");
    id = try append_std_source(files, io, id, "std/src/process.kizu");
    id = try append_std_source(files, io, id, "std/src/kizu/ast.kizu");
    id = try append_std_source(files, io, id, "std/src/kizu/lexer.kizu");
    id = try append_std_source(files, io, id, "std/src/kizu/parser.kizu");
    id = try append_std_source(files, io, id, "std/src/kizu/diagnostic.kizu");
    return id;
}

fn append_referenced_frontend_std_sources(
    allocator: Allocator,
    files: &var std::array::Array<source::SourceFile>,
    io: Io,
    next_id: i64,
    text: []u8
) -> !i64 {
    var pending = std::array::Array<[]u8>(allocator);
    defer pending.deinit();
    var seen = std::map::Map<[]u8, bool>(allocator);
    defer seen.deinit();

    try std_index::queue_references(allocator, text, pending, seen);

    var id = next_id;
    var index = 0;
    while index < pending.len() {
        let path = try pending.get(index);
        let std_text = try std::fs::read_file(io, path);
        try append_std_source_text(files, id, path, std_text);
        id = id + 1;
        try std_index::queue_references(allocator, std_text, pending, seen);
        index = index + 1;
    }
    return id;
}

fn append_package_referenced_frontend_std_sources(
    allocator: Allocator,
    files: &var std::array::Array<source::SourceFile>,
    io: Io,
    next_id: i64,
    package_source_start: i64
) -> !i64 {
    var pending = std::array::Array<[]u8>(allocator);
    defer pending.deinit();
    var seen = std::map::Map<[]u8, bool>(allocator);
    defer seen.deinit();

    var source_index = package_source_start;
    while source_index < next_id {
        let file = try files.at(source_index);
        try std_index::queue_references(allocator, file.text, pending, seen);
        source_index = source_index + 1;
    }

    var id = next_id;
    var pending_index = 0;
    while pending_index < pending.len() {
        let path = try pending.get(pending_index);
        let std_text = try std::fs::read_file(io, path);
        try append_std_source_text(files, id, path, std_text);
        id = id + 1;
        try std_index::queue_references(allocator, std_text, pending, seen);
        pending_index = pending_index + 1;
    }
    return id;
}

fn source_file(
    id: i64,
    kind: source::SourceKind,
    package_name: []u8,
    module_start: i64,
    module_end: i64,
    path: []u8,
    text: []u8
) -> source::SourceFile {
    return source::SourceFile {
        id: id,
        kind: kind,
        package_name: package_name,
        module_start: module_start,
        module_end: module_end,
        path: path,
        text: text
    };
}

fn module_start_for(kind: source::SourceKind, path: []u8) -> i64 {
    if kind == source::SourceKind::Std {
        return path_after_prefix_start(path, "std/src");
    }
    return basename_module_start(path);
}

fn module_end_for(path: []u8) -> i64 {
    let length = std::mem::len(path);
    if length > 5 and std::mem::equal_bytes(path[length - 5..length], ".kizu") {
        return length - 5;
    }
    return length;
}

fn basename_module_start(path: []u8) -> i64 {
    var start = 0;
    var index = 0;
    while index < std::mem::len(path) {
        if path[index] == cast<u8>(47) {
            start = index + 1;
        }
        index = index + 1;
    }
    return start;
}

fn path_after_prefix_start(path: []u8, prefix: []u8) -> i64 {
    var start = std::mem::len(prefix);
    if start < std::mem::len(path) and path[start] == cast<u8>(47) {
        start = start + 1;
    }
    return start;
}

fn is_manifest_root_source(module_root: []u8, path: []u8) -> bool {
    let module_root_len = std::mem::len(module_root);
    let path_len = std::mem::len(path);
    if path_len < module_root_len {
        return false;
    }
    let start = path_len - module_root_len;
    if start > 0 and path[start - 1] != cast<u8>(47) {
        return false;
    }
    return std::mem::equal_bytes(path[start..path_len], module_root);
}

fn package_module_start(source_root_len: i64, path: []u8) -> i64 {
    if source_root_len < 0 {
        return -1;
    }
    if std::mem::len(path) <= source_root_len {
        return -1;
    }
    if path[source_root_len] != cast<u8>(47) {
        return -1;
    }
    return source_root_len + 1;
}

fn package_module_end(path: []u8, start: i64) -> i64 {
    if start < 0 {
        return -1;
    }
    let end = module_end_for(path);
    if end > start + 4 and std::mem::equal_bytes(path[end - 4..end], "/mod") {
        return end - 4;
    }
    if end > start + 5 and std::mem::equal_bytes(path[end - 5..end], "/main") {
        return end - 5;
    }
    return end;
}
