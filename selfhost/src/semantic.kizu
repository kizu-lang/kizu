import selfhost::ownership;
import selfhost::ownership::data;
import selfhost::parser;
import selfhost::resolver;
import selfhost::source;
import selfhost::types;

pub struct CheckedSources {
    // Diagnostic renderers must inspect this owned parse result. They must not
    // parse files again after semantic checking.
    pub parsed: parser::ParsedSourceFiles,
    pub package: data::CheckedPackage,
}

impl CheckedSources {
    fn deinit(self: CheckedSources) -> void {
        self.parsed.deinit();
        return;
    }
}

pub fn check_loaded_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>
) -> !CheckedSources {
    var parsed = try parser::parse_source_files(allocator, files);
    errdefer parsed.deinit();
    let resolved = try resolver::resolve_parsed_sources(
        allocator,
        files,
        &parsed.parsed,
        &parsed.source_indexes
    );
    let typed = try types::check_parsed_sources(
        allocator,
        files,
        &parsed.parsed,
        &parsed.source_indexes,
        resolved
    );
    let checked = try ownership::check_parsed_package(
        allocator,
        files,
        &parsed.parsed,
        &parsed.source_indexes,
        typed
    );
    return CheckedSources {
        parsed: parsed,
        package: checked
    };
}

pub fn ready(checked: &CheckedSources) -> bool {
    return checked.package.diagnostics == 0;
}

pub fn deinit_checked_sources(checked: CheckedSources) -> !void {
    checked.deinit();
    return;
}
