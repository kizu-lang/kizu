// Module: parser boundary for the future self-host compiler frontend.

import selfhost::ast;
import selfhost::token;

// token_span converts a lexer token position into an AST span.
fn token_span(current: &token::Token) -> ast::Span {
    return ast::Span {
        start: current.start,
        end: current.end,
        line: current.line,
        column: current.column,
    };
}

// decl_kind returns the AST node kind for a top-level declaration token.
fn decl_kind(kind: token::TokenKind) -> ast::NodeKind {
    if kind == token::TokenKind::Import {
        return ast::NodeKind::Import;
    }
    if kind == token::TokenKind::Fn {
        return ast::NodeKind::Function;
    }
    if kind == token::TokenKind::Unsafe {
        return ast::NodeKind::Function;
    }
    if kind == token::TokenKind::Extern {
        return ast::NodeKind::Function;
    }
    if kind == token::TokenKind::Struct {
        return ast::NodeKind::Struct;
    }
    if kind == token::TokenKind::Enum {
        return ast::NodeKind::Enum;
    }
    if kind == token::TokenKind::Union {
        return ast::NodeKind::Union;
    }
    if kind == token::TokenKind::Contract {
        return ast::NodeKind::Contract;
    }
    if kind == token::TokenKind::Impl {
        return ast::NodeKind::Impl;
    }
    if kind == token::TokenKind::Satisfy {
        return ast::NodeKind::Satisfy;
    }
    return ast::NodeKind::Empty;
}

// is_decl_token reports whether a token begins one top-level declaration.
fn is_decl_token(kind: token::TokenKind) -> bool {
    return decl_kind(kind) != ast::NodeKind::Empty;
}

// decl_name returns the first identifier associated with a declaration token.
fn decl_name(index: i64, tokens: &std::array::Array<token::Token>) -> ![]const u8 {
    let current = try tokens.at(index);
    let kind = current.kind;
    var cursor = index + 1;
    if kind == token::TokenKind::Unsafe {
        cursor = cursor + 1;
    }
    if kind == token::TokenKind::Extern {
        cursor = cursor + 2;
    }
    let next = try tokens.at(cursor);
    if next.kind == token::TokenKind::Ident {
        return next.literal;
    }
    return "";
}

// declaration_count returns the number of top-level declaration starts.
pub fn declaration_count(tokens: &std::array::Array<token::Token>) -> !i64 {
    var count = 0;
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if is_decl_token(current.kind) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// parse_declarations returns a declaration-order snapshot for a token stream.
pub fn parse_declarations(
    tokens: &std::array::Array<token::Token>
) -> !std::array::Array<ast::DeclSnapshot> {
    let allocator = std::mem::page_allocator();
    var decls = std::array::Array<ast::DeclSnapshot>(allocator);
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if is_decl_token(current.kind) {
            try decls.append(ast::DeclSnapshot {
                kind: decl_kind(current.kind),
                name: try decl_name(index, tokens),
                span: token_span(current),
            });
        }
        index = index + 1;
    }
    return decls;
}

// first_declaration_start returns the start offset of the first declaration.
pub fn first_declaration_start(tokens: &std::array::Array<token::Token>) -> !i64 {
    var index = 0;
    while index < tokens.len() {
        let current = try tokens.at(index);
        if is_decl_token(current.kind) {
            return current.start;
        }
        index = index + 1;
    }
    return -1;
}

// is_control_token reports whether a token starts a control statement.
fn is_control_token(kind: token::TokenKind) -> bool {
    if kind == token::TokenKind::If {
        return true;
    }
    if kind == token::TokenKind::While {
        return true;
    }
    if kind == token::TokenKind::For {
        return true;
    }
    if kind == token::TokenKind::Match {
        return true;
    }
    if kind == token::TokenKind::Break {
        return true;
    }
    return kind == token::TokenKind::Continue;
}

// is_binary_token reports whether a token is a binary operator candidate.
fn is_binary_token(kind: token::TokenKind) -> bool {
    if kind == token::TokenKind::Plus {
        return true;
    }
    if kind == token::TokenKind::Minus {
        return true;
    }
    if kind == token::TokenKind::Asterisk {
        return true;
    }
    if kind == token::TokenKind::Slash {
        return true;
    }
    if kind == token::TokenKind::Eq {
        return true;
    }
    return kind == token::TokenKind::NotEq;
}

// parse_detail_summary returns token-level parser detail counts.
pub fn parse_detail_summary(
    tokens: &std::array::Array<token::Token>
) -> !ast::ParserDetailSummary {
    var controls = 0;
    var expressions = 0;
    var calls = 0;
    var fields = 0;
    var literals = 0;
    var binaries = 0;
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if is_control_token(current.kind) {
            controls = controls + 1;
        }
        if current.kind == token::TokenKind::Ident {
            expressions = expressions + 1;
        }
        if current.kind == token::TokenKind::LParen {
            calls = calls + 1;
        }
        if current.kind == token::TokenKind::Dot {
            fields = fields + 1;
        }
        if current.kind == token::TokenKind::LBrace {
            literals = literals + 1;
        }
        if is_binary_token(current.kind) {
            binaries = binaries + 1;
        }
        index = index + 1;
    }

    return ast::ParserDetailSummary {
        control_count: controls,
        expression_count: expressions,
        call_count: calls,
        field_access_count: fields,
        struct_literal_count: literals,
        binary_expression_count: binaries,
    };
}

// parse_tokens returns the current AST summary used by the parser oracle.
pub fn parse_tokens(tokens: &std::array::Array<token::Token>) -> !ast::ParseSummary {
    var functions = 0;
    var imports = 0;
    var structs = 0;
    var enums = 0;
    var unions = 0;
    var returns = 0;
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            functions = functions + 1;
        }
        if current.kind == token::TokenKind::Import {
            imports = imports + 1;
        }
        if current.kind == token::TokenKind::Struct {
            structs = structs + 1;
        }
        if current.kind == token::TokenKind::Enum {
            enums = enums + 1;
        }
        if current.kind == token::TokenKind::Union {
            unions = unions + 1;
        }
        if current.kind == token::TokenKind::Return {
            returns = returns + 1;
        }
        index = index + 1;
    }

    return ast::ParseSummary {
        function_count: functions,
        import_count: imports,
        struct_count: structs,
        enum_count: enums,
        union_count: unions,
        return_count: returns,
    };
}

// ready exposes the parser module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
