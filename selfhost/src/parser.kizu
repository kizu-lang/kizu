import selfhost::ast;
import selfhost::diagnostic;
import selfhost::lexer;

pub union ParseError {
    Diagnostic(diagnostic::Diagnostic)
    Message([]const u8)
}

pub fn parse_source(source: []const u8) -> ParseError!ast::AstSummary {
    let lexed = lexer::summarize(source);
    if lexed.tokens < 1 {
        return ParseError::Message("lexer produced no tokens");
    }
    return ast::empty(lexed.tokens);
}

pub fn parse_error(path: []const u8) -> ParseError {
    let primary = diagnostic::file_span(path, 0, 1);
    let report = diagnostic::Diagnostic(primary, "parse failed");
    return ParseError::Diagnostic(report);
}
