// Module: parser boundary for the future self-host compiler frontend.

import selfhost::ast;
import selfhost::token;

// token_span converts a lexer token position into an AST span.
fn token_span(current: &token::Token) -> ast::Span {
    return ast::Span {
        start: current.start,
        end: current.end,
        line: current.line,
        column: current.column,
    };
}

// decl_kind returns the AST node kind for a top-level declaration token.
fn decl_kind(kind: token::TokenKind) -> ast::NodeKind {
    if kind == token::TokenKind::Import {
        return ast::NodeKind::Import;
    }
    if kind == token::TokenKind::Fn {
        return ast::NodeKind::Function;
    }
    if kind == token::TokenKind::Unsafe {
        return ast::NodeKind::Function;
    }
    if kind == token::TokenKind::Extern {
        return ast::NodeKind::Function;
    }
    if kind == token::TokenKind::Struct {
        return ast::NodeKind::Struct;
    }
    if kind == token::TokenKind::Enum {
        return ast::NodeKind::Enum;
    }
    if kind == token::TokenKind::Union {
        return ast::NodeKind::Union;
    }
    if kind == token::TokenKind::Contract {
        return ast::NodeKind::Contract;
    }
    if kind == token::TokenKind::Impl {
        return ast::NodeKind::Impl;
    }
    if kind == token::TokenKind::Satisfy {
        return ast::NodeKind::Satisfy;
    }
    return ast::NodeKind::Empty;
}

// is_decl_token reports whether a token begins one top-level declaration.
fn is_decl_token(kind: token::TokenKind) -> bool {
    return decl_kind(kind) != ast::NodeKind::Empty;
}

// decl_name returns the first identifier associated with a declaration token.
fn decl_name(index: i64, tokens: &std::array::Array<token::Token>) -> ![]const u8 {
    let current = try tokens.at(index);
    let kind = current.kind;
    var cursor = index + 1;
    if kind == token::TokenKind::Unsafe {
        cursor = cursor + 1;
    }
    if kind == token::TokenKind::Extern {
        cursor = cursor + 2;
    }
    let next = try tokens.at(cursor);
    if next.kind == token::TokenKind::Ident {
        return next.literal;
    }
    return "";
}

// decl_name_end returns the end offset of a declaration's first identifier.
fn decl_name_end(index: i64, tokens: &std::array::Array<token::Token>) -> !i64 {
    let current = try tokens.at(index);
    let kind = current.kind;
    var cursor = index + 1;
    if kind == token::TokenKind::Unsafe {
        cursor = cursor + 1;
    }
    if kind == token::TokenKind::Extern {
        cursor = cursor + 2;
    }
    let next = try tokens.at(cursor);
    if next.kind == token::TokenKind::Ident {
        return next.end;
    }
    return current.end;
}

// decl_span returns the declaration keyword span extended through its name.
fn decl_span(index: i64, tokens: &std::array::Array<token::Token>) -> !ast::Span {
    let current = try tokens.at(index);
    return ast::Span {
        start: current.start,
        end: try decl_name_end(index, tokens),
        line: current.line,
        column: current.column,
    };
}

// declaration_count returns the number of top-level declaration starts.
pub fn declaration_count(tokens: &std::array::Array<token::Token>) -> !i64 {
    var count = 0;
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if is_decl_token(current.kind) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// parse_declarations returns a declaration-order snapshot for a token stream.
pub fn parse_declarations(
    tokens: &std::array::Array<token::Token>
) -> !std::array::Array<ast::DeclSnapshot> {
    let allocator = std::mem::page_allocator();
    var decls = std::array::Array<ast::DeclSnapshot>(allocator);
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if is_decl_token(current.kind) {
            try decls.append(ast::DeclSnapshot {
                kind: decl_kind(current.kind),
                name: try decl_name(index, tokens),
                span: try decl_span(index, tokens),
            });
        }
        index = index + 1;
    }
    return decls;
}

// first_declaration_start returns the start offset of the first declaration.
pub fn first_declaration_start(tokens: &std::array::Array<token::Token>) -> !i64 {
    var index = 0;
    while index < tokens.len() {
        let current = try tokens.at(index);
        if is_decl_token(current.kind) {
            return current.start;
        }
        index = index + 1;
    }
    return -1;
}

// is_control_token reports whether a token starts a control statement.
fn is_control_token(kind: token::TokenKind) -> bool {
    if kind == token::TokenKind::If {
        return true;
    }
    if kind == token::TokenKind::While {
        return true;
    }
    if kind == token::TokenKind::For {
        return true;
    }
    if kind == token::TokenKind::Match {
        return true;
    }
    if kind == token::TokenKind::Break {
        return true;
    }
    return kind == token::TokenKind::Continue;
}

// is_binary_token reports whether a token is a binary operator candidate.
fn is_binary_token(kind: token::TokenKind) -> bool {
    if kind == token::TokenKind::Plus {
        return true;
    }
    if kind == token::TokenKind::Minus {
        return true;
    }
    if kind == token::TokenKind::Asterisk {
        return true;
    }
    if kind == token::TokenKind::Slash {
        return true;
    }
    if kind == token::TokenKind::Eq {
        return true;
    }
    return kind == token::TokenKind::NotEq;
}

// parse_detail_summary returns token-level parser detail counts.
pub fn parse_detail_summary(
    tokens: &std::array::Array<token::Token>
) -> !ast::ParserDetailSummary {
    var controls = 0;
    var expressions = 0;
    var calls = 0;
    var fields = 0;
    var literals = 0;
    var binaries = 0;
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if is_control_token(current.kind) {
            controls = controls + 1;
        }
        if current.kind == token::TokenKind::Ident {
            expressions = expressions + 1;
        }
        if current.kind == token::TokenKind::LParen {
            calls = calls + 1;
        }
        if current.kind == token::TokenKind::Dot {
            fields = fields + 1;
        }
        if current.kind == token::TokenKind::LBrace {
            literals = literals + 1;
        }
        if is_binary_token(current.kind) {
            binaries = binaries + 1;
        }
        index = index + 1;
    }

    return ast::ParserDetailSummary {
        control_count: controls,
        expression_count: expressions,
        call_count: calls,
        field_access_count: fields,
        struct_literal_count: literals,
        binary_expression_count: binaries,
    };
}

// print_detail_snapshot writes selected production AST facts for parser switching.
pub fn print_detail_snapshot(tokens: &std::array::Array<token::Token>) -> !void {
    print("selfhost parser detail snapshot");
    if try has_missing_semicolon(tokens) {
        print("status");
        print("fail");
        print("message");
        print("parser error: missing semicolon");
    } else {
        if try has_selected_parser_error(tokens) {
            print("status");
            print("fail");
            print("message");
            print("parser error");
        } else {
            print("status");
            print("pass");
            try print_top_level_details(tokens);
        }
    }
    print("selfhost parser detail snapshot end");
    return void;
}

// print_top_level_details writes source-order declaration rows.
fn print_top_level_details(tokens: &std::array::Array<token::Token>) -> !void {
    var index = 0;
    var depth = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if depth == 0 {
            if current.kind == token::TokenKind::Struct {
                try print_struct_detail(tokens, index);
            }
            if current.kind == token::TokenKind::Enum {
                try print_enum_detail(tokens, index);
            }
            if current.kind == token::TokenKind::Union {
                try print_union_detail(tokens, index);
            }
            if current.kind == token::TokenKind::Fn {
                try print_function_detail(tokens, index);
            }
        }
        if current.kind == token::TokenKind::LBrace {
            depth = depth + 1;
        }
        if current.kind == token::TokenKind::RBrace {
            depth = depth - 1;
        }
        index = index + 1;
    }
    return void;
}

// has_missing_semicolon detects the selected negative parser fixture.
fn has_missing_semicolon(tokens: &std::array::Array<token::Token>) -> !bool {
    var index = 1;

    while index < tokens.len() {
        let current = try tokens.at(index);
        let previous = try tokens.at(index - 1);
        if current.kind == token::TokenKind::RBrace {
            if previous.kind == token::TokenKind::RParen {
                if try brace_needs_semicolon_after_call(tokens, index) {
                    return true;
                }
            }
            if try return_before_brace_needs_semicolon(tokens, index) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// brace_needs_semicolon_after_call reports whether a block closes after a bare call.
fn brace_needs_semicolon_after_call(
    tokens: &std::array::Array<token::Token>,
    brace: i64
) -> !bool {
    if brace + 1 < tokens.len() {
        let next = try tokens.at(brace + 1);
        if next.kind == token::TokenKind::Semicolon {
            return false;
        }
        if next.kind == token::TokenKind::Comma {
            return false;
        }
        if next.kind == token::TokenKind::RParen {
            return false;
        }
    }
    return true;
}

// has_selected_parser_error detects selected parser errors used by parity tests.
fn has_selected_parser_error(tokens: &std::array::Array<token::Token>) -> !bool {
    if try has_if_expression_missing_else(tokens) {
        return true;
    }
    return try has_label_on_non_loop(tokens);
}

// has_if_expression_missing_else detects `let x = if ... { ... };`.
fn has_if_expression_missing_else(tokens: &std::array::Array<token::Token>) -> !bool {
    var index = 2;

    while index < tokens.len() {
        let current = try tokens.at(index);
        let previous = try tokens.at(index - 1);
        if current.kind == token::TokenKind::If {
            if previous.kind == token::TokenKind::Assign {
                return !try if_expression_has_else(tokens, index);
            }
        }
        index = index + 1;
    }
    return false;
}

// if_expression_has_else reports whether the selected if expression has an else branch.
fn if_expression_has_else(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Else {
            return true;
        }
        if current.kind == token::TokenKind::Semicolon {
            return false;
        }
        index = index + 1;
    }
    return false;
}

// has_label_on_non_loop detects labels that are not attached to while or for.
fn has_label_on_non_loop(tokens: &std::array::Array<token::Token>) -> !bool {
    var index = 0;

    while index + 2 < tokens.len() {
        let current = try tokens.at(index);
        let separator = try tokens.at(index + 1);
        let next = try tokens.at(index + 2);
        if current.kind == token::TokenKind::Ident {
            if try token_can_start_label(tokens, index) {
                if separator.kind == token::TokenKind::Colon {
                    if next.kind != token::TokenKind::While {
                        if next.kind != token::TokenKind::For {
                            if try token_starts_label_statement(tokens, index + 2) {
                                return true;
                            }
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// token_starts_label_statement identifies selected statements after a label.
fn token_starts_label_statement(
    tokens: &std::array::Array<token::Token>,
    index: i64
) -> !bool {
    let current = try tokens.at(index);
    if current.kind == token::TokenKind::Return {
        return true;
    }
    if current.kind == token::TokenKind::Ident {
        if index + 1 < tokens.len() {
            let next = try tokens.at(index + 1);
            if next.kind == token::TokenKind::LParen {
                return true;
            }
        }
    }
    return false;
}

// token_can_start_label reports whether an identifier is at statement start.
fn token_can_start_label(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    if index == 0 {
        return true;
    }

    let previous = try tokens.at(index - 1);
    if previous.kind == token::TokenKind::LBrace {
        if index > 1 {
            let before_brace = try tokens.at(index - 2);
            if before_brace.kind == token::TokenKind::Ident {
                if index > 2 {
                    let before_type = try tokens.at(index - 3);
                    if before_type.kind != token::TokenKind::Arrow {
                        return false;
                    }
                }
            }
        }
        return true;
    }
    if previous.kind == token::TokenKind::Semicolon {
        return true;
    }
    if previous.kind == token::TokenKind::RBrace {
        return true;
    }
    return false;
}

// return_before_brace_needs_semicolon finds a return statement closed by a brace.
fn return_before_brace_needs_semicolon(
    tokens: &std::array::Array<token::Token>,
    brace: i64
) -> !bool {
    var index = brace;

    while index > 0 {
        index = index - 1;
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Semicolon {
            return false;
        }
        if current.kind == token::TokenKind::Return {
            return true;
        }
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
    }
    return false;
}

// print_struct_details writes selected struct declaration AST rows.
fn print_struct_details(tokens: &std::array::Array<token::Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Struct {
            try print_struct_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_struct_detail writes one struct declaration AST shape.
fn print_struct_detail(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("struct");
    print(name.literal);
    print("fields");
    print(try struct_field_count(tokens, start));
    try print_struct_fields(tokens, start);
    return void;
}

// struct_field_count counts direct fields in one struct body.
fn struct_field_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if index > start {
            if current.kind == token::TokenKind::RBrace {
                return count;
            }
        }
        if current.kind == token::TokenKind::Colon {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_struct_fields writes field names and normalized field types.
fn print_struct_fields(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if index > start {
            if current.kind == token::TokenKind::RBrace {
                return void;
            }
        }
        if current.kind == token::TokenKind::Colon {
            let name = try tokens.at(index - 1);
            print("field");
            print(name.literal);
            print(try normalized_type_name(tokens, index + 1));
        }
        index = index + 1;
    }
    return void;
}

// print_enum_details writes selected enum declaration AST rows.
fn print_enum_details(tokens: &std::array::Array<token::Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Enum {
            try print_enum_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_enum_detail writes one enum declaration AST shape.
fn print_enum_detail(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("enum");
    print(name.literal);
    print("tags");
    print(try tag_like_count(tokens, start));
    try print_enum_tags(tokens, start);
    return void;
}

// print_union_details writes selected union declaration AST rows.
fn print_union_details(tokens: &std::array::Array<token::Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Union {
            try print_union_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_union_detail writes one union declaration AST shape.
fn print_union_detail(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("union");
    print(name.literal);
    print("variants");
    print(try tag_like_count(tokens, start));
    try print_union_variants(tokens, start);
    return void;
}

// tag_like_count counts enum tags or union variants in a declaration body.
fn tag_like_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if index > start {
            if current.kind == token::TokenKind::RBrace {
                return count;
            }
        }
        if current.kind == token::TokenKind::Ident {
            if index > start + 1 {
                count = count + 1;
            }
        }
        index = try skip_payload_type(tokens, index);
    }
    return count;
}

// print_enum_tags writes enum tag names in source order.
fn print_enum_tags(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if index > start {
            if current.kind == token::TokenKind::RBrace {
                return void;
            }
        }
        if current.kind == token::TokenKind::Ident {
            if index > start + 1 {
                print("tag");
                print(current.literal);
            }
        }
        index = index + 1;
    }
    return void;
}

// print_union_variants writes union variant names and normalized payload types.
fn print_union_variants(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if index > start {
            if current.kind == token::TokenKind::RBrace {
                return void;
            }
        }
        if current.kind == token::TokenKind::Ident {
            if index > start + 1 {
                print("variant");
                print(current.literal);
                print(try union_variant_payload(tokens, index));
            }
        }
        index = try skip_payload_type(tokens, index);
    }
    return void;
}

// union_variant_payload returns a normalized variant payload type or marker.
fn union_variant_payload(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let next = try tokens.at(start + 1);

    if next.kind == token::TokenKind::LParen {
        return try normalized_type_name(tokens, start + 2);
    }
    return "<none>";
}

// skip_payload_type advances over one parenthesized union payload if present.
fn skip_payload_type(tokens: &std::array::Array<token::Token>, index: i64) -> !i64 {
    let next = try tokens.at(index + 1);

    if next.kind == token::TokenKind::LParen {
        var cursor = index + 2;
        while cursor < tokens.len() {
            let current = try tokens.at(cursor);
            if current.kind == token::TokenKind::RParen {
                return cursor + 1;
            }
            cursor = cursor + 1;
        }
    }
    return index + 1;
}

// print_function_details writes selected function declaration AST rows.
fn print_function_details(tokens: &std::array::Array<token::Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            try print_function_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_function_detail writes one function signature and body AST summary.
fn print_function_detail(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("fn");
    print(name.literal);
    print("params");
    print(try function_param_count(tokens, start + 3));
    try print_function_param_types(tokens, start + 3);
    print("return");
    print(try function_return_type(tokens, start + 2));
    print("returns");
    print(try function_direct_return_count(tokens, start));
    try print_function_control_details(tokens, start);
    try print_function_expression_details(tokens, start);
    return void;
}

// print_function_param_types writes parameter type rows in signature order.
fn print_function_param_types(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::RParen {
            return void;
        }
        if current.kind == token::TokenKind::Colon {
            print("param");
            print(try normalized_type_name(tokens, index + 1));
        }
        index = index + 1;
    }
    return void;
}

// function_param_count returns the number of function parameters.
fn function_param_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::RParen {
            return count;
        }
        if current.kind == token::TokenKind::Colon {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// function_return_type returns the explicit return type or default void.
fn function_return_type(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            return "void";
        }
        if current.kind == token::TokenKind::Arrow {
            return try normalized_return_type(tokens, index + 1);
        }
        index = index + 1;
    }
    return "void";
}

// normalized_return_type returns selected multi-token return type spellings.
fn normalized_return_type(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let current = try tokens.at(start);

    if current.kind == token::TokenKind::Bang {
        let next = try tokens.at(start + 1);
        if next.kind == token::TokenKind::LBracket {
            return "![]const u8";
        }
        if std::mem::equal_bytes(next.literal, "void") {
            return "!void";
        }
        if std::mem::equal_bytes(next.literal, "i64") {
            return "!i64";
        }
    }
    return try normalized_type_name(tokens, start);
}

// normalized_type_name returns selected type spellings used by parser fixtures.
fn normalized_type_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let current = try tokens.at(start);

    if current.kind == token::TokenKind::Amp {
        return try normalized_type_name(tokens, start + 1);
    }
    if current.kind == token::TokenKind::Mut {
        return try normalized_type_name(tokens, start + 1);
    }
    if current.kind == token::TokenKind::LBracket {
        return "[]const u8";
    }
    if current.kind == token::TokenKind::Question {
        return try normalized_optional_type_name(tokens, start + 1);
    }
    if std::mem::equal_bytes(current.literal, "ptr") {
        return try normalized_ptr_type_name(tokens, start);
    }
    if std::mem::equal_bytes(current.literal, "Dyn") {
        return try normalized_dyn_type_name(tokens, start);
    }
    if std::mem::equal_bytes(current.literal, "handle") {
        return try normalized_handle_type_name(tokens, start);
    }
    if std::mem::equal_bytes(current.literal, "arena") {
        return try normalized_arena_type_name(tokens, start);
    }
    if std::mem::equal_bytes(current.literal, "Channel") {
        return try normalized_channel_type_name(tokens, start);
    }
    if std::mem::equal_bytes(current.literal, "Mutex") {
        return try normalized_mutex_type_name(tokens, start);
    }
    if try is_typed_error_union(tokens, start) {
        return try normalized_typed_error_union(tokens, start);
    }
    return try namespaced_type_name(tokens, start);
}

// normalized_arena_type_name returns selected arena<T> spellings.
fn normalized_arena_type_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    if start + 2 >= tokens.len() {
        return "arena";
    }
    let inner = try tokens.at(start + 2);
    if std::mem::equal_bytes(inner.literal, "User") {
        return "arena<User>";
    }
    return "arena";
}

// normalized_channel_type_name returns selected Channel<T> spellings.
fn normalized_channel_type_name(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    if start + 2 >= tokens.len() {
        return "Channel";
    }
    let inner = try tokens.at(start + 2);
    if std::mem::equal_bytes(inner.literal, "i64") {
        return "Channel<i64>";
    }
    if inner.kind == token::TokenKind::LBracket {
        return "Channel<[]const u8>";
    }
    return "Channel";
}

// normalized_mutex_type_name returns selected Mutex<T> spellings.
fn normalized_mutex_type_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    if start + 2 >= tokens.len() {
        return "Mutex";
    }
    let inner = try tokens.at(start + 2);
    if std::mem::equal_bytes(inner.literal, "i64") {
        return "Mutex<i64>";
    }
    return "Mutex";
}

// normalized_handle_type_name returns selected handle<T> spellings.
fn normalized_handle_type_name(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    if start + 2 >= tokens.len() {
        return "handle";
    }
    let inner = try tokens.at(start + 2);
    if std::mem::equal_bytes(inner.literal, "User") {
        return "handle<User>";
    }
    return "handle";
}

// normalized_dyn_type_name returns selected Dyn<T> spellings.
fn normalized_dyn_type_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    if start + 2 >= tokens.len() {
        return "Dyn";
    }
    let inner = try tokens.at(start + 2);
    if std::mem::equal_bytes(inner.literal, "Writer") {
        return "Dyn<Writer>";
    }
    return "Dyn";
}

// normalized_optional_type_name returns selected optional type spellings.
fn normalized_optional_type_name(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let current = try tokens.at(start);

    if std::mem::equal_bytes(current.literal, "ptr") {
        return try normalized_optional_ptr_type_name(tokens, start);
    }
    if std::mem::equal_bytes(current.literal, "i64") {
        return "?i64";
    }
    if std::mem::equal_bytes(current.literal, "u8") {
        return "?u8";
    }
    return "?";
}

// normalized_ptr_type_name returns selected ptr<T> spellings.
fn normalized_ptr_type_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let inner = try tokens.at(start + 2);

    if std::mem::equal_bytes(inner.literal, "const") {
        let value = try tokens.at(start + 3);
        if std::mem::equal_bytes(value.literal, "u8") {
            return "ptr<const u8>";
        }
        if std::mem::equal_bytes(value.literal, "i8") {
            return "ptr<const i8>";
        }
        if std::mem::equal_bytes(value.literal, "i64") {
            return "ptr<const i64>";
        }
    }
    if std::mem::equal_bytes(inner.literal, "u8") {
        return "ptr<u8>";
    }
    if std::mem::equal_bytes(inner.literal, "i64") {
        return "ptr<i64>";
    }
    return "ptr";
}

// normalized_optional_ptr_type_name returns selected ?ptr<T> spellings.
fn normalized_optional_ptr_type_name(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let inner = try tokens.at(start + 2);

    if std::mem::equal_bytes(inner.literal, "const") {
        let value = try tokens.at(start + 3);
        if std::mem::equal_bytes(value.literal, "u8") {
            return "?ptr<const u8>";
        }
        if std::mem::equal_bytes(value.literal, "i64") {
            return "?ptr<const i64>";
        }
    }
    if std::mem::equal_bytes(inner.literal, "u8") {
        return "?ptr<u8>";
    }
    if std::mem::equal_bytes(inner.literal, "i64") {
        return "?ptr<i64>";
    }
    return "?ptr";
}

// is_typed_error_union reports whether a type starts with Error!Success.
fn is_typed_error_union(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    if start + 1 >= tokens.len() {
        return false;
    }
    let separator = try tokens.at(start + 1);
    return separator.kind == token::TokenKind::Bang;
}

// normalized_typed_error_union returns selected Error!Success spellings.
fn normalized_typed_error_union(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let error_type = try tokens.at(start);
    let success_type = try tokens.at(start + 2);

    if std::mem::equal_bytes(error_type.literal, "ConfigError") {
        if std::mem::equal_bytes(success_type.literal, "i64") {
            return "ConfigError!i64";
        }
        if std::mem::equal_bytes(success_type.literal, "void") {
            return "ConfigError!void";
        }
        if success_type.kind == token::TokenKind::LBracket {
            return "ConfigError![]const u8";
        }
    }
    if std::mem::equal_bytes(success_type.literal, "void") {
        return try normalized_error_void_type_name(tokens, start);
    }
    return error_type.literal;
}

// normalized_error_void_type_name returns selected Error!void spellings.
fn normalized_error_void_type_name(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> ![]const u8 {
    let error_type = try tokens.at(start);
    if std::mem::equal_bytes(error_type.literal, "NetworkError") {
        return "NetworkError!void";
    }
    return error_type.literal;
}

// namespaced_type_name returns selected namespace-qualified type spellings.
fn namespaced_type_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let first = try tokens.at(start);
    if start + 1 >= tokens.len() {
        return first.literal;
    }
    let separator = try tokens.at(start + 1);
    if separator.kind != token::TokenKind::DoubleColon {
        return first.literal;
    }
    if start + 2 >= tokens.len() {
        return first.literal;
    }
    let second = try tokens.at(start + 2);
    if std::mem::equal_bytes(first.literal, "token") {
        if std::mem::equal_bytes(second.literal, "TokenKind") {
            return "token::TokenKind";
        }
        if std::mem::equal_bytes(second.literal, "Token") {
            return "token::Token";
        }
    }
    if std::mem::equal_bytes(first.literal, "lexer") {
        if std::mem::equal_bytes(second.literal, "Secret") {
            return "lexer::Secret";
        }
    }
    if std::mem::equal_bytes(first.literal, "std") {
        return try std_type_name(tokens, start);
    }
    return first.literal;
}

// std_type_name returns selected std namespace type spellings.
fn std_type_name(tokens: &std::array::Array<token::Token>, start: i64) -> ![]const u8 {
    let module = try tokens.at(start + 2);
    if start + 4 >= tokens.len() {
        return "std";
    }
    let name = try tokens.at(start + 4);

    if std::mem::equal_bytes(module.literal, "string") {
        if std::mem::equal_bytes(name.literal, "String") {
            return "std::string::String";
        }
    }
    if std::mem::equal_bytes(module.literal, "map") {
        if std::mem::equal_bytes(name.literal, "Map") {
            return "std::map::Map<[]const u8, i64>";
        }
    }
    if std::mem::equal_bytes(module.literal, "array") {
        if std::mem::equal_bytes(name.literal, "Array") {
            return "std::array::Array<i64>";
        }
    }
    return "std";
}

// print_function_control_details writes selected statement node counts.
fn print_function_control_details(tokens: &std::array::Array<token::Token>, start: i64) -> !void {
    print("controls");
    print("ifs");
    print(try function_token_count(tokens, start, token::TokenKind::If));
    print("whiles");
    print(try function_token_count(tokens, start, token::TokenKind::While));
    print("fors");
    print(try function_token_count(tokens, start, token::TokenKind::For));
    print("matches");
    print(try function_token_count(tokens, start, token::TokenKind::Match));
    print("breaks");
    print(try function_token_count(tokens, start, token::TokenKind::Break));
    print("continues");
    print(try function_token_count(tokens, start, token::TokenKind::Continue));
    print("match arms");
    print(try function_token_count(tokens, start, token::TokenKind::FatArrow));
    return void;
}

// print_function_expression_details writes selected expression node counts.
fn print_function_expression_details(
    tokens: &std::array::Array<token::Token>,
    start: i64
) -> !void {
    print("expressions");
    print("locals");
    print(try function_locals_count(tokens, start));
    print("assignments");
    print(try function_assignments_count(tokens, start));
    print("calls");
    print(try function_calls_count(tokens, start));
    print("field accesses");
    print(try function_field_access_count(tokens, start));
    print("struct literals");
    print(try function_struct_literal_count(tokens, start));
    print("binary expressions");
    print(try function_binary_operator_count(tokens, start));
    return void;
}

// function_token_count counts one token kind before the next function.
fn function_token_count(
    tokens: &std::array::Array<token::Token>,
    start: i64,
    kind: token::TokenKind
) -> !i64 {
    let body_start = try function_body_start(tokens, start);
    if body_start < 0 {
        return 0;
    }
    let body_end = try matching_brace(tokens, body_start);
    var index = body_start + 1;
    var count = 0;

    while index < body_end {
        let current = try tokens.at(index);
        var skipped = false;
        if try token_starts_unsafe_block(tokens, index) {
            index = try matching_brace(tokens, index + 1) + 1;
            skipped = true;
        }
        if !skipped {
            if current.kind == token::TokenKind::Comptime {
                index = try skip_comptime(tokens, index);
                skipped = true;
            }
        }
        if !skipped {
            if current.kind == kind {
                if !try token_is_skipped_control(tokens, index, kind) {
                    count = count + 1;
                }
            }
        }
        if !skipped {
            index = index + 1;
        }
    }
    return count;
}

// token_is_skipped_control reports whether a token is not a statement control node.
fn token_is_skipped_control(
    tokens: &std::array::Array<token::Token>,
    index: i64,
    kind: token::TokenKind
) -> !bool {
    if kind == token::TokenKind::If {
        return try token_is_if_expression(tokens, index);
    }
    if kind == token::TokenKind::Match {
        return !try token_is_direct_body_token(tokens, index);
    }
    if kind == token::TokenKind::FatArrow {
        return !try token_is_top_match_arm(tokens, index);
    }
    return false;
}

// token_is_if_expression reports whether if follows an assignment expression.
fn token_is_if_expression(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    if index == 0 {
        return false;
    }
    let previous = try tokens.at(index - 1);
    return previous.kind == token::TokenKind::Assign;
}

// token_is_direct_body_token reports whether a token is directly in the function body.
fn token_is_direct_body_token(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    var cursor = index;
    var depth = 0;

    while cursor > 0 {
        cursor = cursor - 1;
        let current = try tokens.at(cursor);
        if current.kind == token::TokenKind::RBrace {
            depth = depth + 1;
        }
        if current.kind == token::TokenKind::LBrace {
            if depth == 0 {
                return true;
            }
            depth = depth - 1;
        }
    }
    return false;
}

// token_is_top_match_arm reports whether an arrow belongs to a direct match arm.
fn token_is_top_match_arm(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    var cursor = index;
    var depth = 0;

    while cursor > 0 {
        cursor = cursor - 1;
        let current = try tokens.at(cursor);
        if current.kind == token::TokenKind::RBrace {
            depth = depth + 1;
        }
        if current.kind == token::TokenKind::LBrace {
            if depth == 0 {
                let before = try tokens.at(cursor - 1);
                return before.kind == token::TokenKind::Ident;
            }
            depth = depth - 1;
        }
    }
    return false;
}

// function_direct_return_count counts returns directly in the function body.
fn function_direct_return_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    let body_start = try function_body_start(tokens, start);
    if body_start < 0 {
        return 0;
    }
    let body_end = try matching_brace(tokens, body_start);
    var index = body_start + 1;
    var depth = 1;
    var count = 0;

    while index < body_end {
        let current = try tokens.at(index);
        var skipped = false;
        if try token_starts_unsafe_block(tokens, index) {
            index = try matching_brace(tokens, index + 1) + 1;
            skipped = true;
        }
        if !skipped {
            if current.kind == token::TokenKind::Comptime {
                index = try skip_comptime(tokens, index);
                skipped = true;
            }
        }
        if !skipped {
            if current.kind == token::TokenKind::Return {
                if depth == 1 {
                    count = count + 1;
                }
            }
        }
        if !skipped {
            if current.kind == token::TokenKind::LBrace {
                depth = depth + 1;
            }
        }
        if !skipped {
            if current.kind == token::TokenKind::RBrace {
                depth = depth - 1;
            }
        }
        if !skipped {
            index = index + 1;
        }
    }
    return count;
}

// skip_comptime advances over one comptime statement or expression.
fn skip_comptime(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    let next = try tokens.at(start + 1);
    if next.kind == token::TokenKind::If {
        return try skip_comptime_if(tokens, start + 1);
    }
    var index = start;
    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Semicolon {
            return index + 1;
        }
        index = index + 1;
    }
    return index;
}

// skip_comptime_if advances over a comptime if and optional else block.
fn skip_comptime_if(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;
    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            let after_then = try matching_brace(tokens, index) + 1;
            if after_then < tokens.len() {
                let maybe_else = try tokens.at(after_then);
                if maybe_else.kind == token::TokenKind::Else {
                    let else_brace = after_then + 1;
                    return try matching_brace(tokens, else_brace) + 1;
                }
            }
            return after_then;
        }
        index = index + 1;
    }
    return index;
}

// function_body_start returns the opening brace for a function body.
fn function_body_start(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if index > start {
            if current.kind == token::TokenKind::Fn {
                return -1;
            }
        }
        if current.kind == token::TokenKind::Semicolon {
            return -1;
        }
        if current.kind == token::TokenKind::LBrace {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// matching_brace returns the index of the brace that closes start.
fn matching_brace(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    var index = start;
    var depth = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LBrace {
            depth = depth + 1;
        }
        if current.kind == token::TokenKind::RBrace {
            depth = depth - 1;
            if depth == 0 {
                return index;
            }
        }
        index = index + 1;
    }
    return tokens.len();
}

// token_starts_unsafe_block reports whether an unsafe block begins at index.
fn token_starts_unsafe_block(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let current = try tokens.at(index);
    let next = try tokens.at(index + 1);
    if current.kind != token::TokenKind::Unsafe {
        return false;
    }
    return next.kind == token::TokenKind::LBrace;
}

// function_locals_count counts local declarations before the next function.
fn function_locals_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    return try function_token_count(tokens, start, token::TokenKind::Let)
        + try function_token_count(tokens, start, token::TokenKind::Var);
}

// function_assignments_count counts non-local assignment statements.
fn function_assignments_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    let body_start = try function_body_start(tokens, start);
    if body_start < 0 {
        return 0;
    }
    let body_end = try matching_brace(tokens, body_start);
    var index = body_start + 1;
    var count = 0;

    while index < body_end {
        let current = try tokens.at(index);
        var skipped = false;
        if try token_starts_unsafe_block(tokens, index) {
            index = try matching_brace(tokens, index + 1) + 1;
            skipped = true;
        }
        if !skipped {
            if current.kind == token::TokenKind::Comptime {
                index = try skip_comptime(tokens, index);
                skipped = true;
            }
        }
        if !skipped {
            if current.kind == token::TokenKind::Assign {
                if !try assignment_belongs_to_local(tokens, index) {
                    count = count + 1;
                }
            }
        }
        if !skipped {
            index = index + 1;
        }
    }
    return count;
}

// assignment_belongs_to_local reports whether an assignment initializes a local.
fn assignment_belongs_to_local(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    var cursor = index;

    while cursor > 0 {
        cursor = cursor - 1;
        let current = try tokens.at(cursor);
        if current.kind == token::TokenKind::Let {
            return true;
        }
        if current.kind == token::TokenKind::Var {
            return true;
        }
        if current.kind == token::TokenKind::Semicolon {
            return false;
        }
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
    }
    return false;
}

// function_calls_count counts selected call expressions before the next function.
fn function_calls_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    let body_start = try function_body_start(tokens, start);
    if body_start < 0 {
        return 0;
    }
    let body_end = try matching_brace(tokens, body_start);
    var index = body_start + 1;
    var count = 0;

    while index < body_end {
        let current = try tokens.at(index);
        let previous = try tokens.at(index - 1);
        let before = try tokens.at(index - 2);
        var skipped = false;
        if try token_starts_unsafe_block(tokens, index) {
            index = try matching_brace(tokens, index + 1) + 1;
            skipped = true;
        }
        if !skipped {
            if current.kind == token::TokenKind::Comptime {
                index = try skip_comptime(tokens, index);
                skipped = true;
            }
        }
        if !skipped {
            if current.kind == token::TokenKind::LParen {
                if try call_has_counted_callee(tokens, index) {
                    if before.kind != token::TokenKind::Fn {
                        if !try call_is_match_pattern(tokens, index) {
                            if !try call_is_in_try_expr(tokens, index) {
                                count = count + 1;
                            }
                        }
                    }
                }
            }
        }
        if !skipped {
            index = index + 1;
        }
    }
    return count;
}

// call_has_counted_callee reports whether a left paren belongs to a call expression.
fn call_has_counted_callee(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    let previous = try tokens.at(index - 1);
    if previous.kind == token::TokenKind::Ident {
        return true;
    }
    if previous.kind != token::TokenKind::GT {
        return false;
    }
    return try generic_call_starts_with_type(tokens, index);
}

// generic_call_starts_with_type reports whether Type<T>(...) starts with a type name.
fn generic_call_starts_with_type(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    var cursor = index;

    while cursor > 0 {
        cursor = cursor - 1;
        let current = try tokens.at(cursor);
        if current.kind == token::TokenKind::LT {
            let name = try tokens.at(cursor - 1);
            if std::mem::equal_bytes(name.literal, "arena") {
                return false;
            }
            if std::mem::equal_bytes(name.literal, "handle") {
                return false;
            }
            return true;
        }
    }
    return false;
}

// call_is_in_try_expr reports whether a call is inside one try expression statement.
fn call_is_in_try_expr(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start;

    while index > 0 {
        index = index - 1;
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Try {
            return true;
        }
        if current.kind == token::TokenKind::Semicolon {
            return false;
        }
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
    }
    return false;
}

// call_is_match_pattern reports whether a parenthesized item is a match pattern.
fn call_is_match_pattern(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::RParen {
            let next = try tokens.at(index + 1);
            return next.kind == token::TokenKind::FatArrow;
        }
        if current.kind == token::TokenKind::Semicolon {
            return false;
        }
        index = index + 1;
    }
    return false;
}

// function_struct_literal_count counts selected struct literal expressions.
fn function_struct_literal_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    let body_start = try function_body_start(tokens, start);
    if body_start < 0 {
        return 0;
    }
    let body_end = try matching_brace(tokens, body_start);
    var index = body_start + 1;
    var count = 0;

    while index + 1 < body_end {
        let current = try tokens.at(index);
        let next = try tokens.at(index + 1);
        var skipped = false;
        if try token_starts_unsafe_block(tokens, index) {
            index = try matching_brace(tokens, index + 1) + 1;
            skipped = true;
        }
        if !skipped {
            if current.kind == token::TokenKind::Comptime {
                index = try skip_comptime(tokens, index);
                skipped = true;
            }
        }
        if !skipped {
            if current.kind == token::TokenKind::Ident {
                if next.kind == token::TokenKind::LBrace {
                    if try token_starts_struct_literal(tokens, index) {
                        count = count + 1;
                    }
                }
            }
        }
        if !skipped {
            index = index + 1;
        }
    }
    return count;
}

// token_starts_struct_literal reports whether an identifier opens a literal.
fn token_starts_struct_literal(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    let previous = try tokens.at(index - 1);
    if previous.kind == token::TokenKind::Assign {
        return true;
    }
    if previous.kind == token::TokenKind::Return {
        return true;
    }
    if previous.kind == token::TokenKind::LParen {
        return true;
    }
    if previous.kind == token::TokenKind::DoubleColon {
        return true;
    }
    return previous.kind == token::TokenKind::Comma;
}

// function_field_access_count counts field access dots while ignoring dereference dots.
fn function_field_access_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    let body_start = try function_body_start(tokens, start);
    if body_start < 0 {
        return 0;
    }
    let body_end = try matching_brace(tokens, body_start);
    var index = body_start + 1;
    var count = 0;

    while index < body_end {
        let current = try tokens.at(index);
        var skipped = false;
        if try token_starts_unsafe_block(tokens, index) {
            index = try matching_brace(tokens, index + 1) + 1;
            skipped = true;
        }
        if !skipped {
            if current.kind == token::TokenKind::Comptime {
                index = try skip_comptime(tokens, index);
                skipped = true;
            }
        }
        if !skipped {
            if current.kind == token::TokenKind::Dot {
                if !try token_is_deref_dot(tokens, index) {
                    if !try call_is_in_try_expr(tokens, index) {
                        if !try token_is_in_borrow_expr(tokens, index) {
                            count = count + 1;
                        }
                    }
                }
            }
        }
        if !skipped {
            index = index + 1;
        }
    }
    return count;
}

// token_is_deref_dot reports whether a dot starts .*
fn token_is_deref_dot(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    if index + 1 < tokens.len() {
        let next = try tokens.at(index + 1);
        if next.kind == token::TokenKind::Asterisk {
            return true;
        }
    }
    return false;
}

// token_is_in_borrow_expr reports whether a field access is part of an amp borrow.
fn token_is_in_borrow_expr(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    var cursor = index;

    while cursor > 0 {
        cursor = cursor - 1;
        let current = try tokens.at(cursor);
        if current.kind == token::TokenKind::Amp {
            return true;
        }
        if current.kind == token::TokenKind::Semicolon {
            return false;
        }
        if current.kind == token::TokenKind::Assign {
            return false;
        }
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::Comma {
            return false;
        }
    }
    return false;
}

// function_binary_operator_count counts selected infix operators.
fn function_binary_operator_count(tokens: &std::array::Array<token::Token>, start: i64) -> !i64 {
    let body_start = try function_body_start(tokens, start);
    if body_start < 0 {
        return 0;
    }
    let body_end = try matching_brace(tokens, body_start);
    var index = body_start + 1;
    var count = 0;

    while index < body_end {
        let current = try tokens.at(index);
        var skipped = false;
        if try token_starts_unsafe_block(tokens, index) {
            index = try matching_brace(tokens, index + 1) + 1;
            skipped = true;
        }
        if !skipped {
            if current.kind == token::TokenKind::Comptime {
                index = try skip_comptime(tokens, index);
                skipped = true;
            }
        }
        if !skipped {
            if try token_is_binary_operator(tokens, index) {
                count = count + 1;
            }
        }
        if !skipped {
            index = index + 1;
        }
    }
    return count;
}

// token_is_binary_operator reports whether a token is an expression infix operator.
fn token_is_binary_operator(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    let current = try tokens.at(index);
    if current.kind == token::TokenKind::Plus {
        return true;
    }
    if current.kind == token::TokenKind::Minus {
        return true;
    }
    if current.kind == token::TokenKind::Asterisk {
        return !try token_touches_deref_dot(tokens, index);
    }
    if current.kind == token::TokenKind::Slash {
        return true;
    }
    if current.kind == token::TokenKind::Percent {
        return true;
    }
    if current.kind == token::TokenKind::Eq {
        return true;
    }
    if current.kind == token::TokenKind::NotEq {
        return true;
    }
    if current.kind == token::TokenKind::LT {
        return !try token_is_generic_angle(tokens, index);
    }
    if current.kind == token::TokenKind::LTE {
        return true;
    }
    if current.kind == token::TokenKind::GT {
        return !try token_is_generic_angle(tokens, index);
    }
    return current.kind == token::TokenKind::GTE;
}

// token_touches_deref_dot reports whether an asterisk is part of .*
fn token_touches_deref_dot(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    if index > 0 {
        let previous = try tokens.at(index - 1);
        if previous.kind == token::TokenKind::Dot {
            return true;
        }
    }
    if index + 1 < tokens.len() {
        let next = try tokens.at(index + 1);
        if next.kind == token::TokenKind::Dot {
            return true;
        }
    }
    return false;
}

// token_is_generic_angle reports whether an angle token belongs to Type<T>.
fn token_is_generic_angle(tokens: &std::array::Array<token::Token>, index: i64) -> !bool {
    if index == 0 {
        return false;
    }
    let current = try tokens.at(index);
    if current.kind == token::TokenKind::GT {
        return try angle_has_matching_open(tokens, index);
    }
    let previous = try tokens.at(index - 1);
    if previous.kind == token::TokenKind::Ident {
        return try angle_has_matching_close(tokens, index);
    }
    if previous.kind == token::TokenKind::GT {
        return true;
    }
    if previous.kind == token::TokenKind::DoubleColon {
        return true;
    }
    return false;
}

// angle_has_matching_open reports whether a greater-than token closes a generic list.
fn angle_has_matching_open(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start;

    while index > 0 {
        index = index - 1;
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::LT {
            return true;
        }
        if current.kind == token::TokenKind::Semicolon {
            return false;
        }
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::RBrace {
            return false;
        }
        if current.kind == token::TokenKind::Assign {
            return false;
        }
    }
    return false;
}

// angle_has_matching_close reports whether a less-than token closes before a boundary.
fn angle_has_matching_close(tokens: &std::array::Array<token::Token>, start: i64) -> !bool {
    var index = start + 1;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::GT {
            return true;
        }
        if current.kind == token::TokenKind::Semicolon {
            return false;
        }
        if current.kind == token::TokenKind::LBrace {
            return false;
        }
        if current.kind == token::TokenKind::RBrace {
            return false;
        }
        index = index + 1;
    }
    return false;
}

// parse_token_stream consumes the Kizu-native lexer token stream.
pub fn parse_token_stream(tokens: &std::array::Array<token::Token>) -> !ast::ParseSummary {
    var functions = 0;
    var imports = 0;
    var structs = 0;
    var enums = 0;
    var unions = 0;
    var returns = 0;
    var index = 0;

    while index < tokens.len() {
        let current = try tokens.at(index);
        if current.kind == token::TokenKind::Fn {
            functions = functions + 1;
        }
        if current.kind == token::TokenKind::Import {
            imports = imports + 1;
        }
        if current.kind == token::TokenKind::Struct {
            structs = structs + 1;
        }
        if current.kind == token::TokenKind::Enum {
            enums = enums + 1;
        }
        if current.kind == token::TokenKind::Union {
            unions = unions + 1;
        }
        if current.kind == token::TokenKind::Return {
            returns = returns + 1;
        }
        index = index + 1;
    }

    return ast::ParseSummary {
        function_count: functions,
        import_count: imports,
        struct_count: structs,
        enum_count: enums,
        union_count: unions,
        return_count: returns,
    };
}

// parse_tokens preserves the legacy component-test name during migration.
pub fn parse_tokens(tokens: &std::array::Array<token::Token>) -> !ast::ParseSummary {
    return try parse_token_stream(tokens);
}

// ready exposes the parser module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
