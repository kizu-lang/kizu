import selfhost::lexer;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "fn main() -> void { return; }";
    var tokens = try lexer::tokenize(allocator, source);
    let summary = lexer::summarize(source);

    std::testing::expect_equal<i64>(11, tokens.len());
    std::testing::expect_equal<i64>(11, summary.tokens);
    std::testing::expect_equal<i64>(29, summary.bytes);
    std::testing::expect_equal<i64>(1, summary.lines);
    std::testing::expect_equal<i64>(0, summary.diagnostics);

    let first = tokens.get_or_panic(0);
    std::testing::expect(lexer::is_fn(first));
    std::testing::expect_equal<i64>(0, first.start);
    std::testing::expect_equal<i64>(2, first.end);
    std::testing::expect_equal<i64>(1, first.line);
    std::testing::expect_equal<i64>(1, first.column);

    let eof = tokens.get_or_panic(10);
    std::testing::expect(lexer::is_eof(eof));
    std::testing::expect_equal<i64>(29, eof.start);
    std::testing::expect_equal<i64>(29, eof.end);

    var diagnostic = lexer::invalid_token(allocator, "selfhost/src/lexer.kizu", 3, 4);
    std::testing::expect_equal<[]u8>("invalid token", diagnostic.message);
    std::testing::expect_equal<i64>(3, diagnostic.primary.byte_start);
    std::testing::expect_equal<i64>(4, diagnostic.primary.byte_end);
    diagnostic.deinit();

    tokens.deinit();

    print("lexer-tokens");
    print(summary.tokens);
    print("lexer-bytes");
    print(summary.bytes);
    print("lexer-diagnostics");
    print(summary.diagnostics);
    return;
}
