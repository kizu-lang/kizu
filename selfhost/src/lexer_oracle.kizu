import selfhost::lexer;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "fn main() -> void { return; }";
    var tokens = try lexer::tokenize(allocator, source);
    let summary = lexer::summarize(source);

    std::testing::expect(11 == tokens.len());
    std::testing::expect(11 == summary.tokens);
    std::testing::expect(29 == summary.bytes);
    std::testing::expect(1 == summary.lines);
    std::testing::expect(0 == summary.diagnostics);

    let first = tokens.get_or_panic(0);
    std::testing::expect(lexer::is_fn(first));
    std::testing::expect(0 == first.start);
    std::testing::expect(2 == first.end);
    std::testing::expect(1 == first.line);
    std::testing::expect(1 == first.column);

    let eof = tokens.get_or_panic(10);
    std::testing::expect(lexer::is_eof(eof));
    std::testing::expect(29 == eof.start);
    std::testing::expect(29 == eof.end);

    var diagnostic = lexer::invalid_token(allocator, "selfhost/src/lexer.kizu", 3, 4);
    std::testing::expect(std::mem::equal_bytes("invalid token", diagnostic.message));
    std::testing::expect(3 == diagnostic.primary.byte_start);
    std::testing::expect(4 == diagnostic.primary.byte_end);
    diagnostic.deinit();

    tokens.deinit();

    print("lexer-tokens");
    print(summary.tokens);
    print("lexer-bytes");
    print(summary.bytes);
    print("lexer-diagnostics");
    print(summary.diagnostics);
    return;
}
