import selfhost::lexer;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let source = "fn main() -> void { return; }";
    var tokens = try lexer::tokenize(allocator, source);
    let summary = lexer::summarize(source);

    try std::testing::expect_equal_i64(11, tokens.len());
    try std::testing::expect_equal_i64(11, summary.tokens);
    try std::testing::expect_equal_i64(29, summary.bytes);
    try std::testing::expect_equal_i64(1, summary.lines);
    try std::testing::expect_equal_i64(0, summary.diagnostics);

    let first = try tokens.get(0);
    try std::testing::expect_equal_bool(true, lexer::is_fn(first));
    try std::testing::expect_equal_i64(0, first.start);
    try std::testing::expect_equal_i64(2, first.end);
    try std::testing::expect_equal_i64(1, first.line);
    try std::testing::expect_equal_i64(1, first.column);

    let eof = try tokens.get(10);
    try std::testing::expect_equal_bool(true, lexer::is_eof(eof));
    try std::testing::expect_equal_i64(29, eof.start);
    try std::testing::expect_equal_i64(29, eof.end);

    var diagnostic = lexer::invalid_token(allocator, "selfhost/src/lexer.kizu", 3, 4);
    try std::testing::expect_equal_bytes("invalid token", diagnostic.message);
    try std::testing::expect_equal_i64(3, diagnostic.primary.byte_start);
    try std::testing::expect_equal_i64(4, diagnostic.primary.byte_end);
    diagnostic.deinit();

    tokens.deinit();

    print("lexer-tokens");
    print(summary.tokens);
    print("lexer-bytes");
    print(summary.bytes);
    print("lexer-diagnostics");
    print(summary.diagnostics);
    return;
}
