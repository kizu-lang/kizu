// Module: component tests for the self-host type checker boundary.

import selfhost::types;

// types_component_test checks early type-name classification facts.
pub fn types_component_test() -> !void {
    let int_type = try types::classify("i64");
    let bytes_type = try types::classify("[]const u8");
    let error_type = try types::classify("!void");
    let user_type = try types::classify("Token");
    let unknown_type = try types::classify("42bad");
    let missing_return = try types::source_diagnostic("fn bad() -> i64 { 1; }");
    let if_only_return = try types::source_diagnostic(
        "fn bad(ok: bool) -> i64 { if ok { return 1; } }"
    );

    try std::testing::expect(int_type.kind == types::TypeKind::I64);
    try std::testing::expect(types::can_copy(&int_type));
    try std::testing::expect(bytes_type.kind == types::TypeKind::Bytes);
    try std::testing::expect(types::can_copy(&bytes_type) == false);
    try std::testing::expect(error_type.kind == types::TypeKind::ErrorUnion);
    try std::testing::expect(error_type.is_error_union);
    try std::testing::expect_equal_bytes("void", error_type.success_type);
    try std::testing::expect(user_type.kind == types::TypeKind::User);
    try std::testing::expect(unknown_type.kind == types::TypeKind::Unknown);
    let another_int = try types::classify("i64");
    try std::testing::expect(types::same(&int_type, &another_int));
    try std::testing::expect_equal_bytes(
        "type error: function `bad` must return i64",
        missing_return
    );
    try std::testing::expect_equal_bytes(
        "type error: function `bad` must return i64",
        if_only_return
    );
    return void;
}
