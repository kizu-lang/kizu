import selfhost::source;
import selfhost::ownership::checker;
import selfhost::ownership::data;
import selfhost::ownership::move_diagnostic;
import selfhost::types::model;

pub fn check(typed: model::TypeSummary) -> data::OwnershipSummary {
    return checker::check(typed);
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: model::TypeSummary
) -> !data::OwnershipSummary {
    return checker::check_sources(allocator, files, typed);
}

pub fn first_use_after_move_name(
    allocator: Allocator,
    path: []u8,
    text: []u8
) -> ![]u8 {
    return move_diagnostic::first_use_after_move_name(allocator, path, text);
}

pub fn check_package(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: model::TypeSummary
) -> !data::CheckedPackage {
    return checker::check_package(allocator, files, typed);
}

pub fn checked_package_from_summary(summary: data::OwnershipSummary) -> data::CheckedPackage {
    return checker::checked_package_from_summary(summary);
}

pub fn summary_of(checked: &data::CheckedPackage) -> data::OwnershipSummary {
    return checker::summary_of(checked);
}
