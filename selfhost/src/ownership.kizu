import selfhost::source;
import selfhost::ownership::borrow_param_keys;
import selfhost::ownership::checker;
import selfhost::ownership::data;
import selfhost::ownership::move_diagnostic;
import selfhost::types::model;

pub fn check(typed: model::TypeSummary) -> data::OwnershipSummary {
    return checker::check(typed);
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: model::TypeSummary
) -> !data::OwnershipSummary {
    return checker::check_sources(allocator, files, typed);
}

pub fn first_use_after_move_name_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> ![]u8 {
    let summary = try move_diagnostic::first_use_after_move_summary_ast_node(
        allocator,
        file,
        ast,
        root
    );
    if summary.found {
        return summary.name;
    }
    return "";
}

pub fn first_use_after_move_name_ast_node_with_borrow_params(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    borrow_params: &std::map::Map<[]u8, bool>
) -> ![]u8 {
    let summary = try move_diagnostic::first_use_after_move_summary_ast_node_with_borrow_params(
        allocator,
        file,
        ast,
        root,
        borrow_params
    );
    if summary.found {
        return summary.name;
    }
    return "";
}

pub fn first_use_after_move_summary_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::UseAfterMoveSummary {
    return move_diagnostic::first_use_after_move_summary_ast_node(allocator, file, ast, root);
}

pub fn first_use_after_move_summary_ast_node_with_borrow_params(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    borrow_params: &std::map::Map<[]u8, bool>
) -> !data::UseAfterMoveSummary {
    return move_diagnostic::first_use_after_move_summary_ast_node_with_borrow_params(
        allocator,
        file,
        ast,
        root,
        borrow_params
    );
}

pub fn collect_borrow_param_keys(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    borrow_params: &var std::map::Map<[]u8, bool>
) -> !void {
    return borrow_param_keys::collect_borrow_param_keys(
        allocator,
        file,
        ast,
        root,
        borrow_params
    );
}

pub fn check_package(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: model::TypeSummary
) -> !data::CheckedPackage {
    return checker::check_package(allocator, files, typed);
}

pub fn check_parsed_package(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed_sources: &std::array::Array<std::kizu::ast::ParseResult>,
    parsed_source_indexes: &std::array::Array<i64>,
    typed: model::TypeSummary
) -> !data::CheckedPackage {
    return checker::check_parsed_package(
        allocator,
        files,
        parsed_sources,
        parsed_source_indexes,
        typed
    );
}

pub fn checked_package_from_summary(summary: data::OwnershipSummary) -> data::CheckedPackage {
    return checker::checked_package_from_summary(summary);
}

pub fn summary_of(checked: &data::CheckedPackage) -> data::OwnershipSummary {
    return checker::summary_of(checked);
}
