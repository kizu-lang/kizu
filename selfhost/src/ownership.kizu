import selfhost::lexer;
import selfhost::source;
import selfhost::types;

pub enum ResourceKind {
    Value
    Array
    Map
    String
    Arena
    Handle
    BorrowedView
}

pub enum OwnershipState {
    Available
    Moved
    SharedBorrowed
    MutBorrowed
    Deinitialized
}

pub struct OwnershipSummary {
    pub resources: i64;
    pub checked_nodes: i64;
    pub borrows: i64;
    pub errors: i64;
}

pub fn check(typed: types::TypeSummary) -> OwnershipSummary {
    return OwnershipSummary {
        resources: typed.symbols,
        checked_nodes: typed.typed_nodes,
        borrows: 0,
        errors: typed.diagnostics
    };
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: types::TypeSummary
) -> !OwnershipSummary {
    var summary = ownership_summary(typed.symbols, typed.typed_nodes, 0, 0);
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind == source::SourceKind::Selfhost {
            summary = merge_ownership_summaries(
                summary,
                try check_file_ownership_ast(allocator, file)
            );
        }
        index = index + 1;
    }
    return summary;
}

pub fn declare_resource(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    kinds: &mut std::map::Map<[]const u8, ResourceKind>,
    name: []const u8,
    kind: ResourceKind
) -> !void {
    if states.contains(name) {
        return error("duplicate resource");
    }
    try states.insert(name, OwnershipState::Available);
    try kinds.insert(name, kind);
    return;
}

pub fn move_value(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("move requires available value");
    }
    try states.insert(name, OwnershipState::Moved);
    return;
}

pub fn shared_borrow(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state == OwnershipState::MutBorrowed or state == OwnershipState::Moved {
        return error("shared borrow blocked");
    }
    if state == OwnershipState::Deinitialized {
        return error("borrow after deinit");
    }
    try states.insert(name, OwnershipState::SharedBorrowed);
    return;
}

pub fn record_borrow(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8,
    mutable: bool
) -> !void {
    if mutable {
        try mut_borrow(states, name);
        return;
    }
    let state = try states.get(name);
    if state == OwnershipState::MutBorrowed or state == OwnershipState::Moved {
        return error("shared borrow blocked");
    }
    if state == OwnershipState::Deinitialized {
        return error("borrow after deinit");
    }
    try states.insert(name, OwnershipState::SharedBorrowed);
    return;
}

pub fn mut_borrow(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("mutable borrow requires available value");
    }
    try states.insert(name, OwnershipState::MutBorrowed);
    return;
}

pub fn release_borrow(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state == OwnershipState::SharedBorrowed or state == OwnershipState::MutBorrowed {
        try states.insert(name, OwnershipState::Available);
        return;
    }
    return error("release requires active borrow");
}

pub fn deinit_resource(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("deinit requires available value");
    }
    try states.insert(name, OwnershipState::Deinitialized);
    return;
}

pub fn state_of(
    states: &std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !OwnershipState {
    return states.get(name);
}

pub fn kind_of(
    kinds: &std::map::Map<[]const u8, ResourceKind>,
    name: []const u8
) -> !ResourceKind {
    return kinds.get(name);
}

pub fn summarize(
    states: &std::map::Map<[]const u8, OwnershipState>,
    borrows: i64,
    errors: i64
) -> OwnershipSummary {
    return ownership_summary(states.len(), states.len(), borrows, errors);
}

fn check_file_ownership_ast(
    allocator: Allocator,
    file: &source::SourceFile
) -> !OwnershipSummary {
    let ast_source = std::kizu::ast::source_file(file.path, file.text);
    let result = try std::kizu::parser::parse_program(allocator, ast_source);
    let summary = try check_ownership_ast_node(
        allocator,
        file,
        result.ast,
        result.root
    );
    result.deinit();
    return summary;
}

fn check_ownership_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return check_ownership_range(allocator, file, ast, program.declarations);
        FnDecl(fn_decl) => return check_function_ownership(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.body
        );
        ImportDecl(import_decl) => return ownership_summary(0, 1, 0, 0);
        StructDecl(struct_decl) => return ownership_summary(0, 1, 0, 0);
        EnumDecl(enum_decl) => return ownership_summary(0, 1, 0, 0);
        UnionDecl(union_decl) => return ownership_summary(0, 1, 0, 0);
        Empty => return ownership_summary(0, 0, 0, 0);
        Int(int_node) => return ownership_summary(0, 1, 0, 0);
        String(string_node) => return ownership_summary(0, 1, 0, 0);
        TypeName(type_name) => return ownership_summary(0, 1, 0, 0);
        Var(var_node) => return ownership_summary(0, 1, 0, 0);
        Bool(bool_node) => return ownership_summary(0, 1, 0, 0);
        Prefix(prefix_node) => return check_ownership_ast_node(allocator, file, ast, prefix_node.right);
        Binary(binary) => return merge_ownership_summaries(
            try check_ownership_ast_node(allocator, file, ast, binary.left),
            try check_ownership_ast_node(allocator, file, ast, binary.right)
        );
        FieldExpr(field_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            field_expr_node.receiver
        );
        DerefExpr(deref_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            deref_expr_node.receiver
        );
        Call(call_node) => return check_ownership_call(allocator, file, ast, call_node.callee, call_node.args);
        TypeApplyExpr(type_apply) => return check_ownership_range_with_head(
            allocator,
            file,
            ast,
            type_apply.callee,
            type_apply.type_args
        );
        CastExpr(cast_expr) => return check_ownership_ast_node(allocator, file, ast, cast_expr.value);
        IndexExpr(index_expr) => return check_ownership_index(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end
        );
        StructLiteralExpr(struct_literal) => return check_ownership_range_with_head(
            allocator,
            file,
            ast,
            struct_literal.type_name,
            struct_literal.fields
        );
        StructFieldInit(struct_field_init) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            struct_field_init.value
        );
        ArenaNewExpr(arena_new) => return ownership_summary(0, 1, 0, 0);
        TryExpr(try_expr_node) => return check_ownership_ast_node(allocator, file, ast, try_expr_node.value);
        ComptimeExpr(comptime_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            comptime_expr_node.value
        );
        Block(block) => return check_ownership_range(allocator, file, ast, block.statements);
        If(if_node) => return check_ownership_if(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block
        );
        Let(let_node) => return check_let_ownership(
            allocator,
            file,
            ast,
            let_node.name,
            let_node.value
        );
        Assign(assign_node) => return merge_ownership_summaries(
            try check_ownership_ast_node(allocator, file, ast, assign_node.target),
            try check_ownership_ast_node(allocator, file, ast, assign_node.value)
        );
        Return(return_node) => return check_ownership_ast_node(allocator, file, ast, return_node.value);
        ExprStmt(expr_stmt) => return check_ownership_ast_node(allocator, file, ast, expr_stmt.expr);
        While(while_node) => return check_ownership_loop(allocator, file, ast, while_node.condition, while_node.body);
        For(for_node) => return check_ownership_for_node(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body
        );
        Break(break_node) => return ownership_summary(0, 1, 0, 0);
        Continue(continue_node) => return ownership_summary(0, 1, 0, 0);
        Param(param_node) => return ownership_summary(0, 1, 0, 0);
        Field(field_node) => return ownership_summary(0, 1, 0, 0);
        UnionVariant(union_variant) => return ownership_summary(0, 1, 0, 0);
        Match(match_node) => return check_ownership_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms
        );
        MatchArm(match_arm) => return check_ownership_ast_node(allocator, file, ast, match_arm.body);
        Unsafe(unsafe_node) => return check_ownership_ast_node(allocator, file, ast, unsafe_node.body);
        ComptimeIf(comptime_if_node) => return check_ownership_comptime_if(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block
        );
    }
}

fn check_function_ownership(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    var states = std::map::Map<[]const u8, OwnershipState>(allocator);
    var kinds = std::map::Map<[]const u8, ResourceKind>(allocator);
    var summary = ownership_summary(0, 1, 0, 0);
    var param_index = 0;
    while param_index < params.len {
        let param_child = try ast.child_at(params, param_index);
        let param_name = param_binding_name(file, ast, param_child);
        if !std::mem::equal_bytes(param_name, "") {
            let kind = param_resource_kind(file, ast, param_child);
            try declare_resource(states, kinds, param_name, kind);
            summary = merge_ownership_summaries(summary, ownership_summary(1, 1, 0, 0));
            if kind == ResourceKind::BorrowedView {
                try shared_borrow(states, param_name);
                summary = merge_ownership_summaries(summary, ownership_summary(0, 0, 1, 0));
            }
        }
        param_index = param_index + 1;
    }
    var statement_index = 0;
    let statements = function_body_statements(ast, body);
    while statement_index < statements.len {
        let statement = try ast.child_at(statements, statement_index);
        if statement_is_let(ast, statement) {
            let name = statement_let_name(ast, statement);
            let value = statement_let_value(ast, statement);
            let kind = try initializer_state_resource_kind(file, ast, value, kinds);
            let borrow_name = initializer_borrow_name(file, ast, value);
            if !std::mem::equal_bytes(borrow_name, "") {
                if states.contains(borrow_name) {
                    if initializer_borrow_mutable(ast, value) {
                        try record_borrow(states, borrow_name, true);
                    } else {
                        try shared_borrow(states, borrow_name);
                    }
                }
                summary = merge_ownership_summaries(summary, ownership_summary(0, 0, 1, 0));
            }
            let move_name = initializer_move_name(file, ast, value);
            if !std::mem::equal_bytes(move_name, "") and states.contains(move_name) {
                let state = try states.get(move_name);
                if state == OwnershipState::Moved {
                    summary = merge_ownership_summaries(
                        summary,
                        record_use_after_move(allocator, file, ast, value)
                    );
                } else {
                    let moved_kind = try kinds.get(move_name);
                    if resource_kind_moves(moved_kind) {
                        try move_value(states, move_name);
                    }
                }
            }
            summary = merge_ownership_summaries(
                summary,
                try declare_named_resource(file, ast, name, kind, states, kinds)
            );
        }
        statement_index = statement_index + 1;
    }
    summary = merge_ownership_summaries(
        summary,
        try check_function_body(allocator, file, ast, body)
    );
    states.deinit();
    kinds.deinit();
    return summary;
}

fn param_binding_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []const u8 {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return ast_node_text(file, ast, param_node.name);
        Program(program) => return "";
        Empty => return "";
        ImportDecl(import_decl) => return "";
        StructDecl(struct_decl) => return "";
        EnumDecl(enum_decl) => return "";
        UnionDecl(union_decl) => return "";
        FnDecl(fn_decl) => return "";
        Int(int_node) => return "";
        String(string_node) => return "";
        TypeName(type_name) => return "";
        Var(var_node) => return "";
        Bool(bool_node) => return "";
        Prefix(prefix_node) => return "";
        Binary(binary) => return "";
        FieldExpr(field_expr_node) => return "";
        DerefExpr(deref_expr_node) => return "";
        Call(call_node) => return "";
        TypeApplyExpr(type_apply) => return "";
        CastExpr(cast_expr) => return "";
        IndexExpr(index_expr) => return "";
        StructLiteralExpr(struct_literal) => return "";
        StructFieldInit(struct_field_init) => return "";
        ArenaNewExpr(arena_new) => return "";
        TryExpr(try_expr_node) => return "";
        ComptimeExpr(comptime_expr_node) => return "";
        Block(block) => return "";
        If(if_node) => return "";
        Let(let_node) => return "";
        Assign(assign_node) => return "";
        Return(return_node) => return "";
        ExprStmt(expr_stmt) => return "";
        While(while_node) => return "";
        For(for_node) => return "";
        Break(break_node) => return "";
        Continue(continue_node) => return "";
        Field(field_node) => return "";
        UnionVariant(union_variant) => return "";
        Match(match_node) => return "";
        MatchArm(match_arm) => return "";
        Unsafe(unsafe_node) => return "";
        ComptimeIf(comptime_if_node) => return "";
    }
}

fn param_resource_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ResourceKind {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return resource_kind_for_type(ast_node_text(file, ast, param_node.type_node));
        Program(program) => return ResourceKind::Value;
        Empty => return ResourceKind::Value;
        ImportDecl(import_decl) => return ResourceKind::Value;
        StructDecl(struct_decl) => return ResourceKind::Value;
        EnumDecl(enum_decl) => return ResourceKind::Value;
        UnionDecl(union_decl) => return ResourceKind::Value;
        FnDecl(fn_decl) => return ResourceKind::Value;
        Int(int_node) => return ResourceKind::Value;
        String(string_node) => return ResourceKind::Value;
        TypeName(type_name) => return ResourceKind::Value;
        Var(var_node) => return ResourceKind::Value;
        Bool(bool_node) => return ResourceKind::Value;
        Prefix(prefix_node) => return ResourceKind::Value;
        Binary(binary) => return ResourceKind::Value;
        FieldExpr(field_expr_node) => return ResourceKind::Value;
        DerefExpr(deref_expr_node) => return ResourceKind::Value;
        Call(call_node) => return ResourceKind::Value;
        TypeApplyExpr(type_apply) => return ResourceKind::Value;
        CastExpr(cast_expr) => return ResourceKind::Value;
        IndexExpr(index_expr) => return ResourceKind::Value;
        StructLiteralExpr(struct_literal) => return ResourceKind::Value;
        StructFieldInit(struct_field_init) => return ResourceKind::Value;
        ArenaNewExpr(arena_new) => return ResourceKind::Value;
        TryExpr(try_expr_node) => return ResourceKind::Value;
        ComptimeExpr(comptime_expr_node) => return ResourceKind::Value;
        Block(block) => return ResourceKind::Value;
        If(if_node) => return ResourceKind::Value;
        Let(let_node) => return ResourceKind::Value;
        Assign(assign_node) => return ResourceKind::Value;
        Return(return_node) => return ResourceKind::Value;
        ExprStmt(expr_stmt) => return ResourceKind::Value;
        While(while_node) => return ResourceKind::Value;
        For(for_node) => return ResourceKind::Value;
        Break(break_node) => return ResourceKind::Value;
        Continue(continue_node) => return ResourceKind::Value;
        Field(field_node) => return ResourceKind::Value;
        UnionVariant(union_variant) => return ResourceKind::Value;
        Match(match_node) => return ResourceKind::Value;
        MatchArm(match_arm) => return ResourceKind::Value;
        Unsafe(unsafe_node) => return ResourceKind::Value;
        ComptimeIf(comptime_if_node) => return ResourceKind::Value;
    }
}

fn function_body_statements(
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> std::kizu::ast::ChildRange {
    let node = ast.get(body);
    match node.data {
        Block(block) => return block.statements;
        Program(program) => return empty_child_range();
        Empty => return empty_child_range();
        ImportDecl(import_decl) => return empty_child_range();
        StructDecl(struct_decl) => return empty_child_range();
        EnumDecl(enum_decl) => return empty_child_range();
        UnionDecl(union_decl) => return empty_child_range();
        FnDecl(fn_decl) => return empty_child_range();
        Int(int_node) => return empty_child_range();
        String(string_node) => return empty_child_range();
        TypeName(type_name) => return empty_child_range();
        Var(var_node) => return empty_child_range();
        Bool(bool_node) => return empty_child_range();
        Prefix(prefix_node) => return empty_child_range();
        Binary(binary) => return empty_child_range();
        FieldExpr(field_expr_node) => return empty_child_range();
        DerefExpr(deref_expr_node) => return empty_child_range();
        Call(call_node) => return empty_child_range();
        TypeApplyExpr(type_apply) => return empty_child_range();
        CastExpr(cast_expr) => return empty_child_range();
        IndexExpr(index_expr) => return empty_child_range();
        StructLiteralExpr(struct_literal) => return empty_child_range();
        StructFieldInit(struct_field_init) => return empty_child_range();
        ArenaNewExpr(arena_new) => return empty_child_range();
        TryExpr(try_expr_node) => return empty_child_range();
        ComptimeExpr(comptime_expr_node) => return empty_child_range();
        If(if_node) => return empty_child_range();
        Let(let_node) => return empty_child_range();
        Assign(assign_node) => return empty_child_range();
        Return(return_node) => return empty_child_range();
        ExprStmt(expr_stmt) => return empty_child_range();
        While(while_node) => return empty_child_range();
        For(for_node) => return empty_child_range();
        Break(break_node) => return empty_child_range();
        Continue(continue_node) => return empty_child_range();
        Param(param_node) => return empty_child_range();
        Field(field_node) => return empty_child_range();
        UnionVariant(union_variant) => return empty_child_range();
        Match(match_node) => return empty_child_range();
        MatchArm(match_arm) => return empty_child_range();
        Unsafe(unsafe_node) => return empty_child_range();
        ComptimeIf(comptime_if_node) => return empty_child_range();
    }
}

fn empty_child_range() -> std::kizu::ast::ChildRange {
    return std::kizu::ast::ChildRange { start: 0, len: 0 };
}

fn statement_is_let(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    match node.data {
        Let(let_node) => return true;
        Program(program) => return false;
        Empty => return false;
        ImportDecl(import_decl) => return false;
        StructDecl(struct_decl) => return false;
        EnumDecl(enum_decl) => return false;
        UnionDecl(union_decl) => return false;
        FnDecl(fn_decl) => return false;
        Int(int_node) => return false;
        String(string_node) => return false;
        TypeName(type_name) => return false;
        Var(var_node) => return false;
        Bool(bool_node) => return false;
        Prefix(prefix_node) => return false;
        Binary(binary) => return false;
        FieldExpr(field_expr_node) => return false;
        DerefExpr(deref_expr_node) => return false;
        Call(call_node) => return false;
        TypeApplyExpr(type_apply) => return false;
        CastExpr(cast_expr) => return false;
        IndexExpr(index_expr) => return false;
        StructLiteralExpr(struct_literal) => return false;
        StructFieldInit(struct_field_init) => return false;
        ArenaNewExpr(arena_new) => return false;
        TryExpr(try_expr_node) => return false;
        ComptimeExpr(comptime_expr_node) => return false;
        Block(block) => return false;
        If(if_node) => return false;
        Assign(assign_node) => return false;
        Return(return_node) => return false;
        ExprStmt(expr_stmt) => return false;
        While(while_node) => return false;
        For(for_node) => return false;
        Break(break_node) => return false;
        Continue(continue_node) => return false;
        Param(param_node) => return false;
        Field(field_node) => return false;
        UnionVariant(union_variant) => return false;
        Match(match_node) => return false;
        MatchArm(match_arm) => return false;
        Unsafe(unsafe_node) => return false;
        ComptimeIf(comptime_if_node) => return false;
    }
}

fn statement_let_name(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        Let(let_node) => return let_node.name;
        Program(program) => return node_id;
        Empty => return node_id;
        ImportDecl(import_decl) => return node_id;
        StructDecl(struct_decl) => return node_id;
        EnumDecl(enum_decl) => return node_id;
        UnionDecl(union_decl) => return node_id;
        FnDecl(fn_decl) => return node_id;
        Int(int_node) => return node_id;
        String(string_node) => return node_id;
        TypeName(type_name) => return node_id;
        Var(var_node) => return node_id;
        Bool(bool_node) => return node_id;
        Prefix(prefix_node) => return node_id;
        Binary(binary) => return node_id;
        FieldExpr(field_expr_node) => return node_id;
        DerefExpr(deref_expr_node) => return node_id;
        Call(call_node) => return node_id;
        TypeApplyExpr(type_apply) => return node_id;
        CastExpr(cast_expr) => return node_id;
        IndexExpr(index_expr) => return node_id;
        StructLiteralExpr(struct_literal) => return node_id;
        StructFieldInit(struct_field_init) => return node_id;
        ArenaNewExpr(arena_new) => return node_id;
        TryExpr(try_expr_node) => return node_id;
        ComptimeExpr(comptime_expr_node) => return node_id;
        Block(block) => return node_id;
        If(if_node) => return node_id;
        Assign(assign_node) => return node_id;
        Return(return_node) => return node_id;
        ExprStmt(expr_stmt) => return node_id;
        While(while_node) => return node_id;
        For(for_node) => return node_id;
        Break(break_node) => return node_id;
        Continue(continue_node) => return node_id;
        Param(param_node) => return node_id;
        Field(field_node) => return node_id;
        UnionVariant(union_variant) => return node_id;
        Match(match_node) => return node_id;
        MatchArm(match_arm) => return node_id;
        Unsafe(unsafe_node) => return node_id;
        ComptimeIf(comptime_if_node) => return node_id;
    }
}

fn statement_let_value(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        Let(let_node) => return let_node.value;
        Program(program) => return node_id;
        Empty => return node_id;
        ImportDecl(import_decl) => return node_id;
        StructDecl(struct_decl) => return node_id;
        EnumDecl(enum_decl) => return node_id;
        UnionDecl(union_decl) => return node_id;
        FnDecl(fn_decl) => return node_id;
        Int(int_node) => return node_id;
        String(string_node) => return node_id;
        TypeName(type_name) => return node_id;
        Var(var_node) => return node_id;
        Bool(bool_node) => return node_id;
        Prefix(prefix_node) => return node_id;
        Binary(binary) => return node_id;
        FieldExpr(field_expr_node) => return node_id;
        DerefExpr(deref_expr_node) => return node_id;
        Call(call_node) => return node_id;
        TypeApplyExpr(type_apply) => return node_id;
        CastExpr(cast_expr) => return node_id;
        IndexExpr(index_expr) => return node_id;
        StructLiteralExpr(struct_literal) => return node_id;
        StructFieldInit(struct_field_init) => return node_id;
        ArenaNewExpr(arena_new) => return node_id;
        TryExpr(try_expr_node) => return node_id;
        ComptimeExpr(comptime_expr_node) => return node_id;
        Block(block) => return node_id;
        If(if_node) => return node_id;
        Assign(assign_node) => return node_id;
        Return(return_node) => return node_id;
        ExprStmt(expr_stmt) => return node_id;
        While(while_node) => return node_id;
        For(for_node) => return node_id;
        Break(break_node) => return node_id;
        Continue(continue_node) => return node_id;
        Param(param_node) => return node_id;
        Field(field_node) => return node_id;
        UnionVariant(union_variant) => return node_id;
        Match(match_node) => return node_id;
        MatchArm(match_arm) => return node_id;
        Unsafe(unsafe_node) => return node_id;
        ComptimeIf(comptime_if_node) => return node_id;
    }
}

fn check_function_params(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange
) -> !OwnershipSummary {
    var summary = ownership_summary(0, 0, 0, 0);
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        let node = ast.get(child);
        match node.data {
            Program(program) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Param(param_node) => summary = merge_ownership_summaries(
                summary,
                try declare_param_resource(file, ast, param_node.name, param_node.type_node)
            );
            Empty => summary = merge_ownership_summaries(summary, ownership_summary(0, 0, 0, 0));
            ImportDecl(import_decl) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            StructDecl(struct_decl) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            EnumDecl(enum_decl) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            UnionDecl(union_decl) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            FnDecl(fn_decl) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Int(int_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            String(string_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            TypeName(type_name) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Var(var_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Bool(bool_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Prefix(prefix_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Binary(binary) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            FieldExpr(field_expr_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            DerefExpr(deref_expr_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Call(call_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            TypeApplyExpr(type_apply) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            CastExpr(cast_expr) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            IndexExpr(index_expr) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            StructLiteralExpr(struct_literal) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            StructFieldInit(struct_field_init) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            ArenaNewExpr(arena_new) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            TryExpr(try_expr_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            ComptimeExpr(comptime_expr_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Block(block) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            If(if_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Let(let_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Assign(assign_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Return(return_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            ExprStmt(expr_stmt) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            While(while_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            For(for_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Break(break_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Continue(continue_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Field(field_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            UnionVariant(union_variant) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Match(match_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            MatchArm(match_arm) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            Unsafe(unsafe_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
            ComptimeIf(comptime_if_node) => summary = merge_ownership_summaries(summary, ownership_summary(0, 1, 0, 0));
        }
        index = index + 1;
    }
    return summary;
}

fn check_function_body(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    let node = ast.get(body);
    match node.data {
        Program(program) => return ownership_summary(0, 1, 0, 0);
        Block(block) => return check_ownership_statement_range(
            allocator,
            file,
            ast,
            block.statements
        );
        Empty => return ownership_summary(0, 0, 0, 0);
        ImportDecl(import_decl) => return ownership_summary(0, 1, 0, 0);
        StructDecl(struct_decl) => return ownership_summary(0, 1, 0, 0);
        EnumDecl(enum_decl) => return ownership_summary(0, 1, 0, 0);
        UnionDecl(union_decl) => return ownership_summary(0, 1, 0, 0);
        FnDecl(fn_decl) => return ownership_summary(0, 1, 0, 0);
        Int(int_node) => return ownership_summary(0, 1, 0, 0);
        String(string_node) => return ownership_summary(0, 1, 0, 0);
        TypeName(type_name) => return ownership_summary(0, 1, 0, 0);
        Var(var_node) => return ownership_summary(0, 1, 0, 0);
        Bool(bool_node) => return ownership_summary(0, 1, 0, 0);
        Prefix(prefix_node) => return check_ownership_ast_node(allocator, file, ast, prefix_node.right);
        Binary(binary) => return merge_ownership_summaries(
            try check_ownership_ast_node(allocator, file, ast, binary.left),
            try check_ownership_ast_node(allocator, file, ast, binary.right)
        );
        FieldExpr(field_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            field_expr_node.receiver
        );
        DerefExpr(deref_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            deref_expr_node.receiver
        );
        Call(call_node) => return check_ownership_call(allocator, file, ast, call_node.callee, call_node.args);
        TypeApplyExpr(type_apply) => return check_ownership_range_with_head(
            allocator,
            file,
            ast,
            type_apply.callee,
            type_apply.type_args
        );
        CastExpr(cast_expr) => return check_ownership_ast_node(allocator, file, ast, cast_expr.value);
        IndexExpr(index_expr) => return check_ownership_index(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end
        );
        StructLiteralExpr(struct_literal) => return check_ownership_range_with_head(
            allocator,
            file,
            ast,
            struct_literal.type_name,
            struct_literal.fields
        );
        StructFieldInit(struct_field_init) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            struct_field_init.value
        );
        ArenaNewExpr(arena_new) => return ownership_summary(0, 1, 0, 0);
        TryExpr(try_expr_node) => return check_ownership_ast_node(allocator, file, ast, try_expr_node.value);
        ComptimeExpr(comptime_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            comptime_expr_node.value
        );
        If(if_node) => return check_ownership_if(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block
        );
        Let(let_node) => return check_let_ownership(
            allocator,
            file,
            ast,
            let_node.name,
            let_node.value
        );
        Assign(assign_node) => return merge_ownership_summaries(
            try check_ownership_ast_node(allocator, file, ast, assign_node.target),
            try check_ownership_ast_node(allocator, file, ast, assign_node.value)
        );
        Return(return_node) => return check_ownership_ast_node(allocator, file, ast, return_node.value);
        ExprStmt(expr_stmt) => return check_ownership_ast_node(allocator, file, ast, expr_stmt.expr);
        While(while_node) => return check_ownership_loop(allocator, file, ast, while_node.condition, while_node.body);
        For(for_node) => return check_ownership_for_node(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body
        );
        Break(break_node) => return ownership_summary(0, 1, 0, 0);
        Continue(continue_node) => return ownership_summary(0, 1, 0, 0);
        Param(param_node) => return ownership_summary(0, 1, 0, 0);
        Field(field_node) => return ownership_summary(0, 1, 0, 0);
        UnionVariant(union_variant) => return ownership_summary(0, 1, 0, 0);
        Match(match_node) => return check_ownership_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms
        );
        MatchArm(match_arm) => return check_function_body(allocator, file, ast, match_arm.body);
        Unsafe(unsafe_node) => return check_function_body(allocator, file, ast, unsafe_node.body);
        ComptimeIf(comptime_if_node) => return check_ownership_comptime_if(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block
        );
    }
}

fn check_ownership_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !OwnershipSummary {
    var summary = ownership_summary(0, 1, 0, 0);
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        summary = merge_ownership_summaries(
            summary,
            try check_function_body(allocator, file, ast, child)
        );
        index = index + 1;
    }
    return summary;
}

fn check_let_ownership(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    let kind = try initializer_resource_kind(file, ast, value);
    var borrows = 0;
    if kind == ResourceKind::BorrowedView {
        borrows = 1;
    }
    var summary = ownership_summary(1, 1, borrows, 0);
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, value));
    return summary;
}

fn check_for_ownership(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    var summary = ownership_summary(1, 1, 0, 0);
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, start));
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, end));
    summary = merge_ownership_summaries(summary, try check_function_body(allocator, file, ast, body));
    return summary;
}

fn check_match_ownership(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange
) -> !OwnershipSummary {
    var summary = try check_ownership_ast_node(allocator, file, ast, value);
    var index = 0;
    while index < arms.len {
        let child = try ast.child_at(arms, index);
        summary = merge_ownership_summaries(
            summary,
            try check_match_arm_ownership(allocator, file, ast, child)
        );
        index = index + 1;
    }
    return summary;
}

fn check_match_arm_ownership(
    allocator: Allocator,
