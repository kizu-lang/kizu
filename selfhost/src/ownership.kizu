fn field_call_borrow_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    namespace: bool
) -> []const u8 {
    if is_as_bytes_method(file, ast, name, namespace) {
        return borrow_target_name(file, ast, receiver);
    }
    return "";
}

fn initializer_borrow_mutable(
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(value);
    match node.data {
        Prefix(prefix_node) => return prefix_node.op == std::kizu::ast::prefix_mut_borrow();
        TryExpr(try_expr_node) => return initializer_borrow_mutable(ast, try_expr_node.value);
        Program(program) => return false;
        FnDecl(fn_decl) => return false;
        Empty => return false;
        Int(int_node) => return false;
        String(string_node) => return false;
        TypeName(type_name) => return false;
        Var(var_node) => return false;
        Bool(bool_node) => return false;
        Binary(binary) => return false;
        FieldExpr(field_expr_node) => return false;
        DerefExpr(deref_expr_node) => return false;
        Call(call_node) => return false;
        TypeApplyExpr(type_apply) => return false;
        CastExpr(cast_expr) => return false;
        IndexExpr(index_expr) => return false;
        StructLiteralExpr(struct_literal) => return false;
        StructFieldInit(struct_field_init) => return false;
        ArenaNewExpr(arena_new) => return false;
        ComptimeExpr(comptime_expr_node) => return false;
        Block(block) => return false;
        If(if_node) => return false;
        Let(let_node) => return false;
        Assign(assign_node) => return false;
        Return(return_node) => return false;
        ExprStmt(expr_stmt) => return false;
        While(while_node) => return false;
        For(for_node) => return false;
        Break(break_node) => return false;
        Continue(continue_node) => return false;
        ImportDecl(import_decl) => return false;
        Param(param_node) => return false;
        Field(field_node) => return false;
        StructDecl(struct_decl) => return false;
        EnumDecl(enum_decl) => return false;
        UnionDecl(union_decl) => return false;
        UnionVariant(union_variant) => return false;
        Match(match_node) => return false;
        MatchArm(match_arm) => return false;
        Unsafe(unsafe_node) => return false;
        ComptimeIf(comptime_if_node) => return false;
    }
}

fn is_as_bytes_method(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    namespace: bool
) -> bool {
    if namespace {
        return false;
    }
    return std::mem::equal_bytes(ast_node_text(file, ast, name), "as_bytes");
}

fn resource_kind_moves(kind: ResourceKind) -> bool {
    if kind == ResourceKind::Array or kind == ResourceKind::Map or kind == ResourceKind::String {
        return true;
    }
    if kind == ResourceKind::Arena or kind == ResourceKind::Handle {
        return true;
    }
    return false;
}

fn resource_kind_for_type(type_text: []const u8) -> ResourceKind {
    if resource_text_is_borrowed(type_text) {
        return ResourceKind::BorrowedView;
    }
    return resource_kind_for_text(type_text);
}

fn resource_text_is_borrowed(text: []const u8) -> bool {
    return std::mem::starts_with(text, "&") or
        std::mem::starts_with(text, "[]") or
        bytes_contains(text, ": &") or
        bytes_contains(text, ": []");
}

fn initializer_resource_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> !ResourceKind {
    let node = ast.get(value);
    match node.data {
        Prefix(prefix_node) => return prefix_initializer_kind(prefix_node.op);
        Call(call_node) => return call_initializer_kind(file, ast, call_node.callee);
        TryExpr(try_expr_node) => return try initializer_resource_kind(file, ast, try_expr_node.value);
        ArenaNewExpr(arena_new) => return ResourceKind::Arena;
        Var(var_node) => return ResourceKind::Value;
        Program(program) => return ResourceKind::Value;
        FnDecl(fn_decl) => return ResourceKind::Value;
        Empty => return ResourceKind::Value;
        Int(int_node) => return ResourceKind::Value;
        String(string_node) => return ResourceKind::Value;
        TypeName(type_name) => return ResourceKind::Value;
        Bool(bool_node) => return ResourceKind::Value;
        Binary(binary) => return ResourceKind::Value;
        FieldExpr(field_expr_node) => return ResourceKind::Value;
        DerefExpr(deref_expr_node) => return ResourceKind::Value;
        TypeApplyExpr(type_apply) => return ResourceKind::Value;
        CastExpr(cast_expr) => return ResourceKind::Value;
        IndexExpr(index_expr) => return ResourceKind::Value;
        StructLiteralExpr(struct_literal) => return ResourceKind::Value;
        StructFieldInit(struct_field_init) => return ResourceKind::Value;
        ComptimeExpr(comptime_expr_node) => return ResourceKind::Value;
        Block(block) => return ResourceKind::Value;
        If(if_node) => return ResourceKind::Value;
        Let(let_node) => return ResourceKind::Value;
        Assign(assign_node) => return ResourceKind::Value;
        Return(return_node) => return ResourceKind::Value;
        ExprStmt(expr_stmt) => return ResourceKind::Value;
        While(while_node) => return ResourceKind::Value;
        For(for_node) => return ResourceKind::Value;
        Break(break_node) => return ResourceKind::Value;
        Continue(continue_node) => return ResourceKind::Value;
        ImportDecl(import_decl) => return ResourceKind::Value;
        Param(param_node) => return ResourceKind::Value;
        Field(field_node) => return ResourceKind::Value;
        StructDecl(struct_decl) => return ResourceKind::Value;
        EnumDecl(enum_decl) => return ResourceKind::Value;
        UnionDecl(union_decl) => return ResourceKind::Value;
        UnionVariant(union_variant) => return ResourceKind::Value;
        Match(match_node) => return ResourceKind::Value;
        MatchArm(match_arm) => return ResourceKind::Value;
        Unsafe(unsafe_node) => return ResourceKind::Value;
        ComptimeIf(comptime_if_node) => return ResourceKind::Value;
    }
}

fn resource_kind_for_text(text: []const u8) -> ResourceKind {
    // Text fallback is closed to owned constructors; borrow and move checks use AST/state.
    if std::mem::starts_with(text, "std::array::Array<") {
        return ResourceKind::Array;
    }
    if std::mem::starts_with(text, "std::map::Map<") {
        return ResourceKind::Map;
    }
    if std::mem::starts_with(text, "std::string::String") {
        return ResourceKind::String;
    }
    if std::mem::starts_with(text, "arena<") {
        return ResourceKind::Arena;
    }
    if std::mem::starts_with(text, "handle<") {
        return ResourceKind::Handle;
    }
    return ResourceKind::Value;
}

fn check_ownership_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !OwnershipSummary {
    var summary = ownership_summary(0, 1, 0, 0);
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        summary = merge_ownership_summaries(
            summary,
            try check_ownership_ast_node(allocator, file, ast, child)
        );
        index = index + 1;
    }
    return summary;
}

fn check_ownership_range_with_head(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    head: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange
) -> !OwnershipSummary {
    var summary = try check_ownership_ast_node(allocator, file, ast, head);
    summary = merge_ownership_summaries(
        summary,
        try check_ownership_range(allocator, file, ast, range)
    );
    return summary;
}

fn check_ownership_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !OwnershipSummary {
    return check_ownership_range_with_head(allocator, file, ast, callee, args);
}

fn check_ownership_index(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    var summary = try check_ownership_ast_node(allocator, file, ast, target);
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, start));
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, end));
    return summary;
}

fn check_ownership_if(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    var summary = try check_ownership_ast_node(allocator, file, ast, condition);
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, then_block));
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, else_block));
    return summary;
}

fn check_ownership_comptime_if(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    var summary = try check_ownership_ast_node(allocator, file, ast, condition);
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, then_block));
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, else_block));
    return summary;
}

fn check_ownership_loop(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    var summary = try check_ownership_ast_node(allocator, file, ast, condition);
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, body));
    return summary;
}

fn check_ownership_for_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    var summary = try check_ownership_ast_node(allocator, file, ast, start);
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, end));
    summary = merge_ownership_summaries(summary, try check_ownership_ast_node(allocator, file, ast, body));
    return summary;
}

fn check_ownership_match(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange
) -> !OwnershipSummary {
    var summary = try check_ownership_ast_node(allocator, file, ast, value);
    summary = merge_ownership_summaries(
        summary,
        try check_ownership_range(allocator, file, ast, arms)
    );
    return summary;
}

fn merge_ownership_summaries(left: OwnershipSummary, right: OwnershipSummary) -> OwnershipSummary {
    return ownership_summary(
        left.resources + right.resources,
        left.checked_nodes + right.checked_nodes,
        left.borrows + right.borrows,
        left.errors + right.errors
    );
}

fn ownership_summary(
    resources: i64,
    checked_nodes: i64,
    borrows: i64,
    errors: i64
) -> OwnershipSummary {
    return OwnershipSummary {
        resources: resources,
        checked_nodes: checked_nodes,
        borrows: borrows,
        errors: errors
    };
}

fn token_text(
    source_text: []const u8,
    token: std::kizu::lexer::Token
) -> []const u8 {
    return source_text[token.start..token.end];
}

fn ast_node_text(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []const u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(file.text[span.start..span.end]);
}

fn bytes_contains(haystack: []const u8, needle: []const u8) -> bool {
    let needle_len = std::mem::len(needle);
    if needle_len < 1 {
        return true;
    }
    if needle_len > std::mem::len(haystack) {
        return false;
    }
    var index = 0;
    while index + needle_len <= std::mem::len(haystack) {
        if std::mem::equal_bytes(haystack[index..index + needle_len], needle) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

pub fn use_after_move(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "use after move");
}

pub fn mutable_alias(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "mutable alias");
}

pub fn dangling_borrow(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "dangling borrow");
}

pub fn deinit_while_borrowed(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "deinit while borrowed");
}

fn make_diagnostic(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64,
    message: []const u8
) -> std::kizu::diagnostic::Diagnostic {
    let primary = make_span(path, byte_start, byte_end);
    return std::kizu::diagnostic::Diagnostic(allocator, primary, message);
}

fn make_span(
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::FileSpan {
    return std::kizu::diagnostic::file_span(0, path, byte_start, byte_end, 1, byte_start + 1);
}
