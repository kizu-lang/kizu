// Module: ownership checker boundary for the future self-host compiler.

pub enum AccessKind {
    Owned
    Moved
    SharedBorrowed
    MutBorrowed
}

pub struct ValueState {
    pub kind: AccessKind;
    pub copyable: bool;
}

pub struct Transition {
    pub allowed: bool;
    pub next: ValueState;
    pub diagnostic: []const u8;
}

// owned constructs the initial state for one local value.
pub fn owned(copyable: bool) -> ValueState {
    return ValueState {
        kind: AccessKind::Owned,
        copyable: copyable,
    };
}

// use_value validates a read without changing the ownership state.
pub fn use_value(state: &ValueState) -> Transition {
    if state.kind == AccessKind::Moved {
        return reject(state, "ownership error: moved value used");
    }
    return accept(state);
}

// move_value validates a move and invalidates non-copy values.
pub fn move_value(state: &ValueState) -> Transition {
    if state.kind == AccessKind::Moved {
        return reject(state, "ownership error: double move");
    }
    if state.kind == AccessKind::SharedBorrowed {
        return reject(state, "borrow error: value cannot be moved while borrowed");
    }
    if state.kind == AccessKind::MutBorrowed {
        return reject(state, "borrow error: value cannot be moved while mutably borrowed");
    }
    if state.copyable {
        return accept(state);
    }
    return Transition {
        allowed: true,
        next: ValueState {
            kind: AccessKind::Moved,
            copyable: state.copyable,
        },
        diagnostic: "",
    };
}

// borrow_shared validates a shared borrow transition.
pub fn borrow_shared(state: &ValueState) -> Transition {
    if state.kind == AccessKind::Moved {
        return reject(state, "borrow error: moved value cannot be borrowed");
    }
    if state.kind == AccessKind::MutBorrowed {
        return reject(state, "borrow error: value is already mutably borrowed");
    }
    return Transition {
        allowed: true,
        next: ValueState {
            kind: AccessKind::SharedBorrowed,
            copyable: state.copyable,
        },
        diagnostic: "",
    };
}

// borrow_mut validates a mutable borrow transition.
pub fn borrow_mut(state: &ValueState) -> Transition {
    if state.kind == AccessKind::Moved {
        return reject(state, "borrow error: moved value cannot be mutably borrowed");
    }
    if state.kind == AccessKind::SharedBorrowed {
        return reject(state, "borrow error: value is already borrowed");
    }
    if state.kind == AccessKind::MutBorrowed {
        return reject(state, "borrow error: value is already mutably borrowed");
    }
    return Transition {
        allowed: true,
        next: ValueState {
            kind: AccessKind::MutBorrowed,
            copyable: state.copyable,
        },
        diagnostic: "",
    };
}

// end_borrow restores a borrowed value to owned state.
pub fn end_borrow(state: &ValueState) -> ValueState {
    if state.kind == AccessKind::SharedBorrowed {
        return owned(state.copyable);
    }
    if state.kind == AccessKind::MutBorrowed {
        return owned(state.copyable);
    }
    return ValueState {
        kind: state.kind,
        copyable: state.copyable,
    };
}

// accept preserves the current state and returns an allowed transition.
fn accept(state: &ValueState) -> Transition {
    return Transition {
        allowed: true,
        next: ValueState {
            kind: state.kind,
            copyable: state.copyable,
        },
        diagnostic: "",
    };
}

// reject preserves the current state and returns a diagnostic reason.
fn reject(state: &ValueState, diagnostic: []const u8) -> Transition {
    return Transition {
        allowed: false,
        next: ValueState {
            kind: state.kind,
            copyable: state.copyable,
        },
        diagnostic: diagnostic,
    };
}

// ready exposes the ownership module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
