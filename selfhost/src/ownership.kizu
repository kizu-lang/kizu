import selfhost::lexer;
import selfhost::source;
import selfhost::types;

pub enum ResourceKind {
    Value
    Array
    Map
    String
    Arena
    Handle
    BorrowedView
}

pub enum OwnershipState {
    Available
    Moved
    SharedBorrowed
    MutBorrowed
    Deinitialized
}

pub struct OwnershipSummary {
    pub resources: i64;
    pub checked_nodes: i64;
    pub borrows: i64;
    pub errors: i64;
}

pub fn check(typed: types::TypeSummary) -> OwnershipSummary {
    return OwnershipSummary {
        resources: typed.symbols,
        checked_nodes: typed.typed_nodes,
        borrows: 0,
        errors: typed.diagnostics
    };
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: types::TypeSummary
) -> !OwnershipSummary {
    var summary = ownership_summary(typed.symbols, typed.typed_nodes, 0, typed.diagnostics);
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind != source::SourceKind::User {
            var tokens = try lexer::tokenize(allocator, file.text);
            summary = merge_ownership_summaries(
                summary,
                try scan_file_ownership(file, tokens)
            );
            tokens.deinit();
        }
        index = index + 1;
    }
    return summary;
}

pub fn declare_resource(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    kinds: &mut std::map::Map<[]const u8, ResourceKind>,
    name: []const u8,
    kind: ResourceKind
) -> !void {
    if states.contains(name) {
        return error("duplicate resource");
    }
    try states.insert(name, OwnershipState::Available);
    try kinds.insert(name, kind);
    return;
}

pub fn move_value(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("move requires available value");
    }
    try states.insert(name, OwnershipState::Moved);
    return;
}

pub fn shared_borrow(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state == OwnershipState::MutBorrowed or state == OwnershipState::Moved {
        return error("shared borrow blocked");
    }
    if state == OwnershipState::Deinitialized {
        return error("borrow after deinit");
    }
    try states.insert(name, OwnershipState::SharedBorrowed);
    return;
}

pub fn mut_borrow(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("mutable borrow requires available value");
    }
    try states.insert(name, OwnershipState::MutBorrowed);
    return;
}

pub fn release_borrow(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state == OwnershipState::SharedBorrowed or state == OwnershipState::MutBorrowed {
        try states.insert(name, OwnershipState::Available);
        return;
    }
    return error("release requires active borrow");
}

pub fn deinit_resource(
    states: &mut std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("deinit requires available value");
    }
    try states.insert(name, OwnershipState::Deinitialized);
    return;
}

pub fn state_of(
    states: &std::map::Map<[]const u8, OwnershipState>,
    name: []const u8
) -> !OwnershipState {
    return states.get(name);
}

pub fn kind_of(
    kinds: &std::map::Map<[]const u8, ResourceKind>,
    name: []const u8
) -> !ResourceKind {
    return kinds.get(name);
}

pub fn summarize(
    states: &std::map::Map<[]const u8, OwnershipState>,
    borrows: i64,
    errors: i64
) -> OwnershipSummary {
    return ownership_summary(states.len(), states.len(), borrows, errors);
}

fn scan_file_ownership(
    file: &source::SourceFile,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !OwnershipSummary {
    var resources = 0;
    var checked_nodes = 0;
    var borrows = 0;
    var index = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        let text = token_text(file.text, token);
        resources = resources + ownership_resource_token_count(text);
        checked_nodes = checked_nodes + ownership_checked_token_count(text);
        borrows = borrows + ownership_borrow_token_count(text);
        index = index + 1;
    }
    return ownership_summary(resources, checked_nodes, borrows, 0);
}

fn ownership_resource_token_count(text: []const u8) -> i64 {
    if std::mem::equal_bytes(text, "let") or std::mem::equal_bytes(text, "var") {
        return 1;
    }
    if std::mem::equal_bytes(text, "Array") or
        std::mem::equal_bytes(text, "Map") or
        std::mem::equal_bytes(text, "String") or
        std::mem::equal_bytes(text, "Box") or
        std::mem::equal_bytes(text, "arena") or
        std::mem::equal_bytes(text, "handle") {
        return 1;
    }
    return 0;
}

fn ownership_checked_token_count(text: []const u8) -> i64 {
    if ownership_resource_token_count(text) > 0 {
        return 1;
    }
    if std::mem::equal_bytes(text, "return") or
        std::mem::equal_bytes(text, "=") or
        std::mem::equal_bytes(text, "try") or
        std::mem::equal_bytes(text, "match") or
        std::mem::equal_bytes(text, "if") or
        std::mem::equal_bytes(text, "while") or
        std::mem::equal_bytes(text, "for") {
        return 1;
    }
    return ownership_borrow_token_count(text);
}

fn ownership_borrow_token_count(text: []const u8) -> i64 {
    if std::mem::equal_bytes(text, "&") or
        std::mem::equal_bytes(text, "at") or
        std::mem::equal_bytes(text, "at_mut") or
        std::mem::equal_bytes(text, "as_bytes") or
        std::mem::equal_bytes(text, "borrow") or
        std::mem::equal_bytes(text, "borrow_mut") {
        return 1;
    }
    return 0;
}

fn merge_ownership_summaries(left: OwnershipSummary, right: OwnershipSummary) -> OwnershipSummary {
    return ownership_summary(
        left.resources + right.resources,
        left.checked_nodes + right.checked_nodes,
        left.borrows + right.borrows,
        left.errors + right.errors
    );
}

fn ownership_summary(
    resources: i64,
    checked_nodes: i64,
    borrows: i64,
    errors: i64
) -> OwnershipSummary {
    return OwnershipSummary {
        resources: resources,
        checked_nodes: checked_nodes,
        borrows: borrows,
        errors: errors
    };
}

fn token_text(
    source_text: []const u8,
    token: std::kizu::lexer::Token
) -> []const u8 {
    return source_text[token.start..token.end];
}

pub fn use_after_move(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "use after move");
}

pub fn mutable_alias(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "mutable alias");
}

pub fn dangling_borrow(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "dangling borrow");
}

pub fn deinit_while_borrowed(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "deinit while borrowed");
}

fn make_diagnostic(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64,
    message: []const u8
) -> std::kizu::diagnostic::Diagnostic {
    let primary = make_span(path, byte_start, byte_end);
    return std::kizu::diagnostic::Diagnostic(allocator, primary, message);
}

fn make_span(
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::FileSpan {
    return std::kizu::diagnostic::file_span(0, path, byte_start, byte_end, 1, byte_start + 1);
}
