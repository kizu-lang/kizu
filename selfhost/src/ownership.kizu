fn prefix_borrow_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    op: std::kizu::ast::PrefixOp,
    right: std::kizu::ast::NodeId
) -> []const u8 {
    if op == std::kizu::ast::prefix_borrow() or op == std::kizu::ast::prefix_mut_borrow() {
        return borrow_target_name(file, ast, right);
    }
    return "";
}

