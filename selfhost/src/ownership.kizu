import selfhost::parser;
import selfhost::source;
import selfhost::types;

pub enum ResourceKind {
    Value,
    Record,
    Array,
    Map,
    String,
    Arena,
    Handle,
    BorrowedView,
}

pub enum OwnershipState {
    Available,
    Moved,
    SharedBorrowed,
    MutBorrowed,
    Deinitialized,
}

pub struct OwnershipSummary {
    pub resources: i64,
    pub checked_nodes: i64,
    pub borrows: i64,
    pub errors: i64,
}

pub struct CheckedModuleRef {
    pub source_id: i64,
    pub kind: source::SourceKind,
    pub path: []u8,
}

pub struct CheckedFunctionRef {
    pub module: []u8,
    pub name: []u8,
    pub span_start: i64,
    pub span_end: i64,
}

pub struct OwnershipFact {
    pub name: []u8,
    pub kind: ResourceKind,
    pub state: OwnershipState,
}

pub struct CheckedPackage {
    pub diagnostics: i64,
    pub resources: i64,
    pub checked_nodes: i64,
    pub borrows: i64,
    pub module: CheckedModuleRef,
    pub entry_function: CheckedFunctionRef,
    pub root_fact: OwnershipFact,
    pub summary: OwnershipSummary,
}

pub fn check(typed: types::TypeSummary) -> OwnershipSummary {
    return OwnershipSummary {
        resources: typed.symbols,
        checked_nodes: typed.typed_nodes,
        borrows: 0,
        errors: typed.diagnostics
    };
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: types::TypeSummary
) -> !OwnershipSummary {
    let checked = try check_package(allocator, files, typed);
    return summary_of(checked);
}

pub fn first_use_after_move_name(
    allocator: Allocator,
    path: []u8,
    text: []u8
) -> ![]u8 {
    let file = source::SourceFile {
        id: 0,
        kind: source::SourceKind::User,
        path: path,
        text: text
    };
    let result = try parser::parse_checked_file(allocator, file.path, file.text);
    let name = try first_use_after_move_ast_node(allocator, &file, result.ast, result.root);
    result.deinit();
    return name;
}

pub fn check_package(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: types::TypeSummary
) -> !CheckedPackage {
    let summary = try check_source_summary(allocator, files, typed);
    let module = try first_checked_module(files);
    return checked_package_from_refs(
        summary,
        module,
        entry_function_ref(),
        package_root_fact()
    );
}

pub fn checked_package_from_summary(summary: OwnershipSummary) -> CheckedPackage {
    return checked_package_from_refs(
        summary,
        CheckedModuleRef {
            source_id: 0,
            kind: source::SourceKind::User,
            path: "selfhost/smoke.kizu"
        },
        entry_function_ref(),
        package_root_fact()
    );
}

pub fn summary_of(checked: &CheckedPackage) -> OwnershipSummary {
    return ownership_summary(
        checked.resources,
        checked.checked_nodes,
        checked.borrows,
        checked.diagnostics
    );
}

fn first_use_after_move_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ![]u8 {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try first_use_after_move_in_decl_range(
            allocator,
            file,
            ast,
            program.declarations
        ),
        FnDecl(fn_decl) => try first_use_after_move_in_function(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.body
        ),
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        Empty => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Var(var_node) => "",
        Bool(bool_node) => "",
        Prefix(prefix_node) => "",
        Binary(binary) => "",
        FieldExpr(field_expr_node) => "",
        DerefExpr(deref_expr_node) => "",
        Call(call_node) => "",
        TypeApplyExpr(type_apply) => "",
        CastExpr(cast_expr) => "",
        IndexExpr(index_expr) => "",
        StructLiteralExpr(struct_literal) => "",
        StructFieldInit(struct_field_init) => "",
        ArenaNewExpr(arena_new) => "",
        TryExpr(try_expr_node) => "",
        ComptimeExpr(comptime_expr_node) => "",
        Block(block) => "",
        If(if_node) => "",
        Let(let_node) => "",
        Assign(assign_node) => "",
        Return(return_node) => "",
        Defer(defer_node) => "",
        ExprStmt(expr_stmt) => "",
        While(while_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn first_use_after_move_in_decl_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> ![]u8 {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let name = try first_use_after_move_ast_node(allocator, file, ast, child);
        if !std::mem::equal_bytes(name, "") {
            return name;
        }
        index = index + 1;
    }
    return "";
}

fn first_use_after_move_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId
) -> ![]u8 {
    var states = std::map::Map<[]u8, OwnershipState>(allocator);
    var kinds = std::map::Map<[]u8, ResourceKind>(allocator);
    var param_index = 0;
    while param_index < params.len {
        let param_child = try ast.child_at(params, param_index);
        let param_name = param_binding_name(file, ast, param_child);
        if !std::mem::equal_bytes(param_name, "") {
            try declare_resource(states, kinds, param_name, param_resource_kind(file, ast, param_child));
        }
        param_index = param_index + 1;
    }

    var result = "";
    let statements = function_body_statements(ast, body);
    var statement_index = 0;
    while statement_index < statements.len and std::mem::equal_bytes(result, "") {
        let statement = try ast.child_at(statements, statement_index);
        result = try first_use_after_move_statement(
            file,
            ast,
            statement,
            states,
            kinds
        );
        statement_index = statement_index + 1;
    }
    states.deinit();
    kinds.deinit();
    return result;
}

fn first_use_after_move_statement(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statement: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>
) -> ![]u8 {
    let node = ast.get(statement);
    return match node.data {
        Let(let_node) => try first_use_after_move_let(
            file,
            ast,
            let_node.name,
            let_node.value,
            states,
            kinds
        ),
        ExprStmt(expr_stmt) => try first_use_after_move_expr(
            file,
            ast,
            expr_stmt.expr,
            states,
            kinds,
            false
        ),
        Assign(assign_node) => try first_use_after_move_expr(
            file,
            ast,
            assign_node.value,
            states,
            kinds,
            false
        ),
        Return(return_node) => try first_use_after_move_expr(
            file,
            ast,
            return_node.value,
            states,
            kinds,
            false
        ),
        Defer(defer_node) => try first_use_after_move_expr(
            file,
            ast,
            defer_node.expr,
            states,
            kinds,
            false
        ),
        Block(block) => try first_use_after_move_statement_range(
            file,
            ast,
            block.statements,
            states,
            kinds
        ),
        If(if_node) => try first_use_after_move_if(
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            states,
            kinds
        ),
        While(while_node) => try first_use_after_move_if(
            file,
            ast,
            while_node.condition,
            while_node.body,
            ast.add_empty(0),
            states,
            kinds
        ),
        Program(program) => "",
        FnDecl(fn_decl) => "",
        Empty => "",
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Var(var_node) => "",
        Bool(bool_node) => "",
        Prefix(prefix_node) => "",
        Binary(binary) => "",
        FieldExpr(field_expr_node) => "",
        DerefExpr(deref_expr_node) => "",
        Call(call_node) => "",
        TypeApplyExpr(type_apply) => "",
        CastExpr(cast_expr) => "",
        IndexExpr(index_expr) => "",
        StructLiteralExpr(struct_literal) => "",
        StructFieldInit(struct_field_init) => "",
        ArenaNewExpr(arena_new) => "",
        TryExpr(try_expr_node) => "",
        ComptimeExpr(comptime_expr_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn first_use_after_move_statement_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>
) -> ![]u8 {
    var index = 0;
    while index < range.len {
        let statement = try ast.child_at(range, index);
        let name = try first_use_after_move_statement(file, ast, statement, states, kinds);
        if !std::mem::equal_bytes(name, "") {
            return name;
        }
        index = index + 1;
    }
    return "";
}

fn first_use_after_move_if(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>
) -> ![]u8 {
    let condition_name = try first_use_after_move_expr(file, ast, condition, states, kinds, false);
    if !std::mem::equal_bytes(condition_name, "") {
        return condition_name;
    }
    let then_name = try first_use_after_move_statement(file, ast, then_block, states, kinds);
    if !std::mem::equal_bytes(then_name, "") {
        return then_name;
    }
    return try first_use_after_move_statement(file, ast, else_block, states, kinds);
}

fn first_use_after_move_let(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>
) -> ![]u8 {
    let used = try first_use_after_move_expr(file, ast, value, states, kinds, true);
    if !std::mem::equal_bytes(used, "") {
        return used;
    }
    let name_text = ast_node_text(file, ast, name);
    if !std::mem::equal_bytes(name_text, "") and !states.contains(name_text) {
        let kind = try move_check_initializer_kind(file, ast, value, kinds);
        try declare_resource(states, kinds, name_text, kind);
    }
    return "";
}

fn first_use_after_move_expr(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>,
    move_direct: bool
) -> ![]u8 {
    let base = moved_base_name(file, ast, expr);
    if !std::mem::equal_bytes(base, "") and states.contains(base) {
        let state = try states.get(base);
        if state == OwnershipState::Moved {
            return base;
        }
    }
    let node = ast.get(expr);
    return match node.data {
        Var(var_node) => try move_direct_name_if_needed(file, ast, expr, states, kinds, move_direct),
        FieldExpr(field_expr) => try first_use_after_move_expr(
            file,
            ast,
            field_expr.receiver,
            states,
            kinds,
            false
        ),
        Call(call_node) => try first_use_after_move_call(
            file,
            ast,
            call_node.callee,
            call_node.args,
            states,
            kinds
        ),
        StructLiteralExpr(struct_literal) => try first_use_after_move_expr_range(
            file,
            ast,
            struct_literal.fields,
            states,
            kinds,
            false
        ),
        StructFieldInit(field_init) => try first_use_after_move_expr(
            file,
            ast,
            field_init.value,
            states,
            kinds,
            false
        ),
        Prefix(prefix_node) => try first_use_after_move_expr(
            file,
            ast,
            prefix_node.right,
            states,
            kinds,
            false
        ),
        Binary(binary) => try first_use_after_move_two_exprs(
            file,
            ast,
            binary.left,
            binary.right,
            states,
            kinds
        ),
        TypeApplyExpr(type_apply) => try first_use_after_move_expr(
            file,
            ast,
            type_apply.callee,
            states,
            kinds,
            false
        ),
        TryExpr(try_expr_node) => try first_use_after_move_expr(
            file,
            ast,
            try_expr_node.value,
            states,
            kinds,
            move_direct
        ),
        ComptimeExpr(comptime_expr_node) => try first_use_after_move_expr(
            file,
            ast,
            comptime_expr_node.value,
            states,
            kinds,
            move_direct
        ),
        DerefExpr(deref_expr) => try first_use_after_move_expr(
            file,
            ast,
            deref_expr.receiver,
            states,
            kinds,
            false
        ),
        IndexExpr(index_expr) => try first_use_after_move_index(
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end,
            states,
            kinds
        ),
        Program(program) => "",
        FnDecl(fn_decl) => "",
        Empty => "",
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Bool(bool_node) => "",
        CastExpr(cast_expr) => try first_use_after_move_expr(
            file,
            ast,
            cast_expr.value,
            states,
            kinds,
            false
        ),
        ArenaNewExpr(arena_new) => try first_use_after_move_expr(
            file,
            ast,
            arena_new.allocator,
            states,
            kinds,
            false
        ),
        Block(block) => try first_use_after_move_statement_range(file, ast, block.statements, states, kinds),
        If(if_node) => try first_use_after_move_if(
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            states,
            kinds
        ),
        Let(let_node) => "",
        Assign(assign_node) => "",
        Return(return_node) => "",
        Defer(defer_node) => "",
        ExprStmt(expr_stmt) => "",
        While(while_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn first_use_after_move_call(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>
) -> ![]u8 {
    let callee_name = try first_use_after_move_expr(file, ast, callee, states, kinds, false);
    if !std::mem::equal_bytes(callee_name, "") {
        return callee_name;
    }
    return try first_use_after_move_expr_range(
        file,
        ast,
        args,
        states,
        kinds,
        call_moves_direct_args(file, ast, callee)
    );
}

fn first_use_after_move_expr_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>,
    move_direct: bool
) -> ![]u8 {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let name = try first_use_after_move_expr(file, ast, child, states, kinds, move_direct);
        if !std::mem::equal_bytes(name, "") {
            return name;
        }
        index = index + 1;
    }
    return "";
}

fn first_use_after_move_two_exprs(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>
) -> ![]u8 {
    let left_name = try first_use_after_move_expr(file, ast, left, states, kinds, false);
    if !std::mem::equal_bytes(left_name, "") {
        return left_name;
    }
    return try first_use_after_move_expr(file, ast, right, states, kinds, false);
}

fn first_use_after_move_index(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>
) -> ![]u8 {
    let target_name = try first_use_after_move_expr(file, ast, target, states, kinds, false);
    if !std::mem::equal_bytes(target_name, "") {
        return target_name;
    }
    return try first_use_after_move_two_exprs(file, ast, start, end, states, kinds);
}

fn move_direct_name_if_needed(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId,
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>,
    move_direct: bool
) -> ![]u8 {
    if !move_direct {
        return "";
    }
    let name = ast_node_text(file, ast, expr);
    if !states.contains(name) {
        return "";
    }
    let state = try states.get(name);
    if state == OwnershipState::Moved {
        return name;
    }
    let kind = try kinds.get(name);
    if resource_kind_moves(kind) {
        try move_value(states, name);
    }
    return "";
}

fn moved_base_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(expr);
    return match node.data {
        Var(var_node) => ast_node_text(file, ast, expr),
        FieldExpr(field_expr) => moved_base_name(file, ast, field_expr.receiver),
        DerefExpr(deref_expr) => moved_base_name(file, ast, deref_expr.receiver),
        TryExpr(try_expr_node) => moved_base_name(file, ast, try_expr_node.value),
        ComptimeExpr(comptime_expr_node) => moved_base_name(file, ast, comptime_expr_node.value),
        Program(program) => "",
        FnDecl(fn_decl) => "",
        Empty => "",
        ImportDecl(import_decl) => "",
        StructDecl(struct_decl) => "",
        EnumDecl(enum_decl) => "",
        UnionDecl(union_decl) => "",
        Int(int_node) => "",
        String(string_node) => "",
        TypeName(type_name) => "",
        Bool(bool_node) => "",
        Prefix(prefix_node) => "",
        Binary(binary) => "",
        Call(call_node) => "",
        TypeApplyExpr(type_apply) => "",
        CastExpr(cast_expr) => "",
        IndexExpr(index_expr) => "",
        StructLiteralExpr(struct_literal) => "",
        StructFieldInit(struct_field_init) => "",
        ArenaNewExpr(arena_new) => "",
        Block(block) => "",
        If(if_node) => "",
        Let(let_node) => "",
        Assign(assign_node) => "",
        Return(return_node) => "",
        Defer(defer_node) => "",
        ExprStmt(expr_stmt) => "",
        While(while_node) => "",
        For(for_node) => "",
        Break(break_node) => "",
        Continue(continue_node) => "",
        Param(param_node) => "",
        Field(field_node) => "",
        UnionVariant(union_variant) => "",
        Match(match_node) => "",
        MatchArm(match_arm) => "",
        Unsafe(unsafe_node) => "",
        ComptimeIf(comptime_if_node) => "",
    };
}

fn call_moves_direct_args(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> bool {
    let text = ast_node_text(file, ast, callee);
    return !std::mem::equal_bytes(text, "print") and
        !std::mem::equal_bytes(text, "std::testing::expect");
}

fn move_check_initializer_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, ResourceKind>
) -> !ResourceKind {
    if initializer_text_is_record_literal(file, ast, value) {
        return ResourceKind::Record;
    }
    let node = ast.get(value);
    return match node.data {
        StructLiteralExpr(struct_literal) => ResourceKind::Record,
        Var(var_node) => try initializer_var_kind(file, ast, value, kinds),
        TryExpr(try_expr_node) => try move_check_initializer_kind(
            file,
            ast,
            try_expr_node.value,
            kinds
        ),
        Program(program) => try initializer_resource_kind(file, ast, value),
        FnDecl(fn_decl) => try initializer_resource_kind(file, ast, value),
        Empty => try initializer_resource_kind(file, ast, value),
        Int(int_node) => try initializer_resource_kind(file, ast, value),
        String(string_node) => try initializer_resource_kind(file, ast, value),
        TypeName(type_name) => try initializer_resource_kind(file, ast, value),
        Bool(bool_node) => try initializer_resource_kind(file, ast, value),
        Prefix(prefix_node) => try initializer_resource_kind(file, ast, value),
        Binary(binary) => try initializer_resource_kind(file, ast, value),
        FieldExpr(field_expr_node) => try initializer_resource_kind(file, ast, value),
        DerefExpr(deref_expr_node) => try initializer_resource_kind(file, ast, value),
        Call(call_node) => try initializer_resource_kind(file, ast, value),
        TypeApplyExpr(type_apply) => try initializer_resource_kind(file, ast, value),
        CastExpr(cast_expr) => try initializer_resource_kind(file, ast, value),
        IndexExpr(index_expr) => try initializer_resource_kind(file, ast, value),
        StructFieldInit(struct_field_init) => try initializer_resource_kind(file, ast, value),
        ArenaNewExpr(arena_new) => try initializer_resource_kind(file, ast, value),
        ComptimeExpr(comptime_expr_node) => try initializer_resource_kind(file, ast, value),
        Block(block) => try initializer_resource_kind(file, ast, value),
        If(if_node) => try initializer_resource_kind(file, ast, value),
        Let(let_node) => try initializer_resource_kind(file, ast, value),
        Assign(assign_node) => try initializer_resource_kind(file, ast, value),
        Return(return_node) => try initializer_resource_kind(file, ast, value),
        Defer(defer_node) => try initializer_resource_kind(file, ast, value),
        ExprStmt(expr_stmt) => try initializer_resource_kind(file, ast, value),
        While(while_node) => try initializer_resource_kind(file, ast, value),
        For(for_node) => try initializer_resource_kind(file, ast, value),
        Break(break_node) => try initializer_resource_kind(file, ast, value),
        Continue(continue_node) => try initializer_resource_kind(file, ast, value),
        ImportDecl(import_decl) => try initializer_resource_kind(file, ast, value),
        Param(param_node) => try initializer_resource_kind(file, ast, value),
        Field(field_node) => try initializer_resource_kind(file, ast, value),
        StructDecl(struct_decl) => try initializer_resource_kind(file, ast, value),
        EnumDecl(enum_decl) => try initializer_resource_kind(file, ast, value),
        UnionDecl(union_decl) => try initializer_resource_kind(file, ast, value),
        UnionVariant(union_variant) => try initializer_resource_kind(file, ast, value),
        Match(match_node) => try initializer_resource_kind(file, ast, value),
        MatchArm(match_arm) => try initializer_resource_kind(file, ast, value),
        Unsafe(unsafe_node) => try initializer_resource_kind(file, ast, value),
        ComptimeIf(comptime_if_node) => try initializer_resource_kind(file, ast, value),
    };
}

fn initializer_text_is_record_literal(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> bool {
    let text = ast_node_text(file, ast, value);
    return !std::mem::starts_with(text, "{") and bytes_contains(text, "{");
}

fn check_source_summary(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    typed: types::TypeSummary
) -> !OwnershipSummary {
    var summary = ownership_summary(typed.symbols, typed.typed_nodes, 0, typed.diagnostics);
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if source::is_frontend_source(file.kind) {
            summary = merge_ownership_summaries(
                summary,
                try check_file_ownership_ast(allocator, file)
            );
        }
        index = index + 1;
    }
    return summary;
}

fn checked_package_from_refs(
    summary: OwnershipSummary,
    module: CheckedModuleRef,
    entry_function: CheckedFunctionRef,
    root_fact: OwnershipFact
) -> CheckedPackage {
    return CheckedPackage {
        diagnostics: summary.errors,
        resources: summary.resources,
        checked_nodes: summary.checked_nodes,
        borrows: summary.borrows,
        module: module,
        entry_function: entry_function,
        root_fact: root_fact,
        summary: summary
    };
}

fn first_checked_module(files: &std::array::Array<source::SourceFile>) -> !CheckedModuleRef {
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if source::is_frontend_source(file.kind) {
            return CheckedModuleRef {
                source_id: file.id,
                kind: file.kind,
                path: file.path
            };
        }
        index = index + 1;
    }
    return error("ownership handoff requires selfhost module");
}

fn entry_function_ref() -> CheckedFunctionRef {
    return CheckedFunctionRef {
        module: "main",
        name: "smoke",
        span_start: 0,
        span_end: 0
    };
}

fn package_root_fact() -> OwnershipFact {
    return OwnershipFact {
        name: "selfhost package",
        kind: ResourceKind::Value,
        state: OwnershipState::Available
    };
}

pub fn declare_resource(
    states: &var std::map::Map<[]u8, OwnershipState>,
    kinds: &var std::map::Map<[]u8, ResourceKind>,
    name: []u8,
    kind: ResourceKind
) -> !void {
    if states.contains(name) {
        return error("duplicate resource");
    }
    try states.insert(name, OwnershipState::Available);
    try kinds.insert(name, kind);
    return;
}

pub fn move_value(
    states: &var std::map::Map<[]u8, OwnershipState>,
    name: []u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("move requires available value");
    }
    try states.insert(name, OwnershipState::Moved);
    return;
}

pub fn shared_borrow(
    states: &var std::map::Map<[]u8, OwnershipState>,
    name: []u8
) -> !void {
    let state = try states.get(name);
    if state == OwnershipState::MutBorrowed or state == OwnershipState::Moved {
        return error("shared borrow blocked");
    }
    if state == OwnershipState::Deinitialized {
        return error("borrow after deinit");
    }
    try states.insert(name, OwnershipState::SharedBorrowed);
    return;
}

pub fn record_borrow(
    states: &var std::map::Map<[]u8, OwnershipState>,
    name: []u8,
    mutable: bool
) -> !void {
    if mutable {
        try mut_borrow(states, name);
        return;
    }
    let state = try states.get(name);
    if state == OwnershipState::MutBorrowed or state == OwnershipState::Moved {
        return error("shared borrow blocked");
    }
    if state == OwnershipState::Deinitialized {
        return error("borrow after deinit");
    }
    try states.insert(name, OwnershipState::SharedBorrowed);
    return;
}

pub fn mut_borrow(
    states: &var std::map::Map<[]u8, OwnershipState>,
    name: []u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("mutable borrow requires available value");
    }
    try states.insert(name, OwnershipState::MutBorrowed);
    return;
}

pub fn release_borrow(
    states: &var std::map::Map<[]u8, OwnershipState>,
    name: []u8
) -> !void {
    let state = try states.get(name);
    if state == OwnershipState::SharedBorrowed or state == OwnershipState::MutBorrowed {
        try states.insert(name, OwnershipState::Available);
        return;
    }
    return error("release requires active borrow");
}

pub fn deinit_resource(
    states: &var std::map::Map<[]u8, OwnershipState>,
    name: []u8
) -> !void {
    let state = try states.get(name);
    if state != OwnershipState::Available {
        return error("deinit requires available value");
    }
    try states.insert(name, OwnershipState::Deinitialized);
    return;
}

pub fn state_of(
    states: &std::map::Map<[]u8, OwnershipState>,
    name: []u8
) -> !OwnershipState {
    return states.get(name);
}

pub fn kind_of(
    kinds: &std::map::Map<[]u8, ResourceKind>,
    name: []u8
) -> !ResourceKind {
    return kinds.get(name);
}

pub fn summarize(
    states: &std::map::Map<[]u8, OwnershipState>,
    borrows: i64,
    errors: i64
) -> OwnershipSummary {
    return ownership_summary(states.len(), states.len(), borrows, errors);
}

fn check_file_ownership_ast(
    allocator: Allocator,
    file: &source::SourceFile
) -> !OwnershipSummary {
    let result = try parser::parse_checked_file(allocator, file.path, file.text);
    let summary = try check_ownership_ast_node(
        allocator,
        file,
        result.ast,
        result.root
    );
    result.deinit();
    return summary;
}

fn check_ownership_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return check_ownership_range(allocator, file, ast, program.declarations);,
        FnDecl(fn_decl) => return check_function_ownership(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.body
        );,
        ImportDecl(import_decl) => return ownership_summary(0, 1, 0, 0);,
        StructDecl(struct_decl) => return ownership_summary(0, 1, 0, 0);,
        EnumDecl(enum_decl) => return ownership_summary(0, 1, 0, 0);,
        UnionDecl(union_decl) => return ownership_summary(0, 1, 0, 0);,
        Empty => return ownership_summary(0, 0, 0, 0);,
        Int(int_node) => return ownership_summary(0, 1, 0, 0);,
        String(string_node) => return ownership_summary(0, 1, 0, 0);,
        TypeName(type_name) => return ownership_summary(0, 1, 0, 0);,
        Var(var_node) => return ownership_summary(0, 1, 0, 0);,
        Bool(bool_node) => return ownership_summary(0, 1, 0, 0);,
        Prefix(prefix_node) => return check_ownership_ast_node(allocator, file, ast, prefix_node.right);,
        Binary(binary) => return merge_ownership_summaries(
            try check_ownership_ast_node(allocator, file, ast, binary.left),
            try check_ownership_ast_node(allocator, file, ast, binary.right)
        );,
        FieldExpr(field_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            field_expr_node.receiver
        );,
        DerefExpr(deref_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            deref_expr_node.receiver
        );,
        Call(call_node) => return check_ownership_call(allocator, file, ast, call_node.callee, call_node.args);,
        TypeApplyExpr(type_apply) => return check_ownership_range_with_head(
            allocator,
            file,
            ast,
            type_apply.callee,
            type_apply.type_args
        );,
        CastExpr(cast_expr) => return check_ownership_ast_node(allocator, file, ast, cast_expr.value);,
        IndexExpr(index_expr) => return check_ownership_index(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end
        );,
        StructLiteralExpr(struct_literal) => return check_ownership_range_with_head(
            allocator,
            file,
            ast,
            struct_literal.type_name,
            struct_literal.fields
        );,
        StructFieldInit(struct_field_init) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            struct_field_init.value
        );,
        ArenaNewExpr(arena_new) => return check_ownership_arena_new(
            allocator,
            file,
            ast,
            arena_new.allocator
        );,
        TryExpr(try_expr_node) => return check_ownership_ast_node(allocator, file, ast, try_expr_node.value);,
        ComptimeExpr(comptime_expr_node) => return check_ownership_ast_node(
            allocator,
            file,
            ast,
            comptime_expr_node.value
        );,
        Block(block) => return check_ownership_range(allocator, file, ast, block.statements);,
        If(if_node) => return check_ownership_if(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block
        );,
        Let(let_node) => return check_let_ownership(
            allocator,
            file,
            ast,
            let_node.name,
            let_node.value
        );,
        Assign(assign_node) => return merge_ownership_summaries(
            try check_ownership_ast_node(allocator, file, ast, assign_node.target),
            try check_ownership_ast_node(allocator, file, ast, assign_node.value)
        );,
        Return(return_node) => return check_ownership_ast_node(allocator, file, ast, return_node.value);,
        Defer(defer_node) => return check_ownership_defer(allocator, file, ast, defer_node.expr);,
        ExprStmt(expr_stmt) => return check_ownership_ast_node(allocator, file, ast, expr_stmt.expr);,
        While(while_node) => return check_ownership_loop(allocator, file, ast, while_node.condition, while_node.body);,
        For(for_node) => return check_ownership_for_node(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body
        );,
        Break(break_node) => return ownership_summary(0, 1, 0, 0);,
        Continue(continue_node) => return ownership_summary(0, 1, 0, 0);,
        Param(param_node) => return ownership_summary(0, 1, 0, 0);,
        Field(field_node) => return ownership_summary(0, 1, 0, 0);,
        UnionVariant(union_variant) => return ownership_summary(0, 1, 0, 0);,
        Match(match_node) => return check_ownership_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms
        );,
        MatchArm(match_arm) => return check_ownership_ast_node(allocator, file, ast, match_arm.body);,
        Unsafe(unsafe_node) => return check_ownership_ast_node(allocator, file, ast, unsafe_node.body);,
        ComptimeIf(comptime_if_node) => return check_ownership_comptime_if(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block
        );,
    }
}

fn check_function_ownership(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId
) -> !OwnershipSummary {
    var states = std::map::Map<[]u8, OwnershipState>(allocator);
    var kinds = std::map::Map<[]u8, ResourceKind>(allocator);
    var summary = ownership_summary(0, 1, 0, 0);
    var param_index = 0;
    while param_index < params.len {
        let param_child = try ast.child_at(params, param_index);
        let param_name = param_binding_name(file, ast, param_child);
        if !std::mem::equal_bytes(param_name, "") {
            let kind = param_resource_kind(file, ast, param_child);
            try declare_resource(states, kinds, param_name, kind);
            summary = merge_ownership_summaries(summary, ownership_summary(1, 1, 0, 0));
            if kind == ResourceKind::BorrowedView {
                try shared_borrow(states, param_name);
                summary = merge_ownership_summaries(summary, ownership_summary(0, 0, 1, 0));
            }
        }
        param_index = param_index + 1;
    }
    var statement_index = 0;
    let statements = function_body_statements(ast, body);
    while statement_index < statements.len {
        let statement = try ast.child_at(statements, statement_index);
        if statement_is_let(ast, statement) {
            let name = statement_let_name(ast, statement);
            let value = statement_let_value(ast, statement);
            let kind = try initializer_state_resource_kind(file, ast, value, kinds);
            let borrow_name = initializer_borrow_name(file, ast, value);
            if !std::mem::equal_bytes(borrow_name, "") {
                if states.contains(borrow_name) {
                    if initializer_borrow_mutable(ast, value) {
                        try record_borrow(states, borrow_name, true);
                    } else {
                        try shared_borrow(states, borrow_name);
                    }
                }
                summary = merge_ownership_summaries(summary, ownership_summary(0, 0, 1, 0));
            }
            let move_name = initializer_move_name(file, ast, value);
            if !std::mem::equal_bytes(move_name, "") and states.contains(move_name) {
                let state = try states.get(move_name);
                if state == OwnershipState::Moved {
                    summary = merge_ownership_summaries(
                        summary,
                        record_use_after_move(allocator, file, ast, value)
                    );
                } else {
                    let moved_kind = try kinds.get(move_name);
                    if resource_kind_moves(moved_kind) {
                        try move_value(states, move_name);
                    }
                }
            }
            summary = merge_ownership_summaries(
                summary,
                try declare_named_resource(file, ast, name, kind, states, kinds)
            );
        }
        statement_index = statement_index + 1;
    }
    summary = merge_ownership_summaries(
        summary,
        try check_function_body(allocator, file, ast, body)
    );
    states.deinit();
    kinds.deinit();
    return summary;
}

fn param_binding_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return ast_node_text(file, ast, param_node.name);,
        Program(program) => return "";,
        Empty => return "";,
        ImportDecl(import_decl) => return "";,
        StructDecl(struct_decl) => return "";,
        EnumDecl(enum_decl) => return "";,
        UnionDecl(union_decl) => return "";,
        FnDecl(fn_decl) => return "";,
        Int(int_node) => return "";,
        String(string_node) => return "";,
        TypeName(type_name) => return "";,
        Var(var_node) => return "";,
        Bool(bool_node) => return "";,
        Prefix(prefix_node) => return "";,
        Binary(binary) => return "";,
        FieldExpr(field_expr_node) => return "";,
        DerefExpr(deref_expr_node) => return "";,
        Call(call_node) => return "";,
        TypeApplyExpr(type_apply) => return "";,
        CastExpr(cast_expr) => return "";,
        IndexExpr(index_expr) => return "";,
        StructLiteralExpr(struct_literal) => return "";,
        StructFieldInit(struct_field_init) => return "";,
        ArenaNewExpr(arena_new) => return "";,
        TryExpr(try_expr_node) => return "";,
        ComptimeExpr(comptime_expr_node) => return "";,
        Block(block) => return "";,
        If(if_node) => return "";,
        Let(let_node) => return "";,
        Assign(assign_node) => return "";,
        Return(return_node) => return "";,
        Defer(defer_node) => return "";,
        ExprStmt(expr_stmt) => return "";,
        While(while_node) => return "";,
        For(for_node) => return "";,
        Break(break_node) => return "";,
        Continue(continue_node) => return "";,
        Field(field_node) => return "";,
        UnionVariant(union_variant) => return "";,
        Match(match_node) => return "";,
        MatchArm(match_arm) => return "";,
        Unsafe(unsafe_node) => return "";,
        ComptimeIf(comptime_if_node) => return "";,
    }
}

fn param_resource_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ResourceKind {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return resource_kind_for_type(ast_node_text(file, ast, param_node.type_node));,
        Program(program) => return ResourceKind::Value;,
        Empty => return ResourceKind::Value;,
        ImportDecl(import_decl) => return ResourceKind::Value;,
        StructDecl(struct_decl) => return ResourceKind::Value;,
        EnumDecl(enum_decl) => return ResourceKind::Value;,
        UnionDecl(union_decl) => return ResourceKind::Value;,
        FnDecl(fn_decl) => return ResourceKind::Value;,
        Int(int_node) => return ResourceKind::Value;,
        String(string_node) => return ResourceKind::Value;,
        TypeName(type_name) => return ResourceKind::Value;,
        Var(var_node) => return ResourceKind::Value;,
        Bool(bool_node) => return ResourceKind::Value;,
        Prefix(prefix_node) => return ResourceKind::Value;,
        Binary(binary) => return ResourceKind::Value;,
        FieldExpr(field_expr_node) => return ResourceKind::Value;,
        DerefExpr(deref_expr_node) => return ResourceKind::Value;,
        Call(call_node) => return ResourceKind::Value;,
        TypeApplyExpr(type_apply) => return ResourceKind::Value;,
        CastExpr(cast_expr) => return ResourceKind::Value;,
        IndexExpr(index_expr) => return ResourceKind::Value;,
        StructLiteralExpr(struct_literal) => return ResourceKind::Value;,
        StructFieldInit(struct_field_init) => return ResourceKind::Value;,
        ArenaNewExpr(arena_new) => return ResourceKind::Value;,
        TryExpr(try_expr_node) => return ResourceKind::Value;,
        ComptimeExpr(comptime_expr_node) => return ResourceKind::Value;,
        Block(block) => return ResourceKind::Value;,
        If(if_node) => return ResourceKind::Value;,
        Let(let_node) => return ResourceKind::Value;,
        Assign(assign_node) => return ResourceKind::Value;,
        Return(return_node) => return ResourceKind::Value;,
        Defer(defer_node) => return ResourceKind::Value;,
        ExprStmt(expr_stmt) => return ResourceKind::Value;,
        While(while_node) => return ResourceKind::Value;,
        For(for_node) => return ResourceKind::Value;,
        Break(break_node) => return ResourceKind::Value;,
        Continue(continue_node) => return ResourceKind::Value;,
        Field(field_node) => return ResourceKind::Value;,
        UnionVariant(union_variant) => return ResourceKind::Value;,
        Match(match_node) => return ResourceKind::Value;,
        MatchArm(match_arm) => return ResourceKind::Value;,
        Unsafe(unsafe_node) => return ResourceKind::Value;,
        ComptimeIf(comptime_if_node) => return ResourceKind::Value;,
    }
}

fn function_body_statements(
    ast: std::kizu::ast::Ast,
    body: std::kizu::ast::NodeId
) -> std::kizu::ast::ChildRange {
    let node = ast.get(body);
    return match node.data {
        Block(block) => block.statements,
        Program(program) => empty_child_range(),
        Empty => empty_child_range(),
        ImportDecl(import_decl) => empty_child_range(),
        StructDecl(struct_decl) => empty_child_range(),
        EnumDecl(enum_decl) => empty_child_range(),
        UnionDecl(union_decl) => empty_child_range(),
        FnDecl(fn_decl) => empty_child_range(),
        Int(int_node) => empty_child_range(),
        String(string_node) => empty_child_range(),
        TypeName(type_name) => empty_child_range(),
        Var(var_node) => empty_child_range(),
        Bool(bool_node) => empty_child_range(),
        Prefix(prefix_node) => empty_child_range(),
        Binary(binary) => empty_child_range(),
        FieldExpr(field_expr_node) => empty_child_range(),
        DerefExpr(deref_expr_node) => empty_child_range(),
        Call(call_node) => empty_child_range(),
        TypeApplyExpr(type_apply) => empty_child_range(),
        CastExpr(cast_expr) => empty_child_range(),
        IndexExpr(index_expr) => empty_child_range(),
        StructLiteralExpr(struct_literal) => empty_child_range(),
        StructFieldInit(struct_field_init) => empty_child_range(),
        ArenaNewExpr(arena_new) => empty_child_range(),
        TryExpr(try_expr_node) => empty_child_range(),
        ComptimeExpr(comptime_expr_node) => empty_child_range(),
        If(if_node) => empty_child_range(),
        Let(let_node) => empty_child_range(),
        Assign(assign_node) => empty_child_range(),
        Return(return_node) => empty_child_range(),
        Defer(defer_node) => empty_child_range(),
        ExprStmt(expr_stmt) => empty_child_range(),
        While(while_node) => empty_child_range(),
        For(for_node) => empty_child_range(),
        Break(break_node) => empty_child_range(),
        Continue(continue_node) => empty_child_range(),
        Param(param_node) => empty_child_range(),
        Field(field_node) => empty_child_range(),
        UnionVariant(union_variant) => empty_child_range(),
        Match(match_node) => empty_child_range(),
        MatchArm(match_arm) => empty_child_range(),
        Unsafe(unsafe_node) => empty_child_range(),
        ComptimeIf(comptime_if_node) => empty_child_range(),
    };
}

fn empty_child_range() -> std::kizu::ast::ChildRange {
    return std::kizu::ast::ChildRange { start: 0, len: 0 };
}

fn statement_is_let(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Let(let_node) => true,
        Program(program) => false,
        Empty => false,
        ImportDecl(import_decl) => false,
        StructDecl(struct_decl) => false,
        EnumDecl(enum_decl) => false,
        UnionDecl(union_decl) => false,
        FnDecl(fn_decl) => false,
        Int(int_node) => false,
        String(string_node) => false,
        TypeName(type_name) => false,
        Var(var_node) => false,
        Bool(bool_node) => false,
        Prefix(prefix_node) => false,
        Binary(binary) => false,
        FieldExpr(field_expr_node) => false,
        DerefExpr(deref_expr_node) => false,
        Call(call_node) => false,
        TypeApplyExpr(type_apply) => false,
        CastExpr(cast_expr) => false,
        IndexExpr(index_expr) => false,
        StructLiteralExpr(struct_literal) => false,
        StructFieldInit(struct_field_init) => false,
        ArenaNewExpr(arena_new) => false,
        TryExpr(try_expr_node) => false,
        ComptimeExpr(comptime_expr_node) => false,
        Block(block) => false,
        If(if_node) => false,
        Assign(assign_node) => false,
        Return(return_node) => false,
        Defer(defer_node) => false,
        ExprStmt(expr_stmt) => false,
        While(while_node) => false,
        For(for_node) => false,
        Break(break_node) => false,
        Continue(continue_node) => false,
        Param(param_node) => false,
        Field(field_node) => false,
        UnionVariant(union_variant) => false,
        Match(match_node) => false,
        MatchArm(match_arm) => false,
        Unsafe(unsafe_node) => false,
        ComptimeIf(comptime_if_node) => false,
    };
}

