import selfhost::source;
import selfhost::types::ast_text;
import selfhost::types::diagnostic_summary;
import selfhost::types::expression_facts;
import selfhost::types::model;
import selfhost::types::return_diagnostics;
import selfhost::types::self_type_scope;
import selfhost::types::type_parameter_scope;

// generic_instantiation reaches every call site that writes static type arguments, in
// source order, and hands the declaration it names back to the return rule with those
// arguments in scope. A generic declaration fixes no result type on its own -- `fn id<T>(v:
// T) -> T` returns `i64` at `id<i64>` and `bool` at `id<bool>` -- so its body is checked
// once per type-argument set a call site supplies, which is what the reference checker does
// at the call it is checking (internal/types/checker.go:4527). A declaration nothing
// instantiates is never checked, there and here.
//
// Two boundaries follow from where the walk stands. A call site is matched against the
// declarations of the file it was written in, because that is the file this pass reads; a
// generic declared in another module is instantiated where its own file is walked. And a
// call site whose static arguments name the enclosing declaration's own type parameters
// fixes nothing yet -- `fn outer<T>() { inner<T>(); }` is one instantiation short -- so it
// waits for the call site that supplies them.

pub fn first_instantiated_return_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let node = ast.get(root);
    match node.data {
        Program(program) => return visit_range(
            allocator,
            file,
            ast,
            program.declarations,
            program.declarations,
            return_diagnostics::no_type_arguments(),
            function_returns
        );,
        _ => return diagnostic_summary::no_return_type_mismatch();,
    }
}

// `type_params` is the enclosing declaration's own static parameters, carried so a call
// site written inside a generic body can be told apart from one written where every type
// is already fixed.
fn visit_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return visit_node(
            allocator, file, ast, declarations, fn_decl.body,
            fn_decl.type_params, function_returns
        );,
        ImplDecl(impl_decl) => return visit_range(
            allocator, file, ast, declarations, impl_decl.methods,
            type_params, function_returns
        );,
        ContractDecl(contract_decl) => return visit_range(
            allocator, file, ast, declarations, contract_decl.methods,
            type_params, function_returns
        );,
        Block(block) => return visit_range(
            allocator, file, ast, declarations, block.statements,
            type_params, function_returns
        );,
        Let(let_node) => return visit_node(
            allocator, file, ast, declarations, let_node.value,
            type_params, function_returns
        );,
        Assign(assign_node) => return visit_two(
            allocator, file, ast, declarations, assign_node.target, assign_node.value,
            type_params, function_returns
        );,
        Return(return_node) => return visit_node(
            allocator, file, ast, declarations, return_node.value,
            type_params, function_returns
        );,
        Defer(defer_node) => return visit_node(
            allocator, file, ast, declarations, defer_node.expr,
            type_params, function_returns
        );,
        ErrDefer(err_defer_node) => return visit_node(
            allocator, file, ast, declarations, err_defer_node.expr,
            type_params, function_returns
        );,
        ExprStmt(expr_stmt) => return visit_node(
            allocator, file, ast, declarations, expr_stmt.expr,
            type_params, function_returns
        );,
        If(if_node) => return visit_three(
            allocator, file, ast, declarations,
            if_node.condition, if_node.then_block, if_node.else_block,
            type_params, function_returns
        );,
        ComptimeIf(comptime_if_node) => return visit_three(
            allocator, file, ast, declarations,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            type_params, function_returns
        );,
        While(while_node) => return visit_two(
            allocator, file, ast, declarations, while_node.condition, while_node.body,
            type_params, function_returns
        );,
        For(for_node) => return visit_three(
            allocator, file, ast, declarations,
            for_node.start, for_node.end, for_node.body,
            type_params, function_returns
        );,
        Match(match_node) => return visit_node_and_range(
            allocator, file, ast, declarations, match_node.value, match_node.arms,
            type_params, function_returns
        );,
        MatchArm(match_arm) => return visit_node(
            allocator, file, ast, declarations, match_arm.body,
            type_params, function_returns
        );,
        Unsafe(unsafe_node) => return visit_node(
            allocator, file, ast, declarations, unsafe_node.body,
            type_params, function_returns
        );,
        Prefix(prefix_node) => return visit_node(
            allocator, file, ast, declarations, prefix_node.right,
            type_params, function_returns
        );,
        Binary(binary) => return visit_two(
            allocator, file, ast, declarations, binary.left, binary.right,
            type_params, function_returns
        );,
        FieldExpr(field_expr_node) => return visit_node(
            allocator, file, ast, declarations, field_expr_node.receiver,
            type_params, function_returns
        );,
        DerefExpr(deref_expr_node) => return visit_node(
            allocator, file, ast, declarations, deref_expr_node.receiver,
            type_params, function_returns
        );,
        CastExpr(cast_expr) => return visit_node(
            allocator, file, ast, declarations, cast_expr.value,
            type_params, function_returns
        );,
        IndexExpr(index_expr) => return visit_three(
            allocator, file, ast, declarations,
            index_expr.target, index_expr.start, index_expr.end,
            type_params, function_returns
        );,
        StructLiteralExpr(struct_literal_node) => return visit_range(
            allocator, file, ast, declarations, struct_literal_node.fields,
            type_params, function_returns
        );,
        StructFieldInit(field_init) => return visit_node(
            allocator, file, ast, declarations, field_init.value,
            type_params, function_returns
        );,
        ArenaNewExpr(arena_new) => return visit_node(
            allocator, file, ast, declarations, arena_new.allocator,
            type_params, function_returns
        );,
        TryExpr(try_expr_node) => return visit_node(
            allocator, file, ast, declarations, try_expr_node.value,
            type_params, function_returns
        );,
        ComptimeExpr(comptime_expr_node) => return visit_node(
            allocator, file, ast, declarations, comptime_expr_node.value,
            type_params, function_returns
        );,
        Call(call_node) => return visit_node_and_range(
            allocator, file, ast, declarations, call_node.callee, call_node.args,
            type_params, function_returns
        );,
        TypeApplyExpr(type_apply) => return first_instantiated_mismatch(
            allocator, file, ast, declarations,
            ast_text::ast_node_text(file, ast, type_apply.callee),
            type_apply.type_args, type_params, function_returns
        );,
        _ => return diagnostic_summary::no_return_type_mismatch();,
    }
}

// The call site names the declaration it instantiates, and the declarations of this file
// are what that name is resolved against.
fn first_instantiated_mismatch(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    name: []u8,
    type_args: std::kizu::ast::ChildRange,
    type_params: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    if try mentions_enclosing_parameter(file, ast, type_params, type_args) {
        return diagnostic_summary::no_return_type_mismatch();
    }
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try instantiated_declaration_mismatch(
            allocator, file, ast, child, name, type_args, function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_return_type_mismatch();
}

fn instantiated_declaration_mismatch(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8,
    type_args: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return instantiated_function_mismatch(
            allocator, file, ast, fn_decl.name, fn_decl.type_params, fn_decl.params,
            fn_decl.return_type, fn_decl.body, name, type_args, function_returns
        );,
        _ => return diagnostic_summary::no_return_type_mismatch();,
    }
}

fn instantiated_function_mismatch(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declared_name: std::kizu::ast::NodeId,
    declared_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    name: []u8,
    type_args: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    if !type_parameter_scope::binds_arguments(declared_params, type_args) {
        return diagnostic_summary::no_return_type_mismatch();
    }
    if !std::mem::equal_bytes(name, ast_text::ast_node_text(file, ast, declared_name)) {
        return diagnostic_summary::no_return_type_mismatch();
    }
    return return_diagnostics::first_return_type_mismatch_in_function(
        allocator,
        file,
        ast,
        declared_name,
        declared_params,
        type_args,
        params,
        return_type,
        body,
        self_type_scope::no_self_type(),
        function_returns
    );
}

fn mentions_enclosing_parameter(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_params: std::kizu::ast::ChildRange,
    type_args: std::kizu::ast::ChildRange
) -> !bool {
    var index = 0;
    while index < type_args.len {
        let child = try ast.child_at(type_args, index);
        let resolved = try type_parameter_scope::declared_type_text(
            file, ast, type_params, ast_text::ast_node_text(file, ast, child)
        );
        if std::mem::equal_bytes(resolved, "unknown") {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn visit_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    children: std::kizu::ast::ChildRange,
    type_params: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    var index = 0;
    while index < children.len {
        let child = try ast.child_at(children, index);
        let found = try visit_node(
            allocator, file, ast, declarations, child, type_params, function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_return_type_mismatch();
}

fn visit_two(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let found = try visit_node(
        allocator, file, ast, declarations, first, type_params, function_returns
    );
    if found.found {
        return found;
    }
    return visit_node(
        allocator, file, ast, declarations, second, type_params, function_returns
    );
}

fn visit_three(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let found = try visit_two(
        allocator, file, ast, declarations, first, second, type_params, function_returns
    );
    if found.found {
        return found;
    }
    return visit_node(
        allocator, file, ast, declarations, third, type_params, function_returns
    );
}

fn visit_node_and_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    children: std::kizu::ast::ChildRange,
    type_params: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let found = try visit_node(
        allocator, file, ast, declarations, node_id, type_params, function_returns
    );
    if found.found {
        return found;
    }
    return visit_range(
        allocator, file, ast, declarations, children, type_params, function_returns
    );
}
