// TypeRecord is the checked primitive identity used by lowering. Integer
// identities retain signedness and bit width, while storage ABI selection stays
// a separate compile-time descriptor.
pub struct TypeRecord {
    pub identity: i64,
    pub kind: i64,
    pub bit_width: i64,
    pub signed: bool,
}

pub fn type_kind_unknown() -> i64 { return 0; }
pub fn type_kind_bool() -> i64 { return 1; }
pub fn type_kind_integer() -> i64 { return 2; }
pub fn type_kind_slice() -> i64 { return 3; }

pub fn storage_abi_unknown() -> i64 { return 0; }
pub fn storage_abi_bool() -> i64 { return 1; }
pub fn storage_abi_slice() -> i64 { return 2; }

fn storage_abi_integer_base() -> i64 { return 100; }
fn type_identity_integer_base() -> i64 { return 1000; }

pub fn record_from_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> TypeRecord {
    let node = ast.get(type_node);
    let type_text = text[node.span.start..node.span.end];
    if std::mem::equal_bytes(type_text, "bool") {
        return bool_record();
    }
    if std::mem::equal_bytes(type_text, "[]u8") {
        return slice_record();
    }
    return record_from_text(type_text);
}

pub fn record_from_identity(identity: i64) -> TypeRecord {
    if identity == type_kind_bool() {
        return bool_record();
    }
    if identity == type_kind_slice() {
        return slice_record();
    }
    let encoded = identity - type_identity_integer_base();
    if encoded < 0 {
        return unknown_record();
    }
    let width = encoded / 2;
    if !integer_width_supported(width) {
        return unknown_record();
    }
    let signed = integer_encoding_is_signed(encoded);
    return integer_record(width, signed);
}

pub fn storage_abi(record: TypeRecord) -> i64 {
    if record.kind == type_kind_bool() {
        return storage_abi_bool();
    }
    if record.kind == type_kind_slice() {
        return storage_abi_slice();
    }
    if record.kind == type_kind_integer() {
        return storage_abi_integer(record.bit_width, record.signed);
    }
    return storage_abi_unknown();
}

pub fn storage_abi_integer(width: i64, signed: bool) -> i64 {
    if !integer_width_supported(width) {
        return storage_abi_unknown();
    }
    if signed {
        return storage_abi_integer_base() + width * 2 + 1;
    }
    return storage_abi_integer_base() + width * 2;
}

pub fn storage_abi_is_integer(abi: i64) -> bool {
    return storage_abi_integer_width(abi) > 0;
}

pub fn storage_abi_integer_width(abi: i64) -> i64 {
    let encoded = abi - storage_abi_integer_base();
    if encoded < 0 {
        return 0;
    }
    let width = encoded / 2;
    if !integer_width_supported(width) {
        return 0;
    }
    return width;
}

pub fn storage_abi_integer_signed(abi: i64) -> bool {
    if !storage_abi_is_integer(abi) {
        return false;
    }
    let encoded = abi - storage_abi_integer_base();
    return integer_encoding_is_signed(encoded);
}

pub fn storage_abi_supported(abi: i64) -> bool {
    if abi == storage_abi_bool() or abi == storage_abi_slice() {
        return true;
    }
    return storage_abi_is_integer(abi);
}

pub fn storage_abi_size(abi: i64) -> i64 {
    if abi == storage_abi_bool() {
        return 1;
    }
    if abi == storage_abi_slice() {
        return 16;
    }
    let width = storage_abi_integer_width(abi);
    if width > 0 {
        return width / 8;
    }
    return 0 - 1;
}

pub fn storage_abi_align(abi: i64) -> i64 {
    if abi == storage_abi_bool() {
        return 1;
    }
    if abi == storage_abi_slice() {
        return 8;
    }
    let width = storage_abi_integer_width(abi);
    if width > 0 {
        return width / 8;
    }
    return 0 - 1;
}

fn bool_record() -> TypeRecord {
    return TypeRecord {
        identity: type_kind_bool(),
        kind: type_kind_bool(),
        bit_width: 1,
        signed: false
    };
}

fn slice_record() -> TypeRecord {
    return TypeRecord {
        identity: type_kind_slice(),
        kind: type_kind_slice(),
        bit_width: 0,
        signed: false
    };
}

fn integer_record(width: i64, signed: bool) -> TypeRecord {
    let identity_base = type_identity_integer_base() + width * 2;
    let kind = type_kind_integer();
    if signed {
        let identity = identity_base + 1;
        return TypeRecord {
            identity: identity,
            kind: kind,
            bit_width: width,
            signed: true
        };
    }
    return TypeRecord {
        identity: identity_base,
        kind: kind,
        bit_width: width,
        signed: false
    };
}

fn unknown_record() -> TypeRecord {
    return TypeRecord {
        identity: 0,
        kind: type_kind_unknown(),
        bit_width: 0,
        signed: false
    };
}

pub fn record_from_text(type_text: []u8) -> TypeRecord {
    let length = std::mem::len(type_text);
    if length < 2 {
        return unknown_record();
    }
    let first = type_text[0];
    let signed_prefix = cast<u8>(105);
    let unsigned_prefix = cast<u8>(117);
    if first != signed_prefix and first != unsigned_prefix {
        return unknown_record();
    }
    let width = integer_width_from_text(type_text);
    if !integer_width_supported(width) {
        return unknown_record();
    }
    let signed = first == signed_prefix;
    return integer_record(width, signed);
}

fn integer_width_from_text(type_text: []u8) -> i64 {
    let length = std::mem::len(type_text);
    // v0 integer storage widths are at most two decimal digits (8..64).
    // Decode the digits generically; supported widths are selected separately.
    if length < 2 or length > 3 {
        return 0;
    }
    let first = decimal_digit_value(type_text[1]);
    if first < 0 {
        return 0;
    }
    if length == 2 {
        return first;
    }
    let second = decimal_digit_value(type_text[2]);
    if second < 0 {
        return 0;
    }
    return first * 10 + second;
}

fn decimal_digit_value(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value < 48 or value > 57 {
        return 0 - 1;
    }
    return value - 48;
}

fn integer_width_supported(width: i64) -> bool {
    return width == 8 or width == 16 or width == 32 or width == 64;
}

fn integer_encoding_is_signed(encoded: i64) -> bool {
    let width = encoded / 2;
    return encoded - width * 2 == 1;
}
