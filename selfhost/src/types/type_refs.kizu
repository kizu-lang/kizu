import selfhost::ir::intrinsic_type_contract;
import selfhost::source;
import selfhost::types::model;

// seed_builtin_types installs the builtin type namespace. The intrinsic identities come
// from selfhost::ir::intrinsic_type_contract, the registry the package TypeStore and the
// ABI fact emitters already share, so the frontend cannot accept a narrower set of
// builtin type constructors than the rest of the compiler models. Entries are keyed by the
// canonical ABI identity the registry enumerates; which of an identity's source spellings a
// type position may actually write is a separate question, and type_ref_names answers it
// from the spelling as written. What remains below is the std nominal
// declarations, which are ordinary struct and enum declarations the frontend has not yet
// collected from their own sources; those entries go away once it does.
pub fn seed_builtin_types(
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    try seed_intrinsic_types(kinds, arities, copyable);
    try seed_std_nominal_types(kinds, arities, copyable);
    return;
}

fn seed_intrinsic_types(
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    var index = 0;
    while index < intrinsic_type_contract::source_named_kind_count() {
        let kind = try intrinsic_type_contract::source_named_kind_at(index);
        let name = try intrinsic_type_contract::canonical_name(kind);
        let type_arity = intrinsic_type_contract::arity(kind);
        // An intrinsic that takes type arguments constructs a value over storage it
        // owns; one that takes none is a scalar identity duplicated by value.
        if type_arity == 0 {
            try kinds.insert(name, model::TypeKind::Primitive);
        } else {
            try kinds.insert(name, model::TypeKind::Container);
        }
        try arities.insert(name, type_arity);
        try copyable.insert(name, intrinsic_is_duplicated_by_value(kind));
        index = index + 1;
    }
    return;
}

// intrinsic_is_duplicated_by_value classifies an intrinsic identity for the rules that ask
// whether a value can be stored by copying it. Taking a type argument means the intrinsic
// constructs a value over storage it owns, so it is moved rather than copied. Among the
// identities that take none, the concurrency resources -- a task group, a work queue, a
// partition, a local buffer -- are still storage exactly one scope releases, and
// `Function` and `type` are compile-time tokens no runtime value duplicates. Everything
// else an arity-0 intrinsic names is a scalar identity duplicated by value.
fn intrinsic_is_duplicated_by_value(kind: i64) -> bool {
    if intrinsic_type_contract::arity(kind) > 0 {
        return false;
    }
    if kind == intrinsic_type_contract::kind_task_group() or
        kind == intrinsic_type_contract::kind_queue() or
        kind == intrinsic_type_contract::kind_partition() or
        kind == intrinsic_type_contract::kind_local_buffer() {
        return false;
    }
    return kind != intrinsic_type_contract::kind_function() and
        kind != intrinsic_type_contract::kind_meta_type();
}

fn seed_std_nominal_types(
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    try kinds.insert("std::string::String", model::TypeKind::Struct);
    try arities.insert("std::string::String", 0);
    try copyable.insert("std::string::String", false);
    try kinds.insert("std::fs::Metadata", model::TypeKind::Struct);
    try arities.insert("std::fs::Metadata", 0);
    try copyable.insert("std::fs::Metadata", true);
    try kinds.insert("std::fs::DirEntry", model::TypeKind::Struct);
    try arities.insert("std::fs::DirEntry", 0);
    try copyable.insert("std::fs::DirEntry", true);
    try kinds.insert("std::kizu::ast::Ast", model::TypeKind::Struct);
    try arities.insert("std::kizu::ast::Ast", 0);
    try copyable.insert("std::kizu::ast::Ast", false);
    try kinds.insert("std::kizu::ast::ChildRange", model::TypeKind::Struct);
    try arities.insert("std::kizu::ast::ChildRange", 0);
    try copyable.insert("std::kizu::ast::ChildRange", true);
    try kinds.insert("std::kizu::ast::NodeId", model::TypeKind::Struct);
    try arities.insert("std::kizu::ast::NodeId", 0);
    try copyable.insert("std::kizu::ast::NodeId", true);
    try kinds.insert("std::kizu::ast::ParseResult", model::TypeKind::Struct);
    try arities.insert("std::kizu::ast::ParseResult", 0);
    try copyable.insert("std::kizu::ast::ParseResult", false);
    try kinds.insert("std::kizu::ast::PrefixOp", model::TypeKind::Enum);
    try arities.insert("std::kizu::ast::PrefixOp", 0);
    try copyable.insert("std::kizu::ast::PrefixOp", true);
    try kinds.insert("std::kizu::ast::BinaryOp", model::TypeKind::Enum);
    try arities.insert("std::kizu::ast::BinaryOp", 0);
    try copyable.insert("std::kizu::ast::BinaryOp", true);
    try kinds.insert("std::kizu::lexer::Token", model::TypeKind::Struct);
    try arities.insert("std::kizu::lexer::Token", 0);
    try copyable.insert("std::kizu::lexer::Token", true);
    try kinds.insert("std::kizu::diagnostic::Diagnostic", model::TypeKind::Struct);
    try arities.insert("std::kizu::diagnostic::Diagnostic", 0);
    try copyable.insert("std::kizu::diagnostic::Diagnostic", false);
    try kinds.insert("std::kizu::diagnostic::FileSpan", model::TypeKind::Struct);
    try arities.insert("std::kizu::diagnostic::FileSpan", 0);
    try copyable.insert("std::kizu::diagnostic::FileSpan", true);
    return;
}

pub fn collect_declared_types_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    let node = ast.get(root);
    match node.data {
        Program(program) => return collect_declared_types_in_range(
            allocator,
            file,
            ast,
            program.declarations,
            kinds,
            arities,
            copyable
        );,
        StructDecl(struct_decl) => return collect_declared_type_from_ast(
            allocator,
            file,
            ast,
            struct_decl.name,
            model::TypeKind::Struct,
            struct_decl.type_params.len,
            true,
            kinds,
            arities,
            copyable
        );,
        EnumDecl(enum_decl) => return collect_declared_type_from_ast(
            allocator,
            file,
            ast,
            enum_decl.name,
            model::TypeKind::Enum,
            0,
            true,
            kinds,
            arities,
            copyable
        );,
        UnionDecl(union_decl) => return collect_declared_type_from_ast(
            allocator,
            file,
            ast,
            union_decl.name,
            model::TypeKind::Union,
            union_decl.type_params.len,
            false,
            kinds,
            arities,
            copyable
        );,
        ContractDecl(contract_decl) => return collect_declared_type_from_ast(
            allocator,
            file,
            ast,
            contract_decl.name,
            model::TypeKind::Contract,
            0,
            false,
            kinds,
            arities,
            copyable
        );,
        _ => return;,
    }
    return;
}

fn collect_declared_types_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_declared_types_from_ast(allocator, file, ast, child, kinds, arities, copyable);
        index = index + 1;
    }
    return;
}

fn collect_declared_type_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    kind: model::TypeKind,
    arity: i64,
    is_copyable: bool,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    var qualified = std::string::String(allocator);
    try append_module_name(qualified, file);
    try qualified.append_bytes("::");
    try qualified.append_bytes(ast_node_text(file, ast, name));
    let type_name = qualified.as_bytes();
    try kinds.insert(type_name, kind);
    try arities.insert(type_name, arity);
    try copyable.insert(type_name, is_copyable);
    qualified.deinit();
    return;
}

pub fn collect_type_parameters_from_ast(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    let node = ast.get(root);
    match node.data {
        Program(program) => return collect_type_parameters_in_range(
            file,
            ast,
            program.declarations,
            kinds,
            arities,
            copyable
        );,
        FnDecl(fn_decl) => return collect_type_parameters_from_range(
            file,
            ast,
            fn_decl.type_params,
            kinds,
            arities,
            copyable
        );,
        StructDecl(struct_decl) => return collect_type_parameters_from_range(
            file,
            ast,
            struct_decl.type_params,
            kinds,
            arities,
            copyable
        );,
        UnionDecl(union_decl) => return collect_type_parameters_from_range(
            file,
            ast,
            union_decl.type_params,
            kinds,
            arities,
            copyable
        );,
        ImplDecl(impl_decl) => return collect_type_parameters_in_range(
            file,
            ast,
            impl_decl.methods,
            kinds,
            arities,
            copyable
        );,
        ContractDecl(contract_decl) => return collect_type_parameters_in_range(
            file,
            ast,
            contract_decl.methods,
            kinds,
            arities,
            copyable
        );,
        _ => return;,
    }
    return;
}

fn collect_type_parameters_in_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_type_parameters_from_ast(file, ast, child, kinds, arities, copyable);
        index = index + 1;
    }
    return;
}

fn collect_type_parameters_from_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !void {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let name = ast_node_text(file, ast, child);
        if starts_with_uppercase(name) and !kinds.contains(name) {
            try kinds.insert(name, model::TypeKind::Primitive);
            try arities.insert(name, 0);
            try copyable.insert(name, true);
        }
        index = index + 1;
    }
    return;
}

fn append_module_name(
    name: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    try source::append_qualified_module_name(name, file);
    return;
}

fn ast_node_text(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return file.text[span.start..span.end];
}

fn starts_with_uppercase(name: []u8) -> bool {
    if std::mem::len(name) < 1 {
        return false;
    }
    let byte = name[0];
    return byte >= cast<u8>(65) and byte <= cast<u8>(90);
}
