import selfhost::types::unsafe_capability;

// The raw pointer operations the compiler provides. A source file calls them without
// declaring them, so the call checker resolves them here instead of in the declared
// function table, and the capability pass reads the same rows: one table carries the
// arity a call site is checked against, the @unsafe capability the operation requires,
// and the rule its pointer operand must satisfy.
//
// A row is a signature, not permission to skip checking. An operation listed here is
// still checked for arity and operand shape; leaving a row out means the name is not a
// compiler builtin at all.

pub fn operand_none() -> i64 { return 0; }
// The operand must be a raw pointer that is not nullable.
pub fn operand_readable_pointer() -> i64 { return 1; }
// The operand must be a raw pointer that is neither nullable nor `const`.
pub fn operand_writable_pointer() -> i64 { return 2; }
// The operand must be a raw pointer; a nullable one is still an address.
pub fn operand_any_pointer() -> i64 { return 3; }

pub struct PointerBuiltin {
    pub name: []u8,
    pub params: i64,
    pub capability: i64,
    pub operand: i64,
}

pub fn builtin_count() -> i64 { return 6; }

pub fn builtin_at(index: i64) -> PointerBuiltin {
    if index == 0 {
        return builtin(
            "ptr_read", 1, unsafe_capability::capability_ptr_read(),
            operand_readable_pointer()
        );
    }
    if index == 1 {
        return builtin(
            "ptr_write", 2, unsafe_capability::capability_ptr_write(),
            operand_writable_pointer()
        );
    }
    if index == 2 {
        return builtin(
            "volatile_read", 1, unsafe_capability::capability_volatile(),
            operand_readable_pointer()
        );
    }
    if index == 3 {
        return builtin(
            "volatile_write", 2, unsafe_capability::capability_volatile(),
            operand_writable_pointer()
        );
    }
    if index == 4 {
        return builtin(
            "ptr_from_int", 1, unsafe_capability::capability_ptr_int_cast(),
            operand_none()
        );
    }
    if index == 5 {
        return builtin(
            "int_from_ptr", 1, unsafe_capability::capability_ptr_int_cast(),
            operand_any_pointer()
        );
    }
    return builtin("", -1, -1, operand_none());
}

// lookup answers with a row whose params is -1 when the name is not a compiler builtin.
pub fn lookup(name: []u8) -> PointerBuiltin {
    var index = 0;
    while index < builtin_count() {
        let entry = builtin_at(index);
        if std::mem::equal_bytes(name, entry.name) {
            return entry;
        }
        index = index + 1;
    }
    return builtin("", -1, -1, operand_none());
}

fn builtin(name: []u8, params: i64, capability: i64, operand: i64) -> PointerBuiltin {
    return PointerBuiltin {
        name: name,
        params: params,
        capability: capability,
        operand: operand
    };
}
