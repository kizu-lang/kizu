import selfhost::types::model;
import selfhost::types::primitive_type;

// is_builtin_primitive_name reports whether a name spells a primitive the compiler already
// models. It asks primitive_type's decoder rather than reading a seeded list, so a width
// the storage ABI supports is a width the type checker accepts and the two cannot drift.
// Seeding a fixed subset is what left Array<i32> rejected by the frontend long after the
// scalar storage ABI had been generalized over every supported width.
pub fn is_builtin_primitive_name(name: []u8) -> bool {
    let record = primitive_type::record_from_text(name);
    return record.kind != primitive_type::type_kind_unknown();
}

// type_name_is_known answers the question the seeded map alone used to answer: a declared
// type resolves from the map, and anything else falls through to the primitive decoder.
// The map is consulted first so a user type that happens to spell a primitive still wins.
pub fn type_name_is_known(
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    name: []u8
) -> bool {
    if kinds.contains(name) {
        return true;
    }
    return is_builtin_primitive_name(name);
}

pub fn declare_type(
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>,
    name: []u8,
    kind: model::TypeKind,
    arity: i64,
    copy: bool
) -> !void {
    if kinds.contains(name) {
        return error("duplicate type");
    }
    try kinds.insert(name, kind);
    try arities.insert(name, arity);
    try copyable.insert(name, copy);
    return;
}

// The three accessors below fall back to the primitive decoder on the same terms as
// type_name_is_known: a primitive takes no type arguments and is copied by value.
pub fn lookup_kind(
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    name: []u8
) -> !model::TypeKind {
    if !kinds.contains(name) and is_builtin_primitive_name(name) {
        return model::TypeKind::Primitive;
    }
    return kinds.get(name);
}

pub fn arity_of(
    arities: &std::map::Map<[]u8, i64>,
    name: []u8
) -> !i64 {
    if !arities.contains(name) and is_builtin_primitive_name(name) {
        return 0;
    }
    return arities.get(name);
}

pub fn is_copyable(
    copyable: &std::map::Map<[]u8, bool>,
    name: []u8
) -> !bool {
    if !copyable.contains(name) and is_builtin_primitive_name(name) {
        return true;
    }
    return copyable.get(name);
}

pub fn declare_function(
    arities: &var std::map::Map<[]u8, i64>,
    param_sources: &var std::map::Map<[]u8, []u8>,
    returns: &var std::map::Map<[]u8, []u8>,
    visibility: &var std::map::Map<[]u8, bool>,
    span_starts: &var std::map::Map<[]u8, i64>,
    span_ends: &var std::map::Map<[]u8, i64>,
    name: []u8,
    signature: model::FunctionSignature
) -> !void {
    if arities.contains(name) {
        return error("duplicate function");
    }
    try arities.insert(name, signature.params);
    try param_sources.insert(name, signature.param_source);
    try returns.insert(name, signature.return_type);
    try visibility.insert(name, signature.public);
    try span_starts.insert(name, signature.span_start);
    try span_ends.insert(name, signature.span_end);
    return;
}

pub fn lookup_function(
    arities: &std::map::Map<[]u8, i64>,
    param_sources: &std::map::Map<[]u8, []u8>,
    returns: &std::map::Map<[]u8, []u8>,
    visibility: &std::map::Map<[]u8, bool>,
    span_starts: &std::map::Map<[]u8, i64>,
    span_ends: &std::map::Map<[]u8, i64>,
    name: []u8
) -> !model::FunctionSignature {
    return model::FunctionSignature {
        params: try arities.get(name),
        param_source: try param_sources.get(name),
        return_type: try returns.get(name),
        public: try visibility.get(name),
        span_start: try span_starts.get(name),
        span_end: try span_ends.get(name)
    };
}

pub fn summarize(
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    diagnostics: i64
) -> model::TypeSummary {
    return model::TypeSummary {
        modules: 1,
        symbols: kinds.len(),
        functions: 0,
        typed_nodes: kinds.len(),
        diagnostics: diagnostics
    };
}
