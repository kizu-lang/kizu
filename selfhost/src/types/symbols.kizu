import selfhost::types::model;

pub fn declare_type(
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>,
    name: []u8,
    kind: model::TypeKind,
    arity: i64,
    copy: bool
) -> !void {
    if kinds.contains(name) {
        return error("duplicate type");
    }
    try kinds.insert(name, kind);
    try arities.insert(name, arity);
    try copyable.insert(name, copy);
    return;
}

pub fn lookup_kind(
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    name: []u8
) -> !model::TypeKind {
    return kinds.get(name);
}

pub fn arity_of(
    arities: &std::map::Map<[]u8, i64>,
    name: []u8
) -> !i64 {
    return arities.get(name);
}

pub fn is_copyable(
    copyable: &std::map::Map<[]u8, bool>,
    name: []u8
) -> !bool {
    return copyable.get(name);
}

pub fn declare_function(
    arities: &var std::map::Map<[]u8, i64>,
    param_sources: &var std::map::Map<[]u8, []u8>,
    returns: &var std::map::Map<[]u8, []u8>,
    visibility: &var std::map::Map<[]u8, bool>,
    span_starts: &var std::map::Map<[]u8, i64>,
    span_ends: &var std::map::Map<[]u8, i64>,
    name: []u8,
    signature: model::FunctionSignature
) -> !void {
    if arities.contains(name) {
        return error("duplicate function");
    }
    try arities.insert(name, signature.params);
    try param_sources.insert(name, signature.param_source);
    try returns.insert(name, signature.return_type);
    try visibility.insert(name, signature.public);
    try span_starts.insert(name, signature.span_start);
    try span_ends.insert(name, signature.span_end);
    return;
}

pub fn lookup_function(
    arities: &std::map::Map<[]u8, i64>,
    param_sources: &std::map::Map<[]u8, []u8>,
    returns: &std::map::Map<[]u8, []u8>,
    visibility: &std::map::Map<[]u8, bool>,
    span_starts: &std::map::Map<[]u8, i64>,
    span_ends: &std::map::Map<[]u8, i64>,
    name: []u8
) -> !model::FunctionSignature {
    return model::FunctionSignature {
        params: try arities.get(name),
        param_source: try param_sources.get(name),
        return_type: try returns.get(name),
        public: try visibility.get(name),
        span_start: try span_starts.get(name),
        span_end: try span_ends.get(name)
    };
}

pub fn summarize(
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    diagnostics: i64
) -> model::TypeSummary {
    return model::TypeSummary {
        modules: 1,
        symbols: kinds.len(),
        functions: 0,
        typed_nodes: kinds.len(),
        diagnostics: diagnostics
    };
}
