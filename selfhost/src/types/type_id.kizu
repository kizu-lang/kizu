pub struct TypeId {
    pub raw: i64,
}

pub struct TypeRecord {
    pub id: i64,
    pub kind: i64,
    pub element: i64,
    pub success: i64,
    pub mutable_borrow: bool,
}

pub struct TypeTable {
    pub void_id: i64,
    pub i64_id: i64,
    pub bool_id: i64,
    pub slice_u8_id: i64,
    pub allocator_id: i64,
    pub string_id: i64,
    pub map_slice_u8_i64_id: i64,
}

struct TypeGenericParts {
    ok: bool,
    callee_start: i64,
    callee_end: i64,
    arg0_start: i64,
    arg0_end: i64,
    arg1_start: i64,
    arg1_end: i64,
    arg_count: i64,
}

pub struct TypeMapParts {
    pub ok: bool,
    pub value_start: i64,
    pub value_end: i64,
    pub borrowed: bool,
    pub mutable_borrow: bool,
}

pub struct TypeBoxParts {
    pub ok: bool,
    pub value_start: i64,
    pub value_end: i64,
}

pub fn type_kind_unknown() -> i64 { return 0; }
pub fn type_kind_void() -> i64 { return 1; }
pub fn type_kind_i64() -> i64 { return 2; }
pub fn type_kind_bool() -> i64 { return 3; }
pub fn type_kind_slice_u8() -> i64 { return 4; }
pub fn type_kind_allocator() -> i64 { return 5; }
pub fn type_kind_string() -> i64 { return 6; }
pub fn type_kind_array() -> i64 { return 7; }
pub fn type_kind_map_slice_u8_i64() -> i64 { return 8; }
pub fn type_kind_borrow() -> i64 { return 9; }
pub fn type_kind_error_union() -> i64 { return 10; }
pub fn type_kind_atomic() -> i64 { return 11; }
pub fn type_kind_u8() -> i64 { return 17; }
pub fn type_kind_i32() -> i64 { return 18; }
pub fn type_kind_fs_dir_entry() -> i64 { return 13; }
pub fn type_kind_mutex() -> i64 { return 14; }
pub fn type_kind_io() -> i64 { return 15; }
pub fn type_kind_channel() -> i64 { return 16; }
pub fn type_kind_arena() -> i64 { return 19; }
pub fn type_kind_raw_pointer() -> i64 { return 20; }
pub fn type_kind_ast_source_file() -> i64 { return 21; }
pub fn type_kind_ast_parse_result() -> i64 { return 22; }
pub fn type_kind_ast_node_id() -> i64 { return 23; }
pub fn type_kind_ast_node() -> i64 { return 24; }
pub fn type_kind_dyn() -> i64 { return 25; }
pub fn type_kind_ast() -> i64 { return 26; }
pub fn type_kind_ast_child_range() -> i64 { return 27; }
pub fn type_kind_ast_span() -> i64 { return 28; }
pub fn type_kind_ast_symbol_id() -> i64 { return 29; }

pub fn type_id_unknown() -> i64 { return 0; }
pub fn type_id_void() -> i64 { return 1; }
pub fn type_id_i64() -> i64 { return 2; }
pub fn type_id_bool() -> i64 { return 3; }
pub fn type_id_slice_u8() -> i64 { return 4; }
pub fn type_id_allocator() -> i64 { return 5; }
pub fn type_id_string() -> i64 { return 6; }
pub fn type_id_map_slice_u8_i64() -> i64 { return 8; }
pub fn type_id_u8() -> i64 { return 17; }
pub fn type_id_i32() -> i64 { return 18; }
pub fn type_id_fs_dir_entry() -> i64 { return 13; }
pub fn type_id_io() -> i64 { return 15; }
pub fn type_id_ast_source_file() -> i64 { return 21; }
pub fn type_id_ast_parse_result() -> i64 { return 22; }
pub fn type_id_ast_node_id() -> i64 { return 23; }
pub fn type_id_ast_node() -> i64 { return 24; }
pub fn type_id_dyn() -> i64 { return 25; }
pub fn type_id_ast() -> i64 { return 26; }
pub fn type_id_ast_child_range() -> i64 { return 27; }
pub fn type_id_ast_span() -> i64 { return 28; }
pub fn type_id_ast_symbol_id() -> i64 { return 29; }

pub fn type_id_array(element: i64) -> i64 {
    return element * type_id_composite_stride() + type_kind_array();
}

pub fn type_id_borrow(element: i64, mutable: bool) -> i64 {
    if mutable {
        return element * type_id_composite_stride() + type_id_mut_borrow_tag();
    }
    return element * type_id_composite_stride() + type_kind_borrow();
}

pub fn type_id_error_union(success: i64) -> i64 {
    return success * type_id_composite_stride() + type_kind_error_union();
}

pub fn type_id_atomic(element: i64) -> i64 {
    return element * type_id_composite_stride() + type_kind_atomic();
}

pub fn type_id_mutex(element: i64) -> i64 {
    return element * type_id_composite_stride() + type_kind_mutex();
}

pub fn type_id_channel(element: i64) -> i64 {
    return element * type_id_composite_stride() + type_kind_channel();
}

pub fn type_id_arena(element: i64) -> i64 {
    return element * type_id_composite_stride() + type_kind_arena();
}

pub fn type_id_raw_pointer(element: i64) -> i64 {
    return element * type_id_composite_stride() + type_kind_raw_pointer();
}

pub fn type_id_from_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> i64 {
    let record = type_record_from_node(text, ast, type_node);
    return record.id;
}

pub fn function_return_type_id_from_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    return_type: std::kizu::ast::NodeId
) -> i64 {
    return type_id_from_node(text, ast, return_type);
}

pub fn function_param_type_id_from_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> i64 {
    return type_id_from_node(text, ast, type_node);
}

pub fn builtin_type_table() -> TypeTable {
    return TypeTable {
        void_id: type_id_void(),
        i64_id: type_id_i64(),
        bool_id: type_id_bool(),
        slice_u8_id: type_id_slice_u8(),
        allocator_id: type_id_allocator(),
        string_id: type_id_string(),
        map_slice_u8_i64_id: type_id_map_slice_u8_i64()
    };
}

pub fn unknown_type_record() -> TypeRecord {
    return TypeRecord {
        id: type_id_unknown(),
        kind: type_kind_unknown(),
        element: type_kind_unknown(),
        success: type_kind_unknown(),
        mutable_borrow: false
    };
}

pub fn scalar_type_record(kind: i64) -> TypeRecord {
    return TypeRecord {
        id: scalar_type_id(kind),
        kind: kind,
        element: type_kind_unknown(),
        success: type_kind_unknown(),
        mutable_borrow: false
    };
}

pub fn array_type_record(element: i64) -> TypeRecord {
    return TypeRecord {
        id: type_id_from_shape(type_kind_array(), element, false),
        kind: type_kind_array(),
        element: element,
        success: type_kind_unknown(),
        mutable_borrow: false
    };
}

pub fn borrow_type_record(element: i64, mutable: bool) -> TypeRecord {
    return TypeRecord {
        id: type_id_from_shape(type_kind_borrow(), element, mutable),
        kind: type_kind_borrow(),
        element: element,
        success: type_kind_unknown(),
        mutable_borrow: mutable
    };
}

pub fn error_union_type_record(success: i64, element: i64) -> TypeRecord {
    return TypeRecord {
        id: type_id_error_union(type_id_from_success_shape(success, element)),
        kind: type_kind_error_union(),
        element: element,
        success: success,
        mutable_borrow: false
    };
}

pub fn atomic_type_record(element: i64) -> TypeRecord {
    return TypeRecord {
        id: type_id_from_shape(type_kind_atomic(), element, false),
        kind: type_kind_atomic(),
        element: element,
        success: type_kind_unknown(),
        mutable_borrow: false
    };
}

pub fn mutex_type_record(element: i64) -> TypeRecord {
    return TypeRecord {
        id: type_id_from_shape(type_kind_mutex(), element, false),
        kind: type_kind_mutex(),
        element: element,
        success: type_kind_unknown(),
        mutable_borrow: false
    };
}

pub fn channel_type_record(element: i64) -> TypeRecord {
    return TypeRecord {
        id: type_id_from_shape(type_kind_channel(), element, false),
        kind: type_kind_channel(),
        element: element,
        success: type_kind_unknown(),
        mutable_borrow: false
    };
}

pub fn arena_type_record(element: i64) -> TypeRecord {
    return TypeRecord {
        id: type_id_from_shape(type_kind_arena(), element, false),
        kind: type_kind_arena(),
        element: element,
        success: type_kind_unknown(),
        mutable_borrow: false
    };
}

pub fn raw_pointer_type_record(element: i64, mutable: bool) -> TypeRecord {
    return TypeRecord {
        id: type_id_from_shape(type_kind_raw_pointer(), element, mutable),
        kind: type_kind_raw_pointer(),
        element: element,
        success: type_kind_unknown(),
        mutable_borrow: mutable
    };
}

pub fn dyn_type_record() -> TypeRecord {
    return TypeRecord {
        id: type_id_dyn(),
        kind: type_kind_dyn(),
        element: type_kind_unknown(),
        success: type_kind_unknown(),
        mutable_borrow: false
    };
}

pub fn type_record_from_id(type_id_value: i64) -> TypeRecord {
    if type_id_value == type_id_void() { return scalar_type_record(type_kind_void()); }
    if type_id_value == type_id_i64() { return scalar_type_record(type_kind_i64()); }
    if type_id_value == type_id_bool() { return scalar_type_record(type_kind_bool()); }
    if type_id_value == type_id_slice_u8() { return scalar_type_record(type_kind_slice_u8()); }
    if type_id_value == type_id_allocator() { return scalar_type_record(type_kind_allocator()); }
    if type_id_value == type_id_string() { return scalar_type_record(type_kind_string()); }
    if type_id_value == type_id_u8() { return scalar_type_record(type_kind_u8()); }
    if type_id_value == type_id_i32() { return scalar_type_record(type_kind_i32()); }
    if type_id_value == type_id_ast_source_file() {
        return scalar_type_record(type_kind_ast_source_file());
    }
    if type_id_value == type_id_ast_parse_result() {
        return scalar_type_record(type_kind_ast_parse_result());
    }
    if type_id_value == type_id_ast_node_id() {
        return scalar_type_record(type_kind_ast_node_id());
    }
    if type_id_value == type_id_ast_node() {
        return scalar_type_record(type_kind_ast_node());
    }
    if type_id_value == type_id_ast() {
        return scalar_type_record(type_kind_ast());
    }
    if type_id_value == type_id_ast_child_range() {
        return scalar_type_record(type_kind_ast_child_range());
    }
    if type_id_value == type_id_ast_span() {
        return scalar_type_record(type_kind_ast_span());
    }
    if type_id_value == type_id_ast_symbol_id() {
        return scalar_type_record(type_kind_ast_symbol_id());
    }
    if type_id_value == type_id_dyn() {
        return dyn_type_record();
    }
    if type_id_value == type_id_map_slice_u8_i64() {
        return scalar_type_record(type_kind_map_slice_u8_i64());
    }
    if type_id_value == type_id_fs_dir_entry() {
        return scalar_type_record(type_kind_fs_dir_entry());
    }
    if type_id_value == type_id_io() {
        return scalar_type_record(type_kind_io());
    }
    let stride = type_id_composite_stride();
    let tag = type_id_value % stride;
    let payload = type_id_value / stride;
    if tag == type_kind_atomic() {
        let element = type_record_from_id(payload);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return atomic_type_record(element.kind);
    }
    if tag == type_kind_mutex() {
        let element = type_record_from_id(payload);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return mutex_type_record(element.kind);
    }
    if tag == type_kind_channel() {
        let element = type_record_from_id(payload);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return channel_type_record(element.kind);
    }
    if tag == type_kind_arena() {
        let element = type_record_from_id(payload);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return arena_type_record(element.kind);
    }
    if tag == type_kind_raw_pointer() {
        let element = type_record_from_id(payload);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return raw_pointer_type_record(element.kind, true);
    }
    if tag == type_kind_error_union() {
        let success = type_record_from_id(payload);
        if success.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return error_union_type_record(success.kind, success.element);
    }
    if tag == type_id_mut_borrow_tag() {
        let element = type_record_from_id(payload);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return borrow_type_record(element.kind, true);
    }
    if tag == type_kind_borrow() {
        let element = type_record_from_id(payload);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return borrow_type_record(element.kind, false);
    }
    if tag == type_kind_array() {
        let element = type_record_from_id(payload);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return array_type_record(element.kind);
    }
    return unknown_type_record();
}

fn scalar_type_id(kind: i64) -> i64 {
    if kind == type_kind_void() { return type_id_void(); }
    if kind == type_kind_i64() { return type_id_i64(); }
    if kind == type_kind_bool() { return type_id_bool(); }
    if kind == type_kind_slice_u8() { return type_id_slice_u8(); }
    if kind == type_kind_allocator() { return type_id_allocator(); }
    if kind == type_kind_string() { return type_id_string(); }
    if kind == type_kind_map_slice_u8_i64() { return type_id_map_slice_u8_i64(); }
    if kind == type_kind_u8() { return type_id_u8(); }
    if kind == type_kind_i32() { return type_id_i32(); }
    if kind == type_kind_fs_dir_entry() { return type_id_fs_dir_entry(); }
    if kind == type_kind_io() { return type_id_io(); }
    if kind == type_kind_dyn() { return type_id_dyn(); }
    if kind == type_kind_ast_source_file() { return type_id_ast_source_file(); }
    if kind == type_kind_ast_parse_result() { return type_id_ast_parse_result(); }
    if kind == type_kind_ast_node_id() { return type_id_ast_node_id(); }
    if kind == type_kind_ast_node() { return type_id_ast_node(); }
    if kind == type_kind_ast() { return type_id_ast(); }
    if kind == type_kind_ast_child_range() { return type_id_ast_child_range(); }
    if kind == type_kind_ast_span() { return type_id_ast_span(); }
    if kind == type_kind_ast_symbol_id() { return type_id_ast_symbol_id(); }
    return type_id_unknown();
}

fn type_id_composite_stride() -> i64 {
    return 100;
}

fn type_id_mut_borrow_tag() -> i64 {
    return 12;
}

fn type_id_from_shape(kind: i64, element: i64, mutable_borrow: bool) -> i64 {
    if kind == type_kind_array() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_array(element_id);
    }
    if kind == type_kind_borrow() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_borrow(element_id, mutable_borrow);
    }
    if kind == type_kind_atomic() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_atomic(element_id);
    }
    if kind == type_kind_mutex() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_mutex(element_id);
    }
    if kind == type_kind_channel() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_channel(element_id);
    }
    if kind == type_kind_arena() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_arena(element_id);
    }
    if kind == type_kind_raw_pointer() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_raw_pointer(element_id);
    }
    return scalar_type_id(kind);
}

fn type_id_from_success_shape(success: i64, element: i64) -> i64 {
    if success == type_kind_array() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_array(element_id);
    }
    if success == type_kind_atomic() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_atomic(element_id);
    }
    if success == type_kind_mutex() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_mutex(element_id);
    }
    if success == type_kind_channel() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_channel(element_id);
    }
    if success == type_kind_arena() {
        let element_id = scalar_type_id(element);
        if element_id == type_id_unknown() {
            return type_id_unknown();
        }
        return type_id_arena(element_id);
    }
    return scalar_type_id(success);
}

// type_record_from_text is the single compatibility adapter for legacy type
// spellings. New backend code should prefer TypeId facts or type_record_from_node.
// Delete this adapter once every backend caller receives checker-emitted TypeId
// facts for signatures and type arguments instead of AST spelling nodes.
pub fn type_record_from_text(type_text: []u8) -> TypeRecord {
    let trimmed = std::mem::trim_ascii(type_text);
    if std::mem::len(trimmed) == 0 { return scalar_type_record(type_kind_void()); }
    if std::mem::equal_bytes(trimmed, "void") { return scalar_type_record(type_kind_void()); }
    if std::mem::equal_bytes(trimmed, "i64") { return scalar_type_record(type_kind_i64()); }
    if std::mem::equal_bytes(trimmed, "u8") { return scalar_type_record(type_kind_u8()); }
    if std::mem::equal_bytes(trimmed, "i32") { return scalar_type_record(type_kind_i32()); }
    if std::mem::equal_bytes(trimmed, "bool") { return scalar_type_record(type_kind_bool()); }
    if std::mem::equal_bytes(trimmed, "[]u8") { return scalar_type_record(type_kind_slice_u8()); }
    if std::mem::equal_bytes(trimmed, "Allocator") { return scalar_type_record(type_kind_allocator()); }
    if std::mem::equal_bytes(trimmed, "std::mem::Allocator") { return scalar_type_record(type_kind_allocator()); }
    if std::mem::equal_bytes(trimmed, "Io") { return scalar_type_record(type_kind_io()); }
    if std::mem::equal_bytes(trimmed, "std::string::String") { return scalar_type_record(type_kind_string()); }
    if std::mem::equal_bytes(trimmed, "std::fs::DirEntry") { return scalar_type_record(type_kind_fs_dir_entry()); }
    if std::mem::equal_bytes(trimmed, "std::kizu::ast::SourceFile") or
        std::mem::equal_bytes(trimmed, "SourceFile") {
        return scalar_type_record(type_kind_ast_source_file());
    }
    if std::mem::equal_bytes(trimmed, "std::kizu::ast::ParseResult") or
        std::mem::equal_bytes(trimmed, "ParseResult") {
        return scalar_type_record(type_kind_ast_parse_result());
    }
    if std::mem::equal_bytes(trimmed, "std::kizu::ast::NodeId") or
        std::mem::equal_bytes(trimmed, "NodeId") {
        return scalar_type_record(type_kind_ast_node_id());
    }
    if std::mem::equal_bytes(trimmed, "std::kizu::ast::AstNode") or
        std::mem::equal_bytes(trimmed, "AstNode") {
        return scalar_type_record(type_kind_ast_node());
    }
    if std::mem::equal_bytes(trimmed, "std::kizu::ast::Ast") or
        std::mem::equal_bytes(trimmed, "Ast") {
        return scalar_type_record(type_kind_ast());
    }
    if std::mem::equal_bytes(trimmed, "std::kizu::ast::ChildRange") or
        std::mem::equal_bytes(trimmed, "ChildRange") {
        return scalar_type_record(type_kind_ast_child_range());
    }
    if std::mem::equal_bytes(trimmed, "std::kizu::ast::Span") or
        std::mem::equal_bytes(trimmed, "Span") {
        return scalar_type_record(type_kind_ast_span());
    }
    if std::mem::equal_bytes(trimmed, "std::kizu::ast::SymbolId") or
        std::mem::equal_bytes(trimmed, "SymbolId") {
        return scalar_type_record(type_kind_ast_symbol_id());
    }
    let dyn_record = type_record_dyn_from_text(trimmed);
    if dyn_record.kind != type_kind_unknown() { return dyn_record; }
    let borrowed = type_record_borrow_from_text(trimmed);
    if borrowed.kind != type_kind_unknown() { return borrowed; }
    let error_union = type_record_untyped_error_union_from_text(trimmed);
    if error_union.kind != type_kind_unknown() { return error_union; }
    let generic = type_record_generic_from_text(trimmed);
    if generic.kind != type_kind_unknown() { return generic; }
    return unknown_type_record();
}

fn type_record_dyn_from_text(type_text: []u8) -> TypeRecord {
    let trimmed = std::mem::trim_ascii(type_text);
    if !std::mem::starts_with(trimmed, "dyn ") {
        return unknown_type_record();
    }
    let length = std::mem::len(trimmed);
    let contract_name = std::mem::trim_ascii(trimmed[4..length]);
    if std::mem::len(contract_name) == 0 {
        return unknown_type_record();
    }
    return dyn_type_record();
}

pub fn type_record_from_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> TypeRecord {
    return type_record_from_text(ast_node_text(text, ast, type_node));
}

fn type_record_generic_from_text(type_text: []u8) -> TypeRecord {
    let parts = type_generic_parts(type_text);
    if !parts.ok {
        return unknown_type_record();
    }
    let callee = type_text[parts.callee_start..parts.callee_end];
    if std::mem::equal_bytes(callee, "std::array::Array") and parts.arg_count == 1 {
        let element = type_record_from_text(type_text[parts.arg0_start..parts.arg0_end]);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return array_type_record(element.kind);
    }
    if std::mem::equal_bytes(callee, "std::atomic::Atomic") and parts.arg_count == 1 {
        let element = type_record_from_text(type_text[parts.arg0_start..parts.arg0_end]);
        if element.kind != type_kind_bool() and !type_kind_is_integer_scalar(element.kind) {
            return unknown_type_record();
        }
        return atomic_type_record(element.kind);
    }
    if std::mem::equal_bytes(callee, "std::sync::Mutex") and parts.arg_count == 1 {
        let element = type_record_from_text(type_text[parts.arg0_start..parts.arg0_end]);
        if element.kind != type_kind_bool() and !type_kind_is_integer_scalar(element.kind) {
            return unknown_type_record();
        }
        return mutex_type_record(element.kind);
    }
    if std::mem::equal_bytes(callee, "std::channel::Channel") and parts.arg_count == 1 {
        let element = type_record_from_text(type_text[parts.arg0_start..parts.arg0_end]);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return channel_type_record(element.kind);
    }
    if std::mem::equal_bytes(callee, "std::arena::Arena") and parts.arg_count == 1 {
        let element = type_record_from_text(type_text[parts.arg0_start..parts.arg0_end]);
        if element.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return arena_type_record(element.kind);
    }
    if std::mem::equal_bytes(callee, "ptr") or std::mem::equal_bytes(callee, "?ptr") {
        if parts.arg_count == 1 {
            let element = type_record_raw_pointer_element_from_text(type_text[parts.arg0_start..parts.arg0_end]);
            if element.kind == type_kind_unknown() {
                return unknown_type_record();
            }
            return raw_pointer_type_record(element.kind, true);
        }
    }
    if std::mem::equal_bytes(callee, "std::map::Map") and parts.arg_count == 2 {
        let key = type_record_from_text(type_text[parts.arg0_start..parts.arg0_end]);
        let value = type_record_from_text(type_text[parts.arg1_start..parts.arg1_end]);
        if key.kind == type_kind_slice_u8() and type_kind_is_integer_scalar(value.kind) {
            return scalar_type_record(type_kind_map_slice_u8_i64());
        }
    }
    return unknown_type_record();
}

fn type_record_raw_pointer_element_from_text(type_text: []u8) -> TypeRecord {
    let trimmed = std::mem::trim_ascii(type_text);
    if std::mem::equal_bytes(trimmed, "const") {
        return unknown_type_record();
    }
    if std::mem::starts_with(trimmed, "const ") {
        let trimmed_len = std::mem::len(trimmed);
        let rest = std::mem::trim_ascii(trimmed[6..trimmed_len]);
        return type_record_from_text(rest);
    }
    return type_record_from_text(trimmed);
}

pub fn type_kind_is_integer_scalar(kind: i64) -> bool {
    return kind == type_kind_i64() or kind == type_kind_u8() or kind == type_kind_i32();
}

pub fn map_type_parts_from_text(type_text: []u8) -> TypeMapParts {
    let trimmed = std::mem::trim_ascii(type_text);
    let length = std::mem::len(trimmed);
    if length == 0 {
        return invalid_type_map_parts();
    }
    if trimmed[0] == cast<u8>(38) {
        return map_type_parts_from_borrow_text(trimmed);
    }
    return map_type_parts_from_referent_text(trimmed, 0, false, false);
}

fn map_type_parts_from_borrow_text(type_text: []u8) -> TypeMapParts {
    let length = std::mem::len(type_text);
    let referent_start = type_first_non_space(type_text, 1, length);
    if referent_start >= length {
        return invalid_type_map_parts();
    }
    let referent_end = type_last_non_space_before(type_text, referent_start, length);
    if referent_start >= referent_end {
        return invalid_type_map_parts();
    }
    let referent = type_text[referent_start..referent_end];
    if std::mem::equal_bytes(referent, "var") {
        return invalid_type_map_parts();
    }
    if std::mem::starts_with(referent, "var ") {
        let after_var = type_first_non_space(type_text, referent_start + 4, referent_end);
        if after_var >= referent_end {
            return invalid_type_map_parts();
        }
        return map_type_parts_from_referent_text(type_text[after_var..referent_end], after_var, true, true);
    }
    return map_type_parts_from_referent_text(referent, referent_start, true, false);
}

fn map_type_parts_from_referent_text(
    map_text: []u8,
    offset: i64,
    borrowed: bool,
    mutable_borrow: bool
) -> TypeMapParts {
    let parts = type_generic_parts(map_text);
    if !parts.ok {
        return invalid_type_map_parts();
    }
    let callee = map_text[parts.callee_start..parts.callee_end];
    if !std::mem::equal_bytes(callee, "std::map::Map") {
        return invalid_type_map_parts();
    }
    if parts.arg_count != 2 {
        return invalid_type_map_parts();
    }
    let key = type_record_from_text(map_text[parts.arg0_start..parts.arg0_end]);
    if key.kind != type_kind_slice_u8() {
        return invalid_type_map_parts();
    }
    let value_start = offset + parts.arg1_start;
    let value_end = offset + parts.arg1_end;
    return TypeMapParts {
        ok: true,
        value_start: value_start,
        value_end: value_end,
        borrowed: borrowed,
        mutable_borrow: mutable_borrow
    };
}

fn invalid_type_map_parts() -> TypeMapParts {
    return TypeMapParts {
        ok: false,
        value_start: -1,
        value_end: -1,
        borrowed: false,
        mutable_borrow: false
    };
}

pub fn box_type_parts_from_text(type_text: []u8) -> TypeBoxParts {
    let trimmed = std::mem::trim_ascii(type_text);
    let parts = type_generic_prefix_parts(trimmed);
    if !parts.ok {
        return invalid_type_box_parts();
    }
    let callee = trimmed[parts.callee_start..parts.callee_end];
    if !std::mem::equal_bytes(callee, "std::mem::Box") {
        return invalid_type_box_parts();
    }
    if parts.arg_count != 1 {
        return invalid_type_box_parts();
    }
    return TypeBoxParts {
        ok: true,
        value_start: parts.arg0_start,
        value_end: parts.arg0_end
    };
}

fn invalid_type_box_parts() -> TypeBoxParts {
    return TypeBoxParts {
        ok: false,
        value_start: -1,
        value_end: -1
    };
}

pub fn type_text_is_arena_handle(type_text: []u8) -> bool {
    let trimmed = std::mem::trim_ascii(type_text);
    let parts = type_generic_parts(trimmed);
    if !parts.ok {
        return false;
    }
    if parts.arg_count != 1 {
        return false;
    }
    let callee = trimmed[parts.callee_start..parts.callee_end];
    return std::mem::equal_bytes(callee, "std::arena::Handle");
}

fn type_record_untyped_error_union_from_text(type_text: []u8) -> TypeRecord {
    let length = std::mem::len(type_text);
    if length < 2 {
        return unknown_type_record();
    }
    if type_text[0] != cast<u8>(33) {
        return unknown_type_record();
    }
    let success = type_record_from_text(type_text[1..length]);
    if success.kind == type_kind_unknown() {
        return unknown_type_record();
    }
    return error_union_type_record(success.kind, success.element);
}

fn type_record_borrow_from_text(type_text: []u8) -> TypeRecord {
    let length = std::mem::len(type_text);
    if length < 2 {
        return unknown_type_record();
    }
    if type_text[0] != cast<u8>(38) {
        return unknown_type_record();
    }
    let referent = std::mem::trim_ascii(type_text[1..length]);
    if std::mem::equal_bytes(referent, "var") {
        return unknown_type_record();
    }
    if std::mem::starts_with(referent, "var ") {
        let referent_len = std::mem::len(referent);
        let unwrapped = referent[4..referent_len];
        let record = type_record_from_text(unwrapped);
        if record.kind == type_kind_unknown() {
            return unknown_type_record();
        }
        return borrow_type_record(record.kind, true);
    }
    let record = type_record_from_text(referent);
    if record.kind == type_kind_unknown() {
        return unknown_type_record();
    }
    return borrow_type_record(record.kind, false);
}

fn invalid_type_generic_parts() -> TypeGenericParts {
    return TypeGenericParts {
        ok: false,
        callee_start: -1,
        callee_end: -1,
        arg0_start: -1,
        arg0_end: -1,
        arg1_start: -1,
        arg1_end: -1,
        arg_count: 0
    };
}

fn type_generic_parts(
    type_text: []u8
) -> TypeGenericParts {
    let open = type_top_level_open_angle(type_text);
    if open < 0 {
        return invalid_type_generic_parts();
    }
    let close = type_matching_close_angle(type_text, open);
    if close < 0 {
        return invalid_type_generic_parts();
    }
    if type_has_non_space_after(type_text, close + 1) {
        return invalid_type_generic_parts();
    }
    let callee_start = type_first_non_space(type_text, 0, open);
    let callee_end = type_last_non_space_before(type_text, callee_start, open);
    if callee_start >= callee_end {
        return invalid_type_generic_parts();
    }
    return type_generic_arg_parts(type_text, callee_start, callee_end, open + 1, close);
}

fn type_generic_prefix_parts(
    type_text: []u8
) -> TypeGenericParts {
    let open = type_top_level_open_angle(type_text);
    if open < 0 {
        return invalid_type_generic_parts();
    }
    let close = type_matching_close_angle(type_text, open);
    if close < 0 {
        return invalid_type_generic_parts();
    }
    let callee_start = type_first_non_space(type_text, 0, open);
    let callee_end = type_last_non_space_before(type_text, callee_start, open);
    if callee_start >= callee_end {
        return invalid_type_generic_parts();
    }
    return type_generic_arg_parts(type_text, callee_start, callee_end, open + 1, close);
}

fn type_top_level_open_angle(type_text: []u8) -> i64 {
    var index = 0;
    while index < std::mem::len(type_text) {
        if type_text[index] == cast<u8>(60) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn type_matching_close_angle(type_text: []u8, open: i64) -> i64 {
    var depth = 0;
    var index = open;
    while index < std::mem::len(type_text) {
        let byte = type_text[index];
        if byte == cast<u8>(60) {
            depth = depth + 1;
        } else {
            if byte == cast<u8>(62) {
                depth = depth - 1;
                if depth == 0 {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

fn type_has_non_space_after(type_text: []u8, start: i64) -> bool {
    var index = start;
    while index < std::mem::len(type_text) {
        if !type_byte_is_ascii_space(type_text[index]) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn type_first_non_space(type_text: []u8, start: i64, end: i64) -> i64 {
    var index = start;
    while index < end and type_byte_is_ascii_space(type_text[index]) {
        index = index + 1;
    }
    return index;
}

fn type_last_non_space_before(type_text: []u8, start: i64, end: i64) -> i64 {
    var index = end;
    while index > start and type_byte_is_ascii_space(type_text[index - 1]) {
        index = index - 1;
    }
    return index;
}

fn type_byte_is_ascii_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or
        byte == cast<u8>(9) or
        byte == cast<u8>(10) or
        byte == cast<u8>(13);
}

fn type_generic_arg_parts(
    type_text: []u8,
    callee_start: i64,
    callee_end: i64,
    start: i64,
    end: i64
) -> TypeGenericParts {
    let missing = 0 - 1;
    var arg_count = 0;
    var arg0_start = missing;
    var arg0_end = missing;
    var arg1_start = missing;
    var arg1_end = missing;
    var depth = 0;
    var part_start = start;
    var index = start;
    while index <= end {
        var at_part_end = false;
        if index == end {
            at_part_end = true;
        } else {
            if type_text[index] == cast<u8>(44) {
                if depth == 0 {
                    at_part_end = true;
                }
            }
        }
        if at_part_end {
            let trimmed_part_start = type_first_non_space(type_text, part_start, index);
            let part_end = type_last_non_space_before(type_text, trimmed_part_start, index);
            if trimmed_part_start >= part_end {
                return invalid_type_generic_parts();
            }
            if arg_count == 0 {
                arg0_start = trimmed_part_start;
                arg0_end = part_end;
            } else {
                if arg_count == 1 {
                    arg1_start = trimmed_part_start;
                    arg1_end = part_end;
                } else {
                    return invalid_type_generic_parts();
                }
            }
            arg_count = arg_count + 1;
            part_start = index + 1;
        } else {
            if type_text[index] == cast<u8>(60) {
                depth = depth + 1;
            } else {
                if type_text[index] == cast<u8>(62) {
                    depth = depth - 1;
                    if depth < 0 {
                        return invalid_type_generic_parts();
                    }
                }
            }
        }
        index = index + 1;
    }
    let ok = arg_count > 0;
    return TypeGenericParts {
        ok: ok,
        callee_start: callee_start,
        callee_end: callee_end,
        arg0_start: arg0_start,
        arg0_end: arg0_end,
        arg1_start: arg1_start,
        arg1_end: arg1_end,
        arg_count: arg_count
    };
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 borrows text {
    let node = ast.get(node_id);
    let span = node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
