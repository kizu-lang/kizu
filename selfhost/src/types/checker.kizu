fn first_argument_type_mismatch_in_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<FunctionParamType>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ArgumentTypeSummary {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        let found = try first_argument_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            child,
            local_types,
            function_param_types,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_argument_type_mismatch();
}

fn first_argument_type_mismatch_in_expression_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expressions: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<FunctionParamType>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ArgumentTypeSummary {
    var index = 0;
    while index < expressions.len {
        let child = try ast.child_at(expressions, index);
        let found = try first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            child,
            local_types,
            function_param_types,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_argument_type_mismatch();
}

fn first_argument_type_mismatch_in_expression(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<FunctionParamType>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ArgumentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Call(call_node) => return first_argument_type_mismatch_in_call(
            allocator,
            file,
            ast,
            call_node.callee,
            call_node.args,
            local_types,
            function_param_types,
            function_returns
        );,
        Prefix(prefix_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            prefix_node.right,
            local_types,
            function_param_types,
            function_returns
        );,
        Binary(binary) => return first_argument_type_mismatch_in_two_expressions(
            allocator,
            file,
            ast,
            binary.left,
            binary.right,
            local_types,
            function_param_types,
            function_returns
        );,
        FieldExpr(field_expr_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            local_types,
            function_param_types,
            function_returns
        );,
        DerefExpr(deref_expr_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            deref_expr_node.receiver,
            local_types,
            function_param_types,
            function_returns
        );,
        TypeApplyExpr(type_apply) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            type_apply.callee,
            local_types,
            function_param_types,
            function_returns
        );,
        CastExpr(cast_expr) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            cast_expr.value,
            local_types,
            function_param_types,
            function_returns
        );,
        IndexExpr(index_expr) => return first_argument_type_mismatch_in_two_expressions(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            local_types,
            function_param_types,
            function_returns
        );,
        StructLiteralExpr(struct_literal) => return first_argument_type_mismatch_in_expression_range(
            allocator,
            file,
            ast,
            struct_literal.fields,
            local_types,
            function_param_types,
            function_returns
        );,
        StructFieldInit(struct_field_init) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            struct_field_init.value,
            local_types,
            function_param_types,
            function_returns
        );,
        ArenaNewExpr(arena_new) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            arena_new.allocator,
            local_types,
            function_param_types,
            function_returns
        );,
        TryExpr(try_expr_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            try_expr_node.value,
            local_types,
            function_param_types,
            function_returns
        );,
        ComptimeExpr(comptime_expr_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            local_types,
            function_param_types,
            function_returns
        );,
        Match(match_node) => return first_argument_type_mismatch_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            function_param_types,
            function_returns
        );,
        _ => return no_argument_type_mismatch();,
    }
}

fn first_argument_type_mismatch_in_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<FunctionParamType>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ArgumentTypeSummary {
    let call_found = try argument_type_mismatch_for_call(
        allocator,
        file,
        ast,
        callee,
        args,
        local_types,
        function_param_types,
        function_returns
    );
    if call_found.found {
        return call_found;
    }
    let callee_found = try first_argument_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        callee,
        local_types,
        function_param_types,
        function_returns
    );
    if callee_found.found {
        return callee_found;
    }
    return first_argument_type_mismatch_in_expression_range(
        allocator,
        file,
        ast,
        args,
        local_types,
        function_param_types,
        function_returns
    );
}

fn argument_type_mismatch_for_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<FunctionParamType>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ArgumentTypeSummary {
    let callee_text = ast_node_text(file, ast, callee);
    if should_skip_function_reference(callee_text) or
        last_segment_starts_with_uppercase(callee_text) or
        is_generic_constructor_text(callee_text) or
        is_qualified_name(callee_text) {
        return no_argument_type_mismatch();
    }
    var index = 0;
    while index < args.len {
        let arg = try ast.child_at(args, index);
        let expected = try lookup_function_param_type(function_param_types, callee_text, index);
        if !expected.found {
            return no_argument_type_mismatch();
        }
        let actual = try infer_expression_type(
            allocator,
            file,
            ast,
            arg,
            local_types,
            function_returns
        );
        if known_type_mismatch(expected.type_name, actual) {
            let arg_node = ast.get(arg);
            return argument_type_summary(
                true,
                arg_node.span.start,
                arg_node.span.end,
                expected.type_name,
                actual
            );
        }
        index = index + 1;
    }
    return no_argument_type_mismatch();
}

fn first_argument_type_mismatch_in_two_expressions(
    allocator: Allocator,
