import selfhost::parser;
import selfhost::resolver;
import selfhost::source;
import selfhost::types::ast_text;
import selfhost::types::body_scan;
import selfhost::types::diagnostic_summary;
import selfhost::types::expression_infer;
import selfhost::types::function_call_scan_ast;
import selfhost::types::function_calls;
import selfhost::types::local_facts;
import selfhost::types::model;
import selfhost::types::type_ref_ast;
import selfhost::types::type_ref_scan_ast;
import selfhost::types::type_refs;

struct TypeScanSummary {
    next: i64,
    typed_nodes: i64,
    diagnostics: i64,
}

struct MatchArmScanSummary {
    explicit_count: i64,
    wildcard: bool,
    diagnostic_found: bool,
    diagnostic_kind: i64,
    diagnostic_name: []u8,
    diagnostic_tag: []u8,
}

struct FunctionParamType {
    function_name: []u8,
    index: i64,
    type_name: []u8,
}

struct FunctionParamLookup {
    found: bool,
    type_name: []u8,
}

pub fn check(resolved: resolver::ResolveSummary) -> model::TypeSummary {
    return model::TypeSummary {
        modules: resolved.modules,
        symbols: resolved.symbols,
        functions: 0,
        typed_nodes: resolved.symbols,
        diagnostics: resolved.diagnostics
    };
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    resolved: resolver::ResolveSummary
) -> !model::TypeSummary {
    var kinds = std::map::Map<[]u8, model::TypeKind>(allocator);
    var arities = std::map::Map<[]u8, i64>(allocator);
    var copyable = std::map::Map<[]u8, bool>(allocator);
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var function_returns = std::map::Map<[]u8, []u8>(allocator);
    var parsed_frontend = std::array::Array<std::kizu::ast::ParseResult>(allocator);
    var parsed_frontend_files = std::array::Array<i64>(allocator);
    try type_refs::seed_builtin_types(kinds, arities, copyable);

    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if source::is_source_code(file.kind) {
            let result = try parser::parse_checked_file(allocator, file.path, file.text);
            try type_refs::collect_declared_types_from_ast(
                allocator,
                file,
                result.ast,
                result.root,
                kinds,
                arities,
                copyable
            );
            try function_calls::collect_function_signatures_from_ast(
                allocator,
                file,
                &result.ast,
                result.root,
                function_arities,
                function_returns
            );
            if source::is_frontend_source(file.kind) {
                try parsed_frontend.append(result);
                try parsed_frontend_files.append(index);
            } else {
                result.deinit();
            }
        }
        index = index + 1;
    }

    var typed_nodes = 0;
    var diagnostics = resolved.diagnostics;
    while parsed_frontend.len() > 0 {
        let result = try parsed_frontend.pop();
        let file_index = try parsed_frontend_files.pop();
        let file = try files.at(file_index);
        let scan = try type_ref_scan_ast::check_file_type_references_from_ast(
            allocator,
            file,
            &result.ast,
            result.root,
            kinds,
            arities
        );
        typed_nodes = typed_nodes + scan.typed_nodes;
        diagnostics = diagnostics + scan.diagnostics;
        let call_scan = try function_call_scan_ast::check_file_function_references_from_ast(
            allocator,
            file,
            &result.ast,
            result.root,
            function_arities
        );
        let body_scan = try check_file_body_ast_node(
            allocator,
            file,
            result.ast,
            result.root,
            function_returns
        );
        typed_nodes = typed_nodes + call_scan.typed_nodes;
        diagnostics = diagnostics + call_scan.diagnostics;
        typed_nodes = typed_nodes + body_scan.typed_nodes;
        diagnostics = diagnostics + body_scan.diagnostics;
        result.deinit();
    }

    let summary = model::TypeSummary {
        modules: resolved.modules,
        symbols: kinds.len(),
        functions: function_arities.len(),
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
    parsed_frontend_files.deinit();
    parsed_frontend.deinit();
    kinds.deinit();
    arities.deinit();
    copyable.deinit();
    function_arities.deinit();
    function_returns.deinit();
    return summary;
}

pub fn first_package_function_call_error_ast_node(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !model::FunctionCallSummary {
    return function_calls::first_package_function_call_error_ast_node(
        allocator,
        files,
        file,
        ast,
        root
    );
}

pub fn first_pre_move_check_diagnostic_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !model::CheckDiagnosticSummary {
    var kinds = std::map::Map<[]u8, model::TypeKind>(allocator);
    var arities = std::map::Map<[]u8, i64>(allocator);
    var copyable = std::map::Map<[]u8, bool>(allocator);
    try type_refs::seed_builtin_types(kinds, arities, copyable);
    try type_refs::collect_declared_types_from_ast(allocator, file, ast, root, kinds, arities, copyable);
    let diagnostic = try first_pre_move_check_diagnostic_ast_node_with_types(
        allocator,
        file,
        ast,
        root,
        kinds,
        arities,
        copyable
    );
    kinds.deinit();
    arities.deinit();
    copyable.deinit();
    return diagnostic;
}

pub fn first_pre_move_check_diagnostic_ast_node_with_types(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !model::CheckDiagnosticSummary {
    try type_refs::collect_type_parameters_from_ast(file, ast, root, kinds, arities, copyable);
    let type_ref = try type_ref_ast::first_type_error_in_ast(allocator, file, ast, root, kinds, arities);
    if type_ref.found {
        return diagnostic_summary::from_type_reference(type_ref);
    }

    var function_returns = std::map::Map<[]u8, []u8>(allocator);
    var enum_counts = std::map::Map<[]u8, i64>(allocator);
    var enum_tags = std::map::Map<[]u8, bool>(allocator);
    try collect_function_returns_from_ast(allocator, file, ast, root, function_returns);
    try collect_match_enum_types(allocator, file, ast, root, enum_counts, enum_tags);
    var diagnostic = diagnostic_summary::none();
    let match_diagnostic = try first_match_diagnostic_node(
        allocator,
        file,
        ast,
        root,
        enum_counts,
        enum_tags,
        function_returns
    );
    if match_diagnostic.found {
        diagnostic = diagnostic_summary::from_match(match_diagnostic);
    } else {
        let return_type = try first_return_type_mismatch_node(
            allocator,
            file,
            ast,
            root,
            function_returns
        );
        if return_type.found {
            diagnostic = diagnostic_summary::from_return_type(return_type);
        } else {
            let missing_return = try first_missing_return_node(
                allocator,
                file,
                ast,
                root,
                function_returns
            );
            if missing_return.found {
                diagnostic = missing_return;
            }
        }
    }
    enum_counts.deinit();
    enum_tags.deinit();
    function_returns.deinit();
    return diagnostic;
}

pub fn first_post_move_check_diagnostic_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !model::CheckDiagnosticSummary {
    var function_returns = std::map::Map<[]u8, []u8>(allocator);
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var local_function_param_types = std::array::Array<FunctionParamType>(allocator);
    try collect_function_returns_from_ast(allocator, file, ast, root, function_returns);
    try function_calls::collect_function_arities_from_ast(allocator, file, &ast, root, function_arities);
    try collect_local_function_param_types(
        allocator,
        file,
        ast,
        root,
        local_function_param_types
    );

    var diagnostic = diagnostic_summary::none();
    let local_call = try function_calls::first_function_call_error_ast_node(
        allocator,
        file,
        &ast,
        root,
        function_arities,
        true
    );
    if local_call.found {
        diagnostic = diagnostic_summary::from_function_call(local_call);
    } else {
        let undefined = try first_undefined_variable_node(
            allocator,
            file,
            ast,
            root,
            function_returns
        );
        if undefined.found {
            diagnostic = diagnostic_summary::from_undefined_variable(undefined);
        } else {
            let argument = try first_argument_type_mismatch_node(
                allocator,
                file,
                ast,
                root,
                local_function_param_types,
                function_returns
            );
            if argument.found {
                diagnostic = diagnostic_summary::from_argument_type(argument);
            } else {
                let immutable = try first_immutable_assignment_node(
                    allocator,
                    file,
                    ast,
                    root,
                    function_returns
                );
                if immutable.found {
                    diagnostic = diagnostic_summary::from_immutable_assignment(
                        immutable
                    );
                } else {
                    let invalid = try first_invalid_assignment_target_node(
                        file,
                        ast,
                        root
                    );
                    if invalid.found {
                        diagnostic = diagnostic_summary::from_invalid_assignment_target(
                            invalid
                        );
                    } else {
                        let assignment = try first_assignment_type_mismatch_node(
                            allocator,
                            file,
                            ast,
                            root,
                            function_returns
                        );
                        if assignment.found {
                            diagnostic = diagnostic_summary::from_assignment_type(
                                assignment
                            );
                        }
                    }
                }
            }
        }
    }
    local_function_param_types.deinit();
    function_arities.deinit();
    function_returns.deinit();
    return diagnostic;
}

fn collect_local_function_param_types(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return collect_local_function_param_types_in_range(
            allocator,
            file,
            ast,
            program.declarations,
            param_types
        );,
        FnDecl(fn_decl) => return collect_function_param_types(
            allocator,
            file,
            ast,
            ast_text::ast_node_text(file, ast, fn_decl.name),
            fn_decl.params,
            param_types
        );,
        _ => return;,
    }
}

fn collect_local_function_param_types_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_local_function_param_types(allocator, file, ast, child, param_types);
        index = index + 1;
    }
    return;
}

fn collect_function_param_types(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    params: std::kizu::ast::ChildRange,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        try collect_function_param_type(file, ast, function_name, child, index, param_types);
        index = index + 1;
    }
    return;
}

fn collect_function_param_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    node_id: std::kizu::ast::NodeId,
    param_index: i64,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return collect_function_param_node_type(
            file,
            ast,
            function_name,
            param_node.type_node,
            param_index,
            param_types
        );,
        _ => return;,
    }
}

fn collect_function_param_node_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    type_node: std::kizu::ast::NodeId,
    param_index: i64,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    try param_types.append(function_param_type(
        function_name,
        param_index,
        ast_text::ast_return_type_text(file, ast, type_node)
    ));
    return;
}

fn function_param_type(
    function_name: []u8,
    index: i64,
    type_name: []u8
) -> FunctionParamType {
    return FunctionParamType {
        function_name: function_name,
        index: index,
        type_name: type_name
    };
}

fn function_param_lookup(found: bool, type_name: []u8) -> FunctionParamLookup {
    return FunctionParamLookup {
        found: found,
        type_name: type_name
    };
}

fn lookup_function_param_type(
    param_types: &std::array::Array<FunctionParamType>,
    function_name: []u8,
    param_index: i64
) -> !FunctionParamLookup {
    var index = 0;
    while index < param_types.len() {
        let param_type = try param_types.at(index);
        if std::mem::equal_bytes(param_type.function_name, function_name) and
            param_type.index == param_index {
            return function_param_lookup(true, param_type.type_name);
        }
        index = index + 1;
    }
    return function_param_lookup(false, "");
}

fn collect_function_returns_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    returns: &var std::map::Map<[]u8, []u8>
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return collect_function_returns_in_range(
            allocator,
            file,
            ast,
            program.declarations,
            returns
        );,
        FnDecl(fn_decl) => return collect_function_return(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.return_type,
            returns
        );,
        _ => return;,
    }
}

fn collect_function_returns_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    returns: &var std::map::Map<[]u8, []u8>
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_function_returns_from_ast(allocator, file, ast, child, returns);
        index = index + 1;
    }
    return;
}

fn collect_function_return(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    returns: &var std::map::Map<[]u8, []u8>
) -> !void {
    var qualified = std::string::String(allocator);
    try ast_text::append_module_name(qualified, file);
    try qualified.append_bytes("::");
    try qualified.append_bytes(ast_text::ast_node_text(file, ast, name));
    let key = qualified.as_bytes();
    if returns.contains(key) {
        return error("duplicate function");
    }
    try returns.insert(key, ast_text::ast_return_type_text(file, ast, return_type));
    qualified.deinit();
    return;
}

fn check_file_body_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !TypeScanSummary {
    let traversal = try body_scan::scan_body_ast_node(ast, root);
    let statements = try check_ast_statements(
        allocator,
        file,
        ast,
        root,
        function_returns
    );
    let traversal_summary = type_scan_summary(
        traversal.next,
        traversal.typed_nodes,
        traversal.diagnostics
    );
    let summary = merge_type_summaries(traversal_summary, statements);
    return summary;
}

fn check_ast_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !TypeScanSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return check_statement_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        Empty => return type_scan_summary(0, 0, 0);,
        ImportDecl(import_decl) => return type_scan_summary(0, 0, 0);,
        StructDecl(struct_decl) => return type_scan_summary(0, 0, 0);,
        EnumDecl(enum_decl) => return type_scan_summary(0, 0, 0);,
        UnionDecl(union_decl) => return type_scan_summary(0, 0, 0);,
        FnDecl(fn_decl) => return check_function_statements(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            function_returns
        );,
        Int(int_node) => return type_scan_summary(0, 0, 0);,
        String(string_node) => return type_scan_summary(0, 0, 0);,
        TypeName(type_name) => return type_scan_summary(0, 0, 0);,
        Var(var_node) => return type_scan_summary(0, 0, 0);,
        Bool(bool_node) => return type_scan_summary(0, 0, 0);,
        Prefix(prefix_node) => return type_scan_summary(0, 0, 0);,
        Binary(binary) => return type_scan_summary(0, 0, 0);,
        FieldExpr(field_expr_node) => return type_scan_summary(0, 0, 0);,
        DerefExpr(deref_expr_node) => return type_scan_summary(0, 0, 0);,
        Call(call_node) => return type_scan_summary(0, 0, 0);,
        TypeApplyExpr(type_apply) => return type_scan_summary(0, 0, 0);,
        CastExpr(cast_expr) => return type_scan_summary(0, 0, 0);,
        IndexExpr(index_expr) => return type_scan_summary(0, 0, 0);,
        StructLiteralExpr(struct_literal) => return type_scan_summary(0, 0, 0);,
        StructFieldInit(struct_field_init) => return type_scan_summary(0, 0, 0);,
        ArenaNewExpr(arena_new) => return type_scan_summary(0, 0, 0);,
        TryExpr(try_expr_node) => return type_scan_summary(0, 0, 0);,
        ComptimeExpr(comptime_expr_node) => return type_scan_summary(0, 0, 0);,
        Block(block) => return type_scan_summary(0, 0, 0);,
        If(if_node) => return type_scan_summary(0, 0, 0);,
        Let(let_node) => return type_scan_summary(0, 0, 0);,
        Assign(assign_node) => return type_scan_summary(0, 0, 0);,
        Return(return_node) => return type_scan_summary(0, 0, 0);,
        Defer(defer_node) => return type_scan_summary(0, 0, 0);,
        ExprStmt(expr_stmt) => return type_scan_summary(0, 0, 0);,
        While(while_node) => return type_scan_summary(0, 0, 0);,
        For(for_node) => return type_scan_summary(0, 0, 0);,
        Break(break_node) => return type_scan_summary(0, 0, 0);,
        Continue(continue_node) => return type_scan_summary(0, 0, 0);,
        Param(param_node) => return type_scan_summary(0, 0, 0);,
        Field(field_node) => return type_scan_summary(0, 0, 0);,
        UnionVariant(union_variant) => return type_scan_summary(0, 0, 0);,
        Match(match_node) => return type_scan_summary(0, 0, 0);,
        MatchArm(match_arm) => return type_scan_summary(0, 0, 0);,
        Unsafe(unsafe_node) => return type_scan_summary(0, 0, 0);,
        ComptimeIf(comptime_if_node) => return type_scan_summary(0, 0, 0);,
    }
}

fn check_statement_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !TypeScanSummary {
    var summary = type_scan_summary(0, 0, 0);
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        summary = merge_type_summaries(
            summary,
            try check_ast_statements(allocator, file, ast, child, function_returns)
        );
        index = index + 1;
    }
    return summary;
}

fn check_function_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !TypeScanSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    let local_typed_nodes = try local_facts::collect_function_statement_locals(
        allocator,
        file,
        ast,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let expected_return = try local_facts::function_statement_return_type(
        allocator,
        file,
        ast,
        name,
        return_type,
        function_returns
    );
    var summary = type_scan_summary(0, local_typed_nodes, 0);
    summary = merge_type_summaries(
        summary,
        try check_statement_node(
            allocator,
            file,
            ast,
            body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        )
    );
    local_types.deinit();
    local_mutability.deinit();
    return summary;
}

fn first_return_type_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_return_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_return_type_mismatch_in_function(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            function_returns
        );,
        _ => return diagnostic_summary::no_return_type_mismatch();,
    }
}

fn first_return_type_mismatch_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_return_type_mismatch_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_return_type_mismatch();
}

fn first_return_type_mismatch_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
