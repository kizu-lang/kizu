fn assignment_type_mismatch_for_assign(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::AssignmentTypeSummary {
    let target_node = ast.get(target);
    match target_node.data {
        Var(var_node) => return assignment_type_mismatch_for_var_assign(
            allocator,
            file,
            ast,
            target,
            value,
            local_types,
            function_returns
        );,
        _ => return diagnostic_summary::no_assignment_type_mismatch();,
    }
}

fn assignment_type_mismatch_for_var_assign(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::AssignmentTypeSummary {
    let name = ast_text::ast_node_text(file, ast, target);
    if !local_types.contains(name) {
        return diagnostic_summary::no_assignment_type_mismatch();
    }
    let expected = try local_types.get(name);
    let actual = try expression_infer::infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    if expression_infer::known_type_mismatch(expected, actual) {
        let value_node = ast.get(value);
        return diagnostic_summary::assignment_type_summary(
            true,
            value_node.span.start,
            value_node.span.end,
            expected,
            actual
        );
    }
    return diagnostic_summary::no_assignment_type_mismatch();
}

