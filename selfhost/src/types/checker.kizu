fn first_assignment_type_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::AssignmentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_assignment_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_assignment_type_mismatch_in_function(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.body,
            function_returns
        );,
        _ => return no_assignment_type_mismatch();,
    }
}

fn first_assignment_type_mismatch_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::AssignmentTypeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_assignment_type_mismatch_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_assignment_type_mismatch();
}

fn first_assignment_type_mismatch_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::AssignmentTypeSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    let locals = try collect_function_statement_locals(
        allocator,
        file,
        ast,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let found = try first_assignment_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        function_returns
    );
    local_types.deinit();
    local_mutability.deinit();
    return found;
}

fn first_assignment_type_mismatch_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::AssignmentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_assignment_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            function_returns
        );,
        Assign(assign_node) => return assignment_type_mismatch_for_assign(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            local_types,
            function_returns
        );,
        If(if_node) => return first_assignment_type_mismatch_in_two_statements(
            allocator,
            file,
            ast,
            if_node.then_block,
            if_node.else_block,
            local_types,
            function_returns
        );,
        While(while_node) => return first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            while_node.body,
            local_types,
            function_returns
        );,
        For(for_node) => return first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            for_node.body,
            local_types,
            function_returns
        );,
        Match(match_node) => return first_assignment_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            match_node.arms,
            local_types,
            function_returns
        );,
        MatchArm(match_arm) => return first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            function_returns
        );,
        Unsafe(unsafe_node) => return first_assignment_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return first_assignment_type_mismatch_in_two_statements(
            allocator,
            file,
            ast,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types,
            function_returns
        );,
        _ => return no_assignment_type_mismatch();,
    }
}

fn first_assignment_type_mismatch_in_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
