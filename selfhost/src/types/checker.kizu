struct TypeScanSummary {
    next: i64,
    typed_nodes: i64,
    diagnostics: i64,
}

struct MatchArmScanSummary {
    explicit_count: i64,
    wildcard: bool,
    diagnostic_found: bool,
    diagnostic_kind: i64,
    diagnostic_name: []u8,
    diagnostic_tag: []u8,
}

fn first_argument_type_mismatch_in_comptime_if(
    allocator: Allocator, file: &source::SourceFile, ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId, then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId, local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let selected = try comptime_eval::select_branch_node_without_bindings(
        file, ast, condition, then_block, else_block
    );
    if selected.kind == comptime_eval::SelectedNodeKind::Error {
        return diagnostic_summary::no_argument_type_mismatch();
    }
    return first_argument_type_mismatch_in_statement(
        allocator, file, ast, selected.node_id, local_types,
        function_param_types, function_returns
    );
}

