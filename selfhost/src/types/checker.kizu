fn immutable_assignment_for_assign(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ImmutableAssignmentSummary {
    let target_node = ast.get(target);
    match target_node.data {
        Var(var_node) => return immutable_assignment_for_var_assign(
            file,
            ast,
            target,
            local_types,
            local_mutability
        );,
        _ => return diagnostic_summary::no_immutable_assignment();,
    }
}

fn immutable_assignment_for_var_assign(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ImmutableAssignmentSummary {
    let name = ast_text::ast_node_text(file, ast, target);
    if !local_types.contains(name) {
        return diagnostic_summary::no_immutable_assignment();
    }
    let mutable = try local_mutability.get(name);
    if !mutable {
        let target_node = ast.get(target);
        return diagnostic_summary::immutable_assignment_summary(
            true,
            target_node.span.start,
            target_node.span.end,
            name
        );
    }
    return diagnostic_summary::no_immutable_assignment();
}

fn first_invalid_assignment_target_node(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !model::InvalidAssignmentTargetSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_invalid_assignment_target_in_range(
            file,
            ast,
            program.declarations
        );,
        FnDecl(fn_decl) => return first_invalid_assignment_target_node(
            file,
            ast,
            fn_decl.body
        );,
        Block(block) => return first_invalid_assignment_target_in_range(
            file,
            ast,
            block.statements
        );,
        Assign(assign_node) => return invalid_assignment_target_for_assign(
            ast,
            assign_node.target
        );,
        If(if_node) => return first_invalid_assignment_target_in_two_nodes(
            file,
            ast,
            if_node.then_block,
            if_node.else_block
        );,
        While(while_node) => return first_invalid_assignment_target_node(file, ast, while_node.body);,
        For(for_node) => return first_invalid_assignment_target_node(file, ast, for_node.body);,
        Match(match_node) => return first_invalid_assignment_target_in_range(
            file,
            ast,
            match_node.arms
        );,
        MatchArm(match_arm) => return first_invalid_assignment_target_node(
            file,
            ast,
            match_arm.body
        );,
        Unsafe(unsafe_node) => return first_invalid_assignment_target_node(
            file,
            ast,
            unsafe_node.body
        );,
        ComptimeIf(comptime_if_node) => return first_invalid_assignment_target_in_two_nodes(
            file,
            ast,
            comptime_if_node.then_block,
            comptime_if_node.else_block
        );,
        _ => return diagnostic_summary::no_invalid_assignment_target();,
    }
}

fn first_invalid_assignment_target_in_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !model::InvalidAssignmentTargetSummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let found = try first_invalid_assignment_target_node(file, ast, child);
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_invalid_assignment_target();
}

fn first_invalid_assignment_target_in_two_nodes(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId
) -> !model::InvalidAssignmentTargetSummary {
    let first_found = try first_invalid_assignment_target_node(file, ast, first);
    if first_found.found {
        return first_found;
    }
    return first_invalid_assignment_target_node(file, ast, second);
}

fn invalid_assignment_target_for_assign(
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId
) -> model::InvalidAssignmentTargetSummary {
    let target_node = ast.get(target);
    match target_node.data {
        Var(var_node) => return diagnostic_summary::no_invalid_assignment_target();,
        FieldExpr(field_expr_node) => return diagnostic_summary::no_invalid_assignment_target();,
        DerefExpr(deref_expr_node) => return diagnostic_summary::no_invalid_assignment_target();,
        IndexExpr(index_expr) => return diagnostic_summary::no_invalid_assignment_target();,
        _ => return diagnostic_summary::invalid_assignment_target_result(
            true,
            target_node.span.start,
            target_node.span.end
        );,
    }
}

fn first_undefined_variable_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_undefined_variable_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_undefined_variable_in_function(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.body,
            function_returns
        );,
        _ => return diagnostic_summary::no_undefined_variable();,
    }
}

fn first_undefined_variable_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_undefined_variable_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_undefined_variable();
}

fn first_undefined_variable_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    let locals = try local_facts::collect_function_statement_locals(
        allocator,
        file,
        ast,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let found = try first_undefined_variable_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types
    );
    local_types.deinit();
    local_mutability.deinit();
    return found;
}

fn first_undefined_variable_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_undefined_variable_in_statement_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types
        );,
        Let(let_node) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            let_node.value,
            local_types
        );,
        Assign(assign_node) => return first_undefined_variable_in_two_expressions(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            local_types
        );,
        Return(return_node) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            return_node.value,
            local_types
        );,
        Defer(defer_node) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            defer_node.expr,
            local_types
        );,
        ExprStmt(expr_stmt) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            local_types
        );,
        If(if_node) => return first_undefined_variable_in_if(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            local_types
        );,
        While(while_node) => return first_undefined_variable_in_loop(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            local_types
        );,
        For(for_node) => return first_undefined_variable_in_for(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            local_types
        );,
        Match(match_node) => return first_undefined_variable_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types
        );,
        MatchArm(match_arm) => return first_undefined_variable_in_statement(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types
        );,
        Unsafe(unsafe_node) => return first_undefined_variable_in_statement(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types
        );,
        ComptimeIf(comptime_if_node) => return first_undefined_variable_in_if(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types
        );,
        _ => return diagnostic_summary::no_undefined_variable();,
    }
}

fn first_undefined_variable_in_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        let found = try first_undefined_variable_in_statement(
            allocator,
            file,
            ast,
            child,
            local_types
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_undefined_variable();
}

fn first_undefined_variable_in_expression(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let node = ast.get(node_id);
    match node.data {
        Var(var_node) => return undefined_variable_for_var(file, ast, node_id, local_types);,
        Prefix(prefix_node) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            prefix_node.right,
            local_types
        );,
        Binary(binary) => return first_undefined_variable_in_two_expressions(
            allocator,
            file,
            ast,
            binary.left,
            binary.right,
            local_types
        );,
        FieldExpr(field_expr_node) => return first_undefined_variable_in_field_expr(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            field_expr_node.namespace,
            local_types
        );,
        DerefExpr(deref_expr_node) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            deref_expr_node.receiver,
            local_types
        );,
        Call(call_node) => return first_undefined_variable_in_expression_range(
            allocator,
            file,
            ast,
            call_node.args,
            local_types
        );,
        TypeApplyExpr(type_apply) => return diagnostic_summary::no_undefined_variable();,
        CastExpr(cast_expr) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            cast_expr.value,
            local_types
        );,
        IndexExpr(index_expr) => return first_undefined_variable_in_index(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end,
            local_types
        );,
        StructLiteralExpr(struct_literal) => return first_undefined_variable_in_expression_range(
            allocator,
            file,
            ast,
            struct_literal.fields,
            local_types
        );,
        StructFieldInit(struct_field_init) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            struct_field_init.value,
            local_types
        );,
        ArenaNewExpr(arena_new) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            arena_new.allocator,
            local_types
        );,
        TryExpr(try_expr_node) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            try_expr_node.value,
            local_types
        );,
        ComptimeExpr(comptime_expr_node) => return first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            local_types
        );,
        Match(match_node) => return first_undefined_variable_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types
        );,
        _ => return diagnostic_summary::no_undefined_variable();,
    }
}

fn first_undefined_variable_in_expression_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expressions: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    var index = 0;
    while index < expressions.len {
        let child = try ast.child_at(expressions, index);
        let found = try first_undefined_variable_in_expression(
            allocator,
            file,
            ast,
            child,
            local_types
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_undefined_variable();
}

fn first_undefined_variable_in_two_expressions(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let first_found = try first_undefined_variable_in_expression(
        allocator,
        file,
        ast,
        first,
        local_types
    );
    if first_found.found {
        return first_found;
    }
    return first_undefined_variable_in_expression(allocator, file, ast, second, local_types);
}

fn first_undefined_variable_in_if(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let condition_found = try first_undefined_variable_in_expression(
        allocator,
        file,
        ast,
        condition,
        local_types
    );
    if condition_found.found {
        return condition_found;
    }
    let then_found = try first_undefined_variable_in_statement(
        allocator,
        file,
        ast,
        then_block,
        local_types
    );
    if then_found.found {
        return then_found;
    }
    return first_undefined_variable_in_statement(allocator, file, ast, else_block, local_types);
}

fn first_undefined_variable_in_match(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let value_found = try first_undefined_variable_in_expression(
        allocator,
        file,
        ast,
        value,
        local_types
    );
    if value_found.found {
        return value_found;
    }
    return first_undefined_variable_in_statement_range(
        allocator,
        file,
        ast,
        arms,
        local_types
    );
}

fn first_undefined_variable_in_loop(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let condition_found = try first_undefined_variable_in_expression(
        allocator,
        file,
        ast,
        condition,
        local_types
    );
    if condition_found.found {
        return condition_found;
    }
    return first_undefined_variable_in_statement(allocator, file, ast, body, local_types);
}

fn first_undefined_variable_in_for(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    return first_undefined_variable_in_two_expressions(
        allocator,
        file,
        ast,
        start,
        end,
        local_types
    );
}

fn first_undefined_variable_in_index(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let target_found = try first_undefined_variable_in_expression(
        allocator,
        file,
        ast,
        target,
        local_types
    );
    if target_found.found {
        return target_found;
    }
    return first_undefined_variable_in_two_expressions(
        allocator,
        file,
        ast,
        start,
        end,
        local_types
    );
}

fn first_undefined_variable_in_field_expr(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    namespace: bool,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    if namespace {
        return diagnostic_summary::no_undefined_variable();
    }
    return first_undefined_variable_in_expression(allocator, file, ast, receiver, local_types);
}

fn undefined_variable_for_var(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::UndefinedVariableSummary {
    let name = ast_text::ast_node_text(file, ast, node_id);
    if local_types.contains(name) {
        return diagnostic_summary::no_undefined_variable();
    }
    let node = ast.get(node_id);
    return diagnostic_summary::undefined_variable_summary(
        true,
        node.span.start,
        node.span.end,
        name
    );
}

fn check_statement_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>,
    expected_return: []u8,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !TypeScanSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return check_statement_block(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Let(let_node) => return check_let_statement(
            allocator,
            file,
            ast,
            let_node.mutable,
            let_node.name,
            let_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        Assign(assign_node) => return check_assign_statement(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        Return(return_node) => return check_return_statement(
            allocator,
            file,
            ast,
            return_node.value,
            local_types,
            expected_return,
            function_returns
        );,
        Defer(defer_node) => return check_expr_statement(
            allocator,
            file,
            ast,
            defer_node.expr,
            local_types,
            function_returns
        );,
        ExprStmt(expr_stmt) => return check_expr_statement(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            local_types,
            function_returns
        );,
        If(if_node) => return check_if_statement(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        While(while_node) => return check_while_statement(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        For(for_node) => return check_for_statement(
            allocator,
            file,
            ast,
            for_node.name,
            for_node.start,
            for_node.end,
            for_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Match(match_node) => return check_match_statement(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        MatchArm(match_arm) => return check_statement_node(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Unsafe(unsafe_node) => return check_statement_node(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return check_if_statement(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Break(break_node) => return type_scan_summary(0, 1, 0);,
        Continue(continue_node) => return type_scan_summary(0, 1, 0);,
        Empty => return type_scan_summary(0, 0, 0);,
        Program(program) => return type_scan_summary(0, 0, 0);,
        ImportDecl(import_decl) => return type_scan_summary(0, 0, 0);,
        Param(param_node) => return type_scan_summary(0, 0, 0);,
        Field(field_node) => return type_scan_summary(0, 0, 0);,
        StructDecl(struct_decl) => return type_scan_summary(0, 0, 0);,
        EnumDecl(enum_decl) => return type_scan_summary(0, 0, 0);,
        UnionDecl(union_decl) => return type_scan_summary(0, 0, 0);,
        UnionVariant(union_variant) => return type_scan_summary(0, 0, 0);,
        FnDecl(fn_decl) => return type_scan_summary(0, 0, 0);,
        Int(int_node) => return type_scan_summary(0, 1, 0);,
        String(string_node) => return type_scan_summary(0, 1, 0);,
        TypeName(type_name) => return type_scan_summary(0, 1, 0);,
        Var(var_node) => return type_scan_summary(0, 1, 0);,
        Bool(bool_node) => return type_scan_summary(0, 1, 0);,
        Prefix(prefix_node) => return type_scan_summary(0, 1, 0);,
        Binary(binary) => return type_scan_summary(0, 1, 0);,
        FieldExpr(field_expr_node) => return type_scan_summary(0, 1, 0);,
        DerefExpr(deref_expr_node) => return type_scan_summary(0, 1, 0);,
        Call(call_node) => return type_scan_summary(0, 1, 0);,
        TypeApplyExpr(type_apply) => return type_scan_summary(0, 1, 0);,
        CastExpr(cast_expr) => return type_scan_summary(0, 1, 0);,
        IndexExpr(index_expr) => return type_scan_summary(0, 1, 0);,
        StructLiteralExpr(struct_literal) => return type_scan_summary(0, 1, 0);,
        StructFieldInit(struct_field_init) => return type_scan_summary(0, 1, 0);,
        ArenaNewExpr(arena_new) => return type_scan_summary(0, 1, 0);,
        TryExpr(try_expr_node) => return type_scan_summary(0, 1, 0);,
        ComptimeExpr(comptime_expr_node) => return type_scan_summary(0, 1, 0);,
    }
}

fn check_statement_block(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>,
    expected_return: []u8,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !TypeScanSummary {
    var summary = type_scan_summary(0, 1, 0);
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        summary = merge_type_summaries(
            summary,
            try check_statement_node(
                allocator,
                file,
                ast,
                child,
                local_types,
                local_mutability,
                expected_return,
                function_returns
            )
        );
        index = index + 1;
    }
    return summary;
}

fn check_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
