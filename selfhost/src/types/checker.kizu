fn first_assignment_type_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::AssignmentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_assignment_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_assignment_type_mismatch_in_function(
            allocator,
            file,
            ast,
            fn_decl.type_params,
            fn_decl.params,
            fn_decl.body,
            function_returns
        );,
        ImplDecl(impl_decl) => return first_assignment_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            impl_decl.methods,
            function_returns
        );,
        _ => return diagnostic_summary::no_assignment_type_mismatch();,
    }
}

fn first_assignment_type_mismatch_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::AssignmentTypeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_assignment_type_mismatch_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_assignment_type_mismatch();
}

