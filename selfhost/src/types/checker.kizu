    if selected.kind == comptime_eval::SelectedNodeKind::Error {
        return diagnostic_summary::no_argument_type_mismatch();
    }
    return first_binary_operand_type_mismatch_in_statement(
        allocator, file, ast, selected.node_id, local_types, function_returns
    );
}

