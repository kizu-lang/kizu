fn first_binary_operand_type_mismatch_in_expression(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Call(call_node) => return first_binary_operand_type_mismatch_in_call(
            allocator,
            file,
            ast,
            call_node.callee,
            call_node.args,
            local_types,
            function_returns
        );,
        Prefix(prefix_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            prefix_node.right,
            local_types,
            function_returns
        );,
        Binary(binary) => return binary_operand_type_mismatch(
            allocator,
            file,
            ast,
            binary.left,
            binary.right,
            local_types,
            function_returns
        );,
        FieldExpr(field_expr_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            local_types,
            function_returns
        );,
        DerefExpr(deref_expr_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            deref_expr_node.receiver,
            local_types,
            function_returns
        );,
        TypeApplyExpr(type_apply) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            type_apply.callee,
            local_types,
            function_returns
        );,
        CastExpr(cast_expr) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            cast_expr.value,
            local_types,
            function_returns
        );,
        IndexExpr(index_expr) => return first_binary_operand_type_mismatch_in_two_expressions(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            local_types,
            function_returns
        );,
        StructLiteralExpr(struct_literal) => return first_binary_operand_type_mismatch_in_expression_range(
            allocator,
            file,
            ast,
            struct_literal.fields,
            local_types,
            function_returns
        );,
        StructFieldInit(struct_field_init) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            struct_field_init.value,
            local_types,
            function_returns
        );,
        ArenaNewExpr(arena_new) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            arena_new.allocator,
            local_types,
            function_returns
        );,
        TryExpr(try_expr_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            try_expr_node.value,
            local_types,
            function_returns
        );,
        ComptimeExpr(comptime_expr_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            local_types,
            function_returns
        );,
        Match(match_node) => return first_binary_operand_type_mismatch_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            function_returns
        );,
        _ => return diagnostic_summary::no_argument_type_mismatch();,
    }
}

fn first_binary_operand_type_mismatch_in_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let callee_found = try first_binary_operand_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        callee,
        local_types,
        function_returns
    );
    if callee_found.found {
        return callee_found;
    }
    return first_binary_operand_type_mismatch_in_expression_range(
        allocator,
        file,
        ast,
        args,
        local_types,
        function_returns
    );
}

fn first_binary_operand_type_mismatch_in_two_expressions(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let first_found = try first_binary_operand_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        first,
        local_types,
        function_returns
    );
    if first_found.found {
        return first_found;
    }
    return first_binary_operand_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        second,
        local_types,
        function_returns
    );
}

fn binary_operand_type_mismatch(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    left: std::kizu::ast::NodeId,
    right: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let nested = try first_binary_operand_type_mismatch_in_two_expressions(
        allocator,
        file,
        ast,
        left,
        right,
        local_types,
        function_returns
    );
    if nested.found {
        return nested;
    }
    let left_type = try expression_infer::infer_expression_type(
        allocator,
        file,
        ast,
        left,
        local_types,
        function_returns
    );
    let right_type = try expression_infer::infer_expression_type(
        allocator,
        file,
        ast,
        right,
        local_types,
        function_returns
    );
    if expression_infer::known_binary_operand_type_mismatch(
        left_type, right_type
    ) {
        let right_node = ast.get(right);
        // The comparison above is on canonical types, which is the identity. The
        // note quotes what the source wrote, so this file's own module prefix comes
        // back off before the names reach the report.
        return diagnostic_summary::argument_type_summary(
            true,
            right_node.span.start,
            right_node.span.end,
            try local_module_type_name(allocator, file, left_type),
            try local_module_type_name(allocator, file, right_type)
        );
    }
    return diagnostic_summary::no_argument_type_mismatch();
}

fn first_binary_operand_type_mismatch_in_if(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let condition_found = try first_binary_operand_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        condition,
        local_types,
        function_returns
    );
    if condition_found.found {
        return condition_found;
    }
    let then_found = try first_binary_operand_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        then_block,
        local_types,
        function_returns
    );
    if then_found.found {
        return then_found;
    }
    return first_binary_operand_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        else_block,
        local_types,
        function_returns
    );
}

