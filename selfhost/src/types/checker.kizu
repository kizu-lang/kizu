            allocator,
            file,
            ast,
            return_node.value,
            local_types,
            function_param_types,
            function_returns
        );,
        Defer(defer_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            defer_node.expr,
            local_types,
            function_param_types,
            function_returns
        );,
        ExprStmt(expr_stmt) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            local_types,
            function_param_types,
            function_returns
        );,
        If(if_node) => return first_argument_type_mismatch_in_if(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            local_types,
            function_param_types,
            function_returns
        );,
        While(while_node) => return first_argument_type_mismatch_in_loop(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            local_types,
            function_param_types,
            function_returns
        );,
        For(for_node) => return first_argument_type_mismatch_in_for(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body,
            local_types,
            function_param_types,
            function_returns
        );,
        Match(match_node) => return first_argument_type_mismatch_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            function_param_types,
            function_returns
        );,
        MatchArm(match_arm) => return first_argument_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            function_param_types,
            function_returns
        );,
        Unsafe(unsafe_node) => return first_argument_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            function_param_types,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return first_argument_type_mismatch_in_if(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types,
            function_param_types,
            function_returns
        );,
        _ => return diagnostic_summary::no_argument_type_mismatch();,
