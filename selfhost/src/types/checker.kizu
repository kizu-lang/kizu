    );
    let found = try first_return_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        local_mutability,
        expected_return,
        function_returns
    );
    local_types.deinit();
    local_mutability.deinit();
    return found;
}

