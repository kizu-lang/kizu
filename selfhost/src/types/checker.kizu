fn check_comptime_if_statement(
    allocator: Allocator, file: &source::SourceFile, ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId, then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId, local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>, expected_return: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !TypeScanSummary {
    let selected = try comptime_eval::select_branch_node_without_bindings(
        file, ast, condition, then_block, else_block
    );
    if selected.kind == comptime_eval::SelectedNodeKind::Error {
        return type_scan_summary(0, 0, 0);
    }
    return check_statement_node(
        allocator, file, ast, selected.node_id, local_types,
        local_mutability, expected_return, function_returns
    );
}

fn first_match_diagnostic_in_comptime_if(
    allocator: Allocator, file: &source::SourceFile, ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId, then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId, local_types: &std::map::Map<[]u8, []u8>,
    enum_counts: &std::map::Map<[]u8, i64>, enum_tags: &std::map::Map<[]u8, bool>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::MatchDiagnosticSummary {
    let selected = try comptime_eval::select_branch_node_without_bindings(
        file, ast, condition, then_block, else_block
    );
    if selected.kind == comptime_eval::SelectedNodeKind::Error {
        return diagnostic_summary::no_match_diagnostic();
    }
    return first_match_diagnostic_in_statement(
        allocator, file, ast, selected.node_id, local_types,
        enum_counts, enum_tags, function_returns
    );
}

pub fn check(resolved: resolver::ResolveSummary) -> model::TypeSummary {
    return model::TypeSummary {
        modules: resolved.modules,
        symbols: resolved.symbols,
        functions: 0,
        typed_nodes: resolved.symbols,
        diagnostics: resolved.diagnostics
    };
}

pub fn check_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    resolved: resolver::ResolveSummary
) -> !model::TypeSummary {
    var parsed_sources = try parser::parse_source_files(allocator, files);
    let summary = try check_parsed_sources_core(
        allocator,
        files,
        &parsed_sources.parsed,
        &parsed_sources.source_indexes,
        resolved
    );
    try parser::deinit_parsed_source_files(parsed_sources);
    return summary;
}

pub fn check_parsed_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed_sources: &std::array::Array<std::kizu::ast::ParseResult>,
    parsed_source_indexes: &std::array::Array<i64>,
    resolved: resolver::ResolveSummary
) -> !model::TypeSummary {
    return try check_parsed_sources_core(
        allocator,
        files,
        parsed_sources,
        parsed_source_indexes,
        resolved
    );
}

fn check_parsed_sources_core(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    parsed_sources: &std::array::Array<std::kizu::ast::ParseResult>,
    parsed_source_indexes: &std::array::Array<i64>,
    resolved: resolver::ResolveSummary
) -> !model::TypeSummary {
    var kinds = std::map::Map<[]u8, model::TypeKind>(allocator);
    var arities = std::map::Map<[]u8, i64>(allocator);
    var copyable = std::map::Map<[]u8, bool>(allocator);
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var function_returns = expression_facts::init(allocator);
    defer kinds.deinit();
    defer arities.deinit();
    defer copyable.deinit();
    defer function_arities.deinit();
    defer function_returns.deinit();
    try type_refs::seed_builtin_types(kinds, arities, copyable);

    var index = 0;
    while index < parsed_sources.len() {
        let parsed_source = try parsed_sources.at(index);
        let source_index = try parsed_source_indexes.get(index);
        let file = try files.at(source_index);
        try type_refs::collect_declared_types_from_ast(
            allocator,
            file,
            parsed_source.ast,
            parsed_source.root,
            kinds,
            arities,
            copyable
        );
        try type_refs::collect_type_parameters_from_ast(
            file,
            parsed_source.ast,
            parsed_source.root,
            kinds,
            arities,
            copyable
        );
        try collect_nominal_resolution_facts_from_ast(
            allocator,
            file,
            parsed_source.ast,
            parsed_source.root,
            function_returns
        );
        index = index + 1;
    }

    index = 0;
    while index < parsed_sources.len() {
        let parsed_source = try parsed_sources.at(index);
        let source_index = try parsed_source_indexes.get(index);
        let file = try files.at(source_index);
        try function_calls::collect_function_signatures_from_ast(
            allocator,
            file,
            &parsed_source.ast,
            parsed_source.root,
            function_arities,
            function_returns
        );
        try collect_struct_field_resolution_facts_from_ast(
            allocator,
            file,
            parsed_source.ast,
            parsed_source.root,
            function_returns
        );
        index = index + 1;
    }

    var typed_nodes = 0;
    var diagnostics = resolved.diagnostics;
    index = 0;
    while index < parsed_sources.len() {
        let parsed_source = try parsed_sources.at(index);
        let source_index = try parsed_source_indexes.get(index);
        let file = try files.at(source_index);
        if source::is_frontend_source(file.kind) {
            let comptime_found = try comptime_diagnostic::first_diagnostic(
                allocator, file, parsed_source.ast, parsed_source.root
            );
            if comptime_found.found {
                diagnostics = diagnostics + 1;
            }
            let scan = try type_ref_scan_ast::check_file_type_references_from_ast(
                allocator,
                file,
                &parsed_source.ast,
                parsed_source.root,
                kinds,
                arities
            );
            typed_nodes = typed_nodes + scan.typed_nodes;
            diagnostics = diagnostics + scan.diagnostics;
            let call_scan = try function_call_scan_ast::check_file_function_references_from_ast(
                allocator,
                file,
                &parsed_source.ast,
                parsed_source.root,
                function_arities
            );
            let body_scan = try check_file_body_ast_node(
                allocator,
                file,
                parsed_source.ast,
                parsed_source.root,
                function_returns
            );
            typed_nodes = typed_nodes + call_scan.typed_nodes;
            diagnostics = diagnostics + call_scan.diagnostics;
            typed_nodes = typed_nodes + body_scan.typed_nodes;
            diagnostics = diagnostics + body_scan.diagnostics;
        }
        index = index + 1;
    }

    let summary = model::TypeSummary {
        modules: resolved.modules,
        symbols: kinds.len(),
        functions: function_arities.len(),
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
    return summary;
}

pub fn first_package_function_call_error_ast_node(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !model::FunctionCallSummary {
    return function_calls::first_package_function_call_error_ast_node(
        allocator,
        files,
        file,
        ast,
        root
    );
}

pub fn first_pre_move_check_diagnostic_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !diagnostic::Report {
    var kinds = std::map::Map<[]u8, model::TypeKind>(allocator);
    var arities = std::map::Map<[]u8, i64>(allocator);
    var copyable = std::map::Map<[]u8, bool>(allocator);
    defer kinds.deinit();
    defer arities.deinit();
    defer copyable.deinit();
    try type_refs::seed_builtin_types(kinds, arities, copyable);
    try type_refs::collect_declared_types_from_ast(allocator, file, ast, root, kinds, arities, copyable);
    return try first_pre_move_check_diagnostic_ast_node_with_types(
        allocator,
        file,
        ast,
        root,
        kinds,
        arities,
        copyable
    );
}

pub fn first_pre_move_check_diagnostic_ast_node_with_types(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>
) -> !diagnostic::Report {
    var function_returns = expression_facts::init(allocator);
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    defer function_returns.deinit();
    defer function_arities.deinit();
    try collect_nominal_resolution_facts_from_ast(
        allocator, file, ast, root, function_returns
    );
    try function_calls::collect_function_signatures_from_ast(
        allocator, file, &ast, root, function_arities, function_returns
    );
    try collect_struct_field_resolution_facts_from_ast(
        allocator, file, ast, root, function_returns
    );
    return try first_pre_move_check_diagnostic_ast_node_with_facts(
        allocator,
        file,
        ast,
        root,
        kinds,
        arities,
        copyable,
        function_returns
    );
}

pub fn first_pre_move_check_diagnostic_ast_node_with_facts(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &var std::map::Map<[]u8, model::TypeKind>,
    arities: &var std::map::Map<[]u8, i64>,
    copyable: &var std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !diagnostic::Report {
    let comptime_report = try comptime_diagnostic::first_report(allocator, file, ast, root);
    if comptime_report.found {
        return comptime_report;
    }
    try type_refs::collect_type_parameters_from_ast(file, ast, root, kinds, arities, copyable);
    let type_ref = try type_ref_ast::first_type_error_in_ast(allocator, file, ast, root, kinds, arities);
    if type_ref.found {
        return try reports::from_type_reference_summary(allocator, file.path, file.text, type_ref);
    }
    // A container decides what it may hold from the written spelling alone, which is why
    // it is settled with the declarations rather than with the bodies: a map key that
    // cannot be hashed is wrong where it is written, before any position rule reads the
    // declaration and before any value flows into it.
    let container = try container_scan::first_container_storage_diagnostic_node(
        allocator,
        file,
        ast,
        root,
        kinds,
        copyable
    );
    if container.found {
        return try container_report::from_container_storage_summary(
            allocator, file.path, container
        );
    }
    // Resolving a type spelling only says the name exists. `type` and `dyn Contract`
    // resolve and still store nothing, so the position each spelling was written in is
    // decided next, before any rule that reads the declaration as if it held a value.
    let placement = try type_placement::first_type_placement_diagnostic_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if placement.found {
        return try reports::from_type_placement_summary(allocator, file.path, placement);
    }
    // What a module publishes is settled once every type reference resolves and before
    // any rule reads a declaration's contents: the public boundary is a statement about
    // the names a signature writes, not about what they hold.
    let visible = try visibility::first_visibility_diagnostic_node(file, ast, root);
    if visible.found {
        return try reports::from_visibility_summary(allocator, file.path, visible);
    }
    // A type's method namespace is settled before anything is measured against it: a
    // contract is satisfied by the method set the impl blocks declare, and a name declared
    // twice does not say which declaration that set holds.
    let impl_method = try impl_methods::first_impl_method_diagnostic_node(file, ast, root);
    if impl_method.found {
        return try reports::from_impl_method_summary(allocator, file.path, impl_method);
    }
    // Contract rules are decided once every type reference resolves: a `dyn Contract`
    // placement and an `impl Contract for Type` method set are both statements about
    // names that already exist.
    let contract_rule = try contract_rules::first_contract_diagnostic_node(
        allocator,
        file,
        ast,
        root
    );
    if contract_rule.found {
        return try reports::from_contract_summary(allocator, file.path, contract_rule);
    }
    // A call through a contract object reaches the contract's own method set and nothing
    // else, so it is decided once that set is known to be complete.
    let dispatch = try dyn_dispatch::first_dyn_dispatch_diagnostic_node(file, ast, root);
    if dispatch.found {
        return try reports::from_dyn_dispatch_summary(allocator, file.path, dispatch);
    }
    // A struct literal is the one expression whose type is settled by a declaration rather
    // than by what flows into it, so it is decided before the rules that read a value's
    // type: a literal the declaration does not admit stands for no value at all, and every
    // position it is written in would otherwise measure a type the program never built.
    let literal = try struct_literal_scan::first_struct_literal_diagnostic_node(
        allocator,
        file,
        ast,
        root,
        kinds,
        expression_types
    );
    if literal.found {
        return try reports::from_struct_literal_summary(allocator, file.path, literal);
    }

    var enum_counts = std::map::Map<[]u8, i64>(allocator);
    var enum_tags = std::map::Map<[]u8, bool>(allocator);
    defer enum_counts.deinit();
    defer enum_tags.deinit();
    try collect_match_enum_types(allocator, file, ast, root, enum_counts, enum_tags);
    let match_diagnostic = try first_match_diagnostic_node(
        allocator,
        file,
        ast,
        root,
        enum_counts,
        enum_tags,
        expression_types
    );
    if match_diagnostic.found {
        return try reports::from_match_summary(allocator, file.path, match_diagnostic);
    }
    let return_type = try return_diagnostics::first_return_type_mismatch_node(
        allocator,
        file,
        ast,
        root,
        self_type_scope::no_self_type(),
        expression_types
    );
    if return_type.found {
        return try reports::from_return_type_summary(allocator, file.path, return_type);
    }
    // A generic declaration fixes no result type on its own, so its body is measured
    // against the type arguments a call site supplies rather than against the parameters
    // it was written with.
    let instantiated_return = try generic_instantiation::first_instantiated_return_mismatch_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if instantiated_return.found {
        return try reports::from_return_type_summary(
            allocator, file.path, instantiated_return
        );
    }
    let missing_return = try return_diagnostics::first_missing_return_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if missing_return.found {
        return try reports::from_missing_return_summary(allocator, file.path, missing_return);
    }
    return diagnostic::no_report(allocator);
}

pub fn first_post_move_check_diagnostic_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !diagnostic::Report {
    var function_returns = expression_facts::init(allocator);
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    defer function_returns.deinit();
    defer function_arities.deinit();
    try collect_nominal_resolution_facts_from_ast(
        allocator, file, ast, root, function_returns
    );
    try function_calls::collect_function_signatures_from_ast(
        allocator, file, &ast, root, function_arities, function_returns
    );
    try collect_struct_field_resolution_facts_from_ast(
        allocator, file, ast, root, function_returns
    );
    return try first_post_move_check_diagnostic_ast_node_with_facts(
        allocator, file, ast, root, function_returns
    );
}

pub fn first_post_move_check_diagnostic_ast_node_with_facts(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !diagnostic::Report {
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    var local_function_param_types = std::array::Array<function_params::FunctionParamType>(allocator);
    defer function_arities.deinit();
    defer local_function_param_types.deinit();
    try function_calls::collect_function_arities_from_ast(allocator, file, &ast, root, function_arities);
    try function_params::collect_local_function_param_types(
        allocator,
        file,
        ast,
        root,
        local_function_param_types
    );

    let local_call = try function_calls::first_function_call_error_ast_node(
        allocator,
        file,
        &ast,
        root,
        function_arities,
        true
    );
    if local_call.found {
        return try reports::from_function_call_summary(allocator, file.path, file.text, local_call);
    }
    let unsafe_rule = try unsafe_rules::first_unsafe_diagnostic_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if unsafe_rule.found {
        return try reports::from_unsafe_summary(allocator, file, unsafe_rule);
    }
    // A `comptime Function` slot resolves in the function namespace, so it is decided
    // before the value-namespace scan below ever sees the argument.
    let concurrent = try concurrency::first_concurrency_diagnostic_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if concurrent.found {
        return try reports::from_concurrency_summary(allocator, file.path, concurrent);
    }
    let undefined = try first_undefined_variable_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if undefined.found {
        return try reports::from_undefined_variable_summary(allocator, file.path, undefined);
    }
    let binary_operand = try first_binary_operand_type_mismatch_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if binary_operand.found {
        return try reports::from_binary_operand_type_summary(allocator, file.path, binary_operand);
    }
    let argument = try first_argument_type_mismatch_node(
        allocator,
        file,
        ast,
        root,
        local_function_param_types,
        expression_types
    );
    if argument.found {
        return try reports::from_argument_type_summary(allocator, file.path, argument);
    }
    let immutable = try first_immutable_assignment_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if immutable.found {
        return try reports::from_immutable_assignment_summary(allocator, file.path, immutable);
    }
    var no_locals = std::map::Map<[]u8, []u8>(allocator);
    defer no_locals.deinit();
    let invalid = try first_invalid_assignment_target_node(
        allocator,
        file,
        ast,
        root,
        no_locals,
        expression_types
    );
    if invalid.found {
        return try reports::from_invalid_assignment_target_summary(
            allocator,
            file.path,
            file.text,
            invalid
        );
    }
    let assignment = try first_assignment_type_mismatch_node(
        allocator,
        file,
        ast,
        root,
        expression_types
    );
    if assignment.found {
        return try reports::from_assignment_type_summary(allocator, file.path, assignment);
    }
    return diagnostic::no_report(allocator);
}

// Collect exact struct fields and per-module import aliases into returns.
// Field inference resolves receiver.field through the nominal package/module
// owner; equal short names in different modules never share facts.
pub fn collect_struct_resolution_facts_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try collect_nominal_resolution_facts_from_ast(
        allocator, file, ast, node_id, returns
    );
    try collect_struct_field_resolution_facts_from_ast(
        allocator, file, ast, node_id, returns
    );
    return;
}

pub fn collect_nominal_resolution_facts_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return collect_nominal_type_facts_in_range(
            allocator, file, ast, program.declarations, returns
        );,
        StructDecl(struct_decl) => return insert_nominal_type_fact(
            allocator, file, ast, struct_decl.name, returns
        );,
        EnumDecl(enum_decl) => return insert_nominal_type_fact(
            allocator, file, ast, enum_decl.name, returns
        );,
        UnionDecl(union_decl) => return insert_nominal_type_fact(
            allocator, file, ast, union_decl.name, returns
        );,
        ImportDecl(import_decl) => return insert_struct_import_alias(
            allocator, file, ast, import_decl.path, returns
        );,
        ImplDecl(impl_decl) => return insert_contract_conformance_fact(
            allocator, file, ast, impl_decl.contract_name, impl_decl.type_name, returns
        );,
        _ => return;,
    }
}

// insert_contract_conformance_fact records one `impl Contract for Type`. Explicit
// conformance is the only way a type satisfies a contract (SPEC.md 16), so this fact is
// what a `dyn Contract` argument is measured against; an inherent impl carries an empty
// contract slot and records nothing.
fn insert_contract_conformance_fact(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    contract_name: std::kizu::ast::NodeId,
    type_name: std::kizu::ast::NodeId,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let contract_text = ast_text::ast_node_text(file, ast, contract_name);
    if std::mem::len(contract_text) == 0 {
        return;
    }
    var key = std::string::String(allocator);
    defer key.deinit();
    try append_contract_conformance_prefix(key, allocator, file, contract_text, returns);
    try expression_infer::append_resolved_nominal_type(
        key, allocator, file, ast_text::ast_node_text(file, ast, type_name), returns
    );
    let key_bytes = key.as_bytes();
    if !returns.contains_source(&key_bytes) {
        try returns.insert_source(allocator, &key_bytes, contract_text);
    }
    return;
}

// append_contract_conformance_prefix keys one conformance by the module-qualified
// contract, the same resolution every other nominal fact in this bag uses. The caller
// appends the type, which is already canonical when it comes from inference.
pub fn append_contract_conformance_prefix(
    out: &var std::string::String,
    allocator: Allocator,
    file: &source::SourceFile,
    contract_name: []u8,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try out.append_bytes("cs ");
    try expression_infer::append_resolved_nominal_type(
        out, allocator, file, contract_name, returns
    );
    try out.append_bytes(" ");
    return;
}

pub fn collect_struct_field_resolution_facts_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return collect_struct_field_types_in_range(
            allocator, file, ast, program.declarations, returns
        );,
        StructDecl(struct_decl) => return collect_struct_field_types_for_struct(
            allocator,
            file,
            ast,
            struct_decl.name,
            struct_decl.type_params,
            struct_decl.fields,
            returns
        );,
        _ => return;,
    }
}

fn collect_nominal_type_facts_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        match node.data {
            StructDecl(value) => try insert_nominal_type_fact(
                allocator, file, ast, value.name, returns
            );,
            EnumDecl(value) => try insert_nominal_type_fact(
                allocator, file, ast, value.name, returns
            );,
            UnionDecl(value) => try insert_nominal_type_fact(
                allocator, file, ast, value.name, returns
            );,
            ImportDecl(value) => try insert_struct_import_alias(
                allocator, file, ast, value.path, returns
            );,
            ImplDecl(value) => try insert_contract_conformance_fact(
                allocator, file, ast, value.contract_name, value.type_name, returns
            );,
            _ => ignore_nominal_declaration();,
        }
        index = index + 1;
    }
    return;
}

fn ignore_nominal_declaration() -> void {
    return;
}

fn insert_nominal_type_fact(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let type_name = ast_text::ast_node_text(file, ast, name);
    var canonical_name = std::string::String(allocator);
    defer canonical_name.deinit();
    try expression_infer::append_resolved_nominal_type(
        canonical_name, allocator, file, type_name, returns
    );
    var key = std::string::String(allocator);
    defer key.deinit();
    try key.append_bytes("tn ");
    let canonical_bytes = canonical_name.as_bytes();
    try key.append_bytes(canonical_bytes);
    let key_bytes = key.as_bytes();
    if !returns.contains_source(&key_bytes) {
        try returns.insert_source_owned(allocator, &key_bytes, &canonical_name);
    }
    return;
}

fn collect_struct_field_types_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_struct_field_resolution_facts_from_ast(
            allocator, file, ast, child, returns
        );
        index = index + 1;
    }
    return;
}

fn collect_struct_field_types_for_struct(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    fields: std::kizu::ast::ChildRange,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let struct_name = ast_text::ast_node_text(file, ast, name);
    try collect_struct_template_metadata(
        allocator, file, ast, struct_name, type_params, fields, returns
    );
    var index = 0;
    while index < fields.len {
        let child = try ast.child_at(fields, index);
        try collect_struct_field_type_entry(allocator, file, ast, struct_name, child, returns);
        index = index + 1;
    }
    return;
}

fn collect_struct_template_metadata(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    struct_name: []u8,
    type_params: std::kizu::ast::ChildRange,
    fields: std::kizu::ast::ChildRange,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var owner = std::string::String(allocator);
    defer owner.deinit();
    try expression_infer::append_resolved_nominal_type(
        owner, allocator, file, struct_name, returns
    );
    var index = 0;
    while index < type_params.len {
        let child = try ast.child_at(type_params, index);
        let formal = ast_text::ast_node_text(file, ast, child);
        var previous = 0;
        while previous < index {
            let previous_child = try ast.child_at(type_params, previous);
            let previous_formal = ast_text::ast_node_text(
                file, ast, previous_child
            );
            if std::mem::equal_bytes(previous_formal, formal) {
                return error("duplicate generic struct formal");
            }
            previous = previous + 1;
        }
        try insert_struct_metadata(
            allocator, "tp ", &owner, index, formal, returns
        );
        index = index + 1;
    }
    index = 0;
    while index < fields.len {
        let child = try ast.child_at(fields, index);
        let node = ast.get(child);
        match node.data {
            Field(field) => try insert_struct_metadata(
                allocator, "fn ", &owner, index,
                ast_text::ast_node_text(file, ast, field.name), returns
            );,
            _ => return error("struct field metadata expects Field node");,
        }
        index = index + 1;
    }
    return;
}

fn insert_struct_metadata(
    allocator: Allocator,
    prefix: []u8,
    owner: &std::string::String,
    index: i64,
    value: []u8,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var key = std::string::String(allocator);
    defer key.deinit();
    try key.append_bytes(prefix);
    let owner_bytes = owner.as_bytes();
    try key.append_bytes(owner_bytes);
    try key.append_bytes(" ");
    try std::fmt::append_i64(key, index);
    let key_bytes = key.as_bytes();
    try returns.insert_source(allocator, &key_bytes, value);
    return;
}

fn collect_struct_field_type_entry(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    struct_name: []u8,
    field_node_id: std::kizu::ast::NodeId,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let node = ast.get(field_node_id);
    match node.data {
        Field(field) => return insert_struct_field_type(
            allocator,
            file,
            ast,
            struct_name,
            field.name,
            field.type_node,
            returns
        );,
        _ => return;,
    }
}

fn insert_struct_field_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    struct_name: []u8,
    field_name_id: std::kizu::ast::NodeId,
    type_node_id: std::kizu::ast::NodeId,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let field_name = ast_text::ast_node_text(file, ast, field_name_id);
    var key = std::string::String(allocator);
    defer key.deinit();
    try expression_infer::append_struct_field_key(
        key, allocator, file, struct_name, field_name, returns
    );
    let key_bytes = key.as_bytes();
    let field_type = ast_text::ast_return_type_text(file, ast, type_node_id);
    var resolved_field_type = try expression_infer::build_canonical_type_spelling(
        allocator, file, field_type, returns
    );
    defer resolved_field_type.deinit();
    if returns.contains_field(&key_bytes) {
        let existing = try returns.get_field(&key_bytes);
        if !owned_string_equal_bytes(&resolved_field_type, existing) {
            return error("conflicting exact struct field type");
        }
        return;
    }
    try returns.insert_field(allocator, &key_bytes, &resolved_field_type);
    return;
}

fn owned_string_equal_bytes(
    value: &std::string::String,
    expected: []u8
) -> bool {
    if value.len() != std::mem::len(expected) { return false; }
    var index = 0;
    while index < value.len() {
        if owned_string_byte_at(value, index) != expected[index] { return false; }
        index = index + 1;
    }
    return true;
}

fn owned_string_byte_at(value: &std::string::String, index: i64) -> u8 {
    let bytes = value.as_bytes();
    return cast<u8>(bytes[index]);
}

fn insert_struct_import_alias(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    path: std::kizu::ast::ChildRange,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    if path.len < 1 {
        return;
    }
    let first = try ast.child_at(path, 0);
    let last = try ast.child_at(path, path.len - 1);
    let first_node = ast.get(first);
    let last_node = ast.get(last);
    let alias = ast_text::ast_node_text(file, ast, last);
    var key = std::string::String(allocator);
    defer key.deinit();
    try expression_infer::append_struct_import_alias_key(key, file, alias);
    let key_bytes = key.as_bytes();
    let target = file.text[first_node.span.start..last_node.span.end];
    if returns.contains_source(&key_bytes) {
        let existing = try returns.get_source(&key_bytes);
        if !std::mem::equal_bytes(existing, target) {
            return error("conflicting exact struct import alias");
        }
        return;
    }
    try returns.insert_source(allocator, &key_bytes, target);
    return;
}

fn check_file_body_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !TypeScanSummary {
    let traversal = try body_scan::scan_body_ast_node(ast, root);
    let statements = try check_ast_statements(
        allocator,
        file,
        ast,
        root,
        self_type_scope::no_self_type(),
        function_returns
    );
    let traversal_summary = type_scan_summary(
        traversal.next,
        traversal.typed_nodes,
        traversal.diagnostics
    );
    let summary = merge_type_summaries(traversal_summary, statements);
    return summary;
}

fn check_ast_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    self_type: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !TypeScanSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return check_statement_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            self_type,
            function_returns
        );,
        Empty => return type_scan_summary(0, 0, 0);,
        ImportDecl(import_decl) => return type_scan_summary(0, 0, 0);,
        StructDecl(struct_decl) => return type_scan_summary(0, 0, 0);,
        EnumDecl(enum_decl) => return type_scan_summary(0, 0, 0);,
        UnionDecl(union_decl) => return type_scan_summary(0, 0, 0);,
        // The impl target is the type its methods read `Self` as, so the block hands its
        // own target down to the signatures written inside it. A contract declares the
        // method set an implementing type must supply and names no target of its own, so
        // `Self` stays unresolved there -- and a signature without a body has no value to
        // compare against it.
        ImplDecl(impl_decl) => return check_statement_declarations(
            allocator,
            file,
            ast,
            impl_decl.methods,
            ast_text::ast_node_text(file, ast, impl_decl.type_name),
            function_returns
        );,
        ContractDecl(contract_decl) => return check_statement_declarations(
            allocator,
            file,
            ast,
            contract_decl.methods,
            self_type_scope::no_self_type(),
            function_returns
        );,
        FnDecl(fn_decl) => return check_function_statements(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.type_params,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            self_type,
            function_returns
        );,
        Int(int_node) => return type_scan_summary(0, 0, 0);,
        String(string_node) => return type_scan_summary(0, 0, 0);,
        TypeName(type_name) => return type_scan_summary(0, 0, 0);,
        Var(var_node) => return type_scan_summary(0, 0, 0);,
        Bool(bool_node) => return type_scan_summary(0, 0, 0);,
        Prefix(prefix_node) => return type_scan_summary(0, 0, 0);,
        Binary(binary) => return type_scan_summary(0, 0, 0);,
        FieldExpr(field_expr_node) => return type_scan_summary(0, 0, 0);,
        DerefExpr(deref_expr_node) => return type_scan_summary(0, 0, 0);,
        Call(call_node) => return type_scan_summary(0, 0, 0);,
        TypeApplyExpr(type_apply) => return type_scan_summary(0, 0, 0);,
        CastExpr(cast_expr) => return type_scan_summary(0, 0, 0);,
        IndexExpr(index_expr) => return type_scan_summary(0, 0, 0);,
        StructLiteralExpr(struct_literal) => return type_scan_summary(0, 0, 0);,
        StructFieldInit(struct_field_init) => return type_scan_summary(0, 0, 0);,
        ArenaNewExpr(arena_new) => return type_scan_summary(0, 0, 0);,
        TryExpr(try_expr_node) => return type_scan_summary(0, 0, 0);,
        ComptimeExpr(comptime_expr_node) => return type_scan_summary(0, 0, 0);,
        Block(block) => return type_scan_summary(0, 0, 0);,
        If(if_node) => return type_scan_summary(0, 0, 0);,
        Let(let_node) => return type_scan_summary(0, 0, 0);,
        Assign(assign_node) => return type_scan_summary(0, 0, 0);,
        Return(return_node) => return type_scan_summary(0, 0, 0);,
        Defer(defer_node) => return type_scan_summary(0, 0, 0);,
        ErrDefer(err_defer_node) => return type_scan_summary(0, 0, 0);,
        ExprStmt(expr_stmt) => return type_scan_summary(0, 0, 0);,
        While(while_node) => return type_scan_summary(0, 0, 0);,
        For(for_node) => return type_scan_summary(0, 0, 0);,
        Break(break_node) => return type_scan_summary(0, 0, 0);,
        Continue(continue_node) => return type_scan_summary(0, 0, 0);,
        Param(param_node) => return type_scan_summary(0, 0, 0);,
        Field(field_node) => return type_scan_summary(0, 0, 0);,
        UnionVariant(union_variant) => return type_scan_summary(0, 0, 0);,
        Match(match_node) => return type_scan_summary(0, 0, 0);,
        MatchArm(match_arm) => return type_scan_summary(0, 0, 0);,
        Unsafe(unsafe_node) => return type_scan_summary(0, 0, 0);,
        ComptimeIf(comptime_if_node) => return type_scan_summary(0, 0, 0);,
    }
}

fn check_statement_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    self_type: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !TypeScanSummary {
    var summary = type_scan_summary(0, 0, 0);
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        summary = merge_type_summaries(
            summary,
            try check_ast_statements(
                allocator, file, ast, child, self_type, function_returns
            )
        );
        index = index + 1;
    }
    return summary;
}

fn check_function_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    self_type: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !TypeScanSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    defer local_types.deinit();
    defer local_mutability.deinit();
    let local_typed_nodes = try local_facts::collect_function_statement_locals(
        allocator,
        file,
        ast,
        type_params,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let declared_return = try local_facts::function_statement_return_type(
        allocator,
        file,
        ast,
        name,
        return_type,
        function_returns
    );
    let scoped_return = try type_parameter_scope::declared_type_text(
        file,
        ast,
        type_params,
        declared_return
    );
    let expected_return = try self_type_scope::resolved_type_text(
        allocator,
        scoped_return,
        self_type,
        function_returns
    );
    var summary = type_scan_summary(0, local_typed_nodes, 0);
    summary = merge_type_summaries(
        summary,
        try check_statement_node(
            allocator,
            file,
            ast,
            body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        )
    );
    return summary;
}

fn first_argument_type_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_argument_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_param_types,
            function_returns
        );,
        FnDecl(fn_decl) => return first_argument_type_mismatch_in_function(
            allocator,
            file,
            ast,
            fn_decl.type_params,
            fn_decl.params,
            fn_decl.body,
            function_param_types,
            function_returns
        );,
        ImplDecl(impl_decl) => return first_argument_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            impl_decl.methods,
            function_param_types,
            function_returns
        );,
        _ => return diagnostic_summary::no_argument_type_mismatch();,
    }
}

fn first_argument_type_mismatch_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_argument_type_mismatch_node(
            allocator,
            file,
            ast,
            child,
            function_param_types,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_argument_type_mismatch();
}

fn first_argument_type_mismatch_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    defer local_types.deinit();
    defer local_mutability.deinit();
    let locals = try local_facts::collect_function_statement_locals(
        allocator,
        file,
        ast,
        type_params,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let found = try first_argument_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        function_param_types,
        function_returns
    );
    return found;
}

fn first_argument_type_mismatch_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_argument_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            function_param_types,
            function_returns
        );,
        Let(let_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            let_node.value,
            local_types,
            function_param_types,
            function_returns
        );,
        Assign(assign_node) => return first_argument_type_mismatch_in_two_expressions(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            local_types,
            function_param_types,
            function_returns
        );,
        Return(return_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            return_node.value,
            local_types,
            function_param_types,
            function_returns
        );,
        Defer(defer_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            defer_node.expr,
            local_types,
            function_param_types,
            function_returns
        );,
        ErrDefer(err_defer_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            err_defer_node.expr,
            local_types,
            function_param_types,
            function_returns
        );,
        ExprStmt(expr_stmt) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            local_types,
            function_param_types,
            function_returns
        );,
        If(if_node) => return first_argument_type_mismatch_in_if(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            local_types,
            function_param_types,
            function_returns
        );,
        While(while_node) => return first_argument_type_mismatch_in_loop(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            local_types,
            function_param_types,
            function_returns
        );,
        For(for_node) => return first_argument_type_mismatch_in_for(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body,
            local_types,
            function_param_types,
            function_returns
        );,
        Match(match_node) => return first_argument_type_mismatch_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            function_param_types,
            function_returns
        );,
        MatchArm(match_arm) => return first_argument_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            function_param_types,
            function_returns
        );,
        Unsafe(unsafe_node) => return first_argument_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            function_param_types,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return first_argument_type_mismatch_in_comptime_if(
            allocator, file, ast, comptime_if_node.condition,
            comptime_if_node.then_block, comptime_if_node.else_block,
            local_types, function_param_types, function_returns
        );,
        _ => return diagnostic_summary::no_argument_type_mismatch();,
    }
}

fn first_argument_type_mismatch_in_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        let found = try first_argument_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            child,
            local_types,
            function_param_types,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_argument_type_mismatch();
}

fn first_argument_type_mismatch_in_expression_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    expressions: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    var index = 0;
    while index < expressions.len {
        let child = try ast.child_at(expressions, index);
        let found = try first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            child,
            local_types,
            function_param_types,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_argument_type_mismatch();
}

fn first_argument_type_mismatch_in_expression(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Call(call_node) => return first_argument_type_mismatch_in_call(
            allocator,
            file,
            ast,
            call_node.callee,
            call_node.args,
            local_types,
            function_param_types,
            function_returns
        );,
        Prefix(prefix_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            prefix_node.right,
            local_types,
            function_param_types,
            function_returns
        );,
        Binary(binary) => return first_argument_type_mismatch_in_two_expressions(
            allocator,
            file,
            ast,
            binary.left,
            binary.right,
            local_types,
            function_param_types,
            function_returns
        );,
        FieldExpr(field_expr_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            local_types,
            function_param_types,
            function_returns
        );,
        DerefExpr(deref_expr_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            deref_expr_node.receiver,
            local_types,
            function_param_types,
            function_returns
        );,
        TypeApplyExpr(type_apply) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            type_apply.callee,
            local_types,
            function_param_types,
            function_returns
        );,
        CastExpr(cast_expr) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            cast_expr.value,
            local_types,
            function_param_types,
            function_returns
        );,
        IndexExpr(index_expr) => return first_argument_type_mismatch_in_two_expressions(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            local_types,
            function_param_types,
            function_returns
        );,
        StructLiteralExpr(struct_literal) => return first_argument_type_mismatch_in_expression_range(
            allocator,
            file,
            ast,
            struct_literal.fields,
            local_types,
            function_param_types,
            function_returns
        );,
        StructFieldInit(struct_field_init) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            struct_field_init.value,
            local_types,
            function_param_types,
            function_returns
        );,
        ArenaNewExpr(arena_new) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            arena_new.allocator,
            local_types,
            function_param_types,
            function_returns
        );,
        TryExpr(try_expr_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            try_expr_node.value,
            local_types,
            function_param_types,
            function_returns
        );,
        ComptimeExpr(comptime_expr_node) => return first_argument_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            local_types,
            function_param_types,
            function_returns
        );,
        Match(match_node) => return first_argument_type_mismatch_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            function_param_types,
            function_returns
        );,
        _ => return diagnostic_summary::no_argument_type_mismatch();,
    }
}

fn first_argument_type_mismatch_in_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let call_found = try argument_type_mismatch_for_call(
        allocator,
        file,
        ast,
        callee,
        args,
        local_types,
        function_param_types,
        function_returns
    );
    if call_found.found {
        return call_found;
    }
    let callee_found = try first_argument_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        callee,
        local_types,
        function_param_types,
        function_returns
    );
    if callee_found.found {
        return callee_found;
    }
    return first_argument_type_mismatch_in_expression_range(
        allocator,
        file,
        ast,
        args,
        local_types,
        function_param_types,
        function_returns
    );
}

fn argument_type_mismatch_for_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let callee_text = ast_text::ast_node_text(file, ast, callee);
    if function_calls::should_skip_function_reference(callee_text) or
        expression_infer::last_segment_starts_with_uppercase(callee_text) or
        (try expression_infer::is_generic_constructor_text(callee_text)) or
        ast_text::is_qualified_name(callee_text) {
        return diagnostic_summary::no_argument_type_mismatch();
    }
    var index = 0;
    while index < args.len {
        let arg = try ast.child_at(args, index);
        let expected = try function_params::lookup_function_param_type(function_param_types, callee_text, index);
        if !expected.found {
            return diagnostic_summary::no_argument_type_mismatch();
        }
        // A borrow parameter is filled by writing the borrow operator at the call site, so
        // the value measured here is the borrowed operand and the type it is measured
        // against is the parameter's element type.
        let passed = try function_params::borrow_argument_view(ast, arg, expected.type_name);
        let inferred = try expression_infer::infer_expression_type(
            allocator,
            file,
            ast,
            passed.node,
            local_types,
            function_returns
        );
        let contextual = expression_infer::contextual_integer(
            file,
            ast,
            passed.node,
            passed.type_name,
            inferred
        );
        if contextual.literal.found {
            let literal_node = ast.get(passed.node);
            return diagnostic_summary::integer_literal_range_argument_summary(
                literal_node.span.start,
                literal_node.span.end,
                contextual.literal.digits,
                contextual.literal.negations,
                contextual.literal.expected
            );
        }
        let actual = contextual.type_text;
        // A `dyn Contract` parameter accepts every type that explicitly implements the
        // contract, so the conformance table answers it instead of type identity.
        let dyn_contract = contract_rules::dyn_contract_name(passed.type_name);
        // The condition is bound rather than written in the `if` head: the MIR lowering
        // has no shape for a short-circuit condition on an if/else, so writing it inline
        // stops `selfhost stage selfhost`.
        let expects_contract = std::mem::len(dyn_contract) > 0 and
            !expression_infer::is_unknown_type_text(actual);
        if expects_contract {
            if !(try type_satisfies_contract(
                allocator, file, dyn_contract, actual, function_returns
            )) {
                let arg_node = ast.get(arg);
                return diagnostic_summary::unsatisfied_contract_argument_summary(
                    arg_node.span.start,
                    arg_node.span.end,
                    dyn_contract,
                    actual
                );
            }
        } else {
            // The view above stripped the parameter's borrow layer to measure the
            // borrowed operand against the element type. That is the right measurement
            // for `&x` where x owns its value, and the wrong one for `&x` where x is
            // already a borrow: a re-borrow carries the borrow the parameter wants, so
            // the operand is that borrow and not the element. Ask the declared type too,
            // and report only when the argument fits neither.
            if expression_infer::known_type_mismatch(passed.type_name, actual) and
                expression_infer::known_type_mismatch(expected.type_name, actual) {
                let arg_node = ast.get(arg);
                return diagnostic_summary::argument_type_summary(
                    true,
                    arg_node.span.start,
                    arg_node.span.end,
                    passed.type_name,
                    actual
                );
            }
        }
        index = index + 1;
    }
    return diagnostic_summary::no_argument_type_mismatch();
}

// type_satisfies_contract asks the conformance table recorded from `impl Contract for
// Type`. There is no implicit satisfaction in v0.2, so an unrecorded pair does not.
fn type_satisfies_contract(
    allocator: Allocator,
    file: &source::SourceFile,
    contract_name: []u8,
    type_name: []u8,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !bool {
    var key = std::string::String(allocator);
    defer key.deinit();
    try append_contract_conformance_prefix(key, allocator, file, contract_name, returns);
    try expression_infer::append_resolved_nominal_type(
        key, allocator, file, type_name, returns
    );
    let key_bytes = key.as_bytes();
    return returns.contains_source(&key_bytes);
}

fn first_argument_type_mismatch_in_two_expressions(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let first_found = try first_argument_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        first,
        local_types,
        function_param_types,
        function_returns
    );
    if first_found.found {
        return first_found;
    }
    return first_argument_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        second,
        local_types,
        function_param_types,
        function_returns
    );
}

fn first_argument_type_mismatch_in_if(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let condition_found = try first_argument_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        condition,
        local_types,
        function_param_types,
        function_returns
    );
    if condition_found.found {
        return condition_found;
    }
    let then_found = try first_argument_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        then_block,
        local_types,
        function_param_types,
        function_returns
    );
    if then_found.found {
        return then_found;
    }
    return first_argument_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        else_block,
        local_types,
        function_param_types,
        function_returns
    );
}

fn first_argument_type_mismatch_in_loop(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    condition: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let condition_found = try first_argument_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        condition,
        local_types,
        function_param_types,
        function_returns
    );
    if condition_found.found {
        return condition_found;
    }
    return first_argument_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        function_param_types,
        function_returns
    );
}

fn first_argument_type_mismatch_in_for(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    start: std::kizu::ast::NodeId,
    end: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let range_found = try first_argument_type_mismatch_in_two_expressions(
        allocator,
        file,
        ast,
        start,
        end,
        local_types,
        function_param_types,
        function_returns
    );
    if range_found.found {
        return range_found;
    }
    return first_argument_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        function_param_types,
        function_returns
    );
}

fn first_argument_type_mismatch_in_match(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_param_types: &std::array::Array<function_params::FunctionParamType>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let value_found = try first_argument_type_mismatch_in_expression(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_param_types,
        function_returns
    );
    if value_found.found {
        return value_found;
    }
    return first_argument_type_mismatch_in_statement_range(
        allocator,
        file,
        ast,
        arms,
        local_types,
        function_param_types,
        function_returns
    );
}

fn first_binary_operand_type_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_binary_operand_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_binary_operand_type_mismatch_in_function(
            allocator,
            file,
            ast,
            fn_decl.type_params,
            fn_decl.params,
            fn_decl.body,
            function_returns
        );,
        ImplDecl(impl_decl) => return first_binary_operand_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            impl_decl.methods,
            function_returns
        );,
        _ => return diagnostic_summary::no_argument_type_mismatch();,
    }
}

fn first_binary_operand_type_mismatch_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_binary_operand_type_mismatch_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_argument_type_mismatch();
}

fn first_binary_operand_type_mismatch_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    defer local_types.deinit();
    defer local_mutability.deinit();
    let locals = try local_facts::collect_function_statement_locals(
        allocator,
        file,
        ast,
        type_params,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let found = try first_binary_operand_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        function_returns
    );
    return found;
}

fn first_binary_operand_type_mismatch_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ArgumentTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_binary_operand_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            function_returns
        );,
        Let(let_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            let_node.value,
            local_types,
            function_returns
        );,
        Assign(assign_node) => return first_binary_operand_type_mismatch_in_two_expressions(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            local_types,
            function_returns
        );,
        Return(return_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            return_node.value,
            local_types,
            function_returns
        );,
        Defer(defer_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            defer_node.expr,
            local_types,
            function_returns
        );,
        ErrDefer(err_defer_node) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            err_defer_node.expr,
            local_types,
            function_returns
        );,
        ExprStmt(expr_stmt) => return first_binary_operand_type_mismatch_in_expression(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            local_types,
            function_returns
        );,
        If(if_node) => return first_binary_operand_type_mismatch_in_if(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            local_types,
            function_returns
        );,
        While(while_node) => return first_binary_operand_type_mismatch_in_loop(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            local_types,
            function_returns
        );,
        For(for_node) => return first_binary_operand_type_mismatch_in_for(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body,
            local_types,
            function_returns
        );,
        Match(match_node) => return first_binary_operand_type_mismatch_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            function_returns
        );,
        MatchArm(match_arm) => return first_binary_operand_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            function_returns
        );,
        Unsafe(unsafe_node) => return first_binary_operand_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return first_binary_operand_type_mismatch_in_comptime_if(
            allocator, file, ast, comptime_if_node.condition,
            comptime_if_node.then_block, comptime_if_node.else_block,
            local_types, function_returns
        );,
        _ => return diagnostic_summary::no_argument_type_mismatch();,
    }
}

