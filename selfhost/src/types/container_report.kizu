import selfhost::diagnostic;
import selfhost::types::container_storage;
import selfhost::types::model;

// container_report renders the container storage verdicts. It sits beside
// selfhost::types::reports rather than inside it because that module already carries every
// other report family and is at the size where one more concern stops being readable.

pub fn from_container_storage_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::ContainerStorageSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    let primary = diagnostic::file_span(path, summary.start, summary.end);
    var report = diagnostic::error_report(allocator, primary);
    try append_message(
        report.message, summary.kind, summary.cause,
        summary.owner, summary.member, summary.detail
    );
    return report;
}

fn append_message(
    message: &var std::string::String,
    kind: i64,
    cause: i64,
    owner: []u8,
    member: []u8,
    detail: []u8
) -> !void {
    if kind == container_storage::kind_map_key() {
        try message.append_bytes(
            "type error: std::map::Map key type must be []u8 in v0.2"
        );
        return;
    }
    if kind == container_storage::kind_map_value() {
        try message.append_bytes(
            "type error: std::map::Map value type must be copy in v0.2"
        );
        return;
    }
    if kind == container_storage::kind_borrow_field() {
        return append_borrow_message(message, "borrow field", owner, member);
    }
    if kind == container_storage::kind_borrow_payload() {
        return append_borrow_message(message, "borrow payload", owner, member);
    }
    return append_array_element_message(message, kind, cause, owner, member, detail);
}

fn append_borrow_message(
    message: &var std::string::String,
    position: []u8,
    owner: []u8,
    member: []u8
) -> !void {
    try message.append_bytes("type error: ");
    try message.append_bytes(position);
    try message.append_bytes(" `");
    try message.append_bytes(owner);
    try message.append_bytes(".");
    try message.append_bytes(member);
    try message.append_bytes("` cannot store borrow");
    return;
}

// The array report reads outside in: the position that refused the element, then the
// declaration the refused type was reached through, then the property that decided it.
fn append_array_element_message(
    message: &var std::string::String,
    kind: i64,
    cause: i64,
    owner: []u8,
    member: []u8,
    detail: []u8
) -> !void {
    try message.append_bytes("type error: Array element is not safe in v0.2: ");
    if kind == container_storage::kind_array_element_in_struct() {
        try append_frame(message, "struct", ".", owner, member);
    }
    if kind == container_storage::kind_array_element_in_union() {
        try append_frame(message, "union", "::", owner, member);
    }
    try message.append_bytes("type error: Array element cannot be ");
    try append_cause(message, cause, detail);
    try message.append_bytes(" in v0.2");
    return;
}

fn append_frame(
    message: &var std::string::String,
    declaration: []u8,
    separator: []u8,
    owner: []u8,
    member: []u8
) -> !void {
    try message.append_bytes("type error: ");
    try message.append_bytes(declaration);
    try message.append_bytes(" `");
    try message.append_bytes(owner);
    try message.append_bytes(separator);
    try message.append_bytes(member);
    try message.append_bytes("` cannot be Array element: ");
    return;
}

fn append_cause(
    message: &var std::string::String,
    cause: i64,
    detail: []u8
) -> !void {
    if cause == container_storage::cause_raw_pointer() {
        try message.append_bytes("raw pointer");
        return;
    }
    if cause == container_storage::cause_dyn() {
        try message.append_bytes("dyn");
        return;
    }
    try message.append_bytes(detail);
    return;
}
