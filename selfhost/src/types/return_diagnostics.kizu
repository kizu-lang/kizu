import selfhost::source;
import selfhost::types::ast_text;
import selfhost::types::diagnostic_summary;
import selfhost::types::expression_facts;
import selfhost::types::expression_infer;
import selfhost::types::local_facts;
import selfhost::types::model;
import selfhost::types::self_type_scope;
import selfhost::types::type_parameter_scope;

// ReturnScope carries what a return statement is measured against: the result type the
// declaration fixes, and the scope its spelling was read in. Both sides of the comparison
// are read in that scope -- a value's inferred spelling can mention the same static
// parameters the declared one does -- so the scope travels with the expected type rather
// than being applied to one side of the comparison only.
struct ReturnScope {
    expected: []u8,
    type_params: std::kizu::ast::ChildRange,
    type_args: std::kizu::ast::ChildRange,
}

pub fn first_return_type_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    self_type: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_return_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            self_type,
            function_returns
        );,
        FnDecl(fn_decl) => return first_return_type_mismatch_in_function(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.type_params,
            no_type_arguments(),
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            self_type,
            function_returns
        );,
        // The impl target is the type its methods read `Self` as, so the block hands its
        // own target down to the signatures written inside it.
        ImplDecl(impl_decl) => return first_return_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            impl_decl.methods,
            ast_text::ast_node_text(file, ast, impl_decl.type_name),
            function_returns
        );,
        _ => return diagnostic_summary::no_return_type_mismatch();,
    }
}
fn first_return_type_mismatch_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    self_type: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_return_type_mismatch_node(
            allocator,
            file,
            ast,
            child,
            self_type,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_return_type_mismatch();
}

// A generic declaration is checked in the scope one call site supplies: `type_args` is
// that call site's static arguments, and the empty range is the declaration read on its
// own, where its parameters bind no type.
pub fn first_return_type_mismatch_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    type_args: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    self_type: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    let locals = try local_facts::collect_function_statement_locals(
        allocator,
        file,
        ast,
        type_params,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let declared_return = try local_facts::function_statement_return_type(
        allocator,
        file,
        ast,
        name,
        return_type,
        function_returns
    );
    let scoped_return = try type_parameter_scope::scoped_type_text(
        allocator,
        file,
        ast,
        type_params,
        type_args,
        declared_return,
        function_returns
    );
    let scope = ReturnScope {
        expected: try self_type_scope::resolved_type_text(
            allocator,
            scoped_return,
            self_type,
            function_returns
        ),
        type_params: type_params,
        type_args: type_args
    };
    let found = try first_return_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        local_mutability,
        &scope,
        function_returns
    );
    local_types.deinit();
    local_mutability.deinit();
    return found;
}

fn first_return_type_mismatch_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>,
    scope: &ReturnScope,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_return_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            local_mutability,
            scope,
            function_returns
        );,
        Return(return_node) => return return_statement_type_mismatch(
            allocator,
            file,
            ast,
            return_node.value,
            local_types,
            scope,
            function_returns
        );,
        If(if_node) => return first_return_type_mismatch_in_two_statements(
            allocator,
            file,
            ast,
            if_node.then_block,
            if_node.else_block,
            local_types,
            local_mutability,
            scope,
            function_returns
        );,
        While(while_node) => return first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            while_node.body,
            local_types,
            local_mutability,
            scope,
            function_returns
        );,
        For(for_node) => return first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            for_node.body,
            local_types,
            local_mutability,
            scope,
            function_returns
        );,
        Match(match_node) => return first_return_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            match_node.arms,
            local_types,
            local_mutability,
            scope,
            function_returns
        );,
        MatchArm(match_arm) => return first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            local_mutability,
            scope,
            function_returns
        );,
        Unsafe(unsafe_node) => return first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            local_mutability,
            scope,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return first_return_type_mismatch_in_two_statements(
            allocator,
            file,
            ast,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types,
            local_mutability,
            scope,
            function_returns
        );,
        _ => return diagnostic_summary::no_return_type_mismatch();,
    }
}

fn first_return_type_mismatch_in_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>,
    scope: &ReturnScope,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        let found = try first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            child,
            local_types,
            local_mutability,
            scope,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_return_type_mismatch();
}

fn first_return_type_mismatch_in_two_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>,
    scope: &ReturnScope,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let first_found = try first_return_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        first,
        local_types,
        local_mutability,
        scope,
        function_returns
    );
    if first_found.found {
        return first_found;
    }
    return first_return_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        second,
        local_types,
        local_mutability,
        scope,
        function_returns
    );
}

fn return_statement_type_mismatch(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    scope: &ReturnScope,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::ReturnTypeSummary {
    let inferred = try expression_infer::infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    let contextual = expression_infer::contextual_integer(
        file,
        ast,
        value,
        scope.expected,
        inferred
    );
    let value_node = ast.get(value);
    if contextual.literal.found {
        return diagnostic_summary::integer_literal_range_return_summary(
            value_node.span.start,
            value_node.span.end,
            contextual.literal.digits,
            contextual.literal.negations,
            contextual.literal.expected
        );
    }
    let actual = try type_parameter_scope::scoped_type_text(
        allocator,
        file,
        ast,
        scope.type_params,
        scope.type_args,
        contextual.type_text,
        function_returns
    );
    if expression_infer::known_type_mismatch(scope.expected, actual) {
        return diagnostic_summary::return_type_summary(
            true,
            value_node.span.start,
            value_node.span.end,
            try ast_text::module_local_type_text(allocator, file, scope.expected),
            try ast_text::module_local_type_text(allocator, file, actual)
        );
    }
    return diagnostic_summary::no_return_type_mismatch();
}

pub fn first_missing_return_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::MissingReturnSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_missing_return_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_missing_return_in_function(
            allocator,
            file,
            ast,
            fn_decl.extern_abi,
            fn_decl.name,
            fn_decl.return_type,
            fn_decl.body,
            function_returns
        );,
        ImplDecl(impl_decl) => return first_missing_return_in_declarations(
            allocator,
            file,
            ast,
            impl_decl.methods,
            function_returns
        );,
        _ => return diagnostic_summary::no_missing_return();,
    }
}

fn first_missing_return_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::MissingReturnSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_missing_return_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_missing_return();
}

fn first_missing_return_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    extern_abi: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !model::MissingReturnSummary {
    // A declaration that names an external ABI has no body, so it has no statements
    // that could fail to return. Its obligation belongs to the foreign definition.
    if ast_text::declares_extern_abi(ast, extern_abi) {
        return diagnostic_summary::no_missing_return();
    }
    let expected_return = try local_facts::function_statement_return_type(
        allocator,
        file,
        ast,
        name,
        return_type,
        function_returns
    );
    if !function_requires_return(expected_return) {
        return diagnostic_summary::no_missing_return();
    }
    if try statement_always_returns(ast, body) {
        return diagnostic_summary::no_missing_return();
    }
    return diagnostic_summary::missing_return_summary(
        true,
        ast_text::ast_node_text(file, ast, name),
        expected_return
    );
}

// no_type_arguments is the declaration read on its own: no call site has supplied static
// arguments, so the declaration's type parameters bind nothing.
pub fn no_type_arguments() -> std::kizu::ast::ChildRange {
    return std::kizu::ast::ChildRange { start: 0, len: 0 };
}

fn function_requires_return(expected_return: []u8) -> bool {
    return !std::mem::equal_bytes(expected_return, "void");
}

fn statement_always_returns(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !bool {
    let node = ast.get(node_id);
    return match node.data {
        Block(block) => try statement_range_has_return(ast, block.statements),
        Return(return_node) => true,
        If(if_node) => (try statement_always_returns(ast, if_node.then_block)) and
            (try statement_always_returns(ast, if_node.else_block)),
        Match(match_node) => try statement_range_all_return(ast, match_node.arms),
        MatchArm(match_arm) => try statement_always_returns(ast, match_arm.body),
        Unsafe(unsafe_node) => try statement_always_returns(ast, unsafe_node.body),
        ComptimeIf(comptime_if_node) =>
            (try statement_always_returns(ast, comptime_if_node.then_block)) and
            (try statement_always_returns(ast, comptime_if_node.else_block)),
        _ => false,
    };
}

fn statement_range_has_return(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !bool {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        if try statement_always_returns(ast, child) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn statement_range_all_return(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !bool {
    if statements.len < 1 {
        return false;
    }
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        if !(try statement_always_returns(ast, child)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}
