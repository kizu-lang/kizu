import selfhost::source;
import selfhost::types::ast_text;
import selfhost::types::diagnostic_summary;
import selfhost::types::expression_infer;
import selfhost::types::local_facts;
import selfhost::types::model;

pub fn first_return_type_mismatch_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_return_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_return_type_mismatch_in_function(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            function_returns
        );,
        ImplDecl(impl_decl) => return first_return_type_mismatch_in_declarations(
            allocator,
            file,
            ast,
            impl_decl.methods,
            function_returns
        );,
        _ => return diagnostic_summary::no_return_type_mismatch();,
    }
}
fn first_return_type_mismatch_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_return_type_mismatch_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_return_type_mismatch();
}

fn first_return_type_mismatch_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    let locals = try local_facts::collect_function_statement_locals(
        allocator,
        file,
        ast,
        params,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    let expected_return = try local_facts::function_statement_return_type(
        allocator,
        file,
        ast,
        name,
        return_type,
        function_returns
    );
    let found = try first_return_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        body,
        local_types,
        local_mutability,
        expected_return,
        function_returns
    );
    local_types.deinit();
    local_mutability.deinit();
    return found;
}

fn first_return_type_mismatch_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>,
    expected_return: []u8,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_return_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Return(return_node) => return return_statement_type_mismatch(
            allocator,
            file,
            ast,
            return_node.value,
            local_types,
            expected_return,
            function_returns
        );,
        If(if_node) => return first_return_type_mismatch_in_two_statements(
            allocator,
            file,
            ast,
            if_node.then_block,
            if_node.else_block,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        While(while_node) => return first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            while_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        For(for_node) => return first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            for_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Match(match_node) => return first_return_type_mismatch_in_statement_range(
            allocator,
            file,
            ast,
            match_node.arms,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        MatchArm(match_arm) => return first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        Unsafe(unsafe_node) => return first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return first_return_type_mismatch_in_two_statements(
            allocator,
            file,
            ast,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );,
        _ => return diagnostic_summary::no_return_type_mismatch();,
    }
}

fn first_return_type_mismatch_in_statement_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>,
    expected_return: []u8,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        let found = try first_return_type_mismatch_in_statement(
            allocator,
            file,
            ast,
            child,
            local_types,
            local_mutability,
            expected_return,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_return_type_mismatch();
}

fn first_return_type_mismatch_in_two_statements(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>,
    expected_return: []u8,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    let first_found = try first_return_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        first,
        local_types,
        local_mutability,
        expected_return,
        function_returns
    );
    if first_found.found {
        return first_found;
    }
    return first_return_type_mismatch_in_statement(
        allocator,
        file,
        ast,
        second,
        local_types,
        local_mutability,
        expected_return,
        function_returns
    );
}

fn return_statement_type_mismatch(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    expected_return: []u8,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::ReturnTypeSummary {
    let actual = try expression_infer::infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    if expression_infer::known_type_mismatch(expected_return, actual) {
        let value_node = ast.get(value);
        return diagnostic_summary::return_type_summary(
            true,
            value_node.span.start,
            value_node.span.end,
            expected_return,
            actual
        );
    }
    return diagnostic_summary::no_return_type_mismatch();
}

pub fn first_missing_return_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::MissingReturnSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_missing_return_in_declarations(
            allocator,
            file,
            ast,
            program.declarations,
            function_returns
        );,
        FnDecl(fn_decl) => return first_missing_return_in_function(
            allocator,
            file,
            ast,
            fn_decl.extern_abi,
            fn_decl.name,
            fn_decl.return_type,
            fn_decl.body,
            function_returns
        );,
        ImplDecl(impl_decl) => return first_missing_return_in_declarations(
            allocator,
            file,
            ast,
            impl_decl.methods,
            function_returns
        );,
        _ => return diagnostic_summary::no_missing_return();,
    }
}

fn first_missing_return_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::MissingReturnSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_missing_return_node(
            allocator,
            file,
            ast,
            child,
            function_returns
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return diagnostic_summary::no_missing_return();
}

fn first_missing_return_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    extern_abi: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !model::MissingReturnSummary {
    if !return_diagnostics_node_is_empty(ast, extern_abi) {
        return diagnostic_summary::no_missing_return();
    }
    let expected_return = try local_facts::function_statement_return_type(
        allocator,
        file,
        ast,
        name,
        return_type,
        function_returns
    );
    if !function_requires_return(expected_return) {
        return diagnostic_summary::no_missing_return();
    }
    if try statement_always_returns(ast, body) {
        return diagnostic_summary::no_missing_return();
    }
    return diagnostic_summary::missing_return_summary(
        true,
        ast_text::ast_node_text(file, ast, name),
        expected_return
    );
}

fn function_requires_return(expected_return: []u8) -> bool {
    return !std::mem::equal_bytes(expected_return, "void");
}

fn return_diagnostics_node_is_empty(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Empty => true,
        _ => false,
    };
}

fn statement_always_returns(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !bool {
    let node = ast.get(node_id);
    return match node.data {
        Block(block) => try statement_range_has_return(ast, block.statements),
        Return(return_node) => true,
        If(if_node) => (try statement_always_returns(ast, if_node.then_block)) and
            (try statement_always_returns(ast, if_node.else_block)),
        Match(match_node) => try statement_range_all_return(ast, match_node.arms),
        MatchArm(match_arm) => try statement_always_returns(ast, match_arm.body),
        Unsafe(unsafe_node) => try statement_always_returns(ast, unsafe_node.body),
        ComptimeIf(comptime_if_node) =>
            (try statement_always_returns(ast, comptime_if_node.then_block)) and
            (try statement_always_returns(ast, comptime_if_node.else_block)),
        _ => false,
    };
}

fn statement_range_has_return(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !bool {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        if try statement_always_returns(ast, child) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn statement_range_all_return(
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !bool {
    if statements.len < 1 {
        return false;
    }
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        if !(try statement_always_returns(ast, child)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}
