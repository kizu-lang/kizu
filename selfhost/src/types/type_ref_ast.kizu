import selfhost::source;
import selfhost::type_constructor;
import selfhost::types::model;
import selfhost::types::package_modules;
import selfhost::types::type_ref_names;

pub fn first_type_error_in_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    var import_alias_starts = std::map::Map<[]u8, i64>(allocator);
    var import_alias_ends = std::map::Map<[]u8, i64>(allocator);
    try package_modules::collect_import_aliases_from_ast(
        file,
        &ast,
        root,
        import_alias_starts,
        import_alias_ends
    );
    let summary = try first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        root,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    import_alias_starts.deinit();
    import_alias_ends.deinit();
    return summary;
}

fn first_type_error_in_ast_with_imports(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let node = ast.get(root);
    match node.data {
        Program(program) => return first_type_error_in_ast_range(
            allocator,
            file,
            ast,
            program.declarations,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        FnDecl(fn_decl) => return first_type_error_in_fn_ast(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        StructDecl(struct_decl) => return first_type_error_in_ast_range(
            allocator,
            file,
            ast,
            struct_decl.fields,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        UnionDecl(union_decl) => return first_type_error_in_ast_range(
            allocator,
            file,
            ast,
            union_decl.variants,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ImplDecl(impl_decl) => return first_type_error_in_node_and_range_ast(
            allocator,
            file,
            ast,
            impl_decl.type_name,
            impl_decl.methods,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Param(param_node) => return first_type_error_in_type_node_ast(
            allocator,
            file,
            ast,
            param_node.type_node,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Field(field_node) => return first_type_error_in_type_node_ast(
            allocator,
            file,
            ast,
            field_node.type_node,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        UnionVariant(union_variant) => return first_type_error_in_type_node_ast(
            allocator,
            file,
            ast,
            union_variant.payload,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Block(block) => return first_type_error_in_ast_range(
            allocator,
            file,
            ast,
            block.statements,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Let(let_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            let_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Assign(assign_node) => return first_type_error_in_two_ast(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Return(return_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            return_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Defer(defer_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            defer_node.expr,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ErrDefer(err_defer_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            err_defer_node.expr,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ExprStmt(expr_stmt) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        If(if_node) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        While(while_node) => return first_type_error_in_two_ast(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        For(for_node) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Match(match_node) => return first_type_error_in_node_and_range_ast(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        MatchArm(match_arm) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            match_arm.pattern,
            match_arm.binding,
            match_arm.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Unsafe(unsafe_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            unsafe_node.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ComptimeIf(comptime_if_node) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Prefix(prefix_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            prefix_node.right,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Binary(binary) => return first_type_error_in_two_ast(
            allocator,
            file,
            ast,
            binary.left,
            binary.right,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        FieldExpr(field_expr_node) => return first_type_error_in_two_ast(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            field_expr_node.name,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        DerefExpr(deref_expr_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            deref_expr_node.receiver,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Call(call_node) => return first_type_error_in_node_and_range_ast(
            allocator,
            file,
            ast,
            call_node.callee,
            call_node.args,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        TypeApplyExpr(type_apply) => return first_type_error_in_type_apply_ast(
            allocator,
            file,
            ast,
            type_apply.callee,
            type_apply.type_args,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        CastExpr(cast_expr) => return first_type_error_in_cast_ast(
            allocator,
            file,
            ast,
            cast_expr.type_node,
            cast_expr.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        IndexExpr(index_expr) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        StructLiteralExpr(struct_literal) => return first_type_error_in_struct_literal_ast(
            allocator,
            file,
            ast,
            struct_literal.type_name,
            struct_literal.fields,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        StructFieldInit(struct_field_init) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            struct_field_init.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ArenaNewExpr(arena_new) => return first_type_error_in_cast_ast(
            allocator,
            file,
            ast,
            arena_new.type_node,
            arena_new.allocator,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        TryExpr(try_expr_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            try_expr_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ComptimeExpr(comptime_expr_node) => return first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        _ => return type_ref_names::no_type_reference_error();,
    }
    return type_ref_names::no_type_reference_error();
}

fn first_type_error_in_ast_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let found = try first_type_error_in_ast_with_imports(
            allocator,
            file,
            ast,
            child,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return type_ref_names::no_type_reference_error();
}

fn first_type_error_in_fn_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let param_error = try first_type_error_in_ast_range(
        allocator,
        file,
        ast,
        params,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    if param_error.found {
        return param_error;
    }
    let return_error = try first_type_error_in_type_node_ast(
        allocator,
        file,
        ast,
        return_type,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    if return_error.found {
        return return_error;
    }
    return first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        body,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
}

fn first_type_error_in_two_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let first_error = try first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        first,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    if first_error.found {
        return first_error;
    }
    return first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        second,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
}

fn first_type_error_in_three_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let first_error = try first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        first,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    if first_error.found {
        return first_error;
    }
    let second_error = try first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        second,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    if second_error.found {
        return second_error;
    }
    return first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        third,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
}

fn first_type_error_in_node_and_range_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let node_error = try first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        node_id,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    if node_error.found {
        return node_error;
    }
    return first_type_error_in_ast_range(
        allocator,
        file,
        ast,
        range,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
}

fn first_type_error_in_cast_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let type_error = try first_type_error_in_type_node_ast(
        allocator,
        file,
        ast,
        type_node,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    if type_error.found {
        return type_error;
    }
    return first_type_error_in_ast_with_imports(
        allocator,
        file,
        ast,
        value,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
}

fn first_type_error_in_struct_literal_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let type_error = try first_type_error_in_type_node_ast(
        allocator,
        file,
        ast,
        type_name,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    if type_error.found {
        return type_error;
    }
    return first_type_error_in_ast_range(
        allocator,
        file,
        ast,
        fields,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
}

fn first_type_error_in_type_apply_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let callee_text = ast_node_text(file, ast, callee);
    if is_generic_constructor_name(callee_text) {
        return first_type_error_in_type_range_ast(
            allocator,
            file,
            ast,
            type_args,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );
    }
    return type_ref_names::no_type_reference_error();
}

fn first_type_error_in_type_range_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let found = try first_type_error_in_type_node_ast(
            allocator,
            file,
            ast,
            child,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return type_ref_names::no_type_reference_error();
}

fn first_type_error_in_type_node_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let node = ast.get(type_node);
    match node.data {
        Empty => return type_ref_names::no_type_reference_error();,
        _ => return first_type_error_in_type_text(
            allocator,
            file,
            file.text[node.span.start..node.span.end],
            node.span.start,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
    }
    return type_ref_names::no_type_reference_error();
}

fn first_type_error_in_type_text(
    allocator: Allocator,
    file: &source::SourceFile,
    text: []u8,
    absolute_start: i64,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    var index = 0;
    while index < std::mem::len(text) {
        let byte = text[index];
        var next = index + 1;
        if is_type_identifier_start_byte(byte) {
            let start = index;
            let end = type_path_end_in_text(text, index);
            let name = text[start..end];
            if !should_ignore_type_name(name) {
                let found = try type_ref_names::type_error_for_name_text_with_imports(
                    allocator,
                    file,
                    kinds,
                    arities,
                    name,
                    text,
                    end,
                    absolute_start + start,
                    absolute_start + end,
                    import_alias_starts,
                    import_alias_ends
                );
                if found.found {
                    return found;
                }
            }
            next = end;
        }
        index = next;
    }
    return type_ref_names::no_type_reference_error();
}

fn ast_node_text(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return file.text[span.start..span.end];
}

pub fn should_ignore_type_name(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "const") or
        std::mem::equal_bytes(name, "dyn") or
        std::mem::equal_bytes(name, "mut") or
        std::mem::equal_bytes(name, "var") or
        std::mem::equal_bytes(name, "comptime") or
        std::mem::equal_bytes(name, "pub");
}

pub fn is_type_identifier_start_byte(byte: u8) -> bool {
    return (byte >= cast<u8>(65) and byte <= cast<u8>(90)) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        byte == cast<u8>(95);
}

fn is_type_identifier_part_byte(byte: u8) -> bool {
    return is_type_identifier_start_byte(byte) or
        (byte >= cast<u8>(48) and byte <= cast<u8>(57));
}

fn type_segment_end_in_text(text: []u8, start: i64) -> i64 {
    var cursor = start;
    while cursor < std::mem::len(text) and is_type_identifier_part_byte(text[cursor]) {
        cursor = cursor + 1;
    }
    return cursor;
}

pub fn type_path_end_in_text(text: []u8, start: i64) -> i64 {
    var cursor = type_segment_end_in_text(text, start);
    while cursor + 2 < std::mem::len(text) and
        text[cursor] == cast<u8>(58) and
        text[cursor + 1] == cast<u8>(58) and
        is_type_identifier_start_byte(text[cursor + 2]) {
        cursor = type_segment_end_in_text(text, cursor + 2);
    }
    return cursor;
}

pub fn is_generic_constructor_name(name: []u8) -> bool {
    return type_constructor::is_builtin_name(name);
}
