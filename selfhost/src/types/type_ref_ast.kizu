import selfhost::source;
import selfhost::types::model;

pub fn first_type_error_in_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let node = ast.get(root);
    match node.data {
        Program(program) => return first_type_error_in_ast_range(
            allocator,
            file,
            ast,
            program.declarations,
            kinds,
            arities
        );,
        FnDecl(fn_decl) => return first_type_error_in_fn_ast(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            kinds,
            arities
        );,
        StructDecl(struct_decl) => return first_type_error_in_ast_range(
            allocator,
            file,
            ast,
            struct_decl.fields,
            kinds,
            arities
        );,
        UnionDecl(union_decl) => return first_type_error_in_ast_range(
            allocator,
            file,
            ast,
            union_decl.variants,
            kinds,
            arities
        );,
        Param(param_node) => return first_type_error_in_type_node_ast(
            allocator,
            file,
            ast,
            param_node.type_node,
            kinds,
            arities
        );,
        Field(field_node) => return first_type_error_in_type_node_ast(
            allocator,
            file,
            ast,
            field_node.type_node,
            kinds,
            arities
        );,
        UnionVariant(union_variant) => return first_type_error_in_type_node_ast(
            allocator,
            file,
            ast,
            union_variant.payload,
            kinds,
            arities
        );,
        Block(block) => return first_type_error_in_ast_range(
            allocator,
            file,
            ast,
            block.statements,
            kinds,
            arities
        );,
        Let(let_node) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            let_node.value,
            kinds,
            arities
        );,
        Assign(assign_node) => return first_type_error_in_two_ast(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            kinds,
            arities
        );,
        Return(return_node) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            return_node.value,
            kinds,
            arities
        );,
        Defer(defer_node) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            defer_node.expr,
            kinds,
            arities
        );,
        ExprStmt(expr_stmt) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            kinds,
            arities
        );,
        If(if_node) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            kinds,
            arities
        );,
        While(while_node) => return first_type_error_in_two_ast(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            kinds,
            arities
        );,
        For(for_node) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body,
            kinds,
            arities
        );,
        Match(match_node) => return first_type_error_in_node_and_range_ast(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            kinds,
            arities
        );,
        MatchArm(match_arm) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            match_arm.pattern,
            match_arm.binding,
            match_arm.body,
            kinds,
            arities
        );,
        Unsafe(unsafe_node) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            unsafe_node.body,
            kinds,
            arities
        );,
        ComptimeIf(comptime_if_node) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            kinds,
            arities
        );,
        Prefix(prefix_node) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            prefix_node.right,
            kinds,
            arities
        );,
        Binary(binary) => return first_type_error_in_two_ast(
            allocator,
            file,
            ast,
            binary.left,
            binary.right,
            kinds,
            arities
        );,
        FieldExpr(field_expr_node) => return first_type_error_in_two_ast(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            field_expr_node.name,
            kinds,
            arities
        );,
        DerefExpr(deref_expr_node) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            deref_expr_node.receiver,
            kinds,
            arities
        );,
        Call(call_node) => return first_type_error_in_node_and_range_ast(
            allocator,
            file,
            ast,
            call_node.callee,
            call_node.args,
            kinds,
            arities
        );,
        TypeApplyExpr(type_apply) => return first_type_error_in_type_apply_ast(
            allocator,
            file,
            ast,
            type_apply.callee,
            type_apply.type_args,
            kinds,
            arities
        );,
        CastExpr(cast_expr) => return first_type_error_in_cast_ast(
            allocator,
            file,
            ast,
            cast_expr.type_node,
            cast_expr.value,
            kinds,
            arities
        );,
        IndexExpr(index_expr) => return first_type_error_in_three_ast(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end,
            kinds,
            arities
        );,
        StructLiteralExpr(struct_literal) => return first_type_error_in_struct_literal_ast(
            allocator,
            file,
            ast,
            struct_literal.type_name,
            struct_literal.fields,
            kinds,
            arities
        );,
        StructFieldInit(struct_field_init) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            struct_field_init.value,
            kinds,
            arities
        );,
        ArenaNewExpr(arena_new) => return first_type_error_in_cast_ast(
            allocator,
            file,
            ast,
            arena_new.type_node,
            arena_new.allocator,
            kinds,
            arities
        );,
        TryExpr(try_expr_node) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            try_expr_node.value,
            kinds,
            arities
        );,
        ComptimeExpr(comptime_expr_node) => return first_type_error_in_ast(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            kinds,
            arities
        );,
        _ => return no_type_reference_error();,
    }
    return no_type_reference_error();
}

fn first_type_error_in_ast_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let found = try first_type_error_in_ast(allocator, file, ast, child, kinds, arities);
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_type_reference_error();
}

fn first_type_error_in_fn_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let param_error = try first_type_error_in_ast_range(allocator, file, ast, params, kinds, arities);
    if param_error.found {
        return param_error;
    }
    let return_error = try first_type_error_in_type_node_ast(allocator, file, ast, return_type, kinds, arities);
    if return_error.found {
        return return_error;
    }
    return first_type_error_in_ast(allocator, file, ast, body, kinds, arities);
}

fn first_type_error_in_two_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let first_error = try first_type_error_in_ast(allocator, file, ast, first, kinds, arities);
    if first_error.found {
        return first_error;
    }
    return first_type_error_in_ast(allocator, file, ast, second, kinds, arities);
}

fn first_type_error_in_three_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let first_error = try first_type_error_in_ast(allocator, file, ast, first, kinds, arities);
    if first_error.found {
        return first_error;
    }
    let second_error = try first_type_error_in_ast(allocator, file, ast, second, kinds, arities);
    if second_error.found {
        return second_error;
    }
    return first_type_error_in_ast(allocator, file, ast, third, kinds, arities);
}

fn first_type_error_in_node_and_range_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let node_error = try first_type_error_in_ast(allocator, file, ast, node_id, kinds, arities);
    if node_error.found {
        return node_error;
    }
    return first_type_error_in_ast_range(allocator, file, ast, range, kinds, arities);
}

fn first_type_error_in_cast_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let type_error = try first_type_error_in_type_node_ast(allocator, file, ast, type_node, kinds, arities);
    if type_error.found {
        return type_error;
    }
    return first_type_error_in_ast(allocator, file, ast, value, kinds, arities);
}

fn first_type_error_in_struct_literal_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let type_error = try first_type_error_in_type_node_ast(allocator, file, ast, type_name, kinds, arities);
    if type_error.found {
        return type_error;
    }
    return first_type_error_in_ast_range(allocator, file, ast, fields, kinds, arities);
}

fn first_type_error_in_type_apply_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let callee_text = ast_node_text(file, ast, callee);
    if is_generic_constructor_name(callee_text) {
        return first_type_error_in_type_range_ast(allocator, file, ast, type_args, kinds, arities);
    }
    return no_type_reference_error();
}

fn first_type_error_in_type_range_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let found = try first_type_error_in_type_node_ast(allocator, file, ast, child, kinds, arities);
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_type_reference_error();
}

fn first_type_error_in_type_node_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    let node = ast.get(type_node);
    match node.data {
        Empty => return no_type_reference_error();,
        _ => return first_type_error_in_type_text(
            allocator,
            file,
            file.text[node.span.start..node.span.end],
            node.span.start,
            kinds,
            arities
        );,
    }
    return no_type_reference_error();
}

fn first_type_error_in_type_text(
    allocator: Allocator,
    file: &source::SourceFile,
    text: []u8,
    absolute_start: i64,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !model::TypeReferenceSummary {
    var index = 0;
    while index < std::mem::len(text) {
        let byte = text[index];
        if is_type_identifier_start_byte(byte) {
            let start = index;
            let end = type_path_end_in_text(text, index);
            let name = text[start..end];
            if !should_ignore_type_name(name) {
                let found = try type_error_for_name_text(
                    allocator,
                    file,
                    kinds,
                    arities,
                    name,
                    text,
                    end,
                    absolute_start + start,
                    absolute_start + end
                );
                if found.found {
                    return found;
                }
            }
            index = end;
        } else {
            index = index + 1;
        }
    }
    return no_type_reference_error();
}

fn type_error_for_name_text(
    allocator: Allocator,
    file: &source::SourceFile,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    name: []u8,
    text: []u8,
    next_index: i64,
    start: i64,
    end: i64
) -> !model::TypeReferenceSummary {
    if try type_reference_exists(allocator, file, kinds, name) {
        let observed = observed_type_arity_text(text, next_index);
        let expected = try expected_type_arity(allocator, file, kinds, arities, name);
        if expected >= 0 and expected != observed {
            return type_reference_summary(true, 2, start, end, expected, observed);
        }
        return no_type_reference_error();
    }
    return type_reference_summary(true, 1, start, end, 0, 0);
}

fn type_reference_exists(
    allocator: Allocator,
    file: &source::SourceFile,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    name: []u8
) -> !bool {
    var resolved = std::string::String(allocator);
    try append_resolved_type_reference_name(resolved, file, kinds, name);
    let key = resolved.as_bytes();
    let exists = kinds.contains(key);
    resolved.deinit();
    return exists;
}

fn expected_type_arity(
    allocator: Allocator,
    file: &source::SourceFile,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    name: []u8
) -> !i64 {
    var arity_name = std::string::String(allocator);
    try append_resolved_type_reference_name(arity_name, file, kinds, name);
    let key = arity_name.as_bytes();
    var expected = -1;
    if arities.contains(key) {
        expected = try arities.get(key);
    }
    arity_name.deinit();
    return expected;
}

fn append_resolved_type_reference_name(
    resolved: &var std::string::String,
    file: &source::SourceFile,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    name: []u8
) -> !void {
    if kinds.contains(name) or is_qualified_name(name) {
        try resolved.append_bytes(name);
        return;
    }
    if is_unqualified_type_like(name) {
        try append_module_name(resolved, file);
        try resolved.append_bytes("::");
        try resolved.append_bytes(name);
        return;
    }
    try resolved.append_bytes(name);
    return;
}

fn append_module_name(
    name: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    if file.kind == source::SourceKind::Std {
        try name.append_bytes("std::");
    } else {
        try name.append_bytes("selfhost::");
    }
    try source::append_module_path(name, file);
    return;
}

fn ast_node_text(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return file.text[span.start..span.end];
}

fn type_reference_summary(
    found: bool,
    kind: i64,
    start: i64,
    end: i64,
    expected: i64,
    observed: i64
) -> model::TypeReferenceSummary {
    return model::TypeReferenceSummary {
        found: found,
        kind: kind,
        start: start,
        end: end,
        expected: expected,
        observed: observed
    };
}

fn no_type_reference_error() -> model::TypeReferenceSummary {
    return type_reference_summary(false, 0, 0, 0, 0, 0);
}

fn should_ignore_type_name(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "const") or
        std::mem::equal_bytes(name, "dyn") or
        std::mem::equal_bytes(name, "mut") or
        std::mem::equal_bytes(name, "var") or
        std::mem::equal_bytes(name, "comptime") or
        std::mem::equal_bytes(name, "pub");
}

fn is_unqualified_type_like(name: []u8) -> bool {
    if std::mem::len(name) < 1 {
        return false;
    }
    return starts_with_uppercase(name);
}

fn starts_with_uppercase(name: []u8) -> bool {
    if std::mem::len(name) < 1 {
        return false;
    }
    let byte = name[0];
    return byte >= cast<u8>(65) and byte <= cast<u8>(90);
}

fn is_type_identifier_start_byte(byte: u8) -> bool {
    return (byte >= cast<u8>(65) and byte <= cast<u8>(90)) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122)) or
        byte == cast<u8>(95);
}

fn is_type_identifier_part_byte(byte: u8) -> bool {
    return is_type_identifier_start_byte(byte) or
        (byte >= cast<u8>(48) and byte <= cast<u8>(57));
}

fn type_segment_end_in_text(text: []u8, start: i64) -> i64 {
    var cursor = start;
    while cursor < std::mem::len(text) and is_type_identifier_part_byte(text[cursor]) {
        cursor = cursor + 1;
    }
    return cursor;
}

fn type_path_end_in_text(text: []u8, start: i64) -> i64 {
    var cursor = type_segment_end_in_text(text, start);
    while cursor + 2 < std::mem::len(text) and
        text[cursor] == cast<u8>(58) and
        text[cursor + 1] == cast<u8>(58) and
        is_type_identifier_start_byte(text[cursor + 2]) {
        cursor = type_segment_end_in_text(text, cursor + 2);
    }
    return cursor;
}

fn is_qualified_name(name: []u8) -> bool {
    var index = 0;
    while index + 1 < std::mem::len(name) {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn observed_type_arity_text(text: []u8, index: i64) -> i64 {
    if index >= std::mem::len(text) {
        return 0;
    }
    if text[index] != cast<u8>(60) {
        return 0;
    }
    return count_type_arguments_text(text, index);
}

fn count_type_arguments_text(text: []u8, open_index: i64) -> i64 {
    var count = 1;
    var depth = 1;
    var cursor = open_index + 1;
    while cursor < std::mem::len(text) and depth > 0 {
        let byte = text[cursor];
        if byte == cast<u8>(60) {
            depth = depth + 1;
        } else {
            if byte == cast<u8>(62) {
                depth = depth - 1;
            } else {
                if depth == 1 and byte == cast<u8>(44) {
                    count = count + 1;
                }
            }
        }
        cursor = cursor + 1;
    }
    return count;
}

fn is_generic_constructor_name(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "std::array::Array") or
        std::mem::equal_bytes(name, "std::map::Map") or
        std::mem::equal_bytes(name, "std::mem::Box") or
        std::mem::equal_bytes(name, "std::arena::Arena") or
        std::mem::equal_bytes(name, "std::arena::Handle");
}
