import selfhost::ir::intrinsic_type_contract;

// The concurrency operation registry.
//
// SPEC.md:1648 states one rule for a `comptime Function` parameter: the argument is a
// restricted function-name token, resolved in the function namespace, and never a value.
// A `Function` parameter is reserved for std, so every declaration that carries such a
// slot belongs to std's concurrency surface. This file records, per operation identity,
// where that slot sits and what contract the operation imposes on the named worker.
//
// Two identity forms reach the same operation set:
//
//   - a std function whose declaration carries the slot (std/src/task.kizu:17,22 and
//     std/src/thread.kizu:1),
//   - an intrinsic method whose receiver is a builtin type and which therefore has no
//     declaration anywhere; its slot is registry data in the same sense that
//     selfhost::ir::builtin_call_identity records the operation behind a builtin method.
//
// Nothing here keys on a user-level identifier spelling: the entries are std module
// paths and intrinsic type identities from selfhost::ir::intrinsic_type_contract.

pub fn op_none() -> i64 { return 0; }
pub fn op_task_spawn() -> i64 { return 1; }
pub fn op_queue_enqueue() -> i64 { return 2; }
pub fn op_parallel_for() -> i64 { return 3; }
pub fn op_parallel_map() -> i64 { return 4; }
pub fn op_thread_scoped() -> i64 { return 5; }

// path_operation resolves the std wrapper that declares a comptime Function parameter.
pub fn path_operation(name: []u8) -> i64 {
    if std::mem::equal_bytes(name, "std::task::parallel_for") { return op_parallel_for(); }
    if std::mem::equal_bytes(name, "std::task::parallel_map") { return op_parallel_map(); }
    if std::mem::equal_bytes(name, "std::thread::scoped") { return op_thread_scoped(); }
    return op_none();
}

// builtin_path_operation resolves the compiler builtin each std wrapper lowers to. The
// builtin carries the same slot layout, so a direct call resolves its worker the same
// way -- and is then rejected, because the wrapper is the only supported entry point.
pub fn builtin_path_operation(name: []u8) -> i64 {
    if std::mem::equal_bytes(name, "std::builtin::task_parallel_for") { return op_parallel_for(); }
    if std::mem::equal_bytes(name, "std::builtin::task_parallel_map") { return op_parallel_map(); }
    if std::mem::equal_bytes(name, "std::builtin::thread_scoped") { return op_thread_scoped(); }
    return op_none();
}

// reserving_module names the std module that owns a builtin's supported entry point.
pub fn reserving_module(operation: i64) -> []u8 {
    if operation == op_thread_scoped() { return "std::thread"; }
    return "std::task";
}

// method_operation resolves an intrinsic method that carries the slot.
pub fn method_operation(receiver_kind: i64, method: []u8) -> i64 {
    if receiver_kind == intrinsic_type_contract::kind_task_group() and
        std::mem::equal_bytes(method, "spawn") {
        return op_task_spawn();
    }
    if receiver_kind == intrinsic_type_contract::kind_queue() and
        std::mem::equal_bytes(method, "enqueue") {
        return op_queue_enqueue();
    }
    return op_none();
}

// function_slot is the argument index that holds the function-name token, or -1.
pub fn function_slot(operation: i64) -> i64 {
    if operation == op_task_spawn() { return 0; }
    if operation == op_queue_enqueue() { return 1; }
    if operation == op_parallel_for() { return 3; }
    if operation == op_parallel_map() { return 4; }
    if operation == op_thread_scoped() { return 1; }
    return -1;
}

// binding_shadows_function_name reports whether a value binding that occupies the slot is
// diagnosed as "not a function name" rather than as an undefined function.
//
// The distinction is per operation because the oracle resolves the slot differently.
// `TaskGroup.spawn` falls back to the value scope and reports the binding it finds there
// (internal/types/checker.go:6001). Every other operation looks the token up in the
// function namespace alone -- `queue.enqueue` at :6109 and the shared
// resolveFunctionNameArg at :6396, which admits only a `Function`-typed binding -- so a
// name that no declaration defines is simply undefined.
pub fn binding_shadows_function_name(operation: i64) -> bool {
    return operation == op_task_spawn();
}

// operation_label names the operation the way its diagnostics do.
pub fn operation_label(operation: i64) -> []u8 {
    if operation == op_task_spawn() { return "TaskGroup.spawn"; }
    if operation == op_queue_enqueue() { return "queue.enqueue"; }
    if operation == op_parallel_for() { return "std::task::parallel_for"; }
    if operation == op_parallel_map() { return "std::task::parallel_map"; }
    if operation == op_thread_scoped() { return "std::thread::scoped"; }
    return "";
}

// capture_owner names the side of the boundary that would hold a captured borrow.
pub fn capture_owner(operation: i64) -> []u8 {
    if operation == op_task_spawn() { return "task"; }
    if operation == op_queue_enqueue() { return "queue"; }
    if operation == op_thread_scoped() { return "thread"; }
    return "";
}

// spawns_with_owned_io reports whether the operation hands the worker an Io it owns.
// Such a worker names that Io as its first parameter and cannot borrow it, because the
// borrow would outlive the scope that created it.
pub fn spawns_with_owned_io(operation: i64) -> bool {
    return operation == op_task_spawn() or operation == op_queue_enqueue();
}

// constructor_result_type gives the intrinsic type a std constructor produces. These
// wrappers return a builtin type that no declaration spells out, so the result type is
// registry data rather than a declared return type.
pub fn constructor_result_type(name: []u8) -> []u8 {
    if std::mem::equal_bytes(name, "std::task::Group") { return "TaskGroup"; }
    if std::mem::equal_bytes(name, "std::task::Queue") { return "Queue"; }
    if std::mem::equal_bytes(name, "std::task::partition_mut") { return "Partition"; }
    if std::mem::equal_bytes(name, "std::task::LocalBuffer") { return "LocalBuffer"; }
    return "";
}

// An intrinsic constructor's parameter contract belongs to the compiler, not to the thin
// std wrapper that forwards it: the wrapper's body is a builtin call, so the argument
// types are registry data here just as the result type above is
// (internal/types/checker.go:6013, :6279 and :6305 are the oracle).
pub fn constructor_param_count(name: []u8) -> i64 {
    if std::mem::equal_bytes(name, "std::task::Group") { return 1; }
    if std::mem::equal_bytes(name, "std::task::partition_mut") { return 2; }
    if std::mem::equal_bytes(name, "std::task::LocalBuffer") { return 2; }
    return -1;
}

pub fn constructor_param_type(name: []u8, index: i64) -> []u8 {
    if std::mem::equal_bytes(name, "std::task::Group") { return "Io"; }
    if std::mem::equal_bytes(name, "std::task::partition_mut") { return "i64"; }
    if std::mem::equal_bytes(name, "std::task::LocalBuffer") { return "i64"; }
    return "";
}

// constructor_param_role names the slot the way its diagnostic does.
pub fn constructor_param_role(name: []u8, index: i64) -> []u8 {
    if std::mem::equal_bytes(name, "std::task::Group") { return "`std::task::Group`"; }
    if std::mem::equal_bytes(name, "std::task::partition_mut") {
        if index == 0 { return "partition init"; }
        return "partition count";
    }
    if std::mem::equal_bytes(name, "std::task::LocalBuffer") {
        if index == 0 { return "LocalBuffer count"; }
        return "LocalBuffer init";
    }
    return "";
}

// completes_task reports whether an intrinsic method consumes a task's single result.
pub fn completes_task(receiver_kind: i64, method: []u8) -> bool {
    if receiver_kind != intrinsic_type_contract::kind_task() {
        return false;
    }
    return std::mem::equal_bytes(method, "await") or std::mem::equal_bytes(method, "cancel");
}

// mutable_slot_accessor reports the intrinsic methods that name a slot the compiler owns
// and may be written through. A partition exists to be filled in place, so its element
// accessor is an assignment target; no other intrinsic method is.
pub fn mutable_slot_accessor(receiver_kind: i64, method: []u8) -> bool {
    return receiver_kind == intrinsic_type_contract::kind_partition() and
        std::mem::equal_bytes(method, "at");
}

// boundary_message is the reason an intrinsic type cannot be moved across a concurrency
// boundary. An empty answer means the identity has no boundary restriction.
pub fn boundary_message(kind: i64) -> []u8 {
    if kind == intrinsic_type_contract::kind_arena() {
        return "arena cannot cross concurrency boundary";
    }
    if kind == intrinsic_type_contract::kind_arena_handle() {
        return "handle cannot cross concurrency boundary";
    }
    if kind == intrinsic_type_contract::kind_array() {
        return "Array cannot cross concurrency boundary in v0.2";
    }
    if kind == intrinsic_type_contract::kind_map() {
        return "Map cannot cross concurrency boundary in v0.2";
    }
    if kind == intrinsic_type_contract::kind_mutex() {
        return "Mutex cannot cross concurrency boundary in v0.1";
    }
    if kind == intrinsic_type_contract::kind_task() {
        return "Task cannot cross concurrency boundary";
    }
    return "";
}

// carries_element_boundary reports the intrinsic types whose own identity crosses a
// boundary safely but whose element does not.
pub fn carries_element_boundary(kind: i64) -> bool {
    return kind == intrinsic_type_contract::kind_channel() or
        kind == intrinsic_type_contract::kind_option() or
        kind == intrinsic_type_contract::kind_atomic() or
        kind == intrinsic_type_contract::kind_box();
}
