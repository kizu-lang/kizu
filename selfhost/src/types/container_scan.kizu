import selfhost::source;
import selfhost::types::ast_text;
import selfhost::types::container_storage;
import selfhost::types::model;
import selfhost::types::package_modules;

// container_scan walks the declarations and bodies of one file and hands every position
// that writes a type spelling to selfhost::types::container_storage, which owns what a
// container may hold. Keeping the walk here leaves that module to answer about a type and
// nothing else, and leaves this one with a single job: reach every written spelling once,
// in source order, carrying the two facts a report needs -- the declaration that owns the
// position, and the static parameters in scope where it was written.

pub fn first_container_storage_diagnostic_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>
) -> !model::ContainerStorageSummary {
    var alias_starts = std::map::Map<[]u8, i64>(allocator);
    var alias_ends = std::map::Map<[]u8, i64>(allocator);
    defer alias_starts.deinit();
    defer alias_ends.deinit();
    try package_modules::collect_import_aliases_from_ast(
        file, &ast, root, alias_starts, alias_ends
    );
    let empty = std::kizu::ast::ChildRange { start: 0, len: 0 };
    return try visit_node(
        allocator, file, ast, root, root, kinds, copyable,
        alias_starts, alias_ends, empty, ""
    );
}

// Every position that writes a type spelling is visited, because the map rules are
// properties of the spelling wherever it stands, and the two declaration positions carry
// the owner name their reports need. `type_params` is the enclosing declaration's own
// static parameters; a spelling that mentions one fixes no type until an instantiation is
// checked, so the whole spelling stands down.
fn visit_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node_id: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>,
    alias_starts: &std::map::Map<[]u8, i64>,
    alias_ends: &std::map::Map<[]u8, i64>,
    type_params: std::kizu::ast::ChildRange,
    owner: []u8
) -> !model::ContainerStorageSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return visit_range(
            allocator, file, ast, root, program.declarations, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        FnDecl(fn_decl) => return visit_function(
            allocator, file, ast, root, fn_decl.type_params, fn_decl.params,
            fn_decl.return_type, fn_decl.body, kinds, copyable, alias_starts, alias_ends
        );,
        StructDecl(struct_decl) => return visit_range(
            allocator, file, ast, root, struct_decl.fields, kinds, copyable,
            alias_starts, alias_ends, struct_decl.type_params,
            ast_text::ast_node_text(file, ast, struct_decl.name)
        );,
        UnionDecl(union_decl) => return visit_range(
            allocator, file, ast, root, union_decl.variants, kinds, copyable,
            alias_starts, alias_ends, union_decl.type_params,
            ast_text::ast_node_text(file, ast, union_decl.name)
        );,
        ImplDecl(impl_decl) => return visit_range(
            allocator, file, ast, root, impl_decl.methods, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        ContractDecl(contract_decl) => return visit_range(
            allocator, file, ast, root, contract_decl.methods, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        Param(param_node) => return container_storage::spelling_violation(
            allocator, file, ast, kinds, copyable, alias_starts, alias_ends, type_params,
            ast_text::ast_node_text(file, ast, param_node.type_node), node_id
        );,
        Field(field_node) => return container_storage::stored_violation(
            allocator, file, ast, kinds, copyable, alias_starts, alias_ends, type_params,
            node_id, owner, field_node.name, field_node.type_node,
            container_storage::kind_borrow_field()
        );,
        UnionVariant(variant_node) => return container_storage::stored_violation(
            allocator, file, ast, kinds, copyable, alias_starts, alias_ends, type_params,
            node_id, owner, variant_node.name, variant_node.payload,
            container_storage::kind_borrow_payload()
        );,
        Block(block) => return visit_range(
            allocator, file, ast, root, block.statements, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        Let(let_node) => return visit_node(
            allocator, file, ast, root, let_node.value, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        Assign(assign_node) => return visit_two(
            allocator, file, ast, root, assign_node.target, assign_node.value,
            kinds, copyable, alias_starts, alias_ends, type_params, owner
        );,
        Return(return_node) => return visit_node(
            allocator, file, ast, root, return_node.value, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        Defer(defer_node) => return visit_node(
            allocator, file, ast, root, defer_node.expr, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        ErrDefer(err_defer_node) => return visit_node(
            allocator, file, ast, root, err_defer_node.expr, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        ExprStmt(expr_stmt) => return visit_node(
            allocator, file, ast, root, expr_stmt.expr, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        If(if_node) => return visit_three(
            allocator, file, ast, root, if_node.condition, if_node.then_block,
            if_node.else_block, kinds, copyable, alias_starts, alias_ends,
            type_params, owner
        );,
        While(while_node) => return visit_two(
            allocator, file, ast, root, while_node.condition, while_node.body,
            kinds, copyable, alias_starts, alias_ends, type_params, owner
        );,
        For(for_node) => return visit_node(
            allocator, file, ast, root, for_node.body, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        Match(match_node) => return visit_range(
            allocator, file, ast, root, match_node.arms, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        MatchArm(match_arm) => return visit_node(
            allocator, file, ast, root, match_arm.body, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        Unsafe(unsafe_node) => return visit_node(
            allocator, file, ast, root, unsafe_node.body, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        ComptimeIf(comptime_if) => return visit_three(
            allocator, file, ast, root, comptime_if.condition, comptime_if.then_block,
            comptime_if.else_block, kinds, copyable, alias_starts, alias_ends,
            type_params, owner
        );,
        TryExpr(try_expr) => return visit_node(
            allocator, file, ast, root, try_expr.value, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        ComptimeExpr(comptime_expr) => return visit_node(
            allocator, file, ast, root, comptime_expr.value, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        Prefix(prefix_node) => return visit_node(
            allocator, file, ast, root, prefix_node.right, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        Binary(binary_node) => return visit_two(
            allocator, file, ast, root, binary_node.left, binary_node.right,
            kinds, copyable, alias_starts, alias_ends, type_params, owner
        );,
        Call(call_node) => return visit_call(
            allocator, file, ast, root, call_node.callee, call_node.args,
            kinds, copyable, alias_starts, alias_ends, type_params, owner
        );,
        TypeApplyExpr(type_apply) => return container_storage::spelling_violation(
            allocator, file, ast, kinds, copyable, alias_starts, alias_ends, type_params,
            ast_text::ast_node_text(file, ast, node_id), node_id
        );,
        FieldExpr(field_expr) => return visit_node(
            allocator, file, ast, root, field_expr.receiver, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        DerefExpr(deref_expr) => return visit_node(
            allocator, file, ast, root, deref_expr.receiver, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        CastExpr(cast_expr) => return visit_typed_expression(
            allocator, file, ast, root, cast_expr.type_node, cast_expr.value,
            kinds, copyable, alias_starts, alias_ends, type_params, owner
        );,
        ArenaNewExpr(arena_new) => return visit_typed_expression(
            allocator, file, ast, root, arena_new.type_node, arena_new.allocator,
            kinds, copyable, alias_starts, alias_ends, type_params, owner
        );,
        IndexExpr(index_expr) => return visit_three(
            allocator, file, ast, root, index_expr.target, index_expr.start,
            index_expr.end, kinds, copyable, alias_starts, alias_ends, type_params, owner
        );,
        StructLiteralExpr(struct_literal) => return visit_literal(
            allocator, file, ast, root, struct_literal.type_name, struct_literal.fields,
            kinds, copyable, alias_starts, alias_ends, type_params, owner
        );,
        StructFieldInit(field_init) => return visit_node(
            allocator, file, ast, root, field_init.value, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );,
        _ => return container_storage::no_container_storage_diagnostic();,
    }
}

fn visit_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    children: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>,
    alias_starts: &std::map::Map<[]u8, i64>,
    alias_ends: &std::map::Map<[]u8, i64>,
    type_params: std::kizu::ast::ChildRange,
    owner: []u8
) -> !model::ContainerStorageSummary {
    var index = 0;
    while index < children.len {
        let child = try ast.child_at(children, index);
        let found = try visit_node(
            allocator, file, ast, root, child, kinds, copyable,
            alias_starts, alias_ends, type_params, owner
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return container_storage::no_container_storage_diagnostic();
}

fn visit_two(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>,
    alias_starts: &std::map::Map<[]u8, i64>,
    alias_ends: &std::map::Map<[]u8, i64>,
    type_params: std::kizu::ast::ChildRange,
    owner: []u8
) -> !model::ContainerStorageSummary {
    let found = try visit_node(
        allocator, file, ast, root, first, kinds, copyable,
        alias_starts, alias_ends, type_params, owner
    );
    if found.found {
        return found;
    }
    return visit_node(
        allocator, file, ast, root, second, kinds, copyable,
        alias_starts, alias_ends, type_params, owner
    );
}

fn visit_three(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>,
    alias_starts: &std::map::Map<[]u8, i64>,
    alias_ends: &std::map::Map<[]u8, i64>,
    type_params: std::kizu::ast::ChildRange,
    owner: []u8
) -> !model::ContainerStorageSummary {
    let found = try visit_two(
        allocator, file, ast, root, first, second, kinds, copyable,
        alias_starts, alias_ends, type_params, owner
    );
    if found.found {
        return found;
    }
    return visit_node(
        allocator, file, ast, root, third, kinds, copyable,
        alias_starts, alias_ends, type_params, owner
    );
}

// A signature is read left to right, then the body, which is the order a caller has to
// satisfy it in.
fn visit_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>,
    alias_starts: &std::map::Map<[]u8, i64>,
    alias_ends: &std::map::Map<[]u8, i64>
) -> !model::ContainerStorageSummary {
    let in_params = try visit_range(
        allocator, file, ast, root, params, kinds, copyable,
        alias_starts, alias_ends, type_params, ""
    );
    if in_params.found {
        return in_params;
    }
    let in_result = try container_storage::spelling_violation(
        allocator, file, ast, kinds, copyable, alias_starts, alias_ends, type_params,
        ast_text::ast_node_text(file, ast, return_type), return_type
    );
    if in_result.found {
        return in_result;
    }
    return visit_node(
        allocator, file, ast, root, body, kinds, copyable,
        alias_starts, alias_ends, type_params, ""
    );
}

// A cast and an arena allocation both write a type beside an expression, so the written
// spelling is asked the same questions a declared position's is.
fn visit_typed_expression(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>,
    alias_starts: &std::map::Map<[]u8, i64>,
    alias_ends: &std::map::Map<[]u8, i64>,
    type_params: std::kizu::ast::ChildRange,
    owner: []u8
) -> !model::ContainerStorageSummary {
    let written = try container_storage::spelling_violation(
        allocator, file, ast, kinds, copyable, alias_starts, alias_ends, type_params,
        ast_text::ast_node_text(file, ast, type_node), type_node
    );
    if written.found {
        return written;
    }
    return visit_node(
        allocator, file, ast, root, value, kinds, copyable,
        alias_starts, alias_ends, type_params, owner
    );
}

fn visit_literal(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    type_name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>,
    alias_starts: &std::map::Map<[]u8, i64>,
    alias_ends: &std::map::Map<[]u8, i64>,
    type_params: std::kizu::ast::ChildRange,
    owner: []u8
) -> !model::ContainerStorageSummary {
    let written = try container_storage::spelling_violation(
        allocator, file, ast, kinds, copyable, alias_starts, alias_ends, type_params,
        ast_text::ast_node_text(file, ast, type_name), type_name
    );
    if written.found {
        return written;
    }
    return visit_range(
        allocator, file, ast, root, fields, kinds, copyable,
        alias_starts, alias_ends, type_params, owner
    );
}

// An array fixes its element storage where the array is built, so the element rule is a
// rule about the constructor call and not about every position the array type is written
// in: a function may take `&std::array::Array<ptr<i64>>` and only the code that built it
// answers for the element.
fn visit_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    copyable: &std::map::Map<[]u8, bool>,
    alias_starts: &std::map::Map<[]u8, i64>,
    alias_ends: &std::map::Map<[]u8, i64>,
    type_params: std::kizu::ast::ChildRange,
    owner: []u8
) -> !model::ContainerStorageSummary {
    let element = try container_storage::array_constructor_violation(
        allocator, file, ast, root, callee, type_params
    );
    if element.found {
        return element;
    }
    let in_callee = try visit_node(
        allocator, file, ast, root, callee, kinds, copyable,
        alias_starts, alias_ends, type_params, owner
    );
    if in_callee.found {
        return in_callee;
    }
    return visit_range(
        allocator, file, ast, root, args, kinds, copyable,
        alias_starts, alias_ends, type_params, owner
    );
}
