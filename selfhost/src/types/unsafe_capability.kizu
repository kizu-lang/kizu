// The reserved @unsafe capabilities. Each names one class of operation the language
// permits only inside a scope that opted into it, and carries the help line a missing
// capability diagnostic prints. This is the frontend's copy of the compiler's reserved
// capability registry; a name @unsafe grants that is not listed here is rejected rather
// than silently ignored, which is what keeps the list from being extended by accident.
//
// @unsafe grants a capability for the extent of its block and never revokes one, so a
// scope is the set of capabilities granted by the enclosing @unsafe blocks.

pub fn capability_extern_call() -> i64 { return 0; }
pub fn capability_ptr_cast() -> i64 { return 1; }
pub fn capability_ptr_deref() -> i64 { return 2; }
pub fn capability_ptr_int_cast() -> i64 { return 3; }
pub fn capability_ptr_read() -> i64 { return 4; }
pub fn capability_ptr_write() -> i64 { return 5; }
pub fn capability_unsafe_call() -> i64 { return 6; }
pub fn capability_volatile() -> i64 { return 7; }

pub fn capability_count() -> i64 { return 8; }

pub fn capability_name(capability: i64) -> []u8 {
    if capability == capability_extern_call() { return "extern_call"; }
    if capability == capability_ptr_cast() { return "ptr_cast"; }
    if capability == capability_ptr_deref() { return "ptr_deref"; }
    if capability == capability_ptr_int_cast() { return "ptr_int_cast"; }
    if capability == capability_ptr_read() { return "ptr_read"; }
    if capability == capability_ptr_write() { return "ptr_write"; }
    if capability == capability_unsafe_call() { return "unsafe_call"; }
    if capability == capability_volatile() { return "volatile"; }
    return "";
}

pub fn capability_hint(capability: i64) -> []u8 {
    if capability == capability_extern_call() {
        return "`@unsafe(extern_call)` permits calls to declarations with an external ABI.";
    }
    if capability == capability_ptr_cast() {
        return "`@unsafe(ptr_cast)` permits raw pointer casts with `cast<ptr<...>>(value)`.";
    }
    if capability == capability_ptr_deref() {
        return "`@unsafe(ptr_deref)` permits raw pointer dereference such as `p.*` and `p.*.field`.";
    }
    if capability == capability_ptr_int_cast() {
        return "`@unsafe(ptr_int_cast)` permits `ptr_from_int<ptr<...>>(value)` and `int_from_ptr<usize>(value)`.";
    }
    if capability == capability_ptr_read() {
        return "`@unsafe(ptr_read)` permits raw pointer reads with `ptr_read(p)`.";
    }
    if capability == capability_ptr_write() {
        return "`@unsafe(ptr_write)` permits mutable raw pointer writes with `ptr_write(p, value)`.";
    }
    if capability == capability_unsafe_call() {
        return "`@unsafe(unsafe_call)` permits calls to functions or methods declared with `@requires_unsafe()`.";
    }
    if capability == capability_volatile() {
        return "`@unsafe(volatile)` permits volatile reads and writes with `volatile_read` / `volatile_write`.";
    }
    return "";
}

// from_source_name maps a capability name written in an @unsafe list to its identity,
// or -1 when the name is not reserved.
pub fn from_source_name(name: []u8) -> i64 {
    var capability = 0;
    while capability < capability_count() {
        if std::mem::equal_bytes(name, capability_name(capability)) {
            return capability;
        }
        capability = capability + 1;
    }
    return -1;
}

// A scope is the granted set encoded one capability per binary digit. The language has
// no bitwise operators, so membership is read with division and remainder.
pub fn empty_scope() -> i64 { return 0; }

fn capability_digit(capability: i64) -> i64 {
    var digit = 1;
    var index = 0;
    while index < capability {
        digit = digit * 2;
        index = index + 1;
    }
    return digit;
}

pub fn scope_has(scope: i64, capability: i64) -> bool {
    if capability < 0 or capability >= capability_count() {
        return false;
    }
    return (scope / capability_digit(capability)) % 2 == 1;
}

pub fn grant(scope: i64, capability: i64) -> i64 {
    if capability < 0 or capability >= capability_count() or scope_has(scope, capability) {
        return scope;
    }
    return scope + capability_digit(capability);
}
