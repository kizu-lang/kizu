pub fn from_missing_return(
    name: []u8,
    expected_return: []u8
) -> model::CheckDiagnosticSummary {
    return model::CheckDiagnosticSummary {
        found: true,
        kind: 10,
        detail_kind: 0,
        start: 0,
        end: 0,
        name: name,
        tag: "",
        expected_text: expected_return,
        actual_text: "",
        expected: 0,
        observed: 0
    };
}

pub fn return_type_summary(
    found: bool,
    start: i64,
    end: i64,
    expected: []u8,
    actual: []u8
) -> model::ReturnTypeSummary {
    return model::ReturnTypeSummary {
        found: found,
        start: start,
        end: end,
        expected: expected,
        actual: actual
    };
}

pub fn no_return_type_mismatch() -> model::ReturnTypeSummary {
    return return_type_summary(false, 0, 0, "", "");
}

