import selfhost::types::model;

pub fn none() -> model::CheckDiagnosticSummary {
    return model::CheckDiagnosticSummary {
        found: false,
        kind: 0,
        detail_kind: 0,
        start: 0,
        end: 0,
        name: "",
        tag: "",
        expected_text: "",
        actual_text: "",
        expected: 0,
        observed: 0
    };
}

pub fn from_type_reference(
    summary: model::TypeReferenceSummary
) -> model::CheckDiagnosticSummary {
    return model::CheckDiagnosticSummary {
        found: summary.found,
        kind: 1,
        detail_kind: summary.kind,
        start: summary.start,
        end: summary.end,
        name: "",
        tag: "",
        expected_text: "",
        actual_text: "",
        expected: summary.expected,
        observed: summary.observed
    };
}

