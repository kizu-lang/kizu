import selfhost::types::model;

// no_integer_literal_range is the verdict of a position that holds no rejected contextual
// integer literal, which is every position that reports an ordinary type mismatch.
fn no_integer_literal_range() -> model::IntegerLiteralRange {
    return model::IntegerLiteralRange {
        found: false,
        digits: "",
        negations: 0,
        expected: ""
    };
}

fn integer_literal_range(
    digits: []u8,
    negations: i64,
    expected: []u8
) -> model::IntegerLiteralRange {
    return model::IntegerLiteralRange {
        found: true,
        digits: digits,
        negations: negations,
        expected: expected
    };
}

pub fn return_type_summary(
    found: bool,
    start: i64,
    end: i64,
    expected: []u8,
    actual: []u8
) -> model::ReturnTypeSummary {
    return return_summary_with_literal(
        found, start, end, expected, actual, no_integer_literal_range()
    );
}

// integer_literal_range_return_summary reports a return value the declared return type
// cannot hold as a literal, which the oracle rejects instead of narrowing.
pub fn integer_literal_range_return_summary(
    start: i64,
    end: i64,
    digits: []u8,
    negations: i64,
    expected: []u8
) -> model::ReturnTypeSummary {
    return return_summary_with_literal(
        true, start, end, "", "",
        integer_literal_range(digits, negations, expected)
    );
}

fn return_summary_with_literal(
    found: bool,
    start: i64,
    end: i64,
    expected: []u8,
    actual: []u8,
    literal: model::IntegerLiteralRange
) -> model::ReturnTypeSummary {
    return model::ReturnTypeSummary {
        found: found,
        start: start,
        end: end,
        expected: expected,
        actual: actual,
        literal: literal
    };
}

pub fn no_return_type_mismatch() -> model::ReturnTypeSummary {
    return return_type_summary(false, 0, 0, "", "");
}

pub fn argument_type_summary(
    found: bool,
    start: i64,
    end: i64,
    expected: []u8,
    actual: []u8
) -> model::ArgumentTypeSummary {
    return argument_summary_of_kind(found, 0, start, end, expected, actual);
}

// unsatisfied_contract_argument_summary reports an argument passed to a `dyn Contract`
// parameter without an `impl Contract for Type` to back it.
pub fn unsatisfied_contract_argument_summary(
    start: i64,
    end: i64,
    contract_name: []u8,
    actual: []u8
) -> model::ArgumentTypeSummary {
    return argument_summary_of_kind(true, 1, start, end, contract_name, actual);
}

// integer_literal_range_argument_summary reports an argument the parameter's integer type
// cannot hold as a literal, which the oracle rejects instead of narrowing.
pub fn integer_literal_range_argument_summary(
    start: i64,
    end: i64,
    digits: []u8,
    negations: i64,
    expected: []u8
) -> model::ArgumentTypeSummary {
    return model::ArgumentTypeSummary {
        found: true,
        kind: 0,
        start: start,
        end: end,
        expected: "",
        actual: "",
        literal: integer_literal_range(digits, negations, expected)
    };
}

fn argument_summary_of_kind(
    found: bool,
    kind: i64,
    start: i64,
    end: i64,
    expected: []u8,
    actual: []u8
) -> model::ArgumentTypeSummary {
    return model::ArgumentTypeSummary {
        found: found,
        kind: kind,
        start: start,
        end: end,
        expected: expected,
        actual: actual,
        literal: no_integer_literal_range()
    };
}

pub fn no_argument_type_mismatch() -> model::ArgumentTypeSummary {
    return argument_type_summary(false, 0, 0, "", "");
}

// unknown_struct_literal_summary reports a literal whose type names no struct at all.
pub fn unknown_struct_literal_summary(
    kind: i64,
    type_name: []u8
) -> model::StructLiteralSummary {
    return struct_literal_summary_of_kind(kind, type_name, "", "", "");
}

// struct_literal_field_summary reports one member the literal and the declaration disagree
// about. `expected` and `actual` are empty for the two rules that are about the field set
// rather than about a value's type.
pub fn struct_literal_field_summary(
    kind: i64,
    type_name: []u8,
    field: []u8,
    expected: []u8,
    actual: []u8
) -> model::StructLiteralSummary {
    return struct_literal_summary_of_kind(kind, type_name, field, expected, actual);
}

// integer_literal_range_struct_field_summary reports a field value the field's integer type
// cannot hold as a literal, which the oracle rejects instead of narrowing.
pub fn integer_literal_range_struct_field_summary(
    kind: i64,
    type_name: []u8,
    field: []u8,
    digits: []u8,
    negations: i64,
    expected: []u8
) -> model::StructLiteralSummary {
    return model::StructLiteralSummary {
        found: true,
        kind: kind,
        type_name: type_name,
        field: field,
        expected: "",
        actual: "",
        literal: integer_literal_range(digits, negations, expected)
    };
}

fn struct_literal_summary_of_kind(
    kind: i64,
    type_name: []u8,
    field: []u8,
    expected: []u8,
    actual: []u8
) -> model::StructLiteralSummary {
    return model::StructLiteralSummary {
        found: true,
        kind: kind,
        type_name: type_name,
        field: field,
        expected: expected,
        actual: actual,
        literal: no_integer_literal_range()
    };
}

pub fn no_struct_literal_diagnostic() -> model::StructLiteralSummary {
    return model::StructLiteralSummary {
        found: false,
        kind: 0,
        type_name: "",
        field: "",
        expected: "",
        actual: "",
        literal: no_integer_literal_range()
    };
}

pub fn assignment_type_summary(
    found: bool,
    start: i64,
    end: i64,
    expected: []u8,
    actual: []u8
) -> model::AssignmentTypeSummary {
    return assignment_summary_with_literal(
        found, start, end, expected, actual, no_integer_literal_range()
    );
}

// integer_literal_range_assignment_summary reports an assigned value the binding's integer
// type cannot hold as a literal, which the oracle rejects instead of narrowing.
pub fn integer_literal_range_assignment_summary(
    start: i64,
    end: i64,
    digits: []u8,
    negations: i64,
    expected: []u8
) -> model::AssignmentTypeSummary {
    return assignment_summary_with_literal(
        true, start, end, "", "",
        integer_literal_range(digits, negations, expected)
    );
}

fn assignment_summary_with_literal(
    found: bool,
    start: i64,
    end: i64,
    expected: []u8,
    actual: []u8,
    literal: model::IntegerLiteralRange
) -> model::AssignmentTypeSummary {
    return model::AssignmentTypeSummary {
        found: found,
        start: start,
        end: end,
        expected: expected,
        actual: actual,
        literal: literal
    };
}

pub fn no_assignment_type_mismatch() -> model::AssignmentTypeSummary {
    return assignment_type_summary(false, 0, 0, "", "");
}

pub fn immutable_assignment_summary(
    found: bool,
    start: i64,
    end: i64,
    name: []u8
) -> model::ImmutableAssignmentSummary {
    return model::ImmutableAssignmentSummary {
        found: found,
        start: start,
        end: end,
        name: name
    };
}

pub fn no_immutable_assignment() -> model::ImmutableAssignmentSummary {
    return immutable_assignment_summary(false, 0, 0, "");
}

pub fn invalid_assignment_target_result(
    found: bool,
    start: i64,
    end: i64
) -> model::InvalidAssignmentTargetSummary {
    return model::InvalidAssignmentTargetSummary {
        found: found,
        start: start,
        end: end
    };
}

pub fn no_invalid_assignment_target() -> model::InvalidAssignmentTargetSummary {
    return invalid_assignment_target_result(false, 0, 0);
}

pub fn undefined_variable_summary(
    found: bool,
    start: i64,
    end: i64,
    name: []u8
) -> model::UndefinedVariableSummary {
    return model::UndefinedVariableSummary {
        found: found,
        start: start,
        end: end,
        name: name
    };
}

pub fn no_undefined_variable() -> model::UndefinedVariableSummary {
    return undefined_variable_summary(false, 0, 0, "");
}

pub fn match_diagnostic_summary(
    found: bool,
    kind: i64,
    name: []u8,
    tag: []u8
) -> model::MatchDiagnosticSummary {
    return model::MatchDiagnosticSummary {
        found: found,
        kind: kind,
        name: name,
        tag: tag
    };
}

pub fn no_match_diagnostic() -> model::MatchDiagnosticSummary {
    return match_diagnostic_summary(false, 0, "", "");
}

pub fn missing_return_summary(
    found: bool,
    name: []u8,
    expected_return: []u8
) -> model::MissingReturnSummary {
    return model::MissingReturnSummary {
        found: found,
        name: name,
        expected_return: expected_return
    };
}

pub fn no_missing_return() -> model::MissingReturnSummary {
    return missing_return_summary(false, "", "");
}
