import selfhost::ir::intrinsic_type_contract;
import selfhost::source;
import selfhost::types::ast_text;
import selfhost::types::expression_facts;
import selfhost::types::expression_infer;
import selfhost::types::local_facts;
import selfhost::types::model;
import selfhost::types::pointer_builtin;
import selfhost::types::pointer_containment;
import selfhost::types::raw_pointer;
import selfhost::types::unsafe_capability;

// The raw pointer and @unsafe capability pass.
//
// Two rule families share this walk because they share their premise: both are decided
// by what a value's type spelling is, never by how an identifier is spelled.
//
//  - A capability rule rejects an operation performed outside an @unsafe scope that
//    granted the capability it needs. The scope grows at an @unsafe block and never
//    shrinks within it, so it is carried down the walk as a granted set.
//  - A raw pointer rule rejects an operation a raw pointer does not support at all:
//    dereferencing a nullable one, writing through a `const` one, reading a field off
//    the pointer instead of the pointee, casting a non-pointer to a pointer, or storing
//    one where its lifetime cannot be tracked.
//
// Both consult selfhost::types::raw_pointer for pointer-ness, which resolves the
// pointer constructor through the intrinsic type registry.
//
// The extern and @requires_unsafe obligations are read from the declarations in the
// file being checked; a call whose declaration lives in another module is not yet
// resolved here, so its obligation is not yet enforced.

pub fn kind_missing_capability() -> i64 { return 1; }
pub fn kind_unknown_capability() -> i64 { return 2; }
pub fn kind_operand_not_readable_pointer() -> i64 { return 3; }
pub fn kind_operand_not_writable_pointer() -> i64 { return 4; }
pub fn kind_nullable_deref() -> i64 { return 5; }
pub fn kind_const_assign() -> i64 { return 6; }
pub fn kind_pointer_has_no_fields() -> i64 { return 7; }
pub fn kind_invalid_pointer_cast() -> i64 { return 8; }
pub fn kind_boundary_pointer() -> i64 { return 10; }

// How a missing-capability report names the operation it rejected.
pub fn operation_named() -> i64 { return 1; }
pub fn operation_call() -> i64 { return 2; }
pub fn operation_deref() -> i64 { return 3; }
pub fn operation_cast() -> i64 { return 4; }

pub fn no_unsafe_diagnostic() -> model::UnsafeSummary {
    return model::UnsafeSummary {
        found: false,
        kind: 0,
        operation_kind: 0,
        start: 0,
        end: 0,
        capability: -1,
        operation: "",
        spelling: ""
    };
}

fn unsafe_diagnostic(
    kind: i64,
    operation_kind: i64,
    start: i64,
    end: i64,
    capability: i64,
    operation: []u8,
    spelling: []u8
) -> model::UnsafeSummary {
    return model::UnsafeSummary {
        found: true,
        kind: kind,
        operation_kind: operation_kind,
        start: start,
        end: end,
        capability: capability,
        operation: operation,
        spelling: spelling
    };
}

pub fn first_unsafe_diagnostic_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    var extern_declarations = std::map::Map<[]u8, bool>(allocator);
    var unsafe_declarations = std::map::Map<[]u8, bool>(allocator);
    defer extern_declarations.deinit();
    defer unsafe_declarations.deinit();
    try collect_call_obligations(file, ast, root, extern_declarations, unsafe_declarations);
    return try first_unsafe_diagnostic_in_declaration(
        allocator, file, ast, root, root, extern_declarations, unsafe_declarations,
        expression_types
    );
}

fn collect_call_obligations(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    extern_declarations: &var std::map::Map<[]u8, bool>,
    unsafe_declarations: &var std::map::Map<[]u8, bool>
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return collect_call_obligations_in_range(
            file, ast, program.declarations, extern_declarations, unsafe_declarations
        );,
        ImplDecl(impl_decl) => return collect_call_obligations_in_range(
            file, ast, impl_decl.methods, extern_declarations, unsafe_declarations
        );,
        FnDecl(fn_decl) => return collect_declaration_obligation(
            file, ast, fn_decl.extern_abi, fn_decl.requires_unsafe, fn_decl.name,
            extern_declarations, unsafe_declarations
        );,
        _ => return;,
    }
}

fn collect_call_obligations_in_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    extern_declarations: &var std::map::Map<[]u8, bool>,
    unsafe_declarations: &var std::map::Map<[]u8, bool>
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_call_obligations(
            file, ast, child, extern_declarations, unsafe_declarations
        );
        index = index + 1;
    }
    return;
}

fn collect_declaration_obligation(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    extern_abi: std::kizu::ast::NodeId,
    requires_unsafe: bool,
    name: std::kizu::ast::NodeId,
    extern_declarations: &var std::map::Map<[]u8, bool>,
    unsafe_declarations: &var std::map::Map<[]u8, bool>
) -> !void {
    let declared = ast_text::ast_node_text(file, ast, name);
    if ast_text::declares_extern_abi(ast, extern_abi) and !extern_declarations.contains(declared) {
        try extern_declarations.insert(declared, true);
    }
    if requires_unsafe and !unsafe_declarations.contains(declared) {
        try unsafe_declarations.insert(declared, true);
    }
    return;
}

fn first_unsafe_diagnostic_in_declaration(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    root: std::kizu::ast::NodeId,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_unsafe_diagnostic_in_declarations(
            allocator, file, ast, program.declarations, root,
            extern_declarations, unsafe_declarations, expression_types
        );,
        ImplDecl(impl_decl) => return first_unsafe_diagnostic_in_declarations(
            allocator, file, ast, impl_decl.methods, root,
            extern_declarations, unsafe_declarations, expression_types
        );,
        FnDecl(fn_decl) => return first_unsafe_diagnostic_in_function(
            allocator, file, ast, fn_decl.type_params, fn_decl.params, fn_decl.body, root,
            extern_declarations, unsafe_declarations, expression_types
        );,
        _ => return no_unsafe_diagnostic();,
    }
}

fn first_unsafe_diagnostic_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    root: std::kizu::ast::NodeId,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_unsafe_diagnostic_in_declaration(
            allocator, file, ast, child, root,
            extern_declarations, unsafe_declarations, expression_types
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_unsafe_diagnostic();
}

fn first_unsafe_diagnostic_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    root: std::kizu::ast::NodeId,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    let locals = try local_facts::collect_function_statement_locals(
        allocator, file, ast, type_params, params, body, local_types, local_mutability,
        expression_types
    );
    // A function body starts with no capability: @unsafe is the only way to gain one.
    let found = try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, body, unsafe_capability::empty_scope(), root,
        local_types, extern_declarations, unsafe_declarations, expression_types
    );
    local_types.deinit();
    local_mutability.deinit();
    return found;
}

fn first_unsafe_diagnostic_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return first_unsafe_diagnostic_in_range(
            allocator, file, ast, block.statements, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        Unsafe(unsafe_node) => return first_unsafe_diagnostic_in_unsafe_block(
            allocator, file, ast, unsafe_node.capabilities, unsafe_node.body, scope, root,
            local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        If(if_node) => return first_unsafe_diagnostic_in_three(
            allocator, file, ast, if_node.condition, if_node.then_block,
            if_node.else_block, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        ComptimeIf(comptime_if_node) => return first_unsafe_diagnostic_in_three(
            allocator, file, ast, comptime_if_node.condition,
            comptime_if_node.then_block, comptime_if_node.else_block, scope, root,
            local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        While(while_node) => return first_unsafe_diagnostic_in_two(
            allocator, file, ast, while_node.condition, while_node.body, scope, root,
            local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        For(for_node) => return first_unsafe_diagnostic_in_three(
            allocator, file, ast, for_node.start, for_node.end, for_node.body, scope,
            root, local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        Match(match_node) => return first_unsafe_diagnostic_in_value_and_range(
            allocator, file, ast, match_node.value, match_node.arms, scope, root,
            local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        MatchArm(match_arm) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, match_arm.body, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        Let(let_node) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, let_node.value, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        Assign(assign_node) => return first_unsafe_diagnostic_in_assignment(
            allocator, file, ast, assign_node.target, assign_node.value, scope, root,
            local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        Return(return_node) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, return_node.value, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        Defer(defer_node) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, defer_node.expr, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        ErrDefer(err_defer_node) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, err_defer_node.expr, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        ExprStmt(expr_stmt) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, expr_stmt.expr, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        Call(call_node) => return first_unsafe_diagnostic_in_call(
            allocator, file, ast, node_id, call_node.callee, call_node.args, scope, root,
            local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        TypeApplyExpr(type_apply) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, type_apply.callee, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        CastExpr(cast_expr) => return first_unsafe_diagnostic_in_cast(
            allocator, file, ast, node_id, cast_expr.type_node, cast_expr.value, scope,
            root, local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        DerefExpr(deref_expr_node) => return first_unsafe_diagnostic_in_deref(
            allocator, file, ast, node_id, deref_expr_node.receiver, false, scope, root,
            local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        FieldExpr(field_expr_node) => return first_unsafe_diagnostic_in_field(
            allocator, file, ast, field_expr_node.receiver, field_expr_node.namespace,
            scope, root, local_types, extern_declarations, unsafe_declarations,
            expression_types
        );,
        IndexExpr(index_expr) => return first_unsafe_diagnostic_in_three(
            allocator, file, ast, index_expr.target, index_expr.start, index_expr.end,
            scope, root, local_types, extern_declarations, unsafe_declarations,
            expression_types
        );,
        StructLiteralExpr(struct_literal) => return first_unsafe_diagnostic_in_range(
            allocator, file, ast, struct_literal.fields, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        StructFieldInit(struct_field_init) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, struct_field_init.value, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        ArenaNewExpr(arena_new) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, arena_new.allocator, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        TryExpr(try_expr_node) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, try_expr_node.value, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        ComptimeExpr(comptime_expr_node) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, comptime_expr_node.value, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        Binary(binary) => return first_unsafe_diagnostic_in_two(
            allocator, file, ast, binary.left, binary.right, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        Prefix(prefix_node) => return first_unsafe_diagnostic_in_statement(
            allocator, file, ast, prefix_node.right, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        _ => return no_unsafe_diagnostic();,
    }
}

fn first_unsafe_diagnostic_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        let found = try first_unsafe_diagnostic_in_statement(
            allocator, file, ast, child, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_unsafe_diagnostic();
}

fn first_unsafe_diagnostic_in_two(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let found = try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, first, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
    if found.found {
        return found;
    }
    return try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, second, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

fn first_unsafe_diagnostic_in_three(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let found = try first_unsafe_diagnostic_in_two(
        allocator, file, ast, first, second, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
    if found.found {
        return found;
    }
    return try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, third, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

fn first_unsafe_diagnostic_in_value_and_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    statements: std::kizu::ast::ChildRange,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let found = try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, value, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
    if found.found {
        return found;
    }
    return try first_unsafe_diagnostic_in_range(
        allocator, file, ast, statements, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

// An @unsafe block grants its capabilities for the extent of its body and revokes
// none, so the body is walked with the enclosing scope plus what this block names.
fn first_unsafe_diagnostic_in_unsafe_block(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    capabilities: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    var granted = scope;
    var index = 0;
    while index < capabilities.len {
        let child = try ast.child_at(capabilities, index);
        let name = ast_text::ast_node_text(file, ast, child);
        let capability = unsafe_capability::from_source_name(name);
        if capability < 0 {
            let node = ast.get(child);
            return unsafe_diagnostic(
                kind_unknown_capability(), operation_named(),
                node.span.start, node.span.end, -1, name, ""
            );
        }
        granted = unsafe_capability::grant(granted, capability);
        index = index + 1;
    }
    return try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, body, granted, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

fn first_unsafe_diagnostic_in_assignment(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let found = try first_unsafe_diagnostic_in_assignment_target(
        allocator, file, ast, target, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
    if found.found {
        return found;
    }
    return try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, value, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

// An assignment target reached through a dereference stores into the pointee, so the
// dereference on the way to it is a write and is judged by the write rules.
fn first_unsafe_diagnostic_in_assignment_target(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let node = ast.get(node_id);
    match node.data {
        DerefExpr(deref_expr_node) => return first_unsafe_diagnostic_in_deref(
            allocator, file, ast, node_id, deref_expr_node.receiver, true, scope, root,
            local_types, extern_declarations, unsafe_declarations, expression_types
        );,
        FieldExpr(field_expr_node) => return first_unsafe_diagnostic_in_assignment_field(
            allocator, file, ast, field_expr_node.receiver, field_expr_node.namespace,
            scope, root, local_types, extern_declarations, unsafe_declarations,
            expression_types
        );,
        IndexExpr(index_expr) => return first_unsafe_diagnostic_in_assignment_target(
            allocator, file, ast, index_expr.target, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
        _ => return try first_unsafe_diagnostic_in_statement(
            allocator, file, ast, node_id, scope, root, local_types,
            extern_declarations, unsafe_declarations, expression_types
        );,
    }
}

fn first_unsafe_diagnostic_in_assignment_field(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    namespace: bool,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    if namespace {
        return no_unsafe_diagnostic();
    }
    let receiver_type = try expression_infer::infer_expression_type(
        allocator, file, ast, receiver, local_types, expression_types
    );
    if raw_pointer::is_raw_pointer(receiver_type) {
        let node = ast.get(receiver);
        return unsafe_diagnostic(
            kind_pointer_has_no_fields(), operation_named(),
            node.span.start, node.span.end, -1, "", receiver_type
        );
    }
    return try first_unsafe_diagnostic_in_assignment_target(
        allocator, file, ast, receiver, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

fn first_unsafe_diagnostic_in_deref(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    receiver: std::kizu::ast::NodeId,
    write: bool,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let receiver_type = try expression_infer::infer_expression_type(
        allocator, file, ast, receiver, local_types, expression_types
    );
    // `.*` also reads through a borrow, which needs no capability. Only a raw pointer
    // dereference is unsafe, so the rule is keyed on the receiver's type.
    if raw_pointer::is_raw_pointer(receiver_type) {
        let node = ast.get(node_id);
        let missing = missing_capability(
            scope, unsafe_capability::capability_ptr_deref(), operation_deref(),
            node.span.start, node.span.end, ""
        );
        if missing.found {
            return missing;
        }
        if raw_pointer::is_nullable(receiver_type) {
            return unsafe_diagnostic(
                kind_nullable_deref(), operation_named(),
                node.span.start, node.span.end, -1, "", receiver_type
            );
        }
        if write and raw_pointer::pointee_is_const(raw_pointer::pointee(receiver_type)) {
            return unsafe_diagnostic(
                kind_const_assign(), operation_named(),
                node.span.start, node.span.end, -1, "", receiver_type
            );
        }
    }
    return try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, receiver, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

fn first_unsafe_diagnostic_in_field(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    namespace: bool,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    if namespace {
        return no_unsafe_diagnostic();
    }
    // A raw pointer is an address, not the value it points at: fields belong to the
    // pointee and are reached through `p.*`.
    let receiver_type = try expression_infer::infer_expression_type(
        allocator, file, ast, receiver, local_types, expression_types
    );
    if raw_pointer::is_raw_pointer(receiver_type) {
        let node = ast.get(receiver);
        return unsafe_diagnostic(
            kind_pointer_has_no_fields(), operation_named(),
            node.span.start, node.span.end, -1, "", receiver_type
        );
    }
    return try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, receiver, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

fn first_unsafe_diagnostic_in_cast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let target = ast_text::ast_node_text(file, ast, type_node);
    if raw_pointer::is_raw_pointer(target) {
        let source_type = try expression_infer::infer_expression_type(
            allocator, file, ast, value, local_types, expression_types
        );
        let node = ast.get(node_id);
        // Only an address may become an address. Anything else would invent one.
        if !std::mem::equal_bytes(source_type, "unknown") and
            !raw_pointer::is_raw_pointer(source_type) {
            return unsafe_diagnostic(
                kind_invalid_pointer_cast(), operation_named(),
                node.span.start, node.span.end, -1, target, source_type
            );
        }
        let missing = missing_capability(
            scope, unsafe_capability::capability_ptr_cast(), operation_cast(),
            node.span.start, node.span.end, ""
        );
        if missing.found {
            return missing;
        }
    }
    return try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, value, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

fn first_unsafe_diagnostic_in_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    scope: i64,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let name = callee_name_text(file, ast, callee);
    let callee_node = ast.get(callee);
    let builtin = pointer_builtin::lookup(name);
    if builtin.params >= 0 {
        let found = try check_pointer_builtin_call(
            allocator, file, ast, builtin, args, scope,
            callee_node.span.start, callee_node.span.end, local_types, expression_types
        );
        if found.found {
            return found;
        }
    } else {
        let found = check_declared_call_obligation(
            name, callee_node.span.start, callee_node.span.end, scope,
            extern_declarations, unsafe_declarations
        );
        if found.found {
            return found;
        }
        let constructed = try check_intrinsic_construction(
            allocator, file, ast, name, callee, args, root, local_types, expression_types
        );
        if constructed.found {
            return constructed;
        }
    }
    let walked = try first_unsafe_diagnostic_in_statement(
        allocator, file, ast, callee, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
    if walked.found {
        return walked;
    }
    return try first_unsafe_diagnostic_in_range(
        allocator, file, ast, args, scope, root, local_types,
        extern_declarations, unsafe_declarations, expression_types
    );
}

fn check_pointer_builtin_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    builtin: pointer_builtin::PointerBuiltin,
    args: std::kizu::ast::ChildRange,
    scope: i64,
    start: i64,
    end: i64,
    local_types: &std::map::Map<[]u8, []u8>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let missing = missing_capability(
        scope, builtin.capability, operation_named(), start, end, builtin.name
    );
    if missing.found {
        return missing;
    }
    if builtin.operand == pointer_builtin::operand_none() or args.len < 1 {
        return no_unsafe_diagnostic();
    }
    let operand = try ast.child_at(args, 0);
    let operand_type = try expression_infer::infer_expression_type(
        allocator, file, ast, operand, local_types, expression_types
    );
    if std::mem::equal_bytes(operand_type, "unknown") {
        return no_unsafe_diagnostic();
    }
    let is_pointer = raw_pointer::is_raw_pointer(operand_type);
    let nullable = raw_pointer::is_nullable(operand_type);
    if builtin.operand == pointer_builtin::operand_any_pointer() {
        if !is_pointer {
            return unsafe_diagnostic(
                kind_operand_not_readable_pointer(), operation_named(),
                start, end, -1, builtin.name, operand_type
            );
        }
        return no_unsafe_diagnostic();
    }
    if builtin.operand == pointer_builtin::operand_readable_pointer() {
        if !is_pointer or nullable {
            return unsafe_diagnostic(
                kind_operand_not_readable_pointer(), operation_named(),
                start, end, -1, builtin.name, operand_type
            );
        }
        return no_unsafe_diagnostic();
    }
    if !is_pointer or nullable or
        raw_pointer::pointee_is_const(raw_pointer::pointee(operand_type)) {
        return unsafe_diagnostic(
            kind_operand_not_writable_pointer(), operation_named(),
            start, end, -1, builtin.name, operand_type
        );
    }
    return no_unsafe_diagnostic();
}

fn check_declared_call_obligation(
    name: []u8,
    start: i64,
    end: i64,
    scope: i64,
    extern_declarations: &std::map::Map<[]u8, bool>,
    unsafe_declarations: &std::map::Map<[]u8, bool>
) -> model::UnsafeSummary {
    if extern_declarations.contains(name) {
        let missing = missing_capability(
            scope, unsafe_capability::capability_extern_call(), operation_call(),
            start, end, name
        );
        if missing.found {
            return missing;
        }
    }
    if unsafe_declarations.contains(name) {
        let missing = missing_capability(
            scope, unsafe_capability::capability_unsafe_call(), operation_call(),
            start, end, name
        );
        if missing.found {
            return missing;
        }
    }
    return no_unsafe_diagnostic();
}

fn missing_capability(
    scope: i64,
    capability: i64,
    operation_kind: i64,
    start: i64,
    end: i64,
    operation: []u8
) -> model::UnsafeSummary {
    if unsafe_capability::scope_has(scope, capability) {
        return no_unsafe_diagnostic();
    }
    return unsafe_diagnostic(
        kind_missing_capability(), operation_kind, start, end, capability, operation, ""
    );
}

// A builtin constructor applied to type arguments is where a raw pointer would enter
// storage the compiler cannot reason about. Which constructors those are is read from
// the intrinsic registry, so the rule holds for every identity it owns rather than for
// a list of spellings kept here. What a container may store is a question about the
// element type rather than about the pointer, so selfhost::types::container_storage owns
// it and answers for every classification an element can have.
fn check_intrinsic_construction(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: []u8,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    let kind = intrinsic_type_contract::from_source_name(name);
    if kind < 0 {
        return no_unsafe_diagnostic();
    }
    if is_concurrency_boundary_kind(kind) {
        return try check_boundary_arguments(
            allocator, file, ast, args, root, local_types, expression_types
        );
    }
    return no_unsafe_diagnostic();
}

// A concurrency intrinsic hands a value to code the current scope cannot observe.
fn is_concurrency_boundary_kind(kind: i64) -> bool {
    return kind == intrinsic_type_contract::kind_channel() or
        kind == intrinsic_type_contract::kind_atomic() or
        kind == intrinsic_type_contract::kind_mutex() or
        kind == intrinsic_type_contract::kind_task() or
        kind == intrinsic_type_contract::kind_task_group() or
        kind == intrinsic_type_contract::kind_queue();
}

fn check_boundary_arguments(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    args: std::kizu::ast::ChildRange,
    root: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::UnsafeSummary {
    var visited = std::map::Map<[]u8, bool>(allocator);
    defer visited.deinit();
    var index = 0;
    while index < args.len {
        let child = try ast.child_at(args, index);
        let spelling = try expression_infer::infer_expression_type(
            allocator, file, ast, child, local_types, expression_types
        );
        if try pointer_containment::holds_raw_pointer(file, ast, root, spelling, visited) {
            let node = ast.get(child);
            return unsafe_diagnostic(
                kind_boundary_pointer(), operation_named(),
                node.span.start, node.span.end, -1, "", spelling
            );
        }
        index = index + 1;
    }
    return no_unsafe_diagnostic();
}

fn callee_name_text(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(callee);
    match node.data {
        TypeApplyExpr(type_apply) => return callee_name_text(file, ast, type_apply.callee);,
        _ => return ast_text::ast_node_text(file, ast, callee);,
    }
}
