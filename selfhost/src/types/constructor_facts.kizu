pub struct ConstructorFacts {
    pub node_starts: std::array::Array<i64>,
    pub node_ends: std::array::Array<i64>,
    pub constructor_ids: std::array::Array<i64>,
    pub type_arg0_ids: std::array::Array<i64>,
}

pub fn init(allocator: Allocator) -> ConstructorFacts {
    return ConstructorFacts {
        node_starts: std::array::Array<i64>(allocator),
        node_ends: std::array::Array<i64>(allocator),
        constructor_ids: std::array::Array<i64>(allocator),
        type_arg0_ids: std::array::Array<i64>(allocator)
    };
}

impl ConstructorFacts {
    fn deinit(self: ConstructorFacts) -> void {
        self.node_starts.deinit();
        self.node_ends.deinit();
        self.constructor_ids.deinit();
        self.type_arg0_ids.deinit();
    }
}

// This producer runs only after the full checker succeeds. Known constructor and type
// identities are selected by exact source spelling or an exact root-import expansion.
pub fn collect_checked(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    facts: &var ConstructorFacts
) -> !void {
    try collect_node(text, ast, root, root, facts);
    return;
}

pub fn append_identity(
    facts: &var ConstructorFacts,
    start: i64,
    end: i64,
    constructor_id: i64,
    type_arg0_id: i64
) -> !void {
    try facts.node_starts.append(start);
    try facts.node_ends.append(end);
    try facts.constructor_ids.append(constructor_id);
    try facts.type_arg0_ids.append(type_arg0_id);
    return;
}

fn collect_node(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node_id: std::kizu::ast::NodeId,
    facts: &var ConstructorFacts
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(value) => return collect_range(text, ast, root, value.declarations, facts);,
        ImportDecl(value) => return;,
        StructDecl(value) => return collect_ranges(text, ast, root, value.type_params, value.fields, facts);,
        EnumDecl(value) => return collect_range(text, ast, root, value.tags, facts);,
        UnionDecl(value) => return collect_ranges(text, ast, root, value.type_params, value.variants, facts);,
        ImplDecl(value) => return collect_one_range(text, ast, root, value.type_name, value.methods, facts);,
        UnionVariant(value) => return collect_node(text, ast, root, value.payload, facts);,
        FnDecl(value) => return collect_fn(text, ast, root, value.type_params, value.params, value.body, facts);,
        Param(value) => return collect_node(text, ast, root, value.type_node, facts);,
        Field(value) => return collect_node(text, ast, root, value.type_node, facts);,
        Block(value) => return collect_range(text, ast, root, value.statements, facts);,
        Let(value) => return collect_node(text, ast, root, value.value, facts);,
        Assign(value) => return collect_two(text, ast, root, value.target, value.value, facts);,
        Return(value) => return collect_node(text, ast, root, value.value, facts);,
        Defer(value) => return collect_node(text, ast, root, value.expr, facts);,
        ErrDefer(value) => return collect_node(text, ast, root, value.expr, facts);,
        ExprStmt(value) => return collect_node(text, ast, root, value.expr, facts);,
        If(value) => return collect_three(text, ast, root, value.condition, value.then_block, value.else_block, facts);,
        While(value) => return collect_two(text, ast, root, value.condition, value.body, facts);,
        For(value) => return collect_three(text, ast, root, value.start, value.end, value.body, facts);,
        Break(value) => return;,
        Continue(value) => return;,
        Match(value) => return collect_one_range(text, ast, root, value.value, value.arms, facts);,
        MatchArm(value) => return collect_three(text, ast, root, value.pattern, value.binding, value.body, facts);,
        Unsafe(value) => return collect_node(text, ast, root, value.body, facts);,
        ComptimeIf(value) => return collect_three(text, ast, root, value.condition, value.then_block, value.else_block, facts);,
        Prefix(value) => return collect_node(text, ast, root, value.right, facts);,
        Binary(value) => return collect_two(text, ast, root, value.left, value.right, facts);,
        FieldExpr(value) => return collect_node(text, ast, root, value.receiver, facts);,
        DerefExpr(value) => return collect_node(text, ast, root, value.receiver, facts);,
        Call(value) => return collect_call(text, ast, root, value.callee, value.args, facts);,
        TypeApplyExpr(value) => return collect_one_range(text, ast, root, value.callee, value.type_args, facts);,
        CastExpr(value) => return collect_two(text, ast, root, value.type_node, value.value, facts);,
        IndexExpr(value) => return collect_three(text, ast, root, value.target, value.start, value.end, facts);,
        StructLiteralExpr(value) => return collect_one_range(text, ast, root, value.type_name, value.fields, facts);,
        StructFieldInit(value) => return collect_node(text, ast, root, value.value, facts);,
        ArenaNewExpr(value) => return collect_two(text, ast, root, value.type_node, value.allocator, facts);,
        TryExpr(value) => return collect_node(text, ast, root, value.value, facts);,
        ComptimeExpr(value) => return collect_node(text, ast, root, value.value, facts);,
        TypeName(value) => return;,
        Var(value) => return;,
        Int(value) => return;,
        String(value) => return;,
        Bool(value) => return;,
        Empty => return;,
    }
}

fn collect_call(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    facts: &var ConstructorFacts
) -> !void {
    let node = ast.get(callee);
    match node.data {
        TypeApplyExpr(value) => try append_resolved(
            text, ast, root, callee, value.callee, value.type_args, facts
        );,
        _ => return collect_call_children(text, ast, root, callee, args, facts);,
    }
    try collect_node(text, ast, root, callee, facts);
    try collect_range(text, ast, root, args, facts);
    return;
}

fn append_resolved(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node_id: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    facts: &var ConstructorFacts
) -> !void {
    if args.len != 1 { return; }
    let constructor_id = try resolved_constructor_identity_id(text, ast, root, callee);
    if constructor_id == no_identity() { return; }
    let arg = try ast.child_at(args, 0);
    let type_arg0_id = try resolved_type_identity_id(text, ast, root, arg);
    if type_arg0_id == no_identity() { return; }
    let node = ast.get(node_id);
    try append_identity(facts, node.span.start, node.span.end, constructor_id, type_arg0_id);
    return;
}

fn resolved_constructor_identity_id(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node_id: std::kizu::ast::NodeId
) -> !i64 {
    let atomic_id = try resolved_known_identity_id(
        text, ast, root, node_id, "std::atomic::Atomic", constructor_atomic()
    );
    if atomic_id != no_identity() { return atomic_id; }
    return try resolved_known_identity_id(
        text, ast, root, node_id, "std::channel::Channel", constructor_channel()
    );
}

fn resolved_type_identity_id(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node_id: std::kizu::ast::NodeId
) -> !i64 {
    let bool_id = try resolved_known_identity_id(
        text, ast, root, node_id, "bool", type_bool()
    );
    if bool_id != no_identity() { return bool_id; }
    let i64_id = try resolved_known_identity_id(
        text, ast, root, node_id, "i64", type_i64()
    );
    if i64_id != no_identity() { return i64_id; }
    return try resolved_known_identity_id(
        text, ast, root, node_id, "[]u8", type_slice()
    );
}

fn resolved_known_identity_id(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node_id: std::kizu::ast::NodeId,
    known_name: []u8,
    known_id: i64
) -> !i64 {
    let node = ast.get(node_id);
    let name_start = node.span.start;
    let name_end = node.span.end;
    let name = text[name_start..name_end];
    if std::mem::equal_bytes(name, known_name) { return known_id; }
    let first_end = first_qualified_segment_end(name);
    if first_end == std::mem::len(name) { return no_identity(); }
    return resolved_import_known_identity_id(
        text, ast, root, name, first_end, known_name, known_id
    );
}

fn resolved_import_known_identity_id(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    name: []u8,
    first_end: i64,
    known_name: []u8,
    known_id: i64
) -> !i64 {
    let root_node = ast.get(root);
    match root_node.data {
        Program(program) => return resolved_import_range_identity_id(
            text, ast, program.declarations, name, first_end, known_name, known_id
        );,
        _ => return no_identity();,
    }
}

fn resolved_import_range_identity_id(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    name: []u8,
    first_end: i64,
    known_name: []u8,
    known_id: i64
) -> !i64 {
    var index = 0;
    while index < declarations.len {
        let declaration = try ast.child_at(declarations, index);
        let result = try resolved_import_declaration_identity_id(
            text, ast, declaration, name, first_end, known_name, known_id
        );
        if result != no_alias_match() { return result; }
        index = index + 1;
    }
    return no_identity();
}

fn resolved_import_declaration_identity_id(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declaration: std::kizu::ast::NodeId,
    name: []u8,
    first_end: i64,
    known_name: []u8,
    known_id: i64
) -> !i64 {
    let node = ast.get(declaration);
    match node.data {
        ImportDecl(import_decl) => return resolved_import_path_identity_id(
            text, ast, import_decl.path, name, first_end, known_name, known_id
        );,
        _ => return no_alias_match();,
    }
}

fn resolved_import_path_identity_id(
    text: []u8,
    ast: std::kizu::ast::Ast,
    path: std::kizu::ast::ChildRange,
    name: []u8,
    first_end: i64,
    known_name: []u8,
    known_id: i64
) -> !i64 {
    if path.len < 1 { return no_alias_match(); }
    let first = try ast.child_at(path, 0);
    let last = try ast.child_at(path, path.len - 1);
    let first_node = ast.get(first);
    let last_node = ast.get(last);
    let alias_start = last_node.span.start;
    let alias_end = last_node.span.end;
    let alias = text[alias_start..alias_end];
    if !std::mem::equal_bytes(name[0..first_end], alias) { return no_alias_match(); }
    let module_start = first_node.span.start;
    let module_end = last_node.span.end;
    let module_name = text[module_start..module_end];
    let name_end = std::mem::len(name);
    let suffix = name[first_end..name_end];
    let module_len = std::mem::len(module_name);
    if module_len + std::mem::len(suffix) != std::mem::len(known_name) {
        return no_identity();
    }
    if !std::mem::equal_bytes(module_name, known_name[0..module_len]) {
        return no_identity();
    }
    let known_name_end = std::mem::len(known_name);
    if !std::mem::equal_bytes(suffix, known_name[module_len..known_name_end]) {
        return no_identity();
    }
    return known_id;
}

pub fn constructor_atomic() -> i64 { return 1; }
pub fn constructor_channel() -> i64 { return 2; }
pub fn type_bool() -> i64 { return 1; }
pub fn type_i64() -> i64 { return 2; }
pub fn type_slice() -> i64 { return 3; }
pub fn no_identity() -> i64 { return 0; }
fn no_alias_match() -> i64 { return -1; }

fn first_qualified_segment_end(name: []u8) -> i64 {
    var index = 0;
    while index + 1 < std::mem::len(name) {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            return index;
        }
        index = index + 1;
    }
    return std::mem::len(name);
}

fn collect_call_children(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    facts: &var ConstructorFacts
) -> !void {
    try collect_node(text, ast, root, callee, facts);
    try collect_range(text, ast, root, args, facts);
    return;
}

fn collect_fn(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    facts: &var ConstructorFacts
) -> !void {
    try collect_range(text, ast, root, type_params, facts);
    try collect_range(text, ast, root, params, facts);
    try collect_node(text, ast, root, body, facts);
    return;
}

fn collect_ranges(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    first: std::kizu::ast::ChildRange,
    second: std::kizu::ast::ChildRange,
    facts: &var ConstructorFacts
) -> !void {
    try collect_range(text, ast, root, first, facts);
    try collect_range(text, ast, root, second, facts);
    return;
}

fn collect_one_range(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    facts: &var ConstructorFacts
) -> !void {
    try collect_node(text, ast, root, node, facts);
    try collect_range(text, ast, root, range, facts);
    return;
}

fn collect_two(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    facts: &var ConstructorFacts
) -> !void {
    try collect_node(text, ast, root, first, facts);
    try collect_node(text, ast, root, second, facts);
    return;
}

fn collect_three(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    facts: &var ConstructorFacts
) -> !void {
    try collect_two(text, ast, root, first, second, facts);
    try collect_node(text, ast, root, third, facts);
    return;
}

fn collect_range(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    facts: &var ConstructorFacts
) -> !void {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        try collect_node(text, ast, root, child, facts);
        index = index + 1;
    }
    return;
}
