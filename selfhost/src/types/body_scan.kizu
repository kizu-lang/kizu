pub struct BodyScanSummary {
    pub next: i64,
    pub typed_nodes: i64,
    pub diagnostics: i64,
}

pub fn scan_body_ast_node(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !BodyScanSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return scan_body_range_node(ast, program.declarations);,
        ImportDecl(import_decl) => return scan_body_range_node(ast, import_decl.path);,
        StructDecl(struct_decl) => return scan_body_struct_decl(
            ast,
            struct_decl.name,
            struct_decl.type_params,
            struct_decl.fields
        );,
        EnumDecl(enum_decl) => return scan_body_name_range_node(ast, enum_decl.name, enum_decl.tags);,
        UnionDecl(union_decl) => return scan_body_union_decl(
            ast,
            union_decl.name,
            union_decl.type_params,
            union_decl.variants
        );,
        ImplDecl(impl_decl) => return scan_body_child_range_node(
            ast,
            impl_decl.type_name,
            impl_decl.methods
        );,
        UnionVariant(union_variant) => return scan_body_two_child_node(
            ast,
            union_variant.name,
            union_variant.payload
        );,
        FnDecl(fn_decl) => return scan_body_fn_decl(
            ast,
            fn_decl.extern_abi,
            fn_decl.name,
            fn_decl.type_params,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body
        );,
        Param(param_node) => return scan_body_two_child_node(ast, param_node.name, param_node.type_node);,
        Field(field_node) => return scan_body_two_child_node(ast, field_node.name, field_node.type_node);,
        Block(block) => return scan_body_range_node(ast, block.statements);,
        Let(let_node) => return scan_body_two_child_node(ast, let_node.name, let_node.value);,
        Assign(assign_node) => return scan_body_two_child_node(ast, assign_node.target, assign_node.value);,
        Return(return_node) => return scan_body_one_child_node(ast, return_node.value);,
        Defer(defer_node) => return scan_body_one_child_node(ast, defer_node.expr);,
        ExprStmt(expr_stmt) => return scan_body_one_child_node(ast, expr_stmt.expr);,
        If(if_node) => return scan_body_three_child_node(
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block
        );,
        While(while_node) => return scan_body_three_child_node(
            ast,
            while_node.label,
            while_node.condition,
            while_node.body
        );,
        For(for_node) => return scan_body_five_child_node(
            ast,
            for_node.label,
            for_node.name,
            for_node.start,
            for_node.end,
            for_node.body
        );,
        Break(break_node) => return scan_body_one_child_node(ast, break_node.label);,
        Continue(continue_node) => return scan_body_one_child_node(ast, continue_node.label);,
        Match(match_node) => return scan_body_child_range_node(ast, match_node.value, match_node.arms);,
        MatchArm(match_arm) => return scan_body_three_child_node(
            ast,
            match_arm.pattern,
            match_arm.binding,
            match_arm.body
        );,
        Unsafe(unsafe_node) => return scan_body_one_child_node(ast, unsafe_node.body);,
        ComptimeIf(comptime_if_node) => return scan_body_three_child_node(
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block
        );,
        Prefix(prefix_node) => return scan_body_one_child_node(ast, prefix_node.right);,
        Binary(binary) => return scan_body_two_child_node(ast, binary.left, binary.right);,
        FieldExpr(field_expr_node) => return scan_body_two_child_node(
            ast,
            field_expr_node.receiver,
            field_expr_node.name
        );,
        DerefExpr(deref_expr_node) => return scan_body_one_child_node(ast, deref_expr_node.receiver);,
        Call(call_node) => return scan_body_child_range_node(ast, call_node.callee, call_node.args);,
        TypeApplyExpr(type_apply) => return scan_body_child_range_node(
            ast,
            type_apply.callee,
            type_apply.type_args
        );,
        CastExpr(cast_expr) => return scan_body_two_child_node(
            ast,
            cast_expr.type_node,
            cast_expr.value
        );,
        IndexExpr(index_expr) => return scan_body_three_child_node(
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end
        );,
        StructLiteralExpr(struct_literal) => return scan_body_child_range_node(
            ast,
            struct_literal.type_name,
            struct_literal.fields
        );,
        StructFieldInit(struct_field_init) => return scan_body_two_child_node(
            ast,
            struct_field_init.name,
            struct_field_init.value
        );,
        ArenaNewExpr(arena_new) => return scan_body_two_child_node(
            ast,
            arena_new.type_node,
            arena_new.allocator
        );,
        TryExpr(try_expr_node) => return scan_body_one_child_node(ast, try_expr_node.value);,
        ComptimeExpr(comptime_expr_node) => return scan_body_one_child_node(
            ast,
            comptime_expr_node.value
        );,
        TypeName(type_name) => return body_node_summary();,
        Var(var_node) => return body_node_summary();,
        Int(int_node) => return body_node_summary();,
        String(string_node) => return body_node_summary();,
        Bool(bool_node) => return body_node_summary();,
        Empty => return body_node_summary();,
    }
}

fn scan_body_struct_decl(
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    fields: std::kizu::ast::ChildRange
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, name));
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, type_params));
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, fields));
    return summary;
}

fn scan_body_union_decl(
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    variants: std::kizu::ast::ChildRange
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, name));
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, type_params));
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, variants));
    return summary;
}

fn scan_body_fn_decl(
    ast: std::kizu::ast::Ast,
    extern_abi: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, extern_abi));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, name));
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, type_params));
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, params));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, return_type));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, body));
    return summary;
}

fn scan_body_name_range_node(
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, name));
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, range));
    return summary;
}

fn scan_body_range_node(
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, range));
    return summary;
}

fn scan_body_child_range_node(
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, child));
    summary = merge_body_scan_summaries(summary, try scan_body_child_range(ast, range));
    return summary;
}

fn scan_body_one_child_node(
    ast: std::kizu::ast::Ast,
    child: std::kizu::ast::NodeId
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, child));
    return summary;
}

fn scan_body_two_child_node(
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, first));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, second));
    return summary;
}

fn scan_body_three_child_node(
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, first));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, second));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, third));
    return summary;
}

fn scan_body_five_child_node(
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    fourth: std::kizu::ast::NodeId,
    fifth: std::kizu::ast::NodeId
) -> !BodyScanSummary {
    var summary = body_node_summary();
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, first));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, second));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, third));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, fourth));
    summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, fifth));
    return summary;
}

fn scan_body_child_range(
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !BodyScanSummary {
    var summary = body_scan_summary(range.start + range.len, 0, 0);
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        summary = merge_body_scan_summaries(summary, try scan_body_ast_node(ast, child));
        index = index + 1;
    }
    return summary;
}

fn body_node_summary() -> BodyScanSummary {
    return body_scan_summary(0, 1, 0);
}

fn body_scan_summary(next: i64, typed_nodes: i64, diagnostics: i64) -> BodyScanSummary {
    return BodyScanSummary {
        next: next,
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
}

fn merge_body_scan_summaries(left: BodyScanSummary, right: BodyScanSummary) -> BodyScanSummary {
    return body_scan_summary(
        left.next + right.next,
        left.typed_nodes + right.typed_nodes,
        left.diagnostics + right.diagnostics
    );
}
