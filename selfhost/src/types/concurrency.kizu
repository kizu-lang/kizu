import selfhost::ir::intrinsic_type_contract;
import selfhost::source;
import selfhost::type_constructor;
import selfhost::types::ast_text;
import selfhost::types::concurrency_boundary;
import selfhost::types::concurrency_contract;
import selfhost::types::expression_facts;
import selfhost::types::local_facts;
import selfhost::types::model;

// The `comptime Function` slot and the contracts that hang off it.
//
// SPEC.md:1648 makes a Function parameter a compile-time function-name token: it is not
// a value, it cannot be stored, and its argument is a top-level function name. Two rules
// follow, and this pass owns both.
//
//  - Namespace. The argument in such a slot resolves in the function namespace. The
//    value namespace is left exactly as it is, so a bare function name stays undefined
//    everywhere else and `let f = worker;` remains an error. It is the call site that
//    must not route the slot through the value scan, not the scan that must relax.
//  - Contract. Naming a function is only half a call. The operation behind the slot
//    hands the named worker its arguments across a concurrency boundary, so the worker's
//    declared signature has to fit the operation, and every type that crosses has to be
//    one the far side can uphold.
//
// Both rules read their facts from selfhost::types::concurrency_contract, keyed by
// operation identity, and from the worker's own declaration in the file being checked.

pub fn kind_function_param_reserved() -> i64 { return 1; }
pub fn kind_function_param_comptime() -> i64 { return 2; }
pub fn kind_function_param_borrowed() -> i64 { return 3; }
pub fn kind_builtin_reserved() -> i64 { return 4; }
pub fn kind_expects_function_name() -> i64 { return 5; }
pub fn kind_undefined_function() -> i64 { return 6; }
pub fn kind_spawn_owned_io() -> i64 { return 7; }
pub fn kind_capture_borrow() -> i64 { return 8; }
pub fn kind_boundary() -> i64 { return 9; }
pub fn kind_boundary_field() -> i64 { return 10; }
pub fn kind_arg_count() -> i64 { return 11; }
pub fn kind_parallel_worker_param() -> i64 { return 12; }
pub fn kind_parallel_worker_return() -> i64 { return 13; }
pub fn kind_parallel_map_worker_param() -> i64 { return 14; }
pub fn kind_parallel_map_worker_return() -> i64 { return 15; }
pub fn kind_thread_worker_param() -> i64 { return 16; }
pub fn kind_thread_worker_return() -> i64 { return 17; }
pub fn kind_mutable_argument() -> i64 { return 18; }
pub fn kind_task_incomplete() -> i64 { return 19; }
pub fn kind_task_completed() -> i64 { return 20; }
pub fn kind_constructor_param() -> i64 { return 21; }

pub fn no_concurrency_diagnostic() -> model::ConcurrencySummary {
    return model::ConcurrencySummary {
        found: false, kind: 0, start: 0, end: 0,
        subject: "", detail: "", actual: "", expected: 0, observed: 0
    };
}

fn diagnostic(
    kind: i64,
    start: i64,
    end: i64,
    subject: []u8,
    detail: []u8
) -> model::ConcurrencySummary {
    return model::ConcurrencySummary {
        found: true, kind: kind, start: start, end: end,
        subject: subject, detail: detail, actual: "", expected: 0, observed: 0
    };
}

fn count_diagnostic(
    start: i64,
    end: i64,
    subject: []u8,
    expected: i64,
    observed: i64
) -> model::ConcurrencySummary {
    return model::ConcurrencySummary {
        found: true, kind: kind_arg_count(), start: start, end: end,
        subject: subject, detail: "", actual: "", expected: expected, observed: observed
    };
}

// A worker declaration in the file being checked. A function-name token names a
// top-level function, so these declarations are the whole namespace such a slot reaches.
pub struct WorkerDecl {
    pub found: bool,
    pub params: std::kizu::ast::ChildRange,
    pub return_type: []u8,
}

// A parameter reduced to what these rules ask about: its type without the borrow marker,
// and whether that marker was there.
pub struct ParamFact {
    pub found: bool,
    pub type_name: []u8,
    pub borrowed: bool,
    pub comptime_param: bool,
    pub name: []u8,
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

pub fn first_concurrency_diagnostic_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::ConcurrencySummary {
    let node = ast.get(root);
    match node.data {
        Program(program) => return try first_diagnostic_in_declarations(
            allocator, file, ast, root, program.declarations, expression_types
        );,
        _ => return no_concurrency_diagnostic();,
    }
}

fn first_diagnostic_in_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    declarations: std::kizu::ast::ChildRange,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::ConcurrencySummary {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = try first_diagnostic_in_declaration(
            allocator, file, ast, root, child, expression_types
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_concurrency_diagnostic();
}

fn first_diagnostic_in_declaration(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node_id: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::ConcurrencySummary {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return try first_diagnostic_in_function(
            allocator, file, ast, root,
            fn_decl.type_params, fn_decl.params, fn_decl.body,
            expression_types
        );,
        // A method is a function declaration wherever it is written: the block that
        // encloses it names its receiver, and settles nothing about what its parameters
        // may be (internal/types/checker.go:1055 reads every declaration form alike).
        ImplDecl(impl_decl) => return try first_diagnostic_in_declarations(
            allocator, file, ast, root, impl_decl.methods, expression_types
        );,
        ContractDecl(contract_decl) => return try first_diagnostic_in_declarations(
            allocator, file, ast, root, contract_decl.methods, expression_types
        );,
        _ => return no_concurrency_diagnostic();,
    }
}

fn first_diagnostic_in_function(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    expression_types: &var expression_facts::ExpressionTypeFacts
) -> !model::ConcurrencySummary {
    let policy = try function_token_policy(file, ast, params);
    if policy.found {
        return policy;
    }
    var local_types = std::map::Map<[]u8, []u8>(allocator);
    var local_mutability = std::map::Map<[]u8, bool>(allocator);
    defer local_types.deinit();
    defer local_mutability.deinit();
    let locals = try local_facts::collect_function_statement_locals(
        allocator, file, ast, type_params, params, body,
        local_types, local_mutability, expression_types
    );
    let call = try first_diagnostic_in_statement(
        allocator, file, ast, root, body, local_types, local_mutability
    );
    if call.found {
        return call;
    }
    return try first_task_linearity_diagnostic(
        allocator, file, ast, params, body, local_types
    );
}

// ---------------------------------------------------------------------------
// The Function token policy (internal/types/checker.go:1055 is the oracle)
// ---------------------------------------------------------------------------

fn function_token_policy(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange
) -> !model::ConcurrencySummary {
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        let fact = param_fact(file, ast, child);
        let found = function_token_param_policy(ast, file, child, fact);
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_concurrency_diagnostic();
}

fn function_token_param_policy(
    ast: std::kizu::ast::Ast,
    file: &source::SourceFile,
    node_id: std::kizu::ast::NodeId,
    fact: ParamFact
) -> model::ConcurrencySummary {
    if !fact.found or !is_function_token(fact.type_name) {
        return no_concurrency_diagnostic();
    }
    let node = ast.get(node_id);
    if file.kind != source::SourceKind::Std {
        return diagnostic(
            kind_function_param_reserved(), node.span.start, node.span.end, fact.name, ""
        );
    }
    if fact.borrowed {
        return diagnostic(
            kind_function_param_borrowed(), node.span.start, node.span.end, fact.name, ""
        );
    }
    if !fact.comptime_param {
        return diagnostic(
            kind_function_param_comptime(), node.span.start, node.span.end, fact.name, ""
        );
    }
    return no_concurrency_diagnostic();
}

fn is_function_token(type_name: []u8) -> bool {
    return intrinsic_type_contract::from_source_name(type_name) ==
        intrinsic_type_contract::kind_function();
}

// ---------------------------------------------------------------------------
// Statement and expression walk
// ---------------------------------------------------------------------------

fn first_diagnostic_in_statement(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return try first_diagnostic_in_range(
            allocator, file, ast, root, block.statements, local_types, local_mutability
        );,
        Let(let_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, let_node.value, local_types, local_mutability
        );,
        Assign(assign_node) => return try first_diagnostic_in_two(
            allocator, file, ast, root, assign_node.target, assign_node.value,
            local_types, local_mutability
        );,
        Return(return_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, return_node.value, local_types, local_mutability
        );,
        Defer(defer_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, defer_node.expr, local_types, local_mutability
        );,
        ErrDefer(err_defer_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, err_defer_node.expr, local_types, local_mutability
        );,
        ExprStmt(expr_stmt) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, expr_stmt.expr, local_types, local_mutability
        );,
        If(if_node) => return try first_diagnostic_in_three(
            allocator, file, ast, root,
            if_node.condition, if_node.then_block, if_node.else_block,
            local_types, local_mutability
        );,
        ComptimeIf(comptime_if_node) => return try first_diagnostic_in_three(
            allocator, file, ast, root,
            comptime_if_node.condition, comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types, local_mutability
        );,
        While(while_node) => return try first_diagnostic_in_two(
            allocator, file, ast, root, while_node.condition, while_node.body,
            local_types, local_mutability
        );,
        For(for_node) => return try first_diagnostic_in_three(
            allocator, file, ast, root, for_node.start, for_node.end, for_node.body,
            local_types, local_mutability
        );,
        Match(match_node) => return try first_diagnostic_in_value_and_range(
            allocator, file, ast, root, match_node.value, match_node.arms,
            local_types, local_mutability
        );,
        MatchArm(match_arm) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, match_arm.body, local_types, local_mutability
        );,
        Unsafe(unsafe_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, unsafe_node.body, local_types, local_mutability
        );,
        Prefix(prefix_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, prefix_node.right, local_types, local_mutability
        );,
        Binary(binary) => return try first_diagnostic_in_two(
            allocator, file, ast, root, binary.left, binary.right,
            local_types, local_mutability
        );,
        FieldExpr(field_expr_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, field_expr_node.receiver,
            local_types, local_mutability
        );,
        DerefExpr(deref_expr_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, deref_expr_node.receiver,
            local_types, local_mutability
        );,
        CastExpr(cast_expr) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, cast_expr.value, local_types, local_mutability
        );,
        IndexExpr(index_expr) => return try first_diagnostic_in_three(
            allocator, file, ast, root, index_expr.target, index_expr.start, index_expr.end,
            local_types, local_mutability
        );,
        StructLiteralExpr(struct_literal) => return try first_diagnostic_in_range(
            allocator, file, ast, root, struct_literal.fields, local_types, local_mutability
        );,
        StructFieldInit(struct_field_init) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, struct_field_init.value, local_types, local_mutability
        );,
        ArenaNewExpr(arena_new) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, arena_new.allocator, local_types, local_mutability
        );,
        TryExpr(try_expr_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, try_expr_node.value, local_types, local_mutability
        );,
        ComptimeExpr(comptime_expr_node) => return try first_diagnostic_in_statement(
            allocator, file, ast, root, comptime_expr_node.value, local_types, local_mutability
        );,
        Call(call_node) => return try first_diagnostic_in_call(
            allocator, file, ast, root, call_node.callee, call_node.args,
            local_types, local_mutability
        );,
        _ => return no_concurrency_diagnostic();,
    }
}

fn first_diagnostic_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let found = try first_diagnostic_in_statement(
            allocator, file, ast, root, child, local_types, local_mutability
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_concurrency_diagnostic();
}

fn first_diagnostic_in_two(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    let found = try first_diagnostic_in_statement(
        allocator, file, ast, root, first, local_types, local_mutability
    );
    if found.found {
        return found;
    }
    return try first_diagnostic_in_statement(
        allocator, file, ast, root, second, local_types, local_mutability
    );
}

fn first_diagnostic_in_three(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    let found = try first_diagnostic_in_two(
        allocator, file, ast, root, first, second, local_types, local_mutability
    );
    if found.found {
        return found;
    }
    return try first_diagnostic_in_statement(
        allocator, file, ast, root, third, local_types, local_mutability
    );
}

fn first_diagnostic_in_value_and_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    let found = try first_diagnostic_in_statement(
        allocator, file, ast, root, value, local_types, local_mutability
    );
    if found.found {
        return found;
    }
    return try first_diagnostic_in_range(
        allocator, file, ast, root, range, local_types, local_mutability
    );
}

fn first_diagnostic_in_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    let found = try check_operation(
        allocator, file, ast, root, callee, args, local_types, local_mutability
    );
    if found.found {
        return found;
    }
    let receiver = try first_diagnostic_in_statement(
        allocator, file, ast, root, callee, local_types, local_mutability
    );
    if receiver.found {
        return receiver;
    }
    return try first_diagnostic_in_range(
        allocator, file, ast, root, args, local_types, local_mutability
    );
}

// ---------------------------------------------------------------------------
// Operation identity
// ---------------------------------------------------------------------------

// callee_base unwraps a static type application to the name it applies.
pub fn callee_base(
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> std::kizu::ast::NodeId {
    let node = ast.get(callee);
    match node.data {
        TypeApplyExpr(type_apply) => return callee_base(ast, type_apply.callee);,
        _ => return callee;,
    }
}

// callee_type_argument reads a static type argument off the callee, or "" when the
// callee applies none.
fn callee_type_argument(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    wanted: i64
) -> ![]u8 {
    let node = ast.get(callee);
    match node.data {
        TypeApplyExpr(type_apply) => return try type_argument_text(
            file, ast, type_apply.type_args, wanted
        );,
        _ => return "";,
    }
}

fn type_argument_text(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_args: std::kizu::ast::ChildRange,
    wanted: i64
) -> ![]u8 {
    if wanted >= type_args.len {
        return "";
    }
    let child = try ast.child_at(type_args, wanted);
    return ast_text::ast_node_text(file, ast, child);
}

// operation_of resolves the concurrency operation a callee names, in either identity
// form: a std path whose declaration carries the slot, or an intrinsic method whose
// receiver is a builtin type.
pub fn operation_of(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !i64 {
    let base = callee_base(ast, callee);
    let node = ast.get(base);
    match node.data {
        FieldExpr(field_expr_node) => return try field_callee_operation(
            file, ast, base, field_expr_node.namespace,
            field_expr_node.receiver, field_expr_node.name, local_types
        );,
        _ => return concurrency_contract::path_operation(
            ast_text::ast_node_text(file, ast, base)
        );,
    }
}

fn field_callee_operation(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    base: std::kizu::ast::NodeId,
    namespace: bool,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !i64 {
    if namespace {
        return concurrency_contract::path_operation(
            ast_text::ast_node_text(file, ast, base)
        );
    }
    let receiver_kind = try receiver_intrinsic_kind(file, ast, receiver, local_types);
    if receiver_kind < 0 {
        return concurrency_contract::op_none();
    }
    return concurrency_contract::method_operation(
        receiver_kind, ast_text::ast_node_text(file, ast, name)
    );
}

// is_mutable_slot_accessor reports whether a callee names an intrinsic slot the caller
// may write through. The assignment-target rule asks this of a call target.
pub fn is_mutable_slot_accessor(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !bool {
    let base = callee_base(ast, callee);
    let node = ast.get(base);
    match node.data {
        FieldExpr(field_expr_node) => return try field_names_mutable_slot(
            file, ast, field_expr_node.namespace,
            field_expr_node.receiver, field_expr_node.name, local_types
        );,
        _ => return false;,
    }
}

fn field_names_mutable_slot(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    namespace: bool,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !bool {
    if namespace {
        return false;
    }
    let receiver_kind = try receiver_intrinsic_kind(file, ast, receiver, local_types);
    if receiver_kind < 0 {
        return false;
    }
    return concurrency_contract::mutable_slot_accessor(
        receiver_kind, ast_text::ast_node_text(file, ast, name)
    );
}

fn receiver_intrinsic_kind(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !i64 {
    let name = variable_name(file, ast, receiver);
    if std::mem::len(name) == 0 or !local_types.contains(name) {
        return -1;
    }
    return try type_constructor::applied_intrinsic_kind(try local_types.get(name));
}

fn variable_name(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    match node.data {
        Var(var_node) => return ast_text::ast_node_text(file, ast, node_id);,
        _ => return "";,
    }
}

// ---------------------------------------------------------------------------
// The rule
// ---------------------------------------------------------------------------

fn check_operation(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    let base = callee_base(ast, callee);
    let base_node = ast.get(base);
    let base_text = ast_text::ast_node_text(file, ast, base);
    let constructed = try check_constructor_arguments(
        file, ast, base_text, args, local_types
    );
    if constructed.found {
        return constructed;
    }
    let reserved = concurrency_contract::builtin_path_operation(base_text);
    if reserved != concurrency_contract::op_none() {
        return diagnostic(
            kind_builtin_reserved(),
            base_node.span.start, base_node.span.end, base_text,
            concurrency_contract::reserving_module(reserved)
        );
    }
    let operation = try operation_of(file, ast, callee, local_types);
    if operation == concurrency_contract::op_none() {
        return no_concurrency_diagnostic();
    }
    let slot = concurrency_contract::function_slot(operation);
    let label = concurrency_contract::operation_label(operation);
    if slot >= args.len {
        return count_diagnostic(
            base_node.span.start, base_node.span.end, label, slot + 1, args.len
        );
    }
    let slot_node = try ast.child_at(args, slot);
    let slot_span = ast.get(slot_node);
    let worker_name = variable_name(file, ast, slot_node);
    if std::mem::len(worker_name) == 0 {
        return diagnostic(
            kind_expects_function_name(),
            slot_span.span.start, slot_span.span.end, label, ""
        );
    }
    // A binding whose own type is the Function token forwards the name onward. That is
    // the only value that may stand here (internal/types/checker.go:6396).
    if try binds_function_token(worker_name, local_types) {
        return no_concurrency_diagnostic();
    }
    let worker = try find_worker(file, ast, root, worker_name);
    if !worker.found {
        // Whether a value binding standing in the slot is "not a function name" or an
        // undefined function is a property of the operation, not of this code path: only
        // the operations whose oracle consults the value scope before giving up say the
        // former.
        if local_types.contains(worker_name) and
            concurrency_contract::binding_shadows_function_name(operation) {
            return diagnostic(
                kind_expects_function_name(),
                slot_span.span.start, slot_span.span.end, label, ""
            );
        }
        return diagnostic(
            kind_undefined_function(),
            slot_span.span.start, slot_span.span.end, worker_name, ""
        );
    }
    return try check_worker_contract(
        allocator, file, ast, root, base, callee, args,
        operation, worker_name, &worker, local_mutability
    );
}

// An intrinsic constructor's parameters are registry data, so its arguments are checked
// against that contract rather than against the std wrapper's forwarding declaration.
// The check is conservative: an argument whose type its binding does not already give is
// left to the passes that infer expression types.
fn check_constructor_arguments(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: []u8,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::ConcurrencySummary {
    let count = concurrency_contract::constructor_param_count(name);
    if count < 0 {
        return no_concurrency_diagnostic();
    }
    var index = 0;
    while index < count and index < args.len {
        let child = try ast.child_at(args, index);
        let found = try constructor_argument_mismatch(
            file, ast, name, child, index, local_types
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_concurrency_diagnostic();
}

fn constructor_argument_mismatch(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: []u8,
    node_id: std::kizu::ast::NodeId,
    index: i64,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::ConcurrencySummary {
    let actual = try known_argument_type(file, ast, node_id, local_types);
    if std::mem::len(actual) == 0 {
        return no_concurrency_diagnostic();
    }
    let expected = concurrency_contract::constructor_param_type(name, index);
    if std::mem::len(expected) == 0 or std::mem::equal_bytes(actual, expected) {
        return no_concurrency_diagnostic();
    }
    let node = ast.get(node_id);
    return model::ConcurrencySummary {
        found: true,
        kind: kind_constructor_param(),
        start: node.span.start,
        end: node.span.end,
        subject: concurrency_contract::constructor_param_role(name, index),
        detail: expected,
        actual: actual,
        expected: 0,
        observed: 0
    };
}

// known_argument_type answers only where the type is already settled: a literal's own
// type, or the type its binding was given. Anything else answers "" and is not judged.
fn known_argument_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> ![]u8 {
    let node = ast.get(node_id);
    match node.data {
        Int(int_node) => return "i64";,
        Bool(bool_node) => return "bool";,
        String(string_node) => return "[]u8";,
        Var(var_node) => return try known_binding_type(file, ast, node_id, local_types);,
        _ => return "";,
    }
}

fn known_binding_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> ![]u8 {
    let name = ast_text::ast_node_text(file, ast, node_id);
    if !local_types.contains(name) {
        return "";
    }
    let spelling = try local_types.get(name);
    if std::mem::equal_bytes(spelling, "unknown") {
        return "";
    }
    return spelling;
}

fn binds_function_token(
    name: []u8,
    local_types: &std::map::Map<[]u8, []u8>
) -> !bool {
    if !local_types.contains(name) {
        return false;
    }
    return is_function_token(try local_types.get(name));
}

fn check_worker_contract(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    base: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    operation: i64,
    worker_name: []u8,
    worker: &WorkerDecl,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    if concurrency_contract::spawns_with_owned_io(operation) {
        return try check_spawn_contract(
            allocator, file, ast, root, base, args, operation, worker_name, worker
        );
    }
    if operation == concurrency_contract::op_parallel_for() {
        return try check_index_worker_contract(
            file, ast, base, worker_name, worker,
            kind_parallel_worker_param(), kind_parallel_worker_return(), "void"
        );
    }
    if operation == concurrency_contract::op_parallel_map() {
        let worker_error = try check_index_worker_contract(
            file, ast, base, worker_name, worker,
            kind_parallel_map_worker_param(), kind_parallel_map_worker_return(), "i64"
        );
        if worker_error.found {
            return worker_error;
        }
        return try check_mutable_argument(file, ast, args, 1, local_mutability);
    }
    if operation == concurrency_contract::op_thread_scoped() {
        return try check_thread_worker_contract(
            allocator, file, ast, root, base, callee, worker_name, worker
        );
    }
    return no_concurrency_diagnostic();
}

// A spawned worker owns the Io it is handed and every value that goes with it. Its first
// parameter is that Io; the remaining parameters take the call's captured arguments, and
// each one has to name a type the far side of the boundary can hold.
fn check_spawn_contract(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    base: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    operation: i64,
    worker_name: []u8,
    worker: &WorkerDecl
) -> !model::ConcurrencySummary {
    let node = ast.get(base);
    let first = try param_fact_at(file, ast, worker.params, 0);
    if !accepts_owned_io(first) {
        return diagnostic(
            kind_spawn_owned_io(), node.span.start, node.span.end, worker_name, ""
        );
    }
    // The call passes the worker's parameters after the implicit Io. `spawn` names the
    // worker in that same argument list; `enqueue` names the Io as well.
    var captured = args.len - 1;
    if operation == concurrency_contract::op_queue_enqueue() {
        captured = args.len - 2;
    }
    if captured != worker.params.len - 1 {
        return count_diagnostic(
            node.span.start, node.span.end, worker_name,
            worker.params.len - 1, captured
        );
    }
    let owner = concurrency_contract::capture_owner(operation);
    var index = 0;
    while index < worker.params.len {
        let fact = try param_fact_at(file, ast, worker.params, index);
        if index > 0 and fact.borrowed {
            return diagnostic(
                kind_capture_borrow(), node.span.start, node.span.end, worker_name, owner
            );
        }
        let crossing = try check_boundary_type(
            allocator, file, ast, root, base, fact.type_name
        );
        if crossing.found {
            return crossing;
        }
        index = index + 1;
    }
    return no_concurrency_diagnostic();
}

fn accepts_owned_io(first: ParamFact) -> bool {
    if !first.found or first.borrowed {
        return false;
    }
    return intrinsic_type_contract::from_source_name(first.type_name) ==
        intrinsic_type_contract::kind_io();
}

// A parallel worker runs once per index, so it takes the index and returns either
// nothing or the mapped element.
fn check_index_worker_contract(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    base: std::kizu::ast::NodeId,
    worker_name: []u8,
    worker: &WorkerDecl,
    param_kind: i64,
    return_kind: i64,
    expected_return: []u8
) -> !model::ConcurrencySummary {
    let node = ast.get(base);
    let first = try param_fact_at(file, ast, worker.params, 0);
    if worker.params.len != 1 or !first.found or first.borrowed or
        !std::mem::equal_bytes(first.type_name, "i64") {
        return diagnostic(param_kind, node.span.start, node.span.end, worker_name, "");
    }
    if returns_expected(worker.return_type, expected_return) {
        return no_concurrency_diagnostic();
    }
    return diagnostic(return_kind, node.span.start, node.span.end, worker_name, "");
}

// A parallel_for worker reports failure through an error union, so `void` accepts both
// spellings; a parallel_map worker produces the element itself and accepts only one.
fn returns_expected(returns: []u8, expected: []u8) -> bool {
    if std::mem::equal_bytes(returns, expected) {
        return true;
    }
    if !std::mem::equal_bytes(expected, "void") {
        return false;
    }
    return std::mem::equal_bytes(returns, "!void");
}

// A scoped thread worker maps the static type argument to itself: it takes one owned T
// and gives one back, and T itself has to be able to cross the boundary.
fn check_thread_worker_contract(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    base: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    worker_name: []u8,
    worker: &WorkerDecl
) -> !model::ConcurrencySummary {
    let node = ast.get(base);
    let element = try callee_type_argument(file, ast, callee, 0);
    if std::mem::len(element) == 0 {
        return no_concurrency_diagnostic();
    }
    let first = try param_fact_at(file, ast, worker.params, 0);
    if worker.params.len != 1 or !first.found or
        !std::mem::equal_bytes(first.type_name, element) {
        return diagnostic(
            kind_thread_worker_param(), node.span.start, node.span.end, worker_name, element
        );
    }
    if first.borrowed {
        return diagnostic(
            kind_capture_borrow(), node.span.start, node.span.end, worker_name,
            concurrency_contract::capture_owner(concurrency_contract::op_thread_scoped())
        );
    }
    if !std::mem::equal_bytes(worker.return_type, element) {
        return diagnostic(
            kind_thread_worker_return(), node.span.start, node.span.end, worker_name, element
        );
    }
    return try check_boundary_type(allocator, file, ast, root, base, element);
}

fn check_boundary_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    base: std::kizu::ast::NodeId,
    spelling: []u8
) -> !model::ConcurrencySummary {
    var visited = std::map::Map<[]u8, bool>(allocator);
    defer visited.deinit();
    let crossing = try concurrency_boundary::first_boundary_violation(
        file, ast, root, spelling, visited
    );
    if !crossing.found {
        return no_concurrency_diagnostic();
    }
    let node = ast.get(base);
    if std::mem::len(crossing.owner) > 0 {
        return diagnostic(
            kind_boundary_field(), node.span.start, node.span.end,
            crossing.owner, crossing.field
        );
    }
    return diagnostic(
        kind_boundary(), node.span.start, node.span.end, "", crossing.reason
    );
}

// A `&var` slot needs a binding the caller may still write through.
fn check_mutable_argument(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    args: std::kizu::ast::ChildRange,
    index: i64,
    local_mutability: &std::map::Map<[]u8, bool>
) -> !model::ConcurrencySummary {
    if index >= args.len {
        return no_concurrency_diagnostic();
    }
    let child = try ast.child_at(args, index);
    let name = variable_name(file, ast, child);
    if std::mem::len(name) == 0 or !local_mutability.contains(name) {
        return no_concurrency_diagnostic();
    }
    if try local_mutability.get(name) {
        return no_concurrency_diagnostic();
    }
    let node = ast.get(child);
    return diagnostic(
        kind_mutable_argument(), node.span.start, node.span.end, name, ""
    );
}

// ---------------------------------------------------------------------------
// Worker declarations
// ---------------------------------------------------------------------------

fn no_worker() -> WorkerDecl {
    return WorkerDecl {
        found: false,
        params: std::kizu::ast::ChildRange { start: 0, len: 0 },
        return_type: ""
    };
}

pub fn find_worker(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    name: []u8
) -> !WorkerDecl {
    let node = ast.get(root);
    match node.data {
        Program(program) => return try find_worker_in_range(
            file, ast, program.declarations, name
        );,
        _ => return no_worker();,
    }
}

fn find_worker_in_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    name: []u8
) -> !WorkerDecl {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let found = worker_from_declaration(file, ast, child, name);
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_worker();
}

fn worker_from_declaration(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    name: []u8
) -> WorkerDecl {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return named_worker(
            file, ast, fn_decl.name, fn_decl.params, fn_decl.return_type, name
        );,
        _ => return no_worker();,
    }
}

fn named_worker(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declared: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    name: []u8
) -> WorkerDecl {
    if !std::mem::equal_bytes(ast_text::ast_node_text(file, ast, declared), name) {
        return no_worker();
    }
    return WorkerDecl {
        found: true,
        params: params,
        return_type: ast_text::ast_return_type_text(file, ast, return_type)
    };
}

fn no_param_fact() -> ParamFact {
    return ParamFact {
        found: false, type_name: "", borrowed: false, comptime_param: false, name: ""
    };
}

pub fn param_fact_at(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    index: i64
) -> !ParamFact {
    if index >= params.len {
        return no_param_fact();
    }
    let child = try ast.child_at(params, index);
    return param_fact(file, ast, child);
}

fn param_fact(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> ParamFact {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return param_node_fact(
            file, ast, param_node.comptime_param, param_node.name, param_node.type_node
        );,
        _ => return no_param_fact();,
    }
}

fn param_node_fact(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    comptime_param: bool,
    name: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId
) -> ParamFact {
    let spelling = ast_text::ast_return_type_text(file, ast, type_node);
    return ParamFact {
        found: true,
        type_name: strip_borrow(spelling),
        borrowed: is_borrowed_spelling(spelling),
        comptime_param: comptime_param,
        name: ast_text::ast_node_text(file, ast, name)
    };
}

// A borrow marker is a property of the parameter, not of the type it names: the boundary
// rules ask about the type, the capture rule asks about the marker.
pub fn is_borrowed_spelling(spelling: []u8) -> bool {
    return std::mem::starts_with(spelling, "&");
}

pub fn strip_borrow(spelling: []u8) -> []u8 borrows spelling {
    let length = std::mem::len(spelling);
    if std::mem::starts_with(spelling, "&var ") {
        return std::mem::trim_ascii(spelling[5..length]);
    }
    if std::mem::starts_with(spelling, "&") {
        return std::mem::trim_ascii(spelling[1..length]);
    }
    return spelling;
}

// ---------------------------------------------------------------------------
// Task linearity
// ---------------------------------------------------------------------------

// A spawned task carries exactly one result, so exactly one of `await` or `cancel` takes
// it, and the binding cannot leave the function without that having happened. Spawns and
// completions are both recorded as they are met, so the two orders a completed task can
// be used in -- twice, or not at all -- are the same question asked of two append-only
// lists.
pub struct TaskBinding {
    pub name: []u8,
    pub start: i64,
    pub end: i64,
}

fn first_task_linearity_diagnostic(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !model::ConcurrencySummary {
    var tasks = std::array::Array<TaskBinding>(allocator);
    var completions = std::array::Array<TaskBinding>(allocator);
    defer tasks.deinit();
    defer completions.deinit();
    try collect_task_parameters(file, ast, params, tasks);
    let found = try walk_task_statement(
        file, ast, body, local_types, tasks, completions
    );
    if found.found {
        return found;
    }
    return try first_incomplete_task(tasks, completions);
}

// collect_task_parameters records the task bindings a signature opens the body with. A
// parameter binds a task the same way a local does -- the rule reads every binding the
// scope holds (internal/ownership/checker.go:6515) -- and a borrow marker is a property
// of the parameter, not of the type it names, so a borrowed task is still that task.
fn collect_task_parameters(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    tasks: &var std::array::Array<TaskBinding>
) -> !void {
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        let fact = param_fact(file, ast, child);
        if fact.found and
            (try type_constructor::applied_intrinsic_kind(fact.type_name)) ==
                intrinsic_type_contract::kind_task() {
            let node = ast.get(child);
            try tasks.append(TaskBinding {
                name: fact.name,
                start: node.span.start,
                end: node.span.end
            });
        }
        index = index + 1;
    }
    return;
}

fn first_incomplete_task(
    tasks: &std::array::Array<TaskBinding>,
    completions: &std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    var index = 0;
    while index < tasks.len() {
        let task = try tasks.at(index);
        if !(try names_contain(completions, task.name)) {
            return diagnostic(
                kind_task_incomplete(), task.start, task.end, task.name, ""
            );
        }
        index = index + 1;
    }
    return no_concurrency_diagnostic();
}

fn names_contain(
    names: &std::array::Array<TaskBinding>,
    wanted: []u8
) -> !bool {
    return try task_names_contain(names, wanted);
}

fn task_names_contain(
    tasks: &std::array::Array<TaskBinding>,
    wanted: []u8
) -> !bool {
    var index = 0;
    while index < tasks.len() {
        let task = try tasks.at(index);
        if std::mem::equal_bytes(task.name, wanted) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn walk_task_statement(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return try walk_task_range(
            file, ast, block.statements, local_types, tasks, completions
        );,
        Let(let_node) => return try walk_task_let(
            file, ast, let_node.name, let_node.value, local_types, tasks, completions
        );,
        Assign(assign_node) => return try walk_task_two(
            file, ast, assign_node.target, assign_node.value,
            local_types, tasks, completions
        );,
        Return(return_node) => return try walk_task_statement(
            file, ast, return_node.value, local_types, tasks, completions
        );,
        Defer(defer_node) => return try walk_task_statement(
            file, ast, defer_node.expr, local_types, tasks, completions
        );,
        ErrDefer(err_defer_node) => return try walk_task_statement(
            file, ast, err_defer_node.expr, local_types, tasks, completions
        );,
        ExprStmt(expr_stmt) => return try walk_task_statement(
            file, ast, expr_stmt.expr, local_types, tasks, completions
        );,
        If(if_node) => return try walk_task_three(
            file, ast, if_node.condition, if_node.then_block, if_node.else_block,
            local_types, tasks, completions
        );,
        ComptimeIf(comptime_if_node) => return try walk_task_three(
            file, ast, comptime_if_node.condition, comptime_if_node.then_block,
            comptime_if_node.else_block, local_types, tasks, completions
        );,
        While(while_node) => return try walk_task_two(
            file, ast, while_node.condition, while_node.body,
            local_types, tasks, completions
        );,
        For(for_node) => return try walk_task_three(
            file, ast, for_node.start, for_node.end, for_node.body,
            local_types, tasks, completions
        );,
        Match(match_node) => return try walk_task_value_and_range(
            file, ast, match_node.value, match_node.arms,
            local_types, tasks, completions
        );,
        MatchArm(match_arm) => return try walk_task_statement(
            file, ast, match_arm.body, local_types, tasks, completions
        );,
        Unsafe(unsafe_node) => return try walk_task_statement(
            file, ast, unsafe_node.body, local_types, tasks, completions
        );,
        Prefix(prefix_node) => return try walk_task_statement(
            file, ast, prefix_node.right, local_types, tasks, completions
        );,
        Binary(binary) => return try walk_task_two(
            file, ast, binary.left, binary.right, local_types, tasks, completions
        );,
        FieldExpr(field_expr_node) => return try walk_task_statement(
            file, ast, field_expr_node.receiver, local_types, tasks, completions
        );,
        DerefExpr(deref_expr_node) => return try walk_task_statement(
            file, ast, deref_expr_node.receiver, local_types, tasks, completions
        );,
        CastExpr(cast_expr) => return try walk_task_statement(
            file, ast, cast_expr.value, local_types, tasks, completions
        );,
        IndexExpr(index_expr) => return try walk_task_three(
            file, ast, index_expr.target, index_expr.start, index_expr.end,
            local_types, tasks, completions
        );,
        StructLiteralExpr(struct_literal) => return try walk_task_range(
            file, ast, struct_literal.fields, local_types, tasks, completions
        );,
        StructFieldInit(struct_field_init) => return try walk_task_statement(
            file, ast, struct_field_init.value, local_types, tasks, completions
        );,
        ArenaNewExpr(arena_new) => return try walk_task_statement(
            file, ast, arena_new.allocator, local_types, tasks, completions
        );,
        TryExpr(try_expr_node) => return try walk_task_statement(
            file, ast, try_expr_node.value, local_types, tasks, completions
        );,
        ComptimeExpr(comptime_expr_node) => return try walk_task_statement(
            file, ast, comptime_expr_node.value, local_types, tasks, completions
        );,
        Call(call_node) => return try walk_task_call(
            file, ast, call_node.callee, call_node.args,
            local_types, tasks, completions
        );,
        _ => return no_concurrency_diagnostic();,
    }
}

fn walk_task_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let found = try walk_task_statement(
            file, ast, child, local_types, tasks, completions
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return no_concurrency_diagnostic();
}

fn walk_task_two(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    let found = try walk_task_statement(
        file, ast, first, local_types, tasks, completions
    );
    if found.found {
        return found;
    }
    return try walk_task_statement(file, ast, second, local_types, tasks, completions);
}

fn walk_task_three(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    let found = try walk_task_two(
        file, ast, first, second, local_types, tasks, completions
    );
    if found.found {
        return found;
    }
    return try walk_task_statement(file, ast, third, local_types, tasks, completions);
}

fn walk_task_value_and_range(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    let found = try walk_task_statement(
        file, ast, value, local_types, tasks, completions
    );
    if found.found {
        return found;
    }
    return try walk_task_range(file, ast, range, local_types, tasks, completions);
}

fn walk_task_let(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    let found = try walk_task_statement(
        file, ast, value, local_types, tasks, completions
    );
    if found.found {
        return found;
    }
    if !(try binds_spawned_task(file, ast, value, local_types)) {
        return no_concurrency_diagnostic();
    }
    let name_node = ast.get(name);
    try tasks.append(TaskBinding {
        name: ast_text::ast_node_text(file, ast, name),
        start: name_node.span.start,
        end: name_node.span.end
    });
    return no_concurrency_diagnostic();
}

fn binds_spawned_task(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !bool {
    let node = ast.get(value);
    match node.data {
        TryExpr(try_expr_node) => return try binds_spawned_task(
            file, ast, try_expr_node.value, local_types
        );,
        Call(call_node) => return try call_spawns_task(
            file, ast, call_node.callee, local_types
        );,
        _ => return false;,
    }
}

fn call_spawns_task(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> !bool {
    let operation = try operation_of(file, ast, callee, local_types);
    return operation == concurrency_contract::op_task_spawn();
}

fn walk_task_call(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    let found = try complete_task_receiver(file, ast, callee, tasks, completions);
    if found.found {
        return found;
    }
    return try walk_task_range(file, ast, args, local_types, tasks, completions);
}

fn complete_task_receiver(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    let base = callee_base(ast, callee);
    let node = ast.get(base);
    match node.data {
        FieldExpr(field_expr_node) => return try complete_task_method(
            file, ast, field_expr_node.namespace,
            field_expr_node.receiver, field_expr_node.name, tasks, completions
        );,
        _ => return no_concurrency_diagnostic();,
    }
}

fn complete_task_method(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    namespace: bool,
    receiver: std::kizu::ast::NodeId,
    name: std::kizu::ast::NodeId,
    tasks: &var std::array::Array<TaskBinding>,
    completions: &var std::array::Array<TaskBinding>
) -> !model::ConcurrencySummary {
    if namespace {
        return no_concurrency_diagnostic();
    }
    if !concurrency_contract::completes_task(
        intrinsic_type_contract::kind_task(),
        ast_text::ast_node_text(file, ast, name)
    ) {
        return no_concurrency_diagnostic();
    }
    let receiver_name = variable_name(file, ast, receiver);
    if std::mem::len(receiver_name) == 0 {
        return no_concurrency_diagnostic();
    }
    if !(try task_names_contain(tasks, receiver_name)) {
        return no_concurrency_diagnostic();
    }
    let node = ast.get(receiver);
    if try names_contain(completions, receiver_name) {
        return diagnostic(
            kind_task_completed(), node.span.start, node.span.end, receiver_name, ""
        );
    }
    try completions.append(TaskBinding {
        name: receiver_name,
        start: node.span.start,
        end: node.span.end
    });
    return no_concurrency_diagnostic();
}
