import selfhost::ir::intrinsic_type_contract;

// A raw pointer spelling applies the intrinsic pointer constructor to one type
// argument, optionally behind the nullable marker: `ptr<T>` or `?ptr<T>`. The
// constructor identity comes from selfhost::ir::intrinsic_type_contract, so this module
// never decides pointer-ness by comparing a spelling against a name of its own.
//
// `const` marks the pointee, not the pointer: it is a property of the type argument,
// which is why the accessors below answer about the pointee separately.

fn nullable_marker() -> u8 { return cast<u8>(63); }
fn arguments_open() -> u8 { return cast<u8>(60); }
fn arguments_close() -> u8 { return cast<u8>(62); }

pub fn is_nullable(spelling: []u8) -> bool {
    if std::mem::len(spelling) < 1 {
        return false;
    }
    return spelling[0] == nullable_marker();
}

// pointee_start reports where a raw pointer spelling's single type argument begins, or
// -1 when the spelling does not apply the intrinsic pointer constructor.
fn pointee_start(spelling: []u8) -> i64 {
    let length = std::mem::len(spelling);
    var index = 0;
    if is_nullable(spelling) {
        index = 1;
    }
    let constructor_start = index;
    while index < length and spelling[index] != arguments_open() {
        index = index + 1;
    }
    if index >= length or spelling[length - 1] != arguments_close() {
        return -1;
    }
    let constructor = spelling[constructor_start..index];
    if intrinsic_type_contract::from_source_name(constructor) !=
        intrinsic_type_contract::kind_ptr() {
        return -1;
    }
    return index + 1;
}

pub fn is_raw_pointer(spelling: []u8) -> bool {
    return pointee_start(spelling) >= 0;
}

// pointee answers with the type argument as written, `const` marker included. A
// spelling that is not a raw pointer answers with an empty view of itself.
pub fn pointee(spelling: []u8) -> []u8 borrows spelling {
    let start = pointee_start(spelling);
    if start < 0 {
        return spelling[0..0];
    }
    return std::mem::trim_ascii(spelling[start..std::mem::len(spelling) - 1]);
}

// A `const` pointee may be read through but never written through.
pub fn pointee_is_const(pointee_spelling: []u8) -> bool {
    let marker = "const ";
    let marker_len = std::mem::len(marker);
    if std::mem::len(pointee_spelling) < marker_len {
        return false;
    }
    var index = 0;
    while index < marker_len {
        if pointee_spelling[index] != marker[index] {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// pointee_value_type drops the `const` marker: the value read through a pointer has the
// pointee's type, and read-only-ness is a property of the access, not of the value.
pub fn pointee_value_type(pointee_spelling: []u8) -> []u8 borrows pointee_spelling {
    if !pointee_is_const(pointee_spelling) {
        return pointee_spelling;
    }
    return std::mem::trim_ascii(
        pointee_spelling[std::mem::len("const ")..std::mem::len(pointee_spelling)]
    );
}
