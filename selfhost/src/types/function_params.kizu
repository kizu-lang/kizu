import selfhost::source;
import selfhost::type_spelling;
import selfhost::types::ast_text;
import selfhost::types::type_parameter_scope;

pub struct FunctionParamType {
    pub function_name: []u8,
    pub index: i64,
    pub type_name: []u8,
}

pub struct FunctionParamLookup {
    pub found: bool,
    pub type_name: []u8,
}

// BorrowArgumentView is one call argument paired with the type it is measured against,
// after the borrow operator a borrow parameter is filled with has been removed from both.
pub struct BorrowArgumentView {
    pub node: std::kizu::ast::NodeId,
    pub type_name: []u8,
}

pub fn collect_local_function_param_types(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return collect_local_function_param_types_in_range(
            allocator,
            file,
            ast,
            program.declarations,
            param_types
        );,
        FnDecl(fn_decl) => return collect_function_param_types(
            allocator,
            file,
            ast,
            ast_text::ast_node_text(file, ast, fn_decl.name),
            fn_decl.type_params,
            fn_decl.params,
            param_types
        );,
        _ => return;,
    }
}

pub fn lookup_function_param_type(
    param_types: &std::array::Array<FunctionParamType>,
    function_name: []u8,
    param_index: i64
) -> !FunctionParamLookup {
    var index = 0;
    while index < param_types.len() {
        let param_type = try param_types.at(index);
        if std::mem::equal_bytes(param_type.function_name, function_name) and
            param_type.index == param_index {
            return function_param_lookup(true, param_type.type_name);
        }
        index = index + 1;
    }
    return function_param_lookup(false, "");
}

// borrow_argument_view pairs a call argument with the parameter it fills. A borrow
// parameter is filled by writing the borrow operator at the call site, and that operator
// is what matches the parameter's borrow layer: the value that flows in is the borrowed
// operand, measured against the parameter's element type
// (internal/types/checker.go:6592). Every other argument is measured as written.
pub fn borrow_argument_view(
    ast: std::kizu::ast::Ast,
    arg: std::kizu::ast::NodeId,
    declared: []u8
) -> !BorrowArgumentView {
    let layer = try type_spelling::parse(declared);
    if layer.kind != type_spelling::layer_borrow() and
        layer.kind != type_spelling::layer_borrow_var() {
        return borrow_argument_view_of(arg, declared);
    }
    let node = ast.get(arg);
    match node.data {
        Prefix(prefix_node) => return borrowed_operand_view(
            prefix_node.op,
            prefix_node.right,
            arg,
            try type_spelling::first_child(&layer, declared),
            declared
        );,
        _ => return borrow_argument_view_of(arg, declared);,
    }
    return borrow_argument_view_of(arg, declared);
}

fn borrowed_operand_view(
    op: std::kizu::ast::PrefixOp,
    right: std::kizu::ast::NodeId,
    arg: std::kizu::ast::NodeId,
    element: []u8,
    declared: []u8
) -> BorrowArgumentView {
    match op {
        Borrow => return borrow_argument_view_of(right, element);,
        MutBorrow => return borrow_argument_view_of(right, element);,
        _ => return borrow_argument_view_of(arg, declared);,
    }
}

fn borrow_argument_view_of(
    node: std::kizu::ast::NodeId,
    type_name: []u8
) -> BorrowArgumentView {
    return BorrowArgumentView { node: node, type_name: type_name };
}

fn collect_local_function_param_types_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_local_function_param_types(allocator, file, ast, child, param_types);
        index = index + 1;
    }
    return;
}

fn collect_function_param_types(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        try collect_function_param_type(
            file, ast, function_name, type_params, child, index, param_types
        );
        index = index + 1;
    }
    return;
}

fn collect_function_param_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    type_params: std::kizu::ast::ChildRange,
    node_id: std::kizu::ast::NodeId,
    param_index: i64,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return collect_function_param_node_type(
            file,
            ast,
            function_name,
            type_params,
            param_node.type_node,
            param_index,
            param_types
        );,
        _ => return;,
    }
}

fn collect_function_param_node_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    function_name: []u8,
    type_params: std::kizu::ast::ChildRange,
    type_node: std::kizu::ast::NodeId,
    param_index: i64,
    param_types: &var std::array::Array<FunctionParamType>
) -> !void {
    try param_types.append(function_param_type(
        function_name,
        param_index,
        try type_parameter_scope::declared_type_text(
            file,
            ast,
            type_params,
            ast_text::ast_return_type_text(file, ast, type_node)
        )
    ));
    return;
}

fn function_param_type(
    function_name: []u8,
    index: i64,
    type_name: []u8
) -> FunctionParamType {
    return FunctionParamType {
        function_name: function_name,
        index: index,
        type_name: type_name
    };
}

fn function_param_lookup(found: bool, type_name: []u8) -> FunctionParamLookup {
    return FunctionParamLookup {
        found: found,
        type_name: type_name
    };
}
