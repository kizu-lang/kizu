import selfhost::types::expression_facts;
import selfhost::source;
import selfhost::type_constructor;
import selfhost::type_spelling;
import selfhost::types::ast_text;

pub fn infer_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    let node = ast.get(node_id);
    match node.data {
        Int(int_node) => return "i64";,
        String(string_node) => return "[]u8";,
        Bool(bool_node) => return "bool";,
        Empty => return "void";,
        Var(var_node) => return infer_var_expression_type(file, ast, node_id, local_types);,
        Binary(binary) => return binary_expression_type(binary.op);,
        Prefix(prefix_node) => return prefix_expression_type(prefix_node.op);,
        CastExpr(cast_expr) => return ast_text::ast_return_type_text(file, ast, cast_expr.type_node);,
        ComptimeExpr(comptime_expr_node) => return infer_expression_type(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            local_types,
            function_returns
        );,
        TryExpr(try_expr_node) => return try success_type_of(try infer_expression_type(
            allocator,
            file,
            ast,
            try_expr_node.value,
            local_types,
            function_returns
        ));,
        FieldExpr(field_expr_node) => return try field_expression_type(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            field_expr_node.namespace,
            field_expr_node.name,
            local_types,
            function_returns
        );,
        DerefExpr(deref_expr_node) => return "unknown";,
        Call(call_node) => return call_expression_type(
            allocator,
            file,
            ast,
            call_node.callee,
            local_types,
            function_returns
        );,
        TypeApplyExpr(type_apply) => return declared_expression_type_fact(
            allocator,
            file,
            ast,
            node_id,
            function_returns
        );,
        IndexExpr(index_expr) => return index_expression_type(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.slice,
            local_types,
            function_returns
        );,
        StructLiteralExpr(struct_literal) => return ast_text::ast_node_text(file, ast, struct_literal.type_name);,
        StructFieldInit(struct_field_init) => return "unknown";,
        ArenaNewExpr(arena_new) => return arena_expression_type(file, ast, arena_new.type_node);,
        Block(block) => return "unknown";,
        If(if_node) => return "unknown";,
        Let(let_node) => return "unknown";,
        Assign(assign_node) => return "unknown";,
        Return(return_node) => return "unknown";,
        Defer(defer_node) => return "unknown";,
        ErrDefer(err_defer_node) => return "unknown";,
        ExprStmt(expr_stmt) => return "unknown";,
        While(while_node) => return "unknown";,
        For(for_node) => return "unknown";,
        Break(break_node) => return "void";,
        Continue(continue_node) => return "void";,
        Program(program) => return "unknown";,
        ImportDecl(import_decl) => return "unknown";,
        Param(param_node) => return "unknown";,
        Field(field_node) => return "unknown";,
        StructDecl(struct_decl) => return "unknown";,
        EnumDecl(enum_decl) => return "unknown";,
        UnionDecl(union_decl) => return "unknown";,
        ImplDecl(impl_decl) => return "unknown";,
        UnionVariant(union_variant) => return "unknown";,
        Match(match_node) => return infer_match_expression_type(
            allocator,
            file,
            ast,
            match_node.arms,
            local_types,
            function_returns
        );,
        MatchArm(match_arm) => return "unknown";,
        Unsafe(unsafe_node) => return "unknown";,
        ComptimeIf(comptime_if_node) => return "unknown";,
        FnDecl(fn_decl) => return "unknown";,
        TypeName(type_name) => return ast_text::ast_node_text(file, ast, node_id);,
    }
}

fn infer_match_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    arms: std::kizu::ast::ChildRange,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    var result = "unknown";
    var index = 0;
    while index < arms.len {
        let child = try ast.child_at(arms, index);
        let arm_type = try infer_match_arm_expression_type(
            allocator,
            file,
            ast,
            child,
            local_types,
            function_returns
        );
        if std::mem::equal_bytes(result, "unknown") {
            result = arm_type;
        } else {
            if known_type_mismatch(result, arm_type) {
                return "unknown";
            }
        }
        index = index + 1;
    }
    return result;
}

fn infer_match_arm_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    let node = ast.get(node_id);
    match node.data {
        MatchArm(match_arm) => return infer_match_arm_body_expression_type(
            allocator,
            file,
            ast,
            match_arm.body,
            local_types,
            function_returns
        );,
        _ => return "unknown";,
    }
}

fn infer_match_arm_body_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    let node = ast.get(node_id);
    match node.data {
        ExprStmt(expr_stmt) => return infer_expression_type(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            local_types,
            function_returns
        );,
        Empty => return "void";,
        _ => return "unknown";,
    }
}

fn success_type_of(value_type: []u8) -> ![]u8 borrows value_type {
    let layer = try type_spelling::parse(value_type);
    if layer.kind == type_spelling::layer_error_union() {
        return try type_spelling::second_child(&layer, value_type);
    }
    return value_type;
}

fn field_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    receiver: std::kizu::ast::NodeId,
    namespace: bool,
    name: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    if namespace {
        let receiver_text = ast_text::ast_node_text(file, ast, receiver);
        if last_segment_starts_with_uppercase(receiver_text) {
            return resolved_declared_nominal_type(
                allocator, file, receiver_text, function_returns
            );
        }
    }
    let receiver_type = try infer_expression_type(
        allocator,
        file,
        ast,
        receiver,
        local_types,
        function_returns
    );
    let field = ast_text::ast_node_text(file, ast, name);
    let lookup_receiver_type = try field_receiver_value_type(receiver_type);
    let struct_field = try struct_field_declared_type(
        allocator,
        file,
        lookup_receiver_type,
        field,
        function_returns
    );
    if !std::mem::equal_bytes(struct_field, "unknown") {
        return struct_field;
    }
    let typed_field = typed_field_name_type(lookup_receiver_type, field);
    if !std::mem::equal_bytes(typed_field, "unknown") {
        return typed_field;
    }
    return "unknown";
}

// Namespace enum/union values carry the exact declared nominal owner. Source
// aliases are only spellings; returning one as a type would make an imported
// `module::Enum::Tag` differ from the canonical type stored on struct fields.
pub fn resolved_declared_nominal_type(
    allocator: Allocator,
    file: &source::SourceFile,
    type_name: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    var declared_key = std::string::String(allocator);
    try declared_key.append_bytes("tn ");
    try append_resolved_nominal_type(
        declared_key, allocator, file, type_name, function_returns
    );
    let declared_key_bytes = declared_key.as_bytes();
    var result = type_name;
    if function_returns.contains_source(&declared_key_bytes) {
        result = try function_returns.get_source(&declared_key_bytes);
    }
    declared_key.deinit();
    return result;
}

// Field access auto-dereferences shared and mutable borrows. Normalize that
// receiver shape once so typed compiler structs and declared user structs use
// the same lookup identity.
fn field_receiver_value_type(
    receiver_type: []u8
) -> ![]u8 borrows receiver_type {
    let value_type = std::mem::trim_ascii(receiver_type);
    let layer = try type_spelling::parse(value_type);
    if layer.kind != type_spelling::layer_borrow() and
        layer.kind != type_spelling::layer_borrow_var() {
        return value_type;
    }
    let child = try type_spelling::first_child(&layer, value_type);
    return field_receiver_value_type(child);
}

// Resolve a field access against a user-declared struct's real field type.
// Struct field facts are collected into function_returns under keys built by
// append_struct_field_key (see checker.kizu collect_struct_resolution_facts_*).
// Exact declared fields run before compiler builtin and field-name inference,
// so a declared owner can never be reclassified by a same-spelled field.
fn struct_field_declared_type(
    allocator: Allocator,
    file: &source::SourceFile,
    receiver_type: []u8,
    field: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 borrows function_returns {
    var key = std::string::String(allocator);
    defer key.deinit();
    try append_struct_field_key(
        key, allocator, file, receiver_type, field, function_returns
    );
    let key_bytes = key.as_bytes();
    if function_returns.contains_field(&key_bytes) {
        return try function_returns.get_field(&key_bytes);
    }
    return "unknown";
}

// Build the lookup key for a struct field fact. The leading "sf " tag and the
// space separators cannot appear in a function name (function_returns' other
// keys are module::name with no spaces), so the two key spaces never collide.
pub fn append_struct_field_key(
    key: &var std::string::String,
    allocator: Allocator,
    file: &source::SourceFile,
    struct_name: []u8,
    field: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try key.append_bytes("sf ");
    try append_resolved_nominal_type(
        key, allocator, file, struct_name, function_returns
    );
    try key.append_bytes(" ");
    try key.append_bytes(field);
    return;
}

pub fn append_resolved_nominal_type(
    out: &var std::string::String,
    allocator: Allocator,
    file: &source::SourceFile,
    type_name: []u8,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    if source::is_absolute_name_for_file(file, type_name) {
        try out.append_bytes(type_name);
        return;
    }
    if ast_text::is_qualified_name(type_name) {
        let alias_end = first_qualified_segment_end(type_name);
        let alias = type_name[0..alias_end];
        var alias_key = std::string::String(allocator);
        defer alias_key.deinit();
        try append_struct_import_alias_key(alias_key, file, alias);
        let alias_key_bytes = alias_key.as_bytes();
        if facts.contains_source(&alias_key_bytes) {
            try out.append_bytes(try facts.get_source(&alias_key_bytes));
            try out.append_bytes(type_name[alias_end..std::mem::len(type_name)]);
            return;
        }
        try source::append_package_prefix(out, file);
        try out.append_bytes("::");
        try out.append_bytes(type_name);
        return;
    }
    try source::append_qualified_module_name(out, file);
    try out.append_bytes("::");
    try out.append_bytes(type_name);
    return;
}

pub fn build_canonical_type_spelling(
    allocator: Allocator,
    file: &source::SourceFile,
    spelling: []u8,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !std::string::String {
    var out = std::string::String(allocator);
    errdefer out.deinit();
    try append_canonical_type_spelling(
        &var out, allocator, file, std::mem::trim_ascii(spelling), facts
    );
    return out;
}

fn append_canonical_type_spelling(
    out: &var std::string::String,
    allocator: Allocator,
    file: &source::SourceFile,
    spelling: []u8,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let type_name = std::mem::trim_ascii(spelling);
    let layer = try type_spelling::parse(type_name);
    if layer.kind == type_spelling::layer_named() {
        return append_canonical_named_type(
            out, allocator, file, type_name, &layer, facts
        );
    }
    if layer.kind == type_spelling::layer_error_union() {
        let error_type = try type_spelling::first_child(&layer, type_name);
        let success_type = try type_spelling::second_child(&layer, type_name);
        if std::mem::len(error_type) > 0 {
            try append_canonical_type_spelling(
                out, allocator, file, error_type, facts
            );
        }
        try out.append_bytes("!");
        return append_canonical_type_spelling(
            out, allocator, file, success_type, facts
        );
    }
    try append_type_wrapper(out, layer.kind);
    return append_canonical_type_spelling(
        out,
        allocator,
        file,
        try type_spelling::first_child(&layer, type_name),
        facts
    );
}

fn append_canonical_named_type(
    out: &var std::string::String,
    allocator: Allocator,
    file: &source::SourceFile,
    spelling: []u8,
    layer: &type_spelling::TypeLayer,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try append_declared_nominal_if_known(
        out,
        allocator,
        file,
        try type_spelling::constructor(layer, spelling),
        facts
    );
    if !layer.has_arguments { return; }
    try out.append_bytes("<");
    let arguments = try type_spelling::arguments(layer, spelling);
    var start = 0;
    while start < std::mem::len(arguments) {
        if start > 0 { try out.append_bytes(", "); }
        try append_canonical_type_spelling(
            out,
            allocator,
            file,
            try type_spelling::next_argument(arguments, start),
            facts
        );
        start = try type_spelling::next_argument_start(arguments, start);
    }
    try out.append_bytes(">");
    return;
}

fn append_declared_nominal_if_known(
    out: &var std::string::String,
    allocator: Allocator,
    file: &source::SourceFile,
    type_name: []u8,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var resolved = std::string::String(allocator);
    defer resolved.deinit();
    try append_resolved_nominal_type(
        resolved, allocator, file, type_name, facts
    );
    var type_key = std::string::String(allocator);
    defer type_key.deinit();
    try type_key.append_bytes("tn ");
    let resolved_bytes = resolved.as_bytes();
    try type_key.append_bytes(resolved_bytes);
    let type_key_bytes = type_key.as_bytes();
    if facts.contains_source(&type_key_bytes) {
        try out.append_bytes(resolved_bytes);
        return;
    }
    try out.append_bytes(type_name);
    return;
}

fn append_type_wrapper(
    out: &var std::string::String,
    kind: i64
) -> !void {
    if kind == type_spelling::layer_borrow() {
        try out.append_bytes("&");
        return;
    }
    if kind == type_spelling::layer_borrow_var() {
        try out.append_bytes("&var ");
        return;
    }
    if kind == type_spelling::layer_slice() {
        try out.append_bytes("[]");
        return;
    }
    if kind == type_spelling::layer_nullable() {
        try out.append_bytes("?");
        return;
    }
    if kind == type_spelling::layer_dynamic() {
        try out.append_bytes("dyn ");
        return;
    }
    if kind == type_spelling::layer_const() {
        try out.append_bytes("const ");
        return;
    }
    return error("unknown type spelling wrapper");
}

pub fn append_struct_import_alias_key(
    out: &var std::string::String,
    file: &source::SourceFile,
    alias: []u8
) -> !void {
    try out.append_bytes("sa ");
    try source::append_qualified_module_name(out, file);
    try out.append_bytes(" ");
    try out.append_bytes(alias);
    return;
}

pub fn append_param_type_key(
    out: &var std::string::String,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    param_node: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(param_node);
    try out.append_bytes("pt ");
    try source::append_qualified_module_name(out, file);
    try out.append_bytes(" ");
    try std::fmt::append_i64(out, node.span.start);
    try out.append_bytes(" ");
    try std::fmt::append_i64(out, node.span.end);
    return;
}

pub fn collect_declared_expression_type_facts(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(value) => return collect_declared_expression_type_range(
            allocator, file, ast, value.declarations, facts
        );,
        ImportDecl(value) => return;,
        StructDecl(value) => return collect_declared_expression_type_ranges(
            allocator, file, ast, value.type_params, value.fields, facts
        );,
        EnumDecl(value) => return collect_declared_expression_type_range(
            allocator, file, ast, value.tags, facts
        );,
        UnionDecl(value) => return collect_declared_expression_type_ranges(
            allocator, file, ast, value.type_params, value.variants, facts
        );,
        ImplDecl(value) => return collect_declared_expression_type_one_range(
            allocator, file, ast, value.type_name, value.methods, facts
        );,
        UnionVariant(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.payload, facts
        );,
        FnDecl(value) => return collect_declared_expression_type_fn(
            allocator,
            file,
            ast,
            value.type_params,
            value.params,
            value.body,
            facts
        );,
        Param(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.type_node, facts
        );,
        Field(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.type_node, facts
        );,
        Block(value) => return collect_declared_expression_type_range(
            allocator, file, ast, value.statements, facts
        );,
        Let(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.value, facts
        );,
        Assign(value) => return collect_declared_expression_type_two(
            allocator, file, ast, value.target, value.value, facts
        );,
        Return(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.value, facts
        );,
        Defer(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.expr, facts
        );,
        ErrDefer(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.expr, facts
        );,
        ExprStmt(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.expr, facts
        );,
        If(value) => return collect_declared_expression_type_three(
            allocator,
            file,
            ast,
            value.condition,
            value.then_block,
            value.else_block,
            facts
        );,
        While(value) => return collect_declared_expression_type_two(
            allocator, file, ast, value.condition, value.body, facts
        );,
        For(value) => return collect_declared_expression_type_three(
            allocator, file, ast, value.start, value.end, value.body, facts
        );,
        Break(value) => return;,
        Continue(value) => return;,
        Match(value) => return collect_declared_expression_type_one_range(
            allocator, file, ast, value.value, value.arms, facts
        );,
        MatchArm(value) => return collect_declared_expression_type_three(
            allocator, file, ast, value.pattern, value.binding, value.body, facts
        );,
        Unsafe(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.body, facts
        );,
        ComptimeIf(value) => return collect_declared_expression_type_three(
            allocator,
            file,
            ast,
            value.condition,
            value.then_block,
            value.else_block,
            facts
        );,
        Prefix(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.right, facts
        );,
        Binary(value) => return collect_declared_expression_type_two(
            allocator, file, ast, value.left, value.right, facts
        );,
        FieldExpr(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.receiver, facts
        );,
        DerefExpr(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.receiver, facts
        );,
        Call(value) => return collect_declared_expression_type_one_range(
            allocator, file, ast, value.callee, value.args, facts
        );,
        TypeApplyExpr(value) => return collect_type_apply_expression_fact(
            allocator,
            file,
            ast,
            node_id,
            value.callee,
            value.type_args,
            facts
        );,
        CastExpr(value) => return collect_declared_expression_type_two(
            allocator, file, ast, value.type_node, value.value, facts
        );,
        IndexExpr(value) => return collect_declared_expression_type_three(
            allocator, file, ast, value.target, value.start, value.end, facts
        );,
        StructLiteralExpr(value) => return collect_declared_expression_type_one_range(
            allocator, file, ast, value.type_name, value.fields, facts
        );,
        StructFieldInit(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.value, facts
        );,
        ArenaNewExpr(value) => return collect_declared_expression_type_two(
            allocator, file, ast, value.type_node, value.allocator, facts
        );,
        TryExpr(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.value, facts
        );,
        ComptimeExpr(value) => return collect_declared_expression_type_facts(
            allocator, file, ast, value.value, facts
        );,
        TypeName(value) => return;,
        Var(value) => return;,
        Int(value) => return;,
        String(value) => return;,
        Bool(value) => return;,
        Empty => return;,
    }
}

fn collect_type_apply_expression_fact(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var key = std::string::String(allocator);
    defer key.deinit();
    try append_expression_type_key(key, file, &ast, node_id);
    let key_bytes = key.as_bytes();
    if !facts.contains_source(&key_bytes) {
        var canonical_type = try build_canonical_type_spelling(
            allocator,
            file,
            ast_text::ast_node_text(file, ast, node_id),
            facts
        );
        defer canonical_type.deinit();
        try facts.insert_source_owned(&key_bytes, &canonical_type);
    }
    return collect_declared_expression_type_one_range(
        allocator, file, ast, callee, type_args, facts
    );
}

fn declared_expression_type_fact(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    facts: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 borrows facts {
    var key = std::string::String(allocator);
    defer key.deinit();
    try append_expression_type_key(key, file, &ast, node_id);
    let key_bytes = key.as_bytes();
    if !facts.contains_source(&key_bytes) {
        return error("canonical expression type fact missing");
    }
    return try facts.get_source(&key_bytes);
}

fn append_expression_type_key(
    out: &var std::string::String,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !void {
    let node = ast.get(node_id);
    try out.append_bytes("et ");
    try source::append_qualified_module_name(out, file);
    try out.append_bytes(" ");
    try std::fmt::append_i64(out, node.span.start);
    try out.append_bytes(" ");
    try std::fmt::append_i64(out, node.span.end);
    return;
}

fn collect_declared_expression_type_fn(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_params: std::kizu::ast::ChildRange,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try collect_declared_expression_type_range(
        allocator, file, ast, type_params, facts
    );
    try collect_declared_expression_type_range(
        allocator, file, ast, params, facts
    );
    return collect_declared_expression_type_facts(
        allocator, file, ast, body, facts
    );
}

fn collect_declared_expression_type_ranges(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::ChildRange,
    second: std::kizu::ast::ChildRange,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try collect_declared_expression_type_range(
        allocator, file, ast, first, facts
    );
    return collect_declared_expression_type_range(
        allocator, file, ast, second, facts
    );
}

fn collect_declared_expression_type_one_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try collect_declared_expression_type_facts(
        allocator, file, ast, node_id, facts
    );
    return collect_declared_expression_type_range(
        allocator, file, ast, range, facts
    );
}

fn collect_declared_expression_type_two(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try collect_declared_expression_type_facts(
        allocator, file, ast, first, facts
    );
    return collect_declared_expression_type_facts(
        allocator, file, ast, second, facts
    );
}

fn collect_declared_expression_type_three(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    try collect_declared_expression_type_two(
        allocator, file, ast, first, second, facts
    );
    return collect_declared_expression_type_facts(
        allocator, file, ast, third, facts
    );
}

fn collect_declared_expression_type_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    facts: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        try collect_declared_expression_type_facts(
            allocator, file, ast, child, facts
        );
        index = index + 1;
    }
    return;
}

fn first_qualified_segment_end(name: []u8) -> i64 {
    var index = 0;
    while index + 1 < std::mem::len(name) {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            return index;
        }
        index = index + 1;
    }
    return std::mem::len(name);
}

fn typed_field_name_type(receiver_type: []u8, field: []u8) -> []u8 {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::AstNode") {
        if std::mem::equal_bytes(field, "span") { return "std::kizu::ast::Span"; }
        if std::mem::equal_bytes(field, "data") { return "std::kizu::ast::AstData"; }
    }
    let component_signature_field = component_function_signature_field_type(
        receiver_type,
        field
    );
    if !std::mem::equal_bytes(component_signature_field, "unknown") {
        return component_signature_field;
    }
    if ast_node_id_field_type(receiver_type, field) {
        return "std::kizu::ast::NodeId";
    }
    if ast_child_range_field_type(receiver_type, field) {
        return "std::kizu::ast::ChildRange";
    }
    if ast_bool_field_type(receiver_type, field) {
        return "bool";
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::PrefixNode") and
        std::mem::equal_bytes(field, "op") {
        return "std::kizu::ast::PrefixOp";
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::BinaryNode") and
        std::mem::equal_bytes(field, "op") {
        return "std::kizu::ast::BinaryOp";
    }
    return "unknown";
}

fn component_function_signature_field_type(receiver_type: []u8, field: []u8) -> []u8 {
    if std::mem::equal_bytes(receiver_type, "ComponentFunctionSignature") or
        std::mem::equal_bytes(
            receiver_type,
            "selfhost::ir::component_function_catalog::ComponentFunctionSignature"
        ) {
        if std::mem::equal_bytes(field, "params") {
            return "std::kizu::ast::ChildRange";
        }
        if std::mem::equal_bytes(field, "return_type") {
            return "std::kizu::ast::NodeId";
        }
    }
    return "unknown";
}

fn ast_node_id_field_type(receiver_type: []u8, field: []u8) -> bool {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::FnDeclNode") {
        return std::mem::equal_bytes(field, "extern_abi") or
            std::mem::equal_bytes(field, "name") or
            std::mem::equal_bytes(field, "return_type") or
            std::mem::equal_bytes(field, "return_borrow") or
            std::mem::equal_bytes(field, "body");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::StructDeclNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::EnumDeclNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::UnionDeclNode") {
        return std::mem::equal_bytes(field, "name");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::UnionVariantNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::ParamNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::FieldNode") {
        return std::mem::equal_bytes(field, "name") or std::mem::equal_bytes(field, "type_node") or
            std::mem::equal_bytes(field, "payload");
    }
    return ast_node_id_expression_field_type(receiver_type, field);
}

fn ast_node_id_expression_field_type(receiver_type: []u8, field: []u8) -> bool {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::PrefixNode") {
        return std::mem::equal_bytes(field, "right");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::BinaryNode") {
        return std::mem::equal_bytes(field, "left") or std::mem::equal_bytes(field, "right");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::FieldExprNode") {
        return std::mem::equal_bytes(field, "receiver") or std::mem::equal_bytes(field, "name");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::DerefExprNode") {
        return std::mem::equal_bytes(field, "receiver");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::CallNode") {
        return std::mem::equal_bytes(field, "callee");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::TypeApplyExprNode") {
        return std::mem::equal_bytes(field, "callee");
    }
    return ast_node_id_statement_field_type(receiver_type, field);
}

fn ast_node_id_statement_field_type(receiver_type: []u8, field: []u8) -> bool {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::CastExprNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::ArenaNewExprNode") {
        return std::mem::equal_bytes(field, "type_node") or std::mem::equal_bytes(field, "value") or
            std::mem::equal_bytes(field, "allocator");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::IndexExprNode") {
        return std::mem::equal_bytes(field, "target") or std::mem::equal_bytes(field, "start") or
            std::mem::equal_bytes(field, "end");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::StructLiteralExprNode") {
        return std::mem::equal_bytes(field, "type_name");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::StructFieldInitNode") {
        return std::mem::equal_bytes(field, "name") or std::mem::equal_bytes(field, "value");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::TryExprNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::ComptimeExprNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::ReturnNode") {
        return std::mem::equal_bytes(field, "value");
    }
    return ast_node_id_control_field_type(receiver_type, field);
}

fn ast_node_id_control_field_type(receiver_type: []u8, field: []u8) -> bool {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::LetNode") {
        return std::mem::equal_bytes(field, "name") or std::mem::equal_bytes(field, "value");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::AssignNode") {
        return std::mem::equal_bytes(field, "target") or std::mem::equal_bytes(field, "value");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::DeferNode") {
        return std::mem::equal_bytes(field, "expr");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::ExprStmtNode") {
        return std::mem::equal_bytes(field, "expr");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::IfNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::ComptimeIfNode") {
        return std::mem::equal_bytes(field, "condition") or
            std::mem::equal_bytes(field, "then_block") or
            std::mem::equal_bytes(field, "else_block");
    }
    return ast_node_id_loop_match_field_type(receiver_type, field);
}

fn ast_node_id_loop_match_field_type(receiver_type: []u8, field: []u8) -> bool {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::WhileNode") {
        return std::mem::equal_bytes(field, "label") or
            std::mem::equal_bytes(field, "condition") or
            std::mem::equal_bytes(field, "body");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::ForNode") {
        return std::mem::equal_bytes(field, "label") or std::mem::equal_bytes(field, "name") or
            std::mem::equal_bytes(field, "start") or std::mem::equal_bytes(field, "end") or
            std::mem::equal_bytes(field, "body");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::BreakNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::ContinueNode") {
        return std::mem::equal_bytes(field, "label");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::MatchNode") {
        return std::mem::equal_bytes(field, "value");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::MatchArmNode") {
        return std::mem::equal_bytes(field, "pattern") or
            std::mem::equal_bytes(field, "binding") or
            std::mem::equal_bytes(field, "body");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::UnsafeNode") {
        return std::mem::equal_bytes(field, "body");
    }
    return false;
}

fn ast_child_range_field_type(receiver_type: []u8, field: []u8) -> bool {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::ProgramNode") {
        return std::mem::equal_bytes(field, "declarations");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::FnDeclNode") {
        return std::mem::equal_bytes(field, "type_params") or
            std::mem::equal_bytes(field, "params");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::UnsafeNode") {
        return std::mem::equal_bytes(field, "capabilities");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::StructDeclNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::UnionDeclNode") {
        return std::mem::equal_bytes(field, "type_params") or
            std::mem::equal_bytes(field, "fields") or
            std::mem::equal_bytes(field, "variants");
    }
    return ast_child_range_expression_field_type(receiver_type, field);
}

fn ast_child_range_expression_field_type(receiver_type: []u8, field: []u8) -> bool {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::EnumDeclNode") {
        return std::mem::equal_bytes(field, "tags");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::ImportDeclNode") {
        return std::mem::equal_bytes(field, "path");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::BlockNode") {
        return std::mem::equal_bytes(field, "statements");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::CallNode") {
        return std::mem::equal_bytes(field, "args");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::TypeApplyExprNode") {
        return std::mem::equal_bytes(field, "type_args");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::StructLiteralExprNode") {
        return std::mem::equal_bytes(field, "fields");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::MatchNode") {
        return std::mem::equal_bytes(field, "arms");
    }
    return false;
}

fn ast_bool_field_type(receiver_type: []u8, field: []u8) -> bool {
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::BoolNode") {
        return std::mem::equal_bytes(field, "value");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::FieldExprNode") {
        return std::mem::equal_bytes(field, "namespace");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::IndexExprNode") {
        return std::mem::equal_bytes(field, "slice");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::LetNode") {
        return std::mem::equal_bytes(field, "mutable");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::ParamNode") {
        return std::mem::equal_bytes(field, "comptime_param");
    }
    if std::mem::equal_bytes(receiver_type, "std::kizu::ast::FieldNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::StructDeclNode") or
        std::mem::equal_bytes(receiver_type, "std::kizu::ast::FnDeclNode") {
        return std::mem::equal_bytes(field, "public") or
            std::mem::equal_bytes(field, "requires_unsafe");
    }
    return false;
}

fn call_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    let callee_text = ast_text::ast_node_text(file, ast, callee);
    if try is_generic_constructor_text(callee_text) {
        return declared_expression_type_fact(
            allocator,
            file,
            ast,
            callee,
            function_returns
        );
    }
    let method_type = try method_call_text_type(callee_text, local_types);
    if !std::mem::equal_bytes(method_type, "unknown") {
        return method_type;
    }
    return resolved_function_return_type(allocator, file, callee_text, function_returns);
}

fn index_expression_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    target: std::kizu::ast::NodeId,
    slice: bool,
    local_types: &std::map::Map<[]u8, []u8>,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    let target_type = try infer_expression_type(
        allocator,
        file,
        ast,
        target,
        local_types,
        function_returns
    );
    if slice {
        if is_u8_slice(target_type) {
            return "[]u8";
        }
        if std::mem::starts_with(target_type, "[]") {
            return target_type;
        }
        return "unknown";
    }
    if is_u8_slice(target_type) {
        return "u8";
    }
    return "unknown";
}

fn arena_expression_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId
) -> []u8 {
    let type_name = ast_text::ast_node_text(file, ast, type_node);
    if std::mem::equal_bytes(type_name, "") {
        return "unknown";
    }
    return "unknown";
}

fn method_call_text_type(
    callee: []u8,
    local_types: &std::map::Map<[]u8, []u8>
) -> ![]u8 {
    let method = last_field_segment(callee);
    var receiver_type = "unknown";
    var last_dot = -1;
    var index = 0;
    while index < std::mem::len(callee) {
        if callee[index] == cast<u8>(46) {
            last_dot = index;
        }
        index = index + 1;
    }
    if last_dot > 0 {
        let receiver = callee[0..last_dot];
        if local_types.contains(receiver) {
            receiver_type = try local_types.get(receiver);
        }
    }
    return try method_return_type(method, receiver_type);
}

fn last_field_segment(text: []u8) -> []u8 {
    var start = 0;
    var index = 0;
    while index < std::mem::len(text) {
        if text[index] == cast<u8>(46) {
            start = index + 1;
        }
        index = index + 1;
    }
    return text[start..std::mem::len(text)];
}

fn method_return_type(method: []u8, receiver_type: []u8) -> ![]u8 borrows receiver_type {
    if std::mem::equal_bytes(method, "len") or std::mem::equal_bytes(method, "capacity") {
        return "i64";
    }
    if std::mem::equal_bytes(method, "contains") {
        return "bool";
    }
    if std::mem::equal_bytes(method, "as_bytes") {
        return "[]u8";
    }
    if std::mem::equal_bytes(method, "append") or
        std::mem::equal_bytes(method, "append_bytes") or
        std::mem::equal_bytes(method, "append_byte") or
        std::mem::equal_bytes(method, "reserve") or
        std::mem::equal_bytes(method, "set") or
        std::mem::equal_bytes(method, "clear") or
        std::mem::equal_bytes(method, "truncate") or
        std::mem::equal_bytes(method, "deinit") {
        return "void";
    }
    if std::mem::equal_bytes(method, "get") or
        std::mem::equal_bytes(method, "at") or
        std::mem::equal_bytes(method, "at_mut") {
        return container_element_type(receiver_type);
    }
    return "unknown";
}

fn container_element_type(type_name: []u8) -> ![]u8 borrows type_name {
    if std::mem::starts_with(type_name, "std::array::Array<") {
        return try generic_argument(type_name, 0);
    }
    if std::mem::starts_with(type_name, "std::map::Map<") {
        return try generic_argument(type_name, 1);
    }
    return "unknown";
}

pub fn gate_qualified_generic_method_result() -> !void {
    print(try method_return_type(
        "get", "std::map::Map<[]u8, resolver::BindingKind>"
    ));
    return;
}

fn generic_argument(
    type_name: []u8,
    wanted_index: i64
) -> ![]u8 borrows type_name {
    let layer = try type_spelling::parse(type_name);
    if layer.kind != type_spelling::layer_named() or !layer.has_arguments {
        return error("container type arguments missing");
    }
    let arguments = try type_spelling::arguments(&layer, type_name);
    var start = 0;
    var index = 0;
    while start < std::mem::len(arguments) {
        let argument = try type_spelling::next_argument(arguments, start);
        if index == wanted_index { return argument; }
        start = try type_spelling::next_argument_start(arguments, start);
        index = index + 1;
    }
    return error("container type argument missing");
}

pub fn is_generic_constructor_text(text: []u8) -> !bool {
    return try type_constructor::is_builtin_application(text);
}

fn append_resolved_function_name(
    out: &var std::string::String,
    file: &source::SourceFile,
    name: []u8
) -> !void {
    if source::is_absolute_name_for_file(file, name) {
        try out.append_bytes(name);
        return;
    }
    if ast_text::is_qualified_name(name) {
        try source::append_package_prefix(out, file);
        try out.append_bytes("::");
        try out.append_bytes(name);
        return;
    }
    try source::append_qualified_module_name(out, file);
    try out.append_bytes("::");
    try out.append_bytes(name);
    return;
}

pub fn last_segment_starts_with_uppercase(name: []u8) -> bool {
    var start = 0;
    var index = 0;
    while index + 1 < std::mem::len(name) {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            start = index + 2;
        }
        index = index + 1;
    }
    if start >= std::mem::len(name) {
        return false;
    }
    let byte = name[start];
    return byte >= cast<u8>(65) and byte <= cast<u8>(90);
}

fn resolved_function_return_type(
    allocator: Allocator,
    file: &source::SourceFile,
    name: []u8,
    function_returns: &var expression_facts::ExpressionTypeFacts
) -> ![]u8 {
    if should_skip_function_reference(name) {
        return "unknown";
    }
    var resolved = std::string::String(allocator);
    try append_resolved_function_name(resolved, file, name);
    let key = resolved.as_bytes();
    var result = "unknown";
    if function_returns.contains_source(&key) {
        result = try function_returns.get_source(&key);
    }
    resolved.deinit();
    return result;
}

pub fn should_skip_function_reference(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "print") or
        std::mem::equal_bytes(name, "error") or
        std::mem::equal_bytes(name, "cast") or
        std::mem::equal_bytes(name, "return") or
        std::mem::equal_bytes(name, "or") or
        std::mem::equal_bytes(name, "and") or
        std::mem::equal_bytes(name, "if") or
        std::mem::equal_bytes(name, "while") or
        std::mem::equal_bytes(name, "for") or
        std::mem::equal_bytes(name, "match");
}

fn infer_var_expression_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &std::map::Map<[]u8, []u8>
) -> ![]u8 {
    let name = ast_text::ast_node_text(file, ast, node_id);
    if local_types.contains(name) {
        return local_types.get(name);
    }
    return "unknown";
}

fn binary_expression_type(op: std::kizu::ast::BinaryOp) -> []u8 {
    match op {
        Add => return "i64";,
        Sub => return "i64";,
        Mul => return "i64";,
        Div => return "i64";,
        Mod => return "i64";,
        Eq => return "bool";,
        NotEq => return "bool";,
        LT => return "bool";,
        LTE => return "bool";,
        GT => return "bool";,
        GTE => return "bool";,
        And => return "bool";,
        Or => return "bool";,
    }
}

fn prefix_expression_type(op: std::kizu::ast::PrefixOp) -> []u8 {
    match op {
        Not => return "bool";,
        Neg => return "i64";,
        Borrow => return "unknown";,
        MutBorrow => return "unknown";,
    }
}

pub fn known_type_mismatch(expected: []u8, actual: []u8) -> bool {
    let expected_type = value_type_text(expected);
    let actual_type = value_type_text(actual);
    if std::mem::equal_bytes(expected_type, "unknown") or
        std::mem::equal_bytes(actual_type, "unknown") {
        return false;
    }
    if std::mem::starts_with(expected_type, "!") {
        return false;
    }
    if std::mem::starts_with(actual_type, "!") or type_text_has_error_marker(actual_type) {
        return false;
    }
    if borrow_type_accepts_actual(expected_type, actual_type) {
        return false;
    }
    if is_u8_slice(expected_type) or is_u8_slice(actual_type) {
        return !(is_u8_slice(expected_type) and is_u8_slice(actual_type));
    }
    if !is_scalar_comparable_type(expected_type) or !is_scalar_comparable_type(actual_type) {
        return false;
    }
    return !std::mem::equal_bytes(expected_type, actual_type);
}

pub fn known_binary_operand_type_mismatch(left: []u8, right: []u8) -> bool {
    let left_type = value_type_text(left);
    let right_type = value_type_text(right);
    if std::mem::equal_bytes(left_type, "unknown") or
        std::mem::equal_bytes(right_type, "unknown") {
        return false;
    }
    if std::mem::starts_with(left_type, "!") or
        std::mem::starts_with(right_type, "!") or
        type_text_has_error_marker(left_type) or
        type_text_has_error_marker(right_type) {
        return false;
    }
    if borrow_type_accepts_actual(left_type, right_type) or
        borrow_type_accepts_actual(right_type, left_type) {
        return false;
    }
    if is_u8_slice(left_type) or is_u8_slice(right_type) {
        return !(is_u8_slice(left_type) and is_u8_slice(right_type));
    }
    return !std::mem::equal_bytes(left_type, right_type);
}

fn borrow_type_accepts_actual(expected: []u8, actual: []u8) -> bool {
    if std::mem::starts_with(expected, "&var ") {
        let borrowed = std::mem::trim_ascii(expected[5..std::mem::len(expected)]);
        return type_text_equal_for_borrow(borrowed, actual);
    }
    if std::mem::starts_with(expected, "&") {
        let borrowed = std::mem::trim_ascii(expected[1..std::mem::len(expected)]);
        return type_text_equal_for_borrow(borrowed, actual);
    }
    return false;
}

fn type_text_equal_for_borrow(expected: []u8, actual: []u8) -> bool {
    if is_u8_slice(expected) or is_u8_slice(actual) {
        return is_u8_slice(expected) and is_u8_slice(actual);
    }
    return std::mem::equal_bytes(expected, actual);
}

fn value_type_text(type_name: []u8) -> []u8 {
    let trimmed = std::mem::trim_ascii(type_name);
    let marker = " borrows ";
    let marker_len = std::mem::len(marker);
    var index = 0;
    while index + marker_len <= std::mem::len(trimmed) {
        if std::mem::equal_bytes(trimmed[index..index + marker_len], marker) {
            return std::mem::trim_ascii(trimmed[0..index]);
        }
        index = index + 1;
    }
    return trimmed;
}

pub fn is_scalar_comparable_type(type_name: []u8) -> bool {
    let value_type = value_type_text(type_name);
    return std::mem::equal_bytes(value_type, "void") or
        std::mem::equal_bytes(value_type, "bool") or
        std::mem::equal_bytes(value_type, "i64") or
        std::mem::equal_bytes(value_type, "u8") or
        std::mem::equal_bytes(value_type, "Allocator") or
        std::mem::equal_bytes(value_type, "Io");
}

pub fn is_u8_slice(type_name: []u8) -> bool {
    return std::mem::equal_bytes(value_type_text(type_name), "[]u8");
}

pub fn type_text_has_error_marker(type_name: []u8) -> bool {
    var index = 0;
    while index < std::mem::len(type_name) {
        if type_name[index] == cast<u8>(33) {
            return true;
        }
        index = index + 1;
    }
    return false;
}
