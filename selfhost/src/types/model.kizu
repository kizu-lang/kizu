pub enum TypeKind {
    Primitive,
    Function,
    Struct,
    Union,
    Enum,
    ErrorUnion,
    Optional,
    Container,
}

pub struct TypeSummary {
    pub modules: i64,
    pub symbols: i64,
    pub functions: i64,
    pub typed_nodes: i64,
    pub diagnostics: i64,
}

pub struct FunctionCallSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub expected: i64,
    pub observed: i64,
}

pub struct TypeReferenceSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub expected: i64,
    pub observed: i64,
}

pub struct ReturnTypeSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
}

pub struct ArgumentTypeSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
}

pub struct AssignmentTypeSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
}

pub struct ImmutableAssignmentSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub name: []u8,
}

pub struct InvalidAssignmentTargetSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
}

pub struct UndefinedVariableSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub name: []u8,
}

pub struct MatchDiagnosticSummary {
    pub found: bool,
    pub kind: i64,
    pub name: []u8,
    pub tag: []u8,
}

pub struct MissingReturnSummary {
    pub found: bool,
    pub name: []u8,
    pub expected_return: []u8,
}

pub struct FunctionSignature {
    pub params: i64,
    pub param_source: []u8,
    pub return_type: []u8,
    pub public: bool,
    pub span_start: i64,
    pub span_end: i64,
}
