pub enum TypeKind {
    Primitive,
    Function,
    Struct,
    Union,
    Enum,
    ErrorUnion,
    Optional,
    Container,
    // A contract names a method set, not storage. It shares the declared-type namespace so
    // a contract and a struct cannot take the same name, but it only resolves as a type
    // under a `dyn` layer (SPEC.md 16).
    Contract,
}

pub struct TypeSummary {
    pub modules: i64,
    pub symbols: i64,
    pub functions: i64,
    pub typed_nodes: i64,
    pub diagnostics: i64,
}

pub struct FunctionCallSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub expected: i64,
    pub observed: i64,
}

pub struct TypeReferenceSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub expected: i64,
    pub observed: i64,
}

// IntegerLiteralRange carries one integer literal written where an integer type it cannot
// hold is expected (SPEC.md 7.2). Such a literal is rejected in place rather than left to
// keep `i64` and report the position's ordinary mismatch, so every summary for a position
// that fixes an expected type carries this alternative verdict. `expected` is the integer
// type it failed to fit; `digits` and `negations` spell the literal.
pub struct IntegerLiteralRange {
    pub found: bool,
    pub digits: []u8,
    pub negations: i64,
    pub expected: []u8,
}

pub struct ReturnTypeSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
    pub literal: IntegerLiteralRange,
}

// ArgumentTypeSummary carries one rejected call argument. `kind` 0 is an ordinary type
// mismatch, where `expected` is the declared parameter type; `kind` 1 is a `dyn Contract`
// parameter the argument does not conform to, where `expected` is the contract name.
pub struct ArgumentTypeSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
    pub literal: IntegerLiteralRange,
}

// StructLiteralSummary carries one struct literal the declaration it names does not admit.
// `kind` says which of the three questions decided it: the type names no struct, a field
// the struct declares is missing, a field the literal writes is not declared, or a value
// does not have the type its field declares. `type_name` is the literal's own spelling and
// `field` the member the verdict is about. The reference checker states all four without a
// position, so no span travels with them.
pub struct StructLiteralSummary {
    pub found: bool,
    pub kind: i64,
    pub type_name: []u8,
    pub field: []u8,
    pub expected: []u8,
    pub actual: []u8,
    pub literal: IntegerLiteralRange,
}

// ContractSummary carries one contract rule violation. `subject` is the implementing type
// or the offending parameter, `contract_name` the contract it was measured against, and
// `method` the contract method that decided it.
pub struct ContractSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub subject: []u8,
    pub contract_name: []u8,
    pub method: []u8,
}

// DynDispatchSummary carries one call a contract object cannot serve: a method the
// contract does not declare, or one it declares at a different arity.
pub struct DynDispatchSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub contract_name: []u8,
    pub method: []u8,
    pub expected: i64,
    pub observed: i64,
}

// VisibilitySummary carries one private type a public declaration exposes. `kind` is the
// published position, `owner` the declaration that publishes it, and `member` the field or
// variant inside it when the position names one.
pub struct VisibilitySummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub owner: []u8,
    pub member: []u8,
    pub type_name: []u8,
}

// ImplMethodSummary carries one method name a type's impl blocks declare twice.
pub struct ImplMethodSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub type_name: []u8,
    pub method: []u8,
}

// ContainerStorageSummary carries one type a container position refuses to store.
// `kind` is the position -- a map key, a map value, a borrow field or payload, or an
// array element reached directly or through a declaration. `cause` says which property
// of the element type decided an array element, and `detail` names the intrinsic it was;
// `owner` and `member` name the declaration the refused type was reached through, or the
// field or variant that stores a borrow.
pub struct ContainerStorageSummary {
    pub found: bool,
    pub kind: i64,
    pub cause: i64,
    pub start: i64,
    pub end: i64,
    pub owner: []u8,
    pub member: []u8,
    pub detail: []u8,
}

// TypePlacementSummary carries one type spelling written in a position that stores no
// value of it. `owner` is the declaration that holds the position -- the struct, the
// union, or the function -- and `member` the field, variant, parameter, or local that
// names the spelling. A position with only one of the two leaves the other empty.
pub struct TypePlacementSummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub owner: []u8,
    pub member: []u8,
}

pub struct AssignmentTypeSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub expected: []u8,
    pub actual: []u8,
    pub literal: IntegerLiteralRange,
}

pub struct ImmutableAssignmentSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub name: []u8,
}

pub struct InvalidAssignmentTargetSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
}

pub struct UndefinedVariableSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
    pub name: []u8,
}

pub struct MatchDiagnosticSummary {
    pub found: bool,
    pub kind: i64,
    pub name: []u8,
    pub tag: []u8,
}

pub struct MissingReturnSummary {
    pub found: bool,
    pub name: []u8,
    pub expected_return: []u8,
}

// UnsafeSummary carries one raw pointer or @unsafe capability violation. `operation`
// names the syntax that triggered the rule and `spelling` the type it was applied to;
// `capability` is the reserved capability identity a missing-capability report needs.
pub struct UnsafeSummary {
    pub found: bool,
    pub kind: i64,
    pub operation_kind: i64,
    pub start: i64,
    pub end: i64,
    pub capability: i64,
    pub operation: []u8,
    pub spelling: []u8,
}

// ConcurrencySummary carries one `comptime Function` slot or worker contract violation.
// `subject` is what the rule is about -- the named worker, the operation, or the binding
// -- and `detail` the fact that decided it: the reserved module, the boundary reason, the
// captured element type, or a struct field name.
pub struct ConcurrencySummary {
    pub found: bool,
    pub kind: i64,
    pub start: i64,
    pub end: i64,
    pub subject: []u8,
    pub detail: []u8,
    pub actual: []u8,
    pub expected: i64,
    pub observed: i64,
}

pub struct FunctionSignature {
    pub params: i64,
    pub param_source: []u8,
    pub return_type: []u8,
    pub public: bool,
    pub span_start: i64,
    pub span_end: i64,
}
