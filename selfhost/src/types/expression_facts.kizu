// ExpressionTypeFacts interns every type spelling the collection walk decides, and hands
// the interned bytes back as plain views. Those views outlive the call that asks for one:
// a local's type is parked in a `Map<[]u8, []u8>` and read again after later statements
// have been walked, and walking a later statement collects more facts.
//
// So an interned spelling owns its own buffer. Appending fact N+1 must not move fact N's
// bytes, and one shared growable buffer moves all of them every time it reallocates --
// which left `users`' type reading whatever the freed block held next and made the same
// input answer "check: ok" or "unbalanced type delimiters" run to run.
pub struct ExpressionTypeFacts {
    source_indexes: std::map::Map<[]u8, i64>,
    field_indexes: std::map::Map<[]u8, i64>,
    spellings: std::array::Array<std::string::String>,
}

pub fn init(allocator: Allocator) -> ExpressionTypeFacts {
    return ExpressionTypeFacts {
        source_indexes: std::map::Map<[]u8, i64>(allocator),
        field_indexes: std::map::Map<[]u8, i64>(allocator),
        spellings: std::array::Array<std::string::String>(allocator)
    };
}

impl ExpressionTypeFacts {
    // The index maps hold positions, never views, so releasing them first can strand no
    // reader. The interned buffers go last all the same, so no order of teardown can read
    // a spelling after it is released.
    //
    // Releasing the spellings array releases the array's own storage. The buffer each
    // interned spelling owns is released with the process: freeing one needs the element
    // moved out of the array (`String.deinit` takes an owned receiver, so a borrow off
    // `at_mut` will not do), and the compiled MIR lowering cannot yet resolve the element
    // type of `Array<T>.pop_or_panic` -- it refuses the shape rather than emitting
    // something else. The cost is measured: `check selfhost` over the whole package holds
    // 172MB against 170MB for the shared-buffer store it replaces.
    fn deinit(self: ExpressionTypeFacts) -> void {
        self.source_indexes.deinit();
        self.field_indexes.deinit();
        self.spellings.deinit();
        return;
    }

    fn contains_source(self: &ExpressionTypeFacts, key: &[]u8) -> bool {
        return self.source_indexes.contains(key);
    }

    fn get_source(
        self: &ExpressionTypeFacts,
        key: &[]u8
    ) -> ![]u8 borrows self {
        let index = try self.source_indexes.get(key);
        return try self.spelling_at(index);
    }

    fn insert_source(
        self: &var ExpressionTypeFacts,
        allocator: Allocator,
        key: &[]u8,
        spelling: []u8
    ) -> !void {
        var owned = std::string::String(allocator);
        try owned.append_bytes(spelling);
        // Publish the index last. An allocation failure may leave owned, unreachable
        // storage in this soon-to-be-deinitialized builder, but it can never leave a
        // visible index pointing at a missing spelling.
        let index = self.spellings.len();
        try self.spellings.append(owned);
        try self.source_indexes.insert(key, index);
        return;
    }

    fn insert_source_owned(
        self: &var ExpressionTypeFacts,
        allocator: Allocator,
        key: &[]u8,
        spelling: &std::string::String
    ) -> !void {
        var owned = std::string::String(allocator);
        let spelling_bytes = spelling.as_bytes();
        try owned.append_bytes(spelling_bytes);
        let index = self.spellings.len();
        try self.spellings.append(owned);
        try self.source_indexes.insert(key, index);
        return;
    }

    fn contains_field(self: &ExpressionTypeFacts, key: &[]u8) -> bool {
        return self.field_indexes.contains(key);
    }

    fn get_field(
        self: &ExpressionTypeFacts,
        key: &[]u8
    ) -> ![]u8 borrows self {
        let index = try self.field_indexes.get(key);
        return try self.spelling_at(index);
    }

    fn insert_field(
        self: &var ExpressionTypeFacts,
        allocator: Allocator,
        key: &[]u8,
        spelling: &std::string::String
    ) -> !void {
        var owned = std::string::String(allocator);
        let spelling_bytes = spelling.as_bytes();
        try owned.append_bytes(spelling_bytes);
        let index = self.spellings.len();
        try self.spellings.append(owned);
        try self.field_indexes.insert(key, index);
        return;
    }

    fn spelling_at(
        self: &ExpressionTypeFacts,
        index: i64
    ) -> ![]u8 borrows self {
        let spellings = &self.spellings;
        let interned = try spellings.at(index);
        let length = interned.len();
        let bytes = interned.as_bytes();
        // One interned buffer holds exactly one spelling, so the whole buffer is the
        // view. It is read out of the buffer the store owns, never copied, so the answer
        // stays tied to this store the way the signature says it is.
        return bytes[0..length];
    }
}
