import selfhost::parser;
import selfhost::source;
import selfhost::type_constructor;
import selfhost::types::expression_facts;
import selfhost::types::expression_infer;
import selfhost::types::model;
import selfhost::types::package_modules;
import selfhost::types::pointer_builtin;

pub fn first_package_function_call_error_ast_node(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !model::FunctionCallSummary {
    var function_arities = std::map::Map<[]u8, i64>(allocator);
    defer function_arities.deinit();
    try collect_function_arities_from_ast(
        allocator,
        file,
        ast,
        root,
        function_arities
    );
    var referenced_modules = std::array::Array<package_modules::PackageModuleRef>(allocator);
    defer referenced_modules.deinit();
    var import_alias_starts = std::map::Map<[]u8, i64>(allocator);
    defer import_alias_starts.deinit();
    var import_alias_ends = std::map::Map<[]u8, i64>(allocator);
    defer import_alias_ends.deinit();
    try package_modules::collect_import_aliases_from_ast(
        file,
        ast,
        root,
        import_alias_starts,
        import_alias_ends
    );
    try package_modules::collect_referenced_package_call_modules_from_ast(
        file,
        ast,
        root,
        import_alias_starts,
        import_alias_ends,
        referenced_modules
    );
    try collect_other_package_function_arities_for_modules_from_ast(
        allocator,
        files,
        file,
        referenced_modules,
        function_arities
    );
    return try first_function_call_error_ast_node_with_imports(
        allocator,
        file,
        ast,
        root,
        function_arities,
        import_alias_starts,
        import_alias_ends,
        false
    );
}

fn collect_other_package_function_arities_for_modules_from_ast(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>,
    target_file: &source::SourceFile,
    modules: &std::array::Array<package_modules::PackageModuleRef>,
    function_arities: &var std::map::Map<[]u8, i64>
) -> !void {
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if source::is_source_code(file.kind) and !std::mem::equal_bytes(file.path, target_file.path) {
            if try package_modules::list_contains_file(target_file, modules, file) {
                let result = try parser::parse_checked_file(allocator, file.path, file.text);
                try collect_function_arities_from_ast(
                    allocator,
                    file,
                    &result.ast,
                    result.root,
                    function_arities
                );
                result.deinit();
            }
        }
        index = index + 1;
    }
    return;
}

pub fn collect_function_signatures_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    arities: &var std::map::Map<[]u8, i64>,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    let node = ast.get(root);
    match node.data {
        Program(program) => return collect_function_signatures_in_range_from_ast(
            allocator,
            file,
            ast,
            program.declarations,
            arities,
            returns
        );,
        FnDecl(fn_decl) => return collect_function_signature_from_ast(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.params,
            fn_decl.return_type,
            arities,
            returns
        );,
        ImplDecl(impl_decl) => return collect_method_param_type_facts_in_range(
            allocator,
            file,
            ast,
            impl_decl.methods,
            returns
        );,
        ContractDecl(contract_decl) => return collect_method_param_type_facts_in_range(
            allocator,
            file,
            ast,
            contract_decl.methods,
            returns
        );,
        _ => return;,
    }
    return;
}

fn collect_method_param_type_facts_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    methods: std::kizu::ast::ChildRange,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var index = 0;
    while index < methods.len {
        let child = try ast.child_at(methods, index);
        let node = ast.get(child);
        match node.data {
            FnDecl(fn_decl) => try collect_function_param_type_facts(
                allocator,
                file,
                ast,
                fn_decl.params,
                returns
            );,
            _ => ignore_function_param_type_fact();,
        }
        index = index + 1;
    }
    return;
}

fn collect_function_signatures_in_range_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    arities: &var std::map::Map<[]u8, i64>,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_function_signatures_from_ast(
            allocator,
            file,
            ast,
            child,
            arities,
            returns
        );
        index = index + 1;
    }
    return;
}

fn collect_function_signature_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    arities: &var std::map::Map<[]u8, i64>,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var qualified = std::string::String(allocator);
    try append_module_name(qualified, file);
    try qualified.append_bytes("::");
    try qualified.append_bytes(ast_ref_node_text(file, ast, name));
    let function_name = qualified.as_bytes();
    // A repeated function identity is user source, not a broken invariant: every
    // caller of this collector is a frontend type-check pass over a file the user
    // wrote. Failing here aborted `check` with an internal `runtime error:
    // duplicate function` before the resolver could report `duplicate symbol`. The
    // first declaration keeps the facts, which is the one the diagnostic points
    // back to. Written as a guard rather than an early return so the single deinit
    // below still follows every use of the borrowed name.
    if !arities.contains(function_name) {
        try arities.insert(function_name, params.len);
        var canonical_return = try expression_infer::build_canonical_type_spelling(
            allocator,
            file,
            ast_return_type(file, ast, return_type),
            returns
        );
        defer canonical_return.deinit();
        try returns.insert_source_owned(&function_name, &canonical_return);
        try collect_function_param_type_facts(
            allocator, file, ast, params, returns
        );
    }
    qualified.deinit();
    return;
}

fn collect_function_param_type_facts(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        let node = ast.get(child);
        match node.data {
            Param(param_node) => try insert_function_param_type_fact(
                allocator, file, ast, child, param_node.type_node, returns
            );,
            _ => ignore_function_param_type_fact();,
        }
        index = index + 1;
    }
    return;
}

fn insert_function_param_type_fact(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    param_node: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    returns: &var expression_facts::ExpressionTypeFacts
) -> !void {
    var key = std::string::String(allocator);
    defer key.deinit();
    try expression_infer::append_param_type_key(
        key, file, ast, param_node
    );
    let key_bytes = key.as_bytes();
    var canonical_type = try expression_infer::build_canonical_type_spelling(
        allocator,
        file,
        ast_return_type(file, ast, type_node),
        returns
    );
    defer canonical_type.deinit();
    try returns.insert_source_owned(&key_bytes, &canonical_type);
    return;
}

fn ignore_function_param_type_fact() -> void {
    return;
}

fn ast_return_type(
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    return_type: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(return_type);
    match node.data {
        Empty => return "void";,
        _ => return ast_ref_node_text(file, ast, return_type);,
    }
    return "void";
}

pub fn collect_function_arities_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    arities: &var std::map::Map<[]u8, i64>
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return collect_function_arities_in_range(
            allocator,
            file,
            ast,
            program.declarations,
            arities
        );,
        FnDecl(fn_decl) => return collect_function_arity(
            allocator,
            file,
            ast,
            fn_decl.name,
            fn_decl.params.len,
            arities
        );,
        _ => return;,
    }
}

fn collect_function_arities_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    arities: &var std::map::Map<[]u8, i64>
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        try collect_function_arities_from_ast(allocator, file, ast, child, arities);
        index = index + 1;
    }
    return;
}

fn collect_function_arity(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    params: i64,
    arities: &var std::map::Map<[]u8, i64>
) -> !void {
    var qualified = std::string::String(allocator);
    try append_module_name(qualified, file);
    try qualified.append_bytes("::");
    try qualified.append_bytes(ast_ref_node_text(file, ast, name));
    let key = qualified.as_bytes();
    // Same as collect_function_signature_from_ast: the duplicate is reported as
    // `duplicate symbol` by the resolver, so the first arity stays and this pass
    // does not abort the check. Written as a guard rather than an early return so
    // the single deinit still follows every use of the borrowed key.
    if !arities.contains(key) {
        try arities.insert(key, params);
    }
    qualified.deinit();
    return;
}

pub fn first_function_call_error_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    functions: &std::map::Map<[]u8, i64>,
    local_only: bool
) -> !model::FunctionCallSummary {
    var import_alias_starts = std::map::Map<[]u8, i64>(allocator);
    var import_alias_ends = std::map::Map<[]u8, i64>(allocator);
    try package_modules::collect_import_aliases_from_ast(
        file,
        ast,
        node_id,
        import_alias_starts,
        import_alias_ends
    );
    let found = try first_function_call_error_ast_node_with_imports(
        allocator,
        file,
        ast,
        node_id,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
    import_alias_starts.deinit();
    import_alias_ends.deinit();
    return found;
}

fn first_function_call_error_ast_node_with_imports(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    functions: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>,
    local_only: bool
) -> !model::FunctionCallSummary {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return first_function_call_error_in_range(
            allocator,
            file,
            ast,
            program.declarations,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        FnDecl(fn_decl) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            fn_decl.body,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        ImplDecl(impl_decl) => return first_function_call_error_in_range(
            allocator,
            file,
            ast,
            impl_decl.methods,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Block(block) => return first_function_call_error_in_range(
            allocator,
            file,
            ast,
            block.statements,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Let(let_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            let_node.value,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Assign(assign_node) => return first_function_call_error_in_two_nodes(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Return(return_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            return_node.value,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Defer(defer_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            defer_node.expr,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        ErrDefer(err_defer_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            err_defer_node.expr,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        ExprStmt(expr_stmt) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        If(if_node) => return first_function_call_error_in_three_nodes(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        While(while_node) => return first_function_call_error_in_two_nodes(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        For(for_node) => return first_function_call_error_in_three_nodes(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Match(match_node) => return first_function_call_error_in_match(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        MatchArm(match_arm) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            match_arm.body,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Unsafe(unsafe_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            unsafe_node.body,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        ComptimeIf(comptime_if_node) => return first_function_call_error_in_three_nodes(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Prefix(prefix_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            prefix_node.right,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Binary(binary) => return first_function_call_error_in_two_nodes(
            allocator,
            file,
            ast,
            binary.left,
            binary.right,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        FieldExpr(field_expr_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        DerefExpr(deref_expr_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            deref_expr_node.receiver,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        Call(call_node) => return first_function_call_error_in_call(
            allocator,
            file,
            ast,
            call_node.callee,
            call_node.args,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        TypeApplyExpr(type_apply) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            type_apply.callee,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        CastExpr(cast_expr) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            cast_expr.value,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        IndexExpr(index_expr) => return first_function_call_error_in_three_nodes(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        StructLiteralExpr(struct_literal) => return first_function_call_error_in_range(
            allocator,
            file,
            ast,
            struct_literal.fields,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        StructFieldInit(struct_field_init) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            struct_field_init.value,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        ArenaNewExpr(arena_new) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            arena_new.allocator,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        TryExpr(try_expr_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            try_expr_node.value,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        ComptimeExpr(comptime_expr_node) => return first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );,
        _ => return function_call_summary(false, 0, 0, 0, 0, 0);,
    }
}

fn first_function_call_error_in_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    functions: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>,
    local_only: bool
) -> !model::FunctionCallSummary {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let found = try first_function_call_error_ast_node_with_imports(
            allocator,
            file,
            ast,
            child,
            functions,
            import_alias_starts,
            import_alias_ends,
            local_only
        );
        if found.found {
            return found;
        }
        index = index + 1;
    }
    return function_call_summary(false, 0, 0, 0, 0, 0);
}

fn first_function_call_error_in_two_nodes(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    functions: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>,
    local_only: bool
) -> !model::FunctionCallSummary {
    let first_found = try first_function_call_error_ast_node_with_imports(
        allocator,
        file,
        ast,
        first,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
    if first_found.found {
        return first_found;
    }
    return first_function_call_error_ast_node_with_imports(
        allocator,
        file,
        ast,
        second,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
}

fn first_function_call_error_in_three_nodes(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    functions: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>,
    local_only: bool
) -> !model::FunctionCallSummary {
    let first_found = try first_function_call_error_ast_node_with_imports(
        allocator,
        file,
        ast,
        first,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
    if first_found.found {
        return first_found;
    }
    return first_function_call_error_in_two_nodes(
        allocator,
        file,
        ast,
        second,
        third,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
}

fn first_function_call_error_in_match(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    functions: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>,
    local_only: bool
) -> !model::FunctionCallSummary {
    let value_found = try first_function_call_error_ast_node_with_imports(
        allocator,
        file,
        ast,
        value,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
    if value_found.found {
        return value_found;
    }
    return first_function_call_error_in_range(
        allocator,
        file,
        ast,
        arms,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
}

fn first_function_call_error_in_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    functions: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>,
    local_only: bool
) -> !model::FunctionCallSummary {
    let call_found = try function_call_error_for_ast_call(
        allocator,
        file,
        ast,
        callee,
        args,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
    if call_found.found {
        return call_found;
    }
    let callee_found = try first_function_call_error_ast_node_with_imports(
        allocator,
        file,
        ast,
        callee,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
    if callee_found.found {
        return callee_found;
    }
    return first_function_call_error_in_range(
        allocator,
        file,
        ast,
        args,
        functions,
        import_alias_starts,
        import_alias_ends,
        local_only
    );
}

fn function_call_error_for_ast_call(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange,
    functions: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>,
    local_only: bool
) -> !model::FunctionCallSummary {
    if function_call_callee_is_member(ast, callee) {
        return function_call_summary(false, 0, 0, 0, 0, 0);
    }
    let name = function_call_name_text(file, ast, callee);
    // A compiler builtin is not declared anywhere, so it resolves from its own
    // signature table rather than the declared function table. Its arity is still
    // checked here; the table is a signature, not an exemption.
    let builtin = pointer_builtin::lookup(name);
    if builtin.params >= 0 {
        let callee_node = ast.get(callee);
        if builtin.params != args.len {
            return function_call_summary(
                true,
                2,
                callee_node.span.start,
                callee_node.span.end,
                builtin.params,
                args.len
            );
        }
        return function_call_summary(false, 0, 0, 0, 0, 0);
    }
    if should_skip_function_reference(name) or
        last_segment_starts_with_uppercase(name) or
        (try is_generic_constructor_text(name)) or
        (local_only and is_qualified_name(name)) or
        (!local_only and !is_qualified_name(name)) {
        return function_call_summary(false, 0, 0, 0, 0, 0);
    }
    var resolved = std::string::String(allocator);
    try append_resolved_function_name(
        resolved,
        file,
        name,
        import_alias_starts,
        import_alias_ends
    );
    let key = resolved.as_bytes();
    let found = functions.contains(key);
    var expected = 0;
    if found {
        expected = try functions.get(key);
    }
    resolved.deinit();
    let callee_node = ast.get(callee);
    if !found {
        return function_call_summary(true, 1, callee_node.span.start, callee_node.span.end, 0, 0);
    }
    if expected != args.len {
        return function_call_summary(
            true,
            2,
            callee_node.span.start,
            callee_node.span.end,
            expected,
            args.len
        );
    }
    return function_call_summary(false, 0, 0, 0, 0, 0);
}

pub fn function_call_callee_is_member(
    ast: &std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(callee);
    match node.data {
        FieldExpr(field_expr_node) => return !field_expr_node.namespace;,
        TypeApplyExpr(type_apply) => return function_call_callee_is_member(ast, type_apply.callee);,
        _ => return false;,
    }
}

pub fn function_call_name_text(
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(callee);
    match node.data {
        TypeApplyExpr(type_apply) => return function_call_name_text(file, ast, type_apply.callee);,
        _ => return ast_ref_node_text(file, ast, callee);,
    }
}

fn function_call_summary(
    found: bool,
    kind: i64,
    start: i64,
    end: i64,
    expected: i64,
    observed: i64
) -> model::FunctionCallSummary {
    return model::FunctionCallSummary {
        found: found,
        kind: kind,
        start: start,
        end: end,
        expected: expected,
        observed: observed
    };
}

pub fn should_skip_function_reference(name: []u8) -> bool {
    return expression_infer::should_skip_function_reference(name);
}

// append_compact_path_name appends a path with its ASCII whitespace removed. A path is a run of
// identifiers separated by '::' and the separator's spacing carries no meaning, so the resolved
// key this builds must not carry it either: declaration names never do, and a spaced key misses
// every one of them. It appends into the caller's String rather than compacting into a local one,
// because a slice borrowed from a local String cannot be handed to another function.
pub fn append_compact_path_name(
    out: &var std::string::String,
    name: []u8
) -> !void {
    return append_compact_path_name_from(out, name, 0);
}

// append_compact_path_name_from takes the tail's start offset rather than a slice of name: a
// slice whose end bound is a call ('name[start..std::mem::len(name)]') has no lowering as a
// source-function argument, and the offset carries the same information.
pub fn append_compact_path_name_from(
    out: &var std::string::String,
    name: []u8,
    start: i64
) -> !void {
    let length = std::mem::len(name);
    var index = start;
    while index < length {
        let byte = name[index];
        if !path_byte_is_ascii_space(byte) {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    return;
}

fn path_byte_is_ascii_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or
        byte == cast<u8>(9) or
        byte == cast<u8>(10) or
        byte == cast<u8>(13) or
        byte == cast<u8>(11) or
        byte == cast<u8>(12);
}

pub fn append_resolved_function_name(
    out: &var std::string::String,
    file: &source::SourceFile,
    name: []u8,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !void {
    if source::is_absolute_name_for_file(file, name) {
        try append_compact_path_name(out, name);
        return;
    }
    if is_qualified_name(name) {
        let first_end = first_qualified_segment_end(name);
        let alias = std::mem::trim_ascii(name[0..first_end]);
        if import_alias_starts.contains(alias) {
            let module_start = try import_alias_starts.get(alias);
            let module_end = try import_alias_ends.get(alias);
            try out.append_bytes(file.text[module_start..module_end]);
            try append_compact_path_name_from(out, name, first_end);
            return;
        }
        try source::append_package_prefix(out, file);
        try out.append_bytes("::");
        try append_compact_path_name(out, name);
        return;
    }
    try source::append_qualified_module_name(out, file);
    try out.append_bytes("::");
    try append_compact_path_name(out, name);
    return;
}

pub fn last_segment_starts_with_uppercase(name: []u8) -> bool {
    var start = 0;
    var index = 0;
    while index + 1 < std::mem::len(name) {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            start = index + 2;
        }
        index = index + 1;
    }
    if start >= std::mem::len(name) {
        return false;
    }
    let byte = name[start];
    return byte >= cast<u8>(65) and byte <= cast<u8>(90);
}

fn append_module_name(
    name: &var std::string::String,
    file: &source::SourceFile
) -> !void {
    try source::append_qualified_module_name(name, file);
    return;
}

fn ast_ref_node_text(
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(file.text[span.start..span.end]);
}

pub fn is_generic_constructor_text(text: []u8) -> !bool {
    if try type_constructor::is_builtin_application(text) {
        return true;
    }
    return type_constructor::is_builtin_name(text);
}

fn first_qualified_segment_end(name: []u8) -> i64 {
    var index = 0;
    while index + 1 < std::mem::len(name) {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            return index;
        }
        index = index + 1;
    }
    return std::mem::len(name);
}

fn is_qualified_name(name: []u8) -> bool {
    return first_qualified_segment_end(name) < std::mem::len(name);
}
