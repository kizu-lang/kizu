import selfhost::source;
import selfhost::types::model;
import selfhost::types::package_modules;
import selfhost::types::type_ref_ast;

pub struct TypeReferenceScan {
    pub next: i64,
    pub typed_nodes: i64,
    pub diagnostics: i64,
}

pub fn check_file_type_references_from_ast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var import_alias_starts = std::map::Map<[]u8, i64>(allocator);
    var import_alias_ends = std::map::Map<[]u8, i64>(allocator);
    try package_modules::collect_import_aliases_from_ast(
        file,
        ast,
        root,
        import_alias_starts,
        import_alias_ends
    );
    let scan = try scan_type_reference_ast_node(
        allocator,
        file,
        ast,
        root,
        kinds,
        arities,
        import_alias_starts,
        import_alias_ends
    );
    import_alias_starts.deinit();
    import_alias_ends.deinit();
    return scan;
}

fn scan_type_reference_ast_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    let node = ast.get(node_id);
    match node.data {
        Program(program) => return scan_type_reference_range(
            allocator,
            file,
            ast,
            program.declarations,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        FnDecl(fn_decl) => return scan_type_reference_fn(
            allocator,
            file,
            ast,
            fn_decl.params,
            fn_decl.return_type,
            fn_decl.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        StructDecl(struct_decl) => return scan_type_reference_range(
            allocator,
            file,
            ast,
            struct_decl.fields,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        UnionDecl(union_decl) => return scan_type_reference_range(
            allocator,
            file,
            ast,
            union_decl.variants,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ImplDecl(impl_decl) => return scan_type_reference_node_and_range(
            allocator,
            file,
            ast,
            impl_decl.type_name,
            impl_decl.methods,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Param(param_node) => return scan_type_reference_type_node(
            allocator,
            file,
            ast,
            param_node.type_node,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Field(field_node) => return scan_type_reference_type_node(
            allocator,
            file,
            ast,
            field_node.type_node,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        UnionVariant(union_variant) => return scan_type_reference_type_node(
            allocator,
            file,
            ast,
            union_variant.payload,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Block(block) => return scan_type_reference_range(
            allocator,
            file,
            ast,
            block.statements,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Let(let_node) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            let_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Assign(assign_node) => return scan_type_reference_two_nodes(
            allocator,
            file,
            ast,
            assign_node.target,
            assign_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Return(return_node) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            return_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Defer(defer_node) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            defer_node.expr,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ExprStmt(expr_stmt) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        If(if_node) => return scan_type_reference_three_nodes(
            allocator,
            file,
            ast,
            if_node.condition,
            if_node.then_block,
            if_node.else_block,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        While(while_node) => return scan_type_reference_two_nodes(
            allocator,
            file,
            ast,
            while_node.condition,
            while_node.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        For(for_node) => return scan_type_reference_three_nodes(
            allocator,
            file,
            ast,
            for_node.start,
            for_node.end,
            for_node.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Match(match_node) => return scan_type_reference_node_and_range(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        MatchArm(match_arm) => return scan_type_reference_three_nodes(
            allocator,
            file,
            ast,
            match_arm.pattern,
            match_arm.binding,
            match_arm.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Unsafe(unsafe_node) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            unsafe_node.body,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ComptimeIf(comptime_if_node) => return scan_type_reference_three_nodes(
            allocator,
            file,
            ast,
            comptime_if_node.condition,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Prefix(prefix_node) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            prefix_node.right,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Binary(binary) => return scan_type_reference_two_nodes(
            allocator,
            file,
            ast,
            binary.left,
            binary.right,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        FieldExpr(field_expr_node) => return scan_type_reference_two_nodes(
            allocator,
            file,
            ast,
            field_expr_node.receiver,
            field_expr_node.name,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        DerefExpr(deref_expr_node) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            deref_expr_node.receiver,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        Call(call_node) => return scan_type_reference_node_and_range(
            allocator,
            file,
            ast,
            call_node.callee,
            call_node.args,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        TypeApplyExpr(type_apply) => return scan_type_reference_type_apply(
            allocator,
            file,
            ast,
            type_apply.callee,
            type_apply.type_args,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        CastExpr(cast_expr) => return scan_type_reference_cast(
            allocator,
            file,
            ast,
            cast_expr.type_node,
            cast_expr.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        IndexExpr(index_expr) => return scan_type_reference_three_nodes(
            allocator,
            file,
            ast,
            index_expr.target,
            index_expr.start,
            index_expr.end,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        StructLiteralExpr(struct_literal) => return scan_type_reference_struct_literal(
            allocator,
            file,
            ast,
            struct_literal.type_name,
            struct_literal.fields,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        StructFieldInit(struct_field_init) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            struct_field_init.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ArenaNewExpr(arena_new) => return scan_type_reference_cast(
            allocator,
            file,
            ast,
            arena_new.type_node,
            arena_new.allocator,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        TryExpr(try_expr_node) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            try_expr_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        ComptimeExpr(comptime_expr_node) => return scan_type_reference_ast_node(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
        _ => return type_reference_scan(0, 0, 0);,
    }
}

fn scan_type_reference_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var summary = type_reference_scan(range.start + range.len, 0, 0);
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        summary = merge_type_reference_scans(
            summary,
            try scan_type_reference_ast_node(allocator, file, ast, child, kinds, arities, import_alias_starts, import_alias_ends)
        );
        index = index + 1;
    }
    return summary;
}

fn scan_type_reference_fn(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var summary = try scan_type_reference_range(allocator, file, ast, params, kinds, arities, import_alias_starts, import_alias_ends);
    summary = merge_type_reference_scans(
        summary,
        try scan_type_reference_type_node(allocator, file, ast, return_type, kinds, arities, import_alias_starts, import_alias_ends)
    );
    summary = merge_type_reference_scans(
        summary,
        try scan_type_reference_ast_node(allocator, file, ast, body, kinds, arities, import_alias_starts, import_alias_ends)
    );
    return summary;
}

fn scan_type_reference_two_nodes(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var summary = try scan_type_reference_ast_node(allocator, file, ast, first, kinds, arities, import_alias_starts, import_alias_ends);
    summary = merge_type_reference_scans(
        summary,
        try scan_type_reference_ast_node(allocator, file, ast, second, kinds, arities, import_alias_starts, import_alias_ends)
    );
    return summary;
}

fn scan_type_reference_three_nodes(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    third: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var summary = try scan_type_reference_ast_node(allocator, file, ast, first, kinds, arities, import_alias_starts, import_alias_ends);
    summary = merge_type_reference_scans(
        summary,
        try scan_type_reference_two_nodes(allocator, file, ast, second, third, kinds, arities, import_alias_starts, import_alias_ends)
    );
    return summary;
}

fn scan_type_reference_node_and_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var summary = try scan_type_reference_ast_node(allocator, file, ast, node_id, kinds, arities, import_alias_starts, import_alias_ends);
    summary = merge_type_reference_scans(
        summary,
        try scan_type_reference_range(allocator, file, ast, range, kinds, arities, import_alias_starts, import_alias_ends)
    );
    return summary;
}

fn scan_type_reference_cast(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var summary = try scan_type_reference_type_node(allocator, file, ast, type_node, kinds, arities, import_alias_starts, import_alias_ends);
    summary = merge_type_reference_scans(
        summary,
        try scan_type_reference_ast_node(allocator, file, ast, value, kinds, arities, import_alias_starts, import_alias_ends)
    );
    return summary;
}

fn scan_type_reference_struct_literal(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    type_name: std::kizu::ast::NodeId,
    fields: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var summary = try scan_type_reference_type_node(allocator, file, ast, type_name, kinds, arities, import_alias_starts, import_alias_ends);
    summary = merge_type_reference_scans(
        summary,
        try scan_type_reference_range(allocator, file, ast, fields, kinds, arities, import_alias_starts, import_alias_ends)
    );
    return summary;
}

fn scan_type_reference_type_apply(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    type_args: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    let callee_text = ast_node_text(file, ast, callee);
    if type_ref_ast::is_generic_constructor_name(callee_text) {
        return scan_type_reference_type_range(allocator, file, ast, type_args, kinds, arities, import_alias_starts, import_alias_ends);
    }
    return type_reference_scan(0, 0, 0);
}

fn scan_type_reference_type_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var summary = type_reference_scan(range.start + range.len, 0, 0);
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        summary = merge_type_reference_scans(
            summary,
            try scan_type_reference_type_node(allocator, file, ast, child, kinds, arities, import_alias_starts, import_alias_ends)
        );
        index = index + 1;
    }
    return summary;
}

fn scan_type_reference_type_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    type_node: std::kizu::ast::NodeId,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    let node = ast.get(type_node);
    match node.data {
        Empty => return type_reference_scan(0, 0, 0);,
        _ => return scan_type_reference_text(
            allocator,
            file,
            file.text[node.span.start..node.span.end],
            node.span.start,
            kinds,
            arities,
            import_alias_starts,
            import_alias_ends
        );,
    }
    return type_reference_scan(0, 0, 0);
}

fn scan_type_reference_text(
    allocator: Allocator,
    file: &source::SourceFile,
    text: []u8,
    absolute_start: i64,
    kinds: &std::map::Map<[]u8, model::TypeKind>,
    arities: &std::map::Map<[]u8, i64>,
    import_alias_starts: &std::map::Map<[]u8, i64>,
    import_alias_ends: &std::map::Map<[]u8, i64>
) -> !TypeReferenceScan {
    var index = 0;
    var typed_nodes = 0;
    var diagnostics = 0;
    while index < std::mem::len(text) {
        let byte = text[index];
        if type_ref_ast::is_type_identifier_start_byte(byte) {
            let start = index;
            let end = type_ref_ast::type_path_end_in_text(text, index);
            let name = text[start..end];
            if !type_ref_ast::should_ignore_type_name(name) {
                typed_nodes = typed_nodes + 1;
                let found = try type_ref_ast::type_error_for_name_text_with_imports(
                    allocator,
                    file,
                    kinds,
                    arities,
                    name,
                    text,
                    end,
                    absolute_start + start,
                    absolute_start + end,
                    import_alias_starts,
                    import_alias_ends
                );
                if found.found {
                    diagnostics = diagnostics + 1;
                }
            }
            index = end;
        } else {
            index = index + 1;
        }
    }
    return type_reference_scan(index, typed_nodes, diagnostics);
}

fn ast_node_text(
    file: &source::SourceFile,
    ast: &std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return file.text[span.start..span.end];
}

fn type_reference_scan(next: i64, typed_nodes: i64, diagnostics: i64) -> TypeReferenceScan {
    return TypeReferenceScan {
        next: next,
        typed_nodes: typed_nodes,
        diagnostics: diagnostics
    };
}

fn merge_type_reference_scans(left: TypeReferenceScan, right: TypeReferenceScan) -> TypeReferenceScan {
    return type_reference_scan(
        right.next,
        left.typed_nodes + right.typed_nodes,
        left.diagnostics + right.diagnostics
    );
}
