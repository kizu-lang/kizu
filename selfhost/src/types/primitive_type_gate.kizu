import selfhost::types::primitive_type;

// gate exercises the generic primitive text classifier independently from AST
// lookup. Scalar spellings stay test inputs here, outside the descriptor mapper.
pub fn gate() -> void {
    let unsigned = primitive_type::record_from_text("u8");
    std::testing::expect(unsigned.kind == primitive_type::type_kind_integer());
    std::testing::expect(unsigned.bit_width == 8);
    std::testing::expect(!unsigned.signed);

    let signed = primitive_type::record_from_text("i32");
    std::testing::expect(signed.kind == primitive_type::type_kind_integer());
    std::testing::expect(signed.bit_width == 32);
    std::testing::expect(signed.signed);

    expect_unknown("x8");
    expect_unknown("ux");
    expect_unknown("u7x");
    expect_unknown("u128");
    expect_unknown("u24");
    print("primitive-type-contract");
    return;
}

fn expect_unknown(type_text: []u8) -> void {
    let record = primitive_type::record_from_text(type_text);
    std::testing::expect(record.kind == primitive_type::type_kind_unknown());
    return;
}
