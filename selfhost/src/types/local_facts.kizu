import selfhost::source;
import selfhost::types::ast_text;
import selfhost::types::expression_infer;

pub fn collect_function_statement_locals(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    params: std::kizu::ast::ChildRange,
    body: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    var index = 0;
    while index < params.len {
        let child = try ast.child_at(params, index);
        try collect_param_local(file, ast, child, local_types, local_mutability);
        index = index + 1;
    }
    let local_count = try collect_statement_locals_from_node(
        allocator,
        file,
        ast,
        body,
        local_types,
        local_mutability,
        function_returns
    );
    return params.len + local_count;
}
fn collect_param_local(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>
) -> !void {
    let node = ast.get(node_id);
    match node.data {
        Param(param_node) => return collect_param_node_local(
            file,
            ast,
            param_node.name,
            param_node.type_node,
            local_types,
            local_mutability
        );,
        _ => return;,
    }
}

fn collect_param_node_local(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name_id: std::kizu::ast::NodeId,
    type_node: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>
) -> !void {
    let name = ast_text::ast_node_text(file, ast, name_id);
    if !local_types.contains(name) {
        try local_types.insert(name, ast_text::ast_return_type_text(file, ast, type_node));
        try local_mutability.insert(name, false);
    }
    return;
}

fn collect_statement_locals_from_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    var count = 0;
    var index = 0;
    while index < statements.len {
        let child = try ast.child_at(statements, index);
        count = count + try collect_statement_locals_from_node(
            allocator,
            file,
            ast,
            child,
            local_types,
            local_mutability,
            function_returns
        );
        index = index + 1;
    }
    return count;
}

fn collect_statement_locals_from_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    let node = ast.get(node_id);
    match node.data {
        Block(block) => return collect_statement_locals_from_range(
            allocator,
            file,
            ast,
            block.statements,
            local_types,
            local_mutability,
            function_returns
        );,
        Let(let_node) => return collect_let_statement_local_with_expression(
            allocator,
            file,
            ast,
            let_node.mutable,
            let_node.name,
            let_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        Assign(assign_node) => return try collect_expression_locals_from_node(
            allocator,
            file,
            ast,
            assign_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        Return(return_node) => return collect_expression_locals_from_node(
            allocator,
            file,
            ast,
            return_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        ExprStmt(expr_stmt) => return collect_expression_locals_from_node(
            allocator,
            file,
            ast,
            expr_stmt.expr,
            local_types,
            local_mutability,
            function_returns
        );,
        If(if_node) => return collect_statement_locals_from_two_nodes(
            allocator,
            file,
            ast,
            if_node.then_block,
            if_node.else_block,
            local_types,
            local_mutability,
            function_returns
        );,
        While(while_node) => return collect_statement_locals_from_node(
            allocator,
            file,
            ast,
            while_node.body,
            local_types,
            local_mutability,
            function_returns
        );,
        For(for_node) => return collect_statement_locals_from_node(
            allocator,
            file,
            ast,
            for_node.body,
            local_types,
            local_mutability,
            function_returns
        );,
        Match(match_node) => return collect_statement_locals_from_range(
            allocator,
            file,
            ast,
            match_node.arms,
            local_types,
            local_mutability,
            function_returns
        );,
        MatchArm(match_arm) => return collect_match_arm_locals(
            allocator,
            file,
            ast,
            match_arm.pattern,
            match_arm.binding,
            match_arm.body,
            local_types,
            local_mutability,
            function_returns
        );,
        Unsafe(unsafe_node) => return collect_statement_locals_from_node(
            allocator,
            file,
            ast,
            unsafe_node.body,
            local_types,
            local_mutability,
            function_returns
        );,
        ComptimeIf(comptime_if_node) => return collect_statement_locals_from_two_nodes(
            allocator,
            file,
            ast,
            comptime_if_node.then_block,
            comptime_if_node.else_block,
            local_types,
            local_mutability,
            function_returns
        );,
        _ => return 0;,
    }
}

fn collect_match_arm_locals(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    pattern: std::kizu::ast::NodeId,
    binding: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    var count = 0;
    let binding_name = ast_text::ast_node_text(file, ast, binding);
    if !std::mem::equal_bytes(binding_name, "") and !local_types.contains(binding_name) {
        try local_types.insert(binding_name, ast_match_arm_binding_type(file, ast, pattern));
        try local_mutability.insert(binding_name, false);
        count = count + 1;
    }
    return count + try collect_statement_locals_from_node(
        allocator,
        file,
        ast,
        body,
        local_types,
        local_mutability,
        function_returns
    );
}

fn ast_match_arm_binding_type(
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    binding: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(binding);
    match node.data {
        Var(var_node) => return ast_data_payload_type(ast_text::ast_node_text(file, ast, binding));,
        _ => return "unknown";,
    }
}

fn ast_data_payload_type(pattern: []u8) -> []u8 {
    if std::mem::equal_bytes(pattern, "Program") { return "std::kizu::ast::ProgramNode"; }
    if std::mem::equal_bytes(pattern, "Int") { return "std::kizu::ast::IntNode"; }
    if std::mem::equal_bytes(pattern, "String") { return "std::kizu::ast::StringNode"; }
    if std::mem::equal_bytes(pattern, "TypeName") {
        return "std::kizu::ast::TypeNameNode";
    }
    if std::mem::equal_bytes(pattern, "Var") { return "std::kizu::ast::VarNode"; }
    if std::mem::equal_bytes(pattern, "Bool") { return "std::kizu::ast::BoolNode"; }
    if std::mem::equal_bytes(pattern, "Prefix") { return "std::kizu::ast::PrefixNode"; }
    if std::mem::equal_bytes(pattern, "Binary") { return "std::kizu::ast::BinaryNode"; }
    if std::mem::equal_bytes(pattern, "FieldExpr") { return "std::kizu::ast::FieldExprNode"; }
    if std::mem::equal_bytes(pattern, "DerefExpr") { return "std::kizu::ast::DerefExprNode"; }
    if std::mem::equal_bytes(pattern, "Call") { return "std::kizu::ast::CallNode"; }
    if std::mem::equal_bytes(pattern, "TypeApplyExpr") {
        return "std::kizu::ast::TypeApplyExprNode";
    }
    if std::mem::equal_bytes(pattern, "CastExpr") { return "std::kizu::ast::CastExprNode"; }
    if std::mem::equal_bytes(pattern, "IndexExpr") { return "std::kizu::ast::IndexExprNode"; }
    if std::mem::equal_bytes(pattern, "StructLiteralExpr") {
        return "std::kizu::ast::StructLiteralExprNode";
    }
    if std::mem::equal_bytes(pattern, "StructFieldInit") {
        return "std::kizu::ast::StructFieldInitNode";
    }
    if std::mem::equal_bytes(pattern, "ArenaNewExpr") {
        return "std::kizu::ast::ArenaNewExprNode";
    }
    if std::mem::equal_bytes(pattern, "TryExpr") { return "std::kizu::ast::TryExprNode"; }
    if std::mem::equal_bytes(pattern, "ComptimeExpr") { return "std::kizu::ast::ComptimeExprNode"; }
    if std::mem::equal_bytes(pattern, "Block") { return "std::kizu::ast::BlockNode"; }
    if std::mem::equal_bytes(pattern, "If") { return "std::kizu::ast::IfNode"; }
    if std::mem::equal_bytes(pattern, "Let") { return "std::kizu::ast::LetNode"; }
    if std::mem::equal_bytes(pattern, "Assign") { return "std::kizu::ast::AssignNode"; }
    if std::mem::equal_bytes(pattern, "Return") { return "std::kizu::ast::ReturnNode"; }
    if std::mem::equal_bytes(pattern, "Defer") { return "std::kizu::ast::DeferNode"; }
    if std::mem::equal_bytes(pattern, "ExprStmt") { return "std::kizu::ast::ExprStmtNode"; }
    if std::mem::equal_bytes(pattern, "While") { return "std::kizu::ast::WhileNode"; }
    if std::mem::equal_bytes(pattern, "For") { return "std::kizu::ast::ForNode"; }
    if std::mem::equal_bytes(pattern, "Break") { return "std::kizu::ast::BreakNode"; }
    if std::mem::equal_bytes(pattern, "Continue") { return "std::kizu::ast::ContinueNode"; }
    if std::mem::equal_bytes(pattern, "ImportDecl") { return "std::kizu::ast::ImportDeclNode"; }
    if std::mem::equal_bytes(pattern, "Param") { return "std::kizu::ast::ParamNode"; }
    if std::mem::equal_bytes(pattern, "Field") { return "std::kizu::ast::FieldNode"; }
    if std::mem::equal_bytes(pattern, "StructDecl") { return "std::kizu::ast::StructDeclNode"; }
    if std::mem::equal_bytes(pattern, "EnumDecl") { return "std::kizu::ast::EnumDeclNode"; }
    if std::mem::equal_bytes(pattern, "UnionDecl") { return "std::kizu::ast::UnionDeclNode"; }
    if std::mem::equal_bytes(pattern, "ImplDecl") { return "std::kizu::ast::ImplDeclNode"; }
    if std::mem::equal_bytes(pattern, "UnionVariant") { return "std::kizu::ast::UnionVariantNode"; }
    if std::mem::equal_bytes(pattern, "Match") { return "std::kizu::ast::MatchNode"; }
    if std::mem::equal_bytes(pattern, "MatchArm") { return "std::kizu::ast::MatchArmNode"; }
    if std::mem::equal_bytes(pattern, "Unsafe") { return "std::kizu::ast::UnsafeNode"; }
    if std::mem::equal_bytes(pattern, "ComptimeIf") { return "std::kizu::ast::ComptimeIfNode"; }
    if std::mem::equal_bytes(pattern, "FnDecl") { return "std::kizu::ast::FnDeclNode"; }
    return "unknown";
}

fn collect_expression_locals_from_node(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    let node = ast.get(node_id);
    match node.data {
        Match(match_node) => return collect_match_expression_locals(
            allocator,
            file,
            ast,
            match_node.value,
            match_node.arms,
            local_types,
            local_mutability,
            function_returns
        );,
        TryExpr(try_expr_node) => return collect_expression_locals_from_node(
            allocator,
            file,
            ast,
            try_expr_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        ComptimeExpr(comptime_expr_node) => return collect_expression_locals_from_node(
            allocator,
            file,
            ast,
            comptime_expr_node.value,
            local_types,
            local_mutability,
            function_returns
        );,
        _ => return 0;,
    }
}

fn collect_match_expression_locals(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId,
    arms: std::kizu::ast::ChildRange,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    let value_count = try collect_expression_locals_from_node(
        allocator,
        file,
        ast,
        value,
        local_types,
        local_mutability,
        function_returns
    );
    let arm_count = try collect_statement_locals_from_range(
        allocator,
        file,
        ast,
        arms,
        local_types,
        local_mutability,
        function_returns
    );
    return value_count + arm_count;
}

fn collect_statement_locals_from_two_nodes(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    let first_count = try collect_statement_locals_from_node(
        allocator,
        file,
        ast,
        first,
        local_types,
        local_mutability,
        function_returns
    );
    let second_count = try collect_statement_locals_from_node(
        allocator,
        file,
        ast,
        second,
        local_types,
        local_mutability,
        function_returns
    );
    return first_count + second_count;
}

fn collect_let_statement_local_with_expression(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    mutable: bool,
    name_id: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    let local_count = try collect_let_statement_local(
        allocator,
        file,
        ast,
        mutable,
        name_id,
        value,
        local_types,
        local_mutability,
        function_returns
    );
    let expression_count = try collect_expression_locals_from_node(
        allocator,
        file,
        ast,
        value,
        local_types,
        local_mutability,
        function_returns
    );
    return local_count + expression_count;
}

fn collect_let_statement_local(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    mutable: bool,
    name_id: std::kizu::ast::NodeId,
    value: std::kizu::ast::NodeId,
    local_types: &var std::map::Map<[]u8, []u8>,
    local_mutability: &var std::map::Map<[]u8, bool>,
    function_returns: &std::map::Map<[]u8, []u8>
) -> !i64 {
    let name = ast_text::ast_node_text(file, ast, name_id);
    if local_types.contains(name) {
        return 0;
    }
    let type_name = try expression_infer::infer_expression_type(
        allocator,
        file,
        ast,
        value,
        local_types,
        function_returns
    );
    try local_types.insert(name, type_name);
    try local_mutability.insert(name, mutable);
    return 1;
}

pub fn function_statement_return_type(
    allocator: Allocator,
    file: &source::SourceFile,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    function_returns: &std::map::Map<[]u8, []u8>
) -> ![]u8 {
    var qualified = std::string::String(allocator);
    try ast_text::append_module_name(qualified, file);
    try qualified.append_bytes("::");
    try qualified.append_bytes(ast_text::ast_node_text(file, ast, name));
    let key = qualified.as_bytes();
    var expected = ast_text::ast_return_type_text(file, ast, return_type);
    if function_returns.contains(key) {
        expected = try function_returns.get(key);
    }
    qualified.deinit();
    return expected;
}
