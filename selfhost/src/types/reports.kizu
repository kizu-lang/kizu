}

pub fn from_missing_return_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::MissingReturnSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_empty_report(allocator, path);
    try report.message.append_bytes("type error: function `");
    try report.message.append_bytes(summary.name);
    try report.message.append_bytes("` must return ");
    try report.message.append_bytes(summary.expected_return);
    return report;
}

fn type_reference_report(
    allocator: Allocator,
    path: []u8,
    file_text: []u8,
    summary: model::TypeReferenceSummary
) -> !diagnostic::Report {
    let name = file_text[summary.start..summary.end];
    if summary.kind == 1 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: unknown type `");
        try report.message.append_bytes(name);
        try report.message.append_bytes("`");
        return report;
    }
    if summary.kind == 2 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: type `");
        try report.message.append_bytes(name);
        try report.message.append_bytes("` expects ");
        try std::fmt::append_i64(report.message, summary.expected);
        try report.message.append_bytes(" type arguments, got ");
        try std::fmt::append_i64(report.message, summary.observed);
        return report;
    }
    if summary.kind == 3 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: unknown contract `");
        try report.message.append_bytes(name);
        try report.message.append_bytes("`");
        return report;
    }
    if summary.kind == 4 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: unknown generic type `");
        try report.message.append_bytes(name);
        try report.message.append_bytes("`");
        return report;
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try report.message.append_bytes("check failed");
    return report;
}

fn match_report(
    allocator: Allocator,
    path: []u8,
    summary: model::MatchDiagnosticSummary
) -> !diagnostic::Report {
    if summary.kind == 1 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: match expects enum or union, got ");
        try report.message.append_bytes(summary.name);
        return report;
    }
    if summary.kind == 2 {
        return try match_tag_report(
            allocator,
            path,
            "type error: unknown match tag `",
            summary.name,
            summary.tag
        );
    }
    if summary.kind == 3 {
        return try match_tag_report(
            allocator,
            path,
            "type error: duplicate match tag `",
            summary.name,
            summary.tag
        );
    }
    if summary.kind == 4 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: match on `");
        try report.message.append_bytes(summary.name);
        try report.message.append_bytes("` is not exhaustive");
        return report;
    }
    if summary.kind == 5 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: wildcard match arm must be last");
        return report;
    }
    if summary.kind == 6 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: wildcard match arm cannot bind payload");
        return report;
    }
    if summary.kind == 7 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: duplicate wildcard match arm");
        return report;
    }
    if summary.kind == 8 {
        return try match_tag_report(
            allocator,
            path,
            "type error: enum tag has no payload `",
            summary.name,
            summary.tag
        );
    }
    var report = make_empty_report(allocator, path);
    try report.message.append_bytes("check failed");
    return report;
}

pub fn from_unsafe_summary(
    allocator: Allocator,
    file: &source::SourceFile,
    summary: model::UnsafeSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    return try unsafe_report(allocator, file, summary);
}

fn unsafe_report(
    allocator: Allocator,
    file: &source::SourceFile,
    summary: model::UnsafeSummary
) -> !diagnostic::Report {
    let path = file.path;
    if summary.kind == unsafe_rules::kind_missing_capability() {
        return try missing_capability_report(
            allocator, path, summary.start, summary.end,
            summary.capability, summary.operation_kind, summary.operation
        );
    }
    if summary.kind == unsafe_rules::kind_unknown_capability() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "unsafe error: unknown capability `", summary.operation, "`", "", ""
        );
    }
    if summary.kind == unsafe_rules::kind_operand_not_readable_pointer() {
        return try pointer_spelling_report(
            allocator, file, summary.start, summary.end,
            "type error: `", summary.operation,
            "` expects non-null raw pointer, got ", summary.spelling, ""
        );
    }
    if summary.kind == unsafe_rules::kind_operand_not_writable_pointer() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: `", summary.operation,
            "` expects mutable non-null raw pointer", "", ""
        );
    }
    if summary.kind == unsafe_rules::kind_nullable_deref() {
        return try pointer_spelling_report(
            allocator, file, summary.start, summary.end,
            "type error: nullable raw pointer `", "", "", summary.spelling,
            "` cannot be dereferenced"
        );
    }
    if summary.kind == unsafe_rules::kind_const_assign() {
        return try pointer_spelling_report(
            allocator, file, summary.start, summary.end,
            "type error: cannot assign through const raw pointer `", "", "",
            summary.spelling, "`"
        );
    }
    if summary.kind == unsafe_rules::kind_pointer_has_no_fields() {
        return try pointer_spelling_report(
            allocator, file, summary.start, summary.end,
            "type error: `", "", "", summary.spelling, "` has no fields"
        );
    }
    if summary.kind == unsafe_rules::kind_invalid_pointer_cast() {
        return try pointer_cast_report(
            allocator, file, summary.start, summary.end,
            summary.spelling, summary.operation
        );
    }
    if summary.kind == unsafe_rules::kind_boundary_pointer() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: raw pointer cannot cross concurrency boundary", "", "", "", ""
        );
    }
    return try pointer_rule_report(
        allocator, path, summary.start, summary.end, "check failed", "", "", "", ""
    );
}

pub fn from_concurrency_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::ConcurrencySummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    return try concurrency_report(allocator, path, summary);
}

fn concurrency_report(
    allocator: Allocator,
    path: []u8,
    summary: model::ConcurrencySummary
) -> !diagnostic::Report {
    if summary.kind == concurrency::kind_function_param_reserved() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: Function parameter `", summary.subject,
            "` is reserved for std", "", ""
        );
    }
    if summary.kind == concurrency::kind_function_param_comptime() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: Function parameter `", summary.subject,
            "` must be comptime", "", ""
        );
    }
    if summary.kind == concurrency::kind_function_param_borrowed() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: Function parameter `", summary.subject,
            "` cannot be borrowed", "", ""
        );
    }
    if summary.kind == concurrency::kind_builtin_reserved() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: `", summary.subject, "` is reserved; use ", summary.detail, ""
        );
    }
    if summary.kind == concurrency::kind_expects_function_name() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: `", summary.subject, "` expects function name", "", ""
        );
    }
    if summary.kind == concurrency::kind_undefined_function() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: undefined function `", summary.subject, "`", "", ""
        );
    }
    if summary.kind == concurrency::kind_spawn_owned_io() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: spawned function `", summary.subject,
            "` must accept owned Io as first parameter", "", ""
        );
    }
    if summary.kind == concurrency::kind_capture_borrow() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: ", summary.detail, " cannot capture borrow parameter `",
            summary.subject, "`"
        );
    }
    if summary.kind == concurrency::kind_boundary() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: ", summary.detail, "", "", ""
        );
    }
    if summary.kind == concurrency::kind_boundary_field() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: struct `", summary.subject, ".", summary.detail,
            "` cannot cross concurrency boundary"
        );
    }
    if summary.kind == concurrency::kind_constructor_param() {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: ");
        try report.message.append_bytes(summary.subject);
        try report.message.append_bytes(" expects ");
        try report.message.append_bytes(summary.detail);
        try report.message.append_bytes(", got ");
        try report.message.append_bytes(summary.actual);
        return report;
    }
    if summary.kind == concurrency::kind_arg_count() {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: `");
        try report.message.append_bytes(summary.subject);
        try report.message.append_bytes("` expects ");
        try std::fmt::append_i64(report.message, summary.expected);
        try report.message.append_bytes(" args, got ");
        try std::fmt::append_i64(report.message, summary.observed);
        return report;
    }
    return try concurrency_worker_report(allocator, path, summary);
}

fn concurrency_worker_report(
    allocator: Allocator,
    path: []u8,
    summary: model::ConcurrencySummary
) -> !diagnostic::Report {
    if summary.kind == concurrency::kind_parallel_worker_param() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: parallel worker `", summary.subject, "` must accept i64", "", ""
        );
    }
    if summary.kind == concurrency::kind_parallel_worker_return() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: parallel worker `", summary.subject,
            "` must return void or !void", "", ""
        );
    }
    if summary.kind == concurrency::kind_parallel_map_worker_param() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: parallel map worker `", summary.subject,
            "` must accept i64", "", ""
        );
    }
    if summary.kind == concurrency::kind_parallel_map_worker_return() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: parallel map worker `", summary.subject,
            "` must return i64", "", ""
        );
    }
    if summary.kind == concurrency::kind_thread_worker_param() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: thread worker `", summary.subject, "` must accept ",
            summary.detail, ""
        );
    }
    if summary.kind == concurrency::kind_thread_worker_return() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: thread worker `", summary.subject, "` must return ",
            summary.detail, ""
        );
    }
    if summary.kind == concurrency::kind_mutable_argument() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "type error: &var argument `", summary.subject, "` must be mutable", "", ""
        );
    }
    if summary.kind == concurrency::kind_task_incomplete() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "task error: task `", summary.subject,
            "` must be awaited or canceled", "", ""
        );
    }
    if summary.kind == concurrency::kind_task_completed() {
        return try pointer_rule_report(
            allocator, path, summary.start, summary.end,
            "task error: task `", summary.subject, "` was already completed", "", ""
        );
    }
    return try pointer_rule_report(
        allocator, path, summary.start, summary.end, "check failed", "", "", "", ""
    );
}

fn pointer_rule_report(
    allocator: Allocator,
    path: []u8,
    start: i64,
    end: i64,
    prefix: []u8,
    first: []u8,
    middle: []u8,
    second: []u8,
    suffix: []u8
) -> !diagnostic::Report {
    var report = make_report(allocator, path, start, end);
    try report.message.append_bytes(prefix);
    try report.message.append_bytes(first);
    try report.message.append_bytes(middle);
    try report.message.append_bytes(second);
    try report.message.append_bytes(suffix);
    return report;
}

// pointer_spelling_report is pointer_rule_report for a message whose `second` chunk is a
// resolved type: it is printed the way the program spells it rather than the way the
// checker identifies it.
fn pointer_spelling_report(
    allocator: Allocator,
    file: &source::SourceFile,
    start: i64,
    end: i64,
    prefix: []u8,
    first: []u8,
    middle: []u8,
    spelling: []u8,
    suffix: []u8
) -> !diagnostic::Report {
    var report = make_report(allocator, file.path, start, end);
    try report.message.append_bytes(prefix);
    try report.message.append_bytes(first);
    try report.message.append_bytes(middle);
    try append_source_type_spelling(report.message, allocator, file, spelling);
    try report.message.append_bytes(suffix);
    return report;
}

// A rejected cast names both sides. The source side is a resolved type, while the target
// side is the spelling the cast itself wrote, so only the former is rendered back.
fn pointer_cast_report(
    allocator: Allocator,
    file: &source::SourceFile,
    start: i64,
    end: i64,
    spelling: []u8,
    target: []u8
) -> !diagnostic::Report {
    var report = make_report(allocator, file.path, start, end);
    try report.message.append_bytes("type error: cannot cast ");
    try append_source_type_spelling(report.message, allocator, file, spelling);
    try report.message.append_bytes(" to ");
    try report.message.append_bytes(target);
    return report;
}

// The checker qualifies a nominal type this file declares with the file's own module so
// two same-named types from different modules can never be confused. That prefix is an
// identity, not a spelling: a diagnostic quotes the program, so every occurrence of the
// file's own module prefix comes back off before the type is printed.
fn append_source_type_spelling(
    out: &var std::string::String,
    allocator: Allocator,
    file: &source::SourceFile,
    spelling: []u8
) -> !void {
    var prefix = std::string::String(allocator);
    defer prefix.deinit();
    try ast_text::append_module_name(prefix, file);
    try prefix.append_bytes("::");
    let prefix_len = prefix.len();
    let prefix_bytes = prefix.as_bytes();
    let length = std::mem::len(spelling);
    var index = 0;
    while index < length {
        // The length comes off the String and the bytes are compared by index:
        // prefix_bytes borrows that String, and passing a borrowed view into a
        // function -- std::mem::len or std::mem::starts_with alike -- is an escape,
        // while indexing it is not.
        var matched = index + prefix_len <= length;
        var offset = 0;
        while matched and offset < prefix_len {
            if spelling[index + offset] != prefix_bytes[offset] {
                matched = false;
            }
            offset = offset + 1;
        }
        // One assignment advances the cursor. Written with the step in each arm, the
        // terminal if/else is read as a branch-merge latch, and that lowering requires the
        // non-stepping arm to set the counter to the loop's own bound -- 'index = length'
        // here. This one sets it to 'index + prefix_len', so it stops `selfhost stage
        // selfhost` on "branch-merge exit assignment must set the induction to the loop
        // bound".
        var next = index + 1;
        if matched {
            next = index + prefix_len;
        } else {
            try out.append_byte(spelling[index]);
        }
        index = next;
    }
    return;
}

fn missing_capability_report(
    allocator: Allocator,
    path: []u8,
    start: i64,
    end: i64,
    capability: i64,
    operation_kind: i64,
    operation: []u8
) -> !diagnostic::Report {
    var report = make_report(allocator, path, start, end);
    try report.message.append_bytes("unsafe error: ");
    try append_unsafe_operation(report.message, operation_kind, operation);
    try report.message.append_bytes(" requires @unsafe(");
    try report.message.append_bytes(unsafe_capability::capability_name(capability));
    try report.message.append_bytes(")");
    try report.help.append_bytes(unsafe_capability::capability_hint(capability));
    return report;
}

fn append_unsafe_operation(
    message: &var std::string::String,
    operation_kind: i64,
    operation: []u8
) -> !void {
    if operation_kind == unsafe_rules::operation_call() {
        try message.append_bytes("call to `");
        try message.append_bytes(operation);
        try message.append_bytes("`");
        return;
    }
    if operation_kind == unsafe_rules::operation_deref() {
        try message.append_bytes("raw pointer dereference");
        return;
    }
    if operation_kind == unsafe_rules::operation_cast() {
        try message.append_bytes("pointer cast");
        return;
    }
    try message.append_bytes("`");
    try message.append_bytes(operation);
    try message.append_bytes("`");
    return;
}

fn expected_got_report(
    allocator: Allocator,
    path: []u8,
    start: i64,
    end: i64,
    prefix: []u8,
    expected: []u8,
    actual: []u8
) -> !diagnostic::Report {
    var report = make_report(allocator, path, start, end);
    try report.message.append_bytes(prefix);
    try report.message.append_bytes(expected);
    try report.message.append_bytes(", got ");
    try report.message.append_bytes(actual);
    return report;
}

fn match_tag_report(
    allocator: Allocator,
    path: []u8,
    prefix: []u8,
    name: []u8,
    tag: []u8
) -> !diagnostic::Report {
    var report = make_empty_report(allocator, path);
    try report.message.append_bytes(prefix);
    try report.message.append_bytes(name);
    try report.message.append_bytes("::");
    try report.message.append_bytes(tag);
    try report.message.append_bytes("`");
    return report;
}

fn make_report(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64
) -> diagnostic::Report {
    let primary = diagnostic::file_span(path, byte_start, byte_end);
    return diagnostic::error_report(allocator, primary);
}

fn make_empty_report(
    allocator: Allocator,
    path: []u8
) -> diagnostic::Report {
    let primary = diagnostic::empty_span(path);
    return diagnostic::error_report(allocator, primary);
}
