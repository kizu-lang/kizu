import selfhost::diagnostic;
import selfhost::source;
import selfhost::types::ast_text;
import selfhost::types::concurrency;
import selfhost::types::contract_rules;
import selfhost::types::dyn_dispatch;
import selfhost::types::model;
import selfhost::types::struct_literal;
import selfhost::types::type_placement;
import selfhost::types::unsafe_capability;
import selfhost::types::unsafe_rules;
import selfhost::types::visibility;

pub fn from_type_reference_summary(
    allocator: Allocator,
    path: []u8,
    file_text: []u8,
    summary: model::TypeReferenceSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    return try type_reference_report(allocator, path, file_text, summary);
}

pub fn from_match_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::MatchDiagnosticSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    return try match_report(allocator, path, summary);
}

pub fn from_return_type_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::ReturnTypeSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    if summary.literal.found {
        return try integer_literal_range_report(
            allocator, path, summary.start, summary.end,
            summary.literal.digits, summary.literal.negations,
            summary.literal.expected
        );
    }
    return try expected_got_report(
        allocator,
        path,
        summary.start,
        summary.end,
        "type error: return expects ",
        summary.expected,
        summary.actual
    );
}

pub fn from_function_call_summary(
    allocator: Allocator,
    path: []u8,
    file_text: []u8,
    call_error: model::FunctionCallSummary
) -> !diagnostic::Report {
    if !call_error.found {
        return diagnostic::no_report(allocator);
    }
    let name = file_text[call_error.start..call_error.end];
    if call_error.kind == 1 {
        var report = make_report(allocator, path, call_error.start, call_error.end);
        try report.message.append_bytes("type error: undefined function `");
        try report.message.append_bytes(name);
        try report.message.append_bytes("`");
        return report;
    }
    if call_error.kind == 2 {
        var report = make_report(allocator, path, call_error.start, call_error.end);
        try report.message.append_bytes("type error: `");
        try report.message.append_bytes(name);
        try report.message.append_bytes("` expects ");
        try std::fmt::append_i64(report.message, call_error.expected);
        try report.message.append_bytes(" args, got ");
        try std::fmt::append_i64(report.message, call_error.observed);
        return report;
    }
    var report = make_report(allocator, path, call_error.start, call_error.end);
    try report.message.append_bytes("check failed");
    return report;
}

pub fn from_undefined_variable_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::UndefinedVariableSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try report.message.append_bytes("type error: undefined variable `");
    try report.message.append_bytes(summary.name);
    try report.message.append_bytes("`");
    return report;
}

pub fn from_dyn_dispatch_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::DynDispatchSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    if summary.kind == dyn_dispatch::kind_unknown_method() {
        var unknown = make_report(allocator, path, summary.start, summary.end);
        try unknown.message.append_bytes("type error: `dyn ");
        try unknown.message.append_bytes(summary.contract_name);
        try unknown.message.append_bytes("` has no method `");
        try unknown.message.append_bytes(summary.method);
        try unknown.message.append_bytes("`");
        return unknown;
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try report.message.append_bytes("type error: `");
    try report.message.append_bytes(summary.method);
    try report.message.append_bytes("` expects ");
    try std::fmt::append_i64(report.message, summary.expected);
    try report.message.append_bytes(" args, got ");
    try std::fmt::append_i64(report.message, summary.observed);
    return report;
}

// A struct literal is stated without a position: the reference checker names the type and
// the member the verdict is about, which is enough to find it, and reports no span at all
// (internal/types/checker.go:4951).
pub fn from_struct_literal_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::StructLiteralSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_empty_report(allocator, path);
    try append_struct_literal_message(report.message, summary);
    return report;
}

fn append_struct_literal_message(
    message: &var std::string::String,
    summary: model::StructLiteralSummary
) -> !void {
    if summary.literal.found {
        return append_integer_literal_range_message(
            message,
            summary.literal.digits,
            summary.literal.negations,
            summary.literal.expected
        );
    }
    if summary.kind == struct_literal::kind_unknown_struct() {
        return append_joined(
            message, "type error: unknown struct `", summary.type_name, "`"
        );
    }
    if summary.kind == struct_literal::kind_missing_field() {
        return append_member_joined(
            message,
            "type error: missing field `", summary.type_name, ".", summary.field, "`"
        );
    }
    if summary.kind == struct_literal::kind_unknown_field() {
        return append_member_joined(
            message,
            "type error: unknown field `", summary.type_name, ".", summary.field, "`"
        );
    }
    try append_member_joined(
        message,
        "type error: field `", summary.type_name, ".", summary.field, "` expects "
    );
    try message.append_bytes(summary.expected);
    try message.append_bytes(", got ");
    try message.append_bytes(summary.actual);
    return;
}

pub fn from_visibility_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::VisibilitySummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try report.message.append_bytes("type error: public ");
    try append_published_position(
        report.message, summary.kind, summary.owner, summary.member
    );
    try report.message.append_bytes(" exposes private type `");
    try report.message.append_bytes(summary.type_name);
    try report.message.append_bytes("`");
    return report;
}

// The published position names the declaration that carries it, and a member position
// names the member inside that declaration with the separator the language writes.
fn append_published_position(
    message: &var std::string::String,
    kind: i64,
    owner: []u8,
    member: []u8
) -> !void {
    if kind == visibility::kind_function_param() {
        return try append_owner_position(message, "function `", owner, "` parameter");
    }
    if kind == visibility::kind_function_return() {
        return try append_owner_position(message, "function `", owner, "` return type");
    }
    if kind == visibility::kind_struct_field() {
        return try append_member_position(message, "field `", owner, ".", member);
    }
    return try append_member_position(message, "union variant `", owner, "::", member);
}

fn append_owner_position(
    message: &var std::string::String,
    prefix: []u8,
    name: []u8,
    suffix: []u8
) -> !void {
    try message.append_bytes(prefix);
    try message.append_bytes(name);
    try message.append_bytes(suffix);
    return;
}

fn append_member_position(
    message: &var std::string::String,
    prefix: []u8,
    owner: []u8,
    separator: []u8,
    member: []u8
) -> !void {
    try message.append_bytes(prefix);
    try message.append_bytes(owner);
    try message.append_bytes(separator);
    try message.append_bytes(member);
    try message.append_bytes("`");
    return;
}

pub fn from_impl_method_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::ImplMethodSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try report.message.append_bytes("type error: duplicate impl method `");
    try report.message.append_bytes(summary.type_name);
    try report.message.append_bytes(".");
    try report.message.append_bytes(summary.method);
    try report.message.append_bytes("`");
    return report;
}

pub fn from_contract_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::ContractSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    return try contract_report(allocator, path, summary);
}

fn contract_report(
    allocator: Allocator,
    path: []u8,
    summary: model::ContractSummary
) -> !diagnostic::Report {
    if summary.kind == 1 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: `");
        try report.message.append_bytes(summary.subject);
        try report.message.append_bytes("` does not satisfy `");
        try report.message.append_bytes(summary.contract_name);
        try report.message.append_bytes("`: missing method `");
        try report.message.append_bytes(summary.method);
        try report.message.append_bytes("`");
        return report;
    }
    if summary.kind == 2 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: `");
        try report.message.append_bytes(summary.subject);
        try report.message.append_bytes(".");
        try report.message.append_bytes(summary.method);
        try report.message.append_bytes("` does not match contract `");
        try report.message.append_bytes(summary.contract_name);
        try report.message.append_bytes("`");
        return report;
    }
    if summary.kind == 3 {
        return try dyn_parameter_report(
            allocator, path, summary.start, summary.end, summary.subject, "` must be borrowed"
        );
    }
    if summary.kind == 4 {
        return try dyn_parameter_report(
            allocator,
            path,
            summary.start,
            summary.end,
            summary.subject,
            "` must use immutable borrow in v0"
        );
    }
    return try dyn_parameter_report(
        allocator,
        path,
        summary.start,
        summary.end,
        summary.subject,
        "` must use &dyn Contract"
    );
}

fn dyn_parameter_report(
    allocator: Allocator,
    path: []u8,
    start: i64,
    end: i64,
    parameter: []u8,
    suffix: []u8
) -> !diagnostic::Report {
    var report = make_report(allocator, path, start, end);
    try report.message.append_bytes("type error: dyn parameter `");
    try report.message.append_bytes(parameter);
    try report.message.append_bytes(suffix);
    return report;
}

pub fn from_type_placement_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::TypePlacementSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try append_type_placement_message(report.message, summary);
    return report;
}

// The signature positions name the declaration that owns them; the storage positions name
// the member inside it, with the separator the language writes between the two.
fn append_type_placement_message(
    message: &var std::string::String,
    summary: model::TypePlacementSummary
) -> !void {
    if summary.kind == type_placement::kind_parameter_void() {
        return append_joined(
            message, "type error: parameter `", summary.member, "` cannot have type void"
        );
    }
    if summary.kind == type_placement::kind_parameter_type() {
        return append_joined(
            message, "type error: parameter `", summary.member, "` cannot have type"
        );
    }
    if summary.kind == type_placement::kind_return_type() {
        return append_joined(
            message, "type error: function `", summary.owner, "` cannot return type"
        );
    }
    if summary.kind == type_placement::kind_return_dyn() {
        return append_joined(
            message, "type error: function `", summary.owner, "` cannot return dyn"
        );
    }
    if summary.kind == type_placement::kind_local_type() {
        return append_joined(
            message, "type error: type value cannot be stored in local `", summary.member, "`"
        );
    }
    return append_stored_placement_message(message, summary);
}

fn append_stored_placement_message(
    message: &var std::string::String,
    summary: model::TypePlacementSummary
) -> !void {
    if summary.kind == type_placement::kind_field_type() {
        return append_member_joined(
            message,
            "type error: struct field `",
            summary.owner,
            ".",
            summary.member,
            "` cannot store type value"
        );
    }
    if summary.kind == type_placement::kind_field_dyn() {
        return append_member_joined(
            message,
            "type error: struct field `",
            summary.owner,
            ".",
            summary.member,
            "` cannot store dyn value"
        );
    }
    if summary.kind == type_placement::kind_variant_type() {
        return append_member_joined(
            message,
            "type error: union variant `",
            summary.owner,
            "::",
            summary.member,
            "` cannot store type value"
        );
    }
    if summary.kind == type_placement::kind_variant_dyn() {
        return append_member_joined(
            message,
            "type error: union variant `",
            summary.owner,
            "::",
            summary.member,
            "` cannot store dyn value"
        );
    }
    try message.append_bytes("check failed");
    return;
}

fn append_joined(
    message: &var std::string::String,
    prefix: []u8,
    name: []u8,
    suffix: []u8
) -> !void {
    try message.append_bytes(prefix);
    try message.append_bytes(name);
    try message.append_bytes(suffix);
    return;
}

fn append_member_joined(
    message: &var std::string::String,
    prefix: []u8,
    owner: []u8,
    separator: []u8,
    member: []u8,
    suffix: []u8
) -> !void {
    try message.append_bytes(prefix);
    try message.append_bytes(owner);
    try message.append_bytes(separator);
    try message.append_bytes(member);
    try message.append_bytes(suffix);
    return;
}

pub fn from_argument_type_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::ArgumentTypeSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    if summary.literal.found {
        return try integer_literal_range_report(
            allocator, path, summary.start, summary.end,
            summary.literal.digits, summary.literal.negations,
            summary.literal.expected
        );
    }
    if summary.kind == 1 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: ");
        try report.message.append_bytes(contract_rules::last_type_segment(summary.actual));
        try report.message.append_bytes(" does not satisfy `");
        try report.message.append_bytes(summary.expected);
        try report.message.append_bytes("`");
        return report;
    }
    return try expected_got_report(
        allocator,
        path,
        summary.start,
        summary.end,
        "type error: argument expects ",
        summary.expected,
        summary.actual
    );
}

// integer_literal_range_report states the one diagnostic every position shares for a
// literal written outside the range of the integer type expected there. The literal is
// spelled the way the expression prints itself: the digits, wrapped in `(-` ... `)` once
// per negation applied to them.
fn integer_literal_range_report(
    allocator: Allocator,
    path: []u8,
    start: i64,
    end: i64,
    digits: []u8,
    negations: i64,
    expected: []u8
) -> !diagnostic::Report {
    var report = make_report(allocator, path, start, end);
    try append_integer_literal_range_message(report.message, digits, negations, expected);
    return report;
}

fn append_integer_literal_range_message(
    message: &var std::string::String,
    digits: []u8,
    negations: i64,
    expected: []u8
) -> !void {
    try message.append_bytes("type error: integer literal `");
    var opened = 0;
    while opened < negations {
        try message.append_bytes("(-");
        opened = opened + 1;
    }
    try message.append_bytes(digits);
    var closed = 0;
    while closed < negations {
        try message.append_bytes(")");
        closed = closed + 1;
    }
    try message.append_bytes("` does not fit ");
    try message.append_bytes(expected);
    return;
}

