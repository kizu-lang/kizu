    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try report.message.append_bytes("type error: invalid assignment target `");
    try report.message.append_bytes(file_text[summary.start..summary.end]);
