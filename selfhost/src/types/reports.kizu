        summary.actual
    );
}

pub fn from_binary_operand_type_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::ArgumentTypeSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try report.message.append_bytes("type error: operator operands must have same type");
    try report.note_1.append_bytes("left operand has type ");
    try report.note_1.append_bytes(summary.expected);
    try report.note_2.append_bytes("right operand has type ");
    try report.note_2.append_bytes(summary.actual);
    return report;
}

pub fn from_missing_return_summary(
    allocator: Allocator,
    path: []u8,
    summary: model::MissingReturnSummary
) -> !diagnostic::Report {
    if !summary.found {
        return diagnostic::no_report(allocator);
    }
    var report = make_empty_report(allocator, path);
    try report.message.append_bytes("type error: function `");
    try report.message.append_bytes(summary.name);
    try report.message.append_bytes("` must return ");
    try report.message.append_bytes(summary.expected_return);
    return report;
}

fn type_reference_report(
    allocator: Allocator,
    path: []u8,
    file_text: []u8,
    summary: model::TypeReferenceSummary
) -> !diagnostic::Report {
    let name = file_text[summary.start..summary.end];
    if summary.kind == 1 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: unknown type `");
        try report.message.append_bytes(name);
        try report.message.append_bytes("`");
        return report;
    }
    if summary.kind == 2 {
        var report = make_report(allocator, path, summary.start, summary.end);
        try report.message.append_bytes("type error: type `");
        try report.message.append_bytes(name);
        try report.message.append_bytes("` expects ");
        try std::fmt::append_i64(report.message, summary.expected);
        try report.message.append_bytes(" type arguments, got ");
        try std::fmt::append_i64(report.message, summary.observed);
        return report;
    }
    var report = make_report(allocator, path, summary.start, summary.end);
    try report.message.append_bytes("check failed");
    return report;
}

fn match_report(
    allocator: Allocator,
    path: []u8,
    summary: model::MatchDiagnosticSummary
) -> !diagnostic::Report {
    if summary.kind == 1 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: match expects enum or union, got ");
        try report.message.append_bytes(summary.name);
        return report;
    }
    if summary.kind == 2 {
        return try match_tag_report(
            allocator,
            path,
            "type error: unknown match tag `",
            summary.name,
            summary.tag
        );
    }
    if summary.kind == 3 {
        return try match_tag_report(
            allocator,
            path,
            "type error: duplicate match tag `",
            summary.name,
            summary.tag
        );
    }
    if summary.kind == 4 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: match on `");
        try report.message.append_bytes(summary.name);
        try report.message.append_bytes("` is not exhaustive");
        return report;
    }
    if summary.kind == 5 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: wildcard match arm must be last");
        return report;
    }
    if summary.kind == 6 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: wildcard match arm cannot bind payload");
        return report;
    }
    if summary.kind == 7 {
        var report = make_empty_report(allocator, path);
        try report.message.append_bytes("type error: duplicate wildcard match arm");
        return report;
    }
    if summary.kind == 8 {
        return try match_tag_report(
            allocator,
            path,
            "type error: enum tag has no payload `",
            summary.name,
            summary.tag
        );
    }
    var report = make_empty_report(allocator, path);
    try report.message.append_bytes("check failed");
    return report;
}

fn expected_got_report(
    allocator: Allocator,
    path: []u8,
    start: i64,
    end: i64,
    prefix: []u8,
    expected: []u8,
    actual: []u8
) -> !diagnostic::Report {
    var report = make_report(allocator, path, start, end);
    try report.message.append_bytes(prefix);
    try report.message.append_bytes(expected);
    try report.message.append_bytes(", got ");
    try report.message.append_bytes(actual);
    return report;
}

fn match_tag_report(
    allocator: Allocator,
    path: []u8,
    prefix: []u8,
    name: []u8,
    tag: []u8
) -> !diagnostic::Report {
    var report = make_empty_report(allocator, path);
    try report.message.append_bytes(prefix);
    try report.message.append_bytes(name);
    try report.message.append_bytes("::");
    try report.message.append_bytes(tag);
    try report.message.append_bytes("`");
    return report;
}

fn make_report(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64
) -> diagnostic::Report {
    let primary = diagnostic::file_span(path, byte_start, byte_end);
    return diagnostic::error_report(allocator, primary);
}

fn make_empty_report(
    allocator: Allocator,
    path: []u8
) -> diagnostic::Report {
    let primary = diagnostic::empty_span(path);
    return diagnostic::error_report(allocator, primary);
}
