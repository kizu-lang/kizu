// Ordered semantic ABI signatures use semicolon-separated Kizu type spellings.
// This module is the single parser shared by external entrypoints and runtime
// method descriptors. Empty slots and trailing separators are malformed rather
// than silently changing arity.
pub fn count(param_types: []u8) -> !i64 {
    let byte_len = std::mem::len(param_types);
    if byte_len == 0 { return 0; }
    var count = 1;
    var start = 0;
    var index = 0;
    while index <= byte_len {
        if index == byte_len or param_types[index] == cast<u8>(59) {
            if start == index {
                return error("semantic signature: empty parameter type");
            }
            if index < byte_len { count = count + 1; }
            start = index + 1;
        }
        index = index + 1;
    }
    return count;
}

pub fn type_at(param_types: []u8, wanted: i64) -> ![]u8 {
    if wanted < 0 {
        return error("semantic signature: parameter index out of range");
    }
    let param_count = try count(param_types);
    if wanted >= param_count {
        return error("semantic signature: parameter index out of range");
    }
    let byte_len = std::mem::len(param_types);
    var slot = 0;
    var start = 0;
    var index = 0;
    while index <= byte_len {
        if index == byte_len or param_types[index] == cast<u8>(59) {
            if slot == wanted { return param_types[start..index]; }
            slot = slot + 1;
            start = index + 1;
        }
        index = index + 1;
    }
    return error("semantic signature: parameter index out of range");
}

pub fn valid_gate() -> !void {
    std::testing::expect(try count("") == 0);
    std::testing::expect(try count("[]u8;i64") == 2);
    std::testing::expect_equal<[]u8>("[]u8", try type_at("[]u8;i64", 0));
    std::testing::expect_equal<[]u8>("i64", try type_at("[]u8;i64", 1));
    return;
}

pub fn out_of_range_gate() -> !void {
    print(try type_at("[]u8", 1));
    return;
}

pub fn empty_slot_gate() -> !void {
    print(try type_at("[]u8;;i64", 0));
    return;
}

pub fn trailing_separator_gate() -> !void {
    print(try type_at("[]u8;", 0));
    return;
}
