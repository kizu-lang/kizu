import selfhost::abi::fixed_abi_contract;

// This module owns the fixed process-entry ABI shared by generated run
// artifacts and the hosted C shim. Source function identities never belong
// here; they are supplied by program-entry facts.
pub fn run_entry_symbol() -> []u8 {
    return "kizu_run_main";
}

pub fn c_main_symbol() -> []u8 {
    return "main";
}

pub fn host_init_symbol() -> []u8 {
    return "kizu_host_init";
}

pub fn main_error_message_symbol() -> []u8 {
    return "kizu_main_error_message";
}

pub fn process_exit_code_symbol() -> []u8 {
    return "kizu_rt_process_exit_code";
}

pub fn run_entry_return_abi() -> fixed_abi_contract::FixedAbi {
    return fixed_abi_contract::describe(fixed_abi_contract::FixedAbiKind::Integer64);
}

pub fn c_main_return_abi() -> fixed_abi_contract::FixedAbi {
    return fixed_abi_contract::describe(fixed_abi_contract::FixedAbiKind::Integer32);
}

pub fn c_argc_abi() -> fixed_abi_contract::FixedAbi {
    return fixed_abi_contract::describe(fixed_abi_contract::FixedAbiKind::Integer32);
}

pub fn c_argv_abi() -> fixed_abi_contract::FixedAbi {
    return fixed_abi_contract::describe(fixed_abi_contract::FixedAbiKind::Pointer);
}

pub fn success_exit_code() -> i64 {
    return 0;
}

pub fn failure_exit_code() -> i64 {
    return 1;
}
