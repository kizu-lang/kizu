import selfhost::ir::intrinsic_type_contract;
import selfhost::type_spelling;

// is_builtin_application resolves syntax through the exact builtin type
// constructor registry. A generic function application is never classified as
// a type constructor merely because it has `<...>` syntax.
pub fn is_builtin_application(spelling: []u8) -> !bool {
    let parsed = try type_spelling::parse(spelling);
    if !parsed.has_arguments { return false; }
    let name = try type_spelling::constructor(&parsed, spelling);
    return is_builtin_name(name);
}

pub fn is_builtin_name(name: []u8) -> bool {
    let kind = intrinsic_type_contract::from_source_name(name);
    return kind >= 0 and intrinsic_type_contract::arity(kind) > 0;
}
