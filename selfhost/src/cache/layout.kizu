pub fn cache_root_dir() -> []u8 {
    return "target/selfhost/cache";
}

// Entries use target/selfhost/cache/entries/*.meta and artifacts/*.artifact.
pub fn cache_entry_dir() -> []u8 {
    return "target/selfhost/cache/entries";
}

pub fn cache_artifact_dir() -> []u8 {
    return "target/selfhost/cache/artifacts";
}

pub fn cache_entry_metadata_path(
    allocator: Allocator,
    fingerprint: i64
) -> !std::string::String {
    var out = std::string::String(allocator);
    try out.append_bytes(cache_entry_dir());
    try out.append_byte(cast<u8>(47));
    try std::fmt::append_i64(out, fingerprint);
    try out.append_bytes(".meta");
    return out;
}

pub fn cache_entry_artifact_path(
    allocator: Allocator,
    fingerprint: i64
) -> !std::string::String {
    var out = std::string::String(allocator);
    try out.append_bytes(cache_artifact_dir());
    try out.append_byte(cast<u8>(47));
    try std::fmt::append_i64(out, fingerprint);
    try out.append_bytes(".artifact");
    return out;
}

pub fn ensure_cache_layout(io: Io) -> !void {
    if !(try std::fs::exists(io, "target")) {
        try std::fs::create_dir(io, "target");
    }
    if !(try std::fs::exists(io, "target/selfhost")) {
        try std::fs::create_dir(io, "target/selfhost");
    }
    if !(try std::fs::exists(io, cache_root_dir())) {
        try std::fs::create_dir(io, cache_root_dir());
    }
    if !(try std::fs::exists(io, cache_entry_dir())) {
        try std::fs::create_dir(io, cache_entry_dir());
    }
    if !(try std::fs::exists(io, cache_artifact_dir())) {
        try std::fs::create_dir(io, cache_artifact_dir());
    }
    return;
}
