import selfhost::cache::key;
import selfhost::cache::layout;
import selfhost::cache::metadata;

pub struct Lookup {
    pub found: bool,
    pub fingerprint: i64,
    pub input_description: []u8,
    pub artifact_path: []u8,
}

pub fn write_entry(
    allocator: Allocator,
    io: Io,
    compiler_version: []u8,
    manifest_path: []u8,
    manifest_hash: []u8,
    module_graph_hash: []u8,
    source_hashes: []u8,
    public_interface_hash: []u8,
    target: []u8,
    backend_name: []u8,
    optimization_mode_name: []u8,
    stdlib_hash: []u8,
    stdlib_version: []u8,
    artifact: []u8
) -> !metadata::EntryMetadata {
    try layout::ensure_cache_layout(io);

    let fingerprint = key::compute_fingerprint(
        compiler_version,
        manifest_path,
        manifest_hash,
        module_graph_hash,
        source_hashes,
        public_interface_hash,
        target,
        backend_name,
        optimization_mode_name,
        stdlib_hash,
        stdlib_version
    );
    var artifact_path = try layout::cache_entry_artifact_path(allocator, fingerprint);
    let artifact_path_bytes = artifact_path.as_bytes();
    try std::fs::write_file(io, artifact_path_bytes, artifact);

    var input_description = try metadata::render_input_description(
        allocator,
        compiler_version,
        manifest_path,
        manifest_hash,
        module_graph_hash,
        source_hashes,
        public_interface_hash,
        target,
        backend_name,
        optimization_mode_name,
        stdlib_hash,
        stdlib_version
    );
    let input_description_bytes = input_description.as_bytes();
    var metadata_path = try layout::cache_entry_metadata_path(allocator, fingerprint);
    var metadata_bytes = std::string::String(allocator);
    try metadata::append_line(metadata_bytes, "kizu-cache-entry-v0");
    try metadata_bytes.append_bytes("fingerprint ");
    try std::fmt::append_i64(metadata_bytes, fingerprint);
    try metadata_bytes.append_byte(cast<u8>(10));
    try metadata_bytes.append_bytes("input-description ");
    try metadata_bytes.append_bytes(input_description_bytes);
    try metadata_bytes.append_byte(cast<u8>(10));
    try metadata_bytes.append_bytes("artifact ");
    try metadata_bytes.append_bytes(artifact_path_bytes);
    try metadata_bytes.append_byte(cast<u8>(10));
    let metadata_path_bytes = metadata_path.as_bytes();
    let metadata_view = metadata_bytes.as_bytes();
    try std::fs::write_file(io, metadata_path_bytes, metadata_view);
    metadata_path.deinit();
    metadata_bytes.deinit();
    input_description.deinit();
    artifact_path.deinit();
    return try read_entry(allocator, io, fingerprint);
}

pub fn read_entry(
    allocator: Allocator,
    io: Io,
    fingerprint: i64
) -> !metadata::EntryMetadata {
    var metadata_path = try layout::cache_entry_metadata_path(allocator, fingerprint);
    let metadata_path_bytes = metadata_path.as_bytes();
    let metadata_text = try std::fs::read_file(io, metadata_path_bytes);
    metadata_path.deinit();
    let entry_metadata = try metadata::parse_entry_metadata(allocator, metadata_text);
    return entry_metadata;
}

pub fn lookup_entry(
    allocator: Allocator,
    io: Io,
    fingerprint: i64
) -> !Lookup {
    var metadata_path = try layout::cache_entry_metadata_path(allocator, fingerprint);
    let metadata_path_bytes = metadata_path.as_bytes();
    let found = try std::fs::exists(io, metadata_path_bytes);
    metadata_path.deinit();
    if !found {
        return Lookup {
            found: false,
            fingerprint: 0,
            input_description: "",
            artifact_path: ""
        };
    }

    let entry_metadata = try read_entry(allocator, io, fingerprint);
    return Lookup {
        found: true,
        fingerprint: entry_metadata.fingerprint,
        input_description: entry_metadata.input_description,
        artifact_path: entry_metadata.artifact_path
    };
}
