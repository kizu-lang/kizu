pub fn compute_fingerprint(
    compiler_version: []u8,
    manifest_path: []u8,
    manifest_hash: []u8,
    module_graph_hash: []u8,
    source_hashes: []u8,
    public_interface_hash: []u8,
    target: []u8,
    backend_name: []u8,
    optimization_mode_name: []u8,
    stdlib_hash: []u8,
    stdlib_version: []u8
) -> i64 {
    var state = 17;
    state = mix_field(state, "compiler-version", compiler_version);
    state = mix_field(state, "manifest-path", manifest_path);
    state = mix_field(state, "manifest-hash", manifest_hash);
    state = mix_field(state, "module-graph-hash", module_graph_hash);
    state = mix_field(state, "source-hashes", source_hashes);
    state = mix_field(state, "public-interface-hash", public_interface_hash);
    state = mix_field(state, "target", target);
    state = mix_field(state, "backend", backend_name);
    state = mix_field(state, "optimization-mode", optimization_mode_name);
    state = mix_field(state, "stdlib-hash", stdlib_hash);
    state = mix_field(state, "stdlib-version", stdlib_version);
    return state;
}

fn mix_field(state: i64, name: []u8, value: []u8) -> i64 {
    var next = mix_bytes(state, name);
    next = mix_byte(next, cast<u8>(0));
    next = mix_len(next, std::mem::len(value));
    next = mix_byte(next, cast<u8>(0));
    next = mix_bytes(next, value);
    next = mix_byte(next, cast<u8>(10));
    return next;
}

fn mix_len(state: i64, length: i64) -> i64 {
    var next = state;
    var current = length;
    if current == 0 {
        return mix_byte(next, cast<u8>(48));
    }
    while current > 0 {
        let digit = current % 10;
        next = mix_byte(next, cast<u8>(48 + digit));
        current = current / 10;
    }
    return next;
}

fn mix_bytes(state: i64, bytes: []u8) -> i64 {
    var next = state;
    var index = 0;
    while index < std::mem::len(bytes) {
        next = mix_byte(next, bytes[index]);
        index = index + 1;
    }
    return next;
}

fn mix_byte(state: i64, byte: u8) -> i64 {
    return ((state * 257) + cast<i64>(byte) + 1) % 1000000007;
}
