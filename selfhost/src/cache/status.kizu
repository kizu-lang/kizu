import selfhost::cache::layout;

pub struct Status {
    pub entries: i64,
    pub size_bytes: i64,
}

pub fn cache_status(io: Io) -> !Status {
    try layout::ensure_cache_layout(io);
    var entry_files = try std::fs::read_dir(io, layout::cache_entry_dir());
    var artifact_files = try std::fs::read_dir(io, layout::cache_artifact_dir());
    var entries = 0;
    var bytes = 0;

    var entry_index = 0;
    while entry_index < entry_files.len() {
        let entry = try entry_files.get(entry_index);
        if !entry.is_dir {
            entries = entries + 1;
        }
        entry_index = entry_index + 1;
    }

    var artifact_index = 0;
    while artifact_index < artifact_files.len() {
        let artifact = try artifact_files.get(artifact_index);
        if !artifact.is_dir {
            let metadata = try std::fs::metadata(io, artifact.path);
            bytes = bytes + metadata.size;
        }
        artifact_index = artifact_index + 1;
    }

    entry_files.deinit();
    artifact_files.deinit();
    return Status {
        entries: entries,
        size_bytes: bytes
    };
}
