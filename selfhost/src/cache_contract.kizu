// Module: cache contract boundary for deterministic future compiler artifacts.

pub enum RebuildReason {
    None
    SourceChanged
    StdChanged
    TargetChanged
    CompilerChanged
}

pub struct CacheInput {
    pub compiler_version: []const u8;
    pub target: []const u8;
    pub backend: []const u8;
    pub optimization: []const u8;
    pub source_hash: []const u8;
    pub std_hash: []const u8;
}

pub struct RebuildSummary {
    pub reason: RebuildReason;
    pub must_rebuild: bool;
}

// input creates the deterministic cache key input summary.
pub fn input(
    compiler_version: []const u8,
    target: []const u8,
    backend: []const u8,
    optimization: []const u8,
    source_hash: []const u8,
    std_hash: []const u8
) -> CacheInput {
    return CacheInput {
        compiler_version: compiler_version,
        target: target,
        backend: backend,
        optimization: optimization,
        source_hash: source_hash,
        std_hash: std_hash,
    };
}

// rebuild_reason compares two cache inputs and returns the first changed fact.
pub fn rebuild_reason(previous: &CacheInput, current: &CacheInput) -> RebuildSummary {
    if !std::mem::equal_bytes(previous.compiler_version, current.compiler_version) {
        return changed(RebuildReason::CompilerChanged);
    }
    if !std::mem::equal_bytes(previous.target, current.target) {
        return changed(RebuildReason::TargetChanged);
    }
    if !std::mem::equal_bytes(previous.backend, current.backend) {
        return changed(RebuildReason::TargetChanged);
    }
    if !std::mem::equal_bytes(previous.optimization, current.optimization) {
        return changed(RebuildReason::TargetChanged);
    }
    if !std::mem::equal_bytes(previous.std_hash, current.std_hash) {
        return changed(RebuildReason::StdChanged);
    }
    if !std::mem::equal_bytes(previous.source_hash, current.source_hash) {
        return changed(RebuildReason::SourceChanged);
    }
    return RebuildSummary {
        reason: RebuildReason::None,
        must_rebuild: false,
    };
}

// changed constructs a positive rebuild summary.
fn changed(reason: RebuildReason) -> RebuildSummary {
    return RebuildSummary {
        reason: reason,
        must_rebuild: true,
    };
}

// ready exposes cache contract checks to package-level resolution.
pub fn ready() -> bool {
    return true;
}
