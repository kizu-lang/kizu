// Module: cache contract boundary for deterministic future compiler artifacts.

pub enum RebuildReason {
    None
    ManifestChanged
    ModuleGraphChanged
    PublicInterfaceChanged
    SourceChanged
    SourceOnlyChanged
    StdChanged
    TargetChanged
    CompilerChanged
}

pub struct CacheInput {
    pub compiler_version: []const u8;
    pub target: []const u8;
    pub backend: []const u8;
    pub optimization: []const u8;
    pub input_kind: []const u8;
    pub manifest_hash: []const u8;
    pub module_graph_hash: []const u8;
    pub source_hash: []const u8;
    pub public_interface_hash: []const u8;
    pub std_hash: []const u8;
}

pub struct RebuildSummary {
    pub reason: RebuildReason;
    pub must_rebuild: bool;
}

// input creates the deterministic cache key input summary.
pub fn input(
    compiler_version: []const u8,
    target: []const u8,
    backend: []const u8,
    optimization: []const u8,
    input_kind: []const u8,
    manifest_hash: []const u8,
    module_graph_hash: []const u8,
    source_hash: []const u8,
    public_interface_hash: []const u8,
    std_hash: []const u8
) -> CacheInput {
    return CacheInput {
        compiler_version: compiler_version,
        target: target,
        backend: backend,
        optimization: optimization,
        input_kind: input_kind,
        manifest_hash: manifest_hash,
        module_graph_hash: module_graph_hash,
        source_hash: source_hash,
        public_interface_hash: public_interface_hash,
        std_hash: std_hash,
    };
}

// rebuild_reason compares two cache inputs and returns the first changed fact.
pub fn rebuild_reason(previous: &CacheInput, current: &CacheInput) -> RebuildSummary {
    if !std::mem::equal_bytes(previous.compiler_version, current.compiler_version) {
        return changed(RebuildReason::CompilerChanged);
    }
    if !std::mem::equal_bytes(previous.target, current.target) {
        return changed(RebuildReason::TargetChanged);
    }
    if !std::mem::equal_bytes(previous.backend, current.backend) {
        return changed(RebuildReason::TargetChanged);
    }
    if !std::mem::equal_bytes(previous.optimization, current.optimization) {
        return changed(RebuildReason::TargetChanged);
    }
    if !std::mem::equal_bytes(previous.input_kind, current.input_kind) {
        return changed(RebuildReason::TargetChanged);
    }
    if !std::mem::equal_bytes(previous.manifest_hash, current.manifest_hash) {
        return changed(RebuildReason::ManifestChanged);
    }
    if !std::mem::equal_bytes(previous.module_graph_hash, current.module_graph_hash) {
        return changed(RebuildReason::ModuleGraphChanged);
    }
    if !std::mem::equal_bytes(
        previous.public_interface_hash,
        current.public_interface_hash
    ) {
        return changed(RebuildReason::PublicInterfaceChanged);
    }
    if !std::mem::equal_bytes(previous.source_hash, current.source_hash) {
        if std::mem::equal_bytes(current.input_kind, "package") {
            return changed(RebuildReason::SourceOnlyChanged);
        }
        return changed(RebuildReason::SourceChanged);
    }
    if !std::mem::equal_bytes(previous.std_hash, current.std_hash) {
        return changed(RebuildReason::StdChanged);
    }
    return RebuildSummary {
        reason: RebuildReason::None,
        must_rebuild: false,
    };
}

// reason_name returns the user-facing why-rebuild reason.
pub fn reason_name(reason: RebuildReason) -> []const u8 {
    if reason == RebuildReason::None {
        return "cache hit";
    }
    if reason == RebuildReason::ManifestChanged {
        return "cache miss: manifest changed";
    }
    if reason == RebuildReason::ModuleGraphChanged {
        return "cache miss: module graph changed";
    }
    if reason == RebuildReason::PublicInterfaceChanged {
        return "cache miss: public interface changed";
    }
    if reason == RebuildReason::SourceOnlyChanged {
        return "cache miss: source changed without public interface change";
    }
    if reason == RebuildReason::SourceChanged {
        return "cache miss: source changed";
    }
    if reason == RebuildReason::StdChanged {
        return "cache miss: stdlib changed";
    }
    if reason == RebuildReason::CompilerChanged {
        return "cache miss: compiler cache version changed";
    }
    return "cache miss: build target changed";
}

// changed constructs a positive rebuild summary.
fn changed(reason: RebuildReason) -> RebuildSummary {
    return RebuildSummary {
        reason: reason,
        must_rebuild: true,
    };
}

// ready exposes cache contract checks to package-level resolution.
pub fn ready() -> bool {
    return true;
}
