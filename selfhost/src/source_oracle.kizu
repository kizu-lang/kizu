import selfhost::source;
import selfhost::source::loader;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();

    var files = try loader::load_selfhost_sources(allocator, io, "selfhost");
    let manifest_sources = try source::count_kind(files, source::SourceKind::Manifest);
    let selfhost_sources = try source::count_kind(files, source::SourceKind::Selfhost);
    let std_sources = try source::count_kind(files, source::SourceKind::Std);
    let summary = source::summarize(
        files.len(),
        manifest_sources,
        selfhost_sources,
        std_sources,
        0,
        0
    );
    std::testing::expect_equal<i64>(1, summary.manifest_sources);
    // The selfhost source count is the tree's size: splitting one module in two
    // moves it without changing anything the loader does. Compare it against the
    // tree itself rather than a literal, so what is pinned is the property the
    // literal stood in for -- the loader reaches every selfhost source, and only
    // those. A literal here has been renumbered twice already.
    let tree_sources = try count_kizu_sources_under(io, "selfhost/src");
    std::testing::expect_equal<i64>(tree_sources, summary.selfhost_sources);
    // The std surface is different in kind. It grows only when the selfhost
    // compiler starts importing another std module, which is a deliberate act,
    // so a literal is right here: it makes widening the boundary an edit.
    std::testing::expect_equal<i64>(15, summary.std_sources);
    // Every loaded file lands in exactly one kind.
    std::testing::expect_equal<i64>(
        summary.sources,
        summary.manifest_sources + summary.selfhost_sources + summary.std_sources
    );
    try expect_source_files(files);
    try expect_user_file_sources(allocator, io);

    try expect_diagnostics(allocator);

    // The tape carries only what does not drift with the tree's shape. The total
    // and the selfhost count are checked above, against the tree; printing them
    // here as well made the Go golden a second source for one fact, and that is
    // what went stale.
    print("source-std");
    print(summary.std_sources);
    print("source-diagnostics");
    print(4);
    print("source-related");
    print(2);
    files.deinit();
    return;
}

fn expect_user_file_sources(allocator: Allocator, io: Io) -> !void {
    let path = "examples/hello.kizu";
    let text = try std::fs::read_file(io, path);
    var files = try loader::load_file_sources(allocator, io, path, text);
    let user_sources = try source::count_kind(files, source::SourceKind::User);
    let selfhost_sources = try source::count_kind(files, source::SourceKind::Selfhost);
    let std_sources = try source::count_kind(files, source::SourceKind::Std);
    std::testing::expect_equal<i64>(1, files.len());
    std::testing::expect_equal<i64>(1, user_sources);
    std::testing::expect_equal<i64>(0, selfhost_sources);
    std::testing::expect_equal<i64>(0, std_sources);

    let file = try files.at(0);
    std::testing::expect_equal<i64>(0, file.id);
    std::testing::expect_equal<[]u8>("hello", source::module_path(file));
    std::testing::expect_equal<[]u8>(path, file.path);
    files.deinit();
    try expect_user_std_sources(allocator, io);
    try expect_user_std_dependency_sources(allocator, io);
    try expect_user_std_private_dependency_sources(allocator, io);
    return;
}

fn expect_user_std_sources(allocator: Allocator, io: Io) -> !void {
    let text = "fn main(values: std::array::Array<i64>) { values.deinit(); }";
    var files = try loader::load_file_sources(allocator, io, "examples/uses_array.kizu", text);
    let std_sources = try source::count_kind(files, source::SourceKind::Std);
    std::testing::expect_equal<i64>(2, files.len());
    std::testing::expect_equal<i64>(1, std_sources);

    let std_file = try files.at(1);
    std::testing::expect_equal<[]u8>("array", source::module_path(std_file));
    std::testing::expect_equal<[]u8>("std/src/array.kizu", std_file.path);
    files.deinit();
    return;
}

fn expect_user_std_dependency_sources(allocator: Allocator, io: Io) -> !void {
    let text = "fn main(value: std::string::String) { return; }";
    var files = try loader::load_file_sources(allocator, io, "examples/uses_string.kizu", text);
    let std_sources = try source::count_kind(files, source::SourceKind::Std);
    std::testing::expect_equal<i64>(4, files.len());
    std::testing::expect_equal<i64>(3, std_sources);

    let string_file = try files.at(1);
    std::testing::expect_equal<[]u8>("string", source::module_path(string_file));
    std::testing::expect_equal<[]u8>("std/src/string.kizu", string_file.path);

    let array_file = try files.at(2);
    std::testing::expect_equal<[]u8>("array", source::module_path(array_file));
    std::testing::expect_equal<[]u8>("std/src/array.kizu", array_file.path);

    let mem_file = try files.at(3);
    std::testing::expect_equal<[]u8>("mem", source::module_path(mem_file));
    std::testing::expect_equal<[]u8>("std/src/mem.kizu", mem_file.path);
    files.deinit();
    return;
}

fn expect_user_std_private_dependency_sources(allocator: Allocator, io: Io) -> !void {
    let text = "fn main(path: []u8) { print(std::path::basename(path)); }";
    var files = try loader::load_file_sources(allocator, io, "examples/uses_path.kizu", text);
    let std_sources = try source::count_kind(files, source::SourceKind::Std);
    std::testing::expect_equal<i64>(6, files.len());
    std::testing::expect_equal<i64>(5, std_sources);

    let path_file = try files.at(1);
    std::testing::expect_equal<[]u8>("path", source::module_path(path_file));
    std::testing::expect_equal<[]u8>("std/src/path.kizu", path_file.path);

    let path_bits_file = try files.at(4);
    std::testing::expect_equal<[]u8>("path_bits", source::module_path(path_bits_file));
    std::testing::expect_equal<[]u8>("std/src/path_bits.kizu", path_bits_file.path);
    files.deinit();
    return;
}

fn expect_source_files(files: &std::array::Array<source::SourceFile>) -> !void {
    let manifest = try files.at(0);
    std::testing::expect_equal<i64>(0, manifest.id);
    std::testing::expect_equal<[]u8>("manifest", source::module_path(manifest));
    std::testing::expect_equal<[]u8>("selfhost/kizu.toml", manifest.path);

    let first_source = try files.at(1);
    std::testing::expect_equal<i64>(1, first_source.id);
    std::testing::expect_equal<[]u8>(
        "abi/fixed_abi_contract", source::module_path(first_source)
    );
    std::testing::expect_equal<[]u8>(
        "selfhost/src/abi/fixed_abi_contract.kizu", first_source.path
    );

    var std_index = 0;
    var found_std = false;
    while std_index < files.len() and !found_std {
        let candidate = try files.at(std_index);
        if candidate.kind == source::SourceKind::Std {
            found_std = true;
        } else {
            std_index = std_index + 1;
        }
    }
    std::testing::expect(found_std);
    let first_std = try files.at(std_index);
    std::testing::expect_equal<[]u8>("mem", source::module_path(first_std));
    std::testing::expect_equal<[]u8>("std/src/mem.kizu", first_std.path);
    return;
}

fn expect_diagnostics(allocator: Allocator) -> !void {
    var missing = source::missing_file(allocator, "missing.kizu");
    try expect_diagnostic(missing, "missing file", 0, 0, 0);

    var invalid = source::invalid_manifest(allocator, "kizu.toml", 10, 18);
    try expect_diagnostic(invalid, "invalid manifest", 10, 18, 0);

    var duplicate = try source::duplicate_module(
        allocator,
        "src/main.kizu",
        3,
        7,
        "src/lib.kizu",
        1,
        5
    );
    try expect_diagnostic(duplicate, "duplicate module", 3, 7, 1);

    var cycle = try source::import_cycle(
        allocator,
        "src/a.kizu",
        9,
        15,
        "src/b.kizu",
        2,
        8
    );
    try expect_diagnostic(cycle, "import cycle", 9, 15, 1);
    return;
}

fn expect_diagnostic(
    diagnostic: std::kizu::diagnostic::Diagnostic,
    message: []u8,
    byte_start: i64,
    byte_end: i64,
    related: i64
) -> !void {
    std::testing::expect_equal<[]u8>(message, diagnostic.message);
    std::testing::expect_equal<i64>(byte_start, diagnostic.primary.byte_start);
    std::testing::expect_equal<i64>(byte_end, diagnostic.primary.byte_end);
    std::testing::expect_equal<i64>(related, diagnostic.related_len());
    diagnostic.deinit();
    return;
}

// count_kizu_sources_under returns the number of `.kizu` files in a directory
// tree. It is the independent oracle the selfhost source count is compared
// against: the loader walks the manifest, this walks the filesystem, and a file
// the loader stopped reaching shows up as a disagreement rather than as a
// literal someone renumbered.
fn count_kizu_sources_under(io: Io, path: []u8) -> !i64 {
    var entries = try std::fs::read_dir(io, path);
    defer entries.deinit();
    var count = 0;
    var index = 0;
    while index < entries.len() {
        let entry = try entries.get(index);
        if entry.is_dir {
            let nested = try count_kizu_sources_under(io, entry.path);
            count = count + nested;
        } else {
            if has_kizu_suffix(entry.name) {
                count = count + 1;
            }
        }
        index = index + 1;
    }
    return count;
}

// has_kizu_suffix reports whether a directory entry names a Kizu source.
fn has_kizu_suffix(name: []u8) -> bool {
    let length = std::mem::len(name);
    if length < 5 {
        return false;
    }
    return std::mem::equal_bytes(name[length - 5..length], ".kizu");
}
