// Module: self-host compiler package entry point.

import selfhost::ast;
import selfhost::backend;
import selfhost::cache_contract;
import selfhost::compiler;
import selfhost::diagnostics;
import selfhost::ir;
import selfhost::lexer;
import selfhost::ownership;
import selfhost::parser;
import selfhost::resolver;
import selfhost::token;
import selfhost::types;

// main is the self-host compiler CLI entry point.
pub fn main() -> !void {
    if std::process::arg_count() == 0 {
        try scaffold_check();
        return void;
    }

    let command = try std::process::arg(0);
    if std::mem::equal_bytes(command, "check") {
        try check_command();
        return void;
    }
    if std::mem::equal_bytes(command, "build") {
        try build_command();
        return void;
    }

    let io = std::io::blocking();
    try std::io::write_stderr(io, "error: unknown selfhost command");
    return error("unknown selfhost command");
}

// scaffold_check keeps package-level resolution smoke behavior deterministic.
fn scaffold_check() -> !void {
    token::ready();
    ast::ready();
    lexer::ready();
    parser::ready();
    compiler::ready();
    lexer::source_len("");
    lexer::eof_token("");
    try compiler::compile_self_check();
    return void;
}

// check_command runs `kizu-selfhost check <file>`.
fn check_command() -> !void {
    if std::process::arg_count() != 2 {
        return error("usage: kizu-selfhost check <file>");
    }
    let io = std::io::blocking();
    let path = try std::process::arg(1);
    let source = try std::fs::read_file(io, path);
    try compiler::check_source(source);
    try std::io::write_stdout(io, "selfhost command");
    print("check");
    print("llvm");
    print("pass");
    print(true);
    print("");
    return void;
}

// build_command runs `kizu-selfhost build --target <target> <file>`.
fn build_command() -> !void {
    if std::process::arg_count() != 4 {
        return error("usage: kizu-selfhost build --target <target> <file>");
    }
    let flag = try std::process::arg(1);
    if !std::mem::equal_bytes(flag, "--target") {
        return error("usage: kizu-selfhost build --target <target> <file>");
    }
    let io = std::io::blocking();
    let target = try std::process::arg(2);
    let path = try std::process::arg(3);
    let source = try std::fs::read_file(io, path);
    try compiler::build_source(source, target);
    try std::io::write_stdout(io, "selfhost command");
    print("build");
    print("aarch64-apple-darwin");
    print("pass");
    print(true);
    print("");
    return void;
}
