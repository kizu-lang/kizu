import selfhost::backend;
import selfhost::backend::data;
import selfhost::cli::check;
import selfhost::cli::diagnostics;
import selfhost::cli::output;
import selfhost::ir;
import selfhost::lexer;
import selfhost::ownership;
import selfhost::parser;
import selfhost::parser::format;
import selfhost::parser::validation;
import selfhost::resolver;
import selfhost::source;
import selfhost::types;

pub fn smoke() -> parser::ParseError!i64 {
    let allocator = std::mem::page_allocator();
    let path = "selfhost/smoke.kizu";
    let source = "fn main() -> void { return; }";
    let lexed = lexer::summarize(source);
    let parsed = try parser::parse_file(allocator, path, source);
    let tree = try parser::summarize(&parsed, lexed.tokens);
    parsed.deinit();
    let resolved = resolver::resolve(tree);
    let typed = types::check(resolved);
    let owned = ownership::checked_package_from_summary(ownership::check(typed));
    let lowered = ir::lower(owned);
    let built = backend::summarize(lowered);
    return built.artifacts;
}

pub fn artifact_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let artifact = try ir::emit_selfhost_artifacts(allocator, io, "selfhost");
    let built = try backend::consume_ir_artifact(io, artifact.ir_path);
    std::testing::expect(artifact.bytes > 0);
    std::testing::expect(artifact.manifest_bytes > 0);
    std::testing::expect(built.artifacts > 0);

    print("ir-artifact-path");
    print(artifact.ir_path);
    print("ir-manifest-path");
    print(artifact.manifest_path);
    print("ir-artifact-bytes");
    print(artifact.bytes);
    print("ir-manifest-bytes");
    print(artifact.manifest_bytes);
    print("backend-artifact-bytes");
    print(built.artifacts);
    return;
}

pub fn backend_artifact_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let artifact = try ir::emit_selfhost_artifacts(allocator, io, "selfhost");
    let llvm = try backend::emit_llvm_artifact(
        allocator,
        io,
        artifact.ir_path,
        artifact.manifest_path
    );
    std::testing::expect(artifact.bytes > 0);
    std::testing::expect(artifact.manifest_bytes > 0);
    std::testing::expect(llvm.bytes > 0);
    std::testing::expect(llvm.metadata_bytes > 0);
    std::testing::expect(llvm.storage_bytes > 0);
    std::testing::expect(llvm.storage_metadata_bytes > 0);
    std::testing::expect(llvm.host_bytes > 0);
    std::testing::expect(llvm.host_metadata_bytes > 0);

    print("llvm-artifact-path");
    print(llvm.ll_path);
    print("llvm-metadata-path");
    print(llvm.metadata_path);
    print("runtime-storage-path");
    print(llvm.storage_path);
    print("runtime-storage-metadata-path");
    print(llvm.storage_metadata_path);
    print("host-capability-path");
    print(llvm.host_path);
    print("host-capability-metadata-path");
    print(llvm.host_metadata_path);
    print("llvm-artifact-bytes");
    print(llvm.bytes);
    print("llvm-metadata-bytes");
    print(llvm.metadata_bytes);
    print("runtime-storage-bytes");
    print(llvm.storage_bytes);
    print("runtime-storage-metadata-bytes");
    print(llvm.storage_metadata_bytes);
    print("host-capability-bytes");
    print(llvm.host_bytes);
    print("host-capability-metadata-bytes");
    print(llvm.host_metadata_bytes);
    return;
}

pub fn cli_main() -> !i64 {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let arg_count = std::process::arg_count();
    if arg_count != 2 and arg_count != 3 {
        try output::usage(allocator, io);
        return std::process::exit_code(64);
    }

    let command = try std::process::arg(0);
    if std::mem::starts_with(command, "-") {
        try output::usage(allocator, io);
        return std::process::exit_code(64);
    }
    if arg_count == 3 {
        if !std::mem::equal_bytes(command, "fmt") {
            try output::usage(allocator, io);
            return std::process::exit_code(64);
        }
        let flag = try std::process::arg(1);
        let target = try std::process::arg(2);
        if !is_fmt_write_flag(flag) or std::mem::starts_with(target, "-") {
            try output::usage(allocator, io);
            return std::process::exit_code(64);
        }
        return try fmt_write_file_cli(allocator, io, target);
    }

    let target = try std::process::arg(1);
    if std::mem::starts_with(target, "-") {
        try output::usage(allocator, io);
        return std::process::exit_code(64);
    }
    if std::mem::equal_bytes(command, "check") {
        return try check_file_or_package_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "parse") {
        return try parse_file_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "fmt") {
        return try fmt_file_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "run") {
        return try run_file_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "test") {
        return try test_file_cli(allocator, io, target);
    }
    if !std::mem::equal_bytes(target, "selfhost") {
        try output::usage(allocator, io);
        return std::process::exit_code(64);
    }
    if std::mem::equal_bytes(command, "stage") {
        let llvm = try stage_selfhost(allocator, io);
        try output::line(allocator, io, "stage: ok");
        try output::line(allocator, io, llvm.ll_path);
        try output::line(allocator, io, llvm.metadata_path);
        try output::line(allocator, io, llvm.storage_path);
        try output::line(allocator, io, llvm.storage_metadata_path);
        try output::line(allocator, io, llvm.host_path);
        try output::line(allocator, io, llvm.host_metadata_path);
        return std::process::exit_code(0);
    }

    try output::error_line(allocator, io, "unsupported selfhost command");
    return std::process::exit_code(64);
}

fn is_fmt_write_flag(flag: []u8) -> bool {
    return std::mem::equal_bytes(flag, "--write") or std::mem::equal_bytes(flag, "-w");
}

fn parse_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    if !(try validate_file_cli_parse(allocator, io, path, file_text)) {
        return std::process::exit_code(1);
    }
    return try write_parse_success(allocator, io, file_text);
}

fn fmt_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    if !(try validate_file_cli_parse(allocator, io, path, file_text)) {
        return std::process::exit_code(1);
    }
    return try write_parse_success(allocator, io, file_text);
}

fn fmt_write_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    if !(try validate_file_cli_parse(allocator, io, path, file_text)) {
        return std::process::exit_code(1);
    }
    if source_has_line_comment(file_text) {
        try output::error_line(
            allocator,
            io,
            "error: fmt --write does not support line comments yet"
        );
        return std::process::exit_code(1);
    }
    var formatted = try format::format_source(allocator, file_text);
    let formatted_bytes = formatted.as_bytes();
    try std::fs::write_file(io, path, formatted_bytes);
    formatted.deinit();
    return std::process::exit_code(0);
}

fn source_has_line_comment(source: []u8) -> bool {
    var in_string = false;
    var index = 0;
    let length = std::mem::len(source);
    while index < length {
        let byte = source[index];
        if in_string {
            if byte == cast<u8>(34) {
                in_string = false;
            }
            index = index + 1;
            continue;
        }
        if byte == cast<u8>(34) {
            in_string = true;
            index = index + 1;
            continue;
        }
        if byte == cast<u8>(92) and index + 1 < length and
            source[index + 1] == cast<u8>(92) {
            while index < length and source[index] != cast<u8>(10) {
                index = index + 1;
            }
            continue;
        }
        if byte == cast<u8>(47) and index + 1 < length and
            source[index + 1] == cast<u8>(47) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn validate_file_cli_parse(
    allocator: Allocator,
    io: Io,
    path: []u8,
    file_text: []u8
) -> !bool {
    let parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        try diagnostics::parse_validation_error(allocator, io, parsed_validation);
        return false;
    }
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    parsed.deinit();
    return true;
}

fn write_parse_success(
    allocator: Allocator,
    io: Io,
    file_text: []u8
) -> !i64 {
    var formatted = try format::format_source(allocator, file_text);
    let formatted_bytes = formatted.as_bytes();
    try std::io::write_stdout(io, formatted_bytes);
    try output::stdout_newline(allocator, io);
    formatted.deinit();
    return std::process::exit_code(0);
}

fn check_file_or_package_cli(allocator: Allocator, io: Io, target: []u8) -> !i64 {
    let metadata = try std::fs::metadata(io, target);
    if metadata.is_dir {
        return try check::package_cli(allocator, io, target);
    }
    let target_text = try std::fs::read_file(io, target);
    if source::is_manifest_text(target_text) {
        return try check::package_cli(allocator, io, std::path::dirname(target));
    }
    return try check::file_cli(allocator, io, target);
}

fn write_parse_failure(
    allocator: Allocator,
    io: Io,
    parsed_validation: validation::ParseValidation
) -> !i64 {
    try diagnostics::parse_validation_error(allocator, io, parsed_validation);
    return std::process::exit_code(1);
}

fn run_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    let parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        return try write_parse_failure(allocator, io, parsed_validation);
    }
    var files = try source::load_file_sources(allocator, io, path, file_text);
    defer files.deinit();
    let file = try files.at(0);
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    defer parsed.deinit();
    if !(try check::fast_diagnostics_ast_node(allocator, io, files, file, parsed.ast, parsed.root)) {
        return std::process::exit_code(1);
    }
    let prints_hello = try ast_prints_hello(file_text, parsed.ast, parsed.root);
    if prints_hello {
        let artifact = try backend::emit_run_hello_artifact(allocator, io, path);
        if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
            return std::process::exit_code(0);
        }
    }
    try output::usage(allocator, io);
    return std::process::exit_code(64);
}

fn test_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    let parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        return try write_parse_failure(allocator, io, parsed_validation);
    }
    var files = try source::load_file_sources(allocator, io, path, file_text);
    defer files.deinit();
    let file = try files.at(0);
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    defer parsed.deinit();
    if !(try check::fast_diagnostics_ast_node(allocator, io, files, file, parsed.ast, parsed.root)) {
        return std::process::exit_code(1);
    }
    let expect = try ast_testing_expect_value(file_text, parsed.ast, parsed.root);
    if expect == 1 {
        let artifact = try backend::emit_test_expect_ok_artifact(allocator, io, path);
        if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
            return std::process::exit_code(0);
        }
    }
    if expect == 0 {
        let artifact = try backend::emit_test_expect_failure_artifact(allocator, io, path);
        if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
            return std::process::exit_code(0);
        }
    }
    try output::usage(allocator, io);
    return std::process::exit_code(64);
}

fn ast_prints_hello(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !bool {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try ast_range_prints_hello(text, ast, program.declarations),
        FnDecl(fn_decl) => try ast_fn_prints_hello(text, ast, fn_decl.name, fn_decl.body),
        Block(block) => try ast_range_prints_hello(text, ast, block.statements),
        ExprStmt(expr_stmt) => try ast_prints_hello(text, ast, expr_stmt.expr),
        Call(call_node) => try ast_call_prints_hello(text, ast, call_node.callee, call_node.args),
        TypeApplyExpr(type_apply) => try ast_prints_hello(text, ast, type_apply.callee),
        TryExpr(try_expr_node) => try ast_prints_hello(text, ast, try_expr_node.value),
        ComptimeExpr(comptime_expr_node) => try ast_prints_hello(text, ast, comptime_expr_node.value),
        Unsafe(unsafe_node) => try ast_prints_hello(text, ast, unsafe_node.body),
        If(if_node) => try ast_if_prints_hello(
            text,
            ast,
            if_node.then_block,
            if_node.else_block
        ),
        Empty => false,
        ImportDecl(import_decl) => false,
        StructDecl(struct_decl) => false,
        EnumDecl(enum_decl) => false,
        UnionDecl(union_decl) => false,
        Int(int_node) => false,
        String(string_node) => false,
        TypeName(type_name) => false,
        Var(var_node) => false,
        Bool(bool_node) => false,
        Prefix(prefix_node) => false,
        Binary(binary) => false,
        FieldExpr(field_expr_node) => false,
        DerefExpr(deref_expr_node) => false,
        CastExpr(cast_expr) => false,
        IndexExpr(index_expr) => false,
        StructLiteralExpr(struct_literal) => false,
        StructFieldInit(struct_field_init) => false,
        ArenaNewExpr(arena_new) => false,
        Let(let_node) => false,
        Assign(assign_node) => false,
        Return(return_node) => false,
        Defer(defer_node) => false,
        While(while_node) => false,
        For(for_node) => false,
        Break(break_node) => false,
        Continue(continue_node) => false,
        Param(param_node) => false,
        Field(field_node) => false,
        UnionVariant(union_variant) => false,
        Match(match_node) => false,
        MatchArm(match_arm) => false,
        ComptimeIf(comptime_if_node) => false,
    };
}

fn ast_fn_prints_hello(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !bool {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "main") {
        return false;
    }
    return try ast_prints_hello(text, ast, body);
}

fn ast_range_prints_hello(
    text: []u8,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !bool {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        if try ast_prints_hello(text, ast, child) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn ast_call_prints_hello(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !bool {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return false;
    }
    let arg = try ast.child_at(args, 0);
    return ast_string_payload_equal(text, ast, arg, "hello, kizu");
}

fn ast_string_payload_equal(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    want: []u8
) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        String(string_node) => ast_string_literal_payload_equal(ast_node_text(text, ast, node_id), want),
        _ => false,
    };
}

fn ast_string_literal_payload_equal(literal: []u8, want: []u8) -> bool {
    let length = std::mem::len(literal);
    if length < 2 {
        return false;
    }
    if literal[0] != cast<u8>(34) or literal[length - 1] != cast<u8>(34) {
        return false;
    }
    return std::mem::equal_bytes(literal[1..length - 1], want);
}

fn ast_if_prints_hello(
    text: []u8,
    ast: std::kizu::ast::Ast,
    then_block: std::kizu::ast::NodeId,
    else_block: std::kizu::ast::NodeId
) -> !bool {
    if try ast_prints_hello(text, ast, then_block) {
        return true;
    }
    return try ast_prints_hello(text, ast, else_block);
}

fn ast_testing_expect_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !i64 {
    let node = ast.get(node_id);
    return match node.data {
        Program(program) => try ast_expect_value_in_range(text, ast, program.declarations),
        FnDecl(fn_decl) => try ast_testing_expect_value(text, ast, fn_decl.body),
        Block(block) => try ast_expect_value_in_range(text, ast, block.statements),
        ExprStmt(expr_stmt) => try ast_testing_expect_value(text, ast, expr_stmt.expr),
        Call(call_node) => try ast_call_expect_value(text, ast, call_node.callee, call_node.args),
        TypeApplyExpr(type_apply) => try ast_testing_expect_value(text, ast, type_apply.callee),
        TryExpr(try_expr_node) => try ast_testing_expect_value(text, ast, try_expr_node.value),
        ComptimeExpr(comptime_expr_node) => try ast_testing_expect_value(text, ast, comptime_expr_node.value),
        Unsafe(unsafe_node) => try ast_testing_expect_value(text, ast, unsafe_node.body),
        If(if_node) => try ast_expect_value_in_two_nodes(
            text,
            ast,
            if_node.then_block,
            if_node.else_block
        ),
        Empty => -1,
        ImportDecl(import_decl) => -1,
        StructDecl(struct_decl) => -1,
        EnumDecl(enum_decl) => -1,
        UnionDecl(union_decl) => -1,
        Int(int_node) => -1,
        String(string_node) => -1,
        TypeName(type_name) => -1,
        Var(var_node) => -1,
        Bool(bool_node) => -1,
        Prefix(prefix_node) => -1,
        Binary(binary) => -1,
        FieldExpr(field_expr_node) => -1,
        DerefExpr(deref_expr_node) => -1,
        CastExpr(cast_expr) => -1,
        IndexExpr(index_expr) => -1,
        StructLiteralExpr(struct_literal) => -1,
        StructFieldInit(struct_field_init) => -1,
        ArenaNewExpr(arena_new) => -1,
        Let(let_node) => -1,
        Assign(assign_node) => -1,
        Return(return_node) => -1,
        Defer(defer_node) => -1,
        While(while_node) => -1,
        For(for_node) => -1,
        Break(break_node) => -1,
        Continue(continue_node) => -1,
        Param(param_node) => -1,
        Field(field_node) => -1,
        UnionVariant(union_variant) => -1,
        Match(match_node) => -1,
        MatchArm(match_arm) => -1,
        ComptimeIf(comptime_if_node) => -1,
    };
}

fn ast_expect_value_in_range(
    text: []u8,
    ast: std::kizu::ast::Ast,
    range: std::kizu::ast::ChildRange
) -> !i64 {
    var index = 0;
    while index < range.len {
        let child = try ast.child_at(range, index);
        let value = try ast_testing_expect_value(text, ast, child);
        if value != -1 {
            return value;
        }
        index = index + 1;
    }
    return -1;
}

fn ast_call_expect_value(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !i64 {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "std::testing::expect") or args.len != 1 {
        return -1;
    }
    let arg = try ast.child_at(args, 0);
    return ast_bool_value(ast, arg);
}

fn ast_expect_value_in_two_nodes(
    text: []u8,
    ast: std::kizu::ast::Ast,
    first: std::kizu::ast::NodeId,
    second: std::kizu::ast::NodeId
) -> !i64 {
    let first_value = try ast_testing_expect_value(text, ast, first);
    if first_value != -1 {
        return first_value;
    }
    return try ast_testing_expect_value(text, ast, second);
}

fn ast_bool_value(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> i64 {
    let node = ast.get(node_id);
    return match node.data {
        Bool(bool_node) => bool_value_as_i64(bool_node.value),
        Program(program) => -1,
        Empty => -1,
        ImportDecl(import_decl) => -1,
        StructDecl(struct_decl) => -1,
        EnumDecl(enum_decl) => -1,
        UnionDecl(union_decl) => -1,
        FnDecl(fn_decl) => -1,
        Int(int_node) => -1,
        String(string_node) => -1,
        TypeName(type_name) => -1,
        Var(var_node) => -1,
        Prefix(prefix_node) => -1,
        Binary(binary) => -1,
        FieldExpr(field_expr_node) => -1,
        DerefExpr(deref_expr_node) => -1,
        Call(call_node) => -1,
        TypeApplyExpr(type_apply) => -1,
        CastExpr(cast_expr) => -1,
        IndexExpr(index_expr) => -1,
        StructLiteralExpr(struct_literal) => -1,
        StructFieldInit(struct_field_init) => -1,
        ArenaNewExpr(arena_new) => -1,
        TryExpr(try_expr_node) => -1,
        ComptimeExpr(comptime_expr_node) => -1,
        Block(block) => -1,
        If(if_node) => -1,
        Let(let_node) => -1,
        Assign(assign_node) => -1,
        Return(return_node) => -1,
        Defer(defer_node) => -1,
        ExprStmt(expr_stmt) => -1,
        While(while_node) => -1,
        For(for_node) => -1,
        Break(break_node) => -1,
        Continue(continue_node) => -1,
        Param(param_node) => -1,
        Field(field_node) => -1,
        UnionVariant(union_variant) => -1,
        Match(match_node) => -1,
        MatchArm(match_arm) => -1,
        Unsafe(unsafe_node) => -1,
        ComptimeIf(comptime_if_node) => -1,
    };
}

fn bool_value_as_i64(value: bool) -> i64 {
    if value {
        return 1;
    }
    return 0;
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}

pub fn cli_gate() -> !void {
    let code = try cli_main();
    print("exit-code");
    print(code);
    return;
}

pub fn cli_contract_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let llvm = try check_and_stage_selfhost(allocator, io);

    try output::line(allocator, io, "check: ok");
    print("exit-code");
    print(std::process::exit_code(0));
    try output::line(allocator, io, "stage: ok");
    try output::line(allocator, io, llvm.ll_path);
    try output::line(allocator, io, llvm.metadata_path);
    try output::line(allocator, io, llvm.storage_path);
    try output::line(allocator, io, llvm.storage_metadata_path);
    try output::line(allocator, io, llvm.host_path);
    try output::line(allocator, io, llvm.host_metadata_path);
    print("exit-code");
    print(std::process::exit_code(0));
    return;
}

fn stage_selfhost(allocator: Allocator, io: Io) -> !data::LlvmArtifact {
    let llvm = try check_and_stage_selfhost(allocator, io);
    return llvm;
}

fn check_and_stage_selfhost(allocator: Allocator, io: Io) -> !data::LlvmArtifact {
    var files = try source::load_selfhost_sources(allocator, io, "selfhost");
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    let checked = try ownership::check_package(allocator, files, typed);
    if checked.diagnostics != 0 {
        return error("selfhost check failed");
    }

    let artifact = try ir::emit_checked_artifacts(allocator, io, checked);
    files.deinit();
    let llvm = try backend::emit_llvm_artifact(
        allocator,
        io,
        artifact.ir_path,
        artifact.manifest_path
    );
    return llvm;
}
