import selfhost::backend;
import selfhost::cache;
import selfhost::cli::check;
import selfhost::cli::diagnostics;
import selfhost::cli::execute;
import selfhost::cli::output;
import selfhost::ir;
import selfhost::lexer;
import selfhost::ownership;
import selfhost::ownership::data;
import selfhost::parser;
import selfhost::parser::format;
import selfhost::resolver;
import selfhost::source;
import selfhost::source::loader;
import selfhost::stage_profile;
import selfhost::types;

struct CachedStageFile {
    next: i64,
    bytes: i64,
}

pub fn smoke() -> parser::ParseError!i64 {
    let allocator = std::mem::page_allocator();
    let path = "selfhost/smoke.kizu";
    let source = "fn main() -> void { return; }";
    let lexed = lexer::summarize(source);
    let parsed = try parser::parse_file(allocator, path, source);
    let tree = try parser::summarize(&parsed, lexed.tokens);
    parsed.deinit();
    let resolved = resolver::resolve(tree);
    let typed = types::check(resolved);
    let owned = ownership::checked_package_from_summary(ownership::check(typed));
    let lowered = ir::lower(owned);
    let built = backend::summarize(lowered);
    return built.artifacts;
}

pub fn artifact_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let artifact = try ir::emit_selfhost_artifacts(allocator, io, "selfhost");
    let built = try backend::consume_ir_artifact(io, artifact.ir_path);
    std::testing::expect(artifact.bytes > 0);
    std::testing::expect(artifact.manifest_bytes > 0);
    std::testing::expect(built.artifacts > 0);

    print("ir-artifact-path");
    print(artifact.ir_path);
    print("ir-manifest-path");
    print(artifact.manifest_path);
    print("ir-artifact-bytes");
    print(artifact.bytes);
    print("ir-manifest-bytes");
    print(artifact.manifest_bytes);
    print("backend-artifact-bytes");
    print(built.artifacts);
    return;
}

pub fn backend_artifact_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let artifact = try ir::emit_selfhost_artifacts(allocator, io, "selfhost");
    let llvm = try backend::emit_llvm_artifact(
        allocator,
        io,
        artifact.ir_path,
        artifact.manifest_path
    );
    std::testing::expect(artifact.bytes > 0);
    std::testing::expect(artifact.manifest_bytes > 0);
    std::testing::expect(llvm.bytes > 0);
    std::testing::expect(llvm.metadata_bytes > 0);
    std::testing::expect(llvm.storage_bytes > 0);
    std::testing::expect(llvm.storage_metadata_bytes > 0);
    std::testing::expect(llvm.host_bytes > 0);
    std::testing::expect(llvm.host_metadata_bytes > 0);

    print("llvm-artifact-path");
    print(llvm.ll_path);
    print("llvm-metadata-path");
    print(llvm.metadata_path);
    print("runtime-storage-path");
    print(llvm.storage_path);
    print("runtime-storage-metadata-path");
    print(llvm.storage_metadata_path);
    print("host-capability-path");
    print(llvm.host_path);
    print("host-capability-metadata-path");
    print(llvm.host_metadata_path);
    print("llvm-artifact-bytes");
    print(llvm.bytes);
    print("llvm-metadata-bytes");
    print(llvm.metadata_bytes);
    print("runtime-storage-bytes");
    print(llvm.storage_bytes);
    print("runtime-storage-metadata-bytes");
    print(llvm.storage_metadata_bytes);
    print("host-capability-bytes");
    print(llvm.host_bytes);
    print("host-capability-metadata-bytes");
    print(llvm.host_metadata_bytes);
    return;
}

pub fn cli_main() -> !i64 {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let arg_count = std::process::arg_count();
    if arg_count == 0 {
        return try usage_cli(allocator, io);
    }
    let command = try std::process::arg(0);
    if std::mem::starts_with(command, "-") {
        return try usage_cli(allocator, io);
    }
    if std::mem::equal_bytes(command, "build") {
        if try is_public_build_deferral_shape(arg_count) {
            return try deferred_public_command_cli(allocator, io, "build");
        }
        return try usage_cli(allocator, io);
    }
    if std::mem::equal_bytes(command, "cache") {
        if arg_count == 2 {
            let subcommand = try std::process::arg(1);
            if std::mem::equal_bytes(subcommand, "status") {
                return try cache_status_cli(allocator, io);
            }
            if std::mem::equal_bytes(subcommand, "prune") {
                return try cache_prune_cli(allocator, io);
            }
        }
        return try usage_cli(allocator, io);
    }
    if std::mem::equal_bytes(command, "why-rebuild") {
        if try is_one_target_deferral_shape(arg_count) {
            return try deferred_public_command_cli(allocator, io, "why-rebuild");
        }
        return try usage_cli(allocator, io);
    }
    if std::mem::equal_bytes(command, "init") {
        if try is_public_init_deferral_shape(arg_count) {
            return try deferred_public_command_cli(allocator, io, "init");
        }
        return try usage_cli(allocator, io);
    }
    if std::mem::equal_bytes(command, "ir") {
        if try is_public_ir_deferral_shape(arg_count) {
            return try deferred_public_command_cli(allocator, io, "ir");
        }
        return try usage_cli(allocator, io);
    }
    if std::mem::equal_bytes(command, "import-c-header") {
        if try is_one_target_deferral_shape(arg_count) {
            return try deferred_public_command_cli(allocator, io, "import-c-header");
        }
        return try usage_cli(allocator, io);
    }
    if arg_count != 2 and arg_count != 3 {
        return try usage_cli(allocator, io);
    }
    if arg_count == 3 {
        if !std::mem::equal_bytes(command, "fmt") {
            return try usage_cli(allocator, io);
        }
        let flag = try std::process::arg(1);
        let target = try std::process::arg(2);
        if !is_fmt_write_flag(flag) or std::mem::starts_with(target, "-") {
            return try usage_cli(allocator, io);
        }
        return try fmt_write_file_cli(allocator, io, target);
    }

    let target = try std::process::arg(1);
    if std::mem::starts_with(target, "-") {
        return try usage_cli(allocator, io);
    }
    if std::mem::equal_bytes(command, "check") {
        return try check_file_or_package_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "parse") {
        return try parse_file_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "fmt") {
        return try fmt_file_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "run") {
        return try execute::run_file_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "test") {
        return try execute::test_file_cli(allocator, io, target);
    }
    if !std::mem::equal_bytes(target, "selfhost") {
        return try usage_cli(allocator, io);
    }
    if std::mem::equal_bytes(command, "stage") {
        let llvm = try stage_selfhost(allocator, io);
        try output::line(allocator, io, "stage: ok");
        try output::line(allocator, io, llvm.ll_path);
        try output::line(allocator, io, llvm.metadata_path);
        try output::line(allocator, io, llvm.storage_path);
        try output::line(allocator, io, llvm.storage_metadata_path);
        try output::line(allocator, io, llvm.host_path);
        try output::line(allocator, io, llvm.host_metadata_path);
        return std::process::exit_code(0);
    }

    try output::error_line(allocator, io, "unsupported selfhost command");
    return std::process::exit_code(64);
}

fn usage_cli(allocator: Allocator, io: Io) -> !i64 {
    try output::usage(allocator, io);
    return std::process::exit_code(64);
}
fn deferred_public_command_cli(allocator: Allocator, io: Io, command: []u8) -> !i64 {
    try output::deferred_public_command(allocator, io, command);
    return std::process::exit_code(64);
}

fn cache_status_cli(allocator: Allocator, io: Io) -> !i64 {
    let status = try cache::cache_status(io);
    try output::prefixed_line(allocator, io, "cache dir: ", status.dir);
    try output::prefixed_i64_line(allocator, io, "entries: ", status.entries);
    try output::prefixed_i64_line(allocator, io, "size bytes: ", status.size_bytes);
    return std::process::exit_code(0);
}

fn cache_prune_cli(allocator: Allocator, io: Io) -> !i64 {
    let report = try cache::prune_cache(io, cache::cache_prune_all_policy());
    var line_text = std::string::String(allocator);
    try line_text.append_bytes("cache pruned: removed ");
    try std::fmt::append_i64(line_text, report.removed_entries);
    try line_text.append_bytes(" entries, freed ");
    try std::fmt::append_i64(line_text, report.freed_bytes);
    try line_text.append_bytes(" bytes");
    let bytes = line_text.as_bytes();
    try std::io::write_stdout(io, bytes);
    try output::stdout_newline(allocator, io);
    line_text.deinit();
    return std::process::exit_code(0);
}

fn is_public_build_deferral_shape(arg_count: i64) -> !bool {
    if arg_count == 3 {
        let flag = try std::process::arg(1);
        let target = try std::process::arg(2);
        return std::mem::equal_bytes(flag, "--emit-llvm") and
            !std::mem::starts_with(target, "-");
    }
    if arg_count == 4 {
        let flag = try std::process::arg(1);
        if std::mem::equal_bytes(flag, "--emit-llvm") {
            let opt = try std::process::arg(2);
            let target = try std::process::arg(3);
            return std::mem::equal_bytes(opt, "--opt") and
                !std::mem::starts_with(target, "-");
        }
    }
    if arg_count >= 4 {
        let flag = try std::process::arg(1);
        let target_kind = try std::process::arg(2);
        let target = try std::process::arg(arg_count - 1);
        return std::mem::equal_bytes(flag, "--target") and
            !std::mem::starts_with(target_kind, "-") and
            !std::mem::starts_with(target, "-");
    }
    return false;
}

fn is_one_target_deferral_shape(arg_count: i64) -> !bool {
    if arg_count != 2 {
        return false;
    }
    let target = try std::process::arg(1);
    return !std::mem::starts_with(target, "-");
}

fn is_public_init_deferral_shape(arg_count: i64) -> !bool {
    if arg_count == 1 {
        return true;
    }
    return try is_one_target_deferral_shape(arg_count);
}

fn is_public_ir_deferral_shape(arg_count: i64) -> !bool {
    if arg_count == 2 {
        return try is_one_target_deferral_shape(arg_count);
    }
    if arg_count == 3 {
        let opt = try std::process::arg(1);
        let target = try std::process::arg(2);
        return std::mem::equal_bytes(opt, "--opt") and
            !std::mem::starts_with(target, "-");
    }
    return false;
}

fn is_fmt_write_flag(flag: []u8) -> bool {
    return std::mem::equal_bytes(flag, "--write") or std::mem::equal_bytes(flag, "-w");
}

fn parse_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    if !(try validate_file_cli_parse(allocator, io, path, file_text)) {
        return std::process::exit_code(1);
    }
    return try write_parse_success(allocator, io, file_text);
}

fn fmt_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    if !(try validate_file_cli_parse(allocator, io, path, file_text)) {
        return std::process::exit_code(1);
    }
    return try write_parse_success(allocator, io, file_text);
}

fn fmt_write_file_cli(allocator: Allocator, io: Io, path: []u8) -> !i64 {
    let file_text = try std::fs::read_file(io, path);
    if !(try validate_file_cli_parse(allocator, io, path, file_text)) {
        return std::process::exit_code(1);
    }
    var formatted = try format::format_source(allocator, file_text);
    defer formatted.deinit();
    let formatted_bytes = formatted.as_bytes();
    var temp_path = try fmt_write_temp_path(allocator, path);
    defer temp_path.deinit();
    let temp_bytes = temp_path.as_bytes();
    try std::fs::write_file(io, temp_bytes, formatted_bytes);
    try std::fs::rename(io, temp_bytes, path);
    return std::process::exit_code(0);
}

fn fmt_write_temp_path(allocator: Allocator, path: []u8) -> !std::string::String {
    var temp_path = std::string::String(allocator);
    try temp_path.reserve(std::mem::len(path) + 13);
    try temp_path.append_bytes(path);
    try temp_path.append_bytes(".kizu-fmt.tmp");
    return temp_path;
}

fn validate_file_cli_parse(
    allocator: Allocator,
    io: Io,
    path: []u8,
    file_text: []u8
) -> !bool {
    var parsed_validation = try parser::validate_diagnostic_file(allocator, path, file_text);
    defer parsed_validation.deinit();
    let validation_ok = parsed_validation.ok;
    if !validation_ok {
        try diagnostics::parse_validation_error(allocator, io, path, &var parsed_validation);
        return false;
    }
    let parsed = try parser::parse_validated_file(
        allocator,
        path,
        file_text,
        validation_ok
    );
    parsed.deinit();
    return true;
}

fn write_parse_success(
    allocator: Allocator,
    io: Io,
    file_text: []u8
) -> !i64 {
    var formatted = try format::format_source(allocator, file_text);
    let formatted_bytes = formatted.as_bytes();
    try std::io::write_stdout(io, formatted_bytes);
    try output::stdout_newline(allocator, io);
    formatted.deinit();
    return std::process::exit_code(0);
}

fn check_file_or_package_cli(allocator: Allocator, io: Io, target: []u8) -> !i64 {
    let metadata = try std::fs::metadata(io, target);
    if metadata.is_dir {
        return try check::package_cli(allocator, io, target);
    }
    let target_text = try std::fs::read_file(io, target);
    if source::is_manifest_text(target_text) {
        return try check::package_cli(allocator, io, std::path::dirname(target));
    }
    return try check::file_cli(allocator, io, target);
}

pub fn cli_gate() -> !void {
    let code = try cli_main();
    print("exit-code");
    print(code);
    return;
}

pub fn cli_contract_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let llvm = try check_and_stage_selfhost(allocator, io);

    try output::line(allocator, io, "check: ok");
    print("exit-code");
    print(std::process::exit_code(0));
    try output::line(allocator, io, "stage: ok");
    try output::line(allocator, io, llvm.ll_path);
    try output::line(allocator, io, llvm.metadata_path);
    try output::line(allocator, io, llvm.storage_path);
    try output::line(allocator, io, llvm.storage_metadata_path);
    try output::line(allocator, io, llvm.host_path);
    try output::line(allocator, io, llvm.host_metadata_path);
    print("exit-code");
    print(std::process::exit_code(0));
    return;
}

fn stage_selfhost(allocator: Allocator, io: Io) -> !backend::data::LlvmArtifact {
    let llvm = try check_and_stage_selfhost(allocator, io);
    return llvm;
}

fn check_loaded_selfhost_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>
) -> !data::CheckedPackage {
    var parsed_sources = try parser::parse_source_files(allocator, files);
    let resolved = try resolver::resolve_parsed_sources(
        allocator,
        files,
        &parsed_sources.parsed,
        &parsed_sources.source_indexes
    );
    let typed = try types::check_parsed_sources(
        allocator,
        files,
        &parsed_sources.parsed,
        &parsed_sources.source_indexes,
        resolved
    );
    let checked = try ownership::check_parsed_package(
        allocator,
        files,
        &parsed_sources.parsed,
        &parsed_sources.source_indexes,
        typed
    );
    try parser::deinit_parsed_source_files(parsed_sources);
    return checked;
}

fn check_and_stage_selfhost(allocator: Allocator, io: Io) -> !backend::data::LlvmArtifact {
    var profile_out = std::string::String(allocator);
    defer profile_out.deinit();
    let profile = try stage_profile::start(&var profile_out);
    try stage_profile::flush(&profile, &var profile_out, io);

    let load_started =
        try stage_profile::begin(&profile, &var profile_out, io, "load_selfhost_sources");
    var files = try loader::load_selfhost_sources(allocator, io, "selfhost");
    defer files.deinit();
    try stage_profile::end(
        &profile,
        &var profile_out,
        io,
        "load_selfhost_sources",
        load_started
    );

    let frontend_started =
        try stage_profile::begin(&profile, &var profile_out, io, "frontend_check");
    let checked = try check_loaded_selfhost_sources(allocator, files);
    try stage_profile::end(
        &profile,
        &var profile_out,
        io,
        "frontend_check",
        frontend_started
    );
    if checked.diagnostics != 0 {
        return error("selfhost check failed");
    }

    let cache_input_started =
        try stage_profile::begin(&profile, &var profile_out, io, "stage_cache_input");
    let cache_input = try cache::stage_cache_input(files);
    try stage_profile::end(
        &profile,
        &var profile_out,
        io,
        "stage_cache_input",
        cache_input_started
    );

    let cache_key_started =
        try stage_profile::begin(&profile, &var profile_out, io, "stage_cache_key");
    let cache_key = cache::stage_key(&cache_input);
    try stage_profile::end(&profile, &var profile_out, io, "stage_cache_key", cache_key_started);

    let cache_lookup_started =
        try stage_profile::begin(&profile, &var profile_out, io, "stage_cache_lookup");
    let lookup = try cache::lookup_entry(allocator, io, &cache_key);
    try stage_profile::end(
        &profile,
        &var profile_out,
        io,
        "stage_cache_lookup",
        cache_lookup_started
    );
    if lookup.found {
        try stage_profile::record_i64(&profile, &var profile_out, "stage.cache.hit", 1);
        try stage_profile::flush(&profile, &var profile_out, io);
        let cache_restore_started = try stage_profile::begin(
            &profile,
            &var profile_out,
            io,
            "restore_cached_stage_artifact"
        );
        let packed = try std::fs::read_file(io, lookup.artifact_path);
        let restored = try restore_cached_stage_artifact(io, packed);
        try stage_profile::end(
            &profile,
            &var profile_out,
            io,
            "restore_cached_stage_artifact",
            cache_restore_started
        );
        try stage_profile::finish(&profile, &var profile_out, io);
        return restored;
    }

    try stage_profile::record_i64(&profile, &var profile_out, "stage.cache.hit", 0);
    try stage_profile::flush(&profile, &var profile_out, io);

    let emit_checked_started =
        try stage_profile::begin(&profile, &var profile_out, io, "emit_checked_artifacts");
    let artifact = try ir::emit_checked_artifacts(allocator, io, files, checked);
    try stage_profile::end(
        &profile,
        &var profile_out,
        io,
        "emit_checked_artifacts",
        emit_checked_started
    );

    let emit_llvm_started =
        try stage_profile::begin(&profile, &var profile_out, io, "emit_llvm_artifact");
    let llvm = try backend::emit_llvm_artifact(
        allocator,
        io,
        artifact.ir_path,
        artifact.manifest_path
    );
    try stage_profile::end(
        &profile,
        &var profile_out,
        io,
        "emit_llvm_artifact",
        emit_llvm_started
    );

    let pack_cache_started =
        try stage_profile::begin(&profile, &var profile_out, io, "pack_stage_cache_artifact");
    var packed = try pack_stage_cache_artifact(allocator, io, &llvm);
    try stage_profile::end(
        &profile,
        &var profile_out,
        io,
        "pack_stage_cache_artifact",
        pack_cache_started
    );
    let packed_bytes = packed.as_bytes();

    let write_cache_started =
        try stage_profile::begin(&profile, &var profile_out, io, "write_stage_cache_entry");
    let _written = try cache::write_stage_entry(allocator, io, &cache_input, packed_bytes);
    try stage_profile::end(
        &profile,
        &var profile_out,
        io,
        "write_stage_cache_entry",
        write_cache_started
    );
    try stage_profile::finish(&profile, &var profile_out, io);
    return llvm;
}

fn pack_stage_cache_artifact(
    allocator: Allocator,
    io: Io,
    llvm: &backend::data::LlvmArtifact
) -> !std::string::String {
    var out = std::string::String(allocator);
    try out.append_bytes("kizu-stage-cache-v0");
    try out.append_byte(cast<u8>(10));
    try append_cached_stage_file(io, out, llvm.ll_path);
    try append_cached_stage_file(io, out, llvm.metadata_path);
    try append_cached_stage_file(io, out, llvm.storage_path);
    try append_cached_stage_file(io, out, llvm.storage_metadata_path);
    try append_cached_stage_file(io, out, llvm.host_path);
    try append_cached_stage_file(io, out, llvm.host_metadata_path);
    return out;
}

fn append_cached_stage_file(
    io: Io,
    out: &var std::string::String,
    path: []u8
) -> !void {
    let bytes = try std::fs::read_file(io, path);
    try out.append_bytes("bytes ");
    try std::fmt::append_i64(out, std::mem::len(bytes));
    try out.append_byte(cast<u8>(10));
    try out.append_bytes(bytes);
    try out.append_byte(cast<u8>(10));
    return;
}

fn restore_cached_stage_artifact(io: Io, packed: []u8) -> !backend::data::LlvmArtifact {
    var cursor = try expect_cached_stage_line(packed, 0, "kizu-stage-cache-v0");
    let llvm = try restore_cached_stage_file(io, packed, cursor, "target/selfhost/selfhost.ll");
    cursor = llvm.next;
    let metadata = try restore_cached_stage_file(io, packed, cursor, "target/selfhost/selfhost.ll.meta");
    cursor = metadata.next;
    let storage = try restore_cached_stage_file(io, packed, cursor, "target/selfhost/selfhost.storage.ll");
    cursor = storage.next;
    let storage_metadata = try restore_cached_stage_file(io, packed, cursor, "target/selfhost/selfhost.storage.ll.meta");
    cursor = storage_metadata.next;
    let host = try restore_cached_stage_file(io, packed, cursor, "target/selfhost/selfhost.host.ll");
    cursor = host.next;
    let host_metadata = try restore_cached_stage_file(io, packed, cursor, "target/selfhost/selfhost.host.ll.meta");

    return backend::data::LlvmArtifact {
        ll_path: "target/selfhost/selfhost.ll",
        metadata_path: "target/selfhost/selfhost.ll.meta",
        storage_path: "target/selfhost/selfhost.storage.ll",
        storage_metadata_path: "target/selfhost/selfhost.storage.ll.meta",
        host_path: "target/selfhost/selfhost.host.ll",
        host_metadata_path: "target/selfhost/selfhost.host.ll.meta",
        bytes: llvm.bytes,
        metadata_bytes: metadata.bytes,
        storage_bytes: storage.bytes,
        storage_metadata_bytes: storage_metadata.bytes,
        host_bytes: host.bytes,
        host_metadata_bytes: host_metadata.bytes
    };
}

fn restore_cached_stage_file(
    io: Io,
    packed: []u8,
    cursor: i64,
    path: []u8
) -> !CachedStageFile {
    let bytes_start = cursor + std::mem::len("bytes ");
    let line_end = cached_stage_line_end(packed, cursor);
    if line_end < 0 or !std::mem::starts_with(packed[cursor..line_end], "bytes ") {
        return error("invalid cached stage artifact field");
    }
    let byte_len = try parse_cached_i64(packed[bytes_start..line_end]);
    var next = line_end + 1;
    if byte_len < 0 or next + byte_len > std::mem::len(packed) {
        return error("invalid cached stage artifact size");
    }

    let artifact = packed[next..next + byte_len];
    try std::fs::write_file(io, path, artifact);
    next = next + byte_len;
    if next >= std::mem::len(packed) or packed[next] != cast<u8>(10) {
        return error("invalid cached stage artifact terminator");
    }
    return CachedStageFile {
        next: next + 1,
        bytes: byte_len
    };
}

fn expect_cached_stage_line(packed: []u8, start: i64, expected: []u8) -> !i64 {
    let end = cached_stage_line_end(packed, start);
    if end < 0 or !std::mem::equal_bytes(packed[start..end], expected) {
        return error("invalid cached stage artifact");
    }
    return end + 1;
}

fn cached_stage_line_end(packed: []u8, start: i64) -> i64 {
    if start < 0 or start >= std::mem::len(packed) {
        return -1;
    }
    var index = start;
    while index < std::mem::len(packed) and packed[index] != cast<u8>(10) {
        index = index + 1;
    }
    if index >= std::mem::len(packed) {
        return -1;
    }
    return index;
}

fn parse_cached_i64(bytes: []u8) -> !i64 {
    if std::mem::len(bytes) == 0 {
        return error("invalid cached i64");
    }
    var index = 0;
    var value = 0;
    while index < std::mem::len(bytes) {
        let byte = bytes[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return error("invalid cached i64");
        }
        value = (value * 10) + cast<i64>(byte - cast<u8>(48));
        index = index + 1;
    }
    return value;
}
