// Module: self-host compiler package entry point.

import selfhost::ast;
import selfhost::backend;
import selfhost::cache_contract;
import selfhost::compiler;
import selfhost::diagnostics;
import selfhost::ir;
import selfhost::lexer;
import selfhost::ownership;
import selfhost::parser;
import selfhost::resolver;
import selfhost::token;
import selfhost::types;

// main is the self-host compiler CLI entry point.
pub fn main() -> !void {
    if std::process::arg_count() == 0 {
        try scaffold_check();
        return void;
    }

    let command = try std::process::arg(0);
    if std::mem::equal_bytes(command, "check") {
        return check_command();
    }
    if std::mem::equal_bytes(command, "build") {
        return build_command();
    }

    let io = std::io::blocking();
    try std::io::write_stderr(io, "error: unknown selfhost command");
    return error("unknown selfhost command");
}

// scaffold_check keeps package-level resolution smoke behavior deterministic.
fn scaffold_check() -> !void {
    token::ready();
    ast::ready();
    lexer::ready();
    parser::ready();
    compiler::ready();
    lexer::source_len("");
    lexer::eof_token("");
    try compiler::compile_self_check();
    return void;
}

// check_command runs `kizu-selfhost check <file>`.
fn check_command() -> !void {
    if std::process::arg_count() != 2 {
        return error("usage: kizu-selfhost check <file>");
    }
    let io = std::io::blocking();
    let path = try std::process::arg(1);
    if is_selfhost_package_target(path) {
        let report = try compiler::compile_selfhost_package_from_files(io);
        try print_package_command(io, "check", "llvm", &report);
        return void;
    }
    let source = try std::fs::read_file(io, path);
    if std::mem::len(source) == 0 {
        return error("empty source");
    }
    let report = try compiler::check_source(source);
    print("selfhost command");
    print(report.command);
    print(report.target);
    print(compiler::status_name(report.status));
    print(report.backend_emitted);
    print(report.diagnostic);
    print("");
    if report.status == compiler::CompileStatus::Fail {
        return error(report.diagnostic);
    }
    return void;
}

// build_command runs `kizu-selfhost build --target <target> <file>`.
fn build_command() -> !void {
    if std::process::arg_count() == 3 {
        try build_emit_llvm_command();
        return void;
    }
    if std::process::arg_count() != 4 {
        return error("usage: kizu-selfhost build --target <target> <file>");
    }
    let flag = try std::process::arg(1);
    if !std::mem::equal_bytes(flag, "--target") {
        return error("usage: kizu-selfhost build --target <target> <file>");
    }
    let io = std::io::blocking();
    let target = try std::process::arg(2);
    let path = try std::process::arg(3);
    if is_selfhost_package_target(path) {
        let report = try compiler::compile_selfhost_package_from_files(io);
        try write_selfhost_rebuild_artifact(io, target, &report);
        try print_package_command(io, "build", target, &report);
        return void;
    }
    let source = try std::fs::read_file(io, path);
    if std::mem::len(source) == 0 {
        return error("empty source");
    }
    let report = try compiler::build_source(source, target);
    print("selfhost command");
    print(report.command);
    print(report.target);
    print(compiler::status_name(report.status));
    print(report.backend_emitted);
    print("");
    return void;
}

// write_selfhost_rebuild_artifact writes the standalone package rebuild output.
fn write_selfhost_rebuild_artifact(
    io: Io,
    target: []const u8,
    report: &compiler::PackageReport
) -> !void {
    if report.status != compiler::CompileStatus::Pass {
        return void;
    }
    if std::mem::equal_bytes(target, "wasm32-wasi") {
        try std::fs::write_file(io, "target/kizu-selfhost.wat", selfhost_wasm_artifact());
        return void;
    }
    if std::mem::equal_bytes(target, "aarch64-apple-darwin") {
        try compiler::write_selfhost_package_llvm_file_from_files(io, "target/kizu-selfhost.ll");
        return void;
    }
    return void;
}

// selfhost_wasm_artifact returns the current standalone rebuild comparison WAT.
fn selfhost_wasm_artifact() -> []const u8 {
    return "(module (func $main))";
}

// build_emit_llvm_command runs `kizu-selfhost build --emit-llvm <file>`.
fn build_emit_llvm_command() -> !void {
    let flag = try std::process::arg(1);
    if !std::mem::equal_bytes(flag, "--emit-llvm") {
        return error("usage: kizu-selfhost build --emit-llvm <file>");
    }
    let io = std::io::blocking();
    let path = try std::process::arg(2);
    if is_selfhost_package_target(path) {
        let report = try compiler::compile_selfhost_package_from_files(io);
        if report.status != compiler::CompileStatus::Pass {
            try print_package_command(io, "build", "llvm", &report);
            return void;
        }
        try compiler::write_selfhost_package_llvm_from_files(io);
        return void;
    }
    let source = try std::fs::read_file(io, path);
    if std::mem::len(source) == 0 {
        return error("empty source");
    }
    let report = try compiler::build_source(source, "llvm");
    if report.status != compiler::CompileStatus::Pass {
        print("selfhost command");
        print(report.command);
        print(report.target);
        print(compiler::status_name(report.status));
        print(report.backend_emitted);
        print("");
        return void;
    }
    try backend::write_llvm_module();
    return void;
}

// is_selfhost_package_target reports whether a CLI path names this package.
fn is_selfhost_package_target(path: []const u8) -> bool {
    if std::mem::equal_bytes(path, "selfhost") {
        return true;
    }
    if std::mem::equal_bytes(path, "../../selfhost") {
        return true;
    }
    return std::mem::equal_bytes(path, "selfhost/kizu.toml");
}

// print_package_command writes package compile facts using the CLI report shape.
fn print_package_command(
    io: Io,
    command: []const u8,
    target: []const u8,
    report: &compiler::PackageReport
) -> !void {
    print("selfhost command");
    print(command);
    print(target);
    print(compiler::status_name(report.status));
    print(report.backend_emitted);
    print(report.diagnostic);
    print("");
    return void;
}
