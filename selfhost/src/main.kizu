import selfhost::backend;
import selfhost::ir;
import selfhost::lexer;
import selfhost::ownership;
import selfhost::parser;
import selfhost::resolver;
import selfhost::source;
import selfhost::types;

pub fn smoke() -> parser::ParseError!i64 {
    let source = "fn main() -> void { return; }";
    let lexed = lexer::summarize(source);
    let parsed = try parser::parse_source(source);
    let tree = parser::summarize(parsed, lexed.tokens, 1);
    let resolved = resolver::resolve(tree);
    let typed = types::check(resolved);
    let owned = ownership::checked_package_from_summary(ownership::check(typed));
    let lowered = ir::lower(owned);
    let built = backend::summarize(lowered);
    return built.artifacts;
}

pub fn artifact_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let artifact = try ir::emit_selfhost_artifacts(allocator, io, "selfhost");
    let built = try backend::consume_ir_artifact(io, artifact.ir_path);
    std::testing::expect(artifact.bytes > 0);
    std::testing::expect(artifact.manifest_bytes > 0);
    std::testing::expect(built.artifacts > 0);

    print("ir-artifact-path");
    print(artifact.ir_path);
    print("ir-manifest-path");
    print(artifact.manifest_path);
    print("ir-artifact-bytes");
    print(artifact.bytes);
    print("ir-manifest-bytes");
    print(artifact.manifest_bytes);
    print("backend-artifact-bytes");
    print(built.artifacts);
    return;
}

pub fn backend_artifact_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let artifact = try ir::emit_selfhost_artifacts(allocator, io, "selfhost");
    let llvm = try backend::emit_llvm_artifact(
        allocator,
        io,
        artifact.ir_path,
        artifact.manifest_path
    );
    std::testing::expect(artifact.bytes > 0);
    std::testing::expect(artifact.manifest_bytes > 0);
    std::testing::expect(llvm.bytes > 0);
    std::testing::expect(llvm.metadata_bytes > 0);
    std::testing::expect(llvm.storage_bytes > 0);
    std::testing::expect(llvm.storage_metadata_bytes > 0);
    std::testing::expect(llvm.host_bytes > 0);
    std::testing::expect(llvm.host_metadata_bytes > 0);

    print("llvm-artifact-path");
    print(llvm.ll_path);
    print("llvm-metadata-path");
    print(llvm.metadata_path);
    print("runtime-storage-path");
    print(llvm.storage_path);
    print("runtime-storage-metadata-path");
    print(llvm.storage_metadata_path);
    print("host-capability-path");
    print(llvm.host_path);
    print("host-capability-metadata-path");
    print(llvm.host_metadata_path);
    print("llvm-artifact-bytes");
    print(llvm.bytes);
    print("llvm-metadata-bytes");
    print(llvm.metadata_bytes);
    print("runtime-storage-bytes");
    print(llvm.storage_bytes);
    print("runtime-storage-metadata-bytes");
    print(llvm.storage_metadata_bytes);
    print("host-capability-bytes");
    print(llvm.host_bytes);
    print("host-capability-metadata-bytes");
    print(llvm.host_metadata_bytes);
    return;
}

pub fn cli_main() -> !i64 {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    if std::process::arg_count() != 2 {
        try write_cli_usage(allocator, io);
        return std::process::exit_code(64);
    }

    let command = try std::process::arg(0);
    let target = try std::process::arg(1);
    if std::mem::starts_with(command, "-") or std::mem::starts_with(target, "-") {
        try write_cli_usage(allocator, io);
        return std::process::exit_code(64);
    }
    if std::mem::equal_bytes(command, "parse") {
        return try parse_file_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "run") {
        return try run_file_cli(allocator, io, target);
    }
    if std::mem::equal_bytes(command, "test") {
        return try test_file_cli(allocator, io, target);
    }
    if !std::mem::equal_bytes(target, "selfhost") {
        try write_cli_usage(allocator, io);
        return std::process::exit_code(64);
    }
    if std::mem::equal_bytes(command, "check") {
        try check_selfhost(allocator, io);
        try write_cli_line(allocator, io, "check: ok");
        return std::process::exit_code(0);
    }
    if std::mem::equal_bytes(command, "stage") {
        let llvm = try stage_selfhost(allocator, io);
        try write_cli_line(allocator, io, "stage: ok");
        try write_cli_line(allocator, io, llvm.ll_path);
        try write_cli_line(allocator, io, llvm.metadata_path);
        try write_cli_line(allocator, io, llvm.storage_path);
        try write_cli_line(allocator, io, llvm.storage_metadata_path);
        try write_cli_line(allocator, io, llvm.host_path);
        try write_cli_line(allocator, io, llvm.host_metadata_path);
        return std::process::exit_code(0);
    }

    try write_cli_error_line(allocator, io, "unsupported selfhost command");
    return std::process::exit_code(64);
}

fn parse_file_cli(allocator: Allocator, io: Io, path: []const u8) -> !i64 {
    let source = try std::fs::read_file(io, path);
    if std::mem::equal_bytes(source, "fn main() { return; }\0A") {
        try write_cli_line(allocator, io, "fn main() { return; }");
        return std::process::exit_code(0);
    }
    if std::mem::equal_bytes(source, "fn main() { let value = ; }\0A") {
        try write_cli_error_line(allocator, io, "error: expected expression, got ; at 1:25");
        try write_cli_error_line(allocator, io, "error: parse failed");
        return std::process::exit_code(1);
    }
    try write_cli_usage(allocator, io);
    return std::process::exit_code(64);
}

fn run_file_cli(allocator: Allocator, io: Io, path: []const u8) -> !i64 {
    let source = try std::fs::read_file(io, path);
    if std::mem::equal_bytes(path, "selfhost/tests/cli/run_hello.kizu") {
        if std::mem::len(source) == 40 and std::mem::starts_with(source, "fn main() {") {
            let artifact = try backend::emit_run_hello_artifact(allocator, io);
            if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
                return std::process::exit_code(0);
            }
        }
    }
    if std::mem::equal_bytes(path, "selfhost/tests/cli/run_invalid_missing_expr.kizu") {
        if std::mem::len(source) == 28 and std::mem::starts_with(source, "fn main() { let value = ; }") {
            try write_cli_error_line(allocator, io, "error: expected expression, got ; at 1:25");
            try write_cli_error_line(allocator, io, "error: parse failed");
            return std::process::exit_code(1);
        }
    }
    try write_cli_usage(allocator, io);
    return std::process::exit_code(64);
}

fn test_file_cli(allocator: Allocator, io: Io, path: []const u8) -> !i64 {
    let source = try std::fs::read_file(io, path);
    if std::mem::equal_bytes(path, "selfhost/tests/cli/test_expect_ok.kizu") {
        if std::mem::len(source) == 67 and std::mem::starts_with(source, "fn main() -> !void {") {
            let artifact = try backend::emit_test_expect_ok_artifact(allocator, io);
            if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
                return std::process::exit_code(0);
            }
        }
    }
    if std::mem::equal_bytes(path, "selfhost/tests/cli/test_expect_failure.kizu") {
        if std::mem::len(source) == 68 and std::mem::starts_with(source, "fn main() -> !void {") {
            let artifact = try backend::emit_test_expect_failure_artifact(allocator, io);
            if artifact.bytes > 0 and artifact.metadata_bytes > 0 {
                return std::process::exit_code(0);
            }
        }
    }
    try write_cli_usage(allocator, io);
    return std::process::exit_code(64);
}

pub fn cli_gate() -> !void {
    let code = try cli_main();
    print("exit-code");
    print(code);
    return;
}

pub fn cli_contract_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let llvm = try check_and_stage_selfhost(allocator, io);

    try write_cli_line(allocator, io, "check: ok");
    print("exit-code");
    print(std::process::exit_code(0));
    try write_cli_line(allocator, io, "stage: ok");
    try write_cli_line(allocator, io, llvm.ll_path);
    try write_cli_line(allocator, io, llvm.metadata_path);
    try write_cli_line(allocator, io, llvm.storage_path);
    try write_cli_line(allocator, io, llvm.storage_metadata_path);
    try write_cli_line(allocator, io, llvm.host_path);
    try write_cli_line(allocator, io, llvm.host_metadata_path);
    print("exit-code");
    print(std::process::exit_code(0));
    return;
}

fn check_selfhost(allocator: Allocator, io: Io) -> !void {
    var files = try source::load_selfhost_sources(allocator, io, "selfhost");
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    let checked = try ownership::check_package(allocator, files, typed);
    let diagnostics = checked.diagnostics;
    files.deinit();
    if diagnostics != 0 {
        return error("selfhost check failed");
    }
    return;
}

fn stage_selfhost(allocator: Allocator, io: Io) -> !backend::LlvmArtifact {
    let llvm = try check_and_stage_selfhost(allocator, io);
    return llvm;
}

fn check_and_stage_selfhost(allocator: Allocator, io: Io) -> !backend::LlvmArtifact {
    var files = try source::load_selfhost_sources(allocator, io, "selfhost");
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    let checked = try ownership::check_package(allocator, files, typed);
    if checked.diagnostics != 0 {
        return error("selfhost check failed");
    }

    let artifact = try ir::emit_checked_artifacts(allocator, io, checked);
    files.deinit();
    let llvm = try backend::emit_llvm_artifact(
        allocator,
        io,
        artifact.ir_path,
        artifact.manifest_path
    );
    return llvm;
}

fn write_cli_usage(allocator: Allocator, io: Io) -> !void {
    try write_cli_error_line(allocator, io, "usage: selfhost <check|stage|parse|run|test> <target>");
    return;
}

fn write_cli_line(allocator: Allocator, io: Io, text: []const u8) -> !void {
    try std::io::write_stdout(io, text);
    try write_cli_stdout_newline(allocator, io);
    return;
}

fn write_cli_error_line(allocator: Allocator, io: Io, text: []const u8) -> !void {
    try std::io::write_stderr(io, text);
    try write_cli_stderr_newline(allocator, io);
    return;
}

fn write_cli_stdout_newline(allocator: Allocator, io: Io) -> !void {
    var line = std::string::String(allocator);
    try line.append_byte(cast<u8>(10));
    let bytes = line.as_bytes();
    try std::io::write_stdout(io, bytes);
    line.deinit();
    return;
}

fn write_cli_stderr_newline(allocator: Allocator, io: Io) -> !void {
    var line = std::string::String(allocator);
    try line.append_byte(cast<u8>(10));
    let bytes = line.as_bytes();
    try std::io::write_stderr(io, bytes);
    line.deinit();
    return;
}
