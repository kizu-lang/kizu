import selfhost::resolver;
import selfhost::source;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var symbols = std::map::Map<[]const u8, resolver::BindingKind>(allocator);
    var visibility = std::map::Map<[]const u8, bool>(allocator);
    var files = try source::load_selfhost_sources(allocator, io, "selfhost");

    try resolver::declare(
        symbols,
        visibility,
        "selfhost::lexer",
        resolver::BindingKind::Module,
        true
    );
    try resolver::declare(
        symbols,
        visibility,
        "selfhost::lexer::summarize",
        resolver::BindingKind::Function,
        true
    );
    try resolver::declare(
        symbols,
        visibility,
        "selfhost::ast::AstSummary",
        resolver::BindingKind::TypeName,
        true
    );
    try resolver::declare(
        symbols,
        visibility,
        "selfhost::resolver::scope",
        resolver::BindingKind::Local,
        false
    );
    try expect_resolved(symbols, visibility);
    try expect_diagnostics(allocator);
    let production = try resolver::resolve_sources(allocator, files);

    let summary = resolver::summarize(symbols, 4);
    std::testing::expect_equal<i64>(1, summary.modules);
    std::testing::expect_equal<i64>(4, summary.symbols);
    std::testing::expect_equal<i64>(4, summary.diagnostics);
    std::testing::expect(production.modules > 0);
    std::testing::expect(production.symbols > 0);
    std::testing::expect_equal<i64>(0, production.diagnostics);

    files.deinit();
    symbols.deinit();
    visibility.deinit();

    print("resolver-modules");
    print(production.modules);
    print("resolver-production-symbols");
    print(production.symbols);
    print("resolver-production-diagnostics");
    print(production.diagnostics);
    print("resolver-symbols");
    print(summary.symbols);
    print("resolver-diagnostics");
    print(summary.diagnostics);
    print("resolver-related");
    print(3);
    return;
}

fn expect_resolved(
    symbols: &std::map::Map<[]const u8, resolver::BindingKind>,
    visibility: &std::map::Map<[]const u8, bool>
) -> !void {
    let module = try resolver::resolve_kind(symbols, "selfhost::lexer");
    std::testing::expect(module == resolver::BindingKind::Module);
    let function = try resolver::resolve_kind(symbols, "selfhost::lexer::summarize");
    std::testing::expect(function == resolver::BindingKind::Function);
    let type_name = try resolver::resolve_kind(symbols, "selfhost::ast::AstSummary");
    std::testing::expect(type_name == resolver::BindingKind::TypeName);
    let local = try resolver::resolve_kind(symbols, "selfhost::resolver::scope");
    std::testing::expect(local == resolver::BindingKind::Local);
    let public_symbol = try resolver::is_public(visibility, "selfhost::lexer::summarize");
    std::testing::expect(public_symbol);
    let private_symbol = try resolver::is_public(visibility, "selfhost::resolver::scope");
    std::testing::expect(!private_symbol);
    return;
}

fn expect_diagnostics(allocator: Allocator) -> !void {
    var missing = resolver::missing_symbol(allocator, "selfhost/src/main.kizu", 5, 12);
    try expect_diagnostic(missing, "missing symbol", 0);

    var duplicate = try resolver::duplicate_symbol(
        allocator,
        "selfhost/src/main.kizu",
        10,
        15,
        2,
        7
    );
    try expect_diagnostic(duplicate, "duplicate symbol", 1);

    var private = try resolver::private_access(
        allocator,
        "selfhost/src/main.kizu",
        20,
        27,
        1,
        4
    );
    try expect_diagnostic(private, "private access", 1);

    var cycle = try resolver::import_cycle(
        allocator,
        "selfhost/src/main.kizu",
        30,
        38,
        40,
        48
    );
    try expect_diagnostic(cycle, "import cycle", 1);
    return;
}

fn expect_diagnostic(
    diagnostic: std::kizu::diagnostic::Diagnostic,
    message: []const u8,
    related: i64
) -> !void {
    std::testing::expect_equal<[]const u8>(message, diagnostic.message);
    std::testing::expect(related == diagnostic.related_len());
    diagnostic.deinit();
    return;
}
