// Module: diagnostics boundary for the future self-host compiler frontend.

pub enum Severity {
    Error
    Warning
}

pub struct PrimarySpan {
    pub start: i64;
    pub end: i64;
    pub line: i64;
    pub column: i64;
}

pub struct Diagnostic {
    pub severity: Severity;
    pub message: []const u8;
    pub span: PrimarySpan;
}

// error creates a primary diagnostic error.
pub fn error(
    message: []const u8,
    start: i64,
    end: i64,
    line: i64,
    column: i64
) -> Diagnostic {
    return Diagnostic {
        severity: Severity::Error,
        message: message,
        span: PrimarySpan {
            start: start,
            end: end,
            line: line,
            column: column,
        },
    };
}

// warning creates a primary diagnostic warning.
pub fn warning(
    message: []const u8,
    start: i64,
    end: i64,
    line: i64,
    column: i64
) -> Diagnostic {
    return Diagnostic {
        severity: Severity::Warning,
        message: message,
        span: PrimarySpan {
            start: start,
            end: end,
            line: line,
            column: column,
        },
    };
}

// is_error reports whether a diagnostic is an error.
pub fn is_error(diagnostic: Diagnostic) -> bool {
    return diagnostic.severity == Severity::Error;
}

// same_primary_span compares only the source span identity.
pub fn same_primary_span(left: Diagnostic, right: Diagnostic) -> bool {
    if left.span.start != right.span.start {
        return false;
    }
    if left.span.end != right.span.end {
        return false;
    }
    if left.span.line != right.span.line {
        return false;
    }
    return left.span.column == right.span.column;
}

// ready exposes the diagnostics module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
