// Module: component tests for diagnostics and resolver self-host boundaries.

import selfhost::diagnostics;
import selfhost::resolver;

// resolver_component_test checks module alias and primary diagnostic helpers.
pub fn resolver_component_test() -> !void {
    let module = try resolver::resolve_module_path("selfhost::parser::ast");
    let std_module = try resolver::resolve_module_path("std::mem");
    let conflict = try resolver::alias_conflicts("app::lexer", "selfhost::lexer");
    let diagnostic_kind = diagnostics::error("missing import", 4, 9, 2, 3);
    let diagnostic_span = diagnostics::error("missing import", 4, 9, 2, 3);
    let same = diagnostics::error("same span", 4, 9, 2, 3);
    let warning = diagnostics::warning("unused import", 12, 18, 5, 7);

    try std::testing::expect_equal_bytes("ast", module.alias);
    try std::testing::expect(module.is_std == false);
    try std::testing::expect_equal_bytes("mem", std_module.alias);
    try std::testing::expect(std_module.is_std);
    try std::testing::expect(conflict);
    try std::testing::expect_equal_i64(4, diagnostic_span.span.start);
    try std::testing::expect_equal_i64(9, diagnostic_span.span.end);
    try std::testing::expect_equal_i64(2, diagnostic_span.span.line);
    try std::testing::expect_equal_i64(3, diagnostic_span.span.column);
    try std::testing::expect(diagnostics::is_error(diagnostic_kind));
    try std::testing::expect(diagnostics::is_error(warning) == false);
    try std::testing::expect(diagnostics::same_primary_span(diagnostic_span, same));
    return void;
}
