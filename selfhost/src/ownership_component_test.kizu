// Module: component tests for self-host ownership checker boundaries.

import selfhost::ownership;

// ownership_component_test checks move, copy, and borrow transition facts.
pub fn ownership_component_test() -> !void {
    let copy_value = ownership::owned(true);
    let copy_move = ownership::move_value(&copy_value);
    let owned_value = ownership::owned(false);
    let moved = ownership::move_value(&owned_value);
    let double_move = ownership::move_value(&moved.next);
    let borrowed = ownership::borrow_shared(&owned_value);
    let move_borrowed = ownership::move_value(&borrowed.next);
    let mut_borrow_conflict = ownership::borrow_mut(&borrowed.next);
    let restored = ownership::end_borrow(&borrowed.next);

    try std::testing::expect(copy_move.allowed);
    try std::testing::expect(copy_move.next.kind == ownership::AccessKind::Owned);
    try std::testing::expect(moved.allowed);
    try std::testing::expect(moved.next.kind == ownership::AccessKind::Moved);
    try std::testing::expect(double_move.allowed == false);
    try std::testing::expect(move_borrowed.allowed == false);
    try std::testing::expect(mut_borrow_conflict.allowed == false);
    try std::testing::expect(restored.kind == ownership::AccessKind::Owned);
    return void;
}
