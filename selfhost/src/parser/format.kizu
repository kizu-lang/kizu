import selfhost::lexer;

struct CommentFormatState {
    last: u8,
    at_line_start: bool,
}

pub fn format_source(
    allocator: Allocator,
    source: []u8
) -> !std::string::String {
    var format_tokens = try lexer::tokenize(allocator, source);
    var out = std::string::String(allocator);
    var index = 0;
    var cursor = 0;
    var depth = 0;
    var previous = "";
    var last_top_level_decl = "";
    var last = cast<u8>(0);
    var at_line_start = true;
    let leading_imports = try leading_import_indices(
        allocator,
        source,
        &format_tokens
    );
    if leading_imports.len() > 1 {
        let next_index = try index_after_leading_imports(&format_tokens);
        let last_import = try format_tokens.get(next_index - 1);
        if !has_line_comment_between(source, 0, last_import.end) {
            try append_sorted_imports(out, source, &format_tokens, &leading_imports);
            index = next_index;
            cursor = last_import.end;
            previous = ";";
            last_top_level_decl = "import";
            last = cast<u8>(10);
            at_line_start = true;
        }
    }
    leading_imports.deinit();
    while index < format_tokens.len() {
        let token = try format_tokens.get(index);
        let state = try append_preserved_line_comments(
            out,
            source,
            cursor,
            token.start,
            depth,
            last,
            at_line_start
        );
        last = state.last;
        at_line_start = state.at_line_start;
        if lexer::is_eof(token) {
            index = format_tokens.len();
        } else {
            let text = token_text(source, token);
            let trailing_comma = try is_trailing_comma(source, &format_tokens, index, text);
            if !trailing_comma {
                if std::mem::equal_bytes(text, "}") {
                    if depth > 0 {
                        depth = depth - 1;
                    }
                    if std::mem::equal_bytes(previous, "{") {
                        try out.append_bytes(text);
                    } else {
                        if !at_line_start {
                            try out.append_byte(cast<u8>(10));
                        }
                        try append_indent(out, depth);
                        try out.append_bytes(text);
                    }
                    last = last_byte(text);
                    previous = text;
                    at_line_start = false;
                    let wants_newline = try rbrace_wants_newline(source, &format_tokens, index);
                    if wants_newline {
                        try out.append_byte(cast<u8>(10));
                        last = cast<u8>(10);
                        at_line_start = true;
                    }
                } else {
                    let consecutive_import = std::mem::equal_bytes(text, "import") and
                        std::mem::equal_bytes(last_top_level_decl, "import");
                    if depth == 0 and out.len() > 0 and std::mem::len(previous) > 0 and
                        starts_new_top_level_decl(previous, text) and !consecutive_import {
                        if !at_line_start {
                            try out.append_byte(cast<u8>(10));
                            last = cast<u8>(10);
                            at_line_start = true;
                        } else {
                            if last == cast<u8>(10) {
                                try out.append_byte(cast<u8>(10));
                                last = cast<u8>(10);
                            }
                        }
                    }
                    if depth == 0 and at_line_start and is_top_level_decl_start(text) {
                        last_top_level_decl = text;
                    }
                    if at_line_start {
                        try append_indent(out, depth);
                        at_line_start = false;
                    }
                    if should_insert_space(previous, text, last) {
                        try out.append_byte(cast<u8>(32));
                        last = cast<u8>(32);
                    }
                    try out.append_bytes(text);
                    last = last_byte(text);
                    previous = text;
                    if std::mem::equal_bytes(text, "{") {
                        depth = depth + 1;
                        if !(try next_token_text_equals(source, &format_tokens, index, "}")) {
                            try out.append_byte(cast<u8>(10));
                            last = cast<u8>(10);
                            at_line_start = true;
                        }
                    }
                    if std::mem::equal_bytes(text, ";") {
                        try out.append_byte(cast<u8>(10));
                        last = cast<u8>(10);
                        at_line_start = true;
                    }
                }
            }
            cursor = token.end;
            index = index + 1;
        }
    }
    format_tokens.deinit();
    return out;
}

fn leading_import_indices(
    allocator: Allocator,
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !std::array::Array<i64> {
    var indices = std::array::Array<i64>(allocator);
    var index = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        if !is_import_token(token) {
            index = tokens.len();
        } else {
            try indices.append(index);
            index = try index_after_import(tokens, index);
        }
    }
    try sort_import_indices(source, tokens, &var indices);
    return indices;
}

fn sort_import_indices(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    indices: &var std::array::Array<i64>
) -> !void {
    var index = 1;
    while index < indices.len() {
        var cursor = index;
        var scanning = true;
        while scanning and cursor > 0 {
            let left = try indices.get(cursor - 1);
            let right = try indices.get(cursor);
            if try import_path_less(source, tokens, right, left) {
                try indices.set(cursor - 1, right);
                try indices.set(cursor, left);
                cursor = cursor - 1;
            } else {
                scanning = false;
            }
        }
        index = index + 1;
    }
    return;
}

fn append_sorted_imports(
    out: &var std::string::String,
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    indices: &std::array::Array<i64>
) -> !void {
    var index = 0;
    while index < indices.len() {
        let import_index = try indices.get(index);
        try append_import_decl(out, source, tokens, import_index);
        try out.append_byte(cast<u8>(10));
        index = index + 1;
    }
    return;
}

fn append_import_decl(
    out: &var std::string::String,
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    import_index: i64
) -> !void {
    try out.append_bytes("import ");
    var index = import_index + 1;
    while index < tokens.len() {
        let token = try tokens.get(index);
        let text = token_text(source, token);
        if is_semicolon_token(token) {
            try out.append_bytes(";");
            return;
        }
        if is_ident_token(token) or is_double_colon_token(token) {
            try out.append_bytes(text);
        }
        index = index + 1;
    }
    return;
}

fn index_after_leading_imports(
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !i64 {
    var index = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        if !is_import_token(token) {
            return index;
        }
        index = try index_after_import(tokens, index);
    }
    return index;
}

fn index_after_import(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    import_index: i64
) -> !i64 {
    var index = import_index;
    while index < tokens.len() {
        let token = try tokens.get(index);
        if is_semicolon_token(token) {
            return index + 1;
        }
        if lexer::is_eof(token) {
            return index;
        }
        index = index + 1;
    }
    return index;
}

fn import_path_less(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    left: i64,
    right: i64
) -> !bool {
    var left_index = left + 1;
    var right_index = right + 1;
    while left_index < tokens.len() and right_index < tokens.len() {
        let left_token = try tokens.get(left_index);
        let right_token = try tokens.get(right_index);
        if is_semicolon_token(left_token) {
            return !is_semicolon_token(right_token);
        }
        if is_semicolon_token(right_token) {
            return false;
        }
        let comparison = compare_bytes(token_text(source, left_token), token_text(source, right_token));
        if comparison < 0 {
            return true;
        }
        if comparison > 0 {
            return false;
        }
        left_index = left_index + 1;
        right_index = right_index + 1;
    }
    return false;
}

pub fn has_unsupported_line_comment(source: []u8) -> bool {
    return has_unsupported_line_comment_after(source, 0);
}

fn token_text(
    source: []u8,
    token: std::kizu::lexer::Token
) -> []u8 {
    return source[token.start..token.end];
}

fn append_preserved_line_comments(
    out: &var std::string::String,
    source: []u8,
    start: i64,
    end: i64,
    depth: i64,
    last: u8,
    at_line_start: bool
) -> !CommentFormatState {
    var current_last = last;
    var current_at_line_start = at_line_start;
    var index = start;
    while index < end {
        if index + 1 < end and source[index] == cast<u8>(47) and
            source[index + 1] == cast<u8>(47) and
            line_comment_is_full_line(source, index) {
            if !current_at_line_start {
                try out.append_byte(cast<u8>(10));
            }
            try append_indent(out, depth);
            let comment_end = line_end_excluding_break(source, index + 2);
            try out.append_bytes(source[index..comment_end]);
            try out.append_byte(cast<u8>(10));
            current_last = cast<u8>(10);
            current_at_line_start = true;
            index = line_end_including_break(source, index + 2);
        } else {
            index = index + 1;
        }
    }
    return CommentFormatState {
        last: current_last,
        at_line_start: current_at_line_start
    };
}

fn has_unsupported_line_comment_after(source: []u8, start: i64) -> bool {
    var index = start;
    let length = std::mem::len(source);
    var in_string = false;
    while index < length {
        let byte = source[index];
        if in_string {
            if byte == cast<u8>(92) and index + 1 < length {
                index = index + 2;
                continue;
            }
            if byte == cast<u8>(34) {
                in_string = false;
            }
            index = index + 1;
            continue;
        }
        if byte == cast<u8>(34) {
            in_string = true;
            index = index + 1;
            continue;
        }
        if byte == cast<u8>(47) and index + 1 < length and
            source[index + 1] == cast<u8>(47) {
            if !line_comment_is_full_line(source, index) {
                return true;
            }
            index = line_end_including_break(source, index + 2);
            continue;
        }
        index = index + 1;
    }
    return false;
}

fn has_line_comment_between(source: []u8, start: i64, end: i64) -> bool {
    var index = start;
    while index + 1 < end {
        if source[index] == cast<u8>(47) and source[index + 1] == cast<u8>(47) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn line_comment_is_full_line(source: []u8, comment_start: i64) -> bool {
    var index = comment_start;
    while index > 0 {
        let previous = index - 1;
        if is_line_break(source[previous]) {
            return true;
        }
        if !is_horizontal_space(source[previous]) {
            return false;
        }
        index = previous;
    }
    return true;
}

fn line_end_excluding_break(source: []u8, start: i64) -> i64 {
    var index = start;
    let length = std::mem::len(source);
    while index < length and !is_line_break(source[index]) {
        index = index + 1;
    }
    return index;
}

fn line_end_including_break(source: []u8, start: i64) -> i64 {
    var index = start;
    let length = std::mem::len(source);
    while index < length and !is_line_break(source[index]) {
        index = index + 1;
    }
    if index < length {
        return after_line_break(source, index);
    }
    return index;
}

fn after_line_break(source: []u8, index: i64) -> i64 {
    let length = std::mem::len(source);
    if source[index] == cast<u8>(13) and index + 1 < length and
        source[index + 1] == cast<u8>(10) {
        return index + 2;
    }
    return index + 1;
}

fn is_horizontal_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9);
}

fn is_line_break(byte: u8) -> bool {
    return byte == cast<u8>(10) or byte == cast<u8>(13);
}

fn is_import_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Import => true,
        _ => false,
    };
}

fn is_ident_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        _ => false,
    };
}

fn is_double_colon_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        DoubleColon => true,
        _ => false,
    };
}

fn is_semicolon_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Semicolon => true,
        _ => false,
    };
}

fn compare_bytes(left: []u8, right: []u8) -> i64 {
    var index = 0;
    let left_len = std::mem::len(left);
    let right_len = std::mem::len(right);
    while index < left_len and index < right_len {
        if left[index] < right[index] {
            return 0 - 1;
        }
        if left[index] > right[index] {
            return 1;
        }
        index = index + 1;
    }
    if left_len < right_len {
        return 0 - 1;
    }
    if left_len > right_len {
        return 1;
    }
    return 0;
}

fn next_token_text_equals(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    expected: []u8
) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let next = try tokens.get(index + 1);
    if lexer::is_eof(next) {
        return false;
    }
    return std::mem::equal_bytes(token_text(source, next), expected);
}

fn append_indent(out: &var std::string::String, depth: i64) -> !void {
    var index = 0;
    while index < depth {
        try out.append_bytes("    ");
        index = index + 1;
    }
    return;
}

fn rbrace_wants_newline(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let next = try tokens.get(index + 1);
    if lexer::is_eof(next) {
        return false;
    }
    let text = token_text(source, next);
    return !(std::mem::equal_bytes(text, ",") or
        std::mem::equal_bytes(text, ";") or
        std::mem::equal_bytes(text, ".") or
        std::mem::equal_bytes(text, "::") or
        std::mem::equal_bytes(text, ")") or
        std::mem::equal_bytes(text, "]") or
        std::mem::equal_bytes(text, "}") or
        std::mem::equal_bytes(text, "?") or
        std::mem::equal_bytes(text, "!") or
        std::mem::equal_bytes(text, "else"));
}

fn is_trailing_comma(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    text: []u8
) -> !bool {
    if !std::mem::equal_bytes(text, ",") {
        return false;
    }
    let before_paren = try next_token_text_equals(source, tokens, index, ")");
    if before_paren {
        return true;
    }
    let before_bracket = try next_token_text_equals(source, tokens, index, "]");
    if before_bracket {
        return true;
    }
    if !(try next_token_text_equals(source, tokens, index, "}")) {
        return false;
    }
    return !(try is_match_arm_trailing_comma(source, tokens, index));
}

fn is_match_arm_trailing_comma(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    var cursor = index;
    var brace_depth = 0;
    while cursor > 0 {
        cursor = cursor - 1;
        let token = try tokens.get(cursor);
        let text = token_text(source, token);
        if std::mem::equal_bytes(text, "}") {
            brace_depth = brace_depth + 1;
        }
        if std::mem::equal_bytes(text, "{") {
            if brace_depth == 0 {
                return false;
            }
            brace_depth = brace_depth - 1;
        }
        if brace_depth == 0 and std::mem::equal_bytes(text, "=>") {
            return true;
        }
    }
    return false;
}

fn should_insert_space(
    previous: []u8,
    current: []u8,
    last: u8
) -> bool {
    if last == cast<u8>(0) or last == cast<u8>(10) or last == cast<u8>(32) {
        return false;
    }
    if no_space_before(current) {
        return false;
    }
    if std::mem::equal_bytes(previous, "]") and can_follow_slice_marker(current) {
        return false;
    }
    if no_space_after(previous) {
        return false;
    }
    return true;
}

fn no_space_before(text: []u8) -> bool {
    return std::mem::equal_bytes(text, ")") or
        std::mem::equal_bytes(text, "]") or
        std::mem::equal_bytes(text, ";") or
        std::mem::equal_bytes(text, ",") or
        std::mem::equal_bytes(text, ".") or
        std::mem::equal_bytes(text, "::") or
        std::mem::equal_bytes(text, ">") or
        std::mem::equal_bytes(text, ":") or
        std::mem::equal_bytes(text, "(");
}

fn no_space_after(text: []u8) -> bool {
    return std::mem::equal_bytes(text, "(") or
        std::mem::equal_bytes(text, "[") or
        std::mem::equal_bytes(text, ".") or
        std::mem::equal_bytes(text, "::") or
        std::mem::equal_bytes(text, "!") or
        std::mem::equal_bytes(text, "&") or
        std::mem::equal_bytes(text, "<");
}

fn can_follow_slice_marker(text: []u8) -> bool {
    if std::mem::len(text) == 0 {
        return false;
    }
    let first = text[0];
    return (first >= cast<u8>(65) and first <= cast<u8>(90)) or
        (first >= cast<u8>(97) and first <= cast<u8>(122)) or
        first == cast<u8>(95) or
        std::mem::equal_bytes(text, "&") or
        std::mem::equal_bytes(text, "!") or
        std::mem::equal_bytes(text, "?") or
        std::mem::equal_bytes(text, "[");
}

fn is_top_level_decl_start(text: []u8) -> bool {
    return std::mem::equal_bytes(text, "import") or
        std::mem::equal_bytes(text, "pub") or
        std::mem::equal_bytes(text, "unsafe") or
        std::mem::equal_bytes(text, "extern") or
        std::mem::equal_bytes(text, "fn") or
        std::mem::equal_bytes(text, "struct") or
        std::mem::equal_bytes(text, "enum") or
        std::mem::equal_bytes(text, "union");
}

fn starts_new_top_level_decl(previous: []u8, current: []u8) -> bool {
    if !is_top_level_decl_start(current) {
        return false;
    }
    return !(std::mem::equal_bytes(previous, "pub") or
        std::mem::equal_bytes(previous, "unsafe") or
        std::mem::equal_bytes(previous, "extern"));
}

fn last_byte(text: []u8) -> u8 {
    return text[std::mem::len(text) - 1];
}
