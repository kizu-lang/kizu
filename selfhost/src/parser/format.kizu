import selfhost::lexer;

pub fn format_source(
    allocator: Allocator,
    source: []u8
) -> !std::string::String {
    let prefix_end = leading_comment_prefix_end(source);
    let body = source[prefix_end..std::mem::len(source)];
    var format_tokens = try lexer::tokenize(allocator, body);
    var out = std::string::String(allocator);
    if prefix_end > 0 {
        try out.append_bytes(source[0..prefix_end]);
    }
    var index = 0;
    var depth = 0;
    var previous = "";
    var last = cast<u8>(0);
    var at_line_start = true;
    while index < format_tokens.len() {
        let token = try format_tokens.get(index);
        if lexer::is_eof(token) {
            index = format_tokens.len();
        } else {
            let text = token_text(body, token);
            let trailing_comma = try is_trailing_comma(body, &format_tokens, index, text);
            if !trailing_comma {
                if std::mem::equal_bytes(text, "}") {
                    if depth > 0 {
                        depth = depth - 1;
                    }
                    if std::mem::equal_bytes(previous, "{") {
                        try out.append_bytes(text);
                    } else {
                        if !at_line_start {
                            try out.append_byte(cast<u8>(10));
                        }
                        try append_indent(out, depth);
                        try out.append_bytes(text);
                    }
                    last = last_byte(text);
                    previous = text;
                    at_line_start = false;
                    let wants_newline = try rbrace_wants_newline(body, &format_tokens, index);
                    if wants_newline {
                        try out.append_byte(cast<u8>(10));
                        last = cast<u8>(10);
                        at_line_start = true;
                    }
                } else {
                    if depth == 0 and out.len() > 0 and starts_new_top_level_decl(previous, text) {
                        if !at_line_start {
                            try out.append_byte(cast<u8>(10));
                            last = cast<u8>(10);
                            at_line_start = true;
                        } else {
                            if last == cast<u8>(10) {
                                try out.append_byte(cast<u8>(10));
                                last = cast<u8>(10);
                            }
                        }
                    }
                    if at_line_start {
                        try append_indent(out, depth);
                        at_line_start = false;
                    }
                    if should_insert_space(previous, text, last) {
                        try out.append_byte(cast<u8>(32));
                        last = cast<u8>(32);
                    }
                    try out.append_bytes(text);
                    last = last_byte(text);
                    previous = text;
                    if std::mem::equal_bytes(text, "{") {
                        depth = depth + 1;
                        if !(try next_token_text_equals(body, &format_tokens, index, "}")) {
                            try out.append_byte(cast<u8>(10));
                            last = cast<u8>(10);
                            at_line_start = true;
                        }
                    }
                    if std::mem::equal_bytes(text, ";") {
                        try out.append_byte(cast<u8>(10));
                        last = cast<u8>(10);
                        at_line_start = true;
                    }
                }
            }
            index = index + 1;
        }
    }
    format_tokens.deinit();
    return out;
}

pub fn has_unsupported_line_comment(source: []u8) -> bool {
    let prefix_end = leading_comment_prefix_end(source);
    return has_line_comment_after(source, prefix_end);
}

fn token_text(
    source: []u8,
    token: std::kizu::lexer::Token
) -> []u8 {
    return source[token.start..token.end];
}

fn leading_comment_prefix_end(source: []u8) -> i64 {
    var index = 0;
    let length = std::mem::len(source);
    var seen_comment = false;
    while index < length {
        var cursor = index;
        while cursor < length and is_horizontal_space(source[cursor]) {
            cursor = cursor + 1;
        }
        if cursor >= length {
            if seen_comment {
                return length;
            }
            return 0;
        }
        if is_line_break(source[cursor]) {
            index = after_line_break(source, cursor);
            continue;
        }
        if cursor + 1 < length and source[cursor] == cast<u8>(47) and
            source[cursor + 1] == cast<u8>(47) {
            seen_comment = true;
            index = line_end_including_break(source, cursor + 2);
            continue;
        }
        if seen_comment {
            return index;
        }
        return 0;
    }
    if seen_comment {
        return index;
    }
    return 0;
}

fn has_line_comment_after(source: []u8, start: i64) -> bool {
    var index = start;
    let length = std::mem::len(source);
    var in_string = false;
    while index < length {
        let byte = source[index];
        if in_string {
            if byte == cast<u8>(92) and index + 1 < length {
                index = index + 2;
                continue;
            }
            if byte == cast<u8>(34) {
                in_string = false;
            }
            index = index + 1;
            continue;
        }
        if byte == cast<u8>(34) {
            in_string = true;
            index = index + 1;
            continue;
        }
        if byte == cast<u8>(47) and index + 1 < length and
            source[index + 1] == cast<u8>(47) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn line_end_including_break(source: []u8, start: i64) -> i64 {
    var index = start;
    let length = std::mem::len(source);
    while index < length and !is_line_break(source[index]) {
        index = index + 1;
    }
    if index < length {
        return after_line_break(source, index);
    }
    return index;
}

fn after_line_break(source: []u8, index: i64) -> i64 {
    let length = std::mem::len(source);
    if source[index] == cast<u8>(13) and index + 1 < length and
        source[index + 1] == cast<u8>(10) {
        return index + 2;
    }
    return index + 1;
}

fn is_horizontal_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9);
}

fn is_line_break(byte: u8) -> bool {
    return byte == cast<u8>(10) or byte == cast<u8>(13);
}

fn next_token_text_equals(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    expected: []u8
) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let next = try tokens.get(index + 1);
    if lexer::is_eof(next) {
        return false;
    }
    return std::mem::equal_bytes(token_text(source, next), expected);
}

fn append_indent(out: &var std::string::String, depth: i64) -> !void {
    var index = 0;
    while index < depth {
        try out.append_bytes("    ");
        index = index + 1;
    }
    return;
}

fn rbrace_wants_newline(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let next = try tokens.get(index + 1);
    if lexer::is_eof(next) {
        return false;
    }
    let text = token_text(source, next);
    return !(std::mem::equal_bytes(text, ",") or
        std::mem::equal_bytes(text, ";") or
        std::mem::equal_bytes(text, ".") or
        std::mem::equal_bytes(text, "::") or
        std::mem::equal_bytes(text, ")") or
        std::mem::equal_bytes(text, "]") or
        std::mem::equal_bytes(text, "}") or
        std::mem::equal_bytes(text, "?") or
        std::mem::equal_bytes(text, "!") or
        std::mem::equal_bytes(text, "else"));
}

fn is_trailing_comma(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    text: []u8
) -> !bool {
    if !std::mem::equal_bytes(text, ",") {
        return false;
    }
    let before_paren = try next_token_text_equals(source, tokens, index, ")");
    if before_paren {
        return true;
    }
    let before_bracket = try next_token_text_equals(source, tokens, index, "]");
    if before_bracket {
        return true;
    }
    if !(try next_token_text_equals(source, tokens, index, "}")) {
        return false;
    }
    return !(try is_match_arm_trailing_comma(source, tokens, index));
}

fn is_match_arm_trailing_comma(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    var cursor = index;
    var brace_depth = 0;
    while cursor > 0 {
        cursor = cursor - 1;
        let token = try tokens.get(cursor);
        let text = token_text(source, token);
        if std::mem::equal_bytes(text, "}") {
            brace_depth = brace_depth + 1;
        }
        if std::mem::equal_bytes(text, "{") {
            if brace_depth == 0 {
                return false;
            }
            brace_depth = brace_depth - 1;
        }
        if brace_depth == 0 and std::mem::equal_bytes(text, "=>") {
            return true;
        }
    }
    return false;
}

fn should_insert_space(
    previous: []u8,
    current: []u8,
    last: u8
) -> bool {
    if last == cast<u8>(0) or last == cast<u8>(10) or last == cast<u8>(32) {
        return false;
    }
    if no_space_before(current) {
        return false;
    }
    if std::mem::equal_bytes(previous, "]") and can_follow_slice_marker(current) {
        return false;
    }
    if no_space_after(previous) {
        return false;
    }
    return true;
}

fn no_space_before(text: []u8) -> bool {
    return std::mem::equal_bytes(text, ")") or
        std::mem::equal_bytes(text, "]") or
        std::mem::equal_bytes(text, ";") or
        std::mem::equal_bytes(text, ",") or
        std::mem::equal_bytes(text, ".") or
        std::mem::equal_bytes(text, "::") or
        std::mem::equal_bytes(text, ">") or
        std::mem::equal_bytes(text, ":") or
        std::mem::equal_bytes(text, "(");
}

fn no_space_after(text: []u8) -> bool {
    return std::mem::equal_bytes(text, "(") or
        std::mem::equal_bytes(text, "[") or
        std::mem::equal_bytes(text, ".") or
        std::mem::equal_bytes(text, "::") or
        std::mem::equal_bytes(text, "!") or
        std::mem::equal_bytes(text, "&") or
        std::mem::equal_bytes(text, "<");
}

fn can_follow_slice_marker(text: []u8) -> bool {
    if std::mem::len(text) == 0 {
        return false;
    }
    let first = text[0];
    return (first >= cast<u8>(65) and first <= cast<u8>(90)) or
        (first >= cast<u8>(97) and first <= cast<u8>(122)) or
        first == cast<u8>(95) or
        std::mem::equal_bytes(text, "&") or
        std::mem::equal_bytes(text, "!") or
        std::mem::equal_bytes(text, "?") or
        std::mem::equal_bytes(text, "[");
}

fn is_top_level_decl_start(text: []u8) -> bool {
    return std::mem::equal_bytes(text, "import") or
        std::mem::equal_bytes(text, "pub") or
        std::mem::equal_bytes(text, "unsafe") or
        std::mem::equal_bytes(text, "extern") or
        std::mem::equal_bytes(text, "fn") or
        std::mem::equal_bytes(text, "struct") or
        std::mem::equal_bytes(text, "enum") or
        std::mem::equal_bytes(text, "union");
}

fn starts_new_top_level_decl(previous: []u8, current: []u8) -> bool {
    if !is_top_level_decl_start(current) {
        return false;
    }
    return !(std::mem::equal_bytes(previous, "pub") or
        std::mem::equal_bytes(previous, "unsafe") or
        std::mem::equal_bytes(previous, "extern"));
}

fn last_byte(text: []u8) -> u8 {
    return text[std::mem::len(text) - 1];
}
