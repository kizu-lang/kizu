import selfhost::lexer;
import selfhost::parser::validation_tokens;

pub struct ParseValidation {
    pub ok: bool,
    pub message: []u8,
    pub line: i64,
    pub column: i64,
    pub got: []u8,
}

pub fn validate_source(
    allocator: Allocator,
    source: []u8
) -> !ParseValidation {
    var tokens = try lexer::tokenize(allocator, source);
    defer tokens.deinit();
    return try validate_tokens(allocator, source, &tokens);
}

pub fn validate_tokens(
    allocator: Allocator,
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var delimiters = std::array::Array<i64>(allocator);
    defer delimiters.deinit();
    var delimiter_len = 0;
    var index = 0;
    while index + 1 < tokens.len() {
        let token = try tokens.get(index);
        let text = validation_tokens::token_text(source, token);
        if try validation_tokens::is_binding_statement(source, tokens, index, text) {
            let name = try tokens.get(index + 1);
            if !validation_tokens::is_ident_token(name) {
                return invalid_parse_validation(
                    "expected identifier",
                    name.line,
                    name.column,
                    validation_tokens::token_text(source, name)
                );
            }
            var assign_index = index + 2;
            if assign_index >= tokens.len() {
                assign_index = tokens.len() - 1;
            }
            let assign = try tokens.get(assign_index);
            if !std::mem::equal_bytes(validation_tokens::token_text(source, assign), "=") {
                return invalid_parse_validation(
                    "expected assign",
                    assign.line,
                    assign.column,
                    validation_tokens::token_text(source, assign)
                );
            }
        }
        if validation_tokens::is_open_delimiter(text) {
            let delimiter = validation_tokens::closing_delimiter_code(text);
            if delimiter_len < delimiters.len() {
                try delimiters.set(delimiter_len, delimiter);
            } else {
                try delimiters.append(delimiter);
            }
            delimiter_len = delimiter_len + 1;
        }
        if validation_tokens::is_close_delimiter(text) {
            if delimiter_len < 1 {
                return invalid_parse_validation("unexpected token", token.line, token.column, text);
            }
            let delimiter = try delimiters.get(delimiter_len - 1);
            if !validation_tokens::delimiter_matches(delimiter, text) {
                return invalid_parse_validation(
                    validation_tokens::expected_delimiter_message(delimiter),
                    token.line,
                    token.column,
                    text
                );
            }
            delimiter_len = delimiter_len - 1;
        }
        if std::mem::equal_bytes(text, "=") {
            let next = try tokens.get(index + 1);
            let next_text = validation_tokens::token_text(source, next);
            if validation_tokens::expression_missing_before(next_text) {
                return invalid_parse_validation(
                    "expected expression",
                    next.line,
                    next.column,
                    validation_tokens::missing_expression_got_text(next_text)
                );
            }
        }
        index = index + 1;
    }
    if delimiter_len > 0 {
        let delimiter = try delimiters.get(delimiter_len - 1);
        let eof = try tokens.get(tokens.len() - 1);
        return invalid_parse_validation(
            validation_tokens::expected_delimiter_message(delimiter),
            eof.line,
            eof.column,
            ""
        );
    }
    let top_level = try validate_top_level_declarations(source, tokens);
    if !top_level.ok {
        return top_level;
    }
    let invalid_token = try validate_no_invalid_tokens(source, tokens);
    if !invalid_token.ok {
        return invalid_token;
    }
    let match_arms = try validate_match_arm_separators(source, tokens);
    if !match_arms.ok {
        return match_arms;
    }
    let statement_separators = try validate_statement_separators(source, tokens);
    if !statement_separators.ok {
        return statement_separators;
    }
    return valid_parse_validation();
}

pub fn validate_tokens_ok(
    allocator: Allocator,
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !bool {
    let result = try validate_tokens(allocator, source, tokens);
    return result.ok;
}

fn invalid_parse_validation(
    message: []u8,
    line: i64,
    column: i64,
    got: []u8
) -> ParseValidation {
    return ParseValidation {
        ok: false,
        message: message,
        line: line,
        column: column,
        got: got
    };
}

fn valid_parse_validation() -> ParseValidation {
    return ParseValidation {
        ok: true,
        message: "",
        line: 0,
        column: 0,
        got: ""
    };
}

fn validate_top_level_declarations(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var index = 0;
    while index + 1 < tokens.len() {
        let token = try tokens.get(index);
        let start = try validate_top_level_decl_start(source, tokens, index, token);
        if !start.ok {
            return start;
        }
        index = try validation_tokens::skip_top_level_declaration(tokens, index);
    }
    return valid_parse_validation();
}

fn validate_no_invalid_tokens(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var index = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        if lexer::is_invalid_token(source, token) {
            return invalid_parse_validation(
                "expected expression",
                token.line,
                token.column,
                validation_tokens::token_text(source, token)
            );
        }
        index = index + 1;
    }
    return valid_parse_validation();
}

fn validate_top_level_decl_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    token: std::kizu::lexer::Token
) -> !ParseValidation {
    return match token.kind {
        Import => try validate_import_decl_header(source, tokens, index),
        Pub => try validate_public_top_level_decl_start(source, tokens, index),
        Fn => try validate_fn_decl_header(source, tokens, index, true),
        Unsafe => invalid_parse_validation(
            "unsafe fn is not supported; use @requires_unsafe() fn",
            token.line,
            token.column,
            validation_tokens::token_text(source, token)
        ),
        At => try validate_directive_top_level_decl_start(source, tokens, index),
        Extern => try validate_extern_decl_header(source, tokens, index),
        Struct => try validate_aggregate_decl_header(source, tokens, index, true, true),
        Enum => try validate_aggregate_decl_header(source, tokens, index, false, false),
        Union => try validate_aggregate_decl_header(source, tokens, index, true, false),
        Ident => try validate_ident_top_level_decl_start(source, tokens, index, token),
        Eof => valid_parse_validation(),
        _ => invalid_parse_validation(
            "expected declaration",
            token.line,
            token.column,
            validation_tokens::token_text(source, token)
        ),
    };
}

fn validate_public_top_level_decl_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let next = try tokens.get(index + 1);
    if lexer::is_eof(next) {
        return invalid_parse_validation("expected declaration", next.line, next.column, "");
    }
    if validation_tokens::is_at_token(next) {
        return try validate_directive_top_level_decl_start(source, tokens, index + 1);
    }
    if validation_tokens::is_fn_token(next) {
        return try validate_fn_decl_header(source, tokens, index + 1, true);
    }
    if validation_tokens::is_extern_token(next) {
        return try validate_extern_decl_header(source, tokens, index + 1);
    }
    if validation_tokens::is_struct_token(next) {
        return try validate_aggregate_decl_header(source, tokens, index + 1, true, true);
    }
    if validation_tokens::is_union_token(next) {
        return try validate_aggregate_decl_header(source, tokens, index + 1, true, false);
    }
    if validation_tokens::is_enum_token(next) {
        return try validate_aggregate_decl_header(source, tokens, index + 1, false, false);
    }
    if is_public_top_level_decl_start(source, next) {
        return valid_parse_validation();
    }
    return invalid_parse_validation(
        "expected declaration",
        next.line,
        next.column,
        validation_tokens::token_text(source, next)
    );
}

fn validate_directive_top_level_decl_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let directive = try tokens.get(index + 1);
    if lexer::is_eof(directive) {
        return invalid_parse_validation("expected directive name", directive.line, directive.column, "");
    }
    if !std::mem::equal_bytes(validation_tokens::token_text(source, directive), "requires_unsafe") {
        return invalid_parse_validation(
            "unknown declaration directive",
            directive.line,
            directive.column,
            validation_tokens::token_text(source, directive)
        );
    }
    let open = try tokens.get(index + 2);
    if !validation_tokens::is_left_paren_token(open) {
        return invalid_parse_validation(
            "expected left paren",
            open.line,
            open.column,
            validation_tokens::token_text(source, open)
        );
    }
    let close = try tokens.get(index + 3);
    if !validation_tokens::is_right_paren_token(close) {
        return invalid_parse_validation(
            "expected right paren",
            close.line,
            close.column,
            validation_tokens::token_text(source, close)
        );
    }
    let fn_token = try tokens.get(index + 4);
    if validation_tokens::is_fn_token(fn_token) {
        return try validate_fn_decl_header(source, tokens, index + 4, true);
    }
    return invalid_parse_validation(
        "expected fn after @requires_unsafe()",
        fn_token.line,
        fn_token.column,
        validation_tokens::token_text(source, fn_token)
    );
}

fn validate_import_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let name = try tokens.get(index + 1);
    if !validation_tokens::is_ident_token(name) {
        return invalid_parse_validation(
            "expected identifier",
            name.line,
            name.column,
            validation_tokens::token_text(source, name)
        );
    }
    return valid_parse_validation();
}

fn validate_test_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let name = try tokens.get(index + 1);
    if !validation_tokens::is_string_token(name) {
        return invalid_parse_validation(
            "expected string",
            name.line,
            name.column,
            validation_tokens::token_text(source, name)
        );
    }
    let open = try tokens.get(index + 2);
    if !validation_tokens::is_left_brace_token(open) {
        return invalid_parse_validation(
            "expected left brace",
            open.line,
            open.column,
            validation_tokens::token_text(source, open)
        );
    }
    return valid_parse_validation();
}

fn validate_extern_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let abi = try tokens.get(index + 1);
    if !validation_tokens::is_string_token(abi) {
        return invalid_parse_validation(
            "expected string",
            abi.line,
            abi.column,
            validation_tokens::token_text(source, abi)
        );
    }
    let fn_token = try tokens.get(index + 2);
    if !validation_tokens::is_fn_token(fn_token) {
        return invalid_parse_validation(
            "expected fn",
            fn_token.line,
            fn_token.column,
            validation_tokens::token_text(source, fn_token)
        );
    }
    return try validate_fn_decl_header(source, tokens, index + 2, false);
}

fn validate_aggregate_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    allow_type_params: bool,
    require_field_type: bool
) -> !ParseValidation {
    let name = try tokens.get(index + 1);
    if !validation_tokens::is_ident_token(name) {
        return invalid_parse_validation(
            "expected identifier",
            name.line,
            name.column,
            validation_tokens::token_text(source, name)
        );
    }
    var open_index = index + 2;
    if allow_type_params {
        let type_param_validation = try validate_optional_type_params(source, tokens, open_index);
        if !type_param_validation.ok {
            return type_param_validation;
        }
        open_index = try skip_optional_type_params(tokens, open_index);
    }
    let open = try tokens.get(open_index);
    if !validation_tokens::is_left_brace_token(open) {
        return invalid_parse_validation(
            "expected left brace",
            open.line,
            open.column,
            validation_tokens::token_text(source, open)
        );
    }
    let body_validation = try validate_aggregate_body_start(
        source,
        tokens,
        open_index,
        require_field_type
    );
    if !body_validation.ok {
        return body_validation;
    }
    if require_field_type {
        return try validate_aggregate_field_separators(source, tokens, open_index);
    }
    return try validate_aggregate_item_separators(source, tokens, open_index);
}

fn validate_aggregate_body_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64,
    require_field_type: bool
) -> !ParseValidation {
    let first = try tokens.get(open_index + 1);
    if validation_tokens::is_right_brace_token(first) {
        return valid_parse_validation();
    }
    var after_name_index = open_index + 2;
    if validation_tokens::is_pub_token(first) {
        let name = try tokens.get(open_index + 2);
        if validation_tokens::is_ident_token(name) {
            after_name_index = open_index + 3;
            return try validate_optional_field_type(
                source,
                tokens,
                after_name_index,
                require_field_type
            );
        }
        return invalid_parse_validation(
            "expected identifier",
            name.line,
            name.column,
            validation_tokens::token_text(source, name)
        );
    }
    if validation_tokens::is_ident_token(first) {
        return try validate_optional_field_type(
            source,
            tokens,
            after_name_index,
            require_field_type
        );
    }
    return invalid_parse_validation(
        "expected identifier",
        first.line,
        first.column,
        validation_tokens::token_text(source, first)
    );
}

fn validate_optional_field_type(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    colon_index: i64,
    require_field_type: bool
) -> !ParseValidation {
    if !require_field_type {
        return valid_parse_validation();
    }
    let colon = try tokens.get(colon_index);
    if !validation_tokens::is_colon_token(colon) {
        return invalid_parse_validation(
            "expected colon",
            colon.line,
            colon.column,
            validation_tokens::token_text(source, colon)
        );
    }
    let type_start = try tokens.get(colon_index + 1);
    if validation_tokens::is_type_start_token(type_start) {
        return valid_parse_validation();
    }
    return invalid_parse_validation(
        "expected type name",
        type_start.line,
        type_start.column,
        validation_tokens::token_text(source, type_start)
    );
}

fn validate_aggregate_field_separators(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !ParseValidation {
    var cursor = open_index + 1;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if validation_tokens::is_right_brace_token(token) {
            return valid_parse_validation();
        }
        var name_index = cursor;
        if validation_tokens::is_pub_token(token) {
            name_index = cursor + 1;
        }
        let name = try tokens.get(name_index);
        if !validation_tokens::is_ident_token(name) {
            return invalid_parse_validation(
                "expected identifier",
                name.line,
                name.column,
                validation_tokens::token_text(source, name)
            );
        }
        let colon_index = name_index + 1;
        let colon = try tokens.get(colon_index);
        if !validation_tokens::is_colon_token(colon) {
            return invalid_parse_validation(
                "expected colon",
                colon.line,
                colon.column,
                validation_tokens::token_text(source, colon)
            );
        }
        let type_start_index = colon_index + 1;
        let type_start = try tokens.get(type_start_index);
        if !validation_tokens::is_type_start_token(type_start) {
            return invalid_parse_validation(
                "expected type name",
                type_start.line,
                type_start.column,
                validation_tokens::token_text(source, type_start)
            );
        }
        let separator_validation = try validate_aggregate_field_type_separator(
            source,
            tokens,
            type_start_index
        );
        if !separator_validation.ok {
            return separator_validation;
        }
        cursor = try skip_aggregate_field_type(tokens, type_start_index + 1);
        if cursor >= tokens.len() {
            let eof = try tokens.get(tokens.len() - 1);
            return invalid_parse_validation("expected right brace", eof.line, eof.column, "");
        }
        let separator = try tokens.get(cursor);
        if validation_tokens::is_comma_token(separator) {
            cursor = cursor + 1;
        }
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected right brace", eof.line, eof.column, "");
}

fn validate_aggregate_field_type_separator(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    type_start_index: i64
) -> !ParseValidation {
    return try validate_type_list_separator(
        source,
        tokens,
        type_start_index,
        2,
        "expected comma or right brace"
    );
}

fn skip_aggregate_field_type(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    return try skip_type_list_separator_index(tokens, index, 2);
}

fn validate_aggregate_item_separators(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !ParseValidation {
    var cursor = open_index + 1;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if validation_tokens::is_right_brace_token(token) {
            return valid_parse_validation();
        }
        var name_index = cursor;
        if validation_tokens::is_pub_token(token) {
            name_index = cursor + 1;
        }
        let name = try tokens.get(name_index);
        if !validation_tokens::is_ident_token(name) {
            return invalid_parse_validation(
                "expected identifier",
                name.line,
                name.column,
                validation_tokens::token_text(source, name)
            );
        }
        cursor = name_index + 1;
        if cursor >= tokens.len() {
            let eof = try tokens.get(tokens.len() - 1);
            return invalid_parse_validation("expected right brace", eof.line, eof.column, "");
        }
        let payload_start = try tokens.get(cursor);
        if validation_tokens::is_left_paren_token(payload_start) {
            cursor = try validation_tokens::skip_balanced_parens(tokens, cursor);
        }
        if cursor >= tokens.len() {
            let eof = try tokens.get(tokens.len() - 1);
            return invalid_parse_validation("expected right brace", eof.line, eof.column, "");
        }
        let separator = try tokens.get(cursor);
        if validation_tokens::is_comma_token(separator) {
            cursor = cursor + 1;
        } else {
            if validation_tokens::is_right_brace_token(separator) {
                return valid_parse_validation();
            }
            return invalid_parse_validation(
                "expected comma or right brace",
                separator.line,
                separator.column,
                validation_tokens::token_text(source, separator)
            );
        }
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected right brace", eof.line, eof.column, "");
}

fn validate_fn_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    require_body: bool
) -> !ParseValidation {
    let name = try tokens.get(index + 1);
    if !validation_tokens::is_ident_token(name) {
        return invalid_parse_validation(
            "expected function name",
            name.line,
            name.column,
            validation_tokens::token_text(source, name)
        );
    }
    let type_param_validation = try validate_optional_type_params(source, tokens, index + 2);
    if !type_param_validation.ok {
        return type_param_validation;
    }
    let params_index = try skip_optional_type_params(tokens, index + 2);
    let params = try tokens.get(params_index);
    if !validation_tokens::is_left_paren_token(params) {
        return invalid_parse_validation(
            "expected left paren",
            params.line,
            params.column,
            validation_tokens::token_text(source, params)
        );
    }
    let param_validation = try validate_fn_params(source, tokens, params_index);
    if !param_validation.ok {
        return param_validation;
    }
    let after_params = try validation_tokens::skip_balanced_parens(tokens, params_index);
    let return_validation = try validate_optional_fn_return_type(source, tokens, after_params);
    if !return_validation.ok {
        return return_validation;
    }
    if !require_body {
        return valid_parse_validation();
    }
    return try validate_required_fn_body(source, tokens, after_params);
}

fn validate_required_fn_body(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    var cursor = index;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if validation_tokens::is_left_brace_token(token) {
            return valid_parse_validation();
        }
        if validation_tokens::is_semicolon_token(token) or lexer::is_eof(token) {
            return invalid_parse_validation(
                "expected left brace",
                token.line,
                token.column,
                validation_tokens::token_text(source, token)
            );
        }
        cursor = cursor + 1;
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected left brace", eof.line, eof.column, "");
}

fn validate_fn_params(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !ParseValidation {
    var cursor = open_index + 1;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if validation_tokens::is_right_paren_token(token) {
            return valid_parse_validation();
        }
        if !validation_tokens::is_ident_token(token) {
            return invalid_parse_validation(
                "expected identifier",
                token.line,
                token.column,
                validation_tokens::token_text(source, token)
            );
        }
        let colon = try tokens.get(cursor + 1);
        if !validation_tokens::is_colon_token(colon) {
            return invalid_parse_validation(
                "expected colon",
                colon.line,
                colon.column,
                validation_tokens::token_text(source, colon)
            );
        }
        let type_start = try tokens.get(cursor + 2);
        if !validation_tokens::is_type_start_token(type_start) {
            return invalid_parse_validation(
                "expected type name",
                type_start.line,
                type_start.column,
                validation_tokens::token_text(source, type_start)
            );
        }
        let separator_validation = try validate_fn_param_type_separator(
            source,
            tokens,
            cursor + 2
        );
        if !separator_validation.ok {
            return separator_validation;
        }
        cursor = try skip_fn_param_type(tokens, cursor + 3);
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected right paren", eof.line, eof.column, "");
}

fn validate_fn_param_type_separator(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    type_start_index: i64
) -> !ParseValidation {
    return try validate_type_list_separator(
        source,
        tokens,
        type_start_index,
        1,
        "expected comma or right paren"
    );
}

fn validate_type_list_separator(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    type_start_index: i64,
    close_delimiter: i64,
    message: []u8
) -> !ParseValidation {
    var cursor = type_start_index;
    var angle_depth = 0;
    var bracket_depth = 0;
    var previous = try tokens.get(type_start_index);
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if cursor > type_start_index and angle_depth == 0 and bracket_depth == 0 {
            if validation_tokens::is_comma_token(token) or validation_tokens::is_type_list_close_token(close_delimiter, token) {
                return valid_parse_validation();
            }
            if needs_type_separator(previous, token) {
                return invalid_parse_validation(
                    message,
                    token.line,
                    token.column,
                    validation_tokens::token_text(source, token)
                );
            }
        }
        if validation_tokens::is_lt_token(token) {
            angle_depth = angle_depth + 1;
        }
        if validation_tokens::is_gt_token(token) and angle_depth > 0 {
            angle_depth = angle_depth - 1;
        }
        if validation_tokens::is_left_bracket_token(token) {
            bracket_depth = bracket_depth + 1;
        }
        if validation_tokens::is_right_bracket_token(token) and bracket_depth > 0 {
            bracket_depth = bracket_depth - 1;
        }
        previous = token;
        cursor = cursor + 1;
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation(message, eof.line, eof.column, "");
}

fn needs_type_separator(
    previous: std::kizu::lexer::Token,
    token: std::kizu::lexer::Token
) -> bool {
    if !validation_tokens::is_ident_token(token) {
        return false;
    }
    return validation_tokens::is_ident_token(previous) or validation_tokens::is_gt_token(previous);
}

fn skip_fn_param_type(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    let separator = try skip_type_list_separator_index(tokens, index, 1);
    if separator < tokens.len() {
        let token = try tokens.get(separator);
        if validation_tokens::is_comma_token(token) {
            return separator + 1;
        }
    }
    return separator;
}

fn skip_type_list_separator_index(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    close_delimiter: i64
) -> !i64 {
    var cursor = index;
    var angle_depth = 0;
    var bracket_depth = 0;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if angle_depth == 0 and bracket_depth == 0 and validation_tokens::is_comma_token(token) {
            return cursor;
        }
        if angle_depth == 0 and bracket_depth == 0 and
            validation_tokens::is_type_list_close_token(close_delimiter, token) {
            return cursor;
        }
        if validation_tokens::is_lt_token(token) {
            angle_depth = angle_depth + 1;
        }
        if validation_tokens::is_gt_token(token) and angle_depth > 0 {
            angle_depth = angle_depth - 1;
        }
        if validation_tokens::is_left_bracket_token(token) {
            bracket_depth = bracket_depth + 1;
        }
        if validation_tokens::is_right_bracket_token(token) and bracket_depth > 0 {
            bracket_depth = bracket_depth - 1;
        }
        cursor = cursor + 1;
    }
    return cursor;
}

fn validate_optional_type_params(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let token = try tokens.get(index);
    if !validation_tokens::is_lt_token(token) {
        return valid_parse_validation();
    }
    var cursor = index + 1;
    while cursor < tokens.len() {
        let current = try tokens.get(cursor);
        if !validation_tokens::is_ident_token(current) {
            return invalid_parse_validation(
                "expected type parameter",
                current.line,
                current.column,
                validation_tokens::token_text(source, current)
            );
        }
        let next = try tokens.get(cursor + 1);
        if validation_tokens::is_gt_token(next) {
            return valid_parse_validation();
        }
        if !validation_tokens::is_comma_token(next) {
            return invalid_parse_validation(
                "expected comma",
                next.line,
                next.column,
                validation_tokens::token_text(source, next)
            );
        }
        cursor = cursor + 2;
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected type parameter", eof.line, eof.column, "");
}

fn validate_optional_fn_return_type(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let token = try tokens.get(index);
    if !validation_tokens::is_arrow_token(token) {
        return valid_parse_validation();
    }
    let type_start = try tokens.get(index + 1);
    if validation_tokens::is_type_start_token(type_start) {
        return valid_parse_validation();
    }
    return invalid_parse_validation(
        "expected type name",
        type_start.line,
        type_start.column,
        validation_tokens::token_text(source, type_start)
    );
}

fn skip_optional_type_params(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    let token = try tokens.get(index);
    if !validation_tokens::is_lt_token(token) {
        return index;
    }
    return try validation_tokens::skip_balanced_angles(tokens, index);
}

fn validate_match_arm_separators(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var index = 0;
    while index + 1 < tokens.len() {
        let token = try tokens.get(index);
        if validation_tokens::is_match_token(token) {
            let body = try find_match_body_open_index(tokens, index);
            if body < tokens.len() {
                let validation = try validate_match_body_arm_separators(source, tokens, body);
                if !validation.ok {
                    return validation;
                }
            }
        }
        index = index + 1;
    }
    return valid_parse_validation();
}

fn find_match_body_open_index(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    var cursor = index + 1;
    var paren_depth = 0;
    var bracket_depth = 0;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if paren_depth == 0 and bracket_depth == 0 and validation_tokens::is_left_brace_token(token) {
            return cursor;
        }
        if lexer::is_eof(token) or validation_tokens::is_semicolon_token(token) {
            return tokens.len();
        }
        if validation_tokens::is_left_paren_token(token) {
            paren_depth = paren_depth + 1;
        }
        if validation_tokens::is_right_paren_token(token) and paren_depth > 0 {
            paren_depth = paren_depth - 1;
        }
        if validation_tokens::is_left_bracket_token(token) {
            bracket_depth = bracket_depth + 1;
        }
        if validation_tokens::is_right_bracket_token(token) and bracket_depth > 0 {
            bracket_depth = bracket_depth - 1;
        }
        cursor = cursor + 1;
    }
    return tokens.len();
}

fn validate_match_body_arm_separators(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !ParseValidation {
    var cursor = open_index + 1;
    var brace_depth = 1;
    while cursor < tokens.len() and brace_depth > 0 {
        let token = try tokens.get(cursor);
        if brace_depth == 1 and validation_tokens::is_fat_arrow_token(token) {
            let validation = try validate_match_arm_body_separator(source, tokens, cursor + 1);
            if !validation.ok {
                return validation;
            }
        }
        if validation_tokens::is_left_brace_token(token) {
            brace_depth = brace_depth + 1;
        }
        if validation_tokens::is_right_brace_token(token) {
            brace_depth = brace_depth - 1;
        }
        cursor = cursor + 1;
    }
    return valid_parse_validation();
}

fn validate_match_arm_body_separator(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    start_index: i64
) -> !ParseValidation {
    var cursor = start_index;
    var paren_depth = 0;
    var bracket_depth = 0;
    var brace_depth = 0;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if paren_depth == 0 and bracket_depth == 0 and brace_depth == 0 {
            if validation_tokens::is_comma_token(token) {
                return valid_parse_validation();
            }
            if validation_tokens::is_right_brace_token(token) {
                return invalid_parse_validation(
                    "expected comma",
                    token.line,
                    token.column,
                    validation_tokens::token_text(source, token)
                );
            }
            if try is_match_arm_start_at(tokens, cursor) {
                return invalid_parse_validation(
                    "expected comma",
                    token.line,
                    token.column,
                    validation_tokens::token_text(source, token)
                );
            }
        }
        if validation_tokens::is_left_paren_token(token) {
            paren_depth = paren_depth + 1;
        }
        if validation_tokens::is_right_paren_token(token) and paren_depth > 0 {
            paren_depth = paren_depth - 1;
        }
        if validation_tokens::is_left_bracket_token(token) {
            bracket_depth = bracket_depth + 1;
        }
        if validation_tokens::is_right_bracket_token(token) and bracket_depth > 0 {
            bracket_depth = bracket_depth - 1;
        }
        if validation_tokens::is_left_brace_token(token) {
            brace_depth = brace_depth + 1;
        }
        if validation_tokens::is_right_brace_token(token) and brace_depth > 0 {
            brace_depth = brace_depth - 1;
        }
        cursor = cursor + 1;
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected comma", eof.line, eof.column, "");
}

fn is_match_arm_start_at(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !bool {
    let token = try tokens.get(index);
    if !validation_tokens::is_ident_token(token) {
        return false;
    }
    var next_index = index + 1;
    let next = try tokens.get(next_index);
    if validation_tokens::is_left_paren_token(next) {
        next_index = try validation_tokens::skip_balanced_parens(tokens, next_index);
    }
    if next_index >= tokens.len() {
        return false;
    }
    let marker = try tokens.get(next_index);
    return validation_tokens::is_fat_arrow_token(marker);
}

fn validate_statement_separators(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var index = 0;
    while index + 1 < tokens.len() {
        let token = try tokens.get(index);
        if validation_tokens::is_fn_token(token) {
            let body = try find_fn_body_open_index(tokens, index);
            if body < tokens.len() {
                let validation = try validate_block_statement_separators(source, tokens, body);
                if !validation.ok {
                    return validation;
                }
            }
            index = try validation_tokens::skip_top_level_declaration(tokens, index);
        } else {
            index = index + 1;
        }
    }
    return valid_parse_validation();
}

fn find_fn_body_open_index(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    let type_params = try skip_optional_type_params(tokens, index + 2);
    let params = try tokens.get(type_params);
    if !validation_tokens::is_left_paren_token(params) {
        return tokens.len();
    }
    let after_params = try validation_tokens::skip_balanced_parens(tokens, type_params);
    var cursor = after_params;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if validation_tokens::is_left_brace_token(token) {
            return cursor;
        }
        if validation_tokens::is_semicolon_token(token) or lexer::is_eof(token) {
            return tokens.len();
        }
        cursor = cursor + 1;
    }
    return tokens.len();
}

fn validate_block_statement_separators(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !ParseValidation {
    var cursor = open_index + 1;
    var depth = 1;
    while cursor < tokens.len() and depth > 0 {
        let previous = try tokens.get(cursor - 1);
        let token = try tokens.get(cursor);
        if needs_statement_separator(previous, token) {
            return invalid_parse_validation(
                "expected semicolon",
                token.line,
                token.column,
                validation_tokens::token_text(source, token)
            );
        }
        if validation_tokens::is_left_brace_token(token) {
            depth = depth + 1;
        }
        if validation_tokens::is_right_brace_token(token) {
            depth = depth - 1;
        }
        cursor = cursor + 1;
    }
    return valid_parse_validation();
}

fn needs_statement_separator(
    previous: std::kizu::lexer::Token,
    token: std::kizu::lexer::Token
) -> bool {
    if previous.line != token.line {
        return false;
    }
    return can_end_expression_token(previous) and can_start_expression_token(token);
}

fn can_end_expression_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        Number => true,
        String => true,
        True => true,
        False => true,
        _ => false,
    };
}

fn can_start_expression_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        Number => true,
        String => true,
        True => true,
        False => true,
        Try => true,
        Match => true,
        If => true,
        _ => false,
    };
}

fn validate_ident_top_level_decl_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    token: std::kizu::lexer::Token
) -> !ParseValidation {
    if validation_tokens::is_test_decl_ident(source, token) {
        return try validate_test_decl_header(source, tokens, index);
    }
    if validation_tokens::is_skipped_top_level_decl_ident(source, token) {
        return valid_parse_validation();
    }
    return invalid_parse_validation(
        "expected declaration",
        token.line,
        token.column,
        validation_tokens::token_text(source, token)
    );
}

fn is_public_top_level_decl_start(
    source: []u8,
    token: std::kizu::lexer::Token
) -> bool {
    return match token.kind {
        Fn => true,
        At => true,
        Extern => true,
        Struct => true,
        Enum => true,
        Union => true,
        Ident => validation_tokens::is_skipped_top_level_decl_ident(source, token),
        _ => false,
    };
}
