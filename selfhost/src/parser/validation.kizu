import selfhost::lexer;

pub struct ParseValidation {
    pub ok: bool,
    pub message: []u8,
    pub line: i64,
    pub column: i64,
    pub got: []u8,
}

pub fn validate_source(
    allocator: Allocator,
    source: []u8
) -> !ParseValidation {
    var validation_tokens = try lexer::tokenize(allocator, source);
    defer validation_tokens.deinit();
    return try validate_tokens(allocator, source, &validation_tokens);
}

pub fn validate_tokens(
    allocator: Allocator,
    source: []u8,
    validation_tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var delimiters = std::array::Array<i64>(allocator);
    defer delimiters.deinit();
    var delimiter_len = 0;
    var index = 0;
    while index + 1 < validation_tokens.len() {
        let token = try validation_tokens.get(index);
        let text = token_text(source, token);
        if try is_binding_statement(source, validation_tokens, index, text) {
            let name = try validation_tokens.get(index + 1);
            if !is_ident_token(name) {
                return invalid_parse_validation(
                    "expected identifier",
                    name.line,
                    name.column,
                    token_text(source, name)
                );
            }
            var assign_index = index + 2;
            if assign_index >= validation_tokens.len() {
                assign_index = validation_tokens.len() - 1;
            }
            let assign = try validation_tokens.get(assign_index);
            if !std::mem::equal_bytes(token_text(source, assign), "=") {
                return invalid_parse_validation(
                    "expected assign",
                    assign.line,
                    assign.column,
                    token_text(source, assign)
                );
            }
        }
        if is_open_delimiter(text) {
            let delimiter = closing_delimiter_code(text);
            if delimiter_len < delimiters.len() {
                try delimiters.set(delimiter_len, delimiter);
            } else {
                try delimiters.append(delimiter);
            }
            delimiter_len = delimiter_len + 1;
        }
        if is_close_delimiter(text) {
            if delimiter_len < 1 {
                return invalid_parse_validation("unexpected token", token.line, token.column, text);
            }
            let delimiter = try delimiters.get(delimiter_len - 1);
            if !delimiter_matches(delimiter, text) {
                return invalid_parse_validation(
                    expected_delimiter_message(delimiter),
                    token.line,
                    token.column,
                    text
                );
            }
            delimiter_len = delimiter_len - 1;
        }
        if std::mem::equal_bytes(text, "=") {
            let next = try validation_tokens.get(index + 1);
            let next_text = token_text(source, next);
            if expression_missing_before(next_text) {
                return invalid_parse_validation(
                    "expected expression",
                    next.line,
                    next.column,
                    missing_expression_got_text(next_text)
                );
            }
        }
        index = index + 1;
    }
    if delimiter_len > 0 {
        let delimiter = try delimiters.get(delimiter_len - 1);
        let eof = try validation_tokens.get(validation_tokens.len() - 1);
        return invalid_parse_validation(
            expected_delimiter_message(delimiter),
            eof.line,
            eof.column,
            ""
        );
    }
    let top_level = try validate_top_level_declarations(source, validation_tokens);
    if !top_level.ok {
        return top_level;
    }
    let invalid_token = try validate_no_invalid_tokens(source, validation_tokens);
    if !invalid_token.ok {
        return invalid_token;
    }
    let statement_separators = try validate_statement_separators(source, validation_tokens);
    if !statement_separators.ok {
        return statement_separators;
    }
    return valid_parse_validation();
}

pub fn validate_tokens_ok(
    allocator: Allocator,
    source: []u8,
    validation_tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !bool {
    let result = try validate_tokens(allocator, source, validation_tokens);
    return result.ok;
}

fn token_text(
    source: []u8,
    token: std::kizu::lexer::Token
) -> []u8 {
    if lexer::is_invalid_token(source, token) {
        return lexer::invalid_token_display();
    }
    return lexer::token_text(source, token);
}

fn invalid_parse_validation(
    message: []u8,
    line: i64,
    column: i64,
    got: []u8
) -> ParseValidation {
    return ParseValidation {
        ok: false,
        message: message,
        line: line,
        column: column,
        got: got
    };
}

fn valid_parse_validation() -> ParseValidation {
    return ParseValidation {
        ok: true,
        message: "",
        line: 0,
        column: 0,
        got: ""
    };
}

fn validate_top_level_declarations(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var index = 0;
    while index + 1 < tokens.len() {
        let token = try tokens.get(index);
        let start = try validate_top_level_decl_start(source, tokens, index, token);
        if !start.ok {
            return start;
        }
        index = try skip_top_level_declaration(tokens, index);
    }
    return valid_parse_validation();
}

fn validate_no_invalid_tokens(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var index = 0;
    while index < tokens.len() {
        let token = try tokens.get(index);
        if lexer::is_invalid_token(source, token) {
            return invalid_parse_validation(
                "expected expression",
                token.line,
                token.column,
                token_text(source, token)
            );
        }
        index = index + 1;
    }
    return valid_parse_validation();
}

fn validate_top_level_decl_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    token: std::kizu::lexer::Token
) -> !ParseValidation {
    return match token.kind {
        Import => try validate_import_decl_header(source, tokens, index),
        Pub => try validate_public_top_level_decl_start(source, tokens, index),
        Fn => try validate_fn_decl_header(source, tokens, index, true),
        Unsafe => try validate_unsafe_top_level_decl_start(source, tokens, index),
        Extern => try validate_extern_decl_header(source, tokens, index),
        Struct => try validate_aggregate_decl_header(source, tokens, index, true, true),
        Enum => try validate_aggregate_decl_header(source, tokens, index, false, false),
        Union => try validate_aggregate_decl_header(source, tokens, index, true, false),
        Ident => validate_ident_top_level_decl_start(source, token),
        Eof => valid_parse_validation(),
        _ => invalid_parse_validation(
            "expected declaration",
            token.line,
            token.column,
            token_text(source, token)
        ),
    };
}

fn validate_public_top_level_decl_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let next = try tokens.get(index + 1);
    if lexer::is_eof(next) {
        return invalid_parse_validation("expected declaration", next.line, next.column, "");
    }
    if is_unsafe_modifier_token(next) {
        return try validate_unsafe_top_level_decl_start(source, tokens, index + 1);
    }
    if is_fn_token(next) {
        return try validate_fn_decl_header(source, tokens, index + 1, true);
    }
    if is_extern_token(next) {
        return try validate_extern_decl_header(source, tokens, index + 1);
    }
    if is_struct_token(next) {
        return try validate_aggregate_decl_header(source, tokens, index + 1, true, true);
    }
    if is_union_token(next) {
        return try validate_aggregate_decl_header(source, tokens, index + 1, true, false);
    }
    if is_enum_token(next) {
        return try validate_aggregate_decl_header(source, tokens, index + 1, false, false);
    }
    if is_public_top_level_decl_start(source, next) {
        return valid_parse_validation();
    }
    return invalid_parse_validation(
        "expected declaration",
        next.line,
        next.column,
        token_text(source, next)
    );
}

fn validate_unsafe_top_level_decl_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let next = try tokens.get(index + 1);
    if lexer::is_eof(next) {
        return invalid_parse_validation("expected fn or extern after unsafe", next.line, next.column, "");
    }
    if is_fn_token(next) {
        return try validate_fn_decl_header(source, tokens, index + 1, true);
    }
    if is_extern_token(next) {
        return try validate_extern_decl_header(source, tokens, index + 1);
    }
    return invalid_parse_validation(
        "expected fn or extern after unsafe",
        next.line,
        next.column,
        token_text(source, next)
    );
}

fn validate_import_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let name = try tokens.get(index + 1);
    if !is_ident_token(name) {
        return invalid_parse_validation(
            "expected identifier",
            name.line,
            name.column,
            token_text(source, name)
        );
    }
    return valid_parse_validation();
}

fn validate_extern_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let abi = try tokens.get(index + 1);
    if !is_string_token(abi) {
        return invalid_parse_validation(
            "expected string",
            abi.line,
            abi.column,
            token_text(source, abi)
        );
    }
    let fn_token = try tokens.get(index + 2);
    if !is_fn_token(fn_token) {
        return invalid_parse_validation(
            "expected fn",
            fn_token.line,
            fn_token.column,
            token_text(source, fn_token)
        );
    }
    return try validate_fn_decl_header(source, tokens, index + 2, false);
}

fn validate_aggregate_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    allow_type_params: bool,
    require_field_type: bool
) -> !ParseValidation {
    let name = try tokens.get(index + 1);
    if !is_ident_token(name) {
        return invalid_parse_validation(
            "expected identifier",
            name.line,
            name.column,
            token_text(source, name)
        );
    }
    var open_index = index + 2;
    if allow_type_params {
        let type_param_validation = try validate_optional_type_params(source, tokens, open_index);
        if !type_param_validation.ok {
            return type_param_validation;
        }
        open_index = try skip_optional_type_params(tokens, open_index);
    }
    let open = try tokens.get(open_index);
    if !is_left_brace_token(open) {
        return invalid_parse_validation(
            "expected left brace",
            open.line,
            open.column,
            token_text(source, open)
        );
    }
    return try validate_aggregate_body_start(source, tokens, open_index, require_field_type);
}

fn validate_aggregate_body_start(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64,
    require_field_type: bool
) -> !ParseValidation {
    let first = try tokens.get(open_index + 1);
    if is_right_brace_token(first) {
        return valid_parse_validation();
    }
    var after_name_index = open_index + 2;
    if is_pub_token(first) {
        let name = try tokens.get(open_index + 2);
        if is_ident_token(name) {
            after_name_index = open_index + 3;
            return try validate_optional_field_type(
                source,
                tokens,
                after_name_index,
                require_field_type
            );
        }
        return invalid_parse_validation(
            "expected identifier",
            name.line,
            name.column,
            token_text(source, name)
        );
    }
    if is_ident_token(first) {
        return try validate_optional_field_type(
            source,
            tokens,
            after_name_index,
            require_field_type
        );
    }
    return invalid_parse_validation(
        "expected identifier",
        first.line,
        first.column,
        token_text(source, first)
    );
}

fn validate_optional_field_type(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    colon_index: i64,
    require_field_type: bool
) -> !ParseValidation {
    if !require_field_type {
        return valid_parse_validation();
    }
    let colon = try tokens.get(colon_index);
    if !is_colon_token(colon) {
        return invalid_parse_validation(
            "expected colon",
            colon.line,
            colon.column,
            token_text(source, colon)
        );
    }
    let type_start = try tokens.get(colon_index + 1);
    if is_type_start_token(type_start) {
        return valid_parse_validation();
    }
    return invalid_parse_validation(
        "expected type name",
        type_start.line,
        type_start.column,
        token_text(source, type_start)
    );
}

fn validate_fn_decl_header(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    require_body: bool
) -> !ParseValidation {
    let name = try tokens.get(index + 1);
    if !is_ident_token(name) {
        return invalid_parse_validation(
            "expected function name",
            name.line,
            name.column,
            token_text(source, name)
        );
    }
    let type_param_validation = try validate_optional_type_params(source, tokens, index + 2);
    if !type_param_validation.ok {
        return type_param_validation;
    }
    let params_index = try skip_optional_type_params(tokens, index + 2);
    let params = try tokens.get(params_index);
    if !is_left_paren_token(params) {
        return invalid_parse_validation(
            "expected left paren",
            params.line,
            params.column,
            token_text(source, params)
        );
    }
    let param_validation = try validate_fn_params(source, tokens, params_index);
    if !param_validation.ok {
        return param_validation;
    }
    let after_params = try skip_balanced_parens(tokens, params_index);
    let return_validation = try validate_optional_fn_return_type(source, tokens, after_params);
    if !return_validation.ok {
        return return_validation;
    }
    if !require_body {
        return valid_parse_validation();
    }
    return try validate_required_fn_body(source, tokens, after_params);
}

fn validate_required_fn_body(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    var cursor = index;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if is_left_brace_token(token) {
            return valid_parse_validation();
        }
        if is_semicolon_token(token) or lexer::is_eof(token) {
            return invalid_parse_validation(
                "expected left brace",
                token.line,
                token.column,
                token_text(source, token)
            );
        }
        cursor = cursor + 1;
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected left brace", eof.line, eof.column, "");
}

fn validate_fn_params(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !ParseValidation {
    var cursor = open_index + 1;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if is_right_paren_token(token) {
            return valid_parse_validation();
        }
        if !is_ident_token(token) {
            return invalid_parse_validation(
                "expected identifier",
                token.line,
                token.column,
                token_text(source, token)
            );
        }
        let colon = try tokens.get(cursor + 1);
        if !is_colon_token(colon) {
            return invalid_parse_validation(
                "expected colon",
                colon.line,
                colon.column,
                token_text(source, colon)
            );
        }
        let type_start = try tokens.get(cursor + 2);
        if !is_type_start_token(type_start) {
            return invalid_parse_validation(
                "expected type name",
                type_start.line,
                type_start.column,
                token_text(source, type_start)
            );
        }
        cursor = try skip_fn_param_type(tokens, cursor + 3);
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected right paren", eof.line, eof.column, "");
}

fn skip_fn_param_type(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    var cursor = index;
    var angle_depth = 0;
    var bracket_depth = 0;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if angle_depth == 0 and bracket_depth == 0 and is_comma_token(token) {
            return cursor + 1;
        }
        if angle_depth == 0 and bracket_depth == 0 and is_right_paren_token(token) {
            return cursor;
        }
        if is_lt_token(token) {
            angle_depth = angle_depth + 1;
        }
        if is_gt_token(token) and angle_depth > 0 {
            angle_depth = angle_depth - 1;
        }
        if is_left_bracket_token(token) {
            bracket_depth = bracket_depth + 1;
        }
        if is_right_bracket_token(token) and bracket_depth > 0 {
            bracket_depth = bracket_depth - 1;
        }
        cursor = cursor + 1;
    }
    return cursor;
}

fn validate_optional_type_params(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let token = try tokens.get(index);
    if !is_lt_token(token) {
        return valid_parse_validation();
    }
    var cursor = index + 1;
    while cursor < tokens.len() {
        let current = try tokens.get(cursor);
        if !is_ident_token(current) {
            return invalid_parse_validation(
                "expected type parameter",
                current.line,
                current.column,
                token_text(source, current)
            );
        }
        let next = try tokens.get(cursor + 1);
        if is_gt_token(next) {
            return valid_parse_validation();
        }
        if !is_comma_token(next) {
            return invalid_parse_validation(
                "expected comma",
                next.line,
                next.column,
                token_text(source, next)
            );
        }
        cursor = cursor + 2;
    }
    let eof = try tokens.get(tokens.len() - 1);
    return invalid_parse_validation("expected type parameter", eof.line, eof.column, "");
}

fn validate_optional_fn_return_type(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !ParseValidation {
    let token = try tokens.get(index);
    if !is_arrow_token(token) {
        return valid_parse_validation();
    }
    let type_start = try tokens.get(index + 1);
    if is_type_start_token(type_start) {
        return valid_parse_validation();
    }
    return invalid_parse_validation(
        "expected type name",
        type_start.line,
        type_start.column,
        token_text(source, type_start)
    );
}

fn skip_optional_type_params(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    let token = try tokens.get(index);
    if !is_lt_token(token) {
        return index;
    }
    return try skip_balanced_angles(tokens, index);
}

fn skip_balanced_angles(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    var cursor = index;
    var depth = 0;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if is_lt_token(token) {
            depth = depth + 1;
        }
        if is_gt_token(token) {
            depth = depth - 1;
            if depth == 0 {
                return cursor + 1;
            }
        }
        cursor = cursor + 1;
    }
    return cursor;
}

fn skip_balanced_parens(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    var cursor = index;
    var depth = 0;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if is_left_paren_token(token) {
            depth = depth + 1;
        }
        if is_right_paren_token(token) {
            depth = depth - 1;
            if depth == 0 {
                return cursor + 1;
            }
        }
        cursor = cursor + 1;
    }
    return cursor;
}

fn validate_statement_separators(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>
) -> !ParseValidation {
    var index = 0;
    while index + 1 < tokens.len() {
        let token = try tokens.get(index);
        if is_fn_token(token) {
            let body = try find_fn_body_open_index(tokens, index);
            if body < tokens.len() {
                let validation = try validate_block_statement_separators(source, tokens, body);
                if !validation.ok {
                    return validation;
                }
            }
            index = try skip_top_level_declaration(tokens, index);
        } else {
            index = index + 1;
        }
    }
    return valid_parse_validation();
}

fn find_fn_body_open_index(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    let type_params = try skip_optional_type_params(tokens, index + 2);
    let params = try tokens.get(type_params);
    if !is_left_paren_token(params) {
        return tokens.len();
    }
    let after_params = try skip_balanced_parens(tokens, type_params);
    var cursor = after_params;
    while cursor < tokens.len() {
        let token = try tokens.get(cursor);
        if is_left_brace_token(token) {
            return cursor;
        }
        if is_semicolon_token(token) or lexer::is_eof(token) {
            return tokens.len();
        }
        cursor = cursor + 1;
    }
    return tokens.len();
}

fn validate_block_statement_separators(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    open_index: i64
) -> !ParseValidation {
    var cursor = open_index + 1;
    var depth = 1;
    while cursor < tokens.len() and depth > 0 {
        let previous = try tokens.get(cursor - 1);
        let token = try tokens.get(cursor);
        if needs_statement_separator(previous, token) {
            return invalid_parse_validation(
                "expected semicolon",
                token.line,
                token.column,
                token_text(source, token)
            );
        }
        if is_left_brace_token(token) {
            depth = depth + 1;
        }
        if is_right_brace_token(token) {
            depth = depth - 1;
        }
        cursor = cursor + 1;
    }
    return valid_parse_validation();
}

fn needs_statement_separator(
    previous: std::kizu::lexer::Token,
    token: std::kizu::lexer::Token
) -> bool {
    if previous.line != token.line {
        return false;
    }
    return can_end_expression_token(previous) and can_start_expression_token(token);
}

fn can_end_expression_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        Number => true,
        String => true,
        True => true,
        False => true,
        _ => false,
    };
}

fn can_start_expression_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        Number => true,
        String => true,
        True => true,
        False => true,
        Try => true,
        Match => true,
        If => true,
        _ => false,
    };
}

fn validate_ident_top_level_decl_start(
    source: []u8,
    token: std::kizu::lexer::Token
) -> ParseValidation {
    if is_skipped_top_level_decl_ident(source, token) {
        return valid_parse_validation();
    }
    return invalid_parse_validation(
        "expected declaration",
        token.line,
        token.column,
        token_text(source, token)
    );
}

fn is_public_top_level_decl_start(
    source: []u8,
    token: std::kizu::lexer::Token
) -> bool {
    return match token.kind {
        Fn => true,
        Unsafe => true,
        Extern => true,
        Struct => true,
        Enum => true,
        Union => true,
        Ident => is_skipped_top_level_decl_ident(source, token),
        _ => false,
    };
}

fn is_unsafe_top_level_decl_start(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Fn => true,
        Extern => true,
        _ => false,
    };
}

fn is_fn_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Fn => true,
        _ => false,
    };
}

fn is_extern_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Extern => true,
        _ => false,
    };
}

fn is_struct_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Struct => true,
        _ => false,
    };
}

fn is_enum_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Enum => true,
        _ => false,
    };
}

fn is_union_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Union => true,
        _ => false,
    };
}

fn is_unsafe_modifier_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Unsafe => true,
        _ => false,
    };
}

fn is_pub_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Pub => true,
        _ => false,
    };
}

fn is_string_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        String => true,
        _ => false,
    };
}

fn is_colon_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Colon => true,
        _ => false,
    };
}

fn is_arrow_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Arrow => true,
        _ => false,
    };
}

fn is_comma_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Comma => true,
        _ => false,
    };
}

fn is_type_start_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        Dyn => true,
        Bang => true,
        Amp => true,
        LBracket => true,
        Question => true,
        _ => false,
    };
}

fn is_skipped_top_level_decl_ident(
    source: []u8,
    token: std::kizu::lexer::Token
) -> bool {
    let text = token_text(source, token);
    return std::mem::equal_bytes(text, "impl") or std::mem::equal_bytes(text, "contract");
}

fn skip_top_level_declaration(
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64
) -> !i64 {
    var cursor = index;
    var paren_depth = 0;
    var bracket_depth = 0;
    var brace_depth = 0;
    var seen_body = false;
    while cursor + 1 < tokens.len() {
        let token = try tokens.get(cursor);
        if is_left_paren_token(token) {
            paren_depth = paren_depth + 1;
        }
        if is_right_paren_token(token) and paren_depth > 0 {
            paren_depth = paren_depth - 1;
        }
        if is_left_bracket_token(token) {
            bracket_depth = bracket_depth + 1;
        }
        if is_right_bracket_token(token) and bracket_depth > 0 {
            bracket_depth = bracket_depth - 1;
        }
        if is_left_brace_token(token) {
            brace_depth = brace_depth + 1;
            seen_body = true;
        }
        if is_right_brace_token(token) and brace_depth > 0 {
            brace_depth = brace_depth - 1;
            if seen_body and brace_depth == 0 {
                return cursor + 1;
            }
        }
        if is_semicolon_token(token) and paren_depth == 0 and
            bracket_depth == 0 and brace_depth == 0 {
            return cursor + 1;
        }
        cursor = cursor + 1;
    }
    return cursor;
}

fn is_left_paren_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        LParen => true,
        _ => false,
    };
}

fn is_right_paren_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        RParen => true,
        _ => false,
    };
}

fn is_lt_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        LT => true,
        _ => false,
    };
}

fn is_gt_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        GT => true,
        _ => false,
    };
}

fn is_left_bracket_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        LBracket => true,
        _ => false,
    };
}

fn is_right_bracket_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        RBracket => true,
        _ => false,
    };
}

fn is_left_brace_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        LBrace => true,
        _ => false,
    };
}

fn is_right_brace_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        RBrace => true,
        _ => false,
    };
}

fn is_semicolon_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Semicolon => true,
        _ => false,
    };
}

fn is_open_delimiter(text: []u8) -> bool {
    return std::mem::equal_bytes(text, "(") or
        std::mem::equal_bytes(text, "{") or
        std::mem::equal_bytes(text, "[");
}

fn is_binding_keyword(text: []u8) -> bool {
    return std::mem::equal_bytes(text, "let") or std::mem::equal_bytes(text, "var");
}

fn is_binding_statement(
    source: []u8,
    tokens: &std::array::Array<std::kizu::lexer::Token>,
    index: i64,
    text: []u8
) -> !bool {
    if !is_binding_keyword(text) {
        return false;
    }
    if !std::mem::equal_bytes(text, "var") or index == 0 {
        return true;
    }
    let previous = try tokens.get(index - 1);
    return !std::mem::equal_bytes(token_text(source, previous), "&");
}

fn is_ident_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        _ => false,
    };
}

fn is_close_delimiter(text: []u8) -> bool {
    return std::mem::equal_bytes(text, ")") or
        std::mem::equal_bytes(text, "}") or
        std::mem::equal_bytes(text, "]");
}

fn closing_delimiter_code(text: []u8) -> i64 {
    if std::mem::equal_bytes(text, "(") {
        return 1;
    }
    if std::mem::equal_bytes(text, "{") {
        return 2;
    }
    return 3;
}

fn delimiter_matches(expected: i64, text: []u8) -> bool {
    if expected == 1 {
        return std::mem::equal_bytes(text, ")");
    }
    if expected == 2 {
        return std::mem::equal_bytes(text, "}");
    }
    return std::mem::equal_bytes(text, "]");
}

fn expected_delimiter_message(expected: i64) -> []u8 {
    if expected == 1 {
        return "expected right paren";
    }
    if expected == 2 {
        return "expected right brace";
    }
    return "expected right bracket";
}

fn expression_missing_before(text: []u8) -> bool {
    return std::mem::equal_bytes(text, ";") or
        std::mem::equal_bytes(text, ")") or
        std::mem::equal_bytes(text, "}") or
        std::mem::equal_bytes(text, ",");
}

fn missing_expression_got_text(text: []u8) -> []u8 {
    if std::mem::equal_bytes(text, ";") {
        return ";";
    }
    if std::mem::equal_bytes(text, ")") {
        return ")";
    }
    if std::mem::equal_bytes(text, "}") {
        return "}";
    }
    return ",";
}
