pub fn is_type_start_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => true,
        Dyn => true,
        Bang => true,
        Amp => true,
        LBracket => true,
        Question => true,
        _ => false,
    };
}

