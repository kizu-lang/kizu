import selfhost::lexer;

pub fn token_text(
    source: []u8,
    token: std::kizu::lexer::Token
) -> []u8 {
    if lexer::is_invalid_token(source, token) {
        return lexer::invalid_token_display();
    }
    return lexer::token_text(source, token);
}

pub fn is_fn_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Fn => true,
        _ => false,
    };
}

pub fn is_extern_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Extern => true,
        _ => false,
    };
}

pub fn is_struct_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Struct => true,
        _ => false,
    };
}

pub fn is_enum_token(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
