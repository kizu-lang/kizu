    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::ir::codegen::lower_run_ast_function",
        "lower_run_ast_block"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::ir::codegen::lower_run_ast_block",
