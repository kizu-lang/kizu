fn require_metadata_line_body(bytes: []u8) -> !void {
    let function_name = "selfhost::ir::codegen::metadata_line";
    let statement = try ir_contract::body_child_sequence(bytes, function_name, 0, "statement", 0);
    let statement_kind = try ir_contract::body_node_kind(bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("invalid metadata line body");
    }
    let value = try ir_contract::body_child_sequence(bytes, function_name, statement, "value", 0);
    let value_kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "String") {
        return error("invalid metadata line body");
    }
    let token = try ir_contract::body_token_or_empty(bytes, function_name, value);
    if std::mem::len(token) < 2 {
        return error("invalid metadata line body");
    }
    return;
}

fn require_const_string_value_body(bytes: []u8) -> !void {
    let function_name = "selfhost::ir::codegen::const_string_value";
    let statement = try ir_contract::body_child_sequence(bytes, function_name, 0, "statement", 0);
    let statement_kind = try ir_contract::body_node_kind(bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("invalid const_string_value body");
    }
    let value = try ir_contract::body_child_sequence(bytes, function_name, statement, "value", 0);
    let value_kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        return error("invalid const_string_value body");
    }
    let type_name = try ir_contract::body_child_sequence(bytes, function_name, value, "type", 0);
    let actual_type = try ir_contract::body_token_or_empty(bytes, function_name, type_name);
    if !std::mem::equal_bytes(actual_type, "Value") {
        return error("invalid const_string_value body");
    }
    try require_struct_literal_namespace_expr(
        bytes,
        function_name,
        "Value",
        0,
        "kind",
        "ValueKind",
        "ConstString"
    );
    try require_struct_literal_var_field(bytes, function_name, "Value", 0, "name", "name");
    try require_struct_literal_var_field(
        bytes,
        function_name,
        "Value",
        0,
        "string_payload",
        "payload"
    );
    let const_string_tag = try ir_contract::enum_variant_tag(
        bytes,
        "selfhost::ir::codegen::ValueKind",
        "ConstString"
    );
    if const_string_tag < 0 {
        return error("invalid const_string_value body");
    }
    return;
}

fn require_const_string_instruction_body(bytes: []u8) -> !void {
    let function_name = "selfhost::ir::codegen::const_string_instruction";
    let statement = try ir_contract::body_child_sequence(bytes, function_name, 0, "statement", 0);
    let statement_kind = try ir_contract::body_node_kind(bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("invalid const_string_instruction body");
    }
    let value = try ir_contract::body_child_sequence(bytes, function_name, statement, "value", 0);
    let value_kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        return error("invalid const_string_instruction body");
    }
    let type_name = try ir_contract::body_child_sequence(bytes, function_name, value, "type", 0);
    let actual_type = try ir_contract::body_token_or_empty(bytes, function_name, type_name);
    if !std::mem::equal_bytes(actual_type, "Instruction") {
        return error("invalid const_string_instruction body");
    }
    try require_struct_literal_namespace_expr(
        bytes,
        function_name,
        "Instruction",
        0,
        "kind",
        "InstructionKind",
        "ConstString"
    );
    try require_struct_literal_field_expr(
        bytes,
        function_name,
        "Instruction",
        0,
        "result_kind",
        "value",
        "kind"
    );
    try require_struct_literal_field_expr(
        bytes,
        function_name,
        "Instruction",
        0,
        "result_name",
        "value",
        "name"
    );
    try require_struct_literal_field_expr(
        bytes,
        function_name,
        "Instruction",
        0,
        "result_payload",
        "value",
        "string_payload"
    );
    try require_struct_literal_empty_string_field(bytes, function_name, "Instruction", 0, "callee");
    try require_struct_literal_namespace_expr(
        bytes,
        function_name,
        "Instruction",
        0,
        "argument_kind",
        "ValueKind",
        "None"
    );
    try require_struct_literal_empty_slice_field(
        bytes,
        function_name,
        "Instruction",
        0,
        "argument_name",
        "name"
    );
    try require_struct_literal_empty_slice_field(
        bytes,
        function_name,
        "Instruction",
        0,
        "argument_payload",
        "string_payload"
    );
    let const_string_tag = try ir_contract::enum_variant_tag(
        bytes,
        "selfhost::ir::codegen::InstructionKind",
        "ConstString"
    );
    if const_string_tag < 0 {
        return error("invalid const_string_instruction body");
    }
    return;
}

fn require_return_void_instruction_body(bytes: []u8) -> !void {
    let function_name = "selfhost::ir::codegen::return_void_instruction";
    let statement = try ir_contract::body_child_sequence(bytes, function_name, 0, "statement", 0);
    let statement_kind = try ir_contract::body_node_kind(bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("invalid return_void_instruction body");
    }
    let value = try ir_contract::body_child_sequence(bytes, function_name, statement, "value", 0);
    let value_kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        return error("invalid return_void_instruction body");
    }
    let type_name = try ir_contract::body_child_sequence(bytes, function_name, value, "type", 0);
    let actual_type = try ir_contract::body_token_or_empty(bytes, function_name, type_name);
    if !std::mem::equal_bytes(actual_type, "Instruction") {
        return error("invalid return_void_instruction body");
    }
    try require_struct_literal_namespace_expr(
        bytes,
        function_name,
        "Instruction",
        0,
        "kind",
        "InstructionKind",
        "ReturnVoid"
    );
    try require_struct_literal_namespace_expr(
        bytes,
        function_name,
        "Instruction",
        0,
        "result_kind",
        "ValueKind",
        "None"
    );
    try require_struct_literal_namespace_expr(
        bytes,
        function_name,
        "Instruction",
        0,
        "argument_kind",
        "ValueKind",
        "None"
    );
    try require_struct_literal_empty_string_field(bytes, function_name, "Instruction", 0, "result_name");
    try require_struct_literal_empty_string_field(bytes, function_name, "Instruction", 0, "result_payload");
    try require_struct_literal_empty_string_field(bytes, function_name, "Instruction", 0, "callee");
    try require_struct_literal_empty_string_field(bytes, function_name, "Instruction", 0, "argument_name");
    try require_struct_literal_empty_string_field(bytes, function_name, "Instruction", 0, "argument_payload");
    let return_void_tag = try ir_contract::enum_variant_tag(
        bytes,
        "selfhost::ir::codegen::InstructionKind",
        "ReturnVoid"
    );
    if return_void_tag < 0 {
        return error("invalid return_void_instruction body");
    }
    return;
}

fn require_struct_literal_namespace_expr(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64,
    field_name: []u8,
    expected_receiver: []u8,
    expected_field: []u8
) -> !void {
    let value = try struct_literal_field_value(
        bytes,
        function_name,
        type_name,
        ordinal,
        field_name
    );
    let actual_field = try ir_contract::body_field_expr_name(bytes, function_name, value, "namespace");
    if !std::mem::equal_bytes(actual_field, expected_field) {
        return error("invalid codegen program builder body");
    }

    let receiver = try ir_contract::body_child_sequence(
        bytes,
        function_name,
        value,
        "receiver",
        0
    );
    let actual_receiver = try ir_contract::body_token_or_empty(bytes, function_name, receiver);
    if !std::mem::equal_bytes(actual_receiver, expected_receiver) {
        return error("invalid codegen program builder body");
    }
    return;
}

fn require_struct_literal_empty_string_field(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64,
    field_name: []u8
) -> !void {
    let value = try struct_literal_field_value(
        bytes,
        function_name,
        type_name,
        ordinal,
        field_name
    );
    let kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(kind, "String") {
        return error("invalid codegen program builder body");
    }
    let actual = try ir_contract::body_token_or_empty(bytes, function_name, value);
    if !is_empty_string_literal_token(actual) {
        return error("invalid codegen program builder body");
    }
    return;
}

fn require_struct_literal_empty_slice_field(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64,
    field_name: []u8,
    expected_value_field: []u8
) -> !void {
    let value = try struct_literal_field_value(
        bytes,
        function_name,
        type_name,
        ordinal,
        field_name
    );
    let kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(kind, "IndexExpr") {
        return error("invalid codegen program builder body");
    }
    let target = try ir_contract::body_child_sequence(bytes, function_name, value, "target", 0);
    try require_value_field_expr(bytes, function_name, target, expected_value_field);
    try require_int_child(bytes, function_name, value, "start", 0);
    try require_int_child(bytes, function_name, value, "end", 0);
    return;
}

fn require_value_field_expr(
    bytes: []u8,
    function_name: []u8,
    value: i64,
    expected_value_field: []u8
) -> !void {
    let kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(kind, "FieldExpr") {
        return error("invalid codegen program builder body");
    }
    let actual_field = try ir_contract::body_field_expr_name(bytes, function_name, value, "field");
    if !std::mem::equal_bytes(actual_field, expected_value_field) {
        return error("invalid codegen program builder body");
    }
    let receiver = try ir_contract::body_child_sequence(bytes, function_name, value, "receiver", 0);
    let actual_receiver = try ir_contract::body_token_or_empty(bytes, function_name, receiver);
    if !std::mem::equal_bytes(actual_receiver, "value") {
        return error("invalid codegen program builder body");
    }
    return;
}

fn require_int_child(
    bytes: []u8,
    function_name: []u8,
    value: i64,
    edge: []u8,
    expected: i64
) -> !void {
    let child = try ir_contract::body_child_sequence(bytes, function_name, value, edge, 0);
    let actual = try ir_contract::body_int_value(bytes, function_name, child);
    if actual != expected {
        return error("invalid codegen program builder body");
    }
    return;
}

fn is_empty_string_literal_token(token: []u8) -> bool {
    return std::mem::len(token) == 2 and
        token[0] == cast<u8>(34) and
        token[1] == cast<u8>(34);
}

fn require_codegen_program_builder_body(bytes: []u8) -> !void {
    let builder = "selfhost::ir::codegen::build_main_print_program";
    try ir_contract::require_body_call(bytes, builder, "const_string_value");
    try ir_contract::require_body_call(bytes, builder, "const_string_instruction");
    try ir_contract::require_body_call(bytes, builder, "call_instruction");
    try ir_contract::require_body_call(bytes, builder, "return_void_instruction");
    try require_struct_literal_field(bytes, builder, "CodegenFunction", 0, "name");
    try require_struct_literal_int_field(bytes, builder, "CodegenFunction", 0, "block_count", 1);
    try require_struct_literal_field(bytes, builder, "CodegenBlock", 0, "label");
    try require_struct_literal_int_field(bytes, builder, "CodegenBlock", 0, "instruction_count", 3);
    try require_struct_literal_int_field(bytes, builder, "Program", 0, "function_count", 1);
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "function_name",
        "function",
        "name"
    );
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "block_count",
        "function",
        "block_count"
    );
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "block_label",
        "block",
        "label"
    );
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "instruction_count",
        "block",
        "instruction_count"
    );
    try require_struct_literal_field_expr(bytes, builder, "Program", 0, "first_kind", "first", "kind");
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "first_result_kind",
        "first",
        "result_kind"
    );
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "first_result_name",
        "first",
        "result_name"
    );
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "first_result_payload",
        "first",
        "result_payload"
    );
    try require_struct_literal_field_expr(bytes, builder, "Program", 0, "second_kind", "second", "kind");
    try require_struct_literal_field_expr(bytes, builder, "Program", 0, "second_callee", "second", "callee");
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "second_argument_kind",
        "second",
        "argument_kind"
    );
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "second_argument_name",
        "second",
        "argument_name"
    );
    try require_struct_literal_field_expr(
        bytes,
        builder,
        "Program",
        0,
        "second_argument_payload",
        "second",
        "argument_payload"
    );
    try require_struct_literal_field_expr(bytes, builder, "Program", 0, "third_kind", "third", "kind");
    try require_struct_literal_var_field(
        bytes,
        builder,
        "Program",
        0,
        "from_codegen_lowering",
        "from_codegen_lowering"
    );
    return;
}

fn require_struct_literal_field(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64,
    field_name: []u8
) -> !void {
    let literal = try ir_contract::body_struct_literal_of_type(
        bytes,
        function_name,
        type_name,
        ordinal
    );
    let value = try ir_contract::body_struct_field_value(
        bytes,
        function_name,
        literal,
        field_name
    );
    if value < 0 {
        return error("invalid codegen program builder body");
    }
    return;
}

fn require_struct_literal_int_field(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64,
    field_name: []u8,
    expected: i64
) -> !void {
    let literal = try ir_contract::body_struct_literal_of_type(
        bytes,
        function_name,
        type_name,
        ordinal
    );
    let value = try ir_contract::body_struct_field_value(
        bytes,
        function_name,
        literal,
        field_name
    );
    let actual = try ir_contract::body_int_value(bytes, function_name, value);
    if actual != expected {
        return error("invalid codegen program builder body");
    }
    return;
}

fn require_struct_literal_field_expr(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64,
    field_name: []u8,
    expected_receiver: []u8,
    expected_field: []u8
) -> !void {
    let value = try struct_literal_field_value(
        bytes,
        function_name,
        type_name,
        ordinal,
        field_name
    );
    let actual_field = try ir_contract::body_field_expr_name(bytes, function_name, value, "field");
    if !std::mem::equal_bytes(actual_field, expected_field) {
        return error("invalid codegen program builder body");
    }

    let receiver = try ir_contract::body_child_sequence(
        bytes,
        function_name,
        value,
        "receiver",
        0
    );
    let actual_receiver = try ir_contract::body_token_or_empty(bytes, function_name, receiver);
    if !std::mem::equal_bytes(actual_receiver, expected_receiver) {
        return error("invalid codegen program builder body");
    }
    return;
}

fn require_struct_literal_var_field(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64,
    field_name: []u8,
    expected: []u8
) -> !void {
    let value = try struct_literal_field_value(
        bytes,
        function_name,
        type_name,
        ordinal,
        field_name
    );
    let actual = try ir_contract::body_token_or_empty(bytes, function_name, value);
    if !std::mem::equal_bytes(actual, expected) {
        return error("invalid codegen program builder body");
    }
    return;
}

fn struct_literal_field_value(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64,
    field_name: []u8
) -> !i64 {
    let literal = try ir_contract::body_struct_literal_of_type(
        bytes,
        function_name,
        type_name,
        ordinal
    );
    return try ir_contract::body_struct_field_value(
        bytes,
        function_name,
        literal,
        field_name
    );
}


fn require_executable_function_signatures(bytes: []u8) -> !void {
    try require_function_signature_param_count(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        3
    );
    try require_function_signature_return(bytes, "selfhost::cli::execute::run_file_cli", "!i64");
    try require_function_signature_param(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        0,
        "allocator:runtime:Allocator"
    );
    try require_function_signature_param(
        bytes,
        "selfhost::backend::lower_run_codegen_program",
        1,
        "ast:runtime:std::kizu::ast::Ast"
    );
    try require_function_signature_param(
        bytes,
        "selfhost::ir::codegen::lower_run_program",
        1,
        "ast:runtime:std::kizu::ast::Ast"
    );
    try require_function_signature_return(
        bytes,
        "selfhost::ir::codegen::lower_run_program",
        "!Program"
    );
    try require_function_signature_param(
        bytes,
        "selfhost::ir::codegen::lower_run_ast",
        1,
        "ast:runtime:std::kizu::ast::Ast"
    );
    try require_function_signature_return(
        bytes,
        "selfhost::ir::codegen::lower_run_ast",
        "!RunAst"
    );
    try require_function_signature_return(
        bytes,
        "selfhost::ir::codegen::lower_run_ast_to_program",
        "Program"
    );
    try require_function_signature_param(
        bytes,
        "selfhost::ir::codegen::main_print_program",
        0,
        "payload:runtime:[]u8"
    );
    try require_function_signature_return(
        bytes,
        "selfhost::ir::codegen::main_print_program",
        "Program"
    );
    try require_function_signature_param(
        bytes,
        "selfhost::ir::codegen::stdout_payload",
        0,
        "program:runtime:&Program"
    );
    try require_function_signature_return(
        bytes,
        "selfhost::ir::codegen::stdout_payload",
        "![]u8"
    );
    try require_function_signature_return(
        bytes,
        "selfhost::ir::codegen::metadata_line",
        "[]u8"
    );
    try require_function_signature_return(
        bytes,
        "selfhost::backend::lower_run_codegen_program",
        "!codegen::Program"
    );
    try require_function_signature_param(
        bytes,
        "selfhost::backend::executable::lower_test_executable",
        1,
        "ast:runtime:std::kizu::ast::Ast"
    );
    return;
}

fn require_function_signature_param_count(
    bytes: []u8,
    name: []u8,
    expected: i64
) -> !void {
    let actual = try function_signature_param_count(bytes, name);
    if actual != expected {
        return error("invalid IR artifact fact");
    }
    return;
}

fn require_function_signature_return(bytes: []u8, name: []u8, return_type: []u8) -> !void {
    try ir_contract::require_named_fact(bytes, "function-signature-return ", name, return_type);
    return;
}

fn require_function_signature_param(
    bytes: []u8,
    name: []u8,
    sequence: i64,
    value: []u8
) -> !void {
    try ir_contract::require_sequence_fact(
        bytes,
        "function-signature-param ",
        name,
        sequence,
        value
    );
    return;
}

fn function_signature_param_count(bytes: []u8, name: []u8) -> !i64 {
    return try ir_contract::sequence_fact_count(
        bytes,
        "function-signature-param ",
        name
    );
}

fn append_function_signature_params_metadata(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8
) -> !void {
    let count = try function_signature_param_count(ir_bytes, name);
    var index = 0;
    while index < count {
        try append_backend_input_sequence_fact(
            out,
            ir_bytes,
            "function-signature-param ",
            name,
            index
        );
        index = index + 1;
    }
    return;
}

fn require_selected_executable_body_parsing(bytes: []u8) -> !void {
    return;
}

fn validate_shape_manifest(bytes: []u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-shape-v0") {
        return error("invalid IR shape manifest");
    }
    try require_shape(bytes, "manifest-version selfhost-abi-v0");
    try require_shape(bytes, "node-kind function");
    try require_shape(bytes, "node-kind block");
    try require_shape(bytes, "node-kind diagnostic");
    try require_shape(bytes, "value-type i64");
    try require_shape(bytes, "value-type bool");
    try require_shape(bytes, "value-type []u8");
    try require_shape(bytes, "value-type record");
    try require_shape(bytes, "value-type error-union");
    try require_shape(bytes, "value-type handle");
    try require_shape(bytes, "storage local");
    try require_shape(bytes, "storage owned-container");
    try require_shape(bytes, "storage borrowed-view");
    try require_shape(bytes, "storage arena");
    try require_shape(bytes, "storage handle");
    try require_shape(bytes, "call direct");
    try require_shape(bytes, "call direct-record-roundtrip");
    try require_shape(bytes, "call std-primitive");
    try require_shape(bytes, "cleanup deinit");
    try require_shape(bytes, "host-capabilities selfhost-host-v0");
    try require_shape(bytes, "external std::mem::page_allocator");
    try require_shape(bytes, "external std::fs::exists");
    try require_shape(bytes, "external std::fs::metadata");
    try require_shape(bytes, "external std::fs::read_dir");
    try require_shape(bytes, "external std::fs::read_file");
    try require_shape(bytes, "external std::fs::write_file");
    try require_shape(bytes, "external std::fs::create_dir");
    try require_shape(bytes, "external std::io::blocking");
    try require_shape(bytes, "external std::io::write_stdout");
    try require_shape(bytes, "external std::io::write_stderr");
    try require_shape(bytes, "external std::process::arg_count");
    try require_shape(bytes, "external std::process::arg");
    try require_shape(bytes, "external std::process::env");
    try require_shape(bytes, "external std::process::exit_code");
    try require_shape(bytes, "manifest-complete selfhost-abi-v0");
    return;
}

fn require_shape(bytes: []u8, shape: []u8) -> !void {
    if !ir_contract::contains(bytes, shape) {
        return error("unsupported IR shape manifest");
    }
    return;
}

fn write_backend_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_llvm_module(
    allocator: Allocator,
    ir_bytes: []u8,
    ir_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "; kizu selfhost bootstrap ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(ir_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.handle = type { ptr, i64 }");
    try append_line(out, "%kizu.fs.metadata = type { i64, i1 }");
    try append_line(out, "%kizu.error.bool = type { i1, i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.i64 = type { i1, i64, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.owned = type { i1, %kizu.owned, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.error.metadata = type { i1, %kizu.fs.metadata, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.selfhost.executable = type { i64, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.codegen.binding = type { i1, %kizu.slice.u8, %kizu.slice.u8, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.payload = type { i1, %kizu.slice.u8, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.run_ast = type { i1, i64, %kizu.slice.u8, i64, i64, i64, %kizu.slice.u8, i64, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.codegen.value = type { i64, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.codegen.instruction = type { i64, i64, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, i64, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.codegen.block = type { %kizu.slice.u8, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.function = type { %kizu.slice.u8, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.program = type { i64, %kizu.slice.u8, i64, %kizu.slice.u8, i64, i64, i64, %kizu.slice.u8, %kizu.slice.u8, i64, %kizu.slice.u8, i64, %kizu.slice.u8, %kizu.slice.u8, i64, i1 }");
    try append_line(out, "");
    try cli_llvm::append_globals(out, ir_bytes);
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "declare ptr @kizu_rt_alloc(ptr, i64)");
    try append_line(out, "declare void @kizu_rt_free(ptr, ptr)");
    try append_line(out, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg)");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "declare %kizu.error.bool @kizu_rt_fs_exists(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.metadata @kizu_rt_fs_metadata(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.owned @kizu_rt_fs_read_dir(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_rename(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_arg_count()");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_arg(i64)");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_env(%kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "declare void @kizu_rt_process_exit(i64) noreturn");
    try append_line(out,
        "declare %kizu.error.i64 @kizu_rt_process_spawn_wait8(i64, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out, "declare void @kizu_rt_owned_deinit(%kizu.owned)");
    try append_line(out, "declare void @kizu_rt_trap(%kizu.slice.u8) noreturn");
    try append_line(out, "declare i64 @kizu_selfhost__runtime_storage_smoke()");
    try append_line(out, "declare i64 @kizu_selfhost__host_capability_smoke()");
    try append_line(out, "");
    try cli_llvm::append_functions(out, ir_bytes);
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_selfhost__smoke() {");
    try append_line(out, "entry:");
    try append_line(out, "  ret i64 0");
    try append_line(out, "}");
    return out;
}

fn render_llvm_metadata(
    allocator: Allocator,
    ir_bytes: []u8,
    ir_path: []u8,
    manifest_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-llvm-artifact-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    try append_line(out, "output target/selfhost/selfhost.ll");
    try append_line(out, "runtime-storage target/selfhost/selfhost.storage.ll");
    try append_line(out, "host-runtime target/selfhost/selfhost.host.ll");
    try append_line(out, "host-runtime-metadata target/selfhost/selfhost.host.ll.meta");
    try append_line(out, "storage-backend selfhost-runtime-ll");
    try append_line(out, "host-capabilities selfhost-host-v0");
    try append_line(out, "abi-record summary-i64-slice");
    try append_line(out, "abi-error-union summary-success-failure");
    try append_line(out, "abi-call direct-record-roundtrip");
    try append_line(out, "go-stdprim-storage none");
    try append_line(out, "go-stdprim-host none");
    try append_line(out, "linker-process hosted-artifact-runner");
    try append_line(out, "backend-input ir-contract selfhost-checked-package-v1");
    try append_line(out, "backend-input checked-entry selfhost::cli_main");
    try append_line(out, "backend-input hosted-entry @kizu_selfhost__cli_main");
    try append_line(out, "backend-input hosted-smoke @kizu_selfhost__smoke");
    try append_line(out, "backend-input executable-contract-source data selfhost::backend::data");
    try append_line(
        out,
        "backend-input executable-contract-source lowering selfhost::backend::executable"
    );
    try append_executable_function_signature_metadata(out, ir_bytes);
    try append_line(out, "backend-input hosted-executable-abi executable-result-layout-v1");
    try append_line(out, "backend-input executable-layout kind:i64 callee:[]u8 payload:[]u8");
    try append_backend_input_executable_tag(out, "executable-kind ", "Unsupported");
    try append_backend_input_executable_tag(out, "executable-kind ", "RunReturnVoid");
    try append_backend_input_executable_tag(out, "executable-kind ", "Call");
    try append_line(out, "entry @kizu_selfhost__cli_main");
    try append_line(out, "cli-command check selfhost");
    try append_line(out, "cli-command stage selfhost");
    try append_line(out, "cli-command check file source");
    try append_line(out, "cli-command parse file source");
    try append_line(out, "cli-command fmt file source");
    try append_line(out, "cli-command run file executable top-level-print-or-return");
    try append_line(out, "cli-command test file executable top-level-expect");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/parse-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/check-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/run-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/test-parity.tsv");
    try append_line(out, "cli-hosted-smoke no-go");
    try append_line(out, "validation go test ./cmd/kizu -run TestSelfhostBackendArtifactGate");
    try append_line(out, "external @kizu_rt_mem_page_allocator");
    try append_line(out, "external @kizu_rt_alloc");
    try append_line(out, "external @kizu_rt_free");
    try append_line(out, "external @llvm.memcpy.p0.p0.i64");
    try append_line(out, "external @kizu_rt_io_blocking");
    try append_line(out, "external @kizu_rt_fs_exists");
    try append_line(out, "external @kizu_rt_fs_metadata");
    try append_line(out, "external @kizu_rt_fs_read_dir");
    try append_line(out, "external @kizu_rt_fs_read_file");
    try append_line(out, "external @kizu_rt_fs_write_file");
    try append_line(out, "external @kizu_rt_fs_create_dir");
    try append_line(out, "external @kizu_rt_fs_rename");
    try append_line(out, "external @kizu_rt_io_write_stdout");
    try append_line(out, "external @kizu_rt_io_write_stderr");
    try append_line(out, "external @kizu_rt_process_arg_count");
    try append_line(out, "external @kizu_rt_process_arg");
    try append_line(out, "external @kizu_rt_process_env");
    try append_line(out, "external @kizu_rt_process_exit_code");
    try append_line(out, "external @kizu_rt_process_exit");
    try append_line(out, "external @kizu_rt_process_spawn_wait8");
    try append_line(out, "external @kizu_rt_owned_deinit");
    try append_line(out, "external @kizu_rt_trap");
    try append_line(out, "unsupported-policy blocker");
    try append_line(out, "deferred tagged-union-payload issue-495");
    return out;
}

fn append_executable_function_signature_metadata(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "function-signature-return ",
        "selfhost::cli::execute::run_file_cli"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::cli::execute::run_file_cli"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "function-signature-return ",
        "selfhost::ir::codegen::lower_run_program"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::ir::codegen::lower_run_program"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "function-signature-return ",
        "selfhost::ir::codegen::lower_run_ast"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::ir::codegen::lower_run_ast"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "function-signature-return ",
        "selfhost::ir::codegen::lower_run_ast_to_program"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::ir::codegen::lower_run_ast_to_program"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "function-signature-return ",
        "selfhost::ir::codegen::main_print_program"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::ir::codegen::main_print_program"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "function-signature-return ",
        "selfhost::ir::codegen::stdout_payload"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::ir::codegen::stdout_payload"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "function-signature-return ",
        "selfhost::ir::codegen::metadata_line"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::ir::codegen::metadata_line"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "function-signature-return ",
        "selfhost::backend::lower_run_codegen_program"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::backend::lower_run_codegen_program"
    );
    try append_function_signature_params_metadata(
        out,
        ir_bytes,
        "selfhost::backend::executable::lower_test_executable"
    );
    return;
}

fn append_backend_input_executable_tag(
    out: &var std::string::String,
    prefix: []u8,
    name: []u8
) -> !void {
    let value = try executable_tag_value(prefix, name);
    try out.append_bytes("backend-input ");
    try out.append_bytes(prefix);
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn require_executable_tag_layout() -> !void {
    if try data::executable_kind_tag_by_name("Unsupported") != 0 {
        return error("invalid executable kind layout");
    }
    if try data::executable_kind_tag_by_name("RunReturnVoid") != 1 {
        return error("invalid executable kind layout");
    }
    if try data::executable_kind_tag_by_name("Call") != 2 {
        return error("invalid executable kind layout");
    }
    return;
}

fn executable_tag_value(prefix: []u8, name: []u8) -> !i64 {
    if std::mem::equal_bytes(prefix, "executable-kind ") {
        return try data::executable_kind_tag_by_name(name);
    }
    return error("invalid executable tag prefix");
}

