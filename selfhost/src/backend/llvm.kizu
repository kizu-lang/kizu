    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-prefix ",
        function_name
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-suffix ",
        function_name
    );
    try append_backend_input_named_fact(out, ir_bytes, "hosted-artifact-writer ", function_name);
    return;
}

