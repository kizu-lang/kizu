    try append_line(out, "");
    // array_new / array_append back the dynamic Array<T> builder backing
    // std::kizu::lexer::tokenize (tracker 961, scope 4 prerequisite). array_new allocates the
    // 40-byte %kizu.rt.array record (allocator, data, len, cap, element_size) off the allocator;
    // array_append grows the heap buffer by one element and memcpy's the {ptr, element_size}
    // element slice in, returning the ok error-union. They mirror the canonical storage-module
    // definitions; the hosted compiler module carries its own self-contained copies (it never
    // links the storage module), matching the embedded array_len / array_at / arena_add.
    try append_line(out,
        "define %kizu.owned @kizu_rt_array_new(%kizu.owned %allocator, i64 %element_size) {");
    try append_line(out, "entry:");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %raw = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 40)");
    try append_line(out,
        "  %allocator_field = getelementptr inbounds %kizu.rt.array, ptr %raw, i32 0, i32 0");
    try append_line(out, "  store ptr %allocator_ptr, ptr %allocator_field");
    try append_line(out,
        "  %data_field = getelementptr inbounds %kizu.rt.array, ptr %raw, i32 0, i32 1");
    try append_line(out, "  store ptr null, ptr %data_field");
    try append_line(out,
        "  %len_field = getelementptr inbounds %kizu.rt.array, ptr %raw, i32 0, i32 2");
    try append_line(out, "  store i64 0, ptr %len_field");
