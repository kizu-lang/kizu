import selfhost::backend::cli_llvm;
import selfhost::backend::data;
import selfhost::backend::ir_contract;
import selfhost::backend::ir_index;
import selfhost::backend::runtime;

pub fn consume_ir_artifact(io: Io, path: &[]u8) -> !data::BackendSummary {
    let bytes = try std::fs::read_file(io, path);
    try validate_ir_artifact(bytes);
    return data::BackendSummary {
        artifacts: std::mem::len(bytes)
    };
}

pub fn emit_llvm_artifact(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !data::LlvmArtifact {
    let ir_bytes = try std::fs::read_file(io, ir_path);
    try validate_ir_artifact(ir_bytes);
    var lookup_index = try ir_index::build(ir_bytes);
    defer lookup_index.deinit();

    let manifest_bytes = try std::fs::read_file(io, manifest_path);
    try validate_shape_manifest(manifest_bytes);

    var module = try render_llvm_module(allocator, &lookup_index, ir_bytes, ir_path);
    let module_view = module.as_bytes();
    let module_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.ll",
        module_view,
        module.len()
    );
    module.deinit();

    var metadata = try render_llvm_metadata(allocator, ir_bytes, ir_path, manifest_path);
    let metadata_view = metadata.as_bytes();
    let metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.ll.meta",
        metadata_view,
        metadata.len()
    );
    metadata.deinit();

    let storage = try runtime::load_storage_module(io);
    let storage_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.storage.ll",
        storage,
        std::mem::len(storage)
    );

    var storage_metadata = try runtime::render_storage_metadata(
        allocator,
        io,
        ir_path,
        manifest_path
    );
    let storage_metadata_view = storage_metadata.as_bytes();
    let storage_metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.storage.ll.meta",
        storage_metadata_view,
        storage_metadata.len()
    );
    storage_metadata.deinit();

    let host = try runtime::load_host_module(io);
    let host_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.host.ll",
        host,
        std::mem::len(host)
    );

    var host_metadata = try runtime::render_host_metadata(
        allocator,
        io,
        ir_path,
        manifest_path
    );
    let host_metadata_view = host_metadata.as_bytes();
    let host_metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.host.ll.meta",
        host_metadata_view,
        host_metadata.len()
    );
    host_metadata.deinit();

    return data::LlvmArtifact {
        ll_path: "target/selfhost/selfhost.ll",
        metadata_path: "target/selfhost/selfhost.ll.meta",
        storage_path: "target/selfhost/selfhost.storage.ll",
        storage_metadata_path: "target/selfhost/selfhost.storage.ll.meta",
        host_path: "target/selfhost/selfhost.host.ll",
        host_metadata_path: "target/selfhost/selfhost.host.ll.meta",
        bytes: module_len,
        metadata_bytes: metadata_len,
        storage_bytes: storage_len,
        storage_metadata_bytes: storage_metadata_len,
        host_bytes: host_len,
        host_metadata_bytes: host_metadata_len
    };
}

fn validate_ir_artifact(bytes: []u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-v0") {
        return error("invalid IR artifact");
    }
    if !ir_contract::contains(bytes, "package selfhost") {
        return error("unsupported IR artifact package");
    }
    try ir_contract::require_fact(bytes, "ir-contract selfhost-checked-package-v1");
    try ir_contract::require_fact(bytes, "checked-entry selfhost::cli_main");
    try ir_contract::require_fact(bytes, "hosted-entry @kizu_selfhost__cli_main");
    try ir_contract::require_fact(bytes, "hosted-smoke @kizu_selfhost__smoke");
    try ir_contract::require_fact(
        bytes,
        "executable-contract-source data selfhost::backend::data"
    );
    try ir_contract::require_fact(
        bytes,
        "executable-contract-source lowering selfhost::backend::executable"
    );
    try require_executable_function_signatures(bytes);
    try require_selected_executable_body_ir(bytes);
    try require_selected_executable_body_parsing(bytes);
    try ir_contract::require_fact(bytes, "frontend-executable-lowering checked-body-ir");
    try ir_contract::require_fact(bytes, "hosted-executable-abi executable-result-layout-v1");
    try ir_contract::require_fact(bytes, "executable-layout kind:i64 callee:[]u8 payload:[]u8");
    try require_executable_tag_layout();
    try ir_contract::require_fact(bytes, "checked-diagnostics 0");
    return;
}

fn require_selected_executable_body_ir(bytes: []u8) -> !void {
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        "check::checked_ast_node"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        "backend::render_run_codegen_artifact"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        "backend::emit_rendered_run_artifact"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::render_run_codegen_artifact",
        "code_render::render_run_ast_artifact"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::emit_rendered_run_artifact",
        "hosted::emit_rendered_run_artifact"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::hosted::emit_rendered_run_artifact",
        "write_backend_bytes"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::hosted::emit_rendered_run_artifact",
        "rendered_run_metadata_executable"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::hosted::rendered_run_metadata_executable",
        "codegen::metadata_line"
    );
    try require_metadata_line_body(bytes);
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::test_file_cli",
        "check::checked_ast_node"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::test_file_cli",
        "backend::lower_test_executable"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::test_file_cli",
        "backend::emit_test_executable_artifact"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::executable::lower_test_executable",
        "executable_lowering::lower_test_executable"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::hosted::emit_test_executable_artifact",
        "ensure_hosted_artifact_dir"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::hosted::emit_test_executable_artifact",
        "write_test_artifact"
    );
    return;
}

fn require_metadata_line_body(bytes: []u8) -> !void {
    let function_name = "selfhost::ir::codegen::metadata_line";
    let statement = try ir_contract::body_child_sequence(bytes, function_name, 0, "statement", 0);
    let statement_kind = try ir_contract::body_node_kind(bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("invalid metadata line body");
    }
    let value = try ir_contract::body_child_sequence(bytes, function_name, statement, "value", 0);
    let value_kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "String") {
        return error("invalid metadata line body");
    }
    let token = try ir_contract::body_token_or_empty(bytes, function_name, value);
    if std::mem::len(token) < 2 {
        return error("invalid metadata line body");
    }
    return;
}

fn require_executable_function_signatures(bytes: []u8) -> !void {
    try require_function_signature_param_count(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        3
    );
    try require_function_signature_return(bytes, "selfhost::cli::execute::run_file_cli", "!i64");
    try require_function_signature_param(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        0,
        "allocator:runtime:Allocator"
    );
    try require_function_signature_return(
        bytes,
        "selfhost::ir::codegen::metadata_line",
        "[]u8"
    );
    try require_function_signature_param(
        bytes,
        "selfhost::backend::executable::lower_test_executable",
        1,
        "ast:runtime:std::kizu::ast::Ast"
    );
    return;
}

fn require_function_signature_param_count(
    bytes: []u8,
    name: []u8,
    expected: i64
) -> !void {
    let actual = try function_signature_param_count(bytes, name);
    if actual != expected {
        return error("invalid IR artifact fact");
    }
    return;
}

fn require_function_signature_return(bytes: []u8, name: []u8, return_type: []u8) -> !void {
    try ir_contract::require_named_fact(bytes, "function-signature-return ", name, return_type);
    return;
}

fn require_function_signature_param(
    bytes: []u8,
    name: []u8,
    sequence: i64,
    value: []u8
) -> !void {
    try ir_contract::require_sequence_fact(
        bytes,
        "function-signature-param ",
        name,
        sequence,
        value
    );
    return;
}

fn function_signature_param_count(bytes: []u8, name: []u8) -> !i64 {
    return try ir_contract::sequence_fact_count(
        bytes,
        "function-signature-param ",
        name
    );
}

fn append_function_signature_params_metadata(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8
) -> !void {
    let count = try function_signature_param_count(ir_bytes, name);
    var index = 0;
    while index < count {
        try append_backend_input_sequence_fact(
            out,
            ir_bytes,
            "function-signature-param ",
            name,
            index
        );
        index = index + 1;
    }
    return;
}

fn require_selected_executable_body_parsing(bytes: []u8) -> !void {
    return;
}

fn validate_shape_manifest(bytes: []u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-shape-v0") {
        return error("invalid IR shape manifest");
    }
    try require_shape(bytes, "manifest-version selfhost-abi-v0");
    try require_shape(bytes, "node-kind function");
    try require_shape(bytes, "node-kind block");
    try require_shape(bytes, "node-kind diagnostic");
    try require_shape(bytes, "value-type i64");
    try require_shape(bytes, "value-type bool");
    try require_shape(bytes, "value-type []u8");
    try require_shape(bytes, "value-type record");
    try require_shape(bytes, "value-type error-union");
    try require_shape(bytes, "value-type handle");
    try require_shape(bytes, "storage local");
    try require_shape(bytes, "storage owned-container");
    try require_shape(bytes, "storage borrowed-view");
    try require_shape(bytes, "storage arena");
    try require_shape(bytes, "storage handle");
    try require_shape(bytes, "call direct");
    try require_shape(bytes, "call direct-record-roundtrip");
    try require_shape(bytes, "call std-primitive");
    try require_shape(bytes, "cleanup deinit");
    try require_shape(bytes, "host-capabilities selfhost-host-v0");
    try require_shape(bytes, "external std::mem::page_allocator");
    try require_shape(bytes, "external std::fs::exists");
    try require_shape(bytes, "external std::fs::metadata");
    try require_shape(bytes, "external std::fs::read_dir");
    try require_shape(bytes, "external std::fs::read_file");
    try require_shape(bytes, "external std::fs::write_file");
    try require_shape(bytes, "external std::fs::rename");
    try require_shape(bytes, "external std::fs::create_dir");
    try require_shape(bytes, "external std::io::blocking");
    try require_shape(bytes, "external std::io::write_stdout");
    try require_shape(bytes, "external std::io::write_stderr");
    try require_shape(bytes, "external std::process::arg_count");
    try require_shape(bytes, "external std::process::arg");
    try require_shape(bytes, "external std::process::env");
    try require_shape(bytes, "external std::process::exit_code");
    try require_shape(bytes, "manifest-complete selfhost-abi-v0");
    return;
}

fn require_shape(bytes: []u8, shape: []u8) -> !void {
    if !ir_contract::contains(bytes, shape) {
        return error("unsupported IR shape manifest");
    }
    return;
}

fn write_backend_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_llvm_module(
    allocator: Allocator,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    ir_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "; kizu selfhost bootstrap ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(ir_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.handle = type { ptr, i64 }");
    try append_line(out, "%kizu.fs.metadata = type { i64, i1 }");
    try append_line(out, "%kizu.error.bool = type { i1, i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.i64 = type { i1, i64, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.owned = type { i1, %kizu.owned, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.error.metadata = type { i1, %kizu.fs.metadata, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.selfhost.executable = type { i64, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.codegen.run_ast = type { i1, i64, %kizu.slice.u8, i64, i64, i64, %kizu.slice.u8, i64, %kizu.slice.u8, %kizu.slice.u8, i64, i64, %kizu.slice.u8, i64, i64, i64, i64, i64, i64 }");
    // !RunAst error union (tracker 961, scope 4 prerequisite): the lower_run_ast traversal
    // cluster returns RunAst wrapped in an error union; the success value is the RunAst struct
    // and the failure carries a diagnostic byte slice, matching the canonical { ok, value, error }
    // error-union layout.
    try append_line(out,
        "%kizu.error.run_ast = type { i1, %kizu.selfhost.codegen.run_ast, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.codegen.value = type { i64, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.codegen.instruction = type { i64, i64, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, i64, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.codegen.block = type { %kizu.slice.u8, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.function = type { %kizu.slice.u8, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.program = type { i64, %kizu.slice.u8, i64, %kizu.slice.u8, i64, i64, i64, %kizu.slice.u8, %kizu.slice.u8, i64, %kizu.slice.u8, i64, %kizu.slice.u8, %kizu.slice.u8, i64, i1, %kizu.slice.u8, i64, i64, %kizu.slice.u8, i64, i64, i64, i64, i64, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.local_binding = type { %kizu.slice.u8, i64, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.local_table = type { i64, %kizu.selfhost.codegen.local_binding, %kizu.selfhost.codegen.local_binding }");
    try append_line(out,
        "%kizu.selfhost.codegen.payload_span = type { i64, i64 }");
    try append_line(out,
        "%kizu.error.payload_span = type { i1, %kizu.selfhost.codegen.payload_span, %kizu.slice.u8 }");
    // CodeEval threads the run codegen IR v1 tape lowering result (the unified ok
    // flag, the result value id, and the next free SSA counter) through the
    // recursive expression descent; its error union follows the canonical
    // { ok, value, error } layout.
    try append_line(out,
        "%kizu.selfhost.codegen.code_eval = type { i1, i64, i64 }");
    try append_line(out,
        "%kizu.error.code_eval = type { i1, %kizu.selfhost.codegen.code_eval, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.kizu.ast.child_range = type { i64, i64 }");
    try append_line(out,
        "%kizu.selfhost.codegen.int_env = type { i64, %kizu.kizu.ast.child_range, %kizu.slice.u8, i64, %kizu.slice.u8, i64, %kizu.slice.u8, i64 }");
    // std::kizu::ast::Ast is the first AST container value pulled into stage2 for the
    // read-only Ast.len accessor (tracker 961). Its nodes (Arena<AstNode>) and
    // children (Array<NodeId>) fields lower to the %kizu.owned heap handle the
    // selfhost runtime uses for owned containers; only the children field (index 1)
    // is read by Ast.len. The AstNode/AstData union layout is intentionally NOT
    // modelled here.
    try append_line(out,
        "%kizu.kizu.ast.source_file = type { %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.kizu.ast.ast = type { %kizu.owned, %kizu.owned, %kizu.kizu.ast.source_file }");
    // selfhost::source::SourceFile is the source-loader record constructed by the
    // compiled source_file helper. SourceKind is an enum and lowers to i64.
    try append_line(out,
        "%kizu.selfhost.source.source_file = type { i64, i64, %kizu.slice.u8, i64, i64, %kizu.slice.u8, %kizu.slice.u8 }");
    // NodeId is the children Array element type; Ast.child_at returns one by value as
    // !NodeId via the checked Array<NodeId>.get accessor (tracker 961).
    try append_line(out,
        "%kizu.kizu.ast.node_id = type { i64 }");
    try append_line(out,
        "%kizu.kizu.ast.parse_result = type { %kizu.kizu.ast.ast, %kizu.kizu.ast.node_id }");
    // !std::kizu::ast::ParseResult is the full std::kizu::parser::parse_program return type
    // (issue 1157): the parsed ParseResult value carried in the canonical error union
    // { i1 ok, <value>, %kizu.slice.u8 message }, the same struct-in-error-union shape
    // node_id / related_span already use.
    try append_line(out,
        "%kizu.error.parse_result = type { i1, %kizu.kizu.ast.parse_result, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.error.node_id = type { i1, %kizu.kizu.ast.node_id, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.selfhost.cli.parse_node_result = type { i1, i64, %kizu.kizu.ast.node_id }");
    // The AstNode/AstData tagged-union ABI (tracker 961). AstData is the inline
    // tagged-union layout { i64 tag, [N x i8] payload storage }, where N (96) is the
    // byte capacity of the largest variant payload, matching the canonical backend
    // union capacity. AstNode bundles a Span with the AstData union value; Ast.add_node
    // constructs an AstNode and appends it to the nodes Arena. The individual 44 variant
    // payload structs are not modelled here: add_node forwards the AstData value whole.
    // std::kizu::lexer::Position is the lexer's (line, column) cursor (tracker 961, scope 4
    // prerequisite): the bottom of the tokenizer's position-tracking helpers.
    try append_line(out,
        "%kizu.kizu.lexer.position = type { i64, i64 }");
    // std::kizu::lexer::Token is the tokenizer's output record (tracker 961, scope 4
    // prerequisite): { TokenKind kind, i64 start, i64 end, i64 line, i64 column, i64
    // doc_start, i64 doc_end }. TokenKind is an enum, so it lowers to i64, making the
    // whole struct seven i64 fields. first_token / next_token / token_at thread it.
    try append_line(out,
        "%kizu.kizu.lexer.token = type { i64, i64, i64, i64, i64, i64, i64 }");
    // std::kizu::parser::ParseNode threads the parser's current AST node and lookahead token
    // between recursive-descent parser helpers (tracker 961).
    try append_line(out,
        "%kizu.kizu.parser.parse_node = type { %kizu.kizu.ast.node_id, %kizu.kizu.lexer.token }");
    try append_line(out,
        "%kizu.kizu.ast.span = type { i64, i64 }");
    try append_line(out,
        "%kizu.kizu.ast.ast_data = type { i64, [96 x i8] }");
    try append_line(out,
        "%kizu.kizu.ast.ast_node = type { %kizu.kizu.ast.span, %kizu.kizu.ast.ast_data }");
    // ProgramNode is the first AstData variant payload struct modelled in stage2 for the
    // 'match node.data { Program(program) => program.declarations.len, _ => 0 }' accessor
    // (selfhost::ast::declaration_count, tracker 961). It is read out of the inline AstData
    // payload storage by value.
    try append_line(out,
        "%kizu.kizu.ast.program_node = type { %kizu.kizu.ast.child_range }");
    // The remaining AstData variant payload structs read by the node_count traversal
    // cluster (selfhost::ast::node_count + the count_* helpers, tracker 961). Each is
    // loaded by value out of the inline AstData payload storage so a match-over-AstData
    // arm can follow the NodeId / ChildRange fields it counts. Field types follow the
    // value layout table: bool -> i1, an enum tag -> i64, NodeId / ChildRange / Span ->
    // their already-modelled value types. The five leaf variants (Int / String /
    // TypeName / Var / Bool) and the payload-less Empty stay unmodelled: their arms
    // return the literal 1 without loading a payload.
    try append_line(out,
        "%kizu.kizu.ast.prefix_node = type { i64, %kizu.kizu.ast.node_id }");
    try append_line(out,
        "%kizu.kizu.ast.binary_node = type { i64, %kizu.kizu.ast.node_id, %kizu.kizu.ast.node_id }");
    try append_line(out,
        "%kizu.kizu.ast.field_expr_node = type { %kizu.kizu.ast.node_id, %kizu.kizu.ast.node_id, i1 }");
    try append_line(out,
        "%kizu.kizu.ast.deref_expr_node = type { %kizu.kizu.ast.node_id }");
    try append_line(out,
        "%kizu.kizu.ast.call_node = type { %kizu.kizu.ast.node_id, %kizu.kizu.ast.child_range }");
    try append_line(out,
