import selfhost::backend::cli_llvm;
import selfhost::backend::cli_executable_body_lowering_contract;
import selfhost::backend::cli_executable_body_parser_contract;
import selfhost::backend::data;
import selfhost::backend::ir_contract;
import selfhost::backend::runtime;

pub fn consume_ir_artifact(io: Io, path: &[]u8) -> !data::BackendSummary {
    let bytes = try std::fs::read_file(io, path);
    try validate_ir_artifact(bytes);
    return data::BackendSummary {
        artifacts: std::mem::len(bytes)
    };
}

pub fn emit_llvm_artifact(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !data::LlvmArtifact {
    let ir_bytes = try std::fs::read_file(io, ir_path);
    try validate_ir_artifact(ir_bytes);

    let manifest_bytes = try std::fs::read_file(io, manifest_path);
    try validate_shape_manifest(manifest_bytes);

    var module = try render_llvm_module(allocator, ir_bytes, ir_path);
    let module_view = module.as_bytes();
    let module_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.ll",
        module_view,
        module.len()
    );
    module.deinit();

    var metadata = try render_llvm_metadata(allocator, ir_bytes, ir_path, manifest_path);
    let metadata_view = metadata.as_bytes();
    let metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.ll.meta",
        metadata_view,
        metadata.len()
    );
    metadata.deinit();

    let storage = try runtime::load_storage_module(io);
    let storage_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.storage.ll",
        storage,
        std::mem::len(storage)
    );

    var storage_metadata = try runtime::render_storage_metadata(
        allocator,
        io,
        ir_path,
        manifest_path
    );
    let storage_metadata_view = storage_metadata.as_bytes();
    let storage_metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.storage.ll.meta",
        storage_metadata_view,
        storage_metadata.len()
    );
    storage_metadata.deinit();

    let host = try runtime::load_host_module(io);
    let host_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.host.ll",
        host,
        std::mem::len(host)
    );

    var host_metadata = try runtime::render_host_metadata(
        allocator,
        io,
        ir_path,
        manifest_path
    );
    let host_metadata_view = host_metadata.as_bytes();
    let host_metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.host.ll.meta",
        host_metadata_view,
        host_metadata.len()
    );
    host_metadata.deinit();

    return data::LlvmArtifact {
        ll_path: "target/selfhost/selfhost.ll",
        metadata_path: "target/selfhost/selfhost.ll.meta",
        storage_path: "target/selfhost/selfhost.storage.ll",
        storage_metadata_path: "target/selfhost/selfhost.storage.ll.meta",
        host_path: "target/selfhost/selfhost.host.ll",
        host_metadata_path: "target/selfhost/selfhost.host.ll.meta",
        bytes: module_len,
        metadata_bytes: metadata_len,
        storage_bytes: storage_len,
        storage_metadata_bytes: storage_metadata_len,
        host_bytes: host_len,
        host_metadata_bytes: host_metadata_len
    };
}

fn validate_ir_artifact(bytes: []u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-v0") {
        return error("invalid IR artifact");
    }
    if !ir_contract::contains(bytes, "package selfhost") {
        return error("unsupported IR artifact package");
    }
    try ir_contract::require_fact(bytes, "ir-contract selfhost-checked-package-v1");
    try ir_contract::require_fact(bytes, "checked-entry selfhost::cli_main");
    try ir_contract::require_fact(bytes, "hosted-entry @kizu_selfhost__cli_main");
    try ir_contract::require_fact(bytes, "hosted-smoke @kizu_selfhost__smoke");
    try ir_contract::require_fact(
        bytes,
        "executable-contract-source data selfhost::backend::data"
    );
    try ir_contract::require_fact(
        bytes,
        "executable-contract-source lowering selfhost::backend::executable"
    );
    try require_selected_executable_signatures(bytes);
    try require_selected_executable_body_ir(bytes);
    try require_selected_executable_body_parsing(bytes);
    try require_selected_executable_body_lowering(bytes);
    try require_selected_hosted_artifact_paths(bytes);
    try require_selected_hosted_executable_lowering(bytes);
    try ir_contract::require_fact(bytes, "frontend-executable-lowering checked-ast-selected-body-ir");
    try ir_contract::require_fact(bytes, "hosted-executable-abi executable-result-layout-v1");
    try ir_contract::require_fact(bytes, "executable-ast-layout kind:i64 payload:[]u8");
    try ir_contract::require_fact(bytes, "executable-layout kind:i64 stdout_payload:[]u8");
    try ir_contract::require_named_i64_fact(bytes, "executable-ast-kind ", "Unsupported");
    try ir_contract::require_named_i64_fact(bytes, "executable-ast-kind ", "RunPrintCall");
    try ir_contract::require_named_i64_fact(bytes, "executable-ast-kind ", "RunReturnVoid");
    try ir_contract::require_named_i64_fact(bytes, "executable-ast-kind ", "TestExpectTrue");
    try ir_contract::require_named_i64_fact(bytes, "executable-ast-kind ", "TestExpectFalse");
    try ir_contract::require_named_i64_fact(bytes, "executable-kind ", "Unsupported");
    try ir_contract::require_named_i64_fact(bytes, "executable-kind ", "RunPrintString");
    try ir_contract::require_named_i64_fact(bytes, "executable-kind ", "RunReturnVoid");
    try ir_contract::require_named_i64_fact(bytes, "executable-kind ", "TestExpectOk");
    try ir_contract::require_named_i64_fact(bytes, "executable-kind ", "TestExpectFailure");
    try ir_contract::require_fact(bytes, "checked-diagnostics 0");
    return;
}

fn require_selected_executable_body_ir(bytes: []u8) -> !void {
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        "check::checked_ast_node"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::run_file_cli",
        "backend::lower_run_executable"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::cli::execute::test_file_cli",
        "backend::lower_test_executable"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::executable::lower_run_executable",
        "parse_run_executable_ast"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::executable::lower_test_executable",
        "parse_test_executable_ast"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::hosted::emit_run_executable_artifact",
        "write_run_artifact"
    );
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::hosted::emit_test_executable_artifact",
        "write_test_artifact"
    );
    return;
}

fn require_selected_executable_signatures(bytes: []u8) -> !void {
    try require_selected_signature_param_count(bytes, "selfhost::cli::execute::run_file_cli");
    try require_selected_signature_return(bytes, "selfhost::cli::execute::run_file_cli", "!i64");
    try require_selected_signature_param(
        bytes,
        "selfhost::cli::execute::run_file_cli#0",
        "allocator:runtime:Allocator"
    );
    try require_selected_signature_param_count(
        bytes,
        "selfhost::backend::executable::lower_run_executable"
    );
    try require_selected_signature_return(
        bytes,
        "selfhost::backend::executable::lower_run_executable",
        "!data::Executable"
    );
    try require_selected_signature_param(
        bytes,
        "selfhost::backend::executable::lower_run_executable#1",
        "ast:runtime:std::kizu::ast::Ast"
    );
    try require_selected_signature_return(
        bytes,
        "selfhost::backend::executable::lower_run_executable_ast",
        "data::Executable"
    );
    try require_selected_signature_return(
        bytes,
        "selfhost::backend::executable::parse_run_program_ast",
        "!data::ExecutableAst"
    );
    try require_selected_signature_param(
        bytes,
        "selfhost::backend::executable::parse_run_print_call_ast#3",
        "args:runtime:std::kizu::ast::ChildRange"
    );
    try require_selected_signature_param(
        bytes,
        "selfhost::backend::executable::parse_expect_call_ast#3",
        "args:runtime:std::kizu::ast::ChildRange"
    );
    try require_selected_signature_return(
        bytes,
        "selfhost::backend::hosted::emit_run_executable_artifact",
        "!data::RunArtifact"
    );
    try require_selected_signature_param(
        bytes,
        "selfhost::backend::hosted::emit_run_executable_artifact#3",
        "executable:runtime:data::Executable"
    );
    return;
}

fn require_selected_signature_param_count(bytes: []u8, name: []u8) -> !void {
    try ir_contract::require_named_i64_fact(bytes, "selected-signature-param-count ", name);
    return;
}

fn require_selected_signature_return(bytes: []u8, name: []u8, return_type: []u8) -> !void {
    try ir_contract::require_named_fact(bytes, "selected-signature-return ", name, return_type);
    return;
}

fn require_selected_signature_param(bytes: []u8, name: []u8, value: []u8) -> !void {
    try ir_contract::require_named_fact(bytes, "selected-signature-param ", name, value);
    return;
}

fn require_selected_executable_body_lowering(bytes: []u8) -> !void {
    try cli_executable_body_lowering_contract::require(bytes);
    return;
}

fn require_selected_executable_body_parsing(bytes: []u8) -> !void {
    try cli_executable_body_parser_contract::require_selected_body_parsing(bytes);
    return;
}

fn require_selected_hosted_artifact_paths(bytes: []u8) -> !void {
    try require_hosted_artifact_path(
        bytes,
        "selfhost::backend::hosted::emit_run_executable_artifact",
        "target/selfhost/run",
        "target/selfhost/run/",
        "write_run_artifact"
    );
    try require_hosted_artifact_path(
        bytes,
        "selfhost::backend::hosted::emit_test_executable_artifact",
        "target/selfhost/test",
        "target/selfhost/test/",
        "write_test_artifact"
    );
    try require_hosted_artifact_metadata(
        bytes,
        "selfhost::backend::hosted::write_run_metadata",
        "kizu-run-artifact-v0",
        "issue\20#569"
    );
    try require_hosted_artifact_metadata(
        bytes,
        "selfhost::backend::hosted::write_test_metadata",
        "kizu-test-artifact-v0",
        "issue\20#570"
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-source-prefix ",
        "selfhost::backend::hosted::append_common_metadata",
        "source\20"
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-output-prefix ",
        "selfhost::backend::hosted::append_common_metadata",
        "output\20"
    );
    try require_hosted_common_metadata(bytes);
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-discovery-line ",
        "selfhost::backend::hosted::write_test_metadata",
        "discovery\20none"
    );
    return;
}

fn require_hosted_artifact_path(
    bytes: []u8,
    function_name: []u8,
    directory: []u8,
    prefix: []u8,
    writer: []u8
) -> !void {
    try ir_contract::require_named_fact(bytes, "hosted-artifact-dir ", function_name, directory);
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-ll-prefix ",
        function_name,
        prefix
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-ll-suffix ",
        function_name,
        ".ll"
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-prefix ",
        function_name,
        prefix
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-suffix ",
        function_name,
        ".ll.meta"
    );
    try ir_contract::require_named_fact(bytes, "hosted-artifact-writer ", function_name, writer);
    return;
}

fn require_hosted_artifact_metadata(
    bytes: []u8,
    function_name: []u8,
    title: []u8,
    issue: []u8
) -> !void {
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-title ",
        function_name,
        title
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-issue ",
        function_name,
        issue
    );
    return;
}

fn require_hosted_common_metadata(bytes: []u8) -> !void {
    let function_name = "selfhost::backend::hosted::append_common_metadata";
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-abi-line ",
        function_name,
        "abi\20selfhost-abi-v0"
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-entry-prefix ",
        function_name,
        "entry\20@"
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-runtime-line ",
        function_name,
        "runtime\20target/selfhost/selfhost.host.ll"
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-lowering-line ",
        function_name,
        "executable_lowering\20selfhost::backend::executable\20checked-ast"
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-fallback-line ",
        function_name,
        "go.cmd-kizu-fallback\20none"
    );
    try ir_contract::require_named_fact(
        bytes,
        "hosted-artifact-metadata-mode-line ",
        function_name,
        "artifact_mode\20hosted-artifact"
    );
    return;
}

fn require_selected_hosted_executable_lowering(bytes: []u8) -> !void {
    try require_hosted_lowering_cases(
        bytes,
        "selfhost::backend::hosted::lower_run_hosted_executable"
    );
    try require_hosted_lowering_cases(
        bytes,
        "selfhost::backend::hosted::lower_test_hosted_executable"
    );
    return;
}

fn require_hosted_lowering_cases(bytes: []u8, function_name: []u8) -> !void {
    let count = try hosted_lowering_case_count(bytes, function_name);
    if count < 1 {
        return error("invalid IR artifact fact");
    }

    var index = 0;
    while index < count {
        try require_hosted_lowering_case(bytes, function_name, index);
        index = index + 1;
    }
    return;
}

fn hosted_lowering_case_count(bytes: []u8, function_name: []u8) -> !i64 {
    var count = 0;
    while try ir_contract::sequence_fact_exists(
        bytes,
        "hosted-lowering-case-kind ",
        function_name,
        count
    ) {
        count = count + 1;
    }
    return count;
}

fn require_hosted_lowering_case(
    bytes: []u8,
    function_name: []u8,
    index: i64
) -> !void {
    let kind = try ir_contract::sequence_fact_value(
        bytes,
        "hosted-lowering-case-kind ",
        function_name,
        index
    );
    let kind_tag = try ir_contract::named_i64_fact(bytes, "executable-kind ", kind);
    if kind_tag < 0 {
        return error("invalid IR artifact fact");
    }
    try require_hosted_lowering_case_value(
        bytes,
        "hosted-lowering-case-comment-llvm ",
        function_name,
        index
    );
    try require_hosted_lowering_case_value(
        bytes,
        "hosted-lowering-case-entry ",
        function_name,
        index
    );
    try require_hosted_lowering_case_value(
        bytes,
        "hosted-lowering-case-global ",
        function_name,
        index
    );
    let stream = try require_hosted_lowering_case_value(
        bytes,
        "hosted-lowering-case-stream ",
        function_name,
        index
    );
    try require_hosted_stream_value(stream);
    let newline = try require_hosted_lowering_case_value(
        bytes,
        "hosted-lowering-case-newline ",
        function_name,
        index
    );
    try require_bool_value(newline);
    try require_hosted_lowering_case_value(
        bytes,
        "hosted-lowering-case-exit ",
        function_name,
        index
    );
    let payload = try require_hosted_lowering_case_value(
        bytes,
        "hosted-lowering-case-payload ",
        function_name,
        index
    );
    if std::mem::equal_bytes(payload, "literal") {
        let payload_llvm = try require_hosted_lowering_case_value(
            bytes,
            "hosted-lowering-case-payload-llvm ",
            function_name,
            index
        );
        if std::mem::len(payload_llvm) < 1 {
            return error("invalid IR artifact fact");
        }
    }
    return;
}

fn require_hosted_lowering_case_value(
    bytes: []u8,
    prefix: []u8,
    function_name: []u8,
    index: i64
) -> ![]u8 borrows bytes {
    return try ir_contract::sequence_fact_value(bytes, prefix, function_name, index);
}

fn require_hosted_stream_value(value: []u8) -> !void {
    if std::mem::equal_bytes(value, "None") or
        std::mem::equal_bytes(value, "Stdout") or
        std::mem::equal_bytes(value, "Stderr") {
        return;
    }
    return error("invalid IR artifact fact");
}

fn require_bool_value(value: []u8) -> !void {
    if std::mem::equal_bytes(value, "true") or std::mem::equal_bytes(value, "false") {
        return;
    }
    return error("invalid IR artifact fact");
}

fn validate_shape_manifest(bytes: []u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-shape-v0") {
        return error("invalid IR shape manifest");
    }
    try require_shape(bytes, "manifest-version selfhost-abi-v0");
    try require_shape(bytes, "node-kind function");
    try require_shape(bytes, "node-kind block");
    try require_shape(bytes, "node-kind diagnostic");
    try require_shape(bytes, "value-type i64");
    try require_shape(bytes, "value-type bool");
    try require_shape(bytes, "value-type []u8");
    try require_shape(bytes, "value-type record");
    try require_shape(bytes, "value-type error-union");
    try require_shape(bytes, "value-type handle");
    try require_shape(bytes, "storage local");
    try require_shape(bytes, "storage owned-container");
    try require_shape(bytes, "storage borrowed-view");
    try require_shape(bytes, "storage arena");
    try require_shape(bytes, "storage handle");
    try require_shape(bytes, "call direct");
    try require_shape(bytes, "call direct-record-roundtrip");
    try require_shape(bytes, "call std-primitive");
    try require_shape(bytes, "cleanup deinit");
    try require_shape(bytes, "host-capabilities selfhost-host-v0");
    try require_shape(bytes, "external std::mem::page_allocator");
    try require_shape(bytes, "external std::fs::exists");
    try require_shape(bytes, "external std::fs::metadata");
    try require_shape(bytes, "external std::fs::read_dir");
    try require_shape(bytes, "external std::fs::read_file");
    try require_shape(bytes, "external std::fs::write_file");
    try require_shape(bytes, "external std::fs::create_dir");
    try require_shape(bytes, "external std::io::blocking");
    try require_shape(bytes, "external std::io::write_stdout");
    try require_shape(bytes, "external std::io::write_stderr");
    try require_shape(bytes, "external std::process::arg_count");
    try require_shape(bytes, "external std::process::arg");
    try require_shape(bytes, "external std::process::env");
    try require_shape(bytes, "external std::process::exit_code");
    try require_shape(bytes, "manifest-complete selfhost-abi-v0");
    return;
}

fn require_shape(bytes: []u8, shape: []u8) -> !void {
    if !ir_contract::contains(bytes, shape) {
        return error("unsupported IR shape manifest");
    }
    return;
}

fn write_backend_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_llvm_module(
    allocator: Allocator,
    ir_bytes: []u8,
    ir_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "; kizu selfhost bootstrap ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(ir_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.handle = type { ptr, i64 }");
    try append_line(out, "%kizu.fs.metadata = type { i64, i1 }");
    try append_line(out, "%kizu.error.bool = type { i1, i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.i64 = type { i1, i64, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.owned = type { i1, %kizu.owned, %kizu.slice.u8 }");
    try append_line(out,
        "%kizu.error.metadata = type { i1, %kizu.fs.metadata, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.selfhost.executable.ast = type { i64, %kizu.slice.u8 }");
    try append_line(out, "%kizu.selfhost.executable = type { i64, %kizu.slice.u8 }");
    try append_line(out, "");
    try cli_llvm::append_globals(out, ir_bytes);
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "declare ptr @kizu_rt_alloc(ptr, i64)");
    try append_line(out, "declare void @kizu_rt_free(ptr, ptr)");
    try append_line(out, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg)");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "declare %kizu.error.bool @kizu_rt_fs_exists(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.metadata @kizu_rt_fs_metadata(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.owned @kizu_rt_fs_read_dir(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_fs_rename(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_arg_count()");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_arg(i64)");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_env(%kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "declare void @kizu_rt_process_exit(i64) noreturn");
    try append_line(out, "declare void @kizu_rt_owned_deinit(%kizu.owned)");
    try append_line(out, "declare void @kizu_rt_trap(%kizu.slice.u8) noreturn");
    try append_line(out, "declare i64 @kizu_selfhost__runtime_storage_smoke()");
    try append_line(out, "declare i64 @kizu_selfhost__host_capability_smoke()");
    try append_line(out, "");
    try cli_llvm::append_functions(out, ir_bytes);
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_selfhost__smoke() {");
    try append_line(out, "entry:");
    try append_line(out, "  ret i64 0");
    try append_line(out, "}");
    return out;
}

fn render_llvm_metadata(
    allocator: Allocator,
    ir_bytes: []u8,
    ir_path: []u8,
    manifest_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-llvm-artifact-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    try append_line(out, "output target/selfhost/selfhost.ll");
    try append_line(out, "runtime-storage target/selfhost/selfhost.storage.ll");
    try append_line(out, "host-runtime target/selfhost/selfhost.host.ll");
    try append_line(out, "host-runtime-metadata target/selfhost/selfhost.host.ll.meta");
    try append_line(out, "storage-backend selfhost-runtime-ll");
    try append_line(out, "host-capabilities selfhost-host-v0");
    try append_line(out, "abi-record summary-i64-slice");
    try append_line(out, "abi-error-union summary-success-failure");
    try append_line(out, "abi-call direct-record-roundtrip");
    try append_line(out, "go-stdprim-storage none");
    try append_line(out, "go-stdprim-host none");
    try append_line(out, "linker-process deferred issue-459");
    try append_line(out, "backend-input ir-contract selfhost-checked-package-v1");
    try append_line(out, "backend-input checked-entry selfhost::cli_main");
    try append_line(out, "backend-input hosted-entry @kizu_selfhost__cli_main");
    try append_line(out, "backend-input hosted-smoke @kizu_selfhost__smoke");
    try append_line(out, "backend-input executable-contract-source data selfhost::backend::data");
    try append_line(
        out,
        "backend-input executable-contract-source lowering selfhost::backend::executable"
    );
    try append_selected_executable_signature_metadata(out, ir_bytes);
    try append_selected_executable_body_parsing_metadata(out, ir_bytes);
    try append_selected_hosted_artifact_path_metadata(out, ir_bytes);
    try append_selected_hosted_executable_lowering_metadata(out, ir_bytes);
    try append_line(out, "backend-input hosted-executable-abi executable-result-layout-v1");
    try append_line(out, "backend-input executable-ast-layout kind:i64 payload:[]u8");
    try append_line(out, "backend-input executable-layout kind:i64 stdout_payload:[]u8");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-ast-kind ", "Unsupported");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-ast-kind ", "RunPrintCall");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-ast-kind ", "RunReturnVoid");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-ast-kind ", "TestExpectTrue");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-ast-kind ", "TestExpectFalse");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-kind ", "Unsupported");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-kind ", "RunPrintString");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-kind ", "RunReturnVoid");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-kind ", "TestExpectOk");
    try append_backend_input_i64_fact(out, ir_bytes, "executable-kind ", "TestExpectFailure");
    try append_line(out, "entry @kizu_selfhost__cli_main");
    try append_line(out, "cli-command check selfhost");
    try append_line(out, "cli-command stage selfhost");
    try append_line(out, "cli-command check file source");
    try append_line(out, "cli-command parse file source");
    try append_line(out, "cli-command fmt file source");
    try append_line(out, "cli-command run file executable top-level-print-or-return");
    try append_line(out, "cli-command test file executable top-level-expect");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/parse-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/check-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/run-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/test-parity.tsv");
    try append_line(out, "cli-hosted-smoke no-go");
    try append_line(out, "validation go test ./cmd/kizu -run TestSelfhostBackendArtifactGate");
    try append_line(out, "external @kizu_rt_mem_page_allocator");
    try append_line(out, "external @kizu_rt_alloc");
    try append_line(out, "external @kizu_rt_free");
    try append_line(out, "external @llvm.memcpy.p0.p0.i64");
    try append_line(out, "external @kizu_rt_io_blocking");
    try append_line(out, "external @kizu_rt_fs_exists");
    try append_line(out, "external @kizu_rt_fs_metadata");
    try append_line(out, "external @kizu_rt_fs_read_dir");
    try append_line(out, "external @kizu_rt_fs_read_file");
    try append_line(out, "external @kizu_rt_fs_write_file");
    try append_line(out, "external @kizu_rt_fs_create_dir");
    try append_line(out, "external @kizu_rt_fs_rename");
    try append_line(out, "external @kizu_rt_io_write_stdout");
    try append_line(out, "external @kizu_rt_io_write_stderr");
    try append_line(out, "external @kizu_rt_process_arg_count");
    try append_line(out, "external @kizu_rt_process_arg");
    try append_line(out, "external @kizu_rt_process_env");
    try append_line(out, "external @kizu_rt_process_exit_code");
    try append_line(out, "external @kizu_rt_process_exit");
    try append_line(out, "external @kizu_rt_owned_deinit");
    try append_line(out, "external @kizu_rt_trap");
    try append_line(out, "unsupported-policy blocker");
    try append_line(out, "deferred tagged-union-payload issue-495");
    return out;
}

fn append_selected_executable_signature_metadata(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_backend_input_i64_fact(
        out,
        ir_bytes,
        "selected-signature-param-count ",
        "selfhost::cli::execute::run_file_cli"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-return ",
        "selfhost::cli::execute::run_file_cli"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-param ",
        "selfhost::cli::execute::run_file_cli#0"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-return ",
        "selfhost::backend::executable::lower_run_executable"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-param ",
        "selfhost::backend::executable::lower_run_executable#1"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-return ",
        "selfhost::backend::executable::lower_run_executable_ast"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-return ",
        "selfhost::backend::executable::parse_run_program_ast"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-param ",
        "selfhost::backend::executable::parse_run_print_call_ast#3"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-param ",
        "selfhost::backend::executable::parse_expect_call_ast#3"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-return ",
        "selfhost::backend::hosted::emit_run_executable_artifact"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "selected-signature-param ",
        "selfhost::backend::hosted::emit_run_executable_artifact#3"
    );
    return;
}

fn append_selected_executable_body_parsing_metadata(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "syntax-fn");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "syntax-test");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "syntax-return");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "syntax-void");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "value-main");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "run-print-callee");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "expect-callee-root");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "expect-callee-module");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "expect-callee-function");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "literal-true");
    try append_selected_body_parsing_token_metadata(out, ir_bytes, "literal-false");
    return;
}

fn append_selected_body_parsing_token_metadata(
    out: &var std::string::String,
    ir_bytes: []u8,
    key: []u8
) -> !void {
    try append_backend_input_named_fact(out, ir_bytes, "selected-body-parsing-token ", key);
    return;
}

fn append_selected_hosted_artifact_path_metadata(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_hosted_artifact_path_metadata(
        out,
        ir_bytes,
        "selfhost::backend::hosted::emit_run_executable_artifact"
    );
    try append_hosted_artifact_path_metadata(
        out,
        ir_bytes,
        "selfhost::backend::hosted::emit_test_executable_artifact"
    );
    try append_hosted_artifact_metadata(
        out,
        ir_bytes,
        "selfhost::backend::hosted::write_run_metadata"
    );
    try append_hosted_artifact_metadata(
        out,
        ir_bytes,
        "selfhost::backend::hosted::write_test_metadata"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-source-prefix ",
        "selfhost::backend::hosted::append_common_metadata"
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-output-prefix ",
        "selfhost::backend::hosted::append_common_metadata"
    );
    try append_hosted_common_metadata(out, ir_bytes);
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-discovery-line ",
        "selfhost::backend::hosted::write_test_metadata"
    );
    return;
}

