import selfhost::backend::cli_llvm;
import selfhost::backend::compiled_run_entry_llvm;
import selfhost::backend::compiled_runtime_declarations;
import selfhost::backend::compiled_type_declarations;
import selfhost::backend::data;
import selfhost::backend::external_abi_validation;
import selfhost::abi::fixed_abi_contract;
import selfhost::backend::ir_contract;
import selfhost::backend::ir_index;
import selfhost::backend::profile;
import selfhost::backend::runtime;

pub fn consume_ir_artifact(io: Io, path: &[]u8) -> !data::BackendSummary {
    let bytes = try std::fs::read_file(io, path);
    try validate_ir_artifact(bytes);
    return data::BackendSummary {
        artifacts: std::mem::len(bytes)
    };
}

pub fn emit_llvm_artifact(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !data::LlvmArtifact {
    var profile_out = std::string::String(allocator);
    defer profile_out.deinit();
    let backend_profile = try profile::start(&var profile_out);
    try profile::flush(&backend_profile, &var profile_out, io);

    let read_ir_started = try profile::begin(&backend_profile, &var profile_out, io, "read_ir_file");
    let ir_bytes = try std::fs::read_file(io, ir_path);
    try profile::end(&backend_profile, &var profile_out, io, "read_ir_file", read_ir_started);

    let validate_ir_started =
        try profile::begin(&backend_profile, &var profile_out, io, "validate_ir_artifact");
    try validate_ir_artifact(ir_bytes);
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "validate_ir_artifact",
        validate_ir_started
    );

    let build_index_started =
        try profile::begin(&backend_profile, &var profile_out, io, "build_ir_index");
    var lookup_index = try ir_index::build(ir_bytes);
    defer lookup_index.deinit();
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "build_ir_index",
        build_index_started
    );
    try profile::record_i64(
        &backend_profile,
        &var profile_out,
        "ir.bytes",
        std::mem::len(ir_bytes)
    );
    try profile::record_i64(
        &backend_profile,
        &var profile_out,
        "ir.newlines",
        ir_index::newline_count(&lookup_index)
    );
    try profile::record_i64(
        &backend_profile,
        &var profile_out,
        "ir.index.entries",
        ir_index::entry_count(&lookup_index)
    );
    if profile::is_enabled(&backend_profile) {
        let fact_metrics_started =
            try profile::begin(&backend_profile, &var profile_out, io, "record_ir_fact_metrics");
        try record_ir_fact_profile_metrics(
            &backend_profile,
            &var profile_out,
            &lookup_index,
            ir_bytes
        );
        try profile::end(
            &backend_profile,
            &var profile_out,
            io,
            "record_ir_fact_metrics",
            fact_metrics_started
        );
    }
    try profile::flush(&backend_profile, &var profile_out, io);

    let read_manifest_started =
        try profile::begin(&backend_profile, &var profile_out, io, "read_manifest_file");
    let manifest_bytes = try std::fs::read_file(io, manifest_path);
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "read_manifest_file",
        read_manifest_started
    );

    let validate_manifest_started =
        try profile::begin(&backend_profile, &var profile_out, io, "validate_shape_manifest");
    try validate_shape_manifest(manifest_bytes);
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "validate_shape_manifest",
        validate_manifest_started
    );

    let render_module_started =
        try profile::begin(&backend_profile, &var profile_out, io, "render_llvm_module");
    var module = try render_llvm_module(
        allocator,
        &lookup_index,
        ir_bytes,
        ir_path,
        &backend_profile,
        &var profile_out,
        io
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "render_llvm_module",
        render_module_started
    );
    let module_view = module.as_bytes();
    let write_module_started =
        try profile::begin(&backend_profile, &var profile_out, io, "write_llvm_module");
    let module_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.ll",
        module_view,
        module.len()
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "write_llvm_module",
        write_module_started
    );
    module.deinit();

    let render_metadata_started =
        try profile::begin(&backend_profile, &var profile_out, io, "render_llvm_metadata");
    var metadata = try render_llvm_metadata(allocator, ir_bytes, ir_path, manifest_path);
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "render_llvm_metadata",
        render_metadata_started
    );
    let metadata_view = metadata.as_bytes();
    let write_metadata_started =
        try profile::begin(&backend_profile, &var profile_out, io, "write_llvm_metadata");
    let metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.ll.meta",
        metadata_view,
        metadata.len()
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "write_llvm_metadata",
        write_metadata_started
    );
    metadata.deinit();

    let load_storage_started =
        try profile::begin(&backend_profile, &var profile_out, io, "load_storage_module");
    let storage = try runtime::load_storage_module(io);
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "load_storage_module",
        load_storage_started
    );
    let write_storage_started =
        try profile::begin(&backend_profile, &var profile_out, io, "write_storage_module");
    let storage_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.storage.ll",
        storage,
        std::mem::len(storage)
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "write_storage_module",
        write_storage_started
    );

    let render_storage_metadata_started = try profile::begin(
        &backend_profile,
        &var profile_out,
        io,
        "render_storage_metadata"
    );
    var storage_metadata = try runtime::render_storage_metadata(
        allocator,
        io,
        ir_path,
        manifest_path
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "render_storage_metadata",
        render_storage_metadata_started
    );
    let storage_metadata_view = storage_metadata.as_bytes();
    let write_storage_metadata_started = try profile::begin(
        &backend_profile,
        &var profile_out,
        io,
        "write_storage_metadata"
    );
    let storage_metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.storage.ll.meta",
        storage_metadata_view,
        storage_metadata.len()
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "write_storage_metadata",
        write_storage_metadata_started
    );
    storage_metadata.deinit();

    let load_host_started =
        try profile::begin(&backend_profile, &var profile_out, io, "load_host_module");
    let host = try runtime::load_host_module(io);
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "load_host_module",
        load_host_started
    );
    let write_host_started =
        try profile::begin(&backend_profile, &var profile_out, io, "write_host_module");
    let host_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.host.ll",
        host,
        std::mem::len(host)
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "write_host_module",
        write_host_started
    );

    let render_host_metadata_started =
        try profile::begin(&backend_profile, &var profile_out, io, "render_host_metadata");
    var host_metadata = try runtime::render_host_metadata(
        allocator,
        io,
        ir_path,
        manifest_path
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "render_host_metadata",
        render_host_metadata_started
    );
    let host_metadata_view = host_metadata.as_bytes();
    let write_host_metadata_started =
        try profile::begin(&backend_profile, &var profile_out, io, "write_host_metadata");
    let host_metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/selfhost.host.ll.meta",
        host_metadata_view,
        host_metadata.len()
    );
    try profile::end(
        &backend_profile,
        &var profile_out,
        io,
        "write_host_metadata",
        write_host_metadata_started
    );
    host_metadata.deinit();
    try profile::finish(&backend_profile, &var profile_out, io);

    return data::LlvmArtifact {
        ll_path: "target/selfhost/selfhost.ll",
        metadata_path: "target/selfhost/selfhost.ll.meta",
        storage_path: "target/selfhost/selfhost.storage.ll",
        storage_metadata_path: "target/selfhost/selfhost.storage.ll.meta",
        host_path: "target/selfhost/selfhost.host.ll",
        host_metadata_path: "target/selfhost/selfhost.host.ll.meta",
        bytes: module_len,
        metadata_bytes: metadata_len,
        storage_bytes: storage_len,
        storage_metadata_bytes: storage_metadata_len,
        host_bytes: host_len,
        host_metadata_bytes: host_metadata_len
    };
}

fn record_ir_fact_profile_metrics(
    backend_profile: &profile::Profile,
    profile_out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.body_node.entries",
        "ir.fact.body_node.line_bytes",
        "body-node "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.body_edge.entries",
        "ir.fact.body_edge.line_bytes",
        "body-edge "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.body_call.entries",
        "ir.fact.body_call.line_bytes",
        "body-call "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.body_token.entries",
        "ir.fact.body_token.line_bytes",
        "body-token "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.function_signature_param.entries",
        "ir.fact.function_signature_param.line_bytes",
        "function-signature-param "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.function_return.entries",
        "ir.fact.function_return.line_bytes",
        "function-return "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.struct_field.entries",
        "ir.fact.struct_field.line_bytes",
        "struct-field "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.type_llvm.entries",
        "ir.fact.type_llvm.line_bytes",
        "type-llvm "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.enum_variant.entries",
        "ir.fact.enum_variant.line_bytes",
        "enum-variant "
    );
    try record_fact_prefix_metrics(
        backend_profile,
        profile_out,
        lookup_index,
        ir_bytes,
        "ir.fact.union_variant.entries",
        "ir.fact.union_variant.line_bytes",
        "union-variant "
    );
    return;
}

fn record_fact_prefix_metrics(
    backend_profile: &profile::Profile,
    profile_out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    entries_key: []u8,
    bytes_key: []u8,
    fact_prefix: []u8
) -> !void {
    try profile::record_i64(
        backend_profile,
        profile_out,
        entries_key,
        ir_index::fact_prefix_entry_count(lookup_index, ir_bytes, fact_prefix)
    );

    try profile::record_i64(
        backend_profile,
        profile_out,
        bytes_key,
        ir_index::fact_prefix_line_bytes(lookup_index, ir_bytes, fact_prefix)
    );
    return;
}

fn validate_ir_artifact(bytes: []u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-v0") {
        return error("invalid IR artifact");
    }
    if !ir_contract::contains(bytes, "package selfhost") {
        return error("unsupported IR artifact package");
    }
    try ir_contract::require_fact(bytes, "ir-contract selfhost-checked-package-v1");
    try ir_contract::require_fact(bytes, "checked-entry selfhost::cli_main");
    try ir_contract::require_fact(bytes, "hosted-entry @kizu_selfhost__cli_main");
    try ir_contract::require_fact(bytes, "hosted-smoke @kizu_selfhost__smoke");
    try ir_contract::require_fact(
        bytes,
        "executable-contract-source data selfhost::backend::data"
    );
    try ir_contract::require_fact(
        bytes,
        "executable-contract-source lowering selfhost::backend::executable"
    );
    try external_abi_validation::require_manifest_roots(bytes);
    try require_selected_executable_body_ir(bytes);
    try require_selected_executable_body_parsing(bytes);
    try ir_contract::require_fact(bytes, "frontend-executable-lowering checked-body-ir");
    try ir_contract::require_fact(bytes, "hosted-executable-abi executable-result-layout-v1");
    try ir_contract::require_fact(bytes, "executable-layout kind:i64 callee:[]u8 payload:[]u8");
    try require_executable_tag_layout();
    try ir_contract::require_fact(bytes, "checked-diagnostics 0");
    return;
}

fn require_selected_executable_body_ir(bytes: []u8) -> !void {
    try require_metadata_line_body(bytes);
    try ir_contract::require_body_call(
        bytes,
        "selfhost::backend::executable::lower_test_executable",
        "executable_lowering::lower_test_executable"
    );
    return;
}

fn require_metadata_line_body(bytes: []u8) -> !void {
    let function_name = "selfhost::ir::codegen::metadata_line";
    let statement = try ir_contract::body_child_sequence(bytes, function_name, 0, "statement", 0);
    let statement_kind = try ir_contract::body_node_kind(bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("invalid metadata line body");
    }
    let value = try ir_contract::body_child_sequence(bytes, function_name, statement, "value", 0);
    let value_kind = try ir_contract::body_node_kind(bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "String") {
        return error("invalid metadata line body");
    }
    let token = try ir_contract::body_token_or_empty(bytes, function_name, value);
    if std::mem::len(token) < 2 {
        return error("invalid metadata line body");
    }
    return;
}

fn require_selected_executable_body_parsing(bytes: []u8) -> !void {
    return;
}

fn validate_shape_manifest(bytes: []u8) -> !void {
    if !std::mem::starts_with(bytes, "kizu-ir-shape-v0") {
        return error("invalid IR shape manifest");
    }
    try require_shape(bytes, "manifest-version selfhost-abi-v0");
    try require_shape(bytes, "node-kind function");
    try require_shape(bytes, "node-kind block");
    try require_shape(bytes, "node-kind diagnostic");
    try require_shape(bytes, "value-type i64");
    try require_shape(bytes, "value-type bool");
    try require_shape(bytes, "value-type []u8");
    try require_shape(bytes, "value-type record");
    try require_shape(bytes, "value-type error-union");
    try require_shape(bytes, "value-type handle");
    try require_shape(bytes, "storage local");
    try require_shape(bytes, "storage owned-container");
    try require_shape(bytes, "storage borrowed-view");
    try require_shape(bytes, "storage arena");
    try require_shape(bytes, "storage handle");
    try require_shape(bytes, "call direct");
    try require_shape(bytes, "call direct-record-roundtrip");
    try require_shape(bytes, "call std-primitive");
    try require_shape(bytes, "cleanup deinit");
    try require_shape(bytes, "host-capabilities selfhost-host-v0");
    try require_shape(bytes, "external std::mem::page_allocator");
    try require_shape(bytes, "external std::fs::exists");
    try require_shape(bytes, "external std::fs::metadata");
    try require_shape(bytes, "external std::fs::read_dir");
    try require_shape(bytes, "external std::fs::read_file");
    try require_shape(bytes, "external std::fs::write_file");
    try require_shape(bytes, "external std::fs::rename");
    try require_shape(bytes, "external std::fs::create_dir");
    try require_shape(bytes, "external std::io::blocking");
    try require_shape(bytes, "external std::io::write_stdout");
    try require_shape(bytes, "external std::io::write_stderr");
    try require_shape(bytes, "external std::process::arg_count");
    try require_shape(bytes, "external std::process::arg");
    try require_shape(bytes, "external std::process::env");
    try require_shape(bytes, "external std::process::env_or_empty");
    try require_shape(bytes, "external std::process::monotonic_millis");
    try require_shape(bytes, "external std::process::exit_code");
    try require_shape(bytes, "manifest-complete selfhost-abi-v0");
    return;
}

fn require_shape(bytes: []u8, shape: []u8) -> !void {
    if !ir_contract::contains(bytes, shape) {
        return error("unsupported IR shape manifest");
    }
    return;
}

fn write_backend_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_llvm_module(
    allocator: Allocator,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    ir_path: []u8,
    backend_profile: &profile::Profile,
    profile_out: &var std::string::String,
    io: Io
) -> !std::string::String {
    var out = std::string::String(allocator);
    try out.reserve(std::mem::len(ir_bytes) / 3);
    let preamble_started =
        try profile::begin(backend_profile, profile_out, io, "render_module_preamble");
    try append_line(out, "; kizu selfhost bootstrap ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(ir_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try compiled_runtime_declarations::append_foundation_types(out);
    // kizu.rt.array mirrors the runtime storage Array<T> record layout
    // { allocator, data, len, capacity, element_size }; the read-only Ast.len
    // accessor reads its len field (index 2) through the array_len builtin
    // (tracker 961).
    try append_line(out,
        "%kizu.rt.array = type { ptr, ptr, i64, i64, i64 }");
    // kizu.rt.string mirrors the runtime storage std::string::String record layout
    // { allocator, data, len, capacity }; the compiled artifact_path String builder
    // reads and grows it through the @kizu_rt_string_* helpers below (issue 1165 slice
    // 1). The hosted compiler module carries its own self-contained copy (it never
    // links the storage module), the same split used for %kizu.rt.array.
    try append_line(out,
        "%kizu.rt.string = type { ptr, ptr, i64, i64 }");
    // kizu.rt.map / kizu.rt.map.entry mirror the runtime storage std::map::Map record layouts.
    // The compiled type checker, resolver, and ownership passes key their tables by Map, so the
    // hosted module carries the map runtime too -- copied from the storage module rather than
    // hand-rendered like the array/string/arena helpers above.
    try append_line(out,
        "%kizu.rt.map = type { ptr, ptr, i64, i64, i64 }");
    try append_line(out,
        "%kizu.rt.map.entry = type { ptr, i64, ptr }");
    // Reachable Kizu function facts now own source-defined nominal and error-union
    // declarations. The registry is seeded from the remaining ABI foundation
    // above, so matching declarations dedupe and conflicting layouts fail.
    try compiled_type_declarations::append_reachable_fact_declarations_indexed(
        out, lookup_index, ir_bytes
    );
    try append_line(out, "");
    try cli_llvm::append_globals(out, ir_bytes);
    try append_line(out, "");
    try compiled_runtime_declarations::append_linked_host_externals(out);
    try compiled_run_entry_llvm::append_host_declarations(out);
    try append_line(out,
        "declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1 immarg)");
    try append_line(out, "declare i64 @kizu_selfhost__runtime_storage_smoke()");
    try append_line(out, "declare i64 @kizu_selfhost__host_capability_smoke()");
    try append_line(out, "");
    // array_len is the Array<T> length builtin backing the read-only
    // std::kizu::ast::Ast.len accessor compiled into stage2 (tracker 961). The
    // runtime storage module owns the canonical definition; the hosted compiler
    // module carries its own self-contained copy (it never links the storage
    // module), reading the len field (index 2) out of the %kizu.owned-wrapped
    // %kizu.rt.array record. AstNode/AstData union access, Arena.get, and
    // array_get remain out of scope.
    try append_line(out, "define i64 @kizu_rt_array_len(%kizu.owned %array) {");
    try append_line(out, "entry:");
    try append_line(out, "  %raw = extractvalue %kizu.owned %array, 0");
    try append_line(out,
        "  %len_field = getelementptr inbounds %kizu.rt.array, ptr %raw, i32 0, i32 2");
    try append_line(out, "  %len = load i64, ptr %len_field");
    try append_line(out, "  ret i64 %len");
    try append_line(out, "}");
    try append_line(out, "");
    // The array bounds message global backs the @kizu_rt_array_at failure path; the
    // hosted compiler module carries its own self-contained copy (tracker 961).
    try out.append_bytes(
        "@.kizu.rt.array_index_out_of_bounds = private unnamed_addr constant [25 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("array index out of bounds");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    // The empty-array message global backs the @kizu_rt_array_pop failure path, the checked
    // twin of pop_or_panic: draining a loop's Array is an ordinary '!T' failure, not a trap.
    try out.append_bytes(
        "@.kizu.rt.array_pop_empty = private unnamed_addr constant [20 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("pop from empty array");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try out.append_bytes(
        "@.kizu.rt.arena_invalid_handle = private unnamed_addr constant [20 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("invalid arena handle");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    // array_at is the checked Array<T> element accessor backing the read-only
    // Diagnostic.related_get accessor compiled into stage2 (Array<T>.get -> !T,
    // tracker 961). The runtime storage module owns the canonical definition; the
    // hosted compiler module carries its own self-contained copy (it never links the
    // storage module). It returns a borrowed view of the element as a
    // %kizu.error.slice.u8 (ok flag, element view slice {ptr,element_size}, error
    // message); out-of-bounds or unset storage returns the failure message.
    try append_line(out,
