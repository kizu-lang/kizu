fn append_hosted_common_metadata(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let function_name = "selfhost::backend::hosted::append_common_metadata";
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-abi-line ",
        function_name
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-entry-prefix ",
        function_name
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-runtime-line ",
        function_name
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-lowering-line ",
        function_name
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-fallback-line ",
        function_name
    );
    try append_backend_input_named_fact(
        out,
        ir_bytes,
        "hosted-artifact-metadata-mode-line ",
        function_name
    );
    return;
}

fn append_selected_hosted_executable_lowering_metadata(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_hosted_executable_lowering_metadata(
        out,
        ir_bytes,
        "selfhost::backend::hosted::lower_run_hosted_executable"
    );
    try append_hosted_executable_lowering_metadata(
        out,
        ir_bytes,
        "selfhost::backend::hosted::lower_test_hosted_executable"
    );
    return;
}

fn append_hosted_executable_lowering_metadata(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let count = try hosted_lowering_case_count(ir_bytes, function_name);
    var index = 0;
    while index < count {
        try append_hosted_executable_lowering_case_metadata(
            out,
            ir_bytes,
            function_name,
            index
        );
        index = index + 1;
    }
    return;
}

fn append_hosted_executable_lowering_case_metadata(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> !void {
    try append_backend_input_sequence_fact(
        out,
        ir_bytes,
        "hosted-lowering-case-kind ",
        function_name,
        index
    );
    try append_backend_input_sequence_line_fact(
        out,
        ir_bytes,
        "hosted-lowering-case-comment-llvm ",
        function_name,
        index
    );
    try append_backend_input_sequence_fact(
        out,
        ir_bytes,
        "hosted-lowering-case-entry ",
        function_name,
        index
    );
    try append_backend_input_sequence_fact(
        out,
        ir_bytes,
        "hosted-lowering-case-global ",
        function_name,
        index
    );
    try append_backend_input_sequence_fact(
        out,
        ir_bytes,
        "hosted-lowering-case-stream ",
        function_name,
        index
    );
    try append_backend_input_sequence_fact(
        out,
        ir_bytes,
        "hosted-lowering-case-newline ",
        function_name,
        index
    );
    try append_backend_input_sequence_fact(
        out,
        ir_bytes,
        "hosted-lowering-case-exit ",
        function_name,
        index
    );
    try append_backend_input_sequence_fact(
        out,
        ir_bytes,
        "hosted-lowering-case-payload ",
        function_name,
        index
    );
    if std::mem::equal_bytes(
        try ir_contract::sequence_fact_value(
            ir_bytes,
            "hosted-lowering-case-payload ",
            function_name,
            index
        ),
        "literal"
    ) {
        try append_backend_input_sequence_line_fact(
            out,
            ir_bytes,
            "hosted-lowering-case-payload-llvm ",
            function_name,
            index
        );
    }
    return;
}

fn append_backend_input_i64_fact(
    out: &var std::string::String,
    ir_bytes: []u8,
    prefix: []u8,
    name: []u8
) -> !void {
    let value = try ir_contract::named_i64_fact(ir_bytes, prefix, name);
    try out.append_bytes("backend-input ");
    try out.append_bytes(prefix);
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_backend_input_named_fact(
    out: &var std::string::String,
    ir_bytes: []u8,
    prefix: []u8,
    name: []u8
) -> !void {
    let value = try ir_contract::named_fact_value(ir_bytes, prefix, name);
    try out.append_bytes("backend-input ");
    try out.append_bytes(prefix);
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_backend_input_sequence_fact(
    out: &var std::string::String,
    ir_bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64
) -> !void {
    let value = try ir_contract::sequence_fact_value(ir_bytes, prefix, name, sequence);
    try out.append_bytes("backend-input ");
    try out.append_bytes(prefix);
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, sequence);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_backend_input_sequence_line_fact(
    out: &var std::string::String,
    ir_bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64
) -> !void {
    let value = try ir_contract::sequence_fact_value(ir_bytes, prefix, name, sequence);
    try out.append_bytes("backend-input ");
    try out.append_bytes(prefix);
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, sequence);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_key_value(
    out: &var std::string::String,
    key: []u8,
    value: []u8
) -> !void {
    try out.append_bytes(key);
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
