    try append_line(out, "  %index = extractvalue %kizu.handle %handle, 1");
    try append_line(out,
        "  %data_field = getelementptr inbounds %kizu.rt.array, ptr %raw, i32 0, i32 1");
    try append_line(out, "  %data = load ptr, ptr %data_field");
    try append_line(out,
        "  %len_field = getelementptr inbounds %kizu.rt.array, ptr %raw, i32 0, i32 2");
    try append_line(out, "  %len = load i64, ptr %len_field");
    try append_line(out,
        "  %element_size_field = getelementptr inbounds %kizu.rt.array, ptr %raw, i32 0, i32 4");
    try append_line(out, "  %element_size = load i64, ptr %element_size_field");
    try append_line(out, "  %index_nonnegative = icmp sge i64 %index, 0");
    try append_line(out, "  %index_in_bounds = icmp slt i64 %index, %len");
    try append_line(out, "  %data_ok = icmp ne ptr %data, null");
    try append_line(out, "  %provenance_ok = and i1 %same_arena, %index_nonnegative");
    try append_line(out, "  %bounds_ok = and i1 %provenance_ok, %index_in_bounds");
    try append_line(out, "  %ok = and i1 %bounds_ok, %data_ok");
    try append_line(out, "  br i1 %ok, label %valid, label %invalid");
    try append_line(out, "valid:");
    try append_line(out, "  %offset = mul i64 %index, %element_size");
    try append_line(out, "  %element_ptr = getelementptr i8, ptr %data, i64 %offset");
    try append_line(out, "  %slice_base = insertvalue %kizu.slice.u8 poison, ptr %element_ptr, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %slice_base, i64 %element_size, 1");
    try append_line(out, "  %valid_ok = insertvalue %kizu.error.slice.u8 poison, i1 true, 0");
    try append_line(out,
        "  %valid_value = insertvalue %kizu.error.slice.u8 %valid_ok, %kizu.slice.u8 %slice, 1");
    try append_line(out,
        "  %valid_result = insertvalue %kizu.error.slice.u8 %valid_value, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.slice.u8 %valid_result");
    try append_line(out, "invalid:");
    try append_line(out,
        "  %message_ptr = getelementptr inbounds [20 x i8], ptr @.kizu.rt.arena_invalid_handle, i64 0, i64 0");
    try append_line(out, "  %message_base = insertvalue %kizu.slice.u8 poison, ptr %message_ptr, 0");
    try append_line(out, "  %message = insertvalue %kizu.slice.u8 %message_base, i64 20, 1");
    try append_line(out, "  %invalid_ok = insertvalue %kizu.error.slice.u8 poison, i1 false, 0");
    try append_line(out,
        "  %invalid_value = insertvalue %kizu.error.slice.u8 %invalid_ok, %kizu.slice.u8 zeroinitializer, 1");
    try append_line(out,
        "  %invalid_result = insertvalue %kizu.error.slice.u8 %invalid_value, %kizu.slice.u8 %message, 2");
    try append_line(out, "  ret %kizu.error.slice.u8 %invalid_result");
    try append_line(out, "}");
    try append_line(out, "");
    try runtime::append_hosted_map_runtime(out, io);
    try append_line(out, "");
    try profile::end(
        backend_profile,
        profile_out,
        io,
        "render_module_preamble",
        preamble_started
    );
    let string_runtime_started =
        try profile::begin(backend_profile, profile_out, io, "render_string_runtime");
    try append_string_runtime(out);
    try profile::end(
        backend_profile,
        profile_out,
        io,
        "render_string_runtime",
        string_runtime_started
    );
    let append_functions_started =
        try profile::begin(backend_profile, profile_out, io, "append_functions");
    try cli_llvm::append_functions(
        out,
        lookup_index,
        ir_bytes,
        backend_profile,
        profile_out,
        io
    );
    try profile::end(
        backend_profile,
        profile_out,
        io,
        "append_functions",
        append_functions_started
    );
    let smoke_started =
        try profile::begin(backend_profile, profile_out, io, "render_smoke_function");
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_selfhost__smoke() {");
    try append_line(out, "entry:");
    try append_line(out, "  ret i64 0");
    try append_line(out, "}");
    try profile::end(
        backend_profile,
        profile_out,
        io,
        "render_smoke_function",
        smoke_started
    );
    return out;
}

// append_string_runtime emits the self-contained std::string::String runtime helpers
// the compiled artifact_path builder calls (issue 1165 slice 1). The hosted compiler
// module never links the runtime storage module, so it carries its own copy of the
// @kizu_rt_string_* helpers and their two diagnostic message globals, the same
// declare-here-define-locally split used for @kizu_rt_array_at / @kizu_rt_arena_get.
// The String value is the %kizu.owned-wrapped %kizu.rt.string record
// { allocator, data, len, capacity }; append grows the buffer through @kizu_rt_alloc
// and copies the existing bytes, mirroring the storage module definitions exactly.
fn append_string_runtime(out: &var std::string::String) -> !void {
    try out.append_bytes(
        "@.kizu.rt.allocation_failed = private unnamed_addr constant [17 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("allocation failed");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try out.append_bytes(
        "@.kizu.rt.invalid_slice = private unnamed_addr constant [13 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("invalid slice");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try out.append_bytes(
        "@.kizu.rt.string_reserve_negative = private unnamed_addr constant [39 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("String.reserve expects non-negative i64");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "define %kizu.owned @kizu_rt_string_new(%kizu.owned %allocator) {");
    try append_line(out, "entry:");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %raw = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 32)");
    try append_line(out,
        "  %allocator_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 0");
    try append_line(out, "  store ptr %allocator_ptr, ptr %allocator_field");
    try append_line(out,
        "  %data_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 1");
    try append_line(out, "  store ptr null, ptr %data_field");
    try append_line(out,
        "  %len_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 2");
    try append_line(out, "  store i64 0, ptr %len_field");
    try append_line(out,
        "  %cap_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 3");
    try append_line(out, "  store i64 0, ptr %cap_field");
    try append_line(out, "  %handle = insertvalue %kizu.owned poison, ptr %raw, 0");
    try append_line(out, "  ret %kizu.owned %handle");
    try append_line(out, "}");
    try append_line(out, "");
    try append_line(out,
        "define %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %string, %kizu.slice.u8 %bytes) {");
    try append_line(out, "entry:");
    try append_line(out, "  %byte_ptr = extractvalue %kizu.slice.u8 %bytes, 0");
    try append_line(out, "  %byte_len = extractvalue %kizu.slice.u8 %bytes, 1");
    try append_line(out, "  %len_negative = icmp slt i64 %byte_len, 0");
    try append_line(out, "  br i1 %len_negative, label %invalid_slice, label %valid_length");
    try append_line(out, "valid_length:");
    try append_line(out, "  %has_bytes = icmp sgt i64 %byte_len, 0");
    try append_line(out, "  br i1 %has_bytes, label %validate_ptr, label %empty");
    try append_line(out, "empty:");
    try append_line(out, "  ret %kizu.error.void { i1 true, %kizu.slice.u8 zeroinitializer }");
    try append_line(out, "validate_ptr:");
    try append_line(out, "  %ptr_ok = icmp ne ptr %byte_ptr, null");
    try append_line(out, "  br i1 %ptr_ok, label %append, label %invalid_slice");
    try append_line(out, "append:");
    try append_line(out, "  %raw = extractvalue %kizu.owned %string, 0");
    try append_line(out,
        "  %allocator_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 0");
    try append_line(out, "  %allocator_ptr = load ptr, ptr %allocator_field");
    try append_line(out,
        "  %data_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 1");
    try append_line(out, "  %current_data = load ptr, ptr %data_field");
    try append_line(out,
        "  %len_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 2");
    try append_line(out, "  %current = load i64, ptr %len_field");
    try append_line(out, "  %current_valid = icmp sge i64 %current, 0");
    try append_line(out,
        "  %cap_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 3");
    try append_line(out, "  %current_cap = load i64, ptr %cap_field");
    try append_line(out, "  %cap_valid = icmp sge i64 %current_cap, 0");
    try append_line(out, "  %storage_valid = and i1 %current_valid, %cap_valid");
    try append_line(out, "  br i1 %storage_valid, label %length_check, label %invalid_slice");
    try append_line(out, "length_check:");
    try append_line(out, "  %max_delta = sub i64 9223372036854775807, %current");
    try append_line(out, "  %fits = icmp sle i64 %byte_len, %max_delta");
    try append_line(out, "  br i1 %fits, label %capacity_check, label %invalid_slice");
    try append_line(out, "capacity_check:");
    try append_line(out, "  %next = add i64 %current, %byte_len");
    try append_line(out, "  %within_capacity = icmp sle i64 %next, %current_cap");
    try append_line(out, "  %data_ok = icmp ne ptr %current_data, null");
    try append_line(out, "  %copy_in_place = and i1 %within_capacity, %data_ok");
    try append_line(out, "  br i1 %copy_in_place, label %copy_new_in_place, label %allocate");
    try append_line(out, "copy_new_in_place:");
    try append_line(out, "  %in_place_dest = getelementptr i8, ptr %current_data, i64 %current");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %in_place_dest, ptr %byte_ptr, i64 %byte_len, i1 false)");
    try append_line(out, "  store i64 %next, ptr %len_field");
    try append_line(out,
        "  ret %kizu.error.void { i1 true, %kizu.slice.u8 zeroinitializer }");
    try append_line(out, "allocate:");
    try append_line(out, "  %new_data = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %next)");
    try append_line(out, "  %allocated = icmp ne ptr %new_data, null");
    try append_line(out, "  br i1 %allocated, label %copy_old_check, label %allocation_failed");
    try append_line(out, "copy_old_check:");
    try append_line(out, "  %has_old = icmp sgt i64 %current, 0");
    try append_line(out, "  br i1 %has_old, label %copy_old, label %copy_new");
    try append_line(out, "copy_old:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %new_data, ptr %current_data, i64 %current, i1 false)");
    try append_line(out, "  br label %copy_new");
    try append_line(out, "copy_new:");
    try append_line(out, "  %dest = getelementptr i8, ptr %new_data, i64 %current");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %dest, ptr %byte_ptr, i64 %byte_len, i1 false)");
    try append_line(out, "  %has_old_data = icmp ne ptr %current_data, null");
    try append_line(out, "  br i1 %has_old_data, label %free_old, label %store");
    try append_line(out, "free_old:");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %current_data)");
    try append_line(out, "  br label %store");
    try append_line(out, "store:");
    try append_line(out, "  store ptr %new_data, ptr %data_field");
    try append_line(out, "  store i64 %next, ptr %len_field");
    try append_line(out, "  store i64 %next, ptr %cap_field");
    try append_line(out, "  ret %kizu.error.void { i1 true, %kizu.slice.u8 zeroinitializer }");
    try append_line(out, "allocation_failed:");
    try append_line(out,
        "  %message_ptr = getelementptr inbounds [17 x i8], ptr @.kizu.rt.allocation_failed, i64 0, i64 0");
    try append_line(out, "  %message_base = insertvalue %kizu.slice.u8 poison, ptr %message_ptr, 0");
    try append_line(out, "  %message = insertvalue %kizu.slice.u8 %message_base, i64 17, 1");
    try append_line(out, "  %failed_base = insertvalue %kizu.error.void poison, i1 false, 0");
    try append_line(out,
        "  %failed = insertvalue %kizu.error.void %failed_base, %kizu.slice.u8 %message, 1");
    try append_line(out, "  ret %kizu.error.void %failed");
    try append_line(out, "invalid_slice:");
    try append_line(out,
        "  %invalid_message_ptr = getelementptr inbounds [13 x i8], ptr @.kizu.rt.invalid_slice, i64 0, i64 0");
    try append_line(out,
        "  %invalid_message_base = insertvalue %kizu.slice.u8 poison, ptr %invalid_message_ptr, 0");
    try append_line(out,
        "  %invalid_message = insertvalue %kizu.slice.u8 %invalid_message_base, i64 13, 1");
    try append_line(out, "  %invalid_base = insertvalue %kizu.error.void poison, i1 false, 0");
    try append_line(out,
        "  %invalid_result = insertvalue %kizu.error.void %invalid_base, %kizu.slice.u8 %invalid_message, 1");
    try append_line(out, "  ret %kizu.error.void %invalid_result");
    try append_line(out, "}");
    try append_line(out, "");
    try append_line(out,
        "define %kizu.error.void @kizu_rt_string_reserve(%kizu.owned %string, i64 %additional) {");
    try append_line(out, "entry:");
    try append_line(out, "  %additional_nonnegative = icmp sge i64 %additional, 0");
    try append_line(out, "  br i1 %additional_nonnegative, label %load, label %negative");
    try append_line(out, "load:");
    try append_line(out, "  %raw = extractvalue %kizu.owned %string, 0");
    try append_line(out,
        "  %allocator_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 0");
    try append_line(out, "  %allocator_ptr = load ptr, ptr %allocator_field");
    try append_line(out,
        "  %data_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 1");
    try append_line(out, "  %current_data = load ptr, ptr %data_field");
    try append_line(out,
        "  %len_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 2");
    try append_line(out, "  %current = load i64, ptr %len_field");
    try append_line(out,
        "  %cap_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 3");
    try append_line(out, "  %current_cap = load i64, ptr %cap_field");
    try append_line(out, "  %current_valid = icmp sge i64 %current, 0");
    try append_line(out, "  %cap_valid = icmp sge i64 %current_cap, 0");
    try append_line(out, "  %storage_valid = and i1 %current_valid, %cap_valid");
    try append_line(out, "  br i1 %storage_valid, label %overflow_check, label %invalid_slice");
    try append_line(out, "overflow_check:");
    try append_line(out, "  %max_delta = sub i64 9223372036854775807, %current");
    try append_line(out, "  %fits = icmp sle i64 %additional, %max_delta");
    try append_line(out, "  br i1 %fits, label %want_check, label %invalid_slice");
    try append_line(out, "want_check:");
    try append_line(out, "  %want = add i64 %current, %additional");
    try append_line(out, "  %already_reserved = icmp sle i64 %want, %current_cap");
    try append_line(out, "  br i1 %already_reserved, label %ok, label %select_start");
    try append_line(out, "select_start:");
    try append_line(out, "  %cap_zero = icmp eq i64 %current_cap, 0");
    try append_line(out, "  br i1 %cap_zero, label %grow_from_four, label %grow_loop");
    try append_line(out, "grow_from_four:");
    try append_line(out, "  br label %grow_loop");
    try append_line(out, "grow_loop:");
    try append_line(out,
        "  %candidate = phi i64 [ %current_cap, %select_start ], [ 4, %grow_from_four ], [ %doubled, %double ]");
    try append_line(out, "  %enough = icmp sge i64 %candidate, %want");
    try append_line(out, "  br i1 %enough, label %allocate, label %grow_check");
    try append_line(out, "grow_check:");
    try append_line(out, "  %can_double = icmp sle i64 %candidate, 4611686018427387903");
    try append_line(out, "  br i1 %can_double, label %double, label %invalid_slice");
    try append_line(out, "double:");
    try append_line(out, "  %doubled = mul i64 %candidate, 2");
    try append_line(out, "  br label %grow_loop");
    try append_line(out, "allocate:");
    try append_line(out, "  %new_data = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %candidate)");
    try append_line(out, "  %allocated = icmp ne ptr %new_data, null");
    try append_line(out, "  br i1 %allocated, label %copy_old_check, label %allocation_failed");
    try append_line(out, "copy_old_check:");
    try append_line(out, "  %has_old = icmp sgt i64 %current, 0");
    try append_line(out, "  br i1 %has_old, label %copy_old, label %free_old_check");
    try append_line(out, "copy_old:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %new_data, ptr %current_data, i64 %current, i1 false)");
    try append_line(out, "  br label %free_old_check");
    try append_line(out, "free_old_check:");
    try append_line(out, "  %has_old_data = icmp ne ptr %current_data, null");
    try append_line(out, "  br i1 %has_old_data, label %free_old, label %store");
    try append_line(out, "free_old:");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %current_data)");
    try append_line(out, "  br label %store");
    try append_line(out, "store:");
    try append_line(out, "  store ptr %new_data, ptr %data_field");
    try append_line(out, "  store i64 %candidate, ptr %cap_field");
    try append_line(out, "  br label %ok");
    try append_line(out, "ok:");
    try append_line(out, "  ret %kizu.error.void { i1 true, %kizu.slice.u8 zeroinitializer }");
    try append_line(out, "negative:");
    try append_line(out,
        "  %negative_message_ptr = getelementptr inbounds [39 x i8], ptr @.kizu.rt.string_reserve_negative, i64 0, i64 0");
    try append_line(out,
        "  %negative_message_base = insertvalue %kizu.slice.u8 poison, ptr %negative_message_ptr, 0");
    try append_line(out,
        "  %negative_message = insertvalue %kizu.slice.u8 %negative_message_base, i64 39, 1");
    try append_line(out, "  %negative_base = insertvalue %kizu.error.void poison, i1 false, 0");
    try append_line(out,
        "  %negative_result = insertvalue %kizu.error.void %negative_base, %kizu.slice.u8 %negative_message, 1");
    try append_line(out, "  ret %kizu.error.void %negative_result");
    try append_line(out, "allocation_failed:");
    try append_line(out,
        "  %message_ptr = getelementptr inbounds [17 x i8], ptr @.kizu.rt.allocation_failed, i64 0, i64 0");
    try append_line(out, "  %message_base = insertvalue %kizu.slice.u8 poison, ptr %message_ptr, 0");
    try append_line(out, "  %message = insertvalue %kizu.slice.u8 %message_base, i64 17, 1");
    try append_line(out, "  %failed_base = insertvalue %kizu.error.void poison, i1 false, 0");
    try append_line(out,
        "  %failed = insertvalue %kizu.error.void %failed_base, %kizu.slice.u8 %message, 1");
    try append_line(out, "  ret %kizu.error.void %failed");
    try append_line(out, "invalid_slice:");
    try append_line(out,
        "  %invalid_message_ptr = getelementptr inbounds [13 x i8], ptr @.kizu.rt.invalid_slice, i64 0, i64 0");
    try append_line(out,
        "  %invalid_message_base = insertvalue %kizu.slice.u8 poison, ptr %invalid_message_ptr, 0");
    try append_line(out,
        "  %invalid_message = insertvalue %kizu.slice.u8 %invalid_message_base, i64 13, 1");
    try append_line(out, "  %invalid_base = insertvalue %kizu.error.void poison, i1 false, 0");
    try append_line(out,
        "  %invalid_result = insertvalue %kizu.error.void %invalid_base, %kizu.slice.u8 %invalid_message, 1");
    try append_line(out, "  ret %kizu.error.void %invalid_result");
    try append_line(out, "}");
    try append_line(out, "");
    try append_line(out,
        "define %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned %string, i8 %byte) {");
    try append_line(out, "entry:");
    try append_line(out, "  %slot = alloca i8");
    try append_line(out, "  store i8 %byte, ptr %slot");
    try append_line(out, "  %slice_base = insertvalue %kizu.slice.u8 poison, ptr %slot, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %slice_base, i64 1, 1");
    try append_line(out,
        "  %result = call %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned %string, %kizu.slice.u8 %slice)");
    try append_line(out, "  ret %kizu.error.void %result");
    try append_line(out, "}");
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_rt_string_len(%kizu.owned %string) {");
    try append_line(out, "entry:");
    try append_line(out, "  %raw = extractvalue %kizu.owned %string, 0");
    try append_line(out,
        "  %len_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 2");
    try append_line(out, "  %len = load i64, ptr %len_field");
    try append_line(out, "  ret i64 %len");
    try append_line(out, "}");
    try append_line(out, "");
    try append_line(out, "define %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %string) {");
    try append_line(out, "entry:");
    try append_line(out, "  %raw = extractvalue %kizu.owned %string, 0");
    try append_line(out,
        "  %data_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 1");
    try append_line(out, "  %data = load ptr, ptr %data_field");
    try append_line(out,
        "  %len_field = getelementptr inbounds %kizu.rt.string, ptr %raw, i32 0, i32 2");
    try append_line(out, "  %len = load i64, ptr %len_field");
    try append_line(out, "  %slice_base = insertvalue %kizu.slice.u8 poison, ptr %data, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %slice_base, i64 %len, 1");
    try append_line(out, "  ret %kizu.slice.u8 %slice");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn render_llvm_metadata(
    allocator: Allocator,
    ir_bytes: []u8,
    ir_path: []u8,
    manifest_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-llvm-artifact-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    try append_line(out, "output target/selfhost/selfhost.ll");
    try append_line(out, "runtime-storage target/selfhost/selfhost.storage.ll");
    try append_line(out, "host-runtime target/selfhost/selfhost.host.ll");
    try append_line(out, "host-runtime-metadata target/selfhost/selfhost.host.ll.meta");
    try append_line(out, "storage-backend selfhost-runtime-ll");
    try append_line(out, "host-capabilities selfhost-host-v0");
    try append_line(out, "abi-record summary-i64-slice");
    try append_line(out, "abi-error-union summary-success-failure");
    try append_line(out, "abi-call direct-record-roundtrip");
    try append_line(out, "go-stdprim-storage none");
    try append_line(out, "go-stdprim-host none");
    try append_line(out, "linker-process hosted-artifact-runner");
    try append_line(out, "backend-input ir-contract selfhost-checked-package-v1");
    try append_line(out, "backend-input checked-entry selfhost::cli_main");
    try append_line(out, "backend-input hosted-entry @kizu_selfhost__cli_main");
    try append_line(out, "backend-input hosted-smoke @kizu_selfhost__smoke");
    try append_line(out, "backend-input executable-contract-source data selfhost::backend::data");
    try append_line(
        out,
        "backend-input executable-contract-source lowering selfhost::backend::executable"
    );
    try append_line(out, "backend-input hosted-executable-abi executable-result-layout-v1");
    try append_line(out, "backend-input executable-layout kind:i64 callee:[]u8 payload:[]u8");
    try append_backend_input_executable_tag(out, "executable-kind ", "Unsupported");
    try append_backend_input_executable_tag(out, "executable-kind ", "RunReturnVoid");
    try append_backend_input_executable_tag(out, "executable-kind ", "Call");
    try append_line(out, "entry @kizu_selfhost__cli_main");
    try append_line(out, "cli-command check selfhost");
    try append_line(out, "cli-command stage selfhost");
    try append_line(out, "cli-command check file source");
    try append_line(out, "cli-command parse file source");
    try append_line(out, "cli-command fmt file source");
    try append_line(out, "cli-command run file executable top-level-print-or-return");
    try append_line(out, "cli-command test file executable top-level-expect");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/parse-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/check-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/run-parity.tsv");
    try append_line(out, "cli-parity-manifest selfhost/tests/cli/test-parity.tsv");
    try append_line(out, "cli-hosted-smoke no-go");
    try append_line(out, "validation go test ./cmd/kizu -run TestSelfhostBackendArtifactGate");
    try append_line(out, "external @kizu_rt_mem_page_allocator");
    try append_line(out, "external @kizu_rt_alloc");
    try append_line(out, "external @kizu_rt_free");
    try append_line(out, "external @llvm.memcpy.p0.p0.i64");
    try append_line(out, "external @llvm.trap");
    try append_line(out, "external @kizu_rt_io_blocking");
    try append_line(out, "external @kizu_rt_fs_exists");
    try append_line(out, "external @kizu_rt_fs_metadata");
    try append_line(out, "external @kizu_rt_fs_read_dir");
    try append_line(out, "external @kizu_rt_fs_read_file");
    try append_line(out, "external @kizu_rt_fs_write_file");
    try append_line(out, "external @kizu_rt_fs_create_dir");
    try append_line(out, "external @kizu_rt_fs_rename");
    try append_line(out, "external @kizu_rt_io_write_stdout");
    try append_line(out, "external @kizu_rt_io_write_stderr");
    try append_line(out, "external @kizu_rt_process_arg_count");
    try append_line(out, "external @kizu_rt_process_arg");
    try append_line(out, "external @kizu_rt_process_env");
    try append_line(out, "external @kizu_rt_process_env_or_empty");
    try append_line(out, "external @kizu_rt_process_monotonic_millis");
    try append_line(out, "external @kizu_rt_process_exit_code");
    try append_line(out, "external @kizu_rt_process_exit");
    try append_line(out, "external @kizu_rt_process_spawn_wait8");
    try append_line(out, "external @kizu_rt_owned_deinit");
    try append_line(out, "external @kizu_rt_trap");
    try append_line(out, "unsupported-policy blocker");
    try append_line(out, "deferred tagged-union-payload issue-495");
    return out;
}

fn append_backend_input_executable_tag(
    out: &var std::string::String,
    prefix: []u8,
    name: []u8
) -> !void {
    let value = try executable_tag_value(prefix, name);
    try out.append_bytes("backend-input ");
    try out.append_bytes(prefix);
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn require_executable_tag_layout() -> !void {
    if try data::executable_kind_tag_by_name("Unsupported") != 0 {
        return error("invalid executable kind layout");
    }
    if try data::executable_kind_tag_by_name("RunReturnVoid") != 1 {
        return error("invalid executable kind layout");
    }
    if try data::executable_kind_tag_by_name("Call") != 2 {
        return error("invalid executable kind layout");
    }
    return;
}

fn executable_tag_value(prefix: []u8, name: []u8) -> !i64 {
    if std::mem::equal_bytes(prefix, "executable-kind ") {
        return try data::executable_kind_tag_by_name(name);
    }
    return error("invalid executable tag prefix");
}

fn append_backend_input_named_line_fact(
    out: &var std::string::String,
    ir_bytes: []u8,
    prefix: []u8,
    name: []u8
) -> !void {
    let value = try ir_contract::named_fact_line_value(ir_bytes, prefix, name);
    try out.append_bytes("backend-input ");
    try out.append_bytes(prefix);
    try out.append_bytes(name);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

