        "  %ok = call i1 @kizu_selfhost__parse_write_expected_one_token(%kizu.owned %io, %kizu.slice.u8 %source, i64 %got_index, %kizu.slice.u8 %parse_expected_assign_prefix_slice)");
    try append_line(out, "  ret i1 %ok");
