pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(
        out,
        "parse_expected_expr_prefix",
        "32",
        "error: expected expression, got "
    );
    try append_llvm_constant(
        out,
        "parse_expected_assign_prefix",
        "28",
        "error: expected assign, got "
    );
    try append_llvm_constant(out, "parse_error_at", "4", " at ");
    try append_llvm_constant(out, "parse_error_colon", "1", ":");
    try append_llvm_constant(out, "parse_failed_line", "20", "error: parse failed\0A");
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_parse_skip_comment_or_self_function(out);
    try append_parse_next_semantic_token_index_function(out);
    try append_parse_is_binding_keyword_function(out);
    try append_parse_missing_expr_index_function(out);
    try append_parse_missing_assign_index_function(out);
    try append_parse_write_digit_stderr_function(out);
    try append_parse_write_i64_stderr_function(out);
    try append_parse_write_expected_one_token_function(out);
    try append_parse_write_missing_expr_function(out);
    try append_parse_write_missing_assign_function(out);
    return;
}

fn append_parse_skip_comment_or_self_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__parse_skip_comment_or_self(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  %first_ok = icmp slt i64 %start, %source_len");
    try append_line(out, "  br i1 %first_ok, label %load_first, label %same");
    try append_line(out, "load_first:");
    try append_line(out, "  %first_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %first = load i8, ptr %first_ptr");
    try append_line(out, "  %is_slash = icmp eq i8 %first, 47");
    try append_line(out, "  br i1 %is_slash, label %maybe_comment, label %same");
    try append_line(out, "maybe_comment:");
    try append_line(out, "  %second_index = add i64 %start, 1");
    try append_line(out, "  %second_ok = icmp slt i64 %second_index, %source_len");
    try append_line(out, "  br i1 %second_ok, label %load_second, label %same");
    try append_line(out, "load_second:");
    try append_line(out, "  %second_ptr = getelementptr i8, ptr %source_ptr, i64 %second_index");
    try append_line(out, "  %second = load i8, ptr %second_ptr");
    try append_line(out, "  %is_second_slash = icmp eq i8 %second, 47");
    try append_line(out, "  br i1 %is_second_slash, label %comment_loop, label %same");
    try append_line(out, "comment_loop:");
    try append_line(out, "  %index = phi i64 [ %second_index, %load_second ], [ %next_index, %advance ]");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %comment_load, label %done");
    try append_line(out, "comment_load:");
    try append_line(out, "  %byte_ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %byte_ptr");
    try append_line(out, "  %is_newline = icmp eq i8 %byte, 10");
    try append_line(out, "  br i1 %is_newline, label %done, label %advance");
    try append_line(out, "advance:");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %comment_loop");
    try append_line(out, "done:");
    try append_line(out, "  ret i64 %index");
    try append_line(out, "same:");
    try append_line(out, "  ret i64 %start");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_next_semantic_token_index_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__parse_next_semantic_token_index(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %scan = phi i64 [ %start, %entry ], [ %resume, %skip_comment ]");
    try append_line(out,
        "  %candidate = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out,
        "  %after_comment = call i64 @kizu_selfhost__parse_skip_comment_or_self(%kizu.slice.u8 %source, i64 %candidate)");
    try append_line(out, "  %skipped_comment = icmp ne i64 %after_comment, %candidate");
    try append_line(out, "  br i1 %skipped_comment, label %skip_comment, label %done");
    try append_line(out, "skip_comment:");
    try append_line(out, "  %resume = add i64 %after_comment, 0");
    try append_line(out, "  br label %loop");
    try append_line(out, "done:");
    try append_line(out, "  ret i64 %candidate");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_is_binding_keyword_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_is_binding_keyword(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %len_three = icmp eq i64 %len, 3");
    try append_line(out, "  br i1 %len_three, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %i1 = add i64 %start, 1");
    try append_line(out, "  %i2 = add i64 %start, 2");
    try append_line(out, "  %b0_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %b1_ptr = getelementptr i8, ptr %source_ptr, i64 %i1");
    try append_line(out, "  %b2_ptr = getelementptr i8, ptr %source_ptr, i64 %i2");
    try append_line(out, "  %b0 = load i8, ptr %b0_ptr");
    try append_line(out, "  %b1 = load i8, ptr %b1_ptr");
    try append_line(out, "  %b2 = load i8, ptr %b2_ptr");
    try append_line(out, "  %let_l = icmp eq i8 %b0, 108");
    try append_line(out, "  %let_e = icmp eq i8 %b1, 101");
    try append_line(out, "  %let_t = icmp eq i8 %b2, 116");
    try append_line(out, "  %let_le = and i1 %let_l, %let_e");
    try append_line(out, "  %is_let = and i1 %let_le, %let_t");
    try append_line(out, "  %var_v = icmp eq i8 %b0, 118");
    try append_line(out, "  %var_a = icmp eq i8 %b1, 97");
    try append_line(out, "  %var_r = icmp eq i8 %b2, 114");
    try append_line(out, "  %var_va = and i1 %var_v, %var_a");
    try append_line(out, "  %is_var = and i1 %var_va, %var_r");
    try append_line(out, "  %result = or i1 %is_let, %is_var");
    try append_line(out, "  ret i1 %result");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_missing_expr_index_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__parse_missing_expr_index(%kizu.slice.u8 %source) {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %scan");
    try append_line(out, "scan:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next_index, %advance ], [ %resume_index, %resume ], [ %comment_index, %skip_comment ]");
    try append_line(out,
        "  %non_ws = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out,
        "  %start = call i64 @kizu_selfhost__parse_skip_comment_or_self(%kizu.slice.u8 %source, i64 %non_ws)");
    try append_line(out, "  %comment_skipped = icmp ne i64 %start, %non_ws");
    try append_line(out, "  br i1 %comment_skipped, label %skip_comment, label %check_bounds");
    try append_line(out, "skip_comment:");
    try append_line(out, "  %comment_index = add i64 %start, 0");
    try append_line(out, "  br label %scan");
    try append_line(out, "check_bounds:");
    try append_line(out, "  %in_bounds = icmp slt i64 %start, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load, label %not_found");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_equal = icmp eq i8 %byte, 61");
    try append_line(out, "  br i1 %is_equal, label %after_equal, label %advance");
    try append_line(out, "advance:");
    try append_line(out, "  %next_index = add i64 %start, 1");
    try append_line(out, "  br label %scan");
    try append_line(out, "after_equal:");
    try append_line(out, "  %after_start = add i64 %start, 1");
    try append_line(out,
        "  %after = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %after_start)");
    try append_line(out, "  %after_ok = icmp slt i64 %after, %source_len");
    try append_line(out, "  br i1 %after_ok, label %check_after, label %not_found");
    try append_line(out, "check_after:");
    try append_line(out, "  %after_ptr = getelementptr i8, ptr %source_ptr, i64 %after");
    try append_line(out, "  %after_byte = load i8, ptr %after_ptr");
    try append_line(out, "  %is_semicolon = icmp eq i8 %after_byte, 59");
    try append_line(out, "  %is_rparen = icmp eq i8 %after_byte, 41");
    try append_line(out, "  %is_rbrace = icmp eq i8 %after_byte, 125");
    try append_line(out, "  %is_comma = icmp eq i8 %after_byte, 44");
    try append_line(out, "  %missing_a = or i1 %is_semicolon, %is_rparen");
    try append_line(out, "  %missing_b = or i1 %is_rbrace, %is_comma");
    try append_line(out, "  %missing = or i1 %missing_a, %missing_b");
    try append_line(out, "  br i1 %missing, label %found, label %resume");
    try append_line(out, "resume:");
    try append_line(out, "  %resume_index = add i64 %after, 1");
    try append_line(out, "  br label %scan");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %after");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_missing_assign_index_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__parse_missing_assign_index(%kizu.slice.u8 %source) {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %scan");
    try append_line(out, "scan:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next_index, %advance ], [ %resume_index, %resume_name ], [ %after_assign_next, %after_assign ]");
    try append_line(out,
        "  %non_ws = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out,
        "  %start = call i64 @kizu_selfhost__parse_skip_comment_or_self(%kizu.slice.u8 %source, i64 %non_ws)");
    try append_line(out, "  %in_bounds = icmp slt i64 %start, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %token, label %not_found");
    try append_line(out, "token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %start)");
    try append_line(out,
        "  %is_binding = call i1 @kizu_selfhost__parse_is_binding_keyword(%kizu.slice.u8 %source, i64 %start, i64 %token_end)");
    try append_line(out, "  br i1 %is_binding, label %after_binding, label %advance");
    try append_line(out, "advance:");
    try append_line(out, "  %next_index = add i64 %token_end, 0");
    try append_line(out, "  br label %scan");
    try append_line(out, "after_binding:");
    try append_line(out,
        "  %name_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %token_end)");
    try append_line(out, "  %name_in_bounds = icmp slt i64 %name_start, %source_len");
    try append_line(out, "  br i1 %name_in_bounds, label %name_token, label %not_found");
    try append_line(out, "name_token:");
    try append_line(out, "  %name_ptr = getelementptr i8, ptr %source_ptr, i64 %name_start");
    try append_line(out, "  %name_first = load i8, ptr %name_ptr");
    try append_line(out,
        "  %name_is_word = call i1 @kizu_selfhost__parse_is_word_byte(i8 %name_first)");
    try append_line(out, "  br i1 %name_is_word, label %after_name_token, label %resume_name");
    try append_line(out, "after_name_token:");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %name_start)");
    try append_line(out,
        "  %assign_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %name_end)");
    try append_line(out, "  %assign_in_bounds = icmp slt i64 %assign_start, %source_len");
    try append_line(out, "  br i1 %assign_in_bounds, label %load_assign, label %not_found");
    try append_line(out, "load_assign:");
    try append_line(out, "  %assign_ptr = getelementptr i8, ptr %source_ptr, i64 %assign_start");
    try append_line(out, "  %assign_byte = load i8, ptr %assign_ptr");
    try append_line(out, "  %is_equal = icmp eq i8 %assign_byte, 61");
    try append_line(out, "  br i1 %is_equal, label %after_assign, label %found");
    try append_line(out, "after_assign:");
    try append_line(out, "  %after_assign_next = add i64 %assign_start, 1");
    try append_line(out, "  br label %scan");
    try append_line(out, "resume_name:");
    try append_line(out, "  %resume_index = add i64 %name_start, 1");
    try append_line(out, "  br label %scan");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %assign_start");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_write_digit_stderr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_write_digit_stderr(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  i64 %digit");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %digits_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.parse_digits, i64 0, i64 0");
    try append_line(out, "  %digit_ptr = getelementptr i8, ptr %digits_ptr, i64 %digit");
    try append_line(out, "  %digit_base = insertvalue %kizu.slice.u8 poison, ptr %digit_ptr, 0");
    try append_line(out, "  %digit_slice = insertvalue %kizu.slice.u8 %digit_base, i64 1, 1");
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %digit_slice)");
    try append_line(out, "  %ok = extractvalue %kizu.error.void %write, 0");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_write_i64_stderr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_write_i64_stderr(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  i64 %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %has_hundreds = icmp sge i64 %value, 100");
    try append_line(out, "  br i1 %has_hundreds, label %hundreds, label %check_tens");
    try append_line(out, "hundreds:");
    try append_line(out, "  %hundred_digit = sdiv i64 %value, 100");
    try append_line(out, "  %hundred_ok = call i1 @kizu_selfhost__parse_write_digit_stderr(%kizu.owned %io, i64 %hundred_digit)");
    try append_line(out, "  br i1 %hundred_ok, label %hundreds_tens, label %false");
    try append_line(out, "hundreds_tens:");
    try append_line(out, "  %hundred_rem = srem i64 %value, 100");
    try append_line(out, "  %hundred_tens = sdiv i64 %hundred_rem, 10");
    try append_line(out, "  %hundred_tens_ok = call i1 @kizu_selfhost__parse_write_digit_stderr(%kizu.owned %io, i64 %hundred_tens)");
    try append_line(out, "  br i1 %hundred_tens_ok, label %hundreds_ones, label %false");
    try append_line(out, "hundreds_ones:");
    try append_line(out, "  %hundred_ones = srem i64 %hundred_rem, 10");
    try append_line(out, "  %hundred_ones_ok = call i1 @kizu_selfhost__parse_write_digit_stderr(%kizu.owned %io, i64 %hundred_ones)");
    try append_line(out, "  br i1 %hundred_ones_ok, label %true, label %false");
    try append_line(out, "check_tens:");
    try append_line(out, "  %has_tens = icmp sge i64 %value, 10");
    try append_line(out, "  br i1 %has_tens, label %tens, label %ones");
    try append_line(out, "tens:");
    try append_line(out, "  %ten_digit = sdiv i64 %value, 10");
    try append_line(out, "  %ten_ok = call i1 @kizu_selfhost__parse_write_digit_stderr(%kizu.owned %io, i64 %ten_digit)");
    try append_line(out, "  br i1 %ten_ok, label %tens_ones, label %false");
    try append_line(out, "tens_ones:");
    try append_line(out, "  %one_digit = srem i64 %value, 10");
    try append_line(out, "  %one_after_tens_ok = call i1 @kizu_selfhost__parse_write_digit_stderr(%kizu.owned %io, i64 %one_digit)");
    try append_line(out, "  br i1 %one_after_tens_ok, label %true, label %false");
    try append_line(out, "ones:");
    try append_line(out, "  %ones_ok = call i1 @kizu_selfhost__parse_write_digit_stderr(%kizu.owned %io, i64 %value)");
    try append_line(out, "  br i1 %ones_ok, label %true, label %false");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_write_expected_one_token_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_write_expected_one_token(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %got_index,");
    try append_line(out, "  %kizu.slice.u8 %prefix");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  br label %position_loop");
    try append_line(out, "position_loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next_index, %position_advance ]");
    try append_line(out, "  %line = phi i64 [ 1, %entry ], [ %next_line, %position_advance ]");
    try append_line(out, "  %column = phi i64 [ 1, %entry ], [ %next_column, %position_advance ]");
    try append_line(out, "  %at_got = icmp eq i64 %index, %got_index");
    try append_line(out, "  br i1 %at_got, label %write_prefix, label %position_load");
    try append_line(out, "position_load:");
    try append_line(out, "  %byte_ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %byte_ptr");
    try append_line(out, "  %is_newline = icmp eq i8 %byte, 10");
    try append_line(out, "  %advanced_line = add i64 %line, 1");
    try append_line(out, "  %advanced_column = add i64 %column, 1");
    try append_line(out, "  %next_line = select i1 %is_newline, i64 %advanced_line, i64 %line");
    try append_line(out, "  %next_column = select i1 %is_newline, i64 1, i64 %advanced_column");
    try append_line(out, "  br label %position_advance");
    try append_line(out, "position_advance:");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %position_loop");
    try append_line(out, "write_prefix:");
    try append_line(out,
        "  %prefix_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %prefix)");
    try append_line(out, "  %prefix_ok = extractvalue %kizu.error.void %prefix_write, 0");
    try append_line(out, "  br i1 %prefix_ok, label %write_got, label %false");
    try append_line(out, "write_got:");
    try append_line(out, "  %got_ptr = getelementptr i8, ptr %source_ptr, i64 %got_index");
    try append_line(out, "  %got_base = insertvalue %kizu.slice.u8 poison, ptr %got_ptr, 0");
    try append_line(out, "  %got_slice = insertvalue %kizu.slice.u8 %got_base, i64 1, 1");
    try append_line(out,
        "  %got_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %got_slice)");
    try append_line(out, "  %got_ok = extractvalue %kizu.error.void %got_write, 0");
    try append_line(out, "  br i1 %got_ok, label %write_at, label %false");
    try append_line(out, "write_at:");
    try append_global_slice(out, "parse_error", "at", "parse_error_at", "4");
    try append_line(out,
        "  %at_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %parse_error_at_slice)");
    try append_line(out, "  %at_ok = extractvalue %kizu.error.void %at_write, 0");
    try append_line(out, "  br i1 %at_ok, label %write_line, label %false");
    try append_line(out, "write_line:");
    try append_line(out,
        "  %line_ok = call i1 @kizu_selfhost__parse_write_i64_stderr(%kizu.owned %io, i64 %line)");
    try append_line(out, "  br i1 %line_ok, label %write_colon, label %false");
    try append_line(out, "write_colon:");
    try append_global_slice(out, "parse_error", "colon", "parse_error_colon", "1");
    try append_line(out,
        "  %colon_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %parse_error_colon_slice)");
    try append_line(out, "  %colon_ok = extractvalue %kizu.error.void %colon_write, 0");
    try append_line(out, "  br i1 %colon_ok, label %write_column, label %false");
    try append_line(out, "write_column:");
    try append_line(out,
        "  %column_ok = call i1 @kizu_selfhost__parse_write_i64_stderr(%kizu.owned %io, i64 %column)");
    try append_line(out, "  br i1 %column_ok, label %write_newline, label %false");
    try append_line(out, "write_newline:");
    try append_global_slice(out, "parse_error", "newline", "parse_newline", "1");
    try append_line(out,
        "  %newline_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %parse_error_newline_slice)");
    try append_line(out, "  %newline_ok = extractvalue %kizu.error.void %newline_write, 0");
    try append_line(out, "  br i1 %newline_ok, label %write_failed, label %false");
    try append_line(out, "write_failed:");
    try append_global_slice(out, "parse_failed", "line", "parse_failed_line", "20");
    try append_line(out,
        "  %failed_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %parse_failed_line_slice)");
    try append_line(out, "  %failed_ok = extractvalue %kizu.error.void %failed_write, 0");
    try append_line(out, "  br i1 %failed_ok, label %true, label %false");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_write_missing_expr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_write_missing_expr(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %got_index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "parse_expected_expr", "prefix", "parse_expected_expr_prefix", "32");
    try append_line(out,
        "  %ok = call i1 @kizu_selfhost__parse_write_expected_one_token(%kizu.owned %io, %kizu.slice.u8 %source, i64 %got_index, %kizu.slice.u8 %parse_expected_expr_prefix_slice)");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

