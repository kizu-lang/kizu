import selfhost::backend::ir_contract;

pub fn append_prefix_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let title = try metadata_fact(ir_bytes, "hosted-artifact-metadata-title ", function_name);
    let issue = try metadata_fact(ir_bytes, "hosted-artifact-metadata-issue ", function_name);
    let source_prefix = try metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-source-prefix ",
        "selfhost::backend::hosted::append_common_metadata"
    );
    let size = prefix_decoded_size(title, issue, source_prefix);
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes(title);
    try out.append_bytes("\0A");
    try out.append_bytes(issue);
    try out.append_bytes("\0A");
    try out.append_bytes(source_prefix);
    try append_llvm_constant_footer(out);
    return;
}

pub fn prefix_size(ir_bytes: []u8, function_name: []u8) -> !i64 {
    let title = try metadata_fact(ir_bytes, "hosted-artifact-metadata-title ", function_name);
    let issue = try metadata_fact(ir_bytes, "hosted-artifact-metadata-issue ", function_name);
    let source_prefix = try metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-source-prefix ",
        "selfhost::backend::hosted::append_common_metadata"
    );
    return prefix_decoded_size(title, issue, source_prefix);
}

pub fn append_output_prefix_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8
) -> !void {
    let output_prefix = try output_prefix_fact(ir_bytes);
    let size = output_prefix_size_from_token(output_prefix);
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes("\0A");
    try out.append_bytes(output_prefix);
    try append_llvm_constant_footer(out);
    return;
}

pub fn output_prefix_size(ir_bytes: []u8) -> !i64 {
    let output_prefix = try output_prefix_fact(ir_bytes);
    return output_prefix_size_from_token(output_prefix);
}

pub fn append_before_runtime_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> !void {
    let size = try before_runtime_size(ir_bytes, function_name, index);
    let entry = try lowering_case_entry(ir_bytes, function_name, index);
    let abi_line = try common_metadata_fact(ir_bytes, "hosted-artifact-metadata-abi-line ");
    let entry_prefix = try common_metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-entry-prefix "
    );
    let runtime_prefix = try runtime_line_prefix(ir_bytes);
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes("\0A");
    try append_line_token(out, abi_line);
    try out.append_bytes(entry_prefix);
    try out.append_bytes(entry);
    try out.append_bytes("\0A");
    try out.append_bytes(runtime_prefix);
    try append_llvm_constant_footer(out);
    return;
}

pub fn append_after_runtime_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    include_discovery: bool
) -> !void {
    let size = try after_runtime_size(ir_bytes, include_discovery);
    let fallback_line = try common_metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-fallback-line "
    );
    let lowering_line = try common_metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-lowering-line "
    );
    let mode_line = try common_metadata_fact(ir_bytes, "hosted-artifact-metadata-mode-line ");
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes("\0A");
    try append_line_token(out, lowering_line);
    try append_line_token(out, fallback_line);
    try append_line_token(out, mode_line);
    if include_discovery {
        let discovery_line = try metadata_fact(
            ir_bytes,
            "hosted-artifact-metadata-discovery-line ",
            "selfhost::backend::hosted::write_test_metadata"
        );
        try append_line_token(out, discovery_line);
    }
    try append_llvm_constant_footer(out);
    return;
}

pub fn before_runtime_size(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> !i64 {
    let entry = try lowering_case_entry(ir_bytes, function_name, index);
    let abi_line = try common_metadata_fact(ir_bytes, "hosted-artifact-metadata-abi-line ");
    let entry_prefix = try common_metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-entry-prefix "
    );
    let runtime_prefix = try runtime_line_prefix(ir_bytes);
    return 1 + line_token_size(abi_line) + llvm_c_decoded_len(entry_prefix) +
        std::mem::len(entry) + 1 + llvm_c_decoded_len(runtime_prefix);
}

pub fn after_runtime_size(ir_bytes: []u8, include_discovery: bool) -> !i64 {
    let fallback_line = try common_metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-fallback-line "
    );
    let lowering_line = try common_metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-lowering-line "
    );
    let mode_line = try common_metadata_fact(ir_bytes, "hosted-artifact-metadata-mode-line ");
    var size = 1 + line_token_size(lowering_line) + line_token_size(fallback_line) +
        line_token_size(mode_line);
    if include_discovery {
        let discovery_line = try metadata_fact(
            ir_bytes,
            "hosted-artifact-metadata-discovery-line ",
            "selfhost::backend::hosted::write_test_metadata"
        );
        size = size + line_token_size(discovery_line);
    }
    return size;
}

fn metadata_fact(
    ir_bytes: []u8,
    prefix: []u8,
    fact_name: []u8
) -> ![]u8 borrows ir_bytes {
    return try ir_contract::named_fact_value(ir_bytes, prefix, fact_name);
}

fn common_metadata_fact(ir_bytes: []u8, prefix: []u8) -> ![]u8 borrows ir_bytes {
    return try metadata_fact(
        ir_bytes,
        prefix,
        "selfhost::backend::hosted::append_common_metadata"
    );
}

fn lowering_case_entry(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> ![]u8 borrows ir_bytes {
    return try ir_contract::sequence_fact_value(
        ir_bytes,
        "hosted-lowering-case-entry ",
        function_name,
        index
    );
}

fn runtime_line_prefix(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    let runtime_line = try common_metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-runtime-line "
    );
    return try llvm_c_token_prefix_through_escaped_space(runtime_line);
}

fn output_prefix_fact(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try metadata_fact(
        ir_bytes,
        "hosted-artifact-metadata-output-prefix ",
        "selfhost::backend::hosted::append_common_metadata"
    );
}

fn prefix_decoded_size(title: []u8, issue: []u8, source_prefix: []u8) -> i64 {
    return llvm_c_decoded_len(title) + 1 + llvm_c_decoded_len(issue) + 1 +
        llvm_c_decoded_len(source_prefix);
}

fn output_prefix_size_from_token(output_prefix: []u8) -> i64 {
    return 1 + llvm_c_decoded_len(output_prefix);
}

fn append_line_token(out: &var std::string::String, token: []u8) -> !void {
    try out.append_bytes(token);
    try out.append_bytes("\0A");
    return;
}

fn line_token_size(token: []u8) -> i64 {
    return llvm_c_decoded_len(token) + 1;
}

fn llvm_c_token_prefix_through_escaped_space(token: []u8) -> ![]u8 borrows token {
    var index = 0;
    let len = std::mem::len(token);
    while index + 2 < len {
        if token[index] == cast<u8>(92) and
            token[index + 1] == cast<u8>(50) and
            token[index + 2] == cast<u8>(48) {
            return token[0..index + 3];
        }
        index = index + 1;
    }
    return error("invalid hosted metadata runtime line");
}

fn append_llvm_constant_header(
    out: &var std::string::String,
    name: []u8,
    size: i64
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    return;
}

fn append_llvm_constant_footer(out: &var std::string::String) -> !void {
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn llvm_c_decoded_len(text: []u8) -> i64 {
    var len = 0;
    var index = 0;
    let byte_len = std::mem::len(text);
    while index < byte_len {
        if index + 2 < byte_len and
            text[index] == cast<u8>(92) and
            is_hex_digit(text[index + 1]) and
            is_hex_digit(text[index + 2]) {
            len = len + 1;
            index = index + 3;
        } else {
            len = len + 1;
            index = index + 1;
        }
    }
    return len;
}

fn is_hex_digit(byte: u8) -> bool {
    if byte >= cast<u8>(48) and byte <= cast<u8>(57) {
        return true;
    }
    if byte >= cast<u8>(65) and byte <= cast<u8>(70) {
        return true;
    }
    if byte >= cast<u8>(97) and byte <= cast<u8>(102) {
        return true;
    }
    return false;
}
