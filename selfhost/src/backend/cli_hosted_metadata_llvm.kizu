import selfhost::backend::hosted;
import selfhost::ir::codegen;

pub fn append_prefix_constant(
    out: &var std::string::String,
    name: []u8,
    title: []u8,
    issue: []u8
) -> !void {
    let source_prefix = hosted::metadata_source_prefix();
    let size = prefix_decoded_size(title, issue, source_prefix);
    try append_llvm_constant_header(out, name, size);
    try append_llvm_c_string_payload(out, title);
    try out.append_bytes("\0A");
    try append_llvm_c_string_payload(out, issue);
    try out.append_bytes("\0A");
    try append_llvm_c_string_payload(out, source_prefix);
    try append_llvm_constant_footer(out);
    return;
}

pub fn prefix_size(title: []u8, issue: []u8) -> !i64 {
    let source_prefix = hosted::metadata_source_prefix();
    return prefix_decoded_size(title, issue, source_prefix);
}

pub fn append_output_prefix_constant(
    out: &var std::string::String,
    name: []u8
) -> !void {
    let output_prefix = hosted::metadata_output_prefix();
    let size = output_prefix_size_from_value(output_prefix);
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes("\0A");
    try append_llvm_c_string_payload(out, output_prefix);
    try append_llvm_constant_footer(out);
    return;
}

pub fn output_prefix_size() -> !i64 {
    return output_prefix_size_from_value(hosted::metadata_output_prefix());
}

pub fn append_before_runtime_constant(
    out: &var std::string::String,
    name: []u8,
    entry: []u8
) -> !void {
    let size = try before_runtime_size(entry);
    let abi_line = hosted::metadata_abi_line();
    let entry_prefix = hosted::metadata_entry_prefix();
    let runtime_prefix = try runtime_line_prefix();
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes("\0A");
    try append_line_value(out, abi_line);
    try append_llvm_c_string_payload(out, entry_prefix);
    try out.append_bytes(entry);
    try out.append_bytes("\0A");
    try append_llvm_c_string_payload(out, runtime_prefix);
    try append_llvm_constant_footer(out);
    return;
}

pub fn append_after_runtime_constant(
    out: &var std::string::String,
    name: []u8,
    codegen_ir: []u8,
    include_discovery: bool
) -> !void {
    let size = try after_runtime_size(codegen_ir, include_discovery);
    let fallback_line = hosted::metadata_fallback_line();
    let lowering_line = hosted::metadata_lowering_line();
    let mode_line = hosted::metadata_mode_line();
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes("\0A");
    try out.append_bytes("codegen_ir ");
    try append_line_value(out, codegen_ir);
    try append_line_value(out, lowering_line);
    try append_line_value(out, fallback_line);
    try append_line_value(out, mode_line);
    if include_discovery {
        try append_line_value(out, hosted::test_metadata_discovery_line());
    }
    try append_llvm_constant_footer(out);
    return;
}

pub fn before_runtime_size(
    entry: []u8
) -> !i64 {
    let abi_line = hosted::metadata_abi_line();
    let entry_prefix = hosted::metadata_entry_prefix();
    let runtime_prefix = try runtime_line_prefix();
    return 1 + line_value_size(abi_line) + std::mem::len(entry_prefix) +
        std::mem::len(entry) + 1 + std::mem::len(runtime_prefix);
}

pub fn after_runtime_size(codegen_ir: []u8, include_discovery: bool) -> !i64 {
    let fallback_line = hosted::metadata_fallback_line();
    let lowering_line = hosted::metadata_lowering_line();
    let mode_line = hosted::metadata_mode_line();
    var size = 1 + std::mem::len("codegen_ir ") + line_value_size(codegen_ir) +
        line_value_size(lowering_line) + line_value_size(fallback_line) + line_value_size(mode_line);
    if include_discovery {
        size = size + line_value_size(hosted::test_metadata_discovery_line());
    }
    return size;
}

pub fn run_print_codegen_ir() -> []u8 {
    return codegen::metadata_line();
}

pub fn no_codegen_ir() -> []u8 {
    return "none";
}

fn runtime_line_prefix() -> ![]u8 {
    return try line_prefix_through_space(hosted::metadata_runtime_line());
}

fn prefix_decoded_size(title: []u8, issue: []u8, source_prefix: []u8) -> i64 {
    return std::mem::len(title) + 1 + std::mem::len(issue) + 1 +
        std::mem::len(source_prefix);
}

fn output_prefix_size_from_value(output_prefix: []u8) -> i64 {
    return 1 + std::mem::len(output_prefix);
}

fn append_line_value(out: &var std::string::String, value: []u8) -> !void {
    try append_llvm_c_string_payload(out, value);
    try out.append_bytes("\0A");
    return;
}

fn line_value_size(value: []u8) -> i64 {
    return std::mem::len(value) + 1;
}

fn line_prefix_through_space(line: []u8) -> ![]u8 borrows line {
    var index = 0;
    let len = std::mem::len(line);
    while index < len {
        if line[index] == cast<u8>(32) {
            return line[0..index + 1];
        }
        index = index + 1;
    }
    return error("invalid hosted metadata runtime line");
}

fn append_llvm_constant_header(
    out: &var std::string::String,
    name: []u8,
    size: i64
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    return;
}

fn append_llvm_constant_footer(out: &var std::string::String) -> !void {
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_c_string_payload(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte == cast<u8>(34) {
            try out.append_bytes("\22");
        } else {
            if byte == cast<u8>(92) {
                try out.append_bytes("\5C");
            } else {
                if byte == cast<u8>(10) {
                    try out.append_bytes("\0A");
                } else {
                    try out.append_byte(byte);
                }
            }
        }
        index = index + 1;
    }
    return;
}
