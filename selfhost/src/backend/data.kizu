pub struct BackendSummary {
    pub artifacts: i64,
}

pub struct LlvmArtifact {
    pub ll_path: []u8,
    pub metadata_path: []u8,
    pub storage_path: []u8,
    pub storage_metadata_path: []u8,
    pub host_path: []u8,
    pub host_metadata_path: []u8,
    pub bytes: i64,
    pub metadata_bytes: i64,
    pub storage_bytes: i64,
    pub storage_metadata_bytes: i64,
    pub host_bytes: i64,
    pub host_metadata_bytes: i64,
}

pub struct RunArtifact {
    pub bytes: i64,
    pub metadata_bytes: i64,
}

pub enum RunExecutableKind {
    Unsupported,
    PrintString,
    ReturnVoid,
}

pub struct RunExecutable {
    pub kind: RunExecutableKind,
    pub stdout_payload: []u8,
}

pub struct TestArtifact {
    pub bytes: i64,
    pub metadata_bytes: i64,
}

pub enum TestExecutableKind {
    Unsupported,
    ExpectOk,
    ExpectFailure,
}

pub struct TestExecutable {
    pub kind: TestExecutableKind,
}
