pub struct BackendSummary {
    pub artifacts: i64,
}

pub struct LlvmArtifact {
    pub ll_path: []u8,
    pub metadata_path: []u8,
    pub storage_path: []u8,
    pub storage_metadata_path: []u8,
    pub host_path: []u8,
    pub host_metadata_path: []u8,
    pub bytes: i64,
    pub metadata_bytes: i64,
    pub storage_bytes: i64,
    pub storage_metadata_bytes: i64,
    pub host_bytes: i64,
    pub host_metadata_bytes: i64,
}

pub struct RunArtifact {
    pub bytes: i64,
    pub metadata_bytes: i64,
}

pub enum ExecutableKind {
    Unsupported,
    RunReturnVoid,
    Call,
}

pub fn executable_kind_tag_by_name(name: []u8) -> !i64 {
    if std::mem::equal_bytes(name, "Unsupported") {
        return 0;
    }
    if std::mem::equal_bytes(name, "RunReturnVoid") {
        return 1;
    }
    if std::mem::equal_bytes(name, "Call") {
        return 2;
    }
    return error("invalid executable kind");
}

pub struct Executable {
    pub kind: ExecutableKind,
    pub callee: []u8,
    pub payload: []u8,
}

pub struct TestArtifact {
    pub bytes: i64,
    pub metadata_bytes: i64,
}

pub enum HostedOutputStream {
    None,
    Stdout,
    Stderr,
}

pub struct HostedExecutable {
    pub comment: []u8,
    pub entry: []u8,
    pub global: []u8,
    pub codegen_ir: []u8,
    pub output_stream: HostedOutputStream,
    pub output_payload: []u8,
    pub append_newline: bool,
    pub exit_code: i64,
}
