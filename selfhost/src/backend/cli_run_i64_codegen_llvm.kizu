    try append_line(out, "load_statement:");
    try append_line(out, "  %statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %statement_ok = extractvalue %kizu.error.node_id %statement_result, 0");
    try append_line(out, "  br i1 %statement_ok, label %statement_bound, label %child_fail");
    try append_line(out, "statement_bound:");
    try append_line(out, "  %statement = extractvalue %kizu.error.node_id %statement_result, 1");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_return = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, tags.ast_return);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_return, label %return_payload, label %none");
    try append_line(out, "return_payload:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.return_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %value = extractvalue %kizu.kizu.ast.return_node %payload, 0");
    try append_line(out, "  %op = call i64 @kizu_selfhost__ir_codegen_lower_i64_return_expr(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %value, %kizu.slice.u8 %param0_name, %kizu.slice.u8 %param1_name)");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 %op, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_error_i64_child_fail_block(out, "statement_result");
    try append_none_error_i64_block(out, tags.run_none);
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

