    try append_line(out, "  %payload_bad = icmp slt i64 %payload_start, 0");
    try append_line(out, "  br i1 %payload_bad, label %unsupported, label %payload_slice_block");
    try append_line(out, "payload_slice_block:");
    try append_line(out, "  %payload_len = sub i64 %payload_end, %payload_start");
    try append_line(out, "  %payload_empty = icmp sle i64 %payload_len, 0");
    try append_line(out, "  br i1 %payload_empty, label %unsupported, label %build");
    try append_line(out, "build:");
    try append_line(out, "  %text_ptr = extractvalue %kizu.slice.u8 %text, 0");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %text_ptr, i64 %payload_start");
    try append_line(out, "  %payload_slice0 = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload_slice = insertvalue %kizu.slice.u8 %payload_slice0, i64 %payload_len, 1");
    try append_line(out, "  %program = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lowered_main_print_program(%kizu.slice.u8 %payload_slice)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %program");
    try append_unsupported_program_block(out);
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_const_print_block_program_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_print_block_program(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %block_node");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %block_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %block_node)");
    try append_line(out, "  %block_data = extractvalue %kizu.kizu.ast.ast_node %block_ast, 1");
    try append_line(out, "  %block_tag = extractvalue %kizu.kizu.ast.ast_data %block_data, 0");
    try out.append_bytes("  %is_block = icmp eq i64 %block_tag, ");
    try std::fmt::append_i64(out, tags.ast_block);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_block, label %block_payload_block, label %unsupported");
    try append_line(out, "block_payload_block:");
    try append_line(out, "  %block_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %block_data, ptr %block_slot, align 8");
    try append_line(out, "  %block_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %block_slot, i32 0, i32 1");
    try append_line(out, "  %block_payload = load %kizu.kizu.ast.block_node, ptr %block_payload_ptr, align 8");
    try append_line(out, "  %statements = extractvalue %kizu.kizu.ast.block_node %block_payload, 0");
    try append_line(out, "  %statement_len = extractvalue %kizu.kizu.ast.child_range %statements, 1");
    try append_line(out, "  %one_statement = icmp eq i64 %statement_len, 1");
    try append_line(out, "  br i1 %one_statement, label %statement_child, label %unsupported");
    try append_line(out, "statement_child:");
    try append_line(out, "  %statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %statement_ok = extractvalue %kizu.error.node_id %statement_result, 0");
    try append_line(out, "  br i1 %statement_ok, label %lower_statement, label %unsupported");
    try append_line(out, "lower_statement:");
    try append_line(out, "  %statement = extractvalue %kizu.error.node_id %statement_result, 1");
    try append_line(out, "  %program = call %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_string_print_statement_program(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %program");
    try append_unsupported_program_block(out);
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_const_let_if_program_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_let_if_program(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.child_range %statements");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %statement_len = extractvalue %kizu.kizu.ast.child_range %statements, 1");
    try append_line(out, "  %two_statements = icmp eq i64 %statement_len, 2");
    try append_line(out, "  br i1 %two_statements, label %load_let, label %unsupported");
    try append_line(out, "load_let:");
    try append_line(out, "  %let_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %let_ok = extractvalue %kizu.error.node_id %let_result, 0");
    try append_line(out, "  br i1 %let_ok, label %let_bound, label %unsupported");
    try append_line(out, "let_bound:");
    try append_line(out, "  %let_stmt = extractvalue %kizu.error.node_id %let_result, 1");
    try append_line(out, "  %let_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %let_stmt)");
    try append_line(out, "  %let_data = extractvalue %kizu.kizu.ast.ast_node %let_ast, 1");
    try append_line(out, "  %let_tag = extractvalue %kizu.kizu.ast.ast_data %let_data, 0");
    try out.append_bytes("  %is_let = icmp eq i64 %let_tag, ");
