    try append_line(out, "  %run = call %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_i64_call_run_ast(%kizu.slice.u8 %function_name, i64 %statement_count, %kizu.slice.u8 %print_text, %kizu.slice.u8 %callee_text, i64 %op, i64 %arg0, i64 %arg1)");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.run_ast poison, i1 true, 0");
