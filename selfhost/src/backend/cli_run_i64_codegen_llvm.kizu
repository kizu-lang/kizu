fn append_unsupported_run_ast_block(out: &var std::string::String) -> !void {
    try append_line(out, "unsupported:");
    try append_line(out, "  %us_ptr = extractvalue %kizu.slice.u8 %text, 0");
    try append_line(out, "  %us0 = insertvalue %kizu.slice.u8 poison, ptr %us_ptr, 0");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 %us0, i64 0, 1");
    try append_line(out, "  %us = call %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_unsupported_run_ast(%kizu.slice.u8 %empty)");
    try append_line(out, "  %uw0 = insertvalue %kizu.error.run_ast poison, i1 true, 0");
    try append_line(out, "  %uw1 = insertvalue %kizu.error.run_ast %uw0, %kizu.selfhost.codegen.run_ast %us, 1");
    try append_line(out, "  %uw2 = insertvalue %kizu.error.run_ast %uw1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.run_ast %uw2");
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
