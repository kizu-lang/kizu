    try append_line(out, "  %param1_ok = extractvalue %kizu.error.node_id %param1_result, 0");
    try append_line(out, "  br i1 %param1_ok, label %param_names, label %param1_fail");
    try append_line(out, "param_names:");
    try append_line(out, "  %param1 = extractvalue %kizu.error.node_id %param1_result, 1");
    try append_line(out, "  %param0_name = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_param_i64_name(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %param0)");
    try append_line(out, "  %param0_len = extractvalue %kizu.slice.u8 %param0_name, 1");
    try append_line(out, "  %param0_nonempty = icmp ne i64 %param0_len, 0");
