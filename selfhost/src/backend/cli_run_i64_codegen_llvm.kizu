pub fn append_globals(out: &var std::string::String) -> !void {
    return;
}

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_parse_int_literal_function(out);
    return;
}

fn append_parse_int_literal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_parse_int_literal(");
    try append_line(out, "  %kizu.slice.u8 %literal");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %literal_ptr = extractvalue %kizu.slice.u8 %literal, 0");
    try append_line(out, "  %literal_len = extractvalue %kizu.slice.u8 %literal, 1");
    try append_line(out, "  %empty = icmp eq i64 %literal_len, 0");
    try append_line(out, "  br i1 %empty, label %fail, label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next_index, %body_ok ]");
    try append_line(out, "  %value = phi i64 [ 0, %entry ], [ %next_value, %body_ok ]");
    try append_line(out, "  %done = icmp eq i64 %index, %literal_len");
    try append_line(out, "  br i1 %done, label %success, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %byte_ptr = getelementptr i8, ptr %literal_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %byte_ptr, align 1");
    try append_line(out, "  %below_digit = icmp ult i8 %byte, 48");
    try append_line(out, "  %above_digit = icmp ugt i8 %byte, 57");
    try append_line(out, "  %bad_digit = or i1 %below_digit, %above_digit");
    try append_line(out, "  br i1 %bad_digit, label %fail, label %body_ok");
    try append_line(out, "body_ok:");
    try append_line(out, "  %byte64 = zext i8 %byte to i64");
    try append_line(out, "  %digit = sub i64 %byte64, 48");
    try append_line(out, "  %scaled = mul i64 %value, 10");
    try append_line(out, "  %next_value = add i64 %scaled, %digit");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "success:");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 %value, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  %err0 = insertvalue %kizu.slice.u8 poison, ptr %literal_ptr, 0");
    try append_line(out, "  %err = insertvalue %kizu.slice.u8 %err0, i64 0, 1");
    try append_line(out, "  %fail0 = insertvalue %kizu.error.i64 poison, i1 false, 0");
    try append_line(out, "  %fail1 = insertvalue %kizu.error.i64 %fail0, i64 0, 1");
    try append_line(out, "  %fail2 = insertvalue %kizu.error.i64 %fail1, %kizu.slice.u8 %err, 2");
    try append_line(out, "  ret %kizu.error.i64 %fail2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
