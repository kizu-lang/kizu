import selfhost::backend::compiled_fact_lookup;
import selfhost::backend::ir_contract;

struct I64RunTags {
    ast_program: i64,
    ast_int: i64,
    ast_fn_decl: i64,
    ast_block: i64,
    ast_expr_stmt: i64,
    ast_call: i64,
    ast_param: i64,
    ast_return: i64,
    ast_binary: i64,
    ast_var: i64,
    ast_bool: i64,
    ast_let: i64,
    ast_if: i64,
    ast_empty: i64,
    run_none: i64,
    run_add: i64,
    run_sub: i64,
    run_mul: i64,
    run_div: i64,
    std_add: i64,
    std_sub: i64,
    std_mul: i64,
    std_div: i64,
    std_eq: i64,
    std_not_eq: i64,
    std_lt: i64,
    std_lte: i64,
    std_gt: i64,
    std_gte: i64,
}

pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(out, "i64_type", "3", "i64");
    try append_llvm_constant(out, "run_true", "4", "true");
    try append_llvm_constant(out, "run_false", "5", "false");
    return;
}

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let tags = try load_i64_run_tags(ir_bytes);
    try append_parse_int_literal_function(out);
    try append_call_arg_i64_literal_function(out, &tags);
    try append_type_node_is_i64_function(out);
    try append_node_text_is_var_function(out, &tags);
    try append_param_name_if_i64_function(out);
    try append_param_i64_name_function(out, &tags);
    try append_run_binary_op_function(out, &tags);
    try append_lower_i64_return_binary_function(out, &tags);
    try append_lower_i64_return_expr_function(out, &tags);
    try append_lower_i64_function_block_function(out, &tags);
    try append_lower_i64_function_decl_function(out, &tags);
    try append_lower_i64_function_node_function(out, &tags);
    try append_find_i64_binary_function(out, &tags);
    try append_eval_i64_call_arg_expr_function(out, &tags);
    try append_lower_direct_i64_print_call_function(out, &tags);
    try append_eval_const_i64_expr_function(out, &tags);
    try append_eval_const_i64_operand_one_local_function(out, &tags);
    try append_eval_const_bool_expr_one_local_function(out, &tags);
    try append_eval_const_bool_literal_function(out, &tags);
    try append_lower_const_i64_print_program_function(out);
    try append_lower_const_string_print_statement_program_function(out, &tags);
    try append_lower_const_print_block_program_function(out, &tags);
    try append_lower_const_let_if_program_function(out, &tags);
    try append_lower_const_single_if_program_function(out, &tags);
    try append_lower_const_i64_program_function(out, &tags);
    return;
}

fn load_i64_run_tags(ir_bytes: []u8) -> !I64RunTags {
    return I64RunTags {
        ast_program: try ast_data_tag(ir_bytes, "Program"),
        ast_int: try ast_data_tag(ir_bytes, "Int"),
        ast_fn_decl: try ast_data_tag(ir_bytes, "FnDecl"),
        ast_block: try ast_data_tag(ir_bytes, "Block"),
        ast_expr_stmt: try ast_data_tag(ir_bytes, "ExprStmt"),
        ast_call: try ast_data_tag(ir_bytes, "Call"),
        ast_param: try ast_data_tag(ir_bytes, "Param"),
        ast_return: try ast_data_tag(ir_bytes, "Return"),
        ast_binary: try ast_data_tag(ir_bytes, "Binary"),
        ast_var: try ast_data_tag(ir_bytes, "Var"),
        ast_bool: try ast_data_tag(ir_bytes, "Bool"),
        ast_let: try ast_data_tag(ir_bytes, "Let"),
        ast_if: try ast_data_tag(ir_bytes, "If"),
        ast_empty: try ast_data_tag(ir_bytes, "Empty"),
        run_none: try ir_contract::enum_variant_tag(
            ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "None"
        ),
        run_add: try ir_contract::enum_variant_tag(
            ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Add"
        ),
        run_sub: try ir_contract::enum_variant_tag(
            ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Sub"
        ),
        run_mul: try ir_contract::enum_variant_tag(
            ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Mul"
        ),
        run_div: try ir_contract::enum_variant_tag(
            ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Div"
        ),
        std_add: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "Add"
        ),
        std_sub: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "Sub"
        ),
        std_mul: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "Mul"
        ),
        std_div: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "Div"
        ),
        std_eq: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "Eq"
        ),
        std_not_eq: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "NotEq"
        ),
        std_lt: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "LT"
        ),
        std_lte: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "LTE"
        ),
        std_gt: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "GT"
        ),
        std_gte: try ir_contract::enum_variant_tag(
            ir_bytes, "std::kizu::ast::BinaryOp", "GTE"
        )
    };
}

fn ast_data_tag(ir_bytes: []u8, name: []u8) -> !i64 {
    let variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", name
    );
    if !variant.found {
        return error("missing AstData variant fact");
    }
    return variant.tag;
}

fn append_parse_int_literal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_parse_int_literal(");
    try append_line(out, "  %kizu.slice.u8 %literal");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %literal_ptr = extractvalue %kizu.slice.u8 %literal, 0");
    try append_line(out, "  %literal_len = extractvalue %kizu.slice.u8 %literal, 1");
    try append_line(out, "  %empty = icmp eq i64 %literal_len, 0");
    try append_line(out, "  br i1 %empty, label %fail, label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next_index, %body_ok ]");
    try append_line(out, "  %value = phi i64 [ 0, %entry ], [ %next_value, %body_ok ]");
    try append_line(out, "  %done = icmp eq i64 %index, %literal_len");
    try append_line(out, "  br i1 %done, label %success, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %byte_ptr = getelementptr i8, ptr %literal_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %byte_ptr, align 1");
    try append_line(out, "  %below_digit = icmp ult i8 %byte, 48");
    try append_line(out, "  %above_digit = icmp ugt i8 %byte, 57");
    try append_line(out, "  %bad_digit = or i1 %below_digit, %above_digit");
    try append_line(out, "  br i1 %bad_digit, label %fail, label %body_ok");
    try append_line(out, "body_ok:");
    try append_line(out, "  %byte64 = zext i8 %byte to i64");
    try append_line(out, "  %digit = sub i64 %byte64, 48");
    try append_line(out, "  %scaled = mul i64 %value, 10");
    try append_line(out, "  %next_value = add i64 %scaled, %digit");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "success:");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 %value, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  %err0 = insertvalue %kizu.slice.u8 poison, ptr %literal_ptr, 0");
    try append_line(out, "  %err = insertvalue %kizu.slice.u8 %err0, i64 0, 1");
    try append_line(out, "  %fail0 = insertvalue %kizu.error.i64 poison, i1 false, 0");
    try append_line(out, "  %fail1 = insertvalue %kizu.error.i64 %fail0, i64 0, 1");
    try append_line(out, "  %fail2 = insertvalue %kizu.error.i64 %fail1, %kizu.slice.u8 %err, 2");
    try append_line(out, "  ret %kizu.error.i64 %fail2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_call_arg_i64_literal_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_call_arg_i64_literal(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %node_id");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %node_id)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_int = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, tags.ast_int);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_int, label %parse, label %unsupported");
    try append_line(out, "parse:");
    try append_line(out, "  %literal = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %node_id)");
    try append_line(out, "  %parsed = call %kizu.error.i64 @kizu_selfhost__ir_codegen_parse_int_literal(%kizu.slice.u8 %literal)");
    try append_line(out, "  ret %kizu.error.i64 %parsed");
    try append_line(out, "unsupported:");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 -1, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_type_node_is_i64_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__ir_codegen_type_node_is_i64(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %type_node");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %type_text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %type_node)");
    try append_line(out, "  %i64_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.i64_type, i64 0, i64 0");
    try append_line(out, "  %i64_base = insertvalue %kizu.slice.u8 poison, ptr %i64_ptr, 0");
    try append_line(out, "  %i64_slice = insertvalue %kizu.slice.u8 %i64_base, i64 3, 1");
    try append_line(out, "  %ok = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %type_text, %kizu.slice.u8 %i64_slice)");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_node_text_is_var_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__ir_codegen_node_text_is_var(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %node_id,");
    try append_line(out, "  %kizu.slice.u8 %expected");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %node_id)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_var = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, tags.ast_var);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_var, label %compare, label %no");
    try append_line(out, "compare:");
    try append_line(out, "  %actual = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %node_id)");
    try append_line(out, "  %ok = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %actual, %kizu.slice.u8 %expected)");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "no:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_param_name_if_i64_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.slice.u8 @kizu_selfhost__ir_codegen_param_name_if_i64(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %name,");
    try append_line(out, "  %kizu.kizu.ast.node_id %type_node,");
    try append_line(out, "  i1 %comptime_param");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  br i1 %comptime_param, label %empty, label %check_type");
    try append_line(out, "check_type:");
    try append_line(out, "  %is_i64 = call i1 @kizu_selfhost__ir_codegen_type_node_is_i64(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %type_node)");
    try append_line(out, "  br i1 %is_i64, label %name_text, label %empty");
    try append_line(out, "name_text:");
    try append_line(out, "  %result = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %name)");
    try append_line(out, "  ret %kizu.slice.u8 %result");
    try append_line(out, "empty:");
    try append_line(out, "  %text_ptr = extractvalue %kizu.slice.u8 %text, 0");
    try append_line(out, "  %empty0 = insertvalue %kizu.slice.u8 poison, ptr %text_ptr, 0");
    try append_line(out, "  %empty_slice = insertvalue %kizu.slice.u8 %empty0, i64 0, 1");
    try append_line(out, "  ret %kizu.slice.u8 %empty_slice");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_param_i64_name_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define %kizu.slice.u8 @kizu_selfhost__ir_codegen_param_i64_name(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %param");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %param)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_param = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, tags.ast_param);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_param, label %param_payload, label %empty");
    try append_line(out, "param_payload:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.param_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %comptime = extractvalue %kizu.kizu.ast.param_node %payload, 0");
    try append_line(out, "  %name = extractvalue %kizu.kizu.ast.param_node %payload, 1");
    try append_line(out, "  %type_node = extractvalue %kizu.kizu.ast.param_node %payload, 2");
    try append_line(out, "  %result = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_param_name_if_i64(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %name, %kizu.kizu.ast.node_id %type_node, i1 %comptime)");
    try append_line(out, "  ret %kizu.slice.u8 %result");
    try append_line(out, "empty:");
    try append_line(out, "  %text_ptr = extractvalue %kizu.slice.u8 %text, 0");
    try append_line(out, "  %empty0 = insertvalue %kizu.slice.u8 poison, ptr %text_ptr, 0");
    try append_line(out, "  %empty_slice = insertvalue %kizu.slice.u8 %empty0, i64 0, 1");
    try append_line(out, "  ret %kizu.slice.u8 %empty_slice");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_run_binary_op_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__ir_codegen_run_binary_op(i64 %op) {");
    try append_line(out, "entry:");
    try out.append_bytes("  %is_add = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, tags.std_add);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_add, label %add, label %check_sub");
    try append_line(out, "check_sub:");
    try out.append_bytes("  %is_sub = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, tags.std_sub);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_sub, label %sub, label %check_mul");
    try append_line(out, "check_mul:");
    try out.append_bytes("  %is_mul = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, tags.std_mul);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_mul, label %mul, label %check_div");
    try append_line(out, "check_div:");
    try out.append_bytes("  %is_div = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, tags.std_div);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_div, label %div, label %none");
    try append_line(out, "add:");
    try out.append_bytes("  ret i64 ");
    try std::fmt::append_i64(out, tags.run_add);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "sub:");
    try out.append_bytes("  ret i64 ");
    try std::fmt::append_i64(out, tags.run_sub);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "mul:");
    try out.append_bytes("  ret i64 ");
    try std::fmt::append_i64(out, tags.run_mul);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "div:");
    try out.append_bytes("  ret i64 ");
    try std::fmt::append_i64(out, tags.run_div);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "none:");
    try out.append_bytes("  ret i64 ");
    try std::fmt::append_i64(out, tags.run_none);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_i64_return_binary_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__ir_codegen_lower_i64_return_binary(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  i64 %op,");
