    try append_line(out, "  %arg0_lit = call %kizu.error.i64 @kizu_selfhost__ir_codegen_eval_i64_call_arg_expr(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %declarations, %kizu.kizu.ast.node_id %arg0_node)");
