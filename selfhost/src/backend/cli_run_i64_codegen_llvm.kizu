    try append_line(out, "  %left_result = call %kizu.error.i64 @kizu_selfhost__cli_codegen_eval_const_i64_expr(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %left)");
    try append_line(out, "  %left_ok = extractvalue %kizu.error.i64 %left_result, 0");
    try append_line(out, "  br i1 %left_ok, label %right_eval, label %left_fail");
    try append_line(out, "right_eval:");
    try append_line(out, "  %left_value = extractvalue %kizu.error.i64 %left_result, 1");
    try append_line(out, "  %right_result = call %kizu.error.i64 @kizu_selfhost__cli_codegen_eval_const_i64_expr(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %right)");
    try append_line(out, "  %right_ok = extractvalue %kizu.error.i64 %right_result, 0");
    try append_line(out, "  br i1 %right_ok, label %values, label %right_fail");
