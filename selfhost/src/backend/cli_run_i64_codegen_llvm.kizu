fn append_find_i64_binary_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_find_i64_binary_function(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.child_range %declarations,");
    try append_line(out, "  %kizu.slice.u8 %callee_name");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %decl_len = extractvalue %kizu.kizu.ast.child_range %declarations, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next_index, %continue ]");
    try append_line(out, "  %more = icmp slt i64 %index, %decl_len");
    try append_line(out, "  br i1 %more, label %load_child, label %none");
    try append_line(out, "load_child:");
    try append_line(out, "  %child_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %declarations, i64 %index)");
    try append_line(out, "  %child_ok = extractvalue %kizu.error.node_id %child_result, 0");
    try append_line(out, "  br i1 %child_ok, label %child_bound, label %child_fail");
    try append_line(out, "child_bound:");
    try append_line(out, "  %child = extractvalue %kizu.error.node_id %child_result, 1");
    try append_line(out, "  %op_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_lower_i64_function_node(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %callee_name, %kizu.kizu.ast.node_id %child)");
    try append_line(out, "  %op_ok = extractvalue %kizu.error.i64 %op_result, 0");
    try append_line(out, "  br i1 %op_ok, label %op_bound, label %op_fail");
    try append_line(out, "op_bound:");
    try append_line(out, "  %op = extractvalue %kizu.error.i64 %op_result, 1");
    try out.append_bytes("  %is_none = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, tags.run_none);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_none, label %continue, label %found");
    try append_line(out, "continue:");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "found:");
    try append_line(out, "  ret %kizu.error.i64 %op_result");
    try append_error_i64_named_child_fail_block(out, "child_fail", "child_result");
    try append_line(out, "op_fail:");
    try append_line(out, "  ret %kizu.error.i64 %op_result");
    try append_none_error_i64_block(out, tags.run_none);
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_direct_i64_print_call_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_direct_i64_print_call(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.child_range %declarations,");
    try append_line(out, "  %kizu.slice.u8 %function_name,");
    try append_line(out, "  i64 %statement_count,");
    try append_line(out, "  %kizu.kizu.ast.node_id %print_callee,");
    try append_line(out, "  %kizu.kizu.ast.node_id %callee,");
    try append_line(out, "  %kizu.kizu.ast.child_range %args");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %args_len = extractvalue %kizu.kizu.ast.child_range %args, 1");
    try append_line(out, "  %two_args = icmp eq i64 %args_len, 2");
    try append_line(out, "  br i1 %two_args, label %callee_name, label %unsupported");
    try append_line(out, "callee_name:");
    try append_line(out, "  %callee_text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee)");
    try append_line(out, "  %callee_len = extractvalue %kizu.slice.u8 %callee_text, 1");
    try append_line(out, "  %callee_nonempty = icmp ne i64 %callee_len, 0");
    try append_line(out, "  br i1 %callee_nonempty, label %arg0_child, label %unsupported");
    try append_line(out, "arg0_child:");
    try append_line(out, "  %arg0_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %args, i64 0)");
    try append_line(out, "  %arg0_ok = extractvalue %kizu.error.node_id %arg0_result, 0");
    try append_line(out, "  br i1 %arg0_ok, label %arg1_child, label %arg0_child_fail");
    try append_line(out, "arg1_child:");
    try append_line(out, "  %arg0_node = extractvalue %kizu.error.node_id %arg0_result, 1");
    try append_line(out, "  %arg1_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %args, i64 1)");
    try append_line(out, "  %arg1_ok = extractvalue %kizu.error.node_id %arg1_result, 0");
    try append_line(out, "  br i1 %arg1_ok, label %arg_literals, label %arg1_child_fail");
    try append_line(out, "arg_literals:");
    try append_line(out, "  %arg1_node = extractvalue %kizu.error.node_id %arg1_result, 1");
    try append_line(out, "  %arg0_lit = call %kizu.error.i64 @kizu_selfhost__ir_codegen_call_arg_i64_literal(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %arg0_node)");
    try append_line(out, "  %arg0_lit_ok = extractvalue %kizu.error.i64 %arg0_lit, 0");
    try append_line(out, "  br i1 %arg0_lit_ok, label %arg1_lit_block, label %arg0_lit_fail");
    try append_line(out, "arg1_lit_block:");
    try append_line(out, "  %arg0 = extractvalue %kizu.error.i64 %arg0_lit, 1");
    try append_line(out, "  %arg1_lit = call %kizu.error.i64 @kizu_selfhost__ir_codegen_call_arg_i64_literal(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %arg1_node)");
    try append_line(out, "  %arg1_lit_ok = extractvalue %kizu.error.i64 %arg1_lit, 0");
    try append_line(out, "  br i1 %arg1_lit_ok, label %arg_values, label %arg1_lit_fail");
    try append_line(out, "arg_values:");
    try append_line(out, "  %arg1 = extractvalue %kizu.error.i64 %arg1_lit, 1");
    try append_line(out, "  %arg0_neg = icmp slt i64 %arg0, 0");
    try append_line(out, "  %arg1_neg = icmp slt i64 %arg1, 0");
    try append_line(out, "  %arg_neg = or i1 %arg0_neg, %arg1_neg");
    try append_line(out, "  br i1 %arg_neg, label %unsupported, label %find_op");
    try append_line(out, "find_op:");
    try append_line(out, "  %op_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_find_i64_binary_function(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %declarations, %kizu.slice.u8 %callee_text)");
    try append_line(out, "  %op_ok = extractvalue %kizu.error.i64 %op_result, 0");
    try append_line(out, "  br i1 %op_ok, label %check_op, label %op_fail");
    try append_line(out, "check_op:");
    try append_line(out, "  %op = extractvalue %kizu.error.i64 %op_result, 1");
    try out.append_bytes("  %op_none = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, tags.run_none);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %op_none, label %unsupported, label %check_div");
    try append_line(out, "check_div:");
    try out.append_bytes("  %op_div = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, tags.run_div);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %arg1_zero = icmp eq i64 %arg1, 0");
    try append_line(out, "  %div_zero = and i1 %op_div, %arg1_zero");
    try append_line(out, "  br i1 %div_zero, label %unsupported, label %check_sub");
    try append_line(out, "check_sub:");
    try out.append_bytes("  %op_sub = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, tags.run_sub);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %sub_negative = icmp slt i64 %arg0, %arg1");
    try append_line(out, "  %bad_sub = and i1 %op_sub, %sub_negative");
    try append_line(out, "  br i1 %bad_sub, label %unsupported, label %build");
    try append_line(out, "build:");
    try append_line(out, "  %print_text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %print_callee)");
    try append_line(out, "  %run = call %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_i64_call_run_ast(%kizu.slice.u8 %function_name, i64 %statement_count, %kizu.slice.u8 %print_text, %kizu.slice.u8 %callee_text, i64 %op, i64 %arg0, i64 %arg1)");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.run_ast poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.run_ast %ok0, %kizu.selfhost.codegen.run_ast %run, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.run_ast %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.run_ast %ok2");
    try append_error_run_ast_named_child_fail_block(out, "arg0_child_fail", "arg0_result");
    try append_error_run_ast_named_child_fail_block(out, "arg1_child_fail", "arg1_result");
    try append_error_run_ast_named_i64_fail_block(out, "arg0_lit_fail", "arg0_lit");
    try append_error_run_ast_named_i64_fail_block(out, "arg1_lit_fail", "arg1_lit");
    try append_error_run_ast_named_i64_fail_block(out, "op_fail", "op_result");
    try append_unsupported_run_ast_block(out);
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_none_error_i64_block(out: &var std::string::String, none_tag: i64) -> !void {
    try append_line(out, "none:");
    try append_line(out, "  %none0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try out.append_bytes("  %none1 = insertvalue %kizu.error.i64 %none0, i64 ");
    try std::fmt::append_i64(out, none_tag);
    try append_line(out, ", 1");
    try append_line(out, "  %none2 = insertvalue %kizu.error.i64 %none1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %none2");
    return;
}

fn append_error_i64_child_fail_block(
    out: &var std::string::String,
    result_name: []u8
) -> !void {
    try append_error_i64_named_child_fail_block(out, "child_fail", result_name);
    return;
}

fn append_error_i64_named_child_fail_block(
    out: &var std::string::String,
    label: []u8,
    result_name: []u8
) -> !void {
    try out.append_bytes(label);
    try append_line(out, ":");
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_err = extractvalue %kizu.error.node_id %");
    try out.append_bytes(result_name);
    try append_line(out, ", 2");
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try append_line(out, "_f0 = insertvalue %kizu.error.i64 poison, i1 false, 0");
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_f1 = insertvalue %kizu.error.i64 %");
    try out.append_bytes(label);
    try append_line(out, "_f0, i64 0, 1");
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_f2 = insertvalue %kizu.error.i64 %");
    try out.append_bytes(label);
    try out.append_bytes("_f1, %kizu.slice.u8 %");
    try out.append_bytes(label);
    try append_line(out, "_err, 2");
    try out.append_bytes("  ret %kizu.error.i64 %");
    try out.append_bytes(label);
    try append_line(out, "_f2");
    return;
}

