    try append_line(out, "let_payload_block:");
    try append_line(out, "  %let_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %let_data, ptr %let_slot, align 8");
    try append_line(out, "  %let_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %let_slot, i32 0, i32 1");
    try append_line(out, "  %let_payload = load %kizu.kizu.ast.let_node, ptr %let_payload_ptr, align 8");
    try append_line(out, "  %let_mutable = extractvalue %kizu.kizu.ast.let_node %let_payload, 0");
    try append_line(out, "  br i1 %let_mutable, label %unsupported, label %eval_let_value");
    try append_line(out, "eval_let_value:");
    try append_line(out, "  %let_name = extractvalue %kizu.kizu.ast.let_node %let_payload, 1");
    try append_line(out, "  %let_value = extractvalue %kizu.kizu.ast.let_node %let_payload, 2");
    try append_line(out, "  %local_name = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %let_name)");
    try append_line(out, "  %local_value_result = call %kizu.error.i64 @kizu_selfhost__cli_codegen_eval_const_i64_expr(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %let_value)");
    try append_line(out, "  %local_value_ok = extractvalue %kizu.error.i64 %local_value_result, 0");
    try append_line(out, "  br i1 %local_value_ok, label %local_value_bound, label %unsupported");
    try append_line(out, "local_value_bound:");
    try append_line(out, "  %local_value = extractvalue %kizu.error.i64 %local_value_result, 1");
    try append_line(out, "  %local_value_bad = icmp slt i64 %local_value, 0");
    try append_line(out, "  br i1 %local_value_bad, label %unsupported, label %load_if");
    try append_line(out, "load_if:");
    try append_line(out, "  %if_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 1)");
    try append_line(out, "  %if_ok = extractvalue %kizu.error.node_id %if_result, 0");
    try append_line(out, "  br i1 %if_ok, label %if_bound, label %unsupported");
    try append_line(out, "if_bound:");
    try append_line(out, "  %if_stmt = extractvalue %kizu.error.node_id %if_result, 1");
    try append_line(out, "  %if_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %if_stmt)");
    try append_line(out, "  %if_data = extractvalue %kizu.kizu.ast.ast_node %if_ast, 1");
    try append_line(out, "  %if_tag = extractvalue %kizu.kizu.ast.ast_data %if_data, 0");
    try out.append_bytes("  %is_if = icmp eq i64 %if_tag, ");
    try std::fmt::append_i64(out, tags.ast_if);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_if, label %if_payload_block, label %unsupported");
    try append_line(out, "if_payload_block:");
    try append_line(out, "  %if_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %if_data, ptr %if_slot, align 8");
    try append_line(out, "  %if_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %if_slot, i32 0, i32 1");
    try append_line(out, "  %if_payload = load %kizu.kizu.ast.if_node, ptr %if_payload_ptr, align 8");
    try append_line(out, "  %condition = extractvalue %kizu.kizu.ast.if_node %if_payload, 0");
    try append_line(out, "  %then_block = extractvalue %kizu.kizu.ast.if_node %if_payload, 1");
    try append_line(out, "  %else_block = extractvalue %kizu.kizu.ast.if_node %if_payload, 2");
    try append_line(out, "  %then_program = call %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_print_block_program(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %then_block)");
    try append_line(out, "  %then_supported = call i1 @kizu_selfhost__ir_codegen_program_supported(%kizu.selfhost.codegen.program %then_program)");
    try append_line(out, "  br i1 %then_supported, label %validate_else, label %unsupported");
    try append_line(out, "validate_else:");
    try append_line(out, "  %else_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %else_block)");
    try append_line(out, "  %else_data = extractvalue %kizu.kizu.ast.ast_node %else_ast, 1");
    try append_line(out, "  %else_tag = extractvalue %kizu.kizu.ast.ast_data %else_data, 0");
    try out.append_bytes("  %else_empty = icmp eq i64 %else_tag, ");
    try std::fmt::append_i64(out, tags.ast_empty);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %else_empty, label %else_return_void, label %else_print");
    try append_line(out, "else_return_void:");
    try append_line(out, "  %main_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.run_main, i64 0, i64 0");
    try append_line(out, "  %main_base = insertvalue %kizu.slice.u8 poison, ptr %main_ptr, 0");
    try append_line(out, "  %main_slice = insertvalue %kizu.slice.u8 %main_base, i64 4, 1");
    try append_line(out, "  %else_return_ast = call %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_return_void_run_ast(%kizu.slice.u8 %text, %kizu.slice.u8 %main_slice, i64 2)");
    try append_line(out, "  %else_return_program = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lowered_return_void_program(%kizu.selfhost.codegen.run_ast %else_return_ast)");
    try append_line(out, "  br label %else_program_bound");
    try append_line(out, "else_print:");
    try append_line(out, "  %else_print_program = call %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_print_block_program(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %else_block)");
    try append_line(out, "  %else_supported = call i1 @kizu_selfhost__ir_codegen_program_supported(%kizu.selfhost.codegen.program %else_print_program)");
    try append_line(out, "  br i1 %else_supported, label %else_program_bound, label %unsupported");
    try append_line(out, "else_program_bound:");
    try append_line(out, "  %else_program = phi %kizu.selfhost.codegen.program [ %else_return_program, %else_return_void ], [ %else_print_program, %else_print ]");
    try append_line(out, "  br label %eval_condition");
    try append_line(out, "eval_condition:");
    try append_line(out, "  %condition_result = call %kizu.error.bool @kizu_selfhost__cli_codegen_eval_const_bool_expr_one_local(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %condition, %kizu.slice.u8 %local_name, i64 %local_value)");
    try append_line(out, "  %condition_ok = extractvalue %kizu.error.bool %condition_result, 0");
    try append_line(out, "  br i1 %condition_ok, label %condition_bound, label %unsupported");
    try append_line(out, "condition_bound:");
    try append_line(out, "  %condition_value = extractvalue %kizu.error.bool %condition_result, 1");
    try append_line(out, "  br i1 %condition_value, label %lower_then, label %lower_else");
    try append_line(out, "lower_then:");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %then_program");
    try append_line(out, "lower_else:");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %else_program");
    try append_unsupported_program_block(out);
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_const_single_if_program_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_single_if_program(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %statement");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %statement_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  %statement_data = extractvalue %kizu.kizu.ast.ast_node %statement_ast, 1");
    try append_line(out, "  %statement_tag = extractvalue %kizu.kizu.ast.ast_data %statement_data, 0");
    try out.append_bytes("  %is_if = icmp eq i64 %statement_tag, ");
