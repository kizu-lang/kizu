fn append_lower_const_i64_program_function(
    out: &var std::string::String,
    tags: &I64RunTags
) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_i64_program(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.parse_result %parsed");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ast = extractvalue %kizu.kizu.ast.parse_result %parsed, 0");
    try append_line(out, "  %root = extractvalue %kizu.kizu.ast.parse_result %parsed, 1");
    try append_line(out, "  %root_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %root)");
    try append_line(out, "  %root_data = extractvalue %kizu.kizu.ast.ast_node %root_node, 1");
    try append_line(out, "  %root_tag = extractvalue %kizu.kizu.ast.ast_data %root_data, 0");
    try out.append_bytes("  %is_program = icmp eq i64 %root_tag, ");
    try std::fmt::append_i64(out, tags.ast_program);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_program, label %program_payload_block, label %unsupported");
    try append_line(out, "program_payload_block:");
    try append_line(out, "  %program_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %root_data, ptr %program_slot, align 8");
    try append_line(out, "  %program_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %program_slot, i32 0, i32 1");
    try append_line(out, "  %program_payload = load %kizu.kizu.ast.program_node, ptr %program_payload_ptr, align 8");
    try append_line(out, "  %decls = extractvalue %kizu.kizu.ast.program_node %program_payload, 0");
    try append_line(out, "  %decl_len = extractvalue %kizu.kizu.ast.child_range %decls, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %program_payload_block ], [ %next_index, %continue ]");
    try append_line(out, "  %more = icmp slt i64 %index, %decl_len");
    try append_line(out, "  br i1 %more, label %load_decl, label %unsupported");
    try append_line(out, "load_decl:");
    try append_line(out, "  %decl_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %decls, i64 %index)");
    try append_line(out, "  %decl_ok = extractvalue %kizu.error.node_id %decl_result, 0");
    try append_line(out, "  br i1 %decl_ok, label %decl_bound, label %unsupported");
    try append_line(out, "decl_bound:");
    try append_line(out, "  %decl = extractvalue %kizu.error.node_id %decl_result, 1");
    try append_line(out, "  %decl_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %decl)");
    try append_line(out, "  %decl_data = extractvalue %kizu.kizu.ast.ast_node %decl_node, 1");
    try append_line(out, "  %decl_tag = extractvalue %kizu.kizu.ast.ast_data %decl_data, 0");
    try out.append_bytes("  %is_fn = icmp eq i64 %decl_tag, ");
    try std::fmt::append_i64(out, tags.ast_fn_decl);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_fn, label %fn_payload_block, label %continue");
    try append_line(out, "fn_payload_block:");
    try append_line(out, "  %fn_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %decl_data, ptr %fn_slot, align 8");
    try append_line(out, "  %fn_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %fn_slot, i32 0, i32 1");
    try append_line(out, "  %fn_payload = load %kizu.kizu.ast.fn_decl_node, ptr %fn_payload_ptr, align 8");
    try append_line(out, "  %fn_name = extractvalue %kizu.kizu.ast.fn_decl_node %fn_payload, 3");
    try append_line(out, "  %fn_name_text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %fn_name)");
    try append_line(out, "  %main_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.run_main, i64 0, i64 0");
    try append_line(out, "  %main_base = insertvalue %kizu.slice.u8 poison, ptr %main_ptr, 0");
    try append_line(out, "  %main_slice = insertvalue %kizu.slice.u8 %main_base, i64 4, 1");
    try append_line(out, "  %is_main = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fn_name_text, %kizu.slice.u8 %main_slice)");
    try append_line(out, "  br i1 %is_main, label %body_node, label %continue");
    try append_line(out, "body_node:");
    try append_line(out, "  %body = extractvalue %kizu.kizu.ast.fn_decl_node %fn_payload, 8");
    try append_line(out, "  %body_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %body)");
    try append_line(out, "  %body_data = extractvalue %kizu.kizu.ast.ast_node %body_ast, 1");
    try append_line(out, "  %body_tag = extractvalue %kizu.kizu.ast.ast_data %body_data, 0");
    try out.append_bytes("  %is_block = icmp eq i64 %body_tag, ");
    try std::fmt::append_i64(out, tags.ast_block);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_block, label %block_payload_block, label %unsupported");
    try append_line(out, "block_payload_block:");
    try append_line(out, "  %block_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %body_data, ptr %block_slot, align 8");
    try append_line(out, "  %block_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %block_slot, i32 0, i32 1");
    try append_line(out, "  %block_payload = load %kizu.kizu.ast.block_node, ptr %block_payload_ptr, align 8");
    try append_line(out, "  %statements = extractvalue %kizu.kizu.ast.block_node %block_payload, 0");
    try append_line(out, "  %statement_len = extractvalue %kizu.kizu.ast.child_range %statements, 1");
    try append_line(out, "  %one_statement = icmp eq i64 %statement_len, 1");
    try append_line(out, "  br i1 %one_statement, label %statement_child, label %try_let_if");
    try append_line(out, "try_let_if:");
    try append_line(out, "  %let_if_program = call %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_let_if_program(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %let_if_program");
    try append_line(out, "statement_child:");
    try append_line(out, "  %statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %statement_ok = extractvalue %kizu.error.node_id %statement_result, 0");
    try append_line(out, "  br i1 %statement_ok, label %statement_bound, label %unsupported");
    try append_line(out, "statement_bound:");
    try append_line(out, "  %statement = extractvalue %kizu.error.node_id %statement_result, 1");
    try append_line(out, "  %statement_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  %statement_data = extractvalue %kizu.kizu.ast.ast_node %statement_ast, 1");
    try append_line(out, "  %statement_tag = extractvalue %kizu.kizu.ast.ast_data %statement_data, 0");
    try out.append_bytes("  %is_expr_stmt = icmp eq i64 %statement_tag, ");
    try std::fmt::append_i64(out, tags.ast_expr_stmt);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_expr_stmt, label %expr_stmt_payload, label %try_single_if");
    try append_line(out, "try_single_if:");
    try append_line(out, "  %single_if_program = call %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_single_if_program(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %single_if_program");
    try append_line(out, "expr_stmt_payload:");
    try append_line(out, "  %expr_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %statement_data, ptr %expr_slot, align 8");
    try append_line(out, "  %expr_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %expr_slot, i32 0, i32 1");
    try append_line(out, "  %expr_payload = load %kizu.kizu.ast.expr_stmt_node, ptr %expr_payload_ptr, align 8");
    try append_line(out, "  %expr = extractvalue %kizu.kizu.ast.expr_stmt_node %expr_payload, 0");
    try append_line(out, "  %call_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %expr)");
    try append_line(out, "  %call_data = extractvalue %kizu.kizu.ast.ast_node %call_ast, 1");
    try append_line(out, "  %call_tag = extractvalue %kizu.kizu.ast.ast_data %call_data, 0");
    try out.append_bytes("  %is_call = icmp eq i64 %call_tag, ");
    try std::fmt::append_i64(out, tags.ast_call);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_call, label %call_payload_block, label %unsupported");
    try append_line(out, "call_payload_block:");
    try append_line(out, "  %call_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %call_data, ptr %call_slot, align 8");
    try append_line(out, "  %call_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %call_slot, i32 0, i32 1");
    try append_line(out, "  %call_payload = load %kizu.kizu.ast.call_node, ptr %call_payload_ptr, align 8");
    try append_line(out, "  %callee = extractvalue %kizu.kizu.ast.call_node %call_payload, 0");
    try append_line(out, "  %args = extractvalue %kizu.kizu.ast.call_node %call_payload, 1");
    try append_line(out, "  %callee_text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee)");
    try append_line(out, "  %print_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.run_print, i64 0, i64 0");
    try append_line(out, "  %print_base = insertvalue %kizu.slice.u8 poison, ptr %print_ptr, 0");
    try append_line(out, "  %print_slice = insertvalue %kizu.slice.u8 %print_base, i64 5, 1");
    try append_line(out, "  %is_print = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %callee_text, %kizu.slice.u8 %print_slice)");
    try append_line(out, "  br i1 %is_print, label %arg_count, label %unsupported");
    try append_line(out, "arg_count:");
    try append_line(out, "  %arg_len = extractvalue %kizu.kizu.ast.child_range %args, 1");
    try append_line(out, "  %one_arg = icmp eq i64 %arg_len, 1");
    try append_line(out, "  br i1 %one_arg, label %arg_child, label %unsupported");
    try append_line(out, "arg_child:");
    try append_line(out, "  %arg_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %args, i64 0)");
    try append_line(out, "  %arg_ok = extractvalue %kizu.error.node_id %arg_result, 0");
    try append_line(out, "  br i1 %arg_ok, label %build, label %unsupported");
    try append_line(out, "build:");
    try append_line(out, "  %arg = extractvalue %kizu.error.node_id %arg_result, 1");
    try append_line(out, "  %program = call %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_const_i64_print_program(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %arg)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %program");
    try append_line(out, "continue:");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_unsupported_program_block(out);
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_none_error_i64_block(out: &var std::string::String, none_tag: i64) -> !void {
    try append_line(out, "none:");
    try append_line(out, "  %none0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try out.append_bytes("  %none1 = insertvalue %kizu.error.i64 %none0, i64 ");
    try std::fmt::append_i64(out, none_tag);
    try append_line(out, ", 1");
    try append_line(out, "  %none2 = insertvalue %kizu.error.i64 %none1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %none2");
    return;
}

fn append_error_i64_child_fail_block(
    out: &var std::string::String,
    result_name: []u8
) -> !void {
    try append_error_i64_named_child_fail_block(out, "child_fail", result_name);
    return;
}

fn append_error_i64_named_child_fail_block(
    out: &var std::string::String,
    label: []u8,
    result_name: []u8
) -> !void {
    try out.append_bytes(label);
    try append_line(out, ":");
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_err = extractvalue %kizu.error.node_id %");
    try out.append_bytes(result_name);
    try append_line(out, ", 2");
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try append_line(out, "_f0 = insertvalue %kizu.error.i64 poison, i1 false, 0");
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_f1 = insertvalue %kizu.error.i64 %");
    try out.append_bytes(label);
    try append_line(out, "_f0, i64 0, 1");
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_f2 = insertvalue %kizu.error.i64 %");
    try out.append_bytes(label);
    try out.append_bytes("_f1, %kizu.slice.u8 %");
    try out.append_bytes(label);
    try append_line(out, "_err, 2");
    try out.append_bytes("  ret %kizu.error.i64 %");
    try out.append_bytes(label);
    try append_line(out, "_f2");
    return;
}

