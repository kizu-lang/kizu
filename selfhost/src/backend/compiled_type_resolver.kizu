pub fn generic_intrinsic_abi_gate() -> !void {
    let facts = "abi-repr ptr ptr
nullable-abi-repr ptr ptr
abi-repr []u8 %kizu.slice.u8";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let pointer = try resolve_type_indexed(
        &index, facts, "app::", "ptr<app::Model>"
    );
    let nullable_pointer = try resolve_type_indexed(
        &index, facts, "app::", "?ptr<app::Model>"
    );
    let bytes = try resolve_type_indexed(&index, facts, "app::", "[]u8");
    std::testing::expect_equal<[]u8>("ptr", pointer.canonical_identity);
    std::testing::expect_equal<[]u8>("ptr", pointer.abi);
    std::testing::expect_equal<[]u8>("?ptr<app::Model>", nullable_pointer.full_spelling);
    std::testing::expect_equal<[]u8>("ptr", nullable_pointer.canonical_identity);
    std::testing::expect_equal<[]u8>("ptr", nullable_pointer.abi);
    std::testing::expect_equal<[]u8>("%kizu.slice.u8", bytes.abi);
    return;
}

pub fn invalid_nullable_abi_gate() -> !void {
    let facts = "abi-repr ptr ptr
nullable-abi-repr ptr ptr";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let unused = try resolve_type_indexed(&index, facts, "app::", "?i64");
    print(unused.abi);
    return;
}

fn previous_token_start(bytes: []u8, line_start: i64, token_end: i64) -> i64 {
    var cursor = token_end;
    while cursor > line_start and bytes[cursor - 1] == cast<u8>(32) {
        cursor = cursor - 1;
    }
    while cursor > line_start and bytes[cursor - 1] != cast<u8>(32) {
        cursor = cursor - 1;
    }
    return cursor;
}

fn skip_ascii_spaces(bytes: []u8, start: i64, end: i64) -> i64 {
    var cursor = start;
    while cursor < end and bytes[cursor] == cast<u8>(32) {
        cursor = cursor + 1;
    }
    return cursor;
}

fn skip_ascii_token(bytes: []u8, start: i64, end: i64) -> i64 {
    var cursor = start;
    while cursor < end and bytes[cursor] != cast<u8>(32) {
        cursor = cursor + 1;
    }
    return cursor;
}

fn parse_decimal_i64_range(
    bytes: []u8,
    start: i64,
    end: i64
) -> !i64 {
    if start >= end { return error("compiled type resolver: empty integer fact token"); }
    var value = 0;
    var cursor = start;
    while cursor < end {
        let byte = bytes[cursor];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return error("compiled type resolver: invalid integer fact token");
        }
        value = value * 10 + cast<i64>(byte - cast<u8>(48));
        cursor = cursor + 1;
    }
    return value;
}

pub fn resolve_call_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64
) -> !ResolvedFunction {
    let target = try call_target_indexed(index, ir_bytes, function_name, call_node);
    if !target.found {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled type resolver: body call target not found: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" node ");
        try std::fmt::append_i64(&var message, call_node);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    return try resolve_function_indexed(
        index, ir_bytes, ir_bytes[0..0], target.canonical_identity
    );
}

pub struct FactValue {
    pub found: bool,
    pub value: []u8,
    pub canonical_identity: []u8,
}

fn reject_canonical_kind_conflict(left: &FactValue, right: &FactValue) -> !void {
    if !left.found or !right.found or !std::mem::equal_bytes(
        left.canonical_identity, right.canonical_identity
    ) {
        return;
    }
    if !std::mem::equal_bytes(left.value, right.value) {
        return error("compiled type resolver: canonical type kind ABI mismatch");
    }
    return error("compiled type resolver: duplicate canonical type kind");
}

// exact_type_llvm_indexed classifies one already-resolved canonical identity.
// A miss is a normal non-nominal type; duplicate exact facts remain an error.
pub fn exact_type_llvm_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_identity: []u8
) -> !FactValue {
    if std::mem::len(canonical_identity) == 0 {
        return error("compiled type resolver: empty canonical type identity");
    }
    return try exact_unique_fact_value_indexed(
        index, ir_bytes, "type-llvm ", ir_bytes[0..0], canonical_identity
    );
}

// exact_union_type_indexed classifies one already-resolved tagged union. Its
// value is the LLVM named type; union-variant facts own the recursive payload
// layout inputs.
pub fn exact_union_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_identity: []u8
) -> !FactValue {
    if std::mem::len(canonical_identity) == 0 {
        return error("compiled type resolver: empty canonical union identity");
    }
    return try exact_unique_fact_value_indexed(
        index, ir_bytes, "union-type ", ir_bytes[0..0], canonical_identity
    );
}

fn empty_fact_value(ir_bytes: []u8) -> FactValue {
    return FactValue {
        found: false,
        value: ir_bytes[0..0],
        canonical_identity: ir_bytes[0..0]
    };
}

fn resolved_type_from_fact(
    fact: FactValue,
    full_spelling: []u8,
    spelling_module: []u8
) -> ResolvedType {
    return ResolvedType {
        full_spelling: full_spelling,
        canonical_identity: fact.canonical_identity,
        abi: fact.value,
        declaring_module: compiled_util::module_prefix_of(fact.canonical_identity),
        spelling_module: spelling_module
    };
}

fn primitive_llvm_or_empty(kizu_type: []u8) -> []u8 {
    let scalar = fixed_abi_contract::from_kizu_scalar(kizu_type);
    if scalar.kind != fixed_abi_contract::FixedAbiKind::Missing {
        return scalar.llvm_name;
    }
    return kizu_type[0..0];
}

// type_constructor removes generic arguments while preserving the canonical
// constructor spelling: Map<[]u8, T> and Map<i64, bool> share one abi-repr fact.
fn type_constructor(kizu_type: []u8) -> []u8 {
    let len = std::mem::len(kizu_type);
    var cursor = 0;
    while cursor < len {
        if kizu_type[cursor] == cast<u8>(60) {
            return kizu_type[0..cursor];
        }
        cursor = cursor + 1;
    }
    return kizu_type;
}

fn resolve_fact_value_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    fact_prefix: []u8,
    module_prefix: []u8,
    type_name: []u8
) -> !FactValue {
    if !contains_double_colon(type_name) {
        let local = try exact_unique_fact_value_indexed(
            index, ir_bytes, fact_prefix, module_prefix, type_name
        );
        if local.found { return local; }
        let intrinsic = try exact_unique_fact_value_indexed(
            index, ir_bytes, fact_prefix, ir_bytes[0..0], type_name
        );
        if intrinsic.found { return intrinsic; }
        return empty_fact_value(ir_bytes);
    }
    // An exact canonical identity wins before interpreting the first segment as
    // an import alias. Thus std::foo::T cannot be shadowed by an alias named std.
    let canonical = try exact_unique_fact_value_indexed(
        index, ir_bytes, fact_prefix, ir_bytes[0..0], type_name
    );
    if canonical.found { return canonical; }
    let alias = split_alias(type_name);
    if !alias.found { return empty_fact_value(ir_bytes); }
    let package_root = try exact_unique_fact_value_indexed(
        index, ir_bytes, "package-root ", "", alias.prefix
    );
    if package_root.found { return empty_fact_value(ir_bytes); }
    let target = try exact_unique_fact_value_indexed(
        index, ir_bytes, "module-alias ", module_prefix, alias.prefix
    );
    if !target.found { return empty_fact_value(ir_bytes); }
    return try exact_unique_fact_value_indexed(
        index, ir_bytes, fact_prefix, target.value, alias.remainder
    );
}

fn contains_double_colon(type_name: []u8) -> bool {
    return split_alias(type_name).found;
}

pub struct AliasSplit {
    pub found: bool,
    pub prefix: []u8,
    pub remainder: []u8,
}

fn split_alias(type_name: []u8) -> AliasSplit {
    let len = std::mem::len(type_name);
    var cursor = 0;
    while cursor + 1 < len {
        if type_name[cursor] == cast<u8>(58) and
            type_name[cursor + 1] == cast<u8>(58) {
            return AliasSplit {
                found: true,
                prefix: type_name[0..cursor],
                remainder: type_name[cursor + 2..len]
            };
        }
        cursor = cursor + 1;
    }
    return AliasSplit {
        found: false,
        prefix: type_name[0..0],
        remainder: type_name[0..0]
    };
}

// exact_unique_fact_value_indexed rejects duplicates before a first-match-wins
// lookup could hide declaration or representation debt.
fn exact_unique_fact_value_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    fact_prefix: []u8,
    module_prefix: []u8,
    type_name: []u8
) -> !FactValue {
    var entry = ir_index::first_matching_entry(
        index, ir_bytes, fact_prefix, module_prefix, type_name
    );
    if entry < 0 { return empty_fact_value(ir_bytes); }
    let first = fact_entry_value(index, ir_bytes, entry);
    entry = entry + 1;
    if ir_index::entry_matches_query(
        index, ir_bytes, entry, fact_prefix, module_prefix, type_name
    ) {
        return error("compiled type resolver: duplicate exact fact");
    }
    let key_start = ir_index::entry_line_start(index, entry - 1) +
        std::mem::len(fact_prefix);
    let key_end = ir_index::entry_key_end(index, entry - 1);
    return FactValue {
        found: true,
        value: first,
        canonical_identity: ir_bytes[key_start..key_end]
    };
}

pub fn gate_body_call_instance_symbol_mismatch() -> !void {
    let facts = "body-node app::root 0 depth 0 kind Call span 10 20
body-call-target app::root 10 20 app::generic::identity
package-definition-name 0 0 app::generic::identity
function-instance-symbol 0 0 0 kizu_instance_0_0_0
body-call-instance app::root 10 20 0 0 0 kizu_instance_wrong";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let result = try call_instance_symbol_indexed(
        &index, facts, "app::root", 0
    );
    print(result.canonical_identity);
    return;
}

