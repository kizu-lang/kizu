fn fact_entry_value(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    entry: i64
) -> []u8 {
    let line_end = ir_index::entry_line_end(index, entry);
    var start = ir_index::entry_key_end(index, entry);
    while start < line_end and ir_bytes[start] == cast<u8>(32) {
        start = start + 1;
    }
    return ir_bytes[start..line_end];
}
