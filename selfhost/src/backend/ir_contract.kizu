pub fn require_fact(bytes: []u8, fact: []u8) -> !void {
    if !contains(bytes, fact) {
        return error("unsupported IR artifact contract");
    }
    return;
}

pub fn contains(bytes: []u8, needle: []u8) -> bool {
    let byte_len = std::mem::len(bytes);
    let needle_len = std::mem::len(needle);
    if needle_len == 0 {
        return true;
    }
    if needle_len > byte_len {
        return false;
    }

    var index = 0;
    let last_start = byte_len - needle_len;
    while index <= last_start {
        if std::mem::equal_bytes(bytes[index..index + needle_len], needle) {
            return true;
        }
        index = index + 1;
    }
    return false;
}
