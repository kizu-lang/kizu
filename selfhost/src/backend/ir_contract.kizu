pub fn require_fact(bytes: []u8, fact: []u8) -> !void {
    if !contains(bytes, fact) {
        return error("unsupported IR artifact contract");
    }
    return;
}

pub fn contains(bytes: []u8, needle: []u8) -> bool {
    let byte_len = std::mem::len(bytes);
    let needle_len = std::mem::len(needle);
    if needle_len == 0 {
        return true;
    }
    if needle_len > byte_len {
        return false;
    }

    var index = 0;
    let first = needle[0];
    let last_start = byte_len - needle_len;
    while index <= last_start {
        if bytes[index] == first and
            std::mem::equal_bytes(bytes[index..index + needle_len], needle) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

pub fn named_i64_fact(bytes: []u8, prefix: []u8, name: []u8) -> !i64 {
    let value_start = try named_fact_value_start(bytes, prefix, name);
    return try parse_i64_token(bytes, value_start);
}

pub fn named_fact_value(bytes: []u8, prefix: []u8, name: []u8) -> ![]u8 borrows bytes {
    let value_start = try named_fact_value_start(bytes, prefix, name);
    let value_end = token_end(bytes, value_start);
    return bytes[value_start..value_end];
}

pub fn named_fact_line_value(
    bytes: []u8,
    prefix: []u8,
    name: []u8
) -> ![]u8 borrows bytes {
    let value_start = try named_fact_value_start(bytes, prefix, name);
    let value_end = line_end(bytes, value_start);
    return bytes[value_start..value_end];
}

pub fn require_named_fact(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    value: []u8
) -> !void {
    let actual = try named_fact_value(bytes, prefix, name);
    if !std::mem::equal_bytes(actual, value) {
        return error("invalid IR artifact fact");
    }
    return;
}

pub fn require_named_line_fact(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    value: []u8
) -> !void {
    let actual = try named_fact_line_value(bytes, prefix, name);
    if !std::mem::equal_bytes(actual, value) {
        return error("invalid IR artifact fact");
    }
    return;
}

pub fn require_named_i64_fact(bytes: []u8, prefix: []u8, name: []u8) -> !void {
    let value = try named_i64_fact(bytes, prefix, name);
    if value < 0 {
        return error("invalid IR artifact fact");
    }
    return;
}

pub fn enum_variant_tag(bytes: []u8, enum_name: []u8, variant_name: []u8) -> !i64 {
    let value_start = try enum_variant_tag_start(bytes, enum_name, variant_name);
    return try parse_i64_token(bytes, value_start);
}

pub fn sequence_fact_value(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64
) -> ![]u8 borrows bytes {
    let value_start = try sequence_fact_value_start(bytes, prefix, name, sequence);
    let value_end = token_end(bytes, value_start);
    return bytes[value_start..value_end];
}

pub fn sequence_fact_line_value(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64
) -> ![]u8 borrows bytes {
    let value_start = try sequence_fact_value_start(bytes, prefix, name, sequence);
    let value_end = line_end(bytes, value_start);
    return bytes[value_start..value_end];
}

pub fn sequence_fact_second_value(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64
) -> ![]u8 borrows bytes {
    let first_start = try sequence_fact_value_start(bytes, prefix, name, sequence);
    let first_end = token_end(bytes, first_start);
    let second_start = skip_spaces(bytes, first_end);
    let second_end = token_end(bytes, second_start);
    if second_start == second_end {
        return error("missing IR artifact fact: sequence_fact_second_value");
    }
    return bytes[second_start..second_end];
}

pub fn sequence_fact_value_or_empty(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64
) -> ![]u8 borrows bytes {
    let byte_len = std::mem::len(bytes);
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], name) and
                is_space(bytes[name_end]) {
                let value_start = try sequence_fact_value_start_in_line(
                    bytes,
                    name_end,
                    sequence
                );
                if value_start >= 0 {
                    let value_end = token_end(bytes, value_start);
                    return bytes[value_start..value_end];
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return bytes[0..0];
}

pub fn sequence_fact_exists(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64
) -> !bool {
    let byte_len = std::mem::len(bytes);
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], name) and
                is_space(bytes[name_end]) {
                let sequence_start = skip_spaces(bytes, name_end);
                let actual = try parse_i64_token(bytes, sequence_start);
                if actual == sequence {
                    return true;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return false;
}

fn enum_variant_tag_start(bytes: []u8, enum_name: []u8, variant_name: []u8) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "enum-variant ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(enum_name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], enum_name) and
                is_space(bytes[name_end]) {
                let variant_start = skip_spaces(bytes, name_end);
                let variant_end = token_end(bytes, variant_start);
                if std::mem::equal_bytes(bytes[variant_start..variant_end], variant_name) {
                    return skip_spaces(bytes, variant_end);
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: enum_variant_value_start");
}

pub fn body_token_or_empty(
    bytes: []u8,
    function_name: []u8,
    sequence: i64
) -> ![]u8 borrows bytes {
    return try sequence_fact_value_or_empty(bytes, "body-token ", function_name, sequence);
}

pub fn body_call_callee_or_empty(
    bytes: []u8,
    function_name: []u8,
    sequence: i64
) -> ![]u8 borrows bytes {
    return try sequence_fact_value_or_empty(bytes, "body-call ", function_name, sequence);
}

pub fn body_parent_with_child_token(
    bytes: []u8,
    function_name: []u8,
    edge: []u8,
    ordinal: i64,
    token: []u8
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-edge ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                let parent = try body_edge_line_parent_with_child_token(
                    bytes,
                    function_name,
                    name_end,
                    edge,
                    ordinal,
                    token
                );
                if parent >= 0 {
                    return parent;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: body_parent_sequence_with_child_token");
}

pub fn body_struct_literal_of_type(
    bytes: []u8,
    function_name: []u8,
    type_name: []u8,
    ordinal: i64
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-struct-literal ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = 0;
    var matched = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                let sequence = try body_struct_literal_line_sequence_or_minus_one(
                    bytes,
                    name_end,
                    type_name
                );
                if sequence >= 0 {
                    if matched == ordinal {
                        return sequence;
                    }
                    matched = matched + 1;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: body_struct_literal_of_type");
}

pub fn body_struct_field_value(
    bytes: []u8,
    function_name: []u8,
    struct_literal: i64,
    field_name: []u8
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-edge ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                let field = try body_edge_line_child_for_parent_edge(
                    bytes,
                    name_end,
                    struct_literal,
                    "field"
                );
                if field >= 0 {
                    let actual = try sequence_fact_value(
                        bytes,
                        "body-field-init ",
                        function_name,
                        field
                    );
                    if std::mem::equal_bytes(actual, field_name) {
                        return try body_child_sequence(
                            bytes,
                            function_name,
                            field,
                            "value",
                            0
                        );
                    }
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: body_struct_field_value");
}

pub fn body_field_expr_name(
    bytes: []u8,
    function_name: []u8,
    sequence: i64,
    mode: []u8
) -> ![]u8 borrows bytes {
    let actual_mode = try sequence_fact_second_value(
        bytes,
        "body-field-expr ",
        function_name,
        sequence
    );
    if !std::mem::equal_bytes(actual_mode, mode) {
        return error("invalid IR artifact fact");
    }
    return try sequence_fact_value(bytes, "body-field-expr ", function_name, sequence);
}

pub fn sequence_fact_count(bytes: []u8, prefix: []u8, name: []u8) -> !i64 {
    var count = 0;
    while try sequence_fact_exists(bytes, prefix, name, count) {
        count = count + 1;
    }
    return count;
}

pub fn body_node_count(bytes: []u8, function_name: []u8) -> !i64 {
    let count = try sequence_fact_count(bytes, "body-node ", function_name);
    if count < 1 {
        return error("missing IR artifact fact: body_node_count");
    }
    return count;
}

pub fn body_node_count_from(bytes: []u8, function_name: []u8, from: i64) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-node ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = from;
    var count = 0;
    var seen = false;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                seen = true;
                count = count + 1;
            } else {
                if seen {
                    return count;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    if count < 1 {
        return error("missing IR artifact fact: body_node_count_from");
    }
    return count;
}

pub fn body_node_kind(
    bytes: []u8,
    function_name: []u8,
    sequence: i64
) -> ![]u8 borrows bytes {
    let value_start = try body_node_kind_start(bytes, function_name, sequence);
    let value_end = token_end(bytes, value_start);
    return bytes[value_start..value_end];
}

pub fn body_int_value(bytes: []u8, function_name: []u8, sequence: i64) -> !i64 {
    let kind = try body_node_kind(bytes, function_name, sequence);
    if !std::mem::equal_bytes(kind, "Int") {
        return error("invalid IR artifact fact");
    }
    let token = try sequence_fact_value(bytes, "body-token ", function_name, sequence);
    return try parse_i64_token(token, 0);
}

pub fn body_child_sequence(
    bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64
) -> !i64 {
    let child = try body_child_sequence_or_minus_one(
        bytes,
        function_name,
        parent_sequence,
        edge,
        ordinal
    );
    if child >= 0 {
        return child;
    }
    return error("missing IR artifact fact: body_child_sequence");
}

pub fn body_child_sequence_or_minus_one(
    bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-edge ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                let child = try body_child_sequence_in_line(
                    bytes,
                    name_end,
                    parent_sequence,
                    edge,
                    ordinal
                );
                if child >= 0 {
                    return child;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return -1;
}

pub fn body_edge_count(
    bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-edge ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    let edge_len = std::mem::len(edge);
    var index = 0;
    var count = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                let parent_start = skip_spaces(bytes, name_end);
                let actual_parent = try parse_i64_token(bytes, parent_start);
                if actual_parent == parent_sequence {
                    let parent_end = token_end(bytes, parent_start);
                    let edge_start = skip_spaces(bytes, parent_end);
                    let edge_end = token_end(bytes, edge_start);
                    if std::mem::equal_bytes(bytes[edge_start..edge_end], edge) {
                        count = count + 1;
                    }
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return count;
}

pub fn require_body_call(bytes: []u8, function_name: []u8, callee: []u8) -> !void {
    if try body_has_call(bytes, function_name, callee) {
        return;
    }
    return error("missing IR artifact fact: require_body_call");
}

pub fn body_has_call(bytes: []u8, function_name: []u8, callee: []u8) -> !bool {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-call ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) and body_call_line_matches(bytes, name_end, callee) {
                return true;
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return false;
}

pub fn require_sequence_fact(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64,
    value: []u8
) -> !void {
    let actual = try sequence_fact_value(bytes, prefix, name, sequence);
    if !std::mem::equal_bytes(actual, value) {
        return error("invalid IR artifact fact");
    }
    return;
}

fn body_child_sequence_in_line(
    bytes: []u8,
    name_end: i64,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64
) -> !i64 {
    let parent_start = skip_spaces(bytes, name_end);
    let actual_parent = try parse_i64_token(bytes, parent_start);
    if actual_parent != parent_sequence {
        return -1;
    }

    let parent_end = token_end(bytes, parent_start);
    let edge_start = skip_spaces(bytes, parent_end);
    let edge_end = token_end(bytes, edge_start);
    if !std::mem::equal_bytes(bytes[edge_start..edge_end], edge) {
        return -1;
    }

    let ordinal_start = skip_spaces(bytes, edge_end);
    let actual_ordinal = try parse_i64_token(bytes, ordinal_start);
    if actual_ordinal != ordinal {
        return -1;
    }

    let ordinal_end = token_end(bytes, ordinal_start);
    let child_start = skip_spaces(bytes, ordinal_end);
    return try parse_i64_token(bytes, child_start);
}

fn body_edge_line_parent_with_child_token(
    bytes: []u8,
    function_name: []u8,
    name_end: i64,
    edge: []u8,
    ordinal: i64,
    token: []u8
) -> !i64 {
    let parent_start = skip_spaces(bytes, name_end);
    let parent = try parse_i64_token(bytes, parent_start);
    let parent_end = token_end(bytes, parent_start);
    let edge_start = skip_spaces(bytes, parent_end);
    let edge_end = token_end(bytes, edge_start);
    if !std::mem::equal_bytes(bytes[edge_start..edge_end], edge) {
        return -1;
    }

    let ordinal_start = skip_spaces(bytes, edge_end);
    let actual_ordinal = try parse_i64_token(bytes, ordinal_start);
    if actual_ordinal != ordinal {
        return -1;
    }

    let ordinal_end = token_end(bytes, ordinal_start);
    let child_start = skip_spaces(bytes, ordinal_end);
    let child = try parse_i64_token(bytes, child_start);
    let actual = try body_token_or_empty(bytes, function_name, child);
    if std::mem::equal_bytes(actual, token) {
        return parent;
    }
    return -1;
}

fn body_struct_literal_line_sequence_or_minus_one(
    bytes: []u8,
    name_end: i64,
    type_name: []u8
) -> !i64 {
    let sequence_start = skip_spaces(bytes, name_end);
    let sequence = try parse_i64_token(bytes, sequence_start);
    let sequence_end = token_end(bytes, sequence_start);
    let actual_start = skip_spaces(bytes, sequence_end);
    let actual_end = token_end(bytes, actual_start);
    if std::mem::equal_bytes(bytes[actual_start..actual_end], type_name) {
        return sequence;
    }
    return -1;
}

fn body_edge_line_child_for_parent_edge(
    bytes: []u8,
    name_end: i64,
    parent: i64,
    edge: []u8
) -> !i64 {
    let parent_start = skip_spaces(bytes, name_end);
    let actual_parent = try parse_i64_token(bytes, parent_start);
    if actual_parent != parent {
        return -1;
    }

    let parent_end = token_end(bytes, parent_start);
    let edge_start = skip_spaces(bytes, parent_end);
    let edge_end = token_end(bytes, edge_start);
    if !std::mem::equal_bytes(bytes[edge_start..edge_end], edge) {
        return -1;
    }

    let ordinal_start = skip_spaces(bytes, edge_end);
    let ordinal_end = token_end(bytes, ordinal_start);
    let child_start = skip_spaces(bytes, ordinal_end);
    return try parse_i64_token(bytes, child_start);
}

fn body_call_line_matches(bytes: []u8, name_end: i64, callee: []u8) -> bool {
    let sequence_start = skip_spaces(bytes, name_end);
    let sequence_end = token_end(bytes, sequence_start);
    let callee_start = skip_spaces(bytes, sequence_end);
    let callee_end = token_end(bytes, callee_start);
    return std::mem::equal_bytes(bytes[callee_start..callee_end], callee);
}

fn sequence_fact_value_start(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], name) and
                is_space(bytes[name_end]) {
                let sequence_start = skip_spaces(bytes, name_end);
                let actual = try parse_i64_token(bytes, sequence_start);
                let sequence_end = token_end(bytes, sequence_start);
                if actual == sequence {
                    return skip_spaces(bytes, sequence_end);
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: sequence_fact_value_start");
}

fn sequence_fact_value_start_in_line(bytes: []u8, name_end: i64, sequence: i64) -> !i64 {
    let sequence_start = skip_spaces(bytes, name_end);
    let actual = try parse_i64_token(bytes, sequence_start);
    let sequence_end = token_end(bytes, sequence_start);
    if actual == sequence {
        return skip_spaces(bytes, sequence_end);
    }
    return -1;
}

fn body_node_kind_start(bytes: []u8, function_name: []u8, sequence: i64) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-node ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                let sequence_start = skip_spaces(bytes, name_end);
                let actual = try parse_i64_token(bytes, sequence_start);
                if actual == sequence {
                    return try body_node_kind_start_in_line(bytes, sequence_start);
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: body_node_kind_start");
}

fn body_node_kind_start_in_line(bytes: []u8, sequence_start: i64) -> !i64 {
    let sequence_end = token_end(bytes, sequence_start);
    let depth_label_start = skip_spaces(bytes, sequence_end);
    let depth_label_end = token_end(bytes, depth_label_start);
    if !std::mem::equal_bytes(bytes[depth_label_start..depth_label_end], "depth") {
        return error("invalid IR artifact fact");
    }

    let depth_start = skip_spaces(bytes, depth_label_end);
    let depth_end = token_end(bytes, depth_start);
    let kind_label_start = skip_spaces(bytes, depth_end);
    let kind_label_end = token_end(bytes, kind_label_start);
    if !std::mem::equal_bytes(bytes[kind_label_start..kind_label_end], "kind") {
        return error("invalid IR artifact fact");
    }

    return skip_spaces(bytes, kind_label_end);
}

fn named_fact_value_start(bytes: []u8, prefix: []u8, name: []u8) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(name);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], name) and
                is_space(bytes[name_end]) {
                return skip_spaces(bytes, name_end);
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: named_fact_value_start");
}

fn parse_i64_token(bytes: []u8, start: i64) -> !i64 {
    let byte_len = std::mem::len(bytes);
    if start >= byte_len {
        return error("invalid IR artifact fact");
    }
    var value = 0;
    var index = start;
    var found = false;
    while index < byte_len {
        let byte = bytes[index];
        if !is_digit(byte) {
            break;
        }
        value = (value * 10) + try digit_value(byte);
        found = true;
        index = index + 1;
    }
    if !found {
        return error("invalid IR artifact fact");
    }
    if index < byte_len and
        !is_space(bytes[index]) and
        bytes[index] != cast<u8>(10) and
        bytes[index] != cast<u8>(13) {
        return error("invalid IR artifact fact");
    }
    return value;
}

pub fn extract_function_ir(
    allocator: Allocator,
    bytes: []u8,
    function_name: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    let byte_len = std::mem::len(bytes);
    let name_len = std::mem::len(function_name);
    var index = 0;
    while index < byte_len {
        let end = line_end(bytes, index);
        if index + 5 < end and
            bytes[index] == cast<u8>(98) and
            bytes[index + 1] == cast<u8>(111) and
            bytes[index + 2] == cast<u8>(100) and
            bytes[index + 3] == cast<u8>(121) and
            bytes[index + 4] == cast<u8>(45) {
            if body_line_has_function(bytes, index, end, function_name, name_len) {
                try out.append_bytes(bytes[index..end]);
                try out.append_byte(cast<u8>(10));
            }
        } else {
            try out.append_bytes(bytes[index..end]);
            try out.append_byte(cast<u8>(10));
        }
        if end < byte_len {
            index = end + 1;
        } else {
            index = byte_len;
        }
    }
    return out;
}

fn body_line_has_function(
    bytes: []u8,
    line_start: i64,
    end: i64,
    function_name: []u8,
    name_len: i64
) -> bool {
    var i = line_start + 5;
    while i < end {
        if bytes[i] == cast<u8>(32) {
            break;
        }
        i = i + 1;
    }
    i = i + 1;
    if i + name_len > end {
        return false;
    }
    if !std::mem::equal_bytes(bytes[i..i + name_len], function_name) {
        return false;
    }
    if i + name_len < end and !is_space(bytes[i + name_len]) {
        return false;
    }
    return true;
}

fn token_end(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len {
        let byte = bytes[index];
        if is_space(byte) or byte == cast<u8>(10) or byte == cast<u8>(13) {
            return index;
        }
        index = index + 1;
    }
    return index;
}

fn line_end(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len {
        let byte = bytes[index];
        if byte == cast<u8>(10) or byte == cast<u8>(13) {
            return index;
        }
        index = index + 1;
    }
    return index;
}

fn skip_spaces(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len and is_space(bytes[index]) {
        index = index + 1;
    }
    return index;
}

fn is_line_start(bytes: []u8, index: i64) -> bool {
    if index == 0 {
        return true;
    }
    return bytes[index - 1] == cast<u8>(10);
}

fn is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9);
}

fn is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}

fn digit_value(byte: u8) -> !i64 {
    if byte == cast<u8>(48) {
        return 0;
    }
    if byte == cast<u8>(49) {
        return 1;
    }
    if byte == cast<u8>(50) {
        return 2;
    }
    if byte == cast<u8>(51) {
        return 3;
    }
    if byte == cast<u8>(52) {
        return 4;
    }
    if byte == cast<u8>(53) {
        return 5;
    }
    if byte == cast<u8>(54) {
        return 6;
    }
    if byte == cast<u8>(55) {
        return 7;
    }
    if byte == cast<u8>(56) {
        return 8;
    }
    if byte == cast<u8>(57) {
        return 9;
    }
    return error("invalid IR artifact fact");
}

pub fn body_facts_start(bytes: []u8, function_name: []u8) -> i64 {
    let byte_len = std::mem::len(bytes);
    let name_len = std::mem::len(function_name);
    let prefix = "body-";
    let prefix_len = std::mem::len(prefix);
    var index = 0;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            if body_line_has_function(bytes, index, line_end(bytes, index), function_name, name_len) {
                return index;
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return 0;
}

pub fn body_child_sequence_from(
    bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64,
    from: i64
) -> !i64 {
    let child = try body_child_sequence_or_minus_one_from(
        bytes, function_name, parent_sequence, edge, ordinal, from
    );
    if child >= 0 {
        return child;
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("missing IR artifact fact: body_child_sequence_from function ");
    try message.append_bytes(function_name);
    try message.append_bytes(" parent ");
    try std::fmt::append_i64(&var message, parent_sequence);
    try message.append_bytes(" edge ");
    try message.append_bytes(edge);
    try message.append_bytes(" ordinal ");
    try std::fmt::append_i64(&var message, ordinal);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

pub fn body_child_sequence_or_minus_one_from(
    bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64,
    from: i64
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-edge ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = from;
    var seen = false;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                seen = true;
                let child = try body_child_sequence_in_line(
                    bytes, name_end, parent_sequence, edge, ordinal
                );
                if child >= 0 {
                    return child;
                }
            } else {
                if seen {
                    return -1;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return -1;
}

pub fn body_node_kind_from(
    bytes: []u8,
    function_name: []u8,
    sequence: i64,
    from: i64
) -> ![]u8 borrows bytes {
    let value_start = try body_node_kind_start_from(bytes, function_name, sequence, from);
    let value_end = token_end(bytes, value_start);
    return bytes[value_start..value_end];
}

fn body_node_kind_start_from(
    bytes: []u8,
    function_name: []u8,
    sequence: i64,
    from: i64
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-node ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = from;
    var seen = false;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                seen = true;
                let sequence_start = skip_spaces(bytes, name_end);
                let actual = try parse_i64_token(bytes, sequence_start);
                if actual == sequence {
                    return try body_node_kind_start_in_line(bytes, sequence_start);
                }
            } else {
                if seen {
                    return error("missing IR artifact fact: body_node_kind_start_from boundary");
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: body_node_kind_start_from");
}

// body_node_line_offset_from returns the byte offset of the 'body-node <function_name> <sequence>'
// line, scanning forward from from, or from itself when that line is not reached ahead (so a
// caller advancing it as a forward cursor degrades to its starting point rather than jumping). It
// mirrors body_node_kind_start_from's scan but yields the line start, letting a per-block statement
// walk advance to each statement's body-node line without the global index -- turning a from-bs
// rescan into a forward cursor while reaching the byte-identical line.
pub fn body_node_line_offset_from(
    bytes: []u8,
    function_name: []u8,
    sequence: i64,
    from: i64
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-node ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = from;
    var seen = false;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                seen = true;
                let sequence_start = skip_spaces(bytes, name_end);
                let actual = try parse_i64_token(bytes, sequence_start);
                if actual == sequence {
                    return index;
                }
            } else {
                if seen {
                    return from;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return from;
}

// collect_body_node_line_starts scans the contiguous body-node facts of one function (from from,
// the offset of its 'body-node <function_name> 0' line) and appends the byte offset of each
// 'body-node <function_name> <seq>' line to out in ascending seq order, so out[seq] equals the
// offset body_node_line_start_for_sequence(seq) returns. It mirrors body_node_kind_start_from's
// scan exactly (same prefix/name/space match, same line stepping, same 'seen then other function
// ends the run' boundary), so the offsets it records are byte-identical to per-sequence lookups.
// body-node facts emit in pre-order DFS with strictly increasing sequence, so appending in scan
// order fills out[seq] directly; any gap (never expected) is padded with -1 so out[seq] < 0 is an
// unambiguous 'no offset, use the fallback' signal for the caller.
pub fn collect_body_node_line_starts(
    bytes: []u8,
    function_name: []u8,
    from: i64,
    out: &var std::array::Array<i64>
) -> !void {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-node ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = from;
    var seen = false;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                seen = true;
                let sequence_start = skip_spaces(bytes, name_end);
                let actual = try parse_i64_token(bytes, sequence_start);
                if out.len() <= actual {
                    while out.len() < actual {
                        try out.append(0 - 1);
                    }
                    try out.append(index);
                }
            } else {
                if seen {
                    return;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return;
}

pub fn body_edge_count_from(
    bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    from: i64
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix = "body-edge ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var index = from;
    var count = 0;
    var seen = false;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], function_name) and
                is_space(bytes[name_end]) {
                seen = true;
                let parent_start = skip_spaces(bytes, name_end);
                let actual_parent = try parse_i64_token(bytes, parent_start);
                if actual_parent == parent_sequence {
                    let parent_end = token_end(bytes, parent_start);
                    let edge_start = skip_spaces(bytes, parent_end);
                    let edge_end = token_end(bytes, edge_start);
                    if std::mem::equal_bytes(bytes[edge_start..edge_end], edge) {
                        count = count + 1;
                    }
                }
            } else {
                if seen {
                    return count;
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return count;
}

fn sequence_fact_value_start_from(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64,
    from: i64
) -> !i64 {
    let byte_len = std::mem::len(bytes);
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(name);
    var index = from;
    var seen = false;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], name) and
                is_space(bytes[name_end]) {
                seen = true;
                let sequence_start = skip_spaces(bytes, name_end);
                let actual = try parse_i64_token(bytes, sequence_start);
                let sequence_end = token_end(bytes, sequence_start);
                if actual == sequence {
                    return skip_spaces(bytes, sequence_end);
                }
            } else {
                if seen {
                    return error("missing IR artifact fact: sequence_fact_value_start_from boundary");
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return error("missing IR artifact fact: sequence_fact_value_start_from");
}

pub fn sequence_fact_value_from(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64,
    from: i64
) -> ![]u8 borrows bytes {
    let value_start = try sequence_fact_value_start_from(bytes, prefix, name, sequence, from);
    let value_end = token_end(bytes, value_start);
    return bytes[value_start..value_end];
}

fn sequence_fact_value_or_empty_from(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64,
    from: i64
) -> ![]u8 borrows bytes {
    let byte_len = std::mem::len(bytes);
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(name);
    var index = from;
    var seen = false;
    while index + prefix_len + name_len < byte_len {
        if is_line_start(bytes, index) and
            std::mem::equal_bytes(bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(bytes[name_start..name_end], name) and
                is_space(bytes[name_end]) {
                seen = true;
                let value_start = try sequence_fact_value_start_in_line(
                    bytes, name_end, sequence
                );
                if value_start >= 0 {
                    let value_end = token_end(bytes, value_start);
                    return bytes[value_start..value_end];
                }
            } else {
                if seen {
                    return bytes[0..0];
                }
            }
        }
        index = line_end(bytes, index) + 1;
    }
    return bytes[0..0];
}

pub fn sequence_fact_second_value_from(
    bytes: []u8,
    prefix: []u8,
    name: []u8,
    sequence: i64,
    from: i64
) -> ![]u8 borrows bytes {
    let first_start = try sequence_fact_value_start_from(bytes, prefix, name, sequence, from);
    let first_end = token_end(bytes, first_start);
    let second_start = skip_spaces(bytes, first_end);
    let second_end = token_end(bytes, second_start);
    if second_start == second_end {
        return error("missing IR artifact fact: sequence_fact_second_value_from");
    }
    return bytes[second_start..second_end];
}

pub fn body_token_or_empty_from(
    bytes: []u8,
    function_name: []u8,
    sequence: i64,
    from: i64
) -> ![]u8 borrows bytes {
    return try sequence_fact_value_or_empty_from(bytes, "body-token ", function_name, sequence, from);
}

pub fn body_call_callee_or_empty_from(
    bytes: []u8,
    function_name: []u8,
    sequence: i64,
    from: i64
) -> ![]u8 borrows bytes {
    return try sequence_fact_value_or_empty_from(bytes, "body-call ", function_name, sequence, from);
}

pub fn body_int_value_from(bytes: []u8, function_name: []u8, sequence: i64, from: i64) -> !i64 {
    let kind = try body_node_kind_from(bytes, function_name, sequence, from);
    if !std::mem::equal_bytes(kind, "Int") {
        return error("invalid IR artifact integer node kind");
    }
    let token = try sequence_fact_value_from(bytes, "body-token ", function_name, sequence, from);
    return try parse_i64_token(token, 0);
}

pub fn body_field_expr_name_from(
    bytes: []u8,
    function_name: []u8,
    sequence: i64,
    mode: []u8,
    from: i64
) -> ![]u8 borrows bytes {
    let actual_mode = try sequence_fact_second_value_from(
        bytes, "body-field-expr ", function_name, sequence, from
    );
    if !std::mem::equal_bytes(actual_mode, mode) {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("invalid IR artifact field expression mode: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" node ");
        try std::fmt::append_i64(&var message, sequence);
        try message.append_bytes(" expected ");
        try message.append_bytes(mode);
        try message.append_bytes(" actual ");
        try message.append_bytes(actual_mode);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    return try sequence_fact_value_from(bytes, "body-field-expr ", function_name, sequence, from);
}
