import selfhost::backend::compiled_util;
import selfhost::backend::ir_index;
import selfhost::backend::compiled_type_resolver;

pub struct StructFieldLookup {
    pub found: bool,
    pub index: i64,
    pub field_type: []u8,
    pub canonical_struct_identity: []u8,
    pub declaring_module: []u8,
}

pub struct StructFieldAtIndexLookup {
    pub found: bool,
    pub index: i64,
    pub field_name: []u8,
    pub field_type: []u8,
    pub canonical_struct_identity: []u8,
    pub declaring_module: []u8,
}

pub struct StructFieldFact {
    pub index: i64,
    pub name: []u8,
    pub field_type: []u8,
}

// validate_struct_field_owner_indexed validates one exact owner range without
// allocating a parallel field table. Field facts are canonical source order:
// indexes start at zero and advance by one.
pub fn validate_struct_field_owner_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_struct_identity: []u8
) -> !i64 {
    let prefix = "struct-field ";
    var entry = ir_index::first_matching_entry(
        index, ir_bytes, prefix, ir_bytes[0..0], canonical_struct_identity
    );
    var count = 0;
    while entry >= 0 and ir_index::entry_matches_query(
        index, ir_bytes, entry, prefix,
        ir_bytes[0..0], canonical_struct_identity
    ) {
        let field = try parse_struct_field_entry(index, ir_bytes, entry);
        if field.index < count {
            return error("compiled function: duplicate struct field index");
        }
        if field.index > count {
            return error("compiled function: struct field index gap");
        }
        var previous = ir_index::first_matching_entry(
            index, ir_bytes, prefix, ir_bytes[0..0], canonical_struct_identity
        );
        while previous >= 0 and previous < entry {
            let previous_field = try parse_struct_field_entry(
                index, ir_bytes, previous
            );
            if std::mem::equal_bytes(previous_field.name, field.name) {
                return error("compiled function: duplicate struct field name");
            }
            previous = previous + 1;
        }
        count = count + 1;
        entry = entry + 1;
    }
    return count;
}

// lookup_struct_field_exact_indexed accepts the canonical identity produced by
// compiled_type_resolver. It never guesses by suffix: a field belongs to one
// declaration, and its bare type spelling is relative to that declaration's
// module. A duplicate exact struct field is rejected instead of becoming
// order-dependent.
pub fn lookup_struct_field_exact_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_struct_identity: []u8,
    field_name: []u8
) -> !StructFieldLookup {
    let field_count = try validate_struct_field_owner_indexed(
        index, ir_bytes, canonical_struct_identity
    );
    var result = empty_struct_field_lookup(ir_bytes);
    let prefix = "struct-field ";
    var entry = ir_index::first_matching_entry(
        index, ir_bytes, prefix, ir_bytes[0..0], canonical_struct_identity
    );
    var visited = 0;
    while visited < field_count {
        let field = try parse_struct_field_entry(index, ir_bytes, entry);
        if std::mem::equal_bytes(field.name, field_name) {
            result = StructFieldLookup {
                found: true,
                index: field.index,
                field_type: field.field_type,
                canonical_struct_identity: canonical_struct_identity,
                declaring_module: compiled_util::module_prefix_of(
                    canonical_struct_identity
                )
            };
        }
        visited = visited + 1;
        entry = entry + 1;
    }
    return result;
}

pub fn lookup_struct_field_at_index_exact_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_struct_identity: []u8,
    target_index: i64
) -> !StructFieldAtIndexLookup {
    let field_count = try validate_struct_field_owner_indexed(
        index, ir_bytes, canonical_struct_identity
    );
    if target_index < 0 or target_index >= field_count {
        return StructFieldAtIndexLookup {
            found: false,
            index: target_index,
            field_name: ir_bytes[0..0],
            field_type: ir_bytes[0..0],
            canonical_struct_identity: canonical_struct_identity,
            declaring_module: compiled_util::module_prefix_of(canonical_struct_identity)
        };
    }
    let prefix = "struct-field ";
    var entry = ir_index::first_matching_entry(
        index, ir_bytes, prefix, ir_bytes[0..0], canonical_struct_identity
    );
    var field = try parse_struct_field_entry(index, ir_bytes, entry);
    while field.index < target_index {
        entry = entry + 1;
        field = try parse_struct_field_entry(index, ir_bytes, entry);
    }
    return StructFieldAtIndexLookup {
        found: true,
        index: target_index,
        field_name: field.name,
        field_type: field.field_type,
        canonical_struct_identity: canonical_struct_identity,
        declaring_module: compiled_util::module_prefix_of(canonical_struct_identity)
    };
}

pub fn enum_variant_tag_by_prefix_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    short_enum: []u8,
    variant: []u8
) -> !i64 {
    let marker = "enum-variant ";
    var entry_index = ir_index::first_matching_entry(
        index, ir_bytes, marker, module_prefix, short_enum
    );
    while entry_index >= 0 and
        ir_index::entry_matches_query(
            index, ir_bytes, entry_index, marker, module_prefix, short_enum
        ) {
        let tag = try match_enum_variant_suffix(
            ir_bytes,
            ir_index::entry_key_end(index, entry_index),
            variant
        );
        if tag >= 0 {
            return tag;
        }
        entry_index = entry_index + 1;
    }
    return enum_variant_not_found(short_enum, variant);
}

fn enum_variant_not_found(short_enum: []u8, variant: []u8) -> !i64 {
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled function: enum variant not found: ");
    try message.append_bytes(short_enum);
    try message.append_bytes("::");
    try message.append_bytes(variant);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

// UnionVariantLookup carries the discriminant, canonical union identity, and
// declaration-relative payload spelling. Every consumer resolves payload_kizu
// against declaring_module; a bare payload must never fall back to the caller.
pub struct UnionVariantLookup {
    pub found: bool,
    pub tag: i64,
    pub payload_kizu: []u8,
    pub canonical_identity: []u8,
    pub declaring_module: []u8,
}

// Resolve through the canonical type resolver, then read the variant from the
// declaration layout's validated name/tag/payload table.
pub fn lookup_union_variant_by_prefix_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    short_union: []u8,
    variant: []u8
) -> !UnionVariantLookup {
    let resolved = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, module_prefix, short_union
    );
    let union_type = try compiled_type_resolver::exact_union_type_indexed(
        index, ir_bytes, resolved.canonical_identity
    );
    if !union_type.found {
        return error("compiled function: union variant not found");
    }
    let found = try compiled_type_resolver::resolve_union_variant_indexed(
        index, ir_bytes, resolved.canonical_identity, variant
    );
    if !found.found { return error("compiled function: union variant not found"); }
    return UnionVariantLookup {
        found: true,
        tag: found.tag,
        payload_kizu: found.payload_kizu,
        canonical_identity: resolved.canonical_identity,
        declaring_module: resolved.declaring_module
    };
}

fn match_enum_variant_suffix(
    ir_bytes: []u8,
    after_enum: i64,
    variant: []u8
) -> !i64 {
    let byte_len = std::mem::len(ir_bytes);
    let variant_len = std::mem::len(variant);
    var pos = after_enum;
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    let variant_end = pos + variant_len;
    if variant_end >= byte_len {
        return -1;
    }
    if !std::mem::equal_bytes(ir_bytes[pos..variant_end], variant) {
        return -1;
    }
    if ir_bytes[variant_end] != cast<u8>(32) {
        return -1;
    }
    var tag_start = variant_end;
    while tag_start < byte_len and ir_bytes[tag_start] == cast<u8>(32) {
        tag_start = tag_start + 1;
    }
    var tag_value = 0;
    var found = false;
    while tag_start < byte_len {
        let byte = ir_bytes[tag_start];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            break;
        }
        let digit = cast<i64>(byte - cast<u8>(48));
        if tag_value > 922337203685477580 or
            (tag_value == 922337203685477580 and digit > 7) {
            return error("compiled function: enum variant tag overflow");
        }
        tag_value = tag_value * 10 + digit;
        found = true;
        tag_start = tag_start + 1;
    }
    if !found {
        return -1;
    }
    return tag_value;
}

fn empty_struct_field_lookup(ir_bytes: []u8) -> StructFieldLookup {
    return StructFieldLookup {
        found: false,
        index: -1,
        field_type: ir_bytes[0..0],
        canonical_struct_identity: ir_bytes[0..0],
        declaring_module: ir_bytes[0..0]
    };
}

pub fn parse_struct_field_entry(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    entry: i64
) -> !StructFieldFact {
    let line_end = ir_index::entry_line_end(index, entry);
    let index_start = skip_spaces_until(
        ir_bytes, ir_index::entry_key_end(index, entry), line_end
    );
    let index_end = token_end_until(ir_bytes, index_start, line_end);
    if index_start >= index_end {
        return error("compiled function: malformed struct field fact");
    }
    var field_index = 0;
    var cursor = index_start;
    while cursor < index_end {
        let byte = ir_bytes[cursor];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return error("compiled function: invalid struct field index");
        }
        let digit = cast<i64>(byte - cast<u8>(48));
        if field_index > 922337203685477580 or
            (field_index == 922337203685477580 and digit > 7) {
            return error("compiled function: struct field index overflow");
        }
        field_index = field_index * 10 + digit;
        cursor = cursor + 1;
    }
    let name_start = skip_spaces_until(ir_bytes, index_end, line_end);
    let name_end = token_end_until(ir_bytes, name_start, line_end);
    let type_start = skip_spaces_until(ir_bytes, name_end, line_end);
    if name_start >= name_end {
        return error("compiled function: empty struct field name");
    }
    if type_start >= line_end {
        return error("compiled function: empty struct field type");
    }
    return StructFieldFact {
        index: field_index,
        name: ir_bytes[name_start..name_end],
        field_type: ir_bytes[type_start..line_end]
    };
}

pub fn is_enum_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    short_name: []u8
) -> bool {
    let entry_index = ir_index::first_matching_entry(
        index, ir_bytes, "enum-variant ", module_prefix, short_name
    );
    return entry_index >= 0;
}

// is_union_type_indexed accepts only the exact module-qualified identity. A
// same-basename union in another component must never classify this spelling.
pub fn is_union_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    short_name: []u8
) -> !bool {
    let resolved = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, module_prefix, short_name
    );
    let union_type = try compiled_type_resolver::exact_union_type_indexed(
        index, ir_bytes, resolved.canonical_identity
    );
    return union_type.found;
}

pub fn gate_exact_union_identity() -> !void {
    let facts = "module-alias gamma::models alpha::
union-type alpha::State %alpha.state
union-variant alpha::State Ready 0 Model
union-type beta::State %beta.state
union-variant beta::State Ready 0 bool";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let alpha = try lookup_union_variant_by_prefix_indexed(
        &index, facts, "alpha::", "State", "Ready"
    );
    let beta = try lookup_union_variant_by_prefix_indexed(
        &index, facts, "", "beta::State", "Ready"
    );
    let imported = try lookup_union_variant_by_prefix_indexed(
        &index, facts, "gamma::", "models::State", "Ready"
    );
    if alpha.tag != 0 or beta.tag != 0 or imported.tag != 0 {
        return error("compiled function: exact union identity selected wrong tag");
    }
    if !std::mem::equal_bytes(alpha.canonical_identity, "alpha::State") or
        !std::mem::equal_bytes(alpha.declaring_module, "alpha::") or
        !std::mem::equal_bytes(alpha.payload_kizu, "Model") or
        !std::mem::equal_bytes(imported.canonical_identity, "alpha::State") or
        !std::mem::equal_bytes(imported.declaring_module, "alpha::") {
        return error("compiled function: union payload lost declaration context");
    }
    print("union-exact");
    return;
}

pub fn gate_union_suffix_rejected() -> !void {
    let facts = "union-type alpha::State %alpha.state
union-variant alpha::State Ready 0 i64";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let value = try lookup_union_variant_by_prefix_indexed(
        &index, facts, "", "State", "Ready"
    );
    print(value.tag);
    return;
}

pub fn gate_invalid_union_variant_facts_rejected() -> !void {
    let facts = "union-type alpha::State %alpha.state
union-variant alpha::State Ready 0 i64
union-variant alpha::State Waiting 2 bool";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let value = try lookup_union_variant_by_prefix_indexed(
        &index, facts, "alpha::", "State", "Ready"
    );
    print(value.tag);
    return;
}

fn skip_spaces_until(ir_bytes: []u8, start: i64, end: i64) -> i64 {
    var pos = start;
    while pos < end and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    return pos;
}

fn token_end_until(ir_bytes: []u8, start: i64, end: i64) -> i64 {
    var pos = start;
    while pos < end and ir_bytes[pos] != cast<u8>(32) {
        pos = pos + 1;
    }
    return pos;
}
