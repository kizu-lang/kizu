pub fn borrow_var_spelling_gate() -> !void {
    let facts = "canonical-type 0 intrinsic bool 2 -1 0
canonical-type 1 borrow-var - -1 -1 1 0
";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var table = try parse_and_validate(&index, facts);
    defer table.deinit();
    if !try parsed_canonical_spelling_matches(&table, 1, "&var_bool") {
        return error("borrow-var canonical spelling mismatch");
    }
    return;
}

pub fn nested_generic_spelling_gate() -> !void {
    let facts = "canonical-type 0 intrinsic u8 7 -1 0
canonical-type 1 slice - -1 -1 1 0
canonical-type 2 intrinsic std::channel::Channel 35 -1 1 1
canonical-type 3 intrinsic i64 6 -1 0
canonical-type 4 intrinsic std::array::Array 30 -1 1 3
canonical-type 5 intrinsic std::map::Map 33 -1 2 4 2
";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var table = try parse_and_validate(&index, facts);
    defer table.deinit();
    if !try parsed_canonical_spelling_matches(
        &table, 5,
        "std::map::Map<std::array::Array<i64>,std::channel::Channel<[]u8>>"
    ) { return error("nested canonical spelling mismatch"); }
    return;
}

pub fn declared_generic_runtime_abi_gate() -> !void {
    let facts = "type-llvm app::Box %app.box
declared-type-parameter app::Box 0 T
canonical-type 0 intrinsic i64 6 -1 0
canonical-type 1 declared app::Box 0 0 1 0
";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var table = try parse_and_validate(&index, facts);
    defer table.deinit();
    std::testing::expect_equal<[]u8>(
        "%app.box",
        try parsed_canonical_runtime_abi(&index, &table, facts, 1)
    );
    if !try parsed_canonical_spelling_matches(
        &table, 1, "app::Box<i64>"
    ) {
        return error("declared generic canonical spelling mismatch");
    }
    return;
}

