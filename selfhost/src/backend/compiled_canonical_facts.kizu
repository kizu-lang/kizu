pub fn runtime_abi_direct_resolution_gate() -> !void {
    let facts = "abi-repr []u8 %kizu.slice.u8
abi-repr std::array::Array %kizu.owned
error-llvm i1 %kizu.error.i1
canonical-type 0 intrinsic bool 2 -1 0
canonical-type 1 intrinsic u8 7 -1 0
canonical-type 2 slice - -1 -1 1 1
canonical-type 3 intrinsic std::array::Array 30 -1 1 0
canonical-type 4 intrinsic error 50 -1 0
canonical-type 5 error-union - -1 -1 2 4 0
";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var table = try parse_and_validate(&index, facts);
    defer table.deinit();
    std::testing::expect_equal<[]u8>(
        "i1", try parsed_canonical_runtime_abi(&index, &table, facts, 0)
    );
    std::testing::expect_equal<[]u8>(
        "%kizu.slice.u8",
        try parsed_canonical_runtime_abi(&index, &table, facts, 2)
    );
    std::testing::expect_equal<[]u8>(
        "%kizu.owned",
        try parsed_canonical_runtime_abi(&index, &table, facts, 3)
    );
    std::testing::expect_equal<[]u8>(
        "%kizu.error.i1",
        try parsed_canonical_runtime_abi(&index, &table, facts, 5)
    );
    return;
}

pub fn direction_neutral_scalar_codec_gate() -> !void {
    let facts = "canonical-type 0 intrinsic bool 2 -1 0
canonical-type 1 intrinsic u8 7 -1 0
canonical-type 2 intrinsic i32 5 -1 0
canonical-type 3 intrinsic i64 6 -1 0
";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var table = try parse_and_validate(&index, facts);
    defer table.deinit();
    let bool_codec = try parsed_scalar_i64_codec(&table, 0);
    std::testing::expect(match bool_codec {
        Bool => true,
        _ => false,
    });
    let unsigned_codec = try parsed_scalar_i64_codec(&table, 1);
    std::testing::expect(match unsigned_codec {
        UnsignedNarrow => true,
        _ => false,
    });
    let signed_codec = try parsed_scalar_i64_codec(&table, 2);
    std::testing::expect(match signed_codec {
        SignedNarrow => true,
        _ => false,
    });
    let identity_codec = try parsed_scalar_i64_codec(&table, 3);
    std::testing::expect(match identity_codec {
        Identity => true,
        _ => false,
    });
    return;
}

pub fn aggregate_scalar_storage_rejected_gate() -> !void {
    let facts = "canonical-type 0 intrinsic bool 2 -1 0
canonical-type 1 slice - -1 -1 1 0
";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var table = try parse_and_validate(&index, facts);
    defer table.deinit();
    let codec = try parsed_scalar_i64_codec(&table, 1);
    std::testing::expect(match codec { Unsupported => true, _ => false, });
    return;
}

impl CanonicalFactTable {
    fn deinit(self: CanonicalFactTable) -> void {
        self.instance_calls.deinit();
        self.call_type_ids.deinit();
        self.call_slots.deinit();
        self.child_ids.deinit();
        self.enum_flags.deinit();
        self.records.deinit();
        return;
    }
}
