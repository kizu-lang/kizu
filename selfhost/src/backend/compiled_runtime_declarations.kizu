import selfhost::abi::fixed_abi_contract;

fn append_line(out: &var std::string::String, line: []u8) -> !void {
    try out.append_bytes(line);
    try out.append_byte(cast<u8>(10));
    return;
}

// append_foundation_types owns the fixed named types shared with the linked
// host/storage modules. Source-defined nominal and error types are appended by
// compiled_type_declarations after this foundation has been seeded.
pub fn append_foundation_types(out: &var std::string::String) -> !void {
    try fixed_abi_contract::append_named_declarations(out, true);
    try append_line(out, "%kizu.fs.metadata = type { i64, i1 }");
    try append_line(out, "%kizu.error.bool = type { i1, i1, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.i64 = type { i1, i64, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.owned = type { i1, %kizu.owned, %kizu.slice.u8 }");
    try append_line(
        out, "%kizu.error.metadata = type { i1, %kizu.fs.metadata, %kizu.slice.u8 }"
    );
    try append_line(
        out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }"
    );
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    return;
}

// Host and storage declarations have separate append boundaries because the
// legacy self-contained compiler module still defines its storage helpers. The
// pure compiled-run module links both implementations and appends both sets.
pub fn append_linked_host_externals(out: &var std::string::String) -> !void {
    try append_line(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "declare ptr @kizu_rt_alloc(ptr, i64)");
    try append_line(out, "declare void @kizu_rt_free(ptr, ptr)");
    try append_line(out, "declare void @kizu_print_string(ptr, i64)");
    try append_line(out, "declare void @kizu_print_int(i64)");
    try append_line(out, "declare void @kizu_print_bool(i1)");
    try append_line(out, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg)");
    try append_line(out, "declare void @llvm.trap()");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(
        out, "declare %kizu.error.bool @kizu_rt_fs_exists(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.metadata @kizu_rt_fs_metadata(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.owned @kizu_rt_fs_read_dir(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_fs_rename(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(out, "declare i64 @kizu_rt_process_arg_count()");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_process_arg(i64)");
    try append_line(
        out, "declare %kizu.error.slice.u8 @kizu_rt_process_env(%kizu.slice.u8)"
    );
    try append_line(
        out, "declare %kizu.slice.u8 @kizu_rt_process_env_or_empty(%kizu.slice.u8)"
    );
    try append_line(out, "declare i64 @kizu_rt_process_monotonic_millis()");
    try append_line(out, "declare void @kizu_rt_process_exit(i64) noreturn");
    try append_line(
        out,
        "declare %kizu.error.i64 @kizu_rt_process_spawn_wait8(i64, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8, %kizu.slice.u8)"
    );
    try append_line(out, "declare void @kizu_rt_owned_deinit(%kizu.owned)");
    try append_line(out, "declare void @kizu_rt_trap(%kizu.slice.u8) noreturn");
    return;
}

pub fn append_linked_storage_externals(out: &var std::string::String) -> !void {
    try append_line(out, "declare %kizu.owned @kizu_rt_array_new(%kizu.owned, i64)");
    try append_line(
        out, "declare %kizu.error.void @kizu_rt_array_append(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(out, "declare i64 @kizu_rt_array_len(%kizu.owned)");
    try append_line(
        out, "declare %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned, i64)"
    );
    try append_line(
        out, "declare %kizu.slice.u8 @kizu_rt_array_pop_or_panic(%kizu.owned)"
    );
    try append_line(
        out, "declare %kizu.error.slice.u8 @kizu_rt_array_pop(%kizu.owned)"
    );
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_array_set(%kizu.owned, i64, %kizu.slice.u8)"
    );
    try append_line(out, "declare void @kizu_rt_array_deinit(%kizu.owned)");

    try append_line(out, "declare %kizu.owned @kizu_rt_string_new(%kizu.owned)");
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_string_append_bytes(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out, "declare %kizu.error.void @kizu_rt_string_reserve(%kizu.owned, i64)"
    );
    try append_line(
        out, "declare %kizu.error.void @kizu_rt_string_append_byte(%kizu.owned, i8)"
    );
    try append_line(out, "declare i64 @kizu_rt_string_len(%kizu.owned)");
    try append_line(out, "declare %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned)");
    try append_line(out, "declare void @kizu_rt_string_deinit(%kizu.owned)");

    try append_line(out, "declare %kizu.owned @kizu_rt_map_new(%kizu.owned, i64)");
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_map_insert(%kizu.owned, %kizu.slice.u8, %kizu.slice.u8)"
    );
    try append_line(
        out, "declare i1 @kizu_rt_map_contains(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(out, "declare i64 @kizu_rt_map_len(%kizu.owned)");
    try append_line(
        out, "declare %kizu.error.slice.u8 @kizu_rt_map_get(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(out, "declare void @kizu_rt_map_deinit(%kizu.owned)");

    try append_line(
        out,
        "declare %kizu.error.owned @kizu_rt_box_new(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out, "declare %kizu.error.slice.u8 @kizu_rt_box_borrow(%kizu.owned)"
    );
    try append_line(out, "declare void @kizu_rt_box_deinit(%kizu.owned)");

    try append_line(
        out, "declare %kizu.owned @kizu_rt_diagnostic_buffer_new(%kizu.owned)"
    );
    try append_line(
        out,
        "declare %kizu.error.void @kizu_rt_diagnostic_push(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out, "declare void @kizu_rt_diagnostic_buffer_deinit(%kizu.owned)"
    );

    try append_line(out, "declare %kizu.owned @kizu_rt_arena_new(%kizu.owned, i64)");
    try append_line(
        out, "declare %kizu.handle @kizu_rt_arena_add(%kizu.owned, %kizu.slice.u8)"
    );
    try append_line(
        out,
        "declare %kizu.error.slice.u8 @kizu_rt_arena_get(%kizu.owned, %kizu.handle)"
    );
    try append_line(out, "declare void @kizu_rt_arena_deinit(%kizu.owned)");
    return;
}
