import selfhost::backend::executable;

pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant_bytes(out, "ast_expect_root", "std");
    try append_llvm_constant_bytes(out, "ast_expect_module", "testing");
    try append_llvm_constant_bytes(out, "ast_expect_function", "expect");
    try append_llvm_constant_bytes(out, "ast_void", "void");
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_unsupported_executable_function(out);
    try append_call_executable_function(out);
    try append_lower_test_parse_result_function(out);
    try append_lower_test_program_function(out);
    try append_lower_test_function_function(out);
    try append_lower_test_block_function(out);
    try append_lower_test_statement_function(out);
    try append_lower_test_expr_function(out);
    try append_test_node_text_equal_function(out);
    try append_test_callee_is_expect_function(out);
    try append_lower_test_call_function(out);
    return;
}

fn append_unsupported_executable_function(out: &var std::string::String) -> !void {
    let unsupported = try executable::unsupported_executable_kind_tag();
    try append_line(out,
        "define %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_unsupported(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %empty0 = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 %empty0, i64 0, 1");
    try out.append_bytes("  %kinded = insertvalue %kizu.selfhost.executable zeroinitializer, i64 ");
    try std::fmt::append_i64(out, unsupported);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out,
        "  %result = insertvalue %kizu.selfhost.executable %kinded, %kizu.slice.u8 %empty, 1");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_call_executable_function(out: &var std::string::String) -> !void {
    let call = try executable::call_executable_kind_tag();
    try append_line(out,
        "define %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_call(");
    try append_line(out, "  %kizu.slice.u8 %payload");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try out.append_bytes("  %kinded = insertvalue %kizu.selfhost.executable zeroinitializer, i64 ");
    try std::fmt::append_i64(out, call);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out,
        "  %result = insertvalue %kizu.selfhost.executable %kinded, %kizu.slice.u8 %payload, 1");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_test_parse_result_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable @kizu_selfhost__cli_lower_test_parse_result(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.parse_result %parsed");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ast = extractvalue %kizu.kizu.ast.parse_result %parsed, 0");
    try append_line(out, "  %root = extractvalue %kizu.kizu.ast.parse_result %parsed, 1");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_program(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %root)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_test_program_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_program(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %root");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %root_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %root)");
    try append_line(out, "  %root_data = extractvalue %kizu.kizu.ast.ast_node %root_node, 1");
    try append_line(out, "  %root_tag = extractvalue %kizu.kizu.ast.ast_data %root_data, 0");
    try append_line(out, "  %is_program = icmp eq i64 %root_tag, 0");
    try append_line(out, "  br i1 %is_program, label %program, label %unsupported");
    try append_line(out, "program:");
    try append_line(out, "  %program_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %root_data, ptr %program_slot, align 8");
    try append_line(out,
        "  %program_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %program_slot, i32 0, i32 1");
    try append_line(out,
        "  %program_payload = load %kizu.kizu.ast.program_node, ptr %program_payload_ptr, align 8");
    try append_line(out,
        "  %decls = extractvalue %kizu.kizu.ast.program_node %program_payload, 0");
    try append_line(out, "  %decl_len = extractvalue %kizu.kizu.ast.child_range %decls, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %program ], [ %next_index, %next_decl ]");
    try append_line(out, "  %done = icmp eq i64 %index, %decl_len");
    try append_line(out, "  br i1 %done, label %unsupported, label %load_decl");
    try append_line(out, "load_decl:");
    try append_line(out,
        "  %child_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %decls, i64 %index)");
    try append_line(out, "  %child_ok = extractvalue %kizu.error.node_id %child_result, 0");
    try append_line(out, "  br i1 %child_ok, label %decl_loaded, label %unsupported");
    try append_line(out, "decl_loaded:");
    try append_line(out, "  %decl = extractvalue %kizu.error.node_id %child_result, 1");
    try append_line(out,
        "  %decl_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %decl)");
    try append_line(out, "  %decl_data = extractvalue %kizu.kizu.ast.ast_node %decl_node, 1");
    try append_line(out, "  %decl_tag = extractvalue %kizu.kizu.ast.ast_data %decl_data, 0");
    try append_line(out, "  %is_fn = icmp eq i64 %decl_tag, 42");
    try append_line(out, "  br i1 %is_fn, label %fn_decl, label %next_decl");
    try append_line(out, "fn_decl:");
    try append_line(out, "  %fn_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %decl_data, ptr %fn_slot, align 8");
    try append_line(out,
        "  %fn_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %fn_slot, i32 0, i32 1");
    try append_line(out,
        "  %fn_payload = load %kizu.kizu.ast.fn_decl_node, ptr %fn_payload_ptr, align 8");
    try append_line(out, "  %fn_name = extractvalue %kizu.kizu.ast.fn_decl_node %fn_payload, 3");
    try append_line(out, "  %fn_return_type = extractvalue %kizu.kizu.ast.fn_decl_node %fn_payload, 6");
    try append_line(out, "  %fn_body = extractvalue %kizu.kizu.ast.fn_decl_node %fn_payload, 8");
    try append_line(out,
        "  %candidate = call %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_function(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %fn_name, %kizu.kizu.ast.node_id %fn_return_type, %kizu.kizu.ast.node_id %fn_body)");
    try append_line(out, "  %candidate_kind = extractvalue %kizu.selfhost.executable %candidate, 0");
    try append_line(out, "  %supported = icmp ne i64 %candidate_kind, 0");
    try append_line(out, "  br i1 %supported, label %return_candidate, label %next_decl");
    try append_line(out, "return_candidate:");
    try append_line(out, "  ret %kizu.selfhost.executable %candidate");
    try append_line(out, "next_decl:");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_unsupported(%kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.selfhost.executable %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_test_function_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_function(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %name,");
    try append_line(out, "  %kizu.kizu.ast.node_id %return_type,");
    try append_line(out, "  %kizu.kizu.ast.node_id %body");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %name)");
    try append_line(out, "  %name_data = extractvalue %kizu.kizu.ast.ast_node %name_node, 1");
    try append_line(out, "  %name_tag = extractvalue %kizu.kizu.ast.ast_data %name_data, 0");
    try append_line(out, "  %is_test_name = icmp eq i64 %name_tag, 2");
    try append_line(out, "  br i1 %is_test_name, label %load_body, label %unsupported");
    try append_line(out, "load_body:");
    try append_line(out,
        "  %body_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %body)");
    try append_line(out, "  %body_data = extractvalue %kizu.kizu.ast.ast_node %body_node, 1");
    try append_line(out, "  %body_tag = extractvalue %kizu.kizu.ast.ast_data %body_data, 0");
    try append_line(out, "  %is_block = icmp eq i64 %body_tag, 19");
    try append_line(out, "  br i1 %is_block, label %block, label %unsupported");
    try append_line(out, "block:");
    try append_line(out, "  %block_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %body_data, ptr %block_slot, align 8");
    try append_line(out,
        "  %block_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %block_slot, i32 0, i32 1");
    try append_line(out,
        "  %block_payload = load %kizu.kizu.ast.block_node, ptr %block_payload_ptr, align 8");
    try append_line(out, "  %statements = extractvalue %kizu.kizu.ast.block_node %block_payload, 0");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_block(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %return_type, %kizu.kizu.ast.child_range %statements)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_unsupported(%kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.selfhost.executable %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_test_block_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_block(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %return_type,");
    try append_line(out, "  %kizu.kizu.ast.child_range %statements");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.kizu.ast.child_range %statements, 1");
    try append_line(out, "  %one = icmp eq i64 %len, 1");
    try append_line(out, "  br i1 %one, label %one_stmt, label %maybe_two");
    try append_line(out, "one_stmt:");
    try append_line(out,
        "  %return_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %return_type)");
    try append_line(out, "  %return_data = extractvalue %kizu.kizu.ast.ast_node %return_node, 1");
    try append_line(out, "  %return_tag = extractvalue %kizu.kizu.ast.ast_data %return_data, 0");
    try append_line(out, "  %return_empty = icmp eq i64 %return_tag, 43");
    try append_line(out, "  br i1 %return_empty, label %load_first, label %maybe_void");
    try append_line(out, "maybe_void:");
    try append_line(out, "  %return_type_name = icmp eq i64 %return_tag, 3");
    try append_line(out, "  br i1 %return_type_name, label %check_void, label %unsupported");
    try append_line(out, "check_void:");
    try append_line(out,
        "  %return_text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %return_type)");
    try append_line(out,
        "  %void_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.ast_void, i64 0, i64 0");
    try append_line(out, "  %void0 = insertvalue %kizu.slice.u8 poison, ptr %void_ptr, 0");
    try append_line(out, "  %void = insertvalue %kizu.slice.u8 %void0, i64 4, 1");
    try append_line(out,
        "  %is_void = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %return_text, %kizu.slice.u8 %void)");
    try append_line(out, "  br i1 %is_void, label %load_first, label %unsupported");
    try append_line(out, "maybe_two:");
    try append_line(out, "  %two = icmp eq i64 %len, 2");
    try append_line(out, "  br i1 %two, label %two_stmt, label %unsupported");
    try append_line(out, "two_stmt:");
    try append_line(out,
        "  %second_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 1)");
    try append_line(out, "  %second_ok = extractvalue %kizu.error.node_id %second_result, 0");
    try append_line(out, "  br i1 %second_ok, label %check_second, label %unsupported");
    try append_line(out, "check_second:");
    try append_line(out, "  %second = extractvalue %kizu.error.node_id %second_result, 1");
    try append_line(out,
        "  %second_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %second)");
    try append_line(out, "  %second_data = extractvalue %kizu.kizu.ast.ast_node %second_node, 1");
    try append_line(out, "  %second_tag = extractvalue %kizu.kizu.ast.ast_data %second_data, 0");
    try append_line(out, "  %second_is_return = icmp eq i64 %second_tag, 23");
    try append_line(out, "  br i1 %second_is_return, label %load_return_payload, label %unsupported");
    try append_line(out, "load_return_payload:");
    try append_line(out, "  %return_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %second_data, ptr %return_slot, align 8");
    try append_line(out,
        "  %return_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %return_slot, i32 0, i32 1");
    try append_line(out,
        "  %return_payload = load %kizu.kizu.ast.return_node, ptr %return_payload_ptr, align 8");
    try append_line(out, "  %return_value = extractvalue %kizu.kizu.ast.return_node %return_payload, 0");
    try append_line(out,
        "  %return_value_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %return_value)");
    try append_line(out, "  %return_value_data = extractvalue %kizu.kizu.ast.ast_node %return_value_node, 1");
    try append_line(out, "  %return_value_tag = extractvalue %kizu.kizu.ast.ast_data %return_value_data, 0");
    try append_line(out, "  %return_value_empty = icmp eq i64 %return_value_tag, 43");
    try append_line(out, "  br i1 %return_value_empty, label %load_first, label %unsupported");
    try append_line(out, "load_first:");
    try append_line(out,
        "  %first_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %first_ok = extractvalue %kizu.error.node_id %first_result, 0");
    try append_line(out, "  br i1 %first_ok, label %lower_first, label %unsupported");
    try append_line(out, "lower_first:");
    try append_line(out, "  %first = extractvalue %kizu.error.node_id %first_result, 1");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_statement(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %first)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_unsupported(%kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.selfhost.executable %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_test_statement_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_statement(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %statement");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try append_line(out, "  %is_expr_stmt = icmp eq i64 %tag, 25");
    try append_line(out, "  br i1 %is_expr_stmt, label %expr_stmt, label %unsupported");
    try append_line(out, "expr_stmt:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %slot, align 8");
    try append_line(out,
        "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out,
        "  %payload = load %kizu.kizu.ast.expr_stmt_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %expr = extractvalue %kizu.kizu.ast.expr_stmt_node %payload, 0");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_expr(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %expr)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_unsupported(%kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.selfhost.executable %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_test_expr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_expr(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %expr");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %expr)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try append_line(out, "  %is_call = icmp eq i64 %tag, 10");
    try append_line(out, "  br i1 %is_call, label %call, label %unsupported");
    try append_line(out, "call:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %slot, align 8");
    try append_line(out,
        "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.call_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %callee = extractvalue %kizu.kizu.ast.call_node %payload, 0");
    try append_line(out, "  %args = extractvalue %kizu.kizu.ast.call_node %payload, 1");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_call(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee, %kizu.kizu.ast.child_range %args)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_unsupported(%kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.selfhost.executable %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_test_node_text_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_test_node_text_equal(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %node,");
    try append_line(out, "  %kizu.slice.u8 %expected");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %node)");
    try append_line(out,
        "  %same = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %text, %kizu.slice.u8 %expected)");
