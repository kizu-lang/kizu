    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_test_callee_is_expect_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_test_callee_is_expect(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %callee");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %expect_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee)");
    try append_line(out, "  %expect_data = extractvalue %kizu.kizu.ast.ast_node %expect_node, 1");
    try append_line(out, "  %expect_tag = extractvalue %kizu.kizu.ast.ast_data %expect_data, 0");
    try append_line(out, "  %expect_is_field = icmp eq i64 %expect_tag, 8");
    try append_line(out, "  br i1 %expect_is_field, label %expect_field, label %fail");
    try append_line(out, "expect_field:");
    try append_line(out, "  %expect_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %expect_data, ptr %expect_slot, align 8");
    try append_line(out,
        "  %expect_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %expect_slot, i32 0, i32 1");
    try append_line(out,
        "  %expect_payload = load %kizu.kizu.ast.field_expr_node, ptr %expect_payload_ptr, align 8");
    try append_line(out,
        "  %expect_receiver = extractvalue %kizu.kizu.ast.field_expr_node %expect_payload, 0");
    try append_line(out,
        "  %expect_name = extractvalue %kizu.kizu.ast.field_expr_node %expect_payload, 1");
    try append_line(out,
        "  %expect_namespace = extractvalue %kizu.kizu.ast.field_expr_node %expect_payload, 2");
    try append_line(out, "  br i1 %expect_namespace, label %check_expect_name, label %fail");
    try append_line(out, "check_expect_name:");
    try append_line(out,
        "  %expect_ptr = getelementptr inbounds [6 x i8], ptr @.kizu.cli.ast_expect_function, i64 0, i64 0");
    try append_line(out, "  %expect0 = insertvalue %kizu.slice.u8 poison, ptr %expect_ptr, 0");
    try append_line(out, "  %expect = insertvalue %kizu.slice.u8 %expect0, i64 6, 1");
    try append_line(out,
        "  %expect_name_ok = call i1 @kizu_selfhost__cli_test_node_text_equal(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %expect_name, %kizu.slice.u8 %expect)");
    try append_line(out, "  br i1 %expect_name_ok, label %load_testing, label %fail");
    try append_line(out, "load_testing:");
    try append_line(out,
        "  %testing_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %expect_receiver)");
    try append_line(out, "  %testing_data = extractvalue %kizu.kizu.ast.ast_node %testing_node, 1");
    try append_line(out, "  %testing_tag = extractvalue %kizu.kizu.ast.ast_data %testing_data, 0");
    try append_line(out, "  %testing_is_field = icmp eq i64 %testing_tag, 8");
    try append_line(out, "  br i1 %testing_is_field, label %testing_field, label %fail");
    try append_line(out, "testing_field:");
    try append_line(out, "  %testing_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %testing_data, ptr %testing_slot, align 8");
    try append_line(out,
        "  %testing_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %testing_slot, i32 0, i32 1");
    try append_line(out,
        "  %testing_payload = load %kizu.kizu.ast.field_expr_node, ptr %testing_payload_ptr, align 8");
    try append_line(out,
        "  %testing_receiver = extractvalue %kizu.kizu.ast.field_expr_node %testing_payload, 0");
    try append_line(out,
        "  %testing_name = extractvalue %kizu.kizu.ast.field_expr_node %testing_payload, 1");
    try append_line(out,
        "  %testing_namespace = extractvalue %kizu.kizu.ast.field_expr_node %testing_payload, 2");
    try append_line(out, "  br i1 %testing_namespace, label %check_testing_name, label %fail");
    try append_line(out, "check_testing_name:");
    try append_line(out,
        "  %testing_ptr = getelementptr inbounds [7 x i8], ptr @.kizu.cli.ast_expect_module, i64 0, i64 0");
    try append_line(out, "  %testing0 = insertvalue %kizu.slice.u8 poison, ptr %testing_ptr, 0");
    try append_line(out, "  %testing = insertvalue %kizu.slice.u8 %testing0, i64 7, 1");
    try append_line(out,
        "  %testing_name_ok = call i1 @kizu_selfhost__cli_test_node_text_equal(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %testing_name, %kizu.slice.u8 %testing)");
    try append_line(out, "  br i1 %testing_name_ok, label %load_std, label %fail");
    try append_line(out, "load_std:");
    try append_line(out,
        "  %std_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %testing_receiver)");
    try append_line(out, "  %std_data = extractvalue %kizu.kizu.ast.ast_node %std_node, 1");
    try append_line(out, "  %std_tag = extractvalue %kizu.kizu.ast.ast_data %std_data, 0");
    try append_line(out, "  %std_is_var = icmp eq i64 %std_tag, 4");
    try append_line(out, "  br i1 %std_is_var, label %check_std_name, label %fail");
    try append_line(out, "check_std_name:");
    try append_line(out,
        "  %std_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.ast_expect_root, i64 0, i64 0");
    try append_line(out, "  %std0 = insertvalue %kizu.slice.u8 poison, ptr %std_ptr, 0");
    try append_line(out, "  %std = insertvalue %kizu.slice.u8 %std0, i64 3, 1");
    try append_line(out,
        "  %std_name_ok = call i1 @kizu_selfhost__cli_test_node_text_equal(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %testing_receiver, %kizu.slice.u8 %std)");
    try append_line(out, "  ret i1 %std_name_ok");
    try append_line(out, "fail:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_test_call_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_test_lower_call(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %callee,");
    try append_line(out, "  %kizu.kizu.ast.child_range %args");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %callee_ok = call i1 @kizu_selfhost__cli_test_callee_is_expect(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee)");
    try append_line(out, "  %arg_len = extractvalue %kizu.kizu.ast.child_range %args, 1");
    try append_line(out, "  %one_arg = icmp eq i64 %arg_len, 1");
    try append_line(out, "  %shape_ok = and i1 %callee_ok, %one_arg");
    try append_line(out, "  br i1 %shape_ok, label %load_arg, label %unsupported");
    try append_line(out, "load_arg:");
    try append_line(out,
        "  %arg_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %args, i64 0)");
    try append_line(out, "  %arg_ok = extractvalue %kizu.error.node_id %arg_result, 0");
    try append_line(out, "  br i1 %arg_ok, label %arg_loaded, label %unsupported");
    try append_line(out, "arg_loaded:");
    try append_line(out, "  %arg = extractvalue %kizu.error.node_id %arg_result, 1");
    try append_line(out,
        "  %arg_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %arg)");
    try append_line(out, "  %arg_data = extractvalue %kizu.kizu.ast.ast_node %arg_node, 1");
    try append_line(out, "  %arg_tag = extractvalue %kizu.kizu.ast.ast_data %arg_data, 0");
    try append_line(out, "  %arg_is_bool = icmp eq i64 %arg_tag, 5");
    try append_line(out, "  br i1 %arg_is_bool, label %build, label %unsupported");
    try append_line(out, "build:");
    try append_line(out,
        "  %payload = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %source, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %arg)");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_call(%kizu.slice.u8 %payload)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.selfhost.executable @kizu_selfhost__cli_test_ast_unsupported(%kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.selfhost.executable %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_constant_bytes(
    out: &var std::string::String,
    name: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, std::mem::len(text));
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}
