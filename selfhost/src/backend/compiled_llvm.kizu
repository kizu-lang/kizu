import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_mir_lower;
import selfhost::backend::compiled_mir_llvm;
import selfhost::backend::compiled_struct_cf;
import selfhost::backend::ir_contract;

pub fn append_compiled_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8
) -> !void {
    try append_compiled_function_typed(
        out,
        ir_bytes,
        function_name,
        llvm_symbol,
        function_name[0..0]
    );
    return;
}

pub fn append_compiled_function_typed(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8
) -> !void {
    try append_compiled_function_params(
        out,
        ir_bytes,
        function_name,
        llvm_symbol,
        llvm_return_type,
        ""
    );
    return;
}

pub fn append_compiled_function_params(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8
) -> !void {
    let bs = ir_contract::body_facts_start(ir_bytes, function_name);
    let statement_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, 0, "statement", bs
    );
    // first_token / next_token are the tokenizer entry points: thin wrappers whose nested call
    // arguments (position(...) feeding token_at / advance_position) the generic call-arg lowering
    // does not model. first_token is a single 'return token_at(...)' so it must be intercepted
    // ahead of the single-statement dispatch (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::first_token") {
        let first_mir = try compiled_mir_lower::lower_first_token_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer first_mir.deinit();
        try compiled_mir_llvm::append_function(out, &first_mir);
        return;
    }
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::next_token") {
        let next_mir = try compiled_mir_lower::lower_next_token_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer next_mir.deinit();
        try compiled_mir_llvm::append_function(out, &next_mir);
        return;
    }
    // tokenize builds a dynamic Array<Token> from first_token / next_token until Eof. It now
    // lowers through the generic multi-statement path: lower_multi_statement_function recognises the
    // value-carried array-append loop shape structurally and emits ArrayNew + ValueWhile, so no
    // name-based interception is needed (issue 1165).
    if statement_count == 1 {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", 0, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        // Parser TokenKind predicates can be written as a statement match with return-bool arms
        // (the common exhaustive helper form) or as a compact return-match expression. Both lower
        // through the same semantic predicate MIR instead of a source-shape scanner.
        if std::mem::equal_bytes(kind, "Match") or std::mem::equal_bytes(kind, "ExprStmt") {
            let predicate_mir = try compiled_mir_lower::lower_token_kind_predicate_function(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
            );
            defer predicate_mir.deinit();
            try compiled_mir_llvm::append_function(out, &predicate_mir);
            return;
        }
        if !std::mem::equal_bytes(kind, "Return") {
            return error("compiled function: single statement must be return");
        }
        let value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, statement, "value", 0, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
        // 'return match token.kind { <Variant> => true, _ => false };' is a parser single-variant
        // token predicate (e.g. is_left_brace_token): a match over an enum field returning bool,
        // which the generic expression path does not model (tracker 961, scope 4 prerequisite).
        if std::mem::equal_bytes(value_kind, "Match") {
            let predicate_mir = try compiled_mir_lower::lower_token_kind_predicate_function(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
            );
            defer predicate_mir.deinit();
            try compiled_mir_llvm::append_function(out, &predicate_mir);
            return;
        }
        if std::mem::equal_bytes(value_kind, "String") {
            let mir = try compiled_mir_lower::lower_string_return_function(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, value, bs
            );
            defer mir.deinit();
            try compiled_mir_llvm::append_function(out, &mir);
            return;
        }
        if std::mem::equal_bytes(value_kind, "Int") {
            let mir = try compiled_mir_lower::lower_int_return_function(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, value, bs
            );
            defer mir.deinit();
            try compiled_mir_llvm::append_function(out, &mir);
            return;
        }
        if std::mem::equal_bytes(value_kind, "FieldExpr") {
            let mir = try compiled_mir_lower::lower_enum_field_return_function(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, value, bs
            );
            defer mir.deinit();
            try compiled_mir_llvm::append_function(out, &mir);
            return;
        }
        if std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
            if std::mem::len(llvm_return_type) == 0 {
                return error("compiled function: struct literal requires llvm_return_type");
            }
            let mir = try compiled_mir_lower::lower_struct_return_function(
                ir_bytes, function_name, llvm_symbol,
                llvm_return_type, params_spec, value, bs
            );
            defer mir.deinit();
            try compiled_mir_llvm::append_function(out, &mir);
            return;
        }
        if std::mem::equal_bytes(value_kind, "Call") {
            // A Call whose callee is a FieldExpr is a method call (receiver.method()).
            // Read-only AST/diagnostic accessors lower through this path: self.<field>.len()
            // reads the Array field and calls the array_len builtin (Ast.len), and
            // self.<field>.get(index) lowers to the checked Array<T>.get accessor
            // (Diagnostic.related_get -> !T) (tracker 961).
            if try compiled_mir_lower::callee_is_field_expr(
                ir_bytes, function_name, value, bs
            ) {
                let method_mir = try compiled_mir_lower::lower_array_method_return(
                    ir_bytes, function_name, llvm_symbol,
                    llvm_return_type, params_spec, value, bs
                );
                defer method_mir.deinit();
                try compiled_mir_llvm::append_function(out, &method_mir);
                return;
            }
            let mir = try compiled_mir_lower::lower_call_return_function(
                ir_bytes, function_name, llvm_symbol, params_spec, value, bs
            );
            defer mir.deinit();
            try compiled_mir_llvm::append_function(out, &mir);
            return;
        }
        // 'return <int> + try <call>;' is the count_one / count_with_range single-return
        // try-call accessor (tracker 961): it propagates the call's error union on failure
        // and adds the literal to the unwrapped value on success.
        if try compiled_mir_lower::return_value_is_literal_plus_try(
            ir_bytes, function_name, value, bs
        ) {
            let try_mir = try compiled_mir_lower::lower_return_try_binary_function(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, value, bs
            );
            defer try_mir.deinit();
            try compiled_mir_llvm::append_function(out, &try_mir);
            return;
        }
        if try compiled_mir_lower::return_value_is_short_circuit_or(
            ir_bytes, function_name, value, bs
        ) {
            let or_mir = try compiled_mir_lower::lower_short_circuit_or_return_function(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, value, bs
            );
            defer or_mir.deinit();
            try compiled_mir_llvm::append_function(out, &or_mir);
            return;
        }
        if std::mem::len(llvm_return_type) == 0 {
            return error("compiled function: unsupported return value kind");
        }
        let mir = try compiled_mir_lower::lower_expr_return_function(
            ir_bytes, function_name, llvm_symbol,
            llvm_return_type, params_spec, value, bs
        );
        defer mir.deinit();
        try compiled_mir_llvm::append_function(out, &mir);
        return;
    }
    // print_payload is a 'let node = ast.get(arg); return match node.data { String => ...,
    // Var => ..., _ => ... };' AST accessor whose three call-bodied arms the generic
    // match-union shapes do not model, so it is intercepted by name ahead of the match-union
    // dispatch and lowered through its dedicated renderer (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::print_payload") {
        let payload_mir = try compiled_mir_lower::lower_print_payload_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer payload_mir.deinit();
        try compiled_mir_llvm::append_function(out, &payload_mir);
        return;
    }
    // lower_print_statement is a 'let node = ast.get(expr); return match node.data { Call =>
    // try lower_print_call(...), _ => ... };' AST accessor whose single try-call variant arm and
    // call-bodied default the generic match-union shapes do not model, so it is intercepted by
    // name ahead of the match-union dispatch (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::lower_print_statement") {
        let stmt_mir = try compiled_mir_lower::lower_print_statement_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer stmt_mir.deinit();
        try compiled_mir_llvm::append_function(out, &stmt_mir);
        return;
    }
    // lower_run_parse_result consumes the parser/check AST boundary value and forwards ast/root
    // into the existing run-codegen AST traversal.
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::lower_run_parse_result") {
        let parse_result_mir = try compiled_mir_lower::lower_run_parse_result_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer parse_result_mir.deinit();
        try compiled_mir_llvm::append_function(out, &parse_result_mir);
        return;
    }
    // lower_run_ast is the run-codegen AST traversal root: a 'let node = ast.get(root); return
    // match node.data { Program => try lower_run_ast_declarations(...), _ => ... };' accessor whose
    // try-call variant arm and call-bodied default the generic match-union shapes do not model, so
    // it is intercepted by name ahead of the match-union dispatch (tracker 961, scope 4
    // prerequisite).
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::lower_run_ast") {
        let run_mir = try compiled_mir_lower::lower_run_ast_function_root(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer run_mir.deinit();
        try compiled_mir_llvm::append_function(out, &run_mir);
        return;
    }
    // lower_run_ast_block is the stateful run-block traversal: a bounded loop threading a mutable
    // LocalTable + index whose while + Ast.child_at shape would otherwise be mis-detected as the
    // count_range accumulator, so it is intercepted by name ahead of all shape detection
    // (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::lower_run_ast_block") {
        let block_mir = try compiled_mir_lower::lower_run_ast_block_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer block_mir.deinit();
        try compiled_mir_llvm::append_function(out, &block_mir);
        return;
    }
    // lower_run_ast_function requires the function name to be "main" and forwards the block body to
    // lower_run_ast_block; its 'if + let ast.get + return match' shape mixes a string-literal guard,
    // a method-call let, and a match the generic shapes cannot model, so it is intercepted by name
    // ahead of all shape detection (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::lower_run_ast_function") {
        let fn_mir = try compiled_mir_lower::lower_run_ast_function_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer fn_mir.deinit();
        try compiled_mir_llvm::append_function(out, &fn_mir);
        return;
    }
    // lower_run_ast_declarations scans the program declarations for the first supported FnDecl; its
    // while + Ast.child_at loop with a match-in-loop and try-propagated forwarding cannot be modelled
    // by the generic shapes (and would be mis-detected as count_range), so it is intercepted by name
    // ahead of all shape detection (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::lower_run_ast_declarations") {
        let decls_mir = try compiled_mir_lower::lower_run_ast_declarations_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer decls_mir.deinit();
        try compiled_mir_llvm::append_function(out, &decls_mir);
        return;
    }
    // advance_position threads the lexer cursor over a source range: 'var index = start; var
    // current = initial; while index < end { current = advance_byte(source[index], current);
    // index = index + 1; } return current;'. Its second loop-carried variable (the Position
    // struct current, reassigned from a struct-returning call) the generic while machinery does
    // not model and the count_range shape would mis-detect, so it is intercepted by name ahead of
    // all shape detection (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::advance_position") {
        let advance_mir = try compiled_mir_lower::lower_advance_position_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer advance_mir.deinit();
        try compiled_mir_llvm::append_function(out, &advance_mir);
        return;
    }
    // number_token scans a run of digits then builds the Number Token: 'var end = start; while
    // end < len(source) and is_digit(source[end]) { end = end + 1; } return token(Number, start,
    // end, current);'. Its compound loop condition with a per-byte index load the generic while
    // machinery does not model, so it is intercepted by name ahead of all shape detection (tracker
    // 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::number_token") {
        let number_mir = try compiled_mir_lower::lower_number_token_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer number_mir.deinit();
        try compiled_mir_llvm::append_function(out, &number_mir);
        return;
    }
    // string_token scans either a quoted run or a double-slash multiline string then builds the
    // String Token. Its byte-scanning loops and multiline continuation checks the generic while
    // machinery does not model, so it is intercepted by name ahead of all shape detection
    // (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::string_token") {
        let string_mir = try compiled_mir_lower::lower_string_token_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer string_mir.deinit();
        try compiled_mir_llvm::append_function(out, &string_mir);
        return;
    }
    // skip_line_comment threads the cursor past a comment line then returns an Eof Token: 'var end
    // = start; var current = initial; while end < len(source) and source[end] != 10 { current =
    // advance_byte(source[end], current); end = end + 1; } return token(Eof, end, end, current);'.
    // Its struct loop-carried variable, compound condition, and call-in-loop the generic while
    // machinery does not model, so it is intercepted by name ahead of all shape detection (tracker
    // 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::skip_line_comment") {
        let skip_mir = try compiled_mir_lower::lower_skip_line_comment_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer skip_mir.deinit();
        try compiled_mir_llvm::append_function(out, &skip_mir);
        return;
    }
    // is_doc_comment_start tests three slash bytes plus a fourth-slash demotion: 'if start + 2 >=
    // len { return false; } if source[start] != 47 or source[start+1] != 47 or source[start+2] !=
    // 47 { return false; } return start + 3 >= len or source[start+3] != 47;'. Its index loads
    // inside compound boolean conditions the generic path does not model, so it is intercepted by
    // name ahead of all shape detection (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::is_doc_comment_start") {
        let doc_mir = try compiled_mir_lower::lower_is_doc_comment_start_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer doc_mir.deinit();
        try compiled_mir_llvm::append_function(out, &doc_mir);
        return;
    }
    // word_token scans an identifier run then classifies it: an is_word scan loop, an empty-run
    // single-byte Ident, a keyword table compared via equal_bytes against string constants, and a
    // multi-byte Ident fallback. Its scan loop plus the keyword-comparison chain over string
    // constants the generic path does not model, so it is intercepted by name ahead of all shape
    // detection (tracker 961, scope 4 prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::word_token") {
        let word_mir = try compiled_mir_lower::lower_word_token_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer word_mir.deinit();
        try compiled_mir_llvm::append_function(out, &word_mir);
        return;
    }
    // raw_token_at dispatches the byte at start: an Eof guard, an operator table (single / two- /
    // three-char look-aheads), then the quote / multiline-string / digit / word fallbacks to
    // string_token / number_token / word_token. Its many-arm byte dispatch the generic path does
    // not model, so it is intercepted by name ahead of all shape detection (tracker 961, scope 4
    // prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::raw_token_at") {
        let raw_mir = try compiled_mir_lower::lower_raw_token_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer raw_mir.deinit();
        try compiled_mir_llvm::append_function(out, &raw_mir);
        return;
    }
    // token_at is the top-level tokenizer step: it skips whitespace and line comments while
    // tracking the pending doc span, then returns attach_doc(raw_token_at(...), doc_start,
    // doc_end). Its nested loops with five outer loop-carried variables the generic path does not
    // model, so it is intercepted by name ahead of all shape detection (tracker 961, scope 4
    // prerequisite).
    if std::mem::equal_bytes(function_name, "std::kizu::lexer::token_at") {
        let token_at_mir = try compiled_mir_lower::lower_token_at_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer token_at_mir.deinit();
        try compiled_mir_llvm::append_function(out, &token_at_mir);
        return;
    }
    // Parser source-span predicates scan an AST span for namespace paths / struct-literal type
    // names. They carry multiple loop variables and early returns, so they are intercepted by name
    // instead of broadening the generic restricted while lowering (tracker 961).
    if std::mem::equal_bytes(function_name, "std::kizu::parser::is_namespace_path_span") or
        std::mem::equal_bytes(function_name, "std::kizu::parser::is_struct_literal_type_span") {
        let span_mir = try compiled_mir_lower::lower_parser_span_predicate_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer span_mir.deinit();
        try compiled_mir_llvm::append_function(out, &span_mir);
        return;
    }
    // Parser postfix guards are the first helpers in this cluster that cross from tokens into the
    // parsed AST: they inspect ParseNode.next, fetch Ast.get(ParseNode.node), then classify the
    // node span through the compiled parser span predicates (tracker 961).
    if std::mem::equal_bytes(function_name, "std::kizu::parser::is_type_apply_start") or
        std::mem::equal_bytes(function_name, "std::kizu::parser::is_struct_literal_start") {
        let postfix_mir = try compiled_mir_lower::lower_parser_postfix_start_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer postfix_mir.deinit();
        try compiled_mir_llvm::append_function(out, &postfix_mir);
        return;
    }
    // 'let node = self.get(index); return match node.data { ... };' is the first
    // match-over-AstData-union read-only AST accessor compiled into stage2 (tracker 961).
    if try compiled_mir_lower::is_match_union_function(
        ir_bytes, function_name, statement_count, bs
    ) {
        if std::mem::len(llvm_return_type) == 0 {
            return error("compiled function: match-union accessor requires llvm_return_type");
        }
        // An exhaustive 'match node.data' with no '_' default arm is the node_count
        // recursive AST-traversal accessor; a single matched variant + '_' default arm is
        // the declaration_count shape (tracker 961).
        if try compiled_mir_lower::match_union_has_default_arm(ir_bytes, function_name, bs) {
            let match_mir = try compiled_mir_lower::lower_match_union_return_function(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
            );
            defer match_mir.deinit();
            try compiled_mir_llvm::append_function(out, &match_mir);
            return;
        }
        let traversal_mir = try compiled_mir_lower::lower_traversal_match_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer traversal_mir.deinit();
        try compiled_mir_llvm::append_function(out, &traversal_mir);
        return;
    }
    // count_range is the recursive AST-traversal accumulator loop ('var count = 0; var
    // index = 0; while index < range.len { let child = try tree.child_at(range, index);
    // count = count + try node_count(tree, child); index = index + 1; } return count;'),
    // lowered to a two-phi loop with try-propagation rather than the general while machinery
    // (tracker 961).
    if try compiled_mir_lower::is_count_range_function(
        ir_bytes, function_name, statement_count, bs
    ) {
        if std::mem::len(llvm_return_type) == 0 {
            return error("compiled function: count_range requires llvm_return_type");
        }
        let range_mir = try compiled_mir_lower::lower_count_range_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer range_mir.deinit();
        try compiled_mir_llvm::append_function(out, &range_mir);
        return;
    }
    // std::mem::trim_ascii and ast_node_text are the span-based text slicing accessors the
    // run-codegen AST traversal depends on (tracker 961): trim_ascii is two break-on-condition
    // search loops, ast_node_text binds the AstNode, slices the text two-bound by its span, and
    // forwards the slice to trim_ascii. They are dispatched by name.
    if std::mem::equal_bytes(function_name, "std::mem::trim_ascii") {
        let trim_mir = try compiled_mir_lower::lower_trim_ascii_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer trim_mir.deinit();
        try compiled_mir_llvm::append_function(out, &trim_mir);
        return;
    }
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::ast_node_text") {
        let text_mir = try compiled_mir_lower::lower_ast_node_text_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer text_mir.deinit();
        try compiled_mir_llvm::append_function(out, &text_mir);
        return;
    }
    // string_literal_span is the run-codegen AST traversal accessor that binds an AstNode and
    // reads its Span to slice the quoted source literal (tracker 961, scope 4 prerequisite). It
    // is dispatched by name like the other AST-union accessors.
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::string_literal_span") {
        let span_mir = try compiled_mir_lower::lower_string_literal_span_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer span_mir.deinit();
        try compiled_mir_llvm::append_function(out, &span_mir);
        return;
    }
    // lower_print_call is the first compiled !RunAst error-union AST traversal lowering: it
    // recognises a single print("...") / print(local) statement and builds the wrapped RunAst
    // (tracker 961, scope 4 prerequisite). Its callee comparison forwards a call-valued argument
    // the generic multi-statement path cannot model, so it is dispatched by name.
    if std::mem::equal_bytes(function_name, "selfhost::ir::codegen::lower_print_call") {
        let call_mir = try compiled_mir_lower::lower_print_call_function(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        defer call_mir.deinit();
        try compiled_mir_llvm::append_function(out, &call_mir);
        return;
    }
    // The comment-preservation driver append_preserved_line_comments returns its loop-carried
    // scalar state as a 'CommentFormatState' struct in an error union, so its return type is the
    // '%kizu.error.comment_format_state' shape. That is the type-derived signal that selects the
    // structured-control-flow comment emitter: a forward scan loop carrying four loop-head phis,
    // an if/else comment arm that mutates a '&var std::string::String' through the
    // @kizu_rt_string_append_* ABI, and a 'return CommentFormatState { ... }' success wrap. No
    // other compiled member returns this error union, so dispatching on the return type keeps the
    // selection shape/type-driven rather than name-based (issue 1165 / 1162).
    if std::mem::equal_bytes(llvm_return_type, "%kizu.error.comment_format_state") {
        try compiled_struct_cf::append_comment_preserve_function(
            out, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        return;
    }
    // A scan-shift sort over a '&var std::array::Array<T>' parameter (an outer counter
    // loop, a nested cursor/flag scan loop, an if/else that re-merges into the loop, a
    // try-call comparator condition, and Array<T>.get/set element ABI) needs genuine
    // basic-block + phi control flow rather than the template-shaped i64-induction While
    // machinery, so it lowers through the structured-control-flow emitter
    // (issue 1165 / 1162). sort_import_indices is its first consumer.
    if try compiled_struct_cf::is_import_sort_shape(ir_bytes, function_name, statement_count, bs) {
        try compiled_struct_cf::append_import_sort_function(
            out, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        return;
    }
    // The leading-import collector builds a runtime Array<i64>, scans the token array through
    // an if/else branch-merge loop (a loop-terminating 'index = tokens.len()' on one arm, an
    // append-then-try-advance on the other), sorts the collected indices in place, and returns
    // the filled array as the '!std::array::Array<i64>' success. Its array constructor,
    // Array<T>.append, branch-merge phi, try-call advance / sort and owned success wrap need
    // genuine basic-block + phi control flow rather than the i64-induction While machinery, so
    // it lowers through the structured-control-flow emitter (issue 1165 / 1162).
    // leading_import_indices is its first consumer.
    if try compiled_struct_cf::is_leading_import_shape(ir_bytes, function_name, statement_count, bs) {
        try compiled_struct_cf::append_leading_import_function(
            out, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        return;
    }
    // The single-import emitter mutates a '&var std::string::String' accumulator: it appends the
    // 'import ' prefix, scans the import's tokens through a loop carrying an early-return ';'
    // append and a fall-through 'ident or double-colon' text append, and returns the void
    // success. Its String append runtime calls, string-literal globals, early-return branch and
    // boolean-or fall-through need genuine basic-block + phi control flow rather than the
    // i64-induction While machinery, so it lowers through the structured-control-flow emitter
    // (issue 1165 / 1162). append_import_decl is its first consumer.
    if try compiled_struct_cf::is_import_decl_shape(ir_bytes, function_name, statement_count, bs) {
        try compiled_struct_cf::append_import_decl_function(
            out, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        return;
    }
    // The indentation emitter scans an i64 depth counter, appending the indentation string literal
    // through the @kizu_rt_string_append_bytes ABI on each iteration. It mutates a '&var
    // std::string::String' accumulator inside a counter loop whose String append runtime call and
    // try-propagation need genuine basic-block + phi control flow rather than the i64-induction
    // While machinery, so it lowers through the structured-control-flow emitter (issue 1165 /
    // 1162). It shares the (Let(Int), While, Return(Empty)) top-level shape with the import-cluster
    // emitter, so it is dispatched ahead of is_sorted_imports_shape. append_indent is its first
    // consumer.
    if try compiled_struct_cf::is_append_indent_shape(ir_bytes, function_name, statement_count, bs) {
        try compiled_struct_cf::append_append_indent_function(
            out, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        return;
    }
    // The import-cluster emitter scans the sorted indices array and, for each, appends a single
    // import declaration via append_import_decl followed by a newline byte. Its checked
    // Array<i64>.get, its try-call to the String-mutating append_import_decl with error
    // propagation, and its @kizu_rt_string_append_byte newline append need genuine basic-block +
    // phi control flow rather than the i64-induction While machinery, so it lowers through the
    // structured-control-flow emitter (issue 1165 / 1162). append_sorted_imports is its first
    // consumer.
    if try compiled_struct_cf::is_sorted_imports_shape(ir_bytes, function_name, statement_count, bs) {
        try compiled_struct_cf::append_sorted_imports_function(
            out, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
        );
        return;
    }
    let mir = try compiled_mir_lower::lower_multi_statement_function(
        ir_bytes,
        function_name,
        llvm_symbol,
        llvm_return_type,
        params_spec,
        statement_count,
        bs
    );
    defer mir.deinit();
    try compiled_mir_llvm::append_function(out, &mir);
    return;
}

pub fn append_compiled_function_auto(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: &[]u8,
    params_spec: &[]u8
) -> !void {
    let llvm_return_type = try compiled_signature::derive_return_type(ir_bytes, function_name);
    let llvm_symbol_value = llvm_symbol.*;
    let params_spec_value = params_spec.*;
    try append_compiled_function_params(
        out, ir_bytes, function_name, llvm_symbol_value,
        llvm_return_type, params_spec_value
    );
    return;
}
