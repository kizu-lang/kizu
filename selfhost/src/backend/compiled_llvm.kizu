import selfhost::backend::ir_contract;

pub fn append_compiled_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8
) -> !void {
    try append_compiled_function_typed(
        out,
        ir_bytes,
        function_name,
        llvm_symbol,
        function_name[0..0]
    );
    return;
}

pub fn append_compiled_function_typed(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8
) -> !void {
    try append_compiled_function_params(
        out,
        ir_bytes,
        function_name,
        llvm_symbol,
        llvm_return_type,
        ""
    );
    return;
}

pub fn append_compiled_function_params(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8
) -> !void {
    let statement_count = try count_block_statements(ir_bytes, function_name);
    if statement_count == 1 {
        let statement = try ir_contract::body_child_sequence(
            ir_bytes, function_name, 0, "statement", 0
        );
        let kind = try ir_contract::body_node_kind(ir_bytes, function_name, statement);
        if !std::mem::equal_bytes(kind, "Return") {
            return error("compiled function: single statement must be return");
        }
        let value = try ir_contract::body_child_sequence(
            ir_bytes, function_name, statement, "value", 0
        );
        let value_kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
        if std::mem::equal_bytes(value_kind, "String") {
            try append_string_return_function(
                out, ir_bytes, function_name, llvm_symbol, value
            );
            return;
        }
        if std::mem::equal_bytes(value_kind, "Int") {
            try append_int_return_function(
                out, ir_bytes, function_name, llvm_symbol, value
            );
            return;
        }
        if std::mem::equal_bytes(value_kind, "FieldExpr") {
            try append_field_expr_return_function(
                out, ir_bytes, function_name, llvm_symbol, value
            );
            return;
        }
        if std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
            if std::mem::len(llvm_return_type) == 0 {
                return error("compiled function: struct literal requires llvm_return_type");
            }
            try append_struct_literal_return_function_with_params(
                out, ir_bytes, function_name, llvm_symbol,
                llvm_return_type, params_spec, value
            );
            return;
        }
        if std::mem::equal_bytes(value_kind, "Call") {
            try append_call_return_function(
                out, ir_bytes, function_name, llvm_symbol,
                llvm_return_type, params_spec, value
            );
            return;
        }
        return error("compiled function: unsupported return value kind");
    }
    try append_multi_statement_function(
        out, ir_bytes, function_name, llvm_symbol,
        llvm_return_type, params_spec, statement_count
    );
    return;
}

fn count_block_statements(ir_bytes: []u8, function_name: []u8) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one(
            ir_bytes, function_name, 0, "statement", count
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

fn append_string_return_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    value_node: i64
) -> !void {
    let token = try ir_contract::body_token_or_empty(
        ir_bytes,
        function_name,
        value_node
    );
    let token_len = std::mem::len(token);
    if token_len < 2 {
        return error("compiled function: invalid string token");
    }
    let quote = cast<u8>(34);
    if token[0] != quote or token[token_len - 1] != quote {
        return error("compiled function: string token must be quoted");
    }
    let payload = token[1..token_len - 1];
    let payload_len = token_len - 2;
    try out.append_bytes("@.kizu.compiled.");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(" x i8] c");
    try out.append_byte(quote);
    try append_llvm_c_string_payload(out, payload);
    try out.append_byte(quote);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("define %kizu.slice.u8 @");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %ptr = getelementptr [");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(" x i8], ptr @.kizu.compiled.");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes(
        "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %slice = insertvalue %kizu.slice.u8 %base, i64 ");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.slice.u8 %slice");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_int_return_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    value_node: i64
) -> !void {
    let int_value = try ir_contract::body_int_value(
        ir_bytes,
        function_name,
        value_node
    );
    try out.append_bytes("define i64 @");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret i64 ");
    try std::fmt::append_i64(out, int_value);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_field_expr_return_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    value_node: i64
) -> !void {
    let field_name = try ir_contract::body_field_expr_name(
        ir_bytes,
        function_name,
        value_node,
        "namespace"
    );
    let receiver = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        value_node,
        "receiver",
        0
    );
    let receiver_token = try ir_contract::body_token_or_empty(
        ir_bytes,
        function_name,
        receiver
    );
    let module_prefix = module_prefix_of(function_name);
    let tag = try enum_variant_tag_by_prefix(
        ir_bytes,
        module_prefix,
        receiver_token,
        field_name
    );
    try out.append_bytes("define i64 @");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret i64 ");
    try std::fmt::append_i64(out, tag);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_struct_literal_return_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    value_node: i64
) -> !void {
    try append_struct_literal_return_function_with_params(
        out, ir_bytes, function_name, llvm_symbol,
        llvm_return_type, "", value_node
    );
    return;
}

fn append_struct_literal_return_function_with_params(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64
) -> !void {
    let field_count = try count_struct_fields(
        ir_bytes,
        function_name,
        value_node
    );
    try append_struct_globals_with_params(
        out,
        ir_bytes,
        function_name,
        llvm_symbol,
        params_spec,
        value_node,
        field_count
    );
    try out.append_bytes("define ");
    try out.append_bytes(llvm_return_type);
    try out.append_bytes(" @");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes("(");
    try append_params_signature(out, params_spec);
    try out.append_bytes(") {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    let module_prefix = module_prefix_of(function_name);
    var extract_counter = 0;
    var field_index = 0;
    while field_index < field_count {
        let field_node = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            value_node,
            "field",
            field_index
        );
        let field_value = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            field_node,
            "value",
            0
        );
        let field_value_kind = try ir_contract::body_node_kind(
            ir_bytes,
            function_name,
            field_value
        );
        extract_counter = try append_struct_field_with_params(
            out,
            ir_bytes,
            function_name,
            llvm_symbol,
            llvm_return_type,
            module_prefix,
            params_spec,
            field_index,
            field_count,
            field_value,
            field_value_kind,
            extract_counter
        );
        field_index = field_index + 1;
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(llvm_return_type);
    if field_count == 0 {
        try out.append_bytes(" poison");
    } else {
        try out.append_bytes(" %v");
        try std::fmt::append_i64(out, field_count - 1);
    }
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}

fn count_struct_fields(
    ir_bytes: []u8,
    function_name: []u8,
    struct_node: i64
) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one(
            ir_bytes,
            function_name,
            struct_node,
            "field",
            count
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

fn append_struct_globals(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    struct_node: i64,
    field_count: i64
) -> !void {
    var field_index = 0;
    while field_index < field_count {
        let field_node = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            struct_node,
            "field",
            field_index
        );
        let field_value = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            field_node,
            "value",
            0
        );
        let value_kind = try ir_contract::body_node_kind(
            ir_bytes,
            function_name,
            field_value
        );
        if std::mem::equal_bytes(value_kind, "String") {
            let token = try ir_contract::body_token_or_empty(
                ir_bytes,
                function_name,
                field_value
            );
            let token_len = std::mem::len(token);
            if token_len >= 2 {
                let quote = cast<u8>(34);
                let payload = token[1..token_len - 1];
                let payload_len = token_len - 2;
                try out.append_bytes("@.kizu.compiled.");
                try out.append_bytes(llvm_symbol);
                try out.append_bytes(".f");
                try std::fmt::append_i64(out, field_index);
                try out.append_bytes(" = private unnamed_addr constant [");
                try std::fmt::append_i64(out, payload_len);
                try out.append_bytes(" x i8] c");
                try out.append_byte(quote);
                try append_llvm_c_string_payload(out, payload);
                try out.append_byte(quote);
                try out.append_byte(cast<u8>(10));
            }
        }
        field_index = field_index + 1;
    }
    return;
}

fn append_struct_field_insertvalue(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    module_prefix: []u8,
    field_index: i64,
    field_count: i64,
    field_value: i64,
    field_value_kind: []u8
) -> !void {
    if std::mem::equal_bytes(field_value_kind, "String") {
        try append_struct_string_field(
            out,
            ir_bytes,
            function_name,
            llvm_symbol,
            llvm_return_type,
            field_index,
            field_value
        );
        return;
    }
    if std::mem::equal_bytes(field_value_kind, "Int") {
        let int_value = try ir_contract::body_int_value(
            ir_bytes,
            function_name,
            field_value
        );
        try append_insertvalue_line(
            out,
            llvm_return_type,
            field_index,
            "i64",
            field_index
        );
        try std::fmt::append_i64(out, int_value);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field_index);
        try out.append_byte(cast<u8>(10));
        return;
    }
    if std::mem::equal_bytes(field_value_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty(
            ir_bytes,
            function_name,
            field_value
        );
        try append_insertvalue_line(
            out,
            llvm_return_type,
            field_index,
            "i1",
            field_index
        );
        if std::mem::equal_bytes(token, "true") {
            try out.append_bytes("true");
        } else {
            try out.append_bytes("false");
        }
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field_index);
        try out.append_byte(cast<u8>(10));
        return;
    }
    if std::mem::equal_bytes(field_value_kind, "FieldExpr") {
        let variant_name = try ir_contract::body_field_expr_name(
            ir_bytes,
            function_name,
            field_value,
            "namespace"
        );
        let receiver = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            field_value,
            "receiver",
            0
        );
        let receiver_token = try ir_contract::body_token_or_empty(
            ir_bytes,
            function_name,
            receiver
        );
        let tag = try enum_variant_tag_by_prefix(
            ir_bytes,
            module_prefix,
            receiver_token,
            variant_name
        );
        try append_insertvalue_line(
            out,
            llvm_return_type,
            field_index,
            "i64",
            field_index
        );
        try std::fmt::append_i64(out, tag);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field_index);
        try out.append_byte(cast<u8>(10));
        return;
    }
    return error("compiled function: unsupported struct field value kind");
}

fn append_struct_string_field(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    field_index: i64,
    field_value: i64
) -> !void {
    let token = try ir_contract::body_token_or_empty(
        ir_bytes,
        function_name,
        field_value
    );
    let token_len = std::mem::len(token);
    let quote = cast<u8>(34);
    if token_len < 2 or token[0] != quote or token[token_len - 1] != quote {
        return error("compiled function: invalid string token in struct field");
    }
    let payload_len = token_len - 2;
    try out.append_bytes("  %f");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_ptr = getelementptr [");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(" x i8], ptr @.kizu.compiled.");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes(".f");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %f");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %f");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %f");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %f");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try append_insertvalue_line(
        out,
        llvm_return_type,
        field_index,
        "%kizu.slice.u8",
        field_index
    );
    try out.append_bytes("%f");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_slice, ");
    try std::fmt::append_i64(out, field_index);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_insertvalue_line(
    out: &var std::string::String,
    llvm_type: []u8,
    field_index: i64,
    field_type: []u8,
    struct_field_index: i64
) -> !void {
    try out.append_bytes("  %v");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes(" = insertvalue ");
    try out.append_bytes(llvm_type);
    try out.append_byte(cast<u8>(32));
    if field_index == 0 {
        try out.append_bytes("poison");
    } else {
        try out.append_bytes("%v");
        try std::fmt::append_i64(out, field_index - 1);
    }
    try out.append_bytes(", ");
    try out.append_bytes(field_type);
    try out.append_byte(cast<u8>(32));
    return;
}

fn module_prefix_of(function_name: []u8) -> []u8 {
    let fn_len = std::mem::len(function_name);
    var index = fn_len;
    while index > 0 {
        index = index - 1;
        if function_name[index] == cast<u8>(58) and
            index > 0 and
            function_name[index - 1] == cast<u8>(58) {
            return function_name[0..index + 1];
        }
    }
    return function_name[0..0];
}

fn enum_variant_tag_by_prefix(
    ir_bytes: []u8,
    module_prefix: []u8,
    short_enum: []u8,
    variant: []u8
) -> !i64 {
    let prefix_len = std::mem::len(module_prefix);
    let short_len = std::mem::len(short_enum);
    let qualified_len = prefix_len + short_len;
    let byte_len = std::mem::len(ir_bytes);
    let marker = "enum-variant ";
    let marker_len = std::mem::len(marker);
    var index = 0;
    while index + marker_len + qualified_len < byte_len {
        if is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + marker_len], marker) {
            let name_start = index + marker_len;
            let prefix_end = name_start + prefix_len;
            let enum_end = prefix_end + short_len;
            if enum_end < byte_len and
                std::mem::equal_bytes(ir_bytes[name_start..prefix_end], module_prefix) and
                std::mem::equal_bytes(ir_bytes[prefix_end..enum_end], short_enum) and
                ir_bytes[enum_end] == cast<u8>(32) {
                let tag = try match_enum_variant_suffix(
                    ir_bytes,
                    enum_end,
                    variant
                );
                if tag >= 0 {
                    return tag;
                }
            }
        }
        index = index + 1;
    }
    return error("compiled function: enum variant not found");
}

fn match_enum_variant_suffix(
    ir_bytes: []u8,
    after_enum: i64,
    variant: []u8
) -> !i64 {
    let byte_len = std::mem::len(ir_bytes);
    let variant_len = std::mem::len(variant);
    var pos = after_enum;
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    let variant_end = pos + variant_len;
    if variant_end >= byte_len {
        return -1;
    }
    if !std::mem::equal_bytes(ir_bytes[pos..variant_end], variant) {
        return -1;
    }
    if ir_bytes[variant_end] != cast<u8>(32) {
        return -1;
    }
    var tag_start = variant_end;
    while tag_start < byte_len and ir_bytes[tag_start] == cast<u8>(32) {
        tag_start = tag_start + 1;
    }
    var tag_value = 0;
    var found = false;
    while tag_start < byte_len {
        let byte = ir_bytes[tag_start];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            break;
        }
        tag_value = tag_value * 10 + cast<i64>(byte) - 48;
        found = true;
        tag_start = tag_start + 1;
    }
    if !found {
        return -1;
    }
    return tag_value;
}

fn is_line_start(bytes: []u8, index: i64) -> bool {
    if index == 0 {
        return true;
    }
    return bytes[index - 1] == cast<u8>(10);
}

fn append_params_signature(
    out: &var std::string::String,
    params_spec: []u8
) -> !void {
    let spec_len = std::mem::len(params_spec);
    if spec_len == 0 {
        return;
    }
    try out.append_byte(cast<u8>(10));
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    var param_index = 0;
    while pos < spec_len {
        let entry_end = find_byte(params_spec, semicolon, pos);
        let space_pos = find_byte(params_spec, space, pos);
        if space_pos >= entry_end {
            return error("compiled function: invalid params_spec");
        }
        let param_type = params_spec[pos..space_pos];
        let param_name = params_spec[space_pos + 1..entry_end];
        if param_index > 0 {
            try out.append_bytes(",");
            try out.append_byte(cast<u8>(10));
        }
        try out.append_bytes("  ");
        try out.append_bytes(param_type);
        try out.append_bytes(" %");
        try out.append_bytes(param_name);
        param_index = param_index + 1;
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    try out.append_byte(cast<u8>(10));
    return;
}

fn find_byte(bytes: []u8, target: u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len {
        if bytes[index] == target {
            return index;
        }
        index = index + 1;
    }
    return byte_len;
}

fn find_param_type(params_spec: []u8, name: []u8) -> ![]u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    while pos < spec_len {
        let entry_end = find_byte(params_spec, semicolon, pos);
        let space_pos = find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            let param_type = params_spec[pos..space_pos];
            let param_name = params_spec[space_pos + 1..entry_end];
            if std::mem::equal_bytes(param_name, name) {
                return param_type;
            }
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return error("compiled function: param not found");
}

fn append_struct_globals_with_params(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    params_spec: []u8,
    struct_node: i64,
    field_count: i64
) -> !void {
    var field_index = 0;
    while field_index < field_count {
        let field_node = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            struct_node,
            "field",
            field_index
        );
        let field_value = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            field_node,
            "value",
            0
        );
        let value_kind = try ir_contract::body_node_kind(
            ir_bytes,
            function_name,
            field_value
        );
        if std::mem::equal_bytes(value_kind, "String") {
            let token = try ir_contract::body_token_or_empty(
                ir_bytes,
                function_name,
                field_value
            );
            let token_len = std::mem::len(token);
            if token_len >= 2 {
                let quote = cast<u8>(34);
                let payload = token[1..token_len - 1];
                let payload_len = token_len - 2;
                try out.append_bytes("@.kizu.compiled.");
                try out.append_bytes(llvm_symbol);
                try out.append_bytes(".f");
                try std::fmt::append_i64(out, field_index);
                try out.append_bytes(" = private unnamed_addr constant [");
                try std::fmt::append_i64(out, payload_len);
                try out.append_bytes(" x i8] c");
                try out.append_byte(quote);
                try append_llvm_c_string_payload(out, payload);
                try out.append_byte(quote);
                try out.append_byte(cast<u8>(10));
            }
        }
        field_index = field_index + 1;
    }
    return;
}

fn append_struct_field_with_params(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_count: i64,
    field_value: i64,
    field_value_kind: []u8,
    extract_counter: i64
) -> !i64 {
    if std::mem::equal_bytes(field_value_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty(
            ir_bytes,
            function_name,
            field_value
        );
        let var_type = try find_param_type(params_spec, var_name);
        try append_insertvalue_line(
            out,
            llvm_return_type,
            field_index,
            var_type,
            field_index
        );
        try out.append_bytes("%");
        try out.append_bytes(var_name);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field_index);
        try out.append_byte(cast<u8>(10));
        return extract_counter;
    }
    if std::mem::equal_bytes(field_value_kind, "FieldExpr") {
        let mode = try ir_contract::sequence_fact_second_value(
            ir_bytes,
            "body-field-expr ",
            function_name,
            field_value
        );
        if std::mem::equal_bytes(mode, "field") {
            let new_counter = try append_field_access_insertvalue(
                out,
                ir_bytes,
                function_name,
                llvm_return_type,
                module_prefix,
                params_spec,
                field_index,
                field_value,
                extract_counter
            );
            return new_counter;
        }
        let variant_name = try ir_contract::body_field_expr_name(
            ir_bytes,
            function_name,
            field_value,
            "namespace"
        );
        let receiver = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            field_value,
            "receiver",
            0
        );
        let receiver_token = try ir_contract::body_token_or_empty(
            ir_bytes,
            function_name,
            receiver
        );
        let tag = try enum_variant_tag_by_prefix(
            ir_bytes,
            module_prefix,
            receiver_token,
            variant_name
        );
        try append_insertvalue_line(
            out,
            llvm_return_type,
            field_index,
            "i64",
            field_index
        );
        try std::fmt::append_i64(out, tag);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field_index);
        try out.append_byte(cast<u8>(10));
        return extract_counter;
    }
    if std::mem::equal_bytes(field_value_kind, "IndexExpr") {
        let new_counter = try append_index_expr_insertvalue(
            out,
            ir_bytes,
            function_name,
            llvm_return_type,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            extract_counter
        );
        return new_counter;
    }
    if std::mem::equal_bytes(field_value_kind, "String") {
        try append_struct_string_field(
            out,
            ir_bytes,
            function_name,
            llvm_symbol,
            llvm_return_type,
            field_index,
            field_value
        );
        return extract_counter;
    }
    if std::mem::equal_bytes(field_value_kind, "Int") {
        let int_value = try ir_contract::body_int_value(
            ir_bytes,
            function_name,
            field_value
        );
        try append_insertvalue_line(
            out,
            llvm_return_type,
            field_index,
            "i64",
            field_index
        );
        try std::fmt::append_i64(out, int_value);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field_index);
        try out.append_byte(cast<u8>(10));
        return extract_counter;
    }
    if std::mem::equal_bytes(field_value_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty(
            ir_bytes,
            function_name,
            field_value
        );
        try append_insertvalue_line(
            out,
            llvm_return_type,
            field_index,
            "i1",
            field_index
        );
        if std::mem::equal_bytes(token, "true") {
            try out.append_bytes("true");
        } else {
            try out.append_bytes("false");
        }
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field_index);
        try out.append_byte(cast<u8>(10));
        return extract_counter;
    }
    return error("compiled function: unsupported struct field value kind");
}

fn append_field_access_insertvalue(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_return_type: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    target_field_index: i64,
    field_expr_node: i64,
    extract_counter: i64
) -> !i64 {
    let field_name = try ir_contract::body_field_expr_name(
        ir_bytes,
        function_name,
        field_expr_node,
        "field"
    );
    let receiver = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        field_expr_node,
        "receiver",
        0
    );
    let receiver_kind = try ir_contract::body_node_kind(
        ir_bytes,
        function_name,
        receiver
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled function: field access receiver must be Var");
    }
    let receiver_name = try ir_contract::body_token_or_empty(
        ir_bytes,
        function_name,
        receiver
    );
    let receiver_type = try find_param_type(params_spec, receiver_name);
    let source_field_index = try struct_field_index_by_name(
        ir_bytes,
        module_prefix,
        receiver_name,
        params_spec,
        field_name
    );
    let field_llvm_type = try struct_field_llvm_type(
        ir_bytes,
        module_prefix,
        receiver_name,
        params_spec,
        source_field_index
    );
    try out.append_bytes("  %ex");
    try std::fmt::append_i64(out, extract_counter);
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(receiver_type);
    try out.append_bytes(" %");
    try out.append_bytes(receiver_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, source_field_index);
    try out.append_byte(cast<u8>(10));
    try append_insertvalue_line(
        out,
        llvm_return_type,
        target_field_index,
        field_llvm_type,
        target_field_index
    );
    try out.append_bytes("%ex");
    try std::fmt::append_i64(out, extract_counter);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, target_field_index);
    try out.append_byte(cast<u8>(10));
    return extract_counter + 1;
}

fn append_index_expr_insertvalue(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_return_type: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    target_field_index: i64,
    index_expr_node: i64,
    extract_counter: i64
) -> !i64 {
    let start_node = try ir_contract::body_child_sequence(
        ir_bytes, function_name, index_expr_node, "start", 0
    );
    let end_node = try ir_contract::body_child_sequence(
        ir_bytes, function_name, index_expr_node, "end", 0
    );
    let start_val = try ir_contract::body_int_value(ir_bytes, function_name, start_node);
    let end_val = try ir_contract::body_int_value(ir_bytes, function_name, end_node);
    if start_val != 0 or end_val != 0 {
        return error("compiled function: only [0..0] index expr supported");
    }
    try append_insertvalue_line(
        out,
        llvm_return_type,
        target_field_index,
        "%kizu.slice.u8",
        target_field_index
    );
    try out.append_bytes("zeroinitializer, ");
    try std::fmt::append_i64(out, target_field_index);
    try out.append_byte(cast<u8>(10));
    return extract_counter;
}

fn struct_field_index_by_name(
    ir_bytes: []u8,
    module_prefix: []u8,
    var_name: []u8,
    params_spec: []u8,
    field_name: []u8
) -> !i64 {
    let kizu_type = try find_param_kizu_type(ir_bytes, module_prefix, var_name, params_spec);
    return try lookup_struct_field_index_by_prefix(
        ir_bytes, module_prefix, kizu_type, field_name
    );
}

fn struct_field_llvm_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    var_name: []u8,
    params_spec: []u8,
    field_index: i64
) -> ![]u8 {
    let kizu_type = try find_param_kizu_type(ir_bytes, module_prefix, var_name, params_spec);
    let field_type = try lookup_struct_field_type_by_prefix(
        ir_bytes, module_prefix, kizu_type, field_index
    );
    return try kizu_type_to_llvm(ir_bytes, module_prefix, field_type);
}

fn find_param_kizu_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    var_name: []u8,
    params_spec: []u8
) -> ![]u8 {
    let llvm_type = try find_param_type(params_spec, var_name);
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(module_prefix);
    var index = 0;
    while index + prefix_len < byte_len {
        if is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let after_prefix = index + prefix_len;
            if after_prefix + mp_len < byte_len and
                std::mem::equal_bytes(ir_bytes[after_prefix..after_prefix + mp_len], module_prefix) {
                let kizu_type = try extract_param_kizu_type_from_line(
                    ir_bytes, after_prefix, var_name
                );
                if std::mem::len(kizu_type) > 0 {
                    return kizu_type;
                }
            }
        }
        index = index + 1;
    }
    return error("compiled function: param kizu type not found");
}

fn extract_param_kizu_type_from_line(
    ir_bytes: []u8,
    fn_start: i64,
    var_name: []u8
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    var pos = fn_start;
    while pos < byte_len and ir_bytes[pos] != cast<u8>(32) {
        pos = pos + 1;
    }
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    while pos < byte_len and ir_bytes[pos] >= cast<u8>(48) and ir_bytes[pos] <= cast<u8>(57) {
        pos = pos + 1;
    }
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    let entry_start = pos;
    let line_end_pos = find_line_end(ir_bytes, pos);
    let entry = ir_bytes[entry_start..line_end_pos];
    let colon1 = find_byte(entry, cast<u8>(58), 0);
    let entry_len = std::mem::len(entry);
    if colon1 >= entry_len {
        return ir_bytes[0..0];
    }
    let param_name = entry[0..colon1];
    if !std::mem::equal_bytes(param_name, var_name) {
        return ir_bytes[0..0];
    }
    let colon2 = find_byte(entry, cast<u8>(58), colon1 + 1);
    if colon2 >= entry_len {
        return ir_bytes[0..0];
    }
    return entry[colon2 + 1..entry_len];
}

fn find_line_end(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len and bytes[index] != cast<u8>(10) {
        index = index + 1;
    }
    return index;
}

fn lookup_type_llvm_by_prefix(
    ir_bytes: []u8,
    module_prefix: []u8,
    short_name: []u8
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "type-llvm ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(module_prefix);
    let name_len = std::mem::len(short_name);
    var index = 0;
    while index + prefix_len + mp_len + name_len < byte_len {
        if is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let mp_start = index + prefix_len;
            let mp_end = mp_start + mp_len;
            let name_end = mp_end + name_len;
            if name_end < byte_len and
                std::mem::equal_bytes(ir_bytes[mp_start..mp_end], module_prefix) and
                std::mem::equal_bytes(ir_bytes[mp_end..name_end], short_name) and
                ir_bytes[name_end] == cast<u8>(32) {
                var pos = name_end;
                while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
                    pos = pos + 1;
                }
                let value_end = find_line_end(ir_bytes, pos);
                return ir_bytes[pos..value_end];
            }
        }
        index = index + 1;
    }
    return error("compiled function: type-llvm mapping not found");
}

fn lookup_struct_field_index_by_prefix(
    ir_bytes: []u8,
    module_prefix: []u8,
    short_type: []u8,
    field_name: []u8
) -> !i64 {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "struct-field ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(module_prefix);
    let type_len = std::mem::len(short_type);
    var index = 0;
    while index + prefix_len + mp_len + type_len < byte_len {
        if is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let mp_start = index + prefix_len;
            let mp_end = mp_start + mp_len;
            let type_end = mp_end + type_len;
            if type_end < byte_len and
                std::mem::equal_bytes(ir_bytes[mp_start..mp_end], module_prefix) and
                std::mem::equal_bytes(ir_bytes[mp_end..type_end], short_type) and
                ir_bytes[type_end] == cast<u8>(32) {
                let field_index = try extract_struct_field_match(
                    ir_bytes, type_end, field_name
                );
                if field_index >= 0 {
                    return field_index;
                }
            }
        }
        index = index + 1;
    }
    return error("compiled function: struct field not found");
}

fn lookup_struct_field_type_by_prefix(
    ir_bytes: []u8,
    module_prefix: []u8,
    short_type: []u8,
    target_index: i64
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "struct-field ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(module_prefix);
    let type_len = std::mem::len(short_type);
    var index = 0;
    while index + prefix_len + mp_len + type_len < byte_len {
        if is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let mp_start = index + prefix_len;
            let mp_end = mp_start + mp_len;
            let type_end = mp_end + type_len;
            if type_end < byte_len and
                std::mem::equal_bytes(ir_bytes[mp_start..mp_end], module_prefix) and
                std::mem::equal_bytes(ir_bytes[mp_end..type_end], short_type) and
                ir_bytes[type_end] == cast<u8>(32) {
                let field_type = try extract_struct_field_type_at_index(
                    ir_bytes, type_end, target_index
                );
                if std::mem::len(field_type) > 0 {
                    return field_type;
                }
            }
        }
        index = index + 1;
    }
    return error("compiled function: struct field type not found");
}

fn extract_struct_field_match(
    ir_bytes: []u8,
    after_type: i64,
    field_name: []u8
) -> !i64 {
    let byte_len = std::mem::len(ir_bytes);
    var pos = after_type;
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    var field_index = 0;
    var found_digit = false;
    while pos < byte_len and ir_bytes[pos] >= cast<u8>(48) and ir_bytes[pos] <= cast<u8>(57) {
        field_index = field_index * 10 + cast<i64>(ir_bytes[pos]) - 48;
        found_digit = true;
        pos = pos + 1;
    }
    if !found_digit {
        return -1;
    }
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    let name_start = pos;
    while pos < byte_len and ir_bytes[pos] != cast<u8>(32) and ir_bytes[pos] != cast<u8>(10) {
        pos = pos + 1;
    }
    let actual_name = ir_bytes[name_start..pos];
    if std::mem::equal_bytes(actual_name, field_name) {
        return field_index;
    }
    return -1;
}

fn extract_struct_field_type_at_index(
    ir_bytes: []u8,
    after_type: i64,
    target_index: i64
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    var pos = after_type;
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    var field_index = 0;
    var found_digit = false;
    while pos < byte_len and ir_bytes[pos] >= cast<u8>(48) and ir_bytes[pos] <= cast<u8>(57) {
        field_index = field_index * 10 + cast<i64>(ir_bytes[pos]) - 48;
        found_digit = true;
        pos = pos + 1;
    }
    if !found_digit or field_index != target_index {
        return ir_bytes[0..0];
    }
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    while pos < byte_len and ir_bytes[pos] != cast<u8>(32) and ir_bytes[pos] != cast<u8>(10) {
        pos = pos + 1;
    }
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    let type_start = pos;
    let type_end = find_line_end(ir_bytes, pos);
    return ir_bytes[type_start..type_end];
}

fn kizu_type_to_llvm(
    ir_bytes: []u8,
    module_prefix: []u8,
    kizu_type: []u8
) -> ![]u8 {
    if std::mem::equal_bytes(kizu_type, "i64") {
        return "i64";
    }
    if std::mem::equal_bytes(kizu_type, "bool") {
        return "i1";
    }
    if std::mem::equal_bytes(kizu_type, "u8") {
        return "i8";
    }
    if std::mem::equal_bytes(kizu_type, "[]u8") {
        return "%kizu.slice.u8";
    }
    if std::mem::equal_bytes(kizu_type, "void") {
        return "void";
    }
    if is_enum_type(ir_bytes, module_prefix, kizu_type) {
        return "i64";
    }
    return try lookup_type_llvm_by_prefix(ir_bytes, module_prefix, kizu_type);
}

fn is_enum_type(ir_bytes: []u8, module_prefix: []u8, short_name: []u8) -> bool {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "enum-variant ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(module_prefix);
    let name_len = std::mem::len(short_name);
    var index = 0;
    while index + prefix_len + mp_len + name_len < byte_len {
        if is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let mp_start = index + prefix_len;
            let mp_end = mp_start + mp_len;
            let name_end = mp_end + name_len;
            if name_end < byte_len and
                std::mem::equal_bytes(ir_bytes[mp_start..mp_end], module_prefix) and
                std::mem::equal_bytes(ir_bytes[mp_end..name_end], short_name) and
                ir_bytes[name_end] == cast<u8>(32) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

fn append_call_return_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64
) -> !void {
    let module_prefix = module_prefix_of(function_name);
    try append_call_string_globals(out, ir_bytes, function_name, llvm_symbol, call_node, 0);
    try out.append_bytes("define ");
    try out.append_bytes(llvm_return_type);
    try out.append_bytes(" @");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes("(");
    try append_params_signature(out, params_spec);
    try out.append_bytes(") {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    let call_result_type = try resolve_call_return_type(
        ir_bytes, function_name, module_prefix, call_node
    );
    try append_call_instruction(
        out, ir_bytes, function_name, llvm_symbol,
        module_prefix, params_spec, params_spec,
        call_node, "result", 0, call_result_type
    );
    try out.append_bytes("  ret ");
    try out.append_bytes(call_result_type);
    try out.append_bytes(" %result");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_multi_statement_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64
) -> !void {
    let module_prefix = module_prefix_of(function_name);
    try append_multi_statement_globals(
        out, ir_bytes, function_name, llvm_symbol, statement_count
    );
    try out.append_bytes("define ");
    try out.append_bytes(llvm_return_type);
    try out.append_bytes(" @");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes("(");
    try append_params_signature(out, params_spec);
    try out.append_bytes(") {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    var locals_spec = params_spec;
    var string_counter = 0;
    var extract_counter = 0;
    var stmt_index = 0;
    while stmt_index < statement_count {
        let statement = try ir_contract::body_child_sequence(
            ir_bytes, function_name, 0, "statement", stmt_index
        );
        let stmt_kind = try ir_contract::body_node_kind(ir_bytes, function_name, statement);
        if std::mem::equal_bytes(stmt_kind, "Return") {
            let value = try ir_contract::body_child_sequence(
                ir_bytes, function_name, statement, "value", 0
            );
            let value_kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
            if std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
                let field_count = try count_struct_fields(ir_bytes, function_name, value);
                extract_counter = try append_struct_return_body(
                    out, ir_bytes, function_name, llvm_symbol,
                    llvm_return_type, module_prefix, locals_spec,
                    value, field_count, extract_counter
                );
                try out.append_bytes("  ret ");
                try out.append_bytes(llvm_return_type);
                if field_count == 0 {
                    try out.append_bytes(" poison");
                } else {
                    try out.append_bytes(" %v");
                    try std::fmt::append_i64(out, field_count - 1);
                }
                try out.append_byte(cast<u8>(10));
            } else {
                if std::mem::equal_bytes(value_kind, "Call") {
                    let call_result_type = try resolve_call_return_type(
                        ir_bytes, function_name, module_prefix, value
                    );
                    try append_call_instruction(
                        out, ir_bytes, function_name, llvm_symbol,
                        module_prefix, locals_spec, params_spec,
                        value, "ret_val", string_counter, call_result_type
                    );
                    try out.append_bytes("  ret ");
                    try out.append_bytes(call_result_type);
                    try out.append_bytes(" %ret_val");
                    try out.append_byte(cast<u8>(10));
                } else {
                    return error("compiled function: unsupported return value kind");
                }
            }
        } else {
            if std::mem::equal_bytes(stmt_kind, "Let") {
                let let_name_node = try ir_contract::body_child_sequence(
                    ir_bytes, function_name, statement, "name", 0
                );
                let let_name = try ir_contract::body_token_or_empty(
                    ir_bytes, function_name, let_name_node
                );
                let let_value = try ir_contract::body_child_sequence(
                    ir_bytes, function_name, statement, "value", 0
                );
                let let_value_kind = try ir_contract::body_node_kind(
                    ir_bytes, function_name, let_value
                );
                if std::mem::equal_bytes(let_value_kind, "Call") {
                    let call_type = try resolve_call_return_type(
                        ir_bytes, function_name, module_prefix, let_value
                    );
                    try append_call_instruction(
                        out, ir_bytes, function_name, llvm_symbol,
                        module_prefix, locals_spec, params_spec,
                        let_value, let_name, string_counter, call_type
                    );
                    string_counter = string_counter + try count_call_string_args(
                        ir_bytes, function_name, let_value
                    );
                    locals_spec = try extend_locals_spec(
                        ir_bytes, locals_spec, let_name, call_type
                    );
                } else {
                    if std::mem::equal_bytes(let_value_kind, "StructLiteralExpr") {
                        let struct_type = try resolve_struct_literal_type(
                            ir_bytes, function_name, module_prefix, let_value
                        );
                        let field_count = try count_struct_fields(
                            ir_bytes, function_name, let_value
                        );
                        try append_let_struct_literal(
                            out, ir_bytes, function_name, llvm_symbol,
                            module_prefix, locals_spec, let_name,
                            struct_type, let_value, field_count,
                            string_counter
                        );
                        string_counter = string_counter + field_count;
                        locals_spec = try extend_locals_spec(
                            ir_bytes, locals_spec, let_name, struct_type
                        );
                    } else {
                        return error("compiled function: unsupported let value kind");
                    }
                }
            } else {
                return error("compiled function: unsupported statement kind");
            }
        }
        stmt_index = stmt_index + 1;
    }
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_multi_statement_globals(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    statement_count: i64
) -> !void {
    var global_index = 0;
    var stmt_index = 0;
    while stmt_index < statement_count {
        let statement = try ir_contract::body_child_sequence(
            ir_bytes, function_name, 0, "statement", stmt_index
        );
        let stmt_kind = try ir_contract::body_node_kind(ir_bytes, function_name, statement);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let let_value = try ir_contract::body_child_sequence(
                ir_bytes, function_name, statement, "value", 0
            );
            let let_value_kind = try ir_contract::body_node_kind(
                ir_bytes, function_name, let_value
            );
            if std::mem::equal_bytes(let_value_kind, "Call") {
                try append_call_string_globals(
                    out, ir_bytes, function_name, llvm_symbol, let_value, global_index
                );
                global_index = global_index + try count_call_string_args(
                    ir_bytes, function_name, let_value
                );
            } else {
                if std::mem::equal_bytes(let_value_kind, "StructLiteralExpr") {
                    let field_count = try count_struct_fields(ir_bytes, function_name, let_value);
                    try append_struct_globals_with_params(
                        out, ir_bytes, function_name, llvm_symbol,
                        "", let_value, field_count
                    );
                    global_index = global_index + field_count;
                }
            }
        } else {
            if std::mem::equal_bytes(stmt_kind, "Return") {
                let ret_value = try ir_contract::body_child_sequence(
                    ir_bytes, function_name, statement, "value", 0
                );
                let ret_value_kind = try ir_contract::body_node_kind(
                    ir_bytes, function_name, ret_value
                );
                if std::mem::equal_bytes(ret_value_kind, "StructLiteralExpr") {
                    let field_count = try count_struct_fields(ir_bytes, function_name, ret_value);
                    try append_struct_globals_with_params(
                        out, ir_bytes, function_name, llvm_symbol,
                        "", ret_value, field_count
                    );
                }
            }
        }
        stmt_index = stmt_index + 1;
    }
    return;
}

fn append_struct_return_body(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    value_node: i64,
    field_count: i64,
    extract_counter: i64
) -> !i64 {
    var ec = extract_counter;
    var field_index = 0;
    while field_index < field_count {
        let field_node = try ir_contract::body_child_sequence(
            ir_bytes, function_name, value_node, "field", field_index
        );
        let field_value = try ir_contract::body_child_sequence(
            ir_bytes, function_name, field_node, "value", 0
        );
        let field_value_kind = try ir_contract::body_node_kind(
            ir_bytes, function_name, field_value
        );
        ec = try append_struct_field_with_params(
            out, ir_bytes, function_name, llvm_symbol,
            llvm_return_type, module_prefix, locals_spec,
            field_index, field_count, field_value, field_value_kind, ec
        );
        field_index = field_index + 1;
    }
    return ec;
}

fn resolve_call_return_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty(
        ir_bytes, function_name, call_node
    );
    let ret_type = try lookup_fact_value_by_prefix(
        ir_bytes, "function-signature-return ", module_prefix, callee_name
    );
    return try kizu_type_to_llvm(ir_bytes, module_prefix, ret_type);
}

fn lookup_fact_value_by_prefix(
    ir_bytes: []u8,
    fact_prefix: []u8,
    module_prefix: []u8,
    short_name: []u8
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    let fp_len = std::mem::len(fact_prefix);
    let mp_len = std::mem::len(module_prefix);
    let name_len = std::mem::len(short_name);
    var index = 0;
    while index + fp_len + mp_len + name_len < byte_len {
        if is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + fp_len], fact_prefix) {
            let mp_start = index + fp_len;
            let mp_end = mp_start + mp_len;
            let name_end = mp_end + name_len;
            if name_end < byte_len and
                std::mem::equal_bytes(ir_bytes[mp_start..mp_end], module_prefix) and
                std::mem::equal_bytes(ir_bytes[mp_end..name_end], short_name) and
                ir_bytes[name_end] == cast<u8>(32) {
                var pos = name_end;
                while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
                    pos = pos + 1;
                }
                let value_end = find_line_end(ir_bytes, pos);
                return ir_bytes[pos..value_end];
            }
        }
        index = index + 1;
    }
    return error("compiled function: fact not found");
}

fn resolve_struct_literal_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    struct_literal_node: i64
) -> ![]u8 {
    let type_node = try ir_contract::body_child_sequence(
        ir_bytes, function_name, struct_literal_node, "type", 0
    );
    let type_name = try ir_contract::body_token_or_empty(
        ir_bytes, function_name, type_node
    );
    return try lookup_type_llvm_by_prefix(ir_bytes, module_prefix, type_name);
}

fn derive_callee_llvm_symbol(
    out: &var std::string::String,
    module_prefix: []u8,
    callee_name: []u8
) -> !void {
    try out.append_bytes("kizu_compiled__");
    let prefix_len = std::mem::len(module_prefix);
    if prefix_len > 11 and std::mem::equal_bytes(module_prefix[0..11], "selfhost::") {
        var pos = 11;
        while pos < prefix_len {
            let byte = module_prefix[pos];
            if byte == cast<u8>(58) {
                pos = pos + 1;
            } else {
                try out.append_byte(byte);
                pos = pos + 1;
            }
        }
    } else {
        try out.append_bytes(module_prefix);
    }
    try out.append_bytes(callee_name);
    return;
}

fn append_call_instruction(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    params_spec: []u8,
    call_node: i64,
    result_name: []u8,
    string_global_offset: i64,
    call_result_type: []u8
) -> !void {
    let callee_name = try ir_contract::body_call_callee_or_empty(
        ir_bytes, function_name, call_node
    );
    let arg_count = try count_call_args(ir_bytes, function_name, call_node);
    try append_call_arg_setup(
        out, ir_bytes, function_name, llvm_symbol, module_prefix,
        locals_spec, call_node, arg_count, string_global_offset
    );
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes(" = call ");
    try out.append_bytes(call_result_type);
    try out.append_bytes(" @");
    try derive_callee_llvm_symbol(out, module_prefix, callee_name);
    try out.append_bytes("(");
    var arg_index = 0;
    while arg_index < arg_count {
        if arg_index > 0 {
            try out.append_bytes(", ");
        }
        let arg_node = try ir_contract::body_child_sequence(
            ir_bytes, function_name, call_node, "arg", arg_index
        );
        let arg_kind = try ir_contract::body_node_kind(ir_bytes, function_name, arg_node);
        let arg_type = try resolve_call_arg_type(
            ir_bytes, module_prefix, callee_name, arg_index
        );
        try out.append_bytes(arg_type);
        try out.append_bytes(" ");
        if std::mem::equal_bytes(arg_kind, "Var") {
            let var_name = try ir_contract::body_token_or_empty(
                ir_bytes, function_name, arg_node
            );
            try out.append_bytes("%");
            try out.append_bytes(var_name);
        } else {
            if std::mem::equal_bytes(arg_kind, "String") {
                try out.append_bytes("%arg");
                try std::fmt::append_i64(out, arg_index);
                try out.append_bytes("_slice");
            } else {
                if std::mem::equal_bytes(arg_kind, "Bool") {
                    let token = try ir_contract::body_token_or_empty(
                        ir_bytes, function_name, arg_node
                    );
                    if std::mem::equal_bytes(token, "true") {
                        try out.append_bytes("true");
                    } else {
                        try out.append_bytes("false");
                    }
                } else {
                    return error("compiled function: unsupported call arg kind");
                }
            }
        }
        arg_index = arg_index + 1;
    }
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn count_call_args(ir_bytes: []u8, function_name: []u8, call_node: i64) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one(
            ir_bytes, function_name, call_node, "arg", count
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

fn count_call_string_args(ir_bytes: []u8, function_name: []u8, call_node: i64) -> !i64 {
    let arg_count = try count_call_args(ir_bytes, function_name, call_node);
    var count = 0;
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence(
            ir_bytes, function_name, call_node, "arg", index
        );
        let arg_kind = try ir_contract::body_node_kind(ir_bytes, function_name, arg_node);
        if std::mem::equal_bytes(arg_kind, "String") {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn resolve_call_arg_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_index: i64
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(module_prefix);
    let name_len = std::mem::len(callee_name);
    var index = 0;
    var matched = 0;
    while index + prefix_len + mp_len + name_len < byte_len {
        if is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let mp_start = index + prefix_len;
            let mp_end = mp_start + mp_len;
            let cn_end = mp_end + name_len;
            if cn_end < byte_len and
                std::mem::equal_bytes(ir_bytes[mp_start..mp_end], module_prefix) and
                std::mem::equal_bytes(ir_bytes[mp_end..cn_end], callee_name) and
                ir_bytes[cn_end] == cast<u8>(32) {
                if matched == arg_index {
                    let line_end_pos = find_line_end(ir_bytes, cn_end);
                    let entry = ir_bytes[cn_end..line_end_pos];
                    let entry_len = std::mem::len(entry);
                    let colon2 = find_last_colon(entry);
                    if colon2 < entry_len {
                        let kizu_type = entry[colon2 + 1..entry_len];
                        return try kizu_type_to_llvm(ir_bytes, module_prefix, kizu_type);
                    }
                }
                matched = matched + 1;
            }
        }
        index = index + 1;
    }
    return error("compiled function: call arg type not found");
}

fn find_last_colon(bytes: []u8) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = byte_len;
    while index > 0 {
        index = index - 1;
        if bytes[index] == cast<u8>(58) {
            return index;
        }
    }
    return byte_len;
}

fn append_call_arg_setup(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    arg_count: i64,
    string_global_offset: i64
) -> !void {
    var string_index = string_global_offset;
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence(
            ir_bytes, function_name, call_node, "arg", arg_index
        );
        let arg_kind = try ir_contract::body_node_kind(ir_bytes, function_name, arg_node);
        if std::mem::equal_bytes(arg_kind, "String") {
            let token = try ir_contract::body_token_or_empty(
                ir_bytes, function_name, arg_node
            );
            let token_len = std::mem::len(token);
            if token_len >= 2 {
                let payload_len = token_len - 2;
                try out.append_bytes("  %arg");
                try std::fmt::append_i64(out, arg_index);
                try out.append_bytes("_ptr = getelementptr [");
                try std::fmt::append_i64(out, payload_len);
                try out.append_bytes(" x i8], ptr @.kizu.compiled.");
                try out.append_bytes(llvm_symbol);
                try out.append_bytes(".s");
                try std::fmt::append_i64(out, string_index);
                try out.append_bytes(", i64 0, i64 0");
                try out.append_byte(cast<u8>(10));
                try out.append_bytes("  %arg");
                try std::fmt::append_i64(out, arg_index);
                try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %arg");
                try std::fmt::append_i64(out, arg_index);
                try out.append_bytes("_ptr, 0");
                try out.append_byte(cast<u8>(10));
                try out.append_bytes("  %arg");
                try std::fmt::append_i64(out, arg_index);
                try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %arg");
                try std::fmt::append_i64(out, arg_index);
                try out.append_bytes("_base, i64 ");
                try std::fmt::append_i64(out, payload_len);
                try out.append_bytes(", 1");
                try out.append_byte(cast<u8>(10));
            }
            string_index = string_index + 1;
        }
        arg_index = arg_index + 1;
    }
    return;
}

fn append_call_string_globals(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    call_node: i64,
    offset: i64
) -> !void {
    let arg_count = try count_call_args(ir_bytes, function_name, call_node);
    var string_index = offset;
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence(
            ir_bytes, function_name, call_node, "arg", arg_index
        );
        let arg_kind = try ir_contract::body_node_kind(ir_bytes, function_name, arg_node);
        if std::mem::equal_bytes(arg_kind, "String") {
            let token = try ir_contract::body_token_or_empty(
                ir_bytes, function_name, arg_node
            );
            let token_len = std::mem::len(token);
            if token_len >= 2 {
                let quote = cast<u8>(34);
                let payload = token[1..token_len - 1];
                let payload_len = token_len - 2;
                try out.append_bytes("@.kizu.compiled.");
                try out.append_bytes(llvm_symbol);
                try out.append_bytes(".s");
                try std::fmt::append_i64(out, string_index);
                try out.append_bytes(" = private unnamed_addr constant [");
                try std::fmt::append_i64(out, payload_len);
                try out.append_bytes(" x i8] c");
                try out.append_byte(quote);
                try append_llvm_c_string_payload(out, payload);
                try out.append_byte(quote);
                try out.append_byte(cast<u8>(10));
            }
            string_index = string_index + 1;
        }
        arg_index = arg_index + 1;
    }
    return;
}

fn append_let_struct_literal(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    let_name: []u8,
    struct_type: []u8,
    struct_node: i64,
    field_count: i64,
    string_global_offset: i64
) -> !void {
    var field_index = 0;
    var extract_counter = 0;
    while field_index < field_count {
        let field_node = try ir_contract::body_child_sequence(
            ir_bytes, function_name, struct_node, "field", field_index
        );
        let field_value = try ir_contract::body_child_sequence(
            ir_bytes, function_name, field_node, "value", 0
        );
        let field_value_kind = try ir_contract::body_node_kind(
            ir_bytes, function_name, field_value
        );
        try out.append_bytes("  %");
        try out.append_bytes(let_name);
        try out.append_bytes("_f");
        try std::fmt::append_i64(out, field_index);
        try out.append_bytes(" = insertvalue ");
        try out.append_bytes(struct_type);
        try out.append_byte(cast<u8>(32));
        if field_index == 0 {
            try out.append_bytes("poison");
        } else {
            try out.append_bytes("%");
            try out.append_bytes(let_name);
            try out.append_bytes("_f");
            try std::fmt::append_i64(out, field_index - 1);
        }
        try out.append_bytes(", ");
        if std::mem::equal_bytes(field_value_kind, "String") {
            let token = try ir_contract::body_token_or_empty(
                ir_bytes, function_name, field_value
            );
            let token_len = std::mem::len(token);
            let payload_len = token_len - 2;
            try out.append_bytes("%kizu.slice.u8 %");
            try out.append_bytes(let_name);
            try out.append_bytes("_s");
            try std::fmt::append_i64(out, field_index);
            try out.append_bytes("_slice, ");
            try std::fmt::append_i64(out, field_index);
            try out.append_byte(cast<u8>(10));
            try append_string_slice_setup(
                out, llvm_symbol, let_name, field_index, payload_len,
                string_global_offset + field_index
            );
        } else {
            if std::mem::equal_bytes(field_value_kind, "Int") {
                let int_value = try ir_contract::body_int_value(
                    ir_bytes, function_name, field_value
                );
                try out.append_bytes("i64 ");
                try std::fmt::append_i64(out, int_value);
                try out.append_bytes(", ");
                try std::fmt::append_i64(out, field_index);
                try out.append_byte(cast<u8>(10));
            } else {
                if std::mem::equal_bytes(field_value_kind, "Var") {
                    let var_name = try ir_contract::body_token_or_empty(
                        ir_bytes, function_name, field_value
                    );
                    let var_type = try find_param_type(locals_spec, var_name);
                    try out.append_bytes(var_type);
                    try out.append_bytes(" %");
                    try out.append_bytes(var_name);
                    try out.append_bytes(", ");
                    try std::fmt::append_i64(out, field_index);
                    try out.append_byte(cast<u8>(10));
                } else {
                    return error("compiled function: unsupported let struct field kind");
                }
            }
        }
        field_index = field_index + 1;
    }
    try out.append_bytes("  %");
    try out.append_bytes(let_name);
    try out.append_bytes(" = add i64 0, 0");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_string_slice_setup(
    out: &var std::string::String,
    llvm_symbol: []u8,
    local_name: []u8,
    field_index: i64,
    payload_len: i64,
    global_index: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(local_name);
    try out.append_bytes("_s");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_ptr = getelementptr [");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(" x i8], ptr @.kizu.compiled.");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes(".f");
    try std::fmt::append_i64(out, global_index);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local_name);
    try out.append_bytes("_s");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(local_name);
    try out.append_bytes("_s");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local_name);
    try out.append_bytes("_s");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(local_name);
    try out.append_bytes("_s");
    try std::fmt::append_i64(out, field_index);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn extend_locals_spec(
    ir_bytes: []u8,
    current_spec: []u8,
    name: []u8,
    llvm_type: []u8
) -> ![]u8 {
    return current_spec;
}

fn append_llvm_c_string_payload(
    out: &var std::string::String,
    payload: []u8
) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte == cast<u8>(34) {
            try out.append_bytes("\22");
        } else {
            if byte == cast<u8>(92) {
                try out.append_bytes("\5C");
            } else {
                if byte == cast<u8>(10) {
                    try out.append_bytes("\0A");
                } else {
                    try out.append_byte(byte);
                }
            }
        }
        index = index + 1;
    }
    return;
}
