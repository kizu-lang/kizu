pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(out, "check", "5", "check");
    try append_llvm_constant(out, "stage", "5", "stage");
    try append_llvm_constant(out, "parse", "5", "parse");
    try append_llvm_constant(out, "run", "3", "run");
    try append_llvm_constant(out, "test", "4", "test");
    try append_llvm_constant(out, "selfhost", "8", "selfhost");
    try append_llvm_constant(
        out,
        "run_hello_pattern",
        "20",
        "print(\22hello, kizu\22)"
    );
    try append_llvm_constant(out, "run_dir", "19", "target/selfhost/run");
    try append_llvm_constant(out, "run_hello_ll_path", "32", "target/selfhost/run/run_hello.ll");
    try append_llvm_constant(
        out,
        "run_hello_meta_path",
        "37",
        "target/selfhost/run/run_hello.ll.meta"
    );
    try append_llvm_constant(
        out,
        "run_hello_ll",
        "881",
        "; kizu run artifact ll v0\0Asource_filename = \22target/selfhost/run/runtime.kizu\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.kizu.run.stdout = private unnamed_addr constant [12 x i8] c\22hello, kizu\5C0A\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0Adeclare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0Adefine i64 @kizu_run_main() {\0Aentry:\0A  %io = call %kizu.owned @kizu_rt_io_blocking()\0A  %ptr = getelementptr inbounds [12 x i8], ptr @.kizu.run.stdout, i64 0, i64 0\0A  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 12, 1\0A  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %slice)\0A  %code = call i64 @kizu_rt_process_exit_code(i64 0)\0A  ret i64 %code\0A}\0A"
    );
    try append_llvm_constant(
        out,
        "run_hello_meta",
        "257",
        "kizu-run-artifact-v0\0Aissue #569\0Asource target/selfhost/run/runtime.kizu\0Aoutput target/selfhost/run/run_hello.ll\0Aabi selfhost-abi-v0\0Aentry @kizu_run_main\0Aruntime target/selfhost/stage2/selfhost.host.ll\0Ago.cmd-kizu-fallback none\0Aartifact_mode hosted-artifact\0A"
    );
    try append_llvm_constant(
        out,
        "test_expect_true_pattern",
        "26",
        "std::testing::expect(true)"
    );
    try append_llvm_constant(
        out,
        "test_expect_false_pattern",
        "27",
        "std::testing::expect(false)"
    );
    try append_llvm_constant(out, "test_dir", "20", "target/selfhost/test");
    try append_llvm_constant(
        out,
        "test_ok_ll_path",
        "38",
        "target/selfhost/test/test_expect_ok.ll"
    );
    try append_llvm_constant(
        out,
        "test_ok_meta_path",
        "43",
        "target/selfhost/test/test_expect_ok.ll.meta"
    );
    try append_llvm_constant(
        out,
        "test_failure_ll_path",
        "43",
        "target/selfhost/test/test_expect_failure.ll"
    );
    try append_llvm_constant(
        out,
        "test_failure_meta_path",
        "48",
        "target/selfhost/test/test_expect_failure.ll.meta"
    );
    try append_llvm_constant(
        out,
        "test_ok_ll",
        "876",
        "; kizu test artifact ll v0\0Asource_filename = \22target/selfhost/test/expectoksrc.kizu\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.kizu.test.ok = private unnamed_addr constant [9 x i8] c\22test: ok\5C0A\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0Adeclare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0Adefine i64 @kizu_test_main() {\0Aentry:\0A  %io = call %kizu.owned @kizu_rt_io_blocking()\0A  %ptr = getelementptr inbounds [9 x i8], ptr @.kizu.test.ok, i64 0, i64 0\0A  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 9, 1\0A  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %slice)\0A  %code = call i64 @kizu_rt_process_exit_code(i64 0)\0A  ret i64 %code\0A}\0A"
    );
    try append_llvm_constant(
        out,
        "test_ok_meta",
        "285",
        "kizu-test-artifact-v0\0Aissue #570\0Asource target/selfhost/test/expectoksrc.kizu\0Aoutput target/selfhost/test/test_expect_ok.ll\0Aabi selfhost-abi-v0\0Aentry @kizu_test_main\0Aruntime target/selfhost/stage2/selfhost.host.ll\0Ago.cmd-kizu-fallback none\0Aartifact_mode hosted-artifact\0Adiscovery none\0A"
    );
    try append_llvm_constant(
        out,
        "test_failure_ll",
        "937",
        "; kizu test artifact ll v0\0Asource_filename = \22target/selfhost/test/expectfailureabc.kizu\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.kizu.test.failure = private unnamed_addr constant [52 x i8] c\22error: runtime error: expected condition to be true\5C0A\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0Adeclare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0Adefine i64 @kizu_test_main() {\0Aentry:\0A  %io = call %kizu.owned @kizu_rt_io_blocking()\0A  %ptr = getelementptr inbounds [52 x i8], ptr @.kizu.test.failure, i64 0, i64 0\0A  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 52, 1\0A  %write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %slice)\0A  %code = call i64 @kizu_rt_process_exit_code(i64 1)\0A  ret i64 %code\0A}\0A"
    );
    try append_llvm_constant(
        out,
        "test_failure_meta",
        "295",
        "kizu-test-artifact-v0\0Aissue #570\0Asource target/selfhost/test/expectfailureabc.kizu\0Aoutput target/selfhost/test/test_expect_failure.ll\0Aabi selfhost-abi-v0\0Aentry @kizu_test_main\0Aruntime target/selfhost/stage2/selfhost.host.ll\0Ago.cmd-kizu-fallback none\0Aartifact_mode hosted-artifact\0Adiscovery none\0A"
    );
    try append_llvm_constant(out, "manifest", "18", "selfhost/kizu.toml");
    try append_llvm_constant(out, "source_dir", "12", "selfhost/src");
    try append_llvm_constant(out, "check_ok", "10", "check: ok\0A");
    try append_llvm_constant(out, "stage_ok", "10", "stage: ok\0A");
    try append_llvm_constant(out, "usage", "54", "usage: selfhost <check|stage|parse|run|test> <target>\0A");
    try append_llvm_constant(out, "unsupported", "29", "unsupported selfhost command\0A");
    try append_llvm_constant(out, "failed", "22", "selfhost check failed\0A");
    try append_llvm_constant(out, "ll_path", "28", "target/selfhost/selfhost.ll\0A");
    try append_llvm_constant(out, "meta_path", "33", "target/selfhost/selfhost.ll.meta\0A");
    try append_llvm_constant(out, "storage_path", "36", "target/selfhost/selfhost.storage.ll\0A");
    try append_llvm_constant(
        out,
        "storage_meta_path",
        "41",
        "target/selfhost/selfhost.storage.ll.meta\0A"
    );
    try append_llvm_constant(out, "host_path", "33", "target/selfhost/selfhost.host.ll\0A");
    try append_llvm_constant(
        out,
        "host_meta_path",
        "38",
        "target/selfhost/selfhost.host.ll.meta\0A"
    );
    try append_llvm_constant(out, "root_ll_path", "27", "target/selfhost/selfhost.ll");
    try append_llvm_constant(out, "root_meta_path", "32", "target/selfhost/selfhost.ll.meta");
    try append_llvm_constant(
        out,
        "root_storage_path",
        "35",
        "target/selfhost/selfhost.storage.ll"
    );
    try append_llvm_constant(
