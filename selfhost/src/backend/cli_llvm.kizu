    let params_spec_bytes = params_spec.as_bytes();
    var llvm_symbol = std::string::String(std::mem::page_allocator());
    defer llvm_symbol.deinit();
    try compiled_signature::append_function_llvm_symbol(&var llvm_symbol, function_name);
    let llvm_symbol_bytes = llvm_symbol.as_bytes();
    try compiled_llvm::append_compiled_function_auto(
        out,
        ir_bytes,
        function_name,
        llvm_symbol_bytes,
        params_spec_bytes
    );
    return;
}

fn collect_lexer_compiled_callees(
    ir_bytes: []u8,
    local_name: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    let function_name = try lexer_compiled_qualified_name(local_name);
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    while sequence < count {
        let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
        if std::mem::equal_bytes(kind, "Call") {
            let callee = try ir_contract::body_call_callee_or_empty(
                ir_bytes,
                function_name,
                sequence
            );
            try collect_lexer_compiled_callee(callee, pending);
        }
        sequence = sequence + 1;
    }
    return;
}

fn collect_lexer_compiled_callee(
    callee: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    if std::mem::starts_with(callee, "std::mem::") {
        return;
    }
    if std::mem::starts_with(callee, "selfhost::lexer::") {
        let prefix = "selfhost::lexer::";
        let local = callee[std::mem::len(prefix)..std::mem::len(callee)];
        if !lexer_compiled_supported_local(local) {
            return error("lexer compiled closure: unsupported local helper");
        }
        try pending.append(local);
        return;
    }
    if std::mem::starts_with(callee, "selfhost::") {
        return error("lexer compiled closure: unsupported selfhost callee");
    }
    if lexer_compiled_supported_local(callee) {
        try pending.append(callee);
        return;
    }
    return error("lexer compiled closure: unsupported callee");
}

fn lexer_compiled_supported_local(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "is_digit") or
        std::mem::equal_bytes(name, "is_alpha") or
        std::mem::equal_bytes(name, "is_identifier_start") or
        std::mem::equal_bytes(name, "is_identifier_continue") or
        std::mem::equal_bytes(name, "invalid_token_display");
}

fn lexer_compiled_qualified_name(local_name: []u8) -> ![]u8 {
    if std::mem::equal_bytes(local_name, "is_digit") {
        return "selfhost::lexer::is_digit";
    }
    if std::mem::equal_bytes(local_name, "is_alpha") {
        return "selfhost::lexer::is_alpha";
    }
    if std::mem::equal_bytes(local_name, "is_identifier_start") {
        return "selfhost::lexer::is_identifier_start";
    }
    if std::mem::equal_bytes(local_name, "is_identifier_continue") {
        return "selfhost::lexer::is_identifier_continue";
    }
    if std::mem::equal_bytes(local_name, "invalid_token_display") {
        return "selfhost::lexer::invalid_token_display";
    }
    return error("lexer compiled closure: unsupported local helper");
}

fn append_loader_reachable_compiled_functions(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    var emitted = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("package_module_end");
    try pending.append("is_manifest_root_source");
    try pending.append("package_module_start");
