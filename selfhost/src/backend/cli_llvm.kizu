fn ast_data_tag(ir_bytes: []u8, name: []u8) -> !i64 {
    let variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", name
    );
    if !variant.found {
        return error("missing AstData variant fact");
    }
    return variant.tag;
}

fn append_empty_text_return(out: &var std::string::String, value_name: []u8) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ptr = extractvalue %kizu.slice.u8 %text, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes(" = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(value_name);
    try out.append_bytes("_base, i64 0, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.slice.u8 %");
    try out.append_bytes(value_name);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_payload_span_success_return(out: &var std::string::String, value_name: []u8) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok0 = insertvalue %kizu.error.payload_span poison, i1 true, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok1 = insertvalue %kizu.error.payload_span %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok0, %kizu.selfhost.codegen.payload_span %");
    try out.append_bytes(value_name);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok2 = insertvalue %kizu.error.payload_span %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok1, %kizu.slice.u8 zeroinitializer, 2");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.error.payload_span %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok2");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_empty_payload_span_success_return(out: &var std::string::String, value_name: []u8) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes(" = call %kizu.selfhost.codegen.payload_span @kizu_selfhost__ir_codegen_empty_payload_span()");
    try out.append_byte(cast<u8>(10));
    try append_payload_span_success_return(out, value_name);
    return;
}

fn append_payload_span_child_fail_return(out: &var std::string::String, result_name: []u8) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes("_err = extractvalue %kizu.error.node_id %");
    try out.append_bytes(result_name);
    try out.append_bytes(", 2");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes("_fail0 = insertvalue %kizu.error.payload_span poison, i1 false, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes("_fail1 = insertvalue %kizu.error.payload_span %");
    try out.append_bytes(result_name);
    try out.append_bytes("_fail0, %kizu.selfhost.codegen.payload_span zeroinitializer, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes("_fail2 = insertvalue %kizu.error.payload_span %");
    try out.append_bytes(result_name);
    try out.append_bytes("_fail1, %kizu.slice.u8 %");
    try out.append_bytes(result_name);
    try out.append_bytes("_err, 2");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.error.payload_span %");
    try out.append_bytes(result_name);
    try out.append_bytes("_fail2");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_i64_literal_success_return(
    out: &var std::string::String,
    value_name: []u8,
    value: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok1 = insertvalue %kizu.error.i64 %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok0, i64 ");
    try std::fmt::append_i64(out, value);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok2 = insertvalue %kizu.error.i64 %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok1, %kizu.slice.u8 zeroinitializer, 2");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.error.i64 %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok2");
    try out.append_byte(cast<u8>(10));
    return;
}

