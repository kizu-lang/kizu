fn append_loop_print_call_ok_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.bool @kizu_selfhost__ir_codegen_loop_print_call_ok(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %callee,");
    try append_line(out, "  %kizu.kizu.ast.child_range %args,");
    try append_line(out, "  %kizu.slice.u8 %local_name");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %callee_text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee)");
    try append_line(out,
        "  %print_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.run_print, i64 0, i64 0");
    try append_line(out, "  %print_base = insertvalue %kizu.slice.u8 poison, ptr %print_ptr, 0");
    try append_line(out, "  %print_slice = insertvalue %kizu.slice.u8 %print_base, i64 5, 1");
    try append_line(out,
        "  %callee_ok = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %callee_text, %kizu.slice.u8 %print_slice)");
    try append_line(out, "  br i1 %callee_ok, label %check_arity, label %false_value");
    try append_line(out, "check_arity:");
    try append_line(out, "  %arg_len = extractvalue %kizu.kizu.ast.child_range %args, 1");
    try append_line(out, "  %one_arg = icmp eq i64 %arg_len, 1");
    try append_line(out, "  br i1 %one_arg, label %read_arg, label %false_value");
    try append_line(out, "read_arg:");
    try append_line(out,
        "  %arg_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %args, i64 0)");
    try append_line(out, "  %arg_ok = extractvalue %kizu.error.node_id %arg_result, 0");
    try append_line(out, "  br i1 %arg_ok, label %check_arg, label %arg_failed");
    try append_line(out, "check_arg:");
    try append_line(out, "  %arg = extractvalue %kizu.error.node_id %arg_result, 1");
    try append_line(out,
        "  %arg_is_local = call i1 @kizu_selfhost__ir_codegen_node_text_is_var(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %arg, %kizu.slice.u8 %local_name)");
    try append_line(out, "  %success0 = insertvalue %kizu.error.bool poison, i1 true, 0");
    try append_line(out, "  %success1 = insertvalue %kizu.error.bool %success0, i1 %arg_is_local, 1");
    try append_line(out, "  %success2 = insertvalue %kizu.error.bool %success1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.bool %success2");
    try append_line(out, "false_value:");
    try append_line(out, "  %false0 = insertvalue %kizu.error.bool poison, i1 true, 0");
    try append_line(out, "  %false1 = insertvalue %kizu.error.bool %false0, i1 false, 1");
    try append_line(out, "  %false2 = insertvalue %kizu.error.bool %false1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.bool %false2");
    try append_line(out, "arg_failed:");
    try append_line(out, "  %err = extractvalue %kizu.error.node_id %arg_result, 2");
    try append_line(out, "  %fail0 = insertvalue %kizu.error.bool poison, i1 false, 0");
    try append_line(out, "  %fail1 = insertvalue %kizu.error.bool %fail0, i1 false, 1");
    try append_line(out, "  %fail2 = insertvalue %kizu.error.bool %fail1, %kizu.slice.u8 %err, 2");
    try append_line(out, "  ret %kizu.error.bool %fail2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

