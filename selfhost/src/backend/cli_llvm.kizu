    try append_line(out, "  %block_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %block_slot, i32 0, i32 1");
    try append_line(out, "  %block_node_payload = load %kizu.kizu.ast.block_node, ptr %block_payload_ptr, align 8");
    try append_line(out, "  %statements = extractvalue %kizu.kizu.ast.block_node %block_node_payload, 0");
    try append_line(out, "  %result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_try_void_helper_block_exit_code(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements)");
    try append_line(out, "  ret %kizu.error.i64 %result");
    try append_line(out, "unsupported:");
    try append_i64_literal_success_return(out, "unsupported_helper_decl", -1);
    try append_line(out, "}");
    try append_line(out, "");

    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_try_void_helper_function_exit_code(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %declaration,");
    try append_line(out, "  %kizu.slice.u8 %callee");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %declaration)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_fn = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, fn_decl_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_fn, label %fn_payload, label %unsupported");
    try append_line(out, "fn_payload:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.fn_decl_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %name = extractvalue %kizu.kizu.ast.fn_decl_node %payload, 3");
    try append_line(out, "  %params = extractvalue %kizu.kizu.ast.fn_decl_node %payload, 5");
    try append_line(out, "  %return_type = extractvalue %kizu.kizu.ast.fn_decl_node %payload, 6");
    try append_line(out, "  %body = extractvalue %kizu.kizu.ast.fn_decl_node %payload, 8");
    try append_line(out, "  %result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_try_void_helper_decl_exit_code(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %callee, %kizu.kizu.ast.node_id %name, %kizu.kizu.ast.child_range %params, %kizu.kizu.ast.node_id %return_type, %kizu.kizu.ast.node_id %body)");
    try append_line(out, "  ret %kizu.error.i64 %result");
    try append_line(out, "unsupported:");
    try append_i64_literal_success_return(out, "unsupported_helper_function", -1);
    try append_line(out, "}");
    try append_line(out, "");

    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_try_void_helper_exit_code(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.child_range %declarations,");
    try append_line(out, "  %kizu.slice.u8 %callee");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %declaration_len = extractvalue %kizu.kizu.ast.child_range %declarations, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %continue ]");
    try append_line(out, "  %done = icmp eq i64 %index, %declaration_len");
    try append_line(out, "  br i1 %done, label %unsupported, label %load_child");
    try append_line(out, "load_child:");
    try append_line(out, "  %child_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %declarations, i64 %index)");
    try append_line(out, "  %child_ok = extractvalue %kizu.error.node_id %child_result, 0");
    try append_line(out, "  br i1 %child_ok, label %child_bound, label %child_fail");
    try append_line(out, "child_bound:");
    try append_line(out, "  %child = extractvalue %kizu.error.node_id %child_result, 1");
    try append_line(out, "  %result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_try_void_helper_function_exit_code(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %child, %kizu.slice.u8 %callee)");
    try append_line(out, "  %result_ok = extractvalue %kizu.error.i64 %result, 0");
    try append_line(out, "  br i1 %result_ok, label %check_code, label %return_result");
    try append_line(out, "check_code:");
    try append_line(out, "  %exit_code = extractvalue %kizu.error.i64 %result, 1");
    try append_line(out, "  %supported = icmp sge i64 %exit_code, 0");
    try append_line(out, "  br i1 %supported, label %return_result, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "return_result:");
    try append_line(out, "  ret %kizu.error.i64 %result");
    try append_line(out, "child_fail:");
    try append_i64_child_fail_return(out, "child_result");
    try append_line(out, "unsupported:");
    try append_i64_literal_success_return(out, "unsupported_helper_exit", -1);
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_run_ast_success_return(out: &var std::string::String, value_name: []u8) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok0 = insertvalue %kizu.error.run_ast poison, i1 true, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok1 = insertvalue %kizu.error.run_ast %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok0, %kizu.selfhost.codegen.run_ast %");
    try out.append_bytes(value_name);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok2 = insertvalue %kizu.error.run_ast %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok1, %kizu.slice.u8 zeroinitializer, 2");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.error.run_ast %");
    try out.append_bytes(value_name);
    try out.append_bytes("_ok2");
    try out.append_byte(cast<u8>(10));
    return;
}

