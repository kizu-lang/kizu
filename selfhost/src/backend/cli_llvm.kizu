fn collect_loader_compiled_callee(
    callee: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    if std::mem::starts_with(callee, "std::mem::") {
        return;
    }
    if std::mem::starts_with(callee, "selfhost::source::loader::") {
        let prefix = "selfhost::source::loader::";
        let local = callee[std::mem::len(prefix)..std::mem::len(callee)];
        if !loader_compiled_supported_local(local) {
            return error("loader compiled closure: unsupported local helper");
        }
        try pending.append(local);
