fn append_loop_if_value_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let eq_op = try ir_contract::enum_variant_tag(
        ir_bytes, "std::kizu::ast::BinaryOp", "Eq"
    );
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_if_value(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %condition,");
    try append_line(out, "  %kizu.kizu.ast.node_id %then_block,");
    try append_line(out, "  %kizu.kizu.ast.node_id %else_block,");
    try append_line(out, "  %kizu.slice.u8 %local_name,");
    try append_line(out, "  i1 %want_continue");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %else_empty = call i1 @kizu_selfhost__ir_codegen_is_empty_node(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %else_block)");
    try append_line(out, "  br i1 %else_empty, label %check_then, label %unsupported");
    try append_line(out, "check_then:");
    try append_line(out,
        "  %then_result = call %kizu.error.bool @kizu_selfhost__ir_codegen_loop_then_terminal_ok(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %then_block, i1 %want_continue)");
    try append_line(out, "  %then_ok = extractvalue %kizu.error.bool %then_result, 0");
    try append_line(out, "  br i1 %then_ok, label %check_then_value, label %then_failed");
    try append_line(out, "check_then_value:");
    try append_line(out, "  %then_value = extractvalue %kizu.error.bool %then_result, 1");
    try append_line(out, "  br i1 %then_value, label %condition_value, label %unsupported");
    try append_line(out, "condition_value:");
    try out.append_bytes("  %condition_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_var_int_binary(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %condition, %kizu.slice.u8 %local_name, i64 ");
    try std::fmt::append_i64(out, eq_op);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret %kizu.error.i64 %condition_result");
    try append_line(out, "unsupported:");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 -1, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "then_failed:");
    try append_line(out, "  %then_err = extractvalue %kizu.error.bool %then_result, 2");
    try append_line(out, "  %fail0 = insertvalue %kizu.error.i64 poison, i1 false, 0");
    try append_line(out, "  %fail1 = insertvalue %kizu.error.i64 %fail0, i64 0, 1");
    try append_line(out, "  %fail2 = insertvalue %kizu.error.i64 %fail1, %kizu.slice.u8 %then_err, 2");
    try append_line(out, "  ret %kizu.error.i64 %fail2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

