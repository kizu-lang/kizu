    try append_line(out,
        "  %left_ok = call i1 @kizu_selfhost__ir_codegen_node_text_is_var(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %left, %kizu.slice.u8 %local_name)");
