        "kizu_selfhost__ir_codegen_lowered_program_supported",
        "%kizu.selfhost.codegen.program program"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::metadata_for_program",
        "kizu_selfhost__ir_codegen_metadata_for_program",
        "%kizu.selfhost.codegen.program program"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::is_digit",
        "kizu_selfhost__lexer_is_digit",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::is_alpha",
        "kizu_selfhost__lexer_is_alpha",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::is_identifier_start",
        "kizu_selfhost__lexer_is_identifier_start",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::is_identifier_continue",
        "kizu_selfhost__lexer_is_identifier_continue",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::invalid_token_display",
        "kizu_selfhost__lexer_invalid_token_display",
        ""
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::backend::hosted::hosted_output_len",
        "kizu_selfhost__hosted_output_len",
        "%kizu.slice.u8 output_payload;i1 append_newline"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::source::loader::module_end_for",
        "kizu_selfhost__source_loader_module_end_for",
        "%kizu.slice.u8 path"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::source::loader::package_module_end",
        "kizu_selfhost__source_loader_package_module_end",
        "%kizu.slice.u8 path;i64 start"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::source::loader::is_manifest_root_source",
        "kizu_selfhost__source_loader_is_manifest_root_source",
        "%kizu.slice.u8 module_root;%kizu.slice.u8 path"
    );
    try append_cli_main_function(out, ir_bytes);
    return;
}

fn append_slice_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_equal(");
    try append_line(out, "  %kizu.slice.u8 %left,");
    try append_line(out, "  %kizu.slice.u8 %right");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %left_len = extractvalue %kizu.slice.u8 %left, 1");
    try append_line(out, "  %right_len = extractvalue %kizu.slice.u8 %right, 1");
    try append_line(out, "  %same_len = icmp eq i64 %left_len, %right_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %left_len");
    try append_line(out, "  br i1 %done, label %true, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %left_ptr = extractvalue %kizu.slice.u8 %left, 0");
    try append_line(out, "  %right_ptr = extractvalue %kizu.slice.u8 %right, 0");
    try append_line(out, "  %left_at = getelementptr i8, ptr %left_ptr, i64 %index");
    try append_line(out, "  %right_at = getelementptr i8, ptr %right_ptr, i64 %index");
    try append_line(out, "  %left_byte = load i8, ptr %left_at");
    try append_line(out, "  %right_byte = load i8, ptr %right_at");
    try append_line(out, "  %same_byte = icmp eq i8 %left_byte, %right_byte");
    try append_line(out, "  br i1 %same_byte, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_len_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__slice_len(");
    try append_line(out, "  %kizu.slice.u8 %slice");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %slice, 1");
    try append_line(out, "  ret i64 %len");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_starts_with_dash_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_starts_with_dash(");
    try append_line(out, "  %kizu.slice.u8 %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %value, 1");
    try append_line(out, "  %has_byte = icmp sgt i64 %len, 0");
    try append_line(out, "  br i1 %has_byte, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %value, 0");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_dash = icmp eq i8 %byte, 45");
    try append_line(out, "  ret i1 %is_dash");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_concat3_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__write_concat3(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %prefix,");
    try append_line(out, "  %kizu.slice.u8 %middle,");
    try append_line(out, "  %kizu.slice.u8 %suffix");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %prefix_ptr = extractvalue %kizu.slice.u8 %prefix, 0");
    try append_line(out, "  %prefix_len = extractvalue %kizu.slice.u8 %prefix, 1");
    try append_line(out, "  %middle_ptr = extractvalue %kizu.slice.u8 %middle, 0");
    try append_line(out, "  %middle_len = extractvalue %kizu.slice.u8 %middle, 1");
    try append_line(out, "  %suffix_ptr = extractvalue %kizu.slice.u8 %suffix, 0");
    try append_line(out, "  %suffix_len = extractvalue %kizu.slice.u8 %suffix, 1");
    try append_line(out, "  %prefix_middle_len = add i64 %prefix_len, %middle_len");
    try append_line(out, "  %total_len = add i64 %prefix_middle_len, %suffix_len");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %total_len)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %copy_prefix, label %alloc_failed");
    try append_line(out, "copy_prefix:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %buffer, ptr %prefix_ptr, i64 %prefix_len, i1 false)");
    try append_line(out, "  %middle_dest = getelementptr i8, ptr %buffer, i64 %prefix_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %middle_dest, ptr %middle_ptr, i64 %middle_len, i1 false)");
    try append_line(out,
        "  %suffix_dest = getelementptr i8, ptr %buffer, i64 %prefix_middle_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %suffix_dest, ptr %suffix_ptr, i64 %suffix_len, i1 false)");
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %total_len, 1");
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned %io, %kizu.slice.u8 %path, %kizu.slice.u8 %body)");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %buffer)");
    try append_line(out, "  ret %kizu.error.void %write");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_cli_main_header(out);
    try append_cli_main_dispatch(out);
    try append_cli_corpus_blocks(out);
    try cli_test_llvm::append_cli_test_blocks(out, ir_bytes);
    try cli_run_llvm::append_cli_run_blocks(out, ir_bytes);
    try cli_parse_llvm::append_cli_parse_blocks(out);
    try cli_parse_llvm::append_cli_fmt_blocks(out);
    try cli_parse_llvm::append_cli_fmt_write_blocks(out);
    try append_cli_check_blocks(out);
    try append_cli_stage_blocks(out);
    try append_cli_error_blocks(out);
    try append_line(out, "}");
    return;
}

fn append_cli_main_header(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %argc = call i64 @kizu_rt_process_arg_count()");
    try append_line(out, "  %argc_is_two = icmp eq i64 %argc, 2");
    try append_line(out, "  %argc_is_three = icmp eq i64 %argc, 3");
    try append_line(out, "  %argc_ok = or i1 %argc_is_two, %argc_is_three");
    try append_line(out, "  br i1 %argc_ok, label %load_command, label %usage");
    try append_line(out, "load_command:");
    try append_line(out, "  %command_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 0)");
    try append_line(out, "  %command_ok = extractvalue %kizu.error.slice.u8 %command_result, 0");
    try append_line(out, "  br i1 %command_ok, label %route_args, label %check_failed");
    try append_line(out, "route_args:");
    try append_line(out, "  br i1 %argc_is_three, label %load_fmt_write_flag, label %load_target");
    try append_line(out, "load_fmt_write_flag:");
    try append_line(out,
        "  %fmt_write_flag_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out,
        "  %fmt_write_flag_ok = extractvalue %kizu.error.slice.u8 %fmt_write_flag_result, 0");
    try append_line(out,
        "  br i1 %fmt_write_flag_ok, label %load_fmt_write_target, label %check_failed");
    try append_line(out, "load_fmt_write_target:");
    try append_line(out,
        "  %fmt_write_target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 2)");
    try append_line(out,
        "  %fmt_write_target_ok = extractvalue %kizu.error.slice.u8 %fmt_write_target_result, 0");
    try append_line(out,
        "  br i1 %fmt_write_target_ok, label %dispatch_fmt_write_arg, label %check_failed");
    try append_line(out, "load_target:");
    try append_line(out, "  %target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out, "  %target_ok = extractvalue %kizu.error.slice.u8 %target_result, 0");
    try append_line(out, "  br i1 %target_ok, label %dispatch, label %check_failed");
    return;
}

fn append_cli_main_dispatch(out: &var std::string::String) -> !void {
    try append_cli_fmt_write_arg_dispatch(out);
    try append_line(out, "dispatch:");
    try append_line(out, "  %command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out, "  %target = extractvalue %kizu.error.slice.u8 %target_result, 1");
    try append_line(out,
        "  %command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %command)");
    try append_line(out, "  br i1 %command_is_flag, label %usage, label %check_target_flag");
    try append_line(out, "check_target_flag:");
    try append_line(out,
        "  %target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %target)");
    try append_line(out, "  br i1 %target_is_flag, label %usage, label %maybe_test");
    try append_line(out, "maybe_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.test, i64 0, i64 0");
    try append_line(out, "  %test_base = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test_base, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %dispatch_test, label %maybe_run");
    try append_line(out, "maybe_run:");
    try append_line(out,
        "  %run_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.run, i64 0, i64 0");
    try append_line(out, "  %run_base = insertvalue %kizu.slice.u8 poison, ptr %run_ptr, 0");
    try append_line(out, "  %run_slice = insertvalue %kizu.slice.u8 %run_base, i64 3, 1");
    try append_line(out,
        "  %is_run = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %run_slice)");
    try append_line(out, "  br i1 %is_run, label %dispatch_run, label %maybe_parse");
    try append_line(out, "maybe_parse:");
    try append_line(out,
        "  %parse_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.parse, i64 0, i64 0");
    try append_line(out, "  %parse_base = insertvalue %kizu.slice.u8 poison, ptr %parse_ptr, 0");
    try append_line(out, "  %parse_slice = insertvalue %kizu.slice.u8 %parse_base, i64 5, 1");
    try append_line(out,
        "  %is_parse = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %parse_slice)");
    try append_line(out, "  br i1 %is_parse, label %dispatch_parse, label %maybe_fmt");
    try append_line(out, "maybe_fmt:");
    try append_line(out,
        "  %fmt_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.fmt, i64 0, i64 0");
    try append_line(out, "  %fmt_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_ptr, 0");
    try append_line(out, "  %fmt_slice = insertvalue %kizu.slice.u8 %fmt_base, i64 3, 1");
    try append_line(out,
        "  %is_fmt = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %fmt_slice)");
    try append_line(out, "  br i1 %is_fmt, label %dispatch_fmt, label %match_selfhost");
    try append_line(out, "match_selfhost:");
    try append_line(out,
        "  %selfhost_ptr = getelementptr inbounds [8 x i8], ptr @.kizu.cli.selfhost, i64 0, i64 0");
    try append_line(out, "  %selfhost_base = insertvalue %kizu.slice.u8 poison, ptr %selfhost_ptr, 0");
    try append_line(out, "  %selfhost_slice = insertvalue %kizu.slice.u8 %selfhost_base, i64 8, 1");
    try append_line(out,
        "  %target_matches = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %selfhost_slice)");
    try append_line(out, "  br i1 %target_matches, label %dispatch_command, label %dispatch_corpus");
    try append_line(out, "dispatch_command:");
    try append_line(out,
        "  %check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out, "  %check_base = insertvalue %kizu.slice.u8 poison, ptr %check_ptr, 0");
    try append_line(out, "  %check_slice = insertvalue %kizu.slice.u8 %check_base, i64 5, 1");
    try append_line(out,
        "  %is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %check_slice)");
    try append_line(out, "  br i1 %is_check, label %run_check, label %maybe_stage");
    try append_line(out, "maybe_stage:");
    try append_line(out,
        "  %stage_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.stage, i64 0, i64 0");
    try append_line(out, "  %stage_base = insertvalue %kizu.slice.u8 poison, ptr %stage_ptr, 0");
    try append_line(out, "  %stage_slice = insertvalue %kizu.slice.u8 %stage_base, i64 5, 1");
    try append_line(out,
        "  %is_stage = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %stage_slice)");
    try append_line(out, "  br i1 %is_stage, label %run_stage, label %unsupported");
    return;
}

fn append_cli_fmt_write_arg_dispatch(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_fmt_write_arg:");
    try append_line(out,
        "  %fmt_write_command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out,
        "  %fmt_write_flag = extractvalue %kizu.error.slice.u8 %fmt_write_flag_result, 1");
    try append_line(out,
        "  %fmt_write_target = extractvalue %kizu.error.slice.u8 %fmt_write_target_result, 1");
    try append_line(out,
        "  %fmt_write_command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %fmt_write_command)");
    try append_line(out,
        "  br i1 %fmt_write_command_is_flag, label %usage, label %check_fmt_write_target_flag");
    try append_line(out, "check_fmt_write_target_flag:");
    try append_line(out,
        "  %fmt_write_target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %fmt_write_target)");
    try append_line(out,
        "  br i1 %fmt_write_target_is_flag, label %usage, label %match_fmt_write_command");
    try append_line(out, "match_fmt_write_command:");
    try append_line(out,
        "  %fmt_write_command_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.fmt, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_command_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_command_ptr, 0");
    try append_line(out,
        "  %fmt_write_command_slice = insertvalue %kizu.slice.u8 %fmt_write_command_base, i64 3, 1");
    try append_line(out,
        "  %fmt_write_is_fmt = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_command, %kizu.slice.u8 %fmt_write_command_slice)");
    try append_line(out,
        "  br i1 %fmt_write_is_fmt, label %match_fmt_write_flag, label %usage");
    try append_line(out, "match_fmt_write_flag:");
    try append_line(out,
        "  %fmt_write_flag_ptr = getelementptr inbounds [7 x i8], ptr @.kizu.cli.fmt_write, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_flag_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_flag_ptr, 0");
    try append_line(out,
        "  %fmt_write_flag_slice = insertvalue %kizu.slice.u8 %fmt_write_flag_base, i64 7, 1");
    try append_line(out,
        "  %fmt_write_is_long = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_flag, %kizu.slice.u8 %fmt_write_flag_slice)");
    try append_line(out,
        "  %fmt_write_short_ptr = getelementptr inbounds [2 x i8], ptr @.kizu.cli.fmt_write_short, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_short_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_short_ptr, 0");
    try append_line(out,
        "  %fmt_write_short_slice = insertvalue %kizu.slice.u8 %fmt_write_short_base, i64 2, 1");
    try append_line(out,
        "  %fmt_write_is_short = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_flag, %kizu.slice.u8 %fmt_write_short_slice)");
    try append_line(out, "  %fmt_write_flag_matches = or i1 %fmt_write_is_long, %fmt_write_is_short");
    try append_line(out,
        "  br i1 %fmt_write_flag_matches, label %dispatch_fmt_write, label %usage");
    return;
}

fn append_cli_corpus_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_corpus:");
    try append_line(out,
        "  %corpus_check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out,
        "  %corpus_check_base = insertvalue %kizu.slice.u8 poison, ptr %corpus_check_ptr, 0");
    try append_line(out,
        "  %corpus_check_slice = insertvalue %kizu.slice.u8 %corpus_check_base, i64 5, 1");
    try append_line(out,
        "  %corpus_is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %corpus_check_slice)");
    try append_line(out, "  br i1 %corpus_is_check, label %read_check_corpus_source, label %usage");
    try append_line(out, "read_check_corpus_source:");
    try append_line(out, "  %corpus_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %corpus_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %corpus_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %corpus_file_ok = extractvalue %kizu.error.slice.u8 %corpus_file, 0");
    try append_line(out, "  br i1 %corpus_file_ok, label %match_corpus_source, label %usage");
    try append_line(out, "match_corpus_source:");
    try append_line(out, "  %corpus_bytes = extractvalue %kizu.error.slice.u8 %corpus_file, 1");
    try cli_check_gate_llvm::append_static_check_gate(
        out,
        "check_file",
        "check",
        "corpus_io",
        "corpus_bytes",
        "check_file_ok"
    );
    try append_line(out, "check_file_ok:");
    try append_line(out,
        "  %check_file_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out,
        "  %check_file_ok_base = insertvalue %kizu.slice.u8 poison, ptr %check_file_ok_ptr, 0");
    try append_line(out,
        "  %check_file_ok_slice = insertvalue %kizu.slice.u8 %check_file_ok_base, i64 10, 1");
    try append_line(out,
        "  %check_file_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %corpus_io, %kizu.slice.u8 %check_file_ok_slice)");
    try append_line(out, "  %check_file_write_ok = extractvalue %kizu.error.void %check_file_write, 0");
    try append_line(out, "  br i1 %check_file_write_ok, label %exit_zero, label %check_failed");
    try append_line(out, "exit_one:");
    try append_line(out, "  %one_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %one_code");
    return;
}

fn append_cli_check_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "run_check:");
    try append_line(out, "  %check_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %manifest_ptr = getelementptr inbounds [18 x i8], ptr @.kizu.cli.manifest, i64 0, i64 0");
    try append_line(out, "  %manifest_base = insertvalue %kizu.slice.u8 poison, ptr %manifest_ptr, 0");
    try append_line(out, "  %manifest_slice = insertvalue %kizu.slice.u8 %manifest_base, i64 18, 1");
    try append_line(out,
        "  %manifest = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %check_io, %kizu.slice.u8 %manifest_slice)");
    try append_line(out, "  %manifest_ok = extractvalue %kizu.error.slice.u8 %manifest, 0");
    try append_line(out, "  br i1 %manifest_ok, label %read_sources, label %check_failed");
    try append_line(out, "read_sources:");
    try append_line(out,
        "  %source_ptr = getelementptr inbounds [12 x i8], ptr @.kizu.cli.source_dir, i64 0, i64 0");
    try append_line(out, "  %source_base = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out, "  %source_slice = insertvalue %kizu.slice.u8 %source_base, i64 12, 1");
    try append_line(out,
        "  %sources = call %kizu.error.owned @kizu_rt_fs_read_dir(%kizu.owned %check_io, %kizu.slice.u8 %source_slice)");
    try append_line(out, "  %sources_ok = extractvalue %kizu.error.owned %sources, 0");
    try append_line(out, "  br i1 %sources_ok, label %check_ok, label %check_failed");
    try append_line(out, "check_ok:");
    try append_line(out,
        "  %check_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out, "  %check_ok_base = insertvalue %kizu.slice.u8 poison, ptr %check_ok_ptr, 0");
    try append_line(out, "  %check_ok_slice = insertvalue %kizu.slice.u8 %check_ok_base, i64 10, 1");
    try append_line(out,
        "  %check_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %check_io, %kizu.slice.u8 %check_ok_slice)");
    try append_line(out, "  %check_write_ok = extractvalue %kizu.error.void %check_write, 0");
    try append_line(out, "  br i1 %check_write_ok, label %exit_zero, label %check_failed");
    try append_line(out, "exit_zero:");
    try append_line(out, "  %zero_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %zero_code");
    return;
}

fn append_cli_stage_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "run_stage:");
    try append_line(out, "  %stage_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_stage_copy(out, "ll", "root_ll_path", "27", "stage2_ll_path", "34");
    try append_stage_copy(out, "meta", "root_meta_path", "32", "stage2_meta_path", "39");
    try append_stage_copy(
        out,
        "storage",
        "root_storage_path",
        "35",
        "stage2_storage_path",
        "42"
    );
    try append_stage_copy(
        out,
        "storage_meta",
        "root_storage_meta_path",
        "40",
        "stage2_storage_meta_path",
        "47"
    );
    try append_stage_copy(out, "host", "root_host_path", "32", "stage2_host_path", "39");
    try append_stage_copy(
        out,
        "host_meta",
        "root_host_meta_path",
        "37",
        "stage2_host_meta_path",
        "44"
    );
    try append_stage_write(out, "stage_ok", "stage_ok", "10");
    try append_stage_write(out, "ll", "ll_path", "28");
    try append_stage_write(out, "meta", "meta_path", "33");
    try append_stage_write(out, "storage", "storage_path", "36");
    try append_stage_write(out, "storage_meta", "storage_meta_path", "41");
    try append_stage_write(out, "host", "host_path", "33");
    try append_stage_write(out, "host_meta", "host_meta_path", "38");
    try append_line(out, "  %stage_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %stage_code");
    return;
}

fn append_stage_copy(
    out: &var std::string::String,
    name: []u8,
    source: []u8,
    source_size: []u8,
    target: []u8,
    target_size: []u8
) -> !void {
    try append_global_slice(out, name, "source", source, source_size);
    try append_global_slice(out, name, "target", target, target_size);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_read = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_source_slice)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_bytes = extractvalue %kizu.error.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_read, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_copy = call %kizu.error.void @kizu_rt_fs_write_file(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_target_slice, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_bytes)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    name: []u8,
    role: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_stage_write(
    out: &var std::string::String,
    name: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_write = call %kizu.error.void @kizu_rt_io_write_stdout(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_slice)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_error_blocks(out: &var std::string::String) -> !void {
    try append_cli_error_block(out, "usage", "usage", "58");
    try append_cli_error_block(out, "run_unsupported", "unsupported_run_codegen", "32");
    try append_cli_error_block(out, "unsupported", "unsupported", "29");
    try append_cli_error_block(out, "check_failed", "failed", "22");
    return;
}

fn append_cli_error_block(
    out: &var std::string::String,
    label: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes(label);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(label);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(label);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_write = call %kizu.error.void @kizu_rt_io_write_stderr(");
    try out.append_bytes("%kizu.owned %");
    try out.append_bytes(label);
    try out.append_bytes("_io, %kizu.slice.u8 %");
    try out.append_bytes(label);
    try out.append_bytes("_slice)");
    try out.append_byte(cast<u8>(10));
    if std::mem::equal_bytes(label, "check_failed") {
        try out.append_bytes("  %");
        try out.append_bytes(label);
        try out.append_bytes("_code = call i64 @kizu_rt_process_exit_code(i64 1)");
        try out.append_byte(cast<u8>(10));
    } else {
        try out.append_bytes("  %");
        try out.append_bytes(label);
        try out.append_bytes("_code = call i64 @kizu_rt_process_exit_code(i64 64)");
        try out.append_byte(cast<u8>(10));
    }
    try out.append_bytes("  ret i64 %");
    try out.append_bytes(label);
    try out.append_bytes("_code");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
