import selfhost::backend::compiled_fact_lookup;
import selfhost::backend::compiled_llvm;
import selfhost::backend::compiled_signature;
import selfhost::backend::ir_contract;

pub fn append_globals(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_llvm_constant(out, "check", "5", "check");
    try append_llvm_constant(out, "stage", "5", "stage");
    try append_llvm_constant(out, "parse", "5", "parse");
    try append_llvm_constant(out, "run", "3", "run");
    try append_llvm_constant(out, "run_main", "4", "main");
    try append_llvm_constant(out, "run_entry", "5", "entry");
    try append_llvm_constant(out, "run_print", "5", "print");
    try append_llvm_constant(out, "std_io_blocking", "17", "std::io::blocking");
    try append_llvm_constant(out, "std_fs_read_file", "18", "std::fs::read_file");
    try append_llvm_constant(out, "error_union_void_type", "5", "!void");
    try append_llvm_constant(out, "error_call", "5", "error");
    try append_llvm_constant(out, "stdout_payload_error", "34", "unsupported codegen stdout payload");
    try append_llvm_constant(out, "test", "4", "test");
    try append_llvm_constant(out, "fmt", "3", "fmt");
    try append_llvm_constant(out, "fmt_write", "7", "--write");
    try append_llvm_constant(out, "fmt_write_short", "2", "-w");
    try append_llvm_constant(out, "selfhost", "8", "selfhost");
    try cli_artifact_dir_llvm::append_globals(out);
    try cli_ast_boundary_llvm::append_globals(out);
    try cli_codegen_llvm::append_globals(out, ir_bytes);
    try cli_hosted_renderer_llvm::append_globals(out);
    try cli_parse_llvm::append_globals(out);
    try cli_run_llvm::append_globals(out, ir_bytes);
    try cli_run_i64_codegen_llvm::append_globals(out);
    try cli_test_ast_llvm::append_globals(out);
    try cli_test_llvm::append_globals(out, ir_bytes);
    try cli_hosted_metadata_llvm::append_output_prefix_constant(
        out,
        "artifact_output_prefix"
    );
    try append_llvm_constant(out, "manifest", "18", "selfhost/kizu.toml");
    try append_llvm_constant(out, "source_dir", "12", "selfhost/src");
    try append_llvm_constant(out, "check_ok", "10", "check: ok\0A");
    try append_llvm_constant(out, "move_prefix", "32", "error: move error: moved value `");
    try append_llvm_constant(out, "move_suffix", "10", "` was used");
    try append_llvm_constant(out, "stage_ok", "10", "stage: ok\0A");
    try append_llvm_constant(out, "usage", "58", "usage: selfhost <check|stage|parse|run|test|fmt> <target>\0A");
    try append_llvm_constant(out, "unsupported_run_codegen", "32", "unsupported run codegen program\0A");
    try append_llvm_constant(out, "unsupported", "29", "unsupported selfhost command\0A");
    try append_llvm_constant(out, "failed", "22", "selfhost check failed\0A");
    try append_llvm_constant(out, "ll_path", "28", "target/selfhost/selfhost.ll\0A");
    try append_llvm_constant(out, "meta_path", "33", "target/selfhost/selfhost.ll.meta\0A");
    try append_llvm_constant(out, "storage_path", "36", "target/selfhost/selfhost.storage.ll\0A");
    try append_llvm_constant(
        out,
        "storage_meta_path",
        "41",
        "target/selfhost/selfhost.storage.ll.meta\0A"
    );
    try append_llvm_constant(out, "host_path", "33", "target/selfhost/selfhost.host.ll\0A");
    try append_llvm_constant(
        out,
        "host_meta_path",
        "38",
        "target/selfhost/selfhost.host.ll.meta\0A"
    );
    try append_llvm_constant(out, "root_ll_path", "27", "target/selfhost/selfhost.ll");
    try append_llvm_constant(out, "root_meta_path", "32", "target/selfhost/selfhost.ll.meta");
    try append_llvm_constant(
        out,
        "root_storage_path",
        "35",
        "target/selfhost/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "root_storage_meta_path",
        "40",
        "target/selfhost/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(out, "root_host_path", "32", "target/selfhost/selfhost.host.ll");
    try append_llvm_constant(
        out,
        "root_host_meta_path",
        "37",
        "target/selfhost/selfhost.host.ll.meta"
    );
    try append_llvm_constant(out, "stage2_ll_path", "34", "target/selfhost/stage2/selfhost.ll");
    try append_llvm_constant(
        out,
        "stage2_meta_path",
        "39",
        "target/selfhost/stage2/selfhost.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_path",
        "42",
        "target/selfhost/stage2/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_meta_path",
        "47",
        "target/selfhost/stage2/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_host_path",
        "39",
        "target/selfhost/stage2/selfhost.host.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_host_meta_path",
        "44",
        "target/selfhost/stage2/selfhost.host.ll.meta"
    );
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_lower_run_ast_to_program_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let return_void_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "ReturnVoid"
    );
    let try_void_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "TryVoidPrintReturn"
    );
    let loop_i64_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "LoopI64Print"
    );
    let fs_read_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "FsReadPrintReturn"
    );
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lower_run_ast_to_program(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.selfhost.codegen.run_ast %run_ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %supported = call i1 @kizu_selfhost__ir_codegen_run_ast_supported(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  br i1 %supported, label %supported_shape, label %unsupported");
    try append_line(out, "supported_shape:");
    try append_line(out,
        "  %i64_supported = call i1 @kizu_selfhost__ir_codegen_run_ast_i64_call_supported(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  br i1 %i64_supported, label %i64_program, label %string_program");
    try append_line(out, "i64_program:");
    try append_line(out,
        "  %i64_result = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lowered_i64_call_program(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %i64_result");
    try append_line(out, "string_program:");
    try append_line(out, "  %statement_kind = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 5");
    try out.append_bytes("  %loop_i64 = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, loop_i64_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %loop_i64, label %loop_i64_program, label %check_fs_read_program");
    try append_line(out, "loop_i64_program:");
    try append_line(out,
        "  %loop_i64_result = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lowered_loop_i64_program(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %loop_i64_result");
    try append_line(out, "check_fs_read_program:");
    try out.append_bytes("  %fs_read = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, fs_read_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %fs_read, label %fs_read_program, label %check_try_void_program");
    try append_line(out, "fs_read_program:");
    try append_line(out,
        "  %fs_read_result = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lowered_fs_read_program(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %fs_read_result");
    try append_line(out, "check_try_void_program:");
    try out.append_bytes("  %try_void = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, try_void_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %try_void, label %try_void_program, label %check_return_void_program");
    try append_line(out, "try_void_program:");
    try append_line(out,
        "  %try_void_result = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lowered_try_void_program(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %try_void_result");
    try append_line(out, "check_return_void_program:");
    try out.append_bytes("  %return_void = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, return_void_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %return_void, label %return_void_program, label %print_program");
    try append_line(out, "return_void_program:");
    try append_line(out,
        "  %return_void_result = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lowered_return_void_program(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %return_void_result");
    try append_line(out, "print_program:");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 8");
    try append_line(out,
        "  %string_result = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_lowered_main_print_program(%kizu.slice.u8 %payload)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %string_result");
    try append_line(out, "unsupported:");
    try append_line(out, "  %text_ptr = extractvalue %kizu.slice.u8 %text, 0");
    try append_line(out, "  %empty0 = insertvalue %kizu.slice.u8 poison, ptr %text_ptr, 0");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 %empty0, i64 0, 1");
    try append_line(out,
        "  %unsupported_result = call %kizu.selfhost.codegen.program @kizu_selfhost__ir_codegen_unsupported_program(%kizu.slice.u8 %empty)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %unsupported_result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_run_ast_supported_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let return_void_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "ReturnVoid"
    );
    let try_void_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "TryVoidPrintReturn"
    );
    let loop_i64_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "LoopI64Print"
    );
    let fs_read_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "FsReadPrintReturn"
    );
    let print_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "Print"
    );
    let const_string_kind = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunArgumentKind", "ConstString"
    );
    try append_line(out, "define i1 @kizu_selfhost__ir_codegen_run_ast_supported(");
    try append_line(out, "  %kizu.selfhost.codegen.run_ast %run_ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ok = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 0");
    try append_line(out, "  br i1 %ok, label %check_block, label %unsupported");
    try append_line(out, "check_block:");
    try append_line(out, "  %block_count = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 3");
    try append_line(out, "  %one_block = icmp eq i64 %block_count, 1");
    try append_line(out, "  br i1 %one_block, label %check_main, label %unsupported");
    try append_line(out, "check_main:");
    try append_line(out, "  %function_name = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 2");
    try append_line(out,
        "  %main_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.run_main, i64 0, i64 0");
    try append_line(out, "  %main_base = insertvalue %kizu.slice.u8 poison, ptr %main_ptr, 0");
    try append_line(out, "  %main_slice = insertvalue %kizu.slice.u8 %main_base, i64 4, 1");
    try append_line(out,
        "  %main_ok = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %function_name, %kizu.slice.u8 %main_slice)");
    try append_line(out, "  br i1 %main_ok, label %check_statement_count, label %unsupported");
    try append_line(out, "check_statement_count:");
    try append_line(out, "  %statement_count = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 4");
    try append_line(out, "  %has_statement = icmp sgt i64 %statement_count, 0");
    try append_line(out, "  br i1 %has_statement, label %check_kind, label %unsupported");
    try append_line(out, "check_kind:");
    try append_line(out, "  %statement_kind = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 5");
    try out.append_bytes("  %is_return_void = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, return_void_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_return_void, label %return_void, label %check_try_void");
    try append_line(out, "return_void:");
    try append_line(out, "  %return_function_count = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 1");
    try append_line(out, "  %return_supported = icmp eq i64 %return_function_count, 1");
    try append_line(out, "  ret i1 %return_supported");
    try append_line(out, "check_try_void:");
    try out.append_bytes("  %is_try_void = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, try_void_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_try_void, label %try_void, label %check_loop_i64");
    try append_line(out, "try_void:");
    try append_line(out,
        "  %try_void_supported = call i1 @kizu_selfhost__ir_codegen_try_void_run_ast_supported(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret i1 %try_void_supported");
    try append_line(out, "check_loop_i64:");
    try out.append_bytes("  %is_loop_i64 = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, loop_i64_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_loop_i64, label %loop_i64, label %check_fs_read");
    try append_line(out, "loop_i64:");
    try append_line(out,
        "  %loop_i64_supported = call i1 @kizu_selfhost__ir_codegen_loop_i64_run_ast_supported(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret i1 %loop_i64_supported");
    try append_line(out, "check_fs_read:");
    try out.append_bytes("  %is_fs_read = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, fs_read_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_fs_read, label %fs_read, label %check_print");
    try append_line(out, "fs_read:");
    try append_line(out,
        "  %fs_read_supported = call i1 @kizu_selfhost__ir_codegen_fs_read_run_ast_supported(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret i1 %fs_read_supported");
    try append_line(out, "check_print:");
    try out.append_bytes("  %is_print = icmp eq i64 %statement_kind, ");
    try std::fmt::append_i64(out, print_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_print, label %check_callee, label %unsupported");
    try append_line(out, "check_callee:");
    try append_line(out, "  %callee = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 6");
    try append_line(out,
        "  %print_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.run_print, i64 0, i64 0");
    try append_line(out, "  %print_base = insertvalue %kizu.slice.u8 poison, ptr %print_ptr, 0");
    try append_line(out, "  %print_slice = insertvalue %kizu.slice.u8 %print_base, i64 5, 1");
    try append_line(out,
        "  %callee_ok = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %callee, %kizu.slice.u8 %print_slice)");
    try append_line(out, "  br i1 %callee_ok, label %check_function_count, label %unsupported");
    try append_line(out, "check_function_count:");
    try append_line(out, "  %function_count = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 1");
    try append_line(out, "  %one_function = icmp eq i64 %function_count, 1");
    try append_line(out, "  br i1 %one_function, label %check_const_string_arg, label %check_i64_call");
    try append_line(out, "check_const_string_arg:");
    try append_line(out, "  %arg_kind = extractvalue %kizu.selfhost.codegen.run_ast %run_ast, 7");
    try out.append_bytes("  %const_string_arg = icmp eq i64 %arg_kind, ");
    try std::fmt::append_i64(out, const_string_kind);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret i1 %const_string_arg");
    try append_line(out, "check_i64_call:");
    try append_line(out, "  %two_functions = icmp eq i64 %function_count, 2");
    try append_line(out, "  br i1 %two_functions, label %i64_call, label %unsupported");
    try append_line(out, "i64_call:");
    try append_line(out,
        "  %i64_supported = call i1 @kizu_selfhost__ir_codegen_run_ast_i64_call_supported(%kizu.selfhost.codegen.run_ast %run_ast)");
    try append_line(out, "  ret i1 %i64_supported");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_loop_i64_run_ast_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let loop_i64_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunStatementKind", "LoopI64Print"
    );
    let arg_none_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunArgumentKind", "None"
    );
    let op_none_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "None"
    );
    try append_line(out, "define %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_loop_i64_run_ast(");
    try append_line(out, "  %kizu.slice.u8 %function_name,");
    try append_line(out, "  i64 %statement_count,");
    try append_line(out, "  %kizu.slice.u8 %print_callee,");
    try append_line(out, "  i64 %start_value,");
    try append_line(out, "  i64 %bound,");
    try append_line(out, "  i64 %continue_value,");
    try append_line(out, "  i64 %break_value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %function_name_ptr = extractvalue %kizu.slice.u8 %function_name, 0");
    try append_line(out, "  %empty_base = insertvalue %kizu.slice.u8 poison, ptr %function_name_ptr, 0");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 %empty_base, i64 0, 1");
    try append_line(out, "  %result0 = insertvalue %kizu.selfhost.codegen.run_ast zeroinitializer, i1 true, 0");
    try append_line(out, "  %result1 = insertvalue %kizu.selfhost.codegen.run_ast %result0, i64 1, 1");
    try append_line(out, "  %result2 = insertvalue %kizu.selfhost.codegen.run_ast %result1, %kizu.slice.u8 %function_name, 2");
    try append_line(out, "  %result3 = insertvalue %kizu.selfhost.codegen.run_ast %result2, i64 1, 3");
    try append_line(out, "  %result4 = insertvalue %kizu.selfhost.codegen.run_ast %result3, i64 %statement_count, 4");
    try out.append_bytes("  %result5 = insertvalue %kizu.selfhost.codegen.run_ast %result4, i64 ");
    try std::fmt::append_i64(out, loop_i64_tag);
    try out.append_bytes(", 5");
    try out.append_byte(cast<u8>(10));
