    try append_line(out, "child_fail:");
    try append_i64_child_fail_return(out, "arg_result");
    try append_line(out, "unsupported:");
    try append_i64_literal_success_return(out, "unsupported_error_call", -1);
    try append_line(out, "}");
    try append_line(out, "");

    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_error_void_return_exit_code(");
