import selfhost::backend::cli_artifact_dir_llvm;
import selfhost::backend::cli_artifact_path_llvm;
import selfhost::backend::cli_check_gate_llvm;
import selfhost::backend::cli_codegen_llvm;
import selfhost::backend::cli_frontend_llvm;
import selfhost::backend::cli_hosted_renderer_llvm;
import selfhost::backend::cli_hosted_metadata_llvm;
import selfhost::backend::cli_match_llvm;
import selfhost::backend::cli_parse_llvm;
import selfhost::backend::cli_run_llvm;
import selfhost::backend::cli_test_llvm;
import selfhost::backend::compiled_llvm;

pub fn append_globals(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_llvm_constant(out, "check", "5", "check");
    try append_llvm_constant(out, "stage", "5", "stage");
    try append_llvm_constant(out, "parse", "5", "parse");
    try append_llvm_constant(out, "run", "3", "run");
    try append_llvm_constant(out, "test", "4", "test");
    try append_llvm_constant(out, "fmt", "3", "fmt");
    try append_llvm_constant(out, "fmt_write", "7", "--write");
    try append_llvm_constant(out, "fmt_write_short", "2", "-w");
    try append_llvm_constant(out, "selfhost", "8", "selfhost");
    try cli_artifact_dir_llvm::append_globals(out);
    try cli_codegen_llvm::append_globals(out, ir_bytes);
    try cli_frontend_llvm::append_globals(out);
    try cli_hosted_renderer_llvm::append_globals(out);
    try cli_parse_llvm::append_globals(out);
    try cli_run_llvm::append_globals(out, ir_bytes);
    try cli_test_llvm::append_globals(out, ir_bytes);
    try cli_hosted_metadata_llvm::append_output_prefix_constant(
        out,
        "artifact_output_prefix"
    );
    try append_llvm_constant(out, "manifest", "18", "selfhost/kizu.toml");
    try append_llvm_constant(out, "source_dir", "12", "selfhost/src");
    try append_llvm_constant(out, "check_ok", "10", "check: ok\0A");
    try append_llvm_constant(out, "move_prefix", "32", "error: move error: moved value `");
    try append_llvm_constant(out, "move_suffix", "10", "` was used");
    try append_llvm_constant(out, "stage_ok", "10", "stage: ok\0A");
    try append_llvm_constant(out, "usage", "58", "usage: selfhost <check|stage|parse|run|test|fmt> <target>\0A");
    try append_llvm_constant(out, "unsupported", "29", "unsupported selfhost command\0A");
    try append_llvm_constant(out, "failed", "22", "selfhost check failed\0A");
    try append_llvm_constant(out, "ll_path", "28", "target/selfhost/selfhost.ll\0A");
    try append_llvm_constant(out, "meta_path", "33", "target/selfhost/selfhost.ll.meta\0A");
    try append_llvm_constant(out, "storage_path", "36", "target/selfhost/selfhost.storage.ll\0A");
    try append_llvm_constant(
        out,
        "storage_meta_path",
        "41",
        "target/selfhost/selfhost.storage.ll.meta\0A"
    );
    try append_llvm_constant(out, "host_path", "33", "target/selfhost/selfhost.host.ll\0A");
    try append_llvm_constant(
        out,
        "host_meta_path",
        "38",
        "target/selfhost/selfhost.host.ll.meta\0A"
    );
    try append_llvm_constant(out, "root_ll_path", "27", "target/selfhost/selfhost.ll");
    try append_llvm_constant(out, "root_meta_path", "32", "target/selfhost/selfhost.ll.meta");
    try append_llvm_constant(
        out,
        "root_storage_path",
        "35",
        "target/selfhost/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "root_storage_meta_path",
        "40",
        "target/selfhost/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(out, "root_host_path", "32", "target/selfhost/selfhost.host.ll");
    try append_llvm_constant(
        out,
        "root_host_meta_path",
        "37",
        "target/selfhost/selfhost.host.ll.meta"
    );
    try append_llvm_constant(out, "stage2_ll_path", "34", "target/selfhost/stage2/selfhost.ll");
    try append_llvm_constant(
        out,
        "stage2_meta_path",
        "39",
        "target/selfhost/stage2/selfhost.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_path",
        "42",
        "target/selfhost/stage2/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_meta_path",
        "47",
        "target/selfhost/stage2/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_host_path",
        "39",
        "target/selfhost/stage2/selfhost.host.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_host_meta_path",
        "44",
        "target/selfhost/stage2/selfhost.host.ll.meta"
    );
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_slice_equal_function(out);
    try append_slice_len_function(out);
    try append_slice_starts_with_dash_function(out);
    try append_write_concat3_function(out);
    try cli_artifact_dir_llvm::append_functions(out);
    try cli_artifact_path_llvm::append_functions(out);
    try cli_codegen_llvm::append_functions(out, ir_bytes);
    try cli_frontend_llvm::append_functions(out);
    try cli_hosted_renderer_llvm::append_functions(out);
    try cli_run_llvm::append_functions(out, ir_bytes);
    try cli_parse_llvm::append_functions(out);
    try cli_match_llvm::append_functions(out);
    try cli_test_llvm::append_functions(out, ir_bytes);
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::metadata_line",
        "kizu_selfhost__ir_codegen_metadata_line",
        ""
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::return_void_instruction",
        "kizu_selfhost__ir_codegen_return_void_instruction",
        ""
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::const_string_value",
        "kizu_selfhost__ir_codegen_const_string_value",
        "%kizu.slice.u8 name;%kizu.slice.u8 payload"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::const_string_instruction",
        "kizu_selfhost__ir_codegen_const_string_instruction",
        "%kizu.selfhost.codegen.value value"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::call_instruction",
        "kizu_selfhost__ir_codegen_call_instruction",
        "%kizu.slice.u8 callee;%kizu.selfhost.codegen.value argument"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::build_main_print_program",
        "kizu_selfhost__ir_codegen_build_main_print_program",
        "%kizu.slice.u8 payload;i1 from_codegen_lowering"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lowered_main_print_program",
        "kizu_selfhost__ir_codegen_lowered_main_print_program",
        "%kizu.slice.u8 payload"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::run_ast_supported",
        "kizu_selfhost__ir_codegen_run_ast_supported",
        "%kizu.selfhost.codegen.run_ast run_ast"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast_to_program",
        "kizu_selfhost__ir_codegen_lower_run_ast_to_program",
        "%kizu.slice.u8 text;%kizu.selfhost.codegen.run_ast run_ast"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::unsupported_program",
        "kizu_selfhost__ir_codegen_unsupported_program",
        "%kizu.slice.u8 empty"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::none_value",
        "kizu_selfhost__ir_codegen_none_value",
        "%kizu.slice.u8 empty"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::main_print_payload",
        "kizu_selfhost__ir_codegen_main_print_payload",
        "%kizu.selfhost.codegen.program program"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::stdout_payload",
        "kizu_selfhost__ir_codegen_stdout_payload",
        "%kizu.selfhost.codegen.program program"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::program_supported",
        "kizu_selfhost__ir_codegen_program_supported",
        "%kizu.selfhost.codegen.program program"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::print_run_ast",
        "kizu_selfhost__ir_codegen_print_run_ast",
        "%kizu.slice.u8 function_name;i64 statement_count;%kizu.slice.u8 callee;%kizu.slice.u8 payload"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::unsupported_run_ast",
        "kizu_selfhost__ir_codegen_unsupported_run_ast",
        "%kizu.slice.u8 empty"
    );
    // local_table_contains is the first AST-traversal lowering member compiled
    // into stage2 (tracker 961). It lands the run-AST local-binding model
    // (LocalTable / LocalBinding) plus the membership check lower_let_binding uses
    // to reject duplicate let names inside lower_run_ast_block. It is
    // AST-type-independent (it reads an already-built LocalTable, not AST nodes),
    // so it can be compiled now, ahead of the parser/AST migration the interior,
    // AST-dependent nodes (lower_run_ast and friends) still wait on. It mirrors the
    // already-compiled run_ast_supported shape: a borrowed struct param, field
    // reads, short-circuit and, std::mem::equal_bytes, and a bool return.
    //
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::local_table_contains",
        "kizu_selfhost__ir_codegen_local_table_contains",
        "%kizu.selfhost.codegen.local_table locals;%kizu.slice.u8 name"
    );
    // PayloadSpan / LocalBinding sentinel helpers (tracker 961). These return
    // structs whose fields use -1 sentinels (PayloadSpan { start: -1, end: -1 }),
    // unblocked by the compiled mini MIR now lowering Prefix(-Int) struct fields.
    // empty_local also reads text[0..0]; local_payload_span chains nested field
    // extraction (locals.first.payload_start) plus an empty_payload_span() fallback
    // call, both already supported. They land the run-AST local-binding lookup the
    // parser/AST migration still waits on for the interior nodes.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::empty_payload_span",
        "kizu_selfhost__ir_codegen_empty_payload_span",
        ""
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::empty_local",
        "kizu_selfhost__ir_codegen_empty_local",
        "%kizu.slice.u8 text"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::local_payload_span",
        "kizu_selfhost__ir_codegen_local_payload_span",
        "%kizu.selfhost.codegen.local_table locals;%kizu.slice.u8 name"
    );
    // empty_local_table builds a LocalTable whose first/second fields are produced
    // by calling empty_local (tracker 961). It exercises the new call-valued struct
    // field initializer lowering: the renderer emits each empty_local call and feeds
    // the result into the LocalTable insertvalue chain.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::empty_local_table",
        "kizu_selfhost__ir_codegen_empty_local_table",
        "%kizu.slice.u8 text"
    );
    // insert_local exercises nested struct-literal field initializers
    // (first/second: LocalBinding { ... }) plus a call-valued field
    // (second: empty_local(text)) across both an if-then struct return and the
    // top-level struct return (tracker 961). It preserves the count == 0 and
    // count != 0 LocalTable shapes.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::insert_local",
        "kizu_selfhost__ir_codegen_insert_local",
        "%kizu.slice.u8 text;%kizu.selfhost.codegen.local_table locals;%kizu.selfhost.codegen.local_binding binding"
    );
    // is_payload_supported is the first run-codegen leaf compiled through the
    // restricted bounded-counter while lowering (tracker 961): one i64 induction
    // variable, an index-less-than-std-mem-len comparison condition, sequential
    // early-return byte-range checks in the body, and an index-plus-one increment.
    // The generated LLVM is a single loop-carried phi over the preheader/head/body/
    // latch/exit blocks, and the payload index uses the ADR-0053 checked index-load path.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::is_payload_supported",
        "kizu_selfhost__ir_codegen_is_payload_supported",
        "%kizu.slice.u8 payload"
    );
    // string_literal_span is the first run-codegen AST traversal accessor that binds
    // an AstNode and reads its Span to slice the source text (tracker 961, scope 4
    // prerequisite). It binds the AstNode via Ast.get, reads the Span (AstNode field 0)
    // start/end, rejects spans shorter than the two surrounding quotes, checks the
    // leading/trailing double-quote bytes through the ADR-0053 checked index-load, and
    // forwards the inner payload slice to is_payload_supported, returning the trimmed
    // PayloadSpan on success or empty_payload_span() otherwise. Its callees (Ast.get,
    // is_payload_supported, empty_payload_span) are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::string_literal_span",
        "kizu_selfhost__ir_codegen_string_literal_span",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.node_id node_id"
    );
    // print_payload is the run-codegen AST traversal accessor that dispatches a print
    // argument node on the AstData tag (tracker 961, scope 4 prerequisite): the String
    // variant slices the quoted literal via string_literal_span, the Var variant resolves
    // the local payload via local_payload_span(locals, ast_node_text(...)), and every other
    // variant returns the shared empty_payload_span() sentinel. Its callees are already
    // compiled so selfhost.ll links. The borrowed &LocalTable lands by value, matching the
    // local_table_contains / local_payload_span ABI.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::print_payload",
        "kizu_selfhost__ir_codegen_print_payload",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.selfhost.codegen.local_table locals;%kizu.kizu.ast.node_id arg"
    );
    // lower_print_call is the run-codegen AST traversal lowering that recognises a single
    // print("...") / print(local) statement and builds the RunAst (tracker 961, scope 4
    // prerequisite). It is the first compiled !RunAst error-union return: it rejects a
    // non-print callee or wrong arity, propagates the checked Ast.child_at failure, extracts
    // the argument payload via print_payload, and wraps print_run_ast / unsupported_run_ast
    // into the !RunAst success. All callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_print_call",
        "kizu_selfhost__ir_codegen_lower_print_call",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.slice.u8 function_name;i64 statement_count;%kizu.selfhost.codegen.local_table locals;%kizu.kizu.ast.node_id callee;%kizu.kizu.ast.child_range args"
    );
    // lower_print_statement is the run-codegen AST traversal lowering that dispatches the final
    // block statement on the AstData tag (tracker 961, scope 4 prerequisite): the Call variant
    // forwards lower_print_call's !RunAst result, every other variant returns the wrapped
    // unsupported_run_ast(). Its callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_print_statement",
        "kizu_selfhost__ir_codegen_lower_print_statement",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.slice.u8 function_name;i64 statement_count;%kizu.selfhost.codegen.local_table locals;%kizu.kizu.ast.node_id expr"
    );
    // lower_let_binding is the run-codegen AST traversal lowering that turns a 'let <name> =
    // "..."' binding into a LocalBinding (tracker 961, scope 4 prerequisite): it reads the binding
    // name text, rejects a duplicate / over-capacity local, slices the string literal payload, and
    // returns the LocalBinding or empty_local() on rejection. Its callees are already compiled so
    // selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_let_binding",
        "kizu_selfhost__ir_codegen_lower_let_binding",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.selfhost.codegen.local_table locals;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.node_id value"
    );
    // lower_run_ast_block is the stateful run-block traversal (tracker 961, scope 4 prerequisite):
    // a bounded loop threading a mutable LocalTable + index, lowering non-terminal Let bindings via
    // lower_let_binding / insert_local and the terminal ExprStmt via lower_print_statement. Its
    // callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast_block",
        "kizu_selfhost__ir_codegen_lower_run_ast_block",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.slice.u8 function_name;%kizu.kizu.ast.child_range statements"
    );
    // lower_run_ast_function requires the run function to be 'main' and forwards its block body to
    // lower_run_ast_block (tracker 961, scope 4 prerequisite). Its callees are already compiled so
    // selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast_function",
        "kizu_selfhost__ir_codegen_lower_run_ast_function",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.node_id body"
    );
    // lower_run_ast_declarations scans the program declarations for the first FnDecl whose
    // lower_run_ast_function produces a supported RunAst (tracker 961, scope 4 prerequisite). Its
    // callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast_declarations",
        "kizu_selfhost__ir_codegen_lower_run_ast_declarations",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.child_range declarations"
    );
    // lower_run_ast is the run-codegen AST traversal root (tracker 961, scope 4 prerequisite): it
    // dispatches the program root and forwards lower_run_ast_declarations on the Program variant.
    // Its callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast",
        "kizu_selfhost__ir_codegen_lower_run_ast",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.node_id root"
    );
    // empty_int_env is the first compiled function that takes a real
    // std::kizu::ast value type (ChildRange) as a parameter and stores it into a
    // struct field, establishing the read-only AST value-type foundation in stage2
    // (tracker 961). The ChildRange is forwarded as a whole aggregate into the
    // IntEnv insertvalue chain; no AstNode/AstData union access is involved.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::empty_int_env",
        "kizu_selfhost__ir_codegen_empty_int_env",
        "%kizu.slice.u8 text;%kizu.kizu.ast.child_range decls"
    );
    // std::kizu::ast::Ast.len is the first real AST read-only accessor compiled into
    // stage2 (tracker 961). It takes the Ast container value as a parameter, reads
    // its children Array field (struct field index 1), and returns the Array length
    // via the array_len builtin. It is the method-call lowering counterpart to the
    // empty_int_env value-type foundation: no AstNode/AstData union, Arena.get,
    // array_get, or error-union return is involved.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::ast_len",
        "kizu_kizu__ast_ast_len",
        "%kizu.kizu.ast.ast self"
    );
    // Diagnostic.related_get is the first checked Array<T>.get accessor compiled
    // into stage2 (tracker 961): it reads the related Array<RelatedSpan> field
    // (struct field index 2) and returns a single RelatedSpan by value as
    // !RelatedSpan via the checked @kizu_rt_array_at runtime call, with a real
    // error-union failure return (never unreachable) on an out-of-bounds index.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::diagnostic::diagnostic_related_get",
        "kizu_kizu__diagnostic_diagnostic_related_get",
        "%kizu.kizu.diagnostic.diagnostic self;i64 index"
    );
    // Ast.child_at is the first multi-statement Array<T>.get consumer compiled into
    // stage2 (tracker 961): a bounds-check 'if' with a real return error(...) failure
    // return, then 'return self.children.get(range.start + index);' lowered to the
    // checked @kizu_rt_array_at accessor returning !NodeId.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::ast_child_at",
        "kizu_kizu__ast_ast_child_at",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.child_range range;i64 index"
    );
    // Ast.add_node is the first AstNode/AstData tagged-union constructor compiled into
    // stage2 (tracker 961): it builds an AstNode (Span + AstData union value forwarded
    // whole) and appends it to the nodes Arena via the heap-backed @kizu_rt_arena_add,
    // binding the returned NodeId. It exercises the union value-type ABI without
    // modelling the 44 variant payload structs.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::ast_add_node",
        "kizu_kizu__ast_ast_add_node",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;%kizu.kizu.ast.ast_data data"
    );
    // Ast.get is the first Arena<T>.get accessor compiled into stage2 (tracker 961): it
    // reads an AstNode back out of the nodes Arena by value via the checked
    // @kizu_rt_arena_get, reusing the AstNode/AstData union value-type ABI, and traps on
    // an out-of-bounds NodeId index.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::ast_get",
        "kizu_kizu__ast_ast_get",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.node_id id"
    );
    // declaration_count is the first match-over-AstData-union read-only AST accessor
    // compiled into stage2 (tracker 961): it binds an AstNode via Ast.get, dispatches on
    // the AstData tagged-union tag, and on the Program arm reads program.declarations.len
    // out of the inline payload, returning 0 for every other variant.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::declaration_count",
        "kizu_selfhost__ast_declaration_count",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id root"
    );
    // The node_count recursive AST-traversal cluster compiled into stage2 (tracker 961):
    // node_count is the 44-arm match-over-AstData traversal, count_range the two-phi
    // accumulator loop calling Ast.child_at + node_count, and the count_* helpers the
    // let-try / return-try arithmetic. The whole mutually-recursive cluster is registered
    // together so selfhost.ll links with no undefined symbol.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::node_count",
        "kizu_selfhost__ast_node_count",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id node_id"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_range",
        "kizu_selfhost__ast_count_range",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.child_range range"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_one",
        "kizu_selfhost__ast_count_one",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id first"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_two",
        "kizu_selfhost__ast_count_two",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id first;%kizu.kizu.ast.node_id second"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_three",
        "kizu_selfhost__ast_count_three",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id first;%kizu.kizu.ast.node_id second;%kizu.kizu.ast.node_id third"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_five",
        "kizu_selfhost__ast_count_five",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id first;%kizu.kizu.ast.node_id second;%kizu.kizu.ast.node_id third;%kizu.kizu.ast.node_id fourth;%kizu.kizu.ast.node_id fifth"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_with_range",
        "kizu_selfhost__ast_count_with_range",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.child_range range"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_node_with_range",
        "kizu_selfhost__ast_count_node_with_range",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id node_id;%kizu.kizu.ast.child_range range"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_named_range",
        "kizu_selfhost__ast_count_named_range",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.child_range range"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_named_ranges",
        "kizu_selfhost__ast_count_named_ranges",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.child_range first;%kizu.kizu.ast.child_range second"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_fn_decl_parts",
        "kizu_selfhost__ast_count_fn_decl_parts",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id extern_abi;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.child_range type_params;%kizu.kizu.ast.child_range params;%kizu.kizu.ast.node_id return_type;%kizu.kizu.ast.node_id return_borrow;%kizu.kizu.ast.node_id body"
    );
    // std::mem::is_ascii_space backs the ast_node_text span accessor's trim (tracker 961):
    // an or-chain byte classifier returning i1. It lowers through the single-statement
    // expression-return path (the binary renderer already handles or / eq).
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::mem::is_ascii_space",
        "kizu_std__mem_is_ascii_space",
        "i8 byte"
    );
    // std::mem::trim_ascii and ast_node_text are the span-based text slicing accessors the
    // run-codegen AST traversal depends on (tracker 961). ast_node_text calls trim_ascii calls
    // is_ascii_space; the whole chain is registered together so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::mem::trim_ascii",
        "kizu_std__mem_trim_ascii",
        "%kizu.slice.u8 bytes"
    );
    // std::kizu::lexer leaf byte classifiers (tracker 961, scope 4 prerequisite): the bottom of the
    // lexer compile chain the eventual scanner removal needs (source -> Ast requires the compiled
    // tokenizer). is_alpha / is_digit / is_space are or-chain / range byte predicates over a single
    // i8 that lower through the single-statement expression-return path; is_word or-combines
    // is_alpha / is_digit, its i8 call arguments resolved via the stdlib-symbol arg-type facts.
    // position(line, column) builds the lexer's (line, column) Position cursor struct (tracker
    // 961, scope 4 prerequisite): the leaf of the tokenizer's position-tracking helpers. It lowers
    // through the single-statement struct-return path.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::position",
        "kizu_kizu__lexer_position",
        "i64 line;i64 column"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::is_alpha",
        "kizu_kizu__lexer_is_alpha",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::is_digit",
        "kizu_kizu__lexer_is_digit",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::is_word",
        "kizu_kizu__lexer_is_word",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::is_space",
        "kizu_kizu__lexer_is_space",
        "i8 byte"
    );
    // advance_byte(byte, initial) advances the (line, column) cursor past one source
    // byte, calling position(...) in both the newline and same-line arms (tracker 961,
    // scope 4 prerequisite). It lowers through the multi-statement if + return-call path
    // using the int-literal and field-arith call args.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::advance_byte",
        "kizu_kizu__lexer_advance_byte",
        "i8 byte;%kizu.kizu.lexer.position initial"
    );
    // advance_position(source, start, end, initial) folds advance_byte across source[start..end]
    // to thread the (line, column) cursor (tracker 961, scope 4 prerequisite). It lowers through
    // the dedicated two-phi struct-loop renderer dispatched by name.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::advance_position",
        "kizu_kizu__lexer_advance_position",
        "%kizu.slice.u8 source;i64 start;i64 end;%kizu.kizu.lexer.position initial"
    );
    // token / attach_doc are the leaf Token constructors the tokenizer's raw_token_at / token_at
    // build their results from (tracker 961, scope 4 prerequisite). Both are single struct-literal
    // returns: token reads current.line / current.column off the Position param, attach_doc reads
    // every field off the raw Token. They lower through the struct-return path.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::token",
        "kizu_kizu__lexer_token",
        "i64 kind;i64 start;i64 end;%kizu.kizu.lexer.position current"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::attach_doc",
        "kizu_kizu__lexer_attach_doc",
        "%kizu.kizu.lexer.token raw;i64 doc_start;i64 doc_end"
    );
    // number_token(source, start, current) scans a digit run and builds the Number Token (tracker
    // 961, scope 4 prerequisite). It lowers through a dedicated scan-loop renderer dispatched by
    // name: an i64 end phi advancing while source[end] is a digit, then token(Number, ...).
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::number_token",
        "kizu_kizu__lexer_number_token",
        "%kizu.slice.u8 source;i64 start;%kizu.kizu.lexer.position current"
    );
    // string_token(source, start, current) scans a quoted run and builds the String Token (tracker
    // 961, scope 4 prerequisite). It lowers through a dedicated scan-loop renderer dispatched by
    // name: an i64 end phi advancing while source[end] != quote, then token(String, ...) spanning
    // the closing quote when terminated or the raw run otherwise.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::string_token",
        "kizu_kizu__lexer_string_token",
        "%kizu.slice.u8 source;i64 start;%kizu.kizu.lexer.position current"
    );
    // skip_line_comment(source, start, initial) threads the cursor past a comment line and returns
    // an Eof Token (tracker 961, scope 4 prerequisite). It lowers through a dedicated two-phi
    // struct-loop renderer dispatched by name: i64 end + Position current folded over advance_byte
    // until newline, then token(Eof, end, end, current).
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::lexer::skip_line_comment",
        "kizu_kizu__lexer_skip_line_comment",
        "%kizu.slice.u8 source;i64 start;%kizu.kizu.lexer.position initial"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::ast_node_text",
        "kizu_selfhost__ir_codegen_ast_node_text",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.node_id node_id"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lowered_program_supported",
        "kizu_selfhost__ir_codegen_lowered_program_supported",
        "%kizu.selfhost.codegen.program program"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::metadata_for_program",
        "kizu_selfhost__ir_codegen_metadata_for_program",
        "%kizu.selfhost.codegen.program program"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::is_digit",
        "kizu_selfhost__lexer_is_digit",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::is_alpha",
        "kizu_selfhost__lexer_is_alpha",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::is_identifier_start",
        "kizu_selfhost__lexer_is_identifier_start",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::is_identifier_continue",
        "kizu_selfhost__lexer_is_identifier_continue",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::lexer::invalid_token_display",
        "kizu_selfhost__lexer_invalid_token_display",
        ""
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::backend::hosted::hosted_output_len",
        "kizu_selfhost__hosted_output_len",
        "%kizu.slice.u8 output_payload;i1 append_newline"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::source::loader::module_end_for",
        "kizu_selfhost__source_loader_module_end_for",
        "%kizu.slice.u8 path"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::source::loader::package_module_end",
        "kizu_selfhost__source_loader_package_module_end",
        "%kizu.slice.u8 path;i64 start"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::source::loader::is_manifest_root_source",
        "kizu_selfhost__source_loader_is_manifest_root_source",
        "%kizu.slice.u8 module_root;%kizu.slice.u8 path"
    );
    try append_cli_main_function(out, ir_bytes);
    return;
}

fn append_slice_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_equal(");
    try append_line(out, "  %kizu.slice.u8 %left,");
    try append_line(out, "  %kizu.slice.u8 %right");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %left_len = extractvalue %kizu.slice.u8 %left, 1");
    try append_line(out, "  %right_len = extractvalue %kizu.slice.u8 %right, 1");
    try append_line(out, "  %same_len = icmp eq i64 %left_len, %right_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %left_len");
    try append_line(out, "  br i1 %done, label %true, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %left_ptr = extractvalue %kizu.slice.u8 %left, 0");
    try append_line(out, "  %right_ptr = extractvalue %kizu.slice.u8 %right, 0");
    try append_line(out, "  %left_at = getelementptr i8, ptr %left_ptr, i64 %index");
    try append_line(out, "  %right_at = getelementptr i8, ptr %right_ptr, i64 %index");
    try append_line(out, "  %left_byte = load i8, ptr %left_at");
    try append_line(out, "  %right_byte = load i8, ptr %right_at");
    try append_line(out, "  %same_byte = icmp eq i8 %left_byte, %right_byte");
    try append_line(out, "  br i1 %same_byte, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_len_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__slice_len(");
    try append_line(out, "  %kizu.slice.u8 %slice");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %slice, 1");
    try append_line(out, "  ret i64 %len");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_starts_with_dash_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_starts_with_dash(");
    try append_line(out, "  %kizu.slice.u8 %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %value, 1");
    try append_line(out, "  %has_byte = icmp sgt i64 %len, 0");
    try append_line(out, "  br i1 %has_byte, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %value, 0");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_dash = icmp eq i8 %byte, 45");
    try append_line(out, "  ret i1 %is_dash");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_concat3_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__write_concat3(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %prefix,");
    try append_line(out, "  %kizu.slice.u8 %middle,");
    try append_line(out, "  %kizu.slice.u8 %suffix");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %prefix_ptr = extractvalue %kizu.slice.u8 %prefix, 0");
    try append_line(out, "  %prefix_len = extractvalue %kizu.slice.u8 %prefix, 1");
    try append_line(out, "  %middle_ptr = extractvalue %kizu.slice.u8 %middle, 0");
    try append_line(out, "  %middle_len = extractvalue %kizu.slice.u8 %middle, 1");
    try append_line(out, "  %suffix_ptr = extractvalue %kizu.slice.u8 %suffix, 0");
    try append_line(out, "  %suffix_len = extractvalue %kizu.slice.u8 %suffix, 1");
    try append_line(out, "  %prefix_middle_len = add i64 %prefix_len, %middle_len");
    try append_line(out, "  %total_len = add i64 %prefix_middle_len, %suffix_len");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %total_len)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %copy_prefix, label %alloc_failed");
    try append_line(out, "copy_prefix:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %buffer, ptr %prefix_ptr, i64 %prefix_len, i1 false)");
    try append_line(out, "  %middle_dest = getelementptr i8, ptr %buffer, i64 %prefix_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %middle_dest, ptr %middle_ptr, i64 %middle_len, i1 false)");
    try append_line(out,
        "  %suffix_dest = getelementptr i8, ptr %buffer, i64 %prefix_middle_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %suffix_dest, ptr %suffix_ptr, i64 %suffix_len, i1 false)");
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %total_len, 1");
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned %io, %kizu.slice.u8 %path, %kizu.slice.u8 %body)");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %buffer)");
    try append_line(out, "  ret %kizu.error.void %write");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_cli_main_header(out);
    try append_cli_main_dispatch(out);
    try append_cli_corpus_blocks(out);
    try cli_test_llvm::append_cli_test_blocks(out, ir_bytes);
    try cli_run_llvm::append_cli_run_blocks(out, ir_bytes);
    try cli_parse_llvm::append_cli_parse_blocks(out);
    try cli_parse_llvm::append_cli_fmt_blocks(out);
    try cli_parse_llvm::append_cli_fmt_write_blocks(out);
    try append_cli_check_blocks(out);
    try append_cli_stage_blocks(out);
    try append_cli_error_blocks(out);
    try append_line(out, "}");
    return;
}

fn append_cli_main_header(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %argc = call i64 @kizu_rt_process_arg_count()");
    try append_line(out, "  %argc_is_two = icmp eq i64 %argc, 2");
    try append_line(out, "  %argc_is_three = icmp eq i64 %argc, 3");
    try append_line(out, "  %argc_ok = or i1 %argc_is_two, %argc_is_three");
    try append_line(out, "  br i1 %argc_ok, label %load_command, label %usage");
    try append_line(out, "load_command:");
    try append_line(out, "  %command_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 0)");
    try append_line(out, "  %command_ok = extractvalue %kizu.error.slice.u8 %command_result, 0");
    try append_line(out, "  br i1 %command_ok, label %route_args, label %check_failed");
    try append_line(out, "route_args:");
    try append_line(out, "  br i1 %argc_is_three, label %load_fmt_write_flag, label %load_target");
    try append_line(out, "load_fmt_write_flag:");
    try append_line(out,
        "  %fmt_write_flag_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out,
        "  %fmt_write_flag_ok = extractvalue %kizu.error.slice.u8 %fmt_write_flag_result, 0");
    try append_line(out,
        "  br i1 %fmt_write_flag_ok, label %load_fmt_write_target, label %check_failed");
    try append_line(out, "load_fmt_write_target:");
    try append_line(out,
        "  %fmt_write_target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 2)");
    try append_line(out,
        "  %fmt_write_target_ok = extractvalue %kizu.error.slice.u8 %fmt_write_target_result, 0");
    try append_line(out,
        "  br i1 %fmt_write_target_ok, label %dispatch_fmt_write_arg, label %check_failed");
    try append_line(out, "load_target:");
    try append_line(out, "  %target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out, "  %target_ok = extractvalue %kizu.error.slice.u8 %target_result, 0");
    try append_line(out, "  br i1 %target_ok, label %dispatch, label %check_failed");
    return;
}

fn append_cli_main_dispatch(out: &var std::string::String) -> !void {
    try append_cli_fmt_write_arg_dispatch(out);
    try append_line(out, "dispatch:");
    try append_line(out, "  %command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out, "  %target = extractvalue %kizu.error.slice.u8 %target_result, 1");
    try append_line(out,
        "  %command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %command)");
    try append_line(out, "  br i1 %command_is_flag, label %usage, label %check_target_flag");
    try append_line(out, "check_target_flag:");
    try append_line(out,
        "  %target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %target)");
    try append_line(out, "  br i1 %target_is_flag, label %usage, label %maybe_test");
    try append_line(out, "maybe_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.test, i64 0, i64 0");
    try append_line(out, "  %test_base = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test_base, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %dispatch_test, label %maybe_run");
    try append_line(out, "maybe_run:");
    try append_line(out,
        "  %run_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.run, i64 0, i64 0");
    try append_line(out, "  %run_base = insertvalue %kizu.slice.u8 poison, ptr %run_ptr, 0");
    try append_line(out, "  %run_slice = insertvalue %kizu.slice.u8 %run_base, i64 3, 1");
    try append_line(out,
        "  %is_run = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %run_slice)");
    try append_line(out, "  br i1 %is_run, label %dispatch_run, label %maybe_parse");
    try append_line(out, "maybe_parse:");
    try append_line(out,
        "  %parse_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.parse, i64 0, i64 0");
    try append_line(out, "  %parse_base = insertvalue %kizu.slice.u8 poison, ptr %parse_ptr, 0");
    try append_line(out, "  %parse_slice = insertvalue %kizu.slice.u8 %parse_base, i64 5, 1");
    try append_line(out,
        "  %is_parse = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %parse_slice)");
    try append_line(out, "  br i1 %is_parse, label %dispatch_parse, label %maybe_fmt");
    try append_line(out, "maybe_fmt:");
    try append_line(out,
        "  %fmt_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.fmt, i64 0, i64 0");
    try append_line(out, "  %fmt_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_ptr, 0");
    try append_line(out, "  %fmt_slice = insertvalue %kizu.slice.u8 %fmt_base, i64 3, 1");
    try append_line(out,
        "  %is_fmt = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %fmt_slice)");
    try append_line(out, "  br i1 %is_fmt, label %dispatch_fmt, label %match_selfhost");
    try append_line(out, "match_selfhost:");
    try append_line(out,
        "  %selfhost_ptr = getelementptr inbounds [8 x i8], ptr @.kizu.cli.selfhost, i64 0, i64 0");
    try append_line(out, "  %selfhost_base = insertvalue %kizu.slice.u8 poison, ptr %selfhost_ptr, 0");
    try append_line(out, "  %selfhost_slice = insertvalue %kizu.slice.u8 %selfhost_base, i64 8, 1");
    try append_line(out,
        "  %target_matches = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %selfhost_slice)");
    try append_line(out, "  br i1 %target_matches, label %dispatch_command, label %dispatch_corpus");
    try append_line(out, "dispatch_command:");
    try append_line(out,
        "  %check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out, "  %check_base = insertvalue %kizu.slice.u8 poison, ptr %check_ptr, 0");
    try append_line(out, "  %check_slice = insertvalue %kizu.slice.u8 %check_base, i64 5, 1");
    try append_line(out,
        "  %is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %check_slice)");
    try append_line(out, "  br i1 %is_check, label %run_check, label %maybe_stage");
    try append_line(out, "maybe_stage:");
    try append_line(out,
        "  %stage_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.stage, i64 0, i64 0");
    try append_line(out, "  %stage_base = insertvalue %kizu.slice.u8 poison, ptr %stage_ptr, 0");
    try append_line(out, "  %stage_slice = insertvalue %kizu.slice.u8 %stage_base, i64 5, 1");
    try append_line(out,
        "  %is_stage = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %stage_slice)");
    try append_line(out, "  br i1 %is_stage, label %run_stage, label %unsupported");
    return;
}

fn append_cli_fmt_write_arg_dispatch(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_fmt_write_arg:");
    try append_line(out,
        "  %fmt_write_command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out,
        "  %fmt_write_flag = extractvalue %kizu.error.slice.u8 %fmt_write_flag_result, 1");
    try append_line(out,
        "  %fmt_write_target = extractvalue %kizu.error.slice.u8 %fmt_write_target_result, 1");
    try append_line(out,
        "  %fmt_write_command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %fmt_write_command)");
    try append_line(out,
        "  br i1 %fmt_write_command_is_flag, label %usage, label %check_fmt_write_target_flag");
    try append_line(out, "check_fmt_write_target_flag:");
    try append_line(out,
        "  %fmt_write_target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %fmt_write_target)");
    try append_line(out,
        "  br i1 %fmt_write_target_is_flag, label %usage, label %match_fmt_write_command");
    try append_line(out, "match_fmt_write_command:");
    try append_line(out,
        "  %fmt_write_command_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.fmt, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_command_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_command_ptr, 0");
    try append_line(out,
        "  %fmt_write_command_slice = insertvalue %kizu.slice.u8 %fmt_write_command_base, i64 3, 1");
    try append_line(out,
        "  %fmt_write_is_fmt = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_command, %kizu.slice.u8 %fmt_write_command_slice)");
    try append_line(out,
        "  br i1 %fmt_write_is_fmt, label %match_fmt_write_flag, label %usage");
    try append_line(out, "match_fmt_write_flag:");
    try append_line(out,
        "  %fmt_write_flag_ptr = getelementptr inbounds [7 x i8], ptr @.kizu.cli.fmt_write, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_flag_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_flag_ptr, 0");
    try append_line(out,
        "  %fmt_write_flag_slice = insertvalue %kizu.slice.u8 %fmt_write_flag_base, i64 7, 1");
    try append_line(out,
        "  %fmt_write_is_long = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_flag, %kizu.slice.u8 %fmt_write_flag_slice)");
    try append_line(out,
        "  %fmt_write_short_ptr = getelementptr inbounds [2 x i8], ptr @.kizu.cli.fmt_write_short, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_short_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_short_ptr, 0");
    try append_line(out,
        "  %fmt_write_short_slice = insertvalue %kizu.slice.u8 %fmt_write_short_base, i64 2, 1");
    try append_line(out,
        "  %fmt_write_is_short = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_flag, %kizu.slice.u8 %fmt_write_short_slice)");
    try append_line(out, "  %fmt_write_flag_matches = or i1 %fmt_write_is_long, %fmt_write_is_short");
    try append_line(out,
        "  br i1 %fmt_write_flag_matches, label %dispatch_fmt_write, label %usage");
    return;
}

fn append_cli_corpus_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_corpus:");
    try append_line(out,
        "  %corpus_check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out,
        "  %corpus_check_base = insertvalue %kizu.slice.u8 poison, ptr %corpus_check_ptr, 0");
    try append_line(out,
        "  %corpus_check_slice = insertvalue %kizu.slice.u8 %corpus_check_base, i64 5, 1");
    try append_line(out,
        "  %corpus_is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %corpus_check_slice)");
    try append_line(out, "  br i1 %corpus_is_check, label %read_check_corpus_source, label %usage");
    try append_line(out, "read_check_corpus_source:");
    try append_line(out, "  %corpus_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %corpus_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %corpus_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %corpus_file_ok = extractvalue %kizu.error.slice.u8 %corpus_file, 0");
    try append_line(out, "  br i1 %corpus_file_ok, label %match_corpus_source, label %usage");
    try append_line(out, "match_corpus_source:");
    try append_line(out, "  %corpus_bytes = extractvalue %kizu.error.slice.u8 %corpus_file, 1");
    try cli_check_gate_llvm::append_static_check_gate(
        out,
        "check_file",
        "check",
        "corpus_io",
        "corpus_bytes",
        "check_file_ok"
    );
    try append_line(out, "check_file_ok:");
    try append_line(out,
        "  %check_file_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out,
        "  %check_file_ok_base = insertvalue %kizu.slice.u8 poison, ptr %check_file_ok_ptr, 0");
    try append_line(out,
        "  %check_file_ok_slice = insertvalue %kizu.slice.u8 %check_file_ok_base, i64 10, 1");
    try append_line(out,
        "  %check_file_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %corpus_io, %kizu.slice.u8 %check_file_ok_slice)");
    try append_line(out, "  %check_file_write_ok = extractvalue %kizu.error.void %check_file_write, 0");
    try append_line(out, "  br i1 %check_file_write_ok, label %exit_zero, label %check_failed");
    try append_line(out, "exit_one:");
    try append_line(out, "  %one_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %one_code");
    return;
}

fn append_cli_check_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "run_check:");
    try append_line(out, "  %check_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %manifest_ptr = getelementptr inbounds [18 x i8], ptr @.kizu.cli.manifest, i64 0, i64 0");
    try append_line(out, "  %manifest_base = insertvalue %kizu.slice.u8 poison, ptr %manifest_ptr, 0");
    try append_line(out, "  %manifest_slice = insertvalue %kizu.slice.u8 %manifest_base, i64 18, 1");
    try append_line(out,
        "  %manifest = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %check_io, %kizu.slice.u8 %manifest_slice)");
    try append_line(out, "  %manifest_ok = extractvalue %kizu.error.slice.u8 %manifest, 0");
    try append_line(out, "  br i1 %manifest_ok, label %read_sources, label %check_failed");
    try append_line(out, "read_sources:");
    try append_line(out,
        "  %source_ptr = getelementptr inbounds [12 x i8], ptr @.kizu.cli.source_dir, i64 0, i64 0");
    try append_line(out, "  %source_base = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out, "  %source_slice = insertvalue %kizu.slice.u8 %source_base, i64 12, 1");
    try append_line(out,
        "  %sources = call %kizu.error.owned @kizu_rt_fs_read_dir(%kizu.owned %check_io, %kizu.slice.u8 %source_slice)");
    try append_line(out, "  %sources_ok = extractvalue %kizu.error.owned %sources, 0");
    try append_line(out, "  br i1 %sources_ok, label %check_ok, label %check_failed");
    try append_line(out, "check_ok:");
    try append_line(out,
        "  %check_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out, "  %check_ok_base = insertvalue %kizu.slice.u8 poison, ptr %check_ok_ptr, 0");
    try append_line(out, "  %check_ok_slice = insertvalue %kizu.slice.u8 %check_ok_base, i64 10, 1");
    try append_line(out,
        "  %check_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %check_io, %kizu.slice.u8 %check_ok_slice)");
    try append_line(out, "  %check_write_ok = extractvalue %kizu.error.void %check_write, 0");
    try append_line(out, "  br i1 %check_write_ok, label %exit_zero, label %check_failed");
    try append_line(out, "exit_zero:");
    try append_line(out, "  %zero_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %zero_code");
    return;
}

fn append_cli_stage_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "run_stage:");
    try append_line(out, "  %stage_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_stage_copy(out, "ll", "root_ll_path", "27", "stage2_ll_path", "34");
    try append_stage_copy(out, "meta", "root_meta_path", "32", "stage2_meta_path", "39");
    try append_stage_copy(
        out,
        "storage",
        "root_storage_path",
        "35",
        "stage2_storage_path",
        "42"
    );
    try append_stage_copy(
        out,
        "storage_meta",
        "root_storage_meta_path",
        "40",
        "stage2_storage_meta_path",
        "47"
    );
    try append_stage_copy(out, "host", "root_host_path", "32", "stage2_host_path", "39");
    try append_stage_copy(
        out,
        "host_meta",
        "root_host_meta_path",
        "37",
        "stage2_host_meta_path",
        "44"
    );
    try append_stage_write(out, "stage_ok", "stage_ok", "10");
    try append_stage_write(out, "ll", "ll_path", "28");
    try append_stage_write(out, "meta", "meta_path", "33");
    try append_stage_write(out, "storage", "storage_path", "36");
    try append_stage_write(out, "storage_meta", "storage_meta_path", "41");
    try append_stage_write(out, "host", "host_path", "33");
    try append_stage_write(out, "host_meta", "host_meta_path", "38");
    try append_line(out, "  %stage_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %stage_code");
    return;
}

fn append_stage_copy(
    out: &var std::string::String,
    name: []u8,
    source: []u8,
    source_size: []u8,
    target: []u8,
    target_size: []u8
) -> !void {
    try append_global_slice(out, name, "source", source, source_size);
    try append_global_slice(out, name, "target", target, target_size);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_read = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_source_slice)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_bytes = extractvalue %kizu.error.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_read, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_copy = call %kizu.error.void @kizu_rt_fs_write_file(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_target_slice, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_bytes)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    name: []u8,
    role: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_stage_write(
    out: &var std::string::String,
    name: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_write = call %kizu.error.void @kizu_rt_io_write_stdout(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_slice)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_error_blocks(out: &var std::string::String) -> !void {
    try append_cli_error_block(out, "usage", "usage", "58");
    try append_cli_error_block(out, "unsupported", "unsupported", "29");
    try append_cli_error_block(out, "check_failed", "failed", "22");
    return;
}

fn append_cli_error_block(
    out: &var std::string::String,
    label: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes(label);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(label);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(label);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_write = call %kizu.error.void @kizu_rt_io_write_stderr(");
    try out.append_bytes("%kizu.owned %");
    try out.append_bytes(label);
    try out.append_bytes("_io, %kizu.slice.u8 %");
    try out.append_bytes(label);
    try out.append_bytes("_slice)");
    try out.append_byte(cast<u8>(10));
    if std::mem::equal_bytes(label, "check_failed") {
        try out.append_bytes("  %");
        try out.append_bytes(label);
        try out.append_bytes("_code = call i64 @kizu_rt_process_exit_code(i64 1)");
        try out.append_byte(cast<u8>(10));
    } else {
        try out.append_bytes("  %");
        try out.append_bytes(label);
        try out.append_bytes("_code = call i64 @kizu_rt_process_exit_code(i64 64)");
        try out.append_byte(cast<u8>(10));
    }
    try out.append_bytes("  ret i64 %");
    try out.append_bytes(label);
    try out.append_bytes("_code");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
