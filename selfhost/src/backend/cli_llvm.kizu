}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_slice_equal_function(out);
    try append_slice_contains_function(out);
    try append_slice_starts_with_dash_function(out);
    try append_cli_main_function(out);
    return;
}

fn append_slice_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_equal(");
    try append_line(out, "  %kizu.slice.u8 %left,");
    try append_line(out, "  %kizu.slice.u8 %right");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %left_len = extractvalue %kizu.slice.u8 %left, 1");
    try append_line(out, "  %right_len = extractvalue %kizu.slice.u8 %right, 1");
    try append_line(out, "  %same_len = icmp eq i64 %left_len, %right_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %left_len");
    try append_line(out, "  br i1 %done, label %true, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %left_ptr = extractvalue %kizu.slice.u8 %left, 0");
    try append_line(out, "  %right_ptr = extractvalue %kizu.slice.u8 %right, 0");
    try append_line(out, "  %left_at = getelementptr i8, ptr %left_ptr, i64 %index");
    try append_line(out, "  %right_at = getelementptr i8, ptr %right_ptr, i64 %index");
    try append_line(out, "  %left_byte = load i8, ptr %left_at");
    try append_line(out, "  %right_byte = load i8, ptr %right_at");
    try append_line(out, "  %same_byte = icmp eq i8 %left_byte, %right_byte");
    try append_line(out, "  br i1 %same_byte, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_contains_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_contains(");
    try append_line(out, "  %kizu.slice.u8 %haystack,");
    try append_line(out, "  %kizu.slice.u8 %needle");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %hay_len = extractvalue %kizu.slice.u8 %haystack, 1");
    try append_line(out, "  %needle_len = extractvalue %kizu.slice.u8 %needle, 1");
    try append_line(out, "  %needle_empty = icmp eq i64 %needle_len, 0");
    try append_line(out, "  br i1 %needle_empty, label %true, label %check_len");
    try append_line(out, "check_len:");
    try append_line(out, "  %fits = icmp sle i64 %needle_len, %hay_len");
    try append_line(out, "  br i1 %fits, label %prepare, label %false");
    try append_line(out, "prepare:");
    try append_line(out, "  %last_start = sub i64 %hay_len, %needle_len");
    try append_line(out, "  br label %outer");
    try append_line(out, "outer:");
    try append_line(out, "  %start = phi i64 [ 0, %prepare ], [ %next_start, %outer_advance ]");
    try append_line(out, "  %start_ok = icmp sle i64 %start, %last_start");
    try append_line(out, "  br i1 %start_ok, label %inner, label %false");
    try append_line(out, "inner:");
    try append_line(out, "  %index = phi i64 [ 0, %outer ], [ %next_index, %inner_advance ]");
    try append_line(out, "  %inner_done = icmp eq i64 %index, %needle_len");
    try append_line(out, "  br i1 %inner_done, label %true, label %compare");
    try append_line(out, "compare:");
    try append_line(out, "  %hay_ptr = extractvalue %kizu.slice.u8 %haystack, 0");
    try append_line(out, "  %needle_ptr = extractvalue %kizu.slice.u8 %needle, 0");
    try append_line(out, "  %hay_offset = add i64 %start, %index");
    try append_line(out, "  %hay_at = getelementptr i8, ptr %hay_ptr, i64 %hay_offset");
    try append_line(out, "  %needle_at = getelementptr i8, ptr %needle_ptr, i64 %index");
    try append_line(out, "  %hay_byte = load i8, ptr %hay_at");
    try append_line(out, "  %needle_byte = load i8, ptr %needle_at");
    try append_line(out, "  %same_byte = icmp eq i8 %hay_byte, %needle_byte");
    try append_line(out, "  br i1 %same_byte, label %inner_advance, label %outer_advance");
    try append_line(out, "inner_advance:");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %inner");
    try append_line(out, "outer_advance:");
    try append_line(out, "  %next_start = add i64 %start, 1");
    try append_line(out, "  br label %outer");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_starts_with_dash_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_starts_with_dash(");
    try append_line(out, "  %kizu.slice.u8 %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %value, 1");
    try append_line(out, "  %has_byte = icmp sgt i64 %len, 0");
    try append_line(out, "  br i1 %has_byte, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %value, 0");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_dash = icmp eq i8 %byte, 45");
    try append_line(out, "  ret i1 %is_dash");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_function(out: &var std::string::String) -> !void {
    try append_cli_main_header(out);
    try append_cli_main_dispatch(out);
    try append_cli_corpus_blocks(out);
    try append_cli_test_blocks(out);
    try append_cli_run_blocks(out);
    try append_cli_parse_blocks(out);
    try append_cli_check_blocks(out);
    try append_cli_stage_blocks(out);
    try append_cli_error_blocks(out);
    try append_line(out, "}");
    return;
}

fn append_cli_main_header(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %argc = call i64 @kizu_rt_process_arg_count()");
    try append_line(out, "  %argc_ok = icmp eq i64 %argc, 2");
    try append_line(out, "  br i1 %argc_ok, label %load_command, label %usage");
    try append_line(out, "load_command:");
    try append_line(out, "  %command_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 0)");
    try append_line(out, "  %command_ok = extractvalue %kizu.error.slice.u8 %command_result, 0");
    try append_line(out, "  br i1 %command_ok, label %load_target, label %check_failed");
    try append_line(out, "load_target:");
    try append_line(out, "  %target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out, "  %target_ok = extractvalue %kizu.error.slice.u8 %target_result, 0");
    try append_line(out, "  br i1 %target_ok, label %dispatch, label %check_failed");
    return;
}

fn append_cli_main_dispatch(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch:");
    try append_line(out, "  %command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out, "  %target = extractvalue %kizu.error.slice.u8 %target_result, 1");
    try append_line(out,
        "  %command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %command)");
    try append_line(out, "  br i1 %command_is_flag, label %usage, label %check_target_flag");
    try append_line(out, "check_target_flag:");
    try append_line(out,
        "  %target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %target)");
    try append_line(out, "  br i1 %target_is_flag, label %usage, label %maybe_test");
    try append_line(out, "maybe_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.test, i64 0, i64 0");
    try append_line(out, "  %test_base = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test_base, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %dispatch_test, label %maybe_run");
    try append_line(out, "maybe_run:");
    try append_line(out,
        "  %run_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.run, i64 0, i64 0");
    try append_line(out, "  %run_base = insertvalue %kizu.slice.u8 poison, ptr %run_ptr, 0");
    try append_line(out, "  %run_slice = insertvalue %kizu.slice.u8 %run_base, i64 3, 1");
    try append_line(out,
        "  %is_run = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %run_slice)");
    try append_line(out, "  br i1 %is_run, label %dispatch_run, label %maybe_parse");
    try append_line(out, "maybe_parse:");
    try append_line(out,
        "  %parse_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.parse, i64 0, i64 0");
    try append_line(out, "  %parse_base = insertvalue %kizu.slice.u8 poison, ptr %parse_ptr, 0");
    try append_line(out, "  %parse_slice = insertvalue %kizu.slice.u8 %parse_base, i64 5, 1");
    try append_line(out,
        "  %is_parse = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %parse_slice)");
    try append_line(out, "  br i1 %is_parse, label %dispatch_parse, label %match_selfhost");
    try append_line(out, "match_selfhost:");
    try append_line(out,
        "  %selfhost_ptr = getelementptr inbounds [8 x i8], ptr @.kizu.cli.selfhost, i64 0, i64 0");
    try append_line(out, "  %selfhost_base = insertvalue %kizu.slice.u8 poison, ptr %selfhost_ptr, 0");
    try append_line(out, "  %selfhost_slice = insertvalue %kizu.slice.u8 %selfhost_base, i64 8, 1");
    try append_line(out,
        "  %target_matches = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %selfhost_slice)");
    try append_line(out, "  br i1 %target_matches, label %dispatch_command, label %dispatch_corpus");
    try append_line(out, "dispatch_command:");
    try append_line(out,
        "  %check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out, "  %check_base = insertvalue %kizu.slice.u8 poison, ptr %check_ptr, 0");
    try append_line(out, "  %check_slice = insertvalue %kizu.slice.u8 %check_base, i64 5, 1");
    try append_line(out,
        "  %is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %check_slice)");
    try append_line(out, "  br i1 %is_check, label %run_check, label %maybe_stage");
    try append_line(out, "maybe_stage:");
    try append_line(out,
        "  %stage_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.stage, i64 0, i64 0");
    try append_line(out, "  %stage_base = insertvalue %kizu.slice.u8 poison, ptr %stage_ptr, 0");
    try append_line(out, "  %stage_slice = insertvalue %kizu.slice.u8 %stage_base, i64 5, 1");
    try append_line(out,
        "  %is_stage = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %stage_slice)");
    try append_line(out, "  br i1 %is_stage, label %run_stage, label %unsupported");
    return;
}

