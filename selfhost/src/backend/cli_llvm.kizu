    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::backend::hosted::hosted_output_len",
        "kizu_selfhost__hosted_output_len",
        "%kizu.slice.u8 output_payload;i1 append_newline"
    );
    try append_source_reachable_compiled_functions(out, ir_bytes);
    try append_loader_reachable_compiled_functions(out, ir_bytes);
    try append_cli_main_function(out, ir_bytes);
    return;
}

fn append_source_reachable_compiled_functions(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    var emitted = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("is_source_code");
    try pending.append("is_frontend_source");
    try pending.append("module_path");
    try pending.append("is_absolute_name_for_file");
    var index = 0;
    while index < pending.len() {
        let local_name = try pending.get(index);
        if !(try compiled_closure_name_seen(&emitted, local_name)) {
            try append_source_compiled_function(out, ir_bytes, local_name);
            try collect_source_compiled_callees(ir_bytes, local_name, &var pending);
            try emitted.append(local_name);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn compiled_closure_name_seen(
    names: &std::array::Array<[]u8>,
    name: []u8
) -> !bool {
    var index = 0;
    while index < names.len() {
        let existing = try names.get(index);
        if std::mem::equal_bytes(existing, name) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

fn append_source_compiled_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    local_name: []u8
) -> !void {
    let function_name = try source_compiled_qualified_name(local_name);
    var params_spec = std::string::String(std::mem::page_allocator());
    defer params_spec.deinit();
    try compiled_abi_params::append_params_spec(&var params_spec, ir_bytes, function_name);
    if params_spec.len() == 0 {
        return error("source compiled closure: missing signature params");
    }
    let params_spec_bytes = params_spec.as_bytes();
    var llvm_symbol = std::string::String(std::mem::page_allocator());
    defer llvm_symbol.deinit();
    try compiled_signature::append_function_llvm_symbol(&var llvm_symbol, function_name);
    let llvm_symbol_bytes = llvm_symbol.as_bytes();
    try compiled_llvm::append_compiled_function_auto(
        out,
        ir_bytes,
        function_name,
        llvm_symbol_bytes,
        params_spec_bytes
    );
    return;
}

fn collect_source_compiled_callees(
    ir_bytes: []u8,
    local_name: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    let function_name = try source_compiled_qualified_name(local_name);
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    while sequence < count {
        let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
        if std::mem::equal_bytes(kind, "Call") {
            let callee = try ir_contract::body_call_callee_or_empty(
                ir_bytes,
                function_name,
                sequence
            );
            try collect_source_compiled_callee(callee, pending);
        }
        sequence = sequence + 1;
    }
    return;
}

fn collect_source_compiled_callee(
    callee: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    if std::mem::starts_with(callee, "std::mem::") {
        return;
    }
    if std::mem::starts_with(callee, "selfhost::source::") {
        let prefix = "selfhost::source::";
        let local = callee[std::mem::len(prefix)..std::mem::len(callee)];
        if !source_compiled_supported_local(local) {
            return error("source compiled closure: unsupported local helper");
        }
        try pending.append(local);
        return;
    }
    if source_compiled_supported_local(callee) {
        try pending.append(callee);
        return;
    }
    return error("source compiled closure: unsupported callee");
}

fn source_compiled_supported_local(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "is_source_code") or
        std::mem::equal_bytes(name, "is_frontend_source") or
        std::mem::equal_bytes(name, "module_path") or
        std::mem::equal_bytes(name, "is_absolute_name_for_file") or
        std::mem::equal_bytes(name, "starts_with_package_prefix");
}

fn source_compiled_qualified_name(local_name: []u8) -> ![]u8 {
    if std::mem::equal_bytes(local_name, "is_source_code") {
        return "selfhost::source::is_source_code";
    }
    if std::mem::equal_bytes(local_name, "is_frontend_source") {
        return "selfhost::source::is_frontend_source";
    }
    if std::mem::equal_bytes(local_name, "module_path") {
        return "selfhost::source::module_path";
    }
    if std::mem::equal_bytes(local_name, "is_absolute_name_for_file") {
        return "selfhost::source::is_absolute_name_for_file";
    }
    if std::mem::equal_bytes(local_name, "starts_with_package_prefix") {
        return "selfhost::source::starts_with_package_prefix";
    }
    return error("source compiled closure: unsupported local helper");
}

fn append_kizu_lexer_reachable_compiled_functions(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    var emitted = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("first_token");
    try pending.append("next_token");
    var index = 0;
    while index < pending.len() {
        let local_name = try pending.get(index);
        if !(try compiled_closure_name_seen(&emitted, local_name)) {
            try append_kizu_lexer_compiled_function(out, ir_bytes, local_name);
            try collect_kizu_lexer_compiled_callees(ir_bytes, local_name, &var pending);
            try emitted.append(local_name);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn append_kizu_lexer_compiled_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    local_name: []u8
) -> !void {
    let function_name = try kizu_lexer_compiled_qualified_name(local_name);
    var params_spec = std::string::String(std::mem::page_allocator());
    defer params_spec.deinit();
    try compiled_abi_params::append_params_spec(&var params_spec, ir_bytes, function_name);
    if params_spec.len() == 0 {
        return error("std lexer compiled closure: missing signature params");
    }
    let params_spec_bytes = params_spec.as_bytes();
    var llvm_symbol = std::string::String(std::mem::page_allocator());
    defer llvm_symbol.deinit();
    try compiled_signature::append_function_llvm_symbol(&var llvm_symbol, function_name);
    let llvm_symbol_bytes = llvm_symbol.as_bytes();
    try compiled_llvm::append_compiled_function_auto(
        out,
        ir_bytes,
        function_name,
        llvm_symbol_bytes,
        params_spec_bytes
    );
    return;
}

fn collect_kizu_lexer_compiled_callees(
    ir_bytes: []u8,
    local_name: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    let function_name = try kizu_lexer_compiled_qualified_name(local_name);
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    while sequence < count {
        let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
        if std::mem::equal_bytes(kind, "Call") {
            let callee = try ir_contract::body_call_callee_or_empty(
                ir_bytes,
                function_name,
                sequence
            );
            try collect_kizu_lexer_compiled_callee(callee, pending);
        }
        sequence = sequence + 1;
    }
    return;
}

fn collect_kizu_lexer_compiled_callee(
    callee: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    if std::mem::starts_with(callee, "std::mem::") {
        return;
    }
    if std::mem::starts_with(callee, "std::kizu::lexer::") {
        let prefix = "std::kizu::lexer::";
        let local = callee[std::mem::len(prefix)..std::mem::len(callee)];
        if !kizu_lexer_compiled_supported_local(local) {
            return error("std lexer compiled closure: unsupported local helper");
        }
        try pending.append(local);
        return;
    }
    if std::mem::starts_with(callee, "std::kizu::") {
        return error("std lexer compiled closure: unsupported std callee");
    }
    if kizu_lexer_compiled_supported_local(callee) {
        try pending.append(callee);
        return;
    }
    return error("std lexer compiled closure: unsupported callee");
}

fn kizu_lexer_compiled_supported_local(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "position") or
        std::mem::equal_bytes(name, "is_alpha") or
        std::mem::equal_bytes(name, "is_digit") or
        std::mem::equal_bytes(name, "is_word") or
        std::mem::equal_bytes(name, "is_space") or
        std::mem::equal_bytes(name, "advance_byte") or
        std::mem::equal_bytes(name, "advance_position") or
        std::mem::equal_bytes(name, "token") or
        std::mem::equal_bytes(name, "attach_doc") or
        std::mem::equal_bytes(name, "number_token") or
        std::mem::equal_bytes(name, "string_token") or
        std::mem::equal_bytes(name, "skip_line_comment") or
        std::mem::equal_bytes(name, "is_doc_comment_start") or
        std::mem::equal_bytes(name, "word_token") or
        std::mem::equal_bytes(name, "raw_token_at") or
        std::mem::equal_bytes(name, "token_at") or
        std::mem::equal_bytes(name, "first_token") or
        std::mem::equal_bytes(name, "next_token");
}

