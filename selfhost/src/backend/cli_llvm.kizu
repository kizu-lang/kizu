    try append_line(out, "break_node:");
    try append_line(out, "  br i1 %want_continue, label %unsupported, label %break_label");
    try append_line(out, "break_label:");
    try append_line(out, "  %break_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %break_slot, align 8");
    try append_line(out, "  %break_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %break_slot, i32 0, i32 1");
    try append_line(out, "  %break_payload = load %kizu.kizu.ast.break_node, ptr %break_payload_ptr, align 8");
    try append_line(out, "  %break_label_id = extractvalue %kizu.kizu.ast.break_node %break_payload, 0");
    try append_line(out,
        "  %break_ok = call i1 @kizu_selfhost__ir_codegen_is_empty_node(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %break_label_id)");
    try append_line(out, "  ret i1 %break_ok");
