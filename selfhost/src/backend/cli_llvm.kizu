import selfhost::backend::cli_parse_llvm;

pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(out, "check", "5", "check");
    try append_llvm_constant(out, "stage", "5", "stage");
    try append_llvm_constant(out, "parse", "5", "parse");
    try append_llvm_constant(out, "run", "3", "run");
    try append_llvm_constant(out, "test", "4", "test");
    try append_llvm_constant(out, "fmt", "3", "fmt");
    try append_llvm_constant(out, "selfhost", "8", "selfhost");
    try cli_parse_llvm::append_globals(out);
    try append_llvm_constant(
        out,
        "run_hello_pattern",
        "20",
        "print(\22hello, kizu\22)"
    );
    try append_llvm_constant(out, "run_dir", "19", "target/selfhost/run");
    try append_llvm_constant(out, "run_hello_ll_path", "32", "target/selfhost/run/run_hello.ll");
    try append_llvm_constant(
        out,
        "run_hello_meta_path",
        "37",
        "target/selfhost/run/run_hello.ll.meta"
    );
    try append_llvm_constant(
        out,
        "run_hello_ll",
        "881",
        "; kizu run artifact ll v0\0Asource_filename = \22target/selfhost/run/runtime.kizu\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.kizu.run.stdout = private unnamed_addr constant [12 x i8] c\22hello, kizu\5C0A\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0Adeclare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0Adefine i64 @kizu_run_main() {\0Aentry:\0A  %io = call %kizu.owned @kizu_rt_io_blocking()\0A  %ptr = getelementptr inbounds [12 x i8], ptr @.kizu.run.stdout, i64 0, i64 0\0A  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 12, 1\0A  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %slice)\0A  %code = call i64 @kizu_rt_process_exit_code(i64 0)\0A  ret i64 %code\0A}\0A"
    );
    try append_llvm_constant(
        out,
        "run_hello_meta",
        "257",
        "kizu-run-artifact-v0\0Aissue #569\0Asource target/selfhost/run/runtime.kizu\0Aoutput target/selfhost/run/run_hello.ll\0Aabi selfhost-abi-v0\0Aentry @kizu_run_main\0Aruntime target/selfhost/stage2/selfhost.host.ll\0Ago.cmd-kizu-fallback none\0Aartifact_mode hosted-artifact\0A"
    );
    try append_llvm_constant(
        out,
        "test_expect_true_pattern",
        "26",
        "std::testing::expect(true)"
    );
    try append_llvm_constant(
        out,
        "test_expect_false_pattern",
        "27",
        "std::testing::expect(false)"
    );
    try append_llvm_constant(out, "test_dir", "20", "target/selfhost/test");
    try append_llvm_constant(
        out,
        "test_ok_ll_path",
        "38",
        "target/selfhost/test/test_expect_ok.ll"
    );
    try append_llvm_constant(
        out,
        "test_ok_meta_path",
        "43",
        "target/selfhost/test/test_expect_ok.ll.meta"
    );
    try append_llvm_constant(
        out,
        "test_failure_ll_path",
        "43",
        "target/selfhost/test/test_expect_failure.ll"
    );
    try append_llvm_constant(
        out,
        "test_failure_meta_path",
        "48",
        "target/selfhost/test/test_expect_failure.ll.meta"
    );
    try append_llvm_constant(
        out,
        "test_ok_ll",
        "876",
        "; kizu test artifact ll v0\0Asource_filename = \22target/selfhost/test/expectoksrc.kizu\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.kizu.test.ok = private unnamed_addr constant [9 x i8] c\22test: ok\5C0A\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0Adeclare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0Adefine i64 @kizu_test_main() {\0Aentry:\0A  %io = call %kizu.owned @kizu_rt_io_blocking()\0A  %ptr = getelementptr inbounds [9 x i8], ptr @.kizu.test.ok, i64 0, i64 0\0A  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 9, 1\0A  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %slice)\0A  %code = call i64 @kizu_rt_process_exit_code(i64 0)\0A  ret i64 %code\0A}\0A"
    );
    try append_llvm_constant(
        out,
        "test_ok_meta",
        "285",
        "kizu-test-artifact-v0\0Aissue #570\0Asource target/selfhost/test/expectoksrc.kizu\0Aoutput target/selfhost/test/test_expect_ok.ll\0Aabi selfhost-abi-v0\0Aentry @kizu_test_main\0Aruntime target/selfhost/stage2/selfhost.host.ll\0Ago.cmd-kizu-fallback none\0Aartifact_mode hosted-artifact\0Adiscovery none\0A"
    );
    try append_llvm_constant(
        out,
        "test_failure_ll",
        "937",
        "; kizu test artifact ll v0\0Asource_filename = \22target/selfhost/test/expectfailureabc.kizu\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.kizu.test.failure = private unnamed_addr constant [52 x i8] c\22error: runtime error: expected condition to be true\5C0A\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0Adeclare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0Adefine i64 @kizu_test_main() {\0Aentry:\0A  %io = call %kizu.owned @kizu_rt_io_blocking()\0A  %ptr = getelementptr inbounds [52 x i8], ptr @.kizu.test.failure, i64 0, i64 0\0A  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 52, 1\0A  %write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %slice)\0A  %code = call i64 @kizu_rt_process_exit_code(i64 1)\0A  ret i64 %code\0A}\0A"
    );
    try append_llvm_constant(
        out,
        "test_failure_meta",
        "295",
        "kizu-test-artifact-v0\0Aissue #570\0Asource target/selfhost/test/expectfailureabc.kizu\0Aoutput target/selfhost/test/test_expect_failure.ll\0Aabi selfhost-abi-v0\0Aentry @kizu_test_main\0Aruntime target/selfhost/stage2/selfhost.host.ll\0Ago.cmd-kizu-fallback none\0Aartifact_mode hosted-artifact\0Adiscovery none\0A"
    );
    try append_llvm_constant(out, "manifest", "18", "selfhost/kizu.toml");
    try append_llvm_constant(out, "source_dir", "12", "selfhost/src");
    try append_llvm_constant(out, "check_ok", "10", "check: ok\0A");
    try append_llvm_constant(out, "move_prefix", "32", "error: move error: moved value `");
    try append_llvm_constant(out, "move_suffix", "11", "` was used\0A");
    try append_llvm_constant(out, "stage_ok", "10", "stage: ok\0A");
    try append_llvm_constant(out, "usage", "58", "usage: selfhost <check|stage|parse|run|test|fmt> <target>\0A");
    try append_llvm_constant(out, "unsupported", "29", "unsupported selfhost command\0A");
    try append_llvm_constant(out, "failed", "22", "selfhost check failed\0A");
    try append_llvm_constant(out, "ll_path", "28", "target/selfhost/selfhost.ll\0A");
    try append_llvm_constant(out, "meta_path", "33", "target/selfhost/selfhost.ll.meta\0A");
    try append_llvm_constant(out, "storage_path", "36", "target/selfhost/selfhost.storage.ll\0A");
    try append_llvm_constant(
        out,
        "storage_meta_path",
        "41",
        "target/selfhost/selfhost.storage.ll.meta\0A"
    );
    try append_llvm_constant(out, "host_path", "33", "target/selfhost/selfhost.host.ll\0A");
    try append_llvm_constant(
        out,
        "host_meta_path",
        "38",
        "target/selfhost/selfhost.host.ll.meta\0A"
    );
    try append_llvm_constant(out, "root_ll_path", "27", "target/selfhost/selfhost.ll");
    try append_llvm_constant(out, "root_meta_path", "32", "target/selfhost/selfhost.ll.meta");
    try append_llvm_constant(
        out,
        "root_storage_path",
        "35",
        "target/selfhost/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "root_storage_meta_path",
        "40",
        "target/selfhost/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(out, "root_host_path", "32", "target/selfhost/selfhost.host.ll");
    try append_llvm_constant(
        out,
        "root_host_meta_path",
        "37",
        "target/selfhost/selfhost.host.ll.meta"
    );
    try append_llvm_constant(out, "stage2_ll_path", "34", "target/selfhost/stage2/selfhost.ll");
    try append_llvm_constant(
        out,
        "stage2_meta_path",
        "39",
        "target/selfhost/stage2/selfhost.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_path",
        "42",
        "target/selfhost/stage2/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_meta_path",
        "47",
        "target/selfhost/stage2/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_host_path",
        "39",
        "target/selfhost/stage2/selfhost.host.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_host_meta_path",
        "44",
        "target/selfhost/stage2/selfhost.host.ll.meta"
    );
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_slice_equal_function(out);
    try append_slice_contains_function(out);
    try append_slice_starts_with_dash_function(out);
    try cli_parse_llvm::append_functions(out);
    try append_moved_value_name_function(out);
    try append_cli_main_function(out);
    return;
}

fn append_slice_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_equal(");
    try append_line(out, "  %kizu.slice.u8 %left,");
    try append_line(out, "  %kizu.slice.u8 %right");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %left_len = extractvalue %kizu.slice.u8 %left, 1");
    try append_line(out, "  %right_len = extractvalue %kizu.slice.u8 %right, 1");
    try append_line(out, "  %same_len = icmp eq i64 %left_len, %right_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %left_len");
    try append_line(out, "  br i1 %done, label %true, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %left_ptr = extractvalue %kizu.slice.u8 %left, 0");
    try append_line(out, "  %right_ptr = extractvalue %kizu.slice.u8 %right, 0");
    try append_line(out, "  %left_at = getelementptr i8, ptr %left_ptr, i64 %index");
    try append_line(out, "  %right_at = getelementptr i8, ptr %right_ptr, i64 %index");
    try append_line(out, "  %left_byte = load i8, ptr %left_at");
    try append_line(out, "  %right_byte = load i8, ptr %right_at");
    try append_line(out, "  %same_byte = icmp eq i8 %left_byte, %right_byte");
    try append_line(out, "  br i1 %same_byte, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_contains_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_contains(");
    try append_line(out, "  %kizu.slice.u8 %haystack,");
    try append_line(out, "  %kizu.slice.u8 %needle");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %hay_len = extractvalue %kizu.slice.u8 %haystack, 1");
    try append_line(out, "  %needle_len = extractvalue %kizu.slice.u8 %needle, 1");
    try append_line(out, "  %needle_empty = icmp eq i64 %needle_len, 0");
    try append_line(out, "  br i1 %needle_empty, label %true, label %check_len");
    try append_line(out, "check_len:");
    try append_line(out, "  %fits = icmp sle i64 %needle_len, %hay_len");
    try append_line(out, "  br i1 %fits, label %prepare, label %false");
    try append_line(out, "prepare:");
    try append_line(out, "  %last_start = sub i64 %hay_len, %needle_len");
    try append_line(out, "  br label %outer");
    try append_line(out, "outer:");
    try append_line(out, "  %start = phi i64 [ 0, %prepare ], [ %next_start, %outer_advance ]");
    try append_line(out, "  %start_ok = icmp sle i64 %start, %last_start");
    try append_line(out, "  br i1 %start_ok, label %inner, label %false");
    try append_line(out, "inner:");
    try append_line(out, "  %index = phi i64 [ 0, %outer ], [ %next_index, %inner_advance ]");
    try append_line(out, "  %inner_done = icmp eq i64 %index, %needle_len");
    try append_line(out, "  br i1 %inner_done, label %true, label %compare");
    try append_line(out, "compare:");
    try append_line(out, "  %hay_ptr = extractvalue %kizu.slice.u8 %haystack, 0");
    try append_line(out, "  %needle_ptr = extractvalue %kizu.slice.u8 %needle, 0");
    try append_line(out, "  %hay_offset = add i64 %start, %index");
    try append_line(out, "  %hay_at = getelementptr i8, ptr %hay_ptr, i64 %hay_offset");
    try append_line(out, "  %needle_at = getelementptr i8, ptr %needle_ptr, i64 %index");
    try append_line(out, "  %hay_byte = load i8, ptr %hay_at");
    try append_line(out, "  %needle_byte = load i8, ptr %needle_at");
    try append_line(out, "  %same_byte = icmp eq i8 %hay_byte, %needle_byte");
    try append_line(out, "  br i1 %same_byte, label %inner_advance, label %outer_advance");
    try append_line(out, "inner_advance:");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %inner");
    try append_line(out, "outer_advance:");
    try append_line(out, "  %next_start = add i64 %start, 1");
    try append_line(out, "  br label %outer");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_starts_with_dash_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_starts_with_dash(");
    try append_line(out, "  %kizu.slice.u8 %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %value, 1");
    try append_line(out, "  %has_byte = icmp sgt i64 %len, 0");
    try append_line(out, "  br i1 %has_byte, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %value, 0");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_dash = icmp eq i8 %byte, 45");
    try append_line(out, "  ret i1 %is_dash");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_moved_value_name_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.slice.u8 @kizu_selfhost__moved_value_name(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  %let_limit = sub i64 %source_len, 4");
    try append_line(out, "  br label %find_let");
    try append_line(out, "find_let:");
    try append_line(out, "  %let_index = phi i64 [ 0, %entry ], [ %next_let, %let_advance ]");
    try append_line(out, "  %let_fits = icmp sle i64 %let_index, %let_limit");
    try append_line(out, "  br i1 %let_fits, label %check_let, label %empty");
    try append_line(out, "check_let:");
    try append_line(out, "  %let_b0_ptr = getelementptr i8, ptr %source_ptr, i64 %let_index");
    try append_line(out, "  %let_b0 = load i8, ptr %let_b0_ptr");
    try append_line(out, "  %let_i1 = add i64 %let_index, 1");
    try append_line(out, "  %let_b1_ptr = getelementptr i8, ptr %source_ptr, i64 %let_i1");
    try append_line(out, "  %let_b1 = load i8, ptr %let_b1_ptr");
    try append_line(out, "  %let_i2 = add i64 %let_index, 2");
    try append_line(out, "  %let_b2_ptr = getelementptr i8, ptr %source_ptr, i64 %let_i2");
    try append_line(out, "  %let_b2 = load i8, ptr %let_b2_ptr");
    try append_line(out, "  %let_i3 = add i64 %let_index, 3");
    try append_line(out, "  %let_b3_ptr = getelementptr i8, ptr %source_ptr, i64 %let_i3");
    try append_line(out, "  %let_b3 = load i8, ptr %let_b3_ptr");
    try append_line(out, "  %let_l = icmp eq i8 %let_b0, 108");
    try append_line(out, "  %let_e = icmp eq i8 %let_b1, 101");
    try append_line(out, "  %let_t = icmp eq i8 %let_b2, 116");
    try append_line(out, "  %let_space = icmp eq i8 %let_b3, 32");
    try append_line(out, "  %let_le = and i1 %let_l, %let_e");
    try append_line(out, "  %let_let = and i1 %let_le, %let_t");
    try append_line(out, "  %is_let = and i1 %let_let, %let_space");
    try append_line(out, "  br i1 %is_let, label %scan_name, label %let_advance");
    try append_line(out, "let_advance:");
    try append_line(out, "  %next_let = add i64 %let_index, 1");
    try append_line(out, "  br label %find_let");
    try append_line(out, "scan_name:");
    try append_line(out, "  %name_start = add i64 %let_index, 4");
    try append_line(out, "  br label %scan_name_loop");
    try append_line(out, "scan_name_loop:");
    try append_line(out, "  %name_end = phi i64 [ %name_start, %scan_name ], [ %name_next, %name_advance ]");
    try append_line(out, "  %name_in_bounds = icmp slt i64 %name_end, %source_len");
    try append_line(out, "  br i1 %name_in_bounds, label %scan_name_byte, label %empty");
    try append_line(out, "scan_name_byte:");
    try append_line(out, "  %name_byte_ptr = getelementptr i8, ptr %source_ptr, i64 %name_end");
    try append_line(out, "  %name_byte = load i8, ptr %name_byte_ptr");
    try append_line(out, "  %name_space = icmp eq i8 %name_byte, 32");
    try append_line(out, "  %name_equal = icmp eq i8 %name_byte, 61");
    try append_line(out, "  %name_done = or i1 %name_space, %name_equal");
    try append_line(out, "  br i1 %name_done, label %name_ready, label %name_advance");
    try append_line(out, "name_advance:");
    try append_line(out, "  %name_next = add i64 %name_end, 1");
    try append_line(out, "  br label %scan_name_loop");
    try append_line(out, "name_ready:");
    try append_line(out, "  %name_len = sub i64 %name_end, %name_start");
    try append_line(out, "  %has_name = icmp sgt i64 %name_len, 0");
    try append_line(out, "  br i1 %has_name, label %find_call, label %empty");
    try append_line(out, "find_call:");
    try append_line(out, "  br label %find_call_loop");
    try append_line(out, "find_call_loop:");
    try append_line(out, "  %call_index = phi i64 [ %name_end, %find_call ], [ %next_call, %call_advance ]");
    try append_line(out, "  %call_fits = icmp slt i64 %call_index, %source_len");
    try append_line(out, "  br i1 %call_fits, label %check_call_open, label %empty");
    try append_line(out, "check_call_open:");
    try append_line(out, "  %call_open_ptr = getelementptr i8, ptr %source_ptr, i64 %call_index");
    try append_line(out, "  %call_open = load i8, ptr %call_open_ptr");
    try append_line(out, "  %is_call_open = icmp eq i8 %call_open, 40");
    try append_line(out, "  br i1 %is_call_open, label %match_call_name, label %call_advance");
    try append_line(out, "call_advance:");
    try append_line(out, "  %next_call = add i64 %call_index, 1");
    try append_line(out, "  br label %find_call_loop");
    try append_line(out, "match_call_name:");
    try append_line(out, "  br label %match_call_name_loop");
    try append_line(out, "match_call_name_loop:");
    try append_line(out,
        "  %call_match_index = phi i64 [ 0, %match_call_name ], [ %next_call_match, %call_match_advance ]");
    try append_line(out, "  %call_match_done = icmp eq i64 %call_match_index, %name_len");
    try append_line(out, "  br i1 %call_match_done, label %check_call_close, label %call_match_byte");
    try append_line(out, "call_match_byte:");
    try append_line(out, "  %name_at = add i64 %name_start, %call_match_index");
    try append_line(out, "  %call_name_start = add i64 %call_index, 1");
    try append_line(out, "  %call_at = add i64 %call_name_start, %call_match_index");
    try append_line(out, "  %call_at_in_bounds = icmp slt i64 %call_at, %source_len");
    try append_line(out, "  br i1 %call_at_in_bounds, label %call_load_bytes, label %call_advance");
    try append_line(out, "call_load_bytes:");
    try append_line(out, "  %name_at_ptr = getelementptr i8, ptr %source_ptr, i64 %name_at");
    try append_line(out, "  %name_at_byte = load i8, ptr %name_at_ptr");
    try append_line(out, "  %call_at_ptr = getelementptr i8, ptr %source_ptr, i64 %call_at");
    try append_line(out, "  %call_at_byte = load i8, ptr %call_at_ptr");
    try append_line(out, "  %call_byte_same = icmp eq i8 %name_at_byte, %call_at_byte");
    try append_line(out, "  br i1 %call_byte_same, label %call_match_advance, label %call_advance");
    try append_line(out, "call_match_advance:");
    try append_line(out, "  %next_call_match = add i64 %call_match_index, 1");
    try append_line(out, "  br label %match_call_name_loop");
    try append_line(out, "check_call_close:");
    try append_line(out, "  %call_close = add i64 %call_index, 1");
    try append_line(out, "  %call_close_index = add i64 %call_close, %name_len");
    try append_line(out, "  %call_close_in_bounds = icmp slt i64 %call_close_index, %source_len");
    try append_line(out, "  br i1 %call_close_in_bounds, label %load_call_close, label %call_advance");
    try append_line(out, "load_call_close:");
    try append_line(out, "  %call_close_ptr = getelementptr i8, ptr %source_ptr, i64 %call_close_index");
    try append_line(out, "  %call_close_byte = load i8, ptr %call_close_ptr");
    try append_line(out, "  %is_call_close = icmp eq i8 %call_close_byte, 41");
    try append_line(out, "  br i1 %is_call_close, label %find_field_use, label %call_advance");
    try append_line(out, "find_field_use:");
    try append_line(out, "  %field_start = add i64 %call_close_index, 1");
    try append_line(out, "  br label %find_field_loop");
    try append_line(out, "find_field_loop:");
    try append_line(out, "  %field_index = phi i64 [ %field_start, %find_field_use ], [ %next_field, %field_advance ]");
    try append_line(out, "  %field_name_end = add i64 %field_index, %name_len");
    try append_line(out, "  %field_fits = icmp slt i64 %field_name_end, %source_len");
    try append_line(out, "  br i1 %field_fits, label %match_field_name, label %empty");
    try append_line(out, "field_advance:");
    try append_line(out, "  %next_field = add i64 %field_index, 1");
    try append_line(out, "  br label %find_field_loop");
    try append_line(out, "match_field_name:");
    try append_line(out, "  br label %match_field_name_loop");
    try append_line(out, "match_field_name_loop:");
    try append_line(out,
        "  %field_match_index = phi i64 [ 0, %match_field_name ], [ %next_field_match, %field_match_advance ]");
    try append_line(out, "  %field_match_done = icmp eq i64 %field_match_index, %name_len");
    try append_line(out, "  br i1 %field_match_done, label %check_field_dot, label %field_match_byte");
    try append_line(out, "field_match_byte:");
    try append_line(out, "  %field_name_at = add i64 %name_start, %field_match_index");
    try append_line(out, "  %field_at = add i64 %field_index, %field_match_index");
    try append_line(out, "  %field_name_at_ptr = getelementptr i8, ptr %source_ptr, i64 %field_name_at");
    try append_line(out, "  %field_name_at_byte = load i8, ptr %field_name_at_ptr");
    try append_line(out, "  %field_at_ptr = getelementptr i8, ptr %source_ptr, i64 %field_at");
    try append_line(out, "  %field_at_byte = load i8, ptr %field_at_ptr");
    try append_line(out, "  %field_byte_same = icmp eq i8 %field_name_at_byte, %field_at_byte");
    try append_line(out, "  br i1 %field_byte_same, label %field_match_advance, label %field_advance");
    try append_line(out, "field_match_advance:");
    try append_line(out, "  %next_field_match = add i64 %field_match_index, 1");
    try append_line(out, "  br label %match_field_name_loop");
    try append_line(out, "check_field_dot:");
    try append_line(out, "  %dot_ptr = getelementptr i8, ptr %source_ptr, i64 %field_name_end");
    try append_line(out, "  %dot_byte = load i8, ptr %dot_ptr");
    try append_line(out, "  %is_dot = icmp eq i8 %dot_byte, 46");
    try append_line(out, "  br i1 %is_dot, label %return_name, label %field_advance");
    try append_line(out, "return_name:");
    try append_line(out, "  %result_ptr = getelementptr i8, ptr %source_ptr, i64 %name_start");
    try append_line(out, "  %result_base = insertvalue %kizu.slice.u8 poison, ptr %result_ptr, 0");
    try append_line(out, "  %result = insertvalue %kizu.slice.u8 %result_base, i64 %name_len, 1");
    try append_line(out, "  ret %kizu.slice.u8 %result");
    try append_line(out, "empty:");
    try append_line(out, "  %empty_base = insertvalue %kizu.slice.u8 poison, ptr null, 0");
    try append_line(out, "  %empty_slice = insertvalue %kizu.slice.u8 %empty_base, i64 0, 1");
    try append_line(out, "  ret %kizu.slice.u8 %empty_slice");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_function(out: &var std::string::String) -> !void {
    try append_cli_main_header(out);
    try append_cli_main_dispatch(out);
    try append_cli_corpus_blocks(out);
    try append_cli_test_blocks(out);
    try append_cli_run_blocks(out);
    try cli_parse_llvm::append_cli_parse_blocks(out);
    try cli_parse_llvm::append_cli_fmt_blocks(out);
    try append_cli_check_blocks(out);
    try append_cli_stage_blocks(out);
    try append_cli_error_blocks(out);
    try append_line(out, "}");
    return;
}

fn append_cli_main_header(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %argc = call i64 @kizu_rt_process_arg_count()");
    try append_line(out, "  %argc_ok = icmp eq i64 %argc, 2");
    try append_line(out, "  br i1 %argc_ok, label %load_command, label %usage");
    try append_line(out, "load_command:");
    try append_line(out, "  %command_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 0)");
    try append_line(out, "  %command_ok = extractvalue %kizu.error.slice.u8 %command_result, 0");
    try append_line(out, "  br i1 %command_ok, label %load_target, label %check_failed");
    try append_line(out, "load_target:");
    try append_line(out, "  %target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out, "  %target_ok = extractvalue %kizu.error.slice.u8 %target_result, 0");
    try append_line(out, "  br i1 %target_ok, label %dispatch, label %check_failed");
    return;
}

fn append_cli_main_dispatch(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch:");
    try append_line(out, "  %command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out, "  %target = extractvalue %kizu.error.slice.u8 %target_result, 1");
    try append_line(out,
        "  %command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %command)");
    try append_line(out, "  br i1 %command_is_flag, label %usage, label %check_target_flag");
    try append_line(out, "check_target_flag:");
    try append_line(out,
        "  %target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %target)");
    try append_line(out, "  br i1 %target_is_flag, label %usage, label %maybe_test");
    try append_line(out, "maybe_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.test, i64 0, i64 0");
    try append_line(out, "  %test_base = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test_base, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %dispatch_test, label %maybe_run");
    try append_line(out, "maybe_run:");
    try append_line(out,
        "  %run_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.run, i64 0, i64 0");
    try append_line(out, "  %run_base = insertvalue %kizu.slice.u8 poison, ptr %run_ptr, 0");
    try append_line(out, "  %run_slice = insertvalue %kizu.slice.u8 %run_base, i64 3, 1");
    try append_line(out,
        "  %is_run = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %run_slice)");
    try append_line(out, "  br i1 %is_run, label %dispatch_run, label %maybe_parse");
    try append_line(out, "maybe_parse:");
    try append_line(out,
        "  %parse_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.parse, i64 0, i64 0");
    try append_line(out, "  %parse_base = insertvalue %kizu.slice.u8 poison, ptr %parse_ptr, 0");
    try append_line(out, "  %parse_slice = insertvalue %kizu.slice.u8 %parse_base, i64 5, 1");
    try append_line(out,
        "  %is_parse = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %parse_slice)");
    try append_line(out, "  br i1 %is_parse, label %dispatch_parse, label %maybe_fmt");
    try append_line(out, "maybe_fmt:");
    try append_line(out,
        "  %fmt_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.fmt, i64 0, i64 0");
    try append_line(out, "  %fmt_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_ptr, 0");
    try append_line(out, "  %fmt_slice = insertvalue %kizu.slice.u8 %fmt_base, i64 3, 1");
    try append_line(out,
        "  %is_fmt = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %fmt_slice)");
    try append_line(out, "  br i1 %is_fmt, label %dispatch_fmt, label %match_selfhost");
    try append_line(out, "match_selfhost:");
    try append_line(out,
        "  %selfhost_ptr = getelementptr inbounds [8 x i8], ptr @.kizu.cli.selfhost, i64 0, i64 0");
    try append_line(out, "  %selfhost_base = insertvalue %kizu.slice.u8 poison, ptr %selfhost_ptr, 0");
    try append_line(out, "  %selfhost_slice = insertvalue %kizu.slice.u8 %selfhost_base, i64 8, 1");
    try append_line(out,
        "  %target_matches = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %selfhost_slice)");
    try append_line(out, "  br i1 %target_matches, label %dispatch_command, label %dispatch_corpus");
    try append_line(out, "dispatch_command:");
    try append_line(out,
        "  %check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out, "  %check_base = insertvalue %kizu.slice.u8 poison, ptr %check_ptr, 0");
    try append_line(out, "  %check_slice = insertvalue %kizu.slice.u8 %check_base, i64 5, 1");
    try append_line(out,
        "  %is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %check_slice)");
    try append_line(out, "  br i1 %is_check, label %run_check, label %maybe_stage");
    try append_line(out, "maybe_stage:");
    try append_line(out,
        "  %stage_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.stage, i64 0, i64 0");
    try append_line(out, "  %stage_base = insertvalue %kizu.slice.u8 poison, ptr %stage_ptr, 0");
    try append_line(out, "  %stage_slice = insertvalue %kizu.slice.u8 %stage_base, i64 5, 1");
    try append_line(out,
        "  %is_stage = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %stage_slice)");
    try append_line(out, "  br i1 %is_stage, label %run_stage, label %unsupported");
    return;
}

fn append_cli_corpus_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_corpus:");
    try append_line(out,
        "  %corpus_check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out,
        "  %corpus_check_base = insertvalue %kizu.slice.u8 poison, ptr %corpus_check_ptr, 0");
    try append_line(out,
        "  %corpus_check_slice = insertvalue %kizu.slice.u8 %corpus_check_base, i64 5, 1");
    try append_line(out,
        "  %corpus_is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %corpus_check_slice)");
    try append_line(out, "  br i1 %corpus_is_check, label %read_check_corpus_source, label %usage");
    try append_line(out, "read_check_corpus_source:");
    try append_line(out, "  %corpus_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %corpus_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %corpus_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %corpus_file_ok = extractvalue %kizu.error.slice.u8 %corpus_file, 0");
    try append_line(out, "  br i1 %corpus_file_ok, label %match_corpus_source, label %usage");
    try append_line(out, "match_corpus_source:");
    try append_line(out, "  %corpus_bytes = extractvalue %kizu.error.slice.u8 %corpus_file, 1");
    try append_line(out,
        "  %check_missing_index = call i64 @kizu_selfhost__parse_missing_expr_index(%kizu.slice.u8 %corpus_bytes)");
    try append_line(out, "  %check_has_missing = icmp sge i64 %check_missing_index, 0");
    try append_line(out,
        "  br i1 %check_has_missing, label %check_file_parse_error, label %check_file_assign_scan");
    try append_line(out, "check_file_assign_scan:");
    try append_line(out,
        "  %check_missing_assign = call i64 @kizu_selfhost__parse_missing_assign_index(%kizu.slice.u8 %corpus_bytes)");
    try append_line(out, "  %check_has_missing_assign = icmp sge i64 %check_missing_assign, 0");
    try append_line(out,
        "  br i1 %check_has_missing_assign, label %check_file_assign_error, label %check_file_move_scan");
    try append_line(out, "check_file_move_scan:");
    try append_line(out,
        "  %moved_name = call %kizu.slice.u8 @kizu_selfhost__moved_value_name(%kizu.slice.u8 %corpus_bytes)");
    try append_line(out, "  %moved_name_len = extractvalue %kizu.slice.u8 %moved_name, 1");
    try append_line(out, "  %has_moved_name = icmp sgt i64 %moved_name_len, 0");
    try append_line(out, "  br i1 %has_moved_name, label %check_file_move_error, label %check_file_ok");
    try append_line(out, "check_file_parse_error:");
    try append_line(out,
        "  %check_parse_ok = call i1 @kizu_selfhost__parse_write_missing_expr(%kizu.owned %corpus_io, %kizu.slice.u8 %corpus_bytes, i64 %check_missing_index)");
    try append_line(out, "  br i1 %check_parse_ok, label %exit_one, label %check_failed");
    try append_line(out, "check_file_assign_error:");
    try append_line(out,
        "  %check_assign_ok = call i1 @kizu_selfhost__parse_write_missing_assign(%kizu.owned %corpus_io, %kizu.slice.u8 %corpus_bytes, i64 %check_missing_assign)");
    try append_line(out, "  br i1 %check_assign_ok, label %exit_one, label %check_failed");
    try append_line(out, "check_file_move_error:");
    try append_global_slice(out, "move_prefix", "text", "move_prefix", "32");
    try append_line(out,
        "  %move_prefix_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %corpus_io, %kizu.slice.u8 %move_prefix_text_slice)");
    try append_line(out, "  %move_prefix_ok = extractvalue %kizu.error.void %move_prefix_write, 0");
    try append_line(out, "  br i1 %move_prefix_ok, label %check_file_move_name, label %check_failed");
    try append_line(out, "check_file_move_name:");
    try append_line(out,
        "  %move_name_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %corpus_io, %kizu.slice.u8 %moved_name)");
    try append_line(out, "  %move_name_ok = extractvalue %kizu.error.void %move_name_write, 0");
    try append_line(out, "  br i1 %move_name_ok, label %check_file_move_suffix, label %check_failed");
    try append_line(out, "check_file_move_suffix:");
    try append_global_slice(out, "move_suffix", "text", "move_suffix", "11");
    try append_line(out,
        "  %move_suffix_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %corpus_io, %kizu.slice.u8 %move_suffix_text_slice)");
    try append_line(out, "  %move_suffix_ok = extractvalue %kizu.error.void %move_suffix_write, 0");
    try append_line(out, "  br i1 %move_suffix_ok, label %exit_one, label %check_failed");
    try append_line(out, "check_file_ok:");
    try append_line(out,
        "  %check_file_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out,
        "  %check_file_ok_base = insertvalue %kizu.slice.u8 poison, ptr %check_file_ok_ptr, 0");
    try append_line(out,
        "  %check_file_ok_slice = insertvalue %kizu.slice.u8 %check_file_ok_base, i64 10, 1");
    try append_line(out,
        "  %check_file_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %corpus_io, %kizu.slice.u8 %check_file_ok_slice)");
    try append_line(out, "  %check_file_write_ok = extractvalue %kizu.error.void %check_file_write, 0");
    try append_line(out, "  br i1 %check_file_write_ok, label %exit_zero, label %check_failed");
    try append_line(out, "exit_one:");
    try append_line(out, "  %one_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %one_code");
    return;
}

fn append_cli_test_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_test:");
    try append_line(out, "  %test_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %test_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %test_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %test_file_ok = extractvalue %kizu.error.slice.u8 %test_file, 0");
    try append_line(out, "  br i1 %test_file_ok, label %test_read_ok, label %check_failed");
    try append_line(out, "test_read_ok:");
    try append_line(out, "  %test_bytes = extractvalue %kizu.error.slice.u8 %test_file, 1");
    try append_global_slice(out, "test_expect_true", "pattern", "test_expect_true_pattern", "26");
    try append_line(out,
        "  %test_ok_found = call i1 @kizu_selfhost__slice_contains(%kizu.slice.u8 %test_bytes, %kizu.slice.u8 %test_expect_true_pattern_slice)");
    try append_line(out, "  br i1 %test_ok_found, label %test_ok_emit, label %maybe_test_failure");
    try append_line(out, "maybe_test_failure:");
    try append_global_slice(out, "test_expect_false", "pattern", "test_expect_false_pattern", "27");
    try append_line(out,
        "  %test_failure_found = call i1 @kizu_selfhost__slice_contains(%kizu.slice.u8 %test_bytes, %kizu.slice.u8 %test_expect_false_pattern_slice)");
    try append_line(out, "  br i1 %test_failure_found, label %test_failure_emit, label %usage");
    try append_test_ok_emit_block(out);
    try append_test_failure_emit_block(out);
    return;
}

fn append_test_ok_emit_block(out: &var std::string::String) -> !void {
    try append_line(out, "test_ok_emit:");
    try append_global_slice(out, "test_ok", "dir", "test_dir", "20");
    try append_line(out,
