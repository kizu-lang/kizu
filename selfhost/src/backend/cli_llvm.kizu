    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.error.payload_span %");
    try out.append_bytes(result_name);
    try out.append_bytes("_fail2");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_print_payload_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let call_tag = try ast_data_tag(ir_bytes, "Call");
    let expr_stmt_tag = try ast_data_tag(ir_bytes, "ExprStmt");

    try append_line(out, "define %kizu.error.payload_span @kizu_selfhost__ir_codegen_print_call_payload(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %callee,");
    try append_line(out, "  %kizu.kizu.ast.child_range %args");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %callee_text = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee)");
    try append_line(out, "  %print_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.run_print, i64 0, i64 0");
    try append_line(out, "  %print_base = insertvalue %kizu.slice.u8 poison, ptr %print_ptr, 0");
    try append_line(out, "  %print_slice = insertvalue %kizu.slice.u8 %print_base, i64 5, 1");
    try append_line(out, "  %callee_ok = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %callee_text, %kizu.slice.u8 %print_slice)");
    try append_line(out, "  %args_len = extractvalue %kizu.kizu.ast.child_range %args, 1");
    try append_line(out, "  %one_arg = icmp eq i64 %args_len, 1");
    try append_line(out, "  %shape_ok = and i1 %callee_ok, %one_arg");
    try append_line(out, "  br i1 %shape_ok, label %load_arg, label %unsupported");
    try append_line(out, "load_arg:");
    try append_line(out, "  %arg_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %args, i64 0)");
    try append_line(out, "  %arg_ok = extractvalue %kizu.error.node_id %arg_result, 0");
    try append_line(out, "  br i1 %arg_ok, label %arg_bound, label %child_fail");
    try append_line(out, "arg_bound:");
    try append_line(out, "  %arg = extractvalue %kizu.error.node_id %arg_result, 1");
    try append_line(out, "  %payload = call %kizu.selfhost.codegen.payload_span @kizu_selfhost__ir_codegen_string_literal_span(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %arg)");
    try append_payload_span_success_return(out, "payload");
    try append_line(out, "child_fail:");
    try append_payload_span_child_fail_return(out, "arg_result");
    try append_line(out, "unsupported:");
    try append_empty_payload_span_success_return(out, "empty_call_payload");
    try append_line(out, "}");
    try append_line(out, "");

    try append_line(out, "define %kizu.error.payload_span @kizu_selfhost__ir_codegen_print_expr_payload(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %expr");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %expr)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_call = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, call_tag);
    try out.append_byte(cast<u8>(10));
