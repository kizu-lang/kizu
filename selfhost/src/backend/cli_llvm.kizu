    try append_line(out, "  %param_count = extractvalue %kizu.selfhost.codegen.program %program, 17");
    try append_line(out, "  %zero_params = icmp eq i64 %param_count, 0");
    try append_line(out, "  %exit_code = extractvalue %kizu.selfhost.codegen.program %program, 20");
    try append_line(out, "  %exit_success = icmp eq i64 %exit_code, 0");
    try append_line(out, "  %exit_failure = icmp eq i64 %exit_code, 1");
    try append_line(out, "  %exit_supported = or i1 %exit_success, %exit_failure");
    try append_line(out, "  %result = and i1 %zero_params, %exit_supported");
