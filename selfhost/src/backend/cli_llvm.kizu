pub fn append_globals(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_llvm_constant(out, "check", "5", "check");
    try append_llvm_constant(out, "stage", "5", "stage");
    try append_llvm_constant(out, "parse", "5", "parse");
    try append_llvm_constant(out, "run", "3", "run");
    try append_llvm_constant(out, "run_main", "4", "main");
    try append_llvm_constant(out, "run_entry", "5", "entry");
    try append_llvm_constant(out, "run_print", "5", "print");
    try append_llvm_constant(out, "std_io_blocking", "17", "std::io::blocking");
    try append_llvm_constant(out, "std_fs_read_file", "18", "std::fs::read_file");
    try append_llvm_constant(out, "error_union_void_type", "5", "!void");
    try append_llvm_constant(out, "error_call", "5", "error");
    try append_llvm_constant(out, "stdout_payload_error", "34", "unsupported codegen stdout payload");
    try append_llvm_constant(out, "test", "4", "test");
    try append_llvm_constant(out, "fmt", "3", "fmt");
    try append_llvm_constant(out, "fmt_write", "7", "--write");
    try append_llvm_constant(out, "fmt_write_short", "2", "-w");
    try append_llvm_constant(out, "selfhost", "8", "selfhost");
    try cli_artifact_dir_llvm::append_globals(out);
    try cli_ast_boundary_llvm::append_globals(out);
    try cli_codegen_llvm::append_globals(out, ir_bytes);
    try cli_parse_llvm::append_globals(out);
    try cli_run_llvm::append_globals(out, ir_bytes);
    try cli_run_i64_codegen_llvm::append_globals(out);
    try cli_test_ast_llvm::append_globals(out);
    try cli_test_llvm::append_globals(out, ir_bytes);
    try cli_hosted_metadata_llvm::append_output_prefix_constant(
        out,
        "artifact_output_prefix"
    );
    try append_llvm_constant(out, "manifest", "18", "selfhost/kizu.toml");
    try append_llvm_constant(out, "source_dir", "12", "selfhost/src");
    try append_llvm_constant(out, "check_ok", "10", "check: ok\0A");
    try append_llvm_constant(out, "move_prefix", "32", "error: move error: moved value `");
    try append_llvm_constant(out, "move_suffix", "10", "` was used");
    try append_llvm_constant(out, "undefined_prefix", "39", "error: type error: undefined variable `");
    try append_llvm_constant(out, "undefined_suffix", "1", "`");
    try append_llvm_constant(out, "parse_unexpected_token_prefix", "29", "error: unexpected token, got ");
    try append_llvm_constant(out, "parse_expected_right_paren", "27", "error: expected right paren");
    try append_llvm_constant(out, "parse_expected_right_brace", "27", "error: expected right brace");
    try append_llvm_constant(out, "parse_expected_right_bracket", "29", "error: expected right bracket");
    try append_llvm_constant(out, "stage_ok", "10", "stage: ok\0A");
    try append_llvm_constant(out, "usage", "58", "usage: selfhost <check|stage|parse|run|test|fmt> <target>\0A");
    try append_llvm_constant(out, "unsupported_run_codegen", "32", "unsupported run codegen program\0A");
    try append_llvm_constant(out, "unsupported", "29", "unsupported selfhost command\0A");
    try append_llvm_constant(out, "failed", "22", "selfhost check failed\0A");
    try append_llvm_constant(out, "ll_path", "28", "target/selfhost/selfhost.ll\0A");
    try append_llvm_constant(out, "meta_path", "33", "target/selfhost/selfhost.ll.meta\0A");
    try append_llvm_constant(out, "storage_path", "36", "target/selfhost/selfhost.storage.ll\0A");
    try append_llvm_constant(
        out,
        "storage_meta_path",
        "41",
        "target/selfhost/selfhost.storage.ll.meta\0A"
    );
    try append_llvm_constant(out, "host_path", "33", "target/selfhost/selfhost.host.ll\0A");
    try append_llvm_constant(
        out,
        "host_meta_path",
        "38",
        "target/selfhost/selfhost.host.ll.meta\0A"
    );
    try append_llvm_constant(out, "root_ll_path", "27", "target/selfhost/selfhost.ll");
    try append_llvm_constant(out, "root_meta_path", "32", "target/selfhost/selfhost.ll.meta");
    try append_llvm_constant(
        out,
        "root_storage_path",
        "35",
        "target/selfhost/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "root_storage_meta_path",
        "40",
        "target/selfhost/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(out, "root_host_path", "32", "target/selfhost/selfhost.host.ll");
    try append_llvm_constant(
        out,
        "root_host_meta_path",
        "37",
        "target/selfhost/selfhost.host.ll.meta"
    );
    try append_llvm_constant(out, "stage2_ll_path", "34", "target/selfhost/stage2/selfhost.ll");
    try append_llvm_constant(
        out,
        "stage2_meta_path",
        "39",
        "target/selfhost/stage2/selfhost.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_path",
        "42",
        "target/selfhost/stage2/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_meta_path",
        "47",
        "target/selfhost/stage2/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_host_path",
        "39",
        "target/selfhost/stage2/selfhost.host.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_host_meta_path",
        "44",
        "target/selfhost/stage2/selfhost.host.ll.meta"
    );
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_loop_binary_value_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_binary_value(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  i64 %actual_op,");
    try append_line(out, "  %kizu.kizu.ast.node_id %left,");
    try append_line(out, "  %kizu.kizu.ast.node_id %right,");
    try append_line(out, "  %kizu.slice.u8 %local_name,");
    try append_line(out, "  i64 %expected_op");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %op_ok = icmp eq i64 %actual_op, %expected_op");
    try append_line(out, "  br i1 %op_ok, label %check_left, label %unsupported");
    try append_line(out, "check_left:");
    try append_line(out,
        "  %left_ok = call i1 @kizu_selfhost__ir_codegen_node_text_is_var(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %left, %kizu.slice.u8 %local_name)");
    try append_line(out, "  br i1 %left_ok, label %parse_right, label %unsupported");
    try append_line(out, "parse_right:");
    try append_line(out,
        "  %right_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_call_arg_i64_literal(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %right)");
    try append_line(out, "  ret %kizu.error.i64 %right_result");
    try append_line(out, "unsupported:");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 -1, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_loop_var_int_binary_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let binary_tag = try ast_data_tag(ir_bytes, "Binary");
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_var_int_binary(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %node_id,");
    try append_line(out, "  %kizu.slice.u8 %local_name,");
    try append_line(out, "  i64 %op");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %node_id)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_binary = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, binary_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_binary, label %binary, label %unsupported");
    try append_line(out, "binary:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.binary_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %actual_op = extractvalue %kizu.kizu.ast.binary_node %payload, 0");
    try append_line(out, "  %left = extractvalue %kizu.kizu.ast.binary_node %payload, 1");
    try append_line(out, "  %right = extractvalue %kizu.kizu.ast.binary_node %payload, 2");
    try append_line(out,
        "  %result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_binary_value(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, i64 %actual_op, %kizu.kizu.ast.node_id %left, %kizu.kizu.ast.node_id %right, %kizu.slice.u8 %local_name, i64 %op)");
    try append_line(out, "  ret %kizu.error.i64 %result");
    try append_line(out, "unsupported:");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 -1, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_loop_assign_step_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let add_op = try ir_contract::enum_variant_tag(
        ir_bytes, "std::kizu::ast::BinaryOp", "Add"
    );
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_assign_step(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %target,");
    try append_line(out, "  %kizu.kizu.ast.node_id %value,");
    try append_line(out, "  %kizu.slice.u8 %local_name");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %target_ok = call i1 @kizu_selfhost__ir_codegen_node_text_is_var(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %target, %kizu.slice.u8 %local_name)");
    try append_line(out, "  br i1 %target_ok, label %check_value, label %unsupported");
    try append_line(out, "check_value:");
    try out.append_bytes("  %result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_var_int_binary(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %value, %kizu.slice.u8 %local_name, i64 ");
    try std::fmt::append_i64(out, add_op);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret %kizu.error.i64 %result");
    try append_line(out, "unsupported:");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 -1, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_loop_increment_step_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let assign_tag = try ast_data_tag(ir_bytes, "Assign");
    try append_line(out, "define %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_increment_step(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %statement,");
    try append_line(out, "  %kizu.slice.u8 %local_name");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_assign = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, assign_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_assign, label %assign, label %unsupported");
    try append_line(out, "assign:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.assign_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %target = extractvalue %kizu.kizu.ast.assign_node %payload, 0");
    try append_line(out, "  %value = extractvalue %kizu.kizu.ast.assign_node %payload, 1");
    try append_line(out,
        "  %result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_assign_step(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %target, %kizu.kizu.ast.node_id %value, %kizu.slice.u8 %local_name)");
    try append_line(out, "  ret %kizu.error.i64 %result");
    try append_line(out, "unsupported:");
    try append_line(out, "  %ok0 = insertvalue %kizu.error.i64 poison, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 -1, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_loop_terminal_statement_ok_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let continue_tag = try ast_data_tag(ir_bytes, "Continue");
    let break_tag = try ast_data_tag(ir_bytes, "Break");
    try append_line(out, "define i1 @kizu_selfhost__ir_codegen_loop_terminal_statement_ok(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %statement,");
    try append_line(out, "  i1 %want_continue");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_continue = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, continue_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_continue, label %continue_node, label %check_break");
    try append_line(out, "continue_node:");
    try append_line(out, "  br i1 %want_continue, label %continue_label, label %unsupported");
    try append_line(out, "continue_label:");
    try append_line(out, "  %continue_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %continue_slot, align 8");
    try append_line(out, "  %continue_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %continue_slot, i32 0, i32 1");
    try append_line(out, "  %continue_payload = load %kizu.kizu.ast.continue_node, ptr %continue_payload_ptr, align 8");
    try append_line(out, "  %continue_label_id = extractvalue %kizu.kizu.ast.continue_node %continue_payload, 0");
    try append_line(out,
        "  %continue_ok = call i1 @kizu_selfhost__ir_codegen_is_empty_node(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %continue_label_id)");
    try append_line(out, "  ret i1 %continue_ok");
    try append_line(out, "check_break:");
    try out.append_bytes("  %is_break = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, break_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_break, label %break_node, label %unsupported");
    try append_line(out, "break_node:");
    try append_line(out, "  br i1 %want_continue, label %unsupported, label %break_label");
    try append_line(out, "break_label:");
    try append_line(out, "  %break_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %break_slot, align 8");
    try append_line(out, "  %break_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %break_slot, i32 0, i32 1");
    try append_line(out, "  %break_payload = load %kizu.kizu.ast.break_node, ptr %break_payload_ptr, align 8");
    try append_line(out, "  %break_label_id = extractvalue %kizu.kizu.ast.break_node %break_payload, 0");
    try append_line(out,
        "  %break_ok = call i1 @kizu_selfhost__ir_codegen_is_empty_node(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %break_label_id)");
    try append_line(out, "  ret i1 %break_ok");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_loop_then_block_ok_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.bool @kizu_selfhost__ir_codegen_loop_then_block_ok(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.child_range %statements,");
    try append_line(out, "  i1 %want_continue");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.kizu.ast.child_range %statements, 1");
    try append_line(out, "  %one_statement = icmp eq i64 %len, 1");
    try append_line(out, "  br i1 %one_statement, label %read_child, label %false_value");
    try append_line(out, "read_child:");
    try append_line(out,
        "  %child_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %child_ok = extractvalue %kizu.error.node_id %child_result, 0");
    try append_line(out, "  br i1 %child_ok, label %check_terminal, label %child_failed");
    try append_line(out, "check_terminal:");
    try append_line(out, "  %child = extractvalue %kizu.error.node_id %child_result, 1");
    try append_line(out,
        "  %terminal_ok = call i1 @kizu_selfhost__ir_codegen_loop_terminal_statement_ok(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %child, i1 %want_continue)");
    try append_line(out, "  %success0 = insertvalue %kizu.error.bool poison, i1 true, 0");
    try append_line(out, "  %success1 = insertvalue %kizu.error.bool %success0, i1 %terminal_ok, 1");
    try append_line(out, "  %success2 = insertvalue %kizu.error.bool %success1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.bool %success2");
    try append_line(out, "false_value:");
    try append_line(out, "  %false0 = insertvalue %kizu.error.bool poison, i1 true, 0");
    try append_line(out, "  %false1 = insertvalue %kizu.error.bool %false0, i1 false, 1");
    try append_line(out, "  %false2 = insertvalue %kizu.error.bool %false1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.bool %false2");
    try append_line(out, "child_failed:");
    try append_line(out, "  %err = extractvalue %kizu.error.node_id %child_result, 2");
    try append_line(out, "  %fail0 = insertvalue %kizu.error.bool poison, i1 false, 0");
    try append_line(out, "  %fail1 = insertvalue %kizu.error.bool %fail0, i1 false, 1");
    try append_line(out, "  %fail2 = insertvalue %kizu.error.bool %fail1, %kizu.slice.u8 %err, 2");
    try append_line(out, "  ret %kizu.error.bool %fail2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_loop_then_terminal_ok_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
