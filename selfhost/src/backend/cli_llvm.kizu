    try append_line(out, "  %helper_len = extractvalue %kizu.slice.u8 %helper_name, 1");
    try append_line(out, "  %helper_present = icmp ne i64 %helper_len, 0");
    try append_line(out, "  %helper_match = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %helper_name, %kizu.slice.u8 %helper_callee)");
    try append_line(out, "  %helper_ok = and i1 %helper_present, %helper_match");
