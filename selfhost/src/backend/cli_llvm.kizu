        "  %then_result = call %kizu.error.bool @kizu_selfhost__ir_codegen_loop_then_terminal_ok(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %then_block, i1 %want_continue)");
    try append_line(out, "  %then_ok = extractvalue %kizu.error.bool %then_result, 0");
    try append_line(out, "  br i1 %then_ok, label %check_then_value, label %then_failed");
    try append_line(out, "check_then_value:");
