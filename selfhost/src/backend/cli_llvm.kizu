    }
    if std::mem::starts_with(callee, "selfhost::source::") {
        return error("loader compiled closure: unsupported source callee");
    }
    if loader_compiled_supported_local(callee) {
        try pending.append(callee);
        return;
    }
    return error("loader compiled closure: unsupported callee");
}

fn loader_compiled_supported_local(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "module_end_for") or
