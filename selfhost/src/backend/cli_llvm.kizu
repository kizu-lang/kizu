fn append_lower_loop_i64_while_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let lt_op = try ir_contract::enum_variant_tag(
        ir_bytes, "std::kizu::ast::BinaryOp", "LT"
    );
    let block_tag = try ast_data_tag(ir_bytes, "Block");
    try append_line(out, "define %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_loop_i64_while(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %function_name,");
    try append_line(out, "  i64 %statement_count,");
    try append_line(out, "  %kizu.slice.u8 %local_name,");
    try append_line(out, "  %kizu.kizu.ast.node_id %label,");
    try append_line(out, "  %kizu.kizu.ast.node_id %condition,");
    try append_line(out, "  %kizu.kizu.ast.node_id %body");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %label_empty = call i1 @kizu_selfhost__ir_codegen_is_empty_node(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %label)");
    try append_line(out, "  br i1 %label_empty, label %condition_bound, label %unsupported");
    try append_line(out, "condition_bound:");
    try out.append_bytes("  %bound_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_loop_var_int_binary(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %condition, %kizu.slice.u8 %local_name, i64 ");
    try std::fmt::append_i64(out, lt_op);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %bound_ok = extractvalue %kizu.error.i64 %bound_result, 0");
    try append_line(out, "  br i1 %bound_ok, label %check_bound, label %bound_fail");
    try append_line(out, "check_bound:");
    try append_line(out, "  %bound = extractvalue %kizu.error.i64 %bound_result, 1");
    try append_line(out, "  %bound_positive = icmp sgt i64 %bound, 0");
    try append_line(out, "  br i1 %bound_positive, label %check_body, label %unsupported");
    try append_line(out, "check_body:");
    try append_line(out, "  %loop_start = add i64 0, 1");
    try append_line(out, "  %loop_bound = add i64 %bound, 1");
    try append_line(out, "  %body_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %body)");
    try append_line(out, "  %body_data = extractvalue %kizu.kizu.ast.ast_node %body_node, 1");
    try append_line(out, "  %body_tag = extractvalue %kizu.kizu.ast.ast_data %body_data, 0");
    try out.append_bytes("  %is_block = icmp eq i64 %body_tag, ");
    try std::fmt::append_i64(out, block_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_block, label %body_block, label %unsupported");
    try append_line(out, "body_block:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %body_data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.block_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %body_statements = extractvalue %kizu.kizu.ast.block_node %payload, 0");
    try append_line(out,
        "  %result = call %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_loop_i64_body(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %function_name, i64 %statement_count, %kizu.slice.u8 %local_name, i64 %loop_start, i64 %loop_bound, %kizu.kizu.ast.child_range %body_statements)");
    try append_line(out, "  ret %kizu.error.run_ast %result");
    try append_line(out, "bound_fail:");
