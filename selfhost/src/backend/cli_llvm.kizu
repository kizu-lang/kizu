fn append_lexer_reachable_compiled_functions(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    var emitted = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("is_identifier_continue");
    try pending.append("invalid_token_display");
    var index = 0;
    while index < pending.len() {
        let local_name = try pending.get(index);
        if !(try compiled_closure_name_seen(&emitted, local_name)) {
            try append_lexer_compiled_function(out, ir_bytes, local_name);
            try collect_lexer_compiled_callees(ir_bytes, local_name, &var pending);
            try emitted.append(local_name);
        }
        index = index + 1;
    }
    pending.deinit();
    emitted.deinit();
    return;
}

fn append_lexer_compiled_function(
    out: &var std::string::String,
