        "  %init_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_call_arg_i64_literal(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %value)");
    try append_line(out, "  %init_ok = extractvalue %kizu.error.i64 %init_result, 0");
    try append_line(out, "  br i1 %init_ok, label %init_bound, label %init_fail");
    try append_line(out, "init_bound:");
    try append_line(out, "  %init_value = extractvalue %kizu.error.i64 %init_result, 1");
    try append_line(out, "  %init_zero = icmp eq i64 %init_value, 0");
    try append_line(out, "  br i1 %init_zero, label %check_loop, label %unsupported");
    try append_line(out, "check_loop:");
    try append_line(out, "  %loop_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %loop_statement)");
    try append_line(out, "  %loop_data = extractvalue %kizu.kizu.ast.ast_node %loop_node, 1");
    try append_line(out, "  %loop_tag = extractvalue %kizu.kizu.ast.ast_data %loop_data, 0");
    try out.append_bytes("  %is_while = icmp eq i64 %loop_tag, ");
    try std::fmt::append_i64(out, while_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_while, label %while_node, label %unsupported");
    try append_line(out, "while_node:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %loop_data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.while_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %label = extractvalue %kizu.kizu.ast.while_node %payload, 0");
    try append_line(out, "  %condition = extractvalue %kizu.kizu.ast.while_node %payload, 1");
    try append_line(out, "  %body = extractvalue %kizu.kizu.ast.while_node %payload, 2");
    try append_line(out,
        "  %result = call %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_loop_i64_while(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %function_name, i64 %statement_count, %kizu.slice.u8 %local_name, %kizu.kizu.ast.node_id %label, %kizu.kizu.ast.node_id %condition, %kizu.kizu.ast.node_id %body)");
    try append_line(out, "  ret %kizu.error.run_ast %result");
    try append_line(out, "init_fail:");
    try append_run_ast_error_union_fail_return(out, "init_result", "%kizu.error.i64");
    try append_line(out, "unsupported:");
    try append_unsupported_run_ast_success_return(out, "unsupported_loop_let");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_loop_i64_for_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let block_tag = try ast_data_tag(ir_bytes, "Block");
    try append_line(out, "define %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_loop_i64_for(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %function_name,");
    try append_line(out, "  i64 %statement_count,");
    try append_line(out, "  %kizu.kizu.ast.node_id %label,");
    try append_line(out, "  %kizu.kizu.ast.node_id %name,");
    try append_line(out, "  %kizu.kizu.ast.node_id %start,");
    try append_line(out, "  %kizu.kizu.ast.node_id %end,");
    try append_line(out, "  %kizu.kizu.ast.node_id %body");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %label_empty = call i1 @kizu_selfhost__ir_codegen_is_empty_node(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %label)");
    try append_line(out, "  br i1 %label_empty, label %bind_local, label %unsupported");
    try append_line(out, "bind_local:");
    try append_line(out,
        "  %local_name = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %name)");
    try append_line(out, "  %local_name_len = extractvalue %kizu.slice.u8 %local_name, 1");
    try append_line(out, "  %local_name_present = icmp ne i64 %local_name_len, 0");
    try append_line(out, "  br i1 %local_name_present, label %start_bound, label %unsupported");
    try append_line(out, "start_bound:");
    try append_line(out,
        "  %start_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_call_arg_i64_literal(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %start)");
    try append_line(out, "  %start_ok = extractvalue %kizu.error.i64 %start_result, 0");
    try append_line(out, "  br i1 %start_ok, label %check_start, label %start_fail");
    try append_line(out, "check_start:");
    try append_line(out, "  %start_value = extractvalue %kizu.error.i64 %start_result, 1");
    try append_line(out, "  %start_nonnegative = icmp sge i64 %start_value, 0");
    try append_line(out, "  br i1 %start_nonnegative, label %end_bound, label %unsupported");
    try append_line(out, "end_bound:");
    try append_line(out,
        "  %end_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_call_arg_i64_literal(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %end)");
    try append_line(out, "  %end_ok = extractvalue %kizu.error.i64 %end_result, 0");
    try append_line(out, "  br i1 %end_ok, label %check_bound, label %end_fail");
    try append_line(out, "check_bound:");
    try append_line(out, "  %bound = extractvalue %kizu.error.i64 %end_result, 1");
    try append_line(out, "  %bound_after_start = icmp sgt i64 %bound, %start_value");
    try append_line(out, "  br i1 %bound_after_start, label %check_body, label %unsupported");
    try append_line(out, "check_body:");
    try append_line(out, "  %body_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %body)");
    try append_line(out, "  %body_data = extractvalue %kizu.kizu.ast.ast_node %body_node, 1");
    try append_line(out, "  %body_tag = extractvalue %kizu.kizu.ast.ast_data %body_data, 0");
    try out.append_bytes("  %is_block = icmp eq i64 %body_tag, ");
    try std::fmt::append_i64(out, block_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_block, label %body_block, label %unsupported");
    try append_line(out, "body_block:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %body_data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.block_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %body_statements = extractvalue %kizu.kizu.ast.block_node %payload, 0");
    try append_line(out,
        "  %result = call %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_loop_i64_for_body(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %function_name, i64 %statement_count, %kizu.slice.u8 %local_name, i64 %start_value, i64 %bound, %kizu.kizu.ast.child_range %body_statements)");
    try append_line(out, "  ret %kizu.error.run_ast %result");
    try append_line(out, "start_fail:");
    try append_run_ast_error_union_fail_return(out, "start_result", "%kizu.error.i64");
    try append_line(out, "end_fail:");
    try append_run_ast_error_union_fail_return(out, "end_result", "%kizu.error.i64");
    try append_line(out, "unsupported:");
    try append_unsupported_run_ast_success_return(out, "unsupported_for_loop");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_loop_i64_block_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let let_tag = try ast_data_tag(ir_bytes, "Let");
    let for_tag = try ast_data_tag(ir_bytes, "For");
    try append_line(out, "define %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_loop_i64_block(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %function_name,");
    try append_line(out, "  %kizu.kizu.ast.child_range %statements");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %statement_len = extractvalue %kizu.kizu.ast.child_range %statements, 1");
    try append_line(out, "  %one_statement = icmp eq i64 %statement_len, 1");
    try append_line(out, "  br i1 %one_statement, label %load_for, label %check_while_shape");
    try append_line(out, "load_for:");
    try append_line(out,
        "  %for_statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %for_statement_ok = extractvalue %kizu.error.node_id %for_statement_result, 0");
    try append_line(out, "  br i1 %for_statement_ok, label %check_for, label %for_statement_fail");
    try append_line(out, "check_for:");
    try append_line(out, "  %for_statement = extractvalue %kizu.error.node_id %for_statement_result, 1");
    try append_line(out, "  %for_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %for_statement)");
    try append_line(out, "  %for_data = extractvalue %kizu.kizu.ast.ast_node %for_node, 1");
    try append_line(out, "  %for_tag_actual = extractvalue %kizu.kizu.ast.ast_data %for_data, 0");
    try out.append_bytes("  %is_for = icmp eq i64 %for_tag_actual, ");
    try std::fmt::append_i64(out, for_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_for, label %for_payload_block, label %unsupported");
    try append_line(out, "for_payload_block:");
    try append_line(out, "  %for_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %for_data, ptr %for_slot, align 8");
    try append_line(out, "  %for_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %for_slot, i32 0, i32 1");
    try append_line(out, "  %for_payload = load %kizu.kizu.ast.for_node, ptr %for_payload_ptr, align 8");
    try append_line(out, "  %for_label = extractvalue %kizu.kizu.ast.for_node %for_payload, 0");
    try append_line(out, "  %for_name = extractvalue %kizu.kizu.ast.for_node %for_payload, 1");
    try append_line(out, "  %for_start = extractvalue %kizu.kizu.ast.for_node %for_payload, 2");
    try append_line(out, "  %for_end = extractvalue %kizu.kizu.ast.for_node %for_payload, 3");
    try append_line(out, "  %for_body = extractvalue %kizu.kizu.ast.for_node %for_payload, 4");
    try append_line(out,
        "  %for_result = call %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_loop_i64_for(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %function_name, i64 %statement_len, %kizu.kizu.ast.node_id %for_label, %kizu.kizu.ast.node_id %for_name, %kizu.kizu.ast.node_id %for_start, %kizu.kizu.ast.node_id %for_end, %kizu.kizu.ast.node_id %for_body)");
    try append_line(out, "  ret %kizu.error.run_ast %for_result");
    try append_line(out, "check_while_shape:");
    try append_line(out, "  %two_statements = icmp eq i64 %statement_len, 2");
    try append_line(out, "  br i1 %two_statements, label %load_init, label %unsupported");
    try append_line(out, "load_init:");
    try append_line(out,
        "  %init_statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %init_statement_ok = extractvalue %kizu.error.node_id %init_statement_result, 0");
    try append_line(out, "  br i1 %init_statement_ok, label %load_loop, label %init_statement_fail");
    try append_line(out, "load_loop:");
    try append_line(out,
        "  %loop_statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 1)");
    try append_line(out, "  %loop_statement_ok = extractvalue %kizu.error.node_id %loop_statement_result, 0");
    try append_line(out, "  br i1 %loop_statement_ok, label %check_init, label %loop_statement_fail");
    try append_line(out, "check_init:");
    try append_line(out, "  %init_statement = extractvalue %kizu.error.node_id %init_statement_result, 1");
    try append_line(out, "  %loop_statement = extractvalue %kizu.error.node_id %loop_statement_result, 1");
    try append_line(out, "  %init_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %init_statement)");
    try append_line(out, "  %init_data = extractvalue %kizu.kizu.ast.ast_node %init_node, 1");
    try append_line(out, "  %init_tag = extractvalue %kizu.kizu.ast.ast_data %init_data, 0");
    try out.append_bytes("  %is_let = icmp eq i64 %init_tag, ");
    try std::fmt::append_i64(out, let_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_let, label %let_node, label %unsupported");
    try append_line(out, "let_node:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %init_data, ptr %slot, align 8");
    try append_line(out, "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %slot, i32 0, i32 1");
    try append_line(out, "  %payload = load %kizu.kizu.ast.let_node, ptr %payload_ptr, align 8");
    try append_line(out, "  %mutable = extractvalue %kizu.kizu.ast.let_node %payload, 0");
    try append_line(out, "  %name = extractvalue %kizu.kizu.ast.let_node %payload, 1");
    try append_line(out, "  %value = extractvalue %kizu.kizu.ast.let_node %payload, 2");
    try append_line(out,
        "  %result = call %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_loop_i64_let_while(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %function_name, i64 %statement_len, i1 %mutable, %kizu.kizu.ast.node_id %name, %kizu.kizu.ast.node_id %value, %kizu.kizu.ast.node_id %loop_statement)");
    try append_line(out, "  ret %kizu.error.run_ast %result");
    try append_line(out, "init_statement_fail:");
    try append_run_ast_child_fail_return(out, "init_statement_result");
    try append_line(out, "for_statement_fail:");
    try append_run_ast_child_fail_return(out, "for_statement_result");
    try append_line(out, "loop_statement_fail:");
    try append_run_ast_child_fail_return(out, "loop_statement_result");
    try append_line(out, "unsupported:");
    try append_unsupported_run_ast_success_return(out, "unsupported_loop_block");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_program_supported_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let const_string_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::ValueKind", "ConstString"
    );
    try append_line(out, "define i1 @kizu_selfhost__ir_codegen_program_supported(");
    try append_line(out, "  %kizu.selfhost.codegen.program %program");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %payload = call %kizu.selfhost.codegen.value @kizu_selfhost__ir_codegen_main_print_payload(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  %payload_kind = extractvalue %kizu.selfhost.codegen.value %payload, 0");
    try out.append_bytes("  %is_string_program = icmp eq i64 %payload_kind, ");
    try std::fmt::append_i64(out, const_string_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_string_program, label %supported, label %check_i64");
    try append_line(out, "check_i64:");
    try append_line(out,
        "  %i64_supported = call i1 @kizu_selfhost__ir_codegen_i64_call_program_supported(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  br i1 %i64_supported, label %supported, label %check_return_void");
    try append_line(out, "check_return_void:");
    try append_line(out,
        "  %return_void_supported = call i1 @kizu_selfhost__ir_codegen_return_void_program_supported(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  br i1 %return_void_supported, label %supported, label %check_try_void");
    try append_line(out, "check_try_void:");
    try append_line(out,
        "  %try_void_supported = call i1 @kizu_selfhost__ir_codegen_try_void_program_supported(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  br i1 %try_void_supported, label %supported, label %check_loop_i64");
    try append_line(out, "check_loop_i64:");
    try append_line(out,
        "  %loop_i64_supported = call i1 @kizu_selfhost__ir_codegen_loop_i64_program_supported(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  br i1 %loop_i64_supported, label %supported, label %check_fs_read");
    try append_line(out, "check_fs_read:");
    try append_line(out,
        "  %fs_read_supported = call i1 @kizu_selfhost__ir_codegen_fs_read_program_supported(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  ret i1 %fs_read_supported");
    try append_line(out, "supported:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_stdout_payload_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let const_string_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::ValueKind", "ConstString"
    );
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__ir_codegen_stdout_payload(");
    try append_line(out, "  %kizu.selfhost.codegen.program %program");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %payload = call %kizu.selfhost.codegen.value @kizu_selfhost__ir_codegen_main_print_payload(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  %payload_kind = extractvalue %kizu.selfhost.codegen.value %payload, 0");
    try out.append_bytes("  %is_const_string = icmp eq i64 %payload_kind, ");
    try std::fmt::append_i64(out, const_string_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_const_string, label %const_string, label %check_try_void");
    try append_line(out, "const_string:");
    try append_line(out, "  %string_payload = extractvalue %kizu.selfhost.codegen.value %payload, 2");
    try append_line(out, "  %string_ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %string_result = insertvalue %kizu.error.slice.u8 %string_ok, %kizu.slice.u8 %string_payload, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %string_result");
    try append_line(out, "check_try_void:");
    try append_line(out, "  %try_void = call i1 @kizu_selfhost__ir_codegen_try_void_program_supported(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  br i1 %try_void, label %try_void_payload, label %unsupported");
    try append_line(out, "try_void_payload:");
    try append_line(out, "  %second_payload = extractvalue %kizu.selfhost.codegen.program %program, 13");
    try append_line(out, "  %try_ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %try_result = insertvalue %kizu.error.slice.u8 %try_ok, %kizu.slice.u8 %second_payload, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %try_result");
    try append_line(out, "unsupported:");
    try append_line(out, "  %err_ptr = getelementptr inbounds [34 x i8], ptr @.kizu.cli.stdout_payload_error, i64 0, i64 0");
    try append_line(out, "  %err_base = insertvalue %kizu.slice.u8 poison, ptr %err_ptr, 0");
    try append_line(out, "  %err = insertvalue %kizu.slice.u8 %err_base, i64 34, 1");
    try append_line(out, "  %fail0 = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 false, 0");
    try append_line(out, "  %fail1 = insertvalue %kizu.error.slice.u8 %fail0, %kizu.slice.u8 %err, 2");
    try append_line(out, "  ret %kizu.error.slice.u8 %fail1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

