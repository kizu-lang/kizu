fn append_i64_call_program_supported_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let add_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Add"
    );
    let sub_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Sub"
    );
    let mul_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Mul"
    );
    let div_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Div"
    );
    try append_line(out, "define i1 @kizu_selfhost__ir_codegen_i64_call_program_supported(");
    try append_line(out, "  %kizu.selfhost.codegen.program %program");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %function_count = extractvalue %kizu.selfhost.codegen.program %program, 0");
    try append_line(out, "  %two_functions = icmp eq i64 %function_count, 2");
    try append_line(out, "  br i1 %two_functions, label %check_main, label %unsupported");
    try append_line(out, "check_main:");
    try append_line(out, "  %function_name = extractvalue %kizu.selfhost.codegen.program %program, 1");
    try append_line(out,
        "  %main_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.run_main, i64 0, i64 0");
    try append_line(out, "  %main_base = insertvalue %kizu.slice.u8 poison, ptr %main_ptr, 0");
    try append_line(out, "  %main_slice = insertvalue %kizu.slice.u8 %main_base, i64 4, 1");
    try append_line(out,
        "  %main_ok = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %function_name, %kizu.slice.u8 %main_slice)");
    try append_line(out, "  br i1 %main_ok, label %check_params, label %unsupported");
    try append_line(out, "check_params:");
    try append_line(out, "  %param_count = extractvalue %kizu.selfhost.codegen.program %program, 17");
    try append_line(out, "  %params_ok = icmp eq i64 %param_count, 2");
    try append_line(out, "  br i1 %params_ok, label %check_name_len, label %unsupported");
    try append_line(out, "check_name_len:");
    try append_line(out, "  %fn_name = extractvalue %kizu.selfhost.codegen.program %program, 16");
    try append_line(out, "  %fn_name_len = extractvalue %kizu.slice.u8 %fn_name, 1");
    try append_line(out, "  %fn_name_nonempty = icmp ne i64 %fn_name_len, 0");
    try append_line(out, "  br i1 %fn_name_nonempty, label %check_callee, label %unsupported");
    try append_line(out, "check_callee:");
    try append_line(out, "  %call_callee = extractvalue %kizu.selfhost.codegen.program %program, 19");
    try append_line(out,
        "  %callee_ok = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fn_name, %kizu.slice.u8 %call_callee)");
    try append_line(out, "  br i1 %callee_ok, label %check_op, label %unsupported");
    try append_line(out, "check_op:");
    try append_line(out, "  %op = extractvalue %kizu.selfhost.codegen.program %program, 18");
    try out.append_bytes("  %op_add = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, add_tag);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %op_sub = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, sub_tag);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %op_mul = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, mul_tag);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %op_div = icmp eq i64 %op, ");
    try std::fmt::append_i64(out, div_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %op_1 = or i1 %op_add, %op_sub");
    try append_line(out, "  %op_2 = or i1 %op_1, %op_mul");
    try append_line(out, "  %op_ok = or i1 %op_2, %op_div");
    try append_line(out, "  ret i1 %op_ok");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_slice_equal_function(out);
    try append_slice_len_function(out);
    try append_slice_starts_with_dash_function(out);
    try append_write_concat3_function(out);
    try cli_artifact_dir_llvm::append_functions(out);
    try cli_artifact_path_llvm::append_functions(out);
    try cli_ast_boundary_llvm::append_functions(out);
    try cli_codegen_llvm::append_functions(out, ir_bytes);
    try cli_hosted_renderer_llvm::append_functions(out, ir_bytes);
    try cli_run_llvm::append_functions(out, ir_bytes);
    try cli_parse_llvm::append_functions(out);
    try cli_match_llvm::append_functions(out);
    try cli_test_ast_llvm::append_functions(out);
    try cli_test_llvm::append_functions(out, ir_bytes);
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::metadata_line",
        "kizu_selfhost__ir_codegen_metadata_line",
        ""
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::return_void_instruction",
        "kizu_selfhost__ir_codegen_return_void_instruction",
        ""
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::const_string_value",
        "kizu_selfhost__ir_codegen_const_string_value",
        "%kizu.slice.u8 name;%kizu.slice.u8 payload"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::const_string_instruction",
        "kizu_selfhost__ir_codegen_const_string_instruction",
        "%kizu.selfhost.codegen.value value"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::call_instruction",
        "kizu_selfhost__ir_codegen_call_instruction",
        "%kizu.slice.u8 callee;%kizu.selfhost.codegen.value argument"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::build_main_print_program",
        "kizu_selfhost__ir_codegen_build_main_print_program",
        "%kizu.slice.u8 payload;i1 from_codegen_lowering"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lowered_main_print_program",
        "kizu_selfhost__ir_codegen_lowered_main_print_program",
        "%kizu.slice.u8 payload"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::try_void_run_ast_supported",
        "kizu_selfhost__ir_codegen_try_void_run_ast_supported",
        "%kizu.selfhost.codegen.run_ast run_ast"
    );
    try append_loop_i64_run_ast_supported_function(out, ir_bytes);
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::fs_read_run_ast_supported",
        "kizu_selfhost__ir_codegen_fs_read_run_ast_supported",
        "%kizu.selfhost.codegen.run_ast run_ast"
    );
    try append_run_ast_supported_function(out, ir_bytes);
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::run_ast_i64_call_supported",
        "kizu_selfhost__ir_codegen_run_ast_i64_call_supported",
        "%kizu.selfhost.codegen.run_ast run_ast"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::i64_call_run_ast",
        "kizu_selfhost__ir_codegen_i64_call_run_ast",
        "%kizu.slice.u8 function_name;i64 statement_count;%kizu.slice.u8 print_callee;%kizu.slice.u8 callee;i64 op;i64 arg0;i64 arg1"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::return_void_run_ast",
        "kizu_selfhost__ir_codegen_return_void_run_ast",
        "%kizu.slice.u8 text;%kizu.slice.u8 function_name;i64 statement_count"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::try_void_run_ast",
        "kizu_selfhost__ir_codegen_try_void_run_ast",
        "%kizu.slice.u8 function_name;i64 statement_count;%kizu.slice.u8 print_callee;%kizu.slice.u8 payload;%kizu.slice.u8 try_callee;i64 helper_exit_code"
    );
    try append_loop_i64_run_ast_function(out, ir_bytes);
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::fs_read_run_ast",
        "kizu_selfhost__ir_codegen_fs_read_run_ast",
        "%kizu.slice.u8 function_name;i64 statement_count;%kizu.slice.u8 print_callee;%kizu.slice.u8 path"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lowered_i64_call_program",
        "kizu_selfhost__ir_codegen_lowered_i64_call_program",
        "%kizu.selfhost.codegen.run_ast run_ast"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lowered_return_void_program",
        "kizu_selfhost__ir_codegen_lowered_return_void_program",
        "%kizu.selfhost.codegen.run_ast run_ast"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lowered_try_void_program",
        "kizu_selfhost__ir_codegen_lowered_try_void_program",
        "%kizu.selfhost.codegen.run_ast run_ast"
    );
    try append_lowered_loop_i64_program_function(out, ir_bytes);
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lowered_fs_read_program",
        "kizu_selfhost__ir_codegen_lowered_fs_read_program",
        "%kizu.selfhost.codegen.run_ast run_ast"
    );
    try append_lower_run_ast_to_program_function(out, ir_bytes);
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_parse_result",
        "kizu_selfhost__ir_codegen_lower_run_parse_result",
        "%kizu.slice.u8 text;%kizu.kizu.ast.parse_result parsed"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::unsupported_program",
        "kizu_selfhost__ir_codegen_unsupported_program",
        "%kizu.slice.u8 empty"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::none_value",
        "kizu_selfhost__ir_codegen_none_value",
        "%kizu.slice.u8 empty"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::main_print_payload",
        "kizu_selfhost__ir_codegen_main_print_payload",
        "%kizu.selfhost.codegen.program program"
    );
    try append_stdout_payload_function(out, ir_bytes);
    try append_program_supported_function(out, ir_bytes);
    try append_i64_call_program_supported_function(out, ir_bytes);
    try append_return_void_program_supported_function(out, ir_bytes);
    try append_try_void_program_supported_function(out, ir_bytes);
    try append_loop_i64_program_supported_function(out, ir_bytes);
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::fs_read_program_supported",
        "kizu_selfhost__ir_codegen_fs_read_program_supported",
        "%kizu.selfhost.codegen.program program"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::print_run_ast",
        "kizu_selfhost__ir_codegen_print_run_ast",
        "%kizu.slice.u8 function_name;i64 statement_count;%kizu.slice.u8 callee;%kizu.slice.u8 payload"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::unsupported_run_ast",
        "kizu_selfhost__ir_codegen_unsupported_run_ast",
        "%kizu.slice.u8 empty"
    );
    // local_table_contains is the first AST-traversal lowering member compiled
    // into stage2 (tracker 961). It lands the run-AST local-binding model
    // (LocalTable / LocalBinding) plus the membership check lower_let_binding uses
    // to reject duplicate let names inside lower_run_ast_block. It is
    // AST-type-independent (it reads an already-built LocalTable, not AST nodes),
    // so it can be compiled now, ahead of the parser/AST migration the interior,
    // AST-dependent nodes (lower_run_ast and friends) still wait on. It mirrors the
    // already-compiled run_ast_supported shape: a borrowed struct param, field
    // reads, short-circuit and, std::mem::equal_bytes, and a bool return.
    //
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::local_table_contains",
        "kizu_selfhost__ir_codegen_local_table_contains",
        "%kizu.selfhost.codegen.local_table locals;%kizu.slice.u8 name"
    );
    // PayloadSpan / LocalBinding sentinel helpers (tracker 961). These return
    // structs whose fields use -1 sentinels (PayloadSpan { start: -1, end: -1 }),
    // unblocked by the compiled mini MIR now lowering Prefix(-Int) struct fields.
    // empty_local also reads text[0..0]; local_payload_span chains nested field
    // extraction (locals.first.payload_start) plus an empty_payload_span() fallback
    // call, both already supported. They land the run-AST local-binding lookup the
    // parser/AST migration still waits on for the interior nodes.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::empty_payload_span",
        "kizu_selfhost__ir_codegen_empty_payload_span",
        ""
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::empty_local",
        "kizu_selfhost__ir_codegen_empty_local",
        "%kizu.slice.u8 text"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::local_payload_span",
        "kizu_selfhost__ir_codegen_local_payload_span",
        "%kizu.selfhost.codegen.local_table locals;%kizu.slice.u8 name"
    );
    // empty_local_table builds a LocalTable whose first/second fields are produced
    // by calling empty_local (tracker 961). It exercises the new call-valued struct
    // field initializer lowering: the renderer emits each empty_local call and feeds
    // the result into the LocalTable insertvalue chain.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::empty_local_table",
        "kizu_selfhost__ir_codegen_empty_local_table",
        "%kizu.slice.u8 text"
    );
    // insert_local exercises nested struct-literal field initializers
    // (first/second: LocalBinding { ... }) plus a call-valued field
    // (second: empty_local(text)) across both an if-then struct return and the
    // top-level struct return (tracker 961). It preserves the count == 0 and
    // count != 0 LocalTable shapes.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::insert_local",
        "kizu_selfhost__ir_codegen_insert_local",
        "%kizu.slice.u8 text;%kizu.selfhost.codegen.local_table locals;%kizu.selfhost.codegen.local_binding binding"
    );
    // is_payload_supported is the first run-codegen leaf compiled through the
    // restricted bounded-counter while lowering (tracker 961): one i64 induction
    // variable, an index-less-than-std-mem-len comparison condition, sequential
    // early-return byte-range checks in the body, and an index-plus-one increment.
    // The generated LLVM is a single loop-carried phi over the preheader/head/body/
    // latch/exit blocks, and the payload index uses the ADR-0053 checked index-load path.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::is_payload_supported",
        "kizu_selfhost__ir_codegen_is_payload_supported",
        "%kizu.slice.u8 payload"
    );
    // string_literal_span is the first run-codegen AST traversal accessor that binds
    // an AstNode and reads its Span to slice the source text (tracker 961, scope 4
    // prerequisite). It binds the AstNode via Ast.get, reads the Span (AstNode field 0)
    // start/end, rejects spans shorter than the two surrounding quotes, checks the
    // leading/trailing double-quote bytes through the ADR-0053 checked index-load, and
    // forwards the inner payload slice to is_payload_supported, returning the trimmed
    // PayloadSpan on success or empty_payload_span() otherwise. Its callees (Ast.get,
    // is_payload_supported, empty_payload_span) are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::string_literal_span",
        "kizu_selfhost__ir_codegen_string_literal_span",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.node_id node_id"
    );
    // print_payload is the run-codegen AST traversal accessor that dispatches a print
    // argument node on the AstData tag (tracker 961, scope 4 prerequisite): the String
    // variant slices the quoted literal via string_literal_span, the Var variant resolves
    // the local payload via local_payload_span(locals, ast_node_text(...)), and every other
    // variant returns the shared empty_payload_span() sentinel. Its callees are already
    // compiled so selfhost.ll links. The borrowed &LocalTable lands by value, matching the
    // local_table_contains / local_payload_span ABI.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::print_payload",
        "kizu_selfhost__ir_codegen_print_payload",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.selfhost.codegen.local_table locals;%kizu.kizu.ast.node_id arg"
    );
    // lower_print_call is the run-codegen AST traversal lowering that recognises a single
    // print("...") / print(local) statement and builds the RunAst (tracker 961, scope 4
    // prerequisite). It is the first compiled !RunAst error-union return: it rejects a
    // non-print callee or wrong arity, propagates the checked Ast.child_at failure, extracts
    // the argument payload via print_payload, and wraps print_run_ast / unsupported_run_ast
    // into the !RunAst success. All callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_print_call",
        "kizu_selfhost__ir_codegen_lower_print_call",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.child_range declarations;%kizu.slice.u8 function_name;i64 statement_count;%kizu.selfhost.codegen.local_table locals;%kizu.kizu.ast.node_id callee;%kizu.kizu.ast.child_range args"
    );
    try cli_run_i64_codegen_llvm::append_functions(out, ir_bytes);
    // lower_print_statement is the run-codegen AST traversal lowering that dispatches the final
    // block statement on the AstData tag (tracker 961, scope 4 prerequisite): the Call variant
    // forwards lower_print_call's !RunAst result, every other variant returns the wrapped
    // unsupported_run_ast(). Its callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_print_statement",
        "kizu_selfhost__ir_codegen_lower_print_statement",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.child_range declarations;%kizu.slice.u8 function_name;i64 statement_count;%kizu.selfhost.codegen.local_table locals;%kizu.kizu.ast.node_id expr"
    );
    // lower_let_binding is the run-codegen AST traversal lowering that turns a 'let <name> =
    // "..."' binding into a LocalBinding (tracker 961, scope 4 prerequisite): it reads the binding
    // name text, rejects a duplicate / over-capacity local, slices the string literal payload, and
    // returns the LocalBinding or empty_local() on rejection. Its callees are already compiled so
    // selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_let_binding",
        "kizu_selfhost__ir_codegen_lower_let_binding",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.selfhost.codegen.local_table locals;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.node_id value"
    );
    try append_is_empty_node_function(out, ir_bytes);
    try append_type_node_is_error_union_void_function(out);
    try append_try_void_callee_functions(out, ir_bytes);
    try append_return_void_statement_ok_function(out, ir_bytes);
    try append_print_payload_functions(out, ir_bytes);
    try append_error_void_exit_functions(out, ir_bytes);
    try append_try_void_helper_exit_functions(out, ir_bytes);
    try append_lower_try_void_block_function(out);
    try append_lower_fs_read_block_function(out, ir_bytes);
    try append_loop_binary_value_function(out);
    try append_loop_var_int_binary_function(out, ir_bytes);
    try append_loop_assign_step_function(out, ir_bytes);
    try append_loop_increment_step_function(out, ir_bytes);
    try append_loop_terminal_statement_ok_function(out, ir_bytes);
    try append_loop_then_block_ok_function(out);
    try append_loop_then_terminal_ok_function(out, ir_bytes);
    try append_loop_if_value_function(out, ir_bytes);
    try append_loop_if_terminal_value_function(out, ir_bytes);
    try append_loop_print_call_ok_function(out);
    try append_loop_print_expr_ok_function(out, ir_bytes);
    try append_loop_print_statement_ok_function(out, ir_bytes);
    try append_lower_loop_i64_body_function(out);
    try append_lower_loop_i64_for_body_function(out);
    try append_lower_loop_i64_while_function(out, ir_bytes);
    try append_lower_loop_i64_let_while_function(out, ir_bytes);
    try append_lower_loop_i64_for_function(out, ir_bytes);
    try append_lower_loop_i64_block_function(out, ir_bytes);
    // lower_run_ast_block is the stateful run-block traversal (tracker 961, scope 4 prerequisite):
    // a bounded loop threading a mutable LocalTable + index, lowering non-terminal Let bindings via
    // lower_let_binding / insert_local and the terminal ExprStmt via lower_print_statement. Its
    // callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast_block",
        "kizu_selfhost__ir_codegen_lower_run_ast_block",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.child_range declarations;%kizu.slice.u8 function_name;%kizu.kizu.ast.child_range statements"
    );
    // lower_run_ast_function requires the run function to be 'main' and forwards its block body to
    // lower_run_ast_block (tracker 961, scope 4 prerequisite). Its callees are already compiled so
    // selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast_function",
        "kizu_selfhost__ir_codegen_lower_run_ast_function",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.child_range declarations;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.node_id body"
    );
    // lower_run_ast_declarations scans the program declarations for the first FnDecl whose
    // lower_run_ast_function produces a supported RunAst (tracker 961, scope 4 prerequisite). Its
    // callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast_declarations",
        "kizu_selfhost__ir_codegen_lower_run_ast_declarations",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.child_range declarations"
    );
    // lower_run_ast is the run-codegen AST traversal root (tracker 961, scope 4 prerequisite): it
    // dispatches the program root and forwards lower_run_ast_declarations on the Program variant.
    // Its callees are already compiled so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::lower_run_ast",
        "kizu_selfhost__ir_codegen_lower_run_ast",
        "%kizu.slice.u8 text;%kizu.kizu.ast.ast ast;%kizu.kizu.ast.node_id root"
    );
    // empty_int_env is the first compiled function that takes a real
    // std::kizu::ast value type (ChildRange) as a parameter and stores it into a
    // struct field, establishing the read-only AST value-type foundation in stage2
    // (tracker 961). The ChildRange is forwarded as a whole aggregate into the
    // IntEnv insertvalue chain; no AstNode/AstData union access is involved.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ir::codegen::empty_int_env",
        "kizu_selfhost__ir_codegen_empty_int_env",
        "%kizu.slice.u8 text;%kizu.kizu.ast.child_range decls"
    );
    // std::kizu::ast::Ast.len is the first real AST read-only accessor compiled into
    // stage2 (tracker 961). It takes the Ast container value as a parameter, reads
    // its children Array field (struct field index 1), and returns the Array length
    // via the array_len builtin. It is the method-call lowering counterpart to the
    // empty_int_env value-type foundation: no AstNode/AstData union, Arena.get,
    // array_get, or error-union return is involved.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::ast_len",
        "kizu_kizu__ast_ast_len",
        "%kizu.kizu.ast.ast self"
    );
    // Diagnostic.related_get is the first checked Array<T>.get accessor compiled
    // into stage2 (tracker 961): it reads the related Array<RelatedSpan> field
    // (struct field index 2) and returns a single RelatedSpan by value as
    // !RelatedSpan via the checked @kizu_rt_array_at runtime call, with a real
    // error-union failure return (never unreachable) on an out-of-bounds index.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::diagnostic::diagnostic_related_get",
        "kizu_kizu__diagnostic_diagnostic_related_get",
        "%kizu.kizu.diagnostic.diagnostic self;i64 index"
    );
    // Ast.child_at is the first multi-statement Array<T>.get consumer compiled into
    // stage2 (tracker 961): a bounds-check 'if' with a real return error(...) failure
    // return, then 'return self.children.get(range.start + index);' lowered to the
    // checked @kizu_rt_array_at accessor returning !NodeId.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::ast_child_at",
        "kizu_kizu__ast_ast_child_at",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.child_range range;i64 index"
    );
    // Ast.add_node is the first AstNode/AstData tagged-union constructor compiled into
    // stage2 (tracker 961): it builds an AstNode (Span + AstData union value forwarded
    // whole) and appends it to the nodes Arena via the heap-backed @kizu_rt_arena_add,
    // binding the returned NodeId. It exercises the union value-type ABI without
    // modelling the 44 variant payload structs.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::ast_add_node",
        "kizu_kizu__ast_ast_add_node",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;%kizu.kizu.ast.ast_data data"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::parse_result",
        "kizu_kizu__ast_parse_result",
        "%kizu.kizu.ast.ast ast;%kizu.kizu.ast.node_id root"
    );
    // Ast.get is the first Arena<T>.get accessor compiled into stage2 (tracker 961): it
    // reads an AstNode back out of the nodes Arena by value via the checked
    // @kizu_rt_arena_get, reusing the AstNode/AstData union value-type ABI, and traps on
    // an out-of-bounds NodeId index.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::ast::ast_get",
        "kizu_kizu__ast_ast_get",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.node_id id"
    );
    // declaration_count is the first match-over-AstData-union read-only AST accessor
    // compiled into stage2 (tracker 961): it binds an AstNode via Ast.get, dispatches on
    // the AstData tagged-union tag, and on the Program arm reads program.declarations.len
    // out of the inline payload, returning 0 for every other variant.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::declaration_count",
        "kizu_selfhost__ast_declaration_count",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id root"
    );
    // The node_count recursive AST-traversal cluster compiled into stage2 (tracker 961):
    // node_count is the 44-arm match-over-AstData traversal, count_range the two-phi
    // accumulator loop calling Ast.child_at + node_count, and the count_* helpers the
    // let-try / return-try arithmetic. The whole mutually-recursive cluster is registered
    // together so selfhost.ll links with no undefined symbol.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::node_count",
        "kizu_selfhost__ast_node_count",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id node_id"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_range",
        "kizu_selfhost__ast_count_range",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.child_range range"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_one",
        "kizu_selfhost__ast_count_one",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id first"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_two",
        "kizu_selfhost__ast_count_two",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id first;%kizu.kizu.ast.node_id second"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_three",
        "kizu_selfhost__ast_count_three",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id first;%kizu.kizu.ast.node_id second;%kizu.kizu.ast.node_id third"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_five",
        "kizu_selfhost__ast_count_five",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id first;%kizu.kizu.ast.node_id second;%kizu.kizu.ast.node_id third;%kizu.kizu.ast.node_id fourth;%kizu.kizu.ast.node_id fifth"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_with_range",
        "kizu_selfhost__ast_count_with_range",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.child_range range"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_node_with_range",
        "kizu_selfhost__ast_count_node_with_range",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id node_id;%kizu.kizu.ast.child_range range"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_named_range",
        "kizu_selfhost__ast_count_named_range",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.child_range range"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_named_ranges",
        "kizu_selfhost__ast_count_named_ranges",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.child_range first;%kizu.kizu.ast.child_range second"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "selfhost::ast::count_fn_decl_parts",
        "kizu_selfhost__ast_count_fn_decl_parts",
        "%kizu.kizu.ast.ast tree;%kizu.kizu.ast.node_id extern_abi;%kizu.kizu.ast.node_id name;%kizu.kizu.ast.child_range type_params;%kizu.kizu.ast.child_range params;%kizu.kizu.ast.node_id return_type;%kizu.kizu.ast.node_id return_borrow;%kizu.kizu.ast.node_id body"
    );
    // std::mem::is_ascii_space backs the ast_node_text span accessor's trim (tracker 961):
    // an or-chain byte classifier returning i1. It lowers through the single-statement
    // expression-return path (the binary renderer already handles or / eq).
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::mem::is_ascii_space",
        "kizu_std__mem_is_ascii_space",
        "i8 byte"
    );
    // std::mem::trim_ascii and ast_node_text are the span-based text slicing accessors the
    // run-codegen AST traversal depends on (tracker 961). ast_node_text calls trim_ascii calls
    // is_ascii_space; the whole chain is registered together so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::mem::trim_ascii",
        "kizu_std__mem_trim_ascii",
        "%kizu.slice.u8 bytes"
    );
    // std::mem::starts_with is the shared slice-prefix predicate used by selfhost source helpers.
    // Compiling it here gives stdlib-symbol callers a selfhost-owned checked-index loop.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::mem::starts_with",
        "kizu_std__mem_starts_with",
        "%kizu.slice.u8 bytes;%kizu.slice.u8 prefix"
    );
    // first_token / next_token seed the std::kizu::lexer tokenizer helper closure. The closure
    // reaches token_at, raw_token_at, scan helpers, Token constructors, position tracking, and byte
    // classifiers while leaving tokenize manual because it contains method calls on Array.
    try append_kizu_lexer_reachable_compiled_functions(out, ir_bytes);
    // tokenize(allocator, source) -> !Array<Token> builds the token stream feeding the parser
    // (tracker 961, scope 4 prerequisite). It returns the error-union-owned (%kizu.error.owned)
    // explicitly, so it is registered with an explicit return type rather than the auto path.
    try compiled_llvm::append_compiled_function_params(
        out, ir_bytes,
        "std::kizu::lexer::tokenize",
        "kizu_kizu__lexer_tokenize",
        "%kizu.error.owned",
        "%kizu.owned allocator;%kizu.slice.u8 source"
    );
    // std::kizu::parser TokenKind predicates that match over a Token's TokenKind field and return
    // bool (tracker 961, scope 4 prerequisite). They lower through the token-kind predicate path,
    // covering both compact return-match helpers and exhaustive match-statement helpers.
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_double_colon",
        "kizu_kizu__parser_is_double_colon",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_eof_token",
        "kizu_kizu__parser_is_eof_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_left_brace_token",
        "kizu_kizu__parser_is_left_brace_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_right_brace_token",
        "kizu_kizu__parser_is_right_brace_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_block_close_token",
        "kizu_kizu__parser_is_block_close_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_ident_kind",
        "kizu_kizu__parser_is_ident_kind",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_postfix_start",
        "kizu_kizu__parser_is_postfix_start",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_call_close_token",
        "kizu_kizu__parser_is_call_close_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_pub_token",
        "kizu_kizu__parser_is_pub_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_comptime_token",
        "kizu_kizu__parser_is_comptime_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_decl_item_separator",
        "kizu_kizu__parser_is_decl_item_separator",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_lt_token",
        "kizu_kizu__parser_is_lt_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_gt_token",
        "kizu_kizu__parser_is_gt_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_comma_token",
        "kizu_kizu__parser_is_comma_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_arrow_token",
        "kizu_kizu__parser_is_arrow_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_left_paren_token",
        "kizu_kizu__parser_is_left_paren_token",
        "%kizu.kizu.lexer.token token"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_right_paren_token",
