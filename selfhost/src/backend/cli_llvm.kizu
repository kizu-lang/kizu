import selfhost::backend::cli_artifact_path_llvm;
import selfhost::backend::cli_match_llvm;
import selfhost::backend::cli_parse_llvm;
import selfhost::backend::cli_run_llvm;

pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(out, "check", "5", "check");
    try append_llvm_constant(out, "stage", "5", "stage");
    try append_llvm_constant(out, "parse", "5", "parse");
    try append_llvm_constant(out, "run", "3", "run");
    try append_llvm_constant(out, "test", "4", "test");
    try append_llvm_constant(out, "fmt", "3", "fmt");
    try append_llvm_constant(out, "selfhost", "8", "selfhost");
    try cli_parse_llvm::append_globals(out);
    try cli_run_llvm::append_globals(out);
    try append_llvm_constant(out, "ll_suffix", "3", ".ll");
    try append_llvm_constant(out, "meta_suffix", "8", ".ll.meta");
    try append_llvm_constant(out, "test_dir", "20", "target/selfhost/test");
    try append_llvm_constant(out, "test_path_prefix", "21", "target/selfhost/test/");
    try append_llvm_constant(
        out,
        "test_ll_prefix",
        "46",
        "; kizu test artifact ll v0\0Asource_filename = \22"
    );
    try append_llvm_constant(
        out,
        "test_ok_ll_suffix",
        "793",
        "\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.kizu.test.ok = private unnamed_addr constant [9 x i8] c\22test: ok\5C0A\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0Adeclare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0Adefine i64 @kizu_test_main() {\0Aentry:\0A  %io = call %kizu.owned @kizu_rt_io_blocking()\0A  %ptr = getelementptr inbounds [9 x i8], ptr @.kizu.test.ok, i64 0, i64 0\0A  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 9, 1\0A  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %slice)\0A  %code = call i64 @kizu_rt_process_exit_code(i64 0)\0A  ret i64 %code\0A}\0A"
    );
    try append_llvm_constant(
        out,
        "test_failure_ll_suffix",
        "849",
        "\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.kizu.test.failure = private unnamed_addr constant [52 x i8] c\22error: runtime error: expected condition to be true\5C0A\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0Adeclare %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0Adefine i64 @kizu_test_main() {\0Aentry:\0A  %io = call %kizu.owned @kizu_rt_io_blocking()\0A  %ptr = getelementptr inbounds [52 x i8], ptr @.kizu.test.failure, i64 0, i64 0\0A  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 52, 1\0A  %write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %slice)\0A  %code = call i64 @kizu_rt_process_exit_code(i64 1)\0A  ret i64 %code\0A}\0A"
    );
    try append_llvm_constant(
        out,
        "test_meta_prefix",
        "40",
        "kizu-test-artifact-v0\0Aissue #570\0Asource "
    );
    try append_llvm_constant(
        out,
        "test_ok_meta_suffix",
        "162",
        "\0Aabi selfhost-abi-v0\0Aentry @kizu_test_main\0Aruntime target/selfhost/stage2/selfhost.host.ll\0Ago.cmd-kizu-fallback none\0Aartifact_mode hosted-artifact\0Adiscovery none\0A"
    );
    try append_llvm_constant(
        out,
        "test_failure_meta_suffix",
        "162",
        "\0Aabi selfhost-abi-v0\0Aentry @kizu_test_main\0Aruntime target/selfhost/stage2/selfhost.host.ll\0Ago.cmd-kizu-fallback none\0Aartifact_mode hosted-artifact\0Adiscovery none\0A"
    );
    try append_llvm_constant(out, "artifact_output_prefix", "8", "\0Aoutput ");
    try append_llvm_constant(out, "manifest", "18", "selfhost/kizu.toml");
    try append_llvm_constant(out, "source_dir", "12", "selfhost/src");
    try append_llvm_constant(out, "check_ok", "10", "check: ok\0A");
    try append_llvm_constant(out, "move_prefix", "32", "error: move error: moved value `");
    try append_llvm_constant(out, "move_suffix", "11", "` was used\0A");
    try append_llvm_constant(out, "stage_ok", "10", "stage: ok\0A");
    try append_llvm_constant(out, "usage", "58", "usage: selfhost <check|stage|parse|run|test|fmt> <target>\0A");
    try append_llvm_constant(out, "unsupported", "29", "unsupported selfhost command\0A");
    try append_llvm_constant(out, "failed", "22", "selfhost check failed\0A");
    try append_llvm_constant(out, "ll_path", "28", "target/selfhost/selfhost.ll\0A");
    try append_llvm_constant(out, "meta_path", "33", "target/selfhost/selfhost.ll.meta\0A");
    try append_llvm_constant(out, "storage_path", "36", "target/selfhost/selfhost.storage.ll\0A");
    try append_llvm_constant(
        out,
        "storage_meta_path",
        "41",
        "target/selfhost/selfhost.storage.ll.meta\0A"
    );
    try append_llvm_constant(out, "host_path", "33", "target/selfhost/selfhost.host.ll\0A");
    try append_llvm_constant(
        out,
        "host_meta_path",
        "38",
        "target/selfhost/selfhost.host.ll.meta\0A"
    );
    try append_llvm_constant(out, "root_ll_path", "27", "target/selfhost/selfhost.ll");
    try append_llvm_constant(out, "root_meta_path", "32", "target/selfhost/selfhost.ll.meta");
    try append_llvm_constant(
        out,
        "root_storage_path",
        "35",
        "target/selfhost/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "root_storage_meta_path",
        "40",
        "target/selfhost/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(out, "root_host_path", "32", "target/selfhost/selfhost.host.ll");
    try append_llvm_constant(
        out,
        "root_host_meta_path",
        "37",
        "target/selfhost/selfhost.host.ll.meta"
    );
    try append_llvm_constant(out, "stage2_ll_path", "34", "target/selfhost/stage2/selfhost.ll");
    try append_llvm_constant(
        out,
        "stage2_meta_path",
        "39",
        "target/selfhost/stage2/selfhost.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_path",
        "42",
        "target/selfhost/stage2/selfhost.storage.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_storage_meta_path",
        "47",
        "target/selfhost/stage2/selfhost.storage.ll.meta"
    );
    try append_llvm_constant(
        out,
        "stage2_host_path",
        "39",
        "target/selfhost/stage2/selfhost.host.ll"
    );
    try append_llvm_constant(
        out,
        "stage2_host_meta_path",
        "44",
        "target/selfhost/stage2/selfhost.host.ll.meta"
    );
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_slice_equal_function(out);
    try append_slice_starts_with_dash_function(out);
    try append_write_concat3_function(out);
    try cli_artifact_path_llvm::append_functions(out);
    try cli_parse_llvm::append_functions(out);
    try cli_match_llvm::append_functions(out);
    try append_cli_main_function(out);
    return;
}

fn append_slice_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_equal(");
    try append_line(out, "  %kizu.slice.u8 %left,");
    try append_line(out, "  %kizu.slice.u8 %right");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %left_len = extractvalue %kizu.slice.u8 %left, 1");
    try append_line(out, "  %right_len = extractvalue %kizu.slice.u8 %right, 1");
    try append_line(out, "  %same_len = icmp eq i64 %left_len, %right_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %left_len");
    try append_line(out, "  br i1 %done, label %true, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %left_ptr = extractvalue %kizu.slice.u8 %left, 0");
    try append_line(out, "  %right_ptr = extractvalue %kizu.slice.u8 %right, 0");
    try append_line(out, "  %left_at = getelementptr i8, ptr %left_ptr, i64 %index");
    try append_line(out, "  %right_at = getelementptr i8, ptr %right_ptr, i64 %index");
    try append_line(out, "  %left_byte = load i8, ptr %left_at");
    try append_line(out, "  %right_byte = load i8, ptr %right_at");
    try append_line(out, "  %same_byte = icmp eq i8 %left_byte, %right_byte");
    try append_line(out, "  br i1 %same_byte, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_starts_with_dash_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_starts_with_dash(");
    try append_line(out, "  %kizu.slice.u8 %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %value, 1");
    try append_line(out, "  %has_byte = icmp sgt i64 %len, 0");
    try append_line(out, "  br i1 %has_byte, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %value, 0");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_dash = icmp eq i8 %byte, 45");
    try append_line(out, "  ret i1 %is_dash");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_concat3_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__write_concat3(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %prefix,");
    try append_line(out, "  %kizu.slice.u8 %middle,");
    try append_line(out, "  %kizu.slice.u8 %suffix");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %prefix_ptr = extractvalue %kizu.slice.u8 %prefix, 0");
    try append_line(out, "  %prefix_len = extractvalue %kizu.slice.u8 %prefix, 1");
    try append_line(out, "  %middle_ptr = extractvalue %kizu.slice.u8 %middle, 0");
    try append_line(out, "  %middle_len = extractvalue %kizu.slice.u8 %middle, 1");
    try append_line(out, "  %suffix_ptr = extractvalue %kizu.slice.u8 %suffix, 0");
    try append_line(out, "  %suffix_len = extractvalue %kizu.slice.u8 %suffix, 1");
    try append_line(out, "  %prefix_middle_len = add i64 %prefix_len, %middle_len");
    try append_line(out, "  %total_len = add i64 %prefix_middle_len, %suffix_len");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %total_len)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %copy_prefix, label %alloc_failed");
    try append_line(out, "copy_prefix:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %buffer, ptr %prefix_ptr, i64 %prefix_len, i1 false)");
    try append_line(out, "  %middle_dest = getelementptr i8, ptr %buffer, i64 %prefix_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %middle_dest, ptr %middle_ptr, i64 %middle_len, i1 false)");
    try append_line(out,
        "  %suffix_dest = getelementptr i8, ptr %buffer, i64 %prefix_middle_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %suffix_dest, ptr %suffix_ptr, i64 %suffix_len, i1 false)");
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %total_len, 1");
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned %io, %kizu.slice.u8 %path, %kizu.slice.u8 %body)");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %buffer)");
    try append_line(out, "  ret %kizu.error.void %write");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_function(out: &var std::string::String) -> !void {
    try append_cli_main_header(out);
    try append_cli_main_dispatch(out);
    try append_cli_corpus_blocks(out);
    try append_cli_test_blocks(out);
    try cli_run_llvm::append_cli_run_blocks(out);
    try cli_parse_llvm::append_cli_parse_blocks(out);
    try cli_parse_llvm::append_cli_fmt_blocks(out);
    try append_cli_check_blocks(out);
    try append_cli_stage_blocks(out);
    try append_cli_error_blocks(out);
    try append_line(out, "}");
    return;
}

fn append_cli_main_header(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %argc = call i64 @kizu_rt_process_arg_count()");
    try append_line(out, "  %argc_ok = icmp eq i64 %argc, 2");
    try append_line(out, "  br i1 %argc_ok, label %load_command, label %usage");
    try append_line(out, "load_command:");
    try append_line(out, "  %command_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 0)");
    try append_line(out, "  %command_ok = extractvalue %kizu.error.slice.u8 %command_result, 0");
    try append_line(out, "  br i1 %command_ok, label %load_target, label %check_failed");
    try append_line(out, "load_target:");
    try append_line(out, "  %target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out, "  %target_ok = extractvalue %kizu.error.slice.u8 %target_result, 0");
    try append_line(out, "  br i1 %target_ok, label %dispatch, label %check_failed");
    return;
}

fn append_cli_main_dispatch(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch:");
    try append_line(out, "  %command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out, "  %target = extractvalue %kizu.error.slice.u8 %target_result, 1");
    try append_line(out,
        "  %command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %command)");
    try append_line(out, "  br i1 %command_is_flag, label %usage, label %check_target_flag");
    try append_line(out, "check_target_flag:");
    try append_line(out,
        "  %target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %target)");
    try append_line(out, "  br i1 %target_is_flag, label %usage, label %maybe_test");
    try append_line(out, "maybe_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.test, i64 0, i64 0");
    try append_line(out, "  %test_base = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test_base, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %dispatch_test, label %maybe_run");
    try append_line(out, "maybe_run:");
    try append_line(out,
        "  %run_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.run, i64 0, i64 0");
    try append_line(out, "  %run_base = insertvalue %kizu.slice.u8 poison, ptr %run_ptr, 0");
    try append_line(out, "  %run_slice = insertvalue %kizu.slice.u8 %run_base, i64 3, 1");
    try append_line(out,
        "  %is_run = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %run_slice)");
    try append_line(out, "  br i1 %is_run, label %dispatch_run, label %maybe_parse");
    try append_line(out, "maybe_parse:");
    try append_line(out,
        "  %parse_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.parse, i64 0, i64 0");
    try append_line(out, "  %parse_base = insertvalue %kizu.slice.u8 poison, ptr %parse_ptr, 0");
    try append_line(out, "  %parse_slice = insertvalue %kizu.slice.u8 %parse_base, i64 5, 1");
    try append_line(out,
        "  %is_parse = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %parse_slice)");
    try append_line(out, "  br i1 %is_parse, label %dispatch_parse, label %maybe_fmt");
    try append_line(out, "maybe_fmt:");
    try append_line(out,
        "  %fmt_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.fmt, i64 0, i64 0");
    try append_line(out, "  %fmt_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_ptr, 0");
    try append_line(out, "  %fmt_slice = insertvalue %kizu.slice.u8 %fmt_base, i64 3, 1");
    try append_line(out,
        "  %is_fmt = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %fmt_slice)");
    try append_line(out, "  br i1 %is_fmt, label %dispatch_fmt, label %match_selfhost");
    try append_line(out, "match_selfhost:");
    try append_line(out,
        "  %selfhost_ptr = getelementptr inbounds [8 x i8], ptr @.kizu.cli.selfhost, i64 0, i64 0");
    try append_line(out, "  %selfhost_base = insertvalue %kizu.slice.u8 poison, ptr %selfhost_ptr, 0");
    try append_line(out, "  %selfhost_slice = insertvalue %kizu.slice.u8 %selfhost_base, i64 8, 1");
    try append_line(out,
        "  %target_matches = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %selfhost_slice)");
    try append_line(out, "  br i1 %target_matches, label %dispatch_command, label %dispatch_corpus");
    try append_line(out, "dispatch_command:");
    try append_line(out,
        "  %check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out, "  %check_base = insertvalue %kizu.slice.u8 poison, ptr %check_ptr, 0");
    try append_line(out, "  %check_slice = insertvalue %kizu.slice.u8 %check_base, i64 5, 1");
    try append_line(out,
        "  %is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %check_slice)");
    try append_line(out, "  br i1 %is_check, label %run_check, label %maybe_stage");
    try append_line(out, "maybe_stage:");
    try append_line(out,
        "  %stage_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.stage, i64 0, i64 0");
    try append_line(out, "  %stage_base = insertvalue %kizu.slice.u8 poison, ptr %stage_ptr, 0");
    try append_line(out, "  %stage_slice = insertvalue %kizu.slice.u8 %stage_base, i64 5, 1");
    try append_line(out,
        "  %is_stage = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %stage_slice)");
    try append_line(out, "  br i1 %is_stage, label %run_stage, label %unsupported");
    return;
}

fn append_cli_corpus_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_corpus:");
    try append_line(out,
        "  %corpus_check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out,
        "  %corpus_check_base = insertvalue %kizu.slice.u8 poison, ptr %corpus_check_ptr, 0");
    try append_line(out,
        "  %corpus_check_slice = insertvalue %kizu.slice.u8 %corpus_check_base, i64 5, 1");
    try append_line(out,
        "  %corpus_is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %corpus_check_slice)");
    try append_line(out, "  br i1 %corpus_is_check, label %read_check_corpus_source, label %usage");
    try append_line(out, "read_check_corpus_source:");
    try append_line(out, "  %corpus_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %corpus_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %corpus_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %corpus_file_ok = extractvalue %kizu.error.slice.u8 %corpus_file, 0");
    try append_line(out, "  br i1 %corpus_file_ok, label %match_corpus_source, label %usage");
    try append_line(out, "match_corpus_source:");
    try append_line(out, "  %corpus_bytes = extractvalue %kizu.error.slice.u8 %corpus_file, 1");
    try append_line(out,
        "  %check_missing_index = call i64 @kizu_selfhost__parse_missing_expr_index(%kizu.slice.u8 %corpus_bytes)");
    try append_line(out, "  %check_has_missing = icmp sge i64 %check_missing_index, 0");
    try append_line(out,
        "  br i1 %check_has_missing, label %check_file_parse_error, label %check_file_assign_scan");
    try append_line(out, "check_file_assign_scan:");
    try append_line(out,
        "  %check_missing_assign = call i64 @kizu_selfhost__parse_missing_assign_index(%kizu.slice.u8 %corpus_bytes)");
    try append_line(out, "  %check_has_missing_assign = icmp sge i64 %check_missing_assign, 0");
    try append_line(out,
        "  br i1 %check_has_missing_assign, label %check_file_assign_error, label %check_file_move_scan");
    try append_line(out, "check_file_move_scan:");
    try append_line(out,
        "  %moved_name = call %kizu.slice.u8 @kizu_selfhost__cli_moved_value_name(%kizu.slice.u8 %corpus_bytes)");
    try append_line(out, "  %moved_name_len = extractvalue %kizu.slice.u8 %moved_name, 1");
    try append_line(out, "  %has_moved_name = icmp sgt i64 %moved_name_len, 0");
    try append_line(out, "  br i1 %has_moved_name, label %check_file_move_error, label %check_file_ok");
    try append_line(out, "check_file_parse_error:");
    try append_line(out,
        "  %check_parse_ok = call i1 @kizu_selfhost__parse_write_missing_expr(%kizu.owned %corpus_io, %kizu.slice.u8 %corpus_bytes, i64 %check_missing_index)");
    try append_line(out, "  br i1 %check_parse_ok, label %exit_one, label %check_failed");
    try append_line(out, "check_file_assign_error:");
    try append_line(out,
        "  %check_assign_ok = call i1 @kizu_selfhost__parse_write_missing_assign(%kizu.owned %corpus_io, %kizu.slice.u8 %corpus_bytes, i64 %check_missing_assign)");
    try append_line(out, "  br i1 %check_assign_ok, label %exit_one, label %check_failed");
    try append_line(out, "check_file_move_error:");
    try append_global_slice(out, "move_prefix", "text", "move_prefix", "32");
    try append_line(out,
        "  %move_prefix_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %corpus_io, %kizu.slice.u8 %move_prefix_text_slice)");
    try append_line(out, "  %move_prefix_ok = extractvalue %kizu.error.void %move_prefix_write, 0");
    try append_line(out, "  br i1 %move_prefix_ok, label %check_file_move_name, label %check_failed");
    try append_line(out, "check_file_move_name:");
    try append_line(out,
        "  %move_name_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %corpus_io, %kizu.slice.u8 %moved_name)");
    try append_line(out, "  %move_name_ok = extractvalue %kizu.error.void %move_name_write, 0");
    try append_line(out, "  br i1 %move_name_ok, label %check_file_move_suffix, label %check_failed");
    try append_line(out, "check_file_move_suffix:");
    try append_global_slice(out, "move_suffix", "text", "move_suffix", "11");
    try append_line(out,
        "  %move_suffix_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %corpus_io, %kizu.slice.u8 %move_suffix_text_slice)");
    try append_line(out, "  %move_suffix_ok = extractvalue %kizu.error.void %move_suffix_write, 0");
    try append_line(out, "  br i1 %move_suffix_ok, label %exit_one, label %check_failed");
    try append_line(out, "check_file_ok:");
    try append_line(out,
        "  %check_file_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out,
        "  %check_file_ok_base = insertvalue %kizu.slice.u8 poison, ptr %check_file_ok_ptr, 0");
    try append_line(out,
        "  %check_file_ok_slice = insertvalue %kizu.slice.u8 %check_file_ok_base, i64 10, 1");
    try append_line(out,
        "  %check_file_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %corpus_io, %kizu.slice.u8 %check_file_ok_slice)");
    try append_line(out, "  %check_file_write_ok = extractvalue %kizu.error.void %check_file_write, 0");
    try append_line(out, "  br i1 %check_file_write_ok, label %exit_zero, label %check_failed");
    try append_line(out, "exit_one:");
    try append_line(out, "  %one_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %one_code");
    return;
}

fn append_cli_test_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_test:");
    try append_line(out, "  %test_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %test_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %test_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %test_file_ok = extractvalue %kizu.error.slice.u8 %test_file, 0");
    try append_line(out, "  br i1 %test_file_ok, label %test_read_ok, label %check_failed");
    try append_line(out, "test_read_ok:");
    try append_line(out, "  %test_bytes = extractvalue %kizu.error.slice.u8 %test_file, 1");
    try append_line(out,
        "  %test_expect_value = call i64 @kizu_selfhost__cli_test_expect_value(%kizu.slice.u8 %test_bytes)");
    try append_line(out, "  %test_ok_found = icmp eq i64 %test_expect_value, 1");
    try append_line(out, "  br i1 %test_ok_found, label %test_ok_emit, label %maybe_test_failure");
    try append_line(out, "maybe_test_failure:");
    try append_line(out, "  %test_failure_found = icmp eq i64 %test_expect_value, 0");
    try append_line(out, "  br i1 %test_failure_found, label %test_failure_emit, label %usage");
    try append_test_ok_emit_block(out);
    try append_test_failure_emit_block(out);
    return;
}

fn append_test_ok_emit_block(out: &var std::string::String) -> !void {
    try append_line(out, "test_ok_emit:");
