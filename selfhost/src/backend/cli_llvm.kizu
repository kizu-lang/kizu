    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes(" = call %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_unsupported_run_ast(%kizu.slice.u8 %");
    try out.append_bytes(value_name);
    try out.append_bytes("_empty)");
    try out.append_byte(cast<u8>(10));
    try append_run_ast_success_return(out, value_name);
    return;
}

fn append_lower_try_void_block_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_try_void_block(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.child_range %declarations,");
    try append_line(out, "  %kizu.slice.u8 %function_name,");
    try append_line(out, "  %kizu.kizu.ast.child_range %statements");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %statement_len = extractvalue %kizu.kizu.ast.child_range %statements, 1");
    try append_line(out, "  %three_statements = icmp eq i64 %statement_len, 3");
    try append_line(out, "  br i1 %three_statements, label %load_try, label %unsupported");
    try append_line(out, "load_try:");
    try append_line(out, "  %try_statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %try_statement_ok = extractvalue %kizu.error.node_id %try_statement_result, 0");
    try append_line(out, "  br i1 %try_statement_ok, label %try_statement_bound, label %try_statement_fail");
    try append_line(out, "try_statement_bound:");
    try append_line(out, "  %try_statement = extractvalue %kizu.error.node_id %try_statement_result, 1");
    try append_line(out, "  %try_callee = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_try_void_statement_callee(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %try_statement)");
    try append_line(out, "  %try_callee_len = extractvalue %kizu.slice.u8 %try_callee, 1");
    try append_line(out, "  %try_callee_present = icmp ne i64 %try_callee_len, 0");
    try append_line(out, "  br i1 %try_callee_present, label %helper_exit, label %unsupported");
    try append_line(out, "helper_exit:");
    try append_line(out, "  %helper_result = call %kizu.error.i64 @kizu_selfhost__ir_codegen_try_void_helper_exit_code(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %declarations, %kizu.slice.u8 %try_callee)");
    try append_line(out, "  %helper_ok = extractvalue %kizu.error.i64 %helper_result, 0");
    try append_line(out, "  br i1 %helper_ok, label %helper_bound, label %helper_fail");
    try append_line(out, "helper_bound:");
    try append_line(out, "  %helper_exit_code = extractvalue %kizu.error.i64 %helper_result, 1");
    try append_line(out, "  %helper_supported = icmp sge i64 %helper_exit_code, 0");
    try append_line(out, "  br i1 %helper_supported, label %load_print, label %unsupported");
    try append_line(out, "load_print:");
    try append_line(out, "  %print_statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 1)");
    try append_line(out, "  %print_statement_ok = extractvalue %kizu.error.node_id %print_statement_result, 0");
    try append_line(out, "  br i1 %print_statement_ok, label %print_statement_bound, label %print_statement_fail");
    try append_line(out, "print_statement_bound:");
    try append_line(out, "  %print_statement = extractvalue %kizu.error.node_id %print_statement_result, 1");
    try append_line(out, "  %payload_result = call %kizu.error.payload_span @kizu_selfhost__ir_codegen_print_statement_payload(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %print_statement)");
    try append_line(out, "  %payload_ok = extractvalue %kizu.error.payload_span %payload_result, 0");
    try append_line(out, "  br i1 %payload_ok, label %payload_bound, label %payload_fail");
    try append_line(out, "payload_bound:");
    try append_line(out, "  %payload = extractvalue %kizu.error.payload_span %payload_result, 1");
    try append_line(out, "  %payload_start = extractvalue %kizu.selfhost.codegen.payload_span %payload, 0");
    try append_line(out, "  %payload_end = extractvalue %kizu.selfhost.codegen.payload_span %payload, 1");
    try append_line(out, "  %payload_bad = icmp slt i64 %payload_start, 0");
    try append_line(out, "  br i1 %payload_bad, label %unsupported, label %payload_len");
    try append_line(out, "payload_len:");
    try append_line(out, "  %payload_byte_len = sub i64 %payload_end, %payload_start");
    try append_line(out, "  %payload_present = icmp ne i64 %payload_byte_len, 0");
    try append_line(out, "  br i1 %payload_present, label %load_return, label %unsupported");
    try append_line(out, "load_return:");
    try append_line(out, "  %return_statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 2)");
    try append_line(out, "  %return_statement_ok = extractvalue %kizu.error.node_id %return_statement_result, 0");
    try append_line(out, "  br i1 %return_statement_ok, label %return_statement_bound, label %return_statement_fail");
    try append_line(out, "return_statement_bound:");
    try append_line(out, "  %return_statement = extractvalue %kizu.error.node_id %return_statement_result, 1");
    try append_line(out, "  %return_ok = call i1 @kizu_selfhost__ir_codegen_return_void_statement_ok(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %return_statement)");
    try append_line(out, "  br i1 %return_ok, label %build, label %unsupported");
    try append_line(out, "build:");
    try append_line(out, "  %text_ptr = extractvalue %kizu.slice.u8 %text, 0");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %text_ptr, i64 %payload_start");
    try append_line(out, "  %payload_text_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload_text = insertvalue %kizu.slice.u8 %payload_text_base, i64 %payload_byte_len, 1");
    try append_line(out, "  %print_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.run_print, i64 0, i64 0");
    try append_line(out, "  %print_base = insertvalue %kizu.slice.u8 poison, ptr %print_ptr, 0");
    try append_line(out, "  %print_slice = insertvalue %kizu.slice.u8 %print_base, i64 5, 1");
    try append_line(out, "  %run_ast = call %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_try_void_run_ast(%kizu.slice.u8 %function_name, i64 %statement_len, %kizu.slice.u8 %print_slice, %kizu.slice.u8 %payload_text, %kizu.slice.u8 %try_callee, i64 %helper_exit_code)");
    try append_run_ast_success_return(out, "run_ast");
    try append_line(out, "try_statement_fail:");
    try append_run_ast_child_fail_return(out, "try_statement_result");
    try append_line(out, "print_statement_fail:");
    try append_run_ast_child_fail_return(out, "print_statement_result");
    try append_line(out, "return_statement_fail:");
    try append_run_ast_child_fail_return(out, "return_statement_result");
    try append_line(out, "helper_fail:");
    try append_run_ast_error_union_fail_return(out, "helper_result", "%kizu.error.i64");
    try append_line(out, "payload_fail:");
    try append_run_ast_error_union_fail_return(out, "payload_result", "%kizu.error.payload_span");
    try append_line(out, "unsupported:");
    try append_unsupported_run_ast_success_return(out, "unsupported_try_void");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_lower_fs_read_block_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let let_tag = try ast_data_tag(ir_bytes, "Let");
    let call_tag = try ast_data_tag(ir_bytes, "Call");
    let try_tag = try ast_data_tag(ir_bytes, "TryExpr");
    let expr_stmt_tag = try ast_data_tag(ir_bytes, "ExprStmt");
    let return_tag = try ast_data_tag(ir_bytes, "Return");
    try append_line(out, "define %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_fs_read_block(");
    try append_line(out, "  %kizu.slice.u8 %text,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %function_name,");
    try append_line(out, "  %kizu.kizu.ast.child_range %statements");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %statement_len = extractvalue %kizu.kizu.ast.child_range %statements, 1");
    try append_line(out, "  %four_statements = icmp eq i64 %statement_len, 4");
    try append_line(out, "  br i1 %four_statements, label %load_io, label %unsupported");
    try append_line(out, "load_io:");
    try append_line(out,
        "  %io_statement_result = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.child_range %statements, i64 0)");
    try append_line(out, "  %io_statement_ok = extractvalue %kizu.error.node_id %io_statement_result, 0");
    try append_line(out, "  br i1 %io_statement_ok, label %check_io_let, label %io_statement_fail");
    try append_line(out, "check_io_let:");
    try append_line(out, "  %io_statement = extractvalue %kizu.error.node_id %io_statement_result, 1");
    try append_line(out, "  %io_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %io_statement)");
    try append_line(out, "  %io_data = extractvalue %kizu.kizu.ast.ast_node %io_node, 1");
    try append_line(out, "  %io_tag = extractvalue %kizu.kizu.ast.ast_data %io_data, 0");
    try out.append_bytes("  %io_is_let = icmp eq i64 %io_tag, ");
    try std::fmt::append_i64(out, let_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %io_is_let, label %io_let_payload, label %unsupported");
    try append_line(out, "io_let_payload:");
    try append_line(out, "  %io_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %io_data, ptr %io_slot, align 8");
    try append_line(out, "  %io_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %io_slot, i32 0, i32 1");
    try append_line(out, "  %io_payload = load %kizu.kizu.ast.let_node, ptr %io_payload_ptr, align 8");
    try append_line(out, "  %io_mutable = extractvalue %kizu.kizu.ast.let_node %io_payload, 0");
    try append_line(out, "  br i1 %io_mutable, label %unsupported, label %check_io_name");
    try append_line(out, "check_io_name:");
    try append_line(out, "  %io_name_node = extractvalue %kizu.kizu.ast.let_node %io_payload, 1");
    try append_line(out, "  %io_name = call %kizu.slice.u8 @kizu_selfhost__ir_codegen_ast_node_text(%kizu.slice.u8 %text, %kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %io_name_node)");
    try append_line(out, "  %io_name_len = extractvalue %kizu.slice.u8 %io_name, 1");
    try append_line(out, "  %io_name_present = icmp ne i64 %io_name_len, 0");
    try append_line(out, "  br i1 %io_name_present, label %check_io_call, label %unsupported");
    try append_line(out, "check_io_call:");
    try append_line(out, "  %io_value = extractvalue %kizu.kizu.ast.let_node %io_payload, 2");
    try append_line(out, "  %io_value_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %io_value)");
    try append_line(out, "  %io_value_data = extractvalue %kizu.kizu.ast.ast_node %io_value_node, 1");
    try append_line(out, "  %io_value_tag = extractvalue %kizu.kizu.ast.ast_data %io_value_data, 0");
    try out.append_bytes("  %io_value_is_call = icmp eq i64 %io_value_tag, ");
    try std::fmt::append_i64(out, call_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %io_value_is_call, label %io_call_payload, label %unsupported");
