fn append_unsupported_run_ast_success_return(out: &var std::string::String, value_name: []u8) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_text_ptr = extractvalue %kizu.slice.u8 %text, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_empty_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(value_name);
    try out.append_bytes("_text_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes("_empty = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(value_name);
    try out.append_bytes("_empty_base, i64 0, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value_name);
    try out.append_bytes(" = call %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_unsupported_run_ast(%kizu.slice.u8 %");
    try out.append_bytes(value_name);
    try out.append_bytes("_empty)");
    try out.append_byte(cast<u8>(10));
    try append_run_ast_success_return(out, value_name);
    return;
}

pub fn append_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    try append_slice_equal_function(out);
    try append_slice_len_function(out);
    try append_slice_starts_with_dash_function(out);
    try append_write_concat3_function(out);
    try cli_artifact_dir_llvm::append_functions(out);
    try cli_artifact_path_llvm::append_functions(out);
    try cli_ast_boundary_llvm::append_functions(out);
    try cli_codegen_llvm::append_functions(out, ir_bytes);
    try cli_run_llvm::append_functions(out, ir_bytes);
    try cli_parse_llvm::append_functions(out);
    try cli_check_gate_llvm::append_functions(out);
    try cli_match_llvm::append_functions(out);
    try cli_test_ast_llvm::append_functions(out);
    try cli_test_llvm::append_functions(out, ir_bytes);
    // The selfhost::ir::codegen run codegen IR v1 tape closure compiled into stage2:
    // the shared BFS walks the cluster from the tape lowering root lower_code_module
    // plus the code_op_mem_page_allocator opcode accessor, deriving each member's llvm
    // symbol and params_spec from signature facts. The hosted per-shape Program builder
    // roots were severed once shape emit became closure-excluded (issue 1255 slice4 PR-1).
    try append_codegen_reachable_compiled_functions(out, lookup_index, ir_bytes);
    // The selfhost::ir::code_render run tape renderer closure compiled into stage2:
    // render_run_artifact lowers a parsed run source to the tape (via the codegen
    // closure's lower_code_module) and renders it to the executable LLVM module text,
    // the generic replacement for the per-shape hosted run renderers.
    try append_code_render_reachable_compiled_functions(out, lookup_index, ir_bytes);
    // artifact_path is the first selfhost std::string::String builder compiled into
    // stage2 (issue 1165 slice 1): it lowers through the generic multi-statement path,
    // calling the runtime string intrinsics to concatenate the directory, the borrowed
    // artifact_stem subslice, and the suffix, then returns the owned String error union.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "selfhost::backend::hosted::artifact_path",
        "kizu_selfhost__backend_hosted_artifact_path",
        "%kizu.owned allocator;%kizu.slice.u8 directory;%kizu.slice.u8 source_path;%kizu.slice.u8 suffix"
    );
    try cli_run_i64_codegen_llvm::append_functions(out, ir_bytes);
    // empty_int_env is the first compiled function that takes a real
    // std::kizu::ast value type (ChildRange) as a parameter and stores it into a
    // struct field, establishing the read-only AST value-type foundation in stage2
    // (tracker 961). The ChildRange is forwarded as a whole aggregate into the
    // IntEnv insertvalue chain; no AstNode/AstData union access is involved.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "selfhost::ir::codegen::empty_int_env",
        "kizu_selfhost__ir_codegen_empty_int_env",
        "%kizu.slice.u8 text;%kizu.kizu.ast.child_range decls"
    );
    // std::kizu::ast::Ast.len is the first real AST read-only accessor compiled into
    // stage2 (tracker 961). It takes the Ast container value as a parameter, reads
    // its children Array field (struct field index 1), and returns the Array length
    // via the array_len builtin. It is the method-call lowering counterpart to the
    // empty_int_env value-type foundation: no AstNode/AstData union, Arena.get,
    // array_get, or error-union return is involved.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_len",
        "kizu_kizu__ast_ast_len",
        "%kizu.kizu.ast.ast self"
    );
    // Diagnostic.related_get is the first checked Array<T>.get accessor compiled
    // into stage2 (tracker 961): it reads the related Array<RelatedSpan> field
    // (struct field index 2) and returns a single RelatedSpan by value as
    // !RelatedSpan via the checked @kizu_rt_array_at runtime call, with a real
    // error-union failure return (never unreachable) on an out-of-bounds index.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::diagnostic::diagnostic_related_get",
        "kizu_kizu__diagnostic_diagnostic_related_get",
        "%kizu.kizu.diagnostic.diagnostic self;i64 index"
    );
    // Ast.child_at is the first multi-statement Array<T>.get consumer compiled into
    // stage2 (tracker 961): a bounds-check 'if' with a real return error(...) failure
    // return, then 'return self.children.get(range.start + index);' lowered to the
    // checked @kizu_rt_array_at accessor returning !NodeId.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_child_at",
        "kizu_kizu__ast_ast_child_at",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.child_range range;i64 index"
    );
    // Ast.add_node is the first AstNode/AstData tagged-union constructor compiled into
    // stage2 (tracker 961): it builds an AstNode (Span + AstData union value forwarded
    // whole) and appends it to the nodes Arena via the heap-backed @kizu_rt_arena_add,
    // binding the returned NodeId. It exercises the union value-type ABI without
    // modelling the 44 variant payload structs.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_node",
        "kizu_kizu__ast_ast_add_node",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;%kizu.kizu.ast.ast_data data"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_bool",
        "kizu_kizu__ast_ast_add_bool",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;i1 value"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_empty",
        "kizu_kizu__ast_ast_add_empty",
        "%kizu.kizu.ast.ast self;i64 at"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_int",
        "kizu_kizu__ast_ast_add_int",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;%kizu.kizu.ast.token_id token"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_string",
        "kizu_kizu__ast_ast_add_string",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;%kizu.kizu.ast.token_id token"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_type_name",
        "kizu_kizu__ast_ast_add_type_name",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;%kizu.kizu.ast.symbol_id name"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_var_with_doc",
        "kizu_kizu__ast_ast_add_var_with_doc",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;%kizu.kizu.ast.symbol_id name;%kizu.kizu.ast.span doc"
    );
    // issue 1157 NEW-A child-array mutators: begin_children opens the range, add_child appends a
    // NodeId through the self.children Array field, and finish_children closes the range with a
    // computed ChildRange.len. add_call builds the C2 CallNode payload from callee + ChildRange.
    // These compiled roots keep the NEW-A synth fixtures on the real method bodies.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_begin_children",
        "kizu_kizu__ast_ast_begin_children",
        "%kizu.kizu.ast.ast self"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_child",
        "kizu_kizu__ast_ast_add_child",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.node_id child"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_finish_children",
        "kizu_kizu__ast_ast_finish_children",
        "%kizu.kizu.ast.ast self;i64 start"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_add_call",
        "kizu_kizu__ast_ast_add_call",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.span span_value;%kizu.kizu.ast.node_id callee;%kizu.kizu.ast.child_range args"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::token_id",
        "kizu_kizu__ast_token_id",
        "i64 raw"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::symbol_id",
        "kizu_kizu__ast_symbol_id",
        "i64 raw"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::span",
        "kizu_kizu__ast_span",
        "i64 start;i64 end"
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::parse_result",
        "kizu_kizu__ast_parse_result",
        "%kizu.kizu.ast.ast ast;%kizu.kizu.ast.node_id root"
    );
    // The BinaryOp constant accessors are single enum-field returns compiled for the
    // run codegen tape lowering (code_binary_kind), so the tape's operator mapping
    // calls real compiled std::kizu::ast functions instead of a handwritten tag table.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_add",
        "kizu_kizu__ast_binary_add",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_sub",
        "kizu_kizu__ast_binary_sub",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_mul",
        "kizu_kizu__ast_binary_mul",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_div",
        "kizu_kizu__ast_binary_div",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_mod",
        "kizu_kizu__ast_binary_mod",
        ""
    );
    // The comparison BinaryOp accessors back the run codegen tape's if-condition
    // lowering; they compile through the same enum-field-return path.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_eq",
        "kizu_kizu__ast_binary_eq",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_not_eq",
        "kizu_kizu__ast_binary_not_eq",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_lt",
        "kizu_kizu__ast_binary_lt",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_lte",
        "kizu_kizu__ast_binary_lte",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_gt",
        "kizu_kizu__ast_binary_gt",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_gte",
        "kizu_kizu__ast_binary_gte",
        ""
    );
    // The logical BinaryOp accessors back the run codegen tape's short-circuit
    // and/or routing (lower_code_binary -> lower_code_logical), and prefix_not
    // backs its logical-not lowering (lower_code_prefix); each compiles through
    // the same enum-field-return path as the accessors above.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_and",
        "kizu_kizu__ast_binary_and",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::binary_or",
        "kizu_kizu__ast_binary_or",
        ""
    );
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::prefix_not",
        "kizu_kizu__ast_prefix_not",
        ""
    );
    // prefix_borrow backs the run codegen tape's read-borrow lowering
    // (lower_code_prefix); it compiles through the same enum-field-return path as
    // prefix_not above.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::prefix_borrow",
        "kizu_kizu__ast_prefix_borrow",
        ""
    );
    // prefix_mut_borrow backs the run codegen tape's scalar '&var i64' write-back
    // lowering (lower_code_prefix); it compiles through the same enum-field-return
    // path as prefix_borrow above.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::prefix_mut_borrow",
        "kizu_kizu__ast_prefix_mut_borrow",
        ""
    );
    // Ast.get is the first Arena<T>.get accessor compiled into stage2 (tracker 961): it
    // reads an AstNode back out of the nodes Arena by value via the checked
    // @kizu_rt_arena_get, reusing the AstNode/AstData union value-type ABI, and traps on
    // an out-of-bounds NodeId index.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::ast::ast_get",
        "kizu_kizu__ast_ast_get",
        "%kizu.kizu.ast.ast self;%kizu.kizu.ast.node_id id"
    );
    // The selfhost::ast node-count traversal closure compiled into stage2 (tracker
    // 961): declaration_count is the standalone match-over-AstData read (Ast.get +
    // Program-arm program.declarations.len), and node_count is the 45-arm
    // match-over-AstData traversal seeding the mutually-recursive count_* cluster
    // (count_range the two-phi Ast.child_at + node_count accumulator loop, the rest
    // let-try / return-try arithmetic). The shared BFS walks the whole cluster from
    // these two seeds and links selfhost.ll with no undefined symbol; each member's
    // llvm symbol and params_spec are derived from signature facts.
    try append_ast_reachable_compiled_functions(out, lookup_index, ir_bytes);
    // std::mem::is_ascii_space backs the ast_node_text span accessor's trim (tracker 961):
    // an or-chain byte classifier returning i1. It lowers through the single-statement
    // expression-return path (the binary renderer already handles or / eq).
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::mem::is_ascii_space",
        "kizu_std__mem_is_ascii_space",
        "i8 byte"
    );
    // std::mem::trim_ascii and ast_node_text are the span-based text slicing accessors the
    // run-codegen AST traversal depends on (tracker 961). ast_node_text calls trim_ascii calls
    // is_ascii_space; the whole chain is registered together so selfhost.ll links.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::mem::trim_ascii",
        "kizu_std__mem_trim_ascii",
        "%kizu.slice.u8 bytes"
    );
    // std::mem::starts_with is the shared slice-prefix predicate used by selfhost source helpers.
    // Compiling it here gives stdlib-symbol callers a selfhost-owned checked-index loop.
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::mem::starts_with",
        "kizu_std__mem_starts_with",
        "%kizu.slice.u8 bytes;%kizu.slice.u8 prefix"
    );
    try append_types_checker_reachable_compiled_functions(out, lookup_index, ir_bytes);
    // first_token / next_token seed the std::kizu::lexer tokenizer helper closure. The closure
    // reaches token_at, raw_token_at, scan helpers, Token constructors, position tracking, and byte
    // classifiers while leaving tokenize manual because it contains method calls on Array.
    try append_kizu_lexer_reachable_compiled_functions(out, lookup_index, ir_bytes);
    // tokenize(allocator, source) -> !Array<Token> builds the token stream feeding the parser
    // (tracker 961, scope 4 prerequisite). Its body now lowers through the generic multi-statement
    // path: lower_multi_statement_function recognises the value-carried array-append loop shape
    // structurally and emits a generic ArrayNew + ValueWhile, with no name-based dispatch and no
    // MirTokenizeStmt (issue 1165). Its return type is derived from the signature fact like every
    // other compiled closure member: the compiled type lowering maps every !std::array::Array<T>
    // to %kizu.error.owned via a single prefix rule (issue 1165 slice 2).
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "std::kizu::lexer::tokenize",
        "kizu_kizu__lexer_tokenize",
        "%kizu.owned allocator;%kizu.slice.u8 source"
    );
    // The std::kizu::parser predicate / byte / span helper closure compiled into
    // stage2 (tracker 961, scope 4 prerequisite). The TokenKind predicates match a
    // Token's kind field and return bool; the byte/span helpers guard token spans,
    // load checked slice bytes, and classify name/namespace/struct-literal spans.
    // The shared BFS walks the whole cluster from the standalone predicate seeds
    // plus the two postfix roots (is_type_apply_start / is_struct_literal_start),
    // which pull in is_lt_token / is_single_token_byte / is_namespace_path_span /
    // is_struct_literal_type_span / is_name_byte / is_upper_byte / is_double_colon_at
    // through their body callees and admit the external std::kizu::ast Ast.get
    // accessor (spelled ast.get). Each member's llvm symbol and params_spec are
    // derived from signature facts, so the cluster no longer needs a handwritten
    // append_compiled_function_auto per helper.
    try append_kizu_parser_reachable_compiled_functions(out, lookup_index, ir_bytes);
    // ast_node_text is emitted by the codegen closure BFS (reached from the run
    // tape descent seed lower_code_expr), so it no longer needs an explicit
    // registration here.
    try append_lexer_reachable_compiled_functions(out, lookup_index, ir_bytes);
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out, ir_bytes,
        "selfhost::backend::hosted::hosted_output_len",
        "kizu_selfhost__hosted_output_len",
        "%kizu.slice.u8 output_payload;i1 append_newline"
    );
    try append_source_reachable_compiled_functions(out, lookup_index, ir_bytes);
    try append_loader_reachable_compiled_functions(out, lookup_index, ir_bytes);
    // The selfhost::parser::format read-only helper closure compiled into stage2
    // (issue 1165 / issue 1162): the TokenKind predicates that classify a single
    // token and token_text, the span-slice accessor. They lower through the shared
    // token-kind predicate MIR and the generic single-statement expression path; the
    // BFS derives each member's llvm symbol and params_spec from signature facts. This
    // is the first formatter component on the compiled path, exercising the read-only
    // helpers ahead of the token-array loop / import-sort helpers that still wait on
    // local/param Array<T> read lowering.
    try append_format_reachable_compiled_functions(out, lookup_index, ir_bytes);
    try append_cli_main_function(out, ir_bytes);
    return;
}

fn append_source_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("is_source_code");
    try pending.append("is_frontend_source");
    try pending.append("module_path");
    try pending.append("is_absolute_name_for_file");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "selfhost::source::",
        &var pending,
        false
    );
    pending.deinit();
    return;
}

fn append_types_checker_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("first_hosted_check_undefined_variable_start_ast_node");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "selfhost::types::checker::",
        &var pending,
        false
    );
    pending.deinit();
    return;
}

// append_ast_reachable_compiled_functions emits the selfhost::ast node-count
// traversal closure through the shared BFS. declaration_count and node_count are the
// two entry points: declaration_count is the standalone match-over-AstData read, and
// node_count seeds the mutually-recursive count_* cluster (count_range, count_one,
// count_two, count_three, count_five, count_with_range, count_node_with_range,
// count_named_range, count_named_ranges, count_fn_decl_parts). The BFS derives each
// member's llvm symbol and params_spec from signature facts and admits the external
// std::kizu::ast Ast.get / Ast.child_at accessors, which are compiled separately, so
// the cluster no longer needs a handwritten append_compiled_function_auto per member.
fn append_ast_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("declaration_count");
    try pending.append("node_count");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "selfhost::ast::",
        &var pending,
        false
    );
    pending.deinit();
    return;
}

fn compiled_closure_name_seen(
    names: &std::array::Array<[]u8>,
    name: []u8
) -> !bool {
    var index = 0;
    while index < names.len() {
        let existing = try names.get(index);
        if std::mem::equal_bytes(existing, name) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// append_component_reachable_compiled_functions walks one component's compiled
// closure breadth-first from its seed members. Each pending local name is emitted
// once and its body callees are queued through the shared collector, so the
// source, loader, std lexer, and selfhost lexer closures share a single BFS. The
// allow_empty_params flag lets the selfhost::lexer closure admit the parameterless
// invalid_token_display member while the other components keep the missing-params
// guard.
fn append_component_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    prefix: []u8,
    pending: &var std::array::Array<[]u8>,
    allow_empty_params: bool
) -> !void {
    var emitted = std::array::Array<[]u8>(std::mem::page_allocator());
    var index = 0;
    while index < pending.len() {
        let local_name = try pending.get(index);
        if !(try compiled_closure_name_seen(&emitted, local_name)) {
            try append_component_compiled_closure_member(
                out,
                lookup_index,
                ir_bytes,
                prefix,
                local_name,
                allow_empty_params
            );
            try collect_component_compiled_callees(lookup_index, ir_bytes, prefix, local_name, pending);
            try emitted.append(local_name);
        }
        index = index + 1;
    }
    emitted.deinit();
    return;
}

// append_component_compiled_closure_member emits the LLVM definition for one
// compiled closure member. The fully qualified name is built from the component
// prefix plus the local name, and the params_spec and llvm_symbol are derived from
// the IR signature facts. allow_empty_params keeps the parameterless
// selfhost::lexer member invalid_token_display while every other component rejects
// an empty params_spec as a missing-signature error.
fn append_component_compiled_closure_member(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    prefix: []u8,
    local_name: []u8,
    allow_empty_params: bool
) -> !void {
    var function_name = std::string::String(std::mem::page_allocator());
    defer function_name.deinit();
    try append_component_qualified_name(&var function_name, prefix, local_name);
    let function_name_bytes = function_name.as_bytes();
    try emit_compiled_closure_member(
        out, lookup_index, ir_bytes, function_name_bytes, allow_empty_params
    );
    return;
}

// emit_compiled_closure_member writes the LLVM definition for one compiled closure
// member from its fully qualified name. The name arrives as a borrow so the
// component member builder can construct it from the prefix plus the local name
// without the borrowed view escaping into the plain []u8 helper parameters. The
// params_spec is derived from the IR signature facts and an empty result is only
// tolerated when allow_empty_params is set (the parameterless selfhost::lexer
// member invalid_token_display); otherwise it is a missing-signature error.
fn emit_compiled_closure_member(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: &[]u8,
    allow_empty_params: bool
) -> !void {
    let name = function_name.*;
    var params_spec = std::string::String(std::mem::page_allocator());
    defer params_spec.deinit();
    try compiled_abi_params::append_params_spec(&var params_spec, ir_bytes, name);
    if params_spec.len() == 0 and !allow_empty_params {
        return error("compiled closure: missing signature params");
    }
    let params_spec_bytes = params_spec.as_bytes();
    var llvm_symbol = std::string::String(std::mem::page_allocator());
    defer llvm_symbol.deinit();
    try compiled_signature::append_function_llvm_symbol(&var llvm_symbol, name);
    let llvm_symbol_bytes = llvm_symbol.as_bytes();
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index,
        out,
        ir_bytes,
        name,
        llvm_symbol_bytes,
        params_spec_bytes
    );
    return;
}

// collect_component_compiled_callees gathers the body callees of one compiled
// closure member into the BFS pending queue. The qualified name is rebuilt from
// the component prefix plus the local name, then every Call node in the body is
// classified against the prefix so a single collector serves the source, loader,
// std lexer, and selfhost lexer closures.
fn collect_component_compiled_callees(
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    prefix: []u8,
    local_name: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    var function_name = std::string::String(std::mem::page_allocator());
    defer function_name.deinit();
    try append_component_qualified_name(&var function_name, prefix, local_name);
    let function_name_bytes = function_name.as_bytes();
    try collect_component_compiled_body_callees(lookup_index, ir_bytes, prefix, function_name_bytes, pending);
    return;
}

fn collect_component_compiled_body_callees(
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    prefix: []u8,
    function_name: &[]u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    let name = function_name.*;
    let body_start = ir_contract::body_facts_start(ir_bytes, name);
    let count = try ir_contract::body_node_count_from(ir_bytes, name, body_start);
    var sequence = 0;
    while sequence < count {
        let kind = try ir_contract::body_node_kind_from(ir_bytes, name, sequence, body_start);
        if std::mem::equal_bytes(kind, "Call") {
            let callee = try ir_contract::body_call_callee_or_empty_from(
                ir_bytes,
                name,
                sequence,
                body_start
            );
            try collect_component_compiled_callee(lookup_index, ir_bytes, prefix, callee, pending);
        }
        sequence = sequence + 1;
    }
    return;
}

// collect_component_compiled_callee classifies one callee relative to the
// component prefix. std::mem callees are intrinsic and ignored. The narrow set of
// external accessors compiled separately into selfhost.ll (the std::kizu::ast read
// accessors, called as tree.get / tree.child_at) is admitted without expansion
// so the BFS neither re-emits nor walks them. A callee inside the component prefix
// contributes its local name once the IR facts confirm the helper, while a nested
// sub-namespace under the prefix or any other qualified callee is rejected as an
// explicit error. A bare local name is also resolved through the IR facts so nothing
// is treated as supported without a signature.
fn collect_component_compiled_callee(
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    prefix: []u8,
    callee: []u8,
    pending: &var std::array::Array<[]u8>
) -> !void {
    if std::mem::starts_with(callee, "std::mem::") {
        return;
    }
    // 'error(<message>)' is the error-union builtin lowered inline as a return-error
    // statement, not a component function, so the BFS neither emits nor walks it.
    if std::mem::equal_bytes(callee, "error") {
        return;
    }
    if compiled_external_accessor_allowed(prefix, callee) {
        return;
    }
    // An Array<T> element method (indices.len() / indices.get(...) / indices.set(...)) is a
    // runtime builtin lowered inline through the element-size-generic array ABI, not a
    // component function, so the BFS neither emits nor walks it (issue 1165).
    if compiled_callee_is_array_element_method(callee) {
        return;
    }
    // A std::string::String constructor / mutator (std::string::String(allocator),
    // out.append_bytes(...) / out.append_byte(...)) is a runtime builtin lowered inline through
    // the @kizu_rt_string_* ABI, not a component function, so the BFS neither emits nor walks it
    // (issue 1165).
    if std::mem::equal_bytes(callee, "std::string::String") {
        return;
    }
    if compiled_callee_is_string_mutator_method(callee) {
        return;
    }
    // Owned container deinit calls lower inline through @kizu_rt_owned_deinit. They are value
    // methods, not component functions; accepting the method shape keeps Array/String cleanup out
    // of the BFS without tying the rule to one receiver name.
    if compiled_callee_is_owned_deinit_method(callee) {
        return;
    }
    // The std::array::Array<T>(<allocator>) constructor is the element-size-generic
    // @kizu_rt_array_new runtime builtin lowered inline, not a component function, so the BFS
    // neither emits nor walks it (issue 1165).
    if std::mem::starts_with(callee, "std::array::Array") {
        return;
    }
    if std::mem::starts_with(callee, prefix) {
        let local = callee[std::mem::len(prefix)..std::mem::len(callee)];
        if compiled_callee_has_namespace(local) {
            return error("compiled closure: unsupported nested callee");
        }
        if !component_compiled_local_present(lookup_index, ir_bytes, prefix, local) {
            return error("compiled closure: unsupported local helper");
        }
        try pending.append(local);
        return;
    }
    if compiled_callee_has_namespace(callee) {
        return error("compiled closure: unsupported qualified callee");
    }
    if component_compiled_local_present(lookup_index, ir_bytes, prefix, callee) {
        try pending.append(callee);
        return;
    }
    return error("compiled closure: unsupported callee");
}

// compiled_external_accessor_allowed reports whether a compiled closure callee names an
// external function already emitted elsewhere in selfhost.ll. The policy is prefix-limited
// exact match so nothing is admitted by fallback. Under std::kizu::parser:: the accepted
// names are the issue 1157 parser AST/lexer connection list from std/src/kizu/parser.kizu;
// under selfhost::ast:: only tree.get and tree.child_at are accepted. Every other
// cross-component callee stays an explicit error.
fn compiled_external_accessor_allowed(prefix: []u8, callee: []u8) -> bool {
    if std::mem::equal_bytes(prefix, "selfhost::parser::format::") {
        // The formatter token-array predicates call lexer::is_eof (std::kizu::lexer Token
        // EOF predicate) through the 'lexer' import alias. It is emitted by the std lexer
        // compiled closure, so the format closure references it without re-emitting or
        // walking it (issue 1165). The formatter driver also tokenizes its input through
        // lexer::tokenize; production emits the tokenizer as std::kizu::lexer::tokenize, so the
        // format closure treats that alias as the same external boundary.
        return std::mem::equal_bytes(callee, "lexer::is_eof") or
            std::mem::equal_bytes(callee, "lexer::tokenize");
    }
    if std::mem::equal_bytes(prefix, "std::kizu::parser::") {
        if std::mem::equal_bytes(callee, "ast.get") {
            return true;
        }
        return compiled_parser_external_callee_allowed(callee);
    }
    if std::mem::equal_bytes(prefix, "selfhost::ir::code_render::") {
        // render_run_artifact reaches the tape lowering through codegen::lower_code_module,
        // emitted by the codegen closure, so the render closure references it without
        // re-emitting or walking it.
        if std::mem::equal_bytes(callee, "codegen::lower_code_module") {
            return true;
        }
        return std::mem::starts_with(callee, "codegen::code_op_") or
            std::mem::starts_with(callee, "codegen::code_kind_") or
            std::mem::starts_with(callee, "codegen::code_loop_kind_") or
            std::mem::starts_with(callee, "codegen::code_io_stream_");
    }
    if std::mem::equal_bytes(prefix, "selfhost::types::checker::") {
        return std::mem::equal_bytes(callee, "ast.get") or
            std::mem::equal_bytes(callee, "ast.child_at");
    }
    if std::mem::equal_bytes(prefix, "selfhost::ir::codegen::") {
        // The tape's recursive list walks bind children through the compiled external
        // std::kizu::ast accessor (spelled ast.child_at), emitted separately as
        // kizu_kizu__ast_ast_child_at; the BFS references it without re-emitting it.
        if std::mem::equal_bytes(callee, "ast.child_at") {
            return true;
        }
        // parse_int_literal is still owned by the cli_run_i64_codegen_llvm handwritten
        // define: its accumulator loop carries a mid-body scalar assign the generic
        // while lowering does not model yet. The tape closure references that single
        // definition without re-emitting it. Deletion condition: once the generic
        // while lowering carries mid-body scalar assigns, parse_int_literal joins the
        // compiled closure and the handwritten define is removed with the rest of the
        // run i64 shape path.
        if std::mem::equal_bytes(callee, "parse_int_literal") {
            return true;
        }
        // The run codegen tape's operator mapping calls the compiled std::kizu::ast
        // BinaryOp constant accessors cross-module (code_binary_kind, and the
        // short-circuit and/or routing in lower_code_binary), plus the PrefixOp
        // accessor backing the logical-not lowering (lower_code_prefix); they are
        // emitted separately as kizu_kizu__ast_binary_* / kizu_kizu__ast_prefix_not
        // enum-field returns, so the codegen closure references them without
        // re-emitting or walking them.
        return std::mem::equal_bytes(callee, "std::kizu::ast::binary_add") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_mod") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_sub") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_mul") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_div") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_eq") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_not_eq") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_lt") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_lte") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_gt") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_gte") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_and") or
            std::mem::equal_bytes(callee, "std::kizu::ast::binary_or") or
            std::mem::equal_bytes(callee, "std::kizu::ast::prefix_not") or
            std::mem::equal_bytes(callee, "std::kizu::ast::prefix_borrow") or
            std::mem::equal_bytes(callee, "std::kizu::ast::prefix_mut_borrow");
    }
    if !std::mem::equal_bytes(prefix, "selfhost::ast::") {
        return false;
    }
    if std::mem::equal_bytes(callee, "tree.get") {
        return true;
    }
    if std::mem::equal_bytes(callee, "tree.child_at") {
        return true;
    }
    return false;
}

// compiled_parser_external_callee_allowed mirrors the IR fact-side parser closure policy:
// exact AST constructors/helpers, Ast mutators, and lexer token cursors called by
// std/src/kizu/parser.kizu. It deliberately uses no std::kizu::ast::* or ast.add_* fallback;
// when the compiled parser owns these boundaries, remove individual entries.
fn compiled_parser_external_callee_allowed(callee: []u8) -> bool {
    return compiled_parser_ast_helper_callee_allowed(callee) or
        compiled_parser_ast_mutator_callee_allowed(callee) or
        compiled_parser_lexer_callee_allowed(callee);
}

fn compiled_parser_ast_helper_callee_allowed(callee: []u8) -> bool {
    return std::mem::equal_bytes(callee, "std::kizu::ast::Ast") or
        std::mem::equal_bytes(callee, "std::kizu::ast::span") or
        std::mem::equal_bytes(callee, "std::kizu::ast::empty_span") or
        std::mem::equal_bytes(callee, "std::kizu::ast::symbol_id") or
        std::mem::equal_bytes(callee, "std::kizu::ast::token_id") or
        std::mem::equal_bytes(callee, "std::kizu::ast::parse_result") or
        compiled_parser_ast_binary_op_callee_allowed(callee) or
        compiled_parser_ast_prefix_op_callee_allowed(callee);
}

fn compiled_parser_ast_binary_op_callee_allowed(callee: []u8) -> bool {
    return std::mem::equal_bytes(callee, "std::kizu::ast::binary_add") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_sub") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_mul") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_div") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_mod") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_eq") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_not_eq") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_lt") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_lte") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_gt") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_gte") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_and") or
        std::mem::equal_bytes(callee, "std::kizu::ast::binary_or");
}

fn compiled_parser_ast_prefix_op_callee_allowed(callee: []u8) -> bool {
    return std::mem::equal_bytes(callee, "std::kizu::ast::prefix_borrow") or
        std::mem::equal_bytes(callee, "std::kizu::ast::prefix_mut_borrow") or
        std::mem::equal_bytes(callee, "std::kizu::ast::prefix_neg") or
        std::mem::equal_bytes(callee, "std::kizu::ast::prefix_not");
}

fn compiled_parser_ast_mutator_callee_allowed(callee: []u8) -> bool {
    return std::mem::equal_bytes(callee, "ast.get") or
        std::mem::equal_bytes(callee, "ast.begin_children") or
        std::mem::equal_bytes(callee, "ast.add_child") or
        std::mem::equal_bytes(callee, "ast.finish_children") or
        std::mem::equal_bytes(callee, "ast.add_assign") or
        std::mem::equal_bytes(callee, "ast.add_binary") or
        std::mem::equal_bytes(callee, "ast.add_block") or
        std::mem::equal_bytes(callee, "ast.add_bool") or
        std::mem::equal_bytes(callee, "ast.add_break") or
        std::mem::equal_bytes(callee, "ast.add_call") or
        std::mem::equal_bytes(callee, "ast.add_cast_expr") or
        std::mem::equal_bytes(callee, "ast.add_comptime_expr") or
        std::mem::equal_bytes(callee, "ast.add_comptime_if") or
        std::mem::equal_bytes(callee, "ast.add_continue") or
        std::mem::equal_bytes(callee, "ast.add_defer") or
        std::mem::equal_bytes(callee, "ast.add_deref_expr") or
        std::mem::equal_bytes(callee, "ast.add_empty") or
        std::mem::equal_bytes(callee, "ast.add_enum_decl_with_doc") or
        std::mem::equal_bytes(callee, "ast.add_err_defer") or
        std::mem::equal_bytes(callee, "ast.add_expr_stmt") or
        std::mem::equal_bytes(callee, "ast.add_field_expr") or
        std::mem::equal_bytes(callee, "ast.add_field_with_doc") or
        std::mem::equal_bytes(callee, "ast.add_fn_decl_with_doc") or
        std::mem::equal_bytes(callee, "ast.add_for") or
        std::mem::equal_bytes(callee, "ast.add_if") or
        std::mem::equal_bytes(callee, "ast.add_impl_decl") or
        std::mem::equal_bytes(callee, "ast.add_import_decl") or
        std::mem::equal_bytes(callee, "ast.add_index_expr") or
        std::mem::equal_bytes(callee, "ast.add_int") or
        std::mem::equal_bytes(callee, "ast.add_let") or
        std::mem::equal_bytes(callee, "ast.add_match") or
        std::mem::equal_bytes(callee, "ast.add_match_arm") or
        std::mem::equal_bytes(callee, "ast.add_param") or
        std::mem::equal_bytes(callee, "ast.add_prefix") or
        std::mem::equal_bytes(callee, "ast.add_program") or
        std::mem::equal_bytes(callee, "ast.add_return") or
        std::mem::equal_bytes(callee, "ast.add_string") or
        std::mem::equal_bytes(callee, "ast.add_struct_decl_with_doc") or
        std::mem::equal_bytes(callee, "ast.add_struct_field_init") or
        std::mem::equal_bytes(callee, "ast.add_struct_literal_expr") or
        std::mem::equal_bytes(callee, "ast.add_try_expr") or
        std::mem::equal_bytes(callee, "ast.add_type_apply_expr") or
        std::mem::equal_bytes(callee, "ast.add_type_name") or
        std::mem::equal_bytes(callee, "ast.add_union_decl_with_doc") or
        std::mem::equal_bytes(callee, "ast.add_union_variant_with_doc") or
        std::mem::equal_bytes(callee, "ast.add_unsafe") or
        std::mem::equal_bytes(callee, "ast.add_var") or
        std::mem::equal_bytes(callee, "ast.add_var_with_doc") or
        std::mem::equal_bytes(callee, "ast.add_while");
}

fn compiled_parser_lexer_callee_allowed(callee: []u8) -> bool {
    return std::mem::equal_bytes(callee, "std::kizu::lexer::first_token") or
        std::mem::equal_bytes(callee, "std::kizu::lexer::next_token");
}

// compiled_callee_has_namespace reports whether a name still carries a "::"
// path separator, used to reject nested sub-namespace helpers and cross-component
// qualified callees without enumerating a hand-written namespace table.
fn compiled_callee_has_namespace(name: []u8) -> bool {
    let length = std::mem::len(name);
    if length < 2 {
        return false;
    }
    var index = 0;
    while index + 1 < length {
        if name[index] == cast<u8>(58) and name[index + 1] == cast<u8>(58) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// compiled_callee_is_array_element_method reports whether a callee names a value-receiver
// Array<T> element method (<receiver>.len / <receiver>.get / <receiver>.set /
// <receiver>.append), i.e. a runtime builtin lowered inline through the element-size-generic
// array ABI rather than a component function (issue 1165). Namespaced callees (carrying
// '::') are excluded so a cross-module free function is never mistaken for a method.
fn compiled_callee_is_array_element_method(name: []u8) -> bool {
    if compiled_callee_has_namespace(name) {
        return false;
    }
    return compiled_name_ends_with(name, ".len") or compiled_name_ends_with(name, ".get") or
        compiled_name_ends_with(name, ".set") or compiled_name_ends_with(name, ".append");
}

// compiled_callee_is_string_mutator_method reports whether a method-call callee names a
// std::string::String mutator (<out>.append_bytes / <out>.append_byte). Those lower inline
// through the @kizu_rt_string_append_* runtime ABI, so the BFS treats them as builtins rather
// than component functions (issue 1165).
fn compiled_callee_is_string_mutator_method(name: []u8) -> bool {
    if compiled_callee_has_namespace(name) {
        return false;
    }
    return compiled_name_ends_with(name, ".append_bytes") or
        compiled_name_ends_with(name, ".append_byte");
}

fn compiled_callee_is_owned_deinit_method(name: []u8) -> bool {
    if compiled_callee_has_namespace(name) {
        return false;
    }
    return compiled_name_ends_with(name, ".deinit");
}

fn compiled_name_ends_with(name: []u8, suffix: []u8) -> bool {
    let name_len = std::mem::len(name);
    let suffix_len = std::mem::len(suffix);
    if name_len < suffix_len {
        return false;
    }
    return std::mem::equal_bytes(name[name_len - suffix_len..name_len], suffix);
}

fn append_component_qualified_name(
    out: &var std::string::String,
    prefix: []u8,
    local_name: []u8
) -> !void {
    try out.append_bytes(prefix);
    try out.append_bytes(local_name);
    return;
}

// component_compiled_local_present confirms a component-local helper is a real
// function in the IR facts. The qualified name is matched as component prefix
// plus local name against the function-signature-return facts, so a name is
// only treated as supported when the signature actually exists.
fn component_compiled_local_present(
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    prefix: []u8,
    local_name: []u8
) -> bool {
    let value = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        lookup_index,
        ir_bytes,
        "function-signature-return ",
        prefix,
        local_name
    );
    return std::mem::len(value) != 0;
}

fn append_kizu_lexer_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("first_token");
    try pending.append("next_token");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "std::kizu::lexer::",
        &var pending,
        false
    );
    pending.deinit();
    return;
}

// append_kizu_parser_reachable_compiled_functions emits the std::kizu::parser
// predicate / byte / span helper closure through the shared BFS. The seeds are the
// in-degree-zero cluster roots: the standalone TokenKind predicates and
// is_double_token_byte (none of which call another cluster member) plus the two
// postfix roots is_type_apply_start and is_struct_literal_start. The BFS pulls in
// the remaining members through their body callees -- is_type_apply_start reaches
// is_lt_token and is_namespace_path_span, is_struct_literal_start reaches
// is_single_token_byte and is_struct_literal_type_span, and those spans reach
// is_name_byte / is_double_colon_at / is_upper_byte -- and admits the external
// std::kizu::ast Ast.get accessor invoked as ast.get. Each member's llvm symbol and
// params_spec are derived from signature facts, so the cluster no longer needs a
// handwritten append_compiled_function_auto per helper.
fn append_kizu_parser_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("is_double_colon");
    try pending.append("is_eof_token");
    try pending.append("is_left_brace_token");
    try pending.append("is_right_brace_token");
    try pending.append("is_block_close_token");
    try pending.append("is_ident_kind");
    try pending.append("is_postfix_start");
    try pending.append("is_call_close_token");
    try pending.append("is_pub_token");
    try pending.append("is_comptime_token");
    try pending.append("is_decl_item_separator");
    try pending.append("is_gt_token");
    try pending.append("is_comma_token");
    try pending.append("is_arrow_token");
    try pending.append("is_left_paren_token");
    try pending.append("is_right_paren_token");
    try pending.append("is_double_token_byte");
    try pending.append("is_type_apply_start");
    try pending.append("is_struct_literal_start");
    try pending.append("parse_bool");
    try pending.append("parse_int");
    try pending.append("parse_string");
    // name_node_with_doc is the issue 1157 C2 real parser consumer for
    // ast.add_var_with_doc. It directly builds VarNode { name, doc } without
    // pulling the full declaration parser.
    try pending.append("name_node_with_doc");
    // synth_parse_node_sig is the issue 1157 PJ synthetic fixture seed (in-degree zero, so it
    // must be seeded explicitly like the standalone predicates): a minimal '-> !ParseNode' helper
    // that binds the same-component cursor constructor std::kizu::parser::parse_node(...) to a let
    // and returns it. Seeding it here lowers it on the native compiled path so the backend
    // exercises the site-955 stdlib short-circuit guard, the !ParseNode error-union ABI, and the
    // ParseNode value type. The BFS pulls in the real leaf parse_node through its call edge.
    try pending.append("synth_parse_node_sig");
    // synth_postfix_loop is the issue 1157 worker-3 grammar-loop fixture: it carries the exact
    // parse_postfix_expr 'while true' value-loop CFG (loop-head phi over a carried ParseNode, three
    // bool-predicate-call guarded arms each reassigning through a free !ParseNode try-call, and a
    // terminal carried-value return) but reassigns through the already-lowered synth_parse_node_sig
    // leaf rather than the not-yet-lowered grammar helpers. Seeding it exercises the GrammarLoop
    // lowering on the native compiled path ahead of the real parse_primary consumer.
    try pending.append("synth_postfix_loop");
    // synth_child_assembly is the issue 1157 NEW-A fixture: it opens a child range, appends one
    // NodeId with ast.add_child, and closes it with ast.finish_children. Seeding it exercises the
    // child-array mutator method-call lowering + bodies in isolation, replacing the parse_primary
    // seed which pulls the whole recursive expression SCC.
    try pending.append("synth_child_assembly");
    // synth_append_loop is the issue 1157 worker-3 NEW-A fixture: it carries the parse_call_with_args
    // argument-loop CFG (a Token cursor through a value-cursor loop-head phi, a 'while
    // !is_call_close_token(cursor)' prefix-not bool-predicate-call header, a borrowed '&var
    // Array<NodeId>' append, and a free !Token try-call value-cursor latch), parsing each argument
    // through the already-lowered synth_parse_node_sig leaf instead of the recursive parse_expr.
    // Seeding it exercises the ValueCursorWhile lowering end to end in isolation, ahead of the real
    // parse_call_with_args consumer (which additionally needs the loop embedded mid-function with a
    // next_token call seed and parse_expr lowered).
    try pending.append("synth_append_loop");
    // synth_collection_build is the NEW-A integration fixture: it combines the append loop,
    // child-range drain, begin/add/finish mutators, and final ast.add_call C2 construction with
    // parse_expr replaced by the already-lowered synth_parse_node_sig leaf.
    try pending.append("synth_collection_build");
    // expect_ident is the smallest real !Token enum-dispatch consumer: the Ident arm ok-wraps the
    // matched token and every other arm returns error("expected identifier").
    try pending.append("expect_ident");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "std::kizu::parser::",
        &var pending,
        false
    );
    pending.deinit();
    return;
}

// append_codegen_reachable_compiled_functions emits the selfhost::ir::codegen run
// codegen IR v1 tape closure through the shared BFS. After the issue 1255 slice4 PR-1
// shape contract severance the hosted per-shape Program builder / metadata roots
// (lowered_main_print_program / metadata_for_program / main_print_payload /
// unsupported_program) are gone; only the tape lowering root lower_code_module, the
// code_op_mem_page_allocator opcode accessor, and the live metadata_line constant
// leaf remain. Each member's llvm symbol and params_spec are derived from signature
// facts. allow_empty_params is set because the parameterless metadata_line member
// derives an empty params_spec from its zero-arg signature.
pub fn append_codegen_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    // lower_code_module is the run codegen IR v1 tape lowering root: the
    // whole-file walk compiled into stage2 so the hosted run path can lower a
    // checked file onto the flat instruction tape.
    try pending.append("lower_code_module");
    // code_render references this opcode accessor across the codegen component
    // boundary when rendering the tape; compile its definition through the same
    // closure path as the rest of the codegen roots.
    try pending.append("code_op_mem_page_allocator");
    // metadata_line is the live codegen metadata leaf (zero-dependency constant): it
    // backs the stage2 run metadata and the cli_codegen_llvm metadata constant. It was
    // previously reached via the severed metadata_for_program root, so it is seeded
    // directly here to keep its compiled define present without pulling in shape.
    try pending.append("metadata_line");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "selfhost::ir::codegen::",
        &var pending,
        true
    );
    pending.deinit();
    return;
}

pub fn append_code_render_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("render_run_artifact");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "selfhost::ir::code_render::",
        &var pending,
        true
    );
    pending.deinit();
    return;
}

fn append_lexer_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("is_identifier_continue");
    try pending.append("invalid_token_display");
    // is_eof is the Token EOF predicate the formatter's token-array helpers call across
    // the module boundary; seed it so @kizu_selfhost__lexer_is_eof is emitted for the
    // format closure to reference (issue 1165).
    try pending.append("is_eof");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "selfhost::lexer::",
        &var pending,
        true
    );
    pending.deinit();
    return;
}

fn append_loader_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("package_module_end");
    try pending.append("is_manifest_root_source");
    try pending.append("package_module_start");
    try pending.append("source_file");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "selfhost::source::loader::",
        &var pending,
        false
    );
    pending.deinit();
    return;
}

// append_format_reachable_compiled_functions emits the selfhost::parser::format
// read-only helper closure through the shared BFS (issue 1165 / issue 1162). The
// seeds are the in-degree-zero read-only roots: the four TokenKind predicates that
// classify a single token (is_import_token / is_ident_token / is_double_colon_token /
// is_semicolon_token, each a 'return match token.kind { Variant => true, _ => false }'
// over the std::kizu::lexer::Token value lowered through the shared token-kind
// predicate MIR) and token_text, the span-slice accessor 'return
// source[token.start..token.end]' that the formatter reads every token's text
// through. All five are leaves, so the closure is exactly the seed set and the BFS
// derives each member's llvm symbol and params_spec from signature facts -- this is
// the first formatter component compiled into stage2. The seed set has since grown
// along the BFS frontier through the token-array read / scan-while helpers, the whole
// import-sort cluster (compare_bytes, import_path_less, sort_import_indices,
// leading_import_indices, lowered through compiled_struct_cf), the import / indentation
// emitters (append_import_decl, append_sorted_imports, append_indent), and the
// comment-preservation scalar helpers, and finally the comment-preservation driver
// append_preserved_line_comments itself (lowered through
// compiled_struct_cf::append_comment_preserve_function via the CommentFormatState struct value +
// error-union ABI), and the whole-formatter entry format_source. The stage2 fmt command calls
// that compiled entry directly and no longer routes formatting through parse_format_alloc.
fn append_format_reachable_compiled_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !void {
    var pending = std::array::Array<[]u8>(std::mem::page_allocator());
    try pending.append("is_import_token");
    try pending.append("is_ident_token");
    try pending.append("is_double_colon_token");
    try pending.append("is_semicolon_token");
    try pending.append("token_text");
    // next_token_text_equals is the first token-array read helper on the compiled path
    // (issue 1165): it reads tokens.len() / tokens.get(index + 1) on a value-receiver
    // Array<Token> param, calls lexer::is_eof across the module boundary, and compares the
    // next token text via token_text (already seeded).
    try pending.append("next_token_text_equals");
    // index_after_import is the first token-array scan-while helper on the compiled path
    // (issue 1165): it walks a value-receiver Array<Token> with a parameter-seeded i64
    // induction variable (var index = import_index), reading tokens.len()/tokens.get(...),
    // and returns an i64 on early loop exits. Its BFS pulls in is_semicolon_token (already
    // seeded) and references lexer::is_eof across the module boundary.
    try pending.append("index_after_import");
    // index_after_leading_imports is the first token-array scan-while helper whose loop latch
    // is a loop-carried try-call (issue 1165): the induction variable is reassigned by
    // 'index = try index_after_import(tokens, index);', whose i64 success value feeds the
    // loop-head phi and whose failure propagates as this function's error union. Its BFS pulls
    // in is_import_token (already seeded) and index_after_import (resolved as a local closure
    // member through the call edge).
    try pending.append("index_after_leading_imports");
    // compare_bytes is the first import-sort helper on the compiled path (issue 1165 /
    // 1162): a 'while index < left_len and index < right_len { ... }' byte comparison whose
    // short-circuit 'and' header reads two pure length locals (std::mem::len of the []u8
    // params) and whose body guards index both slices and returns an i64 ordering. Its only
    // callee is std::mem::len (an intrinsic the closure ignores), so it is a BFS leaf.
    try pending.append("compare_bytes");
    // import_path_less is the first multi-counter import-sort helper on the compiled path
    // (issue 1165 / 1162): two lockstep token cursors with base-plus-offset inits
    // ('var left_index = left + 1; var right_index = right + 1;') advanced by a trailing run
    // of constant-step increments under a short-circuit 'and' header, with a body let bound
    // to a nested-call-argument compare_bytes call and a prefix-not call return. Its BFS pulls
    // in is_semicolon_token, token_text, and compare_bytes (all already seeded members).
    try pending.append("import_path_less");
    // sort_import_indices is the first structured-control-flow import-sort helper on the
    // compiled path (issue 1165 / 1162): the scan-shift insertion sort 'var index = 1; while
    // index < indices.len() { var cursor = index; var scanning = true; while scanning and
    // cursor > 0 { let left = try indices.get(cursor - 1); let right = try indices.get(cursor);
    // if try import_path_less(source, tokens, right, left) { ...swaps...; cursor = cursor - 1;
    // } else { scanning = false; } } index = index + 1; } return;'. It needs genuine
    // basic-block + phi control flow (an outer counter loop, a nested cursor/flag scan loop, an
    // if/else that re-merges, a try-call comparator condition, and Array<i64>.get/set element
    // ABI on a '&var std::array::Array<i64>' param), so it lowers through compiled_struct_cf.
    // Its BFS pulls in import_path_less (already a seeded member).
    try pending.append("sort_import_indices");
    // leading_import_indices is the first structured-control-flow collector on the compiled
    // path (issue 1165 / 1162): 'var indices = std::array::Array<i64>(allocator); var index = 0;
    // while index < tokens.len() { let token = try tokens.get(index); if !is_import_token(token)
    // { index = tokens.len(); } else { try indices.append(index); index = try
    // index_after_import(tokens, index); } } try sort_import_indices(source, tokens, &var
    // indices); return indices;'. It builds a runtime-owned Array<i64> through the
    // element-size-generic @kizu_rt_array_new / @kizu_rt_array_append ABI, scans the token array
    // through an if/else branch-merge loop, then sorts the collected indices in place and returns
    // the filled array as the '!std::array::Array<i64>' success, so it lowers through
    // compiled_struct_cf. Its BFS pulls in is_import_token, index_after_import, and
    // sort_import_indices (all already seeded members).
    try pending.append("leading_import_indices");
    // append_import_decl is the first selfhost::parser::format member that mutates a '&var
    // std::string::String' accumulator on the compiled path (issue 1165 / 1162): it appends the
    // 'import ' prefix and the ';' terminator as string literals through the
    // @kizu_rt_string_append_bytes runtime ABI, reads each token's text via token_text, and emits
    // the import path identifiers, scanning the import's tokens through a loop carrying an
    // early-return semicolon branch and a fall-through 'ident or double-colon' text append, so it
    // lowers through compiled_struct_cf. Its BFS pulls in token_text, is_semicolon_token,
    // is_ident_token, and is_double_colon_token (all already seeded members).
    try pending.append("append_import_decl");
    // append_sorted_imports is the import-cluster emitter on the compiled path (issue 1165 /
    // 1162): it scans the sorted indices array and, for each, appends a single import declaration
    // via append_import_decl followed by a newline byte through the @kizu_rt_string_append_byte
    // ABI, so it lowers through compiled_struct_cf. Its BFS pulls in append_import_decl (an already
    // seeded member).
    try pending.append("append_sorted_imports");
    // append_indent is the indentation emitter on the compiled path (issue 1165 / 1162): 'var index
    // = 0; while index < depth { try out.append_bytes("    "); index = index + 1; } return;'. It
    // mutates a '&var std::string::String' accumulator inside an i64 counter loop, appending the
    // four-space indentation literal through the @kizu_rt_string_append_bytes ABI, so it lowers
    // through compiled_struct_cf. It is a BFS leaf: its only callee is the out.append_bytes runtime
    // builtin, so it pulls in no new members.
    try pending.append("append_indent");
    // is_horizontal_space and is_line_break are the two leaf byte classifiers of the comment-
    // preservation cluster on the compiled path (issue 1165 / 1162): 'return byte == cast<u8>(<a>)
    // or byte == cast<u8>(<b>);', lowered through the generic short-circuit-or-return path. They are
    // BFS leaves, so they pull in no new members. The rest of the comment-preservation cluster --
    // the line_comment_* / line_end_* scalar helpers and the append_preserved_line_comments driver
    // below -- is now on the compiled path too (see executable_functions.kizu).
    try pending.append("is_horizontal_space");
    try pending.append("is_line_break");
    // after_line_break is the first comment-preservation scalar helper to move onto the
    // compiled path (issue 1165 / 1162): 'let length = std::mem::len(source); if
    // source[index] == cast<u8>(13) and index + 1 < length and source[index + 1] ==
    // cast<u8>(10) { return index + 2; } return index + 1;'. Its if-condition is a
    // three-operand short-circuit 'and' chain whose trailing 'source[index + 1]' byte load
    // is guarded by the 'index + 1 < length' bounds check, so it lowers through the generic
    // multi-statement path's short-circuit if-chain (cond_insts + cond_rhs_insts +
    // cond_extra_operands) rather than an eager 'and i1' that would load past the slice. It
    // is a BFS leaf: its only callees are std::mem::len and the cast intrinsic, so it pulls
    // in no new members.
    try pending.append("after_line_break");
    // line_end_excluding_break and line_end_including_break scan forward to the end of a line on
    // the compiled path (issue 1165 / 1162): 'var index = start; let length =
    // std::mem::len(source); while index < length and !is_line_break(source[index]) { index =
    // index + 1; } return index;', with line_end_including_break adding a trailing 'if index <
    // length { return after_line_break(source, index); } return index;'. The while header is a
    // genuine short-circuit 'and' whose '!is_line_break(source[index])' operand loads
    // source[index] only when 'index < length' holds, so it lowers through the multi-statement
    // path's short-circuit while header (the guarded load runs in a loopN_head_rhs block) rather
    // than an eager 'and i1'. line_end_including_break's tail is a single-comparison if whose
    // then-block is a 'return after_line_break(..)' ReturnCall the generic if path already lowers.
    // Their body BFS pulls in is_line_break and after_line_break (both already seeded members).
    try pending.append("line_end_excluding_break");
    try pending.append("line_end_including_break");
    // line_comment_is_full_line scans backward from a line comment's start to decide whether only
    // horizontal whitespace precedes it on the line (issue 1165 / 1162): 'var index = comment_start;
    // while index > 0 { let previous = index - 1; if is_line_break(source[previous]) { return true;
    // } if !is_horizontal_space(source[previous]) { return false; } index = previous; } return
    // true;'. Its while header is a single 'index > 0' comparison against a literal (a downward
    // counter), its loop body opens with a 'let previous = index - 1' decrement local feeding both a
    // checked 'source[previous]' byte load passed as a call argument and the 'index = previous'
    // latch, and its body carries two boolean early returns. Its BFS pulls in is_line_break and
    // is_horizontal_space (both already seeded members).
    try pending.append("line_comment_is_full_line");
    // line_comment_has_blank_after scans forward from a line comment's end to decide whether a blank
    // line follows it (issue 1165 / 1162): 'var cursor = line_end_including_break(source,
    // comment_end); while cursor < end { if is_horizontal_space(source[cursor]) { cursor = cursor +
    // 1; continue; } return is_line_break(source[cursor]); } return false;'. It is the first compiled
    // helper with a continue-latch loop -- its induction variable advances inside a body 'if <cond> {
    // cursor = cursor + 1; continue; }' rather than a trailing increment, its primary init is
    // call-seeded so the 'line_end_including_break' call runs in the preheader, and its non-continue
    // path returns 'is_line_break(source[cursor])' (a return whose call argument is a checked byte
    // load). Its BFS pulls in line_end_including_break, is_horizontal_space and is_line_break (all
    // already seeded members).
    try pending.append("line_comment_has_blank_after");
    // line_comment_has_blank_before scans backward from a line comment's start to decide whether a
    // blank line precedes it (issue 1165 / 1162): 'var cursor = comment_start; while cursor > start {
    // let previous = cursor - 1; if is_horizontal_space(source[previous]) { cursor = previous;
    // continue; } if !is_line_break(source[previous]) { return false; } cursor = previous; while
    // cursor > start { let before = cursor - 1; if is_horizontal_space(source[before]) { cursor =
    // before; continue; } return is_line_break(source[before]); } return false; } return false;'. It is
    // the first compiled helper with a nested continue-latch loop and the first whose continue-latch
    // step is a copy-decrement -- both scans advance the cursor inside a body 'if <cond> { cursor =
    // previous; continue; }' whose latch reads the decrement local rather than a constant-step add,
    // both headers are non-literal 'cursor > start' comparisons, and the inner scan reuses the cursor
    // induction (renamed so its loop-head phi does not clash with the outer scan's). Its BFS pulls in
    // is_horizontal_space and is_line_break (both already seeded members).
    try pending.append("line_comment_has_blank_before");
    try pending.append("should_insert_space");
    // lbrace_opens_enum_decl is the first compiled helper with a leading-decrement loop (issue 1165 /
    // 1162): 'var cursor = index; while cursor > 0 { cursor = cursor - 1; let token = try
    // tokens.get(cursor); ... }'. Its induction variable advances through the body-opening 'cursor =
    // cursor - 1' self-decrement rather than a trailing increment, so lower_multi_while_leading_decrement
    // reseats the loop-head phi onto a reserved counter (leading.decrement.head) and synthesizes the
    // decrement as a body 'let cursor = <head> - 1' the later body reads resolve to, with the loop-head
    // phi reading %cursor on the latch edge. Its BFS pulls in token_text (already a seeded member).
    try pending.append("lbrace_opens_enum_decl");
    // is_match_arm_trailing_comma and rbrace_closes_enum_decl reuse the same leading-decrement
    // backward token scan, but also carry a brace_depth scalar through conditional then-block
    // mutations. The MIR lowering threads that scalar through a loop-head phi and per-if select
    // joins, leaving the hand-written formatter path smaller without adding formatter-specific LLVM.
    try pending.append("is_match_arm_trailing_comma");
    try pending.append("rbrace_closes_enum_decl");
    // append_preserved_line_comments is the comment-preservation driver (issue 1165 / 1162): the
    // first selfhost::parser::format member returning a struct in an error union
    // ('-> !CommentFormatState'). It lowers through compiled_struct_cf::append_comment_preserve_function
    // (dispatched by its %kizu.error.comment_format_state return type), threading the loop-carried
    // scalar state through a forward scan loop and closing with 'return CommentFormatState { ... };'.
    // Its BFS reaches the already-seeded line_comment_* / line_end_* / append_indent helpers.
    try pending.append("append_preserved_line_comments");
    // is_top_level_decl_start is a top-level-keyword classifier (issue 1165 / 1162): 'return
    // equal_bytes(text, "import") or equal_bytes(text, "pub") or ... ;', a single-return
    // short-circuit 'or' of std::mem::equal_bytes calls over a []u8 text param -- the same
    // multi-operand 'or'-return shape already compiled for no_space_before / no_space_after, lowered
    // through the generic short-circuit-or-return path. It is a BFS leaf (only std::mem callees).
    try pending.append("is_top_level_decl_start");
    // starts_new_top_level_decl guards a top-level-decl boundary (issue 1165 / 1162): 'if
    // !is_top_level_decl_start(current) { return false; } return !(equal_bytes(previous, "pub") or
    // equal_bytes(previous, "@") or equal_bytes(previous, "extern"));'. It is the first compiled
    // helper whose body pairs a leading 'if !<predicate call> { return false; }' guard with a
    // prefix-not-of-short-circuit-or return, lowered through the generic multi-statement path. Its
    // BFS pulls in is_top_level_decl_start (a seeded member).
    try pending.append("starts_new_top_level_decl");
    // last_byte reads a slice's final byte (issue 1165 / 1162): 'return text[std::mem::len(text) -
    // 1];', a single-return checked single-element index load whose index is a 'len - 1' binary over
    // a std::mem::len call, lowered through the generic expression path's IndexExpr load. It is a BFS
    // leaf (only std::mem::len).
    try pending.append("last_byte");
    // has_line_comment_between scans a byte range for a '//' line comment (issue 1165 / 1162): 'var
    // index = start; while index + 1 < end { if source[index] == cast<u8>(47) and source[index + 1]
    // == cast<u8>(47) { return true; } index = index + 1; } return false;'. It is the first compiled
    // helper whose while header compares a 'counter + 1' binary on the left ('index + 1 < end') and
    // whose body carries a short-circuit-'and' byte-pair guard with an early return true, lowered
    // through the generic multi-statement path. It is a BFS leaf (only std::mem / cast).
    try pending.append("has_line_comment_between");
    // rbrace_wants_newline decides whether a '}' needs a trailing newline by inspecting the next
    // token (issue 1165 / 1162): two 'if <guard> { return false; }' early returns (index bound and
    // lexer::is_eof), a 'let text = token_text(source, next);', and a closing 'return !(equal_bytes(
    // text, ",") or ... or equal_bytes(text, "else"));' -- a prefix-not of a ten-operand short-circuit
    // 'or' over a token-array read. It lowers through the generic multi-statement path; its BFS pulls
    // in token_text (a seeded member) and references lexer::is_eof across the module boundary.
    try pending.append("rbrace_wants_newline");
    // is_trailing_comma decides whether a ',' is a trailing comma by inspecting the next token (issue
    // 1165 / 1162): a 'if !equal_bytes(text, ",") { return false; }' guard, two 'let <name> = try
    // next_token_text_equals(...)' let-try binds with bool early returns, an 'if !(try
    // next_token_text_equals(source, tokens, index, "}")) { return false; }' guard, and a closing
    // 'return !(try is_match_arm_trailing_comma(source, tokens, index));'. It is the first compiled
    // helper whose body lowers a try-call in sub-expression position: the prefix-not of a try-call in
    // an if condition and as the return value each hoist into a preceding synthetic let-try bind whose
    // bound bool is read back as the prefix-not operand, the failure propagating as this function's own
    // error union. It lowers through the generic multi-statement path; its BFS pulls in
    // next_token_text_equals and is_match_arm_trailing_comma (both seeded members).
    try pending.append("is_trailing_comma");
    // format_source is the formatter driver now compiled into stage2 (issue 1165 / 1162). It
    // allocates the String output handle, tokenizes the source, performs import sorting and
    // comment-preserving spacing through the helper closure above, and returns the owned String
    // to the hosted CLI fmt path.
    try pending.append("format_source");
    try append_component_reachable_compiled_functions(
        out,
        lookup_index,
        ir_bytes,
        "selfhost::parser::format::",
        &var pending,
        false
    );
    pending.deinit();
    return;
}

fn append_slice_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_equal(");
    try append_line(out, "  %kizu.slice.u8 %left,");
    try append_line(out, "  %kizu.slice.u8 %right");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %left_len = extractvalue %kizu.slice.u8 %left, 1");
    try append_line(out, "  %right_len = extractvalue %kizu.slice.u8 %right, 1");
    try append_line(out, "  %same_len = icmp eq i64 %left_len, %right_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %left_len");
    try append_line(out, "  br i1 %done, label %true, label %body");
    try append_line(out, "body:");
    try append_line(out, "  %left_ptr = extractvalue %kizu.slice.u8 %left, 0");
    try append_line(out, "  %right_ptr = extractvalue %kizu.slice.u8 %right, 0");
    try append_line(out, "  %left_at = getelementptr i8, ptr %left_ptr, i64 %index");
    try append_line(out, "  %right_at = getelementptr i8, ptr %right_ptr, i64 %index");
    try append_line(out, "  %left_byte = load i8, ptr %left_at");
    try append_line(out, "  %right_byte = load i8, ptr %right_at");
    try append_line(out, "  %same_byte = icmp eq i8 %left_byte, %right_byte");
    try append_line(out, "  br i1 %same_byte, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_len_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__slice_len(");
    try append_line(out, "  %kizu.slice.u8 %slice");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %slice, 1");
    try append_line(out, "  ret i64 %len");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_slice_starts_with_dash_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__slice_starts_with_dash(");
    try append_line(out, "  %kizu.slice.u8 %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = extractvalue %kizu.slice.u8 %value, 1");
    try append_line(out, "  %has_byte = icmp sgt i64 %len, 0");
    try append_line(out, "  br i1 %has_byte, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %value, 0");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_dash = icmp eq i8 %byte, 45");
    try append_line(out, "  ret i1 %is_dash");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_concat3_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__write_concat3(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %prefix,");
    try append_line(out, "  %kizu.slice.u8 %middle,");
    try append_line(out, "  %kizu.slice.u8 %suffix");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %prefix_ptr = extractvalue %kizu.slice.u8 %prefix, 0");
    try append_line(out, "  %prefix_len = extractvalue %kizu.slice.u8 %prefix, 1");
    try append_line(out, "  %middle_ptr = extractvalue %kizu.slice.u8 %middle, 0");
    try append_line(out, "  %middle_len = extractvalue %kizu.slice.u8 %middle, 1");
    try append_line(out, "  %suffix_ptr = extractvalue %kizu.slice.u8 %suffix, 0");
    try append_line(out, "  %suffix_len = extractvalue %kizu.slice.u8 %suffix, 1");
    try append_line(out, "  %prefix_middle_len = add i64 %prefix_len, %middle_len");
    try append_line(out, "  %total_len = add i64 %prefix_middle_len, %suffix_len");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %total_len)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %copy_prefix, label %alloc_failed");
    try append_line(out, "copy_prefix:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %buffer, ptr %prefix_ptr, i64 %prefix_len, i1 false)");
    try append_line(out, "  %middle_dest = getelementptr i8, ptr %buffer, i64 %prefix_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %middle_dest, ptr %middle_ptr, i64 %middle_len, i1 false)");
    try append_line(out,
        "  %suffix_dest = getelementptr i8, ptr %buffer, i64 %prefix_middle_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %suffix_dest, ptr %suffix_ptr, i64 %suffix_len, i1 false)");
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %total_len, 1");
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned %io, %kizu.slice.u8 %path, %kizu.slice.u8 %body)");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %buffer)");
    try append_line(out, "  ret %kizu.error.void %write");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_cli_main_header(out);
    try append_cli_main_dispatch(out);
    try append_cli_corpus_blocks(out);
    try cli_test_llvm::append_cli_test_blocks(out, ir_bytes);
    try cli_run_llvm::append_cli_run_blocks(out, ir_bytes);
    try cli_parse_llvm::append_cli_parse_blocks(out);
    try cli_parse_llvm::append_cli_fmt_blocks(out);
    try cli_parse_llvm::append_cli_fmt_write_blocks(out);
    try append_cli_check_blocks(out);
    try append_cli_stage_blocks(out);
    try append_cli_error_blocks(out);
    try append_line(out, "}");
    return;
}

fn append_cli_main_header(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %argc = call i64 @kizu_rt_process_arg_count()");
    try append_line(out, "  %argc_is_two = icmp eq i64 %argc, 2");
    try append_line(out, "  %argc_is_three = icmp eq i64 %argc, 3");
    try append_line(out, "  %argc_ok = or i1 %argc_is_two, %argc_is_three");
    try append_line(out, "  br i1 %argc_ok, label %load_command, label %usage");
    try append_line(out, "load_command:");
    try append_line(out, "  %command_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 0)");
    try append_line(out, "  %command_ok = extractvalue %kizu.error.slice.u8 %command_result, 0");
    try append_line(out, "  br i1 %command_ok, label %route_args, label %check_failed");
    try append_line(out, "route_args:");
    try append_line(out, "  br i1 %argc_is_three, label %load_fmt_write_flag, label %load_target");
    try append_line(out, "load_fmt_write_flag:");
    try append_line(out,
        "  %fmt_write_flag_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out,
        "  %fmt_write_flag_ok = extractvalue %kizu.error.slice.u8 %fmt_write_flag_result, 0");
    try append_line(out,
        "  br i1 %fmt_write_flag_ok, label %load_fmt_write_target, label %check_failed");
    try append_line(out, "load_fmt_write_target:");
    try append_line(out,
        "  %fmt_write_target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 2)");
    try append_line(out,
        "  %fmt_write_target_ok = extractvalue %kizu.error.slice.u8 %fmt_write_target_result, 0");
    try append_line(out,
        "  br i1 %fmt_write_target_ok, label %dispatch_fmt_write_arg, label %check_failed");
    try append_line(out, "load_target:");
    try append_line(out, "  %target_result = call %kizu.error.slice.u8 @kizu_rt_process_arg(i64 1)");
    try append_line(out, "  %target_ok = extractvalue %kizu.error.slice.u8 %target_result, 0");
    try append_line(out, "  br i1 %target_ok, label %dispatch, label %check_failed");
    return;
}

fn append_cli_main_dispatch(out: &var std::string::String) -> !void {
    try append_cli_fmt_write_arg_dispatch(out);
    try append_line(out, "dispatch:");
    try append_line(out, "  %command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out, "  %target = extractvalue %kizu.error.slice.u8 %target_result, 1");
    try append_line(out,
        "  %command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %command)");
    try append_line(out, "  br i1 %command_is_flag, label %usage, label %check_target_flag");
    try append_line(out, "check_target_flag:");
    try append_line(out,
        "  %target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %target)");
    try append_line(out, "  br i1 %target_is_flag, label %usage, label %maybe_test");
    try append_line(out, "maybe_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.test, i64 0, i64 0");
    try append_line(out, "  %test_base = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test_base, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %dispatch_test, label %maybe_run");
    try append_line(out, "maybe_run:");
    try append_line(out,
        "  %run_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.run, i64 0, i64 0");
    try append_line(out, "  %run_base = insertvalue %kizu.slice.u8 poison, ptr %run_ptr, 0");
    try append_line(out, "  %run_slice = insertvalue %kizu.slice.u8 %run_base, i64 3, 1");
    try append_line(out,
        "  %is_run = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %run_slice)");
    try append_line(out, "  br i1 %is_run, label %dispatch_run, label %maybe_parse");
    try append_line(out, "maybe_parse:");
    try append_line(out,
        "  %parse_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.parse, i64 0, i64 0");
    try append_line(out, "  %parse_base = insertvalue %kizu.slice.u8 poison, ptr %parse_ptr, 0");
    try append_line(out, "  %parse_slice = insertvalue %kizu.slice.u8 %parse_base, i64 5, 1");
    try append_line(out,
        "  %is_parse = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %parse_slice)");
    try append_line(out, "  br i1 %is_parse, label %dispatch_parse, label %maybe_fmt");
    try append_line(out, "maybe_fmt:");
    try append_line(out,
        "  %fmt_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.fmt, i64 0, i64 0");
    try append_line(out, "  %fmt_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_ptr, 0");
    try append_line(out, "  %fmt_slice = insertvalue %kizu.slice.u8 %fmt_base, i64 3, 1");
    try append_line(out,
        "  %is_fmt = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %fmt_slice)");
    try append_line(out, "  br i1 %is_fmt, label %dispatch_fmt, label %match_selfhost");
    try append_line(out, "match_selfhost:");
    try append_line(out,
        "  %selfhost_ptr = getelementptr inbounds [8 x i8], ptr @.kizu.cli.selfhost, i64 0, i64 0");
    try append_line(out, "  %selfhost_base = insertvalue %kizu.slice.u8 poison, ptr %selfhost_ptr, 0");
    try append_line(out, "  %selfhost_slice = insertvalue %kizu.slice.u8 %selfhost_base, i64 8, 1");
    try append_line(out,
        "  %target_matches = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %target, %kizu.slice.u8 %selfhost_slice)");
    try append_line(out, "  br i1 %target_matches, label %dispatch_command, label %dispatch_corpus");
    try append_line(out, "dispatch_command:");
    try append_line(out,
        "  %check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out, "  %check_base = insertvalue %kizu.slice.u8 poison, ptr %check_ptr, 0");
    try append_line(out, "  %check_slice = insertvalue %kizu.slice.u8 %check_base, i64 5, 1");
    try append_line(out,
        "  %is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %check_slice)");
    try append_line(out, "  br i1 %is_check, label %run_check, label %maybe_stage");
    try append_line(out, "maybe_stage:");
    try append_line(out,
        "  %stage_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.stage, i64 0, i64 0");
    try append_line(out, "  %stage_base = insertvalue %kizu.slice.u8 poison, ptr %stage_ptr, 0");
    try append_line(out, "  %stage_slice = insertvalue %kizu.slice.u8 %stage_base, i64 5, 1");
    try append_line(out,
        "  %is_stage = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %stage_slice)");
    try append_line(out, "  br i1 %is_stage, label %run_stage, label %unsupported");
    return;
}

fn append_cli_fmt_write_arg_dispatch(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_fmt_write_arg:");
    try append_line(out,
        "  %fmt_write_command = extractvalue %kizu.error.slice.u8 %command_result, 1");
    try append_line(out,
        "  %fmt_write_flag = extractvalue %kizu.error.slice.u8 %fmt_write_flag_result, 1");
    try append_line(out,
        "  %fmt_write_target = extractvalue %kizu.error.slice.u8 %fmt_write_target_result, 1");
    try append_line(out,
        "  %fmt_write_command_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %fmt_write_command)");
    try append_line(out,
        "  br i1 %fmt_write_command_is_flag, label %usage, label %check_fmt_write_target_flag");
    try append_line(out, "check_fmt_write_target_flag:");
    try append_line(out,
        "  %fmt_write_target_is_flag = call i1 @kizu_selfhost__slice_starts_with_dash(%kizu.slice.u8 %fmt_write_target)");
    try append_line(out,
        "  br i1 %fmt_write_target_is_flag, label %usage, label %match_fmt_write_command");
    try append_line(out, "match_fmt_write_command:");
    try append_line(out,
        "  %fmt_write_command_ptr = getelementptr inbounds [3 x i8], ptr @.kizu.cli.fmt, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_command_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_command_ptr, 0");
    try append_line(out,
        "  %fmt_write_command_slice = insertvalue %kizu.slice.u8 %fmt_write_command_base, i64 3, 1");
    try append_line(out,
        "  %fmt_write_is_fmt = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_command, %kizu.slice.u8 %fmt_write_command_slice)");
    try append_line(out,
        "  br i1 %fmt_write_is_fmt, label %match_fmt_write_flag, label %usage");
    try append_line(out, "match_fmt_write_flag:");
    try append_line(out,
        "  %fmt_write_flag_ptr = getelementptr inbounds [7 x i8], ptr @.kizu.cli.fmt_write, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_flag_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_flag_ptr, 0");
    try append_line(out,
        "  %fmt_write_flag_slice = insertvalue %kizu.slice.u8 %fmt_write_flag_base, i64 7, 1");
    try append_line(out,
        "  %fmt_write_is_long = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_flag, %kizu.slice.u8 %fmt_write_flag_slice)");
    try append_line(out,
        "  %fmt_write_short_ptr = getelementptr inbounds [2 x i8], ptr @.kizu.cli.fmt_write_short, i64 0, i64 0");
    try append_line(out,
        "  %fmt_write_short_base = insertvalue %kizu.slice.u8 poison, ptr %fmt_write_short_ptr, 0");
    try append_line(out,
        "  %fmt_write_short_slice = insertvalue %kizu.slice.u8 %fmt_write_short_base, i64 2, 1");
    try append_line(out,
        "  %fmt_write_is_short = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %fmt_write_flag, %kizu.slice.u8 %fmt_write_short_slice)");
    try append_line(out, "  %fmt_write_flag_matches = or i1 %fmt_write_is_long, %fmt_write_is_short");
    try append_line(out,
        "  br i1 %fmt_write_flag_matches, label %dispatch_fmt_write, label %usage");
    return;
}

fn append_cli_corpus_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_corpus:");
    try append_line(out,
        "  %corpus_check_ptr = getelementptr inbounds [5 x i8], ptr @.kizu.cli.check, i64 0, i64 0");
    try append_line(out,
        "  %corpus_check_base = insertvalue %kizu.slice.u8 poison, ptr %corpus_check_ptr, 0");
    try append_line(out,
        "  %corpus_check_slice = insertvalue %kizu.slice.u8 %corpus_check_base, i64 5, 1");
    try append_line(out,
        "  %corpus_is_check = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %command, %kizu.slice.u8 %corpus_check_slice)");
    try append_line(out, "  br i1 %corpus_is_check, label %read_check_corpus_source, label %usage");
    try append_line(out, "read_check_corpus_source:");
    try append_line(out, "  %corpus_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %corpus_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %corpus_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %corpus_file_ok = extractvalue %kizu.error.slice.u8 %corpus_file, 0");
    try append_line(out, "  br i1 %corpus_file_ok, label %match_corpus_source, label %usage");
    try append_line(out, "match_corpus_source:");
    try append_line(out, "  %corpus_bytes = extractvalue %kizu.error.slice.u8 %corpus_file, 1");
    try cli_check_gate_llvm::append_static_check_gate(
        out,
        "check_file",
        "check",
        "corpus_io",
        "corpus_bytes",
        "check_file_ok"
    );
    try append_line(out, "check_file_ok:");
    try append_line(out,
        "  %check_allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out,
        "  %check_parsed = call %kizu.kizu.ast.parse_result @kizu_selfhost__cli_parse_validated_ast(%kizu.owned %check_allocator, %kizu.slice.u8 %target, %kizu.slice.u8 %corpus_bytes)");
    try append_line(out, "  %check_ast = extractvalue %kizu.kizu.ast.parse_result %check_parsed, 0");
    try append_line(out, "  %check_root = extractvalue %kizu.kizu.ast.parse_result %check_parsed, 1");
    try cli_check_gate_llvm::append_compiled_undefined_variable_gate(
        out,
        "check_file",
        "check",
        "corpus_io",
        "corpus_bytes",
        "check_ast",
        "check_root",
        "check_file_type_ok"
    );
    try append_line(out, "check_file_type_ok:");
    try append_line(out,
        "  %check_file_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out,
        "  %check_file_ok_base = insertvalue %kizu.slice.u8 poison, ptr %check_file_ok_ptr, 0");
    try append_line(out,
        "  %check_file_ok_slice = insertvalue %kizu.slice.u8 %check_file_ok_base, i64 10, 1");
    try append_line(out,
        "  %check_file_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %corpus_io, %kizu.slice.u8 %check_file_ok_slice)");
    try append_line(out, "  %check_file_write_ok = extractvalue %kizu.error.void %check_file_write, 0");
    try append_line(out, "  br i1 %check_file_write_ok, label %exit_zero, label %check_failed");
    try append_line(out, "exit_one:");
    try append_line(out, "  %one_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %one_code");
    return;
}

fn append_cli_check_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "run_check:");
    try append_line(out, "  %check_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %manifest_ptr = getelementptr inbounds [18 x i8], ptr @.kizu.cli.manifest, i64 0, i64 0");
    try append_line(out, "  %manifest_base = insertvalue %kizu.slice.u8 poison, ptr %manifest_ptr, 0");
    try append_line(out, "  %manifest_slice = insertvalue %kizu.slice.u8 %manifest_base, i64 18, 1");
    try append_line(out,
        "  %manifest = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %check_io, %kizu.slice.u8 %manifest_slice)");
    try append_line(out, "  %manifest_ok = extractvalue %kizu.error.slice.u8 %manifest, 0");
    try append_line(out, "  br i1 %manifest_ok, label %read_sources, label %check_failed");
    try append_line(out, "read_sources:");
    try append_line(out,
        "  %source_ptr = getelementptr inbounds [12 x i8], ptr @.kizu.cli.source_dir, i64 0, i64 0");
    try append_line(out, "  %source_base = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out, "  %source_slice = insertvalue %kizu.slice.u8 %source_base, i64 12, 1");
    try append_line(out,
        "  %sources = call %kizu.error.owned @kizu_rt_fs_read_dir(%kizu.owned %check_io, %kizu.slice.u8 %source_slice)");
    try append_line(out, "  %sources_ok = extractvalue %kizu.error.owned %sources, 0");
    try append_line(out, "  br i1 %sources_ok, label %check_ok, label %check_failed");
    try append_line(out, "check_ok:");
    try append_line(out,
        "  %check_ok_ptr = getelementptr inbounds [10 x i8], ptr @.kizu.cli.check_ok, i64 0, i64 0");
    try append_line(out, "  %check_ok_base = insertvalue %kizu.slice.u8 poison, ptr %check_ok_ptr, 0");
    try append_line(out, "  %check_ok_slice = insertvalue %kizu.slice.u8 %check_ok_base, i64 10, 1");
    try append_line(out,
        "  %check_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %check_io, %kizu.slice.u8 %check_ok_slice)");
    try append_line(out, "  %check_write_ok = extractvalue %kizu.error.void %check_write, 0");
    try append_line(out, "  br i1 %check_write_ok, label %exit_zero, label %check_failed");
    try append_line(out, "exit_zero:");
    try append_line(out, "  %zero_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %zero_code");
    return;
}

fn append_cli_stage_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "run_stage:");
    try append_line(out, "  %stage_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_stage_copy(out, "ll", "root_ll_path", "27", "stage2_ll_path", "34");
    try append_stage_copy(out, "meta", "root_meta_path", "32", "stage2_meta_path", "39");
    try append_stage_copy(
        out,
        "storage",
        "root_storage_path",
        "35",
        "stage2_storage_path",
        "42"
    );
    try append_stage_copy(
        out,
        "storage_meta",
        "root_storage_meta_path",
        "40",
        "stage2_storage_meta_path",
        "47"
    );
    try append_stage_copy(out, "host", "root_host_path", "32", "stage2_host_path", "39");
    try append_stage_copy(
        out,
        "host_meta",
        "root_host_meta_path",
        "37",
        "stage2_host_meta_path",
        "44"
    );
    try append_stage_write(out, "stage_ok", "stage_ok", "10");
    try append_stage_write(out, "ll", "ll_path", "28");
    try append_stage_write(out, "meta", "meta_path", "33");
    try append_stage_write(out, "storage", "storage_path", "36");
    try append_stage_write(out, "storage_meta", "storage_meta_path", "41");
    try append_stage_write(out, "host", "host_path", "33");
    try append_stage_write(out, "host_meta", "host_meta_path", "38");
    try append_line(out, "  %stage_code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %stage_code");
    return;
}

fn append_stage_copy(
    out: &var std::string::String,
    name: []u8,
    source: []u8,
    source_size: []u8,
    target: []u8,
    target_size: []u8
) -> !void {
    try append_global_slice(out, name, "source", source, source_size);
    try append_global_slice(out, name, "target", target, target_size);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_read = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_source_slice)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_bytes = extractvalue %kizu.error.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_read, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_copy = call %kizu.error.void @kizu_rt_fs_write_file(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_target_slice, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_bytes)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    name: []u8,
    role: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_stage_write(
    out: &var std::string::String,
    name: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_write = call %kizu.error.void @kizu_rt_io_write_stdout(");
    try out.append_bytes("%kizu.owned %stage_io, %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_slice)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_error_blocks(out: &var std::string::String) -> !void {
    try append_cli_error_block(out, "usage", "usage", "58");
    try append_cli_error_block(out, "run_unsupported", "unsupported_run_codegen", "32");
    try append_cli_error_block(out, "unsupported", "unsupported", "29");
    try append_cli_error_block(out, "check_failed", "failed", "22");
    return;
}

fn append_cli_error_block(
    out: &var std::string::String,
    label: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes(label);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(label);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(label);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label);
    try out.append_bytes("_write = call %kizu.error.void @kizu_rt_io_write_stderr(");
    try out.append_bytes("%kizu.owned %");
    try out.append_bytes(label);
    try out.append_bytes("_io, %kizu.slice.u8 %");
    try out.append_bytes(label);
    try out.append_bytes("_slice)");
    try out.append_byte(cast<u8>(10));
    if std::mem::equal_bytes(label, "check_failed") {
        try out.append_bytes("  %");
        try out.append_bytes(label);
        try out.append_bytes("_code = call i64 @kizu_rt_process_exit_code(i64 1)");
        try out.append_byte(cast<u8>(10));
    } else {
        try out.append_bytes("  %");
        try out.append_bytes(label);
        try out.append_bytes("_code = call i64 @kizu_rt_process_exit_code(i64 64)");
        try out.append_byte(cast<u8>(10));
    }
    try out.append_bytes("  ret i64 %");
    try out.append_bytes(label);
    try out.append_bytes("_code");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
