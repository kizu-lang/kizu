    try append_line(out, "  %ok1 = insertvalue %kizu.error.i64 %ok0, i64 -1, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.error.i64 %ok1, %kizu.slice.u8 zeroinitializer, 2");
    try append_line(out, "  ret %kizu.error.i64 %ok2");
    try append_line(out, "then_failed:");
    try append_line(out, "  %then_err = extractvalue %kizu.error.bool %then_result, 2");
