fn append_loop_terminal_statement_ok_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let continue_tag = try ast_data_tag(ir_bytes, "Continue");
    let break_tag = try ast_data_tag(ir_bytes, "Break");
    try append_line(out, "define i1 @kizu_selfhost__ir_codegen_loop_terminal_statement_ok(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %statement,");
    try append_line(out, "  i1 %want_continue");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %statement)");
    try append_line(out, "  %data = extractvalue %kizu.kizu.ast.ast_node %node, 1");
    try append_line(out, "  %tag = extractvalue %kizu.kizu.ast.ast_data %data, 0");
    try out.append_bytes("  %is_continue = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, continue_tag);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_continue, label %continue_node, label %check_break");
    try append_line(out, "continue_node:");
    try append_line(out, "  br i1 %want_continue, label %continue_label, label %unsupported");
    try append_line(out, "continue_label:");
    try append_line(out, "  %continue_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data, ptr %continue_slot, align 8");
    try append_line(out, "  %continue_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %continue_slot, i32 0, i32 1");
    try append_line(out, "  %continue_payload = load %kizu.kizu.ast.continue_node, ptr %continue_payload_ptr, align 8");
    try append_line(out, "  %continue_label_id = extractvalue %kizu.kizu.ast.continue_node %continue_payload, 0");
    try append_line(out,
        "  %continue_ok = call i1 @kizu_selfhost__ir_codegen_is_empty_node(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %continue_label_id)");
    try append_line(out, "  ret i1 %continue_ok");
    try append_line(out, "check_break:");
    try out.append_bytes("  %is_break = icmp eq i64 %tag, ");
    try std::fmt::append_i64(out, break_tag);
    try out.append_byte(cast<u8>(10));
