        "kizu_kizu__parser_is_double_token_byte",
        "%kizu.slice.u8 text;%kizu.kizu.lexer.token token;i8 first;i8 second"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_double_colon_at",
        "kizu_kizu__parser_is_double_colon_at",
        "%kizu.slice.u8 source;i64 end;i64 index"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_name_byte",
        "kizu_kizu__parser_is_name_byte",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_upper_byte",
        "kizu_kizu__parser_is_upper_byte",
        "i8 byte"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
        "std::kizu::parser::is_namespace_path_span",
        "kizu_kizu__parser_is_namespace_path_span",
        "%kizu.slice.u8 source;%kizu.kizu.ast.span span"
    );
    try compiled_llvm::append_compiled_function_auto(
        out, ir_bytes,
