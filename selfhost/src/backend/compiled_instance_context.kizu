import selfhost::backend::fact_tokens;
import selfhost::backend::ir_index;

pub struct InstanceContext {
    pub found: bool,
    pub target_component: i64,
    pub target_function: i64,
    pub instance_id: i64,
    pub requires_body: bool,
    actual_type_ids: std::array::Array<i64>,
    param_type_ids: std::array::Array<i64>,
    result_type_id: i64,
}

pub fn empty(allocator: Allocator) -> InstanceContext {
    return InstanceContext {
        found: false,
        target_component: -1,
        target_function: -1,
        instance_id: -1,
        requires_body: false,
        actual_type_ids: std::array::Array<i64>(allocator),
        param_type_ids: std::array::Array<i64>(allocator),
        result_type_id: -1
    };
}

pub fn actual_len(context: &InstanceContext) -> i64 {
    return context.actual_type_ids.len();
}

pub fn actual_type_id(context: &InstanceContext, formal_slot: i64) -> !i64 {
    if formal_slot < 0 or formal_slot >= actual_len(context) {
        return error("compiled instance formal slot out of range");
    }
    return context.actual_type_ids.get(formal_slot);
}

pub fn param_len(context: &InstanceContext) -> i64 {
    return context.param_type_ids.len();
}

pub fn param_type_id(context: &InstanceContext, param_index: i64) -> !i64 {
    if param_index < 0 or param_index >= param_len(context) {
        return error("compiled instance parameter index out of range");
    }
    return context.param_type_ids.get(param_index);
}

pub fn result_type_id(context: &InstanceContext) -> !i64 {
    if context.result_type_id < 0 {
        return error("compiled instance result type missing");
    }
    return context.result_type_id;
}

fn token(line: []u8, prefix: []u8, wanted: i64) -> ![]u8 {
    var start = std::mem::len(prefix);
    var index = 0;
    while index < wanted {
        let end = fact_tokens::token_end(line, start, std::mem::len(line));
        if end >= std::mem::len(line) {
            return error("compiled instance fact token missing");
        }
        start = end + 1;
        index = index + 1;
    }
    let end = fact_tokens::token_end(line, start, std::mem::len(line));
    if start >= end { return error("compiled instance fact token missing"); }
    return line[start..end];
}

fn token_i64(line: []u8, prefix: []u8, wanted: i64) -> !i64 {
    let value = try token(line, prefix, wanted);
    return fact_tokens::parse_nonnegative_i64(
        value, 0, std::mem::len(value)
    );
}

fn token_signed_i64(line: []u8, prefix: []u8, wanted: i64) -> !i64 {
    let value = try token(line, prefix, wanted);
    if std::mem::len(value) == 0 {
        return error("compiled instance signed token missing");
    }
    if std::mem::equal_bytes(value, "-9223372036854775808") {
        return -9223372036854775807 - 1;
    }
    var negative = false;
    var start = 0;
    if value[0] == cast<u8>(45) {
        negative = true;
        start = 1;
    }
    let magnitude = try fact_tokens::parse_nonnegative_i64(
        value, start, std::mem::len(value)
    );
    if negative { return 0 - magnitude; }
    return magnitude;
}

pub fn next_instance_id(
    index: &ir_index::IrIndex,
    facts: []u8,
    target_component: i64,
    target_function: i64,
    after_instance_id: i64
) -> !i64 {
    let prefix = "function-instance ";
    var entry = ir_index::first_entry_with_fact_prefix(index, facts, prefix);
    var result = -1;
    while entry >= 0 and ir_index::entry_key_starts_with(
        index, facts, entry, prefix
    ) {
        let line = facts[
            ir_index::entry_line_start(index, entry)..
            ir_index::entry_line_end(index, entry)
        ];
        if try token_i64(line, prefix, 0) == target_component and
            try token_i64(line, prefix, 1) == target_function {
            let candidate = try token_i64(line, prefix, 2);
            if candidate > after_instance_id and
                (result < 0 or candidate < result) {
                result = candidate;
            }
        }
        entry = entry + 1;
    }
    return result;
}

fn fact_matches_context(
    line: []u8,
    prefix: []u8,
    target_component: i64,
    target_function: i64,
    instance_id: i64
) -> !bool {
    return try token_i64(line, prefix, 0) == target_component and
        try token_i64(line, prefix, 1) == target_function and
        try token_i64(line, prefix, 2) == instance_id;
}

fn load_specialized_abi(
    param_type_ids: &var std::array::Array<i64>,
    index: &ir_index::IrIndex,
    facts: []u8,
    target_component: i64,
    target_function: i64,
    instance_id: i64
) -> !i64 {
    let param_prefix = "function-instance-param ";
    var entry = ir_index::first_entry_with_fact_prefix(index, facts, param_prefix);
    while entry >= 0 and ir_index::entry_key_starts_with(
        index, facts, entry, param_prefix
    ) {
        let line = facts[
            ir_index::entry_line_start(index, entry)..
            ir_index::entry_line_end(index, entry)
        ];
        if try fact_matches_context(
            line, param_prefix, target_component, target_function, instance_id
        ) {
            let sequence = try token_i64(line, param_prefix, 3);
            if sequence != param_type_ids.len() {
                return error("compiled instance parameter sequence is not exact");
            }
            let canonical_id = try token_i64(line, param_prefix, 4);
            try param_type_ids.append(canonical_id);
        }
        entry = entry + 1;
    }

    let result_prefix = "function-instance-result ";
    entry = ir_index::first_entry_with_fact_prefix(index, facts, result_prefix);
    var result_count = 0;
    var result_type_id = -1;
    while entry >= 0 and ir_index::entry_key_starts_with(
        index, facts, entry, result_prefix
    ) {
        let line = facts[
            ir_index::entry_line_start(index, entry)..
            ir_index::entry_line_end(index, entry)
        ];
        if try fact_matches_context(
            line, result_prefix, target_component, target_function, instance_id
        ) {
            result_type_id = try token_i64(line, result_prefix, 3);
            result_count = result_count + 1;
        }
        entry = entry + 1;
    }
    if result_count != 1 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled instance result type is not exact: component ");
        try std::fmt::append_i64(&var message, target_component);
        try message.append_bytes(" function ");
        try std::fmt::append_i64(&var message, target_function);
        try message.append_bytes(" instance ");
        try std::fmt::append_i64(&var message, instance_id);
        try message.append_bytes(" count ");
        try std::fmt::append_i64(&var message, result_count);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }

    return result_type_id;
}

pub fn load(
    allocator: Allocator,
    index: &ir_index::IrIndex,
    facts: []u8,
    target_component: i64,
    target_function: i64,
    instance_id: i64,
    expected_actual_len: i64
) -> !InstanceContext {
    if instance_id < 0 { return error("compiled instance ID out of range"); }
    let prefix = "function-instance ";
    var entry = ir_index::first_entry_with_fact_prefix(index, facts, prefix);
    var selected = facts[0..0];
    while entry >= 0 and ir_index::entry_key_starts_with(
        index, facts, entry, prefix
    ) {
        let line = facts[
            ir_index::entry_line_start(index, entry)..
            ir_index::entry_line_end(index, entry)
        ];
        if try token_i64(line, prefix, 2) == instance_id {
            if try token_i64(line, prefix, 0) != target_component or
                try token_i64(line, prefix, 1) != target_function {
                return error("compiled instance ID has conflicting target");
            }
            if std::mem::len(selected) > 0 {
                return error("duplicate compiled function instance ID");
            }
            selected = line;
        }
        entry = entry + 1;
    }
    if std::mem::len(selected) == 0 {
        return error("compiled function instance not found");
    }
    let mode = try token(selected, prefix, 3);
    let requires_body = std::mem::equal_bytes(mode, "body");
    if !requires_body and !std::mem::equal_bytes(mode, "callsite") {
        return error("compiled instance lowering mode invalid");
    }
    var actual_type_ids = std::array::Array<i64>(allocator);
    errdefer actual_type_ids.deinit();
    let binding_count = try token_i64(selected, prefix, 4);
    try actual_type_ids.reserve(expected_actual_len);
    var binding = 0;
    while binding < binding_count {
        let token_start = 5 + binding * 5;
        let kind = try token_i64(selected, prefix, token_start);
        if kind < 1 or kind > 3 {
            return error("compiled instance static binding kind invalid");
        }
        let canonical_id = try token_i64(selected, prefix, token_start + 1);
        let value_bits = try token_signed_i64(
            selected, prefix, token_start + 2
        );
        let function_component = try token_signed_i64(
            selected, prefix, token_start + 3
        );
        let function_id = try token_signed_i64(
            selected, prefix, token_start + 4
        );
        if kind == 1 {
            if value_bits != 0 or function_component != -1 or function_id != -1 {
                return error("compiled type static binding payload invalid");
            }
            try actual_type_ids.append(canonical_id);
        } else {
            if kind == 2 {
                if function_component != -1 or function_id != -1 {
                    return error("compiled scalar static binding payload invalid");
                }
            } else {
                if value_bits != 0 or function_component < 0 or function_id < 0 {
                    return error("compiled function static binding payload invalid");
                }
            }
        }
        binding = binding + 1;
    }
    if actual_type_ids.len() != expected_actual_len {
        return error("compiled instance static type arity mismatch");
    }
    var cursor = std::mem::len(prefix);
    var token_index = 0;
    let expected_token_count = 5 + binding_count * 5;
    while token_index < expected_token_count {
        let end = fact_tokens::token_end(
            selected, cursor, std::mem::len(selected)
        );
        if cursor >= end { return error("compiled instance fact token missing"); }
        cursor = end;
        token_index = token_index + 1;
        if token_index < expected_token_count {
            if cursor >= std::mem::len(selected) {
                return error("compiled instance fact token missing");
            }
            cursor = cursor + 1;
        }
    }
    if cursor != std::mem::len(selected) {
        return error("compiled instance fact has trailing tokens");
    }
    var param_type_ids = std::array::Array<i64>(allocator);
    errdefer param_type_ids.deinit();
    let result_type_id = try load_specialized_abi(
        &var param_type_ids, index, facts,
        target_component, target_function, instance_id
    );
    return InstanceContext {
        found: true,
        target_component: target_component,
        target_function: target_function,
        instance_id: instance_id,
        requires_body: requires_body,
        actual_type_ids: actual_type_ids,
        param_type_ids: param_type_ids,
        result_type_id: result_type_id
    };
}

pub fn symbol(
    index: &ir_index::IrIndex,
    facts: []u8,
    context: &InstanceContext
) -> ![]u8 borrows facts {
    let prefix = "function-instance-symbol ";
    var entry = ir_index::first_entry_with_fact_prefix(index, facts, prefix);
    var found = facts[0..0];
    while entry >= 0 and ir_index::entry_key_starts_with(index, facts, entry, prefix) {
        let line = facts[
            ir_index::entry_line_start(index, entry)..
            ir_index::entry_line_end(index, entry)
        ];
        if try token_i64(line, prefix, 0) == context.target_component and
            try token_i64(line, prefix, 1) == context.target_function and
            try token_i64(line, prefix, 2) == context.instance_id {
            if std::mem::len(found) > 0 {
                return error("duplicate compiled function instance symbol");
            }
            found = try token(line, prefix, 3);
        }
        entry = entry + 1;
    }
    if std::mem::len(found) == 0 {
        return error("compiled function instance symbol missing");
    }
    return found;
}

impl InstanceContext {
    fn deinit(self: InstanceContext) -> void {
        self.param_type_ids.deinit();
        self.actual_type_ids.deinit();
        return;
    }
}
