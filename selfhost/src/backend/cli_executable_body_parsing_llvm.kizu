import selfhost::backend::cli_executable_main_llvm;
import selfhost::backend::ir_contract;

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try require_selected_body_parsing(ir_bytes);
    try cli_executable_main_llvm::append_functions(out);
    try append_cli_is_supported_run_print_payload_function(out);
    try append_cli_parse_run_print_payload_function(out);
    try append_cli_parse_run_return_void_ok_function(out);
    try append_cli_parse_test_expect_value_function(out);
    try append_cli_parse_run_executable_ast_function(out, ir_bytes);
    try append_cli_parse_test_executable_ast_function(out, ir_bytes);
    return;
}

fn require_selected_body_parsing(ir_bytes: []u8) -> !void {
    try ir_contract::require_fact(
        ir_bytes,
        "executable-selected-body-parsing checked-ast-body-parsing-v1"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-parsing ",
        "selfhost::backend::executable::parse_run_executable_ast",
        "checked-run-ast"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-parsing ",
        "selfhost::backend::executable::parse_test_executable_ast",
        "checked-test-ast"
    );
    try require_run_parser_body_shape(ir_bytes);
    try require_test_parser_body_shape(ir_bytes);
    return;
}

fn require_run_parser_body_shape(ir_bytes: []u8) -> !void {
    let parse_run_program = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        parse_run_program,
        "parse_run_program_ast"
    );

    let parse_run_fn = try loop_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_program_ast",
        1,
        2,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_program_ast",
        parse_run_fn,
        "parse_run_fn_ast"
    );

    let parse_run_block = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        2,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        parse_run_block,
        "parse_run_block_ast"
    );

    let parse_run_print = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        3,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        parse_run_print,
        "parse_run_print_stmt_ast"
    );

    let parse_run_return = try return_match_arm_expr(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        3,
        1
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        parse_run_return,
        "parse_run_return_stmt_ast"
    );

    let is_empty = try function_if_condition_prefix_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        is_empty,
        "is_empty_node"
    );

    let parse_run_print_call = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        parse_run_print_call,
        "parse_run_print_call_ast"
    );

    let run_string_literal = try function_statement_value(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_call_ast",
        2
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_call_ast",
        run_string_literal,
        "run_string_literal_payload"
    );

    let run_payload = try return_match_arm_expr(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        run_payload,
        "run_payload_from_literal"
    );

    let is_supported = try function_if_condition_prefix_call(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        4
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        is_supported,
        "is_supported_run_print_payload"
    );
    return;
}

fn require_test_parser_body_shape(ir_bytes: []u8) -> !void {
    let parse_test_program = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        parse_test_program,
        "parse_test_program_ast"
    );

    let parse_test_fn = try loop_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_program_ast",
        1,
        2,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_program_ast",
        parse_test_fn,
        "parse_test_fn_ast"
    );

    let parse_test_block = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        2,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        parse_test_block,
        "parse_test_block_ast"
    );

    let is_void = try function_if_condition_right_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        is_void,
        "is_void_return_type"
    );

    let parse_single_statement_expect = try if_then_return_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        0,
        1
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        parse_single_statement_expect,
        "parse_test_expect_statement_ast"
    );

    let is_empty_return = try function_if_condition_prefix_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        4
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        is_empty_return,
        "is_empty_return"
    );

    let parse_two_statement_expect = try return_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        5
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        parse_two_statement_expect,
        "parse_test_expect_statement_ast"
    );

    let parse_expect_stmt = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        parse_expect_stmt,
        "parse_expect_stmt_ast"
    );

    let parse_expect_call = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        parse_expect_call,
        "parse_expect_call_ast"
    );

    let expect_bool = try function_statement_value(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        2
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        expect_bool,
        "expect_bool_value"
    );

    let bool_value = try return_match_arm_expr(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value",
        bool_value,
        "bool_value_as_i64"
    );
    return;
}

fn function_statement_sequence(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    return try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        0,
        "statement",
        statement_index
    );
}

fn child_sequence(
    ir_bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64
) -> !i64 {
    return try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        parent_sequence,
        edge,
        ordinal
    );
}

fn function_statement_value(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    let statement = try function_statement_sequence(ir_bytes, function_name, statement_index);
    return try child_sequence(ir_bytes, function_name, statement, "value", 0);
}

fn return_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    return try function_statement_value(ir_bytes, function_name, statement_index);
}

fn return_match_arm_expr(
    ir_bytes: []u8,
    function_name: []u8,
    return_statement_index: i64,
    arm_index: i64
) -> !i64 {
    let match_sequence = try return_call(ir_bytes, function_name, return_statement_index);
    return try match_arm_expr(ir_bytes, function_name, match_sequence, arm_index);
}

fn return_match_arm_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    return_statement_index: i64,
    arm_index: i64
) -> !i64 {
    let expr = try return_match_arm_expr(ir_bytes, function_name, return_statement_index, arm_index);
    return try child_sequence(ir_bytes, function_name, expr, "value", 0);
}

fn loop_match_arm_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    loop_statement_index: i64,
    loop_body_statement_index: i64,
    arm_index: i64
) -> !i64 {
    let loop_sequence = try function_statement_sequence(ir_bytes, function_name, loop_statement_index);
    let loop_body = try child_sequence(ir_bytes, function_name, loop_sequence, "body", 0);
    let let_sequence = try child_sequence(
        ir_bytes,
        function_name,
        loop_body,
        "statement",
        loop_body_statement_index
    );
    let match_sequence = try child_sequence(ir_bytes, function_name, let_sequence, "value", 0);
    let expr = try match_arm_expr(ir_bytes, function_name, match_sequence, arm_index);
    return try child_sequence(ir_bytes, function_name, expr, "value", 0);
}

fn match_arm_expr(
    ir_bytes: []u8,
    function_name: []u8,
    match_sequence: i64,
    arm_index: i64
) -> !i64 {
    let arm = try child_sequence(ir_bytes, function_name, match_sequence, "arm", arm_index);
    let body = try child_sequence(ir_bytes, function_name, arm, "body", 0);
    return try child_sequence(ir_bytes, function_name, body, "expr", 0);
}

fn function_if_condition_right_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    let if_sequence = try function_statement_sequence(ir_bytes, function_name, statement_index);
    let condition = try child_sequence(ir_bytes, function_name, if_sequence, "condition", 0);
    return try child_sequence(ir_bytes, function_name, condition, "right", 0);
}

fn function_if_condition_prefix_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    let if_sequence = try function_statement_sequence(ir_bytes, function_name, statement_index);
    let prefix = try child_sequence(ir_bytes, function_name, if_sequence, "condition", 0);
    return try child_sequence(ir_bytes, function_name, prefix, "right", 0);
}

fn if_then_return_call(
    ir_bytes: []u8,
    function_name: []u8,
    if_statement_index: i64,
    then_statement_index: i64
) -> !i64 {
    let if_sequence = try function_statement_sequence(ir_bytes, function_name, if_statement_index);
    let then_block = try child_sequence(ir_bytes, function_name, if_sequence, "then", 0);
    let return_sequence = try child_sequence(
        ir_bytes,
        function_name,
        then_block,
        "statement",
        then_statement_index
    );
    return try child_sequence(ir_bytes, function_name, return_sequence, "value", 0);
}

fn require_body_call(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    callee: []u8
) -> !void {
    try ir_contract::require_sequence_fact(ir_bytes, "body-call ", function_name, sequence, callee);
    return;
}

fn append_cli_parse_run_executable_ast_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let unsupported = try executable_ast_tag(ir_bytes, "Unsupported");
    let run_print = try executable_ast_tag(ir_bytes, "RunPrintCall");
    let run_return = try executable_ast_tag(ir_bytes, "RunReturnVoid");
    try append_line(out,
        "define %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_run_executable_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_empty_payload(out);
    try append_line(out,
        "  %payload_result = call %kizu.error.slice.u8 @kizu_selfhost__cli_parse_run_print_payload(%kizu.slice.u8 %source)");
    try append_line(out, "  %payload_ok = extractvalue %kizu.error.slice.u8 %payload_result, 0");
    try append_line(out, "  br i1 %payload_ok, label %run_print, label %check_return");
    try append_line(out, "run_print:");
    try append_line(out, "  %payload = extractvalue %kizu.error.slice.u8 %payload_result, 1");
    try append_executable_ast_return(out, "run_print", run_print, "payload");
    try append_line(out, "check_return:");
    try append_line(out,
        "  %return_ok = call i1 @kizu_selfhost__cli_parse_run_return_void_ok(%kizu.slice.u8 %source)");
    try append_line(out, "  br i1 %return_ok, label %run_return, label %unsupported");
    try append_line(out, "run_return:");
    try append_executable_ast_return(out, "run_return", run_return, "empty");
    try append_line(out, "unsupported:");
    try append_executable_ast_return(out, "unsupported", unsupported, "empty");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_test_executable_ast_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let unsupported = try executable_ast_tag(ir_bytes, "Unsupported");
    let test_ok = try executable_ast_tag(ir_bytes, "TestExpectTrue");
    let test_failure = try executable_ast_tag(ir_bytes, "TestExpectFalse");
    try append_line(out,
        "define %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_test_executable_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_empty_payload(out);
    try append_line(out,
        "  %expect = call i64 @kizu_selfhost__cli_parse_test_expect_value(%kizu.slice.u8 %source)");
    try append_line(out, "  %is_ok = icmp eq i64 %expect, 1");
    try append_line(out, "  br i1 %is_ok, label %test_ok, label %check_failure");
    try append_line(out, "test_ok:");
    try append_executable_ast_return(out, "test_ok", test_ok, "empty");
    try append_line(out, "check_failure:");
    try append_line(out, "  %is_failure = icmp eq i64 %expect, 0");
    try append_line(out, "  br i1 %is_failure, label %test_failure, label %unsupported");
    try append_line(out, "test_failure:");
    try append_executable_ast_return(out, "test_failure", test_failure, "empty");
    try append_line(out, "unsupported:");
    try append_executable_ast_return(out, "unsupported", unsupported, "empty");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_empty_payload(out: &var std::string::String) -> !void {
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %empty_base = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 %empty_base, i64 0, 1");
    return;
}

fn append_executable_ast_return(
    out: &var std::string::String,
    suffix: []u8,
    kind: i64,
    payload: []u8
) -> !void {
    try out.append_bytes("  %ast_kinded_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast zeroinitializer, i64 ");
    try std::fmt::append_i64(out, kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %ast_result_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast %ast_kinded_");
    try out.append_bytes(suffix);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(payload);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable.ast %ast_result_");
    try out.append_bytes(suffix);
    try out.append_byte(cast<u8>(10));
    return;
}

fn executable_ast_tag(ir_bytes: []u8, name: []u8) -> !i64 {
    return try ir_contract::named_i64_fact(ir_bytes, "executable-ast-kind ", name);
}

fn append_cli_is_supported_run_print_payload_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_is_supported_run_print_payload(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %len");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %offset = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %offset, %len");
    try append_line(out, "  br i1 %done, label %true, label %load");
    try append_line(out, "load:");
    try append_line(out, "  %index = add i64 %start, %offset");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %min_ok = icmp uge i8 %byte, 32");
    try append_line(out, "  %max_ok = icmp ule i8 %byte, 126");
    try append_line(out, "  %range_ok = and i1 %min_ok, %max_ok");
    try append_line(out, "  %is_quote = icmp eq i8 %byte, 34");
    try append_line(out, "  %not_special = xor i1 %is_quote, true");
    try append_line(out, "  %safe = and i1 %range_ok, %not_special");
    try append_line(out, "  br i1 %safe, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %offset, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_run_print_payload_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.error.slice.u8 @kizu_selfhost__cli_parse_run_print_payload(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %plain_body_start = call i64 @kizu_selfhost__cli_run_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_plain_body = icmp sge i64 %plain_body_start, 0");
    try append_line(out, "  br i1 %has_plain_body, label %check_print_plain, label %check_print_void_body");
    try append_line(out, "check_print_void_body:");
    try append_line(out,
        "  %void_body_start = call i64 @kizu_selfhost__cli_run_void_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_void_body = icmp sge i64 %void_body_start, 0");
    try append_line(out, "  br i1 %has_void_body, label %check_print_void, label %continue");
    try append_line(out, "check_print_plain:");
    try append_line(out, "  br label %prepare_check_print");
    try append_line(out, "check_print_void:");
    try append_line(out, "  br label %prepare_check_print");
    try append_line(out, "prepare_check_print:");
    try append_line(out,
        "  %body_start = phi i64 [ %plain_body_start, %check_print_plain ], [ %void_body_start, %check_print_void ]");
    try append_line(out, "  br label %check_print");
    try append_test_next_word_check(
        out,
        "print",
        "body_start",
        "5",
        "112",
        "114",
        "105",
        "110",
        "116",
        "0",
        "0",
        "check_print_lparen",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "print_lparen",
        "print_end",
        "40",
        "check_arg",
        "continue"
    );
    try append_line(out, "check_arg:");
    try append_line(out,
        "  %arg_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %print_lparen_end)");
    try append_line(out, "  %arg_in_bounds = icmp slt i64 %arg_start, %source_len");
    try append_line(out, "  br i1 %arg_in_bounds, label %load_arg, label %continue");
    try append_line(out, "load_arg:");
    try append_line(out,
        "  %arg_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %arg_start)");
    try append_line(out,
        "  %arg_len = sub i64 %arg_end, %arg_start");
    try append_line(out, "  %arg_has_quotes = icmp sge i64 %arg_len, 2");
    try append_line(out, "  br i1 %arg_has_quotes, label %load_quote, label %continue");
    try append_line(out, "load_quote:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %quote_start_ptr = getelementptr i8, ptr %source_ptr, i64 %arg_start");
    try append_line(out, "  %quote_start = load i8, ptr %quote_start_ptr");
    try append_line(out, "  %quote_start_ok = icmp eq i8 %quote_start, 34");
    try append_line(out, "  %quote_end_index = sub i64 %arg_end, 1");
    try append_line(out, "  %quote_end_ptr = getelementptr i8, ptr %source_ptr, i64 %quote_end_index");
    try append_line(out, "  %quote_end = load i8, ptr %quote_end_ptr");
    try append_line(out, "  %quote_end_ok = icmp eq i8 %quote_end, 34");
    try append_line(out, "  %quotes_ok = and i1 %quote_start_ok, %quote_end_ok");
    try append_line(out, "  br i1 %quotes_ok, label %validate_payload, label %continue");
    try append_line(out, "validate_payload:");
    try append_line(out, "  %payload_start = add i64 %arg_start, 1");
    try append_line(out, "  %payload_len = sub i64 %arg_len, 2");
    try append_line(out,
        "  %payload_ok = call i1 @kizu_selfhost__cli_is_supported_run_print_payload(%kizu.slice.u8 %source, i64 %payload_start, i64 %payload_len)");
    try append_line(out, "  br i1 %payload_ok, label %check_print_rparen, label %continue");
    try append_test_next_token_char_check(
        out,
        "print_rparen",
        "arg_end",
        "41",
        "check_print_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "print_semicolon",
        "print_rparen_end",
        "59",
        "check_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "rbrace",
        "print_semicolon_end",
        "125",
        "check_eof",
        "continue"
    );
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %found, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "found:");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %source_ptr, i64 %payload_start");
    try append_line(out, "  %payload_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload = insertvalue %kizu.slice.u8 %payload_base, i64 %payload_len, 1");
    try append_line(out,
        "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %payload, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "not_found:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_run_return_void_ok_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_parse_run_return_void_ok(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
