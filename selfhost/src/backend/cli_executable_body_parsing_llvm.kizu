import selfhost::backend::cli_executable_main_llvm;
import selfhost::backend::cli_executable_parser_token_llvm;
import selfhost::backend::executable;

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try cli_executable_main_llvm::append_functions(out, ir_bytes);
    try append_cli_is_supported_run_print_payload_function(out, ir_bytes);
    try append_cli_parse_run_print_payload_function(out, ir_bytes);
    try append_cli_parse_run_return_void_ok_function(out, ir_bytes);
    try append_cli_parse_test_expect_value_function(out, ir_bytes);
    try append_cli_parse_run_executable_ast_function(out, ir_bytes);
    try append_cli_parse_test_executable_ast_function(out, ir_bytes);
    return;
}

fn append_cli_parse_run_executable_ast_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let unsupported = try executable::unsupported_executable_ast_kind_tag();
    let run_print = try executable::expr_stmt_executable_ast_kind_tag();
    let run_return = try executable::run_return_executable_ast_kind_tag();
    try append_line(out,
        "define %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_run_executable_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_empty_payload(out);
    try append_line(out,
        "  %payload_result = call %kizu.error.slice.u8 @kizu_selfhost__cli_parse_run_print_payload(%kizu.slice.u8 %source)");
    try append_line(out, "  %payload_ok = extractvalue %kizu.error.slice.u8 %payload_result, 0");
    try append_line(out, "  br i1 %payload_ok, label %run_print, label %check_return");
    try append_line(out, "run_print:");
    try append_line(out, "  %callee = extractvalue %kizu.error.slice.u8 %payload_result, 1");
    try append_line(out, "  %payload = extractvalue %kizu.error.slice.u8 %payload_result, 2");
    try append_executable_ast_return(out, "run_print", run_print, "callee", "payload");
    try append_line(out, "check_return:");
    try append_line(out,
        "  %return_ok = call i1 @kizu_selfhost__cli_parse_run_return_void_ok(%kizu.slice.u8 %source)");
    try append_line(out, "  br i1 %return_ok, label %run_return, label %unsupported");
    try append_line(out, "run_return:");
    try append_executable_ast_return(out, "run_return", run_return, "empty", "empty");
    try append_line(out, "unsupported:");
    try append_executable_ast_return(out, "unsupported", unsupported, "empty", "empty");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_test_executable_ast_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let unsupported = try executable::unsupported_executable_ast_kind_tag();
    let call = try executable::call_executable_ast_kind_tag();
    try append_line(out,
        "define %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_test_executable_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_empty_payload(out);
    try append_line(out,
        "  %expect = call %kizu.error.slice.u8 @kizu_selfhost__cli_parse_test_expect_value(%kizu.slice.u8 %source)");
    try append_line(out, "  %expect_ok = extractvalue %kizu.error.slice.u8 %expect, 0");
    try append_line(out, "  br i1 %expect_ok, label %test_expect, label %unsupported");
    try append_line(out, "test_expect:");
    try append_line(out, "  %callee = extractvalue %kizu.error.slice.u8 %expect, 1");
    try append_line(out, "  %payload = extractvalue %kizu.error.slice.u8 %expect, 2");
    try append_executable_ast_return(out, "test_expect", call, "callee", "payload");
    try append_line(out, "unsupported:");
    try append_executable_ast_return(out, "unsupported", unsupported, "empty", "empty");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_empty_payload(out: &var std::string::String) -> !void {
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %empty_base = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 %empty_base, i64 0, 1");
    return;
}

fn append_executable_ast_return(
    out: &var std::string::String,
    suffix: []u8,
    kind: i64,
    callee: []u8,
    payload: []u8
) -> !void {
    try out.append_bytes("  %ast_kinded_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast zeroinitializer, i64 ");
    try std::fmt::append_i64(out, kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %ast_result_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast %ast_kinded_");
    try out.append_bytes(suffix);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(callee);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %ast_payload_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast %ast_result_");
    try out.append_bytes(suffix);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(payload);
    try out.append_bytes(", 2");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable.ast %ast_payload_");
    try out.append_bytes(suffix);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_is_supported_run_print_payload_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let min_byte = executable::run_payload_min_byte();
    let max_byte = executable::run_payload_max_byte();
    let forbidden_byte = executable::run_payload_forbidden_byte();
    try append_line(out, "define i1 @kizu_selfhost__cli_is_supported_run_print_payload(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %len");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %offset = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %offset, %len");
    try append_line(out, "  br i1 %done, label %true, label %load");
    try append_line(out, "load:");
    try append_line(out, "  %index = add i64 %start, %offset");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_i8_constant_line(out, "  %min_ok = icmp uge i8 %byte, ", min_byte);
    try append_i8_constant_line(out, "  %max_ok = icmp ule i8 %byte, ", max_byte);
    try append_line(out, "  %range_ok = and i1 %min_ok, %max_ok");
    try append_i8_constant_line(out, "  %is_quote = icmp eq i8 %byte, ", forbidden_byte);
    try append_line(out, "  %not_special = xor i1 %is_quote, true");
    try append_line(out, "  %safe = and i1 %range_ok, %not_special");
    try append_line(out, "  br i1 %safe, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %offset, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_run_print_payload_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let quote_byte = executable::run_literal_quote_byte();
    let min_length = executable::run_literal_min_length();
    let start_quote_offset = executable::run_literal_start_quote_offset();
    let end_quote_margin = executable::run_literal_end_quote_offset_from_end();
    let payload_start_offset = executable::run_literal_payload_start_offset();
    let payload_width = executable::run_literal_payload_delimiter_width();
    try append_line(out,
        "define %kizu.error.slice.u8 @kizu_selfhost__cli_parse_run_print_payload(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %plain_body_start = call i64 @kizu_selfhost__cli_run_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_plain_body = icmp sge i64 %plain_body_start, 0");
    try append_line(out, "  br i1 %has_plain_body, label %check_print_plain, label %check_print_void_body");
    try append_line(out, "check_print_void_body:");
    try append_line(out,
        "  %void_body_start = call i64 @kizu_selfhost__cli_run_void_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_void_body = icmp sge i64 %void_body_start, 0");
    try append_line(out, "  br i1 %has_void_body, label %check_print_void, label %continue");
    try append_line(out, "check_print_plain:");
    try append_line(out, "  br label %prepare_check_print");
    try append_line(out, "check_print_void:");
    try append_line(out, "  br label %prepare_check_print");
    try append_line(out, "prepare_check_print:");
    try append_line(out,
        "  %body_start = phi i64 [ %plain_body_start, %check_print_plain ], [ %void_body_start, %check_print_void ]");
    try append_line(out, "  br label %check_print");
    try append_test_next_word_check(
        out,
        ir_bytes,
        "print",
        "body_start",
        "run-print-callee",
        "check_print_lparen",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "print_lparen",
        "print_end",
        "syntax-lparen",
        "check_arg",
        "continue"
    );
    try append_line(out, "check_arg:");
    try append_line(out,
        "  %arg_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %print_lparen_end)");
    try append_line(out, "  %arg_in_bounds = icmp slt i64 %arg_start, %source_len");
    try append_line(out, "  br i1 %arg_in_bounds, label %load_arg, label %continue");
    try append_line(out, "load_arg:");
    try append_line(out,
        "  %arg_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %arg_start)");
    try append_line(out,
        "  %arg_len = sub i64 %arg_end, %arg_start");
    try append_i64_constant_line(out, "  %arg_has_quotes = icmp sge i64 %arg_len, ", min_length);
    try append_line(out, "  br i1 %arg_has_quotes, label %load_quote, label %continue");
    try append_line(out, "load_quote:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_i64_constant_line(out, "  %quote_start_index = add i64 %arg_start, ", start_quote_offset);
    try append_line(out,
        "  %quote_start_ptr = getelementptr i8, ptr %source_ptr, i64 %quote_start_index");
    try append_line(out, "  %quote_start = load i8, ptr %quote_start_ptr");
    try append_i8_constant_line(out, "  %quote_start_ok = icmp eq i8 %quote_start, ", quote_byte);
    try append_i64_constant_line(out, "  %quote_end_index = sub i64 %arg_end, ", end_quote_margin);
    try append_line(out, "  %quote_end_ptr = getelementptr i8, ptr %source_ptr, i64 %quote_end_index");
    try append_line(out, "  %quote_end = load i8, ptr %quote_end_ptr");
    try append_i8_constant_line(out, "  %quote_end_ok = icmp eq i8 %quote_end, ", quote_byte);
    try append_line(out, "  %quotes_ok = and i1 %quote_start_ok, %quote_end_ok");
    try append_line(out, "  br i1 %quotes_ok, label %validate_payload, label %continue");
    try append_line(out, "validate_payload:");
    try append_i64_constant_line(out, "  %payload_start = add i64 %arg_start, ", payload_start_offset);
    try append_i64_constant_line(out, "  %payload_len = sub i64 %arg_len, ", payload_width);
    try append_line(out,
        "  %payload_ok = call i1 @kizu_selfhost__cli_is_supported_run_print_payload(%kizu.slice.u8 %source, i64 %payload_start, i64 %payload_len)");
    try append_line(out, "  br i1 %payload_ok, label %check_print_rparen, label %continue");
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "print_rparen",
        "arg_end",
        "syntax-rparen",
        "check_print_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "print_semicolon",
        "print_rparen_end",
        "syntax-semicolon",
        "check_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "rbrace",
        "print_semicolon_end",
        "syntax-rbrace",
        "check_eof",
        "continue"
    );
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %found, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "found:");
    try append_line(out, "  %callee_ptr = getelementptr i8, ptr %source_ptr, i64 %print_start");
    try append_line(out, "  %callee_len = sub i64 %print_end, %print_start");
    try append_line(out, "  %callee_base = insertvalue %kizu.slice.u8 poison, ptr %callee_ptr, 0");
    try append_line(out, "  %callee = insertvalue %kizu.slice.u8 %callee_base, i64 %callee_len, 1");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %source_ptr, i64 %payload_start");
    try append_line(out, "  %payload_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload = insertvalue %kizu.slice.u8 %payload_base, i64 %payload_len, 1");
    try append_line(out,
        "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %callee_result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %callee, 1");
    try append_line(out,
        "  %result = insertvalue %kizu.error.slice.u8 %callee_result, %kizu.slice.u8 %payload, 2");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "not_found:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_i8_constant_line(
    out: &var std::string::String,
    prefix: []u8,
    value: i64
) -> !void {
    try out.append_bytes(prefix);
    try std::fmt::append_i64(out, value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_i64_constant_line(
    out: &var std::string::String,
    prefix: []u8,
    value: i64
) -> !void {
    try out.append_bytes(prefix);
    try std::fmt::append_i64(out, value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_expect_value_phi(
    out: &var std::string::String,
    true_value: i64,
    false_value: i64
) -> !void {
    try out.append_bytes("  %expect_value = phi i64 [ ");
    try std::fmt::append_i64(out, true_value);
    try out.append_bytes(", %bool_true_value ], [ ");
    try std::fmt::append_i64(out, false_value);
    try out.append_bytes(", %bool_false_value ]");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_parse_run_return_void_ok_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_parse_run_return_void_ok(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %plain_body_start = call i64 @kizu_selfhost__cli_run_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_plain_body = icmp sge i64 %plain_body_start, 0");
    try append_line(out,
        "  br i1 %has_plain_body, label %check_return_plain, label %check_return_void_body");
    try append_line(out, "check_return_void_body:");
    try append_line(out,
        "  %void_body_start = call i64 @kizu_selfhost__cli_run_void_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_void_body = icmp sge i64 %void_body_start, 0");
    try append_line(out, "  br i1 %has_void_body, label %check_return_void, label %continue");
    try append_line(out, "check_return_plain:");
    try append_line(out, "  br label %prepare_check_return");
    try append_line(out, "check_return_void:");
    try append_line(out, "  br label %prepare_check_return");
    try append_line(out, "prepare_check_return:");
    try append_line(out,
        "  %body_start = phi i64 [ %plain_body_start, %check_return_plain ], [ %void_body_start, %check_return_void ]");
    try append_line(out, "  br label %check_return");
    try append_test_next_word_check(
        out,
        ir_bytes,
        "return",
        "body_start",
        "syntax-return",
        "check_return_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "return_semicolon",
        "return_end",
        "syntax-semicolon",
        "check_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "rbrace",
        "return_semicolon_end",
        "syntax-rbrace",
        "check_eof",
        "continue"
    );
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %found, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "found:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_test_expect_value_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__cli_parse_test_expect_value(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %void_body_start = call i64 @kizu_selfhost__cli_test_void_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_void_body = icmp sge i64 %void_body_start, 0");
    try append_line(out, "  br i1 %has_void_body, label %check_std_void, label %check_error_body");
    try append_line(out, "check_error_body:");
    try append_line(out,
        "  %error_body_start = call i64 @kizu_selfhost__cli_test_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_error_body = icmp sge i64 %error_body_start, 0");
    try append_line(out, "  br i1 %has_error_body, label %check_std_error, label %continue");
    try append_line(out, "check_std_void:");
    try append_line(out, "  br label %prepare_check_std");
    try append_line(out, "check_std_error:");
    try append_line(out, "  br label %prepare_check_std");
    try append_line(out, "prepare_check_std:");
    try append_line(out,
        "  %body_start = phi i64 [ %void_body_start, %check_std_void ], [ %error_body_start, %check_std_error ]");
    try append_line(out,
        "  %requires_return = phi i1 [ false, %check_std_void ], [ true, %check_std_error ]");
    try append_line(out, "  br label %check_std");
    try append_test_next_word_check(
        out,
        ir_bytes,
        "std",
        "body_start",
        "expect-callee-root",
        "check_colon_one",
        "continue"
    );
    try append_test_next_token_pair_check(
        out,
        ir_bytes,
        "colon_one",
        "std_end",
        "syntax-colon-pair",
        "check_testing",
        "continue"
    );
    try append_test_next_word_check(
        out,
        ir_bytes,
        "testing",
        "colon_one_end",
        "expect-callee-module",
        "check_colon_two",
        "continue"
    );
    try append_test_next_token_pair_check(
        out,
        ir_bytes,
        "colon_two",
        "testing_end",
        "syntax-colon-pair",
        "check_expect",
        "continue"
    );
    try append_test_next_word_check(
        out,
        ir_bytes,
        "expect",
        "colon_two_end",
        "expect-callee-function",
        "check_lparen",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "lparen",
        "expect_end",
        "syntax-lparen",
        "check_bool",
        "continue"
    );
    try append_line(out, "check_bool:");
    try append_line(out,
        "  %bool_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %lparen_end)");
    try append_line(out, "  %bool_in_bounds = icmp slt i64 %bool_start, %source_len");
    try append_line(out, "  br i1 %bool_in_bounds, label %load_bool, label %continue");
    try append_line(out, "load_bool:");
    try append_line(out,
        "  %bool_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %bool_start)");
    try cli_executable_parser_token_llvm::append_token_word_eq_call(
        out,
        ir_bytes,
        "bool_true",
        "bool_start",
        "bool_end",
        "literal-true"
    );
    try append_line(out, "  br i1 %bool_true, label %bool_true_value, label %maybe_bool_false");
    try append_line(out, "maybe_bool_false:");
    try cli_executable_parser_token_llvm::append_token_word_eq_call(
        out,
        ir_bytes,
        "bool_false",
        "bool_start",
        "bool_end",
        "literal-false"
    );
    try append_line(out, "  br i1 %bool_false, label %bool_false_value, label %continue");
    try append_line(out, "bool_true_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "bool_false_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "check_rparen:");
    try append_line(out,
        "  %bool_value_start = phi i64 [ %bool_start, %bool_true_value ], [ %bool_start, %bool_false_value ]");
    try append_line(out,
        "  %bool_value_end = phi i64 [ %bool_end, %bool_true_value ], [ %bool_end, %bool_false_value ]");
    try append_line(out,
        "  %rparen_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %bool_end)");
    try append_line(out, "  %rparen_in_bounds = icmp slt i64 %rparen_start, %source_len");
    try append_line(out, "  br i1 %rparen_in_bounds, label %load_rparen, label %continue");
    try append_line(out, "load_rparen:");
    try append_line(out,
        "  %rparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %rparen_start)");
    try cli_executable_parser_token_llvm::append_token_char_eq_call(
        out,
        ir_bytes,
        "rparen_ok",
        "rparen",
        "rparen",
        "syntax-rparen"
    );
    try append_line(out, "  br i1 %rparen_ok, label %check_expect_semicolon, label %continue");
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "expect_semicolon",
        "rparen_end",
        "syntax-semicolon",
        "after_expect_semicolon",
        "continue"
    );
    try append_line(out, "after_expect_semicolon:");
    try append_line(out,
        "  br i1 %requires_return, label %check_return, label %check_void_rbrace");
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "void_rbrace",
        "expect_semicolon_end",
        "syntax-rbrace",
        "check_void_eof",
        "check_void_return"
    );
    try append_line(out, "check_void_eof:");
    try append_line(out,
        "  %after_void_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %void_rbrace_end)");
    try append_line(out, "  %at_void_eof = icmp eq i64 %after_void_rbrace, %source_len");
    try append_line(out, "  br i1 %at_void_eof, label %return_expect, label %continue");
    try append_test_next_word_check(
        out,
        ir_bytes,
        "void_return",
        "expect_semicolon_end",
        "syntax-return",
        "check_void_return_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "void_return_semicolon",
        "void_return_end",
        "syntax-semicolon",
        "check_void_return_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "void_return_rbrace",
        "void_return_semicolon_end",
        "syntax-rbrace",
        "check_void_return_eof",
        "continue"
    );
    try append_line(out, "check_void_return_eof:");
    try append_line(out,
        "  %after_void_return_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %void_return_rbrace_end)");
    try append_line(out,
        "  %at_void_return_eof = icmp eq i64 %after_void_return_rbrace, %source_len");
    try append_line(out, "  br i1 %at_void_return_eof, label %return_expect, label %continue");
    try append_test_next_word_check(
        out,
        ir_bytes,
        "return",
        "expect_semicolon_end",
        "syntax-return",
        "check_return_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "return_semicolon",
        "return_end",
        "syntax-semicolon",
        "check_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "rbrace",
        "return_semicolon_end",
        "syntax-rbrace",
        "check_eof",
        "continue"
    );
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %return_expect, label %continue");
    try append_line(out, "return_expect:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %callee_ptr = getelementptr i8, ptr %source_ptr, i64 %std_start");
    try append_line(out, "  %callee_len = sub i64 %expect_end, %std_start");
    try append_line(out, "  %callee_base = insertvalue %kizu.slice.u8 poison, ptr %callee_ptr, 0");
    try append_line(out, "  %callee = insertvalue %kizu.slice.u8 %callee_base, i64 %callee_len, 1");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %source_ptr, i64 %bool_value_start");
    try append_line(out, "  %payload_len = sub i64 %bool_value_end, %bool_value_start");
    try append_line(out, "  %payload_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload = insertvalue %kizu.slice.u8 %payload_base, i64 %payload_len, 1");
    try append_line(out,
        "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %callee_result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %callee, 1");
    try append_line(out,
        "  %result = insertvalue %kizu.error.slice.u8 %callee_result, %kizu.slice.u8 %payload, 2");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "not_found:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_test_next_token_pair_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_pair_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_test_next_token_char_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_char_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_test_next_word_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_word_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_check_label(out: &var std::string::String, name: []u8) -> !void {
    try out.append_bytes("check_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_next_token_load(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(previous_end);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds = icmp slt i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, %source_len");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds, label %load_");
    try out.append_bytes(name);
    try out.append_bytes(", label %continue");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("load_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_named_branch(
    out: &var std::string::String,
    name: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_ok, label %");
    try out.append_bytes(ok_label);
    try out.append_bytes(", label %");
    try out.append_bytes(fail_label);
    try out.append_byte(cast<u8>(10));
    return;
}


fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
