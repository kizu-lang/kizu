import selfhost::backend::cli_executable_main_llvm;
import selfhost::backend::cli_executable_parser_token_llvm;

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try cli_executable_main_llvm::append_functions(out, ir_bytes);
    try append_cli_parse_test_expect_value_function(out, ir_bytes);
    return;
}

fn append_expect_value_phi(
    out: &var std::string::String,
    true_value: i64,
    false_value: i64
) -> !void {
    try out.append_bytes("  %expect_value = phi i64 [ ");
    try std::fmt::append_i64(out, true_value);
    try out.append_bytes(", %bool_true_value ], [ ");
    try std::fmt::append_i64(out, false_value);
    try out.append_bytes(", %bool_false_value ]");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_parse_test_expect_value_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__cli_parse_test_expect_value(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %void_body_start = call i64 @kizu_selfhost__cli_test_void_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_void_body = icmp sge i64 %void_body_start, 0");
    try append_line(out, "  br i1 %has_void_body, label %check_std_void, label %check_error_body");
    try append_line(out, "check_error_body:");
    try append_line(out,
        "  %error_body_start = call i64 @kizu_selfhost__cli_test_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_error_body = icmp sge i64 %error_body_start, 0");
    try append_line(out, "  br i1 %has_error_body, label %check_std_error, label %continue");
    try append_line(out, "check_std_void:");
    try append_line(out, "  br label %prepare_check_std");
    try append_line(out, "check_std_error:");
    try append_line(out, "  br label %prepare_check_std");
    try append_line(out, "prepare_check_std:");
    try append_line(out,
        "  %body_start = phi i64 [ %void_body_start, %check_std_void ], [ %error_body_start, %check_std_error ]");
    try append_line(out,
        "  %requires_return = phi i1 [ false, %check_std_void ], [ true, %check_std_error ]");
    try append_line(out, "  br label %check_std");
    try append_test_next_word_check(
        out,
        ir_bytes,
        "std",
        "body_start",
        "expect-callee-root",
        "check_colon_one",
        "continue"
    );
    try append_test_next_token_pair_check(
        out,
        ir_bytes,
        "colon_one",
        "std_end",
        "syntax-colon-pair",
        "check_testing",
        "continue"
    );
    try append_test_next_word_check(
        out,
        ir_bytes,
        "testing",
        "colon_one_end",
        "expect-callee-module",
        "check_colon_two",
        "continue"
    );
    try append_test_next_token_pair_check(
        out,
        ir_bytes,
        "colon_two",
        "testing_end",
        "syntax-colon-pair",
        "check_expect",
        "continue"
    );
    try append_test_next_word_check(
        out,
        ir_bytes,
        "expect",
        "colon_two_end",
        "expect-callee-function",
        "check_lparen",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "lparen",
        "expect_end",
        "syntax-lparen",
        "check_bool",
        "continue"
    );
    try append_line(out, "check_bool:");
    try append_line(out,
        "  %bool_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %lparen_end)");
    try append_line(out, "  %bool_in_bounds = icmp slt i64 %bool_start, %source_len");
    try append_line(out, "  br i1 %bool_in_bounds, label %load_bool, label %continue");
    try append_line(out, "load_bool:");
    try append_line(out,
        "  %bool_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %bool_start)");
    try cli_executable_parser_token_llvm::append_token_word_eq_call(
        out,
        ir_bytes,
        "bool_true",
        "bool_start",
        "bool_end",
        "literal-true"
    );
    try append_line(out, "  br i1 %bool_true, label %bool_true_value, label %maybe_bool_false");
    try append_line(out, "maybe_bool_false:");
    try cli_executable_parser_token_llvm::append_token_word_eq_call(
        out,
        ir_bytes,
        "bool_false",
        "bool_start",
        "bool_end",
        "literal-false"
    );
    try append_line(out, "  br i1 %bool_false, label %bool_false_value, label %continue");
    try append_line(out, "bool_true_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "bool_false_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "check_rparen:");
    try append_line(out,
        "  %bool_value_start = phi i64 [ %bool_start, %bool_true_value ], [ %bool_start, %bool_false_value ]");
    try append_line(out,
        "  %bool_value_end = phi i64 [ %bool_end, %bool_true_value ], [ %bool_end, %bool_false_value ]");
    try append_line(out,
        "  %rparen_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %bool_end)");
    try append_line(out, "  %rparen_in_bounds = icmp slt i64 %rparen_start, %source_len");
    try append_line(out, "  br i1 %rparen_in_bounds, label %load_rparen, label %continue");
    try append_line(out, "load_rparen:");
    try append_line(out,
        "  %rparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %rparen_start)");
    try cli_executable_parser_token_llvm::append_token_char_eq_call(
        out,
        ir_bytes,
        "rparen_ok",
        "rparen",
        "rparen",
        "syntax-rparen"
    );
    try append_line(out, "  br i1 %rparen_ok, label %check_expect_semicolon, label %continue");
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "expect_semicolon",
        "rparen_end",
        "syntax-semicolon",
        "after_expect_semicolon",
        "continue"
    );
    try append_line(out, "after_expect_semicolon:");
    try append_line(out,
        "  br i1 %requires_return, label %check_return, label %check_void_rbrace");
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "void_rbrace",
        "expect_semicolon_end",
        "syntax-rbrace",
        "check_void_eof",
        "check_void_return"
    );
    try append_line(out, "check_void_eof:");
    try append_line(out,
        "  %after_void_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %void_rbrace_end)");
    try append_line(out, "  %at_void_eof = icmp eq i64 %after_void_rbrace, %source_len");
    try append_line(out, "  br i1 %at_void_eof, label %return_expect, label %continue");
    try append_test_next_word_check(
        out,
        ir_bytes,
        "void_return",
        "expect_semicolon_end",
        "syntax-return",
        "check_void_return_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "void_return_semicolon",
        "void_return_end",
        "syntax-semicolon",
        "check_void_return_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "void_return_rbrace",
        "void_return_semicolon_end",
        "syntax-rbrace",
        "check_void_return_eof",
        "continue"
    );
    try append_line(out, "check_void_return_eof:");
    try append_line(out,
        "  %after_void_return_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %void_return_rbrace_end)");
    try append_line(out,
        "  %at_void_return_eof = icmp eq i64 %after_void_return_rbrace, %source_len");
    try append_line(out, "  br i1 %at_void_return_eof, label %return_expect, label %continue");
    try append_test_next_word_check(
        out,
        ir_bytes,
        "return",
        "expect_semicolon_end",
        "syntax-return",
        "check_return_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "return_semicolon",
        "return_end",
        "syntax-semicolon",
        "check_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        ir_bytes,
        "rbrace",
        "return_semicolon_end",
        "syntax-rbrace",
        "check_eof",
        "continue"
    );
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %return_expect, label %continue");
    try append_line(out, "return_expect:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %callee_ptr = getelementptr i8, ptr %source_ptr, i64 %std_start");
    try append_line(out, "  %callee_len = sub i64 %expect_end, %std_start");
    try append_line(out, "  %callee_base = insertvalue %kizu.slice.u8 poison, ptr %callee_ptr, 0");
    try append_line(out, "  %callee = insertvalue %kizu.slice.u8 %callee_base, i64 %callee_len, 1");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %source_ptr, i64 %bool_value_start");
    try append_line(out, "  %payload_len = sub i64 %bool_value_end, %bool_value_start");
    try append_line(out, "  %payload_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload = insertvalue %kizu.slice.u8 %payload_base, i64 %payload_len, 1");
    try append_line(out,
        "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %callee_result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %callee, 1");
    try append_line(out,
        "  %result = insertvalue %kizu.error.slice.u8 %callee_result, %kizu.slice.u8 %payload, 2");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "not_found:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_test_next_token_pair_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_pair_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_test_next_token_char_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_char_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_test_next_word_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_word_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_check_label(out: &var std::string::String, name: []u8) -> !void {
    try out.append_bytes("check_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_next_token_load(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(previous_end);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds = icmp slt i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, %source_len");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds, label %load_");
    try out.append_bytes(name);
    try out.append_bytes(", label %continue");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("load_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_named_branch(
    out: &var std::string::String,
    name: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_ok, label %");
    try out.append_bytes(ok_label);
    try out.append_bytes(", label %");
    try out.append_bytes(fail_label);
    try out.append_byte(cast<u8>(10));
    return;
}


fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
