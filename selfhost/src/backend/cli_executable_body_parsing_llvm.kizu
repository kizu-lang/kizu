    try append_line(out,
        "  %rparen_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %rparen_start, i64 %rparen_end, i8 41)");
    try append_line(out, "  br i1 %rparen_ok, label %check_expect_semicolon, label %continue");
