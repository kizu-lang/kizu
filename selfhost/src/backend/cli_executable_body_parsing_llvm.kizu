    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %plain_body_start = call i64 @kizu_selfhost__cli_run_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_plain_body = icmp sge i64 %plain_body_start, 0");
    try append_line(out,
        "  br i1 %has_plain_body, label %check_return_plain, label %check_return_void_body");
    try append_line(out, "check_return_void_body:");
    try append_line(out,
        "  %void_body_start = call i64 @kizu_selfhost__cli_run_void_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_void_body = icmp sge i64 %void_body_start, 0");
    try append_line(out, "  br i1 %has_void_body, label %check_return_void, label %continue");
    try append_line(out, "check_return_plain:");
    try append_line(out, "  br label %prepare_check_return");
    try append_line(out, "check_return_void:");
    try append_line(out, "  br label %prepare_check_return");
    try append_line(out, "prepare_check_return:");
    try append_line(out,
        "  %body_start = phi i64 [ %plain_body_start, %check_return_plain ], [ %void_body_start, %check_return_void ]");
    try append_line(out, "  br label %check_return");
    try append_test_next_word_check(
        out,
        "return",
        "body_start",
        "6",
        "114",
        "101",
        "116",
        "117",
        "114",
        "110",
