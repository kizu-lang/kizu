pub fn append_functions(out: &var std::string::String) -> !void {
    try append_write_concat5_function(out);
    try append_write_concat9_function(out);
    try append_i64_decimal_function(out);
    try append_artifact_path_function(out);
    return;
}

fn append_write_concat5_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__write_concat5(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %first,");
    try append_line(out, "  %kizu.slice.u8 %second,");
    try append_line(out, "  %kizu.slice.u8 %third,");
    try append_line(out, "  %kizu.slice.u8 %fourth,");
    try append_line(out, "  %kizu.slice.u8 %fifth");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %first_ptr = extractvalue %kizu.slice.u8 %first, 0");
    try append_line(out, "  %first_len = extractvalue %kizu.slice.u8 %first, 1");
    try append_line(out, "  %second_ptr = extractvalue %kizu.slice.u8 %second, 0");
    try append_line(out, "  %second_len = extractvalue %kizu.slice.u8 %second, 1");
    try append_line(out, "  %third_ptr = extractvalue %kizu.slice.u8 %third, 0");
    try append_line(out, "  %third_len = extractvalue %kizu.slice.u8 %third, 1");
    try append_line(out, "  %fourth_ptr = extractvalue %kizu.slice.u8 %fourth, 0");
    try append_line(out, "  %fourth_len = extractvalue %kizu.slice.u8 %fourth, 1");
    try append_line(out, "  %fifth_ptr = extractvalue %kizu.slice.u8 %fifth, 0");
    try append_line(out, "  %fifth_len = extractvalue %kizu.slice.u8 %fifth, 1");
    try append_line(out, "  %first_second_len = add i64 %first_len, %second_len");
    try append_line(out, "  %third_offset = add i64 %first_second_len, %third_len");
    try append_line(out, "  %fourth_offset = add i64 %third_offset, %fourth_len");
    try append_line(out, "  %total_len = add i64 %fourth_offset, %fifth_len");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %total_len)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %copy_first, label %alloc_failed");
    try append_line(out, "copy_first:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %buffer, ptr %first_ptr, i64 %first_len, i1 false)");
    try append_line(out, "  %second_dest = getelementptr i8, ptr %buffer, i64 %first_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %second_dest, ptr %second_ptr, i64 %second_len, i1 false)");
    try append_line(out,
        "  %third_dest = getelementptr i8, ptr %buffer, i64 %first_second_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %third_dest, ptr %third_ptr, i64 %third_len, i1 false)");
    try append_line(out, "  %fourth_dest = getelementptr i8, ptr %buffer, i64 %third_offset");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %fourth_dest, ptr %fourth_ptr, i64 %fourth_len, i1 false)");
    try append_line(out, "  %fifth_dest = getelementptr i8, ptr %buffer, i64 %fourth_offset");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %fifth_dest, ptr %fifth_ptr, i64 %fifth_len, i1 false)");
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %total_len, 1");
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned %io, %kizu.slice.u8 %path, %kizu.slice.u8 %body)");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %buffer)");
    try append_line(out, "  ret %kizu.error.void %write");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_artifact_path_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__artifact_path(");
    try append_line(out, "  %kizu.slice.u8 %target,");
    try append_line(out, "  %kizu.slice.u8 %prefix,");
    try append_line(out, "  %kizu.slice.u8 %suffix");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %target_ptr = extractvalue %kizu.slice.u8 %target, 0");
    try append_line(out, "  %target_len = extractvalue %kizu.slice.u8 %target, 1");
    try append_line(out, "  br label %scan");
    try append_line(out, "scan:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %base_start = phi i64 [ 0, %entry ], [ %next_base_start, %advance ]");
    try append_line(out, "  %dot_index = phi i64 [ -1, %entry ], [ %next_dot_index, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %target_len");
    try append_line(out, "  br i1 %done, label %build, label %scan_body");
    try append_line(out, "scan_body:");
    try append_line(out, "  %byte_ptr = getelementptr i8, ptr %target_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %byte_ptr");
    try append_line(out, "  %is_slash = icmp eq i8 %byte, 47");
    try append_line(out, "  %is_dot = icmp eq i8 %byte, 46");
    try append_line(out, "  %after_slash = add i64 %index, 1");
    try append_line(out, "  %next_base_start = select i1 %is_slash, i64 %after_slash, i64 %base_start");
    try append_line(out, "  %dot_or_previous = select i1 %is_dot, i64 %index, i64 %dot_index");
    try append_line(out, "  %next_dot_index = select i1 %is_slash, i64 -1, i64 %dot_or_previous");
    try append_line(out, "  br label %advance");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %scan");
    try append_line(out, "build:");
    try append_line(out, "  %has_dot = icmp sge i64 %dot_index, %base_start");
    try append_line(out, "  %stem_end = select i1 %has_dot, i64 %dot_index, i64 %target_len");
    try append_line(out, "  %stem_len = sub i64 %stem_end, %base_start");
    try append_line(out, "  %prefix_ptr = extractvalue %kizu.slice.u8 %prefix, 0");
    try append_line(out, "  %prefix_len = extractvalue %kizu.slice.u8 %prefix, 1");
    try append_line(out, "  %suffix_ptr = extractvalue %kizu.slice.u8 %suffix, 0");
    try append_line(out, "  %suffix_len = extractvalue %kizu.slice.u8 %suffix, 1");
    try append_line(out, "  %prefix_stem_len = add i64 %prefix_len, %stem_len");
    try append_line(out, "  %total_len = add i64 %prefix_stem_len, %suffix_len");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %total_len)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %copy_prefix, label %alloc_failed");
    try append_line(out, "copy_prefix:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %buffer, ptr %prefix_ptr, i64 %prefix_len, i1 false)");
    try append_line(out, "  %stem_dest = getelementptr i8, ptr %buffer, i64 %prefix_len");
    try append_line(out, "  %stem_ptr = getelementptr i8, ptr %target_ptr, i64 %base_start");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %stem_dest, ptr %stem_ptr, i64 %stem_len, i1 false)");
    try append_line(out, "  %suffix_dest = getelementptr i8, ptr %buffer, i64 %prefix_stem_len");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %suffix_dest, ptr %suffix_ptr, i64 %suffix_len, i1 false)");
    try append_line(out, "  %path_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %path = insertvalue %kizu.slice.u8 %path_base, i64 %total_len, 1");
    try append_line(out,
        "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %path, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_concat9_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__write_concat9(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_concat9_params(out);
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_concat9_extracts(out);
    try append_concat9_offsets(out);
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %total_len)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %copy_first, label %alloc_failed");
    try append_concat9_copies(out);
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %total_len, 1");
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned %io, %kizu.slice.u8 %path, %kizu.slice.u8 %body)");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %buffer)");
    try append_line(out, "  ret %kizu.error.void %write");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_concat9_params(out: &var std::string::String) -> !void {
    try append_line(out, "  %kizu.slice.u8 %first,");
    try append_line(out, "  %kizu.slice.u8 %second,");
    try append_line(out, "  %kizu.slice.u8 %third,");
    try append_line(out, "  %kizu.slice.u8 %fourth,");
    try append_line(out, "  %kizu.slice.u8 %fifth,");
    try append_line(out, "  %kizu.slice.u8 %sixth,");
    try append_line(out, "  %kizu.slice.u8 %seventh,");
    try append_line(out, "  %kizu.slice.u8 %eighth,");
    try append_line(out, "  %kizu.slice.u8 %ninth");
    return;
}

fn append_concat9_extracts(out: &var std::string::String) -> !void {
    try append_concat9_extract(out, "first");
    try append_concat9_extract(out, "second");
    try append_concat9_extract(out, "third");
    try append_concat9_extract(out, "fourth");
    try append_concat9_extract(out, "fifth");
    try append_concat9_extract(out, "sixth");
    try append_concat9_extract(out, "seventh");
    try append_concat9_extract(out, "eighth");
    try append_concat9_extract(out, "ninth");
    return;
}

fn append_concat9_extract(out: &var std::string::String, name: []u8) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_len = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_concat9_offsets(out: &var std::string::String) -> !void {
    try append_line(out, "  %second_offset = add i64 %first_len, %second_len");
    try append_line(out, "  %third_offset = add i64 %second_offset, %third_len");
    try append_line(out, "  %fourth_offset = add i64 %third_offset, %fourth_len");
    try append_line(out, "  %fifth_offset = add i64 %fourth_offset, %fifth_len");
    try append_line(out, "  %sixth_offset = add i64 %fifth_offset, %sixth_len");
    try append_line(out, "  %seventh_offset = add i64 %sixth_offset, %seventh_len");
    try append_line(out, "  %eighth_offset = add i64 %seventh_offset, %eighth_len");
    try append_line(out, "  %total_len = add i64 %eighth_offset, %ninth_len");
    return;
}

fn append_concat9_copies(out: &var std::string::String) -> !void {
    try append_line(out, "copy_first:");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %buffer, ptr %first_ptr, i64 %first_len, i1 false)");
    try append_concat9_copy(out, "second", "first_len");
    try append_concat9_copy(out, "third", "second_offset");
    try append_concat9_copy(out, "fourth", "third_offset");
    try append_concat9_copy(out, "fifth", "fourth_offset");
    try append_concat9_copy(out, "sixth", "fifth_offset");
    try append_concat9_copy(out, "seventh", "sixth_offset");
    try append_concat9_copy(out, "eighth", "seventh_offset");
    try append_concat9_copy(out, "ninth", "eighth_offset");
    return;
}

fn append_concat9_copy(
    out: &var std::string::String,
    name: []u8,
    offset: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_dest = getelementptr i8, ptr %buffer, i64 %");
    try out.append_bytes(offset);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  call void @llvm.memcpy.p0.p0.i64(ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_dest, ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_ptr, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_len, i1 false)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_i64_decimal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__i64_decimal(i64 %value) {");
    try append_line(out, "entry:");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 20)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %check_zero, label %alloc_failed");
    try append_line(out, "check_zero:");
    try append_line(out, "  %is_zero = icmp eq i64 %value, 0");
    try append_line(out, "  br i1 %is_zero, label %zero, label %loop");
    try append_line(out, "zero:");
    try append_line(out, "  %zero_ptr = getelementptr i8, ptr %buffer, i64 19");
    try append_line(out, "  store i8 48, ptr %zero_ptr");
    try append_line(out, "  br label %finish_zero");
    try append_line(out, "loop:");
    try append_line(out, "  %current = phi i64 [ %value, %check_zero ], [ %quotient, %loop ]");
    try append_line(out, "  %write_index = phi i64 [ 19, %check_zero ], [ %next_index, %loop ]");
    try append_line(out, "  %digit = srem i64 %current, 10");
    try append_line(out, "  %digit_byte_i64 = add i64 %digit, 48");
    try append_line(out, "  %digit_byte = trunc i64 %digit_byte_i64 to i8");
    try append_line(out, "  %digit_ptr = getelementptr i8, ptr %buffer, i64 %write_index");
    try append_line(out, "  store i8 %digit_byte, ptr %digit_ptr");
    try append_line(out, "  %quotient = sdiv i64 %current, 10");
    try append_line(out, "  %next_index = sub i64 %write_index, 1");
    try append_line(out, "  %done = icmp eq i64 %quotient, 0");
    try append_line(out, "  br i1 %done, label %finish_loop, label %loop");
    try append_line(out, "finish_zero:");
    try append_line(out, "  br label %success");
    try append_line(out, "finish_loop:");
    try append_line(out, "  br label %success");
    try append_line(out, "success:");
    try append_line(out, "  %start = phi i64 [ 19, %finish_zero ], [ %write_index, %finish_loop ]");
    try append_line(out, "  %len = sub i64 20, %start");
    try append_line(out, "  %start_ptr = getelementptr i8, ptr %buffer, i64 %start");
    try append_line(out, "  %slice_base = insertvalue %kizu.slice.u8 poison, ptr %start_ptr, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %slice_base, i64 %len, 1");
    try append_line(out,
        "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %slice, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
