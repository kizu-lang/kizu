import selfhost::parser;
import selfhost::ir::component_function_catalog;
import selfhost::ir::executable_body;
import selfhost::ir::executable_functions;
import selfhost::ir::function_signature;
import selfhost::backend::compiled_abi_params;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_llvm;

// format_driver_lowering_gate drives the production compiled LLVM lowering over the real
// selfhost::parser::format::format_source body and reports the measured next blocker, instead of
// pinning the blocker in a comment (issue 1165 / 1162). It reads the on-disk format.kizu, parses
// it, builds the production ComponentFunctionCatalog for the 'selfhost::parser::format' component,
// finds format_source, and emits its real signature + body IR facts the same way the IR fact
// catalog does. It then derives the compiled params_spec / llvm_symbol from those facts and calls
// compiled_llvm::append_compiled_function_auto -- the production single-member lowering driver --
// over them. The driver's call surface is accepted by the facts layer (proven by
// format_driver_facts_gate), so lowering proceeds into the generic multi-statement machinery
// (lower_multi_statement_function). The first thing it does for each top-level 'var' is probe
// whether the var seeds a loop induction counter (statement_is_induction_init ->
// while_carries_induction_var). format_source's scan loop advances 'index' inside a terminal
// if/else branch-merge (a loop-terminating 'index = format_tokens.len()' on the eof arm and an
// 'index = index + 1' on the else arm) rather than a trailing-increment Assign;
// while_carries_induction_var now recognizes that branch-merge induction latch
// (while_is_branch_merge_latch) and classifies 'index' without erroring, so the probe no longer
// stops at "compiled mir: while body must end with the induction increment" and lowering advances
// into the real statement lowering. The first top-level statement
// 'var format_tokens = try lexer::tokenize(allocator, source)' lowers fully: the generic
// cross-module resolver (cross_module_callee_qualified_name_or_empty ->
// lookup_qualified_function_name_by_callee_suffix) resolves the alias-qualified 'lexer::tokenize'
// to the emitted '*::lexer::tokenize' signature this gate supplies below, the try-call success type
// unwraps its !Array<Token> error union, and the Allocator argument type lowers. The second
// statement 'var out = std::string::String(allocator)' lowers its stdlib value constructor through
// the stdlib-symbol path (lookup_stdlib_return): the gate supplies the same global stdlib-symbol
// preamble the production IR carries via the shared
// executable_functions::append_runtime_stdlib_symbol_preamble helper, so the
// 'stdlib-symbol std::string::String' fact is present and the constructor binds a %kizu.owned
// local. The leading_import_indices sibling call then resolves its return type from the emitted
// component signatures (this gate emits every local function-signature-return fact below), and its
// '&format_tokens' borrow argument lowers through the borrow-prefix call-arg path
// (compiled_mir_lower_call::lower_single_call_arg). Lowering now advances to format_source's first
// top-level 'if' statement 'if leading_imports.len() > 1 { ... }'
// (selfhost/src/parser/format.kizu:28). Its then-block is a void multi-statement body (let
// bindings, a nested if, sibling/method call statements, and several assignments to outer vars),
// but the compiled if-lowering only supports a continue-latch then-block or a single-Return
// then-block (selfhost/src/backend/compiled_mir_lower.kizu:4900), so it raises
// "compiled mir: unsupported then block". Lowering a general void multi-statement if-then block is
// the next capability -- a multi-part blocker (statement-list branch bodies, nested if, call
// statements, multi-assign) -- so the gate stops here. The gate is expected to fail with that
// error; the backend test asserts it, pinning the measured blocker as a behavior gate.
pub fn format_driver_lowering_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let path = "selfhost/src/parser/format.kizu";
    let text = try std::fs::read_file(io, path);
    var parsed = try parser::parse_checked_file(allocator, path, text);
    defer parsed.deinit();
    var catalog = try component_function_catalog::collect_from_ast(
        allocator, text, parsed.ast, parsed.root, "selfhost::parser::format"
    );
    defer catalog.deinit();

    let format_index = try component_function_catalog::find_local_function_index(
        &catalog, "format_source"
    );
    let format_node = try component_function_catalog::function_node_id(&catalog, format_index);
    let body = try format_driver_body_node(parsed.ast, format_node);

    var facts = std::string::String(allocator);
    defer facts.deinit();
    // Emit the full component's local function signatures, the same way the production IR
    // carries every selfhost::parser::format function-signature-return fact. format_source's
    // body calls sibling helpers (leading_import_indices, index_after_leading_imports, ...) and
    // the compiled lowering resolves each call's return type from its function-signature-return
    // fact (compiled_signature::resolve_call_return_type); supplying only format_source's own
    // signature left those sibling facts absent and lowering raised
    // "compiled signature: call return type not found" at the first such sibling call
    // (selfhost/src/parser/format.kizu:23, 'try leading_import_indices(...)'). Iterating the
    // catalog is generic component-signature emission, not format_source-specific dispatch
    // (issue 1165 / 1162).
    var sig_index = 0;
    while sig_index < component_function_catalog::len(&catalog) {
        let sig_node = try component_function_catalog::function_node_id(&catalog, sig_index);
        try function_signature::append_catalog(
            &var facts, text, parsed.ast, sig_node, &catalog, sig_index
        );
        sig_index = sig_index + 1;
    }
    try executable_body::append_catalog_helper_body_ir(
        &var facts, text, parsed.ast, &catalog, format_index, "checked-format-driver", body
    );

    // Supply the cross-module callee signature the lowering resolves for the driver's first
    // statement 'var format_tokens = try lexer::tokenize(allocator, source)'. format_source
    // reaches the tokenizer through the 'import selfhost::lexer' alias; the compiled backend
    // emits the real tokenizer entry under std::kizu::lexer::tokenize (the selfhost::lexer
    // wrapper forwards to it and is not separately compiled), exactly the signature fact the
    // production IR carries (function-signature-return std::kizu::lexer::tokenize ...). Emit
    // that real signature from the std kizu lexer's own AST so the generic cross-module
    // resolver (lookup_qualified_function_name_by_callee_suffix) matches '*::lexer::tokenize'
    // over real facts rather than a fabricated return-type string (issue 1165 / 1162).
    try append_external_callee_signature(
        &var facts, allocator, "std/src/kizu/lexer.kizu", "std::kizu::lexer", "tokenize"
    );

    // Supply the global stdlib-symbol preamble the production IR carries, via the same shared
    // helper append_codegen_function_facts uses. format_source's second statement
    // 'var out = std::string::String(allocator)' lowers the String value constructor through
    // the stdlib-symbol path (lookup_stdlib_return), and without this preamble the
    // 'stdlib-symbol std::string::String' fact is absent and lowering raised
    // "compiled function: stdlib return not found". Routing the gate through the same source of
    // truth as production means the gate exercises the real stdlib-symbol surface rather than a
    // gate-local fabrication (issue 1165 / 1162).
    try executable_functions::append_runtime_stdlib_symbol_preamble(&var facts);

    // Round-trip the facts through a file so ir_bytes is a freshly-read owned []u8 with external
    // provenance, exactly like the production backend which reads target/selfhost/selfhost.ir back
    // before lowering. A String.as_bytes() borrow cannot escape into the params_spec / LLVM-text
    // builders the lowering writes into, so the file boundary is what makes the slices ownable.
    let facts_path = "target/selfhost/format_driver_gate.ir";
    if !(try std::fs::exists(io, "target")) {
        try std::fs::create_dir(io, "target");
    }
    if !(try std::fs::exists(io, "target/selfhost")) {
        try std::fs::create_dir(io, "target/selfhost");
    }
    let facts_bytes = facts.as_bytes();
    try std::fs::write_file(io, &facts_path, &facts_bytes);
    let ir_bytes = try std::fs::read_file(io, &facts_path);

    try format_driver_lower(allocator, ir_bytes);
    return;
}

fn format_driver_lower(allocator: Allocator, ir_bytes: []u8) -> !void {
    let function_name = "selfhost::parser::format::format_source";
    var params_spec = std::string::String(allocator);
    defer params_spec.deinit();
    try compiled_abi_params::append_params_spec(&var params_spec, ir_bytes, function_name);
    let params_spec_bytes = params_spec.as_bytes();
    var llvm_symbol = std::string::String(allocator);
    defer llvm_symbol.deinit();
    try compiled_signature::append_function_llvm_symbol(&var llvm_symbol, function_name);
    let llvm_symbol_bytes = llvm_symbol.as_bytes();

    var out = std::string::String(allocator);
    defer out.deinit();
    try compiled_llvm::append_compiled_function_auto(
        &var out, ir_bytes, function_name, &llvm_symbol_bytes, &params_spec_bytes
    );

    // Reached only if format_source lowers without error; with the cross-module call-return-type
    // fact still missing this print is unreachable and the gate fails at the lowering blocker instead.
    print("format-driver-lowering-ok");
    return;
}

// append_external_callee_signature emits the real function-signature-return / -param facts
// for a cross-module callee by running the production component catalog + function_signature
// emission over the callee's own on-disk source, instead of fabricating a metadata table.
// The signature is keyed under <component_prefix>::<function_name>, the same name the owning
// compiled closure emits, so the generic cross-module resolver matches it by suffix.
fn append_external_callee_signature(
    facts: &var std::string::String,
    allocator: Allocator,
    path: []u8,
    component_prefix: []u8,
    function_name: []u8
) -> !void {
    let io = std::io::blocking();
    let text = try std::fs::read_file(io, path);
    var parsed = try parser::parse_checked_file(allocator, path, text);
    defer parsed.deinit();
    var catalog = try component_function_catalog::collect_from_ast(
        allocator, text, parsed.ast, parsed.root, component_prefix
    );
    defer catalog.deinit();
    let index = try component_function_catalog::find_local_function_index(
        &catalog, function_name
    );
    let node = try component_function_catalog::function_node_id(&catalog, index);
    try function_signature::append_catalog(facts, text, parsed.ast, node, &catalog, index);
    return;
}

fn format_driver_body_node(
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !std::kizu::ast::NodeId {
    let node = ast.get(node_id);
    match node.data {
        FnDecl(fn_decl) => return fn_decl.body;,
        _ => return error("format driver gate: missing format_source body");,
    }
}
