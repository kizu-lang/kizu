import selfhost::ir::executable_functions;
import selfhost::backend::compiled_abi_params;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_llvm;
import selfhost::backend::compiled_canonical_facts;
import selfhost::backend::ir_index;

// format_driver_lowering_gate drives the production compiled LLVM lowering over the real
// selfhost::parser::format::format_source body and reports success only after the compiled MIR
// lowerer and LLVM renderer cross the real driver path. It consumes the canonical package,
// signature, call-target, type, and builtin facts emitted by the production numeric package
// collector, where format_source is an external ABI entrypoint. It then derives the compiled
// params_spec / return ABI / llvm_symbol from those facts and calls the production single-member
// lowering driver over them. All indexed lookups share one caller-owned IrIndex, so this gate sorts
// the production fact artifact only once.
//
// Lowering now completes and renders the leading-import no-else void if:
// 'if leading_imports.len() > 1 { ... }' (selfhost/src/parser/format.kizu:28), including its nested
// no-else void if at format.kizu:31. lower_void_then_body lowers the nested free-function try-call
// statement and the six scalar reassignments ('index = next_index;' .. 'at_line_start = true;',
// format.kizu:33-38). lower_multi_if_statement carries the nested try_counter forward so the
// VoidTryCall labels do not collide with sibling try-calls, and the compiled MIR if renderer merges
// assignment aliases through the fall-through join instead of redefining the original SSA names.
// The following non-try expression statement, 'leading_imports.deinit();' (format.kizu:41), now
// lowers through the generic OwnedDeinit path: it validates a zero-arg value-method deinit on a
// local/parameter receiver, resolves the receiver's Kizu and LLVM types from facts, requires a
// std::array::Array<T> lowering to %kizu.owned, and renders @kizu_rt_owned_deinit (issue 1209).
// The main formatter loop, 'while index < format_tokens.len() { ... }' (format.kizu:42), now
// reaches the branch-merge latch lowering instead of the old trailing-increment suffix check. The
// terminal if/else is validated structurally: the EOF arm assigns 'index = format_tokens.len();'
// (format.kizu:69), the non-EOF arm ends with 'index = index + 1;' (format.kizu:144), both target
// the same i64 induction var, and the exit value matches the while header bound. The nested
// positive try-call condition
// 'if try rbrace_closes_enum_decl(source, &format_tokens, index) {' (format.kizu:46) now lowers as
// a hoisted free-function !bool condition and descends through its void then-body. The following
// 'let state = try append_preserved_line_comments(...)' (format.kizu:56) now binds a
// CommentFormatState success value whose field reads at format.kizu:65-67 resolve from real
// struct-field facts emitted from the callee's declared '!CommentFormatState' return payload. The
// EOF branch immediately after those reads,
// 'if lexer::is_eof(token) { ... } else { ... }' (format.kizu:68), now lowers as a real void
// if/else: both arms lower through the void-body path, the else arm preserves its branch-local
// let-try 'let trailing_comma = try is_trailing_comma(...)' (format.kizu:71), and reassigned locals
// merge through the rendered then/else join instead of dropping the else arm. The nested rbrace
// branch assignment 'depth = depth - 1;' (format.kizu:75) now lowers its Binary subtraction value
// through the same type-checked alias assignment path as other scalar reassignment values. The
// following nested else-path append, 'try out.append_byte(cast<u8>(10));' (format.kizu:81), now
// lowers through lower_string_method_arg's CastExpr path: the cast target lowers to the method's
// expected LLVM argument type before the literal is passed through the existing IntLiteral
// call-arg renderer. The next reassignment, 'last = last_byte(text);' (format.kizu:86), now lowers
// as a Call-valued alias assignment: the call return type resolves from the local helper signature,
// its scalar arg lowers through the existing call-arg path, and the resulting i8 is checked against
// the target local's i8 type before aliasing. The later compound condition
// 'if depth == 0 and out.len() > 0 and std::mem::len(previous) > 0 ...' (format.kizu:99) lowers
// the std::string::String receiver through a StringLen MIR expression. The later void if condition
// 'if !(try next_token_text_equals(source, &format_tokens, index, "}"))' (format.kizu:130) lowers
// its hoisted !bool try-call with inverted branch polarity, and descends into the newline then-body
// (format.kizu:131-133). Void-body alias names are generated from the alias slot instead of a fixed
// table, so the real path no longer exhausts at slot 63. The main loop's branch-merge latch now
// carries non-induction scalar aliases through typed phis, starting with the earlier assignment
// 'previous = ","' (format.kizu:51). The gate now reaches full format_source lowering and LLVM
// rendering and prints "format-driver-lowering-ok" (refs 1165 / 1162, issue 1231).
pub fn format_driver_lowering_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    // format_source is a production external ABI entrypoint. Consume the same package catalog,
    // dependency closure, signatures, type facts, and exact body-call classifications as the CLI;
    // this gate owns no parallel source parser or ABI preamble.
    var facts = try executable_functions::numeric_package_collector_facts();
    defer facts.deinit();

    // Round-trip the facts through a file so ir_bytes is a freshly-read owned []u8 with external
    // provenance, exactly like the production backend which reads target/selfhost/selfhost.ir back
    // before lowering. A String.as_bytes() borrow cannot escape into the params_spec / LLVM-text
    // builders the lowering writes into, so the file boundary is what makes the slices ownable.
    let facts_path = "target/selfhost/format_driver_gate.ir";
    if !(try std::fs::exists(io, "target")) {
        try std::fs::create_dir(io, "target");
    }
    if !(try std::fs::exists(io, "target/selfhost")) {
        try std::fs::create_dir(io, "target/selfhost");
    }
    let facts_bytes = facts.as_bytes();
    try std::fs::write_file(io, &facts_path, &facts_bytes);
    let ir_bytes = try std::fs::read_file(io, &facts_path);

    try format_driver_lower(allocator, ir_bytes);
    return;
}

fn format_driver_lower(allocator: Allocator, ir_bytes: []u8) -> !void {
    let function_name = "selfhost::parser::format::format_source";
    var lookup_index = try ir_index::build(ir_bytes);
    defer lookup_index.deinit();
    var canonical_facts = try compiled_canonical_facts::parse_and_validate(
        &lookup_index, ir_bytes
    );
    defer canonical_facts.deinit();
    var params_spec = std::string::String(allocator);
    defer params_spec.deinit();
    try compiled_abi_params::append_params_spec_indexed(
        &lookup_index, &var params_spec, ir_bytes, function_name
    );
    let params_spec_bytes = params_spec.as_bytes();
    let llvm_return_type = try compiled_signature::derive_return_type_indexed(
        &lookup_index, ir_bytes, function_name
    );
    var llvm_symbol = std::string::String(allocator);
    defer llvm_symbol.deinit();
    try compiled_signature::append_function_llvm_symbol(&var llvm_symbol, function_name);
    let llvm_symbol_bytes = llvm_symbol.as_bytes();

    var out = std::string::String(allocator);
    defer out.deinit();
    try compiled_llvm::append_compiled_function_auto_return_indexed(
        &lookup_index,
        &canonical_facts,
        &var out,
        ir_bytes,
        function_name,
        &llvm_symbol_bytes,
        llvm_return_type,
        &params_spec_bytes
    );

    // Reached only if format_source lowers without error; while a measured blocker remains,
    // this print is unreachable and the backend test asserts the exact blocker instead.
    print("format-driver-lowering-ok");
    return;
}
