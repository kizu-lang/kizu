import selfhost::backend::compiled_error_abi;
import selfhost::backend::compiled_fact_lookup;
import selfhost::backend::compiled_type_layout;
import selfhost::backend::compiled_type_resolver;
import selfhost::backend::compiled_util;
import selfhost::abi::fixed_abi_contract;
import selfhost::backend::ir_index;
import selfhost::type_spelling;

// DeclarationRegistry derives the LLVM named-type preamble from exact type
// facts. It keeps nominal identity traversal separate from LLVM declaration
// claims: a source type may be reached more than once, but one LLVM name can
// never silently acquire two owners.
struct DeclarationRegistry {
    state_identities: std::array::Array<[]u8>,
    state_values: std::array::Array<i64>,
    nominal_claim_identities: std::array::Array<[]u8>,
    nominal_claim_names: std::array::Array<[]u8>,
    error_payloads: std::array::Array<[]u8>,
    error_names: std::array::Array<[]u8>,
    pending_functions: std::array::Array<[]u8>,
    pending_modules: std::array::Array<[]u8>,
    pending_types: std::array::Array<[]u8>,
    existing_declarations: std::string::String,
}

impl DeclarationRegistry {
    fn deinit(self: DeclarationRegistry) -> void {
        self.existing_declarations.deinit();
        self.error_names.deinit();
        self.error_payloads.deinit();
        self.pending_types.deinit();
        self.pending_modules.deinit();
        self.pending_functions.deinit();
        self.nominal_claim_names.deinit();
        self.nominal_claim_identities.deinit();
        self.state_values.deinit();
        self.state_identities.deinit();
    }
}

fn new_registry() -> DeclarationRegistry {
    let allocator = std::mem::page_allocator();
    return DeclarationRegistry {
        state_identities: std::array::Array<[]u8>(allocator),
        state_values: std::array::Array<i64>(allocator),
        nominal_claim_identities: std::array::Array<[]u8>(allocator),
        nominal_claim_names: std::array::Array<[]u8>(allocator),
        error_payloads: std::array::Array<[]u8>(allocator),
        error_names: std::array::Array<[]u8>(allocator),
        pending_functions: std::array::Array<[]u8>(allocator),
        pending_modules: std::array::Array<[]u8>(allocator),
        pending_types: std::array::Array<[]u8>(allocator),
        existing_declarations: std::string::String(allocator)
    };
}

// append_reachable_declarations is the reusable declaration boundary. roots
// contain Kizu type spellings (including !T); all nominal layouts and opaque
// representations come from facts rather than a type-name table.
pub fn append_reachable_declarations(
    out: &var std::string::String,
    facts: []u8,
    roots: &std::array::Array<[]u8>
) -> !void {
    var index = try ir_index::build(facts);
    defer index.deinit();
    var registry = new_registry();
    defer registry.deinit();
    try seed_existing_declarations(&var registry, out);
    var root_index = 0;
    while root_index < roots.len() {
        let root = try roots.get(root_index);
        let unused = try lower_and_declare(
            out, &var registry, &index, facts, facts[0..0], facts[0..0], root
        );
        if std::mem::len(unused) == 0 {
            return error("type declaration registry: empty lowered root");
        }
        root_index = root_index + 1;
    }
    try drain_pending_types(out, &var registry, &index, facts);
    return;
}

// append_reachable_fact_declarations is the production entry. The IR producer
// emits one `reachable-type <function> <kizu-type>` fact for every runtime
// signature/body type in the compiled function closure. Function-owner-module
// supplies the declaring lookup context; no source or type spelling is selected
// here.
pub fn append_reachable_fact_declarations_indexed(
    out: &var std::string::String,
    index: &ir_index::IrIndex,
    facts: []u8
) -> !void {
    var registry = new_registry();
    defer registry.deinit();
    try seed_existing_declarations(&var registry, out);
    let prefix = "reachable-type ";
    let prefix_len = std::mem::len(prefix);
    var entry = ir_index::first_entry_with_fact_prefix(index, facts, prefix);
    while entry >= 0 and ir_index::entry_key_starts_with(index, facts, entry, prefix) {
        let line_start = ir_index::entry_line_start(index, entry);
        let key_end = ir_index::entry_key_end(index, entry);
        let line_end = ir_index::entry_line_end(index, entry);
        let function_name = facts[line_start + prefix_len..key_end];
        let root_start = skip_spaces(facts, key_end, line_end);
        if root_start >= line_end {
            return error("type declaration registry: empty reachable type fact");
        }
        let root = facts[root_start..line_end];
        let module_prefix = try compiled_type_resolver::function_owner_module_indexed(
            index, facts, function_name
        );
        if !(try unresolved_function_formal_type(
            index, facts, function_name, root
        )) {
            let unused = try lower_and_declare(
                out, &var registry, index, facts, function_name, module_prefix, root
            );
            if std::mem::len(unused) == 0 {
                return error("type declaration registry: empty lowered reachable type");
            }
        }
        entry = entry + 1;
    }
    try drain_pending_types(out, &var registry, index, facts);
    return;
}

fn seed_existing_declarations(
    registry: &var DeclarationRegistry,
    out: &std::string::String
) -> !void {
    let bytes = out.as_bytes();
    try registry.existing_declarations.append_bytes(bytes);
    return;
}

fn lower_and_declare(
    out: &var std::string::String,
    registry: &var DeclarationRegistry,
    index: &ir_index::IrIndex,
    facts: []u8,
    formal_owner_function: []u8,
    module_prefix: []u8,
    kizu_type: []u8
) -> ![]u8 {
    let normalized = strip_reference_prefixes(kizu_type);
    let normalized_len = std::mem::len(normalized);
    if normalized_len == 0 {
        return error("type declaration registry: empty type");
    }
    if normalized[0] == cast<u8>(33) {
        let payload_type = normalized[1..normalized_len];
        if std::mem::len(payload_type) == 0 {
            return error("type declaration registry: empty error payload");
        }
        let payload_abi = try lower_and_declare(
            out, registry, index, facts, formal_owner_function,
            module_prefix, payload_type
        );
        return try claim_error_union(out, registry, index, facts, payload_abi);
    }

    // Opaque generic constructors still carry reachable value types. Traverse
    // their delimiter-aware arguments before resolving the outer ABI so
    // Channel<Array<Model>> declares Model without constructor-specific code.
    try queue_generic_arguments(
        registry, index, facts, formal_owner_function, module_prefix, normalized
    );

    let resolved = try compiled_type_resolver::resolve_type_indexed(
        index, facts, module_prefix, normalized
    );
    let nominal = try compiled_type_resolver::exact_type_llvm_indexed(
        index, facts, resolved.canonical_identity
    );
    let union_type = try compiled_type_resolver::exact_union_type_indexed(
        index, facts, resolved.canonical_identity
    );
    if nominal.found and union_type.found {
        return error("type declaration registry: conflicting aggregate owner");
    }
    if nominal.found {
        if !std::mem::equal_bytes(nominal.value, resolved.abi) {
            return error("type declaration registry: exact nominal ABI mismatch");
        }
        try visit_nominal(
            out, registry, index, facts, resolved.canonical_identity, resolved.abi
        );
    }
    if union_type.found {
        if !std::mem::equal_bytes(union_type.value, resolved.abi) {
            return error("type declaration registry: exact union ABI mismatch");
        }
        try visit_union(
            out, registry, index, facts, resolved.canonical_identity, resolved.abi
        );
    }
    return resolved.abi;
}

fn queue_generic_arguments(
    registry: &var DeclarationRegistry,
    index: &ir_index::IrIndex,
    facts: []u8,
    formal_owner_function: []u8,
    module_prefix: []u8,
    spelling: []u8
) -> !void {
    let layer = try type_spelling::parse(spelling);
    if layer.kind != type_spelling::layer_named() {
        if layer.kind == type_spelling::layer_borrow() or
            layer.kind == type_spelling::layer_borrow_var() or
            layer.kind == type_spelling::layer_slice() or
            layer.kind == type_spelling::layer_nullable() or
            layer.kind == type_spelling::layer_dynamic() or
            layer.kind == type_spelling::layer_const() {
            try queue_pending_type_if_concrete(
                registry, index, facts, formal_owner_function,
                module_prefix,
                try type_spelling::first_child(&layer, spelling)
            );
        }
        return;
    }
    if !layer.has_arguments {
        return;
    }
    let arguments = try type_spelling::arguments(&layer, spelling);
    var start = 0;
    while start < std::mem::len(arguments) {
        let argument = try type_spelling::next_argument(arguments, start);
        try queue_pending_type_if_concrete(
            registry, index, facts, formal_owner_function,
            module_prefix, argument
        );
        let next = try type_spelling::next_argument_start(arguments, start);
        if next <= start {
            return error("type declaration registry: generic argument cursor did not advance");
        }
        start = next;
    }
    return;
}

fn queue_pending_type_if_concrete(
    registry: &var DeclarationRegistry,
    index: &ir_index::IrIndex,
    facts: []u8,
    formal_owner_function: []u8,
    module_prefix: []u8,
    spelling: []u8
) -> !void {
    if try unresolved_function_formal_type(
        index, facts, formal_owner_function, spelling
    ) {
        return;
    }
    try queue_pending_type(
        registry, formal_owner_function, module_prefix, spelling
    );
    return;
}

// Wrappers around an uninstantiated formal do not have a concrete ABI yet.
// Named generic constructors are intentionally not rejected here: their outer
// abi-repr may be representation-independent, and their arguments are visited
// separately by queue_generic_arguments.
fn unresolved_function_formal_type(
    index: &ir_index::IrIndex,
    facts: []u8,
    function_name: []u8,
    spelling: []u8
) -> !bool {
    if std::mem::len(function_name) == 0 { return false; }
    let normalized = std::mem::trim_ascii(strip_reference_prefixes(spelling));
    if try compiled_type_resolver::is_function_type_parameter_indexed(
        index, facts, function_name, normalized
    ) {
        return true;
    }
    let layer = try type_spelling::parse(normalized);
    if layer.kind == type_spelling::layer_borrow() or
        layer.kind == type_spelling::layer_borrow_var() or
        layer.kind == type_spelling::layer_slice() or
        layer.kind == type_spelling::layer_nullable() or
        layer.kind == type_spelling::layer_dynamic() or
        layer.kind == type_spelling::layer_const() {
        return try unresolved_function_formal_type(
            index, facts, function_name,
            try type_spelling::first_child(&layer, normalized)
        );
    }
    if layer.kind == type_spelling::layer_error_union() {
        let first_child = try type_spelling::first_child(&layer, normalized);
        let second_child = try type_spelling::second_child(&layer, normalized);
        if std::mem::len(first_child) > 0 and
            try unresolved_function_formal_type(
                index, facts, function_name, first_child
            ) {
            return true;
        }
        return try unresolved_function_formal_type(
            index, facts, function_name, second_child
        );
    }
    return false;
}

fn queue_pending_type(
    registry: &var DeclarationRegistry,
    formal_owner_function: []u8,
    module_prefix: []u8,
    spelling: []u8
) -> !void {
    var index = 0;
    while index < registry.pending_types.len() {
        if std::mem::equal_bytes(
            try registry.pending_functions.get(index), formal_owner_function
        ) and std::mem::equal_bytes(try registry.pending_modules.get(index), module_prefix) and
            std::mem::equal_bytes(try registry.pending_types.get(index), spelling) {
            return;
        }
        index = index + 1;
    }
    try registry.pending_functions.append(formal_owner_function);
    try registry.pending_modules.append(module_prefix);
    try registry.pending_types.append(spelling);
    return;
}

fn drain_pending_types(
    out: &var std::string::String,
    registry: &var DeclarationRegistry,
    index: &ir_index::IrIndex,
    facts: []u8
) -> !void {
    var cursor = 0;
    while cursor < registry.pending_types.len() {
        let formal_owner_function = try registry.pending_functions.get(cursor);
        let module_prefix = try registry.pending_modules.get(cursor);
        let pending_type = try registry.pending_types.get(cursor);
        let unused = try lower_and_declare(
            out, registry, index, facts, formal_owner_function,
            module_prefix, pending_type
        );
        if std::mem::len(unused) == 0 {
            return error("type declaration registry: empty pending type ABI");
        }
        cursor = cursor + 1;
    }
    return;
}

fn strip_reference_prefixes(kizu_type: []u8) -> []u8 {
    var result = kizu_type;
    var changed = true;
    while changed {
        changed = false;
        let len = std::mem::len(result);
        if len > 0 and result[0] == cast<u8>(38) {
            result = result[1..len];
            changed = true;
        } else {
            if std::mem::starts_with(result, "var_") {
                result = result[4..len];
                changed = true;
            }
        }
    }
    return result;
}

fn visit_nominal(
    out: &var std::string::String,
    registry: &var DeclarationRegistry,
    index: &ir_index::IrIndex,
    facts: []u8,
    identity: []u8,
    llvm_name: []u8
) -> !void {
    let known = try nominal_state_index(registry, identity);
    if known >= 0 {
        let state = try registry.state_values.get(known);
        if state == 1 {
            return error("type declaration registry: by-value type cycle");
        }
        return;
    }
    try registry.state_identities.append(identity);
    try registry.state_values.append(1);
    let state_index = registry.state_identities.len() - 1;

    // Re-read only the exact nominal fact. Generic ABI precedence must not
    // reinterpret this canonical identity during declaration traversal.
    let nominal = try compiled_type_resolver::exact_type_llvm_indexed(
        index, facts, identity
    );
    if !nominal.found {
        return error("type declaration registry: exact nominal fact missing");
    }
    if !std::mem::equal_bytes(nominal.value, llvm_name) {
        return error("type declaration registry: exact nominal ABI mismatch");
    }

    let field_count = try compiled_fact_lookup::validate_struct_field_owner_indexed(
        index, facts, identity
    );
    let field_prefix = "struct-field ";
    var field_entry = ir_index::first_matching_entry(
        index, facts, field_prefix, "", identity
    );
    let module_prefix = compiled_util::module_prefix_of(identity);

    var body = std::string::String(std::mem::page_allocator());
    defer body.deinit();
    try body.append_bytes("{ ");
    var expected = 0;
    while expected < field_count {
        let field = try compiled_fact_lookup::parse_struct_field_entry(
            index, facts, field_entry
        );
        let field_abi = try lower_and_declare(
            out, registry, index, facts, facts[0..0],
            module_prefix, field.field_type
        );
        if expected > 0 { try body.append_bytes(", "); }
        try body.append_bytes(field_abi);
        expected = expected + 1;
        field_entry = field_entry + 1;
    }
    try body.append_bytes(" }");

    try claim_nominal(registry, llvm_name, identity);
    try reject_nominal_error_name_collision(registry, llvm_name);
    let body_bytes = body.as_bytes();
    if !(try existing_declaration_matches(registry, llvm_name, &body)) {
        try out.append_bytes(llvm_name);
        try out.append_bytes(" = type ");
        try out.append_bytes(body_bytes);
        try out.append_byte(cast<u8>(10));
    }
    try registry.state_values.set(state_index, 2);
    return;
}

fn visit_union(
    out: &var std::string::String,
    registry: &var DeclarationRegistry,
    index: &ir_index::IrIndex,
    facts: []u8,
    identity: []u8,
    llvm_name: []u8
) -> !void {
    let known = try nominal_state_index(registry, identity);
    if known >= 0 {
        let state = try registry.state_values.get(known);
        if state == 1 { return error("type declaration registry: by-value type cycle"); }
        return;
    }
    try registry.state_identities.append(identity);
    try registry.state_values.append(1);
    let state_index = registry.state_identities.len() - 1;

    let union_type = try compiled_type_resolver::exact_union_type_indexed(
        index, facts, identity
    );
    if !union_type.found or !std::mem::equal_bytes(union_type.value, llvm_name) {
        return error("type declaration registry: exact union fact mismatch");
    }
    var variants = try compiled_type_layout::collect_union_variants(
        index, facts, identity
    );
    defer variants.deinit();
    let module_prefix = compiled_util::module_prefix_of(identity);
    var payload_index = 0;
    while payload_index < variants.types.len() {
        let unused = try lower_and_declare(
            out, registry, index, facts, facts[0..0], module_prefix,
            try variants.types.get(payload_index)
        );
        if std::mem::len(unused) == 0 {
            return error("type declaration registry: empty union payload ABI");
        }
        payload_index = payload_index + 1;
    }

    let capacity = try compiled_type_layout::union_payload_capacity(
        index, facts, identity
    );
    var body = std::string::String(std::mem::page_allocator());
    defer body.deinit();
    try body.append_bytes("{ i64, [");
    try std::fmt::append_i64(&var body, capacity);
    try body.append_bytes(" x i8] }");

    try claim_nominal(registry, llvm_name, identity);
    try reject_nominal_error_name_collision(registry, llvm_name);
    if !(try existing_declaration_matches(registry, llvm_name, &body)) {
        try out.append_bytes(llvm_name);
        try out.append_bytes(" = type ");
        let body_bytes = body.as_bytes();
        try out.append_bytes(body_bytes);
        try out.append_byte(cast<u8>(10));
    }
    try registry.state_values.set(state_index, 2);
    return;
}

fn nominal_state_index(
    registry: &DeclarationRegistry,
    identity: []u8
) -> !i64 {
    var cursor = 0;
    while cursor < registry.state_identities.len() {
        let known_identity = try registry.state_identities.get(cursor);
        if std::mem::equal_bytes(known_identity, identity) { return cursor; }
        cursor = cursor + 1;
    }
    return -1;
}

fn claim_nominal(
    registry: &var DeclarationRegistry,
    llvm_name: []u8,
    identity: []u8
) -> !void {
    if fixed_abi_contract::from_llvm(llvm_name).kind !=
        fixed_abi_contract::FixedAbiKind::Missing {
        return error("type declaration registry: reserved fixed ABI name");
    }
    var cursor = 0;
    while cursor < registry.nominal_claim_names.len() {
        let claim_name = try registry.nominal_claim_names.get(cursor);
        if std::mem::equal_bytes(claim_name, llvm_name) {
            let claim_identity = try registry.nominal_claim_identities.get(cursor);
            if std::mem::equal_bytes(claim_identity, identity) { return; }
            return error("type declaration registry: qualified nominal ABI collision");
        }
        cursor = cursor + 1;
    }
    try registry.nominal_claim_identities.append(identity);
    try registry.nominal_claim_names.append(llvm_name);
    return;
}

fn claim_error_union(
    out: &var std::string::String,
    registry: &var DeclarationRegistry,
    index: &ir_index::IrIndex,
    facts: []u8,
    payload_abi: []u8
) -> ![]u8 borrows facts {
    let error_name = try exact_error_union_name(index, facts, payload_abi);
    var existing = 0;
    while existing < registry.error_payloads.len() {
        let known_payload = try registry.error_payloads.get(existing);
        if std::mem::equal_bytes(known_payload, payload_abi) {
            return error_name;
        }
        let known_name = try registry.error_names.get(existing);
        if std::mem::equal_bytes(known_name, error_name) {
            return error("type declaration registry: error union name collision");
        }
        existing = existing + 1;
    }
    var nominal_index = 0;
    while nominal_index < registry.nominal_claim_names.len() {
        let nominal_name = try registry.nominal_claim_names.get(nominal_index);
        if std::mem::equal_bytes(nominal_name, error_name) {
            return error("type declaration registry: nominal/error declaration collision");
        }
        nominal_index = nominal_index + 1;
    }
    var body = std::string::String(std::mem::page_allocator());
    defer body.deinit();
    if std::mem::equal_bytes(payload_abi, "void") {
        try body.append_bytes("{ i1, %kizu.slice.u8 }");
    } else {
        try body.append_bytes("{ i1, ");
        try body.append_bytes(payload_abi);
        try body.append_bytes(", %kizu.slice.u8 }");
    }
    let body_bytes = body.as_bytes();
    if !(try existing_declaration_matches(registry, error_name, &body)) {
        try out.append_bytes(error_name);
        try out.append_bytes(" = type ");
        try out.append_bytes(body_bytes);
        try out.append_byte(cast<u8>(10));
    }
    try registry.error_payloads.append(payload_abi);
    try registry.error_names.append(error_name);
    return error_name;
}

// exact_error_union_name keeps declaration naming in the package facts. The
// producer owns the canonical ABI-to-name mapping; every consumer performs the
// same exact-key lookup and rejects duplicate/conflicting records.
fn exact_error_union_name(
    index: &ir_index::IrIndex,
    facts: []u8,
    payload_abi: []u8
) -> ![]u8 borrows facts {
    return try compiled_error_abi::lookup_indexed(index, facts, payload_abi);
}

fn reject_nominal_error_name_collision(
    registry: &DeclarationRegistry,
    llvm_name: []u8
) -> !void {
    var cursor = 0;
    while cursor < registry.error_names.len() {
        let name_bytes = try registry.error_names.get(cursor);
        if std::mem::equal_bytes(name_bytes, llvm_name) {
            return error("type declaration registry: nominal/error declaration collision");
        }
        cursor = cursor + 1;
    }
    return;
}

fn existing_declaration_matches(
    registry: &DeclarationRegistry,
    name: []u8,
    body_owner: &std::string::String
) -> !bool {
    let existing_owner = &registry.existing_declarations;
    let existing_len = existing_owner.len();
    let marker = " = type ";
    var found = false;
    var line_start = 0;
    var cursor = 0;
    while cursor <= existing_len {
        if cursor == existing_len or string_byte_at(existing_owner, cursor) == cast<u8>(10) {
            let name_end = line_start + std::mem::len(name);
            let body_start = name_end + std::mem::len(marker);
            if body_start <= cursor and
                string_range_equal_bytes(existing_owner, line_start, name_end, name) and
                string_range_equal_bytes(existing_owner, name_end, body_start, marker) {
                if found {
                    return error("type declaration registry: duplicate existing declaration");
                }
                if !string_range_equal_string(existing_owner, body_start, cursor, body_owner) {
                    return error("type declaration registry: existing declaration body conflict");
                }
                found = true;
            }
            line_start = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return found;
}

fn string_range_equal_bytes(
    value: &std::string::String,
    start: i64,
    end: i64,
    bytes: []u8
) -> bool {
    if end - start != std::mem::len(bytes) { return false; }
    var cursor = 0;
    while cursor < std::mem::len(bytes) {
        if string_byte_at(value, start + cursor) != bytes[cursor] { return false; }
        cursor = cursor + 1;
    }
    return true;
}

fn string_range_equal_string(
    left: &std::string::String,
    start: i64,
    end: i64,
    right: &std::string::String
) -> bool {
    if end - start != right.len() { return false; }
    var cursor = 0;
    while cursor < right.len() {
        if string_byte_at(left, start + cursor) != string_byte_at(right, cursor) {
            return false;
        }
        cursor = cursor + 1;
    }
    return true;
}

fn string_byte_at(value: &std::string::String, index: i64) -> u8 {
    let bytes = value.as_bytes();
    return bytes[index];
}

fn skip_spaces(bytes: []u8, start: i64, end: i64) -> i64 {
    var cursor = start;
    while cursor < end and bytes[cursor] == cast<u8>(32) {
        cursor = cursor + 1;
    }
    return cursor;
}
