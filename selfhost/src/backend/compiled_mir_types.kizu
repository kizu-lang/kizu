import selfhost::backend::compiled_fact_lookup;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_type_lower;
import selfhost::backend::compiled_util;
import selfhost::backend::ir_contract;
import selfhost::backend::ir_index;

pub struct FieldAccessInfo {
    pub receiver_kizu_type: []u8,
    pub receiver_llvm_type: []u8,
    pub field_index: i64,
    pub field_kizu_type: []u8,
    pub field_llvm_type: []u8,
}

pub struct LoweredCallInfo {
    pub return_llvm_type: []u8,
    pub module_prefix: []u8,
    pub callee_name: []u8,
}

pub struct CallArgTypeCache {
    pub module_prefixes: std::array::Array<[]u8>,
    pub callee_names: std::array::Array<[]u8>,
    pub arg_counts: std::array::Array<i64>,
    pub type_starts: std::array::Array<i64>,
    pub types: std::array::Array<[]u8>,
    // node_line_starts is the per-function body-node position index (pillar A): node_line_starts[seq]
    // is the byte offset of this function's 'body-node <fn> <seq>' line in ir_bytes, built once at
    // lowering start by build_fn_node_index. fn_node_line_start reads it in O(1) instead of the
    // global index binary search. Empty (len 0) until built, in which case lookups fall back to bs.
    pub node_line_starts: std::array::Array<i64>,
    pub node_kinds: std::array::Array<[]u8>,
    pub edge_parents: std::array::Array<i64>,
    pub edge_names: std::array::Array<[]u8>,
    pub edge_ordinals: std::array::Array<i64>,
    pub edge_children: std::array::Array<i64>,
    pub edges_built: bool,
    // local_names / local_types is the per-function local-binding type cache (pillar B): local_types[i]
    // is the resolved kizu type of the let-bound local local_names[i]. resolve_local_kizu_type is a
    // deterministic function of (function, name) (it scans block 0 direct-first then nested, the
    // same order regardless of where the read sits), so memoizing it by name within this
    // per-function cache returns the byte-identical type while collapsing the repeated O(function)
    // body scans for a local referenced many times. Both slices borrow ir_bytes, which outlives the
    // cache.
    pub local_names: std::array::Array<[]u8>,
    pub local_types: std::array::Array<[]u8>,
    // scoped_local_names and scoped_local_types form a stack of temporary lexical bindings
    // supplied by a
    // lowering construct whose bindings are not let statements. Match-arm
    // payloads are the first consumer. Reverse lookup preserves shadowing.
    pub scoped_local_names: std::array::Array<[]u8>,
    pub scoped_local_types: std::array::Array<[]u8>,
    pub local_binding_names: std::array::Array<[]u8>,
    pub local_binding_statements: std::array::Array<i64>,
    pub local_bindings_built: bool,
    pub field_expr_nodes: std::array::Array<i64>,
    pub field_receiver_kizu_types: std::array::Array<[]u8>,
    pub field_receiver_llvm_types: std::array::Array<[]u8>,
    pub field_indexes: std::array::Array<i64>,
    pub field_kizu_types: std::array::Array<[]u8>,
    pub field_llvm_types: std::array::Array<[]u8>,
    pub llvm_module_prefixes: std::array::Array<[]u8>,
    pub llvm_kizu_types: std::array::Array<[]u8>,
    pub llvm_types: std::array::Array<[]u8>,
    pub struct_field_module_prefixes: std::array::Array<[]u8>,
    pub struct_field_types: std::array::Array<[]u8>,
    pub struct_field_names: std::array::Array<[]u8>,
    pub struct_field_indexes: std::array::Array<i64>,
    pub struct_field_kizu_types: std::array::Array<[]u8>,
    pub lookups: i64,
    pub hits: i64,
}

pub fn call_arg_type_cache() -> CallArgTypeCache {
    return CallArgTypeCache {
        module_prefixes: std::array::Array<[]u8>(std::mem::page_allocator()),
        callee_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        arg_counts: std::array::Array<i64>(std::mem::page_allocator()),
        type_starts: std::array::Array<i64>(std::mem::page_allocator()),
        types: std::array::Array<[]u8>(std::mem::page_allocator()),
        node_line_starts: std::array::Array<i64>(std::mem::page_allocator()),
        node_kinds: std::array::Array<[]u8>(std::mem::page_allocator()),
        edge_parents: std::array::Array<i64>(std::mem::page_allocator()),
        edge_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        edge_ordinals: std::array::Array<i64>(std::mem::page_allocator()),
        edge_children: std::array::Array<i64>(std::mem::page_allocator()),
        edges_built: false,
        local_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        scoped_local_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        scoped_local_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_binding_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_binding_statements: std::array::Array<i64>(std::mem::page_allocator()),
        local_bindings_built: false,
        field_expr_nodes: std::array::Array<i64>(std::mem::page_allocator()),
        field_receiver_kizu_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_receiver_llvm_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_indexes: std::array::Array<i64>(std::mem::page_allocator()),
        field_kizu_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_llvm_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        llvm_module_prefixes: std::array::Array<[]u8>(std::mem::page_allocator()),
        llvm_kizu_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        llvm_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        struct_field_module_prefixes: std::array::Array<[]u8>(std::mem::page_allocator()),
        struct_field_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        struct_field_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        struct_field_indexes: std::array::Array<i64>(std::mem::page_allocator()),
        struct_field_kizu_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        lookups: 0,
        hits: 0
    };
}

impl CallArgTypeCache {
    fn deinit(self: CallArgTypeCache) -> void {
        self.struct_field_kizu_types.deinit();
        self.struct_field_indexes.deinit();
        self.struct_field_names.deinit();
        self.struct_field_types.deinit();
        self.struct_field_module_prefixes.deinit();
        self.llvm_types.deinit();
        self.llvm_kizu_types.deinit();
        self.llvm_module_prefixes.deinit();
        self.field_llvm_types.deinit();
        self.field_kizu_types.deinit();
        self.field_indexes.deinit();
        self.field_receiver_llvm_types.deinit();
        self.field_receiver_kizu_types.deinit();
        self.field_expr_nodes.deinit();
        self.local_types.deinit();
        self.local_names.deinit();
        self.scoped_local_types.deinit();
        self.scoped_local_names.deinit();
        self.local_binding_statements.deinit();
        self.local_binding_names.deinit();
        self.edge_children.deinit();
        self.edge_ordinals.deinit();
        self.edge_names.deinit();
        self.edge_parents.deinit();
        self.node_kinds.deinit();
        self.node_line_starts.deinit();
        self.types.deinit();
        self.type_starts.deinit();
        self.arg_counts.deinit();
        self.callee_names.deinit();
        self.module_prefixes.deinit();
    }
}

pub fn push_scoped_local_type(
    cache: &var CallArgTypeCache,
    name: []u8,
    kizu_type: []u8
) -> !void {
    try cache.scoped_local_names.append(name);
    try cache.scoped_local_types.append(kizu_type);
    return;
}

pub fn pop_scoped_local_type(cache: &var CallArgTypeCache) -> !void {
    let _name = try cache.scoped_local_names.pop();
    let _kizu_type = try cache.scoped_local_types.pop();
    return;
}

fn scoped_local_type_or_empty(
    cache: &CallArgTypeCache,
    name: []u8
) -> []u8 {
    var index = cache.scoped_local_names.len();
    while index > 0 {
        index = index - 1;
        if std::mem::equal_bytes(cache.scoped_local_names.get_or_panic(index), name) {
            return cache.scoped_local_types.get_or_panic(index);
        }
    }
    return name[0..0];
}

// resolve_local_kizu_type_cached memoizes resolve_local_kizu_type by name in the per-function cache
// (pillar B). The result is a deterministic function of (function, name), so a cache hit returns the
// byte-identical type a fresh scan would; a miss does the one full body scan and records it. This
// turns O(references * function) local-type resolution into O(unique locals * function + references
// * unique locals).
pub fn resolve_local_kizu_type_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    var i = 0;
    while i < cache.local_names.len() {
        if std::mem::equal_bytes(cache.local_names.get_or_panic(i), name) {
            return cache.local_types.get_or_panic(i);
        }
        i = i + 1;
    }
    try ensure_local_binding_index(cache, ir_bytes, function_name, bs);
    var binding_index = 0;
    while binding_index < cache.local_binding_names.len() {
        if std::mem::equal_bytes(cache.local_binding_names.get_or_panic(binding_index), name) {
            let statement = cache.local_binding_statements.get_or_panic(binding_index);
            let found = try resolve_let_value_kizu_type_cached(
                index, cache, ir_bytes, function_name, module_prefix, statement, bs
            );
            try cache.local_names.append(name);
            try cache.local_types.append(found);
            return found;
        }
        binding_index = binding_index + 1;
    }
    return local_type_not_found(name);
}

fn ensure_local_binding_index(
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !void {
    if cache.local_bindings_built {
        return;
    }
    try collect_local_bindings_in_block(cache, ir_bytes, function_name, 0, bs);
    cache.local_bindings_built = true;
    return;
}

fn collect_local_bindings_in_block(
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !void {
    try collect_direct_local_bindings(cache, ir_bytes, function_name, block_node, bs);
    var scan_from = fn_node_line_start(cache, block_node, bs);
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, scan_from
        );
        if statement < 0 {
            return;
        }
        let sf = fn_node_line_start(cache, statement, bs);
        scan_from = sf;
        let stmt_kind = try fn_node_kind(cache, ir_bytes, function_name, statement, sf);
        if std::mem::equal_bytes(stmt_kind, "While") {
            let body_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "body", 0, sf
            );
            try collect_local_bindings_in_block(cache, ir_bytes, function_name, body_node, bs);
        }
        if std::mem::equal_bytes(stmt_kind, "If") {
            let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "then", 0, sf
            );
            if then_node >= 0 {
                try collect_local_bindings_in_block(cache, ir_bytes, function_name, then_node, bs);
            }
            let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "else", 0, sf
            );
            if else_node >= 0 {
                try collect_local_bindings_in_block(cache, ir_bytes, function_name, else_node, bs);
            }
        }
        stmt_index = stmt_index + 1;
    }
    return;
}

fn collect_direct_local_bindings(
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !void {
    var scan_from = fn_node_line_start(cache, block_node, bs);
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, scan_from
        );
        if statement < 0 {
            return;
        }
        let sf = fn_node_line_start(cache, statement, bs);
        scan_from = sf;
        let stmt_kind = try fn_node_kind(cache, ir_bytes, function_name, statement, sf);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, sf
            );
            let local_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, sf
            );
            try cache.local_binding_names.append(local_name);
            try cache.local_binding_statements.append(statement);
        }
        stmt_index = stmt_index + 1;
    }
    return;
}

// build_fn_node_index populates cache.node_line_starts with the current function's body-node line
// offsets (pillar A). It is called once at function lowering start; every per-node structural lookup
// during that function's lowering then resolves its node->line offset through fn_node_line_start
// (O(1)) instead of the global index binary search (O(log total) with a full function-name compare
// per step). Byte-identical: the collected offsets equal body_node_line_start_for_sequence's.
pub fn build_fn_node_index(
    cache: &var CallArgTypeCache,
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let from = ir_index::body_node_facts_start(index, ir_bytes, function_name);
    try ir_contract::collect_body_node_line_starts(
        ir_bytes, function_name, from, &var cache.node_line_starts
    );
    var sequence = 0;
    while sequence < cache.node_line_starts.len() {
        let line_start = cache.node_line_starts.get_or_panic(sequence);
        if line_start < 0 {
            try cache.node_kinds.append(ir_bytes[0..0]);
        } else {
            try cache.node_kinds.append(
                try ir_contract::body_node_kind_from(ir_bytes, function_name, sequence, line_start)
            );
        }
        sequence = sequence + 1;
    }
    try build_fn_edge_index(cache, index, ir_bytes, function_name);
    return;
}

fn build_fn_edge_index(
    cache: &var CallArgTypeCache,
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let prefix = "body-edge ";
    var entry = ir_index::first_matching_entry(
        index, ir_bytes, prefix, ir_bytes[0..0], function_name
    );
    while entry >= 0 and
        ir_index::entry_matches_query(index, ir_bytes, entry, prefix, ir_bytes[0..0], function_name) {
        let name_end = ir_index::entry_key_end(index, entry);
        let parent_start = cache_skip_spaces(ir_bytes, name_end);
        let parent = try cache_parse_i64_token(ir_bytes, parent_start);
        let parent_end = cache_token_end(ir_bytes, parent_start);
        let edge_start = cache_skip_spaces(ir_bytes, parent_end);
        let edge_end = cache_token_end(ir_bytes, edge_start);
        let ordinal_start = cache_skip_spaces(ir_bytes, edge_end);
        let ordinal = try cache_parse_i64_token(ir_bytes, ordinal_start);
        let ordinal_end = cache_token_end(ir_bytes, ordinal_start);
        let child_start = cache_skip_spaces(ir_bytes, ordinal_end);
        let child = try cache_parse_i64_token(ir_bytes, child_start);
        try cache.edge_parents.append(parent);
        try cache.edge_names.append(ir_bytes[edge_start..edge_end]);
        try cache.edge_ordinals.append(ordinal);
        try cache.edge_children.append(child);
        entry = entry + 1;
    }
    cache.edges_built = true;
    return;
}

pub fn fn_body_child_sequence_from(
    cache: &CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64,
    from: i64
) -> !i64 {
    let child = try fn_body_child_sequence_or_minus_one_from(
        cache, ir_bytes, function_name, parent_sequence, edge, ordinal, from
    );
    if child >= 0 {
        return child;
    }
    return error("missing IR artifact fact");
}

pub fn fn_body_child_sequence_or_minus_one_from(
    cache: &CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64,
    from: i64
) -> !i64 {
    if !cache.edges_built {
        return try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, parent_sequence, edge, ordinal, from
        );
    }
    var index = 0;
    let end = cache.edge_children.len();
    while index < end {
        if cache.edge_parents.get_or_panic(index) == parent_sequence and
            cache.edge_ordinals.get_or_panic(index) == ordinal and
            std::mem::equal_bytes(cache.edge_names.get_or_panic(index), edge) {
            return cache.edge_children.get_or_panic(index);
        }
        index = index + 1;
    }
    return -1;
}

pub fn fn_body_edge_count_from(
    cache: &CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    from: i64
) -> !i64 {
    if !cache.edges_built {
        return try ir_contract::body_edge_count_from(
            ir_bytes, function_name, parent_sequence, edge, from
        );
    }
    var count = 0;
    var index = 0;
    let end = cache.edge_children.len();
    while index < end {
        if cache.edge_parents.get_or_panic(index) == parent_sequence and
            std::mem::equal_bytes(cache.edge_names.get_or_panic(index), edge) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn cache_skip_spaces(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len and cache_is_space(bytes[index]) {
        index = index + 1;
    }
    return index;
}

fn cache_token_end(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len and !cache_is_space(bytes[index]) {
        index = index + 1;
    }
    return index;
}

fn cache_parse_i64_token(bytes: []u8, start: i64) -> !i64 {
    let byte_len = std::mem::len(bytes);
    if start >= byte_len {
        return error("invalid IR artifact fact");
    }
    var value = 0;
    var index = start;
    var found = false;
    while index < byte_len {
        let byte = bytes[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            break;
        }
        value = (value * 10) + cast<i64>(byte - cast<u8>(48));
        found = true;
        index = index + 1;
    }
    if !found {
        return error("invalid IR artifact fact");
    }
    if index < byte_len and !cache_is_space(bytes[index]) {
        return error("invalid IR artifact fact");
    }
    return value;
}

fn cache_is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(10) or byte == cast<u8>(13) or byte == cast<u8>(9);
}

// fn_node_line_start returns the current function's 'body-node <fn> <sequence>' line offset from
// the per-function index in O(1), or fallback (the function body start bs) when the index is not
// built or has no entry for sequence -- the same fallback body_node_line_start_for_sequence uses,
// so a downstream scan started here reads the byte-identical facts.
pub fn fn_node_line_start(cache: &CallArgTypeCache, sequence: i64, fallback: i64) -> i64 {
    if sequence < 0 or sequence >= cache.node_line_starts.len() {
        return fallback;
    }
    let offset = cache.node_line_starts.get_or_panic(sequence);
    if offset < 0 {
        return fallback;
    }
    return offset;
}

pub fn fn_node_kind(
    cache: &CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    fallback: i64
) -> ![]u8 {
    if sequence >= 0 and sequence < cache.node_kinds.len() {
        let kind = cache.node_kinds.get_or_panic(sequence);
        if std::mem::len(kind) > 0 {
            return kind;
        }
    }
    return try ir_contract::body_node_kind_from(ir_bytes, function_name, sequence, fallback);
}

pub fn kizu_type_to_llvm_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    kizu_type: []u8,
    cache: &var CallArgTypeCache
) -> ![]u8 {
    var cached_index = 0;
    while cached_index < cache.llvm_kizu_types.len() {
        if std::mem::equal_bytes(cache.llvm_module_prefixes.get_or_panic(cached_index), module_prefix) and
            std::mem::equal_bytes(cache.llvm_kizu_types.get_or_panic(cached_index), kizu_type) {
            return cache.llvm_types.get_or_panic(cached_index);
        }
        cached_index = cached_index + 1;
    }
    let llvm_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        index, ir_bytes, module_prefix, kizu_type
    );
    try cache.llvm_module_prefixes.append(module_prefix);
    try cache.llvm_kizu_types.append(kizu_type);
    try cache.llvm_types.append(llvm_type);
    return llvm_type;
}

pub fn lookup_struct_field_by_prefix_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    short_type: []u8,
    field_name: []u8,
    cache: &var CallArgTypeCache
) -> !compiled_fact_lookup::StructFieldLookup {
    var cached_index = 0;
    while cached_index < cache.struct_field_types.len() {
        if std::mem::equal_bytes(
            cache.struct_field_module_prefixes.get_or_panic(cached_index), module_prefix
        ) and
            std::mem::equal_bytes(cache.struct_field_types.get_or_panic(cached_index), short_type) and
            std::mem::equal_bytes(cache.struct_field_names.get_or_panic(cached_index), field_name) {
            return compiled_fact_lookup::StructFieldLookup {
                found: true,
                index: cache.struct_field_indexes.get_or_panic(cached_index),
                field_type: cache.struct_field_kizu_types.get_or_panic(cached_index)
            };
        }
        cached_index = cached_index + 1;
    }
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        index, ir_bytes, module_prefix, short_type, field_name
    );
    if field.found {
        try cache.struct_field_module_prefixes.append(module_prefix);
        try cache.struct_field_types.append(short_type);
        try cache.struct_field_names.append(field_name);
        try cache.struct_field_indexes.append(field.index);
        try cache.struct_field_kizu_types.append(field.field_type);
    }
    return field;
}

pub fn resolve_value_llvm_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return param_type;
    }
    let kizu_type = try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
    return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, kizu_type);
}

pub fn resolve_value_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return try find_function_param_kizu_type(ir_bytes, function_name, name);
    }
    // Callers without a threaded params_spec (struct-field reads in call-argument
    // position) still resolve parameters from the signature facts before falling
    // back to the let-binding scan.
    let fact_param = try find_function_param_kizu_type_or_empty(ir_bytes, function_name, name);
    if std::mem::len(fact_param) > 0 {
        return fact_param;
    }
    return try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
}

// resolve_value_llvm_type_indexed mirrors resolve_value_llvm_type but routes the type-llvm
// lowering through the sorted index. The params_spec and local (resolve_local_kizu_type)
// lookups are unchanged: the former scans the small caller-threaded spec string and the
// latter scans only the current function's body block, neither of which the index covers;
// only kizu_type_to_llvm's whole-IR type/enum scan becomes a binary search.
pub fn resolve_value_llvm_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return param_type;
    }
    let kizu_type = try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
    return try compiled_type_lower::kizu_type_to_llvm_indexed(index, ir_bytes, module_prefix, kizu_type);
}

// resolve_value_llvm_type_indexed_cached is resolve_value_llvm_type_indexed with the local-type
// resolution routed through the per-function cache (pillar B). Hot callers that thread a cache use this
// to collapse a local's repeated O(function) body scans; the result is byte-identical.
pub fn resolve_value_llvm_type_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64,
    cache: &var CallArgTypeCache
) -> ![]u8 {
    let scoped_type = scoped_local_type_or_empty(cache, name);
    if std::mem::len(scoped_type) > 0 {
        return try compiled_type_lower::kizu_type_to_llvm_indexed(
            index, ir_bytes, module_prefix, scoped_type
        );
    }
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return param_type;
    }
    let kizu_type = try resolve_local_kizu_type_cached(
        index, cache, ir_bytes, function_name, module_prefix, name, bs
    );
    return try kizu_type_to_llvm_indexed_cached(index, ir_bytes, module_prefix, kizu_type, cache);
}

pub fn resolve_value_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return try find_function_param_kizu_type_indexed(index, ir_bytes, function_name, name);
    }
    let fact_param = try find_function_param_kizu_type_or_empty_indexed(
        index, ir_bytes, function_name, name
    );
    if std::mem::len(fact_param) > 0 {
        return fact_param;
    }
    return try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
}

// resolve_value_kizu_type_indexed_cached mirrors resolve_value_kizu_type_indexed with the
// local-type resolution routed through the per-function cache (pillar B); byte-identical.
pub fn resolve_value_kizu_type_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64,
    cache: &var CallArgTypeCache
) -> ![]u8 {
    let scoped_type = scoped_local_type_or_empty(cache, name);
    if std::mem::len(scoped_type) > 0 {
        return scoped_type;
    }
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return try find_function_param_kizu_type_indexed(index, ir_bytes, function_name, name);
    }
    let fact_param = try find_function_param_kizu_type_or_empty_indexed(
        index, ir_bytes, function_name, name
    );
    if std::mem::len(fact_param) > 0 {
        return fact_param;
    }
    return try resolve_local_kizu_type_cached(
        index, cache, ir_bytes, function_name, module_prefix, name, bs
    );
}

pub fn struct_lookup_kizu_type(kizu_type: []u8) -> []u8 {
    let len = std::mem::len(kizu_type);
    if len > 0 and kizu_type[0] == cast<u8>(33) {
        return struct_lookup_kizu_type(kizu_type[1..len]);
    }
    if len > 0 and kizu_type[0] == cast<u8>(38) {
        return struct_lookup_kizu_type(kizu_type[1..len]);
    }
    // A '&var <T>' mutable borrow records its keyword as a 'var_' prefix once the
    // leading '&' is stripped; a mutable borrow shares its pointee's lookup type.
    if std::mem::starts_with(kizu_type, "var_") {
        return struct_lookup_kizu_type(kizu_type[4..len]);
    }
    return kizu_type;
}

pub fn count_call_args(ir_bytes: []u8, function_name: []u8, call_node: i64, bs: i64) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, call_node, "arg", count, bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

pub fn count_call_args_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    cache: &CallArgTypeCache
) -> !i64 {
    return try fn_body_edge_count_from(cache, ir_bytes, function_name, call_node, "arg", bs);
}

// cross_module_callee_qualified_name_or_empty resolves an alias-qualified cross-module
// callee to its fully-qualified Kizu name by matching the real signature facts the
// compiled closures emit, so its signature resolves with an empty module prefix (issue
// 1165 / 1162). A call written through an import alias carries an embedded '::' but is not
// a std:: stdlib call; lookup_qualified_function_name_by_callee_suffix then finds the
// emitted function whose name ends with '::' + callee_name -- lexer::is_eof resolves to
// selfhost::lexer::is_eof and lexer::tokenize resolves to std::kizu::lexer::tokenize, each
// to whichever module actually carries it. Same-module calls (bare names, no '::') and
// stdlib calls return "" so they keep their normal resolution path; nothing is admitted by
// a handwritten alias table.
pub fn cross_module_callee_qualified_name_or_empty(
    ir_bytes: []u8,
    callee_name: []u8
) -> []u8 {
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        // A 'std::kizu::*' callee that carries its own function-signature-return fact
        // is a compiled std component function (e.g. the std::kizu::ast BinaryOp
        // accessors), not a runtime intrinsic: resolve it as a fully-qualified
        // cross-module callee so its return type and symbol come from the real
        // signature facts rather than the stdlib-symbol table.
        if std::mem::starts_with(callee_name, "std::kizu::") {
            let ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
                ir_bytes, "function-signature-return ", ir_bytes[0..0], callee_name
            );
            if std::mem::len(ret_kizu) > 0 {
                return callee_name;
            }
        }
        return ir_bytes[0..0];
    }
    let colon = compiled_util::find_byte(callee_name, cast<u8>(58), 0);
    if colon >= std::mem::len(callee_name) {
        return ir_bytes[0..0];
    }
    return compiled_fact_lookup::lookup_qualified_function_name_by_callee_suffix(
        ir_bytes, callee_name
    );
}

// cross_module_callee_qualified_name_or_empty_indexed mirrors the non-indexed resolver but routes
// the 'std::kizu::*' signature-return probe and suffix lookup through the sorted index.
pub fn cross_module_callee_qualified_name_or_empty_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    callee_name: []u8
) -> []u8 {
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        if std::mem::starts_with(callee_name, "std::kizu::") {
            let ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
                index, ir_bytes, "function-signature-return ", ir_bytes[0..0], callee_name
            );
            if std::mem::len(ret_kizu) > 0 {
                return callee_name;
            }
        }
        return ir_bytes[0..0];
    }
    let colon = compiled_util::find_byte(callee_name, cast<u8>(58), 0);
    if colon >= std::mem::len(callee_name) {
        return ir_bytes[0..0];
    }
    return compiled_fact_lookup::lookup_qualified_function_name_by_callee_suffix_indexed(
        index, ir_bytes, callee_name
    );
}

pub fn lower_call_return_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        let ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
            ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
        );
        if std::mem::len(ret_kizu) == 0 {
            return error("compiled mir: cross-module callee return type not found");
        }
        // The signature fact spells the return type the way the callee's own module
        // wrote it (e.g. the bare 'BinaryOp' inside std::kizu::ast), so lower it
        // against the callee's module prefix rather than the caller's.
        return try compiled_type_lower::kizu_type_to_llvm(
            ir_bytes, compiled_util::module_prefix_of(qualified), ret_kizu
        );
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        let stdlib_ret = try compiled_fact_lookup::lookup_stdlib_return(
            ir_bytes, callee_name
        );
        return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, stdlib_ret);
    }
    let array_get_element = try resolve_value_array_get_element_or_empty(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    if std::mem::len(array_get_element) > 0 {
        return try array_get_error_union_llvm_type(ir_bytes, module_prefix, array_get_element);
    }
    return try compiled_signature::resolve_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
}

// lower_call_return_type_indexed mirrors lower_call_return_type, routing its signature/type
// probes through the sorted index. The cross-module suffix lookup still falls back to the
// linear resolver only for non-stdlib alias-qualified callees; std::kizu::* signature probes
// are index-backed.
pub fn lower_call_return_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    // cf tightens the structural callee read (the call's own 'body-call' detail) to the call
    // node's body-node line via the index; the detail fact sorts immediately after that line, so
    // a scan from cf reaches the byte-identical callee a scan from bs would. The return-type
    // resolution below is index-keyed (callee name + module), so it is unaffected by cf.
    let cf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, call_node, bs
    );
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let qualified = cross_module_callee_qualified_name_or_empty_indexed(
        index, ir_bytes, callee_name
    );
    if std::mem::len(qualified) > 0 {
        let ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
            index, ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
        );
        if std::mem::len(ret_kizu) == 0 {
            return error("compiled mir: cross-module callee return type not found");
        }
        return try compiled_type_lower::kizu_type_to_llvm_indexed(
            index, ir_bytes, compiled_util::module_prefix_of(qualified), ret_kizu
        );
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        let stdlib_ret = try compiled_fact_lookup::lookup_stdlib_return_indexed(
            index, ir_bytes, callee_name
        );
        return try compiled_type_lower::kizu_type_to_llvm_indexed(
            index, ir_bytes, module_prefix, stdlib_ret
        );
    }
    let array_get_element = try resolve_value_array_get_element_or_empty(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    if std::mem::len(array_get_element) > 0 {
        return try array_get_error_union_llvm_type_indexed(
            index, ir_bytes, module_prefix, array_get_element
        );
    }
    return try compiled_signature::resolve_call_return_type_indexed(
        index, ir_bytes, function_name, module_prefix, call_node, bs
    );
}

pub fn lower_call_info_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64,
    cache: &var CallArgTypeCache
) -> !LoweredCallInfo {
    let cf = fn_node_line_start(cache, call_node, bs);
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let qualified = cross_module_callee_qualified_name_or_empty_indexed(
        index, ir_bytes, callee_name
    );
    if std::mem::len(qualified) > 0 {
        let ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
            index, ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
        );
        if std::mem::len(ret_kizu) == 0 {
            return error("compiled mir: cross-module callee return type not found");
        }
        let callee_module_prefix = compiled_util::module_prefix_of(qualified);
        let return_llvm = try kizu_type_to_llvm_indexed_cached(
            index, ir_bytes, callee_module_prefix, ret_kizu, cache
        );
        return LoweredCallInfo {
            return_llvm_type: return_llvm,
            module_prefix: callee_module_prefix,
            callee_name: qualified[std::mem::len(callee_module_prefix)..std::mem::len(qualified)]
        };
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        let stdlib_ret = try compiled_fact_lookup::lookup_stdlib_return_indexed(
            index, ir_bytes, callee_name
        );
        let return_llvm = try kizu_type_to_llvm_indexed_cached(
            index, ir_bytes, module_prefix, stdlib_ret, cache
        );
        let symbol = try compiled_fact_lookup::lookup_stdlib_symbol_indexed(
            index, ir_bytes, callee_name
        );
        return LoweredCallInfo {
            return_llvm_type: return_llvm,
            module_prefix: ir_bytes[0..0],
            callee_name: symbol
        };
    }
    let local_ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        index, ir_bytes, "function-signature-return ", module_prefix, callee_name
    );
    if std::mem::len(local_ret_kizu) > 0 {
        let local_return_llvm = try kizu_type_to_llvm_indexed_cached(
            index, ir_bytes, module_prefix, local_ret_kizu, cache
        );
        return LoweredCallInfo {
            return_llvm_type: local_return_llvm,
            module_prefix: module_prefix,
            callee_name: callee_name
        };
    }
    let ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        index, ir_bytes, "function-signature-return ", ir_bytes[0..0], callee_name
    );
    if std::mem::len(ret_kizu) == 0 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled signature: call return type not found: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" -> ");
        try message.append_bytes(callee_name);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let return_llvm = try kizu_type_to_llvm_indexed_cached(
        index, ir_bytes, module_prefix, ret_kizu, cache
    );
    return LoweredCallInfo {
        return_llvm_type: return_llvm,
        module_prefix: module_prefix,
        callee_name: callee_name
    };
}

fn resolve_try_call_success_kizu_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8
) -> ![]u8 {
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    var lookup_prefix = module_prefix;
    var lookup_name = callee_name;
    if std::mem::len(qualified) > 0 {
        lookup_prefix = ir_bytes[0..0];
        lookup_name = qualified;
    }
    var ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
        ir_bytes, "function-signature-return ", lookup_prefix, lookup_name
    );
    if std::mem::len(ret_kizu) == 0 and compiled_fact_lookup::is_stdlib_callee(callee_name) {
        ret_kizu = try compiled_fact_lookup::lookup_stdlib_return(ir_bytes, callee_name);
    }
    if std::mem::len(ret_kizu) == 0 {
        return error("compiled mir: local try-call return type not found");
    }
    if ret_kizu[0] != cast<u8>(33) {
        return error("compiled mir: local try-call callee must return an error union");
    }
    return ret_kizu[1..std::mem::len(ret_kizu)];
}

fn resolve_try_call_success_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8
) -> ![]u8 {
    let qualified = cross_module_callee_qualified_name_or_empty_indexed(index, ir_bytes, callee_name);
    var lookup_prefix = module_prefix;
    var lookup_name = callee_name;
    if std::mem::len(qualified) > 0 {
        lookup_prefix = ir_bytes[0..0];
        lookup_name = qualified;
    }
    var ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        index, ir_bytes, "function-signature-return ", lookup_prefix, lookup_name
    );
    if std::mem::len(ret_kizu) == 0 and compiled_fact_lookup::is_stdlib_callee(callee_name) {
        ret_kizu = try compiled_fact_lookup::lookup_stdlib_return_indexed(
            index, ir_bytes, callee_name
        );
    }
    if std::mem::len(ret_kizu) == 0 {
        return error("compiled mir: local try-call return type not found");
    }
    if ret_kizu[0] != cast<u8>(33) {
        return error("compiled mir: local try-call callee must return an error union");
    }
    return ret_kizu[1..std::mem::len(ret_kizu)];
}

pub fn lower_call_module_prefix(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    // A resolved cross-module callee carries its own fully-qualified module path, so the
    // renderer mangles it from that module prefix (append_callee_symbol ->
    // derive_callee_llvm_symbol handles both selfhost:: and std::kizu:: owners) rather
    // than the caller's module prefix.
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        return compiled_util::module_prefix_of(qualified);
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return ir_bytes[0..0];
    }
    return module_prefix;
}

pub fn lower_call_module_prefix_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let cf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, call_node, bs
    );
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let qualified = cross_module_callee_qualified_name_or_empty_indexed(
        index, ir_bytes, callee_name
    );
    if std::mem::len(qualified) > 0 {
        return compiled_util::module_prefix_of(qualified);
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return ir_bytes[0..0];
    }
    return module_prefix;
}

pub fn lower_call_callee_name(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    // Pair the resolved cross-module module prefix (above) with the callee's short name so
    // the renderer mangles the same fully-qualified symbol the owning closure emits.
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        let qualified_prefix = compiled_util::module_prefix_of(qualified);
        return qualified[std::mem::len(qualified_prefix)..std::mem::len(qualified)];
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return try compiled_fact_lookup::lookup_stdlib_symbol(ir_bytes, callee_name);
    }
    return callee_name;
}

pub fn lower_call_callee_name_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let cf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, call_node, bs
    );
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let qualified = cross_module_callee_qualified_name_or_empty_indexed(
        index, ir_bytes, callee_name
    );
    if std::mem::len(qualified) > 0 {
        let qualified_prefix = compiled_util::module_prefix_of(qualified);
        return qualified[std::mem::len(qualified_prefix)..std::mem::len(qualified)];
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return try compiled_fact_lookup::lookup_stdlib_symbol_indexed(index, ir_bytes, callee_name);
    }
    return callee_name;
}

pub fn lower_call_arg_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_index: i64
) -> ![]u8 {
    var arg_types = try lower_call_arg_types(ir_bytes, module_prefix, callee_name, arg_index + 1);
    defer arg_types.deinit();
    return try arg_types.get(arg_index);
}

pub fn lower_call_arg_types(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        return try lower_signature_call_arg_types(
            ir_bytes, ir_bytes[0..0], qualified, ir_bytes[0..0], arg_count
        );
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return try lower_stdlib_call_arg_types(ir_bytes, callee_name, arg_count);
    }
    return try lower_signature_call_arg_types(
        ir_bytes, module_prefix, callee_name, module_prefix, arg_count
    );
}

pub fn lower_call_arg_types_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    let qualified = cross_module_callee_qualified_name_or_empty_indexed(
        index, ir_bytes, callee_name
    );
    if std::mem::len(qualified) > 0 {
        return try lower_signature_call_arg_types_indexed(
            index, ir_bytes, ir_bytes[0..0], qualified, ir_bytes[0..0], arg_count
        );
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return try lower_stdlib_call_arg_types_indexed(index, ir_bytes, callee_name, arg_count);
    }
    return try lower_signature_call_arg_types_indexed(
        index, ir_bytes, module_prefix, callee_name, module_prefix, arg_count
    );
}

pub fn lower_call_arg_types_cached(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_count: i64,
    ir_lookup_index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache
) -> !std::array::Array<[]u8> {
    cache.lookups = cache.lookups + 1;
    var index = 0;
    while index < cache.arg_counts.len() {
        if (try cache.arg_counts.get(index)) == arg_count and
            std::mem::equal_bytes(try cache.module_prefixes.get(index), module_prefix) and
            std::mem::equal_bytes(try cache.callee_names.get(index), callee_name) {
            cache.hits = cache.hits + 1;
            return try copy_cached_call_arg_types(
                cache, try cache.type_starts.get(index), arg_count
            );
        }
        index = index + 1;
    }

    var types = try lower_call_arg_types_indexed(
        ir_lookup_index, ir_bytes, module_prefix, callee_name, arg_count
    );
    let type_start = cache.types.len();
    try append_cached_call_arg_types(cache, &types);
    try cache.module_prefixes.append(module_prefix);
    try cache.callee_names.append(callee_name);
    try cache.arg_counts.append(arg_count);
    try cache.type_starts.append(type_start);
    return types;
}

fn append_cached_call_arg_types(
    cache: &var CallArgTypeCache,
    types: &std::array::Array<[]u8>
) -> !void {
    var index = 0;
    while index < types.len() {
        try cache.types.append(try types.get(index));
        index = index + 1;
    }
    return;
}

fn copy_cached_call_arg_types(
    cache: &CallArgTypeCache,
    type_start: i64,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    var copied = std::array::Array<[]u8>(std::mem::page_allocator());
    var index = 0;
    while index < arg_count {
        try copied.append(try cache.types.get(type_start + index));
        index = index + 1;
    }
    return copied;
}

fn lower_signature_call_arg_types(
    ir_bytes: []u8,
    lookup_prefix: []u8,
    callee_name: []u8,
    type_module_prefix: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    var types = std::array::Array<[]u8>(std::mem::page_allocator());
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(lookup_prefix);
    let name_len = std::mem::len(callee_name);
    var index = 0;
    while arg_count > 0 and
        index + prefix_len + mp_len + name_len < byte_len and
        types.len() < arg_count {
        if compiled_util::is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let mp_start = index + prefix_len;
            let mp_end = mp_start + mp_len;
            let name_end = mp_end + name_len;
            if name_end < byte_len and
                std::mem::equal_bytes(ir_bytes[mp_start..mp_end], lookup_prefix) and
                std::mem::equal_bytes(ir_bytes[mp_end..name_end], callee_name) and
                ir_bytes[name_end] == cast<u8>(32) {
                let line_end_pos = compiled_util::find_line_end(ir_bytes, name_end);
                let entry = ir_bytes[name_end..line_end_pos];
                let entry_len = std::mem::len(entry);
                let colon1 = compiled_util::find_byte(entry, cast<u8>(58), 0);
                let colon2 = compiled_util::find_byte(entry, cast<u8>(58), colon1 + 1);
                if colon2 >= entry_len {
                    return error("compiled function: call arg type not found");
                }
                let kizu_type = entry[colon2 + 1..entry_len];
                try types.append(
                    try compiled_type_lower::kizu_type_to_llvm(
                        ir_bytes, type_module_prefix, kizu_type
                    )
                );
            }
        }
        index = compiled_util::find_line_end(ir_bytes, index) + 1;
    }
    let found_count = types.len();
    if found_count == arg_count {
        return types;
    }
    if std::mem::len(lookup_prefix) > 0 {
        return try lower_signature_call_arg_types(
            ir_bytes, ir_bytes[0..0], callee_name, type_module_prefix, arg_count
        );
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled function: call arg type not found: ");
    try message.append_bytes(callee_name);
    try message.append_bytes(" expected ");
    try std::fmt::append_i64(&var message, arg_count);
    try message.append_bytes(" got ");
    try std::fmt::append_i64(&var message, found_count);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

fn lower_signature_call_arg_types_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    lookup_prefix: []u8,
    callee_name: []u8,
    type_module_prefix: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    var types = std::array::Array<[]u8>(std::mem::page_allocator());
    let prefix = "function-signature-param ";
    var entry_index = ir_index::first_matching_entry(
        index, ir_bytes, prefix, lookup_prefix, callee_name
    );
    while arg_count > 0 and
        entry_index >= 0 and
        ir_index::entry_matches_query(
            index, ir_bytes, entry_index, prefix, lookup_prefix, callee_name
        ) and
        types.len() < arg_count {
        let key_end = ir_index::entry_key_end(index, entry_index);
        let line_end = ir_index::entry_line_end(index, entry_index);
        let line = ir_bytes[key_end..line_end];
        let entry_len = std::mem::len(line);
        let colon1 = compiled_util::find_byte(line, cast<u8>(58), 0);
        let colon2 = compiled_util::find_byte(line, cast<u8>(58), colon1 + 1);
        if colon2 >= entry_len {
            return error("compiled function: call arg type not found");
        }
        let kizu_type = line[colon2 + 1..entry_len];
        try types.append(
            try compiled_type_lower::kizu_type_to_llvm_indexed(
                index, ir_bytes, type_module_prefix, kizu_type
            )
        );
        entry_index = entry_index + 1;
    }
    let found_count = types.len();
    if found_count == arg_count {
        return types;
    }
    if std::mem::len(lookup_prefix) > 0 {
        return try lower_signature_call_arg_types_indexed(
            index, ir_bytes, ir_bytes[0..0], callee_name, type_module_prefix, arg_count
        );
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled function: call arg type not found: ");
    try message.append_bytes(callee_name);
    try message.append_bytes(" expected ");
    try std::fmt::append_i64(&var message, arg_count);
    try message.append_bytes(" got ");
    try std::fmt::append_i64(&var message, found_count);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

fn lower_stdlib_call_arg_types(
    ir_bytes: []u8,
    callee_name: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    var types = std::array::Array<[]u8>(std::mem::page_allocator());
    var index = 0;
    while index < arg_count {
        try types.append(
            try compiled_fact_lookup::lookup_stdlib_arg_type(ir_bytes, callee_name, index)
        );
        index = index + 1;
    }
    return types;
}

fn lower_stdlib_call_arg_types_indexed(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    callee_name: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    var types = std::array::Array<[]u8>(std::mem::page_allocator());
    var index = 0;
    while index < arg_count {
        try types.append(
            try compiled_fact_lookup::lookup_stdlib_arg_type_indexed(
                ir_lookup_index, ir_bytes, callee_name, index
            )
        );
        index = index + 1;
    }
    return types;
}

pub fn resolve_field_receiver_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64
) -> ![]u8 {
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver_node, bs
        );
        return try resolve_value_kizu_type(
            ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs
        );
    }
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return try resolve_field_expr_kizu_type(
            ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs
        );
    }
    if std::mem::equal_bytes(receiver_kind, "Call") {
        let callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, receiver_node, bs
        );
        // A same-component 'std::kizu::*' receiver call carries its own signature fact, so
        // resolve it through the cross-module signature path before the stdlib-symbol
        // short-circuit, matching site 955 and lower_call_return_type (issue 1157 PJ site
        // 532). This branch has no other cross-module fallback, so the pre-empt is added.
        let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee);
        if std::mem::len(qualified) > 0 {
            let cross_ret = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
                ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
            );
            if std::mem::len(cross_ret) > 0 {
                return cross_ret;
            }
        }
        if compiled_fact_lookup::is_stdlib_callee(callee) {
            return try compiled_fact_lookup::lookup_stdlib_return(ir_bytes, callee);
        }
        let ret_type = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
            ir_bytes, "function-signature-return ", module_prefix, callee
        );
        if std::mem::len(ret_type) == 0 {
            return error("compiled mir: call receiver return type not found");
        }
        return ret_type;
    }
    return error("compiled mir: unsupported field receiver type");
}

pub fn resolve_field_receiver_llvm_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64
) -> ![]u8 {
    let kizu_type = try resolve_field_receiver_kizu_type(
        ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs
    );
    return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, kizu_type);
}

pub fn resolve_field_expr_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> ![]u8 {
    let info = try resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
    );
    return info.field_kizu_type;
}

pub fn resolve_field_expr_index(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> !i64 {
    let info = try resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
    );
    return info.field_index;
}

// resolve_field_receiver_kizu_type_indexed mirrors resolve_field_receiver_kizu_type but routes its
// whole-IR resolutions through the sorted index: a Var receiver resolves its param/local type via
// resolve_value_kizu_type_indexed (find_function_param_indexed), a nested FieldExpr receiver via
// resolve_field_expr_kizu_type_indexed, and a Call receiver's cross-module / signature-return
// reads via the indexed lookups. Byte-identical to the non-indexed resolver.
pub fn resolve_field_receiver_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64
) -> ![]u8 {
    // rf tightens the receiver node's own structural reads (its kind / token / call-callee detail)
    // to its body-node line via the index; bs is kept for the Var-receiver value resolution, which
    // reads let/param facts that can precede this node. Byte-identical to a scan from bs.
    let rf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, rf
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver_node, rf
        );
        return try resolve_value_kizu_type_indexed(
            index, ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs
        );
    }
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return try resolve_field_expr_kizu_type_indexed(
            index, ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs
        );
    }
    if std::mem::equal_bytes(receiver_kind, "Call") {
        let callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, receiver_node, rf
        );
        let qualified = cross_module_callee_qualified_name_or_empty_indexed(index, ir_bytes, callee);
        if std::mem::len(qualified) > 0 {
            let cross_ret = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
                index, ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
            );
            if std::mem::len(cross_ret) > 0 {
                return cross_ret;
            }
        }
        if compiled_fact_lookup::is_stdlib_callee(callee) {
            return try compiled_fact_lookup::lookup_stdlib_return_indexed(index, ir_bytes, callee);
        }
        let ret_type = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
            index, ir_bytes, "function-signature-return ", module_prefix, callee
        );
        if std::mem::len(ret_type) == 0 {
            return error("compiled mir: call receiver return type not found");
        }
        return ret_type;
    }
    return error("compiled mir: unsupported field receiver type");
}

pub fn resolve_field_receiver_kizu_type_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64,
    cache: &var CallArgTypeCache
) -> ![]u8 {
    let rf = fn_node_line_start(cache, receiver_node, bs);
    let receiver_kind = try fn_node_kind(cache, ir_bytes, function_name, receiver_node, rf);
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver_node, rf
        );
        return try resolve_value_kizu_type_indexed_cached(
            index, ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs, cache
        );
    }
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        let info = try resolve_field_expr_indexed_with_cache(
            index, ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs, cache
        );
        return info.field_kizu_type;
    }
    if std::mem::equal_bytes(receiver_kind, "Call") {
        let callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, receiver_node, rf
        );
        let qualified = cross_module_callee_qualified_name_or_empty_indexed(index, ir_bytes, callee);
        if std::mem::len(qualified) > 0 {
            let cross_ret = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
                index, ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
            );
            if std::mem::len(cross_ret) > 0 {
                return cross_ret;
            }
        }
        if compiled_fact_lookup::is_stdlib_callee(callee) {
            return try compiled_fact_lookup::lookup_stdlib_return_indexed(index, ir_bytes, callee);
        }
        let ret_type = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
            index, ir_bytes, "function-signature-return ", module_prefix, callee
        );
        if std::mem::len(ret_type) == 0 {
            return error("compiled mir: call receiver return type not found");
        }
        return ret_type;
    }
    return error("compiled mir: unsupported field receiver type");
}

pub fn resolve_field_expr_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> ![]u8 {
    let info = try resolve_field_expr_indexed(
        index, ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
    );
    return info.field_kizu_type;
}

// resolve_field_expr_indexed mirrors resolve_field_expr, routing its two kizu_type_to_llvm
// lowerings and the struct-field lookup through the sorted index. The body-fact reads
// (mode/field-name/receiver) stay on their per-function _from scans, and the receiver type
// resolution keeps its existing path; only the whole-IR type/struct scans are indexed.
pub fn resolve_field_expr_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> !FieldAccessInfo {
    // nf tightens this field expression's own structural facts (its field-expr mode/name and
    // receiver edge) to its body-node line via the index; bs is kept for receiver type
    // resolution, which reads let/param facts that can precede this node.
    let nf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, expr_node, bs
    );
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, nf
    );
    if !std::mem::equal_bytes(mode, "field") {
        return error("compiled mir: namespace field has no struct type");
    }
    let field_name = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, nf
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, nf
    );
    let receiver_kizu_type = try resolve_field_receiver_kizu_type_indexed(
        index, ir_bytes, function_name, module_prefix, params_spec, receiver, bs
    );
    let receiver_llvm_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        index, ir_bytes, module_prefix, receiver_kizu_type
    );
    let lookup_type = struct_lookup_kizu_type(receiver_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        index, ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled function: struct field not found");
    }
    let field_llvm_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        index, ir_bytes, module_prefix, field.field_type
    );
    return FieldAccessInfo {
        receiver_kizu_type: receiver_kizu_type,
        receiver_llvm_type: receiver_llvm_type,
        field_index: field.index,
        field_kizu_type: field.field_type,
        field_llvm_type: field_llvm_type
    };
}

pub fn resolve_field_expr_indexed_with_cache(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64,
    cache: &var CallArgTypeCache
) -> !FieldAccessInfo {
    let nf = fn_node_line_start(cache, expr_node, bs);
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, nf
    );
    if !std::mem::equal_bytes(mode, "field") {
        return error("compiled mir: namespace field has no struct type");
    }
    let field_name = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, nf
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, nf
    );
    let receiver_kizu_type = try resolve_field_receiver_kizu_type_indexed_cached(
        index, ir_bytes, function_name, module_prefix, params_spec, receiver, bs, cache
    );
    let receiver_llvm_type = try kizu_type_to_llvm_indexed_cached(
        index, ir_bytes, module_prefix, receiver_kizu_type, cache
    );
    let lookup_type = struct_lookup_kizu_type(receiver_kizu_type);
    let field = try lookup_struct_field_by_prefix_indexed_cached(
        index, ir_bytes, module_prefix, lookup_type, field_name, cache
    );
    if !field.found {
        return error("compiled function: struct field not found");
    }
    let field_llvm_type = try kizu_type_to_llvm_indexed_cached(
        index, ir_bytes, module_prefix, field.field_type, cache
    );
    return FieldAccessInfo {
        receiver_kizu_type: receiver_kizu_type,
        receiver_llvm_type: receiver_llvm_type,
        field_index: field.index,
        field_kizu_type: field.field_type,
        field_llvm_type: field_llvm_type
    };
}

pub fn resolve_var_receiver_field_expr_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    expr_line_start: i64,
    receiver_name: []u8,
    bs: i64,
    cache: &var CallArgTypeCache
) -> !FieldAccessInfo {
    var cached_index = 0;
    while cached_index < cache.field_expr_nodes.len() {
        if cache.field_expr_nodes.get_or_panic(cached_index) == expr_node {
            return FieldAccessInfo {
                receiver_kizu_type: cache.field_receiver_kizu_types.get_or_panic(cached_index),
                receiver_llvm_type: cache.field_receiver_llvm_types.get_or_panic(cached_index),
                field_index: cache.field_indexes.get_or_panic(cached_index),
                field_kizu_type: cache.field_kizu_types.get_or_panic(cached_index),
                field_llvm_type: cache.field_llvm_types.get_or_panic(cached_index)
            };
        }
        cached_index = cached_index + 1;
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, expr_line_start
    );
    if !std::mem::equal_bytes(mode, "field") {
        return error("compiled mir: namespace field has no struct type");
    }
    let field_name = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, expr_line_start
    );
    let receiver_kizu_type = try resolve_value_kizu_type_indexed_cached(
        index, ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs, cache
    );
    let receiver_llvm_type = try kizu_type_to_llvm_indexed_cached(
        index, ir_bytes, module_prefix, receiver_kizu_type, cache
    );
    let lookup_type = struct_lookup_kizu_type(receiver_kizu_type);
    let field = try lookup_struct_field_by_prefix_indexed_cached(
        index, ir_bytes, module_prefix, lookup_type, field_name, cache
    );
    if !field.found {
        return error("compiled function: struct field not found");
    }
    let field_llvm_type = try kizu_type_to_llvm_indexed_cached(
        index, ir_bytes, module_prefix, field.field_type, cache
    );
    let info = FieldAccessInfo {
        receiver_kizu_type: receiver_kizu_type,
        receiver_llvm_type: receiver_llvm_type,
        field_index: field.index,
        field_kizu_type: field.field_type,
        field_llvm_type: field_llvm_type
    };
    try cache.field_expr_nodes.append(expr_node);
    try cache.field_receiver_kizu_types.append(info.receiver_kizu_type);
    try cache.field_receiver_llvm_types.append(info.receiver_llvm_type);
    try cache.field_indexes.append(info.field_index);
    try cache.field_kizu_types.append(info.field_kizu_type);
    try cache.field_llvm_types.append(info.field_llvm_type);
    return info;
}


pub fn resolve_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> !FieldAccessInfo {
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, bs
    );
    if !std::mem::equal_bytes(mode, "field") {
        return error("compiled mir: namespace field has no struct type");
    }
    let field_name = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, bs
    );
    let receiver_kizu_type = try resolve_field_receiver_kizu_type(
        ir_bytes, function_name, module_prefix, params_spec, receiver, bs
    );
    let receiver_llvm_type = try compiled_type_lower::kizu_type_to_llvm(
        ir_bytes, module_prefix, receiver_kizu_type
    );
    let lookup_type = struct_lookup_kizu_type(receiver_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix(
        ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled function: struct field not found");
    }
    let field_llvm_type = try compiled_type_lower::kizu_type_to_llvm(
        ir_bytes, module_prefix, field.field_type
    );
    return FieldAccessInfo {
        receiver_kizu_type: receiver_kizu_type,
        receiver_llvm_type: receiver_llvm_type,
        field_index: field.index,
        field_kizu_type: field.field_type,
        field_llvm_type: field_llvm_type
    };
}

fn find_spec_llvm_type_or_empty(params_spec: []u8, name: []u8) -> []u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            let param_type = params_spec[pos..space_pos];
            let param_name = params_spec[space_pos + 1..entry_end];
            if std::mem::equal_bytes(param_name, name) {
                return param_type;
            }
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return params_spec[0..0];
}

// resolve_value_array_get_element_or_empty returns the element type T of a
// '<var>.get(<expr>)' call when <var> is a value-receiver std::array::Array<T>
// param/local, otherwise "" (issue 1165). It backs the let-binding type resolution for
// 'let next = try tokens.get(...)', whose callee is a field-mode method rather than a
// signature-bearing function.
fn resolve_value_array_get_element_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let callee_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, callee_node, bs);
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return "";
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, bs
    );
    if !std::mem::equal_bytes(mode, "field") {
        return "";
    }
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return "";
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, receiver_node, bs);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return "";
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kizu = try resolve_receiver_value_kizu_type(
        ir_bytes, function_name, module_prefix, receiver_name, bs
    );
    let lookup = struct_lookup_kizu_type(receiver_kizu);
    return array_value_element_kizu_type_or_empty(lookup);
}

fn resolve_value_array_get_element_or_empty_indexed_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let call_sf = fn_node_line_start(cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, call_sf
    );
    let callee_sf = fn_node_line_start(cache, callee_node, call_sf);
    let callee_kind = try fn_node_kind(cache, ir_bytes, function_name, callee_node, callee_sf);
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return "";
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(mode, "field") {
        return "";
    }
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", callee_sf
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return "";
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = fn_node_line_start(cache, receiver_node, callee_sf);
    let receiver_kind = try fn_node_kind(cache, ir_bytes, function_name, receiver_node, receiver_sf);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return "";
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_kizu = try resolve_receiver_value_kizu_type_indexed_cached(
        index, cache, ir_bytes, function_name, module_prefix, receiver_name, bs
    );
    let lookup = struct_lookup_kizu_type(receiver_kizu);
    return array_value_element_kizu_type_or_empty(lookup);
}

fn array_get_error_union_llvm_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    element_kizu_type: []u8
) -> ![]u8 {
    return try compiled_type_lower::error_union_inner_to_llvm(
        ir_bytes, module_prefix, element_kizu_type
    );
}

fn array_get_error_union_llvm_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    element_kizu_type: []u8
) -> ![]u8 {
    return try compiled_type_lower::error_union_inner_to_llvm_indexed(
        index, ir_bytes, module_prefix, element_kizu_type
    );
}

// array_value_element_kizu_type_or_empty strips the std::array::Array<...> wrapper and
// returns the element type token, or "" when the type is not an Array<T> (issue 1165).
pub fn array_value_element_kizu_type_or_empty(kizu_type: []u8) -> []u8 {
    let prefix = "std::array::Array<";
    if !std::mem::starts_with(kizu_type, prefix) {
        return "";
    }
    let prefix_len = std::mem::len(prefix);
    let type_len = std::mem::len(kizu_type);
    if type_len <= prefix_len or kizu_type[type_len - 1] != cast<u8>(62) {
        return "";
    }
    return kizu_type[prefix_len..type_len - 1];
}

// resolve_receiver_value_kizu_type resolves a value receiver's kizu type whether it is a
// function parameter or a local binding (issue 1165). It is used where the call-site
// params_spec is not threaded (let-binding type resolution).
pub fn resolve_receiver_value_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param = try find_function_param_kizu_type_or_empty(ir_bytes, function_name, name);
    if std::mem::len(param) > 0 {
        return param;
    }
    return try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
}

// resolve_receiver_value_kizu_type_indexed routes the param-signature probe through the sorted
// index (O(log n) instead of the O(IR) function-signature-param scan); the local fallback keeps
// its body-block walk (already cursor-linear). Byte-identical to the non-indexed resolver.
pub fn resolve_receiver_value_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param = try find_function_param_kizu_type_or_empty_indexed(
        index, ir_bytes, function_name, name
    );
    if std::mem::len(param) > 0 {
        return param;
    }
    return try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
}

fn resolve_receiver_value_kizu_type_indexed_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param = try find_function_param_kizu_type_or_empty_indexed(
        index, ir_bytes, function_name, name
    );
    if std::mem::len(param) > 0 {
        return param;
    }
    return try resolve_local_kizu_type_cached(
        index, cache, ir_bytes, function_name, module_prefix, name, bs
    );
}

// find_function_param_kizu_type_or_empty_indexed mirrors find_function_param_kizu_type_or_empty
// but walks only the sorted index entries whose first two tokens are
// 'function-signature-param <function_name>' instead of rescanning every IR line. The
// param facts for one function share that two-token key, so the index groups them
// contiguously in ascending line_start (file) order: iterating from first_matching_entry
// while entry_matches_query holds visits exactly the same lines, in the same order, that
// the linear scan's prefix+name+space test admits. Each entry's line begins with the
// prefix, so the line_start + prefix_len + fn_len offset lands on the trailing space the
// linear scan checks, and extract_param_kizu_type_from_line then parses identically.
fn find_function_param_kizu_type_or_empty_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8
) -> ![]u8 {
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let fn_len = std::mem::len(function_name);
    var entry = ir_index::first_matching_entry(index, ir_bytes, prefix, ir_bytes[0..0], function_name);
    while entry >= 0 and
        ir_index::entry_matches_query(index, ir_bytes, entry, prefix, ir_bytes[0..0], function_name) {
        let fn_end = ir_index::entry_line_start(index, entry) + prefix_len + fn_len;
        let kizu_type = extract_param_kizu_type_from_line(ir_bytes, fn_end + 1, name);
        if std::mem::len(kizu_type) > 0 {
            return kizu_type;
        }
        entry = entry + 1;
    }
    return "";
}

fn find_function_param_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8
) -> ![]u8 {
    let found = try find_function_param_kizu_type_or_empty_indexed(
        index, ir_bytes, function_name, name
    );
    if std::mem::len(found) > 0 {
        return found;
    }
    return error("compiled mir: param kizu type not found");
}

fn find_function_param_kizu_type_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let fn_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + fn_len < byte_len {
        if compiled_util::is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let fn_start = index + prefix_len;
            let fn_end = fn_start + fn_len;
            if fn_end < byte_len and
                std::mem::equal_bytes(ir_bytes[fn_start..fn_end], function_name) and
                ir_bytes[fn_end] == cast<u8>(32) {
                let kizu_type = extract_param_kizu_type_from_line(
                    ir_bytes, fn_end + 1, name
                );
                if std::mem::len(kizu_type) > 0 {
                    return kizu_type;
                }
            }
        }
        index = compiled_util::find_line_end(ir_bytes, index) + 1;
    }
    return "";
}

fn find_function_param_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let fn_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + fn_len < byte_len {
        if compiled_util::is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let fn_start = index + prefix_len;
            let fn_end = fn_start + fn_len;
            if fn_end < byte_len and
                std::mem::equal_bytes(ir_bytes[fn_start..fn_end], function_name) and
                ir_bytes[fn_end] == cast<u8>(32) {
                let kizu_type = extract_param_kizu_type_from_line(
                    ir_bytes, fn_end + 1, name
                );
                if std::mem::len(kizu_type) > 0 {
                    return kizu_type;
                }
            }
        }
        index = compiled_util::find_line_end(ir_bytes, index) + 1;
    }
    return error("compiled mir: param kizu type not found");
}

fn extract_param_kizu_type_from_line(
    ir_bytes: []u8,
    entry_start: i64,
    name: []u8
) -> []u8 {
    let line_end = compiled_util::find_line_end(ir_bytes, entry_start);
    var pos = entry_start;
    while pos < line_end and ir_bytes[pos] != cast<u8>(32) {
        pos = pos + 1;
    }
    if pos >= line_end {
        return ir_bytes[0..0];
    }
    pos = pos + 1;
    let entry = ir_bytes[pos..line_end];
    let entry_len = std::mem::len(entry);
    let colon1 = compiled_util::find_byte(entry, cast<u8>(58), 0);
    if colon1 >= entry_len {
        return ir_bytes[0..0];
    }
    if !std::mem::equal_bytes(entry[0..colon1], name) {
        return ir_bytes[0..0];
    }
    let colon2 = compiled_util::find_byte(entry, cast<u8>(58), colon1 + 1);
    if colon2 >= entry_len {
        return ir_bytes[0..0];
    }
    return entry[colon2 + 1..entry_len];
}

fn resolve_local_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let found = try resolve_local_in_block_or_empty(
        ir_bytes, function_name, module_prefix, name, 0, bs
    );
    if std::mem::len(found) == 0 {
        return local_type_not_found(name);
    }
    return found;
}

fn local_type_not_found(name: []u8) -> ![]u8 {
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled mir: local type not found: ");
    try message.append_bytes(name);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}
// resolve_local_in_block_or_empty scans one statement block for a let binding named
// 'name', descending into while bodies so a counter loop's body-local lets (e.g. the
// 'let byte = payload[index]' inside is_payload_supported) resolve like top-level
// ones. It returns the binding's kizu type, or "" when the name is not bound in this
// block or any nested while body (tracker 961). Every resolvable let value yields a
// non-empty type, so "" is an unambiguous not-found signal.
fn resolve_local_in_block_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    block_node: i64,
    bs: i64
) -> ![]u8 {
    // A let binding directly in this block shadows any same-named binding in a
    // nested while/if body, so resolve direct bindings before descending. Without
    // the level-first pass, parse_closed_start_slice's then-block 'let end =
    // ast.add_empty(...)' (a NodeId) would be returned for the enclosing 'let end =
    // try parse_expr(...)' (a ParseNode) that a later outer statement's 'end.next'
    // field read targets, mis-resolving the receiver to a fieldless NodeId.
    let direct = try resolve_direct_let_in_block_or_empty(
        ir_bytes, function_name, module_prefix, name, block_node, bs
    );
    if std::mem::len(direct) > 0 {
        return direct;
    }
    // scan_from advances to each statement's body-node line so the next statement edge / kind is
    // found from a tight cursor instead of rescanning from bs every iteration (quadratic per local
    // -> linear). The walk visits the exact same statements, so the result is byte-identical.
    var scan_from = bs;
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, scan_from
        );
        if statement < 0 {
            return "";
        }
        let sf = try ir_contract::body_node_line_offset_from(
            ir_bytes, function_name, statement, scan_from
        );
        scan_from = sf;
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, sf);
        if std::mem::equal_bytes(stmt_kind, "While") {
            let body_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "body", 0, sf
            );
            let nested = try resolve_local_in_block_or_empty(
                ir_bytes, function_name, module_prefix, name, body_node, bs
            );
            if std::mem::len(nested) > 0 {
                return nested;
            }
        }
        // An if-then (and its else) block can bind body-locals that later statements in the same
        // block read, the same way a while body can. The leading_imports sort branch at
        // selfhost/src/parser/format.kizu:28 opens 'if leading_imports.len() > 1 { let next_index
        // = ...; let last_import = try format_tokens.get(...); ... }', and the 'last_import.end'
        // field read resolves last_import's kizu type by re-scanning the body. Descend into the
        // then/else blocks (skipping an absent else) so those bindings resolve like while-body
        // ones; an else that is itself a nested 'if' or an empty block simply contributes no
        // statement to scan (issue 1199).
        if std::mem::equal_bytes(stmt_kind, "If") {
            let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "then", 0, sf
            );
            if then_node >= 0 {
                let then_nested = try resolve_local_in_block_or_empty(
                    ir_bytes, function_name, module_prefix, name, then_node, bs
                );
                if std::mem::len(then_nested) > 0 {
                    return then_nested;
                }
            }
            let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "else", 0, sf
            );
            if else_node >= 0 {
                let else_nested = try resolve_local_in_block_or_empty(
                    ir_bytes, function_name, module_prefix, name, else_node, bs
                );
                if std::mem::len(else_nested) > 0 {
                    return else_nested;
                }
            }
        }
        stmt_index = stmt_index + 1;
    }
    return "";
}
// resolve_direct_let_in_block_or_empty scans only the let bindings directly in
// 'block_node' (without descending into nested while/if bodies) for one named
// 'name', returning its kizu type or "" when absent. resolve_local_in_block_or_empty
// runs this level-first so an enclosing-scope binding wins over a same-named one
// bound inside a nested block, matching lexical scoping.
fn resolve_direct_let_in_block_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    block_node: i64,
    bs: i64
) -> ![]u8 {
    // Same body-node-line cursor as resolve_local_in_block_or_empty: advance scan_from to each
    // statement so the direct-let scan is linear (not a from-bs rescan per statement).
    // Byte-identical; resolve_let_value_kizu_type keeps bs.
    var scan_from = bs;
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, scan_from
        );
        if statement < 0 {
            return "";
        }
        let sf = try ir_contract::body_node_line_offset_from(
            ir_bytes, function_name, statement, scan_from
        );
        scan_from = sf;
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, sf);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, sf
            );
            let local_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, sf
            );
            if std::mem::equal_bytes(local_name, name) {
                return try resolve_let_value_kizu_type(
                    ir_bytes, function_name, module_prefix, statement, bs
                );
            }
        }
        stmt_index = stmt_index + 1;
    }
    return "";
}
fn append_lower_snake_type_name(out: &var std::string::String, name: []u8) -> !void {
    var index = 0;
    while index < std::mem::len(name) {
        let byte = name[index];
        if byte >= cast<u8>(65) and byte <= cast<u8>(90) {
            if index > 0 {
                try out.append_byte(cast<u8>(95));
            }
            try out.append_byte(byte + cast<u8>(32));
        } else {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    return;
}

// value_receiver_method_return_kizu_or_empty resolves the return kizu type of a value-receiver
// method bound to a let ('let range = ast.finish_children(start);'), so a later field read on the
// binding ('range.start') resolves the struct's fields. It derives the method symbol the same way
// method_call_info does -- <impl-prefix><lower-snake receiver type>_<method> -- and reads the
// function-signature-return fact. A bare named-type result (e.g. 'ChildRange') carries a type-llvm
// fact only under its owning module, so it is requalified against the receiver type's module; the
// suffix-matching struct-field lookup then resolves it cross-module. A primitive ('i64') has no
// such fact and an already-qualified spelling needs none, so both are returned verbatim. "" means
// the signature fact is absent, so the caller keeps its existing i64 fallback. This subsumes the
// old i64 hardcode that mistyped every struct-returning value-receiver mutator (issue 1157 NEW-A:
// finish_children -> ChildRange backs the child-range drain that feeds ast.add_call).
fn value_receiver_method_return_kizu_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    callee_node: i64,
    method_name: []u8,
    bs: i64
) -> ![]u8 {
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, receiver, bs);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return ir_bytes[0..0];
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, bs
    );
    let receiver_kizu = try resolve_receiver_value_kizu_type(
        ir_bytes, function_name, module_prefix, receiver_name, bs
    );
    let lookup_type = struct_lookup_kizu_type(receiver_kizu);
    let type_prefix = compiled_util::module_prefix_of(lookup_type);
    var impl_prefix = type_prefix;
    if std::mem::len(impl_prefix) == 0 {
        impl_prefix = module_prefix;
    }
    let type_name = lookup_type[std::mem::len(type_prefix)..std::mem::len(lookup_type)];
    var qualified = std::string::String(std::mem::page_allocator());
    try qualified.append_bytes(impl_prefix);
    try append_lower_snake_type_name(&var qualified, type_name);
    try qualified.append_byte(cast<u8>(95));
    try qualified.append_bytes(method_name);
    let qualified_view = qualified.as_bytes();
    var copied_qualified = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied_qualified.insert(qualified_view, qualified_view);
    let qualified_name = try copied_qualified.get(qualified_view);
    let return_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
        ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified_name
    );
    if std::mem::len(return_kizu) == 0 {
        return ir_bytes[0..0];
    }
    let colon = compiled_util::find_byte(return_kizu, cast<u8>(58), 0);
    if colon < std::mem::len(return_kizu) {
        return return_kizu;
    }
    var requalified = std::string::String(std::mem::page_allocator());
    try requalified.append_bytes(impl_prefix);
    try requalified.append_bytes(return_kizu);
    let requalified_view = requalified.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(requalified_view, requalified_view);
    let requalified_name = try copied.get(requalified_view);
    let type_llvm = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
        ir_bytes, "type-llvm ", ir_bytes[0..0], requalified_name
    );
    if std::mem::len(type_llvm) == 0 {
        return return_kizu;
    }
    return requalified_name;
}

fn value_receiver_method_return_kizu_or_empty_indexed_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    callee_node: i64,
    method_name: []u8,
    callee_sf: i64,
    bs: i64
) -> ![]u8 {
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = fn_node_line_start(cache, receiver, callee_sf);
    let receiver_kind = try fn_node_kind(cache, ir_bytes, function_name, receiver, receiver_sf);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return ir_bytes[0..0];
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, receiver_sf
    );
    let receiver_kizu = try resolve_receiver_value_kizu_type_indexed_cached(
        index, cache, ir_bytes, function_name, module_prefix, receiver_name, bs
    );
    let lookup_type = struct_lookup_kizu_type(receiver_kizu);
    let type_prefix = compiled_util::module_prefix_of(lookup_type);
    var impl_prefix = type_prefix;
    if std::mem::len(impl_prefix) == 0 {
        impl_prefix = module_prefix;
    }
    let type_name = lookup_type[std::mem::len(type_prefix)..std::mem::len(lookup_type)];
    var qualified = std::string::String(std::mem::page_allocator());
    try qualified.append_bytes(impl_prefix);
    try append_lower_snake_type_name(&var qualified, type_name);
    try qualified.append_byte(cast<u8>(95));
    try qualified.append_bytes(method_name);
    let qualified_view = qualified.as_bytes();
    var copied_qualified = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied_qualified.insert(qualified_view, qualified_view);
    let qualified_name = try copied_qualified.get(qualified_view);
    let return_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        index, ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified_name
    );
    if std::mem::len(return_kizu) == 0 {
        return ir_bytes[0..0];
    }
    let colon = compiled_util::find_byte(return_kizu, cast<u8>(58), 0);
    if colon < std::mem::len(return_kizu) {
        return return_kizu;
    }
    var requalified = std::string::String(std::mem::page_allocator());
    try requalified.append_bytes(impl_prefix);
    try requalified.append_bytes(return_kizu);
    let requalified_view = requalified.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(requalified_view, requalified_view);
    let requalified_name = try copied.get(requalified_view);
    let type_llvm = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        index, ir_bytes, "type-llvm ", ir_bytes[0..0], requalified_name
    );
    if std::mem::len(type_llvm) == 0 {
        return return_kizu;
    }
    return requalified_name;
}

pub struct MethodCallResolved {
    pub receiver_name: []u8,
    pub receiver_llvm_type: []u8,
    pub return_llvm_type: []u8,
    pub module_prefix: []u8,
    pub callee_name: []u8,
}

// callee_is_field_mode_method reports whether a Call node's callee is a field-mode FieldExpr,
// i.e. a value-receiver method call (receiver.method(...)) rather than a free or namespaced call.
// It mirrors the statement lowerer's callee_is_field_expr predicate so struct-field lowering can
// detect cross-module method calls without importing the statement lowerer (avoiding a cycle).
pub fn callee_is_field_mode_method(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, bs
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return false;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, bs
    );
    return std::mem::equal_bytes(callee_mode, "field");
}

// resolve_method_call resolves a value-receiver method call '<receiver>.<method>(<args>)' to its
// mangled cross-module symbol, receiver value, and return type. The method symbol is derived as
// <impl-prefix><lower-snake receiver type>_<method> (e.g. ast.finish_children ->
// std::kizu::ast::ast_finish_children) and the return type comes from the function-signature-return
// fact, so neither is hardcoded. It mirrors the statement lowerer's method_call_info but lives here
// so both the statement and struct-field lowerers share the same receiver-prepended method symbol
// resolution (the struct-field path previously emitted the literal 'ast.<method>' against the
// caller module and dropped the receiver).
pub fn resolve_method_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !MethodCallResolved {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, bs
    );
    if !std::mem::equal_bytes(mode, "field") {
        return error("compiled mir: method call callee must be field-mode");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: method call receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kizu = try resolve_value_kizu_type(
        ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs
    );
    let receiver_llvm = try compiled_type_lower::kizu_type_to_llvm(
        ir_bytes, module_prefix, receiver_kizu
    );
    let lookup_type = struct_lookup_kizu_type(receiver_kizu);
    let type_prefix = compiled_util::module_prefix_of(lookup_type);
    var impl_prefix = type_prefix;
    if std::mem::len(impl_prefix) == 0 {
        impl_prefix = module_prefix;
    }
    let type_name = lookup_type[std::mem::len(type_prefix)..std::mem::len(lookup_type)];
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    var qualified = std::string::String(std::mem::page_allocator());
    try qualified.append_bytes(impl_prefix);
    try append_lower_snake_type_name(&var qualified, type_name);
    try qualified.append_byte(cast<u8>(95));
    try qualified.append_bytes(method_name);
    let qualified_name_view = qualified.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(qualified_name_view, qualified_name_view);
    let qualified_name = try copied.get(qualified_name_view);
    let return_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
        ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified_name
    );
    if std::mem::len(return_kizu) == 0 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled mir: method call signature not found: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" node ");
        try std::fmt::append_i64(&var message, call_node);
        try message.append_bytes(" receiver ");
        try message.append_bytes(receiver_name);
        try message.append_bytes(":");
        try message.append_bytes(receiver_kizu);
        try message.append_bytes(" method ");
        try message.append_bytes(method_name);
        try message.append_bytes(" qualified ");
        try message.append_bytes(qualified_name);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let return_llvm = try compiled_type_lower::kizu_type_to_llvm(
        ir_bytes, impl_prefix, return_kizu
    );
    let callee_prefix = compiled_util::module_prefix_of(qualified_name);
    return MethodCallResolved {
        receiver_name: receiver_name,
        receiver_llvm_type: receiver_llvm,
        return_llvm_type: return_llvm,
        module_prefix: callee_prefix,
        callee_name: qualified_name[std::mem::len(callee_prefix)..std::mem::len(qualified_name)]
    };
}

// resolve_let_value_kizu_type resolves the declared kizu type of a let binding from
// its initializer node.
fn resolve_let_value_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    statement: i64,
    bs: i64
) -> ![]u8 {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    return try resolve_let_value_kizu_type_for_value(
        ir_bytes, function_name, module_prefix, value, bs, bs
    );
}

fn resolve_let_value_kizu_type_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    statement: i64,
    bs: i64
) -> ![]u8 {
    let statement_sf = fn_node_line_start(cache, statement, bs);
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, statement_sf
    );
    let value_sf = fn_node_line_start(cache, value, bs);
    return try resolve_let_value_kizu_type_for_value_cached(
        index, cache, ir_bytes, function_name, module_prefix, value, value_sf, bs
    );
}

fn resolve_let_value_kizu_type_for_value(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    value: i64,
    value_sf: i64,
    bs: i64
) -> ![]u8 {
    let value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, value, value_sf
    );
    return try resolve_let_value_kizu_type_for_value_with_kind(
        ir_bytes, function_name, module_prefix, value, value_sf, bs, value_kind
    );
}

fn resolve_let_value_kizu_type_for_value_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    value: i64,
    value_sf: i64,
    bs: i64
) -> ![]u8 {
    let value_kind = try fn_node_kind(cache, ir_bytes, function_name, value, value_sf);
    if std::mem::equal_bytes(value_kind, "FieldExpr") {
        let info = try resolve_field_expr_indexed_with_cache(
            index, ir_bytes, function_name, module_prefix, "", value, bs, cache
        );
        return info.field_kizu_type;
    }
    if std::mem::equal_bytes(value_kind, "Call") {
        return try resolve_let_call_value_kizu_type_indexed_cached(
            index, cache, ir_bytes, function_name, module_prefix, value, value_sf, bs
        );
    }
    if std::mem::equal_bytes(value_kind, "Var") {
        let ref_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, value, value_sf
        );
        return try resolve_value_kizu_type_indexed_cached(
            index, ir_bytes, function_name, module_prefix, "", ref_name, bs, cache
        );
    }
    if std::mem::equal_bytes(value_kind, "TryExpr") {
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "value", 0, value_sf
        );
        let inner_sf = fn_node_line_start(cache, inner, value_sf);
        let inner_kind = try fn_node_kind(cache, ir_bytes, function_name, inner, inner_sf);
        if std::mem::equal_bytes(inner_kind, "Call") {
            let array_get_element = try resolve_value_array_get_element_or_empty_indexed_cached(
                index, cache, ir_bytes, function_name, module_prefix, inner, bs
            );
            if std::mem::len(array_get_element) > 0 {
                return array_get_element;
            }
            let try_callee = try ir_contract::body_call_callee_or_empty_from(
                ir_bytes, function_name, inner, inner_sf
            );
            return try resolve_try_call_success_kizu_type_indexed(
                index, ir_bytes, module_prefix, try_callee
            );
        }
    }
    return try resolve_let_value_kizu_type_for_value_with_kind(
        ir_bytes, function_name, module_prefix, value, value_sf, bs, value_kind
    );
}

// Indexed twin of the Call arm in resolve_let_value_kizu_type_for_value_with_kind. Keep the
// structural method-call cases identical, but avoid whole-IR signature/suffix scans on the hot
// local-type path.
fn resolve_let_call_value_kizu_type_indexed_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    value: i64,
    value_sf: i64,
    bs: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, value, value_sf
    );
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        if std::mem::len(
            cross_module_callee_qualified_name_or_empty_indexed(index, ir_bytes, callee_name)
        ) == 0 {
            return try compiled_fact_lookup::lookup_stdlib_return_indexed(
                index, ir_bytes, callee_name
            );
        }
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "callee", 0, value_sf
    );
    let callee_sf = fn_node_line_start(cache, callee_node, value_sf);
    let callee_kind = try fn_node_kind(cache, ir_bytes, function_name, callee_node, callee_sf);
    var callee_field_mode = false;
    if std::mem::equal_bytes(callee_kind, "FieldExpr") {
        let callee_mode = try ir_contract::sequence_fact_second_value_from(
            ir_bytes, "body-field-expr ", function_name, callee_node, callee_sf
        );
        callee_field_mode = std::mem::equal_bytes(callee_mode, "field");
    }
    if callee_field_mode {
        let method_name = try ir_contract::body_field_expr_name_from(
            ir_bytes, function_name, callee_node, "field", callee_sf
        );
        if std::mem::equal_bytes(method_name, "get") {
            let get_receiver = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
            );
            let get_receiver_sf = fn_node_line_start(cache, get_receiver, value_sf);
            let get_receiver_kind = try fn_node_kind(
                cache, ir_bytes, function_name, get_receiver, get_receiver_sf
            );
            if std::mem::equal_bytes(get_receiver_kind, "Var") {
                let get_receiver_name = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, get_receiver, get_receiver_sf
                );
                let get_receiver_kizu = try resolve_receiver_value_kizu_type_indexed_cached(
                    index, cache, ir_bytes, function_name, module_prefix, get_receiver_name, bs
                );
                if std::mem::equal_bytes(
                    struct_lookup_kizu_type(get_receiver_kizu), "std::kizu::ast::Ast"
                ) {
                    return "std::kizu::ast::AstNode";
                }
            }
        }
        let method_ret = try value_receiver_method_return_kizu_or_empty_indexed_cached(
            index, cache, ir_bytes, function_name, module_prefix, callee_node, method_name,
            callee_sf, bs
        );
        if std::mem::len(method_ret) > 0 {
            return method_ret;
        }
        return "i64";
    }
    let ret_type = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        index, ir_bytes, "function-signature-return ", module_prefix, callee_name
    );
    if std::mem::len(ret_type) > 0 {
        return ret_type;
    }
    let qualified = cross_module_callee_qualified_name_or_empty_indexed(index, ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        let cross_ret = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
            index, ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
        );
        if std::mem::len(cross_ret) > 0 {
            return cross_ret;
        }
    }
    return error("compiled mir: local call return type not found");
}

fn resolve_let_value_kizu_type_for_value_with_kind(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    value: i64,
    value_sf: i64,
    bs: i64,
    value_kind: []u8
) -> ![]u8 {
    if std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        return try resolve_struct_literal_kizu_type_from(ir_bytes, function_name, value, value_sf);
    }
    if std::mem::equal_bytes(value_kind, "Call") {
        // A stdlib-namespaced constructor / helper bound to a let resolves its kizu
        // return type from the stdlib-symbol fact: 'var out = std::string::String(...)'
        // binds a std::string::String, i.e. the runtime-owned handle (issue 1165 slice
        // 1). This is checked ahead of the field-mode method shape below because a
        // namespaced callee (std::string::String) is itself a FieldExpr node and would
        // otherwise be mistaken for the Arena<T>.add method.
        let callee_name = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, value, value_sf
        );
        if compiled_fact_lookup::is_stdlib_callee(callee_name) {
            // A 'std::kizu::*' callee that carries its own function-signature-return fact
            // is a same-component compiled function (e.g. a parser helper returning a
            // ParseNode), not a runtime intrinsic: skip the stdlib-symbol short-circuit so
            // the cross-module 'qualified' path below resolves its real return type (issue
            // 1157 PJ site 955). Genuine runtime intrinsics carry no signature fact, so
            // cross_module_callee_qualified_name_or_empty returns "" and they still take
            // the stdlib-symbol table here.
            if std::mem::len(
                cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name)
            ) == 0 {
                return try compiled_fact_lookup::lookup_stdlib_return(ir_bytes, callee_name);
            }
        }
        // A Call whose callee is a field-mode method binds by the method: Ast.get
        // binds the AstNode element by value; .len() and Arena<T>.add bind an i64
        // (the length / the appended slot index). Ast.add_node's
        // 'let raw = self.nodes.add(...)' is the add consumer (tracker 961).
        let callee_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "callee", 0, value_sf
        );
        let callee_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, callee_node, value_sf
        );
        // A field-mode FieldExpr callee is a value-receiver method (Ast.get / .len /
        // Arena.add); a namespace-mode FieldExpr callee is a qualified free function
        // (e.g. codegen::code_op_const_str) resolved through the signature facts below,
        // so only the field mode takes the method binding.
        var callee_field_mode = false;
        if std::mem::equal_bytes(callee_kind, "FieldExpr") {
            let callee_mode = try ir_contract::sequence_fact_second_value_from(
                ir_bytes, "body-field-expr ", function_name, callee_node, value_sf
            );
            callee_field_mode = std::mem::equal_bytes(callee_mode, "field");
        }
        if callee_field_mode {
            let method_name = try ir_contract::body_field_expr_name_from(
                ir_bytes, function_name, callee_node, "field", value_sf
            );
            if std::mem::equal_bytes(method_name, "get") {
                let get_receiver = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, callee_node, "receiver", 0, value_sf
                );
                let get_receiver_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, get_receiver, value_sf
                );
                if std::mem::equal_bytes(get_receiver_kind, "Var") {
                    let get_receiver_name = try ir_contract::body_token_or_empty_from(
                        ir_bytes, function_name, get_receiver, value_sf
                    );
                    let get_receiver_kizu = try resolve_receiver_value_kizu_type(
                        ir_bytes, function_name, module_prefix, get_receiver_name, bs
                    );
                    if std::mem::equal_bytes(
                        struct_lookup_kizu_type(get_receiver_kizu), "std::kizu::ast::Ast"
                    ) {
                        return "std::kizu::ast::AstNode";
                    }
                }
            }
            // Other value-receiver methods (e.g. ast.finish_children -> ChildRange) resolve their
            // real return type from the signature facts so a later field read on the binding
            // resolves; only an absent fact falls back to the historical i64 (.len()/Arena.add).
            let method_ret = try value_receiver_method_return_kizu_or_empty(
                ir_bytes, function_name, module_prefix, callee_node, method_name, bs
            );
            if std::mem::len(method_ret) > 0 {
                return method_ret;
            }
            return "i64";
        }
        let ret_type = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
            ir_bytes, "function-signature-return ", module_prefix, callee_name
        );
        if std::mem::len(ret_type) > 0 {
            return ret_type;
        }
        // A qualified cross-module callee (e.g. codegen::code_op_const_str) resolves to
        // its fully-qualified function name, whose return type is keyed with an empty
        // module prefix.
        let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
        if std::mem::len(qualified) > 0 {
            let cross_ret = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
                ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
            );
            if std::mem::len(cross_ret) > 0 {
                return cross_ret;
            }
        }
        return error("compiled mir: local call return type not found");
    }
    if std::mem::equal_bytes(value_kind, "Binary") {
        return try resolve_binary_kizu_type(ir_bytes, function_name, value, value_sf);
    }
    // 'var index = import_index;' seeds a loop counter from a parameter (or an outer
    // local), so the bound local takes that referenced value's kizu type (issue 1165).
    // index_after_import's parameter-seeded induction variable is the first consumer.
    if std::mem::equal_bytes(value_kind, "Var") {
        let ref_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, value, value_sf
        );
        let param_type = try find_function_param_kizu_type_or_empty(
            ir_bytes, function_name, ref_name
        );
        if std::mem::len(param_type) > 0 {
            return param_type;
        }
        let local_type = try resolve_local_in_block_or_empty(
            ir_bytes, function_name, module_prefix, ref_name, 0, bs
        );
        if std::mem::len(local_type) > 0 {
            return local_type;
        }
        return error("compiled mir: var initializer name not found");
    }
    // A bare integer initializer (the 'var index = 0' loop counter) is an
    // i64; a cast carries its target type token directly; a single-element
    // index of a byte slice yields u8, matching the always-i8 IndexLoad the
    // expr lowering emits for path[i] (tracker 961).
    if std::mem::equal_bytes(value_kind, "Int") {
        return "i64";
    }
    // The formatter seeds its scalar carry locals with literal initializers: 'var previous = "";'
    // and 'var last_top_level_decl = "";' bind a byte slice, 'var at_line_start = true;' a bool. A
    // string literal is a []u8 slice and a bool literal is a bool, so the void then-body assignment
    // lowering can resolve these reassignment targets' types from their initializer the same way it
    // resolves an Int or CastExpr seed (issue 1201).
    if std::mem::equal_bytes(value_kind, "String") {
        return "[]u8";
    }
    if std::mem::equal_bytes(value_kind, "Bool") {
        return "bool";
    }
    if std::mem::equal_bytes(value_kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "type", 0, value_sf
        );
        return try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, value_sf
        );
    }
    if std::mem::equal_bytes(value_kind, "IndexExpr") {
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "end", 0, value_sf
        );
        let end_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, end_node, value_sf
        );
        if !std::mem::equal_bytes(end_kind, "Empty") {
            return "[]u8";
        }
        return "u8";
    }
    // 'let x = try <callee>(...)' (a node_count cluster let-try) binds the callee's unwrapped
    // success type: the callee returns '!T', so strip the leading '!' (tracker 961).
    if std::mem::equal_bytes(value_kind, "TryExpr") {
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "value", 0, value_sf
        );
        let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, value_sf);
        if std::mem::equal_bytes(inner_kind, "Call") {
            // 'let next = try tokens.get(<expr>)' on a value-receiver Array<T> binds the
            // element type T (issue 1165). The callee is a field-mode method whose Var
            // receiver resolves to std::array::Array<T>, so the bound local takes T; this is
            // checked ahead of the free-function callee lookup since 'tokens.get' is not a
            // signature-bearing function name.
            let array_get_element = try resolve_value_array_get_element_or_empty(
                ir_bytes, function_name, module_prefix, inner, bs
            );
            if std::mem::len(array_get_element) > 0 {
                return array_get_element;
            }
            let try_callee = try ir_contract::body_call_callee_or_empty_from(
                ir_bytes, function_name, inner, value_sf
            );
            return try resolve_try_call_success_kizu_type(
                ir_bytes, module_prefix, try_callee
            );
        }
    }
    // 'let result_value = right_eval.next;' binds a struct-field read: the field's
    // declared kizu type resolves from the receiver's struct-field facts.
    if std::mem::equal_bytes(value_kind, "FieldExpr") {
        return try resolve_field_expr_kizu_type(
            ir_bytes, function_name, module_prefix, "", value, bs
        );
    }
    return error("compiled mir: unsupported local type value");
}

fn resolve_struct_literal_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    struct_literal_node: i64,
    bs: i64
) -> ![]u8 {
    return try resolve_struct_literal_kizu_type_from(
        ir_bytes, function_name, struct_literal_node, bs
    );
}

fn resolve_struct_literal_kizu_type_from(
    ir_bytes: []u8,
    function_name: []u8,
    struct_literal_node: i64,
    sf: i64
) -> ![]u8 {
    let type_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, struct_literal_node, "type", 0, sf
    );
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, type_node, sf);
}

// resolve_binary_kizu_type derives the kizu type of a binary expression bound to
// a let local: arithmetic operators yield i64, comparison/logical operators bool.
fn resolve_binary_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    binary_node: i64,
    bs: i64
) -> ![]u8 {
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, binary_node, bs
    );
    if std::mem::equal_bytes(op, "add") or std::mem::equal_bytes(op, "sub") or
        std::mem::equal_bytes(op, "mul") or std::mem::equal_bytes(op, "div") {
        return "i64";
    }
    return "bool";
}
