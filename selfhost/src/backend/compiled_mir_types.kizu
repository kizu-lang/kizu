import selfhost::backend::compiled_fact_lookup;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_type_lower;
import selfhost::backend::compiled_util;
import selfhost::backend::ir_contract;

pub struct FieldAccessInfo {
    pub receiver_kizu_type: []u8,
    pub receiver_llvm_type: []u8,
    pub field_index: i64,
    pub field_kizu_type: []u8,
    pub field_llvm_type: []u8,
}

pub fn resolve_value_llvm_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return param_type;
    }
    let kizu_type = try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
    return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, kizu_type);
}

pub fn resolve_value_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return try find_function_param_kizu_type(ir_bytes, function_name, name);
    }
    return try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
}

pub fn struct_lookup_kizu_type(kizu_type: []u8) -> []u8 {
    let len = std::mem::len(kizu_type);
    if len > 0 and kizu_type[0] == cast<u8>(33) {
        return struct_lookup_kizu_type(kizu_type[1..len]);
    }
    if len > 0 and kizu_type[0] == cast<u8>(38) {
        return struct_lookup_kizu_type(kizu_type[1..len]);
    }
    return kizu_type;
}

pub fn count_call_args(ir_bytes: []u8, function_name: []u8, call_node: i64, bs: i64) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, call_node, "arg", count, bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

// cross_module_callee_qualified_name_or_empty resolves an alias-qualified cross-module
// callee to its fully-qualified Kizu name by matching the real signature facts the
// compiled closures emit, so its signature resolves with an empty module prefix (issue
// 1165 / 1162). A call written through an import alias carries an embedded '::' but is not
// a std:: stdlib call; lookup_qualified_function_name_by_callee_suffix then finds the
// emitted function whose name ends with '::' + callee_name -- lexer::is_eof resolves to
// selfhost::lexer::is_eof and lexer::tokenize resolves to std::kizu::lexer::tokenize, each
// to whichever module actually carries it. Same-module calls (bare names, no '::') and
// stdlib calls return "" so they keep their normal resolution path; nothing is admitted by
// a handwritten alias table.
pub fn cross_module_callee_qualified_name_or_empty(
    ir_bytes: []u8,
    callee_name: []u8
) -> []u8 {
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return ir_bytes[0..0];
    }
    let colon = compiled_util::find_byte(callee_name, cast<u8>(58), 0);
    if colon >= std::mem::len(callee_name) {
        return ir_bytes[0..0];
    }
    return compiled_fact_lookup::lookup_qualified_function_name_by_callee_suffix(
        ir_bytes, callee_name
    );
}

pub fn lower_call_return_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        let ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
            ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified
        );
        if std::mem::len(ret_kizu) == 0 {
            return error("compiled mir: cross-module callee return type not found");
        }
        return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, ir_bytes[0..0], ret_kizu);
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        let stdlib_ret = try compiled_fact_lookup::lookup_stdlib_return(
            ir_bytes, callee_name
        );
        return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, stdlib_ret);
    }
    return try compiled_signature::resolve_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
}

fn resolve_try_call_success_kizu_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8
) -> ![]u8 {
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    var lookup_prefix = module_prefix;
    var lookup_name = callee_name;
    if std::mem::len(qualified) > 0 {
        lookup_prefix = ir_bytes[0..0];
        lookup_name = qualified;
    }
    var ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
        ir_bytes, "function-signature-return ", lookup_prefix, lookup_name
    );
    if std::mem::len(ret_kizu) == 0 and compiled_fact_lookup::is_stdlib_callee(callee_name) {
        ret_kizu = try compiled_fact_lookup::lookup_stdlib_return(ir_bytes, callee_name);
    }
    if std::mem::len(ret_kizu) == 0 {
        return error("compiled mir: local try-call return type not found");
    }
    if ret_kizu[0] != cast<u8>(33) {
        return error("compiled mir: local try-call callee must return an error union");
    }
    return ret_kizu[1..std::mem::len(ret_kizu)];
}

pub fn lower_call_module_prefix(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    // A resolved cross-module callee carries its own fully-qualified module path, so the
    // renderer mangles it from that module prefix (append_callee_symbol ->
    // derive_callee_llvm_symbol handles both selfhost:: and std::kizu:: owners) rather
    // than the caller's module prefix.
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        return compiled_util::module_prefix_of(qualified);
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return ir_bytes[0..0];
    }
    return module_prefix;
}

pub fn lower_call_callee_name(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    // Pair the resolved cross-module module prefix (above) with the callee's short name so
    // the renderer mangles the same fully-qualified symbol the owning closure emits.
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        let qualified_prefix = compiled_util::module_prefix_of(qualified);
        return qualified[std::mem::len(qualified_prefix)..std::mem::len(qualified)];
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        return try compiled_fact_lookup::lookup_stdlib_symbol(ir_bytes, callee_name);
    }
    return callee_name;
}

pub fn lower_call_arg_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_index: i64
) -> ![]u8 {
    let qualified = cross_module_callee_qualified_name_or_empty(ir_bytes, callee_name);
    if std::mem::len(qualified) > 0 {
        return try compiled_signature::resolve_call_arg_type(
            ir_bytes, ir_bytes[0..0], qualified, arg_index
        );
    }
    if compiled_fact_lookup::is_stdlib_callee(callee_name) {
        // Stdlib callees resolve argument types from trailing stdlib-symbol arg-type tokens:
        // one token is uniform for all args, multiple tokens are matched by index.
        return try compiled_fact_lookup::lookup_stdlib_arg_type(ir_bytes, callee_name, arg_index);
    }
    return try compiled_signature::resolve_call_arg_type(
        ir_bytes, module_prefix, callee_name, arg_index
    );
}

pub fn resolve_field_receiver_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64
) -> ![]u8 {
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver_node, bs
        );
        return try resolve_value_kizu_type(
            ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs
        );
    }
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return try resolve_field_expr_kizu_type(
            ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs
        );
    }
    if std::mem::equal_bytes(receiver_kind, "Call") {
        let callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, receiver_node, bs
        );
        if compiled_fact_lookup::is_stdlib_callee(callee) {
            return try compiled_fact_lookup::lookup_stdlib_return(ir_bytes, callee);
        }
        let ret_type = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
            ir_bytes, "function-signature-return ", module_prefix, callee
        );
        if std::mem::len(ret_type) == 0 {
            return error("compiled mir: call receiver return type not found");
        }
        return ret_type;
    }
    return error("compiled mir: unsupported field receiver type");
}

pub fn resolve_field_receiver_llvm_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64
) -> ![]u8 {
    let kizu_type = try resolve_field_receiver_kizu_type(
        ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs
    );
    return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, kizu_type);
}

pub fn resolve_field_expr_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> ![]u8 {
    let info = try resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
    );
    return info.field_kizu_type;
}

pub fn resolve_field_expr_index(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> !i64 {
    let info = try resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
    );
    return info.field_index;
}

pub fn resolve_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> !FieldAccessInfo {
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, bs
    );
    if !std::mem::equal_bytes(mode, "field") {
        return error("compiled mir: namespace field has no struct type");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, expr_node, "field", bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, bs
    );
    let receiver_kizu_type = try resolve_field_receiver_kizu_type(
        ir_bytes, function_name, module_prefix, params_spec, receiver, bs
    );
    let receiver_llvm_type = try compiled_type_lower::kizu_type_to_llvm(
        ir_bytes, module_prefix, receiver_kizu_type
    );
    let lookup_type = struct_lookup_kizu_type(receiver_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix(
        ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled function: struct field not found");
    }
    let field_llvm_type = try compiled_type_lower::kizu_type_to_llvm(
        ir_bytes, module_prefix, field.field_type
    );
    return FieldAccessInfo {
        receiver_kizu_type: receiver_kizu_type,
        receiver_llvm_type: receiver_llvm_type,
        field_index: field.index,
        field_kizu_type: field.field_type,
        field_llvm_type: field_llvm_type
    };
}

fn find_spec_llvm_type_or_empty(params_spec: []u8, name: []u8) -> []u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            let param_type = params_spec[pos..space_pos];
            let param_name = params_spec[space_pos + 1..entry_end];
            if std::mem::equal_bytes(param_name, name) {
                return param_type;
            }
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return params_spec[0..0];
}

// resolve_value_array_get_element_or_empty returns the element type T of a
// '<var>.get(<expr>)' call when <var> is a value-receiver std::array::Array<T>
// param/local, otherwise "" (issue 1165). It backs the let-binding type resolution for
// 'let next = try tokens.get(...)', whose callee is a field-mode method rather than a
// signature-bearing function.
fn resolve_value_array_get_element_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let callee_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, callee_node, bs);
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return "";
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, bs
    );
    if !std::mem::equal_bytes(mode, "field") {
        return "";
    }
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return "";
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, receiver_node, bs);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return "";
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kizu = try resolve_receiver_value_kizu_type(
        ir_bytes, function_name, module_prefix, receiver_name, bs
    );
    let lookup = struct_lookup_kizu_type(receiver_kizu);
    return array_value_element_kizu_type_or_empty(lookup);
}

// array_value_element_kizu_type_or_empty strips the std::array::Array<...> wrapper and
// returns the element type token, or "" when the type is not an Array<T> (issue 1165).
pub fn array_value_element_kizu_type_or_empty(kizu_type: []u8) -> []u8 {
    let prefix = "std::array::Array<";
    if !std::mem::starts_with(kizu_type, prefix) {
        return "";
    }
    let prefix_len = std::mem::len(prefix);
    let type_len = std::mem::len(kizu_type);
    if type_len <= prefix_len or kizu_type[type_len - 1] != cast<u8>(62) {
        return "";
    }
    return kizu_type[prefix_len..type_len - 1];
}

// resolve_receiver_value_kizu_type resolves a value receiver's kizu type whether it is a
// function parameter or a local binding (issue 1165). It is used where the call-site
// params_spec is not threaded (let-binding type resolution).
fn resolve_receiver_value_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param = try find_function_param_kizu_type_or_empty(ir_bytes, function_name, name);
    if std::mem::len(param) > 0 {
        return param;
    }
    return try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
}

fn find_function_param_kizu_type_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let fn_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + fn_len < byte_len {
        if compiled_util::is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let fn_start = index + prefix_len;
            let fn_end = fn_start + fn_len;
            if fn_end < byte_len and
                std::mem::equal_bytes(ir_bytes[fn_start..fn_end], function_name) and
                ir_bytes[fn_end] == cast<u8>(32) {
                let kizu_type = extract_param_kizu_type_from_line(
                    ir_bytes, fn_end + 1, name
                );
                if std::mem::len(kizu_type) > 0 {
                    return kizu_type;
                }
            }
        }
        index = compiled_util::find_line_end(ir_bytes, index) + 1;
    }
    return "";
}

fn find_function_param_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let fn_len = std::mem::len(function_name);
    var index = 0;
    while index + prefix_len + fn_len < byte_len {
        if compiled_util::is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let fn_start = index + prefix_len;
            let fn_end = fn_start + fn_len;
            if fn_end < byte_len and
                std::mem::equal_bytes(ir_bytes[fn_start..fn_end], function_name) and
                ir_bytes[fn_end] == cast<u8>(32) {
                let kizu_type = extract_param_kizu_type_from_line(
                    ir_bytes, fn_end + 1, name
                );
                if std::mem::len(kizu_type) > 0 {
                    return kizu_type;
                }
            }
        }
        index = compiled_util::find_line_end(ir_bytes, index) + 1;
    }
    return error("compiled mir: param kizu type not found");
}

fn extract_param_kizu_type_from_line(
    ir_bytes: []u8,
    entry_start: i64,
    name: []u8
) -> []u8 {
    let line_end = compiled_util::find_line_end(ir_bytes, entry_start);
    var pos = entry_start;
    while pos < line_end and ir_bytes[pos] != cast<u8>(32) {
        pos = pos + 1;
    }
    if pos >= line_end {
        return ir_bytes[0..0];
    }
    pos = pos + 1;
    let entry = ir_bytes[pos..line_end];
    let entry_len = std::mem::len(entry);
    let colon1 = compiled_util::find_byte(entry, cast<u8>(58), 0);
    if colon1 >= entry_len {
        return ir_bytes[0..0];
    }
    if !std::mem::equal_bytes(entry[0..colon1], name) {
        return ir_bytes[0..0];
    }
    let colon2 = compiled_util::find_byte(entry, cast<u8>(58), colon1 + 1);
    if colon2 >= entry_len {
        return ir_bytes[0..0];
    }
    return entry[colon2 + 1..entry_len];
}

fn resolve_local_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let found = try resolve_local_in_block_or_empty(
        ir_bytes, function_name, module_prefix, name, 0, bs
    );
    if std::mem::len(found) == 0 {
        return error("compiled mir: local type not found");
    }
    return found;
}
// resolve_local_in_block_or_empty scans one statement block for a let binding named
// 'name', descending into while bodies so a counter loop's body-local lets (e.g. the
// 'let byte = payload[index]' inside is_payload_supported) resolve like top-level
// ones. It returns the binding's kizu type, or "" when the name is not bound in this
// block or any nested while body (tracker 961). Every resolvable let value yields a
// non-empty type, so "" is an unambiguous not-found signal.
fn resolve_local_in_block_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    block_node: i64,
    bs: i64
) -> ![]u8 {
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, bs
        );
        if statement < 0 {
            return "";
        }
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let local_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(local_name, name) {
                return try resolve_let_value_kizu_type(
                    ir_bytes, function_name, module_prefix, statement, bs
                );
            }
        }
        if std::mem::equal_bytes(stmt_kind, "While") {
            let body_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "body", 0, bs
            );
            let nested = try resolve_local_in_block_or_empty(
                ir_bytes, function_name, module_prefix, name, body_node, bs
            );
            if std::mem::len(nested) > 0 {
                return nested;
            }
        }
        // An if-then (and its else) block can bind body-locals that later statements in the same
        // block read, the same way a while body can. The leading_imports sort branch at
        // selfhost/src/parser/format.kizu:28 opens 'if leading_imports.len() > 1 { let next_index
        // = ...; let last_import = try format_tokens.get(...); ... }', and the 'last_import.end'
        // field read resolves last_import's kizu type by re-scanning the body. Descend into the
        // then/else blocks (skipping an absent else) so those bindings resolve like while-body
        // ones; an else that is itself a nested 'if' or an empty block simply contributes no
        // statement to scan (issue 1199).
        if std::mem::equal_bytes(stmt_kind, "If") {
            let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "then", 0, bs
            );
            if then_node >= 0 {
                let then_nested = try resolve_local_in_block_or_empty(
                    ir_bytes, function_name, module_prefix, name, then_node, bs
                );
                if std::mem::len(then_nested) > 0 {
                    return then_nested;
                }
            }
            let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "else", 0, bs
            );
            if else_node >= 0 {
                let else_nested = try resolve_local_in_block_or_empty(
                    ir_bytes, function_name, module_prefix, name, else_node, bs
                );
                if std::mem::len(else_nested) > 0 {
                    return else_nested;
                }
            }
        }
        stmt_index = stmt_index + 1;
    }
    return "";
}
// resolve_let_value_kizu_type resolves the declared kizu type of a let binding from
// its initializer node.
fn resolve_let_value_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    statement: i64,
    bs: i64
) -> ![]u8 {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, value, bs
    );
    if std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        return try resolve_struct_literal_kizu_type(ir_bytes, function_name, value, bs);
    }
    if std::mem::equal_bytes(value_kind, "Call") {
        // A stdlib-namespaced constructor / helper bound to a let resolves its kizu
        // return type from the stdlib-symbol fact: 'var out = std::string::String(...)'
        // binds a std::string::String, i.e. the runtime-owned handle (issue 1165 slice
        // 1). This is checked ahead of the field-mode method shape below because a
        // namespaced callee (std::string::String) is itself a FieldExpr node and would
        // otherwise be mistaken for the Arena<T>.add method.
        let callee_name = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, value, bs
        );
        if compiled_fact_lookup::is_stdlib_callee(callee_name) {
            return try compiled_fact_lookup::lookup_stdlib_return(ir_bytes, callee_name);
        }
        // A Call whose callee is a field-mode method is the Arena<T>.add lowering
        // (self.<field>.add(...)); it binds the appended slot index, an i64 (tracker
        // 961). Ast.add_node's 'let raw = self.nodes.add(...)' is its first consumer.
        let callee_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "callee", 0, bs
        );
        let callee_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, callee_node, bs
        );
        if std::mem::equal_bytes(callee_kind, "FieldExpr") {
            return "i64";
        }
        let ret_type = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
            ir_bytes, "function-signature-return ", module_prefix, callee_name
        );
        if std::mem::len(ret_type) == 0 {
            return error("compiled mir: local call return type not found");
        }
        return ret_type;
    }
    if std::mem::equal_bytes(value_kind, "Binary") {
        return try resolve_binary_kizu_type(ir_bytes, function_name, value, bs);
    }
    // 'var index = import_index;' seeds a loop counter from a parameter (or an outer
    // local), so the bound local takes that referenced value's kizu type (issue 1165).
    // index_after_import's parameter-seeded induction variable is the first consumer.
    if std::mem::equal_bytes(value_kind, "Var") {
        let ref_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, value, bs
        );
        let param_type = try find_function_param_kizu_type_or_empty(
            ir_bytes, function_name, ref_name
        );
        if std::mem::len(param_type) > 0 {
            return param_type;
        }
        let local_type = try resolve_local_in_block_or_empty(
            ir_bytes, function_name, module_prefix, ref_name, 0, bs
        );
        if std::mem::len(local_type) > 0 {
            return local_type;
        }
        return error("compiled mir: var initializer name not found");
    }
    // A bare integer initializer (the 'var index = 0' loop counter) is an
    // i64; a cast carries its target type token directly; a single-element
    // index of a byte slice yields u8, matching the always-i8 IndexLoad the
    // expr lowering emits for path[i] (tracker 961).
    if std::mem::equal_bytes(value_kind, "Int") {
        return "i64";
    }
    if std::mem::equal_bytes(value_kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "type", 0, bs
        );
        return try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, bs
        );
    }
    if std::mem::equal_bytes(value_kind, "IndexExpr") {
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "end", 0, bs
        );
        let end_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, end_node, bs
        );
        if !std::mem::equal_bytes(end_kind, "Empty") {
            return "[]u8";
        }
        return "u8";
    }
    // 'let x = try <callee>(...)' (a node_count cluster let-try) binds the callee's unwrapped
    // success type: the callee returns '!T', so strip the leading '!' (tracker 961).
    if std::mem::equal_bytes(value_kind, "TryExpr") {
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "value", 0, bs
        );
        let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
        if std::mem::equal_bytes(inner_kind, "Call") {
            // 'let next = try tokens.get(<expr>)' on a value-receiver Array<T> binds the
            // element type T (issue 1165). The callee is a field-mode method whose Var
            // receiver resolves to std::array::Array<T>, so the bound local takes T; this is
            // checked ahead of the free-function callee lookup since 'tokens.get' is not a
            // signature-bearing function name.
            let array_get_element = try resolve_value_array_get_element_or_empty(
                ir_bytes, function_name, module_prefix, inner, bs
            );
            if std::mem::len(array_get_element) > 0 {
                return array_get_element;
            }
            let try_callee = try ir_contract::body_call_callee_or_empty_from(
                ir_bytes, function_name, inner, bs
            );
            return try resolve_try_call_success_kizu_type(
                ir_bytes, module_prefix, try_callee
            );
        }
    }
    return error("compiled mir: unsupported local type value");
}

fn resolve_struct_literal_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    struct_literal_node: i64,
    bs: i64
) -> ![]u8 {
    let type_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, struct_literal_node, "type", 0, bs
    );
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, type_node, bs);
}

// resolve_binary_kizu_type derives the kizu type of a binary expression bound to
// a let local: arithmetic operators yield i64, comparison/logical operators bool.
fn resolve_binary_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    binary_node: i64,
    bs: i64
) -> ![]u8 {
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, binary_node, bs
    );
    if std::mem::equal_bytes(op, "add") or std::mem::equal_bytes(op, "sub") or
        std::mem::equal_bytes(op, "mul") or std::mem::equal_bytes(op, "div") {
        return "i64";
    }
    return "bool";
}
