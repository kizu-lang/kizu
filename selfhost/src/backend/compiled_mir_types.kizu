pub fn builtin_return_spelling_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_identity: []u8
) -> ![]u8 {
    if try compiled_type_resolver::has_generic_constructor_abi(
        index, ir_bytes, canonical_identity
    ) {
        return canonical_identity;
    }
    let return_type = builtin_call_identity::free_runtime_return_type(
        canonical_identity
    );
    if std::mem::len(return_type) == 0 {
        return error("compiled function: free runtime return type not found");
    }
    return return_type;
}

pub fn gate_generic_constructor_return_without_legacy_fact() -> !void {
    let facts = "abi-repr std::array::Array %kizu.owned";
    var index = try ir_index::build(facts);
    defer index.deinit();
    print(try builtin_return_spelling_indexed(
        &index, facts, "std::array::Array<Item>"
    ));
    return;
}

pub fn gate_owned_constructor_local_uses_concrete_result() -> !void {
    let facts = "abi-repr std::map::Map %kizu.owned
owned-container-family std::map::Map map
body-node app::make 0 depth 0 kind Block span 0 20
body-edge app::make 0 statement 0 1
body-node app::make 1 depth 1 kind Let span 0 20
body-let app::make 1 values
body-edge app::make 1 name 0 2
body-node app::make 2 depth 2 kind Var span 0 6
body-token app::make 2 values
body-edge app::make 1 value 0 3
body-node app::make 3 depth 2 kind Call span 7 20
body-call app::make 3 std::map::Map<[]u8,bool> 1
body-call-target app::make 7 20 std::map::Map
body-call-owned-constructor app::make 7 20 map construct std::map::Map std::map::Map<[]u8,bool> 2 []u8 bool";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var cache = call_arg_type_cache();
    defer cache.deinit();
    try cache.local_binding_names.append("values");
    try cache.local_binding_statements.append(1);
    let local = try resolve_local_type_from_binding_index_cached(
        &index, &var cache, facts, "app::make", "app::", "values", 0
    );
    std::testing::expect_equal<[]u8>(
        "std::map::Map<[]u8,bool>", local.full_spelling
    );
    std::testing::expect_equal<[]u8>("std::map::Map", local.canonical_identity);
    return;
}

pub struct FieldAccessInfo {
    pub receiver_kizu_type: []u8,
    pub receiver_llvm_type: []u8,
    pub field_index: i64,
    pub field_kizu_type: []u8,
    pub field_llvm_type: []u8,
    pub field_full_spelling: []u8,
    pub field_canonical_identity: []u8,
    pub field_type_context: []u8,
}

fn missing_struct_field(
    function_name: []u8,
    receiver_type: []u8,
    field_name: []u8
) -> !FieldAccessInfo {
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled function: struct field not found: ");
    try message.append_bytes(function_name);
    try message.append_bytes(" receiver ");
    try message.append_bytes(receiver_type);
    try message.append_bytes(" field ");
    try message.append_bytes(field_name);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

pub struct LoweredCallInfo {
    pub return_llvm_type: []u8,
    pub module_prefix: []u8,
    pub callee_name: []u8,
}

// CallLoweringInfo is the single instance-scoped view consumed by MIR call lowering.
// It keeps the selected symbol and the concrete canonical call types on the same
// caller-instance lookup, so a call cannot accidentally combine a specialized
// callee with the unspecialized declaration signature.
pub struct CallLoweringInfo {
    pub return_llvm_type: []u8,
    pub module_prefix: []u8,
    pub callee_name: []u8,
    pub types: compiled_canonical_facts::ParsedCallTypeFact,
}

pub struct CallArgTypeCache {
    pub module_prefixes: std::array::Array<[]u8>,
    pub callee_names: std::array::Array<[]u8>,
    pub arg_counts: std::array::Array<i64>,
    pub type_starts: std::array::Array<i64>,
    pub types: std::array::Array<[]u8>,
    // node_line_starts is the per-function body-node position index (pillar A): node_line_starts[seq]
    // is the byte offset of this function's 'body-node <fn> <seq>' line in ir_bytes, built once at
    // lowering start by build_fn_node_index. fn_node_line_start reads it in O(1) instead of the
    // global index binary search. Empty (len 0) until built, in which case lookups fall back to bs.
    pub node_line_starts: std::array::Array<i64>,
    pub node_kinds: std::array::Array<[]u8>,
    pub edge_parents: std::array::Array<i64>,
    pub edge_names: std::array::Array<[]u8>,
    pub edge_ordinals: std::array::Array<i64>,
    pub edge_children: std::array::Array<i64>,
    pub edges_built: bool,
    // local_names / local_types is the per-function local-binding type cache (pillar B): local_types[i]
    // is the resolved kizu type of the let-bound local local_names[i]. resolve_local_kizu_type is a
    // deterministic function of (function, name) (it scans block 0 direct-first then nested, the
    // same order regardless of where the read sits), so memoizing it by name within this
    // per-function cache returns the byte-identical type while collapsing the repeated O(function)
    // body scans for a local referenced many times. Both slices borrow ir_bytes, which outlives the
    // cache.
    pub local_names: std::array::Array<[]u8>,
    pub local_types: std::array::Array<[]u8>,
    pub local_full_spellings: std::array::Array<[]u8>,
    pub local_canonical_identities: std::array::Array<[]u8>,
    pub local_llvm_types: std::array::Array<[]u8>,
    pub local_declaring_modules: std::array::Array<[]u8>,
    pub local_type_contexts: std::array::Array<[]u8>,
    // exact_local_names / exact_local_llvm_types records the ABI already selected while lowering
    // a let-bound expression from canonical call facts. Source-level local type reconstruction can
    // intentionally describe an error union as its success type plus returns_error; it must not
    // replace the concrete ABI of the value that was actually emitted. Reverse lookup preserves
    // the most recent binding when a source name is shadowed.
    pub exact_local_names: std::array::Array<[]u8>,
    pub exact_local_llvm_types: std::array::Array<[]u8>,
    // scoped_local_names and scoped_local_types form a stack of temporary lexical bindings
    // supplied by a
    // lowering construct whose bindings are not let statements. Match-arm
    // payloads are the first consumer. Reverse lookup preserves shadowing.
    pub scoped_local_names: std::array::Array<[]u8>,
    pub scoped_local_types: std::array::Array<[]u8>,
    pub scoped_local_modules: std::array::Array<[]u8>,
    pub local_binding_names: std::array::Array<[]u8>,
    pub local_binding_statements: std::array::Array<i64>,
    pub local_bindings_built: bool,
    pub field_expr_nodes: std::array::Array<i64>,
    pub field_receiver_kizu_types: std::array::Array<[]u8>,
    pub field_receiver_llvm_types: std::array::Array<[]u8>,
    pub field_indexes: std::array::Array<i64>,
    pub field_kizu_types: std::array::Array<[]u8>,
    pub field_llvm_types: std::array::Array<[]u8>,
    pub field_full_spellings: std::array::Array<[]u8>,
    pub field_canonical_identities: std::array::Array<[]u8>,
    pub field_type_contexts: std::array::Array<[]u8>,
    pub llvm_module_prefixes: std::array::Array<[]u8>,
    pub llvm_kizu_types: std::array::Array<[]u8>,
    pub llvm_types: std::array::Array<[]u8>,
    pub struct_field_types: std::array::Array<[]u8>,
    pub struct_field_names: std::array::Array<[]u8>,
    pub struct_field_indexes: std::array::Array<i64>,
    pub struct_field_kizu_types: std::array::Array<[]u8>,
    pub name_store: compiled_mir::MirNameStore,
    pub instance_id: i64,
    pub lookups: i64,
    pub hits: i64,
}

pub fn call_arg_type_cache() -> CallArgTypeCache {
    return CallArgTypeCache {
        module_prefixes: std::array::Array<[]u8>(std::mem::page_allocator()),
        callee_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        arg_counts: std::array::Array<i64>(std::mem::page_allocator()),
        type_starts: std::array::Array<i64>(std::mem::page_allocator()),
        types: std::array::Array<[]u8>(std::mem::page_allocator()),
        node_line_starts: std::array::Array<i64>(std::mem::page_allocator()),
        node_kinds: std::array::Array<[]u8>(std::mem::page_allocator()),
        edge_parents: std::array::Array<i64>(std::mem::page_allocator()),
        edge_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        edge_ordinals: std::array::Array<i64>(std::mem::page_allocator()),
        edge_children: std::array::Array<i64>(std::mem::page_allocator()),
        edges_built: false,
        local_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_full_spellings: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_canonical_identities: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_llvm_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_declaring_modules: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_type_contexts: std::array::Array<[]u8>(std::mem::page_allocator()),
        exact_local_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        exact_local_llvm_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        scoped_local_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        scoped_local_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        scoped_local_modules: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_binding_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        local_binding_statements: std::array::Array<i64>(std::mem::page_allocator()),
        local_bindings_built: false,
        field_expr_nodes: std::array::Array<i64>(std::mem::page_allocator()),
        field_receiver_kizu_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_receiver_llvm_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_indexes: std::array::Array<i64>(std::mem::page_allocator()),
        field_kizu_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_llvm_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_full_spellings: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_canonical_identities: std::array::Array<[]u8>(std::mem::page_allocator()),
        field_type_contexts: std::array::Array<[]u8>(std::mem::page_allocator()),
        llvm_module_prefixes: std::array::Array<[]u8>(std::mem::page_allocator()),
        llvm_kizu_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        llvm_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        struct_field_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        struct_field_names: std::array::Array<[]u8>(std::mem::page_allocator()),
        struct_field_indexes: std::array::Array<i64>(std::mem::page_allocator()),
        struct_field_kizu_types: std::array::Array<[]u8>(std::mem::page_allocator()),
        name_store: compiled_mir::mir_name_store(),
        instance_id: -1,
        lookups: 0,
        hits: 0
    };
}

impl CallArgTypeCache {
    fn deinit(self: CallArgTypeCache) -> void {
        // The name store is deliberately not released here: the names it owns are referenced by the
        // MirFunction this cache helped build, which its caller renders after the lowering has
        // returned and this cache is gone. See MirNameStore.
        self.struct_field_kizu_types.deinit();
        self.struct_field_indexes.deinit();
        self.struct_field_names.deinit();
        self.struct_field_types.deinit();
        self.llvm_types.deinit();
        self.llvm_kizu_types.deinit();
        self.llvm_module_prefixes.deinit();
        self.field_llvm_types.deinit();
        self.field_type_contexts.deinit();
        self.field_canonical_identities.deinit();
        self.field_full_spellings.deinit();
        self.field_kizu_types.deinit();
        self.field_indexes.deinit();
        self.field_receiver_llvm_types.deinit();
        self.field_receiver_kizu_types.deinit();
        self.field_expr_nodes.deinit();
        self.local_types.deinit();
        self.local_names.deinit();
        self.local_type_contexts.deinit();
        self.local_declaring_modules.deinit();
        self.local_llvm_types.deinit();
        self.exact_local_llvm_types.deinit();
        self.exact_local_names.deinit();
        self.local_canonical_identities.deinit();
        self.local_full_spellings.deinit();
        self.scoped_local_modules.deinit();
        self.scoped_local_types.deinit();
        self.scoped_local_names.deinit();
        self.local_binding_statements.deinit();
        self.local_binding_names.deinit();
        self.edge_children.deinit();
        self.edge_ordinals.deinit();
        self.edge_names.deinit();
        self.edge_parents.deinit();
        self.node_kinds.deinit();
        self.node_line_starts.deinit();
        self.types.deinit();
        self.type_starts.deinit();
        self.arg_counts.deinit();
        self.callee_names.deinit();
        self.module_prefixes.deinit();
    }
}

pub fn set_instance_context(
    cache: &var CallArgTypeCache,
    context: &compiled_instance_context::InstanceContext
) -> !void {
    if cache.instance_id >= 0 {
        return error("compiled mir instance context already initialized");
    }
    if context.found { cache.instance_id = context.instance_id; }
    return;
}

pub fn push_scoped_local_type(
    cache: &var CallArgTypeCache,
    name: []u8,
    kizu_type: []u8,
    declaring_module: []u8
) -> !void {
    try cache.scoped_local_names.append(name);
    try cache.scoped_local_types.append(kizu_type);
    try cache.scoped_local_modules.append(declaring_module);
    return;
}

pub fn pop_scoped_local_type(cache: &var CallArgTypeCache) -> !void {
    let _name = try cache.scoped_local_names.pop();
    let _kizu_type = try cache.scoped_local_types.pop();
    let _module = try cache.scoped_local_modules.pop();
    return;
}

fn scoped_local_type_or_empty(
    cache: &CallArgTypeCache,
    name: []u8
) -> []u8 {
    var index = cache.scoped_local_names.len();
    while index > 0 {
        index = index - 1;
        if std::mem::equal_bytes(cache.scoped_local_names.get_or_panic(index), name) {
            return cache.scoped_local_types.get_or_panic(index);
        }
    }
    return name[0..0];
}

fn scoped_local_module_or_empty(
    cache: &CallArgTypeCache,
    name: []u8
) -> []u8 {
    var index = cache.scoped_local_names.len();
    while index > 0 {
        index = index - 1;
        if std::mem::equal_bytes(cache.scoped_local_names.get_or_panic(index), name) {
            return cache.scoped_local_modules.get_or_panic(index);
        }
    }
    return name[0..0];
}

pub fn bind_exact_local_llvm_type(
    cache: &var CallArgTypeCache,
    name: []u8,
    llvm_type: []u8
) -> !void {
    if std::mem::len(name) == 0 or std::mem::len(llvm_type) == 0 {
        return error("compiled mir: exact local ABI binding must be concrete");
    }
    try cache.exact_local_names.append(name);
    try cache.exact_local_llvm_types.append(llvm_type);
    return;
}

fn exact_local_llvm_type_or_empty(
    cache: &CallArgTypeCache,
    name: []u8
) -> []u8 {
    var index = cache.exact_local_names.len();
    while index > 0 {
        index = index - 1;
        if std::mem::equal_bytes(cache.exact_local_names.get_or_panic(index), name) {
            return cache.exact_local_llvm_types.get_or_panic(index);
        }
    }
    return name[0..0];
}

// resolve_local_kizu_type_cached memoizes resolve_local_kizu_type by name in the per-function cache
// (pillar B). The result is a deterministic function of (function, name), so a cache hit returns the
// byte-identical type a fresh scan would; a miss does the one full body scan and records it. This
// turns O(references * function) local-type resolution into O(unique locals * function + references
// * unique locals).
pub fn resolve_local_kizu_type_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let resolved = try resolve_local_type_cached(
        index, cache, ir_bytes, function_name, module_prefix, name, bs
    );
    return resolved_value_kizu_type(&resolved);
}

pub fn resolve_local_type_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> !compiled_type_resolver::ResolvedType {
    var i = 0;
    while i < cache.local_names.len() {
        if std::mem::equal_bytes(cache.local_names.get_or_panic(i), name) {
            return compiled_type_resolver::ResolvedType {
                full_spelling: cache.local_full_spellings.get_or_panic(i),
                canonical_identity: cache.local_canonical_identities.get_or_panic(i),
                abi: cache.local_llvm_types.get_or_panic(i),
                declaring_module: cache.local_declaring_modules.get_or_panic(i),
                spelling_module: cache.local_type_contexts.get_or_panic(i)
            };
        }
        i = i + 1;
    }
    try ensure_local_binding_index(cache, ir_bytes, function_name, bs);
    return try resolve_local_type_from_binding_index_cached(
        index, cache, ir_bytes, function_name, module_prefix, name, bs
    );
}

fn resolve_local_type_from_binding_index_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    name: []u8,
    bs: i64
) -> !compiled_type_resolver::ResolvedType {
    var binding_index = 0;
    while binding_index < cache.local_binding_names.len() {
        if std::mem::equal_bytes(cache.local_binding_names.get_or_panic(binding_index), name) {
            let statement = cache.local_binding_statements.get_or_panic(binding_index);
            let statement_sf = fn_node_line_start(cache, statement, bs);
            let value = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "value", 0, statement_sf
            );
            let value_sf = fn_node_line_start(cache, value, bs);
            let found = try resolve_let_value_type_for_value_cached(
                index, cache, ir_bytes, function_name, module_prefix,
                value, value_sf, bs
            );
            try cache.local_names.append(name);
            try cache.local_types.append(resolved_value_kizu_type(&found));
            try cache.local_full_spellings.append(found.full_spelling);
            try cache.local_canonical_identities.append(found.canonical_identity);
            try cache.local_llvm_types.append(found.abi);
            try cache.local_declaring_modules.append(found.declaring_module);
            try cache.local_type_contexts.append(found.spelling_module);
            return found;
        }
        binding_index = binding_index + 1;
    }
    return local_resolved_type_not_found(name);
}

fn resolve_let_value_type_for_value_cached(
    index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    value: i64,
    value_sf: i64,
    bs: i64
) -> !compiled_type_resolver::ResolvedType {
    let value_kind = try fn_node_kind(
        cache, ir_bytes, function_name, value, value_sf
    );
    if std::mem::equal_bytes(value_kind, "FieldExpr") {
        let info = try resolve_field_expr_indexed_with_cache(
            index, ir_bytes, function_name, module_prefix, "", value, bs, cache
        );
        return resolved_type_from_field_access(info);
    }
    if std::mem::equal_bytes(value_kind, "Call") {
        return try resolve_let_call_value_type_indexed_cached(
            index, cache, ir_bytes, function_name, module_prefix, value, value_sf, bs
        );
    }
    if std::mem::equal_bytes(value_kind, "Var") {
        let ref_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, value, value_sf
        );
        return try resolve_value_type_indexed_cached(
            index, ir_bytes, function_name, module_prefix, "", ref_name, bs, cache
        );
    }
    if std::mem::equal_bytes(value_kind, "TryExpr") {
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "value", 0, value_sf
        );
        let inner_sf = fn_node_line_start(cache, inner, value_sf);
        let inner_kind = try fn_node_kind(
            cache, ir_bytes, function_name, inner, inner_sf
        );
        if std::mem::equal_bytes(inner_kind, "Call") {
            let element = try resolve_value_array_get_element_type_indexed_cached(
                index, cache, ir_bytes, function_name, module_prefix, inner, bs
            );
            if std::mem::len(element.full_spelling) > 0 { return element; }
            let try_callee = try ir_contract::body_call_callee_or_empty_from(
                ir_bytes, function_name, inner, inner_sf
            );
            let try_target = try compiled_type_resolver::call_target_indexed(
                index, ir_bytes, function_name, inner
            );
            let try_builtin = try compiled_type_resolver::call_builtin_indexed(
                index, ir_bytes, function_name, inner
            );
            if !try_target.found and try_builtin.found {
                if std::mem::len(try_builtin.canonical_identity) == 0 {
                    let callee_node = try ir_contract::body_child_sequence_from(
                        ir_bytes, function_name, inner, "callee", 0, inner_sf
                    );
                    let callee_sf = fn_node_line_start(
                        cache, callee_node, inner_sf
                    );
                    let receiver_node =
                        try ir_contract::body_child_sequence_from(
                            ir_bytes, function_name, callee_node, "receiver", 0,
                            callee_sf
                        );
                    let receiver_sf = fn_node_line_start(
                        cache, receiver_node, callee_sf
                    );
                    let receiver_kind = try fn_node_kind(
                        cache, ir_bytes, function_name, receiver_node,
                        receiver_sf
                    );
                    var receiver_spelling = ir_bytes[0..0];
                    if std::mem::equal_bytes(receiver_kind, "Var") {
                        let receiver_name =
                            try ir_contract::body_token_or_empty_from(
                                ir_bytes, function_name, receiver_node,
                                receiver_sf
                            );
                        let receiver_type =
                            try resolve_value_type_indexed_cached(
                                index, ir_bytes, function_name, module_prefix,
                                "", receiver_name, bs, cache
                            );
                        receiver_spelling = receiver_type.full_spelling;
                    } else {
                        if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
                            let receiver_info =
                                try resolve_field_expr_indexed_with_cache(
                                    index, ir_bytes, function_name,
                                    module_prefix, "", receiver_node, bs, cache
                                );
                            receiver_spelling =
                                receiver_info.field_full_spelling;
                        } else {
                            return error(
                                "compiled mir: builtin method receiver type unsupported"
                            );
                        }
                    }
                    let success_spelling =
                        try builtin_method_success_spelling(
                            try_builtin.operation, receiver_spelling
                        );
                    if std::mem::len(success_spelling) == 0 {
                        var message =
                            std::string::String(std::mem::page_allocator());
                        try message.append_bytes(
                            "compiled mir: empty builtin method success spelling: function "
                        );
                        try message.append_bytes(function_name);
                        try message.append_bytes(" operation ");
                        try message.append_bytes(try_builtin.operation);
                        try message.append_bytes(" receiver ");
                        try message.append_bytes(receiver_spelling);
                        let message_bytes = message.as_bytes();
                        return error(message_bytes);
                    }
                    return try compiled_type_resolver::resolve_type_indexed(
                        index, ir_bytes, module_prefix, success_spelling
                    );
                }
                let builtin_return = try builtin_return_spelling_indexed(
                    index, ir_bytes, try_builtin.canonical_identity
                );
                let return_len = std::mem::len(builtin_return);
                if return_len == 0 or builtin_return[0] != cast<u8>(33) {
                    return error("compiled mir: local try-call callee must return an error union");
                }
                return try compiled_type_resolver::resolve_type_indexed(
                    index, ir_bytes,
                    compiled_util::module_prefix_of(try_builtin.canonical_identity),
                    builtin_return[1..return_len]
                );
            }
            let resolved_function = try compiled_type_resolver::resolve_call_indexed(
                index, ir_bytes, function_name, inner
            );
            if !resolved_function.returns_error {
                return error("compiled mir: local try-call callee must return an error union");
            }
            return compiled_type_resolver::function_return_type(&resolved_function);
        }
    }
    let spelling = try resolve_let_value_kizu_type_for_value_cached(
        index, cache, ir_bytes, function_name, module_prefix, value, value_sf, bs
    );
    return try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, module_prefix, spelling
    );
}

fn ensure_local_binding_index(
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !void {
    if cache.local_bindings_built {
        return;
    }
    try collect_local_bindings_in_block(cache, ir_bytes, function_name, 0, bs);
    cache.local_bindings_built = true;
    return;
}

fn collect_local_bindings_in_block(
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !void {
    try collect_direct_local_bindings(cache, ir_bytes, function_name, block_node, bs);
    var scan_from = fn_node_line_start(cache, block_node, bs);
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, scan_from
        );
        if statement < 0 {
            return;
        }
        let sf = fn_node_line_start(cache, statement, bs);
        scan_from = sf;
        let stmt_kind = try fn_node_kind(cache, ir_bytes, function_name, statement, sf);
        if std::mem::equal_bytes(stmt_kind, "While") {
            let body_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "body", 0, sf
            );
            try collect_local_bindings_in_block(cache, ir_bytes, function_name, body_node, bs);
        }
        if std::mem::equal_bytes(stmt_kind, "If") {
            let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "then", 0, sf
            );
            if then_node >= 0 {
                try collect_local_bindings_in_block(cache, ir_bytes, function_name, then_node, bs);
            }
            let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "else", 0, sf
            );
            if else_node >= 0 {
                try collect_local_bindings_in_block(cache, ir_bytes, function_name, else_node, bs);
            }
        }
        stmt_index = stmt_index + 1;
    }
    return;
}

fn collect_direct_local_bindings(
    cache: &var CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !void {
    var scan_from = fn_node_line_start(cache, block_node, bs);
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, scan_from
        );
        if statement < 0 {
            return;
        }
        let sf = fn_node_line_start(cache, statement, bs);
        scan_from = sf;
        let stmt_kind = try fn_node_kind(cache, ir_bytes, function_name, statement, sf);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, sf
            );
            let local_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, sf
            );
            try cache.local_binding_names.append(local_name);
            try cache.local_binding_statements.append(statement);
        }
        stmt_index = stmt_index + 1;
    }
    return;
}

// build_fn_node_index populates cache.node_line_starts with the current function's body-node line
// offsets (pillar A). It is called once at function lowering start; every per-node structural lookup
// during that function's lowering then resolves its node->line offset through fn_node_line_start
// (O(1)) instead of the global index binary search (O(log total) with a full function-name compare
// per step). Byte-identical: the collected offsets equal body_node_line_start_for_sequence's.
pub fn build_fn_node_index(
    cache: &var CallArgTypeCache,
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let from = ir_index::body_node_facts_start(index, ir_bytes, function_name);
    try ir_contract::collect_body_node_line_starts(
        ir_bytes, function_name, from, &var cache.node_line_starts
    );
    var sequence = 0;
    while sequence < cache.node_line_starts.len() {
        let line_start = cache.node_line_starts.get_or_panic(sequence);
        if line_start < 0 {
            try cache.node_kinds.append(ir_bytes[0..0]);
        } else {
            try cache.node_kinds.append(
                try ir_contract::body_node_kind_from(ir_bytes, function_name, sequence, line_start)
            );
        }
        sequence = sequence + 1;
    }
    try build_fn_edge_index(cache, index, ir_bytes, function_name);
    return;
}

fn build_fn_edge_index(
    cache: &var CallArgTypeCache,
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let prefix = "body-edge ";
    var entry = ir_index::first_matching_entry(
        index, ir_bytes, prefix, ir_bytes[0..0], function_name
    );
    while entry >= 0 and
        ir_index::entry_matches_query(index, ir_bytes, entry, prefix, ir_bytes[0..0], function_name) {
        let name_end = ir_index::entry_key_end(index, entry);
        let parent_start = cache_skip_spaces(ir_bytes, name_end);
        let parent = try cache_parse_i64_token(ir_bytes, parent_start);
        let parent_end = cache_token_end(ir_bytes, parent_start);
        let edge_start = cache_skip_spaces(ir_bytes, parent_end);
        let edge_end = cache_token_end(ir_bytes, edge_start);
        let ordinal_start = cache_skip_spaces(ir_bytes, edge_end);
        let ordinal = try cache_parse_i64_token(ir_bytes, ordinal_start);
        let ordinal_end = cache_token_end(ir_bytes, ordinal_start);
        let child_start = cache_skip_spaces(ir_bytes, ordinal_end);
        let child = try cache_parse_i64_token(ir_bytes, child_start);
        try cache.edge_parents.append(parent);
        try cache.edge_names.append(ir_bytes[edge_start..edge_end]);
        try cache.edge_ordinals.append(ordinal);
        try cache.edge_children.append(child);
        entry = entry + 1;
    }
    cache.edges_built = true;
    return;
}

pub fn fn_body_child_sequence_from(
    cache: &CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64,
    from: i64
) -> !i64 {
    let child = try fn_body_child_sequence_or_minus_one_from(
        cache, ir_bytes, function_name, parent_sequence, edge, ordinal, from
    );
    if child >= 0 {
        return child;
    }
    return error("missing IR artifact fact: fn_body_child_sequence_from");
}

pub fn fn_body_child_sequence_or_minus_one_from(
    cache: &CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64,
    from: i64
) -> !i64 {
    if !cache.edges_built {
        return try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, parent_sequence, edge, ordinal, from
        );
    }
    var index = 0;
    let end = cache.edge_children.len();
    while index < end {
        if cache.edge_parents.get_or_panic(index) == parent_sequence and
            cache.edge_ordinals.get_or_panic(index) == ordinal and
            std::mem::equal_bytes(cache.edge_names.get_or_panic(index), edge) {
            return cache.edge_children.get_or_panic(index);
        }
        index = index + 1;
    }
    return -1;
}

pub fn fn_body_edge_count_from(
    cache: &CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    from: i64
) -> !i64 {
    if !cache.edges_built {
        return try ir_contract::body_edge_count_from(
            ir_bytes, function_name, parent_sequence, edge, from
        );
    }
    var count = 0;
    var index = 0;
    let end = cache.edge_children.len();
    while index < end {
        if cache.edge_parents.get_or_panic(index) == parent_sequence and
            std::mem::equal_bytes(cache.edge_names.get_or_panic(index), edge) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

fn cache_skip_spaces(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len and cache_is_space(bytes[index]) {
        index = index + 1;
    }
    return index;
}

fn cache_token_end(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len and !cache_is_space(bytes[index]) {
        index = index + 1;
    }
    return index;
}

fn cache_parse_i64_token(bytes: []u8, start: i64) -> !i64 {
    let byte_len = std::mem::len(bytes);
    if start >= byte_len {
        return error("invalid IR artifact fact");
    }
    var value = 0;
    var index = start;
    var found = false;
    while index < byte_len {
        let byte = bytes[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            break;
        }
        value = (value * 10) + cast<i64>(byte - cast<u8>(48));
        found = true;
        index = index + 1;
    }
    if !found {
        return error("invalid IR artifact fact");
    }
    if index < byte_len and !cache_is_space(bytes[index]) {
        return error("invalid IR artifact fact");
    }
    return value;
}

fn cache_is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(10) or byte == cast<u8>(13) or byte == cast<u8>(9);
}

// fn_node_line_start returns the current function's 'body-node <fn> <sequence>' line offset from
// the per-function index in O(1), or fallback (the function body start bs) when the index is not
// built or has no entry for sequence -- the same fallback body_node_line_start_for_sequence uses,
// so a downstream scan started here reads the byte-identical facts.
pub fn fn_node_line_start(cache: &CallArgTypeCache, sequence: i64, fallback: i64) -> i64 {
    if sequence < 0 or sequence >= cache.node_line_starts.len() {
        return fallback;
    }
    let offset = cache.node_line_starts.get_or_panic(sequence);
    if offset < 0 {
        return fallback;
    }
    return offset;
}

pub struct BodyNodeSpan {
    pub start: i64,
    pub end: i64,
}

// fn_call_span reads the exact Call body-node row selected by the per-function
// O(1) node index. Canonical call facts are keyed by source span, so falling
// back to a global scan here would defeat the parsed table's lookup contract.
pub fn fn_call_span(
    cache: &CallArgTypeCache, ir_bytes: []u8, sequence: i64
) -> !BodyNodeSpan {
    if sequence < 0 or sequence >= cache.node_line_starts.len() {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled mir: call node is absent from function index: node ");
        try std::fmt::append_i64(&var message, sequence);
        try message.append_bytes(" len ");
        try std::fmt::append_i64(&var message, cache.node_line_starts.len());
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let line_start = cache.node_line_starts.get_or_panic(sequence);
    if line_start < 0 { return error("compiled mir: call node line is missing"); }
    let span_label_start = cache_nth_token_start(ir_bytes, line_start, 7);
    let span_label_end = cache_token_end(ir_bytes, span_label_start);
    if !std::mem::equal_bytes(
        ir_bytes[span_label_start..span_label_end], "span"
    ) { return error("compiled mir: call node span contract invalid"); }
    let start_token = cache_skip_spaces(ir_bytes, span_label_end);
    let start = try cache_parse_i64_token(ir_bytes, start_token);
    let end_token = cache_skip_spaces(
        ir_bytes, cache_token_end(ir_bytes, start_token)
    );
    let end = try cache_parse_i64_token(ir_bytes, end_token);
    if start < 0 or end <= start {
        return error("compiled mir: call node span invalid");
    }
    return BodyNodeSpan { start: start, end: end };
}

fn cache_nth_token_start(bytes: []u8, line_start: i64, ordinal: i64) -> i64 {
    var cursor = line_start;
    var index = 0;
    while index < ordinal {
        cursor = cache_skip_spaces(bytes, cache_token_end(bytes, cursor));
        index = index + 1;
    }
    return cursor;
}

pub fn fn_node_kind(
    cache: &CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    fallback: i64
) -> ![]u8 {
    if sequence >= 0 and sequence < cache.node_kinds.len() {
        let kind = cache.node_kinds.get_or_panic(sequence);
        if std::mem::len(kind) > 0 {
            return kind;
        }
    }
    return try ir_contract::body_node_kind_from(ir_bytes, function_name, sequence, fallback);
}

pub fn kizu_type_to_llvm_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    kizu_type: []u8,
    cache: &var CallArgTypeCache
) -> ![]u8 {
    var cached_index = 0;
    while cached_index < cache.llvm_kizu_types.len() {
        if std::mem::equal_bytes(cache.llvm_module_prefixes.get_or_panic(cached_index), module_prefix) and
            std::mem::equal_bytes(cache.llvm_kizu_types.get_or_panic(cached_index), kizu_type) {
            return cache.llvm_types.get_or_panic(cached_index);
        }
        cached_index = cached_index + 1;
    }
    let llvm_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        index, ir_bytes, module_prefix, kizu_type
    );
    try cache.llvm_module_prefixes.append(module_prefix);
    try cache.llvm_kizu_types.append(kizu_type);
    try cache.llvm_types.append(llvm_type);
    return llvm_type;
}

pub fn lookup_struct_field_exact_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_struct_identity: []u8,
    field_name: []u8,
    cache: &var CallArgTypeCache
) -> !compiled_fact_lookup::StructFieldLookup {
    var cached_index = 0;
    while cached_index < cache.struct_field_types.len() {
        if std::mem::equal_bytes(
            cache.struct_field_types.get_or_panic(cached_index), canonical_struct_identity
        ) and
            std::mem::equal_bytes(cache.struct_field_names.get_or_panic(cached_index), field_name) {
            return compiled_fact_lookup::StructFieldLookup {
                found: true,
                index: cache.struct_field_indexes.get_or_panic(cached_index),
                field_type: cache.struct_field_kizu_types.get_or_panic(cached_index),
                canonical_struct_identity: canonical_struct_identity,
                declaring_module: compiled_util::module_prefix_of(
                    canonical_struct_identity
                )
            };
        }
        cached_index = cached_index + 1;
    }
    let field = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        index, ir_bytes, canonical_struct_identity, field_name
    );
    if field.found {
        try cache.struct_field_types.append(canonical_struct_identity);
        try cache.struct_field_names.append(field_name);
        try cache.struct_field_indexes.append(field.index);
        try cache.struct_field_kizu_types.append(field.field_type);
    }
    return field;
}

pub fn resolve_value_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return try find_function_param_kizu_type(ir_bytes, function_name, name);
    }
    // Callers without a threaded params_spec (struct-field reads in call-argument
    // position) still resolve parameters from the signature facts before falling
    // back to the let-binding scan.
    let fact_param = try find_function_param_kizu_type_or_empty(ir_bytes, function_name, name);
    if std::mem::len(fact_param) > 0 {
        return fact_param;
    }
    return try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
}

// resolve_value_llvm_type_indexed mirrors resolve_value_llvm_type but routes the type-llvm
// lowering through the sorted index. The params_spec and local (resolve_local_kizu_type)
// lookups are unchanged: the former scans the small caller-threaded spec string and the
// latter scans only the current function's body block, neither of which the index covers;
// only kizu_type_to_llvm's whole-IR type/enum scan becomes a binary search.
pub fn resolve_value_llvm_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return param_type;
    }
    let kizu_type = try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
    return try compiled_type_lower::kizu_type_to_llvm_indexed(index, ir_bytes, module_prefix, kizu_type);
}

// resolve_value_llvm_type_indexed_cached is resolve_value_llvm_type_indexed with the local-type
// resolution routed through the per-function cache (pillar B). Hot callers that thread a cache use this
// to collapse a local's repeated O(function) body scans; the result is byte-identical.
pub fn resolve_value_llvm_type_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64,
    cache: &var CallArgTypeCache
) -> ![]u8 {
    let scoped_type = scoped_local_type_or_empty(cache, name);
    if std::mem::len(scoped_type) > 0 {
        let scoped_module = scoped_local_module_or_empty(cache, name);
        return try compiled_type_lower::kizu_type_to_llvm_indexed(
            index, ir_bytes, scoped_module, scoped_type
        );
    }
    let exact_local_type = exact_local_llvm_type_or_empty(cache, name);
    if std::mem::len(exact_local_type) > 0 {
        return exact_local_type;
    }
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return param_type;
    }
    let kizu_type = try resolve_local_kizu_type_cached(
        index, cache, ir_bytes, function_name, module_prefix, name, bs
    );
    return try kizu_type_to_llvm_indexed_cached(index, ir_bytes, module_prefix, kizu_type, cache);
}

pub fn resolve_value_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64
) -> ![]u8 {
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        return try find_function_param_kizu_type_indexed(index, ir_bytes, function_name, name);
    }
    let fact_param = try find_function_param_kizu_type_or_empty_indexed(
        index, ir_bytes, function_name, name
    );
    if std::mem::len(fact_param) > 0 {
        return fact_param;
    }
    return try resolve_local_kizu_type(ir_bytes, function_name, module_prefix, name, bs);
}

// resolve_value_kizu_type_indexed_cached mirrors resolve_value_kizu_type_indexed with the
// local-type resolution routed through the per-function cache (pillar B); byte-identical.
pub fn resolve_value_kizu_type_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64,
    cache: &var CallArgTypeCache
) -> ![]u8 {
    let resolved = try resolve_value_type_indexed_cached(
        index, ir_bytes, function_name, module_prefix, params_spec, name, bs, cache
    );
    return resolved_value_kizu_type(&resolved);
}

pub fn resolve_value_type_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    name: []u8,
    bs: i64,
    cache: &var CallArgTypeCache
) -> !compiled_type_resolver::ResolvedType {
    let scoped_type = scoped_local_type_or_empty(cache, name);
    if std::mem::len(scoped_type) > 0 {
        let scoped_module = scoped_local_module_or_empty(cache, name);
        return try compiled_type_resolver::resolve_type_indexed(
            index, ir_bytes, scoped_module, scoped_type
        );
    }
    let param_type = find_spec_llvm_type_or_empty(params_spec, name);
    if std::mem::len(param_type) > 0 {
        let spelling = try find_function_param_kizu_type_indexed(
            index, ir_bytes, function_name, name
        );
        return try compiled_type_resolver::resolve_type_indexed(
            index, ir_bytes, module_prefix, spelling
        );
    }
    let fact_param = try find_function_param_kizu_type_or_empty_indexed(
        index, ir_bytes, function_name, name
    );
    if std::mem::len(fact_param) > 0 {
        return try compiled_type_resolver::resolve_type_indexed(
            index, ir_bytes, module_prefix, fact_param
        );
    }
    return try resolve_local_type_cached(
        index, cache, ir_bytes, function_name, module_prefix, name, bs
    );
}

pub fn struct_lookup_kizu_type(kizu_type: []u8) -> []u8 {
    let len = std::mem::len(kizu_type);
    if len > 0 and kizu_type[0] == cast<u8>(33) {
        return struct_lookup_kizu_type(kizu_type[1..len]);
    }
    if len > 0 and kizu_type[0] == cast<u8>(38) {
        return struct_lookup_kizu_type(kizu_type[1..len]);
    }
    // A '&var <T>' mutable borrow records its keyword as a 'var_' prefix once the
    // leading '&' is stripped; a mutable borrow shares its pointee's lookup type.
    if std::mem::starts_with(kizu_type, "var_") {
        return struct_lookup_kizu_type(kizu_type[4..len]);
    }
    return kizu_type;
}

pub fn count_call_args(ir_bytes: []u8, function_name: []u8, call_node: i64, bs: i64) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, call_node, "arg", count, bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

pub fn count_call_args_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    cache: &CallArgTypeCache
) -> !i64 {
    return try fn_body_edge_count_from(cache, ir_bytes, function_name, call_node, "arg", bs);
}

pub fn lower_call_return_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    var index = try ir_index::build(ir_bytes);
    defer index.deinit();
    return try lower_call_return_type_indexed(
        &index, ir_bytes, function_name, module_prefix, call_node, bs
    );
}

// lower_call_return_type_indexed mirrors lower_call_return_type, routing its signature/type
// probes through the sorted index. The cross-module suffix lookup still falls back to the
// linear resolver only for non-stdlib alias-qualified callees; std::kizu::* signature probes
// are index-backed.
pub fn lower_call_return_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    // cf tightens the structural callee read (the call's own 'body-call' detail) to the call
    // node's body-node line via the index; the detail fact sorts immediately after that line, so
    // a scan from cf reaches the byte-identical callee a scan from bs would. The return-type
    // resolution below is index-keyed (callee name + module), so it is unaffected by cf.
    let cf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, call_node, bs
    );
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let call_target = try compiled_type_resolver::call_target_indexed(
        index, ir_bytes, function_name, call_node
    );
    if call_target.found {
        let function = try compiled_type_resolver::resolve_call_indexed(
            index, ir_bytes, function_name, call_node
        );
        return try compiled_type_lower::kizu_type_to_llvm_indexed(
            index, ir_bytes, function.owner_module, function.return_spelling
        );
    }
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        index, ir_bytes, function_name, call_node
    );
    if builtin.found and std::mem::len(builtin.canonical_identity) > 0 {
        let builtin_ret = try builtin_return_spelling_indexed(
            index, ir_bytes, builtin.canonical_identity
        );
        return try compiled_type_lower::kizu_type_to_llvm_indexed(
            index, ir_bytes,
            compiled_util::module_prefix_of(builtin.canonical_identity), builtin_ret
        );
    }
    let array_get_element = try resolve_value_array_get_element_or_empty(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    if std::mem::len(array_get_element) > 0 {
        return try array_get_error_union_llvm_type_indexed(
            index, ir_bytes, module_prefix, array_get_element
        );
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes(
        "compiled mir: body call target not found [return-type]: function "
    );
    try message.append_bytes(function_name);
    try message.append_bytes(" callee ");
    try message.append_bytes(callee_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, call_node);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

pub fn lower_call_info_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64,
    cache: &var CallArgTypeCache
) -> !LoweredCallInfo {
    let cf = fn_node_line_start(cache, call_node, bs);
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let call_target = try compiled_type_resolver::call_target_indexed(
        index, ir_bytes, function_name, call_node
    );
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        index, ir_bytes, function_name, call_node
    );
    if !call_target.found and builtin.found {
        if std::mem::len(builtin.canonical_identity) == 0 {
            var message = std::string::String(std::mem::page_allocator());
            try message.append_bytes(
                "compiled mir: builtin call has no runtime identity [legacy-info]: function "
            );
            try message.append_bytes(function_name);
            try message.append_bytes(" callee ");
            try message.append_bytes(callee_name);
            try message.append_bytes(" node ");
            try std::fmt::append_i64(&var message, call_node);
            let message_bytes = message.as_bytes();
            return error(message_bytes);
        }
        let builtin_ret = try builtin_return_spelling_indexed(
            index, ir_bytes, builtin.canonical_identity
        );
        let return_llvm = try kizu_type_to_llvm_indexed_cached(
            index, ir_bytes, compiled_util::module_prefix_of(builtin.canonical_identity), builtin_ret, cache
        );
        let symbol = try builtin_contract::free_runtime_symbol(
            builtin.canonical_identity
        );
        return LoweredCallInfo {
            return_llvm_type: return_llvm,
            module_prefix: ir_bytes[0..0],
            callee_name: symbol
        };
    }
    let resolved_function = try compiled_type_resolver::resolve_call_indexed(
        index, ir_bytes, function_name, call_node
    );
    let return_llvm = try kizu_type_to_llvm_indexed_cached(
        index, ir_bytes, resolved_function.owner_module,
        resolved_function.return_spelling, cache
    );
    let owner_len = std::mem::len(resolved_function.owner_module);
    let identity_len = std::mem::len(resolved_function.canonical_identity);
    return LoweredCallInfo {
        return_llvm_type: return_llvm,
        module_prefix: resolved_function.owner_module,
        callee_name: resolved_function.canonical_identity[owner_len..identity_len]
    };
}

pub fn lower_call_module_prefix(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    var index = try ir_index::build(ir_bytes);
    defer index.deinit();
    return try lower_call_module_prefix_indexed(
        &index, ir_bytes, function_name, module_prefix, call_node, bs
    );
}

pub fn lower_call_module_prefix_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    return lower_call_module_prefix_for_instance_indexed(
        index, ir_bytes, -1, function_name, module_prefix, call_node, bs
    );
}

pub fn lower_call_module_prefix_for_instance_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    caller_instance_id: i64,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let instance =
        try compiled_type_resolver::call_instance_symbol_for_instance_indexed(
            index, ir_bytes, caller_instance_id, function_name, call_node
    );
    if instance.found { return ir_bytes[0..0]; }
    let cf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, call_node, bs
    );
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let target = try compiled_type_resolver::call_target_indexed(
        index, ir_bytes, function_name, call_node
    );
    if target.found {
        let function = try compiled_type_resolver::resolve_call_indexed(
            index, ir_bytes, function_name, call_node
        );
        return function.owner_module;
    }
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        index, ir_bytes, function_name, call_node
    );
    if builtin.found {
        return ir_bytes[0..0];
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes(
        "compiled mir: body call target not found [instance-module]: function "
    );
    try message.append_bytes(function_name);
    try message.append_bytes(" callee ");
    try message.append_bytes(callee_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, call_node);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

pub fn lower_call_callee_name(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    var index = try ir_index::build(ir_bytes);
    defer index.deinit();
    return try lower_call_callee_name_indexed(
        &index, ir_bytes, function_name, module_prefix, call_node, bs
    );
}

pub fn lower_call_callee_name_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    return lower_call_callee_name_for_instance_indexed(
        index, ir_bytes, -1, function_name, module_prefix, call_node, bs
    );
}

pub fn lower_call_callee_name_for_instance_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    caller_instance_id: i64,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let instance =
        try compiled_type_resolver::call_instance_symbol_for_instance_indexed(
            index, ir_bytes, caller_instance_id, function_name, call_node
    );
    if instance.found { return instance.canonical_identity; }
    let cf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, call_node, bs
    );
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let target = try compiled_type_resolver::call_target_indexed(
        index, ir_bytes, function_name, call_node
    );
    if target.found {
        let function = try compiled_type_resolver::resolve_call_indexed(
            index, ir_bytes, function_name, call_node
        );
        let owner_len = std::mem::len(function.owner_module);
        return function.canonical_identity[
            owner_len..std::mem::len(function.canonical_identity)
        ];
    }
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        index, ir_bytes, function_name, call_node
    );
    if builtin.found {
        if std::mem::len(builtin.canonical_identity) == 0 {
            var message = std::string::String(std::mem::page_allocator());
            try message.append_bytes(
                "compiled mir: builtin call has no runtime identity [instance-callee]: function "
            );
            try message.append_bytes(function_name);
            try message.append_bytes(" callee ");
            try message.append_bytes(callee_name);
            try message.append_bytes(" node ");
            try std::fmt::append_i64(&var message, call_node);
            let callee_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, call_node, "callee", 0, cf
            );
            let callee_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, callee_node, cf
            );
            try message.append_bytes(" callee-kind ");
            try message.append_bytes(callee_kind);
            if std::mem::equal_bytes(callee_kind, "FieldExpr") {
                let callee_mode = try ir_contract::sequence_fact_second_value_from(
                    ir_bytes, "body-field-expr ", function_name, callee_node, cf
                );
                try message.append_bytes(" callee-mode ");
                try message.append_bytes(callee_mode);
            }
            let message_bytes = message.as_bytes();
            return error(message_bytes);
        }
        return try builtin_contract::free_runtime_symbol(
            builtin.canonical_identity
        );
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes(
        "compiled mir: body call target not found [instance-callee]: function "
    );
    try message.append_bytes(function_name);
    try message.append_bytes(" callee ");
    try message.append_bytes(callee_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, call_node);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

pub fn lower_call_info_for_instance_indexed(
    index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64,
    cache: &CallArgTypeCache
) -> !CallLoweringInfo {
    let span = try fn_call_span(cache, ir_bytes, call_node);
    var types = compiled_canonical_facts::ParsedCallTypeFact {
        receiver_id: -1,
        result_id: -1,
        runtime_start: -1,
        runtime_len: 0,
        actual_start: -1,
        actual_len: 0
    };
    if cache.instance_id >= 0 {
        types = try compiled_canonical_facts::parsed_call_type_for_span_instance_id(
            canonical_facts, cache.instance_id, span.start, span.end
        );
    } else {
        types = try compiled_canonical_facts::parsed_call_type_for_span(
            canonical_facts, &function_name, span.start, span.end
        );
    }
    let return_llvm_type = try compiled_canonical_facts::parsed_canonical_runtime_abi(
        index, canonical_facts, ir_bytes, types.result_id
    );
    let callee_name = try lower_call_callee_name_for_instance_indexed(
        index, ir_bytes, cache.instance_id,
        function_name, module_prefix, call_node, bs
    );
    let owner_module = try lower_call_module_prefix_for_instance_indexed(
        index, ir_bytes, cache.instance_id,
        function_name, module_prefix, call_node, bs
    );
    return CallLoweringInfo {
        return_llvm_type: return_llvm_type,
        module_prefix: owner_module,
        callee_name: callee_name,
        types: types
    };
}

pub fn call_info_error_success_llvm(
    index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    info: &CallLoweringInfo
) -> ![]u8 {
    let success_id = try compiled_canonical_facts::parsed_canonical_error_success_child(
        canonical_facts, info.types.result_id
    );
    return compiled_canonical_facts::parsed_canonical_runtime_abi(
        index, canonical_facts, ir_bytes, success_id
    );
}

pub fn lower_call_arg_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_index: i64
) -> ![]u8 {
    var arg_types = try lower_call_arg_types(ir_bytes, module_prefix, callee_name, arg_index + 1);
    defer arg_types.deinit();
    return try arg_types.get(arg_index);
}

pub fn lower_call_arg_types(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    var index = try ir_index::build(ir_bytes);
    defer index.deinit();
    return try lower_call_arg_types_indexed(
        &index, ir_bytes, module_prefix, callee_name, arg_count
    );
}

pub fn lower_call_arg_types_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    if !(try compiled_type_resolver::has_source_function_indexed(
        index, ir_bytes, module_prefix, callee_name
    )) {
        return try lower_free_runtime_call_arg_types(
            index, ir_bytes, callee_name, arg_count
        );
    }
    let function = try compiled_type_resolver::resolve_function_indexed(
        index, ir_bytes, module_prefix, callee_name
    );
    return try lower_signature_call_arg_types_indexed(
        index, ir_bytes, ir_bytes[0..0], function.canonical_identity,
        function.owner_module, arg_count
    );
}

pub fn lower_call_arg_types_cached(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    arg_count: i64,
    ir_lookup_index: &ir_index::IrIndex,
    cache: &var CallArgTypeCache
) -> !std::array::Array<[]u8> {
    cache.lookups = cache.lookups + 1;
    var index = 0;
    while index < cache.arg_counts.len() {
        if (try cache.arg_counts.get(index)) == arg_count and
            std::mem::equal_bytes(try cache.module_prefixes.get(index), module_prefix) and
            std::mem::equal_bytes(try cache.callee_names.get(index), callee_name) {
            cache.hits = cache.hits + 1;
            return try copy_cached_call_arg_types(
                cache, try cache.type_starts.get(index), arg_count
            );
        }
        index = index + 1;
    }

    var types = try lower_call_arg_types_indexed(
        ir_lookup_index, ir_bytes, module_prefix, callee_name, arg_count
    );
    let type_start = cache.types.len();
    try append_cached_call_arg_types(cache, &types);
    try cache.module_prefixes.append(module_prefix);
    try cache.callee_names.append(callee_name);
    try cache.arg_counts.append(arg_count);
    try cache.type_starts.append(type_start);
    return types;
}

fn append_cached_call_arg_types(
    cache: &var CallArgTypeCache,
    types: &std::array::Array<[]u8>
) -> !void {
    var index = 0;
    while index < types.len() {
        try cache.types.append(try types.get(index));
        index = index + 1;
    }
    return;
}

fn copy_cached_call_arg_types(
    cache: &CallArgTypeCache,
    type_start: i64,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    var copied = std::array::Array<[]u8>(std::mem::page_allocator());
    var index = 0;
    while index < arg_count {
        try copied.append(try cache.types.get(type_start + index));
        index = index + 1;
    }
    return copied;
}

fn lower_signature_call_arg_types_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    lookup_prefix: []u8,
    callee_name: []u8,
    type_module_prefix: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    var types = std::array::Array<[]u8>(std::mem::page_allocator());
    let prefix = "function-signature-param ";
    var entry_index = ir_index::first_matching_entry(
        index, ir_bytes, prefix, lookup_prefix, callee_name
    );
    while arg_count > 0 and
        entry_index >= 0 and
        ir_index::entry_matches_query(
            index, ir_bytes, entry_index, prefix, lookup_prefix, callee_name
        ) and
        types.len() < arg_count {
        let key_end = ir_index::entry_key_end(index, entry_index);
        let line_end = ir_index::entry_line_end(index, entry_index);
        let line = ir_bytes[key_end..line_end];
        let entry_len = std::mem::len(line);
        let colon1 = compiled_util::find_byte(line, cast<u8>(58), 0);
        let colon2 = compiled_util::find_byte(line, cast<u8>(58), colon1 + 1);
        if colon2 >= entry_len {
            return error("compiled function: call arg type not found");
        }
        let kizu_type = line[colon2 + 1..entry_len];
        try types.append(
            try compiled_type_lower::kizu_type_to_llvm_indexed(
                index, ir_bytes, type_module_prefix, kizu_type
            )
        );
        entry_index = entry_index + 1;
    }
    let found_count = types.len();
    if found_count == arg_count {
        return types;
    }
    if std::mem::len(lookup_prefix) > 0 {
        return try lower_signature_call_arg_types_indexed(
            index, ir_bytes, ir_bytes[0..0], callee_name, type_module_prefix, arg_count
        );
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled function: call arg type not found: ");
    try message.append_bytes(callee_name);
    try message.append_bytes(" expected ");
    try std::fmt::append_i64(&var message, arg_count);
    try message.append_bytes(" got ");
    try std::fmt::append_i64(&var message, found_count);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

fn lower_free_runtime_call_arg_types(
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    callee_name: []u8,
    arg_count: i64
) -> !std::array::Array<[]u8> {
    let contract_arg_count = try builtin_contract::free_runtime_arg_count(callee_name);
    if contract_arg_count != arg_count {
        return error("compiled function: free runtime argument count mismatch");
    }
    var types = std::array::Array<[]u8>(std::mem::page_allocator());
    var arg_index = 0;
    while arg_index < arg_count {
        try types.append(
            try compiled_type_lower::kizu_type_to_llvm_indexed(
                lookup_index, ir_bytes, ir_bytes[0..0],
                try builtin_contract::free_runtime_arg_type(callee_name, arg_index)
            )
        );
        arg_index = arg_index + 1;
    }
    return types;
}

// resolve_field_receiver_kizu_type_indexed mirrors resolve_field_receiver_kizu_type but routes its
// whole-IR resolutions through the sorted index: a Var receiver resolves its param/local type via
// resolve_value_kizu_type_indexed (find_function_param_indexed), a nested FieldExpr receiver via
// resolve_field_expr_kizu_type_indexed, and a Call receiver's cross-module / signature-return
// reads via the indexed lookups. Byte-identical to the non-indexed resolver.
fn resolve_field_receiver_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64
) -> !compiled_type_resolver::ResolvedType {
    // rf tightens the receiver node's own structural reads (its kind / token / call-callee detail)
    // to its body-node line via the index; bs is kept for the Var-receiver value resolution, which
    // reads let/param facts that can precede this node. Byte-identical to a scan from bs.
    let rf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, rf
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver_node, rf
        );
        let value_type = try resolve_value_kizu_type_indexed(
            index, ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs
        );
        return try compiled_type_resolver::resolve_type_indexed(
            index, ir_bytes, module_prefix, value_type
        );
    }
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        let info = try resolve_field_expr_indexed(
            index, ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs
        );
        return compiled_type_resolver::ResolvedType {
            full_spelling: info.field_full_spelling,
            canonical_identity: info.field_canonical_identity,
            abi: info.field_llvm_type,
            declaring_module: compiled_util::module_prefix_of(
                info.field_canonical_identity
            ),
            spelling_module: info.field_type_context
        };
    }
    if std::mem::equal_bytes(receiver_kind, "Call") {
        let callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, receiver_node, rf
        );
        let target = try compiled_type_resolver::call_target_indexed(
            index, ir_bytes, function_name, receiver_node
        );
        let builtin = try compiled_type_resolver::call_builtin_indexed(
            index, ir_bytes, function_name, receiver_node
        );
        if !target.found and builtin.found {
            if std::mem::len(builtin.canonical_identity) == 0 {
                return error("compiled mir: field receiver builtin has no runtime identity");
            }
            let builtin_ret = try builtin_return_spelling_indexed(
                index, ir_bytes, builtin.canonical_identity
            );
            return try compiled_type_resolver::resolve_type_indexed(
                index, ir_bytes,
                compiled_util::module_prefix_of(builtin.canonical_identity), builtin_ret
            );
        }
        let resolved_function = try compiled_type_resolver::resolve_call_indexed(
            index, ir_bytes, function_name, receiver_node
        );
        return compiled_type_resolver::function_return_type(&resolved_function);
    }
    return error("compiled mir: unsupported field receiver type");
}

pub fn resolve_field_receiver_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64
) -> ![]u8 {
    let resolved = try resolve_field_receiver_type_indexed(
        index, ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs
    );
    return resolved_value_kizu_type(&resolved);
}

fn resolve_field_receiver_type_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64,
    cache: &var CallArgTypeCache
) -> !compiled_type_resolver::ResolvedType {
    let rf = fn_node_line_start(cache, receiver_node, bs);
    let receiver_kind = try fn_node_kind(cache, ir_bytes, function_name, receiver_node, rf);
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver_node, rf
        );
        return try resolve_value_type_indexed_cached(
            index, ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs, cache
        );
    }
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        let info = try resolve_field_expr_indexed_with_cache(
            index, ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs, cache
        );
        return compiled_type_resolver::ResolvedType {
            full_spelling: info.field_full_spelling,
            canonical_identity: info.field_canonical_identity,
            abi: info.field_llvm_type,
            declaring_module: compiled_util::module_prefix_of(
                info.field_canonical_identity
            ),
            spelling_module: info.field_type_context
        };
    }
    if std::mem::equal_bytes(receiver_kind, "Call") {
        let callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, receiver_node, rf
        );
        let target = try compiled_type_resolver::call_target_indexed(
            index, ir_bytes, function_name, receiver_node
        );
        let builtin = try compiled_type_resolver::call_builtin_indexed(
            index, ir_bytes, function_name, receiver_node
        );
        if !target.found and builtin.found {
            if std::mem::len(builtin.canonical_identity) == 0 {
                return error("compiled mir: field receiver builtin has no runtime identity");
            }
            let builtin_ret = try builtin_return_spelling_indexed(
                index, ir_bytes, builtin.canonical_identity
            );
            return try compiled_type_resolver::resolve_type_indexed(
                index, ir_bytes,
                compiled_util::module_prefix_of(builtin.canonical_identity), builtin_ret
            );
        }
        let resolved_function = try compiled_type_resolver::resolve_call_indexed(
            index, ir_bytes, function_name, receiver_node
        );
        return compiled_type_resolver::function_return_type(&resolved_function);
    }
    return error("compiled mir: unsupported field receiver type");
}

pub fn resolve_field_receiver_kizu_type_indexed_cached(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64,
    cache: &var CallArgTypeCache
) -> ![]u8 {
    let resolved = try resolve_field_receiver_type_indexed_cached(
        index, ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs, cache
    );
    return resolved_value_kizu_type(&resolved);
}

pub fn resolve_field_expr_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    bs: i64
) -> ![]u8 {
    let info = try resolve_field_expr_indexed(
        index, ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
    );
    return info.field_kizu_type;
}

fn resolved_value_kizu_type(
    resolved: &compiled_type_resolver::ResolvedType
) -> []u8 borrows resolved {
    // A generic value must retain its arguments for later element/payload logic.
    // Non-generic nominal values use the canonical identity so a subsequent field
    // access cannot accidentally resolve the bare name in the consumer module.
    let generic_start = compiled_util::find_byte(
        resolved.full_spelling, cast<u8>(60), 0
    );
    if generic_start < std::mem::len(resolved.full_spelling) {
        return resolved.full_spelling;
    }
    return resolved.canonical_identity;
}

fn resolved_type_from_field_access(
    info: FieldAccessInfo
) -> compiled_type_resolver::ResolvedType {
    return compiled_type_resolver::ResolvedType {
        full_spelling: info.field_full_spelling,
        canonical_identity: info.field_canonical_identity,
        abi: info.field_llvm_type,
        declaring_module: compiled_util::module_prefix_of(
            info.field_canonical_identity
        ),
        spelling_module: info.field_type_context
    };
}

// gate_external_struct_field_type_context pins the production resolution
// boundary without relying on AstData. alpha and beta intentionally declare the
// same short struct/field/child names. A beta consumer must resolve alpha::Holder
// fields against alpha, including a bare Child nested in Array<Child>.
pub fn gate_external_struct_field_type_context() -> !void {
    let facts = "type-llvm alpha::Holder %alpha.holder
type-llvm alpha::Container %alpha.container
type-llvm alpha::Child %alpha.child
type-llvm beta::Holder %beta.holder
type-llvm beta::Container %beta.container
type-llvm beta::Child %beta.child
abi-repr std::array::Array %kizu.owned
struct-field alpha::Holder 0 value Child
struct-field alpha::Container 0 items std::array::Array<Child>
struct-field beta::Holder 0 value Child
struct-field beta::Container 0 items std::array::Array<Child>
function-signature-param beta::consume 0 source:runtime:alpha::Container
body-node beta::consume 0 depth 0 kind Block span 0 10
body-edge beta::consume 0 statement 0 1
body-node beta::consume 1 depth 1 kind Let span 0 10
body-let beta::consume 1 items
body-edge beta::consume 1 name 0 2
body-node beta::consume 2 depth 2 kind Var span 0 5
body-token beta::consume 2 items
body-edge beta::consume 1 value 0 3
body-node beta::consume 3 depth 2 kind FieldExpr span 0 10
body-field-expr beta::consume 3 items field
body-edge beta::consume 3 receiver 0 4
body-node beta::consume 4 depth 3 kind Var span 0 6
body-token beta::consume 4 source
body-edge beta::consume 0 statement 1 5
body-node beta::consume 5 depth 1 kind Let span 11 20
body-let beta::consume 5 child
body-edge beta::consume 5 name 0 6
body-node beta::consume 6 depth 2 kind Var span 11 16
body-token beta::consume 6 child
body-edge beta::consume 5 value 0 7
body-node beta::consume 7 depth 2 kind TryExpr span 11 20
body-edge beta::consume 7 value 0 8
body-node beta::consume 8 depth 3 kind Call span 11 20
body-call beta::consume 8 items.get 1
body-edge beta::consume 8 callee 0 9
body-node beta::consume 9 depth 4 kind FieldExpr span 11 18
body-field-expr beta::consume 9 get field
body-edge beta::consume 9 receiver 0 10
body-node beta::consume 10 depth 5 kind Var span 11 16
body-token beta::consume 10 items
body-edge beta::consume 8 arg 0 11
body-node beta::consume 11 depth 4 kind Int span 19 20
body-int beta::consume 11 0";
    var index = try ir_index::build(facts);
    defer index.deinit();

    let holder = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "beta::", "alpha::Holder"
    );
    let value = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        &index, facts, holder.canonical_identity, "value"
    );
    if !value.found { return error("field context gate: value not found"); }
    let value_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, value.declaring_module, value.field_type
    );
    print(value_type.canonical_identity);
    print(value_type.abi);

    let container = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "beta::", "alpha::Container"
    );
    let items = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        &index, facts, container.canonical_identity, "items"
    );
    if !items.found { return error("field context gate: items not found"); }
    let items_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, items.declaring_module, items.field_type
    );
    print(items_type.full_spelling);
    print(items_type.spelling_module);
    let element = array_value_element_kizu_type_or_empty(items_type.full_spelling);
    let element_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, items_type.spelling_module, element
    );
    print(element_type.canonical_identity);
    print(element_type.abi);

    var cache = call_arg_type_cache();
    defer cache.deinit();
    // The interpreter gate seeds the same per-function binding index that
    // build_fn_node_index establishes in compiled lowering. This avoids making
    // the regression depend on the interpreter's unrelated &var field-assignment
    // limitation while still executing the production local ResolvedType cache.
    try cache.local_binding_names.append("items");
    try cache.local_binding_statements.append(1);
    try cache.local_binding_names.append("child");
    try cache.local_binding_statements.append(5);
    let _seed_items = try resolve_local_type_from_binding_index_cached(
        &index, &var cache, facts, "beta::consume", "beta::", "items", 0
    );
    let local_items = try resolve_receiver_value_type_indexed_cached(
        &index, &var cache, facts, "beta::consume", "beta::", "items", 0
    );
    let local_element = array_value_element_kizu_type_or_empty(
        local_items.full_spelling
    );
    let local_element_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, local_items.spelling_module, local_element
    );
    print(local_items.spelling_module);
    print(local_element_type.canonical_identity);
    print(local_element_type.abi);
    let _seed_child = try resolve_local_type_from_binding_index_cached(
        &index, &var cache, facts, "beta::consume", "beta::", "child", 0
    );
    let get_child = try resolve_receiver_value_type_indexed_cached(
        &index, &var cache, facts, "beta::consume", "beta::", "child", 0
    );
    print(get_child.canonical_identity);
    print(get_child.abi);
    return;
}

// A qualified free-function call must retain the callee's declaration context
// through let binding. alpha and beta intentionally declare the same Item;
// resolving the returned bare spelling in the consumer would select beta::Item.
pub fn gate_external_function_return_type_context() -> !void {
    let facts = "type-llvm alpha::Item %alpha.item
type-llvm beta::Item %beta.item
function-signature-return alpha::make Item
function-owner-module alpha::make alpha::
module-alias beta::consumer::a alpha::
body-node beta::consumer::consume 0 depth 0 kind Block span 0 10
body-edge beta::consumer::consume 0 statement 0 1
body-node beta::consumer::consume 1 depth 1 kind Let span 0 10
body-let beta::consumer::consume 1 item
body-edge beta::consumer::consume 1 name 0 2
body-node beta::consumer::consume 2 depth 2 kind Var span 0 4
body-token beta::consumer::consume 2 item
body-edge beta::consumer::consume 1 value 0 3
body-node beta::consumer::consume 3 depth 2 kind Call span 5 10
body-call beta::consumer::consume 3 a::make 0
body-call-target beta::consumer::consume 5 10 alpha::make
body-edge beta::consumer::consume 3 callee 0 4
body-node beta::consumer::consume 4 depth 3 kind FieldExpr span 5 10
body-field-expr beta::consumer::consume 4 make namespace";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let function = try compiled_type_resolver::resolve_function_indexed(
        &index, facts, "beta::consumer::", "a::make"
    );
    print(function.canonical_identity);
    print(function.owner_module);
    print(function.return_spelling);
    let return_type = compiled_type_resolver::function_return_type(&function);
    print(return_type.canonical_identity);
    print(return_type.abi);

    var cache = call_arg_type_cache();
    defer cache.deinit();
    let call_info = try lower_call_info_indexed_cached(
        &index, facts, "beta::consumer::consume", "beta::consumer::", 3, 0, &var cache
    );
    print(call_info.return_llvm_type);
    print(call_info.module_prefix);
    print(call_info.callee_name);
    try cache.local_binding_names.append("item");
    try cache.local_binding_statements.append(1);
    let local = try resolve_local_type_from_binding_index_cached(
        &index, &var cache, facts, "beta::consumer::consume",
        "beta::consumer::", "item", 0
    );
    print(local.canonical_identity);
    print(local.abi);
    print(local.spelling_module);
    return;
}

