        ir_lookup_index, ir_bytes, function_name, call_node, bs
    );
    defer arg_nodes.deinit();
    try require_contiguous_call_args(&arg_nodes);
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, module_prefix, callee_name, arg_nodes.len(),
        ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var arg_index = 0;
    var string_index = first_string_index;
    while arg_index < arg_nodes.len() {
        let arg_node = try arg_nodes.get(arg_index);
        let arg_type = try arg_types.get(arg_index);
        let arg = try lower_single_call_arg_with_aliases_cached(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node,
            string_index, alias_sources, alias_currents, bs, ir_lookup_index,
            call_arg_type_cache
        );
        let is_string_arg = arg.kind == compiled_mir::MirCallArgKind::String;
        var string_arg_count = 0;
        if is_string_arg {
            string_arg_count = 1;
        } else {
            if arg.kind == compiled_mir::MirCallArgKind::Call {
                string_arg_count = try count_string_args(&arg.call_args);
            }
        }
        try args.append(arg);
        string_index = string_index + string_arg_count;
        arg_index = arg_index + 1;
    }
