import selfhost::backend::compiled_mir;
import selfhost::backend::compiled_mir_types;
import selfhost::backend::compiled_util;
import selfhost::backend::ir_contract;
import selfhost::backend::ir_index;

// Shared call-argument lowering used by both statement lowering
// (compiled_mir_lower) and struct field lowering (compiled_mir_lower_struct).
// Extracting it here lets call-valued struct field initializers reuse the same
// arg lowering without an import cycle between the two lowering modules
// (tracker 961).
// lower_single_call_arg lowers one call argument into a MirCallArg
// descriptor. It is shared between lower_call_args (the inline statement/struct call
// path) and the nested-call expression path. A String argument seeds itself at string_index,
// so callers advance the shared string counter when the returned arg tree contains strings.
fn aliased_name_or_original(
    alias_sources: &std::array::Array<[]u8>,
    alias_currents: &std::array::Array<[]u8>,
    name: []u8
) -> ![]u8 {
    if std::mem::len(name) == 0 {
        return name;
    }
    if alias_sources.len() != alias_currents.len() {
        return error("compiled mir: call arg alias tables length mismatch");
    }
    var index = 0;
    while index < alias_sources.len() {
        let source = try alias_sources.get(index);
        if std::mem::equal_bytes(source, name) {
            return try alias_currents.get(index);
        }
        index = index + 1;
    }
    return name;
}

fn call_arg_nodes(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !std::array::Array<i64> {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "body-edge ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    var nodes = std::array::Array<i64>(std::mem::page_allocator());
    var index = bs;
    var seen = false;
    var done = false;
    while !done and index + prefix_len + name_len < byte_len {
        if compiled_util::is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if std::mem::equal_bytes(ir_bytes[name_start..name_end], function_name) and
                call_arg_is_space(ir_bytes[name_end]) {
                seen = true;
                try append_call_arg_node_from_line(ir_bytes, name_end, call_node, &var nodes);
            } else {
                if seen {
                    done = true;
                }
            }
        }
        if !done {
            index = compiled_util::find_line_end(ir_bytes, index) + 1;
        }
    }
    return nodes;
}

fn append_call_arg_node_from_line(
    ir_bytes: []u8,
    name_end: i64,
    call_node: i64,
    nodes: &var std::array::Array<i64>
) -> !void {
    let parent_start = call_arg_skip_spaces(ir_bytes, name_end);
    let parent = try call_arg_parse_i64_token(ir_bytes, parent_start);
    if parent != call_node {
        return;
    }

    let parent_end = call_arg_token_end(ir_bytes, parent_start);
    let edge_start = call_arg_skip_spaces(ir_bytes, parent_end);
    let edge_end = call_arg_token_end(ir_bytes, edge_start);
    if !std::mem::equal_bytes(ir_bytes[edge_start..edge_end], "arg") {
        return;
    }

    let ordinal_start = call_arg_skip_spaces(ir_bytes, edge_end);
    let ordinal = try call_arg_parse_i64_token(ir_bytes, ordinal_start);
    let ordinal_end = call_arg_token_end(ir_bytes, ordinal_start);
    let child_start = call_arg_skip_spaces(ir_bytes, ordinal_end);
    let child = try call_arg_parse_i64_token(ir_bytes, child_start);
    while nodes.len() <= ordinal {
        try nodes.append(-1);
    }
    if (try nodes.get(ordinal)) < 0 {
        try nodes.set(ordinal, child);
    }
    return;
}

fn require_contiguous_call_args(nodes: &std::array::Array<i64>) -> !void {
    var index = 0;
    while index < nodes.len() {
        if (try nodes.get(index)) < 0 {
            return error("compiled mir: missing call arg");
        }
        index = index + 1;
    }
    return;
}

fn call_arg_token_end(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len {
        let byte = bytes[index];
        if call_arg_is_space(byte) or byte == cast<u8>(10) or byte == cast<u8>(13) {
            return index;
        }
        index = index + 1;
    }
    return index;
}

fn call_arg_skip_spaces(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len and call_arg_is_space(bytes[index]) {
        index = index + 1;
    }
    return index;
}

fn call_arg_parse_i64_token(bytes: []u8, start: i64) -> !i64 {
    let byte_len = std::mem::len(bytes);
    if start >= byte_len {
        return error("invalid IR artifact fact");
    }
    var value = 0;
    var index = start;
    var found = false;
    while index < byte_len and call_arg_is_digit(bytes[index]) {
        value = (value * 10) + try call_arg_digit_value(bytes[index]);
        found = true;
        index = index + 1;
    }
    if !found {
        return error("invalid IR artifact fact");
    }
    if index < byte_len and
        !call_arg_is_space(bytes[index]) and
        bytes[index] != cast<u8>(10) and
        bytes[index] != cast<u8>(13) {
        return error("invalid IR artifact fact");
    }
    return value;
}

fn call_arg_is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9);
}

fn call_arg_is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}

fn call_arg_digit_value(byte: u8) -> !i64 {
    if byte >= cast<u8>(48) and byte <= cast<u8>(57) {
        return cast<i64>(byte - cast<u8>(48));
    }
    return error("invalid IR artifact fact");
}

pub fn lower_single_call_arg(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    string_index: i64,
    bs: i64
) -> !compiled_mir::MirCallArg {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if std::mem::equal_bytes(arg_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, bs
        );
        return compiled_mir::var_call_arg(arg_type, var_name);
    }
    if std::mem::equal_bytes(arg_kind, "Call") {
        let callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, arg_node, bs
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, arg_node, bs
        );
        let args = try lower_call_args(
            ir_bytes, function_name, module_prefix, params_spec, arg_node, string_index, bs
        );
        return compiled_mir::call_call_arg(arg_type, callee_module_prefix, callee_name, args);
    }
    if std::mem::equal_bytes(arg_kind, "FieldExpr") {
        return try lower_call_field_arg(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node, bs
        );
    }
    if std::mem::equal_bytes(arg_kind, "IndexExpr") {
        return try lower_call_index_arg(
            ir_bytes, function_name, arg_type, arg_node, bs
        );
    }
    if std::mem::equal_bytes(arg_kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, bs
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid call string token"
        );
        return compiled_mir::string_call_arg(arg_type, token, string_index);
    }
    if std::mem::equal_bytes(arg_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, bs
        );
        return compiled_mir::bool_call_arg(arg_type, std::mem::equal_bytes(token, "true"));
    }
    if std::mem::equal_bytes(arg_kind, "Int") {
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, arg_node, bs
        );
        return compiled_mir::int_literal_call_arg(arg_type, literal);
    }
    if std::mem::equal_bytes(arg_kind, "Binary") {
        return try lower_call_arith_arg(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node, bs
        );
    }
    if std::mem::equal_bytes(arg_kind, "Prefix") {
        // A '&'/'&var' borrow argument (e.g. '&format_tokens' at the leading_import_indices
        // call, issue 1165) shares its pointee's ABI representation: lower_call_arg_type maps
        // the parameter's '&std::array::Array<...>' through kizu_type_to_llvm, which strips the
        // borrow marker, so the resolved arg_type is already the pointee's LLVM type and a
        // borrowed value is passed exactly like the value it borrows. Unwrap the borrow to its
        // operand and lower that operand with the same arg_type; the borrow contributes no
        // inline descriptor of its own. Non-borrow prefixes ('not'/'neg') have no call-arg
        // representation here and fall through to the unsupported-kind error.
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, arg_node, bs
        );
        if std::mem::equal_bytes(op, "borrow") or std::mem::equal_bytes(op, "mut-borrow") {
            let operand_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arg_node, "right", 0, bs
            );
            return try lower_single_call_arg(
                ir_bytes, function_name, module_prefix, params_spec, arg_type, operand_node,
                string_index, bs
            );
        }
    }
    if std::mem::equal_bytes(arg_kind, "CastExpr") {
        // A checked integer cast 'cast<T>(<int literal>)' (e.g. 'cast<u8>(62)' in the parser's
        // is_single_token_byte byte comparisons) carries no inline descriptor of its own: the
        // resolved arg_type is already the parameter's target LLVM width, so the cast literal
        // lowers exactly like a plain Int argument of that width. Non-literal cast operands have
        // no inline call-arg form and fall through to the unsupported-kind error.
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arg_node, "value", 0, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value_node, bs);
        if std::mem::equal_bytes(value_kind, "Int") {
            let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, value_node, bs);
            return compiled_mir::int_literal_call_arg(arg_type, literal);
        }
    }
    return error("compiled mir: unsupported call arg kind");
}

pub fn lower_single_call_arg_with_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    string_index: i64,
    alias_sources: &std::array::Array<[]u8>,
    alias_currents: &std::array::Array<[]u8>,
    bs: i64
) -> !compiled_mir::MirCallArg {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if std::mem::equal_bytes(arg_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, bs
        );
        return compiled_mir::var_call_arg(
            arg_type, try aliased_name_or_original(alias_sources, alias_currents, var_name)
        );
    }
    if std::mem::equal_bytes(arg_kind, "Call") {
        let callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, arg_node, bs
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, arg_node, bs
        );
        let args = try lower_call_args_with_aliases(
            ir_bytes, function_name, module_prefix, params_spec, arg_node, string_index,
            alias_sources, alias_currents, bs
        );
        return compiled_mir::call_call_arg(arg_type, callee_module_prefix, callee_name, args);
    }
    if std::mem::equal_bytes(arg_kind, "FieldExpr") {
        return try lower_call_field_arg_with_aliases(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node,
            alias_sources, alias_currents, bs
        );
    }
    if std::mem::equal_bytes(arg_kind, "IndexExpr") {
        return try lower_call_index_arg_with_aliases(
            ir_bytes, function_name, arg_type, arg_node, alias_sources, alias_currents, bs
        );
    }
    if std::mem::equal_bytes(arg_kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, bs
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid call string token"
        );
        return compiled_mir::string_call_arg(arg_type, token, string_index);
    }
    if std::mem::equal_bytes(arg_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, bs
        );
        return compiled_mir::bool_call_arg(arg_type, std::mem::equal_bytes(token, "true"));
    }
    if std::mem::equal_bytes(arg_kind, "Int") {
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, arg_node, bs
        );
        return compiled_mir::int_literal_call_arg(arg_type, literal);
    }
    if std::mem::equal_bytes(arg_kind, "Binary") {
        return try lower_call_arith_arg_with_aliases(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node,
            alias_sources, alias_currents, bs
        );
    }
    if std::mem::equal_bytes(arg_kind, "Prefix") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, arg_node, bs
        );
        if std::mem::equal_bytes(op, "borrow") or std::mem::equal_bytes(op, "mut-borrow") {
            let operand_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arg_node, "right", 0, bs
            );
            return try lower_single_call_arg_with_aliases(
                ir_bytes, function_name, module_prefix, params_spec, arg_type, operand_node,
                string_index, alias_sources, alias_currents, bs
            );
        }
    }
    if std::mem::equal_bytes(arg_kind, "CastExpr") {
        // See lower_single_call_arg: a 'cast<T>(<int literal>)' argument lowers as a plain Int of
        // the already-resolved target width. Non-literal cast operands fall through to error.
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arg_node, "value", 0, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value_node, bs);
        if std::mem::equal_bytes(value_kind, "Int") {
            let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, value_node, bs);
            return compiled_mir::int_literal_call_arg(arg_type, literal);
        }
    }
    return error("compiled mir: unsupported call arg kind");
}

pub fn lower_call_args(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    first_string_index: i64,
    bs: i64
) -> !std::array::Array<compiled_mir::MirCallArg> {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    var arg_nodes = try call_arg_nodes(ir_bytes, function_name, call_node, bs);
    defer arg_nodes.deinit();
    try require_contiguous_call_args(&arg_nodes);
    var arg_types = try compiled_mir_types::lower_call_arg_types(
        ir_bytes, module_prefix, callee_name, arg_nodes.len()
    );
    defer arg_types.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var arg_index = 0;
    var string_index = first_string_index;
    while arg_index < arg_nodes.len() {
        let arg_node = try arg_nodes.get(arg_index);
        let arg_type = try arg_types.get(arg_index);
        let arg = try lower_single_call_arg(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node, string_index, bs
        );
        let is_string_arg = arg.kind == compiled_mir::MirCallArgKind::String;
        var string_arg_count = 0;
        if is_string_arg {
            string_arg_count = 1;
        } else {
            if arg.kind == compiled_mir::MirCallArgKind::Call {
                string_arg_count = try count_string_args(&arg.call_args);
            }
        }
        try args.append(arg);
        string_index = string_index + string_arg_count;
        arg_index = arg_index + 1;
    }
    return args;
}

pub fn lower_call_args_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    first_string_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !std::array::Array<compiled_mir::MirCallArg> {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    var arg_nodes = try call_arg_nodes(ir_bytes, function_name, call_node, bs);
    defer arg_nodes.deinit();
    try require_contiguous_call_args(&arg_nodes);
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, module_prefix, callee_name, arg_nodes.len(),
        ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var arg_index = 0;
    var string_index = first_string_index;
    while arg_index < arg_nodes.len() {
        let arg_node = try arg_nodes.get(arg_index);
        let arg_type = try arg_types.get(arg_index);
        let arg = try lower_single_call_arg(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node, string_index, bs
        );
        let is_string_arg = arg.kind == compiled_mir::MirCallArgKind::String;
        var string_arg_count = 0;
        if is_string_arg {
            string_arg_count = 1;
        } else {
            if arg.kind == compiled_mir::MirCallArgKind::Call {
                string_arg_count = try count_string_args(&arg.call_args);
            }
        }
        try args.append(arg);
        string_index = string_index + string_arg_count;
        arg_index = arg_index + 1;
    }
    return args;
}

