}

pub fn is_error_call(ir_bytes: []u8, function_name: []u8, call_node: i64, bs: i64) -> !bool {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    return std::mem::equal_bytes(callee_name, "error");
}
pub fn count_string_args(args: &std::array::Array<compiled_mir::MirCallArg>) -> !i64 {
    var count = 0;
    var index = 0;
    while index < args.len() {
        let arg = try args.at(index);
        if arg.kind == compiled_mir::MirCallArgKind::String {
            count = count + 1;
        } else {
            if arg.kind == compiled_mir::MirCallArgKind::Call {
                count = count + try count_string_args(&arg.call_args);
            }
        }
        index = index + 1;
    }
    return count;
}
// A SliceBound carries a static base register plus a constant offset. When the
// bound is a single-level field read off a Var receiver (FieldExpr, e.g.
// current.start), base holds the receiver register and field_index >= 0 names the
// field to extractvalue off source_type before adding offset; field_index == -1
// keeps the plain register/literal bound. This lets text[current.start..current.end]
// style slices lower their dynamic field-read bounds (frontier: parse_impl_decl
// token extraction).
struct SliceBound {
    base: []u8,
    offset: i64,
    source_type: []u8,
    field_index: i64,
}

fn slice_bound_field_read(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    node: i64,
    base: []u8,
    bs: i64
) -> !SliceBound {
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, receiver, bs);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: slice bound field receiver must be a var");
    }
    let field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, node, bs
    );
    return SliceBound {
        base: base,
        offset: 0,
        source_type: field.receiver_llvm_type,
        field_index: field.field_index
    };
}

fn lower_slice_bound(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    node: i64,
    bs: i64
) -> !SliceBound {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if std::mem::equal_bytes(kind, "Var") {
        let name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, node, bs);
        return SliceBound { base: name, offset: 0, source_type: "", field_index: -1 };
    }
    if std::mem::equal_bytes(kind, "Int") {
        let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, node, bs);
        return SliceBound { base: "", offset: literal, source_type: "", field_index: -1 };
    }
    if std::mem::equal_bytes(kind, "FieldExpr") {
        let receiver = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "receiver", 0, bs
        );
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver, bs
        );
        return try slice_bound_field_read(
            ir_bytes, function_name, module_prefix, params_spec, node, receiver_name, bs
        );
    }
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, node, bs
        );
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
        let right_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, right_node, bs
        );
        if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
            return error("compiled mir: unsupported slice bound shape");
        }
        let base = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, right_node, bs
        );
        if std::mem::equal_bytes(op, "add") {
            return SliceBound { base: base, offset: literal, source_type: "", field_index: -1 };
        }
        if std::mem::equal_bytes(op, "sub") {
            return SliceBound { base: base, offset: 0 - literal, source_type: "", field_index: -1 };
        }
        return error("compiled mir: unsupported slice bound op");
    }
    return error("compiled mir: unsupported slice bound kind");
}

fn lower_slice_bound_with_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    node: i64,
    alias_sources: &std::array::Array<[]u8>,
    alias_currents: &std::array::Array<[]u8>,
    bs: i64
) -> !SliceBound {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if std::mem::equal_bytes(kind, "Var") {
        let name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, node, bs);
        return SliceBound {
            base: try aliased_name_or_original(alias_sources, alias_currents, name),
            offset: 0,
            source_type: "",
            field_index: -1
        };
    }
    if std::mem::equal_bytes(kind, "Int") {
        let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, node, bs);
        return SliceBound { base: "", offset: literal, source_type: "", field_index: -1 };
    }
    if std::mem::equal_bytes(kind, "FieldExpr") {
        let receiver = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "receiver", 0, bs
        );
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver, bs
        );
        return try slice_bound_field_read(
            ir_bytes, function_name, module_prefix, params_spec, node,
            try aliased_name_or_original(alias_sources, alias_currents, receiver_name), bs
        );
    }
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, node, bs
        );
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
        let right_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, right_node, bs
        );
        if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
            return error("compiled mir: unsupported slice bound shape");
        }
        let base = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, right_node, bs
        );
        let aliased_base = try aliased_name_or_original(alias_sources, alias_currents, base);
        if std::mem::equal_bytes(op, "add") {
            return SliceBound { base: aliased_base, offset: literal, source_type: "", field_index: -1 };
        }
        if std::mem::equal_bytes(op, "sub") {
            return SliceBound {
                base: aliased_base, offset: 0 - literal, source_type: "", field_index: -1
            };
        }
        return error("compiled mir: unsupported slice bound op");
    }
    return error("compiled mir: unsupported slice bound kind");
}

fn lower_call_index_arg(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    bs: i64
) -> !compiled_mir::MirCallArg {
    let target_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, target_node, bs
    );
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: slice target must be a var");
    }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target_node, bs
    );
    let start_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "start", 0, bs
    );
    let end_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "end", 0, bs
    );
    let start_bound = try lower_slice_bound(
        ir_bytes, function_name, module_prefix, params_spec, start_node, bs
    );
    let end_bound = try lower_slice_bound(
        ir_bytes, function_name, module_prefix, params_spec, end_node, bs
    );
    return compiled_mir::slice_call_arg(
        arg_type,
        target_name,
        start_bound.base,
        start_bound.offset,
        start_bound.source_type,
        start_bound.field_index,
        end_bound.base,
        end_bound.offset,
        end_bound.source_type,
        end_bound.field_index
    );
}

fn lower_call_index_arg_with_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    alias_sources: &std::array::Array<[]u8>,
    alias_currents: &std::array::Array<[]u8>,
    bs: i64
) -> !compiled_mir::MirCallArg {
    let target_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, target_node, bs
    );
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: slice target must be a var");
    }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target_node, bs
    );
    let start_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "start", 0, bs
    );
    let end_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "end", 0, bs
    );
    let start_bound = try lower_slice_bound_with_aliases(
        ir_bytes, function_name, module_prefix, params_spec, start_node,
        alias_sources, alias_currents, bs
    );
    let end_bound = try lower_slice_bound_with_aliases(
        ir_bytes, function_name, module_prefix, params_spec, end_node,
        alias_sources, alias_currents, bs
    );
    return compiled_mir::slice_call_arg(
        arg_type,
        try aliased_name_or_original(alias_sources, alias_currents, target_name),
        start_bound.base,
        start_bound.offset,
        start_bound.source_type,
        start_bound.field_index,
        end_bound.base,
        end_bound.offset,
        end_bound.source_type,
        end_bound.field_index
    );
}

// lower_call_arith_arg lowers a 'Binary' call argument of the form '<base> +/- <int>'
// where the base is either a Var or a single-level FieldExpr (receiver.field) and the
// right operand is an integer literal. It backs the lexer's position(initial.line + 1,
// ...) calls (tracker 961, scope 4 prerequisite). Other binary shapes stay rejected.
fn lower_call_arith_arg(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    bs: i64
) -> !compiled_mir::MirCallArg {
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, arg_node, bs
    );
    var subtract = false;
    if std::mem::equal_bytes(op, "sub") {
        subtract = true;
    } else {
        if !std::mem::equal_bytes(op, "add") {
            return error("compiled mir: unsupported arith call arg op");
        }
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(right_kind, "Int") {
        return error("compiled mir: arith call arg right operand must be an int literal");
    }
    let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    if std::mem::equal_bytes(left_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, left_node, bs
        );
        return compiled_mir::arith_var_call_arg(arg_type, var_name, literal, subtract);
    }
    if !std::mem::equal_bytes(left_kind, "FieldExpr") {
        return error("compiled mir: arith call arg base must be a var or field access");
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, left_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, receiver, bs);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: arith call arg field receiver must be a var");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, bs
    );
    let field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, left_node, bs
    );
    return compiled_mir::arith_field_call_arg(
        arg_type, field.receiver_llvm_type, receiver_name, field.field_index, literal, subtract
    );
}

fn lower_call_arith_arg_with_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    alias_sources: &std::array::Array<[]u8>,
    alias_currents: &std::array::Array<[]u8>,
    bs: i64
) -> !compiled_mir::MirCallArg {
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, arg_node, bs
    );
    var subtract = false;
    if std::mem::equal_bytes(op, "sub") {
        subtract = true;
    } else {
        if !std::mem::equal_bytes(op, "add") {
            return error("compiled mir: unsupported arith call arg op");
        }
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(right_kind, "Int") {
        return error("compiled mir: arith call arg right operand must be an int literal");
    }
    let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    if std::mem::equal_bytes(left_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, left_node, bs
        );
        return compiled_mir::arith_var_call_arg(
            arg_type,
            try aliased_name_or_original(alias_sources, alias_currents, var_name),
            literal,
            subtract
        );
    }
    if !std::mem::equal_bytes(left_kind, "FieldExpr") {
        return error("compiled mir: arith call arg base must be a var or field access");
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, left_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, receiver, bs);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: arith call arg field receiver must be a var");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, bs
    );
    let field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, left_node, bs
    );
    return compiled_mir::arith_field_call_arg(
        arg_type,
        field.receiver_llvm_type,
        try aliased_name_or_original(alias_sources, alias_currents, receiver_name),
        field.field_index,
        literal,
        subtract
    );
}

fn lower_call_arith_arg_with_aliases_cached(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    alias_sources: &std::array::Array<[]u8>,
    alias_currents: &std::array::Array<[]u8>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirCallArg {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, arg_node, sf
    );
    var subtract = false;
    if std::mem::equal_bytes(op, "sub") {
        subtract = true;
    } else {
        if !std::mem::equal_bytes(op, "add") {
            return error("compiled mir: unsupported arith call arg op");
        }
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "left", 0, sf
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "right", 0, sf
    );
    let right_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, right_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, right_node, right_sf
    );
    if !std::mem::equal_bytes(right_kind, "Int") {
        return error("compiled mir: arith call arg right operand must be an int literal");
    }
    let literal = try ir_contract::body_int_value_from(
        ir_bytes, function_name, right_node, right_sf
    );
    let left_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, left_node, bs);
    let left_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, left_node, left_sf
    );
    if std::mem::equal_bytes(left_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, left_node, left_sf
        );
        return compiled_mir::arith_var_call_arg(
            arg_type,
            try aliased_name_or_original(alias_sources, alias_currents, var_name),
            literal,
            subtract
        );
    }
    if !std::mem::equal_bytes(left_kind, "FieldExpr") {
        return error("compiled mir: arith call arg base must be a var or field access");
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, left_node, "receiver", 0, left_sf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: arith call arg field receiver must be a var");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, receiver_sf
    );
    let field = try compiled_mir_types::resolve_var_receiver_field_expr_indexed_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        left_node, left_sf, receiver_name, bs, call_arg_type_cache
    );
    return compiled_mir::arith_field_call_arg(
        arg_type,
        field.receiver_llvm_type,
        try aliased_name_or_original(alias_sources, alias_currents, receiver_name),
        field.field_index,
        literal,
        subtract
    );
}

fn lower_call_field_arg(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    bs: i64
) -> !compiled_mir::MirCallArg {
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, bs
    );
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return try lower_nested_call_field_arg(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node, receiver, bs
        );
    }
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: call field arg receiver must be Var");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, bs
    );
    let field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, arg_node, bs
    );
    return compiled_mir::field_access_call_arg(
        arg_type, field.receiver_llvm_type, receiver_name, field.field_index
    );
}

