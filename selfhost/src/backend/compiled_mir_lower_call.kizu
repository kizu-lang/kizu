pub fn lower_call_args_with_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    first_string_index: i64,
    alias_sources: &std::array::Array<[]u8>,
    alias_currents: &std::array::Array<[]u8>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
