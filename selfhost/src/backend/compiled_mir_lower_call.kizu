fn lower_nested_call_field_arg_with_aliases_cached(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    receiver: i64,
    alias_sources: &std::array::Array<[]u8>,
    alias_currents: &std::array::Array<[]u8>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirCallArg {
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver, bs
    );
    let root_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, receiver, "receiver", 0, receiver_sf
    );
    let root_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, root_receiver, bs
    );
    let root_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, root_receiver, root_sf
    );
    if !std::mem::equal_bytes(root_kind, "Var") {
        return error("compiled mir: nested call field arg receiver must start with Var");
    }
    let root_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, root_receiver, root_sf
    );
    let first_field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        receiver, bs, call_arg_type_cache
    );
    let second_field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        arg_node, bs, call_arg_type_cache
    );
    return compiled_mir::nested_field_access_call_arg(
        arg_type,
        first_field.receiver_llvm_type,
        try aliased_name_or_original(alias_sources, alias_currents, root_name),
        first_field.field_index,
        first_field.field_llvm_type,
        second_field.field_index
    );
}
