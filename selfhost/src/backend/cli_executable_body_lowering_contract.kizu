import selfhost::backend::data;
import selfhost::backend::executable;
import selfhost::backend::ir_contract;

pub fn require(ir_bytes: []u8) -> !void {
    let run_function = "selfhost::backend::executable::lower_run_executable_ast";
    let test_function = "selfhost::backend::executable::lower_test_executable_ast";
    try require_cases(ir_bytes, run_function, false);
    try require_cases(ir_bytes, test_function, true);
    return;
}

fn case_count(ir_bytes: []u8, function_name: []u8) -> !i64 {
    try require_body_node_kind(ir_bytes, function_name, 0, "Block");

    let node_count = try ir_contract::body_node_count(ir_bytes, function_name);
    var ordinal = 0;
    var count = 0;
    while ordinal < node_count {
        let statement = try ir_contract::body_child_sequence_or_minus_one(
            ir_bytes,
            function_name,
            0,
            "statement",
            ordinal
        );
        if statement < 0 {
            if count > 0 {
                return count;
            }
            return error("missing selected body lowering cases");
        }

        let kind = try ir_contract::body_node_kind(ir_bytes, function_name, statement);
        if !std::mem::equal_bytes(kind, "If") {
            if count > 0 {
                return count;
            }
            return error("missing selected body lowering cases");
        }

        count = count + 1;
        ordinal = ordinal + 1;
    }
    return error("missing selected body lowering fallback");
}

fn case_ast_kind_name(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> ![]u8 borrows ir_bytes {
    let if_sequence = try lowering_case_if_sequence(ir_bytes, function_name, index);
    let condition = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        if_sequence,
        "condition",
        0
    );
    try require_body_node_kind(ir_bytes, function_name, condition, "Binary");
    try ir_contract::require_sequence_fact(ir_bytes, "body-binary ", function_name, condition, "eq");

    let left = try ir_contract::body_child_sequence(ir_bytes, function_name, condition, "left", 0);
    try require_field_expr(ir_bytes, function_name, left, "kind", "field");

    let right = try ir_contract::body_child_sequence(ir_bytes, function_name, condition, "right", 0);
    return try field_expr_name(ir_bytes, function_name, right, "namespace");
}

fn case_result_kind_name(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> ![]u8 {
    let if_sequence = try lowering_case_if_sequence(ir_bytes, function_name, index);
    let then_block = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        if_sequence,
        "then",
        0
    );
    try require_body_node_kind(ir_bytes, function_name, then_block, "Block");

    let statement = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        then_block,
        "statement",
        0
    );
    try require_body_node_kind(ir_bytes, function_name, statement, "Return");

    let value = try ir_contract::body_child_sequence(ir_bytes, function_name, statement, "value", 0);
    try require_body_node_kind(ir_bytes, function_name, value, "StructLiteralExpr");
    try ir_contract::require_sequence_fact(
        ir_bytes,
        "body-struct-literal ",
        function_name,
        value,
        "data::Executable"
    );
    return try struct_literal_kind_field(ir_bytes, function_name, value);
}

fn require_cases(ir_bytes: []u8, function_name: []u8, is_test: bool) -> !void {
    let count = try case_count(ir_bytes, function_name);
    let expected_count = expected_case_count(is_test);
    if count < 1 or count != expected_count {
        return error("missing selected body lowering cases");
    }

    var index = 0;
    while index < count {
        let ast_kind_name = try case_ast_kind_name(ir_bytes, function_name, index);
        let result_kind_name = try case_result_kind_name(ir_bytes, function_name, index);
        let actual_ast_kind = try data::executable_ast_kind_tag_by_name(ast_kind_name);
        let actual_result_kind = try data::executable_kind_tag_by_name(result_kind_name);
        let expected_ast_kind = try expected_case_ast_kind_tag(index, is_test);
        let expected_result_kind = try expected_case_result_kind_tag(index, is_test);
        if actual_ast_kind != expected_ast_kind or actual_result_kind != expected_result_kind {
            return error("invalid selected body lowering cases");
        }
        index = index + 1;
    }
    try require_unsupported_return(ir_bytes, function_name, count);
    return;
}

fn expected_case_count(is_test: bool) -> i64 {
    if is_test {
        return executable::test_executable_lowering_case_count();
    }
    return executable::run_executable_lowering_case_count();
}

fn expected_case_ast_kind_tag(index: i64, is_test: bool) -> !i64 {
    if is_test {
        return try executable::test_executable_lowering_case_ast_kind_tag(index);
    }
    return try executable::run_executable_lowering_case_ast_kind_tag(index);
}

fn expected_case_result_kind_tag(index: i64, is_test: bool) -> !i64 {
    if is_test {
        return try executable::test_executable_lowering_case_result_kind_tag(index);
    }
    return try executable::run_executable_lowering_case_result_kind_tag(index);
}

fn require_unsupported_return(
    ir_bytes: []u8,
    function_name: []u8,
    first_unsupported_ordinal: i64
) -> !void {
    let node_count = try ir_contract::body_node_count(ir_bytes, function_name);
    var ordinal = first_unsupported_ordinal;
    while ordinal < node_count {
        let statement = try ir_contract::body_child_sequence_or_minus_one(
            ir_bytes,
            function_name,
            0,
            "statement",
            ordinal
        );
        if statement < 0 {
            return error("missing selected body unsupported executable return");
        }
        if try return_calls_unsupported(ir_bytes, function_name, statement) {
            return;
        }
        ordinal = ordinal + 1;
    }
    return error("missing selected body unsupported executable return");
}

fn return_calls_unsupported(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64
) -> !bool {
    let statement_kind = try ir_contract::body_node_kind(ir_bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return false;
    }

    let value = try ir_contract::body_child_sequence(ir_bytes, function_name, statement, "value", 0);
    let value_kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "Call") {
        return false;
    }

    let callee = try ir_contract::sequence_fact_value(ir_bytes, "body-call ", function_name, value);
    return std::mem::equal_bytes(callee, "unsupported_executable");
}

fn lowering_case_if_sequence(ir_bytes: []u8, function_name: []u8, index: i64) -> !i64 {
    let statement = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        0,
        "statement",
        index
    );
    try require_body_node_kind(ir_bytes, function_name, statement, "If");
    return statement;
}

fn struct_literal_kind_field(
    ir_bytes: []u8,
    function_name: []u8,
    struct_literal: i64
) -> ![]u8 {
    let node_count = try ir_contract::body_node_count(ir_bytes, function_name);
    var ordinal = 0;
    while ordinal < node_count {
        let field = try ir_contract::body_child_sequence_or_minus_one(
            ir_bytes,
            function_name,
            struct_literal,
            "field",
            ordinal
        );
        if field < 0 {
            return error("missing selected body lowering result field");
        }
        let field_name = try ir_contract::sequence_fact_value(
            ir_bytes,
            "body-field-init ",
            function_name,
            field
        );
        if std::mem::equal_bytes(field_name, "kind") {
            let value = try ir_contract::body_child_sequence(
                ir_bytes,
                function_name,
                field,
                "value",
                0
            );
            return try result_kind_value_name(ir_bytes, function_name, value);
        }
        ordinal = ordinal + 1;
    }
    return error("missing selected body lowering result field");
}

fn result_kind_value_name(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64
) -> ![]u8 {
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if std::mem::equal_bytes(kind, "FieldExpr") {
        return try field_expr_name(ir_bytes, function_name, sequence, "namespace");
    }
    if std::mem::equal_bytes(kind, "Call") {
        let callee = try ir_contract::body_call_callee_or_empty(ir_bytes, function_name, sequence);
        return try result_kind_name_for_helper(callee);
    }
    return error("invalid selected body lowering body IR");
}

fn result_kind_name_for_helper(callee: []u8) -> ![]u8 {
    if std::mem::equal_bytes(callee, "run_print_executable_kind") {
        return "RunPrintString";
    }
    if std::mem::equal_bytes(callee, "run_return_executable_kind") {
        return "RunReturnVoid";
    }
    if std::mem::equal_bytes(callee, "test_ok_executable_kind") {
        return "TestExpectOk";
    }
    if std::mem::equal_bytes(callee, "test_failure_executable_kind") {
        return "TestExpectFailure";
    }
    return error("invalid selected body lowering body IR");
}

fn field_expr_name(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    mode: []u8
) -> ![]u8 borrows ir_bytes {
    try require_body_node_kind(ir_bytes, function_name, sequence, "FieldExpr");
    let name = try ir_contract::sequence_fact_value(
        ir_bytes,
        "body-field-expr ",
        function_name,
        sequence
    );
    let actual_mode = try ir_contract::sequence_fact_second_value(
        ir_bytes,
        "body-field-expr ",
        function_name,
        sequence
    );
    if !std::mem::equal_bytes(actual_mode, mode) {
        return error("unsupported selected body lowering field expression");
    }
    return name;
}

fn require_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    name: []u8,
    mode: []u8
) -> !void {
    let actual_name = try field_expr_name(ir_bytes, function_name, sequence, mode);
    if !std::mem::equal_bytes(actual_name, name) {
        return error("unsupported selected body lowering field expression");
    }
    return;
}

fn require_body_node_kind(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    expected: []u8
) -> !void {
    let actual = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if !std::mem::equal_bytes(actual, expected) {
        return error("invalid selected body lowering body IR");
    }
    return;
}
