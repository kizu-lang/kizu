import selfhost::backend::hosted;
import selfhost::backend::ir_contract;

pub fn append_globals(out: &var std::string::String) -> !void {
    let stdout_executable = hosted::run_print_executable();
    try append_llvm_constant_decoded(
        out,
        "hosted_stdout_prefix",
        llvm_c_decoded_len(hosted_stdout_prefix(stdout_executable.comment)),
        hosted_stdout_prefix(stdout_executable.comment)
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_stdout_len_middle",
        llvm_c_decoded_len(hosted_stdout_len_middle()),
        hosted_stdout_len_middle()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_stdout_payload_middle",
        llvm_c_decoded_len(hosted_stdout_payload_middle(stdout_executable.global)),
        hosted_stdout_payload_middle(stdout_executable.global)
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_stdout_slice_middle",
        llvm_c_decoded_len(hosted_stdout_slice_middle(stdout_executable.global)),
        hosted_stdout_slice_middle(stdout_executable.global)
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_stdout_suffix",
        llvm_c_decoded_len(hosted_stdout_suffix(stdout_executable.entry)),
        hosted_stdout_suffix(stdout_executable.entry)
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_fs_read_prefix",
        llvm_c_decoded_len(hosted_fs_read_prefix()),
        hosted_fs_read_prefix()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_fs_read_len_middle",
        llvm_c_decoded_len(hosted_fs_read_len_middle()),
        hosted_fs_read_len_middle()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_fs_read_payload_middle",
        llvm_c_decoded_len(hosted_fs_read_payload_middle()),
        hosted_fs_read_payload_middle()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_fs_read_slice_middle",
        llvm_c_decoded_len(hosted_fs_read_slice_middle()),
        hosted_fs_read_slice_middle()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_fs_read_before_slice_len",
        llvm_c_decoded_len(hosted_fs_read_before_slice_len()),
        hosted_fs_read_before_slice_len()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_fs_read_suffix",
        llvm_c_decoded_len(hosted_fs_read_suffix()),
        hosted_fs_read_suffix()
    );
    let return_executable = hosted::run_return_void_executable();
    try append_llvm_constant_decoded(
        out,
        "hosted_return_prefix",
        llvm_c_decoded_len(hosted_return_prefix(return_executable.comment)),
        hosted_return_prefix(return_executable.comment)
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_return_suffix",
        llvm_c_decoded_len(hosted_return_suffix(return_executable.entry)),
        hosted_return_suffix(return_executable.entry)
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_try_void_prefix",
        llvm_c_decoded_len(hosted_try_void_prefix()),
        hosted_try_void_prefix()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_try_void_len_middle",
        llvm_c_decoded_len(hosted_try_void_len_middle()),
        hosted_try_void_len_middle()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_try_void_payload_middle",
        llvm_c_decoded_len(hosted_try_void_payload_middle()),
        hosted_try_void_payload_middle()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_try_void_success_middle",
        llvm_c_decoded_len(hosted_try_void_success_middle()),
        hosted_try_void_success_middle()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_try_void_failure_middle",
        llvm_c_decoded_len(hosted_try_void_failure_middle()),
        hosted_try_void_failure_middle()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_try_void_suffix",
        llvm_c_decoded_len(hosted_try_void_suffix()),
        hosted_try_void_suffix()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_i64_prefix",
        llvm_c_decoded_len(hosted_i64_prefix()),
        hosted_i64_prefix()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_i64_after_source_before_op",
        llvm_c_decoded_len(hosted_i64_after_source_before_op()),
        hosted_i64_after_source_before_op()
    );
    try append_llvm_constant_decoded(out, "hosted_i64_op_add", 3, "add");
    try append_llvm_constant_decoded(out, "hosted_i64_op_sub", 3, "sub");
    try append_llvm_constant_decoded(out, "hosted_i64_op_mul", 3, "mul");
    try append_llvm_constant_decoded(out, "hosted_i64_op_div", 4, "sdiv");
    try append_llvm_constant_decoded(
        out,
        "hosted_i64_after_op_before_arg0",
        llvm_c_decoded_len(hosted_i64_after_op_before_arg0()),
        hosted_i64_after_op_before_arg0()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_i64_between_args",
        llvm_c_decoded_len(hosted_i64_between_args()),
        hosted_i64_between_args()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_i64_suffix",
        llvm_c_decoded_len(hosted_i64_suffix()),
        hosted_i64_suffix()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_loop_prefix",
        llvm_c_decoded_len(hosted_loop_prefix()),
        hosted_loop_prefix()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_loop_before_start",
        llvm_c_decoded_len(hosted_loop_before_start()),
        hosted_loop_before_start()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_loop_before_bound",
        llvm_c_decoded_len(hosted_loop_before_bound()),
        hosted_loop_before_bound()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_loop_before_continue",
        llvm_c_decoded_len(hosted_loop_before_continue()),
        hosted_loop_before_continue()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_loop_before_break",
        llvm_c_decoded_len(hosted_loop_before_break()),
        hosted_loop_before_break()
    );
    try append_llvm_constant_decoded(
        out,
        "hosted_loop_suffix",
        llvm_c_decoded_len(hosted_loop_suffix()),
        hosted_loop_suffix()
    );
    return;
}

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_write_stdout_ll_function(out);
    try append_write_return_void_ll_function(out);
    try append_write_try_void_ll_function(out);
    try append_write_i64_call_ll_function(out, ir_bytes);
    try append_write_loop_i64_ll_function(out);
    try append_write_fs_read_ll_function(out);
    return;
}

fn append_write_stdout_ll_function(out: &var std::string::String) -> !void {
    let stdout_executable = hosted::run_print_executable();
    let comment = stdout_executable.comment;
    let global = stdout_executable.global;
    let entry = stdout_executable.entry;
    try append_line(out, "define %kizu.error.void @kizu_selfhost__cli_hosted_write_stdout_ll(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %ll_path,");
    try append_line(out, "  %kizu.slice.u8 %source_path,");
    try append_line(out, "  %kizu.slice.u8 %output_len_text,");
    try append_line(out, "  %kizu.slice.u8 %encoded_payload");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "hosted_write", "prefix", "hosted_stdout_prefix", llvm_c_decoded_len(hosted_stdout_prefix(comment)));
    try append_global_slice(out, "hosted_write", "len_middle", "hosted_stdout_len_middle", llvm_c_decoded_len(hosted_stdout_len_middle()));
    try append_global_slice(out, "hosted_write", "payload_middle", "hosted_stdout_payload_middle", llvm_c_decoded_len(hosted_stdout_payload_middle(global)));
    try append_global_slice(out, "hosted_write", "slice_middle", "hosted_stdout_slice_middle", llvm_c_decoded_len(hosted_stdout_slice_middle(global)));
    try append_global_slice(out, "hosted_write", "suffix", "hosted_stdout_suffix", llvm_c_decoded_len(hosted_stdout_suffix(entry)));
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_selfhost__write_concat9(%kizu.owned %io, %kizu.slice.u8 %ll_path, %kizu.slice.u8 %hosted_write_prefix_slice, %kizu.slice.u8 %source_path, %kizu.slice.u8 %hosted_write_len_middle_slice, %kizu.slice.u8 %output_len_text, %kizu.slice.u8 %hosted_write_payload_middle_slice, %kizu.slice.u8 %encoded_payload, %kizu.slice.u8 %hosted_write_slice_middle_slice, %kizu.slice.u8 %output_len_text, %kizu.slice.u8 %hosted_write_suffix_slice)");
    try append_line(out, "  ret %kizu.error.void %write");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_return_void_ll_function(out: &var std::string::String) -> !void {
    let return_executable = hosted::run_return_void_executable();
    let comment = return_executable.comment;
    let entry = return_executable.entry;
    try append_line(out, "define %kizu.error.void @kizu_selfhost__cli_hosted_write_return_void_ll(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %ll_path,");
    try append_line(out, "  %kizu.slice.u8 %source_path");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "hosted_return", "prefix", "hosted_return_prefix", llvm_c_decoded_len(hosted_return_prefix(comment)));
    try append_global_slice(out, "hosted_return", "suffix", "hosted_return_suffix", llvm_c_decoded_len(hosted_return_suffix(entry)));
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_selfhost__write_concat3(%kizu.owned %io, %kizu.slice.u8 %ll_path, %kizu.slice.u8 %hosted_return_prefix_slice, %kizu.slice.u8 %source_path, %kizu.slice.u8 %hosted_return_suffix_slice)");
    try append_line(out, "  ret %kizu.error.void %write");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_fs_read_ll_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__cli_hosted_write_fs_read_ll(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %ll_path,");
    try append_line(out, "  %kizu.slice.u8 %source_path,");
    try append_line(out, "  %kizu.selfhost.codegen.program %program");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %path = extractvalue %kizu.selfhost.codegen.program %program, 8");
    try append_line(out,
        "  %encoded_result = call %kizu.error.slice.u8 @kizu_selfhost__cli_codegen_payload_llvm_c_string(%kizu.slice.u8 %path, i1 false)");
    try append_line(out, "  %encoded_ok = extractvalue %kizu.error.slice.u8 %encoded_result, 0");
    try append_line(out, "  br i1 %encoded_ok, label %build_len, label %failed");
    try append_line(out, "build_len:");
    try append_line(out, "  %encoded_path = extractvalue %kizu.error.slice.u8 %encoded_result, 1");
    try append_line(out, "  %path_len = extractvalue %kizu.slice.u8 %path, 1");
    try append_line(out, "  %path_len_result = call %kizu.error.slice.u8 @kizu_selfhost__i64_decimal(i64 %path_len)");
    try append_line(out, "  %path_len_ok = extractvalue %kizu.error.slice.u8 %path_len_result, 0");
    try append_line(out, "  br i1 %path_len_ok, label %write, label %failed");
    try append_line(out, "write:");
    try append_line(out, "  %path_len_text = extractvalue %kizu.error.slice.u8 %path_len_result, 1");
    try append_global_slice(out, "hosted_fs_read", "prefix", "hosted_fs_read_prefix", llvm_c_decoded_len(hosted_fs_read_prefix()));
    try append_global_slice(out, "hosted_fs_read", "len_middle", "hosted_fs_read_len_middle", llvm_c_decoded_len(hosted_fs_read_len_middle()));
    try append_global_slice(out, "hosted_fs_read", "payload_middle", "hosted_fs_read_payload_middle", llvm_c_decoded_len(hosted_fs_read_payload_middle()));
    try append_global_slice(out, "hosted_fs_read", "slice_middle", "hosted_fs_read_slice_middle", llvm_c_decoded_len(hosted_fs_read_slice_middle()));
    try append_global_slice(out, "hosted_fs_read", "before_slice_len", "hosted_fs_read_before_slice_len", llvm_c_decoded_len(hosted_fs_read_before_slice_len()));
    try append_global_slice(out, "hosted_fs_read", "suffix", "hosted_fs_read_suffix", llvm_c_decoded_len(hosted_fs_read_suffix()));
    try append_line(out,
        "  %write_result = call %kizu.error.void @kizu_selfhost__write_concat11(%kizu.owned %io, %kizu.slice.u8 %ll_path, %kizu.slice.u8 %hosted_fs_read_prefix_slice, %kizu.slice.u8 %source_path, %kizu.slice.u8 %hosted_fs_read_len_middle_slice, %kizu.slice.u8 %path_len_text, %kizu.slice.u8 %hosted_fs_read_payload_middle_slice, %kizu.slice.u8 %encoded_path, %kizu.slice.u8 %hosted_fs_read_slice_middle_slice, %kizu.slice.u8 %path_len_text, %kizu.slice.u8 %hosted_fs_read_before_slice_len_slice, %kizu.slice.u8 %path_len_text, %kizu.slice.u8 %hosted_fs_read_suffix_slice)");
    try append_line(out, "  ret %kizu.error.void %write_result");
    try append_line(out, "failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_try_void_ll_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__cli_hosted_write_try_void_ll(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %ll_path,");
    try append_line(out, "  %kizu.slice.u8 %source_path,");
    try append_line(out, "  %kizu.slice.u8 %output_len_text,");
    try append_line(out, "  %kizu.slice.u8 %encoded_payload,");
    try append_line(out, "  %kizu.selfhost.codegen.program %program");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %helper_exit_code = extractvalue %kizu.selfhost.codegen.program %program, 20");
    try append_line(out, "  %helper_success = icmp eq i64 %helper_exit_code, 0");
    try append_line(out, "  br i1 %helper_success, label %success_middle, label %check_failure_middle");
    try append_line(out, "check_failure_middle:");
    try append_line(out, "  %helper_failure = icmp eq i64 %helper_exit_code, 1");
    try append_line(out, "  br i1 %helper_failure, label %failure_middle, label %failed");
    try append_line(out, "success_middle:");
    try append_global_slice(out, "hosted_try_void", "success_middle", "hosted_try_void_success_middle", llvm_c_decoded_len(hosted_try_void_success_middle()));
    try append_line(out, "  br label %write");
    try append_line(out, "failure_middle:");
    try append_global_slice(out, "hosted_try_void", "failure_middle", "hosted_try_void_failure_middle", llvm_c_decoded_len(hosted_try_void_failure_middle()));
    try append_line(out, "  br label %write");
    try append_line(out, "write:");
    try append_line(out,
        "  %body_middle = phi %kizu.slice.u8 [ %hosted_try_void_success_middle_slice, %success_middle ], [ %hosted_try_void_failure_middle_slice, %failure_middle ]");
    try append_global_slice(out, "hosted_try_void", "prefix", "hosted_try_void_prefix", llvm_c_decoded_len(hosted_try_void_prefix()));
    try append_global_slice(out, "hosted_try_void", "len_middle", "hosted_try_void_len_middle", llvm_c_decoded_len(hosted_try_void_len_middle()));
    try append_global_slice(out, "hosted_try_void", "payload_middle", "hosted_try_void_payload_middle", llvm_c_decoded_len(hosted_try_void_payload_middle()));
    try append_global_slice(out, "hosted_try_void", "suffix", "hosted_try_void_suffix", llvm_c_decoded_len(hosted_try_void_suffix()));
    try append_line(out,
        "  %write_result = call %kizu.error.void @kizu_selfhost__write_concat9(%kizu.owned %io, %kizu.slice.u8 %ll_path, %kizu.slice.u8 %hosted_try_void_prefix_slice, %kizu.slice.u8 %source_path, %kizu.slice.u8 %hosted_try_void_len_middle_slice, %kizu.slice.u8 %output_len_text, %kizu.slice.u8 %hosted_try_void_payload_middle_slice, %kizu.slice.u8 %encoded_payload, %kizu.slice.u8 %body_middle, %kizu.slice.u8 %output_len_text, %kizu.slice.u8 %hosted_try_void_suffix_slice)");
    try append_line(out, "  ret %kizu.error.void %write_result");
    try append_line(out, "failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_i64_call_ll_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let add_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Add"
    );
    let sub_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Sub"
    );
    let mul_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Mul"
    );
    let div_tag = try ir_contract::enum_variant_tag(
        ir_bytes, "selfhost::ir::codegen::RunBinaryOp", "Div"
    );
    try append_line(out, "define %kizu.error.void @kizu_selfhost__cli_hosted_write_i64_call_ll(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %ll_path,");
    try append_line(out, "  %kizu.slice.u8 %source_path,");
    try append_line(out, "  %kizu.selfhost.codegen.program %program");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %op_tag = extractvalue %kizu.selfhost.codegen.program %program, 18");
    try append_op_tag_compare(out, "op_is_add", add_tag);
    try append_line(out, "  br i1 %op_is_add, label %op_add, label %check_sub");
    try append_line(out, "check_sub:");
    try append_op_tag_compare(out, "op_is_sub", sub_tag);
    try append_line(out, "  br i1 %op_is_sub, label %op_sub, label %check_mul");
    try append_line(out, "check_mul:");
    try append_op_tag_compare(out, "op_is_mul", mul_tag);
    try append_line(out, "  br i1 %op_is_mul, label %op_mul, label %check_div");
    try append_line(out, "check_div:");
    try append_op_tag_compare(out, "op_is_div", div_tag);
    try append_line(out, "  br i1 %op_is_div, label %op_div, label %failed");
    try append_line(out, "op_add:");
    try append_global_slice(out, "hosted_i64", "op_add", "hosted_i64_op_add", 3);
    try append_line(out, "  br label %op_ready");
    try append_line(out, "op_sub:");
    try append_global_slice(out, "hosted_i64", "op_sub", "hosted_i64_op_sub", 3);
    try append_line(out, "  br label %op_ready");
    try append_line(out, "op_mul:");
    try append_global_slice(out, "hosted_i64", "op_mul", "hosted_i64_op_mul", 3);
    try append_line(out, "  br label %op_ready");
    try append_line(out, "op_div:");
    try append_global_slice(out, "hosted_i64", "op_div", "hosted_i64_op_div", 4);
    try append_line(out, "  br label %op_ready");
    try append_line(out, "op_ready:");
    try append_line(out,
        "  %op_text = phi %kizu.slice.u8 [ %hosted_i64_op_add_slice, %op_add ], [ %hosted_i64_op_sub_slice, %op_sub ], [ %hosted_i64_op_mul_slice, %op_mul ], [ %hosted_i64_op_div_slice, %op_div ]");
    try append_line(out, "  %arg0 = extractvalue %kizu.selfhost.codegen.program %program, 20");
    try append_line(out, "  %arg0_result = call %kizu.error.slice.u8 @kizu_selfhost__i64_decimal(i64 %arg0)");
    try append_line(out, "  %arg0_ok = extractvalue %kizu.error.slice.u8 %arg0_result, 0");
    try append_line(out, "  br i1 %arg0_ok, label %arg1_decimal, label %failed");
    try append_line(out, "arg1_decimal:");
    try append_line(out, "  %arg0_text = extractvalue %kizu.error.slice.u8 %arg0_result, 1");
    try append_line(out, "  %arg1 = extractvalue %kizu.selfhost.codegen.program %program, 21");
    try append_line(out, "  %arg1_result = call %kizu.error.slice.u8 @kizu_selfhost__i64_decimal(i64 %arg1)");
    try append_line(out, "  %arg1_ok = extractvalue %kizu.error.slice.u8 %arg1_result, 0");
    try append_line(out, "  br i1 %arg1_ok, label %write, label %failed");
    try append_line(out, "write:");
    try append_line(out, "  %arg1_text = extractvalue %kizu.error.slice.u8 %arg1_result, 1");
    try append_global_slice(out, "hosted_i64", "prefix", "hosted_i64_prefix", llvm_c_decoded_len(hosted_i64_prefix()));
    try append_global_slice(out, "hosted_i64", "after_source", "hosted_i64_after_source_before_op", llvm_c_decoded_len(hosted_i64_after_source_before_op()));
    try append_global_slice(out, "hosted_i64", "after_op", "hosted_i64_after_op_before_arg0", llvm_c_decoded_len(hosted_i64_after_op_before_arg0()));
