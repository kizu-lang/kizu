pub fn token_end(bytes: []u8, start: i64, end: i64) -> i64 {
    var index = start;
    while index < end and bytes[index] != cast<u8>(32) and
        bytes[index] != cast<u8>(9) {
        index = index + 1;
    }
    return index;
}

pub fn skip_spaces(bytes: []u8, start: i64, end: i64) -> i64 {
    var index = start;
    while index < end and
        (bytes[index] == cast<u8>(32) or bytes[index] == cast<u8>(9)) {
        index = index + 1;
    }
    return index;
}

pub fn parse_nonnegative_i64(bytes: []u8, start: i64, end: i64) -> !i64 {
    if start >= end { return error("fact numeric token missing"); }
    var value = 0;
    var index = start;
    while index < end {
        let byte = bytes[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return error("fact numeric token invalid");
        }
        let digit = cast<i64>(byte - cast<u8>(48));
        if value > (9223372036854775807 - digit) / 10 {
            return error("fact numeric token overflow");
        }
        value = value * 10 + digit;
        index = index + 1;
    }
    return value;
}
