import selfhost::backend::ir_contract;
import selfhost::ir::external_abi_entrypoints;

// require_manifest_roots validates the complete external ABI boundary from the
// canonical manifest. A root is accepted only when its exact marker and semantic
// return type occur once. Runtime parameter facts must match the manifest's exact
// arity, contiguous slots, and ordered semantic type spellings.
pub fn require_manifest_roots(bytes: []u8) -> !void {
    let allocator = std::mem::page_allocator();
    var manifest = try external_abi_entrypoints::collect(allocator);
    defer manifest.deinit();
    let manifest_entries = &manifest.entrypoints;
    var index = 0;
    while index < external_abi_entrypoints::len(&manifest) {
        let entrypoint = try manifest_entries.at(index);
        try require_entrypoint(bytes, &entrypoint);
        index = index + 1;
    }
    if fact_prefix_line_count(bytes, "external-abi-entrypoint ") !=
        external_abi_entrypoints::len(&manifest) {
        return error("external ABI entrypoint root set mismatch");
    }
    return;
}

fn require_entrypoint(
    bytes: []u8,
    entrypoint: &external_abi_entrypoints::ExternalAbiEntrypoint
) -> !void {
    let allocator = std::mem::page_allocator();
    var qualified = std::string::String(allocator);
    defer qualified.deinit();
    try external_abi_entrypoints::append_qualified_name(&var qualified, entrypoint);
    return require_entrypoint_name(bytes, &qualified, entrypoint);
}

fn require_entrypoint_name(
    bytes: []u8,
    qualified: &std::string::String,
    entrypoint: &external_abi_entrypoints::ExternalAbiEntrypoint
) -> !void {
    var root_count = 0;
    var return_count = 0;
    var param_count = 0;
    let byte_len = std::mem::len(bytes);
    var line_start = 0;
    while line_start < byte_len {
        let line_end_pos = line_end(bytes, line_start);
        if line_is_exact_named_fact(
            bytes, line_start, line_end_pos, "external-abi-entrypoint ", qualified
        ) {
            root_count = root_count + 1;
        }
        if line_is_named_fact(
            bytes, line_start, line_end_pos, "function-signature-return ", qualified
        ) {
            let value_start = named_value_start(
                bytes,
                line_start,
                line_end_pos,
                "function-signature-return ",
                qualified
            );
            if !range_equals(
                bytes, value_start, line_end_pos, entrypoint.return_type
            ) {
                return error("external ABI entrypoint return type mismatch");
            }
            return_count = return_count + 1;
        }
        if line_is_named_fact(
            bytes, line_start, line_end_pos, "function-signature-param ", qualified
        ) {
            let sequence_start = named_value_start(
                bytes,
                line_start,
                line_end_pos,
                "function-signature-param ",
                qualified
            );
            let sequence_end = token_end(bytes, sequence_start, line_end_pos);
            let sequence = try parse_nonnegative_i64(bytes, sequence_start, sequence_end);
            if sequence >= try external_abi_entrypoints::param_count(entrypoint) {
                return error("external ABI entrypoint param arity mismatch");
            }
            let value_start = skip_spaces(bytes, sequence_end, line_end_pos);
            let expected_type = try external_abi_entrypoints::param_type_at(
                entrypoint, sequence
            );
            try require_param_signature(
                bytes, value_start, line_end_pos, expected_type
            );
            param_count = param_count + 1;
        }
        line_start = next_line_start(bytes, line_end_pos);
    }
    if root_count == 0 {
        return error("missing external ABI entrypoint root");
    }
    if root_count != 1 {
        return error("duplicate external ABI entrypoint root");
    }
    if return_count == 0 {
        return error("missing external ABI entrypoint return signature");
    }
    if return_count != 1 {
        return error("duplicate external ABI entrypoint return signature");
    }
    var slot = 0;
    let expected_param_count = try external_abi_entrypoints::param_count(entrypoint);
    while slot < expected_param_count {
        if try param_slot_count(bytes, qualified, slot) > 1 {
            return error("duplicate external ABI entrypoint param signature");
        }
        slot = slot + 1;
    }
    if param_count != expected_param_count {
        return error("external ABI entrypoint param arity mismatch");
    }
    return;
}

fn require_param_signature(
    bytes: []u8,
    start: i64,
    line_end_pos: i64,
    expected_type: []u8
) -> !void {
    let name_end = find_byte_in_range(bytes, cast<u8>(58), start, line_end_pos);
    if name_end <= start or name_end >= line_end_pos {
        return error("invalid external ABI entrypoint param signature");
    }
    let mode_start = name_end + 1;
    let mode_end = find_byte_in_range(bytes, cast<u8>(58), mode_start, line_end_pos);
    if !range_equals(bytes, mode_start, mode_end, "runtime") {
        return error("external ABI entrypoint param mode mismatch");
    }
    if !range_equals(bytes, mode_end + 1, line_end_pos, expected_type) {
        return error("external ABI entrypoint param type mismatch");
    }
    return;
}

fn param_slot_count(
    bytes: []u8,
    qualified: &std::string::String,
    wanted: i64
) -> !i64 {
    var count = 0;
    let byte_len = std::mem::len(bytes);
    var line_start = 0;
    while line_start < byte_len {
        let line_end_pos = line_end(bytes, line_start);
        if line_is_named_fact(
            bytes, line_start, line_end_pos, "function-signature-param ", qualified
        ) {
            let sequence_start = named_value_start(
                bytes,
                line_start,
                line_end_pos,
                "function-signature-param ",
                qualified
            );
            let sequence_end = token_end(bytes, sequence_start, line_end_pos);
            if try parse_nonnegative_i64(bytes, sequence_start, sequence_end) == wanted {
                count = count + 1;
            }
        }
        line_start = next_line_start(bytes, line_end_pos);
    }
    return count;
}

fn line_is_exact_named_fact(
    bytes: []u8,
    line_start: i64,
    line_end_pos: i64,
    prefix: []u8,
    name: &std::string::String
) -> bool {
    let prefix_len = std::mem::len(prefix);
    let name_len = name.len();
    if line_end_pos - line_start != prefix_len + name_len {
        return false;
    }
    return std::mem::equal_bytes(bytes[line_start..line_start + prefix_len], prefix) and
        string_equals_range(name, bytes, line_start + prefix_len, line_end_pos);
}

fn line_is_named_fact(
    bytes: []u8,
    line_start: i64,
    line_end_pos: i64,
    prefix: []u8,
    name: &std::string::String
) -> bool {
    let prefix_len = std::mem::len(prefix);
    let name_len = name.len();
    let name_start = line_start + prefix_len;
    let name_end = name_start + name_len;
    if name_end >= line_end_pos or line_start + prefix_len > line_end_pos {
        return false;
    }
    if !std::mem::equal_bytes(bytes[line_start..name_start], prefix) or
        !string_equals_range(name, bytes, name_start, name_end) {
        return false;
    }
    return is_space(bytes[name_end]);
}

fn named_value_start(
    bytes: []u8,
    line_start: i64,
    line_end_pos: i64,
    prefix: []u8,
    name: &std::string::String
) -> i64 {
    let value_start = line_start + std::mem::len(prefix) + name.len();
    return skip_spaces(bytes, value_start, line_end_pos);
}

fn string_equals_range(
    value: &std::string::String,
    bytes: []u8,
    start: i64,
    end: i64
) -> bool {
    if value.len() != end - start { return false; }
    var index = 0;
    while index < value.len() {
        if string_byte_at(value, index) != bytes[start + index] { return false; }
        index = index + 1;
    }
    return true;
}

fn string_byte_at(value: &std::string::String, index: i64) -> u8 {
    let bytes = value.as_bytes();
    return bytes[index];
}

fn range_equals(bytes: []u8, start: i64, end: i64, expected: []u8) -> bool {
    if start < 0 or end < start or end > std::mem::len(bytes) {
        return false;
    }
    return std::mem::equal_bytes(bytes[start..end], expected);
}

fn find_byte_in_range(bytes: []u8, wanted: u8, start: i64, end: i64) -> i64 {
    var index = start;
    while index < end {
        if bytes[index] == wanted { return index; }
        index = index + 1;
    }
    return end;
}

fn fact_prefix_line_count(bytes: []u8, prefix: []u8) -> i64 {
    let byte_len = std::mem::len(bytes);
    let prefix_len = std::mem::len(prefix);
    var count = 0;
    var line_start = 0;
    while line_start < byte_len {
        let line_end_pos = line_end(bytes, line_start);
        if line_end_pos - line_start > prefix_len and
            std::mem::equal_bytes(bytes[line_start..line_start + prefix_len], prefix) {
            count = count + 1;
        }
        line_start = next_line_start(bytes, line_end_pos);
    }
    return count;
}

fn parse_nonnegative_i64(bytes: []u8, start: i64, end: i64) -> !i64 {
    if start >= end {
        return error("invalid external ABI entrypoint param sequence");
    }
    var value = 0;
    var index = start;
    while index < end {
        let byte = bytes[index];
        if byte < cast<u8>(48) or byte > cast<u8>(57) {
            return error("invalid external ABI entrypoint param sequence");
        }
        value = value * 10 + cast<i64>(byte - cast<u8>(48));
        index = index + 1;
    }
    return value;
}

fn line_end(bytes: []u8, start: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = start;
    while index < byte_len and bytes[index] != cast<u8>(10) and bytes[index] != cast<u8>(13) {
        index = index + 1;
    }
    return index;
}

fn next_line_start(bytes: []u8, end: i64) -> i64 {
    let byte_len = std::mem::len(bytes);
    var index = end;
    while index < byte_len and
        (bytes[index] == cast<u8>(10) or bytes[index] == cast<u8>(13)) {
        index = index + 1;
    }
    return index;
}

fn token_end(bytes: []u8, start: i64, line_end_pos: i64) -> i64 {
    var index = start;
    while index < line_end_pos and !is_space(bytes[index]) {
        index = index + 1;
    }
    return index;
}

fn skip_spaces(bytes: []u8, start: i64, line_end_pos: i64) -> i64 {
    var index = start;
    while index < line_end_pos and is_space(bytes[index]) {
        index = index + 1;
    }
    return index;
}

fn is_space(byte: u8) -> bool {
    return byte == cast<u8>(32) or byte == cast<u8>(9);
}

fn require_first_manifest_entry(bytes: []u8) -> !void {
    let allocator = std::mem::page_allocator();
    var manifest = try external_abi_entrypoints::collect(allocator);
    defer manifest.deinit();
    let manifest_entries = &manifest.entrypoints;
    let entrypoint = try manifest_entries.at(0);
    return require_entrypoint(bytes, &entrypoint);
}

pub fn valid_manifest_roots_gate() -> !void {
    try require_first_manifest_entry(
        "external-abi-entrypoint selfhost::cli::check::fast_diagnostics_parsed_file
function-signature-return selfhost::cli::check::fast_diagnostics_parsed_file !bool
function-signature-param selfhost::cli::check::fast_diagnostics_parsed_file 0 allocator:runtime:Allocator
function-signature-param selfhost::cli::check::fast_diagnostics_parsed_file 1 io:runtime:Io
function-signature-param selfhost::cli::check::fast_diagnostics_parsed_file 2 path:runtime:[]u8
function-signature-param selfhost::cli::check::fast_diagnostics_parsed_file 3 file_text:runtime:[]u8
function-signature-param selfhost::cli::check::fast_diagnostics_parsed_file 4 parsed:runtime:std::kizu::ast::ParseResult
"
    );
    print("external-abi-roots-ok");
    return;
}

pub fn missing_manifest_root_gate() -> !void {
    return require_first_manifest_entry(
        "function-signature-return selfhost::cli::check::fast_diagnostics_parsed_file !bool
"
    );
}

pub fn duplicate_manifest_root_gate() -> !void {
    return require_first_manifest_entry(
        "external-abi-entrypoint selfhost::cli::check::fast_diagnostics_parsed_file
external-abi-entrypoint selfhost::cli::check::fast_diagnostics_parsed_file
function-signature-return selfhost::cli::check::fast_diagnostics_parsed_file !bool
"
    );
}

pub fn missing_manifest_return_gate() -> !void {
    return require_first_manifest_entry(
        "external-abi-entrypoint selfhost::cli::check::fast_diagnostics_parsed_file
"
    );
}

