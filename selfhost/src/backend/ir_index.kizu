pub struct IrIndex {
    pub newline_offsets: std::array::Array<i64>,
    pub key_starts: std::array::Array<i64>,
    pub key_ends: std::array::Array<i64>,
    pub line_starts: std::array::Array<i64>,
    pub line_ends: std::array::Array<i64>,
}

pub fn build(ir_bytes: []u8) -> !IrIndex {
    var index = IrIndex {
        newline_offsets: std::array::Array<i64>(std::mem::page_allocator()),
        key_starts: std::array::Array<i64>(std::mem::page_allocator()),
        key_ends: std::array::Array<i64>(std::mem::page_allocator()),
        line_starts: std::array::Array<i64>(std::mem::page_allocator()),
        line_ends: std::array::Array<i64>(std::mem::page_allocator())
    };
    let byte_len = std::mem::len(ir_bytes);
    var line_start = 0;
    var pos = 0;
    while pos < byte_len {
        if ir_bytes[pos] == cast<u8>(10) {
            try index.newline_offsets.append(pos);
            try append_entry_for_line(&var index, ir_bytes, line_start, pos);
            line_start = pos + 1;
        }
        pos = pos + 1;
    }
    if line_start < byte_len {
        try append_entry_for_line(&var index, ir_bytes, line_start, byte_len);
    }
    let entries = entry_count(&index);
    if entries > 1 {
        try sort_entries(ir_bytes, &var index, 0, entries - 1);
    }
    return index;
}

impl IrIndex {
    fn deinit(self: IrIndex) -> void {
        self.line_ends.deinit();
        self.line_starts.deinit();
        self.key_ends.deinit();
        self.key_starts.deinit();
        self.newline_offsets.deinit();
    }
}

pub fn entry_count(index: &IrIndex) -> i64 {
    return index.key_starts.len();
}

pub fn entry_key_end(index: &IrIndex, entry_index: i64) -> i64 {
    return index.key_ends.get_or_panic(entry_index);
}

pub fn entry_line_end(index: &IrIndex, entry_index: i64) -> i64 {
    return index.line_ends.get_or_panic(entry_index);
}

fn entry_key_start(index: &IrIndex, entry_index: i64) -> i64 {
    return index.key_starts.get_or_panic(entry_index);
}

fn entry_line_start(index: &IrIndex, entry_index: i64) -> i64 {
    return index.line_starts.get_or_panic(entry_index);
}

fn append_entry_for_line(
    index: &var IrIndex,
    ir_bytes: []u8,
    line_start: i64,
    line_end: i64
) -> !void {
    if line_start >= line_end {
        return;
    }
    let first_end = find_byte_before(ir_bytes, cast<u8>(32), line_start, line_end);
    if first_end >= line_end {
        return;
    }
    let second_start = first_end + 1;
    if second_start >= line_end {
        return;
    }
    let second_end = find_byte_before(ir_bytes, cast<u8>(32), second_start, line_end);
    if second_end <= second_start {
        return;
    }
    try index.key_starts.append(line_start);
    try index.key_ends.append(second_end);
    try index.line_starts.append(line_start);
    try index.line_ends.append(line_end);
    return;
}

fn find_byte_before(bytes: []u8, target: u8, start: i64, end: i64) -> i64 {
    var index = start;
    while index < end {
        if bytes[index] == target {
            return index;
        }
        index = index + 1;
    }
    return end;
}

fn sort_entries(
    ir_bytes: []u8,
    index: &var IrIndex,
    low: i64,
    high: i64
) -> !void {
    if low >= high {
        return;
    }
    var left = low;
    var right = high;
    let pivot = (low + high) / 2;
    let pivot_key_start = entry_key_start(index, pivot);
    let pivot_key_end = entry_key_end(index, pivot);
    let pivot_line_start = entry_line_start(index, pivot);
    while left <= right {
        while compare_entry_to_pivot(
            ir_bytes, index, left, pivot_key_start, pivot_key_end, pivot_line_start
        ) < 0 {
            left = left + 1;
        }
        while compare_entry_to_pivot(
            ir_bytes, index, right, pivot_key_start, pivot_key_end, pivot_line_start
        ) > 0 {
            right = right - 1;
        }
        if left <= right {
            try swap_entries(index, left, right);
            left = left + 1;
            right = right - 1;
        }
    }
    if low < right {
        try sort_entries(ir_bytes, index, low, right);
    }
    if left < high {
        try sort_entries(ir_bytes, index, left, high);
    }
    return;
}

fn compare_entry_to_pivot(
    ir_bytes: []u8,
    index: &IrIndex,
    entry: i64,
    pivot_key_start: i64,
    pivot_key_end: i64,
    pivot_line_start: i64
) -> i64 {
    let key_cmp = compare_entry_key_to_range(
        ir_bytes, index, entry, pivot_key_start, pivot_key_end
    );
    if key_cmp != 0 {
        return key_cmp;
    }
    let line_start = entry_line_start(index, entry);
    if line_start < pivot_line_start {
        return 0 - 1;
    }
    if line_start > pivot_line_start {
        return 1;
    }
    return 0;
}

fn swap_entries(index: &var IrIndex, left: i64, right: i64) -> !void {
    let left_key_start = try index.key_starts.get(left);
    let left_key_end = try index.key_ends.get(left);
    let left_line_start = try index.line_starts.get(left);
    let left_line_end = try index.line_ends.get(left);
    try index.key_starts.set(left, try index.key_starts.get(right));
    try index.key_ends.set(left, try index.key_ends.get(right));
    try index.line_starts.set(left, try index.line_starts.get(right));
    try index.line_ends.set(left, try index.line_ends.get(right));
    try index.key_starts.set(right, left_key_start);
    try index.key_ends.set(right, left_key_end);
    try index.line_starts.set(right, left_line_start);
    try index.line_ends.set(right, left_line_end);
    return;
}

fn compare_entry_key_to_range(
    ir_bytes: []u8,
    index: &IrIndex,
    entry: i64,
    right_start: i64,
    right_end: i64
) -> i64 {
    let left_start = entry_key_start(index, entry);
    let left_len = entry_key_end(index, entry) - left_start;
    return compare_key_ranges(ir_bytes, left_start, left_len, right_start, right_end - right_start);
}

fn compare_key_ranges(
    ir_bytes: []u8,
    left_start: i64,
    left_len: i64,
    right_start: i64,
    right_len: i64
) -> i64 {
    var offset = 0;
    while offset < left_len and offset < right_len {
        let lb = ir_bytes[left_start + offset];
        let rb = ir_bytes[right_start + offset];
        if lb < rb {
            return 0 - 1;
        }
        if lb > rb {
            return 1;
        }
        offset = offset + 1;
    }
    if left_len < right_len {
        return 0 - 1;
    }
    if left_len > right_len {
        return 1;
    }
    return 0;
}

pub fn lookup_fact_value_by_prefix_or_empty(
    index: &IrIndex,
    ir_bytes: []u8,
    fact_prefix: []u8,
    module_prefix: []u8,
    short_name: []u8
) -> []u8 {
    let found = first_matching_entry(index, ir_bytes, fact_prefix, module_prefix, short_name);
    if found < 0 {
        return ir_bytes[0..0];
    }
    var pos = entry_key_end(index, found);
    let line_end = entry_line_end(index, found);
    while pos < line_end and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    return ir_bytes[pos..line_end];
}

pub fn first_matching_entry(
    index: &IrIndex,
    ir_bytes: []u8,
    fact_prefix: []u8,
    module_prefix: []u8,
    short_name: []u8
) -> i64 {
    var low = 0;
    var high = entry_count(index);
    while low < high {
        let mid = (low + high) / 2;
        let cmp = compare_entry_to_query(
            ir_bytes,
            index,
            mid,
            fact_prefix,
            module_prefix,
            short_name
        );
        if cmp < 0 {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    if low >= entry_count(index) {
        return 0 - 1;
    }
    if compare_entry_to_query(ir_bytes, index, low, fact_prefix, module_prefix, short_name) == 0 {
        return low;
    }
    return 0 - 1;
}

pub fn entry_matches_query(
    index: &IrIndex,
    ir_bytes: []u8,
    entry_index: i64,
    fact_prefix: []u8,
    module_prefix: []u8,
    short_name: []u8
) -> bool {
    if entry_index < 0 or entry_index >= entry_count(index) {
        return false;
    }
    return compare_entry_to_query(
        ir_bytes, index, entry_index, fact_prefix, module_prefix, short_name
    ) == 0;
}

fn compare_entry_to_query(
    ir_bytes: []u8,
    index: &IrIndex,
    entry_index: i64,
    fact_prefix: []u8,
    module_prefix: []u8,
    short_name: []u8
) -> i64 {
    let entry_start = entry_key_start(index, entry_index);
    let entry_len = entry_key_end(index, entry_index) - entry_start;
    let query_len = std::mem::len(fact_prefix) +
        std::mem::len(module_prefix) +
        std::mem::len(short_name);
    var offset = 0;
    while offset < entry_len and offset < query_len {
        let eb = ir_bytes[entry_start + offset];
        let qb = query_byte_at(fact_prefix, module_prefix, short_name, offset);
        if eb < qb {
            return 0 - 1;
        }
        if eb > qb {
            return 1;
        }
        offset = offset + 1;
    }
    if entry_len < query_len {
        return 0 - 1;
    }
    if entry_len > query_len {
        return 1;
    }
    return 0;
}

fn query_byte_at(
    fact_prefix: []u8,
    module_prefix: []u8,
    short_name: []u8,
    offset: i64
) -> u8 {
    let fp_len = std::mem::len(fact_prefix);
    if offset < fp_len {
        return fact_prefix[offset];
    }
    let mp_offset = offset - fp_len;
    let mp_len = std::mem::len(module_prefix);
    if mp_offset < mp_len {
        return module_prefix[mp_offset];
    }
    return short_name[mp_offset - mp_len];
}
