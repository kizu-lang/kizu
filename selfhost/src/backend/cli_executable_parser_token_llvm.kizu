import selfhost::backend::ir_contract;

pub fn append_named_token_word_eq_call(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    token_key: []u8
) -> !void {
    let token = try parser_source_token(ir_bytes, token_key);
    if std::mem::len(token) > 7 {
        return error("unsupported executable parser token");
    }
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok");
    try out.append_bytes(" = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start");
    try out.append_bytes(", i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end");
    try append_token_word_suffix(out, token);
    return;
}

pub fn append_token_word_eq_call(
    out: &var std::string::String,
    ir_bytes: []u8,
    result_name: []u8,
    start_name: []u8,
    end_name: []u8,
    token_key: []u8
) -> !void {
    let token = try parser_source_token(ir_bytes, token_key);
    if std::mem::len(token) > 7 {
        return error("unsupported executable parser token");
    }
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes(" = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(start_name);
    try out.append_bytes(", i64 %");
    try out.append_bytes(end_name);
    try append_token_word_suffix(out, token);
    return;
}

pub fn append_named_token_char_eq_call(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    token_key: []u8
) -> !void {
    let byte = try token_byte_value(ir_bytes, token_key);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok");
    try out.append_bytes(" = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start");
    try out.append_bytes(", i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end");
    try out.append_bytes(", i8 ");
    try std::fmt::append_i64(out, byte);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn append_token_char_eq_call(
    out: &var std::string::String,
    ir_bytes: []u8,
    result_name: []u8,
    start_name: []u8,
    end_name: []u8,
    token_key: []u8
) -> !void {
    let byte = try token_byte_value(ir_bytes, token_key);
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes(" = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(start_name);
    try out.append_bytes("_start");
    try out.append_bytes(", i64 %");
    try out.append_bytes(end_name);
    try out.append_bytes("_end");
    try out.append_bytes(", i8 ");
    try std::fmt::append_i64(out, byte);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn append_named_token_pair_eq_call(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    token_key: []u8
) -> !void {
    let token = try parser_source_token(ir_bytes, token_key);
    if std::mem::len(token) != 2 {
        return error("unsupported executable parser token");
    }
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok");
    try out.append_bytes(" = call i1 @kizu_selfhost__cli_token_pair_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start");
    try out.append_bytes(", i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end");
    try out.append_bytes(", i8 ");
    try std::fmt::append_i64(out, cast<i64>(token[0]));
    try out.append_bytes(", i8 ");
    try std::fmt::append_i64(out, cast<i64>(token[1]));
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn token_byte_value(ir_bytes: []u8, token_key: []u8) -> !i64 {
    let token = try parser_source_token(ir_bytes, token_key);
    if std::mem::len(token) != 1 {
        return error("unsupported executable parser token");
    }
    return cast<i64>(token[0]);
}

fn append_token_word_suffix(out: &var std::string::String, token: []u8) -> !void {
    try out.append_bytes(", i64 ");
    try std::fmt::append_i64(out, std::mem::len(token));
    try append_token_word_byte(out, token, 0);
    try append_token_word_byte(out, token, 1);
    try append_token_word_byte(out, token, 2);
    try append_token_word_byte(out, token, 3);
    try append_token_word_byte(out, token, 4);
    try append_token_word_byte(out, token, 5);
    try append_token_word_byte(out, token, 6);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_token_word_byte(
    out: &var std::string::String,
    token: []u8,
    index: i64
) -> !void {
    try out.append_bytes(", i8 ");
    if index < std::mem::len(token) {
        try std::fmt::append_i64(out, cast<i64>(token[index]));
    } else {
        try out.append_bytes("0");
    }
    return;
}

fn parser_source_token(ir_bytes: []u8, token_key: []u8) -> ![]u8 borrows ir_bytes {
    return try ir_contract::named_fact_value(
        ir_bytes,
        "executable-parser-token ",
        token_key
    );
}
