pub fn single_expr_return_function(
    name: []u8,
    return_type: []u8,
    params_spec: []u8,
    result_id: i64,
    expr_insts: std::array::Array<compiled_mir::MirExprInst>
) -> compiled_mir::MirFunction {
    let result_name = "expr";
    let return_value_ref = compiled_mir::expr_result_value(result_id, compiled_mir::llvm_type(return_type), result_name);
    let instruction = compiled_mir::expr_instruction();
    let terminator = compiled_mir::return_value(return_value_ref);
    let block = compiled_mir::MirBlock {
        label: "entry",
        instruction_count: 1,
        first_instruction: instruction,
        terminator: terminator
    };
    return compiled_mir::MirFunction {
        name: name,
        return_type: compiled_mir::llvm_type(return_type),
        params_spec: params_spec,
        call_args: std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        struct_fields: std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        expr_insts: expr_insts,
        multi_stmts: std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        block_count: 1,
        entry: block
    };
}

// single_array_get_return_function backs a 'return self.<field>.get(index);'
// read-only accessor (Array<T>.get -> !T). The entry block carries an ArrayGet
// instruction; the renderer emits the multi-block checked-load body itself, so the
// terminator value is an unused placeholder (append_function only checks that the
// terminator kind is Return for this shape) (tracker 961).
pub fn single_array_get_return_function(
    name: []u8,
    error_union_type: []u8,
    params_spec: []u8,
    receiver_type: []u8,
    receiver_name: []u8,
    field_index: i64,
    index_name: []u8,
    element_type: []u8
) -> compiled_mir::MirFunction {
    let placeholder = compiled_mir::multi_result_value(
        0, compiled_mir::llvm_type(error_union_type), "array_get"
    );
    let instruction = compiled_mir::array_get_instruction(
        receiver_type, receiver_name, field_index, index_name, element_type
    );
    let terminator = compiled_mir::return_value(placeholder);
    let block = compiled_mir::MirBlock {
        label: "entry",
        instruction_count: 1,
        first_instruction: instruction,
        terminator: terminator
    };
    return compiled_mir::MirFunction {
        name: name,
        return_type: compiled_mir::llvm_type(error_union_type),
        params_spec: params_spec,
        call_args: std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        struct_fields: std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        expr_insts: std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        multi_stmts: std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        block_count: 1,
        entry: block
    };
}

pub fn multi_statement_function(
    name: []u8,
    return_type: []u8,
    params_spec: []u8,
    stmts: std::array::Array<compiled_mir::MirStmt>
) -> compiled_mir::MirFunction {
    let return_value_ref = compiled_mir::multi_result_value(0, compiled_mir::llvm_type(return_type), "multi");
    let instruction = compiled_mir::multi_statement_instruction();
    let terminator = compiled_mir::return_value(return_value_ref);
    let block = compiled_mir::MirBlock {
        label: "entry",
        instruction_count: 1,
        first_instruction: instruction,
        terminator: terminator
    };
    return compiled_mir::MirFunction {
        name: name,
        return_type: compiled_mir::llvm_type(return_type),
        params_spec: params_spec,
        call_args: std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        struct_fields: std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        expr_insts: std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        multi_stmts: stmts,
        block_count: 1,
        entry: block
    };
}
