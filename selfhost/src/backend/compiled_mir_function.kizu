    };
}

pub fn single_call_return_function(
    name: []u8,
    return_type: []u8,
    params_spec: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<compiled_mir::MirCallArg>
) -> compiled_mir::MirFunction {
    let instruction_value = compiled_mir::call_result_value(0, compiled_mir::llvm_type(return_type), "result");
    let return_value_ref = compiled_mir::call_result_value(0, compiled_mir::llvm_type(return_type), "result");
    let instruction = compiled_mir::call_instruction(instruction_value, module_prefix, callee_name);
    let terminator = compiled_mir::return_value(return_value_ref);
    let block = compiled_mir::MirBlock {
        label: "entry",
        instruction_count: 1,
        first_instruction: instruction,
        terminator: terminator
    };
    return compiled_mir::MirFunction {
        name: name,
        return_type: compiled_mir::llvm_type(return_type),
        params_spec: params_spec,
        call_args: args,
        struct_fields: std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        expr_insts: std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        multi_stmts: std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        block_count: 1,
        entry: block
    };
}

