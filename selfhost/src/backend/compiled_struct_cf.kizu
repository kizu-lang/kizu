import selfhost::backend::ir_contract;
import selfhost::backend::compiled_util;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_mir_types;
import selfhost::backend::compiled_type_lower;

// compiled_struct_cf lowers a structured-control-flow formatter helper (an
// insertion / scan-shift sort over a '&var std::array::Array<T>' parameter) onto the
// compiled stage2 path without the template-shaped i64-induction While machinery
// (issue 1165 / 1162). It is the first compiled helper that needs a genuine basic-block
// + phi shape: an outer counter loop, a nested scan loop carrying a cursor and a boolean
// flag, an if/else that re-merges into the loop (not an early-return-only if), a
// try-call comparator used as the if condition, and Array<T>.get / Array<T>.set element
// reads/writes through the element-size-generic runtime ABI (@kizu_rt_array_at /
// @kizu_rt_array_set / @kizu_rt_array_len). Every identifier, comparator callee,
// argument, element type and literal is derived from the function AST; the control-flow
// skeleton is shape-detected (is_import_sort_shape) like is_value_array_loop_shape, and
// any deviation is an explicit error rather than a silent fallback.
// sort_import_indices is its first consumer.

fn cf_w(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    return;
}

fn cf_l(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}

fn cf_kind_is(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    kind: []u8,
    bs: i64
) -> !bool {
    let actual = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    return std::mem::equal_bytes(actual, kind);
}

// cf_param_type_or_empty returns the LLVM type recorded for a params_spec parameter, or
// "" when 'name' is a local rather than a parameter.
fn cf_param_type_or_empty(params_spec: []u8, name: []u8) -> []u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            let param_type = params_spec[pos..space_pos];
            let param_name = params_spec[space_pos + 1..entry_end];
            if std::mem::equal_bytes(param_name, name) {
                return param_type;
            }
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return params_spec[0..0];
}

// cf_nth_param_name returns the name of the params_spec parameter at position 'target' (0-based),
// or "" when there is no such parameter. The params_spec preserves signature order, so the
// position identifies a specific parameter (e.g. the source parameter the sort helper receives)
// without threading its name through the caller.
fn cf_nth_param_name(params_spec: []u8, target: i64) -> []u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    var index = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end and index == target {
            return params_spec[space_pos + 1..entry_end];
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
        index = index + 1;
    }
    return params_spec[0..0];
}

// cf_strip_ref_var normalises a recorded parameter type token to its underlying value
// type by stripping the leading error-union '!', reference '&', and mutable-reference
// 'var_' markers. The IR records '&var std::array::Array<i64>' with its source spaces
// lowered to underscores, so a '&var' parameter arrives as '&var_std::array::Array<i64>'.
fn cf_strip_ref_var(type_token: []u8) -> []u8 {
    var current = type_token;
    var changed = true;
    while changed {
        changed = false;
        let len = std::mem::len(current);
        if len > 0 and (current[0] == cast<u8>(33) or current[0] == cast<u8>(38)) {
            current = current[1..len];
            changed = true;
        } else {
            if std::mem::starts_with(current, "var_") {
                current = current[4..len];
                changed = true;
            }
        }
    }
    return current;
}

// cf_array_element_llvm derives the element LLVM type of an Array<T> parameter receiver
// from the recorded parameter kizu type, so the element size is taken from <T> rather
// than a hidden i64 special case.
fn cf_array_element_llvm(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_name: []u8,
    bs: i64
) -> ![]u8 {
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type(
        ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs
    );
    let lookup = cf_strip_ref_var(compiled_mir_types::struct_lookup_kizu_type(receiver_kizu));
    let prefix = "std::array::Array<";
    let prefix_len = std::mem::len(prefix);
    let lookup_len = std::mem::len(lookup);
    if lookup_len <= prefix_len or !std::mem::starts_with(lookup, prefix) or
        lookup[lookup_len - 1] != cast<u8>(62) {
        return error("compiled struct-cf: receiver is not a std::array::Array");
    }
    let element_kizu = lookup[prefix_len..lookup_len - 1];
    return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, element_kizu);
}

fn cf_own_fail_msg_field(ret_type: []u8) -> i64 {
    if std::mem::equal_bytes(ret_type, "%kizu.error.void") {
        return 1;
    }
    return 2;
}

// cf_emit_own_fail re-wraps a borrowed runtime error message as this function's own
// error union and returns it (never 'unreachable'). The message SSA value is named
// '%<msg_base><msg_tail>'. The message lands in the union's trailing message field,
// which is field 1 for %kizu.error.void and field 2 otherwise.
fn cf_emit_own_fail(
    out: &var std::string::String,
    ret_type: []u8,
    prefix: []u8,
    msg_base: []u8,
    msg_tail: []u8
) -> !void {
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_ff = insertvalue ");
    try cf_w(out, ret_type);
    try cf_l(out, " zeroinitializer, i1 false, 0");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_fv = insertvalue ");
    try cf_w(out, ret_type);
    try cf_w(out, " %");
    try cf_w(out, prefix);
    try cf_w(out, "_ff, %kizu.slice.u8 %");
    try cf_w(out, msg_base);
    try cf_w(out, msg_tail);
    try cf_w(out, ", ");
    try std::fmt::append_i64(out, cf_own_fail_msg_field(ret_type));
    try cf_l(out, "");
    try cf_w(out, "  ret ");
    try cf_w(out, ret_type);
    try cf_w(out, " %");
    try cf_w(out, prefix);
    try cf_l(out, "_fv");
    return;
}

// cf_emit_get lowers 'let <letname> = try <arr>.get(<index>);' against the checked
// @kizu_rt_array_at runtime helper: it branches on the borrowed view ok flag, propagates
// a failure as this function's own error union, and on success loads the element value
// out of the borrowed view into the SSA value '%<letname>'. The current block on return
// is '<letname>_cont'.
fn cf_emit_get(
    out: &var std::string::String,
    letname: []u8,
    arr_name: []u8,
    recv_type: []u8,
    element_llvm: []u8,
    ret_type: []u8,
    index_base: []u8,
    index_tail: []u8
) -> !void {
    try cf_w(out, "  %");
    try cf_w(out, letname);
    try cf_w(out, "_view = call %kizu.error.slice.u8 @kizu_rt_array_at(");
    try cf_w(out, recv_type);
    try cf_w(out, " %");
    try cf_w(out, arr_name);
    try cf_w(out, ", i64 %");
    try cf_w(out, index_base);
    try cf_w(out, index_tail);
    try cf_l(out, ")");
    try cf_w(out, "  %");
    try cf_w(out, letname);
    try cf_w(out, "_view_ok = extractvalue %kizu.error.slice.u8 %");
    try cf_w(out, letname);
    try cf_l(out, "_view, 0");
    try cf_w(out, "  br i1 %");
    try cf_w(out, letname);
    try cf_w(out, "_view_ok, label %");
    try cf_w(out, letname);
    try cf_w(out, "_cont, label %");
    try cf_w(out, letname);
    try cf_l(out, "_fail");
    try cf_w(out, letname);
    try cf_l(out, "_fail:");
    try cf_w(out, "  %");
    try cf_w(out, letname);
    try cf_w(out, "_view_msg = extractvalue %kizu.error.slice.u8 %");
    try cf_w(out, letname);
    try cf_l(out, "_view, 2");
    try cf_emit_own_fail(out, ret_type, letname, letname, "_view_msg");
    try cf_w(out, letname);
    try cf_l(out, "_cont:");
    try cf_w(out, "  %");
    try cf_w(out, letname);
    try cf_w(out, "_slice = extractvalue %kizu.error.slice.u8 %");
    try cf_w(out, letname);
    try cf_l(out, "_view, 1");
    try cf_w(out, "  %");
    try cf_w(out, letname);
    try cf_w(out, "_ptr = extractvalue %kizu.slice.u8 %");
    try cf_w(out, letname);
    try cf_l(out, "_slice, 0");
    try cf_w(out, "  %");
    try cf_w(out, letname);
    try cf_w(out, " = load ");
    try cf_w(out, element_llvm);
    try cf_w(out, ", ptr %");
    try cf_w(out, letname);
    try cf_l(out, "_ptr");
    return;
}

// cf_emit_set lowers 'try <arr>.set(<index>, <value>);' against the element-size-generic
// @kizu_rt_array_set runtime helper. The element is marshalled through a pre-allocated
// entry-block slot ('%<prefix>_slot'), built into a %kizu.slice.u8 (pointer + element
// size derived from the element LLVM type), and a failure propagates as this function's
// own error union. The current block on return is '<prefix>_cont'.
fn cf_emit_set(
    out: &var std::string::String,
    prefix: []u8,
    arr_name: []u8,
    recv_type: []u8,
    element_llvm: []u8,
    ret_type: []u8,
    index_base: []u8,
    index_tail: []u8,
    value_base: []u8,
    value_tail: []u8
) -> !void {
    try cf_w(out, "  store ");
    try cf_w(out, element_llvm);
    try cf_w(out, " %");
    try cf_w(out, value_base);
    try cf_w(out, value_tail);
    try cf_w(out, ", ptr %");
    try cf_w(out, prefix);
    try cf_l(out, "_slot");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_es0 = insertvalue %kizu.slice.u8 poison, ptr %");
    try cf_w(out, prefix);
    try cf_l(out, "_slot, 0");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_eslice = insertvalue %kizu.slice.u8 %");
    try cf_w(out, prefix);
    try cf_w(out, "_es0, i64 ptrtoint (ptr getelementptr (");
    try cf_w(out, element_llvm);
    try cf_l(out, ", ptr null, i32 1) to i64), 1");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_call = call %kizu.error.void @kizu_rt_array_set(");
    try cf_w(out, recv_type);
    try cf_w(out, " %");
    try cf_w(out, arr_name);
    try cf_w(out, ", i64 %");
    try cf_w(out, index_base);
    try cf_w(out, index_tail);
    try cf_w(out, ", %kizu.slice.u8 %");
    try cf_w(out, prefix);
    try cf_l(out, "_eslice)");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_ok = extractvalue %kizu.error.void %");
    try cf_w(out, prefix);
    try cf_l(out, "_call, 0");
    try cf_w(out, "  br i1 %");
    try cf_w(out, prefix);
    try cf_w(out, "_ok, label %");
    try cf_w(out, prefix);
    try cf_w(out, "_cont, label %");
    try cf_w(out, prefix);
    try cf_l(out, "_fail");
    try cf_w(out, prefix);
    try cf_l(out, "_fail:");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_msg = extractvalue %kizu.error.void %");
    try cf_w(out, prefix);
    try cf_l(out, "_call, 1");
    try cf_emit_own_fail(out, ret_type, prefix, prefix, "_msg");
    try cf_w(out, prefix);
    try cf_l(out, "_cont:");
    return;
}

// cf_emit_append lowers 'try <arr>.append(<value>);' against the element-size-generic
// @kizu_rt_array_append runtime helper. The element is marshalled through a pre-allocated
// entry-block slot ('%<prefix>_slot'), wrapped into a %kizu.slice.u8 (pointer + element size
// derived from the element LLVM type), and a failure propagates as this function's own error
// union. The current block on return is '<prefix>_cont'. It mirrors cf_emit_set without the
// index argument, so the same checked-ABI / own-error wrapping serves both element writes.
fn cf_emit_append(
    out: &var std::string::String,
    prefix: []u8,
    arr_name: []u8,
    recv_type: []u8,
    element_llvm: []u8,
    ret_type: []u8,
    value_base: []u8,
    value_tail: []u8
) -> !void {
    try cf_w(out, "  store ");
    try cf_w(out, element_llvm);
    try cf_w(out, " %");
    try cf_w(out, value_base);
    try cf_w(out, value_tail);
    try cf_w(out, ", ptr %");
    try cf_w(out, prefix);
    try cf_l(out, "_slot");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_es0 = insertvalue %kizu.slice.u8 poison, ptr %");
    try cf_w(out, prefix);
    try cf_l(out, "_slot, 0");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_eslice = insertvalue %kizu.slice.u8 %");
    try cf_w(out, prefix);
    try cf_w(out, "_es0, i64 ptrtoint (ptr getelementptr (");
    try cf_w(out, element_llvm);
    try cf_l(out, ", ptr null, i32 1) to i64), 1");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_call = call %kizu.error.void @kizu_rt_array_append(");
    try cf_w(out, recv_type);
    try cf_w(out, " %");
    try cf_w(out, arr_name);
    try cf_w(out, ", %kizu.slice.u8 %");
    try cf_w(out, prefix);
    try cf_l(out, "_eslice)");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_ok = extractvalue %kizu.error.void %");
    try cf_w(out, prefix);
    try cf_l(out, "_call, 0");
    try cf_w(out, "  br i1 %");
    try cf_w(out, prefix);
    try cf_w(out, "_ok, label %");
    try cf_w(out, prefix);
    try cf_w(out, "_cont, label %");
    try cf_w(out, prefix);
    try cf_l(out, "_fail");
    try cf_w(out, prefix);
    try cf_l(out, "_fail:");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_msg = extractvalue %kizu.error.void %");
    try cf_w(out, prefix);
    try cf_l(out, "_call, 1");
    try cf_emit_own_fail(out, ret_type, prefix, prefix, "_msg");
    try cf_w(out, prefix);
    try cf_l(out, "_cont:");
    return;
}

// cf_emit_string_global emits a private module-level constant for a string-literal token, named
// '@.kizu.compiled.<llvm_symbol>.s<slot>'. The payload length and escaped bytes are decoded from
// the source string token (with its surrounding quotes), matching the layout the generic call
// lowering emits, so the import output helpers reference their "import " / ";" literals through
// the same global form (issue 1165).
fn cf_emit_string_global(
    out: &var std::string::String,
    llvm_symbol: []u8,
    slot: i64,
    token: []u8
) -> !void {
    let quote = cast<u8>(34);
    let payload_len = try compiled_util::string_token_decoded_len(
        token, "compiled struct-cf: invalid string literal"
    );
    try cf_w(out, "@.kizu.compiled.");
    try cf_w(out, llvm_symbol);
    try cf_w(out, ".s");
    try std::fmt::append_i64(out, slot);
    try cf_w(out, " = private unnamed_addr constant [");
    try std::fmt::append_i64(out, payload_len);
    try cf_w(out, " x i8] c");
    try out.append_byte(quote);
    try compiled_util::append_string_token_payload(
        out, token, "compiled struct-cf: invalid string literal"
    );
    try out.append_byte(quote);
    try out.append_byte(cast<u8>(10));
    return;
}

// cf_emit_string_literal_slice materializes a string-literal global into a '%kizu.slice.u8' SSA
// value named '%<prefix>_slice' (a getelementptr to the constant's first byte plus its decoded
// length), so the literal can be passed to the @kizu_rt_string_append_bytes ABI. The slot must
// match the global emitted by cf_emit_string_global.
fn cf_emit_string_literal_slice(
    out: &var std::string::String,
    llvm_symbol: []u8,
    slot: i64,
    prefix: []u8,
    token: []u8
) -> !void {
    let payload_len = try compiled_util::string_token_decoded_len(
        token, "compiled struct-cf: invalid string literal"
    );
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_ptr = getelementptr [");
    try std::fmt::append_i64(out, payload_len);
    try cf_w(out, " x i8], ptr @.kizu.compiled.");
    try cf_w(out, llvm_symbol);
    try cf_w(out, ".s");
    try std::fmt::append_i64(out, slot);
    try cf_l(out, ", i64 0, i64 0");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try cf_w(out, prefix);
    try cf_l(out, "_ptr, 0");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_slice = insertvalue %kizu.slice.u8 %");
    try cf_w(out, prefix);
    try cf_w(out, "_base, i64 ");
    try std::fmt::append_i64(out, payload_len);
    try cf_l(out, ", 1");
    return;
}

// cf_emit_string_append lowers a 'try <out>.<method>(<operand>);' append against a
// @kizu_rt_string_append_* runtime helper: it calls the helper (which returns %kizu.error.void
// over the %kizu.owned string handle and a single operand), branches on the ok flag, propagates
// a failure as this function's own error union, and leaves '<prefix>_cont' current. The operand
// is already materialized (a built literal slice, a slice local, or an i8 literal). The operand
// is spelled '<operand_sigil><operand>', so a register operand passes operand_sigil "%" with the
// SSA name (append_bytes over %kizu.slice.u8) and an immediate passes operand_sigil "" with the
// literal (append_byte over i8); the same helper serves both append methods.
fn cf_emit_string_append(
    out: &var std::string::String,
    ret_type: []u8,
    prefix: []u8,
    runtime_symbol: []u8,
    out_name: []u8,
    operand_type: []u8,
    operand_sigil: []u8,
    operand: []u8
) -> !void {
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_call = call %kizu.error.void @");
    try cf_w(out, runtime_symbol);
    try cf_w(out, "(%kizu.owned %");
    try cf_w(out, out_name);
    try cf_w(out, ", ");
    try cf_w(out, operand_type);
    try cf_w(out, " ");
    try cf_w(out, operand_sigil);
    try cf_w(out, operand);
    try cf_l(out, ")");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_ok = extractvalue %kizu.error.void %");
    try cf_w(out, prefix);
    try cf_l(out, "_call, 0");
    try cf_w(out, "  br i1 %");
    try cf_w(out, prefix);
    try cf_w(out, "_ok, label %");
    try cf_w(out, prefix);
    try cf_w(out, "_cont, label %");
    try cf_w(out, prefix);
    try cf_l(out, "_fail");
    try cf_w(out, prefix);
    try cf_l(out, "_fail:");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_msg = extractvalue %kizu.error.void %");
    try cf_w(out, prefix);
    try cf_l(out, "_call, 1");
    try cf_emit_own_fail(out, ret_type, prefix, prefix, "_msg");
    try cf_w(out, prefix);
    try cf_l(out, "_cont:");
    return;
}

// cf_ctor_element_llvm derives the element LLVM type of a 'std::array::Array<T>(<allocator>)'
// constructor from the constructor callee token, so a local array's element size flows from
// its declared <T> rather than a hidden i64 special case. The callee is the constructor type
// (e.g. 'std::array::Array<i64>'); a callee that is not an Array<T> is an explicit error.
fn cf_ctor_element_llvm(
    ir_bytes: []u8,
    module_prefix: []u8,
    ctor_callee: []u8
) -> ![]u8 {
    let element_kizu = compiled_mir_types::array_value_element_kizu_type_or_empty(ctor_callee);
    if std::mem::len(element_kizu) == 0 {
        return error("compiled struct-cf: array constructor is not a std::array::Array<T>");
    }
    return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, element_kizu);
}

// cf_block_statement_count counts the "statement" children of a Block node.
fn cf_block_statement_count(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", count, bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

// cf_block_has_nested_while reports whether a Block node contains a directly nested
// While statement, distinguishing the scan-shift sort outer loop from the flat
// scan-while helpers (index_after_leading_imports) that share the (Let, While, Return)
// top-level shape.
fn cf_block_has_nested_while(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !bool {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", count, bs
        );
        if child < 0 {
            return false;
        }
        if try cf_kind_is(ir_bytes, function_name, child, "While", bs) {
            return true;
        }
        count = count + 1;
    }
    return false;
}

// is_import_sort_shape detects the scan-shift sort skeleton: a function whose body is
// exactly 'var <i> = <int>; while <i> < <arr>.len() { ...nested while... } return;', with
// the outer loop body carrying a nested While. The full per-node validation lives in
// append_import_sort_function, which errors on any deviation.
pub fn is_import_sort_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let s0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 0, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s0, "Let", bs)) {
        return false;
    }
    let s0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0, "value", 0, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s0_value, "Int", bs)) {
        return false;
    }
    let s1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 1, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s1, "While", bs)) {
        return false;
    }
    let s2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 2, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s2, "Return", bs)) {
        return false;
    }
    let s1_body = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "body", 0, bs);
    return try cf_block_has_nested_while(ir_bytes, function_name, s1_body, bs);
}

// cf_block_has_nested_if reports whether a Block node contains a directly nested If
// statement, distinguishing the leading-import collector's branch-merge scan loop from the
// flat scan-while helpers (index_after_leading_imports) whose loop body is a guarded early
// return rather than an if/else that re-merges into the loop.
fn cf_block_has_nested_if(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !bool {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", count, bs
        );
        if child < 0 {
            return false;
        }
        if try cf_kind_is(ir_bytes, function_name, child, "If", bs) {
            return true;
        }
        count = count + 1;
    }
    return false;
}

// is_leading_import_shape detects the leading-import collector skeleton: a function whose body
// is exactly 'var <indices> = std::array::Array<T>(<allocator>); var <index> = <int>; while
// <index> < <tokens>.len() { let <token> = try <tokens>.get(<index>); if !<pred>(<token>) {
// <index> = <tokens>.len(); } else { try <indices>.append(<index>); <index> = try
// <helper>(<tokens>, <index>); } } try <sort>(...); return <indices>;'. It is structurally
// distinct from the scan-shift sort: a 5-statement body whose first statement constructs an
// array (a Call, not an Int seed), an outer scan loop whose body re-merges through an if/else
// rather than a nested while, and a value-returning tail. The full per-node validation lives
// in append_leading_import_function, which errors on any deviation. leading_import_indices is
// its first consumer.
pub fn is_leading_import_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 5 {
        return false;
    }
    let s0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 0, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s0, "Let", bs)) {
        return false;
    }
    let s0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0, "value", 0, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s0_value, "Call", bs)) {
        return false;
    }
    let ctor_callee = try ir_contract::body_call_callee_or_empty_from(ir_bytes, function_name, s0_value, bs);
    if std::mem::len(compiled_mir_types::array_value_element_kizu_type_or_empty(ctor_callee)) == 0 {
        return false;
    }
    let s1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 1, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s1, "Let", bs)) {
        return false;
    }
    let s2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 2, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s2, "While", bs)) {
        return false;
    }
    let s3 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 3, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s3, "ExprStmt", bs)) {
        return false;
    }
    let s4 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 4, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s4, "Return", bs)) {
        return false;
    }
    let s2_body = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s2, "body", 0, bs);
    return try cf_block_has_nested_if(ir_bytes, function_name, s2_body, bs);
}

// is_import_decl_shape detects the single-import emitter skeleton: a function whose body is
// exactly 'try <out>.append_bytes(<lit>); var <index> = <import_index> + 1; while <index> <
// <tokens>.len() { let <token> = try <tokens>.get(<index>); let <text> = <token_text>(<source>,
// <token>); if <semi>(<token>) { try <out>.append_bytes(<lit>); return; } if <ident>(<token>) or
// <colon>(<token>) { try <out>.append_bytes(<text>); } <index> = <index> + 1; } return;'. It is
// the first compiled helper that mutates a '&var std::string::String' accumulator: a 4-statement
// body opening with a string-literal append (an ExprStmt, not a Let or Int seed), a scan loop
// whose body carries an early-return if and a fall-through boolean-or if, and a bare void return.
// The full per-node validation lives in append_import_decl_function, which errors on any
// deviation. append_import_decl is its first consumer.
pub fn is_import_decl_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 4 {
        return false;
    }
    let s0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 0, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s0, "ExprStmt", bs)) {
        return false;
    }
    let s1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 1, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s1, "Let", bs)) {
        return false;
    }
    let s1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "value", 0, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s1_value, "Binary", bs)) {
        return false;
    }
    let s2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 2, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s2, "While", bs)) {
        return false;
    }
    let s3 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 3, bs);
    if !(try cf_kind_is(ir_bytes, function_name, s3, "Return", bs)) {
        return false;
    }
    let s3_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s3, "value", 0, bs);
    return try cf_kind_is(ir_bytes, function_name, s3_value, "Empty", bs);
}

// cf_expect requires a node to have a given kind, raising an explicit error otherwise.
fn cf_expect(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    kind: []u8,
    message: []u8,
    bs: i64
) -> !void {
    if !(try cf_kind_is(ir_bytes, function_name, node, kind, bs)) {
        return error(message);
    }
    return;
}

// cf_require_binary_op requires a node to be a Binary expression whose recorded operator
// token equals 'op'. The emitted control flow hard-codes each comparison / arithmetic
// operator, so a deviating operator must be an explicit error rather than a silent
// mis-lowering.
fn cf_require_binary_op(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    op: []u8,
    message: []u8,
    bs: i64
) -> !void {
    try cf_expect(ir_bytes, function_name, node, "Binary", message, bs);
    let actual = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, node, bs
    );
    if !std::mem::equal_bytes(actual, op) {
        return error(message);
    }
    return;
}

// cf_require_var requires a node to be a Var reference whose token equals 'name'. The
// emitter binds each operand SSA value to a fixed source identifier, so a different
// referenced variable must be rejected.
fn cf_require_var(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    name: []u8,
    message: []u8,
    bs: i64
) -> !void {
    try cf_expect(ir_bytes, function_name, node, "Var", message, bs);
    let token = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(token, name) {
        return error(message);
    }
    return;
}

// cf_require_int requires a node to be an Int literal whose value equals 'value'.
fn cf_require_int(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    value: i64,
    message: []u8,
    bs: i64
) -> !void {
    try cf_expect(ir_bytes, function_name, node, "Int", message, bs);
    let actual = try ir_contract::body_int_value_from(ir_bytes, function_name, node, bs);
    if actual != value {
        return error(message);
    }
    return;
}

// cf_require_bool requires a node to be a Bool literal whose token equals 'token'.
fn cf_require_bool(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    token: []u8,
    message: []u8,
    bs: i64
) -> !void {
    try cf_expect(ir_bytes, function_name, node, "Bool", message, bs);
    let actual = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(actual, token) {
        return error(message);
    }
    return;
}

// cf_require_cursor_decrement requires a node to be the '<cursor> - 1' expression that
// the emitter renders as a fixed 'sub i64 %<cursor>, 1'. Both the index of the lower
// swap slot and the cursor decrement share this shape.
fn cf_require_cursor_decrement(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    cursor_var: []u8,
    message: []u8,
    bs: i64
) -> !void {
    try cf_require_binary_op(ir_bytes, function_name, node, "sub", message, bs);
    let left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, node, "left", 0, bs);
    try cf_require_var(ir_bytes, function_name, left, cursor_var, message, bs);
    let right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, node, "right", 0, bs);
    try cf_require_int(ir_bytes, function_name, right, 1, message, bs);
    return;
}

// cf_require_call_argc requires a Call node to carry exactly 'expected' positional args,
// so the emitter never reads past or short of the operands it marshals.
fn cf_require_call_argc(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    expected: i64,
    message: []u8,
    bs: i64
) -> !void {
    let argc = try compiled_mir_types::count_call_args(ir_bytes, function_name, call_node, bs);
    if argc != expected {
        return error(message);
    }
    return;
}

// cf_call_under_try unwraps a 'try <call>' expression node to its inner Call node.
fn cf_call_under_try(
    ir_bytes: []u8,
    function_name: []u8,
    try_node: i64,
    bs: i64
) -> !i64 {
    try cf_expect(ir_bytes, function_name, try_node, "TryExpr",
        "compiled struct-cf: expected a try-expression", bs);
    let inner = try ir_contract::body_child_sequence_from(ir_bytes, function_name, try_node, "value", 0, bs);
    try cf_expect(ir_bytes, function_name, inner, "Call",
        "compiled struct-cf: try-expression must wrap a call", bs);
    return inner;
}

// cf_method_receiver_name validates a method call '<receiver>.<method>(...)' and returns
// the receiver variable name.
fn cf_method_receiver_name(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    method: []u8,
    bs: i64
) -> ![]u8 {
    let callee = try ir_contract::body_child_sequence_from(ir_bytes, function_name, call_node, "callee", 0, bs);
    try cf_expect(ir_bytes, function_name, callee, "FieldExpr",
        "compiled struct-cf: expected a method call", bs);
    let field = try ir_contract::body_field_expr_name_from(ir_bytes, function_name, callee, "field", bs);
    if !std::mem::equal_bytes(field, method) {
        return error("compiled struct-cf: unexpected method name");
    }
    let receiver = try ir_contract::body_child_sequence_from(ir_bytes, function_name, callee, "receiver", 0, bs);
    try cf_expect(ir_bytes, function_name, receiver, "Var",
        "compiled struct-cf: method receiver must be a variable", bs);
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs);
}

// cf_emit_cmp_call lowers 'if try <cmp>(<args>)' as the inner-loop branch: it calls the
// comparator error union, propagates a failure, and branches on the unwrapped boolean to
// '%if_then' / '%if_else'. Every argument is read from the AST (parameters keep their
// signature LLVM type; loaded i64 locals use the element LLVM type).
fn cf_emit_cmp_call(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    element_llvm: []u8,
    ret_type: []u8,
    call_node: i64,
    bs: i64
) -> !void {
    let callee = try ir_contract::body_call_callee_or_empty_from(ir_bytes, function_name, call_node, bs);
    let cmp_eu = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    try cf_w(out, "  %cmp_eu = call ");
    try cf_w(out, cmp_eu);
    try cf_w(out, " @");
    try compiled_signature::derive_callee_llvm_symbol(out, module_prefix, callee);
    try cf_w(out, "(");
    let argc = try compiled_mir_types::count_call_args(ir_bytes, function_name, call_node, bs);
    var ai = 0;
    while ai < argc {
        let arg = try ir_contract::body_child_sequence_from(ir_bytes, function_name, call_node, "arg", ai, bs);
        try cf_expect(ir_bytes, function_name, arg, "Var",
            "compiled struct-cf: comparator argument must be a variable", bs);
        let aname = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, arg, bs);
        if ai > 0 {
            try cf_w(out, ", ");
        }
        let ptype = cf_param_type_or_empty(params_spec, aname);
        if std::mem::len(ptype) > 0 {
            try cf_w(out, ptype);
        } else {
            try cf_w(out, element_llvm);
        }
        try cf_w(out, " %");
        try cf_w(out, aname);
        ai = ai + 1;
    }
    try cf_l(out, ")");
    try cf_w(out, "  %cmp_ok = extractvalue ");
    try cf_w(out, cmp_eu);
    try cf_l(out, " %cmp_eu, 0");
    try cf_l(out, "  br i1 %cmp_ok, label %cmp_cont, label %cmp_fail");
    try cf_l(out, "cmp_fail:");
    try cf_w(out, "  %cmp_msg = extractvalue ");
    try cf_w(out, cmp_eu);
    try cf_l(out, " %cmp_eu, 2");
    try cf_emit_own_fail(out, ret_type, "cmp", "cmp", "_msg");
    try cf_l(out, "cmp_cont:");
    try cf_w(out, "  %cmp_val = extractvalue ");
    try cf_w(out, cmp_eu);
    try cf_l(out, " %cmp_eu, 1");
    try cf_l(out, "  br i1 %cmp_val, label %if_then, label %if_else");
    return;
}

// append_import_sort_function emits the full define for a scan-shift sort helper. It
// re-reads and validates the whole skeleton off the AST, then renders the basic-block /
// phi control flow: an outer counter loop, a nested scan loop carrying a cursor and a
// boolean flag through loop-head phis, an if/else that re-merges at '%inner_latch' via
// phis, the try-call comparator condition, and the Array<T>.get / Array<T>.set element
// ABI. Any unsupported deviation is an explicit error.
pub fn append_import_sort_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !void {
    let module_prefix = compiled_util::module_prefix_of(function_name);

    // Outer induction initializer: 'var <outer_var> = 1;'. The insertion sort treats
    // element 0 as trivially sorted, so the counter must start at 1; a different seed
    // (e.g. 0) would skip the first comparison, so it is an explicit error.
    let s0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 0, bs);
    let s0_name = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0, "name", 0, bs);
    let outer_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, s0_name, bs);
    let s0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0, "value", 0, bs);
    try cf_require_int(ir_bytes, function_name, s0_value, 1,
        "compiled struct-cf: outer counter must be initialized to 1", bs);
    let outer_init = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, s0_value, bs);

    // Outer loop and its body: 'while <outer_var> < <arr>.len() { ... }'.
    let s1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 1, bs);
    let outer_cond = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "condition", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, outer_cond, "lt",
        "compiled struct-cf: outer loop condition must be '<counter> < <array>.len()'", bs);
    let outer_cond_left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, outer_cond, "left", 0, bs);
    try cf_require_var(ir_bytes, function_name, outer_cond_left, outer_var,
        "compiled struct-cf: outer loop must compare the counter on the left", bs);
    let outer_cond_right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, outer_cond, "right", 0, bs);
    let arr_name = try cf_method_receiver_name(ir_bytes, function_name, outer_cond_right, "len", bs);
    try cf_require_call_argc(ir_bytes, function_name, outer_cond_right, 0,
        "compiled struct-cf: array length call takes no arguments", bs);

    let recv_type = cf_param_type_or_empty(params_spec, arr_name);
    if std::mem::len(recv_type) == 0 {
        return error("compiled struct-cf: array receiver must be a parameter");
    }
    let element_llvm = try cf_array_element_llvm(
        ir_bytes, function_name, module_prefix, params_spec, arr_name, bs
    );

    let outer_body = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "body", 0, bs);
    if (try cf_block_statement_count(ir_bytes, function_name, outer_body, bs)) != 4 {
        return error("compiled struct-cf: outer loop body must be cursor/flag inits, scan loop, increment");
    }
    let ob0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, outer_body, "statement", 0, bs);
    let ob1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, outer_body, "statement", 1, bs);
    let ob2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, outer_body, "statement", 2, bs);
    let ob3 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, outer_body, "statement", 3, bs);

    // 'var <cursor> = <outer_var>;' seeds the scan cursor from the outer counter.
    try cf_expect(ir_bytes, function_name, ob0, "Let",
        "compiled struct-cf: scan loop must start with the cursor initializer", bs);
    let cursor_name_node = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob0, "name", 0, bs);
    let cursor_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, cursor_name_node, bs);
    let ob0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob0, "value", 0, bs);
    try cf_require_var(ir_bytes, function_name, ob0_value, outer_var,
        "compiled struct-cf: cursor must be seeded from the outer counter", bs);

    // 'var <scanning> = true;' seeds the loop-carried scanning flag.
    try cf_expect(ir_bytes, function_name, ob1, "Let",
        "compiled struct-cf: scan loop must seed the scanning flag", bs);
    let scanning_name_node = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob1, "name", 0, bs);
    let scanning_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, scanning_name_node, bs);
    let ob1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob1, "value", 0, bs);
    try cf_require_bool(ir_bytes, function_name, ob1_value, "true",
        "compiled struct-cf: scanning flag must be seeded to true", bs);

    try cf_expect(ir_bytes, function_name, ob2, "While",
        "compiled struct-cf: scan loop must be a nested while", bs);

    // 'while <scanning> and <cursor> > 0' is the nested scan-loop header.
    let inner_cond = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob2, "condition", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, inner_cond, "and",
        "compiled struct-cf: scan loop header must be '<scanning> and <cursor> > 0'", bs);
    let inner_cond_left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, inner_cond, "left", 0, bs);
    try cf_require_var(ir_bytes, function_name, inner_cond_left, scanning_var,
        "compiled struct-cf: scan loop header must test the scanning flag first", bs);
    let inner_cond_right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, inner_cond, "right", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, inner_cond_right, "gt",
        "compiled struct-cf: scan loop header must guard '<cursor> > 0'", bs);
    let inner_gt_left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, inner_cond_right, "left", 0, bs);
    try cf_require_var(ir_bytes, function_name, inner_gt_left, cursor_var,
        "compiled struct-cf: scan loop header must compare the cursor", bs);
    let inner_gt_right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, inner_cond_right, "right", 0, bs);
    try cf_require_int(ir_bytes, function_name, inner_gt_right, 0,
        "compiled struct-cf: scan loop header must guard the cursor against 0", bs);

    // 'index = index + 1' is the outer counter increment.
    try cf_expect(ir_bytes, function_name, ob3, "Assign",
        "compiled struct-cf: outer loop must end with the counter increment", bs);
    let ob3_target = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob3, "target", 0, bs);
    try cf_require_var(ir_bytes, function_name, ob3_target, outer_var,
        "compiled struct-cf: outer increment must assign the counter", bs);
    let ob3_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob3, "value", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, ob3_value, "add",
        "compiled struct-cf: outer increment must be '<counter> + 1'", bs);
    let ob3_add_left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob3_value, "left", 0, bs);
    try cf_require_var(ir_bytes, function_name, ob3_add_left, outer_var,
        "compiled struct-cf: outer increment must add to the counter", bs);
    let ob3_add_right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob3_value, "right", 0, bs);
    try cf_require_int(ir_bytes, function_name, ob3_add_right, 1,
        "compiled struct-cf: outer increment must add exactly 1", bs);

    // Inner scan loop body: two Array.get reads, then the comparator if/else.
    let inner_body = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ob2, "body", 0, bs);
    if (try cf_block_statement_count(ir_bytes, function_name, inner_body, bs)) != 3 {
        return error("compiled struct-cf: scan body must be two reads and a comparator if");
    }
    let ib0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, inner_body, "statement", 0, bs);
    let ib1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, inner_body, "statement", 1, bs);
    let ib2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, inner_body, "statement", 2, bs);

    try cf_expect(ir_bytes, function_name, ib0, "Let",
        "compiled struct-cf: scan body must bind the left element", bs);
    let left_name_node = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib0, "name", 0, bs);
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_name_node, bs);
    let ib0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib0, "value", 0, bs);
    let ib0_call = try cf_call_under_try(ir_bytes, function_name, ib0_value, bs);
    let ib0_recv = try cf_method_receiver_name(ir_bytes, function_name, ib0_call, "get", bs);
    if !std::mem::equal_bytes(ib0_recv, arr_name) {
        return error("compiled struct-cf: left read must target the sorted array");
    }
    try cf_require_call_argc(ir_bytes, function_name, ib0_call, 1,
        "compiled struct-cf: left read must take a single index", bs);
    let ib0_index = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib0_call, "arg", 0, bs);
    try cf_require_cursor_decrement(ir_bytes, function_name, ib0_index, cursor_var,
        "compiled struct-cf: left read must index '<cursor> - 1'", bs);

    try cf_expect(ir_bytes, function_name, ib1, "Let",
        "compiled struct-cf: scan body must bind the right element", bs);
    let right_name_node = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib1, "name", 0, bs);
    let right_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, right_name_node, bs);
    let ib1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib1, "value", 0, bs);
    let ib1_call = try cf_call_under_try(ir_bytes, function_name, ib1_value, bs);
    let ib1_recv = try cf_method_receiver_name(ir_bytes, function_name, ib1_call, "get", bs);
    if !std::mem::equal_bytes(ib1_recv, arr_name) {
        return error("compiled struct-cf: right read must target the sorted array");
    }
    try cf_require_call_argc(ir_bytes, function_name, ib1_call, 1,
        "compiled struct-cf: right read must take a single index", bs);
    let ib1_index = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib1_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, ib1_index, cursor_var,
        "compiled struct-cf: right read must index the cursor", bs);

    try cf_expect(ir_bytes, function_name, ib2, "If",
        "compiled struct-cf: scan body must end with the comparator if", bs);
    let if_cond = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib2, "condition", 0, bs);
    let cmp_call = try cf_call_under_try(ir_bytes, function_name, if_cond, bs);

    // The comparator decides the swap, so the two scanned elements must reach it in the
    // order the hard-coded swap assumes: '<cmp>(..., <right>, <left>)' compares the high
    // slot against the low slot. The callee itself stays AST-driven (no name dispatch),
    // but the trailing two operands are pinned to the read locals so a reordered call is
    // an explicit error rather than a silently reversed sort.
    let cmp_argc = try compiled_mir_types::count_call_args(ir_bytes, function_name, cmp_call, bs);
    if cmp_argc < 2 {
        return error("compiled struct-cf: comparator must receive the two scanned elements");
    }
    let cmp_high = try ir_contract::body_child_sequence_from(ir_bytes, function_name, cmp_call, "arg", cmp_argc - 2, bs);
    try cf_require_var(ir_bytes, function_name, cmp_high, right_name,
        "compiled struct-cf: comparator must take the high slot ('<right>') first", bs);
    let cmp_low = try ir_contract::body_child_sequence_from(ir_bytes, function_name, cmp_call, "arg", cmp_argc - 1, bs);
    try cf_require_var(ir_bytes, function_name, cmp_low, left_name,
        "compiled struct-cf: comparator must take the low slot ('<left>') second", bs);

    let if_then = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib2, "then", 0, bs);
    let if_else = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ib2, "else", 0, bs);
    if (try cf_block_statement_count(ir_bytes, function_name, if_then, bs)) != 3 {
        return error("compiled struct-cf: comparator then-block must be swap, swap, cursor decrement");
    }
    if (try cf_block_statement_count(ir_bytes, function_name, if_else, bs)) != 1 {
        return error("compiled struct-cf: comparator else-block must stop the scan");
    }

    // Then-block swaps: 'try <arr>.set(<cursor> - 1, <right>); try <arr>.set(<cursor>, <left>);'.
    let then0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, if_then, "statement", 0, bs);
    let then1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, if_then, "statement", 1, bs);
    let then2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, if_then, "statement", 2, bs);
    try cf_expect(ir_bytes, function_name, then0, "ExprStmt",
        "compiled struct-cf: swap statement must be a set call", bs);
    try cf_expect(ir_bytes, function_name, then1, "ExprStmt",
        "compiled struct-cf: swap statement must be a set call", bs);
    try cf_expect(ir_bytes, function_name, then2, "Assign",
        "compiled struct-cf: then-block must end with the cursor decrement", bs);

    // 'try <arr>.set(<cursor> - 1, <right>);' writes the smaller element low.
    let then0_expr = try ir_contract::body_child_sequence_from(ir_bytes, function_name, then0, "expr", 0, bs);
    let set0_call = try cf_call_under_try(ir_bytes, function_name, then0_expr, bs);
    let set0_recv = try cf_method_receiver_name(ir_bytes, function_name, set0_call, "set", bs);
    if !std::mem::equal_bytes(set0_recv, arr_name) {
        return error("compiled struct-cf: swap must target the sorted array");
    }
    try cf_require_call_argc(ir_bytes, function_name, set0_call, 2,
        "compiled struct-cf: low swap must take an index and a value", bs);
    let set0_index = try ir_contract::body_child_sequence_from(ir_bytes, function_name, set0_call, "arg", 0, bs);
    try cf_require_cursor_decrement(ir_bytes, function_name, set0_index, cursor_var,
        "compiled struct-cf: low swap must write index '<cursor> - 1'", bs);
    let set0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, set0_call, "arg", 1, bs);
    try cf_require_var(ir_bytes, function_name, set0_value, right_name,
        "compiled struct-cf: low swap must store the right element", bs);

    // 'try <arr>.set(<cursor>, <left>);' writes the larger element high.
    let then1_expr = try ir_contract::body_child_sequence_from(ir_bytes, function_name, then1, "expr", 0, bs);
    let set1_call = try cf_call_under_try(ir_bytes, function_name, then1_expr, bs);
    let set1_recv = try cf_method_receiver_name(ir_bytes, function_name, set1_call, "set", bs);
    if !std::mem::equal_bytes(set1_recv, arr_name) {
        return error("compiled struct-cf: swap must target the sorted array");
    }
    try cf_require_call_argc(ir_bytes, function_name, set1_call, 2,
        "compiled struct-cf: high swap must take an index and a value", bs);
    let set1_index = try ir_contract::body_child_sequence_from(ir_bytes, function_name, set1_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, set1_index, cursor_var,
        "compiled struct-cf: high swap must write the cursor index", bs);
    let set1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, set1_call, "arg", 1, bs);
    try cf_require_var(ir_bytes, function_name, set1_value, left_name,
        "compiled struct-cf: high swap must store the left element", bs);

    // 'cursor = cursor - 1' steps the scan toward the front.
    let then2_target = try ir_contract::body_child_sequence_from(ir_bytes, function_name, then2, "target", 0, bs);
    try cf_require_var(ir_bytes, function_name, then2_target, cursor_var,
        "compiled struct-cf: then-block must decrement the cursor", bs);
    let then2_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, then2, "value", 0, bs);
    try cf_require_cursor_decrement(ir_bytes, function_name, then2_value, cursor_var,
        "compiled struct-cf: cursor decrement must be '<cursor> - 1'", bs);

    // Else-block: 'scanning = false' stops the scan and re-merges into the loop.
    let else0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, if_else, "statement", 0, bs);
    try cf_expect(ir_bytes, function_name, else0, "Assign",
        "compiled struct-cf: else-block must stop the scan", bs);
    let else0_target = try ir_contract::body_child_sequence_from(ir_bytes, function_name, else0, "target", 0, bs);
    try cf_require_var(ir_bytes, function_name, else0_target, scanning_var,
        "compiled struct-cf: else-block must assign the scanning flag", bs);
    let else0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, else0, "value", 0, bs);
    try cf_require_bool(ir_bytes, function_name, else0_value, "false",
        "compiled struct-cf: else-block must set scanning to false", bs);

    // Final 'return;' must be a void return (its value child is the Empty node).
    let s2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 2, bs);
    let s2_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s2, "value", 0, bs);
    try cf_expect(ir_bytes, function_name, s2_value, "Empty",
        "compiled struct-cf: helper must end with a bare 'return;'", bs);

    // ---- Emit the define ----
    try cf_w(out, "define ");
    try cf_w(out, llvm_return_type);
    try cf_w(out, " @");
    try cf_w(out, llvm_symbol);
    try cf_w(out, "(");
    try compiled_signature::append_params_signature(out, params_spec);
    try cf_l(out, ") {");

    // Entry: pre-allocate the two element marshalling slots, then enter the outer loop.
    try cf_l(out, "entry:");
    try cf_w(out, "  %set0_slot = alloca ");
    try cf_l(out, element_llvm);
    try cf_w(out, "  %set1_slot = alloca ");
    try cf_l(out, element_llvm);
    try cf_l(out, "  br label %outer_head");

    // Outer loop head: phi the counter, test it against the array length.
    try cf_l(out, "outer_head:");
    try cf_w(out, "  %");
    try cf_w(out, outer_var);
    try cf_w(out, " = phi i64 [ ");
    try cf_w(out, outer_init);
    try cf_w(out, ", %entry ], [ %");
    try cf_w(out, outer_var);
    try cf_l(out, "_next, %outer_latch ]");
    try cf_w(out, "  %outer_len = call i64 @kizu_rt_array_len(");
    try cf_w(out, recv_type);
    try cf_w(out, " %");
    try cf_w(out, arr_name);
    try cf_l(out, ")");
    try cf_w(out, "  %outer_cond = icmp slt i64 %");
    try cf_w(out, outer_var);
    try cf_l(out, ", %outer_len");
    try cf_l(out, "  br i1 %outer_cond, label %outer_body, label %outer_exit");

    // Outer body just seeds the inner loop preheader edge.
    try cf_l(out, "outer_body:");
    try cf_l(out, "  br label %inner_head");

    // Inner loop head: phi the cursor and scanning flag, test 'scanning and cursor > 0'.
    try cf_l(out, "inner_head:");
    try cf_w(out, "  %");
    try cf_w(out, cursor_var);
    try cf_w(out, " = phi i64 [ %");
    try cf_w(out, outer_var);
    try cf_w(out, ", %outer_body ], [ %");
    try cf_w(out, cursor_var);
    try cf_l(out, "_next, %inner_latch ]");
    try cf_w(out, "  %");
    try cf_w(out, scanning_var);
    try cf_l(out, " = phi i1 [ true, %outer_body ], [ %scanning_next, %inner_latch ]");
    try cf_w(out, "  %cursor_gt0 = icmp sgt i64 %");
    try cf_w(out, cursor_var);
    try cf_l(out, ", 0");
    try cf_w(out, "  %inner_cond = and i1 %");
    try cf_w(out, scanning_var);
    try cf_l(out, ", %cursor_gt0");
    try cf_l(out, "  br i1 %inner_cond, label %inner_body, label %inner_exit");

    // Inner body: compute cursor - 1, read the two elements, run the comparator if.
    try cf_l(out, "inner_body:");
    try cf_w(out, "  %");
    try cf_w(out, cursor_var);
    try cf_w(out, "_m1 = sub i64 %");
    try cf_w(out, cursor_var);
    try cf_l(out, ", 1");
    try cf_emit_get(out, left_name, arr_name, recv_type, element_llvm, llvm_return_type, cursor_var, "_m1");
    try cf_emit_get(out, right_name, arr_name, recv_type, element_llvm, llvm_return_type, cursor_var, "");
    try cf_emit_cmp_call(
        out, ir_bytes, function_name, module_prefix, params_spec, element_llvm,
        llvm_return_type, cmp_call, bs
    );

    // Then-block: swap the two slots and decrement the cursor.
    try cf_l(out, "if_then:");
    try cf_emit_set(out, "set0", arr_name, recv_type, element_llvm, llvm_return_type,
        cursor_var, "_m1", right_name, "");
    try cf_emit_set(out, "set1", arr_name, recv_type, element_llvm, llvm_return_type,
        cursor_var, "", left_name, "");
    try cf_w(out, "  %");
    try cf_w(out, cursor_var);
    try cf_w(out, "_dec = sub i64 %");
    try cf_w(out, cursor_var);
    try cf_l(out, ", 1");
    try cf_l(out, "  br label %inner_latch");

    // Else-block: stop scanning.
    try cf_l(out, "if_else:");
    try cf_l(out, "  br label %inner_latch");

    // Inner latch: merge the cursor / scanning flag and loop back to the scan head.
    try cf_l(out, "inner_latch:");
    try cf_w(out, "  %");
    try cf_w(out, cursor_var);
    try cf_w(out, "_next = phi i64 [ %");
    try cf_w(out, cursor_var);
    try cf_w(out, "_dec, %set1_cont ], [ %");
    try cf_w(out, cursor_var);
    try cf_l(out, ", %if_else ]");
    try cf_w(out, "  %scanning_next = phi i1 [ %");
    try cf_w(out, scanning_var);
    try cf_l(out, ", %set1_cont ], [ false, %if_else ]");
    try cf_l(out, "  br label %inner_head");

    // Inner exit flows into the outer latch.
    try cf_l(out, "inner_exit:");
    try cf_l(out, "  br label %outer_latch");

    // Outer latch: advance the counter and loop back.
    try cf_l(out, "outer_latch:");
    try cf_w(out, "  %");
    try cf_w(out, outer_var);
    try cf_w(out, "_next = add i64 %");
    try cf_w(out, outer_var);
    try cf_l(out, ", 1");
    try cf_l(out, "  br label %outer_head");

    // Outer exit: return the void success union.
    try cf_l(out, "outer_exit:");
    try cf_w(out, "  %ret_ok = insertvalue ");
    try cf_w(out, llvm_return_type);
    try cf_l(out, " zeroinitializer, i1 true, 0");
    try cf_w(out, "  ret ");
    try cf_w(out, llvm_return_type);
    try cf_l(out, " %ret_ok");
    try cf_l(out, "}");
    try out.append_byte(cast<u8>(10));
    return;
}

// cf_require_len_call validates that a node is a zero-argument '<arr_name>.len()' call and
// raises 'message' on any deviation. Both the loop-header bound and the loop-terminating
// '<index> = <arr_name>.len()' assignment share this shape.
fn cf_require_len_call(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    arr_name: []u8,
    message: []u8,
    bs: i64
) -> !void {
    let receiver = try cf_method_receiver_name(ir_bytes, function_name, call_node, "len", bs);
    if !std::mem::equal_bytes(receiver, arr_name) {
        return error(message);
    }
    try cf_require_call_argc(ir_bytes, function_name, call_node, 0, message, bs);
    return;
}

// cf_var_arg_type resolves the LLVM type of a referenced call-argument local. A parameter
// keeps its recorded signature type; the runtime-owned indices array carries '%kizu.owned';
// the loop counter carries 'i64'. Every other name is an explicit error so the emitter never
// marshals an unclassified local.
fn cf_var_arg_type(
    params_spec: []u8,
    index_var: []u8,
    indices_var: []u8,
    name: []u8
) -> ![]u8 {
    let ptype = cf_param_type_or_empty(params_spec, name);
    if std::mem::len(ptype) > 0 {
        return ptype;
    }
    if std::mem::equal_bytes(name, indices_var) {
        return "%kizu.owned";
    }
    if std::mem::equal_bytes(name, index_var) {
        return "i64";
    }
    return error("compiled struct-cf: unresolved call-argument local");
}

// cf_emit_call_args emits a comma-separated '<type> %<name>' argument list off the AST. Each
// argument is a Var, or a '&var'/'&' borrow Prefix whose operand is a Var (the mutable array
// handle passed to the sort helper); the operand name is resolved to its LLVM type through
// cf_var_arg_type, so an owned array handle and an i64 counter marshal without a per-callee
// table.
fn cf_emit_call_args(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    params_spec: []u8,
    index_var: []u8,
    indices_var: []u8,
    call_node: i64,
    bs: i64
) -> !void {
    let argc = try compiled_mir_types::count_call_args(ir_bytes, function_name, call_node, bs);
    var ai = 0;
    while ai < argc {
        let arg = try ir_contract::body_child_sequence_from(ir_bytes, function_name, call_node, "arg", ai, bs);
        var name_node = arg;
        if try cf_kind_is(ir_bytes, function_name, arg, "Prefix", bs) {
            name_node = try ir_contract::body_child_sequence_from(ir_bytes, function_name, arg, "right", 0, bs);
        }
        try cf_expect(ir_bytes, function_name, name_node, "Var",
            "compiled struct-cf: call argument must be a variable or a borrow of one", bs);
        let name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
        let atype = try cf_var_arg_type(params_spec, index_var, indices_var, name);
        if ai > 0 {
            try cf_w(out, ", ");
        }
        try cf_w(out, atype);
        try cf_w(out, " %");
        try cf_w(out, name);
        ai = ai + 1;
    }
    return;
}

// cf_emit_owned_try_call lowers 'try <callee>(<args>);' for a helper whose error union carries
// no payload value (a '!void' helper) or whose payload is discarded: it calls the helper,
// branches on the ok flag, propagates a failure as this function's own error union, and leaves
// the '<prefix>_cont' block current. The callee symbol, error-union type and argument types are
// all derived from the AST, so no callee name is special-cased.
fn cf_emit_void_try_call(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    ret_type: []u8,
    index_var: []u8,
    indices_var: []u8,
    prefix: []u8,
    call_node: i64,
    bs: i64
) -> !void {
    let callee = try ir_contract::body_call_callee_or_empty_from(ir_bytes, function_name, call_node, bs);
    let call_eu = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_call = call ");
    try cf_w(out, call_eu);
    try cf_w(out, " @");
    try compiled_signature::derive_callee_llvm_symbol(out, module_prefix, callee);
    try cf_w(out, "(");
    try cf_emit_call_args(out, ir_bytes, function_name, params_spec, index_var, indices_var, call_node, bs);
    try cf_l(out, ")");
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_ok = extractvalue ");
    try cf_w(out, call_eu);
    try cf_w(out, " %");
    try cf_w(out, prefix);
    try cf_l(out, "_call, 0");
    try cf_w(out, "  br i1 %");
    try cf_w(out, prefix);
    try cf_w(out, "_ok, label %");
    try cf_w(out, prefix);
    try cf_w(out, "_cont, label %");
    try cf_w(out, prefix);
    try cf_l(out, "_fail");
    try cf_w(out, prefix);
    try cf_l(out, "_fail:");
    // The borrowed message lives in the trailing field of the callee error union: field 1 for
    // the payload-free %kizu.error.void, field 2 for a value-carrying union (e.g. the
    // %kizu.error.i64 of the index-advance helper, whose i64 payload occupies field 1).
    try cf_w(out, "  %");
    try cf_w(out, prefix);
    try cf_w(out, "_msg = extractvalue ");
    try cf_w(out, call_eu);
    try cf_w(out, " %");
    try cf_w(out, prefix);
    try cf_w(out, "_call, ");
    try std::fmt::append_i64(out, cf_own_fail_msg_field(call_eu));
    try cf_l(out, "");
    try cf_emit_own_fail(out, ret_type, prefix, prefix, "_msg");
    try cf_w(out, prefix);
    try cf_l(out, "_cont:");
    return;
}

// append_leading_import_function emits the full define for the leading-import collector. It
// re-reads and validates the whole skeleton off the AST, then renders the basic-block / phi
// control flow: a runtime-owned Array<T> constructor, an outer scan loop carrying an i64
// counter through a loop-head phi, a checked Array<Token>.get element read, a boolean
// predicate that selects between a loop-terminating 'index = tokens.len()' and an
// append-then-advance branch, an if/else that re-merges at '%scan_latch' via a phi, a try-call
// to the index-advance helper, a try-call to the in-place sort helper, and a '%kizu.error.owned'
// success wrap returning the filled array. Any unsupported deviation is an explicit error.
pub fn append_leading_import_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !void {
    let module_prefix = compiled_util::module_prefix_of(function_name);

    // Statement 0: 'var <indices> = std::array::Array<T>(<allocator>);'. The constructor's
    // element <T> sets the runtime element width and the array local carries '%kizu.owned';
    // the constructor takes exactly the allocator, which the runtime call forwards.
    let s0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 0, bs);
    let s0_name = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0, "name", 0, bs);
    let indices_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, s0_name, bs);
    let s0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0, "value", 0, bs);
    try cf_expect(ir_bytes, function_name, s0_value, "Call",
        "compiled struct-cf: leading-import collector must open with the array constructor", bs);
    let ctor_callee = try ir_contract::body_call_callee_or_empty_from(ir_bytes, function_name, s0_value, bs);
    let indices_element_llvm = try cf_ctor_element_llvm(ir_bytes, module_prefix, ctor_callee);
    try cf_require_call_argc(ir_bytes, function_name, s0_value, 1,
        "compiled struct-cf: array constructor takes exactly the allocator argument", bs);
    let ctor_arg = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0_value, "arg", 0, bs);
    try cf_expect(ir_bytes, function_name, ctor_arg, "Var",
        "compiled struct-cf: array constructor argument must be the allocator local", bs);
    let allocator_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, ctor_arg, bs);
    let allocator_type = cf_param_type_or_empty(params_spec, allocator_name);
    if std::mem::len(allocator_type) == 0 {
        return error("compiled struct-cf: array constructor allocator must be a parameter");
    }

    // Statement 1: 'var <index> = <int>;' seeds the scan counter; its literal feeds the
    // loop-head phi's entry edge.
    let s1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 1, bs);
    let s1_name = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "name", 0, bs);
    let index_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, s1_name, bs);
    let s1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "value", 0, bs);
    try cf_expect(ir_bytes, function_name, s1_value, "Int",
        "compiled struct-cf: scan counter must be initialized to an integer literal", bs);
    let index_init = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, s1_value, bs);

    // Statement 2: 'while <index> < <tokens>.len() { ... }'.
    let s2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 2, bs);
    let scan_cond = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s2, "condition", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, scan_cond, "lt",
        "compiled struct-cf: scan loop condition must be '<index> < <tokens>.len()'", bs);
    let scan_cond_left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_cond, "left", 0, bs);
    try cf_require_var(ir_bytes, function_name, scan_cond_left, index_var,
        "compiled struct-cf: scan loop must compare the counter on the left", bs);
    let scan_cond_right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_cond, "right", 0, bs);
    let arr_name = try cf_method_receiver_name(ir_bytes, function_name, scan_cond_right, "len", bs);
    try cf_require_call_argc(ir_bytes, function_name, scan_cond_right, 0,
        "compiled struct-cf: token length call takes no arguments", bs);
    let recv_type = cf_param_type_or_empty(params_spec, arr_name);
    if std::mem::len(recv_type) == 0 {
        return error("compiled struct-cf: token array receiver must be a parameter");
    }
    let token_element_llvm = try cf_array_element_llvm(
        ir_bytes, function_name, module_prefix, params_spec, arr_name, bs
    );

    // Scan body: a checked element read then the predicate if/else.
    let scan_body = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s2, "body", 0, bs);
    if (try cf_block_statement_count(ir_bytes, function_name, scan_body, bs)) != 2 {
        return error("compiled struct-cf: scan body must be the token read and the predicate if");
    }
    let wb0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_body, "statement", 0, bs);
    let wb1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_body, "statement", 1, bs);

    // 'let <token> = try <tokens>.get(<index>);'.
    try cf_expect(ir_bytes, function_name, wb0, "Let",
        "compiled struct-cf: scan body must bind the current token", bs);
    let token_name_node = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb0, "name", 0, bs);
    let token_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, token_name_node, bs);
    let wb0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb0, "value", 0, bs);
    let wb0_call = try cf_call_under_try(ir_bytes, function_name, wb0_value, bs);
    let wb0_recv = try cf_method_receiver_name(ir_bytes, function_name, wb0_call, "get", bs);
    if !std::mem::equal_bytes(wb0_recv, arr_name) {
        return error("compiled struct-cf: token read must target the token array");
    }
    try cf_require_call_argc(ir_bytes, function_name, wb0_call, 1,
        "compiled struct-cf: token read must take a single index", bs);
    let wb0_index = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb0_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, wb0_index, index_var,
        "compiled struct-cf: token read must index the scan counter", bs);

    // 'if !<pred>(<token>) { ... } else { ... }'.
    try cf_expect(ir_bytes, function_name, wb1, "If",
        "compiled struct-cf: scan body must end with the import predicate if", bs);
    let if_cond = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb1, "condition", 0, bs);
    try cf_expect(ir_bytes, function_name, if_cond, "Prefix",
        "compiled struct-cf: predicate must be negated with '!'", bs);
    let if_cond_op = try ir_contract::sequence_fact_value_from(ir_bytes, "body-prefix ", function_name, if_cond, bs);
    if !std::mem::equal_bytes(if_cond_op, "not") {
        return error("compiled struct-cf: predicate must be negated with '!'");
    }
    let pred_call = try ir_contract::body_child_sequence_from(ir_bytes, function_name, if_cond, "right", 0, bs);
    try cf_expect(ir_bytes, function_name, pred_call, "Call",
        "compiled struct-cf: predicate must be a call", bs);
    let pred_callee = try ir_contract::body_call_callee_or_empty_from(ir_bytes, function_name, pred_call, bs);
    let pred_ret = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, pred_call, bs
    );
    try cf_require_call_argc(ir_bytes, function_name, pred_call, 1,
        "compiled struct-cf: predicate takes the current token", bs);
    let pred_arg = try ir_contract::body_child_sequence_from(ir_bytes, function_name, pred_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, pred_arg, token_var,
        "compiled struct-cf: predicate must test the current token", bs);

    // Then-block (predicate false): 'index = tokens.len();' terminates the scan.
    let if_then = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb1, "then", 0, bs);
    let if_else = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb1, "else", 0, bs);
    if (try cf_block_statement_count(ir_bytes, function_name, if_then, bs)) != 1 {
        return error("compiled struct-cf: predicate then-block must stop the scan via the token length");
    }
    if (try cf_block_statement_count(ir_bytes, function_name, if_else, bs)) != 2 {
        return error("compiled struct-cf: predicate else-block must append the index then advance it");
    }
    let then0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, if_then, "statement", 0, bs);
    try cf_expect(ir_bytes, function_name, then0, "Assign",
        "compiled struct-cf: predicate then-block must assign the scan counter", bs);
    let then0_target = try ir_contract::body_child_sequence_from(ir_bytes, function_name, then0, "target", 0, bs);
    try cf_require_var(ir_bytes, function_name, then0_target, index_var,
        "compiled struct-cf: scan terminator must assign the counter", bs);
    let then0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, then0, "value", 0, bs);
    try cf_require_len_call(ir_bytes, function_name, then0_value, arr_name,
        "compiled struct-cf: scan terminator must be '<index> = <tokens>.len()'", bs);

    // Else-block: 'try <indices>.append(<index>);' then 'index = try <helper>(<tokens>, <index>);'.
    let else0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, if_else, "statement", 0, bs);
    try cf_expect(ir_bytes, function_name, else0, "ExprStmt",
        "compiled struct-cf: else-block must begin with the index append", bs);
    let else0_expr = try ir_contract::body_child_sequence_from(ir_bytes, function_name, else0, "expr", 0, bs);
    let append_call = try cf_call_under_try(ir_bytes, function_name, else0_expr, bs);
    let append_recv = try cf_method_receiver_name(ir_bytes, function_name, append_call, "append", bs);
    if !std::mem::equal_bytes(append_recv, indices_var) {
        return error("compiled struct-cf: append must target the indices array");
    }
    try cf_require_call_argc(ir_bytes, function_name, append_call, 1,
        "compiled struct-cf: append must take the scan counter", bs);
    let append_arg = try ir_contract::body_child_sequence_from(ir_bytes, function_name, append_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, append_arg, index_var,
        "compiled struct-cf: append must store the scan counter", bs);

    let else1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, if_else, "statement", 1, bs);
    try cf_expect(ir_bytes, function_name, else1, "Assign",
        "compiled struct-cf: else-block must advance the scan counter", bs);
    let else1_target = try ir_contract::body_child_sequence_from(ir_bytes, function_name, else1, "target", 0, bs);
    try cf_require_var(ir_bytes, function_name, else1_target, index_var,
        "compiled struct-cf: scan advance must assign the counter", bs);
    let else1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, else1, "value", 0, bs);
    let advance_call = try cf_call_under_try(ir_bytes, function_name, else1_value, bs);
    try cf_require_call_argc(ir_bytes, function_name, advance_call, 2,
        "compiled struct-cf: scan advance helper takes the tokens and the counter", bs);
    let advance_arg0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, advance_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, advance_arg0, arr_name,
        "compiled struct-cf: scan advance must pass the token array first", bs);
    let advance_arg1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, advance_call, "arg", 1, bs);
    try cf_require_var(ir_bytes, function_name, advance_arg1, index_var,
        "compiled struct-cf: scan advance must pass the scan counter second", bs);

    // Statement 3: 'try sort_import_indices(source, tokens, &var indices);' sorts the collected
    // indices in place. Every operand is pinned here: the in-place sort takes the source slice,
    // the token array, and the mutable indices handle, but %kizu.owned cannot distinguish the
    // Array<Token> tokens handle from the Array<i64> indices handle at the LLVM level, so a
    // near-miss like '&var tokens' (or a reordered / wrongly-borrowed operand) would emit a
    // type-valid call that silently mis-lowers. The callee symbol stays AST-driven (no name
    // dispatch); the arity, the source/tokens parameters, and the '&var <indices>' borrow are
    // pinned so any deviation is an explicit error rather than a silent mis-lowering.
    let s3 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 3, bs);
    let s3_expr = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s3, "expr", 0, bs);
    let sort_call = try cf_call_under_try(ir_bytes, function_name, s3_expr, bs);
    try cf_require_call_argc(ir_bytes, function_name, sort_call, 3,
        "compiled struct-cf: sort call takes the source, the token array, and the indices handle", bs);
    let source_name = cf_nth_param_name(params_spec, 1);
    if std::mem::len(source_name) == 0 {
        return error("compiled struct-cf: sort call requires the source parameter");
    }
    let sort_arg0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, sort_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, sort_arg0, source_name,
        "compiled struct-cf: sort call must pass the source first", bs);
    let sort_arg1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, sort_call, "arg", 1, bs);
    try cf_require_var(ir_bytes, function_name, sort_arg1, arr_name,
        "compiled struct-cf: sort call must pass the token array second", bs);
    let sort_arg2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, sort_call, "arg", 2, bs);
    try cf_expect(ir_bytes, function_name, sort_arg2, "Prefix",
        "compiled struct-cf: sort call must pass the indices array by mutable borrow", bs);
    let sort_arg2_op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-prefix ", function_name, sort_arg2, bs
    );
    if !std::mem::equal_bytes(sort_arg2_op, "mut-borrow") and
        !std::mem::equal_bytes(sort_arg2_op, "borrow") {
        return error("compiled struct-cf: sort call indices argument must be a borrow, not another prefix");
    }
    let sort_arg2_inner = try ir_contract::body_child_sequence_from(ir_bytes, function_name, sort_arg2, "right", 0, bs);
    try cf_require_var(ir_bytes, function_name, sort_arg2_inner, indices_var,
        "compiled struct-cf: sort call must borrow the constructed indices array", bs);

    // Statement 4: 'return <indices>;' hands back the filled array as the !Array success.
    let s4 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 4, bs);
    let s4_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s4, "value", 0, bs);
    try cf_require_var(ir_bytes, function_name, s4_value, indices_var,
        "compiled struct-cf: collector must return the filled indices array", bs);

    // ---- Emit the define ----
    try cf_w(out, "define ");
    try cf_w(out, llvm_return_type);
    try cf_w(out, " @");
    try cf_w(out, llvm_symbol);
    try cf_w(out, "(");
    try compiled_signature::append_params_signature(out, params_spec);
    try cf_l(out, ") {");

    // Entry: pre-allocate the append marshalling slot, build the runtime array, enter the loop.
    try cf_l(out, "entry:");
    try cf_w(out, "  %app_slot = alloca ");
    try cf_l(out, indices_element_llvm);
    try cf_w(out, "  %");
    try cf_w(out, indices_var);
    try cf_w(out, " = call %kizu.owned @kizu_rt_array_new(");
    try cf_w(out, allocator_type);
    try cf_w(out, " %");
    try cf_w(out, allocator_name);
    try cf_w(out, ", i64 ptrtoint (ptr getelementptr (");
    try cf_w(out, indices_element_llvm);
    try cf_l(out, ", ptr null, i32 1) to i64))");
    try cf_l(out, "  br label %scan_head");

    // Scan head: phi the counter, test it against the token length.
    try cf_l(out, "scan_head:");
    try cf_w(out, "  %");
    try cf_w(out, index_var);
    try cf_w(out, " = phi i64 [ ");
    try cf_w(out, index_init);
    try cf_w(out, ", %entry ], [ %");
    try cf_w(out, index_var);
    try cf_l(out, "_next, %scan_latch ]");
    try cf_w(out, "  %scan_len = call i64 @kizu_rt_array_len(");
    try cf_w(out, recv_type);
    try cf_w(out, " %");
    try cf_w(out, arr_name);
    try cf_l(out, ")");
    try cf_w(out, "  %scan_cond = icmp slt i64 %");
    try cf_w(out, index_var);
    try cf_l(out, ", %scan_len");
    try cf_l(out, "  br i1 %scan_cond, label %scan_body, label %scan_exit");

    // Scan body: read the current token, then run the import predicate branch.
    try cf_l(out, "scan_body:");
    try cf_emit_get(out, token_var, arr_name, recv_type, token_element_llvm, llvm_return_type, index_var, "");
    try cf_w(out, "  %pred = call ");
    try cf_w(out, pred_ret);
    try cf_w(out, " @");
    try compiled_signature::derive_callee_llvm_symbol(out, module_prefix, pred_callee);
    try cf_w(out, "(");
    try cf_w(out, token_element_llvm);
    try cf_w(out, " %");
    try cf_w(out, token_var);
    try cf_l(out, ")");
    // The source guard is '!<pred>', so a true predicate (an import) takes the else branch and a
    // false predicate terminates the scan in the then branch.
    try cf_l(out, "  br i1 %pred, label %lii_else, label %lii_then");

    // Then-block (not an import): terminate the scan by stepping the counter to the token length.
    try cf_l(out, "lii_then:");
    try cf_w(out, "  %then_len = call i64 @kizu_rt_array_len(");
    try cf_w(out, recv_type);
    try cf_w(out, " %");
    try cf_w(out, arr_name);
    try cf_l(out, ")");
    try cf_l(out, "  br label %scan_latch");

    // Else-block (an import): append the index, then advance past the import via the try-call.
    try cf_l(out, "lii_else:");
    try cf_emit_append(out, "app", indices_var, "%kizu.owned", indices_element_llvm,
        llvm_return_type, index_var, "");
    try cf_emit_void_try_call(
        out, ir_bytes, function_name, module_prefix, params_spec, llvm_return_type,
        index_var, indices_var, "iai", advance_call, bs
    );
    try cf_w(out, "  %iai_val = extractvalue ");
    try cf_append_call_eu_type(out, ir_bytes, function_name, module_prefix, advance_call, bs);
    try cf_l(out, " %iai_call, 1");
    try cf_l(out, "  br label %scan_latch");

    // Scan latch: merge the next counter from the two branches and loop back to the head.
    try cf_l(out, "scan_latch:");
    try cf_w(out, "  %");
    try cf_w(out, index_var);
    try cf_l(out, "_next = phi i64 [ %then_len, %lii_then ], [ %iai_val, %iai_cont ]");
    try cf_l(out, "  br label %scan_head");

    // Scan exit: sort the collected indices in place, then return the filled array.
    try cf_l(out, "scan_exit:");
    try cf_emit_void_try_call(
        out, ir_bytes, function_name, module_prefix, params_spec, llvm_return_type,
        index_var, indices_var, "sort", sort_call, bs
    );
    try cf_w(out, "  %ret_ok0 = insertvalue ");
    try cf_w(out, llvm_return_type);
    try cf_l(out, " poison, i1 true, 0");
    try cf_w(out, "  %ret_ok1 = insertvalue ");
    try cf_w(out, llvm_return_type);
    try cf_w(out, " %ret_ok0, %kizu.owned %");
    try cf_w(out, indices_var);
    try cf_l(out, ", 1");
    try cf_w(out, "  %ret_ok2 = insertvalue ");
    try cf_w(out, llvm_return_type);
    try cf_l(out, " %ret_ok1, %kizu.slice.u8 zeroinitializer, 2");
    try cf_w(out, "  ret ");
    try cf_w(out, llvm_return_type);
    try cf_l(out, " %ret_ok2");
    try cf_l(out, "}");
    try out.append_byte(cast<u8>(10));
    return;
}

// cf_append_call_eu_type writes the lowered error-union return type of a call to 'out', so the
// i64-payload extractvalue after the index-advance try-call reads the same union type the call
// emitted (the value lives in field 1, the message in field 2).
fn cf_append_call_eu_type(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> !void {
    let call_eu = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    try cf_w(out, call_eu);
    return;
}

// cf_string_append_arg validates a 'try <out_name>.<method>(<arg>);' ExprStmt against the out
// accumulator and returns the single argument node id, so the caller can pin it as a string
// literal (append_bytes "import " / ";") or a slice local (append_bytes <text>). The receiver,
// the try-call wrapping, the method name, and the single-argument arity are all explicit errors
// on a near-miss.
fn cf_string_append_arg(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_node: i64,
    out_name: []u8,
    method: []u8,
    message: []u8,
    bs: i64
) -> !i64 {
    try cf_expect(ir_bytes, function_name, stmt_node, "ExprStmt", message, bs);
    let expr = try ir_contract::body_child_sequence_from(ir_bytes, function_name, stmt_node, "expr", 0, bs);
    let call = try cf_call_under_try(ir_bytes, function_name, expr, bs);
    let recv = try cf_method_receiver_name(ir_bytes, function_name, call, method, bs);
    if !std::mem::equal_bytes(recv, out_name) {
        return error(message);
    }
    try cf_require_call_argc(ir_bytes, function_name, call, 1, message, bs);
    return try ir_contract::body_child_sequence_from(ir_bytes, function_name, call, "arg", 0, bs);
}

// cf_emit_void_success_ret writes the '%<value_name> = insertvalue <ret_type> zeroinitializer, i1
// true, 0' / 'ret' pair that returns the bare-'return;' void success. The value SSA name is
// caller-supplied so the same shape can terminate more than one block (the early ';' return and
// the loop-exit return) without colliding SSA names.
fn cf_emit_void_success_ret(
    out: &var std::string::String,
    ret_type: []u8,
    value_name: []u8
) -> !void {
    try cf_w(out, "  %");
    try cf_w(out, value_name);
    try cf_w(out, " = insertvalue ");
    try cf_w(out, ret_type);
    try cf_l(out, " zeroinitializer, i1 true, 0");
    try cf_w(out, "  ret ");
    try cf_w(out, ret_type);
    try cf_w(out, " %");
    try cf_l(out, value_name);
    return;
}

// cf_emit_token_predicate emits a single-token boolean predicate call ('%<result> = call i1
// @<callee>(<token_llvm> %<token>)') off the AST: the callee symbol, return type and the token
// operand type are all derived from the call node, so no predicate name is special-cased.
fn cf_emit_token_predicate(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    result_name: []u8,
    call_node: i64,
    token_llvm: []u8,
    token_var: []u8,
    bs: i64
) -> !void {
    let callee = try ir_contract::body_call_callee_or_empty_from(ir_bytes, function_name, call_node, bs);
    let pred_ret = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    try cf_w(out, "  %");
    try cf_w(out, result_name);
    try cf_w(out, " = call ");
    try cf_w(out, pred_ret);
    try cf_w(out, " @");
    try compiled_signature::derive_callee_llvm_symbol(out, module_prefix, callee);
    try cf_w(out, "(");
    try cf_w(out, token_llvm);
    try cf_w(out, " %");
    try cf_w(out, token_var);
    try cf_l(out, ")");
    return;
}

// append_import_decl_function emits the full define for the single-import emitter. It re-reads
// and validates the whole skeleton off the AST, then renders the basic-block / phi control flow:
// a leading 'import ' string-literal append, a 'var index = import_index + 1' preheader seed, an
// outer scan loop carrying the i64 counter through a loop-head phi, a checked Array<Token>.get
// element read, a token_text slice read, an early-return ';' append guarded by the semicolon
// predicate, a fall-through text append guarded by the 'ident or double-colon' boolean-or, and a
// bare '%kizu.error.void' success. The 'import ' / ';' literals are emitted as module-level
// private constants and materialized into %kizu.slice.u8 operands for the @kizu_rt_string_append_*
// ABI. Any unsupported deviation is an explicit error.
pub fn append_import_decl_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !void {
    let module_prefix = compiled_util::module_prefix_of(function_name);

    // Statement 0: 'try <out>.append_bytes("import ");'. The accumulator is the first parameter
    // (the '&var std::string::String' handle, %kizu.owned); the literal seeds module-slot 0.
    let out_name = cf_nth_param_name(params_spec, 0);
    if std::mem::len(out_name) == 0 {
        return error("compiled struct-cf: import emitter requires the out accumulator parameter");
    }
    if !std::mem::equal_bytes(cf_param_type_or_empty(params_spec, out_name), "%kizu.owned") {
        return error("compiled struct-cf: import emitter out accumulator must be a String handle");
    }
    let s0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 0, bs);
    let import_arg = try cf_string_append_arg(
        ir_bytes, function_name, s0, out_name, "append_bytes",
        "compiled struct-cf: import emitter must open with the 'import ' literal append", bs
    );
    try cf_expect(ir_bytes, function_name, import_arg, "String",
        "compiled struct-cf: import emitter prefix append must be a string literal", bs);
    let import_lit = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, import_arg, bs);

    // Statement 1: 'var <index> = <import_index> + 1;' seeds the scan counter from the import
    // index parameter; the materialized sum feeds the loop-head phi's entry edge.
    let s1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 1, bs);
    let s1_name = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "name", 0, bs);
    let index_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, s1_name, bs);
    let s1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "value", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, s1_value, "add",
        "compiled struct-cf: scan counter must be seeded as '<import_index> + 1'", bs);
    let s1_left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1_value, "left", 0, bs);
    try cf_expect(ir_bytes, function_name, s1_left, "Var",
        "compiled struct-cf: scan counter seed must add to the import index parameter", bs);
    let import_index_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, s1_left, bs);
    if !std::mem::equal_bytes(cf_param_type_or_empty(params_spec, import_index_name), "i64") {
        return error("compiled struct-cf: scan counter seed must add to an i64 import index parameter");
    }
    let s1_right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1_value, "right", 0, bs);
    try cf_require_int(ir_bytes, function_name, s1_right, 1,
        "compiled struct-cf: scan counter seed must add exactly 1", bs);

    // Statement 2: 'while <index> < <tokens>.len() { ... }'.
    let s2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 2, bs);
    let scan_cond = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s2, "condition", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, scan_cond, "lt",
        "compiled struct-cf: scan loop condition must be '<index> < <tokens>.len()'", bs);
    let scan_cond_left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_cond, "left", 0, bs);
    try cf_require_var(ir_bytes, function_name, scan_cond_left, index_var,
        "compiled struct-cf: scan loop must compare the counter on the left", bs);
    let scan_cond_right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_cond, "right", 0, bs);
    let arr_name = try cf_method_receiver_name(ir_bytes, function_name, scan_cond_right, "len", bs);
    try cf_require_call_argc(ir_bytes, function_name, scan_cond_right, 0,
        "compiled struct-cf: token length call takes no arguments", bs);
    let recv_type = cf_param_type_or_empty(params_spec, arr_name);
    if std::mem::len(recv_type) == 0 {
        return error("compiled struct-cf: token array receiver must be a parameter");
    }
    let token_element_llvm = try cf_array_element_llvm(
        ir_bytes, function_name, module_prefix, params_spec, arr_name, bs
    );

    // Scan body: the token read, the token_text slice read, the early-return semicolon if, the
    // fall-through ident/double-colon if, and the counter increment.
    let scan_body = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s2, "body", 0, bs);
    if (try cf_block_statement_count(ir_bytes, function_name, scan_body, bs)) != 5 {
        return error("compiled struct-cf: import emitter scan body must be read, text, semi-if, ident-if, increment");
    }
    let wb0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_body, "statement", 0, bs);
    let wb1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_body, "statement", 1, bs);
    let wb2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_body, "statement", 2, bs);
    let wb3 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_body, "statement", 3, bs);
    let wb4 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, scan_body, "statement", 4, bs);

    // 'let <token> = try <tokens>.get(<index>);'.
    try cf_expect(ir_bytes, function_name, wb0, "Let",
        "compiled struct-cf: scan body must bind the current token", bs);
    let token_name_node = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb0, "name", 0, bs);
    let token_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, token_name_node, bs);
    let wb0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb0, "value", 0, bs);
    let wb0_call = try cf_call_under_try(ir_bytes, function_name, wb0_value, bs);
    let wb0_recv = try cf_method_receiver_name(ir_bytes, function_name, wb0_call, "get", bs);
    if !std::mem::equal_bytes(wb0_recv, arr_name) {
        return error("compiled struct-cf: token read must target the token array");
    }
    try cf_require_call_argc(ir_bytes, function_name, wb0_call, 1,
        "compiled struct-cf: token read must take a single index", bs);
    let wb0_index = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb0_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, wb0_index, index_var,
        "compiled struct-cf: token read must index the scan counter", bs);

    // 'let <text> = <token_text>(<source>, <token>);'. The source slice is the second parameter.
    try cf_expect(ir_bytes, function_name, wb1, "Let",
        "compiled struct-cf: scan body must bind the token text", bs);
    let text_name_node = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb1, "name", 0, bs);
    let text_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, text_name_node, bs);
    let wb1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb1, "value", 0, bs);
    try cf_expect(ir_bytes, function_name, wb1_value, "Call",
        "compiled struct-cf: token text must be a token_text call", bs);
    let text_ret = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, wb1_value, bs
    );
    try cf_require_call_argc(ir_bytes, function_name, wb1_value, 2,
        "compiled struct-cf: token_text takes the source and the token", bs);
    let text_callee = try ir_contract::body_call_callee_or_empty_from(ir_bytes, function_name, wb1_value, bs);
    let source_name = cf_nth_param_name(params_spec, 1);
    if std::mem::len(source_name) == 0 {
        return error("compiled struct-cf: token_text requires the source parameter");
    }
    let source_type = cf_param_type_or_empty(params_spec, source_name);
    let text_arg0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb1_value, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, text_arg0, source_name,
        "compiled struct-cf: token_text must pass the source first", bs);
    let text_arg1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb1_value, "arg", 1, bs);
    try cf_require_var(ir_bytes, function_name, text_arg1, token_var,
        "compiled struct-cf: token_text must pass the current token second", bs);

    // 'if <semi>(<token>) { try <out>.append_bytes(";"); return; }'.
    try cf_expect(ir_bytes, function_name, wb2, "If",
        "compiled struct-cf: scan body must guard the semicolon early return", bs);
    let semi_cond = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb2, "condition", 0, bs);
    try cf_expect(ir_bytes, function_name, semi_cond, "Call",
        "compiled struct-cf: semicolon guard must be a predicate call", bs);
    try cf_require_call_argc(ir_bytes, function_name, semi_cond, 1,
        "compiled struct-cf: semicolon guard takes the current token", bs);
    let semi_arg = try ir_contract::body_child_sequence_from(ir_bytes, function_name, semi_cond, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, semi_arg, token_var,
        "compiled struct-cf: semicolon guard must test the current token", bs);
    let semi_then = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb2, "then", 0, bs);
    if (try cf_block_statement_count(ir_bytes, function_name, semi_then, bs)) != 2 {
        return error("compiled struct-cf: semicolon branch must append ';' then return");
    }
    let semi_then0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, semi_then, "statement", 0, bs);
    let semi_arg_node = try cf_string_append_arg(
        ir_bytes, function_name, semi_then0, out_name, "append_bytes",
        "compiled struct-cf: semicolon branch must append the ';' literal", bs
    );
    try cf_expect(ir_bytes, function_name, semi_arg_node, "String",
        "compiled struct-cf: semicolon branch append must be a string literal", bs);
    let semi_lit = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, semi_arg_node, bs);
    let semi_then1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, semi_then, "statement", 1, bs);
    try cf_expect(ir_bytes, function_name, semi_then1, "Return",
        "compiled struct-cf: semicolon branch must end with a return", bs);
    let semi_ret_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, semi_then1, "value", 0, bs);
    try cf_expect(ir_bytes, function_name, semi_ret_value, "Empty",
        "compiled struct-cf: semicolon branch return must be a bare 'return;'", bs);

    // 'if <ident>(<token>) or <colon>(<token>) { try <out>.append_bytes(<text>); }'.
    try cf_expect(ir_bytes, function_name, wb3, "If",
        "compiled struct-cf: scan body must guard the text append", bs);
    let ident_cond = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb3, "condition", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, ident_cond, "or",
        "compiled struct-cf: text guard must be 'ident or double-colon'", bs);
    let ident_call = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ident_cond, "left", 0, bs);
    try cf_expect(ir_bytes, function_name, ident_call, "Call",
        "compiled struct-cf: text guard left must be a predicate call", bs);
    try cf_require_call_argc(ir_bytes, function_name, ident_call, 1,
        "compiled struct-cf: text guard left takes the current token", bs);
    let ident_arg = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ident_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, ident_arg, token_var,
        "compiled struct-cf: text guard left must test the current token", bs);
    let colon_call = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ident_cond, "right", 0, bs);
    try cf_expect(ir_bytes, function_name, colon_call, "Call",
        "compiled struct-cf: text guard right must be a predicate call", bs);
    try cf_require_call_argc(ir_bytes, function_name, colon_call, 1,
        "compiled struct-cf: text guard right takes the current token", bs);
    let colon_arg = try ir_contract::body_child_sequence_from(ir_bytes, function_name, colon_call, "arg", 0, bs);
    try cf_require_var(ir_bytes, function_name, colon_arg, token_var,
        "compiled struct-cf: text guard right must test the current token", bs);
    let ident_then = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb3, "then", 0, bs);
    if (try cf_block_statement_count(ir_bytes, function_name, ident_then, bs)) != 1 {
        return error("compiled struct-cf: text branch must append the token text");
    }
    let ident_then0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, ident_then, "statement", 0, bs);
    let text_append_arg = try cf_string_append_arg(
        ir_bytes, function_name, ident_then0, out_name, "append_bytes",
        "compiled struct-cf: text branch must append the token text local", bs
    );
    try cf_require_var(ir_bytes, function_name, text_append_arg, text_var,
        "compiled struct-cf: text branch must append the token text local", bs);

    // 'index = index + 1' advances the scan counter.
    try cf_expect(ir_bytes, function_name, wb4, "Assign",
        "compiled struct-cf: scan body must end with the counter increment", bs);
    let wb4_target = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb4, "target", 0, bs);
    try cf_require_var(ir_bytes, function_name, wb4_target, index_var,
        "compiled struct-cf: counter increment must assign the scan counter", bs);
    let wb4_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb4, "value", 0, bs);
    try cf_require_binary_op(ir_bytes, function_name, wb4_value, "add",
        "compiled struct-cf: counter increment must be '<index> + 1'", bs);
    let wb4_add_left = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb4_value, "left", 0, bs);
    try cf_require_var(ir_bytes, function_name, wb4_add_left, index_var,
        "compiled struct-cf: counter increment must add to the scan counter", bs);
    let wb4_add_right = try ir_contract::body_child_sequence_from(ir_bytes, function_name, wb4_value, "right", 0, bs);
    try cf_require_int(ir_bytes, function_name, wb4_add_right, 1,
        "compiled struct-cf: counter increment must add exactly 1", bs);

    // ---- Emit the string-literal globals then the define ----
    try cf_emit_string_global(out, llvm_symbol, 0, import_lit);
    try cf_emit_string_global(out, llvm_symbol, 1, semi_lit);

    try cf_w(out, "define ");
    try cf_w(out, llvm_return_type);
    try cf_w(out, " @");
    try cf_w(out, llvm_symbol);
    try cf_w(out, "(");
    try compiled_signature::append_params_signature(out, params_spec);
    try cf_l(out, ") {");

    // Entry: append the 'import ' prefix, then seed the scan counter from 'import_index + 1'.
    try cf_l(out, "entry:");
    try cf_emit_string_literal_slice(out, llvm_symbol, 0, "imp", import_lit);
    try cf_emit_string_append(
        out, llvm_return_type, "imp", "kizu_rt_string_append_bytes", out_name,
        "%kizu.slice.u8", "%", "imp_slice"
    );
    try cf_w(out, "  %");
    try cf_w(out, index_var);
    try cf_w(out, "_init = add i64 %");
    try cf_w(out, import_index_name);
    try cf_l(out, ", 1");
    try cf_l(out, "  br label %scan_head");

    // Scan head: phi the counter, test it against the token length.
    try cf_l(out, "scan_head:");
    try cf_w(out, "  %");
    try cf_w(out, index_var);
    try cf_w(out, " = phi i64 [ %");
    try cf_w(out, index_var);
    try cf_w(out, "_init, %imp_cont ], [ %");
    try cf_w(out, index_var);
    try cf_l(out, "_next, %scan_latch ]");
    try cf_w(out, "  %scan_len = call i64 @kizu_rt_array_len(");
    try cf_w(out, recv_type);
    try cf_w(out, " %");
    try cf_w(out, arr_name);
    try cf_l(out, ")");
    try cf_w(out, "  %scan_cond = icmp slt i64 %");
    try cf_w(out, index_var);
    try cf_l(out, ", %scan_len");
    try cf_l(out, "  br i1 %scan_cond, label %scan_body, label %scan_exit");

    // Scan body: read the token, read its text, then guard the semicolon early return.
    try cf_l(out, "scan_body:");
    try cf_emit_get(out, token_var, arr_name, recv_type, token_element_llvm, llvm_return_type, index_var, "");
    try cf_w(out, "  %");
    try cf_w(out, text_var);
    try cf_w(out, " = call ");
    try cf_w(out, text_ret);
    try cf_w(out, " @");
    try compiled_signature::derive_callee_llvm_symbol(out, module_prefix, text_callee);
    try cf_w(out, "(");
    try cf_w(out, source_type);
    try cf_w(out, " %");
    try cf_w(out, source_name);
    try cf_w(out, ", ");
    try cf_w(out, token_element_llvm);
    try cf_w(out, " %");
    try cf_w(out, token_var);
    try cf_l(out, ")");
    try cf_emit_token_predicate(
        out, ir_bytes, function_name, module_prefix, "semi", semi_cond, token_element_llvm, token_var, bs
    );
    try cf_l(out, "  br i1 %semi, label %semi_then, label %semi_skip");

    // Semicolon branch: append ';' and return the void success.
    try cf_l(out, "semi_then:");
    try cf_emit_string_literal_slice(out, llvm_symbol, 1, "semi", semi_lit);
    try cf_emit_string_append(
        out, llvm_return_type, "semi", "kizu_rt_string_append_bytes", out_name,
        "%kizu.slice.u8", "%", "semi_slice"
    );
    try cf_emit_void_success_ret(out, llvm_return_type, "ret_semi");

    // Skip branch: guard the text append with the short-circuit 'ident or double-colon'.
    try cf_l(out, "semi_skip:");
    try cf_emit_token_predicate(
        out, ir_bytes, function_name, module_prefix, "ident", ident_call, token_element_llvm, token_var, bs
    );
    try cf_l(out, "  br i1 %ident, label %emit_text, label %check_colon");
    try cf_l(out, "check_colon:");
    try cf_emit_token_predicate(
        out, ir_bytes, function_name, module_prefix, "colon", colon_call, token_element_llvm, token_var, bs
    );
    try cf_l(out, "  br i1 %colon, label %emit_text, label %scan_latch");

    // Emit-text block: append the token text slice, then fall through to the latch.
    try cf_l(out, "emit_text:");
    try cf_emit_string_append(
        out, llvm_return_type, "txt", "kizu_rt_string_append_bytes", out_name,
        "%kizu.slice.u8", "%", text_var
    );
    try cf_l(out, "  br label %scan_latch");

    // Scan latch: advance the counter and loop back to the head.
    try cf_l(out, "scan_latch:");
    try cf_w(out, "  %");
    try cf_w(out, index_var);
    try cf_w(out, "_next = add i64 %");
    try cf_w(out, index_var);
    try cf_l(out, ", 1");
    try cf_l(out, "  br label %scan_head");

    // Scan exit: return the void success.
    try cf_l(out, "scan_exit:");
    try cf_emit_void_success_ret(out, llvm_return_type, "ret_ok");
    try cf_l(out, "}");
    try out.append_byte(cast<u8>(10));
    return;
}
