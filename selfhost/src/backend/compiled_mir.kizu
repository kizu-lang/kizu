        result_id: result_id,
        insts: insts
    };
}

// The two renderer-agnostic destinations a condition leaf can branch to, distinct from any
// leaf index because leaf indices are non-negative.
pub fn cond_target_condition_true() -> i64 { return -1; }
pub fn cond_target_condition_false() -> i64 { return -2; }

pub fn cond_target(true_target: i64, false_target: i64) -> MirCondTarget {
    return MirCondTarget {
        true_target: true_target,
        false_target: false_target
    };
}

pub fn copy_cond_targets(
    targets: &std::array::Array<MirCondTarget>
) -> !std::array::Array<MirCondTarget> {
    var copied = std::array::Array<MirCondTarget>(std::mem::page_allocator());
    var index = 0;
    while index < targets.len() {
        let target = try targets.at(index);
        try copied.append(cond_target(target.true_target, target.false_target));
        index = index + 1;
    }
    return copied;
}

pub fn if_merge_var(
    source_name: []u8,
    input_name: []u8,
