        bool_value: false,
        then_call_module_prefix: "",
        then_call_callee_name: "",
        then_call_args: std::array::Array<MirCallArg>(std::mem::page_allocator()),
        then_expr_result_id: -1,
        then_expr_insts: std::array::Array<MirExprInst>(std::mem::page_allocator()),
        then_struct_fields: std::array::Array<MirStructField>(std::mem::page_allocator()),
        then_struct_string_index: string_index,
        then_body_stmts: then_body_stmts,
        else_body_stmts: else_body_stmts,
        merge_vars: merge_vars
    });
