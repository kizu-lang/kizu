pub fn if_try_call_void_body_stmt(
    if_index: i64,
    string_index: i64,
    called_error_union: []u8,
    own_error_union: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    call_args: std::array::Array<MirCallArg>,
    then_on_success: bool,
    then_body_stmts: std::array::Array<MirStmt>,
    merge_vars: std::array::Array<MirIfMergeVar>
) -> MirStmt {
    return MirStmt::If(MirIfStmt {
        if_index: if_index,
        string_index: string_index,
        llvm_type: own_error_union,
        cond_result_id: -1,
        cond_insts: std::array::Array<MirExprInst>(std::mem::page_allocator()),
        cond_short_circuit: 0,
        cond_rhs_result_id: -1,
        cond_rhs_insts: std::array::Array<MirExprInst>(std::mem::page_allocator()),
        cond_extra_operands: std::array::Array<MirCondOperand>(std::mem::page_allocator()),
        cond_targets: std::array::Array<MirCondTarget>(std::mem::page_allocator()),
        cond_try_call: true,
        cond_try_then_on_success: then_on_success,
        cond_called_error_union: called_error_union,
        cond_own_error_union: own_error_union,
        cond_call_module_prefix: module_prefix,
        cond_call_callee_name: callee_name,
        cond_call_args: call_args,
        if_then_kind: MirIfThenKind::VoidBody,
        bool_value: false,
        then_call_module_prefix: "",
        then_call_callee_name: "",
        then_call_args: std::array::Array<MirCallArg>(std::mem::page_allocator()),
        then_expr_result_id: -1,
        then_expr_insts: std::array::Array<MirExprInst>(std::mem::page_allocator()),
        then_struct_fields: std::array::Array<MirStructField>(std::mem::page_allocator()),
        then_struct_string_index: string_index,
        then_body_stmts: then_body_stmts,
        else_body_stmts: std::array::Array<MirStmt>(std::mem::page_allocator()),
        merge_vars: merge_vars
    });
}

// The scalar block instructions render from the function return type and
// terminator value, so their union variants are payload-free and carry no
// result, callee symbol, or argument Array.
pub fn mir_string_const_instruction() -> MirInstruction {
    return MirInstruction::ConstString;
}

pub fn const_int_instruction() -> MirInstruction {
    return MirInstruction::ConstInt;
}

pub fn struct_literal_instruction() -> MirInstruction {
    return MirInstruction::StructLiteral;
}

pub fn expr_instruction() -> MirInstruction {
    return MirInstruction::Expr;
}

pub fn multi_statement_instruction() -> MirInstruction {
    return MirInstruction::MultiStatement;
}

pub fn call_instruction(
    result: MirValue,
    module_prefix: []u8,
    callee_name: []u8
) -> MirInstruction {
    return MirInstruction::Call(MirCallInst {
        result: result,
        module_prefix: module_prefix,
        callee_name: callee_name
    });
}

