pub fn let_try_call_stmt(
    name: []u8,
    called_error_union: []u8,
    success_type: []u8,
    own_error_union: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    string_index: i64,
    try_index: i64,
    arg_insts: std::array::Array<MirExprInst>,
    args: std::array::Array<MirCallArg>
) -> MirStmt {
    return MirStmt::LetTryCall(MirLetTryCallStmt {
        name: name,
        called_error_union: called_error_union,
        success_type: success_type,
        result_transport: builtin_contract::RuntimeResultTransport::Semantic,
        own_error_union: own_error_union,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        string_index: string_index,
        try_index: try_index,
        arg_insts: arg_insts,
        call_args: args
    });
}

pub fn let_try_storage_call_stmt(
    name: []u8,
    storage_error_union: []u8,
    semantic_success_type: []u8,
    result_transport: builtin_contract::RuntimeResultTransport,
    own_error_union: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    string_index: i64,
    try_index: i64,
    arg_insts: std::array::Array<MirExprInst>,
    args: std::array::Array<MirCallArg>
) -> !MirStmt {
    if result_transport == builtin_contract::RuntimeResultTransport::Semantic {
        return error("compiled mir: erased try-call result codec missing");
    }
    return MirStmt::LetTryCall(MirLetTryCallStmt {
        name: name,
        called_error_union: storage_error_union,
        success_type: semantic_success_type,
        result_transport: result_transport,
        own_error_union: own_error_union,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        string_index: string_index,
        try_index: try_index,
        arg_insts: arg_insts,
        call_args: args
    });
}

