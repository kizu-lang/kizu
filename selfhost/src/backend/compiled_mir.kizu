pub fn traversal_try_arm(
    tag: i64,
    payload_type: []u8,
    callee_module: []u8,
    callee_name: []u8,
    arg_insts: std::array::Array<MirExprInst>,
    call_args: std::array::Array<MirCallArg>,
    payload_args: std::array::Array<MirTraversalPayloadArg>
) -> MirTraversalArm {
    return MirTraversalArm {
        tag: tag,
        is_literal: false,
        literal_value: 0,
        literal_llvm: "",
        payload_type: payload_type,
        callee_module: callee_module,
        callee_name: callee_name,
        is_plain_call: false,
        is_payload_value: false,
        is_expr_value: false,
        value_result_id: -1,
        success_llvm: "",
        arg_insts: arg_insts,
        call_args: call_args,
        payload_args: payload_args
    };
}

// traversal_plain_call_arm backs an arm whose body is a non-try call. Error-union match
// functions wrap the success_llvm result into the function's own error union; plain-return
// match functions return the call result directly.
pub fn traversal_plain_call_arm(
    tag: i64,
    payload_type: []u8,
    callee_module: []u8,
    callee_name: []u8,
    success_llvm: []u8,
    arg_insts: std::array::Array<MirExprInst>,
    call_args: std::array::Array<MirCallArg>,
    payload_args: std::array::Array<MirTraversalPayloadArg>
) -> MirTraversalArm {
    return MirTraversalArm {
        tag: tag,
        is_literal: false,
        literal_value: 0,
        literal_llvm: "",
        payload_type: payload_type,
        callee_module: callee_module,
        callee_name: callee_name,
        is_plain_call: true,
        is_payload_value: false,
        is_expr_value: false,
        value_result_id: -1,
        success_llvm: success_llvm,
        arg_insts: arg_insts,
        call_args: call_args,
        payload_args: payload_args
    };
}

pub fn traversal_literal_arm(
    tag: i64,
    literal_value: i64
) -> MirTraversalArm {
    return MirTraversalArm {
        tag: tag,
        is_literal: true,
        literal_value: literal_value,
        literal_llvm: "i64",
        payload_type: "",
        callee_module: "",
        callee_name: "",
        is_plain_call: false,
        is_payload_value: false,
        is_expr_value: false,
        value_result_id: -1,
        success_llvm: "",
        arg_insts: std::array::Array<MirExprInst>(std::mem::page_allocator()),
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator()),
        payload_args: std::array::Array<MirTraversalPayloadArg>(std::mem::page_allocator())
    };
}

// traversal_bool_literal_arm backs a 'Variant => true' / '_ => false' predicate arm.
pub fn traversal_bool_literal_arm(
    tag: i64,
    bool_value: bool
) -> MirTraversalArm {
    var literal_value = 0;
    if bool_value {
        literal_value = 1;
    }
    return MirTraversalArm {
        tag: tag,
        is_literal: true,
        literal_value: literal_value,
        literal_llvm: "i1",
        payload_type: "",
        callee_module: "",
        callee_name: "",
        is_plain_call: false,
        is_payload_value: false,
        is_expr_value: false,
        value_result_id: -1,
        success_llvm: "",
        arg_insts: std::array::Array<MirExprInst>(std::mem::page_allocator()),
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator()),
        payload_args: std::array::Array<MirTraversalPayloadArg>(std::mem::page_allocator())
    };
}

// traversal_payload_value_arm backs a matched payload field returned directly from
// an arm, such as `Block(block) => block.statements`. The field is materialized by
// the same traversal payload extraction metadata used for call arguments.
pub fn traversal_payload_value_arm(
    tag: i64,
    payload_type: []u8,
    success_llvm: []u8,
    field_index: i64,
    temp_id: i64
) -> !MirTraversalArm {
    var payload_args =
        std::array::Array<MirTraversalPayloadArg>(std::mem::page_allocator());
    try payload_args.append(traversal_payload_arg(field_index, temp_id));
    return MirTraversalArm {
        tag: tag,
        is_literal: false,
        literal_value: 0,
        literal_llvm: "",
        payload_type: payload_type,
        callee_module: "",
        callee_name: "",
        is_plain_call: false,
        is_payload_value: true,
        is_expr_value: false,
        value_result_id: -1,
        success_llvm: success_llvm,
        arg_insts: std::array::Array<MirExprInst>(std::mem::page_allocator()),
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator()),
        payload_args: payload_args
    };
}

pub fn traversal_expr_value_arm(
    tag: i64,
    success_llvm: []u8,
    value_result_id: i64,
    value_insts: std::array::Array<MirExprInst>
) -> MirTraversalArm {
    return MirTraversalArm {
        tag: tag,
        is_literal: false,
        literal_value: 0,
        literal_llvm: "",
        payload_type: "",
        callee_module: "",
        callee_name: "",
        is_plain_call: false,
        is_payload_value: false,
        is_expr_value: true,
        value_result_id: value_result_id,
        success_llvm: success_llvm,
        arg_insts: value_insts,
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator()),
        payload_args: std::array::Array<MirTraversalPayloadArg>(
            std::mem::page_allocator()
        )
    };
}

pub fn match_traversal_stmt(
