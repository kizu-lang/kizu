// int_literal_call_arg passes an integer literal directly as a call operand
// (e.g. the '1' in position(line, 1)); the renderer emits no setup and writes the
// literal inline in the argument list (tracker 961, scope 4 prerequisite).
pub fn int_literal_call_arg(ty: []u8, value: i64) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        semantic_type: ty, storage_codec: MirStorageCodec::None,
        kind: MirCallArgKind::IntLiteral,
        value: "",
        bool_value: false,
        string_index: -1,
        int_value: value,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_start_source_type: "",
        slice_start_field_index: -1,
        slice_end_base: "",
        slice_end_offset: 0,
        slice_end_source_type: "",
        slice_end_field_index: -1,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

// type_size_call_arg passes the compile-time byte width of a concrete LLVM
// type as an i64 constant expression. Constructor descriptors use it without
// introducing a container-specific MIR statement or hardcoded width.
pub fn type_size_call_arg(concrete_llvm_type: []u8) -> !MirCallArg {
    if std::mem::len(concrete_llvm_type) == 0 {
        return error("compiled mir: type-size argument requires a concrete LLVM type");
    }
    return MirCallArg {
        ty: "i64",
        semantic_type: "i64", storage_codec: MirStorageCodec::None,
        kind: MirCallArgKind::TypeSize,
        value: concrete_llvm_type,
        bool_value: false,
        string_index: -1,
        int_value: 0,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_start_source_type: "",
        slice_start_field_index: -1,
        slice_end_base: "",
        slice_end_offset: 0,
        slice_end_source_type: "",
        slice_end_field_index: -1,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

// temp_call_arg passes an already-computed expression temp (%t<temp_id>) directly as
// a call operand (issue 1165). It backs nested-call arguments such as the
// token_text(source, next) inside equal_bytes(token_text(...), expected): the inner
// call is lowered into a preceding call expr-inst whose %t<temp_id> result this arg
// references, so the renderer emits no setup and writes %t<temp_id> inline. temp_id
// is stored in int_value.
pub fn temp_call_arg(ty: []u8, temp_id: i64) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        semantic_type: ty, storage_codec: MirStorageCodec::None,
        kind: MirCallArgKind::Temp,
        value: "",
        bool_value: false,
        string_index: -1,
        int_value: temp_id,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_start_source_type: "",
        slice_start_field_index: -1,
        slice_end_base: "",
        slice_end_offset: 0,
        slice_end_source_type: "",
        slice_end_field_index: -1,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

// call_call_arg materializes a nested call argument inline in the enclosing call's
// argument setup, then passes that call result as the operand.
pub fn call_call_arg(
    ty: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        semantic_type: ty, storage_codec: MirStorageCodec::None,
        kind: MirCallArgKind::Call,
        value: "",
        bool_value: false,
        string_index: -1,
        int_value: 0,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_start_source_type: "",
        slice_start_field_index: -1,
        slice_end_base: "",
        slice_end_offset: 0,
        slice_end_source_type: "",
        slice_end_field_index: -1,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    };
}

// arith_field_call_arg passes 'receiver.<field> +/- value' as a call operand: the
// renderer extracts source_field_index off the Var receiver (source_type %name)
// then adds (or subtracts when subtract is true) the literal into an %argN_arith
// temp. Backs position(initial.line + 1, ...) (tracker 961, scope 4 prerequisite).
pub fn arith_field_call_arg(
    ty: []u8,
    source_type: []u8,
    source_name: []u8,
    source_field_index: i64,
    value: i64,
    subtract: bool
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        semantic_type: ty, storage_codec: MirStorageCodec::None,
        kind: MirCallArgKind::Arith,
        value: source_name,
        bool_value: subtract,
        string_index: -1,
        int_value: value,
        source_type: source_type,
        source_field_index: source_field_index,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_start_source_type: "",
        slice_start_field_index: -1,
        slice_end_base: "",
        slice_end_offset: 0,
        slice_end_source_type: "",
        slice_end_field_index: -1,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

// arith_var_call_arg passes '<var> +/- value' as a call operand: the renderer adds
// (or subtracts) the literal off the Var %name directly into an %argN_arith temp.
// source_field_index stays -1 to mark the var (no extractvalue) base (tracker 961).
pub fn arith_var_call_arg(
    ty: []u8,
    var_name: []u8,
    value: i64,
    subtract: bool
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        semantic_type: ty, storage_codec: MirStorageCodec::None,
        kind: MirCallArgKind::Arith,
        value: var_name,
        bool_value: subtract,
        string_index: -1,
        int_value: value,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_start_source_type: "",
        slice_start_field_index: -1,
        slice_end_base: "",
        slice_end_offset: 0,
        slice_end_source_type: "",
        slice_end_field_index: -1,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

// empty_struct_call_args backs the call_args field of non-call struct fields. It
// allocates an empty Array so every MirStructField has a valid (if unused) args
// array; only Call fields populate it (tracker 961).
fn empty_struct_call_args() -> std::array::Array<MirCallArg> {
    return std::array::Array<MirCallArg>(std::mem::page_allocator());
}

// empty_struct_nested_fields backs the nested_fields field of non-StructLiteral
// struct fields; only StructLiteral fields populate it (tracker 961).
fn empty_struct_nested_fields() -> std::array::Array<MirStructField> {
    return std::array::Array<MirStructField>(std::mem::page_allocator());
}

pub fn var_struct_field(index: i64, ty: []u8, name: []u8) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::Var,
        llvm_type: ty,
        value: name,
        int_value: 0,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        computed_rhs_name: "",
        computed_op: "",
        computed_lhs_literal: 0,
        computed_lhs_is_literal: false,
        computed_rhs_literal: 0,
        computed_rhs_is_literal: false,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields(),
        access_path: empty_field_steps()
    };
}

pub fn string_struct_field(index: i64, payload: []u8) -> MirStructField {
    return MirStructField {
        index: index,
