        value: payload,
        int_value: 0,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        computed_rhs_name: "",
        computed_op: "",
        computed_lhs_literal: 0,
        computed_lhs_is_literal: false,
        computed_rhs_literal: 0,
        computed_rhs_is_literal: false,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields(),
        access_path: empty_field_steps()
    };
}

