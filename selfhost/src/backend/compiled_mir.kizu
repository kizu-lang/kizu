pub fn call_expr_inst(
    id: i64,
    llvm_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirExprInst {
    return MirExprInst::Call(MirCallExpr {
        id: id,
        llvm_type: llvm_type,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

// expr_inst_id and expr_inst_llvm_type read the result id and LLVM type that
// every expr-inst variant carries, so result wiring (type-by-id lookups) does
// not depend on the active variant.
pub fn expr_inst_id(inst: &MirExprInst) -> i64 {
    return match inst {
        Var(payload) => payload.id,
        ConstString(payload) => payload.id,
        ConstBool(payload) => payload.id,
        ConstInt(payload) => payload.id,
        ConstEnumTag(payload) => payload.id,
        PrefixNot(payload) => payload.id,
        Binary(payload) => payload.id,
        FieldAccess(payload) => payload.id,
        IndexLoad(payload) => payload.id,
        Call(payload) => payload.id,
    };
}

pub fn expr_inst_llvm_type(inst: &MirExprInst) -> []u8 {
    return match inst {
        Var(payload) => payload.llvm_type,
        ConstString(payload) => payload.llvm_type,
        ConstBool(payload) => payload.llvm_type,
        ConstInt(payload) => payload.llvm_type,
        ConstEnumTag(payload) => payload.llvm_type,
        PrefixNot(payload) => payload.llvm_type,
        Binary(payload) => payload.llvm_type,
        FieldAccess(payload) => payload.llvm_type,
        IndexLoad(payload) => payload.llvm_type,
        Call(payload) => payload.llvm_type,
    };
}

