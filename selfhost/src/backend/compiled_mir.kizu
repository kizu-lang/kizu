pub enum MirTypeKind {
    SliceU8,
    I64,
    Llvm,
}

pub struct MirType {
    pub kind: MirTypeKind,
    pub llvm_name: []u8,
}

pub enum MirValKind {
    ConstString,
    ConstInt,
    CallResult,
    StructResult,
    ExprResult,
    MultiResult,
}

pub struct MirValue {
    pub id: i64,
    pub ty: MirType,
    pub kind: MirValKind,
    pub payload: []u8,
    pub int_value: i64,
}

pub enum MirCallArgKind {
    Var,
    String,
    Bool,
    FieldAccess,
    EmptySlice,
    Slice,
    IntLiteral,
    Arith,
    Temp,
}

// A FieldAccess call arg mirrors MirStructField's nested layout: source_type /
// source_field_index extract the first field off the Var receiver, and when
// nested_field_index >= 0 a second extractvalue reads nested_field_index off
// nested_source_type (the intermediate field type). nested_field_index == -1
// marks a single-level access (receiver.field) so the renderer skips the second
// extractvalue (tracker 961, mirrors nested_field_access_struct_field).
//
// An IntLiteral arg renders its int_value inline as the argument operand (no
// setup), and an Arith arg renders '<base> +/- int_value' into an %argN_arith
// temp before the call: when source_field_index >= 0 the base is the
// source_field_index field extracted off the Var receiver (source_type %value),
// otherwise the base is the Var %value directly; bool_value true selects sub
// over add. These back the lexer's position(initial.line + 1, 1) style calls
// (tracker 961, scope 4 prerequisite).
pub struct MirCallArg {
    pub ty: []u8,
    pub kind: MirCallArgKind,
    pub value: []u8,
    pub bool_value: bool,
    pub string_index: i64,
    pub int_value: i64,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub nested_source_type: []u8,
    pub nested_field_index: i64,
    pub slice_start_base: []u8,
    pub slice_start_offset: i64,
    pub slice_end_base: []u8,
    pub slice_end_offset: i64,
}

pub enum MirStructFieldKind {
    Var,
    ConstString,
    ConstInt,
    ConstBool,
    ConstEnumTag,
    FieldAccess,
    EmptySlice,
    Call,
    StructLiteral,
}

// A Call struct field carries a resolved direct call (callee + module prefix +
// lowered args) whose result becomes the field value. The renderer emits the
// call arg setup and call instruction before insertvalue-ing the result into the
// struct, mirroring the let/return call lowering. A StructLiteral field carries a
// nested struct literal's fields (nested_fields) and its struct type (llvm_type);
// the renderer builds the nested struct in its own insertvalue chain and feeds
// the result in. Non-nested fields keep call_callee_name empty and empty
// call_args / nested_fields arrays (tracker 961).
pub struct MirStructField {
    pub index: i64,
    pub kind: MirStructFieldKind,
    pub llvm_type: []u8,
    pub value: []u8,
    pub int_value: i64,
    pub bool_value: bool,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub nested_source_type: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
    pub nested_fields: std::array::Array<MirStructField>,
}

// Per-variant MirExprInst payloads. Each holds only the fields its variant
// reads in the renderer; only the Call payload owns an inline Array, so the
// union below never carries inactive owned arrays for the scalar variants
// (issue 1007/1012, ADR-0075 tagged-union payload ABI). Every payload keeps
// id and llvm_type because expr_inst_id / expr_inst_llvm_type resolve them
// for any variant when wiring instruction results together.
pub struct MirVarExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
}

pub struct MirConstStringExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
    pub string_index: i64,
}

pub struct MirConstBoolExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub bool_value: bool,
}

pub struct MirConstIntExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub int_value: i64,
}

pub struct MirConstEnumTagExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub int_value: i64,
}

pub struct MirPrefixNotExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub operand: i64,
}

pub struct MirBinaryExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub op: []u8,
    pub left: i64,
    pub right: i64,
}

pub struct MirFieldAccessExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
    pub left: i64,
    pub source_type: []u8,
    pub source_field_index: i64,
}

// Single-byte slice index load (path[i] in expression context). The renderer
// extracts the slice data pointer from target, GEPs by the i64 index result,
// and loads one i8. The instruction owns nothing, so it is copy-only.
pub struct MirIndexLoadExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub target: []u8,
    pub index: i64,
}

// Byte slice expression (bytes[start..end]). target/start/end reference earlier
// expression temps; the renderer performs the same bounds checks as slice call
// arguments before constructing the returned %kizu.slice.u8 view.
pub struct MirSliceExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub target: i64,
    pub start: i64,
    pub end: i64,
}

pub struct MirCallExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirArrayLenExpr backs a local/param 'tokens.len()' read in expression context
// (issue 1165): the receiver is a std::array::Array<T> (or &Array<T>) param/local,
// which lowers to the runtime-owned %kizu.owned handle, so the renderer reads the
// handle straight off the named value (no struct extractvalue) and calls
// @kizu_rt_array_len(%kizu.owned) -> i64. It generalizes the struct-field Array.len
// accessor to direct value receivers; the element type T does not affect the call,
// so it carries only the receiver name. It owns nothing, so it is copy-only.
pub struct MirArrayLenExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub receiver_name: []u8,
}

pub union MirExprInst {
    Var(MirVarExpr),
    ConstString(MirConstStringExpr),
    ConstBool(MirConstBoolExpr),
    ConstInt(MirConstIntExpr),
    ConstEnumTag(MirConstEnumTagExpr),
    PrefixNot(MirPrefixNotExpr),
    Binary(MirBinaryExpr),
    FieldAccess(MirFieldAccessExpr),
    IndexLoad(MirIndexLoadExpr),
    Slice(MirSliceExpr),
    Call(MirCallExpr),
    ArrayLen(MirArrayLenExpr),
}

pub enum MirIfThenKind {
    ReturnBool,
    ReturnCall,
    ReturnExpr,
    ReturnStruct,
    ReturnError,
    // ContinueLatch backs an 'if <cond> { <induction> = <induction> + <step>; continue; }'
    // body statement of a continue-latch while loop (line_comment_has_blank_after, issue 1165
    // / 1162). The then-block carries no return value: it branches straight back to the loop
    // latch ('br label %loop<N>_latch') so the increment is folded into the shared
    // constant-step latch add, and the if-continuation block falls through to the loop's
    // non-continue tail (the trailing 'return'). The increment local is validated but never
    // rendered here.
    ContinueLatch,
}

// Per-variant MirStmt payloads. Each holds only the fields its variant needs and
// owns its inline Array storage, so the union below never carries inactive owned
// arrays (issue 1007/1011, ADR-0075 tagged-union payload ABI).
pub struct MirLetCallStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirLetStructStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

// MirLetArenaAddStmt backs a 'let <name> = self.<field>.add(<struct literal>);'
// (Arena<T>.add(T) -> handle index, tracker 961). It constructs the element struct
// (T) from struct_fields, marshals it through stack storage as a %kizu.slice.u8
// (ptr + sizeof(T)), reads the Arena<T> handle off the struct value receiver, calls
// @kizu_rt_arena_add, and binds <name> to the appended slot index. Ast.add_node is
// its first consumer: it constructs an AstNode (Span + AstData union) and appends it
// to the nodes Arena, exercising the AstNode/AstData union value-type ABI.
pub struct MirLetArenaAddStmt {
    pub name: []u8,
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub arena_field_index: i64,
    pub element_type: []u8,
    pub last_field_index: i64,
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirReturnCallStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirReturnStructStmt {
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirReturnExprStmt {
    pub string_index: i64,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirReturnErrorStmt backs a return error("literal") statement. It mirrors
// MirReturnExprStmt: the error message literal is lowered as a single ConstString
// in expr_insts (so the existing string-global emission applies) and
// message_result_id names the temp holding the message %kizu.slice.u8. The
// renderer builds the error-union failure value (i1 false, success zeroinitializer,
// the message slice at the failure index) and returns it (tracker 961).
pub struct MirReturnErrorStmt {
    pub string_index: i64,
    pub message_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

pub struct MirLetExprStmt {
    pub name: []u8,
    pub string_index: i64,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirLetTryCallStmt backs a 'let <name> = try <callee>(<args>);' statement: a try-call
// over a free function whose return type is an error union (the node_count traversal
// cluster, tracker 961). The renderer emits the call into called_error_union, extracts the
// ok flag (field 0), and branches on a try_index-suffixed label pair: the fail block
// re-wraps the callee's message (field 2) into this function's own_error_union failure
// value and returns it (propagation, never 'unreachable'); the ok block extracts the
// success value (field 1, success_type) and binds it to <name>. called_error_union and
// own_error_union may differ (e.g. a !NodeId child_at call inside a !i64 counter), so the
// fail path always rebuilds the message rather than forwarding the callee union whole. It
// owns the call-argument Array, mirroring MirLetCallStmt.
pub struct MirLetTryCallStmt {
    pub name: []u8,
    pub called_error_union: []u8,
    pub success_type: []u8,
    pub own_error_union: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirReturnArrayGetStmt backs a multi-statement 'return self.<field>.get(<expr>);'
// (Array<T>.get -> !T, tracker 961). It composes the ArrayGet body with an arbitrary
// index expression: expr_insts/index_result_id lower the index (e.g. range.start +
// index) into %t<index_result_id>, and the receiver fields name the Array<T> handle.
// The renderer emits the index, then the checked @kizu_rt_array_at call + ok-branch +
// by-value load + error-union wrap, sharing the body with the single-statement
// accessor. Ast.child_at is its first consumer.
pub struct MirReturnArrayGetStmt {
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub field_index: i64,
    pub element_type: []u8,
    pub index_result_id: i64,
    pub string_index: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirLetArrayGetStmt backs a multi-statement 'let <name> = try <receiver>.get(<expr>);'
// where the receiver is a std::array::Array<T> (or &Array<T>) param/local (issue 1165).
// The receiver lowers to the runtime-owned %kizu.owned handle, so the renderer reads
// it straight off the named value (no struct extractvalue), lowers the index
// expression into %t<index_result_id>, calls the checked @kizu_rt_array_at runtime
// helper, and branches on the ok flag on a try_index-suffixed label pair: the fail
// block re-wraps the runtime message into this function's own_error_union failure
// value and returns it (propagation, never 'unreachable'); the cont block loads the
// element value out of the borrowed view and binds it to %<name>, which the following
// statements continue in. It generalizes the struct-field Array.get accessor to direct
// value receivers in let-binding position. It owns the index expr_insts Array.
pub struct MirLetArrayGetStmt {
    pub name: []u8,
    pub receiver_name: []u8,
    pub element_type: []u8,
    pub own_error_union: []u8,
    pub index_result_id: i64,
    pub string_index: i64,
    pub try_index: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirCondOperand backs one operand of an 'and' short-circuit chain beyond the first
// two (cond_insts and cond_rhs_insts). result_id names the operand's i1 result and
// insts holds the operand's expression lowered into its own guarded block, so a
// trapping/loading operand (e.g. a byte index) never runs unless every earlier operand
// was true (issue 1165 / 1162). It references MirExprInst through a heap-backed Array
// like the lhs/rhs operands, so the union stays fixed-size.
pub struct MirCondOperand {
    pub result_id: i64,
    pub insts: std::array::Array<MirExprInst>,
}

// cond_short_circuit selects how the condition drives the branch:
//   0 = single condition (cond_insts / cond_result_id only)
//   1 = lhs and rhs short-circuit; rhs is only evaluated when lhs is true
//   2 = lhs or rhs short-circuit; rhs is only evaluated when lhs is false
// When short-circuit is active cond_insts/cond_result_id hold the lhs (the first
// operand) and cond_rhs_insts/cond_rhs_result_id hold the second operand, lowered in
// the guarded block so a trapping/loading operand (e.g. a byte index) never runs unless
// reached. An 'and' header may carry further operands in cond_extra_operands: each is
// guarded by every earlier operand, so a chained 'a and b and c' short-circuit
// (after_line_break's 'source[index] == 13 and index + 1 < length and source[index + 1]
// == 10') evaluates the guarded byte loads only when their guards hold (issue 1165 /
// 1162). cond_extra_operands is empty for a single condition, an 'or', and a two-operand
// 'and', so those keep their existing block layout.
pub struct MirIfStmt {
    pub if_index: i64,
    pub string_index: i64,
    pub llvm_type: []u8,
    pub cond_result_id: i64,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_short_circuit: i64,
    pub cond_rhs_result_id: i64,
    pub cond_rhs_insts: std::array::Array<MirExprInst>,
    pub cond_extra_operands: std::array::Array<MirCondOperand>,
    pub if_then_kind: MirIfThenKind,
    pub bool_value: bool,
    pub then_call_module_prefix: []u8,
    pub then_call_callee_name: []u8,
    pub then_call_args: std::array::Array<MirCallArg>,
    pub then_expr_result_id: i64,
    pub then_expr_insts: std::array::Array<MirExprInst>,
    // then_struct_fields / then_struct_string_index back a ReturnStruct then-block
    // such as a return of PayloadSpan { start: locals.first.payload_start, .. }. The
    // string index seeds the per-field SSA names and any ConstString field globals,
    // so it must match between the body render and the globals render.
    pub then_struct_fields: std::array::Array<MirStructField>,
    pub then_struct_string_index: i64,
}

// MirWhileStmt backs a restricted bounded counter loop (tracker 961): one mutable
// i64 induction variable initialized before the loop, a condition that reads it,
// a body of Let/If/Return statements, and a trailing 'var = var + step' increment
// folded into induction_step. The renderer emits a single loop-carried phi for the
// induction variable (named after it, so plain Var reads resolve to the phi) and a
// preheader/head/body/latch/exit block layout. body_stmts holds the body minus the
// increment; it references MirStmt through a heap-backed Array, the same self/mutual
// recursion MirStructField.nested_fields already uses, so the union stays fixed-size.
// The preheader edge seeds the phi from induction_init_var when it is non-empty (a
// 'var index = <param-or-local>' initializer, e.g. index_after_import's import_index),
// otherwise from the induction_init integer literal ('var index = <int>'); only those
// two init shapes are accepted (issue 1165).
// The header condition is one of three shapes, selected by cond_short_circuit:
//   0 = a single comparison, or an 'and' chain whose operands are all side-effect-free
//       (an eager 'and i1' is observably identical to short-circuit, so it folds into
//       cond_insts / cond_result_id and the head emits one 'br i1');
//   1 = a genuine short-circuit 'and' chain whose later operands could trap when an
//       earlier one is false (line_end_excluding_break's 'index < length and
//       !is_line_break(source[index])' loads source[index] only when index < length),
//       so cond_insts / cond_result_id hold the first operand in the head, cond_rhs_insts
//       / cond_rhs_result_id hold the second in a guarded loopN_head_rhs block, and any
//       further operands fill cond_extra_operands, each guarded by every earlier operand.
// An 'or' header is rejected. cond_rhs_insts / cond_extra_operands are empty when
// cond_short_circuit is 0 (issue 1165 / 1162).
// The latch advances the induction variable. When latch_stmts is empty the latch is the
// constant-step 'add i64 %<var>, induction_step' (the 'index = index + <int>' increment).
// When latch_stmts holds one statement the latch is a generic loop-carried update: a
// 'index = try <callee>(.., index);' try-call whose success value (field 1) feeds the
// phi as %<var>_next and whose failure propagates as this function's own error union
// (index_after_leading_imports is its first consumer, issue 1165). It is a 0-or-1 element
// Array<MirStmt> exactly like body_stmts so the union stays fixed-size.
// MirSecondaryInduction is one extra lockstep i64 counter advanced alongside the primary
// induction variable in a multi-counter bounded loop (issue 1165 / 1162). import_path_less
// walks two token cursors ('var left_index = left + 1; var right_index = right + 1; while
// left_index < tokens.len() and right_index < tokens.len() { ...; left_index = left_index +
// 1; right_index = right_index + 1; }'): left_index is the primary induction and right_index
// is one secondary. Each secondary gets its own loop-head phi (named after the variable, so
// plain Var reads resolve to it) seeded on the preheader edge from init_var + init_offset
// when init_var is non-empty (a 'var right_index = right + 1' base-plus-offset initializer)
// or from the init_literal otherwise, and a constant-step latch '%<var>_next = add i64
// %<var>, step'.
pub struct MirSecondaryInduction {
    pub var_name: []u8,
    pub init_literal: i64,
    pub init_var: []u8,
    pub init_offset: i64,
    pub step: i64,
}
pub struct MirWhileStmt {
    pub loop_index: i64,
    pub induction_var: []u8,
    pub induction_init: i64,
    pub induction_init_var: []u8,
    // induction_init_offset seeds a base-plus-offset primary init ('var left_index = left +
    // 1'): when induction_init_var is non-empty and the offset is non-zero the preheader
    // computes '%<var>_init = add i64 %<init_var>, offset' and the phi seeds from it; a zero
    // offset keeps the plain '%<init_var>' copy seed (issue 1165 / 1162).
    pub induction_init_offset: i64,
    pub induction_step: i64,
    pub cond_result_id: i64,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_short_circuit: i64,
    pub cond_rhs_result_id: i64,
    pub cond_rhs_insts: std::array::Array<MirExprInst>,
    pub cond_extra_operands: std::array::Array<MirCondOperand>,
    pub body_stmts: std::array::Array<MirStmt>,
    pub latch_stmts: std::array::Array<MirStmt>,
    // latch_copy_var names the body-local a copy-decrement latch assigns into the induction
    // variable ('index = previous' where 'let previous = index - 1' is computed earlier in the
    // body for line_comment_is_full_line's source[previous] load). When it is non-empty the
    // primary loop-head phi reads %<latch_copy_var> on the latch edge instead of %<var>_next, and
    // the latch block emits no primary add: the body already holds the decremented value, so no
    // separate %<var>_next is computed. It is empty for a constant-step or try-call latch (issue
    // 1165 / 1162).
    pub latch_copy_var: []u8,
    pub secondary_inductions: std::array::Array<MirSecondaryInduction>,
    // init_insts / init_result_id back a call-seeded primary induction init ('var cursor =
    // line_end_including_break(source, comment_end)' for line_comment_has_blank_after, issue
    // 1165 / 1162). When init_insts is non-empty the preheader renders the call instructions and
    // the loop-head phi seeds from %t<init_result_id> on the preheader edge instead of from
    // induction_init_var / induction_init. Both stay empty (init_result_id is -1) for a literal,
    // plain-copy, or base-plus-offset seed.
    pub init_insts: std::array::Array<MirExprInst>,
    pub init_result_id: i64,
}

// MirTraversalArg is one payload-field argument forwarded to a node_count traversal arm's
// count_* callee: extractvalue field_index off the bound variant payload, typed arg_llvm_type
// (tracker 961). The receiver (the Ast tree) is always the implicit first call argument and
// is not modelled here. It owns nothing.
pub struct MirTraversalArg {
    pub field_index: i64,
    pub arg_llvm_type: []u8,
}

// MirTraversalArm is one arm of the node_count match-over-AstData traversal (tracker 961).
// A try-call arm ('Variant(bind) => try count_X(tree, bind.f, ...)') carries the discriminant
// tag, the inline payload struct type, the count_* callee symbol, and the payload-field args;
// the renderer extracts the payload, forwards the receiver + field args, calls count_X, and
// returns its error union directly (the callee and node_count share the !i64 return type, so
// the try is an identity tail return needing no ok/fail branch). A leaf arm ('Variant(_) => 1'
// / 'Empty => 1') sets is_literal and returns the literal wrapped as the error-union success.
// It owns the payload-field arg Array.
pub struct MirTraversalArm {
    pub tag: i64,
    pub is_literal: bool,
    pub literal_value: i64,
    pub payload_type: []u8,
    pub callee_module: []u8,
    pub callee_name: []u8,
    pub args: std::array::Array<MirTraversalArg>,
}

// MirCountRangeStmt backs count_range: 'var count = 0; var index = 0; while index <
// range.len { let child = try tree.child_at(range, index); count = count + try
// node_count(tree, child); index = index + 1; } return count;' (tracker 961). The renderer
// emits a two-phi accumulator loop (count + index) whose body calls the checked Ast.child_at
// and the recursive node_count, propagating either error union as this function's own !i64
// failure, and on the exhausted loop returns the accumulated count wrapped as the success.
pub struct MirCountRangeStmt {
    pub receiver_name: []u8,
    pub receiver_type: []u8,
    pub range_name: []u8,
    pub node_count_module: []u8,
    pub node_count_name: []u8,
    pub own_error_union: []u8,
}

// MirTrimAsciiStmt backs std::mem::trim_ascii: 'var start = 0; var end = len(bytes); while
// start < end { if !is_ascii_space(bytes[start]) break; start += 1; } while end > start { if
// !is_ascii_space(bytes[end-1]) break; end -= 1; } return bytes[start..end];' (tracker 961).
// The renderer emits two search loops that break on the first non-space byte and return the
// trimmed two-bound slice. is_ascii_module/name name the byte classifier callee.
pub struct MirTrimAsciiStmt {
    pub bytes_name: []u8,
    pub is_ascii_module: []u8,
    pub is_ascii_name: []u8,
}

// MirAstNodeTextStmt backs ast_node_text(text, ast, node_id): 'let node = ast.get(node_id);
// let span = &node.span; return trim_ascii(text[span.start..span.end]);' (tracker 961). The
// renderer binds the AstNode by value off the Ast.get call, extracts the Span (AstNode field
// 0) and its start/end, slices text two-bound, and forwards the slice to trim_ascii.
pub struct MirAstNodeTextStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub node_id_name: []u8,
    pub node_id_type: []u8,
    pub trim_module: []u8,
    pub trim_name: []u8,
}

// MirAdvancePositionStmt backs advance_position(source, start, end, initial): 'var index = start;
// var current = initial; while index < end { current = advance_byte(source[index], current);
// index = index + 1; } return current;' (tracker 961, scope 4 prerequisite). The renderer emits a
// two-phi loop threading the i64 index and the Position struct current; each iteration loads
// source[index] (i8) and feeds it with current into advance_byte, whose Position result becomes
// the next current. advance_byte_symbol is the already-compiled callee's mangled symbol.
pub struct MirAdvancePositionStmt {
    pub source_name: []u8,
    pub source_type: []u8,
    pub start_name: []u8,
    pub end_name: []u8,
    pub initial_name: []u8,
    pub position_type: []u8,
    pub advance_byte_symbol: []u8,
}

// MirNumberTokenStmt backs number_token(source, start, current): 'var end = start; while end <
// len(source) and is_digit(source[end]) { end = end + 1; } return token(Number, start, end,
// current);' (tracker 961, scope 4 prerequisite). The renderer scans an i64 end phi forward while
// each source[end] byte is a digit, then builds the Number Token. number_tag is the TokenKind
// discriminant; is_digit_symbol / token_symbol are the already-compiled callees. len(source) is
// the slice length field, read inline as extractvalue field 1 (no len call).
pub struct MirNumberTokenStmt {
    pub source_name: []u8,
    pub source_type: []u8,
    pub start_name: []u8,
    pub current_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub is_digit_symbol: []u8,
    pub token_symbol: []u8,
    pub number_tag: i64,
}

// MirStringTokenStmt backs string_token(source, start, current): quoted strings scan from
// start + 1 to the closing quote, while double-slash multiline strings scan to the end of the
// continuation block. The renderer keeps both scans in this selected helper so raw_token_at does
// not need an extra multiline helper body in the stage2 fact set. string_tag is the TokenKind
// discriminant.
pub struct MirStringTokenStmt {
    pub source_name: []u8,
    pub start_name: []u8,
    pub current_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub token_symbol: []u8,
    pub string_tag: i64,
}

// MirSkipLineCommentStmt backs skip_line_comment(source, start, initial): 'var end = start; var
// current = initial; while end < len(source) and source[end] != 10 { current = advance_byte(
// source[end], current); end = end + 1; } return token(Eof, end, end, current);' (tracker 961,
// scope 4 prerequisite). The renderer threads a two-phi loop (i64 end + Position struct current)
// past the comment line, folding advance_byte over each byte until newline, then builds the Eof
// Token at end. eof_tag is the TokenKind discriminant; advance_byte_symbol / token_symbol are the
// already-compiled callees.
pub struct MirSkipLineCommentStmt {
    pub source_name: []u8,
    pub start_name: []u8,
    pub initial_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub advance_byte_symbol: []u8,
    pub token_symbol: []u8,
    pub eof_tag: i64,
}

// MirTokenAtStmt backs token_at(source, offset, initial): the top-level tokenizer step that skips
// leading whitespace (counting blank lines) and line comments, tracks the pending doc-comment span,
// then returns attach_doc(raw_token_at(source, start, current), doc_start, doc_end) (tracker 961,
// scope 4 prerequisite). The renderer emits an outer loop (start / current / has_doc / doc_start /
// doc_end phis) with an inner whitespace loop (start / current / newlines phis); the conditional
// doc-span updates use selects, and every callee is an already-compiled lexer helper.
pub struct MirTokenAtStmt {
    pub source_name: []u8,
    pub offset_name: []u8,
    pub initial_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub is_space_symbol: []u8,
    pub advance_byte_symbol: []u8,
    pub is_doc_comment_start_symbol: []u8,
    pub skip_line_comment_symbol: []u8,
    pub position_symbol: []u8,
    pub raw_token_at_symbol: []u8,
    pub attach_doc_symbol: []u8,
}

// MirTokenKindPredicateStmt backs the parser's TokenKind predicates, either the compact
// 'return match token.kind { <Variant> => true, _ => false };' form or the exhaustive statement
// match with return-bool arms. The renderer extracts the TokenKind field off the Token param and
// compares it to every true variant discriminant, returning the OR-chain result (tracker 961,
// scope 4 prerequisite).
pub struct MirTokenKindPredicateStmt {
    pub token_name: []u8,
    pub token_type: []u8,
    pub kind_field_index: i64,
    pub variant_tags: std::array::Array<i64>,
}

// MirParserSpanPredicateStmt backs parser span classifiers that scan a source Span rather than a
// TokenKind: is_namespace_path_span(source, span) and is_struct_literal_type_span(source, span).
// They are small recursive-descent parser disambiguators used by type/postfix parsing. The
// renderer emits their explicit loop-carried state and calls the already-compiled byte helpers
// (is_name_byte / is_double_colon_at / is_upper_byte), keeping this work on the parser path
// instead of extending the legacy run scanner (tracker 961).
pub struct MirParserSpanPredicateStmt {
    pub mode: i64,
    pub source_name: []u8,
    pub span_name: []u8,
    pub span_type: []u8,
    pub is_name_symbol: []u8,
    pub is_double_colon_symbol: []u8,
    pub is_upper_symbol: []u8,
}

// MirParserPostfixStartStmt backs the parser's AST-aware postfix disambiguators:
// is_type_apply_start(ast, text, left) and is_struct_literal_start(ast, text, left). They read the
// ParseNode's next Token for the syntax guard, bind the left AstNode via Ast.get(left.node), then
// delegate the final span classification to the compiled span predicates (tracker 961).
pub struct MirParserPostfixStartStmt {
    pub mode: i64,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub text_name: []u8,
    pub left_name: []u8,
    pub left_type: []u8,
    pub token_type: []u8,
    pub ast_node_type: []u8,
    pub span_type: []u8,
    pub node_field_index: i64,
    pub next_field_index: i64,
    pub ast_node_span_field_index: i64,
    pub guard_symbol: []u8,
    pub span_symbol: []u8,
}

// MirArrayNewStmt backs 'var <result> = std::array::Array<T>(<allocator>)': it binds a fresh
// runtime-owned array handle by calling @kizu_rt_array_new with the allocator and the element
// byte width. The width is derived from element_type via 'ptrtoint (ptr getelementptr (T, ptr
// null, i32 1) to i64)' rather than a per-call constant, so the same statement serves Array<Token>
// and Array<i64> without a hardcoded size (issue 1165: generic Array constructor lowering).
pub struct MirArrayNewStmt {
    pub result_name: []u8,
    pub owned_type: []u8,
    pub allocator_name: []u8,
    pub element_type: []u8,
}

// MirValueWhileStmt backs a value-carried bounded loop that appends struct values into a runtime
// array until a sentinel tag is reached -- the std::kizu::lexer::tokenize shape lowered generically
// (issue 1165). Unlike the i64-induction While, the loop carries a struct value (loop_var, type
// element_type) through a phi: the preheader seeds it with init_symbol(source), each body iteration
// recomputes it via update_symbol(source, loop_var), and the loop exits when field_index of the
// value equals eof_tag. Every carried value (seed + each iteration) is try-appended into array_name
// via array_append_symbol; an append failure returns this function's %kizu.error.owned failure
// early. The renderer keeps init/seed/loop/early-return/done in one basic-block group (label_base
// namespaces the blocks) so the cross-statement block wiring stays internal; only array_name is read
// from a preceding MirArrayNewStmt as an SSA value. The loop's done block returns the array as the
// !Array success, so it subsumes the trailing 'return <array>'.
pub struct MirValueWhileStmt {
    pub array_name: []u8,
    pub loop_var: []u8,
    pub source_name: []u8,
    pub element_type: []u8,
    pub owned_type: []u8,
    pub error_owned_type: []u8,
    pub error_void_type: []u8,
    pub init_callee_qualified: []u8,
    pub update_callee_qualified: []u8,
    pub array_append_symbol: []u8,
    pub field_index: i64,
    pub eof_tag: i64,
    pub label_base: []u8,
}

// MirFirstTokenStmt backs first_token(source): 'return token_at(source, 0, position(1, 1));'
// (tracker 961, scope 4 prerequisite). The renderer builds the (1, 1) start Position then returns
// token_at at offset 0. Its nested call argument (position(1, 1)) the generic path does not model,
// so it is dispatched by name.
pub struct MirFirstTokenStmt {
    pub source_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub position_symbol: []u8,
    pub token_at_symbol: []u8,
}

// MirNextTokenStmt backs next_token(source, previous): it reads previous.start / end / line /
// column, advances the Position across the previous token span via advance_position, then returns
// token_at at previous.end (tracker 961, scope 4 prerequisite). Its nested call arguments
// (position(...) feeding advance_position) the generic path does not model, so it is dispatched by
// name.
pub struct MirNextTokenStmt {
    pub source_name: []u8,
    pub previous_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub position_symbol: []u8,
    pub advance_position_symbol: []u8,
    pub token_at_symbol: []u8,
}

// MirOperator is one entry of raw_token_at's operator dispatch table (tracker 961, scope 4
// prerequisite). When byte matches the first byte, the renderer returns the single-char Token
// (single_tag, start..start+1). second_byte >= 0 adds a look-ahead: if source[start+1] equals it,
// the two-char Token (two_tag, start..start+2) is returned instead; third_byte >= 0 adds one more
// alternative (third_tag, used only by '=' -> Eq / FatArrow / Assign). -1 marks an absent
// alternative.
pub struct MirOperator {
    pub byte: i64,
    pub single_tag: i64,
    pub second_byte: i64,
    pub two_tag: i64,
    pub third_byte: i64,
    pub third_tag: i64,
}

// MirRawTokenStmt backs raw_token_at(source, start, current): an Eof guard, an operator dispatch
// table over the byte at start, then quote / multiline-string / digit / word fallbacks dispatching
// to string_token / number_token / word_token (tracker 961, scope 4 prerequisite). eof_tag is the
// TokenKind::Eof discriminant; the *_symbol fields are the already-compiled callees; operators owns
// the dispatch table Array.
pub struct MirRawTokenStmt {
    pub source_name: []u8,
    pub start_name: []u8,
    pub current_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub token_symbol: []u8,
    pub is_digit_symbol: []u8,
    pub string_token_symbol: []u8,
    pub number_token_symbol: []u8,
    pub word_token_symbol: []u8,
    pub eof_tag: i64,
    pub operators: std::array::Array<MirOperator>,
}

// MirKeyword is one (spelling, TokenKind tag) entry of word_token's keyword table (tracker 961,
// scope 4 prerequisite). The renderer emits the spelling as a private string constant and compares
// the scanned identifier slice against it via equal_bytes, returning the keyword Token on a match.
// It owns nothing (text is a borrowed literal slice), so its deinit is empty.
pub struct MirKeyword {
    pub text: []u8,
    pub tag: i64,
}

// MirWordTokenStmt backs word_token(source, start, current): it scans an identifier run (is_word),
// returns a single-byte Ident when the run is empty, otherwise compares the run against the keyword
// table and returns the matching keyword Token, falling back to a multi-byte Ident (tracker 961,
// scope 4 prerequisite). is_word_symbol / token_symbol / equal_bytes_symbol are the already-
// compiled callees; ident_tag is the Ident discriminant; keywords owns the keyword table Array.
pub struct MirWordTokenStmt {
    pub symbol: []u8,
    pub source_name: []u8,
    pub start_name: []u8,
    pub current_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub is_word_symbol: []u8,
    pub token_symbol: []u8,
    pub equal_bytes_symbol: []u8,
    pub ident_tag: i64,
    pub keywords: std::array::Array<MirKeyword>,
}

// MirIsDocCommentStartStmt backs is_doc_comment_start(source, start): 'let length = len(source);
// if start + 2 >= length { return false; } if source[start] != 47 or source[start + 1] != 47 or
// source[start + 2] != 47 { return false; } return start + 3 >= length or source[start + 3] != 47;'
// (tracker 961, scope 4 prerequisite). The renderer emits a bounded branch chain returning i1:
// three slash bytes (47) make a comment, and a fourth slash (start + 3 in bounds) demotes it from
// a doc comment. All byte offsets / sentinels are fixed, so the renderer needs only the slice and
// start names.
pub struct MirIsDocCommentStartStmt {
    pub source_name: []u8,
    pub start_name: []u8,
}

// MirStringLiteralSpanStmt backs string_literal_span(text, ast, node_id): it binds the AstNode
// via Ast.get, reads the Span (AstNode field 0) start/end, rejects spans shorter than the two
// surrounding quote bytes, checks the leading/trailing double-quote (byte 34), forwards the
// inner payload slice to is_payload_supported, and returns the trimmed PayloadSpan on success or
// empty_payload_span() otherwise (tracker 961, scope 4 prerequisite). The callee module names
// the same selfhost::ir::codegen module both helper callees live in.
pub struct MirStringLiteralSpanStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub node_id_name: []u8,
    pub node_id_type: []u8,
    pub callee_module: []u8,
    pub is_payload_name: []u8,
    pub empty_name: []u8,
}

// MirPrintPayloadStmt backs print_payload(text, ast, locals, arg): it binds the AstNode via
// Ast.get, dispatches on the AstData tag, and on the String variant returns string_literal_span,
// on the Var variant returns local_payload_span(locals, ast_node_text(...)), and otherwise
// returns empty_payload_span() (tracker 961, scope 4 prerequisite). The variant tags come from
// the union-variant facts; the four helper callees live in the same selfhost::ir::codegen module.
pub struct MirPrintPayloadStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub locals_name: []u8,
    pub locals_type: []u8,
    pub arg_name: []u8,
    pub arg_type: []u8,
    pub callee_module: []u8,
    pub string_tag: i64,
    pub var_tag: i64,
    pub string_literal_span_name: []u8,
    pub ast_node_text_name: []u8,
    pub local_payload_span_name: []u8,
    pub empty_name: []u8,
}

// MirLowerPrintCallStmt backs lower_print_call(text, ast, function_name, statement_count, locals,
// callee, args): it recognises a single print("...") / print(local) call and builds the RunAst
// wrapped in an !RunAst error union (tracker 961, scope 4 prerequisite). The renderer compares
// the callee text against the "print" literal, rejects a wrong arity, propagates the checked
// Ast.child_at failure, extracts the argument payload via print_payload, and wraps print_run_ast
// or unsupported_run_ast into the error-union success. print_global_symbol names the "print"
// string constant global emitted in the globals pass.
pub struct MirLowerPrintCallStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub declarations_name: []u8,
    pub declarations_type: []u8,
    pub function_name_name: []u8,
    pub statement_count_name: []u8,
    pub locals_name: []u8,
    pub locals_type: []u8,
    pub callee_name: []u8,
    pub callee_type: []u8,
    pub args_name: []u8,
    pub args_type: []u8,
    pub print_global_symbol: []u8,
    pub call_tag: i64,
}

// MirLowerPrintStatementStmt backs lower_print_statement(text, ast, function_name,
// statement_count, locals, expr): it binds the AstNode via Ast.get, and on the Call variant
// extracts the CallNode's callee/args and forwards lower_print_call's !RunAst result directly
// (the source's 'return try lower_print_call(...)' is identity on the same error-union type),
// while every other variant returns the wrapped unsupported_run_ast() (tracker 961, scope 4
// prerequisite). call_tag is the Call discriminant from the union-variant facts.
pub struct MirLowerPrintStatementStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub declarations_name: []u8,
    pub declarations_type: []u8,
    pub function_name_name: []u8,
    pub statement_count_name: []u8,
    pub locals_name: []u8,
    pub locals_type: []u8,
    pub expr_name: []u8,
    pub expr_type: []u8,
    pub call_tag: i64,
}

// MirLowerRunParseResultStmt backs lower_run_parse_result(text, parsed): it consumes the parser's
// checked ParseResult boundary, extracts ast/root, and forwards to the existing lower_run_ast
// traversal. The parse-result field indexes come from struct-field facts.
pub struct MirLowerRunParseResultStmt {
    pub text_name: []u8,
    pub parsed_name: []u8,
    pub parsed_type: []u8,
    pub ast_field_index: i64,
    pub root_field_index: i64,
}

// MirLowerRunAstBlockStmt backs lower_run_ast_block(text, ast, function_name, statements): the
// stateful run-block traversal (tracker 961, scope 4 prerequisite). It threads a mutable
// LocalTable and index through a bounded loop over the statements: each non-terminal statement
// must be a Let binding (lower_let_binding, inserted via insert_local), and the terminal statement
// must be an ExprStmt forwarded to lower_print_statement. Any rejection returns the wrapped
// unsupported_run_ast(); the checked Ast.child_at failure propagates as the !RunAst error.
// let_tag / expr_stmt_tag / return_tag / empty_tag are discriminants from the
// union-variant facts.
pub struct MirLowerRunAstBlockStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub declarations_name: []u8,
    pub declarations_type: []u8,
    pub function_name_name: []u8,
    pub statements_name: []u8,
    pub statements_type: []u8,
    pub locals_type: []u8,
    pub let_tag: i64,
    pub expr_stmt_tag: i64,
    pub return_tag: i64,
    pub empty_tag: i64,
}

// MirLowerRunAstFunctionStmt backs lower_run_ast_function(text, ast, name, body): it requires the
// function name text to equal "main", binds the body AstNode via Ast.get, and on the Block variant
// forwards lower_run_ast_block's !RunAst result (passing the block's statements and the recomputed
// name text), while a non-main name or non-Block body returns the wrapped unsupported_run_ast()
// (tracker 961, scope 4 prerequisite). main_global_symbol names the "main" string constant global;
// block_tag is the Block discriminant from the union-variant facts.
pub struct MirLowerRunAstFunctionStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub declarations_name: []u8,
    pub declarations_type: []u8,
    pub name_name: []u8,
    pub name_type: []u8,
    pub body_name: []u8,
    pub body_type: []u8,
    pub main_global_symbol: []u8,
    pub block_tag: i64,
}

// MirLowerRunAstDeclarationsStmt backs lower_run_ast_declarations(text, ast, declarations): it
// scans the program declarations for the first FnDecl whose lower_run_ast_function produces a
// supported RunAst (tracker 961, scope 4 prerequisite). Each declaration binds via Ast.get; a
// FnDecl forwards through lower_run_ast_function (try-propagated), any other declaration yields
// unsupported_run_ast(); when run_ast_supported holds the wrapped RunAst is returned, otherwise the
// scan continues and falls through to the wrapped unsupported_run_ast(). fn_decl_tag is the FnDecl
// discriminant; the FnDeclNode name/body live at fields 3/8.
pub struct MirLowerRunAstDeclarationsStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub declarations_name: []u8,
    pub declarations_type: []u8,
    pub fn_decl_tag: i64,
}

// MirLowerRunAstStmt backs lower_run_ast(text, ast, root): the run-codegen AST traversal root. It
// binds the root AstNode via Ast.get and on the Program variant forwards lower_run_ast_declarations'
// !RunAst result (passing the program declarations), while every other root returns the wrapped
// unsupported_run_ast() (tracker 961, scope 4 prerequisite). program_tag is the Program discriminant
// from the union-variant facts; the ProgramNode declarations live at field 0.
pub struct MirLowerRunAstStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub root_name: []u8,
    pub root_type: []u8,
    pub program_tag: i64,
}

// MirReturnTryBinaryStmt backs a 'return <literal> + try <callee>(<args>);' single return
// (count_one / count_with_range, tracker 961). The renderer emits the call, branches on its
// ok flag, propagates the failure as this function's own error union, and on success adds the
// literal to the unwrapped value and returns it wrapped as the error-union success. It owns
// the call-argument Array.
pub struct MirReturnTryBinaryStmt {
    pub literal: i64,
    pub called_error_union: []u8,
    pub own_error_union: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirStringTryAppendStmt backs a mutating 'try <receiver>.append_bytes(<arg>);' or
// 'try <receiver>.append_byte(<arg>);' statement on a std::string::String value
// (issue 1165 slice 1). String lowers to the runtime-owned handle %kizu.owned, and the
// method forwards to the @kizu_rt_string_append_* runtime helper returning %kizu.error.void.
// The renderer emits the call, branches on its ok flag, and on failure propagates the
// runtime message as this function's own error union (own_error_union); on success it
// continues in place because the statement binds no value. It owns the call-argument Array
// holding the single appended value.
pub struct MirStringTryAppendStmt {
    pub receiver_name: []u8,
    pub runtime_symbol: []u8,
    pub own_error_union: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirMatchTraversalStmt backs the node_count recursive AST-traversal accessor: 'let node =
// tree.get(node_id); return match node.data { <44 arms> };' (tracker 961). The renderer binds
// the AstNode by value off the Ast.get call, extracts the AstData union (field
// data_field_index) and its i64 tag, then emits an exhaustive icmp/br chain over the arms,
// each arm returning a real value (no 'unreachable'). own_error_union is the node_count return
// type the leaf arms wrap into. It owns the arm Array.
pub struct MirMatchTraversalStmt {
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub index_type: []u8,
    pub index_name: []u8,
    pub data_field_index: i64,
    pub own_error_union: []u8,
    pub arms: std::array::Array<MirTraversalArm>,
}

pub union MirStmt {
    LetCall(MirLetCallStmt),
    LetStruct(MirLetStructStmt),
    LetArenaAdd(MirLetArenaAddStmt),
    LetExpr(MirLetExprStmt),
    LetTryCall(MirLetTryCallStmt),
    ReturnTryBinary(MirReturnTryBinaryStmt),
    StringTryAppend(MirStringTryAppendStmt),
    CountRange(MirCountRangeStmt),
    TrimAscii(MirTrimAsciiStmt),
    AdvancePosition(MirAdvancePositionStmt),
    NumberToken(MirNumberTokenStmt),
    StringToken(MirStringTokenStmt),
    SkipLineComment(MirSkipLineCommentStmt),
    IsDocCommentStart(MirIsDocCommentStartStmt),
    WordToken(MirWordTokenStmt),
    RawToken(MirRawTokenStmt),
    TokenAt(MirTokenAtStmt),
    FirstToken(MirFirstTokenStmt),
    NextToken(MirNextTokenStmt),
    ArrayNew(MirArrayNewStmt),
    ValueWhile(MirValueWhileStmt),
    TokenKindPredicate(MirTokenKindPredicateStmt),
    ParserSpanPredicate(MirParserSpanPredicateStmt),
    ParserPostfixStart(MirParserPostfixStartStmt),
    AstNodeText(MirAstNodeTextStmt),
    StringLiteralSpan(MirStringLiteralSpanStmt),
    PrintPayload(MirPrintPayloadStmt),
    LowerPrintCall(MirLowerPrintCallStmt),
    LowerPrintStatement(MirLowerPrintStatementStmt),
    LowerRunParseResult(MirLowerRunParseResultStmt),
    LowerRunAstBlock(MirLowerRunAstBlockStmt),
    LowerRunAstFunction(MirLowerRunAstFunctionStmt),
    LowerRunAstDeclarations(MirLowerRunAstDeclarationsStmt),
    LowerRunAst(MirLowerRunAstStmt),
    ReturnCall(MirReturnCallStmt),
    ReturnStruct(MirReturnStructStmt),
    ReturnExpr(MirReturnExprStmt),
    ReturnError(MirReturnErrorStmt),
    ReturnArrayGet(MirReturnArrayGetStmt),
    LetArrayGet(MirLetArrayGetStmt),
    If(MirIfStmt),
    While(MirWhileStmt),
    MatchTraversal(MirMatchTraversalStmt),
}

// Only the Call instruction reads a result value and callee symbol; the scalar
// block instructions render purely from the function return type and terminator.
// The block-level call arguments live on MirFunction.call_args (which the call
// renderer reads), so the Call payload carries no argument Array of its own and
// every MirInstruction variant is copy-only. The union owns nothing and needs no
// deinit (issue 1007/1012, ADR-0075).
pub struct MirCallInst {
    pub result: MirValue,
    pub module_prefix: []u8,
    pub callee_name: []u8,
}

// MirArrayGetInst backs a read-only 'return self.<field>.get(index);' accessor
// (Array<T>.get -> !T, tracker 961). The renderer reads the Array<T> handle off
// the struct value receiver (extractvalue field_index), calls the checked
// @kizu_rt_array_at runtime helper, and on success loads the element_type value
// out of the borrowed view and wraps it as the error-union success value; on
// failure it forwards the runtime message as the error-union failure value. The
// error-union return type lives on MirFunction.return_type. The instruction owns
// nothing, so it is copy-only (issue 1007/1012, ADR-0075).
pub struct MirArrayGetInst {
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub field_index: i64,
    pub index_name: []u8,
    pub element_type: []u8,
}

// MirArenaGetInst backs a read-only 'return self.<field>.get(<param>.<field>);'
// accessor (Arena<T>.get -> T, tracker 961). The renderer reads the Arena<T> handle
// off the struct value receiver, calls the checked @kizu_rt_arena_get runtime helper,
// and on success loads the element_type value out of the borrowed view and returns it;
// on out-of-bounds it traps via @kizu_rt_trap (Arena.get panics rather than returning
// an error union). The index is a field access on a value parameter (NodeId.raw). The
// instruction owns nothing, so it is copy-only.
pub struct MirArenaGetInst {
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub arena_field_index: i64,
    pub element_type: []u8,
    pub index_param_type: []u8,
    pub index_param_name: []u8,
    pub index_field_index: i64,
}

// MirMatchUnionInst backs the first 'match <ast node>.data { Variant(bind) =>
// bind.<field>.<field>, _ => <int> }' accessor compiled into stage2 (tracker 961).
// It is a read-only AST accessor whose body first binds an AstNode by value from an
// Ast.get method call (self_name.get(index_name)), then matches on the AstNode/AstData
// tagged-union value: the renderer extracts the AstData union (AstNode field
// data_field_index), reads its i64 tag (field 0), and dispatches on variant_tag. The
// active arm extracts the variant payload out of the inline union storage (the canonical
// alloca+store+gep field 1+load ABI) and returns a two-level field access off it
// (payload field0_index : field0_type, then field1_index : the i64 return type). The
// default arm returns default_value. The Ast.get callee symbol and the AstNode/AstData
// llvm types are the fixed AstData match ABI, so the renderer hardcodes them; everything
// variant-specific flows through this instruction. It owns nothing, so it is copy-only.
pub struct MirMatchUnionInst {
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub index_type: []u8,
    pub index_name: []u8,
    pub data_field_index: i64,
    pub variant_tag: i64,
    pub payload_type: []u8,
    pub field0_index: i64,
    pub field0_type: []u8,
    pub field1_index: i64,
    pub default_value: i64,
}

pub union MirInstruction {
    ConstString,
    ConstInt,
    StructLiteral,
    Expr,
    MultiStatement,
    Call(MirCallInst),
    ArrayGet(MirArrayGetInst),
    ArenaGet(MirArenaGetInst),
    MatchUnion(MirMatchUnionInst),
}

pub enum MirTerminatorKind {
    Return,
}

pub struct MirTerminator {
    pub kind: MirTerminatorKind,
    pub value: MirValue,
}

pub struct MirBlock {
    pub label: []u8,
    pub instruction_count: i64,
    pub first_instruction: MirInstruction,
    pub terminator: MirTerminator,
}

pub struct MirFunction {
    pub name: []u8,
    pub return_type: MirType,
    pub params_spec: []u8,
    pub call_args: std::array::Array<MirCallArg>,
    pub struct_fields: std::array::Array<MirStructField>,
    pub expr_insts: std::array::Array<MirExprInst>,
    pub multi_stmts: std::array::Array<MirStmt>,
    pub block_count: i64,
    pub entry: MirBlock,
}

// MirStructField owns the call-argument Array of a call-valued field (Call kind);
// non-call fields hold the empty array from empty_struct_call_args. It is only
// ever stored in struct_fields Arrays, so this cleanup runs through structural
// array drop, mirroring MirCallExpr (tracker 961).
impl MirStructField {
    fn deinit(self: MirStructField) -> void {
        self.call_args.deinit();
        self.nested_fields.deinit();
        return;
    }
}

// MirExprInst is the only block-level owner union: its Call variant owns the
// expression call-argument Array, so its deinit frees that payload and the scalar
// variants own nothing (issue 1010 owner-payload union cleanup contract). It is
// only ever stored in Arrays, so this cleanup runs through structural array drop.
impl MirCallExpr {
    fn deinit(self: MirCallExpr) -> void {
        self.call_args.deinit();
        return;
    }
}

impl MirExprInst {
    fn deinit(self: MirExprInst) -> void {
        match self {
            Var(payload) => return;,
            ConstString(payload) => return;,
            ConstBool(payload) => return;,
            ConstInt(payload) => return;,
            ConstEnumTag(payload) => return;,
            PrefixNot(payload) => return;,
            Binary(payload) => return;,
            FieldAccess(payload) => return;,
            IndexLoad(payload) => return;,
            Slice(payload) => return;,
            Call(payload) => payload.deinit(),
            ArrayLen(payload) => return;,
        }
    }
}

