pub fn var_expr_inst(id: i64, ty: []u8, name: []u8) -> MirExprInst {
    return MirExprInst::Var(MirVarExpr {
        id: id,
        llvm_type: ty,
        value: name
    });
}

pub fn string_expr_inst(id: i64, payload: []u8, string_index: i64) -> MirExprInst {
    return MirExprInst::ConstString(MirConstStringExpr {
        id: id,
        llvm_type: "%kizu.slice.u8",
        value: payload,
        string_index: string_index
    });
}

pub fn bool_expr_inst(id: i64, value: bool) -> MirExprInst {
    return MirExprInst::ConstBool(MirConstBoolExpr {
        id: id,
        llvm_type: "i1",
        bool_value: value
    });
}

pub fn int_expr_inst(id: i64, value: i64) -> MirExprInst {
    return MirExprInst::ConstInt(MirConstIntExpr {
        id: id,
        llvm_type: "i64",
        int_value: value
    });
}

pub fn typed_int_expr_inst(id: i64, value: i64, llvm_type: []u8) -> MirExprInst {
    return MirExprInst::ConstInt(MirConstIntExpr {
        id: id,
        llvm_type: llvm_type,
        int_value: value
    });
}

pub fn prefix_not_expr_inst(id: i64, operand: i64) -> MirExprInst {
    return MirExprInst::PrefixNot(MirPrefixNotExpr {
        id: id,
        llvm_type: "i1",
        operand: operand
    });
}

fn binary_result_type(op: []u8) -> []u8 {
    if std::mem::equal_bytes(op, "add") or std::mem::equal_bytes(op, "sub") or
        std::mem::equal_bytes(op, "mul") or std::mem::equal_bytes(op, "div") {
        return "i64";
    }
    return "i1";
}

pub fn binary_expr_inst(id: i64, op: []u8, left: i64, right: i64) -> MirExprInst {
    return MirExprInst::Binary(MirBinaryExpr {
        id: id,
        llvm_type: binary_result_type(op),
        op: op,
        left: left,
        right: right
    });
}

pub fn enum_tag_expr_inst(id: i64, tag: i64) -> MirExprInst {
    return MirExprInst::ConstEnumTag(MirConstEnumTagExpr {
        id: id,
        llvm_type: "i64",
        int_value: tag
    });
}

pub fn union_construct_expr_inst(id: i64, llvm_type: []u8, tag: i64) -> MirExprInst {
    return MirExprInst::UnionConstruct(MirUnionConstructExpr {
        id: id,
        llvm_type: llvm_type,
        tag: tag,
        payload_value: 0 - 1,
        payload_type: llvm_type[0..0]
    });
}

pub fn union_construct_payload_expr_inst(
    id: i64,
    llvm_type: []u8,
    tag: i64,
    payload_value: i64,
    payload_type: []u8
) -> MirExprInst {
    return MirExprInst::UnionConstruct(MirUnionConstructExpr {
        id: id,
        llvm_type: llvm_type,
        tag: tag,
        payload_value: payload_value,
        payload_type: payload_type
    });
}

pub fn struct_literal_expr_inst(
    id: i64,
    llvm_type: []u8,
    fields: std::array::Array<MirStructField>
) -> MirExprInst {
    return MirExprInst::StructLiteral(MirStructLiteralExpr {
        id: id,
        llvm_type: llvm_type,
        struct_fields: fields
    });
}

pub fn field_access_expr_inst(
    id: i64,
    field_type: []u8,
    receiver_name: []u8,
    receiver_type: []u8,
    source_field_index: i64
) -> MirExprInst {
    return MirExprInst::FieldAccess(MirFieldAccessExpr {
        id: id,
        llvm_type: field_type,
        value: receiver_name,
        left: -1,
        source_type: receiver_type,
        source_field_index: source_field_index
    });
}

pub fn field_access_temp_expr_inst(
    id: i64,
    field_type: []u8,
    receiver_id: i64,
    receiver_type: []u8,
    source_field_index: i64
) -> MirExprInst {
    return MirExprInst::FieldAccess(MirFieldAccessExpr {
        id: id,
        llvm_type: field_type,
        value: "",
        left: receiver_id,
        source_type: receiver_type,
        source_field_index: source_field_index
    });
}

pub fn index_load_expr_inst(id: i64, target: []u8, index: i64) -> MirExprInst {
    return MirExprInst::IndexLoad(MirIndexLoadExpr {
        id: id,
        llvm_type: "i8",
        target: target,
        index: index
    });
}

pub fn slice_expr_inst(id: i64, target: i64, start: i64, end: i64) -> MirExprInst {
    return MirExprInst::Slice(MirSliceExpr {
        id: id,
        llvm_type: "%kizu.slice.u8",
        target: target,
        start: start,
        end: end
    });
}

pub fn call_expr_inst(
    id: i64,
    llvm_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirExprInst {
    return MirExprInst::Call(MirCallExpr {
        id: id,
        llvm_type: llvm_type,
        storage_llvm_type: llvm_type,
        success_llvm_type: "",
        result_transport: builtin_contract::RuntimeResultTransport::Semantic,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

pub fn storage_call_expr_inst(
    id: i64,
    semantic_llvm_type: []u8,
    storage_llvm_type: []u8,
    success_llvm_type: []u8,
    result_transport: builtin_contract::RuntimeResultTransport,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> !MirExprInst {
    if result_transport == builtin_contract::RuntimeResultTransport::Semantic or
        std::mem::len(storage_llvm_type) == 0 or
        std::mem::len(success_llvm_type) == 0 {
        return error("compiled mir: erased result call descriptor invalid");
    }
    return MirExprInst::Call(MirCallExpr {
        id: id,
        llvm_type: semantic_llvm_type,
        storage_llvm_type: storage_llvm_type,
        success_llvm_type: success_llvm_type,
        result_transport: result_transport,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

// array_len_expr_inst builds a local/param Array<T>.len() expression instruction
// (issue 1165). The receiver is a std::array::Array<T> (or &Array<T>) param/local
// that lowers to %kizu.owned, so the renderer reads the handle straight off the
// named value and calls @kizu_rt_array_len -> i64.
pub fn array_len_expr_inst(id: i64, receiver_name: []u8) -> MirExprInst {
    return MirExprInst::ArrayLen(MirArrayLenExpr {
        id: id,
        llvm_type: "i64",
        receiver_name: receiver_name
    });
}

// string_len_expr_inst builds a local/param std::string::String.len() expression instruction.
// The renderer reads the owned String handle and calls @kizu_rt_string_len -> i64.
pub fn string_len_expr_inst(id: i64, receiver_name: []u8) -> MirExprInst {
    return MirExprInst::StringLen(MirStringLenExpr {
        id: id,
        llvm_type: "i64",
        receiver_name: receiver_name
    });
}

// int_cast_expr_inst builds an integer 'cast<iN>(<expr>)' instruction over the
// already-lowered source temp 'operand' (source_llvm), producing target_llvm.
pub fn int_cast_expr_inst(
    id: i64,
    operand: i64,
    source_llvm: []u8,
    target_llvm: []u8
) -> MirExprInst {
    return MirExprInst::IntCast(MirIntCastExpr {
        id: id,
        llvm_type: target_llvm,
        operand: operand,
        source_llvm: source_llvm
    });
}

// try_unwrap_expr_inst builds a 'try <expr>' value-position instruction over the
// already-lowered inner error-union temp 'operand' (called_error_union), unwrapping
// its success value (llvm_type) on the continue path or propagating the re-wrapped
// failure through own_error_union (issue 1157 big-bang).
pub fn try_unwrap_expr_inst(
    id: i64,
    llvm_type: []u8,
    operand: i64,
    called_error_union: []u8,
    own_error_union: []u8
) -> MirExprInst {
    return MirExprInst::TryUnwrap(MirTryUnwrapExpr {
        id: id,
        llvm_type: llvm_type,
        operand: operand,
        called_error_union: called_error_union,
        own_error_union: own_error_union
    });
}

// expr_inst_id and expr_inst_llvm_type read the result id and LLVM type that
// every expr-inst variant carries, so result wiring (type-by-id lookups) does
// not depend on the active variant.
pub fn expr_inst_id(inst: &MirExprInst) -> i64 {
    return match inst {
        Var(payload) => payload.id,
        ConstString(payload) => payload.id,
        ConstBool(payload) => payload.id,
        ConstInt(payload) => payload.id,
        ConstEnumTag(payload) => payload.id,
        PrefixNot(payload) => payload.id,
        Binary(payload) => payload.id,
        FieldAccess(payload) => payload.id,
        IndexLoad(payload) => payload.id,
        Slice(payload) => payload.id,
        Call(payload) => payload.id,
        ArrayLen(payload) => payload.id,
        StringLen(payload) => payload.id,
        IntCast(payload) => payload.id,
        UnionConstruct(payload) => payload.id,
        StructLiteral(payload) => payload.id,
        TryUnwrap(payload) => payload.id,
    };
}

pub fn expr_inst_llvm_type(inst: &MirExprInst) -> []u8 {
    return match inst {
        Var(payload) => payload.llvm_type,
        ConstString(payload) => payload.llvm_type,
        ConstBool(payload) => payload.llvm_type,
        ConstInt(payload) => payload.llvm_type,
        ConstEnumTag(payload) => payload.llvm_type,
        PrefixNot(payload) => payload.llvm_type,
        Binary(payload) => payload.llvm_type,
        FieldAccess(payload) => payload.llvm_type,
        IndexLoad(payload) => payload.llvm_type,
        Slice(payload) => payload.llvm_type,
        Call(payload) => payload.llvm_type,
        ArrayLen(payload) => payload.llvm_type,
        StringLen(payload) => payload.llvm_type,
        IntCast(payload) => payload.llvm_type,
        UnionConstruct(payload) => payload.llvm_type,
        StructLiteral(payload) => payload.llvm_type,
        TryUnwrap(payload) => payload.llvm_type,
    };
}

pub fn copy_call_arg(arg: &MirCallArg) -> !MirCallArg {
    let copied_call_args = try copy_call_args(&arg.call_args);
    return MirCallArg {
        ty: arg.ty,
        semantic_type: arg.semantic_type,
        storage_codec: arg.storage_codec,
        kind: arg.kind,
        value: arg.value,
        bool_value: arg.bool_value,
        string_index: arg.string_index,
        int_value: arg.int_value,
        source_type: arg.source_type,
        source_field_index: arg.source_field_index,
        nested_source_type: arg.nested_source_type,
        nested_field_index: arg.nested_field_index,
        slice_start_base: arg.slice_start_base,
        slice_start_offset: arg.slice_start_offset,
        slice_start_source_type: arg.slice_start_source_type,
        slice_start_field_index: arg.slice_start_field_index,
        slice_end_base: arg.slice_end_base,
        slice_end_offset: arg.slice_end_offset,
        slice_end_source_type: arg.slice_end_source_type,
        slice_end_field_index: arg.slice_end_field_index,
        call_module_prefix: arg.call_module_prefix,
        call_callee_name: arg.call_callee_name,
        call_args: copied_call_args
    };
}

pub fn storage_call_arg(
    arg: &MirCallArg, storage_type: []u8, conversion: MirStorageCodec
) -> !MirCallArg {
    if conversion == MirStorageCodec::None or std::mem::len(storage_type) == 0 {
        return error("compiled mir: storage conversion missing");
    }
    let copied_call_args = try copy_call_args(&arg.call_args);
    return MirCallArg {
        ty: storage_type, semantic_type: arg.ty,
        storage_codec: conversion,
        kind: arg.kind, value: arg.value, bool_value: arg.bool_value,
        string_index: arg.string_index, int_value: arg.int_value,
        source_type: arg.source_type,
        source_field_index: arg.source_field_index,
        nested_source_type: arg.nested_source_type,
        nested_field_index: arg.nested_field_index,
        slice_start_base: arg.slice_start_base,
        slice_start_offset: arg.slice_start_offset,
        slice_start_source_type: arg.slice_start_source_type,
        slice_start_field_index: arg.slice_start_field_index,
        slice_end_base: arg.slice_end_base,
        slice_end_offset: arg.slice_end_offset,
        slice_end_source_type: arg.slice_end_source_type,
        slice_end_field_index: arg.slice_end_field_index,
        call_module_prefix: arg.call_module_prefix,
        call_callee_name: arg.call_callee_name,
        call_args: copied_call_args
    };
}

pub fn copy_call_args(args: &std::array::Array<MirCallArg>) -> !std::array::Array<MirCallArg> {
    var copied = std::array::Array<MirCallArg>(std::mem::page_allocator());
    var index = 0;
    while index < args.len() {
        let arg = try args.at(index);
        try copied.append(try copy_call_arg(arg));
        index = index + 1;
    }
    return copied;
}

pub fn copy_struct_field(field: &MirStructField) -> !MirStructField {
    return MirStructField {
        index: field.index,
        kind: field.kind,
        llvm_type: field.llvm_type,
        value: field.value,
        int_value: field.int_value,
        bool_value: field.bool_value,
        source_type: field.source_type,
        source_field_index: field.source_field_index,
        nested_source_type: field.nested_source_type,
        computed_rhs_name: field.computed_rhs_name,
        computed_op: field.computed_op,
        computed_lhs_literal: field.computed_lhs_literal,
        computed_lhs_is_literal: field.computed_lhs_is_literal,
        computed_rhs_literal: field.computed_rhs_literal,
        computed_rhs_is_literal: field.computed_rhs_is_literal,
        call_module_prefix: field.call_module_prefix,
        call_callee_name: field.call_callee_name,
        call_args: try copy_call_args(&field.call_args),
        nested_fields: try copy_struct_fields(&field.nested_fields),
        access_path: try copy_field_steps(&field.access_path)
    };
}

pub fn copy_struct_fields(
    fields: &std::array::Array<MirStructField>
) -> !std::array::Array<MirStructField> {
    var copied = std::array::Array<MirStructField>(std::mem::page_allocator());
    var index = 0;
    while index < fields.len() {
        let field = try fields.at(index);
        try copied.append(try copy_struct_field(field));
        index = index + 1;
    }
    return copied;
}

pub fn copy_expr_inst(inst: &MirExprInst) -> !MirExprInst {
    return match inst {
        Var(payload) => MirExprInst::Var(MirVarExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            value: payload.value
        }),
        ConstString(payload) => MirExprInst::ConstString(MirConstStringExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            value: payload.value,
            string_index: payload.string_index
        }),
        ConstBool(payload) => MirExprInst::ConstBool(MirConstBoolExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            bool_value: payload.bool_value
        }),
        ConstInt(payload) => MirExprInst::ConstInt(MirConstIntExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            int_value: payload.int_value
        }),
        ConstEnumTag(payload) => MirExprInst::ConstEnumTag(MirConstEnumTagExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            int_value: payload.int_value
        }),
        PrefixNot(payload) => MirExprInst::PrefixNot(MirPrefixNotExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            operand: payload.operand
        }),
        Binary(payload) => MirExprInst::Binary(MirBinaryExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            op: payload.op,
            left: payload.left,
            right: payload.right
        }),
        FieldAccess(payload) => MirExprInst::FieldAccess(MirFieldAccessExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            value: payload.value,
            left: payload.left,
            source_type: payload.source_type,
            source_field_index: payload.source_field_index
        }),
        IndexLoad(payload) => MirExprInst::IndexLoad(MirIndexLoadExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            target: payload.target,
            index: payload.index
        }),
        Slice(payload) => MirExprInst::Slice(MirSliceExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            target: payload.target,
            start: payload.start,
            end: payload.end
        }),
        Call(payload) => MirExprInst::Call(MirCallExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            storage_llvm_type: payload.storage_llvm_type,
            success_llvm_type: payload.success_llvm_type,
            result_transport: payload.result_transport,
            call_module_prefix: payload.call_module_prefix,
            call_callee_name: payload.call_callee_name,
            call_args: try copy_call_args(&payload.call_args)
        }),
        ArrayLen(payload) => MirExprInst::ArrayLen(MirArrayLenExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            receiver_name: payload.receiver_name
        }),
        StringLen(payload) => MirExprInst::StringLen(MirStringLenExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            receiver_name: payload.receiver_name
        }),
        IntCast(payload) => MirExprInst::IntCast(MirIntCastExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            operand: payload.operand,
            source_llvm: payload.source_llvm
        }),
        UnionConstruct(payload) => MirExprInst::UnionConstruct(MirUnionConstructExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            tag: payload.tag,
            payload_value: payload.payload_value,
            payload_type: payload.payload_type
        }),
        StructLiteral(payload) => MirExprInst::StructLiteral(MirStructLiteralExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            struct_fields: try copy_struct_fields(&payload.struct_fields)
        }),
        TryUnwrap(payload) => MirExprInst::TryUnwrap(MirTryUnwrapExpr {
            id: payload.id,
            llvm_type: payload.llvm_type,
            operand: payload.operand,
            called_error_union: payload.called_error_union,
            own_error_union: payload.own_error_union
        }),
    };
}

pub fn copy_expr_insts(
    insts: &std::array::Array<MirExprInst>
) -> !std::array::Array<MirExprInst> {
    var copied = std::array::Array<MirExprInst>(std::mem::page_allocator());
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        try copied.append(try copy_expr_inst(inst));
        index = index + 1;
    }
    return copied;
}

fn copy_cond_operand(operand: &MirCondOperand) -> !MirCondOperand {
    return MirCondOperand {
        result_id: operand.result_id,
        insts: try copy_expr_insts(&operand.insts)
    };
}

pub fn copy_cond_operands(
    operands: &std::array::Array<MirCondOperand>
) -> !std::array::Array<MirCondOperand> {
    var copied = std::array::Array<MirCondOperand>(std::mem::page_allocator());
    var index = 0;
    while index < operands.len() {
        let operand = try operands.at(index);
        try copied.append(try copy_cond_operand(operand));
        index = index + 1;
    }
    return copied;
}

