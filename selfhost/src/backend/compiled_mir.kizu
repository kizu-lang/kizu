pub fn while_stmt(
    loop_index: i64,
    induction_var: []u8,
    induction_init: i64,
    induction_init_var: []u8,
    induction_init_offset: i64,
    induction_op: []u8,
    induction_step: i64,
    cond_result_id: i64,
    cond_insts: std::array::Array<MirExprInst>,
    cond_short_circuit: i64,
    cond_rhs_result_id: i64,
    cond_rhs_insts: std::array::Array<MirExprInst>,
    cond_extra_operands: std::array::Array<MirCondOperand>,
    cond_targets: std::array::Array<MirCondTarget>,
    body_stmts: std::array::Array<MirStmt>,
    latch_stmts: std::array::Array<MirStmt>,
    latch_copy_var: []u8,
    secondary_inductions: std::array::Array<MirSecondaryInduction>,
    carried_scalars: std::array::Array<MirCarriedScalar>,
    init_insts: std::array::Array<MirExprInst>,
    init_result_id: i64,
    branch_latch_exit_on_true: bool,
    branch_latch_cond_result_id: i64,
    branch_latch_cond_insts: std::array::Array<MirExprInst>,
    branch_latch_advance_stmts: std::array::Array<MirStmt>
) -> MirStmt {
    return MirStmt::While(MirWhileStmt {
        loop_index: loop_index,
        induction_var: induction_var,
        induction_init: induction_init,
        induction_init_var: induction_init_var,
        induction_init_offset: induction_init_offset,
        induction_op: induction_op,
        induction_step: induction_step,
        cond_result_id: cond_result_id,
        cond_insts: cond_insts,
        cond_short_circuit: cond_short_circuit,
        cond_rhs_result_id: cond_rhs_result_id,
        cond_rhs_insts: cond_rhs_insts,
        cond_extra_operands: cond_extra_operands,
        cond_targets: cond_targets,
        body_stmts: body_stmts,
        latch_stmts: latch_stmts,
        latch_copy_var: latch_copy_var,
        secondary_inductions: secondary_inductions,
        carried_scalars: carried_scalars,
        init_insts: init_insts,
        init_result_id: init_result_id,
        branch_latch_exit_on_true: branch_latch_exit_on_true,
        branch_latch_cond_result_id: branch_latch_cond_result_id,
        branch_latch_cond_insts: branch_latch_cond_insts,
        branch_latch_advance_stmts: branch_latch_advance_stmts
    });
}
