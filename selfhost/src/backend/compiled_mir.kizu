pub enum MirTypeKind {
    SliceU8,
    I64,
    Llvm,
}

pub struct MirType {
    pub kind: MirTypeKind,
    pub llvm_name: []u8,
}

pub enum MirValKind {
    ConstString,
    ConstInt,
    CallResult,
    StructResult,
    ExprResult,
    MultiResult,
}

pub struct MirValue {
    pub id: i64,
    pub ty: MirType,
    pub kind: MirValKind,
    pub payload: []u8,
    pub int_value: i64,
}

pub enum MirInstKind {
    ConstString,
    ConstInt,
    Call,
    StructLiteral,
    Expr,
    MultiStatement,
}

pub enum MirCallArgKind {
    Var,
    String,
    Bool,
    FieldAccess,
    EmptySlice,
    Slice,
}

pub struct MirCallArg {
    pub ty: []u8,
    pub kind: MirCallArgKind,
    pub value: []u8,
    pub bool_value: bool,
    pub string_index: i64,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub slice_start_base: []u8,
    pub slice_start_offset: i64,
    pub slice_end_base: []u8,
    pub slice_end_offset: i64,
}

pub enum MirStructFieldKind {
    Var,
    ConstString,
    ConstInt,
    ConstBool,
    ConstEnumTag,
    FieldAccess,
    EmptySlice,
}

pub struct MirStructField {
    pub index: i64,
    pub kind: MirStructFieldKind,
    pub llvm_type: []u8,
    pub value: []u8,
    pub int_value: i64,
    pub bool_value: bool,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub nested_source_type: []u8,
}

pub enum MirExprInstKind {
    Var,
    ConstString,
    ConstBool,
    ConstInt,
    PrefixNot,
    Binary,
    ConstEnumTag,
    FieldAccess,
    Call,
}

pub struct MirExprInst {
    pub id: i64,
    pub kind: MirExprInstKind,
    pub llvm_type: []u8,
    pub value: []u8,
    pub int_value: i64,
    pub bool_value: bool,
    pub left: i64,
    pub right: i64,
    pub op: []u8,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub enum MirIfThenKind {
    ReturnBool,
    ReturnCall,
    ReturnExpr,
    ReturnError,
}

// Per-variant MirStmt payloads. Each holds only the fields its variant needs and
// owns its inline Array storage, so the union below never carries inactive owned
// arrays (issue 1007/1011, ADR-0075 tagged-union payload ABI).
pub struct MirLetCallStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirLetStructStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirReturnCallStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirReturnStructStmt {
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirReturnExprStmt {
    pub string_index: i64,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

pub struct MirIfStmt {
    pub if_index: i64,
    pub string_index: i64,
    pub llvm_type: []u8,
    pub cond_result_id: i64,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub if_then_kind: MirIfThenKind,
    pub bool_value: bool,
    pub then_call_module_prefix: []u8,
    pub then_call_callee_name: []u8,
    pub then_call_args: std::array::Array<MirCallArg>,
    pub then_expr_result_id: i64,
    pub then_expr_insts: std::array::Array<MirExprInst>,
}

pub union MirStmt {
    LetCall(MirLetCallStmt),
    LetStruct(MirLetStructStmt),
    ReturnCall(MirReturnCallStmt),
    ReturnStruct(MirReturnStructStmt),
    ReturnExpr(MirReturnExprStmt),
    ReturnError,
    If(MirIfStmt),
}

pub struct MirInstruction {
    pub kind: MirInstKind,
    pub result: MirValue,
    pub module_prefix: []u8,
    pub callee_name: []u8,
    pub args: std::array::Array<MirCallArg>,
}

pub enum MirTerminatorKind {
    Return,
}

pub struct MirTerminator {
    pub kind: MirTerminatorKind,
    pub value: MirValue,
}

pub struct MirBlock {
    pub label: []u8,
    pub instruction_count: i64,
    pub first_instruction: MirInstruction,
    pub terminator: MirTerminator,
}

pub struct MirFunction {
    pub name: []u8,
    pub return_type: MirType,
    pub params_spec: []u8,
    pub call_args: std::array::Array<MirCallArg>,
    pub struct_fields: std::array::Array<MirStructField>,
    pub expr_insts: std::array::Array<MirExprInst>,
    pub multi_stmts: std::array::Array<MirStmt>,
    pub block_count: i64,
    pub entry: MirBlock,
}

// Interim cleanup for the remaining tag-plus-all-fields MIR records. Each deinit
// frees the owned Array fields initialized in the current record representation.
// This is not union active-variant cleanup; issue 991 specifies a tagged-union
// payload ABI and issue 1007 tracks the migration. MirStmt has already moved onto
// the union payload ABI (issue 1011); MirExprInst, MirInstruction, MirBlock, and
// MirFunction stay on the interim records until issue 1012. Until then, every
// constructed MIR owner aggregate must be deinitialized, moved, or returned.
impl MirExprInst {
    fn deinit(self: MirExprInst) -> void {
        self.call_args.deinit();
        return;
    }
}

impl MirInstruction {
    fn deinit(self: MirInstruction) -> void {
        self.args.deinit();
        return;
    }
}

impl MirBlock {
    fn deinit(self: MirBlock) -> void {
        self.first_instruction.deinit();
        return;
    }
}

impl MirLetCallStmt {
    fn deinit(self: MirLetCallStmt) -> void {
        self.call_args.deinit();
        return;
    }
}

impl MirLetStructStmt {
    fn deinit(self: MirLetStructStmt) -> void {
        self.struct_fields.deinit();
        return;
    }
}

impl MirReturnCallStmt {
    fn deinit(self: MirReturnCallStmt) -> void {
        self.call_args.deinit();
        return;
    }
}

impl MirReturnStructStmt {
    fn deinit(self: MirReturnStructStmt) -> void {
        self.struct_fields.deinit();
        return;
    }
}

impl MirReturnExprStmt {
    fn deinit(self: MirReturnExprStmt) -> void {
        self.expr_insts.deinit();
        return;
    }
}

impl MirIfStmt {
    fn deinit(self: MirIfStmt) -> void {
        self.cond_insts.deinit();
        self.then_call_args.deinit();
        self.then_expr_insts.deinit();
        return;
    }
}

// Active-variant cleanup for the owner-payload union: match self binds the live
// payload as an owned local and frees it through its own deinit, so inactive
// payload storage is never read or cleaned (issue 1010 cleanup contract). The
// payload-free ReturnError variant owns nothing and needs no cleanup.
impl MirStmt {
    fn deinit(self: MirStmt) -> void {
        match self {
            LetCall(payload) => payload.deinit(),
            LetStruct(payload) => payload.deinit(),
            ReturnCall(payload) => payload.deinit(),
            ReturnStruct(payload) => payload.deinit(),
            ReturnExpr(payload) => payload.deinit(),
            ReturnError => return;,
            If(payload) => payload.deinit(),
        }
    }
}

impl MirFunction {
    fn deinit(self: MirFunction) -> void {
        self.call_args.deinit();
        self.struct_fields.deinit();
        self.expr_insts.deinit();
        self.multi_stmts.deinit();
        self.entry.deinit();
        return;
    }
}

pub fn slice_u8_type() -> MirType {
    return MirType {
        kind: MirTypeKind::SliceU8,
        llvm_name: "%kizu.slice.u8"
    };
}

pub fn i64_type() -> MirType {
    return MirType {
        kind: MirTypeKind::I64,
        llvm_name: "i64"
    };
}

pub fn llvm_type(name: []u8) -> MirType {
    return MirType {
        kind: MirTypeKind::Llvm,
        llvm_name: name
    };
}

pub fn mir_string_const_value(id: i64, payload: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: slice_u8_type(),
        kind: MirValKind::ConstString,
        payload: payload,
        int_value: 0
    };
}

pub fn const_int_value(id: i64, value: i64) -> MirValue {
    return MirValue {
        id: id,
        ty: i64_type(),
        kind: MirValKind::ConstInt,
        payload: "",
        int_value: value
    };
}

pub fn call_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
