    llvm_type: []u8,
    string_index: i64,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirStmt {
    return MirStmt::ReturnCall(MirReturnCallStmt {
        name: "ret_val",
        llvm_type: llvm_type,
        string_index: string_index,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

pub fn return_struct_stmt(
    string_index: i64,
    fields: std::array::Array<MirStructField>
) -> MirStmt {
    return MirStmt::ReturnStruct(MirReturnStructStmt {
        string_index: string_index,
        struct_fields: fields
    });
}

pub fn return_expr_stmt(
    string_index: i64,
    result_id: i64,
    insts: std::array::Array<MirExprInst>
) -> MirStmt {
    return MirStmt::ReturnExpr(MirReturnExprStmt {
        string_index: string_index,
        expr_result_id: result_id,
        expr_insts: insts
    });
}

pub fn return_array_get_stmt(
    receiver_type: []u8,
    receiver_name: []u8,
    field_index: i64,
    element_type: []u8,
    index_result_id: i64,
    string_index: i64,
    insts: std::array::Array<MirExprInst>
) -> MirStmt {
    return MirStmt::ReturnArrayGet(MirReturnArrayGetStmt {
        receiver_type: receiver_type,
        receiver_name: receiver_name,
        field_index: field_index,
        element_type: element_type,
        index_result_id: index_result_id,
        string_index: string_index,
        expr_insts: insts
    });
}

pub fn return_error_stmt(
    string_index: i64,
    message_result_id: i64,
    insts: std::array::Array<MirExprInst>
) -> MirStmt {
    return MirStmt::ReturnError(MirReturnErrorStmt {
        string_index: string_index,
        message_result_id: message_result_id,
        expr_insts: insts
    });
}

pub fn while_stmt(
    loop_index: i64,
    induction_var: []u8,
    induction_init: i64,
    induction_step: i64,
    cond_result_id: i64,
    cond_insts: std::array::Array<MirExprInst>,
    body_stmts: std::array::Array<MirStmt>
) -> MirStmt {
    return MirStmt::While(MirWhileStmt {
        loop_index: loop_index,
        induction_var: induction_var,
        induction_init: induction_init,
        induction_step: induction_step,
        cond_result_id: cond_result_id,
        cond_insts: cond_insts,
        body_stmts: body_stmts
    });
}

pub fn if_stmt(
    if_index: i64,
    string_index: i64,
    cond_result_id: i64,
    cond_insts: std::array::Array<MirExprInst>,
    cond_short_circuit: i64,
    cond_rhs_result_id: i64,
    cond_rhs_insts: std::array::Array<MirExprInst>,
    then_kind: MirIfThenKind,
    bool_value: bool,
    call_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    call_args: std::array::Array<MirCallArg>,
    then_result_id: i64,
    then_insts: std::array::Array<MirExprInst>,
    then_struct_fields: std::array::Array<MirStructField>,
    then_struct_string_index: i64
) -> MirStmt {
    return MirStmt::If(MirIfStmt {
        if_index: if_index,
        string_index: string_index,
        llvm_type: call_type,
        cond_result_id: cond_result_id,
        cond_insts: cond_insts,
        cond_short_circuit: cond_short_circuit,
        cond_rhs_result_id: cond_rhs_result_id,
        cond_rhs_insts: cond_rhs_insts,
        if_then_kind: then_kind,
        bool_value: bool_value,
        then_call_module_prefix: module_prefix,
        then_call_callee_name: callee_name,
        then_call_args: call_args,
        then_expr_result_id: then_result_id,
        then_expr_insts: then_insts,
        then_struct_fields: then_struct_fields,
        then_struct_string_index: then_struct_string_index
    });
}

// The scalar block instructions render from the function return type and
// terminator value, so their union variants are payload-free and carry no
// result, callee symbol, or argument Array.
pub fn mir_string_const_instruction() -> MirInstruction {
    return MirInstruction::ConstString;
}

pub fn const_int_instruction() -> MirInstruction {
    return MirInstruction::ConstInt;
}

pub fn struct_literal_instruction() -> MirInstruction {
    return MirInstruction::StructLiteral;
}

pub fn expr_instruction() -> MirInstruction {
    return MirInstruction::Expr;
}

pub fn multi_statement_instruction() -> MirInstruction {
    return MirInstruction::MultiStatement;
}

pub fn call_instruction(
    result: MirValue,
    module_prefix: []u8,
    callee_name: []u8
) -> MirInstruction {
    return MirInstruction::Call(MirCallInst {
        result: result,
        module_prefix: module_prefix,
        callee_name: callee_name
    });
}

pub fn array_get_instruction(
    receiver_type: []u8,
    receiver_name: []u8,
    field_index: i64,
    index_name: []u8,
    element_type: []u8
) -> MirInstruction {
    return MirInstruction::ArrayGet(MirArrayGetInst {
        receiver_type: receiver_type,
        receiver_name: receiver_name,
        field_index: field_index,
        index_name: index_name,
        element_type: element_type
    });
}

pub fn arena_get_instruction(
    receiver_type: []u8,
    receiver_name: []u8,
    arena_field_index: i64,
    element_type: []u8,
    index_param_type: []u8,
    index_param_name: []u8,
    index_field_index: i64
) -> MirInstruction {
    return MirInstruction::ArenaGet(MirArenaGetInst {
        receiver_type: receiver_type,
        receiver_name: receiver_name,
        arena_field_index: arena_field_index,
        element_type: element_type,
        index_param_type: index_param_type,
        index_param_name: index_param_name,
        index_field_index: index_field_index
    });
}

pub fn match_union_instruction(
    receiver_type: []u8,
    receiver_name: []u8,
    index_type: []u8,
    index_name: []u8,
    data_field_index: i64,
    variant_tag: i64,
    payload_type: []u8,
    field0_index: i64,
    field0_type: []u8,
    field1_index: i64,
    default_value: i64
) -> MirInstruction {
    return MirInstruction::MatchUnion(MirMatchUnionInst {
        receiver_type: receiver_type,
        receiver_name: receiver_name,
        index_type: index_type,
        index_name: index_name,
        data_field_index: data_field_index,
        variant_tag: variant_tag,
        payload_type: payload_type,
        field0_index: field0_index,
        field0_type: field0_type,
        field1_index: field1_index,
        default_value: default_value
    });
}

pub fn return_value(value: MirValue) -> MirTerminator {
    return MirTerminator {
        kind: MirTerminatorKind::Return,
        value: value
    };
}
