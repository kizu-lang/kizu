pub fn if_stmt(
    if_index: i64,
    string_index: i64,
    cond_result_id: i64,
    cond_insts: std::array::Array<MirExprInst>,
    cond_short_circuit: i64,
    cond_rhs_result_id: i64,
    cond_rhs_insts: std::array::Array<MirExprInst>,
    cond_extra_operands: std::array::Array<MirCondOperand>,
    cond_targets: std::array::Array<MirCondTarget>,
    then_kind: MirIfThenKind,
    bool_value: bool,
    call_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    call_args: std::array::Array<MirCallArg>,
    then_result_id: i64,
    then_insts: std::array::Array<MirExprInst>,
    then_struct_fields: std::array::Array<MirStructField>,
    then_struct_string_index: i64,
    then_body_stmts: std::array::Array<MirStmt>,
    merge_vars: std::array::Array<MirIfMergeVar>
) -> MirStmt {
    return MirStmt::If(MirIfStmt {
        if_index: if_index,
        string_index: string_index,
        llvm_type: call_type,
        cond_result_id: cond_result_id,
        cond_insts: cond_insts,
        cond_short_circuit: cond_short_circuit,
        cond_rhs_result_id: cond_rhs_result_id,
        cond_rhs_insts: cond_rhs_insts,
        cond_extra_operands: cond_extra_operands,
        cond_targets: cond_targets,
        cond_try_call: false,
        cond_try_then_on_success: true,
        cond_called_error_union: "",
        cond_own_error_union: "",
        cond_call_module_prefix: "",
        cond_call_callee_name: "",
        cond_call_args: std::array::Array<MirCallArg>(std::mem::page_allocator()),
        if_then_kind: then_kind,
        bool_value: bool_value,
        then_call_module_prefix: module_prefix,
        then_call_callee_name: callee_name,
        then_call_args: call_args,
        then_expr_result_id: then_result_id,
        then_expr_insts: then_insts,
        then_struct_fields: then_struct_fields,
        then_struct_string_index: then_struct_string_index,
        then_body_stmts: then_body_stmts,
        else_body_stmts: std::array::Array<MirStmt>(std::mem::page_allocator()),
        merge_vars: merge_vars
    });
}

pub fn if_else_void_body_stmt(
    if_index: i64,
    string_index: i64,
    cond_result_id: i64,
    cond_insts: std::array::Array<MirExprInst>,
    then_body_stmts: std::array::Array<MirStmt>,
