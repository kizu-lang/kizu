        init_call_module_prefix: "",
        init_call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    });
}

// value_cursor_while_stmt_with_init backs a value-cursor loop whose cursor is seeded by a plain
// call ('var <cursor> = next_token(text, token)'). The init call is rendered into the loop
// preheader binding %<init_name> (= %<cursor>_init), and the loop-head phi seeds from that concrete
// value rather than self-referencing %<cursor> on the entry edge. Sharing the same MirStmt position
// as the elided init keeps every body label and the rendering local_prefix unchanged.
pub fn value_cursor_while_stmt_with_init(
    cursor_var: []u8,
    cursor_type: []u8,
    init_name: []u8,
    own_error_union: []u8,
    cond_insts: std::array::Array<MirExprInst>,
    cond_result_id: i64,
    body_stmts: std::array::Array<MirStmt>,
    latch: MirValueCursorLatch,
    label_base: []u8,
    terminal_return: bool,
    init_call_module_prefix: []u8,
    init_call_callee_name: []u8,
    init_call_args: std::array::Array<MirCallArg>
) -> MirStmt {
    return MirStmt::ValueCursorWhile(MirValueCursorWhileStmt {
        cursor_var: cursor_var,
        cursor_type: cursor_type,
        init_name: init_name,
        own_error_union: own_error_union,
        cond_insts: cond_insts,
        cond_result_id: cond_result_id,
        body_stmts: body_stmts,
        latch: latch,
        label_base: label_base,
        terminal_return: terminal_return,
        init_call_callee_name: init_call_callee_name,
        init_call_module_prefix: init_call_module_prefix,
        init_call_args: init_call_args
    });
}

