impl MirIfStmt {
    fn deinit(self: MirIfStmt) -> void {
        self.cond_insts.deinit();
        self.cond_rhs_insts.deinit();
        self.cond_extra_operands.deinit();
        self.then_call_args.deinit();
        self.then_expr_insts.deinit();
        self.then_struct_fields.deinit();
        return;
    }
}

// Active-variant cleanup for the owner-payload union: match self binds the live
// payload as an owned local and frees it through its own deinit, so inactive
// payload storage is never read or cleaned (issue 1010 cleanup contract). The
// ReturnError variant owns its message expr_insts Array like ReturnExpr.
impl MirWhileStmt {
    fn deinit(self: MirWhileStmt) -> void {
        self.cond_insts.deinit();
        self.cond_rhs_insts.deinit();
        self.cond_extra_operands.deinit();
        self.body_stmts.deinit();
        self.latch_stmts.deinit();
        self.secondary_inductions.deinit();
        self.init_insts.deinit();
        return;
    }
}

impl MirStmt {
    fn deinit(self: MirStmt) -> void {
        match self {
            LetCall(payload) => payload.deinit(),
            LetStruct(payload) => payload.deinit(),
            LetArenaAdd(payload) => payload.deinit(),
            LetExpr(payload) => payload.deinit(),
            LetTryCall(payload) => payload.deinit(),
            ReturnTryBinary(payload) => payload.deinit(),
            StringTryAppend(payload) => payload.deinit(),
            CountRange(payload) => payload.deinit(),
            TrimAscii(payload) => payload.deinit(),
            AdvancePosition(payload) => payload.deinit(),
            NumberToken(payload) => payload.deinit(),
            StringToken(payload) => payload.deinit(),
            SkipLineComment(payload) => payload.deinit(),
            IsDocCommentStart(payload) => payload.deinit(),
            WordToken(payload) => payload.deinit(),
            RawToken(payload) => payload.deinit(),
            TokenAt(payload) => payload.deinit(),
            FirstToken(payload) => payload.deinit(),
            NextToken(payload) => payload.deinit(),
            ArrayNew(payload) => payload.deinit(),
            ValueWhile(payload) => payload.deinit(),
            TokenKindPredicate(payload) => payload.deinit(),
            ParserSpanPredicate(payload) => payload.deinit(),
            ParserPostfixStart(payload) => payload.deinit(),
            AstNodeText(payload) => payload.deinit(),
            StringLiteralSpan(payload) => payload.deinit(),
            PrintPayload(payload) => payload.deinit(),
            LowerPrintCall(payload) => payload.deinit(),
            LowerPrintStatement(payload) => payload.deinit(),
            LowerRunParseResult(payload) => payload.deinit(),
            LowerRunAstBlock(payload) => payload.deinit(),
            LowerRunAstFunction(payload) => payload.deinit(),
            LowerRunAstDeclarations(payload) => payload.deinit(),
            LowerRunAst(payload) => payload.deinit(),
            ReturnCall(payload) => payload.deinit(),
            ReturnStruct(payload) => payload.deinit(),
            ReturnExpr(payload) => payload.deinit(),
            ReturnError(payload) => payload.deinit(),
            ReturnArrayGet(payload) => payload.deinit(),
            LetArrayGet(payload) => payload.deinit(),
            If(payload) => payload.deinit(),
            While(payload) => payload.deinit(),
            MatchTraversal(payload) => payload.deinit(),
        }
    }
}

// MirFunction is a product record holding the lowered owner Arrays; its deinit
// frees each one. MirBlock (entry) and its MirInstruction own nothing (the call
// arguments live on call_args above), so entry needs no cleanup and MirBlock and
// MirInstruction carry no deinit (issue 1007/1012).
impl MirFunction {
    fn deinit(self: MirFunction) -> void {
        self.call_args.deinit();
        self.struct_fields.deinit();
        self.expr_insts.deinit();
        self.multi_stmts.deinit();
        return;
    }
}

pub fn slice_u8_type() -> MirType {
    return MirType {
        kind: MirTypeKind::SliceU8,
        llvm_name: "%kizu.slice.u8"
    };
}

pub fn i64_type() -> MirType {
    return MirType {
        kind: MirTypeKind::I64,
        llvm_name: "i64"
    };
}

pub fn llvm_type(name: []u8) -> MirType {
    return MirType {
        kind: MirTypeKind::Llvm,
        llvm_name: name
    };
}

pub fn mir_string_const_value(id: i64, payload: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: slice_u8_type(),
        kind: MirValKind::ConstString,
        payload: payload,
        int_value: 0
    };
}

pub fn const_int_value(id: i64, value: i64) -> MirValue {
    return MirValue {
        id: id,
        ty: i64_type(),
        kind: MirValKind::ConstInt,
        payload: "",
        int_value: value
    };
}

pub fn call_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
        kind: MirValKind::CallResult,
        payload: name,
        int_value: 0
    };
}

pub fn struct_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
        kind: MirValKind::StructResult,
        payload: name,
        int_value: 0
    };
}

pub fn expr_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
        kind: MirValKind::ExprResult,
        payload: name,
        int_value: 0
    };
}

pub fn multi_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
        kind: MirValKind::MultiResult,
        payload: name,
        int_value: 0
    };
}

pub fn var_call_arg(ty: []u8, name: []u8) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Var,
        value: name,
        bool_value: false,
        string_index: -1,
        int_value: 0,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn string_call_arg(ty: []u8, payload: []u8, string_index: i64) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::String,
        value: payload,
        bool_value: false,
        string_index: string_index,
        int_value: 0,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn bool_call_arg(ty: []u8, value: bool) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Bool,
        value: "",
        bool_value: value,
        string_index: -1,
        int_value: 0,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn field_access_call_arg(
    ty: []u8,
    source_type: []u8,
    source_name: []u8,
    source_field_index: i64
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::FieldAccess,
        value: source_name,
        bool_value: false,
        string_index: -1,
        int_value: 0,
        source_type: source_type,
        source_field_index: source_field_index,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

// nested_field_access_call_arg lowers a two-level field access (receiver.a.b)
// passed as a call argument. source_type/source_field_index read the first
// field off the Var receiver and nested_source_type/nested_field_index read the
// leaf field off that intermediate value, matching nested_field_access_struct_field
// (tracker 961).
pub fn nested_field_access_call_arg(
    ty: []u8,
    source_type: []u8,
    source_name: []u8,
    source_field_index: i64,
    nested_type: []u8,
    nested_field_index: i64
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::FieldAccess,
        value: source_name,
        bool_value: false,
        string_index: -1,
        int_value: 0,
        source_type: source_type,
        source_field_index: source_field_index,
        nested_source_type: nested_type,
        nested_field_index: nested_field_index,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn empty_slice_call_arg(ty: []u8) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::EmptySlice,
        value: "",
        bool_value: false,
        string_index: -1,
        int_value: 0,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn slice_call_arg(
    ty: []u8,
    target: []u8,
    start_base: []u8,
    start_offset: i64,
    end_base: []u8,
    end_offset: i64
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Slice,
        value: target,
        bool_value: false,
        string_index: -1,
        int_value: 0,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: start_base,
        slice_start_offset: start_offset,
        slice_end_base: end_base,
        slice_end_offset: end_offset
    };
}

// int_literal_call_arg passes an integer literal directly as a call operand
// (e.g. the '1' in position(line, 1)); the renderer emits no setup and writes the
// literal inline in the argument list (tracker 961, scope 4 prerequisite).
pub fn int_literal_call_arg(ty: []u8, value: i64) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::IntLiteral,
        value: "",
        bool_value: false,
        string_index: -1,
        int_value: value,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

// temp_call_arg passes an already-computed expression temp (%t<temp_id>) directly as
// a call operand (issue 1165). It backs nested-call arguments such as the
// token_text(source, next) inside equal_bytes(token_text(...), expected): the inner
// call is lowered into a preceding call expr-inst whose %t<temp_id> result this arg
// references, so the renderer emits no setup and writes %t<temp_id> inline. temp_id
// is stored in int_value.
pub fn temp_call_arg(ty: []u8, temp_id: i64) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Temp,
        value: "",
        bool_value: false,
        string_index: -1,
        int_value: temp_id,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

// arith_field_call_arg passes 'receiver.<field> +/- value' as a call operand: the
// renderer extracts source_field_index off the Var receiver (source_type %name)
// then adds (or subtracts when subtract is true) the literal into an %argN_arith
// temp. Backs position(initial.line + 1, ...) (tracker 961, scope 4 prerequisite).
pub fn arith_field_call_arg(
    ty: []u8,
    source_type: []u8,
    source_name: []u8,
    source_field_index: i64,
    value: i64,
    subtract: bool
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Arith,
        value: source_name,
        bool_value: subtract,
        string_index: -1,
        int_value: value,
        source_type: source_type,
        source_field_index: source_field_index,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

// arith_var_call_arg passes '<var> +/- value' as a call operand: the renderer adds
// (or subtracts) the literal off the Var %name directly into an %argN_arith temp.
// source_field_index stays -1 to mark the var (no extractvalue) base (tracker 961).
pub fn arith_var_call_arg(
    ty: []u8,
    var_name: []u8,
    value: i64,
    subtract: bool
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Arith,
        value: var_name,
        bool_value: subtract,
        string_index: -1,
        int_value: value,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

// empty_struct_call_args backs the call_args field of non-call struct fields. It
// allocates an empty Array so every MirStructField has a valid (if unused) args
// array; only Call fields populate it (tracker 961).
fn empty_struct_call_args() -> std::array::Array<MirCallArg> {
    return std::array::Array<MirCallArg>(std::mem::page_allocator());
}

// empty_struct_nested_fields backs the nested_fields field of non-StructLiteral
// struct fields; only StructLiteral fields populate it (tracker 961).
fn empty_struct_nested_fields() -> std::array::Array<MirStructField> {
    return std::array::Array<MirStructField>(std::mem::page_allocator());
}

pub fn var_struct_field(index: i64, ty: []u8, name: []u8) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::Var,
        llvm_type: ty,
        value: name,
        int_value: 0,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

