pub fn let_call_stmt(
    name: []u8,
    llvm_type: []u8,
    string_index: i64,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirStmt {
    return MirStmt::LetCall(MirLetCallStmt {
        name: name,
        llvm_type: llvm_type,
        string_index: string_index,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

pub fn let_struct_stmt(
    name: []u8,
    llvm_type: []u8,
    string_index: i64,
    fields: std::array::Array<MirStructField>
) -> MirStmt {
    return MirStmt::LetStruct(MirLetStructStmt {
        name: name,
        llvm_type: llvm_type,
        string_index: string_index,
        struct_fields: fields
    });
}

pub fn return_call_stmt(
    llvm_type: []u8,
    string_index: i64,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirStmt {
    return MirStmt::ReturnCall(MirReturnCallStmt {
        name: "ret_val",
        llvm_type: llvm_type,
        string_index: string_index,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

pub fn return_struct_stmt(
    string_index: i64,
    fields: std::array::Array<MirStructField>
) -> MirStmt {
    return MirStmt::ReturnStruct(MirReturnStructStmt {
        string_index: string_index,
        struct_fields: fields
    });
}

pub fn return_expr_stmt(
    string_index: i64,
    result_id: i64,
    insts: std::array::Array<MirExprInst>
) -> MirStmt {
    return MirStmt::ReturnExpr(MirReturnExprStmt {
        string_index: string_index,
        expr_result_id: result_id,
        expr_insts: insts
    });
}

pub fn return_error_stmt() -> MirStmt {
    return MirStmt::ReturnError;
}

pub fn if_stmt(
    if_index: i64,
    string_index: i64,
    cond_result_id: i64,
    cond_insts: std::array::Array<MirExprInst>,
    then_kind: MirIfThenKind,
    bool_value: bool,
    call_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    call_args: std::array::Array<MirCallArg>,
    then_result_id: i64,
    then_insts: std::array::Array<MirExprInst>
) -> MirStmt {
    return MirStmt::If(MirIfStmt {
        if_index: if_index,
        string_index: string_index,
        llvm_type: call_type,
        cond_result_id: cond_result_id,
        cond_insts: cond_insts,
        if_then_kind: then_kind,
        bool_value: bool_value,
        then_call_module_prefix: module_prefix,
        then_call_callee_name: callee_name,
        then_call_args: call_args,
        then_expr_result_id: then_result_id,
        then_expr_insts: then_insts
    });
}

pub fn mir_string_const_instruction(result: MirValue) -> MirInstruction {
    return MirInstruction {
        kind: MirInstKind::ConstString,
        result: result,
        module_prefix: "",
        callee_name: "",
        args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

pub fn const_int_instruction(result: MirValue) -> MirInstruction {
    return MirInstruction {
        kind: MirInstKind::ConstInt,
        result: result,
        module_prefix: "",
        callee_name: "",
        args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

pub fn struct_literal_instruction(result: MirValue) -> MirInstruction {
    return MirInstruction {
        kind: MirInstKind::StructLiteral,
        result: result,
        module_prefix: "",
        callee_name: "",
        args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

pub fn expr_instruction(result: MirValue) -> MirInstruction {
    return MirInstruction {
        kind: MirInstKind::Expr,
        result: result,
        module_prefix: "",
        callee_name: "",
        args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

pub fn multi_statement_instruction(result: MirValue) -> MirInstruction {
    return MirInstruction {
        kind: MirInstKind::MultiStatement,
        result: result,
        module_prefix: "",
        callee_name: "",
        args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

pub fn call_instruction(
    result: MirValue,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirInstruction {
    return MirInstruction {
        kind: MirInstKind::Call,
        result: result,
        module_prefix: module_prefix,
        callee_name: callee_name,
        args: args
    };
}

pub fn return_value(value: MirValue) -> MirTerminator {
    return MirTerminator {
        kind: MirTerminatorKind::Return,
        value: value
    };
}
