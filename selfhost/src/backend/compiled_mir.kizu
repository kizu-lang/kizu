import selfhost::ir::builtin_contract;

pub struct MirNameStore {
    names: std::array::Array<std::string::String>,
    views: std::map::Map<[]u8, []u8>,
}

pub fn mir_name_store() -> MirNameStore {
    return MirNameStore {
        names: std::array::Array<std::string::String>(
            std::mem::page_allocator()
        ),
        views: std::map::Map<[]u8, []u8>(std::mem::page_allocator())
    };
}

impl MirNameStore {
    fn deinit(self: MirNameStore) -> void {
        self.views.deinit();
        while self.names.len() > 0 {
            let name = self.names.pop_or_panic();
            name.deinit();
        }
        self.names.deinit();
        return;
    }

    fn own(
        self: &var MirNameStore,
        name: std::string::String
    ) -> ![]u8 {
        try self.names.append(name);
        let names = &self.names;
        let stored_name = try names.at(names.len() - 1);
        let generated = stored_name.as_bytes();
        try self.views.insert(generated, generated);
        return try self.views.get(generated);
    }
}

pub enum MirTypeKind {
    SliceU8,
    I64,
    Llvm,
}

pub struct MirType {
    pub kind: MirTypeKind,
    pub llvm_name: []u8,
}

pub enum MirValKind {
    ConstString,
    ConstInt,
    CallResult,
    StructResult,
    ExprResult,
    MultiResult,
}

pub struct MirValue {
    pub id: i64,
    pub ty: MirType,
    pub kind: MirValKind,
    pub payload: []u8,
    pub int_value: i64,
}

pub enum MirCallArgKind {
    Var,
    String,
    Bool,
    FieldAccess,
    EmptySlice,
    Slice,
    IntLiteral,
    Arith,
    Temp,
    Call,
    TypeSize,
}

pub enum MirStorageCodec {
    None,
    IdentityI64,
    BoolI64,
    UnsignedNarrowI64,
    SignedNarrowI64,
    ByteView,
}

// The codec names the semantic/storage pair, not only the encode operation.
// Encoding uses zext/sext; a future read path can use the same value to decode
// BoolI64 with icmp-ne and both narrow integer codecs with trunc.

// A FieldAccess call arg mirrors MirStructField's nested layout: source_type /
// source_field_index extract the first field off the Var receiver, and when
// nested_field_index >= 0 a second extractvalue reads nested_field_index off
// nested_source_type (the intermediate field type). nested_field_index == -1
// marks a single-level access (receiver.field) so the renderer skips the second
// extractvalue (tracker 961, mirrors nested_field_access_struct_field).
//
// An IntLiteral arg renders its int_value inline as the argument operand (no
// setup), and an Arith arg renders '<base> +/- int_value' into an %argN_arith
// temp before the call: when source_field_index >= 0 the base is the
// source_field_index field extracted off the Var receiver (source_type %value),
// otherwise the base is the Var %value directly; bool_value true selects sub
// over add. These back the lexer's position(initial.line + 1, 1) style calls
// (tracker 961, scope 4 prerequisite).
//
// For a Slice arg a bound is normally the static slice_*_base register plus a
// constant slice_*_offset. When a bound is a single-level field read off a Var
// receiver (e.g. text[current.start..current.end]) slice_*_base holds the
// receiver register and slice_*_field_index >= 0 names the field; the renderer
// then extractvalue's that field off slice_*_source_type %base before adding the
// offset. slice_*_field_index == -1 keeps the plain register/literal bound.
pub struct MirCallArg {
    pub ty: []u8,
    pub semantic_type: []u8,
    pub storage_codec: MirStorageCodec,
    pub kind: MirCallArgKind,
    pub value: []u8,
    pub bool_value: bool,
    pub string_index: i64,
    pub int_value: i64,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub nested_source_type: []u8,
    pub nested_field_index: i64,
    pub slice_start_base: []u8,
    pub slice_start_offset: i64,
    pub slice_start_source_type: []u8,
    pub slice_start_field_index: i64,
    pub slice_end_base: []u8,
    pub slice_end_offset: i64,
    pub slice_end_source_type: []u8,
    pub slice_end_field_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub enum MirStructFieldKind {
    Var,
    ConstString,
    ConstInt,
    ConstBool,
    ConstEnumTag,
    FieldAccess,
    ComputedBinary,
    EmptySlice,
    Call,
    StructLiteral,
}

// A Call struct field carries a resolved direct call (callee + module prefix +
// lowered args) whose result becomes the field value. The renderer emits the
// call arg setup and call instruction before insertvalue-ing the result into the
// struct, mirroring the let/return call lowering. A StructLiteral field carries a
// nested struct literal's fields (nested_fields) and its struct type (llvm_type);
// the renderer builds the nested struct in its own insertvalue chain and feeds
// the result in. Non-nested fields keep call_callee_name empty and empty
// call_args / nested_fields arrays (tracker 961).
pub struct MirStructField {
    pub index: i64,
    pub kind: MirStructFieldKind,
    pub llvm_type: []u8,
    pub value: []u8,
    pub int_value: i64,
    pub bool_value: bool,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub nested_source_type: []u8,
    pub computed_rhs_name: []u8,
    pub computed_op: []u8,
    pub computed_lhs_literal: i64,
    pub computed_lhs_is_literal: bool,
    pub computed_rhs_literal: i64,
    pub computed_rhs_is_literal: bool,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
    pub nested_fields: std::array::Array<MirStructField>,
    // access_path holds the FieldAccess extraction chain rooted at `value`, one step per '.'
    // ('executable_function.body.statement.expr.argument.payload' is five steps). Step 0
    // extracts from the root SSA value and each later step extracts from the previous result,
    // so a chain of any depth is representable. It is empty for every other field kind.
    pub access_path: std::array::Array<MirFieldStep>,
}

// MirFieldStep is one '.field' hop of a struct-literal FieldAccess chain: source_type is the
// aggregate being read and field_index is the element extracted from it.
pub struct MirFieldStep {
    pub source_type: []u8,
    pub field_index: i64,
}

pub fn field_step(source_type: []u8, field_index: i64) -> MirFieldStep {
    return MirFieldStep {
        source_type: source_type,
        field_index: field_index
    };
}

fn empty_field_steps() -> std::array::Array<MirFieldStep> {
    return std::array::Array<MirFieldStep>(std::mem::page_allocator());
}

pub fn copy_field_steps(
    steps: &std::array::Array<MirFieldStep>
) -> !std::array::Array<MirFieldStep> {
    var copied = std::array::Array<MirFieldStep>(std::mem::page_allocator());
    var index = 0;
    while index < steps.len() {
        let step = try steps.at(index);
        try copied.append(field_step(step.source_type, step.field_index));
        index = index + 1;
    }
    return copied;
}

// Per-variant MirExprInst payloads. Each holds only the fields its variant
// reads in the renderer; only the Call payload owns an inline Array, so the
// union below never carries inactive owned arrays for the scalar variants
// (issue 1007/1012, ADR-0075 tagged-union payload ABI). Every payload keeps
// id and llvm_type because expr_inst_id / expr_inst_llvm_type resolve them
// for any variant when wiring instruction results together.
pub struct MirVarExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
}

pub struct MirConstStringExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
    pub string_index: i64,
}

pub struct MirConstBoolExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub bool_value: bool,
}

pub struct MirConstIntExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub int_value: i64,
}

pub struct MirConstEnumTagExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub int_value: i64,
}

// MirUnionConstructExpr materializes a tagged-union variant value. The union LLVM type
// named by llvm_type is the byte-buffer aggregate { i64 tag, [N x i8] } (the payload slot
// holds the widest variant), so the value is emitted as an SSA temp.
//   - payload-less variant (payload_value < 0, e.g. AstData::Empty): a single
//     'insertvalue <llvm_type> zeroinitializer, i64 <tag>, 0' (issue 1157 PR-P1).
//   - single-payload variant (payload_value >= 0, e.g. AstData::Program(node)): a
//     stack slot is zero-initialized, the discriminant is stored into field 0 and the
//     payload SSA value (LLVM type payload_type) into the field-1 buffer, then the whole
//     union is loaded back (issue 1157 PR-P2). This store-into-buffer mirror of the read
//     side (append_match_union_block: gep field 1 + load payload_type) keeps the layout
//     consistent, since the payload type is narrower than the [N x i8] field.
pub struct MirUnionConstructExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub tag: i64,
    pub payload_value: i64,
    pub payload_type: []u8,
}

// MirStructLiteralExpr materializes a struct literal value as an expression temp.
// It owns the same field descriptors used by LetStruct / ReturnStruct, so expression
// payloads and statement-level struct literals share field-value and nested-struct
// lowering (issue 1157 C2).
pub struct MirStructLiteralExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirPrefixNotExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub operand: i64,
}

pub struct MirBinaryExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub op: []u8,
    pub left: i64,
    pub right: i64,
}

pub struct MirFieldAccessExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
    pub left: i64,
    pub source_type: []u8,
    pub source_field_index: i64,
}

// Single-byte slice index load (path[i] in expression context). The renderer
// extracts the slice data pointer from target, GEPs by the i64 index result,
// and loads one i8. The instruction owns nothing, so it is copy-only.
pub struct MirIndexLoadExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub target: []u8,
    pub index: i64,
}

// Byte slice expression (bytes[start..end]). target/start/end reference earlier
// expression temps; the renderer performs the same bounds checks as slice call
// arguments before constructing the returned %kizu.slice.u8 view.
pub struct MirSliceExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub target: i64,
    pub start: i64,
    pub end: i64,
}

pub struct MirCallExpr {
    pub id: i64,
    // llvm_type is the semantic expression result. storage_llvm_type is the
    // physical callee result decoded according to result_transport.
    pub llvm_type: []u8,
    pub storage_llvm_type: []u8,
    pub success_llvm_type: []u8,
    pub result_transport: builtin_contract::RuntimeResultTransport,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirArrayLenExpr backs a local/param 'tokens.len()' read in expression context
// (issue 1165): the receiver is a std::array::Array<T> (or &Array<T>) param/local,
// which lowers to the runtime-owned %kizu.owned handle, so the renderer reads the
// handle straight off the named value (no struct extractvalue) and calls
// @kizu_rt_array_len(%kizu.owned) -> i64. It generalizes the struct-field Array.len
// accessor to direct value receivers; the element type T does not affect the call,
// so it carries only the receiver name. It owns nothing, so it is copy-only.
pub struct MirArrayLenExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub receiver_name: []u8,
}

// MirStringLenExpr backs a local/param std::string::String.len() read in expression context.
// The String value lowers to the same runtime-owned %kizu.owned handle as Array<T>, but it calls
// the string runtime length helper instead of the array length helper.
pub struct MirStringLenExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub receiver_name: []u8,
}

// MirIntCastExpr backs 'cast<iN>(<i64 expr>)' over a non-literal integer operand
// (a literal cast folds to a typed ConstInt). operand references the earlier
// expression temp holding the source integer; the renderer narrows it with trunc,
// widens it with sext, or copies it when the widths already match, producing a
// value of llvm_type. It owns nothing, so it is copy-only.
pub struct MirIntCastExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub operand: i64,
    pub source_llvm: []u8,
}

// MirTryUnwrapExpr backs a 'try <expr>' in value/sub-expression position (issue 1157
// big-bang). operand references the earlier expr temp holding the inner error-union
// aggregate (called_error_union); the renderer extracts its ok flag (field 0) and
// branches on an id-suffixed label pair: t<id>_try_fail re-wraps the callee message
// (field msg-index) into this function's own_error_union failure value and returns it
// (propagation, never 'unreachable'); t<id>_try_cont extracts the success value
// (field 1, llvm_type) into %t<id>. This mirrors MirLetTryCallStmt's propagation for
// the statement-free expression path, which owns no stmts. It owns nothing, so it is
// copy-only.
pub struct MirTryUnwrapExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub operand: i64,
    pub called_error_union: []u8,
    pub own_error_union: []u8,
}

pub union MirExprInst {
    Var(MirVarExpr),
    ConstString(MirConstStringExpr),
    ConstBool(MirConstBoolExpr),
    ConstInt(MirConstIntExpr),
    ConstEnumTag(MirConstEnumTagExpr),
    PrefixNot(MirPrefixNotExpr),
    Binary(MirBinaryExpr),
    FieldAccess(MirFieldAccessExpr),
    IndexLoad(MirIndexLoadExpr),
    Slice(MirSliceExpr),
    Call(MirCallExpr),
    ArrayLen(MirArrayLenExpr),
    StringLen(MirStringLenExpr),
    IntCast(MirIntCastExpr),
    UnionConstruct(MirUnionConstructExpr),
    StructLiteral(MirStructLiteralExpr),
    TryUnwrap(MirTryUnwrapExpr),
}

pub enum MirIfThenKind {
    ReturnBool,
    ReturnCall,
    ReturnExpr,
    ReturnStruct,
    ReturnError,
    // VoidReturnSuccess backs a bare 'return;' then-block inside an error-union void
    // function: the renderer returns the wrapped %kizu.error.void success (or a plain
    // 'ret void' when the function returns void directly).
    VoidReturnSuccess,
    // VoidBody backs a no-else side-effecting then-block. The then body is rendered as a
    // conditional branch to a fall-through join, and mutated locals are merged through the
    // MirIfStmt.merge_vars store/load metadata rather than redefining the original SSA names.
    VoidBody,
    // ContinueLatch backs an 'if <cond> { <induction> = <induction> + <step>; continue; }'
    // body statement of a continue-latch while loop (line_comment_has_blank_after, issue 1165
    // / 1162). The then-block carries no return value: it branches straight back to the loop
    // latch ('br label %loop<N>_latch') so the increment is folded into the shared
    // constant-step latch add, and the if-continuation block falls through to the loop's
    // non-continue tail (the trailing 'return'). The increment local is validated but never
    // rendered here.
    ContinueLatch,
}

// Per-variant MirStmt payloads. Each holds only the fields its variant needs and
// owns its inline Array storage, so the union below never carries inactive owned
// arrays (issue 1007/1011, ADR-0075 tagged-union payload ABI).
pub struct MirLetCallStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirLetStructStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

// MirLetArenaAddStmt backs a 'let <name> = self.<field>.add(<struct literal>);'
// (Arena<T>.add(T) -> opaque handle, tracker 961). It constructs the element struct
// (T) from struct_fields, marshals it through stack storage as a %kizu.slice.u8
// (ptr + sizeof(T)), reads the Arena<T> handle off the struct value receiver, calls
// @kizu_rt_arena_add, and binds <name> to the pointer-plus-index handle. Ast.add_node is
// its first consumer: it constructs an AstNode (Span + AstData union) and appends it
// to the nodes Arena, exercising the AstNode/AstData union value-type ABI.
pub struct MirLetArenaAddStmt {
    pub name: []u8,
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub arena_field_index: i64,
    pub element_type: []u8,
    pub last_field_index: i64,
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirReturnCallStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirReturnStructStmt {
    pub string_index: i64,
    // When the function returns an error union over the struct, wrap_error_union
    // carries the union LLVM type and success_llvm the struct's own LLVM type: the
    // renderer builds the struct value first, then wraps it as the union success.
    // Both stay empty when the function returns the struct directly.
    pub wrap_error_union: []u8,
    pub success_llvm: []u8,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirReturnExprStmt {
    pub string_index: i64,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirReturnErrorStmt backs a return error("literal") statement. It mirrors
// MirReturnExprStmt: the error message literal is lowered as a single ConstString
// in expr_insts (so the existing string-global emission applies) and
// message_result_id names the temp holding the message %kizu.slice.u8. The
// renderer builds the error-union failure value (i1 false, success zeroinitializer,
// the message slice at the failure index) and returns it (tracker 961).
pub struct MirReturnErrorStmt {
    pub string_index: i64,
    pub message_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

pub struct MirLetExprStmt {
    pub name: []u8,
    pub string_index: i64,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirAliasAssignStmt binds a lowered expression to a fresh backend alias name. It is used for
// mutable local values that cannot reuse the source local's SSA name: skipped induction seeds and
// assignment statements inside a no-else void then-block. The source_name records the Kizu local
// being carried; output_name is the unique SSA alias that later Var reads may be rewritten to.
pub struct MirAliasAssignStmt {
    pub source_name: []u8,
    pub output_name: []u8,
    pub llvm_type: []u8,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirScalarSelectAssignStmt backs a side-effect-free conditional scalar update inside a loop:
// 'if <cond> { depth = depth +/- <int>; }'. The condition and value expressions are both lowered
// in the current block, and the renderer emits
// '%<output_name> = select i1 <cond>, <value>, %<input_name>'. The owning while carries the source
// variable through a loop-head phi and uses output_name as the latch incoming value (issue 1162).
pub struct MirScalarSelectAssignStmt {
    pub source_name: []u8,
    pub input_name: []u8,
    pub output_name: []u8,
    pub llvm_type: []u8,
    pub cond_result_id: i64,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub value_result_id: i64,
    pub value_insts: std::array::Array<MirExprInst>,
}

// MirLetTryCallStmt backs a 'let <name> = try <callee>(<args>);' statement: a try-call
// over a free function whose return type is an error union (the node_count traversal
// cluster, tracker 961). The renderer emits the call into called_error_union, extracts the
// ok flag (field 0), and branches on a try_index-suffixed label pair: the fail block
// re-wraps the callee's message (field 2) into this function's own_error_union failure
// value and returns it (propagation, never 'unreachable'); the ok block extracts the
// success value (field 1, success_type) and binds it to <name>. called_error_union and
// own_error_union may differ (e.g. a !NodeId child_at call inside a !i64 counter), so the
// fail path always rebuilds the message rather than forwarding the callee union whole. It
// owns the call-argument Array and any pre-call argument expression instructions.
pub struct MirLetTryCallStmt {
    pub name: []u8,
    pub called_error_union: []u8,
    pub success_type: []u8,
    pub result_transport: builtin_contract::RuntimeResultTransport,
    pub own_error_union: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub arg_insts: std::array::Array<MirExprInst>,
    pub call_args: std::array::Array<MirCallArg>,
}

pub union MirValueCursorLatch {
    TryCall(MirLetTryCallStmt),
    FieldRead(MirLetExprStmt),
    // PlainCall backs a '<cursor> = <free-call>(.. <body-local> ..);' latch -- a non-try call that
    // reassigns the carried cursor (parse_import_segments: 'token = next_token(text, segment)').
    // It returns no error union, so like FieldRead it stays in the latch block (no fail/cont split)
    // and binds %<cursor>_next via append_while_latch_call_body, the scalar plain-call latch renderer.
    PlainCall(MirLetCallStmt),
}

// MirReturnArrayGetStmt backs a multi-statement 'return self.<field>.get(<expr>);'
// (Array<T>.get -> !T, tracker 961). It composes the ArrayGet body with an arbitrary
// index expression: expr_insts/index_result_id lower the index (e.g. range.start +
// index) into %t<index_result_id>, and the receiver fields name the Array<T> handle.
// The renderer emits the index, then the checked @kizu_rt_array_at call + ok-branch +
// by-value load + error-union wrap, sharing the body with the single-statement
// accessor. Ast.child_at is its first consumer.
pub struct MirReturnArrayGetStmt {
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub field_index: i64,
    pub element_type: []u8,
    pub index_result_id: i64,
    pub string_index: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirLetArrayGetStmt backs a multi-statement 'let <name> = try <receiver>.get(<expr>);'
// where the receiver is a std::array::Array<T> (or &Array<T>) param/local (issue 1165).
// The receiver lowers to the runtime-owned %kizu.owned handle, so the renderer reads
// it straight off the named value (no struct extractvalue), lowers the index
// expression into %t<index_result_id>, calls the checked @kizu_rt_array_at runtime
// helper, and branches on the ok flag on a try_index-suffixed label pair: the fail
// block re-wraps the runtime message into this function's own_error_union failure
// value and returns it (propagation, never 'unreachable'); the cont block loads the
// element value out of the borrowed view and binds it to %<name>, which the following
// statements continue in. It generalizes the struct-field Array.get accessor to direct
// value receivers in let-binding position. It owns the index expr_insts Array.
pub struct MirLetArrayGetStmt {
    pub name: []u8,
    pub receiver_name: []u8,
    pub element_type: []u8,
    pub own_error_union: []u8,
    pub index_result_id: i64,
    pub string_index: i64,
    pub try_index: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirCondOperand backs one operand of an 'and' short-circuit chain beyond the first
// two (cond_insts and cond_rhs_insts). result_id names the operand's i1 result and
// insts holds the operand's expression lowered into its own guarded block, so a
// trapping/loading operand (e.g. a byte index) never runs unless every earlier operand
// was true (issue 1165 / 1162). It references MirExprInst through a heap-backed Array
// like the lhs/rhs operands, so the union stays fixed-size.
pub struct MirCondOperand {
    pub result_id: i64,
    pub insts: std::array::Array<MirExprInst>,
}

// MirCondTarget names the two destinations a short-circuit chain leaf branches to. A leaf is one
// operand of the condition's and/or tree, and the leaves are lowered in left-to-right evaluation
// order, so an arbitrarily nested tree ('a or b or (c and d)') is representable as a flat leaf
// list: nesting only changes where each leaf's edges go, never the evaluation order. The two
// targets are renderer-agnostic so the same list drives an if (true -> ifN_then, false ->
// ifN_cont) and a while head (true -> loopN_body, false -> loopN_exit):
//   -1 = the condition-true destination
//   -2 = the condition-false destination
//   k >= 0 = leaf k's own block (always k > the branching leaf's index)
// A flat 'and' chain therefore yields (next, -2) per leaf and (-1, -2) for the last, and a flat
// 'or' chain yields (-1, next) and (-1, -2), reproducing the pre-nesting edge layout exactly.
pub struct MirCondTarget {
    pub true_target: i64,
    pub false_target: i64,
}

// MirIfMergeVar describes one mutable local crossing a no-else void if join. input_name is the
// incoming SSA alias before the if, then_name is the alias after the then body, and output_name is
// the alias loaded in the fall-through continuation.
pub struct MirIfMergeVar {
    pub source_name: []u8,
    pub input_name: []u8,
    pub then_name: []u8,
    pub else_name: []u8,
    pub output_name: []u8,
    pub llvm_type: []u8,
}

// cond_short_circuit selects how the condition drives the branch:
//   0 = single condition (cond_insts / cond_result_id only)
//   1 = a short-circuit leaf chain; cond_targets names each leaf's two branch destinations, so
//       an arbitrarily nested and/or tree needs no separate and/or discriminator here
// cond_try_call selects a hoisted 'try <free !bool call>' condition that propagates the
// call failure as this function's own error union and branches on the unwrapped success bool.
// cond_try_then_on_success records the condition polarity: positive try-call conditions branch to
// the then body on success true, while prefix-not try-call conditions branch there on success false.
// It is currently exercised only with a no-else void then-body, so the regular cond_insts fields
// stay empty and the body/merge fields below are reused.
// When short-circuit is active cond_insts/cond_result_id hold the lhs (the first
// operand) and cond_rhs_insts/cond_rhs_result_id hold the second operand, lowered in
// the guarded block so a trapping/loading operand (e.g. a byte index) never runs unless
// reached. Any further leaves live in cond_extra_operands, each in its own guarded block, so a
// chained 'a and b and c' short-circuit (after_line_break's 'source[index] == 13 and index + 1 <
// length and source[index + 1] == 10') evaluates the guarded byte loads only when their guards
// hold, and a chained 'a or b or c' short-circuit (should_insert_space's 'last == 0 or last == 10
// or last == 32') stops at the first true operand (issue 1165 / 1162). cond_extra_operands is
// empty for a single condition and a two-leaf condition, so those keep their existing block
// layout. Because cond_targets carries each leaf's edges, a mixed tree such as
// function_call_error_for_ast_call's 'a or b or (try c) or (d and e) or (f and g)' uses the same
// flat leaf list -- only the edges differ.
pub struct MirIfStmt {
    pub if_index: i64,
    pub string_index: i64,
    pub llvm_type: []u8,
    pub cond_result_id: i64,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_short_circuit: i64,
    pub cond_rhs_result_id: i64,
    pub cond_rhs_insts: std::array::Array<MirExprInst>,
    pub cond_extra_operands: std::array::Array<MirCondOperand>,
    // cond_targets holds one MirCondTarget per chain leaf in evaluation order -- leaf 0 is
    // cond_insts, leaf 1 is cond_rhs_insts, and leaf j >= 2 is cond_extra_operands[j - 2]. It is
    // empty when cond_short_circuit is 0, exactly like cond_rhs_insts / cond_extra_operands.
    pub cond_targets: std::array::Array<MirCondTarget>,
    pub cond_try_call: bool,
    pub cond_try_then_on_success: bool,
    pub cond_called_error_union: []u8,
    pub cond_own_error_union: []u8,
    pub cond_call_module_prefix: []u8,
    pub cond_call_callee_name: []u8,
    pub cond_call_args: std::array::Array<MirCallArg>,
    pub if_then_kind: MirIfThenKind,
    pub bool_value: bool,
    pub then_call_module_prefix: []u8,
    pub then_call_callee_name: []u8,
    pub then_call_args: std::array::Array<MirCallArg>,
    pub then_expr_result_id: i64,
    pub then_expr_insts: std::array::Array<MirExprInst>,
    // then_struct_fields / then_struct_string_index back a ReturnStruct then-block
    // such as a return of PayloadSpan { start: locals.first.payload_start, .. }. The
    // string index seeds the per-field SSA names and any ConstString field globals,
    // so it must match between the body render and the globals render.
    pub then_struct_fields: std::array::Array<MirStructField>,
    pub then_struct_string_index: i64,
    pub then_body_stmts: std::array::Array<MirStmt>,
    pub else_body_stmts: std::array::Array<MirStmt>,
    pub merge_vars: std::array::Array<MirIfMergeVar>,
}

// MirWhileStmt backs a restricted bounded counter loop (tracker 961): one mutable
// i64 induction variable initialized before the loop, a condition that reads it,
// a body of Let/If/Return statements, and a trailing 'var = var + step' increment
// folded into induction_step. The renderer emits a single loop-carried phi for the
// induction variable (named after it, so plain Var reads resolve to the phi) and a
// preheader/head/body/latch/exit block layout. body_stmts holds the body minus the
// increment; it references MirStmt through a heap-backed Array, the same self/mutual
// recursion MirStructField.nested_fields already uses, so the union stays fixed-size.
// The preheader edge seeds the phi from induction_init_var when it is non-empty (a
// 'var index = <param-or-local>' initializer, e.g. index_after_import's import_index),
// otherwise from the induction_init integer literal ('var index = <int>'); only those
// two init shapes are accepted (issue 1165).
// The header condition is one of two shapes, selected by cond_short_circuit:
//   0 = a single comparison, or an and/or tree whose operands are all side-effect-free
//       (an eager 'and i1' is observably identical to short-circuit, so it folds into
//       cond_insts / cond_result_id and the head emits one 'br i1');
//   1 = a genuine short-circuit leaf chain whose later leaves could trap when an
//       earlier one decides the condition (line_end_excluding_break's 'index < length and
//       !is_line_break(source[index])' loads source[index] only when index < length),
//       so cond_insts / cond_result_id hold leaf 0 in the head, cond_rhs_insts
//       / cond_rhs_result_id hold leaf 1 in a guarded loopN_head_rhs block, and any
//       further leaves fill cond_extra_operands. cond_targets names each leaf's two
//       branch destinations, so the tree may nest 'and' and 'or' freely.
// cond_rhs_insts / cond_extra_operands / cond_targets are empty when cond_short_circuit is 0
// (issue 1165 / 1162).
// The latch advances the induction variable. When latch_stmts is empty the latch is the
// constant update '<op> i64 %<var>, induction_step'. Most loops use add; bounded formatting
// loops also use mul/sdiv to advance a decimal divisor.
// When latch_stmts holds one statement the latch is a generic loop-carried update: a
// 'index = try <callee>(.., index);' try-call whose success value (field 1) feeds the
// phi as %<var>_next and whose failure propagates as this function's own error union
// (index_after_leading_imports is its first consumer, issue 1165). It is a 0-or-1 element
// Array<MirStmt> exactly like body_stmts so the union stays fixed-size.
// MirSecondaryInduction is one extra lockstep i64 counter advanced alongside the primary
// induction variable in a multi-counter bounded loop (issue 1165 / 1162). import_path_less
// walks two token cursors ('var left_index = left + 1; var right_index = right + 1; while
// left_index < tokens.len() and right_index < tokens.len() { ...; left_index = left_index +
// 1; right_index = right_index + 1; }'): left_index is the primary induction and right_index
// is one secondary. Each secondary gets its own loop-head phi (named after the variable, so
// plain Var reads resolve to it) seeded on the preheader edge from init_var + init_offset
// when init_var is non-empty (a 'var right_index = right + 1' base-plus-offset initializer)
// or from the init_literal otherwise, and a constant-step latch '%<var>_next = add i64
// %<var>, step'.
pub struct MirSecondaryInduction {
    pub var_name: []u8,
    pub init_literal: i64,
    pub init_var: []u8,
    pub init_offset: i64,
    pub step: i64,
}
pub struct MirCarriedScalar {
    pub var_name: []u8,
    pub llvm_type: []u8,
    pub init_literal: i64,
    pub init_var: []u8,
    pub init_offset: i64,
    pub init_name: []u8,
    pub latch_var: []u8,
}
pub struct MirWhileStmt {
    pub loop_index: i64,
    pub induction_var: []u8,
    pub induction_init: i64,
    pub induction_init_var: []u8,
    // induction_init_offset seeds a base-plus-offset primary init ('var left_index = left +
    // 1'): when induction_init_var is non-empty and the offset is non-zero the preheader
    // computes '%<var>_init = add i64 %<init_var>, offset' and the phi seeds from it; a zero
    // offset keeps the plain '%<init_var>' copy seed (issue 1165 / 1162).
    pub induction_init_offset: i64,
    pub induction_op: []u8,
    pub induction_step: i64,
    pub cond_result_id: i64,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_short_circuit: i64,
    pub cond_rhs_result_id: i64,
    pub cond_rhs_insts: std::array::Array<MirExprInst>,
    pub cond_extra_operands: std::array::Array<MirCondOperand>,
    // cond_targets holds one MirCondTarget per chain leaf in evaluation order, indexed exactly
    // like MirIfStmt.cond_targets. It is empty when cond_short_circuit is 0.
    pub cond_targets: std::array::Array<MirCondTarget>,
    pub body_stmts: std::array::Array<MirStmt>,
    pub latch_stmts: std::array::Array<MirStmt>,
    // latch_copy_var names the body-local a copy-decrement latch assigns into the induction
    // variable ('index = previous' where 'let previous = index - 1' is computed earlier in the
    // body for line_comment_is_full_line's source[previous] load). When it is non-empty the
    // primary loop-head phi reads %<latch_copy_var> on the latch edge instead of %<var>_next, and
    // the latch block emits no primary add: the body already holds the decremented value, so no
    // separate %<var>_next is computed. It is empty for a constant-step or try-call latch (issue
    // 1165 / 1162).
    pub latch_copy_var: []u8,
    pub secondary_inductions: std::array::Array<MirSecondaryInduction>,
    // carried_scalars are scalar locals conditionally mutated inside the loop body and threaded
    // through loop-head phis. They are not induction counters, so the latch emits no add; each phi
    // reads the final body SSA name (latch_var) on the latch edge. Older i64 carried scalars can
    // seed from literal/copy/offset metadata; branch-merge carried aliases seed from init_name, the
    // concrete SSA value that was current before the loop (issue 1162).
    pub carried_scalars: std::array::Array<MirCarriedScalar>,
    // init_insts / init_result_id back a call-seeded primary induction init ('var cursor =
    // line_end_including_break(source, comment_end)' for line_comment_has_blank_after, issue
    // 1165 / 1162). When init_insts is non-empty the preheader renders the call instructions and
    // the loop-head phi seeds from %t<init_result_id> on the preheader edge instead of from
    // induction_init_var / induction_init. Both stay empty (init_result_id is -1) for a literal,
    // plain-copy, or base-plus-offset seed.
    pub init_insts: std::array::Array<MirExprInst>,
    pub init_result_id: i64,
    // branch_latch_* backs a terminal if/else induction latch:
    // 'if done { index = bound; } else { ...; index = index + step; }'. When
    // branch_latch_cond_result_id is non-negative, the loop body falls through to this condition
    // instead of directly to loop<N>_latch. One edge exits the loop; the other renders
    // branch_latch_advance_stmts and then branches to the shared latch where induction_step is
    // applied. branch_latch_exit_on_true records which condition edge exits. The empty / -1
    // defaults keep the existing trailing, continue, try-call, copy, and leading-decrement latches.
    pub branch_latch_exit_on_true: bool,
    pub branch_latch_cond_result_id: i64,
    pub branch_latch_cond_insts: std::array::Array<MirExprInst>,
    pub branch_latch_advance_stmts: std::array::Array<MirStmt>,
}

// MirTraversalPayloadArg is the one traversal-specific argument setup that cannot be
// expressed before the match arm has materialized its tagged-union payload. The lowerer
// reserves temp_id in the arm's common expression namespace, the renderer extracts
// field_index into %t<temp_id>, and the final call consumes that value through an ordinary
// MirCallArg::Temp. It owns nothing.
pub struct MirTraversalPayloadArg {
    pub field_index: i64,
    pub temp_id: i64,
}

// MirTraversalArm is one arm of the node_count match-over-AstData traversal (tracker 961).
// A try-call arm ('Variant(bind) => try count_X(tree, bind.f, ...)') carries the discriminant
// tag, the inline payload struct type, the count_* callee symbol, and the payload-field args;
// the renderer extracts the payload, forwards the receiver + field args, calls count_X, and
// returns its error union directly (the callee and node_count share the !i64 return type, so
// the try is an identity tail return needing no ok/fail branch). A leaf arm ('Variant(_) => 1'
// / 'Empty => 1') sets is_literal and returns the literal wrapped as the error-union success.
// Parameter/literal/string/computed arguments use the same MirExprInst + MirCallArg path as
// every other call. Only payload_args retains traversal-specific materialization metadata.
// It owns all three Arrays.
pub struct MirTraversalArm {
    pub tag: i64,
    pub is_literal: bool,
    pub literal_value: i64,
    pub literal_llvm: []u8,
    pub payload_type: []u8,
    pub callee_module: []u8,
    pub callee_name: []u8,
    pub is_plain_call: bool,
    pub is_payload_value: bool,
    pub is_expr_value: bool,
    pub value_result_id: i64,
    pub success_llvm: []u8,
    pub arg_insts: std::array::Array<MirExprInst>,
    pub call_args: std::array::Array<MirCallArg>,
    pub payload_args: std::array::Array<MirTraversalPayloadArg>,
}

// MirCountRangeStmt backs count_range: 'var count = 0; var index = 0; while index <
// range.len { let child = try tree.child_at(range, index); count = count + try
// node_count(tree, child); index = index + 1; } return count;' (tracker 961). The renderer
// emits a two-phi accumulator loop (count + index) whose body calls the checked Ast.child_at
// and the recursive node_count, propagating either error union as this function's own !i64
// failure, and on the exhausted loop returns the accumulated count wrapped as the success.
// child_error_union is the exact fact-derived ABI of Ast.child_at's !NodeId result;
// the renderer must not infer it from a nominal spelling.
pub struct MirCountRangeStmt {
    pub receiver_name: []u8,
    pub receiver_type: []u8,
    pub range_name: []u8,
    pub range_type: []u8,
    pub range_len_field_index: i64,
    pub child_module: []u8,
    pub child_name: []u8,
    pub child_index_type: []u8,
    pub child_value_type: []u8,
    pub node_count_module: []u8,
    pub node_count_name: []u8,
    pub child_error_union: []u8,
    pub own_error_union: []u8,
}

// MirTrimAsciiStmt backs std::mem::trim_ascii: 'var start = 0; var end = len(bytes); while
// start < end { if !is_ascii_space(bytes[start]) break; start += 1; } while end > start { if
// !is_ascii_space(bytes[end-1]) break; end -= 1; } return bytes[start..end];' (tracker 961).
// The renderer emits two search loops that break on the first non-space byte and return the
// trimmed two-bound slice. is_ascii_module/name name the byte classifier callee.
pub struct MirTrimAsciiStmt {
    pub bytes_name: []u8,
    pub is_ascii_module: []u8,
    pub is_ascii_name: []u8,
}

// MirAstNodeTextStmt backs ast_node_text(text, ast, node_id): 'let node = ast.get(node_id);
// let span = &node.span; return trim_ascii(text[span.start..span.end]);' (tracker 961). The
// renderer binds the AstNode by value off the Ast.get call, extracts the Span (AstNode field
// 0) and its start/end, slices text two-bound, and forwards the slice to trim_ascii.
pub struct MirAstNodeTextStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub node_id_name: []u8,
    pub node_id_type: []u8,
    pub get_module: []u8,
    pub get_name: []u8,
    pub node_type: []u8,
    pub span_type: []u8,
    pub span_field_index: i64,
    pub span_start_index: i64,
    pub span_end_index: i64,
    pub trim_module: []u8,
    pub trim_name: []u8,
}

// MirAdvancePositionStmt backs advance_position(source, start, end, initial): 'var index = start;
// var current = initial; while index < end { current = advance_byte(source[index], current);
// index = index + 1; } return current;' (tracker 961, scope 4 prerequisite). The renderer emits a
// two-phi loop threading the i64 index and the Position struct current; each iteration loads
// source[index] (i8) and feeds it with current into advance_byte, whose Position result becomes
// the next current. advance_byte_symbol is the already-compiled callee's mangled symbol.
pub struct MirAdvancePositionStmt {
    pub source_name: []u8,
    pub source_type: []u8,
    pub start_name: []u8,
    pub end_name: []u8,
    pub initial_name: []u8,
    pub position_type: []u8,
    pub advance_byte_symbol: []u8,
}

// MirNumberTokenStmt backs number_token(source, start, current): 'var end = start; while end <
// len(source) and is_digit(source[end]) { end = end + 1; } return token(Number, start, end,
// current);' (tracker 961, scope 4 prerequisite). The renderer scans an i64 end phi forward while
// each source[end] byte is a digit, then builds the Number Token. number_tag is the TokenKind
// discriminant; is_digit_symbol / token_symbol are the already-compiled callees. len(source) is
// the slice length field, read inline as extractvalue field 1 (no len call).
pub struct MirNumberTokenStmt {
    pub source_name: []u8,
    pub source_type: []u8,
    pub start_name: []u8,
    pub current_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub is_digit_symbol: []u8,
    pub token_symbol: []u8,
    pub number_tag: i64,
}

// MirStringTokenStmt backs string_token(source, start, current): quoted strings scan from
// start + 1 to the closing quote, while double-slash multiline strings scan to the end of the
// continuation block. The renderer keeps both scans in this selected helper so raw_token_at does
// not need an extra multiline helper body in the stage2 fact set. string_tag is the TokenKind
// discriminant.
pub struct MirStringTokenStmt {
    pub source_name: []u8,
    pub start_name: []u8,
    pub current_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub token_symbol: []u8,
    pub string_tag: i64,
}

// MirSkipLineCommentStmt backs skip_line_comment(source, start, initial): 'var end = start; var
// current = initial; while end < len(source) and source[end] != 10 { current = advance_byte(
// source[end], current); end = end + 1; } return token(Eof, end, end, current);' (tracker 961,
// scope 4 prerequisite). The renderer threads a two-phi loop (i64 end + Position struct current)
// past the comment line, folding advance_byte over each byte until newline, then builds the Eof
// Token at end. eof_tag is the TokenKind discriminant; advance_byte_symbol / token_symbol are the
// already-compiled callees.
pub struct MirSkipLineCommentStmt {
    pub source_name: []u8,
    pub start_name: []u8,
    pub initial_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub advance_byte_symbol: []u8,
    pub token_symbol: []u8,
    pub eof_tag: i64,
}

// MirTokenAtStmt backs token_at(source, offset, initial): the top-level tokenizer step that skips
// leading whitespace (counting blank lines) and line comments, tracks the pending doc-comment span,
// then returns attach_doc(raw_token_at(source, start, current), doc_start, doc_end) (tracker 961,
// scope 4 prerequisite). The renderer emits an outer loop (start / current / has_doc / doc_start /
// doc_end phis) with an inner whitespace loop (start / current / newlines phis); the conditional
// doc-span updates use selects, and every callee is an already-compiled lexer helper.
pub struct MirTokenAtStmt {
    pub source_name: []u8,
    pub offset_name: []u8,
    pub initial_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub is_space_symbol: []u8,
    pub advance_byte_symbol: []u8,
    pub is_doc_comment_start_symbol: []u8,
    pub skip_line_comment_symbol: []u8,
    pub position_symbol: []u8,
    pub raw_token_at_symbol: []u8,
    pub attach_doc_symbol: []u8,
}

// MirTokenKindPredicateStmt backs the parser's TokenKind predicates, either the compact
// 'return match token.kind { <Variant> => true, _ => false };' form or the exhaustive statement
// match with return-bool arms. The renderer extracts the TokenKind field off the Token param and
// compares it to every true variant discriminant, returning the OR-chain result (tracker 961,
// scope 4 prerequisite).
pub struct MirTokenKindPredicateStmt {
    pub token_name: []u8,
    pub token_type: []u8,
    pub kind_field_index: i64,
    pub variant_tags: std::array::Array<i64>,
}

// MirParserSpanPredicateStmt backs parser span classifiers that scan a source Span rather than a
// TokenKind: is_namespace_path_span(source, span) and is_struct_literal_type_span(source, span).
// They are small recursive-descent parser disambiguators used by type/postfix parsing. The
// renderer emits their explicit loop-carried state and calls the already-compiled byte helpers
// (is_name_byte / is_double_colon_at / is_upper_byte), keeping this work on the parser path
// instead of extending the legacy run scanner (tracker 961).
pub struct MirParserSpanPredicateStmt {
    pub mode: i64,
    pub source_name: []u8,
    pub span_name: []u8,
    pub span_type: []u8,
    pub is_name_callee_qualified: []u8,
    pub is_double_colon_callee_qualified: []u8,
    pub is_upper_callee_qualified: []u8,
}

// MirParserPostfixStartStmt backs the parser's AST-aware postfix disambiguators:
// is_type_apply_start(ast, text, left) and is_struct_literal_start(ast, text, left). They read the
// ParseNode's next Token for the syntax guard, bind the left AstNode via Ast.get(left.node), then
// delegate the final span classification to the compiled span predicates (tracker 961).
pub struct MirParserPostfixStartStmt {
    pub mode: i64,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub text_name: []u8,
    pub left_name: []u8,
    pub left_type: []u8,
    pub token_type: []u8,
    pub ast_node_type: []u8,
    pub span_type: []u8,
    pub get_module: []u8,
    pub get_name: []u8,
    pub node_id_type: []u8,
    pub node_field_index: i64,
    pub next_field_index: i64,
    pub ast_node_span_field_index: i64,
    pub guard_callee_qualified: []u8,
    pub span_callee_qualified: []u8,
}

// MirArrayNewStmt backs 'var <result> = std::array::Array<T>(<allocator>)': it binds a fresh
// runtime-owned array handle by calling @kizu_rt_array_new with the allocator and the element
// byte width. The width is derived from element_type via 'ptrtoint (ptr getelementptr (T, ptr
// null, i32 1) to i64)' rather than a per-call constant, so the same statement serves Array<Token>
// and Array<i64> without a hardcoded size (issue 1165: generic Array constructor lowering).
pub struct MirArrayNewStmt {
    pub result_name: []u8,
    pub owned_type: []u8,
    pub allocator_type: []u8,
    pub allocator_name: []u8,
    pub element_type: []u8,
}

// MirValueWhileStmt backs a value-carried bounded loop that appends struct values into a runtime
// array until a sentinel tag is reached -- the std::kizu::lexer::tokenize shape lowered generically
// (issue 1165). Unlike the i64-induction While, the loop carries a struct value (loop_var, type
// element_type) through a phi: the preheader seeds it with init_symbol(source), each body iteration
// recomputes it via update_symbol(source, loop_var), and the loop exits when field_index of the
// value equals eof_tag. Every carried value (seed + each iteration) is try-appended into array_name
// via array_append_symbol; an append failure returns this function's %kizu.error.owned failure
// early. The renderer keeps init/seed/loop/early-return/done in one basic-block group (label_base
// namespaces the blocks) so the cross-statement block wiring stays internal; only array_name is read
// from a preceding MirArrayNewStmt as an SSA value. The loop's done block returns the array as the
// !Array success, so it subsumes the trailing 'return <array>'.
pub struct MirValueWhileStmt {
    pub array_name: []u8,
    pub loop_var: []u8,
    pub source_name: []u8,
    pub element_type: []u8,
    pub owned_type: []u8,
    pub error_owned_type: []u8,
    pub error_void_type: []u8,
    pub init_callee_qualified: []u8,
    pub update_callee_qualified: []u8,
    pub array_append_symbol: []u8,
    pub field_index: i64,
    pub eof_tag: i64,
    pub label_base: []u8,
}

// MirGrammarBranch is one guarded arm of a value-carried grammar loop (issue 1157): a
// boolean predicate condition (cond_insts evaluate to the i1 read through cond_result_id)
// that, when true, reassigns the carried value through a free error-union-returning call
// (reassign) and branches back to the loop head. The reassign is a let-position try-call
// bound to the carried variable under a per-branch SSA suffix, so the loop-head phi reads
// its success value (field 1) on the branch's back-edge and a failure propagates as the
// function's own error union. It owns the cond inst Array and the reassign's call_args.
pub struct MirGrammarBranch {
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_result_id: i64,
    pub reassign: MirLetTryCallStmt,
}

// MirGrammarLoopStmt backs a 'while true' value-accumulation grammar loop (issue 1157):
// 'var <carried> = <init>; while true { if <pred0> { <carried> = try <leaf0>(..) } else {
// if <pred1> { ... } else { return <carried>; } } }'. It is structurally distinct from the
// i64-induction While (whose condition compares a counter) and the value-array loop (whose
// condition is a struct-field sentinel), so detecting it never diverts either: the condition
// is a bool literal 'true' and the body is a nested if/else chain whose non-final arms each
// reassign the carried value through a try-call and whose final else returns it. The renderer
// emits a preheader/head/branch CFG: the head holds one loop-carried phi for the carried value
// (named <carried_var> so plain Var reads resolve to it) seeded from init_name on the entry
// edge and from each branch's try-call success on its back-edge; each branch evaluates its
// predicate, and the terminal else wraps the carried value into own_error_union and returns it.
// It owns the branch Array (each branch owns its cond insts and reassign call_args).
pub struct MirGrammarLoopStmt {
    pub carried_var: []u8,
    pub carried_type: []u8,
    pub init_name: []u8,
    pub own_error_union: []u8,
    pub branches: std::array::Array<MirGrammarBranch>,
    pub label_base: []u8,
}

// MirValueCursorWhileStmt backs a value-carried append-while loop (the parse_call_with_args
// argument loop, issue 1157 NEW-A): 'var <cursor> = <init>; while !<pred>(<cursor>) { <body
// incl. try <arr>.append(x)>; <cursor> = try <latch>(..); }; return <cursor>;'. Embedded loops
// can also latch through '<cursor> = <prior-let>.next;'. It is
// structurally distinct from the i64-induction While (whose condition compares a counter), the
// value-array loop (whose condition is a struct-field sentinel) and the grammar loop (whose
// condition is the bool literal 'true'): the condition is a prefix-not over a free bool-predicate
// call and the latch reassigns the cursor through a free error-union try-call or a field read from
// a prior body local, so detecting it never diverts any of those. The renderer emits a
// head/body/latch/exit CFG: the head holds one loop-carried phi for the value cursor (named
// <cursor_var> so plain Var reads in the condition, body and latch resolve to it) seeded from
// init_name on the entry edge and from %<cursor>_next on the latch back-edge; the body statements
// lower through the same per-statement machinery the top level uses (so a borrowed '&var Array'
// append lowers as a void try-call), and the terminal exit wraps the cursor into own_error_union
// and returns it. It owns the cond insts, body stmts and the latch statement.
pub struct MirValueCursorWhileStmt {
    pub cursor_var: []u8,
    pub cursor_type: []u8,
    pub init_name: []u8,
    pub own_error_union: []u8,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_result_id: i64,
    pub body_stmts: std::array::Array<MirStmt>,
    pub latch: MirValueCursorLatch,
    pub label_base: []u8,
    pub terminal_return: bool,
    // A call-seeded cursor init ('var <cursor> = next_token(text, token)') is materialized in the
    // loop preheader as '%<init_name> = call <cursor_type> @<callee>(<args>)' so the loop-head phi
    // seeds from that concrete SSA value instead of self-referencing %<cursor> on the entry edge (an
    // undef cursor cycle the optimizer's GVN can crash on). init_call_callee_name is empty for the
    // var-copy seed path (the phi seeds directly from the copied local/param), in which case no
    // preheader call is rendered.
    pub init_call_callee_name: []u8,
    pub init_call_module_prefix: []u8,
    pub init_call_args: std::array::Array<MirCallArg>,
}

// MirPrecedenceLoopStmt backs a two-carried-value precedence-climbing loop:
// 'var <value> = try <init>(..); var <scalar> = <rank>(<value>.field); while
// <scalar> >= <min> { <body>; <value> = try <latch>(..); <scalar> =
// <rank>(<value>.field); }; return <value>;'. It is structurally distinct from the
// i64-induction While (one scalar induction and an arithmetic latch), the grammar loop
// (bool literal 'true' header), and the value-cursor loop (one carried value and a
// prefix-not predicate): this loop has two phis, a comparison header, a try-call value
// latch, and a plain-call scalar latch derived from the updated value. It owns the init
// calls, condition insts, body statements, and latch calls.
pub struct MirPrecedenceLoopStmt {
    pub value_var: []u8,
    pub value_type: []u8,
    pub scalar_var: []u8,
    pub scalar_type: []u8,
    pub own_error_union: []u8,
    pub value_init: MirLetTryCallStmt,
    pub scalar_init: MirLetCallStmt,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_result_id: i64,
    pub body_stmts: std::array::Array<MirStmt>,
    pub value_latch: MirLetTryCallStmt,
    pub scalar_latch: MirLetCallStmt,
    pub label_base: []u8,
}

// MirDualCursorLoopStmt backs a two-carried-value cursor loop that, unlike the
// precedence loop, seeds its value cursor by copying a prior local/param rather
// than a try-call: 'var <value> = <source>; var <scalar> = <plain>(<value>);
// while <predicate>(<scalar>) { <prefix lets>; <value> = try <latch>(..);
// <scalar> = <plain>(<value>); }; return <value>;' (parse_type_base_end's
// '::' segment walk). The value phi takes its preheader incoming straight from
// the copied source SSA value, so this shape carries no value-init call. The
// scalar cursor is seeded and latched by plain calls and the header is a
// side-effect-free predicate call, distinguishing it from the precedence loop
// (try-call value init plus a '>=' comparison header) and the value-cursor loop
// (a single carried value behind a prefix-not predicate). It owns the scalar
// init call, condition insts, body statements, and latch calls.
pub struct MirDualCursorLoopStmt {
    pub value_var: []u8,
    pub value_type: []u8,
    pub value_source_var: []u8,
    pub scalar_var: []u8,
    pub scalar_type: []u8,
    pub own_error_union: []u8,
    pub scalar_init: MirLetCallStmt,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_result_id: i64,
    pub body_stmts: std::array::Array<MirStmt>,
    pub value_latch: MirLetTryCallStmt,
    pub scalar_latch: MirLetCallStmt,
    pub label_base: []u8,
}

// MirTypeApplyLoopStmt backs parse_type_apply_expr_with_args' 'while true' loop:
// a Token cursor seeded by a plain call, a per-iteration ParseNode try-call, a borrowed
// Array append, a terminal '>' arm that builds children and returns a ParseNode, an error
// guard for non-comma tokens, and a plain-call cursor latch. It is disjoint from the
// existing cursor shapes: grammar-postfix has a Var seed plus nested reassignment arms,
// value-cursor has a prefix-not header and try-call latch, and value-array has a
// struct-field sentinel header. This shape keeps the bool-literal header but requires the
// plain-call seed/latch and terminal construction arm.
pub struct MirTypeApplyLoopStmt {
    pub cursor_var: []u8,
    pub cursor_type: []u8,
    pub own_error_union: []u8,
    pub init: MirLetCallStmt,
    pub parse_arg: MirLetTryCallStmt,
    pub body_stmts: std::array::Array<MirStmt>,
    pub terminal_cond_insts: std::array::Array<MirExprInst>,
    pub terminal_cond_result_id: i64,
    pub terminal_stmts: std::array::Array<MirStmt>,
    pub guard_stmts: std::array::Array<MirStmt>,
    pub latch: MirLetCallStmt,
    pub label_base: []u8,
}

// MirWhileMatchArm is one arm of a while-true + match-dispatch loop body (parse_generic_type_end,
// worker-3 NEW-4). tag is the matched TokenKind variant's discriminant; is_default marks the
// trailing exhaustive fallthrough (the final arm, which carries no icmp). A return arm carries its
// lowered 'return <expr>' in arm_stmts and leaves is_latch false; the single latch arm
// ('<cursor> = try <call>(..)') sets is_latch true and leaves arm_stmts empty -- the loop's shared
// MirLetTryCallStmt latch renders it and branches back to the loop head. arm_stmts is a heap-backed
// Array<MirStmt> exactly like MirEnumDispatchArm so the union stays fixed-size.
pub struct MirWhileMatchArm {
    pub tag: i64,
    pub is_default: bool,
    pub is_latch: bool,
    pub arm_stmts: std::array::Array<MirStmt>,
}

// MirWhileMatchLoopStmt backs a 'while true' loop whose body is a few prefix lets followed by a
// 'match <token>.kind' dispatch (parse_generic_type_end's generic-argument walk, worker-3 NEW-4):
// 'var <cursor> = <plain init>; while true { <try-call/plain prefix lets>; match <next>.kind {
// <variant> => return <expr>, <comma> => <cursor> = try <latch>(..), <others> => return error(..)
// } }; return error(..)'. It is structurally distinct from the i64-induction While (whose body ends
// in an arithmetic increment), the value-cursor / type-apply loops (whose body ends in an
// if-chain + unconditional latch), and the bare EnumDispatch (whose every arm returns): here one
// match arm latches the cursor and back-edges to the loop head while every other arm returns. The
// renderer emits a head/body CFG: the head holds one loop-carried phi for the cursor seeded from
// the plain init on the entry edge and from %<cursor>_next on the latch try-call's cont block; the
// body lowers the prefix lets, evaluates the scrutinee discriminant, and runs an exhaustive icmp/br
// dispatch chain whose return arms ret and whose latch arm reassigns the cursor and branches back.
// The source's trailing 'return error(..)' is unreachable (the loop never exits normally) and is
// not emitted, exactly like the type-apply loop's trailing error return. It owns the init, the
// body stmts, the scrutinee insts, the arm Array, and the latch.
pub struct MirWhileMatchLoopStmt {
    pub cursor_var: []u8,
    pub cursor_type: []u8,
    pub own_error_union: []u8,
    pub init: MirLetCallStmt,
    pub body_stmts: std::array::Array<MirStmt>,
    pub scrutinee_insts: std::array::Array<MirExprInst>,
    pub scrutinee_result_id: i64,
    pub arms: std::array::Array<MirWhileMatchArm>,
    pub latch: MirLetTryCallStmt,
    pub label_base: []u8,
}

// MirTrailingTokenLoopStmt backs a dual Token-cursor advance loop that tracks the trailing token
// (generic_type_allows_const_arg's '<'-walk, NEW-3 second half): 'var <current> = <plain init>; var
// <previous> = <current>; while <current>.<field> < <other>.<field> and <predicate>(<current>) {
// <previous> = <current>; <current> = <plain latch>(<current>); }; <post stmts using previous>'. Two
// Token cursors share one type: the head holds a phi for <current> seeded from the plain init on the
// entry edge and from %<current>_next on the body edge, plus a phi for <previous> seeded from the
// same init on entry (matching 'var previous = current') and from the <current> phi on the body edge
// (the copy latch 'previous = current' is purely that back-edge, so it carries no instruction). The
// compound-AND header is lowered eagerly into cond_insts; the body advances <current> through the
// plain latch and back-edges to the head. The exit block falls through (no terminator) so the
// post-loop statements -- lowered as ordinary trailing MirStmts on the owning function and using the
// loop-carried <previous>/<current> phis -- render straight into it. It is disjoint from
// MirDualCursorLoopStmt (whose value seed is a Var-copy at statement 0, whose header is a single
// predicate call, and whose body ends in a try-call value latch plus a plain-call scalar latch, with
// a bare 'return <value>' exit) because here statement 0 is the plain-call seed, statement 1 the
// Var-copy seed, the header is a compound AND, both latches are Assigns (no try-call), and the exit
// runs arbitrary post-loop statements. It owns the init call, the condition insts, and the latch
// call.
pub struct MirTrailingTokenLoopStmt {
    pub current_var: []u8,
    pub previous_var: []u8,
    pub token_type: []u8,
    pub init: MirLetCallStmt,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_result_id: i64,
    pub latch: MirLetCallStmt,
    pub label_base: []u8,
}

// MirGuardedCursorLoopStmt backs a value-carried cursor loop whose latch is reached only through a
// terminal if/else (parse_type_params' '<T, U>' walk): 'var <cursor> = <plain init>(..); while
// !<pred>(<cursor>) { <body lets/void-calls>; if <pred2>(<local>) { <cursor> = <plain latch>(..); }
// else { <else lets>; return <expr>; } }; return <expr>;'. It is structurally distinct from the
// value-cursor append loop (whose latch is the unconditional last body statement, an error-union
// try-call, and whose exit returns the bare cursor), the type-apply / while-match loops (a
// bool-literal 'while true' header with no normal exit), and the i64-induction While (whose body
// ends in an arithmetic increment): here the header is a prefix-not predicate giving a normal exit,
// the body's terminal If latches the cursor through a plain call in one arm and returns from the
// other, and both the else arm and the post-loop trailing statement return a struct value reading
// the loop-head phi. The renderer emits a head/body/latch/else/exit CFG: the head holds one
// loop-carried phi for the cursor (named <cursor_var> so plain Var reads in the condition, body,
// terminal condition and exit resolve to it) seeded from %<cursor>_init on the entry edge and from
// %<cursor>_next on the latch back-edge; the body statements lower through the same per-statement
// machinery the top level uses, the terminal condition branches to the plain-call latch or the else
// arm, the latch reassigns the cursor and back-edges to the head, and the else and exit arms run
// their lowered statements (each ending in a return). The pre-cursor lets (e.g. 'let start =
// begin_children()') are emitted as ordinary top-level statements ahead of this one, so the cursor
// init is the only preheader instruction this statement owns. It owns the init, the condition
// insts, the body stmts, the terminal condition insts, the latch, and the else/exit stmts.
pub struct MirGuardedCursorLoopStmt {
    pub cursor_var: []u8,
    pub cursor_type: []u8,
    pub own_error_union: []u8,
    pub init: MirLetCallStmt,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_result_id: i64,
    pub body_stmts: std::array::Array<MirStmt>,
    pub terminal_cond_insts: std::array::Array<MirExprInst>,
    pub terminal_cond_result_id: i64,
    pub latch: MirLetCallStmt,
    pub else_stmts: std::array::Array<MirStmt>,
    pub exit_stmts: std::array::Array<MirStmt>,
    pub label_base: []u8,
}

// MirFirstTokenStmt backs first_token(source): 'return token_at(source, 0, position(1, 1));'
// (tracker 961, scope 4 prerequisite). The renderer builds the (1, 1) start Position then returns
// token_at at offset 0. Its nested call argument (position(1, 1)) the generic path does not model,
// so it is dispatched by name.
pub struct MirFirstTokenStmt {
    pub source_name: []u8,
    pub source_type: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub position_line_type: []u8,
    pub position_column_type: []u8,
    pub offset_type: []u8,
    pub position_module: []u8,
    pub position_name: []u8,
    pub token_at_module: []u8,
    pub token_at_name: []u8,
}

// MirNextTokenStmt backs next_token(source, previous): it reads previous.start / end / line /
// column, advances the Position across the previous token span via advance_position, then returns
// token_at at previous.end (tracker 961, scope 4 prerequisite). Its nested call arguments
// (position(...) feeding advance_position) the generic path does not model, so it is dispatched by
// name.
pub struct MirNextTokenStmt {
    pub source_name: []u8,
    pub source_type: []u8,
    pub previous_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub start_field_type: []u8,
    pub end_field_type: []u8,
    pub line_field_type: []u8,
    pub column_field_type: []u8,
    pub start_field_index: i64,
    pub end_field_index: i64,
    pub line_field_index: i64,
    pub column_field_index: i64,
    pub position_module: []u8,
    pub position_name: []u8,
    pub advance_position_module: []u8,
    pub advance_position_name: []u8,
    pub token_at_module: []u8,
    pub token_at_name: []u8,
}

// MirOperator is one entry of raw_token_at's operator dispatch table (tracker 961, scope 4
// prerequisite). When byte matches the first byte, the renderer returns the single-char Token
// (single_tag, start..start+1). second_byte >= 0 adds a look-ahead: if source[start+1] equals it,
// the two-char Token (two_tag, start..start+2) is returned instead; third_byte >= 0 adds one more
// alternative (third_tag, used only by '=' -> Eq / FatArrow / Assign). -1 marks an absent
// alternative.
pub struct MirOperator {
    pub byte: i64,
    pub single_tag: i64,
    pub second_byte: i64,
    pub two_tag: i64,
    pub third_byte: i64,
    pub third_tag: i64,
}

// MirRawTokenStmt backs raw_token_at(source, start, current): an Eof guard, an operator dispatch
// table over the byte at start, then quote / multiline-string / digit / word fallbacks dispatching
// to string_token / number_token / word_token (tracker 961, scope 4 prerequisite). eof_tag is the
// TokenKind::Eof discriminant; the *_symbol fields are the already-compiled callees; operators owns
// the dispatch table Array.
pub struct MirRawTokenStmt {
    pub source_name: []u8,
    pub start_name: []u8,
    pub current_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub token_symbol: []u8,
    pub is_digit_symbol: []u8,
    pub string_token_symbol: []u8,
    pub number_token_symbol: []u8,
    pub word_token_symbol: []u8,
    pub eof_tag: i64,
    pub operators: std::array::Array<MirOperator>,
}

// MirKeyword is one (spelling, TokenKind tag) entry of word_token's keyword table (tracker 961,
// scope 4 prerequisite). The renderer emits the spelling as a private string constant and compares
// the scanned identifier slice against it via equal_bytes, returning the keyword Token on a match.
// It owns nothing (text is a borrowed literal slice), so its deinit is empty.
pub struct MirKeyword {
    pub text: []u8,
    pub tag: i64,
}

// MirWordTokenStmt backs word_token(source, start, current): it scans an identifier run (is_word),
// returns a single-byte Ident when the run is empty, otherwise compares the run against the keyword
// table and returns the matching keyword Token, falling back to a multi-byte Ident (tracker 961,
// scope 4 prerequisite). is_word_symbol / token_symbol / equal_bytes_symbol are the already-
// compiled callees; ident_tag is the Ident discriminant; keywords owns the keyword table Array.
pub struct MirWordTokenStmt {
    pub symbol: []u8,
    pub source_name: []u8,
    pub start_name: []u8,
    pub current_name: []u8,
    pub position_type: []u8,
    pub token_type: []u8,
    pub is_word_symbol: []u8,
    pub token_symbol: []u8,
    pub equal_bytes_symbol: []u8,
    pub ident_tag: i64,
    pub keywords: std::array::Array<MirKeyword>,
}

// MirIsDocCommentStartStmt backs is_doc_comment_start(source, start): 'let length = len(source);
// if start + 2 >= length { return false; } if source[start] != 47 or source[start + 1] != 47 or
// source[start + 2] != 47 { return false; } return start + 3 >= length or source[start + 3] != 47;'
// (tracker 961, scope 4 prerequisite). The renderer emits a bounded branch chain returning i1:
// three slash bytes (47) make a comment, and a fourth slash (start + 3 in bounds) demotes it from
// a doc comment. All byte offsets / sentinels are fixed, so the renderer needs only the slice and
// start names.
pub struct MirIsDocCommentStartStmt {
    pub source_name: []u8,
    pub start_name: []u8,
}

// MirStringLiteralSpanStmt backs string_literal_span(text, ast, node_id): it binds the AstNode
// via Ast.get, reads the Span (AstNode field 0) start/end, rejects spans shorter than the two
// surrounding quote bytes, checks the leading/trailing double-quote (byte 34), forwards the
// inner payload slice to is_payload_supported, and returns the trimmed PayloadSpan on success or
// empty_payload_span() otherwise (tracker 961, scope 4 prerequisite). The callee module names
// the same selfhost::ir::codegen module both helper callees live in.
pub struct MirStringLiteralSpanStmt {
    pub text_name: []u8,
    pub ast_name: []u8,
    pub ast_type: []u8,
    pub node_id_name: []u8,
    pub node_id_type: []u8,
    pub get_module: []u8,
    pub get_name: []u8,
    pub node_type: []u8,
    pub span_type: []u8,
    pub span_field_index: i64,
    pub span_start_index: i64,
    pub span_end_index: i64,
    pub callee_module: []u8,
    pub is_payload_name: []u8,
    pub empty_name: []u8,
}

// MirReturnTryBinaryStmt backs a 'return <literal> + try <callee>(<args>);' single return
// (count_one / count_with_range, tracker 961). The renderer emits the call, branches on its
// ok flag, propagates the failure as this function's own error union, and on success adds the
// literal to the unwrapped value and returns it wrapped as the error-union success. It owns
// the call-argument Array.
pub struct MirReturnTryBinaryStmt {
    pub literal: i64,
    pub called_error_union: []u8,
    pub own_error_union: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirReturnNotTryCallStmt backs a 'return !(try <callee>(<args>));' single return whose callee
// returns an error-union bool (issue 1165 / 1162): the first compiled member with a try-call in
// sub-expression position. The renderer emits the call, branches on its ok flag, propagates the
// failure as this function's own error union (own_error_union), and on success negates the
// unwrapped bool with 'xor i1 %success, true' and returns the negation wrapped as the error-union
// success. The block labels / SSA temps are namespaced by the render-time statement index
// ('nottry<N>_*') so multiple sub-expression try-calls in one function never collide. It owns the
// call-argument Array. is_trailing_comma is its first consumer.
pub struct MirReturnNotTryCallStmt {
    pub called_error_union: []u8,
    pub own_error_union: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub string_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirIfNotTryCallReturnBoolStmt backs an 'if !(try <callee>(<args>)) { return <bool>; }' guard
// whose callee returns an error-union bool (issue 1165 / 1162): the if-condition twin of
// MirReturnNotTryCallStmt. The renderer emits the call, branches on its ok flag, propagates the
// failure as this function's own error union, negates the unwrapped bool, and branches on the
// negation into a 'return <bool_value>' then-block or a fall-through join block that subsequent
// statements render into. The labels / SSA temps are namespaced by the render-time statement index
// ('nottry<N>_*'). It owns the call-argument Array. is_trailing_comma is its first consumer.
pub struct MirIfNotTryCallReturnBoolStmt {
    pub called_error_union: []u8,
    pub own_error_union: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub bool_value: bool,
    pub string_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirStringTryAppendStmt backs a mutating 'try <receiver>.append_bytes(<arg>);' or
// 'try <receiver>.append_byte(<arg>);' statement on a std::string::String value
// (issue 1165 slice 1). String lowers to the runtime-owned handle %kizu.owned, and the
// method forwards to the @kizu_rt_string_append_* runtime helper returning %kizu.error.void.
// The renderer emits the call, branches on its ok flag, and on failure propagates the
// runtime message as this function's own error union (own_error_union); on success it
// continues in place because the statement binds no value. It owns the call-argument Array
// holding the single appended value.
pub struct MirStringTryAppendStmt {
    pub receiver_name: []u8,
    pub runtime_symbol: []u8,
    pub own_error_union: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirArrayTryAppendStmt backs a mutating 'try <receiver>.append(<value>);' statement on a
// std::array::Array<T> value. The array lowers to the runtime-owned handle %kizu.owned and the
// element is marshalled through a statement-local slot into the element-size-generic
// @kizu_rt_array_append runtime helper returning %kizu.error.void. The renderer emits the call,
// branches on its ok flag, and on failure propagates the runtime message as this function's own
// error union; on success it continues in place because the statement binds no value. It owns
// the call-argument Array holding the single appended value.
pub struct MirArrayTryAppendStmt {
    pub receiver_name: []u8,
    pub receiver_source_type: []u8,
    pub receiver_field_index: i64,
    pub element_llvm: []u8,
    pub own_error_union: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirArrayTrySetStmt backs a mutating 'try <receiver>.set(<index>, <value>);' statement on a
// std::array::Array<T> value: the index lowers as a plain i64 argument and the element is
// marshalled through a statement-local slot into the element-size-generic @kizu_rt_array_set
// runtime helper returning %kizu.error.void. The renderer mirrors ArrayTryAppend's ok-branch
// and failure-propagation tail; call_args holds [index, value].
pub struct MirArrayTrySetStmt {
    pub receiver_name: []u8,
    pub element_llvm: []u8,
    pub own_error_union: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirVoidTryCallStmt backs a bare 'try <callee>(<args>);' statement. The callee may return any
// error-union success type; the success value is intentionally discarded because the call is in
// statement position. called_error_union retains the callee's physical ABI so the renderer can
// extract its ok flag and message without assuming a void success.
pub struct MirVoidTryCallStmt {
    pub own_error_union: []u8,
    pub called_error_union: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirVoidTryExprStmt backs a bare 'try <expr>;' statement whose operand is not a call --
// the deferred-propagation shape 'let r = <fallible call>; <cleanup>; try r;'. expr_insts
// lower the operand generically (any expression kind) and expr_result_id names the temp
// holding its error-union aggregate, whose physical ABI is called_error_union. The renderer
// extracts the ok flag and propagates the message through own_error_union exactly like
// MirVoidTryCallStmt; the success value is discarded because the try is in statement
// position. It owns the expression instruction Array.
pub struct MirVoidTryExprStmt {
    pub own_error_union: []u8,
    pub called_error_union: []u8,
    pub string_index: i64,
    pub try_index: i64,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// MirVoidCallStmt backs a resolved non-error-union call used as an expression
// statement. The call target is already instance-scoped by lowering; the value
// is intentionally discarded because its canonical result is void.
pub struct MirVoidCallStmt {
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub string_index: i64,
    pub call_args: std::array::Array<MirCallArg>,
}

// MirErrDeferStmt registers a resolved zero-argument cleanup call. It emits no
// code on the success path; failure renderers replay active registrations in
// reverse order immediately before returning the propagated error.
pub struct MirErrDeferStmt {
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirPrintStmt {
    pub transport: builtin_contract::PrintRuntimeTransport,
    pub value_llvm_type: []u8,
    pub value_result_id: i64,
    pub value_insts: std::array::Array<MirExprInst>,
}

// MirOwnedDeinitStmt backs a non-try '<receiver>.deinit();' expression statement on a value
// receiver whose resolved Kizu type lowers to the runtime-owned %kizu.owned handle. The lowerer
// validates the AST shape, zero-arg method, and receiver type before constructing this statement;
// the renderer emits the explicit cleanup boundary through @kizu_rt_owned_deinit.
pub struct MirOwnedDeinitStmt {
    pub receiver_name: []u8,
}

// MirMatchTraversalStmt backs a recursive tagged-union traversal accessor: 'let node =
// tree.get(node_id); return match node.data { ... };'. The lowerer resolves the get callee,
// returned node ABI, and exact union field ABI before constructing MIR; the renderer only
// consumes these fields and emits an exhaustive icmp/br chain over the arms,
// each arm returning a real value (no 'unreachable'). own_error_union is the node_count return
// type the leaf arms wrap into. It owns the arm Array.
pub struct MirMatchTraversalStmt {
    pub get_module: []u8,
    pub get_name: []u8,
    pub node_type: []u8,
    pub union_type: []u8,
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub index_type: []u8,
    pub index_name: []u8,
    pub data_field_index: i64,
    pub own_error_union: []u8,
    pub arms: std::array::Array<MirTraversalArm>,
}

// MirEnumDispatchArm is one arm of a non-bool enum-dispatch match statement (issue 1157
// PR-PH / B3).
// tag is the matched variant's discriminant; is_default marks the trailing '_' dispatch fallback
// (which carries no tag). arm_stmts is a heap-backed Array exactly like MirWhileStmt.body_stmts,
// so the union stays fixed-size. falls_through independently marks an effect-only body that
// branches to the dispatch continuation rather than terminating the function.
pub struct MirEnumDispatchArm {
    pub tag: i64,
    pub is_default: bool,
    pub falls_through: bool,
    // A tagged-union arm may bind its variant payload. binding_name is the
    // arm-unique backend name referenced by the lowered body; payload_type is
    // derived from the matching union-variant fact. Enum/default arms keep
    // both empty and therefore emit no payload load.
    pub binding_name: []u8,
    pub payload_type: []u8,
    pub arm_stmts: std::array::Array<MirStmt>,
}

// MirEnumDispatchStmt backs a non-bool enum-dispatch match statement lowered to branch
// control flow (issue 1157 PR-PH / B3): the scrutinee lowers to an i64 discriminant in
// scrutinee_insts (the value read through scrutinee_result_id), then the renderer emits an
// exhaustive icmp/br dispatch chain over the arms. The last arm is the unconditional exhaustive
// dispatch fallthrough (a '_' default or, for an exhaustive enum match, the final variant).
// Effect-only arms branch to one shared continuation; terminal arms return in place. It owns the
// scrutinee inst Array and the arm Array.
pub struct MirEnumDispatchStmt {
    pub scrutinee_insts: std::array::Array<MirExprInst>,
    pub scrutinee_result_id: i64,
    pub scrutinee_llvm_type: []u8,
    pub scrutinee_is_union: bool,
    pub arms: std::array::Array<MirEnumDispatchArm>,
}

// MirVoidReturnSuccessStmt backs a bare 'return;' statement: a plain void function
// rets void, and an error-union void function returns the wrapped success value.
pub struct MirVoidReturnSuccessStmt {
    pub placeholder: i64,
}

pub union MirStmt {
    VoidReturnSuccess(MirVoidReturnSuccessStmt),
    LetCall(MirLetCallStmt),
    LetStruct(MirLetStructStmt),
    LetArenaAdd(MirLetArenaAddStmt),
    LetExpr(MirLetExprStmt),
    AliasAssign(MirAliasAssignStmt),
    ScalarSelectAssign(MirScalarSelectAssignStmt),
    LetTryCall(MirLetTryCallStmt),
    ReturnTryBinary(MirReturnTryBinaryStmt),
    ReturnNotTryCall(MirReturnNotTryCallStmt),
    IfNotTryCallReturnBool(MirIfNotTryCallReturnBoolStmt),
    StringTryAppend(MirStringTryAppendStmt),
    ArrayTryAppend(MirArrayTryAppendStmt),
    ArrayTrySet(MirArrayTrySetStmt),
    ErrDefer(MirErrDeferStmt),
    VoidCall(MirVoidCallStmt),
    VoidTryCall(MirVoidTryCallStmt),
    VoidTryExpr(MirVoidTryExprStmt),
    Print(MirPrintStmt),
    OwnedDeinit(MirOwnedDeinitStmt),
    CountRange(MirCountRangeStmt),
    TrimAscii(MirTrimAsciiStmt),
    AdvancePosition(MirAdvancePositionStmt),
    NumberToken(MirNumberTokenStmt),
    StringToken(MirStringTokenStmt),
    SkipLineComment(MirSkipLineCommentStmt),
    IsDocCommentStart(MirIsDocCommentStartStmt),
    WordToken(MirWordTokenStmt),
    RawToken(MirRawTokenStmt),
    TokenAt(MirTokenAtStmt),
    FirstToken(MirFirstTokenStmt),
    NextToken(MirNextTokenStmt),
    ArrayNew(MirArrayNewStmt),
    ValueWhile(MirValueWhileStmt),
    GrammarLoop(MirGrammarLoopStmt),
    ValueCursorWhile(MirValueCursorWhileStmt),
    PrecedenceLoop(MirPrecedenceLoopStmt),
    DualCursorLoop(MirDualCursorLoopStmt),
    TrailingTokenLoop(MirTrailingTokenLoopStmt),
    TypeApplyLoop(MirTypeApplyLoopStmt),
    WhileMatchLoop(MirWhileMatchLoopStmt),
    GuardedCursorLoop(MirGuardedCursorLoopStmt),
    TokenKindPredicate(MirTokenKindPredicateStmt),
    ParserSpanPredicate(MirParserSpanPredicateStmt),
    ParserPostfixStart(MirParserPostfixStartStmt),
    AstNodeText(MirAstNodeTextStmt),
    StringLiteralSpan(MirStringLiteralSpanStmt),
    ReturnCall(MirReturnCallStmt),
    ReturnStruct(MirReturnStructStmt),
    ReturnExpr(MirReturnExprStmt),
    ReturnError(MirReturnErrorStmt),
    ReturnArrayGet(MirReturnArrayGetStmt),
    LetArrayGet(MirLetArrayGetStmt),
    If(MirIfStmt),
    While(MirWhileStmt),
    MatchTraversal(MirMatchTraversalStmt),
    EnumDispatch(MirEnumDispatchStmt),
}

// Only the Call instruction reads a result value and callee symbol; the scalar
// block instructions render purely from the function return type and terminator.
// The block-level call arguments live on MirFunction.call_args (which the call
// renderer reads), so the Call payload carries no argument Array of its own and
// every MirInstruction variant is copy-only. The union owns nothing and needs no
// deinit (issue 1007/1012, ADR-0075).
pub struct MirCallInst {
    pub result: MirValue,
    pub module_prefix: []u8,
    pub callee_name: []u8,
}

// MirArrayGetInst backs a read-only 'return self.<field>.get(index);' accessor
// (Array<T>.get -> !T, tracker 961). The renderer reads the Array<T> handle off
// the struct value receiver (extractvalue field_index), calls the checked
// @kizu_rt_array_at runtime helper, and on success loads the element_type value
// out of the borrowed view and wraps it as the error-union success value; on
// failure it forwards the runtime message as the error-union failure value. The
// error-union return type lives on MirFunction.return_type. The instruction owns
// nothing, so it is copy-only (issue 1007/1012, ADR-0075).
pub struct MirArrayGetInst {
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub field_index: i64,
    pub index_name: []u8,
    pub element_type: []u8,
}

// MirArenaGetInst backs a read-only 'return self.<field>.get(<param>.<field>);'
// accessor (Arena<T>.get -> T, tracker 961). The renderer reads the Arena<T> handle
// off the struct value receiver, calls the checked @kizu_rt_arena_get runtime helper,
// and on success loads the element_type value out of the borrowed view and returns it;
// on out-of-bounds it traps via @kizu_rt_trap (Arena.get panics rather than returning
// an error union). The index is a field access on a value parameter (NodeId.raw). The
// instruction owns nothing, so it is copy-only.
pub struct MirArenaGetInst {
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub arena_field_index: i64,
    pub element_type: []u8,
    pub index_param_type: []u8,
    pub index_param_name: []u8,
    pub index_field_index: i64,
}

// MirMatchUnionInst backs a 'match <node>.data { Variant(bind) =>
// bind.<field>.<field>, _ => <int> }' accessor. It first binds the resolved node value
// from a resolved get method call, then matches on the exact tagged-union field ABI:
// the renderer reads its i64 tag (field 0) and dispatches on variant_tag. The
// active arm extracts the variant payload out of the inline union storage (the canonical
// alloca+store+gep field 1+load ABI) and returns a two-level field access off it
// (payload field0_index : field0_type, then field1_index : the i64 return type). The
// default arm returns default_value. It owns nothing, so it is copy-only.
pub struct MirMatchUnionInst {
    pub get_module: []u8,
    pub get_name: []u8,
    pub node_type: []u8,
    pub union_type: []u8,
    pub receiver_type: []u8,
    pub receiver_name: []u8,
    pub index_type: []u8,
    pub index_name: []u8,
    pub data_field_index: i64,
    pub variant_tag: i64,
    pub payload_type: []u8,
    pub field0_index: i64,
    pub field0_type: []u8,
    pub field1_index: i64,
    pub default_value: i64,
}

pub union MirInstruction {
    ConstString,
    ConstInt,
    StructLiteral,
    Expr,
    MultiStatement,
    Call(MirCallInst),
    ArrayGet(MirArrayGetInst),
    ArenaGet(MirArenaGetInst),
    MatchUnion(MirMatchUnionInst),
}

pub enum MirTerminatorKind {
    Return,
}

pub struct MirTerminator {
    pub kind: MirTerminatorKind,
    pub value: MirValue,
}

pub struct MirBlock {
    pub label: []u8,
    pub instruction_count: i64,
    pub first_instruction: MirInstruction,
    pub terminator: MirTerminator,
}

pub struct MirFunction {
    pub name: []u8,
    pub return_type: MirType,
    pub params_spec: []u8,
    pub call_args: std::array::Array<MirCallArg>,
    pub struct_fields: std::array::Array<MirStructField>,
    pub expr_insts: std::array::Array<MirExprInst>,
    pub multi_stmts: std::array::Array<MirStmt>,
    pub block_count: i64,
    pub entry: MirBlock,
}

impl MirCallArg {
    fn deinit(self: MirCallArg) -> void {
        self.call_args.deinit();
        return;
    }
}

// MirStructField owns the call-argument Array of a call-valued field (Call kind);
// non-call fields hold the empty array from empty_struct_call_args. It is only
// ever stored in struct_fields Arrays, so this cleanup runs through structural
// array drop, mirroring MirCallExpr (tracker 961).
impl MirStructField {
    fn deinit(self: MirStructField) -> void {
        self.call_args.deinit();
        self.nested_fields.deinit();
        self.access_path.deinit();
        return;
    }
}

// MirExprInst is the only block-level owner union: its Call variant owns the
// expression call-argument Array, so its deinit frees that payload and the scalar
// variants own nothing (issue 1010 owner-payload union cleanup contract). It is
// only ever stored in Arrays, so this cleanup runs through structural array drop.
impl MirCallExpr {
    fn deinit(self: MirCallExpr) -> void {
        self.call_args.deinit();
        return;
    }
}

impl MirStructLiteralExpr {
    fn deinit(self: MirStructLiteralExpr) -> void {
        self.struct_fields.deinit();
        return;
    }
}

impl MirExprInst {
    fn deinit(self: MirExprInst) -> void {
        match self {
            Var(payload) => return;,
            ConstString(payload) => return;,
            ConstBool(payload) => return;,
            ConstInt(payload) => return;,
            ConstEnumTag(payload) => return;,
            PrefixNot(payload) => return;,
            Binary(payload) => return;,
            FieldAccess(payload) => return;,
            IndexLoad(payload) => return;,
            Slice(payload) => return;,
            Call(payload) => payload.deinit(),
            ArrayLen(payload) => return;,
            StringLen(payload) => return;,
            IntCast(payload) => return;,
            UnionConstruct(payload) => return;,
            StructLiteral(payload) => payload.deinit(),
            TryUnwrap(payload) => return;,
        }
    }
}

