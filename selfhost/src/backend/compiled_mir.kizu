        bool_value: false,
        string_index: -1,
        int_value: 0,
        source_type: source_type,
        source_field_index: source_field_index,
        nested_source_type: nested_type,
        nested_field_index: nested_field_index,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_start_source_type: "",
        slice_start_field_index: -1,
        slice_end_base: "",
        slice_end_offset: 0,
        slice_end_source_type: "",
        slice_end_field_index: -1,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

