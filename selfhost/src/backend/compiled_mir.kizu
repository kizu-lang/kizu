        id: id,
        kind: MirExprInstKind::Var,
        llvm_type: ty,
        value: name,
        int_value: 0,
        bool_value: false,
        left: -1,
        right: -1,
        op: "",
        source_type: "",
        source_field_index: -1,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
