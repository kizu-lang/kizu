pub enum MirTypeKind {
    SliceU8,
    I64,
    Llvm,
}

pub struct MirType {
    pub kind: MirTypeKind,
    pub llvm_name: []u8,
}

pub enum MirValKind {
    ConstString,
    ConstInt,
    CallResult,
    StructResult,
    ExprResult,
    MultiResult,
}

pub struct MirValue {
    pub id: i64,
    pub ty: MirType,
    pub kind: MirValKind,
    pub payload: []u8,
    pub int_value: i64,
}

pub enum MirCallArgKind {
    Var,
    String,
    Bool,
    FieldAccess,
    EmptySlice,
    Slice,
}

// A FieldAccess call arg mirrors MirStructField's nested layout: source_type /
// source_field_index extract the first field off the Var receiver, and when
// nested_field_index >= 0 a second extractvalue reads nested_field_index off
// nested_source_type (the intermediate field type). nested_field_index == -1
// marks a single-level access (receiver.field) so the renderer skips the second
// extractvalue (tracker 961, mirrors nested_field_access_struct_field).
pub struct MirCallArg {
    pub ty: []u8,
    pub kind: MirCallArgKind,
    pub value: []u8,
    pub bool_value: bool,
    pub string_index: i64,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub nested_source_type: []u8,
    pub nested_field_index: i64,
    pub slice_start_base: []u8,
    pub slice_start_offset: i64,
    pub slice_end_base: []u8,
    pub slice_end_offset: i64,
}

pub enum MirStructFieldKind {
    Var,
    ConstString,
    ConstInt,
    ConstBool,
    ConstEnumTag,
    FieldAccess,
    EmptySlice,
    Call,
    StructLiteral,
}

// A Call struct field carries a resolved direct call (callee + module prefix +
// lowered args) whose result becomes the field value. The renderer emits the
// call arg setup and call instruction before insertvalue-ing the result into the
// struct, mirroring the let/return call lowering. A StructLiteral field carries a
// nested struct literal's fields (nested_fields) and its struct type (llvm_type);
// the renderer builds the nested struct in its own insertvalue chain and feeds
// the result in. Non-nested fields keep call_callee_name empty and empty
// call_args / nested_fields arrays (tracker 961).
pub struct MirStructField {
    pub index: i64,
    pub kind: MirStructFieldKind,
    pub llvm_type: []u8,
    pub value: []u8,
    pub int_value: i64,
    pub bool_value: bool,
    pub source_type: []u8,
    pub source_field_index: i64,
    pub nested_source_type: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
    pub nested_fields: std::array::Array<MirStructField>,
}

// Per-variant MirExprInst payloads. Each holds only the fields its variant
// reads in the renderer; only the Call payload owns an inline Array, so the
// union below never carries inactive owned arrays for the scalar variants
// (issue 1007/1012, ADR-0075 tagged-union payload ABI). Every payload keeps
// id and llvm_type because expr_inst_id / expr_inst_llvm_type resolve them
// for any variant when wiring instruction results together.
pub struct MirVarExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
}

pub struct MirConstStringExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
    pub string_index: i64,
}

pub struct MirConstBoolExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub bool_value: bool,
}

pub struct MirConstIntExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub int_value: i64,
}

pub struct MirConstEnumTagExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub int_value: i64,
}

pub struct MirPrefixNotExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub operand: i64,
}

pub struct MirBinaryExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub op: []u8,
    pub left: i64,
    pub right: i64,
}

pub struct MirFieldAccessExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub value: []u8,
    pub left: i64,
    pub source_type: []u8,
    pub source_field_index: i64,
}

// Single-byte slice index load (path[i] in expression context). The renderer
// extracts the slice data pointer from target, GEPs by the i64 index result,
// and loads one i8. The instruction owns nothing, so it is copy-only.
pub struct MirIndexLoadExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub target: []u8,
    pub index: i64,
}

pub struct MirCallExpr {
    pub id: i64,
    pub llvm_type: []u8,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub union MirExprInst {
    Var(MirVarExpr),
    ConstString(MirConstStringExpr),
    ConstBool(MirConstBoolExpr),
    ConstInt(MirConstIntExpr),
    ConstEnumTag(MirConstEnumTagExpr),
    PrefixNot(MirPrefixNotExpr),
    Binary(MirBinaryExpr),
    FieldAccess(MirFieldAccessExpr),
    IndexLoad(MirIndexLoadExpr),
    Call(MirCallExpr),
}

pub enum MirIfThenKind {
    ReturnBool,
    ReturnCall,
    ReturnExpr,
    ReturnStruct,
    ReturnError,
}

// Per-variant MirStmt payloads. Each holds only the fields its variant needs and
// owns its inline Array storage, so the union below never carries inactive owned
// arrays (issue 1007/1011, ADR-0075 tagged-union payload ABI).
pub struct MirLetCallStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirLetStructStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirReturnCallStmt {
    pub name: []u8,
    pub llvm_type: []u8,
    pub string_index: i64,
    pub call_module_prefix: []u8,
    pub call_callee_name: []u8,
    pub call_args: std::array::Array<MirCallArg>,
}

pub struct MirReturnStructStmt {
    pub string_index: i64,
    pub struct_fields: std::array::Array<MirStructField>,
}

pub struct MirReturnExprStmt {
    pub string_index: i64,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

pub struct MirLetExprStmt {
    pub name: []u8,
    pub string_index: i64,
    pub expr_result_id: i64,
    pub expr_insts: std::array::Array<MirExprInst>,
}

// cond_short_circuit selects how the condition drives the branch:
//   0 = single condition (cond_insts / cond_result_id only)
//   1 = lhs and rhs short-circuit; rhs is only evaluated when lhs is true
//   2 = lhs or rhs short-circuit; rhs is only evaluated when lhs is false
// When short-circuit is active cond_insts/cond_result_id hold the lhs and
// cond_rhs_insts/cond_rhs_result_id hold the rhs, lowered in the guarded block
// so a trapping/loading rhs (e.g. a byte index) never runs unless reached.
pub struct MirIfStmt {
    pub if_index: i64,
    pub string_index: i64,
    pub llvm_type: []u8,
    pub cond_result_id: i64,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub cond_short_circuit: i64,
    pub cond_rhs_result_id: i64,
    pub cond_rhs_insts: std::array::Array<MirExprInst>,
    pub if_then_kind: MirIfThenKind,
    pub bool_value: bool,
    pub then_call_module_prefix: []u8,
    pub then_call_callee_name: []u8,
    pub then_call_args: std::array::Array<MirCallArg>,
    pub then_expr_result_id: i64,
    pub then_expr_insts: std::array::Array<MirExprInst>,
    // then_struct_fields / then_struct_string_index back a ReturnStruct then-block
    // such as a return of PayloadSpan { start: locals.first.payload_start, .. }. The
    // string index seeds the per-field SSA names and any ConstString field globals,
    // so it must match between the body render and the globals render.
    pub then_struct_fields: std::array::Array<MirStructField>,
    pub then_struct_string_index: i64,
}

// MirWhileStmt backs a restricted bounded counter loop (tracker 961): one mutable
// i64 induction variable initialized before the loop, a condition that reads it,
// a body of Let/If/Return statements, and a trailing 'var = var + step' increment
// folded into induction_step. The renderer emits a single loop-carried phi for the
// induction variable (named after it, so plain Var reads resolve to the phi) and a
// preheader/head/body/latch/exit block layout. body_stmts holds the body minus the
// increment; it references MirStmt through a heap-backed Array, the same self/mutual
// recursion MirStructField.nested_fields already uses, so the union stays fixed-size.
pub struct MirWhileStmt {
    pub loop_index: i64,
    pub induction_var: []u8,
    pub induction_init: i64,
    pub induction_step: i64,
    pub cond_result_id: i64,
    pub cond_insts: std::array::Array<MirExprInst>,
    pub body_stmts: std::array::Array<MirStmt>,
}

pub union MirStmt {
    LetCall(MirLetCallStmt),
    LetStruct(MirLetStructStmt),
    LetExpr(MirLetExprStmt),
    ReturnCall(MirReturnCallStmt),
    ReturnStruct(MirReturnStructStmt),
    ReturnExpr(MirReturnExprStmt),
    ReturnError,
    If(MirIfStmt),
    While(MirWhileStmt),
}

// Only the Call instruction reads a result value and callee symbol; the scalar
// block instructions render purely from the function return type and terminator.
// The block-level call arguments live on MirFunction.call_args (which the call
// renderer reads), so the Call payload carries no argument Array of its own and
// every MirInstruction variant is copy-only. The union owns nothing and needs no
// deinit (issue 1007/1012, ADR-0075).
pub struct MirCallInst {
    pub result: MirValue,
    pub module_prefix: []u8,
    pub callee_name: []u8,
}

pub union MirInstruction {
    ConstString,
    ConstInt,
    StructLiteral,
    Expr,
    MultiStatement,
    Call(MirCallInst),
}

pub enum MirTerminatorKind {
    Return,
}

pub struct MirTerminator {
    pub kind: MirTerminatorKind,
    pub value: MirValue,
}

pub struct MirBlock {
    pub label: []u8,
    pub instruction_count: i64,
    pub first_instruction: MirInstruction,
    pub terminator: MirTerminator,
}

pub struct MirFunction {
    pub name: []u8,
    pub return_type: MirType,
    pub params_spec: []u8,
    pub call_args: std::array::Array<MirCallArg>,
    pub struct_fields: std::array::Array<MirStructField>,
    pub expr_insts: std::array::Array<MirExprInst>,
    pub multi_stmts: std::array::Array<MirStmt>,
    pub block_count: i64,
    pub entry: MirBlock,
}

// MirStructField owns the call-argument Array of a call-valued field (Call kind);
// non-call fields hold the empty array from empty_struct_call_args. It is only
// ever stored in struct_fields Arrays, so this cleanup runs through structural
// array drop, mirroring MirCallExpr (tracker 961).
impl MirStructField {
    fn deinit(self: MirStructField) -> void {
        self.call_args.deinit();
        self.nested_fields.deinit();
        return;
    }
}

// MirExprInst is the only block-level owner union: its Call variant owns the
// expression call-argument Array, so its deinit frees that payload and the scalar
// variants own nothing (issue 1010 owner-payload union cleanup contract). It is
// only ever stored in Arrays, so this cleanup runs through structural array drop.
impl MirCallExpr {
    fn deinit(self: MirCallExpr) -> void {
        self.call_args.deinit();
        return;
    }
}

impl MirExprInst {
    fn deinit(self: MirExprInst) -> void {
        match self {
            Var(payload) => return;,
            ConstString(payload) => return;,
            ConstBool(payload) => return;,
            ConstInt(payload) => return;,
            ConstEnumTag(payload) => return;,
            PrefixNot(payload) => return;,
            Binary(payload) => return;,
            FieldAccess(payload) => return;,
            IndexLoad(payload) => return;,
            Call(payload) => payload.deinit(),
        }
    }
}

impl MirLetCallStmt {
    fn deinit(self: MirLetCallStmt) -> void {
        self.call_args.deinit();
        return;
    }
}

impl MirLetStructStmt {
    fn deinit(self: MirLetStructStmt) -> void {
        self.struct_fields.deinit();
        return;
    }
}

impl MirReturnCallStmt {
    fn deinit(self: MirReturnCallStmt) -> void {
        self.call_args.deinit();
        return;
    }
}

impl MirReturnStructStmt {
    fn deinit(self: MirReturnStructStmt) -> void {
        self.struct_fields.deinit();
        return;
    }
}

impl MirReturnExprStmt {
    fn deinit(self: MirReturnExprStmt) -> void {
        self.expr_insts.deinit();
        return;
    }
}

impl MirLetExprStmt {
    fn deinit(self: MirLetExprStmt) -> void {
        self.expr_insts.deinit();
        return;
    }
}

impl MirIfStmt {
    fn deinit(self: MirIfStmt) -> void {
        self.cond_insts.deinit();
        self.cond_rhs_insts.deinit();
        self.then_call_args.deinit();
        self.then_expr_insts.deinit();
        self.then_struct_fields.deinit();
        return;
    }
}

// Active-variant cleanup for the owner-payload union: match self binds the live
// payload as an owned local and frees it through its own deinit, so inactive
// payload storage is never read or cleaned (issue 1010 cleanup contract). The
// payload-free ReturnError variant owns nothing and needs no cleanup.
impl MirWhileStmt {
    fn deinit(self: MirWhileStmt) -> void {
        self.cond_insts.deinit();
        self.body_stmts.deinit();
        return;
    }
}

impl MirStmt {
    fn deinit(self: MirStmt) -> void {
        match self {
            LetCall(payload) => payload.deinit(),
            LetStruct(payload) => payload.deinit(),
            LetExpr(payload) => payload.deinit(),
            ReturnCall(payload) => payload.deinit(),
            ReturnStruct(payload) => payload.deinit(),
            ReturnExpr(payload) => payload.deinit(),
            ReturnError => return;,
            If(payload) => payload.deinit(),
            While(payload) => payload.deinit(),
        }
    }
}

// MirFunction is a product record holding the lowered owner Arrays; its deinit
// frees each one. MirBlock (entry) and its MirInstruction own nothing (the call
// arguments live on call_args above), so entry needs no cleanup and MirBlock and
// MirInstruction carry no deinit (issue 1007/1012).
impl MirFunction {
    fn deinit(self: MirFunction) -> void {
        self.call_args.deinit();
        self.struct_fields.deinit();
        self.expr_insts.deinit();
        self.multi_stmts.deinit();
        return;
    }
}

pub fn slice_u8_type() -> MirType {
    return MirType {
        kind: MirTypeKind::SliceU8,
        llvm_name: "%kizu.slice.u8"
    };
}

pub fn i64_type() -> MirType {
    return MirType {
        kind: MirTypeKind::I64,
        llvm_name: "i64"
    };
}

pub fn llvm_type(name: []u8) -> MirType {
    return MirType {
        kind: MirTypeKind::Llvm,
        llvm_name: name
    };
}

pub fn mir_string_const_value(id: i64, payload: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: slice_u8_type(),
        kind: MirValKind::ConstString,
        payload: payload,
        int_value: 0
    };
}

pub fn const_int_value(id: i64, value: i64) -> MirValue {
    return MirValue {
        id: id,
        ty: i64_type(),
        kind: MirValKind::ConstInt,
        payload: "",
        int_value: value
    };
}

pub fn call_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
        kind: MirValKind::CallResult,
        payload: name,
        int_value: 0
    };
}

pub fn struct_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
        kind: MirValKind::StructResult,
        payload: name,
        int_value: 0
    };
}

pub fn expr_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
        kind: MirValKind::ExprResult,
        payload: name,
        int_value: 0
    };
}

pub fn multi_result_value(id: i64, ty: MirType, name: []u8) -> MirValue {
    return MirValue {
        id: id,
        ty: ty,
        kind: MirValKind::MultiResult,
        payload: name,
        int_value: 0
    };
}

pub fn var_call_arg(ty: []u8, name: []u8) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Var,
        value: name,
        bool_value: false,
        string_index: -1,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn string_call_arg(ty: []u8, payload: []u8, string_index: i64) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::String,
        value: payload,
        bool_value: false,
        string_index: string_index,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn bool_call_arg(ty: []u8, value: bool) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Bool,
        value: "",
        bool_value: value,
        string_index: -1,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn field_access_call_arg(
    ty: []u8,
    source_type: []u8,
    source_name: []u8,
    source_field_index: i64
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::FieldAccess,
        value: source_name,
        bool_value: false,
        string_index: -1,
        source_type: source_type,
        source_field_index: source_field_index,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

// nested_field_access_call_arg lowers a two-level field access (receiver.a.b)
// passed as a call argument. source_type/source_field_index read the first
// field off the Var receiver and nested_source_type/nested_field_index read the
// leaf field off that intermediate value, matching nested_field_access_struct_field
// (tracker 961).
pub fn nested_field_access_call_arg(
    ty: []u8,
    source_type: []u8,
    source_name: []u8,
    source_field_index: i64,
    nested_type: []u8,
    nested_field_index: i64
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::FieldAccess,
        value: source_name,
        bool_value: false,
        string_index: -1,
        source_type: source_type,
        source_field_index: source_field_index,
        nested_source_type: nested_type,
        nested_field_index: nested_field_index,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn empty_slice_call_arg(ty: []u8) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::EmptySlice,
        value: "",
        bool_value: false,
        string_index: -1,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: "",
        slice_start_offset: 0,
        slice_end_base: "",
        slice_end_offset: 0
    };
}

pub fn slice_call_arg(
    ty: []u8,
    target: []u8,
    start_base: []u8,
    start_offset: i64,
    end_base: []u8,
    end_offset: i64
) -> MirCallArg {
    return MirCallArg {
        ty: ty,
        kind: MirCallArgKind::Slice,
        value: target,
        bool_value: false,
        string_index: -1,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        nested_field_index: -1,
        slice_start_base: start_base,
        slice_start_offset: start_offset,
        slice_end_base: end_base,
        slice_end_offset: end_offset
    };
}

// empty_struct_call_args backs the call_args field of non-call struct fields. It
// allocates an empty Array so every MirStructField has a valid (if unused) args
// array; only Call fields populate it (tracker 961).
fn empty_struct_call_args() -> std::array::Array<MirCallArg> {
    return std::array::Array<MirCallArg>(std::mem::page_allocator());
}

// empty_struct_nested_fields backs the nested_fields field of non-StructLiteral
// struct fields; only StructLiteral fields populate it (tracker 961).
fn empty_struct_nested_fields() -> std::array::Array<MirStructField> {
    return std::array::Array<MirStructField>(std::mem::page_allocator());
}

pub fn var_struct_field(index: i64, ty: []u8, name: []u8) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::Var,
        llvm_type: ty,
        value: name,
        int_value: 0,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn string_struct_field(index: i64, payload: []u8) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::ConstString,
        llvm_type: "%kizu.slice.u8",
        value: payload,
        int_value: 0,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn int_struct_field(index: i64, value: i64) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::ConstInt,
        llvm_type: "i64",
        value: "",
        int_value: value,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn bool_struct_field(index: i64, value: bool) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::ConstBool,
        llvm_type: "i1",
        value: "",
        int_value: 0,
        bool_value: value,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn enum_tag_struct_field(index: i64, tag: i64) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::ConstEnumTag,
        llvm_type: "i64",
        value: "",
        int_value: tag,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn field_access_struct_field(
    index: i64,
    field_type: []u8,
    receiver_name: []u8,
    receiver_type: []u8,
    source_field_index: i64
) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::FieldAccess,
        llvm_type: field_type,
        value: receiver_name,
        int_value: -1,
        bool_value: false,
        source_type: receiver_type,
        source_field_index: source_field_index,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn nested_field_access_struct_field(
    index: i64,
    field_type: []u8,
    receiver_name: []u8,
    receiver_type: []u8,
    source_field_index: i64,
    nested_type: []u8,
    nested_field_index: i64
) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::FieldAccess,
        llvm_type: field_type,
        value: receiver_name,
        int_value: nested_field_index,
        bool_value: false,
        source_type: receiver_type,
        source_field_index: source_field_index,
        nested_source_type: nested_type,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn empty_slice_struct_field(index: i64) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::EmptySlice,
        llvm_type: "%kizu.slice.u8",
        value: "",
        int_value: 0,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn call_struct_field(
    index: i64,
    field_type: []u8,
    call_module_prefix: []u8,
    call_callee_name: []u8,
    call_args: std::array::Array<MirCallArg>
) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::Call,
        llvm_type: field_type,
        value: "",
        int_value: -1,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: call_module_prefix,
        call_callee_name: call_callee_name,
        call_args: call_args,
        nested_fields: empty_struct_nested_fields()
    };
}

pub fn struct_literal_struct_field(
    index: i64,
    nested_llvm_type: []u8,
    nested_fields: std::array::Array<MirStructField>
) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::StructLiteral,
        llvm_type: nested_llvm_type,
        value: "",
        int_value: -1,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: nested_fields
    };
}

pub fn var_expr_inst(id: i64, ty: []u8, name: []u8) -> MirExprInst {
    return MirExprInst::Var(MirVarExpr {
        id: id,
        llvm_type: ty,
        value: name
    });
}

pub fn string_expr_inst(id: i64, payload: []u8, string_index: i64) -> MirExprInst {
    return MirExprInst::ConstString(MirConstStringExpr {
        id: id,
        llvm_type: "%kizu.slice.u8",
        value: payload,
        string_index: string_index
    });
}

pub fn bool_expr_inst(id: i64, value: bool) -> MirExprInst {
    return MirExprInst::ConstBool(MirConstBoolExpr {
        id: id,
        llvm_type: "i1",
        bool_value: value
    });
}

pub fn int_expr_inst(id: i64, value: i64) -> MirExprInst {
    return MirExprInst::ConstInt(MirConstIntExpr {
        id: id,
        llvm_type: "i64",
        int_value: value
    });
}

pub fn typed_int_expr_inst(id: i64, value: i64, llvm_type: []u8) -> MirExprInst {
    return MirExprInst::ConstInt(MirConstIntExpr {
        id: id,
        llvm_type: llvm_type,
        int_value: value
    });
}

pub fn prefix_not_expr_inst(id: i64, operand: i64) -> MirExprInst {
    return MirExprInst::PrefixNot(MirPrefixNotExpr {
        id: id,
        llvm_type: "i1",
        operand: operand
    });
}

fn binary_result_type(op: []u8) -> []u8 {
    if std::mem::equal_bytes(op, "add") or std::mem::equal_bytes(op, "sub") or
        std::mem::equal_bytes(op, "mul") or std::mem::equal_bytes(op, "div") {
        return "i64";
    }
    return "i1";
}

pub fn binary_expr_inst(id: i64, op: []u8, left: i64, right: i64) -> MirExprInst {
    return MirExprInst::Binary(MirBinaryExpr {
        id: id,
        llvm_type: binary_result_type(op),
        op: op,
        left: left,
        right: right
    });
}

pub fn enum_tag_expr_inst(id: i64, tag: i64) -> MirExprInst {
    return MirExprInst::ConstEnumTag(MirConstEnumTagExpr {
        id: id,
        llvm_type: "i64",
        int_value: tag
    });
}

pub fn field_access_expr_inst(
    id: i64,
    field_type: []u8,
    receiver_name: []u8,
    receiver_type: []u8,
    source_field_index: i64
) -> MirExprInst {
    return MirExprInst::FieldAccess(MirFieldAccessExpr {
        id: id,
        llvm_type: field_type,
        value: receiver_name,
        left: -1,
        source_type: receiver_type,
        source_field_index: source_field_index
    });
}

pub fn field_access_temp_expr_inst(
    id: i64,
    field_type: []u8,
    receiver_id: i64,
    receiver_type: []u8,
    source_field_index: i64
) -> MirExprInst {
    return MirExprInst::FieldAccess(MirFieldAccessExpr {
        id: id,
        llvm_type: field_type,
        value: "",
        left: receiver_id,
        source_type: receiver_type,
        source_field_index: source_field_index
    });
}

pub fn index_load_expr_inst(id: i64, target: []u8, index: i64) -> MirExprInst {
    return MirExprInst::IndexLoad(MirIndexLoadExpr {
        id: id,
        llvm_type: "i8",
        target: target,
        index: index
    });
}

pub fn call_expr_inst(
    id: i64,
    llvm_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirExprInst {
    return MirExprInst::Call(MirCallExpr {
        id: id,
        llvm_type: llvm_type,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

// expr_inst_id and expr_inst_llvm_type read the result id and LLVM type that
// every expr-inst variant carries, so result wiring (type-by-id lookups) does
// not depend on the active variant.
pub fn expr_inst_id(inst: &MirExprInst) -> i64 {
    return match inst {
        Var(payload) => payload.id,
        ConstString(payload) => payload.id,
        ConstBool(payload) => payload.id,
        ConstInt(payload) => payload.id,
        ConstEnumTag(payload) => payload.id,
        PrefixNot(payload) => payload.id,
        Binary(payload) => payload.id,
        FieldAccess(payload) => payload.id,
        IndexLoad(payload) => payload.id,
        Call(payload) => payload.id,
    };
}

pub fn expr_inst_llvm_type(inst: &MirExprInst) -> []u8 {
    return match inst {
        Var(payload) => payload.llvm_type,
        ConstString(payload) => payload.llvm_type,
        ConstBool(payload) => payload.llvm_type,
        ConstInt(payload) => payload.llvm_type,
        ConstEnumTag(payload) => payload.llvm_type,
        PrefixNot(payload) => payload.llvm_type,
        Binary(payload) => payload.llvm_type,
        FieldAccess(payload) => payload.llvm_type,
        IndexLoad(payload) => payload.llvm_type,
        Call(payload) => payload.llvm_type,
    };
}

pub fn let_call_stmt(
    name: []u8,
    llvm_type: []u8,
    string_index: i64,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirStmt {
    return MirStmt::LetCall(MirLetCallStmt {
        name: name,
        llvm_type: llvm_type,
        string_index: string_index,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

pub fn let_struct_stmt(
    name: []u8,
    llvm_type: []u8,
    string_index: i64,
    fields: std::array::Array<MirStructField>
) -> MirStmt {
    return MirStmt::LetStruct(MirLetStructStmt {
        name: name,
        llvm_type: llvm_type,
        string_index: string_index,
        struct_fields: fields
    });
}

pub fn let_expr_stmt(
    name: []u8,
    string_index: i64,
    result_id: i64,
    insts: std::array::Array<MirExprInst>
) -> MirStmt {
    return MirStmt::LetExpr(MirLetExprStmt {
        name: name,
        string_index: string_index,
        expr_result_id: result_id,
        expr_insts: insts
    });
}

pub fn return_call_stmt(
    llvm_type: []u8,
    string_index: i64,
    module_prefix: []u8,
    callee_name: []u8,
    args: std::array::Array<MirCallArg>
) -> MirStmt {
    return MirStmt::ReturnCall(MirReturnCallStmt {
        name: "ret_val",
        llvm_type: llvm_type,
        string_index: string_index,
        call_module_prefix: module_prefix,
        call_callee_name: callee_name,
        call_args: args
    });
}

pub fn return_struct_stmt(
    string_index: i64,
    fields: std::array::Array<MirStructField>
) -> MirStmt {
    return MirStmt::ReturnStruct(MirReturnStructStmt {
        string_index: string_index,
        struct_fields: fields
    });
}

pub fn return_expr_stmt(
    string_index: i64,
    result_id: i64,
    insts: std::array::Array<MirExprInst>
) -> MirStmt {
    return MirStmt::ReturnExpr(MirReturnExprStmt {
        string_index: string_index,
        expr_result_id: result_id,
        expr_insts: insts
    });
}

pub fn return_error_stmt() -> MirStmt {
    return MirStmt::ReturnError;
}

pub fn while_stmt(
    loop_index: i64,
    induction_var: []u8,
    induction_init: i64,
    induction_step: i64,
    cond_result_id: i64,
    cond_insts: std::array::Array<MirExprInst>,
    body_stmts: std::array::Array<MirStmt>
) -> MirStmt {
    return MirStmt::While(MirWhileStmt {
        loop_index: loop_index,
        induction_var: induction_var,
        induction_init: induction_init,
        induction_step: induction_step,
        cond_result_id: cond_result_id,
        cond_insts: cond_insts,
        body_stmts: body_stmts
    });
}

pub fn if_stmt(
    if_index: i64,
    string_index: i64,
    cond_result_id: i64,
    cond_insts: std::array::Array<MirExprInst>,
    cond_short_circuit: i64,
    cond_rhs_result_id: i64,
    cond_rhs_insts: std::array::Array<MirExprInst>,
    then_kind: MirIfThenKind,
    bool_value: bool,
    call_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    call_args: std::array::Array<MirCallArg>,
    then_result_id: i64,
    then_insts: std::array::Array<MirExprInst>,
    then_struct_fields: std::array::Array<MirStructField>,
    then_struct_string_index: i64
) -> MirStmt {
    return MirStmt::If(MirIfStmt {
        if_index: if_index,
        string_index: string_index,
        llvm_type: call_type,
        cond_result_id: cond_result_id,
        cond_insts: cond_insts,
        cond_short_circuit: cond_short_circuit,
        cond_rhs_result_id: cond_rhs_result_id,
        cond_rhs_insts: cond_rhs_insts,
        if_then_kind: then_kind,
        bool_value: bool_value,
        then_call_module_prefix: module_prefix,
        then_call_callee_name: callee_name,
        then_call_args: call_args,
        then_expr_result_id: then_result_id,
        then_expr_insts: then_insts,
        then_struct_fields: then_struct_fields,
        then_struct_string_index: then_struct_string_index
    });
}

// The scalar block instructions render from the function return type and
// terminator value, so their union variants are payload-free and carry no
// result, callee symbol, or argument Array.
pub fn mir_string_const_instruction() -> MirInstruction {
    return MirInstruction::ConstString;
}

pub fn const_int_instruction() -> MirInstruction {
    return MirInstruction::ConstInt;
}

pub fn struct_literal_instruction() -> MirInstruction {
    return MirInstruction::StructLiteral;
}

pub fn expr_instruction() -> MirInstruction {
    return MirInstruction::Expr;
}

pub fn multi_statement_instruction() -> MirInstruction {
    return MirInstruction::MultiStatement;
}

pub fn call_instruction(
    result: MirValue,
    module_prefix: []u8,
    callee_name: []u8
) -> MirInstruction {
    return MirInstruction::Call(MirCallInst {
        result: result,
        module_prefix: module_prefix,
        callee_name: callee_name
    });
}

pub fn return_value(value: MirValue) -> MirTerminator {
    return MirTerminator {
        kind: MirTerminatorKind::Return,
        value: value
    };
}
