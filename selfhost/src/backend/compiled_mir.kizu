    };
}

pub fn traversal_try_arm(
    tag: i64,
    payload_type: []u8,
    callee_module: []u8,
    callee_name: []u8,
    args: std::array::Array<MirTraversalArg>
) -> MirTraversalArm {
    return MirTraversalArm {
        tag: tag,
        is_literal: false,
        literal_value: 0,
        payload_type: payload_type,
        callee_module: callee_module,
        callee_name: callee_name,
        args: args
    };
}

pub fn traversal_literal_arm(
    tag: i64,
    literal_value: i64
) -> MirTraversalArm {
    return MirTraversalArm {
        tag: tag,
        is_literal: true,
        literal_value: literal_value,
        payload_type: "",
        callee_module: "",
        callee_name: "",
        args: std::array::Array<MirTraversalArg>(std::mem::page_allocator())
    };
}

