// field_access_struct_field builds a single-hop 'root.field' struct-literal field. It is the
// one-step case of the general access path below.
pub fn field_access_struct_field(
    index: i64,
    field_type: []u8,
    receiver_name: []u8,
    receiver_type: []u8,
    source_field_index: i64
) -> !MirStructField {
    var steps = empty_field_steps();
    try steps.append(field_step(receiver_type, source_field_index));
    return field_access_path_struct_field(
        index, field_type, receiver_name, steps
    );
}

// field_access_path_struct_field builds a struct-literal field read through an extraction chain
// of any depth rooted at receiver_name. The renderer walks the steps in order, so a one-hop
// 'node.kind' and a five-hop 'fn.body.statement.expr.argument.payload' share one representation.
pub fn field_access_path_struct_field(
    index: i64,
    field_type: []u8,
    receiver_name: []u8,
    steps: std::array::Array<MirFieldStep>
) -> MirStructField {
    return MirStructField {
        index: index,
        kind: MirStructFieldKind::FieldAccess,
        llvm_type: field_type,
        value: receiver_name,
        int_value: -1,
        bool_value: false,
        source_type: "",
        source_field_index: -1,
        nested_source_type: "",
        computed_rhs_name: "",
        computed_op: "",
        computed_lhs_literal: 0,
        computed_lhs_is_literal: false,
        computed_rhs_literal: 0,
        computed_rhs_is_literal: false,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: empty_struct_call_args(),
        nested_fields: empty_struct_nested_fields(),
        access_path: steps
    };
}


