fn binary_result_type(op: []u8) -> []u8 {
    if std::mem::equal_bytes(op, "add") or std::mem::equal_bytes(op, "sub") or
        std::mem::equal_bytes(op, "mul") or std::mem::equal_bytes(op, "div") {
        return "i64";
    }
    return "i1";
}

pub fn binary_expr_inst(id: i64, op: []u8, left: i64, right: i64) -> MirExprInst {
    return MirExprInst {
        id: id,
        kind: MirExprInstKind::Binary,
        llvm_type: binary_result_type(op),
        value: "",
        int_value: 0,
        bool_value: false,
        left: left,
        right: right,
        op: op,
        source_type: "",
        source_field_index: -1,
        call_module_prefix: "",
        call_callee_name: "",
        call_args: std::array::Array<MirCallArg>(std::mem::page_allocator())
    };
}

