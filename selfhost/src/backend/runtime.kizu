import selfhost::abi::fixed_abi_contract;

pub fn load_storage_module(io: Io) -> ![]u8 {
    let bytes = try std::fs::read_file(io, "selfhost/runtime/selfhost.storage.ll");
    try validate_storage_template(bytes);
    return bytes;
}

pub fn render_storage_metadata(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-runtime-storage-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    let tail = try load_storage_metadata_tail(io);
    try out.append_bytes(tail);
    return out;
}

pub fn load_host_module(io: Io) -> ![]u8 {
    let bytes = try std::fs::read_file(io, "selfhost/runtime/selfhost.host.ll");
    if !std::mem::starts_with(bytes, "; kizu selfhost host capabilities ll v0") {
        return error("invalid host capability artifact");
    }
    // The host template uses slice and owned but not arena handles.
    try fixed_abi_contract::validate_template_declarations(bytes, false);
    return bytes;
}

pub fn render_host_metadata(
    allocator: Allocator,
    io: Io,
    ir_path: []u8,
    manifest_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "kizu-host-capabilities-v0");
    try append_line(out, "abi selfhost-abi-v0");
    try append_key_value(out, "ir ", ir_path);
    try append_key_value(out, "manifest ", manifest_path);
    let tail = try load_host_metadata_tail(io);
    try out.append_bytes(tail);
    return out;
}

fn validate_storage_template(bytes: []u8) -> !void {
    if !std::mem::starts_with(bytes, "; kizu selfhost runtime storage ll v0") {
        return error("invalid runtime storage artifact");
    }
    try fixed_abi_contract::validate_template_declarations(bytes, true);
    return;
}

fn load_storage_metadata_tail(io: Io) -> ![]u8 {
    let bytes = try std::fs::read_file(io, "selfhost/runtime/selfhost.storage.ll.meta.tail");
    if !std::mem::starts_with(bytes, "linked-llvm target/selfhost/selfhost.ll") {
        return error("invalid runtime storage metadata template");
    }
    return bytes;
}

fn load_host_metadata_tail(io: Io) -> ![]u8 {
    let bytes = try std::fs::read_file(io, "selfhost/runtime/selfhost.host.ll.meta.tail");
    if !std::mem::starts_with(bytes, "linked-llvm target/selfhost/selfhost.ll") {
        return error("invalid host capability metadata template");
    }
    return bytes;
}

fn append_key_value(
    out: &var std::string::String,
    key: []u8,
    value: []u8
) -> !void {
    try out.append_bytes(key);
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
