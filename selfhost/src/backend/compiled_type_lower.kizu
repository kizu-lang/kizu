import selfhost::backend::compiled_fact_lookup;

pub fn kizu_type_to_llvm(
    ir_bytes: []u8,
    module_prefix: []u8,
    kizu_type: []u8
) -> ![]u8 {
    let type_len = std::mem::len(kizu_type);
    if type_len == 0 {
        return error("compiled function: empty type");
    }
    if kizu_type[0] == cast<u8>(38) {
        return try kizu_type_to_llvm(ir_bytes, module_prefix, kizu_type[1..type_len]);
    }
    if kizu_type[0] == cast<u8>(33) {
        let inner = kizu_type[1..type_len];
        if std::mem::equal_bytes(inner, "void") {
            return "%kizu.error.void";
        }
        if std::mem::equal_bytes(inner, "[]u8") {
            return "%kizu.error.slice.u8";
        }
        return error("compiled function: unsupported error type");
    }
    if std::mem::equal_bytes(kizu_type, "i64") {
        return "i64";
    }
    if std::mem::equal_bytes(kizu_type, "bool") {
        return "i1";
    }
    if std::mem::equal_bytes(kizu_type, "u8") {
        return "i8";
    }
    if std::mem::equal_bytes(kizu_type, "[]u8") {
        return "%kizu.slice.u8";
    }
    if std::mem::equal_bytes(kizu_type, "void") {
        return "void";
    }
    if compiled_fact_lookup::is_enum_type(ir_bytes, module_prefix, kizu_type) {
        return "i64";
    }
    return try compiled_fact_lookup::lookup_type_llvm_by_prefix(ir_bytes, module_prefix, kizu_type);
}
