import selfhost::backend::compiled_error_abi;
import selfhost::backend::compiled_type_resolver;
import selfhost::backend::ir_index;

pub fn kizu_type_to_llvm_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    kizu_type: []u8
) -> ![]u8 {
    let normalized = strip_reference_prefixes(kizu_type);
    let type_len = std::mem::len(normalized);
    if type_len == 0 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled function: empty type in ");
        try message.append_bytes(module_prefix);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    if normalized[0] == cast<u8>(33) {
        let inner = normalized[1..type_len];
        if std::mem::len(inner) == 0 {
            return error("compiled function: empty error payload");
        }
        return try error_union_inner_to_llvm_indexed(
            index, ir_bytes, module_prefix, inner
        );
    }
    return try compiled_type_resolver::resolve_indexed(
        index, ir_bytes, module_prefix, normalized
    );
}

pub fn error_union_inner_to_llvm_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    inner: []u8
) -> ![]u8 {
    let payload_abi = try compiled_type_resolver::resolve_indexed(
        index, ir_bytes, module_prefix, strip_reference_prefixes(inner)
    );
    return try compiled_error_abi::lookup_indexed(index, ir_bytes, payload_abi);
}

fn strip_reference_prefixes(kizu_type: []u8) -> []u8 {
    var result = kizu_type;
    var changed = true;
    while changed {
        changed = false;
        let len = std::mem::len(result);
        if len > 0 and result[0] == cast<u8>(38) {
            result = result[1..len];
            changed = true;
        } else {
            if std::mem::starts_with(result, "var_") {
                result = result[4..len];
                changed = true;
            }
        }
    }
    return result;
}
